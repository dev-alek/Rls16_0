        1   define input        parameter p-mode                as character no-undo .
        2   define input        parameter p-type                as character no-undo .
        3   define input        parameter p-host-code           as integer   no-undo .
        4   define input        parameter parParentProc         AS WIDGET-HANDLE NO-UNDO.
        5   define input-output parameter p-transport-cli-type  like ub.sysconf.transport-cli-type   no-undo .
        6   define input-output parameter p-transport-cli-code  like ub.sysconf.transport-cli-code   no-undo .
        7   define input-output parameter p-transport-host      like ub.sysconf.transport-host       no-undo .
        8   define input-output parameter p-transport-contract  like ub.sysconf.transport-contract   no-undo .
        9   define input-output parameter p-transport-uslov     like ub.sysconf.transport-uslov      no-undo .
       10   define input-output parameter p-transport-value     like ub.sysconf.transport-value      no-undo .
       11   define input-output parameter p-transport-type      like ub.contract.transport-type      no-undo .
       12   define variable vss-revision    as character no-undo init "$Revision$":U .
       13   define variable vss-author      as character no-undo init "$Author$":U .
       14   define variable vss-date        as character no-undo init "$Date$":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       16   define variable vss-archive     as character no-undo init "$Archive$":U .
       17   define variable vss-description as character no-undo init "транспортные настройки фирмы".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   procedure proc-alt-shift-f2:
       73     if not ibs.th.gbl.gbl-var:rcode
       74   then
       75     run gbl\inidebug.p .
       76   end.
       77   procedure proc-alt-shift-f3:
       78     run gbl/prvssinf.p
       79       ( input this-procedure
       80       ) .
       81   end.
       82   define variable v-inform-launched as logical no-undo initial false .
       83   procedure proc-alt-shift-f4:
       84     define variable v-action as character no-undo .
       85     if v-inform-launched = false then do:
       86       assign
       87         v-inform-launched = true
       88       .
       89       run gbl/d-inform.w
       90         (  input self
       91         ,  input this-procedure
       92         , output v-action
       93         ) no-error .
       94       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       95       assign
       96         v-inform-launched = false
       97       .
       98     end.
       99   end.
      100   procedure proc-alt-f1:
      101     run gbl/corrhelp.p
      102       (input this-procedure
      103       ) .
      104   end .
      105   on alt-shift-f2 anywhere do:
      106     run proc-alt-shift-f2.
      107   end.
      108   on alt-shift-f3 anywhere do:
      109     run proc-alt-shift-f3 in this-procedure .
      110   end.
      111   on alt-shift-f4 anywhere do:
      112     run proc-alt-shift-f4 in this-procedure.
      113   end.
      114   on alt-f1 anywhere do:
      115     run proc-alt-f1 in this-procedure .
      116   end.
      117   define new global shared variable g#language as character no-undo .
      118   if g#language <> '' and g#language <> 'rus':U then do:
      119     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      120   end.
      121   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      122     define variable v-cntxt-db-num        as integer   no-undo .
      123     define variable v-cntxt-userid        as character no-undo .
      124     define variable v-cntxt-level         as character no-undo .
      125     define variable v-cntxt-host-code-obj as integer   no-undo .
      126     define variable v-cntxt-obj-type      as character no-undo .
      127     define variable v-cntxt-obj-code      as integer   no-undo .
      128     define variable v-cntxt-db-num-obj    as integer   no-undo .
      129     define variable v-cntxt-is-admin      as logical   no-undo .
      130   define buffer buf_delivery-type for ub.delivery-type .
      131   define variable  agnt-list as character no-undo .
      132   define variable v-transport-host as integer   no-undo .
      133   DEFINE BUTTON B-exit AUTO-GO
      134        LABEL "&Ввод"
      135        SIZE 10 BY 1
      136        BGCOLOR 8 .
      137   DEFINE BUTTON B-Help
      138        LABEL "Помо&щь"
      139        SIZE 10 BY 1
      140        BGCOLOR 8 .
      141   DEFINE BUTTON b-quit AUTO-END-KEY
      142        LABEL "&Отмена"
      143        SIZE 10 BY 1
      144        BGCOLOR 8 .
      145   DEFINE BUTTON BUTTON-cli
      146        IMAGE-UP FILE "btn-down-arrow":U
      147        IMAGE-DOWN FILE "btn-down-arrow":U
      148        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      149        LABEL "2"
      150        SIZE 2.88 BY 1.
      151   DEFINE BUTTON BUTTON-contr
      152        IMAGE-UP FILE "btn-down-arrow":U
      153        IMAGE-DOWN FILE "btn-down-arrow":U
      154        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      155        LABEL "2"
      156        SIZE 2.88 BY 1.
      157   DEFINE BUTTON BUTTON-type
      158        IMAGE-UP FILE "btn-down-arrow":U
      159        IMAGE-DOWN FILE "btn-down-arrow":U
      160        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      161        LABEL "2"
      162        SIZE 2.88 BY 1.
      163   DEFINE VARIABLE COMBO-usl AS CHARACTER FORMAT "X(256)":U
      164        VIEW-AS COMBO-BOX INNER-LINES 3
      165        LIST-ITEMS "Item 1"
      166        DROP-DOWN-LIST
      167        SIZE 58.5 BY 1 NO-UNDO.
      168   DEFINE VARIABLE cli-type AS CHARACTER FORMAT "X(3)"
      169        VIEW-AS FILL-IN
      170        SIZE 4.38 BY 1.
      171   DEFINE VARIABLE cli-name AS CHARACTER FORMAT "X(256)":U
      172        VIEW-AS FILL-IN
      173        SIZE 41.75 BY 1 NO-UNDO.
      174   DEFINE VARIABLE FILL-cont AS CHARACTER FORMAT "X(256)":U
      175        VIEW-AS FILL-IN
      176        SIZE 41.75 BY 1 NO-UNDO.
      177   DEFINE VARIABLE FILL-type AS CHARACTER FORMAT "X(56)":U
      178        VIEW-AS FILL-IN
      179        SIZE 49.5 BY 1 NO-UNDO.
      180   DEFINE VARIABLE transport-contract LIKE ub.sysconf.transport-contract
      181        LABEL "Транспортный договор"
      182        VIEW-AS FILL-IN
      183        SIZE 8 BY 1 NO-UNDO.
      184   DEFINE VARIABLE cli-code LIKE ub.sysconf.transport-cli-code
      185        LABEL "Контрагент"
      186        VIEW-AS FILL-IN
      187        SIZE 7.5 BY 1 NO-UNDO.
      188   DEFINE VARIABLE transport-type AS INTEGER FORMAT ">>>>9" INITIAL 0
      189        LABEL "Тип доставки"
      190        VIEW-AS FILL-IN
      191        SIZE 6.75 BY 1 NO-UNDO.
      192   DEFINE VARIABLE transport-value LIKE ub.sysconf.transport-value
      193        LABEL "%"
      194        VIEW-AS FILL-IN
      195        SIZE 9.75 BY 1 NO-UNDO.
      196   DEFINE FRAME Dialog-Frame
      197        B-exit AT ROW 1 COL 1
      198        b-quit AT ROW 1 COL 11
      199        B-Help AT ROW 1 COL 66.13
      200        cli-code AT ROW 2.5 COL 16.5 COLON-ALIGNED HELP
      201             ""
      202        cli-type AT ROW 2.5 COL 24.5 COLON-ALIGNED NO-LABEL WIDGET-ID 8
      203        BUTTON-cli AT ROW 2.5 COL 31.13 WIDGET-ID 4
      204        cli-name AT ROW 2.5 COL 32.25 COLON-ALIGNED NO-LABEL
      205        transport-contract AT ROW 3.71 COL 21 COLON-ALIGNED HELP
      206             ""
      207             LABEL "Транспортный договор"
      208        BUTTON-contr AT ROW 3.71 COL 31.25 WIDGET-ID 2
      209        FILL-cont AT ROW 3.75 COL 32.25 COLON-ALIGNED NO-LABEL
      210        transport-value AT ROW 5.96 COL 64.25 COLON-ALIGNED HELP
      211             ""
      212             LABEL "%"
      213        COMBO-usl AT ROW 6.04 COL 1 COLON-ALIGNED NO-LABEL
      214        transport-type AT ROW 7.25 COL 13.75 COLON-ALIGNED
      215        BUTTON-type AT ROW 7.25 COL 23
      216        FILL-type AT ROW 7.25 COL 24.5 COLON-ALIGNED NO-LABEL
      217        "Условие предоставления транспортных услуг:" VIEW-AS TEXT
      218             SIZE 53 BY .67 AT ROW 5.21 COL 3
      219             FGCOLOR 4
      220        SPACE(20.62) SKIP(2.61)
      221       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      222            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      223            TITLE "Транспортные настройки фирмы".
      224   ASSIGN
      225          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      226          FRAME Dialog-Frame:HIDDEN           = TRUE.
      227   ASSIGN
      228          cli-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      229   ASSIGN
      230          FILL-cont:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      231   ASSIGN
      232          FILL-type:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      233   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      234   DO:
      235     APPLY "END-ERROR":U TO SELF.
      236   END.
      237   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      238   DO:
      239     if p-mode <> 'ПРОСМОТР':U then do:
      240       assign transport-value cli-code cli-type transport-contract COMBO-usl .
      241       case COMBO-usl :
      242         when 'Доставка включена':U then assign p-transport-uslov = int('0':U) .
      243         when 'Доставка за процент стоимости':U     then
      244             assign
      245               p-transport-uslov = int('1':U)
      246               p-transport-value = transport-value
      247             .
      248         when 'Сумма доставки зависит от расстояния':U    then assign p-transport-uslov = int('2':U) .
      249       end.
      250       assign
      251         p-transport-cli-type = cli-type
      252         p-transport-cli-code = cli-code
      253         p-transport-host     = v-transport-host
      254         p-transport-contract = transport-contract
      255         p-transport-type     = transport-type
      256       .
      257     end.
      258   END.
      259   ON CHOOSE OF BUTTON-cli IN FRAME Dialog-Frame
      260   DO:
      261     assign
      262       transport-contract = 0
      263       v-transport-host   = 0
      264       FILL-cont          = ""
      265     .
      266     define buffer buf_clients for ub.clients.
      267     run ref/cli-all.w (parParentProc, "b-sel", 'все':U, 'все':U, 'текущие':U, ?, ",,,,,,NO,,":u, "without-obj":U, output agnt-list ) .
      268     if agnt-list <> "" then do:
      269       find first buf_clients no-lock where RECID(buf_clients) = int (agnt-list) no-error.
      270       if buf_clients.obj-type <> 'чел':U and buf_clients.obj-type <> 'орг':U then do:
      271         message
      272           "Контрагент может быть только " 'орг':U " или " 'чел':U
      273           view-as alert-box ERROR .
      274         return no-apply.
      275       end.
      276       assign
      277         cli-name = buf_clients.obj-name
      278         cli-code = buf_clients.obj-code
      279         cli-type = buf_clients.obj-type
      280       .
      281     end.
      282     else assign cli-name = ""  cli-code = ?  cli-type  = ? .
      283     display     cli-name       cli-code      cli-type transport-contract FILL-cont   with frame Dialog-Frame.
      284   END.
      285   ON CHOOSE OF BUTTON-contr IN FRAME Dialog-Frame
      286   DO:
      287     define buffer buf_contract for ub.contract.
      288     run str/cont-all.w ( input  parParentProc, input p-host-code, input "b-sel":U, input 'фирма':U, input cli-type, input cli-code, input  ?, input  ?, input  "current", input 'при':U , input-output agnt-list   ) no-error .
      289     find first buf_contract no-lock where RECID(buf_contract) = int (agnt-list) no-error.
      290     if not available buf_contract then do:
      291       assign
      292         transport-contract = 0
      293         v-transport-host = 0
      294         FILL-cont = ""
      295       .
      296       display transport-contract FILL-cont  with frame Dialog-Frame.
      297       return.
      298     end.
      299     assign
      300       transport-contract = buf_contract.contract-code
      301       v-transport-host   = buf_contract.host-code
      302       FILL-cont          = buf_contract.contract-prn-code + " от " + string(buf_contract.contract-date,"99/99/9999")
      303     .
      304     display transport-contract FILL-cont  with frame Dialog-Frame.
      305   END.
      306   ON CHOOSE OF BUTTON-type IN FRAME Dialog-Frame
      307   DO:
      308     define variable v-rid-list as character no-undo.
      309     define variable v-sts as integer no-undo .
      310   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      311   if lookup(self :type
      312            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      313            ) = 0
      314   then do:
      315     message
      316       "$Workfile$"
      317       "Указанному интерфейсному элементу фокус не может быть передан" skip
      318       "Интерфейсный элемент" self :name  skip
      319       "Тип" self :type  skip
      320       "Процедура" this-procedure :file-name skip
      321       view-as alert-box .
      322   end.
      323   else do:
      324     apply "entry":u to self  .
      325     if focus :handle <> self :handle  then do:
      326       return no-apply .
      327     end.
      328   end.
      329     if available buf_delivery-type then
      330       assign
      331         v-rid-list = string(recid(buf_delivery-type))
      332         v-sts = buf_delivery-type.sts
      333       .
      334     run ref/dlvtypes.w (input parParentProc, v-cntxt-obj-type, v-cntxt-obj-code, "b-sel":U, 'все':U, input-output v-sts, input-output v-rid-list ) no-error .
      335     if v-rid-list <> "":U then do:
      336       FIND FIRST buf_delivery-type WHERE recid( buf_delivery-type ) = integer(entry(1, v-rid-list)) NO-LOCK .
      337       assign
      338         transport-type = buf_delivery-type.deliv-type-code
      339         FILL-type      = buf_delivery-type.deliv-type-name
      340       .
      341       display transport-type  FILL-type  with frame Dialog-Frame .
      342     end.
      343   END.
      344   ON LEAVE OF cli-type IN FRAME Dialog-Frame
      345   DO:
      346     assign cli-type.
      347     assign
      348       transport-contract = 0
      349       v-transport-host   = 0
      350       FILL-cont          = ""
      351     .
      352     define buffer buf_clients for ub.clients.
      353     if cli-type <> 'орг':U and cli-type <> 'чел':U then do:
      354       find first buf_clients no-lock where buf_clients.obj-type = 'орг':U and buf_clients.obj-code = cli-code no-error.
      355       if not available buf_clients then do:
      356         find first buf_clients no-lock where buf_clients.obj-type = 'чел':U and buf_clients.obj-code = cli-code no-error.
      357       end.
      358     end.
      359     else find first buf_clients no-lock where buf_clients.obj-type = cli-type and buf_clients.obj-code = cli-code no-error.
      360     if not available buf_clients then do:
      361       if cli-code = 0 then assign cli-code = ? .
      362       if cli-code = ? then do:
      363         assign cli-name = ""   cli-code = ?  cli-type  = ? .
      364         display cli-name    cli-code     cli-type    with frame Dialog-Frame.
      365       end.
      366       else do:
      367         apply "CHOOSE" to BUTTON-cli IN FRAME Dialog-Frame .
      368       end.
      369       return.
      370     end.
      371     assign
      372       cli-name = buf_clients.obj-name
      373       cli-code = buf_clients.obj-code
      374       cli-type = buf_clients.obj-type
      375     .
      376     display cli-name    cli-code     cli-type  transport-contract FILL-cont   with frame Dialog-Frame.
      377   END.
      378   ON VALUE-CHANGED OF COMBO-usl IN FRAME Dialog-Frame
      379   DO:
      380     assign COMBO-usl .
      381     if COMBO-usl:screen-value = 'Доставка за процент стоимости':U then transport-value:visible = yes .
      382     else                                                   transport-value:visible = no .
      383   END.
      384   ON LEAVE OF transport-contract IN FRAME Dialog-Frame
      385   DO:
      386     if transport-contract = int ( transport-contract:screen-value ) then return.
      387     assign transport-contract .
      388     define buffer buf_contract for ub.contract .
      389     find first buf_contract no-lock
      390       where buf_contract.host-code     = p-host-code
      391         and buf_contract.contract-code = transport-contract
      392         and buf_contract.cli-code      = cli-code
      393         and buf_contract.cli-type      = cli-type
      394     no-error.
      395     if not available buf_contract then do:
      396       apply "CHOOSE" to BUTTON-contr IN FRAME Dialog-Frame .
      397     end.
      398     else do:
      399       assign
      400         transport-contract = buf_contract.contract-code
      401         v-transport-host   = buf_contract.host-code
      402         FILL-cont          = buf_contract.contract-prn-code + " от " + string(buf_contract.contract-date,"99/99/9999")
      403       .
      404     end.
      405     display transport-contract FILL-cont  with frame Dialog-Frame.
      406   END.
      407   ON RETURN OF transport-contract IN FRAME Dialog-Frame
      408   DO:
      409     if transport-contract = int ( transport-contract:screen-value ) then return.
      410     assign transport-contract .
      411     define buffer buf_contract for ub.contract .
      412     find first buf_contract no-lock
      413       where buf_contract.host-code     = p-host-code
      414         and buf_contract.contract-code = transport-contract
      415         and buf_contract.cli-code      = cli-code
      416         and buf_contract.cli-type      = cli-type
      417     no-error.
      418     if not available buf_contract then do:
      419       apply "CHOOSE" to BUTTON-contr IN FRAME Dialog-Frame .
      420     end.
      421     else do:
      422       assign
      423         transport-contract = buf_contract.contract-code
      424         v-transport-host   = buf_contract.host-code
      425         FILL-cont          = buf_contract.contract-prn-code + " от " + string(buf_contract.contract-date,"99/99/9999")
      426       .
      427       display transport-contract FILL-cont  with frame Dialog-Frame.
      428     end.
      429   END.
      430   ON LEAVE OF cli-code IN FRAME Dialog-Frame
      431   DO:
      432     if cli-code = int ( cli-code:screen-value ) then return.
      433     assign cli-code .
      434     DISABLE transport-contract WITH FRAME Dialog-Frame.
      435     assign
      436       transport-contract = 0
      437       v-transport-host   = 0
      438       FILL-cont          = ""
      439     .
      440     define buffer buf_clients for ub.clients.
      441     find first buf_clients no-lock where buf_clients.obj-type = cli-type and buf_clients.obj-code = cli-code no-error.
      442     if not available buf_clients then do:
      443       apply "CHOOSE" to BUTTON-cli IN FRAME Dialog-Frame .
      444     end.
      445     else do:
      446       assign
      447         cli-code           = buf_clients.obj-code
      448         cli-type           = buf_clients.obj-type
      449         cli-name           = buf_clients.obj-name
      450       .
      451     end.
      452     ENABLE transport-contract WITH FRAME Dialog-Frame.
      453     display cli-code cli-type cli-name  transport-contract FILL-cont  with frame Dialog-Frame.
      454   END.
      455   ON RETURN OF cli-code IN FRAME Dialog-Frame
      456   DO:
      457     if cli-code = int ( cli-code:screen-value ) then return.
      458     assign cli-code .
      459     DISABLE transport-contract WITH FRAME Dialog-Frame.
      460     assign
      461       transport-contract = 0
      462       v-transport-host   = 0
      463       FILL-cont          = ""
      464     .
      465     define buffer buf_clients for ub.clients.
      466     find first buf_clients no-lock where buf_clients.obj-type = cli-type and buf_clients.obj-code = cli-code no-error.
      467     if not available buf_clients then do:
      468       apply "CHOOSE" to BUTTON-cli IN FRAME Dialog-Frame .
      469     end.
      470     else do:
      471       assign
      472         cli-code           = buf_clients.obj-code
      473         cli-type           = buf_clients.obj-type
      474         cli-name           = buf_clients.obj-name
      475       .
      476     end.
      477     ENABLE transport-contract WITH FRAME Dialog-Frame.
      478     display cli-code cli-type cli-name  transport-contract FILL-cont  with frame Dialog-Frame.
      479   END.
      480   ON LEAVE OF transport-type IN FRAME Dialog-Frame
      481   DO:
      482     assign transport-type .
      483     find first buf_delivery-type no-lock where buf_delivery-type.deliv-type-code = transport-type no-error .
      484     if available buf_delivery-type then do:
      485       assign
      486         transport-type = buf_delivery-type.deliv-type-code
      487         FILL-type      = buf_delivery-type.deliv-type-name
      488       .
      489       display transport-type  FILL-type  with frame Dialog-Frame .
      490     end.
      491     else apply "CHOOSE"  to BUTTON-type  IN FRAME Dialog-Frame .
      492   END.
      493   ON RETURN OF transport-type IN FRAME Dialog-Frame
      494   DO:
      495     assign transport-type .
      496     find first buf_delivery-type no-lock where buf_delivery-type.deliv-type-code = transport-type no-error .
      497     if available buf_delivery-type then do:
      498       assign
      499         transport-type = buf_delivery-type.deliv-type-code
      500         FILL-type      = buf_delivery-type.deliv-type-name
      501       .
      502       display transport-type  FILL-type  with frame Dialog-Frame .
      503     end.
      504     else apply "CHOOSE"  to BUTTON-type  IN FRAME Dialog-Frame .
      505   END.
      506   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      507   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      508   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      509   on help of frame Dialog-Frame
      510   do:
      511     run gbl/app_help.p
      512       (input this-procedure :file-name
      513       ,input ''
      514       ,input ?
      515       ) no-error.
      516     if error-status :error then do:
      517       message
      518         "Ошибка при вызове помощи"
      519         error-status :get-message(1)
      520         view-as alert-box .
      521     end.
      522   end.
      523   run minbtn-set in this-procedure .
      524   on choose of b-help in frame Dialog-Frame
      525   do:
      526     apply "help":u to frame Dialog-Frame .
      527   end.
      528   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      529   procedure minbtn-set :
      530       do
      531           on error undo, return error return-value
      532           :
      533           define variable ii              as integer       no-undo .
      534           define variable fh              as widget-handle no-undo .
      535           define variable hh              as widget-handle no-undo .
      536           define variable v-h             as handle        extent 4 no-undo .
      537           define variable v-name-button   as character     no-undo .
      538           define variable v-help-old-x    as decimal       no-undo .
      539           define variable v-help-old-y    as decimal       no-undo .
      540           define variable v-help-old-size as decimal       no-undo .
      541           define variable v-frame-width   as decimal       no-undo .
      542           define variable jj              as integer       no-undo .
      543           do
      544               on error undo, return error
      545               :
      546               assign
      547                   v-frame-width = frame Dialog-Frame:width - 0.3
      548                   fh            = frame Dialog-Frame:first-child
      549                   hh            = fh:first-child
      550                   ii            = 1
      551                   .
      552               do while valid-handle(hh):
      553                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      554                   do:
      555                       case lc(hh:name) :
      556                           when "b-help" then
      557                               do:
      558                                   hh:load-image-up("cmp/b-help.bmp":u) .
      559                                   hh:load-image-down("cmp/b-help.bmp":u) .
      560                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      561                                   hh:TOOLTIP = "Помощь" .
      562                                   v-help-old-x = hh:column .
      563                                   v-help-old-y = hh:row    .
      564                                   v-help-old-size = hh:width .
      565                                   hh:width-chars = 2.5 .
      566                               end.
      567                           when "b-print" then
      568                               do:
      569                                   hh:load-image("cmp/b-print.bmp":u) .
      570                                   hh:TOOLTIP = "Печать" .
      571                                   v-h[ii] = hh:handle .
      572                                   ii = ii + 1 .
      573                                   hh:width-chars = 3 .
      574                               end.
      575                           when "b-history" or
      576                           when "b-hist" then
      577                               do:
      578                                   hh:load-image("cmp/b-hist.bmp":u) .
      579                                   hh:TOOLTIP = "История" .
      580                                   v-h[ii] = hh:handle .
      581                                   ii = ii + 1 .
      582                                   hh:width-chars = 3 .
      583                               end.
      584                           when "b-sch" then
      585                               do:
      586                                   hh:load-image("cmp/b-sch.bmp":u) .
      587                                   hh:TOOLTIP = "Установка Фильтра" .
      588                                   v-h[ii] = hh:handle .
      589                                   ii = ii + 1 .
      590                                   hh:width-chars = 3 .
      591                               end.
      592                           when "b-hist-user" then
      593                               do:
      594                                   hh:load-image("cmp/b-hist.bmp":u) .
      595                                   hh:TOOLTIP = "История пользователя" .
      596                                   ii = ii + 1 .
      597                               end.
      598                       end case.
      599                   end.
      600                   hh = hh:next-sibling.
      601               end.
      602               b-help:column = v-frame-width - b-help:width-chars.
      603               jj = 0.
      604               repeat ii = 4 to 1 by -1 :
      605                   if valid-handle (v-h[ii] ) then
      606                   do:
      607                       jj  = jj + 1 .
      608                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      609                       v-h[ii]:row    = v-help-old-y .
      610                   end.
      611               end.
      612           end.
      613       end.
      614   end procedure.
      615   MAIN-BLOCK:
      616   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      617      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      618   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      619     run mainmenu_getcntxt in parparentproc
      620       (output v-cntxt-db-num
      621       ,output v-cntxt-userid
      622       ,output v-cntxt-level
      623       ,output v-cntxt-host-code-obj
      624       ,output v-cntxt-obj-type
      625       ,output v-cntxt-obj-code
      626       ,output v-cntxt-db-num-obj
      627       ,output v-cntxt-is-admin
      628       ) .
      629     if p-type = "contract" then ASSIGN  frame Dialog-Frame:TITLE = "Транспортные настройки договора" .
      630     COMBO-usl:list-items   = 'Доставка включена':U + ","  + 'Доставка за процент стоимости':U + ","  + 'Сумма доставки зависит от расстояния':U .
      631     define buffer buf_clients for ub.clients.
      632     find first buf_clients no-lock where buf_clients.obj-type = p-transport-cli-type and buf_clients.obj-code = p-transport-cli-code no-error.
      633     if available buf_clients then assign cli-name = buf_clients.obj-name .
      634     define buffer buf_contract for ub.contract .
      635     find first buf_contract no-lock where buf_contract.host-code = p-transport-host and buf_contract.contract-code = p-transport-contract no-error.
      636     if available buf_contract then assign FILL-cont = buf_contract.contract-prn-code + " от " + string(contract-date,"99/99/9999") .
      637     case p-mode :
      638       when 'ДОБАВЛЕНИЕ':U then do:
      639         assign COMBO-usl:screen-value   = 'Доставка включена':U .
      640       end.
      641       when 'ИЗМЕНЕНИЕ':U or when 'ПРОСМОТР':U then do:
      642         assign
      643           cli-type           = p-transport-cli-type
      644           cli-code           = p-transport-cli-code
      645           transport-contract = p-transport-contract
      646           transport-type     = p-transport-type
      647         .
      648         if available buf_contract then assign v-transport-host = buf_contract.host-code .
      649         case p-transport-uslov :
      650           when int('0':U) then assign COMBO-usl:screen-value   = 'Доставка включена':U .
      651           when int('1':U)     then
      652             assign
      653               COMBO-usl:screen-value   = 'Доставка за процент стоимости':U
      654               transport-value = p-transport-value
      655             .
      656           when int('2':U)    then assign COMBO-usl:screen-value   = 'Сумма доставки зависит от расстояния':U .
      657         end.
      658         apply "LEAVE"  to transport-type  IN FRAME Dialog-Frame .
      659         apply "LEAVE"  to transport-contract  IN FRAME Dialog-Frame .
      660       end.
      661     end case.
      662     RUN Myenable_UI.
      663     apply "VALUE-CHANGED"  to COMBO-usl  IN FRAME Dialog-Frame .
      664     WAIT-FOR GO OF FRAME Dialog-Frame.
      665   END.
      666   RUN disable_UI.
      667   PROCEDURE disable_UI :
      668     HIDE FRAME Dialog-Frame.
      669   END PROCEDURE.
      670   PROCEDURE Myenable_UI :
      671     DISPLAY cli-code cli-type cli-name transport-contract FILL-cont
      672             transport-value COMBO-usl transport-type FILL-type
      673         WITH FRAME Dialog-Frame.
      674     ENABLE B-exit b-quit B-Help  WITH FRAME Dialog-Frame.
      675     if p-mode = 'ДОБАВЛЕНИЕ':U or p-mode = 'ИЗМЕНЕНИЕ':U then do:
      676       ENABLE cli-code cli-type BUTTON-cli cli-name
      677            transport-contract BUTTON-contr FILL-cont transport-value COMBO-usl
      678            transport-type BUTTON-type FILL-type
      679         WITH FRAME Dialog-Frame.
      680     end.
      681     else do:
      682       B-exit:label in frame Dialog-Frame = "&Выход" .
      683       b-quit:visible = no .
      684     end.
      685     if p-type <> "contract" then do:
      686       assign
      687         transport-type:visible = no
      688         FILL-type:visible = no
      689         BUTTON-type:visible = no
      690       .
      691     end.
      692     VIEW FRAME Dialog-Frame.
      693   END PROCEDURE.
