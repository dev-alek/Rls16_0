      691   end procedure.
      692   DEFINE BUTTON b-exit AUTO-GO DEFAULT
      693        LABEL "&Ввод ":L
      694        SIZE 10 BY 1.
      695   DEFINE BUTTON b-help DEFAULT
      696        LABEL "Помо&щь":L
      697        SIZE 3 BY 1.
      698   DEFINE BUTTON b-quit AUTO-END-KEY DEFAULT
      699        LABEL "&Отмена":L
      700        SIZE 10 BY 1.
      701   DEFINE BUTTON b-region
      702        IMAGE-UP FILE "btn-down-arrow":U
      703        IMAGE-DOWN FILE "btn-down-arrow":U
      704        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      705        LABEL "":L
      706        SIZE 3 BY 1.
      707   DEFINE VARIABLE f-days AS CHARACTER FORMAT "X(256)":U INITIAL "дней"
      708         VIEW-AS TEXT
      709        SIZE 5 BY 1 NO-UNDO.
      710   DEFINE VARIABLE f-if AS CHARACTER FORMAT "X(256)":U INITIAL "Условия переформирования пакетов:"
      711         VIEW-AS TEXT
      712        SIZE 42.4 BY .67 NO-UNDO.
      713   DEFINE VARIABLE f-region AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      714        LABEL "Регион"
      715        VIEW-AS FILL-IN
      716        SIZE 6 BY 1 NO-UNDO.
      717   DEFINE VARIABLE f-region-name AS CHARACTER FORMAT "X(256)":U
      718         VIEW-AS TEXT
      719        SIZE 46 BY .95 NO-UNDO.
      720   DEFINE RECTANGLE RECT-1
      721        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      722        SIZE 79 BY 2.24.
      723   DEFINE RECTANGLE RECT-2
      724        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      725        SIZE 79 BY 1.52.
      726   DEFINE RECTANGLE RECT-3
      727        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      728        SIZE 79 BY 4.76.
      729   DEFINE RECTANGLE RECT-4
      730        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      731        SIZE 79 BY 3.52.
      732   DEFINE VARIABLE t-save-packs AS LOGICAL INITIAL no
      733        LABEL "Удалять файлы пакетов СПН из каталога heap"
      734        VIEW-AS TOGGLE-BOX
      735        SIZE 45 BY 1 NO-UNDO.
      736   DEFINE VARIABLE t-unload-history AS LOGICAL INITIAL yes
      737        LABEL "Выгружать историю"
      738        VIEW-AS TOGGLE-BOX
      739        SIZE 64 BY .81
      740        FGCOLOR 12  NO-UNDO.
      741   DEFINE FRAME dbi
      742        b-exit AT ROW 1 COL 1
      743        b-quit AT ROW 1 COL 11
      744        b-help AT ROW 1 COL 77
      745        db.db-num AT ROW 2.67 COL 12 COLON-ALIGNED
      746             VIEW-AS FILL-IN
      747             SIZE 10 BY 1
      748        db.db-key AT ROW 2.67 COL 34 COLON-ALIGNED
      749             LABEL "Ключ БД" FORMAT "X(12)"
      750             VIEW-AS FILL-IN
      751             SIZE 13 BY 1
      752        db.db-key-enc AT ROW 2.67 COL 61 COLON-ALIGNED
      753             LABEL "Кодировка" FORMAT "X(16)"
      754             VIEW-AS FILL-IN
      755             SIZE 17 BY 1
      756        db.db-name AT ROW 3.86 COL 12 COLON-ALIGNED FORMAT "X(40)"
      757             VIEW-AS FILL-IN
      758             SIZE 57.4 BY 1
      759        f-region AT ROW 5.05 COL 12 COLON-ALIGNED WIDGET-ID 14
      760        b-region AT ROW 5.05 COL 20 WIDGET-ID 68
      761        db.add-clients AT ROW 6.71 COL 3
      762             VIEW-AS TOGGLE-BOX
      763             SIZE 22.6 BY .81 TOOLTIP "Возможность добавления клиентов"
      764        db.remote-stock AT ROW 6.71 COL 27 HELP
      765             ""
      766             VIEW-AS TOGGLE-BOX
      767             SIZE 21 BY .81 TOOLTIP "Отправка чужих остатков"
      768        db.send-check AT ROW 6.71 COL 56 HELP
      769             ""
      770             LABEL "Пересылать чеки"
      771             VIEW-AS TOGGLE-BOX
      772             SIZE 23.4 BY .81 TOOLTIP "ОТправлять чеки из БД в ГБД"
      773        db.add-goods AT ROW 7.71 COL 3
      774             VIEW-AS TOGGLE-BOX
      775             SIZE 22.2 BY .81 TOOLTIP "Возможность добавлять товары"
      776        db.on-line-rest AT ROW 7.71 COL 27 WIDGET-ID 2
      777             VIEW-AS TOGGLE-BOX
      778             SIZE 22 BY .81
      779        t-save-packs AT ROW 8.95 COL 3 WIDGET-ID 8
      780        db.save-packs AT ROW 8.95 COL 53.6 COLON-ALIGNED HELP
      781             "" WIDGET-ID 6
      782             LABEL "через"
      783             VIEW-AS FILL-IN
      784             SIZE 5 BY 1
      785        db.max-p-size AT ROW 10.52 COL 53.6 COLON-ALIGNED
      786             LABEL "Максимальное кол-во записей в пакете"
      787             VIEW-AS FILL-IN
      788             SIZE 14.4 BY 1
      789        db.max-p-queue AT ROW 12.48 COL 53.6 COLON-ALIGNED
      790             LABEL "Кол-во неподтвержденных пакетов больше" FORMAT "->>9"
      791             VIEW-AS FILL-IN
      792             SIZE 6.2 BY 1
      793        db.max-p-time AT ROW 13.71 COL 53.6 COLON-ALIGNED HELP
      794             ""
      795             LABEL "Время ожидания подтверждения больше (мин)" FORMAT ">>>>>9"
      796             VIEW-AS FILL-IN
      797             SIZE 7 BY 1
      798        db.unload-arch AT ROW 15.19 COL 3
      799             LABEL "Выгружать складские архивы по товарам и по поставщикам"
      800             VIEW-AS TOGGLE-BOX
      801             SIZE 64 BY .81
      802             FGCOLOR 12
      803        db.unload-aht AT ROW 16.19 COL 3
      804             LABEL "Выгружать складской архив по типам приобретения"
      805             VIEW-AS TOGGLE-BOX
      806             SIZE 64 BY .81
      807             FGCOLOR 12
      808        t-unload-history AT ROW 17.19 COL 3 WIDGET-ID 4
      809        f-region-name AT ROW 5.05 COL 23 COLON-ALIGNED NO-LABEL WIDGET-ID 16
      810        f-days AT ROW 8.95 COL 59.6 COLON-ALIGNED NO-LABEL WIDGET-ID 10
      811        f-if AT ROW 11.71 COL 4 NO-LABEL
      812        RECT-2 AT ROW 8.71 COL 2
      813        RECT-4 AT ROW 14.95 COL 2
      814        RECT-1 AT ROW 6.48 COL 2
      815        RECT-3 AT ROW 10.19 COL 2 WIDGET-ID 12
      816        SPACE(0.19) SKIP(3.56)
      817       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      818            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      819            TITLE "БД":L
      820            CANCEL-BUTTON b-quit.
      821   ASSIGN
      822          FRAME dbi:SCROLLABLE       = FALSE.
      823   ASSIGN
      824          f-days:HIDDEN IN FRAME dbi           = TRUE
      825          f-days:READ-ONLY IN FRAME dbi        = TRUE.
      826   ASSIGN
      827          f-if:HIDDEN IN FRAME dbi           = TRUE
      828          f-if:READ-ONLY IN FRAME dbi        = TRUE.
      829   ASSIGN
      830          f-region-name:READ-ONLY IN FRAME dbi        = TRUE.
      831   ASSIGN
      832          db.max-p-queue:HIDDEN IN FRAME dbi           = TRUE.
      833   ASSIGN
      834          db.max-p-size:HIDDEN IN FRAME dbi           = TRUE.
      835   ASSIGN
      836          db.max-p-time:HIDDEN IN FRAME dbi           = TRUE.
      837   ASSIGN
      838          db.on-line-rest:HIDDEN IN FRAME dbi           = TRUE.
      839   ASSIGN
      840          RECT-2:HIDDEN IN FRAME dbi           = TRUE.
      841   ASSIGN
      842          RECT-3:HIDDEN IN FRAME dbi           = TRUE.
      843   ASSIGN
      844          RECT-4:HIDDEN IN FRAME dbi           = TRUE.
      845   ASSIGN
      846          db.remote-stock:HIDDEN IN FRAME dbi           = TRUE.
      847   ASSIGN
      848          db.save-packs:HIDDEN IN FRAME dbi           = TRUE.
      849   ASSIGN
      850          db.send-check:HIDDEN IN FRAME dbi           = TRUE.
      851   ASSIGN
      852          t-save-packs:HIDDEN IN FRAME dbi           = TRUE.
      853   ASSIGN
      854          t-unload-history:HIDDEN IN FRAME dbi           = TRUE.
      855   ASSIGN
      856          db.unload-aht:HIDDEN IN FRAME dbi           = TRUE.
      857   ASSIGN
      858          db.unload-arch:HIDDEN IN FRAME dbi           = TRUE.
      859   ON CHOOSE OF b-exit IN FRAME dbi
      860   DO:
      861     define variable ret-val as integer no-undo .
      862     define variable v-db-attr-del as logical   no-undo .
      863     define variable v-reg-attr as integer no-undo.
      864     define buffer buf1_db     for ub.db .
      865     define buffer buf_clients for ub.clients .
      866     define buffer buf_gds-obj for ub.gds-obj .
      867     if mode = "add":U then do:
      868       if input frame dbi ub.db.db-num = ? then do:
      869         message "Введите номер БД."
      870                 view-as alert-box error.
      871         apply "ENTRY" to ub.db.db-num.
      872         return no-apply.
      873       end.
      874       if can-find (buf1_db where buf1_db.db-num = input frame dbi ub.db.db-num no-lock ) then do:
      875         message "БД с таким номером уже есть."
      876                 view-as alert-box error.
      877         apply "ENTRY" to ub.db.db-num.
      878         undo, return no-apply.
      879       end.
      880     end.
      881     if ub.db.db-num :sensitive in frame dbi = true then do:
      882       assign
      883         ub.db.db-num
      884       .
      885     end.
      886     if ub.db.db-key :sensitive in frame dbi = true then do:
      887       if mode = "unld":U
      888         or ( mode <> "unld":U
      889              and trim( ub.db.db-key ) <> "":U
      890            )
      891       then do:
      892         run chk-db-key
      893           ( input ( input frame dbi ub.db.db-num )
      894           ,input ( input frame dbi ub.db.db-key )
      895           ,input ( input frame dbi ub.db.db-key-enc )
      896           ,output ret-val
      897           ).
      898         if ret-val <> 0 then do:
      899           message return-value
      900                   view-as alert-box error.
      901           if ret-val = 1 then do:
      902             apply "ENTRY" to ub.db.db-key.
      903           end.
      904           else do:
      905             apply "ENTRY" to ub.db.db-key-enc.
      906           end.
      907           undo, return no-apply.
      908         end.
      909         assign
      910           ub.db.db-key
      911           ub.db.db-key-enc
      912           .
      913       end.
      914     end.
      915     if input frame dbi ub.db.db-name = "" then do:
      916       message "Название БД не может быть пустым."
      917               view-as alert-box error.
      918       apply "ENTRY" to ub.db.db-name.
      919       undo, return no-apply.
      920     end.
      921     if ub.db.on-line-rest = true
      922       and input frame dbi ub.db.on-line-rest = false
      923     then do:
      924       for each buf_clients no-lock
      925         where buf_clients.db-num = ub.db.db-num
      926         ,each buf_gds-obj
      927         where buf_gds-obj.obj-type = buf_clients.obj-type
      928           and buf_gds-obj.obj-code = buf_clients.obj-code
      929       on error undo, return no-apply
      930       :
      931         assign
      932           buf_gds-obj.on-line-rest = ?
      933         .
      934       end.
      935     end.
      936     assign
      937       ub.db.db-name
      938       ub.db.add-clients
      939       ub.db.add-goods
      940       ub.db.on-line-rest
      941       ub.db.remote-stock
      942       ub.db.max-p-queue
      943       ub.db.max-p-time
      944       ub.db.max-p-size
      945       ub.db.db-key
      946       ub.db.db-key-enc
      947       ub.db.send-check
      948       ub.db.unload-arch
      949       ub.db.unload-aht
      950       f-region
      951       t-save-packs
      952       t-unload-history when mode = "unld"
      953       ri = recid (ub.db)
      954       p-unload-history = t-unload-history
      955     .
      956     if trim( ub.db.db-key ) <> "":U then do:
      957       run save-db-key( ub.db.db-key ) no-error.
      958       if error-status:error then do:
      959         message
      960           vss-workfile vss-revision vss-description skip
      961           substitute( "Невозможно сохранить ключ базы." ) skip
      962           return-value skip
      963           error-status :get-message ( error-status :num-messages )
      964           view-as alert-box error
      965         .
      966         undo, return no-apply.
      967       end.
      968     end.
      969     if t-save-packs :sensitive in frame dbi = true then do:
      970       if t-save-packs = true then do:
      971         assign
      972           ub.db.save-packs
      973         .
      974       end.
      975       else do:
      976         assign
      977           ub.db.save-packs = ?
      978         .
      979       end.
      980     end.
      981     if f-region <> ? and f-region <> 0 then do:
      982         run db-attr-write in this-procedure (ub.db.db-num, "reg-code", f-region) no-error.
      983         if error-status:error then do:
      984            message substitute("Ошибка сохранения кода региона &1 для БД &2: &3",f-region, ub.db.db-num, return-value)
      985              view-as alert-box error.
      986            undo, return no-apply.
      987         end.
      988     end.
      989     else do:
      990         run db-attr-exist in this-procedure (ub.db.db-num, "reg-code", output v-db-attr-del) no-error.
      991         if v-db-attr-del then
      992           run db-attr-delete in this-procedure (ub.db.db-num, "reg-code", output v-db-attr-del) no-error.
      993     end.
      994   END.
      995   ON CHOOSE OF b-quit IN FRAME dbi
      996   DO:
      997     if mode = "add":U then do:
      998       delete ub.db.
      999     end.
     1000     if mode <> "lkp":U then do:
     1001       assign
     1002         ri = ?
     1003       .
     1004     end.
     1005   END.
     1006   ON CHOOSE OF b-region IN FRAME dbi
     1007   DO:
     1008       define buffer buf_regions for ub.regions.
     1009       define variable v-reg-code as integer no-undo.
     1010       run ref/regions.w ( input  ?
     1011                         , input  'выбор':U
     1012                         , output v-reg-code
     1013                          ).
     1014       if v-reg-code = ? or v-reg-code = 0 then return.
     1015       find first buf_regions no-lock
     1016            where buf_regions.reg-code = v-reg-code
     1017          no-error .
     1018       if available buf_regions then do:
     1019          assign
     1020             f-region      = buf_regions.reg-code
     1021             f-region-name = buf_regions.reg-name
     1022             .
     1023       end.
     1024       else do:
     1025          assign
     1026             f-region      = ?
     1027             f-region-name = "":U
     1028             .
     1029       end.
     1030       display
     1031         f-region
     1032         f-region-name
     1033         with frame dbi .
     1034   END.
     1035   ON VALUE-CHANGED OF f-region IN FRAME dbi
     1036   DO:
     1037     define buffer buf_regions for ub.regions.
     1038     assign
     1039       f-region
     1040     .
     1041     if f-region <> ? and f-region <> 0 then do:
     1042         find first buf_regions no-lock
     1043              where buf_regions.reg-code = f-region
     1044            no-error .
     1045         if available buf_regions then do:
     1046            assign
     1047               f-region      = buf_regions.reg-code
     1048               f-region-name = buf_regions.reg-name
     1049               .
     1050         end.
     1051         else do:
     1052            message "Отсутствует регион с кодом " f-region
     1053            view-as alert-box.
     1054            assign
     1055               f-region      = ?
     1056               f-region-name = "":U
     1057               .
     1058         end.
     1059     end.
     1060     else f-region-name = "":U.
     1061     display
     1062         f-region
     1063         f-region-name
     1064         with frame dbi .
     1065   END.
     1066   ON LEAVE OF db.save-packs IN FRAME dbi
     1067   DO:
     1068     assign
     1069       ub.db.save-packs
     1070     .
     1071     if ub.db.save-packs < 10 then do:
     1072       message
     1073         substitute( "Удалять пакеты раньше чем через 10 дней нельзя!" )
     1074         view-as alert-box.
     1075       assign
     1076         ub.db.save-packs = 10
     1077       .
     1078     end.
     1079   END.
     1080   ON VALUE-CHANGED OF t-save-packs IN FRAME dbi
     1081   DO:
     1082     assign
     1083       t-save-packs
     1084     .
     1085     if t-save-packs = true then do:
     1086       if ub.db.save-packs = ?
     1087         or ub.db.save-packs < 10
     1088       then do:
     1089         assign
     1090           ub.db.save-packs = 10
     1091         .
     1092       end.
     1093       enable
     1094         ub.db.save-packs
     1095         with frame dbi
     1096         .
     1097       display
     1098         ub.db.save-packs
     1099         f-days
     1100         with frame dbi
     1101         .
     1102     end.
     1103     else do:
     1104       hide
     1105         ub.db.save-packs
     1106         f-days
     1107         in frame dbi
     1108         .
     1109     end.
     1110   END.
     1111   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME dbi:PARENT eq ?
     1112   THEN FRAME dbi:PARENT = ACTIVE-WINDOW.
     1113   ON WINDOW-CLOSE OF FRAME dbi APPLY "END-ERROR":U TO SELF.
     1114   MAIN-BLOCK:
     1115   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1116      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1117      ON STOP    UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1118   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1119   on help of frame dbi
     1120   do:
     1121     run gbl/app_help.p
     1122       (input this-procedure :file-name
     1123       ,input ''
     1124       ,input ?
     1125       ) no-error.
     1126     if error-status :error then do:
     1127       message
     1128         "Ошибка при вызове помощи"
     1129         error-status :get-message(1)
     1130         view-as alert-box .
     1131     end.
     1132   end.
     1133   run minbtn-set in this-procedure .
     1134   on choose of b-help in frame dbi
     1135   do:
     1136     apply "help":u to frame dbi .
     1137   end.
     1138   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1139   procedure minbtn-set :
     1140       do
     1141           on error undo, return error return-value
     1142           :
     1143           define variable ii              as integer       no-undo .
     1144           define variable fh              as widget-handle no-undo .
     1145           define variable hh              as widget-handle no-undo .
     1146           define variable v-h             as handle        extent 4 no-undo .
     1147           define variable v-name-button   as character     no-undo .
     1148           define variable v-help-old-x    as decimal       no-undo .
     1149           define variable v-help-old-y    as decimal       no-undo .
     1150           define variable v-help-old-size as decimal       no-undo .
     1151           define variable v-frame-width   as decimal       no-undo .
     1152           define variable jj              as integer       no-undo .
     1153           do
     1154               on error undo, return error
     1155               :
     1156               assign
     1157                   v-frame-width = frame dbi:width - 0.3
     1158                   fh            = frame dbi:first-child
     1159                   hh            = fh:first-child
     1160                   ii            = 1
     1161                   .
     1162               do while valid-handle(hh):
     1163                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1164                   do:
     1165                       case lc(hh:name) :
     1166                           when "b-help" then
     1167                               do:
     1168                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1169                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1170                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1171                                   hh:TOOLTIP = "Помощь" .
     1172                                   v-help-old-x = hh:column .
     1173                                   v-help-old-y = hh:row    .
     1174                                   v-help-old-size = hh:width .
     1175                                   hh:width-chars = 2.5 .
     1176                               end.
     1177                           when "b-print" then
     1178                               do:
     1179                                   hh:load-image("cmp/b-print.bmp":u) .
     1180                                   hh:TOOLTIP = "Печать" .
     1181                                   v-h[ii] = hh:handle .
     1182                                   ii = ii + 1 .
     1183                                   hh:width-chars = 3 .
     1184                               end.
     1185                           when "b-history" or
     1186                           when "b-hist" then
     1187                               do:
     1188                                   hh:load-image("cmp/b-hist.bmp":u) .
     1189                                   hh:TOOLTIP = "История" .
     1190                                   v-h[ii] = hh:handle .
     1191                                   ii = ii + 1 .
     1192                                   hh:width-chars = 3 .
     1193                               end.
     1194                           when "b-sch" then
     1195                               do:
     1196                                   hh:load-image("cmp/b-sch.bmp":u) .
     1197                                   hh:TOOLTIP = "Установка Фильтра" .
     1198                                   v-h[ii] = hh:handle .
     1199                                   ii = ii + 1 .
     1200                                   hh:width-chars = 3 .
     1201                               end.
     1202                           when "b-hist-user" then
     1203                               do:
     1204                                   hh:load-image("cmp/b-hist.bmp":u) .
     1205                                   hh:TOOLTIP = "История пользователя" .
     1206                                   ii = ii + 1 .
     1207                               end.
     1208                       end case.
     1209                   end.
     1210                   hh = hh:next-sibling.
     1211               end.
     1212               b-help:column = v-frame-width - b-help:width-chars.
     1213               jj = 0.
     1214               repeat ii = 4 to 1 by -1 :
     1215                   if valid-handle (v-h[ii] ) then
     1216                   do:
     1217                       jj  = jj + 1 .
     1218                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1219                       v-h[ii]:row    = v-help-old-y .
     1220                   end.
     1221               end.
     1222           end.
     1223       end.
     1224   end procedure.
     1225     define variable ret-val as integer no-undo .
     1226     define variable v-db-attr-value as character no-undo .
     1227     define variable v-db-attr-type  as character no-undo .
     1228     if mode <> "add":U then do:
     1229       if mode = "lkp":U then do:
     1230         find ub.db no-lock
     1231           where recid (ub.db) = ri
     1232           no-error
     1233         .
     1234       end.
     1235       else do:
     1236         find ub.db exclusive-lock
     1237           where recid (ub.db) = ri
     1238           no-error
     1239         .
     1240       end.
     1241       if not available ub.db then do:
     1242         message
     1243           vss-workfile vss-revision vss-description skip
     1244           substitute( "БД &1 удалена." ) skip
     1245           view-as alert-box information
     1246         .
     1247         return error .
     1248       end.
     1249     end.
     1250     case mode:
     1251       when "add":U then do:
     1252         create ub.db.
     1253         frame dbi:title = "Добавление БД".
     1254         assign
     1255           ub.db.db-key      = "":U
     1256           ub.db.db-key-enc  = "":U
     1257           ub.db.max-p-size  = 10000
     1258           ub.db.max-p-time  = 20
     1259           ub.db.max-p-queue = 10
     1260         .
     1261       end.
     1262       when "unld":U then do:
     1263         frame dbi:title = "Выгрузка БД".
     1264         if trim( ub.db.db-key ) <> "":U
     1265           and trim( ub.db.db-key-enc ) <> "":U
     1266         then do:
     1267           run chk-db-key ( input ub.db.db-num
     1268                           ,input ub.db.db-key
     1269                           ,input ub.db.db-key-enc
     1270                           ,output ret-val
     1271                          ).
     1272         end.
     1273         assign
     1274           ub.db.db-key     = "":U
     1275           ub.db.db-key-enc = "":U
     1276         .
     1277       end.
     1278       when "upd":U then do:
     1279         frame dbi:title = "Изменение БД".
     1280       end.
     1281       when "lkp":U then do:
     1282         frame dbi:title = "Просмотр БД".
     1283       end.
     1284       otherwise do:
     1285         message
     1286           vss-workfile vss-revision vss-description skip
     1287           substitute( "Не предусмотрена операция &1", mode ) skip
     1288           view-as alert-box error
     1289         .
     1290         return error .
     1291       end.
     1292     end case.
     1293     session:data-entry-return = yes .
     1294     if ub.db.db-num = 0 then do:
     1295       assign
     1296         frame dbi :height-chars = 8.5
     1297       .
     1298     end.
     1299     else do:
     1300         run db-attr-value in this-procedure (ub.db.db-num,
     1301                                              "reg-code",
     1302                                              output f-region,
     1303                                              output v-db-attr-type) no-error.
     1304         if f-region = 0 then f-region = ?.
     1305     end.
     1306     RUN enable_UI.
     1307     if ub.db.db-num <> 0 then do:
     1308       enable
     1309         ub.db.on-line-rest
     1310         ub.db.send-check
     1311         ub.db.remote-stock
     1312         ub.db.max-p-queue
     1313         ub.db.max-p-time
     1314         ub.db.max-p-size
     1315         ub.db.unload-arch
     1316         ub.db.unload-aht
     1317         f-region
     1318         f-region-name
     1319         t-save-packs
     1320         RECT-2
     1321         RECT-3
     1322         RECT-4
     1323         f-if
     1324         WITH FRAME dbi
     1325       .
     1326       display
     1327         ub.db.on-line-rest
     1328         ub.db.send-check
     1329         ub.db.remote-stock
     1330         ub.db.max-p-queue
     1331         ub.db.max-p-time
     1332         ub.db.max-p-size
     1333         ub.db.unload-arch
     1334         ub.db.unload-aht
     1335         f-region
     1336         f-region-name
     1337         t-save-packs
     1338         f-if
     1339         WITH FRAME dbi
     1340       .
     1341       if ub.db.save-packs <> ? then do:
     1342         assign
     1343           t-save-packs = true
     1344         .
     1345       end.
     1346       else do:
     1347         assign
     1348           t-save-packs = false
     1349         .
     1350       end.
     1351       display
     1352         t-save-packs
     1353         with frame dbi
     1354       .
     1355       apply "VALUE-CHANGED" to t-save-packs in frame dbi .
     1356       apply "VALUE-CHANGED" to f-region in frame dbi .
     1357     end.
     1358     case mode:
     1359       when "add":U then do:
     1360         ENABLE ub.db.db-num WITH FRAME dbi.
     1361       end.
     1362       when "unld":U then do:
     1363         ENABLE ub.db.db-key ub.db.db-key-enc t-unload-history WITH FRAME dbi.
     1364         display
     1365           t-unload-history
     1366           with frame dbi .
     1367       end.
     1368       when "upd":U then do:
     1369         if trim( ub.db.db-key ) = "":U
     1370           or trim( ub.db.db-key ) = ?
     1371         then do:
     1372           ENABLE ub.db.db-key ub.db.db-key-enc WITH FRAME dbi.
     1373         end.
     1374       end.
     1375       when "lkp":U then do:
     1376         disable all WITH FRAME dbi.
     1377         ENABLE b-quit b-help WITH FRAME dbi.
     1378       end.
     1379     end case.
     1380     WAIT-FOR GO OF FRAME dbi.
     1381   END.
     1382   RUN disable_UI.
     1383   session:data-entry-return = no .
     1384   PROCEDURE disable_UI :
     1385     HIDE FRAME dbi.
     1386   END PROCEDURE.
     1387   PROCEDURE enable_UI :
     1388     DISPLAY f-region f-region-name
     1389         WITH FRAME dbi.
     1390     IF AVAILABLE db THEN
     1391       DISPLAY db.db-num db.db-key db.db-key-enc db.db-name db.add-clients
     1392             db.add-goods
     1393         WITH FRAME dbi.
     1394     ENABLE b-exit b-quit b-help RECT-1 db.db-name f-region b-region
     1395            db.add-clients db.add-goods
     1396         WITH FRAME dbi.
     1397   END PROCEDURE.
