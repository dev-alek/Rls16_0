        1   define input param mode as char no-undo.
        2   define input-output param  ri as recid no-undo init ?.
        3   define output parameter p-unload-history as logical no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: 8c1a0fd433e1, 1120, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: SMMolotkov $":U .
        6   define variable vss-date        as character no-undo init "$Date: Thu Dec 14 02:13:53 2017 +0300 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: dbi.w $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: adm/dbi.w $":U .
        9   define variable vss-description as character no-undo init "Редактирование БД".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28       assign
       29         p-vss-parameters = substitute('&1',mode)
       30       .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   procedure proc-alt-shift-f2:
       83     if not ibs.th.gbl.gbl-var:rcode
       84   then
       85     run gbl\inidebug.p .
       86   end.
       87   procedure proc-alt-shift-f3:
       88     run gbl/prvssinf.p
       89       ( input this-procedure
       90       ) .
       91   end.
       92   define variable v-inform-launched as logical no-undo initial false .
       93   procedure proc-alt-shift-f4:
       94     define variable v-action as character no-undo .
       95     if v-inform-launched = false then do:
       96       assign
       97         v-inform-launched = true
       98       .
       99       run gbl/d-inform.w
      100         (  input self
      101         ,  input this-procedure
      102         , output v-action
      103         ) no-error .
      104       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      105       assign
      106         v-inform-launched = false
      107       .
      108     end.
      109   end.
      110   procedure proc-alt-f1:
      111     run gbl/corrhelp.p
      112       (input this-procedure
      113       ) .
      114   end .
      115   on alt-shift-f2 anywhere do:
      116     run proc-alt-shift-f2.
      117   end.
      118   on alt-shift-f3 anywhere do:
      119     run proc-alt-shift-f3 in this-procedure .
      120   end.
      121   on alt-shift-f4 anywhere do:
      122     run proc-alt-shift-f4 in this-procedure.
      123   end.
      124   on alt-f1 anywhere do:
      125     run proc-alt-f1 in this-procedure .
      126   end.
      127   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      128   Function reverse returns character (str as character).
      129      define variable rev_incl_s as character init "" no-undo .
      130      define variable rev_incl_i as integer no-undo .
      131      define variable rev_incl_l as integer no-undo .
      132      rev_incl_l = length(str).
      133      do rev_incl_i = 1 to rev_incl_l:
      134         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      135      end.
      136      return rev_incl_s.
      137   end.
      138   procedure check-enc.
      139     define input  parameter p-db-num    as integer   no-undo .
      140     define input  parameter p-db-key    as character no-undo .
      141     define input  parameter p-code      as character no-undo .
      142     define input  parameter p-value     as character no-undo .
      143     define input  parameter p-beg-date  as date      no-undo .
      144     define input  parameter p-end-date  as date      no-undo .
      145     define input  parameter p-enc-value as character no-undo .
      146     define output parameter p-answer    as logical   no-undo .
      147     define variable tmp         as character no-undo .
      148     define variable v-enc-value as character no-undo .
      149     if p-db-num <> 0
      150       and p-db-key = "":U
      151     then do:
      152       assign
      153         p-answer = true
      154       .
      155       return.
      156     end.
      157     if p-db-key = "unload-db":U then do:
      158       assign
      159         p-answer = true
      160       .
      161       return.
      162     end.
      163     if p-code = ""  then do:
      164       assign
      165         tmp = string( p-db-num ) + reverse (p-db-key).
      166       .
      167     end.
      168     else do:
      169       assign
      170         tmp = string( p-db-num )
      171               + trim( p-db-key )
      172               + reverse( trim( p-code ) )
      173               + reverse( trim( p-value ) )
      174               + reverse( string( p-beg-date, "99.99.9999" ) )
      175               + reverse( string( p-end-date, "99.99.9999" ) )
      176       .
      177     end.
      178     run pswd-enc in this-procedure
      179       ( input tmp
      180        ,output v-enc-value
      181       ) no-error .
      182     if error-status:error then do:
      183       message
      184         vss-workfile vss-revision vss-description skip
      185         "Ошибка при вызове процедуры pswd-enc" skip
      186         return-value skip
      187         error-status :get-message(1) skip
      188         view-as alert-box error .
      189       undo, return error .
      190     end.
      191     if v-enc-value = p-enc-value then do:
      192       assign
      193         p-answer = true
      194       .
      195     end.
      196     else do:
      197       assign
      198         p-answer = false
      199       .
      200     end.
      201   end.
      202   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      203   procedure pswd-enc :
      204     define input parameter  pswd     as character no-undo .
      205     define output parameter enc-pswd as character no-undo .
      206     do
      207     on error undo, return error return-value
      208     :
      209       assign
      210         enc-pswd = encode(pswd + string(index(pswd, "k")))
      211       .
      212     end.
      213   end procedure.
      214   function diff-list returns character (
      215     input parfirst-list  as character,
      216     input parsecond-list as character,
      217     input pardelim       as character).
      218     if pardelim = ""
      219     or pardelim = ?
      220     then do:
      221       assign
      222         pardelim = ","
      223       .
      224     end.
      225     def var ind as integer no-undo .
      226     def var v-elem as character no-undo .
      227     def var v-result-list as character no-undo init "".
      228     def var v-num-parfirst-list as integer no-undo .
      229     assign
      230       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      231     .
      232     do ind = 1 to v-num-parfirst-list
      233     :
      234       assign
      235         v-elem = entry(ind, parfirst-list, pardelim)
      236       .
      237       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      238         assign
      239           v-result-list = v-result-list
      240                         + (if v-result-list > "" then pardelim else "")
      241                         + v-elem
      242         .
      243       end.
      244     end.
      245     return v-result-list .
      246   end function.
      247   function add-list returns character (
      248    input parfirst-list  as character,
      249    input parsecond-list as character,
      250    input pardelim       as character).
      251     if pardelim = ""
      252     or pardelim = ?
      253     then do:
      254       assign
      255         pardelim = ","
      256       .
      257     end.
      258     def var ind as integer no-undo .
      259     def var v-elem as character no-undo .
      260     def var v-result-list as character no-undo init "".
      261     def var v-num-parfirst-list as integer no-undo .
      262     assign
      263       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      264     .
      265     do ind = 1 to v-num-parfirst-list
      266     :
      267       assign
      268         v-elem = entry(ind, parfirst-list, pardelim)
      269       .
      270       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      271         assign
      272           v-result-list = v-result-list
      273                         + (if v-result-list > "" then pardelim else "")
      274                         + v-elem
      275         .
      276       end.
      277     end.
      278     def var v-num-parsecond-list as integer no-undo .
      279     assign
      280       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      281     .
      282     do ind = 1 to v-num-parsecond-list
      283     :
      284       assign
      285         v-elem = entry(ind, parsecond-list, pardelim)
      286       .
      287       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      288         assign
      289           v-result-list = v-result-list
      290                         + (if v-result-list > "" then pardelim else "")
      291                         + v-elem
      292         .
      293       end.
      294     end.
      295     return v-result-list .
      296   end function.
      297   function cross-list returns character (
      298    input parfirst-list  as character,
      299    input parsecond-list as character,
      300    input pardelim       as character).
      301     if pardelim = ""
      302     or pardelim = ?
      303     then do:
      304       assign
      305         pardelim = ","
      306       .
      307     end.
      308     def var ind as integer no-undo .
      309     def var v-elem as character no-undo .
      310     def var v-result-list as character no-undo init "".
      311     def var v-num-parfirst-list as integer no-undo .
      312     assign
      313       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      314     .
      315     do ind = 1 to v-num-parfirst-list
      316     :
      317       assign
      318         v-elem = entry(ind, parfirst-list, pardelim)
      319       .
      320       if lookup(v-elem, v-result-list, pardelim) = 0
      321       and lookup(v-elem, parsecond-list, pardelim) > 0
      322       then do:
      323         assign
      324           v-result-list = v-result-list
      325                         + (if v-result-list > "" then pardelim else "")
      326                         + v-elem
      327         .
      328       end.
      329     end.
      330     return v-result-list .
      331   end function.
      332   function radio-label returns character (
      333    input par-rs-value  as character,
      334    input par-rs-radio-buttons as character)
      335    .
      336    DEFINE variable v-result-label as character no-undo.
      337    assign
      338    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      339                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      340                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      341                             ), par-rs-radio-buttons
      342                           )
      343    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      344    .
      345   return v-result-label.
      346   end function.
      347   function m-radio-label returns character (
      348    input par-rs-value  as character,
      349    input par-rs-radio-buttons as character,
      350    input par-delim as character
      351    )
      352    .
      353    DEFINE variable v-result-label as character no-undo.
      354    assign
      355    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      356                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      357                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      358                             ), par-rs-radio-buttons, par-delim
      359                           )
      360    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      361    .
      362   return v-result-label.
      363   end function.
      364   FUNCTION mixlist returns character
      365   (
      366    input parfirst-list  as character
      367    ,input parsecond-list as character
      368    ,input pardelim       as character
      369    ,input pardelim-result as character ) :
      370     if pardelim = ""
      371     or pardelim = ?
      372     then do:
      373       assign
      374         pardelim = ","
      375       .
      376     end.
      377     def var ind as integer no-undo .
      378     def var v-elem1 as character no-undo .
      379     def var v-elem2 as character no-undo .
      380     def var v-result-list as character no-undo init "".
      381     do ind = 1 to num-entries(parfirst-list, pardelim)
      382     :
      383       assign
      384         v-elem1 = entry(ind, parfirst-list, pardelim)
      385         v-elem2 = entry(ind, parsecond-list, pardelim)
      386       .
      387         assign
      388           v-result-list = v-result-list
      389                         + (if v-result-list > "" then pardelim-result else "")
      390                         + v-elem1 + pardelim-result + v-elem2
      391         .
      392     end.
      393     return v-result-list .
      394   END FUNCTION.
      395   procedure save-db-key :
      396     define input parameter p-db-key like ub.db.db-key no-undo .
      397     do
      398     on error undo, return error
      399     :
      400       define buffer buf_rep for ub.rep .
      401       find buf_rep
      402         where buf_rep.rep-num = 1996011200
      403         no-error
      404       .
      405       if not available buf_rep then do:
      406         create buf_rep.
      407         assign
      408           buf_rep.rep-num = 1996011200
      409         .
      410       end.
      411       if lookup( p-db-key, buf_rep.name1 ) = 0 then do:
      412         assign
      413           buf_rep.name1 = buf_rep.name1 + ",":U + p-db-key
      414         .
      415       end.
      416     end.
      417   end procedure.
      418   procedure del-db-key :
      419     define input parameter p-db-key like ub.db.db-key no-undo .
      420     do
      421     on error undo, return error
      422     :
      423       define buffer buf_rep for ub.rep .
      424       define buffer buf_db  for ub.db .
      425       find first buf_db
      426         where buf_db.db-key = p-db-key
      427         no-error
      428       .
      429       if not available buf_db then do:
      430         find first buf_rep
      431           where buf_rep.rep-num = 1996011200
      432           no-error
      433         .
      434         if available buf_rep
      435           and lookup( p-db-key, buf_rep.name1 ) <> 0
      436         then do:
      437           assign
      438             buf_rep.name1 = diff-list( buf_rep.name1, p-db-key, ",":U )
      439           .
      440         end.
      441       end.
      442     end.
      443   end procedure.
      444   procedure chk-db-key :
      445     define input  parameter p-db-num     like ub.db.db-num     no-undo.
      446     define input  parameter p-db-key     like ub.db.db-key     no-undo.
      447     define input  parameter p-db-key-enc like ub.db.db-key-enc no-undo.
      448     define output parameter p-result     as   integer          no-undo .
      449     do
      450     on error undo, return error
      451     :
      452       define buffer buf_rep for ub.rep .
      453       define buffer buf_db  for ub.db .
      454       define variable v-ok as logical no-undo .
      455       if p-db-key = ?
      456         or p-db-key = ""
      457       then do:
      458         assign
      459           p-result = 1
      460         .
      461         return string("Не задано значение ключа БД.").
      462       end.
      463       if p-db-key-enc = ?
      464         or p-db-key-enc = ""
      465       then do:
      466         assign
      467           p-result = 2
      468         .
      469         return string("Не задано кодированное значение ключа БД.").
      470       end.
      471       find buf_rep
      472         where buf_rep.rep-num = 1996011200
      473         no-error
      474       .
      475       if not available buf_rep then do:
      476         create buf_rep.
      477         assign
      478           buf_rep.rep-num = 1996011200
      479         .
      480       end.
      481       for each buf_db no-lock
      482       on error undo, return error
      483       :
      484         if lookup( buf_db.db-key, buf_rep.name1 ) = 0 then do:
      485           assign
      486             buf_rep.name1 = buf_rep.name1 + ",":U + buf_db.db-key
      487           .
      488         end.
      489       end.
      490       assign
      491         p-result = 0
      492       .
      493       if lookup( p-db-key, buf_rep.name1 ) <> 0 then do:
      494         assign
      495           p-result = 1
      496         .
      497         return string("Данное значение ключа БД уже существует.").
      498       end.
      499       run check-enc in this-procedure
      500         ( input p-db-num
      501          ,input p-db-key
      502          ,input ""
      503          ,input ""
      504          ,input ?
      505          ,input ?
      506          ,input p-db-key-enc
      507          ,output v-ok
      508         ) no-error.
      509       if error-status:error then do:
      510         assign
      511           p-result = 1
      512         .
      513         return substitute( "Ошибка при проверке правильности кодирования. &1", error-status:get-message (1) ) .
      514       end.
      515       if v-ok <> true then do:
      516         assign
      517           p-result = 2
      518         .
      519         return string("Неверное кодированное значение ключа БД.").
      520       end.
      521     end.
      522   end procedure.
      523   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      524   define new global shared variable g#attr-lib  as handle no-undo .
      525   define variable v-attr-lib-variable as handle no-undo .
      526   procedure db-attr-code :
