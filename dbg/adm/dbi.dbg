      675   end procedure.
      676   procedure db-attr-batch-edit :
      677     define input  parameter p-code           as character no-undo .
      678     define output parameter p-section-num    as integer no-undo .
      679     do
      680     on error undo, return error
      681     :
      682           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-batch-edit in g#attr-lib
      683         (input  p-code
      684         ,output p-section-num
      685         ) no-error .
      686       if error-status :error
      687       then do:
      688         undo, return error return-value .
