      528     define output parameter p-type           as character no-undo .
      529     define output parameter p-format         as character no-undo .
      530     define output parameter p-label          as character no-undo .
      531     define output parameter p-user-can-edit  as logical   no-undo .
      532     define output parameter p-output-display as logical   no-undo .
      533     define output parameter p-other          as character no-undo .
      534     do
      535     on error undo, return error
      536     :
      537           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-code in g#attr-lib
      538         (input  p-code
      539         ,output p-type
      540         ,output p-format
      541         ,output p-label
      542         ,output p-user-can-edit
      543         ,output p-output-display
      544         ,output p-other
      545         ) no-error .
      546       if error-status :error
      547       then do:
      548         undo, return error return-value .
      549       end.
      550     end.
      551   end procedure.
      552   procedure db-attr-tooltip :
      553     define input  parameter p-code    as character no-undo .
      554     define output parameter p-tooltip as character no-undo .
      555     define output parameter p-label   as character no-undo .
      556     do
      557     on error undo, return error
      558     :
      559           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-tooltip in g#attr-lib
      560         (input  p-code
      561         ,output p-tooltip
      562         ,output p-label
      563         ) no-error .
      564       if error-status :error
      565       then do:
      566         undo, return error return-value .
      567       end.
      568     end.
      569   end procedure.
      570   procedure db-attr-value :
      571     define input  parameter p-db-num    like ub.db-attr.db-num     no-undo .
      572     define input  parameter p-code      like ub.db-attr.attr-code  no-undo .
      573     define output parameter p-value     like ub.db-attr.attr-value no-undo .
      574     define output parameter p-type      as character no-undo .
      575     do
      576     on error undo, return error
      577     :
      578           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-value in g#attr-lib
      579         (input  p-db-num
      580         ,input  p-code
      581         ,output p-value
      582         ,output p-type
      583         ) no-error .
      584       if error-status :error
      585       then do:
      586         undo, return error return-value .
      587       end.
      588     end.
      589   end procedure.
      590   procedure db-attr-write :
      591     define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
      592     define input parameter p-code      like ub.db-attr.attr-code  no-undo .
      593     define input parameter p-value     like ub.db-attr.attr-value no-undo .
      594     do
      595     on error undo, return error
      596     :
      597           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-write in g#attr-lib
      598         (input p-db-num
      599         ,input p-code
      600         ,input p-value
      601         ) no-error .
      602       if error-status :error
      603       then do:
      604         undo, return error return-value .
      605       end.
      606     end.
      607   end procedure.
      608   procedure db-attr-exist :
      609     define input  parameter p-db-num    like ub.db-attr.db-num     no-undo .
      610     define input  parameter p-code      like ub.db-attr.attr-code  no-undo .
      611     define output parameter p-exist    as logical  no-undo .
      612     do
      613     on error undo, return error
      614     :
      615           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-exist in g#attr-lib
      616         (input  p-db-num
      617         ,input  p-code
      618         ,output p-exist
      619         ) no-error .
      620       if error-status :error
      621       then do:
      622         undo, return error return-value .
      623       end.
      624     end.
      625   end procedure.
      626   procedure db-attr-delete :
      627     define input  parameter p-db-num   like ub.db-attr.db-num     no-undo .
      628     define input  parameter p-code     like ub.db-attr.attr-code  no-undo .
      629     define output parameter p-deleted  as logical no-undo.
      630     do
      631     on error undo, return error
      632     :
      633           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-delete in g#attr-lib
      634         (input  p-db-num
      635         ,input  p-code
      636         ,output p-deleted
      637         ) no-error .
      638       if error-status :error
      639       then do:
      640         undo, return error return-value .
      641       end.
      642     end.
      643   end procedure.
      644   procedure db-attr-news :
      645     define input  parameter p-code           as character no-undo .
      646     define output parameter p-news           as logical   no-undo .
      647     do
      648     on error undo, return error
      649     :
      650           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-news in g#attr-lib
      651         (input  p-code
      652         ,output p-news
      653         ) no-error .
      654       if error-status :error
      655       then do:
      656         undo, return error return-value .
      657       end.
      658     end.
      659   end procedure.
      660   procedure db-attr-manual-edit :
      661     define input  parameter p-code           as character no-undo .
      662     define output parameter p-section-num    as integer no-undo .
      663     do
      664     on error undo, return error
      665     :
      666           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-manual-edit in g#attr-lib
      667         (input  p-code
      668         ,output p-section-num
      669         ) no-error .
      670       if error-status :error
      671       then do:
      672         undo, return error return-value .
