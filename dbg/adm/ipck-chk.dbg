        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle  as widget-handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-parameter   as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: ipck-chk.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: adm/ipck-chk.p $":U .
       11   define variable vss-description as character no-undo init "Проверка готовности пакета обновления к инсталляции".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   define  temp-table tt-ext-file no-undo like ub.ext-file.
       83   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       84   procedure cur-time :
       85      define output parameter p-today as date      no-undo .
       86      define output parameter p-time  as integer   no-undo .
       87     do
       88     on error undo, return error
       89     :
       90       define variable v-date1 as date      no-undo .
       91       define variable v-date2 as date      no-undo .
       92       define variable v-time  as integer   no-undo .
       93       assign
       94         v-date1 = today
       95         v-time  = time
       96         v-date2 = today
       97       .
       98       if v-date1 <> v-date2
       99       then do:
      100         assign
      101           v-date1 = today
      102           v-time  = v-time
      103         .
      104       end.
      105       assign
      106         p-today = v-date1
      107         p-time  = v-time
      108       .
      109     end.
      110   end.
      111   function cur-time-date returns character
      112   :
      113     return string(today, '99/99/9999':U) .
      114   end.
      115   function cur-time-mjd returns decimal
      116   :
      117     define variable v-date as date      no-undo .
      118     define variable v-time as integer   no-undo .
      119     run cur-time in this-procedure
      120       (output v-date
      121       ,output v-time
      122       ) .
      123     return integer(v-date) - 2400002 + (v-time / 86400) .
      124   end.
      125   function cur-time-get-ending-index returns integer
      126   (input p-number as integer
      127   )
      128   :
      129     if p-number < 0
      130     or p-number = ?
      131     then do:
      132       return 1 .
      133     end.
      134     define variable v-rest as integer   no-undo .
      135     assign
      136       p-number = p-number modulo 100
      137     .
      138     if p-number < 20
      139     then do:
      140       assign
      141         v-rest = p-number
      142       .
      143     end.
      144     else do:
      145       assign
      146         v-rest = p-number modulo 10
      147       .
      148     end.
      149     case v-rest :
      150       when 1
      151       then do:
      152         return 2 .
      153       end.
      154       when 2 or
      155       when 3 or
      156       when 4
      157       then do:
      158         return 3 .
      159       end.
      160       otherwise do:
      161         return 1 .
      162       end.
      163     end case .
      164   end.
      165   procedure cur-time-mjd-to-date :
      166      define input  parameter i-mjd-diff as decimal no-undo.
      167      define output parameter o-Date     as date    no-undo.
      168      define output parameter o-Time     as integer no-undo.
      169      define variable v-day-number as integer   no-undo .
      170      if    i-mjd-diff < 0
      171         or i-mjd-diff = ?
      172      then do:
      173         return "?" .
      174      end.
      175      assign
      176         v-day-number = truncate(i-mjd-diff,0).
      177         o-Date = date(v-day-number + 2400002).
      178         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      179     .
      180   end.
      181   function cur-time-mjd-to-string returns character
      182   (input p-mjd-diff as decimal
      183   )
      184   :
      185     define variable v-day-number as integer   no-undo .
      186     define variable v-seconds    as integer   no-undo .
      187     define variable v-hour       as integer   no-undo .
      188     define variable v-min        as integer   no-undo .
      189     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      190     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      191     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      192     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      193     if p-mjd-diff < 0
      194     or p-mjd-diff = ?
      195     then do:
      196       return "?" .
      197     end.
      198     assign
      199       v-day-number = integer(truncate(p-mjd-diff,0))
      200       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      201     .
      202     if v-seconds > 86400
      203     then do:
      204       assign
      205         v-seconds = 86400 - 1
      206       .
      207     end.
      208     if v-seconds < 0
      209     then do:
      210       assign
      211         v-seconds = 0
      212       .
      213     end.
      214     assign
      215       v-hour = truncate(v-seconds / 3600, 0)
      216     .
      217     assign
      218       v-seconds = v-seconds modulo 3600
      219     .
      220     assign
      221       v-min = truncate(v-seconds / 60, 0)
      222     .
      223     assign
      224       v-seconds = v-seconds modulo 60
      225     .
      226     return
      227         (if v-day-number <> 0
      228           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      229           else ""
      230         )
      231       + (if v-day-number <> 0 or v-hour <> 0
      232           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      233           else ""
      234         )
      235       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      236           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      237           else ""
      238         )
      239       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      240       .
      241   end.
      242   function cur-time-string returns character
      243   :
      244     define variable v-date as date      no-undo .
      245     define variable v-time as integer   no-undo .
      246     run cur-time in this-procedure
      247       (output v-date
      248       ,output v-time
      249       ) .
      250     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      251   end.
      252   function cur-time-string-sec returns character
      253   :
      254     define variable v-date as date      no-undo .
      255     define variable v-time as integer   no-undo .
      256     run cur-time in this-procedure
      257       (output v-date
      258       ,output v-time
      259       ) .
      260     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      261   end.
      262   function cur-time-custom  returns character
      263   (input p-prefix as character
      264   ,input p-date-format as character
      265   ,input p-delimiter as character
      266   ,input p-time-format as character
      267   ,input p-suffix as character
      268   )
      269   :
      270     define variable v-date as date      no-undo .
      271     define variable v-time as integer   no-undo .
      272     run cur-time in this-procedure
      273       (output v-date
      274       ,output v-time
      275       ) .
      276     return
      277       p-prefix
      278       + string(v-date, p-date-format)
      279       + p-delimiter
      280       + string(v-time, p-time-format)
      281       + p-suffix
      282       .
      283   end.
      284   function cur-time-print  returns character
      285   :
      286     define variable v-date as date      no-undo .
      287     define variable v-time as integer   no-undo .
      288     run cur-time in this-procedure
      289       (output v-date
      290       ,output v-time
      291       ) .
      292     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      293   end.
      294   function cur-time-datetime returns datetime
      295   :
      296     define variable v-char as character no-undo .
      297     define variable v-datetime as datetime no-undo .
      298     v-char = cur-time-string().
      299     v-datetime = datetime(v-char).
      300     return  v-datetime.
      301   end.
      302   function cur-time-string-msec returns character
      303   :
      304     define variable v-date as datetime  no-undo .
      305     v-date = now.
      306     return string(v-date) .
      307   end.
      308   procedure ipck-mf-process-manifest-file :
      309   define input parameter p-manifest-file  as character no-undo .
      310   define input parameter p-action as character no-undo .
      311     do
      312     on error undo, return error
      313     :
      314     end.
      315   end procedure.
      316   procedure ipck-mf-check-ipck :
      317   define input parameter p-db-num as integer no-undo .
      318   define input parameter p-from-db-num as integer no-undo .
      319   define input parameter p-manifest-file as character no-undo .
      320   define variable v-md5-signature as character no-undo .
      321   define variable v-path as character no-undo .
      322   define variable v-full-path as character no-undo .
      323   define buffer buf_Ext-file for ub.ext-file.
      324     do
      325     on error undo, return error return-value
      326     :
      327     for each buf_ext-file no-lock where
      328            buf_Ext-file.db-num = p-db-num
      329        and buf_Ext-file.from-db-num = p-from-db-num
      330        and  buf_Ext-file.file-type = p-manifest-file
      331     on error undo, return error
      332     :
      333       file-info:file-name = v-path + chr(47) + buf_ext-file.file-name.
      334       if FILE-INFO:FULL-PATHNAME = ? then do:
      335         return error substitute("Отсутствует файл &1", buf_ext-file.file-name).
      336       end.
      337           run gbl/md5.p (
      338          input  v-full-path
      339         ,output v-md5-signature
      340         ) .
      341       if
      342       not
      343       (
      344       buf_ext-file.create-sys-date      = file-info:FILE-CREATE-DATE
      345       AND
      346       buf_ext-file.create-sys-time      = STRING(file-info:FILE-create-TIME, "HH:MM:SS")
      347       AND
      348       buf_ext-file.create-sys-time-INT  = file-info:FILE-create-TIME
      349       AND
      350       buf_ext-file.update-sys-date      = file-info:FILE-MOD-DATE
      351       AND
      352       buf_ext-file.update-sys-time      = STRING(file-info:FILE-MOD-TIME, "HH:MM:SS")
      353       AND
      354       buf_ext-file.update-sys-time-INT  = file-info:FILE-MOD-TIME
      355       AND
      356       buf_ext-file.file-size            = FILE-INFO:FILE-SIZE
      357       AND
      358       buf_ext-file.crc-field            = v-md5-signature
      359       )
      360       then do:
      361         return error substitute("Файл &1 не соответствует описанию в манифесте", buf_ext-file.file-name).
      362       end.
      363       if
      364       not
      365       (
      366       buf_ext-file.create-sys-date      = file-info:FILE-MOD-DATE
      367       AND
      368       buf_ext-file.create-sys-time      = STRING(file-info:FILE-mod-TIME, "HH:MM:SS")
      369       AND
      370       buf_ext-file.create-sys-time-INT  = file-info:FILE-mod-TIME
      371       AND
      372       buf_ext-file.update-sys-date      = file-info:FILE-MOD-DATE
      373       AND
      374       buf_ext-file.file-size            = FILE-INFO:FILE-SIZE
      375       AND
      376       buf_ext-file.crc-field            = v-md5-signature
      377       and
      378       buF_ext-file.file-name = buf_ext-file.file-type
      379       ) then do:
      380         return error substitute("Файл &1 не соответствует описанию в манифесте", buf_ext-file.file-name).
      381       end.
      382     end.
      383     end.
      384   end procedure.
      385   define variable p-db-num as integer no-undo .
      386   define variable p-from-db-num as integer no-undo .
      387   define variable p-file-name  as character no-undo .
      388   define variable p-action as character no-undo .
      389   define variable p-lock-par as character no-undo .
      390   define variable v-lock-par as character no-undo .
      391   define buffer buf_ext-file for ub.ext-file.
      392   main-block:
      393   do
      394   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      395   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      396   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      397   :
      398   assign
      399   p-db-num = integer(entry(1, p-parameter, chr(4) ))
      400   p-from-db-num = integer(entry(2, p-parameter, chr(4) ))
      401   p-file-name = entry(3, p-parameter, chr(4) )
      402   p-action = entry(4, chr(4))
      403   no-error .
      404   if error-status:error then do:
      405     return error substitute("Ошибка входных параметров &1:&2&3&4"
      406                            , p-parameter
      407                            , chr(10)
      408                            , error-status:get-message(1)
      409                            , return-value
      410                            ).
      411   end.
      412   assign
      413   p-lock-par = (if num-entries(p-action) > 1
      414                 then entry(2, p-action)
      415                 else '':U)
      416   p-action = entry(1, p-action)
      417   .
      418   CASE p-action:
      419     when 'query':U then do:
      420       find first buf_ext-file exclusive-lock where
      421               buf_Ext-file.db-num = p-db-num
      422           and buf_Ext-file.from-db-num = p-from-db-num
      423           and buf_Ext-file.file-type = p-file-name
      424           and buf_Ext-file.file-name = p-file-name no-error.
      425       if not available buf_ext-file then do:
      426         if p-db-num = g#db-num and g#db-num = 0
      427         then do:
      428         end.
      429         else do:
      430           run nws/cr-route.p (
      431                       input 'send-cmd':U
      432                       ,input ("command"
      433                               + chr(1) + "run-file"
      434                               + chr(1) + "ipck-chk.p"
      435                               + chr(1) + (string(buf_Ext-file.db-num)
      436                               + chr(4) +  string(buf_Ext-file.from-db-num)
      437                               + chr(4) +  buf_ext-file.FILE-NAME
      438                               + chr(4) + 'reply':U + chr(44) + "not-found"))
      439                       ,input ?
      440                       ,input string(0)
      441                       ) no-error .
      442         end.
      443       end.
      444       run ipck-mf-check-ipck in this-procedure ( input p-db-num, input p-from-db-num, input p-file-name) no-error.
      445       if error-status:error then do:
      446         v-lock-par = 'error':U.
      447       end.
      448       else do:
      449         v-lock-par = 'готов':U.
      450       end.
      451       if g#db-num = 0 and p-db-num = g#db-num then do:
      452         run adm/ipck-chk.p ( INPUT parparentproc
      453                               ,INPUT p-parent-handle
      454                               ,INPUT p-log-handle
      455                               ,INPUT (string(buf_ext-file.db-num)
      456                                         + chr(4) + string(buf_ext-file.from-db-num)
      457                                         + chr(4) + buf_ext-file.FILE-NAME
      458                                         + chr(4) + 'reply':U + chr(44) + v-lock-par)).
      459       end.
      460       else do:
      461         run nws/cr-route.p (
      462                       input 'send-cmd':U
      463                       ,input ("command"
      464                               + chr(1) + "run-file"
      465                               + chr(1) + "ipck-chk.p"
      466                               + chr(1) + (string(buf_Ext-file.db-num)
      467                               + chr(4) +  string(buf_ext-file.from-db-num)
      468                               + chr(4) +  buf_ext-file.FILE-NAME
      469                               + chr(4) + 'reply':U + chr(44) + v-lock-par))
      470                     ,input ?
      471                     ,input string(0)
      472                     ) no-error .
      473       end.
      474     end.
      475     when 'reply':U then do:
      476       find first buf_ext-file no-lock where
      477               buf_Ext-file.db-num = p-db-num
      478           and buf_Ext-file.from-db-num = p-from-db-num
      479           and buf_Ext-file.file-type = p-file-name
      480           and buf_Ext-file.file-name = p-file-name no-error.
      481       if available buf_Ext-file then do:
      482         find first buf_ext-file exclusive-lock where
      483                 buf_Ext-file.db-num = p-db-num
      484             and buf_Ext-file.from-db-num = p-from-db-num
      485             and buf_Ext-file.file-type = p-file-name
      486             and buf_Ext-file.file-name = p-file-name .
      487         ASSIGN
      488         buf_Ext-file.STATUS_ = REPLACE(buf_Ext-file.STATUS_, 'готов':U, "":U)
      489         buf_Ext-file.STATUS_ = REPLACE(buf_Ext-file.STATUS_, chr(63), "":U)
      490         buf_Ext-file.STATUS_ = trim(buf_Ext-file.STATUS_, chr(44))
      491         buf_Ext-file.STATUS_ = REPLACE(buf_Ext-file.STATUS_, chr(44) + chr(44), chr(44))
      492         buf_Ext-file.STATUS_ = buf_Ext-file.STATUS_ + chr(44) + p-lock-par
      493         buf_Ext-file.STATUS_ = trim(buf_Ext-file.STATUS_, chr(44))
      494         .
      495       end.
      496     end.
      497   END CASE.
      498   end.
