        1   block-level on error undo, throw.
        2   define input parameter p-mode     as character no-undo .
        3   define input parameter p-obj-type like ub.clients.obj-type no-undo .
        4   define input parameter p-obj-code like ub.clients.obj-code no-undo .
        5   define input parameter p-upper-param-code like ub.thbj-attr.upper-prop-code no-undo .
        6   define input parameter p-param-code like ub.thbj-attr.prop-code no-undo .
        7   define output parameter p-value-character like ub.thbj-attr.property-value-character no-undo .
        8   define output parameter p-value-date    like ub.thbj-attr.property-value-date no-undo .
        9   define output parameter p-value-decimal like ub.thbj-attr.property-value-decimal no-undo .
       10   define output parameter p-value-integer like ub.thbj-attr.property-value-integer no-undo .
       11   define output parameter p-value-logical like ub.thbj-attr.property-value-logical no-undo .
       12   define output parameter p-param-type as character no-undo .
       13   define temp-table tt0-thbj-attr no-undo like ub.thbj-attr.
       14   define input-output parameter table for tt0-thbj-attr append.
       15   define variable vss-revision    as character no-undo init "$Revision$":U .
       16   define variable vss-author      as character no-undo init "$Author$":U .
       17   define variable vss-date        as character no-undo init "$Date$":U .
       18   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       19   define variable vss-archive     as character no-undo init "$Archive$":U .
       20   define variable vss-description as character no-undo init "Получение, установка начальных значений и проверка  для атрибутов настройки - фирмы магазина склада".
       21   procedure vss-get-info :
       22     define output parameter p-vss-revision    like vss-revision    no-undo .
       23     define output parameter p-vss-author      like vss-author      no-undo .
       24     define output parameter p-vss-date        like vss-date        no-undo .
       25     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       26     define output parameter p-vss-archive     like vss-archive     no-undo .
       27     define output parameter p-vss-description like vss-description no-undo .
       28     assign
       29       p-vss-revision    = vss-revision
       30       p-vss-author      = vss-author
       31       p-vss-date        = vss-date
       32       p-vss-workfile    = vss-workfile
       33       p-vss-archive     = vss-archive
       34       p-vss-description = vss-description
       35     .
       36   end procedure.
       37   procedure vss-get-parameters :
       38     define output parameter p-vss-parameters as character no-undo .
       39       assign
       40         p-vss-parameters = substitute('&1|&2|&3|&4|&5':u, p-mode, p-obj-type, p-obj-code, p-upper-param-code, p-param-code)
       41       .
       42   end procedure.
       43   define new global shared variable g#vssrevis-logger as handle    no-undo .
       44   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       45   define variable v-vssrevis-logger                   as handle    no-undo .
       46   procedure vss-logevent :
       47     define input  parameter p-extra-paramters as character no-undo .
       48     define variable v-vssrevis-parameters as character no-undo .
       49     do
       50     on error undo, return error return-value
       51     :
       52       if  valid-handle(v-vssrevis-logger)
       53       and v-vssrevis-logger :get-signature("logevent") <> ""
       54       then do:
       55         run vss-get-parameters in this-procedure
       56           (output v-vssrevis-parameters
       57           ).
       58         run logevent in v-vssrevis-logger
       59           (input vss-workfile
       60           ,input vss-revision
       61           ,input v-vssrevis-parameters
       62           ,input p-extra-paramters
       63           ).
       64       end.
       65     end.
       66   end procedure.
       67   assign
       68     v-vssrevis-logger = g#vssrevis-logger
       69   .
       70   if  valid-handle(v-vssrevis-logger)
       71   and v-vssrevis-logger :get-signature("logevent") <> ""
       72   then do:
       73     assign
       74       v-vssrevis-logevent = true
       75     .
       76     run vss-logevent in this-procedure (input vss-description) .
       77   end.
       78   define new global shared variable g#language as character no-undo .
       79   if g#language <> '' and g#language <> 'rus':U then do:
       80     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       81   end.
       82   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)Workfile: str-glbt.p Revision ".
       83   define new global shared variable g#library  as handle no-undo .
       84   define new global shared variable g#library2 as handle no-undo .
       85   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   define new global shared variable g#attr-lib  as handle no-undo .
       87   define variable v-attr-lib-variable as handle no-undo .
       88   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
