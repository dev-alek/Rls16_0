     2100                   if p-param-code = '':U or p-param-code = entry(v-ii, v-prop-code) then do:               v-to-create = no.                                                            run create-thbj-attr in this-procedure ( input entry(v-ii, v-prop-code)                                               ,input "logical"                                                   ,input v-level-way                                                  ,input v-level-way-2                                                ,input v-up-way                                                     ,output v-to-create) no-error.         if v-to-create then do:                                                        if not available stt0-thbj-attr then do:                              assign                                                                          tt0-thbj-attr.property-value-logical = no                  p-value-logical = (if p-param-code = entry(v-ii, v-prop-code)                                                  then no                                                     else p-value-logical)  .                               end.                                                                               else do:                                                                         p-value-logical = (if p-param-code = entry(v-ii, v-prop-code)                                                  then stt0-thbj-attr.property-value-logical                                      else p-value-logical)  .                               end.                                                                              end.                                                                                else do:                                                                          assign                                                                              p-value-logical = (if p-param-code = entry(v-ii, v-prop-code)                                                    then stt0-thbj-attr.property-value-logical                                      else p-value-logical)  .                             end.                                                                              end.
     2101                 end.
     2102               v-prop-code = "~
     2103   minparolAdm,~
     2104   minparol,~
     2105   TimeAvailAdm,~
     2106   TimeAvail,~
     2107   TimeBlockAdm,~
     2108   TimeBlock,~
     2109   LastPaswdAdm,~
     2110   LastPaswd".
     2111                   do v-ii = 1 to num-entries(v-prop-code):
     2112                     if p-param-code = '':U or p-param-code = entry(v-ii, v-prop-code) then do:               v-to-create = no.                                                            run create-thbj-attr in this-procedure ( input entry(v-ii, v-prop-code)                                               ,input "integer"                                                   ,input v-level-way                                                  ,input v-level-way-2                                                ,input v-up-way                                                     ,output v-to-create) no-error.         if v-to-create then do:                                                        if not available stt0-thbj-attr then do:                              assign                                                                          tt0-thbj-attr.property-value-integer = 0                  p-value-integer = (if p-param-code = entry(v-ii, v-prop-code)                                                  then 0                                                     else p-value-integer)  .                               end.                                                                               else do:                                                                         p-value-integer = (if p-param-code = entry(v-ii, v-prop-code)                                                  then stt0-thbj-attr.property-value-integer                                      else p-value-integer)  .                               end.                                                                              end.                                                                                else do:                                                                          assign                                                                              p-value-integer = (if p-param-code = entry(v-ii, v-prop-code)                                                    then stt0-thbj-attr.property-value-integer                                      else p-value-integer)  .                             end.                                                                              end.
     2113                   end.
     2114               end.
     2115       when 'izt-rul':U then do:
     2116         v-prop-code = "izt-rul".
     2117         do v-ii = 1 to num-entries(v-prop-code):
     2118           if p-param-code = '':U or p-param-code = entry(v-ii, v-prop-code) then do:               v-to-create = no.                                                            run create-thbj-attr in this-procedure ( input entry(v-ii, v-prop-code)                                               ,input "character"                                                   ,input v-level-way                                                  ,input v-level-way-2                                                ,input v-up-way                                                     ,output v-to-create) no-error.         if v-to-create then do:                                                        if not available stt0-thbj-attr then do:                              assign                                                                          tt0-thbj-attr.property-value-character = 'ie-rest,true,true,false,true,true;ie-norest,true,true,false,true,true;iv-rest,true,true,false,true,true;iv-norest,true,true,false,true,true;mf_ie-rest,true,true,true,true,true;mf_ie-norest,true,true,false,true,true;ee-rest,true,true,true,true,true;ee-norest,true,true,false,true,true;ev-rest,true,true,true,true,true;ev-norest,true,true,false,true,true;cli_ev-rest,true,true,true,true,true;cli_ev-norest,true,true,false,true,true;mf_ee-rest,true,true,true,true,true;mf_ee-norest,true,true,false,true,true;cli_mf_ee-rest,true,true,false,true,true;cli_mf_ee-norest,true,true,false,true,true;ОП-rest,true,true,false,true,true;ОП-norest,true,true,false,true,true;ОР-rest,true,true,false,true,true;ОР-norest,true,true,false,true,true;cli_ОР-rest,true,true,false,true,true;cli_ОР-norest,true,true,false,true,true;ОО-rest,true,true,false,true,true;ОО-norest,true,true,false,true,true;cli_ОО-rest,true,true,false,true,true;cli_ОО-norest,true,true,false,true,true;ОФ-rest,true,true,false,true,true;ОФ-norest,true,true,false,true,true;ПО-rest,true,true,false,true,true;ПО-norest,true,true,false,true,true;rcv-rest,true,true,true,true,true;rcv-norest,true,true,false,true,true;cli_rcv-rest,true,true,false,true,true;cli_rcv-norest,true,true,false,true,true;scu-grp-matr,true,true,false,true,true;scu-grp-specif,true,true,false,true,true;delete-matr-rest,false,false,false,false,true;delete-matr-norest,false,false,true,false,true;ФП-rest,true,true,false,true,true;ФП-norest,true,true,false,true,true':U                  p-value-character = (if p-param-code = entry(v-ii, v-prop-code)                                                  then 'ie-rest,true,true,false,true,true;ie-norest,true,true,false,true,true;iv-rest,true,true,false,true,true;iv-norest,true,true,false,true,true;mf_ie-rest,true,true,true,true,true;mf_ie-norest,true,true,false,true,true;ee-rest,true,true,true,true,true;ee-norest,true,true,false,true,true;ev-rest,true,true,true,true,true;ev-norest,true,true,false,true,true;cli_ev-rest,true,true,true,true,true;cli_ev-norest,true,true,false,true,true;mf_ee-rest,true,true,true,true,true;mf_ee-norest,true,true,false,true,true;cli_mf_ee-rest,true,true,false,true,true;cli_mf_ee-norest,true,true,false,true,true;ОП-rest,true,true,false,true,true;ОП-norest,true,true,false,true,true;ОР-rest,true,true,false,true,true;ОР-norest,true,true,false,true,true;cli_ОР-rest,true,true,false,true,true;cli_ОР-norest,true,true,false,true,true;ОО-rest,true,true,false,true,true;ОО-norest,true,true,false,true,true;cli_ОО-rest,true,true,false,true,true;cli_ОО-norest,true,true,false,true,true;ОФ-rest,true,true,false,true,true;ОФ-norest,true,true,false,true,true;ПО-rest,true,true,false,true,true;ПО-norest,true,true,false,true,true;rcv-rest,true,true,true,true,true;rcv-norest,true,true,false,true,true;cli_rcv-rest,true,true,false,true,true;cli_rcv-norest,true,true,false,true,true;scu-grp-matr,true,true,false,true,true;scu-grp-specif,true,true,false,true,true;delete-matr-rest,false,false,false,false,true;delete-matr-norest,false,false,true,false,true;ФП-rest,true,true,false,true,true;ФП-norest,true,true,false,true,true':U                                                     else p-value-character)  .                               end.                                                                               else do:                                                                         p-value-character = (if p-param-code = entry(v-ii, v-prop-code)                                                  then stt0-thbj-attr.property-value-character                                      else p-value-character)  .                               end.                                                                              end.                                                                                else do:                                                                          assign                                                                              p-value-character = (if p-param-code = entry(v-ii, v-prop-code)                                                    then stt0-thbj-attr.property-value-character                                      else p-value-character)  .                             end.                                                                              end.
     2119         end.
     2120       end.
     2121     END CASE.
     2122     run get-param-value in this-procedure no-error .
     2123     if error-status:error then do:
     2124       undo, return error substitute( "&1 &2 &3 &4"
     2125                                     , vss-workfile
     2126                                     , vss-revision
     2127                                     , vss-description
     2128                                     , return-value ).
     2129     end.
     2130   end.
     2131   procedure get-param-value :
     2132   define variable v-prop-list as character no-undo .
     2133   define variable v-prop-type-list as character no-undo .
     2134   define variable v-prop-label-list as character no-undo .
     2135   define variable v-global as logical no-undo .
     2136   define variable v-host as logical no-undo .
     2137   define variable v-shop as logical no-undo .
     2138   define variable v-store as logical no-undo .
     2139   define variable v-db as logical   no-undo .
     2140   define variable v-region as logical   no-undo .
     2141     do
     2142     on error undo, return error
     2143     :
     2144       if p-param-code <> "":U then do:
     2145         run thbjattr_code_reg  in this-procedure (
     2146                                                input v-upper-param-code
     2147                                               ,input '':U
     2148                                               ,output attr-label
     2149                                               ,output attr-user-can-edit
     2150                                               ,output attr-output-display
     2151                                               ,output attr-other
     2152                                               ,output v-prop-list
     2153                                               ,output v-prop-type-list
     2154                                               ,output v-prop-label-list
     2155                                               ,output v-global
     2156                                               ,output v-host
     2157                                               ,output v-shop
     2158                                               ,output v-store
     2159                                               ,output v-db
     2160                                               ,output v-region
     2161                                             ) no-error.
     2162         if error-status:error then do:
     2163           undo, return error substitute( "&1 &2 &3 &4"
     2164                                         , vss-workfile
     2165                                         , vss-revision
     2166                                         , vss-description
     2167                                         , return-value ).
     2168         end.
     2169         if lookup(p-param-code, v-prop-list) = 0 then do:
     2170           return error substitute("Неверное имя параметра  &1", p-param-code).
     2171         end.
     2172       end.
     2173     end.
     2174   end procedure.
     2175   procedure check-param-value :
     2176   define variable v-prop-list as character no-undo .
     2177   define variable v-prop-type-list as character no-undo .
     2178   define variable v-prop-label-list as character no-undo .
     2179   define variable v-global as logical no-undo .
     2180   define variable v-host as logical no-undo .
     2181   define variable v-shop as logical no-undo .
     2182   define variable v-store as logical no-undo .
     2183   define variable v-db as logical   no-undo .
     2184   define variable v-region as logical   no-undo .
     2185   define variable v-jj as integer no-undo .
     2186   define buffer buf_tt0-thbj-attr for tt0-thbj-attr.
     2187     do
     2188     on error undo, return error
     2189     :
     2190       if attr-other = '':U then do:
     2191         run thbjattr_code_reg  in this-procedure (
     2192                                                input v-upper-param-code
     2193                                               ,input '':U
     2194                                               ,output attr-label
     2195                                               ,output attr-user-can-edit
     2196                                               ,output attr-output-display
     2197                                               ,output attr-other
     2198                                               ,output v-prop-list
     2199                                               ,output v-prop-type-list
     2200                                               ,output v-prop-label-list
     2201                                               ,output v-global
     2202                                               ,output v-host
     2203                                               ,output v-shop
     2204                                               ,output v-store
     2205                                               ,output v-db
     2206                                               ,output v-region
     2207                                             ) no-error.
     2208         if error-status:error then do:
     2209           undo, return error substitute( "&1 &2 &3 &4"
     2210                                         , vss-workfile
     2211                                         , vss-revision
     2212                                         , vss-description
     2213                                         , return-value ).
     2214         end.
     2215         if p-obj-type = 'маг':U and not v-shop
     2216         or p-obj-type = 'скл':U and not v-store
     2217         or p-obj-type = 'орг':U and not v-host
     2218         or p-obj-type = 'БД':U and not v-db
     2219         or p-obj-type = 'регион':U and not v-region
     2220         or p-obj-type = '' and not v-global then do:
     2221           undo, return error substitute( "&1 &2 &3 &4 Не предусмотрено создание секции параметров &5 для объекта TH тип &6"
     2222                                         , vss-workfile
     2223                                         , vss-revision
     2224                                         , vss-description
     2225                                         , p-upper-param-code
     2226                                         , p-obj-type
     2227                                         , return-value ).
     2228         end.
     2229       end.
     2230       for each tt0-thbj-attr
     2231       by tt0-thbj-attr.prop-code
     2232       :
     2233         if tt0-thbj-attr.prop-code = '':U then next.
     2234         if lookup(tt0-thbj-attr.prop-code, v-prop-list) = 0 then do:
     2235           return error substitute("Неверное имя параметра  &1", tt0-thbj-attr.prop-code).
     2236         end.
     2237         if entry(lookup(tt0-thbj-attr.prop-code, v-prop-list), v-prop-type-list) <> tt0-thbj-attr.prop-value-type then do:
     2238           return error substitute("Неверный тип параметра &1 - &2&3должен быть &4"
     2239                                   ,tt0-thbj-attr.prop-code
     2240                                   ,tt0-thbj-attr.prop-value-type
     2241                                   ,chr(10)
     2242                                   ,entry(lookup(tt0-thbj-attr.prop-code, v-prop-list), v-prop-type-list)
     2243                                   ).
     2244         end.
     2245         if tt0-thbj-attr.obj-type <> p-obj-type
     2246         or tt0-thbj-attr.obj-code <> p-obj-code then do:
     2247           find first buf_tt0-thbj-attr where
     2248                     buf_tt0-thbj-attr.prop-code = tt0-thbj-attr.prop-code
     2249                and buf_tt0-thbj-attr.obj-type = p-obj-type
     2250                and buf_tt0-thbj-attr.obj-code = p-obj-code no-error.
     2251           if not available buf_tt0-thbj-attr then do:
     2252             assign
     2253             v-jj = v-jj + 1.
     2254             .
     2255           end.
     2256           else do:
     2257             delete tt0-thbj-attr.
     2258           end.
     2259         end.
     2260         else do:
     2261           v-jj = v-jj + 1.
     2262         end.
     2263       end.
     2264       if num-entries(v-prop-list) <> v-jj then do:
     2265         return error substitute("Неверное количество параметров в &1 - &2, должно быть &3"
     2266                                 , v-upper-param-code
     2267                                 , v-jj
     2268                                 , num-entries(v-prop-list)
     2269                                 ).
     2270       end.
     2271     end.
     2272   end procedure.
     2273   procedure create-thbj-attr :
     2274   define input parameter p-prop-code as character no-undo .
     2275   define input parameter p-type as character no-undo .
     2276   define input parameter p-level-way as character no-undo .
     2277   define input parameter p-level-way-2 as character no-undo .
     2278   define input parameter p-up-way as character no-undo .
     2279   define output parameter v-to-create as logical no-undo .
     2280   define variable v-ii as integer no-undo .
     2281   define variable v-up-way as character no-undo .
     2282   define variable v-level-way as character no-undo .
     2283   define variable v-level-way-2 as character no-undo .
     2284   do
     2285   on error undo, return error
     2286   :
     2287     v-to-create = no.
     2288     _do:
     2289     do v-ii = 1 to num-entries(p-up-way):
     2290       assign
     2291       v-up-way = entry(v-ii, p-up-way)
     2292       v-level-way = entry(v-ii, p-level-way)
     2293       v-level-way-2 = entry(v-ii, p-level-way-2)
     2294       .
     2295       find first stt0-thbj-attr where
     2296                 stt0-thbj-attr.prop-code = p-prop-code
     2297             and stt0-thbj-attr.upper-prop-code = v-up-way
     2298             and stt0-thbj-attr.obj-type = v-level-way
     2299             and stt0-thbj-attr.obj-code = integer(v-level-way-2) no-error.
     2300       if not available stt0-thbj-attr then do:
     2301         if v-ii = 1 then do:
     2302           v-to-create = yes.
     2303         end.
     2304       end.
     2305       else do:
     2306         if v-ii >= 1 then leave _do.
     2307       end.
     2308     end.
     2309     if v-to-create then do:
     2310       create tt0-thbj-attr.
     2311       assign
     2312       tt0-thbj-attr.obj-type = p-obj-type
     2313       tt0-thbj-attr.obj-code = p-obj-code
     2314       tt0-thbj-attr.upper-prop-code = p-upper-param-code
     2315       tt0-thbj-attr.prop-code = p-prop-code
     2316       tt0-thbj-attr.prop-value-type = p-type
     2317       .
     2318       if available stt0-thbj-attr then do:
     2319         buffer-copy stt0-thbj-attr except obj-type obj-code upper-prop-code to tt0-thbj-attr.
     2320       end.
     2321     end.
     2322   end.
     2323   end procedure.
