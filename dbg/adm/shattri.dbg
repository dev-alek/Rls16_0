       90   procedure thbjattr_code :
       91      define input  parameter p-upper-code     as character no-undo .
       92      define input  parameter p-code           as character no-undo .
       93      define output parameter p-label          as character no-undo .
       94      define output parameter p-user-can-edit  as logical   no-undo .
       95      define output parameter p-output-display as logical   no-undo .
       96      define output parameter p-other          as character no-undo .
       97      define output parameter p-prop-list      as character no-undo .
       98      define output parameter p-prop-type-list as character no-undo .
       99      define output parameter p-prop-label-list as character no-undo .
      100      define output parameter p-global          as logical no-undo .
      101      define output parameter p-host           as logical no-undo .
      102      define output parameter p-shop           as logical no-undo .
      103      define output parameter p-store          as logical no-undo .
      104      define output parameter p-db             as logical no-undo .
      105      define variable p-region as logical no-undo.
      106      run thbjattr_code_reg in this-procedure (
      107                                               p-upper-code,
      108                                               p-code,
      109                                               output p-label,
      110                                               output p-user-can-edit,
      111                                               output p-output-display,
      112                                               output p-other,
      113                                               output p-prop-list,
      114                                               output p-prop-type-list,
      115                                               output p-prop-label-list,
      116                                               output p-global,
      117                                               output p-host,
      118                                               output p-shop,
      119                                               output p-store,
      120                                               output p-db,
      121                                               output p-region
      122                                               ).
      123   end procedure.
      124   procedure thbjattr_code_reg :
      125   define input  parameter p-upper-code     as character no-undo .
      126   define input  parameter p-code           as character no-undo .
      127   define output parameter p-label          as character no-undo .
      128   define output parameter p-user-can-edit  as logical   no-undo .
      129   define output parameter p-output-display as logical   no-undo .
      130   define output parameter p-other          as character no-undo .
      131   define output parameter p-prop-list      as character no-undo .
      132   define output parameter p-prop-type-list as character no-undo .
      133   define output parameter p-prop-label-list as character no-undo .
      134   define output parameter p-global          as logical no-undo .
      135   define output parameter p-host           as logical no-undo .
      136   define output parameter p-shop           as logical no-undo .
      137   define output parameter p-store          as logical no-undo .
      138   define output parameter p-db             as logical no-undo .
      139   define output parameter p-region         as logical no-undo .
      140   do
      141   on error undo, return error return-value
      142   :
      143       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      144       (input  p-upper-code
      145       ,input  p-code
      146       ,output p-label
      147       ,output p-user-can-edit
      148       ,output p-output-display
      149       ,output p-other
      150       ,output p-prop-list
      151       ,output p-prop-type-list
      152       ,output p-prop-label-list
      153       ,output p-global
      154       ,output p-host
      155       ,output p-shop
      156       ,output p-store
      157       ,output p-db
      158       ,output p-region
      159       ) no-error .
      160     if error-status :error
      161     then do:
      162       undo, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message (1)).
      163     end.
      164   end.
      165   end procedure.
