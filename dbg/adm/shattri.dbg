      707         do v-ii = 1 to num-entries(v-prop-code):
      708           if p-param-code = '':U or p-param-code = entry(v-ii, v-prop-code) then do:               v-to-create = no.                                                            run create-thbj-attr in this-procedure ( input entry(v-ii, v-prop-code)                                               ,input "logical"                                                   ,input v-level-way                                                  ,input v-level-way-2                                                ,input v-up-way                                                     ,output v-to-create) no-error.         if v-to-create then do:                                                        if not available stt0-thbj-attr then do:                              assign                                                                          tt0-thbj-attr.property-value-logical = no                  p-value-logical = (if p-param-code = entry(v-ii, v-prop-code)                                                  then no                                                     else p-value-logical)  .                               end.                                                                               else do:                                                                         p-value-logical = (if p-param-code = entry(v-ii, v-prop-code)                                                  then stt0-thbj-attr.property-value-logical                                      else p-value-logical)  .                               end.                                                                              end.                                                                                else do:                                                                          assign                                                                              p-value-logical = (if p-param-code = entry(v-ii, v-prop-code)                                                    then stt0-thbj-attr.property-value-logical                                      else p-value-logical)  .                             end.                                                                              end.
      709         end.
      710         v-prop-code = "autofbr,restdish,restingr".
      711         do v-ii = 1 to num-entries(v-prop-code):
      712           if p-param-code = '':U or p-param-code = entry(v-ii, v-prop-code) then do:               v-to-create = no.                                                            run create-thbj-attr in this-procedure ( input entry(v-ii, v-prop-code)                                               ,input "logical"                                                   ,input v-level-way                                                  ,input v-level-way-2                                                ,input v-up-way                                                     ,output v-to-create) no-error.         if v-to-create then do:                                                        if not available stt0-thbj-attr then do:                              assign                                                                          tt0-thbj-attr.property-value-logical = yes                  p-value-logical = (if p-param-code = entry(v-ii, v-prop-code)                                                  then yes                                                     else p-value-logical)  .                               end.                                                                               else do:                                                                         p-value-logical = (if p-param-code = entry(v-ii, v-prop-code)                                                  then stt0-thbj-attr.property-value-logical                                      else p-value-logical)  .                               end.                                                                              end.                                                                                else do:                                                                          assign                                                                              p-value-logical = (if p-param-code = entry(v-ii, v-prop-code)                                                    then stt0-thbj-attr.property-value-logical                                      else p-value-logical)  .                             end.                                                                              end.
      713         end.
      714         v-prop-code = "neg-tpsi-qnty".
      715         do v-ii = 1 to num-entries(v-prop-code):
      716           if p-param-code = '':U or p-param-code = entry(v-ii, v-prop-code) then do:               v-to-create = no.                                                            run create-thbj-attr in this-procedure ( input entry(v-ii, v-prop-code)                                               ,input "decimal"                                                   ,input v-level-way                                                  ,input v-level-way-2                                                ,input v-up-way                                                     ,output v-to-create) no-error.         if v-to-create then do:                                                        if not available stt0-thbj-attr then do:                              assign                                                                          tt0-thbj-attr.property-value-decimal = 0.0                  p-value-decimal = (if p-param-code = entry(v-ii, v-prop-code)                                                  then 0.0                                                     else p-value-decimal)  .                               end.                                                                               else do:                                                                         p-value-decimal = (if p-param-code = entry(v-ii, v-prop-code)                                                  then stt0-thbj-attr.property-value-decimal                                      else p-value-decimal)  .                               end.                                                                              end.                                                                                else do:                                                                          assign                                                                              p-value-decimal = (if p-param-code = entry(v-ii, v-prop-code)                                                    then stt0-thbj-attr.property-value-decimal                                      else p-value-decimal)  .                             end.                                                                              end.
      717         end.
      718         v-prop-code = "tpsi-mode".
      719         if p-param-code = '':U or p-param-code = v-prop-code then do:               v-to-create = no.                                                            run create-thbj-attr in this-procedure ( input v-prop-code                                               ,input "integer"                                                   ,input v-level-way                                                  ,input v-level-way-2                                                ,input v-up-way                                                     ,output v-to-create) no-error.         if v-to-create then do:                                                        if not available stt0-thbj-attr then do:                              assign                                                                          tt0-thbj-attr.property-value-integer = 1                  p-value-integer = (if p-param-code = v-prop-code                                                  then 1                                                     else p-value-integer)  .                               end.                                                                               else do:                                                                         p-value-integer = (if p-param-code = v-prop-code                                                  then stt0-thbj-attr.property-value-integer                                      else p-value-integer)  .                               end.                                                                              end.                                                                                else do:                                                                          assign                                                                              p-value-integer = (if p-param-code = v-prop-code                                                    then stt0-thbj-attr.property-value-integer                                      else p-value-integer)  .                             end.                                                                              end.
      720         v-prop-code = "close-in-rfsl".
