      422   define variable v-dflt-level-way as character no-undo .
      423   define variable v-dflt-up-way as character no-undo .
      424   define variable v-start as integer no-undo .
      425   define variable v-step as integer no-undo .
      426   define variable v-reg-code as integer no-undo .
      427   define buffer buf_scales for ub.scales.
      428   define buffer buf_cash-pay for ub.cash-pay.
      429   define buffer buf_cash-pay-bnal for ub.cash-pay.
      430   define buffer buf_cash-pay-nal for ub.cash-pay.
      431   define buffer buf_cash-pay-ntnal for ub.cash-pay.
      432   define buffer stt0-thbj-attr for tt0-thbj-attr.
      433   define buffer buf_tt0-thbj-attr for tt0-thbj-attr.
      434   define buffer buf_shop for ub.shop.
      435   define buffer buf_firm for ub.firm.
      436   define buffer buf_sysconf for ub.sysconf.
      437   define buffer cli_obj for ub.clients.
      438   do
      439   on error undo, return error
      440   :
      441     v-upper-param-code = p-upper-param-code.
      442     if p-obj-type <> "":U
      443     and p-obj-type <> 'орг':U
      444     and p-obj-type <> 'маг':U
      445     and p-obj-type <> 'скл':U
      446     and p-obj-type <> 'БД':U
      447     and p-obj-type <> 'регион':U
      448     then do:
      449       undo, return error substitute( "&1 &2 &3 Неверное значение p-obj-type &4"
      450                                     , vss-workfile
      451                                     , vss-revision
      452                                     , vss-description
      453                                     , p-obj-type ).
      454     end.
      455     if p-mode = "check":U then do:
      456       run check-param-value in this-procedure no-error .
      457       if error-status:error then do:
      458           undo, return error substitute( "&1 &2 &3 &4"
      459                                         , vss-workfile
      460                                         , vss-revision
      461                                         , vss-description
      462                                         , return-value ).
      463       end.
      464       return.
      465     end.
      466     assign
      467     v-obj-type = p-obj-type
      468     v-obj-code = p-obj-code
      469     .
      470     if p-mode = "get":U
      471     or p-mode = "init":U
      472     then do:
      473       run thbjattr_legacy in this-procedure ( input p-upper-param-code
      474                                              ,output v-dflt-level-way
      475                                              ,output v-dflt-up-way).
      476       case p-obj-type:
      477           when 'маг':U or
      478           when 'скл':U then do:
      479             v-start = 1.
      480           end.
      481           when 'БД':U then do:
      482             if lookup("db", v-dflt-level-way) = 1
      483             then v-start = 1.
      484             else v-start = 2.
      485           end.
      486           when 'регион':U then do:
      487             v-start = 2.
      488           end.
      489           when 'орг':U
      490           then do:
      491             v-start = 2.
      492           end.
      493           when '' then do:
      494             v-start = 3.
      495           end.
      496       end case.
      497       _step:
      498       do v-step = v-start to 3:
      499         if  entry(v-step, v-dflt-level-way) = '' then do:
      500           if v-step = v-start then do:
      501           end.
      502           else do:
      503             next _step.
      504           end.
      505         end.
      506         v-upper-param-code = entry(v-step, v-dflt-up-way).
      507         case v-step:
      508           when 1 then do:
      509             case p-obj-type:
      510               when 'маг':U then do:
      511                 v-obj-type = 'маг':U.
      512                 v-obj-code = v-obj-code.
      513               end.
      514               when 'скл':U then do:
      515                 v-obj-type = 'скл':U.
      516                 v-obj-code = v-obj-code.
      517               end.
      518               when 'орг':U then do:
      519               end.
      520               when 'БД':U then do:
      521                 v-obj-type = 'БД':U.
      522                 v-obj-code = p-obj-code.
      523               end.
      524               when '' then do:
      525               end.
      526             end case.
      527           end.
      528           when 2 then do:
      529             case p-obj-type:
      530               when 'маг':U
      531               or
      532               when 'скл':U
      533               then do:
      534                 if not v-host then next _step.
      535                 v-obj-type = 'орг':U.
      536   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      537   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      538     (input  p-obj-type
      539     ,input  p-obj-code
      540     ,output v-host-code
      541     )  .
      542                 v-obj-code = v-host-code.
      543               end.
      544               when 'орг':U then do:
      545                 v-obj-type = 'орг':U.
      546                 v-obj-code = p-obj-code.
      547               end.
      548               when 'БД':U then do:
      549                 if lookup("region", v-dflt-level-way) = 2
      550                 then do:
      551                     v-obj-type = 'регион':U.
      552   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      553   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run regcode in g#library
      554     (input  p-obj-type
      555     ,input  p-obj-code
      556     ,output v-reg-code
      557     )  .
      558                     v-obj-code = v-reg-code.
      559                 end.
      560                 else do:
      561                     v-obj-type = 'БД':U.
      562                     v-obj-code = p-obj-code.
      563                 end.
      564               end.
      565               when 'регион':U then do:
      566                 v-obj-type = 'регион':U.
      567                 v-obj-code = p-obj-code.
      568               end.
      569               when '' then do:
      570               end.
      571             end case.
      572           end.
      573           when 3 then do:
      574             if p-obj-type <> ''
      575             and not v-global then next _step.
      576             v-obj-type = ''.
      577             v-obj-code = 0.
      578           end.
      579         end case.
      580         v-level-way = v-level-way + (if v-level-way = '' then '' else chr(44)) + v-obj-type.
      581         v-level-way-2 = v-level-way-2 + (if v-level-way-2 = '' then '' else chr(44))  + string(v-obj-code).
      582         v-up-way = v-up-way + (if v-up-way = "" then "" else chr(44)) +  entry(v-step, v-dflt-up-way).
      583         if p-param-code = '':U then do:
      584           run thbjattr_get-section  in this-procedure (
      585                                                input v-obj-type
      586                                               ,input v-obj-code
      587                                               ,input v-upper-param-code
      588                                               ,input p-mode
      589                                               ,input-output table tt0-thbj-attr
      590                                               ,output v-found
      591                                               ) no-error.
      592         end.
      593         else do:
      594           run thbjattr_value  in this-procedure (
      595                                                input v-obj-type
      596                                               ,input v-obj-code
      597                                               ,input v-upper-param-code
      598                                               ,input p-param-code
      599                                               ,output p-value-character
      600                                               ,output p-value-date
      601                                               ,output p-value-decimal
      602                                               ,output p-value-integer
      603                                               ,output p-value-logical
      604                                               ,output v-attr-type
      605                                               ,output v-found
      606                                               ) no-error.
      607         end.
      608         if error-status:error then do:
      609           undo, return error substitute( "&1 &2 &3 &4 &5"
      610                                         , vss-workfile
      611                                         , vss-revision
      612                                         , vss-description
      613                                         , error-status:get-message(1)
      614                                         , return-value ).
      615         end.
      616         if v-found = 1.0
      617         and v-step = v-start
      618         then do:
      619           return.
      620         end.
      621           run thbjattr_code_reg in this-procedure (
      622            input  v-upper-param-code
      623           ,input p-param-code
      624           ,output attr-label
      625           ,output attr-user-can-edit
      626           ,output attr-output-display
      627           ,output attr-other
      628           ,output v-prop-list
      629           ,output v-prop-type-list
      630           ,output v-prop-label-list
      631           ,output v-global
      632           ,output v-host
      633           ,output v-shop
      634           ,output v-store
      635           ,output v-db
      636           ,output v-region
      637           ) no-error .
      638         if error-status:error then do:
      639           undo, return error substitute( "&1 &2 &3 Неверное значение v-upper-param-code &4 или p-param-code &5"
      640                                         , vss-workfile
      641                                         , vss-revision
      642                                         , vss-description
      643                                         , v-upper-param-code
      644                                         , p-param-code
      645                                         ).
      646         end.
      647         v-need-prop-list = v-prop-list.
      648         v-num-need = num-entries(v-prop-list).
      649         if v-found = 1.0 or (v-found > 0 and v-step <> v-start) then do:
      650           if p-param-code <> '' then return.
      651           if p-param-code = '':U
      652           and p-obj-type <> v-obj-type then do:
      653             for each tt0-thbj-attr
      654                 where tt0-thbj-attr.obj-type = v-obj-type:
      655               if lookup(tt0-thbj-attr.prop-code,  v-need-prop-list) = 0
      656               and entry(1, tt0-thbj-attr.upper-prop-code, "_") = p-upper-param-code
      657               then do:
      658                 delete tt0-thbj-attr.
      659                 next.
      660               end.
      661               v-to-find-upper-param-code = (if tt0-thbj-attr.upper-prop-code <> p-upper-param-code
      662                                           and  num-entries(p-upper-param-code, "_") > 1
      663                                           and (entry(2, p-upper-param-code, "_") = "obj"
      664                                                 or
      665                                                 entry(2, p-upper-param-code, "_") = "host"
      666                                                 or
      667                                                 entry(2, p-upper-param-code, "_") = "db"
      668                                                 or
      669                                                 entry(2, p-upper-param-code, "_") = "region"
      670                                                 )
      671                                           then p-upper-param-code
      672                                           else tt0-thbj-attr.upper-prop-code
      673                                           ).
      674               find first buf_tt0-thbj-attr where
      675                       buf_tt0-thbj-attr.obj-type = p-obj-type
      676                   and buf_tt0-thbj-attr.obj-code = p-obj-code
      677                   and buf_tt0-thbj-attr.upper-prop-code = v-to-find-upper-param-code
      678                   and buf_tt0-thbj-attr.prop-code = tt0-thbj-attr.prop-code no-error .
      679               if not available buf_tt0-thbj-attr then do:
      680                 create buf_tt0-thbj-attr.
      681                 buffer-copy tt0-thbj-attr except obj-type obj-code upper-prop-code
      682                 to buf_tt0-thbj-attr
      683                 assign
      684                 buf_tt0-thbj-attr.obj-type = p-obj-type
      685                 buf_tt0-thbj-attr.obj-code = p-obj-code
      686                 buf_tt0-thbj-attr.upper-prop-code = v-to-find-upper-param-code
      687                 .
      688                 delete tt0-thbj-attr.
      689               end.
      690               else delete tt0-thbj-attr.
      691               v-num-found = v-num-found + 1.
      692           end.
      693         end.
      694         if v-num-need = v-num-found then do:
      695           return.
      696         end.
      697         end.
      698       end.
      699     end.
      700     CASE p-upper-param-code:
      701       when 'autosale':U then do:
      702         v-prop-code = "automail,augetres,autoclos," +
      703                       "autocomp,autocalc,one-curs," +
