     2871     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2872     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2873     if p-change-value > 0
     2874     then do:
     2875       if frame Dialog-Frame :width + p-change-value >
     2876           session :width-chars
     2877       then do:
     2878         assign
     2879           p-change-value = session :width-chars - frame Dialog-Frame :width
     2880         .
     2881         if p-change-value <= 0
     2882         then do:
     2883           run diasize_position-resize-button in this-procedure .
     2884           return .
     2885         end.
     2886       end.
     2887     end.
     2888     if p-change-value < 0
     2889     then do:
     2890       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2891       then do:
     2892         assign
     2893           p-change-value = v-diasize-orig-frame-width
     2894                          - frame Dialog-Frame :width
     2895         .
     2896         if p-change-value >= 0
     2897         then do:
     2898           run diasize_position-resize-button in this-procedure .
     2899           return .
     2900         end.
     2901       end.
     2902     end.
     2903     if p-change-value >= 0
     2904     then do:
     2905       assign
     2906         v-change-sign = 1
     2907       .
     2908     end.
     2909     else do:
     2910       assign
     2911         v-change-sign = -1
     2912       .
     2913     end.
     2914     assign
     2915       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2916     .
     2917     if p-change-value = 0
     2918     then do:
     2919       run diasize_position-resize-button in this-procedure .
     2920       return .
     2921     end.
