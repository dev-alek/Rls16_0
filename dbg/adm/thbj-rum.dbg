      132     run proc-alt-shift-f4 in this-procedure.
      133   end.
      134   on alt-f1 anywhere do:
      135     run proc-alt-f1 in this-procedure .
      136   end.
      137   function diff-list returns character (
      138     input parfirst-list  as character,
      139     input parsecond-list as character,
      140     input pardelim       as character).
      141     if pardelim = ""
      142     or pardelim = ?
      143     then do:
      144       assign
      145         pardelim = ","
      146       .
      147     end.
      148     def var ind as integer no-undo .
      149     def var v-elem as character no-undo .
      150     def var v-result-list as character no-undo init "".
      151     def var v-num-parfirst-list as integer no-undo .
      152     assign
      153       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      154     .
      155     do ind = 1 to v-num-parfirst-list
      156     :
      157       assign
      158         v-elem = entry(ind, parfirst-list, pardelim)
      159       .
      160       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      161         assign
      162           v-result-list = v-result-list
      163                         + (if v-result-list > "" then pardelim else "")
      164                         + v-elem
      165         .
      166       end.
      167     end.
      168     return v-result-list .
      169   end function.
      170   function add-list returns character (
      171    input parfirst-list  as character,
      172    input parsecond-list as character,
      173    input pardelim       as character).
      174     if pardelim = ""
      175     or pardelim = ?
      176     then do:
      177       assign
      178         pardelim = ","
      179       .
      180     end.
      181     def var ind as integer no-undo .
      182     def var v-elem as character no-undo .
      183     def var v-result-list as character no-undo init "".
      184     def var v-num-parfirst-list as integer no-undo .
      185     assign
      186       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      187     .
      188     do ind = 1 to v-num-parfirst-list
      189     :
      190       assign
      191         v-elem = entry(ind, parfirst-list, pardelim)
      192       .
      193       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      194         assign
      195           v-result-list = v-result-list
      196                         + (if v-result-list > "" then pardelim else "")
      197                         + v-elem
      198         .
      199       end.
      200     end.
      201     def var v-num-parsecond-list as integer no-undo .
      202     assign
      203       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      204     .
      205     do ind = 1 to v-num-parsecond-list
      206     :
      207       assign
      208         v-elem = entry(ind, parsecond-list, pardelim)
      209       .
      210       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      211         assign
      212           v-result-list = v-result-list
      213                         + (if v-result-list > "" then pardelim else "")
      214                         + v-elem
      215         .
      216       end.
      217     end.
      218     return v-result-list .
      219   end function.
      220   function cross-list returns character (
      221    input parfirst-list  as character,
      222    input parsecond-list as character,
      223    input pardelim       as character).
      224     if pardelim = ""
      225     or pardelim = ?
      226     then do:
      227       assign
      228         pardelim = ","
      229       .
      230     end.
      231     def var ind as integer no-undo .
      232     def var v-elem as character no-undo .
      233     def var v-result-list as character no-undo init "".
      234     def var v-num-parfirst-list as integer no-undo .
      235     assign
      236       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      237     .
      238     do ind = 1 to v-num-parfirst-list
      239     :
      240       assign
      241         v-elem = entry(ind, parfirst-list, pardelim)
      242       .
      243       if lookup(v-elem, v-result-list, pardelim) = 0
      244       and lookup(v-elem, parsecond-list, pardelim) > 0
      245       then do:
      246         assign
      247           v-result-list = v-result-list
      248                         + (if v-result-list > "" then pardelim else "")
      249                         + v-elem
      250         .
      251       end.
      252     end.
      253     return v-result-list .
      254   end function.
      255   function radio-label returns character (
      256    input par-rs-value  as character,
      257    input par-rs-radio-buttons as character)
      258    .
      259    DEFINE variable v-result-label as character no-undo.
      260    assign
      261    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      262                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      263                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      264                             ), par-rs-radio-buttons
      265                           )
      266    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      267    .
      268   return v-result-label.
      269   end function.
      270   function m-radio-label returns character (
      271    input par-rs-value  as character,
      272    input par-rs-radio-buttons as character,
      273    input par-delim as character
      274    )
      275    .
      276    DEFINE variable v-result-label as character no-undo.
      277    assign
      278    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      279                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      280                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      281                             ), par-rs-radio-buttons, par-delim
      282                           )
      283    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      284    .
      285   return v-result-label.
      286   end function.
      287   FUNCTION mixlist returns character
      288   (
      289    input parfirst-list  as character
      290    ,input parsecond-list as character
      291    ,input pardelim       as character
      292    ,input pardelim-result as character ) :
      293     if pardelim = ""
      294     or pardelim = ?
      295     then do:
      296       assign
      297         pardelim = ","
      298       .
      299     end.
      300     def var ind as integer no-undo .
      301     def var v-elem1 as character no-undo .
      302     def var v-elem2 as character no-undo .
      303     def var v-result-list as character no-undo init "".
      304     do ind = 1 to num-entries(parfirst-list, pardelim)
      305     :
      306       assign
      307         v-elem1 = entry(ind, parfirst-list, pardelim)
      308         v-elem2 = entry(ind, parsecond-list, pardelim)
      309       .
      310         assign
      311           v-result-list = v-result-list
      312                         + (if v-result-list > "" then pardelim-result else "")
      313                         + v-elem1 + pardelim-result + v-elem2
      314         .
      315     end.
      316     return v-result-list .
      317   END FUNCTION.
