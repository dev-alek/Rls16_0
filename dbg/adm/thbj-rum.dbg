      543   do
      544   on error undo, return error return-value
      545   :
      546       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_set-section in g#attr-lib
      547       (input  p-obj-type
      548       ,input  p-obj-code
      549       ,input  p-upper-code
      550       ,input  table-handle p-tth
      551       ) no-error .
      552     if error-status :error
