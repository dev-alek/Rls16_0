      482   procedure thbjattr_get-section :
      483   define input  parameter p-obj-type like ub.thbj-attr.obj-type   no-undo .
      484   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
      485   define input  parameter p-upper-param-code  like ub.thbj-attr.upper-prop-code  no-undo .
      486   define input  parameter p-mode as character no-undo .
      487   define input-output parameter table-handle p-tth.
      488   define output parameter p-all-found as decimal no-undo .
      489   do
      490   on error undo, return error return-value
      491   :
      492       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_get-section in g#attr-lib
      493       (input  p-obj-type
      494       ,input  p-obj-code
      495       ,input  p-upper-param-code
      496       ,input  p-mode
      497       ,input-output table-handle p-tth
      498       ,output p-all-found
      499       ) no-error .
      500     if error-status :error
      501     then do:
      502       delete object p-tth.
      503       undo, return error return-value .
      504     end.
      505     delete object p-tth.
      506   end.
      507   end procedure.
      508   procedure thbjattr_write :
      509   define input  parameter p-obj-type like ub.thbj-attr.obj-type   no-undo .
      510   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
      511   define input  parameter p-upper-code  like ub.thbj-attr.upper-prop-code  no-undo .
      512   define input  parameter p-code     like ub.thbj-attr.prop-code  no-undo .
      513   define input  parameter p-value-character like ub.thbj-attr.property-value-character no-undo .
      514   define input  parameter p-value-date like ub.thbj-attr.property-value-date no-undo .
      515   define input  parameter p-value-decimal like ub.thbj-attr.property-value-decimal no-undo .
      516   define input  parameter p-value-integer like ub.thbj-attr.property-value-integer no-undo .
      517   define input  parameter p-value-logical like ub.thbj-attr.property-value-logical no-undo .
      518   do
      519   on error undo, return error return-value
      520   :
      521       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_write in g#attr-lib
      522       (input  p-obj-type
      523       ,input  p-obj-code
      524       ,input  p-upper-code
      525       ,input  p-code
      526       ,input  p-value-character
      527       ,input  p-value-date
      528       ,input  p-value-decimal
      529       ,input  p-value-integer
      530       ,input  p-value-logical
      531       ) no-error .
      532     if error-status :error
      533     then do:
      534       undo, return error return-value .
      535     end.
      536   end.
      537   end procedure.
      538   procedure thbjattr_set-section :
      539   define input  parameter p-obj-type like ub.thbj-attr.obj-type   no-undo .
      540   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
      541   define input  parameter p-upper-code  like ub.thbj-attr.upper-prop-code  no-undo .
