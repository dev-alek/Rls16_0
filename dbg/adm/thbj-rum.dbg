     2848   procedure diasize_set-height :
     2849     define input  parameter p-new-height  as decimal   no-undo .
     2850     define input  parameter p-move-resize as logical   no-undo .
     2851     do
     2852     on error undo, return error return-value
     2853     :
     2854       run diasize_change-height in this-procedure
     2855         (input  (p-new-height - frame Dialog-Frame :height)
     2856         ,input  p-move-resize
     2857         ) .
     2858     end.
     2859   end procedure.
     2860   procedure diasize_change-width :
     2861     define input  parameter p-change-value as decimal   no-undo .
     2862     define input  parameter p-move-resize  as logical   no-undo .
     2863     define variable v-field-group-handle   as handle    no-undo .
