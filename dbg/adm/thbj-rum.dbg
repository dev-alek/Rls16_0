      618   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      619   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      620   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      621   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      622   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      623   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      624   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      625   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      626   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      627   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      628   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      629   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      630   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      631   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      632   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      633   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      634   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      635   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      636   define variable v-r-b-code like ub.currency.curr-code no-undo .
      637   define variable v-curr-r-b  as character no-undo .
      638   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      639   procedure gen-key-rec :
      640     define input  parameter p-tbl-name    as character no-undo.
      641     define input  parameter p-bh_tbl-name as handle    no-undo.
      642     define output parameter p-key-rec     as character no-undo.
      643     do
      644     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      645     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      646     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      647     :
      648       define variable fh               as handle    no-undo .
      649       define variable v-ok             as logical   no-undo .
      650       define variable v-inform         as character no-undo .
      651       define variable v-ind            as integer   no-undo .
      652       define variable v-idx-field-qnty as integer   no-undo .
      653       if p-tbl-name = ?
      654         or p-tbl-name = "":U
      655       then do:
      656         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info4 ).
      657       end.
      658       if not p-bh_tbl-name:available then do:
      659         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info4, p-tbl-name ).
      660       end.
      661       assign
      662         p-key-rec = p-tbl-name
      663         v-inform  = p-bh_tbl-name:index-information(1)
      664         v-ind     = 2
      665       .
      666       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      667       on error undo, return error
      668       :
      669         assign
      670           v-inform = p-bh_tbl-name:index-information( v-ind )
      671           v-ind    = v-ind + 1
      672         .
      673       end.
      674       if v-inform = ?
      675         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      676         or entry( 3, v-inform, ",":U ) <> "1":U
      677       then do:
      678         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, p-tbl-name ).
      679       end.
      680       else do:
      681         assign
      682           v-idx-field-qnty = num-entries( v-inform ) - 4
      683         .
      684         if v-idx-field-qnty < 2 then do:
      685           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, p-tbl-name ).
      686         end.
      687         do v-ind = 1 to v-idx-field-qnty by 2
      688         on error undo, return error
      689         :
      690           assign
      691             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      692             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      693           .
      694         end.
      695       end.
      696       if p-key-rec = ? then do:
      697         assign
      698           p-key-rec = "":U
      699         .
      700         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info4, p-tbl-name ).
      701       end.
      702     end.
      703     return.
      704   end procedure.
      705   procedure gen-where-keyr-tab :
      706     define input  parameter i-tableSerach as character no-undo.
      707     define input  parameter i-tablekey   as character  no-undo.
      708     define input  parameter p-key-rec    as character  no-undo.
      709     define input  parameter p-key-handle as handle     no-undo .
      710     define input  parameter p-db-name    as character  no-undo .
      711     define input  parameter p-tt-handle  as handle     no-undo .
      712     define output parameter o-Where      as character  no-undo.
      713     do
      714     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      715     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      716     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      717     :
      718       define variable v-full-tbl-name  as character no-undo .
      719       define variable bh_tbl-name      as handle    no-undo .
      720       define variable fh_key           as handle    no-undo .
      721       define variable fh_search        as handle    no-undo .
      722       define variable v-field-num      as integer   no-undo .
      723       define variable v-count-fld      as integer   no-undo .
      724       define variable v-inform         as character no-undo .
      725       define variable v-ind            as integer   no-undo .
      726       define variable v-idx-field-qnty as integer   no-undo .
      727       define variable v-field-name     as character no-undo .
      728       define variable v-field-val      as character no-undo .
      729       define variable v-word-link      as character no-undo .
      730       define variable vTable           as character no-undo.
      731       define variable bh_tbl-key       as handle    no-undo .
      732       assign
      733         p-key-rec = trim( p-key-rec )
      734       .
      735       if p-key-handle <> ? then do:
      736         if not valid-handle(p-key-handle)
      737            or p-key-handle:type <> "buffer"
      738         then do:
      739           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info4 ).
      740         end.
      741         if num-entries( p-key-rec, chr(3) ) > 1
      742           or p-key-rec = ?
      743           or p-key-rec = "":U
      744         then do:
      745           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info4, p-key-rec ).
      746         end.
      747       end.
      748       else do:
      749         if p-key-rec = ?
      750           or p-key-rec = "":U
      751         then do:
      752           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      753         end.
      754       end.
      755       assign
      756         vTable = entry( 1 , p-key-rec, chr(3) )
      757       .
      758       if p-tt-handle <> ?
      759         and ( not valid-handle(p-tt-handle)
      760               or p-tt-handle:type <> "buffer"
      761             )
      762       then do:
      763         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info4, vTable, chr(10) ).
      764       end.
      765       if p-tt-handle = ? then do:
      766         assign
      767           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      768         .
      769         create buffer bh_tbl-name for table v-full-tbl-name .
      770       end.
      771       else do:
      772         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      773       end.
      774       assign
      775         v-inform = bh_tbl-name:index-information(1)
      776         v-ind    = 2
      777       .
      778       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      779       on error undo, return error
      780       :
      781         assign
      782           v-inform = bh_tbl-name:index-information( v-ind )
      783           v-ind    = v-ind + 1
      784         .
      785       end.
      786       if v-inform = ?
      787         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      788         or entry( 3, v-inform, ",":U ) <> "1":U
      789       then do:
      790         delete object bh_tbl-name no-error.
      791         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info4, vTable ).
      792       end.
      793       assign
      794         v-idx-field-qnty = num-entries( v-inform ) - 4
      795       .
      796       if v-idx-field-qnty < 2 then do:
      797         delete object bh_tbl-name no-error.
      798         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, vTable ).
      799       end.
      800       assign
      801         o-where     = "where":U
      802         v-word-link = "":U
      803         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      804         v-count-fld = 0
      805       .
      806       if i-tablekey ne "" and i-tablekey ne ?
      807       then do:
      808         assign
      809           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      810         .
      811         create buffer bh_tbl-key for table v-full-tbl-name .
      812       end.
      813       if i-tableSerach ne "" and i-tableSerach ne ?
      814       then do:
      815         delete object bh_tbl-name no-error.
      816         assign
      817           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      818         .
      819         create buffer bh_tbl-name for table v-full-tbl-name .
      820       end.
      821       block_where:
      822       do v-ind = 1 to v-idx-field-qnty by 2
      823       on error undo, return error
      824       :
      825         assign
      826           v-count-fld = v-count-fld + 1
      827         .
      828         if p-key-handle = ?
      829           and v-count-fld > v-field-num
      830         then do:
      831           leave block_where.
      832         end.
      833         define variable VfieldKeyTable as handle no-undo.
      834         assign
      835           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      836           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      837         .
      838         if     bh_tbl-key ne ?
      839         then do:
      840            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      841            if VfieldKeyTable eq ?
      842            then next block_where.
      843         end.
      844         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      845         then
      846            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      847         else
      848            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      849         if p-key-handle = ? then do:
      850           assign
      851             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      852           .
      853         end.
      854         else do:
      855           assign
      856             fh_key = p-key-handle:buffer-field( v-field-name )
      857           .
      858           if fh_key = ?
      859             or not valid-handle( fh_key )
      860           then do:
      861             delete object bh_tbl-name.
      862             if     bh_tbl-key ne ?
      863             then
      864                delete object bh_tbl-key.
      865             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info4, p-key-handle:name, v-field-name ).
      866           end.
      867           assign
      868             v-field-val = fh_key:buffer-value
      869           .
      870         end.
      871         if fh_search:data-type ="character":U then do:
      872           assign
      873             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      874             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      875             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      876             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      877             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      878             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      879             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      880             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      881             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      882             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      883             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      884             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      885             v-field-val = substitute( '"&1"', v-field-val )
      886           .
      887         end.
      888         assign
      889           o-where = substitute( "&1 &2", o-where, v-field-val )
      890         .
      891         if v-word-link = "":U then do:
      892           assign
      893             v-word-link = "and":U
      894           .
      895         end.
      896       end.
      897       delete object bh_tbl-name.
      898       if     bh_tbl-key ne ?
      899       then
      900          delete object bh_tbl-key.
      901       if p-key-handle = ?
      902         and v-count-fld <> v-field-num
      903       then do:
      904         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info4, vTable ).
      905       end.
      906     end.
      907   end procedure.
      908   procedure gen-hn-keyr-tab :
      909     define input  parameter i-tableSerach as character no-undo.
      910     define input  parameter i-tablekey   as character no-undo.
      911     define input  parameter p-key-rec    as character no-undo.
      912     define input  parameter p-key-handle as handle    no-undo .
      913     define input  parameter p-db-name    as character no-undo .
      914     define input  parameter p-tt-handle  as handle    no-undo .
      915     define input  parameter p-stts-lock  as integer   no-undo .
      916     define output parameter o-hn         as handle    no-undo.
      917     define variable v-full-tbl-name as character no-undo.
      918     define variable v-where         as character no-undo.
      919     define variable bh_tbl-name     as handle    no-undo.
      920     define variable vTable          as character no-undo.
      921     do
      922     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      923     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      924     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      925         run gen-where-keyr-tab(i-tableSerach,
      926                                i-tablekey,
      927                                p-key-rec,
      928                                p-key-handle,
      929                                p-db-name,
      930                                p-tt-handle,
      931                                output v-where).
      932         if i-tableSerach ne "" and i-tableSerach ne ?
      933         then do:
      934            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      935            create buffer bh_tbl-name for table v-full-tbl-name .
      936         end.
      937         else do:
      938            if p-tt-handle = ? then do:
      939               assign
      940                  vTable = entry( 1 , p-key-rec, chr(3) )
      941               .
      942               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      943               create buffer bh_tbl-name for table v-full-tbl-name .
      944            end.
      945            else do:
      946               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      947            end.
      948         end.
      949         if p-tt-handle = ? then do:
      950            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      951         end.
      952         else do:
      953            bh_tbl-name:find-first( v-where ) no-error .
      954         end.
      955         o-hn = bh_tbl-name.
      956      end.
      957   end procedure.
      958   procedure gen-hn-keyr :
      959     define input  parameter p-key-rec    as character no-undo.
      960     define input  parameter p-key-handle as handle    no-undo .
      961     define input  parameter p-db-name    as character no-undo .
      962     define input  parameter p-tt-handle  as handle    no-undo .
      963     define input  parameter p-stts-lock  as integer   no-undo .
      964     define output parameter o-hn         as handle    no-undo.
      965     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      966   end.
      967   procedure gen-row-keyr :
      968     define input  parameter p-key-rec    as character no-undo.
      969     define input  parameter p-key-handle as handle    no-undo .
      970     define input  parameter p-db-name    as character no-undo .
      971     define input  parameter p-tt-handle  as handle    no-undo .
      972     define input  parameter p-stts-lock  as integer   no-undo .
      973     define output parameter p-tbl-row    as rowid     no-undo.
      974     define output parameter p-tbl-name   as character no-undo.
      975     define variable vHn as handle no-undo.
      976       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      977       p-tbl-row = if vHn:available then vHn:rowid else ?.
      978       p-tbl-name =  vHn:table.
      979       delete object vHn no-error.
      980     if p-tbl-row = ? then do:
      981       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info4, p-tbl-name, p-key-rec ).
      982     end.
      983     else do:
      984       return.
      985     end.
      986   end procedure.
      987   procedure gen-key-fv :
      988     define input  parameter p-key-rec    as character no-undo .
      989     define output parameter p-field-list as character no-undo .
      990     define output parameter p-value-list as character no-undo.
      991     do
      992     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      993     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      994     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      995     :
      996       define variable v-full-tbl-name  as character no-undo .
      997       define variable bh_tbl-name      as handle    no-undo .
      998       define variable v-tbl-name       as character no-undo .
      999       define variable v-field-num      as integer   no-undo .
     1000       define variable v-count-fld      as integer   no-undo .
     1001       define variable v-inform         as character no-undo .
     1002       define variable v-ind            as integer   no-undo .
     1003       define variable v-idx-field-qnty as integer   no-undo .
     1004       define variable v-delim-key      as character no-undo .
     1005       if p-key-rec = ?
     1006         or p-key-rec = "":U
     1007       then do:
     1008         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
     1009       end.
     1010       assign
     1011         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1012         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1013       .
     1014       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1015       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info4 ).
     1016       assign
     1017         v-inform = bh_tbl-name:index-information(1)
     1018         v-ind    = 2
     1019       .
     1020       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1021       on error undo, return error
     1022       :
     1023         assign
     1024           v-inform = bh_tbl-name:index-information( v-ind )
     1025           v-ind    = v-ind + 1
     1026         .
     1027       end.
     1028       if v-inform = ?
     1029         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1030         or entry( 3, v-inform, ",":U ) <> "1":U
     1031       then do:
     1032         delete object bh_tbl-name no-error.
     1033         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
     1034       end.
     1035       assign
     1036         v-idx-field-qnty = num-entries( v-inform ) - 4
     1037       .
     1038       if v-idx-field-qnty < 2 then do:
     1039         delete object bh_tbl-name no-error.
     1040         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
     1041       end.
     1042       assign
     1043         p-field-list = "":U
     1044         p-value-list = "":U
     1045         v-delim-key  = "":U
     1046         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1047         v-count-fld  = 0
     1048       .
     1049       block_where:
     1050       do v-ind = 1 to v-idx-field-qnty by 2
     1051       on error undo, return error
     1052       :
     1053         assign
     1054           v-count-fld = v-count-fld + 1
     1055         .
     1056         if v-count-fld > v-field-num then do:
     1057           leave block_where.
     1058         end.
     1059         assign
     1060           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1061           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1062         .
     1063         if v-ind = 1 then do:
     1064           assign
     1065             v-delim-key = chr(3)
     1066           .
     1067         end.
     1068       end.
     1069       delete object bh_tbl-name.
     1070       if v-count-fld <> v-field-num then do:
     1071         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info4, v-tbl-name ).
     1072       end.
     1073     end.
     1074   end procedure.
     1075   procedure gen-key-field :
     1076     define input  parameter p-table      as character no-undo .
     1077     define output parameter p-field-list as character no-undo .
     1078     do
     1079     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1080     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1081     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1082     :
     1083       define variable v-full-tbl-name  as character no-undo .
     1084       define variable bh_tbl-name      as handle    no-undo .
     1085       define variable v-tbl-name       as character no-undo .
     1086       define variable v-field-num      as integer   no-undo .
     1087       define variable v-count-fld      as integer   no-undo .
     1088       define variable v-inform         as character no-undo .
     1089       define variable v-ind            as integer   no-undo .
     1090       define variable v-idx-field-qnty as integer   no-undo .
     1091       define variable v-delim-key      as character no-undo .
     1092       if p-table = ?
     1093         or p-table = "":U
     1094       then do:
     1095         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info4 ).
     1096       end.
     1097       assign
     1098         v-tbl-name      = p-table
     1099         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1100       .
     1101       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1102       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info4 ).
     1103       assign
     1104         v-inform = bh_tbl-name:index-information(1)
     1105         v-ind    = 2
     1106       .
     1107       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1108       on error undo, return error
     1109       :
     1110         assign
     1111           v-inform = bh_tbl-name:index-information( v-ind )
     1112           v-ind    = v-ind + 1
     1113         .
     1114       end.
     1115       if v-inform = ?
     1116         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1117         or entry( 3, v-inform, ",":U ) <> "1":U
     1118       then do:
     1119         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
     1120       end.
     1121       assign
     1122         v-idx-field-qnty = num-entries( v-inform ) - 4
     1123       .
     1124       if v-idx-field-qnty < 2 then do:
     1125         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
     1126       end.
     1127       assign
     1128         p-field-list = "":U
     1129         v-delim-key  = "":U
     1130         v-count-fld  = 0
     1131       .
     1132       block_where:
     1133       do v-ind = 1 to v-idx-field-qnty by 2
     1134       on error undo, return error
     1135       :
     1136         assign
     1137           v-count-fld = v-count-fld + 1
     1138         .
     1139         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1140         if v-ind = 1 then do:
     1141           assign
     1142             v-delim-key = chr(3)
     1143           .
     1144         end.
     1145       end.
     1146       delete object bh_tbl-name.
     1147     end.
     1148   end procedure.
     1149   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1150   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1151   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1152   FUNCTION get-region RETURNS CHARACTER
     1153     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1154     define variable par-region as character no-undo.
     1155     if parhost-code = 0 and
     1156          parobj-type = "":U and
     1157          parobj-code = 0 then do:
     1158          par-region = "Глобально".
     1159          return par-region.
     1160       end.
     1161       if parobj-type = 'орг':U then do:
     1162          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1163          return par-region.
     1164       end.
     1165       if parobj-type = 'регион':U
     1166       then do:
     1167          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1168          return par-region.
     1169       end.
     1170       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1171       return par-region.
     1172   END FUNCTION.
     1173   FUNCTION get-objregion RETURNS CHARACTER
     1174     (  input parobj-type as character, input parobj-code as integer ) :
     1175     define variable par-region as character no-undo.
     1176     if  parobj-type = "":U and
     1177         parobj-code = 0
     1178     then do:
     1179        par-region = "Глобально".
     1180     end.
     1181     else if parobj-type = 'орг':U
     1182     then do:
     1183        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1184     end.
     1185     else if parobj-type = 'регион':U
     1186     then do:
     1187        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1188     end.
     1189     else
     1190        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1191     return par-region.
     1192   END FUNCTION.
     1193   FUNCTION calldscr returns character ( input p-call-id as character):
     1194   define variable v-descr as character no-undo .
     1195   define variable v-field-list as character no-undo .
     1196   define variable v-value-list as character no-undo.
     1197   define variable v-prop-label as character no-undo .
     1198   define variable v-node-label as character no-undo .
     1199   define variable v-dt-code as integer no-undo .
     1200   define variable v-host-code as integer no-undo .
     1201   define variable v-obj-type as character no-undo .
     1202   define variable v-obj-code as integer no-undo .
     1203   define variable v-label as character no-undo .
     1204   define variable v-node-code as integer no-undo .
     1205   define buffer buf_prop-head for ub.prop-head.
     1206   define buffer buf_prop-ref for ub.prop-ref.
     1207   define buffer buf_prop-map for ub.prop-map.
     1208   run gen-key-fv in this-procedure ( input p-call-id
     1209                                     ,output v-field-list
     1210                                     ,output v-value-list) no-error .
     1211   if error-status:error then return p-call-id.
     1212   CASE entry(1, p-call-id, chr(3)):
     1213     when 'dis-card-type':U then do:
     1214       v-descr = substitute("Тип ДК: эмитент &1 тип: &2"
     1215                            ,integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1216                            ,entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
     1217                            ).
     1218     end.
     1219     when 'dis-card':U then do:
     1220       v-descr = substitute("ДК: № &1"
     1221                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1222                            ).
     1223     end.
     1224     when 'dis-card-property':U then do:
     1225       v-dt-code = integer(entry(lookup("dt-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1226       v-node-code = integer(entry(lookup("node-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1227       v-host-code = integer(entry(lookup("host-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1228       v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3)) .
     1229       v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1230       find first buf_prop-ref no-lock where
     1231                 buf_prop-ref.dt-code = v-dt-code no-error .
     1232       if available buf_prop-ref then do:
     1233         find first buf_prop-head no-lock where
     1234                   buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error .
     1235         v-prop-label = buf_prop-head.prop-label.
     1236         find first buf_prop-map no-lock where
     1237                   buf_prop-map.dtm-code = buf_prop-ref.dtm-code
     1238               and buf_prop-map.node-code = v-node-code no-error .
     1239         if available buf_prop-map then do:
     1240           v-label = buf_prop-map.node-label.
     1241         end.
     1242       end.
     1243       v-descr = substitute("ДК: № &1 &2:&3 &4"
     1244                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1245                            ,v-prop-label
     1246                            ,v-label
     1247                            ,get-region(v-host-code, v-obj-type, v-obj-code)
     1248                            ).
     1249     end.
     1250     when 'clients':U then do:
     1251       v-descr = substitute("&1&2"
     1252                            ,entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
     1253                            ,integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1254                            ).
     1255     end.
     1256     when 'ext-system':U then do:
     1257       v-descr = substitute("Внешняя система &1"
     1258                            ,integer(entry(lookup("esys-id", v-field-list, chr(3)), v-value-list, chr(3)))
     1259                            ).
     1260     end.
     1261     WHEN 'thbj-attr':U then do:
     1262       if entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum':U
     1263       or entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum_obj':U
     1264       then do:
     1265         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'goods':U then do:
     1266           v-descr = "Операции с товарами".
     1267         end.
     1268         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'clients':U then do:
     1269           v-descr = "Операции с клиентами".
     1270         end.
     1271         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'gds-grp':U then do:
     1272           v-descr = "Операции с группами товаров".
     1273         end.
     1274         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'cli-grp':U then do:
     1275           v-descr = "Операции с группами клиентов".
     1276         end.
     1277         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th':U then do:
     1278           v-descr = "Операции с чеками на POS IBS-TH".
     1279         end.
     1280         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th-mob':U then do:
     1281           v-descr = "Операции с чеками на POS IBS-TH-MOB".
     1282         end.
     1283         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'edoc':U then do:
     1284           v-descr = "Операции в системе электронного документооборота".
     1285         end.
     1286         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'thref':U then do:
     1287           v-descr = "Операции со справочниками".
     1288         end.
     1289         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'pdf':U then do:
     1290           v-descr = "Операции с ДНЦ и переоценками".
     1291         end.
     1292         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rep':U then do:
     1293           v-descr = "Отчеты".
     1294         end.
     1295         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'ord':U then do:
     1296           v-descr = "Операции с заказами".
     1297         end.
     1298       end.
     1299     end.
     1300     when 'cash-desk':U then do:
     1301       v-descr = substitute("БД &1 Маг &2 Касса № &4 &3"
     1302                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1303                            ,entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3))
     1304                            ,entry(lookup("cash-num", v-field-list, chr(3)), v-value-list, chr(3))
     1305                            ,entry(lookup("pos-type", v-field-list, chr(3)), v-value-list, chr(3))
     1306                            ).
     1307     end.
     1308     when 'ext-file':U then do:
     1309       v-descr = substitute("БД &1 Файл № &3 (из БД &2)"
     1310                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1311                            ,entry(lookup("from-db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1312                            ,entry(lookup("file-num", v-field-list, chr(3)), v-value-list, chr(3))
     1313                            ).
     1314     end.
     1315   end case.
     1316   return v-descr.
     1317   end function.
     1318   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1319   define variable vss-include-info9 as character format "X(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
     1320   function check-entry-with-mask returns logical ( input p-element as character, input p-list as character, input p-delimiter as character ) :
     1321     define variable p-entry   as logical   no-undo .
     1322     define variable v-ind as integer   no-undo .
     1323     if p-delimiter = "*":U then do:
     1324       message
     1325         vss-workfile "(check-entry-with-mask)" vss-revision vss-description skip
     1326         substitute('Разделитель не может быть равный "&1"', p-delimiter ) skip
     1327         view-as alert-box error .
     1328       return ? .
     1329     end.
     1330     assign
     1331       p-entry = true
     1332     .
     1333     if lookup( p-element, p-list, p-delimiter ) = 0 then do:
     1334       assign
     1335         p-entry = false
     1336       .
     1337       if num-entries( p-list, "*":U ) > 1 then do:
     1338         block_check-list:
     1339         do v-ind = 1 to num-entries( p-list, p-delimiter )
     1340         :
     1341           if p-element matches entry( v-ind, p-list, p-delimiter ) then do:
     1342             assign
     1343               p-entry = true
     1344             .
     1345             leave block_check-list .
     1346           end.
     1347         end.
     1348       end.
     1349     end.
     1350     return p-entry .
     1351   end function .
     1352   PROCEDURE thbj-rum_fill-table :
     1353   define input  parameter p-profile-type as character no-undo .
     1354   define input  parameter p-mode as character no-undo .
     1355   define input  parameter p-silent as logical   no-undo .
     1356   define input  parameter p-uniq-key-rec as character no-undo .
     1357   DEFINE VARIABLE v-dct-algo-call-id AS CHARACTER NO-UNDO.
     1358   define variable v-profile-id-list as character no-undo .
     1359   define variable v-call-id-list as character no-undo .
     1360   define variable v-once-more-list as character no-undo .
     1361   define variable v-current-profile-id as integer no-undo .
     1362   define variable v-current-uniq-key-rec as character no-undo .
     1363   define variable v-current-once-more as integer no-undo .
     1364   define variable v-ii as integer no-undo .
     1365   define variable v-obj-fill as logical no-undo .
     1366   DEFINE BUFFER buf_rule-by-call FOR ub.rule-by-call.
     1367   DEFINE BUFFER buf_rp-by-call FOR ub.rp-by-call.
     1368   DEFINE BUFFER buf2_rp-by-call FOR ub.rp-by-call.
     1369   DEFINE BUFFER buf_rule-profile FOR ub.rule-profile.
     1370   DEFINE BUFFER buf_rule-by-profile FOR ub.rule-by-profile.
     1371   DEFINE BUFFER buf_rule-call-param FOR ub.rule-call-param.
     1372   fill-block:
     1373   do
     1374   on error  undo fill-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1375   on stop   undo fill-block, return error substitute( "&1. stop", vss-workfile )
     1376   on endkey undo fill-block, return error substitute( "&1. endkey", vss-workfile )
     1377   :  .
     1378   if num-entries (p-mode, chr(4)) > 1 then do:
     1379     assign
     1380     v-obj-fill = (entry(2, p-mode, chr(4) ) = "obj")
     1381     p-mode = entry(1, p-mode, chr(4) )
     1382     .
     1383   end.
     1384   IF p-mode <> 'ДОБАВЛЕНИЕ':U THEN DO:
     1385     FOR EACH buf_rp-by-call NO-LOCK WHERE
     1386              buf_rp-by-call.call_id = p-uniq-key-rec
     1387       on error  undo fill-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1388       on stop   undo fill-block, return error substitute( "&1. stop", vss-workfile )
     1389       on endkey undo fill-block, return error substitute( "&1. endkey", vss-workfile )
     1390       :
     1391       find first buf_rule-profile no-lock where
     1392                 buf_rule-profile.profile_id = buf_rp-by-call.profile_id no-error.
     1393       if v-obj-fill
     1394       and lookup("obj", buf_rule-profile.short-name) = 0 then next.
     1395       assign
     1396       v-call-id-list = v-call-id-list +  (if v-call-id-list = '' then '' else chr(4))  +  buf_rp-by-call.call_id
     1397       v-profile-id-list = v-profile-id-list + (if v-profile-id-list = '' then '' else chr(44)) + string(buf_rp-by-call.profile_id)
     1398       v-once-more-list = v-once-more-list + (if v-once-more-list = '' then '' else chr(44))  +  string(buf_rp-by-call.once-more)
     1399       .
     1400       if available buf_rule-profile
     1401       and buf_rule-profile.profile-type = 'cmb':U then do:
     1402         do v-ii = 1 to num-entries('dis-card-type,goods,clients,gds-grp,cli-grp,chk-doc_IBS-TH,chk-doc_IBS-TH-MOB,edoc,thref,pdf,rep,ord,cmb,fdoc':U)  :
     1403           v-current-uniq-key-rec = p-uniq-key-rec.
     1404           entry(lookup('cmb':U, p-uniq-key-rec, chr(3)), v-current-uniq-key-rec, chr(3)) = entry(v-ii, 'dis-card-type,goods,clients,gds-grp,cli-grp,chk-doc_IBS-TH,chk-doc_IBS-TH-MOB,edoc,thref,pdf,rep,ord,cmb,fdoc':U).
     1405           for each buf2_rp-by-call no-lock where
     1406                   buf2_rp-by-call.call_id = v-current-uniq-key-rec
     1407               and buf2_rp-by-call.parent-profile_id = buf_rp-by-call.profile_id
     1408               and buf2_rp-by-call.parent-once-more = buf_rp-by-call.once-more
     1409               :
     1410             v-current-profile-id = buf_rp-by-call.profile_id.
     1411             assign
     1412             v-call-id-list = v-call-id-list +  chr(4)  +  buf2_rp-by-call.call_id
     1413             v-profile-id-list = v-profile-id-list + chr(44) + string(buf2_rp-by-call.profile_id)
     1414             v-once-more-list = v-once-more-list +  chr(44)  +  string(buf2_rp-by-call.once-more)
     1415             .
     1416           end.
     1417         end.
     1418       end.
     1419     END.
     1420     do v-ii = 1 to num-entries(v-call-id-list, chr(4) )  :
     1421       v-current-uniq-key-rec = entry(v-ii, v-call-id-list, chr(4)).
     1422       v-current-profile-id = integer(entry(v-ii, v-profile-id-list)).
     1423       v-current-once-more = integer(entry(v-ii, v-once-more-list)).
     1424       FOR EACH buf_rp-by-call NO-LOCK WHERE
     1425               buf_rp-by-call.call_id = v-current-uniq-key-rec
     1426         on error  undo fill-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1427         on stop   undo fill-block, return error substitute( "&1. stop", vss-workfile )
     1428         on endkey undo fill-block, return error substitute( "&1. endkey", vss-workfile )
     1429         :
     1430         find first buf_rule-profile no-lock where
     1431                   buf_rule-profile.profile_id = buf_rp-by-call.profile_id no-error.
     1432         if v-obj-fill
     1433         and lookup("obj", buf_rule-profile.short-name) = 0 then next.
     1434         find first tt0-rp-by-call where
     1435                   tt0-rp-by-call.call_id = buf_rp-by-call.call_id
     1436              and  tt0-rp-by-call.profile_id = buf_rp-by-call.profile_id
     1437              and  tt0-rp-by-call.once-more = buf_rp-by-call.once-more no-error.
     1438         if not available tt0-rp-by-call then do:
     1439       CREATE tt0-rp-by-call.
     1440       BUFFER-COPY buf_rp-by-call TO tt0-rp-by-call.
     1441       end.
     1442       end.
     1443     FOR EACH buf_rule-by-call  NO-LOCK WHERE
     1444                 buf_rule-by-call.call_id = v-current-uniq-key-rec
     1445     on error  undo fill-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1446     on stop   undo fill-block, return error substitute( "&1. stop", vss-workfile )
     1447     on endkey undo fill-block, return error substitute( "&1. endkey", vss-workfile )
     1448     :
     1449         find first tt0-rule-by-call where
     1450                 tt0-rule-by-call.call_id = buf_rule-by-call.call_id
     1451             and tt0-rule-by-call.codex_id = buf_rule-by-call.codex_id
     1452             and tt0-rule-by-call.ruleset_id = buf_rule-by-call.ruleset_id
     1453             and tt0-rule-by-call.order_id = buf_rule-by-call.order_id no-error.
     1454         if not available tt0-rule-by-call then do:
     1455       CREATE tt0-rule-by-call.
     1456       BUFFER-COPY buf_rule-by-call TO tt0-rule-by-call.
     1457       FOR EACH buf_rule-call-param NO-LOCK WHERE
     1458             buf_rule-call-param.codex_id = tt0-rule-by-call.codex_id
     1459         AND buf_rule-call-param.ruleset_id = tt0-rule-by-call.ruleset_id
     1460         AND buf_rule-call-param.call_id = tt0-rule-by-call.call_id
     1461         AND buf_rule-call-param.order_id = tt0-rule-by-call.order_id
     1462           AND buf_rule-call-param.profile_id = tt0-rule-by-call.profile_id
     1463           AND buf_rule-call-param.once-more = tt0-rule-by-call.once-more
     1464       on error  undo fill-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1465       on stop   undo fill-block, return error substitute( "&1. stop", vss-workfile )
     1466       on endkey undo fill-block, return error substitute( "&1. endkey", vss-workfile )
     1467       :
     1468         CREATE tt0-rule-call-param.
     1469         BUFFER-COPY buf_rule-call-param TO tt0-rule-call-param.
     1470       END.
     1471         end.
     1472     END.
     1473     end.
     1474   END.
     1475   IF p-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
     1476     FOR EACH buf_rule-profile NO-LOCK WHERE
     1477               buf_rule-profile.profile-type = p-profile-type
     1478          AND buf_rule-profile.IS_dynamic = no
     1479       on error  undo fill-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1480       on stop   undo fill-block, return error substitute( "&1. stop", vss-workfile )
     1481       on endkey undo fill-block, return error substitute( "&1. endkey", vss-workfile )
     1482       :
     1483       run thbj-rum_proc-b-addalgo in this-procedure (  input p-silent
     1484                                              ,input yes
     1485                                              ,input p-uniq-key-rec
     1486                                              ,buffer buf_rule-profile
     1487                                               ) no-error .
     1488       if error-status:error then do:
     1489         undo fill-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     1490       end.
     1491     END.
     1492   END.
     1493   end.
     1494   END PROCEDURE.
     1495   PROCEDURE thbj-rum_rename-call-id :
     1496   define input  parameter p-from-call-id as character no-undo .
     1497   define input  parameter p-to-call-id as character no-undo .
     1498   fill-block:
     1499   do
     1500   on error  undo fill-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1501   on stop   undo fill-block, return error substitute( "&1. stop", vss-workfile )
     1502   on endkey undo fill-block, return error substitute( "&1. endkey", vss-workfile )
     1503   :
     1504   for each tt0-rp-by-call
     1505   on error  undo fill-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1506   on stop   undo fill-block, return error substitute( "&1. stop", vss-workfile )
     1507   on endkey undo fill-block, return error substitute( "&1. endkey", vss-workfile )
     1508   :
     1509     if tt0-rp-by-call.call_id = p-from-call-id then do:
     1510       assign
     1511       tt0-rp-by-call.call_id = p-to-call-id.
     1512     end.
     1513   end.
     1514   for each tt0-rule-by-call
     1515   on error  undo fill-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1516   on stop   undo fill-block, return error substitute( "&1. stop", vss-workfile )
     1517   on endkey undo fill-block, return error substitute( "&1. endkey", vss-workfile )
     1518   :
     1519     if tt0-rule-by-call.call_id = p-from-call-id then do:
     1520       assign
     1521       tt0-rule-by-call.call_id = p-to-call-id.
     1522     end.
     1523   end.
     1524   for each tt0-rule-call-param
     1525   on error  undo fill-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1526   on stop   undo fill-block, return error substitute( "&1. stop", vss-workfile )
     1527   on endkey undo fill-block, return error substitute( "&1. endkey", vss-workfile )
     1528   :
     1529     if tt0-rule-call-param.call_id = p-from-call-id then do:
     1530       assign
     1531       tt0-rule-call-param.call_id = p-to-call-id.
     1532     end.
     1533   end.
     1534   end.
     1535   END PROCEDURE.
     1536   PROCEDURE thbj-rum_proc-b-addalgo :
     1537   define input  parameter p-silent as logical   no-undo .
     1538   define input  parameter p-start as logical   no-undo .
     1539   define input  parameter p-uniq-key-rec as character no-undo .
     1540   DEFINE PARAMETER BUFFER buf_rule-profile FOR ub.rule-profile.
     1541   DEFINE VARIABLE v-order-id AS INTEGER NO-UNDO.
     1542   define variable v-rule-uniq-key-rec as character no-undo .
     1543   define variable v-dcta-uniq-key-rec as character no-undo .
     1544   define variable v-found-params as logical no-undo .
     1545   define variable v-found-can-calc as logical no-undo .
     1546   define variable v-disabled as logical no-undo .
     1547   define variable glog as logical no-undo .
     1548   define variable v-once-more as integer no-undo .
     1549   define variable v-main-once-more as integer no-undo .
     1550   define variable v-par-val as character no-undo .
     1551   define variable v-par-type as character no-undo .
     1552   define variable v-rule-profile-uniq-key-rec as character no-undo .
     1553   define variable v-curr-r-b as character no-undo .
     1554   define variable v-param-form as character no-undo .
     1555   define variable v-profile-list  as character no-undo .
     1556   define variable v-uniq-key-rec-list as character no-undo .
     1557   define variable v-obj-type as character no-undo .
     1558   define variable v-obj-code as integer no-undo .
     1559   DEFINE BUFFER buf_tt0-rp-by-call FOR tt0-rp-by-call.
     1560   DEFINE BUFFER buf_rule-by-profile FOR ub.rule-by-profile.
     1561   DEFINE BUFFER buf_rule FOR ub.RULE.
     1562   DEFINE BUFFER buf_tt0-rule-by-call FOR tt0-rule-by-call.
     1563   define buffer buf_ruledict for ub.ruledict.
     1564   define buffer buf_ruledict2 for ub.ruledict.
     1565   define buffer buf_tt0-rule-call-param for tt0-rule-call-param.
     1566   define buffer buf_ruledict-param for ub.ruledict-param.
     1567   define buffer buf_ruledict-param2 for ub.ruledict-param.
     1568   define buffer buf_rp-rule-param for ub.rp-rule-param.
     1569   define buffer buf3_tt0-rp-by-call for tt0-rp-by-call.
     1570   FIND LAST buf_tt0-rp-by-call NO-LOCK WHERE
     1571             buf_tt0-rp-by-call.call_id = p-uniq-key-rec
     1572         AND buf_tt0-rp-by-call.profile_id = buf_rule-profile.profile_id NO-ERROR.
     1573   if buf_rule-profile.parent-feature = integer('1':U) then do:
     1574     undo, return error substitute("Подключение данного алгоритма возможно только через комбинированный алгоритм").
     1575   end.
     1576   define variable v-field-list as character no-undo .
     1577   define variable v-value-list as character no-undo .
     1578   run  gen-key-fv in this-procedure ( input p-uniq-key-rec
     1579                                      ,output v-field-list
     1580                                      ,output v-value-list).
     1581   if lookup("obj-type", v-field-list, chr(3)) > 0 then do:
     1582     assign
     1583     v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
     1584     v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1585     .
     1586   end.
     1587   if lookup(buf_rule-profile.short-name, "obj") = 0
     1588   and v-obj-type <> ''
     1589   then do:
     1590     undo, return error substitute("Данный алгоритм НЕЛЬЗЯ добавлять в контексте объекта!").
     1591   end.
     1592   IF AVAILABLE buf_tt0-rp-by-call THEN do:
     1593     v-main-once-more = buf_tt0-rp-by-call.once-more.
     1594     if buf_rule-profile.is_dynamic = no
     1595     then do:
     1596      undo, return error substitute("Алгоритм &1 уже подключен", buf_rule-profile.profile_id).
     1597     end.
     1598     v-disabled = yes.
     1599     for each buf_rule-by-profile no-lock where
     1600            buf_rule-by-profile.profile_id = buf_rule-profile.profile_id,
     1601        first buf_rule no-lock where
     1602             buf_rule.rule_id = buf_rule-by-profile.rule_id:
     1603        v-disabled = v-disabled and (buf_rule.reusable-params = "-":U).
     1604     end.
     1605     if v-disabled then do:
     1606       undo, return error substitute("Алгоритм &1 уже подключен&2" +
     1607                                     "В нем нет ни одного правила, которое можно выполнить повторно"
     1608                                     ,buf_rule-profile.profile_id
     1609                                     ,chr(10)
     1610                                     ).
     1611     end.
     1612     else do:
     1613       if p-silent = no then do:
     1614         MESSAGE
     1615         substitute("Алгоритм уже подключен&1"+
     1616                   "Выполнение привязанных к нему правил повторно возможно только при указании соответствущих значений параметров&1" +
     1617                   "Все равно подключить алгоритм?"
     1618                   , chr(10))
     1619         VIEW-AS ALERT-BOX question buttons YES-NO update glog.
     1620         if not glog then    RETURN ERROR.
     1621       end.
     1622       else do:
     1623         undo, return error substitute("Алгоритм &1 уже подключен&2"+
     1624                                       "Выполнение привязанных к нему правил повторно возможно только при указании соответствущих значений параметров").
     1625       end.
     1626     end.
     1627   END.
     1628   if buf_rule-profile.param-code <> '':U then do:
     1629     if buf_rule-profile.param-code = 'sys-key' then do:
     1630   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     1631   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     1632     (output v-par-val
     1633     ) no-error .
     1634       if error-status:error then do:
     1635         undo, return error
     1636         substitute("Ошибка при определении значения конфигурационного параметра &1,&2" +
     1637                     "который должен быть включен для работы профайла &3"
     1638                     ,buf_rule-profile.param-code
     1639                     ,chr(10)
     1640                     ,buf_rule-profile.profile_id).
     1641       end.
     1642       if check-entry-with-mask(v-par-val, buf_rule-profile.param-value, chr(4)) = no
     1643       and not (buf_rule-profile.param-code = 'sys-key'
     1644                 and
     1645                 v-par-val = 'IBS')
     1646       then do:
     1647         undo, return error
     1648         substitute("Значения sys-key=&1,&2" +
     1649                     "что не удовлетворяет условиям работы профайла &3"
     1650                     ,v-par-val
     1651                     ,chr(10)
     1652                     ,buf_rule-profile.profile_id).
     1653       end.
     1654     end.
     1655     else do:
     1656   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1657     (input  buf_rule-profile.param-code
     1658     ,input  ''
     1659     ,input  ''
     1660     ,input  0
     1661     ,input  ''
     1662     ,input  ''
     1663     ,input  ''
     1664     ,input  no
     1665     ,output v-par-val
     1666     ,output v-par-type
     1667     ) no-error .
     1668       if error-status:error then do:
     1669         undo, return error
     1670         substitute("Ошибка при определении значения конфигурационного параметра &1,&2" +
     1671                     "который должен быть включен для работы профайла &3"
     1672                     ,buf_rule-profile.param-code
     1673                     ,chr(10)
     1674                     ,buf_rule-profile.profile_id).
     1675       end.
     1676       if lookup(v-par-val, buf_rule-profile.param-value, chr(4)) = 0
     1677       then do:
     1678         undo, return error
     1679         substitute("Значения конфигурационного параметра &1=&2,&3" +
     1680                     "что не удовлетворяет условиям работы профайла &4"
     1681                     ,buf_rule-profile.param-code
     1682                     ,v-par-val
     1683                     ,chr(10)
     1684                     ,buf_rule-profile.profile_id).
     1685       end.
     1686     end.
     1687   end.
     1688   v-profile-list = string(buf_rule-profile.profile_id).
     1689   v-uniq-key-rec-list = p-uniq-key-rec.
     1690   if buf_rule-profile.profile-type = 'cmb':U then do:
     1691     define variable v-once-more-list as character no-undo .
     1692     define variable v-ii as integer no-undo .
     1693     define variable v-current-uniq-key-rec as character no-undo .
     1694     define buffer buf2_rule-profile for ub.rule-profile.
     1695     define buffer buf_profile-by-profile for ub.profile-by-profile.
     1696     for each buf_profile-by-profile no-lock where
     1697             buf_profile-by-profile.profile_id = buf_rule-profile.profile_id,
     1698        first buf2_rule-profile no-lock where
     1699             buf2_rule-profile.profile_id = buf_profile-by-profile.child-profile_id
     1700     on error undo, return error:
     1701       v-profile-list = v-profile-list + chr(44) + string(buf2_rule-profile.profile_id).
     1702       v-current-uniq-key-rec = p-uniq-key-rec.
     1703       entry(lookup('cmb':U, p-uniq-key-rec, chr(3)), v-current-uniq-key-rec, chr(3)) = buf2_rule-profile.profile-type.
     1704       v-uniq-key-rec-list = v-uniq-key-rec-list + chr(4) + v-current-uniq-key-rec.
     1705     end.
     1706   end.
     1707   for each tt2-rule-call-param:
     1708     delete tt2-rule-call-param.
     1709   end.
     1710   do v-ii = 1 to num-entries(v-profile-list):
     1711   find first buf2_rule-profile no-lock where
     1712             buf2_rule-profile.profile_id = integer(entry(v-ii, v-profile-list)).
     1713   FIND LAST buf3_tt0-rp-by-call NO-LOCK WHERE
     1714             buf3_tt0-rp-by-call.call_id = p-uniq-key-rec
     1715         AND buf3_tt0-rp-by-call.profile_id = integer(entry(v-ii, v-profile-list)) NO-ERROR.
     1716   if available buf3_tt0-rp-by-call then do:
     1717     v-once-more = buf3_tt0-rp-by-call.once-more.
     1718   end.
     1719   CREATE buf_tt0-rp-by-call.
     1720   BUFFER-COPY buf2_rule-profile TO buf_tt0-rp-by-call
     1721   ASSIGN
     1722   buf_tt0-rp-by-call.CALL_id = entry(v-ii, v-uniq-key-rec-list, chr(4) )
     1723   buf_tt0-rp-by-call.once-more = v-once-more + 1
     1724   buf_tt0-rp-by-call.parent-profile_id = (if buf_rule-profile.profile-type = 'cmb':U
     1725                                         and buf2_rule-profile.profile-type <> 'cmb':U
     1726                                         then buf_rule-profile.profile_id else 0)
     1727   buf_tt0-rp-by-call.parent-once-more = (if buf_rule-profile.profile-type = 'cmb':U
     1728                                         and buf2_rule-profile.profile-type <> 'cmb':U
     1729                                         then v-main-once-more else 0)
     1730   v-once-more-list = v-once-more-list + (if v-once-more-list = '' then '' else chr(44)) + string(buf_tt0-rp-by-call.once-more)
     1731   .
     1732   if buf2_rule-profile.profile_id = buf_rule-profile.profile_id then do:
     1733     v-main-once-more = buf_tt0-rp-by-call.once-more.
     1734   end.
     1735   if buf_rule-profile.profile-type = 'cmb':U
     1736   and buf2_rule-profile.profile-type <> 'cmb':U then do:
     1737     run  thbj-rum_fill-table in this-procedure ( input buf2_rule-profile.profile-type
     1738                                                 ,input 'ИЗМЕНЕНИЕ':U
     1739                                                 ,input yes
     1740                                                 ,input buf_tt0-rp-by-call.CALL_id ).
     1741   end.
     1742   _rule-by-profile:
     1743   FOR EACH buf_rule-by-profile NO-LOCK WHERE
     1744           buf_rule-by-profile.profile_id = buf_tt0-rp-by-call.profile_id
     1745   BY buf_rule-by-profile.profile_id
     1746   BY buf_rule-by-profile.codex_id
     1747   BY buf_rule-by-profile.ruleset_id
     1748   BY buf_rule-by-profile.rp_order_id
     1749   ON error undo, return error :
     1750     if buf2_rule-profile.profile-type <> 'cmb':U then do:
     1751    FIND FIRST buf_rule NO-LOCK WHERE
     1752                   buf_rule.RULE_id = buf_rule-by-profile.RULE_id NO-ERROR.
     1753    IF NOT AVAILABLE buf_rule THEN DO:
     1754      undo, return error
     1755      SUBSTITUTE("Не найдено правило &1, которое должно быть подключено по алгоритму &2&3" +
     1756                      "кодекс правил &4, свод правил &5"
     1757                      , buf_rule-by-profile.RULE_id
     1758                      , buf_rule-by-profile.profile_id
     1759                      , chr(10)
     1760                      , buf_rule-by-profile.codex_id
     1761                      , buf_rule-by-profile.ruleset_id).
     1762    END.
     1763     FIND LAST buf_tt0-rule-by-call WHERE
     1764               buf_tt0-rule-by-call.codex_id =  buf_rule-by-profile.codex_id
     1765           AND buf_tt0-rule-by-call.ruleset_id = buf_rule-by-profile.ruleset_id
     1766     USE-INDEX imain NO-ERROR.
     1767     IF AVAILABLE buf_tt0-rule-by-call THEN DO:
     1768        v-order-id = buf_tt0-rule-by-call.order_id + 1.
     1769     END.
     1770     ELSE DO:
     1771        v-order-id = 0.
     1772     END.
     1773     CREATE buf_tt0-rule-by-call.
     1774     BUFFER-COPY buf_rule-by-profile TO buf_tt0-rule-by-call
     1775     ASSIGN
     1776     buf_tt0-rule-by-call.order_id = v-order-id
     1777       buf_tt0-rule-by-call.algo-des = substitute("Профайл &1. &2", buf2_rule-profile.profile_id, buf_rule.NAME)
     1778     buf_tt0-rule-by-call.is_dynamic = buf_rule-by-profile.IS_dynamic
     1779     buf_tt0-rule-by-call.can-calc = (IF not buf_tt0-rule-by-call.is_dynamic
     1780                                      or (buf_tt0-rule-by-call.codex_id = 22
     1781                                          and
     1782                                          buf_tt0-rule-by-call.ruleset_id = 1)
     1783                                        THEN yes
     1784                                        ELSE no)
     1785     buf_tt0-rule-by-call.call_id = entry(v-ii, v-uniq-key-rec-list, chr(4) )
     1786     buf_tt0-rule-by-call.once-more = v-once-more + 1
     1787     v-found-can-calc = v-found-can-calc or buf_tt0-rule-by-call.can-calc
     1788     .
     1789     find first buf_ruledict no-lock where
     1790             buf_ruledict.entry-type = 'rule':U
     1791         and  buf_ruledict.uniq-key-rec = buf_rule.uniq-key-rec.
     1792     run gen-key-rec in this-procedure (
     1793                                        input  'rule-profile':U
     1794                                         ,input buffer buf2_rule-profile:handle
     1795                                       ,output v-rule-profile-uniq-key-rec).
     1796     find first buf_ruledict2 no-lock where
     1797             buf_ruledict2.entry-type = 'rule-profile':U
     1798         and  buf_ruledict2.uniq-key-rec = v-rule-profile-uniq-key-rec.
     1799     for each buf_ruledict-param no-lock where
     1800             buf_ruledict-param.entry-id = buf_ruledict.entry-id
     1801     on error undo, return error:
     1802     find first buf_rp-rule-param no-lock where
     1803                 buf_rp-rule-param.profile_id = buf2_rule-profile.profile_id
     1804           and buf_rp-rule-param.rule-param-name = buf_ruledict-param.param-name
     1805           and buf_rp-rule-param.codex_id = buf_rule-by-profile.codex_id
     1806           and buf_rp-rule-param.ruleset_id = buf_rule-by-profile.ruleset_id
     1807           and buf_rp-rule-param.rule_id = buf_rule-by-profile.rule_id
     1808           and buf_rp-rule-param.rp_order_id = buf_rule-by-profile.rp_order_id.
     1809       find first buf_ruledict-param2 no-lock where
     1810             buf_ruledict-param2.entry-id = buf_ruledict2.entry-id
     1811         and buf_ruledict-param2.param-name = buf_rp-rule-param.rp-param-name.
     1812       create buf_tt0-rule-call-param.
     1813       assign
     1814       buf_tt0-rule-call-param.codex_id = buf_tt0-rule-by-call.codex_id
     1815       buf_tt0-rule-call-param.ruleset_id = buf_tt0-rule-by-call.ruleset_id
     1816       buf_tt0-rule-call-param.call_id  = buf_tt0-rule-by-call.call_id
     1817       buf_tt0-rule-call-param.order_id = buf_tt0-rule-by-call.order_id
     1818       buf_tt0-rule-call-param.rule_id = buf_rule.rule_id
     1819       buf_tt0-rule-call-param.param-name = buf_ruledict-param.param-name
     1820       buf_tt0-rule-call-param.p-index = 0
     1821       buf_tt0-rule-call-param.param-des = buf_ruledict-param.documentation
     1822       buf_tt0-rule-call-param.param-num = buf_ruledict-param.param-num
     1823       buf_tt0-rule-call-param.param-label = buf_ruledict-param.param-label
     1824       buf_tt0-rule-call-param.param-mode = buf_ruledict-param.param-mode
     1825       buf_tt0-rule-call-param.param-data-type = buf_ruledict-param.param-data-type
     1826       buf_tt0-rule-call-param.param-2-data-type = buf_ruledict-param.param-2-data-type
     1827       buf_tt0-rule-call-param.param-3-data-type = buf_ruledict-param.param-3-data-type
     1828       buf_tt0-rule-call-param.param-value-character = buf_ruledict-param2.init-value-character
     1829       buf_tt0-rule-call-param.param-value-date = buf_ruledict-param2.init-value-date
     1830       buf_tt0-rule-call-param.param-value-decimal = buf_ruledict-param2.init-value-decimal
     1831       buf_tt0-rule-call-param.param-value-integer = buf_ruledict-param2.init-value-integer
     1832       buf_tt0-rule-call-param.param-value-logical = buf_ruledict-param2.init-value-logical
     1833       buf_tt0-rule-call-param.profile_id          = buf_tt0-rule-by-call.profile_id
     1834       buf_tt0-rule-call-param.once-more           = buf_tt0-rule-by-call.once-more
     1835       .
     1836       if buf_ruledict-param.param-2-data-type = "r-b" then do:
     1837   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1838   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1839     (output v-curr-r-b
     1840     )  .
     1841         buf_tt0-rule-call-param.param-value-character = (if v-curr-r-b = 'rubl':U
     1842                                                          then 'rubl':U
     1843                                                          else 'base':U).
     1844       end.
     1845       assign
     1846       v-found-params = yes.
     1847       create tt2-rule-call-param.
     1848       buffer-copy buf_tt0-rule-call-param to tt2-rule-call-param.
     1849       release tt2-rule-call-param.
     1850     end.
     1851     end.
     1852   END.
     1853   end.
     1854   if v-found-params
     1855   and not p-start
     1856   and not p-silent
     1857   then do:
     1858     if search( substitute("rul/rcps-&1.w", buf_rule-profile.profile_id)) <> ?
     1859     or search( substitute("rul/rcps-&1.r", buf_rule-profile.profile_id)) <> ?
     1860     then do:
     1861       v-param-form = substitute("rul/rcps-&1.w", buf_rule-profile.profile_id).
     1862     end.
     1863     else do:
     1864       v-param-form = "ref/rulercps.w" .
     1865     end.
     1866     if buf_rule-profile.profile-type = 'cmb':U
     1867     and v-param-form = "ref/rulercps.w" then do:
     1868       message
     1869       "Для комбинированных алгоритмов необходимо написать отдельную форму задания параметров!"
     1870       view-as alert-box error .
     1871       return error.
     1872     end.
     1873     if v-obj-type <> ''
     1874     and lookup("obj", buf_rule-profile.short-name) = 0
     1875     then do:
     1876       message
     1877       "Данный алгоритм НЕЛЬЗЯ добавлять в контексте объекта!"
     1878       view-as alert-box error .
     1879       return error.
     1880     end.
     1881     run value(v-param-form) (
     1882                          input parparentproc
     1883                         ,input this-procedure:handle
     1884                         ,input "b-chg":U
     1885                         ,input 'ДОБАВЛЕНИЕ':U
     1886                         ,input 'rp-rule-param':U
     1887                         ,input buf_rule-profile.profile_id
     1888                         ,input v-main-once-more
     1889                         ,input p-uniq-key-rec
     1890                         ,input 0
     1891                         ,input 0
     1892                         ,INPUT 0
     1893                         ,input 0
     1894                         ,INput substitute("алгоритм &1 &2"
     1895                                          , buf_rule-profile.name
     1896                                         , calldscr(p-uniq-key-rec)
     1897                                          )
     1898                         ,input-output table tt2-rule-call-param) no-error.
     1899     if not error-status:error then do:
     1900       for each tt2-rule-call-param
     1901       on error undo, return error:
     1902         find first buf_tt0-rule-call-param where
     1903                   buf_tt0-rule-call-param.call_id = tt2-rule-call-param.call_id
     1904               and buf_tt0-rule-call-param.codex_id = tt2-rule-call-param.codex_id
     1905               and buf_tt0-rule-call-param.ruleset_id = tt2-rule-call-param.ruleset_id
     1906               and buf_tt0-rule-call-param.order_id = tt2-rule-call-param.order_id
     1907               and buf_tt0-rule-call-param.param-name = tt2-rule-call-param.param-name
     1908               and buf_tt0-rule-call-param.p-index = tt2-rule-call-param.p-index no-error .
     1909         if not available buf_tt0-rule-call-param
     1910         and (lookup("LIST", tt2-rule-call-param.param-3-data-type) > 0
     1911              or
     1912              lookup("SORTED-LIST", tt2-rule-call-param.param-3-data-type) > 0
     1913              )
     1914         then do:
     1915           create buf_tt0-rule-call-param.
     1916         end.
     1917         buffer-copy tt2-rule-call-param to buf_tt0-rule-call-param.
     1918         delete tt2-rule-call-param.
     1919       end.
     1920     end.
     1921   end.
     1922   END PROCEDURE.
     1923   define variable add-option as character no-undo.
     1924   define variable v-tbl-row as rowid no-undo .
     1925   define variable v-tbl-name as character no-undo .
     1926   define buffer buf_thbj-attr for ub.thbj-attr.
     1927   DEFINE VARIABLE v-mode AS CHARACTER NO-UNDO EXTENT 3.
     1928   DEFINE VARIABLE rule-display-option AS CHARACTER NO-UNDO.
     1929   define variable v-start as logical no-undo .
     1930   define variable v-h-name as handle no-undo .
     1931   define variable v-is-copy as logical no-undo .
     1932   define variable v-orig-uniq-key-rec as character no-undo .
     1933   define variable v-obj-type as character no-undo .
     1934   define variable v-obj-code as integer no-undo .
     1935   FUNCTION get-profile-documentation RETURNS CHARACTER
     1936     ( p-profile_id AS INTEGER )  FORWARD.
     1937   FUNCTION get-profile-dynamic RETURNS LOGICAL
     1938     ( p-profile_id AS INTEGER )  FORWARD.
     1939   FUNCTION get-profile-name RETURNS CHARACTER
     1940     ( p-profile_id AS INTEGER )  FORWARD.
     1941   DEFINE MENU MENU-B-rule
     1942          MENU-ITEM m_text         LABEL "Текст"
     1943          MENU-ITEM m_graph        LABEL "Граф"          .
     1944   DEFINE BUTTON b-addalgo
     1945        LABEL "Добавить"
     1946        SIZE 10 BY 1.
     1947   DEFINE BUTTON b-delalgo
     1948        LABEL "Удалить"
     1949        SIZE 10 BY 1.
     1950   DEFINE BUTTON B-exit AUTO-GO
     1951        LABEL "&Ввод"
     1952        SIZE 10 BY 1
     1953        BGCOLOR 8 .
     1954   DEFINE BUTTON B-Help
     1955        LABEL "Помо&щь"
     1956        SIZE 3 BY 1
     1957        BGCOLOR 8 .
     1958   DEFINE BUTTON b-params
     1959        LABEL "Параметры"
     1960        SIZE 10 BY 1.
     1961   DEFINE BUTTON b-quit AUTO-END-KEY
     1962        LABEL "&Отмена"
     1963        SIZE 10 BY 1
     1964        BGCOLOR 8 .
     1965   DEFINE BUTTON B-rule
     1966        LABEL "Правило"
     1967        SIZE 10 BY 1.
     1968   DEFINE BUTTON b-rule-on-off
     1969        LABEL "Вкл"
     1970        SIZE 5 BY 1.
     1971   DEFINE BUTTON B-ruleset
     1972        LABEL "Т-ка вызова"
     1973        SIZE 14 BY 1.
     1974   DEFINE VARIABLE E-rule-name AS CHARACTER
     1975        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1976        SIZE 98 BY 4.17
     1977        FGCOLOR 4  NO-UNDO.
     1978   DEFINE VARIABLE Rs-algo-profile AS CHARACTER
     1979        VIEW-AS RADIO-SET HORIZONTAL
     1980        RADIO-BUTTONS
     1981             "Item 1", "1",
     1982   "Item 2", "2"
     1983        SIZE 20.5 BY 1 NO-UNDO.
     1984   DEFINE VARIABLE rs-algo-types AS INTEGER INITIAL 2
     1985        VIEW-AS RADIO-SET HORIZONTAL
     1986        RADIO-BUTTONS
     1987             "Все", 1,
     1988   "Настраив.", 2
     1989        SIZE 18 BY .77 NO-UNDO.
     1990   DEFINE QUERY br-profile FOR
     1991         tt0-rp-by-call SCROLLING.
     1992   DEFINE QUERY br-rule-by-call FOR
     1993         tt0-rule-by-call,
     1994         X_rule-profile SCROLLING.
     1995   DEFINE BROWSE br-profile
     1996     QUERY br-profile NO-LOCK DISPLAY
     1997         tt0-rp-by-call.profile_id COLUMN-LABEL "Про!файл" FORMAT ">>9":U
     1998   get-profile-name ( INPUT tt0-rp-by-call.profile_id) COLUMN-LABEL "Название алгоритма" FORMAT "X(255)"
     1999   get-profile-dynamic ( INPUT tt0-rp-by-call.profile_id) COLUMN-LABEL "Отклю!чаемый" FORMAT "+/":U
     2000   tt0-rp-by-call.once-more COLUMN-LABEL "№ привязки" FORMAT ">9"
     2001       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 15.77
     2002            FONT 4 ROW-HEIGHT-CHARS .67.
     2003   DEFINE BROWSE br-rule-by-call
     2004     QUERY br-rule-by-call NO-LOCK DISPLAY
     2005         tt0-rule-by-call.can-calc COLUMN-LABEL "Вкл." FORMAT "+/":U
     2006   tt0-rule-by-call.algo-des COLUMN-LABEL "Описание алгоритма/правила" FORMAT "X(255)":U WIDTH 40
     2007   tt0-rule-by-call.is_dynamic COLUMN-LABEL "Отклю!чаемое?" FORMAT "+/":U
     2008   tt0-rule-by-call.codex_id COLUMN-LABEL "Кодекс!правил" FORMAT ">,>>>,>>9":U
     2009   tt0-rule-by-call.ruleset_id COLUMN-LABEL "Набор!правил" FORMAT ">,>>>,>>9":U
     2010   tt0-rule-by-call.order_id COLUMN-LABEL "Порядок!вызова" FORMAT ">>9":U WIDTH 9
     2011   tt0-rule-by-call.rule_id COLUMN-LABEL "Код!правила" FORMAT ">>>,>>>,>>9":U WIDTH 9
     2012   tt0-rule-by-call.profile_id COLUMN-LABEL "Алгоритм" FORMAT ">>9":U WIDTH 8
     2013   tt0-rule-by-call.once-more COLUMN-LABEL "№ привязки" FORMAT ">9"
     2014       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 15.77
     2015            FONT 4 ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
     2016   DEFINE FRAME Dialog-Frame
     2017        B-exit AT ROW 1 COL 1.1
     2018        b-quit AT ROW 1 COL 11.1
     2019        B-Help AT ROW 1 COL 95
     2020        Rs-algo-profile AT ROW 2 COL 1 NO-LABEL WIDGET-ID 2
     2021        rs-algo-types AT ROW 2 COL 22 NO-LABEL
     2022        b-addalgo AT ROW 2 COL 40
     2023        b-delalgo AT ROW 2 COL 50
     2024        b-params AT ROW 2 COL 60 WIDGET-ID 6
     2025        B-rule AT ROW 2 COL 70
     2026        B-ruleset AT ROW 2 COL 80 WIDGET-ID 26
     2027        b-rule-on-off AT ROW 2 COL 94
     2028        br-rule-by-call AT ROW 3 COL 1
     2029        br-profile AT ROW 3 COL 1 WIDGET-ID 100
     2030        E-rule-name AT ROW 18.77 COL 1 NO-LABEL
     2031        SPACE(0.00) SKIP(0.34)
     2032       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2033            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2034            TITLE "Привязки RUM"
     2035            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     2036   ASSIGN
     2037          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2038          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2039   ASSIGN
     2040          B-rule:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-rule:HANDLE.
     2041   ASSIGN
     2042          E-rule-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     2043   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2044   DO:
     2045     APPLY "END-ERROR":U TO SELF.
     2046   END.
     2047   ON CHOOSE OF b-addalgo IN FRAME Dialog-Frame
     2048   DO:
     2049   DEFINE VARIABLE v-ref-list AS CHARACTER NO-UNDO.
     2050   DEFINE BUFFER buf_rule-profile FOR ub.rule-profile.
     2051   run ref/rulprofs.w (
     2052                        INPUT parparentproc
     2053                       ,INPUT "b-sel"
     2054                       ,INPUT (p-profile-type + (if parobj-type <> "" then (chr(4) + parobj-type) else ""))
     2055                       ,INPUT-OUTPUT v-ref-list) NO-ERROR.
     2056   IF ERROR-STATUS:ERROR THEN DO:
     2057       RETURN NO-apply.
     2058   END.
     2059   FIND FIRST buf_rule-profile NO-LOCK WHERE
     2060             recid(buf_rule-profile) = INTEGER(v-ref-list) NO-ERROR.
     2061   IF NOT AVAILABLE buf_rule-profile THEN RETURN NO-APPLY.
     2062   if buf_rule-profile.parent-feature = integer('1':U) then do:
     2063     message
     2064     "Данный алгоритм можно добавлять ТОЛЬКО В СОСТАВЕ КОМБИНИРОВАННЫХ АЛГОРИТМОВ!"
     2065     view-as alert-box error.
     2066     undo, return no-apply.
     2067   end.
     2068   if lookup(buf_rule-profile.short-name, "obj") = 0
     2069   and v-obj-type <> ''
     2070   then do:
     2071     message
     2072     "Данный алгоритм НЕЛЬЗЯ добавлять в контексте объекта!"
     2073     view-as alert-box error.
     2074     undo, return no-apply.
     2075   end.
     2076     RUN proc-b-addalgo IN THIS-PROCEDURE ( BUFFER buf_rule-profile) NO-ERROR.
     2077     IF ERROR-STATUS:ERROR THEN DO:
     2078         RETURN NO-APPLY.
     2079     END.
     2080   END.
     2081   ON CHOOSE OF b-delalgo IN FRAME Dialog-Frame
     2082   DO:
     2083     DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     2084     IF NOT AVAILABLE tt0-rp-by-call THEN RETURN NO-APPLY.
     2085     run proc-b-delalgo IN THIS-PROCEDURE NO-ERROR.
     2086     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     2087     APPLY "value-changed" TO br-rule-by-call.
     2088   END.
     2089   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     2090   DO:
     2091     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
     2092     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     2093   END.
     2094   ON CHOOSE OF b-params IN FRAME Dialog-Frame
     2095   DO:
     2096     CASE Rs-algo-profile:
     2097       when 'rule-by-call':U then do:
     2098         IF NOT AVAILABLE tt0-rule-by-call THEN RETURN NO-APPLY.
     2099         run ref/rulercps.w (
     2100                                input parparentproc
     2101                               ,input this-procedure:handle
     2102                               ,input '':U
     2103                               ,input 'ПРОСМОТР':U
     2104                               ,input 'rule-call-param':U
     2105                               ,input 0
     2106                               ,input ?
     2107                               ,input tt0-rule-by-call.call_id
     2108                               ,input tt0-rule-by-call.codex_id
     2109                               ,input tt0-rule-by-call.ruleset_id
     2110                               ,input tt0-rule-by-call.order_id
     2111                               ,input tt0-rule-by-call.RULE_id
     2112                               ,INput substitute("Правило &1 &2"
     2113                                                , tt0-rule-by-call.RULE_id
     2114                                                , calldscr(tt0-rule-by-call.call_id)
     2115                                                )
     2116                               ,input-output table tt0-rule-call-param  ) no-error.
     2117        end.
     2118        when 'rp-by-call':U then do:
     2119         IF NOT AVAILABLE tt0-rp-by-call THEN RETURN NO-APPLY.
     2120         define variable v-param-form as character no-undo .
     2121         define buffer buf_rule-profile for ub.rule-profile.
     2122         find first buf_rule-profile no-lock where
     2123                   buf_rule-profile.profile_id = tt0-rp-by-call.profile_id.
     2124         assign
     2125         v-param-form = (if buf_rule-profile.custom-param-form > 0
     2126                         then  substitute("rul/rcps-&1.w", buf_rule-profile.profile_id)
     2127                         else "ref/rulercps.w")
     2128         .
     2129         if v-obj-type <> ''
     2130         and lookup("obj", buf_rule-profile.short-name) = 0
     2131         then do:
     2132           define variable v-mode as character no-undo .
     2133           v-mode = 'ПРОСМОТР':U.
     2134         end.
     2135         else do:
     2136           v-mode = p-mode.
     2137         end.
     2138         run value(v-param-form) (
     2139                               input parparentproc
     2140                               ,input this-procedure:handle
     2141                               ,input 'b-chg':U
     2142                               ,input v-mode
     2143                               ,input 'rp-rule-param':U
     2144                               ,input tt0-rp-by-call.profile_id
     2145                               ,input tt0-rp-by-call.once-more
     2146                               ,input tt0-rp-by-call.call_id
     2147                               ,input 0
     2148                               ,input 0
     2149                               ,input ?
     2150                               ,input 0
     2151                               ,INput substitute("Профайл &1 № привязки &2 &3"
     2152                                                 ,tt0-rp-by-call.profile
     2153                                                 ,tt0-rp-by-call.once-more
     2154                                                 ,calldscr(tt0-rp-by-call.call_id)
     2155                                                 )
     2156                               ,input-output table tt0-rule-call-param  ) no-error.
     2157        end.
     2158      end case.
     2159   END.
     2160   ON CHOOSE OF B-rule IN FRAME Dialog-Frame
     2161   DO:
     2162     IF NOT AVAILABLE tt0-rule-by-call THEN RETURN NO-APPLY.
     2163     IF rule-display-option = "" THEN DO:
     2164      run gbl/pop-up.p ( input self:handle, input no) no-error.
     2165     END.
     2166     IF rule-display-option = "" THEN DO:
     2167       RETURN NO-APPLY.
     2168     END.
     2169     RUN proc-display-rule IN THIS-PROCEDURE (
     2170                                                INPUT rule-display-option
     2171                                               ,input tt0-rule-by-call.codex_id
     2172                                               ,input tt0-rule-by-call.ruleset_id
     2173                                               ,input tt0-rule-by-call.call_id
     2174                                               ,input tt0-rule-by-call.order_id
     2175                                               ,INPUT tt0-rule-by-call.rule_id) NO-ERROR.
     2176     IF ERROR-STATUS:ERROR THEN DO:
     2177       ASSIGN
     2178       rule-display-option = "".
     2179       RETURN NO-APPLY.
     2180     END.
     2181     ASSIGN
     2182     rule-display-option = "".
     2183   END.
     2184   ON CHOOSE OF b-rule-on-off IN FRAME Dialog-Frame
     2185   DO:
     2186     DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     2187     IF NOT AVAILABLE tt0-rule-by-call THEN RETURN NO-APPLY.
     2188     IF X_rule-profile.IS_dynamic = NO  THEN DO:
     2189        MESSAGE
     2190        substitute("Данное правило не может быть включено/выключено,&1" +
     2191                   "так как принадлежит алгоритму ПО УМОЛЧАНИЮ!"
     2192                   , chr(10))
     2193        VIEW-AS ALERT-BOX ERROR.
     2194        RETURN NO-APPLY.
     2195     END.
     2196     if tt0-rule-by-call.is_dynamic = no then do:
     2197        MESSAGE
     2198        substitute("Данное правило не может быть включено/выключено,&1" +
     2199                   "согласно определенной профайлом логике!"
     2200                   , chr(10))
     2201        VIEW-AS ALERT-BOX ERROR.
     2202        RETURN NO-APPLY.
     2203     end.
     2204     IF tt0-rule-by-call.can-calc THEN DO:
     2205       MESSAGE
     2206       "Вы уверены, что хотите выключить правило?"
     2207       VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE gLOG.
     2208       IF NOT glog THEN RETURN NO-APPLY.
     2209     END.
     2210     ELSE DO:
     2211         MESSAGE
     2212         "Вы уверены, что хотите включить правило?"
     2213         VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE gLOG.
     2214         IF NOT glog THEN RETURN NO-APPLY.
     2215     END.
     2216     ASSIGN
     2217     tt0-rule-by-call.can-calc = NOT (tt0-rule-by-call.can-calc).
     2218     glog = br-rule-by-call:REFRESH() IN FRAME Dialog-Frame.
     2219   END.
     2220   ON CHOOSE OF B-ruleset IN FRAME Dialog-Frame
     2221   DO:
     2222   DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     2223   define buffer buf_ruleset for ub.ruleset.
     2224     IF NOT AVAILABLe tt0-rule-by-call THEN DO:
     2225         RETURN NO-APPLY.
     2226     END.
     2227     FIND FIRST buf_ruleset NO-LOCK WHERE
     2228               buf_ruleset.codex_id = tt0-rule-by-call.codex_id
     2229           AND buf_ruleset.ruleset_id = tt0-rule-by-call.ruleset_id.
     2230     run rul/ruleset-i.w ( input parparentproc
     2231                          ,input 'ПРОСМОТР':U
     2232                          ,input buf_ruleset.codex_id
     2233                          ,input buf_ruleset.ruleset_id
     2234                          ,input-output v-rec) no-error.
     2235   END.
     2236   ON VALUE-CHANGED OF br-profile IN FRAME Dialog-Frame
     2237   DO:
     2238     IF NOT AVAILABLE tt0-rp-by-call THEN DO:
     2239        e-rule-name:SCREEN-VALUE = ''.
     2240     END.
     2241     ELSE DO:
     2242       e-rule-name:SCREEN-VALUE = get-profile-documentation(tt0-rp-by-call.profile_id).
     2243     END.
     2244   END.
     2245   ON VALUE-CHANGED OF br-rule-by-call IN FRAME Dialog-Frame
     2246   DO:
     2247     DEFINE BUFFER buf_rule FOR ub.RULE.
     2248     IF NOT AVAILABLE tt0-rule-by-call THEN RETURN NO-APPLY.
     2249     FIND FIRST buf_rule NO-LOCK WHERE
     2250               buf_rule.RULE_id = tt0-rule-by-call.RULE_id NO-ERROR.
     2251     IF NOT AVAILABLE buf_rule THEN DO:
     2252        e-rule-name:SCREEN-VALUE = SUBSTITUTE("!!!Правило &1 не найдено", tt0-rule-by-call.RULE_Id).
     2253     END.
     2254     ELSE DO:
     2255       e-rule-name:SCREEN-VALUE = buf_rule.name + chr(10) + buf_rule.documentation.
     2256     END.
     2257   END.
     2258   ON CHOOSE OF MENU-ITEM m_graph
     2259   DO:
     2260       IF NOT AVAILABLE tt0-rule-by-call THEN RETURN NO-APPLY.
     2261     ASSIGN
     2262     rule-display-option = "graph".
     2263     RUN proc-display-rule IN THIS-PROCEDURE (  INPUT rule-display-option
     2264                                               ,INPUT tt0-rule-by-call.codex_id
     2265                                               ,INPUT tt0-rule-by-call.ruleset_id
     2266                                               ,INPUT tt0-rule-by-call.call_id
     2267                                               ,INPUT tt0-rule-by-call.order_id
     2268                                               ,INPUT tt0-rule-by-call.rule_id) NO-ERROR.
     2269     ASSIGN
     2270     rule-display-option = "".
     2271   END.
     2272   ON CHOOSE OF MENU-ITEM m_text
     2273   DO:
     2274     IF NOT AVAILABLE tt0-rule-by-call THEN RETURN NO-APPLY.
     2275     ASSIGN
     2276     rule-display-option = "text".
     2277     RUN proc-display-rule IN THIS-PROCEDURE (  INPUT rule-display-option
     2278                                               ,INPUT tt0-rule-by-call.codex_id
     2279                                               ,INPUT tt0-rule-by-call.ruleset_id
     2280                                               ,INPUT tt0-rule-by-call.call_id
     2281                                               ,INPUT tt0-rule-by-call.order_id
     2282                                               ,INPUT tt0-rule-by-call.rule_id) NO-ERROR.
     2283     ASSIGN
     2284     rule-display-option = "".
     2285   END.
     2286   ON VALUE-CHANGED OF Rs-algo-profile IN FRAME Dialog-Frame
     2287   DO:
     2288     ASSIGN
     2289     rs-algo-profile.
     2290     CASE rs-algo-profile:
     2291       WHEN 'rule-by-call':U THEN DO:
     2292         HIDE
     2293         br-profile
     2294         b-addalgo
     2295         b-delalgo
     2296         IN FRAME Dialog-Frame.
     2297         .
     2298         DISPLAY
     2299         rs-algo-types
     2300         br-rule-by-call
     2301         b-rule
     2302         b-ruleset
     2303         b-rule-on-off
     2304         WITH FRAME Dialog-Frame.
     2305         APPLY "VALUE-CHANGED" to br-rule-by-call.
     2306       END.
     2307       WHEN 'rp-by-call':U THEN DO:
     2308         HIDE
     2309         br-rule-by-call
     2310         rs-algo-types
     2311         b-rule
     2312         b-ruleset
     2313         b-rule-on-off
     2314         IN FRAME Dialog-Frame.
     2315         DISPLAY
     2316         br-profile
     2317         b-addalgo
     2318         b-delalgo
     2319         WITH FRAME Dialog-Frame.
     2320         APPLY "VALUE-CHANGED" to br-profile.
     2321       END.
     2322     END CASE.
     2323   END.
     2324   ON VALUE-CHANGED OF rs-algo-types IN FRAME Dialog-Frame
     2325   DO:
     2326     ASSIGN
     2327     rs-algo-types.
     2328     OPEN QUERY br-rule-by-call FOR EACH tt0-rule-by-call WHERE     tt0-rule-by-call.call_id = p-uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE         X_rule-profile.profile_id = tt0-rule-by-call.profile_id   AND (rs-algo-types = 1 or X_rule-profile.is_dynamic = yes)  BY tt0-rule-by-call.codex_id  BY tt0-rule-by-call.ruleset_id  BY tt0-rule-by-call.order_id  INDEXED-REPOSITION.
     2329     APPLY "VALUE-CHANGED" TO br-rule-by-call IN FRAME Dialog-Frame.
     2330   END.
     2331   ON ROW-DISPLAY OF br-profile IN frame Dialog-Frame
     2332   DO:
     2333     IF AVAIL tt0-rp-by-call THEN DO:
     2334       RUN set-row-color IN THIS-PROCEDURE ( INPUT tt0-rp-by-call.parent-profile_id).
     2335     END.
     2336   END.
     2337   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2338   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2339   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2340   on help of frame Dialog-Frame
     2341   do:
     2342     run gbl/app_help.p
     2343       (input this-procedure :file-name
     2344       ,input ''
     2345       ,input ?
     2346       ) no-error.
     2347     if error-status :error then do:
     2348       message
     2349         "Ошибка при вызове помощи"
     2350         error-status :get-message(1)
     2351         view-as alert-box .
     2352     end.
     2353   end.
     2354   run minbtn-set in this-procedure .
     2355   on choose of b-help in frame Dialog-Frame
     2356   do:
     2357     apply "help":u to frame Dialog-Frame .
     2358   end.
     2359   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2360   procedure minbtn-set :
     2361       do
     2362           on error undo, return error return-value
     2363           :
     2364           define variable ii              as integer       no-undo .
     2365           define variable fh              as widget-handle no-undo .
     2366           define variable hh              as widget-handle no-undo .
     2367           define variable v-h             as handle        extent 4 no-undo .
     2368           define variable v-name-button   as character     no-undo .
     2369           define variable v-help-old-x    as decimal       no-undo .
     2370           define variable v-help-old-y    as decimal       no-undo .
     2371           define variable v-help-old-size as decimal       no-undo .
     2372           define variable v-frame-width   as decimal       no-undo .
     2373           define variable jj              as integer       no-undo .
     2374           do
     2375               on error undo, return error
     2376               :
     2377               assign
     2378                   v-frame-width = frame Dialog-Frame:width - 0.3
     2379                   fh            = frame Dialog-Frame:first-child
     2380                   hh            = fh:first-child
     2381                   ii            = 1
     2382                   .
     2383               do while valid-handle(hh):
     2384                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2385                   do:
     2386                       case lc(hh:name) :
     2387                           when "b-help" then
     2388                               do:
     2389                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2390                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2391                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2392                                   hh:TOOLTIP = "Помощь" .
     2393                                   v-help-old-x = hh:column .
     2394                                   v-help-old-y = hh:row    .
     2395                                   v-help-old-size = hh:width .
     2396                                   hh:width-chars = 2.5 .
     2397                               end.
     2398                           when "b-print" then
     2399                               do:
     2400                                   hh:load-image("cmp/b-print.bmp":u) .
     2401                                   hh:TOOLTIP = "Печать" .
     2402                                   v-h[ii] = hh:handle .
     2403                                   ii = ii + 1 .
     2404                                   hh:width-chars = 3 .
     2405                               end.
     2406                           when "b-history" or
     2407                           when "b-hist" then
     2408                               do:
     2409                                   hh:load-image("cmp/b-hist.bmp":u) .
     2410                                   hh:TOOLTIP = "История" .
     2411                                   v-h[ii] = hh:handle .
     2412                                   ii = ii + 1 .
     2413                                   hh:width-chars = 3 .
     2414                               end.
     2415                           when "b-sch" then
     2416                               do:
     2417                                   hh:load-image("cmp/b-sch.bmp":u) .
     2418                                   hh:TOOLTIP = "Установка Фильтра" .
     2419                                   v-h[ii] = hh:handle .
     2420                                   ii = ii + 1 .
     2421                                   hh:width-chars = 3 .
     2422                               end.
     2423                           when "b-hist-user" then
     2424                               do:
     2425                                   hh:load-image("cmp/b-hist.bmp":u) .
     2426                                   hh:TOOLTIP = "История пользователя" .
     2427                                   ii = ii + 1 .
     2428                               end.
     2429                       end case.
     2430                   end.
     2431                   hh = hh:next-sibling.
     2432               end.
     2433               b-help:column = v-frame-width - b-help:width-chars.
     2434               jj = 0.
     2435               repeat ii = 4 to 1 by -1 :
     2436                   if valid-handle (v-h[ii] ) then
     2437                   do:
     2438                       jj  = jj + 1 .
     2439                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2440                       v-h[ii]:row    = v-help-old-y .
     2441                   end.
     2442               end.
     2443           end.
     2444       end.
     2445   end procedure.
     2446   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2447   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2448   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2449   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2450   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2451   define variable v-diasize-current-frame-height as decimal   no-undo .
     2452   define variable v-diasize-change-size          as logical   no-undo .
     2453   define variable v-diasize-resize-button        as handle    no-undo .
     2454   define variable v-diasize-wndmax               as logical   no-undo .
     2455   define variable v-diasize-wndstore             as logical   no-undo .
     2456   define variable v-diasize-proc-name            as character no-undo .
     2457   define variable v-diasize-browse-handle        as handle    no-undo .
     2458   define variable v-diasize-browse-number        as integer   no-undo .
     2459   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2460   define temp-table temp-diasize-handle no-undo
     2461     field handle-value  as handle
     2462     field save-position as decimal
     2463     index xpk is primary unique handle-value
     2464     .
     2465   define temp-table temp-browse-handle no-undo
     2466     field browse-type   as character
     2467     field browse-number as integer
     2468     field browse-handle as handle
     2469     field original-size as decimal
     2470     index xpk is primary unique browse-type browse-number
     2471     index xie browse-type browse-handle
     2472   .
     2473   procedure diasize_change-height :
     2474     define input  parameter p-change-value  as decimal   no-undo .
     2475     define input  parameter p-move-resize   as logical   no-undo .
     2476     define variable v-field-group-handle    as handle    no-undo .
     2477     define variable v-object-handle         as handle    no-undo .
     2478     define variable v-frame-height          as decimal   no-undo .
     2479     define variable v-frame-virtual-height  as decimal   no-undo .
     2480     define variable v-browse-height         as decimal   no-undo .
     2481     define variable v-window-height         as decimal   no-undo .
     2482     define variable v-window-virtual-height as decimal   no-undo .
     2483     define variable v-change-sign           as integer   no-undo .
     2484     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2485     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2486     if p-change-value > 0
     2487     then do:
     2488       if frame Dialog-Frame :height + p-change-value
     2489           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2490       then do:
     2491         assign
     2492           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2493                           - (frame Dialog-Frame :height-chars)
     2494         .
     2495         if p-change-value <= 0
     2496         then do:
     2497           run diasize_position-resize-button in this-procedure .
     2498           return .
     2499         end.
     2500       end.
     2501     end.
     2502     if p-change-value < 0
     2503     then do:
     2504       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2505       then do:
     2506         assign
     2507           p-change-value = v-diasize-orig-frame-height
     2508                          - (frame Dialog-Frame :height-chars)
     2509         .
     2510         if p-change-value >= 0
     2511         then do:
     2512           run diasize_position-resize-button in this-procedure .
     2513           return .
     2514         end.
     2515       end.
     2516     end.
     2517     if p-change-value >= 0
     2518     then do:
     2519       assign
     2520         v-change-sign = 1
     2521       .
     2522     end.
     2523     else do:
     2524       assign
     2525         v-change-sign = -1
     2526       .
     2527     end.
     2528     assign
     2529       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2530     .
     2531     if p-change-value = 0
     2532     then do:
     2533       run diasize_position-resize-button in this-procedure .
     2534       return .
     2535     end.
     2536     move_block:
     2537     do
     2538     on error undo move_block, retry move_block
     2539     :
     2540       if retry
     2541       then do:
     2542         do
     2543         on error undo move_block, leave move_block
     2544         :
     2545           if p-change-value > 0
     2546           then do:
     2547             for each buf_temp-diasize-handle
     2548             on error undo, next
     2549             :
     2550               assign
     2551                 v-object-handle = buf_temp-diasize-handle.handle-value
     2552               .
     2553               if v-object-handle <> v-diasize-resize-button
     2554               then do:
     2555                 assign
     2556                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2557                 .
     2558               end.
     2559             end.
     2560             assign
     2561               v-diasize-browse-handle :height = v-browse-height
     2562             .
     2563             for each buf_temp-browse-handle
     2564               where buf_temp-browse-handle.browse-type = 'height':u
     2565             on error undo, next
     2566             :
     2567               assign
     2568                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2569               .
     2570             end.
     2571             assign
     2572               frame Dialog-Frame :height = v-frame-height
     2573             .
     2574             if frame Dialog-Frame :scrollable = true
     2575             then do:
     2576               assign
     2577                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2578               .
     2579             end.
     2580             run diasize_position-resize-button in this-procedure .
     2581           end.
     2582           else do:
     2583             if frame Dialog-Frame :scrollable = true
     2584             then do:
     2585               assign
     2586                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2587               .
     2588             end.
     2589             assign
     2590               frame Dialog-Frame :height = v-frame-height
     2591             .
     2592             assign
     2593               v-diasize-browse-handle :height = v-browse-height
     2594             .
     2595             for each buf_temp-browse-handle
     2596               where buf_temp-browse-handle.browse-type = 'height':u
     2597             on error undo, next
     2598             :
     2599               assign
     2600                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2601               .
     2602             end.
     2603             for each buf_temp-diasize-handle
     2604             on error undo, next
     2605             :
     2606               assign
     2607                 v-object-handle = buf_temp-diasize-handle.handle-value
     2608               .
     2609               if v-object-handle <> v-diasize-resize-button
     2610               then do:
     2611                 assign
     2612                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2613                 .
     2614               end.
     2615             end.
     2616             run diasize_position-resize-button in this-procedure .
     2617           end.
     2618           assign
     2619             v-diasize-change-size = false
     2620           .
