     3226             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3227             ) .
     3228         end.
     3229       end.
     3230     end.
     3231     assign
     3232       v-diasize-change-size = false
     3233     .
     3234   end procedure.
     3235   procedure diasize_set-width :
     3236     define input  parameter p-new-width  as decimal   no-undo .
     3237     define input  parameter p-move-resize as logical   no-undo .
     3238     do
     3239     on error undo, return error return-value
     3240     :
     3241       run diasize_change-width in this-procedure
     3242         (input  (p-new-width - frame Dialog-Frame :width)
     3243         ,input  p-move-resize
     3244         ) .
     3245     end.
     3246   end procedure.
     3247   procedure diasize_position-resize-button :
     3248     do with frame Dialog-Frame
     3249     :
     3250       hide v-diasize-resize-button .
     3251       assign
     3252         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3253                     - 1
     3254                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3255         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3256                     - 1
     3257                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3258       .
     3259       view v-diasize-resize-button .
     3260     end.
     3261   end procedure.
     3262   on alt-right anywhere
     3263   do:
     3264     run diasize_change-width in this-procedure
     3265       (input 1
     3266       ,input true
     3267       ) .
     3268     return no-apply .
     3269   end.
     3270   on alt-left anywhere
     3271   do:
     3272     run diasize_change-width in this-procedure
     3273       (input -1
     3274       ,input true
     3275       ) .
     3276     return no-apply .
     3277   end.
     3278   on alt-down anywhere
     3279   do:
     3280     run diasize_change-height in this-procedure
     3281       (input 1
     3282       ,input true
     3283       ) .
     3284     return no-apply .
     3285   end.
     3286   on alt-up anywhere
     3287   do:
     3288     run diasize_change-height in this-procedure
     3289       (input -1
     3290       ,input true
     3291       ) .
     3292     return no-apply .
     3293   end.
     3294   on alt-enter of frame Dialog-Frame
     3295   do:
     3296     run diasize_maximize in this-procedure
     3297       (input  ?
     3298       ).
     3299     return no-apply .
     3300   end.
     3301   procedure diasize_end-move :
     3302     do
     3303     on error undo, return error return-value
     3304     :
     3305       define variable v-row-delta as decimal   no-undo .
     3306       define variable v-col-delta as decimal   no-undo .
     3307       define variable v-new-row as decimal   no-undo .
     3308       define variable v-new-col as decimal   no-undo .
     3309       assign
     3310         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3311         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3312       .
     3313       assign
     3314         v-row-delta = v-new-row - frame Dialog-Frame :height
     3315         v-col-delta = v-new-col - frame Dialog-Frame :width
     3316       .
     3317       run diasize_change-height in this-procedure
     3318         (input v-row-delta
     3319         ,input true
     3320         ) .
     3321       run diasize_change-width in this-procedure
     3322         (input v-col-delta
     3323         ,input true
     3324         ) .
     3325     end.
     3326   end procedure.
     3327   procedure diasize_maximize :
     3328     define input  parameter p-action as logical   no-undo .
     3329     do
     3330     on error undo, return error return-value
     3331     :
     3332       if p-action = ?
     3333       then do:
     3334         if v-diasize-need-maximize = true
     3335         then do:
     3336           assign
     3337             p-action = true
     3338           .
     3339         end.
     3340         else do:
     3341           assign
     3342             p-action = false
     3343           .
     3344         end.
     3345       end.
     3346       if p-action = true
     3347       then do:
     3348         run diasize_change-height in this-procedure
     3349           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3350               - frame Dialog-Frame :height-chars
     3351           ,input true
     3352           ) .
     3353         run diasize_change-width in this-procedure
     3354           (input session :width-chars
     3355               - frame Dialog-Frame :width-chars
     3356           ,input true
     3357           ) .
     3358         assign
     3359           v-diasize-need-maximize = false
     3360         .
     3361       end.
     3362       else do:
     3363         run diasize_change-width in this-procedure
     3364           (input v-diasize-orig-frame-width
     3365               - frame Dialog-Frame :width-chars
     3366           ,input true
     3367           ) .
     3368         run diasize_change-height in this-procedure
     3369           (input v-diasize-orig-frame-height
     3370               - frame Dialog-Frame :height-chars
     3371           ,input true
     3372           ) .
     3373         assign
     3374           v-diasize-need-maximize = true
     3375         .
     3376       end.
     3377     end.
     3378   end procedure.
     3379   procedure diasize_restore-orig-size :
     3380     do
     3381     on error undo, return error return-value
     3382     :
     3383       assign
     3384         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3385         v-diasize-current-frame-height = frame Dialog-Frame :height
     3386       .
     3387       run diasize_set-height in this-procedure
     3388         (input  v-diasize-orig-frame-height
     3389         ,input  true
     3390         ) .
     3391       run diasize_set-width in this-procedure
     3392         (input  v-diasize-orig-frame-width
     3393         ,input  true
     3394         ) .
     3395     end.
     3396   end procedure.
     3397   procedure diasize_restore-current-size :
     3398     do
     3399     on error undo, return error return-value
     3400     :
     3401       run diasize_set-height in this-procedure
     3402         (input  v-diasize-current-frame-height
     3403         ,input  true
     3404         ) .
     3405       run diasize_set-width in this-procedure
     3406         (input  v-diasize-current-frame-width
     3407         ,input  true
     3408         ) .
     3409     end.
     3410   end procedure.
     3411   procedure diasize_set-browse-handle :
     3412     define input  parameter p-browse-handle as handle   no-undo .
     3413     define buffer buf_temp-browse-handle for temp-browse-handle .
     3414     do
     3415     on error undo, return error return-value
     3416     :
     3417       assign
     3418         v-diasize-browse-handle = p-browse-handle
     3419       .
     3420       for each buf_temp-browse-handle
     3421       on error undo, return error return-value
     3422       :
     3423         delete buf_temp-browse-handle .
     3424       end.
     3425     end.
     3426   end procedure.
     3427   procedure diasize_add_browse :
     3428     define input  parameter p-browse-type   as character no-undo .
     3429     define input  parameter p-browse-handle as handle    no-undo .
     3430     define buffer buf_temp-browse-handle for temp-browse-handle .
     3431     do
     3432     on error undo, return error return-value
     3433     :
     3434       assign
     3435         v-diasize-browse-number = v-diasize-browse-number + 1
     3436       .
     3437       create buf_temp-browse-handle .
     3438       assign
     3439         buf_temp-browse-handle.browse-type   = p-browse-type
     3440         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3441         buf_temp-browse-handle.browse-handle = p-browse-handle
     3442       .
     3443     end.
     3444   end procedure.
     3445   procedure diasize_init :
     3446     define variable v-default-value    as logical   no-undo .
     3447     define variable v-restore-saved    as logical   no-undo .
     3448     define variable v-resize-value-str as character no-undo .
     3449     do
     3450     on error undo, return error return-value
     3451     :
     3452       do with frame Dialog-Frame
     3453       :
     3454         assign
     3455           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3456           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3457           v-diasize-browse-handle     = browse br-profile :handle
     3458         .
     3459         create button v-diasize-resize-button
     3460         assign
     3461           parent        = frame Dialog-Frame :first-child
     3462           label         = "s"
     3463           height-pixels = 16
     3464           width-pixels  = 16
     3465           visible       = true
     3466           sensitive     = true
     3467           movable       = true
     3468           triggers:
     3469             on end-move persistent run diasize_end-move in this-procedure .
     3470           end triggers.
     3471         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3472         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3473         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3474         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3475         assign
     3476           v-diasize-wndmax = false
     3477         .
     3478         if connected("ub") = true
     3479         then do:
     3480           define variable v-cntxt-db-num        as integer   no-undo .
     3481           define variable v-cntxt-userid        as character no-undo .
     3482           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3483                                             , OUTPUT v-cntxt-userid
     3484                                             ) .
     3485           run gbl/wndpar_r.p
     3486             (input  v-cntxt-db-num
     3487             ,input  v-cntxt-userid
     3488             ,input  'wndmax':U
     3489             ,output v-diasize-wndmax
     3490             ,output v-default-value
     3491             ) .
     3492         end.
     3493         assign
     3494           v-diasize-wndstore = false
     3495         .
     3496         if connected("ub") = true
     3497         then do:
     3498           run gbl/wndpar_r.p
     3499             (input  v-cntxt-db-num
     3500             ,input  v-cntxt-userid
     3501             ,input  'wndstore':U
     3502             ,output v-diasize-wndstore
     3503             ,output v-default-value
     3504             ) .
     3505         end.
     3506         assign
     3507           v-diasize-proc-name = entry(1, program-name(2), '.')
     3508         .
     3509         if v-diasize-wndstore = true
     3510         then do:
     3511           assign
     3512             v-restore-saved = false
     3513           .
     3514           if connected("ub") = true
     3515           then do:
     3516             run gbl/wndsizer.p
     3517               (input  v-cntxt-db-num
     3518               ,input  v-cntxt-userid
     3519               ,input  v-diasize-proc-name
     3520               ,input  'height':u
     3521               ,output v-resize-value-str
     3522               ) .
     3523             if v-resize-value-str <> '':U
     3524             then do:
     3525               run diasize_change-height in this-procedure
     3526                 (input  integer(v-resize-value-str)
     3527                 ,input  true
     3528                 ) .
     3529               assign
     3530                 v-restore-saved = true
     3531               .
     3532             end.
     3533           end.
     3534           if connected("ub") = true
     3535           then do:
     3536             run gbl/wndsizer.p
     3537               (input  v-cntxt-db-num
     3538               ,input  v-cntxt-userid
     3539               ,input  v-diasize-proc-name
     3540               ,input  'width':u
     3541               ,output v-resize-value-str
     3542               ) .
     3543             if v-resize-value-str <> '':U
     3544             then do:
     3545               run diasize_change-width in this-procedure
     3546                 (input  integer(v-resize-value-str)
     3547                 ,input  true
     3548                 ) .
     3549               assign
     3550                 v-restore-saved = true
     3551               .
     3552             end.
     3553           end.
     3554           if v-restore-saved <> true
     3555           then do:
     3556             if v-diasize-wndmax = true
     3557             then do:
     3558               run diasize_maximize in this-procedure
     3559                 (input  true
     3560                 ) .
     3561             end.
     3562           end.
     3563         end.
     3564         else do:
     3565           if v-diasize-wndmax = true
     3566           then do:
     3567             run diasize_maximize in this-procedure
     3568               (input  true
     3569               ) .
     3570           end.
     3571         end.
     3572       end.
     3573     end.
     3574   end procedure.
     3575   procedure diasize_need-full-display :
     3576     define output parameter p-need-full-display as logical   no-undo .
     3577     do
     3578     on error undo, return error return-value
     3579     :
     3580       assign
     3581         p-need-full-display = v-diasize-need-full-display
     3582       .
     3583       assign
     3584         v-diasize-need-full-display = false
     3585       .
     3586     end.
     3587   end procedure.
     3588   procedure get-context :
     3589      define output parameter p-db-num as integer          no-undo.
     3590      define output parameter p-user-id as character        no-undo.
     3591      define variable v-login               as character    no-undo.
     3592      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3593      define buffer buf_user-login  for ub.user-login .
     3594      do
     3595      on error undo, return error
     3596      :
     3597            FIND FIRST buf_sys-ctrl no-lock.
     3598            ASSIGN
     3599               v-login = USERID("ub")
     3600               p-db-num = buf_sys-ctrl.db-num
     3601            .
     3602            FIND FIRST buf_user-login
     3603                 WHERE buf_user-login.db-num = p-db-num
     3604                   AND buf_user-login.user-login = v-login
     3605                 no-lock
     3606                 no-error
     3607                 .
     3608            IF AVAILABLE buf_user-login
     3609            THEN DO:
     3610               assign
     3611                  p-user-id = buf_user-login.user-id
     3612               .
     3613            END.
     3614      end.
     3615   end procedure.
     3616       run diasize_init in this-procedure .
     3617   procedure rcpscont_get-rule-on-off :
     3618   define input parameter p-codex-id as integer no-undo .
     3619   define input parameter p-ruleset-id as integer no-undo .
     3620   define input parameter p-rule-id as integer no-undo .
     3621   define input parameter p-profile-id as integer no-undo .
     3622   define input parameter p-once-more as integer no-undo .
     3623   define output parameter p-on-off as logical no-undo .
     3624   define buffer buf_tt0-rule-by-call for tt0-rule-by-call.
     3625   find first buf_tt0-rule-by-call where
     3626            buf_tt0-rule-by-call.codex_id = p-codex-id
     3627        and buf_tt0-rule-by-call.ruleset_id = p-ruleset-id
     3628        and buf_tt0-rule-by-call.profile_id = p-profile-id
     3629        and buf_tt0-rule-by-call.once-more = p-once-more
     3630        and buf_tt0-rule-by-call.rule_id = p-rule-id
     3631        no-error .
     3632   if available buf_tt0-rule-by-call then do:
     3633      p-on-off = buf_tt0-rule-by-call.can-calc.
     3634   end.
     3635   end procedure.
     3636   procedure rcpscont_set-rule-on-off :
     3637   define input parameter p-codex-id as integer no-undo .
     3638   define input parameter p-ruleset-id as integer no-undo .
     3639   define input parameter p-rule-id as integer no-undo .
     3640   define input parameter p-profile-id as integer no-undo .
     3641   define input parameter p-once-more as integer no-undo .
     3642   define input parameter p-on-off as logical no-undo .
     3643   define variable v-h as handle no-undo .
     3644   define buffer buf_tt0-rule-by-call for tt0-rule-by-call.
     3645   v-h = buffer tt0-rule-by-call:handle.
     3646   if v-h:table <> ''
     3647   and v-h:table <> ? then do:
     3648     find first buf_tt0-rule-by-call where
     3649             buf_tt0-rule-by-call.codex_id = p-codex-id
     3650         and buf_tt0-rule-by-call.ruleset_id = p-ruleset-id
     3651         and buf_tt0-rule-by-call.profile_id = p-profile-id
     3652         and buf_tt0-rule-by-call.once-more = p-once-more
     3653         and buf_tt0-rule-by-call.rule_id = p-rule-id   no-error .
     3654     if not available buf_tt0-rule-by-call then do:
     3655       undo, return error .
     3656     end.
     3657     buf_tt0-rule-by-call.can-calc = p-on-off .
     3658     release buf_tt0-rule-by-call.
     3659   end.
     3660   OPEN QUERY br-rule-by-call FOR EACH tt0-rule-by-call WHERE     tt0-rule-by-call.call_id = p-uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE         X_rule-profile.profile_id = tt0-rule-by-call.profile_id   AND (rs-algo-types = 1 or X_rule-profile.is_dynamic = yes)  BY tt0-rule-by-call.codex_id  BY tt0-rule-by-call.ruleset_id  BY tt0-rule-by-call.order_id  INDEXED-REPOSITION.
     3661   end procedure.
     3662   MAIN-BLOCK:
     3663   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3664      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3665   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3666     run mainmenu_getcntxt in parparentproc
     3667       (output v-cntxt-db-num
     3668       ,output v-cntxt-userid
     3669       ,output v-cntxt-level
     3670       ,output v-cntxt-host-code-obj
     3671       ,output v-cntxt-obj-type
     3672       ,output v-cntxt-obj-code
     3673       ,output v-cntxt-db-num-obj
     3674       ,output v-cntxt-is-admin
     3675       ) .
     3676   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3677   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3678     (output v-curr-r-b
     3679     )  .
     3680     if p-mode <> 'ИЗМЕНЕНИЕ':U
     3681     and p-mode <> 'ДОБАВЛЕНИЕ':U
     3682     AND p-mode <> 'ПРОСМОТР':U
     3683     and p-mode <> 'КОПИРОВАНИЕ':U
     3684     then do:
     3685           message vss-workfile vss-revision vss-description skip
     3686                       "Неверный параметр вызова p-mode"
     3687           view-as alert-box ERROR.
     3688           return error.
     3689       end.
     3690     if p-mode = 'КОПИРОВАНИЕ':U then do:
     3691       v-is-copy = yes.
     3692       p-mode = 'ИЗМЕНЕНИЕ':U.
     3693     end.
     3694     if p-mode = 'ИЗМЕНЕНИЕ':U or p-mode = 'ПРОСМОТР':U then do:
     3695       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     3696         do transaction
     3697         on error undo, return error
     3698         on stop undo, return error
     3699         :
     3700         run gen-row-keyr in this-procedure (
     3701                                              input  p-uniq-key-rec
     3702                                             ,input  ?
     3703                                             ,input  "ub"
     3704                                             ,input  ?
     3705                                             ,input  EXCLUSIVE-LOCK
     3706                                             ,output v-tbl-row
     3707                                             ,output v-tbl-name
     3708                                             ).
     3709           find first buf_thbj-attr EXclusive-lock where
     3710                    rowid(buf_thbj-attr) = v-tbl-row no-wait no-error.
     3711           if locked buf_thbj-attr then do:
     3712             message vss-workfile vss-revision vss-description skip
     3713                     "Запись занята"
     3714             view-as alert-box error .
     3715             return error.
     3716           end.
     3717           if not available buf_thbj-attr then do:
     3718           end.
     3719         end.
     3720       end.
     3721       else do:
     3722         run gen-row-keyr in this-procedure (
     3723                                              input  p-uniq-key-rec
     3724                                             ,input  ?
     3725                                             ,input  "ub"
     3726                                             ,input  ?
     3727                                             ,input  NO-LOCK
     3728                                             ,output v-tbl-row
     3729                                             ,output v-tbl-name
     3730                                             ).
     3731         find first buf_thbj-attr no-lock where
     3732                   rowid(buf_thbj-attr) = v-tbl-row .
     3733       end.
     3734       if not available buf_thbj-attr then do:
     3735         message vss-workfile vss-revision vss-description skip
     3736                 "Не найдена запись"
     3737         view-as alert-box error .
     3738       end.
     3739       assign
     3740       v-obj-type = buf_thbj-attr.obj-type
     3741       v-obj-code = buf_thbj-attr.obj-code
     3742       .
     3743     end.
     3744     ELSE DO:
     3745     END.
     3746     if v-is-copy
     3747     or ( not (buf_thbj-attr.obj-type = ''
     3748               and
     3749               buf_thbj-attr.obj-code = 0)
     3750          and buf_thbj-attr.property-value-logical = no
     3751             )
     3752     then do:
     3753       define variable v-field-list as character no-undo .
     3754       define variable v-value-list as character no-undo .
     3755       run gen-key-fv in this-procedure ( input p-uniq-key-rec
     3756                                         ,output v-field-list
     3757                                         ,output v-value-list).
     3758       assign
     3759       v-orig-uniq-key-rec = p-uniq-key-rec.
     3760       assign
     3761       entry(lookup("obj-type", v-field-list, chr(3)) + 1, v-orig-uniq-key-rec, chr(3)) = ''
     3762       entry(lookup("obj-code", v-field-list, chr(3)) + 1, v-orig-uniq-key-rec, chr(3)) = string(0)
     3763       entry(lookup("upper-prop-code", v-field-list, chr(3)) + 1, v-orig-uniq-key-rec, chr(3)) = 'rum':U
     3764       .
     3765       run thbj-rum_fill-table in this-procedure (
     3766                                                  input p-profile-type
     3767                                                 ,input p-mode + chr(4) + "obj"
     3768                                                 ,input yes
     3769                                                 ,input v-orig-uniq-key-rec).
     3770      run thbj-rum_rename-call-id in this-procedure (
     3771                                                      input v-orig-uniq-key-rec
     3772                                                     ,input p-uniq-key-rec
     3773                                                     ) no-error.
     3774     end.
     3775     else do:
     3776     RUN thbj-rum_FILL-table IN THIS-PROCEDURE (
     3777                                                 input p-profile-type
     3778                                                ,input p-mode
     3779                                                ,input no
     3780                                                ,input p-uniq-key-rec)
     3781                                                no-error .
     3782     end.
     3783     if error-status:error then do:
     3784       message
     3785       error-status:get-message(1) return-value
     3786       view-as alert-box error .
     3787       undo main-block, return error .
     3788     end.
     3789     OPEN QUERY br-profile FOR EACH tt0-rp-by-call WHERE          tt0-rp-by-call.call_id = p-uniq-key-rec NO-LOCK INDEXED-REPOSITION.
     3790     APPLY "VALUE-CHANGED" to br-profile IN FRAME Dialog-Frame.
     3791     OPEN QUERY br-rule-by-call FOR EACH tt0-rule-by-call WHERE     tt0-rule-by-call.call_id = p-uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE         X_rule-profile.profile_id = tt0-rule-by-call.profile_id   AND (rs-algo-types = 1 or X_rule-profile.is_dynamic = yes)  BY tt0-rule-by-call.codex_id  BY tt0-rule-by-call.ruleset_id  BY tt0-rule-by-call.order_id  INDEXED-REPOSITION.
     3792     APPLY "value-changed" TO br-rule-by-call IN FRAME Dialog-Frame.
     3793     RUN Myenable in this-procedure .
     3794     WAIT-FOR GO OF FRAME Dialog-Frame.
     3795   END.
     3796   RUN disable_UI.
     3797   PROCEDURE buttons :
     3798   END PROCEDURE.
     3799   PROCEDURE disable_UI :
     3800     HIDE FRAME Dialog-Frame.
     3801   END PROCEDURE.
     3802   PROCEDURE enable_UI :
     3803     DISPLAY Rs-algo-profile rs-algo-types E-rule-name
     3804         WITH FRAME Dialog-Frame.
     3805     ENABLE B-exit b-quit B-Help Rs-algo-profile rs-algo-types b-addalgo b-delalgo
     3806            b-params B-rule B-ruleset b-rule-on-off br-rule-by-call br-profile
     3807            E-rule-name
     3808         WITH FRAME Dialog-Frame.
     3809     VIEW FRAME Dialog-Frame.
     3810     OPEN QUERY br-profile FOR EACH tt0-rp-by-call WHERE          tt0-rp-by-call.call_id = p-uniq-key-rec NO-LOCK INDEXED-REPOSITION.    OPEN QUERY br-rule-by-call FOR EACH tt0-rule-by-call WHERE     tt0-rule-by-call.call_id = p-uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE         X_rule-profile.profile_id = tt0-rule-by-call.profile_id   AND (rs-algo-types = 1 or X_rule-profile.is_dynamic = yes)  BY tt0-rule-by-call.codex_id  BY tt0-rule-by-call.ruleset_id  BY tt0-rule-by-call.order_id  INDEXED-REPOSITION.
     3811   END PROCEDURE.
     3812   PROCEDURE MyEnable :
     3813   DEFINE VARIABLE v-check-by-mask AS CHARACTER NO-UNDO.
     3814   DEFINE VARIABLE v-type AS CHARACTER NO-UNDO.
     3815   DEFINE VARIABLE v-tooltip AS CHARACTER NO-UNDO.
     3816   define variable v-label as character no-undo .
     3817   define variable v-tooltip-code as character no-undo .
     3818   DEFINE VARIABLE clh AS WIDGET-HANDLE NO-UNDO.
     3819   DEFINE VARIABLE ii AS integer NO-UNDO.
     3820   ASSIGN
     3821   rs-algo-profile:RADIO-BUTTONS IN FRAME Dialog-Frame = "Алгоритмы" + chr(44) +
     3822                                    'rp-by-call':U + chr(44) +
     3823                                   "Правила" + chr(44) + 'rule-by-call':U.
     3824   rs-algo-profile = 'rp-by-call':U.
     3825   ASSIGN
     3826   tt0-rule-by-call.algo-des:RESIZABLE IN BROWSE br-rule-by-call = YES .
     3827   DO ii = 1 TO br-profile:NUM-COLUMNS IN FRAME Dialog-Frame:
     3828       clh = BROWSE br-profile:get-browse-column(ii).
     3829     IF clh:LABEL BEGINS "Название алгоритма" THEN DO:
     3830         ASSIGN
     3831         clh:RESIZABLE = YES
     3832         clh:width = 72
     3833       v-h-name = clh
     3834         .
     3835       END.
     3836   END.
     3837     assign
     3838     b-rule:MENU-MOUSE in frame Dialog-Frame = 1
     3839     .
     3840   run thbjattr_tooltip in this-procedure (
     3841                                              input  buf_thbj-attr.upper-prop-code
     3842                                             ,input  buf_thbj-attr.prop-code
     3843                                             ,output v-tooltip
     3844                                             ,output v-label
     3845                                             ,output v-tooltip-code ).
     3846   frame Dialog-Frame:title = v-label.
     3847   DISPLAY
     3848   rs-algo-types
     3849   rs-algo-profile
     3850   WITH FRAME Dialog-Frame.
     3851   ENABLE
     3852   B-exit when p-mode <> 'ПРОСМОТР':U
     3853   b-quit
     3854   B-Help
     3855   rs-algo-profile
     3856   b-rule
     3857   b-ruleset
     3858   b-addalgo when p-mode <> 'ПРОСМОТР':U
     3859   b-delalgo when p-mode <> 'ПРОСМОТР':U
     3860   b-rule-on-off when p-mode <> 'ПРОСМОТР':U
     3861   b-params
     3862   br-rule-by-call
     3863   br-profile
     3864   rs-algo-types
     3865   e-rule-name
     3866   WITH FRAME Dialog-Frame.
     3867   if p-mode = 'ПРОСМОТР':U then do:
     3868       HIDE
     3869       b-exit in frame Dialog-Frame.
     3870       assign
     3871       b-quit:label in frame Dialog-Frame = "&Выход"
     3872       b-quit:column in frame Dialog-Frame = 1
     3873       e-rule-name:read-only in frame Dialog-Frame = yes
     3874       .
     3875   end.
     3876   VIEW FRAME Dialog-Frame.
     3877   OPEN QUERY br-profile FOR EACH tt0-rp-by-call WHERE          tt0-rp-by-call.call_id = p-uniq-key-rec NO-LOCK INDEXED-REPOSITION.    OPEN QUERY br-rule-by-call FOR EACH tt0-rule-by-call WHERE     tt0-rule-by-call.call_id = p-uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE         X_rule-profile.profile_id = tt0-rule-by-call.profile_id   AND (rs-algo-types = 1 or X_rule-profile.is_dynamic = yes)  BY tt0-rule-by-call.codex_id  BY tt0-rule-by-call.ruleset_id  BY tt0-rule-by-call.order_id  INDEXED-REPOSITION.
     3878   APPLY "VALUE-CHANGED" TO rs-algo-profile.
     3879   END PROCEDURE.
     3880   PROCEDURE proc-b-addalgo :
     3881   DEFINE PARAMETER BUFFER buf_rule-profile FOR ub.rule-profile.
     3882   run thbj-rum_proc-b-addalgo in this-procedure (  input no
     3883                                           ,input v-start
     3884                                           ,input p-uniq-key-rec
     3885                                           ,buffer buf_rule-profile
     3886                                           ) no-error .
     3887       if error-status:error then do:
     3888         message
     3889     return-value
     3890     view-as alert-box .
     3891     return.
     3892   end.
     3893   OPEN QUERY br-profile FOR EACH tt0-rp-by-call WHERE          tt0-rp-by-call.call_id = p-uniq-key-rec NO-LOCK INDEXED-REPOSITION.
     3894   APPLY "VALUE-CHANGED" to br-profile IN FRAME Dialog-Frame.
     3895   OPEN QUERY br-rule-by-call FOR EACH tt0-rule-by-call WHERE     tt0-rule-by-call.call_id = p-uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE         X_rule-profile.profile_id = tt0-rule-by-call.profile_id   AND (rs-algo-types = 1 or X_rule-profile.is_dynamic = yes)  BY tt0-rule-by-call.codex_id  BY tt0-rule-by-call.ruleset_id  BY tt0-rule-by-call.order_id  INDEXED-REPOSITION.
     3896   APPLY "value-changed" TO br-rule-by-call IN FRAME Dialog-Frame.
     3897   END PROCEDURE.
     3898   PROCEDURE proc-b-delalgo :
     3899   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     3900   DEFINE VARIABLE v-rule-nums AS INTEGER NO-UNDO.
     3901   DEFINE VARIABLE v-profile-id AS INTEGER NO-UNDO.
     3902   DEFINE BUFFER buf_rule-profile FOR ub.rule-profile.
     3903   DEFINE BUFFER buf_tt0-rule-by-call FOR tt0-rule-by-call.
     3904   DEFINE BUFFER buf_rule-by-profile FOR ub.rule-by-profile.
     3905   DEFINE BUFFER buf_tt0-rp-by-call FOR tt0-rp-by-call.
     3906   define buffer buf_tt0-rule-call-param for tt0-rule-call-param.
     3907   IF NOT AVAILABLE tt0-rp-by-call THEN RETURN ERROR.
     3908   FIND FIRST buf_rule-profile NO-LOCK WHERE
     3909             buf_rule-profile.profile_id = tt0-rp-by-call.profile_id NO-ERROR.
     3910   IF NOT AVAILABLE buf_rule-profile THEN DO:
     3911      MESSAGE
     3912      substitute("Не найден алгоритм с кодом &1", tt0-rp-by-call.profile_id)
     3913      VIEW-AS ALERT-BOX ERROR.
     3914      RETURN ERROR.
     3915   END.
     3916   IF buf_rule-profile.IS_dynamic = NO THEN DO:
     3917      MESSAGE
     3918      "Привязку к данному алгоритм НЕЛЬЗЯ удалить!"
     3919      VIEW-AS ALERT-BOX ERROR.
     3920      RETURN ERROR.
     3921   END.
     3922   if buf_rule-profile.parent-feature = integer('1':U)
     3923   or tt0-rp-by-call.parent-profile_id > 0
     3924   then do:
     3925     message
     3926     "Данный алгоритм можно удалять ТОЛЬКО В СОСТАВЕ КОМБИНИРОВАННЫХ АЛГОРИТМОВ!"
     3927     view-as alert-box error.
     3928     undo, return no-apply.
     3929   end.
     3930   MESSAGE
     3931   "Вы уверены, что хотите удалить привязку к данному алгоритму?"
     3932   VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     3933   IF NOT glog THEN RETURN ERROR.
     3934   define variable v-ii as integer no-undo .
     3935   define variable v-current-uniq-key-rec as character no-undo .
     3936   define variable v-current-profile-id as integer no-undo .
     3937   define variable v-profile-id-list as character no-undo .
     3938   define variable v-call-id-list as character no-undo .
     3939   define variable v-once-more-list as character no-undo .
     3940   define buffer buf_rp-by-call for ub.rp-by-call.
     3941   assign
     3942   v-call-id-list = p-uniq-key-rec
     3943   v-profile-id-list = string(tt0-rp-by-call.profile_id)
     3944   v-once-more-list = string(tt0-rp-by-call.once-more)
     3945   .
     3946   FIND FIRST buf_rule-profile EXCLUSIVE-LOCK WHERE buf_rule-profile.profile_id = tt0-rp-by-call.profile_id.
     3947   if buf_rule-profile.profile-type = 'cmb':U then do:
     3948     do v-ii = 1 to num-entries('dis-card-type,goods,clients,gds-grp,cli-grp,chk-doc_IBS-TH,chk-doc_IBS-TH-MOB,edoc,thref,pdf,rep,ord,cmb,fdoc':U):
     3949       v-current-uniq-key-rec = p-uniq-key-rec.
     3950       entry(lookup('cmb':U, p-uniq-key-rec, chr(3)), v-current-uniq-key-rec, chr(3)) = entry(v-ii, 'dis-card-type,goods,clients,gds-grp,cli-grp,chk-doc_IBS-TH,chk-doc_IBS-TH-MOB,edoc,thref,pdf,rep,ord,cmb,fdoc':U).
     3951       for each buf_rp-by-call no-lock where
     3952               buf_rp-by-call.call_id = v-current-uniq-key-rec
     3953           and buf_rp-by-call.parent-profile_id = buf_rule-profile.profile_id
     3954           :
     3955         v-current-profile-id = buf_rp-by-call.profile_id.
     3956         assign
     3957         v-call-id-list = v-call-id-list +  chr(4)  +  v-current-uniq-key-rec
     3958         v-profile-id-list = v-profile-id-list + chr(44) + string(v-current-profile-id)
     3959         v-once-more-list = v-once-more-list +  chr(44)  +  string(buf_rp-by-call.once-more)
     3960         .
     3961       end.
     3962     end.
     3963   end.
     3964   do v-ii = 1 to num-entries(v-call-id-list, chr(4) ):
     3965     find first tt0-rp-by-call where
     3966               tt0-rp-by-call.call_id = entry(v-ii, v-call-id-list, chr(4) )
     3967           and tt0-rp-by-call.profile_id = integer(entry(v-ii, v-profile-id-list ))
     3968          and tt0-rp-by-call.once-more = integer(entry(v-ii, v-once-more-list )).
     3969     FOR EACH buf_tt0-rule-by-call where
     3970             buf_tt0-rule-by-call.call_id = entry(v-ii, v-call-id-list, chr(4) )
     3971         and   buf_tt0-rule-by-call.profile_id = integer(entry(v-ii, v-profile-id-list))
     3972         and buf_tt0-rule-by-call.once-more = integer(entry(v-ii, v-once-more-list))
     3973     ON error UNDO, RETURN ERROR:
     3974       for each buf_tt0-rule-call-param where
     3975               buf_tt0-rule-call-param.codex_id = buf_tt0-rule-by-call.codex_id
     3976         and buf_tt0-rule-call-param.ruleset_id = buf_tt0-rule-by-call.ruleset_id
     3977         and buf_tt0-rule-call-param.call_id  = buf_tt0-rule-by-call.call_id
     3978         and buf_tt0-rule-call-param.order_id = buf_tt0-rule-by-call.order_id
     3979         ON error UNDO, RETURN ERROR:
     3980         delete buf_tt0-rule-call-param.
     3981       end.
     3982       DELETE buf_tt0-rule-by-call.
     3983     END.
     3984     DELETE tt0-rp-by-call.
     3985   end.
     3986   OPEN QUERY br-profile FOR EACH tt0-rp-by-call WHERE          tt0-rp-by-call.call_id = p-uniq-key-rec NO-LOCK INDEXED-REPOSITION.
     3987   APPLY "VALUE-CHANGED" to br-profile IN FRAME Dialog-Frame.
     3988   OPEN QUERY br-rule-by-call FOR EACH tt0-rule-by-call WHERE     tt0-rule-by-call.call_id = p-uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE         X_rule-profile.profile_id = tt0-rule-by-call.profile_id   AND (rs-algo-types = 1 or X_rule-profile.is_dynamic = yes)  BY tt0-rule-by-call.codex_id  BY tt0-rule-by-call.ruleset_id  BY tt0-rule-by-call.order_id  INDEXED-REPOSITION.
     3989   APPLY "value-changed" TO br-rule-by-call  IN FRAME Dialog-Frame.
     3990   END PROCEDURE.
     3991   PROCEDURE proc-display-rule :
     3992   DEFINE INPUT PARAMETER p-DISPLAY-MODE AS CHARACTER NO-UNDO.
     3993   DEFINE INPUT PARAMETER p-codex-id AS INTEGER NO-UNDO.
     3994   DEFINE INPUT PARAMETER p-ruleset-id AS INTEGER NO-UNDO.
     3995   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     3996   DEFINE INPUT PARAMETER p-order-id AS INTEGER NO-UNDO.
     3997   DEFINE INPUT PARAMETER p-rule-id AS INTEGER NO-UNDO.
     3998   run rul/disprule.p (
     3999                          input p-DISPLAY-MODE
     4000                         ,input p-rule-id
     4001                         ,input p-codex-id
     4002                         ,input p-ruleset-id
     4003                         ,input p-call-id
     4004                         ,input p-order-id
     4005                          ).
     4006   END PROCEDURE.
     4007   PROCEDURE proc-save :
     4008   DEFINE VARIABLE v-old-call-id AS CHARACTER NO-UNDO.
     4009   DEFINE VARIABLE v-new-call-id AS CHARACTER NO-UNDO.
     4010   define variable glog as logical no-undo .
     4011   define variable v-ok as logical no-undo .
     4012   define variable choice as integer no-undo .
     4013   define variable v-found-new as logical no-undo .
     4014   define variable v-logical-value as logical no-undo .
     4015   define buffer buf_rp-by-call for ub.rp-by-call.
     4016   define buffer buf_tt0-rp-by-call for tt0-rp-by-call.
     4017   define buffer buf_rule-profile for ub.rule-profile.
     4018   if parobj-code > 0 then do:
     4019     find first buf_tt0-rp-by-call no-error.
     4020     if not available buf_tt0-rp-by-call then do:
     4021       run gbl/d-askw.w (input "Вопрос"
     4022                       ,input  substitute("Вы не определили ни одно профайла&1"+
     4023                             "Предполагается, что должны работать профайлы, определенные в ГЛОБАЛЬНОМ контесте,&1" +
     4024                             "или работа по профайлам ВООБЩЕ не требуется?"
     4025                             , chr(10))
     4026                       ,input "|"
     4027                       ,input "ГЛОБАЛЬНЫЕ ПРОФАЙЛЫ|БЕЗ ПРОФАЙЛОВ|Отменить"
     4028                       ,input "||"
     4029                       ,input 1
     4030                       ,input 3
     4031                       ,output choice).
     4032       if choice = 3
     4033       then do:
     4034           undo, return error ''.
     4035       end.
     4036       if choice = 1 then v-logical-value = no.
     4037       if choice = 2 then v-logical-value = yes.
     4038     end.
     4039     else do:
     4040       v-logical-value = yes.
     4041     end.
     4042   end.
     4043   else do:
     4044     v-logical-value = yes.
     4045   end.
     4046   for each buf_rp-by-call where
     4047             buf_rp-by-call.call_id = p-uniq-key-rec,
     4048       first buf_rule-profile no-lock where
     4049             buf_rule-profile.profile_id = buf_rp-by-call.profile_id
     4050         and buf_rule-profile.is_Dynamic = yes
     4051     on ERROR UNDO, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     4052     ON STOP undo, return error '':u:
     4053     find first buf_tt0-rp-by-call where
     4054               buf_tt0-rp-by-call.call_id = buf_rp-by-call.call_id
     4055           and buf_tt0-rp-by-call.profile_id =  buf_rp-by-call.profile_id
     4056           and buf_tt0-rp-by-call.once-more =  buf_rp-by-call.once-more no-error.
     4057     if not available buf_tt0-rp-by-call then do:
     4058        message
     4059        "ВНИМАНИЕ!!!" skip(0)
     4060        "Вы собираетесь удалить профайл(ы)" skip(0)
     4061        "ПРЕДУПРЕЖДЕНИЕ!!!" skip(0)
     4062        "1. Изменения в работе системы" skip(0)
     4063        "на УБД будут вступать в силу ПОСТЕПЕНЕННО - после получения пакета с данными изменениями по СПН" skip(0)
     4064        "Это может привести к РАССИНХРОНИЗАЦИИ данных"  skip(0)
     4065        "2. Даже если Вы передумаете и вновь добавите удаленные профайл(ы)," skip(0)
     4066        "данные по изменениям за этот период будут отсутствовать" skip(0)
     4067        "ПРОДОЛЖИТЬ СОХРАНЕНИЕ              ?"
     4068        view-as alert-box WARNING buttons yes-no update v-ok.
     4069        if not v-ok then do:
     4070          undo, return .
     4071        end.
     4072     end.
     4073   end.
     4074   for each tt0-rp-by-call where
     4075             tt0-rp-by-call.call_id = p-uniq-key-rec,
     4076       first buf_rule-profile no-lock where
     4077             buf_rule-profile.profile_id = tt0-rp-by-call.profile_id
     4078         and buf_rule-profile.is_Dynamic = yes
     4079     on ERROR UNDO, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     4080     ON STOP undo, return error '':u:
     4081     find first buf_rp-by-call where
     4082               buf_rp-by-call.call_id = buf_tt0-rp-by-call.call_id
     4083           and buf_rp-by-call.profile_id =  buf_tt0-rp-by-call.profile_id
     4084           and buf_rp-by-call.once-more =  buf_tt0-rp-by-call.once-more no-error.
     4085     if not available buf_rp-by-call then do:
     4086        v-found-new = yes.
     4087        message
     4088        "ВНИМАНИЕ!!!" skip(0)
     4089        "Вы собираетесь добавить профайл(ы)" skip(0)
     4090        "ПРЕДУПРЕЖДЕНИЕ!!!" skip(0)
     4091        "1. Изменения в работе системы" skip(0)
     4092        "на УБД будут вступать в силу ПОСТЕПЕНЕННО - после получения пакета с данными изменениями по СПН" skip(0)
     4093        "Это может привести к неполноте данных по некоторым БД и т.д." skip(0)
     4094        "2. Для некоторых профайлов предусмотрено включение/выключение правил профайла в соответствии с их бизнес-логикой," skip(0)
     4095        "несвоевременное включение/выключение любого из этих правил МОЖЕТ ПРИВЕСТИ к непредсказуемой работе алгоритма" skip(0)
     4096        "3. Неверно выставленные параметры МОГУТ ПРИВЕСТИ к непредсказуемой работе алгоритма" skip(0)
     4097        "ПРОДОЛЖИТЬ СОХРАНЕНИЕ              ?"
     4098        view-as alert-box WARNING buttons yes-no update v-ok.
     4099        if not v-ok then do:
     4100          undo, return .
     4101        end.
     4102     end.
     4103   end.
     4104   if not v-found-new  then do:
     4105     message
     4106     "ВНИМАНИЕ!!!" skip(0)
     4107     "ПРЕДУПРЕЖДЕНИЕ!!!" skip(0)
     4108     "1. Изменения в работе системы" skip(0)
     4109     "на УБД будут вступать в силу ПОСТЕПЕНЕННО - после получения пакета с данными изменениями по СПН" skip(0)
     4110     "Это может привести к неполноте данных по некоторым БД и т.д." skip(0)
     4111     "2. Для некоторых профайлов предусмотрено включение/выключение правил профайла в соответствии с их бизнес-логикой," skip(0)
     4112     "несвоевременное включение/выключение любого правил из этих МОЖЕТ ПРИВЕСТИ к непредсказуемой работе алгоритма" skip(0)
     4113     "3. Неверно выставленные параметры МОГУТ ПРИВЕСТИ к непредсказуемой работе алгоритма" skip(0)
     4114     "ПРОДОЛЖИТЬ СОХРАНЕНИЕ              ?"
     4115      view-as alert-box WARNING buttons yes-no update v-ok.
     4116     if not v-ok then do:
     4117       undo, return .
     4118     end.
     4119   end.
     4120   run rul/thbjrum1.p (
     4121                    input p-mode
     4122                   ,input p-profile-type
     4123                   ,input p-uniq-key-rec
     4124                   ,input 0
     4125                   ,input "":U
     4126                   ,input 0
     4127                   ,input v-logical-value
     4128                   ,INPUT TABLE tt0-rp-by-call
     4129                   ,INPUT TABLE tt0-rule-by-call
     4130                   ,INPUT TABLE tt0-rule-call-param) no-error .
     4131   if error-status:error then do:
     4132   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4133   define variable fh as widget-handle no-undo .
     4134   define variable hh as widget-handle no-undo .
     4135   define variable rv as character no-undo .
     4136   assign
     4137   rv = entry(1, return-value , chr(4)).
     4138   if rv <> "":U then do:
     4139     assign
     4140     fh = frame Dialog-Frame:first-child
     4141     hh = fh:first-child
     4142     .
     4143     do while valid-handle(hh):
     4144       if hh:name = rv then do:
     4145         APPLY "ENTRY" to hh.
     4146         undo ,
     4147         return error.
     4148       end.
     4149       hh = hh:next-sibling.
     4150     end.
     4151   end.
     4152   if return-value <> '':U then do:
     4153     message
     4154     error-status:get-message(1)
     4155     return-value
     4156     view-as alert-box .
     4157   end.
     4158   return error.
     4159   end.
     4160   END PROCEDURE.
     4161   PROCEDURE set-row-color :
     4162   DEFINE INPUT PARAMETER p-parent-profile-id AS integer NO-UNDO.
     4163   if p-parent-profile-id > 0 then do:
     4164     if valid-handle(v-h-name) then
     4165     assign
     4166     v-h-name:BGCOLOR = GRAY_COLOR
     4167       .
     4168   end.
     4169   else do:
     4170     if valid-handle(v-h-name) then
     4171     assign
     4172     v-h-name:BGCOLOR = ?
     4173       .
     4174   end.
     4175   END PROCEDURE.
     4176   FUNCTION get-profile-documentation RETURNS CHARACTER
     4177     ( p-profile_id AS INTEGER ) :
     4178   DEFINE BUFFER buf_rule-profile FOR ub.rule-profile.
     4179   FIND FIRST buf_rule-profile NO-LOCK WHERE
     4180             buf_rule-profile.profile_id = p-profile_id NO-ERROR.
     4181   IF NOT AVAILABLE buf_rule-profile THEN RETURN ''.
     4182   RETURN buf_rule-profile.documentation.
     4183   END FUNCTION.
     4184   FUNCTION get-profile-dynamic RETURNS LOGICAL
     4185     ( p-profile_id AS INTEGER ) :
     4186   DEFINE BUFFER buf_rule-profile FOR ub.rule-profile.
     4187   FIND FIRST buf_rule-profile NO-LOCK WHERE
     4188             buf_rule-profile.profile_id = p-profile_id NO-ERROR.
     4189   IF NOT AVAILABLE buf_rule-profile THEN RETURN ?.
     4190   RETURN buf_rule-profile.is_dynamic.
     4191   END FUNCTION.
     4192   FUNCTION get-profile-name RETURNS CHARACTER
     4193     ( p-profile_id AS INTEGER ) :
     4194   DEFINE BUFFER buf_rule-profile FOR ub.rule-profile.
     4195   FIND FIRST buf_rule-profile NO-LOCK WHERE
     4196             buf_rule-profile.profile_id = p-profile_id NO-ERROR.
     4197   IF NOT AVAILABLE buf_rule-profile THEN RETURN chr(63).
     4198   RETURN buf_rule-profile.NAME.
     4199   END FUNCTION.
