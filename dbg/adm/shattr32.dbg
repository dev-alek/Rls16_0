      516   :
      517       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_write in g#attr-lib
      518       (input  p-obj-type
      519       ,input  p-obj-code
      520       ,input  p-upper-code
      521       ,input  p-code
      522       ,input  p-value-character
      523       ,input  p-value-date
      524       ,input  p-value-decimal
      525       ,input  p-value-integer
      526       ,input  p-value-logical
      527       ) no-error .
