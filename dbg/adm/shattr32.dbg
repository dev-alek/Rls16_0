      362   procedure thbjattr_code_reg :
      363   define input  parameter p-upper-code     as character no-undo .
      364   define input  parameter p-code           as character no-undo .
      365   define output parameter p-label          as character no-undo .
      366   define output parameter p-user-can-edit  as logical   no-undo .
      367   define output parameter p-output-display as logical   no-undo .
      368   define output parameter p-other          as character no-undo .
      369   define output parameter p-prop-list      as character no-undo .
      370   define output parameter p-prop-type-list as character no-undo .
      371   define output parameter p-prop-label-list as character no-undo .
      372   define output parameter p-global          as logical no-undo .
      373   define output parameter p-host           as logical no-undo .
      374   define output parameter p-shop           as logical no-undo .
      375   define output parameter p-store          as logical no-undo .
      376   define output parameter p-db             as logical no-undo .
      377   define output parameter p-region         as logical no-undo .
      378   do
      379   on error undo, return error return-value
      380   :
      381       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      382       (input  p-upper-code
      383       ,input  p-code
      384       ,output p-label
      385       ,output p-user-can-edit
      386       ,output p-output-display
      387       ,output p-other
      388       ,output p-prop-list
      389       ,output p-prop-type-list
      390       ,output p-prop-label-list
      391       ,output p-global
      392       ,output p-host
      393       ,output p-shop
      394       ,output p-store
      395       ,output p-db
      396       ,output p-region
      397       ) no-error .
      398     if error-status :error
      399     then do:
      400       undo, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message (1)).
      401     end.
      402   end.
      403   end procedure.
