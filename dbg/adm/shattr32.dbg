      478   procedure thbjattr_get-section :
      479   define input  parameter p-obj-type like ub.thbj-attr.obj-type   no-undo .
      480   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
      481   define input  parameter p-upper-param-code  like ub.thbj-attr.upper-prop-code  no-undo .
      482   define input  parameter p-mode as character no-undo .
      483   define input-output parameter table-handle p-tth.
      484   define output parameter p-all-found as decimal no-undo .
      485   do
      486   on error undo, return error return-value
      487   :
      488       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_get-section in g#attr-lib
      489       (input  p-obj-type
      490       ,input  p-obj-code
      491       ,input  p-upper-param-code
      492       ,input  p-mode
      493       ,input-output table-handle p-tth
      494       ,output p-all-found
      495       ) no-error .
      496     if error-status :error
      497     then do:
      498       delete object p-tth.
      499       undo, return error return-value .
      500     end.
      501     delete object p-tth.
      502   end.
      503   end procedure.
      504   procedure thbjattr_write :
      505   define input  parameter p-obj-type like ub.thbj-attr.obj-type   no-undo .
      506   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
