      614   procedure proc-alt-shift-f2:
      615     if not ibs.th.gbl.gbl-var:rcode
      616   then
      617     run gbl\inidebug.p .
      618   end.
      619   procedure proc-alt-shift-f3:
      620     run gbl/prvssinf.p
      621       ( input this-procedure
      622       ) .
      623   end.
      624   define variable v-inform-launched as logical no-undo initial false .
      625   procedure proc-alt-shift-f4:
      626     define variable v-action as character no-undo .
      627     if v-inform-launched = false then do:
      628       assign
      629         v-inform-launched = true
      630       .
      631       run gbl/d-inform.w
      632         (  input self
      633         ,  input this-procedure
      634         , output v-action
      635         ) no-error .
      636       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      637       assign
      638         v-inform-launched = false
      639       .
      640     end.
      641   end.
      642   procedure proc-alt-f1:
      643     run gbl/corrhelp.p
      644       (input this-procedure
      645       ) .
      646   end .
      647   on alt-shift-f2 anywhere do:
      648     run proc-alt-shift-f2.
      649   end.
      650   on alt-shift-f3 anywhere do:
      651     run proc-alt-shift-f3 in this-procedure .
      652   end.
      653   on alt-shift-f4 anywhere do:
      654     run proc-alt-shift-f4 in this-procedure.
      655   end.
      656   on alt-f1 anywhere do:
      657     run proc-alt-f1 in this-procedure .
      658   end.
      659   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      660     define variable v-cntxt-db-num        as integer   no-undo .
      661     define variable v-cntxt-userid        as character no-undo .
      662     define variable v-cntxt-level         as character no-undo .
      663     define variable v-cntxt-host-code-obj as integer   no-undo .
      664     define variable v-cntxt-obj-type      as character no-undo .
      665     define variable v-cntxt-obj-code      as integer   no-undo .
      666     define variable v-cntxt-db-num-obj    as integer   no-undo .
      667     define variable v-cntxt-is-admin      as logical   no-undo .
      668   DEFINE VARIABLE v-db-num LIKE ub.db.db-num NO-UNDO.
      669   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO.
      670   DEFINE VARIABLE v-to-create AS logical NO-UNDO.
      671   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      672   define variable v-tth as handle no-undo .
      673   assign
      674   v-tth = buffer thbjattr_thbj-attr:table-handle .
      675   DEFINE BUTTON B-exit AUTO-GO
      676        LABEL "&Ввод"
      677        SIZE 10 BY 1
      678        BGCOLOR 8 .
      679   DEFINE BUTTON B-Help
      680        LABEL "Помо&щь"
      681        SIZE 3 BY 1
      682        BGCOLOR 8 .
      683   DEFINE BUTTON b-quit AUTO-END-KEY
      684        LABEL "&Отмена"
      685        SIZE 10 BY 1
      686        BGCOLOR 8 .
      687   DEFINE VARIABLE f-cdrgbcgb AS INTEGER FORMAT ">,>>>,>>9":U INITIAL 100000
      688        LABEL "Размер диапазона для собственных кодов товаров"
      689        VIEW-AS FILL-IN NATIVE
      690        SIZE 12 BY 1 NO-UNDO.
      691   DEFINE VARIABLE f-cdrgcagb AS INTEGER FORMAT ">,>>>,>>9":U INITIAL 5000
      692        LABEL "Размер диапазона для кодов точек привязки"
      693        VIEW-AS FILL-IN NATIVE
      694        SIZE 12 BY 1 NO-UNDO.
      695   DEFINE VARIABLE f-cdrgctgb AS INTEGER FORMAT ">,>>>,>>9":U INITIAL 2000
      696        LABEL "Размер диапазона для кодов договоров"
      697        VIEW-AS FILL-IN NATIVE
      698        SIZE 12 BY 1 NO-UNDO.
      699   DEFINE VARIABLE f-cdrgdcgb AS INTEGER FORMAT ">,>>>,>>9":U INITIAL 100000
      700        LABEL "Размер диапазона для кодов ДК"
      701        VIEW-AS FILL-IN NATIVE
      702        SIZE 12 BY 1 NO-UNDO.
      703   DEFINE VARIABLE f-cdrgdrgb AS INTEGER FORMAT ">,>>>,>>9":U INITIAL 1000
      704        LABEL "Размер диапазона для кодов скидок и расписаний"
      705        VIEW-AS FILL-IN NATIVE
      706        SIZE 12 BY 1 NO-UNDO.
      707   DEFINE VARIABLE f-cdrgfdgb AS INTEGER FORMAT ">,>>>,>>9":U INITIAL 1000
      708        LABEL "Размер диапазона для кодов финансовых документов"
      709        VIEW-AS FILL-IN NATIVE
      710        SIZE 12 BY 1 NO-UNDO.
      711   DEFINE VARIABLE f-cdrgfmgb AS INTEGER FORMAT ">>,>>>,>>9":U INITIAL 10000
      712        LABEL "Размер диапазона для кодов организаций"
      713        VIEW-AS FILL-IN NATIVE
      714        SIZE 12 BY 1 NO-UNDO.
      715   DEFINE VARIABLE f-cdrgpglc AS INTEGER FORMAT ">,>>>,>>9":U INITIAL 1000
      716        LABEL "Размер диапазона для лок. штучных кодов для весов"
      717        VIEW-AS FILL-IN NATIVE
      718        SIZE 12 BY 1 NO-UNDO.
      719   DEFINE VARIABLE f-cdrgpngb AS INTEGER FORMAT ">>,>>>,>>9":U INITIAL 5000
      720        LABEL "Размер диапазона для кодов физ.лиц"
      721        VIEW-AS FILL-IN NATIVE
      722        SIZE 12 BY 1 NO-UNDO.
      723   DEFINE VARIABLE f-cdrgscgb AS INTEGER FORMAT ">,>>>,>>9":U INITIAL 1000
      724        LABEL "Размер диапазона для глобальных весовых кодов"
      725        VIEW-AS FILL-IN NATIVE
      726        SIZE 12 BY 1 NO-UNDO.
      727   DEFINE VARIABLE f-cdrgsclc AS INTEGER FORMAT ">,>>>,>>9":U INITIAL 1000
      728        LABEL "Размер диапазона для локальных весовых кодов"
      729        VIEW-AS FILL-IN NATIVE
      730        SIZE 12 BY 1 NO-UNDO.
      731   DEFINE VARIABLE f-cdrgssgb AS INTEGER FORMAT ">,>>>,>>9":U INITIAL 1000
      732        LABEL "Размер диапазона для глобальных взвешиваемых кодов"
      733        VIEW-AS FILL-IN NATIVE
      734        SIZE 12 BY 1 NO-UNDO.
      735   DEFINE VARIABLE f-cdrgsslc AS INTEGER FORMAT ">,>>>,>>9":U INITIAL 1000
      736        LABEL "Размер диапазона для локальных взвешиваемых кодов"
      737        VIEW-AS FILL-IN NATIVE
      738        SIZE 12 BY 1 NO-UNDO.
      739   DEFINE FRAME Dialog-Frame
      740        B-exit AT ROW 1 COL 1
      741        b-quit AT ROW 1 COL 11
      742        B-Help AT ROW 1 COL 95
      743        f-cdrgbcgb AT ROW 3 COL 52 COLON-ALIGNED
      744        f-cdrgscgb AT ROW 4 COL 52 COLON-ALIGNED WIDGET-ID 12
      745        f-cdrgsclc AT ROW 5 COL 52 COLON-ALIGNED WIDGET-ID 14
      746        f-cdrgssgb AT ROW 6 COL 52 COLON-ALIGNED WIDGET-ID 18
      747        f-cdrgsslc AT ROW 7 COL 52 COLON-ALIGNED WIDGET-ID 16
      748        f-cdrgpglc AT ROW 8 COL 52 COLON-ALIGNED WIDGET-ID 22
      749        f-cdrgctgb AT ROW 9 COL 52 COLON-ALIGNED WIDGET-ID 2
      750        f-cdrgdcgb AT ROW 10 COL 52 COLON-ALIGNED WIDGET-ID 4
      751        f-cdrgdrgb AT ROW 11 COL 52 COLON-ALIGNED WIDGET-ID 6
      752        f-cdrgfmgb AT ROW 12 COL 52 COLON-ALIGNED WIDGET-ID 8
      753        f-cdrgpngb AT ROW 13 COL 52 COLON-ALIGNED WIDGET-ID 10
      754        f-cdrgcagb AT ROW 14 COL 52 COLON-ALIGNED WIDGET-ID 20
      755        f-cdrgfdgb AT ROW 15 COL 52 COLON-ALIGNED WIDGET-ID 24
      756        SPACE(33.24) SKIP(2.57)
      757       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      758            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      759            TITLE "Опции работы с диапазонами кодов"
      760            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      761   ASSIGN
      762          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      763          FRAME Dialog-Frame:HIDDEN           = TRUE.
      764   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      765   DO:
      766     APPLY "END-ERROR":U TO SELF.
      767   END.
      768   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      769   DO:
      770     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      771     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      772   END.
      773   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      774   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      775   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      776   on help of frame Dialog-Frame
      777   do:
      778     run gbl/app_help.p
      779       (input this-procedure :file-name
      780       ,input ''
      781       ,input ?
      782       ) no-error.
      783     if error-status :error then do:
      784       message
      785         "Ошибка при вызове помощи"
      786         error-status :get-message(1)
      787         view-as alert-box .
      788     end.
      789   end.
      790   run minbtn-set in this-procedure .
      791   on choose of b-help in frame Dialog-Frame
      792   do:
      793     apply "help":u to frame Dialog-Frame .
      794   end.
      795   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      796   procedure minbtn-set :
      797       do
      798           on error undo, return error return-value
      799           :
      800           define variable ii              as integer       no-undo .
      801           define variable fh              as widget-handle no-undo .
      802           define variable hh              as widget-handle no-undo .
      803           define variable v-h             as handle        extent 4 no-undo .
      804           define variable v-name-button   as character     no-undo .
      805           define variable v-help-old-x    as decimal       no-undo .
      806           define variable v-help-old-y    as decimal       no-undo .
      807           define variable v-help-old-size as decimal       no-undo .
      808           define variable v-frame-width   as decimal       no-undo .
      809           define variable jj              as integer       no-undo .
      810           do
      811               on error undo, return error
      812               :
      813               assign
      814                   v-frame-width = frame Dialog-Frame:width - 0.3
      815                   fh            = frame Dialog-Frame:first-child
      816                   hh            = fh:first-child
      817                   ii            = 1
      818                   .
      819               do while valid-handle(hh):
      820                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      821                   do:
      822                       case lc(hh:name) :
      823                           when "b-help" then
      824                               do:
      825                                   hh:load-image-up("cmp/b-help.bmp":u) .
      826                                   hh:load-image-down("cmp/b-help.bmp":u) .
      827                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      828                                   hh:TOOLTIP = "Помощь" .
      829                                   v-help-old-x = hh:column .
      830                                   v-help-old-y = hh:row    .
      831                                   v-help-old-size = hh:width .
      832                                   hh:width-chars = 2.5 .
      833                               end.
      834                           when "b-print" then
      835                               do:
      836                                   hh:load-image("cmp/b-print.bmp":u) .
      837                                   hh:TOOLTIP = "Печать" .
      838                                   v-h[ii] = hh:handle .
      839                                   ii = ii + 1 .
      840                                   hh:width-chars = 3 .
      841                               end.
      842                           when "b-history" or
      843                           when "b-hist" then
      844                               do:
      845                                   hh:load-image("cmp/b-hist.bmp":u) .
      846                                   hh:TOOLTIP = "История" .
      847                                   v-h[ii] = hh:handle .
      848                                   ii = ii + 1 .
      849                                   hh:width-chars = 3 .
      850                               end.
      851                           when "b-sch" then
      852                               do:
      853                                   hh:load-image("cmp/b-sch.bmp":u) .
      854                                   hh:TOOLTIP = "Установка Фильтра" .
      855                                   v-h[ii] = hh:handle .
      856                                   ii = ii + 1 .
      857                                   hh:width-chars = 3 .
      858                               end.
      859                           when "b-hist-user" then
      860                               do:
      861                                   hh:load-image("cmp/b-hist.bmp":u) .
      862                                   hh:TOOLTIP = "История пользователя" .
      863                                   ii = ii + 1 .
      864                               end.
      865                       end case.
      866                   end.
      867                   hh = hh:next-sibling.
      868               end.
      869               b-help:column = v-frame-width - b-help:width-chars.
      870               jj = 0.
      871               repeat ii = 4 to 1 by -1 :
      872                   if valid-handle (v-h[ii] ) then
      873                   do:
      874                       jj  = jj + 1 .
      875                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      876                       v-h[ii]:row    = v-help-old-y .
      877                   end.
      878               end.
      879           end.
      880       end.
      881   end procedure.
      882   MAIN-BLOCK:
      883   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      884      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      885   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      886     run mainmenu_getcntxt in parparentproc
      887       (output v-cntxt-db-num
      888       ,output v-cntxt-userid
      889       ,output v-cntxt-level
      890       ,output v-cntxt-host-code-obj
      891       ,output v-cntxt-obj-type
      892       ,output v-cntxt-obj-code
      893       ,output v-cntxt-db-num-obj
      894       ,output v-cntxt-is-admin
      895       ) .
      896   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      897   ON TAB ANYWHERE
      898   DO:
      899   define variable ii as integer no-undo .
      900   define variable fh as widget-handle no-undo .
      901   define variable hh as widget-handle no-undo .
      902   define variable v-next-widget-name as character no-undo .
      903   if v-tab-order <> '' then do:
      904     if self:type = "TOGGLE-BOX" then
      905     self:BGCOLOR = ?.
      906     assign
      907     ii = lookup(self:name, v-tab-order).
      908     assign
      909     ii = ii + 1
      910     v-next-widget-name = entry(ii, v-tab-order)
      911     no-error .
      912     if error-status:error then do:
      913       assign
      914       ii = 1
      915       v-next-widget-name = entry( ii, v-tab-order)
      916       .
      917     end.
      918     assign
      919     fh = frame Dialog-Frame:first-child
      920     hh = fh:first-child
      921     .
      922     do while valid-handle(hh):
      923       if hh:name = v-next-widget-name then do:
      924         if hh:sensitive  = yes
      925         AND hh:visible = yes then do:
      926           if hh:type = "TOGGLE-BOX":U then do:
      927             assign
      928             hh:BGcolor = 1
      929             .
      930           end.
      931           APPLY "ENTRY" to hh.
      932           return no-apply.
      933         end.
      934         else do:
      935           APPLY "TAB" to hh.
      936           return no-apply.
      937         end.
      938       end.
      939       hh = hh:next-sibling.
      940     end.
      941   end.
      942   END.
      943   ON BACK-TAB ANYWHERE
      944   DO:
      945   define variable ii as integer no-undo .
      946   define variable fh as widget-handle no-undo .
      947   define variable hh as widget-handle no-undo .
      948   define variable v-next-widget-name as character no-undo .
      949   if v-tab-order <> '' then do:
      950     assign
      951     ii = lookup(self:name, v-tab-order).
      952     .
      953     assign
      954     ii = (if ii = 1
      955           then  num-entries(v-tab-order)
      956           else ii - 1
      957           )
      958     v-next-widget-name = entry(ii, v-tab-order)
      959     .
      960     assign
      961     fh = frame Dialog-Frame:first-child
      962     hh = fh:first-child
      963     .
      964     do while valid-handle(hh):
      965       if hh:name = v-next-widget-name then do:
      966         if hh:sensitive  = yes
      967         AND hh:visible = yes then do:
      968           if hh:type = "TOGGLE-BOX":U then do:
      969             assign
      970             hh:BGcolor = 1
      971             .
      972           end.
      973           APPLY "ENTRY" to hh.
      974           return no-apply.
      975         end.
      976         else do:
      977         APPLY "BACK-TAB" to hh.
      978         return no-apply.
      979         end.
      980       end.
      981       hh = hh:next-sibling.
      982     end.
      983     end.
      984   END.
      985   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      986   ON RETURN ANYWHERE
      987   DO:
      988   define variable ii as integer no-undo .
      989   define variable fh as widget-handle no-undo .
      990   define variable hh as widget-handle no-undo .
      991   define variable v-next-widget-name as character no-undo .
      992     if v-tab-order <> '' then do:
      993       assign
      994       ii = lookup(self:name, v-tab-order).
      995       if ii = num-entries(v-tab-order) then do:
      996           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
      997           return no-apply.
      998       end.
      999       if self:type <> "BUTTON" and
     1000         self:type <> "EDITOR"  then do:
     1001         run proc-move-forward in this-procedure .
     1002         return no-apply.
     1003       end.
     1004       if self:type = "BUTTON" then do:
     1005         APPLY "CHOOSE" to self.
     1006       end.
     1007       if self:type = "TOGGLE-BOX" then
     1008       self:BGCOLOR = ?.
     1009       assign
     1010       ii = ii + 1
     1011       v-next-widget-name = entry(ii, v-tab-order)
     1012       no-error .
     1013       if error-status:error then do:
     1014         assign
     1015         ii = 1
     1016         v-next-widget-name = entry( ii, v-tab-order)
     1017         .
     1018       end.
     1019       assign
     1020       fh = frame Dialog-Frame:first-child
     1021       hh = fh:first-child
     1022       .
     1023       do while valid-handle(hh):
     1024         if hh:name = v-next-widget-name then do:
     1025           if hh:sensitive  = yes
     1026           AND hh:visible = yes then do:
     1027             if hh:type = "TOGGLE-BOX":U then do:
     1028               assign
     1029               hh:BGcolor = 1
     1030               .
     1031             end.
     1032             APPLY "ENTRY" to hh.
     1033             return no-apply.
     1034           end.
     1035           else do:
     1036             APPLY "TAB" to hh.
     1037             return no-apply.
     1038           end.
     1039         end.
     1040         hh = hh:next-sibling.
     1041       end.
     1042     end.
     1043   END.
     1044   procedure proc-move-forward :
     1045   define variable ii as integer no-undo .
     1046   define variable fh as widget-handle no-undo .
     1047   define variable hh as widget-handle no-undo .
     1048   define variable v-next-widget-name as character no-undo .
     1049   do
     1050   on error undo, return error
     1051   :
     1052     if v-tab-order <> '' then do:
     1053       if self:type = "TOGGLE-BOX" then
     1054       self:BGCOLOR = ?.
     1055       assign
     1056       ii = lookup(self:name, v-tab-order).
     1057       assign
     1058       ii = ii + 1
     1059       v-next-widget-name = entry(ii, v-tab-order)
     1060       no-error .
     1061       if error-status:error then do:
     1062         assign
     1063         ii = 1
     1064         v-next-widget-name = entry( ii, v-tab-order)
     1065         .
     1066       end.
     1067       assign
     1068       fh = frame Dialog-Frame:first-child
     1069       hh = fh:first-child
     1070       .
     1071       do while valid-handle(hh):
     1072         if hh:name = v-next-widget-name then do:
     1073           if hh:sensitive  = yes
     1074           AND hh:visible = yes then do:
     1075             if hh:type = "TOGGLE-BOX":U then do:
     1076               assign
     1077               hh:BGcolor = 1
     1078               .
     1079             end.
     1080             APPLY "ENTRY" to hh.
     1081             return.
     1082           end.
     1083           else do:
     1084             assign
     1085             ii = ii + 1
     1086             v-next-widget-name = entry(ii, v-tab-order)
     1087             no-error .
     1088             if error-status:error then do:
     1089               assign
     1090               ii = 1
     1091               v-next-widget-name = entry( ii, v-tab-order)
     1092               .
     1093             end.
     1094           end.
     1095         end.
     1096         hh = hh:next-sibling.
     1097       end.
     1098     end.
     1099   end.
     1100   end procedure.
     1101     IF p-mode <> 'ПРОСМОТР':U
     1102     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     1103         MESSAGE
     1104         vss-workfile vss-revision vss-description skip
     1105         "Неверное значение параметра p-mode" p-mode
     1106         VIEW-AS ALERT-BOX ERROR.
     1107         UNDO, RETURN ERROR.
     1108     END.
     1109     IF p-obj-type <> 'БД':U
     1110     and p-obj-type <> '':U
     1111     THEN DO:
     1112         MESSAGE
     1113         vss-workfile vss-revision vss-description skip
     1114         "Неверное значение параметра p-obj-type" p-obj-type
     1115         VIEW-AS ALERT-BOX ERROR.
     1116         UNDO, RETURN ERROR.
     1117     END.
     1118     if p-obj-type = 'БД':U then do:
     1119       FIND FIRST X_db NO-LOCK WHERE X_db.db-num = p-obj-code NO-ERROR.
     1120       IF NOT AVAILABLE X_db THEN DO:
     1121           MESSAGE
     1122           vss-workfile vss-revision vss-description skip
     1123           "Неверное значение параметра p-obj-code" p-obj-code
     1124           VIEW-AS ALERT-BOX ERROR.
     1125           UNDO, RETURN ERROR.
     1126       END.
     1127     end.
     1128     if p-obj-type = '':U then do:
     1129       if v-cntxt-db-num <> 0
     1130       and p-mode <> 'ПРОСМОТР':U
     1131       then do:
     1132           MESSAGE
     1133           "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" skip
     1134           VIEW-AS ALERT-BOX ERROR.
     1135           UNDO, RETURN ERROR.
     1136       end.
     1137     end.
     1138     if p-obj-type = 'БД':U then do:
     1139       if v-cntxt-db-num <> 0
     1140       and p-mode <> 'ПРОСМОТР':U
     1141       and X_db.db-num <> v-cntxt-db-num
     1142       then do:
     1143           MESSAGE
     1144           "Нельзя менять параметры в чужой УБД" skip
     1145           VIEW-AS ALERT-BOX ERROR.
     1146           UNDO, RETURN ERROR.
     1147       end.
     1148     end.
     1149     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     1150       FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
     1151                 LOCKED_thbj-attr.obj-type = p-obj-type
     1152           AND   LOCKED_thbj-attr.obj-code = p-obj-code
     1153           AND   LOCKED_thbj-attr.upper-prop-code = 'code-range':U
     1154           AND   locked_thbj-attr.prop-code = '':U NO-WAIT NO-ERROR.
     1155        if locked locked_thbj-attr then do:
     1156           message
     1157           vss-workfile vss-revision vss-description skip
     1158            "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
     1159           view-as alert-box error .
     1160           undo, return error.
     1161         end.
     1162     END.
     1163     ELSE DO:
     1164         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
     1165             LOCKED_thbj-attr.obj-type = p-obj-type
     1166       AND   LOCKED_thbj-attr.obj-code = p-obj-code
     1167       AND   LOCKED_thbj-attr.upper-prop-code = 'code-range':U
     1168       and   locked_thbj-attr.prop-code = '':U
     1169       NO-ERROR.
     1170     END.
     1171     if not available locked_thbj-attr then do:
     1172       ASSIGN
     1173       v-to-create  = YES.
     1174       message
     1175       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     1176                   chr(10))
     1177       view-as alert-box WARNING.
     1178     end.
     1179     RUN FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     1180     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     1181     RUN Myenable.
     1182     WAIT-FOR GO OF FRAME Dialog-Frame.
     1183   END.
     1184   RUN disable_UI.
     1185   PROCEDURE disable_UI :
     1186     HIDE FRAME Dialog-Frame.
     1187   END PROCEDURE.
     1188   PROCEDURE enable_UI :
     1189     DISPLAY f-cdrgbcgb f-cdrgscgb f-cdrgsclc f-cdrgssgb f-cdrgsslc f-cdrgpglc
     1190             f-cdrgctgb f-cdrgdcgb f-cdrgdrgb f-cdrgfmgb f-cdrgpngb f-cdrgcagb
     1191             f-cdrgfdgb
     1192         WITH FRAME Dialog-Frame.
     1193     ENABLE B-exit b-quit B-Help f-cdrgbcgb f-cdrgscgb f-cdrgsclc f-cdrgssgb
     1194            f-cdrgsslc f-cdrgpglc f-cdrgctgb f-cdrgdcgb f-cdrgdrgb f-cdrgfmgb
     1195            f-cdrgpngb f-cdrgcagb f-cdrgfdgb
     1196         WITH FRAME Dialog-Frame.
     1197     VIEW FRAME Dialog-Frame.
     1198   END PROCEDURE.
     1199   PROCEDURE fill-widgets :
     1200   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     1201   DEFINE VARIABLE v-entry AS CHARACTER NO-UNDO.
     1202   define variable v-param-type as character no-undo .
     1203   define variable v-param-value as character no-undo .
     1204   define variable v-value-character as character no-undo .
     1205   define variable v-value-date as date no-undo .
     1206   define variable v-value-decimal as decimal no-undo .
     1207   define variable v-value-integer as INTEGER no-undo .
     1208   define variable v-value-logical AS LOGICAL no-undo .
     1209   FOR EACH thbjattr_thbj-attr:
     1210     delete thbjattr_thbj-attr.
     1211   end.
     1212   FOR EACH temp-thbj-attr:
     1213     delete temp-thbj-attr.
     1214   end.
     1215   run adm/shattri.p (
     1216                 input "init":U
     1217               , input p-obj-type
     1218               , input p-obj-code
     1219               , input 'code-range':U
     1220               , input "":U
     1221               , output v-value-character
     1222               , output v-value-date
     1223               , output v-value-decimal
     1224               , output v-value-integer
     1225               , output v-value-logical
     1226               , output v-param-type
     1227               , INPUT-OUTPUT TABLE-handle v-tth
     1228               ) no-error .
     1229   if error-status:error
     1230   and not available locked_thbj-attr then do:
     1231     message
     1232     "Не удалось получить начальные значения настроек" skip
     1233     error-status:get-message(1) return-value
     1234     view-as alert-box error .
     1235     undo, return error .
     1236   end.
     1237   FOR EACH thbjattr_thbj-attr:
     1238     ASSIGN
     1239     v-entry = thbjattr_thbj-attr.prop-code.
     1240     IF v-entry = 'cdrgbcgb':U THEN DO:
     1241       ASSIGN
     1242       f-cdrgbcgb = thbjattr_thbj-attr.property-value-integer
     1243       f-cdrgbcgb:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1244       .
     1245     END.
     1246     IF v-entry = 'cdrgctgb':U THEN DO:
     1247       ASSIGN
     1248       f-cdrgctgb = thbjattr_thbj-attr.property-value-integer
     1249       f-cdrgctgb:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1250       .
     1251     END.
     1252     IF v-entry = 'cdrgdcgb':U THEN DO:
     1253       ASSIGN
     1254       f-cdrgdcgb = thbjattr_thbj-attr.property-value-integer
     1255       f-cdrgdcgb:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1256       .
     1257     END.
     1258     IF v-entry = 'cdrgdrgb':U THEN DO:
     1259       ASSIGN
     1260       f-cdrgdrgb = thbjattr_thbj-attr.property-value-integer
     1261       f-cdrgdrgb:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1262       .
     1263     END.
     1264     IF v-entry = 'cdrgfmgb':U THEN DO:
     1265       ASSIGN
     1266       f-cdrgfmgb = thbjattr_thbj-attr.property-value-integer
     1267       f-cdrgfmgb:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1268       .
     1269     END.
     1270     IF v-entry = 'cdrgpngb':U THEN DO:
     1271       ASSIGN
     1272       f-cdrgpngb = thbjattr_thbj-attr.property-value-integer
     1273       f-cdrgpngb:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1274       .
     1275     END.
     1276     IF v-entry = 'cdrgscgb':U THEN DO:
     1277       ASSIGN
     1278       f-cdrgscgb = thbjattr_thbj-attr.property-value-integer
     1279       f-cdrgscgb:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1280       .
     1281     END.
     1282     IF v-entry = 'cdrgsclc':U THEN DO:
     1283       ASSIGN
     1284       f-cdrgsclc = thbjattr_thbj-attr.property-value-integer
     1285       f-cdrgsclc:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1286       .
     1287     END.
     1288     IF v-entry = 'cdrgssgb':U THEN DO:
     1289       ASSIGN
     1290       f-cdrgssgb = thbjattr_thbj-attr.property-value-integer
     1291       f-cdrgssgb:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1292       .
     1293     END.
     1294     IF v-entry = 'cdrgsslc':U THEN DO:
     1295       ASSIGN
     1296       f-cdrgsslc = thbjattr_thbj-attr.property-value-integer
     1297       f-cdrgsslc:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1298       .
     1299     END.
     1300     IF v-entry = 'cdrgcagb':U THEN DO:
     1301       ASSIGN
     1302       f-cdrgcagb = thbjattr_thbj-attr.property-value-integer
     1303       f-cdrgcagb:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1304       .
     1305     END.
     1306     IF v-entry = 'cdrgpglc':U THEN DO:
     1307       ASSIGN
     1308       f-cdrgpglc = thbjattr_thbj-attr.property-value-integer
     1309       f-cdrgpglc:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1310       .
     1311     END.
     1312     IF v-entry = 'cdrgfdgb':U THEN DO:
     1313       ASSIGN
     1314       f-cdrgfdgb = thbjattr_thbj-attr.property-value-integer
     1315       f-cdrgfdgb:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1316       .
     1317     END.
     1318     create temp-thbj-attr.
     1319     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     1320   END.
     1321   END PROCEDURE.
     1322   PROCEDURE MyEnable :
     1323   ASSIGN
     1324   FRAME Dialog-Frame:TITLE = substitute("&1 &2 &3"
     1325                                           ,(FRAME Dialog-Frame:TITLE)
     1326                                           ,(if p-obj-type = 'БД':U then "БД" else "")
     1327                                           ,(if p-obj-type = 'БД':U then string(p-obj-code) else "")
     1328                                           )
     1329   v-tab-order = "f-cdrgbcgb,f-cdrgscgb,f-cdrgsclc,f-cdrgssgb,f-cdrgsslc,f-cdrgpglc,f-cdrgctgb,f-cdrgdcgb,f-cdrgdrgb,f-cdrgfmgb,f-cdrgpngb,f-cdrgcagb.f-cdrgfdgb".
     1330   DISPLAY
     1331   f-cdrgbcgb
     1332   f-cdrgscgb
     1333   f-cdrgsclc
     1334   f-cdrgssgb
     1335   f-cdrgsslc
     1336   f-cdrgpglc
     1337   f-cdrgctgb
     1338   f-cdrgdcgb
     1339   f-cdrgdrgb
     1340   f-cdrgfmgb
     1341   f-cdrgpngb
     1342   f-cdrgcagb
     1343   f-cdrgfdgb
     1344   WITH FRAME Dialog-Frame.
     1345   ENABLE
     1346   B-exit WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1347   b-quit
     1348   B-Help
     1349   f-cdrgbcgb WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1350   f-cdrgscgb WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1351   f-cdrgsclc WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1352   f-cdrgssgb WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1353   f-cdrgsslc WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1354   f-cdrgpglc WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1355   f-cdrgctgb WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1356   f-cdrgdcgb WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1357   f-cdrgdrgb WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1358   f-cdrgfmgb WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1359   f-cdrgpngb WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1360   f-cdrgcagb WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1361   f-cdrgfdgb WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1362   WITH FRAME Dialog-Frame.
     1363   VIEW FRAME Dialog-Frame.
     1364   IF p-mode = 'ПРОСМОТР':U THEN DO:
     1365       HIDE
     1366       b-exit
     1367       IN FRAME Dialog-Frame.
     1368       ASSIGN
     1369       b-quit:LABEL = "&Выход"
     1370       b-quit:column = 1
     1371       .
     1372   END.
     1373   END PROCEDURE.
     1374   PROCEDURE proc-save :
     1375   define variable v-value-character as character no-undo .
     1376   define variable v-value-date as date no-undo .
     1377   define variable v-value-decimal as decimal no-undo .
     1378   define variable v-value-integer as INTEGER no-undo .
     1379   define variable v-value-logical AS LOGICAL no-undo .
     1380   define variable v-param-type as character no-undo .
     1381   define variable wh as widget-handle no-undo .
     1382   define variable fh as widget-handle no-undo .
     1383   define variable v-same as logical no-undo .
     1384   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     1385   ASSIGN
     1386   FRAME Dialog-Frame
     1387   f-cdrgbcgb
     1388   f-cdrgscgb
     1389   f-cdrgsclc
     1390   f-cdrgssgb
     1391   f-cdrgsslc
     1392   f-cdrgpglc
     1393   f-cdrgctgb
     1394   f-cdrgdcgb
     1395   f-cdrgdrgb
     1396   f-cdrgfmgb
     1397   f-cdrgpngb
     1398   f-cdrgcagb
     1399   f-cdrgfdgb
     1400   .
     1401   assign
     1402   fh = frame Dialog-Frame:first-child
     1403   wh = fh:first-child
     1404   .
     1405   do while valid-handle(wh):
     1406     if wh:private-data begins "recid=" then do:
     1407       find first thbjattr_thbj-attr where
     1408                 recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     1409       assign
     1410       buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     1411     end.
     1412     wh = wh:next-sibling.
     1413   end.
     1414   v-same = yes.
     1415   for each thbjattr_thbj-attr,
     1416       first temp-thbj-attr where
     1417             temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     1418         and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     1419         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     1420         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code:
     1421      buffer-compare
     1422      thbjattr_thbj-attr
     1423      to temp-thbj-attr
     1424      save result in v-same.
     1425      if v-same = no then leave.
     1426   end.
     1427   v-same = no.
     1428   IF v-same  and not v-to-create THEN RETURN.
     1429   run adm/shattri.p (
     1430                  input "check":U
     1431                , input p-obj-type
     1432                , input p-obj-code
     1433                , input 'code-range':U
     1434                , input '':U
     1435                , output v-value-character
     1436                , output v-value-date
     1437                , output v-value-decimal
     1438                , output v-value-integer
     1439                , output v-value-logical
     1440                , output v-param-type
     1441                , input-output TABLE-handle v-tth
     1442               ) no-error .
     1443   if error-status:error then do:
     1444     message
     1445     "Некорректное значение ПАРАМЕТРОВ" skip
     1446     error-status:get-message(1) skip
     1447     return-value
     1448     view-as alert-box error .
     1449     undo, return error .
     1450   end.
     1451   RUN thbjattr_set-section IN THIS-PROCEDURE (
     1452        input p-obj-type
     1453       ,input p-obj-code
     1454       ,input 'code-range':U
     1455       ,input table thbjattr_thbj-attr
     1456   ) NO-ERROR.
     1457   IF ERROR-STATUS:error THEN do:
     1458     MESSAGE ERROR-STATUS:get-message(1)  SKIP
     1459     RETURN-VALUE
     1460     VIEW-AS ALERT-BOX.
     1461     UNDO, RETURN ERROR.
     1462   END.
     1463   END PROCEDURE.
