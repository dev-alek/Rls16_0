        1   DEFINE BUFFER locked_thbj-attr FOR ub.thbj-attr.
        2   DEFINE TEMP-TABLE tt-sale-add NO-UNDO LIKE ub.clients
        3          field doc-kind as character
        4          field doc-kind-label as character
        5          index pi is primary unique doc-kind.
        6   DEFINE TEMP-TABLE tt-trn-doc NO-UNDO LIKE ub.trn-doc.
        7   DEFINE BUFFER X_shop FOR ub.shop.
        8   DEFINE BUFFER X_sysconf FOR ub.sysconf.
        9   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
       10   DEFINE INPUT PARAMETER p-mode AS CHARACTER NO-UNDO.
       11   DEFINE INPUT PARAMETER p-obj-type LIKE ub.clients.obj-type NO-UNDO.
       12   DEFINE INPUT PARAMETER p-obj-code LIKE ub.clients.obj-code NO-UNDO.
       13   define variable vss-revision    as character no-undo init "$Revision$":U .
       14   define variable vss-author      as character no-undo init "$Author$":U .
       15   define variable vss-date        as character no-undo init "$Date$":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       17   define variable vss-archive     as character no-undo init "$Archive$":U .
       18   define variable vss-description as character no-undo init "Редактирование атрибута магазина (thbj-attr) 'autosale'".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       74   define variable v-waitfram-action01         as character   no-undo .
       75   define variable v-waitfram-action02         as character   no-undo .
       76   define variable v-waitfram-action03         as character   no-undo .
       77   define variable mWaitFramTextBeg            as character   no-undo.
       78   define variable mWaitFramTextEnd            as character   no-undo.
       79   define variable mWaitFramView               as logical     no-undo.
       80   define variable mWaitProcEvent              as logical     no-undo init yes.
       81   define variable mWaitFramInterval           as integer     no-undo init 1 .
       82   define variable mWaitFramStop               as logical     no-undo.
       83   define variable mWaitFramStopUser           as logical     no-undo.
       84   define variable mWaitFramStopTimeOut        as logical     no-undo.
       85   define variable mWaitFramStartProc          as datetime-tz no-undo.
       86   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       87   define button B-WaitFramStop auto-end-key
       88        label "Стоп"
       89        size 10 by 1 tooltip "Остоновить процесс".
       90   define button B-viewProcInfo
       91        label "Информация"
       92        size 15 by 1 tooltip "Информация о процесс".
       93   define frame waitfram
       94     v-waitfram-action01 format "x(72)" no-label skip
       95     v-waitfram-action02 format "x(72)" no-label skip
       96     v-waitfram-action03 format "x(72)" no-label skip
       97     B-viewProcInfo
       98     B-WaitFramStop at row 4 col 30
       99     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      100     .
      101   define new global shared variable mBatchMode as logical no-undo init ?.
      102   define variable mFramBachModHandle as handle no-undo.
      103   mFramBachModHandle = frame waitfram:handle.
      104   define variable mFameOldVis as logical no-undo.
      105   define variable mVisCUrentVin as logical no-undo.
      106   if session:batch-mode
      107   then
      108      mBatchMode = yes.
      109   if mBatchMode = ? then do:
      110     mVisCUrentVin = current-window:visible.
      111     mFameOldVis = mFramBachModHandle:visible.
      112     mFramBachModHandle:visible  = yes.
      113     mBatchMode = mFramBachModHandle:visible ne yes.
      114     mFramBachModHandle:visible = mFameOldVis.
      115     current-window:visible = mVisCUrentVin.
      116   end.
      117    if  log-manager:logfile-name ne ?
      118     then DO:
      119         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      120         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      121         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      122     end.
      123   on choose of B-WaitFramStop in frame waitfram
      124   do:
      125     mWaitFramStop = yes.
      126     mWaitFramStopUser = yes.
      127   end.
      128   function waitfram-check-timeout returns logical():
      129      define variable vtime as int64 no-undo.
      130      if mWaitFramStopTimeOut
      131      then
      132         return yes.
      133      vtime = ( now - mWaitFramStartProc ) / 1000 .
      134      if     mWaitFramTimeOut ne ?
      135         and mWaitFramTimeOut ne 0
      136         and mWaitFramTimeOut lt vtime
      137      then do:
      138         mWaitFramStopTimeOut = yes.
      139      end.
      140      return mWaitFramStopTimeOut.
      141   end.
      142   procedure waitfram-hide :
      143     if not session:batch-mode
      144     then do
      145     on error undo, return error return-value
      146     :
      147       pause 0 before-hide .
      148       if not mBatchMode then
      149         hide frame waitfram .
      150     if     not mWaitFramView
      151        and mWaitProcEvent
      152     then
      153       process events .
      154     end.
      155   end procedure.
      156   procedure waitfram-show :
      157     define input  parameter p-message as character no-undo .
      158     define variable v-left-margin as integer   no-undo .
      159     if not session:batch-mode
      160     then do
      161     on error undo, return error return-value
      162     :
      163       if length(p-message) <= 70 then do:
      164         assign
      165           v-left-margin = integer((70 - length(p-message)) / 2)
      166         .
      167         assign
      168           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      169         .
      170         assign
      171           v-waitfram-action01 = " "
      172           v-waitfram-action02 = " "
      173                                    + fill(" ", v-left-margin)
      174                                    + p-message
      175           v-waitfram-action03 = " "
      176         .
      177       end.
      178       else do:
      179         define variable vRindex1 as integer no-undo.
      180         define variable vRindex2 as integer no-undo.
      181         vRindex1 = r-index(p-message," ",70).
      182         if vRindex1 = 0
      183         then
      184            vRindex1 = 70.
      185         if length(p-message)  <= vRindex1 + 70 then do:
      186           assign
      187             v-waitfram-action01 = " "
      188             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      189             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      190           .
      191         end.
      192         else do:
      193           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      194           if vRindex2 <= vRindex1
      195           then
      196              vRindex2 = vRindex1 + 70.
      197           assign
      198             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      199             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      200             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      201           .
      202         end.
      203       end.
      204       B-viewProcInfo:visible   in frame waitfram = no.
      205       B-viewProcInfo:sensitive in frame waitfram = no.
      206       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      207       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      208       if  (   mWaitFramView
      209          or  mWaitProcEvent)
      210          and not mBatchMode
      211       then
      212          display
      213             v-waitfram-action01 skip
      214             v-waitfram-action02 skip
      215             v-waitfram-action03 skip
      216          with frame waitfram .
      217       if     mWaitFramView
      218          then do:
      219             if     mWaitFramInterval ne ?
      220                and not mBatchMode
      221             then
      222                wait-for go of frame waitfram pause mWaitFramInterval.
      223          end.
      224          else
      225             if     mWaitProcEvent
      226                and not mBatchMode
      227             then
      228                process events .
      229     end.
      230   end procedure.
      231      procedure waitfram-show-this:
      232         define input  parameter iInterval as int64 no-undo.
      233         define variable vtime as int64 no-undo.
      234         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      235         mWaitFramInterval = iInterval.
      236         run waitfram-show (substitute("&1&2 &3&4" ,
      237                                       mWaitFramTextBeg ,
      238                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      239                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      240                                       mWaitFramTextEnd
      241                                      )
      242                           ).
      243      end.
      244      procedure WaitFramRunPause:
      245         define input  parameter iInterval as dec no-undo.
      246         define variable vStart  as datetime-tz no-undo.
      247         define variable vend    as datetime-tz no-undo.
      248         define variable vint as int64 no-undo.
      249         define variable vOk as logical no-undo.
      250         vStart = now.
      251         vend   = vStart.
      252         publish "WaitFramPause" (iInterval,output vOk).
      253         vend   =  now.
      254         vint = vend - vStart.
      255         vint = iInterval - vint / 1000.
      256         if     not mWaitFramStop
      257            and (   vint > 0
      258                 or (    not vOk
      259                     and iInterval eq ?
      260                     )
      261                 )
      262         then
      263            run waitfram-show-this (iInterval).
      264         vend   =  now.
      265         vint = vend - vStart.
      266         vint = iInterval - vint / 1000.
      267         if     not mWaitFramStop
      268            and vint > 0
      269         then do:
      270            run gbl/pause.p (vint * 1000).
      271         end.
      272         if iInterval ne ?
      273         then
      274            publish "WaitFramStop".
      275         waitfram-check-timeout().
      276      end.
      277      procedure WaitFramWaitFor:
      278         define input  parameter iInterval as dec no-undo.
      279         assign
      280            mWaitFramStartProc   = now
      281            mWaitFramStopUser    = no
      282            mWaitFramStopTimeOut = no
      283         .
      284         block-wait:
      285         do while not mWaitFramStop:
      286            run WaitFramRunPause (iInterval).
      287            if  waitfram-check-timeout()
      288            then do:
      289               leave block-wait.
      290            end.
      291         end.
      292         run waitfram-hide.
      293      end.
      294   procedure waitfram-join :
      295     define input  parameter p-line-1  as character no-undo .
      296     define input  parameter p-line-2  as character no-undo .
      297     define input  parameter p-line-3  as character no-undo .
      298     define output parameter p-message as character no-undo .
      299     do
      300     on error undo, return error return-value
      301     :
      302       assign
      303         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      304                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      305                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      306       .
      307     end.
      308   end procedure.
      309   function waitfram-join-function returns character
      310     (input p-line-1 as character
      311     ,input p-line-2 as character
      312     ,input p-line-3 as character
      313     ).
      314     define variable v-message as character no-undo .
      315     run waitfram-join in this-procedure
      316       (input  p-line-1
      317       ,input  p-line-2
      318       ,input  p-line-3
      319       ,output v-message
      320       ) .
      321     return v-message .
      322   end function .
      323   define new global shared variable g#language as character no-undo .
      324   if g#language <> '' and g#language <> 'rus':U then do:
      325     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      326   end.
