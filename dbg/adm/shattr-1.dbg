      901     if not ibs.th.gbl.gbl-var:rcode
      902   then
      903     run gbl\inidebug.p .
      904   end.
      905   procedure proc-alt-shift-f3:
      906     run gbl/prvssinf.p
      907       ( input this-procedure
      908       ) .
      909   end.
      910   define variable v-inform-launched as logical no-undo initial false .
      911   procedure proc-alt-shift-f4:
      912     define variable v-action as character no-undo .
      913     if v-inform-launched = false then do:
      914       assign
      915         v-inform-launched = true
      916       .
      917       run gbl/d-inform.w
      918         (  input self
      919         ,  input this-procedure
      920         , output v-action
      921         ) no-error .
      922       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      923       assign
      924         v-inform-launched = false
      925       .
      926     end.
      927   end.
      928   procedure proc-alt-f1:
      929     run gbl/corrhelp.p
      930       (input this-procedure
      931       ) .
      932   end .
      933   on alt-shift-f2 anywhere do:
      934     run proc-alt-shift-f2.
      935   end.
      936   on alt-shift-f3 anywhere do:
      937     run proc-alt-shift-f3 in this-procedure .
      938   end.
      939   on alt-shift-f4 anywhere do:
      940     run proc-alt-shift-f4 in this-procedure.
      941   end.
      942   on alt-f1 anywhere do:
      943     run proc-alt-f1 in this-procedure .
      944   end.
      945   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      946     define variable v-cntxt-db-num        as integer   no-undo .
      947     define variable v-cntxt-userid        as character no-undo .
      948     define variable v-cntxt-level         as character no-undo .
      949     define variable v-cntxt-host-code-obj as integer   no-undo .
      950     define variable v-cntxt-obj-type      as character no-undo .
      951     define variable v-cntxt-obj-code      as integer   no-undo .
      952     define variable v-cntxt-db-num-obj    as integer   no-undo .
      953     define variable v-cntxt-is-admin      as logical   no-undo .
      954   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      955   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      956   DEFINE VARIABLE v-db-num LIKE ub.db.db-num NO-UNDO.
      957   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO.
      958   DEFINE VARIABLE v-to-create AS logical NO-UNDO.
      959   define variable v-ref-rec as recid no-undo .
      960   DEFINE VARIABLE ref-list AS CHARACTER NO-UNDO.
      961   DEFINE BUFFER cli-buf FOR ub.clients .
      962   define variable v-tth as handle no-undo .
      963   assign
      964   v-tth = buffer thbjattr_thbj-attr:table-handle .
      965   DEFINE BUTTON B-exit AUTO-GO
      966        LABEL "&Ввод"
      967        SIZE 10 BY 1
      968        BGCOLOR 8 .
      969   DEFINE BUTTON B-Help
      970        LABEL "Помо&щь"
      971        SIZE 3 BY 1
      972        BGCOLOR 8 .
      973   DEFINE BUTTON b-quit AUTO-END-KEY
      974        LABEL "&Отмена"
      975        SIZE 10 BY 1
      976        BGCOLOR 8 .
      977   DEFINE BUTTON B-sc-clear
      978        LABEL "&Сбросить"
      979        SIZE 10 BY 1.
      980   DEFINE BUTTON B-sc-update
      981        LABEL "<-&Изменить"
      982        SIZE 10 BY 1.
      983   DEFINE BUTTON r-agnt
      984        IMAGE-UP FILE "btn-down-arrow":U
      985        IMAGE-DOWN FILE "btn-down-arrow":U
      986        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      987        LABEL "r-acc"
      988        SIZE 3 BY .87.
      989   DEFINE BUTTON r-boss
      990        IMAGE-UP FILE "btn-down-arrow":U
      991        IMAGE-DOWN FILE "btn-down-arrow":U
      992        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      993        LABEL "r-acc"
      994        SIZE 3 BY .87.
      995   DEFINE BUTTON r-wrkr
      996        IMAGE-UP FILE "btn-down-arrow":U
      997        IMAGE-DOWN FILE "btn-down-arrow":U
      998        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      999        LABEL "r-acc"
     1000        SIZE 3 BY .87.
     1001   DEFINE VARIABLE agnt-name AS CHARACTER FORMAT "x(256)":U
     1002         VIEW-AS TEXT
     1003        SIZE 10.5 BY 1
     1004        FGCOLOR 4 FONT 4 NO-UNDO.
     1005   DEFINE VARIABLE boss-name AS CHARACTER FORMAT "x(256)":U
     1006         VIEW-AS TEXT
     1007        SIZE 10.5 BY 1
     1008        FGCOLOR 4 FONT 4 NO-UNDO.
     1009   DEFINE VARIABLE f-neg-tpsi-qnty AS DECIMAL FORMAT ">>,>>9.99":U INITIAL 0
     1010        LABEL "уводить в отриц.ост-ки чужой товар с количеством <"
     1011        VIEW-AS FILL-IN
     1012        SIZE 15 BY 1 TOOLTIP "если чужого товара недостаточно" NO-UNDO.
     1013   DEFINE VARIABLE wrkr-name AS CHARACTER FORMAT "x(256)":U
     1014         VIEW-AS TEXT
     1015        SIZE 10.5 BY 1
     1016        FGCOLOR 4 FONT 4 NO-UNDO.
     1017   DEFINE VARIABLE rs-tpsi-mode AS INTEGER
     1018        VIEW-AS RADIO-SET HORIZONTAL
     1019        RADIO-BUTTONS
     1020             "1", 1,
     1021   "2", 2
     1022        SIZE 11.5 BY 1 NO-UNDO.
     1023   DEFINE VARIABLE t-augetres AS LOGICAL INITIAL no
     1024        LABEL "автом. резервирование после чтения чеков с кассы"
     1025        VIEW-AS TOGGLE-BOX
     1026        SIZE 70 BY 1 NO-UNDO.
     1027   DEFINE VARIABLE t-autocalc AS LOGICAL INITIAL no
     1028        LABEL "автом. расчет шапки накл. после входа в РАСЧЕТ ПРОДАЖИ"
     1029        VIEW-AS TOGGLE-BOX
     1030        SIZE 60 BY 1 NO-UNDO.
     1031   DEFINE VARIABLE t-autoclos AS LOGICAL INITIAL no
     1032        LABEL "автом. закрытие продажи после удачного резервирования"
     1033        VIEW-AS TOGGLE-BOX
     1034        SIZE 70 BY 1 NO-UNDO.
     1035   DEFINE VARIABLE t-autocomp AS LOGICAL INITIAL no
     1036        LABEL "компенсация расход-возврат (в момент закрытия продажи)"
     1037        VIEW-AS TOGGLE-BOX
     1038        SIZE 70 BY 1 NO-UNDO.
     1039   DEFINE VARIABLE t-autofbr AS LOGICAL INITIAL no
     1040        LABEL "автом. пр-во необходимых блюд (для РЕСТОРАНА)"
     1041        VIEW-AS TOGGLE-BOX
     1042        SIZE 70 BY 1 NO-UNDO.
     1043   DEFINE VARIABLE t-automail AS LOGICAL INITIAL no
     1044        LABEL "автом. чтение чеков с кассы после входа в РАСЧЕТ ПРОДАЖИ"
     1045        VIEW-AS TOGGLE-BOX
     1046        SIZE 60 BY 1 NO-UNDO.
     1047   DEFINE VARIABLE t-close-day-period AS LOGICAL INITIAL no
     1048        LABEL "закрыть период по дате продажи"
     1049        VIEW-AS TOGGLE-BOX
     1050        SIZE 37.3 BY 1 TOOLTIP "Не разрешено делать более одной продажи в день (за смену)" NO-UNDO.
     1051   DEFINE VARIABLE t-close-in-rfsl AS LOGICAL INITIAL no
     1052        LABEL "закрывать приход по техпроливу на факт"
     1053        VIEW-AS TOGGLE-BOX
     1054        SIZE 70 BY 1 NO-UNDO.
     1055   DEFINE VARIABLE t-main-tpsi AS LOGICAL INITIAL no
     1056        LABEL "Объект-распределитель"
     1057        VIEW-AS TOGGLE-BOX
     1058        SIZE 27 BY 1 TOOLTIP "объект, принимающий чеки с <общих> касс ТПСИ" NO-UNDO.
     1059   DEFINE VARIABLE t-neg-tpsi-oper AS LOGICAL INITIAL no
     1060        LABEL "уводить в отриц.ост-ки чужой товар по отметке оператора (для ТПСИ)"
     1061        VIEW-AS TOGGLE-BOX
     1062        SIZE 70 BY 1 NO-UNDO.
     1063   DEFINE VARIABLE t-neg-tpsi-weight AS LOGICAL INITIAL no
     1064        LABEL "уводить в отриц.ост-ки чужой весовой товар на объекте продажи (для ТПСИ)"
     1065        VIEW-AS TOGGLE-BOX
     1066        SIZE 76 BY 1 TOOLTIP "если чужого вес.товара недостаточно" NO-UNDO.
     1067   DEFINE VARIABLE t-one-curs AS LOGICAL INITIAL no
     1068        LABEL "в продажу чеки только с одним значением курса баз.вал."
     1069        VIEW-AS TOGGLE-BOX
     1070        SIZE 70 BY 1 NO-UNDO.
     1071   DEFINE VARIABLE t-one-sale-per-day AS LOGICAL INITIAL no
     1072        LABEL "один день-одна продажа"
     1073        VIEW-AS TOGGLE-BOX
     1074        SIZE 37.3 BY 1 TOOLTIP "Не разрешено делать более одной продажи в день (за смену)" NO-UNDO.
     1075   DEFINE VARIABLE t-pay-gds-algo AS LOGICAL INITIAL no
     1076        LABEL "разбивка по типам касс.плат."
     1077        VIEW-AS TOGGLE-BOX
     1078        SIZE 37.3 BY 1 TOOLTIP "Разбивка строк чека по типам касс.плат. при закачке чека в продажу для дальнейш" NO-UNDO.
     1079   DEFINE VARIABLE t-prcl-spl AS LOGICAL INITIAL no
     1080        LABEL "Значение цены в продаже брать из прайс-листа (не из чека)"
     1081        VIEW-AS TOGGLE-BOX
     1082        SIZE 70 BY 1 NO-UNDO.
     1083   DEFINE VARIABLE t-restdish AS LOGICAL INITIAL no
     1084        LABEL "учет остатков блюд при резервировании (для автом. пр-ва)"
     1085        VIEW-AS TOGGLE-BOX
     1086        SIZE 70 BY 1 NO-UNDO.
     1087   DEFINE VARIABLE t-restingr AS LOGICAL INITIAL no
     1088        LABEL "учет остатков ингридиентов при резервировании (для автом. пр-ва)"
     1089        VIEW-AS TOGGLE-BOX
     1090        SIZE 70 BY 1 NO-UNDO.
     1091   DEFINE VARIABLE t-resttpsi AS LOGICAL INITIAL no
     1092        LABEL "учет остатков товаров при резервировании (для ТПСИ)"
     1093        VIEW-AS TOGGLE-BOX
     1094        SIZE 66.5 BY 1 TOOLTIP "резервировать остатки чужого товара на объекте продажи" NO-UNDO.
     1095   DEFINE VARIABLE t-sale-filter AS LOGICAL INITIAL no
     1096        LABEL "в продажу чеки только по фильтру (если задан)"
     1097        VIEW-AS TOGGLE-BOX
     1098        SIZE 70 BY 1 NO-UNDO.
     1099   DEFINE QUERY BR-sale-add FOR
     1100         tt-sale-add SCROLLING.
     1101   DEFINE QUERY Dialog-Frame FOR
     1102         tt-trn-doc SCROLLING.
     1103   DEFINE BROWSE BR-sale-add
     1104     QUERY BR-sale-add NO-LOCK DISPLAY
     1105         doc-kind-label COLUMN-LABEL "Предназначен" FORMAT "X(20)":U
     1106               WIDTH 22
     1107         tt-sale-add.obj-type FORMAT "X(3)":U
     1108         tt-sale-add.obj-code COLUMN-LABEL "Код" FORMAT ">>>>>>>>9":U
     1109         tt-sale-add.obj-name FORMAT "X(40)":U WIDTH 28.3
     1110       WITH NO-ROW-MARKERS SEPARATORS SIZE 66 BY 4.5
     1111            TITLE "Контрагенты для дополнительных документов, создаваемых по продаже" FIT-LAST-COLUMN.
     1112   DEFINE FRAME Dialog-Frame
     1113        B-exit AT ROW 1 COL 1
     1114        b-quit AT ROW 1 COL 11
     1115        B-Help AT ROW 1 COL 95
     1116        t-automail AT ROW 2 COL 1
     1117        t-one-sale-per-day AT ROW 2 COL 62 WIDGET-ID 22
     1118        t-augetres AT ROW 3 COL 1
     1119        t-close-day-period AT ROW 3 COL 62 WIDGET-ID 24
     1120        t-autocalc AT ROW 4 COL 1
     1121        t-pay-gds-algo AT ROW 4 COL 62 WIDGET-ID 28
     1122        t-autoclos AT ROW 5 COL 1
     1123        t-autocomp AT ROW 6 COL 1
     1124        t-one-curs AT ROW 7 COL 1
     1125        t-sale-filter AT ROW 8 COL 1
     1126        t-prcl-spl AT ROW 9 COL 1
     1127        t-autofbr AT ROW 10 COL 1
     1128        t-restdish AT ROW 11 COL 1
     1129        t-restingr AT ROW 12 COL 1
     1130        rs-tpsi-mode AT ROW 13 COL 28 NO-LABEL
     1131        t-main-tpsi AT ROW 13 COL 71
     1132        t-resttpsi AT ROW 14 COL 1
     1133        t-neg-tpsi-weight AT ROW 15 COL 1
     1134        f-neg-tpsi-qnty AT ROW 16 COL 54 COLON-ALIGNED
     1135        t-neg-tpsi-oper AT ROW 17 COL 1
     1136        t-close-in-rfsl AT ROW 18 COL 1 WIDGET-ID 26
     1137        BR-sale-add AT ROW 19 COL 1
     1138        B-sc-update AT ROW 19.13 COL 67.5
     1139        B-sc-clear AT ROW 19 COL 78 WIDGET-ID 30
     1140        tt-trn-doc.wrkr AT ROW 20.47 COL 74 COLON-ALIGNED WIDGET-ID 18
     1141             LABEL "К&л-к"
     1142             VIEW-AS FILL-IN
     1143             SIZE 8.8 BY 1
     1144             FONT 4
     1145        r-wrkr AT ROW 20.47 COL 96.1 WIDGET-ID 14
     1146        tt-trn-doc.agnt AT ROW 21.47 COL 74 COLON-ALIGNED WIDGET-ID 2
     1147             LABEL "И&сп"
     1148             VIEW-AS FILL-IN
     1149             SIZE 8.8 BY 1
     1150             FONT 4
     1151        r-agnt AT ROW 21.47 COL 96 WIDGET-ID 10
     1152        tt-trn-doc.boss AT ROW 22.47 COL 74 COLON-ALIGNED WIDGET-ID 6
     1153             LABEL "&М-р"
     1154             VIEW-AS FILL-IN
     1155             SIZE 8.8 BY 1
     1156             FONT 4
     1157        r-boss AT ROW 22.47 COL 96 WIDGET-ID 12
     1158        wrkr-name AT ROW 20.47 COL 83.5 COLON-ALIGNED NO-LABEL WIDGET-ID 20
     1159        agnt-name AT ROW 21.47 COL 83.5 COLON-ALIGNED NO-LABEL WIDGET-ID 4
     1160        boss-name AT ROW 22.47 COL 83.5 COLON-ALIGNED NO-LABEL WIDGET-ID 8
     1161        "Режим работы ТПСИ" VIEW-AS TEXT
     1162             SIZE 19.5 BY 1 AT ROW 13 COL 4
     1163             FGCOLOR 4
     1164        "Проставлять в док-ты:" VIEW-AS TEXT
     1165             SIZE 20.5 BY 1 AT ROW 19.13 COL 78.5 WIDGET-ID 16
     1166             FGCOLOR 4
     1167        SPACE(0.30) SKIP(3.44)
     1168       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1169            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1170            TITLE "Набор опций работы с продажей"
     1171            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     1172   ASSIGN
     1173          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1174          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1175   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1176   DO:
     1177     APPLY "END-ERROR":U TO SELF.
     1178   END.
     1179   ON LEAVE OF tt-trn-doc.agnt IN FRAME Dialog-Frame
     1180   DO:
     1181     if input frame Dialog-Frame tt-trn-doc.agnt <> tt-trn-doc.agnt then do:
     1182       run local-psn-chk ("agnt", "leave").
     1183     end.
     1184   END.
     1185   ON MOUSE-SELECT-DBLCLICK OF tt-trn-doc.agnt IN FRAME Dialog-Frame
     1186   OR RETURN OF tt-trn-doc.agnt IN FRAME Dialog-Frame DO:
     1187     run local-psn-chk ("agnt", "ret-mouse").
     1188     apply "entry" to tt-trn-doc.boss in frame Dialog-Frame.
     1189     return no-apply.
     1190   END.
     1191   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1192   DO:
     1193     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
     1194     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1195   END.
     1196   ON CHOOSE OF B-sc-clear IN FRAME Dialog-Frame
     1197   DO:
     1198       DEFINE BUFFER buf_tt-sale-add FOR tt-sale-add.
     1199       FIND FIRST buf_tt-sale-add WHERE
     1200                 buf_tt-sale-add.doc-kind = tt-sale-add.doc-kind.
     1201       ASSIGN
     1202       buf_tt-sale-add.obj-type = ''
     1203       buf_tt-sale-add.obj-code = 0
     1204       buf_tt-sale-add.obj-name = ''
     1205       .
     1206       br-sale-add:REFRESH().
     1207   END.
     1208   ON CHOOSE OF B-sc-update IN FRAME Dialog-Frame
     1209   DO:
     1210     define VARIable v-rid-list AS CHARACTER NO-UNDO.
     1211     DEFINE BUFFER buf_tt-sale-add FOR tt-sale-add.
     1212     DEFINE BUFFER buf_clients FOR ub.clients.
     1213     IF NOT AVAILABLE tt-sale-add THEN DO:
     1214         message
     1215         "Выберите Предназначение документа, для которого вы хотите установить КОНТРАГЕНТА"
     1216         VIEW-AS ALERT-BOX.
     1217     END.
     1218     run ref/cli-all.w (
     1219                    input parparentproc
     1220                   ,input "b-sel"
     1221                   ,input 'орг':U
     1222                   ,input 'все':U
     1223                   ,input 'текущие':U
     1224                   ,input ?
     1225                   ,input ",,,,,,NO,,"
     1226                   ,input ""
     1227                   ,output v-rid-list ) NO-ERROR.
     1228     IF v-rid-list = '':U THEN RETURN NO-APPLY.
     1229     FIND FIRST buf_clients NO-LOCK WHERE
     1230               recid(buf_clients) = INTEGER(v-rid-list) NO-ERROR.
     1231     IF NOT AVAILABLE buf_clients THEN RETURN NO-APPLY.
     1232     FIND FIRST buf_tt-sale-add WHERE
     1233               buf_tt-sale-add.doc-kind = tt-sale-add.doc-kind.
     1234     ASSIGN
     1235     buf_tt-sale-add.obj-type = buf_clients.obj-type
     1236     buf_tt-sale-add.obj-code = buf_clients.obj-code
     1237     buf_tt-sale-add.obj-name = buf_clients.obj-name
     1238     .
     1239     br-sale-add:REFRESH().
     1240   END.
     1241   ON LEAVE OF tt-trn-doc.boss IN FRAME Dialog-Frame
     1242   DO:
     1243     if input frame Dialog-Frame tt-trn-doc.boss <> tt-trn-doc.boss then do:
     1244       run local-psn-chk ("boss", "leave").
     1245     end.
     1246   END.
     1247   ON MOUSE-SELECT-DBLCLICK OF tt-trn-doc.boss IN FRAME Dialog-Frame
     1248   OR RETURN OF tt-trn-doc.boss IN FRAME Dialog-Frame DO:
     1249     run local-psn-chk ("boss", "ret-mouse").
     1250     apply "entry" to tt-trn-doc.boss in frame Dialog-Frame.
     1251     return no-apply.
     1252   END.
     1253   ON CHOOSE OF r-agnt IN FRAME Dialog-Frame
     1254   DO:
     1255     RUN local-psn-chk ("agnt", "button").
     1256     apply "entry" to tt-trn-doc.agnt in FRAME Dialog-Frame.
     1257     return no-apply.
     1258   END.
     1259   ON CHOOSE OF r-boss IN FRAME Dialog-Frame
     1260   DO:
     1261     RUN local-psn-chk ("boss", "button").
     1262     apply "entry" to tt-trn-doc.boss in FRAME Dialog-Frame.
     1263     return no-apply.
     1264   END.
     1265   ON CHOOSE OF r-wrkr IN FRAME Dialog-Frame
     1266   DO:
     1267     RUN local-psn-chk ("wrkr", "button").
     1268     apply "entry" to tt-trn-doc.wrkr in FRAME Dialog-Frame.
     1269     return no-apply.
     1270   END.
     1271   ON VALUE-CHANGED OF rs-tpsi-mode IN FRAME Dialog-Frame
     1272   DO:
     1273       ASSIGN
     1274     rs-tpsi-mode.
     1275     CASE rs-tpsi-mode:
     1276       WHEN 1 THEN DO:
     1277         ASSIGN
     1278         t-main-tpsi = NO.
     1279         DISPLAY
     1280         t-main-tpsi
     1281         WITH FRAME Dialog-Frame.
     1282         DISABLE
     1283         t-main-tpsi
     1284         WITH FRAME Dialog-Frame.
     1285         if p-mode = 'ИЗМЕНЕНИЕ':U then
     1286         ENABLE
     1287         f-neg-tpsi-qnty
     1288         t-neg-tpsi-oper
     1289         t-neg-tpsi-weight
     1290         t-resttpsi
     1291         WITH FRAME Dialog-Frame.
     1292       END.
     1293       WHEN 2 THEN DO:
     1294         ASSIGN
     1295         f-neg-tpsi-qnty  = 0
     1296         t-neg-tpsi-oper  = NO
     1297         t-neg-tpsi-weight  = NO
     1298         t-resttpsi = NO.
     1299         DISPLAY
     1300         f-neg-tpsi-qnty
     1301         t-neg-tpsi-oper
     1302         t-neg-tpsi-weight
     1303         t-resttpsi
     1304         WITH FRAME Dialog-Frame.
     1305         DISABLE
     1306         f-neg-tpsi-qnty
     1307         t-neg-tpsi-oper
     1308         t-neg-tpsi-weight
     1309         t-resttpsi
     1310         WITH FRAME Dialog-Frame.
     1311         if p-mode = 'ИЗМЕНЕНИЕ':U then
     1312         ENABLE
     1313         t-main-tpsi
     1314         WITH FRAME Dialog-Frame.
     1315       END.
     1316     END CASE.
     1317   END.
     1318   ON VALUE-CHANGED OF t-autofbr IN FRAME Dialog-Frame
     1319   DO:
     1320     IF p-mode = 'ПРОСМОТР':U  THEN RETURN NO-APPLY.
     1321     ASSIGN
     1322     t-autofbr.
     1323     CASE t-autofbr:
     1324         WHEN YES THEN DO:
     1325            ENABLE
     1326            t-restdish
     1327            t-restingr
     1328            WITH FRAME Dialog-Frame.
     1329         END.
     1330         WHEN NO THEN DO:
     1331             ASSIGN
     1332              t-restdish = NO
     1333              t-restingr = NO.
     1334             DISPLAY
     1335             t-restdish
     1336             t-restingr
     1337             WITH FRAME Dialog-Frame.
     1338             disable
     1339             t-restdish
     1340             t-restingr
     1341             WITH FRAME Dialog-Frame.
     1342        END.
     1343     END CASE.
     1344   END.
     1345   ON VALUE-CHANGED OF t-one-sale-per-day IN FRAME Dialog-Frame
     1346   DO:
     1347     ASSIGN
     1348     t-one-sale-per-day.
     1349     CASE t-one-sale-per-day:
     1350       WHEN NO THEN DO:
     1351         if p-mode <> 'ПРОСМОТР':U then do:
     1352           ASSIGN
     1353           t-close-day-period = NO
     1354           .
     1355         end.
     1356         DISPLAY
     1357         t-close-day-period
     1358         WITH FRAME Dialog-Frame.
     1359         DISABLE
     1360         t-close-day-period
     1361         WITH FRAME Dialog-Frame.
     1362       END.
     1363       WHEN YES THEN DO:
     1364         if p-mode <> 'ПРОСМОТР':U then do:
     1365           Enable
     1366           t-close-day-period
     1367           WITH FRAME Dialog-Frame.
     1368         end.
     1369      END.
     1370     END CASE.
     1371   END.
     1372   ON LEAVE OF tt-trn-doc.wrkr IN FRAME Dialog-Frame
     1373   DO:
     1374     if input frame Dialog-Frame tt-trn-doc.wrkr <> tt-trn-doc.wrkr then do:
     1375       run local-psn-chk ("wrkr", "leave").
     1376     end.
     1377   END.
     1378   ON MOUSE-SELECT-DBLCLICK OF tt-trn-doc.wrkr IN FRAME Dialog-Frame
     1379   OR RETURN OF tt-trn-doc.wrkr IN FRAME Dialog-Frame DO:
     1380     run local-psn-chk ("wrkr", "ret-mouse").
     1381     apply "entry" to tt-trn-doc.agnt in frame Dialog-Frame.
     1382     return no-apply.
     1383   END.
     1384   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1385   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1386   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1387   on help of frame Dialog-Frame
     1388   do:
     1389     run gbl/app_help.p
     1390       (input this-procedure :file-name
     1391       ,input ''
     1392       ,input ?
     1393       ) no-error.
     1394     if error-status :error then do:
     1395       message
     1396         "Ошибка при вызове помощи"
     1397         error-status :get-message(1)
     1398         view-as alert-box .
     1399     end.
     1400   end.
     1401   run minbtn-set in this-procedure .
     1402   on choose of b-help in frame Dialog-Frame
     1403   do:
     1404     apply "help":u to frame Dialog-Frame .
     1405   end.
     1406   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1407   procedure minbtn-set :
     1408       do
     1409           on error undo, return error return-value
     1410           :
     1411           define variable ii              as integer       no-undo .
     1412           define variable fh              as widget-handle no-undo .
     1413           define variable hh              as widget-handle no-undo .
     1414           define variable v-h             as handle        extent 4 no-undo .
     1415           define variable v-name-button   as character     no-undo .
     1416           define variable v-help-old-x    as decimal       no-undo .
     1417           define variable v-help-old-y    as decimal       no-undo .
     1418           define variable v-help-old-size as decimal       no-undo .
     1419           define variable v-frame-width   as decimal       no-undo .
     1420           define variable jj              as integer       no-undo .
     1421           do
     1422               on error undo, return error
     1423               :
     1424               assign
     1425                   v-frame-width = frame Dialog-Frame:width - 0.3
     1426                   fh            = frame Dialog-Frame:first-child
     1427                   hh            = fh:first-child
     1428                   ii            = 1
     1429                   .
     1430               do while valid-handle(hh):
     1431                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1432                   do:
     1433                       case lc(hh:name) :
     1434                           when "b-help" then
     1435                               do:
     1436                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1437                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1438                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1439                                   hh:TOOLTIP = "Помощь" .
     1440                                   v-help-old-x = hh:column .
     1441                                   v-help-old-y = hh:row    .
     1442                                   v-help-old-size = hh:width .
     1443                                   hh:width-chars = 2.5 .
     1444                               end.
     1445                           when "b-print" then
     1446                               do:
     1447                                   hh:load-image("cmp/b-print.bmp":u) .
     1448                                   hh:TOOLTIP = "Печать" .
     1449                                   v-h[ii] = hh:handle .
     1450                                   ii = ii + 1 .
     1451                                   hh:width-chars = 3 .
     1452                               end.
     1453                           when "b-history" or
     1454                           when "b-hist" then
     1455                               do:
     1456                                   hh:load-image("cmp/b-hist.bmp":u) .
     1457                                   hh:TOOLTIP = "История" .
     1458                                   v-h[ii] = hh:handle .
     1459                                   ii = ii + 1 .
     1460                                   hh:width-chars = 3 .
     1461                               end.
     1462                           when "b-sch" then
     1463                               do:
     1464                                   hh:load-image("cmp/b-sch.bmp":u) .
     1465                                   hh:TOOLTIP = "Установка Фильтра" .
     1466                                   v-h[ii] = hh:handle .
     1467                                   ii = ii + 1 .
     1468                                   hh:width-chars = 3 .
     1469                               end.
     1470                           when "b-hist-user" then
     1471                               do:
     1472                                   hh:load-image("cmp/b-hist.bmp":u) .
     1473                                   hh:TOOLTIP = "История пользователя" .
     1474                                   ii = ii + 1 .
     1475                               end.
     1476                       end case.
     1477                   end.
     1478                   hh = hh:next-sibling.
     1479               end.
     1480               b-help:column = v-frame-width - b-help:width-chars.
     1481               jj = 0.
     1482               repeat ii = 4 to 1 by -1 :
     1483                   if valid-handle (v-h[ii] ) then
     1484                   do:
     1485                       jj  = jj + 1 .
     1486                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1487                       v-h[ii]:row    = v-help-old-y .
     1488                   end.
     1489               end.
     1490           end.
     1491       end.
     1492   end procedure.
     1493   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1494   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1495   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1496   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1497   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1498   define variable v-diasize-current-frame-height as decimal   no-undo .
     1499   define variable v-diasize-change-size          as logical   no-undo .
     1500   define variable v-diasize-resize-button        as handle    no-undo .
     1501   define variable v-diasize-wndmax               as logical   no-undo .
     1502   define variable v-diasize-wndstore             as logical   no-undo .
     1503   define variable v-diasize-proc-name            as character no-undo .
     1504   define variable v-diasize-browse-handle        as handle    no-undo .
     1505   define variable v-diasize-browse-number        as integer   no-undo .
     1506   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1507   define temp-table temp-diasize-handle no-undo
     1508     field handle-value  as handle
     1509     field save-position as decimal
     1510     index xpk is primary unique handle-value
     1511     .
     1512   define temp-table temp-browse-handle no-undo
     1513     field browse-type   as character
     1514     field browse-number as integer
     1515     field browse-handle as handle
     1516     field original-size as decimal
     1517     index xpk is primary unique browse-type browse-number
     1518     index xie browse-type browse-handle
     1519   .
     1520   procedure diasize_change-height :
     1521     define input  parameter p-change-value  as decimal   no-undo .
     1522     define input  parameter p-move-resize   as logical   no-undo .
     1523     define variable v-field-group-handle    as handle    no-undo .
     1524     define variable v-object-handle         as handle    no-undo .
     1525     define variable v-frame-height          as decimal   no-undo .
     1526     define variable v-frame-virtual-height  as decimal   no-undo .
     1527     define variable v-browse-height         as decimal   no-undo .
     1528     define variable v-window-height         as decimal   no-undo .
     1529     define variable v-window-virtual-height as decimal   no-undo .
     1530     define variable v-change-sign           as integer   no-undo .
     1531     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1532     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1533     if p-change-value > 0
     1534     then do:
     1535       if frame Dialog-Frame :height + p-change-value
     1536           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1537       then do:
     1538         assign
     1539           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1540                           - (frame Dialog-Frame :height-chars)
     1541         .
     1542         if p-change-value <= 0
     1543         then do:
     1544           run diasize_position-resize-button in this-procedure .
     1545           return .
     1546         end.
     1547       end.
     1548     end.
     1549     if p-change-value < 0
     1550     then do:
     1551       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1552       then do:
     1553         assign
     1554           p-change-value = v-diasize-orig-frame-height
     1555                          - (frame Dialog-Frame :height-chars)
     1556         .
     1557         if p-change-value >= 0
     1558         then do:
     1559           run diasize_position-resize-button in this-procedure .
     1560           return .
     1561         end.
     1562       end.
     1563     end.
     1564     if p-change-value >= 0
     1565     then do:
     1566       assign
     1567         v-change-sign = 1
     1568       .
     1569     end.
     1570     else do:
     1571       assign
     1572         v-change-sign = -1
     1573       .
     1574     end.
     1575     assign
     1576       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1577     .
     1578     if p-change-value = 0
     1579     then do:
     1580       run diasize_position-resize-button in this-procedure .
     1581       return .
     1582     end.
     1583     move_block:
     1584     do
     1585     on error undo move_block, retry move_block
     1586     :
     1587       if retry
     1588       then do:
     1589         do
     1590         on error undo move_block, leave move_block
     1591         :
     1592           if p-change-value > 0
     1593           then do:
     1594             for each buf_temp-diasize-handle
     1595             on error undo, next
     1596             :
     1597               assign
     1598                 v-object-handle = buf_temp-diasize-handle.handle-value
     1599               .
     1600               if v-object-handle <> v-diasize-resize-button
     1601               then do:
     1602                 assign
     1603                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1604                 .
     1605               end.
     1606             end.
     1607             assign
     1608               v-diasize-browse-handle :height = v-browse-height
     1609             .
     1610             for each buf_temp-browse-handle
     1611               where buf_temp-browse-handle.browse-type = 'height':u
     1612             on error undo, next
     1613             :
     1614               assign
     1615                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1616               .
     1617             end.
     1618             assign
     1619               frame Dialog-Frame :height = v-frame-height
     1620             .
     1621             if frame Dialog-Frame :scrollable = true
     1622             then do:
     1623               assign
     1624                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1625               .
     1626             end.
     1627             run diasize_position-resize-button in this-procedure .
     1628           end.
     1629           else do:
     1630             if frame Dialog-Frame :scrollable = true
     1631             then do:
     1632               assign
     1633                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1634               .
     1635             end.
     1636             assign
     1637               frame Dialog-Frame :height = v-frame-height
     1638             .
     1639             assign
     1640               v-diasize-browse-handle :height = v-browse-height
     1641             .
     1642             for each buf_temp-browse-handle
     1643               where buf_temp-browse-handle.browse-type = 'height':u
     1644             on error undo, next
     1645             :
     1646               assign
     1647                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1648               .
     1649             end.
     1650             for each buf_temp-diasize-handle
     1651             on error undo, next
     1652             :
     1653               assign
     1654                 v-object-handle = buf_temp-diasize-handle.handle-value
     1655               .
     1656               if v-object-handle <> v-diasize-resize-button
     1657               then do:
     1658                 assign
     1659                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1660                 .
     1661               end.
     1662             end.
     1663             run diasize_position-resize-button in this-procedure .
     1664           end.
     1665           assign
     1666             v-diasize-change-size = false
     1667           .
     1668           leave move_block .
     1669         end.
     1670       end.
     1671       assign
     1672         v-diasize-need-full-display = true
     1673       .
     1674       if v-diasize-change-size = false
     1675       then do:
     1676         assign
     1677           v-diasize-change-size = true
     1678         .
     1679       end.
     1680       else do:
     1681         return .
     1682       end.
     1683       assign
     1684         v-frame-height = frame Dialog-Frame :height
     1685         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1686         v-browse-height = v-diasize-browse-handle :height
     1687       .
     1688       for each buf_temp-browse-handle
     1689         where buf_temp-browse-handle.browse-type = 'height':u
     1690       :
     1691         assign
     1692           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1693         .
     1694       end.
     1695       for each buf_temp-diasize-handle
     1696       :
     1697         delete buf_temp-diasize-handle .
     1698       end.
     1699       assign
     1700         v-field-group-handle = frame Dialog-Frame :first-child
     1701       .
     1702       do while valid-handle(v-field-group-handle)
     1703       :
     1704         assign
     1705           v-object-handle = v-field-group-handle :first-child
     1706         .
     1707         do while valid-handle(v-object-handle)
     1708         :
     1709           if  v-object-handle <> v-diasize-browse-handle :handle
     1710           and can-query(v-object-handle, "row")
     1711           and can-query(v-object-handle, "height")
     1712           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1713           then do:
     1714             find first buf_temp-browse-handle
     1715               where buf_temp-browse-handle.browse-type   = 'height':u
     1716                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1717               no-error .
     1718             if available buf_temp-browse-handle
     1719             then do:
     1720             end.
     1721             else do:
     1722               create buf_temp-diasize-handle .
     1723               assign
     1724                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1725                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1726               .
     1727             end.
     1728           end.
     1729           assign
     1730             v-object-handle = v-object-handle :next-sibling
     1731           .
     1732         end.
     1733         assign
     1734           v-field-group-handle = v-field-group-handle :next-sibling
     1735         .
     1736       end.
     1737       do with frame Dialog-Frame
     1738       :
     1739         hide v-diasize-resize-button .
     1740         assign
     1741           v-diasize-resize-button :row    = 1
     1742           v-diasize-resize-button :column = 1
     1743         .
     1744       end.
     1745       if p-change-value > 0
     1746       then do:
     1747         if frame Dialog-Frame :scrollable = true
     1748         then do:
     1749           assign
     1750             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1751             no-error .
     1752           if error-status :error
     1753           or error-status :get-message(1) <> ""
     1754           then do:
     1755             undo move_block, retry move_block .
     1756           end.
     1757         end.
     1758         assign
     1759           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1760           no-error .
     1761         if error-status :error
     1762         or error-status :get-message(1) <> ""
     1763         then do:
     1764           undo move_block, retry move_block .
     1765         end.
     1766         assign
     1767           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1768           no-error .
     1769         if error-status :error
     1770         or error-status :get-message(1) <> ""
     1771         then do:
     1772           undo move_block, retry move_block .
     1773         end.
     1774         for each buf_temp-browse-handle
     1775           where buf_temp-browse-handle.browse-type = 'height':u
     1776         on error undo move_block, retry move_block
     1777         :
     1778           assign
     1779             buf_temp-browse-handle.browse-handle :height
     1780               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1781             no-error .
     1782           if error-status :error
     1783           or error-status :get-message(1) <> ""
     1784           then do:
     1785             undo move_block, retry move_block .
     1786           end.
     1787         end.
     1788         for each buf_temp-diasize-handle
     1789         on error undo move_block, retry move_block
     1790         :
     1791           assign
     1792             v-object-handle = buf_temp-diasize-handle.handle-value
     1793           .
     1794           if v-object-handle <> v-diasize-resize-button
     1795           then do:
     1796             assign
     1797               v-object-handle :row = v-object-handle :row + p-change-value
     1798               no-error .
     1799             if error-status :error
     1800             or error-status :get-message(1) <> ""
     1801             then do:
     1802               undo move_block, retry move_block .
     1803             end.
     1804           end.
     1805         end.
     1806       end.
     1807       else do:
     1808         for each buf_temp-diasize-handle
     1809         on error undo move_block, retry move_block
     1810         :
     1811           assign
     1812             v-object-handle = buf_temp-diasize-handle.handle-value
     1813           .
     1814           if v-object-handle <> v-diasize-resize-button
     1815           then do:
     1816             assign
     1817               v-object-handle :row = v-object-handle :row + p-change-value
     1818               no-error .
     1819             if error-status :error
     1820             or error-status :get-message(1) <> ""
     1821             then do:
     1822               undo move_block, retry move_block .
     1823             end.
     1824           end.
     1825         end.
     1826         assign
     1827           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1828           no-error .
     1829         if error-status :error
     1830         or error-status :get-message(1) <> ""
     1831         then do:
     1832           undo move_block, retry move_block .
     1833         end.
     1834         for each buf_temp-browse-handle
     1835           where buf_temp-browse-handle.browse-type = 'height':u
     1836         on error undo move_block, retry move_block
     1837         :
     1838           assign
     1839             buf_temp-browse-handle.browse-handle :height
     1840               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1841             no-error .
     1842           if error-status :error
     1843           or error-status :get-message(1) <> ""
     1844           then do:
     1845             undo move_block, retry move_block .
     1846           end.
     1847         end.
     1848         assign
     1849           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1850           no-error .
     1851         if error-status :error
     1852         or error-status :get-message(1) <> ""
     1853         then do:
     1854           undo move_block, retry move_block .
     1855         end.
     1856         if frame Dialog-Frame :scrollable = true
     1857         then do:
     1858           assign
     1859             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1860             no-error .
     1861           if error-status :error
     1862           or error-status :get-message(1) <> ""
     1863           then do:
     1864             undo move_block, retry move_block .
     1865           end.
     1866         end.
     1867       end.
     1868       if p-move-resize = true
     1869       then do:
     1870         run diasize_position-resize-button in this-procedure .
     1871       end.
     1872       if v-diasize-wndstore = true
     1873       then do:
     1874         if connected("ub") = true
     1875         then do:
     1876           define variable v-cntxt-db-num        as integer   no-undo .
     1877           define variable v-cntxt-userid        as character no-undo .
     1878           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1879                                             , OUTPUT v-cntxt-userid
     1880                                             ) .
     1881           run gbl/wndsizew.p
     1882             (input  v-cntxt-db-num
     1883             ,input  v-cntxt-userid
     1884             ,input  v-diasize-proc-name
     1885             ,input  'height':u
     1886             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1887             ) .
     1888         end.
     1889       end.
     1890     end.
     1891     assign
     1892       v-diasize-change-size = false
     1893     .
     1894   end procedure.
     1895   procedure diasize_set-height :
     1896     define input  parameter p-new-height  as decimal   no-undo .
     1897     define input  parameter p-move-resize as logical   no-undo .
     1898     do
     1899     on error undo, return error return-value
     1900     :
     1901       run diasize_change-height in this-procedure
     1902         (input  (p-new-height - frame Dialog-Frame :height)
     1903         ,input  p-move-resize
     1904         ) .
     1905     end.
     1906   end procedure.
     1907   procedure diasize_change-width :
     1908     define input  parameter p-change-value as decimal   no-undo .
     1909     define input  parameter p-move-resize  as logical   no-undo .
     1910     define variable v-field-group-handle   as handle    no-undo .
     1911     define variable v-object-handle        as handle    no-undo .
     1912     define variable v-frame-width          as decimal   no-undo .
     1913     define variable v-frame-virtual-width  as decimal   no-undo .
     1914     define variable v-browse-width         as decimal   no-undo .
     1915     define variable v-window-width         as decimal   no-undo .
     1916     define variable v-window-virtual-width as decimal   no-undo .
     1917     define variable v-change-sign          as integer   no-undo .
     1918     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1919     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1920     if p-change-value > 0
     1921     then do:
     1922       if frame Dialog-Frame :width + p-change-value >
     1923           session :width-chars
     1924       then do:
     1925         assign
     1926           p-change-value = session :width-chars - frame Dialog-Frame :width
     1927         .
     1928         if p-change-value <= 0
     1929         then do:
     1930           run diasize_position-resize-button in this-procedure .
     1931           return .
     1932         end.
     1933       end.
     1934     end.
     1935     if p-change-value < 0
     1936     then do:
     1937       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1938       then do:
     1939         assign
     1940           p-change-value = v-diasize-orig-frame-width
     1941                          - frame Dialog-Frame :width
     1942         .
     1943         if p-change-value >= 0
     1944         then do:
     1945           run diasize_position-resize-button in this-procedure .
     1946           return .
     1947         end.
     1948       end.
     1949     end.
     1950     if p-change-value >= 0
     1951     then do:
     1952       assign
     1953         v-change-sign = 1
     1954       .
     1955     end.
     1956     else do:
     1957       assign
     1958         v-change-sign = -1
     1959       .
     1960     end.
     1961     assign
     1962       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1963     .
     1964     if p-change-value = 0
     1965     then do:
     1966       run diasize_position-resize-button in this-procedure .
     1967       return .
     1968     end.
     1969     move_block:
     1970     do
     1971     on error undo move_block, leave move_block
     1972     :
     1973       if retry
     1974       then do:
     1975         do
     1976         on error undo move_block, leave move_block
     1977         :
     1978           if p-change-value > 0
     1979           then do:
     1980             for each buf_temp-diasize-handle
     1981             on error undo, next
     1982             :
     1983               assign
     1984                 v-object-handle = buf_temp-diasize-handle.handle-value
     1985               .
     1986               if v-object-handle <> v-diasize-resize-button
     1987               then do:
     1988                 assign
     1989                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1990                 .
     1991               end.
     1992             end.
     1993             assign
     1994               v-diasize-browse-handle :width = v-browse-width
     1995             .
     1996             for each buf_temp-browse-handle
     1997               where buf_temp-browse-handle.browse-type = 'width':u
     1998             on error undo, next
     1999             :
     2000               assign
     2001                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2002               .
     2003             end.
     2004             assign
     2005               frame Dialog-Frame :width = v-frame-width
     2006             .
     2007             if frame Dialog-Frame :scrollable = true
     2008             then do:
     2009               assign
     2010                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2011               .
     2012             end.
     2013             run diasize_position-resize-button in this-procedure .
     2014           end.
     2015           else do:
     2016             if frame Dialog-Frame :scrollable = true
     2017             then do:
     2018               assign
     2019                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2020               .
     2021             end.
     2022             assign
     2023               frame Dialog-Frame :width = v-frame-width
     2024             .
     2025             for each buf_temp-browse-handle
     2026               where buf_temp-browse-handle.browse-type = 'width':u
     2027             on error undo, next
     2028             :
     2029               assign
     2030                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2031               .
     2032             end.
     2033             assign
     2034               v-diasize-browse-handle :width = v-browse-width
     2035             .
     2036             for each buf_temp-diasize-handle
     2037             on error undo, next
     2038             :
     2039               assign
     2040                 v-object-handle = buf_temp-diasize-handle.handle-value
     2041               .
     2042               if v-object-handle <> v-diasize-resize-button
     2043               then do:
     2044                 assign
     2045                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2046                 .
     2047               end.
     2048             end.
     2049             run diasize_position-resize-button in this-procedure .
     2050           end.
     2051           assign
     2052             v-diasize-change-size = false
     2053           .
     2054           leave move_block .
     2055         end.
     2056       end.
     2057       assign
     2058         v-diasize-need-full-display = true
     2059       .
     2060       if v-diasize-change-size = false
     2061       then do:
     2062         assign
     2063           v-diasize-change-size = true
     2064         .
     2065       end.
     2066       else do:
     2067         return .
     2068       end.
     2069       assign
     2070         v-frame-width = frame Dialog-Frame :width
     2071         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2072         v-browse-width = v-diasize-browse-handle :width
     2073       .
     2074       for each buf_temp-browse-handle
     2075         where buf_temp-browse-handle.browse-type = 'width':u
     2076       :
     2077         assign
     2078           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2079         .
     2080       end.
     2081       for each buf_temp-diasize-handle
     2082       :
     2083         delete buf_temp-diasize-handle .
     2084       end.
     2085       assign
     2086         v-field-group-handle = frame Dialog-Frame :first-child
     2087       .
     2088       do while valid-handle(v-field-group-handle)
     2089       :
     2090         assign
     2091           v-object-handle = v-field-group-handle :first-child
     2092         .
     2093         do while valid-handle(v-object-handle)
     2094         :
     2095           if  v-object-handle <> v-diasize-browse-handle :handle
     2096           and v-object-handle <> v-diasize-resize-button
     2097           and can-query(v-object-handle, "row")
     2098           and can-query(v-object-handle, "height")
     2099           and ( v-object-handle :col + v-object-handle :width
     2100                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2101               )
     2102           then do:
     2103             find first buf_temp-browse-handle
     2104               where buf_temp-browse-handle.browse-type   = 'width':u
     2105                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2106               no-error .
     2107             if available buf_temp-browse-handle
     2108             then do:
     2109             end.
     2110             else do:
     2111               create buf_temp-diasize-handle .
     2112               assign
     2113                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2114                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2115               .
     2116             end.
     2117           end.
     2118           assign
     2119             v-object-handle = v-object-handle :next-sibling
     2120           .
     2121         end.
     2122         assign
     2123           v-field-group-handle = v-field-group-handle :next-sibling
     2124         .
     2125       end.
     2126       do with frame Dialog-Frame
     2127       :
     2128         hide v-diasize-resize-button .
     2129         v-diasize-resize-button :row = 1.
     2130         v-diasize-resize-button :column = 1.
     2131       end.
     2132       if p-change-value > 0
     2133       then do:
     2134         if frame Dialog-Frame :scrollable = true
     2135         then do:
     2136           assign
     2137             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2138             no-error .
     2139           if error-status :error
     2140           or error-status :get-message(1) <> ""
     2141           then do:
     2142             undo move_block, retry move_block.
     2143           end.
     2144         end.
     2145         assign
     2146           frame Dialog-Frame :width = v-frame-width + p-change-value
     2147           no-error .
     2148         if error-status :error
     2149         or error-status :get-message(1) <> ""
     2150         then do:
     2151           undo move_block, retry move_block.
     2152         end.
     2153         assign
     2154           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2155         no-error .
     2156         if error-status :error
     2157         or error-status :get-message(1) <> ""
     2158         then do:
     2159           undo move_block, retry move_block.
     2160         end.
     2161         for each buf_temp-browse-handle
     2162           where buf_temp-browse-handle.browse-type = 'width':u
     2163         on error undo move_block, retry move_block
     2164         :
     2165           assign
     2166             buf_temp-browse-handle.browse-handle :width
     2167               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2168             no-error .
     2169           if error-status :error
     2170           or error-status :get-message(1) <> ""
     2171           then do:
     2172             undo move_block, retry move_block .
     2173           end.
     2174         end.
     2175         for each buf_temp-diasize-handle
     2176         on error undo move_block, retry move_block
     2177         :
     2178           assign
     2179             v-object-handle = buf_temp-diasize-handle.handle-value
     2180           .
     2181           if v-object-handle <> v-diasize-resize-button
     2182           then do:
     2183             assign
     2184               v-object-handle :col = v-object-handle :col + p-change-value
     2185               no-error .
     2186             if error-status :error
     2187             or error-status :get-message(1) <> ""
     2188             then do:
     2189               undo move_block, retry move_block .
     2190             end.
     2191           end.
     2192         end.
     2193       end.
     2194       else do:
     2195         for each buf_temp-diasize-handle
     2196         on error undo move_block, retry move_block
     2197         :
     2198           assign
     2199             v-object-handle = buf_temp-diasize-handle.handle-value
     2200           .
     2201           if v-object-handle <> v-diasize-resize-button
     2202           then do:
     2203             assign
     2204               v-object-handle :col = v-object-handle :col + p-change-value
     2205               no-error .
     2206             if error-status :error
     2207             or error-status :get-message(1) <> ""
     2208             then do:
     2209               undo move_block, retry move_block .
     2210             end.
     2211           end.
     2212         end.
     2213         for each buf_temp-browse-handle
     2214           where buf_temp-browse-handle.browse-type = 'width':u
     2215         on error undo move_block, retry move_block
     2216         :
     2217           assign
     2218             buf_temp-browse-handle.browse-handle :width
     2219               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2220             no-error .
     2221           if error-status :error
     2222           or error-status :get-message(1) <> ""
     2223           then do:
     2224             undo move_block, retry move_block .
     2225           end.
     2226         end.
     2227         assign
     2228           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2229           no-error .
     2230         if error-status :error
     2231         or error-status :get-message(1) <> ""
     2232         then do:
     2233           undo move_block, retry move_block.
     2234         end.
     2235         assign
     2236           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2237         no-error .
     2238         if error-status :error
     2239         or error-status :get-message(1) <> ""
     2240         then do:
     2241           undo move_block, retry move_block.
     2242         end.
     2243         if frame Dialog-Frame :scrollable = true
     2244         then do:
     2245           assign
     2246             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2247           no-error .
     2248           if error-status :error
     2249           or error-status :get-message(1) <> ""
     2250           then do:
     2251             undo move_block, retry move_block.
     2252           end.
     2253         end.
     2254       end.
     2255       if p-move-resize
     2256       then do:
     2257         run diasize_position-resize-button in this-procedure .
     2258       end.
     2259       if v-diasize-wndstore = true
     2260       then do:
     2261         if connected("ub") = true
     2262         then do:
     2263           define variable v-cntxt-db-num        as integer   no-undo .
     2264           define variable v-cntxt-userid        as character no-undo .
     2265           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2266                                             , OUTPUT v-cntxt-userid
     2267                                             ) .
     2268           run gbl/wndsizew.p
     2269             (input  v-cntxt-db-num
     2270             ,input  v-cntxt-userid
     2271             ,input  v-diasize-proc-name
     2272             ,input  'width':u
     2273             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2274             ) .
     2275         end.
     2276       end.
     2277     end.
     2278     assign
     2279       v-diasize-change-size = false
     2280     .
     2281   end procedure.
     2282   procedure diasize_set-width :
     2283     define input  parameter p-new-width  as decimal   no-undo .
     2284     define input  parameter p-move-resize as logical   no-undo .
     2285     do
     2286     on error undo, return error return-value
     2287     :
     2288       run diasize_change-width in this-procedure
     2289         (input  (p-new-width - frame Dialog-Frame :width)
     2290         ,input  p-move-resize
     2291         ) .
     2292     end.
     2293   end procedure.
     2294   procedure diasize_position-resize-button :
     2295     do with frame Dialog-Frame
     2296     :
     2297       hide v-diasize-resize-button .
     2298       assign
     2299         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2300                     - 1
     2301                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2302         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2303                     - 1
     2304                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2305       .
     2306       view v-diasize-resize-button .
     2307     end.
     2308   end procedure.
     2309   on alt-right anywhere
     2310   do:
     2311     run diasize_change-width in this-procedure
     2312       (input 1
     2313       ,input true
     2314       ) .
     2315     return no-apply .
     2316   end.
     2317   on alt-left anywhere
     2318   do:
     2319     run diasize_change-width in this-procedure
     2320       (input -1
     2321       ,input true
     2322       ) .
     2323     return no-apply .
     2324   end.
     2325   on alt-down anywhere
     2326   do:
     2327     run diasize_change-height in this-procedure
     2328       (input 1
     2329       ,input true
     2330       ) .
     2331     return no-apply .
     2332   end.
     2333   on alt-up anywhere
     2334   do:
     2335     run diasize_change-height in this-procedure
     2336       (input -1
     2337       ,input true
     2338       ) .
     2339     return no-apply .
     2340   end.
     2341   on alt-enter of frame Dialog-Frame
     2342   do:
     2343     run diasize_maximize in this-procedure
     2344       (input  ?
     2345       ).
     2346     return no-apply .
     2347   end.
     2348   procedure diasize_end-move :
     2349     do
     2350     on error undo, return error return-value
     2351     :
     2352       define variable v-row-delta as decimal   no-undo .
     2353       define variable v-col-delta as decimal   no-undo .
     2354       define variable v-new-row as decimal   no-undo .
     2355       define variable v-new-col as decimal   no-undo .
     2356       assign
     2357         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2358         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2359       .
     2360       assign
     2361         v-row-delta = v-new-row - frame Dialog-Frame :height
     2362         v-col-delta = v-new-col - frame Dialog-Frame :width
     2363       .
     2364       run diasize_change-height in this-procedure
     2365         (input v-row-delta
     2366         ,input true
     2367         ) .
     2368       run diasize_change-width in this-procedure
     2369         (input v-col-delta
     2370         ,input true
     2371         ) .
     2372     end.
     2373   end procedure.
     2374   procedure diasize_maximize :
     2375     define input  parameter p-action as logical   no-undo .
     2376     do
     2377     on error undo, return error return-value
     2378     :
     2379       if p-action = ?
     2380       then do:
     2381         if v-diasize-need-maximize = true
     2382         then do:
     2383           assign
     2384             p-action = true
     2385           .
     2386         end.
     2387         else do:
     2388           assign
     2389             p-action = false
     2390           .
     2391         end.
     2392       end.
     2393       if p-action = true
     2394       then do:
     2395         run diasize_change-height in this-procedure
     2396           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2397               - frame Dialog-Frame :height-chars
     2398           ,input true
     2399           ) .
     2400         run diasize_change-width in this-procedure
     2401           (input session :width-chars
     2402               - frame Dialog-Frame :width-chars
     2403           ,input true
     2404           ) .
     2405         assign
     2406           v-diasize-need-maximize = false
     2407         .
     2408       end.
     2409       else do:
     2410         run diasize_change-width in this-procedure
     2411           (input v-diasize-orig-frame-width
     2412               - frame Dialog-Frame :width-chars
     2413           ,input true
     2414           ) .
     2415         run diasize_change-height in this-procedure
     2416           (input v-diasize-orig-frame-height
     2417               - frame Dialog-Frame :height-chars
     2418           ,input true
     2419           ) .
     2420         assign
     2421           v-diasize-need-maximize = true
     2422         .
     2423       end.
     2424     end.
     2425   end procedure.
     2426   procedure diasize_restore-orig-size :
     2427     do
     2428     on error undo, return error return-value
     2429     :
     2430       assign
     2431         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2432         v-diasize-current-frame-height = frame Dialog-Frame :height
     2433       .
     2434       run diasize_set-height in this-procedure
     2435         (input  v-diasize-orig-frame-height
     2436         ,input  true
     2437         ) .
     2438       run diasize_set-width in this-procedure
     2439         (input  v-diasize-orig-frame-width
     2440         ,input  true
     2441         ) .
     2442     end.
     2443   end procedure.
     2444   procedure diasize_restore-current-size :
     2445     do
     2446     on error undo, return error return-value
     2447     :
     2448       run diasize_set-height in this-procedure
     2449         (input  v-diasize-current-frame-height
     2450         ,input  true
     2451         ) .
     2452       run diasize_set-width in this-procedure
     2453         (input  v-diasize-current-frame-width
     2454         ,input  true
     2455         ) .
     2456     end.
     2457   end procedure.
     2458   procedure diasize_set-browse-handle :
     2459     define input  parameter p-browse-handle as handle   no-undo .
     2460     define buffer buf_temp-browse-handle for temp-browse-handle .
     2461     do
     2462     on error undo, return error return-value
     2463     :
     2464       assign
     2465         v-diasize-browse-handle = p-browse-handle
     2466       .
     2467       for each buf_temp-browse-handle
     2468       on error undo, return error return-value
     2469       :
     2470         delete buf_temp-browse-handle .
     2471       end.
     2472     end.
     2473   end procedure.
     2474   procedure diasize_add_browse :
     2475     define input  parameter p-browse-type   as character no-undo .
     2476     define input  parameter p-browse-handle as handle    no-undo .
     2477     define buffer buf_temp-browse-handle for temp-browse-handle .
     2478     do
     2479     on error undo, return error return-value
     2480     :
     2481       assign
     2482         v-diasize-browse-number = v-diasize-browse-number + 1
     2483       .
     2484       create buf_temp-browse-handle .
     2485       assign
     2486         buf_temp-browse-handle.browse-type   = p-browse-type
     2487         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2488         buf_temp-browse-handle.browse-handle = p-browse-handle
     2489       .
     2490     end.
     2491   end procedure.
     2492   procedure diasize_init :
     2493     define variable v-default-value    as logical   no-undo .
     2494     define variable v-restore-saved    as logical   no-undo .
     2495     define variable v-resize-value-str as character no-undo .
     2496     do
     2497     on error undo, return error return-value
     2498     :
     2499       do with frame Dialog-Frame
     2500       :
     2501         assign
     2502           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2503           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2504           v-diasize-browse-handle     = browse BR-sale-add :handle
     2505         .
     2506         create button v-diasize-resize-button
     2507         assign
     2508           parent        = frame Dialog-Frame :first-child
     2509           label         = "s"
     2510           height-pixels = 16
     2511           width-pixels  = 16
     2512           visible       = true
     2513           sensitive     = true
     2514           movable       = true
     2515           triggers:
     2516             on end-move persistent run diasize_end-move in this-procedure .
     2517           end triggers.
     2518         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2519         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2520         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2521         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2522         assign
     2523           v-diasize-wndmax = false
     2524         .
     2525         if connected("ub") = true
     2526         then do:
     2527           define variable v-cntxt-db-num        as integer   no-undo .
     2528           define variable v-cntxt-userid        as character no-undo .
     2529           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2530                                             , OUTPUT v-cntxt-userid
     2531                                             ) .
     2532           run gbl/wndpar_r.p
     2533             (input  v-cntxt-db-num
     2534             ,input  v-cntxt-userid
     2535             ,input  'wndmax':U
     2536             ,output v-diasize-wndmax
     2537             ,output v-default-value
     2538             ) .
     2539         end.
     2540         assign
     2541           v-diasize-wndstore = false
     2542         .
     2543         if connected("ub") = true
     2544         then do:
     2545           run gbl/wndpar_r.p
     2546             (input  v-cntxt-db-num
     2547             ,input  v-cntxt-userid
     2548             ,input  'wndstore':U
     2549             ,output v-diasize-wndstore
     2550             ,output v-default-value
     2551             ) .
     2552         end.
     2553         assign
     2554           v-diasize-proc-name = entry(1, program-name(2), '.')
     2555         .
     2556         if v-diasize-wndstore = true
     2557         then do:
     2558           assign
     2559             v-restore-saved = false
     2560           .
     2561           if connected("ub") = true
     2562           then do:
     2563             run gbl/wndsizer.p
     2564               (input  v-cntxt-db-num
     2565               ,input  v-cntxt-userid
     2566               ,input  v-diasize-proc-name
     2567               ,input  'height':u
     2568               ,output v-resize-value-str
     2569               ) .
     2570             if v-resize-value-str <> '':U
     2571             then do:
     2572               run diasize_change-height in this-procedure
     2573                 (input  integer(v-resize-value-str)
     2574                 ,input  true
     2575                 ) .
     2576               assign
     2577                 v-restore-saved = true
     2578               .
     2579             end.
     2580           end.
     2581           if connected("ub") = true
     2582           then do:
     2583             run gbl/wndsizer.p
     2584               (input  v-cntxt-db-num
     2585               ,input  v-cntxt-userid
     2586               ,input  v-diasize-proc-name
     2587               ,input  'width':u
     2588               ,output v-resize-value-str
     2589               ) .
     2590             if v-resize-value-str <> '':U
     2591             then do:
     2592               run diasize_change-width in this-procedure
     2593                 (input  integer(v-resize-value-str)
     2594                 ,input  true
     2595                 ) .
     2596               assign
     2597                 v-restore-saved = true
     2598               .
     2599             end.
     2600           end.
     2601           if v-restore-saved <> true
     2602           then do:
     2603             if v-diasize-wndmax = true
     2604             then do:
     2605               run diasize_maximize in this-procedure
     2606                 (input  true
     2607                 ) .
     2608             end.
     2609           end.
     2610         end.
     2611         else do:
     2612           if v-diasize-wndmax = true
     2613           then do:
     2614             run diasize_maximize in this-procedure
     2615               (input  true
     2616               ) .
     2617           end.
     2618         end.
     2619       end.
     2620     end.
     2621   end procedure.
     2622   procedure diasize_need-full-display :
     2623     define output parameter p-need-full-display as logical   no-undo .
     2624     do
     2625     on error undo, return error return-value
     2626     :
     2627       assign
     2628         p-need-full-display = v-diasize-need-full-display
     2629       .
     2630       assign
     2631         v-diasize-need-full-display = false
     2632       .
     2633     end.
     2634   end procedure.
     2635   procedure get-context :
     2636      define output parameter p-db-num as integer          no-undo.
     2637      define output parameter p-user-id as character        no-undo.
     2638      define variable v-login               as character    no-undo.
     2639      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2640      define buffer buf_user-login  for ub.user-login .
     2641      do
     2642      on error undo, return error
     2643      :
     2644            FIND FIRST buf_sys-ctrl no-lock.
     2645            ASSIGN
     2646               v-login = USERID("ub")
     2647               p-db-num = buf_sys-ctrl.db-num
     2648            .
     2649            FIND FIRST buf_user-login
     2650                 WHERE buf_user-login.db-num = p-db-num
     2651                   AND buf_user-login.user-login = v-login
     2652                 no-lock
     2653                 no-error
     2654                 .
     2655            IF AVAILABLE buf_user-login
     2656            THEN DO:
     2657               assign
     2658                  p-user-id = buf_user-login.user-id
     2659               .
     2660            END.
     2661      end.
     2662   end procedure.
     2663       run diasize_init in this-procedure .
     2664   MAIN-BLOCK:
     2665   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2666      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2667   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2668     run mainmenu_getcntxt in parparentproc
     2669       (output v-cntxt-db-num
     2670       ,output v-cntxt-userid
     2671       ,output v-cntxt-level
     2672       ,output v-cntxt-host-code-obj
     2673       ,output v-cntxt-obj-type
     2674       ,output v-cntxt-obj-code
     2675       ,output v-cntxt-db-num-obj
     2676       ,output v-cntxt-is-admin
     2677       ) .
     2678   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2679   ON TAB ANYWHERE
     2680   DO:
     2681   define variable ii as integer no-undo .
     2682   define variable fh as widget-handle no-undo .
     2683   define variable hh as widget-handle no-undo .
     2684   define variable v-next-widget-name as character no-undo .
     2685   if v-tab-order <> '' then do:
     2686     if self:type = "TOGGLE-BOX" then
     2687     self:BGCOLOR = ?.
     2688     assign
     2689     ii = lookup(self:name, v-tab-order).
     2690     assign
     2691     ii = ii + 1
     2692     v-next-widget-name = entry(ii, v-tab-order)
     2693     no-error .
     2694     if error-status:error then do:
     2695       assign
     2696       ii = 1
     2697       v-next-widget-name = entry( ii, v-tab-order)
     2698       .
     2699     end.
     2700     assign
     2701     fh = frame Dialog-Frame:first-child
     2702     hh = fh:first-child
     2703     .
     2704     do while valid-handle(hh):
     2705       if hh:name = v-next-widget-name then do:
     2706         if hh:sensitive  = yes
     2707         AND hh:visible = yes then do:
     2708           if hh:type = "TOGGLE-BOX":U then do:
     2709             assign
     2710             hh:BGcolor = 1
     2711             .
     2712           end.
     2713           APPLY "ENTRY" to hh.
     2714           return no-apply.
     2715         end.
     2716         else do:
     2717           APPLY "TAB" to hh.
     2718           return no-apply.
     2719         end.
     2720       end.
     2721       hh = hh:next-sibling.
     2722     end.
     2723   end.
     2724   END.
     2725   ON BACK-TAB ANYWHERE
     2726   DO:
     2727   define variable ii as integer no-undo .
     2728   define variable fh as widget-handle no-undo .
     2729   define variable hh as widget-handle no-undo .
     2730   define variable v-next-widget-name as character no-undo .
     2731   if v-tab-order <> '' then do:
     2732     assign
     2733     ii = lookup(self:name, v-tab-order).
     2734     .
     2735     assign
     2736     ii = (if ii = 1
     2737           then  num-entries(v-tab-order)
     2738           else ii - 1
     2739           )
     2740     v-next-widget-name = entry(ii, v-tab-order)
     2741     .
     2742     assign
     2743     fh = frame Dialog-Frame:first-child
     2744     hh = fh:first-child
     2745     .
     2746     do while valid-handle(hh):
     2747       if hh:name = v-next-widget-name then do:
     2748         if hh:sensitive  = yes
     2749         AND hh:visible = yes then do:
     2750           if hh:type = "TOGGLE-BOX":U then do:
     2751             assign
     2752             hh:BGcolor = 1
     2753             .
     2754           end.
     2755           APPLY "ENTRY" to hh.
     2756           return no-apply.
     2757         end.
     2758         else do:
     2759         APPLY "BACK-TAB" to hh.
     2760         return no-apply.
     2761         end.
     2762       end.
     2763       hh = hh:next-sibling.
     2764     end.
     2765     end.
     2766   END.
     2767   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2768   ON RETURN ANYWHERE
     2769   DO:
     2770   define variable ii as integer no-undo .
     2771   define variable fh as widget-handle no-undo .
     2772   define variable hh as widget-handle no-undo .
     2773   define variable v-next-widget-name as character no-undo .
     2774     if v-tab-order <> '' then do:
     2775       assign
     2776       ii = lookup(self:name, v-tab-order).
     2777       if ii = num-entries(v-tab-order) then do:
     2778           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     2779           return no-apply.
     2780       end.
     2781       if self:type <> "BUTTON" and
     2782         self:type <> "EDITOR"  then do:
     2783         run proc-move-forward in this-procedure .
     2784         return no-apply.
     2785       end.
     2786       if self:type = "BUTTON" then do:
     2787         APPLY "CHOOSE" to self.
     2788       end.
     2789       if self:type = "TOGGLE-BOX" then
     2790       self:BGCOLOR = ?.
     2791       assign
     2792       ii = ii + 1
     2793       v-next-widget-name = entry(ii, v-tab-order)
     2794       no-error .
     2795       if error-status:error then do:
     2796         assign
     2797         ii = 1
     2798         v-next-widget-name = entry( ii, v-tab-order)
     2799         .
     2800       end.
     2801       assign
     2802       fh = frame Dialog-Frame:first-child
     2803       hh = fh:first-child
     2804       .
     2805       do while valid-handle(hh):
     2806         if hh:name = v-next-widget-name then do:
     2807           if hh:sensitive  = yes
     2808           AND hh:visible = yes then do:
     2809             if hh:type = "TOGGLE-BOX":U then do:
     2810               assign
     2811               hh:BGcolor = 1
     2812               .
     2813             end.
     2814             APPLY "ENTRY" to hh.
     2815             return no-apply.
     2816           end.
     2817           else do:
     2818             APPLY "TAB" to hh.
     2819             return no-apply.
     2820           end.
     2821         end.
     2822         hh = hh:next-sibling.
     2823       end.
     2824     end.
     2825   END.
     2826   procedure proc-move-forward :
     2827   define variable ii as integer no-undo .
     2828   define variable fh as widget-handle no-undo .
     2829   define variable hh as widget-handle no-undo .
     2830   define variable v-next-widget-name as character no-undo .
     2831   do
     2832   on error undo, return error
     2833   :
     2834     if v-tab-order <> '' then do:
     2835       if self:type = "TOGGLE-BOX" then
     2836       self:BGCOLOR = ?.
     2837       assign
     2838       ii = lookup(self:name, v-tab-order).
     2839       assign
     2840       ii = ii + 1
     2841       v-next-widget-name = entry(ii, v-tab-order)
     2842       no-error .
     2843       if error-status:error then do:
     2844         assign
     2845         ii = 1
     2846         v-next-widget-name = entry( ii, v-tab-order)
     2847         .
     2848       end.
     2849       assign
     2850       fh = frame Dialog-Frame:first-child
     2851       hh = fh:first-child
     2852       .
     2853       do while valid-handle(hh):
     2854         if hh:name = v-next-widget-name then do:
     2855           if hh:sensitive  = yes
     2856           AND hh:visible = yes then do:
     2857             if hh:type = "TOGGLE-BOX":U then do:
     2858               assign
     2859               hh:BGcolor = 1
     2860               .
     2861             end.
     2862             APPLY "ENTRY" to hh.
     2863             return.
     2864           end.
     2865           else do:
     2866             assign
     2867             ii = ii + 1
     2868             v-next-widget-name = entry(ii, v-tab-order)
     2869             no-error .
     2870             if error-status:error then do:
     2871               assign
     2872               ii = 1
     2873               v-next-widget-name = entry( ii, v-tab-order)
     2874               .
     2875             end.
     2876           end.
     2877         end.
     2878         hh = hh:next-sibling.
     2879       end.
     2880     end.
     2881   end.
     2882   end procedure.
     2883     IF p-mode <> 'ПРОСМОТР':U
     2884     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     2885         MESSAGE
     2886         vss-workfile vss-revision vss-description skip
     2887         "Неверное значение параметра p-mode" p-mode
     2888         VIEW-AS ALERT-BOX ERROR.
     2889         UNDO, RETURN ERROR.
     2890     END.
     2891     IF p-obj-type <> 'маг':U
     2892     and p-obj-type <> 'орг':U
     2893     and p-obj-type <> '':U
     2894     THEN DO:
     2895         MESSAGE
     2896         vss-workfile vss-revision vss-description skip
     2897         "Неверное значение параметра p-obj-type" p-obj-type
     2898         VIEW-AS ALERT-BOX ERROR.
     2899         UNDO, RETURN ERROR.
     2900     END.
     2901     if p-obj-type = 'маг':U then do:
     2902       FIND FIRST X_shop NO-LOCK WHERE X_shop.obj-code = p-obj-code NO-ERROR.
     2903       IF NOT AVAILABLE X_shop THEN DO:
     2904           MESSAGE
     2905           vss-workfile vss-revision vss-description skip
     2906           "Неверное значение параметра p-obj-code" p-obj-code
     2907           VIEW-AS ALERT-BOX ERROR.
     2908           UNDO, RETURN ERROR.
     2909       END.
     2910   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2911   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2912     (input  'маг':U
     2913     ,input  p-obj-code
     2914     ,output v-db-num
     2915     )  .
     2916       IF v-db-num <> v-cntxt-db-num
     2917       AND v-cntxt-db-num <> 0
     2918       and p-mode <> 'ПРОСМОТР':U
     2919       THEN DO:
     2920           MESSAGE
     2921           "Нельзя менять параметры магазина в чужой БД" skip
     2922           "магазин принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     2923           VIEW-AS ALERT-BOX ERROR.
     2924           UNDO, RETURN ERROR.
     2925       END.
     2926     end.
     2927     if p-obj-type = 'орг':U then do:
     2928       FIND FIRST X_sysconf NO-LOCK WHERE X_sysconf.host-code = p-obj-code NO-ERROR.
     2929       IF NOT AVAILABLE X_sysconf THEN DO:
     2930           MESSAGE
     2931           vss-workfile vss-revision vss-description skip
     2932           "Неверное значение параметра p-obj-code" p-obj-code
     2933           VIEW-AS ALERT-BOX ERROR.
     2934           UNDO, RETURN ERROR.
     2935       END.
     2936       if v-cntxt-db-num <> 0
     2937       and p-mode <> 'ПРОСМОТР':U
     2938       then do:
     2939           MESSAGE
     2940           "Нельзя менять параметры ФИРМЫ в УБД" skip
     2941           VIEW-AS ALERT-BOX ERROR.
     2942           UNDO, RETURN ERROR.
     2943       end.
     2944     end.
     2945     if p-obj-type = '':U then do:
     2946       if v-cntxt-db-num <> 0
     2947       and p-mode <> 'ПРОСМОТР':U
     2948       then do:
     2949           MESSAGE
     2950           "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" skip
     2951           VIEW-AS ALERT-BOX ERROR.
     2952           UNDO, RETURN ERROR.
     2953       end.
     2954     end.
     2955     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     2956       FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
     2957                 LOCKED_thbj-attr.obj-type = p-obj-type
     2958           AND   LOCKED_thbj-attr.obj-code = p-obj-code
     2959           AND   LOCKED_thbj-attr.upper-prop-code = 'autosale':U
     2960           AND LOCKED_thbj-attr.prop-code = "":U
     2961           NO-WAIT NO-ERROR.
     2962        if locked locked_thbj-attr then do:
     2963           message
     2964           vss-workfile vss-revision vss-description skip
     2965            "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
     2966           view-as alert-box error .
     2967           undo, return error.
     2968         end.
     2969     END.
     2970     ELSE DO:
     2971         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
     2972             LOCKED_thbj-attr.obj-type = p-obj-type
     2973       AND   LOCKED_thbj-attr.obj-code = p-obj-code
     2974       AND   LOCKED_thbj-attr.upper-prop-code = 'autosale':U
     2975       AND   LOCKED_thbj-attr.prop-code = '':U NO-ERROR.
     2976     END.
     2977     if not available locked_thbj-attr then do:
     2978       ASSIGN
     2979       v-to-create  = YES.
     2980       message
     2981       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     2982                   chr(10))
     2983       view-as alert-box WARNING.
     2984     end.
     2985     RUN FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     2986     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     2987     RUN Myenable in this-procedure .
     2988     WAIT-FOR GO OF FRAME Dialog-Frame.
     2989   END.
     2990   RUN disable_UI.
     2991   PROCEDURE disable_UI :
     2992     HIDE FRAME Dialog-Frame.
     2993   END PROCEDURE.
     2994   PROCEDURE enable_UI :
     2995     OPEN QUERY Dialog-Frame FOR EACH tt-trn-doc SHARE-LOCK.
     2996     GET FIRST Dialog-Frame.
     2997     DISPLAY t-automail t-one-sale-per-day t-augetres t-close-day-period t-autocalc
     2998             t-pay-gds-algo t-autoclos t-autocomp t-one-curs t-sale-filter
     2999             t-prcl-spl t-autofbr t-restdish t-restingr rs-tpsi-mode t-main-tpsi
     3000             t-resttpsi t-neg-tpsi-weight f-neg-tpsi-qnty t-neg-tpsi-oper
     3001             t-close-in-rfsl wrkr-name agnt-name boss-name
     3002         WITH FRAME Dialog-Frame.
     3003     IF AVAILABLE tt-trn-doc THEN
     3004       DISPLAY tt-trn-doc.wrkr tt-trn-doc.agnt tt-trn-doc.boss
     3005         WITH FRAME Dialog-Frame.
     3006     ENABLE B-exit b-quit B-Help t-automail t-one-sale-per-day t-augetres
     3007            t-close-day-period t-autocalc t-pay-gds-algo t-autoclos t-autocomp
     3008            t-one-curs t-sale-filter t-prcl-spl t-autofbr t-restdish t-restingr
     3009            rs-tpsi-mode t-main-tpsi t-resttpsi t-neg-tpsi-weight f-neg-tpsi-qnty
     3010            t-neg-tpsi-oper t-close-in-rfsl BR-sale-add B-sc-update B-sc-clear
     3011            tt-trn-doc.wrkr r-wrkr tt-trn-doc.agnt r-agnt tt-trn-doc.boss r-boss
     3012            wrkr-name agnt-name boss-name
     3013         WITH FRAME Dialog-Frame.
     3014     VIEW FRAME Dialog-Frame.
     3015     OPEN QUERY BR-sale-add FOR EACH tt-sale-add NO-LOCK INDEXED-REPOSITION.
     3016   END PROCEDURE.
     3017   PROCEDURE fill-widgets :
     3018   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     3019   DEFINE VARIABLE v-entry AS CHARACTER NO-UNDO.
     3020   define variable v-param-type as character no-undo .
     3021   define variable v-value-character as character no-undo .
     3022   define variable v-value-date as date no-undo .
     3023   define variable v-value-decimal as decimal no-undo .
     3024   define variable v-value-integer as INTEGER no-undo .
     3025   define variable v-value-logical AS LOGICAL no-undo .
     3026   define variable v-sale-add as character no-undo .
     3027   DEFINE VARIABLE v-doc-kind AS CHARACTER NO-UNDO.
     3028   DEFINE VARIABLE v-doc-kind-label AS CHARACTER NO-UNDO.
     3029   DEFINE VARIABLE v-cli-type LIKE ub.clients.obj-type NO-UNDO.
     3030   DEFINE VARIABLE v-cli-code LIKE ub.clients.obj-code NO-UNDO.
     3031   DEFINE VARIABLE v-obj-name LIKE ub.clients.obj-name NO-UNDO.
     3032   DEFINE BUFFER buf_clients FOR ub.clients.
     3033   FOR EACH tt-trn-doc:
     3034     DELETE tt-trn-doc.
     3035   END.
     3036   FOR EACH thbjattr_thbj-attr:
     3037     delete thbjattr_thbj-attr.
     3038   end.
     3039   FOR EACH temp-thbj-attr:
     3040     delete temp-thbj-attr.
     3041   end.
     3042   CREATE tt-trn-doc.
     3043   run adm/shattri.p (
     3044                 input "init":U
     3045               , input p-obj-type
     3046               , input p-obj-code
     3047               , input 'autosale':U
     3048               , input "":U
     3049               , output v-value-character
     3050               , output v-value-date
     3051               , output v-value-decimal
     3052               , output v-value-integer
     3053               , output v-value-logical
     3054               , output v-param-type
     3055               , INPUT-OUTPUT table-handle v-tth
     3056               ) no-error .
     3057   if error-status:error
     3058   and not available locked_thbj-attr then do:
     3059     message
     3060     "Не удалось получить начальные значения настроек" skip
     3061     error-status:get-message(1) return-value
     3062     view-as alert-box error .
     3063     undo, return error .
     3064   end.
     3065   FOR EACH thbjattr_thbj-attr:
     3066     ASSIGN
     3067     v-entry = thbjattr_thbj-attr.prop-code.
     3068     IF v-entry = 'autoclos':U THEN DO:
     3069       ASSIGN
     3070       t-autoclos = thbjattr_thbj-attr.property-value-logical
     3071       t-autoclos:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3072       .
     3073     END.
     3074     IF v-entry = 'automail':U THEN DO:
     3075       ASSIGN
     3076       t-automail = thbjattr_thbj-attr.property-value-logical
     3077       t-automail:private-data = "recid=" + string(recid(thbjattr_thbj-attr))
     3078       .
     3079     END.
     3080     IF v-entry = 'augetres':U THEN DO:
     3081       ASSIGN
     3082       t-augetres = thbjattr_thbj-attr.property-value-logical
     3083       t-augetres:private-data = "recid=" + string(recid(thbjattr_thbj-attr))
     3084       .
     3085     END.
     3086     IF v-entry = 'autocalc':U THEN DO:
     3087       ASSIGN
     3088       t-autocalc = thbjattr_thbj-attr.property-value-logical
     3089       t-autocalc:private-data = "recid=" + string(recid(thbjattr_thbj-attr))
     3090       .
     3091     END.
     3092     IF v-entry = 'autocomp':U THEN DO:
