      614   procedure thbjattr_code :
      615      define input  parameter p-upper-code     as character no-undo .
      616      define input  parameter p-code           as character no-undo .
      617      define output parameter p-label          as character no-undo .
      618      define output parameter p-user-can-edit  as logical   no-undo .
      619      define output parameter p-output-display as logical   no-undo .
      620      define output parameter p-other          as character no-undo .
      621      define output parameter p-prop-list      as character no-undo .
      622      define output parameter p-prop-type-list as character no-undo .
      623      define output parameter p-prop-label-list as character no-undo .
      624      define output parameter p-global          as logical no-undo .
      625      define output parameter p-host           as logical no-undo .
      626      define output parameter p-shop           as logical no-undo .
      627      define output parameter p-store          as logical no-undo .
      628      define output parameter p-db             as logical no-undo .
      629      define variable p-region as logical no-undo.
      630      run thbjattr_code_reg in this-procedure (
      631                                               p-upper-code,
      632                                               p-code,
      633                                               output p-label,
      634                                               output p-user-can-edit,
      635                                               output p-output-display,
