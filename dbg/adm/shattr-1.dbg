     3291       if input frame Dialog-Frame tt-trn-doc.wrkr <> ""
     3292          and input frame Dialog-Frame tt-trn-doc.wrkr <> ? then
     3293         message "Из справочника клиентов Вы должны выбрать человека.".
     3294       run ref/cli-all.w (  input parparentproc
     3295                     ,  input "b-sel"
     3296                     ,  input 'чел':U
     3297                     ,  input ?
     3298                     ,  input ?
     3299                     ,  input v-ref-rec
     3300                     ,  input ",,,,,,NO"
     3301                     ,  input "lock-cli-type"
     3302                     , output ref-list ) .
     3303       assign v-ref-rec13 = integer( ref-list ).
     3304       v-ref-rec = integer( ref-list ) .
     3305       find cli-buf where recid (cli-buf) =
     3306          v-ref-rec
     3307          no-lock no-error.
     3308       if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then
     3309         find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-trn-doc.wrkr
     3310                              and cli-buf.obj-type = 'чел':U no-lock no-error.
     3311     end.
     3312     if available cli-buf and can-do( 'чел':U, cli-buf.obj-type ) then do:
     3313       display cli-buf.obj-code @ tt-trn-doc.wrkr
     3314               cli-buf.obj-name @ wrkr-name with frame Dialog-Frame.
     3315       assign frame Dialog-Frame tt-trn-doc.wrkr.
     3316     end.
     3317     else display ? @ tt-trn-doc.wrkr
     3318                  ? @ wrkr-name with frame Dialog-Frame.
     3319     apply "entry" to tt-trn-doc.agnt in frame Dialog-Frame.
     3320   if available cli-buf then do:
     3321         display cli-buf.obj-code @ tt-trn-doc.wrkr cli-buf.obj-name @ wrkr-name with frame Dialog-Frame.
     3322     end.
     3323     else display ? @ tt-trn-doc.wrkr ? @ wrkr-name with frame Dialog-Frame.
