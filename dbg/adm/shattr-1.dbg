     3217   if tt-trn-doc.wrkr = 0 then tt-trn-doc.wrkr = ?.
     3218   if tt-trn-doc.agnt = 0 then tt-trn-doc.agnt = ?.
     3219   if tt-trn-doc.boss = 0 then tt-trn-doc.boss = ?.
     3220   _ii:
     3221   DO ii = 1 TO NUM-ENTRIES(v-sale-add, ';'):
     3222       ASSIGN
     3223       v-entry =  ENTRY(ii, v-sale-add, ';':U)
     3224       v-doc-kind = ENTRY(1, v-entry)
     3225       v-cli-type = ENTRY(2, v-entry)
     3226       v-cli-code = integer(ENTRY(3, v-entry))
     3227       v-doc-kind-label = '':U
     3228       .
     3229       if v-doc-kind = 'rgs':U then next _ii .
     3230       assign
     3231       v-doc-kind-label = entry (lookup (v-doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
     3232       no-error
     3233       .
     3234       if v-doc-kind-label = '':U then do:
     3235           NEXT _ii.
     3236       END.
     3237       FIND FIRST tt-sale-add WHERE
     3238                   tt-sale-add.doc-kind = v-doc-kind NO-ERROR.
     3239       IF NOT AVAILABLE tt-sale-add THEN DO:
     3240           FIND FIRST buf_clients NO-LOCK WHERE
     3241                     buf_clients.obj-type = v-cli-type
     3242                 AND buf_clients.obj-code =v-cli-code NO-ERROR.
     3243           IF NOT AVAILABLE buf_clients THEN DO:
     3244               ASSIGN
     3245               v-cli-type = '':U
     3246               v-cli-code = 0
     3247               v-obj-name = '':U
     3248               .
     3249           END.
     3250           ELSE DO:
     3251               ASSIGN
     3252               v-obj-name = buf_clients.obj-name
     3253               .
     3254           END.
     3255           CREATE tt-sale-add.
     3256           ASSIGN
     3257           tt-sale-add.doc-kind = v-doc-kind
     3258           tt-sale-add.doc-kind-label = v-doc-kind-label
     3259           tt-sale-add.obj-type = v-cli-type
     3260           tt-sale-add.obj-code = v-cli-code
     3261           tt-sale-add.obj-name = v-obj-name
     3262           .
     3263           release tt-sale-add.
     3264       END.
     3265   END.
     3266   do ii = 1 to num-entries('rwo,trf,swo,ngs,rgs,vir':U):
     3267     if entry(ii, 'rwo,trf,swo,ngs,rgs,vir':U) = 'rgs':U then next .
     3268     find first tt-sale-add where
     3269               tt-sale-add.doc-kind = entry(ii, 'rwo,trf,swo,ngs,rgs,vir':U) no-error .
     3270     if not available tt-sale-add then do:
     3271       CREATE tt-sale-add.
     3272       ASSIGN
     3273       tt-sale-add.doc-kind = entry(ii, 'rwo,trf,swo,ngs,rgs,vir':U)
     3274       tt-sale-add.doc-kind-label = entry (lookup (entry(ii, 'rwo,trf,swo,ngs,rgs,vir':U), 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
     3275       tt-sale-add.obj-type = '':U
     3276       tt-sale-add.obj-code = 0
     3277       tt-sale-add.obj-name = '':U
     3278       .
     3279       release tt-sale-add.
     3280     end.
     3281   end.
     3282   END PROCEDURE.
     3283   PROCEDURE local-psn-chk :
     3284   define input parameter p-man    as character no-undo.
     3285   define input parameter p-action as character no-undo.
     3286   if p-man = 'wrkr':U and p-action = "ret-mouse" then do:
     3287     define variable v-ref-rec13   as recid no-undo .
     3288     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-trn-doc.wrkr
     3289                    and cli-buf.obj-type = 'чел':U no-lock no-error.
