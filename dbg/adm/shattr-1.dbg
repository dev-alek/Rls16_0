      648   procedure thbjattr_code_reg :
      649   define input  parameter p-upper-code     as character no-undo .
      650   define input  parameter p-code           as character no-undo .
      651   define output parameter p-label          as character no-undo .
      652   define output parameter p-user-can-edit  as logical   no-undo .
      653   define output parameter p-output-display as logical   no-undo .
      654   define output parameter p-other          as character no-undo .
      655   define output parameter p-prop-list      as character no-undo .
      656   define output parameter p-prop-type-list as character no-undo .
      657   define output parameter p-prop-label-list as character no-undo .
      658   define output parameter p-global          as logical no-undo .
      659   define output parameter p-host           as logical no-undo .
      660   define output parameter p-shop           as logical no-undo .
      661   define output parameter p-store          as logical no-undo .
      662   define output parameter p-db             as logical no-undo .
      663   define output parameter p-region         as logical no-undo .
      664   do
      665   on error undo, return error return-value
      666   :
      667       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      668       (input  p-upper-code
      669       ,input  p-code
      670       ,output p-label
      671       ,output p-user-can-edit
      672       ,output p-output-display
      673       ,output p-other
      674       ,output p-prop-list
      675       ,output p-prop-type-list
      676       ,output p-prop-label-list
      677       ,output p-global
      678       ,output p-host
      679       ,output p-shop
      680       ,output p-store
      681       ,output p-db
      682       ,output p-region
      683       ) no-error .
      684     if error-status :error
      685     then do:
      686       undo, return error substitute( "&1. &2&3&4", vss-include-info2, return-value, chr(10), error-status :get-message (1)).
      687     end.
      688   end.
      689   end procedure.
