     3494     if available cli-buf and can-do( 'чел':U, cli-buf.obj-type ) then do:
     3495       display cli-buf.obj-code @ tt-trn-doc.boss
     3496               cli-buf.obj-name @ boss-name with frame Dialog-Frame.
     3497       assign frame Dialog-Frame tt-trn-doc.boss.
     3498     end.
     3499     else display ? @ tt-trn-doc.boss
     3500                  ? @ boss-name with frame Dialog-Frame.
     3501     apply "entry" to  b-exit in frame Dialog-Frame.
     3502   if available cli-buf then do:
     3503         display cli-buf.obj-code @ tt-trn-doc.boss cli-buf.obj-name @ boss-name with frame Dialog-Frame.
     3504     end.
     3505     else display ? @ tt-trn-doc.boss ? @ boss-name with frame Dialog-Frame.
     3506         return no-apply.
     3507   end.
     3508   if p-man = 'boss':U and p-action = "button" then do:
     3509     define variable v-ref-rec20   as recid no-undo .
     3510     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-trn-doc.boss
     3511                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     3512     assign v-ref-rec20 = ( if available cli-buf then recid( cli-buf ) else ? ).
     3513     v-ref-rec = ( if available cli-buf then recid( cli-buf ) else ? ).
     3514     release cli-buf.
     3515     if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:
     3516       run ref/cli-all.w (  input parparentproc
     3517                     ,  input "b-sel"
     3518                     ,  input 'чел':U
     3519                     ,  input ?
     3520                     ,  input ?
     3521                     ,  input v-ref-rec
     3522                     ,  input ",,,,,,NO"
     3523                     ,  input "lock-cli-type"
     3524                     , output ref-list ) .
     3525       assign v-ref-rec20 = integer( ref-list ).
     3526       v-ref-rec = integer( ref-list ) .
     3527       find cli-buf where recid (cli-buf) =
     3528          v-ref-rec
     3529          no-lock no-error.
     3530       if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then
     3531         find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-trn-doc.boss
     3532                              and cli-buf.obj-type = 'чел':U no-lock no-error.
     3533     end.
     3534     if available cli-buf and can-do( 'чел':U, cli-buf.obj-type ) then do:
     3535       display cli-buf.obj-code @ tt-trn-doc.boss
     3536               cli-buf.obj-name @ boss-name with frame Dialog-Frame.
     3537       assign frame Dialog-Frame tt-trn-doc.boss.
     3538     end.
     3539     else display ? @ tt-trn-doc.boss
     3540                  ? @ boss-name with frame Dialog-Frame.
     3541     apply "entry" to  b-exit in frame Dialog-Frame.
     3542   if available cli-buf then do:
     3543         display cli-buf.obj-code @ tt-trn-doc.boss cli-buf.obj-name @ boss-name with frame Dialog-Frame.
     3544     end.
     3545     else display ? @ tt-trn-doc.boss ? @ boss-name with frame Dialog-Frame.
     3546         return no-apply.
     3547   end.
     3548   if p-man = 'boss':U and p-action = "leave" then do:
     3549     define variable v-ref-rec21   as recid no-undo .
     3550     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-trn-doc.boss
     3551                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     3552   if available cli-buf then do:
     3553         display cli-buf.obj-code @ tt-trn-doc.boss cli-buf.obj-name @ boss-name with frame Dialog-Frame.
     3554             assign frame Dialog-Frame tt-trn-doc.boss.
     3555     end.
     3556     else display ? @ tt-trn-doc.boss ? @ boss-name with frame Dialog-Frame.
     3557   end.
     3558   END PROCEDURE.
     3559   PROCEDURE MyEnable :
     3560   ASSIGN
     3561   FRAME Dialog-Frame:TITLE = FRAME Dialog-Frame:TITLE + (if p-obj-type = 'орг':U then " фирма" else " маг") + STRING(p-obj-code)
     3562   v-tab-order = "t-automail,t-one-day-per-sale,t-autocalc,t-close-day-period,t-augetres,t-pay-gds-algo,t-autoclos,t-autocomp,t-one-curs,t-autofbr,t-restdish,t-restingr,t-resttpsi," +
     3563                 "t-neg-tpsi-weight,f-neg-tpsi-qnty,t-neg-tpsi-oper,t-close-in-rfsl,br-sale-add,wrkr,r-wrkr,agnt,r-agnt,boss,r-boss".
     3564   find first tt-trn-doc.
     3565     define variable v-ref-rec22   as recid no-undo .
     3566     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-trn-doc.wrkr
     3567                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     3568   if not available cli-buf then do:
     3569     display tt-trn-doc.wrkr with frame Dialog-Frame.
     3570     find cli-buf no-lock where cli-buf.obj-code = input frame Dialog-Frame tt-trn-doc.wrkr
     3571                            and cli-buf.obj-type = 'чел':U no-error.
     3572   end.
     3573   if available cli-buf then do:
     3574         display cli-buf.obj-code @ tt-trn-doc.wrkr cli-buf.obj-name @ wrkr-name with frame Dialog-Frame.
     3575     end.
     3576     else display ? @ tt-trn-doc.wrkr ? @ wrkr-name with frame Dialog-Frame.
     3577     define variable v-ref-rec23   as recid no-undo .
     3578     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-trn-doc.agnt
     3579                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     3580   if not available cli-buf then do:
     3581     display tt-trn-doc.agnt with frame Dialog-Frame.
     3582     find cli-buf no-lock where cli-buf.obj-code = input frame Dialog-Frame tt-trn-doc.agnt
     3583                            and cli-buf.obj-type = 'чел':U no-error.
     3584   end.
     3585   if available cli-buf then do:
     3586         display cli-buf.obj-code @ tt-trn-doc.agnt cli-buf.obj-name @ agnt-name with frame Dialog-Frame.
     3587     end.
     3588     else display ? @ tt-trn-doc.agnt ? @ agnt-name with frame Dialog-Frame.
     3589     define variable v-ref-rec24   as recid no-undo .
     3590     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-trn-doc.boss
     3591                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     3592   if not available cli-buf then do:
     3593     display tt-trn-doc.boss with frame Dialog-Frame.
     3594     find cli-buf no-lock where cli-buf.obj-code = input frame Dialog-Frame tt-trn-doc.boss
     3595                            and cli-buf.obj-type = 'чел':U no-error.
     3596   end.
     3597   if available cli-buf then do:
     3598         display cli-buf.obj-code @ tt-trn-doc.boss cli-buf.obj-name @ boss-name with frame Dialog-Frame.
     3599     end.
     3600     else display ? @ tt-trn-doc.boss ? @ boss-name with frame Dialog-Frame.
     3601   DISPLAY
     3602   t-automail
     3603   t-autocalc
     3604   t-augetres
     3605   t-autoclos
     3606   t-autocomp
     3607   t-autofbr
     3608   t-restdish
     3609   t-restingr
     3610   t-one-curs
     3611   t-prcl-spl
     3612   t-resttpsi
     3613   t-neg-tpsi-weight
     3614   f-neg-tpsi-qnty
     3615   t-neg-tpsi-oper
     3616   t-sale-filter
     3617   t-one-sale-per-day
     3618   t-close-day-period
     3619   t-pay-gds-algo
     3620   rs-tpsi-mode
     3621   t-main-tpsi
     3622   tt-trn-doc.wrkr
     3623   tt-trn-doc.agnt
     3624   tt-trn-doc.boss
     3625   t-close-in-rfsl
     3626   WITH FRAME Dialog-Frame.
     3627   ENABLE
     3628   B-exit WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3629   b-quit
     3630   B-Help
     3631   t-automail WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3632   t-one-sale-per-day WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3633   t-pay-gds-algo WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3634   t-autocalc WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3635   t-augetres WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3636   t-autoclos WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3637   t-autocomp WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3638   t-one-curs WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3639   t-prcl-spl WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3640   t-autofbr  WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3641   t-restdish WHEN p-mode = 'ИЗМЕНЕНИЕ':U AND t-autofbr
     3642   t-restingr WHEN p-mode = 'ИЗМЕНЕНИЕ':U AND t-autofbr
     3643   t-resttpsi WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3644   t-neg-tpsi-weight WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3645   f-neg-tpsi-qnty   WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3646   t-neg-tpsi-oper   WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3647   t-sale-filter WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3648   t-close-in-rfsl WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3649   br-sale-add
     3650   b-sc-update WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3651   b-sc-clear WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3652   rs-tpsi-mode WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3653   t-main-tpsi WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3654   tt-trn-doc.wrkr WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3655   tt-trn-doc.agnt WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3656   tt-trn-doc.boss WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3657   r-wrkr WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3658   r-agnt WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3659   r-boss WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3660   WITH FRAME Dialog-Frame.
     3661   VIEW FRAME Dialog-Frame.
     3662   IF p-mode = 'ПРОСМОТР':U THEN DO:
     3663       HIDE
     3664       b-exit
     3665       IN FRAME Dialog-Frame.
     3666       ASSIGN
     3667       b-quit:LABEL = "&Выход"
     3668       .
     3669   END.
     3670   APPLY "value-changed" TO t-autofbr.
     3671   APPLY "value-changed" TO rs-tpsi-mode.
     3672   APPLY "value-changed" TO t-one-sale-per-day.
     3673   OPEN QUERY BR-sale-add FOR EACH tt-sale-add NO-LOCK INDEXED-REPOSITION.
     3674   END PROCEDURE.
     3675   PROCEDURE proc-save :
     3676   define variable v-value-character as character no-undo .
     3677   define variable v-value-date as date no-undo .
     3678   define variable v-value-decimal as decimal no-undo .
     3679   define variable v-value-integer as INTEGER no-undo .
     3680   define variable v-value-logical AS LOGICAL no-undo .
     3681   define variable v-sale-add as character no-undo .
     3682   define variable v-trf-type like ub.clients.obj-type no-undo .
     3683   define variable v-trf-code like ub.clients.obj-code no-undo .
     3684   define variable v-param-type as character no-undo .
     3685   define variable wh as widget-handle no-undo .
     3686   define variable fh as widget-handle no-undo .
     3687   define variable v-same as logical no-undo .
     3688   DEFINE BUFFER buf_tt-sale-add FOR tt-sale-add.
     3689   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     3690   ASSIGN
     3691   FRAME Dialog-Frame
     3692   t-augetres
     3693   t-autocalc
     3694   t-autoclos
     3695   t-autocomp
     3696   t-one-curs
     3697   t-autofbr
     3698   t-automail
     3699   t-prcl-spl
     3700   t-sale-filter
     3701   rs-tpsi-mode
     3702   t-main-tpsi
     3703   t-one-sale-per-day
     3704   t-pay-gds-algo
     3705   t-close-in-rfsl
     3706   tt-trn-doc.wrkr
     3707   tt-trn-doc.agnt
     3708   tt-trn-doc.boss
     3709   tt-trn-doc.wrkr = if tt-trn-doc.wrkr = ? then 0 else tt-trn-doc.wrkr
     3710   tt-trn-doc.agnt = if tt-trn-doc.agnt = ? then 0 else tt-trn-doc.agnt
     3711   tt-trn-doc.boss = if tt-trn-doc.boss = ? then 0 else tt-trn-doc.boss
     3712   .
     3713   if t-one-sale-per-day then do:
     3714     assign t-close-day-period .
     3715   end.
     3716   if p-obj-type = 'маг':U
     3717   or p-obj-type = 'скл':U then do:
     3718     define variable l-shift-on as logical no-undo .
     3719   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3720   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3721     (input  p-obj-type
     3722     ,input  p-obj-code
     3723     ,input  'shift-on=request'
     3724     ,output l-shift-on
     3725     )  .
     3726     if l-shift-on and t-close-day-period then do:
     3727       message
     3728       "Не могут быть одновременно включены СМЕНЫ на объекте и режим закрытия периода по продаже"
     3729       view-as alert-box error .
     3730       undo, return no-apply.
     3731     end.
     3732   end.
     3733   IF  t-autofbr then
     3734   ASSIGN
     3735   t-restdish
     3736   t-restingr
     3737   .
     3738   assign
     3739   t-resttpsi
     3740   t-neg-tpsi-weight
     3741   f-neg-tpsi-qnty
     3742   t-neg-tpsi-oper
     3743   .
     3744   FOR EACH buf_tt-sale-add :
     3745      ASSIGN
     3746      v-sale-add = v-sale-add + (IF v-sale-add = '':U THEN '':U ELSE ';':U) +
     3747                       buf_tt-sale-add.doc-kind + chr(44) +
     3748                       buf_tt-sale-add.obj-type + chr(44) +
     3749                       string(buf_tt-sale-add.obj-code).
     3750     if buf_tt-sale-add.doc-kind = 'trf':U then do:
     3751       assign
     3752       v-trf-type = buf_tt-sale-add.obj-type
     3753       v-trf-code = buf_tt-sale-add.obj-code
     3754       .
     3755     end.
     3756   END.
     3757   assign
     3758   fh = frame Dialog-Frame:first-child
     3759   wh = fh:first-child
     3760   .
     3761   do while valid-handle(wh):
     3762     if wh:private-data begins "recid=" then do:
     3763       find first thbjattr_thbj-attr where
     3764                 recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     3765       assign
     3766       buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     3767     end.
     3768     wh = wh:next-sibling.
     3769   end.
     3770   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'sale-add':U.
     3771   assign
     3772   thbjattr_thbj-attr.property-value-character = v-sale-add
     3773   .
     3774   release thbjattr_thbj-attr.
     3775   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'close-in-rfsl':U.
     3776   assign
     3777   thbjattr_thbj-attr.property-value-integer = (if t-close-in-rfsl then 1 else 0)
     3778   .
     3779   release thbjattr_thbj-attr.
     3780   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'pay-gds-algo':U.
     3781   assign
     3782   thbjattr_thbj-attr.property-value-character = (if t-pay-gds-algo then "1.8" else '')
     3783   .
     3784   release thbjattr_thbj-attr.
     3785   v-same = yes.
     3786   for each thbjattr_thbj-attr,
     3787       first temp-thbj-attr where
     3788             temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     3789         and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     3790         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     3791         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code:
     3792      buffer-compare
     3793      thbjattr_thbj-attr
     3794      to temp-thbj-attr
     3795      save result in v-same.
     3796      if not v-same then leave.
     3797   end.
     3798   v-same = no.
     3799   IF v-same  and not v-to-create THEN RETURN.
     3800   run adm/shattri.p (
     3801                 input "check":U
     3802               , input p-obj-type
     3803               , input p-obj-code
     3804               , input 'autosale':U
     3805               , INPUT '':U
     3806                , output v-value-character
     3807                , output v-value-date
     3808                , output v-value-decimal
     3809                , output v-value-integer
     3810                , output v-value-logical
     3811                , output v-param-type
     3812                , input-output table-handle v-tth
     3813                ) no-error .
     3814   if error-status:error then do:
     3815     message
     3816     "Некорректное значение ПАРАМЕТРОВ" skip
     3817     error-status:get-message(1) skip
     3818     return-value
     3819     view-as alert-box error .
     3820     undo, return error .
     3821   end.
     3822   do TRANSACTION
     3823   on error undo, return error return-value
     3824   :
     3825     RUN thbjattr_set-section IN THIS-PROCEDURE (
     3826          input p-obj-type
     3827         ,input p-obj-code
     3828         ,input 'autosale':U
     3829         ,INPUT table thbjattr_thbj-attr
     3830     ) NO-ERROR.
     3831     IF ERROR-STATUS:error THEN do:
     3832       MESSAGE ERROR-STATUS:get-message(1)  SKIP
     3833       RETURN-VALUE
     3834       VIEW-AS ALERT-BOX.
     3835       UNDO, RETURN ERROR.
     3836     END.
     3837     if v-trf-code <> 0 then do:
     3838       RUN clntattr-write IN THIS-PROCEDURE (
     3839           input v-trf-type
     3840           ,input v-trf-code
     3841           ,input 'shftrep2':U
     3842           ,input string(yes)
     3843       ) NO-ERROR.
     3844     end.
     3845   end.
     3846   END PROCEDURE.
