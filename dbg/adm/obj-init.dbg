      271             "" WIDGET-ID 24
      272             LABEL "Номер БД для копирования прав при импорте из 1С" FORMAT ">>>>>>>>9"
      273             VIEW-AS FILL-IN
      274             SIZE 10 BY 1
      275        "Оплаты :" VIEW-AS TEXT
      276             SIZE 8.6 BY .91 AT ROW 11.52 COL 15 WIDGET-ID 2
      277             FGCOLOR 4
      278        RECT-1 AT ROW 10.76 COL 13
      279        SPACE(36.99) SKIP(2.04)
      280       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
