      193        b-exit AT ROW 1 COL 1
      194        b-quit AT ROW 1 COL 11
      195        b-tocd AT ROW 1 COL 41
      196        b-help AT ROW 1 COL 69
      197        X_sysconf.rsrv-time AT ROW 2 COL 31.8 COLON-ALIGNED
      198             VIEW-AS FILL-IN
      199             SIZE 4 BY 1
      200        X_sysconf.load-time AT ROW 2 COL 60 COLON-ALIGNED
      201             VIEW-AS FILL-IN
      202             SIZE 4 BY 1
      203        X_sysconf.holidays AT ROW 3 COL 52.6 COLON-ALIGNED
      204             VIEW-AS FILL-IN
      205             SIZE 11.6 BY 1
      206        X_sysconf.out-line-discnt AT ROW 5 COL 43
      207             VIEW-AS TOGGLE-BOX
      208             SIZE 22 BY .81
      209        X_sysconf.price-calc AT ROW 6 COL 2
      210             VIEW-AS TOGGLE-BOX
      211             SIZE 36.6 BY .81
      212        X_sysconf.out-rate AT ROW 6 COL 43
      213             VIEW-AS TOGGLE-BOX
      214             SIZE 22 BY .81
      215        X_sysconf.no-eq AT ROW 7 COL 2
      216             VIEW-AS TOGGLE-BOX
      217             SIZE 37.6 BY .81
      218        X_sysconf.in-ov AT ROW 7 COL 43
      219             VIEW-AS TOGGLE-BOX
      220             SIZE 23 BY .81
      221        X_sysconf.unit-cli-perm AT ROW 8 COL 2
      222             VIEW-AS TOGGLE-BOX
      223             SIZE 32.6 BY .81
      224        X_sysconf.inout-price AT ROW 8 COL 43
      225             VIEW-AS TOGGLE-BOX
      226             SIZE 32 BY .81
      227        X_sysconf.in-perm AT ROW 9 COL 2
      228             VIEW-AS TOGGLE-BOX
      229             SIZE 69 BY .81
      230        X_sysconf.in-pay AT ROW 11.52 COL 30.6 COLON-ALIGNED
      231             LABEL "п&рихода"
      232             VIEW-AS FILL-IN
      233             SIZE 6 BY 1
      234        b-inpay AT ROW 11.52 COL 39.6 WIDGET-ID 6
      235        X_sysconf.out-pay AT ROW 12.52 COL 30.6 COLON-ALIGNED
      236             LABEL "рас&хода"
      237             VIEW-AS FILL-IN
      238             SIZE 6 BY 1
      239        b-outpay AT ROW 12.52 COL 39.6 WIDGET-ID 10
      240        X_sysconf.ret-pay AT ROW 13.52 COL 30.6 COLON-ALIGNED
      241             LABEL "во&зврата"
      242             VIEW-AS FILL-IN
      243             SIZE 6 BY 1
      244        b-retpay AT ROW 13.52 COL 39.6 WIDGET-ID 14
      245        X_sysconf.ret-sup-pay AT ROW 14.52 COL 30.6 COLON-ALIGNED
      246             LABEL "возвра&та пост."
      247             VIEW-AS FILL-IN
      248             SIZE 6 BY 1
      249        b-suppay AT ROW 14.52 COL 39.6 WIDGET-ID 18
      250        X_sysconf.down-pay AT ROW 15.52 COL 30.6 COLON-ALIGNED
      251             LABEL "списани&я"
      252             VIEW-AS FILL-IN
      253             SIZE 6 BY 1
      254        b-spipay AT ROW 15.52 COL 39.6 WIDGET-ID 16
      255        X_sysconf.inv-pay AT ROW 16.52 COL 30.6 COLON-ALIGNED
      256             LABEL "и&нвентар."
      257             VIEW-AS FILL-IN
      258             SIZE 6 BY 1
      259        b-invpay AT ROW 16.52 COL 39.6 WIDGET-ID 8
      260        X_sysconf.chk-pay AT ROW 17.52 COL 30.6 COLON-ALIGNED
      261             LABEL "продажи"
      262             VIEW-AS FILL-IN
      263             SIZE 6 BY 1
      264        b-realpay AT ROW 17.52 COL 39.6 WIDGET-ID 12
