      290           X_sysconf.down-pay
      291           X_sysconf.in-pay
      292           X_sysconf.inv-pay
      293           X_sysconf.out-pay
      294           X_sysconf.ret-pay
      295           X_sysconf.ret-sup-pay
      296           X_sysconf.fbr-pay
      297           X_sysconf.out-rate
      298           X_sysconf.out-line-discnt
      299           X_sysconf.inout-price
      300           X_sysconf.no-eq
      301           X_sysconf.unit-cli-perm
      302           X_sysconf.in-ov
      303           X_sysconf.in-perm
      304           X_sysconf.price-calc
      305           X_sysconf.rsrv-time
      306           X_sysconf.load-time
      307           X_sysconf.holidays
      308           X_sysconf.xdn-grp-code
      309           .
      310           if v-to-c-d = yes then
      311           assign
      312           X_sysconf.all-prt = all-prt_
      313           X_sysconf.cd-bc-alt = cd-bc-alt_
      314           X_sysconf.cd-bc-base = cd-bc-base_
      315           X_sysconf.cd-loc-alt = cd-loc-alt_
      316           X_sysconf.cd-loc-base = cd-loc-base_
      317           X_sysconf.cd-parts-all = cd-parts-all_
      318           X_sysconf.cd-parts-not-blank = cd-parts-not-blank_
      319           X_sysconf.cd-parts-ser = cd-parts-ser_
      320           X_sysconf.cd-pb-alt = cd-pb-alt_
      321           X_sysconf.cd-pb-base = cd-pb-base_
      322           X_sysconf.cd-sc-base =cd-sc-base_
      323           .
      324   END.
      325   ON CHOOSE OF b-fbrpay IN FRAME d-config
      326   DO:
      327       define variable ref-rec as character no-undo .
      328       define buffer buf_pay-type for ub.pay-type.
      329       run ref/paytype.w (input parparentproc, "b-sel", output ref-rec ).
      330       apply "ENTRY" to self .
      331       if ref-rec = "" then return no-apply.
      332       else do:
      333           FIND buf_pay-type WHERE
      334                    recid( buf_pay-type ) = integer(ref-rec) NO-LOCK .
      335           assign
      336           X_sysconf.fbr-pay = buf_pay-type.obj-code .
      337           display
      338           X_sysconf.fbr-pay
      339           with frame d-config.
      340       end.
      341   END.
      342   ON CHOOSE OF b-inpay IN FRAME d-config
