      457   ON CHOOSE OF b-tocd IN FRAME d-config
      458   DO:
      459       assign
      460       all-prt_ = X_sysconf.all-prt
      461       cd-bc-alt_ = X_sysconf.cd-bc-alt
      462       cd-bc-base_ = X_sysconf.cd-bc-base
      463       cd-loc-alt_ = X_sysconf.cd-loc-alt
      464       cd-loc-base_ = X_sysconf.cd-loc-base
      465       cd-parts-all_ = X_sysconf.cd-parts-all
      466       cd-parts-not-blank_ = X_sysconf.cd-parts-not-blank
      467       cd-parts-ser_ = X_sysconf.cd-parts-ser
      468       cd-pb-alt_ = X_sysconf.cd-pb-alt
      469       cd-pb-base_ = X_sysconf.cd-pb-base
      470       cd-sc-base_ = X_sysconf.cd-sc-base.
      471       run adm/to-cd.w ( INPUT (if ibs.th.gbl.gbl-var:g#db-num = 0 then 'ИЗМЕНЕНИЕ':U else 'ПРОСМОТР':U)
      472                        ,INPUT X_sysconf.host-code
      473                        ,INPUT 'маг':U
      474                        ,INPUT 0
      475                        ,input  ("Параметры отсылки товаров на кассу по умолчанию для маг-нов фирмы " +
      476                                                   string(X_sysconf.host-code))
      477                         ,INPUT-OUTPUT all-prt_
      478                         ,INPUT-OUTPUT cd-bc-alt_
      479                         ,INPUT-OUTPUT cd-bc-base_
      480                         ,INPUT-OUTPUT cd-loc-alt_
      481                         ,INPUT-OUTPUT cd-loc-base_
      482                         ,INPUT-OUTPUT cd-parts-all_
      483                         ,INPUT-OUTPUT cd-parts-not-blank_
      484                         ,INPUT-OUTPUT cd-parts-ser_
      485                         ,INPUT-OUTPUT cd-pb-alt_
      486                         ,INPUT-OUTPUT cd-pb-base_
      487                         ,INPUT-OUTPUT cd-sc-base_) .
      488       assign
      489       v-to-c-d = yes.
      490   END.
      491   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-config:PARENT eq ?
      492   THEN FRAME d-config:PARENT = ACTIVE-WINDOW.
      493   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      494   on help of frame d-config
      495   do:
      496     run gbl/app_help.p
      497       (input this-procedure :file-name
      498       ,input ''
      499       ,input ?
      500       ) no-error.
      501     if error-status :error then do:
      502       message
      503         "Ошибка при вызове помощи"
      504         error-status :get-message(1)
      505         view-as alert-box .
      506     end.
      507   end.
      508   run minbtn-set in this-procedure .
      509   on choose of b-help in frame d-config
      510   do:
      511     apply "help":u to frame d-config .
      512   end.
      513   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      514   procedure minbtn-set :
      515       do
      516           on error undo, return error return-value
      517           :
      518           define variable ii              as integer       no-undo .
      519           define variable fh              as widget-handle no-undo .
      520           define variable hh              as widget-handle no-undo .
      521           define variable v-h             as handle        extent 4 no-undo .
      522           define variable v-name-button   as character     no-undo .
      523           define variable v-help-old-x    as decimal       no-undo .
      524           define variable v-help-old-y    as decimal       no-undo .
      525           define variable v-help-old-size as decimal       no-undo .
      526           define variable v-frame-width   as decimal       no-undo .
      527           define variable jj              as integer       no-undo .
      528           do
      529               on error undo, return error
      530               :
      531               assign
      532                   v-frame-width = frame d-config:width - 0.3
      533                   fh            = frame d-config:first-child
      534                   hh            = fh:first-child
      535                   ii            = 1
      536                   .
      537               do while valid-handle(hh):
      538                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      539                   do:
      540                       case lc(hh:name) :
      541                           when "b-help" then
      542                               do:
      543                                   hh:load-image-up("cmp/b-help.bmp":u) .
      544                                   hh:load-image-down("cmp/b-help.bmp":u) .
      545                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      546                                   hh:TOOLTIP = "Помощь" .
      547                                   v-help-old-x = hh:column .
      548                                   v-help-old-y = hh:row    .
      549                                   v-help-old-size = hh:width .
      550                                   hh:width-chars = 2.5 .
      551                               end.
      552                           when "b-print" then
      553                               do:
      554                                   hh:load-image("cmp/b-print.bmp":u) .
      555                                   hh:TOOLTIP = "Печать" .
      556                                   v-h[ii] = hh:handle .
      557                                   ii = ii + 1 .
      558                                   hh:width-chars = 3 .
      559                               end.
      560                           when "b-history" or
      561                           when "b-hist" then
      562                               do:
      563                                   hh:load-image("cmp/b-hist.bmp":u) .
      564                                   hh:TOOLTIP = "История" .
      565                                   v-h[ii] = hh:handle .
      566                                   ii = ii + 1 .
      567                                   hh:width-chars = 3 .
      568                               end.
      569                           when "b-sch" then
      570                               do:
      571                                   hh:load-image("cmp/b-sch.bmp":u) .
      572                                   hh:TOOLTIP = "Установка Фильтра" .
      573                                   v-h[ii] = hh:handle .
      574                                   ii = ii + 1 .
      575                                   hh:width-chars = 3 .
      576                               end.
      577                           when "b-hist-user" then
      578                               do:
      579                                   hh:load-image("cmp/b-hist.bmp":u) .
      580                                   hh:TOOLTIP = "История пользователя" .
      581                                   ii = ii + 1 .
      582                               end.
      583                       end case.
      584                   end.
      585                   hh = hh:next-sibling.
      586               end.
      587               b-help:column = v-frame-width - b-help:width-chars.
      588               jj = 0.
      589               repeat ii = 4 to 1 by -1 :
      590                   if valid-handle (v-h[ii] ) then
      591                   do:
      592                       jj  = jj + 1 .
      593                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      594                       v-h[ii]:row    = v-help-old-y .
      595                   end.
      596               end.
      597           end.
      598       end.
      599   end procedure.
      600   ON WINDOW-CLOSE OF FRAME d-config APPLY "END-ERROR":U TO SELF.
      601   MAIN-BLOCK:
      602   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      603      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      604     find X_sysconf where X_sysconf.host-code = p-curr-host-code.
      605     find first buf_clients no-lock where
      606               buf_clients.obj-type = 'орг':U
      607           and buf_clients.obj-code = p-curr-host-code.
      608     RUN enable_UI.
      609     assign
      610     frame d-config:title = substitute("&1 для фирмы &2"
      611                                           , frame d-config:title
      612                                          , buf_clients.obj-name).
      613     WAIT-FOR GO OF FRAME d-config.
      614   END.
      615   RUN disable_UI.
      616   PROCEDURE disable_UI :
      617     HIDE FRAME d-config.
      618   END PROCEDURE.
      619   PROCEDURE enable_UI :
      620     IF AVAILABLE X_sysconf THEN
      621       DISPLAY X_sysconf.rsrv-time X_sysconf.load-time X_sysconf.holidays
      622             X_sysconf.out-line-discnt X_sysconf.price-calc X_sysconf.out-rate
      623             X_sysconf.no-eq X_sysconf.in-ov X_sysconf.unit-cli-perm
      624             X_sysconf.inout-price X_sysconf.in-perm X_sysconf.in-pay
      625             X_sysconf.out-pay X_sysconf.ret-pay X_sysconf.ret-sup-pay
      626             X_sysconf.down-pay X_sysconf.inv-pay X_sysconf.chk-pay
      627             X_sysconf.fbr-pay X_sysconf.xdn-grp-code
      628         WITH FRAME d-config.
      629     ENABLE b-exit b-quit b-tocd b-help RECT-1 X_sysconf.rsrv-time
      630            X_sysconf.load-time X_sysconf.holidays X_sysconf.out-line-discnt
      631            X_sysconf.price-calc X_sysconf.out-rate X_sysconf.no-eq
      632            X_sysconf.in-ov X_sysconf.unit-cli-perm X_sysconf.inout-price
      633            X_sysconf.in-perm X_sysconf.in-pay b-inpay X_sysconf.out-pay b-outpay
      634            X_sysconf.ret-pay b-retpay X_sysconf.ret-sup-pay b-suppay
      635            X_sysconf.down-pay b-spipay X_sysconf.inv-pay b-invpay
      636            X_sysconf.chk-pay b-realpay X_sysconf.fbr-pay b-fbrpay
      637            X_sysconf.xdn-grp-code
      638         WITH FRAME d-config.
      639   END PROCEDURE.
      640   PROCEDURE Myenable :
      641   IF AVAILABLE X_sysconf THEN
      642       DISPLAY X_sysconf.rsrv-time X_sysconf.load-time X_sysconf.holidays
      643             X_sysconf.out-line-discnt X_sysconf.price-calc X_sysconf.out-rate
      644             X_sysconf.no-eq X_sysconf.in-ov X_sysconf.unit-cli-perm
      645             X_sysconf.inout-price X_sysconf.in-perm X_sysconf.in-pay
      646             X_sysconf.down-pay X_sysconf.out-pay X_sysconf.inv-pay
      647             X_sysconf.ret-pay X_sysconf.chk-pay X_sysconf.ret-sup-pay
      648             X_sysconf.fbr-pay X_sysconf.xdn-grp-code
      649         WITH FRAME d-config.
      650     ENABLE b-exit b-quit b-tocd b-help X_sysconf.rsrv-time X_sysconf.load-time
      651            X_sysconf.holidays X_sysconf.out-line-discnt X_sysconf.price-calc
      652            X_sysconf.out-rate X_sysconf.no-eq X_sysconf.in-ov
      653            X_sysconf.unit-cli-perm X_sysconf.inout-price X_sysconf.in-perm
      654            X_sysconf.in-pay X_sysconf.down-pay X_sysconf.out-pay
      655            X_sysconf.inv-pay X_sysconf.ret-pay X_sysconf.chk-pay
      656            X_sysconf.ret-sup-pay X_sysconf.fbr-pay RECT-1 X_sysconf.xdn-grp-code
      657         WITH FRAME d-config.
      658   IF ibs.th.gbl.gbl-var:g#db-num <> 0 THEN DO:
      659       HIDE
      660       b-exit IN FRAME d-config.
      661       ASSIGN
      662       b-quit:COLUMN = 1
      663       b-quit:LABEL = "&Выход".
      664   END.
      665   END PROCEDURE.
