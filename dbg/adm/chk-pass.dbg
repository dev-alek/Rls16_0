      254       , input  0
      255       , input  v-cntxt-userid
      256       ) NO-ERROR .
      257   end.
      258         RETURN .
      259      END.
      260      assign
      261         p-ok = FALSE
      262      .
      263      FIND FIRST buf_user-login
      264           WHERE buf_user-login.db-num     = p-db-num
      265             AND buf_user-login.user-id    = p-user-id
      266           NO-LOCK
      267           NO-ERROR
      268           .
      269      IF AVAILABLE buf_user-login
      270      THEN DO:
      271         ASSIGN
      272            v-login = buf_user-login.user-login
      273         .
      274      END.
      275      RUN enable_UI.
      276      WAIT-FOR GO OF FRAME Dialog-Frame.
      277   END.
      278   RUN disable_UI.
      279   PROCEDURE chk-action :
      280   define output parameter p-ok as logical          no-undo.
      281   define variable v-user-password-enc    as character    no-undo.
      282   do
      283   on error undo, return error
      284   :
      285   define variable vss-include-info5 as character format "X(65)" no-undo
      286   initial "@(#)$Workfile$ $Revision$".
      287   do:
      288     if valid-handle( g#eventlib ) <> TRUE then do:       run gbl/eventlib.p persistent no-error.       if error-status :error or valid-handle( g#eventlib ) <> TRUE then do:         message "Error starting eventlib.p" skip( 0 )           g#eventlib                        skip( 0 )           g#eventlib    :type               skip( 0 )           g#eventlib    :file-name          skip( 0 )           error-status :get-message( 1 )  skip( 0 )           return-value                    skip( 0 )         view-as alert-box error.         stop.       end.      end.     run eventlib-event-log in g#eventlib
      289       ( input  0
      290       , input  v-cntxt-db-num
      291       , input  p-action
      292       , input  0
      293       , input  '':U
      294       , input  0
      295       , input  '':U
      296       , input  '*':U
      297       , input  '':U
      298       , input  '':U
