      207       (input  v-cntxt-db-num
      208       ,input  v-cntxt-userid
      209       ,input  0
      210       ,input  p-action
      211       ,input  'object':U
      212       ,input  0
      213       ,input  v-cntxt-obj-type
      214       ,input  v-cntxt-obj-code
      215       ,input  0
      216       ,input  0
      217       ,input  0
      218       ,input  false
      219       ,output p-ok
      220       )  .
      221   end.
      222      IF p-ok
      223      AND NOT p-ask
      224      THEN DO:
      225   define variable vss-include-info4 as character format "X(65)" no-undo
      226   initial "@(#)$Workfile$ $Revision$".
      227   do:
      228     if valid-handle( g#eventlib ) <> TRUE then do:       run gbl/eventlib.p persistent no-error.       if error-status :error or valid-handle( g#eventlib ) <> TRUE then do:         message "Error starting eventlib.p" skip( 0 )           g#eventlib                        skip( 0 )           g#eventlib    :type               skip( 0 )           g#eventlib    :file-name          skip( 0 )           error-status :get-message( 1 )  skip( 0 )           return-value                    skip( 0 )         view-as alert-box error.         stop.       end.      end.     run eventlib-event-log in g#eventlib
      229       ( input  0
      230       , input  v-cntxt-db-num
      231       , input  p-action
      232       , input  0
      233       , input  '':U
      234       , input  0
      235       , input  '':U
      236       , input  '*':U
      237       , input  '':U
      238       , input  '':U
      239       , input  '':U
      240       , input  TODAY
      241       , input  35
      242       , input  TIME
      243       , input  'S':U
      244       , input  0
      245       , input  v-cntxt-obj-type
      246       , input  v-cntxt-obj-code
      247       , input  '':U
