        1   define input parameter  parparentproc as handle    no-undo .
        2   define input parameter  p-user-id     as character no-undo .
        3   define input parameter  p-db-num      as integer   no-undo .
        4   define input parameter  p-action      as character        no-undo.
        5   define input parameter  p-ask         as logical          no-undo.
        6   define output parameter p-message     as character        no-undo.
        7   define output parameter p-ok          as logical   no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "Проверка пароля".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   procedure proc-alt-shift-f2:
       75     if not ibs.th.gbl.gbl-var:rcode
       76   then
       77     run gbl\inidebug.p .
       78   end.
       79   procedure proc-alt-shift-f3:
       80     run gbl/prvssinf.p
       81       ( input this-procedure
       82       ) .
       83   end.
       84   define variable v-inform-launched as logical no-undo initial false .
       85   procedure proc-alt-shift-f4:
       86     define variable v-action as character no-undo .
       87     if v-inform-launched = false then do:
       88       assign
       89         v-inform-launched = true
       90       .
       91       run gbl/d-inform.w
       92         (  input self
       93         ,  input this-procedure
       94         , output v-action
       95         ) no-error .
       96       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       97       assign
       98         v-inform-launched = false
       99       .
      100     end.
      101   end.
      102   procedure proc-alt-f1:
      103     run gbl/corrhelp.p
      104       (input this-procedure
      105       ) .
      106   end .
      107   on alt-shift-f2 anywhere do:
      108     run proc-alt-shift-f2.
      109   end.
      110   on alt-shift-f3 anywhere do:
      111     run proc-alt-shift-f3 in this-procedure .
      112   end.
      113   on alt-shift-f4 anywhere do:
      114     run proc-alt-shift-f4 in this-procedure.
      115   end.
      116   on alt-f1 anywhere do:
      117     run proc-alt-f1 in this-procedure .
      118   end.
      119   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      120     define variable v-cntxt-db-num        as integer   no-undo .
      121     define variable v-cntxt-userid        as character no-undo .
      122     define variable v-cntxt-level         as character no-undo .
      123     define variable v-cntxt-host-code-obj as integer   no-undo .
      124     define variable v-cntxt-obj-type      as character no-undo .
      125     define variable v-cntxt-obj-code      as integer   no-undo .
      126     define variable v-cntxt-db-num-obj    as integer   no-undo .
      127     define variable v-cntxt-is-admin      as logical   no-undo .
      128   define variable vss-include-info1 as character format "X(65)" no-undo
      129   initial "@(#)$Workfile$ $Revision$".
      130   define new global shared variable g#eventlib as handle no-undo.
      131   define buffer buf_user-login     for ub.user-login .
      132   DEFINE BUTTON b-exit AUTO-GO
      133        LABEL "&Ввод"
      134        SIZE 10 BY 1
      135        BGCOLOR 8 .
      136   DEFINE BUTTON b-quit AUTO-END-KEY
      137        LABEL "&Отмена"
      138        SIZE 10 BY 1
      139        BGCOLOR 8 .
      140   DEFINE VARIABLE v-login AS CHARACTER FORMAT "X(256)":U
      141        LABEL "Логин"
      142        VIEW-AS FILL-IN
      143        SIZE 16 BY 1 NO-UNDO.
      144   DEFINE VARIABLE v-password AS CHARACTER FORMAT "X(16)":U
      145        LABEL "Пароль"
      146        VIEW-AS FILL-IN
      147        SIZE 16 BY 1 NO-UNDO.
      148   DEFINE FRAME Dialog-Frame
      149        v-password AT ROW 2.75 COL 10.88 COLON-ALIGNED WIDGET-ID 4 AUTO-RETURN  PASSWORD-FIELD
      150        b-exit AT ROW 4.75 COL 10
      151        b-quit AT ROW 4.75 COL 21
      152        v-login AT ROW 1.5 COL 11 COLON-ALIGNED WIDGET-ID 2
      153        SPACE(11.62) SKIP(4.07)
      154       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      155            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      156            TITLE "Введите пароль"
      157            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit WIDGET-ID 100.
      158   ASSIGN
      159          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      160          FRAME Dialog-Frame:HIDDEN           = TRUE.
      161   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      162   DO:
      163     APPLY "END-ERROR":U TO SELF.
      164   END.
      165   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      166   DO:
      167     assign
      168       v-login
      169       v-password
      170     .
      171     RUN chk-action in this-procedure (OUTPUT p-ok)  .
      172   END.
      173   ON ENTER OF v-password IN FRAME Dialog-Frame
      174   DO:
      175      APPLY "CHOOSE" TO b-exit in frame Dialog-Frame.
      176   END.
      177   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      178   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      179   on "ENTRY" of b-exit do:
      180     if lastkey = keycode ("RETURN") then do:
      181       apply "CHOOSE" to b-exit in frame Dialog-Frame.
      182     end.
      183   end.
      184   on "ESC" ANYWHERE do:
      185     if lastkey = keycode ("RETURN") then do:
      186       p-ok = FALSE.
      187       apply "CHOOSE" to b-quit in frame Dialog-Frame.
      188     end.
      189   end.
      190   MAIN-BLOCK:
      191   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      192      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      193   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      194     run mainmenu_getcntxt in parparentproc
      195       (output v-cntxt-db-num
      196       ,output v-cntxt-userid
      197       ,output v-cntxt-level
      198       ,output v-cntxt-host-code-obj
      199       ,output v-cntxt-obj-type
      200       ,output v-cntxt-obj-code
      201       ,output v-cntxt-db-num-obj
      202       ,output v-cntxt-is-admin
      203       ) .
      204   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      205   do:
