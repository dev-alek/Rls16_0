      518   END PROCEDURE.
      519   PROCEDURE disable_UI :
      520     HIDE FRAME Dialog-Frame.
      521   END PROCEDURE.
      522   PROCEDURE enable_UI :
      523     DISPLAY v-password v-login
      524         WITH FRAME Dialog-Frame.
      525     ENABLE v-password b-exit b-quit v-login
      526         WITH FRAME Dialog-Frame.
      527     VIEW FRAME Dialog-Frame.
      528   END PROCEDURE.
