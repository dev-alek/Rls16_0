      316       ) NO-ERROR .
      317   end.
      318      FIND FIRST buf_user-login
      319           WHERE buf_user-login.db-num     = p-db-num
      320             AND buf_user-login.user-login = v-login
      321           NO-LOCK
      322           NO-ERROR
      323           .
      324      IF NOT AVAILABLE buf_user-login
      325      THEN DO:
      326         ASSIGN
      327            p-message = "Неправильный логин"
      328            p-ok      = FALSE
      329         .
      330         RETURN.
      331      END.
      332      run adm/pswd-enc.p
      333         (input  encode(v-password)
      334         ,output v-user-password-enc
      335         ) no-error .
      336      if error-status:error
      337      then do:
      338         return error substitute( "&1. Ошибка кодировки. &2", vss-workfile, return-value ).
      339      end.
      340      assign
      341         v-user-password-enc = encode(v-user-password-enc)
      342      .
      343      IF buf_user-login.user-password-encoded = v-user-password-enc
      344      THEN DO:
      345         IF p-action = "":U
      346         THEN DO:
      347            ASSIGN
      348               p-ok = TRUE
      349            .
