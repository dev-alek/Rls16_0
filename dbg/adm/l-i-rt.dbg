        1   define variable vss-revision    as character no-undo init "$Revision: 21e3183bea69, 738, rls $":U .
        2   define variable vss-author      as character no-undo init "$Author: SShalanin $":U .
        3   define variable vss-date        as character no-undo init "$Date: Mon Aug 01 17:35:56 2016 +0300 $":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile: l-i-rt.w $":U .
        5   define variable vss-archive     as character no-undo init "$Archive: adm/l-i-rt.w $":U .
        6   define variable vss-description as character no-undo init "Окно входа в систему".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   define variable v-cConnect          as character no-undo .
       66   define variable v-fltConnect        as character no-undo .
       67   define variable v-user-entered      as logical   no-undo init false .
       68   define variable v-name-for-load-cfg as character no-undo .
       69   define variable v-name-for-init-db  as character no-undo .
       70   define variable v-fname-cfg         as character no-undo .
       71   define variable v-err-code          as integer   no-undo .
       72   define variable v-try-connect       as logical   no-undo init false .
       73   define variable v-is-copy           as logical   no-undo init false .
       74   define variable v-updating          as logical   no-undo init false .
       75   DEFINE VAR w-login AS WIDGET-HANDLE NO-UNDO.
       76   DEFINE BUTTON b-OK AUTO-GO
       77        LABEL "&Ввод":L
       78        SIZE 10 BY 1.
       79   DEFINE BUTTON b-quit AUTO-END-KEY
       80        LABEL "&Отмена":L
       81        SIZE 10 BY 1.
       82   DEFINE VARIABLE name AS CHARACTER FORMAT "X(12)":U
       83        LABEL "Логин"
       84        VIEW-AS FILL-IN
       85        SIZE 20 BY 1 NO-UNDO.
       86   DEFINE VARIABLE password AS CHARACTER FORMAT "X(16)":U
       87        LABEL "Пароль"
       88        VIEW-AS FILL-IN
       89        SIZE 20 BY 1 NO-UNDO.
       90   DEFINE VARIABLE password_display AS CHARACTER FORMAT "X(16)":U
       91        LABEL "Пароль"
       92        VIEW-AS FILL-IN
       93        SIZE 20 BY 1 NO-UNDO.
       94   DEFINE IMAGE IMAGE-1
       95        FILENAME "cmp/ith.bmp":U
       96        SIZE 40 BY 8.88.
       97   DEFINE FRAME FRAME-A
       98        name AT ROW 4.96 COL 10 COLON-ALIGNED
       99        password AT ROW 6.17 COL 10 COLON-ALIGNED BLANK
      100        password_display AT ROW 6.17 COL 10 COLON-ALIGNED  PASSWORD-FIELD
      101        b-OK AT ROW 8 COL 11.75
      102        b-quit AT ROW 8 COL 21.88
      103        IMAGE-1 AT ROW 1 COL 1
      104       WITH 1 DOWN NO-BOX OVERLAY
      105            SIDE-LABELS THREE-D
      106            AT COL 1 ROW 1
      107            SIZE 40.13 BY 9.13.
      108   IF SESSION:DISPLAY-TYPE = "GUI":U THEN
      109     CREATE WINDOW w-login ASSIGN
      110            HIDDEN             = YES
      111            TITLE              = "TH Обмен с радиотерминалом"
      112            COLUMN             = 27
      113            ROW                = 7.58
      114            HEIGHT             = 9.13
      115            WIDTH              = 40.25
      116            MAX-HEIGHT         = 35.63
      117            MAX-WIDTH          = 160
      118            VIRTUAL-HEIGHT     = 35.63
      119            VIRTUAL-WIDTH      = 160
      120            RESIZE             = no
      121            SCROLL-BARS        = yes
      122            STATUS-AREA        = no
      123            BGCOLOR            = ?
      124            FGCOLOR            = ?
      125            THREE-D            = yes
      126            MESSAGE-AREA       = no
      127            SENSITIVE          = yes.
      128   ELSE w-login = CURRENT-WINDOW.
      129   IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(w-login)
      130   THEN w-login:HIDDEN = no.
      131   ON VALUE-CHANGED OF password_display IN FRAME FRAME-A DO:
      132       IF NOT v-updating THEN DO:
      133           ASSIGN password:SCREEN-VALUE = password_display:SCREEN-VALUE.
      134       END.
      135   END.
      136   ON ANY-KEY OF password_display IN FRAME FRAME-A DO:
      137       IF LASTKEY = KEY-CODE("CTRL-V") THEN DO:
      138              ASSIGN
      139              v-updating = TRUE
      140              password:SCREEN-VALUE = System.Windows.Forms.Clipboard:GetText()
      141              password_display:SCREEN-VALUE = System.Windows.Forms.Clipboard:GetText()
      142              v-updating = FALSE.
      143              System.Windows.Forms.Clipboard:Clear().
      144              RETURN NO-APPLY.
      145       END.
      146   END.
      147   ON CHOOSE OF b-OK IN FRAME FRAME-A
      148   DO:
      149     if name :screen-value = ""
      150     then do:
      151       message
      152         "Введите имя пользователя"
      153         view-as alert-box information .
      154       apply "entry" to name .
      155       return no-apply .
      156     end.
      157   END.
      158   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      159   on help of frame FRAME-A
      160   do:
      161     run gbl/app_help.p
      162       (input this-procedure :file-name
      163       ,input ''
      164       ,input ?
      165       ) no-error.
      166     if error-status :error then do:
      167       message
      168         "Ошибка при вызове помощи"
      169         error-status :get-message(1)
      170         view-as alert-box .
      171     end.
      172   end.
      173   procedure proc-alt-shift-f2:
      174     if not ibs.th.gbl.gbl-var:rcode
      175   then
      176     run gbl\inidebug.p .
      177   end.
      178   procedure proc-alt-shift-f3:
      179     run gbl/prvssinf.p
      180       ( input this-procedure
      181       ) .
      182   end.
      183   define variable v-inform-launched as logical no-undo initial false .
      184   procedure proc-alt-shift-f4:
      185     define variable v-action as character no-undo .
      186     if v-inform-launched = false then do:
      187       assign
      188         v-inform-launched = true
      189       .
      190       run gbl/d-inform.w
      191         (  input self
      192         ,  input this-procedure
      193         , output v-action
      194         ) no-error .
      195       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      196       assign
      197         v-inform-launched = false
      198       .
      199     end.
      200   end.
      201   procedure proc-alt-f1:
      202     run gbl/corrhelp.p
      203       (input this-procedure
      204       ) .
      205   end .
      206   on alt-shift-f2 anywhere do:
      207     run proc-alt-shift-f2.
      208   end.
      209   on alt-shift-f3 anywhere do:
      210     run proc-alt-shift-f3 in this-procedure .
      211   end.
      212   on alt-shift-f4 anywhere do:
      213     run proc-alt-shift-f4 in this-procedure.
      214   end.
      215   on alt-f1 anywhere do:
      216     run proc-alt-f1 in this-procedure .
      217   end.
      218   on "ENTRY" of b-ok do:
      219     if lastkey = keycode ("RETURN") then apply "CHOOSE" to b-ok in frame FRAME-A.
      220   end.
      221   on window-close of w-login do:
      222     apply "end-error" to frame FRAME-A.
      223   end.
      224   ASSIGN
      225     CURRENT-WINDOW             = w-login
      226     SESSION:SYSTEM-ALERT-BOXES = (CURRENT-WINDOW:MESSAGE-AREA = NO)
      227     session:three-d = yes
      228   .
      229   PAUSE 0 BEFORE-HIDE.
      230   if session:date-format <> "dmy":U
      231     or session:numeric-decimal-point <> ".":U
      232     or session:numeric-separator <> ",":U
      233   then do:
      234     message
      235       vss-workfile vss-revision vss-description skip
      236       "Неправильные установки сессии progress!" skip
      237       "Формат даты должен быть - " "'dmy'":U skip
      238       "Десятичный разделитель - " "'.'":U skip
      239       "Разделитель тысяч - " "','":U skip
      240       view-as alert-box error .
      241     quit.
      242   end.
      243   IMAGE-1 :load-image("cmp/ith.bmp") .
      244   define variable v-auto-start  as logical   no-undo .
      245   define variable v-num-entries as integer   no-undo .
      246   define variable v-ind         as integer   no-undo .
      247   define variable v-param       as character no-undo .
      248   if  session :parameter <> "":u
      249   and session :parameter <> ?
      250   then do:
      251     assign
      252       v-auto-start = true
      253     .
      254     assign
      255       v-num-entries = num-entries( session:parameter, ",":u )
      256     .
      257     do v-ind = 1 to v-num-entries :
      258       assign
      259         v-param = entry( v-ind, SESSION:PARAMETER, ",":U )
      260       .
      261       if num-entries( v-param, ":":U ) = 2 then do:
      262         if v-param begins "U:" then do:
      263           assign
      264             name = entry( 2, v-param, ":":U )
      265           .
      266         end.
      267         if v-param begins "P:" then do:
      268           assign
      269             password = entry( 2, v-param, ":":U )
      270           .
      271         end.
      272       end.
      273     end.
      274   end.
      275   else do:
      276     assign
      277       v-auto-start = false
      278     .
      279     enable
      280       name password b-ok b-quit
      281       with frame FRAME-A in window w-login .
      282     assign
      283       session :data-entry-return = yes
      284     .
      285   end.
      286   run gbl/font-chk.p no-error .
      287   if error-status :error
      288   then do:
      289     message
      290       "Неправильные установки системных шрифтов" skip
      291       "Обратитесь к администратору" skip
      292       error-status :get-message(1) skip
      293       return-value skip
      294       view-as alert-box information .
      295   end.
      296   do1:
      297   do
      298   on error  undo, leave
      299   on endkey undo, leave
      300   on stop   undo, leave
      301   :
      302     if lookup( '.', propath) > 0
      303     then do:
      304       define variable v-home-directory      as character no-undo .
      305       define variable v-num-entries-propath as integer   no-undo .
      306       define variable v-old-propath         as character no-undo .
      307       define variable v-new-propath         as character no-undo .
      308       define variable v-path-item           as character no-undo .
      309       assign
      310         file-info :file-name = '.'
      311         v-home-directory = file-info :full-pathname
      312       .
      313       assign
      314         v-old-propath = propath
      315         v-new-propath = ''
      316       .
      317       assign
      318         v-num-entries-propath = num-entries(v-old-propath)
      319       .
      320       do v-ind = 1 to v-num-entries-propath
      321       :
      322         assign
      323           v-path-item = entry(v-ind, v-old-propath)
      324         .
      325         if v-path-item = '.'
      326         then do:
      327           assign
      328             v-path-item = v-home-directory
      329           .
      330         end.
      331         assign
      332           v-new-propath = v-new-propath
      333                         + (if v-new-propath <> '' then ',' else '')
      334                         + v-path-item
      335         .
      336       end.
      337       assign
      338         propath = v-new-propath
      339       .
      340     end.
      341     run enable_ui in this-procedure .
      342     if v-auto-start <> true
      343     then do:
      344       WAIT-FOR GO OF frame FRAME-A focus name.
      345       assign
      346         name
      347         password .
      348     end.
      349     GET-KEY-VALUE SECTION "REP-SETS" KEY "ConPar" VALUE v-cConnect.
      350     if v-cConnect = ?
      351     or trim (v-cConnect) = ""
      352     then do:
      353       message
      354         "Не указаны параметры подключения к БД"
      355         "(секция REP-SETS ключ ConPar в .ini файле)."
      356         view-as alert-box error .
      357       undo do1, leave.
      358     end.
      359     if index(v-cConnect, '&1':u) = 0
      360     then do:
      361       message
      362         "В строке подключения к БД не указан комбинация символов &1"
      363         "(секция REP-SETS ключ ConPar в .ini файле)."
      364         view-as alert-box error .
      365       undo do1, leave.
      366     end.
      367     GET-KEY-VALUE SECTION "REP-SETS":U KEY "ConParFlt":U VALUE v-fltConnect .
      368     if trim (v-fltConnect) = "":U
      369       or trim( v-fltConnect ) = trim( v-cConnect )
      370     then do:
      371       assign
      372         v-fltConnect = ?
      373       .
      374     end.
      375     else do:
      376       if index(v-fltConnect, '&1':u) = 0
      377       then do:
      378         message
      379           "В строке подключения к БД параметров не указана комбинация символов &1"
      380           "(секция REP-SETS ключ ConParFlt в .ini файле)."
      381           view-as alert-box error .
      382         undo do1, leave.
      383       end.
      384     end.
      385     assign
      386       v-try-connect = true
      387     .
      388     run gbl/dbconn.p
      389       (input v-cConnect
      390       ,input v-fltConnect
      391       ,input name
      392       ,input password
      393       ,input-output v-user-entered
      394       ) .
      395     if userid('ub':U) = '':U
      396     then do:
      397       message
      398         "Ошибка при подключении к базе данных" skip
      399         "Неизвестный пользователь" skip
      400         view-as alert-box error .
      401       disconnect ub no-error .
      402       quit.
      403     end.
      404   end.
      405   assign
      406     session :data-entry-return = no
      407   .
      408   RUN disable_UI.
      409   if v-user-entered
      410   then do:
      411     run adm/unloaddb.w
      412       ( input name
      413        ,input password
      414        ,output v-is-copy
      415       ).
      416     if v-is-copy = false
      417     then do:
      418       run adm/chkdbkey.p no-error.
      419       if error-status :error
      420       then do:
      421         if error-status :get-message(1) <> ""
      422         then do:
      423           message
      424             vss-workfile vss-revision vss-description skip
      425             error-status :get-message(1) skip
      426             return-value skip
      427             view-as alert-box error .
      428         end.
      429       end.
      430       else do:
      431         run adm/checkcnf.p
      432           ( input "cfg-check":U
      433           ) no-error.
      434         if error-status :error
      435         then do:
      436           if error-status :get-message(1) <> ""
      437           then do:
      438             message
      439               vss-workfile vss-revision vss-description skip
      440               error-status :get-message(1) skip
      441               return-value skip
      442               view-as alert-box error .
      443           end.
      444         end.
      445         else do:
      446           run gbl/w-reqsrv.w
      447             (input name
      448             ,input password
      449             ,input v-auto-start
      450             ).
      451         end.
      452       end.
      453     end.
      454   end.
      455   else do:
      456     if v-try-connect = true
      457     then do:
      458       message
      459         "Ошибка при подключении к базе данных" skip
      460         "Обратитесь к администратору" skip
      461         "Строка подключения к БД:" skip
      462         v-cConnect skip
      463         view-as alert-box error .
      464     end.
      465   end.
      466   disconnect ub no-error .
      467   quit.
      468   PROCEDURE ARM-users :
      469   END PROCEDURE.
      470   PROCEDURE disable_UI :
      471     IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(w-login)
      472     THEN DELETE WIDGET w-login.
      473     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
      474   END PROCEDURE.
      475   PROCEDURE enable_UI :
      476     ENABLE IMAGE-1 name password password_display b-OK b-quit
      477         WITH FRAME FRAME-A IN WINDOW w-login.
      478     VIEW w-login.
      479   END PROCEDURE.
