        1   block-level on error undo, throw.
        2   define input  parameter p-action as character no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: checkcnf.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: adm/checkcnf.p $":U .
        8   define variable vss-description as character no-undo init "Проверка наличия обязательных параметров, а так же загрузка любых параметров конфигурации системы".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   procedure cur-time :
       69      define output parameter p-today as date      no-undo .
       70      define output parameter p-time  as integer   no-undo .
       71     do
       72     on error undo, return error
       73     :
       74       define variable v-date1 as date      no-undo .
       75       define variable v-date2 as date      no-undo .
       76       define variable v-time  as integer   no-undo .
       77       assign
       78         v-date1 = today
       79         v-time  = time
       80         v-date2 = today
       81       .
       82       if v-date1 <> v-date2
       83       then do:
       84         assign
       85           v-date1 = today
       86           v-time  = v-time
       87         .
       88       end.
       89       assign
       90         p-today = v-date1
       91         p-time  = v-time
       92       .
       93     end.
       94   end.
       95   function cur-time-date returns character
       96   :
       97     return string(today, '99/99/9999':U) .
       98   end.
       99   function cur-time-mjd returns decimal
      100   :
      101     define variable v-date as date      no-undo .
      102     define variable v-time as integer   no-undo .
      103     run cur-time in this-procedure
      104       (output v-date
      105       ,output v-time
      106       ) .
      107     return integer(v-date) - 2400002 + (v-time / 86400) .
      108   end.
      109   function cur-time-get-ending-index returns integer
      110   (input p-number as integer
      111   )
      112   :
      113     if p-number < 0
      114     or p-number = ?
      115     then do:
      116       return 1 .
      117     end.
      118     define variable v-rest as integer   no-undo .
      119     assign
      120       p-number = p-number modulo 100
      121     .
      122     if p-number < 20
      123     then do:
      124       assign
      125         v-rest = p-number
      126       .
      127     end.
      128     else do:
      129       assign
      130         v-rest = p-number modulo 10
      131       .
      132     end.
      133     case v-rest :
      134       when 1
      135       then do:
      136         return 2 .
      137       end.
      138       when 2 or
      139       when 3 or
      140       when 4
      141       then do:
      142         return 3 .
      143       end.
      144       otherwise do:
      145         return 1 .
      146       end.
      147     end case .
      148   end.
      149   procedure cur-time-mjd-to-date :
      150      define input  parameter i-mjd-diff as decimal no-undo.
      151      define output parameter o-Date     as date    no-undo.
      152      define output parameter o-Time     as integer no-undo.
      153      define variable v-day-number as integer   no-undo .
      154      if    i-mjd-diff < 0
      155         or i-mjd-diff = ?
      156      then do:
      157         return "?" .
      158      end.
      159      assign
      160         v-day-number = truncate(i-mjd-diff,0).
      161         o-Date = date(v-day-number + 2400002).
      162         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      163     .
      164   end.
      165   function cur-time-mjd-to-string returns character
      166   (input p-mjd-diff as decimal
      167   )
      168   :
      169     define variable v-day-number as integer   no-undo .
      170     define variable v-seconds    as integer   no-undo .
      171     define variable v-hour       as integer   no-undo .
      172     define variable v-min        as integer   no-undo .
      173     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      174     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      175     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      176     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      177     if p-mjd-diff < 0
      178     or p-mjd-diff = ?
      179     then do:
      180       return "?" .
      181     end.
      182     assign
      183       v-day-number = integer(truncate(p-mjd-diff,0))
      184       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      185     .
      186     if v-seconds > 86400
      187     then do:
      188       assign
      189         v-seconds = 86400 - 1
      190       .
      191     end.
      192     if v-seconds < 0
      193     then do:
      194       assign
      195         v-seconds = 0
      196       .
      197     end.
      198     assign
      199       v-hour = truncate(v-seconds / 3600, 0)
      200     .
      201     assign
      202       v-seconds = v-seconds modulo 3600
      203     .
      204     assign
      205       v-min = truncate(v-seconds / 60, 0)
      206     .
      207     assign
      208       v-seconds = v-seconds modulo 60
      209     .
      210     return
      211         (if v-day-number <> 0
      212           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      213           else ""
      214         )
      215       + (if v-day-number <> 0 or v-hour <> 0
      216           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      217           else ""
      218         )
      219       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      220           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      221           else ""
      222         )
      223       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      224       .
      225   end.
      226   function cur-time-string returns character
      227   :
      228     define variable v-date as date      no-undo .
      229     define variable v-time as integer   no-undo .
      230     run cur-time in this-procedure
      231       (output v-date
      232       ,output v-time
      233       ) .
      234     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      235   end.
      236   function cur-time-string-sec returns character
      237   :
      238     define variable v-date as date      no-undo .
      239     define variable v-time as integer   no-undo .
      240     run cur-time in this-procedure
      241       (output v-date
      242       ,output v-time
      243       ) .
      244     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      245   end.
      246   function cur-time-custom  returns character
      247   (input p-prefix as character
      248   ,input p-date-format as character
      249   ,input p-delimiter as character
      250   ,input p-time-format as character
      251   ,input p-suffix as character
      252   )
      253   :
      254     define variable v-date as date      no-undo .
      255     define variable v-time as integer   no-undo .
      256     run cur-time in this-procedure
      257       (output v-date
      258       ,output v-time
      259       ) .
      260     return
      261       p-prefix
      262       + string(v-date, p-date-format)
      263       + p-delimiter
      264       + string(v-time, p-time-format)
      265       + p-suffix
      266       .
      267   end.
      268   function cur-time-print  returns character
      269   :
      270     define variable v-date as date      no-undo .
      271     define variable v-time as integer   no-undo .
      272     run cur-time in this-procedure
      273       (output v-date
      274       ,output v-time
      275       ) .
      276     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      277   end.
      278   function cur-time-datetime returns datetime
      279   :
      280     define variable v-char as character no-undo .
      281     define variable v-datetime as datetime no-undo .
      282     v-char = cur-time-string().
      283     v-datetime = datetime(v-char).
      284     return  v-datetime.
      285   end.
      286   function cur-time-string-msec returns character
      287   :
      288     define variable v-date as datetime  no-undo .
      289     v-date = now.
      290     return string(v-date) .
      291   end.
      292   define new shared temp-table cnf no-undo
      293       field param-code    as character   format "x(8)"        column-label "Код"                               field param-type    as character                        column-label "Тип"                               field param-value   as character   format "x(250)"      column-label "Значение"                          field param-encoded as character                        column-label "Кодированное значение"             field host-code     as integer                          column-label "Фирма"                             field obj-type      as character                        column-label "Тип объекта"                       field obj-code      as integer     format ">>>>>>"      column-label "Код объекта"                       field conf-type     as character                        column-label "Кодировка"                         field beg-date      as date                             column-label "Начало действия параметра"         field end-date      as date                             column-label "Окончание действия параметра"      field db-num        as integer     format ">>>>>"       column-label "БД"                                field stts          as integer                          column-label "Статус"
      294       field db-key        as character   format "x(12)"       column-label "Ключ БД"
      295       field param-PS      as character   format "x(40)"       column-label "PS"
      296       field param-name    as character   format "x(30)"       column-label "Название"
      297       field is-changed    as logical initial false            column-label "Изменен"
      298       field NotUsed       as logical initial False            column-label "Выключен"
      299       field ErrorExist    as integer initial 0  format ">>"   column-label "Уровень ошибки"
      300       index pi
      301         is unique
      302         param-code
      303         host-code
      304         obj-type
      305         obj-code
      306         beg-date
      307         end-date
      308         db-num
      309       index db-num
      310         db-num
      311       index db-key
      312         db-key
      313       index par-name
      314         is word-index
      315         param-name
      316       index par-value
      317         is word-index
      318         param-value
      319    .
      320   def new shared temp-table log-table no-undo
      321       field stroka       as character format "x(256)".
      322   def new shared variable err-level as integer no-undo.
      323   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      324   define new shared temp-table cnf-struct no-undo
      325     field param-code    as character
      326     field param-type    as character
      327     field data-type     as character
      328     field param-name    as character
      329     field attach-type   as character
      330     field list-value    as character
      331     field default-value as character
      332     field PS            as character
      333     field param-group   as character
      334     field user-resp     as character
      335     index by-code is unique param-code
      336   .
      337   define temp-table t_cnf-struct no-undo like cnf-struct .
      338   define stream TxtStream.
      339   define stream temp-stream .
      340   function coding-user-resp returns character
      341     ( input p-param-code as character
      342      ,input p-user-resp  as character
      343     )
      344   :
      345     return encode( p-param-code + p-user-resp ) .
      346   end function.
      347   function decoding-user-resp returns character
      348     ( input p-param-code as character
      349      ,input p-code-usr   as character
      350     )
      351   :
      352     define variable v-ind         as integer   no-undo .
      353     define variable v-user-list   as character no-undo .
      354     define variable v-num-entries as integer   no-undo .
      355     define variable v-user-resp   as character no-undo .
      356     assign
      357       v-user-list   = "Бахтадзе,Булгаков,Белоусов,Гюнтнер,Исаков,Перваков,Суслов,Уханов,Чернова,Кочетков,Степанов,Хныкин,Гридчина,Шальнев,Сливенко,Харитонов,Кирюхин,Морозов"
      358       v-num-entries = num-entries( v-user-list )
      359       v-user-resp   = "":U
      360     .
      361     block_do:
      362     do v-ind = 1 to v-num-entries :
      363       if encode( p-param-code + entry( v-ind, v-user-list ) ) = p-code-usr then do:
      364         assign
      365           v-user-resp = entry( v-ind, v-user-list )
      366         .
      367         leave block_do.
      368       end.
      369     end.
      370     if v-user-resp = "":U then do:
      371       message
      372         vss-include-info1 skip
      373         substitute( "Невозможно распознать ответственного за параметр <&1>!",  p-param-code) skip
      374         substitute( "Возможно его нет в списке." ) skip
      375         view-as alert-box error
      376       .
      377       return "unknown":U.
      378     end.
      379     else do:
      380       return v-user-resp .
      381     end.
      382   end function.
      383   function sum-enc returns character (str as character, num-rev as integer).
      384      define variable rev_incl_s as character init "" no-undo .
      385      define variable rev_incl_i as integer no-undo .
      386      define variable rev_incl_l as integer no-undo .
      387      rev_incl_l = length(str).
      388      do rev_incl_i = 1 to rev_incl_l:
      389         if rev_incl_i <= num-rev
      390           or rev_incl_l - rev_incl_i < num-rev
      391         then do:
      392           assign
      393             rev_incl_s = rev_incl_s + substr(str, rev_incl_l - rev_incl_i + 1, 1)
      394           .
      395         end.
      396         else do:
      397           assign
      398             rev_incl_s = rev_incl_s + substr(str, rev_incl_i, 1)
      399           .
      400         end.
      401      end.
      402      return rev_incl_s.
      403   end.
      404   procedure check-cfg :
      405     define input-output parameter p-param-code    as character no-undo .
      406     define input-output parameter p-param-type    as character no-undo .
      407     define input-output parameter p-data-type     as character no-undo .
      408     define input-output parameter p-param-name    as character no-undo .
      409     define input-output parameter p-attach-type   as character no-undo .
      410     define input-output parameter p-list-value    as character no-undo .
      411     define input-output parameter p-default-value as character no-undo .
      412     define input-output parameter p-param-PS      as character no-undo .
      413     define input-output parameter p-param-group   as character no-undo .
      414     define input-output parameter p-user-resp     as character no-undo .
      415     do
      416     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      417     on stop   undo, return error substitute( "&1. stop", vss-include-info1 )
      418     on endkey undo, return error substitute( "&1. endkey", vss-include-info1 )
      419     :
      420       define variable v-ind as character no-undo .
      421       assign
      422         p-param-code    = trim( p-param-code )
      423         p-param-type    = trim( p-param-type )
      424         p-data-type     = trim( p-data-type )
      425         p-param-name    = trim( p-param-name )
      426         p-attach-type   = trim( p-attach-type )
      427         p-list-value    = trim( p-list-value )
      428         p-default-value = trim( p-default-value )
      429         p-param-PS      = trim( p-param-PS )
      430         p-param-group   = trim( p-param-group )
      431         p-user-resp     = trim( p-user-resp )
      432       .
      433       if p-param-code = "":U then do:
      434         undo, return error substitute( "&1. Не задана метка параметра", vss-include-info1 ).
      435       end.
      436       if length( p-param-code ) > 8 then do:
      437         undo, return error substitute( "&1. Длина метки параметра не может превышать 8 символов (&2)", vss-include-info1, p-param-code ).
      438       end.
      439       if lookup( p-param-type, ',о,к,п':U ) = 0 then do:
      440         undo, return error substitute( '&1. Значение типа настройки "&2" не допустимо (&3)', vss-include-info1, p-param-type, p-param-code ).
      441       end.
      442       if lookup( p-param-type, 'к,п':U ) <> 0
      443         and lookup( p-attach-type, 'Нет':U ) = 0
      444       then do:
      445         undo, return error substitute( '&1. Для параметров с типом "&2" допустимы только привязки "&3" (&4)', vss-include-info1, 'к,п':U, 'Нет':U, p-param-code ).
      446       end.
      447       if p-param-name = "":U then do:
      448         undo, return error substitute( "&1. Не задано название параметра &2", vss-include-info1, p-param-code  ).
      449       end.
      450       if lookup( entry( 1, p-data-type ), "logical,integer,decimal,date,character":U ) = 0
      451         or num-entries( p-data-type ) > 2
      452         or ( num-entries( p-data-type ) = 2
      453              and entry( 2, p-data-type ) <> "list":U
      454            )
      455       then do:
      456         undo, return error substitute( "&1. Значение типа параметра &2 не допустимо (&3)", vss-include-info1, p-data-type, p-param-code ).
      457       end.
      458       if lookup( p-attach-type, 'Нет,Фирма,Объект':U ) = 0
      459       then do:
      460         undo, return error substitute( '&1. Значение привязки "&2" не допустимо (&3)', vss-include-info1, p-attach-type, p-param-code ).
      461       end.
      462     end.
      463     return.
      464   end procedure.
      465   procedure fill-cnf-struct :
      466     define input parameter p-file-name as character no-undo .
      467     do
      468     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      469     on stop   undo, return error substitute( "&1. stop", vss-workfile )
      470     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      471     :
      472       define variable v-file-name as character no-undo .
      473       define variable v-counter as integer   no-undo .
      474       define variable v-temp-fname       as character           no-undo.
      475       define variable v-last-key         as integer             no-undo .
      476       define variable v-new-line         as integer             no-undo .
      477       define variable v-read-chksum      as logical             no-undo .
      478       define variable v-md5-signature-av as character           no-undo .
      479       define variable v-md5-signature    as character           no-undo .
      480       define frame inf-cfg
      481         v-counter label "Просмотрено"
      482         with view-as dialog-box side-labels 1 columns three-d title ""
      483       .
      484       assign
      485         v-file-name = search( p-file-name )
      486       .
      487       if v-file-name = ""
      488         or v-file-name = ?
      489       then do:
      490         return error substitute( "&1. Не задан файл схемы конфигурации!", vss-include-info1 ).
      491       end.
      492       assign
      493         v-last-key         = 0
      494         v-read-chksum      = false
      495         v-md5-signature-av = "":U
      496         file-info:file-name = ".":U
      497         v-temp-fname = substitute( "&1\&2-&3-&4.tmp", file-info:full-pathname, time, etime, random( 1111111 , 9999999 ) )
      498       .
      499       input stream TxtStream from value( v-file-name ).
      500       output stream temp-stream to value(v-temp-fname) .
      501       block_read:
      502       repeat while v-last-key <> -2
      503       on error undo, return error
      504       :
      505         readkey stream TxtStream pause 0.
      506         assign
      507           v-last-key = lastkey
      508         .
      509         if chr( v-last-key ) = chr(1) then do:
      510           assign
      511             v-read-chksum = true
      512           .
      513         end.
      514         else do:
      515           if v-read-chksum = true then do:
      516             if v-last-key = 13 then do:
      517               leave block_read.
      518             end.
      519             else do:
      520               assign
      521                 v-md5-signature-av = v-md5-signature-av + chr( v-last-key )
      522               .
      523             end.
      524           end.
      525           else do:
      526             if v-last-key = 13 then do:
      527               put stream temp-stream skip(v-new-line).
      528               assign
      529                 v-new-line = 1
      530               .
      531             end.
      532             else do:
      533               put stream temp-stream unformatted chr( v-last-key ).
      534               assign
      535                 v-new-line = 0
      536               .
      537             end.
      538           end.
      539         end.
      540       end.
      541       output stream temp-stream close.
      542       input stream TxtStream close.
      543       run gbl/md5.p
      544         ( input  search( v-temp-fname )
      545          ,output v-md5-signature
      546         ) no-error.
      547       if error-status :error then do:
      548         return error substitute("Ошибка при подсчете контрольной суммы текстового файла схемы &1", v-file-name ) .
      549       end.
      550       os-delete value( v-temp-fname ).
      551       assign
      552         v-md5-signature = sum-enc( v-md5-signature, 8 )
      553       .
      554       if v-md5-signature-av <> v-md5-signature then do:
      555         return error substitute( "Некорректная контрольная сумма текстового файла схемы &1", v-file-name ) .
      556       end.
      557       input stream TxtStream from value( v-file-name ).
      558       assign
      559         v-counter = 0
      560       .
      561       assign
      562         frame inf-cfg:title = "Чтение параметров конфигурации"
      563       .
      564       view frame inf-cfg.
      565       for each t_cnf-struct:
      566         delete t_cnf-struct.
      567       end.
      568       create t_cnf-struct no-error.
      569       read-cycle:
      570       repeat transaction
      571       on error  undo, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      572       :
      573         assign
      574           v-counter = v-counter + 1
      575         .
      576         if ( v-counter modulo 10 ) = 0 then do:
      577           display
      578             v-counter
      579             with frame inf-cfg.
      580         end.
      581         import stream TxtStream delimiter '`':U t_cnf-struct.param-code t_cnf-struct.param-type t_cnf-struct.data-type t_cnf-struct.param-name t_cnf-struct.attach-type t_cnf-struct.list-value t_cnf-struct.default-value t_cnf-struct.PS t_cnf-struct.param-group t_cnf-struct.user-resp no-error.
      582         if error-status:error then do:
      583           return error substitute( "&1. Ошибка при чтении текстового файла схемы! Cтрока &1. (&2)", vss-include-info1, v-counter, error-status :get-message ( error-status :num-messages ) ).
      584         end.
      585         else do:
      586           if not ( t_cnf-struct.param-code begins chr(1) ) then do:
      587             assign
      588               t_cnf-struct.user-resp = decoding-user-resp( t_cnf-struct.param-code, t_cnf-struct.user-resp )
      589             .
      590             if t_cnf-struct.user-resp = "unknown":U then do:
      591               return error substitute( "&1. Ошибка параметра! Cтрока &2.", vss-include-info1, v-counter ).
      592             end.
      593             run check-cfg in this-procedure
      594               ( input-output t_cnf-struct.param-code
      595               ,input-output t_cnf-struct.param-type
      596               ,input-output t_cnf-struct.data-type
      597               ,input-output t_cnf-struct.param-name
      598               ,input-output t_cnf-struct.attach-type
      599               ,input-output t_cnf-struct.list-value
      600               ,input-output t_cnf-struct.default-value
      601               ,input-output t_cnf-struct.PS
      602               ,input-output t_cnf-struct.param-group
      603               ,input-output t_cnf-struct.user-resp
      604               ) no-error .
      605             if error-status :error then do:
      606               return error substitute( "&1. Ошибка параметра! Cтрока &2. &3 (&4)", vss-include-info1, v-counter, return-value, error-status :get-message ( error-status :num-messages ) ).
      607             end.
      608             else do:
      609               find first cnf-struct
      610                 where cnf-struct.param-code = t_cnf-struct.param-code
      611                 no-error
      612               .
      613               if not available cnf-struct then do:
      614                 create cnf-struct .
      615               end.
      616               buffer-copy t_cnf-struct to cnf-struct .
      617             end.
      618           end.
      619         end.
      620       end.
      621       delete t_cnf-struct no-error.
      622       hide frame inf-cfg.
      623       input stream TxtStream close.
      624     end.
      625     return.
      626   end procedure.
      627   define new global shared variable g#library  as handle no-undo .
      628   define new global shared variable g#library2 as handle no-undo .
      629   define new  shared variable g#auto as logical no-undo.
      630   define new  shared variable g#news as logical no-undo.
      631   define new  shared variable g#oxml as logical no-undo.
      632   define new  shared variable g#esys as logical no-undo.
      633   define new  shared variable g#news-source-db as integer no-undo.
      634   define new  shared variable g#esys-source-esys as integer no-undo.
      635   define new  shared variable g#db-num as integer   no-undo .
      636   define new  shared variable g#userid as character no-undo .
      637   define new  shared variable g#passwd as character no-undo .
      638   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      639   procedure get-ro_get-read-only :
      640     define output parameter p-ro-set as logical   no-undo .
      641     do
      642     on error  undo, return error substitute( "&1(get-ro_get-read-only). &2&3&4", vss-include-info2, return-value, error-status :get-message( 1 ) )
      643     on stop   undo, return error substitute( "&1(get-ro_get-read-only). stop", vss-include-info2 )
      644     on endkey undo, return error substitute( "&1(get-ro_get-read-only). endkey", vss-include-info2 )
      645     :
      646       if lookup( 'READ-ONLY':U, DBRESTRICTIONS('ub':U) ) > 0
      647       then do:
      648         assign
      649           p-ro-set = true
      650         .
      651       end.
      652       else do:
      653         assign
      654           p-ro-set = false
      655         .
      656       end.
      657     end.
      658   end procedure.
      659   do
      660   on error  undo, return error
      661   :
      662     define variable v-ind            as integer       no-undo .
      663     define variable v-start-time     as int64         no-undo .
      664     define variable v-current-time   as character     no-undo .
      665     define variable w-login          as widget-handle no-undo.
      666     define buffer buf_config  for ub.config .
      667     define buffer buf1_config for ub.config .
      668     define stream txt-file .
      669     define stream necescnf .
      670     define stream del-cnf .
      671     define variable counter       as integer                   no-undo .
      672     define variable p-value       like ub.config.param-value      no-undo .
      673     define variable p-type        like ub.config.param-type       no-undo .
      674     define variable err-cnf-param as char                      no-undo .
      675     define variable err-log       as logical                   no-undo .
      676     define variable err-code      as integer init -1           no-undo .
      677     define variable load-cfg-now  as logical init TRUE         no-undo .
      678     define variable fname-txt     as char                      no-undo .
      679     define variable fname-cfg     as char    init "config.cfg" no-undo .
      680     define variable str-hdl       as handle                    no-undo .
      681     define variable v-curr-db          as integer   no-undo .
      682     define variable v-check-db-num     as integer   no-undo .
      683     define variable v-check-user-id    as character no-undo .
      684     define variable v-check-user-admin as logical   no-undo .
      685     define variable v-get-ro_read-only as logical   no-undo .
      686     define frame a
      687       v-ind           format ">>>>>>>9"   label "Обработано параметров" skip
      688       v-current-time  format "x(8)"       label "Время" skip
      689       with view-as dialog-box side-labels three-d
      690       title "Проверка конфигурационных параметров"
      691       .
      692     if p-action <> "cfg-check":U
      693       and p-action <> "cfg-load":U
      694     then do:
      695       message
      696         vss-workfile vss-revision vss-description skip
      697         substitute("Ошибка задания входных параметров.") skip
      698         substitute("action = &1", p-action ) skip
      699         view-as alert-box error .
      700       return error.
      701     end.
      702     assign
      703       v-get-ro_read-only = false
      704     .
      705     run get-ro_get-read-only in this-procedure
      706       ( output v-get-ro_read-only
      707       ) .
      708   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      709   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run getcurus in g#library2
      710     (output v-check-db-num
      711     ,output v-check-user-id
      712     ) no-error .
      713     if error-status :error then do:
      714       message
      715         vss-workfile vss-revision vss-description skip
      716         "Ошибка при определении текущей базы и текущего пользователя" skip
      717         error-status :get-message(1) skip
      718         return-value skip
      719         view-as alert-box error .
      720       undo, return error return-value .
      721     end.
      722     assign
      723       v-curr-db = v-check-db-num
      724     .
      725   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      726   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run user-adm in g#library2
      727     (input  v-check-db-num
      728     ,input  v-check-user-id
      729     ,output v-check-user-admin
      730     ) no-error .
      731     if error-status :error then do:
      732       message
      733         vss-workfile vss-revision vss-description skip
      734         "Ошибка при определении является ли пользователем администратор" skip
      735         error-status :get-message(1) skip
      736         return-value skip
      737         view-as alert-box error .
      738       undo, return error return-value .
      739     end.
      740     create widget-pool .
      741     create window w-login
      742       assign
      743         title              = "Проверка параметров"
      744         column             = 31.5
      745         row                = 9
      746         height             = 2.0
      747         width              = 30
      748         resize             = false
      749         scroll-bars        = false
      750         status-area        = false
      751         three-d            = true
      752         message-area       = false
      753         sensitive          = true
      754         visible            = true
      755         .
      756     assign
      757       current-window   = w-login
      758       g#auto           = false
      759       g#news           = false
      760       g#news-source-db = -1
      761       g#db-num         = v-curr-db
      762       g#userid         = v-check-user-id
      763       g#passwd         = ""
      764     .
      765     if p-action <> "cfg-load":U then do:
      766       assign
      767         v-start-time = etime
      768       .
      769       view frame a.
      770       display
      771         v-ind
      772         v-current-time
      773         with frame a .
      774       run adm/cnf-str.p persistent set str-hdl no-error.
      775       if not valid-handle (str-hdl)  then do:
      776         message "Ошибка при попытке инициализировать работу со схемой конфигурации" view-as alert-box error.
      777         return error.
      778       end.
      779       for each cnf-struct
      780       on error undo, return error
      781       :
      782         delete cnf-struct.
      783       end.
      784       os-delete value( "necescnf.txt":U ) .
      785       assign
      786         fname-txt = "cmp/mold_db.sch"
      787       .
      788       if search( fname-txt ) = ? then do:
      789         message "Не найден файл схемы настроек" + chr(32) + fname-txt view-as alert-box error.
      790         return error.
      791       end.
      792       assign
      793         fname-txt = search( fname-txt )
      794       .
      795     end.
      796     assign
      797       err-code = -1
      798       load-cfg-now = true
      799       .
      800     do while err-code <> 0 and load-cfg-now = true
      801     :
      802       assign
      803         v-ind         = 0
      804         err-cnf-param = ""
      805       .
      806       if p-action <> "cfg-load":U then do:
      807         run fill-cnf-struct in this-procedure
      808           ( input fname-txt
      809           ) no-error.
      810         if error-status :error then do:
      811           message
      812             vss-workfile vss-revision vss-description skip
      813             substitute( "Ошибка при чтении текстового файла схемы!" ) skip
      814             return-value skip
      815             error-status :get-message ( error-status :num-messages )
      816             view-as alert-box error
      817           .
      818           return error.
      819         end.
      820         for each cnf-struct no-lock
      821         on error undo, return error
      822         :
      823           assign
      824             v-ind = v-ind + 1
      825           .
      826           if v-ind mod 10 = 0 then do:
      827             assign
      828               v-current-time = string(integer(truncate((etime - v-start-time) / 1000, 0)), 'HH:MM:SS':U)
      829             .
      830             display
      831               v-ind
      832               v-current-time
      833               with frame a.
      834           end.
      835           assign
      836             err-log = false
      837           .
      838           find first buf_config no-lock
      839             where buf_config.param-code = cnf-struct.param-code
      840               and buf_config.db-num     = v-curr-db
      841             no-error .
      842           if available buf_config then do:
      843             run cnv-param-type in str-hdl (cnf-struct.data-type).
      844             assign
      845               cnf-struct.data-type = return-value
      846             .
      847             if lookup(cnf-struct.param-type, 'к,п':U) > 0
      848             then do:
      849   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      850     (input  buf_config.param-code
      851     ,input  '':U
      852     ,input  '':U
      853     ,input  0
      854     ,input  '':U
      855     ,input  '':U
      856     ,input  '':U
      857     ,input  no
      858     ,output p-value
      859     ,output p-type
      860     ) no-error .
      861               if error-status :error
      862               or buf_config.param-type <> cnf-struct.data-type
      863               or buf_config.conf-type  <> cnf-struct.param-type
      864               then do:
      865                 assign
      866                   err-log = true
      867                 .
      868               end.
      869             end.
      870             for each buf1_config no-lock
      871                 where buf1_config.param-code = cnf-struct.param-code
      872                   and buf1_config.db-num     = v-curr-db
      873             on error undo, return error
      874             :
      875   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      876     (input  buf1_config.param-code
      877     ,input  buf1_config.host-code
      878     ,input  buf1_config.obj-type
      879     ,input  buf1_config.obj-code
      880     ,input  '':U
      881     ,input  '':U
      882     ,input  '':U
      883     ,input  no
      884     ,output p-value
      885     ,output p-type
      886     ) no-error .
      887               if error-status:error
      888                 or buf1_config.param-type <> cnf-struct.data-type
      889                 or buf1_config.conf-type  <> cnf-struct.param-type
      890               then do:
      891                 assign
      892                   err-log = true
      893                 .
      894               end.
      895             end.
      896           end.
      897           else do:
      898             if lookup(cnf-struct.param-type, 'к,о':U) > 0
      899             then do:
      900               assign
      901                 err-log = true
      902               .
      903             end.
      904           end.
      905           if err-log then do:
      906             run write-err-conf-list in this-procedure
      907               ( input cnf-struct.param-code
      908               ,input v-curr-db
      909               ,input cnf-struct.param-type
      910               ,input err-cnf-param
      911               ).
      912             assign
      913               err-cnf-param = err-cnf-param + " ":U + cnf-struct.param-code
      914               .
      915           end.
      916         end.
      917         for each cnf-struct
      918         on error undo, return error
      919         :
      920           delete cnf-struct.
      921         end.
      922       end.
      923       if v-get-ro_read-only = false then do:
      924         if p-action = "cfg-load":U then do:
      925           assign
      926             load-cfg-now = true
      927           .
      928         end.
      929         else do:
      930           if trim( err-cnf-param ) <> "":U then do:
      931             if v-check-user-admin <> true then do:
      932               message
      933                 "Требуется загрузка параметров конфигурации системы!" skip
      934                 "Список требуемых параметров выведен в файл" chr(32) "necescnf.txt":U skip
      935                 "Обратитесь к администратору системы."
      936                 view-as alert-box error.
      937               assign
      938                 err-code     = 3
      939                 load-cfg-now = false
      940               .
      941             end.
      942             else do:
      943               message
      944                 "Требуется загрузка параметров конфигурации системы!" skip
      945                 "Список требуемых параметров выведен в файл" chr(32) "necescnf.txt":U skip
      946                 "Список удаленных параметров выведен в файл" chr(32) "del-cnf.txt":U skip
      947                 "Загрузить параметры сейчас?" skip
      948                 view-as alert-box question buttons yes-no update load-cfg-now.
      949               if load-cfg-now <> true then do:
      950                 assign
      951                   err-code = 3
      952                 .
      953               end.
      954             end.
      955           end.
      956           else do:
      957             assign
      958               err-code = 0
      959               load-cfg-now = false
      960             .
      961           end.
      962         end.
      963       end.
      964       else do:
      965         assign
      966           load-cfg-now = false
      967         .
      968         if trim( err-cnf-param ) <> "":U then do:
      969           assign
      970             err-code = 3
      971           .
      972           message
      973             "В ОСНОВНУЮ БД требуется загрузить параметры конфигурации системы!" skip
      974             "Список требуемых параметров выведен в файл" chr(32) "necescnf.txt":U skip
      975             "Обратитесь к администратору системы."
      976             view-as alert-box error.
      977         end.
      978         else do:
      979           assign
      980             err-code = 0
      981           .
      982         end.
      983       end.
      984       if load-cfg-now = true then do:
      985         run adm/wloadcfg.w (input-output fname-cfg).
      986         if fname-cfg <> ""
      987           and fname-cfg <> ?
      988           and fname-cfg <> "?"
      989         then do:
      990           run adm/loadcfg.p (fname-cfg, "", "", yes, no, yes, 2, output err-code) no-error.
      991           if error-status:error then do:
      992             message error-status:get-message(1).
      993           end.
      994           if err-code = 0 then do:
      995             assign
      996               err-code = -1
      997             .
      998             message
      999               "Параметры загружены успешно"
     1000               view-as alert-box information .
     1001           end.
     1002           else do:
     1003             message
     1004               "Параметры не загружены!" skip
     1005               "Код завершения: " err-code
     1006                view-as alert-box error .
     1007           end.
     1008         end.
     1009         else do:
     1010           message
     1011             "Параметры не загружены!" skip
     1012             "Не задан файл конфигурации." skip
     1013             view-as alert-box error .
     1014           assign
     1015             err-code     = 1
     1016             load-cfg-now = false
     1017             .
     1018         end.
     1019       end.
     1020       if p-action = "cfg-load":U then do:
     1021         assign
     1022           err-code     = 0
     1023           load-cfg-now = false
     1024         .
     1025       end.
     1026     end.
     1027     if p-action <> "cfg-load":U then do:
     1028       run kill1 in str-hdl .
     1029     end.
     1030     hide frame a .
     1031     delete object w-login .
     1032   end.
     1033   if err-code <> 0 then do:
     1034     return error.
     1035   end.
     1036   else do:
     1037     return.
     1038   end.
     1039   procedure write-err-conf-list :
     1040     define input parameter par-code      like ub.config.param-code no-undo .
     1041     define input parameter p-db-num      like ub.config.db-num     no-undo .
     1042     define input parameter cnf-type      like ub.config.conf-type  no-undo .
     1043     define input parameter err-cnf-param as   character            no-undo .
     1044     do transaction
     1045     on error undo, return error
     1046     :
     1047       define variable p-code      like ub.config.param-code no-undo .
     1048       define variable list-p-code as   character            no-undo .
     1049       define variable ind         as   integer              no-undo .
     1050       define buffer buf_sys-ctrl for ub.sys-ctrl .
     1051       define buffer buf_db       for ub.db .
     1052       define buffer buf_config   for ub.config .
     1053       assign
     1054         list-p-code = par-code
     1055       .
     1056       do ind = 1 to num-entries( list-p-code )
     1057       on error undo, return error
     1058       :
     1059         assign
     1060           p-code = entry( ind, list-p-code )
     1061         .
     1062         if v-check-user-admin = true
     1063         then do:
     1064           output stream del-cnf to "del-cnf.txt":U page-size 0 append.
     1065           for each buf_config exclusive-lock
     1066             where buf_config.param-code = p-code
     1067               and buf_config.db-num     = p-db-num
     1068           on error undo, return error
     1069           :
     1070             if err-cnf-param = "":U then do:
     1071               put stream del-cnf unformatted
     1072                 string("Дата удаления:" + " ":U + cur-time-string() )
     1073                 skip
     1074               .
     1075             end.
     1076             export stream del-cnf buf_config .
     1077             assign
     1078               buf_config.stts = -1
     1079             .
     1080             delete buf_config .
     1081           end.
     1082           output stream del-cnf close.
     1083         end.
     1084         if err-cnf-param = "":U then do:
     1085           output stream necescnf to "necescnf.txt":U.
     1086           find first buf_sys-ctrl no-lock.
     1087           find first buf_db no-lock
     1088               where buf_db.db-num = buf_sys-ctrl.db-num
     1089               .
     1090           put stream necescnf unformatted
     1091             string("Дата:" + " ":U + cur-time-string() )
     1092             skip
     1093             string("db: ":U + string(buf_db.db-num) + " db-name: ":U + buf_db.db-name + " db-key: ":U + buf_db.db-key )
     1094             skip
     1095           .
     1096         end.
     1097         else do:
     1098           output stream necescnf to "necescnf.txt":U page-size 0 append.
     1099         end.
     1100         put stream necescnf unformatted p-code space(1) cnf-type skip.
     1101         output stream necescnf close.
     1102       end.
     1103     end.
     1104   end procedure.
