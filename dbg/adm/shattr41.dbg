     1635   line
     1636   index isdone
     1637   done
     1638   .
     1639   DEFINE VARIABLE v-db-num LIKE ub.db.db-num NO-UNDO.
     1640   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO.
     1641   DEFINE VARIABLE v-to-create AS logical NO-UNDO.
     1642   DEFINE VARIABLE v-host-code LIKE ub.shop.host-code NO-UNDO.
     1643   DEFINE VARIABLE v-base-code LIKE ub.sysconf.base-code NO-UNDO.
     1644   DEFINE VARIABLE v-r-b-code LIKE ub.currency.curr-code NO-UNDO.
     1645   DEFINE VARIABLE specgrp-option AS INTEGER NO-UNDO.
     1646   DEFINE BUFFER buf_currency FOR ub.currency.
     1647   DEFINE BUFFER buf_cash-pay-nal FOR ub.cash-pay.
     1648   DEFINE BUFFER buf_cash-pay-ntnl FOR ub.cash-pay.
     1649   define BUFFER buf_cli-grp FOR ub.cli-grp.
     1650   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
     1651   define variable v-tth as handle no-undo .
     1652   assign
     1653   v-tth = buffer thbjattr_thbj-attr:table-handle .
     1654   DEFINE MENU MENU-B-add-2
     1655          MENU-ITEM m_50           LABEL "Услуги"
     1656          MENU-ITEM m_24           LABEL "Перечисление в систему лояльности".
     1657   DEFINE BUTTON B-add-2  NO-FOCUS
     1658        LABEL "&Добавить"
     1659        SIZE 10 BY 1.
     1660   DEFINE BUTTON b-chg
     1661        LABEL "&Изменить"
     1662        SIZE 10 BY 1.
     1663   DEFINE BUTTON B-del-2
     1664        LABEL "&Удалить"
     1665        SIZE 10 BY 1.
     1666   DEFINE BUTTON B-exit AUTO-GO
     1667        LABEL "&Ввод"
     1668        SIZE 10 BY 1
     1669        BGCOLOR 8 .
     1670   DEFINE BUTTON B-Help
     1671        LABEL "Помо&щь"
     1672        SIZE 10 BY 1
     1673        BGCOLOR 8 .
     1674   DEFINE BUTTON B-no-ok
     1675        LABEL "Отмена"
     1676        SIZE 10 BY 1.
     1677   DEFINE BUTTON B-ok
     1678        LABEL "Ввод"
     1679        SIZE 10 BY 1.
     1680   DEFINE BUTTON b-quit AUTO-END-KEY
     1681        LABEL "&Отмена"
     1682        SIZE 10 BY 1
     1683        BGCOLOR 8 .
     1684   DEFINE VARIABLE t-ibmgroup AS LOGICAL INITIAL no
     1685        LABEL "прием чеков с продажами по группам"
     1686        VIEW-AS TOGGLE-BOX
     1687        SIZE 38.6 BY 1 NO-UNDO.
     1688   DEFINE QUERY BR-cash-pay FOR
     1689         tt-cash-pay-autotank SCROLLING.
     1690   DEFINE QUERY BR-specgrp FOR
     1691         tt-sum-grp SCROLLING.
     1692   DEFINE BROWSE BR-cash-pay
     1693     QUERY BR-cash-pay NO-LOCK DISPLAY
     1694         autotank-cdpay-code COLUMN-LABEL "Код платежа!autotank" FORMAT ">>>>9":U
     1695         tt-cash-pay-autotank.cdpay-code COLUMN-LABEL "Код платежа!IBS TH" FORMAT ">>>9":U
     1696         tt-cash-pay-autotank.curr-code COLUMN-LABEL "Код валюты!IBS TH" FORMAT ">>9":U
     1697         autotank-obj-name COLUMN-LABEL "Название типа!кассового платежа!AUTOTANK" FORMAT "X(27)":U
     1698         tt-cash-pay-autotank.obj-name COLUMN-LABEL "Название типа!кассового платежа!IBS TH" FORMAT "X(30)":U
     1699               WIDTH 34.8
     1700       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.62
     1701            TITLE "Соответствие кодов типов кассовых платежей" FIT-LAST-COLUMN.
     1702   DEFINE BROWSE BR-specgrp
     1703     QUERY BR-specgrp NO-LOCK DISPLAY
     1704         tt-sum-grp.grp-code COLUMN-LABEL "Код группы" FORMAT "99":U
     1705         tt-sum-grp.grp-name COLUMN-LABEL "Описание" FORMAT "X(40)":U
     1706         code-2 COLUMN-LABEL "Код товара" FORMAT "999999999":U WIDTH 40.2
     1707       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 8.57
     1708            TITLE "Спецгруппы в справочнике суммовых групп" FIT-LAST-COLUMN.
     1709   DEFINE FRAME Dialog-Frame
     1710        B-add-2 AT ROW 11.48 COL 51 WIDGET-ID 4
     1711        B-exit AT ROW 1 COL 1
     1712        b-quit AT ROW 1 COL 11
     1713        B-Help AT ROW 1 COL 71
     1714        b-chg AT ROW 2 COL 71 WIDGET-ID 2
     1715        BR-cash-pay AT ROW 3 COL 1
     1716        B-ok AT ROW 10.62 COL 79
     1717        B-no-ok AT ROW 10.62 COL 89
     1718        t-ibmgroup AT ROW 11.48 COL 2
     1719        B-del-2 AT ROW 11.48 COL 61 WIDGET-ID 6
     1720        BR-specgrp AT ROW 12.67 COL 1 WIDGET-ID 100
     1721        SPACE(0.59) SKIP(0.13)
     1722       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1723            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1724            TITLE "Параметры POS Касса autotank"
     1725            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     1726   ASSIGN
     1727          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1728          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1729   ASSIGN
     1730          B-add-2:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-add-2:HANDLE.
     1731   ASSIGN
     1732          B-no-ok:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1733   ASSIGN
     1734          B-ok:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1735   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1736   DO:
     1737     APPLY "END-ERROR":U TO SELF.
     1738   END.
     1739   ON CHOOSE OF B-add-2 IN FRAME Dialog-Frame
     1740   DO:
     1741     IF specgrp-option = 0 THEN DO:
     1742       run gbl/pop-up.p ( INPUT self:handle, INPUT yes) NO-ERROR.
     1743     END.
     1744     IF specgrp-option = 0  THEN RETURN NO-APPLY.
     1745     RUN proc-b-add-2 IN THIS-PROCEDURE ( INPUT specgrp-option) NO-ERROR.
     1746     IF ERROR-STATUS:ERROR THEN do:
     1747         specgrp-option = 0.
     1748          RETURN NO-APPLY.
     1749     END.
     1750   END.
     1751   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     1752   DO:
     1753     IF NOT AVAILABLE tt-cash-PAY-autotank THEN DO:
     1754       RETURN NO-APPLY.
     1755     END.
     1756     RUN proc-b-chg IN THIS-PROCEDURE NO-ERROR.
     1757     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1758   END.
     1759   ON CHOOSE OF B-del-2 IN FRAME Dialog-Frame
     1760   DO:
     1761     IF NOT AVAILABLE tt-sum-grp THEN RETURN NO-APPLY.
     1762     DELETE tt-sum-grp.
     1763     OPEN QUERY BR-specgrp FOR EACH tt-sum-grp NO-LOCK INDEXED-REPOSITION.
     1764     REPOSITION br-specgrp TO ROW 1.
     1765   END.
     1766   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1767   DO:
     1768     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
     1769     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1770   END.
     1771   ON CHOOSE OF B-no-ok IN FRAME Dialog-Frame
     1772   DO:
     1773   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1774   if lookup(self :type
     1775            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1776            ) = 0
     1777   then do:
     1778     message
     1779       "$Workfile$"
     1780       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1781       "Интерфейсный элемент" self :name  skip
     1782       "Тип" self :type  skip
     1783       "Процедура" this-procedure :file-name skip
     1784       view-as alert-box .
     1785   end.
     1786   else do:
     1787     apply "entry":u to self  .
     1788     if focus :handle <> self :handle  then do:
     1789       return no-apply .
     1790     end.
     1791   end.
     1792     RUN proc-b-no-ok IN THIS-PROCEDURE.
     1793   END.
     1794   ON CHOOSE OF MENU-ITEM m_24
     1795   DO:
     1796     ASSIGN
     1797     specgrp-option = 24.
     1798     RUN proc-b-add-2 IN THIS-PROCEDURE ( INPUT specgrp-option) NO-ERROR.
     1799     IF ERROR-STATUS:ERROR THEN DO:
     1800         specgrp-option = 0.
     1801         RETURN NO-APPLY.
     1802     END.
     1803   END.
     1804   ON CHOOSE OF MENU-ITEM m_50
     1805   DO:
     1806     ASSIGN
     1807     specgrp-option = 50.
     1808     RUN proc-b-add-2 IN THIS-PROCEDURE ( INPUT specgrp-option) NO-ERROR.
     1809     IF ERROR-STATUS:ERROR THEN DO:
     1810         specgrp-option = 0.
     1811         RETURN NO-APPLY.
     1812     END.
     1813   END.
     1814   ON VALUE-CHANGED OF t-ibmgroup IN FRAME Dialog-Frame
     1815   DO:
     1816    ASSIGN
     1817    t-ibmgroup.
     1818     CASE t-ibmgroup:
     1819       WHEN YES  THEN DO:
     1820         if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     1821            ENABLE
     1822            b-add-2
     1823            b-del-2
     1824            WITH FRAME Dialog-Frame.
     1825         end.
     1826       END.
     1827       WHEN NO THEN DO:
     1828         FOR EACH tt-sum-grp:
     1829             DELETE tt-sum-grp.
     1830         END.
     1831         DISABLE
     1832         b-add-2
     1833         b-del-2
     1834         WITH FRAME Dialog-Frame.
     1835         OPEN QUERY BR-specgrp FOR EACH tt-sum-grp NO-LOCK INDEXED-REPOSITION.
     1836       END.
     1837     END CASE.
     1838   END.
     1839   ON CHOOSE OF MENU-ITEM m_50
     1840   DO:
     1841     ASSIGN
     1842     specgrp-option = 50.
     1843     RUN proc-b-add-2 IN THIS-PROCEDURE ( INPUT specgrp-option) NO-ERROR.
     1844     IF ERROR-STATUS:ERROR THEN DO:
     1845         specgrp-option = 0.
     1846         RETURN NO-APPLY.
     1847     END.
     1848   END.
     1849   ON CHOOSE OF MENU-ITEM m_24
     1850   DO:
     1851     ASSIGN
     1852     specgrp-option = 24.
     1853     RUN proc-b-add-2 IN THIS-PROCEDURE ( INPUT specgrp-option) NO-ERROR.
     1854     IF ERROR-STATUS:ERROR THEN DO:
     1855         specgrp-option = 0.
     1856         RETURN NO-APPLY.
     1857     END.
     1858   END.
     1859   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1860   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1861   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1862   on help of frame Dialog-Frame
     1863   do:
     1864     run gbl/app_help.p
     1865       (input this-procedure :file-name
     1866       ,input ''
     1867       ,input ?
     1868       ) no-error.
     1869     if error-status :error then do:
     1870       message
     1871         "Ошибка при вызове помощи"
     1872         error-status :get-message(1)
     1873         view-as alert-box .
     1874     end.
     1875   end.
     1876   run minbtn-set in this-procedure .
     1877   on choose of b-help in frame Dialog-Frame
     1878   do:
     1879     apply "help":u to frame Dialog-Frame .
     1880   end.
     1881   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1882   procedure minbtn-set :
     1883       do
     1884           on error undo, return error return-value
     1885           :
     1886           define variable ii              as integer       no-undo .
     1887           define variable fh              as widget-handle no-undo .
     1888           define variable hh              as widget-handle no-undo .
     1889           define variable v-h             as handle        extent 4 no-undo .
     1890           define variable v-name-button   as character     no-undo .
     1891           define variable v-help-old-x    as decimal       no-undo .
     1892           define variable v-help-old-y    as decimal       no-undo .
     1893           define variable v-help-old-size as decimal       no-undo .
     1894           define variable v-frame-width   as decimal       no-undo .
     1895           define variable jj              as integer       no-undo .
     1896           do
     1897               on error undo, return error
     1898               :
     1899               assign
     1900                   v-frame-width = frame Dialog-Frame:width - 0.3
     1901                   fh            = frame Dialog-Frame:first-child
     1902                   hh            = fh:first-child
     1903                   ii            = 1
     1904                   .
     1905               do while valid-handle(hh):
     1906                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1907                   do:
     1908                       case lc(hh:name) :
     1909                           when "b-help" then
     1910                               do:
     1911                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1912                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1913                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1914                                   hh:TOOLTIP = "Помощь" .
     1915                                   v-help-old-x = hh:column .
     1916                                   v-help-old-y = hh:row    .
     1917                                   v-help-old-size = hh:width .
     1918                                   hh:width-chars = 2.5 .
     1919                               end.
     1920                           when "b-print" then
     1921                               do:
     1922                                   hh:load-image("cmp/b-print.bmp":u) .
     1923                                   hh:TOOLTIP = "Печать" .
     1924                                   v-h[ii] = hh:handle .
     1925                                   ii = ii + 1 .
     1926                                   hh:width-chars = 3 .
     1927                               end.
     1928                           when "b-history" or
     1929                           when "b-hist" then
     1930                               do:
     1931                                   hh:load-image("cmp/b-hist.bmp":u) .
     1932                                   hh:TOOLTIP = "История" .
     1933                                   v-h[ii] = hh:handle .
     1934                                   ii = ii + 1 .
     1935                                   hh:width-chars = 3 .
     1936                               end.
     1937                           when "b-sch" then
     1938                               do:
     1939                                   hh:load-image("cmp/b-sch.bmp":u) .
     1940                                   hh:TOOLTIP = "Установка Фильтра" .
     1941                                   v-h[ii] = hh:handle .
     1942                                   ii = ii + 1 .
     1943                                   hh:width-chars = 3 .
     1944                               end.
     1945                           when "b-hist-user" then
     1946                               do:
     1947                                   hh:load-image("cmp/b-hist.bmp":u) .
     1948                                   hh:TOOLTIP = "История пользователя" .
     1949                                   ii = ii + 1 .
     1950                               end.
     1951                       end case.
     1952                   end.
     1953                   hh = hh:next-sibling.
     1954               end.
     1955               b-help:column = v-frame-width - b-help:width-chars.
     1956               jj = 0.
     1957               repeat ii = 4 to 1 by -1 :
     1958                   if valid-handle (v-h[ii] ) then
     1959                   do:
     1960                       jj  = jj + 1 .
     1961                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1962                       v-h[ii]:row    = v-help-old-y .
     1963                   end.
     1964               end.
     1965           end.
     1966       end.
     1967   end procedure.
     1968   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1969   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1970   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1971   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1972   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1973   define variable v-diasize-current-frame-height as decimal   no-undo .
     1974   define variable v-diasize-change-size          as logical   no-undo .
     1975   define variable v-diasize-resize-button        as handle    no-undo .
     1976   define variable v-diasize-wndmax               as logical   no-undo .
     1977   define variable v-diasize-wndstore             as logical   no-undo .
     1978   define variable v-diasize-proc-name            as character no-undo .
     1979   define variable v-diasize-browse-handle        as handle    no-undo .
     1980   define variable v-diasize-browse-number        as integer   no-undo .
     1981   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1982   define temp-table temp-diasize-handle no-undo
     1983     field handle-value  as handle
     1984     field save-position as decimal
     1985     index xpk is primary unique handle-value
     1986     .
     1987   define temp-table temp-browse-handle no-undo
     1988     field browse-type   as character
     1989     field browse-number as integer
     1990     field browse-handle as handle
     1991     field original-size as decimal
     1992     index xpk is primary unique browse-type browse-number
     1993     index xie browse-type browse-handle
     1994   .
     1995   procedure diasize_change-height :
     1996     define input  parameter p-change-value  as decimal   no-undo .
     1997     define input  parameter p-move-resize   as logical   no-undo .
     1998     define variable v-field-group-handle    as handle    no-undo .
     1999     define variable v-object-handle         as handle    no-undo .
     2000     define variable v-frame-height          as decimal   no-undo .
     2001     define variable v-frame-virtual-height  as decimal   no-undo .
     2002     define variable v-browse-height         as decimal   no-undo .
     2003     define variable v-window-height         as decimal   no-undo .
     2004     define variable v-window-virtual-height as decimal   no-undo .
     2005     define variable v-change-sign           as integer   no-undo .
     2006     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2007     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2008     if p-change-value > 0
     2009     then do:
     2010       if frame Dialog-Frame :height + p-change-value
     2011           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2012       then do:
     2013         assign
     2014           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2015                           - (frame Dialog-Frame :height-chars)
     2016         .
     2017         if p-change-value <= 0
     2018         then do:
     2019           run diasize_position-resize-button in this-procedure .
     2020           return .
     2021         end.
     2022       end.
     2023     end.
     2024     if p-change-value < 0
     2025     then do:
     2026       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2027       then do:
     2028         assign
     2029           p-change-value = v-diasize-orig-frame-height
     2030                          - (frame Dialog-Frame :height-chars)
     2031         .
     2032         if p-change-value >= 0
     2033         then do:
     2034           run diasize_position-resize-button in this-procedure .
     2035           return .
     2036         end.
     2037       end.
     2038     end.
     2039     if p-change-value >= 0
     2040     then do:
     2041       assign
     2042         v-change-sign = 1
     2043       .
     2044     end.
     2045     else do:
     2046       assign
     2047         v-change-sign = -1
     2048       .
     2049     end.
     2050     assign
     2051       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2052     .
     2053     if p-change-value = 0
     2054     then do:
     2055       run diasize_position-resize-button in this-procedure .
     2056       return .
     2057     end.
     2058     move_block:
     2059     do
     2060     on error undo move_block, retry move_block
     2061     :
     2062       if retry
     2063       then do:
     2064         do
     2065         on error undo move_block, leave move_block
     2066         :
     2067           if p-change-value > 0
     2068           then do:
     2069             for each buf_temp-diasize-handle
     2070             on error undo, next
     2071             :
     2072               assign
     2073                 v-object-handle = buf_temp-diasize-handle.handle-value
     2074               .
     2075               if v-object-handle <> v-diasize-resize-button
     2076               then do:
     2077                 assign
     2078                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2079                 .
     2080               end.
     2081             end.
     2082             assign
     2083               v-diasize-browse-handle :height = v-browse-height
     2084             .
     2085             for each buf_temp-browse-handle
     2086               where buf_temp-browse-handle.browse-type = 'height':u
     2087             on error undo, next
     2088             :
     2089               assign
     2090                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2091               .
     2092             end.
     2093             assign
     2094               frame Dialog-Frame :height = v-frame-height
     2095             .
     2096             if frame Dialog-Frame :scrollable = true
     2097             then do:
     2098               assign
     2099                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2100               .
     2101             end.
     2102             run diasize_position-resize-button in this-procedure .
     2103           end.
     2104           else do:
     2105             if frame Dialog-Frame :scrollable = true
     2106             then do:
     2107               assign
     2108                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2109               .
     2110             end.
     2111             assign
     2112               frame Dialog-Frame :height = v-frame-height
     2113             .
     2114             assign
     2115               v-diasize-browse-handle :height = v-browse-height
     2116             .
     2117             for each buf_temp-browse-handle
     2118               where buf_temp-browse-handle.browse-type = 'height':u
     2119             on error undo, next
     2120             :
     2121               assign
     2122                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2123               .
     2124             end.
     2125             for each buf_temp-diasize-handle
     2126             on error undo, next
     2127             :
     2128               assign
     2129                 v-object-handle = buf_temp-diasize-handle.handle-value
     2130               .
     2131               if v-object-handle <> v-diasize-resize-button
     2132               then do:
     2133                 assign
     2134                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2135                 .
     2136               end.
     2137             end.
     2138             run diasize_position-resize-button in this-procedure .
     2139           end.
     2140           assign
     2141             v-diasize-change-size = false
     2142           .
     2143           leave move_block .
     2144         end.
     2145       end.
     2146       assign
     2147         v-diasize-need-full-display = true
     2148       .
     2149       if v-diasize-change-size = false
     2150       then do:
     2151         assign
     2152           v-diasize-change-size = true
     2153         .
     2154       end.
     2155       else do:
     2156         return .
     2157       end.
     2158       assign
     2159         v-frame-height = frame Dialog-Frame :height
     2160         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2161         v-browse-height = v-diasize-browse-handle :height
     2162       .
     2163       for each buf_temp-browse-handle
     2164         where buf_temp-browse-handle.browse-type = 'height':u
     2165       :
     2166         assign
     2167           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2168         .
     2169       end.
     2170       for each buf_temp-diasize-handle
     2171       :
     2172         delete buf_temp-diasize-handle .
     2173       end.
     2174       assign
     2175         v-field-group-handle = frame Dialog-Frame :first-child
     2176       .
     2177       do while valid-handle(v-field-group-handle)
     2178       :
     2179         assign
     2180           v-object-handle = v-field-group-handle :first-child
     2181         .
     2182         do while valid-handle(v-object-handle)
     2183         :
     2184           if  v-object-handle <> v-diasize-browse-handle :handle
     2185           and can-query(v-object-handle, "row")
     2186           and can-query(v-object-handle, "height")
     2187           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2188           then do:
     2189             find first buf_temp-browse-handle
     2190               where buf_temp-browse-handle.browse-type   = 'height':u
     2191                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2192               no-error .
     2193             if available buf_temp-browse-handle
     2194             then do:
     2195             end.
     2196             else do:
     2197               create buf_temp-diasize-handle .
     2198               assign
     2199                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2200                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2201               .
     2202             end.
     2203           end.
     2204           assign
     2205             v-object-handle = v-object-handle :next-sibling
     2206           .
     2207         end.
     2208         assign
     2209           v-field-group-handle = v-field-group-handle :next-sibling
     2210         .
     2211       end.
     2212       do with frame Dialog-Frame
     2213       :
     2214         hide v-diasize-resize-button .
     2215         assign
     2216           v-diasize-resize-button :row    = 1
     2217           v-diasize-resize-button :column = 1
     2218         .
     2219       end.
     2220       if p-change-value > 0
     2221       then do:
     2222         if frame Dialog-Frame :scrollable = true
     2223         then do:
     2224           assign
     2225             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2226             no-error .
     2227           if error-status :error
     2228           or error-status :get-message(1) <> ""
     2229           then do:
     2230             undo move_block, retry move_block .
     2231           end.
     2232         end.
     2233         assign
     2234           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2235           no-error .
     2236         if error-status :error
     2237         or error-status :get-message(1) <> ""
     2238         then do:
     2239           undo move_block, retry move_block .
     2240         end.
     2241         assign
     2242           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2243           no-error .
     2244         if error-status :error
     2245         or error-status :get-message(1) <> ""
     2246         then do:
     2247           undo move_block, retry move_block .
     2248         end.
     2249         for each buf_temp-browse-handle
     2250           where buf_temp-browse-handle.browse-type = 'height':u
     2251         on error undo move_block, retry move_block
     2252         :
     2253           assign
     2254             buf_temp-browse-handle.browse-handle :height
     2255               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2256             no-error .
     2257           if error-status :error
     2258           or error-status :get-message(1) <> ""
     2259           then do:
     2260             undo move_block, retry move_block .
     2261           end.
     2262         end.
     2263         for each buf_temp-diasize-handle
     2264         on error undo move_block, retry move_block
     2265         :
     2266           assign
     2267             v-object-handle = buf_temp-diasize-handle.handle-value
     2268           .
     2269           if v-object-handle <> v-diasize-resize-button
     2270           then do:
     2271             assign
     2272               v-object-handle :row = v-object-handle :row + p-change-value
     2273               no-error .
     2274             if error-status :error
     2275             or error-status :get-message(1) <> ""
     2276             then do:
     2277               undo move_block, retry move_block .
     2278             end.
     2279           end.
     2280         end.
     2281       end.
     2282       else do:
     2283         for each buf_temp-diasize-handle
     2284         on error undo move_block, retry move_block
     2285         :
     2286           assign
     2287             v-object-handle = buf_temp-diasize-handle.handle-value
     2288           .
     2289           if v-object-handle <> v-diasize-resize-button
     2290           then do:
     2291             assign
     2292               v-object-handle :row = v-object-handle :row + p-change-value
     2293               no-error .
     2294             if error-status :error
     2295             or error-status :get-message(1) <> ""
     2296             then do:
     2297               undo move_block, retry move_block .
     2298             end.
     2299           end.
     2300         end.
     2301         assign
     2302           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2303           no-error .
     2304         if error-status :error
     2305         or error-status :get-message(1) <> ""
     2306         then do:
     2307           undo move_block, retry move_block .
     2308         end.
     2309         for each buf_temp-browse-handle
     2310           where buf_temp-browse-handle.browse-type = 'height':u
     2311         on error undo move_block, retry move_block
     2312         :
     2313           assign
     2314             buf_temp-browse-handle.browse-handle :height
     2315               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2316             no-error .
     2317           if error-status :error
     2318           or error-status :get-message(1) <> ""
     2319           then do:
     2320             undo move_block, retry move_block .
     2321           end.
     2322         end.
     2323         assign
     2324           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2325           no-error .
     2326         if error-status :error
     2327         or error-status :get-message(1) <> ""
     2328         then do:
     2329           undo move_block, retry move_block .
     2330         end.
     2331         if frame Dialog-Frame :scrollable = true
     2332         then do:
     2333           assign
     2334             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2335             no-error .
     2336           if error-status :error
     2337           or error-status :get-message(1) <> ""
     2338           then do:
     2339             undo move_block, retry move_block .
     2340           end.
     2341         end.
     2342       end.
     2343       if p-move-resize = true
     2344       then do:
     2345         run diasize_position-resize-button in this-procedure .
     2346       end.
     2347       if v-diasize-wndstore = true
     2348       then do:
     2349         if connected("ub") = true
     2350         then do:
     2351           define variable v-cntxt-db-num        as integer   no-undo .
     2352           define variable v-cntxt-userid        as character no-undo .
     2353           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2354                                             , OUTPUT v-cntxt-userid
     2355                                             ) .
     2356           run gbl/wndsizew.p
     2357             (input  v-cntxt-db-num
     2358             ,input  v-cntxt-userid
     2359             ,input  v-diasize-proc-name
     2360             ,input  'height':u
     2361             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2362             ) .
     2363         end.
     2364       end.
     2365     end.
     2366     assign
     2367       v-diasize-change-size = false
     2368     .
     2369   end procedure.
     2370   procedure diasize_set-height :
     2371     define input  parameter p-new-height  as decimal   no-undo .
     2372     define input  parameter p-move-resize as logical   no-undo .
     2373     do
     2374     on error undo, return error return-value
     2375     :
     2376       run diasize_change-height in this-procedure
     2377         (input  (p-new-height - frame Dialog-Frame :height)
     2378         ,input  p-move-resize
     2379         ) .
     2380     end.
     2381   end procedure.
     2382   procedure diasize_change-width :
     2383     define input  parameter p-change-value as decimal   no-undo .
     2384     define input  parameter p-move-resize  as logical   no-undo .
     2385     define variable v-field-group-handle   as handle    no-undo .
     2386     define variable v-object-handle        as handle    no-undo .
     2387     define variable v-frame-width          as decimal   no-undo .
     2388     define variable v-frame-virtual-width  as decimal   no-undo .
     2389     define variable v-browse-width         as decimal   no-undo .
     2390     define variable v-window-width         as decimal   no-undo .
     2391     define variable v-window-virtual-width as decimal   no-undo .
     2392     define variable v-change-sign          as integer   no-undo .
     2393     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2394     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2395     if p-change-value > 0
     2396     then do:
     2397       if frame Dialog-Frame :width + p-change-value >
     2398           session :width-chars
     2399       then do:
     2400         assign
     2401           p-change-value = session :width-chars - frame Dialog-Frame :width
     2402         .
     2403         if p-change-value <= 0
     2404         then do:
     2405           run diasize_position-resize-button in this-procedure .
     2406           return .
     2407         end.
     2408       end.
     2409     end.
     2410     if p-change-value < 0
     2411     then do:
     2412       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2413       then do:
     2414         assign
     2415           p-change-value = v-diasize-orig-frame-width
     2416                          - frame Dialog-Frame :width
     2417         .
     2418         if p-change-value >= 0
     2419         then do:
     2420           run diasize_position-resize-button in this-procedure .
     2421           return .
     2422         end.
     2423       end.
     2424     end.
     2425     if p-change-value >= 0
     2426     then do:
     2427       assign
     2428         v-change-sign = 1
     2429       .
     2430     end.
     2431     else do:
     2432       assign
     2433         v-change-sign = -1
     2434       .
     2435     end.
     2436     assign
     2437       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2438     .
     2439     if p-change-value = 0
     2440     then do:
     2441       run diasize_position-resize-button in this-procedure .
     2442       return .
     2443     end.
     2444     move_block:
     2445     do
     2446     on error undo move_block, leave move_block
     2447     :
     2448       if retry
     2449       then do:
     2450         do
     2451         on error undo move_block, leave move_block
     2452         :
     2453           if p-change-value > 0
     2454           then do:
     2455             for each buf_temp-diasize-handle
     2456             on error undo, next
     2457             :
     2458               assign
     2459                 v-object-handle = buf_temp-diasize-handle.handle-value
     2460               .
     2461               if v-object-handle <> v-diasize-resize-button
     2462               then do:
     2463                 assign
     2464                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2465                 .
     2466               end.
     2467             end.
     2468             assign
     2469               v-diasize-browse-handle :width = v-browse-width
     2470             .
     2471             for each buf_temp-browse-handle
     2472               where buf_temp-browse-handle.browse-type = 'width':u
     2473             on error undo, next
     2474             :
     2475               assign
     2476                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2477               .
     2478             end.
     2479             assign
     2480               frame Dialog-Frame :width = v-frame-width
     2481             .
     2482             if frame Dialog-Frame :scrollable = true
     2483             then do:
     2484               assign
     2485                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2486               .
     2487             end.
     2488             run diasize_position-resize-button in this-procedure .
     2489           end.
     2490           else do:
     2491             if frame Dialog-Frame :scrollable = true
     2492             then do:
     2493               assign
     2494                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2495               .
     2496             end.
     2497             assign
     2498               frame Dialog-Frame :width = v-frame-width
     2499             .
     2500             for each buf_temp-browse-handle
     2501               where buf_temp-browse-handle.browse-type = 'width':u
     2502             on error undo, next
     2503             :
     2504               assign
     2505                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2506               .
     2507             end.
     2508             assign
     2509               v-diasize-browse-handle :width = v-browse-width
     2510             .
     2511             for each buf_temp-diasize-handle
     2512             on error undo, next
     2513             :
     2514               assign
     2515                 v-object-handle = buf_temp-diasize-handle.handle-value
     2516               .
     2517               if v-object-handle <> v-diasize-resize-button
     2518               then do:
     2519                 assign
     2520                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2521                 .
     2522               end.
     2523             end.
     2524             run diasize_position-resize-button in this-procedure .
     2525           end.
     2526           assign
     2527             v-diasize-change-size = false
     2528           .
     2529           leave move_block .
     2530         end.
     2531       end.
     2532       assign
     2533         v-diasize-need-full-display = true
     2534       .
     2535       if v-diasize-change-size = false
     2536       then do:
     2537         assign
     2538           v-diasize-change-size = true
     2539         .
     2540       end.
     2541       else do:
     2542         return .
     2543       end.
     2544       assign
     2545         v-frame-width = frame Dialog-Frame :width
     2546         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2547         v-browse-width = v-diasize-browse-handle :width
     2548       .
     2549       for each buf_temp-browse-handle
     2550         where buf_temp-browse-handle.browse-type = 'width':u
     2551       :
     2552         assign
     2553           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2554         .
     2555       end.
     2556       for each buf_temp-diasize-handle
     2557       :
     2558         delete buf_temp-diasize-handle .
     2559       end.
     2560       assign
     2561         v-field-group-handle = frame Dialog-Frame :first-child
     2562       .
     2563       do while valid-handle(v-field-group-handle)
     2564       :
     2565         assign
     2566           v-object-handle = v-field-group-handle :first-child
     2567         .
     2568         do while valid-handle(v-object-handle)
     2569         :
     2570           if  v-object-handle <> v-diasize-browse-handle :handle
     2571           and v-object-handle <> v-diasize-resize-button
     2572           and can-query(v-object-handle, "row")
     2573           and can-query(v-object-handle, "height")
     2574           and ( v-object-handle :col + v-object-handle :width
     2575                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2576               )
     2577           then do:
     2578             find first buf_temp-browse-handle
     2579               where buf_temp-browse-handle.browse-type   = 'width':u
     2580                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2581               no-error .
     2582             if available buf_temp-browse-handle
     2583             then do:
     2584             end.
     2585             else do:
     2586               create buf_temp-diasize-handle .
     2587               assign
     2588                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2589                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2590               .
     2591             end.
     2592           end.
     2593           assign
     2594             v-object-handle = v-object-handle :next-sibling
     2595           .
     2596         end.
     2597         assign
     2598           v-field-group-handle = v-field-group-handle :next-sibling
     2599         .
     2600       end.
     2601       do with frame Dialog-Frame
     2602       :
     2603         hide v-diasize-resize-button .
     2604         v-diasize-resize-button :row = 1.
     2605         v-diasize-resize-button :column = 1.
     2606       end.
     2607       if p-change-value > 0
     2608       then do:
     2609         if frame Dialog-Frame :scrollable = true
     2610         then do:
     2611           assign
     2612             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2613             no-error .
     2614           if error-status :error
     2615           or error-status :get-message(1) <> ""
     2616           then do:
     2617             undo move_block, retry move_block.
     2618           end.
     2619         end.
     2620         assign
     2621           frame Dialog-Frame :width = v-frame-width + p-change-value
     2622           no-error .
     2623         if error-status :error
     2624         or error-status :get-message(1) <> ""
     2625         then do:
     2626           undo move_block, retry move_block.
     2627         end.
     2628         assign
     2629           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2630         no-error .
     2631         if error-status :error
     2632         or error-status :get-message(1) <> ""
     2633         then do:
     2634           undo move_block, retry move_block.
     2635         end.
     2636         for each buf_temp-browse-handle
     2637           where buf_temp-browse-handle.browse-type = 'width':u
     2638         on error undo move_block, retry move_block
     2639         :
     2640           assign
     2641             buf_temp-browse-handle.browse-handle :width
     2642               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2643             no-error .
     2644           if error-status :error
     2645           or error-status :get-message(1) <> ""
     2646           then do:
     2647             undo move_block, retry move_block .
     2648           end.
     2649         end.
     2650         for each buf_temp-diasize-handle
     2651         on error undo move_block, retry move_block
     2652         :
     2653           assign
     2654             v-object-handle = buf_temp-diasize-handle.handle-value
     2655           .
     2656           if v-object-handle <> v-diasize-resize-button
     2657           then do:
     2658             assign
     2659               v-object-handle :col = v-object-handle :col + p-change-value
     2660               no-error .
     2661             if error-status :error
     2662             or error-status :get-message(1) <> ""
     2663             then do:
     2664               undo move_block, retry move_block .
     2665             end.
     2666           end.
     2667         end.
     2668       end.
     2669       else do:
     2670         for each buf_temp-diasize-handle
     2671         on error undo move_block, retry move_block
     2672         :
     2673           assign
     2674             v-object-handle = buf_temp-diasize-handle.handle-value
     2675           .
     2676           if v-object-handle <> v-diasize-resize-button
     2677           then do:
     2678             assign
     2679               v-object-handle :col = v-object-handle :col + p-change-value
     2680               no-error .
     2681             if error-status :error
     2682             or error-status :get-message(1) <> ""
     2683             then do:
     2684               undo move_block, retry move_block .
     2685             end.
     2686           end.
     2687         end.
     2688         for each buf_temp-browse-handle
     2689           where buf_temp-browse-handle.browse-type = 'width':u
     2690         on error undo move_block, retry move_block
     2691         :
     2692           assign
     2693             buf_temp-browse-handle.browse-handle :width
     2694               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2695             no-error .
     2696           if error-status :error
     2697           or error-status :get-message(1) <> ""
     2698           then do:
     2699             undo move_block, retry move_block .
     2700           end.
     2701         end.
     2702         assign
     2703           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2704           no-error .
     2705         if error-status :error
     2706         or error-status :get-message(1) <> ""
     2707         then do:
     2708           undo move_block, retry move_block.
     2709         end.
     2710         assign
     2711           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2712         no-error .
     2713         if error-status :error
     2714         or error-status :get-message(1) <> ""
     2715         then do:
     2716           undo move_block, retry move_block.
     2717         end.
     2718         if frame Dialog-Frame :scrollable = true
     2719         then do:
     2720           assign
     2721             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2722           no-error .
     2723           if error-status :error
     2724           or error-status :get-message(1) <> ""
     2725           then do:
     2726             undo move_block, retry move_block.
     2727           end.
     2728         end.
     2729       end.
     2730       if p-move-resize
     2731       then do:
     2732         run diasize_position-resize-button in this-procedure .
     2733       end.
     2734       if v-diasize-wndstore = true
     2735       then do:
     2736         if connected("ub") = true
     2737         then do:
     2738           define variable v-cntxt-db-num        as integer   no-undo .
     2739           define variable v-cntxt-userid        as character no-undo .
     2740           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2741                                             , OUTPUT v-cntxt-userid
     2742                                             ) .
     2743           run gbl/wndsizew.p
     2744             (input  v-cntxt-db-num
     2745             ,input  v-cntxt-userid
     2746             ,input  v-diasize-proc-name
     2747             ,input  'width':u
     2748             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2749             ) .
     2750         end.
     2751       end.
     2752     end.
     2753     assign
     2754       v-diasize-change-size = false
     2755     .
     2756   end procedure.
     2757   procedure diasize_set-width :
     2758     define input  parameter p-new-width  as decimal   no-undo .
     2759     define input  parameter p-move-resize as logical   no-undo .
     2760     do
     2761     on error undo, return error return-value
     2762     :
     2763       run diasize_change-width in this-procedure
     2764         (input  (p-new-width - frame Dialog-Frame :width)
     2765         ,input  p-move-resize
     2766         ) .
     2767     end.
     2768   end procedure.
     2769   procedure diasize_position-resize-button :
     2770     do with frame Dialog-Frame
     2771     :
     2772       hide v-diasize-resize-button .
     2773       assign
     2774         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2775                     - 1
     2776                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2777         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2778                     - 1
     2779                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2780       .
     2781       view v-diasize-resize-button .
     2782     end.
     2783   end procedure.
     2784   on alt-right anywhere
     2785   do:
     2786     run diasize_change-width in this-procedure
     2787       (input 1
     2788       ,input true
     2789       ) .
     2790     return no-apply .
     2791   end.
     2792   on alt-left anywhere
     2793   do:
     2794     run diasize_change-width in this-procedure
     2795       (input -1
     2796       ,input true
     2797       ) .
     2798     return no-apply .
     2799   end.
     2800   on alt-down anywhere
     2801   do:
     2802     run diasize_change-height in this-procedure
     2803       (input 1
     2804       ,input true
     2805       ) .
     2806     return no-apply .
     2807   end.
     2808   on alt-up anywhere
     2809   do:
     2810     run diasize_change-height in this-procedure
     2811       (input -1
     2812       ,input true
     2813       ) .
     2814     return no-apply .
     2815   end.
     2816   on alt-enter of frame Dialog-Frame
     2817   do:
     2818     run diasize_maximize in this-procedure
     2819       (input  ?
     2820       ).
     2821     return no-apply .
     2822   end.
     2823   procedure diasize_end-move :
     2824     do
     2825     on error undo, return error return-value
     2826     :
     2827       define variable v-row-delta as decimal   no-undo .
     2828       define variable v-col-delta as decimal   no-undo .
     2829       define variable v-new-row as decimal   no-undo .
     2830       define variable v-new-col as decimal   no-undo .
     2831       assign
     2832         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2833         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2834       .
     2835       assign
     2836         v-row-delta = v-new-row - frame Dialog-Frame :height
     2837         v-col-delta = v-new-col - frame Dialog-Frame :width
     2838       .
     2839       run diasize_change-height in this-procedure
     2840         (input v-row-delta
     2841         ,input true
     2842         ) .
     2843       run diasize_change-width in this-procedure
     2844         (input v-col-delta
     2845         ,input true
     2846         ) .
     2847     end.
     2848   end procedure.
     2849   procedure diasize_maximize :
     2850     define input  parameter p-action as logical   no-undo .
     2851     do
     2852     on error undo, return error return-value
     2853     :
     2854       if p-action = ?
     2855       then do:
     2856         if v-diasize-need-maximize = true
     2857         then do:
     2858           assign
     2859             p-action = true
     2860           .
     2861         end.
     2862         else do:
     2863           assign
     2864             p-action = false
     2865           .
     2866         end.
     2867       end.
     2868       if p-action = true
     2869       then do:
     2870         run diasize_change-height in this-procedure
     2871           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2872               - frame Dialog-Frame :height-chars
     2873           ,input true
     2874           ) .
     2875         run diasize_change-width in this-procedure
     2876           (input session :width-chars
     2877               - frame Dialog-Frame :width-chars
     2878           ,input true
     2879           ) .
     2880         assign
     2881           v-diasize-need-maximize = false
     2882         .
     2883       end.
     2884       else do:
     2885         run diasize_change-width in this-procedure
     2886           (input v-diasize-orig-frame-width
     2887               - frame Dialog-Frame :width-chars
     2888           ,input true
     2889           ) .
     2890         run diasize_change-height in this-procedure
     2891           (input v-diasize-orig-frame-height
     2892               - frame Dialog-Frame :height-chars
     2893           ,input true
     2894           ) .
     2895         assign
     2896           v-diasize-need-maximize = true
     2897         .
     2898       end.
     2899     end.
     2900   end procedure.
     2901   procedure diasize_restore-orig-size :
     2902     do
     2903     on error undo, return error return-value
     2904     :
     2905       assign
     2906         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2907         v-diasize-current-frame-height = frame Dialog-Frame :height
     2908       .
     2909       run diasize_set-height in this-procedure
     2910         (input  v-diasize-orig-frame-height
     2911         ,input  true
     2912         ) .
     2913       run diasize_set-width in this-procedure
     2914         (input  v-diasize-orig-frame-width
     2915         ,input  true
     2916         ) .
     2917     end.
     2918   end procedure.
     2919   procedure diasize_restore-current-size :
     2920     do
     2921     on error undo, return error return-value
     2922     :
     2923       run diasize_set-height in this-procedure
     2924         (input  v-diasize-current-frame-height
     2925         ,input  true
     2926         ) .
     2927       run diasize_set-width in this-procedure
     2928         (input  v-diasize-current-frame-width
     2929         ,input  true
     2930         ) .
     2931     end.
     2932   end procedure.
     2933   procedure diasize_set-browse-handle :
     2934     define input  parameter p-browse-handle as handle   no-undo .
     2935     define buffer buf_temp-browse-handle for temp-browse-handle .
     2936     do
     2937     on error undo, return error return-value
     2938     :
     2939       assign
     2940         v-diasize-browse-handle = p-browse-handle
     2941       .
     2942       for each buf_temp-browse-handle
     2943       on error undo, return error return-value
     2944       :
     2945         delete buf_temp-browse-handle .
     2946       end.
     2947     end.
     2948   end procedure.
     2949   procedure diasize_add_browse :
     2950     define input  parameter p-browse-type   as character no-undo .
     2951     define input  parameter p-browse-handle as handle    no-undo .
     2952     define buffer buf_temp-browse-handle for temp-browse-handle .
     2953     do
     2954     on error undo, return error return-value
     2955     :
     2956       assign
     2957         v-diasize-browse-number = v-diasize-browse-number + 1
     2958       .
     2959       create buf_temp-browse-handle .
     2960       assign
     2961         buf_temp-browse-handle.browse-type   = p-browse-type
     2962         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2963         buf_temp-browse-handle.browse-handle = p-browse-handle
     2964       .
     2965     end.
     2966   end procedure.
     2967   procedure diasize_init :
     2968     define variable v-default-value    as logical   no-undo .
     2969     define variable v-restore-saved    as logical   no-undo .
     2970     define variable v-resize-value-str as character no-undo .
     2971     do
     2972     on error undo, return error return-value
     2973     :
     2974       do with frame Dialog-Frame
     2975       :
     2976         assign
     2977           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2978           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2979           v-diasize-browse-handle     = browse BR-cash-pay :handle
     2980         .
     2981         create button v-diasize-resize-button
     2982         assign
     2983           parent        = frame Dialog-Frame :first-child
     2984           label         = "s"
     2985           height-pixels = 16
     2986           width-pixels  = 16
     2987           visible       = true
     2988           sensitive     = true
     2989           movable       = true
     2990           triggers:
     2991             on end-move persistent run diasize_end-move in this-procedure .
     2992           end triggers.
     2993         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2994         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2995         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2996         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2997         assign
     2998           v-diasize-wndmax = false
     2999         .
     3000         if connected("ub") = true
     3001         then do:
     3002           define variable v-cntxt-db-num        as integer   no-undo .
     3003           define variable v-cntxt-userid        as character no-undo .
     3004           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3005                                             , OUTPUT v-cntxt-userid
     3006                                             ) .
     3007           run gbl/wndpar_r.p
     3008             (input  v-cntxt-db-num
     3009             ,input  v-cntxt-userid
     3010             ,input  'wndmax':U
     3011             ,output v-diasize-wndmax
     3012             ,output v-default-value
     3013             ) .
     3014         end.
     3015         assign
     3016           v-diasize-wndstore = false
     3017         .
     3018         if connected("ub") = true
     3019         then do:
     3020           run gbl/wndpar_r.p
     3021             (input  v-cntxt-db-num
     3022             ,input  v-cntxt-userid
     3023             ,input  'wndstore':U
     3024             ,output v-diasize-wndstore
     3025             ,output v-default-value
     3026             ) .
     3027         end.
     3028         assign
     3029           v-diasize-proc-name = entry(1, program-name(2), '.')
     3030         .
     3031         if v-diasize-wndstore = true
     3032         then do:
     3033           assign
     3034             v-restore-saved = false
     3035           .
     3036           if connected("ub") = true
     3037           then do:
     3038             run gbl/wndsizer.p
     3039               (input  v-cntxt-db-num
     3040               ,input  v-cntxt-userid
     3041               ,input  v-diasize-proc-name
     3042               ,input  'height':u
     3043               ,output v-resize-value-str
     3044               ) .
     3045             if v-resize-value-str <> '':U
     3046             then do:
     3047               run diasize_change-height in this-procedure
     3048                 (input  integer(v-resize-value-str)
     3049                 ,input  true
     3050                 ) .
     3051               assign
     3052                 v-restore-saved = true
     3053               .
     3054             end.
     3055           end.
     3056           if connected("ub") = true
     3057           then do:
     3058             run gbl/wndsizer.p
     3059               (input  v-cntxt-db-num
     3060               ,input  v-cntxt-userid
     3061               ,input  v-diasize-proc-name
     3062               ,input  'width':u
     3063               ,output v-resize-value-str
     3064               ) .
     3065             if v-resize-value-str <> '':U
     3066             then do:
     3067               run diasize_change-width in this-procedure
     3068                 (input  integer(v-resize-value-str)
     3069                 ,input  true
     3070                 ) .
     3071               assign
     3072                 v-restore-saved = true
     3073               .
     3074             end.
     3075           end.
     3076           if v-restore-saved <> true
     3077           then do:
     3078             if v-diasize-wndmax = true
     3079             then do:
     3080               run diasize_maximize in this-procedure
     3081                 (input  true
     3082                 ) .
     3083             end.
     3084           end.
     3085         end.
     3086         else do:
     3087           if v-diasize-wndmax = true
     3088           then do:
     3089             run diasize_maximize in this-procedure
     3090               (input  true
     3091               ) .
     3092           end.
     3093         end.
     3094       end.
     3095     end.
     3096   end procedure.
     3097   procedure diasize_need-full-display :
     3098     define output parameter p-need-full-display as logical   no-undo .
     3099     do
     3100     on error undo, return error return-value
     3101     :
     3102       assign
     3103         p-need-full-display = v-diasize-need-full-display
     3104       .
     3105       assign
     3106         v-diasize-need-full-display = false
     3107       .
     3108     end.
     3109   end procedure.
     3110   procedure get-context :
     3111      define output parameter p-db-num as integer          no-undo.
     3112      define output parameter p-user-id as character        no-undo.
     3113      define variable v-login               as character    no-undo.
     3114      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3115      define buffer buf_user-login  for ub.user-login .
     3116      do
     3117      on error undo, return error
     3118      :
     3119            FIND FIRST buf_sys-ctrl no-lock.
     3120            ASSIGN
     3121               v-login = USERID("ub")
     3122               p-db-num = buf_sys-ctrl.db-num
     3123            .
     3124            FIND FIRST buf_user-login
     3125                 WHERE buf_user-login.db-num = p-db-num
     3126                   AND buf_user-login.user-login = v-login
     3127                 no-lock
     3128                 no-error
     3129                 .
     3130            IF AVAILABLE buf_user-login
     3131            THEN DO:
     3132               assign
     3133                  p-user-id = buf_user-login.user-id
     3134               .
     3135            END.
     3136      end.
     3137   end procedure.
     3138       run diasize_init in this-procedure .
     3139   MAIN-BLOCK:
     3140   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3141      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3142   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3143     run mainmenu_getcntxt in parparentproc
     3144       (output v-cntxt-db-num
     3145       ,output v-cntxt-userid
     3146       ,output v-cntxt-level
     3147       ,output v-cntxt-host-code-obj
     3148       ,output v-cntxt-obj-type
     3149       ,output v-cntxt-obj-code
     3150       ,output v-cntxt-db-num-obj
     3151       ,output v-cntxt-is-admin
     3152       ) .
     3153   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3154   ON TAB ANYWHERE
     3155   DO:
     3156   define variable ii as integer no-undo .
     3157   define variable fh as widget-handle no-undo .
     3158   define variable hh as widget-handle no-undo .
     3159   define variable v-next-widget-name as character no-undo .
     3160   if v-tab-order <> '' then do:
     3161     if self:type = "TOGGLE-BOX" then
     3162     self:BGCOLOR = ?.
     3163     assign
     3164     ii = lookup(self:name, v-tab-order).
     3165     assign
     3166     ii = ii + 1
     3167     v-next-widget-name = entry(ii, v-tab-order)
     3168     no-error .
     3169     if error-status:error then do:
     3170       assign
     3171       ii = 1
     3172       v-next-widget-name = entry( ii, v-tab-order)
     3173       .
     3174     end.
     3175     assign
     3176     fh = frame Dialog-Frame:first-child
     3177     hh = fh:first-child
     3178     .
     3179     do while valid-handle(hh):
     3180       if hh:name = v-next-widget-name then do:
     3181         if hh:sensitive  = yes
     3182         AND hh:visible = yes then do:
     3183           if hh:type = "TOGGLE-BOX":U then do:
     3184             assign
     3185             hh:BGcolor = 1
     3186             .
     3187           end.
     3188           APPLY "ENTRY" to hh.
     3189           return no-apply.
     3190         end.
     3191         else do:
     3192           APPLY "TAB" to hh.
     3193           return no-apply.
     3194         end.
     3195       end.
     3196       hh = hh:next-sibling.
     3197     end.
     3198   end.
     3199   END.
     3200   ON BACK-TAB ANYWHERE
     3201   DO:
     3202   define variable ii as integer no-undo .
     3203   define variable fh as widget-handle no-undo .
     3204   define variable hh as widget-handle no-undo .
     3205   define variable v-next-widget-name as character no-undo .
     3206   if v-tab-order <> '' then do:
     3207     assign
     3208     ii = lookup(self:name, v-tab-order).
     3209     .
     3210     assign
     3211     ii = (if ii = 1
     3212           then  num-entries(v-tab-order)
     3213           else ii - 1
     3214           )
     3215     v-next-widget-name = entry(ii, v-tab-order)
     3216     .
     3217     assign
     3218     fh = frame Dialog-Frame:first-child
     3219     hh = fh:first-child
     3220     .
     3221     do while valid-handle(hh):
     3222       if hh:name = v-next-widget-name then do:
     3223         if hh:sensitive  = yes
     3224         AND hh:visible = yes then do:
     3225           if hh:type = "TOGGLE-BOX":U then do:
     3226             assign
     3227             hh:BGcolor = 1
     3228             .
     3229           end.
     3230           APPLY "ENTRY" to hh.
     3231           return no-apply.
     3232         end.
     3233         else do:
     3234         APPLY "BACK-TAB" to hh.
     3235         return no-apply.
     3236         end.
     3237       end.
     3238       hh = hh:next-sibling.
     3239     end.
     3240     end.
     3241   END.
     3242   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3243   ON RETURN ANYWHERE
     3244   DO:
     3245   define variable ii as integer no-undo .
     3246   define variable fh as widget-handle no-undo .
     3247   define variable hh as widget-handle no-undo .
     3248   define variable v-next-widget-name as character no-undo .
     3249     if v-tab-order <> '' then do:
     3250       assign
     3251       ii = lookup(self:name, v-tab-order).
     3252       if ii = num-entries(v-tab-order) then do:
     3253           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     3254           return no-apply.
     3255       end.
     3256       if self:type <> "BUTTON" and
     3257         self:type <> "EDITOR"  then do:
     3258         run proc-move-forward in this-procedure .
     3259         return no-apply.
     3260       end.
     3261       if self:type = "BUTTON" then do:
     3262         APPLY "CHOOSE" to self.
     3263       end.
     3264       if self:type = "TOGGLE-BOX" then
     3265       self:BGCOLOR = ?.
     3266       assign
     3267       ii = ii + 1
     3268       v-next-widget-name = entry(ii, v-tab-order)
     3269       no-error .
     3270       if error-status:error then do:
     3271         assign
     3272         ii = 1
     3273         v-next-widget-name = entry( ii, v-tab-order)
     3274         .
     3275       end.
     3276       assign
     3277       fh = frame Dialog-Frame:first-child
     3278       hh = fh:first-child
     3279       .
     3280       do while valid-handle(hh):
     3281         if hh:name = v-next-widget-name then do:
     3282           if hh:sensitive  = yes
     3283           AND hh:visible = yes then do:
     3284             if hh:type = "TOGGLE-BOX":U then do:
     3285               assign
     3286               hh:BGcolor = 1
     3287               .
     3288             end.
     3289             APPLY "ENTRY" to hh.
     3290             return no-apply.
     3291           end.
     3292           else do:
     3293             APPLY "TAB" to hh.
     3294             return no-apply.
     3295           end.
     3296         end.
     3297         hh = hh:next-sibling.
     3298       end.
     3299     end.
     3300   END.
     3301   procedure proc-move-forward :
     3302   define variable ii as integer no-undo .
     3303   define variable fh as widget-handle no-undo .
     3304   define variable hh as widget-handle no-undo .
     3305   define variable v-next-widget-name as character no-undo .
     3306   do
     3307   on error undo, return error
     3308   :
     3309     if v-tab-order <> '' then do:
     3310       if self:type = "TOGGLE-BOX" then
     3311       self:BGCOLOR = ?.
     3312       assign
     3313       ii = lookup(self:name, v-tab-order).
     3314       assign
     3315       ii = ii + 1
     3316       v-next-widget-name = entry(ii, v-tab-order)
     3317       no-error .
     3318       if error-status:error then do:
     3319         assign
     3320         ii = 1
     3321         v-next-widget-name = entry( ii, v-tab-order)
     3322         .
     3323       end.
     3324       assign
     3325       fh = frame Dialog-Frame:first-child
     3326       hh = fh:first-child
     3327       .
     3328       do while valid-handle(hh):
     3329         if hh:name = v-next-widget-name then do:
     3330           if hh:sensitive  = yes
     3331           AND hh:visible = yes then do:
     3332             if hh:type = "TOGGLE-BOX":U then do:
     3333               assign
     3334               hh:BGcolor = 1
     3335               .
     3336             end.
     3337             APPLY "ENTRY" to hh.
     3338             return.
     3339           end.
     3340           else do:
     3341             assign
     3342             ii = ii + 1
     3343             v-next-widget-name = entry(ii, v-tab-order)
     3344             no-error .
     3345             if error-status:error then do:
     3346               assign
     3347               ii = 1
     3348               v-next-widget-name = entry( ii, v-tab-order)
     3349               .
     3350             end.
     3351           end.
     3352         end.
     3353         hh = hh:next-sibling.
     3354       end.
     3355     end.
     3356   end.
     3357   end procedure.
     3358     IF p-mode <> 'ПРОСМОТР':U
     3359     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     3360         MESSAGE
     3361         vss-workfile vss-revision vss-description skip
     3362         "Неверное значение параметра p-mode" p-mode
     3363         VIEW-AS ALERT-BOX ERROR.
     3364         UNDO, RETURN ERROR.
     3365     END.
     3366     IF p-obj-type <> 'маг':U
     3367     and p-obj-type <> 'орг':U
     3368     and p-obj-type <> '':U
     3369     THEN DO:
     3370         MESSAGE
     3371         vss-workfile vss-revision vss-description skip
     3372         "Неверное значение параметра p-obj-type" p-obj-type
     3373         VIEW-AS ALERT-BOX ERROR.
     3374         UNDO, RETURN ERROR.
     3375     END.
     3376     if p-obj-type = 'маг':U then do:
     3377       FIND FIRST X_shop NO-LOCK WHERE X_shop.obj-code = p-obj-code NO-ERROR.
     3378       IF NOT AVAILABLE X_shop THEN DO:
     3379           MESSAGE
     3380           vss-workfile vss-revision vss-description skip
     3381           "Неверное значение параметра p-obj-code" p-obj-code
     3382           VIEW-AS ALERT-BOX ERROR.
     3383           UNDO, RETURN ERROR.
     3384       END.
     3385   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3386   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     3387     (input  'маг':U
     3388     ,input  p-obj-code
     3389     ,output v-db-num
     3390     )  .
     3391       IF v-db-num <> v-cntxt-db-num
     3392       AND v-cntxt-db-num <> 0
     3393       and p-mode <> 'ПРОСМОТР':U
     3394       THEN DO:
     3395           MESSAGE
     3396           "Нельзя менять параметры магазина в чужой БД" skip
     3397           "магазин принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     3398           VIEW-AS ALERT-BOX ERROR.
     3399           UNDO, RETURN ERROR.
     3400       END.
     3401   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3402   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3403     (input  p-obj-type
     3404     ,input  p-obj-code
     3405     ,output v-host-code
     3406     )  .
     3407     end.
     3408     if p-obj-type = 'орг':U then do:
     3409       FIND FIRST X_sysconf NO-LOCK WHERE X_sysconf.host-code = p-obj-code NO-ERROR.
     3410       IF NOT AVAILABLE X_sysconf THEN DO:
     3411           MESSAGE
     3412           vss-workfile vss-revision vss-description skip
     3413           "Неверное значение параметра p-obj-code" p-obj-code
     3414           VIEW-AS ALERT-BOX ERROR.
     3415           UNDO, RETURN ERROR.
     3416       END.
     3417       if v-cntxt-db-num <> 0
     3418       and p-mode <> 'ПРОСМОТР':U
     3419       then do:
     3420           MESSAGE
     3421           "Нельзя менять параметры ФИРМЫ в УБД" skip
     3422           VIEW-AS ALERT-BOX ERROR.
     3423           UNDO, RETURN ERROR.
     3424       end.
     3425       v-host-code = p-obj-code.
     3426     end.
     3427     if p-obj-type = '':U then do:
     3428       if v-cntxt-db-num <> 0
     3429       and p-mode <> 'ПРОСМОТР':U
     3430       then do:
     3431           MESSAGE
     3432           "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" skip
     3433           VIEW-AS ALERT-BOX ERROR.
     3434           UNDO, RETURN ERROR.
     3435       end.
     3436     end.
     3437     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     3438       FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
     3439                 LOCKED_thbj-attr.obj-type = p-obj-type
     3440           AND   LOCKED_thbj-attr.obj-code = p-obj-code
     3441           AND   LOCKED_thbj-attr.upper-prop-code = 'cd-type-autotank':U
     3442           AND   locked_thbj-attr.prop-code = '':U NO-WAIT NO-ERROR.
     3443        if locked locked_thbj-attr then do:
     3444           message
     3445           vss-workfile vss-revision vss-description skip
     3446            "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
     3447           view-as alert-box error .
     3448           undo, return error.
     3449         end.
     3450     END.
     3451     ELSE DO:
     3452         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
     3453             LOCKED_thbj-attr.obj-type = p-obj-type
     3454       AND   LOCKED_thbj-attr.obj-code = p-obj-code
     3455       AND   LOCKED_thbj-attr.upper-prop-code = 'cd-type-autotank':U
     3456       AND   locked_thbj-attr.prop-code = '':U NO-ERROR.
     3457     END.
     3458     if not available locked_thbj-attr then do:
     3459       ASSIGN
     3460       v-to-create  = YES.
     3461       message
     3462       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     3463                   chr(10))
     3464       view-as alert-box WARNING.
     3465     end.
     3466   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3467   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run r-b-curr in g#library
     3468     (input  v-host-code
     3469     ,output v-r-b-code
     3470     )  .
     3471     FIND FIRST buf_currency NO-LOCK WHERE
     3472           buf_currency.curr-code = v-r-b-code .
     3473     RUN FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     3474     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     3475     RUN Myenable.
     3476     WAIT-FOR GO OF FRAME Dialog-Frame.
     3477   END.
     3478   RUN disable_UI.
     3479   PROCEDURE disable_UI :
     3480     HIDE FRAME Dialog-Frame.
     3481   END PROCEDURE.
     3482   PROCEDURE enable_UI :
     3483     DISPLAY t-ibmgroup
     3484         WITH FRAME Dialog-Frame.
     3485     ENABLE B-exit b-quit B-Help b-chg BR-cash-pay B-ok B-no-ok BR-specgrp
     3486         WITH FRAME Dialog-Frame.
     3487     VIEW FRAME Dialog-Frame.
     3488   END PROCEDURE.
     3489   PROCEDURE fill-widgets :
     3490   define variable v-value-character as character no-undo .
     3491   define variable v-value-date as date no-undo .
     3492   define variable v-value-decimal as decimal no-undo .
     3493   define variable v-value-integer as INTEGER no-undo .
     3494   define variable v-value-logical AS LOGICAL no-undo .
     3495   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     3496   DEFINE VARIABLE v-entry AS CHARACTER NO-UNDO.
     3497   DEFINE VARIABLE v-specgrp AS CHARACTER NO-UNDO.
     3498   define variable v-grp-code as integer no-undo .
     3499   define variable v-gtype as integer no-undo .
     3500   DEFINE VARIABLE v-cash-pay-list AS CHARACTER NO-UNDO.
     3501   DEFINE VARIABLE v-cdpay-code LIKE ub.cash-pay.cdpay-code NO-UNDO.
     3502   DEFINE VARIABLE v-curr-code LIKE ub.cash-pay.curr-code NO-UNDO.
     3503   DEFINE VARIABLE v-cdpay-code-autotank LIKE ub.cash-pay.cdpay-code NO-UNDO.
     3504   define variable v-autotank-obj-name as character no-undo .
     3505   define variable v-param-type as character no-undo .
     3506   define variable v-param-value as character no-undo .
     3507   DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
     3508   DEFINE BUFFER buf_tt-sum-grp FOR tt-sum-grp.
     3509   DEFINE BUFFER buf_tax-rate FOR ub.tax-rate.
     3510   DEFINE BUFFER buf_goods FOR ub.goods.
     3511   FOR EACH thbjattr_thbj-attr:
     3512     delete thbjattr_thbj-attr.
     3513   end.
     3514   FOR EACH temp-thbj-attr:
     3515     delete temp-thbj-attr.
     3516   end.
     3517   run adm/shattri.p (
     3518                 input "init":U
     3519               , input p-obj-type
     3520               , input p-obj-code
     3521               , input 'cd-type-autotank':U
     3522               , input "":U
     3523               , output v-value-character
     3524               , output v-value-date
     3525               , output v-value-decimal
     3526               , output v-value-integer
     3527               , output v-value-logical
     3528               , output v-param-type
     3529               , INPUT-OUTPUT TABLE-handle v-tth
     3530               ) no-error .
     3531   if error-status:error
     3532   and not available locked_thbj-attr then do:
     3533     message
     3534     "Не удалось получить начальные значения настроек" skip
     3535     error-status:get-message(1) return-value
     3536     view-as alert-box error .
     3537     undo, return error .
     3538   end.
     3539   FOR EACH thbjattr_thbj-attr:
     3540     ASSIGN
     3541     v-entry = thbjattr_thbj-attr.prop-code.
     3542     IF v-entry = 'cash-pay-list':U THEN DO:
     3543       ASSIGN
     3544       v-cash-pay-list = thbjattr_thbj-attr.property-value-character.
     3545     END.
     3546     if v-entry = 'ibmgroup':U then do:
     3547       assign
     3548       t-ibmgroup = thbjattr_thbj-attr.property-value-logical
     3549       .
     3550     end.
     3551     IF v-entry = 'specgrp':U THEN DO:
     3552       ASSIGN
     3553       v-specgrp = thbjattr_thbj-attr.property-value-character.
     3554     END.
     3555     create temp-thbj-attr.
     3556     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     3557   END.
     3558   if v-cash-pay-list <> "":U then do:
     3559   _ii:
     3560   DO ii = 1 TO  NUM-ENTRIES(v-cash-pay-list, ";"):
     3561     ASSIGN
     3562     v-entry = entry(ii, v-cash-pay-list, ";":U)
     3563     v-cdpay-code-autotank = integer(entry(1, entry(1, v-entry, chr(47)), chr(44)))
     3564     v-autotank-obj-name = entry(2, entry(1, v-entry, chr(47)), chr(44))
     3565     v-cdpay-code = integer(entry(1, entry(2, v-entry, chr(47)), chr(44)))
     3566     v-curr-code = integer(entry(2, entry(2, v-entry, chr(47)), chr(44)))
     3567     .
     3568     FIND FIRST buf_cash-pay NO-LOCK WHERE
     3569                   buf_cash-pay.cdpay-code = v-cdpay-code
     3570           AND buf_cash-pay.curr-code = v-curr-code  NO-ERROR.
     3571     CREATE tt-cash-pay-autotank.
     3572     if available buf_cash-pay then do:
     3573       BUFFER-COPY buf_cash-pay TO tt-cash-pay-autotank.
     3574     end.
     3575     else do:
     3576       ASSIGN
     3577       tt-cash-pay-autotank.cdpay-code = 0
     3578       .
     3579     end.
     3580     ASSIGN
     3581     tt-cash-pay-autotank.autotank-cdpay-code = v-cdpay-code-autotank
     3582     tt-cash-pay-autotank.autotank-obj-name = v-autotank-obj-name
     3583     .
     3584   END.
     3585   end.
     3586   if v-specgrp <> "":U then do:
     3587     _ii:
     3588     DO ii = 1 TO NUM-ENTRIES(v-specgrp, ";"):
     3589       ASSIGN
     3590       v-grp-code = INTEGER (ENTRY(1, ENTRY(ii, v-specgrp, ";":U), "-":U))
     3591       .
     3592       if num-entries(ENTRY(ii, v-specgrp, ";":U), "-":U) > 2 then do:
     3593         assign
     3594         v-gtype = INTEGER (ENTRY(3, ENTRY(ii, v-specgrp, ";":U), "-":U)) no-error .
     3595       end.
     3596       FIND FIRST buf_tt-sum-grp NO-LOCK WHERE
     3597                     buf_tt-sum-grp.grp-code = v-grp-code NO-ERROR.
     3598       IF AVAILABLE buf_tt-sum-grp THEN NEXT _ii.
     3599       FIND FIRST buf_goods NO-LOCK WHERE
     3600                   buf_goods.gds-code = integer(ENTRY(2, ENTRY(ii, v-specgrp, ";":U), "-":U)) NO-ERROR.
     3601         CREATE buf_tt-sum-grp.
     3602         ASSIGN
     3603         buf_tt-sum-grp.grp-code = integer(ENTRY(1, ENTRY(ii, v-specgrp, ";":U), "-":U))
     3604         buf_tt-sum-grp.code-2 = (IF AVAILABLE buf_goods
     3605                                  THEN buf_goods.gds-code
     3606                                  ELSE integer(ENTRY(2, ENTRY(ii, v-specgrp, ";":U), "-":U)))
     3607         buf_tt-sum-grp.grp-name = (IF AVAILABLE buf_goods
     3608                                  THEN buf_goods.gds-name
     3609                                  ELSE "!!!Ошибка не такого товара")
     3610         buf_tt-sum-grp.gtype    = v-gtype
     3611         .
     3612     END.
     3613   end.
     3614   END PROCEDURE.
     3615   PROCEDURE MyEnable :
     3616   DEFINE BUFFER buf_currency FOR ub.currency.
     3617   ASSIGN
     3618   FRAME Dialog-Frame:TITLE = FRAME Dialog-Frame:TITLE + (if p-obj-type = 'орг':U then " фирма" else " маг") + STRING(p-obj-code)
     3619   tt-cash-pay-autotank.obj-name:resizable in browse br-cash-pay = yes
     3620   tt-cash-pay-autotank.autotank-obj-name:resizable in browse br-cash-pay = yes
     3621   v-tab-order = "b-add-cash-pay,b-del-cash-pay".
     3622   if p-obj-code = 0 and p-obj-type = "" then  t-ibmgroup = no.
     3623   display
     3624   t-ibmgroup
     3625   WITH FRAME Dialog-Frame.
     3626   ENABLE
     3627   B-exit WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3628   b-quit
     3629   B-Help
     3630   br-cash-pay
     3631   b-chg WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3632   t-ibmgroup WHEN p-mode = 'ИЗМЕНЕНИЕ':U and p-obj-type = 'маг':U
     3633   b-add-2   WHEN p-mode = 'ИЗМЕНЕНИЕ':U AND t-ibmgroup
     3634   b-del-2   WHEN p-mode = 'ИЗМЕНЕНИЕ':U AND t-ibmgroup
     3635   WITH FRAME Dialog-Frame.
     3636   VIEW FRAME Dialog-Frame.
     3637   IF p-mode = 'ПРОСМОТР':U THEN DO:
     3638       HIDE
     3639       b-exit
     3640       IN FRAME Dialog-Frame.
     3641       ASSIGN
     3642       b-quit:LABEL = "&Выход"
     3643       .
     3644   END.
     3645   APPLY "value-changed" TO t-ibmgroup.
     3646   RUN openbrcash-pay IN THIS-PROCEDURE.
     3647   OPEN QUERY BR-specgrp FOR EACH tt-sum-grp NO-LOCK INDEXED-REPOSITION.
     3648   END PROCEDURE.
     3649   PROCEDURE OpenBrcash-pay :
     3650   OPEN QUERY br-cash-pay FOR EACH tt-cash-pay-autotank SHARE-LOCK.
     3651   END PROCEDURE.
     3652   PROCEDURE proc-b-add-2 :
     3653   DEFINE INPUT PARAMETER p-gtype AS INTEGER NO-UNDO.
     3654   DEFINE VARIABLE v-value-int AS integer NO-UNDO.
     3655   DEFINE VARIABLE v-sum-grp-rid AS recid NO-UNDO.
     3656   DEFINE VARIABLE ref-list AS character NO-UNDO.
     3657   define buffer buf_gds-list for gds-list.
     3658     define variable v-host-code as integer no-undo .
     3659     define buffer buf_macro-list-hist for macro-list-hist.
     3660     DEFINE BUFFER buf_tt-sum-grp FOR tt-sum-grp.
     3661     DEFINE BUFFER buf_goods FOR ub.goods.
     3662     DEFINE BUFFER buf_sum-grp FOR ub.sum-grp.
     3663     run ref/sum-grps.w (
     3664                    input parparentproc
     3665                  , INPUT "b-sel"
     3666                  , input-output ref-list).
     3667     if ref-list = "":U then do:
     3668       UNDO, RETURN ERROR.
     3669     END.
     3670       find first buf_sum-grp no-lock where
     3671                 recid(buf_sum-grp) = integer(entry(1, ref-list)) no-error .
     3672       if not avail buf_sum-grp then return error.
     3673       assign
     3674       v-value-int = buf_sum-grp.grp-code
     3675       .
     3676     FIND FIRST buf_tt-sum-grp WHERE
     3677               buf_tt-sum-grp.grp-code = v-value-int NO-ERROR.
     3678     IF AVAILABLE buf_tt-sum-grp THEN DO:
     3679         MESSAGE
     3680         "Уже определена запись с таким кодом"
     3681         VIEW-AS ALERT-BOX ERROR.
     3682         UNDO, RETURN error.
     3683     END.
     3684     for each buf_macro-list-hist:
     3685       delete buf_macro-list-hist.
     3686     end.
     3687     for each gds-list-hist:
     3688       delete gds-list-hist.
     3689     end.
     3690     create buf_macro-list-hist.
     3691     assign
     3692     buf_macro-list-hist.list-table = '':U
     3693     buf_macro-list-hist.id         = 1
     3694     buf_macro-list-hist.line       = 0
     3695     buf_macro-list-hist.hist-mode  = '+'
     3696     buf_macro-list-hist.status_    = 'все':U
     3697     .
     3698     CASE p-gtype:
     3699         WHEN 50 THEN DO:
     3700             ASSIGN
     3701             buf_macro-list-hist.des        = "ВСЕ услуги-платежи в адрес ОСС"
     3702             buf_macro-list-hist.item_      = 'office-type':U
     3703             buf_macro-list-hist.option_    = "goods-attr"
     3704             .
     3705         END.
     3706         WHEN 24 THEN DO:
     3707             ASSIGN
     3708             buf_macro-list-hist.des        = "ВСЕ услуги-перечисления в системы лояльности"
     3709             buf_macro-list-hist.item_      = 'is-loyalty-payment':U  + chr(3) + string(yes)
     3710             buf_macro-list-hist.option_    = "goods-attr-val"
     3711             .
     3712       END.
     3713     END CASE.
     3714     release buf_macro-list-hist.
     3715   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3716   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3717     (input  p-obj-type
     3718     ,input  p-obj-code
     3719     ,output v-host-code
     3720     ) no-error .
     3721     for each gds-list:
     3722       delete gds-list.
     3723     end.
     3724     run str/gdsqlist.w (
     3725                      input parparentproc
     3726                     ,input this-procedure:handle
     3727                     ,input v-host-code
     3728                     ,input p-obj-type
     3729                     ,input p-obj-code
     3730                     ,input "b-sel"
     3731                     ,input "ВСЕ услуги-платежи в адрес ОСС"
     3732                     ,input yes
     3733                     ).
     3734     find first gds-list where
     3735              gds-list.to-sel = yes no-error.
     3736     if not available gds-list then return error.
     3737     FIND FIRST buf_goods NO-LOCK WHERE
     3738               buf_goods.gds-code = gds-list.gds-code NO-ERROR.
     3739     IF NOT AVAILABLE buf_goods THEN RETURN error.
     3740     for each buf_gds-list where buf_gds-list.to-sel = yes:
     3741       buf_gds-list.to-sel = no.
     3742     end.
     3743     if buf_goods.gds-type <> 'у':U then do:
     3744       message
     3745       "Со спецгруппой можно связать только УСЛУГУ!"
     3746       view-as alert-box error.
     3747       undo, return error.
     3748     end.
     3749     if buf_goods.unit-base <> "руб" then do:
     3750       message
     3751       substitute("Со спецгруппой можно связать только УСЛУГУ,&1" +
     3752                  "у которой единица измерения равна единице измерения НАЦИОНАЛЬНОЙ ВАЛЮТЫ (&2)"
     3753                  , chr(10)
     3754                  , "руб")
     3755       view-as alert-box error.
     3756       undo, return error.
     3757     end.
     3758     CREATE buf_tt-sum-grp.
     3759     ASSIGN
     3760     buf_tt-sum-grp.grp-code = v-value-int
     3761     buf_tt-sum-grp.grp-name = gds-list.gds-name
     3762     buf_tt-sum-grp.code-2   = gds-list.gds-code
     3763     buf_tt-sum-grp.gtype    = p-gtype
     3764     v-sum-grp-rid = RECID(buf_tt-sum-grp)
     3765     .
     3766     for each gds-list:
     3767       delete gds-list.
     3768     end.
     3769     OPEN QUERY BR-specgrp FOR EACH tt-sum-grp NO-LOCK INDEXED-REPOSITION.
     3770     REPOSITION br-specgrp TO RECID v-sum-grp-rid.
     3771   end procedure.
     3772   PROCEDURE proc-b-chg :
     3773   DEFINE VARIABLE v-value AS CHARACTER NO-UNDO.
     3774   DEFINE VARIABLE v-log AS logical NO-UNDO.
     3775   DEFINE variable v-rid AS RECID NO-UNDO.
     3776   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     3777   define variable v-cdpay-code as integer no-undo .
     3778   DEFINE BUFFER buf_tt-cash-pay-autotank FOR tt-cash-pay-autotank.
     3779   DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
     3780   if not available tt-cash-pay-autotank then return error.
     3781   FIND FIRST buf_tt-cash-PAY-autotank NO-LOCK WHERE
     3782           buf_tt-cash-pay-autotank.autotank-cdpay-code = tt-cash-pay-autotank.autotank-cdpay-code  NO-ERROR.
     3783   IF buf_tt-cash-pay-autotank.cdpay-code <> 0 THEN DO:
     3784     MESSAGE
     3785     SUBSTITUTE("Уже задано правило соответствия для типа кассового платежа,&1" +
     3786                 "у которого код платежа на AUTOTANK &2"
     3787                 , chr(10)
     3788                 , tt-cash-pay-autotank.autotank-cdpay-code
     3789                 ) skip
     3790     "Изменить?"
     3791     VIEW-AS ALERT-BOX question buttons yes-no update v-log.
     3792     if not v-log then return .
     3793   END.
     3794   run ref/cashpays.w (
     3795              input parparentproc
     3796             ,input  "b-sel":U
     3797             ,input  'все':U
     3798             ,input (if p-obj-type = 'орг':U then p-obj-code else v-host-code)
     3799             ,input (if p-obj-type = 'орг':U then '':U else p-obj-type)
     3800             ,input (if p-obj-type = 'орг':U then 0 else p-obj-code)
     3801             ,OUTPUT v-rid-list) NO-ERROR.
     3802   IF ERROR-STATUS:ERROR THEN RETURN error.
     3803   if v-rid-list = "":U then do:
     3804     message
     3805     "Вы не выбрали соответствующий тип кассового платежа в IBS TH" skip(0)
     3806     "Значит ли это, что Вы хотите удалить соответствие?"
     3807     view-as alert-box question buttons yes-no update v-log.
     3808     if v-log = no then return.
     3809     else do:
     3810       ASSIGN
     3811       buf_tt-cash-pay-autotank.cdpay-code = 0
     3812       buf_tt-cash-pay-autotank.curr-code = 0
     3813       buf_tt-cash-pay-autotank.obj-name = ''
     3814       v-rid = RECID(buf_tt-cash-pay-autotank)
     3815       .
     3816     end.
     3817   end.
     3818   else do:
     3819     FIND FIRST buf_cash-pay NO-LOCK WHERE
     3820             RECID(buf_cash-pay) = INTEGER(ENTRY(1, v-rid-list)) NO-ERROR.
     3821     IF NOT AVAILABLE buf_cash-pay  THEN RETURN error.
     3822     if buf_cash-pay.curr-code <> 0 then do:
     3823       message
     3824       "Нельзя выбрать типа кассового платежа с валютой отличной от национальной!"
     3825       view-as alert-box error .
     3826       undo, return error.
     3827     end.
     3828     ASSIGN
     3829     buf_tt-cash-pay-autotank.cdpay-code = buf_cash-pay.cdpay-code
     3830     buf_tt-cash-pay-autotank.curr-code = buf_cash-pay.curr-code
     3831     buf_tt-cash-pay-autotank.obj-name = buf_cash-pay.obj-name
     3832     v-rid = RECID(buf_tt-cash-pay-autotank)
     3833     .
     3834   end.
     3835   RUN openbrcash-pay IN THIS-PROCEDURE.
     3836   REPOSITION br-cash-pay TO RECID v-rid.
     3837   END PROCEDURE.
     3838   PROCEDURE proc-save :
     3839   define variable v-same as logical no-undo .
     3840   define variable v-value-character as character no-undo .
     3841   define variable v-value-date as date no-undo .
     3842   define variable v-value-decimal as decimal no-undo .
     3843   define variable v-value-integer as INTEGER no-undo .
     3844   define variable v-value-logical AS LOGICAL no-undo .
     3845   define variable v-param-type as character no-undo .
     3846   DEFINE VARIABLE v-cash-pay-list AS CHARACTER NO-UNDO.
     3847   define variable v-specgrp as character no-undo .
     3848   define variable ii as integer no-undo .
     3849   DEFINE BUFFER buf_tt-cash-pay-autotank FOR tt-cash-pay-autotank.
     3850   DEFINE BUFFER buf_tt-sum-grp FOR tt-sum-grp.
     3851   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     3852   if t-ibmgroup then do:
     3853     ii = 0.
     3854     FOR EACH buf_tt-sum-grp BY buf_tt-sum-grp.grp-code:
     3855       ASSIGN
     3856       ii = ii + 1
     3857       v-specgrp = v-specgrp + (if ii = 1 then "":U else ";":U)  +
     3858                     STRING(buf_tt-sum-grp.grp-code) + "-":U + STRING(buf_tt-sum-grp.code-2) +
     3859                      '-' + STRING(buf_tt-sum-grp.gtype)
     3860       .
     3861     END.
     3862   end.
     3863   FOR EACH tt-cash-pay-autotank BY tt-cash-pay-autotank.autotank-cdpay-code:
     3864     ASSIGN
     3865     v-cash-pay-list = v-cash-pay-list + (IF v-cash-pay-list = "":U THEN "":U ELSE ";") +
     3866                       STRING(tt-cash-pay-autotank.autotank-cdpay-code) + chr(44) +
     3867                       STRING(tt-cash-pay-autotank.autotank-obj-name) +
     3868                       chr(47) +
     3869                       STRING(tt-cash-pay-autotank.cdpay-code) + chr(44) +
     3870                       STRING(tt-cash-pay-autotank.curr-code)
     3871     .
     3872   END.
     3873   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'cash-pay-list':U.
     3874   assign
     3875   thbjattr_thbj-attr.property-value-character = v-cash-pay-list.
     3876   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'ibmgroup':U.
     3877   assign
     3878   thbjattr_thbj-attr.property-value-logical = t-ibmgroup.
     3879   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'specgrp':U.
     3880   assign
     3881   thbjattr_thbj-attr.property-value-character = v-specgrp.
     3882   v-same = yes.
     3883   for each thbjattr_thbj-attr,
     3884       first temp-thbj-attr where
     3885             temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     3886         and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     3887         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     3888         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code:
     3889      buffer-compare
     3890      thbjattr_thbj-attr
     3891      to temp-thbj-attr
     3892      save result in v-same.
     3893      if not v-same then leave.
     3894   end.
     3895   v-same = no.
     3896   IF v-same  and not v-to-create THEN RETURN.
     3897   run adm/shattri.p (
     3898                 input "check":U
     3899               , input p-obj-type
     3900               , input p-obj-code
     3901               , input 'cd-type-autotank':U
     3902               , INPUT '':U
     3903                , output v-value-character
     3904                , output v-value-date
     3905                , output v-value-decimal
     3906                , output v-value-integer
     3907                , output v-value-logical
     3908                , output v-param-type
     3909                , input-output TABLE-handle v-tth
     3910                ) no-error .
     3911   if error-status:error then do:
     3912     message
     3913     "Некорректное значение ПАРАМЕТРОВ" skip
     3914     error-status:get-message(1) skip
     3915     return-value
     3916     view-as alert-box error .
     3917     undo, return error .
     3918   end.
     3919   do TRANSACTION
     3920   on error undo, return error return-value
     3921   :
     3922     RUN thbjattr_set-section IN THIS-PROCEDURE (
     3923          input p-obj-type
     3924         ,input p-obj-code
     3925         ,input 'cd-type-autotank':U
     3926         ,INPUT table thbjattr_thbj-attr
     3927     ) NO-ERROR.
     3928     IF ERROR-STATUS:error THEN do:
     3929       MESSAGE ERROR-STATUS:get-message(1)  SKIP
     3930       RETURN-VALUE
     3931       VIEW-AS ALERT-BOX.
     3932       UNDO, RETURN ERROR.
     3933     END.
     3934   end.
     3935   END PROCEDURE.
