     1613     index code is         unique gds-code
     1614     index oi order-num
     1615     index isel to-sel
     1616     .
     1617   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1618   define  new shared  temp-table gds-list-hist no-undo
     1619   field list-table as character
     1620   field id as integer
     1621   field line as integer
     1622   field hist-mode as character
     1623   field des as character
