      486   procedure thbjattr_get-section :
      487   define input  parameter p-obj-type like ub.thbj-attr.obj-type   no-undo .
      488   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
      489   define input  parameter p-upper-param-code  like ub.thbj-attr.upper-prop-code  no-undo .
      490   define input  parameter p-mode as character no-undo .
      491   define input-output parameter table-handle p-tth.
      492   define output parameter p-all-found as decimal no-undo .
      493   do
