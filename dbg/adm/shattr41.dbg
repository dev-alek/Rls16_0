      622   procedure proc-alt-shift-f2:
      623     if not ibs.th.gbl.gbl-var:rcode
      624   then
      625     run gbl\inidebug.p .
      626   end.
      627   procedure proc-alt-shift-f3:
      628     run gbl/prvssinf.p
      629       ( input this-procedure
      630       ) .
      631   end.
      632   define variable v-inform-launched as logical no-undo initial false .
      633   procedure proc-alt-shift-f4:
      634     define variable v-action as character no-undo .
      635     if v-inform-launched = false then do:
      636       assign
      637         v-inform-launched = true
      638       .
      639       run gbl/d-inform.w
      640         (  input self
      641         ,  input this-procedure
      642         , output v-action
      643         ) no-error .
      644       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      645       assign
      646         v-inform-launched = false
      647       .
      648     end.
      649   end.
      650   procedure proc-alt-f1:
      651     run gbl/corrhelp.p
      652       (input this-procedure
      653       ) .
      654   end .
      655   on alt-shift-f2 anywhere do:
      656     run proc-alt-shift-f2.
      657   end.
      658   on alt-shift-f3 anywhere do:
      659     run proc-alt-shift-f3 in this-procedure .
      660   end.
      661   on alt-shift-f4 anywhere do:
      662     run proc-alt-shift-f4 in this-procedure.
      663   end.
      664   on alt-f1 anywhere do:
      665     run proc-alt-f1 in this-procedure .
      666   end.
      667   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      668   procedure cli-grplib-get-full-name :
      669      define input parameter  p-node-code  as integer      no-undo.
      670      define output parameter p-full-name as character    no-undo.
      671   do
      672   on error undo, return error
      673   :
      674       define variable v-upper-code    as integer           no-undo.
      675       define buffer buf_cli-grp       for ub.cli-grp.
      676       define buffer buf_upper_cli-grp for ub.cli-grp.
      677       find first buf_cli-grp no-lock
      678            where buf_cli-grp.node-code = p-node-code
      679       no-error.
      680       if not available buf_cli-grp
      681       then do:
      682           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
      683       end.
      684       assign
      685           p-full-name  = ""
      686           v-upper-code = 1
      687       .
      688       do while buf_cli-grp.upper-code <> 0
      689       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      690       :
      691           assign
      692               p-full-name  = buf_cli-grp.node-name
      693                            + (if p-full-name <> "" then chr(47) else "")
      694                            + p-full-name
      695               v-upper-code = buf_cli-grp.upper-code
      696           .
      697           find first buf_cli-grp no-lock
      698                where buf_cli-grp.node-code = v-upper-code
      699           no-error.
      700           if not available buf_cli-grp
      701           then do:
      702               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
      703                                   + string( v-upper-code )
      704                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      705           end.
      706       end.
      707       assign
      708       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      709       .
      710   end.
      711   end .
      712   procedure cgrplib-get-node-from-full-name :
      713   define input parameter p-full-name as character no-undo .
      714   define output parameter p-node-code as integer no-undo .
      715   define variable v-ii as integer no-undo .
      716   define variable v-upper-code as integer no-undo .
      717   define variable v-root-code as integer no-undo .
      718   define variable v-entry as character no-undo .
      719   define buffer buf_cli-grp       for ub.cli-grp.
      720   do
      721   on error undo, return error
      722   :
      723     find first buf_cli-grp no-lock
      724         where buf_cli-grp.upper-code = 0
      725     no-error .
      726     if not available buf_cli-grp
      727     then do:
      728         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
      729     end.
      730     else do:
      731       assign
      732       v-root-code = buf_cli-grp.node-code
      733       .
      734     end.
      735     v-upper-code = v-root-code.
      736     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      737       assign
      738       v-entry = entry(v-ii, p-full-name, chr(47)).
      739       if v-entry = '' then leave.
      740       find first buf_cli-grp no-lock where
      741                 buf_cli-grp.node-name = v-entry
      742             and buf_cli-grp.upper-code = v-upper-code
      743             no-error.
      744       if not available buf_cli-grp then do:
      745         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      746       end.
      747       else do:
      748         p-node-code = buf_cli-grp.node-code.
      749         v-upper-code = buf_cli-grp.node-code.
      750       end.
      751     end.
      752   end.
      753   end .
      754   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      755   function windows-date-format returns character ( input p-date  as date, input p-format as character ):
      756   define variable v-string-date as character no-undo .
      757   CASE p-format:
      758     when "dd.mm.yyyy":U
      759     or
      760     when "dd.mm.yy":U
      761     or
      762     when "dd/mm/yy":U
      763     then do:
      764       assign
      765       p-format = replace(p-format, "dd", "99")
      766       p-format = replace(p-format, "mm", "99")
      767       p-format = replace(p-format, "yy", "99")
      768       v-string-date = string(p-date, p-format)
      769       .
      770     end.
      771     when "d.m.yy":U then do:
      772       ASSIGN
      773       v-string-date = string(day(p-date), ">9") + string(month(p-date), ">9") +
      774                       substring(string(p-date, "99/99/99"), 7, 2)
      775       .
      776     end.
      777     when "yyyy-mm-dd":U then do:
      778       ASSIGN
      779       v-string-date = string(year(p-date), "9999") + "-":U + string(month(p-date), "99") + string(day(p-date), "99")
      780       .
      781     end.
      782   END CASE.
      783   return v-string-date.
      784   END FUNCTION.
