     1603   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1604   define new shared temp-table gds-list no-undo like ub.goods
     1605     field qnty   as decimal
     1606     field to-del as logical
