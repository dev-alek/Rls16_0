        1   DEFINE BUFFER locked_thbj-attr FOR thbj-attr.
        2   DEFINE TEMP-TABLE tt-cash-pay-autotank NO-UNDO LIKE cash-pay
        3          field autotank-cdpay-code like ub.cash-pay.cdpay-code
        4          field autotank-obj-name as character
        5          index pi is unique primary autotank-cdpay-code.
        6   DEFINE TEMP-TABLE tt-sum-grp NO-UNDO LIKE sum-grp
        7          field code-2 as integer
        8          field gtype as integer.
        9   DEFINE BUFFER X_shop FOR shop.
       10   DEFINE BUFFER X_sysconf FOR sysconf.
       11   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
       12   DEFINE INPUT PARAMETER p-mode AS CHARACTER NO-UNDO.
       13   DEFINE INPUT PARAMETER p-obj-type LIKE ub.clients.obj-type NO-UNDO.
       14   DEFINE INPUT PARAMETER p-obj-code LIKE ub.shop.obj-code NO-UNDO.
       15   define variable vss-revision    as character no-undo init "$Revision$":U .
       16   define variable vss-author      as character no-undo init "$Author$":U .
       17   define variable vss-date        as character no-undo init "$Date$":U .
       18   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       19   define variable vss-archive     as character no-undo init "$Archive$":U .
       20   define variable vss-description as character no-undo init "Редактирование атрибута магазина (thbj-attr) 'cd-type-Autotank'".
       21   procedure vss-get-info :
       22     define output parameter p-vss-revision    like vss-revision    no-undo .
       23     define output parameter p-vss-author      like vss-author      no-undo .
       24     define output parameter p-vss-date        like vss-date        no-undo .
       25     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       26     define output parameter p-vss-archive     like vss-archive     no-undo .
       27     define output parameter p-vss-description like vss-description no-undo .
       28     assign
       29       p-vss-revision    = vss-revision
       30       p-vss-author      = vss-author
       31       p-vss-date        = vss-date
       32       p-vss-workfile    = vss-workfile
       33       p-vss-archive     = vss-archive
       34       p-vss-description = vss-description
       35     .
       36   end procedure.
       37   procedure vss-get-parameters :
       38     define output parameter p-vss-parameters as character no-undo .
       39   end procedure.
       40   define new global shared variable g#vssrevis-logger as handle    no-undo .
       41   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       42   define variable v-vssrevis-logger                   as handle    no-undo .
       43   procedure vss-logevent :
       44     define input  parameter p-extra-paramters as character no-undo .
       45     define variable v-vssrevis-parameters as character no-undo .
       46     do
       47     on error undo, return error return-value
       48     :
       49       if  valid-handle(v-vssrevis-logger)
       50       and v-vssrevis-logger :get-signature("logevent") <> ""
       51       then do:
       52         run vss-get-parameters in this-procedure
       53           (output v-vssrevis-parameters
       54           ).
       55         run logevent in v-vssrevis-logger
       56           (input vss-workfile
       57           ,input vss-revision
       58           ,input v-vssrevis-parameters
       59           ,input p-extra-paramters
       60           ).
       61       end.
       62     end.
       63   end procedure.
       64   assign
       65     v-vssrevis-logger = g#vssrevis-logger
       66   .
       67   if  valid-handle(v-vssrevis-logger)
       68   and v-vssrevis-logger :get-signature("logevent") <> ""
       69   then do:
       70     assign
       71       v-vssrevis-logevent = true
       72     .
       73     run vss-logevent in this-procedure (input vss-description) .
       74   end.
       75   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   define variable v-waitfram-action01         as character   no-undo .
       77   define variable v-waitfram-action02         as character   no-undo .
       78   define variable v-waitfram-action03         as character   no-undo .
       79   define variable mWaitFramTextBeg            as character   no-undo.
       80   define variable mWaitFramTextEnd            as character   no-undo.
       81   define variable mWaitFramView               as logical     no-undo.
       82   define variable mWaitProcEvent              as logical     no-undo init yes.
       83   define variable mWaitFramInterval           as integer     no-undo init 1 .
       84   define variable mWaitFramStop               as logical     no-undo.
       85   define variable mWaitFramStopUser           as logical     no-undo.
       86   define variable mWaitFramStopTimeOut        as logical     no-undo.
       87   define variable mWaitFramStartProc          as datetime-tz no-undo.
       88   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       89   define button B-WaitFramStop auto-end-key
       90        label "Стоп"
       91        size 10 by 1 tooltip "Остоновить процесс".
       92   define button B-viewProcInfo
       93        label "Информация"
       94        size 15 by 1 tooltip "Информация о процесс".
       95   define frame waitfram
       96     v-waitfram-action01 format "x(72)" no-label skip
       97     v-waitfram-action02 format "x(72)" no-label skip
       98     v-waitfram-action03 format "x(72)" no-label skip
       99     B-viewProcInfo
      100     B-WaitFramStop at row 4 col 30
      101     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      102     .
      103   define new global shared variable mBatchMode as logical no-undo init ?.
      104   define variable mFramBachModHandle as handle no-undo.
      105   mFramBachModHandle = frame waitfram:handle.
      106   define variable mFameOldVis as logical no-undo.
      107   define variable mVisCUrentVin as logical no-undo.
      108   if session:batch-mode
      109   then
      110      mBatchMode = yes.
      111   if mBatchMode = ? then do:
      112     mVisCUrentVin = current-window:visible.
      113     mFameOldVis = mFramBachModHandle:visible.
      114     mFramBachModHandle:visible  = yes.
      115     mBatchMode = mFramBachModHandle:visible ne yes.
      116     mFramBachModHandle:visible = mFameOldVis.
      117     current-window:visible = mVisCUrentVin.
      118   end.
      119    if  log-manager:logfile-name ne ?
      120     then DO:
      121         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      122         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      123         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      124     end.
      125   on choose of B-WaitFramStop in frame waitfram
      126   do:
      127     mWaitFramStop = yes.
      128     mWaitFramStopUser = yes.
      129   end.
      130   function waitfram-check-timeout returns logical():
      131      define variable vtime as int64 no-undo.
      132      if mWaitFramStopTimeOut
      133      then
      134         return yes.
      135      vtime = ( now - mWaitFramStartProc ) / 1000 .
      136      if     mWaitFramTimeOut ne ?
      137         and mWaitFramTimeOut ne 0
      138         and mWaitFramTimeOut lt vtime
      139      then do:
      140         mWaitFramStopTimeOut = yes.
      141      end.
      142      return mWaitFramStopTimeOut.
      143   end.
      144   procedure waitfram-hide :
      145     if not session:batch-mode
      146     then do
      147     on error undo, return error return-value
      148     :
      149       pause 0 before-hide .
      150       if not mBatchMode then
      151         hide frame waitfram .
      152     if     not mWaitFramView
      153        and mWaitProcEvent
      154     then
      155       process events .
      156     end.
      157   end procedure.
      158   procedure waitfram-show :
      159     define input  parameter p-message as character no-undo .
      160     define variable v-left-margin as integer   no-undo .
      161     if not session:batch-mode
      162     then do
      163     on error undo, return error return-value
      164     :
      165       if length(p-message) <= 70 then do:
      166         assign
      167           v-left-margin = integer((70 - length(p-message)) / 2)
      168         .
      169         assign
      170           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      171         .
      172         assign
      173           v-waitfram-action01 = " "
      174           v-waitfram-action02 = " "
      175                                    + fill(" ", v-left-margin)
      176                                    + p-message
      177           v-waitfram-action03 = " "
      178         .
      179       end.
      180       else do:
      181         define variable vRindex1 as integer no-undo.
      182         define variable vRindex2 as integer no-undo.
      183         vRindex1 = r-index(p-message," ",70).
      184         if vRindex1 = 0
      185         then
      186            vRindex1 = 70.
      187         if length(p-message)  <= vRindex1 + 70 then do:
      188           assign
      189             v-waitfram-action01 = " "
      190             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      191             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      192           .
      193         end.
      194         else do:
      195           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      196           if vRindex2 <= vRindex1
      197           then
      198              vRindex2 = vRindex1 + 70.
      199           assign
      200             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      201             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      202             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      203           .
      204         end.
      205       end.
      206       B-viewProcInfo:visible   in frame waitfram = no.
      207       B-viewProcInfo:sensitive in frame waitfram = no.
      208       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      209       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      210       if  (   mWaitFramView
      211          or  mWaitProcEvent)
      212          and not mBatchMode
      213       then
      214          display
      215             v-waitfram-action01 skip
      216             v-waitfram-action02 skip
      217             v-waitfram-action03 skip
      218          with frame waitfram .
      219       if     mWaitFramView
      220          then do:
      221             if     mWaitFramInterval ne ?
      222                and not mBatchMode
      223             then
      224                wait-for go of frame waitfram pause mWaitFramInterval.
      225          end.
      226          else
      227             if     mWaitProcEvent
      228                and not mBatchMode
      229             then
      230                process events .
      231     end.
      232   end procedure.
      233      procedure waitfram-show-this:
      234         define input  parameter iInterval as int64 no-undo.
      235         define variable vtime as int64 no-undo.
      236         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      237         mWaitFramInterval = iInterval.
      238         run waitfram-show (substitute("&1&2 &3&4" ,
      239                                       mWaitFramTextBeg ,
      240                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      241                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      242                                       mWaitFramTextEnd
      243                                      )
      244                           ).
      245      end.
      246      procedure WaitFramRunPause:
      247         define input  parameter iInterval as dec no-undo.
      248         define variable vStart  as datetime-tz no-undo.
      249         define variable vend    as datetime-tz no-undo.
      250         define variable vint as int64 no-undo.
      251         define variable vOk as logical no-undo.
      252         vStart = now.
      253         vend   = vStart.
      254         publish "WaitFramPause" (iInterval,output vOk).
      255         vend   =  now.
      256         vint = vend - vStart.
      257         vint = iInterval - vint / 1000.
      258         if     not mWaitFramStop
      259            and (   vint > 0
      260                 or (    not vOk
      261                     and iInterval eq ?
      262                     )
      263                 )
      264         then
      265            run waitfram-show-this (iInterval).
      266         vend   =  now.
      267         vint = vend - vStart.
      268         vint = iInterval - vint / 1000.
      269         if     not mWaitFramStop
      270            and vint > 0
      271         then do:
      272            run gbl/pause.p (vint * 1000).
      273         end.
      274         if iInterval ne ?
      275         then
      276            publish "WaitFramStop".
      277         waitfram-check-timeout().
      278      end.
      279      procedure WaitFramWaitFor:
      280         define input  parameter iInterval as dec no-undo.
      281         assign
      282            mWaitFramStartProc   = now
      283            mWaitFramStopUser    = no
      284            mWaitFramStopTimeOut = no
      285         .
      286         block-wait:
      287         do while not mWaitFramStop:
      288            run WaitFramRunPause (iInterval).
      289            if  waitfram-check-timeout()
      290            then do:
      291               leave block-wait.
      292            end.
      293         end.
      294         run waitfram-hide.
      295      end.
      296   procedure waitfram-join :
      297     define input  parameter p-line-1  as character no-undo .
      298     define input  parameter p-line-2  as character no-undo .
      299     define input  parameter p-line-3  as character no-undo .
      300     define output parameter p-message as character no-undo .
      301     do
      302     on error undo, return error return-value
      303     :
      304       assign
      305         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      306                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      307                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      308       .
      309     end.
      310   end procedure.
      311   function waitfram-join-function returns character
      312     (input p-line-1 as character
      313     ,input p-line-2 as character
      314     ,input p-line-3 as character
      315     ).
      316     define variable v-message as character no-undo .
      317     run waitfram-join in this-procedure
      318       (input  p-line-1
      319       ,input  p-line-2
      320       ,input  p-line-3
      321       ,output v-message
      322       ) .
      323     return v-message .
      324   end function .
      325   define new global shared variable g#language as character no-undo .
      326   if g#language <> '' and g#language <> 'rus':U then do:
      327     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      328   end.
      329   define new global shared variable g#library  as handle no-undo .
      330   define new global shared variable g#library2 as handle no-undo .
      331   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      332   define new global shared variable g#attr-lib  as handle no-undo .
      333   define variable v-attr-lib-variable as handle no-undo .
      334   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      335   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      336   procedure thbjattr_code :
