      370   procedure thbjattr_code_reg :
      371   define input  parameter p-upper-code     as character no-undo .
      372   define input  parameter p-code           as character no-undo .
      373   define output parameter p-label          as character no-undo .
      374   define output parameter p-user-can-edit  as logical   no-undo .
      375   define output parameter p-output-display as logical   no-undo .
      376   define output parameter p-other          as character no-undo .
      377   define output parameter p-prop-list      as character no-undo .
      378   define output parameter p-prop-type-list as character no-undo .
      379   define output parameter p-prop-label-list as character no-undo .
      380   define output parameter p-global          as logical no-undo .
      381   define output parameter p-host           as logical no-undo .
      382   define output parameter p-shop           as logical no-undo .
      383   define output parameter p-store          as logical no-undo .
      384   define output parameter p-db             as logical no-undo .
      385   define output parameter p-region         as logical no-undo .
      386   do
      387   on error undo, return error return-value
      388   :
      389       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      390       (input  p-upper-code
      391       ,input  p-code
      392       ,output p-label
      393       ,output p-user-can-edit
      394       ,output p-output-display
      395       ,output p-other
      396       ,output p-prop-list
      397       ,output p-prop-type-list
      398       ,output p-prop-label-list
      399       ,output p-global
      400       ,output p-host
      401       ,output p-shop
      402       ,output p-store
      403       ,output p-db
      404       ,output p-region
      405       ) no-error .
      406     if error-status :error
      407     then do:
      408       undo, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message (1)).
      409     end.
      410   end.
      411   end procedure.
