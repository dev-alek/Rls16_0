        1   define input  param ittl     as character no-undo .
        2   define output param en-pswd as character no-undo .
        3   def var vss-revision    as character no-undo init "$Revision$":U .
        4   def var vss-author      as character no-undo init "$Author$":U .
        5   def var vss-date        as character no-undo init "$Date$":U .
        6   def var vss-workfile    as character no-undo init "$Workfile$":U .
        7   def var vss-archive     as character no-undo init "$Archive$":U .
        8   def var vss-description as character no-undo init "Запрос пароля".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1':u,ittl)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   DEFINE BUTTON b-exit AUTO-GO
      116        LABEL "&Ввод "
      117        SIZE 10 BY 1
      118        BGCOLOR 8 .
      119   DEFINE BUTTON b-help
      120        LABEL "Помо&щь"
      121        SIZE 10 BY 1
      122        BGCOLOR 8 .
      123   DEFINE BUTTON b-quit AUTO-END-KEY
      124        LABEL "&Отмена"
      125        SIZE 10 BY 1
      126        BGCOLOR 8 .
      127   DEFINE VARIABLE TTL AS CHARACTER
      128        VIEW-AS EDITOR SCROLLBAR-VERTICAL LARGE
      129        SIZE 52 BY 6 NO-UNDO.
      130   DEFINE VARIABLE pswd AS CHARACTER FORMAT "X(50)":U
      131        LABEL "&Пароль"
      132        VIEW-AS FILL-IN
      133        SIZE 44 BY 1 NO-UNDO.
      134   DEFINE FRAME d-ask-pswd
      135        pswd AT ROW 9.75 COL 10 COLON-ALIGNED BLANK  PASSWORD-FIELD
      136        b-exit AT ROW 1 COL 1
      137        b-quit AT ROW 1 COL 11
      138        b-help AT ROW 1 COL 21
      139        TTL AT ROW 3 COL 4 NO-LABEL WIDGET-ID 4
      140        SPACE(2.99) SKIP(1.66)
      141       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      142            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      143            TITLE "Ввод пароля "
      144            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit.
      145   ASSIGN
      146          FRAME d-ask-pswd:SCROLLABLE       = FALSE
      147          FRAME d-ask-pswd:HIDDEN           = TRUE.
      148   ASSIGN
      149          TTL:READ-ONLY IN FRAME d-ask-pswd        = TRUE.
      150   ON WINDOW-CLOSE OF FRAME d-ask-pswd
      151   DO:
      152     APPLY "END-ERROR":U TO SELF.
      153   END.
      154   ON CHOOSE OF b-exit IN FRAME d-ask-pswd
      155   DO:
      156      en-pswd = encode (input pswd).
      157   END.
      158   ON CHOOSE OF b-quit IN FRAME d-ask-pswd
      159   DO:
      160      en-pswd = ?.
      161   END.
      162   ON LEAVE OF pswd IN FRAME d-ask-pswd
      163   DO:
      164   END.
      165   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-ask-pswd:PARENT eq ?
      166   THEN FRAME d-ask-pswd:PARENT = ACTIVE-WINDOW.
      167   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      168   on help of frame d-ask-pswd
      169   do:
      170     run gbl/app_help.p
      171       (input this-procedure :file-name
      172       ,input ''
      173       ,input ?
      174       ) no-error.
      175     if error-status :error then do:
      176       message
      177         "Ошибка при вызове помощи"
      178         error-status :get-message(1)
      179         view-as alert-box .
      180     end.
      181   end.
      182   run minbtn-set in this-procedure .
      183   on choose of b-help in frame d-ask-pswd
      184   do:
      185     apply "help":u to frame d-ask-pswd .
      186   end.
      187   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      188   procedure minbtn-set :
      189       do
      190           on error undo, return error return-value
      191           :
      192           define variable ii              as integer       no-undo .
      193           define variable fh              as widget-handle no-undo .
      194           define variable hh              as widget-handle no-undo .
      195           define variable v-h             as handle        extent 4 no-undo .
      196           define variable v-name-button   as character     no-undo .
      197           define variable v-help-old-x    as decimal       no-undo .
      198           define variable v-help-old-y    as decimal       no-undo .
      199           define variable v-help-old-size as decimal       no-undo .
      200           define variable v-frame-width   as decimal       no-undo .
      201           define variable jj              as integer       no-undo .
      202           do
      203               on error undo, return error
      204               :
      205               assign
      206                   v-frame-width = frame d-ask-pswd:width - 0.3
      207                   fh            = frame d-ask-pswd:first-child
      208                   hh            = fh:first-child
      209                   ii            = 1
      210                   .
      211               do while valid-handle(hh):
      212                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      213                   do:
      214                       case lc(hh:name) :
      215                           when "b-help" then
      216                               do:
      217                                   hh:load-image-up("cmp/b-help.bmp":u) .
      218                                   hh:load-image-down("cmp/b-help.bmp":u) .
      219                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      220                                   hh:TOOLTIP = "Помощь" .
      221                                   v-help-old-x = hh:column .
      222                                   v-help-old-y = hh:row    .
      223                                   v-help-old-size = hh:width .
      224                                   hh:width-chars = 2.5 .
      225                               end.
      226                           when "b-print" then
      227                               do:
      228                                   hh:load-image("cmp/b-print.bmp":u) .
      229                                   hh:TOOLTIP = "Печать" .
      230                                   v-h[ii] = hh:handle .
      231                                   ii = ii + 1 .
      232                                   hh:width-chars = 3 .
      233                               end.
      234                           when "b-history" or
      235                           when "b-hist" then
      236                               do:
      237                                   hh:load-image("cmp/b-hist.bmp":u) .
      238                                   hh:TOOLTIP = "История" .
      239                                   v-h[ii] = hh:handle .
      240                                   ii = ii + 1 .
      241                                   hh:width-chars = 3 .
      242                               end.
      243                           when "b-sch" then
      244                               do:
      245                                   hh:load-image("cmp/b-sch.bmp":u) .
      246                                   hh:TOOLTIP = "Установка Фильтра" .
      247                                   v-h[ii] = hh:handle .
      248                                   ii = ii + 1 .
      249                                   hh:width-chars = 3 .
      250                               end.
      251                           when "b-hist-user" then
      252                               do:
      253                                   hh:load-image("cmp/b-hist.bmp":u) .
      254                                   hh:TOOLTIP = "История пользователя" .
      255                                   ii = ii + 1 .
      256                               end.
      257                       end case.
      258                   end.
      259                   hh = hh:next-sibling.
      260               end.
      261               b-help:column = v-frame-width - b-help:width-chars.
      262               jj = 0.
      263               repeat ii = 4 to 1 by -1 :
      264                   if valid-handle (v-h[ii] ) then
      265                   do:
      266                       jj  = jj + 1 .
      267                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      268                       v-h[ii]:row    = v-help-old-y .
      269                   end.
      270               end.
      271           end.
      272       end.
      273   end procedure.
      274   MAIN-BLOCK:
      275   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      276      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      277     en-pswd = "".
      278     RUN enable_UI.
      279     ttl:screen-value = iTTL.
      280     WAIT-FOR GO OF FRAME d-ask-pswd.
      281   END.
      282   RUN disable_UI.
      283   PROCEDURE disable_UI :
      284     HIDE FRAME d-ask-pswd.
      285   END PROCEDURE.
      286   PROCEDURE enable_UI :
      287     DISPLAY TTL pswd
      288         WITH FRAME d-ask-pswd.
      289     ENABLE b-exit b-quit b-help pswd
      290         WITH FRAME d-ask-pswd.
      291     VIEW FRAME d-ask-pswd.
      292   END PROCEDURE.
