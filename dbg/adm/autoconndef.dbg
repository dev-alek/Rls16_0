        1   block-level on error undo, throw.
        2   define input  parameter p-user-login    as character no-undo .
        3   define input  parameter p-user-password as character no-undo .
        4   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        5   define new shared variable g#auto-pid           as integer   no-undo .
        6   define new shared variable conn-par             as character no-undo .
        7   define new shared variable g#auto-user-id       as character no-undo .
        8   define new shared variable g#auto-user-login    as character no-undo .
        9   define new shared variable g#auto-user-password as character no-undo .
       10   define new shared variable v-socket             as logical   no-undo .
       11   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       12   define new shared variable auto-window-h     as handle    no-undo .
       13   define new shared variable auto-log-msg-h    as handle    no-undo .
       14   define new shared variable hand-log-msg-h    as handle    no-undo .
       15   define new shared variable log-file-name     as character no-undo initial ? .
       16   define new shared variable add-log-file-name as character no-undo initial ? .
       17   define new shared variable writelogvalue     as character no-undo initial ? .
       18   run adm/autoinit.p ( input p-user-login
       19                       ,input p-user-password
       20                     ) no-error.
       21   if error-status:error
       22   then
       23      return error.
       24   run adm/autoconn.p no-error.
       25   if error-status:error
       26   then
       27      return error.
