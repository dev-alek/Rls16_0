        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: chkdbkey.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: adm/chkdbkey.p $":U .
        7   define variable vss-description as character no-undo init "Процедура проверки правильности кодировки ключей БД".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       67   procedure cur-time :
       68      define output parameter p-today as date      no-undo .
       69      define output parameter p-time  as integer   no-undo .
       70     do
       71     on error undo, return error
       72     :
       73       define variable v-date1 as date      no-undo .
       74       define variable v-date2 as date      no-undo .
       75       define variable v-time  as integer   no-undo .
       76       assign
       77         v-date1 = today
       78         v-time  = time
       79         v-date2 = today
       80       .
       81       if v-date1 <> v-date2
       82       then do:
       83         assign
       84           v-date1 = today
       85           v-time  = v-time
       86         .
       87       end.
       88       assign
       89         p-today = v-date1
       90         p-time  = v-time
       91       .
       92     end.
       93   end.
       94   function cur-time-date returns character
       95   :
       96     return string(today, '99/99/9999':U) .
       97   end.
       98   function cur-time-mjd returns decimal
       99   :
      100     define variable v-date as date      no-undo .
      101     define variable v-time as integer   no-undo .
      102     run cur-time in this-procedure
      103       (output v-date
      104       ,output v-time
      105       ) .
      106     return integer(v-date) - 2400002 + (v-time / 86400) .
      107   end.
      108   function cur-time-get-ending-index returns integer
      109   (input p-number as integer
      110   )
      111   :
      112     if p-number < 0
      113     or p-number = ?
      114     then do:
      115       return 1 .
      116     end.
      117     define variable v-rest as integer   no-undo .
      118     assign
      119       p-number = p-number modulo 100
      120     .
      121     if p-number < 20
      122     then do:
      123       assign
      124         v-rest = p-number
      125       .
      126     end.
      127     else do:
      128       assign
      129         v-rest = p-number modulo 10
      130       .
      131     end.
      132     case v-rest :
      133       when 1
      134       then do:
      135         return 2 .
      136       end.
      137       when 2 or
      138       when 3 or
      139       when 4
      140       then do:
      141         return 3 .
      142       end.
      143       otherwise do:
      144         return 1 .
      145       end.
      146     end case .
      147   end.
      148   procedure cur-time-mjd-to-date :
      149      define input  parameter i-mjd-diff as decimal no-undo.
      150      define output parameter o-Date     as date    no-undo.
      151      define output parameter o-Time     as integer no-undo.
      152      define variable v-day-number as integer   no-undo .
      153      if    i-mjd-diff < 0
      154         or i-mjd-diff = ?
      155      then do:
      156         return "?" .
      157      end.
      158      assign
      159         v-day-number = truncate(i-mjd-diff,0).
      160         o-Date = date(v-day-number + 2400002).
      161         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      162     .
      163   end.
      164   function cur-time-mjd-to-string returns character
      165   (input p-mjd-diff as decimal
      166   )
      167   :
      168     define variable v-day-number as integer   no-undo .
      169     define variable v-seconds    as integer   no-undo .
      170     define variable v-hour       as integer   no-undo .
      171     define variable v-min        as integer   no-undo .
      172     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      173     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      174     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      175     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      176     if p-mjd-diff < 0
      177     or p-mjd-diff = ?
      178     then do:
      179       return "?" .
      180     end.
      181     assign
      182       v-day-number = integer(truncate(p-mjd-diff,0))
      183       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      184     .
      185     if v-seconds > 86400
      186     then do:
      187       assign
      188         v-seconds = 86400 - 1
      189       .
      190     end.
      191     if v-seconds < 0
      192     then do:
      193       assign
      194         v-seconds = 0
      195       .
      196     end.
      197     assign
      198       v-hour = truncate(v-seconds / 3600, 0)
      199     .
      200     assign
      201       v-seconds = v-seconds modulo 3600
      202     .
      203     assign
      204       v-min = truncate(v-seconds / 60, 0)
      205     .
      206     assign
      207       v-seconds = v-seconds modulo 60
      208     .
      209     return
      210         (if v-day-number <> 0
      211           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      212           else ""
      213         )
      214       + (if v-day-number <> 0 or v-hour <> 0
      215           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      216           else ""
      217         )
      218       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      219           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      220           else ""
      221         )
      222       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      223       .
      224   end.
      225   function cur-time-string returns character
      226   :
      227     define variable v-date as date      no-undo .
      228     define variable v-time as integer   no-undo .
      229     run cur-time in this-procedure
      230       (output v-date
      231       ,output v-time
      232       ) .
      233     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      234   end.
      235   function cur-time-string-sec returns character
      236   :
      237     define variable v-date as date      no-undo .
      238     define variable v-time as integer   no-undo .
      239     run cur-time in this-procedure
      240       (output v-date
      241       ,output v-time
      242       ) .
      243     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      244   end.
      245   function cur-time-custom  returns character
      246   (input p-prefix as character
      247   ,input p-date-format as character
      248   ,input p-delimiter as character
      249   ,input p-time-format as character
      250   ,input p-suffix as character
      251   )
      252   :
      253     define variable v-date as date      no-undo .
      254     define variable v-time as integer   no-undo .
      255     run cur-time in this-procedure
      256       (output v-date
      257       ,output v-time
      258       ) .
      259     return
      260       p-prefix
      261       + string(v-date, p-date-format)
      262       + p-delimiter
      263       + string(v-time, p-time-format)
      264       + p-suffix
      265       .
      266   end.
      267   function cur-time-print  returns character
      268   :
      269     define variable v-date as date      no-undo .
      270     define variable v-time as integer   no-undo .
      271     run cur-time in this-procedure
      272       (output v-date
      273       ,output v-time
      274       ) .
      275     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      276   end.
      277   function cur-time-datetime returns datetime
      278   :
      279     define variable v-char as character no-undo .
      280     define variable v-datetime as datetime no-undo .
      281     v-char = cur-time-string().
      282     v-datetime = datetime(v-char).
      283     return  v-datetime.
      284   end.
      285   function cur-time-string-msec returns character
      286   :
      287     define variable v-date as datetime  no-undo .
      288     v-date = now.
      289     return string(v-date) .
      290   end.
      291   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      292   Function reverse returns character (str as character).
      293      define variable rev_incl_s as character init "" no-undo .
      294      define variable rev_incl_i as integer no-undo .
      295      define variable rev_incl_l as integer no-undo .
      296      rev_incl_l = length(str).
      297      do rev_incl_i = 1 to rev_incl_l:
      298         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      299      end.
      300      return rev_incl_s.
      301   end.
      302   procedure check-enc.
      303     define input  parameter p-db-num    as integer   no-undo .
      304     define input  parameter p-db-key    as character no-undo .
      305     define input  parameter p-code      as character no-undo .
      306     define input  parameter p-value     as character no-undo .
      307     define input  parameter p-beg-date  as date      no-undo .
      308     define input  parameter p-end-date  as date      no-undo .
      309     define input  parameter p-enc-value as character no-undo .
      310     define output parameter p-answer    as logical   no-undo .
      311     define variable tmp         as character no-undo .
      312     define variable v-enc-value as character no-undo .
      313     if p-db-num <> 0
      314       and p-db-key = "":U
      315     then do:
      316       assign
      317         p-answer = true
      318       .
      319       return.
      320     end.
      321     if p-db-key = "unload-db":U then do:
      322       assign
      323         p-answer = true
      324       .
      325       return.
      326     end.
      327     if p-code = ""  then do:
      328       assign
      329         tmp = string( p-db-num ) + reverse (p-db-key).
      330       .
      331     end.
      332     else do:
      333       assign
      334         tmp = string( p-db-num )
      335               + trim( p-db-key )
      336               + reverse( trim( p-code ) )
      337               + reverse( trim( p-value ) )
      338               + reverse( string( p-beg-date, "99.99.9999" ) )
      339               + reverse( string( p-end-date, "99.99.9999" ) )
      340       .
      341     end.
      342     run pswd-enc in this-procedure
      343       ( input tmp
      344        ,output v-enc-value
      345       ) no-error .
      346     if error-status:error then do:
      347       message
      348         vss-workfile vss-revision vss-description skip
      349         "Ошибка при вызове процедуры pswd-enc" skip
      350         return-value skip
      351         error-status :get-message(1) skip
      352         view-as alert-box error .
      353       undo, return error .
      354     end.
      355     if v-enc-value = p-enc-value then do:
      356       assign
      357         p-answer = true
      358       .
      359     end.
      360     else do:
      361       assign
      362         p-answer = false
      363       .
      364     end.
      365   end.
      366   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      367   procedure pswd-enc :
      368     define input parameter  pswd     as character no-undo .
      369     define output parameter enc-pswd as character no-undo .
      370     do
      371     on error undo, return error return-value
      372     :
      373       assign
      374         enc-pswd = encode(pswd + string(index(pswd, "k")))
      375       .
      376     end.
      377   end procedure.
      378   define new global shared variable g#library  as handle no-undo .
      379   define new global shared variable g#library2 as handle no-undo .
      380   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      381   procedure get-ro_get-read-only :
      382     define output parameter p-ro-set as logical   no-undo .
      383     do
      384     on error  undo, return error substitute( "&1(get-ro_get-read-only). &2&3&4", vss-include-info3, return-value, error-status :get-message( 1 ) )
      385     on stop   undo, return error substitute( "&1(get-ro_get-read-only). stop", vss-include-info3 )
      386     on endkey undo, return error substitute( "&1(get-ro_get-read-only). endkey", vss-include-info3 )
      387     :
      388       if lookup( 'READ-ONLY':U, DBRESTRICTIONS('ub':U) ) > 0
      389       then do:
      390         assign
      391           p-ro-set = true
      392         .
      393       end.
      394       else do:
      395         assign
      396           p-ro-set = false
      397         .
      398       end.
      399     end.
      400   end procedure.
      401   do
      402   on error  undo, return error
      403   :
      404     define variable v-ind              as integer   no-undo .
      405     define variable v-start-time       as int64     no-undo .
      406     define variable v-current-time     as character no-undo .
      407     define variable v-err-code         as integer   no-undo .
      408     define variable v-load-db-key-now  as logical   no-undo .
      409     define variable v-file-name        as character no-undo .
      410     define variable v-log              as logical   no-undo .
      411     define variable v-str              as character no-undo .
      412     define variable v-last-key         as integer no-undo .
      413     define variable v-delimeter        as character no-undo .
      414     define variable v-num-entries      as integer no-undo .
      415     define variable v-check-db-num     as integer   no-undo .
      416     define variable v-check-user-id    as character no-undo .
      417     define variable v-check-user-admin as logical   no-undo .
      418     define variable v-get-ro_read-only as logical   no-undo .
      419     define variable v-db-num     like ub.db.db-num no-undo .
      420     define variable v-db-key     like ub.db.db-key no-undo .
      421     define variable v-db-key-enc like ub.db.db-key-enc no-undo .
      422     define buffer buf_db for ub.db .
      423     define stream NecesDb .
      424     define stream FileDbKey .
      425     create widget-pool .
      426     define variable w-login as widget-handle no-undo.
      427     create window w-login assign
      428            title              = "Проверка ключей БД"
      429            column             = 31.5
      430            row                = 9
      431            height             = 2.0
      432            width              = 10
      433            resize             = false
      434            scroll-bars        = false
      435            status-area        = false
      436            three-d            = true
      437            message-area       = false
      438            sensitive          = true
      439            visible            = true
      440            .
      441     define frame a
      442       v-ind           format ">>9"   label "Обработано ключей" skip
      443       v-current-time  format "x(8)"       label "Время" skip
      444       with view-as dialog-box side-labels three-d
      445       title "Проверка ключей БД"
      446       .
      447     assign
      448       current-window = w-login
      449       v-start-time   = etime
      450     .
      451     assign
      452       v-get-ro_read-only = false
      453     .
      454     run get-ro_get-read-only in this-procedure
      455       ( output v-get-ro_read-only
      456       ) .
      457     view frame a.
      458     disable triggers for load of ub.db .
      459     assign
      460       v-err-code        = -1
      461       v-load-db-key-now = TRUE
      462     .
      463     do while v-err-code <> 0
      464        and v-load-db-key-now = TRUE
      465     on error undo, return error
      466     :
      467       os-delete value( "neceskey.txt":U ) .
      468       assign
      469         v-ind = 0
      470       .
      471       display
      472         v-ind
      473         v-current-time
      474         with frame a .
      475       for each buf_db no-lock
      476       on error undo, return error
      477       :
      478         assign
      479           v-ind = v-ind + 1
      480         .
      481         if v-ind mod 10 = 0 then do:
      482           assign
      483             v-current-time = string(integer(truncate((etime - v-start-time) / 1000, 0)), 'HH:MM:SS':U)
      484           .
      485           display
      486             v-ind
      487             v-current-time
      488             with frame a.
      489         end.
      490         run check-enc in this-procedure
      491           ( input buf_db.db-num
      492            ,input buf_db.db-key
      493            ,input "":U
      494            ,input "":U
      495            ,input ?
      496            ,input ?
      497            ,input buf_db.db-key-enc
      498            ,output v-log
      499           ) no-error.
      500         if error-status :error then do:
      501           message
      502             vss-workfile vss-revision vss-description skip
      503             substitute( "Ошибка при проверке кодированых ключей БД! (1)" ) skip
      504             error-status :get-message ( error-status :num-messages )
      505             view-as alert-box error
      506           .
      507           return error .
      508         end.
      509         if v-log <> TRUE then do:
      510           assign
      511             v-err-code = 1
      512           .
      513           output stream NecesDb to "neceskey.txt":U append.
      514           put stream NecesDb unformatted
      515             substitute( "БД: &1 Ключ: &2 Кодированое значение: &3", buf_db.db-num, buf_db.db-key, buf_db.db-key-enc ) skip
      516           .
      517           output stream NecesDb close.
      518         end.
      519       end.
      520       if v-err-code > 0
      521       then do:
      522   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      523   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run getcurus in g#library2
      524     (output v-check-db-num
      525     ,output v-check-user-id
      526     ) no-error .
      527         if error-status :error then do:
      528           message
      529             vss-workfile vss-revision vss-description skip
      530             substitute("Ошибка при определении текущей БД и/или пользователя") skip
      531             error-status :get-message(1) skip
      532             return-value skip
      533             view-as alert-box error .
      534         end.
      535   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      536   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run user-adm in g#library2
      537     (input  v-check-db-num
      538     ,input  v-check-user-id
      539     ,output v-check-user-admin
      540     ) no-error .
      541         if error-status :error then do:
      542           message
      543             vss-workfile vss-revision vss-description skip
      544             substitute("Ошибка при определении является ли текущий пользователь администратором") skip
      545             error-status :get-message(1) skip
      546             return-value skip
      547             view-as alert-box error .
      548         end.
      549         if v-check-user-admin = true
      550           and v-get-ro_read-only = false
      551         then do:
      552           message
      553             "Требуется загрузка кодированых ключей БД!" skip
      554             "Список БД с неправильной кодировкой ключей выведен в файл" chr(32) "neceskey.txt":U skip
      555             "Загрузить кодированые ключи БД сейчас?" skip
      556             view-as alert-box question buttons yes-no update v-load-db-key-now.
      557           if v-load-db-key-now = TRUE then do:
      558             SYSTEM-DIALOG GET-FILE
      559               v-file-name
      560               FILTERS "Текстовые файлы  *.txt" "*.txt",
      561                       "Все файлы"  "*.*"
      562               MUST-EXIST
      563               TITLE "Выберите файл для импорта кодированых ключей"
      564               USE-FILENAME
      565               UPDATE v-log.
      566             if v-log <> true then do:
      567               return error .
      568             end.
      569             assign
      570               v-delimeter = chr(32)
      571               v-last-key  = 0
      572             .
      573             input stream FileDbKey from value(v-file-name) .
      574             block_read:
      575             repeat while v-last-key <> -2
      576             on error undo, return error
      577             :
      578               assign
      579                 v-last-key   = 0
      580                 v-str        = "":U
      581                 v-db-num     = -1
      582                 v-db-key     = "":U
      583                 v-db-key-enc = "":U
      584               .
      585               do while v-last-key <> 13
      586                        and v-last-key <> -2
      587               on error undo, return error
      588               :
      589                 readkey stream FileDbKey pause 0.
      590                 assign
      591                   v-last-key = lastkey
      592                   v-str = v-str + chr( v-last-key )
      593                 .
      594               end.
      595               assign
      596                 v-str = trim( v-str )
      597                 v-num-entries = num-entries( v-str, v-delimeter )
      598               .
      599               if v-str = "":U then do:
      600                 next.
      601               end.
      602               if v-num-entries > 3 then do:
      603                 message
      604                   vss-workfile vss-revision vss-description skip
      605                   substitute( "Некорректный файл ключей БД!" ) skip
      606                   error-status :get-message ( error-status :num-messages )
      607                   view-as alert-box error
      608                 .
      609                 assign
      610                   v-err-code = 1
      611                 .
      612                 leave block_read.
      613               end.
      614               assign
      615                 v-db-num = integer( entry( 1, v-str, v-delimeter ) ) no-error
      616               .
      617               if error-status :error then do:
      618                 message
      619                   vss-workfile vss-revision vss-description skip
      620                   substitute( "Ошибка при чтении файла ключей БД!" ) skip
      621                   error-status :get-message ( error-status :num-messages )
      622                   view-as alert-box error
      623                 .
      624                 assign
      625                   v-err-code = 1
      626                 .
      627                 leave block_read.
      628               end.
      629               if v-num-entries >= 2 then do:
      630                 assign
      631                   v-db-key = entry( 2, v-str, v-delimeter )
      632                 .
      633               end.
      634               if v-num-entries = 3 then do:
      635                 assign
      636                   v-db-key-enc = entry( 3, v-str, v-delimeter )
      637                 .
      638               end.
      639               find first buf_db
      640                 where buf_db.db-num = v-db-num
      641                 no-error
      642               .
      643               if not available buf_db then do:
      644                 next.
      645               end.
      646               if ( ( v-db-num = 0
      647                      and buf_db.db-key <> "":U
      648                    )
      649                    or v-db-num <> 0
      650                  )
      651                 and buf_db.db-key <> v-db-key
      652               then do:
      653                 message
      654                   vss-workfile vss-revision vss-description skip
      655                   substitute( "В файле импорта обнаружено несоответствие ключей по БД &1 !", v-db-num ) skip
      656                   substitute( "В БД: Ключ - &1", buf_db.db-key ) skip
      657                   substitute( "В файле: Ключ - &1", v-db-key ) skip
      658                   error-status :get-message ( error-status :num-messages )
      659                   view-as alert-box error
      660                 .
      661                 assign
      662                   v-err-code = 1
      663                 .
      664                 leave block_read.
      665               end.
      666               run check-enc in this-procedure
      667                 ( input v-db-num
      668                  ,input v-db-key
      669                  ,input "":U
      670                  ,input "":U
      671                  ,input ?
      672                  ,input ?
      673                  ,input v-db-key-enc
      674                  ,output v-log
      675                 ) no-error.
      676               if error-status :error then do:
      677                 message
      678                   vss-workfile vss-revision vss-description skip
      679                   substitute( "Ошибка при проверке кодированых ключей БД! (2)" ) skip
      680                   return-value skip
      681                   error-status :get-message ( error-status :num-messages )
      682                   view-as alert-box error
      683                 .
      684                 assign
      685                   v-err-code = 1
      686                 .
      687                 leave block_read.
      688               end.
      689               if v-log <> TRUE then do:
      690                 message
      691                   vss-workfile vss-revision vss-description skip
      692                   substitute( "В файле импорта обнаружена ошибка кодировки ключей БД!" ) skip
      693                   substitute( "БД: &1; Ключ БД: &2; Кодированое значение: &3", v-db-num, v-db-key, v-db-key-enc ) skip
      694                   error-status :get-message ( error-status :num-messages )
      695                   view-as alert-box error
      696                 .
      697                 assign
      698                   v-err-code = 1
      699                 .
      700                 leave block_read.
      701               end.
      702               if buf_db.db-key <> v-db-key then do:
      703                 assign
      704                   buf_db.db-key = v-db-key
      705                 .
      706               end.
      707               assign
      708                 buf_db.db-key-enc = v-db-key-enc
      709                 v-err-code        = 0
      710               .
      711             end.
      712             input stream FileDbKey close.
      713             if v-err-code = 0 then do:
      714               message
      715                 "Предоставленные кодированые значения ключей БД загружены!"
      716                 view-as alert-box information.
      717             end.
      718           end.
      719           else do:
      720             return error.
      721           end.
      722         end.
      723         else do:
      724           message "Требуется загрузка кодированых ключей БД!" skip
      725                   "Список БД с неправильной кодировкой ключей выведен в файл" chr(32) "neceskey.txt":U skip
      726                   "Обратитесь к администратору системы."
      727             view-as alert-box error.
      728           return error.
      729         end.
      730       end.
      731       else do:
      732         assign
      733           v-err-code = 0
      734         .
      735       end.
      736     end.
      737     hide frame a .
      738     delete object w-login .
      739   end.
      740   return.
