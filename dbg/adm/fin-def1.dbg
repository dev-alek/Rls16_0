      586   main-block:
      587   do for
      588   buf_sysconf
      589   on error undo, return error return-value
      590   on stop undo, return error return-value
      591   :
      592     find first buf_sysconf where
      593                 recid(buf_sysconf) = p-rec no-error .
      594     if not available buf_sysconf then do:
      595       v-err-mess = substitute("Не найдена запись СВОЯ ФИРМА - p-rec &1", p-rec).
      596       run err-mess in this-procedure ( input-output v-err-mess).
      597       undo main-block, return error "":U.
      598     end.
      599     if buf_sysconf.host-code <> p-host-code then do:
      600       message
      601       "Неверно задан параметр p-rec или p-host-code"
      602       view-as alert-box error .
      603       undo main-block, return error "":U.
      604     end.
      605     assign
      606     buf_sysconf.contract-city               = p-contract-city
      607     buf_sysconf.contract-type               = p-contract-type
      608     buf_sysconf.pay-sign-post               = p-pay-sign-post
      609     buf_sysconf.pay-sign                    = p-pay-sign
      610     buf_sysconf.fin-VAT-pc                  = p-fin-VAT-pc
      611     buf_sysconf.srok-opl                    = p-srok-opl
      612     buf_sysconf.srok-opl-sf                 = p-srok-opl-sf
      613     buf_sysconf.usl-opl                     = p-usl-opl
      614     buf_sysconf.usl-opl-sf                  = p-usl-opl-sf
      615     buf_sysconf.is-an-uchet                 = p-is-an-uchet
      616     buf_sysconf.is-code-cel-nazn            = p-is-code-cel-nazn
      617     buf_sysconf.is-corr-acc                 = p-is-corr-acc
      618     buf_sysconf.is-cassa-acc                = p-is-cassa-acc
      619     buf_sysconf.fin-calc                    = p-fin-calc
      620     buf_sysconf.pay-code-schet-rubl         = p-pay-code-schet-rubl
      621     buf_sysconf.pay-code-schet-base         = p-pay-code-schet-base
      622     buf_sysconf.an-uchet-code-out           = p-an-uchet-code-out
      623     buf_sysconf.cel-nazn-code-out           = p-cel-nazn-code-out
      624     buf_sysconf.cor-acc-out                 = p-cor-acc-out
      625     buf_sysconf.cor-acc1-out                = p-cor-acc1-out
      626     buf_sysconf.an-uchet-code-in            = p-an-uchet-code-in
      627     buf_sysconf.cel-nazn-code-in            = p-cel-nazn-code-in
      628     buf_sysconf.cor-acc-in                  = p-cor-acc-in
      629     buf_sysconf.cor-acc1-in                 = p-cor-acc1-in
      630     buf_sysconf.an-uchet-code-out-cash      = p-an-uchet-code-out-cash
      631     buf_sysconf.cel-nazn-code-out-cash      = p-cel-nazn-code-out-cash
      632     buf_sysconf.cor-acc-out-cash            = p-cor-acc-out-cash
      633     buf_sysconf.cor-acc1-out-cash           = p-cor-acc1-out-cash
      634     buf_sysconf.an-uchet-code-in-cash       = p-an-uchet-code-in-cash
      635     buf_sysconf.cel-nazn-code-in-cash       = p-cel-nazn-code-in-cash
      636     buf_sysconf.cor-acc-in-cash             = p-cor-acc-in-cash
      637     buf_sysconf.cor-acc1-in-cash            = p-cor-acc1-in-cash
      638     buf_sysconf.an-uchet-code-out-payoff    = p-an-uchet-code-out-payoff
      639     buf_sysconf.cel-nazn-code-out-payoff    = p-cel-nazn-code-out-payoff
      640     buf_sysconf.cor-acc-out-payoff          = p-cor-acc-out-payoff
      641     buf_sysconf.cor-acc1-out-payoff         = p-cor-acc1-out-payoff
      642     buf_sysconf.an-uchet-code-in-payoff     = p-an-uchet-code-in-payoff
      643     buf_sysconf.cel-nazn-code-in-payoff     = p-cel-nazn-code-in-payoff
      644     buf_sysconf.cor-acc-in-payoff           = p-cor-acc-in-payoff
      645     buf_sysconf.cor-acc1-in-payoff          = p-cor-acc1-in-payoff
      646     .
      647     release buf_sysconf no-error.
      648     if error-status:error then do:
      649       v-err-mess = substitute("Ошибка при сохранении записи СВОЯ ФИРМА &1: &2", p-host-code, ERROR-STATUS:GET-message(1)).
      650       run err-mess in this-procedure ( input-output v-err-mess ).
      651       undo main-block, return error (if p-silent = yes then v-err-mess else '':U).
      652     end.
      653     if p-fin-copy then do:
      654       run utl/fin-init.p (
      655                       input p-fin-host-copy
      656                     , input p-host-code
      657                     , input yes
      658                     , input yes
      659                     , input yes
      660                     , input yes) no-error .
      661       if error-status:error then do:
      662         v-err-mess = substitute("Ошибка при копировании настроек блока ВЗАИМОРАСЧЕТЫ с фирмы &1 на фирму &2: &3", p-fin-host-copy, p-host-code, ERROR-STATUS:GET-message(1)).
      663         run err-mess in this-procedure ( input-output v-err-mess ).
      664         undo, return error (if p-silent = yes then v-err-mess else '':U).
      665       end.
      666     end.
      667   end.
      668   PROCEDURE err-mess:
      669     DEFINE INPUT-output PARAMETER p-mess as character No-UNDO.
      670     CASE p-silent:
      671       when yes then do:
      672         p-mess = substitute("СВОЯ ФИРМА &1: &2", p-host-code,  p-mess).
      673       end.
      674       otherwise do:
      675         message
      676         p-mess
      677         view-as alert-box error .
      678       end.
      679     end.
      680   END PROCEDURE.
