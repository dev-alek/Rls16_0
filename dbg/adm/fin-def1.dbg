       73   define new global shared variable g#vssrevis-logger as handle    no-undo .
       74   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       75   define variable v-vssrevis-logger                   as handle    no-undo .
       76   procedure vss-logevent :
       77     define input  parameter p-extra-paramters as character no-undo .
       78     define variable v-vssrevis-parameters as character no-undo .
       79     do
       80     on error undo, return error return-value
       81     :
       82       if  valid-handle(v-vssrevis-logger)
       83       and v-vssrevis-logger :get-signature("logevent") <> ""
       84       then do:
       85         run vss-get-parameters in this-procedure
       86           (output v-vssrevis-parameters
       87           ).
       88         run logevent in v-vssrevis-logger
       89           (input vss-workfile
       90           ,input vss-revision
       91           ,input v-vssrevis-parameters
       92           ,input p-extra-paramters
       93           ).
       94       end.
       95     end.
       96   end procedure.
       97   assign
       98     v-vssrevis-logger = g#vssrevis-logger
