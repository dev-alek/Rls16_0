       59     define output parameter p-vss-archive     like vss-archive     no-undo .
       60     define output parameter p-vss-description like vss-description no-undo .
       61     assign
       62       p-vss-revision    = vss-revision
       63       p-vss-author      = vss-author
       64       p-vss-date        = vss-date
       65       p-vss-workfile    = vss-workfile
       66       p-vss-archive     = vss-archive
       67       p-vss-description = vss-description
       68     .
       69   end procedure.
       70   procedure vss-get-parameters :
