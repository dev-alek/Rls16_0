        1   block-level on error undo, throw.
        2   define input parameter        p-mode as character no-undo .
        3   define input parameter        p-silent as logical no-undo .
        4   define input-output parameter p-rec  as recid     no-undo .
        5   define input parameter        p-layout-type as character no-undo .
        6   define input parameter        p-device-type as character no-undo .
        7   define input parameter        p-mode-id as character no-undo .
        8   define input parameter        p-widget-id as character no-undo .
        9   define input parameter        p-widget-type as character no-undo .
       10   define input parameter        p-elem-type as integer no-undo .
       11   define input parameter        p-des as character no-undo .
       12   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       13   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       14   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile: layoute1.p $":U .
       16   define variable vss-archive     as character no-undo init "$Archive: adm/layoute1.p $":U .
       17   define variable vss-description as character no-undo init "Сохранение элемента  раскладки".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define   shared variable g#auto as logical no-undo.
       79   define   shared variable g#news as logical no-undo.
       80   define   shared variable g#oxml as logical no-undo.
       81   define   shared variable g#esys as logical no-undo.
       82   define   shared variable g#news-source-db as integer no-undo.
       83   define   shared variable g#esys-source-esys as integer no-undo.
       84   define   shared variable g#db-num as integer   no-undo .
       85   define   shared variable g#userid as character no-undo .
       86   define   shared variable g#passwd as character no-undo .
       87   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   procedure gen-key-rec :
       89     define input  parameter p-tbl-name    as character no-undo.
       90     define input  parameter p-bh_tbl-name as handle    no-undo.
       91     define output parameter p-key-rec     as character no-undo.
       92     do
       93     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       94     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       95     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       96     :
       97       define variable fh               as handle    no-undo .
       98       define variable v-ok             as logical   no-undo .
       99       define variable v-inform         as character no-undo .
      100       define variable v-ind            as integer   no-undo .
      101       define variable v-idx-field-qnty as integer   no-undo .
      102       if p-tbl-name = ?
      103         or p-tbl-name = "":U
      104       then do:
      105         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info0 ).
      106       end.
      107       if not p-bh_tbl-name:available then do:
      108         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info0, p-tbl-name ).
      109       end.
      110       assign
      111         p-key-rec = p-tbl-name
      112         v-inform  = p-bh_tbl-name:index-information(1)
      113         v-ind     = 2
      114       .
      115       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      116       on error undo, return error
      117       :
      118         assign
      119           v-inform = p-bh_tbl-name:index-information( v-ind )
      120           v-ind    = v-ind + 1
      121         .
      122       end.
      123       if v-inform = ?
      124         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      125         or entry( 3, v-inform, ",":U ) <> "1":U
      126       then do:
      127         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, p-tbl-name ).
      128       end.
      129       else do:
      130         assign
      131           v-idx-field-qnty = num-entries( v-inform ) - 4
      132         .
      133         if v-idx-field-qnty < 2 then do:
      134           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, p-tbl-name ).
      135         end.
      136         do v-ind = 1 to v-idx-field-qnty by 2
      137         on error undo, return error
      138         :
      139           assign
      140             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      141             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      142           .
      143         end.
      144       end.
      145       if p-key-rec = ? then do:
      146         assign
      147           p-key-rec = "":U
      148         .
      149         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info0, p-tbl-name ).
      150       end.
      151     end.
      152     return.
      153   end procedure.
      154   procedure gen-where-keyr-tab :
      155     define input  parameter i-tableSerach as character no-undo.
      156     define input  parameter i-tablekey   as character  no-undo.
      157     define input  parameter p-key-rec    as character  no-undo.
      158     define input  parameter p-key-handle as handle     no-undo .
      159     define input  parameter p-db-name    as character  no-undo .
      160     define input  parameter p-tt-handle  as handle     no-undo .
      161     define output parameter o-Where      as character  no-undo.
      162     do
      163     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      164     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      165     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      166     :
      167       define variable v-full-tbl-name  as character no-undo .
      168       define variable bh_tbl-name      as handle    no-undo .
      169       define variable fh_key           as handle    no-undo .
      170       define variable fh_search        as handle    no-undo .
      171       define variable v-field-num      as integer   no-undo .
      172       define variable v-count-fld      as integer   no-undo .
      173       define variable v-inform         as character no-undo .
      174       define variable v-ind            as integer   no-undo .
      175       define variable v-idx-field-qnty as integer   no-undo .
      176       define variable v-field-name     as character no-undo .
      177       define variable v-field-val      as character no-undo .
      178       define variable v-word-link      as character no-undo .
      179       define variable vTable           as character no-undo.
      180       define variable bh_tbl-key       as handle    no-undo .
      181       assign
      182         p-key-rec = trim( p-key-rec )
      183       .
      184       if p-key-handle <> ? then do:
      185         if not valid-handle(p-key-handle)
      186            or p-key-handle:type <> "buffer"
      187         then do:
      188           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info0 ).
      189         end.
      190         if num-entries( p-key-rec, chr(3) ) > 1
      191           or p-key-rec = ?
      192           or p-key-rec = "":U
      193         then do:
      194           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info0, p-key-rec ).
      195         end.
      196       end.
      197       else do:
      198         if p-key-rec = ?
      199           or p-key-rec = "":U
      200         then do:
      201           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      202         end.
      203       end.
      204       assign
      205         vTable = entry( 1 , p-key-rec, chr(3) )
      206       .
      207       if p-tt-handle <> ?
      208         and ( not valid-handle(p-tt-handle)
      209               or p-tt-handle:type <> "buffer"
      210             )
      211       then do:
      212         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info0, vTable, chr(10) ).
      213       end.
      214       if p-tt-handle = ? then do:
      215         assign
      216           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      217         .
      218         create buffer bh_tbl-name for table v-full-tbl-name .
      219       end.
      220       else do:
      221         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      222       end.
      223       assign
      224         v-inform = bh_tbl-name:index-information(1)
      225         v-ind    = 2
      226       .
      227       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      228       on error undo, return error
      229       :
      230         assign
      231           v-inform = bh_tbl-name:index-information( v-ind )
      232           v-ind    = v-ind + 1
      233         .
      234       end.
      235       if v-inform = ?
      236         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      237         or entry( 3, v-inform, ",":U ) <> "1":U
      238       then do:
      239         delete object bh_tbl-name no-error.
      240         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info0, vTable ).
      241       end.
      242       assign
      243         v-idx-field-qnty = num-entries( v-inform ) - 4
      244       .
      245       if v-idx-field-qnty < 2 then do:
      246         delete object bh_tbl-name no-error.
      247         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, vTable ).
      248       end.
      249       assign
      250         o-where     = "where":U
      251         v-word-link = "":U
      252         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      253         v-count-fld = 0
      254       .
      255       if i-tablekey ne "" and i-tablekey ne ?
      256       then do:
      257         assign
      258           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      259         .
      260         create buffer bh_tbl-key for table v-full-tbl-name .
      261       end.
      262       if i-tableSerach ne "" and i-tableSerach ne ?
      263       then do:
      264         delete object bh_tbl-name no-error.
      265         assign
      266           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      267         .
      268         create buffer bh_tbl-name for table v-full-tbl-name .
      269       end.
      270       block_where:
      271       do v-ind = 1 to v-idx-field-qnty by 2
      272       on error undo, return error
      273       :
      274         assign
      275           v-count-fld = v-count-fld + 1
      276         .
      277         if p-key-handle = ?
      278           and v-count-fld > v-field-num
      279         then do:
      280           leave block_where.
      281         end.
      282         define variable VfieldKeyTable as handle no-undo.
      283         assign
      284           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      285           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      286         .
      287         if     bh_tbl-key ne ?
      288         then do:
      289            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      290            if VfieldKeyTable eq ?
      291            then next block_where.
      292         end.
      293         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      294         then
      295            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      296         else
      297            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      298         if p-key-handle = ? then do:
      299           assign
      300             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      301           .
      302         end.
      303         else do:
      304           assign
      305             fh_key = p-key-handle:buffer-field( v-field-name )
      306           .
      307           if fh_key = ?
      308             or not valid-handle( fh_key )
      309           then do:
      310             delete object bh_tbl-name.
      311             if     bh_tbl-key ne ?
      312             then
      313                delete object bh_tbl-key.
      314             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info0, p-key-handle:name, v-field-name ).
      315           end.
      316           assign
      317             v-field-val = fh_key:buffer-value
      318           .
      319         end.
      320         if fh_search:data-type ="character":U then do:
      321           assign
      322             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      323             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      324             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      325             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      326             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      327             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      328             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      329             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      330             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      331             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      332             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      333             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      334             v-field-val = substitute( '"&1"', v-field-val )
      335           .
      336         end.
      337         assign
      338           o-where = substitute( "&1 &2", o-where, v-field-val )
      339         .
      340         if v-word-link = "":U then do:
      341           assign
      342             v-word-link = "and":U
      343           .
      344         end.
      345       end.
      346       delete object bh_tbl-name.
      347       if     bh_tbl-key ne ?
      348       then
      349          delete object bh_tbl-key.
      350       if p-key-handle = ?
      351         and v-count-fld <> v-field-num
      352       then do:
      353         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info0, vTable ).
      354       end.
      355     end.
      356   end procedure.
      357   procedure gen-hn-keyr-tab :
      358     define input  parameter i-tableSerach as character no-undo.
      359     define input  parameter i-tablekey   as character no-undo.
      360     define input  parameter p-key-rec    as character no-undo.
      361     define input  parameter p-key-handle as handle    no-undo .
      362     define input  parameter p-db-name    as character no-undo .
      363     define input  parameter p-tt-handle  as handle    no-undo .
      364     define input  parameter p-stts-lock  as integer   no-undo .
      365     define output parameter o-hn         as handle    no-undo.
      366     define variable v-full-tbl-name as character no-undo.
      367     define variable v-where         as character no-undo.
      368     define variable bh_tbl-name     as handle    no-undo.
      369     define variable vTable          as character no-undo.
      370     do
      371     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      372     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      373     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      374         run gen-where-keyr-tab(i-tableSerach,
      375                                i-tablekey,
      376                                p-key-rec,
      377                                p-key-handle,
      378                                p-db-name,
      379                                p-tt-handle,
      380                                output v-where).
      381         if i-tableSerach ne "" and i-tableSerach ne ?
      382         then do:
      383            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      384            create buffer bh_tbl-name for table v-full-tbl-name .
      385         end.
      386         else do:
      387            if p-tt-handle = ? then do:
      388               assign
      389                  vTable = entry( 1 , p-key-rec, chr(3) )
      390               .
      391               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      392               create buffer bh_tbl-name for table v-full-tbl-name .
      393            end.
      394            else do:
      395               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      396            end.
      397         end.
      398         if p-tt-handle = ? then do:
      399            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      400         end.
      401         else do:
      402            bh_tbl-name:find-first( v-where ) no-error .
      403         end.
      404         o-hn = bh_tbl-name.
      405      end.
      406   end procedure.
      407   procedure gen-hn-keyr :
      408     define input  parameter p-key-rec    as character no-undo.
      409     define input  parameter p-key-handle as handle    no-undo .
      410     define input  parameter p-db-name    as character no-undo .
      411     define input  parameter p-tt-handle  as handle    no-undo .
      412     define input  parameter p-stts-lock  as integer   no-undo .
      413     define output parameter o-hn         as handle    no-undo.
      414     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      415   end.
      416   procedure gen-row-keyr :
      417     define input  parameter p-key-rec    as character no-undo.
      418     define input  parameter p-key-handle as handle    no-undo .
      419     define input  parameter p-db-name    as character no-undo .
      420     define input  parameter p-tt-handle  as handle    no-undo .
      421     define input  parameter p-stts-lock  as integer   no-undo .
      422     define output parameter p-tbl-row    as rowid     no-undo.
      423     define output parameter p-tbl-name   as character no-undo.
      424     define variable vHn as handle no-undo.
      425       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      426       p-tbl-row = if vHn:available then vHn:rowid else ?.
      427       p-tbl-name =  vHn:table.
      428       delete object vHn no-error.
      429     if p-tbl-row = ? then do:
      430       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info0, p-tbl-name, p-key-rec ).
      431     end.
      432     else do:
      433       return.
      434     end.
      435   end procedure.
      436   procedure gen-key-fv :
      437     define input  parameter p-key-rec    as character no-undo .
      438     define output parameter p-field-list as character no-undo .
      439     define output parameter p-value-list as character no-undo.
      440     do
      441     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      442     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      443     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      444     :
      445       define variable v-full-tbl-name  as character no-undo .
      446       define variable bh_tbl-name      as handle    no-undo .
      447       define variable v-tbl-name       as character no-undo .
      448       define variable v-field-num      as integer   no-undo .
      449       define variable v-count-fld      as integer   no-undo .
      450       define variable v-inform         as character no-undo .
      451       define variable v-ind            as integer   no-undo .
      452       define variable v-idx-field-qnty as integer   no-undo .
      453       define variable v-delim-key      as character no-undo .
      454       if p-key-rec = ?
      455         or p-key-rec = "":U
      456       then do:
      457         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      458       end.
      459       assign
      460         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      461         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      462       .
      463       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      464       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info0 ).
      465       assign
      466         v-inform = bh_tbl-name:index-information(1)
      467         v-ind    = 2
      468       .
      469       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      470       on error undo, return error
      471       :
      472         assign
      473           v-inform = bh_tbl-name:index-information( v-ind )
      474           v-ind    = v-ind + 1
      475         .
      476       end.
      477       if v-inform = ?
      478         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      479         or entry( 3, v-inform, ",":U ) <> "1":U
      480       then do:
      481         delete object bh_tbl-name no-error.
      482         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      483       end.
      484       assign
      485         v-idx-field-qnty = num-entries( v-inform ) - 4
      486       .
      487       if v-idx-field-qnty < 2 then do:
      488         delete object bh_tbl-name no-error.
      489         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      490       end.
      491       assign
      492         p-field-list = "":U
      493         p-value-list = "":U
      494         v-delim-key  = "":U
      495         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      496         v-count-fld  = 0
      497       .
      498       block_where:
      499       do v-ind = 1 to v-idx-field-qnty by 2
      500       on error undo, return error
      501       :
      502         assign
      503           v-count-fld = v-count-fld + 1
      504         .
      505         if v-count-fld > v-field-num then do:
      506           leave block_where.
      507         end.
      508         assign
      509           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      510           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      511         .
      512         if v-ind = 1 then do:
      513           assign
      514             v-delim-key = chr(3)
      515           .
      516         end.
      517       end.
      518       delete object bh_tbl-name.
      519       if v-count-fld <> v-field-num then do:
      520         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      521       end.
      522     end.
      523   end procedure.
      524   procedure gen-key-field :
      525     define input  parameter p-table      as character no-undo .
      526     define output parameter p-field-list as character no-undo .
      527     do
      528     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      529     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      530     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      531     :
      532       define variable v-full-tbl-name  as character no-undo .
      533       define variable bh_tbl-name      as handle    no-undo .
      534       define variable v-tbl-name       as character no-undo .
      535       define variable v-field-num      as integer   no-undo .
      536       define variable v-count-fld      as integer   no-undo .
      537       define variable v-inform         as character no-undo .
      538       define variable v-ind            as integer   no-undo .
      539       define variable v-idx-field-qnty as integer   no-undo .
      540       define variable v-delim-key      as character no-undo .
      541       if p-table = ?
      542         or p-table = "":U
      543       then do:
      544         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info0 ).
      545       end.
      546       assign
      547         v-tbl-name      = p-table
      548         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      549       .
      550       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      551       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info0 ).
      552       assign
      553         v-inform = bh_tbl-name:index-information(1)
      554         v-ind    = 2
      555       .
      556       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      557       on error undo, return error
      558       :
      559         assign
      560           v-inform = bh_tbl-name:index-information( v-ind )
      561           v-ind    = v-ind + 1
      562         .
      563       end.
      564       if v-inform = ?
      565         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      566         or entry( 3, v-inform, ",":U ) <> "1":U
      567       then do:
      568         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      569       end.
      570       assign
      571         v-idx-field-qnty = num-entries( v-inform ) - 4
      572       .
      573       if v-idx-field-qnty < 2 then do:
      574         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      575       end.
      576       assign
      577         p-field-list = "":U
      578         v-delim-key  = "":U
      579         v-count-fld  = 0
      580       .
      581       block_where:
      582       do v-ind = 1 to v-idx-field-qnty by 2
      583       on error undo, return error
      584       :
      585         assign
      586           v-count-fld = v-count-fld + 1
      587         .
      588         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      589         if v-ind = 1 then do:
      590           assign
      591             v-delim-key = chr(3)
      592           .
      593         end.
      594       end.
      595       delete object bh_tbl-name.
      596     end.
      597   end procedure.
      598   define variable v-mess as character no-undo .
      599   define buffer buf_layout-elem for ub.layout-elem.
      600   define buffer buf_layout-elem-rule for ub.layout-elem-rule.
      601   define buffer buf_layout for ub.layout.
      602   define buffer buf_wi-mode for ub.wi-mode.
      603   if p-mode <> 'ДОБАВЛЕНИЕ':U
      604   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
      605     message vss-workfile vss-revision vss-description skip
      606             "Неверный параметр p-mode - " p-mode
      607     view-as alert-box error .
      608     return error '':u.
      609   end.
      610   if g#db-num <> 0
      611   then do:
      612     message vss-workfile vss-revision vss-description skip
      613             "Запрещено в УБД редактировать элементы раскладок"
      614     view-as alert-box error .
      615     return error '':u.
      616   end.
      617   _main:
      618   do for buf_layout-elem
      619   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      620   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
      621   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
      622   :
      623     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      624       find first buf_layout-elem no-lock where
      625                 buf_layout-elem.layout-type = p-layout-type
      626             and buf_layout-elem.device-type = p-device-type
      627             and buf_layout-elem.mode-id = p-mode-id
      628             and buf_layout-elem.widget-id = p-widget-id  no-error .
      629       if available buf_layout-elem then do:
      630         assign
      631         v-mess = substitute("Уже существует элемент раскладки c типом = &1 для устройства &2 режима &3 с идентификатором &4", p-layout-type, p-device-type, p-mode-id, p-widget-id).
      632         run err-mess in this-procedure ( input-output v-mess).
      633         return error (if p-silent = yes then v-mess else '':U).
      634       end.
      635       if lookup( entry(1, p-layout-type, "_") , 'th-pos-screen,th-pos-keyboard':U) = 0 then do:
      636         assign
      637         v-mess = substitute("Неверный тип раскладки &1", p-layout-type).
      638         run err-mess in this-procedure ( input-output v-mess).
      639         return error (if p-silent = yes then v-mess else '':U).
      640       end.
      641       case p-layout-type:
      642         WHEN 'th-pos-keyboard':U  THEN DO:
      643           if lookup(p-device-type, 'IBM-50':U) = 0 then do:
      644             assign
      645             v-mess = substitute("Неверный тип устройства &1 для раскладки &2"
      646                               , p-device-type
      647                               , p-layout-type).
      648             run err-mess in this-procedure ( input-output v-mess).
      649             return error (if p-silent = yes then v-mess else '':U).
      650           end.
      651         END.
      652         WHEN 'th-pos-screen':U  THEN DO:
      653           if lookup(p-device-type, 'Screen,TouchScreen':U) = 0 then do:
      654             assign
      655             v-mess = substitute("Неверный тип устройства &1 для раскладки &2"
      656                               , p-device-type
      657                               , p-layout-type).
      658             run err-mess in this-procedure ( input-output v-mess).
      659             return error (if p-silent = yes then v-mess else '':U).
      660           end.
      661         END.
      662       end case.
      663       create buf_layout-elem.
      664       assign
      665       buf_layout-elem.layout-type = p-layout-type
      666       buf_layout-elem.device-type = p-device-type
      667       buf_layout-elem.mode-id = p-mode-id
      668       buf_layout-elem.widget-id = p-widget-id
      669       .
      670     end.
      671     if p-layout-type = 'th-pos-keyboard':U
      672     or p-layout-type = 'th-pos-screen':U then do:
      673       find first buf_wi-mode no-lock where
      674                 buf_wi-mode.mode-type = 'cd-IBS-TH':U
      675             and buf_wi-mode.mode-id = p-mode-id no-error.
      676       if not available buf_wi-mode then do:
      677         assign
      678         v-mess = substitute("Неверный режим = &1", p-mode-id
      679                                 , chr(10)
      680                                 )
      681         .
      682         run err-mess in this-procedure ( input-output v-mess).
      683         return error (if p-silent = yes then v-mess else 'mode-id':U).
      684       end.
      685     end.
      686     if lookup(p-widget-type, "BUTTON") = 0 then do:
      687         assign
      688         v-mess = substitute("Неверный тип элемента = &1", p-widget-type
      689                                 , chr(10)
      690                                 )
      691         .
      692         run err-mess in this-procedure ( input-output v-mess).
      693         return error (if p-silent = yes then v-mess else 'widget-type':U).
      694     end.
      695     if lookup(string(p-elem-type), '0,-1':U) = 0 then do:
      696       assign
      697       v-mess = substitute("Неверный тип элемента = &1", p-elem-type
      698                               , chr(10)
      699                               )
      700       .
      701       run err-mess in this-procedure ( input-output v-mess).
      702       return error (if p-silent = yes then v-mess else 'widget-type':U).
      703     end.
      704     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      705       find first buf_layout-elem exclusive-lock where
      706                 recid(buf_layout-elem) = p-rec .
      707       if buf_layout-elem.layout-type <> p-layout-type
      708       or buf_layout-elem.device-type <> p-device-type
      709       or buf_layout-elem.mode-id <> p-mode-id
      710       or buf_layout-elem.widget-id <> p-widget-id
      711       then do:
      712         assign
      713         v-mess = substitute("Для уже существующего элемента расладки невозможно измененить тип раскладки, тип устройства, режим, идентификатор элемента&1"
      714                                 , chr(10)
      715                                 )
      716         .
      717         run err-mess in this-procedure ( input-output v-mess).
      718         return error (if p-silent = yes then v-mess else '':U).
      719       end.
      720       if p-elem-type = integer('-1':U) then do:
      721         for each buf_layout-elem-rule no-lock where
      722                 buf_layout-elem-rule.mode-id = p-mode-id
      723             and buf_layout-elem-rule.widget-id = p-widget-id
      724           on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      725           on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
      726           on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
      727           :
      728           find first buf_layout share-lock where
      729                    buf_layout.layout-id = buf_layout-elem-rule.layout-id
      730                and buf_layout.layout-type = buf_layout-elem.layout-type
      731                and buf_layout.device-type = buf_layout-elem.device-type no-error.
      732           if available buf_layout
      733           and (buf_layout.is-default = integer('0':U)
      734                or
      735                buf_layout.is-default = integer('1':U)
      736                )
      737           then do:
      738             assign
      739             v-mess = substitute("Элемент имеет тип НЕПРОГРАММИРУЕМЫЙ, но он фигурирует в раскладке &1&2Сохранение невозможно"
      740                                     , buf_layout-elem-rule.layout-id
      741                                     , chr(10)
      742                                     )
      743             .
      744             run err-mess in this-procedure ( input-output v-mess).
      745             return error (if p-silent = yes then v-mess else 'elem-type':U).
      746           end.
      747         end.
      748       end.
      749     end.
      750     assign
      751     buf_layout-elem.des = p-des
      752     buf_layout-elem.widget-type = p-widget-type
      753     buf_layout-elem.elem-type = p-elem-type
      754     p-rec = recid(buf_layout-elem)
      755     .
      756   end.
      757   PROCEDURE err-mess:
      758     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      759     CASE p-silent:
      760       when yes then do:
      761         assign
      762         p-mess = substitute("Элемент раскладки: тип &1 для устройства &2 режим &3 идентификатор &4:&5&6"
      763                            , p-layout-type
      764                            , p-device-type
      765                            , p-mode-id
      766                            , p-widget-id
      767                            , chr(10)
      768                            , p-mess)
      769         .
      770       end.
      771       when no then do:
      772         message
      773         p-mess
      774         view-as alert-box error .
      775       end.
      776     end.
      777   END PROCEDURE.
