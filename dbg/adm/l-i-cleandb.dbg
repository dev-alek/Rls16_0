        1   define new global shared variable g#language as character no-undo .
        2   if g#language <> '' and g#language <> 'rus':U then do:
        3     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        4   end.
        5   define new global shared variable g#library  as handle no-undo .
        6   define new global shared variable g#library2 as handle no-undo .
        7   define new  shared variable g#auto as logical no-undo.
        8   define new  shared variable g#news as logical no-undo.
        9   define new  shared variable g#oxml as logical no-undo.
       10   define new  shared variable g#esys as logical no-undo.
       11   define new  shared variable g#news-source-db as integer no-undo.
       12   define new  shared variable g#esys-source-esys as integer no-undo.
       13   define new  shared variable g#db-num as integer   no-undo .
       14   define new  shared variable g#userid as character no-undo .
       15   define new  shared variable g#passwd as character no-undo .
       16   define variable v-updating      as logical   no-undo init false .
       17   DEFINE VAR w-login AS WIDGET-HANDLE NO-UNDO.
       18   DEFINE BUTTON b-OK  NO-FOCUS
       19        LABEL "&Очистить":L
       20        SIZE 13 BY 1
       21        BGCOLOR 15 .
       22   DEFINE BUTTON b-quit AUTO-END-KEY  NO-FOCUS
       23        LABEL "&Закрыть":L
       24        SIZE 12.4 BY 1.
       25   DEFINE VARIABLE log-edit AS CHARACTER
       26        VIEW-AS EDITOR SCROLLBAR-VERTICAL
       27        SIZE 69 BY 5.24 NO-UNDO.
       28   DEFINE VARIABLE f-date AS DATE FORMAT "99/99/9999":U
       29        LABEL "Дата"
       30        VIEW-AS FILL-IN
       31        SIZE 14 BY 1 TOOLTIP "Дата актуальности документов" NO-UNDO.
       32   DEFINE VARIABLE f-ub AS CHARACTER FORMAT "X(256)":U INITIAL "-db ub -ld ub -H ... -S ..."
       33        LABEL "UB"
       34        VIEW-AS FILL-IN
       35        SIZE 59 BY 1 NO-UNDO.
       36   DEFINE VARIABLE name AS CHARACTER FORMAT "X(12)":U INITIAL "адм"
       37        LABEL "Логин"
       38        VIEW-AS FILL-IN
       39        SIZE 20 BY 1 NO-UNDO.
       40   DEFINE VARIABLE password AS CHARACTER FORMAT "X(16)":U INITIAL "адм"
       41        LABEL "Пароль"
       42        VIEW-AS FILL-IN
       43        SIZE 20 BY 1 NO-UNDO.
       44   DEFINE VARIABLE password_display AS CHARACTER FORMAT "X(16)":U
       45        LABEL "Пароль"
       46        VIEW-AS FILL-IN
       47        SIZE 20 BY 1 NO-UNDO.
       48   DEFINE FRAME FRAME-A
       49        b-OK AT ROW 7.19 COL 12
       50        f-ub AT ROW 2 COL 10 COLON-ALIGNED WIDGET-ID 2
       51        name AT ROW 3.24 COL 10 COLON-ALIGNED
       52        b-quit AT ROW 7.19 COL 25
       53        password AT ROW 4.52 COL 10 COLON-ALIGNED PASSWORD-FIELD
       54        password_display AT ROW 4.52 COL 10 COLON-ALIGNED PASSWORD-FIELD
       55        f-date AT ROW 5.81 COL 10 COLON-ALIGNED WIDGET-ID 10
       56        log-edit AT ROW 8.62 COL 3 NO-LABEL WIDGET-ID 12
       57       WITH 1 DOWN NO-BOX OVERLAY
       58            SIDE-LABELS THREE-D
       59            AT COL 1 ROW 1
       60            SIZE 72.6 BY 13.57.
       61   IF SESSION:DISPLAY-TYPE = "GUI":U THEN
       62     CREATE WINDOW w-login ASSIGN
       63            HIDDEN             = YES
       64            TITLE              = "Trade House 15.0"
       65            COLUMN             = 27
       66            ROW                = 7.57
       67            HEIGHT             = 13.57
       68            WIDTH              = 73
       69            MAX-HEIGHT         = 35.62
       70            MAX-WIDTH          = 160
       71            VIRTUAL-HEIGHT     = 35.62
       72            VIRTUAL-WIDTH      = 160
       73            RESIZE             = no
       74            SCROLL-BARS        = yes
       75            STATUS-AREA        = no
       76            BGCOLOR            = ?
       77            FGCOLOR            = ?
       78            THREE-D            = yes
       79            MESSAGE-AREA       = no
       80            SENSITIVE          = yes.
       81   ELSE w-login = CURRENT-WINDOW.
       82   ASSIGN
       83          log-edit:READ-ONLY IN FRAME FRAME-A        = TRUE.
       84   IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(w-login)
       85   THEN w-login:HIDDEN = no.
       86   ON VALUE-CHANGED OF password_display IN FRAME FRAME-A DO:
       87       IF NOT v-updating THEN DO:
       88           ASSIGN password:SCREEN-VALUE = password_display:SCREEN-VALUE.
       89       END.
       90   END.
       91   ON ANY-KEY OF password_display IN FRAME FRAME-A DO:
       92       IF LASTKEY = KEY-CODE("CTRL-V") THEN DO:
       93              ASSIGN
       94              v-updating = TRUE
       95              password:SCREEN-VALUE = System.Windows.Forms.Clipboard:GetText()
       96              password_display:SCREEN-VALUE = System.Windows.Forms.Clipboard:GetText()
       97              v-updating = FALSE.
       98              System.Windows.Forms.Clipboard:Clear().
       99              RETURN NO-APPLY.
      100       END.
      101   END.
      102   ON CHOOSE OF b-OK IN FRAME FRAME-A
      103   DO:
      104     define variable v-cConnect     as CHAR no-undo.
      105     define variable v-user-entered as logical   no-undo init false .
      106     assign
      107       f-ub
      108       name
      109       password
      110       f-date.
      111     if name :screen-value = ""
      112     then do:
      113       message
      114         "Введите имя пользователя"
      115         view-as alert-box information .
      116       apply "entry" to name .
      117       return no-apply .
      118     end.
      119     if f-date = ? then
      120     do:
      121       message "Необходимо ввести дату актуальности документов" view-as alert-box.
      122       apply "entry":U to f-date in frame FRAME-A.
      123       return no-apply.
      124     end.
      125     assign
      126       v-cConnect = f-ub
      127                  + (if     name ne ""
      128                        and name ne ?
      129                     then " &1 "
      130                     else " ")
      131     .
      132     run gbl/dbconnnodisc.p
      133       (input v-cConnect
      134       ,input ?
      135       ,input name
      136       ,input password
      137       ,input-output v-user-entered
      138       ) no-error.
      139     if error-status:error
      140     then do:
      141        message return-value view-as alert-box.
      142        return no-apply.
      143     end.
      144     if userid('ub':U) = '':U
      145     then do:
      146       message
      147         "Ошибка при подключении к базе данных" skip
      148         "Неизвестный пользователь" skip
      149         view-as alert-box error .
      150       disconnect ub no-error .
      151       quit.
      152     end.
      153     assign
      154       session :data-entry-return = no
      155     .
      156     if v-user-entered then
      157     do:
      158       message
      159         'Вы уверены, что хотите произвести чистку базы данных до' string(f-date,"99/99/9999") '?' skip
      160         view-as alert-box question buttons yes-no update v-ok as logical.
      161       if v-ok <> true then do:
      162         return no-apply .
      163       end.
      164       run utl/clean_db.p
      165         ( input f-date
      166          ,input this-procedure :handle
      167         ) no-error.
      168       if error-status :error then do:
      169          message
      170          substitute( "Ошибка при работе утилит!" ) skip
      171          return-value skip
      172          error-status :get-message ( error-status :num-messages )
      173          view-as alert-box error
      174        .
      175       end.
      176     end.
      177     else do:
      178       if error-status :error then
      179       do:
      180         message
      181           "Ошибка при подключении к БД" skip
      182           error-status :get-message(1) skip
      183           return-value skip
      184           view-as alert-box error .
      185         disconnect ub no-error .
      186       end.
      187       else
      188       do:
      189         message
      190           "Ошибка при подключении к базе данных" skip
      191           "Обратитесь к администратору" skip
      192           "Строка подключения к БД:" skip
      193           v-cConnect skip
      194           view-as alert-box error .
      195       end.
      196     end.
      197   END.
      198   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME FRAME-A:PARENT eq ?
      199   THEN FRAME FRAME-A:PARENT = ACTIVE-WINDOW.
      200   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      201   on help of frame FRAME-A
      202   do:
      203     run gbl/app_help.p
      204       (input this-procedure :file-name
      205       ,input ''
      206       ,input ?
      207       ) no-error.
      208     if error-status :error then do:
      209       message
      210         "Ошибка при вызове помощи"
      211         error-status :get-message(1)
      212         view-as alert-box .
      213     end.
      214   end.
      215   on "ENTRY" of b-ok do:
      216     if lastkey = keycode ("RETURN") then do:
      217       apply "CHOOSE" to b-ok in frame FRAME-A.
      218     end.
      219   end.
      220   on window-close of w-login do:
      221     apply "end-error" to frame FRAME-A.
      222   end.
      223   MAIN-BLOCK:
      224   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      225      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      226     ASSIGN
      227       CURRENT-WINDOW             = w-login
      228       SESSION:SYSTEM-ALERT-BOXES = (CURRENT-WINDOW:MESSAGE-AREA = NO)
      229       session:three-d = yes
      230     .
      231     PAUSE 0 BEFORE-HIDE.
      232     if session:date-format <> "dmy":U
      233     or session:numeric-decimal-point <> ".":U
      234     or session:numeric-separator <> ",":U
      235     then do:
      236       message
      237         "Неправильные установки сессии progress!" skip
      238         "Формат даты должен быть - " "'dmy'":U skip
      239         "Десятичный разделитель - " "'.'":U skip
      240         "Разделитель тысяч - " "','":U skip
      241         view-as alert-box error .
      242       quit.
      243     end.
      244     run enable_UI in this-procedure .
      245     WAIT-FOR GO OF frame FRAME-A focus name.
      246   END.
      247   RUN disable_UI in this-procedure.
      248   quit.
      249   PROCEDURE callback-write-to-log :
      250     define input parameter p-msg-str as character no-undo .
      251     define variable lok as logical   no-undo .
      252     do with frame FRAME-A
      253     on error undo, return error return-value
      254     :
      255       assign
      256         lok = log-edit :move-to-eof( )
      257         lok = log-edit :insert-string( p-msg-str )
      258         lok = log-edit :move-to-eof( )
      259       .
      260     end.
      261   END PROCEDURE.
      262   PROCEDURE disable_UI :
      263     IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(w-login)
      264     THEN DELETE WIDGET w-login.
      265     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
      266   END PROCEDURE.
      267   PROCEDURE enable_UI :
      268     DISPLAY f-ub f-date log-edit
      269         WITH FRAME FRAME-A IN WINDOW w-login.
      270     ENABLE b-OK f-ub name b-quit  password_display f-date log-edit
      271         WITH FRAME FRAME-A IN WINDOW w-login.
      272     VIEW w-login.
      273   END PROCEDURE.
