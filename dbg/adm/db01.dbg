        1   block-level on error undo, throw.
        2   define input-output parameter p-rec                 as recid no-undo .
        3   define input parameter        p-mode                as character no-undo .
        4   define input parameter        p-db-num              like ub.db.db-num no-undo .
        5   define input parameter        p-db-name             like ub.db.db-name no-undo .
        6   define input parameter        p-add-clients         like ub.db.add-clients no-undo .
        7   define input parameter        p-send-check          like ub.db.send-check no-undo .
        8   define input parameter        p-add-goods           like ub.db.add-goods no-undo .
        9   define input parameter        p-save-packs          like ub.db.save-packs no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision: 8c1a0fd433e1, 1120, rls $":U .
       11   define variable vss-author      as character no-undo init "$Author: SMMolotkov $":U .
       12   define variable vss-date        as character no-undo init "$Date: Thu Dec 14 02:13:53 2017 +0300 $":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile: db01.p $":U .
       14   define variable vss-archive     as character no-undo init "$Archive: adm/db01.p $":U .
       15   define variable vss-description as character no-undo init "Сохранение изменений в карточке магазина".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define buffer buf_db for ub.db .
       75   do on error undo, throw:
       76     if lookup(p-mode, "ДОБАВЛЕНИЕ,ИЗМЕНЕНИЕ") = 0 then do:
       77       undo, throw new Progress.Lang.AppError(
       78         substitute("&1 &2 &3&4Неверный параметр p-mode. Не предусмотрена операция [&5]",
       79                    vss-workfile, vss-revision, vss-description, chr(10),
       80                    p-mode )
       81       ) .
       82     end .
       83     if p-db-name > "" then .
       84     else do:
       85       undo, throw new Progress.Lang.AppError(
       86         substitute("&1 &2 &3&4Имя БД отсутствует",
       87                    vss-workfile, vss-revision, vss-description, chr(10))
       88       ) .
       89     end .
       90     if p-save-packs < 10 then do:
       91       undo, throw new Progress.Lang.AppError(
       92         substitute("&1 &2 &3&4Минимальный период хранения пакетов 10 дней.&4Удалять пакеты через [&5] дней нельзя.",
       93                    vss-workfile, vss-revision, vss-description, chr(10),
       94                    p-save-packs )
       95       ) .
       96     end.
       97     case p-mode:
       98       when 'ДОБАВЛЕНИЕ':U then do:
       99         if p-db-num = ? then do:
      100           undo, throw new Progress.Lang.AppError(
      101             substitute("&1 &2 &3&4Номер БД отсутствует",
      102                        vss-workfile, vss-revision, vss-description, chr(10))
      103           ) .
      104         end .
      105         if can-find (first buf_db where buf_db.db-num = p-db-num) then do:
      106           undo, throw new Progress.Lang.AppError(
      107             substitute("&1 &2 &3&4БД с номером [&5] уже существует",
      108                        vss-workfile, vss-revision, vss-description, chr(10),
      109                        p-db-num )
      110           ) .
      111         end .
      112         create buf_db .
      113         assign
      114           buf_db.db-num       = p-db-num
      115           buf_db.db-key       = "":U
      116           buf_db.db-key-enc   = "":U
      117           buf_db.remote-stock = false
      118           buf_db.on-line-rest = false
      119           buf_db.max-p-size   = 10000
      120           buf_db.max-p-queue  = 10
      121           buf_db.max-p-time   = 0
      122           buf_db.unload-arch  = true
      123           buf_db.unload-aht   = true
      124         .
      125       end.
      126       when 'ИЗМЕНЕНИЕ':U then do:
      127         find first buf_db exclusive-lock where recid(buf_db) = p-rec no-error no-wait .
      128         if locked(buf_db) then do:
      129           undo, throw new Progress.Lang.AppError(
      130             substitute("&1 &2 &3&4Запись о БД с ид. [&5] занята другим пользователем",
      131                        vss-workfile, vss-revision, vss-description, chr(10),
      132                        p-rec )
      133           ) .
      134         end .
      135         if not available buf_db then do:
      136           undo, throw new Progress.Lang.AppError(
      137             substitute("&1 &2 &3&4Запись о БД с ид. [&5] отсутствует",
      138                        vss-workfile, vss-revision, vss-description, chr(10),
      139                        p-rec )
      140           ) .
      141         end .
      142       end .
      143       otherwise .
      144     end case .
      145     assign
      146       buf_db.db-name     = p-db-name
      147       buf_db.add-clients = p-add-clients
      148       buf_db.send-check  = p-send-check
      149       buf_db.add-goods   = p-add-goods
      150       buf_db.save-packs  = p-save-packs
      151     .
      152     validate buf_db .
      153   end.
