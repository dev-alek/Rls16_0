      639   procedure proc-alt-shift-f2:
      640     if not ibs.th.gbl.gbl-var:rcode
      641   then
      642     run gbl\inidebug.p .
      643   end.
      644   procedure proc-alt-shift-f3:
      645     run gbl/prvssinf.p
      646       ( input this-procedure
      647       ) .
      648   end.
      649   define variable v-inform-launched as logical no-undo initial false .
      650   procedure proc-alt-shift-f4:
      651     define variable v-action as character no-undo .
      652     if v-inform-launched = false then do:
      653       assign
      654         v-inform-launched = true
      655       .
      656       run gbl/d-inform.w
      657         (  input self
      658         ,  input this-procedure
      659         , output v-action
      660         ) no-error .
      661       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      662       assign
      663         v-inform-launched = false
      664       .
      665     end.
      666   end.
      667   procedure proc-alt-f1:
      668     run gbl/corrhelp.p
      669       (input this-procedure
      670       ) .
      671   end .
      672   on alt-shift-f2 anywhere do:
      673     run proc-alt-shift-f2.
      674   end.
      675   on alt-shift-f3 anywhere do:
      676     run proc-alt-shift-f3 in this-procedure .
      677   end.
      678   on alt-shift-f4 anywhere do:
      679     run proc-alt-shift-f4 in this-procedure.
      680   end.
      681   on alt-f1 anywhere do:
      682     run proc-alt-f1 in this-procedure .
      683   end.
