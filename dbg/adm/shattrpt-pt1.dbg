      352   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      353   procedure thbjattr_code :
      354      define input  parameter p-upper-code     as character no-undo .
      355      define input  parameter p-code           as character no-undo .
      356      define output parameter p-label          as character no-undo .
      357      define output parameter p-user-can-edit  as logical   no-undo .
      358      define output parameter p-output-display as logical   no-undo .
      359      define output parameter p-other          as character no-undo .
      360      define output parameter p-prop-list      as character no-undo .
      361      define output parameter p-prop-type-list as character no-undo .
      362      define output parameter p-prop-label-list as character no-undo .
      363      define output parameter p-global          as logical no-undo .
      364      define output parameter p-host           as logical no-undo .
      365      define output parameter p-shop           as logical no-undo .
      366      define output parameter p-store          as logical no-undo .
      367      define output parameter p-db             as logical no-undo .
      368      define variable p-region as logical no-undo.
      369      run thbjattr_code_reg in this-procedure (
      370                                               p-upper-code,
      371                                               p-code,
      372                                               output p-label,
      373                                               output p-user-can-edit,
      374                                               output p-output-display,
      375                                               output p-other,
      376                                               output p-prop-list,
      377                                               output p-prop-type-list,
      378                                               output p-prop-label-list,
      379                                               output p-global,
      380                                               output p-host,
      381                                               output p-shop,
      382                                               output p-store,
      383                                               output p-db,
      384                                               output p-region
      385                                               ).
      386   end procedure.
      387   procedure thbjattr_code_reg :
      388   define input  parameter p-upper-code     as character no-undo .
      389   define input  parameter p-code           as character no-undo .
      390   define output parameter p-label          as character no-undo .
      391   define output parameter p-user-can-edit  as logical   no-undo .
      392   define output parameter p-output-display as logical   no-undo .
      393   define output parameter p-other          as character no-undo .
      394   define output parameter p-prop-list      as character no-undo .
      395   define output parameter p-prop-type-list as character no-undo .
      396   define output parameter p-prop-label-list as character no-undo .
      397   define output parameter p-global          as logical no-undo .
      398   define output parameter p-host           as logical no-undo .
      399   define output parameter p-shop           as logical no-undo .
      400   define output parameter p-store          as logical no-undo .
      401   define output parameter p-db             as logical no-undo .
      402   define output parameter p-region         as logical no-undo .
      403   do
      404   on error undo, return error return-value
      405   :
      406       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      407       (input  p-upper-code
      408       ,input  p-code
      409       ,output p-label
      410       ,output p-user-can-edit
      411       ,output p-output-display
      412       ,output p-other
      413       ,output p-prop-list
      414       ,output p-prop-type-list
      415       ,output p-prop-label-list
      416       ,output p-global
      417       ,output p-host
      418       ,output p-shop
      419       ,output p-store
      420       ,output p-db
      421       ,output p-region
      422       ) no-error .
      423     if error-status :error
      424     then do:
      425       undo, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message (1)).
      426     end.
      427   end.
      428   end procedure.
      429   procedure thbjattr_tooltip :
