     1742   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1743   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1744   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1745   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1746   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1747   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1748   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1749   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1750         adm-object-hdl = FRAME F-Main:HANDLE.
     1751   RUN ensure-broker.
     1752   THIS-PROCEDURE:ADM-DATA =
     1753        'ADM1.1~`':U +
     1754        'SmartObject~`':U +
     1755        '~`':U +
     1756        'NO ~`':U +
     1757        'clients~`':U +
     1758        '~`':U +
     1759        '~`':U +
     1760        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1761           + "~`":U +
     1762        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1763        'Record-Source,Record-Target,TableIO-Target~`':U +
     1764        '~`':U +
     1765        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1766        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1767            THEN "^^":U
     1768        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1769             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1770   PROCEDURE adm-apply-entry :
     1771     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1772   END PROCEDURE.
     1773   PROCEDURE adm-destroy :
     1774    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1775   END PROCEDURE.
     1776   PROCEDURE adm-disable :
     1777       DISABLE RECT-1 RECT-3 RECT-2 RECT-5 RECT-6 RECT-7 r-algoincptrl t-mand-chioce-autocar t-trn-reas-sug t-calc-free-vol t-calc-free-vol-sug r-expptrl r-inpptrl B-set_dop-info B-set_sec-fields sec-fields r-temp-for-pomi r-algrvspt t-rvsnmter t-invclipt f-invclipt b-invclipt r-denstclc mass-proc mass-proc-in-lgas otkl-fact-volue otkl-temp otkl-density otkl-water v-dop-info v-sec-fields WITH FRAME F-Main.
     1778       RUN dispatch ('disable-fields':U).
     1779       RUN set-attribute-list ('ENABLED=no':U).
     1780       RETURN.
     1781   END PROCEDURE.
     1782   PROCEDURE adm-edit-attribute-list :
     1783         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1784         RETURN.
     1785   END PROCEDURE.
     1786   PROCEDURE adm-enable :
     1787       ENABLE UNLESS-HIDDEN RECT-1 RECT-3 RECT-2 RECT-5 RECT-6 RECT-7 r-algoincptrl t-mand-chioce-autocar t-trn-reas-sug t-calc-free-vol t-calc-free-vol-sug r-expptrl r-inpptrl B-set_dop-info B-set_sec-fields sec-fields r-temp-for-pomi r-algrvspt t-rvsnmter t-invclipt f-invclipt b-invclipt r-denstclc mass-proc mass-proc-in-lgas otkl-fact-volue otkl-temp otkl-density otkl-water v-dop-info v-sec-fields WITH FRAME F-Main.
     1788       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1789       RUN set-attribute-list ('ENABLED=yes':U).
     1790       RETURN.
     1791   END PROCEDURE.
     1792   PROCEDURE adm-exit :
     1793        RUN notify ('exit':U).
     1794     RETURN.
     1795   END PROCEDURE.
     1796   PROCEDURE adm-hide :
     1797     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1798   END PROCEDURE.
     1799   PROCEDURE adm-initialize :
     1800     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1801   END PROCEDURE.
     1802   PROCEDURE adm-show-errors :
     1803       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1804       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1805           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1806       END.
     1807       RETURN.
     1808   END PROCEDURE.
     1809   PROCEDURE adm-UIB-mode :
     1810     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1811   END PROCEDURE.
     1812   PROCEDURE adm-view :
     1813     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1814   END PROCEDURE.
     1815   PROCEDURE dispatch :
     1816       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1817       RUN broker-dispatch IN adm-broker-hdl
     1818           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1819       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1820   END PROCEDURE.
     1821   PROCEDURE ensure-broker :
     1822   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1823   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1824   DO:
     1825       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1826       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1827   END.
     1828   END PROCEDURE.
     1829   PROCEDURE get-attribute :
     1830     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1831     RUN broker-get-attribute IN adm-broker-hdl
     1832         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1833     RETURN RETURN-VALUE.
     1834   END PROCEDURE.
     1835   PROCEDURE get-attribute-list :
     1836     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1837     RUN broker-get-attribute-list IN adm-broker-hdl
     1838         (INPUT THIS-PROCEDURE,
     1839          INPUT ?,
     1840          OUTPUT p-attr-list) NO-ERROR.
     1841     RETURN.
     1842   END PROCEDURE.
     1843   PROCEDURE new-state :
     1844     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1845     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1846     RETURN.
     1847   END PROCEDURE.
     1848   PROCEDURE notify :
     1849     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1850     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1851     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1852         RETURN "ADM-ERROR":U.
     1853     RETURN.
     1854   END PROCEDURE.
     1855   PROCEDURE set-attribute-list :
     1856     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1857     RUN ensure-broker.
     1858     RUN broker-set-attribute-list IN adm-broker-hdl
     1859         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1860     RETURN.
     1861   END PROCEDURE.
     1862   PROCEDURE set-position :
     1863       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1864       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1865       IF VALID-HANDLE(adm-object-hdl) THEN
     1866       DO:
     1867         ASSIGN adm-object-hdl:ROW    =   p-row
     1868                adm-object-hdl:COLUMN =   p-col.
     1869       END.
     1870       RETURN.
     1871   END PROCEDURE.
     1872   PROCEDURE adm-display-fields :
     1873         IF AVAILABLE clients THEN
     1874             DISPLAY UNLESS-HIDDEN  r-algoincptrl t-mand-chioce-autocar t-trn-reas-sug t-calc-free-vol t-calc-free-vol-sug r-expptrl r-inpptrl dop-info sec-fields r-temp-for-pomi r-algrvspt t-rvsnmter t-invclipt f-invclipt r-denstclc mass-proc mass-proc-in-lgas otkl-fact-volue otkl-temp Prc-dev-mass otkl-density otkl-water Dev-paid-trans v-dop-info v-sec-fields f-invclipt-name
     1875               WITH FRAME F-Main NO-ERROR.
     1876         ELSE DO:
     1877             CLEAR FRAME F-Main ALL NO-PAUSE.
     1878             RUN set-editors('CLEAR':U).
     1879         END.
     1880       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1881       RETURN.
     1882   END PROCEDURE.
     1883   PROCEDURE adm-open-query :
     1884     RETURN.
     1885   END PROCEDURE.
     1886   PROCEDURE adm-row-changed :
     1887         IF VALID-HANDLE(adm-object-hdl) THEN
     1888           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1889         RUN notify ('row-available':U).
     1890         RETURN.
     1891   END PROCEDURE.
     1892   PROCEDURE reposition-query :
     1893       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1894       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1895       RETURN.
     1896   END PROCEDURE.
     1897     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1898     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1899     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1900     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1901     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1902     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1903     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1904     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1905     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1906     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1907     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1908     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1909     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1910     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1911     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1912     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1913     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1914     IF "":U = "":U THEN
     1915       RUN modify-list-attribute IN adm-broker-hdl
     1916         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1917     RUN use-create-on-add(?).
     1918   PROCEDURE adm-add-record :
     1919       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1920          "must have at least one Enabled Table to perform Add.":U
     1921          VIEW-AS ALERT-BOX ERROR.
     1922       RETURN.
     1923   END PROCEDURE.
     1924   PROCEDURE adm-assign-record :
     1925    MESSAGE
     1926          "Object ":U THIS-PROCEDURE:FILE-NAME
     1927            "must have at least one Enabled Table to perform Assign.":U
     1928              VIEW-AS ALERT-BOX ERROR.
     1929      RETURN.
     1930     END PROCEDURE.
     1931   PROCEDURE adm-assign-statement :
     1932     RETURN.
     1933   END PROCEDURE.
     1934   PROCEDURE adm-cancel-record :
     1935      RETURN.
     1936     END PROCEDURE.
     1937   PROCEDURE adm-copy-record :
     1938       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1939        "must have at least one Enabled Table to perform Copy.":U
     1940          VIEW-AS ALERT-BOX ERROR.
     1941       RETURN.
     1942   END PROCEDURE.
     1943   PROCEDURE adm-create-record :
     1944      RETURN.
     1945   END PROCEDURE.
     1946   PROCEDURE adm-current-changed :
     1947     RETURN.
     1948   END PROCEDURE.
     1949   PROCEDURE adm-delete-record :
     1950    MESSAGE
     1951          "Object ":U THIS-PROCEDURE:FILE-NAME
     1952            "must have at least one Enabled Table to perform Delete.":U
     1953              VIEW-AS ALERT-BOX ERROR.
     1954       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1955       RETURN.
