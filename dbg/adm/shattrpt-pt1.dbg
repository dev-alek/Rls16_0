     1964   PROCEDURE adm-end-update :
     1965     RETURN.
     1966   END PROCEDURE.
     1967   PROCEDURE adm-reset-record :
     1968       RETURN.
     1969   END PROCEDURE.
     1970   PROCEDURE adm-update-record :
     1971       MESSAGE
     1972         "Object ":U THIS-PROCEDURE:FILE-NAME
     1973           "must have at least one Enabled Table to perform Update.":U
     1974             VIEW-AS ALERT-BOX ERROR.
     1975      RETURN.
     1976   END PROCEDURE.
     1977   PROCEDURE check-modified :
     1978   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1979   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1980   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1981   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1982     IF check-state = "check":U THEN
     1983     DO:
     1984       RUN get-link-handle IN adm-broker-hdl
     1985         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1986            OUTPUT group-target-list).
     1987       IF group-target-list NE "":U THEN
     1988       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1989         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1990         RUN check-modified IN curr-widget ('group-check':U).
     1991         IF RETURN-VALUE NE "":U THEN
     1992         DO:
     1993           RUN check-modified-message(RETURN-VALUE).
     1994           RETURN "":U.
     1995         END.
     1996       END.
     1997     END.
     1998     RETURN "":U.
     1999   END PROCEDURE.
     2000   PROCEDURE check-modified-message :
     2001     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     2002        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     2003           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     2004        IF RETURN-VALUE = "YES":U THEN
     2005           RUN notify ('view,CONTAINER-SOURCE':U).
     2006        MESSAGE IF p-changed-table NE ? THEN
     2007           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     2008           ELSE "Current values have been changed."
     2009           SKIP "  Do you wish to save those changes?"
     2010           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     2011        IF ANS THEN
     2012        DO:
     2013           IF group-assign-target THEN
     2014             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     2015           ELSE RUN dispatch('update-record':U).
     2016           IF RETURN-VALUE = "ADM-ERROR":U THEN
     2017           DO:
     2018               MESSAGE "Changes to the previous record were not saved."
     2019                 VIEW-AS ALERT-BOX ERROR.
     2020               IF group-assign-target THEN
     2021                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     2022               ELSE RUN dispatch ('cancel-record':U).
     2023           END.
     2024        END.
     2025        ELSE DO:
     2026          IF group-assign-target THEN
     2027             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     2028          ELSE RUN dispatch('cancel-record':U).
     2029        END.
     2030        RETURN.
     2031   END PROCEDURE.
     2032   PROCEDURE get-rowid :
     2033       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     2034       ASSIGN
     2035       p-table   =   adm-first-table.
     2036       RETURN.
     2037   END PROCEDURE.
     2038   PROCEDURE init-group-assign :
     2039       RUN request-attribute IN adm-broker-hdl
     2040         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     2041       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     2042         group-assign-target = yes.
     2043       ELSE group-assign-target = no.
     2044       RETURN.
     2045   END PROCEDURE.
     2046   PROCEDURE set-editors :
     2047       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     2048       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     2049       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     2050       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     2051       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     2052       DO WHILE VALID-HANDLE (curr-widget):
     2053           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     2054              curr-widget:HIDDEN = no THEN DO:
     2055             CASE p-field-setting:
     2056               WHEN "INITIALIZE":U THEN
     2057               DO:
     2058                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     2059                     read-only-list +
     2060                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     2061                        STRING(curr-widget).
     2062               END.
     2063               WHEN "DISABLE":U OR
     2064               WHEN "ENABLE":U THEN
     2065               DO:
     2066                   curr-widget:SENSITIVE = yes.
     2067                   RUN get-attribute ('Read-Only-Editors':U).
     2068                   IF RETURN-VALUE = ? OR
     2069                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     2070                       curr-widget:READ-ONLY =
     2071                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     2072               END.
     2073               WHEN "CLEAR":U THEN
     2074                   curr-widget:SCREEN-VALUE = "":U.
     2075             END CASE.
     2076           END.
     2077           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     2078       END.
     2079       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     2080         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     2081           + '"':U).
     2082       RETURN.
     2083   END PROCEDURE.
     2084   PROCEDURE use-check-modified-all :
     2085    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     2086     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     2087     RETURN.
     2088   END PROCEDURE.
     2089   PROCEDURE use-create-on-add :
     2090   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     2091      RETURN.
     2092   END PROCEDURE.
     2093   PROCEDURE use-initial-lock :
     2094     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     2095     ASSIGN adm-initial-lock = p-attr-value.
     2096     RETURN.
     2097   END PROCEDURE.
     2098     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     2099   ASSIGN
     2100          FRAME F-Main:SCROLLABLE       = FALSE
     2101          FRAME F-Main:HIDDEN           = TRUE.
     2102   ASSIGN
     2103          dop-info:HIDDEN IN FRAME F-Main           = TRUE
     2104          dop-info:READ-ONLY IN FRAME F-Main        = TRUE.
     2105   ASSIGN
     2106          f-invclipt-name:READ-ONLY IN FRAME F-Main        = TRUE.
     2107   ASSIGN
     2108          sec-fields:READ-ONLY IN FRAME F-Main        = TRUE.
     2109   ON CHOOSE OF b-invclipt IN FRAME F-Main
     2110   DO:
     2111     define variable rid-list as character no-undo .
     2112     define buffer buf_clients for ub.clients.
     2113       run ref/cli-all.w
     2114         ( input parParentProc
     2115         , input "b-sel"
     2116         , input 'орг':U
     2117         , input 'все':U
     2118         , input 'текущие':U
     2119         , input ?
     2120         , input "yes,yes,yes,,,,ИЛИ"
     2121         , input "lock-cli-type":U
     2122         , output rid-list
     2123         ) .
     2124       find first buf_clients no-lock
     2125         where recid(buf_clients) = integer( rid-list )
     2126         no-error.
     2127       if available buf_clients then do:
     2128         assign
     2129           f-invclipt      = buf_clients.obj-code
     2130           f-invclipt-name = buf_clients.obj-name
     2131         .
     2132       end.
     2133       else do:
     2134         assign
     2135           f-invclipt      = ?
     2136           f-invclipt-name = "":U
     2137         .
     2138       end.
     2139       display
     2140         f-invclipt
     2141         f-invclipt-name
     2142         with frame F-Main .
     2143   END.
     2144   ON CHOOSE OF B-set_dop-info IN FRAME F-Main
     2145   DO:
     2146     run select-dop-info in this-procedure.
     2147   END.
     2148   ON CHOOSE OF B-set_sec-fields IN FRAME F-Main
     2149   DO:
     2150     run select-sec-fields in this-procedure.
     2151   END.
     2152   ON LEAVE OF otkl-density IN FRAME F-Main
     2153   DO:
     2154     assign
     2155     otkl-density no-error  .
     2156     if error-status:error or decimal (otkl-density) > 1 then do:
     2157       message "Формат поля должен быть меньше единицы и три знака после запятой"
     2158       view-as alert-box.
     2159       RETURN NO-APPLY.
     2160     end.
     2161   END.
     2162   ON LEAVE OF otkl-fact-volue IN FRAME F-Main
     2163   DO:
     2164     assign
     2165     otkl-fact-volue
     2166     .
     2167   END.
     2168   ON LEAVE OF otkl-temp IN FRAME F-Main
     2169   DO:
     2170     assign
     2171     otkl-temp
     2172     .
     2173   END.
     2174   ON LEAVE OF otkl-water IN FRAME F-Main
     2175   DO:
     2176     assign
     2177     otkl-water
     2178     .
     2179   END.
     2180   ON VALUE-CHANGED OF t-invclipt IN FRAME F-Main
     2181   DO:
     2182     assign
     2183       t-invclipt
     2184     .
     2185     if t-invclipt = true then do:
     2186       enable
     2187         f-invclipt
     2188         b-invclipt
     2189         with frame F-Main .
     2190       display
     2191         f-invclipt-name
     2192         with frame F-Main .
     2193     end.
     2194     else do:
     2195       assign
     2196         f-invclipt       = ?
     2197         f-invclipt-name = "":U
     2198       .
     2199       display
     2200         f-invclipt
     2201         f-invclipt-name
     2202         with frame F-Main .
     2203       hide
     2204         f-invclipt
     2205         b-invclipt
     2206         f-invclipt
     2207         in frame F-Main .
     2208     end.
     2209   END.
     2210   if not this-procedure :persistent
     2211   then do:
     2212     message
     2213       vss-workfile vss-revision vss-description skip
     2214       "Ошибка при запуске процедуры" skip
     2215       "Данную процедуру следует запускать только с параметром persistent" skip
     2216       view-as alert-box error .
     2217     undo, return error .
     2218   end.
     2219   PROCEDURE adm-row-available :
     2220     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     2221     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     2222     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     2223     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     2224     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     2225     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     2226     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     2227     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     2228     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     2229     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     2230     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     2231     IF adm-updating-record THEN RETURN.
     2232     RUN get-attribute ('FIELDS-ENABLED':U).
     2233     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     2234     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     2235         OUTPUT link-handle) NO-ERROR.
     2236     IF link-handle = "":U THEN
     2237         RETURN.
     2238     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     2239     IF NUM-ENTRIES(link-handle) > 1 THEN
     2240         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     2241             "encountered more than one RECORD-SOURCE.":U SKIP
     2242             "The first - ":U record-source-hdl:file-name " - will be used.":U
     2243                VIEW-AS ALERT-BOX ERROR.
     2244     RUN get-attribute ('Key-Name':U).
     2245     key-name = RETURN-VALUE.
     2246     IF key-name = "":U THEN key-name = ?.
     2247     IF key-name NE ? THEN DO:
     2248       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     2249         NO-ERROR.
     2250       IF key-value NE ? THEN
     2251         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     2252     END.
     2253     IF key-name eq ? THEN tbl-list = "clients":U.
     2254         RUN send-records IN record-source-hdl
     2255             (INPUT tbl-list, OUTPUT rowid-list) NO-ERROR.
     2256         IF ERROR-STATUS:ERROR THEN RETURN.
     2257     IF key-name ne ?
     2258     THEN DO:
     2259       RUN dispatch ('find-using-key':U).
     2260       IF RETURN-VALUE eq "ADM-ERROR":U THEN RETURN RETURN-VALUE.
     2261     END.
     2262     ELSE
     2263     DO:
     2264       row-avail-cntr = row-avail-cntr + 1.
     2265       row-avail-rowid = TO-ROWID(ENTRY(row-avail-cntr,rowid-list)).
     2266       IF row-avail-rowid NE ROWID(clients) THEN different-row = yes.
     2267       IF row-avail-rowid ne ? THEN DO:
     2268          DO:
     2269            IF row-avail-enabled AND
     2270               (adm-initial-lock = "SHARE-LOCK":U OR
     2271                adm-initial-lock = "EXCLUSIVE-LOCK":U) THEN
     2272            DO:
     2273              IF adm-initial-lock = "SHARE-LOCK":U
     2274              THEN FIND clients WHERE ROWID(clients) = row-avail-rowid SHARE-LOCK NO-ERROR.
     2275              ELSE DO TRANSACTION:
     2276                FIND clients WHERE ROWID(clients) = row-avail-rowid EXCLUSIVE-LOCK NO-ERROR.
     2277              END.
     2278            END.
     2279            ELSE FIND clients WHERE ROWID(clients) = row-avail-rowid  NO-LOCK NO-ERROR.
     2280            IF ERROR-STATUS:ERROR THEN DO:
     2281              RUN dispatch ('show-errors':U).
     2282              RETURN "ADM-ERROR":U.
     2283            END.
     2284          END.
     2285       END.
     2286       ELSE DO:
     2287            IF AVAILABLE clients THEN RELEASE clients.
     2288        END.
     2289     END.
     2290   IF VALID-HANDLE (adm-object-hdl) THEN
     2291       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     2292   RUN notify IN THIS-PROCEDURE ('row-available':U).
     2293     if p-mode = 'ПРОСМОТР':U then do:
     2294         run disable-all IN THIS-PROCEDURE.
     2295     end.
     2296   END PROCEDURE.
     2297   PROCEDURE disable_UI :
     2298     HIDE FRAME F-Main.
     2299     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     2300   END PROCEDURE.
     2301   PROCEDURE disable-all :
     2302       disable
     2303         all
     2304         with frame F-Main .
     2305       enable
     2306         B-set_dop-info
     2307         B-set_sec-fields
     2308         with frame F-Main .
     2309   END PROCEDURE.
     2310   PROCEDURE PartOne-Init :
     2311     DEFINE INPUT PARAMETER iParparentproc AS WIDGET-HANDLE       NO-UNDO.
     2312     DEFINE INPUT PARAMETER iMode          AS CHARACTER           NO-UNDO.
     2313     DEFINE INPUT PARAMETER iObjtype       LIKE ub.clients.obj-type NO-UNDO.
     2314     DEFINE INPUT PARAMETER iObjcode       LIKE ub.shop.obj-code    NO-UNDO.
     2315     DEFINE INPUT PARAMETER TABLE FOR temp-thbj-attr.
     2316     define variable v-entry           as character  no-undo .
     2317     define buffer buf_clients for ub.clients .
     2318     assign
     2319        parparentproc = iParparentproc
     2320        p-mode        = iMode
     2321        p-obj-type    = iObjtype
     2322        p-obj-code    = iObjcode
     2323        .
     2324     for each temp-thbj-attr no-lock
     2325           :
     2326       assign
     2327         v-entry = temp-thbj-attr.prop-code
     2328       .
     2329       case v-entry:
     2330         when 'denstclc':U then do:
     2331           assign
     2332             r-denstclc = temp-thbj-attr.property-value-character
     2333             r-denstclc :private-data in frame F-Main = "recid=" + string(recid(temp-thbj-attr))
     2334           .
     2335         end.
     2336         when 'expptrl':U then do:
     2337           assign
     2338             r-expptrl = temp-thbj-attr.property-value-character
     2339             r-expptrl :private-data in frame F-Main = "recid=" + string(recid(temp-thbj-attr))
     2340           .
     2341         end.
     2342         when 'inpptrl':U then do:
     2343           assign
     2344             r-inpptrl = temp-thbj-attr.property-value-character
     2345             r-inpptrl :private-data in frame F-Main = "recid=" + string(recid(temp-thbj-attr))
     2346           .
     2347         end.
     2348         when 'rvsnmter':U then do:
     2349           assign
     2350             t-rvsnmter = temp-thbj-attr.property-value-logical
     2351             t-rvsnmter :private-data in frame F-Main = "recid=" + string(recid(temp-thbj-attr))
     2352           .
     2353         end.
     2354         when 'invclipt':U then do:
     2355           assign
     2356             f-invclipt = temp-thbj-attr.property-value-integer
     2357             f-invclipt :private-data in frame F-Main = "recid=" + string(recid(temp-thbj-attr))
     2358           .
     2359         end.
     2360         when 'algrvspt':U then do:
     2361           assign
     2362             r-algrvspt = temp-thbj-attr.property-value-integer
     2363             r-algrvspt :private-data in frame F-Main = "recid=" + string(recid(temp-thbj-attr))
     2364           .
     2365         end.
     2366         when 'temp-for-pomi':U then do:
     2367           assign
     2368             r-temp-for-pomi = temp-thbj-attr.property-value-integer
     2369             r-temp-for-pomi :private-data in frame F-Main = "recid=" + string(recid(temp-thbj-attr))
     2370           .
     2371         end.
     2372         when 'CriticalDif':U then
     2373             do:
     2374               assign
     2375                 mass-proc = temp-thbj-attr.property-value-character
     2376                 mass-proc :private-data in frame F-Main = "recid=" + string(recid(temp-thbj-attr))
     2377               .
     2378             end.
     2379         when 'algoincome':U then
     2380             do:
     2381               assign
     2382                 r-algoincptrl = temp-thbj-attr.property-value-integer
     2383                 r-algoincptrl :private-data in frame F-Main = "recid=" + string(recid(temp-thbj-attr))
     2384                 .
     2385             end.
     2386         when 'otkl-fact-volue':U then
     2387             do:
     2388               assign
     2389                 otkl-fact-volue = temp-thbj-attr.property-value-decimal
     2390                 otkl-fact-volue :private-data in frame F-Main = "recid=" + string(recid(temp-thbj-attr))
     2391                 .
     2392             end.
     2393         when 'otkl-temp':U then
     2394             do:
     2395               assign
     2396                 otkl-temp = temp-thbj-attr.property-value-decimal
     2397                 otkl-temp :private-data in frame F-Main = "recid=" + string(recid(temp-thbj-attr))
     2398                 .
     2399             end.
     2400         when 'otkl-density':U then
     2401             do:
     2402               assign
     2403                 otkl-density = temp-thbj-attr.property-value-character
     2404                 otkl-density :private-data in frame F-Main = "recid=" + string(recid(temp-thbj-attr))
     2405                 .
     2406                 if otkl-density = "" then otkl-density = "0.000" .
     2407             end.
     2408         when 'otkl-water':U then
     2409             do:
     2410               assign
     2411                 otkl-water = temp-thbj-attr.property-value-decimal
     2412                 otkl-water :private-data in frame F-Main = "recid=" + string(recid(temp-thbj-attr))
     2413                 .
     2414             end.
     2415         when 'mand-choice-autocar':U then
     2416             do:
     2417               assign
     2418                 t-mand-chioce-autocar = temp-thbj-attr.property-value-logical
     2419                 t-mand-chioce-autocar :private-data in frame F-Main = "recid=" + string(recid(temp-thbj-attr))
     2420               .
     2421             end.
     2422           when 'dop-info':U then
     2423             do:
     2424               assign
     2425                 dop-info = temp-thbj-attr.property-value-character
     2426                 dop-info :private-data in frame F-Main = "recid=" + string(recid(temp-thbj-attr))
     2427               .
     2428             end.
     2429           when 'sec-fields':U then
     2430             do:
     2431               assign
     2432                 sec-fields = temp-thbj-attr.property-value-character
     2433                 sec-fields :private-data in frame F-Main = "recid=" + string(recid(temp-thbj-attr))
     2434               .
     2435             end.
     2436           when 'CriticalDifInLgas':U then
     2437             do:
     2438               assign
     2439                 mass-proc-in-lgas = temp-thbj-attr.property-value-decimal
     2440                 mass-proc-in-lgas :private-data in frame F-Main = "recid=" + string(recid(temp-thbj-attr))
     2441               .
     2442             end.
     2443           when 'calc-free-vol':U then
     2444             do:
     2445               assign
     2446                 t-calc-free-vol = temp-thbj-attr.property-value-logical
     2447                 t-calc-free-vol :private-data in frame F-Main = "recid=" + string(recid(temp-thbj-attr))
     2448               .
     2449             end.
     2450           when 'calc-free-vol-sug':U then
     2451             do:
     2452               assign
     2453                 t-calc-free-vol-sug = temp-thbj-attr.property-value-logical
     2454                 t-calc-free-vol-sug :private-data in frame F-Main = "recid=" + string(recid(temp-thbj-attr))
     2455               .
     2456             end.
     2457           when 'trn-reas-sug':U then
     2458             do:
     2459               assign
     2460                 t-trn-reas-sug = temp-thbj-attr.property-value-logical
     2461                 t-trn-reas-sug :private-data in frame F-Main = "recid=" + string(recid(temp-thbj-attr))
     2462               .
     2463             end.
     2464           otherwise do:
     2465               delete temp-thbj-attr.
     2466           end.
     2467       end case.
     2468     end.
     2469     find first buf_clients no-lock
     2470       where buf_clients.obj-code = f-invclipt
     2471         and buf_clients.obj-type = 'орг':U
     2472       no-error.
     2473     if available buf_clients then do:
     2474       assign
     2475         t-invclipt      = true
     2476         f-invclipt-name = buf_clients.obj-name
     2477       .
     2478     end.
     2479     else do:
     2480       assign
     2481         t-invclipt      = false
     2482         f-invclipt-name = "":U
     2483       .
     2484     end.
     2485     RUN proc-init-dop-info.
     2486     RUN proc-init-sec-fields.
     2487     define variable v-obj-code as integer no-undo .
     2488     define variable v-obj-type as character no-undo .
     2489     if p-obj-code = 0 then do:
     2490         assign
     2491         v-obj-code = v-cntxt-obj-code
     2492         v-obj-type = v-cntxt-obj-type
     2493         .
     2494     end.
     2495     else do:
     2496         assign
     2497         v-obj-code = p-obj-code
     2498         v-obj-type = p-obj-type
     2499         .
     2500     end.
     2501       find last ub.shift-obj no-lock where ub.shift-obj.obj-code = v-obj-code and
     2502           ub.shift-obj.obj-type = v-obj-type no-error .
     2503       if available (ub.shift-obj) then
     2504       do:
     2505           find first ub.shift-param no-lock where ub.shift-param.obj-code = ub.shift-obj.obj-code and
     2506               ub.shift-param.obj-type = ub.shift-obj.obj-type and
     2507               ub.shift-param.shift-date = ub.shift-obj.shift-date and
     2508               ub.shift-param.shift-name = ub.shift-obj.shift-name and
     2509               ub.shift-param.shift-num = ub.shift-obj.shift-num no-error .
     2510           if not available (ub.shift-param) then
     2511           do:
     2512               find first ub.shift-param no-lock where ub.shift-param.obj-code = 0 and
     2513                   ub.shift-param.obj-type = "" and
     2514                   ub.shift-param.shift-date = 01.01.1900 no-error .
     2515               if available (ub.shift-param) then
     2516                   assign
     2517                       dev-paid-trans = ub.shift-param.dev-paid-trans
     2518                       prc-dev-mass   = ub.shift-param.prc-dev-mass
     2519                       .
     2520           end.
     2521           else
     2522           do:
     2523               assign
     2524                   dev-paid-trans = ub.shift-param.dev-paid-trans
     2525                   prc-dev-mass   = ub.shift-param.prc-dev-mass
     2526                   .
     2527           end.
     2528       end.
     2529       display dev-paid-trans prc-dev-mass with frame F-Main .
     2530     apply "value-changed" to t-invclipt in frame F-Main .
     2531     DISPLAY r-algoincptrl t-mand-chioce-autocar t-trn-reas-sug t-calc-free-vol t-calc-free-vol-sug r-expptrl r-inpptrl dop-info sec-fields r-temp-for-pomi r-algrvspt t-rvsnmter t-invclipt f-invclipt r-denstclc mass-proc mass-proc-in-lgas otkl-fact-volue otkl-temp Prc-dev-mass otkl-density otkl-water Dev-paid-trans v-dop-info v-sec-fields f-invclipt-name
     2532         WITH FRAME F-Main.
     2533     hide dop-info in frame F-Main .
     2534     hide sec-fields in frame F-Main .
     2535   END PROCEDURE.
     2536   PROCEDURE send-records :
     2537   END PROCEDURE.
     2538   PROCEDURE state-changed :
     2539     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     2540     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     2541     CASE p-state:
     2542       WHEN 'update-begin':U THEN DO:
     2543           RUN dispatch('enable-fields':U).
     2544           IF RETURN-VALUE = "ADM-ERROR":U THEN
     2545           DO:
     2546             RUN new-state('update-failed,TABLEIO-SOURCE':U).
     2547             RUN new-state('update-complete':U).
     2548           END.
     2549           ELSE RUN new-state ('update':U).
     2550       END.
     2551       WHEN 'update-complete':U THEN DO:
     2552           RUN new-state ('update-complete':U).
     2553       END.
     2554     END CASE.
     2555   END PROCEDURE.
     2556   PROCEDURE PartOne-Get :
     2557      DEFINE OUTPUT PARAMETER TABLE FOR temp-thbj-attr.
     2558      define variable wh                as widget-handle  no-undo .
     2559      define variable fh                as widget-handle  no-undo .
     2560      define buffer buf_clients for ub.clients .
     2561      ASSIGN FRAME F-Main r-algoincptrl t-mand-chioce-autocar t-trn-reas-sug t-calc-free-vol t-calc-free-vol-sug r-expptrl r-inpptrl dop-info sec-fields r-temp-for-pomi r-algrvspt t-rvsnmter t-invclipt f-invclipt r-denstclc mass-proc mass-proc-in-lgas otkl-fact-volue otkl-temp Prc-dev-mass otkl-density otkl-water Dev-paid-trans v-dop-info v-sec-fields f-invclipt-name.
     2562      display dop-info sec-fields with frame F-Main .
     2563      hide dop-info sec-fields in frame F-Main .
     2564     assign
     2565       frame F-Main t-invclipt
     2566       frame F-Main f-invclipt
     2567       fh = frame F-Main:first-child
     2568       wh = fh:first-child
     2569     .
     2570     if t-invclipt = true then do:
     2571       find first buf_clients no-lock
     2572         where buf_clients.obj-code = f-invclipt
     2573           and buf_clients.obj-type = 'орг':U
     2574         no-error.
     2575       if not available buf_clients then do:
     2576         message
     2577           "Некорректное значение НАСТРОЙКИ"    skip
     2578           t-invclipt:label                     skip
     2579           view-as alert-box error .
     2580         undo, return error .
     2581       end.
     2582     end.
     2583     do while valid-handle(wh):
     2584       if wh:private-data begins "recid=" then do:
     2585         find first temp-thbj-attr
     2586           where recid(temp-thbj-attr) = integer(entry(2, wh:private-data, '='))
     2587         .
     2588         assign
     2589           buffer temp-thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value
     2590         .
     2591       end.
     2592       wh = wh:next-sibling.
     2593     end.
     2594   END PROCEDURE.
     2595   PROCEDURE proc-init-dop-info :
     2596      assign
     2597         v-list-dop-info      = 'car-num':U + "," + 'fio-driver':U + "," + 'time-income':U + "," + 'date-income':U + "," + 'time-pour':U + "," + 'date-pour':U + "," + 'inspection-cert':U + ","
     2598         + 'date-cert':U + "," + 'date-pasport':U  + "," + 'num-pasport':U + "," + 'condition':U + "," + 'seals-condition':U + "," + 'acc-ship':U + "," + 'doc-not':U + "," + 'spisok-not-doc':U + "," + 'ptbobj':U +
     2599         "," + 'ptb-item-pour':U + "," + 'autoent':U.
     2600         v-list-dop-info-full = "Гос. № автоцистерны" + "," + "Ф.И.О. водителя-экспедитора" + "," + "Время прибытия на АЗС" + "," + "Дата прибытия на АЗС" + "," + "Время налива" + "," + "Дата налива" + "," + "Свидетельство о поверке" + ","
     2601         + "Дата свидетельства о поверке" + "," + "Паспорт качества дата" + "," + "Паспорт качества номер" + "," + "Техническое состояние" + "," + "Пломбы и их состояние" + "," + "Допустимый % погрешности поставщика" + "," + "Документы НЕ предоставлены" + "," + "Список не предоставленных документов" +
     2602          "," + "Нефтебаза/ГНС" + "," + "Примечание к нефтебазе" + "," + "Автопредприятие".
     2603   END PROCEDURE.
     2604   PROCEDURE proc-init-sec-fields :
     2605      assign
     2606         v-list-sec-fields      = "section-name,cli-qnty,doc-dens,group-np,list-tank,"
     2607                                + "ttn-temp,acc-ship,doc-dens-st,doc-qnty,doc-volume,"
     2608                                + "shape,pour,num-passport,car-vol,pasp-dens,"
     2609                                + "a-b-tarir,tank-density,tank-temp,dens-temp,"
     2610                                + "place-si,place-si-temp,accessIDLowerLevel".
     2611         v-list-sec-fields-full = "Номер секции,Масса по док.,Плотность по док. (при раб. темп.),Группа НП/Давление насыщенных паров,Резервуар,"
     2612                                + "Температура по ТТН,Погр. изм. пост.,Плотность по док. (при станд. темп.),Кол-во по док.,Объем по док.,"
     2613                                + "Форма горловины,Тип налива,Дата и номер паспорта качества,Объем по свидетельству о поверке,Плотность по паспорту,"
     2614                                + "Отклонение от тарировочной планки,Плотность топлива,Температура замера объема,Температура замера плотности,"
     2615                                + "Средство измерения плотности,Средство измерения температуры,Идентиф. доступа (ключ) «нижнего уровня»".
     2616   END PROCEDURE.
     2617   PROCEDURE select-dop-info :
     2618   define variable v-counter       as integer      no-undo.
     2619   define variable v-label         as character    no-undo.
     2620   define variable v-value         as character    no-undo.
     2621   define variable v-list          as character    no-undo.
     2622   define variable v-changed       as logical    no-undo.
     2623   define variable v-accepted      as logical    no-undo.
     2624   define variable v-mode          as integer    no-undo.
     2625   define variable V-EX as logical   no-undo .
     2626   do
     2627   with frame F-Main
     2628   on error undo, return error
     2629   :
     2630   if p-mode = 'ПРОСМОТР':U then v-mode = 0 .
     2631   else v-mode = 1 .
     2632       run twowin_clear in this-procedure.
     2633       do v-counter = 1 to num-entries( v-list-dop-info-full )
     2634       on error undo, return error
     2635       :
     2636           assign
     2637               v-label = entry( v-counter, v-list-dop-info-full )
     2638               v-value = entry( v-counter, v-list-dop-info )
     2639               v-ex = false
     2640           .
     2641              if  lookup (v-value , dop-info ) > 0 then  v-ex = true .
     2642              else v-ex = false .
     2643           run twowin_add-item in this-procedure (
     2644                 input v-value
     2645               , input v-label
     2646               , input substitute( "Обязательные поля: &1", v-VALUE)
     2647               , input  V-EX
     2648           ).
     2649       end.
     2650       run gbl/twowin.w (
     2651             input ?
     2652           , input v-mode
     2653           , input "Выбор обязательного поля доп.инфо ПН":U
     2654           , input "":U
     2655           , input "&Тест"
     2656           , input table temp_twowin_items
     2657           , output table temp_twowin_itemsSelected_col
     2658           , output v-changed
     2659           , output v-accepted
     2660       ).
     2661       if v-changed then do:
     2662           dop-info = "" .
     2663           for each temp_twowin_itemsSelected_col :
     2664           dop-info = dop-info +  temp_twowin_itemsSelected_col.itmExtKey + "," .
     2665           end.
     2666           dop-info = trim(dop-info, ",") .
     2667           display dop-info with frame F-Main .
     2668           hide dop-info in frame F-Main .
     2669       end.
     2670   end.
     2671   END PROCEDURE.
     2672   PROCEDURE select-sec-fields :
     2673   define variable v-counter       as integer      no-undo.
     2674   define variable v-label         as character    no-undo.
     2675   define variable v-value         as character    no-undo.
     2676   define variable v-list          as character    no-undo.
     2677   define variable v-changed       as logical    no-undo.
     2678   define variable v-accepted      as logical    no-undo.
     2679   define variable v-mode          as integer    no-undo.
     2680   define variable V-EX as logical   no-undo .
     2681   do
     2682   with frame F-Main
     2683   on error undo, return error
     2684   :
     2685   if p-mode = 'ПРОСМОТР':U then v-mode = 0 .
     2686   else v-mode = 1 .
     2687       run twowin_clear in this-procedure.
     2688       do v-counter = 1 to num-entries( v-list-sec-fields-full )
     2689       on error undo, return error
     2690       :
     2691           assign
     2692               v-label = entry( v-counter, v-list-sec-fields-full )
     2693               v-value = entry( v-counter, v-list-sec-fields )
     2694               v-ex = false
     2695           .
     2696              if  lookup (v-value , sec-fields ) > 0 then  v-ex = true .
     2697              else v-ex = false .
     2698           run twowin_add-item in this-procedure (
     2699                 input v-value
     2700               , input v-label
     2701               , input substitute( "Обязательные поля: &1", v-VALUE)
     2702               , input  V-EX
     2703           ).
     2704       end.
     2705       run gbl/twowin.w (
     2706             input ?
     2707           , input v-mode
     2708           , input "Выбор обязательного поля в секциях ПН":U
     2709           , input "":U
     2710           , input "&Тест"
     2711           , input table temp_twowin_items
     2712           , output table sect_twowin_itemsSelected_col
     2713           , output v-changed
     2714           , output v-accepted
     2715       ).
     2716       if v-changed then do:
     2717           sec-fields = "" .
     2718           for each sect_twowin_itemsSelected_col :
     2719           sec-fields = sec-fields +  sect_twowin_itemsSelected_col.itmExtKey + "," .
     2720           end.
     2721           sec-fields = trim(sec-fields, ",") .
     2722           display sec-fields with frame F-Main .
     2723           hide sec-fields in frame F-Main .
     2724       end.
     2725   end.
     2726   END PROCEDURE.
