      736   procedure twowin_clear :
      737       define buffer buf_temp_twowin_items        for temp_twowin_items.
      738   do
      739   for buf_temp_twowin_items
      740   on error undo, return error
      741   :
      742       empty temp-table buf_temp_twowin_items.
      743   end.
      744   end procedure.
      745   procedure twowin_add-item :
      746   define input parameter p-ext-key   as character        no-undo.
      747   define input parameter p-item-name as character        no-undo.
      748   define input parameter p-item-desc as character        no-undo.
      749   define input parameter p-selected  as logical          no-undo.
      750       define buffer buf_temp_twowin_items        for temp_twowin_items.
      751   do
      752   for buf_temp_twowin_items
      753   on error undo, return error
      754   :
      755       assign
      756           v-twowin5-itm-key = v-twowin5-itm-key + 1
      757       .
      758       create temp_twowin_items.
      759       assign
      760           temp_twowin_items.itm-key      = v-twowin5-itm-key
      761           temp_twowin_items.itmExtKey    = p-ext-key
      762           temp_twowin_items.itmName      = p-item-name
      763           temp_twowin_items.itmDesc      = p-item-desc
      764           temp_twowin_items.itmSelected  = p-selected
      765           temp_twowin_items.selLeft      = no
      766           temp_twowin_items.selRight     = no
      767       .
      768   end.
      769   end procedure.
      770   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      771   define new global shared variable g#trdcalib as handle no-undo.
      772   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      773   procedure cur-time :
      774      define output parameter p-today as date      no-undo .
      775      define output parameter p-time  as integer   no-undo .
      776     do
      777     on error undo, return error
      778     :
      779       define variable v-date1 as date      no-undo .
      780       define variable v-date2 as date      no-undo .
      781       define variable v-time  as integer   no-undo .
      782       assign
      783         v-date1 = today
      784         v-time  = time
      785         v-date2 = today
      786       .
      787       if v-date1 <> v-date2
      788       then do:
      789         assign
      790           v-date1 = today
      791           v-time  = v-time
      792         .
      793       end.
      794       assign
      795         p-today = v-date1
      796         p-time  = v-time
      797       .
      798     end.
      799   end.
      800   function cur-time-date returns character
      801   :
      802     return string(today, '99/99/9999':U) .
      803   end.
      804   function cur-time-mjd returns decimal
      805   :
      806     define variable v-date as date      no-undo .
      807     define variable v-time as integer   no-undo .
      808     run cur-time in this-procedure
      809       (output v-date
      810       ,output v-time
      811       ) .
      812     return integer(v-date) - 2400002 + (v-time / 86400) .
      813   end.
      814   function cur-time-get-ending-index returns integer
      815   (input p-number as integer
      816   )
      817   :
      818     if p-number < 0
      819     or p-number = ?
      820     then do:
      821       return 1 .
      822     end.
      823     define variable v-rest as integer   no-undo .
      824     assign
      825       p-number = p-number modulo 100
      826     .
      827     if p-number < 20
      828     then do:
      829       assign
      830         v-rest = p-number
      831       .
      832     end.
      833     else do:
      834       assign
      835         v-rest = p-number modulo 10
      836       .
      837     end.
      838     case v-rest :
      839       when 1
      840       then do:
      841         return 2 .
      842       end.
      843       when 2 or
      844       when 3 or
      845       when 4
      846       then do:
      847         return 3 .
      848       end.
      849       otherwise do:
      850         return 1 .
      851       end.
      852     end case .
      853   end.
      854   procedure cur-time-mjd-to-date :
      855      define input  parameter i-mjd-diff as decimal no-undo.
      856      define output parameter o-Date     as date    no-undo.
      857      define output parameter o-Time     as integer no-undo.
      858      define variable v-day-number as integer   no-undo .
      859      if    i-mjd-diff < 0
      860         or i-mjd-diff = ?
      861      then do:
      862         return "?" .
      863      end.
      864      assign
      865         v-day-number = truncate(i-mjd-diff,0).
      866         o-Date = date(v-day-number + 2400002).
      867         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      868     .
      869   end.
      870   function cur-time-mjd-to-string returns character
      871   (input p-mjd-diff as decimal
      872   )
      873   :
      874     define variable v-day-number as integer   no-undo .
      875     define variable v-seconds    as integer   no-undo .
      876     define variable v-hour       as integer   no-undo .
      877     define variable v-min        as integer   no-undo .
      878     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      879     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      880     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      881     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      882     if p-mjd-diff < 0
      883     or p-mjd-diff = ?
      884     then do:
      885       return "?" .
      886     end.
      887     assign
      888       v-day-number = integer(truncate(p-mjd-diff,0))
      889       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      890     .
      891     if v-seconds > 86400
      892     then do:
      893       assign
      894         v-seconds = 86400 - 1
      895       .
      896     end.
      897     if v-seconds < 0
      898     then do:
      899       assign
      900         v-seconds = 0
      901       .
      902     end.
      903     assign
      904       v-hour = truncate(v-seconds / 3600, 0)
      905     .
      906     assign
      907       v-seconds = v-seconds modulo 3600
      908     .
      909     assign
      910       v-min = truncate(v-seconds / 60, 0)
      911     .
      912     assign
      913       v-seconds = v-seconds modulo 60
      914     .
      915     return
      916         (if v-day-number <> 0
      917           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      918           else ""
      919         )
      920       + (if v-day-number <> 0 or v-hour <> 0
      921           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      922           else ""
      923         )
      924       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      925           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      926           else ""
      927         )
      928       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      929       .
      930   end.
      931   function cur-time-string returns character
      932   :
      933     define variable v-date as date      no-undo .
      934     define variable v-time as integer   no-undo .
      935     run cur-time in this-procedure
      936       (output v-date
      937       ,output v-time
      938       ) .
      939     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      940   end.
      941   function cur-time-string-sec returns character
      942   :
      943     define variable v-date as date      no-undo .
      944     define variable v-time as integer   no-undo .
      945     run cur-time in this-procedure
      946       (output v-date
      947       ,output v-time
      948       ) .
      949     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      950   end.
      951   function cur-time-custom  returns character
      952   (input p-prefix as character
      953   ,input p-date-format as character
      954   ,input p-delimiter as character
      955   ,input p-time-format as character
      956   ,input p-suffix as character
      957   )
      958   :
      959     define variable v-date as date      no-undo .
      960     define variable v-time as integer   no-undo .
      961     run cur-time in this-procedure
      962       (output v-date
      963       ,output v-time
      964       ) .
      965     return
      966       p-prefix
      967       + string(v-date, p-date-format)
      968       + p-delimiter
      969       + string(v-time, p-time-format)
      970       + p-suffix
      971       .
      972   end.
      973   function cur-time-print  returns character
      974   :
      975     define variable v-date as date      no-undo .
      976     define variable v-time as integer   no-undo .
      977     run cur-time in this-procedure
      978       (output v-date
      979       ,output v-time
      980       ) .
      981     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      982   end.
      983   function cur-time-datetime returns datetime
      984   :
      985     define variable v-char as character no-undo .
      986     define variable v-datetime as datetime no-undo .
      987     v-char = cur-time-string().
      988     v-datetime = datetime(v-char).
      989     return  v-datetime.
      990   end.
      991   function cur-time-string-msec returns character
      992   :
      993     define variable v-date as datetime  no-undo .
      994     v-date = now.
      995     return string(v-date) .
      996   end.
      997   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      998   procedure sys-time_get-sys :
      999     define output parameter p-year         as integer   no-undo .
     1000     define output parameter p-month        as integer   no-undo .
     1001     define output parameter p-day          as integer   no-undo .
     1002     define output parameter p-hour         as integer   no-undo .
     1003     define output parameter p-minute       as integer   no-undo .
     1004     define output parameter p-second       as integer   no-undo .
     1005     define output parameter p-milliseconds as integer   no-undo .
     1006     define variable v-system-time-structure as memptr    no-undo.
     1007     do
     1008     on error undo, return error return-value
     1009     :
     1010       assign
     1011         set-size(v-system-time-structure) = 16
     1012       .
     1013       run GetSystemTime
     1014         (input  get-pointer-value(v-system-time-structure)
     1015         ) .
     1016       assign
     1017         p-year         = get-short(v-system-time-structure,  1)
     1018         p-month        = get-short(v-system-time-structure,  3)
     1019         p-day          = get-short(v-system-time-structure,  7)
     1020         p-hour         = get-short(v-system-time-structure,  9)
     1021         p-minute       = get-short(v-system-time-structure, 11)
     1022         p-second       = get-short(v-system-time-structure, 13)
     1023         p-milliseconds = get-short(v-system-time-structure, 15)
     1024       .
     1025       assign
     1026         set-size(v-system-time-structure) = 0
     1027       .
     1028     end.
     1029   end procedure.
     1030   procedure sys-time_get-comp-user-name :
     1031     define output parameter p-computer-name as character no-undo .
     1032     define output parameter p-user-name     as character no-undo .
     1033     define output parameter p-process-pid   as integer   no-undo .
     1034     define variable v-return-value  as integer   no-undo .
     1035     define variable v-buffer-length as integer   no-undo .
     1036     define variable v-buffer-memptr as memptr    no-undo .
     1037     do
     1038     on error undo, return error return-value
     1039     :
     1040       assign
     1041         v-buffer-length = 1024
     1042         set-size(v-buffer-memptr) = v-buffer-length + 4
     1043       .
     1044       assign
     1045         put-long(v-buffer-memptr, 1) = v-buffer-length
     1046       .
     1047       run GetComputerNameA
     1048         (input  get-pointer-value(v-buffer-memptr) + 4
     1049         ,input  get-pointer-value(v-buffer-memptr)
     1050         ,output v-return-value
     1051         ) .
     1052       if v-return-value <> 0
     1053       then do:
     1054         assign
     1055           p-computer-name = get-string(v-buffer-memptr, 5)
     1056         .
     1057       end.
     1058       assign
     1059         put-long(v-buffer-memptr, 1) = v-buffer-length
     1060       .
     1061       run GetUserNameA
     1062         (input  get-pointer-value(v-buffer-memptr) + 4
     1063         ,input  get-pointer-value(v-buffer-memptr)
     1064         ,output v-return-value
     1065         ) .
     1066       if v-return-value <> 0
     1067       then do:
     1068         assign
     1069           p-user-name = get-string(v-buffer-memptr, 5)
     1070         .
     1071       end.
     1072       run GetCurrentProcessId
     1073         (output p-process-pid
     1074         ) .
     1075       assign
     1076         set-size(v-buffer-memptr) = 0
     1077       .
     1078     end.
     1079   end procedure.
     1080   procedure sys-time_get-http :
     1081     define output parameter p-http-time as character no-undo .
     1082     define variable v-year         as integer   no-undo .
     1083     define variable v-month        as integer   no-undo .
     1084     define variable v-day-of-week  as integer   no-undo .
     1085     define variable v-day          as integer   no-undo .
     1086     define variable v-hour         as integer   no-undo .
     1087     define variable v-minute       as integer   no-undo .
     1088     define variable v-second       as integer   no-undo .
     1089     define variable v-milliseconds as integer   no-undo .
     1090     do
     1091     on error undo, return error return-value
     1092     :
     1093       run sys-time_get-sys in this-procedure
     1094         (output v-year
     1095         ,output v-month
     1096         ,output v-day
     1097         ,output v-hour
     1098         ,output v-minute
     1099         ,output v-second
     1100         ,output v-milliseconds
     1101         ) .
     1102       assign
     1103         v-day-of-week = weekday(date(v-month, v-day, v-year))
     1104         p-http-time = entry(v-day-of-week, 'Sun,Mon,Tue,Wed,Thu,Fri,Sat')
     1105                     + ', ':u
     1106                     + string(v-day, '99':u)
     1107                     + ' ':u
     1108                     + entry(v-month, 'Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec':u)
     1109                     + ' ':u
     1110                     + string(v-year, '9999':u)
     1111                     + ' ':u
     1112                     + string(v-hour, '99':u)
     1113                     + ':':u
     1114                     + string(v-minute, '99':u)
     1115                     + ':':u
     1116                     + string(v-second, '99':u)
     1117                     + ' ':u
     1118                     + 'GMT':u
     1119       .
     1120     end.
     1121   end procedure.
     1122   procedure sys-time_set-sys :
     1123     define input  parameter p-year         as integer   no-undo .
     1124     define input  parameter p-month        as integer   no-undo .
     1125     define input  parameter p-day          as integer   no-undo .
     1126     define input  parameter p-hour         as integer   no-undo .
     1127     define input  parameter p-minute       as integer   no-undo .
     1128     define input  parameter p-second       as integer   no-undo .
     1129     define input  parameter p-milliseconds as integer   no-undo .
     1130     define variable v-system-time-structure as memptr    no-undo.
     1131     define variable v-return-value as integer   no-undo .
     1132     define variable v-day-of-week  as integer   no-undo .
     1133     do
     1134     on error undo, return error return-value
     1135     :
     1136       assign
     1137         v-day-of-week = weekday(date(p-month, p-day, p-year))
     1138       .
     1139       assign
     1140         set-size(v-system-time-structure) = 16
     1141       .
     1142       assign
     1143         put-short(v-system-time-structure,  1) = p-year
     1144         put-short(v-system-time-structure,  3) = p-month
     1145         put-short(v-system-time-structure,  5) = v-day-of-week
     1146         put-short(v-system-time-structure,  7) = p-day
     1147         put-short(v-system-time-structure,  9) = p-hour
     1148         put-short(v-system-time-structure, 11) = p-minute
     1149         put-short(v-system-time-structure, 13) = p-second
     1150         put-short(v-system-time-structure, 15) = p-milliseconds
     1151       .
     1152       run SetSystemTime
     1153         (input  get-pointer-value(v-system-time-structure)
     1154         ,output v-return-value
     1155         ) .
     1156       assign
     1157         set-size(v-system-time-structure) = 0
     1158       .
     1159       if v-return-value = 0
     1160       then do:
     1161         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
     1162       end.
     1163     end.
     1164   end procedure.
     1165   procedure sys-time_sys-to-mjd :
     1166     define input  parameter p-year         as integer   no-undo .
     1167     define input  parameter p-month        as integer   no-undo .
     1168     define input  parameter p-day          as integer   no-undo .
     1169     define input  parameter p-hour         as integer   no-undo .
     1170     define input  parameter p-minute       as integer   no-undo .
     1171     define input  parameter p-second       as integer   no-undo .
     1172     define input  parameter p-milliseconds as integer   no-undo .
     1173     define output parameter p-mjd          as decimal   no-undo .
     1174     define variable v-year-correction as decimal   no-undo .
     1175     define variable v-shift-year as decimal   no-undo .
     1176     do
     1177     on error undo, return error return-value
     1178     :
     1179       assign
     1180         v-year-correction = truncate((decimal(p-month) - 14.0) / 12, 0)
     1181         v-shift-year      = decimal(p-year) + v-year-correction
     1182         p-mjd = truncate( (1461.0 * (v-shift-year + 4800.0 ) ) / 4, 0)
     1183               + truncate( (367.0 * (decimal(p-month) - 2.0 - v-year-correction * 12) ) / 12, 0)
     1184               - truncate( (3 * truncate((v-shift-year + 4900 ) / 100,0) ) / 4, 0)
     1185               + decimal(p-day) - 2432076.0
     1186               + p-hour / 24.0
     1187               + p-minute / 1440.0
     1188               + p-second / 86400.0
     1189               + p-milliseconds / 86400000.0
     1190       .
     1191     end.
     1192   end procedure.
     1193   procedure sys-time_sys-to-loc :
     1194     define input  parameter p-sys-year         as integer   no-undo .
     1195     define input  parameter p-sys-month        as integer   no-undo .
     1196     define input  parameter p-sys-day          as integer   no-undo .
     1197     define input  parameter p-sys-hour         as integer   no-undo .
     1198     define input  parameter p-sys-minute       as integer   no-undo .
     1199     define input  parameter p-sys-second       as integer   no-undo .
     1200     define input  parameter p-sys-milliseconds as integer   no-undo .
     1201     define output parameter p-loc-year         as integer   no-undo .
     1202     define output parameter p-loc-month        as integer   no-undo .
     1203     define output parameter p-loc-day          as integer   no-undo .
     1204     define output parameter p-loc-hour         as integer   no-undo .
     1205     define output parameter p-loc-minute       as integer   no-undo .
     1206     define output parameter p-loc-second       as integer   no-undo .
     1207     define output parameter p-loc-milliseconds as integer   no-undo .
     1208     define variable v-system-time-structure as memptr    no-undo.
     1209     define variable v-return-value          as integer   no-undo .
     1210     define variable v-sys-day-of-week       as integer   no-undo .
     1211     do
     1212     on error undo, return error return-value
     1213     :
     1214       assign
     1215         v-sys-day-of-week = weekday(date(p-sys-month, p-sys-day, p-sys-year))
     1216       .
     1217       assign
     1218         set-size(v-system-time-structure) = 32
     1219       .
     1220       assign
     1221         put-short(v-system-time-structure,  1) = p-sys-year
     1222         put-short(v-system-time-structure,  3) = p-sys-month
     1223         put-short(v-system-time-structure,  5) = v-sys-day-of-week
     1224         put-short(v-system-time-structure,  7) = p-sys-day
     1225         put-short(v-system-time-structure,  9) = p-sys-hour
     1226         put-short(v-system-time-structure, 11) = p-sys-minute
     1227         put-short(v-system-time-structure, 13) = p-sys-second
     1228         put-short(v-system-time-structure, 15) = p-sys-milliseconds
     1229       .
     1230       run SystemTimeToTzSpecificLocalTime
     1231         (input  0
     1232         ,input  get-pointer-value(v-system-time-structure)
     1233         ,input  get-pointer-value(v-system-time-structure) + 16
     1234         ,output v-return-value
     1235         ) .
     1236       assign
     1237         p-loc-year         = get-short(v-system-time-structure,  1 + 16)
     1238         p-loc-month        = get-short(v-system-time-structure,  3 + 16)
     1239         p-loc-day          = get-short(v-system-time-structure,  7 + 16)
     1240         p-loc-hour         = get-short(v-system-time-structure,  9 + 16)
     1241         p-loc-minute       = get-short(v-system-time-structure, 11 + 16)
     1242         p-loc-second       = get-short(v-system-time-structure, 13 + 16)
     1243         p-loc-milliseconds = get-short(v-system-time-structure, 15 + 16)
     1244       .
     1245       assign
     1246         set-size(v-system-time-structure) = 0
     1247       .
     1248       if v-return-value = 0
     1249       then do:
     1250         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
     1251       end.
     1252     end.
     1253   end procedure.
     1254   procedure sys-time_mjd-to-sys :
     1255     define input  parameter p-mjd          as decimal   no-undo .
     1256     define output parameter p-year         as integer   no-undo .
     1257     define output parameter p-month        as integer   no-undo .
     1258     define output parameter p-day          as integer   no-undo .
     1259     define output parameter p-hour         as integer   no-undo .
     1260     define output parameter p-minute       as integer   no-undo .
     1261     define output parameter p-second       as integer   no-undo .
     1262     define output parameter p-milliseconds as integer   no-undo .
     1263     define variable v-year-correction as decimal   no-undo .
     1264     define variable v-shift-year      as decimal   no-undo .
     1265     define variable v-conv-date     as date      no-undo .
     1266     define variable v-int-part      as integer   no-undo .
     1267     define variable v-fraction-part as decimal   no-undo .
     1268     do
     1269     on error undo, return error return-value
     1270     :
     1271       assign
     1272         v-int-part      = integer(truncate(p-mjd, 0))
     1273         v-fraction-part = p-mjd - v-int-part
     1274         v-conv-date     = date(11, 17, 1858) + v-int-part
     1275         p-year          = year(v-conv-date)
     1276         p-month         = month(v-conv-date)
     1277         p-day           = day(v-conv-date)
     1278         v-fraction-part = v-fraction-part * 24.0
     1279         p-hour          = integer(truncate(v-fraction-part, 0))
     1280         v-fraction-part = (v-fraction-part - p-hour) * 60.0
     1281         p-minute        = integer(truncate(v-fraction-part, 0))
     1282         v-fraction-part = (v-fraction-part - p-minute) * 60.0
     1283         p-second        = integer(truncate(v-fraction-part, 0))
     1284         v-fraction-part = (v-fraction-part - p-second) * 1000.0
     1285         p-milliseconds  = integer(v-fraction-part)
     1286       .
     1287     end.
     1288   end procedure.
     1289   procedure sys-time_mjd-to-loc :
     1290     define input  parameter p-mjd              as decimal   no-undo .
     1291     define output parameter p-loc-year         as integer   no-undo .
     1292     define output parameter p-loc-month        as integer   no-undo .
     1293     define output parameter p-loc-day          as integer   no-undo .
     1294     define output parameter p-loc-hour         as integer   no-undo .
     1295     define output parameter p-loc-minute       as integer   no-undo .
     1296     define output parameter p-loc-second       as integer   no-undo .
     1297     define output parameter p-loc-milliseconds as integer   no-undo .
     1298     define variable v-sys-year         as integer   no-undo .
     1299     define variable v-sys-month        as integer   no-undo .
     1300     define variable v-sys-day          as integer   no-undo .
     1301     define variable v-sys-hour         as integer   no-undo .
     1302     define variable v-sys-minute       as integer   no-undo .
     1303     define variable v-sys-second       as integer   no-undo .
     1304     define variable v-sys-milliseconds as integer   no-undo .
     1305     do
     1306     on error undo, return error return-value
     1307     :
     1308       run sys-time_mjd-to-sys
     1309         (input  p-mjd
     1310         ,output v-sys-year
     1311         ,output v-sys-month
     1312         ,output v-sys-day
     1313         ,output v-sys-hour
     1314         ,output v-sys-minute
     1315         ,output v-sys-second
     1316         ,output v-sys-milliseconds
     1317         ) .
     1318       run sys-time_sys-to-loc
     1319         (input  v-sys-year
     1320         ,input  v-sys-month
     1321         ,input  v-sys-day
     1322         ,input  v-sys-hour
     1323         ,input  v-sys-minute
     1324         ,input  v-sys-second
     1325         ,input  v-sys-milliseconds
     1326         ,output p-loc-year
     1327         ,output p-loc-month
     1328         ,output p-loc-day
     1329         ,output p-loc-hour
     1330         ,output p-loc-minute
     1331         ,output p-loc-second
     1332         ,output p-loc-milliseconds
     1333         ) .
     1334     end.
     1335   end procedure.
     1336   function sys-time_get-mjd-func returns decimal
     1337   :
     1338     define variable v-year         as integer   no-undo .
     1339     define variable v-month        as integer   no-undo .
     1340     define variable v-day          as integer   no-undo .
     1341     define variable v-hour         as integer   no-undo .
     1342     define variable v-minute       as integer   no-undo .
     1343     define variable v-second       as integer   no-undo .
     1344     define variable v-milliseconds as integer   no-undo .
     1345     define variable v-mjd          as decimal   no-undo .
     1346     run sys-time_get-sys in this-procedure
     1347       (output v-year
     1348       ,output v-month
     1349       ,output v-day
     1350       ,output v-hour
     1351       ,output v-minute
     1352       ,output v-second
     1353       ,output v-milliseconds
     1354       ) .
     1355     run sys-time_sys-to-mjd in this-procedure
     1356       (input  v-year
     1357       ,input  v-month
     1358       ,input  v-day
     1359       ,input  v-hour
     1360       ,input  v-minute
     1361       ,input  v-second
     1362       ,input  v-milliseconds
     1363       ,output v-mjd
     1364       ) .
     1365     return v-mjd .
     1366   end function .
     1367   function sys-time_get-sys-str-func returns character
     1368   :
     1369     define variable v-utc-time as character no-undo .
     1370     define variable v-year         as integer   no-undo .
     1371     define variable v-month        as integer   no-undo .
     1372     define variable v-day          as integer   no-undo .
     1373     define variable v-hour         as integer   no-undo .
     1374     define variable v-minute       as integer   no-undo .
     1375     define variable v-second       as integer   no-undo .
     1376     define variable v-milliseconds as integer   no-undo .
     1377     run sys-time_get-sys in this-procedure
     1378       (output v-year
     1379       ,output v-month
     1380       ,output v-day
     1381       ,output v-hour
     1382       ,output v-minute
     1383       ,output v-second
     1384       ,output v-milliseconds
     1385       ) .
     1386     assign
     1387       v-utc-time  = 'UTC ':u
     1388                   + string(v-year,         '9999':u)
     1389                   + '/':u
     1390                   + string(v-month,        '99':u)
     1391                   + '/':u
     1392                   + string(v-day,          '99':u)
     1393                   + ' ':u
     1394                   + string(v-hour,         '99':u)
     1395                   + ':':u
     1396                   + string(v-minute,       '99':u)
     1397                   + ':':u
     1398                   + string(v-second,       '99':u)
     1399                   + ' ':u
     1400                   + string(v-milliseconds, '999':u)
     1401     .
     1402     return v-utc-time.
     1403   end function .
     1404   function sys-time_mjd-to-loc-str-func returns character
     1405     (v-sys-mjd as decimal)
     1406   :
     1407     define variable v-loc-str          as character no-undo .
     1408     define variable v-loc-year         as integer   no-undo .
     1409     define variable v-loc-month        as integer   no-undo .
     1410     define variable v-loc-day          as integer   no-undo .
     1411     define variable v-loc-hour         as integer   no-undo .
     1412     define variable v-loc-minute       as integer   no-undo .
     1413     define variable v-loc-second       as integer   no-undo .
     1414     define variable v-loc-milliseconds as integer   no-undo .
     1415     run sys-time_mjd-to-loc in this-procedure
     1416       (input  v-sys-mjd
     1417       ,output v-loc-year
     1418       ,output v-loc-month
     1419       ,output v-loc-day
     1420       ,output v-loc-hour
     1421       ,output v-loc-minute
     1422       ,output v-loc-second
     1423       ,output v-loc-milliseconds
     1424       ) .
     1425     assign
     1426       v-loc-str = substitute('&1/&2/&3 &4:&5'
     1427                             ,string(v-loc-day,    '99':U)
     1428                             ,string(v-loc-month,  '99':U)
     1429                             ,string(v-loc-year,   '9999':U)
     1430                             ,string(v-loc-hour,   '99':U)
     1431                             ,string(v-loc-minute, '99':U)
     1432                             )
     1433     .
     1434     return v-loc-str .
     1435   end function .
