        1   DEFINE SHARED TEMP-TABLE tt-clients NO-UNDO LIKE ub.clients.
        2   DEFINE SHARED TEMP-TABLE tt-shop NO-UNDO LIKE ub.shop.
        3   define input  parameter parparentProc as widget-handle no-undo .
        4   define input  parameter p-mode as character no-undo .
        5   define input  parameter p-obj-code like ub.shop.obj-code no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Редактирование атрибутов магазина".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   DEFINE BUTTON B-exit AUTO-GO
      116        LABEL "&Ввод ":L
      117        SIZE 10 BY 1
      118        BGCOLOR 8 .
      119   DEFINE BUTTON b-help
      120        LABEL "&Помощь":L
      121        SIZE 10 BY 1
      122        BGCOLOR 8 .
      123   DEFINE BUTTON B-quit AUTO-END-KEY
      124        LABEL "&Отмена":L
      125        SIZE 10 BY 1
      126        BGCOLOR 8 .
      127   DEFINE VARIABLE EndTime AS DECIMAL FORMAT "99.99":U INITIAL 20
      128        LABEL "Окончание"
      129        VIEW-AS FILL-IN
      130        SIZE 6.13 BY .92
      131        BGCOLOR 15  NO-UNDO.
      132   DEFINE VARIABLE StartTime AS DECIMAL FORMAT "99.99":U INITIAL 8
      133        LABEL "Начало"
      134        VIEW-AS FILL-IN
      135        SIZE 6.38 BY .92
      136        BGCOLOR 15  NO-UNDO.
      137   DEFINE RECTANGLE RECT-1
      138        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      139        SIZE 71 BY 4.21.
      140   DEFINE QUERY Dialog-Frame FOR
      141         tt-shop,
      142         tt-clients SCROLLING.
      143   DEFINE FRAME Dialog-Frame
      144        B-exit AT ROW 1 COL 1
      145        B-quit AT ROW 1 COL 11
      146        b-help AT ROW 1 COL 61
      147        tt-shop.acct AT ROW 2.46 COL 11.13 COLON-ALIGNED
      148             LABEL "Бухгалтер"
      149             VIEW-AS FILL-IN
      150             SIZE 24.5 BY .92
      151             BGCOLOR 15
      152        tt-shop.store-boss AT ROW 2.46 COL 50.25 COLON-ALIGNED
      153             LABEL "Зав. складом"
      154             VIEW-AS FILL-IN
      155             SIZE 23 BY .92
      156             BGCOLOR 15
      157        tt-shop.goods-man AT ROW 3.46 COL 11.13 COLON-ALIGNED
      158             LABEL "Товаровед"
      159             VIEW-AS FILL-IN
      160             SIZE 24.5 BY .92
      161             BGCOLOR 15
      162        tt-shop.store-man AT ROW 3.46 COL 50.25 COLON-ALIGNED
      163             LABEL "Кладовщик"
      164             VIEW-AS FILL-IN
      165             SIZE 23 BY .92
      166             BGCOLOR 15
      167        StartTime AT ROW 6.92 COL 13.5
      168        EndTime AT ROW 6.92 COL 47.75 COLON-ALIGNED
      169        tt-clients.PS AT ROW 11 COL 2.88 NO-LABEL
      170             VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
      171             SIZE 71 BY 5.33
      172             BGCOLOR 15
      173        "Время работы ( при круглосуточной - указывайте : 00.00 и 00.00 ) :" VIEW-AS TEXT
      174             SIZE 63.75 BY 1 AT ROW 5.33 COL 6.63
      175             FGCOLOR 4
      176        "Примечание :" VIEW-AS TEXT
      177             SIZE 12.5 BY 1 AT ROW 9.63 COL 31.75
      178             FGCOLOR 4
      179        RECT-1 AT ROW 4.58 COL 2.88
      180        SPACE(4.10) SKIP(7.99)
      181       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      182            SIDE-LABELS THREE-D  SCROLLABLE
      183            BGCOLOR 8 FGCOLOR 0
      184            TITLE BGCOLOR 8 FGCOLOR 1 "Дополнительные сведения о магазине":L
      185            CANCEL-BUTTON B-quit.
      186   ASSIGN
      187          FRAME Dialog-Frame:SCROLLABLE       = FALSE.
      188   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      189   DO:
      190       assign
      191           tt-clients.PS StartTime EndTime
      192           tt-shop.acct tt-shop.goods-man tt-shop.store-boss tt-shop.store-man
      193           .
      194       assign
      195       tt-shop.Work-hours = string( StartTime, "99.99" ) + "," + string( EndTime, "99.99" ) .
      196   END.
      197   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      198   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      199   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      200   on help of frame Dialog-Frame
      201   do:
      202     run gbl/app_help.p
      203       (input this-procedure :file-name
      204       ,input ''
      205       ,input ?
      206       ) no-error.
      207     if error-status :error then do:
      208       message
      209         "Ошибка при вызове помощи"
      210         error-status :get-message(1)
      211         view-as alert-box .
      212     end.
      213   end.
      214   run minbtn-set in this-procedure .
      215   on choose of b-help in frame Dialog-Frame
      216   do:
      217     apply "help":u to frame Dialog-Frame .
      218   end.
      219   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      220   procedure minbtn-set :
      221       do
      222           on error undo, return error return-value
      223           :
      224           define variable ii              as integer       no-undo .
      225           define variable fh              as widget-handle no-undo .
      226           define variable hh              as widget-handle no-undo .
      227           define variable v-h             as handle        extent 4 no-undo .
      228           define variable v-name-button   as character     no-undo .
      229           define variable v-help-old-x    as decimal       no-undo .
      230           define variable v-help-old-y    as decimal       no-undo .
      231           define variable v-help-old-size as decimal       no-undo .
      232           define variable v-frame-width   as decimal       no-undo .
      233           define variable jj              as integer       no-undo .
      234           do
      235               on error undo, return error
      236               :
      237               assign
      238                   v-frame-width = frame Dialog-Frame:width - 0.3
      239                   fh            = frame Dialog-Frame:first-child
      240                   hh            = fh:first-child
      241                   ii            = 1
      242                   .
      243               do while valid-handle(hh):
      244                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      245                   do:
      246                       case lc(hh:name) :
      247                           when "b-help" then
      248                               do:
      249                                   hh:load-image-up("cmp/b-help.bmp":u) .
      250                                   hh:load-image-down("cmp/b-help.bmp":u) .
      251                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      252                                   hh:TOOLTIP = "Помощь" .
      253                                   v-help-old-x = hh:column .
      254                                   v-help-old-y = hh:row    .
      255                                   v-help-old-size = hh:width .
      256                                   hh:width-chars = 2.5 .
      257                               end.
      258                           when "b-print" then
      259                               do:
      260                                   hh:load-image("cmp/b-print.bmp":u) .
      261                                   hh:TOOLTIP = "Печать" .
      262                                   v-h[ii] = hh:handle .
      263                                   ii = ii + 1 .
      264                                   hh:width-chars = 3 .
      265                               end.
      266                           when "b-history" or
      267                           when "b-hist" then
      268                               do:
      269                                   hh:load-image("cmp/b-hist.bmp":u) .
      270                                   hh:TOOLTIP = "История" .
      271                                   v-h[ii] = hh:handle .
      272                                   ii = ii + 1 .
      273                                   hh:width-chars = 3 .
      274                               end.
      275                           when "b-sch" then
      276                               do:
      277                                   hh:load-image("cmp/b-sch.bmp":u) .
      278                                   hh:TOOLTIP = "Установка Фильтра" .
      279                                   v-h[ii] = hh:handle .
      280                                   ii = ii + 1 .
      281                                   hh:width-chars = 3 .
      282                               end.
      283                           when "b-hist-user" then
      284                               do:
      285                                   hh:load-image("cmp/b-hist.bmp":u) .
      286                                   hh:TOOLTIP = "История пользователя" .
      287                                   ii = ii + 1 .
      288                               end.
      289                       end case.
      290                   end.
      291                   hh = hh:next-sibling.
      292               end.
      293               b-help:column = v-frame-width - b-help:width-chars.
      294               jj = 0.
      295               repeat ii = 4 to 1 by -1 :
      296                   if valid-handle (v-h[ii] ) then
      297                   do:
      298                       jj  = jj + 1 .
      299                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      300                       v-h[ii]:row    = v-help-old-y .
      301                   end.
      302               end.
      303           end.
      304       end.
      305   end procedure.
      306   ON WINDOW-CLOSE OF FRAME Dialog-Frame APPLY "END-ERROR":U TO SELF.
      307   MAIN-BLOCK:
      308   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      309      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      310     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      311       find first tt-shop .
      312       find first tt-clients .
      313     end.
      314     else do:
      315       find first tt-shop no-lock where
      316                       tt-shop.obj-code = p-obj-code .
      317       find first tt-clients no-lock where
      318                       tt-clients.obj-code = p-obj-code
      319                   ANd tt-clients.obj-type = 'маг':U.
      320     end.
      321       run Myenable in this-procedure.
      322       WAIT-FOR GO OF FRAME Dialog-Frame.
      323   END.
      324   RUN disable_UI.
      325   PROCEDURE disable_UI :
      326     HIDE FRAME Dialog-Frame.
      327   END PROCEDURE.
      328   PROCEDURE enable_UI :
      329     DISPLAY StartTime EndTime
      330         WITH FRAME Dialog-Frame.
      331     IF AVAILABLE tt-clients THEN
      332       DISPLAY tt-clients.PS
      333         WITH FRAME Dialog-Frame.
      334     IF AVAILABLE tt-shop THEN
      335       DISPLAY tt-shop.acct tt-shop.store-boss tt-shop.goods-man tt-shop.store-man
      336         WITH FRAME Dialog-Frame.
      337     ENABLE B-exit B-quit b-help RECT-1 tt-shop.acct tt-shop.store-boss
      338            tt-shop.goods-man tt-shop.store-man StartTime EndTime tt-clients.PS
      339         WITH FRAME Dialog-Frame.
      340   END PROCEDURE.
      341   PROCEDURE MyEnable :
      342       assign
      343           StartTime = decimal( entry( 1, tt-shop.work-hours ) )
      344           EndTime = decimal( entry( 2, tt-shop.work-hours ) ) .
      345   DISPLAY EndTime StartTime
      346         WITH FRAME Dialog-Frame.
      347     IF AVAILABLE tt-clients THEN
      348       DISPLAY tt-clients.PS
      349         WITH FRAME Dialog-Frame.
      350     IF AVAILABLE tt-shop THEN
      351       DISPLAY tt-shop.store-man tt-shop.acct tt-shop.store-boss tt-shop.goods-man
      352         WITH FRAME Dialog-Frame.
      353     ENABLE RECT-1 tt-clients.PS B-quit EndTime tt-shop.store-man B-exit
      354            tt-shop.acct tt-shop.store-boss b-help tt-shop.goods-man StartTime
      355         WITH FRAME Dialog-Frame.
      356    if p-mode = 'ПРОСМОТР':U then do:
      357       assign
      358       tt-clients.PS:read-only = yes
      359       b-quit:label = "&Выход".
      360       DISABLE
      361       B-exit
      362       StartTime
      363       EndTime
      364       tt-shop.acct
      365       tt-shop.goods-man
      366       tt-shop.store-boss
      367       tt-shop.store-man
      368       WITH FRAME Dialog-Frame.
      369       hide
      370       b-exit in frame Dialog-Frame.
      371     end.
      372   END PROCEDURE.
