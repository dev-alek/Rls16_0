      695   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      696   procedure proc-b-attr :
      697   define input parameter p-mode as character no-undo .
      698   define input parameter p-obj-type like ub.clients.obj-type no-undo .
      699   define input parameter p-obj-code like ub.clients.obj-code no-undo .
      700   define variable v-sts as integer no-undo .
      701   define variable vattr-codes as character no-undo .
      702   define variable vattr-labels as character no-undo .
      703   define variable ii as integer no-undo .
      704   define variable v-attr-code like ub.clients-attr.attr-code no-undo .
      705   define variable attr-label as character no-undo .
      706   define variable attr-user-can-edit as logical no-undo .
      707   define variable attr-output-display as logical no-undo .
      708   define variable attr-other as char no-undo .
      709   define variable v-prop-list as character no-undo .
      710   define variable v-prop-type-list as character no-undo .
      711   define variable v-prop-label-list as character no-undo .
      712   define variable v-global as logical no-undo .
      713   define variable v-host as logical no-undo .
      714   define variable v-shop as logical no-undo .
      715   define variable v-store as logical no-undo .
      716   define variable v-db as logical   no-undo .
      717   define variable attr-value as char no-undo .
      718   define variable v-spr as character no-undo .
      719   define variable v-title as character no-undo .
      720   define variable v-ii as integer no-undo .
      721   define variable v-ok as integer no-undo .
      722   define variable v-rid-list as character no-undo .
      723   define variable v-rec as recid no-undo .
      724   define variable conf-par as character no-undo .
      725   define variable par-type as character no-undo .
      726   define variable v-firm-code as integer   no-undo .
      727   define variable v-from-obj-code  as integer no-undo .
      728   define variable v-found as decimal no-undo .
      729   define buffer buf_clients for ub.clients.
      730   define buffer buf_sysconf for ub.sysconf.
      731   define buffer buf_shop for ub.shop.
      732   define buffer buf_store for ub.store.
      733   define buffer buf_db for ub.db.
      734   do
      735   on error undo, return error
      736   :
      737   assign
      738   vattr-codes = "":U
      739   vattr-labels = "":U
      740   .
      741   _II:
      742   DO ii = 1 to num-entries('autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U):
      743     run thbjattr_code (
      744                          input entry(ii, 'autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U)
      745                         ,input   '':U
      746                         ,output  attr-label
      747                         ,output  attr-user-can-edit
      748                         ,output  attr-output-display
      749                         ,output  attr-other
      750                         ,output v-prop-list
      751                         ,output v-prop-type-list
      752                         ,output v-prop-label-list
      753                         ,output v-global
      754                         ,output v-host
      755                         ,output v-shop
      756                         ,output v-store
      757                         ,output v-db
      758                       ) no-error.
      759       .
      760       if NOT error-status:error
      761       and attr-user-can-edit
      762       and index(attr-other, "spr-ext=") > 0
      763       anD (if p-obj-type = 'маг':U
      764            then v-shop
      765            else (if p-obj-type = 'скл':U
      766                  then v-store
      767                  else (if p-obj-type = 'орг':U
      768                        then v-host
      769                        else (if p-obj-type = 'БД':U
      770                             then v-db
      771                             else v-global)
      772                       )
      773                  )
      774            ) then do:
      775         if entry(ii, 'autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U) = 'alias-tpsi':U then do:
      776   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      777     (input  'tpsi'
      778     ,input  0
      779     ,input  ''
      780     ,input  0
      781     ,input  ''
      782     ,input  ''
      783     ,input  ''
      784     ,input  no
      785     ,output conf-par
      786     ,output par-type
      787     ) no-error .
      788           if error-status:error
      789           or (conf-par <> "yes") then next _ii.
      790         end.
      791         assign
      792         vattr-codes = vattr-codes + chr(44) + entry(ii, 'autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U)
      793         vattr-labels = vattr-labels + chr(44) + attr-label
      794         .
      795       end.
      796   end.
      797   CASE p-mode:
      798     when 'ПРОСМОТР':U then do:
      799       assign
      800       v-title = "Выберите типы параметров для просмотра".
      801     end.
      802     when 'ИЗМЕНЕНИЕ':U then do:
      803       assign
      804       v-title = "Выберите типы параметров для редактирования".
      805     end.
      806     when  'КОПИРОВАНИЕ':U then do:
      807       assign
      808       v-title = "Выберите типы параметров для копирования".
      809     end.
      810   END CASE.
      811   run gbl/d-list.w (
      812                  INPUT (if p-mode = 'КОПИРОВАНИЕ':U then "b-sel,b-mark":U else "b-sel":U)
      813                 ,INPUT v-title
      814                 ,INPUT vattr-codes
      815                 ,INPUT vattr-labels
      816                 ,INPUT chr(44)
      817                 ,INPUT "":U
      818                 ,output v-attr-code).
      819   IF v-attr-code = "":u THEN do:
      820     RETURN ''.
      821   end.
      822   if p-mode = 'ПРОСМОТР':U
      823   or p-mode = 'ИЗМЕНЕНИЕ':U then do:
      824     run thbjattr_code  in this-procedure (
      825          input   v-attr-code
      826         ,input   '':U
      827         ,output  attr-label
      828         ,output  attr-user-can-edit
      829         ,output  attr-output-display
      830         ,output  attr-other
      831         ,output v-prop-list
      832         ,output v-prop-type-list
      833         ,output v-prop-label-list
      834         ,output v-global
      835         ,output v-host
      836         ,output v-shop
      837         ,output v-store
      838         ,output v-db
      839     ).
      840     do ii = 1 to num-entries(attr-other, chr(47)):
      841       if entry(ii, attr-other, chr(47)) begins "spr-ext=":U then do:
      842         assign
      843         v-spr = entry(2, entry(ii, attr-other, chr(47)), "=").
      844       end.
      845     end.
      846     run value(v-spr) (
      847                      input parparentproc
      848                     ,input p-mode
      849                     ,input p-obj-type
      850                     ,input p-obj-code
      851                     ).
      852   end.
      853   else do:
      854      if p-obj-type = 'маг':U then do:
      855       message
      856       "Выберите магазин для копирования ПАРАМЕТРОВ"
      857       view-as alert-box WARNING.
      858         run adm/shops.w ( input parparentproc
      859                          ,input "b-sel"
      860                          ,input-output v-rid-list
      861                          ,no ).
      862        if v-rid-list = "":U then return.
      863        find first buf_shop no-lock where
      864                 recid(buf_shop) = integer(v-rid-list) .
      865        v-from-obj-code = buf_shop.obj-code.
      866      end.
      867      if p-obj-type = 'орг':U then do:
      868         message
      869         "Выберите ФИРМУ для копирования ПАРАМЕТРОВ"
      870         view-as alert-box WARNING.
      871         run adm/sconfs.w (
      872               input parParentProc
      873             , input "b-sel":U
      874             , input no
      875             , input 0
      876             , output v-firm-code
      877             , input-output v-rid-list
      878         ) no-error.
      879         if v-rid-list = "":U then return.
      880       find first buf_sysconf no-lock
      881                         where recid(buf_sysconf) = integer(entry(1, v-rid-list)).
      882       v-from-obj-code = buf_sysconf.host-code.
      883      end.
      884      if p-obj-type = 'скл':U then do:
      885       message
      886       "Выберите склад для копирования ПАРАМЕТРОВ"
      887       view-as alert-box WARNING.
      888         run adm/stores.w ( input parparentproc
      889                           ,input "b-sel"
      890                           ,input-output v-rid-list
      891                           ,input no ).
      892        if v-rid-list = "":U then return.
      893        find first buf_store no-lock where
      894                 recid(buf_store) = integer(v-rid-list) .
      895        v-from-obj-code = buf_store.obj-code.
      896      end.
      897      if p-obj-type = 'БД':U then do:
      898         message
      899         "Выберите БД для копирования ПАРАМЕТРОВ"
      900         view-as alert-box WARNING.
      901         run adm/dbs.w (
      902               input parParentProc
      903             , input 'ПРОСМОТР':U
      904             , output v-rec
      905         ) no-error.
      906         if v-rec = ? then return.
      907       find first buf_db no-lock
      908                         where recid(buf_db) = v-rec.
      909       v-from-obj-code = buf_db.db-num.
      910      end.
      911      if (p-obj-type = 'маг':U
      912      AND p-obj-code = buf_shop.obj-code )
      913      or (p-obj-type = 'скл':U
      914      AND p-obj-code = buf_store.obj-code )
      915      or (p-obj-type = 'орг':U
      916      AND p-obj-code = buf_sysconf.host-code )
      917      or (p-obj-type = 'БД':U
      918      AND p-obj-code = buf_db.db-num )
      919      or (p-obj-type = '':U
      920      AND p-obj-code = 0 )
      921      then do:
      922        message "Нельзя копировать ПАРАМЕТРЫ самих в себя"
      923        view-as alert-box error .
      924        return error .
      925      end.
      926      run waitfram-show in this-procedure ( input "Ждите..." ).
      927      DO ii = 1 to num-entries(v-attr-code):
      928         for each thbjattr_thbj-attr:
      929           delete thbjattr_thbj-attr.
      930         end.
      931         assign
      932         v-ii = v-ii + 1.
      933         run thbjattr_get-section  in this-procedure (
      934              input  p-obj-type
      935             ,input  v-from-obj-code
      936             ,input  entry(ii, v-attr-code)
      937             ,input '':U
      938             ,input-output table thbjattr_thbj-attr
      939             ,output v-found
      940                                                 ) no-error .
      941         if not error-status:error then do:
      942           run thbjattr_set-section in this-procedure (
      943                                                  input p-obj-type
      944                                                 ,input p-obj-code
      945                                                 ,input entry(ii, v-attr-code)
      946                                                 ,input table thbjattr_thbj-attr ) no-error .
      947           if not error-status:error then
      948           assign
      949           v-ok = v-ok + 1
      950           .
      951         end.
      952      end.
      953      run waitfram-hide in this-procedure .
      954      if v-ii = v-ok then do:
      955         message
      956         substitute("Скопировано &1 параметров с &4&5 на &2&3"
      957                    , v-ok
      958                    , p-obj-type
      959                    , p-obj-code
      960                    , p-obj-type
      961                    , v-from-obj-code
      962                    )
      963         view-as alert-box .
      964      end.
      965      else do:
      966         message
      967         substitute("Из &1 параметров удалось скопировать &2 параметров с &3&4 на &5&6"
      968                    , v-ii
      969                    , v-ok
      970                    , p-obj-type
      971                    , p-obj-code
      972                    , p-obj-type
      973                    , v-from-obj-code
      974                    )
      975         view-as alert-box WARNING.
      976      end.
      977   end.
      978   end.
      979   end procedure.
      980   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      981     define variable v-cntxt-db-num        as integer   no-undo .
      982     define variable v-cntxt-userid        as character no-undo .
      983     define variable v-cntxt-level         as character no-undo .
      984     define variable v-cntxt-host-code-obj as integer   no-undo .
      985     define variable v-cntxt-obj-type      as character no-undo .
      986     define variable v-cntxt-obj-code      as integer   no-undo .
      987     define variable v-cntxt-db-num-obj    as integer   no-undo .
      988     define variable v-cntxt-is-admin      as logical   no-undo .
      989   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      990   define temp-table userobjs_temp-user-obj no-undo
      991     field obj-type as character
      992     field obj-code as integer
      993     index xpk is primary unique obj-type obj-code
      994     .
      995   procedure userobjs_clear :
      996     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      997     do
      998     on error undo, return error return-value
      999     :
     1000       for each buf_userobjs_temp-user-obj
     1001       on error undo, return error return-value
     1002       :
     1003         delete buf_userobjs_temp-user-obj .
     1004       end.
     1005     end.
     1006   end .
     1007   procedure userobjs_object-count :
     1008     define output parameter p-total-count as integer   no-undo .
     1009     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1010     do
     1011     on error undo, return error return-value
     1012     :
     1013       assign
     1014         p-total-count = 0
     1015       .
     1016       for each buf_userobjs_temp-user-obj
     1017       on error undo, return error return-value
     1018       :
     1019         assign
     1020           p-total-count = p-total-count + 1
     1021         .
     1022       end.
     1023     end.
     1024   end.
     1025   procedure userobjs_append :
     1026      define input  parameter p-obj-type as character no-undo .
     1027      define input  parameter p-obj-code as integer   no-undo .
     1028     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1029     do
     1030     on error undo, return error return-value
     1031     :
     1032       find first buf_userobjs_temp-user-obj
     1033         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1034           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1035         no-error .
     1036       if not available buf_userobjs_temp-user-obj
     1037       then do:
     1038         create buf_userobjs_temp-user-obj .
     1039         assign
     1040           buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1041           buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1042         .
     1043       end.
     1044     end.
     1045   end.
     1046   procedure userobjs_object-exist :
     1047     define output parameter p-object-exist as logical   no-undo .
     1048     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1049     do
     1050     on error undo, return error return-value
     1051     :
     1052       find first buf_userobjs_temp-user-obj
     1053         no-error .
     1054       if not available buf_userobjs_temp-user-obj
     1055       then do:
     1056         assign
     1057           p-object-exist = false
     1058         .
     1059       end.
     1060       else do:
     1061         assign
     1062           p-object-exist = true
     1063         .
     1064       end.
     1065     end.
     1066   end.
     1067   procedure userobjs_transfer :
     1068     define input  parameter p-callback-handle as handle no-undo .
     1069     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
     1070     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1071     do
     1072     on error undo, return error return-value
     1073     :
     1074       if valid-handle(p-callback-handle) <> true
     1075       then do:
     1076         message
     1077           vss-workfile vss-revision vss-description skip
     1078           "Ошибка задания входных параметров" skip
     1079           "Неизвестный указатель на процедуру" skip
     1080           view-as alert-box error .
     1081         undo, return error return-value .
     1082       end.
     1083       if p-callback-handle :get-signature("userobjs_append") = ""
     1084       then do:
     1085         message
     1086           vss-workfile vss-revision vss-description skip
     1087           "Ошибка задания входных параметров" skip
     1088           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
     1089                     ,p-callback-handle :file-name
     1090                     ) skip
     1091           view-as alert-box error .
     1092         undo, return error return-value .
     1093       end.
     1094       for each buf_userobjs_temp-user-obj
     1095       on error undo, return error return-value
     1096       :
     1097         run userobjs_append in p-callback-handle
     1098           (input  buf_userobjs_temp-user-obj.obj-type
     1099           ,input  buf_userobjs_temp-user-obj.obj-code
     1100           ) .
     1101       end.
     1102     end.
     1103   end procedure.
     1104   procedure userobjs_select-one :
     1105      define input  parameter parparentproc     as widget-handle no-undo .
     1106      define input  parameter p-db-num          as integer   no-undo .
     1107      define input  parameter p-user-id         as character no-undo .
     1108      define input  parameter p-host-code-obj   as integer   no-undo .
     1109      define input  parameter p-obj-type        as character no-undo .
     1110      define input  parameter p-obj-code        as integer   no-undo .
     1111      define output parameter p-user-select     as logical   no-undo .
     1112      define output parameter p-select-obj-type as character no-undo .
     1113      define output parameter p-select-obj-code as character no-undo .
     1114     do
     1115     on error undo, return error return-value
     1116     :
     1117       run gbl/userobjs.w
     1118         (input  parparentproc
     1119         ,input  this-procedure :handle
     1120         ,input  p-db-num
     1121         ,input  p-user-id
     1122         ,input  p-host-code-obj
     1123         ,input  p-obj-type
     1124         ,input  p-obj-code
     1125         ,INPUT  "b-sel"
     1126         ,output p-user-select
     1127         ,output p-select-obj-type
