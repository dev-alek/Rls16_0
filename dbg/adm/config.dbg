     1752   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
     1753   DO:
     1754     define variable v-rid-list as character no-undo .
     1755     run ref/cclihist.w
     1756       (input parparentproc
     1757       ,input 0
     1758       ,input '':U
     1759       ,input 0
     1760       ,input '':U
     1761       ,input 'one':U
     1762       ,input 'орг':U
     1763       ,input tt-firm.firm-code
     1764       ,input ?
     1765       ,input ?
     1766       ,input '':U
     1767       ,input '':U
     1768       ,input v-cntxt-db-num
     1769       ,input-output v-rid-list
     1770       ) no-error .
     1771   END.
     1772   ON CHOOSE OF B-hold-obj IN FRAME Dialog-Frame
     1773   DO:
     1774     define variable v-user-select as logical   no-undo .
     1775     define variable v-obj-type    as character no-undo .
     1776     define variable v-obj-code    as integer   no-undo .
     1777     define buffer   buf_clients for ub.clients.
     1778   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1779   run userobjs_select-one in this-procedure
     1780     (input  parparentproc
     1781     ,input  v-cntxt-db-num
     1782     ,input  v-cntxt-userid
     1783     ,input  p-host-code
     1784     ,input  ''
     1785     ,input  0
     1786     ,output v-user-select
     1787     ,output v-obj-type
     1788     ,output v-obj-code
     1789     )  .
     1790     if v-user-select <> true
     1791     then do:
     1792       message
     1793         "Объект не выбран"
     1794         view-as alert-box information .
     1795     end.
     1796     else do:
     1797       find first buf_clients no-lock
     1798         where buf_clients.obj-type = v-obj-type
     1799           and buf_clients.obj-code = v-obj-code
     1800         .
     1801       assign
     1802         tt-firm.main-obj-code:screen-value = string(buf_clients.obj-code)
     1803         tt-firm.main-obj-code
     1804         main-obj-name:screen-value = buf_clients.obj-name
     1805         main-obj-name
     1806         tt-firm.main-obj-type:screen-value = buf_clients.obj-type
     1807         tt-firm.main-obj-type
     1808       .
     1809     end.
     1810   END.
     1811   ON CHOOSE OF B-ret-credit-pay IN FRAME Dialog-Frame
     1812   DO:
     1813     RUN local-payt-chk in this-procedure ("ret-credit-pay", "button").
     1814     apply "entry" to tt-sysconf.ret-credit-pay in FRAME Dialog-Frame.
     1815     return no-apply.
     1816   END.
     1817   ON CHOOSE OF B-sale-type-code IN FRAME Dialog-Frame
