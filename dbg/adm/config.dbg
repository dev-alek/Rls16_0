     3233         tt-firm.main-obj-code
     3234         main-obj-name:screen-value = buf_clients.obj-name
     3235         main-obj-name
     3236         tt-firm.main-obj-type:screen-value = buf_clients.obj-type
     3237         tt-firm.main-obj-type
     3238       .
     3239     end.
     3240   end.
     3241   DISPLAY
     3242   tt-clients.obj-name
     3243   (if p-mode = 'ДОБАВЛЕНИЕ':U and not (p-is-deploy and parparentproc:get-signature("mainmenu_getcntxt") = "")
     3244   then v-next-firm-code
     3245   else tt-sysconf.host-code) @
