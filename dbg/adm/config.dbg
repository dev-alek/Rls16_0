     1160   procedure thobjs :
     1161      define input        parameter parparentproc     as widget-handle no-undo .
     1162      define input        parameter i-bttns           as character     no-undo .
     1163      define input        parameter i-list-mode       as character     no-undo.
     1164      define input        parameter i-obj-type        as character     no-undo.
     1165      define input        parameter i-db-num          as integer       no-undo.
     1166      define input        parameter i-host-code       as integer       no-undo.
     1167      define input-output parameter p-rid-list        as character     no-undo .
     1168   run ref/thobjs.p
     1169           ( input parparentproc
     1170            ,input  this-procedure :handle
     1171           , input i-bttns
     1172           , input i-list-mode
     1173           , input i-obj-type
     1174           , input i-db-num
     1175           , input i-host-code
     1176           , input-output p-rid-list ) no-error .
     1177   end.
     1178   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1179   define variable v-waitfram-action01         as character   no-undo .
     1180   define variable v-waitfram-action02         as character   no-undo .
     1181   define variable v-waitfram-action03         as character   no-undo .
     1182   define variable mWaitFramTextBeg            as character   no-undo.
     1183   define variable mWaitFramTextEnd            as character   no-undo.
     1184   define variable mWaitFramView               as logical     no-undo.
     1185   define variable mWaitProcEvent              as logical     no-undo init yes.
     1186   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1187   define variable mWaitFramStop               as logical     no-undo.
     1188   define variable mWaitFramStopUser           as logical     no-undo.
     1189   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1190   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1191   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1192   define button B-WaitFramStop auto-end-key
     1193        label "Стоп"
     1194        size 10 by 1 tooltip "Остоновить процесс".
     1195   define button B-viewProcInfo
     1196        label "Информация"
     1197        size 15 by 1 tooltip "Информация о процесс".
     1198   define frame waitfram
     1199     v-waitfram-action01 format "x(72)" no-label skip
     1200     v-waitfram-action02 format "x(72)" no-label skip
     1201     v-waitfram-action03 format "x(72)" no-label skip
     1202     B-viewProcInfo
     1203     B-WaitFramStop at row 4 col 30
     1204     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1205     .
     1206   define new global shared variable mBatchMode as logical no-undo init ?.
     1207   define variable mFramBachModHandle as handle no-undo.
     1208   mFramBachModHandle = frame waitfram:handle.
     1209   define variable mFameOldVis as logical no-undo.
     1210   define variable mVisCUrentVin as logical no-undo.
     1211   if session:batch-mode
     1212   then
     1213      mBatchMode = yes.
     1214   if mBatchMode = ? then do:
     1215     mVisCUrentVin = current-window:visible.
     1216     mFameOldVis = mFramBachModHandle:visible.
     1217     mFramBachModHandle:visible  = yes.
     1218     mBatchMode = mFramBachModHandle:visible ne yes.
     1219     mFramBachModHandle:visible = mFameOldVis.
     1220     current-window:visible = mVisCUrentVin.
     1221   end.
     1222    if  log-manager:logfile-name ne ?
     1223     then DO:
     1224         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1225         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1226         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1227     end.
     1228   on choose of B-WaitFramStop in frame waitfram
     1229   do:
     1230     mWaitFramStop = yes.
     1231     mWaitFramStopUser = yes.
     1232   end.
     1233   function waitfram-check-timeout returns logical():
     1234      define variable vtime as int64 no-undo.
     1235      if mWaitFramStopTimeOut
     1236      then
     1237         return yes.
     1238      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1239      if     mWaitFramTimeOut ne ?
     1240         and mWaitFramTimeOut ne 0
     1241         and mWaitFramTimeOut lt vtime
     1242      then do:
     1243         mWaitFramStopTimeOut = yes.
     1244      end.
     1245      return mWaitFramStopTimeOut.
     1246   end.
     1247   procedure waitfram-hide :
     1248     if not session:batch-mode
     1249     then do
     1250     on error undo, return error return-value
     1251     :
     1252       pause 0 before-hide .
     1253       if not mBatchMode then
     1254         hide frame waitfram .
     1255     if     not mWaitFramView
     1256        and mWaitProcEvent
     1257     then
     1258       process events .
     1259     end.
     1260   end procedure.
     1261   procedure waitfram-show :
     1262     define input  parameter p-message as character no-undo .
     1263     define variable v-left-margin as integer   no-undo .
     1264     if not session:batch-mode
     1265     then do
     1266     on error undo, return error return-value
     1267     :
     1268       if length(p-message) <= 70 then do:
     1269         assign
     1270           v-left-margin = integer((70 - length(p-message)) / 2)
     1271         .
     1272         assign
     1273           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1274         .
     1275         assign
     1276           v-waitfram-action01 = " "
     1277           v-waitfram-action02 = " "
     1278                                    + fill(" ", v-left-margin)
     1279                                    + p-message
     1280           v-waitfram-action03 = " "
     1281         .
     1282       end.
     1283       else do:
     1284         define variable vRindex1 as integer no-undo.
     1285         define variable vRindex2 as integer no-undo.
     1286         vRindex1 = r-index(p-message," ",70).
     1287         if vRindex1 = 0
     1288         then
     1289            vRindex1 = 70.
     1290         if length(p-message)  <= vRindex1 + 70 then do:
     1291           assign
     1292             v-waitfram-action01 = " "
     1293             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1294             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1295           .
     1296         end.
     1297         else do:
     1298           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1299           if vRindex2 <= vRindex1
     1300           then
     1301              vRindex2 = vRindex1 + 70.
     1302           assign
     1303             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1304             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1305             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1306           .
     1307         end.
     1308       end.
     1309       B-viewProcInfo:visible   in frame waitfram = no.
     1310       B-viewProcInfo:sensitive in frame waitfram = no.
     1311       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1312       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1313       if  (   mWaitFramView
     1314          or  mWaitProcEvent)
     1315          and not mBatchMode
     1316       then
     1317          display
     1318             v-waitfram-action01 skip
     1319             v-waitfram-action02 skip
     1320             v-waitfram-action03 skip
     1321          with frame waitfram .
     1322       if     mWaitFramView
     1323          then do:
     1324             if     mWaitFramInterval ne ?
     1325                and not mBatchMode
     1326             then
     1327                wait-for go of frame waitfram pause mWaitFramInterval.
     1328          end.
     1329          else
     1330             if     mWaitProcEvent
     1331                and not mBatchMode
     1332             then
     1333                process events .
     1334     end.
     1335   end procedure.
     1336      procedure waitfram-show-this:
     1337         define input  parameter iInterval as int64 no-undo.
     1338         define variable vtime as int64 no-undo.
     1339         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1340         mWaitFramInterval = iInterval.
     1341         run waitfram-show (substitute("&1&2 &3&4" ,
     1342                                       mWaitFramTextBeg ,
     1343                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1344                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1345                                       mWaitFramTextEnd
     1346                                      )
     1347                           ).
     1348      end.
     1349      procedure WaitFramRunPause:
     1350         define input  parameter iInterval as dec no-undo.
     1351         define variable vStart  as datetime-tz no-undo.
     1352         define variable vend    as datetime-tz no-undo.
     1353         define variable vint as int64 no-undo.
     1354         define variable vOk as logical no-undo.
     1355         vStart = now.
     1356         vend   = vStart.
     1357         publish "WaitFramPause" (iInterval,output vOk).
     1358         vend   =  now.
     1359         vint = vend - vStart.
     1360         vint = iInterval - vint / 1000.
     1361         if     not mWaitFramStop
     1362            and (   vint > 0
     1363                 or (    not vOk
     1364                     and iInterval eq ?
     1365                     )
     1366                 )
     1367         then
     1368            run waitfram-show-this (iInterval).
     1369         vend   =  now.
     1370         vint = vend - vStart.
     1371         vint = iInterval - vint / 1000.
     1372         if     not mWaitFramStop
     1373            and vint > 0
     1374         then do:
     1375            run gbl/pause.p (vint * 1000).
     1376         end.
     1377         if iInterval ne ?
     1378         then
     1379            publish "WaitFramStop".
     1380         waitfram-check-timeout().
     1381      end.
     1382      procedure WaitFramWaitFor:
     1383         define input  parameter iInterval as dec no-undo.
     1384         assign
     1385            mWaitFramStartProc   = now
     1386            mWaitFramStopUser    = no
     1387            mWaitFramStopTimeOut = no
     1388         .
     1389         block-wait:
     1390         do while not mWaitFramStop:
     1391            run WaitFramRunPause (iInterval).
     1392            if  waitfram-check-timeout()
     1393            then do:
     1394               leave block-wait.
     1395            end.
     1396         end.
     1397         run waitfram-hide.
     1398      end.
     1399   procedure waitfram-join :
     1400     define input  parameter p-line-1  as character no-undo .
     1401     define input  parameter p-line-2  as character no-undo .
     1402     define input  parameter p-line-3  as character no-undo .
     1403     define output parameter p-message as character no-undo .
     1404     do
     1405     on error undo, return error return-value
     1406     :
     1407       assign
     1408         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1409                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1410                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1411       .
     1412     end.
     1413   end procedure.
     1414   function waitfram-join-function returns character
     1415     (input p-line-1 as character
     1416     ,input p-line-2 as character
     1417     ,input p-line-3 as character
     1418     ).
     1419     define variable v-message as character no-undo .
     1420     run waitfram-join in this-procedure
     1421       (input  p-line-1
     1422       ,input  p-line-2
     1423       ,input  p-line-3
     1424       ,output v-message
     1425       ) .
     1426     return v-message .
     1427   end function .
     1428   define variable conf-par as   character    no-undo .
     1429   define variable par-type as   character    no-undo .
     1430   define variable v-db-num like ub.db.db-num no-undo .
     1431   define variable hold     as   character    no-undo .
