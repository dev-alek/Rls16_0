     3262   tt-sysconf.KOPF
     3263   tt-sysconf.SOEI
     3264   tt-sysconf.cons-vat-pc
     3265   with frame Dialog-Frame.
     3266   if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
     3267   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3268     define variable v-ref-rec44   as recid no-undo .
     3269     find buf_curr-chk where buf_curr-chk.curr-code = input frame Dialog-Frame tt-sysconf.base-code
     3270                    no-lock no-error.
