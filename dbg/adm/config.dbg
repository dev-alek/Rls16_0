     1129         ) .
     1130     end.
     1131   end.
     1132   procedure userobjs_select-many :
     1133     define input  parameter parparentproc   as widget-handle no-undo .
     1134     define input  parameter p-db-num        as integer   no-undo .
     1135     define input  parameter p-user-id       as character no-undo .
     1136     define input  parameter p-host-code-obj as integer   no-undo .
     1137     define input  parameter p-obj-type      as character no-undo .
     1138     define input  parameter p-obj-code      as integer   no-undo .
     1139     define output parameter p-user-select   as logical   no-undo .
     1140     define variable v-select-obj-type as character no-undo .
     1141     define variable v-select-obj-code as integer   no-undo .
     1142     do
     1143     on error undo, return error return-value
     1144     :
     1145       run gbl/userobjs.w
     1146         (input  parparentproc
     1147         ,input  this-procedure :handle
     1148         ,input  p-db-num
     1149         ,input  p-user-id
     1150         ,input  p-host-code-obj
