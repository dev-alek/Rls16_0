     3406   PROCEDURE proc-save :
     3407   define variable v-rid as recid no-undo .
     3408   do
     3409   with frame Dialog-Frame
     3410   :
     3411       assign
     3412           fi-egrip-date
     3413           fi-egrip-num
     3414       .
     3415   end.
     3416   assign
     3417     v-rid = (if p-mode = 'ДОБАВЛЕНИЕ':U
     3418             then ?
     3419             else recid(locked_sysconf)
     3420             )
     3421     varpurch-name
     3422     tt-clients.obj-name
     3423     tt-sysconf.host-code      frame Dialog-Frame
     3424     tt-sysconf.artic-disable
     3425     tt-sysconf.avrg-price
     3426     tt-sysconf.gen-s-f-office
     3427     tt-sysconf.base-code
     3428     tt-sysconf.branch
     3429     tt-sysconf.cash-pay
     3430     tt-sysconf.cashier
     3431     tt-sysconf.cons-vat-pc
     3432     tt-sysconf.credit-pay
     3433     tt-sysconf.head-position
     3434     tt-sysconf.KOPF
     3435     tt-sysconf.negative-rest
     3436     tt-sysconf.osn-base
     3437     tt-sysconf.property
     3438     tt-sysconf.purch-code = integer (lookup (varpurch-name, 'выкуп,консигнация,ответственное хранение':U))
     3439     tt-sysconf.ret-credit-pay
     3440     tt-sysconf.sale-type
     3441     tt-sysconf.sale-code
     3442     tt-sysconf.snr-accnt
     3443     tt-sysconf.SOEI
     3444     tt-firm.main-obj-type
     3445     tt-firm.main-obj-code
     3446     .
     3447   run adm/sysconf1.p
     3448     (input-output v-rid
     3449     ,input p-mode
     3450     ,input no
     3451     ,input p-is-deploy
     3452     ,input tt-sysconf.host-code
     3453     ,input tt-clients.grp-code
     3454     ,input tt-clients.obj-name
     3455     ,input tt-sysconf.avrg-price
     3456     ,input tt-sysconf.artic-disable
     3457     ,input tt-sysconf.base-code
     3458     ,input tt-sysconf.branch
     3459     ,input tt-sysconf.cash-pay
     3460     ,input tt-sysconf.cashier
     3461     ,input tt-sysconf.cons-vat-pc
     3462     ,input tt-sysconf.credit-pay
     3463     ,input tt-sysconf.firm-db-num
     3464     ,input tt-sysconf.head-position
     3465     ,input tt-sysconf.KOPF
     3466     ,input tt-sysconf.negative-rest
     3467     ,input tt-sysconf.ord-prt
     3468     ,input tt-sysconf.osn-base
     3469     ,input tt-sysconf.property
     3470     ,input tt-sysconf.purch-code
     3471     ,input tt-sysconf.ret-credit-pay
     3472     ,input tt-sysconf.sale-type
     3473     ,input tt-sysconf.sale-code
     3474     ,input tt-sysconf.snr-accnt
     3475     ,input tt-sysconf.SOEI
     3476     ,input tt-sysconf.transport-cli-type
     3477     ,input tt-sysconf.transport-cli-code
     3478     ,input tt-sysconf.transport-host
     3479     ,input tt-sysconf.transport-contract
     3480     ,input tt-sysconf.transport-uslov
     3481     ,input tt-sysconf.transport-value
     3482     ,input tt-firm.main-obj-type
     3483     ,input tt-firm.main-obj-code
     3484     ,input varals-gds
     3485     ,input fi-egrip-date
     3486     ,input fi-egrip-num
     3487     ,input tt-sysconf.gen-s-f-office
     3488     ) no-error .
     3489   if error-status :error
     3490   then do:
     3491   message error-status:get-message(1) view-as alert-box .
     3492   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3493   define variable fh as widget-handle no-undo .
     3494   define variable hh as widget-handle no-undo .
     3495   define variable rv as character no-undo .
     3496   assign
     3497   rv = entry(1, return-value , chr(4)).
     3498   if rv <> "":U then do:
     3499     assign
     3500     fh = frame Dialog-Frame:first-child
     3501     hh = fh:first-child
     3502     .
     3503     do while valid-handle(hh):
     3504       if hh:name = rv then do:
     3505         APPLY "ENTRY" to hh.
     3506         undo ,
     3507         return error.
     3508       end.
     3509       hh = hh:next-sibling.
     3510     end.
     3511   end.
     3512     undo, return error.
     3513   end.
     3514   END PROCEDURE.
