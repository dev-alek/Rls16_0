     2359           ,input-output ref-list
     2360           ) .
     2361         if ref-list <> ""
     2362         then do:
     2363           find buf_cli-grp
     2364             where recid( buf_cli-grp ) = integer( ref-list )
     2365             .
     2366           if can-find( first ub.cli-grp where
     2367                             ub.cli-grp.upper-code = buf_cli-grp.node-code )
     2368           then do:
     2369             message
     2370               "Добавлять можно только в группы," skip
     2371               "у которых нет подгрупп." skip
     2372               "Выбирайте другую группу !" skip
     2373               view-as alert-box information .
     2374             return .
     2375           end.
     2376           assign
     2377             tt-clients.grp-code = buf_cli-grp.node-code
     2378           .
     2379         end.
     2380         else do:
     2381           return .
     2382         end.
     2383       end.
     2384       else do:
     2385         find first locked_clients exclusive-lock
     2386           where locked_clients.obj-type = 'орг':U
     2387           and (p-host-code = 0 or locked_clients.obj-code = p-host-code)
     2388           no-wait
     2389           no-error
     2390           .
     2391         if not available locked_clients
     2392         then do:
     2393           if locked locked_clients
     2394           then do:
     2395             find first locked_clients exclusive-lock
     2396               where locked_clients.obj-type = 'орг':U
     2397               no-error  .
     2398           end.
     2399           else do:
     2400             message
     2401               vss-workfile vss-revision vss-description skip
     2402               "Не найдена запись клиент для свой фирмы" skip
     2403               view-as alert-box error .
     2404           end.
     2405           undo, return error .
     2406         end.
     2407         find first locked_firm exclusive-lock
     2408           where locked_firm.firm-code = locked_clients.obj-code
     2409           no-wait
     2410           no-error
     2411           .
     2412         if not available locked_firm
     2413         then do:
     2414           if locked locked_firm
     2415           then do:
     2416             find first locked_firm exclusive-lock
     2417               where locked_firm.firm-code = locked_clients.obj-code
     2418               no-error
     2419               .
     2420           end.
     2421           else do:
     2422             message
     2423               vss-workfile vss-revision vss-description skip
     2424               "Не найдена запись фирма для свой фирмы" skip
     2425               view-as alert-box error .
     2426           end.
     2427           undo, return error.
     2428         end.
     2429         buffer-copy locked_clients to tt-clients .
     2430         buffer-copy locked_firm to tt-firm .
     2431         tt-sysconf.host-code = tt-clients.obj-code.
     2432       end.
     2433     end.
     2434     else do:
     2435       if p-mode = 'ИЗМЕНЕНИЕ':U
     2436       then do:
     2437         find first locked_sysconf exclusive-lock
     2438           where locked_sysconf.host-code = p-host-code
     2439           no-wait
     2440           no-error .
     2441         if not available locked_sysconf
     2442         then do:
     2443           if locked locked_sysconf
     2444           then do:
     2445             find first locked_sysconf exclusive-lock
     2446               where locked_sysconf.host-code = p-host-code
     2447               no-error .
     2448           end.
     2449           else do:
     2450             message
     2451               vss-workfile vss-revision vss-description skip
     2452               "Ошибка при поиске фирмы" skip
     2453               "Код фирмы" p-host-code skip
     2454               view-as alert-box error .
     2455           end.
     2456           undo, return error.
     2457         end.
     2458         find first locked_clients exclusive-lock
     2459           where locked_clients.obj-code = locked_sysconf.host-code
     2460             and locked_clients.obj-type = 'орг':U
     2461           no-wait
     2462           no-error .
     2463         if not available locked_clients
     2464         then do:
     2465          if locked locked_clients
     2466           then do:
     2467             find first locked_clients exclusive-lock
     2468               where locked_clients.obj-code = locked_sysconf.host-code
     2469                 and locked_clients.obj-type = 'орг':U
     2470               no-error .
     2471           end.
     2472           else do:
     2473             message
     2474               vss-workfile vss-revision vss-description skip
     2475               "Не найдена запись КЛИЕНТ для СВОЕЙ ФИРМЫ" p-host-code skip
     2476               view-as alert-box error .
     2477           end.
     2478           undo, return error.
     2479         end.
     2480         find first locked_firm exclusive-lock
     2481           where locked_firm.firm-code = locked_sysconf.host-code
     2482           no-wait
     2483           no-error
     2484           .
     2485         if not available locked_firm
     2486         then do:
     2487           if locked locked_firm
     2488           then do:
     2489             message
     2490               vss-workfile vss-revision vss-description skip
     2491               "Запись ФИРМА для СВОЕЙ ФИРМЫ" p-host-code "занята"
     2492               view-as alert-box error .
     2493           end.
     2494           else do:
     2495             message
     2496               vss-workfile vss-revision vss-description skip
     2497               "Не найдена запись ФИРМА для СВОЕЙ ФИРМЫ" p-host-code skip
     2498               view-as alert-box error .
     2499           end.
     2500           undo, return error .
     2501         end.
     2502       end.
     2503       if p-mode = 'ПРОСМОТР':U
     2504       then do:
     2505         find first locked_sysconf no-lock
     2506           where locked_sysconf.host-code = p-host-code
     2507           .
     2508         find first locked_clients no-lock
     2509           where locked_clients.obj-code = locked_sysconf.host-code
     2510             and locked_clients.obj-type = 'орг':U
     2511           .
     2512         find first locked_firm no-lock
     2513           where locked_firm.firm-code = locked_sysconf.host-code
     2514           .
     2515       end.
     2516       if not available locked_sysconf
     2517       then do:
     2518         message
     2519           vss-workfile vss-revision vss-description skip
     2520           "Внутренняя ошибка" skip
     2521           "Недоступна запись текущей фирмы locked_sysconf" skip
     2522           view-as alert-box error .
     2523         undo, return error return-value .
     2524       end.
     2525       find first locked_currency no-lock
     2526         where locked_currency.curr-code = locked_sysconf.base-code
     2527         no-error .
     2528       if not available locked_currency
     2529       then do:
     2530         message
     2531           vss-workfile vss-revision vss-description skip
     2532           "Не найдена базовая валюта для фирмы" locked_sysconf.host-code skip
     2533           "Код валюты" locked_sysconf.base-code skip
     2534           view-as alert-box error .
     2535         undo, return error return-value .
     2536       end.
     2537       create tt-clients.
     2538       create tt-sysconf.
     2539       create tt-firm.
     2540       buffer-copy locked_clients to tt-clients.
     2541       buffer-copy locked_sysconf to tt-sysconf.
     2542       buffer-copy locked_firm to tt-firm.
     2543     end.
     2544     run myenable in this-procedure
     2545       no-error .
     2546     if error-status :error
     2547     then do:
     2548       return error return-value .
     2549     end.
     2550     view frame Dialog-Frame.
     2551     wait-for go of frame Dialog-Frame.
     2552   END.
     2553   RUN disable_UI in this-procedure .
     2554   PROCEDURE disable_UI :
     2555     HIDE FRAME Dialog-Frame.
     2556   END PROCEDURE.
     2557   PROCEDURE enable_UI :
     2558     DISPLAY base-code-name varpurch-name varals-gds fi-egrip-date fi-egrip-num
     2559             sale-code-name cash-pay-name credit-pay-name ret-credit-pay-name
     2560             hold-arh-title main-obj-title main-obj-name
     2561         WITH FRAME Dialog-Frame.
     2562     IF AVAILABLE tt-clients THEN
     2563       DISPLAY tt-clients.obj-name
     2564         WITH FRAME Dialog-Frame.
     2565     IF AVAILABLE tt-firm THEN
     2566       DISPLAY tt-firm.main-obj-code tt-firm.main-obj-type
     2567         WITH FRAME Dialog-Frame.
     2568     IF AVAILABLE tt-sysconf THEN
     2569       DISPLAY tt-sysconf.host-code tt-sysconf.base-code tt-sysconf.sale-type
     2570             tt-sysconf.sale-code tt-sysconf.cash-pay tt-sysconf.credit-pay
     2571             tt-sysconf.cons-vat-pc tt-sysconf.ret-credit-pay tt-sysconf.osn-base
     2572             tt-sysconf.negative-rest tt-sysconf.avrg-price
     2573             tt-sysconf.artic-disable tt-sysconf.gen-s-f-office
     2574             tt-sysconf.head-position tt-sysconf.snr-accnt tt-sysconf.cashier
     2575             tt-sysconf.branch tt-sysconf.property tt-sysconf.KOPF tt-sysconf.SOEI
     2576         WITH FRAME Dialog-Frame.
     2577     ENABLE B-exit b-quit B-transport Btn_trn-reason B-attr B-hist B-Help RECT-1
     2578            RECT-2 b-base-code tt-sysconf.sale-type tt-sysconf.sale-code
     2579            B-sale-type-code tt-sysconf.cash-pay B-cash-pay tt-sysconf.credit-pay
     2580            B-credit-pay tt-sysconf.cons-vat-pc tt-sysconf.ret-credit-pay
     2581            B-ret-credit-pay tt-sysconf.negative-rest varpurch-name
     2582            tt-sysconf.avrg-price tt-sysconf.artic-disable varals-gds
     2583            tt-sysconf.gen-s-f-office fi-egrip-date fi-egrip-num
     2584            tt-firm.main-obj-code tt-firm.main-obj-type B-hold-obj
     2585            tt-sysconf.head-position tt-sysconf.snr-accnt tt-sysconf.cashier
     2586            tt-sysconf.branch tt-sysconf.property tt-sysconf.KOPF tt-sysconf.SOEI
     2587            sale-code-name cash-pay-name credit-pay-name ret-credit-pay-name
     2588            hold-arh-title main-obj-title main-obj-name
     2589         WITH FRAME Dialog-Frame.
     2590     VIEW FRAME Dialog-Frame.
     2591   END PROCEDURE.
     2592   PROCEDURE gen-code :
     2593   define output parameter p-firm-code like ub.firm.firm-code no-undo.
     2594   def variable ii as integer no-undo.
     2595   define buffer buf_firm for ub.firm.
     2596   do ii = 1 to 99999:
     2597       find first buf_firm no-lock where
     2598                   buf_firm.firm-code = ii no-error.
     2599       if not available buf_firm
     2600       then do:
     2601           assign
     2602           p-firm-code = ii.
     2603           return.
     2604       end.
     2605   END.
     2606   END PROCEDURE.
     2607   PROCEDURE local-cli-chk :
     2608   define input parameter p-man    as character no-undo.
     2609   define input parameter p-man2 as character no-undo .
     2610   define input parameter p-action as character no-undo.
     2611   if p-man = "sale-code" and p-man2 = "sale-type" and p-action = "ret-mouse" then do:
     2612     define variable v-ref-rec16   as recid no-undo .
     2613     define variable ref-list16 as character no-undo .
     2614     find buf_cli_sale-code where buf_cli_sale-code.obj-code = input frame Dialog-Frame tt-sysconf.sale-code
     2615                    and buf_cli_sale-code.obj-type = input frame Dialog-Frame tt-sysconf.sale-type no-lock no-error.
     2616     if not available buf_cli_sale-code or lookup(buf_cli_sale-code.obj-type, ('орг':U + chr(44) + 'чел':U) ) = 0 then do:
     2617       if input frame Dialog-Frame tt-sysconf.sale-code <> ""
     2618          and input frame Dialog-Frame tt-sysconf.sale-code <> ? then
     2619         message substitute("Из справочника клиентов Вы должны выбрать &1.", ('орг':U + chr(44) + 'чел':U)).
     2620       run ref/cli-all.w (  input parparentproc
     2621                     ,  input "b-sel"
     2622                     ,  input ?
     2623                     ,  input ?
     2624                     ,  input ?
     2625                     ,  input v-ref-rec16
     2626                     ,  input ",,,,,,NO"
     2627                     ,  input ""
     2628                     , output ref-list16 ) .
     2629       assign v-ref-rec16 = integer( ref-list16 ).
     2630       find buf_cli_sale-code where recid (buf_cli_sale-code) =
     2631          v-ref-rec16
     2632          no-lock no-error.
     2633       if not available buf_cli_sale-code or lookup(buf_cli_sale-code.obj-type, ('орг':U + chr(44) + 'чел':U) ) = 0 then
     2634         find buf_cli_sale-code where buf_cli_sale-code.obj-code = input frame Dialog-Frame tt-sysconf.sale-code
     2635                          and buf_cli_sale-code.obj-type = input frame Dialog-Frame tt-sysconf.sale-type no-lock no-error.
     2636     end.
     2637     if available buf_cli_sale-code and lookup(buf_cli_sale-code.obj-type, ('орг':U + chr(44) + 'чел':U) ) > 0 then do:
     2638       display buf_cli_sale-code.obj-code @ tt-sysconf.sale-code
     2639               buf_cli_sale-code.obj-type @ tt-sysconf.sale-type
     2640               buf_cli_sale-code.obj-name @ sale-code-name with frame Dialog-Frame.
     2641       assign frame Dialog-Frame tt-sysconf.sale-code.
     2642     end.
     2643     else do:
     2644        display
     2645        ? @ tt-sysconf.sale-code
     2646        ? @ sale-code-name with frame Dialog-Frame.
     2647     end.
     2648     apply "entry" to b-sale-type-code in frame Dialog-Frame.
     2649     return no-apply.
     2650   end.
     2651   if p-man = "sale-code" and p-man2 = "sale-type" and p-action = "button" then do:
     2652     define variable v-ref-rec17   as recid no-undo .
     2653     define variable ref-list17 as character no-undo .
     2654     find buf_cli_sale-code where buf_cli_sale-code.obj-code = input frame Dialog-Frame tt-sysconf.sale-code
     2655                    and buf_cli_sale-code.obj-type = input frame Dialog-Frame tt-sysconf.sale-type no-lock no-error.
     2656     assign v-ref-rec17 = ( if available buf_cli_sale-code then recid( buf_cli_sale-code ) else ? ).
     2657     release buf_cli_sale-code.
     2658     if not available buf_cli_sale-code or lookup(buf_cli_sale-code.obj-type, ('орг':U + chr(44) + 'чел':U) ) = 0 then do:
     2659       run ref/cli-all.w (  input parparentproc
     2660                     ,  input "b-sel"
     2661                     ,  input ?
     2662                     ,  input ?
     2663                     ,  input ?
     2664                     ,  input v-ref-rec17
     2665                     ,  input ",,,,,,NO"
     2666                     ,  input ""
     2667                     , output ref-list17 ) .
     2668       assign v-ref-rec17 = integer( ref-list17 ).
     2669       find buf_cli_sale-code where recid (buf_cli_sale-code) =
     2670          v-ref-rec17
     2671          no-lock no-error.
     2672       if not available buf_cli_sale-code or lookup(buf_cli_sale-code.obj-type, ('орг':U + chr(44) + 'чел':U) ) = 0 then
     2673         find buf_cli_sale-code where buf_cli_sale-code.obj-code = input frame Dialog-Frame tt-sysconf.sale-code
     2674                          and buf_cli_sale-code.obj-type = input frame Dialog-Frame tt-sysconf.sale-type no-lock no-error.
     2675     end.
     2676     if available buf_cli_sale-code and lookup(buf_cli_sale-code.obj-type, ('орг':U + chr(44) + 'чел':U) ) > 0 then do:
     2677       display buf_cli_sale-code.obj-code @ tt-sysconf.sale-code
     2678               buf_cli_sale-code.obj-type @ tt-sysconf.sale-type
     2679               buf_cli_sale-code.obj-name @ sale-code-name with frame Dialog-Frame.
     2680       assign frame Dialog-Frame tt-sysconf.sale-code.
     2681     end.
     2682     else do:
     2683        display
     2684        ? @ tt-sysconf.sale-code
     2685        ? @ sale-code-name with frame Dialog-Frame.
     2686     end.
     2687     apply "entry" to b-sale-type-code in frame Dialog-Frame.
     2688     return no-apply.
     2689   end.
     2690   if p-man = "sale-code" and p-man2 = "sale-type" and p-action = "leave" then do:
     2691     define variable v-ref-rec18   as recid no-undo .
     2692     define variable ref-list18 as character no-undo .
     2693     find buf_cli_sale-code where buf_cli_sale-code.obj-code = input frame Dialog-Frame tt-sysconf.sale-code
     2694                    and buf_cli_sale-code.obj-type = input frame Dialog-Frame tt-sysconf.sale-type no-lock no-error.
     2695   if available buf_cli_sale-code then do:
     2696       display
     2697       buf_cli_sale-code.obj-code @ tt-sysconf.sale-code
     2698       buf_cli_sale-code.obj-type @ tt-sysconf.sale-type
     2699       buf_cli_sale-code.obj-name @ sale-code-name
     2700       with frame Dialog-Frame.
     2701           assign frame Dialog-Frame tt-sysconf.sale-code  tt-sysconf.sale-type.
     2702   end.
     2703   else do:
     2704     display
     2705     ? @ tt-sysconf.sale-code
     2706     ? @ sale-code-name with frame Dialog-Frame.
     2707   end.
     2708   end.
     2709   END PROCEDURE.
     2710   PROCEDURE local-cp-chk :
     2711   define input parameter p-man    as character no-undo.
     2712   define input parameter p-action as character no-undo.
     2713   DEFINE VARIABLE ref-list AS CHARACTER NO-UNDO.
     2714   if p-man = "credit-pay" and p-action = "ret-mouse" then do:
     2715   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2716     define variable v-rid-list20   as character no-undo .
     2717     find buf_cp_credit-pay where buf_cp_credit-pay.cdpay-code = input frame Dialog-Frame tt-sysconf.credit-pay
     2718                    no-lock no-error.
     2719     if not available buf_cp_credit-pay  then do:
     2720       if input frame Dialog-Frame tt-sysconf.credit-pay <> ""
     2721          and input frame Dialog-Frame tt-sysconf.credit-pay <> ? then
     2722         message "Из справочника типов кассовых платежей Вы должны выбрать тип кассового платежа.".
     2723      run ref/cashpays.w (
     2724                          input parparentproc
     2725                         ,input "b-sel"
     2726                         ,input 'все':U
     2727                         ,input 0
     2728                         ,input ''
     2729                         ,input 0
     2730                         ,output v-rid-list20
     2731                         ) no-error.
     2732       find buf_cp_credit-pay where recid (buf_cp_credit-pay) = integer(v-rid-list20)  no-lock no-error.
     2733       if not available buf_cp_credit-pay then
     2734         find first buf_cp_credit-pay where
     2735             buf_cp_credit-pay.cdpay-code = input frame Dialog-Frame tt-sysconf.credit-pay
     2736         no-lock no-error.
     2737     end.
     2738     if available buf_cp_credit-pay then do:
     2739       display buf_cp_credit-pay.cdpay-code @ tt-sysconf.credit-pay
     2740               buf_cp_credit-pay.obj-name @ credit-pay-name with frame Dialog-Frame.
     2741       assign frame Dialog-Frame tt-sysconf.credit-pay.
     2742     end.
     2743     else display ? @ tt-sysconf.credit-pay
     2744                  ? @ credit-pay-name with frame Dialog-Frame.
     2745     apply "entry" to b-exit in frame Dialog-Frame.
     2746     return no-apply.
     2747   end.
     2748   if p-man = "credit-pay" and p-action = "button" then do:
     2749   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2750     define variable v-rid-list22   as character no-undo .
     2751     find buf_cp_credit-pay where buf_cp_credit-pay.cdpay-code = input frame Dialog-Frame tt-sysconf.credit-pay
     2752                     no-lock no-error.
     2753     assign v-rid-list22 = ( if available buf_cp_credit-pay then string(recid( buf_cp_credit-pay )) else ? ).
     2754     release buf_cp_credit-pay.
     2755     if not available buf_cp_credit-pay  then do:
     2756      run ref/cashpays.w (
     2757                          input parparentproc
     2758                         ,input "b-sel"
     2759                         ,input 'все':U
     2760                         ,input 0
     2761                         ,input ''
     2762                         ,input 0
     2763                         ,output v-rid-list22
     2764                         ) no-error.
     2765       find buf_cp_credit-pay where recid (buf_cp_credit-pay) = integer(v-rid-list22)  no-lock no-error.
     2766       if not available buf_cp_credit-pay then
     2767         find first buf_cp_credit-pay where
     2768             buf_cp_credit-pay.cdpay-code = input frame Dialog-Frame tt-sysconf.credit-pay
     2769         no-lock no-error.
     2770     end.
     2771     if available buf_cp_credit-pay then do:
     2772       display buf_cp_credit-pay.cdpay-code @ tt-sysconf.credit-pay
     2773               buf_cp_credit-pay.obj-name @ credit-pay-name with frame Dialog-Frame.
     2774       assign frame Dialog-Frame tt-sysconf.credit-pay.
     2775     end.
     2776     else display ? @ tt-sysconf.credit-pay
     2777                  ? @ credit-pay-name with frame Dialog-Frame.
     2778     apply "entry" to b-exit in frame Dialog-Frame.
     2779     return no-apply.
     2780   end.
     2781   if p-man = "credit-pay" and p-action = "leave" then do:
     2782   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2783     define variable v-rid-list24   as character no-undo .
     2784     find buf_cp_credit-pay where buf_cp_credit-pay.cdpay-code = input frame Dialog-Frame tt-sysconf.credit-pay
     2785                    no-lock no-error.
     2786   if available buf_cp_credit-pay then do:
     2787       display
     2788       buf_cp_credit-pay.cdpay-code @ tt-sysconf.credit-pay
     2789       buf_cp_credit-pay.obj-name @ credit-pay-name with frame Dialog-Frame.
     2790           assign frame Dialog-Frame tt-sysconf.credit-pay.
     2791   end.
     2792   else display ? @ tt-sysconf.credit-pay ? @ credit-pay-name with frame Dialog-Frame.
     2793   end.
     2794   END PROCEDURE.
     2795   PROCEDURE local-curr-chk :
     2796   define input parameter p-man    as character no-undo.
     2797   define input parameter p-action as character no-undo.
     2798   DEFINE VARIABLE ref-list AS CHARACTER NO-UNDO.
     2799   if p-man = "base-code" and p-action = "ret-mouse" then do:
     2800   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2801     define variable v-ref-rec26   as recid no-undo .
     2802     find buf_curr-chk where buf_curr-chk.curr-code = input frame Dialog-Frame tt-sysconf.base-code
     2803                    no-lock no-error.
     2804     if not available buf_curr-chk  then do:
     2805       if input frame Dialog-Frame tt-sysconf.base-code <> ""
     2806          and input frame Dialog-Frame tt-sysconf.base-code <> ? then
     2807         message "Из справочника валют Вы должны выбрать валюту.".
     2808       run ref/currency.w (
     2809                       input parparentproc
     2810                     , input "b-sel"
     2811                     , input-output v-ref-rec26) no-error .
     2812       find buf_curr-chk where recid (buf_curr-chk) = v-ref-rec26  no-lock no-error.
     2813       if not available buf_curr-chk then
     2814         find first buf_curr-chk where
     2815             buf_curr-chk.curr-code = input frame Dialog-Frame tt-sysconf.base-code
     2816         no-lock no-error.
     2817     end.
     2818     if available buf_curr-chk then do:
     2819       display buf_curr-chk.curr-code @ tt-sysconf.base-code
