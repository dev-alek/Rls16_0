      409   procedure thbjattr_code :
      410      define input  parameter p-upper-code     as character no-undo .
      411      define input  parameter p-code           as character no-undo .
      412      define output parameter p-label          as character no-undo .
      413      define output parameter p-user-can-edit  as logical   no-undo .
      414      define output parameter p-output-display as logical   no-undo .
      415      define output parameter p-other          as character no-undo .
      416      define output parameter p-prop-list      as character no-undo .
      417      define output parameter p-prop-type-list as character no-undo .
      418      define output parameter p-prop-label-list as character no-undo .
      419      define output parameter p-global          as logical no-undo .
      420      define output parameter p-host           as logical no-undo .
      421      define output parameter p-shop           as logical no-undo .
      422      define output parameter p-store          as logical no-undo .
      423      define output parameter p-db             as logical no-undo .
      424      define variable p-region as logical no-undo.
      425      run thbjattr_code_reg in this-procedure (
      426                                               p-upper-code,
      427                                               p-code,
      428                                               output p-label,
      429                                               output p-user-can-edit,
      430                                               output p-output-display,
      431                                               output p-other,
      432                                               output p-prop-list,
      433                                               output p-prop-type-list,
      434                                               output p-prop-label-list,
      435                                               output p-global,
      436                                               output p-host,
      437                                               output p-shop,
      438                                               output p-store,
      439                                               output p-db,
      440                                               output p-region
      441                                               ).
