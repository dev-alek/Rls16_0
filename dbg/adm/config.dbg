     3218   then do:
     3219     enable
     3220       fi-egrip-num
     3221       with frame Dialog-Frame.
     3222   end.
     3223   if hold = "yes"
     3224   then do:
     3225     find first buf_clients no-lock
     3226       where buf_clients.obj-code = tt-firm.main-obj-code
     3227         and buf_clients.obj-type = tt-firm.main-obj-type
