     1441   FUNCTION title-mode RETURNS CHARACTER
     1442     ( INPUT pmode as character ) :
     1443   DEFINE VARIABLE ptitle-mode as character no-undo.
     1444   CASE ENTRY(1, pmode) :
     1445     when 'ДОБАВЛЕНИЕ':U then ptitle-mode = "ДОБАВЛЕНИЕ".
     1446     when 'ИЗМЕНЕНИЕ':U  then ptitle-mode = "ИЗМЕНЕНИЕ".
     1447     when 'ПРОСМОТР':U  then ptitle-mode = "ПРОСМОТР".
     1448   END CASE.
     1449     RETURN ptitle-mode.
     1450   END FUNCTION.
