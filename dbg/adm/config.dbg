     3019   PROCEDURE MyEnable :
     3020   define variable hold-type as character no-undo.
     3021   define variable v-next-firm-code like ub.firm.firm-code.
     3022   define variable vartpsi      as character no-undo.
     3023   define variable vartpsi-type as character no-undo.
     3024   define variable varals-gds-str      as character no-undo.
     3025   define variable varals-gds-str-type as character no-undo.
     3026   define variable var-type            as character no-undo .
     3027   define variable var-tooltip         as character no-undo .
     3028   define variable v-egrip-date-str    as character    no-undo.
     3029   define buffer buf_sysconf for ub.sysconf.
     3030   define buffer buf1_clients for ub.clients.
     3031   define buffer buf_pay-type for ub.pay-type.
     3032   assign
     3033   varpurch-name:LIST-ITEMS in frame Dialog-Frame = 'выкуп,консигнация,ответственное хранение':U
     3034   .
     3035   if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     3036     run gen-code in this-procedure
     3037       (output v-next-firm-code
     3038       ) no-error .
     3039     if error-status :error
     3040     or v-next-firm-code = 0
     3041     then do:
     3042       message
     3043         "Ошибка при генерации кода новой СВОЕЙ ФИРМЫ" skip
     3044         "или нет свободного кода"
     3045         view-as alert-box error.
     3046         return error.
     3047     end.
     3048   end.
     3049   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3050     (input  'holding'
     3051     ,input  0
     3052     ,input  ''
     3053     ,input  0
     3054     ,input  ''
     3055     ,input  ''
     3056     ,input  ''
     3057     ,input  no
     3058     ,output hold
     3059     ,output hold-type
     3060     ) no-error .
     3061   if ( not error-status :error )
     3062   and hold = "yes"
     3063   then do:
     3064     if p-mode = 'ИЗМЕНЕНИЕ':U
     3065     then do:
     3066       enable
     3067         RECT-2
     3068         B-hold-obj
     3069         tt-firm.main-obj-code
     3070         tt-firm.main-obj-type
     3071         with frame Dialog-Frame.
     3072     end.
     3073     display
     3074     hold-arh-title
     3075     main-obj-title
     3076     main-obj-name
     3077     with frame Dialog-Frame.
     3078     assign
     3079     B-hold-obj:visible = yes
     3080     RECT-2:visible     = yes
     3081     tt-firm.main-obj-code:visible  = yes
     3082     hold-arh-title:visible  = yes
     3083     main-obj-title:visible  = yes
     3084     main-obj-name:visible  = yes
     3085     tt-firm.main-obj-type:visible  = yes
     3086     .
     3087   end.
     3088   else do:
     3089     assign
     3090     B-hold-obj:visible = no
     3091     RECT-2:visible     = no
     3092     tt-firm.main-obj-code:visible  = no
     3093     hold-arh-title:visible  = no
     3094     main-obj-title:visible  = no
     3095     main-obj-name:visible  = no
     3096     tt-firm.main-obj-type:visible  = no
     3097     .
     3098   end.
     3099   if tt-sysconf.base-code <> 0
     3100   then do:
     3101     DISPLAY
     3102     tt-sysconf.osn-base with frame Dialog-Frame.
     3103     enable
     3104     tt-sysconf.osn-base when (not (p-is-deploy and parparentproc:get-signature("mainmenu_getcntxt") = "")
     3105                                   and p-mode <> 'ПРОСМОТР':U)
     3106     with frame Dialog-Frame.
     3107   end.
     3108   else do:
     3109     HIDE
     3110     tt-sysconf.osn-base
     3111     in frame Dialog-Frame.
     3112   end.
     3113   assign
     3114     tt-sysconf.osn-base :tooltip = "Учет ОС не только в рублях, но и в баз. вал."
     3115   .
     3116   assign varpurch-name =  entry (lookup (string(tt-sysconf.purch-code), '1,2,3':U), 'выкуп,консигнация,ответственное хранение':U).
     3117   display
     3118   varpurch-name
     3119   with frame Dialog-Frame.
     3120   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3121     (input  'tpsi'
     3122     ,input  0
     3123     ,input  ''
     3124     ,input  0
     3125     ,input  ''
     3126     ,input  ''
     3127     ,input  ''
     3128     ,input  no
     3129     ,output vartpsi
     3130     ,output vartpsi-type
     3131     ) no-error .
     3132   if ( not error-status :error )
     3133   and vartpsi = "yes"
     3134   then do:
     3135     run clntattr-value in this-procedure (
     3136                                           input  'орг':U
     3137                                           ,input  tt-sysconf.host-code
     3138                                           ,input  'als-gds':U
     3139                                           ,output varals-gds-str
     3140                                           ,output varals-gds-str-type).
     3141     if varals-gds-str = "yes"
     3142     then do:
     3143       assign
     3144         varals-gds = yes
     3145       .
     3146     end.
     3147     else do:
     3148       assign
     3149         varals-gds = no
     3150       .
     3151     end.
     3152     display varals-gds with frame Dialog-Frame.
     3153     if p-mode <> 'ПРОСМОТР':U
