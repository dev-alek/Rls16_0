     1946   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1947   on help of frame Dialog-Frame
     1948   do:
     1949     run gbl/app_help.p
     1950       (input this-procedure :file-name
     1951       ,input ''
     1952       ,input ?
     1953       ) no-error.
     1954     if error-status :error then do:
     1955       message
     1956         "Ошибка при вызове помощи"
     1957         error-status :get-message(1)
     1958         view-as alert-box .
     1959     end.
     1960   end.
     1961   run minbtn-set in this-procedure .
     1962   on choose of b-help in frame Dialog-Frame
     1963   do:
     1964     apply "help":u to frame Dialog-Frame .
     1965   end.
     1966   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1967   procedure minbtn-set :
     1968       do
     1969           on error undo, return error return-value
     1970           :
     1971           define variable ii              as integer       no-undo .
     1972           define variable fh              as widget-handle no-undo .
     1973           define variable hh              as widget-handle no-undo .
     1974           define variable v-h             as handle        extent 4 no-undo .
     1975           define variable v-name-button   as character     no-undo .
     1976           define variable v-help-old-x    as decimal       no-undo .
     1977           define variable v-help-old-y    as decimal       no-undo .
     1978           define variable v-help-old-size as decimal       no-undo .
     1979           define variable v-frame-width   as decimal       no-undo .
     1980           define variable jj              as integer       no-undo .
     1981           do
     1982               on error undo, return error
     1983               :
     1984               assign
     1985                   v-frame-width = frame Dialog-Frame:width - 0.3
     1986                   fh            = frame Dialog-Frame:first-child
     1987                   hh            = fh:first-child
     1988                   ii            = 1
     1989                   .
     1990               do while valid-handle(hh):
     1991                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1992                   do:
     1993                       case lc(hh:name) :
     1994                           when "b-help" then
     1995                               do:
     1996                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1997                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1998                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1999                                   hh:TOOLTIP = "Помощь" .
     2000                                   v-help-old-x = hh:column .
     2001                                   v-help-old-y = hh:row    .
     2002                                   v-help-old-size = hh:width .
     2003                                   hh:width-chars = 2.5 .
     2004                               end.
     2005                           when "b-print" then
     2006                               do:
     2007                                   hh:load-image("cmp/b-print.bmp":u) .
     2008                                   hh:TOOLTIP = "Печать" .
     2009                                   v-h[ii] = hh:handle .
     2010                                   ii = ii + 1 .
     2011                                   hh:width-chars = 3 .
     2012                               end.
     2013                           when "b-history" or
     2014                           when "b-hist" then
     2015                               do:
     2016                                   hh:load-image("cmp/b-hist.bmp":u) .
     2017                                   hh:TOOLTIP = "История" .
     2018                                   v-h[ii] = hh:handle .
     2019                                   ii = ii + 1 .
     2020                                   hh:width-chars = 3 .
     2021                               end.
     2022                           when "b-sch" then
     2023                               do:
     2024                                   hh:load-image("cmp/b-sch.bmp":u) .
     2025                                   hh:TOOLTIP = "Установка Фильтра" .
     2026                                   v-h[ii] = hh:handle .
     2027                                   ii = ii + 1 .
     2028                                   hh:width-chars = 3 .
     2029                               end.
     2030                           when "b-hist-user" then
     2031                               do:
     2032                                   hh:load-image("cmp/b-hist.bmp":u) .
     2033                                   hh:TOOLTIP = "История пользователя" .
     2034                                   ii = ii + 1 .
     2035                               end.
     2036                       end case.
     2037                   end.
     2038                   hh = hh:next-sibling.
     2039               end.
     2040               b-help:column = v-frame-width - b-help:width-chars.
     2041               jj = 0.
     2042               repeat ii = 4 to 1 by -1 :
     2043                   if valid-handle (v-h[ii] ) then
     2044                   do:
     2045                       jj  = jj + 1 .
     2046                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2047                       v-h[ii]:row    = v-help-old-y .
     2048                   end.
     2049               end.
     2050           end.
     2051       end.
     2052   end procedure.
     2053   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2054   on ' ' of fi-egrip-date in frame Dialog-Frame
     2055   do:
     2056     if (can-query (self, "sensitive")
     2057        and
     2058        self :sensitive = true
     2059        )
     2060     or (can-query (self, "read-only")
     2061        and
     2062        self :read-only = false
     2063        )
     2064     then do:
     2065       assign
     2066         self :screen-value = ?
     2067       .
     2068     end.
     2069     return no-apply.
     2070   end.
     2071   on delete-character of fi-egrip-date in frame Dialog-Frame
     2072   do:
     2073     if (can-query (self, "sensitive")
     2074        and
     2075        self :sensitive = true
     2076        )
     2077     or (can-query (self, "read-only")
     2078        and
     2079        self :read-only = false
     2080        )
     2081     then do:
     2082       assign
     2083         self :screen-value = ?
     2084       .
     2085     end.
     2086     return no-apply.
     2087   end.
     2088   on ctrl-d of fi-egrip-date in frame Dialog-Frame
     2089   do:
     2090     define variable v-curr-sv-date as date no-undo .
     2091     if (can-query (self, "sensitive")
     2092        and
     2093        self :sensitive = true
     2094        )
     2095     or (can-query (self, "read-only")
     2096        and
     2097        self :read-only = false
     2098        )
     2099     then do:
     2100       if self :handle <> focus :handle
     2101       then do:
     2102         apply "entry":u to self .
     2103       end.
     2104       run gbl/getcurdt.p
     2105         (output v-curr-sv-date
     2106         ) .
     2107       assign
     2108         self :screen-value = string(v-curr-sv-date) .
     2109       .
     2110     end.
     2111     return no-apply.
     2112   end.
     2113   on ctrl-b of fi-egrip-date in frame Dialog-Frame
     2114   do:
     2115     if (can-query (self, "sensitive")
     2116        and
     2117        self :sensitive = true
     2118        )
     2119     or (can-query (self, "read-only")
     2120        and
     2121        self :read-only = false
     2122        )
     2123     then do:
     2124       if self :handle <> focus :handle
     2125       then do:
     2126         apply "entry":u to self .
     2127       end.
     2128       define variable v-curr-sv-date as date no-undo .
     2129       define variable v-new-sv-date  as date no-undo .
     2130       assign
     2131         v-curr-sv-date = date(self :screen-value) no-error
     2132       .
     2133       if v-curr-sv-date = ?
     2134       then do:
     2135         run gbl/getcurdt.p
     2136           (output v-curr-sv-date
     2137           ) .
     2138       end.
     2139       if v-curr-sv-date <> ?
     2140       then do:
     2141         assign
     2142           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     2143         .
     2144         assign
     2145           self :screen-value = string(v-new-sv-date) .
     2146         .
     2147       end.
     2148     end.
     2149     return no-apply .
     2150   end.
     2151   on ctrl-e of fi-egrip-date in frame Dialog-Frame
     2152   do:
     2153     if (can-query (self, "sensitive")
     2154        and
     2155        self :sensitive = true
     2156        )
     2157     or (can-query (self, "read-only")
     2158        and
     2159        self :read-only = false
     2160        )
     2161     then do:
     2162       if self :handle <> focus :handle
     2163       then do:
     2164         apply "entry":u to self .
     2165       end.
     2166       define variable v-curr-sv-date as date no-undo .
     2167       define variable v-new-sv-date  as date no-undo .
     2168       assign
     2169         v-curr-sv-date = date(self :screen-value) no-error
     2170       .
     2171       if v-curr-sv-date = ?
     2172       then do:
     2173         run gbl/getcurdt.p
     2174           (output v-curr-sv-date
     2175           ) .
     2176       end.
     2177       if v-curr-sv-date <> ?
     2178       then do:
     2179         run gbl/lastdate.p
     2180           (input  v-curr-sv-date
     2181           ,output v-new-sv-date
     2182           ).
     2183         assign
     2184           self :screen-value = string(v-new-sv-date) .
     2185         .
     2186       end.
     2187     end.
     2188     return no-apply .
     2189   end.
     2190   on ctrl-f of fi-egrip-date in frame Dialog-Frame
     2191   do:
     2192     if (can-query (self, "sensitive")
     2193        and
     2194        self :sensitive = true
     2195        )
     2196     or (can-query (self, "read-only")
     2197        and
     2198        self :read-only = false
     2199        )
     2200     then do:
     2201       if self :handle <> focus :handle
     2202       then do:
     2203         apply "entry":u to self .
     2204       end.
     2205       define variable v-ok            as logical   no-undo .
     2206       define variable v-curr-sv-date  as date      no-undo .
     2207       define variable v-description   as character no-undo .
     2208       assign
     2209         v-curr-sv-date = date(self :screen-value) no-error
     2210       .
     2211       if v-curr-sv-date = ?
     2212       then do:
     2213         run gbl/getcurdt.p
     2214           (output v-curr-sv-date
     2215           ) .
     2216       end.
     2217       if v-curr-sv-date <> ?
     2218       then do:
     2219         run gbl/d-inpday.w
     2220           (input ?
     2221           ,input "Выбор даты"
     2222           ,input v-description
     2223           ,input ""
     2224           ,input-output v-curr-sv-date
     2225           ,output v-ok
     2226           ).
     2227         if v-ok = true
     2228         then do:
     2229           assign
     2230             self :screen-value = string(v-curr-sv-date) .
     2231           .
     2232         end.
     2233       end.
     2234     end.
     2235     return no-apply .
     2236   end.
