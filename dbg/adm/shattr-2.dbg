      615   procedure proc-alt-shift-f2:
      616     if not ibs.th.gbl.gbl-var:rcode
      617   then
      618     run gbl\inidebug.p .
      619   end.
      620   procedure proc-alt-shift-f3:
      621     run gbl/prvssinf.p
      622       ( input this-procedure
      623       ) .
      624   end.
      625   define variable v-inform-launched as logical no-undo initial false .
      626   procedure proc-alt-shift-f4:
      627     define variable v-action as character no-undo .
      628     if v-inform-launched = false then do:
      629       assign
      630         v-inform-launched = true
      631       .
      632       run gbl/d-inform.w
      633         (  input self
      634         ,  input this-procedure
      635         , output v-action
      636         ) no-error .
      637       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      638       assign
      639         v-inform-launched = false
      640       .
      641     end.
      642   end.
      643   procedure proc-alt-f1:
      644     run gbl/corrhelp.p
      645       (input this-procedure
      646       ) .
      647   end .
      648   on alt-shift-f2 anywhere do:
      649     run proc-alt-shift-f2.
      650   end.
      651   on alt-shift-f3 anywhere do:
      652     run proc-alt-shift-f3 in this-procedure .
      653   end.
      654   on alt-shift-f4 anywhere do:
      655     run proc-alt-shift-f4 in this-procedure.
      656   end.
      657   on alt-f1 anywhere do:
      658     run proc-alt-f1 in this-procedure .
      659   end.
      660   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      661     define variable v-cntxt-db-num        as integer   no-undo .
      662     define variable v-cntxt-userid        as character no-undo .
      663     define variable v-cntxt-level         as character no-undo .
      664     define variable v-cntxt-host-code-obj as integer   no-undo .
      665     define variable v-cntxt-obj-type      as character no-undo .
      666     define variable v-cntxt-obj-code      as integer   no-undo .
      667     define variable v-cntxt-db-num-obj    as integer   no-undo .
      668     define variable v-cntxt-is-admin      as logical   no-undo .
      669   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      670   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
      671                                                       ,input p-range-type as character
      672                                                       ,input p-code as integer):
      673   define variable v-seq-val as integer no-undo .
      674   define buffer buf_code-range for ub.code-range.
      675   find first buf_code-range no-lock where
      676             buf_code-range.db-num = p-db-num
      677       and  buf_code-range.range-type = p-range-type
      678       and  buf_code-range.stts = 'u'
      679       and buf_code-range.first-code <= p-code
      680       and buf_code-range.last-code >= p-code no-error .
      681   if available buf_code-range then return yes.
      682   CASE p-range-type:
      683     when 'pngb':U then do:
      684       v-seq-val = current-value(s-pngb-code, ub).
      685     end.
      686     when 'fmgb':U then do:
      687       v-seq-val = current-value(s-fmgb-code, ub).
      688     end.
      689   END CASE.
      690   if p-code <= v-seq-val then do:
      691     find first buf_code-range no-lock where
      692               buf_code-range.db-num = p-db-num
      693         and  buf_code-range.range-type = p-range-type
      694         and  buf_code-range.stts = 'a'
      695         and buf_code-range.first-code <= p-code
      696         no-error .
      697    if available buf_code-range then return yes.
      698   end.
      699   find first buf_code-range no-lock where
      700             buf_code-range.db-num = p-db-num
      701       and  buf_code-range.range-type = p-range-type
      702       and  buf_code-range.stts = 'f'
      703       and buf_code-range.first-code <= p-code
      704       and buf_code-range.last-code >= p-code
      705       no-error .
      706   if available buf_code-range then return yes.
      707   return no.
      708   END FUNCTION.
      709   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
      710                                                       ,input p-range-type as character
      711                                                       ,input p-code as integer):
      712   define variable v-seq-val as integer no-undo .
      713   define buffer buf_code-range for ub.code-range.
      714   CASE p-range-type:
      715     when 'pngb':U then do:
      716       v-seq-val = current-value(s-pngb-code, ub).
      717     end.
      718     when 'fmgb':U then do:
      719       v-seq-val = current-value(s-fmgb-code, ub).
      720     end.
      721   END CASE.
      722   if p-code <= v-seq-val then do:
      723     find first buf_code-range no-lock where
      724               buf_code-range.db-num = p-db-num
      725         and  buf_code-range.range-type = p-range-type
      726         and buf_code-range.first-code <= p-code
      727         and buf_code-range.last-code >= p-code no-error .
      728     if available buf_code-range then return yes.
      729   end.
      730   return no.
      731   END FUNCTION.
      732   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
      733                                                       ,input p-db-num as integer
      734                                                       ,input p-staff-code as integer
      735                                                       ,input p-date as date
      736                                                        ):
      737   define buffer buf_staff for ub.staff.
      738   if p-date = ? then do:
      739     p-date = today .
      740   end.
      741   find first buf_staff no-lock where
      742             buf_staff.role = p-role
      743         and buf_staff.role-level = 'db':U
      744         and buf_staff.db-num = p-db-num
      745         and buf_staff.staff-code = p-staff-code
      746         and buf_staff.date-end >= p-date use-index pi  no-error .
      747   if available buf_staff then do:
      748     return buf_staff.psn-code.
      749   end.
      750   return 0.
      751   end FUNCTION.
      752   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
      753                                                             ,input p-db-num as integer
      754                                                             ,input p-date as date
      755                                                                 ):
      756   define buffer buf_staff for ub.staff.
      757   define buffer buf2_staff for ub.staff.
      758   if p-date = ? then do:
      759     p-date = today .
      760   end.
      761   for each  buf_staff no-lock where
      762             buf_staff.role = p-role
      763         and buf_staff.db-num = p-db-num,
      764   first buf2_staff no-lock where
      765         buf2_staff.role = p-role
      766     and buf2_staff.role-level = 'db':U
      767     and buf2_staff.staff-code = buf_staff.staff-code
      768     and buf2_staff.date-start <= p-date
      769     and buf2_staff.date-end >= p-date
      770   by buf_staff.staff-code
      771   by date-start descending:
      772     return buf_staff.staff-code.
      773   end.
      774   end FUNCTION.
      775   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
      776                                                  ,input p-db-num as integer
      777                                                  ,input p-psn-code as integer
      778                                                  ,input p-date as date
      779                                                  ,output p-c-password as character
      780                                                        ):
      781   define buffer buf_staff for ub.staff.
      782   if p-date = ? then do:
      783     p-date = today .
      784   end.
      785   find first buf_staff no-lock where
      786             buf_staff.role = p-role
      787         and buf_staff.role-level = 'db':U
      788         and buf_staff.db-num = p-db-num
      789        and buf_staff.date-end >= p-date
      790        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
      791   if available buf_staff
      792   then do:
      793     assign
      794     p-c-password = buf_staff.password.
      795     return buf_staff.staff-code.
      796   end.
      797   p-c-password = ''.
      798   return 0.
      799   end FUNCTION.
      800   FUNCTION gbclcode-is-psn-role returns integer (
      801                                                 input p-role as character
      802                                                 ,input p-psn-code as integer
      803                                                 ,input p-date as date
      804                                                     ):
      805   define buffer buf_staff for ub.staff.
      806   if p-date = ? then do:
      807     p-date = today .
      808   end.
      809   for each buf_staff no-lock where
      810             buf_staff.psn-code = p-psn-code
      811        and  buf_staff.role = p-role
      812   by buf_staff.role-level
      813   by buf_staff.date-start
      814        :
      815     if  buf_staff.date-start <= p-date and
      816     buf_staff.date-end >= p-date  then do:
      817       return buf_staff.staff-code.
      818     end.
      819   end.
      820   return 0.
      821   end FUNCTION.
      822   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
      823   define variable v-role-name as character no-undo .
      824   assign
      825   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      826   no-error .
      827   return v-role-name.
      828   END.
      829   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      830   FUNCTION gbclcode-get-position returns character ( input p-role as character
      831                                                     ,input p-role-level as character
      832                                                     ,input p-work-place as character
      833                                                     ,input p-staff-code as integer
      834                                                                ):
      835   define variable v-role-name as character no-undo .
      836   define variable v-role-level as character no-undo .
      837   define variable v-staff-code as integer no-undo .
      838   assign
      839   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      840   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
      841   v-staff-code = p-staff-code
      842   no-error .
      843   return substitute("&1, &2, Код &3"
      844                   ,v-role-name
      845                   ,v-role-level
      846                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
      847   END.
      848   FUNCTION gbclcode-get-work-place returns character (
      849                                                   input p-role as character
      850                                                  ,input p-role-level as character
      851                                                  ,input p-db-num as integer
      852                                                  ,input p-host-code as integer
      853                                                  ,input p-obj-type as character
      854                                                  ,input p-obj-code as integer
      855                                                  ) :
      856   define variable v-work-place as character no-undo .
      857   define variable v-obj-type as character no-undo .
      858     case p-role-level:
      859       when 'db':U then do:
      860         v-work-place = string(p-db-num, "99999").
      861       end.
      862       when 'firm':U then do:
      863         v-work-place = string(p-host-code, "99999").
      864       end.
      865       when 'object':U then do:
      866         assign
      867         v-work-place = p-obj-type + string(p-obj-code, "999999999")
      868         .
      869       end.
      870     END CASE.
      871     return v-work-place.
      872   END FUNCTION.
      873   FUNCTION gbclcode-get-level-last-code returns integer (
      874                                                           input p-role as character
      875                                                         , input p-role-level as character
      876                                                         , input p-work-place as character
      877                                                         , input p-date-start as date
      878                                                         ):
      879   DEFINE VARIABLE v-today as date no-undo .
      880   define buffer buf_staff for ub.staff.
      881   if p-work-place = chr(63) then return ?.
      882   if p-date-start = ? then do:
      883     v-today = today .
      884   end.
      885   else do:
      886     v-today = p-date-start.
      887   end.
      888   find last buf_staff no-lock where
      889             buf_staff.role = p-role
      890        and  buf_staff.role-level = p-role-level
      891        and  buf_staff.work-place = p-work-place
      892        and  buf_staff.date-start <= v-today + 1
      893        and  buf_staff.date-end >= v-today + 1
      894        use-index pi  no-error .
      895   if available buf_staff
      896   then return buf_staff.staff-code.
      897   return 0.
      898   end FUNCTION.
      899   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      900   procedure cur-time :
      901      define output parameter p-today as date      no-undo .
      902      define output parameter p-time  as integer   no-undo .
      903     do
      904     on error undo, return error
      905     :
      906       define variable v-date1 as date      no-undo .
      907       define variable v-date2 as date      no-undo .
      908       define variable v-time  as integer   no-undo .
      909       assign
      910         v-date1 = today
      911         v-time  = time
      912         v-date2 = today
      913       .
      914       if v-date1 <> v-date2
      915       then do:
      916         assign
      917           v-date1 = today
      918           v-time  = v-time
      919         .
      920       end.
      921       assign
      922         p-today = v-date1
      923         p-time  = v-time
      924       .
      925     end.
      926   end.
      927   function cur-time-date returns character
      928   :
      929     return string(today, '99/99/9999':U) .
      930   end.
      931   function cur-time-mjd returns decimal
      932   :
      933     define variable v-date as date      no-undo .
      934     define variable v-time as integer   no-undo .
      935     run cur-time in this-procedure
      936       (output v-date
      937       ,output v-time
      938       ) .
      939     return integer(v-date) - 2400002 + (v-time / 86400) .
      940   end.
      941   function cur-time-get-ending-index returns integer
      942   (input p-number as integer
      943   )
      944   :
      945     if p-number < 0
      946     or p-number = ?
      947     then do:
      948       return 1 .
      949     end.
      950     define variable v-rest as integer   no-undo .
      951     assign
      952       p-number = p-number modulo 100
      953     .
      954     if p-number < 20
      955     then do:
      956       assign
      957         v-rest = p-number
      958       .
      959     end.
      960     else do:
      961       assign
      962         v-rest = p-number modulo 10
      963       .
      964     end.
      965     case v-rest :
      966       when 1
      967       then do:
      968         return 2 .
      969       end.
      970       when 2 or
      971       when 3 or
      972       when 4
      973       then do:
      974         return 3 .
      975       end.
      976       otherwise do:
      977         return 1 .
      978       end.
      979     end case .
      980   end.
      981   procedure cur-time-mjd-to-date :
      982      define input  parameter i-mjd-diff as decimal no-undo.
      983      define output parameter o-Date     as date    no-undo.
      984      define output parameter o-Time     as integer no-undo.
      985      define variable v-day-number as integer   no-undo .
      986      if    i-mjd-diff < 0
      987         or i-mjd-diff = ?
      988      then do:
      989         return "?" .
      990      end.
      991      assign
      992         v-day-number = truncate(i-mjd-diff,0).
      993         o-Date = date(v-day-number + 2400002).
      994         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      995     .
      996   end.
      997   function cur-time-mjd-to-string returns character
      998   (input p-mjd-diff as decimal
      999   )
     1000   :
     1001     define variable v-day-number as integer   no-undo .
     1002     define variable v-seconds    as integer   no-undo .
     1003     define variable v-hour       as integer   no-undo .
     1004     define variable v-min        as integer   no-undo .
     1005     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1006     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1007     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1008     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1009     if p-mjd-diff < 0
     1010     or p-mjd-diff = ?
     1011     then do:
     1012       return "?" .
     1013     end.
     1014     assign
     1015       v-day-number = integer(truncate(p-mjd-diff,0))
     1016       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1017     .
     1018     if v-seconds > 86400
     1019     then do:
     1020       assign
     1021         v-seconds = 86400 - 1
     1022       .
     1023     end.
     1024     if v-seconds < 0
     1025     then do:
     1026       assign
     1027         v-seconds = 0
     1028       .
     1029     end.
     1030     assign
     1031       v-hour = truncate(v-seconds / 3600, 0)
     1032     .
     1033     assign
     1034       v-seconds = v-seconds modulo 3600
     1035     .
     1036     assign
     1037       v-min = truncate(v-seconds / 60, 0)
     1038     .
     1039     assign
     1040       v-seconds = v-seconds modulo 60
     1041     .
     1042     return
     1043         (if v-day-number <> 0
     1044           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1045           else ""
     1046         )
     1047       + (if v-day-number <> 0 or v-hour <> 0
     1048           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1049           else ""
     1050         )
     1051       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1052           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1053           else ""
     1054         )
     1055       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1056       .
     1057   end.
     1058   function cur-time-string returns character
     1059   :
     1060     define variable v-date as date      no-undo .
     1061     define variable v-time as integer   no-undo .
     1062     run cur-time in this-procedure
     1063       (output v-date
     1064       ,output v-time
     1065       ) .
     1066     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1067   end.
     1068   function cur-time-string-sec returns character
     1069   :
     1070     define variable v-date as date      no-undo .
     1071     define variable v-time as integer   no-undo .
     1072     run cur-time in this-procedure
     1073       (output v-date
     1074       ,output v-time
     1075       ) .
     1076     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1077   end.
     1078   function cur-time-custom  returns character
     1079   (input p-prefix as character
     1080   ,input p-date-format as character
     1081   ,input p-delimiter as character
     1082   ,input p-time-format as character
     1083   ,input p-suffix as character
     1084   )
     1085   :
     1086     define variable v-date as date      no-undo .
     1087     define variable v-time as integer   no-undo .
     1088     run cur-time in this-procedure
     1089       (output v-date
     1090       ,output v-time
     1091       ) .
     1092     return
     1093       p-prefix
     1094       + string(v-date, p-date-format)
     1095       + p-delimiter
     1096       + string(v-time, p-time-format)
     1097       + p-suffix
     1098       .
     1099   end.
     1100   function cur-time-print  returns character
     1101   :
     1102     define variable v-date as date      no-undo .
     1103     define variable v-time as integer   no-undo .
     1104     run cur-time in this-procedure
     1105       (output v-date
     1106       ,output v-time
     1107       ) .
     1108     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1109   end.
     1110   function cur-time-datetime returns datetime
     1111   :
     1112     define variable v-char as character no-undo .
     1113     define variable v-datetime as datetime no-undo .
     1114     v-char = cur-time-string().
     1115     v-datetime = datetime(v-char).
     1116     return  v-datetime.
     1117   end.
     1118   function cur-time-string-msec returns character
     1119   :
     1120     define variable v-date as datetime  no-undo .
     1121     v-date = now.
     1122     return string(v-date) .
     1123   end.
     1124   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
     1125   DEFINE VARIABLE v-db-num LIKE ub.db.db-num NO-UNDO.
     1126   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO.
     1127   DEFINE VARIABLE v-to-create AS logical NO-UNDO.
     1128   define variable v-tth as handle no-undo .
     1129   define variable v-t-shft as integer no-undo .
     1130   assign
     1131   v-tth = buffer thbjattr_thbj-attr:table-handle .
     1132   DEFINE BUTTON B-exit AUTO-GO
     1133        LABEL "&Ввод"
     1134        SIZE 10 BY 1
     1135        BGCOLOR 8 .
     1136   DEFINE BUTTON B-Help
     1137        LABEL "Помо&щь"
     1138        SIZE 3 BY 1
     1139        BGCOLOR 8 .
     1140   DEFINE BUTTON b-quit AUTO-END-KEY
     1141        LABEL "&Отмена"
     1142        SIZE 10 BY 1
     1143        BGCOLOR 8 .
     1144   DEFINE BUTTON r-cashier
     1145        IMAGE-UP FILE "btn-down-arrow":U
     1146        IMAGE-DOWN FILE "btn-down-arrow":U
     1147        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1148        LABEL "":L
     1149        SIZE 3 BY 1
     1150        BGCOLOR 8 FGCOLOR 0 .
     1151   DEFINE VARIABLE E-comments AS CHARACTER
     1152        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1153        SIZE 98 BY 1.93
     1154        FGCOLOR 4  NO-UNDO.
     1155   DEFINE VARIABLE cashier-psn-code-name AS CHARACTER FORMAT "X(256)":U
     1156        VIEW-AS FILL-IN
     1157        SIZE 25.5 BY 1 NO-UNDO.
     1158   DEFINE VARIABLE F-shift AS CHARACTER FORMAT "X(256)":U INITIAL "Способ обработки виртуальных смен"
     1159         VIEW-AS TEXT
     1160        SIZE 49.5 BY .67
     1161        FGCOLOR 4  NO-UNDO.
     1162   DEFINE VARIABLE l-loc-hour AS INTEGER FORMAT "99":U INITIAL 0
     1163        VIEW-AS FILL-IN
     1164        SIZE 3.3 BY 1 TOOLTIP "Стрелка вверх, вниз - изменение часа"
     1165        FGCOLOR 4  NO-UNDO.
     1166   DEFINE VARIABLE l-loc-min AS INTEGER FORMAT "99":U INITIAL 0
     1167        VIEW-AS FILL-IN
     1168        SIZE 3.3 BY 1 TOOLTIP "Стрелка вверх, вниз - изменение минут"
     1169        FGCOLOR 4  NO-UNDO.
     1170   DEFINE VARIABLE l-loc-sec AS INTEGER FORMAT "99":U INITIAL 0
     1171        VIEW-AS FILL-IN
     1172        SIZE 3.3 BY 1 TOOLTIP "Стрелка вверх, вниз - изменение секунд"
     1173        FGCOLOR 4  NO-UNDO.
     1174   DEFINE VARIABLE l-t-shift AS CHARACTER FORMAT "X(256)":U INITIAL "Время начала пересменки в магазине"
     1175         VIEW-AS TEXT
     1176        SIZE 35 BY .67 NO-UNDO.
     1177   DEFINE VARIABLE zero-cashier AS INTEGER FORMAT "99999" INITIAL 0
     1178        LABEL "<НУЛЕВОЙ> кассир"
     1179        VIEW-AS FILL-IN
     1180        SIZE 11.5 BY 1.07 NO-UNDO.
     1181   DEFINE VARIABLE RS-REJIM AS INTEGER
     1182        VIEW-AS RADIO-SET VERTICAL
     1183        RADIO-BUTTONS
     1184             "Нет вирт. смен", 0,
     1185   "Режим 1", 1,
     1186   "Режим 2", 2
     1187        SIZE 18 BY 2.77 NO-UNDO.
     1188   DEFINE VARIABLE RS-v-shft AS INTEGER
     1189        VIEW-AS RADIO-SET VERTICAL
     1190        RADIO-BUTTONS
     1191             "Нет вирт. смен", 0,
     1192   "Запрос оператору", 1,
     1193   "Дата учета чека определяется по чекам закрытия кассовых смен", 2
     1194        SIZE 70 BY 3
     1195        FGCOLOR 4  NO-UNDO.
     1196   DEFINE VARIABLE t-annu-check AS LOGICAL INITIAL no
     1197        LABEL "принимать аннулированные чеки"
     1198        VIEW-AS TOGGLE-BOX
     1199        SIZE 35.5 BY 1 NO-UNDO.
     1200   DEFINE VARIABLE t-card-by-mask AS LOGICAL INITIAL no
     1201        LABEL "использовать маски ДК при приеме чеков с касс для персонифицированных карт"
     1202        VIEW-AS TOGGLE-BOX
     1203        SIZE 94 BY 1 NO-UNDO.
     1204   DEFINE VARIABLE t-cas-curs AS LOGICAL INITIAL no
     1205        LABEL "брать курсы валют в чек из спула, а не из бэк-офиса"
     1206        VIEW-AS TOGGLE-BOX
     1207        SIZE 70 BY 1 NO-UNDO.
     1208   DEFINE VARIABLE t-cas-shft AS LOGICAL INITIAL no
     1209        LABEL "использовать смены на кассе"
     1210        VIEW-AS TOGGLE-BOX
     1211        SIZE 70 BY 1 NO-UNDO.
     1212   DEFINE VARIABLE t-dc-mask AS LOGICAL INITIAL no
     1213        LABEL "использовать маски ДК при приеме чеков с касс для неперсонифицированных карт"
     1214        VIEW-AS TOGGLE-BOX
     1215        SIZE 94 BY 1 NO-UNDO.
     1216   DEFINE VARIABLE t-hnum AS LOGICAL INITIAL no
     1217        LABEL "при обработке спулов номер магазина для чеков брать из спулов"
     1218        VIEW-AS TOGGLE-BOX
     1219        SIZE 70 BY 1 NO-UNDO.
     1220   DEFINE VARIABLE t-is-100-discnt AS LOGICAL INITIAL no
     1221        LABEL "принимать чеки со 100% скидкой"
     1222        VIEW-AS TOGGLE-BOX
     1223        SIZE 70 BY 1 NO-UNDO.
     1224   DEFINE VARIABLE T-next AS LOGICAL INITIAL no
     1225        LABEL "Сдвиг вперед"
     1226        VIEW-AS TOGGLE-BOX
     1227        SIZE 25 BY 1
     1228        FGCOLOR 4  NO-UNDO.
     1229   DEFINE VARIABLE t-no-get-chk AS LOGICAL INITIAL no
     1230        LABEL "НЕТ ПРИЕМА ЧЕКОВ В МАГАЗИНЕ"
     1231        VIEW-AS TOGGLE-BOX
     1232        SIZE 70 BY 1 NO-UNDO.
     1233   DEFINE VARIABLE t-ptrl-check AS LOGICAL INITIAL no
     1234        LABEL "принимать специф.чеки АЗК:сброс,перелив, перевод транз, техпролив"
     1235        VIEW-AS TOGGLE-BOX
     1236        SIZE 70 BY 1 NO-UNDO.
     1237   DEFINE VARIABLE t-z-check AS LOGICAL INITIAL no
     1238        LABEL "принимать чеки z-отчета"
     1239        VIEW-AS TOGGLE-BOX
     1240        SIZE 35.5 BY 1 NO-UNDO.
     1241   DEFINE FRAME Dialog-Frame
     1242        B-exit AT ROW 1 COL 1
     1243        b-quit AT ROW 1 COL 11
     1244        B-Help AT ROW 1 COL 95
     1245        t-no-get-chk AT ROW 2.13 COL 4
     1246        t-cas-curs AT ROW 3.13 COL 4
     1247        t-hnum AT ROW 4.13 COL 4
     1248        t-cas-shft AT ROW 5.13 COL 4
     1249        RS-REJIM AT ROW 7.37 COL 3 NO-LABEL
     1250        RS-v-shft AT ROW 7.37 COL 23 NO-LABEL
     1251        l-loc-hour AT ROW 10.87 COL 39 COLON-ALIGNED NO-LABEL
     1252        l-loc-min AT ROW 10.87 COL 44 COLON-ALIGNED NO-LABEL
     1253        l-loc-sec AT ROW 10.87 COL 49 COLON-ALIGNED NO-LABEL
     1254        T-next AT ROW 10.87 COL 56.5
     1255        E-comments AT ROW 12.13 COL 1 NO-LABEL
     1256        t-dc-mask AT ROW 14.6 COL 3.5
     1257        t-card-by-mask AT ROW 15.6 COL 3.5
     1258        t-ptrl-check AT ROW 16.6 COL 3.5
     1259        t-annu-check AT ROW 17.6 COL 3.5
     1260        t-z-check AT ROW 17.6 COL 41 WIDGET-ID 12
     1261        t-is-100-discnt AT ROW 18.6 COL 3.5 WIDGET-ID 2
     1262        zero-cashier AT ROW 19.93 COL 18.5 COLON-ALIGNED WIDGET-ID 10
     1263        cashier-psn-code-name AT ROW 20 COL 31.5 COLON-ALIGNED NO-LABEL WIDGET-ID 4
     1264        r-cashier AT ROW 20 COL 60 WIDGET-ID 6
     1265        F-shift AT ROW 6.37 COL 1.5 COLON-ALIGNED NO-LABEL
     1266        l-t-shift AT ROW 11.13 COL 2.5 NO-LABEL
     1267        "(аннулированные заказы РЕСТОРАНА)" VIEW-AS TEXT
     1268             SIZE 34 BY 1 AT ROW 20 COL 63.5 WIDGET-ID 8
     1269             FGCOLOR 4
     1270        SPACE(1.79) SKIP(0.12)
     1271       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1272            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1273            TITLE "Опции закачки чеков"
     1274            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     1275   ASSIGN
     1276          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1277          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1278   ASSIGN
     1279          cashier-psn-code-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1280   ASSIGN
     1281          l-loc-hour:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1282   ASSIGN
     1283          l-loc-min:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1284   ASSIGN
     1285          l-loc-sec:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1286   ASSIGN
     1287          RS-v-shft:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1288   ASSIGN
     1289          T-next:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1290   ASSIGN
     1291          zero-cashier:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1292   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1293   DO:
     1294     APPLY "END-ERROR":U TO SELF.
     1295   END.
     1296   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1297   DO:
     1298     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
     1299     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1300   END.
     1301   ON CURSOR-DOWN OF l-loc-hour IN FRAME Dialog-Frame
     1302   DO:
     1303     assign  frame Dialog-Frame l-loc-hour .
     1304     l-loc-hour = l-loc-hour -  1.
     1305     if l-loc-hour < 0 then return no-apply.
     1306     display l-loc-hour with frame Dialog-Frame.
     1307     assign
     1308     v-t-shft = 3600 * l-loc-hour + 60 * l-loc-min + l-loc-sec.
     1309   END.
     1310   ON CURSOR-UP OF l-loc-hour IN FRAME Dialog-Frame
     1311   DO:
     1312     assign  frame Dialog-Frame l-loc-hour .
     1313     l-loc-hour = l-loc-hour +  1.
     1314     if l-loc-hour > 24 then return no-apply.
     1315     display l-loc-hour with frame Dialog-Frame.
     1316     assign
     1317     v-t-shft = 3600 * l-loc-hour + 60 * l-loc-min + l-loc-sec.
     1318   END.
     1319   ON LEAVE OF l-loc-hour IN FRAME Dialog-Frame
     1320   DO:
     1321       assign frame Dialog-Frame l-loc-hour .
     1322      if l-loc-hour > 24 then do:
     1323      message "Часы должны быть   до 24 ! " .
     1324      return no-apply.
     1325      end.
     1326      if l-loc-hour < 0 then do:
     1327      message "Часы должны быть  от 0 до 24 ! " .
     1328      return no-apply.
     1329      end.
     1330     assign
     1331     v-t-shft = 3600 * l-loc-hour + 60 * l-loc-min + l-loc-sec.
     1332      RUN set-comments IN THIS-PROCEDURE.
     1333   END.
     1334   ON CURSOR-DOWN OF l-loc-min IN FRAME Dialog-Frame
     1335   DO:
     1336     assign  frame Dialog-Frame l-loc-min .
     1337     l-loc-min = l-loc-min -  1.
     1338     if l-loc-min < 0 then return no-apply.
     1339     display l-loc-min with frame Dialog-Frame.
     1340     assign
     1341     v-t-shft = 3600 * l-loc-hour + 60 * l-loc-min + l-loc-sec.
     1342   END.
     1343   ON CURSOR-UP OF l-loc-min IN FRAME Dialog-Frame
     1344   DO:
     1345      assign  frame Dialog-Frame l-loc-min .
     1346     l-loc-min = l-loc-min +  1.
     1347     if l-loc-min > 59 then return no-apply.
     1348     display l-loc-min with frame Dialog-Frame.
     1349     assign
     1350     v-t-shft = 3600 * l-loc-hour + 60 * l-loc-min + l-loc-sec.
     1351   END.
     1352   ON LEAVE OF l-loc-min IN FRAME Dialog-Frame
     1353   DO:
     1354      assign frame Dialog-Frame l-loc-min .
     1355      if l-loc-min > 59 then do:
     1356      message "Минуты должны быть  от 0 до 59 ! " .
     1357      return no-apply.
     1358      end.
     1359     assign
     1360     v-t-shft = 3600 * l-loc-hour + 60 * l-loc-min + l-loc-sec.
     1361   RUN set-comments IN THIS-PROCEDURE.
     1362   END.
     1363   ON CURSOR-DOWN OF l-loc-sec IN FRAME Dialog-Frame
     1364   DO:
     1365     assign  frame Dialog-Frame l-loc-sec .
     1366     l-loc-sec = l-loc-sec -  1.
     1367     if l-loc-sec < 0 then return no-apply.
     1368     display l-loc-sec with frame Dialog-Frame.
     1369     assign
     1370     v-t-shft = 3600 * l-loc-hour + 60 * l-loc-min + l-loc-sec.
     1371   END.
     1372   ON CURSOR-UP OF l-loc-sec IN FRAME Dialog-Frame
     1373   DO:
     1374      assign  frame Dialog-Frame l-loc-sec .
     1375     l-loc-sec = l-loc-sec +  1.
     1376     if l-loc-sec > 59 then return no-apply.
     1377     display l-loc-sec with frame Dialog-Frame.
     1378     assign
     1379     v-t-shft = 3600 * l-loc-hour + 60 * l-loc-min + l-loc-sec.
     1380   END.
     1381   ON LEAVE OF l-loc-sec IN FRAME Dialog-Frame
     1382   DO:
     1383      assign frame Dialog-Frame l-loc-sec .
     1384      if l-loc-sec > 59 then do:
     1385      message "Минуты должны быть  от 0 до 59 ! " .
     1386      return no-apply.
     1387      end.
     1388     assign
     1389     v-t-shft = 3600 * l-loc-hour + 60 * l-loc-min + l-loc-sec.
     1390   RUN set-comments IN THIS-PROCEDURE.
     1391   END.
     1392   ON CHOOSE OF r-cashier IN FRAME Dialog-Frame
     1393   DO:
     1394   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1395   DEFINE VARIABLE v-cashier-code AS integer NO-UNDO.
     1396   DEFINE BUFFER buf_staff FOR ub.staff.
     1397   run ref/staffs.w ( input parparentproc
     1398                       , input "b-sel"
     1399                       , input 'C':U
     1400                       , input v-db-num
     1401                       , input 0
     1402                       , output v-rid-list ) .
     1403   IF v-rid-list <> '':U THEN DO:
     1404      FIND FIRST buf_staff no-lock WHERE
     1405         recid( buf_staff ) = integer( v-rid-list )  .
     1406         v-cashier-code = buf_staff.staff-code .
     1407     run get-cashier in this-procedure ( input buf_staff.staff-code).
     1408   END.
     1409   DISPLAY
     1410   zero-cashier
     1411   cashier-psn-code-name
     1412   WITH FRAME Dialog-Frame.
     1413   END.
     1414   ON VALUE-CHANGED OF RS-REJIM IN FRAME Dialog-Frame
     1415   DO:
     1416     IF p-mode <> 'ПРОСМОТР':U  THEN
     1417     ASSIGN
     1418     rs-rejim.
     1419     CASE rs-rejim:
     1420       WHEN 0 THEN DO:
     1421         rs-v-shft = 0.
     1422         HIDE
     1423         rs-v-shft
     1424         IN FRAME Dialog-Frame.
     1425         if v-t-shft = 0 then do:
     1426            hide
     1427           l-t-shift
     1428           l-loc-hour
     1429           l-loc-min
     1430           l-loc-sec
     1431           t-next
     1432           IN FRAME Dialog-Frame.
     1433          end.
     1434       END.
     1435       WHEN 1 THEN DO:
     1436         rs-v-shft = 1.
     1437         DISPLAY
     1438         rs-v-shft
     1439         WITH FRAME Dialog-Frame.
     1440         HIDE
     1441         l-t-shift
     1442         l-loc-hour
     1443         l-loc-min
     1444         l-loc-sec
     1445         t-next
     1446         IN FRAME Dialog-Frame.
     1447       END.
     1448       WHEN 2 THEN DO:
     1449         rs-v-shft = 2.
     1450         t-next = YES.
     1451         DISPLAY
     1452         rs-v-shft
     1453         l-t-shift
     1454         l-loc-hour
     1455         l-loc-min
     1456         l-loc-sec
     1457         t-next
     1458         WITH FRAME Dialog-Frame.
     1459       END.
     1460     END CASE.
     1461     RUN set-comments IN THIS-PROCEDURE.
     1462   END.
     1463   ON VALUE-CHANGED OF RS-v-shft IN FRAME Dialog-Frame
     1464   DO:
     1465   IF p-mode = 'ПРОСМОТР':U  THEN RETURN NO-APPLY.
     1466   IF rs-v-shft:VISIBLE IN FRAME Dialog-Frame THEN DO:
     1467     ASSIGN rs-v-shft.
     1468   END.
     1469   ELSE DO:
     1470       rs-v-shft = 0.
     1471   END.
     1472   CASE RS-v-shft:
     1473       WHEN 2 THEN DO:
     1474          DISPLAY
     1475          l-loc-hour
     1476          l-loc-min
     1477          l-loc-sec
     1478          WITH FRAME Dialog-Frame.
     1479       END.
     1480       WHEN 0 OR WHEN 1 THEN DO:
     1481           ASSIGN
     1482           l-loc-hour = 0
     1483           l-loc-min = 0
     1484           l-loc-sec = 0
     1485           .
     1486           hide
     1487           l-loc-hour
     1488           l-loc-min
     1489           l-loc-sec
     1490           l-t-shift
     1491           IN  FRAME Dialog-Frame.
     1492       END.
     1493   END CASE.
     1494   RUN set-comments IN THIS-PROCEDURE .
     1495   END.
     1496   ON VALUE-CHANGED OF t-cas-shft IN FRAME Dialog-Frame
     1497   DO:
     1498   define variable v-old-t-cas-shft as logical no-undo .
     1499     IF p-mode = 'ПРОСМОТР':U  THEN RETURN NO-APPLY.
     1500     ASSIGN
     1501     v-old-t-cas-shft = t-cas-shft
     1502     t-cas-shft.
     1503     CASE t-cas-shft:
     1504     WHEN yes THEN DO:
     1505        ENABLE
     1506        RS-rejim
     1507        f-shift
     1508        WITH FRAME Dialog-Frame.
     1509        APPLY "VALUE-CHANGED" TO rs-v-shft.
     1510     END.
     1511     WHEN no THEN DO:
     1512       if v-old-t-cas-shft <> t-cas-shft then do:
     1513         ASSIGN
     1514         RS-rejim = 0
     1515         t-next = NO
     1516         .
     1517         disable
     1518         RS-rejim
     1519         t-next
     1520         WITH FRAME Dialog-Frame.
     1521         HIDE
     1522         t-next
     1523         rs-rejim
     1524         f-shift
     1525         rs-v-shft
     1526         IN FRAME  Dialog-Frame.
     1527       end.
     1528       DISPLAY
     1529       l-t-shift
     1530       l-loc-hour
     1531       l-loc-min
     1532       l-loc-sec
     1533       WITH FRAME Dialog-Frame.
     1534       RUN set-comments IN THIS-PROCEDURE.
     1535     END.
     1536   END CASE.
     1537   END.
     1538   ON VALUE-CHANGED OF T-next IN FRAME Dialog-Frame
     1539   DO:
     1540     ASSIGN
     1541     t-next.
     1542     CASE t-next:
     1543         WHEN NO THEN DO:
     1544            IF T-CAS-SHFT THEN DO:
     1545                ASSIGN
     1546                RS-V-SHFT = 1
     1547                .
     1548                DISPLAY
     1549                RS-V-SHFT
     1550                WITH FRAME Dialog-Frame.
     1551                DISABLE
     1552                RS-V-SHFT
     1553                WITH FRAME Dialog-Frame.
     1554            END.
     1555         END.
     1556         WHEN YES  THEN DO:
     1557             ASSIGN
     1558             rs-v-shft = 1
     1559             T-CAS-SHFT = YES
     1560             .
     1561             DISPLAY
     1562             rs-v-shft
     1563             T-CAS-SHFT
     1564             WITH FRAME Dialog-Frame.
     1565             DISABLE
     1566             rs-v-shft
     1567             T-CAS-SHFT
     1568             WITH FRAME Dialog-Frame.
     1569         END.
     1570     END CASE.
     1571     RUN set-comments IN THIS-PROCEDURE.
     1572   END.
     1573   ON VALUE-CHANGED OF t-no-get-chk IN FRAME Dialog-Frame
     1574   DO:
     1575       ASSIGN
     1576     t-no-get-chk.
     1577     CASE t-no-get-chk:
     1578         WHEN YES  THEN DO:
     1579            rs-rejim = 0.
     1580            APPLY "value-changed" TO t-cas-shft.
     1581            APPLY "value-changed" TO rs-rejim.
     1582            run set-comments in this-procedure .
     1583            DISABLE
     1584            RS-v-shft
     1585            t-annu-check
     1586            t-z-check
     1587            t-card-by-mask
     1588            t-cas-curs
     1589            t-cas-shft
     1590            t-dc-mask
     1591            t-hnum
     1592            T-next
     1593            t-ptrl-check
     1594            t-is-100-discnt
     1595            WITH FRAME Dialog-Frame.
     1596         END.
     1597         WHEN NO  THEN DO:
     1598            RUN myenable IN THIS-PROCEDURE.
     1599         END.
     1600     END CASE.
     1601   END.
     1602   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1603   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1604   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1605   on help of frame Dialog-Frame
     1606   do:
     1607     run gbl/app_help.p
     1608       (input this-procedure :file-name
     1609       ,input ''
     1610       ,input ?
     1611       ) no-error.
     1612     if error-status :error then do:
     1613       message
     1614         "Ошибка при вызове помощи"
     1615         error-status :get-message(1)
     1616         view-as alert-box .
     1617     end.
     1618   end.
     1619   run minbtn-set in this-procedure .
     1620   on choose of b-help in frame Dialog-Frame
     1621   do:
     1622     apply "help":u to frame Dialog-Frame .
     1623   end.
     1624   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1625   procedure minbtn-set :
     1626       do
     1627           on error undo, return error return-value
     1628           :
     1629           define variable ii              as integer       no-undo .
     1630           define variable fh              as widget-handle no-undo .
     1631           define variable hh              as widget-handle no-undo .
     1632           define variable v-h             as handle        extent 4 no-undo .
     1633           define variable v-name-button   as character     no-undo .
     1634           define variable v-help-old-x    as decimal       no-undo .
     1635           define variable v-help-old-y    as decimal       no-undo .
     1636           define variable v-help-old-size as decimal       no-undo .
     1637           define variable v-frame-width   as decimal       no-undo .
     1638           define variable jj              as integer       no-undo .
     1639           do
     1640               on error undo, return error
     1641               :
     1642               assign
     1643                   v-frame-width = frame Dialog-Frame:width - 0.3
     1644                   fh            = frame Dialog-Frame:first-child
     1645                   hh            = fh:first-child
     1646                   ii            = 1
     1647                   .
     1648               do while valid-handle(hh):
     1649                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1650                   do:
     1651                       case lc(hh:name) :
     1652                           when "b-help" then
     1653                               do:
     1654                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1655                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1656                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1657                                   hh:TOOLTIP = "Помощь" .
     1658                                   v-help-old-x = hh:column .
     1659                                   v-help-old-y = hh:row    .
     1660                                   v-help-old-size = hh:width .
     1661                                   hh:width-chars = 2.5 .
     1662                               end.
     1663                           when "b-print" then
     1664                               do:
     1665                                   hh:load-image("cmp/b-print.bmp":u) .
     1666                                   hh:TOOLTIP = "Печать" .
     1667                                   v-h[ii] = hh:handle .
     1668                                   ii = ii + 1 .
     1669                                   hh:width-chars = 3 .
     1670                               end.
     1671                           when "b-history" or
     1672                           when "b-hist" then
     1673                               do:
     1674                                   hh:load-image("cmp/b-hist.bmp":u) .
     1675                                   hh:TOOLTIP = "История" .
     1676                                   v-h[ii] = hh:handle .
     1677                                   ii = ii + 1 .
     1678                                   hh:width-chars = 3 .
     1679                               end.
     1680                           when "b-sch" then
     1681                               do:
     1682                                   hh:load-image("cmp/b-sch.bmp":u) .
     1683                                   hh:TOOLTIP = "Установка Фильтра" .
     1684                                   v-h[ii] = hh:handle .
     1685                                   ii = ii + 1 .
     1686                                   hh:width-chars = 3 .
     1687                               end.
     1688                           when "b-hist-user" then
     1689                               do:
     1690                                   hh:load-image("cmp/b-hist.bmp":u) .
     1691                                   hh:TOOLTIP = "История пользователя" .
     1692                                   ii = ii + 1 .
     1693                               end.
     1694                       end case.
     1695                   end.
     1696                   hh = hh:next-sibling.
     1697               end.
     1698               b-help:column = v-frame-width - b-help:width-chars.
     1699               jj = 0.
     1700               repeat ii = 4 to 1 by -1 :
     1701                   if valid-handle (v-h[ii] ) then
     1702                   do:
     1703                       jj  = jj + 1 .
     1704                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1705                       v-h[ii]:row    = v-help-old-y .
     1706                   end.
     1707               end.
     1708           end.
     1709       end.
     1710   end procedure.
     1711   MAIN-BLOCK:
     1712   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1713      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1714   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1715     run mainmenu_getcntxt in parparentproc
     1716       (output v-cntxt-db-num
     1717       ,output v-cntxt-userid
     1718       ,output v-cntxt-level
     1719       ,output v-cntxt-host-code-obj
     1720       ,output v-cntxt-obj-type
     1721       ,output v-cntxt-obj-code
     1722       ,output v-cntxt-db-num-obj
     1723       ,output v-cntxt-is-admin
     1724       ) .
     1725   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1726   ON TAB ANYWHERE
     1727   DO:
     1728   define variable ii as integer no-undo .
     1729   define variable fh as widget-handle no-undo .
     1730   define variable hh as widget-handle no-undo .
     1731   define variable v-next-widget-name as character no-undo .
     1732   if v-tab-order <> '' then do:
     1733     if self:type = "TOGGLE-BOX" then
     1734     self:BGCOLOR = ?.
     1735     assign
     1736     ii = lookup(self:name, v-tab-order).
     1737     assign
     1738     ii = ii + 1
     1739     v-next-widget-name = entry(ii, v-tab-order)
     1740     no-error .
     1741     if error-status:error then do:
     1742       assign
     1743       ii = 1
     1744       v-next-widget-name = entry( ii, v-tab-order)
     1745       .
     1746     end.
     1747     assign
     1748     fh = frame Dialog-Frame:first-child
     1749     hh = fh:first-child
     1750     .
     1751     do while valid-handle(hh):
     1752       if hh:name = v-next-widget-name then do:
     1753         if hh:sensitive  = yes
     1754         AND hh:visible = yes then do:
     1755           if hh:type = "TOGGLE-BOX":U then do:
     1756             assign
     1757             hh:BGcolor = 1
     1758             .
     1759           end.
     1760           APPLY "ENTRY" to hh.
     1761           return no-apply.
     1762         end.
     1763         else do:
     1764           APPLY "TAB" to hh.
     1765           return no-apply.
     1766         end.
     1767       end.
     1768       hh = hh:next-sibling.
     1769     end.
     1770   end.
     1771   END.
     1772   ON BACK-TAB ANYWHERE
     1773   DO:
     1774   define variable ii as integer no-undo .
     1775   define variable fh as widget-handle no-undo .
     1776   define variable hh as widget-handle no-undo .
     1777   define variable v-next-widget-name as character no-undo .
     1778   if v-tab-order <> '' then do:
     1779     assign
     1780     ii = lookup(self:name, v-tab-order).
     1781     .
     1782     assign
     1783     ii = (if ii = 1
     1784           then  num-entries(v-tab-order)
     1785           else ii - 1
     1786           )
     1787     v-next-widget-name = entry(ii, v-tab-order)
     1788     .
     1789     assign
     1790     fh = frame Dialog-Frame:first-child
     1791     hh = fh:first-child
     1792     .
     1793     do while valid-handle(hh):
     1794       if hh:name = v-next-widget-name then do:
     1795         if hh:sensitive  = yes
     1796         AND hh:visible = yes then do:
     1797           if hh:type = "TOGGLE-BOX":U then do:
     1798             assign
     1799             hh:BGcolor = 1
     1800             .
     1801           end.
     1802           APPLY "ENTRY" to hh.
     1803           return no-apply.
     1804         end.
     1805         else do:
     1806         APPLY "BACK-TAB" to hh.
     1807         return no-apply.
     1808         end.
     1809       end.
     1810       hh = hh:next-sibling.
     1811     end.
     1812     end.
     1813   END.
     1814   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1815   ON RETURN ANYWHERE
     1816   DO:
     1817   define variable ii as integer no-undo .
     1818   define variable fh as widget-handle no-undo .
     1819   define variable hh as widget-handle no-undo .
     1820   define variable v-next-widget-name as character no-undo .
     1821     if v-tab-order <> '' then do:
     1822       assign
     1823       ii = lookup(self:name, v-tab-order).
     1824       if ii = num-entries(v-tab-order) then do:
     1825           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     1826           return no-apply.
     1827       end.
     1828       if self:type <> "BUTTON" and
     1829         self:type <> "EDITOR"  then do:
     1830         run proc-move-forward in this-procedure .
     1831         return no-apply.
     1832       end.
     1833       if self:type = "BUTTON" then do:
     1834         APPLY "CHOOSE" to self.
     1835       end.
     1836       if self:type = "TOGGLE-BOX" then
     1837       self:BGCOLOR = ?.
     1838       assign
     1839       ii = ii + 1
     1840       v-next-widget-name = entry(ii, v-tab-order)
     1841       no-error .
     1842       if error-status:error then do:
     1843         assign
     1844         ii = 1
     1845         v-next-widget-name = entry( ii, v-tab-order)
     1846         .
     1847       end.
     1848       assign
     1849       fh = frame Dialog-Frame:first-child
     1850       hh = fh:first-child
     1851       .
     1852       do while valid-handle(hh):
     1853         if hh:name = v-next-widget-name then do:
     1854           if hh:sensitive  = yes
     1855           AND hh:visible = yes then do:
     1856             if hh:type = "TOGGLE-BOX":U then do:
     1857               assign
     1858               hh:BGcolor = 1
     1859               .
     1860             end.
     1861             APPLY "ENTRY" to hh.
     1862             return no-apply.
     1863           end.
     1864           else do:
     1865             APPLY "TAB" to hh.
     1866             return no-apply.
     1867           end.
     1868         end.
     1869         hh = hh:next-sibling.
     1870       end.
     1871     end.
     1872   END.
     1873   procedure proc-move-forward :
     1874   define variable ii as integer no-undo .
     1875   define variable fh as widget-handle no-undo .
     1876   define variable hh as widget-handle no-undo .
     1877   define variable v-next-widget-name as character no-undo .
     1878   do
     1879   on error undo, return error
     1880   :
     1881     if v-tab-order <> '' then do:
     1882       if self:type = "TOGGLE-BOX" then
     1883       self:BGCOLOR = ?.
     1884       assign
     1885       ii = lookup(self:name, v-tab-order).
     1886       assign
     1887       ii = ii + 1
     1888       v-next-widget-name = entry(ii, v-tab-order)
     1889       no-error .
     1890       if error-status:error then do:
     1891         assign
     1892         ii = 1
     1893         v-next-widget-name = entry( ii, v-tab-order)
     1894         .
     1895       end.
     1896       assign
     1897       fh = frame Dialog-Frame:first-child
     1898       hh = fh:first-child
     1899       .
     1900       do while valid-handle(hh):
     1901         if hh:name = v-next-widget-name then do:
     1902           if hh:sensitive  = yes
     1903           AND hh:visible = yes then do:
     1904             if hh:type = "TOGGLE-BOX":U then do:
     1905               assign
     1906               hh:BGcolor = 1
     1907               .
     1908             end.
     1909             APPLY "ENTRY" to hh.
     1910             return.
     1911           end.
     1912           else do:
     1913             assign
     1914             ii = ii + 1
     1915             v-next-widget-name = entry(ii, v-tab-order)
     1916             no-error .
     1917             if error-status:error then do:
     1918               assign
     1919               ii = 1
     1920               v-next-widget-name = entry( ii, v-tab-order)
     1921               .
     1922             end.
     1923           end.
     1924         end.
     1925         hh = hh:next-sibling.
     1926       end.
     1927     end.
     1928   end.
     1929   end procedure.
     1930     IF p-mode <> 'ПРОСМОТР':U
     1931     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     1932         MESSAGE
     1933         vss-workfile vss-revision vss-description skip
     1934         "Неверное значение параметра p-mode" p-mode
     1935         VIEW-AS ALERT-BOX ERROR.
     1936         UNDO, RETURN ERROR.
     1937     END.
     1938     IF p-obj-type <> 'маг':U
     1939     and p-obj-type <> 'орг':U
     1940     and p-obj-type <> '':U
     1941     THEN DO:
     1942         MESSAGE
     1943         vss-workfile vss-revision vss-description skip
     1944         "Неверное значение параметра p-obj-type" p-obj-type
     1945         VIEW-AS ALERT-BOX ERROR.
     1946         UNDO, RETURN ERROR.
     1947     END.
     1948     if p-obj-type = 'маг':U then do:
     1949       FIND FIRST X_shop NO-LOCK WHERE X_shop.obj-code = p-obj-code NO-ERROR.
     1950       IF NOT AVAILABLE X_shop THEN DO:
     1951           MESSAGE
     1952           vss-workfile vss-revision vss-description skip
     1953           "Неверное значение параметра p-obj-code" p-obj-code
     1954           VIEW-AS ALERT-BOX ERROR.
     1955           UNDO, RETURN ERROR.
     1956       END.
     1957   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1958   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1959     (input  'маг':U
     1960     ,input  p-obj-code
     1961     ,output v-db-num
     1962     )  .
     1963       IF v-db-num <> v-cntxt-db-num
     1964       AND v-cntxt-db-num <> 0
     1965       and p-mode <> 'ПРОСМОТР':U
     1966       THEN DO:
     1967           MESSAGE
     1968           "Нельзя менять параметры магазина в чужой БД" skip
     1969           "магазин принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     1970           VIEW-AS ALERT-BOX ERROR.
     1971           UNDO, RETURN ERROR.
     1972       END.
     1973     end.
     1974     if p-obj-type = 'орг':U then do:
     1975       FIND FIRST X_sysconf NO-LOCK WHERE X_sysconf.host-code = p-obj-code NO-ERROR.
     1976       IF NOT AVAILABLE X_sysconf THEN DO:
     1977           MESSAGE
     1978           vss-workfile vss-revision vss-description skip
     1979           "Неверное значение параметра p-obj-code" p-obj-code
     1980           VIEW-AS ALERT-BOX ERROR.
     1981           UNDO, RETURN ERROR.
     1982       END.
     1983       if v-cntxt-db-num <> 0
     1984       and p-mode <> 'ПРОСМОТР':U
     1985       then do:
     1986           MESSAGE
     1987           "Нельзя менять параметры ФИРМЫ в УБД" skip
     1988           VIEW-AS ALERT-BOX ERROR.
     1989           UNDO, RETURN ERROR.
     1990       end.
     1991     end.
     1992     if p-obj-type = '':U then do:
     1993       if v-cntxt-db-num <> 0
     1994       and p-mode <> 'ПРОСМОТР':U
     1995       then do:
     1996           MESSAGE
     1997           "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" skip
     1998           VIEW-AS ALERT-BOX ERROR.
     1999           UNDO, RETURN ERROR.
     2000       end.
     2001     end.
     2002     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     2003       FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
     2004                 LOCKED_thbj-attr.obj-type = p-obj-type
     2005           AND   LOCKED_thbj-attr.obj-code = p-obj-code
     2006           AND   LOCKED_thbj-attr.upper-prop-code = 'get-chk':U
     2007           and locked_thbj-attr.prop-code = '':U NO-WAIT NO-ERROR.
     2008        if locked locked_thbj-attr then do:
     2009           message
     2010           vss-workfile vss-revision vss-description skip
     2011            "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
     2012           view-as alert-box error .
     2013           undo, return error.
     2014         end.
     2015     END.
     2016     ELSE DO:
     2017         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
     2018             LOCKED_thbj-attr.obj-type = p-obj-type
     2019       AND   LOCKED_thbj-attr.obj-code = p-obj-code
     2020       AND   LOCKED_thbj-attr.upper-prop-code = 'get-chk':U
     2021       and   locked_thbj-attr.prop-code = '':U NO-ERROR.
     2022     END.
     2023     if not available locked_thbj-attr then do:
     2024       ASSIGN
     2025       v-to-create  = YES.
     2026       message
     2027       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     2028                   chr(10))
     2029       view-as alert-box WARNING.
     2030     end.
     2031     RUN FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     2032     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     2033     RUN Myenable in this-procedure .
     2034     WAIT-FOR GO OF FRAME Dialog-Frame.
     2035   END.
     2036   RUN disable_UI.
     2037   PROCEDURE disable_UI :
     2038     HIDE FRAME Dialog-Frame.
     2039   END PROCEDURE.
     2040   PROCEDURE enable_UI :
     2041     DISPLAY t-no-get-chk t-cas-curs t-hnum t-cas-shft RS-REJIM RS-v-shft
     2042             l-loc-hour l-loc-min l-loc-sec T-next E-comments t-dc-mask
     2043             t-card-by-mask t-ptrl-check t-annu-check t-z-check t-is-100-discnt
     2044             zero-cashier cashier-psn-code-name F-shift l-t-shift
     2045         WITH FRAME Dialog-Frame.
     2046     ENABLE B-exit b-quit B-Help t-no-get-chk t-cas-curs t-hnum t-cas-shft
     2047            RS-REJIM l-loc-hour l-loc-min l-loc-sec t-dc-mask t-card-by-mask
     2048            t-ptrl-check t-annu-check t-z-check t-is-100-discnt r-cashier F-shift
     2049            l-t-shift
     2050         WITH FRAME Dialog-Frame.
     2051     VIEW FRAME Dialog-Frame.
     2052   END PROCEDURE.
     2053   PROCEDURE fill-widgets :
     2054   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     2055   DEFINE VARIABLE v-entry AS CHARACTER NO-UNDO.
     2056   DEFINE VARIABLE v-dop-time AS CHARACTER NO-UNDO.
     2057   define variable v-param-type as character no-undo .
     2058   define variable v-value-character as character no-undo .
     2059   define variable v-value-date as date no-undo .
     2060   define variable v-value-decimal as decimal no-undo .
     2061   define variable v-value-integer as INTEGER no-undo .
     2062   define variable v-value-logical AS LOGICAL no-undo .
     2063   FOR EACH thbjattr_thbj-attr:
     2064     delete thbjattr_thbj-attr.
     2065   end.
     2066   FOR EACH temp-thbj-attr:
     2067     delete temp-thbj-attr.
     2068   end.
     2069   run adm/shattri.p (
     2070                 input "init":U
     2071               , input p-obj-type
     2072               , input p-obj-code
     2073               , input 'get-chk':U
     2074               , input "":U
     2075               , output v-value-character
     2076               , output v-value-date
     2077               , output v-value-decimal
     2078               , output v-value-integer
     2079               , output v-value-logical
     2080               , output v-param-type
     2081               , INPUT-OUTPUT TABLE-handle v-tth
     2082               ) no-error .
     2083   if error-status:error
     2084   and not available locked_thbj-attr then do:
     2085     message
     2086     "Не удалось получить начальные значения настроек" skip
     2087     error-status:get-message(1) return-value
     2088     view-as alert-box error .
     2089     undo, return error .
     2090   end.
     2091   FOR EACH thbjattr_thbj-attr:
     2092     ASSIGN
     2093     v-entry = thbjattr_thbj-attr.prop-code.
     2094     IF v-entry = 'cas-curs':U THEN DO:
     2095       ASSIGN
     2096       t-cas-curs = thbjattr_thbj-attr.property-value-logical
     2097       t-cas-curs:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2098       .
     2099     END.
     2100     IF v-entry = 'hnum':U THEN DO:
     2101       ASSIGN
     2102       t-hnum = thbjattr_thbj-attr.property-value-logical
     2103       t-hnum:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2104       .
     2105     END.
     2106     IF v-entry = 'cas-shft':U THEN DO:
     2107       ASSIGN
     2108       t-cas-shft = thbjattr_thbj-attr.property-value-logical
     2109       t-cas-shft:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2110       .
     2111     END.
     2112     IF v-entry = 'v-shft':U THEN DO:
     2113       ASSIGN
     2114       RS-v-shft = thbjattr_thbj-attr.property-value-integer
     2115       rs-v-shft:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2116       .
     2117     END.
     2118     IF v-entry = 't-shft':U THEN DO:
     2119       ASSIGN
     2120       t-next  = thbjattr_thbj-attr.property-value-integer < 0
     2121       v-t-shft = abs(thbjattr_thbj-attr.property-value-integer)
     2122       v-dop-time = string(v-t-shft, "hh:mm:ss")
     2123       l-loc-hour = integer(SUBSTRING(v-dop-time, 1, 2))
     2124       l-loc-min = integer(SUBSTRING(v-dop-time, 4, 2))
     2125       l-loc-sec = integer(SUBSTRING(v-dop-time, 7, 2))
     2126       .
     2127     END.
     2128     IF v-entry = 'dc-mask':U THEN DO:
     2129       ASSIGN
     2130       t-dc-mask = thbjattr_thbj-attr.property-value-logical
     2131       t-dc-mask:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2132       .
     2133     END.
     2134     IF v-entry = 'ptrl-check':U THEN DO:
     2135       ASSIGN
     2136       t-ptrl-check = thbjattr_thbj-attr.property-value-logical
     2137       t-ptrl-check:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2138       .
     2139     END.
     2140     IF v-entry = 'card-by-mask':U THEN DO:
     2141       ASSIGN
     2142       t-card-by-mask = thbjattr_thbj-attr.property-value-logical
     2143       t-card-by-mask:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2144       .
     2145     END.
     2146     IF v-entry = 'annu-check':U THEN DO:
     2147       ASSIGN
     2148       t-annu-check = thbjattr_thbj-attr.property-value-logical.
     2149       t-annu-check:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2150       .
     2151     END.
     2152     IF v-entry = 'z-check':U THEN DO:
     2153       ASSIGN
     2154       t-z-check = thbjattr_thbj-attr.property-value-logical.
     2155       t-z-check:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2156       .
     2157     END.
     2158     IF v-entry = 'no-get-chk':U THEN DO:
     2159       ASSIGN
     2160       t-no-get-chk = thbjattr_thbj-attr.property-value-logical
     2161       t-no-get-chk:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2162       .
     2163     END.
     2164     IF v-entry = 'is-100-discnt':U THEN DO:
     2165       ASSIGN
     2166       t-is-100-discnt = thbjattr_thbj-attr.property-value-logical
     2167       t-is-100-discnt:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2168       .
     2169     END.
     2170     IF v-entry = 'zero-cashier':U THEN DO:
     2171       ASSIGN
     2172       zero-cashier = thbjattr_thbj-attr.property-value-integer
     2173       zero-cashier:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2174       .
     2175     END.
     2176     create temp-thbj-attr.
     2177     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     2178   END.
     2179   assign
     2180   rs-rejim = (if t-cas-shft then rs-v-shft else 0).
     2181   END PROCEDURE.
     2182   PROCEDURE get-cashier :
     2183   DEFINE INPUT PARAMETER p-cashier-code AS INTEGER NO-UNDO.
     2184   DEFINE VARIABLE v-cashier-psn-code AS integer NO-UNDO.
     2185   DEFINE VARIABLE v-today as date no-undo .
     2186   DEFINE VARIABLE v-time as integer no-undo .
     2187   define buffer buf_clients for ub.clients.
     2188   run cur-time in this-procedure ( output v-today, output v-time).
     2189      assign
     2190      v-cashier-psn-code = gbclcode-is-this-db-role( INPUT 'C':U
     2191                                                    ,INPUT v-db-num
     2192                                                    ,INPUT p-cashier-code
     2193                                                    ,input v-today
     2194                                                    ) NO-ERROR.
     2195      IF NOT ERROR-STATUS:ERROR THEN DO:
     2196        FIND FIRST buf_clients NO-LOCK WHERE
     2197                   buf_clients.obj-type = 'чел':U
     2198               AND buf_clients.obj-code = v-cashier-psn-code NO-ERROR.
     2199        IF AVAILABLE buf_clients THEN DO:
     2200            ASSIGN
     2201             cashier-psn-code-name = buf_Clients.obj-name
     2202            zero-cashier = p-cashier-code
     2203            .
     2204        END.
     2205        ELSE DO:
     2206         if p-cashier-code > 0 then do:
     2207         MESSAGE
     2208         "Ошибка при определении кассира"
     2209         VIEW-AS ALERT-BOX.
     2210         end.
     2211        END.
     2212      END.
     2213      ELSE DO:
     2214       if p-cashier-code > 0 then do:
     2215         MESSAGE
     2216         "Ошибка при определении кассира"
     2217         VIEW-AS ALERT-BOX.
     2218       end.
     2219     END.
     2220   END PROCEDURE.
     2221   PROCEDURE MyEnable :
     2222   ASSIGN
     2223   FRAME Dialog-Frame:TITLE = FRAME Dialog-Frame:TITLE + (if p-obj-type = 'орг':U then " фирма" else " маг") + STRING(p-obj-code)
     2224   v-tab-order = "t-no-get-chk,t-cas-curs,t-hnum,t-cas-shft,RS-rejim,l-loc-hour,l-loc-min,l-loc-sec,t-split-check,t-dc-mask,t-card-by-mask,t-ptrl-check,t-annu-check,t-z-check,t-is-100-discnt,r-cashier"
     2225   .
     2226   RUN get-cashier in this-procedure ( input zero-cashier) .
     2227   DISPLAY
     2228   t-no-get-chk
     2229   rs-rejim
     2230   t-cas-curs
     2231   t-hnum
     2232   t-cas-shft
     2233   E-comments
     2234   t-dc-mask
     2235   t-card-by-mask
     2236   t-ptrl-check
     2237   t-annu-check
     2238   t-z-check
     2239   t-is-100-discnt
     2240   zero-cashier
     2241   cashier-psn-code-name
     2242   WITH FRAME Dialog-Frame.
     2243   ENABLE
     2244   B-exit WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2245   b-quit
     2246   B-Help
     2247   t-no-get-chk WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2248   t-cas-curs WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2249   t-hnum WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2250   t-cas-shft WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2251   t-dc-mask WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2252   t-card-by-mask WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2253   t-ptrl-check WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2254   t-annu-check WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2255   t-z-check WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2256   l-loc-hour WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2257   l-loc-sec WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2258   l-loc-min WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2259   t-next WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2260   t-is-100-discnt WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2261   r-cashier WHEN p-mode = 'ИЗМЕНЕНИЕ':U and p-obj-type = 'маг':U
     2262   WITH FRAME Dialog-Frame.
     2263   if rs-rejim = 0 then do:
     2264     HIDE
     2265     rs-v-shft
     2266     in frame Dialog-Frame .
     2267   end.
     2268   if v-t-shft = 0 then do:
     2269     hide
     2270     l-loc-hour
     2271     l-loc-sec
     2272     l-loc-min
     2273     t-next
     2274     in FRAME Dialog-Frame.
     2275   end.
     2276   else do:
     2277     display
     2278     l-loc-hour
     2279     l-loc-sec
     2280     l-loc-min
     2281     t-next
     2282     with FRAME Dialog-Frame.
     2283   end.
     2284   VIEW FRAME Dialog-Frame.
     2285   IF p-mode = 'ПРОСМОТР':U THEN DO:
     2286     HIDE
     2287     b-exit
     2288     IN FRAME Dialog-Frame.
     2289     ASSIGN
     2290     b-quit:LABEL = "&Выход"
     2291     .
     2292   END.
     2293   APPLY "value-changed" TO t-cas-shft.
     2294   APPLY "value-changed" TO rs-rejim.
     2295   run set-comments in this-procedure .
     2296   IF t-no-get-chk = YES THEN DO:
     2297     APPLY "value-changed" TO t-no-get-chk.
     2298   END .
     2299   END PROCEDURE.
     2300   PROCEDURE proc-save :
     2301   define variable v-value-character as character no-undo .
     2302   define variable v-value-date as date no-undo .
     2303   define variable v-value-decimal as decimal no-undo .
     2304   define variable v-value-integer as INTEGER no-undo .
     2305   define variable v-value-logical AS LOGICAL no-undo .
     2306   define variable v-param-type as character no-undo .
     2307   define variable wh as widget-handle no-undo .
     2308   define variable fh as widget-handle no-undo .
     2309   define variable v-same as logical no-undo .
     2310   DEFINE VARIABLE l-shift-on AS LOGICAL NO-UNDO.
     2311   DEFINE VARIABLE v-t-shft AS integer NO-UNDO.
     2312   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     2313   ASSIGN
     2314   FRAME Dialog-Frame
     2315   t-no-get-chk
     2316   t-cas-curs
     2317   t-cas-shft
     2318   t-hnum
     2319   t-dc-mask
     2320   t-ptrl-check
     2321   t-card-by-mask
     2322   t-annu-check
     2323   t-z-check
     2324   t-is-100-discnt
     2325   zero-cashier
     2326   .
     2327   IF RS-v-shft:SENSITIVE THEN DO:
     2328       ASSIGN
     2329       rs-v-shft.
     2330   END.
     2331   IF l-loc-hour:SENSITIVE THEN DO:
     2332       ASSIGN
     2333       l-loc-hour l-loc-min l-loc-sec.
     2334       v-t-shft = (l-loc-hour * 3600 + l-loc-min * 60 + l-loc-sec).
     2335   END.
     2336   IF p-obj-type = 'маг':U THEN DO:
     2337   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2338   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2339     (input  'маг':U
     2340     ,input  p-obj-code
     2341     ,input  'shift-on=request'
     2342     ,output l-shift-on
     2343     )  .
     2344     if l-shift-on and not t-cas-shft then do:
     2345        message "На текущем объекте требуется использование смен" skip
     2346        "а настройка СМЕНЫ НА КАССЕ выключена - это недопустимо." skip (2)
     2347       view-as alert-box ERROR.
     2348       undo, return ERROR.
     2349     end.
     2350     IF l-shift-on AND v-t-shft <> 0 THEN DO:
     2351         message
     2352         "На текущем объекте требуется использование смен,"
     2353         "а настройка ВРЕМЯ ПЕРЕСМЕНКИ включена - это недопустимо." skip (2)
     2354         view-as alert-box ERROR.
     2355         undo, return ERROR.
     2356     END.
     2357   END.
     2358   assign
     2359   fh = frame Dialog-Frame:first-child
     2360   wh = fh:first-child
     2361   .
     2362   do while valid-handle(wh):
     2363     if wh:private-data begins "recid=" then do:
     2364       find first thbjattr_thbj-attr where
     2365                 recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     2366       if wh:sensitive
     2367       or wh:name = "zero-cashier"
     2368       then do:
     2369         assign
     2370         buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     2371       end.
     2372     end.
     2373     wh = wh:next-sibling.
     2374   end.
     2375   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 't-shft':U.
     2376   assign
     2377   thbjattr_thbj-attr.property-value-integer = (IF t-cas-shft THEN 1 ELSE (-1)) * v-t-shft
     2378   .
     2379   release thbjattr_thbj-attr.
     2380   v-same = yes.
     2381   for each thbjattr_thbj-attr,
     2382       first temp-thbj-attr where
     2383             temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     2384         and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     2385         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     2386         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code:
     2387      buffer-compare
     2388      thbjattr_thbj-attr
     2389      to temp-thbj-attr
     2390      save result in v-same.
     2391      if v-same = no then leave.
     2392   end.
     2393   v-same = no.
     2394   IF v-same  and not v-to-create THEN RETURN.
     2395   run adm/shattri.p (
     2396                 input "check":U
     2397                , input p-obj-type
     2398                , input p-obj-code
     2399                , input 'get-chk':U
     2400                , INPUT '':U
     2401                , output v-value-character
     2402                , output v-value-date
     2403                , output v-value-decimal
     2404                , output v-value-integer
     2405                , output v-value-logical
     2406                , output v-param-type
     2407                , input-output TABLE-handle v-tth
     2408               ) no-error .
     2409   if error-status:error then do:
     2410     message
     2411     "Некорректное значение ПАРАМЕТРОВ" skip
     2412     error-status:get-message(1) skip
     2413     return-value
     2414     view-as alert-box error .
     2415     undo, return error .
     2416   end.
     2417   RUN thbjattr_set-section IN THIS-PROCEDURE (
     2418        input p-obj-type
     2419       ,input p-obj-code
     2420       ,input 'get-chk':U
     2421       ,input table thbjattr_thbj-attr
     2422   ) NO-ERROR.
     2423   IF ERROR-STATUS:error THEN do:
     2424     MESSAGE ERROR-STATUS:get-message(1) SKIP
     2425     RETURN-VALUE
     2426     VIEW-AS ALERT-BOX.
     2427     UNDO, RETURN ERROR.
     2428   END.
     2429   END PROCEDURE.
     2430   PROCEDURE set-comments :
     2431   DEFINE VARIABLE v-t-shft AS INTEGER NO-UNDO.
     2432   DEFINE VARIABLE v-str AS character NO-UNDO.
     2433   IF l-loc-hour:VISIBLE IN FRAME Dialog-Frame THEN DO:
     2434       ASSIGN
     2435       FRAME Dialog-Frame
     2436       l-loc-hour l-loc-min l-loc-sec.
     2437       ASSIGN
     2438       v-t-shft = l-loc-hour * 3600 + l-loc-min * 60 + l-loc-sec.
     2439       IF NOT t-next THEN DO:
     2440          ASSIGN
     2441          v-str = SUBSTITUTE("Чеки, пробитые до &1 будут учитываться ПРЕДЫДУЩИМ днем", STRING(v-t-shft, "hh:mm:ss"))
     2442          .
     2443       END.
     2444       ELSE DO:
     2445          ASSIGN
     2446          v-str = SUBSTITUTE("Чеки, пробитые после &1 будут учитываться СЛЕДУЮЩИМ днем", STRING(v-t-shft, "hh:mm:ss"))
     2447          .
     2448      END.
     2449   END.
     2450   e-comments:SCREEN-VALUE = v-str.
     2451   END PROCEDURE.
