      491     field actual-time-int as integer
      492   .
      493   define variable v-preconnection as logical   no-undo .
      494   define variable v-connection    as logical   no-undo .
      495   define variable v-param         as character no-undo .
      496   define variable v-param-name    as character no-undo .
      497   define variable v-param-value   as character no-undo .
      498   define variable ind             as integer   no-undo .
      499   define variable v-num-entries   as integer   no-undo .
      500   define variable v-mode          as character no-undo .
      501   define variable v-par-val       as character no-undo .
      502   define variable v-par-type      as character no-undo .
      503   define variable v-updating      as logical   no-undo init false .
      504   DEFINE VAR w-login AS WIDGET-HANDLE NO-UNDO.
      505   DEFINE BUTTON b-OK AUTO-GO
      506        LABEL "&Ввод":L
      507        SIZE 10 BY 1.
      508   DEFINE BUTTON b-quit AUTO-END-KEY
      509        LABEL "&Отмена":L
      510        SIZE 10 BY 1.
      511   DEFINE VARIABLE name AS CHARACTER FORMAT "X(12)":U
      512        LABEL "Логин"
      513        VIEW-AS FILL-IN
      514        SIZE 20 BY 1 NO-UNDO.
      515   DEFINE VARIABLE password AS CHARACTER FORMAT "X(16)":U
      516        LABEL "Пароль"
      517        VIEW-AS FILL-IN
      518        SIZE 20 BY 1 NO-UNDO.
      519   DEFINE VARIABLE password_display AS CHARACTER FORMAT "X(16)":U
      520        LABEL "Пароль"
      521        VIEW-AS FILL-IN
      522        SIZE 20 BY 1 NO-UNDO.
      523   DEFINE IMAGE IMAGE-1
      524        FILENAME "cmp/ith.bmp":U
      525        SIZE 40 BY 8.88.
      526   DEFINE FRAME FRAME-A
      527        name AT ROW 4.96 COL 10 COLON-ALIGNED
      528        password AT ROW 6.17 COL 10 COLON-ALIGNED BLANK
      529        password_display AT ROW 6.17 COL 10 COLON-ALIGNED  PASSWORD-FIELD
      530        b-OK AT ROW 8 COL 11.75
      531        b-quit AT ROW 8 COL 21.88
      532        IMAGE-1 AT ROW 1 COL 1
      533       WITH 1 DOWN NO-BOX OVERLAY
      534            SIDE-LABELS THREE-D
      535            AT COL 1 ROW 1
      536            SIZE 40.13 BY 8.96.
      537   IF SESSION:DISPLAY-TYPE = "GUI":U and not session:batch-mode THEN
      538     CREATE WINDOW w-login ASSIGN
      539            HIDDEN             = YES
      540            TITLE              = "TH OpenXML"
      541            COLUMN             = 27
      542            ROW                = 7.58
      543            HEIGHT             = 9.13
      544            WIDTH              = 40.25
      545            MAX-HEIGHT         = 35.63
      546            MAX-WIDTH          = 160
      547            VIRTUAL-HEIGHT     = 35.63
      548            VIRTUAL-WIDTH      = 160
      549            RESIZE             = no
      550            SCROLL-BARS        = yes
      551            STATUS-AREA        = no
      552            BGCOLOR            = ?
      553            FGCOLOR            = ?
      554            THREE-D            = yes
      555            MESSAGE-AREA       = no
      556            SENSITIVE          = yes.
      557   ELSE w-login = CURRENT-WINDOW.
      558   IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(w-login)
      559   THEN w-login:HIDDEN = no.
      560   ON VALUE-CHANGED OF password_display IN FRAME FRAME-A DO:
      561       IF NOT v-updating THEN DO:
      562           ASSIGN password:SCREEN-VALUE = password_display:SCREEN-VALUE.
      563       END.
      564   END.
      565   ON ANY-KEY OF password_display IN FRAME FRAME-A DO:
      566       IF LASTKEY = KEY-CODE("CTRL-V") THEN DO:
      567              ASSIGN
      568              v-updating = TRUE
      569              password:SCREEN-VALUE = System.Windows.Forms.Clipboard:GetText()
      570              password_display:SCREEN-VALUE = System.Windows.Forms.Clipboard:GetText()
      571              v-updating = FALSE.
      572              System.Windows.Forms.Clipboard:Clear().
      573              RETURN NO-APPLY.
      574       END.
      575   END.
      576   ON CHOOSE OF b-OK IN FRAME FRAME-A
      577   DO:
      578     if name :screen-value = "" then do:
      579       message
      580         "Введите имя пользователя"
      581         view-as alert-box information .
      582       apply "entry" to name .
      583       return no-apply .
      584     end.
      585   END.
      586   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      587   on help of frame FRAME-A
      588   do:
      589     run gbl/app_help.p
      590       (input this-procedure :file-name
      591       ,input ''
      592       ,input ?
      593       ) no-error.
      594     if error-status :error then do:
      595       message
      596         "Ошибка при вызове помощи"
      597         error-status :get-message(1)
      598         view-as alert-box .
      599     end.
      600   end.
      601   procedure proc-alt-shift-f2:
      602     if not ibs.th.gbl.gbl-var:rcode
      603   then
      604     run gbl\inidebug.p .
      605   end.
      606   procedure proc-alt-shift-f3:
      607     run gbl/prvssinf.p
      608       ( input this-procedure
      609       ) .
      610   end.
      611   define variable v-inform-launched as logical no-undo initial false .
      612   procedure proc-alt-shift-f4:
      613     define variable v-action as character no-undo .
      614     if v-inform-launched = false then do:
      615       assign
      616         v-inform-launched = true
      617       .
      618       run gbl/d-inform.w
      619         (  input self
      620         ,  input this-procedure
      621         , output v-action
      622         ) no-error .
      623       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      624       assign
      625         v-inform-launched = false
      626       .
      627     end.
      628   end.
      629   procedure proc-alt-f1:
      630     run gbl/corrhelp.p
      631       (input this-procedure
      632       ) .
      633   end .
      634   on alt-shift-f2 anywhere do:
      635     run proc-alt-shift-f2.
      636   end.
      637   on alt-shift-f3 anywhere do:
      638     run proc-alt-shift-f3 in this-procedure .
      639   end.
      640   on alt-shift-f4 anywhere do:
      641     run proc-alt-shift-f4 in this-procedure.
      642   end.
      643   on alt-f1 anywhere do:
      644     run proc-alt-f1 in this-procedure .
      645   end.
      646   on "ENTRY" of b-ok do:
      647     if lastkey = keycode ("RETURN") then apply "CHOOSE" to b-ok in frame FRAME-A.
      648   end.
      649   if valid-handle(w-login) then
      650   do:
      651   on window-close of w-login do:
      652     apply "end-error" to frame FRAME-A.
      653   end.
      654   ASSIGN CURRENT-WINDOW             = w-login
      655       SESSION:SYSTEM-ALERT-BOXES = (CURRENT-WINDOW:MESSAGE-AREA = NO).
      656       session:three-d = yes.
      657   end.
      658   PAUSE 0 BEFORE-HIDE.
      659   if session:date-format <> "dmy":U
      660     or session:numeric-decimal-point <> ".":U
      661     or session:numeric-separator <> ",":U
      662   then do:
      663     message
      664       vss-workfile vss-revision vss-description skip
      665       "Неправильные установки сессии progress!" skip
      666       "Формат даты должен быть - " "'dmy'":U skip
      667       "Десятичный разделитель - " "'.'":U skip
      668       "Разделитель тысяч - " "','":U skip
      669       view-as alert-box error .
      670     quit.
      671   end.
      672   assign
      673     v-preconnection = FALSE
      674     name            = "":U
      675     password        = "":U
      676   .
      677   if SESSION:PARAMETER <> "":U
      678     and SESSION:PARAMETER <> ?
      679   then do:
      680     assign
      681       v-num-entries = num-entries( SESSION:PARAMETER, ",":U )
      682     .
      683     do ind = 1 to v-num-entries :
      684       assign
      685         v-param = entry( ind, SESSION:PARAMETER, ",":U )
      686       .
      687       if num-entries( v-param, ":":U ) > 1 then do:
      688         assign
      689           v-param-name  = entry( 1, v-param, ":":U )
      690           v-param-value = substring( v-param, length( v-param-name ) + 2 )
      691         .
      692         case v-param-name :
      693           when "U":U then do:
      694             assign
      695               name = v-param-value
      696             .
      697           end.
      698           when "P":U then do:
      699             assign
      700               password = v-param-value
      701             .
      702           end.
      703           when "M":U then do:
      704             assign
      705               v-mode = replace( v-param-value, chr(4), ",":U )
      706             .
      707           end.
      708           when "A":U then .
      709           otherwise do:
      710             message
      711               substitute("Неизвестный параметр сессии СПН: &1", v-param) skip
      712               substitute("Параметр игнорируется.") skip
      713               view-as alert-box information .
      714           end.
      715         end case.
      716       end.
      717       else do:
      718         message
      719           substitute("Неизвестный параметр сессии СПН: &1", v-param) skip
      720           substitute("Параметр игнорируется.") skip
      721           view-as alert-box information .
      722       end.
      723     end.
      724     if name <> "":U
      725       and password <> "":U
      726     then do:
      727       run adm/autoinit.p ( input name
      728                       ,input password
      729                     ) no-error.
      730       run adm/autoconn.p no-error.
      731       if error-status :error then do:
      732         assign
      733           password = "":U
      734         .
      735       end.
      736       else do:
      737         assign
      738           v-preconnection = TRUE
      739         .
      740       end.
      741       run gbl/dbdiscon.p no-error.
      742     end.
      743   end.
      744   if v-preconnection = FALSE then do:
      745     run enable_UI.
      746   end.
      747   assign
      748     session :data-entry-return = yes
      749   .
      750   run gbl/font-chk.p no-error .
      751   if error-status :error then do:
      752     message
      753       vss-workfile vss-revision vss-description skip
      754       "Неправильные установки системных шрифтов" skip
      755       "Обратитесь к администратору" skip
      756       error-status :get-message(1) skip
      757       return-value skip
      758       view-as alert-box information .
      759   end.
      760   do1:
      761   do
      762   on error  undo, leave
      763   on endkey undo, leave
      764   on stop   undo, leave
      765   :
      766     if v-preconnection = FALSE then do:
      767       WAIT-FOR GO OF frame FRAME-A focus name.
      768     end.
      769     assign
      770       name
      771       password
      772       v-connection = FALSE
      773     .
      774     run adm/autoinit.p ( input name
      775                     ,input password
      776                    ) no-error.
      777     if error-status :error then do:
      778       message
      779         vss-workfile vss-revision vss-description skip
      780         "Ошибка инициализации переменных для системы автоматического запуска" skip
      781         return-value
      782         view-as alert-box error.
      783       leave do1.
      784     end.
      785     run bge/oxml-ini.p no-error.
      786     if error-status :error then do:
      787       message
      788         vss-workfile vss-revision vss-description skip
      789         "Ошибка инициализации переменных для системы OpenXML" skip
      790         return-value
      791         view-as alert-box error.
      792       leave do1.
      793     end.
      794     run adm/autoconn.p no-error.
      795     if error-status:error then do:
      796       message
      797         vss-workfile vss-revision vss-description skip
      798         return-value
      799         view-as alert-box error.
      800       leave do1.
      801     end.
      802     assign
      803       v-connection = TRUE
      804     .
      805     run gbl/dbdiscon.p no-error.
      806   end.
      807   assign
      808     session :data-entry-return = no
      809   .
      810   RUN disable_UI.
      811   if v-connection
      812     and not error-status:error then do:
      813     run adm/automain.w ( input 'autooxml':U
      814                         ,input v-mode
      815                         ) no-error.
      816   end.
      817   run gbl/dbdiscon.p no-error.
      818   quit.
      819   PROCEDURE disable_UI :
      820     IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(w-login)
      821     THEN DELETE WIDGET w-login.
      822     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
      823   END PROCEDURE.
      824   PROCEDURE enable_UI :
      825     ENABLE IMAGE-1 name password password_display b-OK b-quit
      826         WITH FRAME FRAME-A IN WINDOW w-login.
      827     VIEW w-login.
      828   END PROCEDURE.
