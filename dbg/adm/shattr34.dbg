      613   procedure thbjattr_code :
      614      define input  parameter p-upper-code     as character no-undo .
      615      define input  parameter p-code           as character no-undo .
      616      define output parameter p-label          as character no-undo .
      617      define output parameter p-user-can-edit  as logical   no-undo .
      618      define output parameter p-output-display as logical   no-undo .
      619      define output parameter p-other          as character no-undo .
      620      define output parameter p-prop-list      as character no-undo .
      621      define output parameter p-prop-type-list as character no-undo .
      622      define output parameter p-prop-label-list as character no-undo .
      623      define output parameter p-global          as logical no-undo .
      624      define output parameter p-host           as logical no-undo .
      625      define output parameter p-shop           as logical no-undo .
      626      define output parameter p-store          as logical no-undo .
      627      define output parameter p-db             as logical no-undo .
      628      define variable p-region as logical no-undo.
      629      run thbjattr_code_reg in this-procedure (
      630                                               p-upper-code,
      631                                               p-code,
      632                                               output p-label,
      633                                               output p-user-can-edit,
      634                                               output p-output-display,
      635                                               output p-other,
      636                                               output p-prop-list,
      637                                               output p-prop-type-list,
      638                                               output p-prop-label-list,
      639                                               output p-global,
      640                                               output p-host,
      641                                               output p-shop,
      642                                               output p-store,
      643                                               output p-db,
      644                                               output p-region
      645                                               ).
      646   end procedure.
      647   procedure thbjattr_code_reg :
      648   define input  parameter p-upper-code     as character no-undo .
      649   define input  parameter p-code           as character no-undo .
      650   define output parameter p-label          as character no-undo .
      651   define output parameter p-user-can-edit  as logical   no-undo .
      652   define output parameter p-output-display as logical   no-undo .
      653   define output parameter p-other          as character no-undo .
      654   define output parameter p-prop-list      as character no-undo .
      655   define output parameter p-prop-type-list as character no-undo .
      656   define output parameter p-prop-label-list as character no-undo .
      657   define output parameter p-global          as logical no-undo .
      658   define output parameter p-host           as logical no-undo .
      659   define output parameter p-shop           as logical no-undo .
      660   define output parameter p-store          as logical no-undo .
      661   define output parameter p-db             as logical no-undo .
      662   define output parameter p-region         as logical no-undo .
      663   do
      664   on error undo, return error return-value
      665   :
      666       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      667       (input  p-upper-code
      668       ,input  p-code
      669       ,output p-label
      670       ,output p-user-can-edit
      671       ,output p-output-display
      672       ,output p-other
      673       ,output p-prop-list
      674       ,output p-prop-type-list
      675       ,output p-prop-label-list
      676       ,output p-global
      677       ,output p-host
      678       ,output p-shop
      679       ,output p-store
      680       ,output p-db
      681       ,output p-region
      682       ) no-error .
      683     if error-status :error
      684     then do:
      685       undo, return error substitute( "&1. &2&3&4", vss-include-info2, return-value, chr(10), error-status :get-message (1)).
      686     end.
      687   end.
      688   end procedure.
