     1070     if error-status :error = yes
     1071     then do:
     1072       return no-apply.
     1073     end.
     1074   END.
     1075   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1076   DO:
     1077     run proc-b-del in this-procedure no-error .
     1078     if error-status :error = yes
     1079     then do:
     1080       return no-apply.
     1081     end.
     1082   END.
     1083   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1084   DO:
     1085     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
     1086     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1087   END.
     1088   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1089   DO:
     1090     run proc-b-mark in this-procedure no-error .
     1091     if error-status :error = yes
     1092     then do:
     1093       return no-apply.
     1094     end.
     1095   END.
     1096   ON VALUE-CHANGED OF cb-bgeflold IN FRAME Dialog-Frame
     1097   DO:
     1098     run check-bgeflold in this-procedure .
     1099   END.
     1100   ON VALUE-CHANGED OF cb-bgefmt IN FRAME Dialog-Frame
     1101   DO:
     1102     run check-bgefmt in this-procedure .
     1103   END.
     1104   ON VALUE-CHANGED OF cb-bgeshift IN FRAME Dialog-Frame
     1105   DO:
     1106     run check-bgeshift in this-procedure .
     1107   END.
     1108   ON LEAVE OF fi-bgeflnm IN FRAME Dialog-Frame
     1109   DO:
     1110     run check-bgeflnm in this-procedure .
     1111   END.
     1112   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1113   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1114   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1115   on help of frame Dialog-Frame
     1116   do:
     1117     run gbl/app_help.p
     1118       (input this-procedure :file-name
     1119       ,input ''
     1120       ,input ?
     1121       ) no-error.
     1122     if error-status :error then do:
     1123       message
     1124         "Ошибка при вызове помощи"
     1125         error-status :get-message(1)
     1126         view-as alert-box .
     1127     end.
     1128   end.
     1129   run minbtn-set in this-procedure .
     1130   on choose of b-help in frame Dialog-Frame
     1131   do:
     1132     apply "help":u to frame Dialog-Frame .
     1133   end.
     1134   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1135   procedure minbtn-set :
     1136       do
     1137           on error undo, return error return-value
     1138           :
     1139           define variable ii              as integer       no-undo .
     1140           define variable fh              as widget-handle no-undo .
     1141           define variable hh              as widget-handle no-undo .
     1142           define variable v-h             as handle        extent 4 no-undo .
     1143           define variable v-name-button   as character     no-undo .
     1144           define variable v-help-old-x    as decimal       no-undo .
     1145           define variable v-help-old-y    as decimal       no-undo .
     1146           define variable v-help-old-size as decimal       no-undo .
     1147           define variable v-frame-width   as decimal       no-undo .
     1148           define variable jj              as integer       no-undo .
     1149           do
     1150               on error undo, return error
     1151               :
     1152               assign
     1153                   v-frame-width = frame Dialog-Frame:width - 0.3
     1154                   fh            = frame Dialog-Frame:first-child
     1155                   hh            = fh:first-child
     1156                   ii            = 1
     1157                   .
     1158               do while valid-handle(hh):
     1159                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1160                   do:
     1161                       case lc(hh:name) :
     1162                           when "b-help" then
     1163                               do:
     1164                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1165                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1166                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1167                                   hh:TOOLTIP = "Помощь" .
     1168                                   v-help-old-x = hh:column .
     1169                                   v-help-old-y = hh:row    .
     1170                                   v-help-old-size = hh:width .
     1171                                   hh:width-chars = 2.5 .
     1172                               end.
     1173                           when "b-print" then
     1174                               do:
     1175                                   hh:load-image("cmp/b-print.bmp":u) .
     1176                                   hh:TOOLTIP = "Печать" .
     1177                                   v-h[ii] = hh:handle .
     1178                                   ii = ii + 1 .
     1179                                   hh:width-chars = 3 .
     1180                               end.
     1181                           when "b-history" or
     1182                           when "b-hist" then
     1183                               do:
     1184                                   hh:load-image("cmp/b-hist.bmp":u) .
     1185                                   hh:TOOLTIP = "История" .
     1186                                   v-h[ii] = hh:handle .
     1187                                   ii = ii + 1 .
     1188                                   hh:width-chars = 3 .
     1189                               end.
     1190                           when "b-sch" then
     1191                               do:
     1192                                   hh:load-image("cmp/b-sch.bmp":u) .
     1193                                   hh:TOOLTIP = "Установка Фильтра" .
     1194                                   v-h[ii] = hh:handle .
     1195                                   ii = ii + 1 .
     1196                                   hh:width-chars = 3 .
     1197                               end.
     1198                           when "b-hist-user" then
     1199                               do:
     1200                                   hh:load-image("cmp/b-hist.bmp":u) .
     1201                                   hh:TOOLTIP = "История пользователя" .
     1202                                   ii = ii + 1 .
     1203                               end.
     1204                       end case.
     1205                   end.
     1206                   hh = hh:next-sibling.
     1207               end.
     1208               b-help:column = v-frame-width - b-help:width-chars.
     1209               jj = 0.
     1210               repeat ii = 4 to 1 by -1 :
     1211                   if valid-handle (v-h[ii] ) then
     1212                   do:
     1213                       jj  = jj + 1 .
     1214                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1215                       v-h[ii]:row    = v-help-old-y .
     1216                   end.
     1217               end.
     1218           end.
     1219       end.
     1220   end procedure.
     1221   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1222   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1223   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1224   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1225   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1226   define variable v-diasize-current-frame-height as decimal   no-undo .
     1227   define variable v-diasize-change-size          as logical   no-undo .
     1228   define variable v-diasize-resize-button        as handle    no-undo .
     1229   define variable v-diasize-wndmax               as logical   no-undo .
     1230   define variable v-diasize-wndstore             as logical   no-undo .
     1231   define variable v-diasize-proc-name            as character no-undo .
     1232   define variable v-diasize-browse-handle        as handle    no-undo .
     1233   define variable v-diasize-browse-number        as integer   no-undo .
     1234   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1235   define temp-table temp-diasize-handle no-undo
     1236     field handle-value  as handle
     1237     field save-position as decimal
     1238     index xpk is primary unique handle-value
     1239     .
     1240   define temp-table temp-browse-handle no-undo
     1241     field browse-type   as character
     1242     field browse-number as integer
     1243     field browse-handle as handle
     1244     field original-size as decimal
     1245     index xpk is primary unique browse-type browse-number
     1246     index xie browse-type browse-handle
     1247   .
     1248   procedure diasize_change-height :
     1249     define input  parameter p-change-value  as decimal   no-undo .
     1250     define input  parameter p-move-resize   as logical   no-undo .
     1251     define variable v-field-group-handle    as handle    no-undo .
     1252     define variable v-object-handle         as handle    no-undo .
     1253     define variable v-frame-height          as decimal   no-undo .
     1254     define variable v-frame-virtual-height  as decimal   no-undo .
     1255     define variable v-browse-height         as decimal   no-undo .
     1256     define variable v-window-height         as decimal   no-undo .
     1257     define variable v-window-virtual-height as decimal   no-undo .
     1258     define variable v-change-sign           as integer   no-undo .
     1259     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1260     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1261     if p-change-value > 0
     1262     then do:
     1263       if frame Dialog-Frame :height + p-change-value
     1264           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1265       then do:
     1266         assign
     1267           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1268                           - (frame Dialog-Frame :height-chars)
     1269         .
     1270         if p-change-value <= 0
     1271         then do:
     1272           run diasize_position-resize-button in this-procedure .
     1273           return .
     1274         end.
     1275       end.
     1276     end.
     1277     if p-change-value < 0
     1278     then do:
     1279       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1280       then do:
     1281         assign
     1282           p-change-value = v-diasize-orig-frame-height
     1283                          - (frame Dialog-Frame :height-chars)
     1284         .
     1285         if p-change-value >= 0
     1286         then do:
     1287           run diasize_position-resize-button in this-procedure .
     1288           return .
     1289         end.
     1290       end.
     1291     end.
     1292     if p-change-value >= 0
     1293     then do:
     1294       assign
     1295         v-change-sign = 1
     1296       .
     1297     end.
     1298     else do:
     1299       assign
     1300         v-change-sign = -1
     1301       .
     1302     end.
     1303     assign
     1304       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1305     .
     1306     if p-change-value = 0
     1307     then do:
     1308       run diasize_position-resize-button in this-procedure .
     1309       return .
     1310     end.
     1311     move_block:
     1312     do
     1313     on error undo move_block, retry move_block
     1314     :
     1315       if retry
     1316       then do:
     1317         do
     1318         on error undo move_block, leave move_block
     1319         :
     1320           if p-change-value > 0
     1321           then do:
     1322             for each buf_temp-diasize-handle
     1323             on error undo, next
     1324             :
     1325               assign
     1326                 v-object-handle = buf_temp-diasize-handle.handle-value
     1327               .
     1328               if v-object-handle <> v-diasize-resize-button
     1329               then do:
     1330                 assign
     1331                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1332                 .
     1333               end.
     1334             end.
     1335             assign
     1336               v-diasize-browse-handle :height = v-browse-height
     1337             .
     1338             for each buf_temp-browse-handle
     1339               where buf_temp-browse-handle.browse-type = 'height':u
     1340             on error undo, next
     1341             :
     1342               assign
     1343                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1344               .
     1345             end.
     1346             assign
     1347               frame Dialog-Frame :height = v-frame-height
     1348             .
     1349             if frame Dialog-Frame :scrollable = true
     1350             then do:
     1351               assign
     1352                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1353               .
     1354             end.
     1355             run diasize_position-resize-button in this-procedure .
     1356           end.
     1357           else do:
     1358             if frame Dialog-Frame :scrollable = true
     1359             then do:
     1360               assign
     1361                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1362               .
     1363             end.
     1364             assign
     1365               frame Dialog-Frame :height = v-frame-height
     1366             .
     1367             assign
     1368               v-diasize-browse-handle :height = v-browse-height
     1369             .
     1370             for each buf_temp-browse-handle
     1371               where buf_temp-browse-handle.browse-type = 'height':u
     1372             on error undo, next
     1373             :
     1374               assign
     1375                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1376               .
     1377             end.
     1378             for each buf_temp-diasize-handle
     1379             on error undo, next
     1380             :
     1381               assign
     1382                 v-object-handle = buf_temp-diasize-handle.handle-value
     1383               .
     1384               if v-object-handle <> v-diasize-resize-button
     1385               then do:
     1386                 assign
     1387                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1388                 .
     1389               end.
     1390             end.
     1391             run diasize_position-resize-button in this-procedure .
     1392           end.
     1393           assign
     1394             v-diasize-change-size = false
     1395           .
     1396           leave move_block .
     1397         end.
     1398       end.
     1399       assign
     1400         v-diasize-need-full-display = true
     1401       .
     1402       if v-diasize-change-size = false
     1403       then do:
     1404         assign
     1405           v-diasize-change-size = true
     1406         .
     1407       end.
     1408       else do:
     1409         return .
     1410       end.
     1411       assign
     1412         v-frame-height = frame Dialog-Frame :height
     1413         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1414         v-browse-height = v-diasize-browse-handle :height
     1415       .
     1416       for each buf_temp-browse-handle
     1417         where buf_temp-browse-handle.browse-type = 'height':u
     1418       :
     1419         assign
     1420           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1421         .
     1422       end.
     1423       for each buf_temp-diasize-handle
     1424       :
     1425         delete buf_temp-diasize-handle .
     1426       end.
     1427       assign
     1428         v-field-group-handle = frame Dialog-Frame :first-child
     1429       .
     1430       do while valid-handle(v-field-group-handle)
     1431       :
     1432         assign
     1433           v-object-handle = v-field-group-handle :first-child
     1434         .
     1435         do while valid-handle(v-object-handle)
     1436         :
     1437           if  v-object-handle <> v-diasize-browse-handle :handle
     1438           and can-query(v-object-handle, "row")
     1439           and can-query(v-object-handle, "height")
     1440           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1441           then do:
     1442             find first buf_temp-browse-handle
     1443               where buf_temp-browse-handle.browse-type   = 'height':u
     1444                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1445               no-error .
     1446             if available buf_temp-browse-handle
     1447             then do:
     1448             end.
     1449             else do:
     1450               create buf_temp-diasize-handle .
     1451               assign
     1452                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1453                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1454               .
     1455             end.
     1456           end.
     1457           assign
     1458             v-object-handle = v-object-handle :next-sibling
     1459           .
     1460         end.
     1461         assign
     1462           v-field-group-handle = v-field-group-handle :next-sibling
     1463         .
     1464       end.
     1465       do with frame Dialog-Frame
     1466       :
     1467         hide v-diasize-resize-button .
     1468         assign
     1469           v-diasize-resize-button :row    = 1
     1470           v-diasize-resize-button :column = 1
     1471         .
     1472       end.
     1473       if p-change-value > 0
     1474       then do:
     1475         if frame Dialog-Frame :scrollable = true
     1476         then do:
     1477           assign
     1478             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1479             no-error .
     1480           if error-status :error
     1481           or error-status :get-message(1) <> ""
     1482           then do:
     1483             undo move_block, retry move_block .
     1484           end.
     1485         end.
     1486         assign
     1487           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1488           no-error .
     1489         if error-status :error
     1490         or error-status :get-message(1) <> ""
     1491         then do:
     1492           undo move_block, retry move_block .
     1493         end.
     1494         assign
     1495           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1496           no-error .
     1497         if error-status :error
     1498         or error-status :get-message(1) <> ""
     1499         then do:
     1500           undo move_block, retry move_block .
     1501         end.
     1502         for each buf_temp-browse-handle
     1503           where buf_temp-browse-handle.browse-type = 'height':u
     1504         on error undo move_block, retry move_block
     1505         :
     1506           assign
     1507             buf_temp-browse-handle.browse-handle :height
     1508               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1509             no-error .
     1510           if error-status :error
     1511           or error-status :get-message(1) <> ""
     1512           then do:
     1513             undo move_block, retry move_block .
     1514           end.
     1515         end.
     1516         for each buf_temp-diasize-handle
     1517         on error undo move_block, retry move_block
     1518         :
     1519           assign
     1520             v-object-handle = buf_temp-diasize-handle.handle-value
     1521           .
     1522           if v-object-handle <> v-diasize-resize-button
     1523           then do:
     1524             assign
     1525               v-object-handle :row = v-object-handle :row + p-change-value
     1526               no-error .
     1527             if error-status :error
     1528             or error-status :get-message(1) <> ""
     1529             then do:
     1530               undo move_block, retry move_block .
     1531             end.
     1532           end.
     1533         end.
     1534       end.
     1535       else do:
     1536         for each buf_temp-diasize-handle
     1537         on error undo move_block, retry move_block
     1538         :
     1539           assign
     1540             v-object-handle = buf_temp-diasize-handle.handle-value
     1541           .
     1542           if v-object-handle <> v-diasize-resize-button
     1543           then do:
     1544             assign
     1545               v-object-handle :row = v-object-handle :row + p-change-value
     1546               no-error .
     1547             if error-status :error
     1548             or error-status :get-message(1) <> ""
     1549             then do:
     1550               undo move_block, retry move_block .
     1551             end.
     1552           end.
     1553         end.
     1554         assign
     1555           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1556           no-error .
     1557         if error-status :error
     1558         or error-status :get-message(1) <> ""
     1559         then do:
     1560           undo move_block, retry move_block .
     1561         end.
     1562         for each buf_temp-browse-handle
     1563           where buf_temp-browse-handle.browse-type = 'height':u
     1564         on error undo move_block, retry move_block
     1565         :
     1566           assign
     1567             buf_temp-browse-handle.browse-handle :height
     1568               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1569             no-error .
     1570           if error-status :error
     1571           or error-status :get-message(1) <> ""
     1572           then do:
     1573             undo move_block, retry move_block .
     1574           end.
     1575         end.
     1576         assign
     1577           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1578           no-error .
     1579         if error-status :error
     1580         or error-status :get-message(1) <> ""
     1581         then do:
     1582           undo move_block, retry move_block .
     1583         end.
     1584         if frame Dialog-Frame :scrollable = true
     1585         then do:
     1586           assign
     1587             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1588             no-error .
     1589           if error-status :error
     1590           or error-status :get-message(1) <> ""
     1591           then do:
     1592             undo move_block, retry move_block .
     1593           end.
     1594         end.
     1595       end.
     1596       if p-move-resize = true
     1597       then do:
     1598         run diasize_position-resize-button in this-procedure .
     1599       end.
     1600       if v-diasize-wndstore = true
     1601       then do:
     1602         if connected("ub") = true
     1603         then do:
     1604           define variable v-cntxt-db-num        as integer   no-undo .
     1605           define variable v-cntxt-userid        as character no-undo .
     1606           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1607                                             , OUTPUT v-cntxt-userid
     1608                                             ) .
     1609           run gbl/wndsizew.p
     1610             (input  v-cntxt-db-num
     1611             ,input  v-cntxt-userid
     1612             ,input  v-diasize-proc-name
     1613             ,input  'height':u
     1614             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1615             ) .
     1616         end.
     1617       end.
     1618     end.
     1619     assign
     1620       v-diasize-change-size = false
     1621     .
     1622   end procedure.
     1623   procedure diasize_set-height :
     1624     define input  parameter p-new-height  as decimal   no-undo .
     1625     define input  parameter p-move-resize as logical   no-undo .
     1626     do
     1627     on error undo, return error return-value
     1628     :
     1629       run diasize_change-height in this-procedure
     1630         (input  (p-new-height - frame Dialog-Frame :height)
     1631         ,input  p-move-resize
     1632         ) .
     1633     end.
     1634   end procedure.
     1635   procedure diasize_change-width :
     1636     define input  parameter p-change-value as decimal   no-undo .
     1637     define input  parameter p-move-resize  as logical   no-undo .
     1638     define variable v-field-group-handle   as handle    no-undo .
     1639     define variable v-object-handle        as handle    no-undo .
     1640     define variable v-frame-width          as decimal   no-undo .
     1641     define variable v-frame-virtual-width  as decimal   no-undo .
     1642     define variable v-browse-width         as decimal   no-undo .
     1643     define variable v-window-width         as decimal   no-undo .
     1644     define variable v-window-virtual-width as decimal   no-undo .
     1645     define variable v-change-sign          as integer   no-undo .
     1646     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1647     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1648     if p-change-value > 0
     1649     then do:
     1650       if frame Dialog-Frame :width + p-change-value >
     1651           session :width-chars
     1652       then do:
     1653         assign
     1654           p-change-value = session :width-chars - frame Dialog-Frame :width
     1655         .
     1656         if p-change-value <= 0
     1657         then do:
     1658           run diasize_position-resize-button in this-procedure .
     1659           return .
     1660         end.
     1661       end.
     1662     end.
     1663     if p-change-value < 0
     1664     then do:
     1665       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1666       then do:
     1667         assign
     1668           p-change-value = v-diasize-orig-frame-width
     1669                          - frame Dialog-Frame :width
     1670         .
     1671         if p-change-value >= 0
     1672         then do:
     1673           run diasize_position-resize-button in this-procedure .
     1674           return .
     1675         end.
     1676       end.
     1677     end.
     1678     if p-change-value >= 0
     1679     then do:
     1680       assign
     1681         v-change-sign = 1
     1682       .
     1683     end.
     1684     else do:
     1685       assign
     1686         v-change-sign = -1
     1687       .
     1688     end.
     1689     assign
     1690       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1691     .
     1692     if p-change-value = 0
     1693     then do:
     1694       run diasize_position-resize-button in this-procedure .
     1695       return .
     1696     end.
     1697     move_block:
     1698     do
     1699     on error undo move_block, leave move_block
     1700     :
     1701       if retry
     1702       then do:
     1703         do
     1704         on error undo move_block, leave move_block
     1705         :
     1706           if p-change-value > 0
     1707           then do:
     1708             for each buf_temp-diasize-handle
     1709             on error undo, next
     1710             :
     1711               assign
     1712                 v-object-handle = buf_temp-diasize-handle.handle-value
     1713               .
     1714               if v-object-handle <> v-diasize-resize-button
     1715               then do:
     1716                 assign
     1717                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1718                 .
     1719               end.
     1720             end.
     1721             assign
     1722               v-diasize-browse-handle :width = v-browse-width
     1723             .
     1724             for each buf_temp-browse-handle
     1725               where buf_temp-browse-handle.browse-type = 'width':u
     1726             on error undo, next
     1727             :
     1728               assign
     1729                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1730               .
     1731             end.
     1732             assign
     1733               frame Dialog-Frame :width = v-frame-width
     1734             .
     1735             if frame Dialog-Frame :scrollable = true
     1736             then do:
     1737               assign
     1738                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1739               .
     1740             end.
     1741             run diasize_position-resize-button in this-procedure .
     1742           end.
     1743           else do:
     1744             if frame Dialog-Frame :scrollable = true
     1745             then do:
     1746               assign
     1747                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1748               .
     1749             end.
     1750             assign
     1751               frame Dialog-Frame :width = v-frame-width
     1752             .
     1753             for each buf_temp-browse-handle
     1754               where buf_temp-browse-handle.browse-type = 'width':u
     1755             on error undo, next
     1756             :
     1757               assign
     1758                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1759               .
     1760             end.
     1761             assign
     1762               v-diasize-browse-handle :width = v-browse-width
     1763             .
     1764             for each buf_temp-diasize-handle
     1765             on error undo, next
     1766             :
     1767               assign
     1768                 v-object-handle = buf_temp-diasize-handle.handle-value
     1769               .
     1770               if v-object-handle <> v-diasize-resize-button
     1771               then do:
     1772                 assign
     1773                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1774                 .
     1775               end.
     1776             end.
     1777             run diasize_position-resize-button in this-procedure .
     1778           end.
     1779           assign
     1780             v-diasize-change-size = false
     1781           .
     1782           leave move_block .
     1783         end.
     1784       end.
     1785       assign
     1786         v-diasize-need-full-display = true
     1787       .
     1788       if v-diasize-change-size = false
     1789       then do:
     1790         assign
     1791           v-diasize-change-size = true
     1792         .
     1793       end.
     1794       else do:
     1795         return .
     1796       end.
     1797       assign
     1798         v-frame-width = frame Dialog-Frame :width
     1799         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1800         v-browse-width = v-diasize-browse-handle :width
     1801       .
     1802       for each buf_temp-browse-handle
     1803         where buf_temp-browse-handle.browse-type = 'width':u
     1804       :
     1805         assign
     1806           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1807         .
     1808       end.
     1809       for each buf_temp-diasize-handle
     1810       :
     1811         delete buf_temp-diasize-handle .
     1812       end.
     1813       assign
     1814         v-field-group-handle = frame Dialog-Frame :first-child
     1815       .
     1816       do while valid-handle(v-field-group-handle)
     1817       :
     1818         assign
     1819           v-object-handle = v-field-group-handle :first-child
     1820         .
     1821         do while valid-handle(v-object-handle)
     1822         :
     1823           if  v-object-handle <> v-diasize-browse-handle :handle
     1824           and v-object-handle <> v-diasize-resize-button
     1825           and can-query(v-object-handle, "row")
     1826           and can-query(v-object-handle, "height")
     1827           and ( v-object-handle :col + v-object-handle :width
     1828                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1829               )
     1830           then do:
     1831             find first buf_temp-browse-handle
     1832               where buf_temp-browse-handle.browse-type   = 'width':u
     1833                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1834               no-error .
     1835             if available buf_temp-browse-handle
     1836             then do:
     1837             end.
     1838             else do:
     1839               create buf_temp-diasize-handle .
     1840               assign
     1841                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1842                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1843               .
     1844             end.
     1845           end.
     1846           assign
     1847             v-object-handle = v-object-handle :next-sibling
     1848           .
     1849         end.
     1850         assign
     1851           v-field-group-handle = v-field-group-handle :next-sibling
     1852         .
     1853       end.
     1854       do with frame Dialog-Frame
     1855       :
     1856         hide v-diasize-resize-button .
     1857         v-diasize-resize-button :row = 1.
     1858         v-diasize-resize-button :column = 1.
     1859       end.
     1860       if p-change-value > 0
     1861       then do:
     1862         if frame Dialog-Frame :scrollable = true
     1863         then do:
     1864           assign
     1865             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1866             no-error .
     1867           if error-status :error
     1868           or error-status :get-message(1) <> ""
     1869           then do:
     1870             undo move_block, retry move_block.
     1871           end.
     1872         end.
     1873         assign
     1874           frame Dialog-Frame :width = v-frame-width + p-change-value
     1875           no-error .
     1876         if error-status :error
     1877         or error-status :get-message(1) <> ""
     1878         then do:
     1879           undo move_block, retry move_block.
     1880         end.
     1881         assign
     1882           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1883         no-error .
     1884         if error-status :error
     1885         or error-status :get-message(1) <> ""
     1886         then do:
     1887           undo move_block, retry move_block.
     1888         end.
     1889         for each buf_temp-browse-handle
     1890           where buf_temp-browse-handle.browse-type = 'width':u
     1891         on error undo move_block, retry move_block
     1892         :
     1893           assign
     1894             buf_temp-browse-handle.browse-handle :width
     1895               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1896             no-error .
     1897           if error-status :error
     1898           or error-status :get-message(1) <> ""
     1899           then do:
     1900             undo move_block, retry move_block .
     1901           end.
     1902         end.
     1903         for each buf_temp-diasize-handle
     1904         on error undo move_block, retry move_block
     1905         :
     1906           assign
     1907             v-object-handle = buf_temp-diasize-handle.handle-value
     1908           .
     1909           if v-object-handle <> v-diasize-resize-button
     1910           then do:
     1911             assign
     1912               v-object-handle :col = v-object-handle :col + p-change-value
     1913               no-error .
     1914             if error-status :error
     1915             or error-status :get-message(1) <> ""
     1916             then do:
     1917               undo move_block, retry move_block .
     1918             end.
     1919           end.
     1920         end.
     1921       end.
     1922       else do:
     1923         for each buf_temp-diasize-handle
     1924         on error undo move_block, retry move_block
     1925         :
     1926           assign
     1927             v-object-handle = buf_temp-diasize-handle.handle-value
     1928           .
     1929           if v-object-handle <> v-diasize-resize-button
     1930           then do:
     1931             assign
     1932               v-object-handle :col = v-object-handle :col + p-change-value
     1933               no-error .
     1934             if error-status :error
     1935             or error-status :get-message(1) <> ""
     1936             then do:
     1937               undo move_block, retry move_block .
     1938             end.
     1939           end.
     1940         end.
     1941         for each buf_temp-browse-handle
     1942           where buf_temp-browse-handle.browse-type = 'width':u
     1943         on error undo move_block, retry move_block
     1944         :
     1945           assign
     1946             buf_temp-browse-handle.browse-handle :width
     1947               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1948             no-error .
     1949           if error-status :error
     1950           or error-status :get-message(1) <> ""
     1951           then do:
     1952             undo move_block, retry move_block .
     1953           end.
     1954         end.
     1955         assign
     1956           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1957           no-error .
     1958         if error-status :error
     1959         or error-status :get-message(1) <> ""
     1960         then do:
     1961           undo move_block, retry move_block.
     1962         end.
     1963         assign
     1964           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1965         no-error .
     1966         if error-status :error
     1967         or error-status :get-message(1) <> ""
     1968         then do:
     1969           undo move_block, retry move_block.
     1970         end.
     1971         if frame Dialog-Frame :scrollable = true
     1972         then do:
     1973           assign
     1974             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1975           no-error .
     1976           if error-status :error
     1977           or error-status :get-message(1) <> ""
     1978           then do:
     1979             undo move_block, retry move_block.
     1980           end.
     1981         end.
     1982       end.
     1983       if p-move-resize
     1984       then do:
     1985         run diasize_position-resize-button in this-procedure .
     1986       end.
     1987       if v-diasize-wndstore = true
     1988       then do:
     1989         if connected("ub") = true
     1990         then do:
     1991           define variable v-cntxt-db-num        as integer   no-undo .
     1992           define variable v-cntxt-userid        as character no-undo .
     1993           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1994                                             , OUTPUT v-cntxt-userid
     1995                                             ) .
     1996           run gbl/wndsizew.p
     1997             (input  v-cntxt-db-num
     1998             ,input  v-cntxt-userid
     1999             ,input  v-diasize-proc-name
     2000             ,input  'width':u
     2001             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2002             ) .
     2003         end.
     2004       end.
     2005     end.
     2006     assign
     2007       v-diasize-change-size = false
     2008     .
     2009   end procedure.
     2010   procedure diasize_set-width :
     2011     define input  parameter p-new-width  as decimal   no-undo .
     2012     define input  parameter p-move-resize as logical   no-undo .
     2013     do
     2014     on error undo, return error return-value
     2015     :
     2016       run diasize_change-width in this-procedure
     2017         (input  (p-new-width - frame Dialog-Frame :width)
     2018         ,input  p-move-resize
     2019         ) .
     2020     end.
     2021   end procedure.
     2022   procedure diasize_position-resize-button :
     2023     do with frame Dialog-Frame
     2024     :
     2025       hide v-diasize-resize-button .
     2026       assign
     2027         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2028                     - 1
     2029                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2030         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2031                     - 1
     2032                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2033       .
     2034       view v-diasize-resize-button .
     2035     end.
     2036   end procedure.
     2037   on alt-right anywhere
     2038   do:
     2039     run diasize_change-width in this-procedure
     2040       (input 1
     2041       ,input true
     2042       ) .
     2043     return no-apply .
     2044   end.
     2045   on alt-left anywhere
     2046   do:
     2047     run diasize_change-width in this-procedure
     2048       (input -1
     2049       ,input true
     2050       ) .
     2051     return no-apply .
     2052   end.
     2053   on alt-down anywhere
     2054   do:
     2055     run diasize_change-height in this-procedure
     2056       (input 1
     2057       ,input true
     2058       ) .
     2059     return no-apply .
     2060   end.
     2061   on alt-up anywhere
     2062   do:
     2063     run diasize_change-height in this-procedure
     2064       (input -1
     2065       ,input true
     2066       ) .
     2067     return no-apply .
     2068   end.
     2069   on alt-enter of frame Dialog-Frame
     2070   do:
     2071     run diasize_maximize in this-procedure
     2072       (input  ?
     2073       ).
     2074     return no-apply .
     2075   end.
     2076   procedure diasize_end-move :
     2077     do
     2078     on error undo, return error return-value
     2079     :
     2080       define variable v-row-delta as decimal   no-undo .
     2081       define variable v-col-delta as decimal   no-undo .
     2082       define variable v-new-row as decimal   no-undo .
     2083       define variable v-new-col as decimal   no-undo .
     2084       assign
     2085         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2086         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2087       .
     2088       assign
     2089         v-row-delta = v-new-row - frame Dialog-Frame :height
     2090         v-col-delta = v-new-col - frame Dialog-Frame :width
     2091       .
     2092       run diasize_change-height in this-procedure
     2093         (input v-row-delta
     2094         ,input true
     2095         ) .
     2096       run diasize_change-width in this-procedure
     2097         (input v-col-delta
     2098         ,input true
     2099         ) .
     2100     end.
     2101   end procedure.
     2102   procedure diasize_maximize :
     2103     define input  parameter p-action as logical   no-undo .
     2104     do
     2105     on error undo, return error return-value
     2106     :
     2107       if p-action = ?
     2108       then do:
     2109         if v-diasize-need-maximize = true
     2110         then do:
     2111           assign
     2112             p-action = true
     2113           .
     2114         end.
     2115         else do:
     2116           assign
     2117             p-action = false
     2118           .
     2119         end.
     2120       end.
     2121       if p-action = true
     2122       then do:
     2123         run diasize_change-height in this-procedure
     2124           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2125               - frame Dialog-Frame :height-chars
     2126           ,input true
     2127           ) .
     2128         run diasize_change-width in this-procedure
     2129           (input session :width-chars
     2130               - frame Dialog-Frame :width-chars
     2131           ,input true
     2132           ) .
     2133         assign
     2134           v-diasize-need-maximize = false
     2135         .
     2136       end.
     2137       else do:
     2138         run diasize_change-width in this-procedure
     2139           (input v-diasize-orig-frame-width
     2140               - frame Dialog-Frame :width-chars
     2141           ,input true
     2142           ) .
     2143         run diasize_change-height in this-procedure
     2144           (input v-diasize-orig-frame-height
     2145               - frame Dialog-Frame :height-chars
     2146           ,input true
     2147           ) .
     2148         assign
     2149           v-diasize-need-maximize = true
     2150         .
     2151       end.
     2152     end.
     2153   end procedure.
     2154   procedure diasize_restore-orig-size :
     2155     do
     2156     on error undo, return error return-value
     2157     :
     2158       assign
     2159         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2160         v-diasize-current-frame-height = frame Dialog-Frame :height
     2161       .
     2162       run diasize_set-height in this-procedure
     2163         (input  v-diasize-orig-frame-height
     2164         ,input  true
     2165         ) .
     2166       run diasize_set-width in this-procedure
     2167         (input  v-diasize-orig-frame-width
     2168         ,input  true
     2169         ) .
     2170     end.
     2171   end procedure.
     2172   procedure diasize_restore-current-size :
     2173     do
     2174     on error undo, return error return-value
     2175     :
     2176       run diasize_set-height in this-procedure
     2177         (input  v-diasize-current-frame-height
     2178         ,input  true
     2179         ) .
     2180       run diasize_set-width in this-procedure
     2181         (input  v-diasize-current-frame-width
     2182         ,input  true
     2183         ) .
     2184     end.
     2185   end procedure.
     2186   procedure diasize_set-browse-handle :
     2187     define input  parameter p-browse-handle as handle   no-undo .
     2188     define buffer buf_temp-browse-handle for temp-browse-handle .
     2189     do
     2190     on error undo, return error return-value
     2191     :
     2192       assign
     2193         v-diasize-browse-handle = p-browse-handle
     2194       .
     2195       for each buf_temp-browse-handle
     2196       on error undo, return error return-value
     2197       :
     2198         delete buf_temp-browse-handle .
     2199       end.
     2200     end.
     2201   end procedure.
     2202   procedure diasize_add_browse :
     2203     define input  parameter p-browse-type   as character no-undo .
     2204     define input  parameter p-browse-handle as handle    no-undo .
     2205     define buffer buf_temp-browse-handle for temp-browse-handle .
     2206     do
     2207     on error undo, return error return-value
     2208     :
     2209       assign
     2210         v-diasize-browse-number = v-diasize-browse-number + 1
     2211       .
     2212       create buf_temp-browse-handle .
     2213       assign
     2214         buf_temp-browse-handle.browse-type   = p-browse-type
     2215         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2216         buf_temp-browse-handle.browse-handle = p-browse-handle
     2217       .
     2218     end.
     2219   end procedure.
     2220   procedure diasize_init :
     2221     define variable v-default-value    as logical   no-undo .
     2222     define variable v-restore-saved    as logical   no-undo .
     2223     define variable v-resize-value-str as character no-undo .
     2224     do
     2225     on error undo, return error return-value
     2226     :
     2227       do with frame Dialog-Frame
     2228       :
     2229         assign
     2230           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2231           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2232           v-diasize-browse-handle     = browse br-tt-clients-iv :handle
     2233         .
     2234         create button v-diasize-resize-button
     2235         assign
     2236           parent        = frame Dialog-Frame :first-child
     2237           label         = "s"
     2238           height-pixels = 16
     2239           width-pixels  = 16
     2240           visible       = true
     2241           sensitive     = true
     2242           movable       = true
     2243           triggers:
     2244             on end-move persistent run diasize_end-move in this-procedure .
     2245           end triggers.
     2246         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2247         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2248         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2249         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2250         assign
     2251           v-diasize-wndmax = false
     2252         .
     2253         if connected("ub") = true
     2254         then do:
     2255           define variable v-cntxt-db-num        as integer   no-undo .
     2256           define variable v-cntxt-userid        as character no-undo .
     2257           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2258                                             , OUTPUT v-cntxt-userid
     2259                                             ) .
     2260           run gbl/wndpar_r.p
     2261             (input  v-cntxt-db-num
     2262             ,input  v-cntxt-userid
     2263             ,input  'wndmax':U
     2264             ,output v-diasize-wndmax
     2265             ,output v-default-value
     2266             ) .
     2267         end.
     2268         assign
     2269           v-diasize-wndstore = false
     2270         .
     2271         if connected("ub") = true
     2272         then do:
     2273           run gbl/wndpar_r.p
     2274             (input  v-cntxt-db-num
     2275             ,input  v-cntxt-userid
     2276             ,input  'wndstore':U
     2277             ,output v-diasize-wndstore
     2278             ,output v-default-value
     2279             ) .
     2280         end.
     2281         assign
     2282           v-diasize-proc-name = entry(1, program-name(2), '.')
     2283         .
     2284         if v-diasize-wndstore = true
     2285         then do:
     2286           assign
     2287             v-restore-saved = false
     2288           .
     2289           if connected("ub") = true
     2290           then do:
     2291             run gbl/wndsizer.p
     2292               (input  v-cntxt-db-num
     2293               ,input  v-cntxt-userid
     2294               ,input  v-diasize-proc-name
     2295               ,input  'height':u
     2296               ,output v-resize-value-str
     2297               ) .
     2298             if v-resize-value-str <> '':U
     2299             then do:
     2300               run diasize_change-height in this-procedure
     2301                 (input  integer(v-resize-value-str)
     2302                 ,input  true
     2303                 ) .
     2304               assign
     2305                 v-restore-saved = true
     2306               .
     2307             end.
     2308           end.
     2309           if connected("ub") = true
     2310           then do:
     2311             run gbl/wndsizer.p
     2312               (input  v-cntxt-db-num
     2313               ,input  v-cntxt-userid
     2314               ,input  v-diasize-proc-name
     2315               ,input  'width':u
     2316               ,output v-resize-value-str
     2317               ) .
     2318             if v-resize-value-str <> '':U
     2319             then do:
     2320               run diasize_change-width in this-procedure
     2321                 (input  integer(v-resize-value-str)
     2322                 ,input  true
     2323                 ) .
     2324               assign
     2325                 v-restore-saved = true
     2326               .
     2327             end.
     2328           end.
     2329           if v-restore-saved <> true
     2330           then do:
     2331             if v-diasize-wndmax = true
     2332             then do:
     2333               run diasize_maximize in this-procedure
     2334                 (input  true
     2335                 ) .
     2336             end.
     2337           end.
     2338         end.
     2339         else do:
     2340           if v-diasize-wndmax = true
     2341           then do:
     2342             run diasize_maximize in this-procedure
     2343               (input  true
     2344               ) .
     2345           end.
     2346         end.
     2347       end.
     2348     end.
     2349   end procedure.
     2350   procedure diasize_need-full-display :
     2351     define output parameter p-need-full-display as logical   no-undo .
     2352     do
     2353     on error undo, return error return-value
     2354     :
     2355       assign
     2356         p-need-full-display = v-diasize-need-full-display
     2357       .
     2358       assign
     2359         v-diasize-need-full-display = false
     2360       .
     2361     end.
     2362   end procedure.
     2363   procedure get-context :
     2364      define output parameter p-db-num as integer          no-undo.
     2365      define output parameter p-user-id as character        no-undo.
     2366      define variable v-login               as character    no-undo.
     2367      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2368      define buffer buf_user-login  for ub.user-login .
     2369      do
     2370      on error undo, return error
     2371      :
     2372            FIND FIRST buf_sys-ctrl no-lock.
     2373            ASSIGN
     2374               v-login = USERID("ub")
     2375               p-db-num = buf_sys-ctrl.db-num
     2376            .
     2377            FIND FIRST buf_user-login
     2378                 WHERE buf_user-login.db-num = p-db-num
     2379                   AND buf_user-login.user-login = v-login
     2380                 no-lock
     2381                 no-error
     2382                 .
     2383            IF AVAILABLE buf_user-login
     2384            THEN DO:
     2385               assign
     2386                  p-user-id = buf_user-login.user-id
     2387               .
     2388            END.
     2389      end.
     2390   end procedure.
     2391       run diasize_init in this-procedure .
     2392   MAIN-BLOCK:
     2393   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2394      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2395   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2396     run mainmenu_getcntxt in parparentproc
     2397       (output v-cntxt-db-num
     2398       ,output v-cntxt-userid
     2399       ,output v-cntxt-level
     2400       ,output v-cntxt-host-code-obj
     2401       ,output v-cntxt-obj-type
     2402       ,output v-cntxt-obj-code
     2403       ,output v-cntxt-db-num-obj
     2404       ,output v-cntxt-is-admin
     2405       ) .
     2406     if  p-mode <> 'ПРОСМОТР':U and
     2407         p-mode <> 'ИЗМЕНЕНИЕ':U
     2408     then do:
     2409         message
     2410         vss-workfile vss-revision vss-description skip
     2411         "Неверное значение параметра p-mode" p-mode
     2412         view-as alert-box error.
     2413         undo, return error.
     2414     end.
     2415     if p-obj-type <> 'БД':U and
     2416        p-obj-type <> '':U
     2417     then do:
     2418         message
     2419         vss-workfile vss-revision vss-description skip
     2420         "Неверное значение параметра p-obj-type" p-obj-type
     2421         view-as alert-box error.
     2422         undo, return error.
     2423     end.
     2424     if p-obj-type = 'БД':U then do:
     2425       find first X_db no-lock where X_db.db-num = p-obj-code no-error.
     2426       if not available X_db then do:
     2427           message
     2428           vss-workfile vss-revision vss-description skip
     2429           "Неверное значение параметра p-obj-code" p-obj-code
     2430           view-as alert-box error.
     2431           undo, return error.
     2432       end.
     2433     end.
     2434     if p-obj-type = '':U then do:
     2435       if v-cntxt-db-num <> 0
     2436       and p-mode <> 'ПРОСМОТР':U
     2437       then do:
     2438           MESSAGE
     2439           "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" skip
     2440           VIEW-AS ALERT-BOX ERROR.
     2441           UNDO, RETURN ERROR.
     2442       end.
     2443     end.
     2444     if p-obj-type = 'БД':U then do:
     2445       if v-cntxt-db-num <> 0
     2446       and p-mode <> 'ПРОСМОТР':U
     2447       and X_db.db-num <> v-cntxt-db-num
     2448       then do:
     2449           MESSAGE
     2450           "Нельзя менять параметры в чужой УБД" skip
     2451           VIEW-AS ALERT-BOX ERROR.
     2452           UNDO, RETURN ERROR.
     2453       end.
     2454     end.
     2455     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     2456       find first locked_thbj-attr exclusive-lock
     2457         where locked_thbj-attr.obj-type = p-obj-type
     2458           and locked_thbj-attr.obj-code = p-obj-code
     2459           and locked_thbj-attr.upper-prop-code = 'bge-export':U
     2460           and locked_thbj-attr.prop-code = "":u
     2461       no-wait no-error.
     2462       if locked locked_thbj-attr then do:
     2463         message
     2464           vss-workfile vss-revision vss-description skip
     2465             "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
     2466         view-as alert-box error .
     2467         undo, return error.
     2468       end.
     2469     end.
     2470     else do:
     2471       find first locked_thbj-attr no-lock
     2472       where locked_thbj-attr.obj-type = p-obj-type
     2473         and locked_thbj-attr.obj-code = p-obj-code
     2474         and locked_thbj-attr.upper-prop-code = 'bge-export':U
     2475         and locked_thbj-attr.prop-code = '':u
     2476       no-error.
     2477     end.
     2478     if not available locked_thbj-attr then do:
     2479       assign
     2480         v-to-create  = yes
     2481       .
     2482       message
     2483       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     2484                   chr(10))
     2485       view-as alert-box WARNING.
     2486     end.
     2487     assign
     2488       v-tth = buffer thbjattr_thbj-attr:table-handle
     2489     .
     2490     run fill-widgets in this-procedure no-error.
     2491     if error-status:error then undo, return error.
     2492     run my-enable in this-procedure .
     2493     WAIT-FOR GO OF FRAME Dialog-Frame.
     2494   END.
     2495   RUN disable_UI.
     2496   PROCEDURE check-bgeflnm :
     2497   END PROCEDURE.
     2498   PROCEDURE check-bgeflold :
     2499   do
     2500   on error undo, return error return-value
     2501   :
     2502     assign frame Dialog-Frame
     2503       cb-bgeflold
     2504     .
     2505     if cb-bgeflold = "var":u
     2506     then do:
     2507       enable
     2508         fi-bgeflnm
     2509       with frame Dialog-Frame.
     2510     end.
     2511     else do:
     2512       disable
     2513         fi-bgeflnm
     2514       with frame Dialog-Frame.
     2515     end.
     2516   end.
     2517   END PROCEDURE.
     2518   PROCEDURE check-bgefmt :
     2519   do
     2520   on error undo, return error return-value
     2521   :
     2522     assign frame Dialog-Frame
     2523       cb-bgefmt
     2524     .
     2525     if cb-bgefmt = "xml":u
     2526     then do:
     2527       enable
     2528         cb-bgeflold
     2529         fi-bgeflnm when cb-bgeflold = "var":u
     2530       with frame Dialog-Frame.
     2531     end.
     2532     else do:
     2533       disable
     2534         cb-bgeflold
     2535         fi-bgeflnm
     2536       with frame Dialog-Frame.
     2537     end.
     2538   end.
     2539   END PROCEDURE.
     2540   PROCEDURE check-bgeshift :
     2541   END PROCEDURE.
     2542   PROCEDURE disable_UI :
     2543     HIDE FRAME Dialog-Frame.
     2544   END PROCEDURE.
     2545   PROCEDURE enable_UI :
     2546     DISPLAY tg-bgeclall tg-bgedcard tg-bgedict cb-bgeshift cb-bgefmt cb-bgeflold
     2547             fi-bgeflnm
     2548         WITH FRAME Dialog-Frame.
     2549     ENABLE B-exit b-quit B-Help tg-bgeclall tg-bgedcard tg-bgedict cb-bgeshift
     2550            cb-bgefmt cb-bgeflold fi-bgeflnm b-mark b-add b-del br-tt-clients-iv
     2551         WITH FRAME Dialog-Frame.
     2552     VIEW FRAME Dialog-Frame.
     2553     OPEN QUERY br-tt-clients-iv FOR EACH tt-clients-iv NO-LOCK INDEXED-REPOSITION.
     2554   END PROCEDURE.
     2555   PROCEDURE fill-widgets :
     2556   define buffer buf_clients       for ub.clients.
     2557   define buffer buf_tt-clients-iv for tt-clients-iv.
     2558   define variable v-param-type      as character  no-undo .
     2559   define variable v-value-character as character  no-undo .
     2560   define variable v-value-date      as date       no-undo .
     2561   define variable v-value-decimal   as decimal    no-undo .
     2562   define variable v-value-integer   as integer    no-undo .
     2563   define variable v-value-logical   as logical    no-undo .
     2564   define variable v-entry           as character  no-undo .
     2565   define variable v-str             as character  no-undo .
     2566   define variable v-bgecliiv        as character  no-undo .
     2567   define variable v-obj-type        as character  no-undo .
     2568   define variable v-obj-code        as integer    no-undo .
     2569   define variable v-i               as integer    no-undo .
     2570   do
     2571   on error undo, return error return-value
     2572   :
     2573     empty temp-table thbjattr_thbj-attr.
     2574     empty temp-table temp-thbj-attr.
     2575     empty temp-table buf_tt-clients-iv.
     2576     run adm/shattri.p (
     2577                   input "init":U
     2578                 , input p-obj-type
     2579                 , input p-obj-code
     2580                 , input 'bge-export':U
     2581                 , input "":U
     2582                 , output v-value-character
     2583                 , output v-value-date
     2584                 , output v-value-decimal
     2585                 , output v-value-integer
     2586                 , output v-value-logical
     2587                 , output v-param-type
     2588                 , INPUT-OUTPUT table-handle v-tth
     2589                 ) no-error .
     2590     if error-status:error
     2591     and not available locked_thbj-attr then do:
     2592       message
     2593       "Не удалось получить начальные значения настроек" skip
     2594       error-status:get-message(1) return-value
     2595       view-as alert-box error .
     2596       undo, return error .
     2597     end.
     2598     for each thbjattr_thbj-attr:
     2599       assign
     2600         v-entry = thbjattr_thbj-attr.prop-code
     2601       .
     2602       case v-entry:
     2603         when 'bgeclall':U then do:
     2604           assign
     2605             tg-bgeclall = thbjattr_thbj-attr.property-value-logical
     2606             tg-bgeclall :private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2607           .
     2608         end.
     2609         when 'bgedcard':U then do:
     2610           assign
     2611             tg-bgedcard = thbjattr_thbj-attr.property-value-logical
     2612             tg-bgedcard :private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2613           .
     2614         end.
     2615         when 'bgedict':U then do:
     2616           assign
     2617             tg-bgedict = thbjattr_thbj-attr.property-value-logical
     2618             tg-bgedict :private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2619           .
     2620         end.
     2621         when 'bgeflnm':U then do:
     2622           assign
     2623             fi-bgeflnm = thbjattr_thbj-attr.property-value-character
     2624             fi-bgeflnm :private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2625           .
     2626         end.
     2627         when 'bgeflold':U then do:
     2628           assign
     2629             cb-bgeflold = thbjattr_thbj-attr.property-value-character
     2630             cb-bgeflold :private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2631           .
     2632         end.
     2633         when 'bgefmt':U then do:
     2634           assign
     2635             cb-bgefmt = thbjattr_thbj-attr.property-value-character
     2636             cb-bgefmt :private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2637           .
     2638         end.
     2639         when 'bgeshift':U then do:
     2640           assign
     2641             cb-bgeshift = thbjattr_thbj-attr.property-value-character
     2642             cb-bgeshift :private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2643           .
     2644         end.
     2645         when 'bgecliiv':U then do:
     2646           assign
     2647             v-bgecliiv = thbjattr_thbj-attr.property-value-character
     2648           .
     2649         end.
     2650       end case.
     2651       create temp-thbj-attr.
     2652       buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     2653     end.
     2654     _cli-cycle:
     2655     do v-i = 1 to num-entries(v-bgecliiv,';')
     2656     :
     2657       assign
     2658         v-str = entry( v-i , v-bgecliiv ,';')
     2659       .
     2660       if num-entries(v-str) = 2
     2661       then do:
     2662         assign
     2663           v-obj-type = entry(1, v-str)
     2664         .
     2665         assign
     2666           v-obj-code = integer( entry(2, v-str) )
     2667         no-error .
     2668         if error-status :error = yes
     2669         then do:
     2670           next _cli-cycle.
     2671         end.
     2672         find first buf_clients no-lock
     2673           where buf_clients.obj-type = v-obj-type
     2674             and buf_clients.obj-code = v-obj-code
     2675         no-error.
     2676         if available buf_clients
     2677         then do:
     2678           find first buf_tt-clients-iv no-lock
     2679             where buf_tt-clients-iv.obj-type = buf_clients.obj-type
     2680               and buf_tt-clients-iv.obj-code = buf_clients.obj-code
     2681           no-error .
     2682           if not available buf_tt-clients-iv
     2683           then do:
     2684             create buf_tt-clients-iv.
     2685             buffer-copy buf_clients to buf_tt-clients-iv.
     2686             release buf_tt-clients-iv.
     2687           end.
     2688         end.
     2689       end.
     2690     end.
     2691     run open-br in this-procedure .
     2692   end.
     2693   END PROCEDURE.
     2694   PROCEDURE my-enable :
     2695     if p-mode = 'ПРОСМОТР':U
     2696     then do:
     2697       assign
     2698         fi-bgeflnm  :fgcolor in frame Dialog-Frame = BROWN_COLOR
     2699         b-exit :hidden  = yes
     2700         b-quit :label   = "&Выход":U
     2701       .
     2702     end.
     2703     display
     2704       tg-bgeclall
     2705       tg-bgedcard
     2706       tg-bgedict
     2707       fi-bgeflnm
     2708       cb-bgeflold
     2709       cb-bgefmt
     2710       cb-bgeshift
     2711     with frame Dialog-Frame.
     2712     enable
     2713       b-exit      when p-mode = 'ИЗМЕНЕНИЕ':U
     2714       b-quit
     2715       b-help
     2716       b-mark      when p-mode = 'ИЗМЕНЕНИЕ':U
     2717       b-add       when p-mode = 'ИЗМЕНЕНИЕ':U
     2718       b-del       when p-mode = 'ИЗМЕНЕНИЕ':U
     2719       br-tt-clients-iv
     2720       tg-bgeclall when p-mode = 'ИЗМЕНЕНИЕ':U
     2721       tg-bgedcard when p-mode = 'ИЗМЕНЕНИЕ':U
     2722       tg-bgedict  when p-mode = 'ИЗМЕНЕНИЕ':U
     2723       fi-bgeflnm  when p-mode = 'ИЗМЕНЕНИЕ':U
     2724       cb-bgeflold when p-mode = 'ИЗМЕНЕНИЕ':U
     2725       cb-bgefmt   when p-mode = 'ИЗМЕНЕНИЕ':U
     2726       cb-bgeshift when p-mode = 'ИЗМЕНЕНИЕ':U
     2727     with frame Dialog-Frame.
     2728     view frame Dialog-Frame.
     2729   END PROCEDURE.
     2730   PROCEDURE open-br :
     2731   do
     2732   on error undo, return error return-value
     2733   :
     2734     OPEN QUERY br-tt-clients-iv FOR EACH tt-clients-iv NO-LOCK INDEXED-REPOSITION.
     2735   end.
     2736   END PROCEDURE.
     2737   PROCEDURE proc-b-add :
     2738     define buffer buf_clients       for ub.clients.
     2739     define buffer buf_tt-clients-iv for tt-clients-iv.
     2740     define variable v-rid-list  as character no-undo .
     2741     define variable v-i         as integer   no-undo .
     2742   do
     2743   on error undo, return error return-value
     2744   :
     2745     run ref/cli-all.w ( input parparentproc
     2746                       , input "b-sel,b-mark"
     2747                       , input 'все':U
     2748                       , input 'все':U
     2749                       , input 'текущие':U
     2750                       , input ?
     2751                       , input ",,,,,,NO,,"
     2752                       , input ""
     2753                       , output v-rid-list
     2754                       ) no-error.
     2755     if error-status :error = yes
     2756     then do:
     2757       message
     2758         "Ошибка при выборе контрагентов" skip
     2759         return-value skip
     2760         trim(error-status :get-message(1)) skip
     2761         trim(error-status :get-message(2)) skip
     2762       view-as alert-box information.
     2763     end.
     2764     do v-i = 1 to num-entries(v-rid-list)
     2765     :
     2766       find first buf_clients no-lock
     2767         where recid(buf_clients) = integer(entry(v-i,v-rid-list))
     2768       no-error .
     2769       if available buf_clients
     2770       then do:
     2771         find first buf_tt-clients-iv no-lock
     2772           where buf_tt-clients-iv.obj-type = buf_clients.obj-type
     2773             and buf_tt-clients-iv.obj-code = buf_clients.obj-code
     2774         no-error .
     2775         if not available buf_tt-clients-iv
     2776         then do:
     2777           create buf_tt-clients-iv.
     2778           buffer-copy buf_clients to buf_tt-clients-iv.
     2779         end.
     2780       end.
     2781     end.
     2782     run open-br in this-procedure .
     2783   end.
     2784   END PROCEDURE.
     2785   PROCEDURE proc-b-del :
     2786     define buffer buf_tt-clients-iv for tt-clients-iv.
     2787     define variable v-log   as logical   no-undo .
     2788   do
     2789   on error undo, return error return-value
     2790   :
     2791     find first buf_tt-clients-iv no-lock
     2792       where buf_tt-clients-iv.is-selected = yes
     2793     no-error .
     2794     if available buf_tt-clients-iv
     2795     then do:
     2796       message
     2797         "Удалить выделенные?"
     2798       view-as alert-box question buttons yes-no update v-log.
     2799       if v-log <> yes then return.
     2800       for each buf_tt-clients-iv
     2801         where buf_tt-clients-iv.is-selected = yes
     2802       :
     2803         delete buf_tt-clients-iv.
     2804       end.
     2805     end.
     2806     else do:
     2807       if available tt-clients-iv
     2808       then do:
     2809         message
     2810           tt-clients-iv.obj-name skip
     2811           "Удалить?"
     2812         view-as alert-box question buttons yes-no update v-log.
     2813         if v-log <> yes then return.
     2814         delete tt-clients-iv.
     2815       end.
     2816     end.
     2817     run open-br in this-procedure.
     2818   end.
     2819   END PROCEDURE.
     2820   PROCEDURE proc-b-mark :
     2821   do
     2822   on error undo, return error return-value
     2823   :
     2824     if available tt-clients-iv
     2825     then do:
     2826       assign
     2827         tt-clients-iv.is-selected = not tt-clients-iv.is-selected
     2828       .
     2829        br-tt-clients-iv:refresh() in frame Dialog-Frame.
     2830       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     2831         br-tt-clients-iv:select-next-row ().
     2832         apply "VALUE-CHANGED" to br-tt-clients-iv in frame Dialog-Frame.
     2833       end.
     2834     end.
     2835   end.
     2836   END PROCEDURE.
     2837   PROCEDURE proc-save :
     2838   define buffer buf_tt-clients-iv for tt-clients-iv.
     2839   define variable v-value-character as character      no-undo .
     2840   define variable v-value-date      as date           no-undo .
     2841   define variable v-value-decimal   as decimal        no-undo .
     2842   define variable v-value-integer   as integer        no-undo .
     2843   define variable v-value-logical   as logical        no-undo .
     2844   define variable v-sale-add        as character      no-undo .
     2845   define variable v-param-type      as character      no-undo .
     2846   define variable wh                as widget-handle  no-undo .
     2847   define variable fh                as widget-handle  no-undo .
     2848   define variable v-same            as logical        no-undo .
     2849   define variable v-bgecliiv        as character      no-undo .
     2850   do
     2851   on error undo, return error return-value
     2852   :
     2853     if p-mode = 'ПРОСМОТР':U then return error.
     2854     assign
     2855     frame Dialog-Frame
     2856       tg-bgeclall
     2857       tg-bgedcard
     2858       tg-bgedict
     2859       fi-bgeflnm
     2860       cb-bgeflold
     2861       cb-bgefmt
     2862       cb-bgeshift
     2863       fh = frame Dialog-Frame:first-child
     2864       wh = fh:first-child
     2865     .
     2866     for each buf_tt-clients-iv
     2867     :
     2868       assign
     2869         v-bgecliiv = v-bgecliiv + substitute( "&1,&2;"
     2870                                             , buf_tt-clients-iv.obj-type
     2871                                             , buf_tt-clients-iv.obj-code
     2872                                             )
     2873       .
     2874     end.
     2875     assign
     2876       v-bgecliiv = trim(v-bgecliiv , ',')
     2877     .
     2878     do while valid-handle(wh):
     2879       if wh:private-data begins "recid="
     2880       then do:
     2881         find first thbjattr_thbj-attr
     2882           where recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '='))
     2883         .
     2884         assign
     2885         buffer
     2886           thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value
     2887         .
     2888       end.
     2889       wh = wh:next-sibling.
     2890     end.
     2891     find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'bgecliiv':U.
     2892     assign
     2893       thbjattr_thbj-attr.property-value-character = v-bgecliiv
     2894     .
     2895     release thbjattr_thbj-attr.
     2896     assign
     2897       v-same = yes
     2898     .
     2899     for each thbjattr_thbj-attr,
     2900         first temp-thbj-attr
     2901           where temp-thbj-attr.obj-type         = thbjattr_thbj-attr.obj-type
     2902             and temp-thbj-attr.obj-code         = thbjattr_thbj-attr.obj-code
     2903             and temp-thbj-attr.upper-prop-code  = thbjattr_thbj-attr.upper-prop-code
     2904             and temp-thbj-attr.prop-code        = thbjattr_thbj-attr.prop-code
     2905     :
     2906       buffer-compare thbjattr_thbj-attr to temp-thbj-attr save result in v-same.
     2907       if not v-same then leave.
     2908     end.
     2909     if v-same  and not v-to-create then return.
     2910     run adm/shattri.p ( input "check":U
     2911                       , input p-obj-type
     2912                       , input p-obj-code
     2913                       , input 'bge-export':U
     2914                       , INPUT '':U
     2915                       , output v-value-character
     2916                       , output v-value-date
     2917                       , output v-value-decimal
     2918                       , output v-value-integer
     2919                       , output v-value-logical
     2920                       , output v-param-type
     2921                       , input-output table-handle v-tth
     2922                       ) no-error .
     2923     if error-status :error then do:
     2924       message
     2925         "Некорректное значение ПАРАМЕТРОВ"  skip
     2926         error-status:get-message(1)         skip
     2927         return-value
     2928       view-as alert-box error .
     2929       undo, return error .
     2930     end.
     2931     do transaction
     2932     on error undo, return error return-value
     2933     :
     2934       run thbjattr_set-section in this-procedure ( input p-obj-type
     2935                                                  , input p-obj-code
     2936                                                  , input 'bge-export':U
     2937                                                  , input table thbjattr_thbj-attr
     2938                                                  ) no-error.
     2939       if error-status:error then do:
     2940         message
     2941           error-status:get-message(1)  skip
     2942           return-value
     2943         view-as alert-box.
     2944         undo, return error.
     2945       end.
     2946     end.
     2947   end.
     2948   END PROCEDURE.
     2949   FUNCTION mark-selected RETURNS CHARACTER
     2950   ( buffer buf_tt-clients-iv for tt-clients-iv) :
     2951     return (if buf_tt-clients-iv.is-selected then '*' else '').
     2952   END FUNCTION.
