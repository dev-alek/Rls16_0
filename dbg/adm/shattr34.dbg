     1010        LABEL "Способ выгрузки сменных объектов"
     1011        VIEW-AS COMBO-BOX INNER-LINES 5
     1012        LIST-ITEMS "no-distinct","distinct"
     1013        DROP-DOWN-LIST
     1014        SIZE 16 BY 1 NO-UNDO.
     1015   DEFINE VARIABLE fi-bgeflnm AS CHARACTER FORMAT "X(256)":U
     1016        LABEL "Список шаблонов"
     1017        VIEW-AS FILL-IN
     1018        SIZE 46.5 BY 1 NO-UNDO.
     1019   DEFINE VARIABLE tg-bgeclall AS LOGICAL INITIAL no
     1020        LABEL "Экспорт всех объектов"
     1021        VIEW-AS TOGGLE-BOX
     1022        SIZE 50 BY .83 NO-UNDO.
     1023   DEFINE VARIABLE tg-bgedcard AS LOGICAL INITIAL no
     1024        LABEL "Удалять нули в начале номеров дисконтных карт"
     1025        VIEW-AS TOGGLE-BOX
     1026        SIZE 61.5 BY .83 NO-UNDO.
     1027   DEFINE VARIABLE tg-bgedict AS LOGICAL INITIAL no
     1028        LABEL "Экспорт видов оплат, типов кас. платежей и дисконтных карт"
     1029        VIEW-AS TOGGLE-BOX
     1030        SIZE 61.5 BY .83 NO-UNDO.
     1031   DEFINE QUERY br-tt-clients-iv FOR
     1032         tt-clients-iv SCROLLING.
     1033   DEFINE BROWSE br-tt-clients-iv
     1034     QUERY br-tt-clients-iv NO-LOCK DISPLAY
     1035         mark-selected(buffer tt-clients-iv) FORMAT "X(1)":U WIDTH 1
     1036         tt-clients-iv.obj-type FORMAT "X(3)":U
     1037         tt-clients-iv.obj-code FORMAT ">>>>>>>>9":U
     1038         tt-clients-iv.obj-name FORMAT "X(40)":U WIDTH 48.75
     1039       WITH NO-ROW-MARKERS SEPARATORS SIZE 64.5 BY 10
     1040            TITLE "Контрагенты для которых внешний приход экспортируется как внутренний" ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
     1041   DEFINE FRAME Dialog-Frame
     1042        B-exit AT ROW 1 COL 1 WIDGET-ID 2
     1043        b-quit AT ROW 1 COL 11 WIDGET-ID 6
     1044        B-Help AT ROW 1 COL 54.88 WIDGET-ID 4
     1045        tg-bgeclall AT ROW 3 COL 2 WIDGET-ID 8
     1046        tg-bgedcard AT ROW 4 COL 2 WIDGET-ID 10
     1047        tg-bgedict AT ROW 5 COL 2 WIDGET-ID 12
     1048        cb-bgeshift AT ROW 6 COL 33 COLON-ALIGNED WIDGET-ID 20
     1049        cb-bgefmt AT ROW 7 COL 33 COLON-ALIGNED WIDGET-ID 18
     1050        cb-bgeflold AT ROW 8 COL 33 COLON-ALIGNED WIDGET-ID 16
     1051        fi-bgeflnm AT ROW 9 COL 16.5 COLON-ALIGNED WIDGET-ID 14
     1052        b-mark AT ROW 10.5 COL 1 WIDGET-ID 26
     1053        b-add AT ROW 10.5 COL 4 WIDGET-ID 22
     1054        b-del AT ROW 10.5 COL 14 WIDGET-ID 24
     1055        br-tt-clients-iv AT ROW 11.5 COL 1 WIDGET-ID 200
     1056        SPACE(0.00) SKIP(0.12)
     1057       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1058            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1059            TITLE "Настройки экспорта" WIDGET-ID 100.
     1060   ASSIGN
     1061          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1062          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1063   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1064   DO:
     1065     APPLY "END-ERROR":U TO SELF.
     1066   END.
     1067   ON CHOOSE OF b-add IN FRAME Dialog-Frame
