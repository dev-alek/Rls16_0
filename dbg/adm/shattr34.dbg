      997   DEFINE VARIABLE cb-bgeflold AS CHARACTER FORMAT "X(256)":U
      998        LABEL "Варианты создания файла выгрузки"
      999        VIEW-AS COMBO-BOX INNER-LINES 5
     1000        LIST-ITEMS "old","var","new","firm","oracle"
     1001        DROP-DOWN-LIST
     1002        SIZE 16 BY 1 NO-UNDO.
     1003   DEFINE VARIABLE cb-bgefmt AS CHARACTER FORMAT "X(256)":U
     1004        LABEL "Форматы выгрузки"
     1005        VIEW-AS COMBO-BOX INNER-LINES 5
     1006        LIST-ITEMS "xml","dbf","analythic"
     1007        DROP-DOWN-LIST
     1008        SIZE 16 BY 1 NO-UNDO.
