        1   DEFINE BUFFER X_c-db FOR ub.c-db.
        2   define input  parameter parparentproc as   widget-handle no-undo .
        3   define input  parameter p-db-num      like ub.db.db-num  no-undo .
        4   def var vss-revision    as character no-undo init "$Revision$":U .
        5   def var vss-author      as character no-undo init "$Author$":U .
        6   def var vss-date        as character no-undo init "$Date$":U .
        7   def var vss-workfile    as character no-undo init "$Workfile$":U .
        8   def var vss-archive     as character no-undo init "$Archive$":U .
        9   def var vss-description as character no-undo init "Просмотр истории изменения записи БД".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   procedure proc-alt-shift-f2:
       80     if not ibs.th.gbl.gbl-var:rcode
       81   then
       82     run gbl\inidebug.p .
       83   end.
       84   procedure proc-alt-shift-f3:
       85     run gbl/prvssinf.p
       86       ( input this-procedure
       87       ) .
       88   end.
       89   define variable v-inform-launched as logical no-undo initial false .
       90   procedure proc-alt-shift-f4:
       91     define variable v-action as character no-undo .
       92     if v-inform-launched = false then do:
       93       assign
       94         v-inform-launched = true
       95       .
       96       run gbl/d-inform.w
       97         (  input self
       98         ,  input this-procedure
       99         , output v-action
      100         ) no-error .
      101       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      102       assign
      103         v-inform-launched = false
      104       .
      105     end.
      106   end.
      107   procedure proc-alt-f1:
      108     run gbl/corrhelp.p
      109       (input this-procedure
      110       ) .
      111   end .
      112   on alt-shift-f2 anywhere do:
      113     run proc-alt-shift-f2.
      114   end.
      115   on alt-shift-f3 anywhere do:
      116     run proc-alt-shift-f3 in this-procedure .
      117   end.
      118   on alt-shift-f4 anywhere do:
      119     run proc-alt-shift-f4 in this-procedure.
      120   end.
      121   on alt-f1 anywhere do:
      122     run proc-alt-f1 in this-procedure .
      123   end.
      124   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125   define variable v-waitfram-action01         as character   no-undo .
      126   define variable v-waitfram-action02         as character   no-undo .
      127   define variable v-waitfram-action03         as character   no-undo .
      128   define variable mWaitFramTextBeg            as character   no-undo.
      129   define variable mWaitFramTextEnd            as character   no-undo.
      130   define variable mWaitFramView               as logical     no-undo.
      131   define variable mWaitProcEvent              as logical     no-undo init yes.
      132   define variable mWaitFramInterval           as integer     no-undo init 1 .
      133   define variable mWaitFramStop               as logical     no-undo.
      134   define variable mWaitFramStopUser           as logical     no-undo.
      135   define variable mWaitFramStopTimeOut        as logical     no-undo.
      136   define variable mWaitFramStartProc          as datetime-tz no-undo.
      137   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      138   define button B-WaitFramStop auto-end-key
      139        label "Стоп"
      140        size 10 by 1 tooltip "Остоновить процесс".
      141   define button B-viewProcInfo
      142        label "Информация"
      143        size 15 by 1 tooltip "Информация о процесс".
      144   define frame waitfram
      145     v-waitfram-action01 format "x(72)" no-label skip
      146     v-waitfram-action02 format "x(72)" no-label skip
      147     v-waitfram-action03 format "x(72)" no-label skip
      148     B-viewProcInfo
      149     B-WaitFramStop at row 4 col 30
      150     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      151     .
      152   define new global shared variable mBatchMode as logical no-undo init ?.
      153   define variable mFramBachModHandle as handle no-undo.
      154   mFramBachModHandle = frame waitfram:handle.
      155   define variable mFameOldVis as logical no-undo.
      156   define variable mVisCUrentVin as logical no-undo.
      157   if session:batch-mode
      158   then
      159      mBatchMode = yes.
      160   if mBatchMode = ? then do:
      161     mVisCUrentVin = current-window:visible.
      162     mFameOldVis = mFramBachModHandle:visible.
      163     mFramBachModHandle:visible  = yes.
      164     mBatchMode = mFramBachModHandle:visible ne yes.
      165     mFramBachModHandle:visible = mFameOldVis.
      166     current-window:visible = mVisCUrentVin.
      167   end.
      168    if  log-manager:logfile-name ne ?
      169     then DO:
      170         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      171         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      172         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      173     end.
      174   on choose of B-WaitFramStop in frame waitfram
      175   do:
      176     mWaitFramStop = yes.
      177     mWaitFramStopUser = yes.
      178   end.
      179   function waitfram-check-timeout returns logical():
      180      define variable vtime as int64 no-undo.
      181      if mWaitFramStopTimeOut
      182      then
      183         return yes.
      184      vtime = ( now - mWaitFramStartProc ) / 1000 .
      185      if     mWaitFramTimeOut ne ?
      186         and mWaitFramTimeOut ne 0
      187         and mWaitFramTimeOut lt vtime
      188      then do:
      189         mWaitFramStopTimeOut = yes.
      190      end.
      191      return mWaitFramStopTimeOut.
      192   end.
      193   procedure waitfram-hide :
      194     if not session:batch-mode
      195     then do
      196     on error undo, return error return-value
      197     :
      198       pause 0 before-hide .
      199       if not mBatchMode then
      200         hide frame waitfram .
      201     if     not mWaitFramView
      202        and mWaitProcEvent
      203     then
      204       process events .
      205     end.
      206   end procedure.
      207   procedure waitfram-show :
      208     define input  parameter p-message as character no-undo .
      209     define variable v-left-margin as integer   no-undo .
      210     if not session:batch-mode
      211     then do
      212     on error undo, return error return-value
      213     :
      214       if length(p-message) <= 70 then do:
      215         assign
      216           v-left-margin = integer((70 - length(p-message)) / 2)
      217         .
      218         assign
      219           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      220         .
      221         assign
      222           v-waitfram-action01 = " "
      223           v-waitfram-action02 = " "
      224                                    + fill(" ", v-left-margin)
      225                                    + p-message
      226           v-waitfram-action03 = " "
      227         .
      228       end.
      229       else do:
      230         define variable vRindex1 as integer no-undo.
      231         define variable vRindex2 as integer no-undo.
      232         vRindex1 = r-index(p-message," ",70).
      233         if vRindex1 = 0
      234         then
      235            vRindex1 = 70.
      236         if length(p-message)  <= vRindex1 + 70 then do:
      237           assign
      238             v-waitfram-action01 = " "
      239             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      240             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      241           .
      242         end.
      243         else do:
      244           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      245           if vRindex2 <= vRindex1
      246           then
      247              vRindex2 = vRindex1 + 70.
      248           assign
      249             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      250             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      251             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      252           .
      253         end.
      254       end.
      255       B-viewProcInfo:visible   in frame waitfram = no.
      256       B-viewProcInfo:sensitive in frame waitfram = no.
      257       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      258       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      259       if  (   mWaitFramView
      260          or  mWaitProcEvent)
      261          and not mBatchMode
      262       then
      263          display
      264             v-waitfram-action01 skip
      265             v-waitfram-action02 skip
      266             v-waitfram-action03 skip
      267          with frame waitfram .
      268       if     mWaitFramView
      269          then do:
      270             if     mWaitFramInterval ne ?
      271                and not mBatchMode
      272             then
      273                wait-for go of frame waitfram pause mWaitFramInterval.
      274          end.
      275          else
      276             if     mWaitProcEvent
      277                and not mBatchMode
      278             then
      279                process events .
      280     end.
      281   end procedure.
      282      procedure waitfram-show-this:
      283         define input  parameter iInterval as int64 no-undo.
      284         define variable vtime as int64 no-undo.
      285         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      286         mWaitFramInterval = iInterval.
      287         run waitfram-show (substitute("&1&2 &3&4" ,
      288                                       mWaitFramTextBeg ,
      289                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      290                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      291                                       mWaitFramTextEnd
      292                                      )
      293                           ).
      294      end.
      295      procedure WaitFramRunPause:
      296         define input  parameter iInterval as dec no-undo.
      297         define variable vStart  as datetime-tz no-undo.
      298         define variable vend    as datetime-tz no-undo.
      299         define variable vint as int64 no-undo.
      300         define variable vOk as logical no-undo.
      301         vStart = now.
      302         vend   = vStart.
      303         publish "WaitFramPause" (iInterval,output vOk).
      304         vend   =  now.
      305         vint = vend - vStart.
      306         vint = iInterval - vint / 1000.
      307         if     not mWaitFramStop
      308            and (   vint > 0
      309                 or (    not vOk
      310                     and iInterval eq ?
      311                     )
      312                 )
      313         then
      314            run waitfram-show-this (iInterval).
      315         vend   =  now.
      316         vint = vend - vStart.
      317         vint = iInterval - vint / 1000.
      318         if     not mWaitFramStop
      319            and vint > 0
      320         then do:
      321            run gbl/pause.p (vint * 1000).
      322         end.
      323         if iInterval ne ?
      324         then
      325            publish "WaitFramStop".
      326         waitfram-check-timeout().
      327      end.
      328      procedure WaitFramWaitFor:
      329         define input  parameter iInterval as dec no-undo.
      330         assign
      331            mWaitFramStartProc   = now
      332            mWaitFramStopUser    = no
      333            mWaitFramStopTimeOut = no
      334         .
      335         block-wait:
      336         do while not mWaitFramStop:
      337            run WaitFramRunPause (iInterval).
      338            if  waitfram-check-timeout()
      339            then do:
      340               leave block-wait.
      341            end.
      342         end.
      343         run waitfram-hide.
      344      end.
      345   procedure waitfram-join :
      346     define input  parameter p-line-1  as character no-undo .
      347     define input  parameter p-line-2  as character no-undo .
      348     define input  parameter p-line-3  as character no-undo .
      349     define output parameter p-message as character no-undo .
      350     do
      351     on error undo, return error return-value
      352     :
      353       assign
      354         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      355                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      356                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      357       .
      358     end.
      359   end procedure.
      360   function waitfram-join-function returns character
      361     (input p-line-1 as character
      362     ,input p-line-2 as character
      363     ,input p-line-3 as character
      364     ).
      365     define variable v-message as character no-undo .
      366     run waitfram-join in this-procedure
      367       (input  p-line-1
      368       ,input  p-line-2
      369       ,input  p-line-3
      370       ,output v-message
      371       ) .
      372     return v-message .
      373   end function .
      374   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      375   function usrfulnf returns character ( input p-user-id as character):
      376   define variable v-user-name as character no-undo .
      377   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      378   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      379     (input  p-user-id
      380     ,output v-user-name
      381     ) no-error .
      382   if error-status:error
      383   or v-user-name = ""
      384   then do:
      385     return p-user-id.
      386   end.
      387   else do:
      388     return v-user-name.
      389   end.
      390   end function.
      391   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      392   define   temp-table temp-changes no-undo
      393   field f_name as character
      394   field l_name as character
      395   field v_old as character
      396   field v_new as character
      397   field t_name as character
      398   field num_ as integer
      399   field uniq-key-rec as character
      400   field action as integer
      401   field fNotChange as logical
      402   index pi is unique primary
      403   num_
      404   t_name
      405   f_name
      406   index
      407   Chan
      408   fnotChange
      409   t_name
      410   f_name
      411   index imain uniq-key-rec
      412   .
      413   FUNCTION get-all-fields returns character (p-file-name as character ):
      414   define variable v-dop as character no-undo .
      415     find first _file no-lock where _file._file-name = p-file-name no-error .
      416     if not available _file then return "":U.
      417     for each _field no-lock where
      418              _field._file-recid = recid(_file) :
      419       assign
      420       v-dop = v-dop + _field._field-name + chr(44)
      421       .
      422     end.
      423     return trim(v-dop).
      424   END FUNCTION.
      425   PROCEDURE proc-full-temp-changes :
      426     define input  parameter p-act-create as logical   no-undo .
      427     define input  parameter p-act-delete as logical   no-undo .
      428     define input  parameter p-hst-handle as handle    no-undo .
      429     define input  parameter p-main-table as character no-undo .
      430     define input  parameter p-field-list as character no-undo .
      431     define input  parameter p-label-form as character no-undo .
      432     define variable h-new-buf         as handle    no-undo .
      433     define variable h-main-buf        as handle    no-undo .
      434     define variable h-for-comp        as handle    no-undo .
      435     define variable v-inform          as character no-undo .
      436     define variable v-ind             as integer   no-undo .
      437     define variable v-idx-field-qnty  as integer   no-undo .
      438     define variable v-num-entries     as integer   no-undo .
      439     define variable fh                as handle    no-undo .
      440     define variable fh-main           as handle    no-undo .
      441     define variable fh-old            as handle    no-undo .
      442     define variable fh-new            as handle    no-undo .
      443     define variable v-field-name      as character no-undo .
      444     define variable v-field-lvl       as character no-undo .
      445     define variable v-field-form      as character no-undo .
      446     define variable v-search-exp      as character no-undo .
      447     define variable v-srch-main       as character no-undo .
      448     define variable v-word-link       as character no-undo .
      449     define variable v-av-chip-num     as logical   no-undo .
      450     define variable v-main-pi-fld-lst as character no-undo .
      451     define variable v-main-fld-lst    as character no-undo .
      452     define variable v-delim-list      as character no-undo .
      453     define variable v-label           as character no-undo .
      454     define variable v-old-value       as character no-undo case-sensitive.
      455     define variable v-new-value       as character no-undo case-sensitive.
      456     define variable v-chg-fields as character no-undo.
      457     for each temp-changes:
      458       delete temp-changes.
      459     end.
      460     if not p-hst-handle:available then do:
      461       return .
      462     end.
      463     create buffer h-new-buf  for table p-hst-handle .
      464     create buffer h-main-buf for table p-main-table .
      465     assign
      466       v-inform = h-main-buf:index-information(1)
      467       v-ind    = 2
      468     .
      469     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      470     on error undo, return error
      471     :
      472       assign
      473         v-inform = h-main-buf:index-information( v-ind )
      474         v-ind    = v-ind + 1
      475       .
      476     end.
      477     if v-inform = ?
      478       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      479       or entry( 3, v-inform, ",":U ) <> "1":U
      480     then do:
      481       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      482     end.
      483     assign
      484       v-idx-field-qnty = num-entries( v-inform ) - 4
      485     .
      486     if v-idx-field-qnty < 2 then do:
      487       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      488     end.
      489     assign
      490       v-srch-main   = "where":U
      491       v-word-link   = "":U
      492       v-av-chip-num = false
      493       v-delim-list  = "":U
      494     .
      495     do v-ind = 1 to v-idx-field-qnty by 2
      496     on error undo, return error
      497     :
      498       assign
      499         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      500         fh                = p-hst-handle:buffer-field( v-field-name )
      501         fh-main           = h-main-buf:buffer-field( v-field-name )
      502         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      503         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      504       .
      505       if fh:data-type ="character":U then do:
      506         assign
      507           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      508         .
      509       end.
      510       else do:
      511         assign
      512           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      513         .
      514       end.
      515       if v-delim-list = "":U then do:
      516         assign
      517           v-delim-list = ",":U
      518         .
      519       end.
      520       if v-word-link = "":U then do:
      521         assign
      522           v-word-link = "and":U
      523         .
      524       end.
      525     end.
      526     assign
      527       v-delim-list  = "":U
      528     .
      529     do v-ind = 1 to h-main-buf:num-fields
      530     on error undo, return error
      531     :
      532       assign
      533         fh-main      = h-main-buf:buffer-field( v-ind )
      534         v-field-name = fh-main:name
      535       .
      536         assign
      537           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      538         .
      539         if v-delim-list = "":U then do:
      540           assign
      541             v-delim-list = ",":U
      542           .
      543         end.
      544     end.
      545     assign
      546       v-inform = p-hst-handle:index-information(1)
      547       v-ind    = 2
      548     .
      549     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      550     on error undo, return error
      551     :
      552       assign
      553         v-inform = p-hst-handle:index-information( v-ind )
      554         v-ind    = v-ind + 1
      555       .
      556     end.
      557     if v-inform = ?
      558       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      559       or entry( 3, v-inform, ",":U ) <> "1":U
      560     then do:
      561       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      562     end.
      563     assign
      564       v-idx-field-qnty = num-entries( v-inform ) - 4
      565     .
      566     if v-idx-field-qnty < 2 then do:
      567       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      568     end.
      569     assign
      570       v-search-exp  = "where":U
      571       v-word-link   = "":U
      572       v-av-chip-num = false
      573     .
      574     do v-ind = 1 to v-idx-field-qnty by 2
      575     on error undo, return error
      576     :
      577       assign
      578         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      579         fh           = p-hst-handle:buffer-field( v-field-name )
      580         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      581       .
      582       if v-field-name = "chip-num":U then do:
      583         assign
      584           v-search-exp  = substitute( "&1 >", v-search-exp )
      585           v-av-chip-num = true
      586         .
      587       end.
      588       else do:
      589         assign
      590           v-search-exp = substitute( "&1 =", v-search-exp )
      591         .
      592       end.
      593       if fh:data-type ="character":U then do:
      594         assign
      595           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      596         .
      597       end.
      598       else do:
      599         assign
      600           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
      601         .
      602       end.
      603       if v-word-link = "":U then do:
      604         assign
      605           v-word-link = "and":U
      606         .
      607       end.
      608     end.
      609     if v-av-chip-num = false then do:
      610       message
      611         vss-workfile vss-revision vss-description skip
      612         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
      613         "Использование данной процедуры невозможно!" skip
      614         view-as alert-box error .
      615       return error .
      616     end.
      617     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
      618     if not h-new-buf:available then do:
      619       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
      620       if not h-main-buf:available then do:
      621         assign
      622           h-for-comp = ?
      623         .
      624       end.
      625       else do:
      626         assign
      627           h-for-comp = h-main-buf
      628         .
      629       end.
      630     end.
      631     else do:
      632       assign
      633         h-for-comp = h-new-buf
      634       .
      635     end.
      636     assign
      637       v-num-entries = num-entries( v-main-fld-lst, ",":U )
      638     .
      639     do v-ind = 1 to v-num-entries
      640     on error undo, return error return-value
      641     :
      642       assign
      643         v-field-name = entry( v-ind, v-main-fld-lst )
      644         fh-old       = p-hst-handle:buffer-field( v-field-name )
      645         v-old-value  = fh-old:buffer-value()
      646         v-label      = trim( fh-old:label )
      647       .
      648       if ( trim( p-field-list ) <> "":U
      649            and lookup( v-field-name, p-field-list ) > 0
      650          )
      651          or trim( p-field-list ) = "":U
      652       then do:
      653         if h-for-comp <> ? then do:
      654           assign
      655             fh-new      = h-for-comp:buffer-field( v-field-name )
      656             v-new-value = fh-new:buffer-value()
      657           .
      658         end.
      659         else do:
      660           assign
      661             v-new-value = "":U
      662           .
      663         end.
      664           if p-act-create = true then do:
      665             assign
      666               v-old-value = "":U
      667             .
      668           end.
      669           if p-act-delete = true then do:
      670             assign
      671               v-new-value = "":U
      672             .
      673           end.
      674         if v-old-value <> v-new-value
      675         then do:
      676           create temp-changes.
      677           assign
      678             temp-changes.t_name = p-main-table
      679             temp-changes.f_name = v-field-name
      680             temp-changes.l_name = replace( v-label, "&":U, "":U )
      681             temp-changes.v_old  = trim( v-old-value )
      682             temp-changes.v_new  = trim( v-new-value )
      683             temp-changes.num_   = 0
      684             temp-changes.fNotChange = v-old-value eq v-new-value
      685           .
      686         end.
      687       end.
      688     end.
      689     assign
      690       v-num-entries = num-entries( p-label-form, chr(8) )
      691     .
      692     do v-ind = 1 to v-num-entries
      693     on error undo, return error return-value
      694     :
      695       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
      696         assign
      697           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      698           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      699           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      700         .
      701         find first temp-changes
      702           where temp-changes.f_name = v-field-name
      703           no-error .
      704         if available temp-changes then do:
      705           if trim( v-field-lvl ) <> "":U then do:
      706             assign
      707               temp-changes.l_name = v-field-lvl
      708             .
      709           end.
      710           if trim( v-field-form ) <> "":U then do:
      711             assign
      712               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
      713             .
      714             if h-for-comp <> ? then do:
      715               assign
      716                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
      717               .
      718             end.
      719           end.
      720         end.
      721       end.
      722       else do:
      723         message
      724           vss-workfile vss-revision vss-description skip
      725           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
      726           substitute( "список для поля '&1': '&2'"
      727                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      728                       ,entry( v-ind, p-label-form, chr(8) )
      729                     ) skip
      730           substitute( "полный список: &2", p-label-form ) skip
      731           view-as alert-box error .
      732       end.
      733     end.
      734     delete object h-new-buf .
      735     delete object h-main-buf .
      736   END PROCEDURE.
      737   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      738   define variable c-point  as character no-undo .
      739   define variable tbl      as character no-undo .
      740   define variable join-tbl as character no-undo .
      741   define variable fld      as character no-undo .
      742   define variable lab      as character no-undo .
      743   define variable spr      as character no-undo .
      744   define variable dim      as character no-undo .
      745   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      746   procedure fltfield-clear :
      747     define output parameter loc-fld as character no-undo.
      748     define output parameter loc-lab as character no-undo .
      749     define output parameter loc-spr as character no-undo .
      750     define output parameter loc-dim as character no-undo .
      751     assign
      752       loc-fld = ""
      753       loc-lab = ""
      754       loc-spr = ""
      755       loc-dim = "0"
      756     .
      757   end procedure .
      758   procedure fltfield-add :
      759     define input        parameter par-fld as character no-undo.
      760     define input        parameter par-lab as character no-undo .
      761     define input        parameter par-spr as character no-undo .
      762     define input-output parameter loc-fld as character no-undo.
      763     define input-output parameter loc-lab as character no-undo .
      764     define input-output parameter loc-spr as character no-undo .
      765     define input-output parameter loc-dim as character no-undo .
      766     do
      767     on error undo, return error
      768     :
      769       assign
      770       loc-fld = if loc-dim = '0'
      771                 then par-fld
      772                 else (loc-fld + chr(44) + par-fld)
      773       loc-lab = if loc-dim = '0'
      774                 then par-lab
      775                 else (loc-lab + chr(44) + par-lab)
      776       loc-spr = if loc-dim = '0'
      777                 then par-spr
      778                 else (loc-spr + chr(44) + par-spr)
      779       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      780                 string(integer(if num-entries(loc-dim) > 1
      781                               then entry(2, loc-dim)
      782                               else entry(1, loc-dim)
      783                               ) + 1)
      784       no-error
      785       .
      786     end.
      787   end procedure.
      788   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      789   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      790   procedure fltopend_fltopend :
      791   define input parameter p-parent-handle as handle no-undo .
      792   define input parameter p-qh as handle no-undo .
      793   define input parameter p-flt-open-open-query  as character no-undo .
      794   define input parameter p-where-cond as character no-undo .
      795   define input parameter p-use-indFIRST-query-tail as character no-undo .
      796   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      797   define input parameter p-indexed-reposition as character no-undo .
      798     do
      799     on error undo, return error
      800     :
      801   define variable v-prepare-string as character no-undo .
      802   define variable glog as logical no-undo .
      803   assign
      804   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      805                      p-where-cond + chr(32)  +
      806                      p-use-indFIRST-query-tail + chr(32) +
      807                      p-use-ind-sort-clmn-by + chr(32) +
      808                      p-indexed-reposition
      809   .
      810   assign
      811   glog = p-qh:query-prepare(v-prepare-string) no-error .
      812   if not glog
      813   or error-status:error then do:
      814     message error-status:get-message(1) view-as alert-box .
      815     undo, return error .
      816   end.
      817   assign
      818   glog = p-qh:query-open no-error .
      819   if not glog
      820   or error-status:error then do:
      821     message error-status:get-message(1) view-as alert-box .
      822     undo, return error .
      823   end.
      824     end.
      825   end procedure.
      826   procedure fltopend_fltfindd :
      827   define input parameter p-parent-handle as handle no-undo .
      828   define input parameter p-qh as handle no-undo .
      829   define input parameter p-rowid as rowid no-undo .
      830   define input parameter p-next as logical no-undo .
      831   define input parameter p-lock as integer no-undo .
      832   define input parameter p-bh as handle no-undo .
      833   define input parameter p-where-cond as character no-undo .
      834   define input parameter p-use-index-phrase as character no-undo .
      835   define variable glog as logical no-undo .
      836   define variable v-qh as handle no-undo .
      837   define variable v-bh as handle no-undo .
      838   define variable v-recid as recid no-undo .
      839   define variable v-prepare-string as character no-undo .
      840   do
      841   on error undo, return error
      842   on stop undo, return error
      843   :
      844     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      845     create buffer v-bh for table p-bh buffer-name p-bh:name.
      846     create query v-qh.
      847     v-qh:set-buffers(v-bh).
      848     v-prepare-string = substitute("for each &1 &2 &3"
      849                                     ,v-bh:name
      850                                     ,p-where-cond
      851                                     ,p-use-index-phrase).
      852     glog = v-qh:query-prepare(v-prepare-string) no-error.
      853     if not glog then do:
      854       delete object v-qh.
      855       delete object v-bh.
      856       undo, return error .
      857     end.
      858     glog = v-qh:query-open no-error .
      859     if not glog then do:
      860       delete object v-qh.
      861       delete object v-bh.
      862       undo, return error .
      863     end.
      864     if p-next then do:
      865       v-qh:reposition-to-rowid(p-rowid) no-error .
      866       glog = v-qh:get-next( p-lock) no-error .
      867       glog = v-qh:get-next( p-lock) no-error .
      868       if not glog or v-qh:query-off-end = yes then do:
      869         glog = v-qh:get-first( p-lock) no-error .
      870       end.
      871     end.
      872     else do:
      873       glog = v-qh:get-first( p-lock) no-error .
      874     end.
      875     v-recid = v-bh:recid no-error .
      876     delete object v-qh.
      877     delete object v-bh.
      878     return string(v-recid) .
      879   end.
      880   end procedure.
      881   procedure fltopend_fltfindq :
      882   define input parameter p-parent-handle as handle no-undo .
      883   define input parameter p-qh as handle no-undo .
      884   define input parameter p-next as logical no-undo .
      885   define input parameter p-lock as integer no-undo .
      886   define input parameter p-flt-open-open-query  as character no-undo .
      887   define input parameter p-where-cond as character no-undo .
      888   define input parameter p-use-indFIRST-query-tail as character no-undo .
      889   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      890   define input parameter p-indexed-reposition as character no-undo .
      891   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      892   define variable glog as logical no-undo .
      893   define variable v-qh as handle no-undo .
      894   define variable v-bh as handle no-undo extent 18.
      895   define variable v-rowid as rowid no-undo extent 18.
      896   define variable v-ii as integer no-undo .
      897   define variable v-prepare-string as character no-undo .
      898   do
      899   on error undo, return error
      900   on stop undo, return error
      901   :
      902     create query v-qh.
      903     do v-ii = 1 to p-qh:num-buffers:
      904       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      905       assign
      906       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      907       no-error.
      908       v-qh:add-buffer(v-bh[v-ii]).
      909     end.
      910     assign
      911     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      912                       p-where-cond + chr(32)  +
      913                       p-use-indFIRST-query-tail + chr(32) +
      914                       p-use-ind-sort-clmn-by + chr(32) +
      915                       p-indexed-reposition
      916     .
      917     glog = v-qh:query-prepare( v-prepare-string) no-error .
      918     if not glog then do:
      919       delete object v-qh.
      920       do v-ii = 1 to p-qh:num-buffers:
      921         delete object v-bh[v-ii].
      922       end.
      923       undo, return error .
      924     end.
      925     glog = v-qh:query-open no-error .
      926     if not glog then do:
      927       delete object v-qh.
      928       do v-ii = 1 to p-qh:num-buffers:
      929         delete object v-bh[v-ii].
      930       end.
      931       undo, return error .
      932     end.
      933     if p-next then do:
      934       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      935       glog = v-qh:get-next( p-lock) no-error .
      936       glog = v-qh:get-next( p-lock) no-error .
      937       if not glog or v-qh:query-off-end = yes then do:
      938         glog = v-qh:get-first( p-lock) no-error .
      939       end.
      940     end.
      941     else do:
      942       glog = v-qh:get-first( p-lock) no-error .
      943     end.
      944     do v-ii = 1 to p-qh:num-buffers:
      945       assign
      946       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      947       no-error.
      948     end.
      949     delete object v-qh.
      950     do v-ii = 1 to p-qh:num-buffers:
      951       delete object v-bh[v-ii].
      952     end.
      953   end.
      954   end procedure.
      955   define variable v-hist-rec         as recid no-undo.
      956   define variable v-sort-column-name as character no-undo .
      957   define variable v-filter-pointr as character no-undo init "Просмотр истории изменения записи БД" .
      958   define variable v-filter-point0 as character no-undo init "db-hist" .
      959   define variable v-filter-point as character no-undo .
      960   FUNCTION get-action RETURNS CHARACTER
      961       ( p-action as integer )  FORWARD.
      962   DEFINE BUTTON b-help
      963        LABEL "Помо&щь"
      964        SIZE 3 BY 1
      965        BGCOLOR 8 .
      966   DEFINE BUTTON b-quit AUTO-END-KEY DEFAULT
      967        LABEL "&Выход"
      968        SIZE 10 BY 1
      969        BGCOLOR 8 .
      970   DEFINE BUTTON b-sch
      971        LABEL "&Фильтр"
      972        SIZE 3 BY 1.
      973   DEFINE QUERY BR-changes FOR
      974         temp-changes SCROLLING.
      975   DEFINE QUERY br-db-hist FOR X_c-db.
      976   DEFINE BROWSE BR-changes
      977     QUERY BR-changes DISPLAY
      978         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
      979   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
      980   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
      981       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 8.25.
      982   DEFINE BROWSE br-db-hist
      983     QUERY br-db-hist NO-LOCK DISPLAY
      984         X_c-db.corr-user-name column-label "Изменил" FORMAT "x(8)":U
      985         usrfulnf(X_c-db.corr-user-name) column-label "Изменил" FORMAT "x(15)":U
      986         X_c-db.corr-user-db-num COLUMN-LABEL "БД изм." FORMAT ">>>>9":U
      987         X_c-db.corr-date FORMAT "99/99/9999":U
      988         string(X_c-db.corr-time,"HH:MM:SS") COLUMN-LABEL "Время изм." FORMAT "x(8)":U
      989         get-action(X_c-db.action) COLUMN-LABEL "Действие" FORMAT "x(10)":U
      990         X_c-db.db-num
      991         X_c-db.db-name
      992         X_c-db.db-key
      993       WITH SEPARATORS SIZE 97 BY 11 ROW-HEIGHT-CHARS .58 FIT-LAST-COLUMN.
      994   DEFINE FRAME d-db-hist
      995        b-quit AT ROW 1 COL 2
      996        b-sch AT ROW 1 COL 93 WIDGET-ID 2
      997        b-help AT ROW 1 COL 96
      998        br-db-hist AT ROW 2.25 COL 2
      999        BR-changes AT ROW 14.25 COL 2
     1000        SPACE(0.87) SKIP(0.37)
     1001       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1002            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1003            TITLE "История изменения параметров конфигурации"
     1004            CANCEL-BUTTON b-quit.
     1005   ASSIGN
     1006          FRAME d-db-hist:SCROLLABLE       = FALSE.
     1007   ON WINDOW-CLOSE OF FRAME d-db-hist
     1008   DO:
     1009     APPLY "END-ERROR":U TO SELF.
     1010   END.
     1011   ON CHOOSE OF b-quit IN FRAME d-db-hist
     1012   DO:
     1013     define variable v-ok as logical   no-undo .
     1014   END.
     1015   ON CHOOSE OF b-sch IN FRAME d-db-hist
     1016   DO:
     1017     RUN proc-b-sch IN this-procedure NO-ERROR.
     1018   END.
     1019   ON VALUE-CHANGED OF br-db-hist IN FRAME d-db-hist
     1020   DO:
     1021     if available X_c-db then do:
     1022       run proc-full-temp-changes in this-procedure
     1023         ( input (X_c-db.action = 1 )
     1024          ,input (X_c-db.action = 99 )
     1025          ,input (buffer X_c-db:handle)
     1026          ,input 'db':U
     1027          ,input "":U
     1028          ,input "":U
     1029         ) no-error.
     1030     end.
     1031     else do:
     1032       for each temp-changes
     1033       :
     1034         delete temp-changes .
     1035       end.
     1036     end.
     1037     OPEN QUERY BR-changes FOR EACH temp-changes.
     1038   END.
     1039   if VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-db-hist:PARENT eq ?
     1040   THEN FRAME d-db-hist:PARENT = ACTIVE-WINDOW.
     1041   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1042   on help of frame d-db-hist
     1043   do:
     1044     run gbl/app_help.p
     1045       (input this-procedure :file-name
     1046       ,input ''
     1047       ,input ?
     1048       ) no-error.
     1049     if error-status :error then do:
     1050       message
     1051         "Ошибка при вызове помощи"
     1052         error-status :get-message(1)
     1053         view-as alert-box .
     1054     end.
     1055   end.
     1056   run minbtn-set in this-procedure .
     1057   on choose of b-help in frame d-db-hist
     1058   do:
     1059     apply "help":u to frame d-db-hist .
     1060   end.
     1061   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1062   procedure minbtn-set :
     1063       do
     1064           on error undo, return error return-value
     1065           :
     1066           define variable ii              as integer       no-undo .
     1067           define variable fh              as widget-handle no-undo .
     1068           define variable hh              as widget-handle no-undo .
     1069           define variable v-h             as handle        extent 4 no-undo .
     1070           define variable v-name-button   as character     no-undo .
     1071           define variable v-help-old-x    as decimal       no-undo .
     1072           define variable v-help-old-y    as decimal       no-undo .
     1073           define variable v-help-old-size as decimal       no-undo .
     1074           define variable v-frame-width   as decimal       no-undo .
     1075           define variable jj              as integer       no-undo .
     1076           do
     1077               on error undo, return error
     1078               :
     1079               assign
     1080                   v-frame-width = frame d-db-hist:width - 0.3
     1081                   fh            = frame d-db-hist:first-child
     1082                   hh            = fh:first-child
     1083                   ii            = 1
     1084                   .
     1085               do while valid-handle(hh):
     1086                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1087                   do:
     1088                       case lc(hh:name) :
     1089                           when "b-help" then
     1090                               do:
     1091                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1092                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1093                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1094                                   hh:TOOLTIP = "Помощь" .
     1095                                   v-help-old-x = hh:column .
     1096                                   v-help-old-y = hh:row    .
     1097                                   v-help-old-size = hh:width .
     1098                                   hh:width-chars = 2.5 .
     1099                               end.
     1100                           when "b-print" then
     1101                               do:
     1102                                   hh:load-image("cmp/b-print.bmp":u) .
     1103                                   hh:TOOLTIP = "Печать" .
     1104                                   v-h[ii] = hh:handle .
     1105                                   ii = ii + 1 .
     1106                                   hh:width-chars = 3 .
     1107                               end.
     1108                           when "b-history" or
     1109                           when "b-hist" then
     1110                               do:
     1111                                   hh:load-image("cmp/b-hist.bmp":u) .
     1112                                   hh:TOOLTIP = "История" .
     1113                                   v-h[ii] = hh:handle .
     1114                                   ii = ii + 1 .
     1115                                   hh:width-chars = 3 .
     1116                               end.
     1117                           when "b-sch" then
     1118                               do:
     1119                                   hh:load-image("cmp/b-sch.bmp":u) .
     1120                                   hh:TOOLTIP = "Установка Фильтра" .
     1121                                   v-h[ii] = hh:handle .
     1122                                   ii = ii + 1 .
     1123                                   hh:width-chars = 3 .
     1124                               end.
     1125                           when "b-hist-user" then
     1126                               do:
     1127                                   hh:load-image("cmp/b-hist.bmp":u) .
     1128                                   hh:TOOLTIP = "История пользователя" .
     1129                                   ii = ii + 1 .
     1130                               end.
     1131                       end case.
     1132                   end.
     1133                   hh = hh:next-sibling.
     1134               end.
     1135               b-help:column = v-frame-width - b-help:width-chars.
     1136               jj = 0.
     1137               repeat ii = 4 to 1 by -1 :
     1138                   if valid-handle (v-h[ii] ) then
     1139                   do:
     1140                       jj  = jj + 1 .
     1141                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1142                       v-h[ii]:row    = v-help-old-y .
     1143                   end.
     1144               end.
     1145           end.
     1146       end.
     1147   end procedure.
     1148   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1149   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1150   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1151   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1152   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1153   define variable v-diasize-current-frame-height as decimal   no-undo .
     1154   define variable v-diasize-change-size          as logical   no-undo .
     1155   define variable v-diasize-resize-button        as handle    no-undo .
     1156   define variable v-diasize-wndmax               as logical   no-undo .
     1157   define variable v-diasize-wndstore             as logical   no-undo .
     1158   define variable v-diasize-proc-name            as character no-undo .
     1159   define variable v-diasize-browse-handle        as handle    no-undo .
     1160   define variable v-diasize-browse-number        as integer   no-undo .
     1161   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1162   define temp-table temp-diasize-handle no-undo
     1163     field handle-value  as handle
     1164     field save-position as decimal
     1165     index xpk is primary unique handle-value
     1166     .
     1167   define temp-table temp-browse-handle no-undo
     1168     field browse-type   as character
     1169     field browse-number as integer
     1170     field browse-handle as handle
     1171     field original-size as decimal
     1172     index xpk is primary unique browse-type browse-number
     1173     index xie browse-type browse-handle
     1174   .
     1175   procedure diasize_change-height :
     1176     define input  parameter p-change-value  as decimal   no-undo .
     1177     define input  parameter p-move-resize   as logical   no-undo .
     1178     define variable v-field-group-handle    as handle    no-undo .
     1179     define variable v-object-handle         as handle    no-undo .
     1180     define variable v-frame-height          as decimal   no-undo .
     1181     define variable v-frame-virtual-height  as decimal   no-undo .
     1182     define variable v-browse-height         as decimal   no-undo .
     1183     define variable v-window-height         as decimal   no-undo .
     1184     define variable v-window-virtual-height as decimal   no-undo .
     1185     define variable v-change-sign           as integer   no-undo .
     1186     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1187     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1188     if p-change-value > 0
     1189     then do:
     1190       if frame d-db-hist :height + p-change-value
     1191           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1192       then do:
     1193         assign
     1194           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1195                           - (frame d-db-hist :height-chars)
     1196         .
     1197         if p-change-value <= 0
     1198         then do:
     1199           run diasize_position-resize-button in this-procedure .
     1200           return .
     1201         end.
     1202       end.
     1203     end.
     1204     if p-change-value < 0
     1205     then do:
     1206       if frame d-db-hist :height + p-change-value < v-diasize-orig-frame-height
     1207       then do:
     1208         assign
     1209           p-change-value = v-diasize-orig-frame-height
     1210                          - (frame d-db-hist :height-chars)
     1211         .
     1212         if p-change-value >= 0
     1213         then do:
     1214           run diasize_position-resize-button in this-procedure .
     1215           return .
     1216         end.
     1217       end.
     1218     end.
     1219     if p-change-value >= 0
     1220     then do:
     1221       assign
     1222         v-change-sign = 1
     1223       .
     1224     end.
     1225     else do:
     1226       assign
     1227         v-change-sign = -1
     1228       .
     1229     end.
     1230     assign
     1231       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1232     .
     1233     if p-change-value = 0
     1234     then do:
     1235       run diasize_position-resize-button in this-procedure .
     1236       return .
     1237     end.
     1238     move_block:
     1239     do
     1240     on error undo move_block, retry move_block
     1241     :
     1242       if retry
     1243       then do:
     1244         do
     1245         on error undo move_block, leave move_block
     1246         :
     1247           if p-change-value > 0
     1248           then do:
     1249             for each buf_temp-diasize-handle
     1250             on error undo, next
     1251             :
     1252               assign
     1253                 v-object-handle = buf_temp-diasize-handle.handle-value
     1254               .
     1255               if v-object-handle <> v-diasize-resize-button
     1256               then do:
     1257                 assign
     1258                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1259                 .
     1260               end.
     1261             end.
     1262             assign
     1263               v-diasize-browse-handle :height = v-browse-height
     1264             .
     1265             for each buf_temp-browse-handle
     1266               where buf_temp-browse-handle.browse-type = 'height':u
     1267             on error undo, next
     1268             :
     1269               assign
     1270                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1271               .
     1272             end.
     1273             assign
     1274               frame d-db-hist :height = v-frame-height
     1275             .
     1276             if frame d-db-hist :scrollable = true
     1277             then do:
     1278               assign
     1279                 frame d-db-hist :virtual-height = v-frame-virtual-height
     1280               .
     1281             end.
     1282             run diasize_position-resize-button in this-procedure .
     1283           end.
     1284           else do:
     1285             if frame d-db-hist :scrollable = true
     1286             then do:
     1287               assign
     1288                 frame d-db-hist :virtual-height = v-frame-virtual-height
     1289               .
     1290             end.
     1291             assign
     1292               frame d-db-hist :height = v-frame-height
     1293             .
     1294             assign
     1295               v-diasize-browse-handle :height = v-browse-height
     1296             .
     1297             for each buf_temp-browse-handle
     1298               where buf_temp-browse-handle.browse-type = 'height':u
     1299             on error undo, next
     1300             :
     1301               assign
     1302                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1303               .
     1304             end.
     1305             for each buf_temp-diasize-handle
     1306             on error undo, next
     1307             :
     1308               assign
     1309                 v-object-handle = buf_temp-diasize-handle.handle-value
     1310               .
     1311               if v-object-handle <> v-diasize-resize-button
     1312               then do:
     1313                 assign
     1314                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1315                 .
     1316               end.
     1317             end.
     1318             run diasize_position-resize-button in this-procedure .
     1319           end.
     1320           assign
     1321             v-diasize-change-size = false
     1322           .
     1323           leave move_block .
     1324         end.
     1325       end.
     1326       assign
     1327         v-diasize-need-full-display = true
     1328       .
     1329       if v-diasize-change-size = false
     1330       then do:
     1331         assign
     1332           v-diasize-change-size = true
     1333         .
     1334       end.
     1335       else do:
     1336         return .
     1337       end.
     1338       assign
     1339         v-frame-height = frame d-db-hist :height
     1340         v-frame-virtual-height = frame d-db-hist :virtual-height
     1341         v-browse-height = v-diasize-browse-handle :height
     1342       .
     1343       for each buf_temp-browse-handle
     1344         where buf_temp-browse-handle.browse-type = 'height':u
     1345       :
     1346         assign
     1347           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1348         .
     1349       end.
     1350       for each buf_temp-diasize-handle
     1351       :
     1352         delete buf_temp-diasize-handle .
     1353       end.
     1354       assign
     1355         v-field-group-handle = frame d-db-hist :first-child
     1356       .
     1357       do while valid-handle(v-field-group-handle)
     1358       :
     1359         assign
     1360           v-object-handle = v-field-group-handle :first-child
     1361         .
     1362         do while valid-handle(v-object-handle)
     1363         :
     1364           if  v-object-handle <> v-diasize-browse-handle :handle
     1365           and can-query(v-object-handle, "row")
     1366           and can-query(v-object-handle, "height")
     1367           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1368           then do:
     1369             find first buf_temp-browse-handle
     1370               where buf_temp-browse-handle.browse-type   = 'height':u
     1371                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1372               no-error .
     1373             if available buf_temp-browse-handle
     1374             then do:
     1375             end.
     1376             else do:
     1377               create buf_temp-diasize-handle .
     1378               assign
     1379                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1380                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1381               .
     1382             end.
     1383           end.
     1384           assign
     1385             v-object-handle = v-object-handle :next-sibling
     1386           .
     1387         end.
     1388         assign
     1389           v-field-group-handle = v-field-group-handle :next-sibling
     1390         .
     1391       end.
     1392       do with frame d-db-hist
     1393       :
     1394         hide v-diasize-resize-button .
     1395         assign
     1396           v-diasize-resize-button :row    = 1
     1397           v-diasize-resize-button :column = 1
     1398         .
     1399       end.
     1400       if p-change-value > 0
     1401       then do:
     1402         if frame d-db-hist :scrollable = true
     1403         then do:
     1404           assign
     1405             frame d-db-hist :virtual-height = frame d-db-hist :virtual-height + p-change-value
     1406             no-error .
     1407           if error-status :error
     1408           or error-status :get-message(1) <> ""
     1409           then do:
     1410             undo move_block, retry move_block .
     1411           end.
     1412         end.
     1413         assign
     1414           frame d-db-hist :height = frame d-db-hist :height + p-change-value
     1415           no-error .
     1416         if error-status :error
     1417         or error-status :get-message(1) <> ""
     1418         then do:
     1419           undo move_block, retry move_block .
     1420         end.
     1421         assign
     1422           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1423           no-error .
     1424         if error-status :error
     1425         or error-status :get-message(1) <> ""
     1426         then do:
     1427           undo move_block, retry move_block .
     1428         end.
     1429         for each buf_temp-browse-handle
     1430           where buf_temp-browse-handle.browse-type = 'height':u
     1431         on error undo move_block, retry move_block
     1432         :
     1433           assign
     1434             buf_temp-browse-handle.browse-handle :height
     1435               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1436             no-error .
     1437           if error-status :error
     1438           or error-status :get-message(1) <> ""
     1439           then do:
     1440             undo move_block, retry move_block .
     1441           end.
     1442         end.
     1443         for each buf_temp-diasize-handle
     1444         on error undo move_block, retry move_block
     1445         :
     1446           assign
     1447             v-object-handle = buf_temp-diasize-handle.handle-value
     1448           .
     1449           if v-object-handle <> v-diasize-resize-button
     1450           then do:
     1451             assign
     1452               v-object-handle :row = v-object-handle :row + p-change-value
     1453               no-error .
     1454             if error-status :error
     1455             or error-status :get-message(1) <> ""
     1456             then do:
     1457               undo move_block, retry move_block .
     1458             end.
     1459           end.
     1460         end.
     1461       end.
     1462       else do:
     1463         for each buf_temp-diasize-handle
     1464         on error undo move_block, retry move_block
     1465         :
     1466           assign
     1467             v-object-handle = buf_temp-diasize-handle.handle-value
     1468           .
     1469           if v-object-handle <> v-diasize-resize-button
     1470           then do:
     1471             assign
     1472               v-object-handle :row = v-object-handle :row + p-change-value
     1473               no-error .
     1474             if error-status :error
     1475             or error-status :get-message(1) <> ""
     1476             then do:
     1477               undo move_block, retry move_block .
     1478             end.
     1479           end.
     1480         end.
     1481         assign
     1482           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1483           no-error .
     1484         if error-status :error
     1485         or error-status :get-message(1) <> ""
     1486         then do:
     1487           undo move_block, retry move_block .
     1488         end.
     1489         for each buf_temp-browse-handle
     1490           where buf_temp-browse-handle.browse-type = 'height':u
     1491         on error undo move_block, retry move_block
     1492         :
     1493           assign
     1494             buf_temp-browse-handle.browse-handle :height
     1495               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1496             no-error .
     1497           if error-status :error
     1498           or error-status :get-message(1) <> ""
     1499           then do:
     1500             undo move_block, retry move_block .
     1501           end.
     1502         end.
     1503         assign
     1504           frame d-db-hist :height = frame d-db-hist :height + p-change-value
     1505           no-error .
     1506         if error-status :error
     1507         or error-status :get-message(1) <> ""
     1508         then do:
     1509           undo move_block, retry move_block .
     1510         end.
     1511         if frame d-db-hist :scrollable = true
     1512         then do:
     1513           assign
     1514             frame d-db-hist :virtual-height = frame d-db-hist :virtual-height + p-change-value
     1515             no-error .
     1516           if error-status :error
     1517           or error-status :get-message(1) <> ""
     1518           then do:
     1519             undo move_block, retry move_block .
     1520           end.
     1521         end.
     1522       end.
     1523       if p-move-resize = true
     1524       then do:
     1525         run diasize_position-resize-button in this-procedure .
     1526       end.
     1527       if v-diasize-wndstore = true
     1528       then do:
     1529         if connected("ub") = true
     1530         then do:
     1531           define variable v-cntxt-db-num        as integer   no-undo .
     1532           define variable v-cntxt-userid        as character no-undo .
     1533           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1534                                             , OUTPUT v-cntxt-userid
     1535                                             ) .
     1536           run gbl/wndsizew.p
     1537             (input  v-cntxt-db-num
     1538             ,input  v-cntxt-userid
     1539             ,input  v-diasize-proc-name
     1540             ,input  'height':u
     1541             ,input  string(frame d-db-hist :height - v-diasize-orig-frame-height)
     1542             ) .
     1543         end.
     1544       end.
     1545     end.
     1546     assign
     1547       v-diasize-change-size = false
     1548     .
     1549   end procedure.
     1550   procedure diasize_set-height :
     1551     define input  parameter p-new-height  as decimal   no-undo .
     1552     define input  parameter p-move-resize as logical   no-undo .
     1553     do
     1554     on error undo, return error return-value
     1555     :
     1556       run diasize_change-height in this-procedure
     1557         (input  (p-new-height - frame d-db-hist :height)
     1558         ,input  p-move-resize
     1559         ) .
     1560     end.
     1561   end procedure.
     1562   procedure diasize_change-width :
     1563     define input  parameter p-change-value as decimal   no-undo .
     1564     define input  parameter p-move-resize  as logical   no-undo .
     1565     define variable v-field-group-handle   as handle    no-undo .
     1566     define variable v-object-handle        as handle    no-undo .
     1567     define variable v-frame-width          as decimal   no-undo .
     1568     define variable v-frame-virtual-width  as decimal   no-undo .
     1569     define variable v-browse-width         as decimal   no-undo .
     1570     define variable v-window-width         as decimal   no-undo .
     1571     define variable v-window-virtual-width as decimal   no-undo .
     1572     define variable v-change-sign          as integer   no-undo .
     1573     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1574     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1575     if p-change-value > 0
     1576     then do:
     1577       if frame d-db-hist :width + p-change-value >
     1578           session :width-chars
     1579       then do:
     1580         assign
     1581           p-change-value = session :width-chars - frame d-db-hist :width
     1582         .
     1583         if p-change-value <= 0
     1584         then do:
     1585           run diasize_position-resize-button in this-procedure .
     1586           return .
     1587         end.
     1588       end.
     1589     end.
     1590     if p-change-value < 0
     1591     then do:
     1592       if frame d-db-hist :width + p-change-value < v-diasize-orig-frame-width
     1593       then do:
     1594         assign
     1595           p-change-value = v-diasize-orig-frame-width
     1596                          - frame d-db-hist :width
     1597         .
     1598         if p-change-value >= 0
     1599         then do:
     1600           run diasize_position-resize-button in this-procedure .
     1601           return .
     1602         end.
     1603       end.
     1604     end.
     1605     if p-change-value >= 0
     1606     then do:
     1607       assign
     1608         v-change-sign = 1
     1609       .
     1610     end.
     1611     else do:
     1612       assign
     1613         v-change-sign = -1
     1614       .
     1615     end.
     1616     assign
     1617       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1618     .
     1619     if p-change-value = 0
     1620     then do:
     1621       run diasize_position-resize-button in this-procedure .
     1622       return .
     1623     end.
     1624     move_block:
     1625     do
     1626     on error undo move_block, leave move_block
     1627     :
     1628       if retry
     1629       then do:
     1630         do
     1631         on error undo move_block, leave move_block
     1632         :
     1633           if p-change-value > 0
     1634           then do:
     1635             for each buf_temp-diasize-handle
     1636             on error undo, next
     1637             :
     1638               assign
     1639                 v-object-handle = buf_temp-diasize-handle.handle-value
     1640               .
     1641               if v-object-handle <> v-diasize-resize-button
     1642               then do:
     1643                 assign
     1644                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1645                 .
     1646               end.
     1647             end.
     1648             assign
     1649               v-diasize-browse-handle :width = v-browse-width
     1650             .
     1651             for each buf_temp-browse-handle
     1652               where buf_temp-browse-handle.browse-type = 'width':u
     1653             on error undo, next
     1654             :
     1655               assign
     1656                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1657               .
     1658             end.
     1659             assign
     1660               frame d-db-hist :width = v-frame-width
     1661             .
     1662             if frame d-db-hist :scrollable = true
     1663             then do:
     1664               assign
     1665                 frame d-db-hist :virtual-width = v-frame-virtual-width
     1666               .
     1667             end.
     1668             run diasize_position-resize-button in this-procedure .
     1669           end.
     1670           else do:
     1671             if frame d-db-hist :scrollable = true
     1672             then do:
     1673               assign
     1674                 frame d-db-hist :virtual-width = v-frame-virtual-width
     1675               .
     1676             end.
     1677             assign
     1678               frame d-db-hist :width = v-frame-width
     1679             .
     1680             for each buf_temp-browse-handle
     1681               where buf_temp-browse-handle.browse-type = 'width':u
     1682             on error undo, next
     1683             :
     1684               assign
     1685                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1686               .
     1687             end.
     1688             assign
     1689               v-diasize-browse-handle :width = v-browse-width
     1690             .
     1691             for each buf_temp-diasize-handle
     1692             on error undo, next
     1693             :
     1694               assign
     1695                 v-object-handle = buf_temp-diasize-handle.handle-value
     1696               .
     1697               if v-object-handle <> v-diasize-resize-button
     1698               then do:
     1699                 assign
     1700                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1701                 .
     1702               end.
     1703             end.
     1704             run diasize_position-resize-button in this-procedure .
     1705           end.
     1706           assign
     1707             v-diasize-change-size = false
     1708           .
     1709           leave move_block .
     1710         end.
     1711       end.
     1712       assign
     1713         v-diasize-need-full-display = true
     1714       .
     1715       if v-diasize-change-size = false
     1716       then do:
     1717         assign
     1718           v-diasize-change-size = true
     1719         .
     1720       end.
     1721       else do:
     1722         return .
     1723       end.
     1724       assign
     1725         v-frame-width = frame d-db-hist :width
     1726         v-frame-virtual-width = frame d-db-hist :virtual-width
     1727         v-browse-width = v-diasize-browse-handle :width
     1728       .
     1729       for each buf_temp-browse-handle
     1730         where buf_temp-browse-handle.browse-type = 'width':u
     1731       :
     1732         assign
     1733           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1734         .
     1735       end.
     1736       for each buf_temp-diasize-handle
     1737       :
     1738         delete buf_temp-diasize-handle .
     1739       end.
     1740       assign
     1741         v-field-group-handle = frame d-db-hist :first-child
     1742       .
     1743       do while valid-handle(v-field-group-handle)
     1744       :
     1745         assign
     1746           v-object-handle = v-field-group-handle :first-child
     1747         .
     1748         do while valid-handle(v-object-handle)
     1749         :
     1750           if  v-object-handle <> v-diasize-browse-handle :handle
     1751           and v-object-handle <> v-diasize-resize-button
     1752           and can-query(v-object-handle, "row")
     1753           and can-query(v-object-handle, "height")
     1754           and ( v-object-handle :col + v-object-handle :width
     1755                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1756               )
     1757           then do:
     1758             find first buf_temp-browse-handle
     1759               where buf_temp-browse-handle.browse-type   = 'width':u
     1760                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1761               no-error .
     1762             if available buf_temp-browse-handle
     1763             then do:
     1764             end.
     1765             else do:
     1766               create buf_temp-diasize-handle .
     1767               assign
     1768                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1769                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1770               .
     1771             end.
     1772           end.
     1773           assign
     1774             v-object-handle = v-object-handle :next-sibling
     1775           .
     1776         end.
     1777         assign
     1778           v-field-group-handle = v-field-group-handle :next-sibling
     1779         .
     1780       end.
     1781       do with frame d-db-hist
     1782       :
     1783         hide v-diasize-resize-button .
     1784         v-diasize-resize-button :row = 1.
     1785         v-diasize-resize-button :column = 1.
     1786       end.
     1787       if p-change-value > 0
     1788       then do:
     1789         if frame d-db-hist :scrollable = true
     1790         then do:
     1791           assign
     1792             frame d-db-hist :virtual-width = frame d-db-hist :virtual-width + p-change-value
     1793             no-error .
     1794           if error-status :error
     1795           or error-status :get-message(1) <> ""
     1796           then do:
     1797             undo move_block, retry move_block.
     1798           end.
     1799         end.
     1800         assign
     1801           frame d-db-hist :width = v-frame-width + p-change-value
     1802           no-error .
     1803         if error-status :error
     1804         or error-status :get-message(1) <> ""
     1805         then do:
     1806           undo move_block, retry move_block.
     1807         end.
     1808         assign
     1809           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1810         no-error .
     1811         if error-status :error
     1812         or error-status :get-message(1) <> ""
     1813         then do:
     1814           undo move_block, retry move_block.
     1815         end.
     1816         for each buf_temp-browse-handle
     1817           where buf_temp-browse-handle.browse-type = 'width':u
     1818         on error undo move_block, retry move_block
     1819         :
     1820           assign
     1821             buf_temp-browse-handle.browse-handle :width
     1822               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1823             no-error .
     1824           if error-status :error
     1825           or error-status :get-message(1) <> ""
     1826           then do:
     1827             undo move_block, retry move_block .
     1828           end.
     1829         end.
     1830         for each buf_temp-diasize-handle
     1831         on error undo move_block, retry move_block
     1832         :
     1833           assign
     1834             v-object-handle = buf_temp-diasize-handle.handle-value
     1835           .
     1836           if v-object-handle <> v-diasize-resize-button
     1837           then do:
     1838             assign
     1839               v-object-handle :col = v-object-handle :col + p-change-value
     1840               no-error .
     1841             if error-status :error
     1842             or error-status :get-message(1) <> ""
     1843             then do:
     1844               undo move_block, retry move_block .
     1845             end.
     1846           end.
     1847         end.
     1848       end.
     1849       else do:
     1850         for each buf_temp-diasize-handle
     1851         on error undo move_block, retry move_block
     1852         :
     1853           assign
     1854             v-object-handle = buf_temp-diasize-handle.handle-value
     1855           .
     1856           if v-object-handle <> v-diasize-resize-button
     1857           then do:
     1858             assign
     1859               v-object-handle :col = v-object-handle :col + p-change-value
     1860               no-error .
     1861             if error-status :error
     1862             or error-status :get-message(1) <> ""
     1863             then do:
     1864               undo move_block, retry move_block .
     1865             end.
     1866           end.
     1867         end.
     1868         for each buf_temp-browse-handle
     1869           where buf_temp-browse-handle.browse-type = 'width':u
     1870         on error undo move_block, retry move_block
     1871         :
     1872           assign
     1873             buf_temp-browse-handle.browse-handle :width
     1874               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1875             no-error .
     1876           if error-status :error
     1877           or error-status :get-message(1) <> ""
     1878           then do:
     1879             undo move_block, retry move_block .
     1880           end.
     1881         end.
     1882         assign
     1883           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1884           no-error .
     1885         if error-status :error
     1886         or error-status :get-message(1) <> ""
     1887         then do:
     1888           undo move_block, retry move_block.
     1889         end.
     1890         assign
     1891           frame d-db-hist :width = frame d-db-hist :width + p-change-value
     1892         no-error .
     1893         if error-status :error
     1894         or error-status :get-message(1) <> ""
     1895         then do:
     1896           undo move_block, retry move_block.
     1897         end.
     1898         if frame d-db-hist :scrollable = true
     1899         then do:
     1900           assign
     1901             frame d-db-hist :virtual-width = frame d-db-hist :virtual-width + p-change-value
     1902           no-error .
     1903           if error-status :error
     1904           or error-status :get-message(1) <> ""
     1905           then do:
     1906             undo move_block, retry move_block.
     1907           end.
     1908         end.
     1909       end.
     1910       if p-move-resize
     1911       then do:
     1912         run diasize_position-resize-button in this-procedure .
     1913       end.
     1914       if v-diasize-wndstore = true
     1915       then do:
     1916         if connected("ub") = true
     1917         then do:
     1918           define variable v-cntxt-db-num        as integer   no-undo .
     1919           define variable v-cntxt-userid        as character no-undo .
     1920           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1921                                             , OUTPUT v-cntxt-userid
     1922                                             ) .
     1923           run gbl/wndsizew.p
     1924             (input  v-cntxt-db-num
     1925             ,input  v-cntxt-userid
     1926             ,input  v-diasize-proc-name
     1927             ,input  'width':u
     1928             ,input  string(frame d-db-hist :width - v-diasize-orig-frame-width)
     1929             ) .
     1930         end.
     1931       end.
     1932     end.
     1933     assign
     1934       v-diasize-change-size = false
     1935     .
     1936   end procedure.
     1937   procedure diasize_set-width :
     1938     define input  parameter p-new-width  as decimal   no-undo .
     1939     define input  parameter p-move-resize as logical   no-undo .
     1940     do
     1941     on error undo, return error return-value
     1942     :
     1943       run diasize_change-width in this-procedure
     1944         (input  (p-new-width - frame d-db-hist :width)
     1945         ,input  p-move-resize
     1946         ) .
     1947     end.
     1948   end procedure.
     1949   procedure diasize_position-resize-button :
     1950     do with frame d-db-hist
     1951     :
     1952       hide v-diasize-resize-button .
     1953       assign
     1954         v-diasize-resize-button :row = frame d-db-hist :height - v-diasize-resize-button :height
     1955                     - 1
     1956                     - (frame d-db-hist :border-bottom-pixels / session :pixels-per-row)
     1957         v-diasize-resize-button :col = frame d-db-hist :width - v-diasize-resize-button :width
     1958                     - 1
     1959                     - (frame d-db-hist :border-right-pixels / session :pixels-per-column)
     1960       .
     1961       view v-diasize-resize-button .
     1962     end.
     1963   end procedure.
     1964   on alt-right anywhere
     1965   do:
     1966     run diasize_change-width in this-procedure
     1967       (input 1
     1968       ,input true
     1969       ) .
     1970     return no-apply .
     1971   end.
     1972   on alt-left anywhere
     1973   do:
     1974     run diasize_change-width in this-procedure
     1975       (input -1
     1976       ,input true
     1977       ) .
     1978     return no-apply .
     1979   end.
     1980   on alt-down anywhere
     1981   do:
     1982     run diasize_change-height in this-procedure
     1983       (input 1
     1984       ,input true
     1985       ) .
     1986     return no-apply .
     1987   end.
     1988   on alt-up anywhere
     1989   do:
     1990     run diasize_change-height in this-procedure
     1991       (input -1
     1992       ,input true
     1993       ) .
     1994     return no-apply .
     1995   end.
     1996   on alt-enter of frame d-db-hist
     1997   do:
     1998     run diasize_maximize in this-procedure
     1999       (input  ?
     2000       ).
     2001     return no-apply .
     2002   end.
     2003   procedure diasize_end-move :
     2004     do
     2005     on error undo, return error return-value
     2006     :
     2007       define variable v-row-delta as decimal   no-undo .
     2008       define variable v-col-delta as decimal   no-undo .
     2009       define variable v-new-row as decimal   no-undo .
     2010       define variable v-new-col as decimal   no-undo .
     2011       assign
     2012         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2013         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2014       .
     2015       assign
     2016         v-row-delta = v-new-row - frame d-db-hist :height
     2017         v-col-delta = v-new-col - frame d-db-hist :width
     2018       .
     2019       run diasize_change-height in this-procedure
     2020         (input v-row-delta
     2021         ,input true
     2022         ) .
     2023       run diasize_change-width in this-procedure
     2024         (input v-col-delta
     2025         ,input true
     2026         ) .
     2027     end.
     2028   end procedure.
     2029   procedure diasize_maximize :
     2030     define input  parameter p-action as logical   no-undo .
     2031     do
     2032     on error undo, return error return-value
     2033     :
     2034       if p-action = ?
     2035       then do:
     2036         if v-diasize-need-maximize = true
     2037         then do:
     2038           assign
     2039             p-action = true
     2040           .
     2041         end.
     2042         else do:
     2043           assign
     2044             p-action = false
     2045           .
     2046         end.
     2047       end.
     2048       if p-action = true
     2049       then do:
     2050         run diasize_change-height in this-procedure
     2051           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2052               - frame d-db-hist :height-chars
     2053           ,input true
     2054           ) .
     2055         run diasize_change-width in this-procedure
     2056           (input session :width-chars
     2057               - frame d-db-hist :width-chars
     2058           ,input true
     2059           ) .
     2060         assign
     2061           v-diasize-need-maximize = false
     2062         .
     2063       end.
     2064       else do:
     2065         run diasize_change-width in this-procedure
     2066           (input v-diasize-orig-frame-width
     2067               - frame d-db-hist :width-chars
     2068           ,input true
     2069           ) .
     2070         run diasize_change-height in this-procedure
     2071           (input v-diasize-orig-frame-height
     2072               - frame d-db-hist :height-chars
     2073           ,input true
     2074           ) .
     2075         assign
     2076           v-diasize-need-maximize = true
     2077         .
     2078       end.
     2079     end.
     2080   end procedure.
     2081   procedure diasize_restore-orig-size :
     2082     do
     2083     on error undo, return error return-value
     2084     :
     2085       assign
     2086         v-diasize-current-frame-width  = frame d-db-hist :width
     2087         v-diasize-current-frame-height = frame d-db-hist :height
     2088       .
     2089       run diasize_set-height in this-procedure
     2090         (input  v-diasize-orig-frame-height
     2091         ,input  true
     2092         ) .
     2093       run diasize_set-width in this-procedure
     2094         (input  v-diasize-orig-frame-width
     2095         ,input  true
     2096         ) .
     2097     end.
     2098   end procedure.
     2099   procedure diasize_restore-current-size :
     2100     do
     2101     on error undo, return error return-value
     2102     :
     2103       run diasize_set-height in this-procedure
     2104         (input  v-diasize-current-frame-height
     2105         ,input  true
     2106         ) .
     2107       run diasize_set-width in this-procedure
     2108         (input  v-diasize-current-frame-width
     2109         ,input  true
     2110         ) .
     2111     end.
     2112   end procedure.
     2113   procedure diasize_set-browse-handle :
     2114     define input  parameter p-browse-handle as handle   no-undo .
     2115     define buffer buf_temp-browse-handle for temp-browse-handle .
     2116     do
     2117     on error undo, return error return-value
     2118     :
     2119       assign
     2120         v-diasize-browse-handle = p-browse-handle
     2121       .
     2122       for each buf_temp-browse-handle
     2123       on error undo, return error return-value
     2124       :
     2125         delete buf_temp-browse-handle .
     2126       end.
     2127     end.
     2128   end procedure.
     2129   procedure diasize_add_browse :
     2130     define input  parameter p-browse-type   as character no-undo .
     2131     define input  parameter p-browse-handle as handle    no-undo .
     2132     define buffer buf_temp-browse-handle for temp-browse-handle .
     2133     do
     2134     on error undo, return error return-value
     2135     :
     2136       assign
     2137         v-diasize-browse-number = v-diasize-browse-number + 1
     2138       .
     2139       create buf_temp-browse-handle .
     2140       assign
     2141         buf_temp-browse-handle.browse-type   = p-browse-type
     2142         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2143         buf_temp-browse-handle.browse-handle = p-browse-handle
     2144       .
     2145     end.
     2146   end procedure.
     2147   procedure diasize_init :
     2148     define variable v-default-value    as logical   no-undo .
     2149     define variable v-restore-saved    as logical   no-undo .
     2150     define variable v-resize-value-str as character no-undo .
     2151     do
     2152     on error undo, return error return-value
     2153     :
     2154       do with frame d-db-hist
     2155       :
     2156         assign
     2157           v-diasize-orig-frame-height = frame d-db-hist :height
     2158           v-diasize-orig-frame-width  = frame d-db-hist :width
     2159           v-diasize-browse-handle     = browse BR-changes :handle
     2160         .
     2161         create button v-diasize-resize-button
     2162         assign
     2163           parent        = frame d-db-hist :first-child
     2164           label         = "s"
     2165           height-pixels = 16
     2166           width-pixels  = 16
     2167           visible       = true
     2168           sensitive     = true
     2169           movable       = true
     2170           triggers:
     2171             on end-move persistent run diasize_end-move in this-procedure .
     2172           end triggers.
     2173         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2174         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2175         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2176         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2177         assign
     2178           v-diasize-wndmax = false
     2179         .
     2180         if connected("ub") = true
     2181         then do:
     2182           define variable v-cntxt-db-num        as integer   no-undo .
     2183           define variable v-cntxt-userid        as character no-undo .
     2184           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2185                                             , OUTPUT v-cntxt-userid
     2186                                             ) .
     2187           run gbl/wndpar_r.p
     2188             (input  v-cntxt-db-num
     2189             ,input  v-cntxt-userid
     2190             ,input  'wndmax':U
     2191             ,output v-diasize-wndmax
     2192             ,output v-default-value
     2193             ) .
     2194         end.
     2195         assign
     2196           v-diasize-wndstore = false
     2197         .
     2198         if connected("ub") = true
     2199         then do:
     2200           run gbl/wndpar_r.p
     2201             (input  v-cntxt-db-num
     2202             ,input  v-cntxt-userid
     2203             ,input  'wndstore':U
     2204             ,output v-diasize-wndstore
     2205             ,output v-default-value
     2206             ) .
     2207         end.
     2208         assign
     2209           v-diasize-proc-name = entry(1, program-name(2), '.')
     2210         .
     2211         if v-diasize-wndstore = true
     2212         then do:
     2213           assign
     2214             v-restore-saved = false
     2215           .
     2216           if connected("ub") = true
     2217           then do:
     2218             run gbl/wndsizer.p
     2219               (input  v-cntxt-db-num
     2220               ,input  v-cntxt-userid
     2221               ,input  v-diasize-proc-name
     2222               ,input  'height':u
     2223               ,output v-resize-value-str
     2224               ) .
     2225             if v-resize-value-str <> '':U
     2226             then do:
     2227               run diasize_change-height in this-procedure
     2228                 (input  integer(v-resize-value-str)
     2229                 ,input  true
     2230                 ) .
     2231               assign
     2232                 v-restore-saved = true
     2233               .
     2234             end.
     2235           end.
     2236           if connected("ub") = true
     2237           then do:
     2238             run gbl/wndsizer.p
     2239               (input  v-cntxt-db-num
     2240               ,input  v-cntxt-userid
     2241               ,input  v-diasize-proc-name
     2242               ,input  'width':u
     2243               ,output v-resize-value-str
     2244               ) .
     2245             if v-resize-value-str <> '':U
     2246             then do:
     2247               run diasize_change-width in this-procedure
     2248                 (input  integer(v-resize-value-str)
     2249                 ,input  true
     2250                 ) .
     2251               assign
     2252                 v-restore-saved = true
     2253               .
     2254             end.
     2255           end.
     2256           if v-restore-saved <> true
     2257           then do:
     2258             if v-diasize-wndmax = true
     2259             then do:
     2260               run diasize_maximize in this-procedure
     2261                 (input  true
     2262                 ) .
     2263             end.
     2264           end.
     2265         end.
     2266         else do:
     2267           if v-diasize-wndmax = true
     2268           then do:
     2269             run diasize_maximize in this-procedure
     2270               (input  true
     2271               ) .
     2272           end.
     2273         end.
     2274       end.
     2275     end.
     2276   end procedure.
     2277   procedure diasize_need-full-display :
     2278     define output parameter p-need-full-display as logical   no-undo .
     2279     do
     2280     on error undo, return error return-value
     2281     :
     2282       assign
     2283         p-need-full-display = v-diasize-need-full-display
     2284       .
     2285       assign
     2286         v-diasize-need-full-display = false
     2287       .
     2288     end.
     2289   end procedure.
     2290   procedure get-context :
     2291      define output parameter p-db-num as integer          no-undo.
     2292      define output parameter p-user-id as character        no-undo.
     2293      define variable v-login               as character    no-undo.
     2294      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2295      define buffer buf_user-login  for ub.user-login .
     2296      do
     2297      on error undo, return error
     2298      :
     2299            FIND FIRST buf_sys-ctrl no-lock.
     2300            ASSIGN
     2301               v-login = USERID("ub")
     2302               p-db-num = buf_sys-ctrl.db-num
     2303            .
     2304            FIND FIRST buf_user-login
     2305                 WHERE buf_user-login.db-num = p-db-num
     2306                   AND buf_user-login.user-login = v-login
     2307                 no-lock
     2308                 no-error
     2309                 .
     2310            IF AVAILABLE buf_user-login
     2311            THEN DO:
     2312               assign
     2313                  p-user-id = buf_user-login.user-id
     2314               .
     2315            END.
     2316      end.
     2317   end procedure.
     2318       run diasize_init in this-procedure .
     2319   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2320   do:
     2321     BR-changes :SET-REPOSITIONED-ROW(8, "CONDITIONAL") .
     2322   end.
     2323   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2324   on f5 of frame d-db-hist anywhere
     2325   do:
     2326     run OpenBR in this-procedure ( input yes, input no, input no ) .
     2327       apply "VALUE-CHANGED" to BR-changes.
     2328   end.
     2329   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2330   DEF VAR cur-clmn-numbr-db-hist as INT EXTENT 11 no-undo.
     2331   DEF VAR varmvibr-db-hist       as INT no-undo.
     2332   DEF VAR varmvjbr-db-hist       as INT no-undo.
     2333   DEF VAR varmvkbr-db-hist       as INT no-undo.
     2334   DEF VAR varmvlbr-db-hist       as INT no-undo.
     2335   DEF VAR move-elementbr-db-hist as INT no-undo.
     2336   def var jjbr-db-hist           as int no-undo.
     2337   do varmvibr-db-hist = 1 to EXTENT(cur-clmn-numbr-db-hist):
     2338     ASSIGN cur-clmn-numbr-db-hist[varmvibr-db-hist] = varmvibr-db-hist.
     2339   END.
     2340   RUN start-mv-clmnbr-db-hist.
     2341   PROCEDURE start-mv-clmnbr-db-hist:
     2342   def var old-session as logical no-undo.
     2343      old-session = SESSION:IMMEDIATE-DISPLAY.
     2344      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2345      SESSION:IMMEDIATE-DISPLAY = old-session.
     2346   END.
     2347   ON ctrl-cursor-right OF BROWSE br-db-hist do:
     2348     RUN re-move-clmnbr-db-hist ( 1, 11).
     2349   END.
     2350   ON ctrl-cursor-left OF BROWSE br-db-hist do:
     2351     RUN re-move-clmnbr-db-hist (11, 1).
     2352   END.
     2353   PROCEDURE re-move-clmnbr-db-hist:
     2354     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2355     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2356     DO varmvibr-db-hist = 1 TO EXTENT(cur-clmn-numbr-db-hist):
     2357       if cur-clmn-numbr-db-hist[varmvibr-db-hist] = source-column THEN cur-clmn-numbr-db-hist[varmvibr-db-hist] = -1.
     2358     END.
     2359     if br-db-hist:MOVE-COLUMN(source-column, target-column) IN FRAME d-db-hist then.
     2360     if source-column > target-column THEN
     2361     DO varmvjbr-db-hist = source-column - 1 to target-column BY -1:
     2362       DO varmvibr-db-hist = 1 TO EXTENT(cur-clmn-numbr-db-hist):
     2363           if cur-clmn-numbr-db-hist[varmvibr-db-hist] = varmvjbr-db-hist THEN DO:
     2364             cur-clmn-numbr-db-hist[varmvibr-db-hist] = cur-clmn-numbr-db-hist[varmvibr-db-hist] + 1.
     2365           END.
     2366       END.
     2367     END.
     2368     ELSE
     2369     DO varmvjbr-db-hist = source-column + 1 to target-column:
     2370       DO varmvibr-db-hist = 1 TO EXTENT(cur-clmn-numbr-db-hist):
     2371         if cur-clmn-numbr-db-hist[varmvibr-db-hist] = varmvjbr-db-hist THEN DO:
     2372           cur-clmn-numbr-db-hist[varmvibr-db-hist] = cur-clmn-numbr-db-hist[varmvibr-db-hist] - 1.
     2373         END.
     2374       END.
     2375     END.
     2376     DO varmvibr-db-hist = 1 TO EXTENT(cur-clmn-numbr-db-hist):
     2377       if cur-clmn-numbr-db-hist[varmvibr-db-hist] = -1 THEN cur-clmn-numbr-db-hist[varmvibr-db-hist] = target-column.
     2378     END.
     2379   END PROCEDURE.
     2380   PROCEDURE ch-clmnbr-db-hist:
     2381     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2382     if cur-clmn-loc <= 1 then do:
     2383       return .
     2384     end.
     2385     DO varmvibr-db-hist = 1 TO EXTENT(cur-clmn-numbr-db-hist):
     2386       if cur-clmn-numbr-db-hist[varmvibr-db-hist] = cur-clmn-loc THEN move-elementbr-db-hist = varmvibr-db-hist.
     2387     END.
     2388     RUN re-move-clmnbr-db-hist (cur-clmn-loc, 1).
     2389   END PROCEDURE.
     2390   PROCEDURE mv-brw-defaultbr-db-hist:
     2391   def var old-session as logical no-undo.
     2392     old-session = SESSION:IMMEDIATE-DISPLAY.
     2393     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2394     do varmvlbr-db-hist = 1 to EXTENT(cur-clmn-numbr-db-hist):
     2395       RUN re-move-clmnbr-db-hist (cur-clmn-numbr-db-hist[varmvlbr-db-hist], varmvlbr-db-hist).
     2396     END.
     2397     RUN start-mv-clmnbr-db-hist.
     2398     SESSION:IMMEDIATE-DISPLAY = old-session.
     2399   END PROCEDURE.
     2400   .
     2401   def var sort-labelbr-db-hist   as character no-undo .
     2402   def var sort-clmnbr-db-hist    as handle    no-undo .
     2403   def var cur-clmnbr-db-hist     as handle    no-undo .
     2404   def var cur-clmn-locbr-db-hist as integer   no-undo .
     2405   def var re-querybr-db-hist     as logical   initial no no-undo .
     2406   on start-search, ctrl-o of br-db-hist in frame d-db-hist do:
     2407      run sort-brbr-db-hist
     2408        (input (if available X_c-db
     2409                then recid(X_c-db)
     2410                else ?
     2411               )
     2412        ).
     2413   end.
     2414   PROCEDURE sort-brbr-db-hist :
     2415     define input parameter p-recid as recid no-undo .
     2416     if re-querybr-db-hist = no then do:
     2417       assign
     2418          cur-clmnbr-db-hist = br-db-hist:current-column in frame d-db-hist
     2419       .
     2420       if sort-clmnbr-db-hist <> ? then sort-clmnbr-db-hist:column-fgcolor = 0.
     2421       if cur-clmnbr-db-hist = sort-clmnbr-db-hist then do:
     2422         assign
     2423            sort-labelbr-db-hist = ""
     2424            sort-clmnbr-db-hist = ?
     2425         .
     2426        end.
     2427        else do:
     2428          assign
     2429            sort-labelbr-db-hist = cur-clmnbr-db-hist:label
     2430            sort-clmnbr-db-hist  = cur-clmnbr-db-hist
     2431            sort-clmnbr-db-hist:column-fgcolor = 4
     2432          .
     2433        end.
     2434      end.
     2435     assign
     2436       cur-clmn-locbr-db-hist = 1
     2437     .
     2438     def var column-handle as handle no-undo .
     2439     column-handle = br-db-hist:first-column.
     2440     do while valid-handle(column-handle) :
     2441       if column-handle = cur-clmnbr-db-hist then do:
     2442         leave .
     2443       end.
     2444       column-handle = column-handle:NEXT-COLUMN.
     2445       assign
     2446         cur-clmn-locbr-db-hist = cur-clmn-locbr-db-hist + 1
     2447       .
     2448     end.
     2449     case sort-labelbr-db-hist:
     2450           when X_c-db.corr-user-db-num:label in browse br-db-hist then DO:    assign       v-sort-column-name = "X_c-db.corr-user-db-num"     .     run OpenBR in this-procedure ( input yes, input no, input no ) .   . END.
     2451           when X_c-db.corr-date:label in browse br-db-hist then DO:    assign       v-sort-column-name = "X_c-db.corr-date"     .     run OpenBR in this-procedure ( input yes, input no, input no ) .   . END.
     2452       otherwise do:
     2453         assign
     2454           v-sort-column-name = ""
     2455         .
     2456         run OpenBR in this-procedure ( input yes, input no, input no ) .
     2457           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-db-hist') then do:
     2458             run mv-brw-defaultbr-db-hist.
     2459           end.
     2460         if sort-labelbr-db-hist <> "" then do:
     2461           assign
     2462             cur-clmnbr-db-hist:column-fgcolor = 0
     2463           .
     2464         end.
     2465         assign
     2466           cur-clmn-locbr-db-hist = ?
     2467         .
     2468       end.
     2469     end case.
     2470       if cur-clmn-locbr-db-hist <> ? then do:
     2471         if can-do( this-procedure:internal-entries, 'ch-clmnbr-db-hist') then do:
     2472           run ch-clmnbr-db-hist in this-procedure (cur-clmn-locbr-db-hist).
     2473         end.
     2474       end.
     2475     if p-recid <> ? then do:
     2476       reposition br-db-hist to recid p-recid no-error.
     2477       apply "value-changed" to br-db-hist in frame d-db-hist.
     2478     end.
     2479     apply "entry" to br-db-hist in frame d-db-hist.
     2480   END PROCEDURE.
     2481   procedure re-open-query-srt-clmnbr-db-hist:
     2482   if cur-clmnbr-db-hist = ? then do:
     2483      run OpenBR in this-procedure ( input yes, input no, input no ) .
     2484   end.
     2485   else do:
     2486      assign re-querybr-db-hist = yes.
     2487      run sort-brbr-db-hist
     2488        (input (if available X_c-db
     2489                then recid(X_c-db)
     2490                else ?
     2491               )
     2492        ).
     2493      assign re-querybr-db-hist = no.
     2494   end.
     2495   end.
     2496   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2497   procedure set-filter-name :
     2498   define input parameter p-filter-name as character no-undo .
     2499     do with frame d-db-hist:
     2500       if p-filter-name > "" then do:
     2501         assign
     2502           frame d-db-hist:title
     2503             = frame d-db-hist:title + "   ФИЛЬТР: " + p-filter-name.
     2504         .
     2505         assign
     2506           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2507         .
     2508       end.
     2509       else do:
     2510         assign
     2511           b-sch :tooltip = ""
     2512         .
     2513       end.
     2514     end.
     2515   end procedure.
     2516   MAIN-BLOCK:
     2517   DO
     2518   ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2519   ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2520   :
     2521     RUN enable_UI.
     2522     assign
     2523       temp-changes.l_name:resizable in browse br-changes = true
     2524       temp-changes.v_old:resizable in browse br-changes = true
     2525       temp-changes.v_new:resizable in browse br-changes = true
     2526       temp-changes.l_name:width in browse br-changes = 33
     2527       temp-changes.v_old:width in browse br-changes = 30
     2528       temp-changes.v_new:width in browse br-changes = 30
     2529     .
     2530     run OpenBR in this-procedure ( input yes, input no, input no) .
     2531     wait-for go of frame d-db-hist.
     2532   end.
     2533   RUN disable_UI.
     2534   PROCEDURE disable_UI :
     2535     HIDE FRAME d-db-hist.
     2536   END PROCEDURE.
     2537   PROCEDURE enable_UI :
     2538     ENABLE b-quit b-sch b-help br-db-hist BR-changes
     2539         WITH FRAME d-db-hist.
     2540   END PROCEDURE.
     2541   PROCEDURE OpenBR :
     2542     define input  parameter p-open-query     as logical   no-undo .
     2543     define input  parameter p-find-next      as logical   no-undo .
     2544     define input  parameter p-find-condition as character no-undo .
     2545     define variable l-query-was-opened as logical no-undo .
     2546     define variable v-sort-column-phrase as character no-undo .
     2547     if available X_c-db then do:
     2548       assign
     2549         v-hist-rec = recid( X_c-db )
     2550       .
     2551     end.
     2552     run waitfram-show in this-procedure ( input "Ждите...").
     2553     case v-sort-column-name :
     2554       when "" then do:
     2555         assign
     2556           v-sort-column-phrase = "by X_c-db.corr-date by X_c-db.corr-time by X_c-db.corr-user-db-num by X_c-db.chip-num":U
     2557         .
     2558       end.
     2559       otherwise do:
     2560         assign
     2561           v-sort-column-phrase = substitute( "by &1", v-sort-column-name )
     2562         .
     2563       end.
     2564     end case.
     2565     if p-db-num <> ? then do:
     2566       assign
     2567         v-filter-point = v-filter-point0 + "one-db":U + chr(4) + v-filter-pointr
     2568         frame d-db-hist:title = substitute( "История изменения БД &1", p-db-num ) + chr(32)
     2569       .
     2570   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2571   define variable  l-disable-where-16  as logical   no-undo .
     2572   define variable  l-filter-open-16    as logical   .
     2573   define variable  flt-rec-16       as recid     no-undo .
     2574   define variable  filter-name-16      as character no-undo .
     2575   define variable  where-phrase-16     as character no-undo .
     2576   define variable  sort-phrase-16      as character no-undo .
     2577   define variable  where-phrase-rus-16 as character no-undo .
     2578   define variable  sort-phrase-rus-16  as character no-undo .
     2579     run waitfram-show in this-procedure
     2580       (input "ЖДИТЕ ..."
     2581       ).
     2582   run gbl/flt-get.p
     2583     (input v-filter-point
     2584     ,output flt-rec-16
     2585     ,output filter-name-16
     2586     ,output where-phrase-16
     2587     ,output sort-phrase-16
     2588     ,output where-phrase-rus-16
     2589     ,output sort-phrase-rus-16
     2590     ).
     2591   if p-open-query then do:
     2592       run set-filter-name in this-procedure
     2593         (INPUT filter-name-16
     2594         ) no-error .
     2595     assign
     2596       l-filter-open-16 = false
     2597     .
     2598     if flt-rec-16 <> ?
     2599       or v-sort-column-phrase > ""
     2600     then do:
     2601       define variable  parameter-2-16 as character no-undo .
     2602       define variable  parameter-3-16 as character no-undo .
     2603       define variable  parameter-4-16 as character no-undo .
     2604       define variable  parameter-5-16 as character no-undo .
     2605       define variable  parameter-6-16 as character no-undo .
     2606       define variable  parameter-7-16 as character no-undo .
     2607         assign
     2608         parameter-3-16 =
     2609                                 "FOR EACH X_c-db"
     2610         parameter-4-16 =
     2611           (
     2612             if ("X_c-db.db-num = p-db-num" + " " + where-phrase-16) <> ""
     2613             then substitute(' X_c-db.db-num = &1 ', p-db-num  )  + " " + where-phrase-16
     2614             else "true"
     2615           )
     2616         parameter-5-16 = (" " + "" + " " + "")
     2617         parameter-6-16 = if sort-phrase-16 = ''
     2618                              then
     2619           (
     2620           " " + "  " +
     2621             " " + v-sort-column-phrase +
     2622           " " + "  "
     2623           )
     2624                              else
     2625           (
     2626           " " + "  " +
     2627             " " + v-sort-column-phrase +
     2628           " " + sort-phrase-16
     2629           )
     2630         parameter-7-16 =
     2631           " indexed-reposition  "
     2632       .
     2633       do
     2634       on stop undo, leave
     2635       on error undo, leave
     2636       :
     2637         assign
     2638           l-disable-where-16 =
     2639             ("X_c-db.db-num = p-db-num" + " " + where-phrase-16 = "")
     2640         .
     2641         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2642                             ,input query br-db-hist :handle
     2643                             ,input parameter-3-16
     2644                             ,input parameter-4-16
     2645                             ,input parameter-5-16
     2646                             ,input parameter-6-16
     2647                             ,input parameter-7-16
     2648                             )
     2649         .
     2650         assign
     2651           l-filter-open-16 = true
     2652         .
     2653       end.
     2654       if l-filter-open-16 = false then do:
     2655         message
     2656           "Ошибка при фильтрации / сортировке" skip
     2657           "Будут показаны записи без учета фильтра" skip
     2658           view-as alert-box .
     2659       end.
     2660       else do:
     2661           assign
     2662             l-query-was-opened = true
     2663           .
     2664       end.
     2665     end.
     2666     if l-filter-open-16 = false then do:
     2667       OPEN QUERY br-db-hist FOR EACH X_c-db
     2668         where X_c-db.db-num = p-db-num
     2669         indexed-reposition
     2670     .
     2671         assign
     2672           l-query-was-opened = true
     2673         .
     2674     end.
     2675   end.
     2676   else do:
     2677     assign
     2678       v-hist-rec = recid( X_c-db )
     2679     .
     2680     do
     2681     on stop undo, leave
     2682     on error undo, leave
     2683     :
     2684       if query br-db-hist :handle:get-buffer-handle(1) = (buffer X_c-db:handle) then do:
     2685         assign
     2686         parameter-2-16 = (if p-find-next then "true":u else "false":u )
     2687         parameter-4-16 =
     2688           "where ":u + substitute(' X_c-db.db-num = &1 ', p-db-num  )  + " ":u + where-phrase-16 + " ":u + p-find-condition + " " + ""
     2689         parameter-5-16 = "  "
     2690       .
     2691         run fltopend_fltfindd in this-procedure  (
     2692                             input this-procedure:handle
     2693                             ,input query br-db-hist :handle
     2694                             ,input rowid(X_c-db)
     2695                             ,input logical(parameter-2-16)
     2696                             ,input no-lock
     2697                             ,input (buffer X_c-db:handle)
     2698                             ,input parameter-4-16
     2699                             ,input parameter-5-16
     2700                             ) no-error.
     2701         .
     2702         assign
     2703           v-hist-rec = integer(return-value)
     2704           v-fltopend-rowid[1] = ?
     2705         .
     2706       end.
     2707       else do:
     2708         assign
     2709         parameter-2-16 = (if p-find-next then "true":u else "false":u )
     2710         parameter-3-16 =  "FOR EACH X_c-db"
     2711         parameter-4-16 =
     2712           (
     2713             if ("X_c-db.db-num = p-db-num" + " " + where-phrase-16) <> ""
     2714             then substitute(' X_c-db.db-num = &1 ', p-db-num  )  + " " + where-phrase-16
     2715             else "true"
     2716           )
     2717         parameter-5-16 = (" " + "" + " " + "" + " " + p-find-condition)
     2718         parameter-6-16 = if sort-phrase-16 = ''
     2719                              then
     2720           (
     2721           " " + "  " +
     2722             " " + v-sort-column-phrase +
     2723           " " + "  "
     2724           )
     2725                              else
     2726           (
     2727           " " + "  " +
     2728             " " + v-sort-column-phrase +
     2729           " " + sort-phrase-16
     2730           )
     2731         parameter-7-16 =
     2732           " indexed-reposition  "
     2733       .
     2734         run fltopend_fltfindq in this-procedure  (
     2735                             input this-procedure:handle
     2736                             ,input query br-db-hist :handle
     2737                             ,input logical(parameter-2-16)
     2738                             ,input no-lock
     2739                             ,input parameter-3-16
     2740                             ,input parameter-4-16
     2741                             ,input parameter-5-16
     2742                             ,input parameter-6-16
     2743                             ,input parameter-7-16
     2744                             ,output v-fltopend-rowid
     2745                             ) no-error.
     2746         .
     2747         v-hist-rec = ?.
     2748       end.
     2749       assign
     2750         l-query-was-opened = true
     2751       .
     2752     end.
     2753   end.
     2754     run waitfram-hide in this-procedure .
     2755     end.
     2756     else do:
     2757       assign
     2758         v-filter-point = v-filter-point0 + "all":U + chr(4) + v-filter-pointr
     2759         frame d-db-hist:title = "История изменения баз данных" + chr(32)
     2760       .
     2761   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2762   define variable  l-disable-where-18  as logical   no-undo .
     2763   define variable  l-filter-open-18    as logical   .
     2764   define variable  flt-rec-18       as recid     no-undo .
     2765   define variable  filter-name-18      as character no-undo .
     2766   define variable  where-phrase-18     as character no-undo .
     2767   define variable  sort-phrase-18      as character no-undo .
     2768   define variable  where-phrase-rus-18 as character no-undo .
     2769   define variable  sort-phrase-rus-18  as character no-undo .
     2770     run waitfram-show in this-procedure
     2771       (input "ЖДИТЕ ..."
     2772       ).
     2773   run gbl/flt-get.p
     2774     (input v-filter-point
     2775     ,output flt-rec-18
     2776     ,output filter-name-18
     2777     ,output where-phrase-18
     2778     ,output sort-phrase-18
     2779     ,output where-phrase-rus-18
     2780     ,output sort-phrase-rus-18
     2781     ).
     2782   if p-open-query then do:
     2783       run set-filter-name in this-procedure
     2784         (INPUT filter-name-18
     2785         ) no-error .
     2786     assign
     2787       l-filter-open-18 = false
     2788     .
     2789     if flt-rec-18 <> ?
     2790       or v-sort-column-phrase > ""
     2791     then do:
     2792       define variable  parameter-2-18 as character no-undo .
     2793       define variable  parameter-3-18 as character no-undo .
     2794       define variable  parameter-4-18 as character no-undo .
     2795       define variable  parameter-5-18 as character no-undo .
     2796       define variable  parameter-6-18 as character no-undo .
     2797       define variable  parameter-7-18 as character no-undo .
     2798         assign
     2799         parameter-3-18 =
     2800                                 "FOR EACH X_c-db"
     2801         parameter-4-18 =
     2802           (
     2803             if ("true" + " " + where-phrase-18) <> ""
     2804             then "true" + " " + where-phrase-18
     2805             else "true"
     2806           )
     2807         parameter-5-18 = (" " + "" + " " + "")
     2808         parameter-6-18 = if sort-phrase-18 = ''
     2809                              then
     2810           (
     2811           " " + " " +
     2812             " " + v-sort-column-phrase +
     2813           " " + " "
     2814           )
     2815                              else
     2816           (
     2817           " " + " " +
     2818             " " + v-sort-column-phrase +
     2819           " " + sort-phrase-18
     2820           )
     2821         parameter-7-18 =
     2822           " indexed-reposition  "
     2823       .
     2824       do
     2825       on stop undo, leave
     2826       on error undo, leave
     2827       :
     2828         assign
     2829           l-disable-where-18 =
     2830             ("true" + " " + where-phrase-18 = "")
     2831         .
     2832         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2833                             ,input query br-db-hist :handle
     2834                             ,input parameter-3-18
     2835                             ,input parameter-4-18
     2836                             ,input parameter-5-18
     2837                             ,input parameter-6-18
     2838                             ,input parameter-7-18
     2839                             )
     2840         .
     2841         assign
     2842           l-filter-open-18 = true
     2843         .
     2844       end.
     2845       if l-filter-open-18 = false then do:
     2846         message
     2847           "Ошибка при фильтрации / сортировке" skip
     2848           "Будут показаны записи без учета фильтра" skip
     2849           view-as alert-box .
     2850       end.
     2851       else do:
     2852           assign
     2853             l-query-was-opened = true
     2854           .
     2855       end.
     2856     end.
     2857     if l-filter-open-18 = false then do:
     2858       OPEN QUERY br-db-hist FOR EACH X_c-db
     2859         where true
     2860         indexed-reposition
     2861     .
     2862         assign
     2863           l-query-was-opened = true
     2864         .
     2865     end.
     2866   end.
     2867   else do:
     2868     assign
     2869       v-hist-rec = recid( X_c-db )
     2870     .
     2871     do
     2872     on stop undo, leave
     2873     on error undo, leave
     2874     :
     2875       if query br-db-hist :handle:get-buffer-handle(1) = (buffer X_c-db:handle) then do:
     2876         assign
     2877         parameter-2-18 = (if p-find-next then "true":u else "false":u )
     2878         parameter-4-18 =
     2879           "where ":u + "true" + " ":u + where-phrase-18 + " ":u + p-find-condition + " " + ""
     2880         parameter-5-18 = " "
     2881       .
     2882         run fltopend_fltfindd in this-procedure  (
     2883                             input this-procedure:handle
     2884                             ,input query br-db-hist :handle
     2885                             ,input rowid(X_c-db)
     2886                             ,input logical(parameter-2-18)
     2887                             ,input no-lock
     2888                             ,input (buffer X_c-db:handle)
     2889                             ,input parameter-4-18
     2890                             ,input parameter-5-18
     2891                             ) no-error.
     2892         .
     2893         assign
     2894           v-hist-rec = integer(return-value)
     2895           v-fltopend-rowid[1] = ?
     2896         .
     2897       end.
     2898       else do:
     2899         assign
     2900         parameter-2-18 = (if p-find-next then "true":u else "false":u )
     2901         parameter-3-18 =  "FOR EACH X_c-db"
     2902         parameter-4-18 =
     2903           (
     2904             if ("true" + " " + where-phrase-18) <> ""
     2905             then "true" + " " + where-phrase-18
     2906             else "true"
     2907           )
     2908         parameter-5-18 = (" " + "" + " " + "" + " " + p-find-condition)
     2909         parameter-6-18 = if sort-phrase-18 = ''
     2910                              then
     2911           (
     2912           " " + " " +
     2913             " " + v-sort-column-phrase +
     2914           " " + " "
     2915           )
     2916                              else
     2917           (
     2918           " " + " " +
     2919             " " + v-sort-column-phrase +
     2920           " " + sort-phrase-18
     2921           )
     2922         parameter-7-18 =
     2923           " indexed-reposition  "
     2924       .
     2925         run fltopend_fltfindq in this-procedure  (
     2926                             input this-procedure:handle
     2927                             ,input query br-db-hist :handle
     2928                             ,input logical(parameter-2-18)
     2929                             ,input no-lock
     2930                             ,input parameter-3-18
     2931                             ,input parameter-4-18
     2932                             ,input parameter-5-18
     2933                             ,input parameter-6-18
     2934                             ,input parameter-7-18
     2935                             ,output v-fltopend-rowid
     2936                             ) no-error.
     2937         .
     2938         v-hist-rec = ?.
     2939       end.
     2940       assign
     2941         l-query-was-opened = true
     2942       .
     2943     end.
     2944   end.
     2945     run waitfram-hide in this-procedure .
     2946     end.
     2947     if not p-open-query then do:
     2948       reposition br-db-hist to recid v-hist-rec no-error.
     2949     end.
     2950     if not p-open-query and v-fltopend-rowid[1] <> ? then do:
     2951       query br-db-hist:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     2952     end.
     2953     run waitfram-hide in this-procedure.
     2954     apply "value-changed" to br-db-hist in frame d-db-hist .
     2955     apply "entry" to br-db-hist .
     2956   END PROCEDURE.
     2957   PROCEDURE proc-b-sch :
     2958   assign
     2959     tbl = 'c-db'
     2960     join-tbl = 'X_c-db'
     2961     fld = ""
     2962     lab = ""
     2963     spr = ""
     2964     dim = '0'
     2965     .
     2966   run fltfield-add in this-procedure('action', 'Действие', 'hist-action',
     2967                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2968   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     2969                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2970   run fltfield-add in this-procedure('corr-date', 'Дата изменения', '',
     2971                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2972   run fltfield-add in this-procedure('corr-time', 'Время изменения', 'time',
     2973                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2974   run fltfield-add in this-procedure('corr-user-db-num', 'БД Изменения', 'db',
     2975                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2976   run fltfield-add in this-procedure('db-num', 'Номер БД', '',
     2977                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2978   run fltfield-add in this-procedure('db-name', 'Название', '',
     2979                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2980   run fltfield-add in this-procedure ('db-key', 'Ключ БД', '',
     2981                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2982   Filter-Block:
     2983   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     2984       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     2985       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     2986     run gbl/filter.w ( INPUT parparentproc, INPUT v-filter-point, INPUT tbl, INPUT join-tbl, INPUT fld, INPUT lab, INPUT spr, INPUT dim ).
     2987     run OpenBR in this-procedure ( input yes, input no, input '':U).
     2988   END.
     2989   END PROCEDURE.
     2990   FUNCTION get-action RETURNS CHARACTER
     2991       ( p-action as integer ) :
     2992     define variable dops as character no-undo.
     2993       assign
     2994       dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U)
     2995       no-error
     2996     .
     2997     return dops.
     2998   END FUNCTION.
