     1693   PROCEDURE MyEnable :
     1694   ASSIGN
     1695   FRAME Dialog-Frame:TITLE = FRAME Dialog-Frame:TITLE + (if p-obj-type = 'орг':U then " фирма" else " маг") + STRING(p-obj-code)
     1696   v-tab-order = "wrkr,r-wrkr,agnt,r-agnt,boss,r-boss".
     1697   find first tt-trn-doc.
     1698     define variable v-ref-rec20   as recid no-undo .
     1699     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-trn-doc.wrkr
     1700                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     1701   if not available cli-buf then do:
     1702     display tt-trn-doc.wrkr with frame Dialog-Frame.
     1703     find cli-buf no-lock where cli-buf.obj-code = input frame Dialog-Frame tt-trn-doc.wrkr
     1704                            and cli-buf.obj-type = 'чел':U no-error.
     1705   end.
     1706   if available cli-buf then do:
     1707         display cli-buf.obj-code @ tt-trn-doc.wrkr cli-buf.obj-name @ wrkr-name with frame Dialog-Frame.
     1708     end.
     1709     else display ? @ tt-trn-doc.wrkr ? @ wrkr-name with frame Dialog-Frame.
     1710     define variable v-ref-rec21   as recid no-undo .
     1711     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-trn-doc.agnt
     1712                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     1713   if not available cli-buf then do:
     1714     display tt-trn-doc.agnt with frame Dialog-Frame.
     1715     find cli-buf no-lock where cli-buf.obj-code = input frame Dialog-Frame tt-trn-doc.agnt
     1716                            and cli-buf.obj-type = 'чел':U no-error.
     1717   end.
     1718   if available cli-buf then do:
     1719         display cli-buf.obj-code @ tt-trn-doc.agnt cli-buf.obj-name @ agnt-name with frame Dialog-Frame.
     1720     end.
     1721     else display ? @ tt-trn-doc.agnt ? @ agnt-name with frame Dialog-Frame.
     1722     define variable v-ref-rec22   as recid no-undo .
     1723     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-trn-doc.boss
     1724                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     1725   if not available cli-buf then do:
     1726     display tt-trn-doc.boss with frame Dialog-Frame.
     1727     find cli-buf no-lock where cli-buf.obj-code = input frame Dialog-Frame tt-trn-doc.boss
     1728                            and cli-buf.obj-type = 'чел':U no-error.
     1729   end.
     1730   if available cli-buf then do:
     1731         display cli-buf.obj-code @ tt-trn-doc.boss cli-buf.obj-name @ boss-name with frame Dialog-Frame.
     1732     end.
     1733     else display ? @ tt-trn-doc.boss ? @ boss-name with frame Dialog-Frame.
     1734   DISPLAY
     1735   tt-trn-doc.wrkr
     1736   tt-trn-doc.agnt
     1737   tt-trn-doc.boss
     1738   WITH FRAME Dialog-Frame.
     1739   ENABLE
     1740   B-exit WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1741   b-quit
     1742       b-1
     1743       b-2
     1744       b-3
     1745       B-Help
     1746   tt-trn-doc.wrkr WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1747   tt-trn-doc.agnt WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1748   tt-trn-doc.boss WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1749   r-wrkr WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1750   r-agnt WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1751   r-boss WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1752   WITH FRAME Dialog-Frame.
     1753   VIEW FRAME Dialog-Frame.
     1754   IF p-mode = 'ПРОСМОТР':U THEN DO:
     1755       HIDE
     1756       b-exit
     1757       IN FRAME Dialog-Frame.
     1758       ASSIGN
     1759       b-quit:LABEL = "&Выход"
     1760       .
     1761   END.
     1762   END PROCEDURE.
     1763   PROCEDURE proc-save :
     1764   define variable v-value-character as character no-undo .
     1765   define variable v-value-date as date no-undo .
     1766   define variable v-value-decimal as decimal no-undo .
     1767   define variable v-value-integer as INTEGER no-undo .
     1768   define variable v-value-logical AS LOGICAL no-undo .
     1769   define variable v-param-type as character no-undo .
     1770   define variable wh as widget-handle no-undo .
     1771   define variable fh as widget-handle no-undo .
     1772   define variable v-same as logical no-undo .
     1773   IF p-mode = 'ПРОСМОТР':U THEN do:
     1774     RETURN ERROR.
     1775   end.
     1776   ASSIGN
     1777   FRAME Dialog-Frame
     1778   tt-trn-doc.wrkr
     1779   tt-trn-doc.agnt
     1780   tt-trn-doc.boss
     1781   tt-trn-doc.wrkr = if tt-trn-doc.wrkr = ? then 0 else tt-trn-doc.wrkr
     1782   tt-trn-doc.agnt = if tt-trn-doc.agnt = ? then 0 else tt-trn-doc.agnt
     1783   tt-trn-doc.boss = if tt-trn-doc.boss = ? then 0 else tt-trn-doc.boss
     1784   .
     1785   assign
     1786   fh = frame Dialog-Frame:first-child
     1787   wh = fh:first-child
     1788   .
     1789   do while valid-handle(wh):
     1790     if wh:private-data begins "recid=" then do:
     1791       find first thbjattr_thbj-attr where
     1792                 recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     1793       assign
     1794       buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     1795     end.
     1796     wh = wh:next-sibling.
     1797   end.
     1798   v-same = yes.
     1799   for each thbjattr_thbj-attr,
     1800       first temp-thbj-attr where
     1801             temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     1802         and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     1803         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     1804         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code:
     1805      buffer-compare
     1806      thbjattr_thbj-attr
     1807      to temp-thbj-attr
     1808      save result in v-same.
     1809      if not v-same then leave.
     1810   end.
     1811   v-same = no.
     1812   IF v-same  and not v-to-create THEN RETURN.
     1813   run adm/shattri.p (
     1814                 input "check":U
     1815               , input p-obj-type
     1816               , input p-obj-code
     1817               , input 'rt-trn-doc':U
     1818               , INPUT '':U
     1819               , output v-value-character
     1820               , output v-value-date
     1821               , output v-value-decimal
     1822               , output v-value-integer
     1823               , output v-value-logical
     1824               , output v-param-type
     1825               , input-output table-handle v-tth
     1826               ) no-error .
     1827   if error-status:error then do:
     1828     message
     1829     "Некорректное значение ПАРАМЕТРОВ" skip
     1830     error-status:get-message(1) skip
     1831     return-value
     1832     view-as alert-box error .
     1833     undo, return error .
     1834   end.
     1835   do TRANSACTION
     1836   on error undo, return error return-value
     1837   :
     1838     RUN thbjattr_set-section IN THIS-PROCEDURE (
     1839          input p-obj-type
     1840         ,input p-obj-code
     1841         ,input 'rt-trn-doc':U
     1842         ,INPUT table thbjattr_thbj-attr
     1843     ) NO-ERROR.
     1844     IF ERROR-STATUS:error THEN do:
     1845       MESSAGE ERROR-STATUS:get-message(1)  SKIP
     1846       RETURN-VALUE
     1847       VIEW-AS ALERT-BOX.
     1848       UNDO, RETURN ERROR.
     1849     END.
     1850   end.
     1851   END PROCEDURE.
