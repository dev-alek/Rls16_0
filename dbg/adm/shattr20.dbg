      617   procedure proc-alt-shift-f2:
      618     if not ibs.th.gbl.gbl-var:rcode
      619   then
      620     run gbl\inidebug.p .
      621   end.
      622   procedure proc-alt-shift-f3:
      623     run gbl/prvssinf.p
      624       ( input this-procedure
      625       ) .
      626   end.
      627   define variable v-inform-launched as logical no-undo initial false .
      628   procedure proc-alt-shift-f4:
      629     define variable v-action as character no-undo .
      630     if v-inform-launched = false then do:
      631       assign
      632         v-inform-launched = true
      633       .
      634       run gbl/d-inform.w
      635         (  input self
      636         ,  input this-procedure
      637         , output v-action
      638         ) no-error .
      639       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      640       assign
      641         v-inform-launched = false
      642       .
      643     end.
      644   end.
      645   procedure proc-alt-f1:
      646     run gbl/corrhelp.p
      647       (input this-procedure
      648       ) .
      649   end .
      650   on alt-shift-f2 anywhere do:
      651     run proc-alt-shift-f2.
      652   end.
      653   on alt-shift-f3 anywhere do:
      654     run proc-alt-shift-f3 in this-procedure .
      655   end.
      656   on alt-shift-f4 anywhere do:
      657     run proc-alt-shift-f4 in this-procedure.
      658   end.
      659   on alt-f1 anywhere do:
      660     run proc-alt-f1 in this-procedure .
      661   end.
