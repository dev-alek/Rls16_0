      365   procedure thbjattr_code_reg :
      366   define input  parameter p-upper-code     as character no-undo .
      367   define input  parameter p-code           as character no-undo .
      368   define output parameter p-label          as character no-undo .
      369   define output parameter p-user-can-edit  as logical   no-undo .
      370   define output parameter p-output-display as logical   no-undo .
      371   define output parameter p-other          as character no-undo .
      372   define output parameter p-prop-list      as character no-undo .
      373   define output parameter p-prop-type-list as character no-undo .
      374   define output parameter p-prop-label-list as character no-undo .
      375   define output parameter p-global          as logical no-undo .
      376   define output parameter p-host           as logical no-undo .
      377   define output parameter p-shop           as logical no-undo .
      378   define output parameter p-store          as logical no-undo .
      379   define output parameter p-db             as logical no-undo .
      380   define output parameter p-region         as logical no-undo .
      381   do
      382   on error undo, return error return-value
      383   :
      384       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      385       (input  p-upper-code
      386       ,input  p-code
      387       ,output p-label
      388       ,output p-user-can-edit
      389       ,output p-output-display
      390       ,output p-other
      391       ,output p-prop-list
      392       ,output p-prop-type-list
      393       ,output p-prop-label-list
      394       ,output p-global
      395       ,output p-host
      396       ,output p-shop
      397       ,output p-store
      398       ,output p-db
      399       ,output p-region
      400       ) no-error .
      401     if error-status :error
      402     then do:
      403       undo, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message (1)).
      404     end.
      405   end.
      406   end procedure.
