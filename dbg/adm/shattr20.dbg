      492       (input  p-obj-type
      493       ,input  p-obj-code
      494       ,input  p-upper-param-code
      495       ,input  p-mode
      496       ,input-output table-handle p-tth
      497       ,output p-all-found
      498       ) no-error .
      499     if error-status :error
      500     then do:
      501       delete object p-tth.
      502       undo, return error return-value .
      503     end.
      504     delete object p-tth.
      505   end.
      506   end procedure.
