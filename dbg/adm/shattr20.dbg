      750   DEFINE QUERY Dialog-Frame FOR
      751         tt-trn-doc SCROLLING.
      752   DEFINE FRAME Dialog-Frame
      753        B-exit AT ROW 1 COL 1
      754        b-quit AT ROW 1 COL 11
      755        B-Help AT ROW 1 COL 77.5
      756        B-1 AT ROW 2.25 COL 4 WIDGET-ID 80
      757        tt-trn-doc.wrkr AT ROW 2.25 COL 18.5 COLON-ALIGNED
      758             LABEL "К&ладовщик"
      759             VIEW-AS FILL-IN
      760             SIZE 9.75 BY 1
      761        r-wrkr AT ROW 2.25 COL 30.63
      762        B-2 AT ROW 3.25 COL 4 WIDGET-ID 82
      763        tt-trn-doc.agnt AT ROW 3.25 COL 18.5 COLON-ALIGNED
      764             LABEL "И&сполнитель"
      765             VIEW-AS FILL-IN
      766             SIZE 9.75 BY 1
      767        r-agnt AT ROW 3.25 COL 30.5
      768        B-3 AT ROW 4.25 COL 4 WIDGET-ID 84
      769        tt-trn-doc.boss AT ROW 4.25 COL 18.5 COLON-ALIGNED
      770             LABEL "&Менеджер"
      771             VIEW-AS FILL-IN
      772             SIZE 9.75 BY 1
      773        r-boss AT ROW 4.25 COL 30.5
      774        wrkr-name AT ROW 2.25 COL 31.5 COLON-ALIGNED NO-LABEL
      775        agnt-name AT ROW 3.25 COL 31.5 COLON-ALIGNED NO-LABEL
      776        boss-name AT ROW 4.25 COL 31.5 COLON-ALIGNED NO-LABEL
      777        SPACE(12.87) SKIP(0.87)
      778       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      779            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      780            TITLE "Радиотерминал. Параметры документа по умолчанию"
      781            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      782   ASSIGN
      783          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      784          FRAME Dialog-Frame:HIDDEN           = TRUE.
      785   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      786   DO:
      787     APPLY "END-ERROR":U TO SELF.
      788   END.
      789   ON LEAVE OF tt-trn-doc.agnt IN FRAME Dialog-Frame
      790   DO:
      791     if input frame Dialog-Frame tt-trn-doc.agnt <> tt-trn-doc.agnt then do:
      792       run local-psn-chk ("agnt", "leave").
      793     end.
      794   END.
      795   ON MOUSE-SELECT-DBLCLICK OF tt-trn-doc.agnt IN FRAME Dialog-Frame
      796   OR RETURN OF tt-trn-doc.agnt IN FRAME Dialog-Frame DO:
      797     run local-psn-chk ("agnt", "ret-mouse").
      798     apply "entry" to tt-trn-doc.agnt in frame Dialog-Frame.
      799     return no-apply.
      800   END.
      801   ON CHOOSE OF B-1 IN FRAME Dialog-Frame
      802   DO:
      803     run gbl/v-taobj.w
      804         ('rt-trn-doc':U,
      805          "wrkr"
      806          ).
      807   END.
      808   ON CHOOSE OF B-2 IN FRAME Dialog-Frame
      809   DO:
      810     run gbl/v-taobj.w
      811         ('rt-trn-doc':U,
      812          "agnt"
      813          ).
      814   END.
      815   ON CHOOSE OF B-3 IN FRAME Dialog-Frame
      816   DO:
      817     run gbl/v-taobj.w
      818         ('rt-trn-doc':U,
      819          "boss"
      820          ).
      821   END.
      822   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      823   DO:
      824     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      825     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      826   END.
      827   ON LEAVE OF tt-trn-doc.boss IN FRAME Dialog-Frame
      828   DO:
      829     if input frame Dialog-Frame tt-trn-doc.boss <> tt-trn-doc.boss then do:
      830       run local-psn-chk ("boss", "leave").
      831     end.
      832   END.
      833   ON MOUSE-SELECT-DBLCLICK OF tt-trn-doc.boss IN FRAME Dialog-Frame
      834   OR RETURN OF tt-trn-doc.boss IN FRAME Dialog-Frame DO:
      835     run local-psn-chk ("boss", "ret-mouse").
      836     apply "entry" to tt-trn-doc.boss in frame Dialog-Frame.
      837     return no-apply.
      838   END.
      839   ON CHOOSE OF r-agnt IN FRAME Dialog-Frame
      840   DO:
      841     RUN local-psn-chk ("agnt", "button").
      842     apply "entry" to tt-trn-doc.agnt in FRAME Dialog-Frame.
      843     return no-apply.
      844   END.
      845   ON CHOOSE OF r-boss IN FRAME Dialog-Frame
      846   DO:
      847       RUN local-psn-chk ("boss", "button").
      848     apply "entry" to tt-trn-doc.boss in FRAME Dialog-Frame.
      849     return no-apply.
      850   END.
      851   ON CHOOSE OF r-wrkr IN FRAME Dialog-Frame
      852   DO:
      853     RUN local-psn-chk ("wrkr", "button").
      854     apply "entry" to tt-trn-doc.wrkr in FRAME Dialog-Frame.
      855     return no-apply.
      856   END.
      857   ON LEAVE OF tt-trn-doc.wrkr IN FRAME Dialog-Frame
      858   DO:
      859     if input frame Dialog-Frame tt-trn-doc.wrkr <> tt-trn-doc.wrkr then do:
      860       run local-psn-chk ("wrkr", "leave").
      861     end.
      862   END.
      863   ON MOUSE-SELECT-DBLCLICK OF tt-trn-doc.wrkr IN FRAME Dialog-Frame
      864   OR RETURN OF tt-trn-doc.wrkr IN FRAME Dialog-Frame DO:
      865     run local-psn-chk ("wrkr", "ret-mouse").
      866     apply "entry" to tt-trn-doc.wrkr in frame Dialog-Frame.
      867     return no-apply.
      868   END.
      869   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      870   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      871   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      872   on help of frame Dialog-Frame
      873   do:
      874     run gbl/app_help.p
      875       (input this-procedure :file-name
      876       ,input ''
      877       ,input ?
      878       ) no-error.
      879     if error-status :error then do:
      880       message
      881         "Ошибка при вызове помощи"
      882         error-status :get-message(1)
      883         view-as alert-box .
      884     end.
      885   end.
      886   run minbtn-set in this-procedure .
      887   on choose of b-help in frame Dialog-Frame
      888   do:
      889     apply "help":u to frame Dialog-Frame .
      890   end.
      891   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      892   procedure minbtn-set :
      893       do
      894           on error undo, return error return-value
      895           :
      896           define variable ii              as integer       no-undo .
      897           define variable fh              as widget-handle no-undo .
      898           define variable hh              as widget-handle no-undo .
      899           define variable v-h             as handle        extent 4 no-undo .
      900           define variable v-name-button   as character     no-undo .
      901           define variable v-help-old-x    as decimal       no-undo .
      902           define variable v-help-old-y    as decimal       no-undo .
      903           define variable v-help-old-size as decimal       no-undo .
      904           define variable v-frame-width   as decimal       no-undo .
      905           define variable jj              as integer       no-undo .
      906           do
      907               on error undo, return error
      908               :
      909               assign
      910                   v-frame-width = frame Dialog-Frame:width - 0.3
      911                   fh            = frame Dialog-Frame:first-child
      912                   hh            = fh:first-child
      913                   ii            = 1
      914                   .
      915               do while valid-handle(hh):
      916                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      917                   do:
      918                       case lc(hh:name) :
      919                           when "b-help" then
      920                               do:
      921                                   hh:load-image-up("cmp/b-help.bmp":u) .
      922                                   hh:load-image-down("cmp/b-help.bmp":u) .
      923                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      924                                   hh:TOOLTIP = "Помощь" .
      925                                   v-help-old-x = hh:column .
      926                                   v-help-old-y = hh:row    .
      927                                   v-help-old-size = hh:width .
      928                                   hh:width-chars = 2.5 .
      929                               end.
      930                           when "b-print" then
      931                               do:
      932                                   hh:load-image("cmp/b-print.bmp":u) .
      933                                   hh:TOOLTIP = "Печать" .
      934                                   v-h[ii] = hh:handle .
      935                                   ii = ii + 1 .
      936                                   hh:width-chars = 3 .
      937                               end.
      938                           when "b-history" or
      939                           when "b-hist" then
      940                               do:
      941                                   hh:load-image("cmp/b-hist.bmp":u) .
      942                                   hh:TOOLTIP = "История" .
      943                                   v-h[ii] = hh:handle .
      944                                   ii = ii + 1 .
      945                                   hh:width-chars = 3 .
      946                               end.
      947                           when "b-sch" then
      948                               do:
      949                                   hh:load-image("cmp/b-sch.bmp":u) .
      950                                   hh:TOOLTIP = "Установка Фильтра" .
      951                                   v-h[ii] = hh:handle .
      952                                   ii = ii + 1 .
      953                                   hh:width-chars = 3 .
      954                               end.
      955                           when "b-hist-user" then
      956                               do:
      957                                   hh:load-image("cmp/b-hist.bmp":u) .
      958                                   hh:TOOLTIP = "История пользователя" .
      959                                   ii = ii + 1 .
      960                               end.
      961                       end case.
      962                   end.
      963                   hh = hh:next-sibling.
      964               end.
      965               b-help:column = v-frame-width - b-help:width-chars.
      966               jj = 0.
      967               repeat ii = 4 to 1 by -1 :
      968                   if valid-handle (v-h[ii] ) then
      969                   do:
      970                       jj  = jj + 1 .
      971                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      972                       v-h[ii]:row    = v-help-old-y .
      973                   end.
      974               end.
      975           end.
      976       end.
      977   end procedure.
      978   MAIN-BLOCK:
      979   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      980      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      981   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      982     run mainmenu_getcntxt in parparentproc
      983       (output v-cntxt-db-num
      984       ,output v-cntxt-userid
      985       ,output v-cntxt-level
      986       ,output v-cntxt-host-code-obj
      987       ,output v-cntxt-obj-type
      988       ,output v-cntxt-obj-code
      989       ,output v-cntxt-db-num-obj
      990       ,output v-cntxt-is-admin
      991       ) .
      992   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      993   ON TAB ANYWHERE
      994   DO:
      995   define variable ii as integer no-undo .
      996   define variable fh as widget-handle no-undo .
      997   define variable hh as widget-handle no-undo .
      998   define variable v-next-widget-name as character no-undo .
      999   if v-tab-order <> '' then do:
     1000     if self:type = "TOGGLE-BOX" then
     1001     self:BGCOLOR = ?.
     1002     assign
     1003     ii = lookup(self:name, v-tab-order).
     1004     assign
     1005     ii = ii + 1
     1006     v-next-widget-name = entry(ii, v-tab-order)
     1007     no-error .
     1008     if error-status:error then do:
     1009       assign
     1010       ii = 1
     1011       v-next-widget-name = entry( ii, v-tab-order)
     1012       .
     1013     end.
     1014     assign
     1015     fh = frame Dialog-Frame:first-child
     1016     hh = fh:first-child
     1017     .
     1018     do while valid-handle(hh):
     1019       if hh:name = v-next-widget-name then do:
     1020         if hh:sensitive  = yes
     1021         AND hh:visible = yes then do:
     1022           if hh:type = "TOGGLE-BOX":U then do:
     1023             assign
     1024             hh:BGcolor = 1
     1025             .
     1026           end.
     1027           APPLY "ENTRY" to hh.
     1028           return no-apply.
     1029         end.
     1030         else do:
     1031           APPLY "TAB" to hh.
     1032           return no-apply.
     1033         end.
     1034       end.
     1035       hh = hh:next-sibling.
     1036     end.
     1037   end.
     1038   END.
     1039   ON BACK-TAB ANYWHERE
     1040   DO:
     1041   define variable ii as integer no-undo .
     1042   define variable fh as widget-handle no-undo .
     1043   define variable hh as widget-handle no-undo .
     1044   define variable v-next-widget-name as character no-undo .
     1045   if v-tab-order <> '' then do:
     1046     assign
     1047     ii = lookup(self:name, v-tab-order).
     1048     .
     1049     assign
     1050     ii = (if ii = 1
     1051           then  num-entries(v-tab-order)
     1052           else ii - 1
     1053           )
     1054     v-next-widget-name = entry(ii, v-tab-order)
     1055     .
     1056     assign
     1057     fh = frame Dialog-Frame:first-child
     1058     hh = fh:first-child
     1059     .
     1060     do while valid-handle(hh):
     1061       if hh:name = v-next-widget-name then do:
     1062         if hh:sensitive  = yes
     1063         AND hh:visible = yes then do:
     1064           if hh:type = "TOGGLE-BOX":U then do:
     1065             assign
     1066             hh:BGcolor = 1
     1067             .
     1068           end.
     1069           APPLY "ENTRY" to hh.
     1070           return no-apply.
     1071         end.
     1072         else do:
     1073         APPLY "BACK-TAB" to hh.
     1074         return no-apply.
     1075         end.
     1076       end.
     1077       hh = hh:next-sibling.
     1078     end.
     1079     end.
     1080   END.
     1081   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1082   ON RETURN ANYWHERE
     1083   DO:
     1084   define variable ii as integer no-undo .
     1085   define variable fh as widget-handle no-undo .
     1086   define variable hh as widget-handle no-undo .
     1087   define variable v-next-widget-name as character no-undo .
     1088     if v-tab-order <> '' then do:
     1089       assign
     1090       ii = lookup(self:name, v-tab-order).
     1091       if ii = num-entries(v-tab-order) then do:
     1092           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     1093           return no-apply.
     1094       end.
     1095       if self:type <> "BUTTON" and
     1096         self:type <> "EDITOR"  then do:
     1097         run proc-move-forward in this-procedure .
     1098         return no-apply.
     1099       end.
     1100       if self:type = "BUTTON" then do:
     1101         APPLY "CHOOSE" to self.
     1102       end.
     1103       if self:type = "TOGGLE-BOX" then
     1104       self:BGCOLOR = ?.
     1105       assign
     1106       ii = ii + 1
     1107       v-next-widget-name = entry(ii, v-tab-order)
     1108       no-error .
     1109       if error-status:error then do:
     1110         assign
     1111         ii = 1
     1112         v-next-widget-name = entry( ii, v-tab-order)
     1113         .
     1114       end.
     1115       assign
     1116       fh = frame Dialog-Frame:first-child
     1117       hh = fh:first-child
     1118       .
     1119       do while valid-handle(hh):
     1120         if hh:name = v-next-widget-name then do:
     1121           if hh:sensitive  = yes
     1122           AND hh:visible = yes then do:
     1123             if hh:type = "TOGGLE-BOX":U then do:
     1124               assign
     1125               hh:BGcolor = 1
     1126               .
     1127             end.
     1128             APPLY "ENTRY" to hh.
     1129             return no-apply.
     1130           end.
     1131           else do:
     1132             APPLY "TAB" to hh.
     1133             return no-apply.
     1134           end.
     1135         end.
     1136         hh = hh:next-sibling.
     1137       end.
     1138     end.
     1139   END.
     1140   procedure proc-move-forward :
     1141   define variable ii as integer no-undo .
     1142   define variable fh as widget-handle no-undo .
     1143   define variable hh as widget-handle no-undo .
     1144   define variable v-next-widget-name as character no-undo .
     1145   do
     1146   on error undo, return error
     1147   :
     1148     if v-tab-order <> '' then do:
     1149       if self:type = "TOGGLE-BOX" then
     1150       self:BGCOLOR = ?.
     1151       assign
     1152       ii = lookup(self:name, v-tab-order).
     1153       assign
     1154       ii = ii + 1
     1155       v-next-widget-name = entry(ii, v-tab-order)
     1156       no-error .
     1157       if error-status:error then do:
     1158         assign
     1159         ii = 1
     1160         v-next-widget-name = entry( ii, v-tab-order)
     1161         .
     1162       end.
     1163       assign
     1164       fh = frame Dialog-Frame:first-child
     1165       hh = fh:first-child
     1166       .
     1167       do while valid-handle(hh):
     1168         if hh:name = v-next-widget-name then do:
     1169           if hh:sensitive  = yes
     1170           AND hh:visible = yes then do:
     1171             if hh:type = "TOGGLE-BOX":U then do:
     1172               assign
     1173               hh:BGcolor = 1
     1174               .
     1175             end.
     1176             APPLY "ENTRY" to hh.
     1177             return.
     1178           end.
     1179           else do:
     1180             assign
     1181             ii = ii + 1
     1182             v-next-widget-name = entry(ii, v-tab-order)
     1183             no-error .
     1184             if error-status:error then do:
     1185               assign
     1186               ii = 1
     1187               v-next-widget-name = entry( ii, v-tab-order)
     1188               .
     1189             end.
     1190           end.
     1191         end.
     1192         hh = hh:next-sibling.
     1193       end.
     1194     end.
     1195   end.
     1196   end procedure.
     1197     IF p-mode <> 'ПРОСМОТР':U
     1198     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     1199         MESSAGE
     1200         vss-workfile vss-revision vss-description skip
     1201         "Неверное значение параметра p-mode" p-mode
     1202         VIEW-AS ALERT-BOX ERROR.
     1203         UNDO, RETURN ERROR.
     1204     END.
     1205     IF p-obj-type <> 'маг':U
     1206     and p-obj-type <> 'скл':U
     1207     and p-obj-type <> 'орг':U
     1208     and p-obj-type <> '':U
     1209     THEN DO:
     1210         MESSAGE
     1211         vss-workfile vss-revision vss-description skip
     1212         "Неверное значение параметра p-obj-type" p-obj-type
     1213         VIEW-AS ALERT-BOX ERROR.
     1214         UNDO, RETURN ERROR.
     1215     END.
     1216     if p-obj-type = 'маг':U then do:
     1217       FIND FIRST X_shop NO-LOCK WHERE X_shop.obj-code = p-obj-code NO-ERROR.
     1218       IF NOT AVAILABLE X_shop THEN DO:
     1219           MESSAGE
     1220           vss-workfile vss-revision vss-description skip
     1221           "Неверное значение параметра p-obj-code" p-obj-code
     1222           VIEW-AS ALERT-BOX ERROR.
     1223           UNDO, RETURN ERROR.
     1224       END.
     1225   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1226   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1227     (input  'маг':U
     1228     ,input  p-obj-code
     1229     ,output v-db-num
     1230     )  .
     1231       IF v-db-num <> v-cntxt-db-num
     1232       AND v-cntxt-db-num <> 0
     1233       and p-mode <> 'ПРОСМОТР':U
     1234       THEN DO:
     1235           MESSAGE
     1236           "Нельзя менять параметры магазина в чужой БД" skip
     1237           "магазин принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     1238           VIEW-AS ALERT-BOX ERROR.
     1239           UNDO, RETURN ERROR.
     1240       END.
     1241     end.
     1242     if p-obj-type = 'скл':U then do:
     1243       FIND FIRST X_store NO-LOCK WHERE X_store.obj-code = p-obj-code NO-ERROR.
     1244       IF NOT AVAILABLE X_store THEN DO:
     1245           MESSAGE
     1246           vss-workfile vss-revision vss-description skip
     1247           "Неверное значение параметра p-obj-code" p-obj-code
     1248           VIEW-AS ALERT-BOX ERROR.
     1249           UNDO, RETURN ERROR.
     1250       END.
     1251   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1252   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1253     (input  'скл':U
     1254     ,input  p-obj-code
     1255     ,output v-db-num
     1256     )  .
     1257       IF v-db-num <> v-cntxt-db-num
     1258       AND v-cntxt-db-num <> 0
     1259       and p-mode <> 'ПРОСМОТР':U
     1260       THEN DO:
     1261           MESSAGE
     1262           "Нельзя менять параметры склада в чужой БД" skip
     1263           "склад принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     1264           VIEW-AS ALERT-BOX ERROR.
     1265           UNDO, RETURN ERROR.
     1266       END.
     1267     end.
     1268     if p-obj-type = 'орг':U then do:
     1269       FIND FIRST X_sysconf NO-LOCK WHERE X_sysconf.host-code = p-obj-code NO-ERROR.
     1270       IF NOT AVAILABLE X_sysconf THEN DO:
     1271           MESSAGE
     1272           vss-workfile vss-revision vss-description skip
     1273           "Неверное значение параметра p-obj-code" p-obj-code
     1274           VIEW-AS ALERT-BOX ERROR.
     1275           UNDO, RETURN ERROR.
     1276       END.
     1277       if v-cntxt-db-num <> 0
     1278       and p-mode <> 'ПРОСМОТР':U
     1279       then do:
     1280           MESSAGE
     1281           "Нельзя менять параметры ФИРМЫ в УБД" skip
     1282           VIEW-AS ALERT-BOX ERROR.
     1283           UNDO, RETURN ERROR.
     1284       end.
     1285     end.
     1286     if p-obj-type = '':U then do:
     1287       if v-cntxt-db-num <> 0
     1288       and p-mode <> 'ПРОСМОТР':U
     1289       then do:
     1290           MESSAGE
     1291           "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" skip
     1292           VIEW-AS ALERT-BOX ERROR.
     1293           UNDO, RETURN ERROR.
     1294       end.
     1295     end.
     1296     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     1297       FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
     1298                 LOCKED_thbj-attr.obj-type = p-obj-type
     1299           AND   LOCKED_thbj-attr.obj-code = p-obj-code
     1300           AND   LOCKED_thbj-attr.upper-prop-code = 'rt-trn-doc':U
     1301           AND   LOCKED_thbj-attr.prop-code = '':U NO-WAIT NO-ERROR.
     1302        if locked locked_thbj-attr then do:
     1303           message
     1304           vss-workfile vss-revision vss-description skip
     1305            "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
     1306           view-as alert-box error .
     1307           undo, return error.
     1308         end.
     1309     END.
     1310     ELSE DO:
     1311         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
     1312             LOCKED_thbj-attr.obj-type = p-obj-type
     1313       AND   LOCKED_thbj-attr.obj-code = p-obj-code
     1314       AND   LOCKED_thbj-attr.upper-prop-code = 'rt-trn-doc':U
     1315       AND   LOCKED_thbj-attr.prop-code = '':U NO-ERROR.
     1316     END.
     1317     if not available locked_thbj-attr then do:
     1318       ASSIGN
     1319       v-to-create  = YES.
     1320       message
     1321       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     1322                   chr(10))
     1323       view-as alert-box WARNING.
     1324     end.
     1325     RUN FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     1326     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     1327     RUN Myenable.
     1328     WAIT-FOR GO OF FRAME Dialog-Frame.
     1329   END.
     1330   RUN disable_UI.
     1331   PROCEDURE disable_UI :
     1332     HIDE FRAME Dialog-Frame.
     1333   END PROCEDURE.
     1334   PROCEDURE enable_UI :
     1335     OPEN QUERY Dialog-Frame FOR EACH tt-trn-doc SHARE-LOCK.
     1336     GET FIRST Dialog-Frame.
     1337     DISPLAY wrkr-name agnt-name boss-name
     1338         WITH FRAME Dialog-Frame.
     1339     IF AVAILABLE tt-trn-doc THEN
     1340       DISPLAY tt-trn-doc.wrkr tt-trn-doc.agnt tt-trn-doc.boss
     1341         WITH FRAME Dialog-Frame.
     1342     ENABLE B-exit b-quit B-Help B-1 tt-trn-doc.wrkr r-wrkr B-2 tt-trn-doc.agnt
     1343            r-agnt B-3 tt-trn-doc.boss r-boss wrkr-name agnt-name boss-name
     1344         WITH FRAME Dialog-Frame.
     1345     VIEW FRAME Dialog-Frame.
     1346   END PROCEDURE.
     1347   PROCEDURE fill-widgets :
     1348   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     1349   DEFINE VARIABLE v-entry AS CHARACTER NO-UNDO.
     1350   define variable v-param-type as character no-undo .
     1351   define variable v-param-value as character no-undo .
     1352   DEFINE VARIABLE v-cli-type LIKE ub.clients.obj-type NO-UNDO.
     1353   DEFINE VARIABLE v-cli-code LIKE ub.clients.obj-code NO-UNDO.
     1354   DEFINE VARIABLE v-obj-name LIKE ub.clients.obj-name NO-UNDO.
     1355   define variable v-value-character as character no-undo .
     1356   define variable v-value-date as date no-undo .
     1357   define variable v-value-decimal as decimal no-undo .
     1358   define variable v-value-integer as INTEGER no-undo .
     1359   define variable v-value-logical AS LOGICAL no-undo .
     1360   DEFINE BUFFER buf_clients FOR ub.clients.
     1361   FOR EACH tt-trn-doc:
     1362     DELETE tt-trn-doc.
     1363   END.
     1364   FOR EACH thbjattr_thbj-attr:
     1365     delete thbjattr_thbj-attr.
     1366   end.
     1367   FOR EACH temp-thbj-attr:
     1368     delete temp-thbj-attr.
     1369   end.
     1370   CREATE tt-trn-doc.
     1371   run adm/shattri.p (
     1372                 input "init":U
     1373               , input p-obj-type
     1374               , input p-obj-code
     1375               , input 'rt-trn-doc':U
     1376               , input "":U
     1377               , output v-value-character
     1378               , output v-value-date
     1379               , output v-value-decimal
     1380               , output v-value-integer
     1381               , output v-value-logical
     1382               , output v-param-type
     1383               , input-output table-handle v-tth
     1384               ) no-error .
     1385   if error-status:error
     1386   and not available locked_thbj-attr
     1387   then do:
     1388     message
     1389     "Не удалось получить начальные значения настроек" skip
     1390     error-status:get-message(1) return-value
     1391     view-as alert-box error .
     1392     undo, return error .
     1393   end.
     1394   FOR EACH thbjattr_thbj-attr:
     1395     ASSIGN
     1396     v-entry = thbjattr_thbj-attr.prop-code.
     1397     if v-entry = 'wrkr':U
     1398     then do:
     1399       assign
     1400       tt-trn-doc.wrkr = thbjattr_thbj-attr.property-value-integer
     1401       tt-trn-doc.wrkr:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1402       .
     1403     end.
     1404     if v-entry = 'agnt':U
     1405     then do:
     1406       assign
     1407       tt-trn-doc.agnt = thbjattr_thbj-attr.property-value-integer
     1408       tt-trn-doc.agnt:private-data = "recid=" + string(recid(thbjattr_thbj-attr))
     1409       .
     1410     end.
     1411     if v-entry = 'boss':U
     1412     then do:
     1413       assign
     1414       tt-trn-doc.boss = thbjattr_thbj-attr.property-value-integer
     1415       tt-trn-doc.boss:private-data = "recid=" + string(recid(thbjattr_thbj-attr))
     1416       .
     1417     end.
     1418     create temp-thbj-attr.
     1419     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     1420   end.
     1421   if tt-trn-doc.wrkr = 0 then tt-trn-doc.wrkr = ?.
     1422   if tt-trn-doc.agnt = 0 then tt-trn-doc.agnt = ?.
     1423   if tt-trn-doc.boss = 0 then tt-trn-doc.boss = ?.
     1424   END PROCEDURE.
     1425   PROCEDURE local-psn-chk :
     1426   define input parameter p-man    as character no-undo.
     1427   define input parameter p-action as character no-undo.
     1428   DEFINE VARIABLE ref-list AS CHARACTER NO-UNDO.
     1429   if p-man = 'wrkr':U and p-action = "ret-mouse" then do:
     1430     define variable v-ref-rec11   as recid no-undo .
     1431     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-trn-doc.wrkr
     1432                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     1433     if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:
     1434       if input frame Dialog-Frame tt-trn-doc.wrkr <> ""
     1435          and input frame Dialog-Frame tt-trn-doc.wrkr <> ? then
     1436         message "Из справочника клиентов Вы должны выбрать человека.".
     1437       run ref/cli-all.w (  input parparentproc
     1438                     ,  input "b-sel"
     1439                     ,  input 'чел':U
     1440                     ,  input ?
     1441                     ,  input ?
     1442                     ,  input v-ref-rec11
     1443                     ,  input ",,,,,,NO"
     1444                     ,  input "lock-cli-type"
     1445                     , output ref-list ) .
     1446       assign v-ref-rec11 = integer( ref-list ).
     1447       find cli-buf where recid (cli-buf) =
     1448          v-ref-rec11
     1449          no-lock no-error.
     1450       if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then
     1451         find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-trn-doc.wrkr
     1452                              and cli-buf.obj-type = 'чел':U no-lock no-error.
     1453     end.
     1454     if available cli-buf and can-do( 'чел':U, cli-buf.obj-type ) then do:
     1455       display cli-buf.obj-code @ tt-trn-doc.wrkr
     1456               cli-buf.obj-name @ wrkr-name with frame Dialog-Frame.
     1457       assign frame Dialog-Frame tt-trn-doc.wrkr.
     1458     end.
     1459     else display ? @ tt-trn-doc.wrkr
     1460                  ? @ wrkr-name with frame Dialog-Frame.
     1461     apply "entry" to tt-trn-doc.agnt in frame Dialog-Frame.
     1462   if available cli-buf then do:
     1463         display cli-buf.obj-code @ tt-trn-doc.wrkr cli-buf.obj-name @ wrkr-name with frame Dialog-Frame.
     1464     end.
     1465     else display ? @ tt-trn-doc.wrkr ? @ wrkr-name with frame Dialog-Frame.
     1466         return no-apply.
     1467   end.
     1468   if p-man = 'wrkr':U and p-action = "button" then do:
     1469     define variable v-ref-rec12   as recid no-undo .
     1470     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-trn-doc.wrkr
     1471                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     1472     assign v-ref-rec12 = ( if available cli-buf then recid( cli-buf ) else ? ).
     1473     release cli-buf.
     1474     if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:
     1475       run ref/cli-all.w (  input parparentproc
     1476                     ,  input "b-sel"
     1477                     ,  input 'чел':U
     1478                     ,  input ?
     1479                     ,  input ?
