      116   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      118   define  shared variable RepPathName        as character no-undo .
