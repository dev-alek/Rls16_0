      358   procedure usr-prnt-sheet1-write-line-data :
      359   define input parameter p-firm-code as character        no-undo.
      360   define input parameter p-firm-name  as character        no-undo.
      361   do
      362   on error undo, return error
      363   :
      364         put stream excel-line unformatted
      365                               "Фирмы":U
      366               chr(9)   "DTA":U
      367               chr(9)   p-firm-code
      368               chr(9)   p-firm-name
      369               chr(10)
      370         .
      371   end.
      372   end procedure.
      373   procedure usr-prnt-sheet2-write-line-data :
      374   define input parameter p-obj-type as character        no-undo.
