      120   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      121   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      122   procedure paramls-clear :
      123     define buffer buf_temp-param for temp-param .
      124     do
      125     on error undo, return error return-value
      126     :
      127       for each buf_temp-param
      128       on error undo, return error
      129       :
      130         delete buf_temp-param .
      131       end.
      132     end.
      133   end procedure.
      134   procedure paramls-write :
      135     define input  parameter p-code     as character no-undo .
      136     define input  parameter p-sub-code as character no-undo .
      137     define input  parameter p-value    as character no-undo .
      138     define buffer buf_temp-param for temp-param .
      139     do
      140     on error undo, return error return-value
      141     :
      142       find first buf_temp-param
      143         where buf_temp-param.param-code     = p-code
      144           and buf_temp-param.param-sub-code = p-sub-code
      145         no-error .
      146       if not available buf_temp-param then do:
      147         create buf_temp-param .
      148         assign
      149           buf_temp-param.param-code     = p-code
      150           buf_temp-param.param-sub-code = p-sub-code
      151         .
      152       end.
      153       assign
      154         buf_temp-param.param-value = p-value
      155       .
      156     end.
      157   end procedure.
      158   procedure paramls-read :
      159     define input  parameter p-code          as character no-undo .
      160     define input  parameter p-sub-code      as character no-undo .
      161     define input  parameter p-default-value as character no-undo .
      162     define output parameter p-value         as character no-undo .
      163     define buffer buf_temp-param for temp-param .
      164     do
      165     on error undo, return error return-value
      166     :
      167       find first buf_temp-param
      168         where buf_temp-param.param-code     = p-code
      169           and buf_temp-param.param-sub-code = p-sub-code
      170         no-error .
      171       if available buf_temp-param then do:
      172         assign
      173           p-value = buf_temp-param.param-value
      174         .
      175       end.
      176       else do:
      177         assign
      178           p-value = p-default-value
      179         .
      180       end.
      181     end.
      182   end procedure.
      183   procedure paramls-append :
      184     define input  parameter p-code     as character no-undo .
      185     define input  parameter p-sub-code as character no-undo .
      186     define input  parameter p-value    as character no-undo .
      187     define buffer buf_temp-param for temp-param .
      188     do
      189     on error undo, return error return-value
      190     :
      191       find first buf_temp-param
      192            where buf_temp-param.param-code     = p-code
      193              and buf_temp-param.param-sub-code = p-sub-code
      194         no-error .
      195       if not available buf_temp-param then do:
      196         create buf_temp-param .
      197         assign
      198           buf_temp-param.param-code     = p-code
      199           buf_temp-param.param-sub-code = p-sub-code
      200           buf_temp-param.param-value    = p-value
      201         .
      202       end.
      203       else do:
      204           assign
      205               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      206           .
      207       end.
      208     end.
      209   end procedure.
      210   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
