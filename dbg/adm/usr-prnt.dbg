      426   procedure usr-prnt-write-cell-data :
      427   define input parameter p-data-key   as character        no-undo.
      428   define input parameter p-data-value as character        no-undo.
      429       define buffer buf_temp_cell-data     for temp_cell-data.
      430   do
      431   for buf_temp_cell-data
      432   on error undo, return error
      433   :
      434       find first buf_temp_cell-data
      435            where buf_temp_cell-data.data-key = p-data-key
      436       no-error.
      437       if not available buf_temp_cell-data
      438       then do:
      439           create buf_temp_cell-data.
      440           assign
      441               buf_temp_cell-data.data-key = p-data-key
      442           .
      443       end.
      444       assign
      445           buf_temp_cell-data.data-value = p-data-value
      446       .
      447       put stream excel-cell unformatted
      448                           buf_temp_cell-data.data-key
      449           chr(9)   buf_temp_cell-data.data-value
      450           chr(10)
      451       .
      452   end.
      453   end procedure.
      454   procedure usr-prnt-run-excel :
      455   define input parameter p-header-filename    as character        no-undo.
      456   define input parameter p-data-filename      as character        no-undo.
      457   define variable v-template-file-name    as character    no-undo.
      458   define variable v-vb-file-name          as character    no-undo.
      459   define buffer buf_temp-param for temp-param .
      460   do
      461   for buf_temp-param
      462   on error undo, return error
      463   :
      464       create buf_temp-param.
      465       assign
      466           v-template-file-name    = search( "exe/user.xlt" )
      467           v-vb-file-name          = search( "exe/t_form.bas" )
      468       .
      469       if v-template-file-name = ?
      470       or v-template-file-name = "":U
      471       then do:
      472           message
      473               "Ошибка имени файла шаблона."
      474           view-as alert-box error.
      475       end.
      476       if v-vb-file-name = ?
      477       or v-vb-file-name = "":U
      478       then do:
      479           message
      480               "Ошибка имени файла кода обработки."
      481           view-as alert-box error.
      482       end.
      483       run paramls-write in this-procedure (
      484             input "template":U
      485           , input "template-file-name":U
      486           , input v-template-file-name
      487       ).
      488       run paramls-write in this-procedure (
      489             input "template":U
      490           , input "vb-file-name":U
      491           , input v-vb-file-name
      492       ).
      493       run paramls-write in this-procedure (
      494             input "data":U
      495           , input "data-header-filename":U
      496           , input p-header-filename
      497       ).
      498       run paramls-write in this-procedure (
      499             input "data":U
      500           , input "data-filename":U
      501           , input p-data-filename
      502       ).
      503       run gbl/macroxlt.p (
      504           input-output table buf_temp-param
      505       ) no-error.
      506       if error-status :error
      507       then do:
      508           message
      509                    vss-workfile vss-revision vss-description
      510               skip(1)
      511               skip "Ошибка создания файла Excel."
      512               skip return-value
      513               skip trim(error-status :get-message(1))
      514                    trim(error-status :get-message(2))
      515                    trim(error-status :get-message(3))
      516           view-as alert-box error.
      517           undo, return error .
      518       end.
      519   end.
      520   end procedure.
      521   procedure usr-prnt-close :
      522   do
      523   on error undo, return error
      524   :
      525       output stream excel-line close.
      526       output stream excel-cell close.
      527       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
      528           export "exe/user.xlt" .
      529           export "exe/t_form.bas" .
      530           export v-usr-prnt-cell-file-name.
      531           export v-usr-prnt-data-file-name.
      532       output close.
      533   end.
      534   end procedure.
      535     FIND FIRST buf_global-state
      536       NO-LOCK
      537       .
      538     FIND FIRST buf_global-state-attr
      539       WHERE buf_global-state-attr.gls-id = buf_global-state.gls-id
      540       AND buf_global-state-attr.attr-code = "action-gbl"
      541       EXCLUSIVE-LOCK
      542       NO-error
      543       .
      544     IF AVAILABLE buf_global-state-attr
      545       THEN
      546     DO:
      547       if buf_global-state-attr.attr-value = "yes" then v-action-gbl = yes .
      548     END.
      549      FIND FIRST buf_user-account
      550         WHERE buf_user-account.user-id = p-user-id
      551         NO-LOCK
      552         NO-ERROR
      553         .
      554      IF NOT AVAILABLE buf_user-account
      555      THEN DO:
      556         message
      557            "Пользователь" p-user-id "не найден"
      558            skip
      559         view-as alert-box information.
      560         return.
      561      END.
      562      FIND FIRST buf_user-login
      563         WHERE buf_user-login.user-id = buf_user-account.user-id
      564            AND buf_user-login.db-num = p-db-num
      565         NO-LOCK
      566         NO-ERROR
      567         .
      568      IF NOT AVAILABLE buf_user-login
      569      THEN DO:
      570         message
      571            "У пользователя" buf_user-account.nik "отсутствует логин"
      572            skip "для БД" p-db-num
      573         view-as alert-box information.
      574         return.
      575      END.
      576      run open-stream     IN THIS-PROCEDURE .
      577      run print-header    in this-procedure .
      578      run print-body      in this-procedure .
      579      run close-stream    IN THIS-PROCEDURE .
      580   end.
      581   procedure open-stream :
      582   do
      583   on error undo, return error
      584   :
      585   if session :set-wait-state( "compiler" ) then.
      586   output stream out-stream to value( string( session:temp-directory +
      587                                        "rpt" + string( g#report-num ) ) )
      588                                        page-size 62 .
      589       put stream out-stream unformatted
      590             chr(10)
      591           + "Печатная форма предназначена только для вывода в Microsoft Excel."
      592           + chr(10)
      593       .
      594       output stream out-stream close.
      595       run usr-prnt-init in this-procedure.
      596   end.
      597   end procedure.
      598   PROCEDURE print-header :
      599   do
      600   on error undo, return error
      601   :
      602       run usr-prnt-write-cell-data in this-procedure (
      603             input "user_id_1":U
      604           , input buf_user-account.user-id
      605       ).
      606       run usr-prnt-write-cell-data in this-procedure (
      607             input "user_name_1":U
      608           , input buf_user-account.last-name
      609       ).
      610       run usr-prnt-write-cell-data in this-procedure (
      611             input "user_nik_1":U
      612           , input buf_user-account.nik
      613       ).
      614       run usr-prnt-write-cell-data in this-procedure (
      615             input "user_login_1":U
      616           , input buf_user-login.user-login
      617       ).
      618       run usr-prnt-write-cell-data in this-procedure (
      619             input "user_db_1":U
      620           , input buf_user-login.db-num
      621       ).
      622       run usr-prnt-write-cell-data in this-procedure (
      623             input "user_id_2":U
      624           , input buf_user-account.user-id
      625       ).
      626       run usr-prnt-write-cell-data in this-procedure (
      627             input "user_name_2":U
      628           , input buf_user-account.last-name
      629       ).
      630       run usr-prnt-write-cell-data in this-procedure (
      631             input "user_nik_2":U
      632           , input buf_user-account.nik
      633       ).
      634       run usr-prnt-write-cell-data in this-procedure (
      635             input "user_login_2":U
      636           , input buf_user-login.user-login
      637       ).
      638       run usr-prnt-write-cell-data in this-procedure (
      639             input "user_db_2":U
      640           , input buf_user-login.db-num
      641       ).
      642       run usr-prnt-write-cell-data in this-procedure (
      643             input "user_id_3":U
      644           , input buf_user-account.user-id
      645       ).
      646       run usr-prnt-write-cell-data in this-procedure (
      647             input "user_name_3":U
      648           , input buf_user-account.last-name
      649       ).
      650       run usr-prnt-write-cell-data in this-procedure (
      651             input "user_nik_3":U
      652           , input buf_user-account.nik
      653       ).
      654       run usr-prnt-write-cell-data in this-procedure (
      655             input "user_login_3":U
      656           , input buf_user-login.user-login
      657       ).
      658       run usr-prnt-write-cell-data in this-procedure (
      659             input "user_db_3":U
      660           , input buf_user-login.db-num
      661       ).
      662       run usr-prnt-write-cell-data in this-procedure (
      663             input "user_id_4":U
      664           , input buf_user-account.user-id
      665       ).
      666       run usr-prnt-write-cell-data in this-procedure (
      667             input "user_name_4":U
      668           , input buf_user-account.last-name
      669       ).
      670       run usr-prnt-write-cell-data in this-procedure (
      671             input "user_nik_4":U
      672           , input buf_user-account.nik
      673       ).
      674       run usr-prnt-write-cell-data in this-procedure (
      675             input "user_login_4":U
      676           , input buf_user-login.user-login
      677       ).
      678       run usr-prnt-write-cell-data in this-procedure (
      679             input "user_db_4":U
      680           , input buf_user-login.db-num
      681       ).
      682   end.
      683   END PROCEDURE.
      684   PROCEDURE print-body :
      685     define buffer buf_user-login-action-role for ub.user-login-action-role .
      686     define buffer buf_action-role-item       for ub.action-role-item .
      687     define buffer buf_action-item            for ub.action-item .
      688     define buffer buf_action-role            for ub.action-role .
      689     define buffer buf_user-host              for ub.user-host .
      690     define buffer buf_user-obj               for ub.user-obj .
      691     define buffer buf_user-menu-group        for ub.user-menu-group .
      692     define buffer buf_clients                for ub.clients .
      693     define buffer buf_menu-group             for ub.menu-group .
      694     define variable v-host-code like ub.user-host.host-code no-undo .
      695     define variable v-obj-code  like ub.user-obj.obj-code no-undo .
      696     define variable v-obj-type  like ub.user-obj.obj-type no-undo .
      697     do
      698       on error undo, return error
      699       :
      700       FOR EACH  buf_user-host WHERE
      701         buf_user-host.user-id = p-user-id
      702         NO-LOCK:
      703         if not v-action-gbl and buf_user-host.db-num  <> p-db-num then next .
      704         for FIRST buf_clients
      705           WHERE buf_clients.obj-type = 'орг':U
      706           AND buf_clients.obj-code = buf_user-host.host-code
      707           NO-LOCK
      708           :
      709           RUN usr-prnt-sheet1-write-line-data IN THIS-PROCEDURE
      710             ( INPUT buf_user-host.host-code
      711             , INPUT buf_clients.obj-name
      712             ) .
      713             v-host-code = buf_user-host.host-code .
      714         end.
      715       END.
      716       FOR EACH  buf_user-obj where
      717         buf_user-obj.user-id = p-user-id
      718         NO-LOCK:
      719         if not v-action-gbl and buf_user-obj.db-num  <> p-db-num then next .
      720         for FIRST buf_clients
      721           WHERE buf_clients.obj-type = buf_user-obj.obj-type
      722           AND buf_clients.obj-code = buf_user-obj.obj-code
      723           NO-LOCK
      724           :
      725           RUN usr-prnt-sheet2-write-line-data IN THIS-PROCEDURE
      726             ( INPUT buf_user-obj.obj-type
      727             , INPUT buf_user-obj.obj-code
      728             , INPUT buf_clients.obj-name
      729             ) .
      730             assign
      731               v-obj-code = buf_user-obj.obj-code
      732               v-obj-type = buf_user-obj.obj-type
      733             .
      734         END.
      735       end.
      736       FOR EACH  buf_user-menu-group
      737         WHERE buf_user-menu-group.user-id = p-user-id
      738         NO-LOCK
      739         ,
      740         each buf_menu-group
      741         WHERE buf_menu-group.menu-code        = buf_user-menu-group.menu-code
      742         AND buf_menu-group.menu-group-code  = buf_user-menu-group.menu-group-code
      743         :
      744         if not v-action-gbl and buf_user-menu-group.db-num  <> p-db-num then next .
      745         CASE buf_user-menu-group.menu-group-context:
      746           WHEN 'global':U
      747           THEN
      748             DO:
      749               RUN usr-prnt-sheet3-write-line-data IN THIS-PROCEDURE
      750                 ( INPUT "Глобально"
      751                 , INPUT buf_menu-group.menu-group-name
      752                 ) .
      753             END.
      754           WHEN 'firm':U
      755           THEN
      756             DO:
      757               FIND  FIRST buf_clients
      758                 WHERE buf_clients.obj-type = 'орг':U
      759                 AND buf_clients.obj-code = buf_user-menu-group.host-code
      760                 NO-LOCK
      761                 NO-ERROR
      762                 .
      763               IF AVAILABLE buf_clients
      764                 THEN
      765               DO:
      766                 RUN usr-prnt-sheet3-write-line-data IN THIS-PROCEDURE
      767                   ( INPUT SUBSTITUTE( "Фирма &1 &2", buf_clients.obj-code, buf_clients.obj-name)
      768                   , INPUT buf_menu-group.menu-group-name
      769                   ) .
      770               END.
      771             END.
      772           WHEN 'object':U
      773           THEN
      774             DO:
      775               FIND  FIRST buf_clients
      776                 WHERE buf_clients.obj-type = buf_user-menu-group.obj-type
      777                 AND buf_clients.obj-code = buf_user-menu-group.obj-code
      778                 NO-LOCK
      779                 NO-ERROR
      780                 .
      781               IF AVAILABLE buf_clients
      782                 THEN
      783               DO:
      784                 RUN usr-prnt-sheet3-write-line-data IN THIS-PROCEDURE
      785                   ( INPUT SUBSTITUTE( "&1 &2 &3", buf_clients.obj-type, buf_clients.obj-code, buf_clients.obj-name)
      786                   , INPUT buf_menu-group.menu-group-name
      787                   ) .
      788               END.
      789             END.
      790           OTHERWISE
      791           DO:
      792           END.
      793         END CASE.
      794       END.
      795       if v-action-gbl then
      796       do:
      797         FOR EACH buf_user-login-action-role
      798           WHERE buf_user-login-action-role.action-head-code    = 0
      799           AND buf_user-login-action-role.action-role-context = 'global':U
      800           AND buf_user-login-action-role.db-num              = p-db-num
      801           AND buf_user-login-action-role.user-id             = p-user-id
      802           NO-LOCK
      803           ,
      804           FIRST buf_action-role
      805           WHERE buf_action-role.action-head-code    = 0
      806           AND buf_action-role.action-role-code    = buf_user-login-action-role.action-role-code
      807           NO-LOCK
      808           :
      809           FOR EACH  buf_action-role-item
      810             WHERE buf_action-role-item.action-head-code    = 0
      811             AND buf_action-role-item.action-role-code    = buf_user-login-action-role.action-role-code
      812             NO-LOCK
      813             ,
      814             FIRST buf_action-item
      815             WHERE buf_action-item.action-head-code    = 0
      816             AND buf_action-item.action-item-code    = buf_action-role-item.action-item-code
      817             :
      818             RUN usr-prnt-sheet4-write-line-data IN THIS-PROCEDURE
      819               ( INPUT "Без привязки"
      820               , INPUT buf_action-role.action-role-name
      821               , INPUT buf_action-item.action-item-code
      822               , INPUT buf_action-item.action-item-name
      823               , INPUT buf_action-item.action-item-description
      824               ) .
      825           END.
      826         END.
      827         FOR EACH buf_user-login-action-role
      828           WHERE buf_user-login-action-role.action-head-code    = 0
      829           AND buf_user-login-action-role.action-role-context = 'firm':U
      830           AND buf_user-login-action-role.db-num              = p-db-num
      831           AND buf_user-login-action-role.user-id             = p-user-id
      832           NO-LOCK
      833           ,
      834           FIRST buf_action-role
      835           WHERE buf_action-role.action-head-code    = 0
      836           AND buf_action-role.action-role-code    = buf_user-login-action-role.action-role-code
      837           NO-LOCK
      838           :
      839           FOR EACH  buf_action-role-item
      840             WHERE buf_action-role-item.action-head-code    = 0
      841             AND buf_action-role-item.action-role-code    = buf_user-login-action-role.action-role-code
      842             NO-LOCK
      843             ,
      844             FIRST buf_action-item
      845             WHERE buf_action-item.action-head-code    = 0
      846             AND buf_action-item.action-item-code    = buf_action-role-item.action-item-code
      847             :
      848             RUN usr-prnt-sheet4-write-line-data IN THIS-PROCEDURE
      849               ( INPUT SUBSTITUTE("Фирма &1", buf_user-login-action-role.host-code)
      850               , INPUT buf_action-role.action-role-name
      851               , INPUT buf_action-item.action-item-code
      852               , INPUT buf_action-item.action-item-name
      853               , INPUT buf_action-item.action-item-description
      854               ) .
      855           END.
      856         END.
      857         FOR EACH buf_user-login-action-role
      858           WHERE buf_user-login-action-role.action-head-code    = 0
      859           AND buf_user-login-action-role.action-role-context = 'object':U
      860           AND buf_user-login-action-role.db-num              = p-db-num
      861           AND buf_user-login-action-role.user-id             = p-user-id
      862           NO-LOCK
      863           ,
      864           FIRST buf_action-role
      865           WHERE buf_action-role.action-head-code    = 0
      866           AND buf_action-role.action-role-code    = buf_user-login-action-role.action-role-code
      867           NO-LOCK
      868           :
      869           FOR EACH  buf_action-role-item
      870             WHERE buf_action-role-item.action-head-code    = 0
      871             AND buf_action-role-item.action-role-code    = buf_user-login-action-role.action-role-code
      872             NO-LOCK
      873             ,
      874             FIRST buf_action-item
      875             WHERE buf_action-item.action-head-code    = 0
      876             AND buf_action-item.action-item-code    = buf_action-role-item.action-item-code
      877             :
      878             RUN usr-prnt-sheet4-write-line-data IN THIS-PROCEDURE
      879               ( INPUT SUBSTITUTE("&1 &2", buf_user-login-action-role.obj-type, buf_user-login-action-role.obj-code)
      880               , INPUT buf_action-role.action-role-name
      881               , INPUT buf_action-item.action-item-code
      882               , INPUT buf_action-item.action-item-name
      883               , INPUT buf_action-item.action-item-description
      884               ) .
      885           END.
      886         END.
      887       end.
      888       else
      889       do:
      890         FOR EACH buf_user-login-action-role
      891           WHERE buf_user-login-action-role.action-head-code    = 0
      892           AND buf_user-login-action-role.db-num              = p-db-num
      893           AND buf_user-login-action-role.action-role-context = 'global':U
      894           AND buf_user-login-action-role.user-id             = p-user-id
      895           NO-LOCK
      896           ,
      897           FIRST buf_action-role
      898           WHERE buf_action-role.action-head-code    = 0
      899           AND buf_action-role.action-role-code    = buf_user-login-action-role.action-role-code
      900           AND buf_action-role.db-num              = p-db-num
      901           NO-LOCK
      902           :
      903           FOR EACH  buf_action-role-item
      904             WHERE buf_action-role-item.action-head-code    = 0
      905             AND buf_action-role-item.action-role-code    = buf_user-login-action-role.action-role-code
      906             AND buf_action-role-item.db-num              = p-db-num
      907             NO-LOCK
      908             ,
      909             FIRST buf_action-item
      910             WHERE buf_action-item.action-head-code    = 0
      911             AND buf_action-item.action-item-code    = buf_action-role-item.action-item-code
      912             :
      913             RUN usr-prnt-sheet4-write-line-data IN THIS-PROCEDURE
      914               ( INPUT "Без привязки"
      915               , INPUT buf_action-role.action-role-name
      916               , INPUT buf_action-item.action-item-code
      917               , INPUT buf_action-item.action-item-name
      918               , INPUT buf_action-item.action-item-description
      919               ) .
      920           END.
      921         END.
      922         FOR EACH buf_user-login-action-role
      923           WHERE buf_user-login-action-role.action-head-code    = 0
      924           AND buf_user-login-action-role.db-num              = p-db-num
      925           AND buf_user-login-action-role.action-role-context = 'firm':U
      926           AND buf_user-login-action-role.user-id             = p-user-id
      927           NO-LOCK
      928           ,
      929           FIRST buf_action-role
      930           WHERE buf_action-role.action-head-code    = 0
      931           AND buf_action-role.action-role-code    = buf_user-login-action-role.action-role-code
      932           AND buf_action-role.db-num              = p-db-num
      933           NO-LOCK
      934           :
      935           FOR EACH  buf_action-role-item
      936             WHERE buf_action-role-item.action-head-code    = 0
      937             AND buf_action-role-item.action-role-code    = buf_user-login-action-role.action-role-code
      938             AND buf_action-role-item.db-num              = p-db-num
      939             NO-LOCK
      940             ,
      941             FIRST buf_action-item
      942             WHERE buf_action-item.action-head-code    = 0
      943             AND buf_action-item.action-item-code    = buf_action-role-item.action-item-code
      944             :
      945             RUN usr-prnt-sheet4-write-line-data IN THIS-PROCEDURE
      946               ( INPUT SUBSTITUTE("Фирма &1", buf_user-login-action-role.host-code)
      947               , INPUT buf_action-role.action-role-name
      948               , INPUT buf_action-item.action-item-code
      949               , INPUT buf_action-item.action-item-name
      950               , INPUT buf_action-item.action-item-description
      951               ) .
      952           END.
      953         END.
      954         FOR EACH buf_user-login-action-role
      955           WHERE buf_user-login-action-role.action-head-code    = 0
      956           AND buf_user-login-action-role.db-num              = p-db-num
      957           AND buf_user-login-action-role.action-role-context = 'object':U
      958           AND buf_user-login-action-role.user-id             = p-user-id
      959           NO-LOCK
      960           ,
      961           FIRST buf_action-role
      962           WHERE buf_action-role.action-head-code    = 0
      963           AND buf_action-role.action-role-code    = buf_user-login-action-role.action-role-code
      964           AND buf_action-role.db-num              = p-db-num
      965           NO-LOCK
      966           :
      967           FOR EACH  buf_action-role-item
      968             WHERE buf_action-role-item.action-head-code    = 0
      969             AND buf_action-role-item.action-role-code    = buf_user-login-action-role.action-role-code
      970             AND buf_action-role-item.db-num              = p-db-num
      971             NO-LOCK
      972             ,
      973             FIRST buf_action-item
      974             WHERE buf_action-item.action-head-code    = 0
      975             AND buf_action-item.action-item-code    = buf_action-role-item.action-item-code
      976             :
      977             RUN usr-prnt-sheet4-write-line-data IN THIS-PROCEDURE
      978               ( INPUT SUBSTITUTE("&1 &2", buf_user-login-action-role.obj-type, buf_user-login-action-role.obj-code)
      979               , INPUT buf_action-role.action-role-name
      980               , INPUT buf_action-item.action-item-code
      981               , INPUT buf_action-item.action-item-name
      982               , INPUT buf_action-item.action-item-description
      983               ) .
      984           END.
      985         END.
      986       end.
      987     end.
      988   END PROCEDURE.
      989   procedure close-stream :
      990   do
      991   on error undo, return error
      992   :
      993       run usr-prnt-close in this-procedure .
      994       os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
      995       os-rename
      996           value( string( session:temp-directory ) + "$" + string( g#report-num ) + ".txl" )
      997           value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
      998       .
      999   if session :set-wait-state( "" ) then.
     1000       define variable v-user-action   as character no-undo .
     1001       define variable v-printed       as logical   no-undo .
     1002       define variable DisabledOptions as integer   no-undo .
     1003       define variable v-orient-page as character no-undo .
     1004       run gbl/prnfilen.w (
     1005             input "":U
     1006           , input 20
     1007           , input string(session :temp-directory) + "rpt" + string( g#report-num )
     1008           , input 7
     1009           , output v-user-action
     1010           , output v-printed
     1011       ).
     1012       os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     1013   end.
     1014   end procedure.
