        1   block-level on error undo, throw.
        2   define input parameter p-action      as   character    no-undo .
        3   define input parameter p-db-num      like ub.db.db-num no-undo .
        4   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   def var vss-author      as character no-undo init "$Author: expertek $":U .
        6   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   def var vss-workfile    as character no-undo init "$Workfile: chk-c-db.p $":U .
        8   def var vss-archive     as character no-undo init "$Archive: adm/chk-c-db.p $":U .
        9   def var vss-description as character no-undo init "Проверка корректности копии БД и ее подготовка".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   procedure cur-time :
       70      define output parameter p-today as date      no-undo .
       71      define output parameter p-time  as integer   no-undo .
       72     do
       73     on error undo, return error
       74     :
       75       define variable v-date1 as date      no-undo .
       76       define variable v-date2 as date      no-undo .
       77       define variable v-time  as integer   no-undo .
       78       assign
       79         v-date1 = today
       80         v-time  = time
       81         v-date2 = today
       82       .
       83       if v-date1 <> v-date2
       84       then do:
       85         assign
       86           v-date1 = today
       87           v-time  = v-time
       88         .
       89       end.
       90       assign
       91         p-today = v-date1
       92         p-time  = v-time
       93       .
       94     end.
       95   end.
       96   function cur-time-date returns character
       97   :
       98     return string(today, '99/99/9999':U) .
       99   end.
      100   function cur-time-mjd returns decimal
      101   :
      102     define variable v-date as date      no-undo .
      103     define variable v-time as integer   no-undo .
      104     run cur-time in this-procedure
      105       (output v-date
      106       ,output v-time
      107       ) .
      108     return integer(v-date) - 2400002 + (v-time / 86400) .
      109   end.
      110   function cur-time-get-ending-index returns integer
      111   (input p-number as integer
      112   )
      113   :
      114     if p-number < 0
      115     or p-number = ?
      116     then do:
      117       return 1 .
      118     end.
      119     define variable v-rest as integer   no-undo .
      120     assign
      121       p-number = p-number modulo 100
      122     .
      123     if p-number < 20
      124     then do:
      125       assign
      126         v-rest = p-number
      127       .
      128     end.
      129     else do:
      130       assign
      131         v-rest = p-number modulo 10
      132       .
      133     end.
      134     case v-rest :
      135       when 1
      136       then do:
      137         return 2 .
      138       end.
      139       when 2 or
      140       when 3 or
      141       when 4
      142       then do:
      143         return 3 .
      144       end.
      145       otherwise do:
      146         return 1 .
      147       end.
      148     end case .
      149   end.
      150   procedure cur-time-mjd-to-date :
      151      define input  parameter i-mjd-diff as decimal no-undo.
      152      define output parameter o-Date     as date    no-undo.
      153      define output parameter o-Time     as integer no-undo.
      154      define variable v-day-number as integer   no-undo .
      155      if    i-mjd-diff < 0
      156         or i-mjd-diff = ?
      157      then do:
      158         return "?" .
      159      end.
      160      assign
      161         v-day-number = truncate(i-mjd-diff,0).
      162         o-Date = date(v-day-number + 2400002).
      163         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      164     .
      165   end.
      166   function cur-time-mjd-to-string returns character
      167   (input p-mjd-diff as decimal
      168   )
      169   :
      170     define variable v-day-number as integer   no-undo .
      171     define variable v-seconds    as integer   no-undo .
      172     define variable v-hour       as integer   no-undo .
      173     define variable v-min        as integer   no-undo .
      174     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      175     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      176     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      177     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      178     if p-mjd-diff < 0
      179     or p-mjd-diff = ?
      180     then do:
      181       return "?" .
      182     end.
      183     assign
      184       v-day-number = integer(truncate(p-mjd-diff,0))
      185       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      186     .
      187     if v-seconds > 86400
      188     then do:
      189       assign
      190         v-seconds = 86400 - 1
      191       .
      192     end.
      193     if v-seconds < 0
      194     then do:
      195       assign
      196         v-seconds = 0
      197       .
      198     end.
      199     assign
      200       v-hour = truncate(v-seconds / 3600, 0)
      201     .
      202     assign
      203       v-seconds = v-seconds modulo 3600
      204     .
      205     assign
      206       v-min = truncate(v-seconds / 60, 0)
      207     .
      208     assign
      209       v-seconds = v-seconds modulo 60
      210     .
      211     return
      212         (if v-day-number <> 0
      213           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      214           else ""
      215         )
      216       + (if v-day-number <> 0 or v-hour <> 0
      217           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      218           else ""
      219         )
      220       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      221           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      222           else ""
      223         )
      224       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      225       .
      226   end.
      227   function cur-time-string returns character
      228   :
      229     define variable v-date as date      no-undo .
      230     define variable v-time as integer   no-undo .
      231     run cur-time in this-procedure
      232       (output v-date
      233       ,output v-time
      234       ) .
      235     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      236   end.
      237   function cur-time-string-sec returns character
      238   :
      239     define variable v-date as date      no-undo .
      240     define variable v-time as integer   no-undo .
      241     run cur-time in this-procedure
      242       (output v-date
      243       ,output v-time
      244       ) .
      245     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      246   end.
      247   function cur-time-custom  returns character
      248   (input p-prefix as character
      249   ,input p-date-format as character
      250   ,input p-delimiter as character
      251   ,input p-time-format as character
      252   ,input p-suffix as character
      253   )
      254   :
      255     define variable v-date as date      no-undo .
      256     define variable v-time as integer   no-undo .
      257     run cur-time in this-procedure
      258       (output v-date
      259       ,output v-time
      260       ) .
      261     return
      262       p-prefix
      263       + string(v-date, p-date-format)
      264       + p-delimiter
      265       + string(v-time, p-time-format)
      266       + p-suffix
      267       .
      268   end.
      269   function cur-time-print  returns character
      270   :
      271     define variable v-date as date      no-undo .
      272     define variable v-time as integer   no-undo .
      273     run cur-time in this-procedure
      274       (output v-date
      275       ,output v-time
      276       ) .
      277     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      278   end.
      279   function cur-time-datetime returns datetime
      280   :
      281     define variable v-char as character no-undo .
      282     define variable v-datetime as datetime no-undo .
      283     v-char = cur-time-string().
      284     v-datetime = datetime(v-char).
      285     return  v-datetime.
      286   end.
      287   function cur-time-string-msec returns character
      288   :
      289     define variable v-date as datetime  no-undo .
      290     v-date = now.
      291     return string(v-date) .
      292   end.
      293   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      294   define new global shared variable g#lib-nws as handle no-undo .
      295   do
      296   on error  undo, return error substitute("&1. error &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      297   on endkey undo, return error substitute("&1. endkey")
      298   on stop   undo, return error substitute("&1. stop")
      299   :
      300     define variable v-compare-log as logical no-undo .
      301     define variable v-copy-date as date      no-undo .
      302     define variable v-copy-time as integer   no-undo .
      303     define variable v-action    as character no-undo .
      304     define variable v-ind       as integer   no-undo .
      305     define variable v-compare   as logical   no-undo .
      306     define frame inf
      307       v-action label "Проверка соответствия" format "X(50)":U SKIP
      308       v-ind    label "Просмотрено записей" AT 3
      309       with view-as dialog-box SIDE-LABELS three-d title "Проверка корректности копии БД" SIZE 80 BY 3.5 .
      310     if transaction then do:
      311       message
      312         vss-workfile vss-revision vss-description skip
      313         "Вызов данной процедуры в транзакции недопустим" skip
      314         view-as alert-box error .
      315     end.
      316     if not connected( "db-copy":U ) then do:
      317       return error substitute( "&1. Копия БД не подключена!", vss-workfile ).
      318     end.
      319     view frame inf.
      320     assign
      321       v-action = "даты последней архивации, номеров и ключей БД"
      322       v-ind    = 0
      323     .
      324     do with frame inf
      325     :
      326       assign
      327         v-action :screen-value   = string( v-action, v-action :format)
      328         v-ind :screen-value      = string( v-ind, v-ind :format)
      329       .
      330     end.
      331     find first db-orig.sys-ctrl share-lock .
      332     find first db-copy.sys-ctrl share-lock .
      333     if db-orig.sys-ctrl.db-num <> db-copy.sys-ctrl.db-num then do:
      334       return error substitute( "&1. Копия ГБД не корректна! Отличаются номера БД.", vss-workfile ).
      335     end.
      336     if db-orig.sys-ctrl.cut-date <> db-copy.sys-ctrl.cut-date then do:
      337       return error substitute( "&1. Копия ГБД не корректна! Отличается дата последней архивации.", vss-workfile ).
      338     end.
      339     find first db-orig.db share-lock
      340       where db-orig.db.db-num = db-orig.sys-ctrl.db-num
      341     .
      342     find first db-copy.db share-lock
      343       where db-copy.db.db-num = db-orig.db.db-num
      344       no-error
      345     .
      346     if not available db-copy.db
      347       or db-copy.db.db-key <> db-orig.db.db-key
      348     then do:
      349       return error substitute( "&1. Копия ГБД не корректна! Отличаются ключи ГБД.", vss-workfile ).
      350     end.
      351     assign
      352       v-action = "даты и времени создания копии БД"
      353       v-ind    = 0
      354     .
      355     do with frame inf
      356     :
      357       assign
      358         v-action :screen-value   = string( v-action, v-action :format)
      359         v-ind :screen-value      = string( v-ind, v-ind :format)
      360       .
      361     end.
      362     if db-copy.sys-ctrl.status_ = 'copy-DB':U
      363       and ( db-orig.sys-ctrl.CopyDate <> db-copy.sys-ctrl.CopyDate
      364             or db-orig.sys-ctrl.CopyTimeInt <> db-copy.sys-ctrl.CopyTimeInt
      365           )
      366     then do:
      367       return error substitute( "&1. Копия ГБД не корректна! Отличаются дата и(или) время копирования.", vss-workfile ).
      368     end.
      369     assign
      370       v-action = "пакетов в исходной БД пакетам в копии БД"
      371       v-ind    = 0
      372     .
      373     for each db-orig.pck-sent share-lock
      374       where db-orig.pck-sent.rcvd = true
      375     on error undo, return error
      376     :
      377       if p-db-num <> ?
      378         and db-orig.pck-sent.db-num <> p-db-num
      379       then do:
      380         next.
      381       end.
      382       assign
      383         v-ind = v-ind + 1
      384       .
      385       do with frame inf
      386       :
      387         assign
      388           v-action :screen-value   = string( v-action, v-action :format)
      389           v-ind :screen-value      = string( v-ind, v-ind :format)
      390         .
      391       end.
      392       find first db-copy.pck-sent share-lock
      393         where db-copy.pck-sent.db-num   = db-orig.pck-sent.db-num
      394           and db-copy.pck-sent.pack-num = db-orig.pck-sent.pack-num
      395         no-error .
      396       if not available db-copy.pck-sent
      397         or db-orig.pck-sent.CRC-pack <> db-copy.pck-sent.CRC-pack
      398       then do:
      399         return error substitute( "&1. Копия ГБД не корректна! Найдены отличия в пакетах новостей. Пакет &2", vss-workfile, db-orig.pck-sent.pack-num ).
      400       end.
      401     end.
      402     assign
      403       v-action = "пакетов копии БД пакетам в исходной БД"
      404       v-ind    = 0
      405     .
      406     for each db-copy.pck-sent share-lock
      407     on error undo, return error
      408     :
      409       if p-db-num <> ?
      410         and db-copy.pck-sent.db-num <> p-db-num
      411       then do:
      412         next.
      413       end.
      414       assign
      415         v-ind = v-ind + 1
      416       .
      417       do with frame inf
      418       :
      419         assign
      420           v-action :screen-value   = string( v-action, v-action :format)
      421           v-ind :screen-value      = string( v-ind, v-ind :format)
      422         .
      423       end.
      424       find first db-orig.pck-sent share-lock
      425         where db-orig.pck-sent.db-num   = db-copy.pck-sent.db-num
      426           and db-orig.pck-sent.pack-num = db-copy.pck-sent.pack-num
      427         no-error .
      428       if not available db-orig.pck-sent
      429         or db-orig.pck-sent.CRC-pack <> db-copy.pck-sent.CRC-pack
      430       then do:
      431         return error substitute( "&1. Копия ГБД не корректна! Найдены отличия в пакетах новостей. Пакет &2", vss-workfile, db-copy.pck-sent.pack-num ).
      432       end.
      433     end.
      434     assign
      435       v-action = "объектов в исходной БД объектам в копии БД"
      436       v-ind    = 0
      437     .
      438     for each db-orig.db share-lock
      439     on error undo, return error
      440     :
      441       if p-db-num <> ?
      442         and db-orig.db.db-num <> p-db-num
      443       then do:
      444         next.
      445       end.
      446       for each db-orig.clients share-lock
      447         where db-orig.clients.db-num = db-orig.db.db-num
      448       on error undo, return error
      449       :
      450         assign
      451           v-ind = v-ind + 1
      452         .
      453         do with frame inf
      454         :
      455           assign
      456             v-action :screen-value   = string( v-action, v-action :format)
      457             v-ind :screen-value      = string( v-ind, v-ind :format)
      458           .
      459         end.
      460         find first db-copy.clients share-lock
      461           where db-copy.clients.obj-type = db-orig.clients.obj-type
      462             and db-copy.clients.obj-code = db-orig.clients.obj-code
      463           no-error .
      464         if not available db-copy.clients
      465           or db-orig.clients.db-num <> db-copy.clients.db-num
      466         then do:
      467           return error substitute( "&1. Копия ГБД не корректна! Клиенты привязаны к разным БД (клиент в исходной &2 &3).", vss-workfile, db-orig.clients.obj-type, db-orig.clients.obj-code ).
      468         end.
      469       end.
      470     end.
      471     assign
      472       v-action = "объектов в копии БД объектам в исходной БД"
      473       v-ind    = 0
      474     .
      475     for each db-copy.db share-lock
      476     on error undo, return error
      477     :
      478       if p-db-num <> ?
      479         and db-copy.db.db-num <> p-db-num
      480       then do:
      481         next.
      482       end.
      483       for each db-copy.clients share-lock
      484         where db-copy.clients.db-num = db-copy.db.db-num
      485       on error undo, return error
      486       :
      487         assign
      488           v-ind = v-ind + 1
      489         .
      490         do with frame inf
      491         :
      492           assign
      493             v-action :screen-value   = string( v-action, v-action :format)
      494             v-ind :screen-value      = string( v-ind, v-ind :format)
      495           .
      496         end.
      497         find first db-orig.clients share-lock
      498           where db-orig.clients.obj-type = db-copy.clients.obj-type
      499             and db-orig.clients.obj-code = db-copy.clients.obj-code
      500           no-error .
      501         if not available db-orig.clients
      502           or db-copy.clients.db-num <> db-orig.clients.db-num
      503         then do:
      504           return error substitute( "&1. Копия ГБД не корректна! Клиенты привязаны к разным БД (клиент в копии &2 &3).", vss-workfile, db-copy.clients.obj-type, db-copy.clients.obj-code ).
      505         end.
      506       end.
      507     end.
      508     assign
      509       v-action = "информации в копии о текущем состоянии БД"
      510       v-ind    = 0
      511     .
      512     for each db-copy.db-status share-lock
      513       where db-copy.db-status.db-num > 0
      514     on error undo, return error
      515     :
      516       if p-db-num <> ?
      517         and db-copy.db-status.db-num <> p-db-num
      518       then do:
      519         next.
      520       end.
      521       assign
      522         v-ind = v-ind + 1
      523       .
      524       do with frame inf
      525       :
      526         assign
      527           v-action :screen-value   = string( v-action, v-action :format)
      528           v-ind :screen-value      = string( v-ind, v-ind :format)
      529         .
      530       end.
      531       find first db-orig.db-status share-lock
      532         where db-orig.db-status.db-num = db-copy.db-status.db-num
      533         no-error .
      534       if not available db-orig.db-status then do:
      535         return error substitute( "&1. Копия ГБД не корректна! В исходной БД отсутствует в информации о текущем состоянии БД &2", vss-workfile, db-copy.db-status.db-num ).
      536       end.
      537       else do:
      538         buffer-compare db-copy.db-status to db-orig.db-status save result in v-compare no-error.
      539         if not v-compare then do:
      540           return error substitute( "&1. Копия ГБД не корректна! Найдены отличия в информации о текущем состоянии БД &2"
      541                                     ,vss-workfile
      542                                     ,db-copy.db-status.db-num
      543                                   ).
      544         end.
      545       end.
      546     end.
      547     assign
      548       v-action = "информации в исходной БД о текущем состоянии БД"
      549       v-ind    = 0
      550     .
      551     for each db-orig.db-status share-lock
      552       where db-orig.db-status.db-num > 0
      553     on error undo, return error
      554     :
      555       if p-db-num <> ?
      556         and db-orig.db-status.db-num <> p-db-num
      557       then do:
      558         next.
      559       end.
      560       assign
      561         v-ind = v-ind + 1
      562       .
      563       do with frame inf
      564       :
      565         assign
      566           v-action :screen-value   = string( v-action, v-action :format)
      567           v-ind :screen-value      = string( v-ind, v-ind :format)
      568         .
      569       end.
      570       find first db-copy.db-status share-lock
      571         where db-copy.db-status.db-num = db-orig.db-status.db-num
      572         no-error .
      573       if not available db-copy.db-status then do:
      574         return error substitute( "&1. Копия ГБД не корректна! В копии отсутствует в информации о текущем состоянии БД &2", vss-workfile, db-orig.db-status.db-num ).
      575       end.
      576       else do:
      577         buffer-compare db-orig.db-status to db-copy.db-status save result in v-compare no-error.
      578         if not v-compare then do:
      579           return error substitute( "&1. Копия ГБД не корректна! Найдены отличия в информации о текущем состоянии БД &2"
      580                                     ,vss-workfile
      581                                     ,db-orig.db-status.db-num
      582                                   ).
      583         end.
      584       end.
      585     end.
      586     assign
      587       v-action = "диапазонов кодов исходной БД диапазонам в копии БД"
      588       v-ind    = 0
      589     .
      590     for each db-orig.code-range share-lock
      591     on error undo, return error
      592     :
      593       if p-db-num <> ?
      594         and db-orig.code-range.db-num <> p-db-num
      595       then do:
      596         next.
      597       end.
      598       assign
      599         v-ind = v-ind + 1
      600       .
      601       do with frame inf
      602       :
      603         assign
      604           v-action :screen-value   = string( v-action, v-action :format)
      605           v-ind :screen-value      = string( v-ind, v-ind :format)
      606         .
      607       end.
      608       find first db-copy.code-range share-lock
      609         where db-copy.code-range.range-type = db-orig.code-range.range-type
      610           and db-copy.code-range.first-code = db-orig.code-range.first-code
      611         no-error
      612       .
      613       if not available db-copy.code-range then do:
      614         return error substitute( "&1. Копия ГБД не корректна! Найдены отличия в диапазонах кодов. Диапазон &2 &3", vss-workfile, db-orig.code-range.range-type, db-orig.code-range.first-code ).
      615       end.
      616     end.
      617     assign
      618       v-action = "диапазонов кодов копии БД диапазонам в исходной БД"
      619       v-ind    = 0
      620     .
      621     for each db-copy.code-range share-lock
      622     on error undo, return error
      623     :
      624       if p-db-num <> ?
      625         and db-copy.code-range.db-num <> p-db-num
      626       then do:
      627         next.
      628       end.
      629       assign
      630         v-ind = v-ind + 1
      631       .
      632       do with frame inf
      633       :
      634         assign
      635           v-action :screen-value   = string( v-action, v-action :format)
      636           v-ind :screen-value      = string( v-ind, v-ind :format)
      637         .
      638       end.
      639       find first db-orig.code-range share-lock
      640         where db-orig.code-range.range-type = db-copy.code-range.range-type
      641           and db-orig.code-range.first-code = db-copy.code-range.first-code
      642         no-error
      643       .
      644       if not available db-orig.code-range then do:
      645         return error substitute( "&1. Копия ГБД не корректна! Найдены отличия в диапазонах кодов. Диапазон &2 &3", vss-workfile, db-copy.code-range.range-type, db-copy.code-range.first-code ).
      646       end.
      647     end.
      648     assign
      649       v-action = "распределенных команд СПН в копии БД командам в исходной БД"
      650       v-ind    = 0
      651     .
      652     for each db-copy.db-rec-attr share-lock
      653     on error undo, return error
      654     :
      655       if p-db-num <> ?
      656         and db-copy.db-rec-attr.db-num <> p-db-num
      657       then do:
      658         next.
      659       end.
      660       assign
      661         v-ind = v-ind + 1
      662       .
      663       do with frame inf
      664       :
      665         assign
      666           v-action :screen-value   = string( v-action, v-action :format)
      667           v-ind :screen-value      = string( v-ind, v-ind :format)
      668         .
      669       end.
      670       find first db-orig.db-rec-attr share-lock
      671         where db-orig.db-rec-attr.db-num       = db-copy.db-rec-attr.db-num
      672           and db-orig.db-rec-attr.uniq-key-rec = db-copy.db-rec-attr.uniq-key-rec
      673           and db-orig.db-rec-attr.attr-code    = db-copy.db-rec-attr.attr-code
      674         no-error
      675       .
      676       if not available db-orig.db-rec-attr then do:
      677         return error substitute( "&1. Копия ГБД не корректна! В исходной БД отсутствует распределенная команда &2 над записью &3 для БД &4"
      678                                   ,vss-workfile
      679                                   ,db-copy.db-rec-attr.attr-code
      680                                   ,db-copy.db-rec-attr.uniq-key-rec
      681                                   ,p-db-num
      682                                 ).
      683       end.
      684       else do:
      685         buffer-compare db-copy.db-rec-attr
      686           except attr-value-logical attr-type
      687           to db-orig.db-rec-attr save result in v-compare no-error.
      688         if not v-compare then do:
      689           return error substitute( "&1. Копия ГБД не корректна! Найдены отличия в распределенных командах.&2Команда &3 над записью &4 для БД &5"
      690                                     ,vss-workfile
      691                                     ,chr(10)
      692                                     ,db-copy.db-rec-attr.attr-code
      693                                     ,db-copy.db-rec-attr.uniq-key-rec
      694                                     ,p-db-num
      695                                   ).
      696         end.
      697       end.
      698     end.
      699     if p-action = "prep":U then do:
      700       assign
      701         v-action = "распределенных команд СПН в исходной БД командам в копии БД"
      702         v-ind = 0
      703       .
      704       for each db-orig.db-rec-attr share-lock
      705       on error undo, return error
      706       :
      707         if p-db-num <> ?
      708           and db-orig.db-rec-attr.db-num <> p-db-num
      709         then do:
      710           next.
      711         end.
      712         assign
      713           v-ind = v-ind + 1
      714         .
      715         do with frame inf
      716         :
      717           assign
      718             v-action :screen-value   = string( v-action, v-action :format)
      719             v-ind :screen-value      = string( v-ind, v-ind :format)
      720           .
      721         end.
      722         find first db-copy.db-rec-attr share-lock
      723           where db-copy.db-rec-attr.db-num       = db-orig.db-rec-attr.db-num
      724             and db-copy.db-rec-attr.uniq-key-rec = db-orig.db-rec-attr.uniq-key-rec
      725             and db-copy.db-rec-attr.attr-code    = db-orig.db-rec-attr.attr-code
      726           no-error
      727         .
      728         if not available db-copy.db-rec-attr then do:
      729           return error substitute( "&1. Копия ГБД не корректна! В копии отсутствует распределенная команда &2 над записью &3 для БД &4"
      730                                     ,vss-workfile
      731                                     ,db-orig.db-rec-attr.attr-code
      732                                     ,db-orig.db-rec-attr.uniq-key-rec
      733                                     ,p-db-num
      734                                   ).
      735         end.
      736       end.
      737       run cur-time( output v-copy-date
      738                    ,output v-copy-time
      739                   ) no-error .
      740       if error-status :error then do:
      741         return error substitute( "&1. Ошибка при определении текущей даты", vss-workfile ).
      742       end.
      743       do transaction
      744       on error  undo, return error substitute("&1. error &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      745       on endkey undo, return error substitute("&1. endkey")
      746       on stop   undo, return error substitute("&1. stop")
      747       :
      748         find first db-orig.sys-ctrl exclusive-lock .
      749         find first db-copy.sys-ctrl exclusive-lock .
      750         assign
      751           db-orig.sys-ctrl.CopyDate    = v-copy-date
      752           db-orig.sys-ctrl.CopyTimeInt = v-copy-time
      753           db-orig.sys-ctrl.CopyTime    = string( v-copy-time, "HH:MM:SS" )
      754           db-copy.sys-ctrl.status_     = 'copy-DB':U
      755           db-copy.sys-ctrl.CopyDate    = db-orig.sys-ctrl.CopyDate
      756           db-copy.sys-ctrl.CopyTimeInt = db-orig.sys-ctrl.CopyTimeInt
      757           db-copy.sys-ctrl.CopyTime    = db-orig.sys-ctrl.CopyTime
      758         .
      759         for each db-copy.db no-lock
      760         on error undo, return error
      761         :
      762   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      763   define buffer buf2_db    for db-copy.db .
      764   define buffer buf2_route for db-copy.route .
      765   define variable v-msg#2    as character no-undo .
      766   define variable v-lock#2   as logical   no-undo .
      767   define variable v-ok#2     as logical   no-undo .
      768   find first buf2_db no-lock
      769     where buf2_db.db-num = db-copy.db.db-num
      770     no-error
      771   .
      772   if not available buf2_db then do:
      773     message
      774       vss-include-info2 skip
      775       vss-workfile vss-revision vss-description skip
      776       substitute( "Попытка создать маршрутизацию на несуществующую БД &1", db-copy.db.db-num ) skip
      777       return-value skip
      778       error-status :get-message ( error-status :num-messages )
      779       view-as alert-box error
      780     .
      781   end.
      782   if "db-copy":U <> "ub":U
      783      or ( trim( buf2_db.db-key ) <> "":U
      784           and buf2_db.db-key <> ?
      785         )
      786   then do:
      787       disable triggers for load of db-copy.route .
      788     create buf2_route .
      789     assign
      790       buf2_route.last-pack    = -1
      791       buf2_route.name-rec     = 'begins_unload_from_copy':U
      792       buf2_route.db-num       = db-copy.db.db-num
      793       buf2_route.uniq-key-rec = '':U
      794       buf2_route.num-dump     = 0
      795       buf2_route.tbl-ord      = dynamic-next-value( "s-news-ord":U, "db-copy":U )
      796       .
      797       assign
      798         buf2_route.dump-ord = dynamic-next-value( "s-news-dord":U, "db-copy":U )
      799       .
      800       assign
      801         buf2_route.CreDate      = db-copy.sys-ctrl.CopyDate
      802       .
      803       assign
      804         buf2_route.CreTimeInt   = db-copy.sys-ctrl.CopyTimeInt
      805         buf2_route.CreTime      = string(db-copy.sys-ctrl.CopyTimeInt,"HH:MM:SS":U)
      806       .
      807       assign
      808         buf2_route.CreUserName  = 'prep_copy':U
      809       .
      810   end.
      811   else do:
      812   define variable vss-include-info3 as character format "X(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
      813   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_lock-route in g#lib-nws
      814     ( input  'check'
      815     , input  db-copy.db.db-num
      816     , input  0
      817     , input  ''
      818     , output v-msg#2
      819     , output v-lock#2
      820     , output v-ok#2
      821     ) no-error .
      822     if error-status :error
      823       or v-lock#2 = true
      824       or v-ok#2   = false
      825     then do:
      826       return error substitute( "&1. Маршрутизация записи &2.&3Ключ записи: &4&3&3"
      827                                ,vss-include-info2
      828                                ,'begins_unload_from_copy':U
      829                                ,chr(10)
      830                                ,'':U
      831                              )
      832                   + substitute( "&1&2&2&3&2&2&4"
      833                                 ,v-msg#2
      834                                 ,chr(10)
      835                                 ,return-value
      836                                 ,error-status :get-message( error-status :num-messages )
      837                               ) .
      838     end.
      839   end.
      840         end.
      841       end.
      842     end.
      843     if p-db-num <> ? then do:
      844       do transaction
      845       on error  undo, return error substitute("&1. error &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      846       on endkey undo, return error substitute("&1. endkey")
      847       on stop   undo, return error substitute("&1. stop")
      848       :
      849         find first db-orig.db exclusive-lock
      850           where db-orig.db.db-num = p-db-num
      851         .
      852         find first db-copy.db exclusive-lock
      853           where db-copy.db.db-num = p-db-num
      854         .
      855         if trim( db-orig.db.db-key ) = "":U
      856           or db-orig.db.db-key = ?
      857         then do:
      858           disable triggers for load of db-orig.db .
      859           disable triggers for load of db-copy.db .
      860           assign
      861             db-orig.db.db-key = "unload-db":U
      862             db-copy.db.db-key = "unload-db":U
      863           .
      864         end.
      865       end.
      866     end.
      867     hide frame inf.
      868   end.
