      672   procedure grplib-get-full-name :
      673      define input parameter p-node-code  as integer      no-undo.
      674      define output parameter p-full-name as character    no-undo.
      675      do
      676   on error undo, return error
      677   :
      678       define variable v-upper-code    as integer           no-undo.
      679       define buffer buf_gds-grp       for ub.gds-grp.
      680       define buffer buf_upper_gds-grp for ub.gds-grp.
      681       find first buf_gds-grp no-lock
      682            where buf_gds-grp.node-code = p-node-code
      683       no-error.
      684       if not available buf_gds-grp
      685       then do:
      686           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      687       end.
      688       assign
      689           p-full-name  = ""
      690           v-upper-code = 1
      691       .
      692       do while buf_gds-grp.upper-code <> 0
      693       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      694       :
      695           assign
      696               p-full-name  = buf_gds-grp.node-name
      697                            + (if p-full-name <> "" then chr(47) else "")
      698                            + p-full-name
      699               v-upper-code = buf_gds-grp.upper-code
      700           .
      701           find first buf_gds-grp no-lock
      702                where buf_gds-grp.node-code = v-upper-code
      703           no-error.
      704           if not available buf_gds-grp
      705           then do:
      706               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      707                                   + string( v-upper-code )
      708                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      709           end.
      710       end.
      711       assign
      712       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      713       .
      714   end.
      715   end .
      716   procedure grplib-get-node-from-full-name :
      717   define input parameter p-full-name as character no-undo .
      718   define output parameter p-node-code as integer no-undo .
      719   define variable v-ii as integer no-undo .
      720   define variable v-upper-code as integer no-undo .
      721   define variable v-root-code as integer no-undo .
      722   define variable v-entry as character no-undo .
      723   define buffer buf_gds-grp       for ub.gds-grp.
      724   do
      725   on error undo, return error
      726   :
      727     find first buf_gds-grp no-lock
      728         where buf_gds-grp.upper-code = 0
      729     no-error .
      730     if not available buf_gds-grp
      731     then do:
      732         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      733     end.
      734     else do:
      735       assign
      736       v-root-code = buf_gds-grp.node-code
      737       .
      738     end.
      739     v-upper-code = v-root-code.
      740     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      741       assign
      742       v-entry = entry(v-ii, p-full-name, chr(47)).
      743       if v-entry = '' then leave.
      744       find first buf_gds-grp no-lock where
      745                 buf_gds-grp.node-name = v-entry
      746             and buf_gds-grp.upper-code = v-upper-code
      747             no-error.
      748       if not available buf_gds-grp then do:
      749         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      750       end.
      751       else do:
      752         p-node-code = buf_gds-grp.node-code.
      753         v-upper-code = buf_gds-grp.node-code.
      754       end.
      755     end.
      756   end.
      757   end .
      758   DEFINE TEMP-TABLE tt-gdsreffi NO-UNDO
      759   FIELD table-name AS CHARACTER
      760   FIELD field-name AS CHARACTER
      761   FIELD field-label AS CHARACTER
      762   FIELD field-format AS CHARACTER
      763   FIELD field-width AS DECIMAL
      764   FIELD field-is-selected AS INTEGER
      765   INDEX pi IS UNIQUE PRIMARY
      766   table-name
      767   field-name
      768   INDEX iis
      769   field-is-selected
      770   .
      771   DEFINE BUFFER sel_tt-gdsreffi FOR tt-gdsreffi.
      772   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      773   DEFINE VARIABLE v-db-num LIKE ub.db.db-num NO-UNDO.
      774   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO.
      775   DEFINE VARIABLE v-to-create AS logical NO-UNDO.
      776   DEFINE BUFFER cli-buf FOR ub.clients .
      777   define variable v-tth as handle no-undo .
      778   assign
      779   v-tth = buffer thbjattr_thbj-attr:table-handle .
      780   DEFINE BUTTON B-exit AUTO-GO
      781        LABEL "&Ввод"
      782        SIZE 10 BY 1
      783        BGCOLOR 8 .
      784   DEFINE BUTTON B-Help
      785        LABEL "Помо&щь"
      786        SIZE 3 BY 1
      787        BGCOLOR 8 .
      788   DEFINE BUTTON b-quit AUTO-END-KEY
      789        LABEL "&Отмена"
      790        SIZE 10 BY 1
      791        BGCOLOR 8 .
      792   DEFINE VARIABLE l-inn-uniq AS CHARACTER FORMAT "X(256)":U
      793         VIEW-AS TEXT
      794        SIZE 39.5 BY .67
      795        FGCOLOR 4  NO-UNDO.
      796   DEFINE VARIABLE rs-inn-uniq AS INTEGER
      797        VIEW-AS RADIO-SET VERTICAL
      798        RADIO-BUTTONS
      799             "Item 1", 1,
      800   "Item 2", 2,
      801   "Item 3", 3,
      802   "Item 4", 4
      803        SIZE 87.5 BY 4.27 NO-UNDO.
      804   DEFINE VARIABLE t-nocorinn AS LOGICAL INITIAL no
      805        LABEL "Разрешено добавление некорректного ИНН после подтверждения оператора"
      806        VIEW-AS TOGGLE-BOX
      807        SIZE 70 BY 1 NO-UNDO.
      808   DEFINE FRAME Dialog-Frame
      809        B-exit AT ROW 1 COL 1
      810        b-quit AT ROW 1 COL 11
      811        B-Help AT ROW 1 COL 95
      812        t-nocorinn AT ROW 2.1 COL 2
      813        rs-inn-uniq AT ROW 4.2 COL 2.5 NO-LABEL WIDGET-ID 118
      814        l-inn-uniq AT ROW 3.13 COL 2.5 NO-LABEL WIDGET-ID 126
      815        SPACE(57.24) SKIP(19.78)
      816       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      817            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      818            TITLE "Набор опций работы со справочником клиентов"
      819            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      820   ASSIGN
      821          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      822          FRAME Dialog-Frame:HIDDEN           = TRUE.
      823   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      824   DO:
      825     APPLY "END-ERROR":U TO SELF.
      826   END.
      827   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      828   DO:
      829     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      830     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      831   END.
      832   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      833   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      834   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      835   on help of frame Dialog-Frame
      836   do:
      837     run gbl/app_help.p
      838       (input this-procedure :file-name
      839       ,input ''
      840       ,input ?
      841       ) no-error.
      842     if error-status :error then do:
      843       message
      844         "Ошибка при вызове помощи"
      845         error-status :get-message(1)
      846         view-as alert-box .
      847     end.
      848   end.
      849   run minbtn-set in this-procedure .
      850   on choose of b-help in frame Dialog-Frame
      851   do:
      852     apply "help":u to frame Dialog-Frame .
      853   end.
      854   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      855   procedure minbtn-set :
      856       do
      857           on error undo, return error return-value
      858           :
      859           define variable ii              as integer       no-undo .
      860           define variable fh              as widget-handle no-undo .
      861           define variable hh              as widget-handle no-undo .
      862           define variable v-h             as handle        extent 4 no-undo .
      863           define variable v-name-button   as character     no-undo .
      864           define variable v-help-old-x    as decimal       no-undo .
      865           define variable v-help-old-y    as decimal       no-undo .
      866           define variable v-help-old-size as decimal       no-undo .
      867           define variable v-frame-width   as decimal       no-undo .
      868           define variable jj              as integer       no-undo .
      869           do
      870               on error undo, return error
      871               :
      872               assign
      873                   v-frame-width = frame Dialog-Frame:width - 0.3
      874                   fh            = frame Dialog-Frame:first-child
      875                   hh            = fh:first-child
      876                   ii            = 1
      877                   .
      878               do while valid-handle(hh):
      879                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      880                   do:
      881                       case lc(hh:name) :
      882                           when "b-help" then
      883                               do:
      884                                   hh:load-image-up("cmp/b-help.bmp":u) .
      885                                   hh:load-image-down("cmp/b-help.bmp":u) .
      886                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      887                                   hh:TOOLTIP = "Помощь" .
      888                                   v-help-old-x = hh:column .
      889                                   v-help-old-y = hh:row    .
      890                                   v-help-old-size = hh:width .
      891                                   hh:width-chars = 2.5 .
      892                               end.
      893                           when "b-print" then
      894                               do:
      895                                   hh:load-image("cmp/b-print.bmp":u) .
      896                                   hh:TOOLTIP = "Печать" .
      897                                   v-h[ii] = hh:handle .
      898                                   ii = ii + 1 .
      899                                   hh:width-chars = 3 .
      900                               end.
      901                           when "b-history" or
      902                           when "b-hist" then
      903                               do:
      904                                   hh:load-image("cmp/b-hist.bmp":u) .
      905                                   hh:TOOLTIP = "История" .
      906                                   v-h[ii] = hh:handle .
      907                                   ii = ii + 1 .
      908                                   hh:width-chars = 3 .
      909                               end.
      910                           when "b-sch" then
      911                               do:
      912                                   hh:load-image("cmp/b-sch.bmp":u) .
      913                                   hh:TOOLTIP = "Установка Фильтра" .
      914                                   v-h[ii] = hh:handle .
      915                                   ii = ii + 1 .
      916                                   hh:width-chars = 3 .
      917                               end.
      918                           when "b-hist-user" then
      919                               do:
      920                                   hh:load-image("cmp/b-hist.bmp":u) .
      921                                   hh:TOOLTIP = "История пользователя" .
      922                                   ii = ii + 1 .
      923                               end.
      924                       end case.
      925                   end.
      926                   hh = hh:next-sibling.
      927               end.
      928               b-help:column = v-frame-width - b-help:width-chars.
      929               jj = 0.
      930               repeat ii = 4 to 1 by -1 :
      931                   if valid-handle (v-h[ii] ) then
      932                   do:
      933                       jj  = jj + 1 .
      934                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      935                       v-h[ii]:row    = v-help-old-y .
      936                   end.
      937               end.
      938           end.
      939       end.
      940   end procedure.
      941   MAIN-BLOCK:
      942   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      943      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      944   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      945     run mainmenu_getcntxt in parparentproc
      946       (output v-cntxt-db-num
      947       ,output v-cntxt-userid
      948       ,output v-cntxt-level
      949       ,output v-cntxt-host-code-obj
      950       ,output v-cntxt-obj-type
      951       ,output v-cntxt-obj-code
      952       ,output v-cntxt-db-num-obj
      953       ,output v-cntxt-is-admin
      954       ) .
      955   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      956   ON TAB ANYWHERE
      957   DO:
      958   define variable ii as integer no-undo .
      959   define variable fh as widget-handle no-undo .
      960   define variable hh as widget-handle no-undo .
      961   define variable v-next-widget-name as character no-undo .
      962   if v-tab-order <> '' then do:
      963     if self:type = "TOGGLE-BOX" then
      964     self:BGCOLOR = ?.
      965     assign
      966     ii = lookup(self:name, v-tab-order).
      967     assign
      968     ii = ii + 1
      969     v-next-widget-name = entry(ii, v-tab-order)
      970     no-error .
      971     if error-status:error then do:
      972       assign
      973       ii = 1
      974       v-next-widget-name = entry( ii, v-tab-order)
      975       .
      976     end.
      977     assign
      978     fh = frame Dialog-Frame:first-child
      979     hh = fh:first-child
      980     .
      981     do while valid-handle(hh):
      982       if hh:name = v-next-widget-name then do:
      983         if hh:sensitive  = yes
      984         AND hh:visible = yes then do:
      985           if hh:type = "TOGGLE-BOX":U then do:
      986             assign
      987             hh:BGcolor = 1
      988             .
      989           end.
      990           APPLY "ENTRY" to hh.
      991           return no-apply.
      992         end.
      993         else do:
      994           APPLY "TAB" to hh.
      995           return no-apply.
      996         end.
      997       end.
      998       hh = hh:next-sibling.
      999     end.
     1000   end.
     1001   END.
     1002   ON BACK-TAB ANYWHERE
     1003   DO:
     1004   define variable ii as integer no-undo .
     1005   define variable fh as widget-handle no-undo .
     1006   define variable hh as widget-handle no-undo .
     1007   define variable v-next-widget-name as character no-undo .
     1008   if v-tab-order <> '' then do:
     1009     assign
     1010     ii = lookup(self:name, v-tab-order).
     1011     .
     1012     assign
     1013     ii = (if ii = 1
     1014           then  num-entries(v-tab-order)
     1015           else ii - 1
     1016           )
     1017     v-next-widget-name = entry(ii, v-tab-order)
     1018     .
     1019     assign
     1020     fh = frame Dialog-Frame:first-child
     1021     hh = fh:first-child
     1022     .
     1023     do while valid-handle(hh):
     1024       if hh:name = v-next-widget-name then do:
     1025         if hh:sensitive  = yes
     1026         AND hh:visible = yes then do:
     1027           if hh:type = "TOGGLE-BOX":U then do:
     1028             assign
     1029             hh:BGcolor = 1
     1030             .
     1031           end.
     1032           APPLY "ENTRY" to hh.
     1033           return no-apply.
     1034         end.
     1035         else do:
     1036         APPLY "BACK-TAB" to hh.
     1037         return no-apply.
     1038         end.
     1039       end.
     1040       hh = hh:next-sibling.
     1041     end.
     1042     end.
     1043   END.
     1044   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1045   ON RETURN ANYWHERE
     1046   DO:
     1047   define variable ii as integer no-undo .
     1048   define variable fh as widget-handle no-undo .
     1049   define variable hh as widget-handle no-undo .
     1050   define variable v-next-widget-name as character no-undo .
     1051     if v-tab-order <> '' then do:
     1052       assign
     1053       ii = lookup(self:name, v-tab-order).
     1054       if ii = num-entries(v-tab-order) then do:
     1055           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     1056           return no-apply.
     1057       end.
     1058       if self:type <> "BUTTON" and
     1059         self:type <> "EDITOR"  then do:
     1060         run proc-move-forward in this-procedure .
     1061         return no-apply.
     1062       end.
     1063       if self:type = "BUTTON" then do:
     1064         APPLY "CHOOSE" to self.
     1065       end.
     1066       if self:type = "TOGGLE-BOX" then
     1067       self:BGCOLOR = ?.
     1068       assign
     1069       ii = ii + 1
     1070       v-next-widget-name = entry(ii, v-tab-order)
     1071       no-error .
     1072       if error-status:error then do:
     1073         assign
     1074         ii = 1
     1075         v-next-widget-name = entry( ii, v-tab-order)
     1076         .
     1077       end.
     1078       assign
     1079       fh = frame Dialog-Frame:first-child
     1080       hh = fh:first-child
     1081       .
     1082       do while valid-handle(hh):
     1083         if hh:name = v-next-widget-name then do:
     1084           if hh:sensitive  = yes
     1085           AND hh:visible = yes then do:
     1086             if hh:type = "TOGGLE-BOX":U then do:
     1087               assign
     1088               hh:BGcolor = 1
     1089               .
     1090             end.
     1091             APPLY "ENTRY" to hh.
     1092             return no-apply.
     1093           end.
     1094           else do:
     1095             APPLY "TAB" to hh.
     1096             return no-apply.
     1097           end.
     1098         end.
     1099         hh = hh:next-sibling.
     1100       end.
     1101     end.
     1102   END.
     1103   procedure proc-move-forward :
     1104   define variable ii as integer no-undo .
     1105   define variable fh as widget-handle no-undo .
     1106   define variable hh as widget-handle no-undo .
     1107   define variable v-next-widget-name as character no-undo .
     1108   do
     1109   on error undo, return error
     1110   :
     1111     if v-tab-order <> '' then do:
     1112       if self:type = "TOGGLE-BOX" then
     1113       self:BGCOLOR = ?.
     1114       assign
     1115       ii = lookup(self:name, v-tab-order).
     1116       assign
     1117       ii = ii + 1
     1118       v-next-widget-name = entry(ii, v-tab-order)
     1119       no-error .
     1120       if error-status:error then do:
     1121         assign
     1122         ii = 1
     1123         v-next-widget-name = entry( ii, v-tab-order)
     1124         .
     1125       end.
     1126       assign
     1127       fh = frame Dialog-Frame:first-child
     1128       hh = fh:first-child
     1129       .
     1130       do while valid-handle(hh):
     1131         if hh:name = v-next-widget-name then do:
     1132           if hh:sensitive  = yes
     1133           AND hh:visible = yes then do:
     1134             if hh:type = "TOGGLE-BOX":U then do:
     1135               assign
     1136               hh:BGcolor = 1
     1137               .
     1138             end.
     1139             APPLY "ENTRY" to hh.
     1140             return.
     1141           end.
     1142           else do:
     1143             assign
     1144             ii = ii + 1
     1145             v-next-widget-name = entry(ii, v-tab-order)
     1146             no-error .
     1147             if error-status:error then do:
     1148               assign
     1149               ii = 1
     1150               v-next-widget-name = entry( ii, v-tab-order)
     1151               .
     1152             end.
     1153           end.
     1154         end.
     1155         hh = hh:next-sibling.
     1156       end.
     1157     end.
     1158   end.
     1159   end procedure.
     1160     IF p-mode <> 'ПРОСМОТР':U
     1161     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     1162         MESSAGE
     1163         vss-workfile vss-revision vss-description skip
     1164         "Неверное значение параметра p-mode" p-mode
     1165         VIEW-AS ALERT-BOX ERROR.
     1166         UNDO, RETURN ERROR.
     1167     END.
     1168     IF  p-obj-type <> '':U
     1169     THEN DO:
     1170         MESSAGE
     1171         vss-workfile vss-revision vss-description skip
     1172         "Неверное значение параметра p-obj-type" p-obj-type
     1173         VIEW-AS ALERT-BOX ERROR.
     1174         UNDO, RETURN ERROR.
     1175     END.
     1176     if p-obj-type = '':U then do:
     1177       if v-cntxt-db-num <> 0
     1178       and p-mode <> 'ПРОСМОТР':U
     1179       then do:
     1180           MESSAGE
     1181           "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" skip
     1182           VIEW-AS ALERT-BOX ERROR.
     1183           UNDO, RETURN ERROR.
     1184       end.
     1185     end.
     1186     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     1187       FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
     1188                 LOCKED_thbj-attr.obj-type = p-obj-type
     1189           AND   LOCKED_thbj-attr.obj-code = p-obj-code
     1190           AND   LOCKED_thbj-attr.upper-prop-code = 'cli-all':U
     1191           AND LOCKED_thbj-attr.prop-code = "":U
     1192           NO-WAIT NO-ERROR.
     1193        if locked locked_thbj-attr then do:
     1194           message
     1195           vss-workfile vss-revision vss-description skip
     1196            "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
     1197           view-as alert-box error .
     1198           undo, return error.
     1199         end.
     1200     END.
     1201     ELSE DO:
     1202         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
     1203             LOCKED_thbj-attr.obj-type = p-obj-type
     1204       AND   LOCKED_thbj-attr.obj-code = p-obj-code
     1205       AND   LOCKED_thbj-attr.upper-prop-code = 'cli-all':U
     1206       AND   LOCKED_thbj-attr.prop-code = '':U NO-ERROR.
     1207     END.
     1208     if not available locked_thbj-attr then do:
     1209       ASSIGN
     1210       v-to-create  = YES.
     1211       message
     1212       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     1213                   chr(10))
     1214       view-as alert-box WARNING.
     1215     end.
     1216     RUN FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     1217     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     1218     RUN Myenable in this-procedure .
     1219     WAIT-FOR GO OF FRAME Dialog-Frame.
     1220   END.
     1221   RUN disable_UI.
     1222   PROCEDURE disable_UI :
     1223     HIDE FRAME Dialog-Frame.
     1224   END PROCEDURE.
     1225   PROCEDURE enable_UI :
     1226     DISPLAY t-nocorinn rs-inn-uniq l-inn-uniq
     1227         WITH FRAME Dialog-Frame.
     1228     ENABLE B-exit b-quit B-Help t-nocorinn rs-inn-uniq l-inn-uniq
     1229         WITH FRAME Dialog-Frame.
     1230     VIEW FRAME Dialog-Frame.
     1231   END PROCEDURE.
     1232   PROCEDURE fill-widgets :
     1233   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     1234   DEFINE VARIABLE v-entry AS CHARACTER NO-UNDO.
     1235   define variable v-param-type as character no-undo .
     1236   define variable v-value-character as character no-undo .
     1237   define variable v-value-date as date no-undo .
     1238   define variable v-value-decimal as decimal no-undo .
     1239   define variable v-value-integer as INTEGER no-undo .
     1240   define variable v-value-logical AS LOGICAL no-undo .
     1241   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     1242   FOR EACH thbjattr_thbj-attr:
     1243     delete thbjattr_thbj-attr.
     1244   end.
     1245   FOR EACH temp-thbj-attr:
     1246     delete temp-thbj-attr.
     1247   end.
     1248   run adm/shattri.p (
     1249                 input "init":U
     1250               , input p-obj-type
     1251               , input p-obj-code
     1252               , input 'cli-all':U
     1253               , input "":U
     1254               , output v-value-character
     1255               , output v-value-date
     1256               , output v-value-decimal
     1257               , output v-value-integer
     1258               , output v-value-logical
     1259               , output v-param-type
     1260               , INPUT-OUTPUT table-handle v-tth
     1261               ) no-error .
     1262   if error-status:error
     1263   and not available locked_thbj-attr then do:
     1264     message
     1265     "Не удалось получить начальные значения настроек" skip
     1266     error-status:get-message(1) return-value
     1267     view-as alert-box error .
     1268     undo, return error .
     1269   end.
     1270   FOR EACH thbjattr_thbj-attr:
     1271     ASSIGN
     1272     v-entry = thbjattr_thbj-attr.prop-code.
     1273     IF v-entry = 'nocorinn':U THEN DO:
     1274       ASSIGN
     1275       t-nocorinn = thbjattr_thbj-attr.property-value-logical
     1276       t-nocorinn:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1277       .
     1278     END.
     1279     IF v-entry = 'inn-uniq':U THEN DO:
     1280       ASSIGN
     1281       rs-inn-uniq = thbjattr_thbj-attr.property-value-integer
     1282       rs-inn-uniq:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1283       .
     1284     END.
     1285     create temp-thbj-attr.
     1286     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     1287   END.
     1288   END PROCEDURE.
     1289   PROCEDURE MyEnable :
     1290   ASSIGN
     1291   l-inn-uniq = "Запрет ввода клиента с повторным ИНН"
     1292   t-nocorinn:LABEL IN FRAME Dialog-Frame = "Разрешено добавление некорректного ИНН после подтверждения оператора"
     1293   rs-inn-uniq:RADIO-BUTTONS IN FRAME Dialog-Frame =
     1294   "Проверка ввода повторного ИНН для фирмы и запрос подтверждения оператора" + chr(44) + STRING(0) + chr(44) +
     1295   "Проверка ввода повторного ИНН для фирмы и физ.лица и запрос подтверждения оператора" + chr(44) + STRING(1) + chr(44) +
     1296   "Запрет ввода повторного ИНН для фирмы и физ.лица; возникновение коллизии в СПН" + chr(44) + STRING(2) + chr(44) +
     1297   "НЕ ПРОВЕРЯТЬ ввод повторного ИНН" + chr(44) + STRING(99)
     1298   v-tab-order = "t-nocorinn,rs-inn-uniq"
     1299   .
     1300   DISPLAY
     1301   l-inn-uniq
     1302   t-nocorinn
     1303   rs-inn-uniq
     1304   WITH FRAME Dialog-Frame.
     1305   ENABLE
     1306   B-exit WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1307   b-quit
     1308   B-Help
     1309   t-nocorinn WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1310   rs-inn-uniq WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1311   WITH FRAME Dialog-Frame.
     1312   VIEW FRAME Dialog-Frame.
     1313   IF p-mode = 'ПРОСМОТР':U THEN DO:
     1314       HIDE
     1315       b-exit
     1316       IN FRAME Dialog-Frame.
     1317       ASSIGN
     1318       b-quit:LABEL = "&Выход"
     1319       b-quit:column = 1
     1320       .
     1321   END.
     1322   END PROCEDURE.
     1323   PROCEDURE proc-save :
     1324   define variable v-value-character as character no-undo .
     1325   define variable v-value-date as date no-undo .
     1326   define variable v-value-decimal as decimal no-undo .
     1327   define variable v-value-integer as INTEGER no-undo .
     1328   define variable v-value-logical AS LOGICAL no-undo .
     1329   define variable v-param-type as character no-undo .
     1330   define variable wh as widget-handle no-undo .
     1331   define variable fh as widget-handle no-undo .
     1332   define variable v-same as logical no-undo .
     1333   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     1334   ASSIGN
     1335   FRAME Dialog-Frame
     1336   t-nocorinn
     1337   rs-inn-uniq
     1338   .
     1339   assign
     1340   fh = frame Dialog-Frame:first-child
     1341   wh = fh:first-child
     1342   .
     1343   do while valid-handle(wh):
     1344     if wh:private-data begins "recid=" then do:
     1345       find first thbjattr_thbj-attr where
     1346                 recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     1347       assign
     1348       buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     1349     end.
     1350     wh = wh:next-sibling.
     1351   end.
     1352   v-same = yes.
     1353   for each thbjattr_thbj-attr,
     1354       first temp-thbj-attr where
     1355             temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     1356         and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     1357         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     1358         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code:
     1359      buffer-compare
     1360      thbjattr_thbj-attr
     1361      to temp-thbj-attr
     1362      save result in v-same.
     1363      if not v-same then leave.
     1364   end.
     1365   v-same = no.
     1366   IF v-same  and not v-to-create THEN RETURN.
     1367   run adm/shattri.p (
     1368                 input "check":U
     1369               , input p-obj-type
     1370               , input p-obj-code
     1371               , input 'cli-all':U
     1372               , INPUT '':U
     1373                , output v-value-character
     1374                , output v-value-date
     1375                , output v-value-decimal
     1376                , output v-value-integer
     1377                , output v-value-logical
     1378                , output v-param-type
     1379                , input-output table-handle v-tth
     1380                ) no-error .
     1381   if error-status:error then do:
     1382     message
     1383     "Некорректное значение ПАРАМЕТРОВ" skip
     1384     error-status:get-message(1) skip
     1385     return-value
     1386     view-as alert-box error .
     1387     undo, return error .
     1388   end.
     1389   do TRANSACTION
     1390   on error undo, return error return-value
     1391   :
     1392     RUN thbjattr_set-section IN THIS-PROCEDURE (
     1393          input p-obj-type
     1394         ,input p-obj-code
     1395         ,input 'cli-all':U
     1396         ,INPUT table thbjattr_thbj-attr
     1397     ) NO-ERROR.
     1398     IF ERROR-STATUS:error THEN do:
     1399       MESSAGE ERROR-STATUS:get-message(1)  SKIP
     1400       RETURN-VALUE
     1401       VIEW-AS ALERT-BOX.
     1402       UNDO, RETURN ERROR.
     1403     END.
     1404   end.
     1405   END PROCEDURE.
