     2080   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
     2081                                             INPUT iFlagEmpty AS INTEGER).
     2082       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
     2083       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
     2084           DO:
     2085               IF iFlagEmpty = 0                           THEN RETURN "".
     2086               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
     2087               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
     2088               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
     2089               ELSE RETURN "".
     2090           END.
     2091       ELSE DO:
     2092           run xmlchar-encode in this-procedure (
     2093                 input sToPlace
     2094               , output sToPlace
     2095           ).
     2096           ASSIGN
     2097               sToPlace = sParName + '="' + sToPlace + '"'
     2098           .
     2099           RETURN sToPlace.
     2100       END.
     2101   END FUNCTION.
     2102   function bge-xml-date returns character
     2103   ( input p-date as date )
