     1291   PROCEDURE show-counter :
     1292   do
     1293   on error undo, return error
     1294   :
     1295       assign
     1296       v-counter-visible = true
     1297       .
     1298       process events.
     1299   end.
     1300   END PROCEDURE.
     1301   PROCEDURE hide-counter :
     1302   do
     1303   on error undo, return error
     1304   :
     1305       assign
     1306       v-counter-visible = false
     1307       .
     1308       run hide-message in parparentproc .
