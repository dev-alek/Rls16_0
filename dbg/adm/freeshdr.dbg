     1349   PROCEDURE write-log :
     1350   do
     1351   on error undo, return error
     1352   :
     1353   define input parameter p-tab-position   as integer      no-undo.
     1354   define input parameter p-log-string     as character    no-undo.
     1355   run write-to-log in this-procedure( input ( fill( chr(32), 1  * p-tab-position)  +
     1356                                       (IF p-log-string = "&Line" THEN FILL("-", 80)
     1357                                       ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
     1358                                       ELSE p-log-string))).
     1359   end.
     1360   END PROCEDURE.
     1361   procedure writelog :
     1362   do
     1363   on error undo, return error
     1364   :
     1365   define input parameter p-file-name AS CHAR     NO-UNDO.
     1366   define input parameter p-log-level AS INTEGER  NO-UNDO.
     1367   define input parameter p-log-string  AS CHAR     NO-UNDO.
     1368     if p-file-name <> "" then
     1369     run  auto2dia-Writefile in this-procedure (
     1370                                       input p-file-name
     1371                                     ,input p-log-level
     1372                                     ,input p-log-string
     1373                                   ) no-error .
     1374      process events.
     1375   end.
     1376   end procedure.
     1377   PROCEDURE auto2dia-writefile:
     1378     define input parameter sFileName AS CHAR     NO-UNDO.
     1379     define input parameter iLogLevel AS INTEGER  NO-UNDO.
     1380     define input parameter sToWrite  AS CHAR     NO-UNDO.
     1381     define variable v-SlashPos  as integer no-undo .
     1382     define variable v-lDirName  as character no-undo .
     1383     define variable v-lDirName2 as character no-undo .
     1384     v-SlashPos  = maximum (  r-index(sFileName, "\"),  r-index(sFileName, "/")  ) .
     1385     v-lDirName  = if v-SlashPos > 0 then substring (sFileName, 1, v-SlashPos - 1) else "".
     1386     FILE-INFO:FILE-NAME = v-lDirName .
     1387     v-lDirName2 = FILE-INFO:FULL-PATHNAME .
     1388     if v-lDirName2 <> ? then do :
     1389   OUTPUT STREAM auto2dia TO VALUE(sFileName) APPEND.
     1390       PUT STREAM auto2dia UNFORMATTED chr(10).
     1391       PUT STREAM auto2dia UNFORMATTED (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1392                                         OR sToWrite = "&Line") THEN "" ELSE
     1393                                         cur-time-string-sec() + " ").
     1394       PUT STREAM auto2dia UNFORMATTED
     1395               (IF sToWrite = "&Line" THEN FILL("-", 80)
     1396                ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1397                ELSE sToWrite).
     1398   OUTPUT STREAM auto2dia CLOSE.
     1399     end .
     1400   END PROCEDURE.
     1401   define variable vss-include-info7 as character format "X(65)" no-undo
     1402   initial "@(#)$Workfile$ $Revision$".
     1403   DEF STREAM stmXMLOut.
     1404   DEF STREAM stmXMLLog.
     1405   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1406   define variable vss-include-info9 as character format "X(65)" no-undo
     1407   initial "@(#)$Workfile$ $Revision$".
     1408   procedure xmlchar-test :
     1409   define input parameter p-in-string          as character        no-undo.
     1410   define output parameter p-out-string-enc    as character        no-undo.
     1411   define output parameter p-out-string-dec    as character        no-undo.
     1412   do
     1413   on error undo, return error
     1414   :
     1415          run xmlchar-encode in this-procedure
     1416       (
     1417             input p-in-string
     1418           , output p-out-string-enc
     1419       ).
     1420          run xmlchar-decode in this-procedure
     1421       (
     1422             input p-out-string-enc
     1423           , output p-out-string-dec
     1424       ).
     1425   end.
     1426   end .
     1427   procedure xmlchar-encode :
     1428   define input parameter p-in-string      as character        no-undo.
     1429   define output parameter p-out-string    as character        no-undo.
     1430       define variable v-position      as integer      no-undo.
     1431       define variable v-current-char  as character    no-undo.
     1432   do
     1433   on error undo, return error
     1434   :
     1435       assign
     1436           p-out-string = "":U
     1437       .
     1438       case p-in-string
     1439       :
     1440           when ?
     1441           then do:
     1442               assign
     1443                   p-out-string = "?":U
     1444               .
     1445           end.
     1446           when "?":U
     1447           then do:
     1448               assign
     1449                   p-out-string = "&#63;":U
     1450               .
     1451           end.
     1452           otherwise do:
     1453               do v-position = 1 to length( p-in-string )
     1454               :
     1455                   assign
     1456                       v-current-char = substring( p-in-string, v-position, 1 )
     1457                   .
     1458                   case v-current-char
     1459                   :
     1460                       when "&":U
     1461                       then do:
     1462                           assign
     1463                               p-out-string = p-out-string + "&amp;":U
     1464                           .
     1465                       end.
     1466                       when ">":U
     1467                       then do:
     1468                           assign
     1469                               p-out-string = p-out-string + "&gt;":U
     1470                           .
     1471                       end.
     1472                       when "<":U
     1473                       then do:
     1474                           assign
     1475                               p-out-string = p-out-string + "&lt;":U
     1476                           .
     1477                       end.
     1478                       when "'":U
     1479                       then do:
     1480                           assign
     1481                               p-out-string = p-out-string + "&apos;":U
     1482                           .
     1483                       end.
     1484                       when '"':U
     1485                       then do:
     1486                           assign
     1487                               p-out-string = p-out-string + "&quot;":U
     1488                           .
     1489                       end.
     1490                       when chr(1)
     1491                       then do:
     1492                           assign
     1493                               p-out-string = p-out-string + "":U
     1494                           .
     1495                       end.
     1496                       when chr(2)
     1497                       then do:
     1498                           assign
     1499                               p-out-string = p-out-string + "":U
     1500                           .
     1501                       end.
     1502                       when chr(3)
     1503                       then do:
     1504                           assign
     1505                               p-out-string = p-out-string + "":U
     1506                           .
     1507                       end.
     1508                       when chr(4)
     1509                       then do:
     1510                           assign
     1511                               p-out-string = p-out-string + "":U
     1512                           .
     1513                       end.
     1514                       when chr(5)
     1515                       then do:
     1516                           assign
     1517                               p-out-string = p-out-string + "":U
     1518                           .
     1519                       end.
     1520                       when chr(6)
     1521                       then do:
     1522                           assign
     1523                               p-out-string = p-out-string + "":U
     1524                           .
     1525                       end.
     1526                       when chr(7)
     1527                       then do:
     1528                           assign
     1529                               p-out-string = p-out-string + "":U
     1530                           .
     1531                       end.
     1532                       when chr(8)
     1533                       then do:
     1534                           assign
     1535                               p-out-string = p-out-string + "":U
     1536                           .
     1537                       end.
     1538                       when chr(9)
     1539                       then do:
     1540                           assign
     1541                               p-out-string = p-out-string + "":U
     1542                           .
     1543                       end.
     1544                       when chr(29)
     1545                       then do:
     1546                           assign
     1547                               p-out-string = p-out-string + "":U
     1548                           .
     1549                       end.
     1550                       when chr(10)
     1551                       then do:
     1552                           assign
     1553                               p-out-string = p-out-string + "&#10;":U
     1554                           .
     1555                       end.
     1556                       when chr(13)
     1557                       then do:
     1558                           assign
     1559                               p-out-string = p-out-string + "&#13;":U
     1560                           .
     1561                       end.
     1562                       otherwise do:
     1563                           assign
     1564                               p-out-string = p-out-string + v-current-char
     1565                           .
     1566                       end.
     1567                   end case.
     1568               end.
     1569           end.
     1570       end case.
     1571   end.
     1572   end .
     1573   procedure xmlchar-encode-1c :
     1574   define input parameter p-in-string      as character        no-undo.
     1575   define output parameter p-out-string    as character        no-undo.
     1576       define variable v-position      as integer      no-undo.
     1577       define variable v-current-char  as character    no-undo.
     1578   do
     1579   on error undo, return error
     1580   :
     1581       assign
     1582           p-out-string = "":U
     1583       .
     1584       case p-in-string
     1585       :
     1586           when ?
     1587           then do:
     1588               assign
     1589                   p-out-string = "?":U
     1590               .
     1591           end.
     1592           otherwise do:
     1593               do v-position = 1 to length( p-in-string )
     1594               :
     1595                   assign
     1596                       v-current-char = substring( p-in-string, v-position, 1 )
     1597                   .
     1598                   case v-current-char
     1599                   :
     1600                       when chr(1)
     1601                       then do:
     1602                           assign
     1603                               p-out-string = p-out-string + " ":U
     1604                           .
     1605                       end.
     1606                       when chr(2)
     1607                       then do:
     1608                           assign
     1609                               p-out-string = p-out-string + " ":U
     1610                           .
     1611                       end.
     1612                       when chr(3)
     1613                       then do:
     1614                           assign
     1615                               p-out-string = p-out-string + " ":U
     1616                           .
     1617                       end.
     1618                       when chr(4)
     1619                       then do:
     1620                           assign
     1621                               p-out-string = p-out-string + " ":U
     1622                           .
     1623                       end.
     1624                       when chr(5)
     1625                       then do:
     1626                           assign
     1627                               p-out-string = p-out-string + " ":U
     1628                           .
     1629                       end.
     1630                       when chr(6)
     1631                       then do:
     1632                           assign
     1633                               p-out-string = p-out-string + " ":U
     1634                           .
     1635                       end.
     1636                       when chr(7)
     1637                       then do:
     1638                           assign
     1639                               p-out-string = p-out-string + " ":U
     1640                           .
     1641                       end.
     1642                       when chr(8)
     1643                       then do:
     1644                           assign
     1645                               p-out-string = p-out-string + " ":U
     1646                           .
     1647                       end.
     1648                       when chr(9)
     1649                       then do:
     1650                           assign
     1651                               p-out-string = p-out-string + " ":U
     1652                           .
     1653                       end.
     1654                       when chr(29)
     1655                       then do:
     1656                           assign
     1657                               p-out-string = p-out-string + " ":U
     1658                           .
     1659                       end.
     1660                       when chr(10)
     1661                       then do:
     1662                           assign
     1663                               p-out-string = p-out-string + " ":U
     1664                           .
     1665                       end.
     1666                       when chr(13)
     1667                       then do:
     1668                           assign
     1669                               p-out-string = p-out-string + " ":U
     1670                           .
     1671                       end.
     1672                       otherwise do:
     1673                           assign
     1674                               p-out-string = p-out-string + v-current-char
     1675                           .
     1676                       end.
     1677                   end case.
     1678               end.
     1679           end.
     1680       end case.
     1681   end.
     1682   end .
     1683   procedure xmlchar-decode :
     1684   define input parameter p-in-string      as character        no-undo.
     1685   define output parameter p-out-string    as character        no-undo.
     1686       define variable v-position      as integer      no-undo.
     1687       define variable v-last-position as integer      no-undo.
     1688       define variable v-temp-integer  as integer      no-undo.
     1689       define variable v-current-char  as character    no-undo.
     1690       define variable v-next-char     as character    no-undo.
     1691       define variable v-success       as logical      no-undo.
     1692   do
     1693   on error undo, return error
     1694   :
     1695       assign
     1696           p-out-string = "":U
     1697           v-position   = 0
     1698       .
     1699       replace-cycle:
     1700       do while yes
     1701       on error undo, return error
     1702       :
     1703           assign
     1704               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1705           .
     1706           if v-last-position <= v-position
     1707           then do:
     1708               if v-position = 0
     1709               then do:
     1710                   assign
     1711                       p-out-string = p-in-string
     1712                   .
     1713               end.
     1714               else do:
     1715                   assign
     1716                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1717                   .
     1718               end.
     1719               leave replace-cycle.
     1720           end.
     1721           else do:
     1722               assign
     1723                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1724                   v-position      = v-last-position
     1725                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1726               .
     1727               if v-current-char = "#":U
     1728               then do:
     1729                   assign
     1730                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1731                   .
     1732                   if v-last-position > 0
     1733                   then do:
     1734                       run xmlchar-read-integer in this-procedure
     1735                        (
     1736                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1737                           , output v-temp-integer
     1738                           , output v-success
     1739                       ).
     1740                       if v-success = yes
     1741                       and v-temp-integer >= 1
     1742                       and v-temp-integer <= 255
     1743                       then do:
     1744                           assign
     1745                               p-out-string = p-out-string + chr( v-temp-integer )
     1746                               v-position   = v-last-position + 1
     1747                           .
     1748                       end.
     1749                       else do:
     1750                           assign
     1751                               p-out-string = p-out-string + "&":U
     1752                               v-position   = v-position   + 1
     1753                           .
     1754                       end.
     1755                   end.
     1756                   else do:
     1757                       assign
     1758                           p-out-string = p-out-string + "&":U
     1759                           v-position   = v-position   + 1
     1760                       .
     1761                   end.
     1762               end.
     1763               else do:
     1764                   case substring( p-in-string, v-position + 1, 3 )
     1765                   :
     1766                       when "lt;":U
     1767                       then do:
     1768                           assign
     1769                               p-out-string = p-out-string + "<":U
     1770                               v-position   = v-position   + 3
     1771                           .
     1772                       end.
     1773                       when "gt;":U
     1774                       then do:
     1775                           assign
     1776                               p-out-string = p-out-string + ">":U
     1777                               v-position   = v-position   + 3
     1778                           .
     1779                       end.
     1780                       otherwise do:
     1781                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1782                           then do:
     1783                               assign
     1784                                   p-out-string = p-out-string + "&":U
     1785                                   v-position   = v-position   + 4
     1786                               .
     1787                           end.
     1788                           else do:
     1789                               case substring( p-in-string, v-position + 1, 5 )
     1790                               :
     1791                                   when "quot;":U
     1792                                   then do:
     1793                                       assign
     1794                                           p-out-string = p-out-string + '"':U
     1795                                           v-position   = v-position   + 5
     1796                                       .
     1797                                   end.
     1798                                   when "apos;":U
     1799                                   then do:
     1800                                       assign
     1801                                           p-out-string = p-out-string + "'":U
     1802                                           v-position   = v-position   + 5
     1803                                       .
     1804                                   end.
     1805                                   otherwise do:
     1806                                       assign
     1807                                           p-out-string = p-out-string + "&":U
     1808                                       .
     1809                                   end.
     1810                               end case.
     1811                           end.
     1812                       end.
     1813                   end case.
     1814               end.
     1815           end.
     1816       end.
     1817   end.
     1818   end .
     1819   procedure xmlchar-read-integer :
     1820   define input parameter p-input-string      as character        no-undo.
     1821   define output parameter p-output-integer   as integer          no-undo.
     1822   define output parameter p-success       as logical          no-undo.
     1823   do
     1824   on error undo, return error
     1825   :
     1826       assign
     1827           p-output-integer = integer( p-input-string )
     1828       no-error.
     1829       if error-status :error
     1830       then do:
     1831           assign
     1832               p-success           = no
     1833               p-output-integer    = 0
     1834           .
     1835       end.
     1836       else do:
     1837           assign
     1838               p-success           = yes
     1839           .
     1840       end.
     1841   end.
     1842   end.
     1843   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1844   procedure strtdate :
     1845     define input  parameter p-str         as character no-undo .
     1846     define output parameter p-value       as date      no-undo .
     1847     define output parameter p-data-valid  as logical   no-undo .
     1848     define output parameter p-message     as character no-undo .
     1849   do
     1850   on error undo, return error return-value
     1851   :
     1852     define variable v-value       as date      no-undo .
     1853     define variable v-i           as integer   no-undo .
     1854     define variable v-num         as integer   no-undo .
     1855     define variable v-delim       as character no-undo .
     1856     define variable v-delim-list  as character no-undo .
     1857     define variable v-day         as integer   no-undo .
     1858     define variable v-month       as integer   no-undo .
     1859     define variable v-year        as integer   no-undo .
     1860     define variable v-day-str     as character no-undo .
     1861     define variable v-month-str   as character no-undo .
     1862     define variable v-year-str    as character no-undo .
     1863     assign
     1864       p-value       = ?
     1865       p-data-valid  = false
     1866     .
     1867     if p-str = ?
     1868     then do:
     1869       assign
     1870         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
     1871       .
     1872       return .
     1873     end.
     1874     if p-str = ""
     1875     then do:
     1876       assign
     1877         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
     1878       .
     1879       return .
     1880     end.
     1881     if length(p-str)  > 10
     1882     then do:
     1883       assign
     1884         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
     1885       .
     1886       return .
     1887     end.
     1888     assign
     1889       v-delim-list = '/,-,.':U
     1890     .
     1891     _delim:
     1892     do v-i = 1 to num-entries( v-delim-list )
     1893     :
     1894       assign
     1895         v-delim = entry( v-i , v-delim-list )
     1896         v-num   = num-entries( p-str , v-delim )
     1897       .
     1898       if v-num <> 3
     1899       then do:
     1900         assign
     1901           v-delim = ''
     1902         .
     1903       end.
     1904       else do:
     1905         leave _delim.
     1906       end.
     1907     end.
     1908     if v-delim = ''
     1909     then do:
     1910       assign
     1911         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
     1912       .
     1913       return .
     1914     end.
     1915     assign
     1916       v-day-str   = entry( 1, p-str , v-delim)
     1917       v-month-str = entry( 2, p-str , v-delim)
     1918       v-year-str  = entry( 3, p-str , v-delim)
     1919     .
     1920     if  length(v-day-str) > 2   or
     1921         length(v-day-str) < 1   or
     1922         length(v-month-str) > 2 or
     1923         length(v-month-str) < 1 or
     1924         (
     1925           length(v-year-str) <> 2 and
     1926           length(v-year-str) <> 4
     1927         )
     1928     then do:
     1929       assign
     1930         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
     1931       .
     1932       return .
     1933     end.
     1934     if length( v-year-str ) = 2
     1935     then do:
     1936       assign
     1937         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
     1938       .
     1939     end.
     1940     assign
     1941       v-day   = integer( v-day-str )
     1942       v-month = integer( v-month-str)
     1943       v-year  = integer( v-year-str)
     1944     no-error .
     1945     if error-status :error
     1946     then do:
     1947       assign
     1948         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
     1949       .
     1950       return .
     1951     end.
     1952     if v-day < 1  or
     1953        v-day > 31 or
     1954        v-month < 1 or
     1955        v-month > 12 or
     1956        v-year < 0   or
     1957        v-year > 5000
     1958     then do:
     1959       assign
     1960         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
     1961       .
     1962       return .
     1963     end.
     1964     assign
     1965       v-value = date( v-month, v-day, v-year )
     1966     no-error .
     1967     if error-status :error
     1968     then do:
     1969       assign
     1970         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
     1971       .
     1972       return .
     1973     end.
     1974     assign
     1975       p-value       = v-value
     1976       p-data-valid  = true
     1977     .
     1978   end.
     1979   end procedure.
     1980   define variable v-bge-xml-bgecliiv      as logical  init no  no-undo.
