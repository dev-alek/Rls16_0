     2125   PROCEDURE wp-XMLTagOpen:
     2126   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     2127   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     2128   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     2129       define variable v-out-string    as character    no-undo.
     2130   do
     2131   on error undo, return error
     2132   :
     2133       if v-bge-xml-bgefmt = "dbf":U
     2134       then do:
     2135       end.
     2136       else do:
     2137           assign
     2138               v-out-string = substitute( "&1&2<&3&4>"
     2139                                       , chr(10)
     2140                                       , fill( " ":U, 4 * iTagLevel)
     2141                                       , sTagName
     2142                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     2143                               )
     2144           .
     2145           put stream stmXMLOut unformatted
     2146               v-out-string
     2147           .
     2148       end.
     2149   end.
     2150   END PROCEDURE.
     2151   PROCEDURE wp-XMLTagPut:
     2152     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     2153     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     2154     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     2155     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     2156       define variable v-out-string    as character    no-undo.
     2157   do
     2158   on error undo, return error
     2159   :
     2160       if v-bge-xml-bgefmt = "dbf":U
     2161       then do:
     2162           if v-bge-xml-dbf-file-name <> "":U
     2163           then do:
     2164               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     2165               export stream stmXMLOut
     2166                   sTagName
     2167                   sParValue
     2168               .
     2169               output stream stmXMLOut close.
     2170           end.
     2171       end.
     2172       else do:
     2173           IF  iFlagEmpty = 1
     2174           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     2175           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     2176           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     2177           THEN DO:
     2178               run xmlchar-encode in this-procedure (
     2179                   input sParValue
     2180                   , output sParValue
     2181               ).
     2182               assign
     2183                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     2184                                               , chr(10)
     2185                                               , FILL(" ", 4 * iTagLevel)
     2186                                               , sTagName
     2187                                               , sParValue
     2188                               )
     2189               .
     2190               PUT STREAM stmXMLOut UNFORMATTED
     2191                   v-out-string
     2192               .
     2193           END.
     2194       end.
     2195   end.
     2196   END PROCEDURE.
     2197   PROCEDURE wp-XMLTagClose:
     2198   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     2199   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     2200       define variable v-out-string    as character    no-undo.
     2201   do
     2202   on error undo, return error
     2203   :
     2204       if v-bge-xml-bgefmt = "dbf":U
     2205       then do:
     2206       end.
     2207       else do:
     2208           assign
     2209               v-out-string = substitute( "&1&2</&3>"
     2210                                   , ( if iTagLevel=0 then "":U else chr(10) )
     2211                                   , fill( " ", 4 * iTagLevel )
     2212                                   , sTagName
     2213                           )
     2214           .
     2215           PUT STREAM stmXMLOut UNFORMATTED
     2216               v-out-string
     2217           .
     2218       end.
     2219   end.
     2220   END PROCEDURE.
     2221   PROCEDURE wp-XMLWriteLog:
     2222     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     2223     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     2224     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     2225   define variable v-str              as character no-undo .
     2226   define variable v-error-append     as logical   no-undo .
     2227   define variable v-error-append-msg as character no-undo .
     2228   assign
     2229     v-str = chr(10)
     2230             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     2231             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     2232     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     2233     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     2234     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     2235   .
     2236   run bge/bge-log.p (input v-str) no-error .
     2237   if error-status:error then do:
     2238     assign
     2239       v-error-append     = yes
     2240       v-error-append-msg = return-value
     2241     .
     2242   end.
     2243   run gbl/fileapnd.p
     2244     ( input sFileName
     2245     , input v-str
     2246     , input 10
     2247     ) no-error .
     2248   if error-status:error then do:
     2249     assign
     2250       v-error-append     = yes
     2251       v-error-append-msg = substitute( "&1&2&3"
     2252                                       , v-error-append-msg
     2253                                       , chr(10)
     2254                                       , return-value
     2255                                       )
     2256     .
     2257   end.
     2258   if v-error-append
     2259   then do:
     2260     return error substitute( "&1" , v-error-append-msg ) .
     2261   end.
     2262   END PROCEDURE.
     2263   PROCEDURE wp-XMLWriteEDT:
     2264     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     2265     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     2266     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     2267       if valid-handle ( hEDT )
     2268       then do:
     2269           hEDT :move-to-eof().
     2270           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     2271                                           OR sToWrite = "&Line") THEN "" ELSE
     2272                                           cur-time-string-sec() + " ").
     2273           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     2274                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     2275                   ELSE FILL(" ", iLogLevel) + sToWrite).
     2276           hEDT :insert-string(chr(10)).
     2277       end.
     2278       process events.
     2279       output to 'bgescn.txt' append.
     2280           put unformatted
     2281               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     2282                                           OR sToWrite = "&Line") THEN "" ELSE
     2283                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     2284               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     2285                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     2286                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     2287           .
     2288       output close.
     2289   END PROCEDURE.
     2290   PROCEDURE wp-XMLShowCNT:
     2291     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     2292       if valid-handle( hCNT )
     2293       then do:
     2294           ASSIGN hCNT :VISIBLE = TRUE.
     2295       end.
     2296   END PROCEDURE.
     2297   PROCEDURE wp-XMLHideCNT:
     2298     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     2299       if valid-handle( hCNT )
     2300       then do:
     2301           ASSIGN hCNT :VISIBLE = FALSE.
     2302       end.
     2303   END PROCEDURE.
     2304   PROCEDURE wp-XMLWriteCNT:
     2305     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     2306     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     2307       if valid-handle( hCNT )
     2308       then do:
     2309           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     2310       end.
     2311   END PROCEDURE.
     2312   procedure bge-xml-write-header:
     2313   do
     2314   on error undo, return error
     2315   :
     2316   define input parameter p-xml-file-name  as character        no-undo.
     2317   define input parameter p-doc-name       as character        no-undo.
     2318   define input parameter p-version        as character        no-undo.
     2319   define input parameter p-db-num         as integer          no-undo.
     2320   define input parameter p-date-from      as date             no-undo.
     2321   define input parameter p-shift-num-from as integer          no-undo.
     2322   define input parameter p-date-to        as date             no-undo.
     2323   define input parameter p-shift-num-to   as integer          no-undo.
     2324   define input parameter p-obj-list       as character        no-undo.
     2325   define input parameter p-doc-type-list  as character        no-undo.
     2326   define input parameter p-pay-code       as logical          no-undo.
     2327   define input parameter p-cst            as logical          no-undo.
     2328   define input parameter p-parts          as logical          no-undo.
     2329   define input parameter p-chk-pay-code   as logical          no-undo.
     2330   define input parameter p-pay-desk       as logical          no-undo.
     2331   define input parameter p-pay-desk-cards as logical          no-undo.
     2332   define input parameter p-deleted        as logical          no-undo.
     2333   define input parameter p-opened-docs    as logical          no-undo.
     2334   define variable v-out-string    as character    no-undo.
     2335   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     2336   assign
     2337       v-out-string = substitute( "&1&2&3"
     2338                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     2339                           , chr(10)
     2340                           , "<IBS_Trade_House>":U )
     2341   .
     2342   put stream stmXMLOut unformatted
     2343       v-out-string
     2344   .
     2345   run wp-XMLTagOpen(1, "header","").
     2346   if v-bge-xml-bgeflold = "oracle":u
     2347   then do:
     2348     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     2349     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     2350     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     2351     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     2352     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     2353   end.
     2354   run wp-XMLTagOpen( 2, "manifest", "").
     2355   run wp-XMLTagOpen( 3, "document", "").
     2356   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     2357   run wp-XMLTagput( 4, "description", "", 0).
     2358   run wp-XMLTagput( 4, "version", p-version, 0).
     2359   run wp-XMLTagclose( 3, "document" ).
     2360   run wp-XMLTagclose( 2, "manifest" ).
     2361   run wp-XMLTagclose( 1, "header" ).
     2362   run wp-XMLTagOpen(1, "options","").
     2363   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     2364   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     2365   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     2366   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     2367   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     2368   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     2369   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     2370   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     2371   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     2372   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     2373   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     2374   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     2375   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     2376   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     2377   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     2378   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     2379   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     2380   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     2381   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     2382   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     2383   run wp-XMLTagClose(1, "options").
     2384   run wp-XMLTagOpen( 1, "body", "" ).
     2385   output stream stmXMLOut close.
     2386   end.
     2387   end procedure.
     2388   procedure xml-bge-write-footer:
     2389   do
     2390   on error undo, return error return-value
     2391   :
     2392   define input parameter p-xml-file-name as character    no-undo.
     2393   define variable v-error-num     as integer           no-undo.
     2394   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     2395   run wp-XMLTagClose( 1, "body" ).
     2396   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     2397   output stream stmXMLOut close.
     2398   if v-bge-xml-bgeflold = "oracle":u
     2399   then do:
     2400     define variable v-tmp-file-name         as character no-undo .
     2401     define variable v-zip-file-name         as character no-undo .
     2402     define variable v-exch-file-name        as character no-undo .
     2403     define variable v-heap-file-name        as character no-undo .
     2404     define variable v-i                     as integer   no-undo .
     2405     define variable v-file-name             as character no-undo .
     2406     define variable v-arc                   as character no-undo .
     2407     define variable v-str                   as character no-undo .
     2408     define variable v-exch-tmp-file-name    as character no-undo .
     2409     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     2410     define variable v-bge-xml-exch-dir      as character no-undo .
     2411     define variable v-bge-xml-heap-dir      as character no-undo .
     2412     define variable v-bge-xml-compress-heap as logical   no-undo .
     2413     define variable v-home-dir              as character no-undo .
     2414     define variable v-os-command            as character no-undo .
     2415     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2416     if v-home-dir = ?
     2417     then do:
     2418       undo, return error substitute( "&1&2&3"
     2419                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     2420                                     , chr(10)
     2421                                     , "Обратитесь к администратору.":u
     2422                                     ).
     2423     end.
     2424     assign
     2425       v-home-dir = v-home-dir
     2426     .
     2427     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2428     if error-status :error
     2429     then do:
     2430       undo, return error substitute( "&1&2&3"
     2431                                     , "Неверно задан каталог экспорта.":u
     2432                                     , chr(10)
     2433                                     , "Обратитесь к администратору.":u
     2434                                     ).
     2435     end.
     2436     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     2437     if v-bge-xml-exch-dir = ?
     2438     then do:
     2439       undo, return error substitute( "&1&2&3"
     2440                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     2441                                     , chr(10)
     2442                                     , "Обратитесь к администратору.":u
     2443                                     ).
     2444     end.
     2445     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     2446     if error-status :error
     2447     then do:
     2448       undo, return error substitute( "&1&2&3"
     2449                                     , "Неверно задан каталог экспорта (exch).":u
     2450                                     , chr(10)
     2451                                     , "Обратитесь к администратору.":u
     2452                                     ).
     2453     end.
     2454     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     2455     if v-bge-xml-heap-dir = ?
     2456     then do:
     2457       undo, return error substitute( "&1&2&3"
     2458                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     2459                                     , chr(10)
     2460                                     , "Обратитесь к администратору.":u
     2461                                     ).
     2462     end.
     2463     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     2464     if error-status :error
     2465     then do:
     2466       undo, return error substitute( "&1&2&3"
     2467                                     , "Неверно задан каталог экспорта (heap).":u
     2468                                     , chr(10)
     2469                                     , "Обратитесь к администратору.":u
     2470                                     ).
     2471     end.
     2472     get-key-value section "BGE" key "heap-compress" value v-str.
     2473     assign
     2474       v-i = int(v-str)
     2475     no-error .
     2476     if v-i = ? or v-i = 0
     2477     then do:
     2478       assign
     2479         v-bge-xml-compress-heap = no
     2480       .
     2481     end.
     2482     else do:
     2483       assign
     2484         v-bge-xml-compress-heap = yes
     2485       .
     2486     end.
     2487     assign
     2488       v-arc = search( "exe/7za.exe":u )
     2489     .
     2490     if v-arc = ? or v-arc = ""
     2491     then do:
     2492       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     2493     end.
     2494     assign
     2495       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     2496       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     2497       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     2498       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     2499       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     2500       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     2501       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     2502     .
     2503     run gbl/del-file.p (input v-tmp-file-name) .
     2504     run gbl/del-file.p (input v-zip-file-name) .
     2505     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     2506     if v-error-num > 0
     2507     then do:
     2508         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     2509                                      , p-xml-file-name + "xm1":u
     2510                                      , v-tmp-file-name
     2511                                      , v-error-num
     2512                                      ).
     2513     end.
     2514     assign
     2515       v-os-command     = substitute( "&1 a -tzip &2 &3"
     2516                                    , v-arc
     2517                                    , v-zip-file-name
     2518                                    , v-tmp-file-name
     2519                                    )
     2520     .
     2521     os-command silent value ( v-os-command ) .
     2522     run gbl/del-file.p (input v-heap-file-name) .
     2523     if v-bge-xml-compress-heap = no
     2524     then do:
     2525       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     2526       if v-error-num > 0
     2527       then do:
     2528           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     2529                                        , v-tmp-file-name
     2530                                        , v-heap-file-name
     2531                                        , v-error-num
     2532                                        ) .
     2533       end.
     2534     end.
     2535     else do:
     2536       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     2537       if v-error-num > 0
     2538       then do:
     2539           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     2540                                        , v-zip-file-name
     2541                                        , v-heap-file-name
     2542                                        , v-error-num
     2543                                        ) .
     2544       end.
     2545     end.
     2546     run gbl/del-file.p (input v-tmp-file-name) .
     2547     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     2548     if error-status :error then do:
     2549       undo, return error substitute( "&1&2&3"
     2550                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     2551                                     , chr(10)
     2552                                     , "Обратитесь к администратору."
     2553                                     ).
     2554     end.
     2555     run gbl/del-file.p (input v-exch-file-name) .
     2556     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     2557     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     2558     if v-error-num > 0
     2559     then do:
     2560       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     2561                                     , v-zip-file-name
     2562                                     , v-exch-tmp-file-name
     2563                                     , v-error-num
     2564                                     ) .
     2565     end.
     2566     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     2567     if v-error-num > 0
     2568     then do:
     2569       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     2570                                     , v-exch-tmp-file-name
     2571                                     , v-exch-file-name
     2572                                     , v-error-num
     2573                                     ) .
     2574     end.
     2575     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     2576   end.
     2577   else do:
     2578     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     2579     if v-error-num > 0
     2580     then do:
     2581       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     2582                                     , p-xml-file-name + "xm1"
     2583                                     , p-xml-file-name + "xml"
     2584                                     , v-error-num
     2585                                     ) .
     2586     end.
     2587   end.
     2588   if opsys = "unix"
     2589   then do:
     2590       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     2591   end.
     2592   end.
     2593   end procedure.
     2594   procedure xml-bge-filename0:
     2595   define input parameter p-prefix   as character no-undo .
     2596   define input parameter p-name     as character no-undo .
     2597   define input parameter p-shared-process as logical no-undo .
     2598   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     2599   define output parameter p-xml-file-name  as character no-undo .
     2600   // define output parameter p-fullfnamenoext as character no-undo .
     2601   define output parameter p-locked         as logical      no-undo.
     2602   define variable v-fullfnamenoext as character no-undo .
     2603   define variable v-fileext        as character no-undo .
     2604   define variable v-fullfname      as character no-undo .
     2605   define variable v-error-num      as integer   no-undo .
     2606   do
     2607   on error undo, return error
     2608   :
     2609     case v-bge-xml-bgeflold :
     2610       when "old" then do:
     2611         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     2612         v-fileext       = ".xml":U .
     2613         v-fullfname     = v-fullfnamenoext + v-fileext .
     2614         p-xml-file-name = v-fullfname .
     2615         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     2616         if v-error-num > 0 then do:
     2617           return error.
     2618         end.
     2619       end.
     2620       when "var" then do:
     2621         case p-prefix :
     2622           when "doc" then do:
     2623             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     2624             v-fileext       = ".xml":U .
     2625             v-fullfname     = v-fullfnamenoext + v-fileext .
     2626             p-xml-file-name = v-fullfname .
     2627           end.
     2628           when "day" then do:
     2629             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     2630             v-fileext       = ".xml":U .
     2631             v-fullfname     = v-fullfnamenoext + v-fileext .
     2632             p-xml-file-name = v-fullfname .
     2633           end.
     2634           otherwise do:
     2635             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     2636             v-fileext       = ".xml":U .
     2637             v-fullfname     = v-fullfnamenoext + v-fileext .
     2638             p-xml-file-name = v-fullfname .
     2639           end.
     2640         end case.
     2641         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     2642         if v-error-num > 0 then do:
     2643           return error.
     2644         end.
     2645       end.
     2646       when "new" then do:
     2647                   run bge/genfname.p (
     2648                       input p-home-dir
     2649                       , input p-prefix
     2650                       , input ""
     2651                       , input "xml"
     2652                       , input ""
     2653                       , output p-xml-file-name
     2654                   ).
     2655       end.
     2656       when "no-parameter" then do:
     2657         if p-shared-process then do:
     2658                       run bge/genfname.p (
     2659                           input p-home-dir
     2660                           , input "d"
     2661                           , input ""
     2662                           , input "xml"
     2663                           , input ""
     2664                           , output p-xml-file-name
     2665                       ).
     2666         end.
     2667         else do:
     2668           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     2669           v-fileext       = ".xml":U .
     2670           v-fullfname     = v-fullfnamenoext + v-fileext .
     2671           p-xml-file-name = v-fullfname .
     2672           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     2673           if v-error-num > 0 then do:
     2674             return error.
     2675           end.
     2676         end.
     2677       end.
     2678     end case.
     2679     assign
     2680       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2681       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     2682     .
     2683   end .
     2684   end procedure .
     2685   procedure xml-bge-filename :
     2686   do
     2687   on error undo, return error
     2688   :
     2689   define input parameter p-prefix             as character    no-undo.
     2690   define input parameter p-name               as character    no-undo.
     2691   define input parameter p-shared-process     as logical      no-undo.
     2692   define output parameter p-xml-file-name     as character    no-undo.
     2693   define output parameter p-log-file-name     as character    no-undo.
     2694   define output parameter p-locked            as logical      no-undo.
     2695   define variable v-home-dir          as character no-undo .
     2696   define variable v-error-num         as integer   no-undo .
     2697   define variable v-bge-xml-heap-dir  as character no-undo .
     2698       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2699       if v-home-dir = ?
     2700       then do:
     2701           message
     2702             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     2703             skip(1)
     2704             skip "Обратитесь к администратору."
     2705           view-as alert-box error.
     2706           undo, return error .
     2707       end.
     2708       if v-bge-xml-bgeflold <> "oracle"
     2709       then do:
     2710         assign
     2711             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     2712         .
     2713       end.
     2714       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2715       if error-status :error
     2716       then do:
     2717           message
     2718             skip "Неверно задан каталог экспорта."
     2719             skip(1)
     2720             skip "Обратитесь к администратору."
     2721           view-as alert-box error.
     2722           undo, return error .
     2723       end.
     2724       if v-bge-xml-bgefmt = "dbf":U
     2725       then do:
     2726           assign
     2727               p-xml-file-name = v-home-dir
     2728               p-locked        = no
     2729           .
     2730       end.
     2731       else do:
     2732           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     2733             output p-xml-file-name, output p-locked) .
     2734       end.
     2735       if v-bge-xml-bgeflold = "oracle"
     2736       then do:
     2737         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     2738         if v-bge-xml-heap-dir = ?
     2739         then do:
     2740           undo, return error substitute( "&1&2&3"
     2741                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     2742                                         , chr(10)
     2743                                         , "Обратитесь к администратору.":u
     2744                                         ).
     2745         end.
     2746         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     2747         if error-status :error
     2748         then do:
     2749           undo, return error substitute( "&1&2&3"
     2750                                         , "Неверно задан каталог экспорта (heap).":u
     2751                                         , chr(10)
     2752                                         , "Обратитесь к администратору.":u
     2753                                         ).
     2754         end.
     2755         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     2756           assign
     2757             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     2758           .
     2759         end.
     2760         else do:
     2761           assign
     2762             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     2763           .
     2764         end.
     2765       end.
     2766       else do:
     2767         assign
     2768             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     2769         .
     2770       end.
     2771       assign
     2772          v-bge-xml-static-log-file-name = p-log-file-name
     2773       .
     2774   end.
     2775   end procedure.
     2776   procedure bge-xml-read-config :
     2777   do
     2778   on error undo, return error return-value
     2779   :
     2780   define input  parameter p-last-date as date      no-undo .
     2781   define input  parameter p-db-num    as integer   no-undo .
     2782       define variable v-bgeclall      as character     no-undo.
     2783       define variable v-bgedict       as character     no-undo.
     2784       define variable v-bgeshift      as character     no-undo.
     2785       define variable v-par-type      as character     no-undo.
     2786       define variable v-bgeflnm       as character     no-undo.
     2787       define variable v-bgecliiv      as character     no-undo .
     2788       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     2789       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     2790       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     2791       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     2792       define variable v-db-num-str    as character     no-undo .
     2793       define variable v-param-type      as character  no-undo .
     2794       define variable v-value-character as character  no-undo .
     2795       define variable v-value-date      as date       no-undo .
     2796       define variable v-value-decimal   as decimal    no-undo .
     2797       define variable v-value-integer   as integer    no-undo .
     2798       define variable v-value-logical   as logical    no-undo .
     2799       define variable v-tth             as handle      no-undo .
     2800       run adm/shattri.p ( input "get":U
     2801                         , input  '':u
     2802                         , input  0
     2803                         , input  'bge-export':U
     2804                         , input  'bgeclall':U
     2805                         , output v-bgecliiv
     2806                         , output v-value-date
     2807                         , output v-value-decimal
     2808                         , output v-value-integer
     2809                         , output v-value-logical
     2810                         , output v-param-type
     2811                         , input-output table-handle v-tth
     2812                         ) no-error .
     2813       if error-status :error
     2814       then do:
     2815         assign
     2816           v-bge-xml-bgecliiv = no
     2817         .
     2818       end.
     2819       else do:
     2820         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     2821       end.
     2822       delete object v-tth.
     2823       assign
     2824           v-bge-xml-bgeclall = no
     2825           v-bge-xml-bgedict  = no
     2826       .
     2827       run adm/shattri.p ( input "get":U
     2828                         , input  '':u
     2829                         , input  0
     2830                         , input  'bge-export':U
     2831                         , input  'bgeclall':U
     2832                         , output v-value-character
     2833                         , output v-value-date
     2834                         , output v-value-decimal
     2835                         , output v-value-integer
     2836                         , output v-value-logical
     2837                         , output v-param-type
     2838                         , input-output table-handle v-tth
     2839                         ) no-error .
     2840       if error-status :error
     2841       then do:
     2842         assign
     2843           v-bge-xml-bgeclall = no
     2844         .
     2845       end.
     2846       else do:
     2847         assign
     2848           v-bge-xml-bgeclall = v-value-logical
     2849         .
     2850       end.
     2851       delete object v-tth.
     2852       run adm/shattri.p ( input "get":U
     2853                         , input  '':u
     2854                         , input  0
     2855                         , input  'bge-export':U
     2856                         , input  'bgedict':U
     2857                         , output v-value-character
     2858                         , output v-value-date
     2859                         , output v-value-decimal
     2860                         , output v-value-integer
     2861                         , output v-value-logical
     2862                         , output v-param-type
     2863                         , input-output table-handle v-tth
     2864                         ) no-error .
     2865       if error-status :error
     2866       then do:
     2867         assign
     2868           v-bge-xml-bgedict = no
     2869         .
     2870       end.
     2871       else do:
     2872         assign
     2873           v-bge-xml-bgedict = v-value-logical
     2874         .
     2875       end.
     2876       delete object v-tth.
     2877       run adm/shattri.p ( input "get":U
     2878                         , input  '':u
     2879                         , input  0
     2880                         , input  'bge-export':U
     2881                         , input  'bgefmt':U
     2882                         , output v-value-character
     2883                         , output v-value-date
     2884                         , output v-value-decimal
     2885                         , output v-value-integer
     2886                         , output v-value-logical
     2887                         , output v-param-type
     2888                         , input-output table-handle v-tth
     2889                         ) no-error .
     2890       if error-status :error
     2891       then do:
     2892         assign
     2893           v-bge-xml-bgefmt  = "xml":U
     2894         .
     2895       end.
     2896       else do:
     2897         assign
     2898           v-bge-xml-bgefmt  = v-value-character
     2899         .
     2900       end.
     2901       delete object v-tth.
     2902       run adm/shattri.p ( input "get":U
     2903                         , input  '':u
     2904                         , input  0
     2905                         , input  'bge-export':U
     2906                         , input  'bgeshift':U
     2907                         , output v-value-character
     2908                         , output v-value-date
     2909                         , output v-value-decimal
     2910                         , output v-value-integer
     2911                         , output v-value-logical
     2912                         , output v-param-type
     2913                         , input-output table-handle v-tth
     2914                         ) no-error .
     2915       if error-status :error
     2916       then do:
     2917         assign
     2918             v-bge-xml-shift-mode = no
     2919         .
     2920       end.
     2921       else do:
     2922         assign
     2923             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     2924         .
     2925       end.
     2926       delete object v-tth.
     2927       run adm/shattri.p ( input "get":U
     2928                         , input  '':u
     2929                         , input  0
     2930                         , input  'bge-export':U
     2931                         , input  'bgeflold':U
     2932                         , output v-value-character
     2933                         , output v-value-date
     2934                         , output v-value-decimal
     2935                         , output v-value-integer
     2936                         , output v-value-logical
     2937                         , output v-param-type
     2938                         , input-output table-handle v-tth
     2939                         ) no-error .
     2940       if error-status :error
     2941       then do:
     2942         assign
     2943           v-bge-xml-bgeflold = "no-parameter":U
     2944         .
     2945       end.
     2946       else do:
     2947         assign
     2948           v-bge-xml-bgeflold  = v-value-character
     2949         .
     2950       end.
     2951       delete object v-tth.
     2952       assign
     2953         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     2954         v-bge-xml-db-num-str  = v-db-num-str
     2955       .
     2956       if p-last-date <> ?
     2957       then do:
     2958           run adm/shattri.p ( input "get":U
     2959                             , input  '':u
     2960                             , input  0
     2961                             , input  'bge-export':U
     2962                             , input  'bgeflnm':U
     2963                             , output v-value-character
     2964                             , output v-value-date
     2965                             , output v-value-decimal
     2966                             , output v-value-integer
     2967                             , output v-value-logical
     2968                             , output v-param-type
     2969                             , input-output table-handle v-tth
     2970                             ) no-error .
     2971           if error-status :error
     2972           then do:
     2973             assign
     2974               v-bgeflnm = '':U
     2975             .
     2976           end.
     2977           else do:
     2978             assign
     2979               v-bgeflnm = v-value-character
     2980             .
     2981           end.
     2982           delete object v-tth.
     2983           if v-bge-xml-bgeflold = "var"
     2984           then do:
     2985               if v-bgeflnm = ?
     2986               or num-entries( v-bgeflnm ) < 2
     2987               then do:
     2988                   assign
     2989                       v-bge-xml-bgeflold = "new"
     2990                   .
     2991               end.
     2992               else do:
     2993                   assign
     2994                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     2995                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     2996                   .
     2997                   assign
     2998                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     2999                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     3000                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     3001                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     3002                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     3003                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     3004                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     3005                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     3006                   .
     3007               end.
     3008           end.
     3009       end.
     3010   end.
     3011   end procedure.
     3012   procedure bge-xml-get-ref-filename :
     3013   define input parameter p-in-file-name       as character        no-undo.
     3014   define output parameter p-home-dir          as character        no-undo.
     3015   define output parameter p-out-file-name     as character        no-undo.
     3016   define output parameter p-locked            as logical          no-undo.
     3017       define variable v-counter       as integer      no-undo.
     3018       define variable v-error-level   as integer      no-undo.
     3019   do
     3020   on error undo, return error
     3021   :
     3022       run bge/bge-ini.p (
     3023             input "bge"
     3024           , output p-home-dir
     3025       ).
     3026       if return-value <> "OK"
     3027       then do:
     3028           undo, return error.
     3029       end.
     3030       assign
     3031           p-home-dir = p-home-dir + "\dict":U
     3032       .
     3033       run bge/dir_cd.p (
     3034           input p-home-dir
     3035           , input "CA"
     3036       ).
     3037       if return-value = "ERROR"
     3038       then do:
     3039           undo, return error.
     3040       end.
     3041       assign
     3042           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     3043       .
     3044       assign
     3045           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     3046       .
     3047       wait-lock:
     3048       do v-counter = 1 TO 3
     3049       :
     3050           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     3051           if p-locked = no
     3052           then do:
     3053               leave wait-lock.
     3054           end.
     3055           else do:
     3056               readkey pause 1.
     3057           end.
     3058       END.
     3059       if p-locked = yes
     3060       then do:
     3061           undo, return error.
     3062       end.
     3063       run bge/os_copy.p (
     3064             input "D":U
     3065           , input p-out-file-name + "xml":U
     3066           , input "":U
     3067           , output v-error-level
     3068       ).
     3069       if v-error-level > 0
     3070       then do:
     3071           undo, return error.
     3072       end.
     3073   end.
     3074   end procedure.
     3075   procedure bge-xml-write-ref-header :
     3076   define input parameter p-bge-name as character        no-undo.
     3077   define input parameter p-file-name as character        no-undo.
     3078       define variable v-out-string    as character    no-undo.
     3079   do
     3080   on error undo, return error
     3081   :
     3082       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     3083       put stream stmXMLOut unformatted
     3084           "<?xml version='1.0' encoding='windows-1251'?>":U
     3085       .
     3086       assign
     3087           v-out-string = substitute( "&1&2"
     3088                               , chr(10)
     3089                               , "<IBS_Trade_House>":U )
     3090       .
     3091       put stream stmXMLOut unformatted
     3092           v-out-string
     3093       .
     3094       run wp-XMLTagOpen( 1, "header", "" ).
     3095       if v-bge-xml-bgeflold = "oracle":u
     3096       then do:
     3097         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     3098         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     3099         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     3100         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     3101         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     3102       end.
     3103       else do:
     3104         run wp-XMLTagOpen( 2, "delivery", "" ).
     3105         run wp-XMLTagOpen( 3, "to", "" ).
     3106         run wp-XMLTagClose( 3, "to" ).
     3107         run wp-XMLTagOpen( 3, "from", "" ).
     3108         run wp-XMLTagClose( 3, "from" ).
     3109         run wp-XMLTagClose( 2, "delivery" ).
     3110       end.
     3111       run wp-XMLTagOpen( 2, "manifest", "" ).
     3112       run wp-XMLTagOpen( 3, "document", "" ).
     3113       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     3114       run wp-XMLTagPut( 4, "description", "", 0 ).
     3115       run wp-XMLTagClose( 3, "document" ).
     3116       run wp-XMLTagClose( 2, "manifest" ).
     3117       run wp-XMLTagClose( 1, "header" ).
     3118       run wp-XMLTagOpen( 1, "body", "" ).
     3119   end.
     3120   end procedure.
     3121   procedure bge-xml-write-ref-footer :
     3122   define input parameter p-file-name as character        no-undo.
     3123       define variable v-error-level   as integer      no-undo.
     3124   do
     3125   on error undo, return error
     3126   :
     3127       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     3128       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     3129       output stream stmXMLOut close.
     3130       run bge/os_copy.p (
     3131             input "M":U
     3132           , input p-file-name + "xm1":U
     3133           , input p-file-name + "xml":U
     3134           , output v-error-level
     3135       ).
     3136       if v-error-level > 0
     3137       then do:
     3138           undo, return error.
     3139       end.
     3140   end.
     3141   end procedure.
     3142   procedure bge-xml-out-dir :
     3143   define output parameter p-out-dir       as character    no-undo.
     3144   define output parameter p-log-file-name as character    no-undo.
     3145   do
     3146   on error undo, return error
     3147   :
     3148       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     3149       if p-out-dir = ?
     3150       then do:
     3151           message
     3152             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     3153                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     3154             skip(1)
     3155             skip "Обратитесь к администратору."
     3156           view-as alert-box error.
     3157           undo, return error .
     3158       end.
     3159       if v-bge-xml-bgeflold <> "oracle" then assign
     3160         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     3161       .
     3162       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     3163       if error-status :error  then do:
     3164           run wp-XMLWriteLog in this-procedure (
     3165                 input p-log-file-name
     3166               , input 0
     3167               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     3168                                   , p-out-dir
     3169                                   , return-value
     3170                                   , trim( error-status :get-message( 1 ) )
     3171                                   )
     3172           ).
     3173           undo, return error.
     3174       end.
     3175       assign
     3176           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     3177           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     3178       .
     3179   end.
     3180   end procedure.
     3181   procedure bge-xml-out-dir2 :
     3182   define output parameter p-out-dir       as character    no-undo.
     3183   define output parameter p-out-dirR      as character    no-undo.
     3184   define output parameter p-log-file-name as character    no-undo.
     3185   do
     3186   on error undo, return error
     3187   :
     3188       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     3189       if p-out-dir = ?
     3190       then do:
     3191           message
     3192             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     3193                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     3194             skip(1)
     3195             skip "Обратитесь к администратору."
     3196           view-as alert-box error.
     3197           undo, return error .
     3198       end.
     3199       if v-bge-xml-bgeflold <> "oracle" then assign
     3200             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     3201             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     3202         .
     3203       else p-out-dirR = p-out-dir .
     3204       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     3205       if error-status :error  then do:
     3206           run wp-XMLWriteLog in this-procedure (
     3207                 input p-log-file-name
     3208               , input 0
     3209               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     3210                                   , p-out-dir
     3211                                   , return-value
     3212                                   , error-status :get-message( 1 )
     3213                                   )
     3214           ).
     3215           undo, return error.
     3216       end.
     3217       if p-out-dirR <> p-out-dir then do:
     3218         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     3219         if error-status :error then do:
     3220           run wp-XMLWriteLog in this-procedure (
     3221                 input p-log-file-name
     3222               , input 0
     3223               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     3224                                   , p-out-dirR
     3225                                   , return-value
     3226                                   , error-status :get-message( 1 )
     3227                                   )
     3228           ).
     3229           p-out-dirR = p-out-dir .
     3230         end.
     3231       end .
     3232       assign
     3233         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     3234         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     3235       .
     3236   end.
     3237   end procedure.
     3238   procedure bge-xml-out-file :
     3239   do
     3240   on error undo, return error
     3241   :
     3242   define input parameter p-out-dir            as character        no-undo.
     3243   define input parameter p-prefix             as character        no-undo.
     3244   define input parameter p-sheduled           as logical          no-undo.
     3245   define output parameter p-xml-file-name     as character        no-undo.
     3246   define output parameter p-locked            as logical          no-undo.
     3247   define variable v-home-dir      as character     no-undo.
     3248   define variable v-error-num     as integer       no-undo.
     3249   define variable v-today             as date         no-undo.
     3250   define variable v-time              as integer      no-undo.
     3251       if v-bge-xml-bgefmt = "dbf":U
     3252       then do:
     3253           assign
     3254               p-xml-file-name = p-out-dir
     3255               p-locked        = no
     3256           .
     3257       end.
     3258       else do:
     3259           if v-bge-xml-bgeflold = "firm":U
     3260           then do:
     3261               run bge/genfname.p (
     3262                     input p-out-dir
     3263                   , input p-prefix
     3264                   , input "":U
     3265                   , input "arj":U
     3266                   , input "":U
     3267                   , output p-xml-file-name
     3268               ).
     3269           end.
     3270           else do:
     3271               run bge/genfname.p (
     3272                     input p-out-dir
     3273                   , input p-prefix
     3274                   , input "":U
     3275                   , input "xml":U
     3276                   , input "":U
     3277                   , output p-xml-file-name
     3278               ).
     3279           end.
     3280           assign
     3281               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     3282               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     3283           .
     3284       end.
     3285   end.
     3286   end procedure.
     3287   procedure bge-xml-init-ext-doc-type :
     3288       define variable v-counter    as integer      no-undo.
     3289       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     3290   do
     3291   for buf_temp_ext-doc-type
     3292   on error undo, return error
     3293   :
     3294       empty temp-table buf_temp_ext-doc-type.
     3295       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     3296       :
     3297           create buf_temp_ext-doc-type.
     3298           assign
     3299               buf_temp_ext-doc-type.edt-key               = v-counter
     3300               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     3301               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     3302           .
     3303       end.
     3304   end.
     3305   end procedure.
     3306   procedure bge-xml-get-decimal-shift-num :
     3307   define input parameter p-shift-date     as date             no-undo.
     3308   define input parameter p-shift-num      as integer          no-undo.
     3309   define output parameter p-shift-decimal as decimal          no-undo.
     3310   do
     3311   on error undo, return error
     3312   :
     3313       assign
     3314           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     3315       .
     3316   end.
     3317   end procedure.
     3318   procedure bge-xml-ora-exp-filename :
     3319     define input  parameter p-table-name  as character no-undo .
     3320     define input  parameter p-doc-code    as character no-undo .
     3321     define input  parameter p-obj-code    as integer   no-undo .
     3322     define output parameter p-filename    as character no-undo .
     3323     define output parameter p-seq-num     as integer   no-undo .
     3324     define variable v-ora-exp-seq     as integer   no-undo .
     3325     define variable v-ora-exp-seq-str as character no-undo .
     3326     define variable v-home-dir        as character no-undo.
     3327   do
     3328   on error undo, return error return-value
     3329   :
     3330     if v-bge-xml-bgeflold = "oracle":u
     3331     then do:
     3332       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     3333       if v-home-dir = ?
     3334       then do:
     3335         undo, return error substitute( "&1&2&3":U
     3336                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     3337                                       , chr(10)
     3338                                       , "Обратитесь к администратору.":U
     3339                                       ).
     3340       end.
     3341       assign
     3342           v-home-dir = v-home-dir
     3343       .
     3344       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     3345       if error-status :error
     3346       then do:
     3347         undo, return error substitute( "&1&2&3":U
     3348                                       , "Неверно задан каталог экспорта.":U
     3349                                       , chr(10)
     3350                                       , "Обратитесь к администратору.":U
     3351                                       ).
     3352       end.
     3353       assign
     3354         v-ora-exp-seq = ?
     3355       .
     3356       if  p-table-name <> ? and
     3357           p-doc-code <> ?
     3358       then do:
     3359         run bge/get-oesq.p ( input p-table-name
     3360                            , input p-doc-code
     3361                            , output v-ora-exp-seq
     3362                            ) no-error .
     3363         if error-status :error = yes
     3364         then do:
     3365           undo, return error return-value .
     3366         end.
     3367       end.
     3368       if v-ora-exp-seq = ?
     3369       then do:
     3370         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     3371         if error-status :error
     3372         then do:
     3373           undo, return error return-value .
     3374         end.
     3375       end.
     3376       if p-table-name <> ? and
     3377          p-doc-code   <> ?
     3378       then do:
     3379         run bge/oesqdoc.p ( input p-table-name
     3380                           , input p-doc-code
     3381                           , input v-ora-exp-seq
     3382                           ) no-error .
     3383         if error-status :error = yes
     3384         then do:
     3385           undo, return error return-value .
     3386         end.
     3387       end.
     3388       assign
     3389         p-seq-num  = v-ora-exp-seq
     3390         p-filename = substitute("&1/&2-000_&3."
     3391                                , v-home-dir
     3392                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     3393                                , string(v-ora-exp-seq , "999999999")
     3394                                )
     3395       .
     3396     end.
     3397   end.
     3398   end procedure.
     3399   procedure bge-xml-date-to-str :
     3400     define input  parameter p-date  as date      no-undo .
     3401     define output parameter p-str   as character no-undo .
     3402   do
     3403   on error undo, return error return-value
     3404   :
     3405     if p-date <> ?
     3406     then do:
     3407       assign
     3408         p-str = substitute( "&1-&2-&3"
     3409                           , string( year(p-date)  , "9999")
     3410                           , string( month(p-date) , "99"  )
     3411                           , string( day(p-date)   , "99"  )
     3412                           )
     3413       .
     3414     end.
     3415     else do:
     3416       assign
     3417         p-str = ?
     3418       .
     3419     end.
     3420   end.
     3421   end procedure.
     3422   procedure bge-xml-date-str-to-str :
     3423     define input  parameter p-date-str  as character no-undo .
     3424     define output parameter p-str       as character no-undo .
     3425     define variable v-date          as date      no-undo .
     3426     define variable v-date-valid    as logical   no-undo .
     3427     define variable v-error-message as character no-undo .
     3428   do
     3429   on error undo, return error return-value
     3430   :
     3431     assign
     3432       p-str = ?
     3433     .
     3434     if p-date-str = ? or p-date-str = ""
     3435     then do:
     3436       return .
     3437     end.
     3438     run strtdate in this-procedure ( input  p-date-str
     3439                                    , output v-date
     3440                                    , output v-date-valid
     3441                                    , output v-error-message
     3442                                    ).
     3443     if v-date-valid <> true
     3444     then do:
     3445       return .
     3446     end.
     3447     assign
     3448       p-str = substitute( "&1-&2-&3"
     3449                         , string( year(v-date)  , "9999")
     3450                         , string( month(v-date) , "99"  )
     3451                         , string( day(v-date)   , "99"  )
     3452                         )
     3453     .
     3454   end.
     3455   end procedure.
     3456   procedure bge-xml-fill-tt-bgecliiv :
     3457     define input  parameter p-str as character no-undo .
     3458     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     3459     define buffer buf_clients             for ub.clients.
     3460     define variable v-i         as integer   no-undo .
     3461     define variable v-count     as integer   no-undo .
     3462     define variable v-cli-count as integer   no-undo .
     3463     define variable v-client    as character no-undo .
     3464     define variable v-obj-type  as character no-undo .
     3465     define variable v-obj-code  as integer   no-undo .
     3466   do
     3467   on error undo, return error return-value
     3468   :
     3469     empty temp-table buf_tt-bge-xml-bgecliiv.
     3470     assign
     3471       v-bge-xml-bgecliiv = no
     3472       v-cli-count        = num-entries(p-str,';')
     3473     .
     3474     if v-cli-count > 0
     3475     then do:
     3476       _cli-cycle:
     3477       do v-i = 1 to v-cli-count
     3478       :
     3479         assign
     3480           v-client = entry(v-i , p-str, ';')
     3481         .
     3482         if num-entries(v-client) <> 2
     3483         then do:
     3484           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     3485         end.
     3486         assign
     3487           v-obj-type = entry(1, v-client)
     3488         .
     3489         assign
     3490           v-obj-code = integer(entry(2, v-client))
     3491         no-error .
     3492         if error-status :error
     3493         then do:
     3494           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     3495         end.
     3496         find first buf_clients no-lock
     3497           where buf_clients.obj-type = v-obj-type
     3498             and buf_clients.obj-code = v-obj-code
     3499         no-error.
     3500         if not available buf_clients
     3501         then do:
     3502           next _cli-cycle.
     3503         end.
     3504         find first buf_tt-bge-xml-bgecliiv no-lock
     3505           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     3506             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     3507         no-error .
     3508         if available buf_tt-bge-xml-bgecliiv
     3509         then do:
     3510           next _cli-cycle.
     3511         end.
     3512         create buf_tt-bge-xml-bgecliiv.
     3513         assign
     3514           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     3515           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     3516         .
     3517       end.
     3518     end.
     3519     else do:
     3520       assign
     3521         v-bge-xml-bgecliiv = no
     3522       .
     3523       return .
     3524     end.
     3525     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     3526     if available buf_tt-bge-xml-bgecliiv
     3527     then do:
     3528       assign
     3529         v-bge-xml-bgecliiv = yes
     3530       .
     3531     end.
     3532   end.
     3533   end procedure.
     3534   procedure bge-xml-resolve-ext-doc-type :
     3535     define input  parameter p-ext-doc-type      as character no-undo .
     3536     define input  parameter p-obj-type          as character no-undo .
     3537     define input  parameter p-obj-code          as integer   no-undo .
     3538     define output parameter p-out-ext-doc-type  as character no-undo .
     3539     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     3540   do
     3541   on error undo, return error return-value
     3542   :
     3543     assign
     3544       p-out-ext-doc-type = p-ext-doc-type
     3545     .
     3546     if p-ext-doc-type <> 'ie':U
     3547     then do:
     3548       return .
     3549     end.
     3550     if v-bge-xml-bgecliiv = yes
     3551     then do:
     3552       find first buf_tt-bge-xml-bgecliiv no-lock
     3553         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     3554           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     3555       no-error .
     3556       if available buf_tt-bge-xml-bgecliiv
     3557       then do:
     3558         assign
     3559           p-out-ext-doc-type = 'iv':U
     3560         .
     3561       end.
     3562     end.
     3563   end.
     3564   end procedure.
     3565   procedure safe-wp-xmltagput :
     3566     define input  parameter pTagLevel   as integer   no-undo .
     3567     define input  parameter pTagName    as character no-undo .
     3568     define input  parameter pParValue   as character no-undo .
     3569     define input  parameter pFlagEmpty  as integer   no-undo .
     3570   do
     3571   on error undo, return error return-value
     3572   :
     3573     if v-bge-xml-bgeflold = "oracle":u
     3574     then do:
     3575       return .
     3576     end.
     3577     run wp-xmltagput in this-procedure ( input pTagLevel
     3578                                        , input pTagName
     3579                                        , input pParValue
     3580                                        , input pFlagEmpty
     3581                                        ).
     3582   end.
     3583   end procedure.
     3584   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3585     define variable v-cntxt-db-num        as integer   no-undo .
     3586     define variable v-cntxt-userid        as character no-undo .
     3587     define variable v-cntxt-level         as character no-undo .
     3588     define variable v-cntxt-host-code-obj as integer   no-undo .
     3589     define variable v-cntxt-obj-type      as character no-undo .
     3590     define variable v-cntxt-obj-code      as integer   no-undo .
     3591     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3592     define variable v-cntxt-is-admin      as logical   no-undo .
     3593   def var vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3594   procedure gen-key-rec :
     3595     define input  parameter p-tbl-name    as character no-undo.
     3596     define input  parameter p-bh_tbl-name as handle    no-undo.
     3597     define output parameter p-key-rec     as character no-undo.
     3598     do
     3599     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3600     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     3601     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     3602     :
     3603       define variable fh               as handle    no-undo .
     3604       define variable v-ok             as logical   no-undo .
     3605       define variable v-inform         as character no-undo .
     3606       define variable v-ind            as integer   no-undo .
     3607       define variable v-idx-field-qnty as integer   no-undo .
     3608       if p-tbl-name = ?
     3609         or p-tbl-name = "":U
     3610       then do:
     3611         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info12 ).
     3612       end.
     3613       if not p-bh_tbl-name:available then do:
     3614         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info12, p-tbl-name ).
     3615       end.
     3616       assign
     3617         p-key-rec = p-tbl-name
     3618         v-inform  = p-bh_tbl-name:index-information(1)
     3619         v-ind     = 2
     3620       .
     3621       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3622       on error undo, return error
     3623       :
     3624         assign
     3625           v-inform = p-bh_tbl-name:index-information( v-ind )
     3626           v-ind    = v-ind + 1
     3627         .
     3628       end.
     3629       if v-inform = ?
     3630         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3631         or entry( 3, v-inform, ",":U ) <> "1":U
     3632       then do:
     3633         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info12, p-tbl-name ).
     3634       end.
     3635       else do:
     3636         assign
     3637           v-idx-field-qnty = num-entries( v-inform ) - 4
     3638         .
     3639         if v-idx-field-qnty < 2 then do:
     3640           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info12, v-inform, p-tbl-name ).
     3641         end.
     3642         do v-ind = 1 to v-idx-field-qnty by 2
     3643         on error undo, return error
     3644         :
     3645           assign
     3646             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     3647             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     3648           .
     3649         end.
     3650       end.
     3651       if p-key-rec = ? then do:
     3652         assign
     3653           p-key-rec = "":U
     3654         .
     3655         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info12, p-tbl-name ).
     3656       end.
     3657     end.
     3658     return.
     3659   end procedure.
     3660   procedure gen-where-keyr-tab :
     3661     define input  parameter i-tableSerach as character no-undo.
     3662     define input  parameter i-tablekey   as character  no-undo.
     3663     define input  parameter p-key-rec    as character  no-undo.
     3664     define input  parameter p-key-handle as handle     no-undo .
     3665     define input  parameter p-db-name    as character  no-undo .
     3666     define input  parameter p-tt-handle  as handle     no-undo .
     3667     define output parameter o-Where      as character  no-undo.
     3668     do
     3669     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3670     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     3671     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     3672     :
     3673       define variable v-full-tbl-name  as character no-undo .
     3674       define variable bh_tbl-name      as handle    no-undo .
     3675       define variable fh_key           as handle    no-undo .
     3676       define variable fh_search        as handle    no-undo .
     3677       define variable v-field-num      as integer   no-undo .
     3678       define variable v-count-fld      as integer   no-undo .
     3679       define variable v-inform         as character no-undo .
     3680       define variable v-ind            as integer   no-undo .
     3681       define variable v-idx-field-qnty as integer   no-undo .
     3682       define variable v-field-name     as character no-undo .
     3683       define variable v-field-val      as character no-undo .
     3684       define variable v-word-link      as character no-undo .
     3685       define variable vTable           as character no-undo.
     3686       define variable bh_tbl-key       as handle    no-undo .
     3687       assign
     3688         p-key-rec = trim( p-key-rec )
     3689       .
     3690       if p-key-handle <> ? then do:
     3691         if not valid-handle(p-key-handle)
     3692            or p-key-handle:type <> "buffer"
     3693         then do:
     3694           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info12 ).
     3695         end.
     3696         if num-entries( p-key-rec, chr(3) ) > 1
     3697           or p-key-rec = ?
     3698           or p-key-rec = "":U
     3699         then do:
     3700           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info12, p-key-rec ).
     3701         end.
     3702       end.
     3703       else do:
     3704         if p-key-rec = ?
     3705           or p-key-rec = "":U
     3706         then do:
     3707           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info12 ).
     3708         end.
     3709       end.
     3710       assign
     3711         vTable = entry( 1 , p-key-rec, chr(3) )
     3712       .
     3713       if p-tt-handle <> ?
     3714         and ( not valid-handle(p-tt-handle)
     3715               or p-tt-handle:type <> "buffer"
     3716             )
     3717       then do:
     3718         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info12, vTable, chr(10) ).
     3719       end.
     3720       if p-tt-handle = ? then do:
     3721         assign
     3722           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     3723         .
     3724         create buffer bh_tbl-name for table v-full-tbl-name .
     3725       end.
     3726       else do:
     3727         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     3728       end.
     3729       assign
     3730         v-inform = bh_tbl-name:index-information(1)
     3731         v-ind    = 2
     3732       .
     3733       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3734       on error undo, return error
     3735       :
     3736         assign
     3737           v-inform = bh_tbl-name:index-information( v-ind )
     3738           v-ind    = v-ind + 1
     3739         .
     3740       end.
     3741       if v-inform = ?
     3742         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3743         or entry( 3, v-inform, ",":U ) <> "1":U
     3744       then do:
     3745         delete object bh_tbl-name no-error.
     3746         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info12, vTable ).
     3747       end.
     3748       assign
     3749         v-idx-field-qnty = num-entries( v-inform ) - 4
     3750       .
     3751       if v-idx-field-qnty < 2 then do:
     3752         delete object bh_tbl-name no-error.
     3753         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info12, v-inform, vTable ).
     3754       end.
     3755       assign
     3756         o-where     = "where":U
     3757         v-word-link = "":U
     3758         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     3759         v-count-fld = 0
     3760       .
     3761       if i-tablekey ne "" and i-tablekey ne ?
     3762       then do:
     3763         assign
     3764           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     3765         .
     3766         create buffer bh_tbl-key for table v-full-tbl-name .
     3767       end.
     3768       if i-tableSerach ne "" and i-tableSerach ne ?
     3769       then do:
     3770         delete object bh_tbl-name no-error.
     3771         assign
     3772           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     3773         .
     3774         create buffer bh_tbl-name for table v-full-tbl-name .
     3775       end.
     3776       block_where:
     3777       do v-ind = 1 to v-idx-field-qnty by 2
     3778       on error undo, return error
     3779       :
     3780         assign
     3781           v-count-fld = v-count-fld + 1
     3782         .
     3783         if p-key-handle = ?
     3784           and v-count-fld > v-field-num
     3785         then do:
     3786           leave block_where.
     3787         end.
     3788         define variable VfieldKeyTable as handle no-undo.
     3789         assign
     3790           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     3791           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     3792         .
     3793         if     bh_tbl-key ne ?
     3794         then do:
     3795            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     3796            if VfieldKeyTable eq ?
     3797            then next block_where.
     3798         end.
     3799         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     3800         then
     3801            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     3802         else
     3803            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     3804         if p-key-handle = ? then do:
     3805           assign
     3806             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     3807           .
     3808         end.
     3809         else do:
     3810           assign
     3811             fh_key = p-key-handle:buffer-field( v-field-name )
     3812           .
     3813           if fh_key = ?
     3814             or not valid-handle( fh_key )
     3815           then do:
     3816             delete object bh_tbl-name.
     3817             if     bh_tbl-key ne ?
     3818             then
     3819                delete object bh_tbl-key.
     3820             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info12, p-key-handle:name, v-field-name ).
     3821           end.
     3822           assign
     3823             v-field-val = fh_key:buffer-value
     3824           .
     3825         end.
     3826         if fh_search:data-type ="character":U then do:
     3827           assign
     3828             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     3829             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     3830             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     3831             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     3832             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     3833             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     3834             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     3835             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     3836             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     3837             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     3838             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     3839             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     3840             v-field-val = substitute( '"&1"', v-field-val )
     3841           .
     3842         end.
     3843         assign
     3844           o-where = substitute( "&1 &2", o-where, v-field-val )
     3845         .
     3846         if v-word-link = "":U then do:
     3847           assign
     3848             v-word-link = "and":U
     3849           .
     3850         end.
     3851       end.
     3852       delete object bh_tbl-name.
     3853       if     bh_tbl-key ne ?
     3854       then
     3855          delete object bh_tbl-key.
     3856       if p-key-handle = ?
     3857         and v-count-fld <> v-field-num
     3858       then do:
     3859         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info12, vTable ).
     3860       end.
     3861     end.
     3862   end procedure.
     3863   procedure gen-hn-keyr-tab :
     3864     define input  parameter i-tableSerach as character no-undo.
     3865     define input  parameter i-tablekey   as character no-undo.
     3866     define input  parameter p-key-rec    as character no-undo.
     3867     define input  parameter p-key-handle as handle    no-undo .
     3868     define input  parameter p-db-name    as character no-undo .
     3869     define input  parameter p-tt-handle  as handle    no-undo .
     3870     define input  parameter p-stts-lock  as integer   no-undo .
     3871     define output parameter o-hn         as handle    no-undo.
     3872     define variable v-full-tbl-name as character no-undo.
     3873     define variable v-where         as character no-undo.
     3874     define variable bh_tbl-name     as handle    no-undo.
     3875     define variable vTable          as character no-undo.
     3876     do
     3877     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3878     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     3879     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     3880         run gen-where-keyr-tab(i-tableSerach,
     3881                                i-tablekey,
     3882                                p-key-rec,
     3883                                p-key-handle,
     3884                                p-db-name,
     3885                                p-tt-handle,
     3886                                output v-where).
     3887         if i-tableSerach ne "" and i-tableSerach ne ?
     3888         then do:
     3889            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     3890            create buffer bh_tbl-name for table v-full-tbl-name .
     3891         end.
     3892         else do:
     3893            if p-tt-handle = ? then do:
     3894               assign
     3895                  vTable = entry( 1 , p-key-rec, chr(3) )
     3896               .
     3897               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     3898               create buffer bh_tbl-name for table v-full-tbl-name .
     3899            end.
     3900            else do:
     3901               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     3902            end.
     3903         end.
     3904         if p-tt-handle = ? then do:
     3905            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     3906         end.
     3907         else do:
     3908            bh_tbl-name:find-first( v-where ) no-error .
     3909         end.
     3910         o-hn = bh_tbl-name.
     3911      end.
     3912   end procedure.
     3913   procedure gen-hn-keyr :
     3914     define input  parameter p-key-rec    as character no-undo.
     3915     define input  parameter p-key-handle as handle    no-undo .
     3916     define input  parameter p-db-name    as character no-undo .
     3917     define input  parameter p-tt-handle  as handle    no-undo .
     3918     define input  parameter p-stts-lock  as integer   no-undo .
     3919     define output parameter o-hn         as handle    no-undo.
     3920     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     3921   end.
     3922   procedure gen-row-keyr :
     3923     define input  parameter p-key-rec    as character no-undo.
     3924     define input  parameter p-key-handle as handle    no-undo .
     3925     define input  parameter p-db-name    as character no-undo .
     3926     define input  parameter p-tt-handle  as handle    no-undo .
     3927     define input  parameter p-stts-lock  as integer   no-undo .
     3928     define output parameter p-tbl-row    as rowid     no-undo.
     3929     define output parameter p-tbl-name   as character no-undo.
     3930     define variable vHn as handle no-undo.
     3931       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     3932       p-tbl-row = if vHn:available then vHn:rowid else ?.
     3933       p-tbl-name =  vHn:table.
     3934       delete object vHn no-error.
     3935     if p-tbl-row = ? then do:
     3936       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info12, p-tbl-name, p-key-rec ).
     3937     end.
     3938     else do:
     3939       return.
     3940     end.
     3941   end procedure.
     3942   procedure gen-key-fv :
     3943     define input  parameter p-key-rec    as character no-undo .
     3944     define output parameter p-field-list as character no-undo .
     3945     define output parameter p-value-list as character no-undo.
     3946     do
     3947     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3948     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     3949     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     3950     :
     3951       define variable v-full-tbl-name  as character no-undo .
     3952       define variable bh_tbl-name      as handle    no-undo .
     3953       define variable v-tbl-name       as character no-undo .
     3954       define variable v-field-num      as integer   no-undo .
     3955       define variable v-count-fld      as integer   no-undo .
     3956       define variable v-inform         as character no-undo .
     3957       define variable v-ind            as integer   no-undo .
     3958       define variable v-idx-field-qnty as integer   no-undo .
     3959       define variable v-delim-key      as character no-undo .
     3960       if p-key-rec = ?
     3961         or p-key-rec = "":U
     3962       then do:
     3963         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info12 ).
     3964       end.
     3965       assign
     3966         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     3967         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     3968       .
     3969       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     3970       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info12 ).
     3971       assign
     3972         v-inform = bh_tbl-name:index-information(1)
     3973         v-ind    = 2
     3974       .
     3975       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3976       on error undo, return error
     3977       :
     3978         assign
     3979           v-inform = bh_tbl-name:index-information( v-ind )
     3980           v-ind    = v-ind + 1
     3981         .
     3982       end.
     3983       if v-inform = ?
     3984         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3985         or entry( 3, v-inform, ",":U ) <> "1":U
     3986       then do:
     3987         delete object bh_tbl-name no-error.
     3988         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info12, v-tbl-name ).
     3989       end.
     3990       assign
     3991         v-idx-field-qnty = num-entries( v-inform ) - 4
     3992       .
     3993       if v-idx-field-qnty < 2 then do:
     3994         delete object bh_tbl-name no-error.
     3995         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info12, v-inform, v-tbl-name ).
     3996       end.
     3997       assign
     3998         p-field-list = "":U
     3999         p-value-list = "":U
     4000         v-delim-key  = "":U
     4001         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     4002         v-count-fld  = 0
     4003       .
     4004       block_where:
     4005       do v-ind = 1 to v-idx-field-qnty by 2
     4006       on error undo, return error
     4007       :
     4008         assign
     4009           v-count-fld = v-count-fld + 1
     4010         .
     4011         if v-count-fld > v-field-num then do:
     4012           leave block_where.
     4013         end.
     4014         assign
     4015           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     4016           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     4017         .
     4018         if v-ind = 1 then do:
     4019           assign
     4020             v-delim-key = chr(3)
     4021           .
     4022         end.
     4023       end.
     4024       delete object bh_tbl-name.
     4025       if v-count-fld <> v-field-num then do:
     4026         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info12, v-tbl-name ).
     4027       end.
     4028     end.
     4029   end procedure.
     4030   procedure gen-key-field :
     4031     define input  parameter p-table      as character no-undo .
     4032     define output parameter p-field-list as character no-undo .
     4033     do
     4034     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4035     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     4036     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     4037     :
     4038       define variable v-full-tbl-name  as character no-undo .
     4039       define variable bh_tbl-name      as handle    no-undo .
     4040       define variable v-tbl-name       as character no-undo .
     4041       define variable v-field-num      as integer   no-undo .
     4042       define variable v-count-fld      as integer   no-undo .
     4043       define variable v-inform         as character no-undo .
     4044       define variable v-ind            as integer   no-undo .
     4045       define variable v-idx-field-qnty as integer   no-undo .
     4046       define variable v-delim-key      as character no-undo .
     4047       if p-table = ?
     4048         or p-table = "":U
     4049       then do:
     4050         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info12 ).
     4051       end.
     4052       assign
     4053         v-tbl-name      = p-table
     4054         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     4055       .
     4056       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     4057       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info12 ).
     4058       assign
     4059         v-inform = bh_tbl-name:index-information(1)
     4060         v-ind    = 2
     4061       .
     4062       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     4063       on error undo, return error
     4064       :
     4065         assign
     4066           v-inform = bh_tbl-name:index-information( v-ind )
     4067           v-ind    = v-ind + 1
     4068         .
     4069       end.
     4070       if v-inform = ?
     4071         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     4072         or entry( 3, v-inform, ",":U ) <> "1":U
     4073       then do:
     4074         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info12, v-tbl-name ).
     4075       end.
     4076       assign
     4077         v-idx-field-qnty = num-entries( v-inform ) - 4
     4078       .
     4079       if v-idx-field-qnty < 2 then do:
     4080         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info12, v-inform, v-tbl-name ).
     4081       end.
     4082       assign
     4083         p-field-list = "":U
     4084         v-delim-key  = "":U
     4085         v-count-fld  = 0
     4086       .
     4087       block_where:
     4088       do v-ind = 1 to v-idx-field-qnty by 2
     4089       on error undo, return error
     4090       :
     4091         assign
     4092           v-count-fld = v-count-fld + 1
     4093         .
     4094         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     4095         if v-ind = 1 then do:
     4096           assign
     4097             v-delim-key = chr(3)
     4098           .
     4099         end.
     4100       end.
     4101       delete object bh_tbl-name.
     4102     end.
     4103   end procedure.
     4104   define variable v-value as character no-undo .
     4105   define variable v-type as character no-undo .
     4106   define variable v-free-id as character no-undo .
     4107   define variable v-free-task-name as character no-undo .
     4108   define variable v-run-prog-name as character no-undo .
     4109   define variable v-enable-concurrent-0 as logical no-undo .
     4110   define variable v-enable-concurrent-db as logical no-undo .
     4111   define variable v-is-rum as logical no-undo .
     4112   define variable v-conf-par as character no-undo .
     4113   define variable v-par-val as character no-undo .
     4114   define variable v-par-type as character no-undo .
     4115   define variable v-mes as character no-undo .
     4116   define variable v-uniq-key-rec as character no-undo .
     4117   define buffer buf_schedule-attr for ub.schedule-attr.
     4118   define buffer buf_schedule for ub.schedule.
     4119   define buffer lock-batchprocess for ub.batchprocess.
     4120   do
     4121   on error undo, return error substitute("&1 &2 &3&4&5&4"
     4122                                         ,vss-workfile
     4123                                         ,vss-revision
     4124                                         ,vss-description
     4125                                         ,chr(10)
     4126                                         ,error-status:get-message(1) )
     4127   :
     4128     run gbl/set-gbl.p
     4129       (input  true
     4130       ,input  g#auto-user-id
     4131       ,input  g#auto-user-password
     4132       ) no-error .
     4133     if error-status :error
     4134     then do:
     4135       run write-to-log in this-procedure
     4136         ( vss-workfile + chr(32)
     4137         + "Ошибка при инициализации переменных g#..." + chr(10)
     4138         + error-status :get-message(error-status :num-messages) + chr(10)
     4139         + return-value
     4140         ) .
     4141       return error return-value .
     4142     end.
     4143     define buffer lck_schedule-attr for ub.schedule-attr.
     4144     run schedule-attr-get-free-id  in this-procedure (
     4145                                                         input p-cre-db-num
     4146                                                       ,input p-task-type
     4147                                                       ,input p-task-num
     4148                                                       ,output v-free-id) no-error .
     4149     if error-status:error then do:
     4150       assign
     4151       v-mes = substitute("&1 &2 &3&4Невозможно получить название  произвольного задания по строке расписания&4" +
     4152                                     "Неверный атрибут расписания <Идентификатор произвольной задачи>&4" +
     4153                                     "№ расписания &5"
     4154                                     , vss-workfile
     4155                                     , vss-revision
     4156                                     , vss-description
     4157                                     , chr(10)
     4158                                     , p-task-num
     4159                                     ).
     4160       run write-to-log in this-procedure ( v-mes ).
     4161       undo, return error.
     4162     end.
     4163     run schedule-attr-get-free-props  in this-procedure (input v-free-id, output v-value).
     4164     assign
     4165     v-free-task-name = entry(buffer temp-schedule-free:buffer-field("free-task-name"):POSITION - 2, v-value, chr(4) )
     4166     v-run-prog-name = entry(buffer temp-schedule-free:buffer-field("proc-run-name"):POSITION - 2, v-value, chr(4) )
     4167     v-conf-par = entry(buffer temp-schedule-free:buffer-field("conf-param"):POSITION - 2, v-value, chr(4) )
     4168     v-enable-concurrent-0 = (entry(buffer temp-schedule-free:buffer-field("enable-concurrent-0"):POSITION - 2, v-value, chr(4) ) = "yes")
     4169     v-enable-concurrent-db = (entry(buffer temp-schedule-free:buffer-field("enable-concurrent-db"):POSITION - 2, v-value, chr(4) ) = "yes")
     4170     no-error .
     4171     if error-status:error then do:
     4172       v-mes = substitute("&1 &2 &3&4Невозможно получить название  произвольного задания по строке расписания&4" +
     4173                                     "Неверно заданы параметры  задания в файле shd-free.d&4&6&4" +
     4174                                     "№ расписания &5"
     4175                                     , vss-workfile
     4176                                     , vss-revision
     4177                                     , vss-description
     4178                                     , chr(10)
     4179                                     , p-task-num
     4180                                     , error-status:get-message(1)
     4181                                     ).
     4182       run write-to-log in this-procedure ( v-mes ).
     4183       undo, return error.
     4184     end.
     4185     run schedule-attr-is-rum-free-id in this-procedure ( input v-free-id
     4186                                                         ,output v-is-rum) no-error.
     4187     if v-conf-par <> '':U then do:
     4188   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     4189     (input  v-conf-par
     4190     ,input  ''
     4191     ,input  ''
     4192     ,input  0
     4193     ,input  ''
     4194     ,input  ''
     4195     ,input  ''
     4196     ,input  yes
     4197     ,output v-par-val
     4198     ,output v-par-type
     4199     ) no-error .
     4200       if error-status:error
     4201       or v-par-type <> "L":U
     4202       then do:
     4203         v-mes = substitute("Невозможно запустить произвольное задания по строке расписания&1" +
     4204                                       "Требуемый конфигурационный параметр &2 не включен&1" +
     4205                                       "№ расписания &3"
     4206                                       , chr(10)
     4207                                       , v-conf-par
     4208                                       , p-task-num
     4209                                       ).
     4210         run write-to-log in this-procedure ( v-mes ).
     4211         undo, return error.
     4212       end.
     4213     end.
     4214     if not v-enable-concurrent-0 then do:
     4215       run gbl/lock-prc.p
     4216           (input 'schd':U
     4217           ,input 0
     4218           ,input 0
     4219           ,input 0
     4220           ,input v-free-id
     4221           ,input ""
     4222           ,input ""
     4223           ,input (
     4224                   v-free-task-name
     4225                 )
     4226           ,input no
     4227           ,buffer lock-batchprocess
     4228           ) no-error .
     4229       if error-status:error then do:
     4230         ASSIGN
     4231         V-MES = return-value .
     4232         run write-to-log in this-procedure ( v-mes ).
     4233         undo, return error.
     4234       end.
     4235     end.
     4236     if not v-enable-concurrent-db then do:
     4237       run gbl/lock-prc.p
     4238           (input 'schd':U
     4239           ,input 0
     4240           ,input 0
     4241           ,input 0
     4242           ,input v-free-id
     4243           ,input string(p-db-num)
     4244           ,input ""
     4245           ,input (
     4246                   v-free-task-name + chr(32) + string(p-db-num)
     4247                 )
     4248           ,input no
     4249           ,buffer lock-batchprocess
     4250           ) no-error .
     4251       if error-status:error then do:
     4252         ASSIGN
     4253         V-MES = return-value .
     4254         run write-to-log in this-procedure ( v-mes ).
     4255         undo, return error.
     4256       end.
     4257     end.
     4258     if v-is-rum then do:
     4259       find first buf_schedule no-lock where
     4260                 buf_schedule.cre-db-num = p-cre-db-num
     4261             and buf_schedule.task-type = p-task-type
     4262             and buf_schedule.task-num = p-task-num no-error.
     4263       run gen-key-rec in this-procedure (
     4264                                         input  'schedule':U
     4265                                       ,input (buffer buf_schedule:handle)
     4266                                       ,output v-uniq-key-rec).
     4267       run get-db-num in parparentproc ( output v-cntxt-db-num).
     4268       case entry(1, v-free-id, "_"):
     4269         when 'ord':U then do:
     4270       run str/ordrum.p
     4271         (
     4272           input parparentproc
     4273         ,input this-procedure
     4274         ,input this-procedure
     4275         ,input 'batchwork':U
     4276         ,input 0
     4277         ,input 23
     4278         ,input 1
     4279         ,input 0
     4280         ,input v-cntxt-db-num
     4281         ,input v-uniq-key-rec
     4282         ,input  ( string(dynamic-next-value( "next-rep-num":U, "ubflt":U ), "9999999999") + chr(4) +
     4283                   string(p-task-num) )
     4284         ,input yes
     4285         ) no-error .
     4286         end.
     4287         when 'goods':U then do:
     4288           run str/goodsrum.p
     4289             (
     4290               input parparentproc
     4291             ,input this-procedure
     4292             ,input this-procedure
     4293             ,input 'goods-batchwork':U
     4294             ,input 0
     4295             ,input 11
     4296             ,input 10
     4297             ,input v-cntxt-db-num
     4298             ,input v-uniq-key-rec
     4299             ,input  ( string(dynamic-next-value( "next-rep-num":U, "ubflt":U ), "9999999999") + chr(4) +
     4300                       string(p-task-num) )
     4301             ,input yes
     4302             ) no-error .
     4303         end.
     4304       end case.
     4305     end.
     4306     else do:
     4307     run value(v-run-prog-name)(
     4308                                 input parparentproc
     4309                               , input this-procedure:handle
     4310                               , input this-procedure:handle
     4311                               , input p-cre-db-num
     4312                               , input p-task-type
     4313                               , input p-task-num
     4314                               , input p-db-num         ) no-error .
     4315     end.
     4316     if error-status :error then do:
     4317       ASSIGN
     4318       V-MES = substitute("!!!Ошибка при выполнении задания:&1&2&1&3&1&6&1№ расписания &4, для БД &5"
     4319                         ,chr(10)
     4320                         , error-status:get-message(1)
     4321                         , return-value
     4322                         , p-task-num
     4323                         , string(p-db-num)
     4324                         , v-free-task-name ).
     4325       run write-to-log in this-procedure ( v-mes ).
     4326       undo, return error.
     4327     end.
     4328     if return-value <> '':U then do:
     4329       run write-to-log in this-procedure ( return-value ).
     4330     end.
     4331   end.
