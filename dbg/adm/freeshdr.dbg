     1312   PROCEDURE write-counter :
     1313   do
     1314   on error undo, return error
     1315   :
     1316   define input parameter p-counter-string     as character    no-undo.
     1317   if v-counter-visible then
     1318   run write-message in parparentproc ( input p-counter-string) .
     1319   process events.
     1320   end.
     1321   END PROCEDURE.
     1322   PROCEDURE get-stop-state :
