     1327   end.
     1328   END PROCEDURE.
     1329   PROCEDURE set-view-log :
     1330   do
     1331   on error undo, return error
     1332   :
     1333   define input parameter p-view-log     as logical    no-undo.
     1334       assign
     1335       v-view-log = p-view-log
     1336       .
     1337   end.
     1338   END PROCEDURE.
     1339   PROCEDURE get-view-log :
     1340   do
     1341   on error undo, return error
     1342   :
     1343   define output parameter p-view-log     as logical    no-undo.
     1344       assign
     1345       p-view-log = v-view-log
