        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-cre-db-num  as integer   no-undo .
        4   define input parameter p-task-type   as character no-undo .
        5   define input parameter p-task-num    as integer   no-undo .
        6   define input parameter p-db-num      as integer      no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: freeshdr.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: adm/freeshdr.p $":U .
       12   define variable vss-description as character no-undo init "Процедура вызова произвольной задачи выполняющейся по расписанию".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   define variable v-waitfram-action01         as character   no-undo .
       69   define variable v-waitfram-action02         as character   no-undo .
       70   define variable v-waitfram-action03         as character   no-undo .
       71   define variable mWaitFramTextBeg            as character   no-undo.
       72   define variable mWaitFramTextEnd            as character   no-undo.
       73   define variable mWaitFramView               as logical     no-undo.
       74   define variable mWaitProcEvent              as logical     no-undo init yes.
       75   define variable mWaitFramInterval           as integer     no-undo init 1 .
       76   define variable mWaitFramStop               as logical     no-undo.
       77   define variable mWaitFramStopUser           as logical     no-undo.
       78   define variable mWaitFramStopTimeOut        as logical     no-undo.
       79   define variable mWaitFramStartProc          as datetime-tz no-undo.
       80   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       81   define button B-WaitFramStop auto-end-key
       82        label "Стоп"
       83        size 10 by 1 tooltip "Остоновить процесс".
       84   define button B-viewProcInfo
       85        label "Информация"
       86        size 15 by 1 tooltip "Информация о процесс".
       87   define frame waitfram
       88     v-waitfram-action01 format "x(72)" no-label skip
       89     v-waitfram-action02 format "x(72)" no-label skip
       90     v-waitfram-action03 format "x(72)" no-label skip
       91     B-viewProcInfo
       92     B-WaitFramStop at row 4 col 30
       93     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       94     .
       95   define new global shared variable mBatchMode as logical no-undo init ?.
       96   define variable mFramBachModHandle as handle no-undo.
       97   mFramBachModHandle = frame waitfram:handle.
       98   define variable mFameOldVis as logical no-undo.
       99   define variable mVisCUrentVin as logical no-undo.
      100   if session:batch-mode
      101   then
      102      mBatchMode = yes.
      103   if mBatchMode = ? then do:
      104     mVisCUrentVin = current-window:visible.
      105     mFameOldVis = mFramBachModHandle:visible.
      106     mFramBachModHandle:visible  = yes.
      107     mBatchMode = mFramBachModHandle:visible ne yes.
      108     mFramBachModHandle:visible = mFameOldVis.
      109     current-window:visible = mVisCUrentVin.
      110   end.
      111    if  log-manager:logfile-name ne ?
      112     then DO:
      113         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      114         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      115         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      116     end.
      117   on choose of B-WaitFramStop in frame waitfram
      118   do:
      119     mWaitFramStop = yes.
      120     mWaitFramStopUser = yes.
      121   end.
      122   function waitfram-check-timeout returns logical():
      123      define variable vtime as int64 no-undo.
      124      if mWaitFramStopTimeOut
      125      then
      126         return yes.
      127      vtime = ( now - mWaitFramStartProc ) / 1000 .
      128      if     mWaitFramTimeOut ne ?
      129         and mWaitFramTimeOut ne 0
      130         and mWaitFramTimeOut lt vtime
      131      then do:
      132         mWaitFramStopTimeOut = yes.
      133      end.
      134      return mWaitFramStopTimeOut.
      135   end.
      136   procedure waitfram-hide :
      137     if not session:batch-mode
      138     then do
      139     on error undo, return error return-value
      140     :
      141       pause 0 before-hide .
      142       if not mBatchMode then
      143         hide frame waitfram .
      144     if     not mWaitFramView
      145        and mWaitProcEvent
      146     then
      147       process events .
      148     end.
      149   end procedure.
      150   procedure waitfram-show :
      151     define input  parameter p-message as character no-undo .
      152     define variable v-left-margin as integer   no-undo .
      153     if not session:batch-mode
      154     then do
      155     on error undo, return error return-value
      156     :
      157       if length(p-message) <= 70 then do:
      158         assign
      159           v-left-margin = integer((70 - length(p-message)) / 2)
      160         .
      161         assign
      162           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      163         .
      164         assign
      165           v-waitfram-action01 = " "
      166           v-waitfram-action02 = " "
      167                                    + fill(" ", v-left-margin)
      168                                    + p-message
      169           v-waitfram-action03 = " "
      170         .
      171       end.
      172       else do:
      173         define variable vRindex1 as integer no-undo.
      174         define variable vRindex2 as integer no-undo.
      175         vRindex1 = r-index(p-message," ",70).
      176         if vRindex1 = 0
      177         then
      178            vRindex1 = 70.
      179         if length(p-message)  <= vRindex1 + 70 then do:
      180           assign
      181             v-waitfram-action01 = " "
      182             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      183             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      184           .
      185         end.
      186         else do:
      187           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      188           if vRindex2 <= vRindex1
      189           then
      190              vRindex2 = vRindex1 + 70.
      191           assign
      192             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      193             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      194             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      195           .
      196         end.
      197       end.
      198       B-viewProcInfo:visible   in frame waitfram = no.
      199       B-viewProcInfo:sensitive in frame waitfram = no.
      200       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      201       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      202       if  (   mWaitFramView
      203          or  mWaitProcEvent)
      204          and not mBatchMode
      205       then
      206          display
      207             v-waitfram-action01 skip
      208             v-waitfram-action02 skip
      209             v-waitfram-action03 skip
      210          with frame waitfram .
      211       if     mWaitFramView
      212          then do:
      213             if     mWaitFramInterval ne ?
      214                and not mBatchMode
      215             then
      216                wait-for go of frame waitfram pause mWaitFramInterval.
      217          end.
      218          else
      219             if     mWaitProcEvent
      220                and not mBatchMode
      221             then
      222                process events .
      223     end.
      224   end procedure.
      225      procedure waitfram-show-this:
      226         define input  parameter iInterval as int64 no-undo.
      227         define variable vtime as int64 no-undo.
      228         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      229         mWaitFramInterval = iInterval.
      230         run waitfram-show (substitute("&1&2 &3&4" ,
      231                                       mWaitFramTextBeg ,
      232                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      233                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      234                                       mWaitFramTextEnd
      235                                      )
      236                           ).
      237      end.
      238      procedure WaitFramRunPause:
      239         define input  parameter iInterval as dec no-undo.
      240         define variable vStart  as datetime-tz no-undo.
      241         define variable vend    as datetime-tz no-undo.
      242         define variable vint as int64 no-undo.
      243         define variable vOk as logical no-undo.
      244         vStart = now.
      245         vend   = vStart.
      246         publish "WaitFramPause" (iInterval,output vOk).
      247         vend   =  now.
      248         vint = vend - vStart.
      249         vint = iInterval - vint / 1000.
      250         if     not mWaitFramStop
      251            and (   vint > 0
      252                 or (    not vOk
      253                     and iInterval eq ?
      254                     )
      255                 )
      256         then
      257            run waitfram-show-this (iInterval).
      258         vend   =  now.
      259         vint = vend - vStart.
      260         vint = iInterval - vint / 1000.
      261         if     not mWaitFramStop
      262            and vint > 0
      263         then do:
      264            run gbl/pause.p (vint * 1000).
      265         end.
      266         if iInterval ne ?
      267         then
      268            publish "WaitFramStop".
      269         waitfram-check-timeout().
      270      end.
      271      procedure WaitFramWaitFor:
      272         define input  parameter iInterval as dec no-undo.
      273         assign
      274            mWaitFramStartProc   = now
      275            mWaitFramStopUser    = no
      276            mWaitFramStopTimeOut = no
      277         .
      278         block-wait:
      279         do while not mWaitFramStop:
      280            run WaitFramRunPause (iInterval).
      281            if  waitfram-check-timeout()
      282            then do:
      283               leave block-wait.
      284            end.
      285         end.
      286         run waitfram-hide.
      287      end.
      288   procedure waitfram-join :
      289     define input  parameter p-line-1  as character no-undo .
      290     define input  parameter p-line-2  as character no-undo .
      291     define input  parameter p-line-3  as character no-undo .
      292     define output parameter p-message as character no-undo .
      293     do
      294     on error undo, return error return-value
      295     :
      296       assign
      297         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      298                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      299                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      300       .
      301     end.
      302   end procedure.
      303   function waitfram-join-function returns character
      304     (input p-line-1 as character
      305     ,input p-line-2 as character
      306     ,input p-line-3 as character
      307     ).
      308     define variable v-message as character no-undo .
      309     run waitfram-join in this-procedure
      310       (input  p-line-1
      311       ,input  p-line-2
      312       ,input  p-line-3
      313       ,output v-message
      314       ) .
      315     return v-message .
      316   end function .
      317   define new global shared variable g#language as character no-undo .
      318   if g#language <> '' and g#language <> 'rus':U then do:
      319     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      320   end.
      321   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      322   define  shared variable g#auto-pid           as integer   no-undo .
      323   define  shared variable conn-par             as character no-undo .
      324   define  shared variable g#auto-user-id       as character no-undo .
      325   define  shared variable g#auto-user-login    as character no-undo .
      326   define  shared variable g#auto-user-password as character no-undo .
      327   define  shared variable v-socket             as logical   no-undo .
      328   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      329   define  shared variable auto-window-h     as handle    no-undo .
      330   define  shared variable auto-log-msg-h    as handle    no-undo .
      331   define  shared variable hand-log-msg-h    as handle    no-undo .
      332   define  shared variable log-file-name     as character no-undo initial ? .
      333   define  shared variable add-log-file-name as character no-undo initial ? .
      334   define  shared variable writelogvalue     as character no-undo initial ? .
      335   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      336   procedure cur-time :
      337      define output parameter p-today as date      no-undo .
      338      define output parameter p-time  as integer   no-undo .
      339     do
      340     on error undo, return error
      341     :
      342       define variable v-date1 as date      no-undo .
      343       define variable v-date2 as date      no-undo .
      344       define variable v-time  as integer   no-undo .
      345       assign
      346         v-date1 = today
      347         v-time  = time
      348         v-date2 = today
      349       .
      350       if v-date1 <> v-date2
      351       then do:
      352         assign
      353           v-date1 = today
      354           v-time  = v-time
      355         .
      356       end.
      357       assign
      358         p-today = v-date1
      359         p-time  = v-time
      360       .
      361     end.
      362   end.
      363   function cur-time-date returns character
      364   :
      365     return string(today, '99/99/9999':U) .
      366   end.
      367   function cur-time-mjd returns decimal
      368   :
      369     define variable v-date as date      no-undo .
      370     define variable v-time as integer   no-undo .
      371     run cur-time in this-procedure
      372       (output v-date
      373       ,output v-time
      374       ) .
      375     return integer(v-date) - 2400002 + (v-time / 86400) .
      376   end.
      377   function cur-time-get-ending-index returns integer
      378   (input p-number as integer
      379   )
      380   :
      381     if p-number < 0
      382     or p-number = ?
      383     then do:
      384       return 1 .
      385     end.
      386     define variable v-rest as integer   no-undo .
      387     assign
      388       p-number = p-number modulo 100
      389     .
      390     if p-number < 20
      391     then do:
      392       assign
      393         v-rest = p-number
      394       .
      395     end.
      396     else do:
      397       assign
      398         v-rest = p-number modulo 10
      399       .
      400     end.
      401     case v-rest :
      402       when 1
      403       then do:
      404         return 2 .
      405       end.
      406       when 2 or
      407       when 3 or
      408       when 4
      409       then do:
      410         return 3 .
      411       end.
      412       otherwise do:
      413         return 1 .
      414       end.
      415     end case .
      416   end.
      417   procedure cur-time-mjd-to-date :
      418      define input  parameter i-mjd-diff as decimal no-undo.
      419      define output parameter o-Date     as date    no-undo.
      420      define output parameter o-Time     as integer no-undo.
      421      define variable v-day-number as integer   no-undo .
      422      if    i-mjd-diff < 0
      423         or i-mjd-diff = ?
      424      then do:
      425         return "?" .
      426      end.
      427      assign
      428         v-day-number = truncate(i-mjd-diff,0).
      429         o-Date = date(v-day-number + 2400002).
      430         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      431     .
      432   end.
      433   function cur-time-mjd-to-string returns character
      434   (input p-mjd-diff as decimal
      435   )
      436   :
      437     define variable v-day-number as integer   no-undo .
      438     define variable v-seconds    as integer   no-undo .
      439     define variable v-hour       as integer   no-undo .
      440     define variable v-min        as integer   no-undo .
      441     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      442     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      443     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      444     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      445     if p-mjd-diff < 0
      446     or p-mjd-diff = ?
      447     then do:
      448       return "?" .
      449     end.
      450     assign
      451       v-day-number = integer(truncate(p-mjd-diff,0))
      452       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      453     .
      454     if v-seconds > 86400
      455     then do:
      456       assign
      457         v-seconds = 86400 - 1
      458       .
      459     end.
      460     if v-seconds < 0
      461     then do:
      462       assign
      463         v-seconds = 0
      464       .
      465     end.
      466     assign
      467       v-hour = truncate(v-seconds / 3600, 0)
      468     .
      469     assign
      470       v-seconds = v-seconds modulo 3600
      471     .
      472     assign
      473       v-min = truncate(v-seconds / 60, 0)
      474     .
      475     assign
      476       v-seconds = v-seconds modulo 60
      477     .
      478     return
      479         (if v-day-number <> 0
      480           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      481           else ""
      482         )
      483       + (if v-day-number <> 0 or v-hour <> 0
      484           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      485           else ""
      486         )
      487       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      488           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      489           else ""
      490         )
      491       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      492       .
      493   end.
      494   function cur-time-string returns character
      495   :
      496     define variable v-date as date      no-undo .
      497     define variable v-time as integer   no-undo .
      498     run cur-time in this-procedure
      499       (output v-date
      500       ,output v-time
      501       ) .
      502     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      503   end.
      504   function cur-time-string-sec returns character
      505   :
      506     define variable v-date as date      no-undo .
      507     define variable v-time as integer   no-undo .
      508     run cur-time in this-procedure
      509       (output v-date
      510       ,output v-time
      511       ) .
      512     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      513   end.
      514   function cur-time-custom  returns character
      515   (input p-prefix as character
      516   ,input p-date-format as character
      517   ,input p-delimiter as character
      518   ,input p-time-format as character
      519   ,input p-suffix as character
      520   )
      521   :
      522     define variable v-date as date      no-undo .
      523     define variable v-time as integer   no-undo .
      524     run cur-time in this-procedure
      525       (output v-date
      526       ,output v-time
      527       ) .
      528     return
      529       p-prefix
      530       + string(v-date, p-date-format)
      531       + p-delimiter
      532       + string(v-time, p-time-format)
      533       + p-suffix
      534       .
      535   end.
      536   function cur-time-print  returns character
      537   :
      538     define variable v-date as date      no-undo .
      539     define variable v-time as integer   no-undo .
      540     run cur-time in this-procedure
      541       (output v-date
      542       ,output v-time
      543       ) .
      544     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      545   end.
      546   function cur-time-datetime returns datetime
      547   :
      548     define variable v-char as character no-undo .
      549     define variable v-datetime as datetime no-undo .
      550     v-char = cur-time-string().
      551     v-datetime = datetime(v-char).
      552     return  v-datetime.
      553   end.
      554   function cur-time-string-msec returns character
      555   :
      556     define variable v-date as datetime  no-undo .
      557     v-date = now.
      558     return string(v-date) .
      559   end.
      560   define stream LogStream .
      561   define variable mNoTime as logical no-undo.
      562   procedure write-to-log-notime :
      563     define input param i-str as character no-undo .
      564     mNoTime = yes.
      565     run write-to-log (i-str).
      566     mNoTime = no.
      567   end.
      568   procedure write-to-log :
      569     define input param p-str as character no-undo .
      570     do
      571     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      572     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      573     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      574     :
      575       define variable log-res        as logical   no-undo .
      576       define variable v-jj           as integer   no-undo .
      577       if    mNoTime
      578          or writelogvalue eq "AsyncProc"
      579       then
      580          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      581       else
      582          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      583       if auto-log-msg-h <> ? then do:
      584         log-res = auto-log-msg-h:move-to-eof( ) .
      585         log-res = auto-log-msg-h:insert-string( p-str ).
      586       end.
      587       if hand-log-msg-h <> ? then do:
      588         log-res = hand-log-msg-h:move-to-eof( ) .
      589         log-res = hand-log-msg-h:insert-string( p-str ).
      590       end.
      591       assign
      592         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      593         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      594         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      595       .
      596       if add-log-file-name <> ? then do:
      597         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      598           run gbl/fileapnd.p
      599             ( input entry(v-jj, add-log-file-name, chr(1) )
      600             ,input p-str
      601             ,input 20
      602             ) no-error .
      603           if error-status:error then do:
      604             return error return-value .
      605           end.
      606         end.
      607       end.
      608       if writelogvalue eq "AsyncProc"
      609       then do:
      610          p-str = trim(p-str, (chr(13) + chr(10)) )
      611       .
      612          Publish "WriteLogAsunc" (p-str,yes).
      613       end.
      614       else if writelogvalue <> "yes" then do:
      615         run gbl/fileapnd.p
      616           ( input log-file-name
      617           ,input p-str
      618           ,input 20
      619           ) no-error .
      620         if error-status:error then do:
      621           return error return-value .
      622         end.
      623       end.
      624     end.
      625   end procedure.
      626   procedure write-to-screen :
      627     define input param p-str as character no-undo .
      628     do
      629     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      630     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      631     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      632     :
      633       define variable log-res as logical no-undo.
      634       assign
      635         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      636       .
      637       if auto-log-msg-h <> ?
      638       then do:
      639         log-res = auto-log-msg-h:move-to-eof( ) .
      640         log-res = auto-log-msg-h:insert-string( p-str ).
      641       end.
      642       if hand-log-msg-h <> ?
      643       then do:
      644         log-res = hand-log-msg-h:move-to-eof( ) .
      645         log-res = hand-log-msg-h:insert-string( p-str ).
      646       end.
      647     end.
      648   end procedure.
      649   procedure send-msg-to-email :
      650     define input  parameter p-subject      as character no-undo .
      651     define input  parameter p-text-err     as character no-undo .
      652     define input  parameter p-attach-files as character no-undo .
      653     do
      654     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      655     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      656     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      657     :
      658       define variable v-tth             as handle    no-undo .
      659       define variable v-value-character as character no-undo .
      660       define variable v-value-date      as date      no-undo .
      661       define variable v-value-decimal   as decimal   no-undo .
      662       define variable v-value-integer   as integer   no-undo .
      663       define variable v-value-logical   as logical   no-undo .
      664       define variable v-param-type      as character no-undo .
      665       define variable v-email       as character no-undo .
      666       define variable v-tmp-str     as character no-undo .
      667       define variable v-tmp1-str    as character no-undo .
      668       define variable v-ind         as integer   no-undo .
      669       define variable v-num-entries as integer   no-undo .
      670       delete object v-tth no-error.
      671       run adm/shattri.p
      672         ( input "get":U
      673          ,input  "":U
      674          ,input  0
      675          ,input  'auto-task':U
      676          ,input  'send-msg-to-email':U
      677          ,output v-value-character
      678          ,output v-value-date
      679          ,output v-value-decimal
      680          ,output v-value-integer
      681          ,output v-value-logical
      682          ,output v-param-type
      683          ,input-output table-handle v-tth
      684         ) no-error .
      685       if not error-status :error  then do:
      686         assign
      687           v-tmp-str = v-value-character
      688         .
      689       end.
      690       delete object v-tth no-error.
      691       assign
      692         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      693         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      694         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      695         v-num-entries = num-entries( v-tmp-str, chr(44) )
      696         v-email       = "":U
      697       .
      698       do v-ind = 1 to v-num-entries
      699       :
      700         assign
      701           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      702         .
      703         if trim( v-tmp1-str ) <> "":U then do:
      704           if v-email = "":U then do:
      705             assign
      706               v-email = v-tmp1-str
      707             .
      708           end.
      709           else do:
      710             assign
      711               v-email = v-email + chr(44) + v-tmp1-str
      712             .
      713           end.
      714         end.
      715       end.
      716       if v-email <> "":U then do:
      717         run gbl/sendmail.p
      718           ( input v-email
      719           , input p-subject
      720           , input p-text-err
      721           , input p-attach-files
      722           ) no-error .
      723         if error-status :error
      724           or return-value <> "":U
      725         then do:
      726           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      727         end.
      728       end.
      729     end.
      730   end procedure.
      731   define new global shared variable g#library  as handle no-undo .
      732   define new global shared variable g#library2 as handle no-undo .
      733   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      734   define temp-table temp-schedule-free no-undo
      735   field free-id as character
      736   field free-task-name as character
      737   field proc-run-name as character
      738   field proc-param-edit-name as character
      739   field conf-param as character
      740   field is-gbd as logical
      741   field is-ubd as logical
      742   field enable-concurrent-0 as logical
      743   field enable-concurrent-db as logical
      744   field other-info as character
      745   field enc-key as character
      746   field is-rum as logical
      747   index pi is unique primary
      748   free-id.
      749   procedure schedule-attr-name :
      750   do
      751     on error undo, return error
      752     :
      753     define input  parameter p-code           as character no-undo .
      754     define output parameter p-type           as character no-undo .
      755     define output parameter p-format         as character no-undo .
      756     define output parameter p-label          as character no-undo .
      757     define output parameter p-user-can-edit  as logical   no-undo .
      758     define output parameter p-output-display as logical   no-undo .
      759     define output parameter p-other          as character no-undo .
      760       if index(p-code, chr(4)) > 0 then do:
      761         p-code = entry(1, p-code, chr(4)).
      762       end.
      763       case p-code :
      764               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      765               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      766               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      767               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      768               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      769               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      770               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      771               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      772               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      773         otherwise do:
      774           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      775         end.
      776       end.
      777     end.
      778   end procedure.
      779   procedure schedule-attr-tooltip :
      780   do
      781     on error undo, return error
      782     :
      783       define input  parameter p-code    as character no-undo .
      784       define output parameter p-tooltip as character no-undo .
      785       define output parameter p-label   as character no-undo .
      786       if index(p-code, chr(4)) > 0 then do:
      787         p-code = entry(1, p-code, chr(4)).
      788       end.
      789       case p-code :
      790               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      791               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      792               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      793               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      794               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      795               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      796               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      797               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      798               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      799         otherwise do:
      800               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      801         end.
      802       end.
      803     end.
      804   end procedure.
      805   procedure schedule-attr-value :
      806   do
      807   on error undo, return error return-value
      808   :
      809   define input parameter  p-cre-db-num as integer    no-undo.
      810   define input parameter  p-task-type  as character  no-undo.
      811   define input parameter  p-task-num   as integer    no-undo.
      812   define input parameter  p-code       as character  no-undo.
      813   define output parameter p-value      as character  no-undo.
      814   define output parameter p-type       as character  no-undo.
      815       define variable v-format         as character no-undo .
      816       define variable v-label          as character no-undo .
      817       define variable v-user-can-edit  as logical   no-undo .
      818       define variable v-output-display as logical   no-undo .
      819       define variable v-other          as character no-undo .
      820       define buffer buf_schedule-attr for ub.schedule-attr.
      821       run schedule-attr-name in this-procedure (
      822             input  p-code
      823           , output p-type
      824           , output v-format
      825           , output v-label
      826           , output v-user-can-edit
      827           , output v-output-display
      828           , output v-other
      829       ) no-error .
      830       if error-status :error
      831       then do:
      832           undo, return error return-value .
      833       end.
      834       if p-code begins ('schd-free-id':U + chr(4))
      835       and entry(2, p-code, chr(4)) = '':U then do:
      836         find first buf_schedule-attr no-lock
      837             where buf_schedule-attr.cre-db-num = p-cre-db-num
      838               and buf_schedule-attr.task-type  = p-task-type
      839               and buf_schedule-attr.task-num   = p-task-num
      840               and buf_schedule-attr.attr-code  begins p-code
      841         no-error .
      842       end.
      843       else do:
      844         find first buf_schedule-attr no-lock
      845             where buf_schedule-attr.cre-db-num = p-cre-db-num
      846               and buf_schedule-attr.task-type  = p-task-type
      847               and buf_schedule-attr.task-num   = p-task-num
      848               and buf_schedule-attr.attr-code  = p-code
      849         no-error .
      850       end.
      851       if available buf_schedule-attr
      852       then do:
      853           assign
      854               p-value = buf_schedule-attr.attr-value
      855           .
      856       end.
      857       else do:
      858         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      859            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      860         end.
      861         else do:
      862           assign
      863               p-value = if p-type = 'L':U then "no":U else ""
      864           .
      865         end.
      866       end.
      867   end.
      868   end procedure.
      869   procedure schedule-attr-write :
      870   do
      871   on error undo, return error
      872   :
      873   define input parameter p-cre-db-num  as integer   no-undo.
      874   define input parameter p-task-type   as character no-undo.
      875   define input parameter p-task-num    as integer   no-undo.
      876   define input parameter p-code        as character no-undo.
      877   define input parameter p-value       as character no-undo.
      878       define variable v-type              as character                no-undo.
      879       define variable v-format            as character                no-undo.
      880       define variable v-label             as character                no-undo.
      881       define variable v-user-can-edit     as logical                  no-undo.
      882       define variable v-output-display    as logical                  no-undo.
      883       define variable v-other             as character                no-undo.
      884       define buffer buf_schedule-attr for ub.schedule-attr .
      885       run schedule-attr-name in this-procedure (
      886             input  p-code
      887           , output v-type
      888           , output v-format
      889           , output v-label
      890           , output v-user-can-edit
      891           , output v-output-display
      892           , output v-other
      893       ) no-error.
      894       if error-status :error
      895       then do:
      896           undo, return error return-value.
      897       end.
      898       find first buf_schedule-attr exclusive-lock
      899            where buf_schedule-attr.cre-db-num = p-cre-db-num
      900              and buf_schedule-attr.task-type  = p-task-type
      901              and buf_schedule-attr.task-num   = p-task-num
      902              and buf_schedule-attr.attr-code  = p-code
      903       no-error.
      904       if not available buf_schedule-attr
      905       then do:
      906           create buf_schedule-attr.
      907           assign
      908             buf_schedule-attr.cre-db-num = p-cre-db-num
      909             buf_schedule-attr.task-type  = p-task-type
      910             buf_schedule-attr.task-num   = p-task-num
      911             buf_schedule-attr.attr-code  = p-code
      912             buf_schedule-attr.attr-value = p-value
      913           .
      914       end.
      915       else do:
      916           assign
      917               buf_schedule-attr.attr-value = p-value
      918           .
      919       end.
      920   end.
      921   end procedure.
      922   procedure schedule-attr-delete :
      923   do
      924   on error undo, return error
      925   :
      926   define input  parameter p-cre-db-num  as integer   no-undo.
      927   define input  parameter p-task-type   as character no-undo.
      928   define input  parameter p-task-num    as integer   no-undo.
      929   define input  parameter p-code        as character no-undo.
      930   define output parameter p-deleted     as logical   no-undo.
      931       define buffer buf_schedule-attr for ub.schedule-attr .
      932       define variable v-type              as character                no-undo.
      933       define variable v-format            as character                no-undo.
      934       define variable v-label             as character                no-undo.
      935       define variable v-user-can-edit     as logical                  no-undo.
      936       define variable v-output-display    as logical                  no-undo.
      937       define variable v-other             as character                no-undo.
      938       run schedule-attr-name in this-procedure (
      939             input p-code
      940           , output v-type
      941           , output v-format
      942           , output v-label
      943           , output v-user-can-edit
      944           , output v-output-display
      945           , output v-other
      946       ) no-error .
      947       if error-status :error
      948       then do:
      949           undo, return error return-value .
      950       end.
      951       find first buf_schedule-attr exclusive-lock
      952            where buf_schedule-attr.cre-db-num = p-cre-db-num
      953              and buf_schedule-attr.task-type  = p-task-type
      954              and buf_schedule-attr.task-num   = p-task-num
      955              and buf_schedule-attr.attr-code  = p-code
      956       no-error.
      957       if not available buf_schedule-attr
      958       then do:
      959           assign
      960               p-deleted = no
      961           .
      962       end.
      963       else do:
      964           delete buf_schedule-attr.
      965           assign
      966               p-deleted = yes
      967           .
      968       end.
      969   end.
      970   end procedure.
      971   procedure schedule-attr-news :
      972   do
      973   on error undo, return error
      974   :
      975       define input  parameter p-code           as character no-undo .
      976       define output parameter p-news           as logical   no-undo .
      977       if index(p-code, chr(4)) > 0 then do:
      978         p-code = entry(1, p-code, chr(4)).
      979       end.
      980       case p-code :
      981               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      982               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      983               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      984               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      985               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      986               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      987               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      988               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      989               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      990         otherwise do:
      991           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      992         end.
      993       end.
      994   end.
      995   end procedure.
      996   procedure schedule-attr-extract-logical :
      997   do
      998   on error undo, return error
      999   :
     1000   define input  parameter p-parameter-number   as integer      no-undo.
     1001   define input  parameter p-parameter-list     as character    no-undo.
     1002   define output parameter p-parameter-value   as logical      no-undo.
     1003       if num-entries( p-parameter-list ) > p-parameter-number - 1
     1004       then do:
     1005           assign
     1006               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
     1007           .
     1008       end.
     1009       else do:
     1010           assign
     1011               p-parameter-value   = no
     1012           .
     1013       end.
     1014   end.
     1015   end procedure.
     1016   procedure schedule-attr-get-free-id :
     1017   do
     1018   on error undo, return error return-value
     1019   :
     1020     define input  parameter p-cre-db-num  as integer   no-undo.
     1021     define input  parameter p-task-type   as character no-undo.
     1022     define input  parameter p-task-num    as integer   no-undo.
     1023     define output parameter p-free-id     as character no-undo.
     1024     define buffer buf_schedule-attr for ub.schedule-attr.
     1025     find first buf_schedule-attr no-lock
     1026         where buf_schedule-attr.cre-db-num = p-cre-db-num
     1027           and buf_schedule-attr.task-type  = p-task-type
     1028           and buf_schedule-attr.task-num   = p-task-num
     1029           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
     1030     no-error .
     1031     if available buf_schedule-attr then
     1032     assign
     1033     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
     1034     no-error
     1035     .
     1036   end.
     1037   end procedure.
     1038   procedure schedule-attr-get-free-props :
     1039     define input parameter p-free-id as character no-undo .
     1040     define output parameter p-value as character no-undo .
     1041     define buffer buf_temp-schedule-free for temp-schedule-free.
     1042     do
     1043     on error undo, return error return-value
     1044     :
     1045       find first buf_temp-schedule-free no-lock no-error .
     1046       if not available buf_temp-schedule-free then do:
     1047         run schedule-attr-fill-free-props in this-procedure .
     1048       end.
     1049       find first buf_temp-schedule-free where
     1050               buf_temp-schedule-free.free-id = p-free-id no-error.
     1051       if available buf_temp-schedule-free then do:
     1052         assign
     1053         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
     1054                   buf_temp-schedule-free.proc-run-name        + chr(4) +
     1055                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
     1056                   buf_temp-schedule-free.conf-param           + chr(4) +
     1057                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
     1058                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
     1059                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
     1060                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
     1061                   buf_temp-schedule-free.other-info
     1062         .
     1063       end.
     1064       else do:
     1065        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
     1066                              "id произвольной задачи - &5"
     1067                              ,vss-workfile
     1068                              ,vss-revision
     1069                              ,vss-description
     1070                              ,chr(10)
     1071                              ,p-free-id).
     1072       end.
     1073     end.
     1074   end procedure.
     1075   procedure schedule-attr-is-rum-free-id :
     1076   define input parameter p-free-id as character no-undo .
     1077   define output parameter p-is-rum as logical no-undo .
     1078   define buffer buf_temp-schedule-free for temp-schedule-free.
     1079   do
     1080   on error undo, return error
     1081   :
     1082       find first buf_temp-schedule-free no-lock no-error .
     1083       if not available buf_temp-schedule-free then do:
     1084         run schedule-attr-fill-free-props in this-procedure .
     1085       end.
     1086       find first buf_temp-schedule-free where
     1087               buf_temp-schedule-free.free-id = p-free-id no-error.
     1088       if available buf_temp-schedule-free
     1089       and buf_temp-schedule-free.is-rum
     1090       then do:
     1091         p-is-rum = yes.
     1092       end.
     1093   end.
     1094   end procedure.
     1095   procedure schedule-attr-fill-free-props :
     1096   define variable v-path                    as character                no-undo .
     1097   DEFINE VARIABLE v-full-path               as character                no-undo .
     1098   DEFINE VARIABLE v-file-name               as character                no-undo .
     1099   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
     1100   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
     1101   define buffer buf_temp-schedule-free for temp-schedule-free.
     1102   define variable v-answer as logical no-undo .
     1103     do
     1104     on error undo, return error substitute("&1 &2 &3&4&5&4"
     1105                                           ,vss-workfile
     1106                                           ,vss-revision
     1107                                           ,vss-description
     1108                                           ,chr(10)
     1109                                           ,error-status:get-message(1) )
     1110     :
     1111       run gbl/filename.p (
     1112                       input 'cmp/shd-free.d'
     1113                     ,output v-full-path
     1114                     ,output v-path
     1115                     ,output v-file-name
     1116                     ,output v-file-name-no-ext
     1117                     ,output v-file-name-ext
     1118                     ) .
     1119       input from value(v-full-path).
     1120       repeat :
     1121         create buf_temp-schedule-free.
     1122         import buf_temp-schedule-free.
     1123       END.
     1124       input close.
     1125       _ff:
     1126       for each buf_temp-schedule-free :
     1127         if buf_temp-schedule-free.free-id = '':U then do:
     1128            delete buf_temp-schedule-free.
     1129            next _ff.
     1130          end.
     1131          run schedule-attr-check-enc in this-procedure (
     1132                                                       input  buf_temp-schedule-free.free-id
     1133                                                      ,input  (buf_temp-schedule-free.proc-run-name +
     1134                                                               buf_temp-schedule-free.proc-param-edit-name +
     1135                                                               buf_temp-schedule-free.conf-param +
     1136                                                               string(buf_temp-schedule-free.is-gbd) +
     1137                                                               string(buf_temp-schedule-free.is-ubd) +
     1138                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
     1139                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
     1140                                                               string(buf_temp-schedule-free.other-info)
     1141                                                               )
     1142                                                       ,input  buf_temp-schedule-free.enc-key
     1143                                                       ,output v-answer    ) no-error .
     1144          if error-status:error
     1145          or not v-answer then delete buf_temp-schedule-free.
     1146        end.
     1147     end.
     1148   end procedure.
     1149   Function schedule-attr-reverse returns character (str as character).
     1150      define variable rev_incl_s as character init "" no-undo .
     1151      define variable rev_incl_i as integer no-undo .
     1152      define variable rev_incl_l as integer no-undo .
     1153      rev_incl_l = length(str).
     1154      do rev_incl_i = 1 to rev_incl_l:
     1155         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
     1156      end.
     1157      return rev_incl_s.
     1158   end.
     1159   procedure schedule-attr-check-enc.
     1160     define input  parameter p-free-id   as character no-undo .
     1161     define input  parameter p-value     as character no-undo .
     1162     define input  parameter p-enc-value as character no-undo .
     1163     define output parameter p-answer    as logical   no-undo .
     1164     define variable tmp         as character no-undo .
     1165     define variable v-enc-value as character no-undo .
     1166     assign
     1167     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
     1168     .
     1169     run schedule-attr-pswd-enc in this-procedure
     1170       ( input tmp
     1171        ,output v-enc-value
     1172       ) no-error .
     1173     if error-status:error then do:
     1174       message
     1175         vss-workfile vss-revision vss-description skip
     1176         "Ошибка при вызове процедуры pswd-enc" skip
     1177         return-value skip
     1178         error-status :get-message(1) skip
     1179         view-as alert-box error .
     1180       undo, return error .
     1181     end.
     1182     if v-enc-value = p-enc-value then do:
     1183       assign
     1184         p-answer = true
     1185       .
     1186     end.
     1187     else do:
     1188       assign
     1189         p-answer = false
     1190       .
     1191     end.
     1192   end.
     1193   procedure schedule-attr-conf-enc.
     1194     define input  parameter p-free-id   as character no-undo .
     1195     define input  parameter p-value     as character no-undo .
     1196     define output parameter p-enc-value as character no-undo .
     1197     define variable tmp         as character no-undo .
     1198     assign
     1199       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
     1200     .
     1201     run schedule-attr-pswd-enc in this-procedure
     1202       ( input tmp
     1203        ,output p-enc-value
     1204       ) no-error .
     1205     if error-status:error then do:
     1206       message
     1207         vss-workfile vss-revision vss-description skip
     1208         "Ошибка при вызове процедуры pswd-enc" skip
     1209         return-value skip
     1210         error-status :get-message(1) skip
     1211         view-as alert-box error .
     1212       undo, return error .
     1213     end.
     1214   end procedure.
     1215   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1216   procedure schedule-attr-pswd-enc :
     1217     define input parameter  pswd     as character no-undo .
     1218     define output parameter enc-pswd as character no-undo .
     1219     do
     1220     on error undo, return error return-value
     1221     :
     1222       assign
     1223         enc-pswd = encode(pswd + string(index(pswd, "k")))
     1224       .
     1225     end.
     1226   end procedure.
     1227   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1228   define variable v-loc-counter as integer no-undo .
     1229   define variable v-counter-visible as logical no-undo .
     1230   define variable v-view-log as logical no-undo .
     1231   define stream auto2dia.
     1232   PROCEDURE write-log-and-file :
     1233   do
     1234   on error undo, return error
     1235   :
     1236     define input parameter p-tab-position   as integer   no-undo.
     1237     define input parameter p-file-name      as character no-undo .
     1238     define input parameter p-log-level      as integer   no-undo .
     1239     define input parameter p-log-string     AS CHARacter NO-UNDO.
     1240     define variable v-jj as integer   no-undo .
     1241     run write-to-screen in this-procedure( input ( fill( chr(32), p-tab-position) + p-log-string)) .
     1242     if p-file-name <> '':U then do:
     1243       do v-jj = 1 to num-entries(p-file-name, chr(1)):
     1244         run  auto2dia-writefile in this-procedure (
     1245                                         input entry(v-jj, p-file-name, chr(1))
     1246                                         ,input p-log-level
     1247                                         ,input (p-log-string + chr(10))
     1248                                       ) no-error .
     1249       end.
     1250     end.
     1251     if writelogvalue eq "AsyncProc"
     1252     then
     1253        run write-to-log in this-procedure( p-log-string) .
     1254   end.
     1255   END PROCEDURE.
     1256   PROCEDURE get-title :
     1257   do
     1258   on error undo, return error
     1259   :
     1260   define output parameter p-title     as character    no-undo.
     1261   end.
     1262   END PROCEDURE.
     1263   PROCEDURE set-title :
     1264   do
     1265   on error undo, return error
     1266   :
     1267   define input parameter p-title     as character    no-undo.
     1268   run write-to-log in this-procedure( input ( fill( chr(32), 15) + p-title)) .
     1269   end.
     1270   END PROCEDURE.
     1271   PROCEDURE get-counter-value :
     1272   do
     1273   on error undo, return error
     1274   :
