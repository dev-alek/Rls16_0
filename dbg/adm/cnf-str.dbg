        1   block-level on error undo, throw.
        2   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":u .
        3   def var vss-author      as character no-undo init "$Author: expertek $":u.
        4   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":u.
        5   def var vss-workfile    as character no-undo init "$Workfile: cnf-str.p $":u.
        6   def var vss-archive     as character no-undo init "$Archive: adm/cnf-str.p $":u.
        7   def var vss-description as character no-undo init "Просмотр и корректировка схемы конфигурации".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define  shared temp-table cnf no-undo
       67       field param-code    as character   format "x(8)"        column-label "Код"                               field param-type    as character                        column-label "Тип"                               field param-value   as character   format "x(250)"      column-label "Значение"                          field param-encoded as character                        column-label "Кодированное значение"             field host-code     as integer                          column-label "Фирма"                             field obj-type      as character                        column-label "Тип объекта"                       field obj-code      as integer     format ">>>>>>"      column-label "Код объекта"                       field conf-type     as character                        column-label "Кодировка"                         field beg-date      as date                             column-label "Начало действия параметра"         field end-date      as date                             column-label "Окончание действия параметра"      field db-num        as integer     format ">>>>>"       column-label "БД"                                field stts          as integer                          column-label "Статус"
       68       field db-key        as character   format "x(12)"       column-label "Ключ БД"
       69       field param-PS      as character   format "x(40)"       column-label "PS"
       70       field param-name    as character   format "x(30)"       column-label "Название"
       71       field is-changed    as logical initial false            column-label "Изменен"
       72       field NotUsed       as logical initial False            column-label "Выключен"
       73       field ErrorExist    as integer initial 0  format ">>"   column-label "Уровень ошибки"
       74       index pi
       75         is unique
       76         param-code
       77         host-code
       78         obj-type
       79         obj-code
       80         beg-date
       81         end-date
       82         db-num
       83       index db-num
       84         db-num
       85       index db-key
       86         db-key
       87       index par-name
       88         is word-index
       89         param-name
       90       index par-value
       91         is word-index
       92         param-value
       93    .
       94   def  shared temp-table log-table no-undo
       95       field stroka       as character format "x(256)".
       96   def  shared variable err-level as integer no-undo.
       97   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       98   procedure cur-time :
       99      define output parameter p-today as date      no-undo .
      100      define output parameter p-time  as integer   no-undo .
      101     do
      102     on error undo, return error
      103     :
      104       define variable v-date1 as date      no-undo .
      105       define variable v-date2 as date      no-undo .
      106       define variable v-time  as integer   no-undo .
      107       assign
      108         v-date1 = today
      109         v-time  = time
      110         v-date2 = today
      111       .
      112       if v-date1 <> v-date2
      113       then do:
      114         assign
      115           v-date1 = today
      116           v-time  = v-time
      117         .
      118       end.
      119       assign
      120         p-today = v-date1
      121         p-time  = v-time
      122       .
      123     end.
      124   end.
      125   function cur-time-date returns character
      126   :
      127     return string(today, '99/99/9999':U) .
      128   end.
      129   function cur-time-mjd returns decimal
      130   :
      131     define variable v-date as date      no-undo .
      132     define variable v-time as integer   no-undo .
      133     run cur-time in this-procedure
      134       (output v-date
      135       ,output v-time
      136       ) .
      137     return integer(v-date) - 2400002 + (v-time / 86400) .
      138   end.
      139   function cur-time-get-ending-index returns integer
      140   (input p-number as integer
      141   )
      142   :
      143     if p-number < 0
      144     or p-number = ?
      145     then do:
      146       return 1 .
      147     end.
      148     define variable v-rest as integer   no-undo .
      149     assign
      150       p-number = p-number modulo 100
      151     .
      152     if p-number < 20
      153     then do:
      154       assign
      155         v-rest = p-number
      156       .
      157     end.
      158     else do:
      159       assign
      160         v-rest = p-number modulo 10
      161       .
      162     end.
      163     case v-rest :
      164       when 1
      165       then do:
      166         return 2 .
      167       end.
      168       when 2 or
      169       when 3 or
      170       when 4
      171       then do:
      172         return 3 .
      173       end.
      174       otherwise do:
      175         return 1 .
      176       end.
      177     end case .
      178   end.
      179   procedure cur-time-mjd-to-date :
      180      define input  parameter i-mjd-diff as decimal no-undo.
      181      define output parameter o-Date     as date    no-undo.
      182      define output parameter o-Time     as integer no-undo.
      183      define variable v-day-number as integer   no-undo .
      184      if    i-mjd-diff < 0
      185         or i-mjd-diff = ?
      186      then do:
      187         return "?" .
      188      end.
      189      assign
      190         v-day-number = truncate(i-mjd-diff,0).
      191         o-Date = date(v-day-number + 2400002).
      192         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      193     .
      194   end.
      195   function cur-time-mjd-to-string returns character
      196   (input p-mjd-diff as decimal
      197   )
      198   :
      199     define variable v-day-number as integer   no-undo .
      200     define variable v-seconds    as integer   no-undo .
      201     define variable v-hour       as integer   no-undo .
      202     define variable v-min        as integer   no-undo .
      203     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      204     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      205     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      206     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      207     if p-mjd-diff < 0
      208     or p-mjd-diff = ?
      209     then do:
      210       return "?" .
      211     end.
      212     assign
      213       v-day-number = integer(truncate(p-mjd-diff,0))
      214       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      215     .
      216     if v-seconds > 86400
      217     then do:
      218       assign
      219         v-seconds = 86400 - 1
      220       .
      221     end.
      222     if v-seconds < 0
      223     then do:
      224       assign
      225         v-seconds = 0
      226       .
      227     end.
      228     assign
      229       v-hour = truncate(v-seconds / 3600, 0)
      230     .
      231     assign
      232       v-seconds = v-seconds modulo 3600
      233     .
      234     assign
      235       v-min = truncate(v-seconds / 60, 0)
      236     .
      237     assign
      238       v-seconds = v-seconds modulo 60
      239     .
      240     return
      241         (if v-day-number <> 0
      242           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      243           else ""
      244         )
      245       + (if v-day-number <> 0 or v-hour <> 0
      246           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      247           else ""
      248         )
      249       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      250           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      251           else ""
      252         )
      253       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      254       .
      255   end.
      256   function cur-time-string returns character
      257   :
      258     define variable v-date as date      no-undo .
      259     define variable v-time as integer   no-undo .
      260     run cur-time in this-procedure
      261       (output v-date
      262       ,output v-time
      263       ) .
      264     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      265   end.
      266   function cur-time-string-sec returns character
      267   :
      268     define variable v-date as date      no-undo .
      269     define variable v-time as integer   no-undo .
      270     run cur-time in this-procedure
      271       (output v-date
      272       ,output v-time
      273       ) .
      274     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      275   end.
      276   function cur-time-custom  returns character
      277   (input p-prefix as character
      278   ,input p-date-format as character
      279   ,input p-delimiter as character
      280   ,input p-time-format as character
      281   ,input p-suffix as character
      282   )
      283   :
      284     define variable v-date as date      no-undo .
      285     define variable v-time as integer   no-undo .
      286     run cur-time in this-procedure
      287       (output v-date
      288       ,output v-time
      289       ) .
      290     return
      291       p-prefix
      292       + string(v-date, p-date-format)
      293       + p-delimiter
      294       + string(v-time, p-time-format)
      295       + p-suffix
      296       .
      297   end.
      298   function cur-time-print  returns character
      299   :
      300     define variable v-date as date      no-undo .
      301     define variable v-time as integer   no-undo .
      302     run cur-time in this-procedure
      303       (output v-date
      304       ,output v-time
      305       ) .
      306     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      307   end.
      308   function cur-time-datetime returns datetime
      309   :
      310     define variable v-char as character no-undo .
      311     define variable v-datetime as datetime no-undo .
      312     v-char = cur-time-string().
      313     v-datetime = datetime(v-char).
      314     return  v-datetime.
      315   end.
      316   function cur-time-string-msec returns character
      317   :
      318     define variable v-date as datetime  no-undo .
      319     v-date = now.
      320     return string(v-date) .
      321   end.
      322   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      323   define  shared temp-table cnf-struct no-undo
      324     field param-code    as character
      325     field param-type    as character
      326     field data-type     as character
      327     field param-name    as character
      328     field attach-type   as character
      329     field list-value    as character
      330     field default-value as character
      331     field PS            as character
      332     field param-group   as character
      333     field user-resp     as character
      334     index by-code is unique param-code
      335   .
      336   define temp-table t_cnf-struct no-undo like cnf-struct .
      337   define stream TxtStream.
      338   define stream temp-stream .
      339   function coding-user-resp returns character
      340     ( input p-param-code as character
      341      ,input p-user-resp  as character
      342     )
      343   :
      344     return encode( p-param-code + p-user-resp ) .
      345   end function.
      346   function decoding-user-resp returns character
      347     ( input p-param-code as character
      348      ,input p-code-usr   as character
      349     )
      350   :
      351     define variable v-ind         as integer   no-undo .
      352     define variable v-user-list   as character no-undo .
      353     define variable v-num-entries as integer   no-undo .
      354     define variable v-user-resp   as character no-undo .
      355     assign
      356       v-user-list   = "Бахтадзе,Булгаков,Белоусов,Гюнтнер,Исаков,Перваков,Суслов,Уханов,Чернова,Кочетков,Степанов,Хныкин,Гридчина,Шальнев,Сливенко,Харитонов,Кирюхин,Морозов"
      357       v-num-entries = num-entries( v-user-list )
      358       v-user-resp   = "":U
      359     .
      360     block_do:
      361     do v-ind = 1 to v-num-entries :
      362       if encode( p-param-code + entry( v-ind, v-user-list ) ) = p-code-usr then do:
      363         assign
      364           v-user-resp = entry( v-ind, v-user-list )
      365         .
      366         leave block_do.
      367       end.
      368     end.
      369     if v-user-resp = "":U then do:
      370       message
      371         vss-include-info1 skip
      372         substitute( "Невозможно распознать ответственного за параметр <&1>!",  p-param-code) skip
      373         substitute( "Возможно его нет в списке." ) skip
      374         view-as alert-box error
      375       .
      376       return "unknown":U.
      377     end.
      378     else do:
      379       return v-user-resp .
      380     end.
      381   end function.
      382   function sum-enc returns character (str as character, num-rev as integer).
      383      define variable rev_incl_s as character init "" no-undo .
      384      define variable rev_incl_i as integer no-undo .
      385      define variable rev_incl_l as integer no-undo .
      386      rev_incl_l = length(str).
      387      do rev_incl_i = 1 to rev_incl_l:
      388         if rev_incl_i <= num-rev
      389           or rev_incl_l - rev_incl_i < num-rev
      390         then do:
      391           assign
      392             rev_incl_s = rev_incl_s + substr(str, rev_incl_l - rev_incl_i + 1, 1)
      393           .
      394         end.
      395         else do:
      396           assign
      397             rev_incl_s = rev_incl_s + substr(str, rev_incl_i, 1)
      398           .
      399         end.
      400      end.
      401      return rev_incl_s.
      402   end.
      403   procedure check-cfg :
      404     define input-output parameter p-param-code    as character no-undo .
      405     define input-output parameter p-param-type    as character no-undo .
      406     define input-output parameter p-data-type     as character no-undo .
      407     define input-output parameter p-param-name    as character no-undo .
      408     define input-output parameter p-attach-type   as character no-undo .
      409     define input-output parameter p-list-value    as character no-undo .
      410     define input-output parameter p-default-value as character no-undo .
      411     define input-output parameter p-param-PS      as character no-undo .
      412     define input-output parameter p-param-group   as character no-undo .
      413     define input-output parameter p-user-resp     as character no-undo .
      414     do
      415     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      416     on stop   undo, return error substitute( "&1. stop", vss-include-info1 )
      417     on endkey undo, return error substitute( "&1. endkey", vss-include-info1 )
      418     :
      419       define variable v-ind as character no-undo .
      420       assign
      421         p-param-code    = trim( p-param-code )
      422         p-param-type    = trim( p-param-type )
      423         p-data-type     = trim( p-data-type )
      424         p-param-name    = trim( p-param-name )
      425         p-attach-type   = trim( p-attach-type )
      426         p-list-value    = trim( p-list-value )
      427         p-default-value = trim( p-default-value )
      428         p-param-PS      = trim( p-param-PS )
      429         p-param-group   = trim( p-param-group )
      430         p-user-resp     = trim( p-user-resp )
      431       .
      432       if p-param-code = "":U then do:
      433         undo, return error substitute( "&1. Не задана метка параметра", vss-include-info1 ).
      434       end.
      435       if length( p-param-code ) > 8 then do:
      436         undo, return error substitute( "&1. Длина метки параметра не может превышать 8 символов (&2)", vss-include-info1, p-param-code ).
      437       end.
      438       if lookup( p-param-type, ',о,к,п':U ) = 0 then do:
      439         undo, return error substitute( '&1. Значение типа настройки "&2" не допустимо (&3)', vss-include-info1, p-param-type, p-param-code ).
      440       end.
      441       if lookup( p-param-type, 'к,п':U ) <> 0
      442         and lookup( p-attach-type, 'Нет':U ) = 0
      443       then do:
      444         undo, return error substitute( '&1. Для параметров с типом "&2" допустимы только привязки "&3" (&4)', vss-include-info1, 'к,п':U, 'Нет':U, p-param-code ).
      445       end.
      446       if p-param-name = "":U then do:
      447         undo, return error substitute( "&1. Не задано название параметра &2", vss-include-info1, p-param-code  ).
      448       end.
      449       if lookup( entry( 1, p-data-type ), "logical,integer,decimal,date,character":U ) = 0
      450         or num-entries( p-data-type ) > 2
      451         or ( num-entries( p-data-type ) = 2
      452              and entry( 2, p-data-type ) <> "list":U
      453            )
      454       then do:
      455         undo, return error substitute( "&1. Значение типа параметра &2 не допустимо (&3)", vss-include-info1, p-data-type, p-param-code ).
      456       end.
      457       if lookup( p-attach-type, 'Нет,Фирма,Объект':U ) = 0
      458       then do:
      459         undo, return error substitute( '&1. Значение привязки "&2" не допустимо (&3)', vss-include-info1, p-attach-type, p-param-code ).
      460       end.
      461     end.
      462     return.
      463   end procedure.
      464   procedure fill-cnf-struct :
      465     define input parameter p-file-name as character no-undo .
      466     do
      467     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      468     on stop   undo, return error substitute( "&1. stop", vss-workfile )
      469     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      470     :
      471       define variable v-file-name as character no-undo .
      472       define variable v-counter as integer   no-undo .
      473       define variable v-temp-fname       as character           no-undo.
      474       define variable v-last-key         as integer             no-undo .
      475       define variable v-new-line         as integer             no-undo .
      476       define variable v-read-chksum      as logical             no-undo .
      477       define variable v-md5-signature-av as character           no-undo .
      478       define variable v-md5-signature    as character           no-undo .
      479       define frame inf-cfg
      480         v-counter label "Просмотрено"
      481         with view-as dialog-box side-labels 1 columns three-d title ""
      482       .
      483       assign
      484         v-file-name = search( p-file-name )
      485       .
      486       if v-file-name = ""
      487         or v-file-name = ?
      488       then do:
      489         return error substitute( "&1. Не задан файл схемы конфигурации!", vss-include-info1 ).
      490       end.
      491       assign
      492         v-last-key         = 0
      493         v-read-chksum      = false
      494         v-md5-signature-av = "":U
      495         file-info:file-name = ".":U
      496         v-temp-fname = substitute( "&1\&2-&3-&4.tmp", file-info:full-pathname, time, etime, random( 1111111 , 9999999 ) )
      497       .
      498       input stream TxtStream from value( v-file-name ).
      499       output stream temp-stream to value(v-temp-fname) .
      500       block_read:
      501       repeat while v-last-key <> -2
      502       on error undo, return error
      503       :
      504         readkey stream TxtStream pause 0.
      505         assign
      506           v-last-key = lastkey
      507         .
      508         if chr( v-last-key ) = chr(1) then do:
      509           assign
      510             v-read-chksum = true
      511           .
      512         end.
      513         else do:
      514           if v-read-chksum = true then do:
      515             if v-last-key = 13 then do:
      516               leave block_read.
      517             end.
      518             else do:
      519               assign
      520                 v-md5-signature-av = v-md5-signature-av + chr( v-last-key )
      521               .
      522             end.
      523           end.
      524           else do:
      525             if v-last-key = 13 then do:
      526               put stream temp-stream skip(v-new-line).
      527               assign
      528                 v-new-line = 1
      529               .
      530             end.
      531             else do:
      532               put stream temp-stream unformatted chr( v-last-key ).
      533               assign
      534                 v-new-line = 0
      535               .
      536             end.
      537           end.
      538         end.
      539       end.
      540       output stream temp-stream close.
      541       input stream TxtStream close.
      542       run gbl/md5.p
      543         ( input  search( v-temp-fname )
      544          ,output v-md5-signature
      545         ) no-error.
      546       if error-status :error then do:
      547         return error substitute("Ошибка при подсчете контрольной суммы текстового файла схемы &1", v-file-name ) .
      548       end.
      549       os-delete value( v-temp-fname ).
      550       assign
      551         v-md5-signature = sum-enc( v-md5-signature, 8 )
      552       .
      553       if v-md5-signature-av <> v-md5-signature then do:
      554         return error substitute( "Некорректная контрольная сумма текстового файла схемы &1", v-file-name ) .
      555       end.
      556       input stream TxtStream from value( v-file-name ).
      557       assign
      558         v-counter = 0
      559       .
      560       assign
      561         frame inf-cfg:title = "Чтение параметров конфигурации"
      562       .
      563       view frame inf-cfg.
      564       for each t_cnf-struct:
      565         delete t_cnf-struct.
      566       end.
      567       create t_cnf-struct no-error.
      568       read-cycle:
      569       repeat transaction
      570       on error  undo, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      571       :
      572         assign
      573           v-counter = v-counter + 1
      574         .
      575         if ( v-counter modulo 10 ) = 0 then do:
      576           display
      577             v-counter
      578             with frame inf-cfg.
      579         end.
      580         import stream TxtStream delimiter '`':U t_cnf-struct.param-code t_cnf-struct.param-type t_cnf-struct.data-type t_cnf-struct.param-name t_cnf-struct.attach-type t_cnf-struct.list-value t_cnf-struct.default-value t_cnf-struct.PS t_cnf-struct.param-group t_cnf-struct.user-resp no-error.
      581         if error-status:error then do:
      582           return error substitute( "&1. Ошибка при чтении текстового файла схемы! Cтрока &1. (&2)", vss-include-info1, v-counter, error-status :get-message ( error-status :num-messages ) ).
      583         end.
      584         else do:
      585           if not ( t_cnf-struct.param-code begins chr(1) ) then do:
      586             assign
      587               t_cnf-struct.user-resp = decoding-user-resp( t_cnf-struct.param-code, t_cnf-struct.user-resp )
      588             .
      589             if t_cnf-struct.user-resp = "unknown":U then do:
      590               return error substitute( "&1. Ошибка параметра! Cтрока &2.", vss-include-info1, v-counter ).
      591             end.
      592             run check-cfg in this-procedure
      593               ( input-output t_cnf-struct.param-code
      594               ,input-output t_cnf-struct.param-type
      595               ,input-output t_cnf-struct.data-type
      596               ,input-output t_cnf-struct.param-name
      597               ,input-output t_cnf-struct.attach-type
      598               ,input-output t_cnf-struct.list-value
      599               ,input-output t_cnf-struct.default-value
      600               ,input-output t_cnf-struct.PS
      601               ,input-output t_cnf-struct.param-group
      602               ,input-output t_cnf-struct.user-resp
      603               ) no-error .
      604             if error-status :error then do:
      605               return error substitute( "&1. Ошибка параметра! Cтрока &2. &3 (&4)", vss-include-info1, v-counter, return-value, error-status :get-message ( error-status :num-messages ) ).
      606             end.
      607             else do:
      608               find first cnf-struct
      609                 where cnf-struct.param-code = t_cnf-struct.param-code
      610                 no-error
      611               .
      612               if not available cnf-struct then do:
      613                 create cnf-struct .
      614               end.
      615               buffer-copy t_cnf-struct to cnf-struct .
      616             end.
      617           end.
      618         end.
      619       end.
      620       delete t_cnf-struct no-error.
      621       hide frame inf-cfg.
      622       input stream TxtStream close.
      623     end.
      624     return.
      625   end procedure.
      626   def stream txt-file.
      627   def var log-on    as logical   no-undo.
      628   def var mes-on    as logical   no-undo.
      629   def stream log-file.
      630   procedure init.
      631   define input parameter par-logname as character no-undo.
      632   define input parameter par-meson   as logical   no-undo.
      633   define input parameter par-appon   as logical   no-undo.
      634   assign mes-on    = par-meson
      635          log-on    = false.
      636   if par-logname <> "" then do:
      637      if par-appon then
      638         output stream log-file to value (par-logname) append.
      639      else
      640         output stream log-file to value (par-logname).
      641      do on error undo, retry:
      642        if retry then do:
      643           return "2".
      644        end.
      645        put stream log-file unformatted "====" + cur-time-string() + "====" skip.
      646        assign log-on = true.
      647      end.
      648   end.
      649   return.
      650   end procedure.
      651   procedure toggle-mes.
      652   define input parameter par-meson   as logical   no-undo.
      653   assign mes-on    = par-meson.
      654   return.
      655   end procedure.
      656   procedure kill.
      657       output stream log-file close.
      658       delete procedure this-procedure.
      659       return.
      660   end procedure.
      661   procedure kill1.
      662       delete procedure this-procedure.
      663       return.
      664   end procedure.
      665   procedure log-error.
      666   define input parameter par-message as character.
      667   define input parameter par-level   as integer.
      668   case par-level :
      669     when 1 then do:
      670       assign
      671         par-message = substitute( "Замечание: &1", par-message ).
      672       .
      673     end.
      674     when 2 then do:
      675       assign
      676         par-message = substitute( "$Критическая ОШИБКА: &1", par-message ).
      677       .
      678     end.
      679   end case. .
      680   if log-on then do:
      681      put stream log-file unformatted par-message skip.
      682   end.
      683   else do:
      684      create log-table.
      685      log-table.stroka = par-message.
      686   end.
      687   if par-level > 0 and mes-on then message par-message.
      688   err-level = (max(par-level, err-level)).
      689   end procedure.
      690   procedure cnv-param-type.
      691     define input parameter cfg-param-type as character no-undo.
      692     if lookup ("list":U, cfg-param-type) > 0 then
      693       return "C":U.
      694     else if cfg-param-type = "date":U then
      695       return "T":U.
      696     else
      697       return upper(substr(cfg-param-type, 1, 1)).
      698   end procedure.
      699   procedure log-sys-error.
      700     define input parameter par-message as character no-undo.
      701     define variable k as integer no-undo.
      702     if par-message <> "" then do:
      703       run log-error in this-procedure
      704         ( input par-message
      705         ,input 2
      706         ).
      707     end.
      708     do k = 1 to Error-Status:Num-messages:
      709       run log-error in this-procedure
      710         ( input Error-Status:Get-message(k)
      711           ,input 2
      712         ).
      713     end.
      714   end procedure.
