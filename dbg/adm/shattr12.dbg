      618   procedure proc-alt-shift-f2:
      619     if not ibs.th.gbl.gbl-var:rcode
      620   then
      621     run gbl\inidebug.p .
      622   end.
      623   procedure proc-alt-shift-f3:
      624     run gbl/prvssinf.p
      625       ( input this-procedure
      626       ) .
      627   end.
      628   define variable v-inform-launched as logical no-undo initial false .
      629   procedure proc-alt-shift-f4:
      630     define variable v-action as character no-undo .
      631     if v-inform-launched = false then do:
      632       assign
      633         v-inform-launched = true
      634       .
      635       run gbl/d-inform.w
      636         (  input self
      637         ,  input this-procedure
      638         , output v-action
      639         ) no-error .
      640       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      641       assign
      642         v-inform-launched = false
      643       .
      644     end.
      645   end.
      646   procedure proc-alt-f1:
      647     run gbl/corrhelp.p
      648       (input this-procedure
      649       ) .
      650   end .
      651   on alt-shift-f2 anywhere do:
      652     run proc-alt-shift-f2.
      653   end.
      654   on alt-shift-f3 anywhere do:
      655     run proc-alt-shift-f3 in this-procedure .
      656   end.
      657   on alt-shift-f4 anywhere do:
      658     run proc-alt-shift-f4 in this-procedure.
      659   end.
      660   on alt-f1 anywhere do:
      661     run proc-alt-f1 in this-procedure .
      662   end.
      663   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      664     define variable v-cntxt-db-num        as integer   no-undo .
      665     define variable v-cntxt-userid        as character no-undo .
      666     define variable v-cntxt-level         as character no-undo .
      667     define variable v-cntxt-host-code-obj as integer   no-undo .
      668     define variable v-cntxt-obj-type      as character no-undo .
      669     define variable v-cntxt-obj-code      as integer   no-undo .
      670     define variable v-cntxt-db-num-obj    as integer   no-undo .
      671     define variable v-cntxt-is-admin      as logical   no-undo .
      672   DEFINE VARIABLE v-db-num LIKE ub.db.db-num NO-UNDO.
      673   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO.
      674   DEFINE VARIABLE v-to-create AS logical NO-UNDO.
      675   DEFINE VARIABLE v-host-code LIKE ub.shop.host-code NO-UNDO.
      676   DEFINE VARIABLE v-base-code LIKE ub.sysconf.base-code NO-UNDO.
      677   DEFINE VARIABLE v-r-b-code LIKE ub.currency.curr-code NO-UNDO.
      678   DEFINE BUFFER buf_currency FOR ub.currency.
      679   DEFINE BUFFER buf_cash-pay-nal FOR ub.cash-pay.
      680   DEFINE BUFFER buf_cash-pay-ntnl FOR ub.cash-pay.
      681   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      682   define variable v-tth as handle no-undo .
      683   assign
      684   v-tth = buffer thbjattr_thbj-attr:table-handle .
      685   DEFINE BUTTON B-add  NO-FOCUS
      686        LABEL "&Добавить"
      687        SIZE 10 BY 1.
      688   DEFINE BUTTON b-cash-pay-nal
      689        IMAGE-UP FILE "btn-down-arrow":U
      690        IMAGE-DOWN FILE "btn-down-arrow":U
      691        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      692        LABEL "":L
      693        SIZE 3 BY 1
      694        BGCOLOR 8 FGCOLOR 0 .
      695   DEFINE BUTTON b-cash-pay-ntnl
      696        IMAGE-UP FILE "btn-down-arrow":U
      697        IMAGE-DOWN FILE "btn-down-arrow":U
      698        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      699        LABEL "":L
      700        SIZE 3 BY 1
      701        BGCOLOR 8 FGCOLOR 0 .
      702   DEFINE BUTTON b-curr
      703        IMAGE-UP FILE "btn-down-arrow":U
      704        IMAGE-DOWN FILE "btn-down-arrow":U
      705        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      706        LABEL "":L
      707        SIZE 3 BY 1
      708        BGCOLOR 8 FGCOLOR 0 .
      709   DEFINE BUTTON B-del
      710        LABEL "&Удалить"
      711        SIZE 10 BY 1.
      712   DEFINE BUTTON B-exit AUTO-GO
      713        LABEL "&Ввод"
      714        SIZE 10 BY 1
      715        BGCOLOR 8 .
      716   DEFINE BUTTON B-Help
      717        LABEL "Помо&щь"
      718        SIZE 10 BY 1
      719        BGCOLOR 8 .
      720   DEFINE BUTTON b-quit AUTO-END-KEY
      721        LABEL "&Отмена"
      722        SIZE 10 BY 1
      723        BGCOLOR 8 .
      724   DEFINE VARIABLE f-ipcsbasc AS INTEGER FORMAT ">>9":U INITIAL 0
      725        LABEL "Код валюты, соответствующий баз. вал. КАССЫ"
      726        VIEW-AS FILL-IN
      727        SIZE 7 BY 1 NO-UNDO.
      728   DEFINE VARIABLE f-omrnbase AS INTEGER FORMAT ">>9":U INITIAL 0
      729        VIEW-AS FILL-IN
      730        SIZE 7 BY 1 NO-UNDO.
      731   DEFINE VARIABLE f-omrnnal AS INTEGER FORMAT ">>>9":U INITIAL 0
      732        LABEL "с кодом валюты равным коду баз. валюты НА КАССЕ"
      733         VIEW-AS TEXT
      734        SIZE 7 BY .67 NO-UNDO.
      735   DEFINE VARIABLE f-omrnntnl AS INTEGER FORMAT ">>>9":U INITIAL 0
      736        LABEL "с кодом валюты равным коду баз. валюты НА КАССЕ"
      737         VIEW-AS TEXT
      738        SIZE 7 BY .67 NO-UNDO.
      739   DEFINE VARIABLE for-cash-pay-nal AS CHARACTER FORMAT "X(256)":U
      740         VIEW-AS TEXT
      741        SIZE 20.5 BY .67
      742        FGCOLOR 4  NO-UNDO.
      743   DEFINE VARIABLE for-cash-pay-ntnl AS CHARACTER FORMAT "X(256)":U
      744         VIEW-AS TEXT
      745        SIZE 20.5 BY .67
      746        FGCOLOR 4  NO-UNDO.
      747   DEFINE VARIABLE for-curr-name AS CHARACTER FORMAT "X(256)":U
      748         VIEW-AS TEXT
      749        SIZE 6.75 BY .67
      750        FGCOLOR 4  NO-UNDO.
      751   DEFINE VARIABLE l-omrnnal AS CHARACTER FORMAT "X(256)":U INITIAL "Тип кассового платежа, соответствующий оплате <НАЛИЧНЫЕ> НА КАССЕ"
      752         VIEW-AS TEXT
      753        SIZE 65 BY .67 NO-UNDO.
      754   DEFINE VARIABLE l-omrnntnl AS CHARACTER FORMAT "X(256)":U INITIAL "Тип кассового платежа, соответствующий оплате БЕЗНАЛИЧНЫЕ НА КАССЕ"
      755         VIEW-AS TEXT
      756        SIZE 67 BY .67 NO-UNDO.
      757   DEFINE QUERY BR-cash-pay FOR
      758         tt-cash-pay-omrn SCROLLING.
      759   DEFINE BROWSE BR-cash-pay
      760     QUERY BR-cash-pay NO-LOCK DISPLAY
      761         omrn-pay-code COLUMN-LABEL "Код оплаты!на кассе" FORMAT ">>>>9":U
      762         tt-cash-pay-omrn.cdpay-code COLUMN-LABEL "Тип кассового!платежа (в BO)" FORMAT ">>>9":U
      763         tt-cash-pay-omrn.curr-code COLUMN-LABEL "Код!валюты" FORMAT ">>9":U
      764         tt-cash-pay-omrn.obj-name COLUMN-LABEL "Название типа кассового платежа" FORMAT "X(40)":U
      765               WIDTH 56.75
      766       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.25
      767            TITLE "Соответствие кодов оплат на кассе типам кассовых платежей  в BO" EXPANDABLE.
      768   DEFINE FRAME Dialog-Frame
      769        B-add AT ROW 9.75 COL 1
      770        B-exit AT ROW 1 COL 1
      771        b-quit AT ROW 1 COL 11
      772        B-Help AT ROW 1 COL 54.88
      773        f-ipcsbasc AT ROW 2.5 COL 65 COLON-ALIGNED
      774        f-omrnbase AT ROW 2.5 COL 65 COLON-ALIGNED NO-LABEL
      775        b-curr AT ROW 2.5 COL 75
      776        b-cash-pay-nal AT ROW 4.75 COL 70.5
      777        b-cash-pay-ntnl AT ROW 6.75 COL 70.5
      778        B-del AT ROW 9.75 COL 11
      779        BR-cash-pay AT ROW 11.25 COL 1
      780        for-curr-name AT ROW 2.75 COL 77 COLON-ALIGNED NO-LABEL
      781        l-omrnnal AT ROW 4 COL 2 NO-LABEL
      782        f-omrnnal AT ROW 4.92 COL 61 COLON-ALIGNED
      783        for-cash-pay-nal AT ROW 4.92 COL 73.5 COLON-ALIGNED NO-LABEL
      784        l-omrnntnl AT ROW 6 COL 2 NO-LABEL
      785        f-omrnntnl AT ROW 6.92 COL 61 COLON-ALIGNED
      786        for-cash-pay-ntnl AT ROW 7 COL 73.5 COLON-ALIGNED NO-LABEL
      787        SPACE(3.24) SKIP(11.65)
      788       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      789            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      790            TITLE "Параметры POS omron-new"
      791            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      792   ASSIGN
      793          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      794          FRAME Dialog-Frame:HIDDEN           = TRUE.
      795   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      796   DO:
      797     APPLY "END-ERROR":U TO SELF.
      798   END.
      799   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      800   DO:
      801     DEFINE VARIABLE v-value AS CHARACTER NO-UNDO.
      802     DEFINE VARIABLE v-log AS logical NO-UNDO.
      803     DEFINE variable v-rid AS RECID NO-UNDO.
      804     DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      805     DEFINE BUFFER buf_tt-cash-pay-omrn FOR tt-cash-pay-omrn.
      806     DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
      807     define variable ii as integer no-undo .
      808     define variable ii-max as integer no-undo .
      809     find last buf_tt-cash-pay-omrn use-index pi no-error .
      810     if available buf_tt-cash-pay-omrn then do:
      811       assign
      812       ii-max = buf_tt-cash-pay-omrn.omrn-pay-code
      813       .
      814     end.
      815     do ii = 1 to MAX(ii-max, 12):
      816       find first buf_tt-cash-pay-omrn where
      817                 buf_tt-cash-pay-omrn.omrn-pay-code = ii no-error.
      818       if not available buf_tt-cash-pay-omrn then leave.
      819     end.
      820     if available buf_tt-cash-pay-omrn then do:
      821       message
      822       "Все соответствия уже заданы"
      823       view-as alert-box error .
      824       return no-apply.
      825     end.
      826      run ref/cashpays.w (
      827                  input parparentproc
      828                 ,input  "b-sel":U
      829                 ,input 'все':U
      830                 ,input (if p-obj-type = 'орг':U then p-obj-code else v-host-code)
      831                 ,input (if p-obj-type = 'орг':U then '':U else p-obj-type)
      832                 ,input (if p-obj-type = 'орг':U then 0 else p-obj-code)
      833                 ,OUTPUT v-rid-list) NO-ERROR.
      834   IF ERROR-STATUS:ERROR OR v-rid-list = "":U  THEN RETURN no-apply.
      835   FIND FIRST buf_cash-pay NO-LOCK WHERE
      836           RECID(buf_cash-pay) = INTEGER(ENTRY(1, v-rid-list)) NO-ERROR.
      837   IF NOT AVAILABLE buf_cash-pay  THEN RETURN NO-APPLY.
      838   CREATE tt-cash-pay-omrn.
      839   BUFFER-COPY buf_cash-pay
      840      TO tt-cash-pay-omrn
      841      ASSIGN
      842      tt-cash-pay-omrn.omrn-pay-code = ii
      843      v-rid = RECID(tt-cash-pay-omrn)
      844      .
      845      RUN openbr IN THIS-PROCEDURE.
      846      REPOSITION br-cash-pay TO RECID v-rid.
      847   END.
      848   ON CHOOSE OF b-cash-pay-nal IN FRAME Dialog-Frame
      849   DO:
      850       define variable v-rid-list as character no-undo.
      851       DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
      852       run ref/cashpays.w (
      853                      input parparentproc
      854                     ,input "b-sel"
      855                     ,input 'все':U
      856                     ,input (if p-obj-type = 'орг':U then p-obj-code else v-host-code)
      857                     ,input (if p-obj-type = 'орг':U then '':U else p-obj-type)
      858                     ,input (if p-obj-type = 'орг':U then 0 else p-obj-code)
      859                     ,output v-rid-list ).
      860       if v-rid-list <> "":U then do:
      861         FIND FIRST buf_cash-pay WHERE
      862                   recid( buf_cash-pay ) = integer(entry(1, v-rid-list)) NO-LOCK .
      863         IF buf_cash-pay.curr-code <> 0
      864         and buf_cash-pay.curr-code <> v-r-b-code THEN DO:
      865             MESSAGE
      866             substitute("Нужно выбрать тип кассового платежа с валютой &1 (&2) или &3 (валюта продажи на фирме &4)"
      867                         ,0
      868                         ,"руб"
      869                         ,buf_currency.curr-code
      870                        , v-host-code)
      871             VIEW-AS ALERT-BOX ERROR.
      872             RETURN NO-APPLY.
      873         END.
      874         DISPLAY
      875         buf_cash-pay.cdpay-code @ f-omrnnal
      876         buf_cash-pay.obj-name @ for-cash-pay-nal
      877         with frame Dialog-Frame .
      878       end.
      879   END.
      880   ON CHOOSE OF b-cash-pay-ntnl IN FRAME Dialog-Frame
      881   DO:
      882       define variable v-rid-list as character no-undo.
      883       DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
      884       run ref/cashpays.w (
      885                      input parparentproc
      886                     ,input "b-sel"
      887                     ,input 'все':U
      888                     ,input (if p-obj-type = 'орг':U then p-obj-code else v-host-code)
      889                     ,input (if p-obj-type = 'орг':U then '':U else p-obj-type)
      890                     ,input (if p-obj-type = 'орг':U then 0 else p-obj-code)
      891                     ,output v-rid-list ).
      892       if v-rid-list <> "":U then do:
      893         FIND FIRST buf_cash-pay WHERE
      894                   recid( buf_cash-pay ) = integer(entry(1, v-rid-list)) NO-LOCK .
      895         IF buf_cash-pay.curr-code <> 0
      896         and buf_cash-pay.curr-code <> v-r-b-code THEN DO:
      897             MESSAGE
      898             substitute("Нужно выбрать тип кассового платежа с валютой &1 (&2) или &3 (валюта продажи на фирме &4)"
      899                         ,0
      900                         ,"руб"
      901                         ,buf_currency.curr-code
      902                        , v-host-code)
      903             VIEW-AS ALERT-BOX ERROR.
      904             RETURN NO-APPLY.
      905         END.
      906         DISPLAY
      907         buf_cash-pay.cdpay-code @ f-omrnntnl
      908         buf_cash-pay.obj-name @ for-cash-pay-ntnl
      909         with frame Dialog-Frame .
      910       end.
      911   END.
      912   ON CHOOSE OF b-curr IN FRAME Dialog-Frame
      913   DO:
      914       define variable rr as recid no-undo.
      915       DEFINE BUFFER buf_currency FOR ub.currency.
      916       rr = ? .
      917       run ref/currency.w (input parparentproc, "b-sel", input-output rr ).
      918       if rr <> ? then do:
      919         FIND FIRST buf_currency WHERE
      920                   recid( buf_currency ) = rr NO-LOCK .
      921         DISPLAY
      922         buf_currency.curr-code @ f-omrnbase
      923         buf_currency.curr-abbr @ for-curr-name
      924         with frame Dialog-Frame .
      925       end.
      926   END.
      927   ON CHOOSE OF B-del IN FRAME Dialog-Frame
      928   DO:
      929     IF NOT AVAILABLE tt-cash-pay-omrn THEN RETURN NO-APPLY.
      930     DELETE tt-cash-pay-omrn.
      931     RUN openbr IN THIS-PROCEDURE.
      932     REPOSITION br-cash-pay TO ROW 1.
      933   END.
      934   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      935   DO:
      936     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      937     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      938   END.
      939   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      940   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      941   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      942   on help of frame Dialog-Frame
      943   do:
      944     run gbl/app_help.p
      945       (input this-procedure :file-name
      946       ,input ''
      947       ,input ?
      948       ) no-error.
      949     if error-status :error then do:
      950       message
      951         "Ошибка при вызове помощи"
      952         error-status :get-message(1)
      953         view-as alert-box .
      954     end.
      955   end.
      956   run minbtn-set in this-procedure .
      957   on choose of b-help in frame Dialog-Frame
      958   do:
      959     apply "help":u to frame Dialog-Frame .
      960   end.
      961   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      962   procedure minbtn-set :
      963       do
      964           on error undo, return error return-value
      965           :
      966           define variable ii              as integer       no-undo .
      967           define variable fh              as widget-handle no-undo .
      968           define variable hh              as widget-handle no-undo .
      969           define variable v-h             as handle        extent 4 no-undo .
      970           define variable v-name-button   as character     no-undo .
      971           define variable v-help-old-x    as decimal       no-undo .
      972           define variable v-help-old-y    as decimal       no-undo .
      973           define variable v-help-old-size as decimal       no-undo .
      974           define variable v-frame-width   as decimal       no-undo .
      975           define variable jj              as integer       no-undo .
      976           do
      977               on error undo, return error
      978               :
      979               assign
      980                   v-frame-width = frame Dialog-Frame:width - 0.3
      981                   fh            = frame Dialog-Frame:first-child
      982                   hh            = fh:first-child
      983                   ii            = 1
      984                   .
      985               do while valid-handle(hh):
      986                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      987                   do:
      988                       case lc(hh:name) :
      989                           when "b-help" then
      990                               do:
      991                                   hh:load-image-up("cmp/b-help.bmp":u) .
      992                                   hh:load-image-down("cmp/b-help.bmp":u) .
      993                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      994                                   hh:TOOLTIP = "Помощь" .
      995                                   v-help-old-x = hh:column .
      996                                   v-help-old-y = hh:row    .
      997                                   v-help-old-size = hh:width .
      998                                   hh:width-chars = 2.5 .
      999                               end.
     1000                           when "b-print" then
     1001                               do:
     1002                                   hh:load-image("cmp/b-print.bmp":u) .
     1003                                   hh:TOOLTIP = "Печать" .
     1004                                   v-h[ii] = hh:handle .
     1005                                   ii = ii + 1 .
     1006                                   hh:width-chars = 3 .
     1007                               end.
     1008                           when "b-history" or
     1009                           when "b-hist" then
     1010                               do:
     1011                                   hh:load-image("cmp/b-hist.bmp":u) .
     1012                                   hh:TOOLTIP = "История" .
     1013                                   v-h[ii] = hh:handle .
     1014                                   ii = ii + 1 .
     1015                                   hh:width-chars = 3 .
     1016                               end.
     1017                           when "b-sch" then
     1018                               do:
     1019                                   hh:load-image("cmp/b-sch.bmp":u) .
     1020                                   hh:TOOLTIP = "Установка Фильтра" .
     1021                                   v-h[ii] = hh:handle .
     1022                                   ii = ii + 1 .
     1023                                   hh:width-chars = 3 .
     1024                               end.
     1025                           when "b-hist-user" then
     1026                               do:
     1027                                   hh:load-image("cmp/b-hist.bmp":u) .
     1028                                   hh:TOOLTIP = "История пользователя" .
     1029                                   ii = ii + 1 .
     1030                               end.
     1031                       end case.
     1032                   end.
     1033                   hh = hh:next-sibling.
     1034               end.
     1035               b-help:column = v-frame-width - b-help:width-chars.
     1036               jj = 0.
     1037               repeat ii = 4 to 1 by -1 :
     1038                   if valid-handle (v-h[ii] ) then
     1039                   do:
     1040                       jj  = jj + 1 .
     1041                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1042                       v-h[ii]:row    = v-help-old-y .
     1043                   end.
     1044               end.
     1045           end.
     1046       end.
     1047   end procedure.
     1048   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1049   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1050   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1051   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1052   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1053   define variable v-diasize-current-frame-height as decimal   no-undo .
     1054   define variable v-diasize-change-size          as logical   no-undo .
     1055   define variable v-diasize-resize-button        as handle    no-undo .
     1056   define variable v-diasize-wndmax               as logical   no-undo .
     1057   define variable v-diasize-wndstore             as logical   no-undo .
     1058   define variable v-diasize-proc-name            as character no-undo .
     1059   define variable v-diasize-browse-handle        as handle    no-undo .
     1060   define variable v-diasize-browse-number        as integer   no-undo .
     1061   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1062   define temp-table temp-diasize-handle no-undo
     1063     field handle-value  as handle
     1064     field save-position as decimal
     1065     index xpk is primary unique handle-value
     1066     .
     1067   define temp-table temp-browse-handle no-undo
     1068     field browse-type   as character
     1069     field browse-number as integer
     1070     field browse-handle as handle
     1071     field original-size as decimal
     1072     index xpk is primary unique browse-type browse-number
     1073     index xie browse-type browse-handle
     1074   .
     1075   procedure diasize_change-height :
     1076     define input  parameter p-change-value  as decimal   no-undo .
     1077     define input  parameter p-move-resize   as logical   no-undo .
     1078     define variable v-field-group-handle    as handle    no-undo .
     1079     define variable v-object-handle         as handle    no-undo .
     1080     define variable v-frame-height          as decimal   no-undo .
     1081     define variable v-frame-virtual-height  as decimal   no-undo .
     1082     define variable v-browse-height         as decimal   no-undo .
     1083     define variable v-window-height         as decimal   no-undo .
     1084     define variable v-window-virtual-height as decimal   no-undo .
     1085     define variable v-change-sign           as integer   no-undo .
     1086     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1087     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1088     if p-change-value > 0
     1089     then do:
     1090       if frame Dialog-Frame :height + p-change-value
     1091           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1092       then do:
     1093         assign
     1094           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1095                           - (frame Dialog-Frame :height-chars)
     1096         .
     1097         if p-change-value <= 0
     1098         then do:
     1099           run diasize_position-resize-button in this-procedure .
     1100           return .
     1101         end.
     1102       end.
     1103     end.
     1104     if p-change-value < 0
     1105     then do:
     1106       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1107       then do:
     1108         assign
     1109           p-change-value = v-diasize-orig-frame-height
     1110                          - (frame Dialog-Frame :height-chars)
     1111         .
     1112         if p-change-value >= 0
     1113         then do:
     1114           run diasize_position-resize-button in this-procedure .
     1115           return .
     1116         end.
     1117       end.
     1118     end.
     1119     if p-change-value >= 0
     1120     then do:
     1121       assign
     1122         v-change-sign = 1
     1123       .
     1124     end.
     1125     else do:
     1126       assign
     1127         v-change-sign = -1
     1128       .
     1129     end.
     1130     assign
     1131       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1132     .
     1133     if p-change-value = 0
     1134     then do:
     1135       run diasize_position-resize-button in this-procedure .
     1136       return .
     1137     end.
     1138     move_block:
     1139     do
     1140     on error undo move_block, retry move_block
     1141     :
     1142       if retry
     1143       then do:
     1144         do
     1145         on error undo move_block, leave move_block
     1146         :
     1147           if p-change-value > 0
     1148           then do:
     1149             for each buf_temp-diasize-handle
     1150             on error undo, next
     1151             :
     1152               assign
     1153                 v-object-handle = buf_temp-diasize-handle.handle-value
     1154               .
     1155               if v-object-handle <> v-diasize-resize-button
     1156               then do:
     1157                 assign
     1158                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1159                 .
     1160               end.
     1161             end.
     1162             assign
     1163               v-diasize-browse-handle :height = v-browse-height
     1164             .
     1165             for each buf_temp-browse-handle
     1166               where buf_temp-browse-handle.browse-type = 'height':u
     1167             on error undo, next
     1168             :
     1169               assign
     1170                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1171               .
     1172             end.
     1173             assign
     1174               frame Dialog-Frame :height = v-frame-height
     1175             .
     1176             if frame Dialog-Frame :scrollable = true
     1177             then do:
     1178               assign
     1179                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1180               .
     1181             end.
     1182             run diasize_position-resize-button in this-procedure .
     1183           end.
     1184           else do:
     1185             if frame Dialog-Frame :scrollable = true
     1186             then do:
     1187               assign
     1188                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1189               .
     1190             end.
     1191             assign
     1192               frame Dialog-Frame :height = v-frame-height
     1193             .
     1194             assign
     1195               v-diasize-browse-handle :height = v-browse-height
     1196             .
     1197             for each buf_temp-browse-handle
     1198               where buf_temp-browse-handle.browse-type = 'height':u
     1199             on error undo, next
     1200             :
     1201               assign
     1202                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1203               .
     1204             end.
     1205             for each buf_temp-diasize-handle
     1206             on error undo, next
     1207             :
     1208               assign
     1209                 v-object-handle = buf_temp-diasize-handle.handle-value
     1210               .
     1211               if v-object-handle <> v-diasize-resize-button
     1212               then do:
     1213                 assign
     1214                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1215                 .
     1216               end.
     1217             end.
     1218             run diasize_position-resize-button in this-procedure .
     1219           end.
     1220           assign
     1221             v-diasize-change-size = false
     1222           .
     1223           leave move_block .
     1224         end.
     1225       end.
     1226       assign
     1227         v-diasize-need-full-display = true
     1228       .
     1229       if v-diasize-change-size = false
     1230       then do:
     1231         assign
     1232           v-diasize-change-size = true
     1233         .
     1234       end.
     1235       else do:
     1236         return .
     1237       end.
     1238       assign
     1239         v-frame-height = frame Dialog-Frame :height
     1240         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1241         v-browse-height = v-diasize-browse-handle :height
     1242       .
     1243       for each buf_temp-browse-handle
     1244         where buf_temp-browse-handle.browse-type = 'height':u
     1245       :
     1246         assign
     1247           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1248         .
     1249       end.
     1250       for each buf_temp-diasize-handle
     1251       :
     1252         delete buf_temp-diasize-handle .
     1253       end.
     1254       assign
     1255         v-field-group-handle = frame Dialog-Frame :first-child
     1256       .
     1257       do while valid-handle(v-field-group-handle)
     1258       :
     1259         assign
     1260           v-object-handle = v-field-group-handle :first-child
     1261         .
     1262         do while valid-handle(v-object-handle)
     1263         :
     1264           if  v-object-handle <> v-diasize-browse-handle :handle
     1265           and can-query(v-object-handle, "row")
     1266           and can-query(v-object-handle, "height")
     1267           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1268           then do:
     1269             find first buf_temp-browse-handle
     1270               where buf_temp-browse-handle.browse-type   = 'height':u
     1271                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1272               no-error .
     1273             if available buf_temp-browse-handle
     1274             then do:
     1275             end.
     1276             else do:
     1277               create buf_temp-diasize-handle .
     1278               assign
     1279                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1280                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1281               .
     1282             end.
     1283           end.
     1284           assign
     1285             v-object-handle = v-object-handle :next-sibling
     1286           .
     1287         end.
     1288         assign
     1289           v-field-group-handle = v-field-group-handle :next-sibling
     1290         .
     1291       end.
     1292       do with frame Dialog-Frame
     1293       :
     1294         hide v-diasize-resize-button .
     1295         assign
     1296           v-diasize-resize-button :row    = 1
     1297           v-diasize-resize-button :column = 1
     1298         .
     1299       end.
     1300       if p-change-value > 0
     1301       then do:
     1302         if frame Dialog-Frame :scrollable = true
     1303         then do:
     1304           assign
     1305             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1306             no-error .
     1307           if error-status :error
     1308           or error-status :get-message(1) <> ""
     1309           then do:
     1310             undo move_block, retry move_block .
     1311           end.
     1312         end.
     1313         assign
     1314           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1315           no-error .
     1316         if error-status :error
     1317         or error-status :get-message(1) <> ""
     1318         then do:
     1319           undo move_block, retry move_block .
     1320         end.
     1321         assign
     1322           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1323           no-error .
     1324         if error-status :error
     1325         or error-status :get-message(1) <> ""
     1326         then do:
     1327           undo move_block, retry move_block .
     1328         end.
     1329         for each buf_temp-browse-handle
     1330           where buf_temp-browse-handle.browse-type = 'height':u
     1331         on error undo move_block, retry move_block
     1332         :
     1333           assign
     1334             buf_temp-browse-handle.browse-handle :height
     1335               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1336             no-error .
     1337           if error-status :error
     1338           or error-status :get-message(1) <> ""
     1339           then do:
     1340             undo move_block, retry move_block .
     1341           end.
     1342         end.
     1343         for each buf_temp-diasize-handle
     1344         on error undo move_block, retry move_block
     1345         :
     1346           assign
     1347             v-object-handle = buf_temp-diasize-handle.handle-value
     1348           .
     1349           if v-object-handle <> v-diasize-resize-button
     1350           then do:
     1351             assign
     1352               v-object-handle :row = v-object-handle :row + p-change-value
     1353               no-error .
     1354             if error-status :error
     1355             or error-status :get-message(1) <> ""
     1356             then do:
     1357               undo move_block, retry move_block .
     1358             end.
     1359           end.
     1360         end.
     1361       end.
     1362       else do:
     1363         for each buf_temp-diasize-handle
     1364         on error undo move_block, retry move_block
     1365         :
     1366           assign
     1367             v-object-handle = buf_temp-diasize-handle.handle-value
     1368           .
     1369           if v-object-handle <> v-diasize-resize-button
     1370           then do:
     1371             assign
     1372               v-object-handle :row = v-object-handle :row + p-change-value
     1373               no-error .
     1374             if error-status :error
     1375             or error-status :get-message(1) <> ""
     1376             then do:
     1377               undo move_block, retry move_block .
     1378             end.
     1379           end.
     1380         end.
     1381         assign
     1382           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1383           no-error .
     1384         if error-status :error
     1385         or error-status :get-message(1) <> ""
     1386         then do:
     1387           undo move_block, retry move_block .
     1388         end.
     1389         for each buf_temp-browse-handle
     1390           where buf_temp-browse-handle.browse-type = 'height':u
     1391         on error undo move_block, retry move_block
     1392         :
     1393           assign
     1394             buf_temp-browse-handle.browse-handle :height
     1395               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1396             no-error .
     1397           if error-status :error
     1398           or error-status :get-message(1) <> ""
     1399           then do:
     1400             undo move_block, retry move_block .
     1401           end.
     1402         end.
     1403         assign
     1404           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1405           no-error .
     1406         if error-status :error
     1407         or error-status :get-message(1) <> ""
     1408         then do:
     1409           undo move_block, retry move_block .
     1410         end.
     1411         if frame Dialog-Frame :scrollable = true
     1412         then do:
     1413           assign
     1414             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1415             no-error .
     1416           if error-status :error
     1417           or error-status :get-message(1) <> ""
     1418           then do:
     1419             undo move_block, retry move_block .
     1420           end.
     1421         end.
     1422       end.
     1423       if p-move-resize = true
     1424       then do:
     1425         run diasize_position-resize-button in this-procedure .
     1426       end.
     1427       if v-diasize-wndstore = true
     1428       then do:
     1429         if connected("ub") = true
     1430         then do:
     1431           define variable v-cntxt-db-num        as integer   no-undo .
     1432           define variable v-cntxt-userid        as character no-undo .
     1433           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1434                                             , OUTPUT v-cntxt-userid
     1435                                             ) .
     1436           run gbl/wndsizew.p
     1437             (input  v-cntxt-db-num
     1438             ,input  v-cntxt-userid
     1439             ,input  v-diasize-proc-name
     1440             ,input  'height':u
     1441             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1442             ) .
     1443         end.
     1444       end.
     1445     end.
     1446     assign
     1447       v-diasize-change-size = false
     1448     .
     1449   end procedure.
     1450   procedure diasize_set-height :
     1451     define input  parameter p-new-height  as decimal   no-undo .
     1452     define input  parameter p-move-resize as logical   no-undo .
     1453     do
     1454     on error undo, return error return-value
     1455     :
     1456       run diasize_change-height in this-procedure
     1457         (input  (p-new-height - frame Dialog-Frame :height)
     1458         ,input  p-move-resize
     1459         ) .
     1460     end.
     1461   end procedure.
     1462   procedure diasize_change-width :
     1463     define input  parameter p-change-value as decimal   no-undo .
     1464     define input  parameter p-move-resize  as logical   no-undo .
     1465     define variable v-field-group-handle   as handle    no-undo .
     1466     define variable v-object-handle        as handle    no-undo .
     1467     define variable v-frame-width          as decimal   no-undo .
     1468     define variable v-frame-virtual-width  as decimal   no-undo .
     1469     define variable v-browse-width         as decimal   no-undo .
     1470     define variable v-window-width         as decimal   no-undo .
     1471     define variable v-window-virtual-width as decimal   no-undo .
     1472     define variable v-change-sign          as integer   no-undo .
     1473     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1474     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1475     if p-change-value > 0
     1476     then do:
     1477       if frame Dialog-Frame :width + p-change-value >
     1478           session :width-chars
     1479       then do:
     1480         assign
     1481           p-change-value = session :width-chars - frame Dialog-Frame :width
     1482         .
     1483         if p-change-value <= 0
     1484         then do:
     1485           run diasize_position-resize-button in this-procedure .
     1486           return .
     1487         end.
     1488       end.
     1489     end.
     1490     if p-change-value < 0
     1491     then do:
     1492       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1493       then do:
     1494         assign
     1495           p-change-value = v-diasize-orig-frame-width
     1496                          - frame Dialog-Frame :width
     1497         .
     1498         if p-change-value >= 0
     1499         then do:
     1500           run diasize_position-resize-button in this-procedure .
     1501           return .
     1502         end.
     1503       end.
     1504     end.
     1505     if p-change-value >= 0
     1506     then do:
     1507       assign
     1508         v-change-sign = 1
     1509       .
     1510     end.
     1511     else do:
     1512       assign
     1513         v-change-sign = -1
     1514       .
     1515     end.
     1516     assign
     1517       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1518     .
     1519     if p-change-value = 0
     1520     then do:
     1521       run diasize_position-resize-button in this-procedure .
     1522       return .
     1523     end.
     1524     move_block:
     1525     do
     1526     on error undo move_block, leave move_block
     1527     :
     1528       if retry
     1529       then do:
     1530         do
     1531         on error undo move_block, leave move_block
     1532         :
     1533           if p-change-value > 0
     1534           then do:
     1535             for each buf_temp-diasize-handle
     1536             on error undo, next
     1537             :
     1538               assign
     1539                 v-object-handle = buf_temp-diasize-handle.handle-value
     1540               .
     1541               if v-object-handle <> v-diasize-resize-button
     1542               then do:
     1543                 assign
     1544                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1545                 .
     1546               end.
     1547             end.
     1548             assign
     1549               v-diasize-browse-handle :width = v-browse-width
     1550             .
     1551             for each buf_temp-browse-handle
     1552               where buf_temp-browse-handle.browse-type = 'width':u
     1553             on error undo, next
     1554             :
     1555               assign
     1556                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1557               .
     1558             end.
     1559             assign
     1560               frame Dialog-Frame :width = v-frame-width
     1561             .
     1562             if frame Dialog-Frame :scrollable = true
     1563             then do:
     1564               assign
     1565                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1566               .
     1567             end.
     1568             run diasize_position-resize-button in this-procedure .
     1569           end.
     1570           else do:
     1571             if frame Dialog-Frame :scrollable = true
     1572             then do:
     1573               assign
     1574                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1575               .
     1576             end.
     1577             assign
     1578               frame Dialog-Frame :width = v-frame-width
     1579             .
     1580             for each buf_temp-browse-handle
     1581               where buf_temp-browse-handle.browse-type = 'width':u
     1582             on error undo, next
     1583             :
     1584               assign
     1585                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1586               .
     1587             end.
     1588             assign
     1589               v-diasize-browse-handle :width = v-browse-width
     1590             .
     1591             for each buf_temp-diasize-handle
     1592             on error undo, next
     1593             :
     1594               assign
     1595                 v-object-handle = buf_temp-diasize-handle.handle-value
     1596               .
     1597               if v-object-handle <> v-diasize-resize-button
     1598               then do:
     1599                 assign
     1600                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1601                 .
     1602               end.
     1603             end.
     1604             run diasize_position-resize-button in this-procedure .
     1605           end.
     1606           assign
     1607             v-diasize-change-size = false
     1608           .
     1609           leave move_block .
     1610         end.
     1611       end.
     1612       assign
     1613         v-diasize-need-full-display = true
     1614       .
     1615       if v-diasize-change-size = false
     1616       then do:
     1617         assign
     1618           v-diasize-change-size = true
     1619         .
     1620       end.
     1621       else do:
     1622         return .
     1623       end.
     1624       assign
     1625         v-frame-width = frame Dialog-Frame :width
     1626         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1627         v-browse-width = v-diasize-browse-handle :width
     1628       .
     1629       for each buf_temp-browse-handle
     1630         where buf_temp-browse-handle.browse-type = 'width':u
     1631       :
     1632         assign
     1633           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1634         .
     1635       end.
     1636       for each buf_temp-diasize-handle
     1637       :
     1638         delete buf_temp-diasize-handle .
     1639       end.
     1640       assign
     1641         v-field-group-handle = frame Dialog-Frame :first-child
     1642       .
     1643       do while valid-handle(v-field-group-handle)
     1644       :
     1645         assign
     1646           v-object-handle = v-field-group-handle :first-child
     1647         .
     1648         do while valid-handle(v-object-handle)
     1649         :
     1650           if  v-object-handle <> v-diasize-browse-handle :handle
     1651           and v-object-handle <> v-diasize-resize-button
     1652           and can-query(v-object-handle, "row")
     1653           and can-query(v-object-handle, "height")
     1654           and ( v-object-handle :col + v-object-handle :width
     1655                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1656               )
     1657           then do:
     1658             find first buf_temp-browse-handle
     1659               where buf_temp-browse-handle.browse-type   = 'width':u
     1660                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1661               no-error .
     1662             if available buf_temp-browse-handle
     1663             then do:
     1664             end.
     1665             else do:
     1666               create buf_temp-diasize-handle .
     1667               assign
     1668                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1669                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1670               .
     1671             end.
     1672           end.
     1673           assign
     1674             v-object-handle = v-object-handle :next-sibling
     1675           .
     1676         end.
     1677         assign
     1678           v-field-group-handle = v-field-group-handle :next-sibling
     1679         .
     1680       end.
     1681       do with frame Dialog-Frame
     1682       :
     1683         hide v-diasize-resize-button .
     1684         v-diasize-resize-button :row = 1.
     1685         v-diasize-resize-button :column = 1.
     1686       end.
     1687       if p-change-value > 0
     1688       then do:
     1689         if frame Dialog-Frame :scrollable = true
     1690         then do:
     1691           assign
     1692             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1693             no-error .
     1694           if error-status :error
     1695           or error-status :get-message(1) <> ""
     1696           then do:
     1697             undo move_block, retry move_block.
     1698           end.
     1699         end.
     1700         assign
     1701           frame Dialog-Frame :width = v-frame-width + p-change-value
     1702           no-error .
     1703         if error-status :error
     1704         or error-status :get-message(1) <> ""
     1705         then do:
     1706           undo move_block, retry move_block.
     1707         end.
     1708         assign
     1709           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1710         no-error .
     1711         if error-status :error
     1712         or error-status :get-message(1) <> ""
     1713         then do:
     1714           undo move_block, retry move_block.
     1715         end.
     1716         for each buf_temp-browse-handle
     1717           where buf_temp-browse-handle.browse-type = 'width':u
     1718         on error undo move_block, retry move_block
     1719         :
     1720           assign
     1721             buf_temp-browse-handle.browse-handle :width
     1722               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1723             no-error .
     1724           if error-status :error
     1725           or error-status :get-message(1) <> ""
     1726           then do:
     1727             undo move_block, retry move_block .
     1728           end.
     1729         end.
     1730         for each buf_temp-diasize-handle
     1731         on error undo move_block, retry move_block
     1732         :
     1733           assign
     1734             v-object-handle = buf_temp-diasize-handle.handle-value
     1735           .
     1736           if v-object-handle <> v-diasize-resize-button
     1737           then do:
     1738             assign
     1739               v-object-handle :col = v-object-handle :col + p-change-value
     1740               no-error .
     1741             if error-status :error
     1742             or error-status :get-message(1) <> ""
     1743             then do:
     1744               undo move_block, retry move_block .
     1745             end.
     1746           end.
     1747         end.
     1748       end.
     1749       else do:
     1750         for each buf_temp-diasize-handle
     1751         on error undo move_block, retry move_block
     1752         :
     1753           assign
     1754             v-object-handle = buf_temp-diasize-handle.handle-value
     1755           .
     1756           if v-object-handle <> v-diasize-resize-button
     1757           then do:
     1758             assign
     1759               v-object-handle :col = v-object-handle :col + p-change-value
     1760               no-error .
     1761             if error-status :error
     1762             or error-status :get-message(1) <> ""
     1763             then do:
     1764               undo move_block, retry move_block .
     1765             end.
     1766           end.
     1767         end.
     1768         for each buf_temp-browse-handle
     1769           where buf_temp-browse-handle.browse-type = 'width':u
     1770         on error undo move_block, retry move_block
     1771         :
     1772           assign
     1773             buf_temp-browse-handle.browse-handle :width
     1774               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1775             no-error .
     1776           if error-status :error
     1777           or error-status :get-message(1) <> ""
     1778           then do:
     1779             undo move_block, retry move_block .
     1780           end.
     1781         end.
     1782         assign
     1783           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1784           no-error .
     1785         if error-status :error
     1786         or error-status :get-message(1) <> ""
     1787         then do:
     1788           undo move_block, retry move_block.
     1789         end.
     1790         assign
     1791           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1792         no-error .
     1793         if error-status :error
     1794         or error-status :get-message(1) <> ""
     1795         then do:
     1796           undo move_block, retry move_block.
     1797         end.
     1798         if frame Dialog-Frame :scrollable = true
     1799         then do:
     1800           assign
     1801             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1802           no-error .
     1803           if error-status :error
     1804           or error-status :get-message(1) <> ""
     1805           then do:
     1806             undo move_block, retry move_block.
     1807           end.
     1808         end.
     1809       end.
     1810       if p-move-resize
     1811       then do:
     1812         run diasize_position-resize-button in this-procedure .
     1813       end.
     1814       if v-diasize-wndstore = true
     1815       then do:
     1816         if connected("ub") = true
     1817         then do:
     1818           define variable v-cntxt-db-num        as integer   no-undo .
     1819           define variable v-cntxt-userid        as character no-undo .
     1820           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1821                                             , OUTPUT v-cntxt-userid
     1822                                             ) .
     1823           run gbl/wndsizew.p
     1824             (input  v-cntxt-db-num
     1825             ,input  v-cntxt-userid
     1826             ,input  v-diasize-proc-name
     1827             ,input  'width':u
     1828             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1829             ) .
     1830         end.
     1831       end.
     1832     end.
     1833     assign
     1834       v-diasize-change-size = false
     1835     .
     1836   end procedure.
     1837   procedure diasize_set-width :
     1838     define input  parameter p-new-width  as decimal   no-undo .
     1839     define input  parameter p-move-resize as logical   no-undo .
     1840     do
     1841     on error undo, return error return-value
     1842     :
     1843       run diasize_change-width in this-procedure
     1844         (input  (p-new-width - frame Dialog-Frame :width)
     1845         ,input  p-move-resize
     1846         ) .
     1847     end.
     1848   end procedure.
     1849   procedure diasize_position-resize-button :
     1850     do with frame Dialog-Frame
     1851     :
     1852       hide v-diasize-resize-button .
     1853       assign
     1854         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1855                     - 1
     1856                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1857         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1858                     - 1
     1859                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1860       .
     1861       view v-diasize-resize-button .
     1862     end.
     1863   end procedure.
     1864   on alt-right anywhere
     1865   do:
     1866     run diasize_change-width in this-procedure
     1867       (input 1
     1868       ,input true
     1869       ) .
     1870     return no-apply .
     1871   end.
     1872   on alt-left anywhere
     1873   do:
     1874     run diasize_change-width in this-procedure
     1875       (input -1
     1876       ,input true
     1877       ) .
     1878     return no-apply .
     1879   end.
     1880   on alt-down anywhere
     1881   do:
     1882     run diasize_change-height in this-procedure
     1883       (input 1
     1884       ,input true
     1885       ) .
     1886     return no-apply .
     1887   end.
     1888   on alt-up anywhere
     1889   do:
     1890     run diasize_change-height in this-procedure
     1891       (input -1
     1892       ,input true
     1893       ) .
     1894     return no-apply .
     1895   end.
     1896   on alt-enter of frame Dialog-Frame
     1897   do:
     1898     run diasize_maximize in this-procedure
     1899       (input  ?
     1900       ).
     1901     return no-apply .
     1902   end.
     1903   procedure diasize_end-move :
     1904     do
     1905     on error undo, return error return-value
     1906     :
     1907       define variable v-row-delta as decimal   no-undo .
     1908       define variable v-col-delta as decimal   no-undo .
     1909       define variable v-new-row as decimal   no-undo .
     1910       define variable v-new-col as decimal   no-undo .
     1911       assign
     1912         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1913         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1914       .
     1915       assign
     1916         v-row-delta = v-new-row - frame Dialog-Frame :height
     1917         v-col-delta = v-new-col - frame Dialog-Frame :width
     1918       .
     1919       run diasize_change-height in this-procedure
     1920         (input v-row-delta
     1921         ,input true
     1922         ) .
     1923       run diasize_change-width in this-procedure
     1924         (input v-col-delta
     1925         ,input true
     1926         ) .
     1927     end.
     1928   end procedure.
     1929   procedure diasize_maximize :
     1930     define input  parameter p-action as logical   no-undo .
     1931     do
     1932     on error undo, return error return-value
     1933     :
     1934       if p-action = ?
     1935       then do:
     1936         if v-diasize-need-maximize = true
     1937         then do:
     1938           assign
     1939             p-action = true
     1940           .
     1941         end.
     1942         else do:
     1943           assign
     1944             p-action = false
     1945           .
     1946         end.
     1947       end.
     1948       if p-action = true
     1949       then do:
     1950         run diasize_change-height in this-procedure
     1951           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1952               - frame Dialog-Frame :height-chars
     1953           ,input true
     1954           ) .
     1955         run diasize_change-width in this-procedure
     1956           (input session :width-chars
     1957               - frame Dialog-Frame :width-chars
     1958           ,input true
     1959           ) .
     1960         assign
     1961           v-diasize-need-maximize = false
     1962         .
     1963       end.
     1964       else do:
     1965         run diasize_change-width in this-procedure
     1966           (input v-diasize-orig-frame-width
     1967               - frame Dialog-Frame :width-chars
     1968           ,input true
     1969           ) .
     1970         run diasize_change-height in this-procedure
     1971           (input v-diasize-orig-frame-height
     1972               - frame Dialog-Frame :height-chars
     1973           ,input true
     1974           ) .
     1975         assign
     1976           v-diasize-need-maximize = true
     1977         .
     1978       end.
     1979     end.
     1980   end procedure.
     1981   procedure diasize_restore-orig-size :
     1982     do
     1983     on error undo, return error return-value
     1984     :
     1985       assign
     1986         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1987         v-diasize-current-frame-height = frame Dialog-Frame :height
     1988       .
     1989       run diasize_set-height in this-procedure
     1990         (input  v-diasize-orig-frame-height
     1991         ,input  true
     1992         ) .
     1993       run diasize_set-width in this-procedure
     1994         (input  v-diasize-orig-frame-width
     1995         ,input  true
     1996         ) .
     1997     end.
     1998   end procedure.
     1999   procedure diasize_restore-current-size :
     2000     do
     2001     on error undo, return error return-value
     2002     :
     2003       run diasize_set-height in this-procedure
     2004         (input  v-diasize-current-frame-height
     2005         ,input  true
     2006         ) .
     2007       run diasize_set-width in this-procedure
     2008         (input  v-diasize-current-frame-width
     2009         ,input  true
     2010         ) .
     2011     end.
     2012   end procedure.
     2013   procedure diasize_set-browse-handle :
     2014     define input  parameter p-browse-handle as handle   no-undo .
     2015     define buffer buf_temp-browse-handle for temp-browse-handle .
     2016     do
     2017     on error undo, return error return-value
     2018     :
     2019       assign
     2020         v-diasize-browse-handle = p-browse-handle
     2021       .
     2022       for each buf_temp-browse-handle
     2023       on error undo, return error return-value
     2024       :
     2025         delete buf_temp-browse-handle .
     2026       end.
     2027     end.
     2028   end procedure.
     2029   procedure diasize_add_browse :
     2030     define input  parameter p-browse-type   as character no-undo .
     2031     define input  parameter p-browse-handle as handle    no-undo .
     2032     define buffer buf_temp-browse-handle for temp-browse-handle .
     2033     do
     2034     on error undo, return error return-value
     2035     :
     2036       assign
     2037         v-diasize-browse-number = v-diasize-browse-number + 1
     2038       .
     2039       create buf_temp-browse-handle .
     2040       assign
     2041         buf_temp-browse-handle.browse-type   = p-browse-type
     2042         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2043         buf_temp-browse-handle.browse-handle = p-browse-handle
     2044       .
     2045     end.
     2046   end procedure.
     2047   procedure diasize_init :
     2048     define variable v-default-value    as logical   no-undo .
     2049     define variable v-restore-saved    as logical   no-undo .
     2050     define variable v-resize-value-str as character no-undo .
     2051     do
     2052     on error undo, return error return-value
     2053     :
     2054       do with frame Dialog-Frame
     2055       :
     2056         assign
     2057           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2058           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2059           v-diasize-browse-handle     = browse BR-cash-pay :handle
     2060         .
     2061         create button v-diasize-resize-button
     2062         assign
     2063           parent        = frame Dialog-Frame :first-child
     2064           label         = "s"
     2065           height-pixels = 16
     2066           width-pixels  = 16
     2067           visible       = true
     2068           sensitive     = true
     2069           movable       = true
     2070           triggers:
     2071             on end-move persistent run diasize_end-move in this-procedure .
     2072           end triggers.
     2073         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2074         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2075         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2076         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2077         assign
     2078           v-diasize-wndmax = false
     2079         .
     2080         if connected("ub") = true
     2081         then do:
     2082           define variable v-cntxt-db-num        as integer   no-undo .
     2083           define variable v-cntxt-userid        as character no-undo .
     2084           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2085                                             , OUTPUT v-cntxt-userid
     2086                                             ) .
     2087           run gbl/wndpar_r.p
     2088             (input  v-cntxt-db-num
     2089             ,input  v-cntxt-userid
     2090             ,input  'wndmax':U
     2091             ,output v-diasize-wndmax
     2092             ,output v-default-value
     2093             ) .
     2094         end.
     2095         assign
     2096           v-diasize-wndstore = false
     2097         .
     2098         if connected("ub") = true
     2099         then do:
     2100           run gbl/wndpar_r.p
     2101             (input  v-cntxt-db-num
     2102             ,input  v-cntxt-userid
     2103             ,input  'wndstore':U
     2104             ,output v-diasize-wndstore
     2105             ,output v-default-value
     2106             ) .
     2107         end.
     2108         assign
     2109           v-diasize-proc-name = entry(1, program-name(2), '.')
     2110         .
     2111         if v-diasize-wndstore = true
     2112         then do:
     2113           assign
     2114             v-restore-saved = false
     2115           .
     2116           if connected("ub") = true
     2117           then do:
     2118             run gbl/wndsizer.p
     2119               (input  v-cntxt-db-num
     2120               ,input  v-cntxt-userid
     2121               ,input  v-diasize-proc-name
     2122               ,input  'height':u
     2123               ,output v-resize-value-str
     2124               ) .
     2125             if v-resize-value-str <> '':U
     2126             then do:
     2127               run diasize_change-height in this-procedure
     2128                 (input  integer(v-resize-value-str)
     2129                 ,input  true
     2130                 ) .
     2131               assign
     2132                 v-restore-saved = true
     2133               .
     2134             end.
     2135           end.
     2136           if connected("ub") = true
     2137           then do:
     2138             run gbl/wndsizer.p
     2139               (input  v-cntxt-db-num
     2140               ,input  v-cntxt-userid
     2141               ,input  v-diasize-proc-name
     2142               ,input  'width':u
     2143               ,output v-resize-value-str
     2144               ) .
     2145             if v-resize-value-str <> '':U
     2146             then do:
     2147               run diasize_change-width in this-procedure
     2148                 (input  integer(v-resize-value-str)
     2149                 ,input  true
     2150                 ) .
     2151               assign
     2152                 v-restore-saved = true
     2153               .
     2154             end.
     2155           end.
     2156           if v-restore-saved <> true
     2157           then do:
     2158             if v-diasize-wndmax = true
     2159             then do:
     2160               run diasize_maximize in this-procedure
     2161                 (input  true
     2162                 ) .
     2163             end.
     2164           end.
     2165         end.
     2166         else do:
     2167           if v-diasize-wndmax = true
     2168           then do:
     2169             run diasize_maximize in this-procedure
     2170               (input  true
     2171               ) .
     2172           end.
     2173         end.
     2174       end.
     2175     end.
     2176   end procedure.
     2177   procedure diasize_need-full-display :
     2178     define output parameter p-need-full-display as logical   no-undo .
     2179     do
     2180     on error undo, return error return-value
     2181     :
     2182       assign
     2183         p-need-full-display = v-diasize-need-full-display
     2184       .
     2185       assign
     2186         v-diasize-need-full-display = false
     2187       .
     2188     end.
     2189   end procedure.
     2190   procedure get-context :
     2191      define output parameter p-db-num as integer          no-undo.
     2192      define output parameter p-user-id as character        no-undo.
     2193      define variable v-login               as character    no-undo.
     2194      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2195      define buffer buf_user-login  for ub.user-login .
     2196      do
     2197      on error undo, return error
     2198      :
     2199            FIND FIRST buf_sys-ctrl no-lock.
     2200            ASSIGN
     2201               v-login = USERID("ub")
     2202               p-db-num = buf_sys-ctrl.db-num
     2203            .
     2204            FIND FIRST buf_user-login
     2205                 WHERE buf_user-login.db-num = p-db-num
     2206                   AND buf_user-login.user-login = v-login
     2207                 no-lock
     2208                 no-error
     2209                 .
     2210            IF AVAILABLE buf_user-login
     2211            THEN DO:
     2212               assign
     2213                  p-user-id = buf_user-login.user-id
     2214               .
     2215            END.
     2216      end.
     2217   end procedure.
     2218       run diasize_init in this-procedure .
     2219   MAIN-BLOCK:
     2220   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2221      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2222   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2223     run mainmenu_getcntxt in parparentproc
     2224       (output v-cntxt-db-num
     2225       ,output v-cntxt-userid
     2226       ,output v-cntxt-level
     2227       ,output v-cntxt-host-code-obj
     2228       ,output v-cntxt-obj-type
     2229       ,output v-cntxt-obj-code
     2230       ,output v-cntxt-db-num-obj
     2231       ,output v-cntxt-is-admin
     2232       ) .
     2233   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2234   ON TAB ANYWHERE
     2235   DO:
     2236   define variable ii as integer no-undo .
     2237   define variable fh as widget-handle no-undo .
     2238   define variable hh as widget-handle no-undo .
     2239   define variable v-next-widget-name as character no-undo .
     2240   if v-tab-order <> '' then do:
     2241     if self:type = "TOGGLE-BOX" then
     2242     self:BGCOLOR = ?.
     2243     assign
     2244     ii = lookup(self:name, v-tab-order).
     2245     assign
     2246     ii = ii + 1
     2247     v-next-widget-name = entry(ii, v-tab-order)
     2248     no-error .
     2249     if error-status:error then do:
     2250       assign
     2251       ii = 1
     2252       v-next-widget-name = entry( ii, v-tab-order)
     2253       .
     2254     end.
     2255     assign
     2256     fh = frame Dialog-Frame:first-child
     2257     hh = fh:first-child
     2258     .
     2259     do while valid-handle(hh):
     2260       if hh:name = v-next-widget-name then do:
     2261         if hh:sensitive  = yes
     2262         AND hh:visible = yes then do:
     2263           if hh:type = "TOGGLE-BOX":U then do:
     2264             assign
     2265             hh:BGcolor = 1
     2266             .
     2267           end.
     2268           APPLY "ENTRY" to hh.
     2269           return no-apply.
     2270         end.
     2271         else do:
     2272           APPLY "TAB" to hh.
     2273           return no-apply.
     2274         end.
     2275       end.
     2276       hh = hh:next-sibling.
     2277     end.
     2278   end.
     2279   END.
     2280   ON BACK-TAB ANYWHERE
     2281   DO:
     2282   define variable ii as integer no-undo .
     2283   define variable fh as widget-handle no-undo .
     2284   define variable hh as widget-handle no-undo .
     2285   define variable v-next-widget-name as character no-undo .
     2286   if v-tab-order <> '' then do:
     2287     assign
     2288     ii = lookup(self:name, v-tab-order).
     2289     .
     2290     assign
     2291     ii = (if ii = 1
     2292           then  num-entries(v-tab-order)
     2293           else ii - 1
     2294           )
     2295     v-next-widget-name = entry(ii, v-tab-order)
     2296     .
     2297     assign
     2298     fh = frame Dialog-Frame:first-child
     2299     hh = fh:first-child
     2300     .
     2301     do while valid-handle(hh):
     2302       if hh:name = v-next-widget-name then do:
     2303         if hh:sensitive  = yes
     2304         AND hh:visible = yes then do:
     2305           if hh:type = "TOGGLE-BOX":U then do:
     2306             assign
     2307             hh:BGcolor = 1
     2308             .
     2309           end.
     2310           APPLY "ENTRY" to hh.
     2311           return no-apply.
     2312         end.
     2313         else do:
     2314         APPLY "BACK-TAB" to hh.
     2315         return no-apply.
     2316         end.
     2317       end.
     2318       hh = hh:next-sibling.
     2319     end.
     2320     end.
     2321   END.
     2322   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2323   ON RETURN ANYWHERE
     2324   DO:
     2325   define variable ii as integer no-undo .
     2326   define variable fh as widget-handle no-undo .
     2327   define variable hh as widget-handle no-undo .
     2328   define variable v-next-widget-name as character no-undo .
     2329     if v-tab-order <> '' then do:
     2330       assign
     2331       ii = lookup(self:name, v-tab-order).
     2332       if ii = num-entries(v-tab-order) then do:
     2333           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     2334           return no-apply.
     2335       end.
     2336       if self:type <> "BUTTON" and
     2337         self:type <> "EDITOR"  then do:
     2338         run proc-move-forward in this-procedure .
     2339         return no-apply.
     2340       end.
     2341       if self:type = "BUTTON" then do:
     2342         APPLY "CHOOSE" to self.
     2343       end.
     2344       if self:type = "TOGGLE-BOX" then
     2345       self:BGCOLOR = ?.
     2346       assign
     2347       ii = ii + 1
     2348       v-next-widget-name = entry(ii, v-tab-order)
     2349       no-error .
     2350       if error-status:error then do:
     2351         assign
     2352         ii = 1
     2353         v-next-widget-name = entry( ii, v-tab-order)
     2354         .
     2355       end.
     2356       assign
     2357       fh = frame Dialog-Frame:first-child
     2358       hh = fh:first-child
     2359       .
     2360       do while valid-handle(hh):
     2361         if hh:name = v-next-widget-name then do:
     2362           if hh:sensitive  = yes
     2363           AND hh:visible = yes then do:
     2364             if hh:type = "TOGGLE-BOX":U then do:
     2365               assign
     2366               hh:BGcolor = 1
     2367               .
     2368             end.
     2369             APPLY "ENTRY" to hh.
     2370             return no-apply.
     2371           end.
     2372           else do:
     2373             APPLY "TAB" to hh.
     2374             return no-apply.
     2375           end.
     2376         end.
     2377         hh = hh:next-sibling.
     2378       end.
     2379     end.
     2380   END.
     2381   procedure proc-move-forward :
     2382   define variable ii as integer no-undo .
     2383   define variable fh as widget-handle no-undo .
     2384   define variable hh as widget-handle no-undo .
     2385   define variable v-next-widget-name as character no-undo .
     2386   do
     2387   on error undo, return error
     2388   :
     2389     if v-tab-order <> '' then do:
     2390       if self:type = "TOGGLE-BOX" then
     2391       self:BGCOLOR = ?.
     2392       assign
     2393       ii = lookup(self:name, v-tab-order).
     2394       assign
     2395       ii = ii + 1
     2396       v-next-widget-name = entry(ii, v-tab-order)
     2397       no-error .
     2398       if error-status:error then do:
     2399         assign
     2400         ii = 1
     2401         v-next-widget-name = entry( ii, v-tab-order)
     2402         .
     2403       end.
     2404       assign
     2405       fh = frame Dialog-Frame:first-child
     2406       hh = fh:first-child
     2407       .
     2408       do while valid-handle(hh):
     2409         if hh:name = v-next-widget-name then do:
     2410           if hh:sensitive  = yes
     2411           AND hh:visible = yes then do:
     2412             if hh:type = "TOGGLE-BOX":U then do:
     2413               assign
     2414               hh:BGcolor = 1
     2415               .
     2416             end.
     2417             APPLY "ENTRY" to hh.
     2418             return.
     2419           end.
     2420           else do:
     2421             assign
     2422             ii = ii + 1
     2423             v-next-widget-name = entry(ii, v-tab-order)
     2424             no-error .
     2425             if error-status:error then do:
     2426               assign
     2427               ii = 1
     2428               v-next-widget-name = entry( ii, v-tab-order)
     2429               .
     2430             end.
     2431           end.
     2432         end.
     2433         hh = hh:next-sibling.
     2434       end.
     2435     end.
     2436   end.
     2437   end procedure.
     2438     IF p-mode <> 'ПРОСМОТР':U
     2439     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     2440         MESSAGE
     2441         vss-workfile vss-revision vss-description skip
     2442         "Неверное значение параметра p-mode" p-mode
     2443         VIEW-AS ALERT-BOX ERROR.
     2444         UNDO, RETURN ERROR.
     2445     END.
     2446     IF p-obj-type <> 'маг':U
     2447     and p-obj-type <> 'орг':U
     2448     and p-obj-type <> '':U
     2449     THEN DO:
     2450         MESSAGE
     2451         vss-workfile vss-revision vss-description skip
     2452         "Неверное значение параметра p-obj-type" p-obj-type
     2453         VIEW-AS ALERT-BOX ERROR.
     2454         UNDO, RETURN ERROR.
     2455     END.
     2456     if p-obj-type = 'маг':U then do:
     2457       FIND FIRST X_shop NO-LOCK WHERE X_shop.obj-code = p-obj-code NO-ERROR.
     2458       IF NOT AVAILABLE X_shop THEN DO:
     2459           MESSAGE
     2460           vss-workfile vss-revision vss-description skip
     2461           "Неверное значение параметра p-obj-code" p-obj-code
     2462           VIEW-AS ALERT-BOX ERROR.
     2463           UNDO, RETURN ERROR.
     2464       END.
     2465   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2466   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2467     (input  'маг':U
     2468     ,input  p-obj-code
     2469     ,output v-db-num
     2470     )  .
     2471       IF v-db-num <> v-cntxt-db-num
     2472       AND v-cntxt-db-num <> 0
     2473       and p-mode <> 'ПРОСМОТР':U
     2474       THEN DO:
     2475           MESSAGE
     2476           "Нельзя менять параметры магазина в чужой БД" skip
     2477           "магазин принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     2478           VIEW-AS ALERT-BOX ERROR.
     2479           UNDO, RETURN ERROR.
     2480       END.
     2481   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2482   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2483     (input  p-obj-type
     2484     ,input  p-obj-code
     2485     ,output v-host-code
     2486     )  .
     2487     end.
     2488     if p-obj-type = 'орг':U then do:
     2489       FIND FIRST X_sysconf NO-LOCK WHERE X_sysconf.host-code = p-obj-code NO-ERROR.
     2490       IF NOT AVAILABLE X_sysconf THEN DO:
     2491           MESSAGE
     2492           vss-workfile vss-revision vss-description skip
     2493           "Неверное значение параметра p-obj-code" p-obj-code
     2494           VIEW-AS ALERT-BOX ERROR.
     2495           UNDO, RETURN ERROR.
     2496       END.
     2497       if v-cntxt-db-num <> 0
     2498       and p-mode <> 'ПРОСМОТР':U
     2499       then do:
     2500           MESSAGE
     2501           "Нельзя менять параметры ФИРМЫ в УБД" skip
     2502           VIEW-AS ALERT-BOX ERROR.
     2503           UNDO, RETURN ERROR.
     2504       end.
     2505       v-host-code = p-obj-code.
     2506     end.
     2507     if p-obj-type = '':U then do:
     2508       if v-cntxt-db-num <> 0
     2509       and p-mode <> 'ПРОСМОТР':U
     2510       then do:
     2511           MESSAGE
     2512           "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" skip
     2513           VIEW-AS ALERT-BOX ERROR.
     2514           UNDO, RETURN ERROR.
     2515       end.
     2516     end.
     2517     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     2518       FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
     2519                 LOCKED_thbj-attr.obj-type = p-obj-type
     2520           AND   LOCKED_thbj-attr.obj-code = p-obj-code
     2521           AND   LOCKED_thbj-attr.upper-prop-code = 'cd-type-omron-new':U
     2522           AND   locked_thbj-attr.prop-code = '':U NO-ERROR.
     2523        if locked locked_thbj-attr then do:
     2524           message
     2525           vss-workfile vss-revision vss-description skip
     2526            "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
     2527           view-as alert-box error .
     2528           undo, return error.
     2529         end.
     2530     END.
     2531     ELSE DO:
     2532         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
     2533             LOCKED_thbj-attr.obj-type = p-obj-type
     2534       AND   LOCKED_thbj-attr.obj-code = p-obj-code
     2535       AND   LOCKED_thbj-attr.upper-prop-code = 'cd-type-omron-new':U
     2536       AND  locked_thbj-attr.prop-code = '':u NO-ERROR.
     2537     END.
     2538     if not available locked_thbj-attr then do:
     2539       ASSIGN
     2540       v-to-create  = YES.
     2541       message
     2542       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     2543                   chr(10))
     2544       view-as alert-box WARNING.
     2545     end.
     2546   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2547   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run r-b-curr in g#library
     2548     (input  v-host-code
     2549     ,output v-r-b-code
     2550     )  .
     2551   FIND FIRST buf_currency NO-LOCK WHERE
     2552           buf_currency.curr-code = v-r-b-code .
     2553     RUN FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     2554     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     2555     RUN Myenable.
     2556     WAIT-FOR GO OF FRAME Dialog-Frame.
     2557   END.
     2558   RUN disable_UI.
     2559   PROCEDURE disable_UI :
     2560     HIDE FRAME Dialog-Frame.
     2561   END PROCEDURE.
     2562   PROCEDURE enable_UI :
     2563     DISPLAY f-ipcsbasc f-omrnbase for-curr-name l-omrnnal f-omrnnal
     2564             for-cash-pay-nal l-omrnntnl f-omrnntnl for-cash-pay-ntnl
     2565         WITH FRAME Dialog-Frame.
     2566     ENABLE B-exit b-quit B-Help f-ipcsbasc f-omrnbase b-curr b-cash-pay-nal
     2567            b-cash-pay-ntnl BR-cash-pay for-curr-name l-omrnnal f-omrnnal
     2568            for-cash-pay-nal l-omrnntnl f-omrnntnl for-cash-pay-ntnl
     2569         WITH FRAME Dialog-Frame.
     2570     VIEW FRAME Dialog-Frame.
     2571   END PROCEDURE.
     2572   PROCEDURE fill-widgets :
     2573   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     2574   define variable v-value-character as character no-undo .
     2575   define variable v-value-date as date no-undo .
     2576   define variable v-value-decimal as decimal no-undo .
     2577   define variable v-value-integer as INTEGER no-undo .
     2578   define variable v-value-logical AS LOGICAL no-undo .
     2579   DEFINE VARIABLE v-entry AS CHARACTER NO-UNDO.
     2580   DEFINE VARIABLE v-omrncurl AS CHARACTER NO-UNDO.
     2581   DEFINE VARIABLE v-omrnpayl AS CHARACTER NO-UNDO.
     2582   DEFINE VARIABLE v-omrnon-new-pay-code LIKE ub.cash-pay.cdpay-code NO-UNDO.
     2583   DEFINE VARIABLE v-cdpay-code LIKE ub.cash-pay.cdpay-code NO-UNDO.
     2584   DEFINE VARIABLE v-curr-code LIKE ub.cash-pay.curr-code NO-UNDO.
     2585   DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
     2586   define variable v-param-type as character no-undo .
     2587   define variable v-param-value as character no-undo .
     2588   FOR EACH thbjattr_thbj-attr:
     2589     delete thbjattr_thbj-attr.
     2590   end.
     2591   FOR EACH temp-thbj-attr:
     2592     delete temp-thbj-attr.
     2593   end.
     2594   run adm/shattri.p (
     2595                 input "init":U
     2596               , input p-obj-type
     2597               , input p-obj-code
     2598               , input 'cd-type-omron-new':U
     2599               , input "":U
     2600               , output v-value-character
     2601               , output v-value-date
     2602               , output v-value-decimal
     2603               , output v-value-integer
     2604               , output v-value-logical
     2605               , output v-param-type
     2606               , INPUT-OUTPUT TABLE-handle v-tth
     2607               ) no-error .
     2608   if error-status:error
     2609   and not available locked_thbj-attr then do:
     2610     message
     2611     "Не удалось получить начальные значения настроек" skip
     2612     error-status:get-message(1) return-value
     2613     view-as alert-box error .
     2614     undo, return error .
     2615   end.
     2616   FOR EACH thbjattr_thbj-attr:
     2617     ASSIGN
     2618     v-entry = thbjattr_thbj-attr.prop-code.
     2619     IF v-entry = 'omrnbase':U THEN DO:
     2620       ASSIGN
     2621       f-omrnbase = thbjattr_thbj-attr.property-value-INTEGER
     2622       f-omrnbase:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2623       .
     2624     END.
     2625     IF v-entry = 'omrnnal':U THEN DO:
     2626       ASSIGN
     2627       f-omrnnal = thbjattr_thbj-attr.property-value-INTEGER
     2628       f-omrnnal:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2629       .
     2630     END.
     2631     IF v-entry = 'omrnntnl':U THEN DO:
     2632       ASSIGN
     2633       f-omrnntnl = thbjattr_thbj-attr.property-value-INTEGER
     2634       f-omrnntnl:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2635       .
     2636     END.
     2637     IF v-entry = 'omrncurl':U THEN DO:
     2638       ASSIGN
     2639       v-omrncurl = thbjattr_thbj-attr.property-value-character
     2640       .
     2641     END.
     2642     IF v-entry = 'omrnpayl':U THEN DO:
     2643       ASSIGN
     2644       v-omrnpayl = thbjattr_thbj-attr.property-value-character.
     2645     END.
     2646     create temp-thbj-attr.
     2647     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     2648   END.
     2649   if v-omrncurl <> "":U then do:
     2650   _ii:
     2651   DO ii = 1 TO MIN(NUM-ENTRIES(v-omrncurl), NUM-ENTRIES(v-omrnpayl)):
     2652      ASSIGN
     2653      v-omrnon-new-pay-code = ii
     2654      v-cdpay-code = INTEGER (ENTRY(ii, v-omrnpayl))
     2655      v-curr-code = INTEGER (ENTRY(ii, v-omrncurl))
     2656      .
     2657      FIND FIRST buf_cash-pay NO-LOCK WHERE
     2658                   buf_cash-pay.cdpay-code = v-cdpay-code
     2659           AND buf_cash-pay.curr-code = v-curr-code  NO-ERROR.
     2660      IF NOT AVAILABLE buf_cash-pay THEN NEXT _ii.
     2661       CREATE tt-cash-pay-omrn.
     2662       BUFFER-COPY buf_cash-pay TO tt-cash-pay-omrn
     2663       ASSIGN
     2664       tt-cash-pay-omrn.omrn-pay-code = ii
     2665       .
     2666   END.
     2667   end.
     2668   END PROCEDURE.
     2669   PROCEDURE MyEnable :
     2670   DEFINE BUFFER buf_currency FOR ub.currency.
     2671   FIND FIRST buf_currency NO-LOCK WHERE
     2672             buf_currency.curr-code = f-omrnbase NO-ERROR.
     2673   IF AVAILABLE buf_currency THEN DO:
     2674       ASSIGN
     2675       for-curr-name = buf_currency.curr-abbr.
     2676   END.
     2677   ELSE DO:
     2678       ASSIGN
     2679       for-curr-name = ?.
     2680   END.
     2681   FIND FIRST buf_cash-pay-nal NO-LOCK WHERE
     2682             buf_cash-pay-nal.cdpay-code = f-omrnnal
     2683         AND buf_cash-pay-nal.curr-code = f-omrnbase NO-ERROR.
     2684   IF AVAILABLE buf_cash-pay-nal THEN DO:
     2685       ASSIGN
     2686       for-cash-pay-nal = buf_cash-pay-nal.obj-name.
     2687   END.
     2688   ELSE DO:
     2689       ASSIGN
     2690       for-cash-pay-nal = ?.
     2691   END.
     2692   FIND FIRST buf_cash-pay-ntnl NO-LOCK WHERE
     2693             buf_cash-pay-ntnl.cdpay-code = f-omrnntnl
     2694         AND buf_cash-pay-ntnl.curr-code = f-omrnbase NO-ERROR.
     2695   IF AVAILABLE buf_cash-pay-ntnl THEN DO:
     2696       ASSIGN
     2697       for-cash-pay-ntnl = buf_cash-pay-ntnl.obj-name.
     2698   END.
     2699   ELSE DO:
     2700       ASSIGN
     2701       for-cash-pay-ntnl = ?.
     2702   END.
     2703   ASSIGN
     2704   FRAME Dialog-Frame:TITLE = FRAME Dialog-Frame:TITLE + (if p-obj-type = 'орг':U then " фирма" else " маг") + STRING(p-obj-code)
     2705   v-tab-order = "f-omrnbase,b-curr,b-cash-pay-nal,b-cash-pay-ntnl,b-add,b-del".
     2706   DISPLAY
     2707   f-omrnbase
     2708   f-omrnnal
     2709   f-omrnntnl
     2710   l-omrnnal
     2711   l-omrnntnl
     2712   for-curr-name
     2713   for-cash-pay-nal
     2714   for-cash-pay-ntnl
     2715   WITH FRAME Dialog-Frame.
     2716   ENABLE
     2717   B-exit WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2718   b-quit
     2719   B-Help
     2720   br-cash-pay
     2721   b-curr WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2722   b-cash-pay-nal WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2723   b-cash-pay-ntnl WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2724   f-omrnbase WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2725   b-add   WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2726   b-del   WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2727   WITH FRAME Dialog-Frame.
     2728   VIEW FRAME Dialog-Frame.
     2729   IF p-mode = 'ПРОСМОТР':U THEN DO:
     2730       HIDE
     2731       b-exit
     2732       IN FRAME Dialog-Frame.
     2733       ASSIGN
     2734       b-quit:LABEL = "&Выход"
     2735       .
     2736   END.
     2737   RUN openbr IN THIS-PROCEDURE.
     2738   END PROCEDURE.
     2739   PROCEDURE OpenBr :
     2740   OPEN QUERY br-cash-pay FOR EACH tt-cash-pay-omrn SHARE-LOCK.
     2741   END PROCEDURE.
     2742   PROCEDURE proc-save :
     2743   define variable v-value-character as character no-undo .
     2744   define variable v-value-date as date no-undo .
     2745   define variable v-value-decimal as decimal no-undo .
     2746   define variable v-value-integer as INTEGER no-undo .
     2747   define variable v-value-logical AS LOGICAL no-undo .
     2748   define variable v-param-type as character no-undo .
     2749   define variable wh as widget-handle no-undo .
     2750   define variable fh as widget-handle no-undo .
     2751   define variable v-same as logical no-undo .
     2752   DEFINE VARIABLE v-omrncurl AS CHARACTER NO-UNDO.
     2753   DEFINE VARIABLE v-omrnpayl AS CHARACTER NO-UNDO.
     2754   define variable v-dop1 as character no-undo .
     2755   define variable v-dop2 as character no-undo .
     2756   define variable v-dop3 as character no-undo .
     2757   DEFINE BUFFER buf_tt-cash-pay-omrn FOR tt-cash-pay-omrn.
     2758   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     2759   ASSIGN
     2760   FRAME Dialog-Frame
     2761   f-omrnbase
     2762   f-omrnnal
     2763   f-omrnntnl
     2764   .
     2765   FOR EACH tt-cash-pay-omrn BY tt-cash-pay-omrn.omrn-pay-code:
     2766     ASSIGN
     2767     v-omrncurl = v-omrncurl + (IF v-omrncurl = "":U THEN "":U ELSE chr(44)) + STRING(tt-cash-pay-omrn.omrn-pay-code)
     2768     v-omrnpayl = v-omrnpayl + (IF v-omrnpayl = "":U THEN "":U ELSE chr(44)) + STRING(tt-cash-pay-omrn.cdpay-code)
     2769     .
     2770   END.
     2771   assign
     2772   fh = frame Dialog-Frame:first-child
     2773   wh = fh:first-child
     2774   .
     2775   do while valid-handle(wh):
     2776     if wh:private-data begins "recid=" then do:
     2777       find first thbjattr_thbj-attr where
     2778                 recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     2779       assign
     2780       buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     2781     end.
     2782     wh = wh:next-sibling.
     2783   end.
     2784   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'omrncurl':U.
     2785   assign
     2786   thbjattr_thbj-attr.property-value-character = v-omrncurl.
     2787   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'omrnpayl':U.
     2788   assign
     2789   thbjattr_thbj-attr.property-value-character = v-omrnpayl.
     2790   v-same = yes.
     2791   for each thbjattr_thbj-attr,
     2792       first temp-thbj-attr where
     2793             temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     2794         and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     2795         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     2796         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code:
     2797      buffer-compare
     2798      thbjattr_thbj-attr
     2799      to temp-thbj-attr
     2800      save result in v-same.
     2801      if not v-same then leave.
     2802   end.
     2803   v-same = no.
     2804   IF v-same  and not v-to-create THEN RETURN.
     2805   run adm/shattri.p (
     2806                 input "check":U
     2807               , input p-obj-type
     2808               , input p-obj-code
     2809               , input 'cd-type-omron-new':U
     2810               , INPUT '':U
     2811                , output v-value-character
     2812                , output v-value-date
     2813                , output v-value-decimal
     2814                , output v-value-integer
     2815                , output v-value-logical
     2816                , output v-param-type
     2817                , input-output TABLE-handle v-tth
     2818                ) no-error .
     2819   if error-status:error then do:
     2820     message
     2821     "Некорректное значение ПАРАМЕТРОВ" skip
     2822     error-status:get-message(1) skip
     2823     return-value
     2824     view-as alert-box error .
     2825     undo, return error .
     2826   end.
     2827   do TRANSACTION
     2828   on error undo, return error return-value
     2829   :
     2830     RUN thbjattr_set-section IN THIS-PROCEDURE (
     2831          input p-obj-type
     2832         ,input p-obj-code
     2833         ,input 'cd-type-omron-new':U
     2834         ,INPUT table thbjattr_thbj-attr
     2835     ) NO-ERROR.
     2836     IF ERROR-STATUS:error THEN do:
     2837       MESSAGE ERROR-STATUS:get-message(1)  SKIP
     2838       RETURN-VALUE
     2839       VIEW-AS ALERT-BOX.
     2840       UNDO, RETURN ERROR.
     2841     END.
     2842   end.
     2843   END PROCEDURE.
