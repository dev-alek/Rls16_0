      676   function nzpl-spl returns logical
      677   (input p-obj-type as character
      678                                   , input p-obj-code as integer):
      679   define variable v-dopi    as integer no-undo .
      680   define variable v-param-type as character no-undo .
      681   define variable v-value-character as character no-undo .
      682   define variable v-value-date as date no-undo .
      683   define variable v-value-decimal as decimal no-undo .
      684   define variable v-value-integer as integer no-undo .
      685   define variable v-value-logical as logical no-undo .
      686   define variable v-tth as handle no-undo .
      687   define variable dflt-cd as character no-undo .
      688   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      689   define variable v-param-type5 as character no-undo .
      690   define variable v-value-date5 as date no-undo .
      691   define variable v-value-decimal5 as decimal no-undo .
      692   define variable v-value-integer5 as INTEGER no-undo .
      693   define variable v-value-logical5 AS LOGICAL no-undo .
      694   define variable v-tth5 as handle no-undo .
      695   run adm/shattri.p (
      696       input "get":U
      697       ,input  p-obj-type
      698       ,input  p-obj-code
      699       ,input  'cd-sending':U
      700       ,input  'dflt-cd':U
      701       ,output dflt-cd
      702       ,output v-value-date5
      703       ,output v-value-decimal5
      704       ,output v-value-integer5
      705       ,output v-value-logical5
      706       ,output v-param-type5
      707       ,INPUT-OUTPUT table-handle v-tth5
      708       ) no-error .
      709   delete object v-tth5 no-error.
      710   if dflt-cd <> 'IBM':U
      711   and dflt-cd <> 'IBM-XML':U then return no.
      712   if dflt-cd = 'IBM-XML':U then return yes.
      713   run adm/shattri.p (
      714       input "get":U
      715       ,input  p-obj-type
      716       ,input  p-obj-code
      717       ,input  'cd-type-ibm':U
      718       ,input  'ibmspool':U
      719       ,output v-value-character
      720       ,output v-value-date
      721       ,output v-value-decimal
      722       ,output v-value-integer
      723       ,output v-value-logical
      724       ,output v-param-type
      725       ,INPUT-OUTPUT table-handle v-tth
      726       ) no-error .
      727   if error-status:error then do:
      728     delete object v-tth.
      729     return no.
      730   end.
      731   delete object v-tth.
      732   assign
      733   v-dopi = v-value-integer no-error .
      734   if v-dopi >= 6 then return yes.
      735   end. // FUNCTION/method
      736   FUNCTION nzpl-two returns logical
      737                                    (input p-obj-type as character
      738                                     , input p-obj-code as integer):
      739     define variable v-nzpl-two as logical no-undo.
      740     run
      741     nzpl-two-proc (input p-obj-type, input p-obj-code, output v-nzpl-two).
      742     return v-nzpl-two.
      743   end. // FUNCTION/method
      744   procedure nzpl-two-proc :
      745   define input  parameter p-obj-type   as character no-undo.
      746   define input  parameter p-obj-code   as integer   no-undo.
      747   define output parameter varge-two-pl as logical   no-undo.
      748   define buffer bf_pl-gds-pump       for ub.pl-gds-pump.
      749   define buffer bf-other_pl-gds-pump for ub.pl-gds-pump.
      750   //do on error undo, return error return-value :
      751   assign
      752     varge-two-pl = no.
      753   for each bf_pl-gds-pump where bf_pl-gds-pump.obj-type = p-obj-type        and
      754                                 bf_pl-gds-pump.obj-code = p-obj-code        and
      755                                 bf_pl-gds-pump.status_  = 'тек':U no-lock on error undo, return error return-value :
      756     find first bf-other_pl-gds-pump where bf-other_pl-gds-pump.obj-type  =  bf_pl-gds-pump.obj-type  and
      757                                           bf-other_pl-gds-pump.obj-code  =  bf_pl-gds-pump.obj-code  and
      758                                           bf-other_pl-gds-pump.pump-code =  bf_pl-gds-pump.pump-code and
      759                                           bf-other_pl-gds-pump.gds-code  =  bf_pl-gds-pump.gds-code  and
      760                                           bf-other_pl-gds-pump.status_   =  'тек':U        and
      761                                           bf-other_pl-gds-pump.pl-code   <> bf_pl-gds-pump.pl-code   no-lock no-error.
      762     if available bf-other_pl-gds-pump then do:
      763       assign
      764         varge-two-pl = yes.
      765       leave.
      766     end.
      767   end.
      768   //end.
      769   end. // procedure/method .
