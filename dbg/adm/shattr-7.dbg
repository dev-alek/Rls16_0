     1730        T-multicurr AT ROW 4.71 COL 69.6 WIDGET-ID 2
     1731        RS-cd-vat AT ROW 5.76 COL 34.6 NO-LABEL
     1732        B-del AT ROW 6.76 COL 11
     1733        BR-tax-rate-code AT ROW 7.76 COL 1
     1734        t-ibmgroup AT ROW 14 COL 1
     1735        B-del-2 AT ROW 14 COL 61
     1736        BR-specgrp AT ROW 15 COL 1
     1737        B-add AT ROW 6.76 COL 1
     1738        for-curr-name AT ROW 3.67 COL 79.6 COLON-ALIGNED NO-LABEL
     1739        l-ibmspool AT ROW 4.52 COL 3.6 NO-LABEL
     1740        l-cd-vat AT ROW 5.76 COL 3.6 NO-LABEL
     1741        SPACE(66.69) SKIP(14.66)
     1742       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1743            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1744            TITLE "Параметры POS IBM"
     1745            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     1746   ASSIGN
     1747          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1748          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1749   ASSIGN
     1750          B-add-2:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-add-2:HANDLE.
     1751   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1752   DO:
     1753     APPLY "END-ERROR":U TO SELF.
     1754   END.
     1755   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1756   DO:
     1757     DEFINE VARIABLE v-value AS CHARACTER NO-UNDO.
     1758     DEFINE VARIABLE v-log AS logical NO-UNDO.
     1759     DEFINE VARIABLE v-tax-rid AS RECID NO-UNDO.
     1760     DEFINE VARIABLE v-tax-rate-rid AS RECID NO-UNDO.
     1761     DEFINE BUFFER buf_tax FOR ub.tax.
     1762     DEFINE BUFFER buf_tax-rate FOR ub.tax-rate.
     1763     FIND FIRST buf_tax NO-LOCK WHERE
     1764               buf_tax.tax-code = INTEGER('1':U).
     1765     run ref/tax-tree.w (
     1766         input parparentproc
     1767         ,INPUT "b-seltax-rate"
     1768         ,INPUT "ALL-TAX-RATES"
     1769         ,INPUT 0
     1770         ,INPUT p-obj-type
     1771         ,INPUT p-obj-code
     1772         ,INPUT RECID(buf_tax)
     1773         ,INPUT-OUTPUT v-tax-rate-rid
     1774         ) NO-ERROR.
     1775   IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1776   IF v-tax-rate-rid <> ? THEN DO:
     1777       FIND FIRST buf_tax-rate NO-LOCK WHERE
     1778             recid(buf_tax-rate) = v-tax-rate-rid.
     1779      FIND FIRST tt-tax-rate-code NO-LOCK WHERE
     1780                 tt-tax-rate-code.rate-code = buf_tax-rate.rate-code NO-ERROR.
     1781       IF AVAILABLE tt-tax-rate-code THEN DO:
     1782           MESSAGE
     1783           "Вы уже выбрали ставку налога с кодом ставки" tt-tax-rate-code.rate-code
     1784           VIEW-AS ALERT-BOX.
     1785           RETURN NO-APPLY.
     1786      END.
     1787      IF buf_tax-rate.STATUS_ = 'удал':U  THEN DO:
     1788           MESSAGE
     1789           "Нельзя выбрать ставку налога в статусе УДАЛЕН"
     1790           VIEW-AS ALERT-BOX.
     1791           RETURN NO-APPLY.
     1792      END.
     1793      CREATE tt-tax-rate-code.
     1794      BUFFER-COPY buf_tax-rate
     1795      except tax-code
     1796      TO tt-tax-rate-code
     1797      ASSIGN
     1798      tt-tax-rate-code.bo-tax-code = buf_tax-rate.tax-code
     1799      tt-tax-rate-code.tax-code = 0
     1800      v-tax-rate-rid = RECID(tt-tax-rate-code)
     1801      .
     1802      run openbr IN THIS-PROCEDURE.
     1803      REPOSITION br-tax-rate-code TO RECID v-tax-rate-rid.
     1804   END.
     1805   END.
     1806   ON CHOOSE OF B-add-2 IN FRAME Dialog-Frame
     1807   DO:
     1808     IF specgrp-option = 0 THEN DO:
     1809       run gbl/pop-up.p ( INPUT self:handle, INPUT no) NO-ERROR.
     1810     END.
     1811     IF specgrp-option = 0  THEN RETURN NO-APPLY.
     1812     RUN proc-b-add-2 IN THIS-PROCEDURE ( INPUT specgrp-option) NO-ERROR.
     1813     IF ERROR-STATUS:ERROR THEN do:
     1814         specgrp-option = 0.
     1815          RETURN NO-APPLY.
     1816     END.
     1817   END.
     1818   ON CHOOSE OF b-curr IN FRAME Dialog-Frame
     1819   DO:
     1820       define variable rr as recid no-undo.
     1821       DEFINE BUFFER buf_currency FOR ub.currency.
     1822       rr = ? .
     1823       run ref/currency.w (
     1824                       input parparentproc
     1825                     , input "b-sel"
     1826                     , input-output rr ).
     1827       if rr <> ? then do:
     1828         FIND FIRST buf_currency WHERE
     1829                   recid( buf_currency ) = rr NO-LOCK .
     1830         DISPLAY
     1831         buf_currency.curr-code @ f-ibmnalc
     1832         buf_currency.curr-abbr @ for-curr-name
     1833         with frame Dialog-Frame .
     1834       end.
     1835   END.
     1836   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1837   DO:
     1838     IF NOT AVAILABLE tt-tax-rate-code THEN RETURN NO-APPLY.
     1839     DELETE tt-tax-rate-code.
     1840     run openbr IN THIS-PROCEDURE.
     1841     REPOSITION br-tax-rate-code TO ROW 1.
     1842   END.
     1843   ON CHOOSE OF B-del-2 IN FRAME Dialog-Frame
     1844   DO:
     1845     IF NOT AVAILABLE tt-sum-grp THEN RETURN NO-APPLY.
     1846     DELETE tt-sum-grp.
     1847     OPEN QUERY BR-specgrp FOR EACH tt-sum-grp NO-LOCK INDEXED-REPOSITION.
     1848     REPOSITION br-specgrp TO ROW 1.
     1849   END.
     1850   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1851   DO:
     1852     run proc-save IN THIS-PROCEDURE NO-ERROR.
     1853     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1854   END.
     1855   ON LEAVE OF f-ibmnalc IN FRAME Dialog-Frame
     1856   DO:
     1857       DEFINE BUFFER buf_currency FOR ub.currency.
     1858       FIND FIRST buf_currency NO-LOCK WHERE
     1859               buf_currency.curr-code = INPUT FRAME Dialog-Frame f-ibmnalc NO-ERROR.
     1860     IF AVAIL buf_currency THEN DO:
     1861       DISPLAY
     1862       buf_currency.curr-abbr @ for-curr-name
     1863       WITH FRAME Dialog-Frame.
     1864     END.
     1865   END.
     1866   ON CHOOSE OF MENU-ITEM m_24
     1867   DO:
     1868     ASSIGN
     1869     specgrp-option = 24.
     1870     RUN proc-b-add-2 IN THIS-PROCEDURE ( INPUT specgrp-option) NO-ERROR.
     1871     IF ERROR-STATUS:ERROR THEN DO:
     1872         specgrp-option = 0.
     1873         RETURN NO-APPLY.
     1874     END.
     1875   END.
     1876   ON CHOOSE OF MENU-ITEM m_50
     1877   DO:
     1878     ASSIGN
     1879     specgrp-option = 50.
     1880     RUN proc-b-add-2 IN THIS-PROCEDURE ( INPUT specgrp-option) NO-ERROR.
     1881     IF ERROR-STATUS:ERROR THEN DO:
     1882         specgrp-option = 0.
     1883         RETURN NO-APPLY.
     1884     END.
     1885   END.
     1886   ON VALUE-CHANGED OF RS-cd-vat IN FRAME Dialog-Frame
     1887   DO:
     1888     ASSIGN
     1889     rs-cd-vat.
     1890     CASE rs-cd-vat:
     1891       WHEN 0 THEN DO:
     1892         for each tt-tax-rate-code:
     1893           delete tt-tax-rate-code.
     1894         end.
     1895         ASSIGN
     1896         tt-tax-rate-code.tax-code:read-only IN browse br-tax-rate-code  = yes .
     1897         DISABLE
     1898         b-add
     1899         b-del WITH FRAME Dialog-Frame.
     1900       END.
     1901       WHEN 1 THEN DO:
     1902           IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     1903             ASSIGN
     1904             tt-tax-rate-code.tax-code:read-only IN browse br-tax-rate-code  = NO .
     1905             ENABLE
     1906             b-add
     1907             b-del WITH FRAME Dialog-Frame.
     1908         END.
     1909       END.
     1910     END CASE.
     1911     run openbr in this-procedure .
     1912   END.
     1913   ON VALUE-CHANGED OF t-ibmgroup IN FRAME Dialog-Frame
     1914   DO:
     1915     ASSIGN
     1916    t-ibmgroup.
     1917     CASE t-ibmgroup:
     1918       WHEN YES  THEN DO:
     1919         if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     1920            ENABLE
     1921            b-add-2
     1922            b-del-2
     1923            WITH FRAME Dialog-Frame.
     1924            OPEN QUERY BR-specgrp FOR EACH tt-sum-grp NO-LOCK INDEXED-REPOSITION.
     1925          end.
     1926       END.
     1927       WHEN NO THEN DO:
     1928         if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     1929           DISABLE
     1930           b-add-2
     1931           b-del-2
     1932           WITH FRAME Dialog-Frame.
     1933           OPEN QUERY BR-specgrp FOR EACH tt-sum-grp NO-LOCK where false INDEXED-REPOSITION.
     1934         end.
     1935       END.
     1936     END CASE.
     1937   END.
     1938   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1939   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1940   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1941   on help of frame Dialog-Frame
     1942   do:
     1943     run gbl/app_help.p
     1944       (input this-procedure :file-name
     1945       ,input ''
     1946       ,input ?
     1947       ) no-error.
     1948     if error-status :error then do:
     1949       message
     1950         "Ошибка при вызове помощи"
     1951         error-status :get-message(1)
     1952         view-as alert-box .
     1953     end.
     1954   end.
     1955   run minbtn-set in this-procedure .
     1956   on choose of b-help in frame Dialog-Frame
     1957   do:
     1958     apply "help":u to frame Dialog-Frame .
     1959   end.
     1960   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1961   procedure minbtn-set :
     1962       do
     1963           on error undo, return error return-value
     1964           :
     1965           define variable ii              as integer       no-undo .
     1966           define variable fh              as widget-handle no-undo .
     1967           define variable hh              as widget-handle no-undo .
     1968           define variable v-h             as handle        extent 4 no-undo .
     1969           define variable v-name-button   as character     no-undo .
     1970           define variable v-help-old-x    as decimal       no-undo .
     1971           define variable v-help-old-y    as decimal       no-undo .
     1972           define variable v-help-old-size as decimal       no-undo .
     1973           define variable v-frame-width   as decimal       no-undo .
     1974           define variable jj              as integer       no-undo .
     1975           do
     1976               on error undo, return error
     1977               :
     1978               assign
     1979                   v-frame-width = frame Dialog-Frame:width - 0.3
     1980                   fh            = frame Dialog-Frame:first-child
     1981                   hh            = fh:first-child
     1982                   ii            = 1
     1983                   .
     1984               do while valid-handle(hh):
     1985                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1986                   do:
     1987                       case lc(hh:name) :
     1988                           when "b-help" then
     1989                               do:
     1990                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1991                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1992                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1993                                   hh:TOOLTIP = "Помощь" .
     1994                                   v-help-old-x = hh:column .
     1995                                   v-help-old-y = hh:row    .
     1996                                   v-help-old-size = hh:width .
     1997                                   hh:width-chars = 2.5 .
     1998                               end.
     1999                           when "b-print" then
     2000                               do:
     2001                                   hh:load-image("cmp/b-print.bmp":u) .
     2002                                   hh:TOOLTIP = "Печать" .
     2003                                   v-h[ii] = hh:handle .
     2004                                   ii = ii + 1 .
     2005                                   hh:width-chars = 3 .
     2006                               end.
     2007                           when "b-history" or
     2008                           when "b-hist" then
     2009                               do:
     2010                                   hh:load-image("cmp/b-hist.bmp":u) .
     2011                                   hh:TOOLTIP = "История" .
     2012                                   v-h[ii] = hh:handle .
     2013                                   ii = ii + 1 .
     2014                                   hh:width-chars = 3 .
     2015                               end.
     2016                           when "b-sch" then
     2017                               do:
     2018                                   hh:load-image("cmp/b-sch.bmp":u) .
     2019                                   hh:TOOLTIP = "Установка Фильтра" .
     2020                                   v-h[ii] = hh:handle .
     2021                                   ii = ii + 1 .
     2022                                   hh:width-chars = 3 .
     2023                               end.
     2024                           when "b-hist-user" then
     2025                               do:
     2026                                   hh:load-image("cmp/b-hist.bmp":u) .
     2027                                   hh:TOOLTIP = "История пользователя" .
     2028                                   ii = ii + 1 .
     2029                               end.
     2030                       end case.
     2031                   end.
     2032                   hh = hh:next-sibling.
     2033               end.
     2034               b-help:column = v-frame-width - b-help:width-chars.
     2035               jj = 0.
     2036               repeat ii = 4 to 1 by -1 :
     2037                   if valid-handle (v-h[ii] ) then
     2038                   do:
     2039                       jj  = jj + 1 .
     2040                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2041                       v-h[ii]:row    = v-help-old-y .
     2042                   end.
     2043               end.
     2044           end.
     2045       end.
     2046   end procedure.
     2047   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2048   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2049   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2050   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2051   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2052   define variable v-diasize-current-frame-height as decimal   no-undo .
     2053   define variable v-diasize-change-size          as logical   no-undo .
     2054   define variable v-diasize-resize-button        as handle    no-undo .
     2055   define variable v-diasize-wndmax               as logical   no-undo .
     2056   define variable v-diasize-wndstore             as logical   no-undo .
     2057   define variable v-diasize-proc-name            as character no-undo .
     2058   define variable v-diasize-browse-handle        as handle    no-undo .
     2059   define variable v-diasize-browse-number        as integer   no-undo .
     2060   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2061   define temp-table temp-diasize-handle no-undo
     2062     field handle-value  as handle
     2063     field save-position as decimal
     2064     index xpk is primary unique handle-value
     2065     .
     2066   define temp-table temp-browse-handle no-undo
     2067     field browse-type   as character
     2068     field browse-number as integer
     2069     field browse-handle as handle
     2070     field original-size as decimal
     2071     index xpk is primary unique browse-type browse-number
     2072     index xie browse-type browse-handle
     2073   .
     2074   procedure diasize_change-height :
     2075     define input  parameter p-change-value  as decimal   no-undo .
     2076     define input  parameter p-move-resize   as logical   no-undo .
     2077     define variable v-field-group-handle    as handle    no-undo .
     2078     define variable v-object-handle         as handle    no-undo .
     2079     define variable v-frame-height          as decimal   no-undo .
     2080     define variable v-frame-virtual-height  as decimal   no-undo .
     2081     define variable v-browse-height         as decimal   no-undo .
     2082     define variable v-window-height         as decimal   no-undo .
     2083     define variable v-window-virtual-height as decimal   no-undo .
     2084     define variable v-change-sign           as integer   no-undo .
     2085     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2086     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2087     if p-change-value > 0
     2088     then do:
     2089       if frame Dialog-Frame :height + p-change-value
     2090           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2091       then do:
     2092         assign
     2093           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2094                           - (frame Dialog-Frame :height-chars)
     2095         .
     2096         if p-change-value <= 0
     2097         then do:
     2098           run diasize_position-resize-button in this-procedure .
     2099           return .
     2100         end.
     2101       end.
     2102     end.
     2103     if p-change-value < 0
     2104     then do:
     2105       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2106       then do:
     2107         assign
     2108           p-change-value = v-diasize-orig-frame-height
     2109                          - (frame Dialog-Frame :height-chars)
     2110         .
     2111         if p-change-value >= 0
     2112         then do:
     2113           run diasize_position-resize-button in this-procedure .
     2114           return .
     2115         end.
     2116       end.
     2117     end.
     2118     if p-change-value >= 0
     2119     then do:
     2120       assign
     2121         v-change-sign = 1
     2122       .
     2123     end.
     2124     else do:
     2125       assign
     2126         v-change-sign = -1
     2127       .
     2128     end.
     2129     assign
     2130       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2131     .
     2132     if p-change-value = 0
     2133     then do:
     2134       run diasize_position-resize-button in this-procedure .
     2135       return .
     2136     end.
     2137     move_block:
     2138     do
     2139     on error undo move_block, retry move_block
     2140     :
     2141       if retry
     2142       then do:
     2143         do
     2144         on error undo move_block, leave move_block
     2145         :
     2146           if p-change-value > 0
     2147           then do:
     2148             for each buf_temp-diasize-handle
     2149             on error undo, next
     2150             :
     2151               assign
     2152                 v-object-handle = buf_temp-diasize-handle.handle-value
     2153               .
     2154               if v-object-handle <> v-diasize-resize-button
     2155               then do:
     2156                 assign
     2157                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2158                 .
     2159               end.
     2160             end.
     2161             assign
     2162               v-diasize-browse-handle :height = v-browse-height
     2163             .
     2164             for each buf_temp-browse-handle
     2165               where buf_temp-browse-handle.browse-type = 'height':u
     2166             on error undo, next
     2167             :
     2168               assign
     2169                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2170               .
     2171             end.
     2172             assign
     2173               frame Dialog-Frame :height = v-frame-height
     2174             .
     2175             if frame Dialog-Frame :scrollable = true
     2176             then do:
     2177               assign
     2178                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2179               .
     2180             end.
     2181             run diasize_position-resize-button in this-procedure .
     2182           end.
     2183           else do:
     2184             if frame Dialog-Frame :scrollable = true
     2185             then do:
     2186               assign
     2187                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2188               .
     2189             end.
     2190             assign
     2191               frame Dialog-Frame :height = v-frame-height
     2192             .
     2193             assign
     2194               v-diasize-browse-handle :height = v-browse-height
     2195             .
     2196             for each buf_temp-browse-handle
     2197               where buf_temp-browse-handle.browse-type = 'height':u
     2198             on error undo, next
     2199             :
     2200               assign
     2201                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2202               .
     2203             end.
     2204             for each buf_temp-diasize-handle
     2205             on error undo, next
     2206             :
     2207               assign
     2208                 v-object-handle = buf_temp-diasize-handle.handle-value
     2209               .
     2210               if v-object-handle <> v-diasize-resize-button
     2211               then do:
     2212                 assign
     2213                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2214                 .
     2215               end.
     2216             end.
     2217             run diasize_position-resize-button in this-procedure .
     2218           end.
     2219           assign
     2220             v-diasize-change-size = false
     2221           .
     2222           leave move_block .
     2223         end.
     2224       end.
     2225       assign
     2226         v-diasize-need-full-display = true
     2227       .
     2228       if v-diasize-change-size = false
     2229       then do:
     2230         assign
     2231           v-diasize-change-size = true
     2232         .
     2233       end.
     2234       else do:
     2235         return .
     2236       end.
     2237       assign
     2238         v-frame-height = frame Dialog-Frame :height
     2239         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2240         v-browse-height = v-diasize-browse-handle :height
     2241       .
     2242       for each buf_temp-browse-handle
     2243         where buf_temp-browse-handle.browse-type = 'height':u
     2244       :
     2245         assign
     2246           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2247         .
     2248       end.
     2249       for each buf_temp-diasize-handle
     2250       :
     2251         delete buf_temp-diasize-handle .
     2252       end.
     2253       assign
     2254         v-field-group-handle = frame Dialog-Frame :first-child
     2255       .
     2256       do while valid-handle(v-field-group-handle)
     2257       :
     2258         assign
     2259           v-object-handle = v-field-group-handle :first-child
     2260         .
     2261         do while valid-handle(v-object-handle)
     2262         :
     2263           if  v-object-handle <> v-diasize-browse-handle :handle
     2264           and can-query(v-object-handle, "row")
     2265           and can-query(v-object-handle, "height")
     2266           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2267           then do:
     2268             find first buf_temp-browse-handle
     2269               where buf_temp-browse-handle.browse-type   = 'height':u
     2270                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2271               no-error .
     2272             if available buf_temp-browse-handle
     2273             then do:
     2274             end.
     2275             else do:
     2276               create buf_temp-diasize-handle .
     2277               assign
     2278                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2279                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2280               .
     2281             end.
     2282           end.
     2283           assign
     2284             v-object-handle = v-object-handle :next-sibling
     2285           .
     2286         end.
     2287         assign
     2288           v-field-group-handle = v-field-group-handle :next-sibling
     2289         .
     2290       end.
     2291       do with frame Dialog-Frame
     2292       :
     2293         hide v-diasize-resize-button .
     2294         assign
     2295           v-diasize-resize-button :row    = 1
     2296           v-diasize-resize-button :column = 1
     2297         .
     2298       end.
     2299       if p-change-value > 0
     2300       then do:
     2301         if frame Dialog-Frame :scrollable = true
     2302         then do:
     2303           assign
     2304             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2305             no-error .
     2306           if error-status :error
     2307           or error-status :get-message(1) <> ""
     2308           then do:
     2309             undo move_block, retry move_block .
     2310           end.
     2311         end.
     2312         assign
     2313           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2314           no-error .
     2315         if error-status :error
     2316         or error-status :get-message(1) <> ""
     2317         then do:
     2318           undo move_block, retry move_block .
     2319         end.
     2320         assign
     2321           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2322           no-error .
     2323         if error-status :error
     2324         or error-status :get-message(1) <> ""
     2325         then do:
     2326           undo move_block, retry move_block .
     2327         end.
     2328         for each buf_temp-browse-handle
     2329           where buf_temp-browse-handle.browse-type = 'height':u
     2330         on error undo move_block, retry move_block
     2331         :
     2332           assign
     2333             buf_temp-browse-handle.browse-handle :height
     2334               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2335             no-error .
     2336           if error-status :error
     2337           or error-status :get-message(1) <> ""
     2338           then do:
     2339             undo move_block, retry move_block .
     2340           end.
     2341         end.
     2342         for each buf_temp-diasize-handle
     2343         on error undo move_block, retry move_block
     2344         :
     2345           assign
     2346             v-object-handle = buf_temp-diasize-handle.handle-value
     2347           .
     2348           if v-object-handle <> v-diasize-resize-button
     2349           then do:
     2350             assign
     2351               v-object-handle :row = v-object-handle :row + p-change-value
     2352               no-error .
     2353             if error-status :error
     2354             or error-status :get-message(1) <> ""
     2355             then do:
     2356               undo move_block, retry move_block .
     2357             end.
     2358           end.
     2359         end.
     2360       end.
     2361       else do:
     2362         for each buf_temp-diasize-handle
     2363         on error undo move_block, retry move_block
     2364         :
     2365           assign
     2366             v-object-handle = buf_temp-diasize-handle.handle-value
     2367           .
     2368           if v-object-handle <> v-diasize-resize-button
     2369           then do:
     2370             assign
     2371               v-object-handle :row = v-object-handle :row + p-change-value
     2372               no-error .
     2373             if error-status :error
     2374             or error-status :get-message(1) <> ""
     2375             then do:
     2376               undo move_block, retry move_block .
     2377             end.
     2378           end.
     2379         end.
     2380         assign
     2381           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2382           no-error .
     2383         if error-status :error
     2384         or error-status :get-message(1) <> ""
     2385         then do:
     2386           undo move_block, retry move_block .
     2387         end.
     2388         for each buf_temp-browse-handle
     2389           where buf_temp-browse-handle.browse-type = 'height':u
     2390         on error undo move_block, retry move_block
     2391         :
     2392           assign
     2393             buf_temp-browse-handle.browse-handle :height
     2394               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2395             no-error .
     2396           if error-status :error
     2397           or error-status :get-message(1) <> ""
     2398           then do:
     2399             undo move_block, retry move_block .
     2400           end.
     2401         end.
     2402         assign
     2403           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2404           no-error .
     2405         if error-status :error
     2406         or error-status :get-message(1) <> ""
     2407         then do:
     2408           undo move_block, retry move_block .
     2409         end.
     2410         if frame Dialog-Frame :scrollable = true
     2411         then do:
     2412           assign
     2413             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2414             no-error .
     2415           if error-status :error
     2416           or error-status :get-message(1) <> ""
     2417           then do:
     2418             undo move_block, retry move_block .
     2419           end.
     2420         end.
     2421       end.
     2422       if p-move-resize = true
     2423       then do:
     2424         run diasize_position-resize-button in this-procedure .
     2425       end.
     2426       if v-diasize-wndstore = true
     2427       then do:
     2428         if connected("ub") = true
     2429         then do:
     2430           define variable v-cntxt-db-num        as integer   no-undo .
     2431           define variable v-cntxt-userid        as character no-undo .
     2432           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2433                                             , OUTPUT v-cntxt-userid
     2434                                             ) .
     2435           run gbl/wndsizew.p
     2436             (input  v-cntxt-db-num
     2437             ,input  v-cntxt-userid
     2438             ,input  v-diasize-proc-name
     2439             ,input  'height':u
     2440             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2441             ) .
     2442         end.
     2443       end.
     2444     end.
     2445     assign
     2446       v-diasize-change-size = false
     2447     .
     2448   end procedure.
     2449   procedure diasize_set-height :
     2450     define input  parameter p-new-height  as decimal   no-undo .
     2451     define input  parameter p-move-resize as logical   no-undo .
     2452     do
     2453     on error undo, return error return-value
     2454     :
     2455       run diasize_change-height in this-procedure
     2456         (input  (p-new-height - frame Dialog-Frame :height)
     2457         ,input  p-move-resize
     2458         ) .
     2459     end.
     2460   end procedure.
     2461   procedure diasize_change-width :
     2462     define input  parameter p-change-value as decimal   no-undo .
     2463     define input  parameter p-move-resize  as logical   no-undo .
     2464     define variable v-field-group-handle   as handle    no-undo .
     2465     define variable v-object-handle        as handle    no-undo .
     2466     define variable v-frame-width          as decimal   no-undo .
     2467     define variable v-frame-virtual-width  as decimal   no-undo .
     2468     define variable v-browse-width         as decimal   no-undo .
     2469     define variable v-window-width         as decimal   no-undo .
     2470     define variable v-window-virtual-width as decimal   no-undo .
     2471     define variable v-change-sign          as integer   no-undo .
     2472     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2473     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2474     if p-change-value > 0
     2475     then do:
     2476       if frame Dialog-Frame :width + p-change-value >
     2477           session :width-chars
     2478       then do:
     2479         assign
     2480           p-change-value = session :width-chars - frame Dialog-Frame :width
     2481         .
     2482         if p-change-value <= 0
     2483         then do:
     2484           run diasize_position-resize-button in this-procedure .
     2485           return .
     2486         end.
     2487       end.
     2488     end.
     2489     if p-change-value < 0
     2490     then do:
     2491       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2492       then do:
     2493         assign
     2494           p-change-value = v-diasize-orig-frame-width
     2495                          - frame Dialog-Frame :width
     2496         .
     2497         if p-change-value >= 0
     2498         then do:
     2499           run diasize_position-resize-button in this-procedure .
     2500           return .
     2501         end.
     2502       end.
     2503     end.
     2504     if p-change-value >= 0
     2505     then do:
     2506       assign
     2507         v-change-sign = 1
     2508       .
     2509     end.
     2510     else do:
     2511       assign
     2512         v-change-sign = -1
     2513       .
     2514     end.
     2515     assign
     2516       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2517     .
     2518     if p-change-value = 0
     2519     then do:
     2520       run diasize_position-resize-button in this-procedure .
     2521       return .
     2522     end.
     2523     move_block:
     2524     do
     2525     on error undo move_block, leave move_block
     2526     :
     2527       if retry
     2528       then do:
     2529         do
     2530         on error undo move_block, leave move_block
     2531         :
     2532           if p-change-value > 0
     2533           then do:
     2534             for each buf_temp-diasize-handle
     2535             on error undo, next
     2536             :
     2537               assign
     2538                 v-object-handle = buf_temp-diasize-handle.handle-value
     2539               .
     2540               if v-object-handle <> v-diasize-resize-button
     2541               then do:
     2542                 assign
     2543                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2544                 .
     2545               end.
     2546             end.
     2547             assign
     2548               v-diasize-browse-handle :width = v-browse-width
     2549             .
     2550             for each buf_temp-browse-handle
     2551               where buf_temp-browse-handle.browse-type = 'width':u
     2552             on error undo, next
     2553             :
     2554               assign
     2555                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2556               .
     2557             end.
     2558             assign
     2559               frame Dialog-Frame :width = v-frame-width
     2560             .
     2561             if frame Dialog-Frame :scrollable = true
     2562             then do:
     2563               assign
     2564                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2565               .
     2566             end.
     2567             run diasize_position-resize-button in this-procedure .
     2568           end.
     2569           else do:
     2570             if frame Dialog-Frame :scrollable = true
     2571             then do:
     2572               assign
     2573                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2574               .
     2575             end.
     2576             assign
     2577               frame Dialog-Frame :width = v-frame-width
     2578             .
     2579             for each buf_temp-browse-handle
     2580               where buf_temp-browse-handle.browse-type = 'width':u
     2581             on error undo, next
     2582             :
     2583               assign
     2584                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2585               .
     2586             end.
     2587             assign
     2588               v-diasize-browse-handle :width = v-browse-width
     2589             .
     2590             for each buf_temp-diasize-handle
     2591             on error undo, next
     2592             :
     2593               assign
     2594                 v-object-handle = buf_temp-diasize-handle.handle-value
     2595               .
     2596               if v-object-handle <> v-diasize-resize-button
     2597               then do:
     2598                 assign
     2599                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2600                 .
     2601               end.
     2602             end.
     2603             run diasize_position-resize-button in this-procedure .
     2604           end.
     2605           assign
     2606             v-diasize-change-size = false
     2607           .
     2608           leave move_block .
     2609         end.
     2610       end.
     2611       assign
     2612         v-diasize-need-full-display = true
     2613       .
     2614       if v-diasize-change-size = false
     2615       then do:
     2616         assign
     2617           v-diasize-change-size = true
     2618         .
     2619       end.
     2620       else do:
     2621         return .
     2622       end.
     2623       assign
     2624         v-frame-width = frame Dialog-Frame :width
     2625         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2626         v-browse-width = v-diasize-browse-handle :width
     2627       .
     2628       for each buf_temp-browse-handle
     2629         where buf_temp-browse-handle.browse-type = 'width':u
     2630       :
     2631         assign
     2632           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2633         .
     2634       end.
     2635       for each buf_temp-diasize-handle
     2636       :
     2637         delete buf_temp-diasize-handle .
     2638       end.
     2639       assign
     2640         v-field-group-handle = frame Dialog-Frame :first-child
     2641       .
     2642       do while valid-handle(v-field-group-handle)
     2643       :
     2644         assign
     2645           v-object-handle = v-field-group-handle :first-child
     2646         .
     2647         do while valid-handle(v-object-handle)
     2648         :
     2649           if  v-object-handle <> v-diasize-browse-handle :handle
     2650           and v-object-handle <> v-diasize-resize-button
     2651           and can-query(v-object-handle, "row")
     2652           and can-query(v-object-handle, "height")
     2653           and ( v-object-handle :col + v-object-handle :width
     2654                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2655               )
     2656           then do:
     2657             find first buf_temp-browse-handle
     2658               where buf_temp-browse-handle.browse-type   = 'width':u
     2659                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2660               no-error .
     2661             if available buf_temp-browse-handle
     2662             then do:
     2663             end.
     2664             else do:
     2665               create buf_temp-diasize-handle .
     2666               assign
     2667                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2668                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2669               .
     2670             end.
     2671           end.
     2672           assign
     2673             v-object-handle = v-object-handle :next-sibling
     2674           .
     2675         end.
     2676         assign
     2677           v-field-group-handle = v-field-group-handle :next-sibling
     2678         .
     2679       end.
     2680       do with frame Dialog-Frame
     2681       :
     2682         hide v-diasize-resize-button .
     2683         v-diasize-resize-button :row = 1.
     2684         v-diasize-resize-button :column = 1.
     2685       end.
     2686       if p-change-value > 0
     2687       then do:
     2688         if frame Dialog-Frame :scrollable = true
     2689         then do:
     2690           assign
     2691             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2692             no-error .
     2693           if error-status :error
     2694           or error-status :get-message(1) <> ""
     2695           then do:
     2696             undo move_block, retry move_block.
     2697           end.
     2698         end.
     2699         assign
     2700           frame Dialog-Frame :width = v-frame-width + p-change-value
     2701           no-error .
     2702         if error-status :error
     2703         or error-status :get-message(1) <> ""
     2704         then do:
     2705           undo move_block, retry move_block.
     2706         end.
     2707         assign
     2708           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2709         no-error .
     2710         if error-status :error
     2711         or error-status :get-message(1) <> ""
     2712         then do:
     2713           undo move_block, retry move_block.
     2714         end.
     2715         for each buf_temp-browse-handle
     2716           where buf_temp-browse-handle.browse-type = 'width':u
     2717         on error undo move_block, retry move_block
     2718         :
     2719           assign
     2720             buf_temp-browse-handle.browse-handle :width
     2721               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2722             no-error .
     2723           if error-status :error
     2724           or error-status :get-message(1) <> ""
     2725           then do:
     2726             undo move_block, retry move_block .
     2727           end.
     2728         end.
     2729         for each buf_temp-diasize-handle
     2730         on error undo move_block, retry move_block
     2731         :
     2732           assign
     2733             v-object-handle = buf_temp-diasize-handle.handle-value
     2734           .
     2735           if v-object-handle <> v-diasize-resize-button
     2736           then do:
     2737             assign
     2738               v-object-handle :col = v-object-handle :col + p-change-value
     2739               no-error .
     2740             if error-status :error
     2741             or error-status :get-message(1) <> ""
     2742             then do:
     2743               undo move_block, retry move_block .
     2744             end.
     2745           end.
     2746         end.
     2747       end.
     2748       else do:
     2749         for each buf_temp-diasize-handle
     2750         on error undo move_block, retry move_block
     2751         :
     2752           assign
     2753             v-object-handle = buf_temp-diasize-handle.handle-value
     2754           .
     2755           if v-object-handle <> v-diasize-resize-button
     2756           then do:
     2757             assign
     2758               v-object-handle :col = v-object-handle :col + p-change-value
     2759               no-error .
     2760             if error-status :error
     2761             or error-status :get-message(1) <> ""
     2762             then do:
     2763               undo move_block, retry move_block .
     2764             end.
     2765           end.
     2766         end.
     2767         for each buf_temp-browse-handle
     2768           where buf_temp-browse-handle.browse-type = 'width':u
     2769         on error undo move_block, retry move_block
     2770         :
     2771           assign
     2772             buf_temp-browse-handle.browse-handle :width
     2773               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2774             no-error .
     2775           if error-status :error
     2776           or error-status :get-message(1) <> ""
     2777           then do:
     2778             undo move_block, retry move_block .
     2779           end.
     2780         end.
     2781         assign
     2782           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2783           no-error .
     2784         if error-status :error
     2785         or error-status :get-message(1) <> ""
     2786         then do:
     2787           undo move_block, retry move_block.
     2788         end.
     2789         assign
     2790           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2791         no-error .
     2792         if error-status :error
     2793         or error-status :get-message(1) <> ""
     2794         then do:
     2795           undo move_block, retry move_block.
     2796         end.
     2797         if frame Dialog-Frame :scrollable = true
     2798         then do:
     2799           assign
     2800             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2801           no-error .
     2802           if error-status :error
     2803           or error-status :get-message(1) <> ""
     2804           then do:
     2805             undo move_block, retry move_block.
     2806           end.
     2807         end.
     2808       end.
     2809       if p-move-resize
     2810       then do:
     2811         run diasize_position-resize-button in this-procedure .
     2812       end.
     2813       if v-diasize-wndstore = true
     2814       then do:
     2815         if connected("ub") = true
     2816         then do:
     2817           define variable v-cntxt-db-num        as integer   no-undo .
     2818           define variable v-cntxt-userid        as character no-undo .
     2819           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2820                                             , OUTPUT v-cntxt-userid
     2821                                             ) .
     2822           run gbl/wndsizew.p
     2823             (input  v-cntxt-db-num
     2824             ,input  v-cntxt-userid
     2825             ,input  v-diasize-proc-name
     2826             ,input  'width':u
     2827             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2828             ) .
     2829         end.
     2830       end.
     2831     end.
     2832     assign
     2833       v-diasize-change-size = false
     2834     .
     2835   end procedure.
     2836   procedure diasize_set-width :
     2837     define input  parameter p-new-width  as decimal   no-undo .
     2838     define input  parameter p-move-resize as logical   no-undo .
     2839     do
     2840     on error undo, return error return-value
     2841     :
     2842       run diasize_change-width in this-procedure
     2843         (input  (p-new-width - frame Dialog-Frame :width)
     2844         ,input  p-move-resize
     2845         ) .
     2846     end.
     2847   end procedure.
     2848   procedure diasize_position-resize-button :
     2849     do with frame Dialog-Frame
     2850     :
     2851       hide v-diasize-resize-button .
     2852       assign
     2853         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2854                     - 1
     2855                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2856         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2857                     - 1
     2858                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2859       .
     2860       view v-diasize-resize-button .
     2861     end.
     2862   end procedure.
     2863   on alt-right anywhere
     2864   do:
     2865     run diasize_change-width in this-procedure
     2866       (input 1
     2867       ,input true
     2868       ) .
     2869     return no-apply .
     2870   end.
     2871   on alt-left anywhere
     2872   do:
     2873     run diasize_change-width in this-procedure
     2874       (input -1
     2875       ,input true
     2876       ) .
     2877     return no-apply .
     2878   end.
     2879   on alt-down anywhere
     2880   do:
     2881     run diasize_change-height in this-procedure
     2882       (input 1
     2883       ,input true
     2884       ) .
     2885     return no-apply .
     2886   end.
     2887   on alt-up anywhere
     2888   do:
     2889     run diasize_change-height in this-procedure
     2890       (input -1
     2891       ,input true
     2892       ) .
     2893     return no-apply .
     2894   end.
     2895   on alt-enter of frame Dialog-Frame
     2896   do:
     2897     run diasize_maximize in this-procedure
     2898       (input  ?
     2899       ).
     2900     return no-apply .
     2901   end.
     2902   procedure diasize_end-move :
     2903     do
     2904     on error undo, return error return-value
     2905     :
     2906       define variable v-row-delta as decimal   no-undo .
     2907       define variable v-col-delta as decimal   no-undo .
     2908       define variable v-new-row as decimal   no-undo .
     2909       define variable v-new-col as decimal   no-undo .
     2910       assign
     2911         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2912         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2913       .
     2914       assign
     2915         v-row-delta = v-new-row - frame Dialog-Frame :height
     2916         v-col-delta = v-new-col - frame Dialog-Frame :width
     2917       .
     2918       run diasize_change-height in this-procedure
     2919         (input v-row-delta
     2920         ,input true
     2921         ) .
     2922       run diasize_change-width in this-procedure
     2923         (input v-col-delta
     2924         ,input true
     2925         ) .
     2926     end.
     2927   end procedure.
     2928   procedure diasize_maximize :
     2929     define input  parameter p-action as logical   no-undo .
     2930     do
     2931     on error undo, return error return-value
     2932     :
     2933       if p-action = ?
     2934       then do:
     2935         if v-diasize-need-maximize = true
     2936         then do:
     2937           assign
     2938             p-action = true
     2939           .
     2940         end.
     2941         else do:
     2942           assign
     2943             p-action = false
     2944           .
     2945         end.
     2946       end.
     2947       if p-action = true
     2948       then do:
     2949         run diasize_change-height in this-procedure
     2950           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2951               - frame Dialog-Frame :height-chars
     2952           ,input true
     2953           ) .
     2954         run diasize_change-width in this-procedure
     2955           (input session :width-chars
     2956               - frame Dialog-Frame :width-chars
     2957           ,input true
     2958           ) .
     2959         assign
     2960           v-diasize-need-maximize = false
     2961         .
     2962       end.
     2963       else do:
     2964         run diasize_change-width in this-procedure
     2965           (input v-diasize-orig-frame-width
     2966               - frame Dialog-Frame :width-chars
     2967           ,input true
     2968           ) .
     2969         run diasize_change-height in this-procedure
     2970           (input v-diasize-orig-frame-height
     2971               - frame Dialog-Frame :height-chars
     2972           ,input true
     2973           ) .
     2974         assign
     2975           v-diasize-need-maximize = true
     2976         .
     2977       end.
     2978     end.
     2979   end procedure.
     2980   procedure diasize_restore-orig-size :
     2981     do
     2982     on error undo, return error return-value
     2983     :
     2984       assign
     2985         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2986         v-diasize-current-frame-height = frame Dialog-Frame :height
     2987       .
     2988       run diasize_set-height in this-procedure
     2989         (input  v-diasize-orig-frame-height
     2990         ,input  true
     2991         ) .
     2992       run diasize_set-width in this-procedure
     2993         (input  v-diasize-orig-frame-width
     2994         ,input  true
     2995         ) .
     2996     end.
     2997   end procedure.
     2998   procedure diasize_restore-current-size :
     2999     do
     3000     on error undo, return error return-value
     3001     :
     3002       run diasize_set-height in this-procedure
     3003         (input  v-diasize-current-frame-height
     3004         ,input  true
     3005         ) .
     3006       run diasize_set-width in this-procedure
     3007         (input  v-diasize-current-frame-width
     3008         ,input  true
     3009         ) .
     3010     end.
     3011   end procedure.
     3012   procedure diasize_set-browse-handle :
     3013     define input  parameter p-browse-handle as handle   no-undo .
     3014     define buffer buf_temp-browse-handle for temp-browse-handle .
     3015     do
     3016     on error undo, return error return-value
     3017     :
     3018       assign
     3019         v-diasize-browse-handle = p-browse-handle
     3020       .
     3021       for each buf_temp-browse-handle
     3022       on error undo, return error return-value
     3023       :
     3024         delete buf_temp-browse-handle .
     3025       end.
     3026     end.
     3027   end procedure.
     3028   procedure diasize_add_browse :
     3029     define input  parameter p-browse-type   as character no-undo .
     3030     define input  parameter p-browse-handle as handle    no-undo .
     3031     define buffer buf_temp-browse-handle for temp-browse-handle .
     3032     do
     3033     on error undo, return error return-value
     3034     :
     3035       assign
     3036         v-diasize-browse-number = v-diasize-browse-number + 1
     3037       .
     3038       create buf_temp-browse-handle .
     3039       assign
     3040         buf_temp-browse-handle.browse-type   = p-browse-type
     3041         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3042         buf_temp-browse-handle.browse-handle = p-browse-handle
     3043       .
     3044     end.
     3045   end procedure.
     3046   procedure diasize_init :
     3047     define variable v-default-value    as logical   no-undo .
     3048     define variable v-restore-saved    as logical   no-undo .
     3049     define variable v-resize-value-str as character no-undo .
     3050     do
     3051     on error undo, return error return-value
     3052     :
     3053       do with frame Dialog-Frame
     3054       :
     3055         assign
     3056           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3057           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3058           v-diasize-browse-handle     = browse BR-specgrp :handle
     3059         .
     3060         create button v-diasize-resize-button
     3061         assign
     3062           parent        = frame Dialog-Frame :first-child
     3063           label         = "s"
     3064           height-pixels = 16
     3065           width-pixels  = 16
     3066           visible       = true
     3067           sensitive     = true
     3068           movable       = true
     3069           triggers:
     3070             on end-move persistent run diasize_end-move in this-procedure .
     3071           end triggers.
     3072         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3073         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3074         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3075         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3076         assign
     3077           v-diasize-wndmax = false
     3078         .
     3079         if connected("ub") = true
     3080         then do:
     3081           define variable v-cntxt-db-num        as integer   no-undo .
     3082           define variable v-cntxt-userid        as character no-undo .
     3083           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3084                                             , OUTPUT v-cntxt-userid
     3085                                             ) .
     3086           run gbl/wndpar_r.p
     3087             (input  v-cntxt-db-num
     3088             ,input  v-cntxt-userid
     3089             ,input  'wndmax':U
     3090             ,output v-diasize-wndmax
     3091             ,output v-default-value
     3092             ) .
     3093         end.
     3094         assign
     3095           v-diasize-wndstore = false
     3096         .
     3097         if connected("ub") = true
     3098         then do:
     3099           run gbl/wndpar_r.p
     3100             (input  v-cntxt-db-num
     3101             ,input  v-cntxt-userid
     3102             ,input  'wndstore':U
     3103             ,output v-diasize-wndstore
     3104             ,output v-default-value
     3105             ) .
     3106         end.
     3107         assign
     3108           v-diasize-proc-name = entry(1, program-name(2), '.')
     3109         .
     3110         if v-diasize-wndstore = true
     3111         then do:
     3112           assign
     3113             v-restore-saved = false
     3114           .
     3115           if connected("ub") = true
     3116           then do:
     3117             run gbl/wndsizer.p
     3118               (input  v-cntxt-db-num
     3119               ,input  v-cntxt-userid
     3120               ,input  v-diasize-proc-name
     3121               ,input  'height':u
     3122               ,output v-resize-value-str
     3123               ) .
     3124             if v-resize-value-str <> '':U
     3125             then do:
     3126               run diasize_change-height in this-procedure
     3127                 (input  integer(v-resize-value-str)
     3128                 ,input  true
     3129                 ) .
     3130               assign
     3131                 v-restore-saved = true
     3132               .
     3133             end.
     3134           end.
     3135           if connected("ub") = true
     3136           then do:
     3137             run gbl/wndsizer.p
     3138               (input  v-cntxt-db-num
     3139               ,input  v-cntxt-userid
     3140               ,input  v-diasize-proc-name
     3141               ,input  'width':u
     3142               ,output v-resize-value-str
     3143               ) .
     3144             if v-resize-value-str <> '':U
     3145             then do:
     3146               run diasize_change-width in this-procedure
     3147                 (input  integer(v-resize-value-str)
     3148                 ,input  true
     3149                 ) .
     3150               assign
     3151                 v-restore-saved = true
     3152               .
     3153             end.
     3154           end.
     3155           if v-restore-saved <> true
     3156           then do:
     3157             if v-diasize-wndmax = true
     3158             then do:
     3159               run diasize_maximize in this-procedure
     3160                 (input  true
     3161                 ) .
     3162             end.
     3163           end.
     3164         end.
     3165         else do:
     3166           if v-diasize-wndmax = true
     3167           then do:
     3168             run diasize_maximize in this-procedure
     3169               (input  true
     3170               ) .
     3171           end.
     3172         end.
     3173       end.
     3174     end.
     3175   end procedure.
     3176   procedure diasize_need-full-display :
     3177     define output parameter p-need-full-display as logical   no-undo .
     3178     do
     3179     on error undo, return error return-value
     3180     :
     3181       assign
     3182         p-need-full-display = v-diasize-need-full-display
     3183       .
     3184       assign
     3185         v-diasize-need-full-display = false
     3186       .
     3187     end.
     3188   end procedure.
     3189   procedure get-context :
     3190      define output parameter p-db-num as integer          no-undo.
     3191      define output parameter p-user-id as character        no-undo.
     3192      define variable v-login               as character    no-undo.
     3193      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3194      define buffer buf_user-login  for ub.user-login .
     3195      do
     3196      on error undo, return error
     3197      :
     3198            FIND FIRST buf_sys-ctrl no-lock.
     3199            ASSIGN
     3200               v-login = USERID("ub")
     3201               p-db-num = buf_sys-ctrl.db-num
     3202            .
     3203            FIND FIRST buf_user-login
     3204                 WHERE buf_user-login.db-num = p-db-num
     3205                   AND buf_user-login.user-login = v-login
     3206                 no-lock
     3207                 no-error
     3208                 .
     3209            IF AVAILABLE buf_user-login
     3210            THEN DO:
     3211               assign
     3212                  p-user-id = buf_user-login.user-id
     3213               .
     3214            END.
     3215      end.
     3216   end procedure.
     3217       run diasize_init in this-procedure .
     3218   MAIN-BLOCK:
     3219   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3220      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3221   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3222     run mainmenu_getcntxt in parparentproc
     3223       (output v-cntxt-db-num
     3224       ,output v-cntxt-userid
     3225       ,output v-cntxt-level
     3226       ,output v-cntxt-host-code-obj
     3227       ,output v-cntxt-obj-type
     3228       ,output v-cntxt-obj-code
     3229       ,output v-cntxt-db-num-obj
     3230       ,output v-cntxt-is-admin
     3231       ) .
     3232   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3233   ON TAB ANYWHERE
     3234   DO:
     3235   define variable ii as integer no-undo .
     3236   define variable fh as widget-handle no-undo .
     3237   define variable hh as widget-handle no-undo .
     3238   define variable v-next-widget-name as character no-undo .
     3239   if v-tab-order <> '' then do:
     3240     if self:type = "TOGGLE-BOX" then
     3241     self:BGCOLOR = ?.
     3242     assign
     3243     ii = lookup(self:name, v-tab-order).
     3244     assign
     3245     ii = ii + 1
     3246     v-next-widget-name = entry(ii, v-tab-order)
     3247     no-error .
     3248     if error-status:error then do:
     3249       assign
     3250       ii = 1
     3251       v-next-widget-name = entry( ii, v-tab-order)
     3252       .
     3253     end.
     3254     assign
     3255     fh = frame Dialog-Frame:first-child
     3256     hh = fh:first-child
     3257     .
     3258     do while valid-handle(hh):
     3259       if hh:name = v-next-widget-name then do:
     3260         if hh:sensitive  = yes
     3261         AND hh:visible = yes then do:
     3262           if hh:type = "TOGGLE-BOX":U then do:
     3263             assign
     3264             hh:BGcolor = 1
     3265             .
     3266           end.
     3267           APPLY "ENTRY" to hh.
     3268           return no-apply.
     3269         end.
     3270         else do:
     3271           APPLY "TAB" to hh.
     3272           return no-apply.
     3273         end.
     3274       end.
     3275       hh = hh:next-sibling.
     3276     end.
     3277   end.
     3278   END.
     3279   ON BACK-TAB ANYWHERE
     3280   DO:
     3281   define variable ii as integer no-undo .
     3282   define variable fh as widget-handle no-undo .
     3283   define variable hh as widget-handle no-undo .
     3284   define variable v-next-widget-name as character no-undo .
     3285   if v-tab-order <> '' then do:
     3286     assign
     3287     ii = lookup(self:name, v-tab-order).
     3288     .
     3289     assign
     3290     ii = (if ii = 1
     3291           then  num-entries(v-tab-order)
     3292           else ii - 1
     3293           )
     3294     v-next-widget-name = entry(ii, v-tab-order)
     3295     .
     3296     assign
     3297     fh = frame Dialog-Frame:first-child
     3298     hh = fh:first-child
     3299     .
     3300     do while valid-handle(hh):
     3301       if hh:name = v-next-widget-name then do:
     3302         if hh:sensitive  = yes
     3303         AND hh:visible = yes then do:
     3304           if hh:type = "TOGGLE-BOX":U then do:
     3305             assign
     3306             hh:BGcolor = 1
     3307             .
     3308           end.
     3309           APPLY "ENTRY" to hh.
     3310           return no-apply.
     3311         end.
     3312         else do:
     3313         APPLY "BACK-TAB" to hh.
     3314         return no-apply.
     3315         end.
     3316       end.
     3317       hh = hh:next-sibling.
     3318     end.
     3319     end.
     3320   END.
     3321   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3322   ON RETURN ANYWHERE
     3323   DO:
     3324   define variable ii as integer no-undo .
     3325   define variable fh as widget-handle no-undo .
     3326   define variable hh as widget-handle no-undo .
     3327   define variable v-next-widget-name as character no-undo .
     3328     if v-tab-order <> '' then do:
     3329       assign
     3330       ii = lookup(self:name, v-tab-order).
     3331       if ii = num-entries(v-tab-order) then do:
     3332           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     3333           return no-apply.
     3334       end.
     3335       if self:type <> "BUTTON" and
     3336         self:type <> "EDITOR"  then do:
     3337         run proc-move-forward in this-procedure .
     3338         return no-apply.
     3339       end.
     3340       if self:type = "BUTTON" then do:
     3341         APPLY "CHOOSE" to self.
     3342       end.
     3343       if self:type = "TOGGLE-BOX" then
     3344       self:BGCOLOR = ?.
     3345       assign
     3346       ii = ii + 1
     3347       v-next-widget-name = entry(ii, v-tab-order)
     3348       no-error .
     3349       if error-status:error then do:
     3350         assign
     3351         ii = 1
     3352         v-next-widget-name = entry( ii, v-tab-order)
     3353         .
     3354       end.
     3355       assign
     3356       fh = frame Dialog-Frame:first-child
     3357       hh = fh:first-child
     3358       .
     3359       do while valid-handle(hh):
     3360         if hh:name = v-next-widget-name then do:
     3361           if hh:sensitive  = yes
     3362           AND hh:visible = yes then do:
     3363             if hh:type = "TOGGLE-BOX":U then do:
     3364               assign
     3365               hh:BGcolor = 1
     3366               .
     3367             end.
     3368             APPLY "ENTRY" to hh.
     3369             return no-apply.
     3370           end.
     3371           else do:
     3372             APPLY "TAB" to hh.
     3373             return no-apply.
     3374           end.
     3375         end.
     3376         hh = hh:next-sibling.
     3377       end.
     3378     end.
     3379   END.
     3380   procedure proc-move-forward :
     3381   define variable ii as integer no-undo .
     3382   define variable fh as widget-handle no-undo .
     3383   define variable hh as widget-handle no-undo .
     3384   define variable v-next-widget-name as character no-undo .
     3385   do
     3386   on error undo, return error
     3387   :
     3388     if v-tab-order <> '' then do:
     3389       if self:type = "TOGGLE-BOX" then
     3390       self:BGCOLOR = ?.
     3391       assign
     3392       ii = lookup(self:name, v-tab-order).
     3393       assign
     3394       ii = ii + 1
     3395       v-next-widget-name = entry(ii, v-tab-order)
     3396       no-error .
     3397       if error-status:error then do:
     3398         assign
     3399         ii = 1
     3400         v-next-widget-name = entry( ii, v-tab-order)
     3401         .
     3402       end.
     3403       assign
     3404       fh = frame Dialog-Frame:first-child
     3405       hh = fh:first-child
     3406       .
     3407       do while valid-handle(hh):
     3408         if hh:name = v-next-widget-name then do:
     3409           if hh:sensitive  = yes
     3410           AND hh:visible = yes then do:
     3411             if hh:type = "TOGGLE-BOX":U then do:
     3412               assign
     3413               hh:BGcolor = 1
     3414               .
     3415             end.
     3416             APPLY "ENTRY" to hh.
     3417             return.
     3418           end.
     3419           else do:
     3420             assign
     3421             ii = ii + 1
     3422             v-next-widget-name = entry(ii, v-tab-order)
     3423             no-error .
     3424             if error-status:error then do:
     3425               assign
     3426               ii = 1
     3427               v-next-widget-name = entry( ii, v-tab-order)
     3428               .
     3429             end.
     3430           end.
     3431         end.
     3432         hh = hh:next-sibling.
     3433       end.
     3434     end.
     3435   end.
     3436   end procedure.
     3437     IF p-mode <> 'ПРОСМОТР':U
     3438     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     3439         MESSAGE
     3440         vss-workfile vss-revision vss-description skip
     3441         "Неверное значение параметра p-mode" p-mode
     3442         VIEW-AS ALERT-BOX ERROR.
     3443         UNDO, RETURN ERROR.
     3444     END.
     3445     IF p-obj-type <> 'маг':U
     3446     and p-obj-type <> 'орг':U
     3447     and p-obj-type <> '':U
     3448     THEN DO:
     3449         MESSAGE
     3450         vss-workfile vss-revision vss-description skip
     3451         "Неверное значение параметра p-obj-type" p-obj-type
     3452         VIEW-AS ALERT-BOX ERROR.
     3453         UNDO, RETURN ERROR.
     3454     END.
     3455     if p-obj-type = 'маг':U then do:
     3456       FIND FIRST X_shop NO-LOCK WHERE X_shop.obj-code = p-obj-code NO-ERROR.
     3457       IF NOT AVAILABLE X_shop THEN DO:
     3458           MESSAGE
     3459           vss-workfile vss-revision vss-description skip
     3460           "Неверное значение параметра p-obj-code" p-obj-code
     3461           VIEW-AS ALERT-BOX ERROR.
     3462           UNDO, RETURN ERROR.
     3463       END.
     3464   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3465   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     3466     (input  'маг':U
     3467     ,input  p-obj-code
     3468     ,output v-db-num
     3469     )  .
     3470       IF v-db-num <> v-cntxt-db-num AND v-cntxt-db-num <> 0 THEN DO:
     3471           MESSAGE
     3472           "Нельзя менять параметры магазина в чужой БД" skip
     3473           "магазин принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     3474           VIEW-AS ALERT-BOX ERROR.
     3475           UNDO, RETURN ERROR.
     3476       END.
     3477   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3478   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3479     (input  p-obj-type
     3480     ,input  p-obj-code
     3481     ,output v-host-code
     3482     )  .
     3483     end.
     3484     if p-obj-type = 'орг':U then do:
     3485       FIND FIRST X_sysconf NO-LOCK WHERE X_sysconf.host-code = p-obj-code NO-ERROR.
     3486       IF NOT AVAILABLE X_sysconf THEN DO:
     3487           MESSAGE
     3488           vss-workfile vss-revision vss-description skip
     3489           "Неверное значение параметра p-obj-code" p-obj-code
     3490           VIEW-AS ALERT-BOX ERROR.
     3491           UNDO, RETURN ERROR.
     3492       END.
     3493       if v-cntxt-db-num <> 0
     3494       and p-mode <> 'ПРОСМОТР':U
     3495       then do:
     3496           MESSAGE
     3497           "Нельзя менять параметры ФИРМЫ в УБД" skip
     3498           VIEW-AS ALERT-BOX ERROR.
     3499           UNDO, RETURN ERROR.
     3500       end.
     3501       v-host-code = p-obj-code.
     3502     end.
     3503     if p-obj-type = '':U then do:
     3504       if v-cntxt-db-num <> 0
     3505       and p-mode <> 'ПРОСМОТР':U
     3506       then do:
     3507           MESSAGE
     3508           "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" skip
     3509           VIEW-AS ALERT-BOX ERROR.
     3510           UNDO, RETURN ERROR.
     3511       end.
     3512     end.
     3513     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     3514       FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
     3515                 LOCKED_thbj-attr.obj-type = p-obj-type
     3516           AND   LOCKED_thbj-attr.obj-code = p-obj-code
     3517           AND   LOCKED_thbj-attr.upper-prop-code = 'cd-type-ibm':U
     3518           AND   locked_thbj-attr.prop-code = '':U NO-WAIT NO-ERROR.
     3519        if locked locked_thbj-attr then do:
     3520           message
     3521           vss-workfile vss-revision vss-description skip
     3522            "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
     3523           view-as alert-box error .
     3524           undo, return error.
     3525         end.
     3526     END.
     3527     ELSE DO:
     3528         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
     3529             LOCKED_thbj-attr.obj-type = p-obj-type
     3530       AND   LOCKED_thbj-attr.obj-code = p-obj-code
     3531       AND   LOCKED_thbj-attr.upper-prop-code = 'cd-type-ibm':U
     3532       AND  locked_thbj-attr.prop-code = '':U NO-ERROR.
     3533     END.
     3534     if not available locked_thbj-attr then do:
     3535       ASSIGN
     3536       v-to-create  = YES.
     3537       message
     3538       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     3539                   chr(10))
     3540       view-as alert-box WARNING.
     3541     end.
     3542     run FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     3543     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     3544     run Myenable in this-procedure .
     3545     WAIT-FOR GO OF FRAME Dialog-Frame.
     3546   END.
     3547   run disable_UI in this-procedure .
     3548   PROCEDURE disable_UI :
     3549     HIDE FRAME Dialog-Frame.
     3550   END PROCEDURE.
     3551   PROCEDURE enable_UI :
     3552     DISPLAY f-ibmrubc f-ibmnalc RS-ibmspool T-multicurr RS-cd-vat t-ibmgroup
     3553             for-curr-name l-ibmspool l-cd-vat
     3554         WITH FRAME Dialog-Frame.
     3555     ENABLE B-exit b-quit B-Help f-ibmrubc f-ibmnalc b-curr RS-ibmspool
     3556            T-multicurr RS-cd-vat BR-tax-rate-code BR-specgrp for-curr-name
     3557            l-ibmspool l-cd-vat
     3558         WITH FRAME Dialog-Frame.
     3559     VIEW FRAME Dialog-Frame.
     3560   END PROCEDURE.
     3561   PROCEDURE fill-widgets :
     3562   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     3563   DEFINE VARIABLE v-entry AS CHARACTER NO-UNDO.
     3564   DEFINE VARIABLE v-rate-code LIKE ub.tax-rate.rate-code NO-UNDO.
     3565   DEFINE VARIABLE v-cdtaxlst AS CHARACTER NO-UNDO.
     3566   DEFINE VARIABLE v-specgrp AS CHARACTER NO-UNDO.
     3567   define variable v-param-type as character no-undo .
     3568   define variable v-param-value as character no-undo .
     3569   define variable v-grp-code as integer no-undo .
     3570   define variable v-gtype as integer no-undo .
     3571   define variable v-value-character as character no-undo .
     3572   define variable v-value-date as date no-undo .
     3573   define variable v-value-decimal as decimal no-undo .
     3574   define variable v-value-integer as INTEGER no-undo .
     3575   define variable v-value-logical AS LOGICAL no-undo .
     3576   DEFINE BUFFER buf_tax-rate FOR ub.tax-rate.
     3577   DEFINE BUFFER buf_goods FOR ub.goods.
     3578   DEFINE BUFFER buf_tt-sum-grp FOR tt-sum-grp.
     3579   FOR EACH thbjattr_thbj-attr:
     3580     delete thbjattr_thbj-attr.
     3581   end.
     3582   FOR EACH temp-thbj-attr:
     3583     delete temp-thbj-attr.
     3584   end.
     3585   run adm/shattri.p (
     3586                 input "init":U
     3587               , input p-obj-type
     3588               , input p-obj-code
     3589               , input 'cd-type-ibm':U
     3590               , input "":U
     3591               , output v-value-character
     3592               , output v-value-date
     3593               , output v-value-decimal
     3594               , output v-value-integer
     3595               , output v-value-logical
     3596               , output v-param-type
     3597               , INPUT-OUTPUT TABLE-handle v-tth
     3598               ) no-error .
     3599   if error-status:error
     3600   and not available locked_thbj-attr then do:
     3601     message
     3602     "Не удалось получить начальные значения настроек" skip
     3603     error-status:get-message(1) return-value
     3604     view-as alert-box error .
     3605     undo, return error .
     3606   end.
     3607   FOR EACH thbjattr_thbj-attr:
     3608     ASSIGN
     3609     v-entry = thbjattr_thbj-attr.prop-code.
     3610     IF v-entry = 'ibmrubc':U THEN DO:
     3611       ASSIGN
     3612       f-ibmrubc = thbjattr_thbj-attr.property-value-integer
     3613       f-ibmrubc:private-data in frame Dialog-Frame  = "recid=" + string(recid(thbjattr_thbj-attr))
     3614       .
     3615     END.
     3616     IF v-entry = 'ibmnalc':U THEN DO:
     3617       ASSIGN
     3618       f-ibmnalc = thbjattr_thbj-attr.property-value-integer
     3619       f-ibmnalc:private-data = "recid=" + string(recid(thbjattr_thbj-attr))
     3620       .
     3621     END.
     3622     IF v-entry = 'ibmspool':U THEN DO:
     3623       ASSIGN
     3624       RS-ibmspool = thbjattr_thbj-attr.property-value-integer
     3625       rs-ibmspool:private-data = "recid=" + string(recid(thbjattr_thbj-attr))
     3626       .
     3627     END.
     3628     IF v-entry = 'ibmgroup':U THEN DO:
     3629       ASSIGN
     3630       t-ibmgroup = thbjattr_thbj-attr.property-value-logical
     3631       t-ibmgroup:private-data = "recid=" + string(recid(thbjattr_thbj-attr))
     3632       .
     3633     END.
     3634     IF v-entry = 'cd-vat':U THEN DO:
     3635       ASSIGN
     3636       RS-cd-vat = thbjattr_thbj-attr.property-value-integer
     3637       rs-cd-vat:private-data = "recid=" + string(recid(thbjattr_thbj-attr))
     3638       .
     3639     END.
     3640     IF v-entry = 'cdtaxlst':U THEN DO:
     3641       ASSIGN
     3642       v-cdtaxlst = thbjattr_thbj-attr.property-value-character
     3643       .
     3644     END.
     3645     IF v-entry = 'specgrp':U THEN DO:
     3646       ASSIGN
     3647       v-specgrp = thbjattr_thbj-attr.property-value-character.
     3648     END.
     3649     IF v-entry = 'multicurr':U THEN DO:
     3650       ASSIGN
     3651       t-multicurr = thbjattr_thbj-attr.property-value-logical
     3652       t-multicurr:private-data = "recid=" + string(recid(thbjattr_thbj-attr))
     3653       .
     3654     END.
     3655     create temp-thbj-attr.
     3656     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     3657   END.
     3658   if v-cdtaxlst <> "":U then do:
     3659     _ii:
     3660     DO ii = 1 TO NUM-ENTRIES(v-cdtaxlst, ";"):
     3661       ASSIGN
     3662       v-rate-code = INTEGER (ENTRY(1, ENTRY(ii, v-cdtaxlst, ";":U), "-":U))
     3663       .
     3664       FIND FIRST buf_tax-rate NO-LOCK WHERE
     3665                     buf_tax-rate.rate-code = v-rate-code NO-ERROR.
     3666       IF NOT AVAILABLE buf_tax-rate THEN NEXT _ii.
     3667         CREATE tt-tax-rate-code.
     3668         BUFFER-COPY buf_tax-rate TO tt-tax-rate-code
     3669         ASSIGN
     3670         tt-tax-rate-code.tax-code = integer(ENTRY(2, ENTRY(ii, v-cdtaxlst, ";":U), "-":U))
     3671         tt-tax-rate-code.bo-tax-code = buf_tax-rate.tax-code
     3672         .
     3673     END.
     3674   end.
     3675   if v-specgrp <> "":U then do:
     3676     _ii:
     3677     DO ii = 1 TO NUM-ENTRIES(v-specgrp, ";"):
     3678       ASSIGN
     3679       v-grp-code = INTEGER (ENTRY(1, ENTRY(ii, v-specgrp, ";":U), "-":U))
     3680       .
     3681       if num-entries(ENTRY(ii, v-specgrp, ";":U), "-":U) > 2 then do:
     3682         assign
     3683         v-gtype = INTEGER (ENTRY(3, ENTRY(ii, v-specgrp, ";":U), "-":U)) no-error .
     3684       end.
     3685        FIND FIRST buf_tt-sum-grp NO-LOCK WHERE
     3686                     buf_tt-sum-grp.grp-code = v-grp-code NO-ERROR.
     3687       IF AVAILABLE buf_tt-sum-grp THEN NEXT _ii.
     3688       FIND FIRST buf_goods NO-LOCK WHERE
     3689                   buf_goods.gds-code = integer(ENTRY(2, ENTRY(ii, v-specgrp, ";":U), "-":U)) NO-ERROR.
     3690         CREATE buf_tt-sum-grp.
     3691         ASSIGN
     3692         buf_tt-sum-grp.grp-code = integer(ENTRY(1, ENTRY(ii, v-specgrp, ";":U), "-":U))
     3693         buf_tt-sum-grp.code-2 = (IF AVAILABLE buf_goods
     3694                                  THEN buf_goods.gds-code
     3695                                  ELSE integer(ENTRY(2, ENTRY(ii, v-specgrp, ";":U), "-":U)))
     3696         buf_tt-sum-grp.grp-name = (IF AVAILABLE buf_goods
     3697                                  THEN buf_goods.gds-name
     3698                                  ELSE "!!!Ошибка не такого товара")
     3699         buf_tt-sum-grp.gtype    = v-gtype
     3700         .
     3701     END.
     3702   end.
     3703   END PROCEDURE.
     3704   PROCEDURE MyEnable :
     3705   DEFINE BUFFER buf_currency FOR ub.currency.
     3706   FIND FIRST buf_currency NO-LOCK WHERE
     3707             buf_currency.curr-code = f-ibmnalc NO-ERROR.
     3708   IF AVAILABLE buf_currency THEN DO:
     3709       ASSIGN
     3710       for-curr-name = buf_currency.curr-abbr.
     3711   END.
     3712   ASSIGN
     3713   FRAME Dialog-Frame:TITLE = FRAME Dialog-Frame:TITLE + (if p-obj-type = 'орг':U then " фирма" else " маг") + STRING(p-obj-code)
     3714   v-tab-order = "f-ibmrubc,f-ibmnalc,b-curr,RS-ibmspool,t-multicurr,RS-cd-vat,b-add,b-del,br-tax-rate-code," +
     3715                 "t-ibmgroup,b-add-2,b-del-2,br-specgrp".
     3716   assign
     3717   f-ibmrubc :label = "Код национальной валюты (РУБ) НА КАССЕ"
     3718   b-add-2:MENU-MOUSE = 1
     3719   .
     3720   DISPLAY
     3721   f-ibmrubc
     3722   f-ibmnalc
     3723   RS-ibmspool
     3724   for-curr-name
     3725   RS-cd-vat
     3726   l-ibmspool
     3727   t-multicurr
     3728   l-cd-vat
     3729   t-ibmgroup
     3730   WITH FRAME Dialog-Frame.
     3731   ENABLE
     3732   B-exit WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3733   b-quit
     3734   B-Help
     3735   br-tax-rate-code
     3736   br-specgrp
     3737   b-curr WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3738   f-ibmrubc WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3739   f-ibmnalc WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3740   RS-ibmspool WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3741   t-ibmgroup WHEN p-mode = 'ИЗМЕНЕНИЕ':U AND p-obj-type = 'маг':U
     3742   t-multicurr when p-mode = 'ИЗМЕНЕНИЕ':U
     3743   rs-cd-vat WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3744   b-add   WHEN p-mode = 'ИЗМЕНЕНИЕ':U AND rs-cd-vat = 1
     3745   b-del   WHEN p-mode = 'ИЗМЕНЕНИЕ':U AND rs-cd-vat = 1
     3746   b-add-2   WHEN p-mode = 'ИЗМЕНЕНИЕ':U AND t-ibmgroup
     3747   b-del-2   WHEN p-mode = 'ИЗМЕНЕНИЕ':U AND t-ibmgroup
     3748   WITH FRAME Dialog-Frame.
     3749   VIEW FRAME Dialog-Frame.
     3750   IF p-mode = 'ПРОСМОТР':U THEN DO:
     3751       HIDE
     3752       b-exit
     3753       IN FRAME Dialog-Frame.
     3754       ASSIGN
     3755       b-quit:LABEL = "&Выход"
     3756       tt-tax-rate-code.tax-code:read-only  in browse br-tax-rate-code = yes
     3757       .
     3758   END.
     3759   APPLY "value-changed" TO rs-cd-vat.
     3760   APPLY "value-changed" TO t-ibmgroup.
     3761   OPEN QUERY BR-specgrp FOR EACH tt-sum-grp NO-LOCK INDEXED-REPOSITION.
     3762   END PROCEDURE.
     3763   PROCEDURE OpenBr :
     3764   OPEN QUERY br-tax-rate-code FOR EACH tt-tax-rate-code SHARE-LOCK.
     3765   END PROCEDURE.
     3766   PROCEDURE proc-b-add-2 :
     3767   DEFINE INPUT PARAMETER p-gtype AS INTEGER NO-UNDO.
     3768   DEFINE VARIABLE v-value-int AS integer NO-UNDO.
     3769     DEFINE VARIABLE v-sum-grp-rid AS recid NO-UNDO.
     3770     DEFINE VARIABLE ref-list AS character NO-UNDO.
     3771     define variable v-host-code as integer no-undo .
     3772     define buffer buf_macro-list-hist for macro-list-hist.
     3773     DEFINE BUFFER buf_tt-sum-grp FOR tt-sum-grp.
     3774     DEFINE BUFFER buf_goods FOR ub.goods.
     3775     DEFINE BUFFER buf_sum-grp FOR ub.sum-grp.
     3776     define buffer buf_gds-list for gds-list.
     3777     run ref/sum-grps.w (
     3778                    input parparentproc
     3779                  , INPUT "b-sel"
     3780                  , input-output ref-list).
     3781     if ref-list = "":U then do:
     3782       UNDO, RETURN ERROR.
     3783     END.
     3784       find first buf_sum-grp no-lock where
     3785                 recid(buf_sum-grp) = integer(entry(1, ref-list)) no-error .
     3786       if not avail buf_sum-grp then return error.
     3787       assign
     3788       v-value-int = buf_sum-grp.grp-code
     3789       .
     3790     FIND FIRST buf_tt-sum-grp WHERE
     3791               buf_tt-sum-grp.grp-code = v-value-int NO-ERROR.
     3792     IF AVAILABLE buf_tt-sum-grp THEN DO:
     3793         MESSAGE
     3794         "Уже определена запись с таким кодом"
     3795         VIEW-AS ALERT-BOX ERROR.
     3796         UNDO, RETURN error.
     3797     END.
     3798     for each buf_macro-list-hist:
     3799       delete buf_macro-list-hist.
     3800     end.
     3801     for each gds-list-hist:
     3802       delete gds-list-hist.
     3803     end.
     3804     create buf_macro-list-hist.
     3805     assign
     3806     buf_macro-list-hist.list-table = '':U
     3807     buf_macro-list-hist.id         = 1
     3808     buf_macro-list-hist.line       = 0
     3809     buf_macro-list-hist.hist-mode  = '+'
     3810     buf_macro-list-hist.status_    = 'все':U
     3811     .
     3812     CASE p-gtype:
     3813         WHEN 50 THEN DO:
     3814             ASSIGN
     3815             buf_macro-list-hist.des        = "ВСЕ услуги-платежи в адрес ОСС"
     3816             buf_macro-list-hist.item_      = 'office-type':U
     3817             buf_macro-list-hist.option_    = "goods-attr"
     3818             .
     3819         END.
     3820         WHEN 24 THEN DO:
     3821             ASSIGN
     3822             buf_macro-list-hist.des        = "ВСЕ услуги-перечисления в системы лояльности"
     3823             buf_macro-list-hist.item_      = 'is-loyalty-payment':U  + chr(3) + string(yes)
     3824             buf_macro-list-hist.option_    = "goods-attr-val"
     3825             .
     3826       END.
     3827     END CASE.
     3828     release buf_macro-list-hist.
     3829   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3830   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3831     (input  p-obj-type
     3832     ,input  p-obj-code
     3833     ,output v-host-code
     3834     )  .
     3835     for each gds-list:
     3836       delete gds-list.
     3837     end.
     3838     run str/gdsqlist.w (
     3839                      input parparentproc
     3840                     ,input this-procedure:handle
     3841                     ,input v-host-code
     3842                     ,input p-obj-type
     3843                     ,input p-obj-code
     3844                     ,input "b-sel"
     3845                     ,input "ВСЕ услуги-платежи в адрес ОСС"
     3846                     ,input yes
     3847                     ).
     3848     find first gds-list where
     3849              gds-list.to-sel = yes no-error.
     3850     if not available gds-list then return error.
     3851     for each buf_gds-list where buf_gds-list.to-sel = yes:
     3852       buf_gds-list.to-sel = no.
     3853     end.
     3854     FIND FIRST buf_goods NO-LOCK WHERE
     3855               buf_goods.gds-code = gds-list.gds-code NO-ERROR.
     3856    IF NOT AVAILABLE buf_goods THEN RETURN error.
     3857     if buf_goods.gds-type <> 'у':U then do:
     3858       message
     3859       "Со спецгруппой можно связать только УСЛУГУ!"
     3860       view-as alert-box error.
     3861       undo, return error.
     3862     end.
     3863     if buf_goods.unit-base <> "руб" then do:
     3864       message
     3865       substitute("Со спецгруппой можно связать только УСЛУГУ,&1" +
     3866                  "у которой единица измерения равна единице измерения НАЦИОНАЛЬНОЙ ВАЛЮТЫ (&2)"
     3867                  , chr(10)
     3868                  , "руб")
     3869       view-as alert-box error.
     3870       undo, return error.
     3871     end.
     3872     CREATE buf_tt-sum-grp.
     3873     ASSIGN
     3874     buf_tt-sum-grp.grp-code = v-value-int
     3875     buf_tt-sum-grp.grp-name = gds-list.gds-name
     3876     buf_tt-sum-grp.code-2   = gds-list.gds-code
     3877     buf_tt-sum-grp.gtype    = p-gtype
     3878     v-sum-grp-rid = RECID(buf_tt-sum-grp)
     3879     .
     3880     for each gds-list:
     3881       delete gds-list.
     3882     end.
     3883     OPEN QUERY BR-specgrp FOR EACH tt-sum-grp NO-LOCK INDEXED-REPOSITION.
     3884     REPOSITION br-specgrp TO RECID v-sum-grp-rid.
     3885   END PROCEDURE.
     3886   PROCEDURE proc-save :
     3887   define variable v-value-character as character no-undo .
     3888   define variable v-value-date as date no-undo .
     3889   define variable v-value-decimal as decimal no-undo .
     3890   define variable v-value-integer as INTEGER no-undo .
     3891   define variable v-value-logical AS LOGICAL no-undo .
     3892   define variable v-cdtaxlst as character no-undo .
     3893   define variable v-specgrp as character no-undo .
     3894   define variable ii as integer no-undo .
     3895   define variable v-param-type as character no-undo .
     3896   define variable wh as widget-handle no-undo .
     3897   define variable fh as widget-handle no-undo .
     3898   define variable v-same as logical no-undo .
     3899   define buffer buf_clients-shop for ub.clients.
     3900   define buffer buf_clients-shop-attr for ub.thbj-attr.
     3901   DEFINE BUFFER buf_tt-tax-rate-code FOR tt-tax-rate-code.
     3902   DEFINE BUFFER buf_tt-sum-grp FOR tt-sum-grp.
     3903   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     3904   FIND FIRST buf_tt-tax-rate-code NO-LOCK WHERE
     3905             buf_tt-tax-rate-code.tax-code = 0 NO-ERROR.
     3906   IF AVAILABLE buf_tt-tax-rate-code THEN DO:
     3907       MESSAGE
     3908       "Вы не ввели категорию налога НА КАССЕ для ставки с кодом " buf_tt-tax-rate-code.rate-code
     3909       VIEW-AS ALERT-BOX ERROR.
     3910       RETURN ERROR.
     3911   END.
     3912   ASSIGN
     3913   FRAME Dialog-Frame
     3914   f-ibmrubc
     3915   f-ibmnalc
     3916   RS-ibmspool
     3917   t-multicurr
     3918   t-ibmgroup
     3919   RS-cd-vat.
     3920   if not t-ibmgroup then do:
     3921     FOR EACH tt-sum-grp:
     3922      DELETE tt-sum-grp.
     3923     END.
     3924   end.
     3925   if rs-ibmspool < 5
     3926   and p-obj-type = 'орг':U then do:
     3927     for each buf_clients-shop no-lock where
     3928             buf_clients-shop.host-code = p-obj-code
     3929         and buf_clients-shop.obj-type = 'маг':U
     3930         and buf_clients-shop.stts = 0:
     3931       FIND FIRST buf_clients-shop-attr no-LOCK WHERE
     3932             buf_clients-shop-attr.obj-type = buf_clients-shop.obj-type
     3933         AND buf_clients-shop-attr.obj-code = buf_clients-shop.obj-code
     3934         AND buf_clients-shop-attr.upper-prop-code = 'cd-type-ibm':U NO-ERROR.
     3935       if not available buf_clients-shop
     3936       and nzpl-two(input buf_clients-shop.obj-type, input buf_clients-shop.obj-code) then do:
     3937         message
     3938         substitute("На &1&2, принадлежащем фирме &3, конфигурация ТРК-Пистолет-Резервуар такова,&4" +
     3939         "что не может поддерживаться POS со значением типа спула < 6,&4" +
     3940         "(по правилам получения значений параметров, если для какого-либо объекта параметры еще не определялись индивидуально,&4" +
     3941         "значения параметров для него полагаются равными значению данных параметров для фирмы объекта)&4" +
     3942         "Вы можете установить для &1&2 корректные для него значения параметра ТИП СПУЛА (< 6)&4" +
     3943         "и попробовать вновь установить параметры для фирмы &3"
     3944         , buf_clients-shop.obj-type
     3945         , buf_clients-shop.obj-code
     3946         , buf_clients-shop.host-code)
     3947         view-as alert-box error .
     3948         undo, return error .
     3949       end.
     3950     end.
     3951   end.
     3952   if rs-cd-vat = 1 then do:
     3953     FOR EACH tt-tax-rate-code BY tt-tax-rate-code.rate-code:
     3954       ASSIGN
     3955       ii = ii + 1
     3956       v-cdtaxlst = v-cdtaxlst + (if ii = 1 then "":U else ";":U)  +
     3957                     STRING(tt-tax-rate-code.rate-code) + "-":U + STRING(tt-tax-rate-code.tax-code)
     3958       .
     3959     END.
     3960   end.
     3961   if t-ibmgroup then do:
     3962     ii = 0.
     3963     FOR EACH buf_tt-sum-grp BY buf_tt-sum-grp.grp-code:
     3964       ASSIGN
     3965       ii = ii + 1
     3966       v-specgrp = v-specgrp + (if ii = 1 then "":U else ";":U)  +
     3967                     STRING(buf_tt-sum-grp.grp-code) + "-":U +
     3968                      STRING(buf_tt-sum-grp.code-2) + '-' + STRING(buf_tt-sum-grp.gtype)
     3969       .
     3970     END.
     3971   end.
     3972   assign
     3973   fh = frame Dialog-Frame:first-child
     3974   wh = fh:first-child
     3975   .
     3976   do while valid-handle(wh):
     3977     if wh:private-data begins "recid=" then do:
     3978       find first thbjattr_thbj-attr where
     3979                 recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     3980       assign
     3981       buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     3982     end.
     3983     wh = wh:next-sibling.
     3984   end.
     3985   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'cdtaxlst':U.
     3986   assign
     3987   thbjattr_thbj-attr.property-value-character = v-cdtaxlst
     3988   .
     3989   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'specgrp':U.
     3990   assign
     3991   thbjattr_thbj-attr.property-value-character = v-specgrp
     3992   .
     3993   v-same = yes.
     3994   for each thbjattr_thbj-attr,
     3995       first temp-thbj-attr where
     3996             temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     3997         and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     3998         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     3999         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code:
     4000      buffer-compare
     4001      thbjattr_thbj-attr
     4002      to temp-thbj-attr
     4003      save result in v-same.
     4004      if not v-same then leave.
     4005   end.
     4006   v-same = no.
     4007   IF v-same  and not v-to-create THEN RETURN.
     4008   run adm/shattri.p (
     4009                 input "check":U
     4010               , input p-obj-type
     4011               , input p-obj-code
     4012               , input 'cd-type-ibm':U
     4013               , INPUT '':U
     4014                , output v-value-character
     4015                , output v-value-date
     4016                , output v-value-decimal
     4017                , output v-value-integer
     4018                , output v-value-logical
     4019                , output v-param-type
     4020                , input-output TABLE-handle v-tth
     4021                ) no-error .
     4022   if error-status:error then do:
     4023     message
     4024     "Некорректное значение ПАРАМЕТРОВ" skip
     4025     error-status:get-message(1) skip
     4026     return-value
     4027     view-as alert-box error .
     4028     undo, return error .
     4029   end.
     4030   do TRANSACTION
     4031   on error undo, return error return-value
     4032   :
     4033     RUN thbjattr_set-section IN THIS-PROCEDURE (
     4034          input p-obj-type
     4035         ,input p-obj-code
     4036         ,input 'cd-type-ibm':U
     4037         ,INPUT table thbjattr_thbj-attr
     4038     ) NO-ERROR.
     4039     IF ERROR-STATUS:error THEN do:
     4040       MESSAGE ERROR-STATUS:get-message(1)  SKIP
     4041       RETURN-VALUE
     4042       VIEW-AS ALERT-BOX.
     4043       UNDO, RETURN ERROR.
     4044     END.
     4045   end.
     4046   END PROCEDURE.
