     1699   DEFINE QUERY BR-specgrp FOR
     1700         tt-sum-grp SCROLLING.
     1701   DEFINE QUERY BR-tax-rate-code FOR
     1702         tt-tax-rate-code SCROLLING.
     1703   DEFINE BROWSE BR-specgrp
     1704     QUERY BR-specgrp NO-LOCK DISPLAY
     1705         tt-sum-grp.grp-code COLUMN-LABEL "Код группы" FORMAT "99":U
     1706         tt-sum-grp.grp-name COLUMN-LABEL "Описание" FORMAT "X(40)":U
     1707         code-2 COLUMN-LABEL "Код товара" FORMAT "999999999":U
     1708       WITH NO-ROW-MARKERS SEPARATORS SIZE 79.6 BY 6
     1709            TITLE "Спецгруппы в справочнике суммовых групп" FIT-LAST-COLUMN.
     1710   DEFINE BROWSE BR-tax-rate-code
