     1714         tt-tax-rate-code.rate-name COLUMN-LABEL "Название ставки" FORMAT "X(40)":U
     1715         tt-tax-rate-code.tax-code COLUMN-LABEL "Катег.налога!на кассе" FORMAT "9":U
     1716               WIDTH 13
     1717     ENABLE
     1718         tt-tax-rate-code.tax-code
     1719       WITH NO-ROW-MARKERS SEPARATORS SIZE 79.6 BY 6
     1720            TITLE "Соответствие ставок НДС категориям налога на кассе (кроме POS c ОС LINUX)" FIT-LAST-COLUMN.
