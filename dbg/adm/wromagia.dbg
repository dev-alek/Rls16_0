        1   DEFINE OUTPUT PARAMETER p-code AS integer NO-UNDO.
        2   DEFINE OUTPUT PARAMETER p-name AS CHARACTER NO-UNDO.
        3   DEFINE OUTPUT PARAMETER p-return-write-off AS logical NO-UNDO.
        4   DEFINE OUTPUT PARAMETER p-object AS CHARACTER NO-UNDO.
        5   DEFINE OUTPUT PARAMETER p-setted AS logical NO-UNDO.
        6   def var vss-revision    as character no-undo init "$Revision$":U .
        7   def var vss-author      as character no-undo init "$Author$":U .
        8   def var vss-date        as character no-undo init "$Date$":U .
        9   def var vss-workfile    as character no-undo init "$Workfile$":U .
       10   def var vss-archive     as character no-undo init "$Archive$":U .
       11   def var vss-description as character no-undo init "Коды возврата/списания".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       67   define variable v-waitfram-action01         as character   no-undo .
       68   define variable v-waitfram-action02         as character   no-undo .
       69   define variable v-waitfram-action03         as character   no-undo .
       70   define variable mWaitFramTextBeg            as character   no-undo.
       71   define variable mWaitFramTextEnd            as character   no-undo.
       72   define variable mWaitFramView               as logical     no-undo.
       73   define variable mWaitProcEvent              as logical     no-undo init yes.
       74   define variable mWaitFramInterval           as integer     no-undo init 1 .
       75   define variable mWaitFramStop               as logical     no-undo.
       76   define variable mWaitFramStopUser           as logical     no-undo.
       77   define variable mWaitFramStopTimeOut        as logical     no-undo.
       78   define variable mWaitFramStartProc          as datetime-tz no-undo.
       79   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       80   define button B-WaitFramStop auto-end-key
       81        label "Стоп"
       82        size 10 by 1 tooltip "Остоновить процесс".
       83   define button B-viewProcInfo
       84        label "Информация"
       85        size 15 by 1 tooltip "Информация о процесс".
       86   define frame waitfram
       87     v-waitfram-action01 format "x(72)" no-label skip
       88     v-waitfram-action02 format "x(72)" no-label skip
       89     v-waitfram-action03 format "x(72)" no-label skip
       90     B-viewProcInfo
       91     B-WaitFramStop at row 4 col 30
       92     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       93     .
       94   define new global shared variable mBatchMode as logical no-undo init ?.
       95   define variable mFramBachModHandle as handle no-undo.
       96   mFramBachModHandle = frame waitfram:handle.
       97   define variable mFameOldVis as logical no-undo.
       98   define variable mVisCUrentVin as logical no-undo.
       99   if session:batch-mode
      100   then
      101      mBatchMode = yes.
      102   if mBatchMode = ? then do:
      103     mVisCUrentVin = current-window:visible.
      104     mFameOldVis = mFramBachModHandle:visible.
      105     mFramBachModHandle:visible  = yes.
      106     mBatchMode = mFramBachModHandle:visible ne yes.
      107     mFramBachModHandle:visible = mFameOldVis.
      108     current-window:visible = mVisCUrentVin.
      109   end.
      110    if  log-manager:logfile-name ne ?
      111     then DO:
      112         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      113         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      114         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      115     end.
      116   on choose of B-WaitFramStop in frame waitfram
      117   do:
      118     mWaitFramStop = yes.
      119     mWaitFramStopUser = yes.
      120   end.
      121   function waitfram-check-timeout returns logical():
      122      define variable vtime as int64 no-undo.
      123      if mWaitFramStopTimeOut
      124      then
      125         return yes.
      126      vtime = ( now - mWaitFramStartProc ) / 1000 .
      127      if     mWaitFramTimeOut ne ?
      128         and mWaitFramTimeOut ne 0
      129         and mWaitFramTimeOut lt vtime
      130      then do:
      131         mWaitFramStopTimeOut = yes.
      132      end.
      133      return mWaitFramStopTimeOut.
      134   end.
      135   procedure waitfram-hide :
      136     if not session:batch-mode
      137     then do
      138     on error undo, return error return-value
      139     :
      140       pause 0 before-hide .
      141       if not mBatchMode then
      142         hide frame waitfram .
      143     if     not mWaitFramView
      144        and mWaitProcEvent
      145     then
      146       process events .
      147     end.
      148   end procedure.
      149   procedure waitfram-show :
      150     define input  parameter p-message as character no-undo .
      151     define variable v-left-margin as integer   no-undo .
      152     if not session:batch-mode
      153     then do
      154     on error undo, return error return-value
      155     :
      156       if length(p-message) <= 70 then do:
      157         assign
      158           v-left-margin = integer((70 - length(p-message)) / 2)
      159         .
      160         assign
      161           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      162         .
      163         assign
      164           v-waitfram-action01 = " "
      165           v-waitfram-action02 = " "
      166                                    + fill(" ", v-left-margin)
      167                                    + p-message
      168           v-waitfram-action03 = " "
      169         .
      170       end.
      171       else do:
      172         define variable vRindex1 as integer no-undo.
      173         define variable vRindex2 as integer no-undo.
      174         vRindex1 = r-index(p-message," ",70).
      175         if vRindex1 = 0
      176         then
      177            vRindex1 = 70.
      178         if length(p-message)  <= vRindex1 + 70 then do:
      179           assign
      180             v-waitfram-action01 = " "
      181             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      182             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      183           .
      184         end.
      185         else do:
      186           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      187           if vRindex2 <= vRindex1
      188           then
      189              vRindex2 = vRindex1 + 70.
      190           assign
      191             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      192             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      193             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      194           .
      195         end.
      196       end.
      197       B-viewProcInfo:visible   in frame waitfram = no.
      198       B-viewProcInfo:sensitive in frame waitfram = no.
      199       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      200       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      201       if  (   mWaitFramView
      202          or  mWaitProcEvent)
      203          and not mBatchMode
      204       then
      205          display
      206             v-waitfram-action01 skip
      207             v-waitfram-action02 skip
      208             v-waitfram-action03 skip
      209          with frame waitfram .
      210       if     mWaitFramView
      211          then do:
      212             if     mWaitFramInterval ne ?
      213                and not mBatchMode
      214             then
      215                wait-for go of frame waitfram pause mWaitFramInterval.
      216          end.
      217          else
      218             if     mWaitProcEvent
      219                and not mBatchMode
      220             then
      221                process events .
      222     end.
      223   end procedure.
      224      procedure waitfram-show-this:
      225         define input  parameter iInterval as int64 no-undo.
      226         define variable vtime as int64 no-undo.
      227         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      228         mWaitFramInterval = iInterval.
      229         run waitfram-show (substitute("&1&2 &3&4" ,
      230                                       mWaitFramTextBeg ,
      231                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      232                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      233                                       mWaitFramTextEnd
      234                                      )
      235                           ).
      236      end.
      237      procedure WaitFramRunPause:
      238         define input  parameter iInterval as dec no-undo.
      239         define variable vStart  as datetime-tz no-undo.
      240         define variable vend    as datetime-tz no-undo.
      241         define variable vint as int64 no-undo.
      242         define variable vOk as logical no-undo.
      243         vStart = now.
      244         vend   = vStart.
      245         publish "WaitFramPause" (iInterval,output vOk).
      246         vend   =  now.
      247         vint = vend - vStart.
      248         vint = iInterval - vint / 1000.
      249         if     not mWaitFramStop
      250            and (   vint > 0
      251                 or (    not vOk
      252                     and iInterval eq ?
      253                     )
      254                 )
      255         then
      256            run waitfram-show-this (iInterval).
      257         vend   =  now.
      258         vint = vend - vStart.
      259         vint = iInterval - vint / 1000.
      260         if     not mWaitFramStop
      261            and vint > 0
      262         then do:
      263            run gbl/pause.p (vint * 1000).
      264         end.
      265         if iInterval ne ?
      266         then
      267            publish "WaitFramStop".
      268         waitfram-check-timeout().
      269      end.
      270      procedure WaitFramWaitFor:
      271         define input  parameter iInterval as dec no-undo.
      272         assign
      273            mWaitFramStartProc   = now
      274            mWaitFramStopUser    = no
      275            mWaitFramStopTimeOut = no
      276         .
      277         block-wait:
      278         do while not mWaitFramStop:
      279            run WaitFramRunPause (iInterval).
      280            if  waitfram-check-timeout()
      281            then do:
      282               leave block-wait.
      283            end.
      284         end.
      285         run waitfram-hide.
      286      end.
      287   procedure waitfram-join :
      288     define input  parameter p-line-1  as character no-undo .
      289     define input  parameter p-line-2  as character no-undo .
      290     define input  parameter p-line-3  as character no-undo .
      291     define output parameter p-message as character no-undo .
      292     do
      293     on error undo, return error return-value
      294     :
      295       assign
      296         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      297                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      298                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      299       .
      300     end.
      301   end procedure.
      302   function waitfram-join-function returns character
      303     (input p-line-1 as character
      304     ,input p-line-2 as character
      305     ,input p-line-3 as character
      306     ).
      307     define variable v-message as character no-undo .
      308     run waitfram-join in this-procedure
      309       (input  p-line-1
      310       ,input  p-line-2
      311       ,input  p-line-3
      312       ,output v-message
      313       ) .
      314     return v-message .
      315   end function .
      316   define new global shared variable g#language as character no-undo .
      317   if g#language <> '' and g#language <> 'rus':U then do:
      318     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      319   end.
      320   define new global shared variable g#library  as handle no-undo .
      321   define new global shared variable g#library2 as handle no-undo .
      322   procedure proc-alt-shift-f2:
      323     if not ibs.th.gbl.gbl-var:rcode
      324   then
      325     run gbl\inidebug.p .
      326   end.
      327   procedure proc-alt-shift-f3:
      328     run gbl/prvssinf.p
      329       ( input this-procedure
      330       ) .
      331   end.
      332   define variable v-inform-launched as logical no-undo initial false .
      333   procedure proc-alt-shift-f4:
      334     define variable v-action as character no-undo .
      335     if v-inform-launched = false then do:
      336       assign
      337         v-inform-launched = true
      338       .
      339       run gbl/d-inform.w
      340         (  input self
      341         ,  input this-procedure
      342         , output v-action
      343         ) no-error .
      344       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      345       assign
      346         v-inform-launched = false
      347       .
      348     end.
      349   end.
      350   procedure proc-alt-f1:
      351     run gbl/corrhelp.p
      352       (input this-procedure
      353       ) .
      354   end .
      355   on alt-shift-f2 anywhere do:
      356     run proc-alt-shift-f2.
      357   end.
      358   on alt-shift-f3 anywhere do:
      359     run proc-alt-shift-f3 in this-procedure .
      360   end.
      361   on alt-shift-f4 anywhere do:
      362     run proc-alt-shift-f4 in this-procedure.
      363   end.
      364   on alt-f1 anywhere do:
      365     run proc-alt-f1 in this-procedure .
      366   end.
      367   DEFINE BUTTON B-exit AUTO-GO
      368        LABEL "&Ввод"
      369        SIZE 10 BY 1
      370        BGCOLOR 8 .
      371   DEFINE BUTTON B-Help
      372        LABEL "Помо&щь"
      373        SIZE 10 BY 1
      374        BGCOLOR 8 .
      375   DEFINE BUTTON b-quit AUTO-END-KEY
      376        LABEL "&Отмена"
      377        SIZE 10 BY 1
      378        BGCOLOR 8 .
      379   DEFINE VARIABLE f-code AS INTEGER FORMAT ">9":U INITIAL 0
      380        LABEL "Код"
      381        VIEW-AS FILL-IN
      382        SIZE 9.5 BY 1 NO-UNDO.
      383   DEFINE VARIABLE f-name AS CHARACTER FORMAT "X(30)":U
      384        LABEL "Описание"
      385        VIEW-AS FILL-IN
      386        SIZE 35 BY 1 NO-UNDO.
      387   DEFINE VARIABLE Rs-object AS CHARACTER
      388        VIEW-AS RADIO-SET VERTICAL
      389        RADIO-BUTTONS
      390             "Блюдо/Товар", "1",
      391   "Чек", "2",
      392   "Заказ", "3"
      393        SIZE 30 BY 2.5 NO-UNDO.
      394   DEFINE VARIABLE RS-return-write-off AS INTEGER
      395        VIEW-AS RADIO-SET HORIZONTAL
      396        RADIO-BUTTONS
      397             "Возврат", 1,
      398   "Списание", -1
      399        SIZE 35 BY 1 NO-UNDO.
      400   DEFINE FRAME Dialog-Frame
      401        B-exit AT ROW 1 COL 1
      402        b-quit AT ROW 1 COL 11
      403        B-Help AT ROW 1 COL 54.88
      404        f-code AT ROW 2.5 COL 4.5 COLON-ALIGNED
      405        RS-return-write-off AT ROW 4 COL 6 NO-LABEL
      406        Rs-object AT ROW 5.5 COL 6 NO-LABEL
      407        f-name AT ROW 9 COL 14 COLON-ALIGNED
      408        SPACE(16.12) SKIP(0.37)
      409       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      410            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      411            TITLE "Код возврата/списания"
      412            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      413   ASSIGN
      414          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      415          FRAME Dialog-Frame:HIDDEN           = TRUE.
      416   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      417   DO:
      418     APPLY "END-ERROR":U TO SELF.
      419   END.
      420   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      421   DO:
      422     ASSIGN
      423     f-code
      424     RS-return-write-off
      425     Rs-object
      426     f-name
      427     .
      428     IF f-code = 0 THEN DO:
      429        MESSAGE "Код возврата/списания не может = 0"
      430        VIEW-AS ALERT-BOX.
      431        RETURN NO-APPLY.
      432     END.
      433     IF f-name = '':U  THEN DO:
      434        MESSAGE "Введите описание возврата/списания"
      435        VIEW-AS ALERT-BOX.
      436        RETURN NO-APPLY.
      437     END.
      438     assign
      439     p-setted = YES
      440     p-code = f-code
      441     p-name = f-name
      442     p-return-write-off = (rs-return-write-off = 1)
      443     p-object = rs-object
      444     .
      445   END.
      446   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      447   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      448   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      449   on help of frame Dialog-Frame
      450   do:
      451     run gbl/app_help.p
      452       (input this-procedure :file-name
      453       ,input ''
      454       ,input ?
      455       ) no-error.
      456     if error-status :error then do:
      457       message
      458         "Ошибка при вызове помощи"
      459         error-status :get-message(1)
      460         view-as alert-box .
      461     end.
      462   end.
      463   run minbtn-set in this-procedure .
      464   on choose of b-help in frame Dialog-Frame
      465   do:
      466     apply "help":u to frame Dialog-Frame .
      467   end.
      468   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      469   procedure minbtn-set :
      470       do
      471           on error undo, return error return-value
      472           :
      473           define variable ii              as integer       no-undo .
      474           define variable fh              as widget-handle no-undo .
      475           define variable hh              as widget-handle no-undo .
      476           define variable v-h             as handle        extent 4 no-undo .
      477           define variable v-name-button   as character     no-undo .
      478           define variable v-help-old-x    as decimal       no-undo .
      479           define variable v-help-old-y    as decimal       no-undo .
      480           define variable v-help-old-size as decimal       no-undo .
      481           define variable v-frame-width   as decimal       no-undo .
      482           define variable jj              as integer       no-undo .
      483           do
      484               on error undo, return error
      485               :
      486               assign
      487                   v-frame-width = frame Dialog-Frame:width - 0.3
      488                   fh            = frame Dialog-Frame:first-child
      489                   hh            = fh:first-child
      490                   ii            = 1
      491                   .
      492               do while valid-handle(hh):
      493                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      494                   do:
      495                       case lc(hh:name) :
      496                           when "b-help" then
      497                               do:
      498                                   hh:load-image-up("cmp/b-help.bmp":u) .
      499                                   hh:load-image-down("cmp/b-help.bmp":u) .
      500                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      501                                   hh:TOOLTIP = "Помощь" .
      502                                   v-help-old-x = hh:column .
      503                                   v-help-old-y = hh:row    .
      504                                   v-help-old-size = hh:width .
      505                                   hh:width-chars = 2.5 .
      506                               end.
      507                           when "b-print" then
      508                               do:
      509                                   hh:load-image("cmp/b-print.bmp":u) .
      510                                   hh:TOOLTIP = "Печать" .
      511                                   v-h[ii] = hh:handle .
      512                                   ii = ii + 1 .
      513                                   hh:width-chars = 3 .
      514                               end.
      515                           when "b-history" or
      516                           when "b-hist" then
      517                               do:
      518                                   hh:load-image("cmp/b-hist.bmp":u) .
      519                                   hh:TOOLTIP = "История" .
      520                                   v-h[ii] = hh:handle .
      521                                   ii = ii + 1 .
      522                                   hh:width-chars = 3 .
      523                               end.
      524                           when "b-sch" then
      525                               do:
      526                                   hh:load-image("cmp/b-sch.bmp":u) .
      527                                   hh:TOOLTIP = "Установка Фильтра" .
      528                                   v-h[ii] = hh:handle .
      529                                   ii = ii + 1 .
      530                                   hh:width-chars = 3 .
      531                               end.
      532                           when "b-hist-user" then
      533                               do:
      534                                   hh:load-image("cmp/b-hist.bmp":u) .
      535                                   hh:TOOLTIP = "История пользователя" .
      536                                   ii = ii + 1 .
      537                               end.
      538                       end case.
      539                   end.
      540                   hh = hh:next-sibling.
      541               end.
      542               b-help:column = v-frame-width - b-help:width-chars.
      543               jj = 0.
      544               repeat ii = 4 to 1 by -1 :
      545                   if valid-handle (v-h[ii] ) then
      546                   do:
      547                       jj  = jj + 1 .
      548                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      549                       v-h[ii]:row    = v-help-old-y .
      550                   end.
      551               end.
      552           end.
      553       end.
      554   end procedure.
      555   MAIN-BLOCK:
      556   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      557      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      558     RUN Myenable.
      559     WAIT-FOR GO OF FRAME Dialog-Frame.
      560   END.
      561   RUN disable_UI.
      562   PROCEDURE disable_UI :
      563     HIDE FRAME Dialog-Frame.
      564   END PROCEDURE.
      565   PROCEDURE enable_UI :
      566     DISPLAY f-code RS-return-write-off Rs-object f-name
      567         WITH FRAME Dialog-Frame.
      568     ENABLE B-exit b-quit B-Help f-code RS-return-write-off Rs-object f-name
      569         WITH FRAME Dialog-Frame.
      570     VIEW FRAME Dialog-Frame.
      571   END PROCEDURE.
      572   PROCEDURE MyEnable :
      573   ASSIGN
      574   rs-object:RADIO-BUTTONS  IN FRAME Dialog-Frame =
      575        "Блюдо/товар" + chr(44) + 'chk-gds':U + chr(44) +
      576       "Чек" + chr(44) + 'chk-doc':U + chr(44) +
      577       "Заказ" + chr(44) + 'ord-doc':U
      578       .
      579   DISPLAY
      580   f-code
      581   RS-return-write-off
      582   Rs-object f-name
      583   WITH FRAME Dialog-Frame.
      584   ENABLE
      585   B-exit
      586   b-quit
      587   B-Help
      588   f-code
      589   RS-return-write-off
      590   Rs-object f-name
      591   WITH FRAME Dialog-Frame.
      592   VIEW FRAME Dialog-Frame.
      593   END PROCEDURE.
