     3215                ,INPUT    varenvd
     3216                ,INPUT    varpharm
     3217                ,input    KPP
     3218               )
     3219                no-error .
     3220   if error-status:error then do:
     3221     define variable l-ret-widg as character no-undo .
     3222     define variable l-ret-text as character no-undo .
     3223     assign
     3224       l-ret-widg = entry(1, return-value, chr(4))
     3225       l-ret-text = entry(2, return-value, chr(4))
     3226     .
     3227     message l-ret-text view-as alert-box error .
     3228   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3229   define variable fh as widget-handle no-undo .
     3230   define variable hh as widget-handle no-undo .
     3231   define variable rv as character no-undo .
     3232   assign
     3233   rv = entry(1, return-value , chr(4)).
     3234   if rv <> "":U then do:
     3235     assign
     3236     fh = frame Dialog-Frame:first-child
     3237     hh = fh:first-child
     3238     .
     3239     do while valid-handle(hh):
     3240       if hh:name = rv then do:
     3241         APPLY "ENTRY" to hh.
     3242         undo ,
     3243         return error.
     3244       end.
     3245       hh = hh:next-sibling.
     3246     end.
     3247   end.
     3248     undo, return error.
     3249   end.
     3250       assign
     3251           fi-holdfirm-code
     3252       .
     3253       find first buf_clients no-lock
     3254            where buf_clients.obj-type = 'орг':U
     3255              and buf_clients.obj-code = fi-holdfirm-code
     3256       no-error.
