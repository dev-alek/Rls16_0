     1887   ON CHOOSE OF b-holdfirm IN FRAME Dialog-Frame
     1888   DO:
     1889       define variable v-ref-list  as character    no-undo.
     1890       define variable v-firm-code as integer    no-undo.
     1891       assign
     1892           fi-holdfirm-code
     1893       .
     1894       run adm/sconfs.w (
     1895             input parParentProc
     1896           , input "b-sel":U
     1897           , input no
     1898           , input fi-holdfirm-code
     1899           , output v-firm-code
     1900           , input-output ref-list
     1901       ) no-error.
     1902       if error-status :error
     1903       then do:
     1904           message
     1905                    vss-workfile vss-revision vss-description
     1906               skip(1)
     1907               skip "Ошибка выбора фирмы."
     1908               skip return-value
     1909               skip trim(error-status :get-message(1))
     1910                    trim(error-status :get-message(2))
     1911                    trim(error-status :get-message(3))
     1912           view-as alert-box error.
     1913           undo, return no-apply .
     1914       end.
     1915       if v-firm-code = ?
     1916       or v-firm-code = 0
     1917       then do:
     1918           message "Фирма не выбрана."
     1919           view-as alert-box warning.
     1920           return no-apply.
     1921       end.
     1922       else do:
     1923           define buffer buf_clients for ub.clients.
     1924           find first buf_clients no-lock
     1925                where buf_clients.obj-type = 'орг':U
     1926                  and buf_clients.obj-code = v-firm-code
     1927           no-error.
     1928           if available buf_clients
     1929           then do:
     1930               assign
     1931                   fi-holdfirm-code = v-firm-code
     1932                   fi-holdfirm-name = buf_clients.obj-name
     1933               .
     1934           end.
     1935           else do:
     1936               assign
     1937                   fi-holdfirm-code = 0
     1938                   fi-holdfirm-name = "":U
     1939               .
     1940           end.
     1941           display
     1942               fi-holdfirm-code
     1943               fi-holdfirm-name
     1944           with frame Dialog-Frame.
     1945       end.
     1946   END.
     1947   ON CHOOSE OF b-host IN FRAME Dialog-Frame
     1948   DO:
     1949   define variable ref-list as char no-undo.
     1950   define variable glog as logical no-undo .
     1951   IF p-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
     1952     run adm/sconfs.w (
     1953                    input parParentProc
     1954                   ,input "b-sel":U
     1955                   ,input no
     1956                   ,input p-host-code
     1957                   ,output new-host-code
     1958                   ,input-output ref-list ) .
     1959     .
     1960     if new-host-code = ?
     1961     or new-host-code = 0
     1962     then do:
     1963       message "Фирма не выбрана."
     1964               view-as alert-box error.
     1965       return no-apply.
     1966     end.
     1967     if tt-shop.host-code <> 0 then do:
     1968       message
     1969       "Проставить коды оплат для типов документов, параметры отсылки на кассу и др. согласно настройкам выбранной фирмы?"
     1970       view-as alert-box question buttons yes-no update glog.
     1971     end.
     1972     else do:
     1973       glog = yes.
     1974     end.
     1975     tt-shop.host-code = new-host-code.
     1976     find first buf_cli-host where
     1977               buf_cli-host.obj-type = 'орг':U
     1978           and buf_cli-host.obj-code = tt-shop.host-code no-lock.
     1979     CASE p-mode:
     1980       when 'ПРОСМОТР':U then
     1981       frame Dialog-Frame:title = "МАГАЗИН  фирмы : " + buf_cli-host.obj-name + "               " + "ПРОСМОТР".
     1982       when 'ДОБАВЛЕНИЕ':U then
     1983       frame Dialog-Frame:title = "МАГАЗИН  фирмы : " + buf_cli-host.obj-name + "               " + "ДОБАВЛЕНИЕ".
     1984       when 'ИЗМЕНЕНИЕ':U then
     1985       frame Dialog-Frame:title = "МАГАЗИН  фирмы : " + buf_cli-host.obj-name + "               " + "ИЗМЕНЕНИЕ".
     1986     END CASE.
     1987     if glog then do:
     1988       run reset-from-sysconf in this-procedure ( input yes
     1989                                                 , input tt-shop.host-code
     1990                                                         ).
     1991     end.
     1992   END.
     1993   ELSE DO:
     1994         run adm/config.w (
     1995                             input parparentproc
     1996                            ,input tt-shop.host-code
     1997                            ,input  'ПРОСМОТР':U
     1998                            ,input no
     1999                            ) no-error.
     2000       if error-status:error then return no-apply.
     2001   END.
     2002   END.
