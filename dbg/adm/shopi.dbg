     3284           tt-shop.chk-pay = buf_sysconf.chk-pay
     3285           tt-shop.down-pay = buf_sysconf.down-pay
     3286           tt-shop.in-pay  = buf_sysconf.in-pay
     3287           tt-shop.inv-pay  = buf_sysconf.inv-pay
     3288           tt-shop.out-pay  = buf_sysconf.out-pay
     3289           tt-shop.ret-pay = buf_sysconf.ret-pay
     3290           tt-shop.ret-sup-pay = buf_sysconf.ret-sup-pay
     3291           tt-shop.fbr-pay = buf_sysconf.fbr-pay
     3292           tt-shop.rsrv-time  = buf_sysconf.rsrv-time
     3293           tt-shop.cd-bc-alt  = buf_sysconf.cd-bc-alt
     3294           tt-shop.cd-bc-base = buf_sysconf.cd-bc-base
     3295           tt-shop.cd-loc-alt = buf_sysconf.cd-loc-alt
     3296           tt-shop.cd-loc-base = buf_sysconf.cd-loc-base
     3297           tt-shop.cd-parts-all = buf_sysconf.cd-parts-all
     3298           tt-shop.cd-parts-not-blank = buf_sysconf.cd-parts-not-blank
     3299           tt-shop.cd-parts-ser = buf_sysconf.cd-parts-ser
     3300           tt-shop.cd-pb-alt = buf_sysconf.cd-pb-alt
     3301           tt-shop.cd-pb-base = buf_sysconf.cd-pb-base
     3302           tt-shop.cd-sc-base = buf_sysconf.cd-sc-base
     3303           tt-shop.all-prt = buf_sysconf.all-prt
     3304           .
     3305   end.
