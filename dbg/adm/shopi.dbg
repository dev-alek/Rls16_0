     1158   procedure thobjs :
     1159      define input        parameter parparentproc     as widget-handle no-undo .
     1160      define input        parameter i-bttns           as character     no-undo .
     1161      define input        parameter i-list-mode       as character     no-undo.
     1162      define input        parameter i-obj-type        as character     no-undo.
     1163      define input        parameter i-db-num          as integer       no-undo.
     1164      define input        parameter i-host-code       as integer       no-undo.
     1165      define input-output parameter p-rid-list        as character     no-undo .
     1166   run ref/thobjs.p
     1167           ( input parparentproc
     1168            ,input  this-procedure :handle
     1169           , input i-bttns
     1170           , input i-list-mode
     1171           , input i-obj-type
     1172           , input i-db-num
     1173           , input i-host-code
