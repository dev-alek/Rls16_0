      423       ,output p-prop-type-list
      424       ,output p-prop-label-list
      425       ,output p-global
      426       ,output p-host
      427       ,output p-shop
      428       ,output p-store
      429       ,output p-db
      430       ,output p-region
      431       ) no-error .
      432     if error-status :error
      433     then do:
      434       undo, return error substitute( "&1. &2&3&4", vss-include-info2, return-value, chr(10), error-status :get-message (1)).
      435     end.
      436   end.
      437   end procedure.
