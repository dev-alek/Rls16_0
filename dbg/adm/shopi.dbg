      648   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      649   procedure proc-b-attr :
      650   define input parameter p-mode as character no-undo .
      651   define input parameter p-obj-type like ub.clients.obj-type no-undo .
      652   define input parameter p-obj-code like ub.clients.obj-code no-undo .
      653   define variable v-sts as integer no-undo .
      654   define variable vattr-codes as character no-undo .
      655   define variable vattr-labels as character no-undo .
      656   define variable ii as integer no-undo .
      657   define variable v-attr-code like ub.clients-attr.attr-code no-undo .
      658   define variable attr-label as character no-undo .
      659   define variable attr-user-can-edit as logical no-undo .
      660   define variable attr-output-display as logical no-undo .
      661   define variable attr-other as char no-undo .
      662   define variable v-prop-list as character no-undo .
      663   define variable v-prop-type-list as character no-undo .
      664   define variable v-prop-label-list as character no-undo .
      665   define variable v-global as logical no-undo .
      666   define variable v-host as logical no-undo .
      667   define variable v-shop as logical no-undo .
      668   define variable v-store as logical no-undo .
      669   define variable v-db as logical   no-undo .
      670   define variable attr-value as char no-undo .
      671   define variable v-spr as character no-undo .
      672   define variable v-title as character no-undo .
      673   define variable v-ii as integer no-undo .
      674   define variable v-ok as integer no-undo .
      675   define variable v-rid-list as character no-undo .
      676   define variable v-rec as recid no-undo .
      677   define variable conf-par as character no-undo .
      678   define variable par-type as character no-undo .
      679   define variable v-firm-code as integer   no-undo .
      680   define variable v-from-obj-code  as integer no-undo .
      681   define variable v-found as decimal no-undo .
      682   define buffer buf_clients for ub.clients.
      683   define buffer buf_sysconf for ub.sysconf.
      684   define buffer buf_shop for ub.shop.
      685   define buffer buf_store for ub.store.
      686   define buffer buf_db for ub.db.
      687   do
      688   on error undo, return error
      689   :
      690   assign
      691   vattr-codes = "":U
      692   vattr-labels = "":U
      693   .
      694   _II:
      695   DO ii = 1 to num-entries('autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U):
      696     run thbjattr_code (
      697                          input entry(ii, 'autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U)
      698                         ,input   '':U
      699                         ,output  attr-label
      700                         ,output  attr-user-can-edit
      701                         ,output  attr-output-display
      702                         ,output  attr-other
      703                         ,output v-prop-list
      704                         ,output v-prop-type-list
      705                         ,output v-prop-label-list
      706                         ,output v-global
      707                         ,output v-host
      708                         ,output v-shop
      709                         ,output v-store
      710                         ,output v-db
      711                       ) no-error.
      712       .
      713       if NOT error-status:error
      714       and attr-user-can-edit
      715       and index(attr-other, "spr-ext=") > 0
      716       anD (if p-obj-type = 'маг':U
      717            then v-shop
      718            else (if p-obj-type = 'скл':U
      719                  then v-store
      720                  else (if p-obj-type = 'орг':U
      721                        then v-host
      722                        else (if p-obj-type = 'БД':U
      723                             then v-db
      724                             else v-global)
      725                       )
      726                  )
      727            ) then do:
      728         if entry(ii, 'autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U) = 'alias-tpsi':U then do:
      729   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      730     (input  'tpsi'
      731     ,input  0
      732     ,input  ''
      733     ,input  0
      734     ,input  ''
      735     ,input  ''
      736     ,input  ''
      737     ,input  no
      738     ,output conf-par
      739     ,output par-type
      740     ) no-error .
      741           if error-status:error
      742           or (conf-par <> "yes") then next _ii.
      743         end.
      744         assign
      745         vattr-codes = vattr-codes + chr(44) + entry(ii, 'autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U)
      746         vattr-labels = vattr-labels + chr(44) + attr-label
      747         .
      748       end.
      749   end.
      750   CASE p-mode:
      751     when 'ПРОСМОТР':U then do:
      752       assign
      753       v-title = "Выберите типы параметров для просмотра".
      754     end.
      755     when 'ИЗМЕНЕНИЕ':U then do:
      756       assign
      757       v-title = "Выберите типы параметров для редактирования".
      758     end.
      759     when  'КОПИРОВАНИЕ':U then do:
      760       assign
      761       v-title = "Выберите типы параметров для копирования".
      762     end.
      763   END CASE.
      764   run gbl/d-list.w (
      765                  INPUT (if p-mode = 'КОПИРОВАНИЕ':U then "b-sel,b-mark":U else "b-sel":U)
      766                 ,INPUT v-title
      767                 ,INPUT vattr-codes
      768                 ,INPUT vattr-labels
      769                 ,INPUT chr(44)
      770                 ,INPUT "":U
      771                 ,output v-attr-code).
      772   IF v-attr-code = "":u THEN do:
      773     RETURN ''.
      774   end.
      775   if p-mode = 'ПРОСМОТР':U
      776   or p-mode = 'ИЗМЕНЕНИЕ':U then do:
      777     run thbjattr_code  in this-procedure (
      778          input   v-attr-code
      779         ,input   '':U
      780         ,output  attr-label
      781         ,output  attr-user-can-edit
      782         ,output  attr-output-display
      783         ,output  attr-other
      784         ,output v-prop-list
      785         ,output v-prop-type-list
      786         ,output v-prop-label-list
      787         ,output v-global
      788         ,output v-host
      789         ,output v-shop
      790         ,output v-store
      791         ,output v-db
      792     ).
      793     do ii = 1 to num-entries(attr-other, chr(47)):
      794       if entry(ii, attr-other, chr(47)) begins "spr-ext=":U then do:
      795         assign
      796         v-spr = entry(2, entry(ii, attr-other, chr(47)), "=").
      797       end.
      798     end.
      799     run value(v-spr) (
      800                      input parparentproc
      801                     ,input p-mode
      802                     ,input p-obj-type
      803                     ,input p-obj-code
      804                     ).
      805   end.
      806   else do:
      807      if p-obj-type = 'маг':U then do:
      808       message
      809       "Выберите магазин для копирования ПАРАМЕТРОВ"
      810       view-as alert-box WARNING.
      811         run adm/shops.w ( input parparentproc
      812                          ,input "b-sel"
      813                          ,input-output v-rid-list
      814                          ,no ).
      815        if v-rid-list = "":U then return.
      816        find first buf_shop no-lock where
      817                 recid(buf_shop) = integer(v-rid-list) .
      818        v-from-obj-code = buf_shop.obj-code.
      819      end.
      820      if p-obj-type = 'орг':U then do:
      821         message
      822         "Выберите ФИРМУ для копирования ПАРАМЕТРОВ"
      823         view-as alert-box WARNING.
      824         run adm/sconfs.w (
      825               input parParentProc
      826             , input "b-sel":U
      827             , input no
      828             , input 0
      829             , output v-firm-code
      830             , input-output v-rid-list
      831         ) no-error.
      832         if v-rid-list = "":U then return.
      833       find first buf_sysconf no-lock
      834                         where recid(buf_sysconf) = integer(entry(1, v-rid-list)).
      835       v-from-obj-code = buf_sysconf.host-code.
      836      end.
      837      if p-obj-type = 'скл':U then do:
      838       message
      839       "Выберите склад для копирования ПАРАМЕТРОВ"
      840       view-as alert-box WARNING.
      841         run adm/stores.w ( input parparentproc
      842                           ,input "b-sel"
      843                           ,input-output v-rid-list
      844                           ,input no ).
      845        if v-rid-list = "":U then return.
      846        find first buf_store no-lock where
      847                 recid(buf_store) = integer(v-rid-list) .
      848        v-from-obj-code = buf_store.obj-code.
      849      end.
      850      if p-obj-type = 'БД':U then do:
      851         message
      852         "Выберите БД для копирования ПАРАМЕТРОВ"
      853         view-as alert-box WARNING.
      854         run adm/dbs.w (
      855               input parParentProc
      856             , input 'ПРОСМОТР':U
      857             , output v-rec
      858         ) no-error.
      859         if v-rec = ? then return.
      860       find first buf_db no-lock
      861                         where recid(buf_db) = v-rec.
      862       v-from-obj-code = buf_db.db-num.
      863      end.
      864      if (p-obj-type = 'маг':U
      865      AND p-obj-code = buf_shop.obj-code )
      866      or (p-obj-type = 'скл':U
      867      AND p-obj-code = buf_store.obj-code )
      868      or (p-obj-type = 'орг':U
      869      AND p-obj-code = buf_sysconf.host-code )
      870      or (p-obj-type = 'БД':U
      871      AND p-obj-code = buf_db.db-num )
      872      or (p-obj-type = '':U
      873      AND p-obj-code = 0 )
      874      then do:
      875        message "Нельзя копировать ПАРАМЕТРЫ самих в себя"
      876        view-as alert-box error .
      877        return error .
      878      end.
      879      run waitfram-show in this-procedure ( input "Ждите..." ).
      880      DO ii = 1 to num-entries(v-attr-code):
      881         for each thbjattr_thbj-attr:
      882           delete thbjattr_thbj-attr.
      883         end.
      884         assign
      885         v-ii = v-ii + 1.
      886         run thbjattr_get-section  in this-procedure (
      887              input  p-obj-type
      888             ,input  v-from-obj-code
      889             ,input  entry(ii, v-attr-code)
      890             ,input '':U
      891             ,input-output table thbjattr_thbj-attr
      892             ,output v-found
      893                                                 ) no-error .
      894         if not error-status:error then do:
      895           run thbjattr_set-section in this-procedure (
      896                                                  input p-obj-type
      897                                                 ,input p-obj-code
      898                                                 ,input entry(ii, v-attr-code)
      899                                                 ,input table thbjattr_thbj-attr ) no-error .
      900           if not error-status:error then
      901           assign
      902           v-ok = v-ok + 1
      903           .
      904         end.
      905      end.
      906      run waitfram-hide in this-procedure .
      907      if v-ii = v-ok then do:
      908         message
      909         substitute("Скопировано &1 параметров с &4&5 на &2&3"
      910                    , v-ok
      911                    , p-obj-type
      912                    , p-obj-code
      913                    , p-obj-type
      914                    , v-from-obj-code
      915                    )
      916         view-as alert-box .
      917      end.
      918      else do:
      919         message
      920         substitute("Из &1 параметров удалось скопировать &2 параметров с &3&4 на &5&6"
      921                    , v-ii
      922                    , v-ok
      923                    , p-obj-type
      924                    , p-obj-code
      925                    , p-obj-type
      926                    , v-from-obj-code
      927                    )
      928         view-as alert-box WARNING.
      929      end.
      930   end.
      931   end.
      932   end procedure.
      933   procedure proc-alt-shift-f2:
      934     if not ibs.th.gbl.gbl-var:rcode
      935   then
      936     run gbl\inidebug.p .
      937   end.
      938   procedure proc-alt-shift-f3:
      939     run gbl/prvssinf.p
      940       ( input this-procedure
      941       ) .
      942   end.
      943   define variable v-inform-launched as logical no-undo initial false .
      944   procedure proc-alt-shift-f4:
      945     define variable v-action as character no-undo .
      946     if v-inform-launched = false then do:
      947       assign
      948         v-inform-launched = true
      949       .
      950       run gbl/d-inform.w
      951         (  input self
      952         ,  input this-procedure
      953         , output v-action
      954         ) no-error .
      955       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      956       assign
      957         v-inform-launched = false
      958       .
      959     end.
