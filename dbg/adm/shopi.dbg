     1176   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1177   define variable v-waitfram-action01         as character   no-undo .
     1178   define variable v-waitfram-action02         as character   no-undo .
     1179   define variable v-waitfram-action03         as character   no-undo .
     1180   define variable mWaitFramTextBeg            as character   no-undo.
     1181   define variable mWaitFramTextEnd            as character   no-undo.
     1182   define variable mWaitFramView               as logical     no-undo.
     1183   define variable mWaitProcEvent              as logical     no-undo init yes.
     1184   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1185   define variable mWaitFramStop               as logical     no-undo.
     1186   define variable mWaitFramStopUser           as logical     no-undo.
     1187   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1188   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1189   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1190   define button B-WaitFramStop auto-end-key
     1191        label "Стоп"
     1192        size 10 by 1 tooltip "Остоновить процесс".
     1193   define button B-viewProcInfo
     1194        label "Информация"
     1195        size 15 by 1 tooltip "Информация о процесс".
     1196   define frame waitfram
     1197     v-waitfram-action01 format "x(72)" no-label skip
     1198     v-waitfram-action02 format "x(72)" no-label skip
     1199     v-waitfram-action03 format "x(72)" no-label skip
     1200     B-viewProcInfo
     1201     B-WaitFramStop at row 4 col 30
     1202     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1203     .
     1204   define new global shared variable mBatchMode as logical no-undo init ?.
     1205   define variable mFramBachModHandle as handle no-undo.
     1206   mFramBachModHandle = frame waitfram:handle.
     1207   define variable mFameOldVis as logical no-undo.
     1208   define variable mVisCUrentVin as logical no-undo.
     1209   if session:batch-mode
     1210   then
     1211      mBatchMode = yes.
     1212   if mBatchMode = ? then do:
     1213     mVisCUrentVin = current-window:visible.
     1214     mFameOldVis = mFramBachModHandle:visible.
     1215     mFramBachModHandle:visible  = yes.
     1216     mBatchMode = mFramBachModHandle:visible ne yes.
     1217     mFramBachModHandle:visible = mFameOldVis.
     1218     current-window:visible = mVisCUrentVin.
     1219   end.
     1220    if  log-manager:logfile-name ne ?
     1221     then DO:
     1222         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1223         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1224         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1225     end.
     1226   on choose of B-WaitFramStop in frame waitfram
     1227   do:
     1228     mWaitFramStop = yes.
     1229     mWaitFramStopUser = yes.
     1230   end.
     1231   function waitfram-check-timeout returns logical():
     1232      define variable vtime as int64 no-undo.
     1233      if mWaitFramStopTimeOut
     1234      then
     1235         return yes.
     1236      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1237      if     mWaitFramTimeOut ne ?
     1238         and mWaitFramTimeOut ne 0
     1239         and mWaitFramTimeOut lt vtime
     1240      then do:
     1241         mWaitFramStopTimeOut = yes.
     1242      end.
     1243      return mWaitFramStopTimeOut.
     1244   end.
     1245   procedure waitfram-hide :
     1246     if not session:batch-mode
     1247     then do
     1248     on error undo, return error return-value
     1249     :
     1250       pause 0 before-hide .
     1251       if not mBatchMode then
     1252         hide frame waitfram .
     1253     if     not mWaitFramView
     1254        and mWaitProcEvent
     1255     then
     1256       process events .
     1257     end.
     1258   end procedure.
     1259   procedure waitfram-show :
     1260     define input  parameter p-message as character no-undo .
     1261     define variable v-left-margin as integer   no-undo .
     1262     if not session:batch-mode
     1263     then do
     1264     on error undo, return error return-value
     1265     :
     1266       if length(p-message) <= 70 then do:
     1267         assign
     1268           v-left-margin = integer((70 - length(p-message)) / 2)
     1269         .
     1270         assign
     1271           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1272         .
     1273         assign
     1274           v-waitfram-action01 = " "
     1275           v-waitfram-action02 = " "
     1276                                    + fill(" ", v-left-margin)
     1277                                    + p-message
     1278           v-waitfram-action03 = " "
     1279         .
     1280       end.
     1281       else do:
     1282         define variable vRindex1 as integer no-undo.
     1283         define variable vRindex2 as integer no-undo.
     1284         vRindex1 = r-index(p-message," ",70).
     1285         if vRindex1 = 0
     1286         then
     1287            vRindex1 = 70.
     1288         if length(p-message)  <= vRindex1 + 70 then do:
     1289           assign
     1290             v-waitfram-action01 = " "
     1291             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1292             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1293           .
     1294         end.
     1295         else do:
     1296           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1297           if vRindex2 <= vRindex1
     1298           then
     1299              vRindex2 = vRindex1 + 70.
     1300           assign
     1301             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1302             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1303             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1304           .
     1305         end.
     1306       end.
     1307       B-viewProcInfo:visible   in frame waitfram = no.
     1308       B-viewProcInfo:sensitive in frame waitfram = no.
     1309       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1310       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1311       if  (   mWaitFramView
     1312          or  mWaitProcEvent)
     1313          and not mBatchMode
     1314       then
     1315          display
     1316             v-waitfram-action01 skip
     1317             v-waitfram-action02 skip
     1318             v-waitfram-action03 skip
     1319          with frame waitfram .
     1320       if     mWaitFramView
     1321          then do:
     1322             if     mWaitFramInterval ne ?
     1323                and not mBatchMode
     1324             then
     1325                wait-for go of frame waitfram pause mWaitFramInterval.
     1326          end.
     1327          else
     1328             if     mWaitProcEvent
     1329                and not mBatchMode
     1330             then
     1331                process events .
     1332     end.
     1333   end procedure.
     1334      procedure waitfram-show-this:
     1335         define input  parameter iInterval as int64 no-undo.
     1336         define variable vtime as int64 no-undo.
     1337         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1338         mWaitFramInterval = iInterval.
     1339         run waitfram-show (substitute("&1&2 &3&4" ,
     1340                                       mWaitFramTextBeg ,
     1341                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1342                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1343                                       mWaitFramTextEnd
     1344                                      )
     1345                           ).
     1346      end.
     1347      procedure WaitFramRunPause:
     1348         define input  parameter iInterval as dec no-undo.
     1349         define variable vStart  as datetime-tz no-undo.
     1350         define variable vend    as datetime-tz no-undo.
     1351         define variable vint as int64 no-undo.
     1352         define variable vOk as logical no-undo.
     1353         vStart = now.
     1354         vend   = vStart.
     1355         publish "WaitFramPause" (iInterval,output vOk).
     1356         vend   =  now.
     1357         vint = vend - vStart.
     1358         vint = iInterval - vint / 1000.
     1359         if     not mWaitFramStop
     1360            and (   vint > 0
     1361                 or (    not vOk
     1362                     and iInterval eq ?
     1363                     )
     1364                 )
     1365         then
     1366            run waitfram-show-this (iInterval).
     1367         vend   =  now.
     1368         vint = vend - vStart.
     1369         vint = iInterval - vint / 1000.
     1370         if     not mWaitFramStop
     1371            and vint > 0
     1372         then do:
     1373            run gbl/pause.p (vint * 1000).
     1374         end.
     1375         if iInterval ne ?
     1376         then
     1377            publish "WaitFramStop".
     1378         waitfram-check-timeout().
     1379      end.
     1380      procedure WaitFramWaitFor:
     1381         define input  parameter iInterval as dec no-undo.
     1382         assign
     1383            mWaitFramStartProc   = now
     1384            mWaitFramStopUser    = no
     1385            mWaitFramStopTimeOut = no
     1386         .
     1387         block-wait:
     1388         do while not mWaitFramStop:
     1389            run WaitFramRunPause (iInterval).
     1390            if  waitfram-check-timeout()
     1391            then do:
     1392               leave block-wait.
     1393            end.
     1394         end.
     1395         run waitfram-hide.
     1396      end.
     1397   procedure waitfram-join :
     1398     define input  parameter p-line-1  as character no-undo .
     1399     define input  parameter p-line-2  as character no-undo .
     1400     define input  parameter p-line-3  as character no-undo .
     1401     define output parameter p-message as character no-undo .
     1402     do
     1403     on error undo, return error return-value
     1404     :
     1405       assign
     1406         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1407                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1408                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1409       .
     1410     end.
     1411   end procedure.
     1412   function waitfram-join-function returns character
     1413     (input p-line-1 as character
     1414     ,input p-line-2 as character
     1415     ,input p-line-3 as character
     1416     ).
     1417     define variable v-message as character no-undo .
     1418     run waitfram-join in this-procedure
     1419       (input  p-line-1
     1420       ,input  p-line-2
     1421       ,input  p-line-3
     1422       ,output v-message
     1423       ) .
     1424     return v-message .
     1425   end function .
