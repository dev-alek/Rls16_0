     2281         return no-apply.
     2282       end.
     2283    END.
     2284   ON CTRL-enter OF tt-clients.db-num IN FRAME Dialog-Frame
     2285   DO:
     2286     define variable  ri as recid no-undo.
     2287     define buffer buf_db for ub.db .
     2288     run adm/dbs.w (
     2289                   input parparentproc
     2290                  ,input 'ПРОСМОТР':U
     2291                  ,output ri).
     2292     if ri <> ? then  do:
     2293       FIND first buf_db where recid( ub.db ) = ri .
     2294       display
     2295       buf_db.db-num @ tt-clients.db-num
     2296       with frame Dialog-Frame.
     2297     end.
     2298   END.
     2299   ON RETURN OF tt-clients.db-num IN FRAME Dialog-Frame
     2300   DO:
     2301     RUN chk-db no-error.
     2302     if error-status:error  THEN do:
     2303       apply "ctrl-enter":U to self.
     2304       return no-apply.
     2305     end.
     2306   END.
     2307   ON VALUE-CHANGED OF tt-shop.doc-prt IN FRAME Dialog-Frame
     2308   DO:
     2309   define variable glog as logical no-undo .
     2310     if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
     2311       if (tt-shop.doc-prt:checked ) <> tt-shop.doc-prt
     2312       then do:
     2313         run trg/objatchk.p
     2314           (input 'маг':U
     2315           ,input tt-shop.obj-code
     2316           ,input "doc-prt":u
     2317           ,input tt-shop.doc-prt :checked in frame Dialog-Frame
     2318           ) no-error .
     2319         if error-status :error then do:
     2320           assign
     2321           tt-shop.doc-prt :checked in frame Dialog-Frame = tt-shop.doc-prt
     2322           .
     2323           return no-apply .
     2324         end.
     2325       end.
     2326     end.
     2327   END.
     2328   ON VALUE-CHANGED OF tt-shop.is-kitchen IN FRAME Dialog-Frame
     2329   DO:
     2330   assign tt-shop.is-kitchen.
     2331     run on-off-kitchen in this-procedure(tt-shop.is-kitchen) no-error.
     2332     if error-status:error then return no-apply.
     2333   END.
     2334   ON CHOOSE OF MENU-ITEM m-choose
     2335   DO:
     2336      DEFINE VARIABLE v-obj-code LIKE ub.clients.obj-code NO-UNDO.
     2337     run ref/chs-code.w ('маг':U, v-cntxt-db-num, OUTPUT v-obj-code) no-error .
     2338     if not error-status:error
     2339     and v-obj-code <> ? then do:
     2340       display
     2341       v-obj-code @ tt-shop.obj-code
     2342       with frame Dialog-Frame .
     2343     end.
     2344   END.
     2345   ON LEAVE OF tt-shop.obj-code IN FRAME Dialog-Frame
     2346   DO:
     2347    define variable choice as integer no-undo .
     2348    define variable glog as logical no-undo .
     2349    if input frame Dialog-Frame tt-shop.obj-code > 999
     2350    and  p-mode = 'ДОБАВЛЕНИЕ':U then do:
     2351     glog = no.
     2352     run gbl/d-askw.w (input "Рекомендация",
     2353                           input  ("Код нового магазина рекомендуется сделать меньшим 1000," + chr(10)
     2354                                   + "иначе у Вас могут возникнуть проблемы при работе с кассой IBM"),
     2355                           input "|",
     2356                           input "Продолжить с выбранным номером магазина|Отменить",
     2357                           input "|",
     2358                           input 1,
     2359                           input 2,
     2360                           output choice).
     2361       if choice = 2
     2362       then do:
     2363           apply "ENTRY":U to tt-shop.obj-code IN frame Dialog-Frame.
     2364           return no-apply.
     2365       end.
     2366     end.
     2367   END.
     2368   ON VALUE-CHANGED OF tt-shop.shift-on IN FRAME Dialog-Frame
     2369   DO:
     2370     if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
     2371       if tt-shop.shift-on :checked in frame Dialog-Frame <> tt-shop.shift-on
     2372       then do:
     2373         run trg/objatchk.p
     2374           (input 'маг':U
     2375           ,input tt-shop.obj-code
     2376           ,input "shift-on":u
     2377           ,input tt-shop.shift-on :checked in frame Dialog-Frame
     2378           ) no-error .
     2379         if error-status :error
     2380         then do:
     2381           assign
     2382           tt-shop.shift-on :checked in frame Dialog-Frame = tt-shop.shift-on
     2383           .
     2384           return no-apply .
     2385         end.
     2386       end.
     2387     end.
     2388   END.
     2389   ON VALUE-CHANGED OF tt-shop.sub-store-on IN FRAME Dialog-Frame
     2390   DO:
     2391     if input frame Dialog-Frame tt-shop.sub-store-on = yes
     2392     then do:
     2393       ENABLE
     2394       b-sub-store
     2395       with frame Dialog-Frame.
     2396     end.
     2397     else do:
     2398       DISABLE
     2399       b-sub-store
     2400       with frame Dialog-Frame.
     2401     end.
     2402   END.
     2403   ON VALUE-CHANGED OF varenvd IN FRAME Dialog-Frame
     2404   DO:
     2405     ASSIGN FRAME Dialog-Frame
     2406       varenvd.
     2407   END.
     2408   ON VALUE-CHANGED OF varpharm IN FRAME Dialog-Frame
     2409   DO:
     2410     ASSIGN FRAME Dialog-Frame
     2411       VARpharm.
     2412   END.
     2413   ON VALUE-CHANGED OF varpurch-code-name IN FRAME Dialog-Frame
     2414   DO:
     2415     ASSIGN FRAME Dialog-Frame varpurch-code-name.
     2416   END.
     2417   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2418   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2419   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2420   on help of frame Dialog-Frame
     2421   do:
     2422     run gbl/app_help.p
     2423       (input this-procedure :file-name
     2424       ,input ''
     2425       ,input ?
     2426       ) no-error.
     2427     if error-status :error then do:
     2428       message
     2429         "Ошибка при вызове помощи"
     2430         error-status :get-message(1)
     2431         view-as alert-box .
     2432     end.
     2433   end.
     2434   run minbtn-set in this-procedure .
     2435   on choose of b-help in frame Dialog-Frame
     2436   do:
     2437     apply "help":u to frame Dialog-Frame .
     2438   end.
     2439   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2440   procedure minbtn-set :
     2441       do
     2442           on error undo, return error return-value
     2443           :
     2444           define variable ii              as integer       no-undo .
     2445           define variable fh              as widget-handle no-undo .
     2446           define variable hh              as widget-handle no-undo .
     2447           define variable v-h             as handle        extent 4 no-undo .
     2448           define variable v-name-button   as character     no-undo .
     2449           define variable v-help-old-x    as decimal       no-undo .
     2450           define variable v-help-old-y    as decimal       no-undo .
     2451           define variable v-help-old-size as decimal       no-undo .
     2452           define variable v-frame-width   as decimal       no-undo .
     2453           define variable jj              as integer       no-undo .
     2454           do
     2455               on error undo, return error
     2456               :
     2457               assign
     2458                   v-frame-width = frame Dialog-Frame:width - 0.3
     2459                   fh            = frame Dialog-Frame:first-child
     2460                   hh            = fh:first-child
     2461                   ii            = 1
     2462                   .
     2463               do while valid-handle(hh):
     2464                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2465                   do:
     2466                       case lc(hh:name) :
     2467                           when "b-help" then
     2468                               do:
     2469                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2470                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2471                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2472                                   hh:TOOLTIP = "Помощь" .
     2473                                   v-help-old-x = hh:column .
     2474                                   v-help-old-y = hh:row    .
     2475                                   v-help-old-size = hh:width .
     2476                                   hh:width-chars = 2.5 .
     2477                               end.
     2478                           when "b-print" then
     2479                               do:
     2480                                   hh:load-image("cmp/b-print.bmp":u) .
     2481                                   hh:TOOLTIP = "Печать" .
     2482                                   v-h[ii] = hh:handle .
     2483                                   ii = ii + 1 .
     2484                                   hh:width-chars = 3 .
     2485                               end.
     2486                           when "b-history" or
     2487                           when "b-hist" then
     2488                               do:
     2489                                   hh:load-image("cmp/b-hist.bmp":u) .
     2490                                   hh:TOOLTIP = "История" .
     2491                                   v-h[ii] = hh:handle .
     2492                                   ii = ii + 1 .
     2493                                   hh:width-chars = 3 .
     2494                               end.
     2495                           when "b-sch" then
     2496                               do:
     2497                                   hh:load-image("cmp/b-sch.bmp":u) .
     2498                                   hh:TOOLTIP = "Установка Фильтра" .
     2499                                   v-h[ii] = hh:handle .
     2500                                   ii = ii + 1 .
     2501                                   hh:width-chars = 3 .
     2502                               end.
     2503                           when "b-hist-user" then
     2504                               do:
     2505                                   hh:load-image("cmp/b-hist.bmp":u) .
     2506                                   hh:TOOLTIP = "История пользователя" .
     2507                                   ii = ii + 1 .
     2508                               end.
     2509                       end case.
     2510                   end.
     2511                   hh = hh:next-sibling.
     2512               end.
     2513               b-help:column = v-frame-width - b-help:width-chars.
     2514               jj = 0.
     2515               repeat ii = 4 to 1 by -1 :
     2516                   if valid-handle (v-h[ii] ) then
     2517                   do:
     2518                       jj  = jj + 1 .
     2519                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2520                       v-h[ii]:row    = v-help-old-y .
     2521                   end.
     2522               end.
     2523           end.
     2524       end.
     2525   end procedure.
     2526   MAIN-BLOCK:
     2527   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2528      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2529   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2530     run mainmenu_getcntxt in parparentproc
     2531       (output v-cntxt-db-num
     2532       ,output v-cntxt-userid
     2533       ,output v-cntxt-level
     2534       ,output v-cntxt-host-code-obj
     2535       ,output v-cntxt-obj-type
     2536       ,output v-cntxt-obj-code
     2537       ,output v-cntxt-db-num-obj
     2538       ,output v-cntxt-is-admin
     2539       ) .
     2540    if p-mode  <> 'ДОБАВЛЕНИЕ':U
     2541    and p-mode <> 'ИЗМЕНЕНИЕ':U
     2542    and p-mode <> 'ПРОСМОТР':U
     2543    then do:
     2544       message
     2545       vss-workfile vss-revision vss-description skip
     2546       "Неверное значение параметров вызова p-mode"  p-mode
     2547       view-as alert-box ERROR.
     2548       undo, return error.
     2549    end.
     2550   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2551   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2552     (output v-db-num
     2553     )  .
     2554   if p-mode <> 'ПРОСМОТР':U then do:
     2555     if v-db-num <> 0 then do:
     2556       message
     2557       vss-workfile vss-revision vss-description skip
     2558       "Неверное значение параметров вызова p-mode - нельзя изменять/добавлять записи МАГАЗИН в УБД"
     2559       view-as alert-box ERROR.
     2560       undo, return error.
     2561     end.
     2562   end.
     2563   for each tt-shop:
     2564     delete tt-shop.
     2565   end.
     2566   for each tt-clients:
     2567     delete tt-clients.
     2568   end.
     2569   if p-mode = 'ДОБАВЛЕНИЕ':U  then do:
     2570       message
     2571       "Вам следует выбрать группу," skip
     2572       "к которой будет относиться магазин."
     2573       view-as alert-box.
     2574       ref-list = "".
     2575       run ref/cli-grps.w ( input parparentproc, "b-sel", input-output ref-list ) .
     2576       if ref-list <> "" then  do:
     2577         FIND buf_cli-grp where
     2578             recid( buf_cli-grp ) = integer( ref-list ) .
     2579         if can-find( FIRST ub.cli-grp where ub.cli-grp.upper-code = buf_cli-grp.node-code )
     2580         then do:
     2581           message
     2582           "Добавлять можно только в группы," skip
     2583           "у которых нет подгрупп." skip
     2584           "Выбирайте другую группу !".
     2585           return .
     2586         end.
     2587       end.
     2588       else return .
     2589       create tt-clients.
     2590       create tt-shop.
     2591       assign
     2592       tt-clients.grp-code = buf_cli-grp.node-code
     2593       tt-clients.obj-type = 'маг':U
     2594       tt-shop.discaloc = yes
     2595       tt-shop.doc-prt = false
     2596       tt-shop.work-hours = if tt-shop.work-hours <> "" then tt-shop.work-hours else "08.00,20.00"
     2597       .
     2598     end.
     2599     else do:
     2600       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     2601         do transaction
     2602         ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2603         ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2604           FIND first locked_clients exclusive-lock where
     2605                   recid( locked_clients ) = p-rid no-error .
     2606           if not available locked_clients then do:
     2607             FIND first locked_clients exclusive-lock where
     2608                     locked_clients.obj-type = 'маг':U
     2609                   AND locked_clients.obj-code = p-obj-code no-wait no-error .
     2610           if locked locked_clients then do:
     2611             message
     2612             vss-workfile vss-revision vss-description skip
     2613             "Запись КЛИЕНТ для МАГАЗИНА" p-obj-code "занята"
     2614             view-as alert-box error .
     2615             undo, return error.
     2616           end.
     2617           end.
     2618           FIND first locked_shop exclusive-lock where
     2619                     locked_shop.obj-code = locked_clients.obj-code .
     2620         end.
     2621       end.
     2622       if p-mode = 'ПРОСМОТР':U then do:
     2623         FIND first locked_clients no-lock where
     2624                 recid( locked_clients ) = p-rid.
     2625         FIND first locked_shop no-lock where
     2626                   locked_shop.obj-code = locked_clients.obj-code .
     2627       end.
     2628       create tt-clients.
     2629       create tt-shop.
     2630       buffer-copy locked_clients to tt-clients.
     2631       buffer-copy locked_shop to tt-shop.
     2632       FIND FIRST buf_cli-host NO-LOCK WHERE
     2633                  buf_cli-host.obj-code = locked_shop.host-code AND
     2634                  buf_cli-host.obj-type = 'орг':U NO-ERROR.
     2635         if avail buf_cli-host then do:
     2636           assign
     2637           frame Dialog-Frame:title =
     2638           "Настройки магазина фирмы ~"" + buf_cli-host.obj-name +
     2639           "~" ("   + string( tt-shop.host-code )   + ").".
     2640         end.
     2641       end.
     2642       assign
     2643       tt-shop.work-hours = if tt-shop.work-hours <> "" then tt-shop.work-hours else "08.00,20.00"
     2644       .
     2645       assign
     2646       all-prt_ = tt-shop.all-prt
     2647       cd-bc-alt_ = tt-shop.cd-bc-alt
     2648       cd-bc-base_ = tt-shop.cd-bc-base
     2649       cd-loc-alt_ = tt-shop.cd-loc-alt
     2650       cd-loc-base_ = tt-shop.cd-loc-base
     2651       cd-parts-all_ = tt-shop.cd-parts-all
     2652       cd-parts-not-blank_ = tt-shop.cd-parts-not-blank
     2653       cd-parts-ser_ = tt-shop.cd-parts-ser
     2654       cd-pb-alt_ = tt-shop.cd-pb-alt
     2655       cd-pb-base_ = tt-shop.cd-pb-base
     2656       cd-sc-base_ = tt-shop.cd-sc-base
     2657       .
     2658    ASSIGN
     2659       varpurch-code-name:LIST-ITEMS = "по настройкам фирмы" + "," + 'выкуп,консигнация,ответственное хранение,старая консигнация':U.
     2660     IF tt-shop.purch-code = ? THEN DO:
     2661       ASSIGN
     2662         varpurch-code-name = "по настройкам фирмы".
     2663     END.
     2664     ELSE DO:
     2665           assign
     2666         varpurch-code-name = entry (lookup (string(tt-shop.purch-code), '1,2,3,4':U), 'выкуп,консигнация,ответственное хранение,старая консигнация':U).
     2667     END.
     2668     RUN clntattr-value IN THIS-PROCEDURE
     2669       (INPUT 'маг':U,
     2670        INPUT tt-shop.obj-code,
     2671        input 'pharm':U,
     2672        OUTPUT v-pharm,
     2673        OUTPUT var-type).
     2674     IF v-pharm = "yes":u THEN DO:
     2675       ASSIGN
     2676         varpharm = YES.
     2677     END.
     2678     ELSE DO:
     2679       ASSIGN
     2680         varpharm = NO.
     2681     END.
     2682     RUN clntattr-value IN THIS-PROCEDURE
     2683       (INPUT 'маг':U,
     2684        INPUT tt-shop.obj-code,
     2685        input 'envd':U,
     2686        OUTPUT v-envd,
     2687        OUTPUT var-type).
     2688     IF v-envd = "yes":u THEN DO:
     2689       ASSIGN
     2690         varenvd = YES.
     2691     END.
     2692     ELSE DO:
     2693       ASSIGN
     2694         varenvd = NO.
     2695     END.
     2696     RUN clntattr-value IN THIS-PROCEDURE
     2697       (INPUT 'маг':U,
     2698        INPUT tt-shop.obj-code,
     2699        input 'kpp':U,
     2700        OUTPUT v-kpp,
     2701        OUTPUT var-type).
     2702      kpp:screen-value = v-kpp.
     2703      run init-firmhold in this-procedure.
     2704     RUN Myenable.
     2705     if p-mode = 'ДОБАВЛЕНИЕ':U then
     2706         WAIT-FOR GO OF FRAME Dialog-Frame FOCUS tt-shop.obj-code.
     2707     else
     2708         WAIT-FOR GO OF FRAME Dialog-Frame FOCUS tt-clients.obj-name .
     2709   END.
     2710   RUN disable_UI.
     2711   PROCEDURE chk-db :
     2712      if ( not can-find( ub.db where ub.db.db-num = input FRAME Dialog-Frame tt-clients.db-num ))
     2713     then do:
     2714         message "Неверный номер. Номер может быть:" skip
     2715                         "    0, 1, ... -- номер существующей БД" skip
     2716                         " CTRL-ENTER  -- вызов справочника."  view-as alert-box.
     2717         apply "ENTRY":U  to tt-clients.db-num IN FRAME Dialog-Frame.
     2718         return error.
     2719     end.
     2720   END PROCEDURE.
     2721   PROCEDURE disable_UI :
     2722     HIDE FRAME Dialog-Frame.
     2723   END PROCEDURE.
     2724   PROCEDURE enable_UI :
     2725     DISPLAY KPP varpurch-code-name varenvd varpharm fi-holdfirm-code
     2726             fi-holdfirm-name
     2727         WITH FRAME Dialog-Frame.
     2728     IF AVAILABLE tt-clients THEN
     2729       DISPLAY tt-clients.db-num tt-clients.obj-name
     2730         WITH FRAME Dialog-Frame.
     2731     IF AVAILABLE tt-shop THEN
     2732       DISPLAY tt-shop.obj-code tt-shop.director tt-shop.addres1 tt-shop.phone
     2733             tt-shop.addres2 tt-shop.fax tt-shop.rsrv-time tt-shop.doc-prt
     2734             tt-shop.price-calc tt-shop.in-pay tt-shop.no-eq tt-shop.out-pay
     2735             tt-shop.unit-cli-perm tt-shop.ret-pay tt-shop.out-rate tt-shop.in-perm
     2736             tt-shop.ret-sup-pay tt-shop.out-line-discnt tt-shop.down-pay
     2737             tt-shop.in-ov tt-shop.inv-pay tt-shop.inout-price tt-shop.chk-pay
     2738             tt-shop.day-only tt-shop.fbr-pay tt-shop.buy-goods tt-shop.with-serv
     2739             tt-shop.pr-cash tt-shop.sub-store-type tt-shop.sub-store-code
     2740             tt-shop.discaloc tt-shop.shift-on tt-shop.kitchen-store-code
     2741             tt-shop.sub-store-on tt-shop.is-catering tt-shop.is-kitchen
     2742             tt-shop.is-kitchen-store
     2743         WITH FRAME Dialog-Frame.
     2744     ENABLE B-exit RECT-10 RECT-kitchen-store RECT-sub-store b-quit b-reset CliPS
     2745            b-tocd b-host tt-clients.db-num b-db B-hist B-Help tt-shop.obj-code
     2746            tt-clients.obj-name B-attr Btn_trn-reason tt-shop.director
     2747            tt-shop.addres1 tt-shop.phone tt-shop.addres2 tt-shop.fax
     2748            tt-shop.rsrv-time tt-shop.doc-prt tt-shop.price-calc tt-shop.in-pay
     2749            b-inpay tt-shop.no-eq tt-shop.out-pay b-outpay tt-shop.unit-cli-perm
     2750            tt-shop.ret-pay b-retpay tt-shop.out-rate tt-shop.in-perm
     2751            tt-shop.ret-sup-pay b-suppay tt-shop.out-line-discnt tt-shop.down-pay
     2752            b-spipay tt-shop.in-ov tt-shop.inv-pay b-invpay tt-shop.inout-price
     2753            tt-shop.chk-pay b-realpay tt-shop.day-only tt-shop.fbr-pay b-fbrpay
     2754            tt-shop.buy-goods tt-shop.with-serv tt-shop.pr-cash
     2755            tt-shop.sub-store-type tt-shop.sub-store-code b-sub-store
     2756            tt-shop.discaloc tt-shop.shift-on tt-shop.kitchen-store-code
     2757            b-kitchen-store tt-shop.sub-store-on tt-shop.is-catering
     2758            tt-shop.is-kitchen b-holdfirm tt-shop.is-kitchen-store
     2759            varenvd varpharm
     2760         WITH FRAME Dialog-Frame.
     2761     VIEW FRAME Dialog-Frame.
     2762   END PROCEDURE.
     2763   PROCEDURE init-firmhold :
     2764       define variable v-outhold       as character    no-undo.
     2765       define variable v-par-type      as character    no-undo.
     2766       define variable v-firm-code-str as character    no-undo.
     2767       define variable v-firm-code     as integer      no-undo.
     2768       define buffer buf_clients   for ub.clients.
     2769       define buffer buf_shop      for ub.shop.
     2770   do
     2771   for buf_clients
     2772     , buf_shop
     2773   on error undo, return error
     2774   :
     2775       if available tt-shop
     2776       and tt-shop.host-code <> 0
     2777       then do:
     2778           find first buf_shop no-lock
     2779                where buf_shop.obj-code = tt-shop.obj-code
     2780           no-error.
     2781           if available buf_shop
     2782           then do:
     2783               run gbl/conf-rd.p (
     2784                   input "outhold":U
     2785                   , input tt-shop.host-code
     2786                   , input 'маг':U
     2787                   , input tt-shop.obj-code
     2788                   , input "":U
     2789                   , input "":U
     2790                   , input "":U
     2791                   , input no
     2792                   , output v-outhold
     2793                   , output v-par-type
     2794               ) no-error.
     2795               if error-status :error
     2796               then do:
     2797                   assign
     2798                       v-outhold            = ""
     2799                   .
     2800               end.
     2801               if v-outhold <> "":U
     2802               then do:
     2803                   assign
     2804                       v-shopi-have-holdfirm                              = yes
     2805                   .
     2806                   run clntattr-value in this-procedure (
     2807                       input 'маг':U
     2808                       , input tt-shop.obj-code
     2809                       , input 'holdfirm-code':U
     2810                       , output v-firm-code-str
     2811                       , output v-par-type
     2812                   ).
     2813                   assign
     2814                       v-firm-code = integer( v-firm-code-str )
     2815                   no-error.
     2816                   if error-status :error
     2817                   then do:
     2818                       assign
     2819                           v-firm-code = 0
     2820                       .
     2821                   end.
     2822                   else do:
     2823                       if v-firm-code = 0
     2824                       then do:
     2825                           assign
     2826                               fi-holdfirm-code = 0
     2827                               fi-holdfirm-name = "":U
     2828                           .
     2829                       end.
     2830                       else do:
     2831                           find first buf_clients no-lock
     2832                               where buf_clients.obj-type = 'орг':U
     2833                               and buf_clients.obj-code = v-firm-code
     2834                           no-error.
     2835                           if available buf_clients
     2836                           then do:
     2837                               assign
     2838                                   fi-holdfirm-code = v-firm-code
     2839                                   fi-holdfirm-name = buf_clients.obj-name
     2840                               .
     2841                           end.
     2842                           else do:
     2843                               assign
     2844                                   fi-holdfirm-code = 0
     2845                                   fi-holdfirm-name = "":U
     2846                               .
     2847                           end.
     2848                       end.
     2849                   end.
     2850               end.
     2851               else do:
     2852                   assign
     2853                       v-shopi-have-holdfirm                              = no
     2854                   .
     2855               end.
     2856           end.
     2857       end.
     2858   end.
     2859   END PROCEDURE.
     2860   PROCEDURE MyENable :
     2861   IF AVAILABLE tt-clients THEN
     2862       DISPLAY tt-clients.obj-name tt-clients.db-num
     2863         WITH FRAME Dialog-Frame.
     2864     IF AVAILABLE tt-shop THEN
     2865       DISPLAY
     2866       tt-shop.obj-code
