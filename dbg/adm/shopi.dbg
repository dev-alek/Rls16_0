     2206   ON CHOOSE OF b-tocd IN FRAME Dialog-Frame
     2207   DO:
     2208     if  tt-shop.host-code = 0
     2209     or tt-shop.host-code = ?
     2210     then do:
     2211       message "Фирма не выбрана ! "
     2212               view-as alert-box error.
     2213       return no-apply.
     2214     end.
     2215       assign
     2216       all-prt_ = tt-shop.all-prt
     2217       cd-bc-alt_ = tt-shop.cd-bc-alt
     2218       cd-bc-base_ = tt-shop.cd-bc-base
     2219       cd-loc-alt_ = tt-shop.cd-loc-alt
     2220       cd-loc-base_ = tt-shop.cd-loc-base
     2221       cd-parts-all_ = tt-shop.cd-parts-all
     2222       cd-parts-not-blank_ = tt-shop.cd-parts-not-blank
     2223       cd-parts-ser_ = tt-shop.cd-parts-ser
     2224       cd-pb-alt_ = tt-shop.cd-pb-alt
     2225       cd-pb-base_ = tt-shop.cd-pb-base
     2226       cd-sc-base_ = tt-shop.cd-sc-base.
     2227       run adm/to-cd.w (
     2228                      INPUT p-mode
     2229                     ,INPUT tt-shop.host-code
     2230                     ,INPUT 'маг':U
     2231                     ,INPUT tt-shop.obj-code
     2232                     ,INPUT ("Параметры отсылки товаров на кассу для магазина " +
     2233                     string(tt-shop.obj-code) + " фирмы " + string(tt-shop.host-code))
     2234                     ,INPUT-OUTPUT all-prt_
     2235                     ,INPUT-OUTPUT cd-bc-alt_
     2236                     ,INPUT-OUTPUT cd-bc-base_
     2237                     ,INPUT-OUTPUT cd-loc-alt_
     2238                     ,INPUT-OUTPUT cd-loc-base_
     2239                     ,INPUT-OUTPUT cd-parts-all_
     2240                     ,INPUT-OUTPUT cd-parts-not-blank_
     2241                     ,INPUT-OUTPUT cd-parts-ser_
     2242                     ,INPUT-OUTPUT cd-pb-alt_
     2243                     ,INPUT-OUTPUT cd-pb-base_
     2244                     ,INPUT-OUTPUT cd-sc-base_) no-error.
     2245       if error-status:error then return no-apply.
     2246       assign
     2247       tt-shop.all-prt             = all-prt_
     2248       tt-shop.cd-bc-alt           = cd-bc-alt_
     2249       tt-shop.cd-bc-base          = cd-bc-base_
     2250       tt-shop.cd-loc-alt          = cd-loc-alt_
     2251       tt-shop.cd-loc-base         = cd-loc-base_
     2252       tt-shop.cd-parts-all        = cd-parts-all_
     2253       tt-shop.cd-parts-not-blank  = cd-parts-not-blank_
     2254       tt-shop.cd-parts-ser        = cd-parts-ser_
     2255       tt-shop.cd-pb-alt           = cd-pb-alt_
     2256       tt-shop.cd-pb-base          = cd-pb-base_
     2257       tt-shop.cd-sc-base          = cd-sc-base_
     2258       .
     2259   END.
     2260   ON CHOOSE OF Btn_trn-reason IN FRAME Dialog-Frame
