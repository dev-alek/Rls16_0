     3030   PROCEDURE on-off-kitchen :
     3031   define input parameter p-is-kitchen like ub.shop.is-kitchen no-undo.
     3032   case p-is-kitchen :
     3033       when no then do:
     3034           disable
     3035           b-kitchen-store
     3036           tt-shop.kitchen-store-code
     3037           with frame Dialog-Frame
     3038           .
     3039           hide
     3040           b-kitchen-store
     3041           tt-shop.kitchen-store-code
     3042           rect-kitchen-store
     3043           in frame Dialog-Frame.
     3044           .
     3045       end.
     3046       when yes then do:
     3047               enable
     3048           b-kitchen-store
     3049           tt-shop.kitchen-store-code
     3050           with frame Dialog-Frame
     3051           .
     3052           display
     3053           b-kitchen-store
     3054           tt-shop.kitchen-store-code
     3055           rect-kitchen-store
     3056           with frame Dialog-Frame.
     3057       end.
     3058   END CASE.
     3059   END PROCEDURE.
     3060   PROCEDURE proc-save :
     3061   define input parameter p-save as logical no-undo .
     3062       define buffer buf_clients       for ub.clients.
     3063   do
     3064   for buf_clients
     3065   on error undo, return error
     3066   :
     3067   if p-mode =  'ДОБАВЛЕНИЕ':U
     3068   and (new-host-code = ?
     3069        or
     3070        new-host-code = 0)
     3071   then do:
     3072     message "Фирма не выбрана."
     3073     view-as alert-box error.
     3074     return error.
     3075   end.
     3076   assign
