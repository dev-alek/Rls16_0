      970     run proc-alt-shift-f3 in this-procedure .
      971   end.
      972   on alt-shift-f4 anywhere do:
      973     run proc-alt-shift-f4 in this-procedure.
      974   end.
      975   on alt-f1 anywhere do:
      976     run proc-alt-f1 in this-procedure .
      977   end.
      978   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      979     define variable v-cntxt-db-num        as integer   no-undo .
      980     define variable v-cntxt-userid        as character no-undo .
      981     define variable v-cntxt-level         as character no-undo .
      982     define variable v-cntxt-host-code-obj as integer   no-undo .
      983     define variable v-cntxt-obj-type      as character no-undo .
      984     define variable v-cntxt-obj-code      as integer   no-undo .
      985     define variable v-cntxt-db-num-obj    as integer   no-undo .
      986     define variable v-cntxt-is-admin      as logical   no-undo .
      987   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      988   define temp-table userobjs_temp-user-obj no-undo
      989     field obj-type as character
      990     field obj-code as integer
      991     index xpk is primary unique obj-type obj-code
      992     .
      993   procedure userobjs_clear :
      994     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      995     do
      996     on error undo, return error return-value
      997     :
      998       for each buf_userobjs_temp-user-obj
      999       on error undo, return error return-value
     1000       :
     1001         delete buf_userobjs_temp-user-obj .
     1002       end.
     1003     end.
     1004   end .
     1005   procedure userobjs_object-count :
     1006     define output parameter p-total-count as integer   no-undo .
     1007     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1008     do
     1009     on error undo, return error return-value
     1010     :
     1011       assign
     1012         p-total-count = 0
     1013       .
     1014       for each buf_userobjs_temp-user-obj
     1015       on error undo, return error return-value
     1016       :
     1017         assign
     1018           p-total-count = p-total-count + 1
     1019         .
     1020       end.
     1021     end.
     1022   end.
     1023   procedure userobjs_append :
     1024      define input  parameter p-obj-type as character no-undo .
     1025      define input  parameter p-obj-code as integer   no-undo .
     1026     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1027     do
     1028     on error undo, return error return-value
     1029     :
     1030       find first buf_userobjs_temp-user-obj
     1031         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1032           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1033         no-error .
     1034       if not available buf_userobjs_temp-user-obj
     1035       then do:
     1036         create buf_userobjs_temp-user-obj .
     1037         assign
     1038           buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1039           buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1040         .
     1041       end.
     1042     end.
     1043   end.
     1044   procedure userobjs_object-exist :
     1045     define output parameter p-object-exist as logical   no-undo .
     1046     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1047     do
     1048     on error undo, return error return-value
     1049     :
     1050       find first buf_userobjs_temp-user-obj
     1051         no-error .
     1052       if not available buf_userobjs_temp-user-obj
     1053       then do:
     1054         assign
     1055           p-object-exist = false
     1056         .
     1057       end.
     1058       else do:
     1059         assign
     1060           p-object-exist = true
     1061         .
     1062       end.
     1063     end.
     1064   end.
     1065   procedure userobjs_transfer :
     1066     define input  parameter p-callback-handle as handle no-undo .
     1067     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
     1068     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1069     do
     1070     on error undo, return error return-value
     1071     :
     1072       if valid-handle(p-callback-handle) <> true
     1073       then do:
     1074         message
     1075           vss-workfile vss-revision vss-description skip
     1076           "Ошибка задания входных параметров" skip
     1077           "Неизвестный указатель на процедуру" skip
     1078           view-as alert-box error .
     1079         undo, return error return-value .
     1080       end.
     1081       if p-callback-handle :get-signature("userobjs_append") = ""
     1082       then do:
     1083         message
     1084           vss-workfile vss-revision vss-description skip
     1085           "Ошибка задания входных параметров" skip
     1086           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
     1087                     ,p-callback-handle :file-name
     1088                     ) skip
     1089           view-as alert-box error .
     1090         undo, return error return-value .
     1091       end.
     1092       for each buf_userobjs_temp-user-obj
     1093       on error undo, return error return-value
     1094       :
     1095         run userobjs_append in p-callback-handle
     1096           (input  buf_userobjs_temp-user-obj.obj-type
     1097           ,input  buf_userobjs_temp-user-obj.obj-code
     1098           ) .
     1099       end.
     1100     end.
     1101   end procedure.
