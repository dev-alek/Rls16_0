      432               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      433               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      434               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      435               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      436               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      437               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      438               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      439               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      440         otherwise do:
      441               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      442         end.
      443       end.
      444     end.
      445   end procedure.
      446   procedure schedule-attr-value :
      447   do
      448   on error undo, return error return-value
      449   :
      450   define input parameter  p-cre-db-num as integer    no-undo.
      451   define input parameter  p-task-type  as character  no-undo.
      452   define input parameter  p-task-num   as integer    no-undo.
      453   define input parameter  p-code       as character  no-undo.
      454   define output parameter p-value      as character  no-undo.
      455   define output parameter p-type       as character  no-undo.
      456       define variable v-format         as character no-undo .
      457       define variable v-label          as character no-undo .
      458       define variable v-user-can-edit  as logical   no-undo .
      459       define variable v-output-display as logical   no-undo .
      460       define variable v-other          as character no-undo .
      461       define buffer buf_schedule-attr for ub.schedule-attr.
      462       run schedule-attr-name in this-procedure (
      463             input  p-code
      464           , output p-type
      465           , output v-format
      466           , output v-label
      467           , output v-user-can-edit
      468           , output v-output-display
      469           , output v-other
      470       ) no-error .
      471       if error-status :error
      472       then do:
      473           undo, return error return-value .
      474       end.
      475       if p-code begins ('schd-free-id':U + chr(4))
      476       and entry(2, p-code, chr(4)) = '':U then do:
      477         find first buf_schedule-attr no-lock
      478             where buf_schedule-attr.cre-db-num = p-cre-db-num
      479               and buf_schedule-attr.task-type  = p-task-type
      480               and buf_schedule-attr.task-num   = p-task-num
      481               and buf_schedule-attr.attr-code  begins p-code
      482         no-error .
      483       end.
      484       else do:
      485         find first buf_schedule-attr no-lock
      486             where buf_schedule-attr.cre-db-num = p-cre-db-num
      487               and buf_schedule-attr.task-type  = p-task-type
      488               and buf_schedule-attr.task-num   = p-task-num
      489               and buf_schedule-attr.attr-code  = p-code
      490         no-error .
      491       end.
      492       if available buf_schedule-attr
      493       then do:
      494           assign
      495               p-value = buf_schedule-attr.attr-value
      496           .
      497       end.
      498       else do:
      499         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      500            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      501         end.
      502         else do:
      503           assign
      504               p-value = if p-type = 'L':U then "no":U else ""
      505           .
      506         end.
      507       end.
      508   end.
      509   end procedure.
      510   procedure schedule-attr-write :
      511   do
      512   on error undo, return error
      513   :
      514   define input parameter p-cre-db-num  as integer   no-undo.
      515   define input parameter p-task-type   as character no-undo.
      516   define input parameter p-task-num    as integer   no-undo.
      517   define input parameter p-code        as character no-undo.
      518   define input parameter p-value       as character no-undo.
      519       define variable v-type              as character                no-undo.
      520       define variable v-format            as character                no-undo.
      521       define variable v-label             as character                no-undo.
      522       define variable v-user-can-edit     as logical                  no-undo.
      523       define variable v-output-display    as logical                  no-undo.
      524       define variable v-other             as character                no-undo.
      525       define buffer buf_schedule-attr for ub.schedule-attr .
      526       run schedule-attr-name in this-procedure (
      527             input  p-code
      528           , output v-type
      529           , output v-format
      530           , output v-label
      531           , output v-user-can-edit
      532           , output v-output-display
      533           , output v-other
      534       ) no-error.
      535       if error-status :error
      536       then do:
      537           undo, return error return-value.
      538       end.
      539       find first buf_schedule-attr exclusive-lock
      540            where buf_schedule-attr.cre-db-num = p-cre-db-num
      541              and buf_schedule-attr.task-type  = p-task-type
      542              and buf_schedule-attr.task-num   = p-task-num
      543              and buf_schedule-attr.attr-code  = p-code
      544       no-error.
      545       if not available buf_schedule-attr
      546       then do:
      547           create buf_schedule-attr.
      548           assign
      549             buf_schedule-attr.cre-db-num = p-cre-db-num
      550             buf_schedule-attr.task-type  = p-task-type
      551             buf_schedule-attr.task-num   = p-task-num
      552             buf_schedule-attr.attr-code  = p-code
      553             buf_schedule-attr.attr-value = p-value
      554           .
      555       end.
      556       else do:
      557           assign
      558               buf_schedule-attr.attr-value = p-value
      559           .
      560       end.
      561   end.
      562   end procedure.
      563   procedure schedule-attr-delete :
      564   do
      565   on error undo, return error
      566   :
      567   define input  parameter p-cre-db-num  as integer   no-undo.
      568   define input  parameter p-task-type   as character no-undo.
      569   define input  parameter p-task-num    as integer   no-undo.
      570   define input  parameter p-code        as character no-undo.
      571   define output parameter p-deleted     as logical   no-undo.
      572       define buffer buf_schedule-attr for ub.schedule-attr .
      573       define variable v-type              as character                no-undo.
      574       define variable v-format            as character                no-undo.
      575       define variable v-label             as character                no-undo.
      576       define variable v-user-can-edit     as logical                  no-undo.
      577       define variable v-output-display    as logical                  no-undo.
      578       define variable v-other             as character                no-undo.
      579       run schedule-attr-name in this-procedure (
      580             input p-code
      581           , output v-type
      582           , output v-format
      583           , output v-label
      584           , output v-user-can-edit
      585           , output v-output-display
      586           , output v-other
      587       ) no-error .
      588       if error-status :error
      589       then do:
      590           undo, return error return-value .
      591       end.
      592       find first buf_schedule-attr exclusive-lock
      593            where buf_schedule-attr.cre-db-num = p-cre-db-num
      594              and buf_schedule-attr.task-type  = p-task-type
      595              and buf_schedule-attr.task-num   = p-task-num
      596              and buf_schedule-attr.attr-code  = p-code
      597       no-error.
      598       if not available buf_schedule-attr
      599       then do:
      600           assign
      601               p-deleted = no
      602           .
      603       end.
      604       else do:
      605           delete buf_schedule-attr.
      606           assign
      607               p-deleted = yes
      608           .
      609       end.
      610   end.
      611   end procedure.
      612   procedure schedule-attr-news :
      613   do
      614   on error undo, return error
      615   :
      616       define input  parameter p-code           as character no-undo .
      617       define output parameter p-news           as logical   no-undo .
      618       if index(p-code, chr(4)) > 0 then do:
      619         p-code = entry(1, p-code, chr(4)).
      620       end.
      621       case p-code :
      622               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      623               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      624               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      625               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      626               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      627               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      628               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      629               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      630               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      631         otherwise do:
      632           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      633         end.
      634       end.
      635   end.
      636   end procedure.
      637   procedure schedule-attr-extract-logical :
      638   do
      639   on error undo, return error
      640   :
      641   define input  parameter p-parameter-number   as integer      no-undo.
      642   define input  parameter p-parameter-list     as character    no-undo.
      643   define output parameter p-parameter-value   as logical      no-undo.
      644       if num-entries( p-parameter-list ) > p-parameter-number - 1
      645       then do:
      646           assign
      647               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      648           .
      649       end.
      650       else do:
      651           assign
      652               p-parameter-value   = no
      653           .
      654       end.
      655   end.
      656   end procedure.
      657   procedure schedule-attr-get-free-id :
      658   do
      659   on error undo, return error return-value
      660   :
      661     define input  parameter p-cre-db-num  as integer   no-undo.
      662     define input  parameter p-task-type   as character no-undo.
      663     define input  parameter p-task-num    as integer   no-undo.
      664     define output parameter p-free-id     as character no-undo.
      665     define buffer buf_schedule-attr for ub.schedule-attr.
      666     find first buf_schedule-attr no-lock
      667         where buf_schedule-attr.cre-db-num = p-cre-db-num
      668           and buf_schedule-attr.task-type  = p-task-type
      669           and buf_schedule-attr.task-num   = p-task-num
      670           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      671     no-error .
      672     if available buf_schedule-attr then
      673     assign
      674     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      675     no-error
      676     .
      677   end.
      678   end procedure.
      679   procedure schedule-attr-get-free-props :
      680     define input parameter p-free-id as character no-undo .
      681     define output parameter p-value as character no-undo .
      682     define buffer buf_temp-schedule-free for temp-schedule-free.
      683     do
      684     on error undo, return error return-value
      685     :
      686       find first buf_temp-schedule-free no-lock no-error .
      687       if not available buf_temp-schedule-free then do:
      688         run schedule-attr-fill-free-props in this-procedure .
      689       end.
      690       find first buf_temp-schedule-free where
      691               buf_temp-schedule-free.free-id = p-free-id no-error.
      692       if available buf_temp-schedule-free then do:
      693         assign
      694         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      695                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      696                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      697                   buf_temp-schedule-free.conf-param           + chr(4) +
      698                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      699                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      700                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      701                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      702                   buf_temp-schedule-free.other-info
      703         .
      704       end.
      705       else do:
      706        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      707                              "id произвольной задачи - &5"
      708                              ,vss-workfile
      709                              ,vss-revision
      710                              ,vss-description
      711                              ,chr(10)
      712                              ,p-free-id).
      713       end.
      714     end.
      715   end procedure.
      716   procedure schedule-attr-is-rum-free-id :
      717   define input parameter p-free-id as character no-undo .
      718   define output parameter p-is-rum as logical no-undo .
      719   define buffer buf_temp-schedule-free for temp-schedule-free.
      720   do
      721   on error undo, return error
      722   :
      723       find first buf_temp-schedule-free no-lock no-error .
      724       if not available buf_temp-schedule-free then do:
      725         run schedule-attr-fill-free-props in this-procedure .
      726       end.
      727       find first buf_temp-schedule-free where
      728               buf_temp-schedule-free.free-id = p-free-id no-error.
      729       if available buf_temp-schedule-free
      730       and buf_temp-schedule-free.is-rum
      731       then do:
      732         p-is-rum = yes.
      733       end.
      734   end.
      735   end procedure.
      736   procedure schedule-attr-fill-free-props :
      737   define variable v-path                    as character                no-undo .
      738   DEFINE VARIABLE v-full-path               as character                no-undo .
      739   DEFINE VARIABLE v-file-name               as character                no-undo .
      740   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      741   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      742   define buffer buf_temp-schedule-free for temp-schedule-free.
      743   define variable v-answer as logical no-undo .
      744     do
      745     on error undo, return error substitute("&1 &2 &3&4&5&4"
      746                                           ,vss-workfile
      747                                           ,vss-revision
      748                                           ,vss-description
      749                                           ,chr(10)
      750                                           ,error-status:get-message(1) )
      751     :
      752       run gbl/filename.p (
      753                       input 'cmp/shd-free.d'
      754                     ,output v-full-path
      755                     ,output v-path
      756                     ,output v-file-name
      757                     ,output v-file-name-no-ext
      758                     ,output v-file-name-ext
      759                     ) .
      760       input from value(v-full-path).
      761       repeat :
      762         create buf_temp-schedule-free.
      763         import buf_temp-schedule-free.
      764       END.
      765       input close.
      766       _ff:
      767       for each buf_temp-schedule-free :
      768         if buf_temp-schedule-free.free-id = '':U then do:
      769            delete buf_temp-schedule-free.
      770            next _ff.
      771          end.
      772          run schedule-attr-check-enc in this-procedure (
      773                                                       input  buf_temp-schedule-free.free-id
      774                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      775                                                               buf_temp-schedule-free.proc-param-edit-name +
      776                                                               buf_temp-schedule-free.conf-param +
      777                                                               string(buf_temp-schedule-free.is-gbd) +
      778                                                               string(buf_temp-schedule-free.is-ubd) +
      779                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      780                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      781                                                               string(buf_temp-schedule-free.other-info)
      782                                                               )
      783                                                       ,input  buf_temp-schedule-free.enc-key
      784                                                       ,output v-answer    ) no-error .
      785          if error-status:error
      786          or not v-answer then delete buf_temp-schedule-free.
      787        end.
      788     end.
      789   end procedure.
      790   Function schedule-attr-reverse returns character (str as character).
      791      define variable rev_incl_s as character init "" no-undo .
      792      define variable rev_incl_i as integer no-undo .
      793      define variable rev_incl_l as integer no-undo .
      794      rev_incl_l = length(str).
      795      do rev_incl_i = 1 to rev_incl_l:
      796         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      797      end.
      798      return rev_incl_s.
      799   end.
      800   procedure schedule-attr-check-enc.
      801     define input  parameter p-free-id   as character no-undo .
      802     define input  parameter p-value     as character no-undo .
      803     define input  parameter p-enc-value as character no-undo .
      804     define output parameter p-answer    as logical   no-undo .
      805     define variable tmp         as character no-undo .
      806     define variable v-enc-value as character no-undo .
      807     assign
      808     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      809     .
      810     run schedule-attr-pswd-enc in this-procedure
      811       ( input tmp
      812        ,output v-enc-value
      813       ) no-error .
      814     if error-status:error then do:
      815       message
      816         vss-workfile vss-revision vss-description skip
      817         "Ошибка при вызове процедуры pswd-enc" skip
      818         return-value skip
      819         error-status :get-message(1) skip
      820         view-as alert-box error .
      821       undo, return error .
      822     end.
      823     if v-enc-value = p-enc-value then do:
      824       assign
      825         p-answer = true
      826       .
      827     end.
      828     else do:
      829       assign
      830         p-answer = false
      831       .
      832     end.
      833   end.
      834   procedure schedule-attr-conf-enc.
      835     define input  parameter p-free-id   as character no-undo .
      836     define input  parameter p-value     as character no-undo .
      837     define output parameter p-enc-value as character no-undo .
      838     define variable tmp         as character no-undo .
      839     assign
      840       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      841     .
      842     run schedule-attr-pswd-enc in this-procedure
      843       ( input tmp
      844        ,output p-enc-value
      845       ) no-error .
      846     if error-status:error then do:
      847       message
      848         vss-workfile vss-revision vss-description skip
      849         "Ошибка при вызове процедуры pswd-enc" skip
      850         return-value skip
      851         error-status :get-message(1) skip
      852         view-as alert-box error .
      853       undo, return error .
      854     end.
      855   end procedure.
      856   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      857   procedure schedule-attr-pswd-enc :
      858     define input parameter  pswd     as character no-undo .
      859     define output parameter enc-pswd as character no-undo .
      860     do
      861     on error undo, return error return-value
      862     :
      863       assign
      864         enc-pswd = encode(pswd + string(index(pswd, "k")))
      865       .
      866     end.
      867   end procedure.
      868   define variable v-free-id as character no-undo .
      869   define variable v-value as character no-undo .
      870   define variable v-type as character no-undo .
      871   define variable v-cntxt-db-num like ub.db.db-num no-undo.
      872   define variable v-proc-name as character no-undo .
      873   define variable v-is-rum as logical no-undo .
      874   define variable v-cancel as logical no-undo .
      875   define buffer buf_temp-schedule-free for temp-schedule-free .
      876   DEFINE BUTTON B-Help
      877        LABEL "Помо&щь"
      878        SIZE 3 BY 1
      879        BGCOLOR 8 .
      880   DEFINE BUTTON b-quit AUTO-END-KEY
      881        LABEL "&Выход"
      882        SIZE 10 BY 1
      883        BGCOLOR 8 .
      884   DEFINE BUTTON B-sel AUTO-GO
      885        LABEL "&Выбор"
      886        SIZE 10 BY 1.
      887   DEFINE QUERY BR-free-tasks FOR
      888         buf_temp-schedule-free SCROLLING.
      889   DEFINE BROWSE BR-free-tasks
      890     QUERY BR-free-tasks DISPLAY
      891         buf_temp-schedule-free.free-task-name COLUMN-LABEL "Название задачи" FORMAT "X(255)" WIDTH 30
      892   buf_temp-schedule-free.proc-run-name  COLUMN-LABEL "Исполняющая!процедура" FORMAT "X(14)"
      893   buf_temp-schedule-free.proc-param-edit-name COLUMN-LABEL "Процедура!редактирования!параметров" FORMAT "X(14)"
      894   buf_temp-schedule-free.conf-param COLUMN-LABEL  "Кодир.!конфиг.!пар-тр" FORMAT "X(8)"
      895   buf_temp-schedule-free.is-gbd COLUMN-LABEL  "Возможность!запуска!в ГБД" FORMAT "да/нет"
      896   buf_temp-schedule-free.is-ubd COLUMN-LABEL "Возможность!запуска!в УБД" FORMAT "да/нет"
      897   buf_temp-schedule-free.enable-concurrent-0 COLUMN-LABEL  "Возможность!одноврем.!запуска" FORMAT "да/нет"
      898   buf_temp-schedule-free.enable-concurrent-db COLUMN-LABEL "Возможность!одноврем.!запуска!в одной БД" FORMAT "да/нет"
      899   buf_temp-schedule-free.free-id COLUMN-LABEL "ID задачи" FORMAT "X(100)" WIDTH 11
      900       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.5 FIT-LAST-COLUMN.
      901   DEFINE FRAME Dialog-Frame
      902        b-quit AT ROW 1 COL 1
      903        B-sel AT ROW 1 COL 11
      904        B-Help AT ROW 1 COL 95
      905        BR-free-tasks AT ROW 3 COL 1
      906        SPACE(0.49) SKIP(0.91)
      907       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      908            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      909            TITLE ""
      910            CANCEL-BUTTON b-quit.
      911   ASSIGN
      912          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      913          FRAME Dialog-Frame:HIDDEN           = TRUE.
      914   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      915   DO:
      916     APPLY "END-ERROR":U TO SELF.
      917   END.
      918   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      919   DO:
      920     p-cancel = YES.
      921   END.
      922   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
      923   DO:
      924     IF NOT AVAILABLE buf_temp-schedule-free THEN RETURN NO-APPLY.
      925     if available buf_temp-schedule-free then do:
      926       assign
      927       v-free-id = buf_temp-schedule-free.free-id
      928       p-free-id = v-free-id
      929       .
      930     end.
      931   END.
      932   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      933   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      934   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      935   on help of frame Dialog-Frame
      936   do:
      937     run gbl/app_help.p
      938       (input this-procedure :file-name
      939       ,input ''
      940       ,input ?
      941       ) no-error.
      942     if error-status :error then do:
      943       message
      944         "Ошибка при вызове помощи"
      945         error-status :get-message(1)
      946         view-as alert-box .
      947     end.
      948   end.
      949   run minbtn-set in this-procedure .
      950   on choose of b-help in frame Dialog-Frame
      951   do:
      952     apply "help":u to frame Dialog-Frame .
      953   end.
      954   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      955   procedure minbtn-set :
      956       do
      957           on error undo, return error return-value
      958           :
      959           define variable ii              as integer       no-undo .
      960           define variable fh              as widget-handle no-undo .
      961           define variable hh              as widget-handle no-undo .
      962           define variable v-h             as handle        extent 4 no-undo .
      963           define variable v-name-button   as character     no-undo .
      964           define variable v-help-old-x    as decimal       no-undo .
      965           define variable v-help-old-y    as decimal       no-undo .
      966           define variable v-help-old-size as decimal       no-undo .
      967           define variable v-frame-width   as decimal       no-undo .
      968           define variable jj              as integer       no-undo .
      969           do
      970               on error undo, return error
      971               :
      972               assign
      973                   v-frame-width = frame Dialog-Frame:width - 0.3
      974                   fh            = frame Dialog-Frame:first-child
      975                   hh            = fh:first-child
      976                   ii            = 1
      977                   .
      978               do while valid-handle(hh):
      979                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      980                   do:
      981                       case lc(hh:name) :
      982                           when "b-help" then
      983                               do:
      984                                   hh:load-image-up("cmp/b-help.bmp":u) .
      985                                   hh:load-image-down("cmp/b-help.bmp":u) .
      986                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      987                                   hh:TOOLTIP = "Помощь" .
      988                                   v-help-old-x = hh:column .
      989                                   v-help-old-y = hh:row    .
      990                                   v-help-old-size = hh:width .
      991                                   hh:width-chars = 2.5 .
      992                               end.
      993                           when "b-print" then
      994                               do:
      995                                   hh:load-image("cmp/b-print.bmp":u) .
      996                                   hh:TOOLTIP = "Печать" .
      997                                   v-h[ii] = hh:handle .
      998                                   ii = ii + 1 .
      999                                   hh:width-chars = 3 .
     1000                               end.
     1001                           when "b-history" or
     1002                           when "b-hist" then
     1003                               do:
     1004                                   hh:load-image("cmp/b-hist.bmp":u) .
     1005                                   hh:TOOLTIP = "История" .
     1006                                   v-h[ii] = hh:handle .
     1007                                   ii = ii + 1 .
     1008                                   hh:width-chars = 3 .
     1009                               end.
     1010                           when "b-sch" then
     1011                               do:
     1012                                   hh:load-image("cmp/b-sch.bmp":u) .
     1013                                   hh:TOOLTIP = "Установка Фильтра" .
     1014                                   v-h[ii] = hh:handle .
     1015                                   ii = ii + 1 .
     1016                                   hh:width-chars = 3 .
     1017                               end.
     1018                           when "b-hist-user" then
     1019                               do:
     1020                                   hh:load-image("cmp/b-hist.bmp":u) .
     1021                                   hh:TOOLTIP = "История пользователя" .
     1022                                   ii = ii + 1 .
     1023                               end.
     1024                       end case.
     1025                   end.
     1026                   hh = hh:next-sibling.
     1027               end.
     1028               b-help:column = v-frame-width - b-help:width-chars.
     1029               jj = 0.
     1030               repeat ii = 4 to 1 by -1 :
     1031                   if valid-handle (v-h[ii] ) then
     1032                   do:
     1033                       jj  = jj + 1 .
     1034                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1035                       v-h[ii]:row    = v-help-old-y .
     1036                   end.
     1037               end.
     1038           end.
     1039       end.
     1040   end procedure.
     1041   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1042   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1043   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1044   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1045   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1046   define variable v-diasize-current-frame-height as decimal   no-undo .
     1047   define variable v-diasize-change-size          as logical   no-undo .
     1048   define variable v-diasize-resize-button        as handle    no-undo .
     1049   define variable v-diasize-wndmax               as logical   no-undo .
     1050   define variable v-diasize-wndstore             as logical   no-undo .
     1051   define variable v-diasize-proc-name            as character no-undo .
     1052   define variable v-diasize-browse-handle        as handle    no-undo .
     1053   define variable v-diasize-browse-number        as integer   no-undo .
     1054   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1055   define temp-table temp-diasize-handle no-undo
     1056     field handle-value  as handle
     1057     field save-position as decimal
     1058     index xpk is primary unique handle-value
     1059     .
     1060   define temp-table temp-browse-handle no-undo
     1061     field browse-type   as character
     1062     field browse-number as integer
     1063     field browse-handle as handle
     1064     field original-size as decimal
     1065     index xpk is primary unique browse-type browse-number
     1066     index xie browse-type browse-handle
     1067   .
     1068   procedure diasize_change-height :
     1069     define input  parameter p-change-value  as decimal   no-undo .
     1070     define input  parameter p-move-resize   as logical   no-undo .
     1071     define variable v-field-group-handle    as handle    no-undo .
     1072     define variable v-object-handle         as handle    no-undo .
     1073     define variable v-frame-height          as decimal   no-undo .
     1074     define variable v-frame-virtual-height  as decimal   no-undo .
     1075     define variable v-browse-height         as decimal   no-undo .
     1076     define variable v-window-height         as decimal   no-undo .
     1077     define variable v-window-virtual-height as decimal   no-undo .
     1078     define variable v-change-sign           as integer   no-undo .
     1079     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1080     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1081     if p-change-value > 0
     1082     then do:
     1083       if frame Dialog-Frame :height + p-change-value
     1084           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1085       then do:
     1086         assign
     1087           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1088                           - (frame Dialog-Frame :height-chars)
     1089         .
     1090         if p-change-value <= 0
     1091         then do:
     1092           run diasize_position-resize-button in this-procedure .
     1093           return .
     1094         end.
     1095       end.
     1096     end.
     1097     if p-change-value < 0
     1098     then do:
     1099       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1100       then do:
     1101         assign
     1102           p-change-value = v-diasize-orig-frame-height
     1103                          - (frame Dialog-Frame :height-chars)
     1104         .
     1105         if p-change-value >= 0
     1106         then do:
     1107           run diasize_position-resize-button in this-procedure .
     1108           return .
     1109         end.
     1110       end.
     1111     end.
     1112     if p-change-value >= 0
     1113     then do:
     1114       assign
     1115         v-change-sign = 1
     1116       .
     1117     end.
     1118     else do:
     1119       assign
     1120         v-change-sign = -1
     1121       .
     1122     end.
     1123     assign
     1124       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1125     .
     1126     if p-change-value = 0
     1127     then do:
     1128       run diasize_position-resize-button in this-procedure .
     1129       return .
     1130     end.
     1131     move_block:
     1132     do
     1133     on error undo move_block, retry move_block
     1134     :
     1135       if retry
     1136       then do:
     1137         do
     1138         on error undo move_block, leave move_block
     1139         :
     1140           if p-change-value > 0
     1141           then do:
     1142             for each buf_temp-diasize-handle
     1143             on error undo, next
     1144             :
     1145               assign
     1146                 v-object-handle = buf_temp-diasize-handle.handle-value
     1147               .
     1148               if v-object-handle <> v-diasize-resize-button
     1149               then do:
     1150                 assign
     1151                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1152                 .
     1153               end.
     1154             end.
     1155             assign
     1156               v-diasize-browse-handle :height = v-browse-height
     1157             .
     1158             for each buf_temp-browse-handle
     1159               where buf_temp-browse-handle.browse-type = 'height':u
     1160             on error undo, next
     1161             :
     1162               assign
     1163                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1164               .
     1165             end.
     1166             assign
     1167               frame Dialog-Frame :height = v-frame-height
     1168             .
     1169             if frame Dialog-Frame :scrollable = true
     1170             then do:
     1171               assign
     1172                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1173               .
     1174             end.
     1175             run diasize_position-resize-button in this-procedure .
     1176           end.
     1177           else do:
     1178             if frame Dialog-Frame :scrollable = true
     1179             then do:
     1180               assign
     1181                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1182               .
     1183             end.
     1184             assign
     1185               frame Dialog-Frame :height = v-frame-height
     1186             .
     1187             assign
     1188               v-diasize-browse-handle :height = v-browse-height
     1189             .
     1190             for each buf_temp-browse-handle
     1191               where buf_temp-browse-handle.browse-type = 'height':u
     1192             on error undo, next
     1193             :
     1194               assign
     1195                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1196               .
     1197             end.
     1198             for each buf_temp-diasize-handle
     1199             on error undo, next
     1200             :
     1201               assign
     1202                 v-object-handle = buf_temp-diasize-handle.handle-value
     1203               .
     1204               if v-object-handle <> v-diasize-resize-button
     1205               then do:
     1206                 assign
     1207                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1208                 .
     1209               end.
     1210             end.
     1211             run diasize_position-resize-button in this-procedure .
     1212           end.
     1213           assign
     1214             v-diasize-change-size = false
     1215           .
     1216           leave move_block .
     1217         end.
     1218       end.
     1219       assign
     1220         v-diasize-need-full-display = true
     1221       .
     1222       if v-diasize-change-size = false
     1223       then do:
     1224         assign
     1225           v-diasize-change-size = true
     1226         .
     1227       end.
     1228       else do:
     1229         return .
     1230       end.
     1231       assign
     1232         v-frame-height = frame Dialog-Frame :height
     1233         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1234         v-browse-height = v-diasize-browse-handle :height
     1235       .
     1236       for each buf_temp-browse-handle
     1237         where buf_temp-browse-handle.browse-type = 'height':u
     1238       :
     1239         assign
     1240           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1241         .
     1242       end.
     1243       for each buf_temp-diasize-handle
     1244       :
     1245         delete buf_temp-diasize-handle .
     1246       end.
     1247       assign
     1248         v-field-group-handle = frame Dialog-Frame :first-child
     1249       .
     1250       do while valid-handle(v-field-group-handle)
     1251       :
     1252         assign
     1253           v-object-handle = v-field-group-handle :first-child
     1254         .
     1255         do while valid-handle(v-object-handle)
     1256         :
     1257           if  v-object-handle <> v-diasize-browse-handle :handle
     1258           and can-query(v-object-handle, "row")
     1259           and can-query(v-object-handle, "height")
     1260           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1261           then do:
     1262             find first buf_temp-browse-handle
     1263               where buf_temp-browse-handle.browse-type   = 'height':u
     1264                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1265               no-error .
     1266             if available buf_temp-browse-handle
     1267             then do:
     1268             end.
     1269             else do:
     1270               create buf_temp-diasize-handle .
     1271               assign
     1272                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1273                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1274               .
     1275             end.
     1276           end.
     1277           assign
     1278             v-object-handle = v-object-handle :next-sibling
     1279           .
     1280         end.
     1281         assign
     1282           v-field-group-handle = v-field-group-handle :next-sibling
     1283         .
     1284       end.
     1285       do with frame Dialog-Frame
     1286       :
     1287         hide v-diasize-resize-button .
     1288         assign
     1289           v-diasize-resize-button :row    = 1
     1290           v-diasize-resize-button :column = 1
     1291         .
     1292       end.
     1293       if p-change-value > 0
     1294       then do:
     1295         if frame Dialog-Frame :scrollable = true
     1296         then do:
     1297           assign
     1298             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1299             no-error .
     1300           if error-status :error
     1301           or error-status :get-message(1) <> ""
     1302           then do:
     1303             undo move_block, retry move_block .
     1304           end.
     1305         end.
     1306         assign
     1307           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1308           no-error .
     1309         if error-status :error
     1310         or error-status :get-message(1) <> ""
     1311         then do:
     1312           undo move_block, retry move_block .
     1313         end.
     1314         assign
     1315           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1316           no-error .
     1317         if error-status :error
     1318         or error-status :get-message(1) <> ""
     1319         then do:
     1320           undo move_block, retry move_block .
     1321         end.
     1322         for each buf_temp-browse-handle
     1323           where buf_temp-browse-handle.browse-type = 'height':u
     1324         on error undo move_block, retry move_block
     1325         :
     1326           assign
     1327             buf_temp-browse-handle.browse-handle :height
     1328               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1329             no-error .
     1330           if error-status :error
     1331           or error-status :get-message(1) <> ""
     1332           then do:
     1333             undo move_block, retry move_block .
     1334           end.
     1335         end.
     1336         for each buf_temp-diasize-handle
     1337         on error undo move_block, retry move_block
     1338         :
     1339           assign
     1340             v-object-handle = buf_temp-diasize-handle.handle-value
     1341           .
     1342           if v-object-handle <> v-diasize-resize-button
     1343           then do:
     1344             assign
     1345               v-object-handle :row = v-object-handle :row + p-change-value
     1346               no-error .
     1347             if error-status :error
     1348             or error-status :get-message(1) <> ""
     1349             then do:
     1350               undo move_block, retry move_block .
     1351             end.
     1352           end.
     1353         end.
     1354       end.
     1355       else do:
     1356         for each buf_temp-diasize-handle
     1357         on error undo move_block, retry move_block
     1358         :
     1359           assign
     1360             v-object-handle = buf_temp-diasize-handle.handle-value
     1361           .
     1362           if v-object-handle <> v-diasize-resize-button
     1363           then do:
     1364             assign
     1365               v-object-handle :row = v-object-handle :row + p-change-value
     1366               no-error .
     1367             if error-status :error
     1368             or error-status :get-message(1) <> ""
     1369             then do:
     1370               undo move_block, retry move_block .
     1371             end.
     1372           end.
     1373         end.
     1374         assign
     1375           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1376           no-error .
     1377         if error-status :error
     1378         or error-status :get-message(1) <> ""
     1379         then do:
     1380           undo move_block, retry move_block .
     1381         end.
     1382         for each buf_temp-browse-handle
     1383           where buf_temp-browse-handle.browse-type = 'height':u
     1384         on error undo move_block, retry move_block
     1385         :
     1386           assign
     1387             buf_temp-browse-handle.browse-handle :height
     1388               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1389             no-error .
     1390           if error-status :error
     1391           or error-status :get-message(1) <> ""
     1392           then do:
     1393             undo move_block, retry move_block .
     1394           end.
     1395         end.
     1396         assign
     1397           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1398           no-error .
     1399         if error-status :error
     1400         or error-status :get-message(1) <> ""
     1401         then do:
     1402           undo move_block, retry move_block .
     1403         end.
     1404         if frame Dialog-Frame :scrollable = true
     1405         then do:
     1406           assign
     1407             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1408             no-error .
     1409           if error-status :error
     1410           or error-status :get-message(1) <> ""
     1411           then do:
     1412             undo move_block, retry move_block .
     1413           end.
     1414         end.
     1415       end.
     1416       if p-move-resize = true
     1417       then do:
     1418         run diasize_position-resize-button in this-procedure .
     1419       end.
     1420       if v-diasize-wndstore = true
     1421       then do:
     1422         if connected("ub") = true
     1423         then do:
     1424           define variable v-cntxt-db-num        as integer   no-undo .
     1425           define variable v-cntxt-userid        as character no-undo .
     1426           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1427                                             , OUTPUT v-cntxt-userid
     1428                                             ) .
     1429           run gbl/wndsizew.p
     1430             (input  v-cntxt-db-num
     1431             ,input  v-cntxt-userid
     1432             ,input  v-diasize-proc-name
     1433             ,input  'height':u
     1434             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1435             ) .
     1436         end.
     1437       end.
     1438     end.
     1439     assign
     1440       v-diasize-change-size = false
     1441     .
     1442   end procedure.
     1443   procedure diasize_set-height :
     1444     define input  parameter p-new-height  as decimal   no-undo .
     1445     define input  parameter p-move-resize as logical   no-undo .
     1446     do
     1447     on error undo, return error return-value
     1448     :
     1449       run diasize_change-height in this-procedure
     1450         (input  (p-new-height - frame Dialog-Frame :height)
     1451         ,input  p-move-resize
     1452         ) .
     1453     end.
     1454   end procedure.
     1455   procedure diasize_change-width :
     1456     define input  parameter p-change-value as decimal   no-undo .
     1457     define input  parameter p-move-resize  as logical   no-undo .
     1458     define variable v-field-group-handle   as handle    no-undo .
     1459     define variable v-object-handle        as handle    no-undo .
     1460     define variable v-frame-width          as decimal   no-undo .
     1461     define variable v-frame-virtual-width  as decimal   no-undo .
     1462     define variable v-browse-width         as decimal   no-undo .
     1463     define variable v-window-width         as decimal   no-undo .
     1464     define variable v-window-virtual-width as decimal   no-undo .
     1465     define variable v-change-sign          as integer   no-undo .
     1466     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1467     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1468     if p-change-value > 0
     1469     then do:
     1470       if frame Dialog-Frame :width + p-change-value >
     1471           session :width-chars
     1472       then do:
     1473         assign
     1474           p-change-value = session :width-chars - frame Dialog-Frame :width
     1475         .
     1476         if p-change-value <= 0
     1477         then do:
     1478           run diasize_position-resize-button in this-procedure .
     1479           return .
     1480         end.
     1481       end.
     1482     end.
     1483     if p-change-value < 0
     1484     then do:
     1485       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1486       then do:
     1487         assign
     1488           p-change-value = v-diasize-orig-frame-width
     1489                          - frame Dialog-Frame :width
     1490         .
     1491         if p-change-value >= 0
     1492         then do:
     1493           run diasize_position-resize-button in this-procedure .
     1494           return .
     1495         end.
     1496       end.
     1497     end.
     1498     if p-change-value >= 0
     1499     then do:
     1500       assign
     1501         v-change-sign = 1
     1502       .
     1503     end.
     1504     else do:
     1505       assign
     1506         v-change-sign = -1
     1507       .
     1508     end.
     1509     assign
     1510       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1511     .
     1512     if p-change-value = 0
     1513     then do:
     1514       run diasize_position-resize-button in this-procedure .
     1515       return .
     1516     end.
     1517     move_block:
     1518     do
     1519     on error undo move_block, leave move_block
     1520     :
     1521       if retry
     1522       then do:
     1523         do
     1524         on error undo move_block, leave move_block
     1525         :
     1526           if p-change-value > 0
     1527           then do:
     1528             for each buf_temp-diasize-handle
     1529             on error undo, next
     1530             :
     1531               assign
     1532                 v-object-handle = buf_temp-diasize-handle.handle-value
     1533               .
     1534               if v-object-handle <> v-diasize-resize-button
     1535               then do:
     1536                 assign
     1537                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1538                 .
     1539               end.
     1540             end.
     1541             assign
     1542               v-diasize-browse-handle :width = v-browse-width
     1543             .
     1544             for each buf_temp-browse-handle
     1545               where buf_temp-browse-handle.browse-type = 'width':u
     1546             on error undo, next
     1547             :
     1548               assign
     1549                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1550               .
     1551             end.
     1552             assign
     1553               frame Dialog-Frame :width = v-frame-width
     1554             .
     1555             if frame Dialog-Frame :scrollable = true
     1556             then do:
     1557               assign
     1558                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1559               .
     1560             end.
     1561             run diasize_position-resize-button in this-procedure .
     1562           end.
     1563           else do:
     1564             if frame Dialog-Frame :scrollable = true
     1565             then do:
     1566               assign
     1567                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1568               .
     1569             end.
     1570             assign
     1571               frame Dialog-Frame :width = v-frame-width
     1572             .
     1573             for each buf_temp-browse-handle
     1574               where buf_temp-browse-handle.browse-type = 'width':u
     1575             on error undo, next
     1576             :
     1577               assign
     1578                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1579               .
     1580             end.
     1581             assign
     1582               v-diasize-browse-handle :width = v-browse-width
     1583             .
     1584             for each buf_temp-diasize-handle
     1585             on error undo, next
     1586             :
     1587               assign
     1588                 v-object-handle = buf_temp-diasize-handle.handle-value
     1589               .
     1590               if v-object-handle <> v-diasize-resize-button
     1591               then do:
     1592                 assign
     1593                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1594                 .
     1595               end.
     1596             end.
     1597             run diasize_position-resize-button in this-procedure .
     1598           end.
     1599           assign
     1600             v-diasize-change-size = false
     1601           .
     1602           leave move_block .
     1603         end.
     1604       end.
     1605       assign
     1606         v-diasize-need-full-display = true
     1607       .
     1608       if v-diasize-change-size = false
     1609       then do:
     1610         assign
     1611           v-diasize-change-size = true
     1612         .
     1613       end.
     1614       else do:
     1615         return .
     1616       end.
     1617       assign
     1618         v-frame-width = frame Dialog-Frame :width
     1619         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1620         v-browse-width = v-diasize-browse-handle :width
     1621       .
     1622       for each buf_temp-browse-handle
     1623         where buf_temp-browse-handle.browse-type = 'width':u
     1624       :
     1625         assign
     1626           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1627         .
     1628       end.
     1629       for each buf_temp-diasize-handle
     1630       :
     1631         delete buf_temp-diasize-handle .
     1632       end.
     1633       assign
     1634         v-field-group-handle = frame Dialog-Frame :first-child
     1635       .
     1636       do while valid-handle(v-field-group-handle)
     1637       :
     1638         assign
     1639           v-object-handle = v-field-group-handle :first-child
     1640         .
     1641         do while valid-handle(v-object-handle)
     1642         :
     1643           if  v-object-handle <> v-diasize-browse-handle :handle
     1644           and v-object-handle <> v-diasize-resize-button
     1645           and can-query(v-object-handle, "row")
     1646           and can-query(v-object-handle, "height")
     1647           and ( v-object-handle :col + v-object-handle :width
     1648                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1649               )
     1650           then do:
     1651             find first buf_temp-browse-handle
     1652               where buf_temp-browse-handle.browse-type   = 'width':u
     1653                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1654               no-error .
     1655             if available buf_temp-browse-handle
     1656             then do:
     1657             end.
     1658             else do:
     1659               create buf_temp-diasize-handle .
     1660               assign
     1661                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1662                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1663               .
     1664             end.
     1665           end.
     1666           assign
     1667             v-object-handle = v-object-handle :next-sibling
     1668           .
     1669         end.
     1670         assign
     1671           v-field-group-handle = v-field-group-handle :next-sibling
     1672         .
     1673       end.
     1674       do with frame Dialog-Frame
     1675       :
     1676         hide v-diasize-resize-button .
     1677         v-diasize-resize-button :row = 1.
     1678         v-diasize-resize-button :column = 1.
     1679       end.
     1680       if p-change-value > 0
     1681       then do:
     1682         if frame Dialog-Frame :scrollable = true
     1683         then do:
     1684           assign
     1685             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1686             no-error .
     1687           if error-status :error
     1688           or error-status :get-message(1) <> ""
     1689           then do:
     1690             undo move_block, retry move_block.
     1691           end.
     1692         end.
     1693         assign
     1694           frame Dialog-Frame :width = v-frame-width + p-change-value
     1695           no-error .
     1696         if error-status :error
     1697         or error-status :get-message(1) <> ""
     1698         then do:
     1699           undo move_block, retry move_block.
     1700         end.
     1701         assign
     1702           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1703         no-error .
     1704         if error-status :error
     1705         or error-status :get-message(1) <> ""
     1706         then do:
     1707           undo move_block, retry move_block.
     1708         end.
     1709         for each buf_temp-browse-handle
     1710           where buf_temp-browse-handle.browse-type = 'width':u
     1711         on error undo move_block, retry move_block
     1712         :
     1713           assign
     1714             buf_temp-browse-handle.browse-handle :width
     1715               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1716             no-error .
     1717           if error-status :error
     1718           or error-status :get-message(1) <> ""
     1719           then do:
     1720             undo move_block, retry move_block .
     1721           end.
     1722         end.
     1723         for each buf_temp-diasize-handle
     1724         on error undo move_block, retry move_block
     1725         :
     1726           assign
     1727             v-object-handle = buf_temp-diasize-handle.handle-value
     1728           .
     1729           if v-object-handle <> v-diasize-resize-button
     1730           then do:
     1731             assign
     1732               v-object-handle :col = v-object-handle :col + p-change-value
     1733               no-error .
     1734             if error-status :error
     1735             or error-status :get-message(1) <> ""
     1736             then do:
     1737               undo move_block, retry move_block .
     1738             end.
     1739           end.
     1740         end.
     1741       end.
     1742       else do:
     1743         for each buf_temp-diasize-handle
     1744         on error undo move_block, retry move_block
     1745         :
     1746           assign
     1747             v-object-handle = buf_temp-diasize-handle.handle-value
     1748           .
     1749           if v-object-handle <> v-diasize-resize-button
     1750           then do:
     1751             assign
     1752               v-object-handle :col = v-object-handle :col + p-change-value
     1753               no-error .
     1754             if error-status :error
     1755             or error-status :get-message(1) <> ""
     1756             then do:
     1757               undo move_block, retry move_block .
     1758             end.
     1759           end.
     1760         end.
     1761         for each buf_temp-browse-handle
     1762           where buf_temp-browse-handle.browse-type = 'width':u
     1763         on error undo move_block, retry move_block
     1764         :
     1765           assign
     1766             buf_temp-browse-handle.browse-handle :width
     1767               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1768             no-error .
     1769           if error-status :error
     1770           or error-status :get-message(1) <> ""
     1771           then do:
     1772             undo move_block, retry move_block .
     1773           end.
     1774         end.
     1775         assign
     1776           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1777           no-error .
     1778         if error-status :error
     1779         or error-status :get-message(1) <> ""
     1780         then do:
     1781           undo move_block, retry move_block.
     1782         end.
     1783         assign
     1784           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1785         no-error .
     1786         if error-status :error
     1787         or error-status :get-message(1) <> ""
     1788         then do:
     1789           undo move_block, retry move_block.
     1790         end.
     1791         if frame Dialog-Frame :scrollable = true
     1792         then do:
     1793           assign
     1794             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1795           no-error .
     1796           if error-status :error
     1797           or error-status :get-message(1) <> ""
     1798           then do:
     1799             undo move_block, retry move_block.
     1800           end.
     1801         end.
     1802       end.
     1803       if p-move-resize
     1804       then do:
     1805         run diasize_position-resize-button in this-procedure .
     1806       end.
     1807       if v-diasize-wndstore = true
     1808       then do:
     1809         if connected("ub") = true
     1810         then do:
     1811           define variable v-cntxt-db-num        as integer   no-undo .
     1812           define variable v-cntxt-userid        as character no-undo .
     1813           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1814                                             , OUTPUT v-cntxt-userid
     1815                                             ) .
     1816           run gbl/wndsizew.p
     1817             (input  v-cntxt-db-num
     1818             ,input  v-cntxt-userid
     1819             ,input  v-diasize-proc-name
     1820             ,input  'width':u
     1821             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1822             ) .
     1823         end.
     1824       end.
     1825     end.
     1826     assign
     1827       v-diasize-change-size = false
     1828     .
     1829   end procedure.
     1830   procedure diasize_set-width :
     1831     define input  parameter p-new-width  as decimal   no-undo .
     1832     define input  parameter p-move-resize as logical   no-undo .
     1833     do
     1834     on error undo, return error return-value
     1835     :
     1836       run diasize_change-width in this-procedure
     1837         (input  (p-new-width - frame Dialog-Frame :width)
     1838         ,input  p-move-resize
     1839         ) .
     1840     end.
     1841   end procedure.
     1842   procedure diasize_position-resize-button :
     1843     do with frame Dialog-Frame
     1844     :
     1845       hide v-diasize-resize-button .
     1846       assign
     1847         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1848                     - 1
     1849                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1850         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1851                     - 1
     1852                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1853       .
     1854       view v-diasize-resize-button .
     1855     end.
     1856   end procedure.
     1857   on alt-right anywhere
     1858   do:
     1859     run diasize_change-width in this-procedure
     1860       (input 1
     1861       ,input true
     1862       ) .
     1863     return no-apply .
     1864   end.
     1865   on alt-left anywhere
     1866   do:
     1867     run diasize_change-width in this-procedure
     1868       (input -1
     1869       ,input true
     1870       ) .
     1871     return no-apply .
     1872   end.
     1873   on alt-down anywhere
     1874   do:
     1875     run diasize_change-height in this-procedure
     1876       (input 1
     1877       ,input true
     1878       ) .
     1879     return no-apply .
     1880   end.
     1881   on alt-up anywhere
     1882   do:
     1883     run diasize_change-height in this-procedure
     1884       (input -1
     1885       ,input true
     1886       ) .
     1887     return no-apply .
     1888   end.
     1889   on alt-enter of frame Dialog-Frame
     1890   do:
     1891     run diasize_maximize in this-procedure
     1892       (input  ?
     1893       ).
     1894     return no-apply .
     1895   end.
     1896   procedure diasize_end-move :
     1897     do
     1898     on error undo, return error return-value
     1899     :
     1900       define variable v-row-delta as decimal   no-undo .
     1901       define variable v-col-delta as decimal   no-undo .
     1902       define variable v-new-row as decimal   no-undo .
     1903       define variable v-new-col as decimal   no-undo .
     1904       assign
     1905         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1906         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1907       .
     1908       assign
     1909         v-row-delta = v-new-row - frame Dialog-Frame :height
     1910         v-col-delta = v-new-col - frame Dialog-Frame :width
     1911       .
     1912       run diasize_change-height in this-procedure
     1913         (input v-row-delta
     1914         ,input true
     1915         ) .
     1916       run diasize_change-width in this-procedure
     1917         (input v-col-delta
     1918         ,input true
     1919         ) .
     1920     end.
     1921   end procedure.
     1922   procedure diasize_maximize :
     1923     define input  parameter p-action as logical   no-undo .
     1924     do
     1925     on error undo, return error return-value
     1926     :
     1927       if p-action = ?
     1928       then do:
     1929         if v-diasize-need-maximize = true
     1930         then do:
     1931           assign
     1932             p-action = true
     1933           .
     1934         end.
     1935         else do:
     1936           assign
     1937             p-action = false
     1938           .
     1939         end.
     1940       end.
     1941       if p-action = true
     1942       then do:
     1943         run diasize_change-height in this-procedure
     1944           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1945               - frame Dialog-Frame :height-chars
     1946           ,input true
     1947           ) .
     1948         run diasize_change-width in this-procedure
     1949           (input session :width-chars
     1950               - frame Dialog-Frame :width-chars
     1951           ,input true
     1952           ) .
     1953         assign
     1954           v-diasize-need-maximize = false
     1955         .
     1956       end.
     1957       else do:
     1958         run diasize_change-width in this-procedure
     1959           (input v-diasize-orig-frame-width
     1960               - frame Dialog-Frame :width-chars
     1961           ,input true
     1962           ) .
     1963         run diasize_change-height in this-procedure
     1964           (input v-diasize-orig-frame-height
     1965               - frame Dialog-Frame :height-chars
     1966           ,input true
     1967           ) .
     1968         assign
     1969           v-diasize-need-maximize = true
     1970         .
     1971       end.
     1972     end.
     1973   end procedure.
     1974   procedure diasize_restore-orig-size :
     1975     do
     1976     on error undo, return error return-value
     1977     :
     1978       assign
     1979         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1980         v-diasize-current-frame-height = frame Dialog-Frame :height
     1981       .
     1982       run diasize_set-height in this-procedure
     1983         (input  v-diasize-orig-frame-height
     1984         ,input  true
     1985         ) .
     1986       run diasize_set-width in this-procedure
     1987         (input  v-diasize-orig-frame-width
     1988         ,input  true
     1989         ) .
     1990     end.
     1991   end procedure.
     1992   procedure diasize_restore-current-size :
     1993     do
     1994     on error undo, return error return-value
     1995     :
     1996       run diasize_set-height in this-procedure
     1997         (input  v-diasize-current-frame-height
     1998         ,input  true
     1999         ) .
     2000       run diasize_set-width in this-procedure
     2001         (input  v-diasize-current-frame-width
     2002         ,input  true
     2003         ) .
     2004     end.
     2005   end procedure.
     2006   procedure diasize_set-browse-handle :
     2007     define input  parameter p-browse-handle as handle   no-undo .
     2008     define buffer buf_temp-browse-handle for temp-browse-handle .
     2009     do
     2010     on error undo, return error return-value
     2011     :
     2012       assign
     2013         v-diasize-browse-handle = p-browse-handle
     2014       .
     2015       for each buf_temp-browse-handle
     2016       on error undo, return error return-value
     2017       :
     2018         delete buf_temp-browse-handle .
     2019       end.
     2020     end.
     2021   end procedure.
     2022   procedure diasize_add_browse :
     2023     define input  parameter p-browse-type   as character no-undo .
     2024     define input  parameter p-browse-handle as handle    no-undo .
     2025     define buffer buf_temp-browse-handle for temp-browse-handle .
     2026     do
     2027     on error undo, return error return-value
     2028     :
     2029       assign
     2030         v-diasize-browse-number = v-diasize-browse-number + 1
     2031       .
     2032       create buf_temp-browse-handle .
     2033       assign
     2034         buf_temp-browse-handle.browse-type   = p-browse-type
     2035         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2036         buf_temp-browse-handle.browse-handle = p-browse-handle
     2037       .
     2038     end.
     2039   end procedure.
     2040   procedure diasize_init :
     2041     define variable v-default-value    as logical   no-undo .
     2042     define variable v-restore-saved    as logical   no-undo .
     2043     define variable v-resize-value-str as character no-undo .
     2044     do
     2045     on error undo, return error return-value
     2046     :
     2047       do with frame Dialog-Frame
     2048       :
     2049         assign
     2050           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2051           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2052           v-diasize-browse-handle     = browse BR-free-tasks :handle
     2053         .
     2054         create button v-diasize-resize-button
     2055         assign
     2056           parent        = frame Dialog-Frame :first-child
     2057           label         = "s"
     2058           height-pixels = 16
     2059           width-pixels  = 16
     2060           visible       = true
     2061           sensitive     = true
     2062           movable       = true
     2063           triggers:
     2064             on end-move persistent run diasize_end-move in this-procedure .
     2065           end triggers.
     2066         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2067         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2068         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2069         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2070         assign
     2071           v-diasize-wndmax = false
     2072         .
     2073         if connected("ub") = true
     2074         then do:
     2075           define variable v-cntxt-db-num        as integer   no-undo .
     2076           define variable v-cntxt-userid        as character no-undo .
     2077           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2078                                             , OUTPUT v-cntxt-userid
     2079                                             ) .
     2080           run gbl/wndpar_r.p
     2081             (input  v-cntxt-db-num
     2082             ,input  v-cntxt-userid
     2083             ,input  'wndmax':U
     2084             ,output v-diasize-wndmax
     2085             ,output v-default-value
     2086             ) .
     2087         end.
     2088         assign
     2089           v-diasize-wndstore = false
     2090         .
     2091         if connected("ub") = true
     2092         then do:
     2093           run gbl/wndpar_r.p
     2094             (input  v-cntxt-db-num
     2095             ,input  v-cntxt-userid
     2096             ,input  'wndstore':U
     2097             ,output v-diasize-wndstore
     2098             ,output v-default-value
     2099             ) .
     2100         end.
     2101         assign
     2102           v-diasize-proc-name = entry(1, program-name(2), '.')
     2103         .
     2104         if v-diasize-wndstore = true
     2105         then do:
     2106           assign
     2107             v-restore-saved = false
     2108           .
     2109           if connected("ub") = true
     2110           then do:
     2111             run gbl/wndsizer.p
     2112               (input  v-cntxt-db-num
     2113               ,input  v-cntxt-userid
     2114               ,input  v-diasize-proc-name
     2115               ,input  'height':u
     2116               ,output v-resize-value-str
     2117               ) .
     2118             if v-resize-value-str <> '':U
     2119             then do:
     2120               run diasize_change-height in this-procedure
     2121                 (input  integer(v-resize-value-str)
     2122                 ,input  true
     2123                 ) .
     2124               assign
     2125                 v-restore-saved = true
     2126               .
     2127             end.
     2128           end.
     2129           if connected("ub") = true
     2130           then do:
     2131             run gbl/wndsizer.p
     2132               (input  v-cntxt-db-num
     2133               ,input  v-cntxt-userid
     2134               ,input  v-diasize-proc-name
     2135               ,input  'width':u
     2136               ,output v-resize-value-str
     2137               ) .
     2138             if v-resize-value-str <> '':U
     2139             then do:
     2140               run diasize_change-width in this-procedure
     2141                 (input  integer(v-resize-value-str)
     2142                 ,input  true
     2143                 ) .
     2144               assign
     2145                 v-restore-saved = true
     2146               .
     2147             end.
     2148           end.
     2149           if v-restore-saved <> true
     2150           then do:
     2151             if v-diasize-wndmax = true
     2152             then do:
     2153               run diasize_maximize in this-procedure
     2154                 (input  true
     2155                 ) .
     2156             end.
     2157           end.
     2158         end.
     2159         else do:
     2160           if v-diasize-wndmax = true
     2161           then do:
     2162             run diasize_maximize in this-procedure
     2163               (input  true
     2164               ) .
     2165           end.
     2166         end.
     2167       end.
     2168     end.
     2169   end procedure.
     2170   procedure diasize_need-full-display :
     2171     define output parameter p-need-full-display as logical   no-undo .
     2172     do
     2173     on error undo, return error return-value
     2174     :
     2175       assign
     2176         p-need-full-display = v-diasize-need-full-display
     2177       .
     2178       assign
     2179         v-diasize-need-full-display = false
     2180       .
     2181     end.
     2182   end procedure.
     2183   procedure get-context :
     2184      define output parameter p-db-num as integer          no-undo.
     2185      define output parameter p-user-id as character        no-undo.
     2186      define variable v-login               as character    no-undo.
     2187      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2188      define buffer buf_user-login  for ub.user-login .
     2189      do
     2190      on error undo, return error
     2191      :
     2192            FIND FIRST buf_sys-ctrl no-lock.
     2193            ASSIGN
     2194               v-login = USERID("ub")
     2195               p-db-num = buf_sys-ctrl.db-num
     2196            .
     2197            FIND FIRST buf_user-login
     2198                 WHERE buf_user-login.db-num = p-db-num
     2199                   AND buf_user-login.user-login = v-login
     2200                 no-lock
     2201                 no-error
     2202                 .
     2203            IF AVAILABLE buf_user-login
     2204            THEN DO:
     2205               assign
     2206                  p-user-id = buf_user-login.user-id
     2207               .
     2208            END.
     2209      end.
     2210   end procedure.
     2211   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2212   on F2 of frame Dialog-Frame anywhere do:
     2213     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     2214     return no-apply.
     2215   end.
     2216   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2217   on F2 of frame Dialog-Frame anywhere do:
     2218     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     2219     return no-apply.
     2220   end.
     2221   MAIN-BLOCK:
     2222   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2223      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2224     run get-db-num in parparentproc(output v-cntxt-db-num).
     2225     if p-free-id = '':u then do:
     2226       for each buf_temp-schedule-free:
     2227         delete buf_temp-schedule-free.
     2228       end.
     2229       run schedule-attr-fill-free-props in this-procedure .
     2230       if p-mode = 'shd' then do:
     2231         for each buf_temp-schedule-free:
     2232           if (v-cntxt-db-num = 0
     2233           and not  buf_temp-schedule-free.is-gbd)
     2234           or (v-cntxt-db-num <> 0
     2235           and not buf_temp-schedule-free.is-ubd)
     2236           or buf_temp-schedule-free.is-rum
     2237           then do:
     2238             delete buf_temp-schedule-free.
     2239           end.
     2240         end.
     2241       end.
     2242       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     2243         run schedule-attr-get-free-id  in this-procedure (
     2244                                                            input p-cre-db-num
     2245                                                           ,input p-task-type
     2246                                                           ,input p-task-num
     2247                                                           ,output v-free-id) no-error .
     2248         if error-status:error then do:
     2249           message
     2250           "Невозможно получить название  произвольного задания по строке расписания"
     2251           view-as alert-box error .
     2252           undo, return no-apply.
     2253         end.
     2254         p-free-id = v-free-id.
     2255       end.
     2256       else do:
     2257         run diasize_init in this-procedure .
     2258         RUN Myenable.
     2259         WAIT-FOR GO OF FRAME Dialog-Frame.
     2260       end.
     2261     end.
     2262     else do:
     2263       v-free-id = p-free-id.
     2264     end.
     2265     run schedule-attr-is-rum-free-id in this-procedure ( input v-free-id
     2266                                                         ,output v-is-rum) no-error.
     2267     if error-status:error then do:
     2268       message
     2269       "Невозможно получить свойство RUM  произвольного задания по строке расписания"
     2270       view-as alert-box error .
     2271       undo, return error.
     2272     end.
     2273     run schedule-attr-value in this-procedure (
     2274                                                   input p-cre-db-num
     2275                                                   ,input p-task-type
     2276                                                   ,input  p-task-num
     2277                                                   ,input  ('schd-free-id':U + chr(4) + v-free-id)
     2278                                                   ,output v-value
     2279                                                   ,output v-type          ).
     2280     CASE p-mode:
     2281       when 'ДОБАВЛЕНИЕ':U then do:
     2282       end.
     2283       when 'shd' then do:
     2284         if v-is-rum then do:
     2285           run str/freerump.w (
     2286                 input parparentproc
     2287               , input p-cre-db-num
     2288               , input p-task-type
     2289               , input p-task-num
     2290               , output v-cancel
     2291           ) no-error.
     2292         end.
     2293         else do:
     2294         if v-value <> '':u then do:
     2295           v-proc-name = entry(buffer buf_temp-schedule-free:buffer-field("proc-param-edit-name"):POSITION - 2
     2296                                     , v-value, chr(4) ) .
     2297           if v-proc-name <> '':U  then do:
     2298             if search(replace(v-proc-name, ".w":U, ".r":U)) <> ?
     2299             or
     2300             search(v-proc-name) <> ?   then do:
     2301               run value(v-proc-name) (
     2302                                                                   input parparentproc
     2303                                                                   ,input p-curr-host-code
     2304                                                                   ,input p-curr-obj-type
     2305                                                                   ,input p-curr-obj-code
     2306                                                                   ,input 'shd':U
     2307                                                                   ,input p-cre-db-num
     2308                                                                   ,input p-task-type
     2309                                                                   ,input p-task-num
     2310                                                                   ,input ?
     2311                                                                   ,output p-cancel
     2312                                                                   ,output p-params
     2313                                                               ) no-error .
     2314               if error-status:error then do:
     2315                 undo, return error .
     2316               end.
     2317               RETURN.
     2318             end.
     2319             else do:
     2320               message
     2321               substitute("Не определена или не найдена процедура редактирования параметров для произвольной задачи по расписанию &1"
     2322                         , v-proc-name)
     2323               view-as alert-box error .
     2324               undo, return error .
     2325             end.
     2326           end.
     2327           else do:
     2328             if p-task-num >= 0 then do:
     2329               message
     2330               "Данная произвольная процедура не требует параметров"
     2331               view-as alert-box .
     2332               undo, return  .
     2333             end.
     2334           end.
     2335         end.
     2336         end.
     2337       end.
     2338     END CASE.
     2339   END.
     2340   RUN disable_UI.
     2341   PROCEDURE disable_UI :
     2342     HIDE FRAME Dialog-Frame.
     2343   END PROCEDURE.
     2344   PROCEDURE enable_UI :
     2345     ENABLE b-quit B-sel B-Help BR-free-tasks
     2346         WITH FRAME Dialog-Frame.
     2347     VIEW FRAME Dialog-Frame.
     2348     OPEN QUERY BR-free-tasks FOR EACH buf_temp-schedule-free.
     2349   END PROCEDURE.
     2350   PROCEDURE MyEnable :
     2351   assign
     2352   frame Dialog-Frame:title = "Произвольные задания"
     2353   buf_temp-schedule-free.free-task-name:RESIZABLE IN BROWSE br-free-tasks = YES
     2354   buf_temp-schedule-free.free-id:RESIZABLE IN BROWSE br-free-tasks = YES
     2355   .
     2356     ENABLE
     2357     b-quit
     2358     B-sel
     2359     B-Help
     2360     BR-free-tasks
     2361     WITH FRAME Dialog-Frame.
     2362     VIEW FRAME Dialog-Frame.
     2363     OPEN QUERY BR-free-tasks FOR EACH buf_temp-schedule-free.
     2364   END PROCEDURE.
