      688   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      689   define variable v-tth           as handle   no-undo .
      690   define variable v-to-create    as logical      no-undo.
      691   DEFINE BUTTON b-exit AUTO-GO
      692        LABEL "Ввод"
      693        SIZE 10 BY 1
      694        BGCOLOR 8 .
      695   DEFINE BUTTON b-help
      696        LABEL "Помо&щь"
      697        SIZE 10 BY 1
      698        BGCOLOR 8 .
      699   DEFINE BUTTON b-quit AUTO-END-KEY
      700        LABEL "Отмена"
      701        SIZE 10 BY 1
      702        BGCOLOR 8 .
      703   DEFINE VARIABLE tb-wndmax AS LOGICAL INITIAL no
      704        LABEL "Максимизировать окна при открытии"
      705        VIEW-AS TOGGLE-BOX
      706        SIZE 37.5 BY .83 TOOLTIP "окно будет максимизироваться или будет считываться сохранённая настройка окна" NO-UNDO.
      707   DEFINE VARIABLE tb-wndstore AS LOGICAL INITIAL no
      708        LABEL "Сохранять внешний вид окна"
      709        VIEW-AS TOGGLE-BOX
      710        SIZE 37.5 BY .83 TOOLTIP "при изменении размера окна будет сохраняться его ширина и высота" NO-UNDO.
      711   DEFINE FRAME Dialog-Frame
      712        b-exit AT ROW 1 COL 1
      713        b-quit AT ROW 1 COL 11
      714        b-help AT ROW 1 COL 39.5
      715        tb-wndmax AT ROW 2.75 COL 6 WIDGET-ID 2
      716        tb-wndstore AT ROW 4 COL 6 WIDGET-ID 4
      717        SPACE(6.37) SKIP(1.08)
      718       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      719            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      720            TITLE "Настройки размеров окон"
      721            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit WIDGET-ID 100.
      722   ASSIGN
      723          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      724          FRAME Dialog-Frame:HIDDEN           = TRUE.
      725   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      726   DO:
      727      APPLY "END-ERROR":U TO SELF.
      728   END.
      729   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      730   DO:
      731      if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      732         run save-attr in this-procedure .
      733      END.
      734   END.
      735   ON CHOOSE OF b-help IN FRAME Dialog-Frame
      736   OR HELP OF FRAME Dialog-Frame
      737   DO:
      738      MESSAGE "Help for File: c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\adm\shattr35.w" VIEW-AS ALERT-BOX INFORMATION.
      739   END.
      740   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      741   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      742   MAIN-BLOCK:
      743   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      744      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      745   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      746   on help of frame Dialog-Frame
      747   do:
      748     run gbl/app_help.p
      749       (input this-procedure :file-name
      750       ,input ''
      751       ,input ?
      752       ) no-error.
      753     if error-status :error then do:
      754       message
      755         "Ошибка при вызове помощи"
      756         error-status :get-message(1)
      757         view-as alert-box .
      758     end.
      759   end.
      760   run minbtn-set in this-procedure .
      761   on choose of b-help in frame Dialog-Frame
      762   do:
      763     apply "help":u to frame Dialog-Frame .
      764   end.
      765   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      766   procedure minbtn-set :
      767       do
      768           on error undo, return error return-value
      769           :
      770           define variable ii              as integer       no-undo .
      771           define variable fh              as widget-handle no-undo .
      772           define variable hh              as widget-handle no-undo .
      773           define variable v-h             as handle        extent 4 no-undo .
      774           define variable v-name-button   as character     no-undo .
      775           define variable v-help-old-x    as decimal       no-undo .
      776           define variable v-help-old-y    as decimal       no-undo .
      777           define variable v-help-old-size as decimal       no-undo .
      778           define variable v-frame-width   as decimal       no-undo .
      779           define variable jj              as integer       no-undo .
      780           do
      781               on error undo, return error
      782               :
      783               assign
      784                   v-frame-width = frame Dialog-Frame:width - 0.3
      785                   fh            = frame Dialog-Frame:first-child
      786                   hh            = fh:first-child
      787                   ii            = 1
      788                   .
      789               do while valid-handle(hh):
      790                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      791                   do:
      792                       case lc(hh:name) :
      793                           when "b-help" then
      794                               do:
      795                                   hh:load-image-up("cmp/b-help.bmp":u) .
      796                                   hh:load-image-down("cmp/b-help.bmp":u) .
      797                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      798                                   hh:TOOLTIP = "Помощь" .
      799                                   v-help-old-x = hh:column .
      800                                   v-help-old-y = hh:row    .
      801                                   v-help-old-size = hh:width .
      802                                   hh:width-chars = 2.5 .
      803                               end.
      804                           when "b-print" then
      805                               do:
      806                                   hh:load-image("cmp/b-print.bmp":u) .
      807                                   hh:TOOLTIP = "Печать" .
      808                                   v-h[ii] = hh:handle .
      809                                   ii = ii + 1 .
      810                                   hh:width-chars = 3 .
      811                               end.
      812                           when "b-history" or
      813                           when "b-hist" then
      814                               do:
      815                                   hh:load-image("cmp/b-hist.bmp":u) .
      816                                   hh:TOOLTIP = "История" .
      817                                   v-h[ii] = hh:handle .
      818                                   ii = ii + 1 .
      819                                   hh:width-chars = 3 .
      820                               end.
      821                           when "b-sch" then
      822                               do:
      823                                   hh:load-image("cmp/b-sch.bmp":u) .
      824                                   hh:TOOLTIP = "Установка Фильтра" .
      825                                   v-h[ii] = hh:handle .
      826                                   ii = ii + 1 .
      827                                   hh:width-chars = 3 .
      828                               end.
      829                           when "b-hist-user" then
      830                               do:
      831                                   hh:load-image("cmp/b-hist.bmp":u) .
      832                                   hh:TOOLTIP = "История пользователя" .
      833                                   ii = ii + 1 .
      834                               end.
      835                       end case.
      836                   end.
      837                   hh = hh:next-sibling.
      838               end.
      839               b-help:column = v-frame-width - b-help:width-chars.
      840               jj = 0.
      841               repeat ii = 4 to 1 by -1 :
      842                   if valid-handle (v-h[ii] ) then
      843                   do:
      844                       jj  = jj + 1 .
      845                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      846                       v-h[ii]:row    = v-help-old-y .
      847                   end.
      848               end.
      849           end.
      850       end.
      851   end procedure.
      852     if  p-mode <> 'ПРОСМОТР':U and
      853         p-mode <> 'ИЗМЕНЕНИЕ':U
      854     then do:
      855         message
      856         vss-workfile vss-revision vss-description skip
      857         "Неверное значение параметра p-mode" p-mode
      858         view-as alert-box error.
      859         undo, return error.
      860     end.
      861     RUN load-attr IN THIS-PROCEDURE .
      862     RUN enable_UI.
      863     RUN post_enable_UI IN THIS-PROCEDURE.
      864     WAIT-FOR GO OF FRAME Dialog-Frame.
      865   END.
      866   RUN disable_UI.
      867   PROCEDURE disable_UI :
      868     HIDE FRAME Dialog-Frame.
      869   END PROCEDURE.
      870   PROCEDURE enable_UI :
      871     DISPLAY tb-wndmax tb-wndstore
      872         WITH FRAME Dialog-Frame.
      873     ENABLE b-exit b-quit b-help tb-wndmax tb-wndstore
      874         WITH FRAME Dialog-Frame.
      875     VIEW FRAME Dialog-Frame.
      876   END PROCEDURE.
      877   PROCEDURE load-attr :
      878   define variable v-value-character as character      no-undo .
      879   define variable v-value-date      as date           no-undo .
      880   define variable v-value-decimal   as decimal        no-undo .
      881   define variable v-value-integer   as integer        no-undo .
      882   define variable v-value-logical   as logical        no-undo .
      883   define variable v-param-type      as character      no-undo .
      884   define variable v-entry           as character  no-undo .
      885   do
      886   on error undo, return error
      887   :
      888      if p-mode = 'ИЗМЕНЕНИЕ':U then
      889      do
      890      transaction
      891      :
      892         find first locked_thbj-attr
      893               where locked_thbj-attr.upper-prop-code = 'wnd-size':U
      894               exclusive-lock
      895               no-wait
      896               no-error
      897               .
      898         if locked locked_thbj-attr then do:
      899            message
      900               vss-workfile vss-revision vss-description skip
      901                  "Запись !!!"
      902               view-as alert-box error .
      903            undo, return error.
      904         end.
      905      end.
      906      else do:
      907         find first locked_thbj-attr
      908               where locked_thbj-attr.upper-prop-code = 'wnd-size':U
      909               no-lock
      910               no-error
      911               .
      912      end.
      913      if not available locked_thbj-attr then do:
      914         assign
      915            v-to-create  = yes
      916         .
      917         message
      918            substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
      919                        chr(10)
      920                        )
      921         view-as alert-box WARNING.
      922      end.
      923      assign
      924         v-tth = buffer thbjattr_thbj-attr:table-handle
      925      .
      926      empty temp-table thbjattr_thbj-attr.
      927      empty temp-table temp-thbj-attr.
      928     run adm/shattri.p (
      929                   input "init":U
      930                 , input p-obj-type
      931                 , input p-obj-code
      932                 , input 'wnd-size':U
      933                 , input "":U
      934                 , output v-value-character
      935                 , output v-value-date
      936                 , output v-value-decimal
      937                 , output v-value-integer
      938                 , output v-value-logical
      939                 , output v-param-type
      940                 , INPUT-OUTPUT table-handle v-tth
      941                 ) no-error .
      942     if error-status:error
      943     and not available locked_thbj-attr then do:
      944       message
      945       "Не удалось получить начальные значения настроек" skip
      946       error-status:get-message(1) return-value
      947       view-as alert-box error .
      948       undo, return error .
      949     end.
      950     for each thbjattr_thbj-attr:
      951       assign
      952         v-entry = thbjattr_thbj-attr.prop-code
      953       .
      954       case v-entry:
      955         when 'max':U then do:
      956           assign
      957             tb-wndmax = thbjattr_thbj-attr.property-value-logical
      958             tb-wndmax :private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
      959           .
      960         end.
      961         when 'store':U then do:
      962           assign
      963             tb-wndstore = thbjattr_thbj-attr.property-value-logical
      964             tb-wndstore :private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
      965           .
      966         end.
      967       end case.
      968       create temp-thbj-attr.
      969       buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
      970     end.
      971   end.
      972   END PROCEDURE.
      973   PROCEDURE post_enable_UI :
      974   do
      975   on error undo, return error
      976   :
      977     if  p-mode = 'ПРОСМОТР':U
      978     then do:
      979       DISABLE
      980           tb-wndmax tb-wndstore
      981       WITH FRAME Dialog-Frame.
      982     END.
      983   END.
      984   END PROCEDURE.
      985   PROCEDURE save-attr :
      986   define variable v-value-character as character      no-undo .
      987   define variable v-value-date      as date           no-undo .
      988   define variable v-value-decimal   as decimal        no-undo .
      989   define variable v-value-integer   as integer        no-undo .
      990   define variable v-value-logical   as logical        no-undo .
      991   define variable v-param-type      as character      no-undo .
      992   define variable wh                as widget-handle  no-undo .
      993   define variable fh                as widget-handle  no-undo .
      994   define variable v-same            as logical        no-undo .
      995   do
      996   on error undo, return error
      997   :
      998      assign
      999      frame Dialog-Frame
     1000         tb-wndmax
     1001         tb-wndstore
     1002         fh = frame Dialog-Frame:first-child
     1003         wh = fh:first-child
     1004      .
     1005      do while valid-handle(wh):
     1006         if wh:private-data begins "recid="
     1007         then do:
     1008            find first thbjattr_thbj-attr
     1009            where recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '='))
     1010            .
     1011            assign
     1012            buffer
     1013            thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value
     1014            .
     1015         end.
     1016         wh = wh:next-sibling.
     1017      end.
     1018      assign
     1019         v-same = yes
     1020      .
     1021      for each thbjattr_thbj-attr,
     1022            first temp-thbj-attr
     1023            where temp-thbj-attr.obj-type          = thbjattr_thbj-attr.obj-type
     1024               and temp-thbj-attr.obj-code         = thbjattr_thbj-attr.obj-code
     1025               and temp-thbj-attr.upper-prop-code  = thbjattr_thbj-attr.upper-prop-code
     1026               and temp-thbj-attr.prop-code        = thbjattr_thbj-attr.prop-code
     1027      :
     1028         buffer-compare thbjattr_thbj-attr to temp-thbj-attr save result in v-same.
     1029         if not v-same then leave.
     1030      end.
     1031      if v-same  and not v-to-create then return.
     1032      run adm/shattri.p ( input "check":U
     1033                        , input p-obj-type
     1034                        , input p-obj-code
     1035                        , input 'wnd-size':U
     1036                        , INPUT '':U
     1037                        , output v-value-character
     1038                        , output v-value-date
     1039                        , output v-value-decimal
     1040                        , output v-value-integer
     1041                        , output v-value-logical
     1042                        , output v-param-type
     1043                        , input-output table-handle v-tth
     1044                        ) no-error .
     1045      if error-status :error then do:
     1046         message
     1047            "Некорректное значение ПАРАМЕТРОВ"  skip
     1048            error-status:get-message(1)         skip
     1049            return-value
     1050         view-as alert-box error .
     1051         undo, return error .
     1052      end.
     1053      do transaction
     1054      on error undo, return error return-value
     1055      :
     1056         run thbjattr_set-section in this-procedure ( input p-obj-type
     1057                                                   , input p-obj-code
     1058                                                   , input 'wnd-size':U
     1059                                                   , input table thbjattr_thbj-attr
     1060                                                   ) no-error.
     1061         if error-status:error then do:
     1062            message
     1063            error-status:get-message(1)  skip
     1064            return-value
     1065            view-as alert-box.
     1066            undo, return error.
     1067         end.
     1068      end.
     1069   end.
     1070   END PROCEDURE.
