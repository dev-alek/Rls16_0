      402   procedure thbjattr_code :
      403      define input  parameter p-upper-code     as character no-undo .
      404      define input  parameter p-code           as character no-undo .
      405      define output parameter p-label          as character no-undo .
      406      define output parameter p-user-can-edit  as logical   no-undo .
      407      define output parameter p-output-display as logical   no-undo .
      408      define output parameter p-other          as character no-undo .
      409      define output parameter p-prop-list      as character no-undo .
      410      define output parameter p-prop-type-list as character no-undo .
      411      define output parameter p-prop-label-list as character no-undo .
      412      define output parameter p-global          as logical no-undo .
      413      define output parameter p-host           as logical no-undo .
      414      define output parameter p-shop           as logical no-undo .
      415      define output parameter p-store          as logical no-undo .
      416      define output parameter p-db             as logical no-undo .
      417      define variable p-region as logical no-undo.
      418      run thbjattr_code_reg in this-procedure (
      419                                               p-upper-code,
      420                                               p-code,
      421                                               output p-label,
      422                                               output p-user-can-edit,
      423                                               output p-output-display,
      424                                               output p-other,
      425                                               output p-prop-list,
      426                                               output p-prop-type-list,
      427                                               output p-prop-label-list,
      428                                               output p-global,
      429                                               output p-host,
      430                                               output p-shop,
      431                                               output p-store,
      432                                               output p-db,
      433                                               output p-region
      434                                               ).
      435   end procedure.
      436   procedure thbjattr_code_reg :
      437   define input  parameter p-upper-code     as character no-undo .
      438   define input  parameter p-code           as character no-undo .
      439   define output parameter p-label          as character no-undo .
      440   define output parameter p-user-can-edit  as logical   no-undo .
