      556   procedure uf-get :
      557     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      558     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      559     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      560     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      561     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      562     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      563     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      564     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      565     do
      566     on error undo, return error
      567     :
      568       define buffer buf_usr-flt for ubflt.usr-flt .
      569       define variable v-use-List_     as logical   no-undo .
      570       define variable v-type-List_     as character no-undo .
      571       define variable v-format-List_   as character no-undo .
      572       define variable v-use-Naim      as logical   no-undo .
      573       define variable v-type-Naim      as character no-undo .
      574       define variable v-format-Naim    as character no-undo .
      575       define variable v-use-print-graft as logical   no-undo .
      576       define variable v-use-sort-gr     as logical   no-undo .
      577       define variable v-use-type-price  as logical   no-undo .
      578       define variable v-use-type-val    as logical   no-undo .
      579       define variable v-label          as character no-undo .
      580       define variable v-tooltip        as character no-undo .
      581       define variable v-user-can-edit  as logical   no-undo .
      582       define variable v-output-display as logical   no-undo .
      583       define variable v-other          as character no-undo .
      584       run uf-name in this-procedure
      585          (input  entry(1, p-code, chr(4))
      586         ,output v-use-List_
      587         ,output v-type-List_
      588         ,output v-format-List_
      589         ,output v-use-Naim
      590         ,output v-type-Naim
      591         ,output v-format-Naim
      592         ,output v-use-print-graft
      593         ,output v-use-sort-gr
      594         ,output v-use-type-price
      595         ,output v-use-type-val
      596         ,output v-label
      597         ,output v-tooltip
      598         ,output v-user-can-edit
      599         ,output v-output-display
      600         ,output v-other
      601         ) no-error .
      602       if error-status :error then do:
      603         undo, return error return-value .
      604       end.
      605       find first buf_usr-flt no-lock where
      606                  buf_usr-flt.Call-point     = p-code AND
      607                  buf_usr-flt.user-name       = p-user-name
      608         no-error .
      609       if avail buf_usr-flt then do:
      610         assign
      611         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      612         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      613         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      614         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      615         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      616         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      617         .
      618       end.
      619       else do:
      620         assign
      621         p-List_        = (if v-use-List_       then "":U                    else ?)
      622         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      623         p-print-graft  = (if v-use-print-graft then no                      else ?)
      624         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      625         p-type-price   = (if v-use-type-price  then no                      else ?)
      626         p-type-val     = (if v-use-List_       then no                      else ?)
      627         .
      628       end.
      629     end.
      630   end procedure.
      631   procedure uf-set :
      632     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      633     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      634     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      635     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      636     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      637     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      638     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      639     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      640     do
      641     on error undo, return error
      642     :
      643       define buffer buf_usr-flt for ubflt.usr-flt .
      644       define variable v-use-List_     as logical   no-undo .
      645       define variable v-type-List_     as character no-undo .
      646       define variable v-format-List_   as character no-undo .
      647       define variable v-use-Naim      as logical   no-undo .
      648       define variable v-type-Naim      as character no-undo .
      649       define variable v-format-Naim    as character no-undo .
      650       define variable v-use-print-graft as logical   no-undo .
      651       define variable v-use-sort-gr   as logical   no-undo .
      652       define variable v-use-type-price as logical   no-undo .
      653       define variable v-use-type-val  as logical   no-undo .
      654       define variable v-tooltip        as character no-undo .
      655       define variable v-label          as character no-undo .
      656       define variable v-user-can-edit  as logical   no-undo .
      657       define variable v-output-display as logical   no-undo .
      658       define variable v-other          as character no-undo .
      659       run uf-name in this-procedure
      660         (input  entry(1, p-code, chr(4))
      661         ,output v-use-List_
      662         ,output v-type-List_
      663         ,output v-format-List_
      664         ,output v-use-Naim
      665         ,output v-type-Naim
      666         ,output v-format-Naim
      667         ,output v-use-print-graft
      668         ,output v-use-sort-gr
      669         ,output v-use-type-price
      670         ,output v-use-type-val
      671         ,output v-label
      672         ,output v-tooltip
      673         ,output v-user-can-edit
      674         ,output v-output-display
      675         ,output v-other
      676         ) no-error .
      677       if error-status :error then do:
      678         undo, return error return-value .
      679       end.
      680       find first buf_usr-flt where
      681                  buf_usr-flt.Call-point     = p-code AND
      682                  buf_usr-flt.user-name       = p-user-name
      683         no-error .
      684       if not avail buf_usr-flt then do:
      685           create buf_usr-flt .
      686           assign
      687           buf_usr-flt.call-point = p-code
      688           buf_usr-flt.user-name  = p-user-name
      689           .
      690       end.
      691       if avail buf_usr-flt then do:
      692        assign
      693        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      694        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      695        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      696        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      697        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      698        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      699       .
      700       release buf_usr-flt.
      701       end.
      702       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      703     end.
      704   end procedure.
      705   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      706     define variable v-cntxt-db-num        as integer   no-undo .
      707     define variable v-cntxt-userid        as character no-undo .
      708     define variable v-cntxt-level         as character no-undo .
      709     define variable v-cntxt-host-code-obj as integer   no-undo .
      710     define variable v-cntxt-obj-type      as character no-undo .
      711     define variable v-cntxt-obj-code      as integer   no-undo .
      712     define variable v-cntxt-db-num-obj    as integer   no-undo .
      713     define variable v-cntxt-is-admin      as logical   no-undo .
      714   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      715     run mainmenu_getcntxt in parparentproc
      716       (output v-cntxt-db-num
      717       ,output v-cntxt-userid
      718       ,output v-cntxt-level
      719       ,output v-cntxt-host-code-obj
      720       ,output v-cntxt-obj-type
      721       ,output v-cntxt-obj-code
      722       ,output v-cntxt-db-num-obj
      723       ,output v-cntxt-is-admin
      724       ) .
      725   define variable v-host-code     as integer   no-undo .
      726   define variable v-obj-host-code as integer   no-undo.
      727   define variable v-types         as character no-undo .
      728   DEFINE BUTTON b-clients DEFAULT
      729        IMAGE-UP FILE "btn-down-arrow":U
      730        IMAGE-DOWN FILE "btn-down-arrow":U
      731        IMAGE-INSENSITIVE FILE "btn-down-arrow":U NO-FOCUS
      732        LABEL "b-clients"
      733        SIZE 3 BY .88.
      734   DEFINE BUTTON b-exit AUTO-GO DEFAULT
      735        LABEL "&Ввод"
      736        SIZE 10 BY 1
      737        BGCOLOR 8 .
      738   DEFINE BUTTON b-help
      739        LABEL "Помо&щь"
      740        SIZE 10 BY 1
      741        BGCOLOR 8 .
      742   DEFINE BUTTON b-quit AUTO-END-KEY DEFAULT
      743        LABEL "&Отмена"
      744        SIZE 10 BY 1
      745        BGCOLOR 8 .
      746   DEFINE BUTTON btn_dwl
      747        LABEL "Загрузить"
      748        SIZE 15 BY 1 TOOLTIP "Загрузить значение из excel".
      749   DEFINE VARIABLE f-host-name AS CHARACTER FORMAT "X(80)":U
      750        LABEL "Фирма"
      751        VIEW-AS COMBO-BOX INNER-LINES 5
      752        DROP-DOWN-LIST
      753        SIZE 85 BY 1 NO-UNDO.
      754   DEFINE VARIABLE f-obj-type AS CHARACTER FORMAT "X(3)":U
      755        LABEL "Объект"
      756        VIEW-AS COMBO-BOX INNER-LINES 5
      757        DROP-DOWN-LIST
      758        SIZE 6 BY 1 NO-UNDO.
      759   DEFINE VARIABLE f-param-name AS CHARACTER
      760        VIEW-AS EDITOR NO-BOX
      761        SIZE 85 BY 1.5 NO-UNDO.
      762   DEFINE VARIABLE f-param-ps AS CHARACTER
      763        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      764        SIZE 85 BY 2.5 NO-UNDO.
      765   DEFINE VARIABLE f-beg-date AS DATE FORMAT "99/99/9999":U
      766        VIEW-AS FILL-IN
      767        SIZE 11 BY 1 NO-UNDO.
      768   DEFINE VARIABLE f-cnf-type AS CHARACTER FORMAT "X(40)":U
      769         VIEW-AS TEXT
      770        SIZE 51.5 BY .67 NO-UNDO.
      771   DEFINE VARIABLE f-db-key AS CHARACTER FORMAT "X(12)" INITIAL ?
      772        LABEL "Ключ БД"
      773        VIEW-AS FILL-IN
      774        SIZE 13 BY 1 NO-UNDO.
      775   DEFINE VARIABLE f-db-num AS INTEGER FORMAT ">>>>>>>>9" INITIAL ?
      776        LABEL "Номер БД"
      777        VIEW-AS FILL-IN
      778        SIZE 9 BY 1 NO-UNDO.
      779   DEFINE VARIABLE f-end-date AS DATE FORMAT "99/99/9999":U
      780        VIEW-AS FILL-IN
      781        SIZE 11 BY 1 NO-UNDO.
      782   DEFINE VARIABLE f-obj-code AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
      783        VIEW-AS FILL-IN
      784        SIZE 7 BY 1 NO-UNDO.
      785   DEFINE VARIABLE f-obj-name AS CHARACTER FORMAT "X(80)":U
      786         VIEW-AS TEXT
      787        SIZE 68.5 BY .67 NO-UNDO.
      788   DEFINE VARIABLE f-param-code AS CHARACTER FORMAT "X(8)":U
      789        LABEL "Параметр"
      790         VIEW-AS TEXT
      791        SIZE 9 BY .67 NO-UNDO.
      792   DEFINE VARIABLE f-param-value AS CHARACTER FORMAT "X(250)":U
      793        LABEL "Значение"
      794        VIEW-AS COMBO-BOX INNER-LINES 5
      795        DROP-DOWN-LIST
      796        SIZE 85 BY 1 NO-UNDO.
      797   DEFINE VARIABLE f-param-value-2 AS CHARACTER FORMAT "X(31000)":U
      798        LABEL "Значение"
      799        VIEW-AS FILL-IN
      800        SIZE 85 BY 1 NO-UNDO.
      801   DEFINE RECTANGLE RECT-1
      802        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      803        SIZE 97 BY 4.
      804   DEFINE RECTANGLE RECT-2
      805        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      806        SIZE 97 BY 3.25.
      807   DEFINE VARIABLE t-beg-date AS LOGICAL INITIAL yes
      808        LABEL "неограничено"
      809        VIEW-AS TOGGLE-BOX
      810        SIZE 16.5 BY 1 NO-UNDO.
      811   DEFINE VARIABLE t-end-date AS LOGICAL INITIAL yes
      812        LABEL "неограничено"
      813        VIEW-AS TOGGLE-BOX
      814        SIZE 16.5 BY 1 NO-UNDO.
      815   DEFINE FRAME d-cnf
      816        b-clients AT ROW 15.38 COL 26
      817        b-exit AT ROW 1 COL 2
      818        b-quit AT ROW 1 COL 12
      819        b-help AT ROW 1 COL 89
      820        f-db-num AT ROW 2.5 COL 12 COLON-ALIGNED
      821        f-db-key AT ROW 2.5 COL 31.5 COLON-ALIGNED
      822        f-param-name AT ROW 4.96 COL 14 NO-LABEL
      823        f-param-ps AT ROW 6.79 COL 14 NO-LABEL
      824        f-param-value-2 AT ROW 9.54 COL 12 COLON-ALIGNED WIDGET-ID 4
      825        f-param-value AT ROW 9.54 COL 12 COLON-ALIGNED
      826        f-beg-date AT ROW 11.29 COL 30.5 COLON-ALIGNED NO-LABEL
      827        t-beg-date AT ROW 11.29 COL 45
      828        btn_dwl AT ROW 11.29 COL 62.5 WIDGET-ID 2
      829        f-end-date AT ROW 12.54 COL 30.5 COLON-ALIGNED NO-LABEL
      830        t-end-date AT ROW 12.54 COL 45
      831        f-obj-type AT ROW 15.29 COL 11 COLON-ALIGNED
      832        f-obj-code AT ROW 15.29 COL 17 COLON-ALIGNED NO-LABEL
      833        f-host-name AT ROW 16.5 COL 11 COLON-ALIGNED
      834        f-param-code AT ROW 3.79 COL 12 COLON-ALIGNED
      835        f-cnf-type AT ROW 3.79 COL 21 COLON-ALIGNED NO-LABEL
      836        f-obj-name AT ROW 15.46 COL 27.5 COLON-ALIGNED NO-LABEL
      837        "Дата окончания действия:" VIEW-AS TEXT
      838             SIZE 25 BY .75 AT ROW 12.54 COL 7.5
      839        "Название:" VIEW-AS TEXT
      840             SIZE 9.5 BY 1 AT ROW 4.79 COL 4
      841        "Дата начала действия:" VIEW-AS TEXT
      842             SIZE 22 BY .75 AT ROW 11.54 COL 10.5
      843        "Привязки" VIEW-AS TEXT
      844             SIZE 9 BY .67 AT ROW 14.29 COL 2.5
      845        "Примечание:" VIEW-AS TEXT
      846             SIZE 11 BY 1 AT ROW 6.79 COL 2
      847        RECT-1 AT ROW 14.04 COL 2
      848        RECT-2 AT ROW 10.79 COL 2
      849        SPACE(0.87) SKIP(4.33)
      850       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      851            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      852            TITLE "Модификация параметра конфигурации"
      853            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit.
      854   ASSIGN
      855          FRAME d-cnf:SCROLLABLE       = FALSE.
      856   ASSIGN
      857          f-cnf-type:READ-ONLY IN FRAME d-cnf        = TRUE.
      858   ASSIGN
      859          f-db-key:READ-ONLY IN FRAME d-cnf        = TRUE.
      860   ASSIGN
      861          f-db-num:READ-ONLY IN FRAME d-cnf        = TRUE.
      862   ASSIGN
      863          f-obj-name:READ-ONLY IN FRAME d-cnf        = TRUE.
      864   ASSIGN
      865          f-param-code:READ-ONLY IN FRAME d-cnf        = TRUE.
      866   ASSIGN
      867          f-param-name:READ-ONLY IN FRAME d-cnf        = TRUE.
      868   ASSIGN
      869          f-param-ps:READ-ONLY IN FRAME d-cnf        = TRUE.
      870   ON WINDOW-CLOSE OF FRAME d-cnf
      871   DO:
      872     APPLY "END-ERROR":U TO SELF.
      873   END.
      874   ON CHOOSE OF b-clients IN FRAME d-cnf
      875   DO:
      876       define variable ref-list   as character no-undo.
      877       define variable ref-rec    as recid     no-undo.
      878       define variable clr-object as logical   no-undo .
      879       run ref/cli-all.w ( parparentproc, "b-sel", ?, ?, ?, ?, ?, ?, output ref-list) .
      880       if ref-list <> ""
      881       then do:
      882         assign
      883           ref-rec = integer (ref-list)
      884         .
      885         run disp-obj in this-procedure
      886           ( input ref-rec
      887            ,input ?
      888            ,input ?
      889           ) no-error .
      890         if error-status :error then do:
      891           return no-apply .
      892         end.
      893         run chk-host-code in db-hdl (f-obj-type, f-obj-code, output v-obj-host-code).
      894         if v-obj-host-code = ?
      895         then do:
      896           run clr-ref-object ( return-value ).
      897         end.
      898         else do:
      899           if v-host-code <> v-obj-host-code then do:
      900             if v-host-code <> 0 then do:
      901               message "Выбранный объект относится к другой фирме " skip
      902                       "Заменить привязку к фирме?" skip
      903                 view-as alert-box buttons yes-no update clr-object .
      904             end.
      905             if clr-object = true
      906               or v-host-code = 0
      907             then do:
      908               assign
      909                 v-host-code = v-obj-host-code
      910               .
      911               find first ub.clients no-lock
      912                 where ub.clients.obj-code = v-obj-host-code
      913                   and ub.clients.obj-type = 'орг':U
      914               no-error.
      915               assign
      916                 f-host-name = substitute( "&1  &2", string(ub.clients.obj-code, "999999999"), ub.clients.obj-name )
      917               .
      918               display f-host-name with frame d-cnf.
      919             end.
      920           end.
      921         end.
      922       end.
      923   END.
      924   ON CHOOSE OF b-exit IN FRAME d-cnf
      925   DO:
      926     define variable v-msg as character no-undo .
      927     define variable v-ok  as logical   no-undo .
      928     define buffer buf_cnf for cnf.
      929     assign
      930       f-db-num
      931       f-db-key
      932       f-param-value
      933       f-param-value-2
      934       f-obj-type
      935       f-obj-code
      936       t-beg-date
      937       t-end-date
      938     .
      939     if t-beg-date <> true
      940     then do:
      941       assign
      942         f-beg-date
      943       .
      944     end.
      945     if t-end-date <> true
      946     then do:
      947       assign
      948         f-end-date
      949       .
      950     end.
      951     if f-param-value = ? then do:
      952       assign
      953         f-param-value = "":U
      954       .
      955     end.
      956     if f-param-value-2 = ? then do:
      957       assign
      958         f-param-value-2 = "":U
      959       .
      960     end.
      961     if f-beg-date = ? then do:
      962       message
      963         "Не установлена дата начала срока действия параметра!" skip
      964         view-as alert-box error .
      965       apply "entry":U to f-beg-date in frame d-cnf.
      966       return no-apply.
      967     end.
      968     if f-end-date = ? then do:
      969       message
      970         "Не установлена дата окончания срока действия параметра!" skip
      971         view-as alert-box error .
      972       apply "entry":U to f-end-date in frame d-cnf.
      973       return no-apply.
      974     end.
      975     if f-db-num = ? then do:
      976       message
      977         "Не установлен номер БД в которой будет действовать этот параметр!" skip
      978         view-as alert-box error .
      979       apply "entry":U to f-db-num in frame d-cnf.
      980       return no-apply.
      981     end.
      982     if f-obj-type <> "":U
      983       or f-obj-code <> 0
      984     then do:
      985       apply "leave" to f-obj-code in frame d-cnf.
      986     end.
      987     find first buf_cnf no-lock
      988       where buf_cnf.db-num     = f-db-num
      989         and buf_cnf.param-code = f-param-code
      990         and buf_cnf.beg-date   = f-beg-date
      991         and buf_cnf.end-date   = f-end-date
      992         and buf_cnf.host-code  = v-host-code
      993         and buf_cnf.obj-type   = f-obj-type
      994         and buf_cnf.obj-code   = f-obj-code
      995         and rowid( buf_cnf ) <> rowid( cnf )
      996       no-error
      997     .
      998     if available buf_cnf then do:
      999       assign
     1000         v-msg = substitute( "Уже есть параметр &1 для БД &2&3"
     1001                             ,f-param-code
     1002                             ,f-db-num
     1003                             ,chr(10)
     1004                           )
     1005       .
     1006       if t-beg-date = true
     1007         and t-end-date = true
     1008       then do:
     1009         assign
     1010           v-msg = v-msg + substitute( "с неограниченным периодом действия" )
     1011         .
     1012       end.
     1013       else do:
     1014         assign
     1015           v-msg = v-msg + substitute( "с периодом действия&1", chr(32) )
     1016         .
     1017         if t-beg-date <> true then do:
     1018           assign
     1019             v-msg = v-msg + substitute( "c &1&2", f-beg-date, chr(32) )
     1020           .
     1021         end.
     1022         if t-end-date <> true then do:
     1023           assign
     1024             v-msg = v-msg + substitute( "по &1&2", f-end-date, chr(32) )
     1025           .
     1026         end.
     1027       end.
     1028       assign
     1029         v-msg = v-msg + substitute( "&1", chr(10) )
     1030       .
     1031       message
     1032         v-msg skip
     1033         view-as alert-box error .
     1034       apply "entry":U to f-db-num in frame d-cnf.
     1035       return no-apply.
     1036     end.
     1037     do transaction
     1038     on error undo, return no-apply
     1039     :
     1040       assign
     1041         cnf.db-num      = f-db-num
     1042         cnf.db-key      = f-db-key
     1043         cnf.param-value = if f-param-code = "tsd-list" then f-param-value-2 else f-param-value
     1044         cnf.beg-date    = f-beg-date
     1045         cnf.end-date    = f-end-date
     1046         cnf.host-code   = v-host-code
     1047         cnf.obj-type    = f-obj-type
     1048         cnf.obj-code    = f-obj-code
     1049         cnf.NotUsed     = false
     1050       .
     1051     end.
     1052   END.
     1053   ON CHOOSE OF b-quit IN FRAME d-cnf
     1054   DO:
     1055     assign
     1056       ri = ?
     1057     .
     1058   END.
     1059   ON CHOOSE OF btn_dwl IN FRAME d-cnf
     1060   DO:
     1061     def var v-outstr as char no-undo.
     1062     run adm/xlssn.p
     1063       (output v-outstr) no-error.
     1064     if length (v-outstr) > 31000
     1065     then do:
     1066       message "Превышена длинна значения, не возможно загрузить даенные" view-as alert-box information.
     1067     end.
     1068     else do:
     1069       f-param-value-2 = v-outstr.
     1070       f-param-value-2:screen-value = v-outstr.
     1071     end.
     1072   END.
     1073   ON RETURN OF f-db-key IN FRAME d-cnf
     1074   DO:
     1075     apply "TAB" to self.
     1076   END.
     1077   ON LEAVE OF f-db-num IN FRAME d-cnf
     1078   DO:
     1079     define variable v-new-key as character no-undo .
     1080     assign
     1081       f-db-num
     1082     .
     1083     if f-db-num <> ? then do:
     1084       run check-db-key in this-procedure
     1085         ( input  f-db-num
     1086         , output v-new-key
     1087         ).
     1088       if v-new-key <> ?
     1089         and v-new-key <> "?":U
     1090       then do:
     1091         assign
     1092           f-db-key = trim( v-new-key )
     1093         .
     1094         display
     1095           f-db-key
     1096           with frame d-cnf
     1097         .
     1098       end.
     1099     end.
     1100   END.
     1101   ON RETURN OF f-db-num IN FRAME d-cnf
     1102   DO:
     1103     apply "TAB" to self.
     1104   END.
     1105   ON RETURN OF f-host-name IN FRAME d-cnf
     1106   DO:
     1107     apply "TAB" to self.
     1108   END.
     1109   ON VALUE-CHANGED OF f-host-name IN FRAME d-cnf
     1110   DO:
     1111     assign
     1112       f-host-name
     1113     .
     1114     assign
     1115       v-host-code = integer(substr(f-host-name, 1, 6))
     1116     .
     1117     if v-obj-host-code <> v-host-code
     1118     and f-obj-code:sensitive in frame d-cnf
     1119     then do:
     1120        run clr-ref-object ("").
     1121     end.
     1122   END.
     1123   ON LEAVE OF f-obj-code IN FRAME d-cnf
     1124   OR RETURN OF f-obj-code IN FRAME d-cnf
     1125   DO:
     1126       assign
     1127         f-obj-code
     1128       .
     1129       run disp-obj in this-procedure
     1130         ( input ?
     1131          ,input f-obj-code
     1132          ,input f-obj-type
     1133         ) no-error .
     1134       if error-status :error then do:
     1135         apply "CHOOSE" to b-clients.
     1136         return.
     1137       end.
     1138       if valid-handle (db-hdl)
     1139       then do:
     1140         run chk-host-code in db-hdl (f-obj-type, f-obj-code, output v-obj-host-code).
     1141         if v-obj-host-code = ?
     1142         then do:
     1143           run clr-ref-object (return-value).
     1144         end.
     1145         else do:
     1146           if v-host-code <> v-obj-host-code
     1147           then do:
     1148             if v-host-code <> 0
     1149             then do:
     1150                 message "Выбранный объект относится к другой фирме " skip
     1151                         "Заменить привязку к фирме?"
     1152                 view-as alert-box buttons yes-no update clr-object as logical.
     1153             end.
     1154             if clr-object = true
     1155             or v-host-code = 0
     1156             then do:
     1157               assign
     1158                 v-host-code = v-obj-host-code
     1159               .
     1160               find first ub.clients no-lock
     1161                 where ub.clients.obj-code = v-obj-host-code
     1162                   and ub.clients.obj-type = 'орг':U
     1163                 no-error.
     1164               assign
     1165                 f-host-name = substitute( "&1  &2", string(ub.clients.obj-code, "999999999"), ub.clients.obj-name )
     1166               .
     1167               display
     1168                 f-host-name
     1169                 with frame d-cnf.
     1170             end.
     1171           end.
     1172         end.
     1173       end.
     1174   END.
     1175   ON RETURN OF f-obj-type IN FRAME d-cnf
     1176   DO:
     1177     apply "TAB" to self.
     1178   END.
     1179   ON VALUE-CHANGED OF f-obj-type IN FRAME d-cnf
     1180   DO:
     1181       assign
     1182         f-obj-type
     1183       .
     1184       if f-obj-type = ""
     1185       then do:
     1186         assign
     1187           v-types = 'все':U
     1188         .
     1189       end.
     1190       else do:
     1191         assign
     1192           v-types = f-obj-type
     1193         .
     1194       end.
     1195       run uf-get in this-procedure
     1196         ( input  'cli-all-p':U
     1197          ,input  v-cntxt-userid
     1198          ,output v-uf-List_
     1199          ,output v-uf-Naim
     1200          ,output v-uf-print-graft
     1201          ,output v-uf-sort-gr
     1202          ,output v-uf-type-price
     1203          ,output v-uf-type-val
     1204         ) no-error.
     1205       if not error-status:error
     1206       then do:
     1207         assign
     1208           entry(1, v-uf-List_, chr(4)) = v-types
     1209         .
     1210       end.
     1211       else do:
     1212         assign
     1213           v-uf-List_ = v-types + fill(chr(4), 5)
     1214         .
     1215       end.
     1216       run uf-set in this-procedure
     1217         ( input 'cli-all-p':U
     1218          ,input v-cntxt-userid
     1219          ,input v-uf-List_
     1220          ,input v-uf-Naim
     1221          ,input v-uf-print-graft
     1222          ,input v-uf-sort-gr
     1223          ,input v-uf-type-price
     1224          ,input v-uf-type-val
     1225         ) no-error.
     1226   END.
     1227   ON LEAVE OF f-param-value IN FRAME d-cnf
     1228   DO:
     1229     define variable v-tmp-date        as date      no-undo .
     1230     define variable v-tmp-param-value as character no-undo .
     1231     assign
     1232       v-tmp-param-value = f-param-value:screen-value
     1233     .
     1234     if v-tmp-param-value = ? then do:
     1235       assign
     1236         v-tmp-param-value = "":U
     1237       .
     1238     end.
     1239     if cnf-struct.data-type = "date":U
     1240       and trim( v-tmp-param-value ) <> "":U
     1241     then do:
     1242       assign
     1243         v-tmp-date = date( v-tmp-param-value ) no-error
     1244       .
     1245       if error-status :error
     1246         or v-tmp-date = ?
     1247       then do:
     1248         message
     1249           "Значение параметра должно быть датой в формате число/месяц/год !" skip
     1250           substitute( "введено значение: &1", v-tmp-param-value ) skip
     1251           substitute( "после преобразования: &1", string( v-tmp-date, "99/99/9999" ) ) skip
     1252           view-as alert-box error .
     1253         apply "entry":U to f-param-value in frame d-cnf.
     1254         return no-apply.
     1255       end.
     1256       else do:
     1257         assign
     1258           f-param-value = string( v-tmp-date, "99/99/9999" )
     1259         .
     1260         display
     1261           f-param-value
     1262           with frame d-cnf
     1263           .
     1264         if v-tmp-param-value <> f-param-value then do:
     1265           message
     1266             "Значение параметра преобразованно в соответствии с форматом даты число/месяц/год" skip
     1267             substitute( "введено значение: &1", v-tmp-param-value ) skip
     1268             substitute( "после преобразования: &1", f-param-value ) skip
     1269             view-as alert-box information .
     1270         end.
     1271       end.
     1272     end.
     1273   END.
     1274   ON RETURN OF f-param-value IN FRAME d-cnf
     1275   DO:
     1276     apply "TAB" to self.
     1277   END.
     1278   ON RETURN OF f-param-value-2 IN FRAME d-cnf
     1279   DO:
     1280     apply "TAB" to self.
     1281   END.
     1282   ON VALUE-CHANGED OF t-beg-date IN FRAME d-cnf
     1283   DO:
     1284     assign
     1285       t-beg-date
     1286     .
     1287     if t-beg-date = true
     1288     then do:
     1289       assign
     1290         f-beg-date = 01/01/1900
     1291       .
     1292       hide f-beg-date in frame d-cnf.
     1293     end.
     1294     else do:
     1295       assign
     1296         f-beg-date = ?
     1297       .
     1298       enable f-beg-date with frame d-cnf.
     1299     end.
     1300   END.
     1301   ON VALUE-CHANGED OF t-end-date IN FRAME d-cnf
     1302   DO:
     1303     assign
     1304       t-end-date
     1305     .
     1306     if t-end-date = true
     1307     then do:
     1308       assign
     1309         f-end-date = 01/01/9999
     1310       .
     1311       hide f-end-date in frame d-cnf.
     1312     end.
     1313     else do:
     1314       assign
     1315         f-end-date = ?
     1316       .
     1317       enable f-end-date with frame d-cnf.
     1318     end.
     1319   END.
     1320   if VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-cnf:PARENT eq ?
     1321   THEN FRAME d-cnf:PARENT = ACTIVE-WINDOW.
     1322   MAIN-BLOCK:
     1323   DO
     1324   ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1325   ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1326   :
     1327   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1328   on help of frame d-cnf
     1329   do:
     1330     run gbl/app_help.p
     1331       (input this-procedure :file-name
     1332       ,input ''
     1333       ,input ?
     1334       ) no-error.
     1335     if error-status :error then do:
     1336       message
     1337         "Ошибка при вызове помощи"
     1338         error-status :get-message(1)
     1339         view-as alert-box .
     1340     end.
     1341   end.
     1342   run minbtn-set in this-procedure .
     1343   on choose of b-help in frame d-cnf
     1344   do:
     1345     apply "help":u to frame d-cnf .
     1346   end.
     1347   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1348   procedure minbtn-set :
     1349       do
     1350           on error undo, return error return-value
     1351           :
     1352           define variable ii              as integer       no-undo .
     1353           define variable fh              as widget-handle no-undo .
     1354           define variable hh              as widget-handle no-undo .
     1355           define variable v-h             as handle        extent 4 no-undo .
     1356           define variable v-name-button   as character     no-undo .
     1357           define variable v-help-old-x    as decimal       no-undo .
     1358           define variable v-help-old-y    as decimal       no-undo .
     1359           define variable v-help-old-size as decimal       no-undo .
     1360           define variable v-frame-width   as decimal       no-undo .
     1361           define variable jj              as integer       no-undo .
     1362           do
     1363               on error undo, return error
     1364               :
     1365               assign
     1366                   v-frame-width = frame d-cnf:width - 0.3
     1367                   fh            = frame d-cnf:first-child
     1368                   hh            = fh:first-child
     1369                   ii            = 1
     1370                   .
     1371               do while valid-handle(hh):
     1372                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1373                   do:
     1374                       case lc(hh:name) :
     1375                           when "b-help" then
     1376                               do:
     1377                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1378                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1379                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1380                                   hh:TOOLTIP = "Помощь" .
     1381                                   v-help-old-x = hh:column .
     1382                                   v-help-old-y = hh:row    .
     1383                                   v-help-old-size = hh:width .
     1384                                   hh:width-chars = 2.5 .
     1385                               end.
     1386                           when "b-print" then
     1387                               do:
     1388                                   hh:load-image("cmp/b-print.bmp":u) .
     1389                                   hh:TOOLTIP = "Печать" .
     1390                                   v-h[ii] = hh:handle .
     1391                                   ii = ii + 1 .
     1392                                   hh:width-chars = 3 .
     1393                               end.
     1394                           when "b-history" or
     1395                           when "b-hist" then
     1396                               do:
     1397                                   hh:load-image("cmp/b-hist.bmp":u) .
     1398                                   hh:TOOLTIP = "История" .
     1399                                   v-h[ii] = hh:handle .
     1400                                   ii = ii + 1 .
     1401                                   hh:width-chars = 3 .
     1402                               end.
     1403                           when "b-sch" then
     1404                               do:
     1405                                   hh:load-image("cmp/b-sch.bmp":u) .
     1406                                   hh:TOOLTIP = "Установка Фильтра" .
     1407                                   v-h[ii] = hh:handle .
     1408                                   ii = ii + 1 .
     1409                                   hh:width-chars = 3 .
     1410                               end.
     1411                           when "b-hist-user" then
     1412                               do:
     1413                                   hh:load-image("cmp/b-hist.bmp":u) .
     1414                                   hh:TOOLTIP = "История пользователя" .
     1415                                   ii = ii + 1 .
     1416                               end.
     1417                       end case.
     1418                   end.
     1419                   hh = hh:next-sibling.
     1420               end.
     1421               b-help:column = v-frame-width - b-help:width-chars.
     1422               jj = 0.
     1423               repeat ii = 4 to 1 by -1 :
     1424                   if valid-handle (v-h[ii] ) then
     1425                   do:
     1426                       jj  = jj + 1 .
     1427                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1428                       v-h[ii]:row    = v-help-old-y .
     1429                   end.
     1430               end.
     1431           end.
     1432       end.
     1433   end procedure.
     1434   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1435   on ' ' of f-beg-date in frame d-cnf
     1436   do:
     1437     if (can-query (self, "sensitive")
     1438        and
     1439        self :sensitive = true
     1440        )
     1441     or (can-query (self, "read-only")
     1442        and
     1443        self :read-only = false
     1444        )
     1445     then do:
     1446       assign
     1447         self :screen-value = ?
     1448       .
     1449     end.
     1450     return no-apply.
     1451   end.
     1452   on delete-character of f-beg-date in frame d-cnf
     1453   do:
     1454     if (can-query (self, "sensitive")
     1455        and
     1456        self :sensitive = true
     1457        )
     1458     or (can-query (self, "read-only")
     1459        and
     1460        self :read-only = false
     1461        )
     1462     then do:
     1463       assign
     1464         self :screen-value = ?
     1465       .
     1466     end.
     1467     return no-apply.
     1468   end.
     1469   on ctrl-d of f-beg-date in frame d-cnf
     1470   do:
     1471     define variable v-curr-sv-date as date no-undo .
     1472     if (can-query (self, "sensitive")
     1473        and
     1474        self :sensitive = true
     1475        )
     1476     or (can-query (self, "read-only")
     1477        and
     1478        self :read-only = false
     1479        )
     1480     then do:
     1481       if self :handle <> focus :handle
     1482       then do:
     1483         apply "entry":u to self .
     1484       end.
     1485       run gbl/getcurdt.p
     1486         (output v-curr-sv-date
     1487         ) .
     1488       assign
     1489         self :screen-value = string(v-curr-sv-date) .
     1490       .
     1491     end.
     1492     return no-apply.
     1493   end.
     1494   on ctrl-b of f-beg-date in frame d-cnf
     1495   do:
     1496     if (can-query (self, "sensitive")
     1497        and
     1498        self :sensitive = true
     1499        )
     1500     or (can-query (self, "read-only")
     1501        and
     1502        self :read-only = false
     1503        )
     1504     then do:
     1505       if self :handle <> focus :handle
     1506       then do:
     1507         apply "entry":u to self .
     1508       end.
     1509       define variable v-curr-sv-date as date no-undo .
     1510       define variable v-new-sv-date  as date no-undo .
     1511       assign
     1512         v-curr-sv-date = date(self :screen-value) no-error
     1513       .
     1514       if v-curr-sv-date = ?
     1515       then do:
     1516         run gbl/getcurdt.p
     1517           (output v-curr-sv-date
     1518           ) .
     1519       end.
     1520       if v-curr-sv-date <> ?
     1521       then do:
     1522         assign
     1523           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1524         .
     1525         assign
     1526           self :screen-value = string(v-new-sv-date) .
     1527         .
     1528       end.
     1529     end.
     1530     return no-apply .
     1531   end.
     1532   on ctrl-e of f-beg-date in frame d-cnf
     1533   do:
     1534     if (can-query (self, "sensitive")
     1535        and
     1536        self :sensitive = true
     1537        )
     1538     or (can-query (self, "read-only")
     1539        and
     1540        self :read-only = false
     1541        )
     1542     then do:
     1543       if self :handle <> focus :handle
     1544       then do:
     1545         apply "entry":u to self .
     1546       end.
     1547       define variable v-curr-sv-date as date no-undo .
     1548       define variable v-new-sv-date  as date no-undo .
     1549       assign
     1550         v-curr-sv-date = date(self :screen-value) no-error
     1551       .
     1552       if v-curr-sv-date = ?
     1553       then do:
     1554         run gbl/getcurdt.p
     1555           (output v-curr-sv-date
     1556           ) .
     1557       end.
     1558       if v-curr-sv-date <> ?
     1559       then do:
     1560         run gbl/lastdate.p
     1561           (input  v-curr-sv-date
     1562           ,output v-new-sv-date
     1563           ).
     1564         assign
     1565           self :screen-value = string(v-new-sv-date) .
     1566         .
     1567       end.
     1568     end.
     1569     return no-apply .
     1570   end.
     1571   on ctrl-f of f-beg-date in frame d-cnf
     1572   do:
     1573     if (can-query (self, "sensitive")
     1574        and
     1575        self :sensitive = true
     1576        )
     1577     or (can-query (self, "read-only")
     1578        and
     1579        self :read-only = false
     1580        )
     1581     then do:
     1582       if self :handle <> focus :handle
     1583       then do:
     1584         apply "entry":u to self .
     1585       end.
     1586       define variable v-ok            as logical   no-undo .
     1587       define variable v-curr-sv-date  as date      no-undo .
     1588       define variable v-description   as character no-undo .
     1589       assign
     1590         v-curr-sv-date = date(self :screen-value) no-error
     1591       .
     1592       if v-curr-sv-date = ?
     1593       then do:
     1594         run gbl/getcurdt.p
     1595           (output v-curr-sv-date
     1596           ) .
     1597       end.
     1598       if v-curr-sv-date <> ?
     1599       then do:
     1600         run gbl/d-inpday.w
     1601           (input ?
     1602           ,input "Выбор даты"
     1603           ,input v-description
     1604           ,input ""
     1605           ,input-output v-curr-sv-date
     1606           ,output v-ok
     1607           ).
     1608         if v-ok = true
     1609         then do:
     1610           assign
     1611             self :screen-value = string(v-curr-sv-date) .
     1612           .
     1613         end.
     1614       end.
     1615     end.
     1616     return no-apply .
     1617   end.
     1618     define MENU m-ed-date7
     1619       MENU-ITEM m-ed-date7-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1620       MENU-ITEM m-ed-date7-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
