        1   define input        parameter parparentproc as widget-handle no-undo .
        2   define input        parameter Cnf-hdl       as handle        no-undo .
        3   define input        parameter db-hdl        as handle        no-undo .
        4   define input        parameter str-hdl       as handle        no-undo .
        5   define input        parameter p-action      as character     no-undo .
        6   define input-output parameter ri            as integer       no-undo init ?.
        7   def var vss-revision    as character no-undo init "$Revision$":U .
        8   def var vss-author      as character no-undo init "$Author$":U .
        9   def var vss-date        as character no-undo init "$Date$":U .
       10   def var vss-workfile    as character no-undo init "$Workfile$":U .
       11   def var vss-archive     as character no-undo init "$Archive$":U .
       12   def var vss-description as character no-undo init "Просмотр и корректировка системных настроек".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define  shared temp-table cnf no-undo
       72       field param-code    as character   format "x(8)"        column-label "Код"                               field param-type    as character                        column-label "Тип"                               field param-value   as character   format "x(250)"      column-label "Значение"                          field param-encoded as character                        column-label "Кодированное значение"             field host-code     as integer                          column-label "Фирма"                             field obj-type      as character                        column-label "Тип объекта"                       field obj-code      as integer     format ">>>>>>"      column-label "Код объекта"                       field conf-type     as character                        column-label "Кодировка"                         field beg-date      as date                             column-label "Начало действия параметра"         field end-date      as date                             column-label "Окончание действия параметра"      field db-num        as integer     format ">>>>>"       column-label "БД"                                field stts          as integer                          column-label "Статус"
       73       field db-key        as character   format "x(12)"       column-label "Ключ БД"
       74       field param-PS      as character   format "x(40)"       column-label "PS"
       75       field param-name    as character   format "x(30)"       column-label "Название"
       76       field is-changed    as logical initial false            column-label "Изменен"
       77       field NotUsed       as logical initial False            column-label "Выключен"
       78       field ErrorExist    as integer initial 0  format ">>"   column-label "Уровень ошибки"
       79       index pi
       80         is unique
       81         param-code
       82         host-code
       83         obj-type
       84         obj-code
       85         beg-date
       86         end-date
       87         db-num
       88       index db-num
       89         db-num
       90       index db-key
       91         db-key
       92       index par-name
       93         is word-index
       94         param-name
       95       index par-value
       96         is word-index
       97         param-value
       98    .
       99   def  shared temp-table log-table no-undo
      100       field stroka       as character format "x(256)".
      101   def  shared variable err-level as integer no-undo.
      102   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      103   define  shared temp-table cnf-struct no-undo
      104     field param-code    as character
      105     field param-type    as character
      106     field data-type     as character
      107     field param-name    as character
      108     field attach-type   as character
      109     field list-value    as character
      110     field default-value as character
      111     field PS            as character
      112     field param-group   as character
      113     field user-resp     as character
      114     index by-code is unique param-code
      115   .
      116   define temp-table t_cnf-struct no-undo like cnf-struct .
      117   define stream TxtStream.
      118   define stream temp-stream .
      119   function coding-user-resp returns character
      120     ( input p-param-code as character
      121      ,input p-user-resp  as character
      122     )
      123   :
      124     return encode( p-param-code + p-user-resp ) .
      125   end function.
      126   function decoding-user-resp returns character
      127     ( input p-param-code as character
      128      ,input p-code-usr   as character
      129     )
      130   :
      131     define variable v-ind         as integer   no-undo .
      132     define variable v-user-list   as character no-undo .
      133     define variable v-num-entries as integer   no-undo .
      134     define variable v-user-resp   as character no-undo .
      135     assign
      136       v-user-list   = "Бахтадзе,Булгаков,Белоусов,Гюнтнер,Исаков,Перваков,Суслов,Уханов,Чернова,Кочетков,Степанов,Хныкин,Гридчина,Шальнев,Сливенко,Харитонов,Кирюхин,Морозов"
      137       v-num-entries = num-entries( v-user-list )
      138       v-user-resp   = "":U
      139     .
      140     block_do:
      141     do v-ind = 1 to v-num-entries :
      142       if encode( p-param-code + entry( v-ind, v-user-list ) ) = p-code-usr then do:
      143         assign
      144           v-user-resp = entry( v-ind, v-user-list )
      145         .
      146         leave block_do.
      147       end.
      148     end.
      149     if v-user-resp = "":U then do:
      150       message
      151         vss-include-info0 skip
      152         substitute( "Невозможно распознать ответственного за параметр <&1>!",  p-param-code) skip
      153         substitute( "Возможно его нет в списке." ) skip
      154         view-as alert-box error
      155       .
      156       return "unknown":U.
      157     end.
      158     else do:
      159       return v-user-resp .
      160     end.
      161   end function.
      162   function sum-enc returns character (str as character, num-rev as integer).
      163      define variable rev_incl_s as character init "" no-undo .
      164      define variable rev_incl_i as integer no-undo .
      165      define variable rev_incl_l as integer no-undo .
      166      rev_incl_l = length(str).
      167      do rev_incl_i = 1 to rev_incl_l:
      168         if rev_incl_i <= num-rev
      169           or rev_incl_l - rev_incl_i < num-rev
      170         then do:
      171           assign
      172             rev_incl_s = rev_incl_s + substr(str, rev_incl_l - rev_incl_i + 1, 1)
      173           .
      174         end.
      175         else do:
      176           assign
      177             rev_incl_s = rev_incl_s + substr(str, rev_incl_i, 1)
      178           .
      179         end.
      180      end.
      181      return rev_incl_s.
      182   end.
      183   procedure check-cfg :
      184     define input-output parameter p-param-code    as character no-undo .
      185     define input-output parameter p-param-type    as character no-undo .
      186     define input-output parameter p-data-type     as character no-undo .
      187     define input-output parameter p-param-name    as character no-undo .
      188     define input-output parameter p-attach-type   as character no-undo .
      189     define input-output parameter p-list-value    as character no-undo .
      190     define input-output parameter p-default-value as character no-undo .
      191     define input-output parameter p-param-PS      as character no-undo .
      192     define input-output parameter p-param-group   as character no-undo .
      193     define input-output parameter p-user-resp     as character no-undo .
      194     do
      195     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      196     on stop   undo, return error substitute( "&1. stop", vss-include-info0 )
      197     on endkey undo, return error substitute( "&1. endkey", vss-include-info0 )
      198     :
      199       define variable v-ind as character no-undo .
      200       assign
      201         p-param-code    = trim( p-param-code )
      202         p-param-type    = trim( p-param-type )
      203         p-data-type     = trim( p-data-type )
      204         p-param-name    = trim( p-param-name )
      205         p-attach-type   = trim( p-attach-type )
      206         p-list-value    = trim( p-list-value )
      207         p-default-value = trim( p-default-value )
      208         p-param-PS      = trim( p-param-PS )
      209         p-param-group   = trim( p-param-group )
      210         p-user-resp     = trim( p-user-resp )
      211       .
      212       if p-param-code = "":U then do:
      213         undo, return error substitute( "&1. Не задана метка параметра", vss-include-info0 ).
      214       end.
      215       if length( p-param-code ) > 8 then do:
      216         undo, return error substitute( "&1. Длина метки параметра не может превышать 8 символов (&2)", vss-include-info0, p-param-code ).
      217       end.
      218       if lookup( p-param-type, ',о,к,п':U ) = 0 then do:
      219         undo, return error substitute( '&1. Значение типа настройки "&2" не допустимо (&3)', vss-include-info0, p-param-type, p-param-code ).
      220       end.
      221       if lookup( p-param-type, 'к,п':U ) <> 0
      222         and lookup( p-attach-type, 'Нет':U ) = 0
      223       then do:
      224         undo, return error substitute( '&1. Для параметров с типом "&2" допустимы только привязки "&3" (&4)', vss-include-info0, 'к,п':U, 'Нет':U, p-param-code ).
      225       end.
      226       if p-param-name = "":U then do:
      227         undo, return error substitute( "&1. Не задано название параметра &2", vss-include-info0, p-param-code  ).
      228       end.
      229       if lookup( entry( 1, p-data-type ), "logical,integer,decimal,date,character":U ) = 0
      230         or num-entries( p-data-type ) > 2
      231         or ( num-entries( p-data-type ) = 2
      232              and entry( 2, p-data-type ) <> "list":U
      233            )
      234       then do:
      235         undo, return error substitute( "&1. Значение типа параметра &2 не допустимо (&3)", vss-include-info0, p-data-type, p-param-code ).
      236       end.
      237       if lookup( p-attach-type, 'Нет,Фирма,Объект':U ) = 0
      238       then do:
      239         undo, return error substitute( '&1. Значение привязки "&2" не допустимо (&3)', vss-include-info0, p-attach-type, p-param-code ).
      240       end.
      241     end.
      242     return.
      243   end procedure.
      244   procedure fill-cnf-struct :
      245     define input parameter p-file-name as character no-undo .
      246     do
      247     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      248     on stop   undo, return error substitute( "&1. stop", vss-workfile )
      249     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      250     :
      251       define variable v-file-name as character no-undo .
      252       define variable v-counter as integer   no-undo .
      253       define variable v-temp-fname       as character           no-undo.
      254       define variable v-last-key         as integer             no-undo .
      255       define variable v-new-line         as integer             no-undo .
      256       define variable v-read-chksum      as logical             no-undo .
      257       define variable v-md5-signature-av as character           no-undo .
      258       define variable v-md5-signature    as character           no-undo .
      259       define frame inf-cfg
      260         v-counter label "Просмотрено"
      261         with view-as dialog-box side-labels 1 columns three-d title ""
      262       .
      263       assign
      264         v-file-name = search( p-file-name )
      265       .
      266       if v-file-name = ""
      267         or v-file-name = ?
      268       then do:
      269         return error substitute( "&1. Не задан файл схемы конфигурации!", vss-include-info0 ).
      270       end.
      271       assign
      272         v-last-key         = 0
      273         v-read-chksum      = false
      274         v-md5-signature-av = "":U
      275         file-info:file-name = ".":U
      276         v-temp-fname = substitute( "&1\&2-&3-&4.tmp", file-info:full-pathname, time, etime, random( 1111111 , 9999999 ) )
      277       .
      278       input stream TxtStream from value( v-file-name ).
      279       output stream temp-stream to value(v-temp-fname) .
      280       block_read:
      281       repeat while v-last-key <> -2
      282       on error undo, return error
      283       :
      284         readkey stream TxtStream pause 0.
      285         assign
      286           v-last-key = lastkey
      287         .
      288         if chr( v-last-key ) = chr(1) then do:
      289           assign
      290             v-read-chksum = true
      291           .
      292         end.
      293         else do:
      294           if v-read-chksum = true then do:
      295             if v-last-key = 13 then do:
      296               leave block_read.
      297             end.
      298             else do:
      299               assign
      300                 v-md5-signature-av = v-md5-signature-av + chr( v-last-key )
      301               .
      302             end.
      303           end.
      304           else do:
      305             if v-last-key = 13 then do:
      306               put stream temp-stream skip(v-new-line).
      307               assign
      308                 v-new-line = 1
      309               .
      310             end.
      311             else do:
      312               put stream temp-stream unformatted chr( v-last-key ).
      313               assign
      314                 v-new-line = 0
      315               .
      316             end.
      317           end.
      318         end.
      319       end.
      320       output stream temp-stream close.
      321       input stream TxtStream close.
      322       run gbl/md5.p
      323         ( input  search( v-temp-fname )
      324          ,output v-md5-signature
      325         ) no-error.
      326       if error-status :error then do:
      327         return error substitute("Ошибка при подсчете контрольной суммы текстового файла схемы &1", v-file-name ) .
      328       end.
      329       os-delete value( v-temp-fname ).
      330       assign
      331         v-md5-signature = sum-enc( v-md5-signature, 8 )
      332       .
      333       if v-md5-signature-av <> v-md5-signature then do:
      334         return error substitute( "Некорректная контрольная сумма текстового файла схемы &1", v-file-name ) .
      335       end.
      336       input stream TxtStream from value( v-file-name ).
      337       assign
      338         v-counter = 0
      339       .
      340       assign
      341         frame inf-cfg:title = "Чтение параметров конфигурации"
      342       .
      343       view frame inf-cfg.
      344       for each t_cnf-struct:
      345         delete t_cnf-struct.
      346       end.
      347       create t_cnf-struct no-error.
      348       read-cycle:
      349       repeat transaction
      350       on error  undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      351       :
      352         assign
      353           v-counter = v-counter + 1
      354         .
      355         if ( v-counter modulo 10 ) = 0 then do:
      356           display
      357             v-counter
      358             with frame inf-cfg.
      359         end.
      360         import stream TxtStream delimiter '`':U t_cnf-struct.param-code t_cnf-struct.param-type t_cnf-struct.data-type t_cnf-struct.param-name t_cnf-struct.attach-type t_cnf-struct.list-value t_cnf-struct.default-value t_cnf-struct.PS t_cnf-struct.param-group t_cnf-struct.user-resp no-error.
      361         if error-status:error then do:
      362           return error substitute( "&1. Ошибка при чтении текстового файла схемы! Cтрока &1. (&2)", vss-include-info0, v-counter, error-status :get-message ( error-status :num-messages ) ).
      363         end.
      364         else do:
      365           if not ( t_cnf-struct.param-code begins chr(1) ) then do:
      366             assign
      367               t_cnf-struct.user-resp = decoding-user-resp( t_cnf-struct.param-code, t_cnf-struct.user-resp )
      368             .
      369             if t_cnf-struct.user-resp = "unknown":U then do:
      370               return error substitute( "&1. Ошибка параметра! Cтрока &2.", vss-include-info0, v-counter ).
      371             end.
      372             run check-cfg in this-procedure
      373               ( input-output t_cnf-struct.param-code
      374               ,input-output t_cnf-struct.param-type
      375               ,input-output t_cnf-struct.data-type
      376               ,input-output t_cnf-struct.param-name
      377               ,input-output t_cnf-struct.attach-type
      378               ,input-output t_cnf-struct.list-value
      379               ,input-output t_cnf-struct.default-value
      380               ,input-output t_cnf-struct.PS
      381               ,input-output t_cnf-struct.param-group
      382               ,input-output t_cnf-struct.user-resp
      383               ) no-error .
      384             if error-status :error then do:
      385               return error substitute( "&1. Ошибка параметра! Cтрока &2. &3 (&4)", vss-include-info0, v-counter, return-value, error-status :get-message ( error-status :num-messages ) ).
      386             end.
      387             else do:
      388               find first cnf-struct
      389                 where cnf-struct.param-code = t_cnf-struct.param-code
      390                 no-error
      391               .
      392               if not available cnf-struct then do:
      393                 create cnf-struct .
      394               end.
      395               buffer-copy t_cnf-struct to cnf-struct .
      396             end.
      397           end.
      398         end.
      399       end.
      400       delete t_cnf-struct no-error.
      401       hide frame inf-cfg.
      402       input stream TxtStream close.
      403     end.
      404     return.
      405   end procedure.
      406   procedure proc-alt-shift-f2:
      407     if not ibs.th.gbl.gbl-var:rcode
      408   then
      409     run gbl\inidebug.p .
      410   end.
      411   procedure proc-alt-shift-f3:
      412     run gbl/prvssinf.p
      413       ( input this-procedure
      414       ) .
      415   end.
      416   define variable v-inform-launched as logical no-undo initial false .
      417   procedure proc-alt-shift-f4:
      418     define variable v-action as character no-undo .
      419     if v-inform-launched = false then do:
      420       assign
      421         v-inform-launched = true
      422       .
      423       run gbl/d-inform.w
      424         (  input self
      425         ,  input this-procedure
      426         , output v-action
      427         ) no-error .
      428       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      429       assign
      430         v-inform-launched = false
      431       .
      432     end.
      433   end.
      434   procedure proc-alt-f1:
      435     run gbl/corrhelp.p
      436       (input this-procedure
      437       ) .
      438   end .
      439   on alt-shift-f2 anywhere do:
      440     run proc-alt-shift-f2.
      441   end.
      442   on alt-shift-f3 anywhere do:
      443     run proc-alt-shift-f3 in this-procedure .
      444   end.
      445   on alt-shift-f4 anywhere do:
      446     run proc-alt-shift-f4 in this-procedure.
      447   end.
      448   on alt-f1 anywhere do:
      449     run proc-alt-f1 in this-procedure .
      450   end.
      451   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      452   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
      453   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
      454   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      455   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      456   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
      457   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
      458   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
      459   procedure uf-name :
      460     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      461     define output parameter p-use-List_     as logical   no-undo .
      462     define output parameter p-type-List_     as character no-undo .
      463     define output parameter p-format-List_   as character no-undo .
      464     define output parameter p-use-Naim      as logical   no-undo .
      465     define output parameter p-type-Naim      as character no-undo .
      466     define output parameter p-format-Naim    as character no-undo .
      467     define output parameter p-use-print-graft as logical   no-undo .
      468     define output parameter p-use-sort-gr   as logical   no-undo .
      469     define output parameter p-use-type-price as logical   no-undo .
      470     define output parameter p-use-type-val  as logical   no-undo .
      471     define output parameter p-label          as character no-undo .
      472     define output parameter p-tooltip        as character no-undo .
      473     define output parameter p-user-can-edit  as logical   no-undo .
      474     define output parameter p-output-display as logical   no-undo .
      475     define output parameter p-other          as character no-undo .
      476     do
      477     on error undo, return error
