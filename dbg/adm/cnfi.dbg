     1755   on ctrl-e of f-end-date in frame d-cnf
     1756   do:
     1757     if (can-query (self, "sensitive")
     1758        and
     1759        self :sensitive = true
     1760        )
     1761     or (can-query (self, "read-only")
     1762        and
     1763        self :read-only = false
     1764        )
     1765     then do:
     1766       if self :handle <> focus :handle
     1767       then do:
     1768         apply "entry":u to self .
     1769       end.
     1770       define variable v-curr-sv-date as date no-undo .
     1771       define variable v-new-sv-date  as date no-undo .
     1772       assign
     1773         v-curr-sv-date = date(self :screen-value) no-error
     1774       .
     1775       if v-curr-sv-date = ?
     1776       then do:
     1777         run gbl/getcurdt.p
     1778           (output v-curr-sv-date
     1779           ) .
     1780       end.
     1781       if v-curr-sv-date <> ?
     1782       then do:
     1783         run gbl/lastdate.p
     1784           (input  v-curr-sv-date
     1785           ,output v-new-sv-date
     1786           ).
     1787         assign
     1788           self :screen-value = string(v-new-sv-date) .
     1789         .
     1790       end.
     1791     end.
     1792     return no-apply .
     1793   end.
     1794   on ctrl-f of f-end-date in frame d-cnf
     1795   do:
     1796     if (can-query (self, "sensitive")
     1797        and
     1798        self :sensitive = true
     1799        )
     1800     or (can-query (self, "read-only")
     1801        and
     1802        self :read-only = false
     1803        )
     1804     then do:
     1805       if self :handle <> focus :handle
     1806       then do:
     1807         apply "entry":u to self .
     1808       end.
     1809       define variable v-ok            as logical   no-undo .
     1810       define variable v-curr-sv-date  as date      no-undo .
     1811       define variable v-description   as character no-undo .
     1812       assign
     1813         v-curr-sv-date = date(self :screen-value) no-error
     1814       .
     1815       if v-curr-sv-date = ?
     1816       then do:
     1817         run gbl/getcurdt.p
     1818           (output v-curr-sv-date
     1819           ) .
     1820       end.
     1821       if v-curr-sv-date <> ?
     1822       then do:
     1823         run gbl/d-inpday.w
     1824           (input ?
     1825           ,input "Выбор даты"
     1826           ,input v-description
     1827           ,input ""
     1828           ,input-output v-curr-sv-date
     1829           ,output v-ok
     1830           ).
     1831         if v-ok = true
     1832         then do:
     1833           assign
     1834             self :screen-value = string(v-curr-sv-date) .
     1835           .
     1836         end.
     1837       end.
     1838     end.
     1839     return no-apply .
     1840   end.
     1841     define MENU m-ed-date9
     1842       MENU-ITEM m-ed-date9-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1843       MENU-ITEM m-ed-date9-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1844       MENU-ITEM m-ed-date9-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1845       MENU-ITEM m-ed-date9-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1846       .
     1847     if f-end-date :POPUP-MENU in frame d-cnf = ?
     1848     then do:
     1849       ASSIGN
     1850         f-end-date :POPUP-MENU in frame d-cnf = MENU m-ed-date9 :HANDLE
     1851         f-end-date :MENU-MOUSE in frame d-cnf = 3
     1852       .
     1853     end.
     1854     define variable v-label-handle9 as handle no-undo .
     1855     assign
     1856       v-label-handle9 = f-end-date :side-label-handle in frame d-cnf
     1857     .
     1858     if valid-handle (v-label-handle9)
     1859     then do:
     1860       if v-label-handle9 :tooltip = ""
     1861       or v-label-handle9 :tooltip = ?
     1862       then do:
     1863         assign
     1864           v-label-handle9 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     1865         .
     1866       end.
     1867     end.
     1868     ON CHOOSE OF MENU-ITEM m-ed-date9-1 in menu m-ed-date9 DO:
     1869       apply "ctrl-b":U to f-end-date in frame d-cnf .
     1870     END.
     1871     ON CHOOSE OF MENU-ITEM m-ed-date9-2 in menu m-ed-date9 DO:
     1872       apply "ctrl-d":U to f-end-date in frame d-cnf .
     1873     END.
     1874     ON CHOOSE OF MENU-ITEM m-ed-date9-3 in menu m-ed-date9 DO:
     1875       apply "ctrl-e":U to f-end-date in frame d-cnf .
     1876     END.
     1877     ON CHOOSE OF MENU-ITEM m-ed-date9-4 in menu m-ed-date9 DO:
     1878       apply "ctrl-f":U to f-end-date in frame d-cnf .
     1879     END.
     1880     define variable v-num-entries as integer   no-undo .
     1881     define variable v-db-key      as character no-undo .
     1882     find first cnf
     1883       where recid( cnf ) = ri
     1884       no-error.
     1885     if not available cnf then do:
     1886       message
     1887         vss-workfile vss-revision vss-description skip
     1888         "Не передана ссылка на параметр!" skip
     1889         view-as alert-box error .
     1890       assign
     1891         ri = ?
     1892       .
     1893       return.
     1894     end.
     1895       if lookup (cnf.conf-type, 'к,п':U) > 0
     1896       and p-action <> "lkp":U
     1897       then do:
     1898         message
     1899           vss-workfile vss-revision vss-description skip
     1900           "Параметр закодирован. Изменение не допускается!" skip
     1901           view-as alert-box error .
     1902         return error.
     1903       end.
     1904     if cnf.errorexist > 0
     1905     then do:
     1906       run fill-default in cnf-hdl
     1907         ( buffer cnf
     1908         ).
     1909     end.
     1910     if not available cnf
     1911     then do:
     1912       message
     1913         vss-workfile vss-revision vss-description skip
     1914         "После исправления неверных привязок параметр удален, " skip
     1915         "так как дублирует уже существующий параметр" skip
     1916         view-as alert-box error .
     1917       assign
     1918         ri = -1
     1919       .
     1920       return.
     1921     end.
     1922     find first cnf-struct
     1923       where cnf-struct.param-code = cnf.param-code
     1924       no-error.
     1925     if not available cnf-struct
     1926     then do:
     1927       message
     1928         vss-workfile vss-revision vss-description skip
     1929         "Невозможно корректировать строку без описания параметра!" skip
     1930         view-as alert-box error .
     1931       assign
     1932         ri = ?
     1933       .
     1934       return.
     1935     end.
     1936     case cnf-struct.param-type:
     1937       when 'к':U then f-cnf-type = "(конфигурационный)".
     1938       when 'о':U then f-cnf-type = "(обязательный)".
     1939       when 'п':U then f-cnf-type = "(кодированный)".
     1940       when "":U       then f-cnf-type = "(необязательный)".
     1941       otherwise            f-cnf-type = "(такого типа не знаю!!!)".
     1942     end.
     1943     assign
     1944       f-db-num      = cnf.db-num
     1945       f-db-key      = cnf.db-key
     1946       f-param-code  = cnf.param-code
     1947       f-param-name  = cnf.param-name
     1948       f-param-ps    = cnf.param-ps
     1949       f-beg-date    = cnf.beg-date
     1950       f-end-date    = cnf.end-date
     1951       v-host-code   = cnf.host-code
     1952     .
     1953     if f-param-code = "tsd-list"
     1954       then assign f-param-value-2 = cnf.param-value.
     1955       else assign f-param-value = cnf.param-value.
     1956     if ( f-db-key = "" or f-db-key = ? )
     1957       and f-db-num <> ?
     1958     then do:
     1959       run check-db-key in this-procedure
     1960         ( input  f-db-num
     1961          ,output v-db-key
     1962         ).
     1963       if v-db-key <> ?
     1964         and v-db-key <> "?":U
     1965       then do:
     1966         assign
     1967           f-db-key = v-db-key
     1968         .
     1969       end.
     1970     end.
     1971     if lookup( cnf-struct.param-type, 'к,п':U ) > 0
     1972     then do:
     1973       assign
     1974         t-beg-date = false
     1975         t-end-date = false
     1976       .
     1977       if cnf.beg-date = 01/01/1900
     1978       or cnf.beg-date = ?
     1979       then do:
     1980         assign
     1981           t-beg-date = true
     1982         .
     1983       end.
     1984       if cnf.end-date = 01/01/9999
     1985         or cnf.end-date = ?
     1986       then do:
     1987         assign
     1988           t-end-date = true
     1989         .
     1990       end.
     1991     end.
     1992     else do:
     1993       assign
     1994         t-beg-date = true
     1995         t-end-date = true
     1996       .
     1997     end.
     1998     if trim( cnf-struct.list-value ) <> "":U
     1999     then do:
     2000       assign
     2001         v-num-entries = num-entries( cnf-struct.list-value )
     2002         f-param-value:list-items  = cnf-struct.list-value
     2003         f-param-value:subtype     = "drop-down-list":U
     2004         f-param-value:inner-lines = ( if v-num-entries <= 10 then v-num-entries else 10 )
     2005       .
     2006       if lookup( f-param-value, f-param-value:list-items ) = 0
     2007       then do:
     2008          if f-param-value <> ""
     2009          then do:
     2010            message
     2011              "значение параметра не соответствует списку возможных значений" skip
     2012              "значение заменено на первое из списка возможных." skip
     2013              view-as alert-box error .
     2014          end.
     2015          assign
     2016            f-param-value:screen-value = entry (1, f-param-value:list-items)
     2017          .
     2018       end.
     2019       else do:
     2020         assign
     2021           f-param-value:screen-value = f-param-value
     2022         .
     2023       end.
     2024     end.
     2025     else do:
     2026       if cnf-struct.data-type = "logical":U
     2027       then do:
     2028         assign
     2029           f-param-value:list-items  = "yes,no":U
     2030           f-param-value:subtype     = "drop-down-list":U
     2031           f-param-value:inner-lines = 2
     2032         .
     2033       end.
     2034       else do:
     2035         assign
     2036           f-param-value:screen-value = f-param-value
     2037           f-param-value:subtype      = "simple":U
     2038           f-param-value:inner-lines  = 0
     2039         .
     2040       end.
     2041     end.
     2042     RUN enable_UI.
     2043     run prepare-screen .
     2044     if f-obj-code:sensitive in frame d-cnf then do:
     2045       assign
     2046         f-obj-type = cnf.obj-type
     2047         f-obj-code = cnf.obj-code
     2048       .
     2049     end.
     2050     apply "value-changed" to t-beg-date in frame d-cnf.
     2051     apply "value-changed" to t-end-date in frame d-cnf.
     2052     if p-action = "lkp":U
     2053     then do:
     2054       disable
     2055         b-clients
     2056         b-exit
     2057         f-param-value
     2058         f-param-value-2
     2059         f-beg-date
     2060         t-beg-date
     2061         f-end-date
     2062         t-end-date
     2063         f-obj-type
     2064         f-obj-code
     2065         f-host-name
     2066         with frame d-cnf
     2067       .
     2068     end.
     2069     wait-for go of frame d-cnf.
     2070   end.
     2071   RUN disable_UI.
     2072   PROCEDURE check-db-key :
     2073   define input  parameter p-db-num as integer no-undo.
     2074     define output parameter p-db-key as character no-undo.
     2075     define buffer buf_cnf for cnf .
     2076     assign
     2077       p-db-key = ?
     2078     .
     2079     for first buf_cnf no-lock
     2080       where buf_cnf.db-num = p-db-num
     2081         and buf_cnf.db-key <> ?
     2082         and buf_cnf.db-key <> "":U
     2083     on error undo, return error return-value
     2084     :
     2085       assign
     2086         p-db-key = buf_cnf.db-key
     2087       .
     2088     end.
     2089   END PROCEDURE.
     2090   PROCEDURE clr-ref-object :
     2091     define input parameter par-mes as character format "x(80)" no-undo.
     2092     define variable clr-object as logical   no-undo .
     2093     if par-mes <> ""
     2094     then do:
     2095       message
     2096         par-mes skip
     2097         " Отменить привязку к объекту?" skip
     2098         view-as alert-box buttons yes-no update clr-object .
     2099     end.
     2100     if clr-object = true
     2101     or par-mes = ""
     2102     then do:
     2103       assign
     2104         f-obj-code = 0
     2105         f-obj-type = ""
     2106         f-obj-name = ""
     2107       .
     2108       display
     2109         f-obj-code
     2110         f-obj-type
     2111         f-obj-name
     2112         with frame d-cnf.
     2113     end.
     2114   END PROCEDURE.
     2115   PROCEDURE disable_UI :
     2116     HIDE FRAME d-cnf.
     2117   END PROCEDURE.
     2118   PROCEDURE disp-obj :
     2119     define input parameter par-recid    as recid     no-undo.
     2120     define input parameter par-obj-code as integer   no-undo.
     2121     define input parameter par-obj-type as character no-undo.
     2122       define variable ref-rec as recid no-undo.
     2123       define buffer buf_clients for ub.clients .
     2124       if par-recid <> ? then do:
     2125         find first buf_clients no-lock
     2126           where recid ( buf_clients ) = par-recid
     2127           no-error.
     2128       end.
     2129       else do:
     2130         find buf_clients no-lock
     2131           where buf_clients.obj-type = par-obj-type
     2132             and buf_clients.obj-code = par-obj-code
     2133           no-error .
     2134       end.
     2135       if not available buf_clients then do:
     2136         return error .
     2137       end.
     2138       if buf_clients.obj-type <> 'скл':U
     2139         and buf_clients.obj-type <> 'маг':U
     2140       then do:
     2141         message substitute( "Привязать параметр можно только к клиенту с типом '&1' или '&2'", 'маг':U, 'скл':U ) skip
     2142           view-as alert-box information .
     2143         return error .
     2144       end.
     2145       assign
     2146         f-obj-code = buf_clients.obj-code
     2147         f-obj-type = buf_clients.obj-type
     2148         f-obj-name = buf_clients.obj-name
     2149       .
     2150       display
     2151         f-obj-code
     2152         f-obj-type
     2153         f-obj-name
     2154         with frame d-cnf
     2155       .
     2156     return.
     2157   END PROCEDURE.
     2158   PROCEDURE enable_UI :
     2159     DISPLAY f-db-num f-db-key f-param-name f-param-ps f-param-value f-beg-date
     2160             t-beg-date f-end-date t-end-date f-obj-type f-obj-code f-host-name
     2161             f-param-code f-cnf-type f-obj-name
     2162         WITH FRAME d-cnf.
     2163     ENABLE b-exit b-quit b-help RECT-1 RECT-2 f-param-name f-param-ps
     2164            f-param-value btn_dwl f-obj-name
     2165         WITH FRAME d-cnf.
     2166   END PROCEDURE.
     2167   PROCEDURE Prepare-screen :
     2168   define variable v-ok as logical   no-undo .
     2169     define buffer buf_sysconf for ub.sysconf .
     2170     define buffer buf_clients for ub.clients .
     2171     if cnf-struct.attach-type = 'Фирма':U
     2172     or cnf-struct.attach-type = 'Объект':U
     2173     then do:
     2174       enable
     2175         f-host-name
     2176         with frame d-cnf
     2177       .
     2178       assign
     2179         v-ok = f-host-name:add-last ( substitute( "&1  Нет привязки", "000000" ) ) in frame d-cnf
     2180       .
     2181       for each buf_sysconf no-lock
     2182       on error undo, return error
     2183       :
     2184         find first buf_clients no-lock
     2185           where buf_clients.obj-code = buf_sysconf.host-code
     2186             and buf_clients.obj-type = 'орг':U
     2187           no-error.
     2188         assign
     2189           v-ok = f-host-name:add-last ( substitute( "&1  &2", string(buf_clients.obj-code, "999999999"), buf_clients.obj-name ) ) in frame d-cnf
     2190         .
     2191         if v-host-code = buf_sysconf.host-code
     2192         then do:
     2193           assign
     2194             f-host-name = substitute( "&1  &2", string(buf_clients.obj-code, "999999999"), buf_clients.obj-name )
     2195           .
     2196         end.
     2197       end.
     2198       if f-host-name = ""
     2199       then do:
     2200         assign
     2201           f-host-name = substitute( "&1  Нет привязки", "000000":U )
     2202         .
     2203       end.
     2204     end.
     2205     if cnf-struct.attach-type = 'Объект':U
     2206     then do:
     2207       enable
     2208         f-obj-code
     2209         f-obj-type
     2210         b-clients
     2211       with frame d-cnf.
     2212       assign
     2213         f-obj-type:list-items = 'скл':U + ",":U + 'маг':U
     2214       .
     2215       if f-obj-code > 0
     2216       then do:
     2217         run chk-host-code in db-hdl (input f-obj-type, input f-obj-code, output v-obj-host-code).
     2218         if v-obj-host-code <> v-host-code
     2219         then do:
     2220           run clr-ref-object ("Привязка к объекту противоречит привязке к фирме").
     2221         end.
     2222       end.
     2223       run disp-obj in this-procedure
     2224         ( input ?
     2225          ,input f-obj-code
     2226          ,input f-obj-type
     2227         ) no-error .
     2228       if error-status :error then do:
     2229       end.
     2230       apply "value-changed" to f-obj-type in frame d-cnf.
     2231     end.
     2232     else do:
     2233       if f-obj-type <> ""
     2234       then do:
     2235         run clr-ref-object ("Привязка к объекту не предусмотрена").
     2236       end.
     2237     end.
     2238   if f-param-code = "tsd-list" and p-action <> "lkp":U
     2239   then do:
     2240     enable
     2241       btn_dwl
     2242       f-param-value-2
     2243       with frame d-cnf.
     2244   end.
     2245   else do:
     2246     hide
     2247       btn_dwl
     2248       in frame d-cnf.
     2249   end.
     2250   if f-param-code = "tsd-list"
     2251   then do:
     2252     enable
     2253       f-param-value-2
     2254       with frame d-cnf.
     2255     f-param-value-2:screen-value = f-param-value-2.
     2256     hide
     2257       f-param-value
     2258       in frame d-cnf.
     2259   end.
     2260   else do:
     2261     hide
     2262       f-param-value-2
     2263       in frame d-cnf.
     2264   end.
     2265   END PROCEDURE.
