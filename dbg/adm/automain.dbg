      839   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      840   define variable v-uh6 as handle no-undo .
      841   define variable v-found6 as logical no-undo .
      842   v-uh6 = session:first-procedure no-error.
      843   do while valid-handle(v-uh6):
      844     if v-uh6:type = "PROCEDURE" then do:
      845       if v-uh6:file-name = "gbl/mainproc.p" then do:
      846         v-found6 = yes.
      847         leave.
      848       end.
      849     end.
      850     v-uh6 = v-uh6:next-sibling no-error.
      851   end.
      852   if not v-found6 then do:
      853     run gbl/mainproc.p persistent.
      854   end.
      855   procedure mainhandle_parentproc_indicator :
      856   return.
      857   end procedure.
      858   define variable mForExtsys as character no-undo.
      859   define variable mHiddenMode as logical no-undo.
      860   define variable mForDb as longchar no-undo.
      861   define variable mForProc as character no-undo.
      862   define variable mSessionBegin as logical no-undo init yes.
      863   define variable mListDb       as character no-undo.
      864   define variable mListDbAll    as character no-undo.
      865   define variable mListKey      as character no-undo.
      866   define variable mListKeyAll   as character no-undo.
      867   define temp-table tt-db no-undo
      868      field db-num as integer
      869      index pi is unique primary
      870       db-num ascending
      871   .
      872   define temp-table tt-extsys no-undo
      873      field extsys_id as integer
      874      index pi is unique primary
      875         extsys_id ascending
      876   .
      877   define temp-table tt-BatchProcess
      878    field BP_Type as char
      879    field CharKey_One as char
      880    field CharKey_Two as char
      881    field CharKey_Three as char
      882    field BP_ExecSysDate as date
      883    field BP_ExecSysTimeInt as int
      884    index dt BP_ExecSysDate BP_ExecSysTimeInt.
      885   function objExists return character
      886   (input  ifolder as character,
      887    input  iType   as character  ):
      888       define variable vFileType as character no-undo init "D,F".
      889       define variable vi        as integer no-undo.
      890       define variable vtype as character no-undo.
      891       if iType ne ?
      892       then
      893          vFileType = iType.
      894       do vi = 1 to num-entries(vFileType):
      895          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
      896          vtype = file-information:file-type.
      897          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
      898             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
      899             index(vtype , entry(vi,vFileType )) > 0
      900          then return file-information:full-pathname .
      901          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
      902          vtype = file-information:file-type.
      903          if file-information:file-name <> "" and
      904             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
      905             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
      906             index( vtype, entry(vi,vFileType )) > 0
      907          then return file-information:full-pathname .
      908       end.
      909       return ? .
      910   end.
      911   function SearchFile return character
      912   (input  ifile as character):
      913      return objExists(ifile,?).
      914   end.
      915   function SearchPFile return character
      916   (input inFile as char):
      917        define variable oFile       as character no-undo.
      918        define variable vFileSearch as character no-undo.
      919        define variable vNumEntry   as integer no-undo.
      920        if inFile = "" then return ?.
      921        vNumEntry = num-entries(inFile,".").
      922        vFileSearch = inFile.
      923        if    vNumEntry > 0
      924           and (   entry(vNumEntry,inFile,".") eq "p"
      925                or entry(vNumEntry,inFile,".") eq "w")
      926        then do:
      927           entry(vNumEntry,vFileSearch, ".") = "r".
      928           oFile = search(vFileSearch ).
      929           if oFile eq ?
      930           then
      931              oFile = search(inFile).
      932        end.
      933        else
      934           oFile = search(vFileSearch).
      935        return oFile.
      936     end.
      937   procedure initProcMode:
      938      define input  parameter iAutoTypeList as character no-undo.
      939      define input  parameter iMode as character no-undo.
      940      define variable v-ind as integer no-undo.
      941      if lookup( "H":U, iMode, "+":U ) = 0
      942      then do:
      943         mHiddenMode = false.
      944         run myenable in this-procedure
      945            ( input iAutoTypeList
      946            ) .
      947      end.
      948      else do:
      949         mHiddenMode = true.
      950      end.
      951      assign
      952         mForDb      = "":U
      953         mForExtsys  = "":U
      954      .
      955      block_db-list:
      956      do v-ind = 1 to num-entries( iMode, "+":U )
      957      :
      958         if entry( 1, entry( v-ind, imode, "+":U), ":":U ) = "DB":U
      959         then do:
      960            mForDb = entry( 2, entry( v-ind, imode, "+":U), ":":U ).
      961            for each tt-db
      962            :
      963              delete tt-db .
      964            end.
      965            run gbl/prcs-lst.p
      966               ( input mForDb
      967               , input 0
      968               , input 99999
      969               , input false
      970               , input (buffer tt-db:handle)
      971               , input "db-num":U
      972               ) no-error .
      973            mForDb = "".
      974            for each tt-db
      975            :
      976               mForDb = mForDb + ",":U + string( tt-db.db-num ).
      977               delete tt-db .
      978            end.
      979            mForDb = substring( mForDb, 2 ).
      980            leave block_db-list .
      981         end.
      982         if entry( 1, entry( v-ind, iMode, "+":U), ":":U ) = "ExtSys":U
      983         then do:
      984            mForExtsys = entry( 2, entry( v-ind, iMode, "+":U), ":":U ).
      985            for each tt-extsys
      986            :
      987               delete tt-extsys .
      988            end.
      989            run gbl/prcs-lst.p
      990               ( input mForExtsys
      991               , input 0
      992               , input 99999
      993               , input false
      994               , input (buffer tt-extsys:handle)
      995               , input "extsys_id":U
      996               ) no-error .
      997            mForExtsys = "".
      998            for each tt-extsys
      999            :
     1000               mForExtsys = mForExtsys + ";":U + string( tt-extsys.extsys_id ).
     1001               delete tt-extsys .
     1002            end.
     1003            mForExtsys = substring( mForExtsys, 2 ).
     1004            leave block_db-list .
     1005         end.
     1006         if entry( 1, entry( v-ind, iMode, "+":U), ":":U ) = "ProcName":U
     1007         then do:
     1008            mForProc = entry( 2, entry( v-ind, iMode, "+":U), ":":U ).
     1009            leave block_db-list .
     1010         end.
     1011      end.
     1012   end.
     1013   define variable mAsyncProcRun as logical no-undo.
     1014   procedure startproc:
     1015      define input  parameter iAutoType as character no-undo.
     1016      define input  parameter iListDb as character no-undo.
     1017      define input  parameter iListKey as character no-undo.
     1018      define input  parameter iStart as datetime-tz no-undo.
     1019      mStartTime = iStart.
     1020    define variable v-db-num as integer no-undo.
     1021    define variable v-ind as integer no-undo.
     1022    define variable v-num-entries-db-list as integer no-undo.
     1023    v-num-entries-db-list = num-entries(iListDb, chr(44))
     1024               .
     1025      case iAutoType :
     1026         when 'autonws':U
     1027         then do:
     1028            define variable mreadini as character no-undo.
     1029            define variable msesnws as integer no-undo.
     1030            get-key-value section "THAutoSessions" key "NumAsyncSessionsNWS" value mreadini.
     1031            assign
     1032               msesnws = 1
     1033               msesnws = integer (mreadini)
     1034            no-error.
     1035            if    mAsyncProcRun
     1036               or msesnws > 1
     1037            then do:
     1038               mAsyncHelper:maxproc = msesnws.
     1039               run bge/auto-nws.p
     1040                  (input iAutoType
     1041                  ,input this-procedure
     1042                  ,input iListDb
     1043               ) no-error.
     1044            end.
     1045            else do:
     1046               run nws/exch-nws.p
     1047                     (input this-procedure
     1048                     ,input g#auto-user-id
     1049                     ,input g#auto-user-password
     1050                     ,input iListDb
     1051                     ) no-error.
     1052            end.
     1053             if error-status :error
     1054               then do:
     1055                  run write-to-log in this-procedure
     1056                     (input vss-workfile + chr(32)
     1057                       + "Ошибка при запуске новостей" + chr(10)
     1058                       + error-status :get-message(error-status :num-messages) + chr(10)
     1059                       + return-value
     1060                  ) .
     1061               end.
     1062         end.
     1063         when 'mercury':U
     1064         then do:
     1065            run bge/auto-merc-asunc.p
     1066               (input iAutoType
     1067               ,input this-procedure
     1068               ,input iListDb
     1069            ) no-error.
     1070         end.
     1071         when 'is_motp':U
     1072         then do:
     1073            if mAsyncProcRun
     1074            then
     1075               run addtask (iAutoType,"utl\proc-anyproc.p",substitute ("&2&1&3&1&4&1&5&1&6",
     1076                                                   chr(4),
     1077                                                   "bge/auto-motp.p",
     1078                                                   g#auto-user-id,
     1079                                                   g#auto-user-password,
     1080                                                   iListDb,
     1081                                                   no)).
     1082            else
     1083               run bge/auto-motp.p
     1084                  (input g#auto-user-id
     1085                  ,input g#auto-user-password
     1086                  ,input iListDb
     1087                  ,input no
     1088               ) no-error.
     1089         end.
     1090         when 'is_diadoc':U
     1091         then do:
     1092            run bge/auto-diadoc.p
     1093               (input iAutoType
     1094               ,input this-procedure
     1095               , input iListDb
     1096               ) no-error.
     1097         end.
     1098         when 'hddtest':U
     1099         then do:
     1100            define variable Vdbinfo as char no-undo.
     1101            run adm/db-info.p ( output v-db-num, output Vdbinfo ) no-error.
     1102            if mAsyncProcRun
     1103            then
     1104               run addtask (iAutoType,"utl\proc-anyproc.p",substitute ("&2&1&3&1&4&1&5",
     1105                                                   chr(4),
     1106                                                   "bge/auto-hddtest.p",
     1107                                                   g#auto-user-id,
     1108                                                   g#auto-user-password,
     1109                                                   v-db-num)).
     1110            else
     1111               run bge/auto-hddtest.p
     1112                  (input g#auto-user-id
     1113                  ,input g#auto-user-password
     1114                  ,input v-db-num
     1115               ) no-error.
     1116         end.
     1117         when 'autoarh':U
     1118         then do:
     1119            do v-ind = 1 to v-num-entries-db-list
     1120            :
     1121               define variable v-rec-key as character no-undo.
     1122               define variable v-cre-db-num as integer no-undo.
     1123               define variable v-task-type as character no-undo.
     1124               define variable v-task-num as integer no-undo.
     1125               assign
     1126                  v-db-num     = integer( entry( v-ind, iListDb, chr(44) ) )
     1127                  v-rec-key    =          entry( v-ind, iListKey, chr(1) )
     1128                  v-cre-db-num = integer( entry( 1, v-rec-key, chr(3) ) )
     1129                  v-task-type  =          entry( 2, v-rec-key, chr(3) )
     1130                  v-task-num   = integer( entry( 3, v-rec-key, chr(3) ) )
     1131               .
     1132                if mAsyncProcRun
     1133                then
     1134                   run addtask (iAutoType,"utl\proc-anyproc.p",substitute ("&2&1&3&1&4&1&5&1&6",
     1135                                                      chr(4),
     1136                                                      "adm/calc-arc.p",
     1137                                                      v-db-num,
     1138                                                      v-cre-db-num,
     1139                                                      v-task-type,
     1140                                                      v-task-num)).
     1141                else do:
     1142                  run adm/calc-arc.p
     1143                     (input v-db-num
     1144                     ,input v-cre-db-num
     1145                     ,input v-task-type
     1146                     ,input v-task-num
     1147                  ) no-error.
     1148                  if error-status :error
     1149                  then do:
     1150                  run write-to-log in this-procedure
     1151                     (input vss-workfile + chr(32)
     1152                          + "Ошибка при расчете архива" + chr(10)
     1153                          + error-status :get-message(error-status :num-messages) + chr(10)
     1154                          + return-value
     1155                     ) .
     1156                  end.
     1157               end.
     1158            end.
     1159         end.
     1160         when 'autoexp':U
     1161         then do:
     1162            do v-ind = 1 to v-num-entries-db-list :
     1163               assign
     1164                  v-db-num     = integer( entry( v-ind, iListDb, chr(44) ) )
     1165                  v-rec-key    =          entry( v-ind, iListKey, chr(1) )
     1166                  v-cre-db-num = integer( entry( 1, v-rec-key, chr(3) ) )
     1167                  v-task-type  =          entry( 2, v-rec-key, chr(3) )
     1168                  v-task-num   = integer( entry( 3, v-rec-key, chr(3) ) )
     1169               .
     1170               if mAsyncProcRun
     1171                then
     1172                   run addtask (iAutoType,"utl\proc-anyproc.p",substitute ("&2&1&3&1&4&1&5&1&6",
     1173                                                      chr(4),
     1174                                                      "bge/bge-shd.p",
     1175                                                      v-cre-db-num,
     1176                                                      v-task-type,
     1177                                                      v-task-num,
     1178                                                      v-db-num)).
     1179                else do:
     1180                  run bge/bge-shd.p
     1181                     (input v-cre-db-num
     1182                     ,input v-task-type
     1183                     ,input v-task-num
     1184                     ,input v-db-num
     1185                  ) no-error.
     1186               end.
     1187            end.
     1188         end.
     1189         when 'autooxml':U
     1190         then do:
     1191            do v-ind = 1 to v-num-entries-db-list :
     1192               assign
     1193                  v-db-num     = integer( entry( v-ind, iListDb, chr(44) ) )
     1194                  v-rec-key    =          entry( v-ind, iListKey, chr(1) )
     1195                  v-cre-db-num = integer( entry( 1, v-rec-key, chr(3) ) )
     1196                  v-task-type  =          entry( 2, v-rec-key, chr(3) )
     1197                  v-task-num   = integer( entry( 3, v-rec-key, chr(3) ) )
     1198               .
     1199               run bge/oxmlshd.p
     1200               (input this-procedure:handle
     1201               ,input v-cre-db-num
     1202               ,input v-task-type
     1203               ,input v-task-num
     1204               ,input v-db-num
     1205               ,input mForExtsys
     1206               ) no-error.
     1207            end.
     1208         end.
     1209         when 'autogcd':U
     1210         then do:
     1211            do v-ind = 1 to v-num-entries-db-list :
     1212               assign
     1213                  v-db-num     = integer( entry( v-ind, iListDb, chr(44) ) )
     1214                  v-rec-key    =          entry( v-ind, iListKey, chr(1) )
     1215                  v-cre-db-num = integer( entry( 1, v-rec-key, chr(3) ) )
     1216                  v-task-type  =          entry( 2, v-rec-key, chr(3) )
     1217                  v-task-num   = integer( entry( 3, v-rec-key, chr(3) ) )
     1218               .
     1219               run str/gcd-shd.p
     1220                  (input this-procedure:handle
     1221                  ,input v-cre-db-num
     1222                  ,input v-task-type
     1223                  ,input v-task-num
     1224                  ,input v-db-num
     1225                  ) no-error.
     1226            end.
     1227         end.
     1228         when 'autosuz':U
     1229         then do:
     1230            do v-ind = 1 to v-num-entries-db-list
     1231            :
     1232               assign
     1233                  v-db-num     = integer( entry( v-ind, iListDb, chr(44) ) )
     1234                  v-rec-key    =          entry( v-ind, iListKey, chr(1) )
     1235                  v-cre-db-num = integer( entry( 1, v-rec-key, chr(3) ) )
     1236                  v-task-type  =          entry( 2, v-rec-key, chr(3) )
     1237                  v-task-num   = integer( entry( 3, v-rec-key, chr(3) ) )
     1238               .
