     1240                  (
     1241                  input this-procedure:handle
     1242                  ,input v-cre-db-num
     1243                  ,input v-task-type
     1244                  ,input v-task-num
     1245                  ,input v-db-num
     1246               ) no-error.
     1247               if error-status :error
     1248               then do:
     1249                  run write-to-log in this-procedure
     1250                     (input vss-workfile + chr(32)
     1251                       + "Ошибка при запуске отчета" + chr(10)
     1252                       + error-status :get-message(error-status :num-messages) + chr(10)
     1253                       + return-value
     1254                  ) .
     1255               end.
     1256            end.
     1257         end.
     1258         when 'autosale':U
     1259         then do:
     1260            do v-ind = 1 to v-num-entries-db-list :
     1261               assign
     1262                  v-db-num     = integer( entry( v-ind, iListDb, chr(44) ) )
     1263                  v-rec-key    =          entry( v-ind, iListKey, chr(1) )
     1264                  v-cre-db-num = integer( entry( 1, v-rec-key, chr(3) ) )
     1265                  v-task-type  =          entry( 2, v-rec-key, chr(3) )
     1266                  v-task-num   = integer( entry( 3, v-rec-key, chr(3) ) )
     1267               .
