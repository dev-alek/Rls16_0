     1270                  ,input v-cre-db-num
     1271                  ,input v-task-type
     1272                  ,input v-task-num
     1273                  ,input v-db-num
     1274                  ) no-error.
     1275            end.
     1276         end.
     1277         when 'autocbnk':U
     1278         then do:
     1279            do v-ind = 1 to v-num-entries-db-list :
     1280               assign
     1281                  v-db-num     = integer( entry( v-ind, iListDb, chr(44) ) )
     1282                  v-rec-key    =          entry( v-ind, iListKey, chr(1) )
     1283                  v-cre-db-num = integer( entry( 1, v-rec-key, chr(3) ) )
     1284                  v-task-type  =          entry( 2, v-rec-key, chr(3) )
     1285                  v-task-num   = integer( entry( 3, v-rec-key, chr(3) ) )
     1286               .
     1287               run bge/clb-shd.p
     1288                  (input this-procedure:handle
     1289                  ,input v-cre-db-num
     1290                  ,input v-task-type
     1291                  ,input v-task-num
     1292                  ,input v-db-num
     1293               ) no-error.
     1294            end.
     1295         end.
     1296         when 'autofree':U
     1297         then do:
     1298            do v-ind = 1 to v-num-entries-db-list :
     1299               assign
     1300                  v-db-num     = integer( entry( v-ind, iListDb, chr(44) ) )
     1301                  v-rec-key    =          entry( v-ind, iListKey, chr(1) )
     1302                  v-cre-db-num = integer( entry( 1, v-rec-key, chr(3) ) )
     1303                  v-task-type  =          entry( 2, v-rec-key, chr(3) )
     1304                  v-task-num   = integer( entry( 3, v-rec-key, chr(3) ) )
     1305               .
     1306               run adm/freeshdr.p
     1307                  (input this-procedure:handle
     1308                  ,input v-cre-db-num
     1309                  ,input v-task-type
     1310                  ,input v-task-num
     1311                  ,input v-db-num
     1312               ) no-error.
     1313            end.
     1314         end.
     1315         when 'is_PM':U
     1316         then do:
     1317            do v-ind = 1 to v-num-entries-db-list :
     1318               assign
     1319                  v-db-num     = integer( entry( v-ind, iListDb, chr(44) ) )
     1320                  v-rec-key    =          entry( v-ind, iListKey, chr(1) )
     1321                  v-cre-db-num = integer( entry( 1, v-rec-key, chr(3) ) )
     1322                  v-task-type  =          entry( 2, v-rec-key, chr(3) )
     1323                  v-task-num   = integer( entry( 3, v-rec-key, chr(3) ) )
     1324               .
     1325               run bge/auto-exp-is_PM.p
     1326                          (input this-procedure:handle
     1327                           ,input v-db-num
     1328                           ,input v-cre-db-num
     1329                           ,input v-task-type
     1330                           ,input v-task-num
     1331                           ) no-error.
     1332            end.
     1333         end.
     1334      end case.
     1335   end.
     1336   define variable volddate as date no-undo init ?.
     1337   define stream sOutCash.
     1338   define variable mFileCashParLog as character no-undo.
     1339   procedure AddCashParam:
     1340      define input  parameter p-auto-type-list as character no-undo.
     1341      define input  parameter iToday as date no-undo.
     1342      define input  parameter iTime as integer no-undo.
     1343      if mFileCashParLog eq ""
     1344      then do:
     1345         mFileCashParLog = searchfile("cashparam.log").
     1346         if mFileCashParLog eq ?
     1347         then do:
     1348            output stream sOutCash to "cashparam.log" append.
     1349            output stream sOutCash close.
     1350            mFileCashParLog = searchfile("cashparam.log").
     1351            if mFileCashParLog eq ?
     1352            then
     1353               mFileCashParLog = "".
     1354         end.
     1355      end.
     1356      if (    lookup ('autooxml':U  ,p-auto-type-list) > 0
     1357         )
     1358         and voldDate ne iToday
     1359      then do:
     1360         mAsyncHelper:setTimeOutTask("cashParam",600).
     1361         voldDate = iToday.
     1362         if iTime < 7200
     1363         then
     1364            run addTaskTime in this-procedure ("cashParam","utl/proc-send-all.p" , mFileCashParLog, datetime-tz (month (iToday),day (iToday), year (iToday),2,0 )).
     1365         if iTime < 50400
     1366         then
     1367            run addTaskTime in this-procedure("cashParam","utl/proc-send-all.p" , mFileCashParLog, datetime-tz (month (iToday),day (iToday), year (iToday),14,0 )).
     1368      end.
     1369   end.
     1370   procedure AddUtil:
     1371      define input  parameter p-auto-type-list as character no-undo.
     1372      define variable vRun as logical no-undo.
     1373      if mFileCashParLog eq ""
     1374      then do:
     1375         mFileCashParLog = searchfile("utils.log").
     1376         if mFileCashParLog eq ?
     1377         then do:
     1378            output stream sOutCash to "utils.log" append.
     1379            output stream sOutCash close.
     1380            mFileCashParLog = searchfile("utils.log").
     1381            if mFileCashParLog eq ?
     1382            then
     1383               mFileCashParLog = "".
     1384         end.
     1385      end.
     1386      if (    lookup ('autooxml':U  ,p-auto-type-list) > 0
     1387         )
     1388      then do:
     1389         mAsyncHelper:setTimeOutTask("Utils",600).
     1390         run utl/chknds22.p (output vRun).
     1391         if vRun then
     1392         do:
     1393           run addTaskTime in this-procedure("Смена кода ставки НДС с 1 на 11.","utl/run_nds22.p" , mFileCashParLog, datetime-tz (1,1,2026,0,0 )).
     1394         end.
     1395      end.
     1396   end.
     1397   define variable mPrintNextMes as logical no-undo init yes.
     1398   procedure checkConect:
     1399      define input  parameter iTitle  as character no-undo.
     1400      define input  parameter iAutoType as character no-undo.
     1401      define output parameter oDbNum  as integer   no-undo.
     1402      define output parameter oDBInfo as character no-undo.
     1403      define variable v-log as logical no-undo.
     1404      run adm/chk-db.p no-error .
     1405      if error-status :error then do:
     1406         run write-to-log (  substitute( "&1. Проверка возможности работы сессии.&2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message(1) ) ).
     1407         run gbl/dbdiscon.p no-error.
     1408         if error-status :error then do:
     1409            run write-to-log (  substitute( "&1. Не удалось отсоединиться от БД&2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message(1) ) ).
     1410         end.
     1411         return error.
     1412      end.
     1413      if v-socket = false
     1414      then do:
     1415         if iAutoType = 'autonws':U
     1416         then do:
     1417            message
     1418               vss-workfile vss-revision vss-description skip
     1419               substitute( 'В параметрах соединения с БД отсутствуют параметры "-S" и "-1".' ) skip
     1420               substitute( 'Работа СПН возможна только в ручном режиме.' ) skip
     1421               substitute( 'Продолжить работу в ручном режиме?' ) skip
     1422               view-as alert-box question buttons yes-no update v-log
     1423            .
     1424            if v-log = true
     1425            then do:
     1426               run gbl/dbdiscon.p no-error.
     1427               if error-status :error then do:
     1428                  run write-to-log (  substitute( "&1. Не удалось отсоединиться от БД&2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message(1) ) ).
     1429               end.
     1430               return error "HandMode".
     1431            end.
     1432         end.
     1433         else do:
     1434            message
     1435               vss-workfile vss-revision vss-description skip
     1436               substitute( 'В параметрах соединения с БД отсутствуют параметры "-S" и "-1".' ) skip
     1437               substitute( '&1 работать не может.', ititle ) skip
     1438               view-as alert-box error
     1439            .
     1440         end.
     1441         return error.
     1442      end.
     1443      run adm/db-info.p ( output oDbNum, output oDBInfo ) no-error.
     1444      if error-status :error
     1445      then do:
     1446         if mPrintNextMes = true then do:
     1447            run write-to-log( vss-workfile + chr(32)
     1448                            + "Ошибка при считывании информации о текущей БД." + chr(10)
     1449                            + error-status :get-message(error-status :num-messages) + chr(10)
     1450                            + return-value
     1451                            ) .
     1452            mPrintNextMes = false.
     1453         end.
     1454         return error "WaitOK".
     1455      end.
     1456      else do:
     1457         mPrintNextMes = true.
     1458      end.
     1459   end procedure.
     1460   procedure initAsyncProc:
     1461      define input  parameter iTitle as character no-undo.
     1462      define input  parameter iAutoTypeList as character no-undo.
     1463      define input  parameter iWorkType     as character no-undo.
     1464      define input  parameter iNextPeriod as logical no-undo.
     1465      define output parameter oDbInfo as character no-undo.
     1466      define variable vi as integer no-undo.
     1467      define variable vAutoType as character  no-undo.
     1468      define variable vError as logical no-undo.
     1469      define variable vConect as logical no-undo.
     1470      define variable vDbNum as integer no-undo.
     1471      do vi = 1 to num-entries (iAutoTypeList):
     1472         vAutoType = entry(vi,iAutoTypeList).
     1473         if lookup(vAutoType, iWorkType) eq 0
     1474         then do:
     1475            if not vConect
     1476            then do:
     1477               run adm/autoconn.p no-error.
     1478               if error-status :error
     1479               then do:
     1480                  run write-to-log ( substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1) ) ).
     1481               end.
     1482               else do:
     1483                  vConect = yes.
     1484                  run checkConect (input  iTitle,
     1485                                input  i-auto-type,
     1486                                output vDbNum,
     1487                                output oDbInfo) no-error.
     1488                  if error-status:error
     1489                  then do:
     1490                     return error return-value.
     1491                  end.
     1492               end.
     1493            end.
     1494            if iNextPeriod
     1495            then do:
     1496               run adm/chk-sch.p
     1497               ( input  vAutoType
     1498               , input  mForDb
     1499               , output mListDb
     1500               , output mListDbAll
     1501               , output mListKey
     1502               , output mListKeyAll
     1503               , input mForExtsys
     1504               , input mForProc
     1505               , output table tt-BatchProcess
     1506               ) no-error.
     1507               run adm/wr-n-bp.p
     1508                   ( input this-procedure:handle
     1509                   ,input mSessionBegin
     1510                   ,input vAutoType
     1511                   ,input mListDb
     1512                   ,input mForExtsys
     1513                   ,input mForProc
     1514                   ) no-error.
     1515               if error-status :error
     1516               then do:
     1517                  vError = yes.
     1518                  run write-to-log( vss-workfile + chr(32)
     1519                               + "Ошибка при анализе начала следующего сеанса" + chr(10)
     1520                               + error-status :get-message(error-status :num-messages) + chr(10)
     1521                               + return-value
     1522                               ) no-error.
     1523                  if error-status:error
     1524                  then do:
     1525                     run write-to-screen (return-value).
     1526                  end.
     1527               end.
     1528            end.
     1529            run adm/chk-sch.p
     1530               ( input  vAutoType
     1531               , input  mForDb
     1532               , output mListDb
     1533               , output mListDbAll
     1534               , output mListKey
     1535               , output mListKeyAll
     1536               , input mForExtsys
     1537               , input mForProc
     1538               , output table tt-BatchProcess
     1539               ) no-error.
     1540            if error-status :error
     1541            then do:
     1542               run write-to-log( vss-workfile + chr(32)
     1543                               + "Ошибка при чтении расписания." + chr(10)
     1544                               + error-status :get-message(error-status :num-messages) + chr(10)
     1545                               + return-value
     1546                               ) .
     1547               return error.
     1548            end.
     1549            for each tt-BatchProcess:
     1550               run startproc(tt-BatchProcess.BP_Type,
     1551                             tt-BatchProcess.CharKey_One,
     1552                             tt-BatchProcess.CharKey_Three,
     1553                             datetime-tz (tt-BatchProcess.BP_ExecSysDate,tt-BatchProcess.BP_ExecSysTimeInt * 1000)).
     1554            end.
     1555         end.
     1556      end.
     1557      if iNextPeriod and not vError
     1558      then
     1559         mSessionBegin = false.
     1560      if vConect
     1561      then do:
     1562         run gbl/dbdiscon.p no-error.
     1563         if error-status :error then do:
     1564            run write-to-log (  substitute( "&1. Не удалось отсоединиться от БД&2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message(1) ) ) no-error.
     1565            if error-status:error
     1566            then do:
     1567               run write-to-screen (return-value).
     1568            end.
     1569         end.
     1570      end.
     1571   end procedure.
     1572   define stream VarStream.
     1573   procedure ReedFileContext:
     1574      define variable v-varfile as character no-undo.
     1575      define variable v-varstr as character no-undo.
     1576      define variable mNewHiddenMode as logical no-undo.
     1577      assign
     1578         file-info:file-name = substitute( "./ATH&1.var", g#auto-pid )
     1579         v-varfile           = file-info:full-pathname
     1580      .
     1581      if v-varfile <> ?
     1582      then do:
     1583         v-varstr = "".
     1584         input stream VarStream from value( v-varfile ) .
     1585         block_read-var:
     1586         repeat :
     1587            import stream VarStream unformatted v-varstr no-error .
     1588            leave block_read-var .
     1589         end.
     1590         input stream VarStream close.
     1591         if lookup( "H":U, v-varstr, "+":U ) = 0
     1592         then do:
     1593            mNewHiddenMode = false.
     1594         end.
     1595         else do:
     1596            mNewHiddenMode = true.
     1597         end.
     1598         os-delete value( v-varfile ) .
     1599         if mNewHiddenMode <> mHiddenMode
     1600         then do:
     1601            mHiddenMode = mNewHiddenMode.
     1602            run write-to-log ( substitute( "Смена статуса 'видимости' сессии. Теперь сессия &1видна.", (if mHiddenMode = true then "не":U else "") ) ) no-error.
     1603            if error-status:error
     1604            then do:
     1605               run write-to-screen (return-value).
     1606            end.
     1607         end.
     1608      end.
     1609   end.
     1610   procedure CheckUpdate:
     1611     define variable CheckUpd      as class ibs.th.adm.upd.CheckUpd no-undo.
     1612     CheckUpd = new ibs.th.adm.upd.CheckUpd ().
     1613     if CheckUpd:isStopWork
     1614     then do:
     1615        run write-to-log ("Идет установка r-кодов. Попробуйте через несколько минут.") .
     1616        delete object CheckUpd no-error.
     1617        return error "Идет установка r-кодов. Попробуйте через несколько минут.".
     1618     end.
     1619     if CheckUpd:isNeedUpd
     1620     then do:
     1621        run write-to-log ("Необходимо обновить базу. Запустите ТН") .
     1622        delete object CheckUpd no-error.
     1623        return error "Необходимо обновить базу. Запустите ТН".
     1624     end.
     1625     delete object CheckUpd no-error.
     1626   end.
     1627   define variable m-time          as integer   no-undo .
     1628   define variable mtoday         as date      no-undo .
     1629   define variable log-exit      as logical   no-undo .
     1630   define variable writelogtype  as character no-undo .
     1631   define variable mStart     as logical   no-undo .
     1632   define variable mtitle as character no-undo.
     1633   define variable mDbNum as integer no-undo.
     1634   define variable mDbInfo as character no-undo.
     1635   define variable vRun as logical no-undo.
     1636   define temp-table tt-proc no-undo
     1637     field proc_id as integer
     1638     index pi is unique primary
     1639       proc_id ascending
     1640   .
     1641   DEFINE VAR automain AS WIDGET-HANDLE NO-UNDO.
     1642   DEFINE BUTTON b-exit AUTO-GO DEFAULT
     1643        LABEL "Вы&ход "
     1644        SIZE 10 BY 1 TOOLTIP "Выход из автоматической системы"
     1645        BGCOLOR 8 .
     1646   DEFINE BUTTON b-hand DEFAULT
     1647        LABEL "&РРежим"
     1648        SIZE 10 BY 1 TOOLTIP "Ручной режим приема и отправки новостей"
     1649        BGCOLOR 8 .
     1650   DEFINE BUTTON b-start DEFAULT
     1651        LABEL "&Запуск"
     1652        SIZE 10 BY 1 TOOLTIP "Запустить один цикл"
     1653        BGCOLOR 8 .
     1654   DEFINE BUTTON b-help DEFAULT
     1655        LABEL "Помо&щь"
     1656        SIZE 10 BY 1 TOOLTIP "Помощь"
     1657        BGCOLOR 8 .
     1658   DEFINE BUTTON b-prop DEFAULT
     1659        LABEL "&Настройки"
     1660        SIZE 10 BY 1 TOOLTIP "Настройка СПН"
     1661        BGCOLOR 8 .
     1662   DEFINE VARIABLE auto-log AS CHARACTER
     1663        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL LARGE
     1664        SIZE 96.88 BY 19.75 NO-UNDO.
     1665   DEFINE VARIABLE curr-date AS DATE FORMAT "99/99/9999":U
     1666         VIEW-AS TEXT
     1667        SIZE 11 BY .67 NO-UNDO.
     1668   DEFINE VARIABLE curr-time AS CHARACTER FORMAT "X(8)":U
     1669         VIEW-AS TEXT
     1670        SIZE 8 BY .67 NO-UNDO.
     1671   DEFINE VARIABLE f-msg AS CHARACTER FORMAT "X(256)":U
     1672         VIEW-AS TEXT
     1673        SIZE 63 BY .67
     1674        FGCOLOR 12  NO-UNDO.
     1675   DEFINE FRAME f-amain
     1676        b-exit AT ROW 1.17 COL 2.25
     1677        b-hand AT ROW 1.17 COL 12.25
     1678        b-prop AT ROW 1.17 COL 22.25
     1679        b-start AT ROW 1.17 COL 32.25
     1680        b-help AT ROW 1.17 COL 89
     1681        auto-log AT ROW 3.38 COL 2.25 NO-LABEL
     1682        f-msg AT ROW 2.5 COL 13 COLON-ALIGNED NO-LABEL
     1683        curr-date AT ROW 2.5 COL 79 NO-LABEL
     1684        curr-time AT ROW 2.5 COL 90.5 NO-LABEL
     1685        "Сообщения:" VIEW-AS TEXT
     1686             SIZE 10.5 BY .67 AT ROW 2.5 COL 3
     1687       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1688            SIDE-LABELS NO-UNDERLINE THREE-D
     1689            AT COL 1 ROW 1
     1690            SIZE 99.38 BY 22.42.
     1691   IF SESSION:DISPLAY-TYPE = "GUI":U and not session:batch-mode THEN
     1692     CREATE WINDOW automain ASSIGN
     1693            HIDDEN             = YES
     1694            TITLE              = ""
     1695            HEIGHT             = 22.75
     1696            WIDTH              = 99.38
     1697            MAX-HEIGHT         = 22.75
     1698            MAX-WIDTH          = 99.38
     1699            VIRTUAL-HEIGHT     = 22.75
     1700            VIRTUAL-WIDTH      = 99.38
     1701            RESIZE             = no
     1702            SCROLL-BARS        = no
     1703            STATUS-AREA        = no
     1704            BGCOLOR            = ?
     1705            FGCOLOR            = ?
     1706            KEEP-FRAME-Z-ORDER = yes
     1707            THREE-D            = yes
     1708            MESSAGE-AREA       = no
     1709            SENSITIVE          = yes.
     1710   ELSE automain = CURRENT-WINDOW.
     1711   ASSIGN
     1712          auto-log:READ-ONLY IN FRAME f-amain        = TRUE.
     1713   ASSIGN
     1714          b-hand:HIDDEN IN FRAME f-amain           = TRUE.
     1715   ASSIGN
     1716         b-start:HIDDEN IN FRAME f-amain           = TRUE.
     1717   ASSIGN
     1718          b-prop:HIDDEN IN FRAME f-amain           = TRUE.
     1719   ASSIGN
     1720          f-msg:READ-ONLY IN FRAME f-amain        = TRUE.
     1721   IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(automain)
     1722   THEN automain:HIDDEN = yes.
     1723   if VALID-HANDLE(automain) then
     1724   do:
     1725   ON END-ERROR OF automain
     1726   OR ENDKEY OF automain ANYWHERE DO:
     1727     RETURN NO-APPLY.
     1728   END.
     1729   ON WINDOW-CLOSE OF automain
     1730   DO:
     1731     RETURN NO-APPLY.
     1732   END.
     1733   end.
     1734   ON CHOOSE OF b-exit IN FRAME f-amain
     1735   DO:
     1736     define variable v-answer as logical   no-undo .
     1737     run gbl/q-wait.w
     1738       ( input substitute( "Вы хотите завершить работу авторежима?" )
     1739        ,input false
     1740        ,input 20
     1741        ,output v-answer
     1742       ) no-error .
     1743     if error-status :error
     1744       or v-answer = true
     1745     then do:
     1746       if error-status :error then do:
     1747         run write-to-log ( substitute( "&1. Ошибка при завершении работы. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1) )
     1748                         ).
     1749       end.
     1750       assign
     1751         log-exit = yes
     1752       .
     1753     end.
     1754   END.
     1755   ON CHOOSE OF b-start IN FRAME f-amain
     1756   DO:
     1757      mstart = yes.
     1758   end.
     1759   ON CHOOSE OF b-hand IN FRAME f-amain
     1760   DO:
     1761     define variable v-auto-old as logical no-undo .
     1762     case i-auto-type
     1763     :
     1764       when 'autonws':U
     1765       then do:
     1766           assign
     1767               v-auto-old = g#auto
     1768               g#auto       = FALSE
     1769           .
     1770           run write-to-log ( (if v-auto-old then string("Aвтоматический режим прерван." + chr(32) ) else "" )
     1771                               + "Запущен ручной режим обмена новостями."
     1772                           ).
     1773           run adm/autoconn.p no-error.
     1774           if error-status :error
     1775           then do:
     1776             run write-to-log (  substitute( "&1. &2&3&4"
     1777                                             ,vss-workfile
     1778                                             ,return-value
     1779                                             ,chr(10)
     1780                                             ,error-status:get-message(error-status:num-messages)
     1781                                           )
     1782                              ).
     1783             message
     1784               substitute( "&1. &2&3&4"
     1785                           ,vss-workfile
     1786                           ,return-value
     1787                           ,chr(10)
     1788                           ,error-status:get-message(error-status:num-messages)
     1789                         )
     1790               view-as alert-box .
     1791           end.
     1792           else do:
     1793             run nws/nws-hand.w
     1794               ( input this-procedure:handle
     1795               , input g#auto-user-id
     1796               , input g#auto-user-password
     1797               ) no-error .
     1798             if error-status :error then do:
     1799               run write-to-log
     1800                 ( substitute( "&1. &2&3&4"
     1801                               ,vss-workfile
     1802                               ,return-value
     1803                               ,chr(10)
     1804                               ,error-status:get-message(error-status:num-messages)
     1805                             )
     1806                 ).
     1807               message
     1808                 substitute( "&1. &2&3&4"
     1809                             ,vss-workfile
     1810                             ,return-value
     1811                             ,chr(10)
     1812                             ,error-status:get-message(error-status:num-messages)
     1813                           )
     1814                 view-as alert-box .
     1815             end.
     1816           end.
     1817           assign
     1818             g#auto = v-auto-old
     1819             hand-log-msg-h = ?
     1820           .
     1821           run write-to-log ( "Закончена работа с ручным режимом обмена новостями."
     1822                               + (if v-auto-old then string( chr(32) + "Запущен автоматический режим." ) else "")
     1823                           ).
     1824           run gbl/dbdiscon.p no-error.
     1825           if error-status :error then do:
     1826             run write-to-log (  substitute( "&1. Не удалось отсоединиться от БД&2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message(1) ) ).
     1827           end.
     1828           apply "choose" to b-exit in frame f-amain.
     1829           return no-apply.
     1830       end.
     1831       when 'autooxml':U
     1832       then do:
     1833           assign
     1834               v-auto-old = g#auto
     1835               g#auto       = FALSE
     1836           .
     1837           run write-to-log ( (if v-auto-old then string("Aвтоматический режим прерван." + chr(32) ) else "" )
     1838                               + "Запущен ручной режим обмена данными."
     1839                           ).
     1840           run adm/autoconn.p no-error.
     1841           if error-status :error
     1842           then do:
     1843             run write-to-log (  substitute( "&1. &2&3&4"
     1844                                             ,vss-workfile
     1845                                             ,return-value
     1846                                             ,chr(10)
     1847                                             ,error-status:get-message(error-status:num-messages)
     1848                                           )
     1849                              ).
     1850             message
     1851               substitute( "&1. &2&3&4"
     1852                           ,vss-workfile
     1853                           ,return-value
     1854                           ,chr(10)
     1855                           ,error-status:get-message(error-status:num-messages)
     1856                         )
     1857               view-as alert-box .
     1858           end.
     1859           else do:
     1860             run bge/oxmlhand.w
     1861               (
     1862                input this-procedure:handle
     1863               ,input this-procedure:handle
     1864               ,input g#auto-user-id
     1865               ,input g#auto-user-password
     1866               ) no-error .
     1867             if error-status :error then do:
     1868               run write-to-log
     1869                 ( substitute( "&1. &2&3&4"
     1870                               ,vss-workfile
     1871                               ,return-value
     1872                               ,chr(10)
     1873                               ,error-status:get-message(error-status:num-messages)
     1874                             )
     1875                 ).
     1876               message
     1877                 substitute( "&1. &2&3&4"
     1878                             ,vss-workfile
     1879                             ,return-value
     1880                             ,chr(10)
     1881                             ,error-status:get-message(error-status:num-messages)
     1882                           )
     1883                 view-as alert-box .
     1884             end.
     1885           end.
     1886           assign
     1887             g#auto = v-auto-old
     1888             hand-log-msg-h = ?
     1889           .
     1890           run write-to-log ( "Закончена работа с ручным режимом обмена данными."
     1891                               + (if v-auto-old then string( chr(32) + "Запущен автоматический режим." ) else "")
     1892                           ).
     1893           run gbl/dbdiscon.p no-error.
     1894           if error-status :error then do:
     1895             run write-to-log (  substitute( "&1. Не удалось отсоединиться от БД&2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message(1) ) ).
     1896           end.
     1897           apply "choose" to b-exit in frame f-amain.
     1898           return no-apply.
     1899       end.
     1900      end case.
     1901   END.
     1902   ON CHOOSE OF b-prop IN FRAME f-amain
     1903   DO:
     1904       case i-auto-type
     1905       :
     1906           when 'autonws':U
     1907           then do:
     1908               define variable v-auto-old as logical no-undo .
     1909               assign
     1910                   v-auto-old = g#auto
     1911                   g#auto       = FALSE
     1912               .
     1913               run write-to-log ( (if v-auto-old then string("Aвтоматический режим прерван." + chr(32) ) else "" )
     1914                                   + "Запущен режим настройки СПН."
     1915                               ).
     1916               run adm/autoconn.p no-error.
     1917               if error-status :error
     1918               then do:
     1919                   message vss-workfile skip return-value view-as alert-box .
     1920                   run write-to-log (  vss-workfile + chr(32)
     1921                                       + return-value
     1922                                   ).
     1923                   assign
     1924                   g#auto = v-auto-old
     1925                   .
     1926                   return no-apply.
     1927               end.
     1928               run adm/autoprop.w no-error.
     1929               run nws/nws-init.p no-error.
     1930               if error-status :error
     1931               then do:
     1932                   run write-to-log (  vss-workfile + chr(10)
     1933                                       + "Ошибка инициализации переменных для системы передачи новостей" + chr(10)
     1934                                       + return-value
     1935                                   ).
     1936                   assign
     1937                   g#auto = v-auto-old
     1938                   .
     1939                   return no-apply.
     1940               end.
     1941               run gbl/dbdiscon.p no-error.
     1942               if error-status :error then do:
     1943                 run write-to-log (  substitute( "&1. Не удалось отсоединиться от БД&2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message(1) ) ).
     1944               end.
     1945               run write-to-log ( "Закончена работа с режимом настройки СПН."
     1946                                   + (if v-auto-old then string( chr(32) + "Запущен автоматический режим." ) else "")
     1947                               ).
     1948               assign
     1949                   g#auto = v-auto-old
     1950               .
     1951           end.
     1952           when 'autoexp':U
     1953           then do:
     1954               message
     1955                   "В разработке..."
     1956                   skip
     1957               view-as alert-box information.
     1958           end.
     1959           when 'autooxml':U
     1960           then do:
     1961               assign
     1962                   v-auto-old = g#auto
     1963                   g#auto       = FALSE
     1964               .
     1965               run write-to-log ( (if v-auto-old then string("Aвтоматический режим прерван." + chr(32) ) else "" )
     1966                                   + "Запущен режим настройки OpenXML."
     1967                               ).
     1968               run adm/autoconn.p no-error.
     1969               if error-status :error
     1970               then do:
     1971                   message vss-workfile skip return-value view-as alert-box .
     1972                   run write-to-log (  vss-workfile + chr(32)
     1973                                       + return-value
     1974                                   ).
     1975                   assign
     1976                   g#auto = v-auto-old
     1977                   .
     1978                   return no-apply.
     1979               end.
     1980               run adm/autoprop.w no-error.
     1981               run bge/oxml-ini.p no-error.
     1982               if error-status :error
     1983               then do:
     1984                   run write-to-log (  vss-workfile + chr(10)
     1985                                       + "Ошибка инициализации переменных для системы OpenXML" + chr(10)
     1986                                       + return-value
     1987                                   ).
     1988                   assign
     1989                   g#auto = v-auto-old
     1990                   .
     1991                   return no-apply.
     1992               end.
     1993               run gbl/dbdiscon.p no-error.
     1994               if error-status :error then do:
     1995                 run write-to-log (  substitute( "&1. Не удалось отсоединиться от БД&2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message(1) ) ).
     1996               end.
     1997               run write-to-log ( "Закончена работа с режимом настройки OpenXML."
     1998                                   + (if v-auto-old then string( chr(32) + "Запущен автоматический режим." ) else "")
     1999                               ).
     2000               assign
     2001                   g#auto = v-auto-old
     2002               .
     2003           end.
     2004       end case.
     2005   END.
     2006   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2007   on help of frame f-amain
     2008   do:
     2009     run gbl/app_help.p
     2010       (input this-procedure :file-name
     2011       ,input ''
     2012       ,input ?
     2013       ) no-error.
     2014     if error-status :error then do:
     2015       message
     2016         "Ошибка при вызове помощи"
     2017         error-status :get-message(1)
     2018         view-as alert-box .
     2019     end.
     2020   end.
     2021   run minbtn-set in this-procedure .
     2022   on choose of b-help in frame f-amain
     2023   do:
     2024     apply "help":u to frame f-amain .
     2025   end.
     2026   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2027   procedure minbtn-set :
     2028       do
     2029           on error undo, return error return-value
     2030           :
     2031           define variable ii              as integer       no-undo .
     2032           define variable fh              as widget-handle no-undo .
     2033           define variable hh              as widget-handle no-undo .
     2034           define variable v-h             as handle        extent 4 no-undo .
     2035           define variable v-name-button   as character     no-undo .
     2036           define variable v-help-old-x    as decimal       no-undo .
     2037           define variable v-help-old-y    as decimal       no-undo .
     2038           define variable v-help-old-size as decimal       no-undo .
     2039           define variable v-frame-width   as decimal       no-undo .
     2040           define variable jj              as integer       no-undo .
     2041           do
     2042               on error undo, return error
     2043               :
     2044               assign
     2045                   v-frame-width = frame f-amain:width - 0.3
     2046                   fh            = frame f-amain:first-child
     2047                   hh            = fh:first-child
     2048                   ii            = 1
     2049                   .
     2050               do while valid-handle(hh):
     2051                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2052                   do:
     2053                       case lc(hh:name) :
     2054                           when "b-help" then
     2055                               do:
     2056                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2057                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2058                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2059                                   hh:TOOLTIP = "Помощь" .
     2060                                   v-help-old-x = hh:column .
     2061                                   v-help-old-y = hh:row    .
     2062                                   v-help-old-size = hh:width .
     2063                                   hh:width-chars = 2.5 .
     2064                               end.
     2065                           when "b-print" then
     2066                               do:
     2067                                   hh:load-image("cmp/b-print.bmp":u) .
     2068                                   hh:TOOLTIP = "Печать" .
     2069                                   v-h[ii] = hh:handle .
     2070                                   ii = ii + 1 .
     2071                                   hh:width-chars = 3 .
     2072                               end.
     2073                           when "b-history" or
     2074                           when "b-hist" then
     2075                               do:
     2076                                   hh:load-image("cmp/b-hist.bmp":u) .
     2077                                   hh:TOOLTIP = "История" .
     2078                                   v-h[ii] = hh:handle .
     2079                                   ii = ii + 1 .
     2080                                   hh:width-chars = 3 .
     2081                               end.
     2082                           when "b-sch" then
     2083                               do:
     2084                                   hh:load-image("cmp/b-sch.bmp":u) .
     2085                                   hh:TOOLTIP = "Установка Фильтра" .
     2086                                   v-h[ii] = hh:handle .
     2087                                   ii = ii + 1 .
     2088                                   hh:width-chars = 3 .
     2089                               end.
     2090                           when "b-hist-user" then
     2091                               do:
     2092                                   hh:load-image("cmp/b-hist.bmp":u) .
     2093                                   hh:TOOLTIP = "История пользователя" .
     2094                                   ii = ii + 1 .
     2095                               end.
     2096                       end case.
     2097                   end.
     2098                   hh = hh:next-sibling.
     2099               end.
     2100               b-help:column = v-frame-width - b-help:width-chars.
     2101               jj = 0.
     2102               repeat ii = 4 to 1 by -1 :
     2103                   if valid-handle (v-h[ii] ) then
     2104                   do:
     2105                       jj  = jj + 1 .
     2106                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2107                       v-h[ii]:row    = v-help-old-y .
     2108                   end.
     2109               end.
     2110           end.
     2111       end.
     2112   end procedure.
     2113   if valid-handle(automain) then
     2114   ASSIGN CURRENT-WINDOW                = automain
     2115          THIS-PROCEDURE:CURRENT-WINDOW = automain.
     2116   on close of this-procedure
     2117   do:
     2118     apply "choose" to b-exit in frame f-amain.
     2119     return no-apply.
     2120   end.
     2121   PAUSE 0 BEFORE-HIDE.
     2122   MAIN-BLOCK:
     2123   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2124      ON END-KEY UNDO MAIN-BLOCK, retry MAIN-BLOCK
     2125      ON STOP    UNDO MAIN-BLOCK, retry MAIN-BLOCK:
     2126     define variable start-time            as int64     no-undo .
     2127     run initProcMode (i-auto-type,i-mode).
     2128     mAsyncHelper = new ibs.th.file.AsyncHelperth().
     2129     mAsyncHelper:mProcPublish = this-procedure.
     2130     mAsyncHelper:setCurrentUserPasswd().
     2131     mAsyncHelper:MyBachMode = yes.
     2132     mAsyncHelper:WritelogInter = 5.
     2133     mAsyncHelper:MyBachMode = yes.
     2134     mAsyncHelper:maxproc    = 1.
     2135     run adm/autoconn.p no-error.
     2136     if error-status :error then do:
     2137       run write-to-log ( substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1) ) ).
     2138     end.
     2139     run CheckUpdate no-error.
     2140     if error-status :error then do:
     2141        return error return-value.
     2142     end.
     2143   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2144     (input  'writelog'
     2145     ,input  ''
     2146     ,input  ''
     2147     ,input  0
     2148     ,input  ''
     2149     ,input  ''
     2150     ,input  ''
     2151     ,input  no
     2152     ,output writelogvalue
     2153     ,output writelogtype
     2154     ) no-error .
     2155     run adm/chk-db.p no-error .
     2156     if error-status :error then do:
     2157       run write-to-log (  substitute( "&1. Проверка возможности работы сессии.&2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message(1) ) ).
     2158       run gbl/dbdiscon.p no-error.
     2159       if error-status :error then do:
     2160         run write-to-log (  substitute( "&1. Не удалось отсоединиться от БД&2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message(1) ) ).
     2161       end.
     2162       assign
     2163         log-exit = true
     2164       .
     2165     end.
     2166     else do:
     2167        define variable Vdbinfo as character no-undo.
     2168       run AddUtil(i-auto-type).
     2169       run adm/db-info.p ( output g#db-num, output Vdbinfo ) no-error.
     2170       run gbl/dbdiscon.p no-error.
     2171       if error-status :error then do:
     2172         run write-to-log (  substitute( "&1. Не удалось отсоединиться от БД&2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message(1) ) ).
     2173       end.
     2174       if i-auto-type = 'autonws':U
     2175       or i-auto-type = 'autooxml':U
     2176       or i-auto-type = 'is_motp':U
     2177       or i-auto-type = 'is_diadoc':U
     2178       then do:
     2179         assign
     2180           g#auto = false
     2181         .
     2182       end.
     2183       else do:
     2184         assign
     2185           g#auto = true
     2186         .
     2187       end.
     2188       assign
     2189         auto-log-msg-h = auto-log:handle
     2190         auto-window-h = this-procedure:handle
     2191         hand-log-msg-h = ?
     2192       .
     2193       if valid-handle(automain) then
     2194         automain:title = substitute( "PID: &1 &2", g#auto-pid, automain:title ).
     2195       case i-auto-type :
     2196         when 'autonws':U
     2197         then do:
     2198           if valid-handle(automain) then
     2199             automain:title = automain:title + "Система передачи новостей.".
     2200           g#auto = FALSE.
     2201           run write-to-log ( "Запущена система передачи новостей" ) no-error.
     2202           if error-status:error
     2203           then do:
     2204             run write-to-screen (return-value).
     2205           end.
     2206           if mHiddenMode = false then do:
     2207             run write-to-log ( "Через 5 секунд будет запущен автоматический режим обмена новостями" ) no-error.
     2208             wait-for
     2209               go of frame f-amain
     2210               or close of this-procedure
     2211               or choose of b-hand in frame f-amain
     2212               or choose of b-help in frame f-amain
     2213               or choose of b-prop in frame f-amain
     2214               or choose of b-start in frame f-amain
     2215               focus frame f-amain
     2216               pause 5
     2217               .
     2218             if error-status:error
     2219             then do:
     2220               run write-to-screen (return-value).
     2221             end.
     2222           end.
     2223           if not log-exit
     2224           then do:
     2225             run write-to-log ( "Запущен автоматический режим обмена новостями" ) no-error.
     2226             if error-status:error
     2227             then do:
     2228               run write-to-screen (return-value).
     2229             end.
     2230             assign
     2231               g#auto = TRUE
     2232             .
     2233           end.
     2234         end.
     2235         when 'autoarh':U
     2236         then do:
     2237           if valid-handle(automain) then
     2238           assign
     2239             automain:title = automain:title + "Система автоматического расчета архивов."
     2240           .
     2241           run write-to-log ( "Запущена система автоматического расчета архивов" ).
     2242         end.
     2243         when 'autoexp':U
     2244         then do:
     2245           if valid-handle(automain) then
     2246           assign
     2247             automain:title = automain:title + "Система автоматического экспорта."
     2248           .
     2249           if mHiddenMode = false then do:
     2250             run write-to-log ( "Через 5 секунд будет запущена система автоматического экспорта" ).
     2251             wait-for
     2252               go of frame f-amain
     2253               or close of this-procedure
     2254               or choose of b-hand in frame f-amain
     2255               or choose of b-help in frame f-amain
     2256               or choose of b-prop in frame f-amain
     2257               or choose of b-start in frame f-amain
     2258               focus frame f-amain
     2259               pause 5
     2260               .
     2261           end.
     2262           if not log-exit
     2263           then do:
     2264             run write-to-log ( "Запущена система автоматического экспорта" ).
     2265           end.
     2266         end.
     2267         when 'autooxml':U
     2268         then do:
     2269           if valid-handle(automain) then
     2270             automain:title = automain:title + "Система OpenXML.".
     2271           g#auto = FALSE.
     2272           .
     2273           run write-to-log ( "Запущена система OpenXML" ).
     2274           if mHiddenMode = false then do:
     2275             run write-to-log ( "Через 5 секунд будет запущен автоматический режим обмена данными" ).
     2276             wait-for
     2277               go of frame f-amain
     2278               or close of this-procedure
     2279               or choose of b-hand in frame f-amain
     2280               or choose of b-help in frame f-amain
     2281               or choose of b-prop in frame f-amain
     2282               or choose of b-start in frame f-amain
     2283               focus frame f-amain
     2284               pause 5
     2285               .
     2286           end.
     2287           if not log-exit
     2288           then do:
     2289             run write-to-log ( "Запущен автоматический режим обмена данныи" ).
     2290             assign
     2291               g#auto = TRUE
     2292             .
     2293           end.
     2294         end.
     2295         when 'is_motp':U
     2296      or when 'is_diadoc':U
     2297         then do:
     2298           define variable vTitle as character no-undo.
     2299            vTitle = if i-auto-type eq  'is_diadoc':U
     2300                     then "ИС Диадок"
     2301                     else "ИС МОТП.".
     2302           assign
     2303             automain:title = automain:title + vTitle
     2304           .
     2305           run write-to-log ( "Запущен автоматический режим обмена данныи c " + vTitle).
     2306         end.
     2307         when 'autogcd':U
     2308         then do:
     2309           if valid-handle(automain) then
     2310           assign
     2311             automain:title = automain:title + "Система автоматического приема информации с касс."
     2312           .
     2313           run write-to-log ( "Запущена система автоматического приема информации с касс" ).
     2314         end.
     2315         when 'autosuz':U
     2316         then do:
     2317           if valid-handle(automain) then
     2318           assign
     2319             automain:title = automain:title + "Система автоматического запуска отчетов."
     2320           .
     2321           run write-to-log ( "Запущена система автоматического запуска отчетов" ).
     2322         end.
     2323         when 'autosale':U
     2324         then do:
     2325           if valid-handle(automain) then
     2326           assign
     2327             automain:title = automain:title + "Система автоматической работы с документами продажи."
     2328           .
     2329           run write-to-log ( "Запущена система автоматической работы с документами продажи" ).
     2330         end.
     2331         when 'autocbnk':U
     2332         then do:
     2333           if valid-handle(automain) then
     2334           assign
     2335             automain:title = automain:title + "Система автоматического эксп/имп в КЛИЕНТ-БАНК."
     2336           .
     2337           run write-to-log ( "Запущена система автоматического эксп/имп в КЛИЕНТ-БАНК" ).
     2338         end.
     2339         when 'autofree':U
     2340         then do:
     2341           if valid-handle(automain) then
     2342           assign
     2343             automain:title = automain:title + "Система автоматического выполнения произвольных заданий."
     2344           .
     2345           run write-to-log ( "Запущена система автоматического выполнения произвольных заданий" ).
     2346         end.
     2347         when 'sktsrv':U
     2348         then do:
     2349           if valid-handle(automain) then
     2350           assign
     2351             automain:title = automain:title + "Сокет-Сервер"
     2352           .
     2353           run write-to-log ( "Запущен Сокет-Сервер" ).
     2354         end.
     2355         when 'mercury':U
     2356         then do:
     2357           if valid-handle(automain) then
     2358           assign
     2359             automain:title = automain:title + "ФГИС Меркурий"
     2360           .
     2361           run write-to-log ( "Запущена система Меркурий" ).
     2362         end.
     2363         when 'is_motp':U
     2364      or when 'is_diadoc':U
     2365         then do:
     2366           if valid-handle(automain) then
     2367           assign
     2368             automain:title = automain:title + vTitle
     2369           .
     2370           run write-to-log ( "Запущена система " + vTitle).
     2371         end.
     2372         when 'hddtest':U
     2373         then do:
     2374           if valid-handle(automain) then
     2375           assign
     2376             automain:title = automain:title + "Мониторинг HDD"
     2377           .
     2378           run write-to-log ( "Запущен мониторинг состояний HDD" ).
     2379         end.
     2380         when 'is_PM':U
     2381         then do:
     2382           if valid-handle(automain) then
     2383           assign
     2384             automain:title = automain:title + "Выгрузка в ИС Президентский Мониторинг"
     2385           .
     2386           run write-to-log ( "Запущена выгрузка в ИС Президентский Мониторинг" ).
     2387         end.
     2388         otherwise do:
     2389           assign
     2390             log-exit = yes
     2391           .
     2392         end.
     2393       end case.
     2394       if valid-handle(automain) then
     2395       assign
     2396         mtitle = automain:title
     2397       .
     2398       if mForDb <> "":U then do:
     2399         if length(mForDb) > 32000
     2400         then do :
     2401           define variable tmp-str as character no-undo .
     2402           tmp-str = entry(1, mForDb) + "-" + entry(num-entries(mForDb), mForDb) .
     2403           run write-to-log ( substitute( "Сессия работает с БД &1", tmp-str ) ).
     2404         end .
     2405         else do :
     2406           run write-to-log ( substitute( "Сессия работает с БД &1", mForDb ) ).
     2407         end .
     2408       end.
     2409       if mForExtsys <> "":U then do:
     2410         run write-to-log ( substitute( "Сессия работает с Внешними Системами &1", mForExtsys ) ).
     2411       end.
     2412       if mForProc <> "":U then do:
     2413         run write-to-log ( substitute( "Сессия работает с Произвольными заданиями &1", mForProc ) ).
     2414       end.
     2415     end.
     2416      main-cycl:
     2417      do while not log-exit
     2418      on error  undo, leave main-cycl
     2419      on stop   undo, next
     2420      on endkey undo, next
     2421      :
     2422         run cur-time( output mtoday
     2423                      ,output m-time
     2424                   ) no-error.
     2425         run AddCashParam(i-auto-type, mtoday, m-time).
     2426         vRun = no.
     2427         find first tt-BatchProcess no-lock
     2428          where
     2429            ( tt-BatchProcess.BP_ExecSysDate < mtoday
     2430                 or (tt-BatchProcess.BP_ExecSysDate = mtoday
     2431                     and tt-BatchProcess.BP_ExecSysTimeInt < m-time
     2432                   )
     2433               )
     2434         no-error.
     2435         if available tt-BatchProcess
     2436         then
     2437            vRun = yes.
     2438         else do:
     2439            find first tt-BatchProcess no-lock no-error.
     2440            if not available tt-BatchProcess
     2441            then
     2442               vRun = yes.
     2443         end.
     2444         if    vRun
     2445            or mstart
     2446         then do:
     2447            for each  tt-BatchProcess :
     2448               delete tt-BatchProcess .
     2449            end.
     2450            run adm/autoconn.p no-error.
     2451            if error-status :error
     2452            then do:
     2453               run write-to-log ( substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1) ) ).
     2454               if valid-handle(automain) then
     2455               assign
     2456                  automain:title = mtitle
     2457               .
     2458            end.
     2459            else do:
     2460               run checkConect (input  if valid-handle(automain) then automain:title else i-auto-type,
     2461                                input  i-auto-type,
     2462                                output mDbNum,
     2463                                output mDbInfo) no-error.
     2464               if error-status:error
     2465               then do:
     2466                  if return-value = "WaitOK"
     2467                  then
     2468                     next main-cycl .
     2469                  else if return-value eq "HandMode"
     2470                  then
     2471                     apply "choose" to b-hand in frame f-amain.
     2472                  log-exit = true.
     2473                  leave main-cycl .
     2474               end.
     2475               run CheckUpdate no-error.
     2476               if error-status :error then do:
     2477                  run write-to-log ( substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1) ) ).
     2478                  return error return-value.
     2479               end.
     2480              run adm/chk-sch.p
     2481                 ( input  i-auto-type
     2482                 , input  mfordb
     2483                 , output mlistdb
     2484                 , output mlistdball
     2485                 , output mlistkey
     2486                 , output mlistkeyall
     2487                 , input mforextsys
     2488                 , input mforproc
     2489                 , output table tt-BatchProcess
     2490                 ) no-error.
     2491              if error-status :error
     2492              then do:
     2493                 run write-to-log( vss-workfile + chr(32)
     2494                                 + "Ошибка при чтении расписания." + chr(10)
     2495                                 + error-status :get-message(error-status :num-messages) + chr(10)
     2496                                 + return-value
     2497                                ) .
     2498                 run gbl/dbdiscon.p no-error.
     2499                 if error-status :error then do:
     2500                    run write-to-log (  substitute( "&1. Не удалось отсоединиться от БД&2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message(1) ) ).
     2501                 end.
     2502                 assign
     2503                    log-exit = true
     2504                 .
     2505                 leave main-cycl .
     2506              end.
     2507              if valid-handle(automain) then
     2508                automain:title = mtitle + chr(32) + mdbinfo.
     2509              if mstart
     2510              then
     2511                 assign
     2512                    mlistdb  = mlistdball
     2513                    mlistkey = mlistkeyall
     2514                 .
     2515              if num-entries( mlistdb ) > 0
     2516              then do:
     2517                 run write-to-log ( "Текущая" + chr(32) + mdbinfo ) no-error.
     2518                 if error-status:error
     2519                 then do:
     2520                    run write-to-screen (return-value).
     2521                 end.
     2522   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2523   define variable v-uh9 as handle no-undo .
     2524   define variable v-found9 as logical no-undo .
     2525   v-uh9 = session:first-procedure no-error.
     2526   do while valid-handle(v-uh9):
     2527     if v-uh9:type = "PROCEDURE" then do:
     2528       if v-uh9:file-name = "gbl/mainproc.p" then do:
     2529         v-found9 = yes.
     2530         leave.
     2531       end.
     2532     end.
     2533     v-uh9 = v-uh9:next-sibling no-error.
     2534   end.
     2535   if not v-found9 then do:
     2536     run gbl/mainproc.p persistent.
     2537   end.
     2538                 if lookup (i-auto-type , mAsyncHelper:getListTask()) eq 0
     2539                 then
     2540                    run startproc (i-auto-type
     2541                                  ,mlistdb
     2542                                  ,mListKey
     2543                                  ,mAsyncHelper:getnowDay()
     2544                                ).
     2545              end.
     2546            find first tt-BatchProcess no-lock
     2547            where
     2548            ( tt-BatchProcess.BP_ExecSysDate > mtoday
     2549                 or (tt-BatchProcess.BP_ExecSysDate = mtoday
     2550                     and tt-BatchProcess.BP_ExecSysTimeInt > mtime
     2551                   )
     2552               )
     2553            no-error.
     2554            if not available tt-BatchProcess
     2555            then do:
     2556               run adm/wr-n-bp.p
     2557                 ( input this-procedure:handle
     2558                  ,input mSessionBegin
     2559                  ,input i-auto-type
     2560                  ,input mListDb
     2561                  ,input mForExtsys
     2562                  ,input mForProc
     2563                 ) no-error.
     2564               if error-status :error
     2565               then do:
     2566                  run write-to-log( vss-workfile + chr(32)
     2567                                   + "Ошибка при анализе начала следующего сеанса" + chr(10)
     2568                                   + error-status :get-message(error-status :num-messages) + chr(10)
     2569                                   + return-value
     2570                                 ) no-error.
     2571                  if error-status:error
     2572                  then do:
     2573                     run write-to-screen (return-value).
     2574                  end.
     2575               end.
     2576               else do:
     2577                  assign
     2578                     mSessionBegin = false
     2579                  .
     2580               end.
     2581               run adm/chk-sch.p
     2582                  ( input  i-auto-type
     2583                  , input  mfordb
     2584                  , output mlistdb
     2585                  , output mlistdball
     2586                  , output mlistkey
     2587                  , output mlistkeyall
     2588                  , input mforextsys
     2589                  , input mforproc
     2590                  , output table tt-BatchProcess
     2591                  ) no-error.
     2592               if error-status :error
     2593               then do:
     2594                  run write-to-log( vss-workfile + chr(32)
     2595                                + "Ошибка при чтении расписания." + chr(10)
     2596                                + error-status :get-message(error-status :num-messages) + chr(10)
     2597                                + return-value
     2598                              ) .
     2599              end.
     2600            end.
     2601            run gbl/dbdiscon.p no-error.
     2602            if error-status :error then do:
     2603              run write-to-log (  substitute( "&1. Не удалось отсоединиться от БД&2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message(1) ) ) no-error.
     2604              if error-status:error
     2605              then do:
     2606                run write-to-screen (return-value).
     2607              end.
     2608            end.
     2609         end.
     2610      end.
     2611      if mAsyncHelper:isWorkShed()
     2612      then do:
     2613         define variable vListTask as character no-undo.
     2614         vListTask = mAsyncHelper:getListWorkShed().
     2615         run write-to-log ( substitute( "Ожидаем выполнение асихронных процессов: &1.", vListTask) ).
     2616         run waitproc("Ожидаем получение данных").
     2617         run write-to-log ( "Асихронные процессы выполнены .").
     2618      end.
     2619      assign
     2620         start-time = etime
     2621       .
     2622       mStart = no.
     2623       do while not log-exit:
     2624         if mHiddenMode = false then do:
     2625           wait-for
     2626             go of frame f-amain
     2627             or close of this-procedure
     2628             or choose of b-hand in frame f-amain
     2629             or choose of b-help in frame f-amain
     2630             or choose of b-prop in frame f-amain
     2631             or choose of b-start in frame f-amain
     2632             focus frame f-amain
     2633             pause 1
     2634           .
     2635           display
     2636             string( time, "HH:MM:SS" ) @ curr-time
     2637             today @ curr-date
     2638             with frame f-amain
     2639             no-error
     2640           .
     2641         end.
     2642         else do:
     2643           if not session:batch-mode then
     2644             wait-for
     2645               go of frame f-amain
     2646               or close of this-procedure
     2647               pause 1
     2648             .
     2649           else
     2650             pause 1.
     2651         end.
     2652         if not session:batch-mode then
     2653           run ReedFileContext.
     2654         if mHiddenMode = false
     2655           and frame f-amain:visible = false
     2656         then do:
     2657           run myenable in this-procedure
     2658             ( input i-auto-type
     2659             ) .
     2660         end.
     2661         if mHiddenMode = true
     2662           and frame f-amain:visible = true
     2663         then do:
     2664           run myhide in this-procedure .
     2665         end.
     2666         if    mStart
     2667            or etime - start-time > 60000
     2668            or time mod 60 = 1
     2669         then do:
     2670           leave .
     2671         end.
     2672       end.
     2673       if mHiddenMode = false then do:
     2674         display
     2675           "" @ curr-time
     2676           "" @ curr-date
     2677           with frame f-amain
     2678           no-error
     2679         .
     2680       end.
     2681     end.
     2682     delete object mAsyncHelper.
     2683     case i-auto-type :
     2684       when 'autonws':U
     2685       then do:
     2686         run write-to-log ( "Закончен сеанс работы с системой передачи новостей" ) no-error.
     2687         if error-status:error
     2688         then do:
     2689           run write-to-screen (return-value).
     2690         end.
     2691       end.
     2692       when 'autoarh':U
     2693       then do:
     2694         run write-to-log ( "Закончен сеанс работы с системой автоматического расчета архивов" ).
     2695       end.
     2696       when 'autoexp':U
     2697       then do:
     2698         run write-to-log ( "Закончен сеанс работы с системой автоматического экспорта" ).
     2699       end.
     2700       when 'autooxml':U
     2701       then do:
     2702         run write-to-log ( "Закончен сеанс работы с системой OpenXML" ).
     2703       end.
     2704       when 'autogcd':U
     2705       then do:
     2706         run write-to-log ( "Закончен сеанс работы с системой автоматического приема информации с кассы" ).
     2707       end.
     2708       when 'autosuz':U
     2709       then do:
     2710         run write-to-log ( "Закончен сеанс работы с системой автоматического запуска отчетов" ).
     2711       end.
     2712       when 'autosale':U
     2713       then do:
     2714         run write-to-log ( "Закончен сеанс работы с системой автоматической обработки документов продаж" ).
     2715       end.
     2716       when 'autocbnk':U
     2717       then do:
     2718         run write-to-log ( "Закончен сеанс работы с системой автоматической эксп/имп в КЛИЕНТ-БАНК" ).
     2719       end.
     2720       when 'sktsrv':U
     2721       then do:
     2722         run write-to-log ( "Закончен сеанс работы Сокет-Сервера" ).
     2723       end.
     2724       when 'autofree':U
     2725       then do:
     2726         run write-to-log ( "Закончен сеанс работы с системой автоматической выполнения произвольных заданий" ).
     2727       end.
     2728       when 'mercury':U
     2729       then do:
     2730         run write-to-log ( "Закончен сеанс работы с ФГИС Меркурий" ).
     2731       end.
     2732       when 'is_motp':U
     2733       then do:
     2734         run write-to-log ( "Закончен сеанс работы с ИС МОТП" ).
     2735       end.
     2736       when 'is_diadoc':U
     2737       then do:
     2738         run write-to-log ( "Закончен сеанс работы с ИС Диадок" ).
     2739       end.
     2740       otherwise do:
     2741         run write-to-log ( "Закончен сеанс работы с системой ....." ).
     2742       end.
     2743     end case.
     2744     assign
     2745       g#auto = FALSE
     2746     .
     2747     RUN disable_UI.
     2748   END.
     2749   PROCEDURE disable_UI :
     2750     IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(automain)
     2751     THEN DELETE WIDGET automain.
     2752     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     2753   END PROCEDURE.
     2754   PROCEDURE enable_UI :
     2755     DISPLAY auto-log curr-date curr-time
     2756         WITH FRAME f-amain IN WINDOW automain.
     2757     ENABLE b-exit b-help auto-log
     2758         WITH FRAME f-amain IN WINDOW automain.
     2759     VIEW automain.
     2760   END PROCEDURE.
     2761   PROCEDURE hide-message :
     2762   assign
     2763       f-msg = "":U
     2764     .
     2765     if not session:batch-mode then
     2766       hide f-msg in frame f-amain.
     2767     return .
     2768   END PROCEDURE.
     2769   PROCEDURE myenable :
     2770     define input  parameter pe-auto-type as character no-undo .
     2771     IF VALID-HANDLE(automain) THEN
     2772     DO:
     2773     assign
     2774       automain:HIDDEN = false
     2775     .
     2776     run enable_UI.
     2777     if pe-auto-type = 'autonws':U
     2778       or pe-auto-type = 'autooxml':U
     2779     then do:
     2780       enable b-hand b-prop with frame f-amain.
     2781     end.
     2782     if session:debug-alert
     2783     then do:
     2784       enable b-start b-prop with frame f-amain.
     2785     end.
     2786     END.
     2787   END PROCEDURE.
     2788   PROCEDURE myhide :
     2789     disable all with frame f-amain .
     2790     hide all no-pause in window automain .
     2791     if VALID-HANDLE(automain) then
     2792     assign
     2793       automain:HIDDEN = true
     2794     .
     2795   END PROCEDURE.
     2796   PROCEDURE write-message :
     2797   define input  parameter p-msg as character no-undo .
     2798     assign
     2799       f-msg = p-msg
     2800     .
     2801     if not session:batch-mode then
     2802     do:
     2803     enable f-msg with frame f-amain.
     2804     if mHiddenMode = false then
     2805     display
     2806       f-msg
     2807       with frame f-amain
     2808       .
     2809     end.
     2810     return .
     2811   END PROCEDURE.
