        1   CREATE WIDGET-POOL.
        2   define input parameter i-auto-type as character no-undo .
        3   define input parameter i-mode      as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Главное окно запуска автоматических процедур по расписанию".
       10   define variable mAsyncHelper as class ibs.th.file.AsyncHelperth  no-undo.
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define new  shared variable g#auto as logical no-undo.
       72   define new  shared variable g#news as logical no-undo.
       73   define new  shared variable g#oxml as logical no-undo.
       74   define new  shared variable g#esys as logical no-undo.
       75   define new  shared variable g#news-source-db as integer no-undo.
       76   define new  shared variable g#esys-source-esys as integer no-undo.
       77   define new  shared variable g#db-num as integer   no-undo .
       78   define new  shared variable g#userid as character no-undo .
       79   define new  shared variable g#passwd as character no-undo .
       80   procedure proc-alt-shift-f2:
       81     if not ibs.th.gbl.gbl-var:rcode
       82   then
       83     run gbl\inidebug.p .
       84   end.
       85   procedure proc-alt-shift-f3:
       86     run gbl/prvssinf.p
       87       ( input this-procedure
       88       ) .
       89   end.
       90   define variable v-inform-launched as logical no-undo initial false .
       91   procedure proc-alt-shift-f4:
       92     define variable v-action as character no-undo .
       93     if v-inform-launched = false then do:
       94       assign
       95         v-inform-launched = true
       96       .
       97       run gbl/d-inform.w
       98         (  input self
       99         ,  input this-procedure
      100         , output v-action
      101         ) no-error .
      102       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      103       assign
      104         v-inform-launched = false
      105       .
      106     end.
      107   end.
      108   procedure proc-alt-f1:
      109     run gbl/corrhelp.p
      110       (input this-procedure
      111       ) .
      112   end .
      113   on alt-shift-f2 anywhere do:
      114     run proc-alt-shift-f2.
      115   end.
      116   on alt-shift-f3 anywhere do:
      117     run proc-alt-shift-f3 in this-procedure .
      118   end.
      119   on alt-shift-f4 anywhere do:
      120     run proc-alt-shift-f4 in this-procedure.
      121   end.
      122   on alt-f1 anywhere do:
      123     run proc-alt-f1 in this-procedure .
      124   end.
      125   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      126   define  shared variable g#auto-pid           as integer   no-undo .
      127   define  shared variable conn-par             as character no-undo .
      128   define  shared variable g#auto-user-id       as character no-undo .
      129   define  shared variable g#auto-user-login    as character no-undo .
      130   define  shared variable g#auto-user-password as character no-undo .
      131   define  shared variable v-socket             as logical   no-undo .
      132   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133   define  shared variable auto-window-h     as handle    no-undo .
      134   define  shared variable auto-log-msg-h    as handle    no-undo .
      135   define  shared variable hand-log-msg-h    as handle    no-undo .
      136   define  shared variable log-file-name     as character no-undo initial ? .
      137   define  shared variable add-log-file-name as character no-undo initial ? .
      138   define  shared variable writelogvalue     as character no-undo initial ? .
      139   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      140   procedure cur-time :
      141      define output parameter p-today as date      no-undo .
      142      define output parameter p-time  as integer   no-undo .
      143     do
      144     on error undo, return error
      145     :
      146       define variable v-date1 as date      no-undo .
      147       define variable v-date2 as date      no-undo .
      148       define variable v-time  as integer   no-undo .
      149       assign
      150         v-date1 = today
      151         v-time  = time
      152         v-date2 = today
      153       .
      154       if v-date1 <> v-date2
      155       then do:
      156         assign
      157           v-date1 = today
      158           v-time  = v-time
      159         .
      160       end.
      161       assign
      162         p-today = v-date1
      163         p-time  = v-time
      164       .
      165     end.
      166   end.
      167   function cur-time-date returns character
      168   :
      169     return string(today, '99/99/9999':U) .
      170   end.
      171   function cur-time-mjd returns decimal
      172   :
      173     define variable v-date as date      no-undo .
      174     define variable v-time as integer   no-undo .
      175     run cur-time in this-procedure
      176       (output v-date
      177       ,output v-time
      178       ) .
      179     return integer(v-date) - 2400002 + (v-time / 86400) .
      180   end.
      181   function cur-time-get-ending-index returns integer
      182   (input p-number as integer
      183   )
      184   :
      185     if p-number < 0
      186     or p-number = ?
      187     then do:
      188       return 1 .
      189     end.
      190     define variable v-rest as integer   no-undo .
      191     assign
      192       p-number = p-number modulo 100
      193     .
      194     if p-number < 20
      195     then do:
      196       assign
      197         v-rest = p-number
      198       .
      199     end.
      200     else do:
      201       assign
      202         v-rest = p-number modulo 10
      203       .
      204     end.
      205     case v-rest :
      206       when 1
      207       then do:
      208         return 2 .
      209       end.
      210       when 2 or
      211       when 3 or
      212       when 4
      213       then do:
      214         return 3 .
      215       end.
      216       otherwise do:
      217         return 1 .
      218       end.
      219     end case .
      220   end.
      221   procedure cur-time-mjd-to-date :
      222      define input  parameter i-mjd-diff as decimal no-undo.
      223      define output parameter o-Date     as date    no-undo.
      224      define output parameter o-Time     as integer no-undo.
      225      define variable v-day-number as integer   no-undo .
      226      if    i-mjd-diff < 0
      227         or i-mjd-diff = ?
      228      then do:
      229         return "?" .
      230      end.
      231      assign
      232         v-day-number = truncate(i-mjd-diff,0).
      233         o-Date = date(v-day-number + 2400002).
      234         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      235     .
      236   end.
      237   function cur-time-mjd-to-string returns character
      238   (input p-mjd-diff as decimal
      239   )
      240   :
      241     define variable v-day-number as integer   no-undo .
      242     define variable v-seconds    as integer   no-undo .
      243     define variable v-hour       as integer   no-undo .
      244     define variable v-min        as integer   no-undo .
      245     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      246     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      247     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      248     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      249     if p-mjd-diff < 0
      250     or p-mjd-diff = ?
      251     then do:
      252       return "?" .
      253     end.
      254     assign
      255       v-day-number = integer(truncate(p-mjd-diff,0))
      256       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      257     .
      258     if v-seconds > 86400
      259     then do:
      260       assign
      261         v-seconds = 86400 - 1
      262       .
      263     end.
      264     if v-seconds < 0
      265     then do:
      266       assign
      267         v-seconds = 0
      268       .
      269     end.
      270     assign
      271       v-hour = truncate(v-seconds / 3600, 0)
      272     .
      273     assign
      274       v-seconds = v-seconds modulo 3600
      275     .
      276     assign
      277       v-min = truncate(v-seconds / 60, 0)
      278     .
      279     assign
      280       v-seconds = v-seconds modulo 60
      281     .
      282     return
      283         (if v-day-number <> 0
      284           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      285           else ""
      286         )
      287       + (if v-day-number <> 0 or v-hour <> 0
      288           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      289           else ""
      290         )
      291       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      292           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      293           else ""
      294         )
      295       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      296       .
      297   end.
      298   function cur-time-string returns character
      299   :
      300     define variable v-date as date      no-undo .
      301     define variable v-time as integer   no-undo .
      302     run cur-time in this-procedure
      303       (output v-date
      304       ,output v-time
      305       ) .
      306     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      307   end.
      308   function cur-time-string-sec returns character
      309   :
      310     define variable v-date as date      no-undo .
      311     define variable v-time as integer   no-undo .
      312     run cur-time in this-procedure
      313       (output v-date
      314       ,output v-time
      315       ) .
      316     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      317   end.
      318   function cur-time-custom  returns character
      319   (input p-prefix as character
      320   ,input p-date-format as character
      321   ,input p-delimiter as character
      322   ,input p-time-format as character
      323   ,input p-suffix as character
      324   )
      325   :
      326     define variable v-date as date      no-undo .
      327     define variable v-time as integer   no-undo .
      328     run cur-time in this-procedure
      329       (output v-date
      330       ,output v-time
      331       ) .
      332     return
      333       p-prefix
      334       + string(v-date, p-date-format)
      335       + p-delimiter
      336       + string(v-time, p-time-format)
      337       + p-suffix
      338       .
      339   end.
      340   function cur-time-print  returns character
      341   :
      342     define variable v-date as date      no-undo .
      343     define variable v-time as integer   no-undo .
      344     run cur-time in this-procedure
      345       (output v-date
      346       ,output v-time
      347       ) .
      348     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      349   end.
      350   function cur-time-datetime returns datetime
      351   :
      352     define variable v-char as character no-undo .
      353     define variable v-datetime as datetime no-undo .
      354     v-char = cur-time-string().
      355     v-datetime = datetime(v-char).
      356     return  v-datetime.
      357   end.
      358   function cur-time-string-msec returns character
      359   :
      360     define variable v-date as datetime  no-undo .
      361     v-date = now.
      362     return string(v-date) .
      363   end.
      364   define stream LogStream .
      365   define variable mNoTime as logical no-undo.
      366   procedure write-to-log-notime :
      367     define input param i-str as character no-undo .
      368     mNoTime = yes.
      369     run write-to-log (i-str).
      370     mNoTime = no.
      371   end.
      372   procedure write-to-log :
      373     define input param p-str as character no-undo .
      374     do
      375     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      376     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      377     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      378     :
      379       define variable log-res        as logical   no-undo .
      380       define variable v-jj           as integer   no-undo .
      381       if    mNoTime
      382          or writelogvalue eq "AsyncProc"
      383       then
      384          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      385       else
      386          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      387       if auto-log-msg-h <> ? then do:
      388         log-res = auto-log-msg-h:move-to-eof( ) .
      389         log-res = auto-log-msg-h:insert-string( p-str ).
      390       end.
      391       if hand-log-msg-h <> ? then do:
      392         log-res = hand-log-msg-h:move-to-eof( ) .
      393         log-res = hand-log-msg-h:insert-string( p-str ).
      394       end.
      395       assign
      396         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      397         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      398         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      399       .
      400       if add-log-file-name <> ? then do:
      401         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      402           run gbl/fileapnd.p
      403             ( input entry(v-jj, add-log-file-name, chr(1) )
      404             ,input p-str
      405             ,input 20
      406             ) no-error .
      407           if error-status:error then do:
      408             return error return-value .
      409           end.
      410         end.
      411       end.
      412       if writelogvalue eq "AsyncProc"
      413       then do:
      414          p-str = trim(p-str, (chr(13) + chr(10)) )
      415       .
      416          Publish "WriteLogAsunc" (p-str,yes).
      417       end.
      418       else if writelogvalue <> "yes" then do:
      419         run gbl/fileapnd.p
      420           ( input log-file-name
      421           ,input p-str
      422           ,input 20
      423           ) no-error .
      424         if error-status:error then do:
      425           return error return-value .
      426         end.
      427       end.
      428     end.
      429   end procedure.
      430   procedure write-to-screen :
      431     define input param p-str as character no-undo .
      432     do
      433     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      434     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      435     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      436     :
      437       define variable log-res as logical no-undo.
      438       assign
      439         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      440       .
      441       if auto-log-msg-h <> ?
      442       then do:
      443         log-res = auto-log-msg-h:move-to-eof( ) .
      444         log-res = auto-log-msg-h:insert-string( p-str ).
      445       end.
      446       if hand-log-msg-h <> ?
      447       then do:
      448         log-res = hand-log-msg-h:move-to-eof( ) .
      449         log-res = hand-log-msg-h:insert-string( p-str ).
      450       end.
      451     end.
      452   end procedure.
      453   procedure send-msg-to-email :
      454     define input  parameter p-subject      as character no-undo .
      455     define input  parameter p-text-err     as character no-undo .
      456     define input  parameter p-attach-files as character no-undo .
      457     do
      458     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      459     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      460     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      461     :
      462       define variable v-tth             as handle    no-undo .
      463       define variable v-value-character as character no-undo .
      464       define variable v-value-date      as date      no-undo .
      465       define variable v-value-decimal   as decimal   no-undo .
      466       define variable v-value-integer   as integer   no-undo .
      467       define variable v-value-logical   as logical   no-undo .
      468       define variable v-param-type      as character no-undo .
      469       define variable v-email       as character no-undo .
      470       define variable v-tmp-str     as character no-undo .
      471       define variable v-tmp1-str    as character no-undo .
      472       define variable v-ind         as integer   no-undo .
      473       define variable v-num-entries as integer   no-undo .
      474       delete object v-tth no-error.
      475       run adm/shattri.p
      476         ( input "get":U
      477          ,input  "":U
      478          ,input  0
      479          ,input  'auto-task':U
      480          ,input  'send-msg-to-email':U
      481          ,output v-value-character
      482          ,output v-value-date
      483          ,output v-value-decimal
      484          ,output v-value-integer
      485          ,output v-value-logical
      486          ,output v-param-type
      487          ,input-output table-handle v-tth
      488         ) no-error .
      489       if not error-status :error  then do:
      490         assign
      491           v-tmp-str = v-value-character
      492         .
      493       end.
      494       delete object v-tth no-error.
      495       assign
      496         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      497         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      498         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      499         v-num-entries = num-entries( v-tmp-str, chr(44) )
      500         v-email       = "":U
      501       .
      502       do v-ind = 1 to v-num-entries
      503       :
      504         assign
      505           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      506         .
      507         if trim( v-tmp1-str ) <> "":U then do:
      508           if v-email = "":U then do:
      509             assign
      510               v-email = v-tmp1-str
      511             .
      512           end.
      513           else do:
      514             assign
      515               v-email = v-email + chr(44) + v-tmp1-str
      516             .
      517           end.
      518         end.
      519       end.
      520       if v-email <> "":U then do:
      521         run gbl/sendmail.p
      522           ( input v-email
      523           , input p-subject
      524           , input p-text-err
      525           , input p-attach-files
      526           ) no-error .
      527         if error-status :error
      528           or return-value <> "":U
      529         then do:
      530           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      531         end.
      532       end.
      533     end.
      534   end procedure.
      535   define variable mLableText as character no-undo.
      536   define variable mStartTime as datetime-tz no-undo init ?.
      537   procedure addtask:
      538      define input  parameter ITask as character no-undo.
      539      define input  parameter iProc as character no-undo.
      540      define input  parameter iParam as character no-undo.
      541      subscribe "PutFileLogAsunc" anywhere run-procedure "WriteLogAsync".
      542      if mStartTime ne ?
      543      then
      544         mAsyncHelper:AddTask (ITask,iProc,iParam,mStartTime).
      545      else
      546         mAsyncHelper:AddTask (ITask,iProc,iParam).
      547      unsubscribe "PutFileLogAsunc".
      548   end.
      549   procedure addTaskTime:
      550      define input  parameter ITask      as character no-undo.
      551      define input  parameter iProc      as character no-undo.
      552      define input  parameter iParam     as character no-undo.
      553      define input  parameter iStartTime as datetime-tz no-undo.
      554      subscribe "PutFileLogAsunc" anywhere run-procedure "WriteLogAsync".
      555      mAsyncHelper:AddTask (ITask,iProc,iParam,iStartTime).
      556      unsubscribe "PutFileLogAsunc".
      557   end.
      558   procedure waitproc:
      559      define input  parameter itext  as character no-undo.
      560      subscribe "PutFileLogAsunc" anywhere run-procedure "WriteLogAsync".
      561      run ibs\th\file\waithelper.p (mAsyncHelper,?,1,itext + " " + mLableText).
      562      unsubscribe "PutFileLogAsunc".
      563   end.
      564   procedure waitProcLable:
      565      define input  parameter itext  as character no-undo.
      566      mLableText = itext.
      567   end.
      568   procedure waitProcShed:
      569      define input  parameter iSched as character no-undo.
      570      define input  parameter itext  as character no-undo.
      571      subscribe "PutFileLogAsunc" anywhere run-procedure "WriteLogAsync".
      572      run ibs\th\file\waithelper.p (mAsyncHelper,iSched,1,itext).
      573      unsubscribe "PutFileLogAsunc".
      574   end.
      575   procedure WriteLogAsync:
      576      define input  parameter iFile as character no-undo.
      577      define variable vText as character no-undo.
      578      define variable vFile as longchar  no-undo.
      579      define variable vfileName as character no-undo.
      580      define variable vi as int64 no-undo.
      581      define variable vStr  as character no-undo.
      582      vfileName = mAsyncHelper:objExists(iFile,"f").
      583      if vfileName ne ?
      584      then do:
      585         copy-lob from file vfileName to vFile no-error.
      586         if error-status:error
      587         then do:
      588            run write-to-log (substitute ("Не удалось прочесть файл &1",iFile)).
      589         end.
      590         else do:
      591             vFile = replace (vFile,chr(13) + chr(10),chr(10)).
      592             do vi = 1 to num-entries(vFile,chr(10)) - 1:
      593               run write-to-log-notime (entry(vi, vFile,chr(10))).
      594            end.
      595         end.
      596      end.
      597      else do:
      598          assign
      599              vtext = substitute ("Процедура обработки данных не завершена. &1",ifile).
      600          run write-to-log (vtext).
      601      end.
      602   end.
      603   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      604   define variable v-loc-counter as integer no-undo .
      605   define variable v-counter-visible as logical no-undo .
      606   define variable v-view-log as logical no-undo .
      607   define stream auto2dia.
      608   PROCEDURE write-log-and-file :
      609   do
      610   on error undo, return error
      611   :
      612     define input parameter p-tab-position   as integer   no-undo.
      613     define input parameter p-file-name      as character no-undo .
      614     define input parameter p-log-level      as integer   no-undo .
      615     define input parameter p-log-string     AS CHARacter NO-UNDO.
      616     define variable v-jj as integer   no-undo .
      617     run write-to-screen in this-procedure( input ( fill( chr(32), p-tab-position) + p-log-string)) .
      618     if p-file-name <> '':U then do:
      619       do v-jj = 1 to num-entries(p-file-name, chr(1)):
      620         run  auto2dia-writefile in this-procedure (
      621                                         input entry(v-jj, p-file-name, chr(1))
      622                                         ,input p-log-level
      623                                         ,input (p-log-string + chr(10))
      624                                       ) no-error .
      625       end.
      626     end.
      627     if writelogvalue eq "AsyncProc"
      628     then
      629        run write-to-log in this-procedure( p-log-string) .
      630   end.
      631   END PROCEDURE.
