      725   PROCEDURE write-log :
      726   do
      727   on error undo, return error
      728   :
      729   define input parameter p-tab-position   as integer      no-undo.
      730   define input parameter p-log-string     as character    no-undo.
      731   run write-to-log in this-procedure( input ( fill( chr(32), 2  * p-tab-position)  +
      732                                       (IF p-log-string = "&Line" THEN FILL("-", 80)
      733                                       ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
      734                                       ELSE p-log-string))).
      735   end.
      736   END PROCEDURE.
      737   procedure writelog :
      738   do
      739   on error undo, return error
      740   :
      741   define input parameter p-file-name AS CHAR     NO-UNDO.
      742   define input parameter p-log-level AS INTEGER  NO-UNDO.
      743   define input parameter p-log-string  AS CHAR     NO-UNDO.
      744     if p-file-name <> "" then
      745     run  auto2dia-Writefile in this-procedure (
      746                                       input p-file-name
      747                                     ,input p-log-level
      748                                     ,input p-log-string
      749                                   ) no-error .
      750      process events.
      751   end.
      752   end procedure.
      753   PROCEDURE auto2dia-writefile:
      754     define input parameter sFileName AS CHAR     NO-UNDO.
      755     define input parameter iLogLevel AS INTEGER  NO-UNDO.
      756     define input parameter sToWrite  AS CHAR     NO-UNDO.
      757     define variable v-SlashPos  as integer no-undo .
      758     define variable v-lDirName  as character no-undo .
      759     define variable v-lDirName2 as character no-undo .
      760     v-SlashPos  = maximum (  r-index(sFileName, "\"),  r-index(sFileName, "/")  ) .
      761     v-lDirName  = if v-SlashPos > 0 then substring (sFileName, 1, v-SlashPos - 1) else "".
      762     FILE-INFO:FILE-NAME = v-lDirName .
      763     v-lDirName2 = FILE-INFO:FULL-PATHNAME .
      764     if v-lDirName2 <> ? then do :
      765   OUTPUT STREAM auto2dia TO VALUE(sFileName) APPEND.
      766       PUT STREAM auto2dia UNFORMATTED chr(10).
      767       PUT STREAM auto2dia UNFORMATTED (IF (iLogLevel = 0 OR sToWrite = "&DLine"
      768                                         OR sToWrite = "&Line") THEN "" ELSE
      769                                         cur-time-string-sec() + " ").
      770       PUT STREAM auto2dia UNFORMATTED
      771               (IF sToWrite = "&Line" THEN FILL("-", 80)
      772                ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
      773                ELSE sToWrite).
      774   OUTPUT STREAM auto2dia CLOSE.
      775     end .
      776   END PROCEDURE.
