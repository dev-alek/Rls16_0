      607   procedure thbjattr_code :
      608      define input  parameter p-upper-code     as character no-undo .
      609      define input  parameter p-code           as character no-undo .
      610      define output parameter p-label          as character no-undo .
      611      define output parameter p-user-can-edit  as logical   no-undo .
      612      define output parameter p-output-display as logical   no-undo .
      613      define output parameter p-other          as character no-undo .
      614      define output parameter p-prop-list      as character no-undo .
      615      define output parameter p-prop-type-list as character no-undo .
      616      define output parameter p-prop-label-list as character no-undo .
      617      define output parameter p-global          as logical no-undo .
      618      define output parameter p-host           as logical no-undo .
      619      define output parameter p-shop           as logical no-undo .
      620      define output parameter p-store          as logical no-undo .
      621      define output parameter p-db             as logical no-undo .
      622      define variable p-region as logical no-undo.
      623      run thbjattr_code_reg in this-procedure (
      624                                               p-upper-code,
      625                                               p-code,
      626                                               output p-label,
      627                                               output p-user-can-edit,
      628                                               output p-output-display,
      629                                               output p-other,
      630                                               output p-prop-list,
      631                                               output p-prop-type-list,
      632                                               output p-prop-label-list,
      633                                               output p-global,
      634                                               output p-host,
      635                                               output p-shop,
      636                                               output p-store,
      637                                               output p-db,
      638                                               output p-region
      639                                               ).
      640   end procedure.
      641   procedure thbjattr_code_reg :
      642   define input  parameter p-upper-code     as character no-undo .
      643   define input  parameter p-code           as character no-undo .
      644   define output parameter p-label          as character no-undo .
      645   define output parameter p-user-can-edit  as logical   no-undo .
      646   define output parameter p-output-display as logical   no-undo .
      647   define output parameter p-other          as character no-undo .
      648   define output parameter p-prop-list      as character no-undo .
      649   define output parameter p-prop-type-list as character no-undo .
      650   define output parameter p-prop-label-list as character no-undo .
      651   define output parameter p-global          as logical no-undo .
      652   define output parameter p-host           as logical no-undo .
      653   define output parameter p-shop           as logical no-undo .
      654   define output parameter p-store          as logical no-undo .
      655   define output parameter p-db             as logical no-undo .
      656   define output parameter p-region         as logical no-undo .
      657   do
      658   on error undo, return error return-value
      659   :
      660       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      661       (input  p-upper-code
      662       ,input  p-code
      663       ,output p-label
      664       ,output p-user-can-edit
      665       ,output p-output-display
      666       ,output p-other
      667       ,output p-prop-list
      668       ,output p-prop-type-list
      669       ,output p-prop-label-list
      670       ,output p-global
      671       ,output p-host
      672       ,output p-shop
      673       ,output p-store
      674       ,output p-db
      675       ,output p-region
      676       ) no-error .
      677     if error-status :error
      678     then do:
      679       undo, return error substitute( "&1. &2&3&4", vss-include-info2, return-value, chr(10), error-status :get-message (1)).
      680     end.
      681   end.
      682   end procedure.
