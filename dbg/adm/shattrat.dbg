      901       ) .
      902   end.
      903   define variable v-inform-launched as logical no-undo initial false .
      904   procedure proc-alt-shift-f4:
      905     define variable v-action as character no-undo .
      906     if v-inform-launched = false then do:
      907       assign
      908         v-inform-launched = true
      909       .
      910       run gbl/d-inform.w
      911         (  input self
      912         ,  input this-procedure
      913         , output v-action
      914         ) no-error .
      915       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      916       assign
      917         v-inform-launched = false
      918       .
      919     end.
      920   end.
      921   procedure proc-alt-f1:
      922     run gbl/corrhelp.p
      923       (input this-procedure
      924       ) .
      925   end .
      926   on alt-shift-f2 anywhere do:
      927     run proc-alt-shift-f2.
      928   end.
      929   on alt-shift-f3 anywhere do:
      930     run proc-alt-shift-f3 in this-procedure .
      931   end.
      932   on alt-shift-f4 anywhere do:
      933     run proc-alt-shift-f4 in this-procedure.
      934   end.
      935   on alt-f1 anywhere do:
      936     run proc-alt-f1 in this-procedure .
      937   end.
      938   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      939     define variable v-cntxt-db-num        as integer   no-undo .
      940     define variable v-cntxt-userid        as character no-undo .
      941     define variable v-cntxt-level         as character no-undo .
      942     define variable v-cntxt-host-code-obj as integer   no-undo .
      943     define variable v-cntxt-obj-type      as character no-undo .
      944     define variable v-cntxt-obj-code      as integer   no-undo .
      945     define variable v-cntxt-db-num-obj    as integer   no-undo .
      946     define variable v-cntxt-is-admin      as logical   no-undo .
      947   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      948   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      949   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      950   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      951   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      952   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      953   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      954   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      955   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      956   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      957   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      958   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      959   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      960   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      961   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      962   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      963   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      964   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      965   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      966   define variable v-tth           as handle   no-undo .
      967   define variable v-to-create     as logical  no-undo .
      968   DEFINE BUTTON B-exit AUTO-GO
      969        LABEL "&Ввод"
      970        SIZE 10 BY 1
      971        BGCOLOR 8 .
      972   DEFINE BUTTON B-Help
      973        LABEL "Помо&щь"
      974        SIZE 10 BY 1
      975        BGCOLOR 8 .
      976   DEFINE BUTTON b-quit AUTO-END-KEY
      977        LABEL "&Отмена"
      978        SIZE 10 BY 1
      979        BGCOLOR 8 .
      980   DEFINE VARIABLE f-email-list AS CHARACTER
      981        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
      982        SIZE 55 BY 5 DROP-TARGET NO-UNDO.
      983   DEFINE VARIABLE f-user-list AS CHARACTER FORMAT "x(8)"
      984        VIEW-AS FILL-IN
      985        SIZE 55 BY 1 DROP-TARGET NO-UNDO.
      986   DEFINE VARIABLE label-email-list AS CHARACTER FORMAT "X(256)":U INITIAL "Список email для отправки сообщений"
      987         VIEW-AS TEXT
      988        SIZE 47.5 BY .67 NO-UNDO.
      989   DEFINE VARIABLE label-user-list AS CHARACTER FORMAT "X(256)":U INITIAL "Список логинов исключенных из проверки подключений при обновление системы"
      990         VIEW-AS TEXT
      991        SIZE 75 BY .67 NO-UNDO.
      992   DEFINE VARIABLE maxColMarks AS INTEGER FORMAT "->>>>,>>>,>>9":U INITIAL 1000
      993        LABEL "Максимальное количество очищаемых марок"
      994        VIEW-AS FILL-IN
      995        SIZE 14 BY 1 NO-UNDO.
      996   DEFINE FRAME shattrat
      997        B-exit AT ROW 1 COL 1 WIDGET-ID 2
      998        b-quit AT ROW 1 COL 11 WIDGET-ID 6
      999        B-Help AT ROW 1 COL 50 WIDGET-ID 4
     1000        f-email-list AT ROW 3.74 COL 4.5 NO-LABEL WIDGET-ID 22
     1001        f-user-list AT ROW 10.74 COL 2.5 COLON-ALIGNED NO-LABEL WIDGET-ID 22
     1002        maxColMarks AT ROW 11.89 COL 43.38 COLON-ALIGNED WIDGET-ID 30
     1003        label-email-list AT ROW 2.74 COL 2.5 NO-LABEL WIDGET-ID 28
     1004        label-user-list AT ROW 9.74 COL 2.5 NO-LABEL WIDGET-ID 28
     1005        SPACE(0.99) SKIP(3.54)
     1006       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1007            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1008            TITLE "Настройки АВТОПРОЦЕССОВ" WIDGET-ID 100.
     1009   ASSIGN
     1010          FRAME shattrat:SCROLLABLE       = FALSE.
     1011   ASSIGN
     1012          label-email-list:READ-ONLY IN FRAME shattrat        = TRUE.
     1013   ASSIGN
     1014          label-user-list:READ-ONLY IN FRAME shattrat        = TRUE.
     1015   ON WINDOW-CLOSE OF FRAME shattrat
     1016   DO:
     1017     APPLY "END-ERROR":U TO SELF.
     1018   END.
     1019   ON CHOOSE OF B-exit IN FRAME shattrat
     1020   DO:
     1021     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
     1022     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1023   END.
     1024   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME shattrat:PARENT eq ?
     1025   THEN FRAME shattrat:PARENT = ACTIVE-WINDOW.
     1026   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1027   on help of frame shattrat
     1028   do:
     1029     run gbl/app_help.p
     1030       (input this-procedure :file-name
     1031       ,input ''
     1032       ,input ?
     1033       ) no-error.
     1034     if error-status :error then do:
     1035       message
     1036         "Ошибка при вызове помощи"
     1037         error-status :get-message(1)
     1038         view-as alert-box .
     1039     end.
     1040   end.
     1041   run minbtn-set in this-procedure .
     1042   on choose of b-help in frame shattrat
     1043   do:
     1044     apply "help":u to frame shattrat .
     1045   end.
     1046   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1047   procedure minbtn-set :
     1048       do
     1049           on error undo, return error return-value
     1050           :
     1051           define variable ii              as integer       no-undo .
     1052           define variable fh              as widget-handle no-undo .
     1053           define variable hh              as widget-handle no-undo .
     1054           define variable v-h             as handle        extent 4 no-undo .
     1055           define variable v-name-button   as character     no-undo .
     1056           define variable v-help-old-x    as decimal       no-undo .
     1057           define variable v-help-old-y    as decimal       no-undo .
     1058           define variable v-help-old-size as decimal       no-undo .
     1059           define variable v-frame-width   as decimal       no-undo .
     1060           define variable jj              as integer       no-undo .
     1061           do
     1062               on error undo, return error
     1063               :
     1064               assign
     1065                   v-frame-width = frame shattrat:width - 0.3
     1066                   fh            = frame shattrat:first-child
     1067                   hh            = fh:first-child
     1068                   ii            = 1
     1069                   .
     1070               do while valid-handle(hh):
     1071                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1072                   do:
     1073                       case lc(hh:name) :
     1074                           when "b-help" then
     1075                               do:
     1076                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1077                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1078                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1079                                   hh:TOOLTIP = "Помощь" .
     1080                                   v-help-old-x = hh:column .
     1081                                   v-help-old-y = hh:row    .
     1082                                   v-help-old-size = hh:width .
     1083                                   hh:width-chars = 2.5 .
     1084                               end.
     1085                           when "b-print" then
     1086                               do:
     1087                                   hh:load-image("cmp/b-print.bmp":u) .
     1088                                   hh:TOOLTIP = "Печать" .
     1089                                   v-h[ii] = hh:handle .
     1090                                   ii = ii + 1 .
     1091                                   hh:width-chars = 3 .
     1092                               end.
     1093                           when "b-history" or
     1094                           when "b-hist" then
     1095                               do:
     1096                                   hh:load-image("cmp/b-hist.bmp":u) .
     1097                                   hh:TOOLTIP = "История" .
     1098                                   v-h[ii] = hh:handle .
     1099                                   ii = ii + 1 .
     1100                                   hh:width-chars = 3 .
     1101                               end.
     1102                           when "b-sch" then
     1103                               do:
     1104                                   hh:load-image("cmp/b-sch.bmp":u) .
     1105                                   hh:TOOLTIP = "Установка Фильтра" .
     1106                                   v-h[ii] = hh:handle .
     1107                                   ii = ii + 1 .
     1108                                   hh:width-chars = 3 .
     1109                               end.
     1110                           when "b-hist-user" then
     1111                               do:
     1112                                   hh:load-image("cmp/b-hist.bmp":u) .
     1113                                   hh:TOOLTIP = "История пользователя" .
     1114                                   ii = ii + 1 .
     1115                               end.
     1116                       end case.
     1117                   end.
     1118                   hh = hh:next-sibling.
     1119               end.
     1120               b-help:column = v-frame-width - b-help:width-chars.
     1121               jj = 0.
     1122               repeat ii = 4 to 1 by -1 :
     1123                   if valid-handle (v-h[ii] ) then
     1124                   do:
     1125                       jj  = jj + 1 .
     1126                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1127                       v-h[ii]:row    = v-help-old-y .
     1128                   end.
     1129               end.
     1130           end.
     1131       end.
     1132   end procedure.
     1133   MAIN-BLOCK:
     1134   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1135      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1136   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1137     run mainmenu_getcntxt in parparentproc
     1138       (output v-cntxt-db-num
     1139       ,output v-cntxt-userid
     1140       ,output v-cntxt-level
     1141       ,output v-cntxt-host-code-obj
     1142       ,output v-cntxt-obj-type
     1143       ,output v-cntxt-obj-code
     1144       ,output v-cntxt-db-num-obj
     1145       ,output v-cntxt-is-admin
     1146       ) .
     1147     if  p-mode <> 'ПРОСМОТР':U
     1148       and p-mode <> 'ИЗМЕНЕНИЕ':U
     1149     then do:
     1150         message
     1151         vss-workfile vss-revision vss-description skip
     1152         "Неверное значение параметра p-mode" p-mode
     1153         view-as alert-box error.
     1154         undo, return error.
     1155     end.
     1156     if p-obj-type <> 'БД':U
     1157       and p-obj-type <> '':u
     1158     then do:
     1159         message
     1160         vss-workfile vss-revision vss-description skip
     1161         "Неверное значение параметра p-obj-type" p-obj-type
     1162         view-as alert-box error.
     1163         undo, return error.
     1164     end.
     1165     if p-obj-type = '':U then do:
     1166       if v-cntxt-db-num <> 0
     1167         and p-mode <> 'ПРОСМОТР':U
     1168       then do:
     1169           MESSAGE
     1170           "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" skip
     1171           VIEW-AS ALERT-BOX ERROR.
     1172           UNDO, RETURN ERROR.
     1173       end.
     1174     end.
     1175     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     1176       find first locked_thbj-attr exclusive-lock
     1177         where locked_thbj-attr.obj-type = p-obj-type
     1178           and locked_thbj-attr.obj-code = p-obj-code
     1179           and locked_thbj-attr.upper-prop-code = 'auto-task':U
     1180           and locked_thbj-attr.prop-code = "":u
     1181       no-wait no-error.
     1182       if locked locked_thbj-attr then do:
     1183         message
     1184           vss-workfile vss-revision vss-description skip
     1185           "Запись ПАРАМЕТРЫ(АТРИБУТЫ) занята"
     1186         view-as alert-box error .
     1187         undo, return error.
     1188       end.
     1189     end.
     1190     else do:
     1191       find first locked_thbj-attr no-lock
     1192         where locked_thbj-attr.obj-type = p-obj-type
     1193           and locked_thbj-attr.obj-code = p-obj-code
     1194           and locked_thbj-attr.upper-prop-code = 'auto-task':U
     1195           and locked_thbj-attr.prop-code = '':u
     1196         no-error.
     1197     end.
     1198     if not available locked_thbj-attr then do:
     1199       assign
     1200         v-to-create  = yes
     1201       .
     1202       message
     1203         substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ", chr(10) )
     1204         view-as alert-box warning .
     1205     end.
     1206     assign
     1207       v-tth = buffer thbjattr_thbj-attr:table-handle
     1208     .
     1209     run fill-widgets in this-procedure no-error.
     1210     if error-status:error then undo, return error.
     1211     RUN enable_UI.
     1212     if p-mode = 'ПРОСМОТР':U then do:
     1213       disable
     1214         all
     1215         with frame shattrat
     1216         .
     1217       enable
     1218         b-exit
     1219         b-help
     1220         with frame shattrat
     1221         .
     1222        assign
     1223          b-exit:label = "Вы&ход"
     1224        .
     1225        hide b-quit in frame shattrat .
     1226     end.
     1227     if p-obj-type <> '':U then
     1228     do:
     1229       hide maxColMarks  in frame shattrat .
     1230     end.
     1231     WAIT-FOR GO OF FRAME shattrat.
     1232   END.
     1233   RUN disable_UI.
     1234   PROCEDURE disable_UI :
     1235     HIDE FRAME shattrat.
     1236   END PROCEDURE.
     1237   PROCEDURE enable_UI :
     1238     DISPLAY f-email-list f-user-list maxColMarks label-email-list label-user-list
     1239         WITH FRAME shattrat.
     1240     ENABLE B-exit b-quit B-Help f-email-list f-user-list maxColMarks
     1241         WITH FRAME shattrat.
     1242   END PROCEDURE.
     1243   PROCEDURE fill-widgets :
     1244   define variable v-param-type      as character  no-undo .
     1245   define variable v-value-character as character  no-undo .
     1246   define variable v-value-date      as date       no-undo .
     1247   define variable v-value-decimal   as decimal    no-undo .
     1248   define variable v-value-integer   as integer    no-undo .
     1249   define variable v-value-logical   as logical    no-undo .
     1250   define variable v-entry           as character  no-undo .
     1251   do
     1252   on error undo, return error return-value
     1253   :
     1254     for each thbjattr_thbj-attr
     1255     :
     1256       delete thbjattr_thbj-attr .
     1257     end.
     1258     for each temp-thbj-attr
     1259     :
     1260       delete temp-thbj-attr .
     1261     end.
     1262     run adm/shattri.p
     1263       ( input "init":U
     1264       , input p-obj-type
     1265       , input p-obj-code
     1266       , input 'auto-task':U
     1267       , input "":U
     1268       , output v-value-character
     1269       , output v-value-date
     1270       , output v-value-decimal
     1271       , output v-value-integer
     1272       , output v-value-logical
     1273       , output v-param-type
     1274       , INPUT-OUTPUT table-handle v-tth
     1275       ) no-error .
     1276     if error-status:error
     1277       and not available locked_thbj-attr
     1278     then do:
     1279       message
     1280       "Не удалось получить начальные значения настроек" skip
     1281       error-status:get-message(1) return-value
     1282       view-as alert-box error .
     1283       undo, return error .
     1284     end.
     1285     for each thbjattr_thbj-attr:
     1286       assign
     1287         v-entry = thbjattr_thbj-attr.prop-code
     1288       .
     1289       case v-entry:
     1290         when 'send-msg-to-email':U then do:
     1291           assign
     1292             f-email-list  = thbjattr_thbj-attr.property-value-character
     1293             f-email-list  :private-data in frame shattrat = "recid=" + string(recid(thbjattr_thbj-attr))
     1294           .
     1295         end.
     1296         when 'user-list':U then do:
     1297           assign
     1298             f-user-list  = thbjattr_thbj-attr.property-value-character
     1299             f-user-list  :private-data in frame shattrat = "recid=" + string(recid(thbjattr_thbj-attr))
     1300           .
     1301         end.
     1302         when 'maxColMarks':U then do:
     1303           assign
     1304             maxColMarks  = thbjattr_thbj-attr.property-value-integer
     1305             maxColMarks  :private-data in frame shattrat = "recid=" + string(recid(thbjattr_thbj-attr))
     1306           .
     1307         end.
     1308       end case.
     1309       create temp-thbj-attr.
     1310       buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     1311     end.
     1312   end.
     1313   END PROCEDURE.
     1314   PROCEDURE proc-save :
     1315   define variable v-value-character as character      no-undo .
     1316   define variable v-value-date      as date           no-undo .
     1317   define variable v-value-decimal   as decimal        no-undo .
     1318   define variable v-value-integer   as integer        no-undo .
     1319   define variable v-value-logical   as logical        no-undo .
     1320   define variable v-sale-add        as character      no-undo .
     1321   define variable v-param-type      as character      no-undo .
     1322   define variable wh                as widget-handle  no-undo .
     1323   define variable fh                as widget-handle  no-undo .
     1324   define variable v-same            as logical        no-undo .
     1325   do
     1326   on error undo, return error return-value
     1327   :
     1328     if p-mode = 'ПРОСМОТР':U then do:
     1329       return .
     1330     end.
     1331     assign
     1332       frame shattrat f-email-list
     1333       frame shattrat f-user-list
     1334       fh = frame shattrat:first-child
     1335       wh = fh:first-child
     1336     .
     1337     do while valid-handle(wh):
     1338       if wh:private-data begins "recid=" then do:
     1339         find first thbjattr_thbj-attr
     1340           where recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '='))
     1341         .
     1342         assign
     1343           buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value
     1344         .
     1345       end.
     1346       wh = wh:next-sibling.
     1347     end.
     1348     assign
     1349       v-same = yes
     1350     .
     1351     for each thbjattr_thbj-attr,
     1352         first temp-thbj-attr
     1353           where temp-thbj-attr.obj-type         = thbjattr_thbj-attr.obj-type
     1354             and temp-thbj-attr.obj-code         = thbjattr_thbj-attr.obj-code
     1355             and temp-thbj-attr.upper-prop-code  = thbjattr_thbj-attr.upper-prop-code
     1356             and temp-thbj-attr.prop-code        = thbjattr_thbj-attr.prop-code
     1357     :
     1358       buffer-compare thbjattr_thbj-attr to temp-thbj-attr save result in v-same.
     1359       if v-same = false then do:
     1360         leave.
     1361       end.
     1362     end.
     1363     if v-same = true
     1364       and v-to-create = false
     1365     then do:
     1366       return.
     1367     end.
     1368     run adm/shattri.p
     1369       ( input "check":U
     1370       , input p-obj-type
     1371       , input p-obj-code
     1372       , input 'auto-task':U
     1373       , INPUT '':U
     1374       , output v-value-character
     1375       , output v-value-date
     1376       , output v-value-decimal
     1377       , output v-value-integer
     1378       , output v-value-logical
     1379       , output v-param-type
     1380       , input-output table-handle v-tth
     1381       ) no-error .
     1382     if error-status :error then do:
     1383       message
     1384         "Некорректное значение ПАРАМЕТРОВ"  skip
     1385         error-status:get-message(1)         skip
     1386         return-value
     1387       view-as alert-box error .
     1388       undo, return error .
     1389     end.
     1390     run thbjattr_set-section in this-procedure
     1391       ( input p-obj-type
     1392       , input p-obj-code
     1393       , input 'auto-task':U
     1394       , input table thbjattr_thbj-attr
     1395       ) no-error.
     1396     if error-status:error then do:
     1397       message
     1398         error-status:get-message(1)  skip
     1399         return-value
     1400       view-as alert-box.
     1401       undo, return error.
     1402     end.
     1403   end.
     1404   END PROCEDURE.
