        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U.
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U.
        5   define variable vss-workfile    as character no-undo init "$Workfile: cnf-db.p $":U.
        6   define variable vss-archive     as character no-undo init "$Archive: adm/cnf-db.p $":U.
        7   define variable vss-description as character no-undo init "Процедуры работы с таблицей конфигурации".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define  shared temp-table cnf no-undo
       67       field param-code    as character   format "x(8)"        column-label "Код"                               field param-type    as character                        column-label "Тип"                               field param-value   as character   format "x(250)"      column-label "Значение"                          field param-encoded as character                        column-label "Кодированное значение"             field host-code     as integer                          column-label "Фирма"                             field obj-type      as character                        column-label "Тип объекта"                       field obj-code      as integer     format ">>>>>>"      column-label "Код объекта"                       field conf-type     as character                        column-label "Кодировка"                         field beg-date      as date                             column-label "Начало действия параметра"         field end-date      as date                             column-label "Окончание действия параметра"      field db-num        as integer     format ">>>>>"       column-label "БД"                                field stts          as integer                          column-label "Статус"
       68       field db-key        as character   format "x(12)"       column-label "Ключ БД"
       69       field param-PS      as character   format "x(40)"       column-label "PS"
       70       field param-name    as character   format "x(30)"       column-label "Название"
       71       field is-changed    as logical initial false            column-label "Изменен"
       72       field NotUsed       as logical initial False            column-label "Выключен"
       73       field ErrorExist    as integer initial 0  format ">>"   column-label "Уровень ошибки"
       74       index pi
       75         is unique
       76         param-code
       77         host-code
       78         obj-type
       79         obj-code
       80         beg-date
       81         end-date
       82         db-num
       83       index db-num
       84         db-num
       85       index db-key
       86         db-key
       87       index par-name
       88         is word-index
       89         param-name
       90       index par-value
       91         is word-index
       92         param-value
       93    .
       94   def  shared temp-table log-table no-undo
       95       field stroka       as character format "x(256)".
       96   def  shared variable err-level as integer no-undo.
       97   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       98   define  shared temp-table cnf-struct no-undo
       99     field param-code    as character
      100     field param-type    as character
      101     field data-type     as character
      102     field param-name    as character
      103     field attach-type   as character
      104     field list-value    as character
      105     field default-value as character
      106     field PS            as character
      107     field param-group   as character
      108     field user-resp     as character
      109     index by-code is unique param-code
      110   .
      111   define temp-table t_cnf-struct no-undo like cnf-struct .
      112   define stream TxtStream.
      113   define stream temp-stream .
      114   function coding-user-resp returns character
      115     ( input p-param-code as character
      116      ,input p-user-resp  as character
      117     )
      118   :
      119     return encode( p-param-code + p-user-resp ) .
      120   end function.
      121   function decoding-user-resp returns character
      122     ( input p-param-code as character
      123      ,input p-code-usr   as character
      124     )
      125   :
      126     define variable v-ind         as integer   no-undo .
      127     define variable v-user-list   as character no-undo .
      128     define variable v-num-entries as integer   no-undo .
      129     define variable v-user-resp   as character no-undo .
      130     assign
      131       v-user-list   = "Бахтадзе,Булгаков,Белоусов,Гюнтнер,Исаков,Перваков,Суслов,Уханов,Чернова,Кочетков,Степанов,Хныкин,Гридчина,Шальнев,Сливенко,Харитонов,Кирюхин,Морозов"
      132       v-num-entries = num-entries( v-user-list )
      133       v-user-resp   = "":U
      134     .
      135     block_do:
      136     do v-ind = 1 to v-num-entries :
      137       if encode( p-param-code + entry( v-ind, v-user-list ) ) = p-code-usr then do:
      138         assign
      139           v-user-resp = entry( v-ind, v-user-list )
      140         .
      141         leave block_do.
      142       end.
      143     end.
      144     if v-user-resp = "":U then do:
      145       message
      146         vss-include-info0 skip
      147         substitute( "Невозможно распознать ответственного за параметр <&1>!",  p-param-code) skip
      148         substitute( "Возможно его нет в списке." ) skip
      149         view-as alert-box error
      150       .
      151       return "unknown":U.
      152     end.
      153     else do:
      154       return v-user-resp .
      155     end.
      156   end function.
      157   function sum-enc returns character (str as character, num-rev as integer).
      158      define variable rev_incl_s as character init "" no-undo .
      159      define variable rev_incl_i as integer no-undo .
      160      define variable rev_incl_l as integer no-undo .
      161      rev_incl_l = length(str).
      162      do rev_incl_i = 1 to rev_incl_l:
      163         if rev_incl_i <= num-rev
      164           or rev_incl_l - rev_incl_i < num-rev
      165         then do:
      166           assign
      167             rev_incl_s = rev_incl_s + substr(str, rev_incl_l - rev_incl_i + 1, 1)
      168           .
      169         end.
      170         else do:
      171           assign
      172             rev_incl_s = rev_incl_s + substr(str, rev_incl_i, 1)
      173           .
      174         end.
      175      end.
      176      return rev_incl_s.
      177   end.
      178   procedure check-cfg :
      179     define input-output parameter p-param-code    as character no-undo .
      180     define input-output parameter p-param-type    as character no-undo .
      181     define input-output parameter p-data-type     as character no-undo .
      182     define input-output parameter p-param-name    as character no-undo .
      183     define input-output parameter p-attach-type   as character no-undo .
      184     define input-output parameter p-list-value    as character no-undo .
      185     define input-output parameter p-default-value as character no-undo .
      186     define input-output parameter p-param-PS      as character no-undo .
      187     define input-output parameter p-param-group   as character no-undo .
      188     define input-output parameter p-user-resp     as character no-undo .
      189     do
      190     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      191     on stop   undo, return error substitute( "&1. stop", vss-include-info0 )
      192     on endkey undo, return error substitute( "&1. endkey", vss-include-info0 )
      193     :
      194       define variable v-ind as character no-undo .
      195       assign
      196         p-param-code    = trim( p-param-code )
      197         p-param-type    = trim( p-param-type )
      198         p-data-type     = trim( p-data-type )
      199         p-param-name    = trim( p-param-name )
      200         p-attach-type   = trim( p-attach-type )
      201         p-list-value    = trim( p-list-value )
      202         p-default-value = trim( p-default-value )
      203         p-param-PS      = trim( p-param-PS )
      204         p-param-group   = trim( p-param-group )
      205         p-user-resp     = trim( p-user-resp )
      206       .
      207       if p-param-code = "":U then do:
      208         undo, return error substitute( "&1. Не задана метка параметра", vss-include-info0 ).
      209       end.
      210       if length( p-param-code ) > 8 then do:
      211         undo, return error substitute( "&1. Длина метки параметра не может превышать 8 символов (&2)", vss-include-info0, p-param-code ).
      212       end.
      213       if lookup( p-param-type, ',о,к,п':U ) = 0 then do:
      214         undo, return error substitute( '&1. Значение типа настройки "&2" не допустимо (&3)', vss-include-info0, p-param-type, p-param-code ).
      215       end.
      216       if lookup( p-param-type, 'к,п':U ) <> 0
      217         and lookup( p-attach-type, 'Нет':U ) = 0
      218       then do:
      219         undo, return error substitute( '&1. Для параметров с типом "&2" допустимы только привязки "&3" (&4)', vss-include-info0, 'к,п':U, 'Нет':U, p-param-code ).
      220       end.
      221       if p-param-name = "":U then do:
      222         undo, return error substitute( "&1. Не задано название параметра &2", vss-include-info0, p-param-code  ).
      223       end.
      224       if lookup( entry( 1, p-data-type ), "logical,integer,decimal,date,character":U ) = 0
      225         or num-entries( p-data-type ) > 2
      226         or ( num-entries( p-data-type ) = 2
      227              and entry( 2, p-data-type ) <> "list":U
      228            )
      229       then do:
      230         undo, return error substitute( "&1. Значение типа параметра &2 не допустимо (&3)", vss-include-info0, p-data-type, p-param-code ).
      231       end.
      232       if lookup( p-attach-type, 'Нет,Фирма,Объект':U ) = 0
      233       then do:
      234         undo, return error substitute( '&1. Значение привязки "&2" не допустимо (&3)', vss-include-info0, p-attach-type, p-param-code ).
      235       end.
      236     end.
      237     return.
      238   end procedure.
      239   procedure fill-cnf-struct :
      240     define input parameter p-file-name as character no-undo .
      241     do
      242     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      243     on stop   undo, return error substitute( "&1. stop", vss-workfile )
      244     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      245     :
      246       define variable v-file-name as character no-undo .
      247       define variable v-counter as integer   no-undo .
      248       define variable v-temp-fname       as character           no-undo.
      249       define variable v-last-key         as integer             no-undo .
      250       define variable v-new-line         as integer             no-undo .
      251       define variable v-read-chksum      as logical             no-undo .
      252       define variable v-md5-signature-av as character           no-undo .
      253       define variable v-md5-signature    as character           no-undo .
      254       define frame inf-cfg
      255         v-counter label "Просмотрено"
      256         with view-as dialog-box side-labels 1 columns three-d title ""
      257       .
      258       assign
      259         v-file-name = search( p-file-name )
      260       .
      261       if v-file-name = ""
      262         or v-file-name = ?
      263       then do:
      264         return error substitute( "&1. Не задан файл схемы конфигурации!", vss-include-info0 ).
      265       end.
      266       assign
      267         v-last-key         = 0
      268         v-read-chksum      = false
      269         v-md5-signature-av = "":U
      270         file-info:file-name = ".":U
      271         v-temp-fname = substitute( "&1\&2-&3-&4.tmp", file-info:full-pathname, time, etime, random( 1111111 , 9999999 ) )
      272       .
      273       input stream TxtStream from value( v-file-name ).
      274       output stream temp-stream to value(v-temp-fname) .
      275       block_read:
      276       repeat while v-last-key <> -2
      277       on error undo, return error
      278       :
      279         readkey stream TxtStream pause 0.
      280         assign
      281           v-last-key = lastkey
      282         .
      283         if chr( v-last-key ) = chr(1) then do:
      284           assign
      285             v-read-chksum = true
      286           .
      287         end.
      288         else do:
      289           if v-read-chksum = true then do:
      290             if v-last-key = 13 then do:
      291               leave block_read.
      292             end.
      293             else do:
      294               assign
      295                 v-md5-signature-av = v-md5-signature-av + chr( v-last-key )
      296               .
      297             end.
      298           end.
      299           else do:
      300             if v-last-key = 13 then do:
      301               put stream temp-stream skip(v-new-line).
      302               assign
      303                 v-new-line = 1
      304               .
      305             end.
      306             else do:
      307               put stream temp-stream unformatted chr( v-last-key ).
      308               assign
      309                 v-new-line = 0
      310               .
      311             end.
      312           end.
      313         end.
      314       end.
      315       output stream temp-stream close.
      316       input stream TxtStream close.
      317       run gbl/md5.p
      318         ( input  search( v-temp-fname )
      319          ,output v-md5-signature
      320         ) no-error.
      321       if error-status :error then do:
      322         return error substitute("Ошибка при подсчете контрольной суммы текстового файла схемы &1", v-file-name ) .
      323       end.
      324       os-delete value( v-temp-fname ).
      325       assign
      326         v-md5-signature = sum-enc( v-md5-signature, 8 )
      327       .
      328       if v-md5-signature-av <> v-md5-signature then do:
      329         return error substitute( "Некорректная контрольная сумма текстового файла схемы &1", v-file-name ) .
      330       end.
      331       input stream TxtStream from value( v-file-name ).
      332       assign
      333         v-counter = 0
      334       .
      335       assign
      336         frame inf-cfg:title = "Чтение параметров конфигурации"
      337       .
      338       view frame inf-cfg.
      339       for each t_cnf-struct:
      340         delete t_cnf-struct.
      341       end.
      342       create t_cnf-struct no-error.
      343       read-cycle:
      344       repeat transaction
      345       on error  undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      346       :
      347         assign
      348           v-counter = v-counter + 1
      349         .
      350         if ( v-counter modulo 10 ) = 0 then do:
      351           display
      352             v-counter
      353             with frame inf-cfg.
      354         end.
      355         import stream TxtStream delimiter '`':U t_cnf-struct.param-code t_cnf-struct.param-type t_cnf-struct.data-type t_cnf-struct.param-name t_cnf-struct.attach-type t_cnf-struct.list-value t_cnf-struct.default-value t_cnf-struct.PS t_cnf-struct.param-group t_cnf-struct.user-resp no-error.
      356         if error-status:error then do:
      357           return error substitute( "&1. Ошибка при чтении текстового файла схемы! Cтрока &1. (&2)", vss-include-info0, v-counter, error-status :get-message ( error-status :num-messages ) ).
      358         end.
      359         else do:
      360           if not ( t_cnf-struct.param-code begins chr(1) ) then do:
      361             assign
      362               t_cnf-struct.user-resp = decoding-user-resp( t_cnf-struct.param-code, t_cnf-struct.user-resp )
      363             .
      364             if t_cnf-struct.user-resp = "unknown":U then do:
      365               return error substitute( "&1. Ошибка параметра! Cтрока &2.", vss-include-info0, v-counter ).
      366             end.
      367             run check-cfg in this-procedure
      368               ( input-output t_cnf-struct.param-code
      369               ,input-output t_cnf-struct.param-type
      370               ,input-output t_cnf-struct.data-type
      371               ,input-output t_cnf-struct.param-name
      372               ,input-output t_cnf-struct.attach-type
      373               ,input-output t_cnf-struct.list-value
      374               ,input-output t_cnf-struct.default-value
      375               ,input-output t_cnf-struct.PS
      376               ,input-output t_cnf-struct.param-group
      377               ,input-output t_cnf-struct.user-resp
      378               ) no-error .
      379             if error-status :error then do:
      380               return error substitute( "&1. Ошибка параметра! Cтрока &2. &3 (&4)", vss-include-info0, v-counter, return-value, error-status :get-message ( error-status :num-messages ) ).
      381             end.
      382             else do:
      383               find first cnf-struct
      384                 where cnf-struct.param-code = t_cnf-struct.param-code
      385                 no-error
      386               .
      387               if not available cnf-struct then do:
      388                 create cnf-struct .
      389               end.
      390               buffer-copy t_cnf-struct to cnf-struct .
      391             end.
      392           end.
      393         end.
      394       end.
      395       delete t_cnf-struct no-error.
      396       hide frame inf-cfg.
      397       input stream TxtStream close.
      398     end.
      399     return.
      400   end procedure.
      401   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      402   Function reverse returns character (str as character).
      403      define variable rev_incl_s as character init "" no-undo .
      404      define variable rev_incl_i as integer no-undo .
      405      define variable rev_incl_l as integer no-undo .
      406      rev_incl_l = length(str).
      407      do rev_incl_i = 1 to rev_incl_l:
      408         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      409      end.
      410      return rev_incl_s.
      411   end.
      412   procedure check-enc.
      413     define input  parameter p-db-num    as integer   no-undo .
      414     define input  parameter p-db-key    as character no-undo .
      415     define input  parameter p-code      as character no-undo .
      416     define input  parameter p-value     as character no-undo .
      417     define input  parameter p-beg-date  as date      no-undo .
      418     define input  parameter p-end-date  as date      no-undo .
      419     define input  parameter p-enc-value as character no-undo .
      420     define output parameter p-answer    as logical   no-undo .
      421     define variable tmp         as character no-undo .
      422     define variable v-enc-value as character no-undo .
      423     if p-db-num <> 0
      424       and p-db-key = "":U
      425     then do:
      426       assign
      427         p-answer = true
      428       .
      429       return.
      430     end.
      431     if p-db-key = "unload-db":U then do:
      432       assign
      433         p-answer = true
      434       .
      435       return.
      436     end.
      437     if p-code = ""  then do:
      438       assign
      439         tmp = string( p-db-num ) + reverse (p-db-key).
      440       .
      441     end.
      442     else do:
      443       assign
      444         tmp = string( p-db-num )
      445               + trim( p-db-key )
      446               + reverse( trim( p-code ) )
      447               + reverse( trim( p-value ) )
      448               + reverse( string( p-beg-date, "99.99.9999" ) )
      449               + reverse( string( p-end-date, "99.99.9999" ) )
      450       .
      451     end.
      452     run pswd-enc in this-procedure
      453       ( input tmp
      454        ,output v-enc-value
      455       ) no-error .
      456     if error-status:error then do:
      457       message
      458         vss-workfile vss-revision vss-description skip
      459         "Ошибка при вызове процедуры pswd-enc" skip
      460         return-value skip
      461         error-status :get-message(1) skip
      462         view-as alert-box error .
      463       undo, return error .
      464     end.
      465     if v-enc-value = p-enc-value then do:
      466       assign
      467         p-answer = true
      468       .
      469     end.
      470     else do:
      471       assign
      472         p-answer = false
      473       .
      474     end.
      475   end.
      476   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      477   procedure pswd-enc :
      478     define input parameter  pswd     as character no-undo .
      479     define output parameter enc-pswd as character no-undo .
      480     do
      481     on error undo, return error return-value
      482     :
      483       assign
      484         enc-pswd = encode(pswd + string(index(pswd, "k")))
      485       .
      486     end.
      487   end procedure.
      488   define variable str-hdl as handle  no-undo .
      489   define variable cnf-hdl as handle  no-undo .
      490   procedure init :
      491     define input parameter  par-str-hdl as handle.
      492     do
      493     on error undo, return error return-value
      494     :
      495       if valid-handle (par-str-hdl)
      496       then do:
      497         assign
      498           str-hdl = par-str-hdl
      499         .
      500       end.
      501       else do:
      502         return "2" .
      503       end.
      504       return.
      505     end.
      506   end procedure.
      507   procedure kill :
      508     do
      509     on error undo, return error return-value
      510     :
      511       delete procedure this-procedure.
      512       return.
      513     end.
      514   end procedure.
      515   procedure loaddb :
      516     do
      517     on error undo, return error return-value
      518     :
      519       define buffer buf_db       for ub.db .
      520       define buffer buf_sys-ctrl for ub.sys-ctrl .
      521       define variable v-ok      as logical   no-undo .
      522       define variable MaxErr    as integer   no-undo .
      523       define variable v-db-list as character no-undo .
      524       if not valid-handle (cnf-hdl)
      525       then do:
      526         run find-library in this-procedure no-error.
      527         if not valid-handle (cnf-hdl)
      528         then do:
      529             run log-error in str-hdl ("Ошибка при загрузки в памяти библиотек", 2) no-error.
      530             return ("2") .
      531         end.
      532       end.
      533       read-cycle:
      534       do on error undo, leave read-cycle:
      535         find first buf_sys-ctrl no-lock .
      536         for each ub.config no-lock
      537         on error undo, leave read-cycle
      538         :
      539           find first buf_db no-lock
      540             where buf_db.db-num = ub.config.db-num
      541             .
      542           if ub.config.db-num = buf_sys-ctrl.db-num then do:
      543             assign
      544               MaxErr = 2
      545             .
      546           end.
      547           else do:
      548             assign
      549               MaxErr = 1
      550             .
      551           end.
      552           create cnf .
      553           if lookup( ub.config.conf-type, 'к,п':U ) > 0
      554           then do:
      555             run check-enc in this-procedure
      556               ( input ub.config.db-num
      557                ,input buf_db.db-key
      558                ,input ub.config.param-code
      559                ,input ub.config.param-value
      560                ,input ub.config.beg-date
      561                ,input ub.config.end-date
      562                ,input ub.config.param-encoded
      563                ,output v-ok
      564               ) no-error.
      565             if error-status:error then do:                                          run log-sys-error in str-hdl ("Системная ошибка").                   undo, return "2" .                                                      end.
      566             if v-ok <> true
      567             then do:
      568               assign
      569                 cnf.errorexist = MaxErr
      570               .
      571               run log-error in str-hdl
      572                 ( input substitute("Параметр &1 для БД &2 - ошибка кодирования (&3)", ub.config.param-code, ub.config.db-num, ub.config.param-encoded )
      573                  ,input MaxErr
      574                 ).
      575             end.
      576           end.
      577           if ub.config.beg-date = ?
      578           or ub.config.end-date = ?
      579           then do:
      580             assign
      581               cnf.errorexist = MaxErr
      582             .
      583             run log-error in str-hdl
      584               ( input substitute("Параметр &1 для БД &2 - не задана дата действия параметра", ub.config.param-code, ub.config.db-num )
      585                 ,input MaxErr
      586               ).
      587           end.
      588           buffer-copy ub.config to cnf
      589             assign
      590               cnf.db-key = buf_db.db-key
      591             no-error
      592           .
      593           if error-status:error then do:                                          run log-sys-error in str-hdl ("Системная ошибка").                   undo, return "2" .                                                      end.
      594           release cnf no-error.
      595           if error-status:error then do:                                          run log-sys-error in str-hdl ("Системная ошибка").                   undo, return "2" .                                                      end.
      596         end.
      597         for each cnf
      598         on error undo, leave read-cycle
      599         :
      600           run chk-param in cnf-hdl
      601             ( buffer cnf
      602             ) no-error.
      603                   if error-status:error then do:                                          run log-sys-error in str-hdl ("Системная ошибка").                   undo, return "2" .                                                      end.
      604         end.
      605         run chk-unref in cnf-hdl
      606           ( input ?
      607           , input ?
      608           , input 'к,о':U
      609           , input false
      610           ) no-error.
      611               if error-status:error then do:                                          run log-sys-error in str-hdl ("Системная ошибка").                   undo, return "2" .                                                      end.
      612         return if err-level > 0 then string (err-level) else "".
      613       end.
      614       run log-sys-error in str-hdl ("При загрузке параметров возникла непредвиденная ошибка").
      615       return string (err-level).
      616     end.
      617   end procedure.
      618   procedure chk-company :
      619     define input  parameter par-host-code like ub.sysconf.host-code no-undo.
      620     define buffer buf_sysconf for ub.sysconf .
      621     do
      622     on error undo, return error return-value
      623     :
      624       find first buf_sysconf no-lock
      625         where buf_sysconf.host-code = par-host-code
      626         no-error .
      627       if available buf_sysconf
      628       then do:
      629         return.
      630       end.
      631       else do:
      632         return "1".
      633       end.
      634     end.
      635   end procedure.
      636   procedure chk-host-code :
      637     define input  parameter obj-obj-type  as character no-undo .
      638     define input  parameter obj-obj-code  as integer   no-undo .
      639     define output parameter obj-host-code as integer   no-undo .
      640     do
      641     on error undo, return error return-value
      642     :
      643       assign
      644         obj-host-code = ?
      645       .
      646       if obj-obj-type = ""
      647       or obj-obj-code = 0
      648       then do:
      649         return.
      650       end.
      651       case obj-obj-type
      652       :
      653           when 'скл':U
      654           then do:
      655                 find first ub.store where ub.store.obj-code = obj-obj-code no-lock no-error.
      656                 if available ub.store then
      657                   assign obj-host-code = ub.store.host-code.
      658                 else
      659                   run log-error in str-hdl ("Не допустимый код магазина " + string(obj-obj-code), 1).
      660           end.
      661           when 'маг':U
      662           then do:
      663                 find first ub.shop where ub.shop.obj-code = obj-obj-code no-lock no-error.
      664                 if available ub.shop then
      665                   assign obj-host-code = ub.shop.host-code.
      666                 else
      667                   run log-error in str-hdl ("Не допустимый код склада " + string(obj-obj-code), 1).
      668           end.
      669           otherwise do:
      670                 run log-error in str-hdl (" Недопустимый тип объекта привязки - " + obj-obj-type, 1).
      671           end.
      672       end.
      673       return.
      674     end.
      675   end procedure.
      676   procedure chk-cfg :
      677     define input-output parameter par-chg-encode as logical           no-undo.
      678     define variable authorise as logical initial "false" no-undo .
      679     define buffer buf_sys-ctrl for ub.sys-ctrl .
      680     define buffer buf_cnf      for cnf .
      681     do
      682     on error undo, return error return-value
      683     :
      684       find first buf_sys-ctrl no-lock .
      685       for each cnf no-lock
      686         where cnf.NotUsed
      687        ,first cnf-struct no-lock
      688           where cnf-struct.param-code = cnf.param-code
      689       on error undo, return error return-value
      690       :
      691         if lookup( cnf.conf-type, 'к,о':U ) + lookup( cnf-struct.param-type, 'к,о':U ) <> 0
      692         then do:
      693           if cnf.db-num = buf_sys-ctrl.db-num
      694           then do:
      695             run log-error in str-hdl
      696               ( input substitute( "Отсутствует обязательный параметр &1 для текущей БД", cnf.param-code )
      697                ,input 2
      698               ).
      699           end.
      700           else do:
      701             run log-error in str-hdl
      702               ( input substitute( "Отсутствует обязательный параметр &1 для БД &2", cnf.param-code, cnf.db-num )
      703                ,input 1
      704               ).
      705           end.
      706         end.
      707       end.
      708       assign
      709         err-level = 0
      710       .
      711       find first buf_cnf
      712         where buf_cnf.ErrorExist >= 2
      713           and buf_cnf.db-num = buf_sys-ctrl.db-num
      714           and ( buf_cnf.NotUsed = false
      715                 or buf_cnf.conf-type <> ""
      716               )
      717         no-error .
      718       if available buf_cnf then do:
      719         run log-error in str-hdl
      720           ( input "В параметрах для текущей БД есть ошибки, подлежащие исправлению"
      721            ,input 2
      722           ).
      723       end.
      724       find first buf_cnf
      725         where buf_cnf.ErrorExist >= 2
      726           and buf_cnf.db-num <> buf_sys-ctrl.db-num
      727           and ( buf_cnf.NotUsed = false
      728                 or buf_cnf.conf-type <> ""
      729               )
      730         no-error .
      731       if available buf_cnf then do:
      732         run log-error in str-hdl
      733           ( input substitute( "В параметрах для БД &1 есть ошибки, подлежащие исправлению", buf_cnf.db-num )
      734            ,input 1
      735           ).
      736       end.
      737       if err-level > 2 then do:
      738         return.
      739       end.
      740                   for each ub.config
      741         where lookup( ub.config.conf-type, 'к,п':U ) > 0
      742       on error undo, return error
      743       :
      744           find first cnf where ub.config.param-code = cnf.param-code and                  ub.config.host-code  = cnf.host-code  and                  ub.config.obj-type   = cnf.obj-type   and                  ub.config.obj-code   = cnf.obj-code   and                  ub.config.beg-date   = cnf.beg-date   and                  ub.config.end-date   = cnf.end-date   and                  ub.config.db-num     = cnf.db-num no-error.
      745           if not available cnf
      746           then do:
      747             run log-error in str-hdl ("В наборе параметров удален кодированный параметр " +
      748                                       ub.config.param-code, 0).
      749             Authorise = true.
      750             next.
      751           end.
      752           if cnf.param-value <> ub.config.param-value
      753           then do:
      754             run log-error in str-hdl ("Изменен кодированный параметр " + ub.config.param-code  + " на "  +
      755                                       cnf.param-value  + " с " + ub.config.param-value, 0).
      756             Authorise = true.
      757             next.
      758           end.
      759       end.
      760       for each cnf
      761         where lookup( ub.config.conf-type, 'к,п':U ) > 0
      762           and cnf.notused = false
      763       on error undo, return error
      764       :
      765           find first ub.config where ub.config.param-code = cnf.param-code and                  ub.config.host-code  = cnf.host-code  and                  ub.config.obj-type   = cnf.obj-type   and                  ub.config.obj-code   = cnf.obj-code   and                  ub.config.beg-date   = cnf.beg-date   and                  ub.config.end-date   = cnf.end-date   and                  ub.config.db-num     = cnf.db-num no-lock no-error.
      766           if not available ub.config
      767           then do:
      768             run log-error in str-hdl ("В новом наборе параметров есть новый кодированный параметр " +
      769                                       cnf.param-code, 0).
      770             Authorise = true.
      771             next.
      772           end.
      773       end.
      774       if authorise and not par-chg-encode
      775       then do:
      776         run gbl/authoriz.p (input "Run information dialog",output par-chg-encode ) no-error.
      777         if error-status:error then do:                                          run log-sys-error in str-hdl ("Системная ошибка").                   undo, return "2" .                                                      end.
      778         if not par-chg-encode then
      779             run log-error in str-hdl ("Изменение кодированных параметров запрещено", 2).
      780       end.
      781     end.
      782   end procedure.
      783   procedure save-cfg :
      784     define input  parameter par-chg-encode as logical          no-undo.
      785     do
      786     on error undo, return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
      787     :
      788     define buffer b-config for ub.config.
      789     assign
      790       err-level = 0
      791     .
      792     run chk-cfg in this-procedure
      793       (input-output par-chg-encode
      794       ) no-error.
      795     if error-status:error then do:                                          run log-sys-error in str-hdl ("Системная ошибка").                   undo, return "2" .                                                      end.
      796     if err-level > 1 then do:
      797       return string (err-level) .
      798     end.
      799     run adm/cnf-chk.p no-error .
      800     if error-status :error then do:
      801       run log-error in str-hdl
      802         ( input substitute( "Текущий набор невозможно сохранить&1&2&1&3", chr(10), return-value, error-status :get-message ( 1 ) )
      803          ,input 2
      804         ).
      805       return "2".
      806     end.
      807     tran-write:
      808     do transaction
      809     on error undo tran-write, return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
      810     :
      811       for each cnf
      812         where cnf.NotUsed = false
      813       on error undo tran-write, return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
      814       :
      815         find first ub.config exclusive-lock
      816           where ub.config.param-code = cnf.param-code and                  ub.config.host-code  = cnf.host-code  and                  ub.config.obj-type   = cnf.obj-type   and                  ub.config.obj-code   = cnf.obj-code   and                  ub.config.beg-date   = cnf.beg-date   and                  ub.config.end-date   = cnf.end-date   and                  ub.config.db-num     = cnf.db-num no-error.
      817         if not available ub.config
      818         then do:
      819           if locked ub.config
      820           then do:
      821               run log-error in str-hdl ("Запись текущего набора локирована, попробуйте записать позже", 2).
      822               undo Tran-Write, return string(err-level).
      823           end.
      824           else do:
      825             create ub.config no-error.
      826           end.
      827           if error-status:error then do:                                          run log-sys-error in str-hdl ("Системная ошибка").                   undo, return "2" .                                                      end.
      828         end.
      829         buffer-copy cnf to ub.config
      830           assign
      831             ub.config.stts = 0
      832         .
      833       end.
      834       for each ub.config no-lock
      835       on error undo tran-write, return "2"
      836       :
      837         if can-find (first cnf where ub.config.param-code = cnf.param-code and                  ub.config.host-code  = cnf.host-code  and                  ub.config.obj-type   = cnf.obj-type   and                  ub.config.obj-code   = cnf.obj-code   and                  ub.config.beg-date   = cnf.beg-date   and                  ub.config.end-date   = cnf.end-date   and                  ub.config.db-num     = cnf.db-num and not cnf.NotUsed) then next.
      838         find first b-config where ReciD(b-config) = recid(ub.config) exclusive-lock no-error.
      839         if not available b-config
      840         then do:
      841           if locked b-config then
      842               run log-error in str-hdl ("Запись текущего набора локирована, попробуйте записать позже", 2).
      843           else if error-status:error then
      844               run log-sys-error in str-hdl ("Запись текущего набора недоступна").
      845           if err-level > 0
      846           then do:
      847             undo Tran-Write, return string(err-level).
      848           end.
      849         end.
      850         else do:
      851           if par-chg-encode
      852           then do:
      853             assign
      854               b-config.stts = -1
      855             .
      856           end.
      857           delete b-config .
      858         end.
      859       end.
      860       return "".
      861     end.
      862     end.
      863   end procedure.
      864   procedure find-library :
      865     do
      866     on error undo, return error return-value
      867     :
      868       if valid-handle(cnf-hdl) then return.
      869       assign
      870         cnf-hdl = session :first-procedure
      871       .
      872       do while valid-handle (cnf-hdl)
      873       :
      874         if cnf-hdl:private-data = "Work-with-config"
      875         then do:
      876           leave.
      877         end.
      878         assign
      879           cnf-hdl = cnf-hdl :next-sibling
      880         .
      881       end.
      882     end.
      883   end procedure.
