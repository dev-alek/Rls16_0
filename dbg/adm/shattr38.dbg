      616   procedure proc-alt-shift-f2:
      617     if not ibs.th.gbl.gbl-var:rcode
      618   then
      619     run gbl\inidebug.p .
      620   end.
      621   procedure proc-alt-shift-f3:
      622     run gbl/prvssinf.p
      623       ( input this-procedure
      624       ) .
      625   end.
      626   define variable v-inform-launched as logical no-undo initial false .
      627   procedure proc-alt-shift-f4:
      628     define variable v-action as character no-undo .
      629     if v-inform-launched = false then do:
      630       assign
      631         v-inform-launched = true
      632       .
      633       run gbl/d-inform.w
      634         (  input self
      635         ,  input this-procedure
      636         , output v-action
      637         ) no-error .
      638       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      639       assign
      640         v-inform-launched = false
      641       .
      642     end.
      643   end.
      644   procedure proc-alt-f1:
      645     run gbl/corrhelp.p
      646       (input this-procedure
      647       ) .
      648   end .
      649   on alt-shift-f2 anywhere do:
      650     run proc-alt-shift-f2.
      651   end.
      652   on alt-shift-f3 anywhere do:
      653     run proc-alt-shift-f3 in this-procedure .
      654   end.
      655   on alt-shift-f4 anywhere do:
      656     run proc-alt-shift-f4 in this-procedure.
      657   end.
      658   on alt-f1 anywhere do:
      659     run proc-alt-f1 in this-procedure .
      660   end.
      661   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      662     define variable v-cntxt-db-num        as integer   no-undo .
      663     define variable v-cntxt-userid        as character no-undo .
      664     define variable v-cntxt-level         as character no-undo .
      665     define variable v-cntxt-host-code-obj as integer   no-undo .
      666     define variable v-cntxt-obj-type      as character no-undo .
      667     define variable v-cntxt-obj-code      as integer   no-undo .
      668     define variable v-cntxt-db-num-obj    as integer   no-undo .
      669     define variable v-cntxt-is-admin      as logical   no-undo .
      670   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      671   DEFINE VARIABLE v-db-num LIKE ub.db.db-num NO-UNDO.
      672   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO.
      673   DEFINE VARIABLE v-to-create AS logical NO-UNDO.
      674   DEFINE BUFFER cli-buf FOR ub.clients .
      675   define variable fixed-l-zeros as logical no-undo .
      676   define variable fixed-l-mask as logical no-undo .
      677   define variable v-tth as handle no-undo .
      678   assign
      679   v-tth = buffer thbjattr_thbj-attr:table-handle .
      680   DEFINE BUTTON B-exit AUTO-GO
      681        LABEL "&Ввод"
      682        SIZE 10 BY 1
      683        BGCOLOR 8 .
      684   DEFINE BUTTON B-Help
      685        LABEL "Помо&щь"
      686        SIZE 3 BY 1
      687        BGCOLOR 8 .
      688   DEFINE BUTTON b-quit AUTO-END-KEY
      689        LABEL "&Отмена"
      690        SIZE 10 BY 1
      691        BGCOLOR 8 .
      692   DEFINE VARIABLE t-l-mask AS LOGICAL INITIAL no
      693        LABEL "Маскирование ДК"
      694        VIEW-AS TOGGLE-BOX
      695        SIZE 94 BY 1 NO-UNDO.
      696   DEFINE VARIABLE t-l-zeros AS LOGICAL INITIAL no
      697        LABEL "Разрешено добавление номеров ДК, совпадающих с имеющимися с точностью до лидир. нулей"
      698        VIEW-AS TOGGLE-BOX
      699        SIZE 94 BY 1 NO-UNDO.
      700   DEFINE FRAME Dialog-Frame
      701        B-exit AT ROW 1 COL 1
      702        b-quit AT ROW 1 COL 11
      703        B-Help AT ROW 1 COL 95
      704        t-l-zeros AT ROW 2.1 COL 2
      705        t-l-mask AT ROW 3.38 COL 2 WIDGET-ID 2
      706        SPACE(3.24) SKIP(19.20)
      707       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      708            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      709            TITLE "Набор опций работы со справочником ДК"
      710            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      711   ASSIGN
      712          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      713          FRAME Dialog-Frame:HIDDEN           = TRUE.
      714   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      715   DO:
      716     APPLY "END-ERROR":U TO SELF.
      717   END.
      718   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      719   DO:
      720     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      721     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      722   END.
      723   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      724   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      725   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      726   on help of frame Dialog-Frame
      727   do:
      728     run gbl/app_help.p
      729       (input this-procedure :file-name
      730       ,input ''
      731       ,input ?
      732       ) no-error.
      733     if error-status :error then do:
      734       message
      735         "Ошибка при вызове помощи"
      736         error-status :get-message(1)
      737         view-as alert-box .
      738     end.
      739   end.
      740   run minbtn-set in this-procedure .
      741   on choose of b-help in frame Dialog-Frame
      742   do:
      743     apply "help":u to frame Dialog-Frame .
      744   end.
      745   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      746   procedure minbtn-set :
      747       do
      748           on error undo, return error return-value
      749           :
      750           define variable ii              as integer       no-undo .
      751           define variable fh              as widget-handle no-undo .
      752           define variable hh              as widget-handle no-undo .
      753           define variable v-h             as handle        extent 4 no-undo .
      754           define variable v-name-button   as character     no-undo .
      755           define variable v-help-old-x    as decimal       no-undo .
      756           define variable v-help-old-y    as decimal       no-undo .
      757           define variable v-help-old-size as decimal       no-undo .
      758           define variable v-frame-width   as decimal       no-undo .
      759           define variable jj              as integer       no-undo .
      760           do
      761               on error undo, return error
      762               :
      763               assign
      764                   v-frame-width = frame Dialog-Frame:width - 0.3
      765                   fh            = frame Dialog-Frame:first-child
      766                   hh            = fh:first-child
      767                   ii            = 1
      768                   .
      769               do while valid-handle(hh):
      770                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      771                   do:
      772                       case lc(hh:name) :
      773                           when "b-help" then
      774                               do:
      775                                   hh:load-image-up("cmp/b-help.bmp":u) .
      776                                   hh:load-image-down("cmp/b-help.bmp":u) .
      777                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      778                                   hh:TOOLTIP = "Помощь" .
      779                                   v-help-old-x = hh:column .
      780                                   v-help-old-y = hh:row    .
      781                                   v-help-old-size = hh:width .
      782                                   hh:width-chars = 2.5 .
      783                               end.
      784                           when "b-print" then
      785                               do:
      786                                   hh:load-image("cmp/b-print.bmp":u) .
      787                                   hh:TOOLTIP = "Печать" .
      788                                   v-h[ii] = hh:handle .
      789                                   ii = ii + 1 .
      790                                   hh:width-chars = 3 .
      791                               end.
      792                           when "b-history" or
      793                           when "b-hist" then
      794                               do:
      795                                   hh:load-image("cmp/b-hist.bmp":u) .
      796                                   hh:TOOLTIP = "История" .
      797                                   v-h[ii] = hh:handle .
      798                                   ii = ii + 1 .
      799                                   hh:width-chars = 3 .
      800                               end.
      801                           when "b-sch" then
      802                               do:
      803                                   hh:load-image("cmp/b-sch.bmp":u) .
      804                                   hh:TOOLTIP = "Установка Фильтра" .
      805                                   v-h[ii] = hh:handle .
      806                                   ii = ii + 1 .
      807                                   hh:width-chars = 3 .
      808                               end.
      809                           when "b-hist-user" then
      810                               do:
      811                                   hh:load-image("cmp/b-hist.bmp":u) .
      812                                   hh:TOOLTIP = "История пользователя" .
      813                                   ii = ii + 1 .
      814                               end.
      815                       end case.
      816                   end.
      817                   hh = hh:next-sibling.
      818               end.
      819               b-help:column = v-frame-width - b-help:width-chars.
      820               jj = 0.
      821               repeat ii = 4 to 1 by -1 :
      822                   if valid-handle (v-h[ii] ) then
      823                   do:
      824                       jj  = jj + 1 .
      825                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      826                       v-h[ii]:row    = v-help-old-y .
      827                   end.
      828               end.
      829           end.
      830       end.
      831   end procedure.
      832   MAIN-BLOCK:
      833   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      834      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      835   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      836     run mainmenu_getcntxt in parparentproc
      837       (output v-cntxt-db-num
      838       ,output v-cntxt-userid
      839       ,output v-cntxt-level
      840       ,output v-cntxt-host-code-obj
      841       ,output v-cntxt-obj-type
      842       ,output v-cntxt-obj-code
      843       ,output v-cntxt-db-num-obj
      844       ,output v-cntxt-is-admin
      845       ) .
      846   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      847   ON TAB ANYWHERE
      848   DO:
      849   define variable ii as integer no-undo .
      850   define variable fh as widget-handle no-undo .
      851   define variable hh as widget-handle no-undo .
      852   define variable v-next-widget-name as character no-undo .
      853   if v-tab-order <> '' then do:
      854     if self:type = "TOGGLE-BOX" then
      855     self:BGCOLOR = ?.
      856     assign
      857     ii = lookup(self:name, v-tab-order).
      858     assign
      859     ii = ii + 1
      860     v-next-widget-name = entry(ii, v-tab-order)
      861     no-error .
      862     if error-status:error then do:
      863       assign
      864       ii = 1
      865       v-next-widget-name = entry( ii, v-tab-order)
      866       .
      867     end.
      868     assign
      869     fh = frame Dialog-Frame:first-child
      870     hh = fh:first-child
      871     .
      872     do while valid-handle(hh):
      873       if hh:name = v-next-widget-name then do:
      874         if hh:sensitive  = yes
      875         AND hh:visible = yes then do:
      876           if hh:type = "TOGGLE-BOX":U then do:
      877             assign
      878             hh:BGcolor = 1
      879             .
      880           end.
      881           APPLY "ENTRY" to hh.
      882           return no-apply.
      883         end.
      884         else do:
      885           APPLY "TAB" to hh.
      886           return no-apply.
      887         end.
      888       end.
      889       hh = hh:next-sibling.
      890     end.
      891   end.
      892   END.
      893   ON BACK-TAB ANYWHERE
      894   DO:
      895   define variable ii as integer no-undo .
      896   define variable fh as widget-handle no-undo .
      897   define variable hh as widget-handle no-undo .
      898   define variable v-next-widget-name as character no-undo .
      899   if v-tab-order <> '' then do:
      900     assign
      901     ii = lookup(self:name, v-tab-order).
      902     .
      903     assign
      904     ii = (if ii = 1
      905           then  num-entries(v-tab-order)
      906           else ii - 1
      907           )
      908     v-next-widget-name = entry(ii, v-tab-order)
      909     .
      910     assign
      911     fh = frame Dialog-Frame:first-child
      912     hh = fh:first-child
      913     .
      914     do while valid-handle(hh):
      915       if hh:name = v-next-widget-name then do:
      916         if hh:sensitive  = yes
      917         AND hh:visible = yes then do:
      918           if hh:type = "TOGGLE-BOX":U then do:
      919             assign
      920             hh:BGcolor = 1
      921             .
      922           end.
      923           APPLY "ENTRY" to hh.
      924           return no-apply.
      925         end.
      926         else do:
      927         APPLY "BACK-TAB" to hh.
      928         return no-apply.
      929         end.
      930       end.
      931       hh = hh:next-sibling.
      932     end.
      933     end.
      934   END.
      935   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      936   ON RETURN ANYWHERE
      937   DO:
      938   define variable ii as integer no-undo .
      939   define variable fh as widget-handle no-undo .
      940   define variable hh as widget-handle no-undo .
      941   define variable v-next-widget-name as character no-undo .
      942     if v-tab-order <> '' then do:
      943       assign
      944       ii = lookup(self:name, v-tab-order).
      945       if ii = num-entries(v-tab-order) then do:
      946           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
      947           return no-apply.
      948       end.
      949       if self:type <> "BUTTON" and
      950         self:type <> "EDITOR"  then do:
      951         run proc-move-forward in this-procedure .
      952         return no-apply.
      953       end.
      954       if self:type = "BUTTON" then do:
      955         APPLY "CHOOSE" to self.
      956       end.
      957       if self:type = "TOGGLE-BOX" then
      958       self:BGCOLOR = ?.
      959       assign
      960       ii = ii + 1
      961       v-next-widget-name = entry(ii, v-tab-order)
      962       no-error .
      963       if error-status:error then do:
      964         assign
      965         ii = 1
      966         v-next-widget-name = entry( ii, v-tab-order)
      967         .
      968       end.
      969       assign
      970       fh = frame Dialog-Frame:first-child
      971       hh = fh:first-child
      972       .
      973       do while valid-handle(hh):
      974         if hh:name = v-next-widget-name then do:
      975           if hh:sensitive  = yes
      976           AND hh:visible = yes then do:
      977             if hh:type = "TOGGLE-BOX":U then do:
      978               assign
      979               hh:BGcolor = 1
      980               .
      981             end.
      982             APPLY "ENTRY" to hh.
      983             return no-apply.
      984           end.
      985           else do:
      986             APPLY "TAB" to hh.
      987             return no-apply.
      988           end.
      989         end.
      990         hh = hh:next-sibling.
      991       end.
      992     end.
      993   END.
      994   procedure proc-move-forward :
      995   define variable ii as integer no-undo .
      996   define variable fh as widget-handle no-undo .
      997   define variable hh as widget-handle no-undo .
      998   define variable v-next-widget-name as character no-undo .
      999   do
     1000   on error undo, return error
     1001   :
     1002     if v-tab-order <> '' then do:
     1003       if self:type = "TOGGLE-BOX" then
     1004       self:BGCOLOR = ?.
     1005       assign
     1006       ii = lookup(self:name, v-tab-order).
     1007       assign
     1008       ii = ii + 1
     1009       v-next-widget-name = entry(ii, v-tab-order)
     1010       no-error .
     1011       if error-status:error then do:
     1012         assign
     1013         ii = 1
     1014         v-next-widget-name = entry( ii, v-tab-order)
     1015         .
     1016       end.
     1017       assign
     1018       fh = frame Dialog-Frame:first-child
     1019       hh = fh:first-child
     1020       .
     1021       do while valid-handle(hh):
     1022         if hh:name = v-next-widget-name then do:
     1023           if hh:sensitive  = yes
     1024           AND hh:visible = yes then do:
     1025             if hh:type = "TOGGLE-BOX":U then do:
     1026               assign
     1027               hh:BGcolor = 1
     1028               .
     1029             end.
     1030             APPLY "ENTRY" to hh.
     1031             return.
     1032           end.
     1033           else do:
     1034             assign
     1035             ii = ii + 1
     1036             v-next-widget-name = entry(ii, v-tab-order)
     1037             no-error .
     1038             if error-status:error then do:
     1039               assign
     1040               ii = 1
     1041               v-next-widget-name = entry( ii, v-tab-order)
     1042               .
     1043             end.
     1044           end.
     1045         end.
     1046         hh = hh:next-sibling.
     1047       end.
     1048     end.
     1049   end.
     1050   end procedure.
     1051     IF p-mode <> 'ПРОСМОТР':U
     1052     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     1053         MESSAGE
     1054         vss-workfile vss-revision vss-description skip
     1055         "Неверное значение параметра p-mode" p-mode
     1056         VIEW-AS ALERT-BOX ERROR.
     1057         UNDO, RETURN ERROR.
     1058     END.
     1059     if p-obj-type = '':U then do:
     1060       if v-cntxt-db-num <> 0
     1061       and p-mode <> 'ПРОСМОТР':U
     1062       then do:
     1063           MESSAGE
     1064           "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" skip
     1065           VIEW-AS ALERT-BOX ERROR.
     1066           UNDO, RETURN ERROR.
     1067       end.
     1068     end.
     1069     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     1070       FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
     1071                 LOCKED_thbj-attr.obj-type = p-obj-type
     1072           AND   LOCKED_thbj-attr.obj-code = p-obj-code
     1073           AND   LOCKED_thbj-attr.upper-prop-code = 'dc-ref':U
     1074           AND LOCKED_thbj-attr.prop-code = "":U
     1075           NO-WAIT NO-ERROR.
     1076        if locked locked_thbj-attr then do:
     1077           message
     1078           vss-workfile vss-revision vss-description skip
     1079            "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
     1080           view-as alert-box error .
     1081           undo, return error.
     1082         end.
     1083     END.
     1084     ELSE DO:
     1085         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
     1086             LOCKED_thbj-attr.obj-type = p-obj-type
     1087       AND   LOCKED_thbj-attr.obj-code = p-obj-code
     1088       AND   LOCKED_thbj-attr.upper-prop-code = 'dc-ref':U
     1089       AND   LOCKED_thbj-attr.prop-code = '':U NO-ERROR.
     1090     END.
     1091     if not available locked_thbj-attr then do:
     1092       ASSIGN
     1093       v-to-create  = YES.
     1094       message
     1095       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     1096                   chr(10))
     1097       view-as alert-box WARNING.
     1098     end.
     1099     RUN FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     1100     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     1101     RUN Myenable in this-procedure .
     1102     WAIT-FOR GO OF FRAME Dialog-Frame.
     1103   END.
     1104   RUN disable_UI.
     1105   PROCEDURE disable_UI :
     1106     HIDE FRAME Dialog-Frame.
     1107   END PROCEDURE.
     1108   PROCEDURE enable_UI :
     1109     DISPLAY t-l-zeros t-l-mask
     1110         WITH FRAME Dialog-Frame.
     1111     ENABLE B-exit b-quit B-Help t-l-zeros t-l-mask
     1112         WITH FRAME Dialog-Frame.
     1113     VIEW FRAME Dialog-Frame.
     1114   END PROCEDURE.
     1115   PROCEDURE fill-widgets :
     1116   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     1117   DEFINE VARIABLE v-entry AS CHARACTER NO-UNDO.
     1118   define variable v-param-type as character no-undo .
     1119   define variable v-value-character as character no-undo .
     1120   define variable v-value-date as date no-undo .
     1121   define variable v-value-decimal as decimal no-undo .
     1122   define variable v-value-integer as INTEGER no-undo .
     1123   define variable v-value-logical AS LOGICAL no-undo .
     1124   DEFINE VARIABLE v-gds-copy-list AS CHARACTER NO-UNDO.
     1125   DEFINE VARIABLE v-gdsreffi-list AS CHARACTER NO-UNDO.
     1126   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     1127   FOR EACH thbjattr_thbj-attr:
     1128     delete thbjattr_thbj-attr.
     1129   end.
     1130   FOR EACH temp-thbj-attr:
     1131     delete temp-thbj-attr.
     1132   end.
     1133   run adm/shattri.p (
     1134                 input "init":U
     1135               , input p-obj-type
     1136               , input p-obj-code
     1137               , input 'dc-ref':U
     1138               , input "":U
     1139               , output v-value-character
     1140               , output v-value-date
     1141               , output v-value-decimal
     1142               , output v-value-integer
     1143               , output v-value-logical
     1144               , output v-param-type
     1145               , INPUT-OUTPUT table-handle v-tth
     1146               ) no-error .
     1147   if error-status:error
     1148   and not available locked_thbj-attr then do:
     1149     message
     1150     "Не удалось получить начальные значения настроек" skip
     1151     error-status:get-message(1) return-value
     1152     view-as alert-box error .
     1153     undo, return error .
     1154   end.
     1155   FOR EACH thbjattr_thbj-attr:
     1156     ASSIGN
     1157     v-entry = thbjattr_thbj-attr.prop-code.
     1158     IF v-entry = 'l-zeros':U THEN DO:
     1159       ASSIGN
     1160       t-l-zeros = thbjattr_thbj-attr.property-value-logical
     1161       t-l-zeros:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1162       fixed-l-zeros = t-l-zeros
     1163       .
     1164     END.
     1165     IF v-entry = 'l-mask':U THEN DO:
     1166       ASSIGN
     1167       t-l-mask = thbjattr_thbj-attr.property-value-logical
     1168       t-l-mask:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1169       fixed-l-mask = t-l-mask
     1170       .
     1171     END.
     1172     create temp-thbj-attr.
     1173     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     1174   END.
     1175   END PROCEDURE.
     1176   PROCEDURE MyEnable :
     1177   if p-obj-type = 'маг':U
     1178   or p-obj-type = 'скл':U then do:
     1179     ASSIGN
     1180     FRAME Dialog-Frame:TITLE = substitute("&1 &2&3"
     1181                                            ,FRAME Dialog-Frame:TITLE
     1182                                            ,p-obj-type
     1183                                            ,p-obj-code)
     1184     .
     1185   end.
     1186   v-tab-order = "t-l-zeros,t-l-mask" .
     1187   ENABLE
     1188   B-exit WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1189   b-quit
     1190   B-Help
     1191   WITH FRAME Dialog-Frame.
     1192   DISPLAY
     1193   t-l-mask
     1194   WITH FRAME Dialog-Frame.
     1195   enable
     1196   t-l-mask WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1197   WITH FRAME Dialog-Frame.
     1198   if p-obj-type = "" then do:
     1199   DISPLAY
     1200   t-l-zeros
     1201   WITH FRAME Dialog-Frame.
     1202   enable
     1203   t-l-zeros WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1204   WITH FRAME Dialog-Frame.
     1205   end.
     1206   VIEW FRAME Dialog-Frame.
     1207   IF p-mode = 'ПРОСМОТР':U THEN DO:
     1208       HIDE
     1209       b-exit
     1210       IN FRAME Dialog-Frame.
     1211       ASSIGN
     1212       b-quit:LABEL = "&Выход"
     1213       b-quit:column = 1
     1214       .
     1215   END.
     1216   END PROCEDURE.
     1217   PROCEDURE proc-save :
     1218   define variable v-value-character as character no-undo .
     1219   define variable v-value-date as date no-undo .
     1220   define variable v-value-decimal as decimal no-undo .
     1221   define variable v-value-integer as INTEGER no-undo .
     1222   define variable v-value-logical AS LOGICAL no-undo .
     1223   define variable v-param-type as character no-undo .
     1224   define variable v-gds-copy-list as character no-undo .
     1225   define variable v-gdsreffi as character no-undo .
     1226   define variable wh as widget-handle no-undo .
     1227   define variable fh as widget-handle no-undo .
     1228   define variable v-same as logical no-undo .
     1229   define variable glog as logical no-undo .
     1230   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     1231   ASSIGN
     1232   FRAME Dialog-Frame
     1233   t-l-zeros
     1234   t-l-mask
     1235   .
     1236   if fixed-l-zeros <> t-l-zeros then do:
     1237     case t-l-zeros:
     1238       when yes then do:
     1239         message
     1240         "Вы уверены, что Вы хотите включить опцию <Разрешено добавление номеров ДК, совпадающих с имеющимися с точностью до лидир. нулей>?" skip
     1241         "Выключить ее невозможно!!!" skip(2)
     1242         "После появления в БД ДК с номерами, совпадающими с точностью до лидирующих нулей, корректная работа с некоторыми POS НЕ ГАРАНТИРУЕТСЯ!!!"
     1243         view-as alert-box question buttons yes-no update glog.
     1244         if not glog then undo, return error .
     1245       end.
     1246       when no then do:
     1247         message
     1248         "Выключить однажды включенную опцию <Разрешено добавление номеров ДК, совпадающих с имеющимися с точностью до лидир. нулей>" skip
     1249         "НЕВОЗМОЖНО!!!"
     1250         view-as alert-box error.
     1251         undo, return error .
     1252       end.
     1253     end case.
     1254   end.
     1255   assign
     1256   fh = frame Dialog-Frame:first-child
     1257   wh = fh:first-child
     1258   .
     1259   do while valid-handle(wh):
     1260     if wh:private-data begins "recid=" then do:
     1261       find first thbjattr_thbj-attr where
     1262                 recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     1263       assign
     1264       buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     1265     end.
     1266     wh = wh:next-sibling.
     1267   end.
     1268   v-same = yes.
     1269   for each thbjattr_thbj-attr,
     1270       first temp-thbj-attr where
     1271             temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     1272         and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     1273         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     1274         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code:
     1275      buffer-compare
     1276      thbjattr_thbj-attr
     1277      to temp-thbj-attr
     1278      save result in v-same.
     1279      if not v-same then leave.
     1280   end.
     1281   v-same = no.
     1282   IF v-same  and not v-to-create THEN RETURN.
     1283   run adm/shattri.p (
     1284                 input "check":U
     1285               , input p-obj-type
     1286               , input p-obj-code
     1287               , input 'dc-ref':U
     1288               , INPUT '':U
     1289                , output v-value-character
     1290                , output v-value-date
     1291                , output v-value-decimal
     1292                , output v-value-integer
     1293                , output v-value-logical
     1294                , output v-param-type
     1295                , input-output table-handle v-tth
     1296                ) no-error .
     1297   if error-status:error then do:
     1298     message
     1299     "Некорректное значение ПАРАМЕТРОВ" skip
     1300     error-status:get-message(1) skip
     1301     return-value
     1302     view-as alert-box error .
     1303     undo, return error .
     1304   end.
     1305   do TRANSACTION
     1306   on error undo, return error return-value
     1307   :
     1308     RUN thbjattr_set-section IN THIS-PROCEDURE (
     1309          input p-obj-type
     1310         ,input p-obj-code
     1311         ,input 'dc-ref':U
     1312         ,INPUT table thbjattr_thbj-attr
     1313     ) NO-ERROR.
     1314     IF ERROR-STATUS:error THEN do:
     1315       MESSAGE ERROR-STATUS:get-message(1)  SKIP
     1316       RETURN-VALUE
     1317       VIEW-AS ALERT-BOX.
     1318       UNDO, RETURN ERROR.
     1319     END.
     1320   end.
     1321   END PROCEDURE.
