      490   define new  shared variable g#news as logical no-undo.
      491   define new  shared variable g#oxml as logical no-undo.
      492   define new  shared variable g#esys as logical no-undo.
      493   define new  shared variable g#news-source-db as integer no-undo.
      494   define new  shared variable g#esys-source-esys as integer no-undo.
      495   define new  shared variable g#db-num as integer   no-undo .
      496   define new  shared variable g#userid as character no-undo .
      497   define new  shared variable g#passwd as character no-undo .
      498   procedure proc-alt-shift-f2:
      499     if not ibs.th.gbl.gbl-var:rcode
      500   then
      501     run gbl\inidebug.p .
      502   end.
      503   procedure proc-alt-shift-f3:
      504     run gbl/prvssinf.p
      505       ( input this-procedure
      506       ) .
      507   end.
      508   define variable v-inform-launched as logical no-undo initial false .
      509   procedure proc-alt-shift-f4:
      510     define variable v-action as character no-undo .
      511     if v-inform-launched = false then do:
      512       assign
      513         v-inform-launched = true
      514       .
      515       run gbl/d-inform.w
      516         (  input self
      517         ,  input this-procedure
      518         , output v-action
      519         ) no-error .
      520       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      521       assign
      522         v-inform-launched = false
      523       .
      524     end.
      525   end.
      526   procedure proc-alt-f1:
      527     run gbl/corrhelp.p
      528       (input this-procedure
      529       ) .
      530   end .
      531   on alt-shift-f2 anywhere do:
      532     run proc-alt-shift-f2.
      533   end.
      534   on alt-shift-f3 anywhere do:
      535     run proc-alt-shift-f3 in this-procedure .
      536   end.
      537   on alt-shift-f4 anywhere do:
      538     run proc-alt-shift-f4 in this-procedure.
      539   end.
      540   on alt-f1 anywhere do:
      541     run proc-alt-f1 in this-procedure .
      542   end.
      543   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      544   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile: defc-gds.i $ $Revision: 47e5c2a27e63, 2885, rls $".
      545   DEFINE  TEMP-TABLE cash-gds no-undo
      546   FIELD gds-code          like ub.goods.gds-code
      547   FIELD artic             like ub.goods.artic
      548   FIELD producer-int      as integer
      549   FIELD b-code            like ub.bar-code.b-code
      550   FIELD b-str             like ub.prod-bc.b-str
      551   FIELD bc-on              like ub.prod-bc.bc-on
      552   FIELD gds-name          like ub.goods.gds-name
      553   FIELD gds-namelong      like ub.goods.gds-name
      554   FIELD gds-name1         like ub.goods.gds-name
      555   FIELD f-name            like ub.gds-prt.f-name
