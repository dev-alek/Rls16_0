      638   procedure vss-get-info :
      639     define output parameter p-vss-revision    like vss-revision    no-undo .
      640     define output parameter p-vss-author      like vss-author      no-undo .
      641     define output parameter p-vss-date        like vss-date        no-undo .
      642     define output parameter p-vss-workfile    like vss-workfile    no-undo .
      643     define output parameter p-vss-archive     like vss-archive     no-undo .
      644     define output parameter p-vss-description like vss-description no-undo .
      645     assign
      646       p-vss-revision    = vss-revision
      647       p-vss-author      = vss-author
      648       p-vss-date        = vss-date
      649       p-vss-workfile    = vss-workfile
      650       p-vss-archive     = vss-archive
      651       p-vss-description = vss-description
      652     .
      653   end procedure.
      654   procedure vss-get-parameters :
      655     define output parameter p-vss-parameters as character no-undo .
      656   end procedure.
      657   define new global shared variable g#vssrevis-logger as handle    no-undo .
      658   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      659   define variable v-vssrevis-logger                   as handle    no-undo .
      660   procedure vss-logevent :
      661     define input  parameter p-extra-paramters as character no-undo .
      662     define variable v-vssrevis-parameters as character no-undo .
      663     do
      664     on error undo, return error return-value
      665     :
      666       if  valid-handle(v-vssrevis-logger)
      667       and v-vssrevis-logger :get-signature("logevent") <> ""
      668       then do:
      669         run vss-get-parameters in this-procedure
      670           (output v-vssrevis-parameters
      671           ).
      672         run logevent in v-vssrevis-logger
      673           (input vss-workfile
      674           ,input vss-revision
      675           ,input v-vssrevis-parameters
      676           ,input p-extra-paramters
      677           ).
      678       end.
      679     end.
      680   end procedure.
      681   assign
      682     v-vssrevis-logger = g#vssrevis-logger
      683   .
      684   if  valid-handle(v-vssrevis-logger)
      685   and v-vssrevis-logger :get-signature("logevent") <> ""
      686   then do:
      687     assign
      688       v-vssrevis-logevent = true
      689     .
      690     run vss-logevent in this-procedure (input vss-description) .
      691   end.
      692   function objExists return character
      693   (input  ifolder as character,
      694    input  iType   as character  ):
      695       define variable vFileType as character no-undo init "D,F".
      696       define variable vi        as integer no-undo.
      697       define variable vtype as character no-undo.
      698       if iType ne ?
      699       then
      700          vFileType = iType.
      701       do vi = 1 to num-entries(vFileType):
      702          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
      703          vtype = file-information:file-type.
      704          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
      705             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
      706             index(vtype , entry(vi,vFileType )) > 0
      707          then return file-information:full-pathname .
      708          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
      709          vtype = file-information:file-type.
      710          if file-information:file-name <> "" and
      711             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
      712             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
      713             index( vtype, entry(vi,vFileType )) > 0
      714          then return file-information:full-pathname .
      715       end.
      716       return ? .
      717   end.
      718   function SearchFile return character
      719   (input  ifile as character):
      720      return objExists(ifile,?).
      721   end.
      722   function SearchPFile return character
      723   (input inFile as char):
      724        define variable oFile       as character no-undo.
      725        define variable vFileSearch as character no-undo.
      726        define variable vNumEntry   as integer no-undo.
      727        if inFile = "" then return ?.
      728        vNumEntry = num-entries(inFile,".").
      729        vFileSearch = inFile.
      730        if    vNumEntry > 0
      731           and (   entry(vNumEntry,inFile,".") eq "p"
      732                or entry(vNumEntry,inFile,".") eq "w")
      733        then do:
      734           entry(vNumEntry,vFileSearch, ".") = "r".
      735           oFile = search(vFileSearch ).
      736           if oFile eq ?
      737           then
      738              oFile = search(inFile).
      739        end.
      740        else
      741           oFile = search(vFileSearch).
      742        return oFile.
      743     end.
      744   CREATE WIDGET-POOL.
      745   define variable hServerSocket    as handle       no-undo.
      746   define variable v-connect-param  as CHAR         no-undo.
      747   define variable v-srv-connected  as LOG          no-undo.
      748   define variable us-tmo           as INTEGER   INIT 60 no-undo.
      749   if num-entries (p-param, ";") = 2
      750   then do:
      751     v-connect-param = entry (1, p-param, ";").
      752     us-tmo = integer (entry (2, p-param, ";")) no-error.
      753     if us-tmo = ?
      754     then us-tmo = 60.
      755   end.
      756   else do:
      757     v-connect-param = p-param.
      758   end.
      759   DEFINE VAR C-Win AS WIDGET-HANDLE NO-UNDO.
      760   DEFINE BUTTON b-exit DEFAULT
      761        LABEL "Вы&ход "
      762        SIZE 10 BY 1 TOOLTIP "Выход из автоматической системы"
      763        BGCOLOR 8 .
      764   DEFINE BUTTON b-help DEFAULT
      765        LABEL "Помо&щь"
      766        SIZE 10 BY 1 TOOLTIP "Помощь"
      767        BGCOLOR 8 .
      768   DEFINE BUTTON Btn-st
      769        LABEL "Старт"
      770        SIZE 10 BY 1.
      771   DEFINE BUTTON Btn-log
      772        LABEL "Вкл. расширеный лог."
      773        SIZE 22 BY 1.
      774   DEFINE VARIABLE auto-log AS longchar
      775        VIEW-AS EDITOR SCROLLBAR-VERTICAL LARGE
      776        SIZE 96 BY 20 NO-UNDO.
      777   DEFINE VARIABLE mPort AS integer FORMAT ">>>>9"
      778        LABEL "Порт"
      779        VIEW-AS FILL-IN
      780        SIZE 6 BY 1 NO-UNDO.
      781   DEFINE FRAME DEFAULT-FRAME
      782        b-help AT ROW 1.17 COL 89 WIDGET-ID 4
      783        b-exit AT ROW 1.25 COL 2.5 WIDGET-ID 2
      784        Btn-st AT ROW 1.25 COL 12.5 WIDGET-ID 6
      785        Btn-log AT ROW 1.25 COL 37
      786        mPort AT ROW 1.25 COL 24
      787        auto-log AT ROW 3 COL 2.5 NO-LABEL WIDGET-ID 8
      788       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      789            SIDE-LABELS NO-UNDERLINE THREE-D
      790            AT COL 1 ROW 1
      791            SIZE 99 BY 22.58 WIDGET-ID 100.
      792   IF SESSION:DISPLAY-TYPE = "GUI":U  and not session:batch-mode THEN
      793     CREATE WINDOW C-Win ASSIGN
      794            HIDDEN             = YES
      795            TITLE              = "Сокет-сервер"
      796            HEIGHT             = 22.58
      797            WIDTH              = 99
      798            MAX-HEIGHT         = 30.04
      799            MAX-WIDTH          = 128
      800            VIRTUAL-HEIGHT     = 30.04
      801            VIRTUAL-WIDTH      = 128
      802            RESIZE             = yes
      803            SCROLL-BARS        = no
      804            STATUS-AREA        = no
      805            BGCOLOR            = ?
      806            FGCOLOR            = ?
      807            KEEP-FRAME-Z-ORDER = yes
      808            THREE-D            = yes
      809            MESSAGE-AREA       = no
      810            SENSITIVE          = yes.
      811   ELSE C-Win = CURRENT-WINDOW.
      812   ASSIGN
      813          auto-log:READ-ONLY IN FRAME DEFAULT-FRAME        = TRUE.
      814   IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(C-Win)
      815   THEN C-Win:HIDDEN = yes.
      816   if valid-handle(C-Win) then
      817   do:
      818   ON END-ERROR OF C-Win
      819   OR ENDKEY OF C-Win ANYWHERE DO:
      820     IF THIS-PROCEDURE:PERSISTENT THEN RETURN NO-APPLY.
      821   END.
      822   ON WINDOW-CLOSE OF C-Win
      823   DO:
      824     APPLY "CLOSE":U TO THIS-PROCEDURE.
      825     mWork = no.
      826     RETURN NO-APPLY.
      827   END.
      828   end.
      829   ON CHOOSE OF b-exit IN FRAME DEFAULT-FRAME
      830   DO:
      831   RUN proc-stop-srv.
      832   PAUSE 2.
      833   APPLY 'close':U TO THIS-PROCEDURE.
      834   mWork = no.
      835   END.
      836   ON CHOOSE OF Btn-st IN FRAME DEFAULT-FRAME
      837   DO:
      838   assign mPort.
      839   IF v-srv-connected = NO THEN
      840     RUN proc-start-srv IN THIS-PROCEDURE NO-ERROR.
      841   ELSE  RUN proc-stop-srv IN THIS-PROCEDURE NO-ERROR.
      842   END.
      843   ON CHOOSE OF Btn-log IN FRAME DEFAULT-FRAME
      844   DO:
      845      ibs.th.skt.Adapters.LogWrite:isDebugMod = not ibs.th.skt.Adapters.LogWrite:isDebugMod.
      846      if ibs.th.skt.Adapters.logWrite:isDebugMod
      847      then
      848         btn-log:LABEL IN FRAME DEFAULT-FRAME = "Выкл. расширеный лог.".
      849      else
      850         btn-log:LABEL IN FRAME DEFAULT-FRAME = "Вкл. расширеный лог.".
      851   END.
      852   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      853   on help of frame DEFAULT-FRAME
      854   do:
      855     run gbl/app_help.p
      856       (input this-procedure :file-name
      857       ,input ''
      858       ,input ?
      859       ) no-error.
      860     if error-status :error then do:
      861       message
      862         "Ошибка при вызове помощи"
      863         error-status :get-message(1)
      864         view-as alert-box .
      865     end.
      866   end.
      867   run minbtn-set in this-procedure .
      868   on choose of b-help in frame DEFAULT-FRAME
      869   do:
      870     apply "help":u to frame DEFAULT-FRAME .
      871   end.
      872   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      873   procedure minbtn-set :
      874       do
      875           on error undo, return error return-value
      876           :
      877           define variable ii              as integer       no-undo .
      878           define variable fh              as widget-handle no-undo .
      879           define variable hh              as widget-handle no-undo .
      880           define variable v-h             as handle        extent 4 no-undo .
      881           define variable v-name-button   as character     no-undo .
      882           define variable v-help-old-x    as decimal       no-undo .
      883           define variable v-help-old-y    as decimal       no-undo .
      884           define variable v-help-old-size as decimal       no-undo .
      885           define variable v-frame-width   as decimal       no-undo .
      886           define variable jj              as integer       no-undo .
      887           do
      888               on error undo, return error
      889               :
      890               assign
      891                   v-frame-width = frame DEFAULT-FRAME:width - 0.3
      892                   fh            = frame DEFAULT-FRAME:first-child
      893                   hh            = fh:first-child
      894                   ii            = 1
      895                   .
      896               do while valid-handle(hh):
      897                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      898                   do:
      899                       case lc(hh:name) :
      900                           when "b-help" then
      901                               do:
      902                                   hh:load-image-up("cmp/b-help.bmp":u) .
      903                                   hh:load-image-down("cmp/b-help.bmp":u) .
      904                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      905                                   hh:TOOLTIP = "Помощь" .
      906                                   v-help-old-x = hh:column .
      907                                   v-help-old-y = hh:row    .
      908                                   v-help-old-size = hh:width .
      909                                   hh:width-chars = 2.5 .
      910                               end.
      911                           when "b-print" then
      912                               do:
      913                                   hh:load-image("cmp/b-print.bmp":u) .
      914                                   hh:TOOLTIP = "Печать" .
      915                                   v-h[ii] = hh:handle .
      916                                   ii = ii + 1 .
      917                                   hh:width-chars = 3 .
      918                               end.
      919                           when "b-history" or
      920                           when "b-hist" then
      921                               do:
      922                                   hh:load-image("cmp/b-hist.bmp":u) .
      923                                   hh:TOOLTIP = "История" .
      924                                   v-h[ii] = hh:handle .
      925                                   ii = ii + 1 .
      926                                   hh:width-chars = 3 .
      927                               end.
      928                           when "b-sch" then
      929                               do:
      930                                   hh:load-image("cmp/b-sch.bmp":u) .
      931                                   hh:TOOLTIP = "Установка Фильтра" .
      932                                   v-h[ii] = hh:handle .
      933                                   ii = ii + 1 .
      934                                   hh:width-chars = 3 .
      935                               end.
      936                           when "b-hist-user" then
      937                               do:
      938                                   hh:load-image("cmp/b-hist.bmp":u) .
      939                                   hh:TOOLTIP = "История пользователя" .
      940                                   ii = ii + 1 .
      941                               end.
      942                       end case.
      943                   end.
      944                   hh = hh:next-sibling.
      945               end.
      946               b-help:column = v-frame-width - b-help:width-chars.
      947               jj = 0.
      948               repeat ii = 4 to 1 by -1 :
      949                   if valid-handle (v-h[ii] ) then
      950                   do:
      951                       jj  = jj + 1 .
      952                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      953                       v-h[ii]:row    = v-help-old-y .
      954                   end.
      955               end.
      956           end.
      957       end.
      958   end procedure.
      959   if valid-handle(C-Win) then
      960   do:
      961   ASSIGN CURRENT-WINDOW                = C-Win
      962          THIS-PROCEDURE:CURRENT-WINDOW = C-Win.
      963   end.
      964   ON CLOSE OF THIS-PROCEDURE
      965      RUN disable_UI.
      966   PAUSE 0 BEFORE-HIDE.
      967   IF v-connect-param > ''
      968   then do:
      969      if (trim(v-connect-param)begins "-S")
      970      then do:
      971         mPort = int(substring (trim(v-connect-param), 3)).
      972      end.
      973   end.
      974   if mPort eq 0
      975   then do:
      976     RUN write-to-log-event('Не указаны параметры подключения!').
      977     RUN write-to-log-event('Параметры задаются -param "Sock:-S <Port>" или -param "M:<h+>Sock:<Port>" ').
      978     mPort = 8080.
      979     RUN write-to-log-event('Задаем порт по умочанию 8080').
      980   END.
      981   MAIN-BLOCK:
      982   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      983      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      984      if not p-hide then do:
      985         if valid-handle(C-Win) then
      986           C-Win:HIDDEN = no.
      987         RUN enable_UI.
      988     end.
      989     define variable sktserv  as class SktServer no-undo.
      990     define variable logWrite as class LogWrite  no-undo.
      991     if ibs.th.skt.Adapters.logWrite:isDebugMod
      992      then
      993         btn-log:LABEL IN FRAME DEFAULT-FRAME = "Выкл. расширеный лог.".
      994      else
      995         btn-log:LABEL IN FRAME DEFAULT-FRAME = "Вкл. расширеный лог.".
      996   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      997   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      998     (output g#db-num
      999     )  .
     1000     g#language = 'RUS'.
     1001     run gbl/set-gbl.p
     1002       (input true
     1003       ,input p-user-login
     1004       ,input p-user-password
     1005       ) no-error.
     1006     run gbl/get-gbl.p no-error.
     1007     if error-status:error
     1008     then do:
     1009       message "Ошибка получения глобальный переменных." view-as alert-box.
     1010       return error.
     1011     end.
     1012     logWrite = new LogWrite().
     1013     sktserv  = new SktServer(this-procedure,us-tmo).
     1014     apply 'choose':U to Btn-st.
     1015     mWork = yes.
     1016     subscribe "write-to-log" anywhere run-procedure "write-to-log-event".
     1017     subscribe "write-to-log-codepage" anywhere run-procedure "write-to-log-event-codepage".
     1018     subscribe "runCDn" anywhere.
     1019     subscribe "runLmStatus" anywhere.
     1020     define variable CheckUpd      as class ibs.th.adm.upd.CheckUpd no-undo.
     1021     CheckUpd = new ibs.th.adm.upd.CheckUpd ().
     1022     mAsyncHelper = new ibs.th.file.AsyncHelperth().
     1023     mAsyncHelper:mProcPublish = this-procedure.
     1024     mAsyncHelper:setCurrentUserPasswd().
     1025     mAsyncHelper:MyBachMode = yes.
     1026     mAsyncHelper:WritelogInter = 5.
     1027     mAsyncHelper:MyBachMode = yes.
     1028     mAsyncHelper:maxproc    = 1.
     1029     run runCDN (1).
     1030     run runLmStatus.
     1031     IF NOT THIS-PROCEDURE:PERSISTENT THEN
     1032     do while mWork:
     1033        if valid-object(sktserv)
     1034        then
     1035           if sktserv:checkEnd()
     1036              or mAsyncHelper:isWorkShed()
     1037           then do:
     1038              wait-for close of this-procedure pause 0.001.
     1039              mAsyncHelper:WaitForOne(?).
     1040           end.
     1041           else do:
     1042              if  CheckUpd:isStopWork or CheckUpd:isNeedUpd
     1043              then do:
     1044                 RUN proc-stop-srv.
     1045                 mWork = no.
     1046              end.
     1047              else do:
     1048                   if valid-handle(C-Win) then
     1049                     wait-for connect of hServerSocket or choose of Btn-st or close of this-procedure pause 60.
     1050                   else
     1051                     wait-for connect of hServerSocket or close of this-procedure pause 60.
     1052              end.
     1053           end.
     1054        else
     1055          wait-for choose of Btn-st or close of this-procedure.
     1056     end.
     1057     delete object mAsyncHelper no-error.
     1058     unsubscribe "write-to-log".
     1059     unsubscribe "write-to-log-codePage".
     1060     unsubscribe "runCDN".
     1061     unsubscribe "runLmStatus".
     1062   END.
     1063   delete object logWrite.
     1064   PROCEDURE connproc :
     1065     define input parameter hSocket as handle no-undo.
     1066     sktserv:connproc(hSocket).
     1067   END PROCEDURE.
     1068   PROCEDURE disable_UI :
     1069     IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(C-Win)
     1070     THEN DELETE WIDGET C-Win.
     1071     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1072   END PROCEDURE.
     1073   PROCEDURE enable_UI :
     1074     DISPLAY auto-log mport
     1075         WITH FRAME DEFAULT-FRAME IN WINDOW C-Win.
     1076     ENABLE b-help b-exit Btn-st Btn-log auto-log mport
     1077         WITH FRAME DEFAULT-FRAME IN WINDOW C-Win.
     1078     VIEW C-Win.
     1079   END PROCEDURE.
     1080   PROCEDURE proc-start-srv :
     1081   DEF VAR vl-cnt AS LOG NO-UNDO.
     1082   CREATE SERVER-SOCKET hServerSocket.
     1083   hServerSocket:SET-CONNECT-PROCEDURE ("connProc":U).
     1084   vl-cnt = hServerSocket:ENABLE-CONNECTIONS("-S " + string(mPort)) NO-ERROR.
     1085   if vl-cnt = NO THEN do:
     1086     RUN write-to-log-event(substitute('Ошибка запуска сервера &1!',error-status:get-message(1) )).
     1087     return.
     1088   end.
     1089   v-srv-connected = YES.
     1090   RUN write-to-log-event(substitute('Запущен сокет-сервер с параметрами: -S &1 ', mPort)).
     1091   RUN write-to-log-event(substitute ("http://localhost:&1/help - описание запросов",mPort)).
     1092   mport:sensitive  in FRAME DEFAULT-FRAME = false.
     1093   btn-st:LABEL IN FRAME DEFAULT-FRAME = 'Стоп'.
     1094   sktserv  = new SktServer(this-procedure, us-tmo).
     1095   END PROCEDURE.
     1096   PROCEDURE proc-stop-srv :
     1097   DEF VAR vl-dis AS LOG NO-UNDO.
     1098   mport:sensitive  in FRAME DEFAULT-FRAME = true.
     1099   vl-dis = hServerSocket:disable-CONNECTIONS() NO-ERROR.
     1100   IF NOT vl-dis THEN DO:
     1101     RUN write-to-log-event(substitute('Ошибка остановки сервера &1!',error-status:get-message(1) )).
     1102     return.
     1103   END.
     1104   DELETE OBJECT sktserv no-error.
     1105   DELETE OBJECT hServerSocket no-error.
     1106   IF NOT valid-handle(hServerSocket) THEN
     1107   RUN write-to-log-event(substitute('Остановлен сокет-сервер (&1)',v-connect-param)).
     1108   ELSE RETURN.
     1109   v-srv-connected = NO.
     1110   btn-st:LABEL IN FRAME DEFAULT-FRAME = 'Старт'.
     1111   END PROCEDURE.
     1112   PROCEDURE write-to-log-event :
     1113      DEFINE INPUT PARAMETER itext       AS character NO-UNDO.
     1114      run write-to-log-event-codepage(itext, ?).
     1115   end.
     1116   PROCEDURE write-to-log-event-codepage :
     1117   DEFINE INPUT PARAMETER itext       AS character NO-UNDO.
     1118   define input parameter iSourcePage as character no-undo.
     1119   define variable str as char no-undo.
     1120   auto-log:move-to-eof( ) IN FRAME DEFAULT-FRAME NO-ERROR.
     1121   if objExists(itext,"F") eq ?
     1122   then do:
     1123      str = cur-time-string-msec() + chr(9) + itext + chr(10).
     1124      auto-log:insert-string( str ) NO-ERROR.
     1125      RUN write-to-log-file(str).
     1126   end.
     1127   else do:
     1128      def var varfile-str as longchar no-undo.
     1129      if  itext ne "filewrireLog.txt"
     1130      then do:
     1131         str = cur-time-string-sec() + chr(9) + "Файл: " +  itext + chr(10).
     1132         auto-log:insert-string(str) NO-ERROR.
     1133         auto-log:insert-file(search(itext)) no-error.
     1134      end.
     1135      else do:
     1136         str = cur-time-string-sec() + chr(10).
     1137         auto-log:insert-string(str) NO-ERROR.
     1138         auto-log:insert-file(search(itext)) no-error.
     1139      end.
     1140      if    iSourcePage eq ""
     1141         or iSourcePage eq ?
     1142      then
     1143         copy-lob
     1144            file itext
     1145            to object varfile-str
     1146         no-error.
     1147      else
     1148         copy-lob
     1149            file itext
     1150            to object varfile-str convert source codepage iSourcePage
     1151         no-error.
     1152      RUN write-to-log-file(varfile-str + chr(10)).
     1153   end.
     1154   END PROCEDURE.
     1155   PROCEDURE write-to-log-file :
     1156   DEFINE INPUT PARAMETER str-long AS longchar NO-UNDO.
     1157   define variable vFileName as character no-undo.
     1158   str-long = cur-time-string-msec() + chr(9) + str-long + chr(10) .
     1159   vFileName = "sktsrv-" + replace(string(today),"/","-") + ".log".
     1160   copy-lob
     1161   from object str-long
     1162   to file vFileName append
     1163   no-error
     1164   .
     1165   END PROCEDURE.
     1166   procedure runCdn:
     1167      define input param iTypeUpd as integer no-undo.
     1168      run utl/runproc-cdn.p ("CDN",this-procedure,iTypeUpd).
     1169   end procedure.
     1170   procedure runLMStatus:
     1171      run utl/runproc-lmsts.p ("LM-STATUS",this-procedure).
     1172   end procedure.
