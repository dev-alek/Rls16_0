        1   using ibs.th.skt.Adapters.LogWrite.
        2   using ibs.th.skt.*.
        3   using ibs.th.skt.Adapters.*.
        4   using ibs.th.skt.ControlledClients.*.
        5   define input parameter p-param as character no-undo.
        6   define input parameter p-hide as logical no-undo.
        7   define input parameter p-user-login    as character no-undo .
        8   define input parameter p-user-password as character no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision$":U .
       10   define variable vss-author      as character no-undo init "$Author$":U .
       11   define variable vss-date        as character no-undo init "$Date$":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       13   define variable vss-archive     as character no-undo init "$Archive$":U .
       14   define variable vss-description as character no-undo init "4GL socket server (HTTPD)".
       15   define variable mAsyncHelper as class ibs.th.file.AsyncHelperth  no-undo.
       16   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       17   define  shared variable auto-window-h     as handle    no-undo .
       18   define  shared variable auto-log-msg-h    as handle    no-undo .
       19   define  shared variable hand-log-msg-h    as handle    no-undo .
       20   define  shared variable log-file-name     as character no-undo initial ? .
       21   define  shared variable add-log-file-name as character no-undo initial ? .
       22   define  shared variable writelogvalue     as character no-undo initial ? .
       23   define new global shared variable g#language as character no-undo .
       24   if g#language <> '' and g#language <> 'rus':U then do:
       25     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       26   end.
       27   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       28   procedure cur-time :
       29      define output parameter p-today as date      no-undo .
       30      define output parameter p-time  as integer   no-undo .
       31     do
       32     on error undo, return error
       33     :
       34       define variable v-date1 as date      no-undo .
       35       define variable v-date2 as date      no-undo .
       36       define variable v-time  as integer   no-undo .
       37       assign
       38         v-date1 = today
       39         v-time  = time
       40         v-date2 = today
       41       .
       42       if v-date1 <> v-date2
       43       then do:
       44         assign
       45           v-date1 = today
       46           v-time  = v-time
       47         .
       48       end.
       49       assign
       50         p-today = v-date1
       51         p-time  = v-time
       52       .
       53     end.
       54   end.
       55   function cur-time-date returns character
       56   :
       57     return string(today, '99/99/9999':U) .
       58   end.
       59   function cur-time-mjd returns decimal
       60   :
       61     define variable v-date as date      no-undo .
       62     define variable v-time as integer   no-undo .
       63     run cur-time in this-procedure
       64       (output v-date
       65       ,output v-time
       66       ) .
       67     return integer(v-date) - 2400002 + (v-time / 86400) .
       68   end.
       69   function cur-time-get-ending-index returns integer
       70   (input p-number as integer
       71   )
       72   :
       73     if p-number < 0
       74     or p-number = ?
       75     then do:
       76       return 1 .
       77     end.
       78     define variable v-rest as integer   no-undo .
       79     assign
       80       p-number = p-number modulo 100
       81     .
       82     if p-number < 20
       83     then do:
       84       assign
       85         v-rest = p-number
       86       .
       87     end.
       88     else do:
       89       assign
       90         v-rest = p-number modulo 10
       91       .
       92     end.
       93     case v-rest :
       94       when 1
       95       then do:
       96         return 2 .
       97       end.
       98       when 2 or
       99       when 3 or
      100       when 4
      101       then do:
      102         return 3 .
      103       end.
      104       otherwise do:
      105         return 1 .
      106       end.
      107     end case .
      108   end.
      109   procedure cur-time-mjd-to-date :
      110      define input  parameter i-mjd-diff as decimal no-undo.
      111      define output parameter o-Date     as date    no-undo.
      112      define output parameter o-Time     as integer no-undo.
      113      define variable v-day-number as integer   no-undo .
      114      if    i-mjd-diff < 0
      115         or i-mjd-diff = ?
      116      then do:
      117         return "?" .
      118      end.
      119      assign
      120         v-day-number = truncate(i-mjd-diff,0).
      121         o-Date = date(v-day-number + 2400002).
      122         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      123     .
      124   end.
      125   function cur-time-mjd-to-string returns character
      126   (input p-mjd-diff as decimal
      127   )
      128   :
      129     define variable v-day-number as integer   no-undo .
      130     define variable v-seconds    as integer   no-undo .
      131     define variable v-hour       as integer   no-undo .
      132     define variable v-min        as integer   no-undo .
      133     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      134     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      135     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      136     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      137     if p-mjd-diff < 0
      138     or p-mjd-diff = ?
      139     then do:
      140       return "?" .
      141     end.
      142     assign
      143       v-day-number = integer(truncate(p-mjd-diff,0))
      144       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      145     .
      146     if v-seconds > 86400
      147     then do:
      148       assign
      149         v-seconds = 86400 - 1
      150       .
      151     end.
      152     if v-seconds < 0
      153     then do:
      154       assign
      155         v-seconds = 0
      156       .
      157     end.
      158     assign
      159       v-hour = truncate(v-seconds / 3600, 0)
      160     .
      161     assign
      162       v-seconds = v-seconds modulo 3600
      163     .
      164     assign
      165       v-min = truncate(v-seconds / 60, 0)
      166     .
      167     assign
      168       v-seconds = v-seconds modulo 60
      169     .
      170     return
      171         (if v-day-number <> 0
      172           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      173           else ""
      174         )
      175       + (if v-day-number <> 0 or v-hour <> 0
      176           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      177           else ""
      178         )
      179       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      180           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      181           else ""
      182         )
      183       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      184       .
      185   end.
      186   function cur-time-string returns character
      187   :
      188     define variable v-date as date      no-undo .
      189     define variable v-time as integer   no-undo .
      190     run cur-time in this-procedure
      191       (output v-date
      192       ,output v-time
      193       ) .
      194     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      195   end.
      196   function cur-time-string-sec returns character
      197   :
      198     define variable v-date as date      no-undo .
      199     define variable v-time as integer   no-undo .
      200     run cur-time in this-procedure
      201       (output v-date
      202       ,output v-time
      203       ) .
      204     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      205   end.
      206   function cur-time-custom  returns character
      207   (input p-prefix as character
      208   ,input p-date-format as character
      209   ,input p-delimiter as character
      210   ,input p-time-format as character
      211   ,input p-suffix as character
      212   )
      213   :
      214     define variable v-date as date      no-undo .
      215     define variable v-time as integer   no-undo .
      216     run cur-time in this-procedure
      217       (output v-date
      218       ,output v-time
      219       ) .
      220     return
      221       p-prefix
      222       + string(v-date, p-date-format)
      223       + p-delimiter
      224       + string(v-time, p-time-format)
      225       + p-suffix
      226       .
      227   end.
      228   function cur-time-print  returns character
      229   :
      230     define variable v-date as date      no-undo .
      231     define variable v-time as integer   no-undo .
      232     run cur-time in this-procedure
      233       (output v-date
      234       ,output v-time
      235       ) .
      236     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      237   end.
      238   function cur-time-datetime returns datetime
      239   :
      240     define variable v-char as character no-undo .
      241     define variable v-datetime as datetime no-undo .
      242     v-char = cur-time-string().
      243     v-datetime = datetime(v-char).
      244     return  v-datetime.
      245   end.
      246   function cur-time-string-msec returns character
      247   :
      248     define variable v-date as datetime  no-undo .
      249     v-date = now.
      250     return string(v-date) .
      251   end.
      252   define stream LogStream .
      253   define variable mNoTime as logical no-undo.
      254   procedure write-to-log-notime :
      255     define input param i-str as character no-undo .
      256     mNoTime = yes.
      257     run write-to-log (i-str).
      258     mNoTime = no.
      259   end.
      260   procedure write-to-log :
      261     define input param p-str as character no-undo .
      262     do
      263     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      264     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      265     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      266     :
      267       define variable log-res        as logical   no-undo .
      268       define variable v-jj           as integer   no-undo .
      269       if auto-log-msg-h <> ? then do:
      270         log-res = auto-log-msg-h:move-to-eof( ) .
      271         log-res = auto-log-msg-h:insert-string( p-str ).
      272       end.
      273       if hand-log-msg-h <> ? then do:
      274         log-res = hand-log-msg-h:move-to-eof( ) .
      275         log-res = hand-log-msg-h:insert-string( p-str ).
      276       end.
      277       assign
      278         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      279         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      280         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      281       .
      282       if add-log-file-name <> ? then do:
      283         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      284           run gbl/fileapnd.p
      285             ( input entry(v-jj, add-log-file-name, chr(1) )
      286             ,input p-str
      287             ,input 20
      288             ) no-error .
      289           if error-status:error then do:
      290             return error return-value .
      291           end.
      292         end.
      293       end.
      294       if writelogvalue eq "AsyncProc"
      295       then do:
      296          p-str = trim(p-str, (chr(13) + chr(10)) )
      297       .
      298          Publish "WriteLogAsunc" (p-str,yes).
      299       end.
      300       else if writelogvalue <> "yes" then do:
      301         run gbl/fileapnd.p
      302           ( input log-file-name
      303           ,input p-str
      304           ,input 20
      305           ) no-error .
      306         if error-status:error then do:
      307           return error return-value .
      308         end.
      309       end.
      310     end.
      311   end procedure.
      312   procedure write-to-screen :
      313     define input param p-str as character no-undo .
      314     do
      315     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      316     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      317     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      318     :
      319       define variable log-res as logical no-undo.
      320       if auto-log-msg-h <> ?
      321       then do:
      322         log-res = auto-log-msg-h:move-to-eof( ) .
      323         log-res = auto-log-msg-h:insert-string( p-str ).
      324       end.
      325       if hand-log-msg-h <> ?
      326       then do:
      327         log-res = hand-log-msg-h:move-to-eof( ) .
      328         log-res = hand-log-msg-h:insert-string( p-str ).
      329       end.
      330     end.
      331   end procedure.
      332   procedure send-msg-to-email :
      333     define input  parameter p-subject      as character no-undo .
      334     define input  parameter p-text-err     as character no-undo .
      335     define input  parameter p-attach-files as character no-undo .
      336     do
      337     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      338     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      339     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      340     :
      341       define variable v-tth             as handle    no-undo .
      342       define variable v-value-character as character no-undo .
      343       define variable v-value-date      as date      no-undo .
      344       define variable v-value-decimal   as decimal   no-undo .
      345       define variable v-value-integer   as integer   no-undo .
      346       define variable v-value-logical   as logical   no-undo .
      347       define variable v-param-type      as character no-undo .
      348       define variable v-email       as character no-undo .
      349       define variable v-tmp-str     as character no-undo .
      350       define variable v-tmp1-str    as character no-undo .
      351       define variable v-ind         as integer   no-undo .
      352       define variable v-num-entries as integer   no-undo .
      353       delete object v-tth no-error.
      354       run adm/shattri.p
      355         ( input "get":U
      356          ,input  "":U
      357          ,input  0
      358          ,input  'auto-task':U
      359          ,input  'send-msg-to-email':U
      360          ,output v-value-character
      361          ,output v-value-date
      362          ,output v-value-decimal
      363          ,output v-value-integer
      364          ,output v-value-logical
      365          ,output v-param-type
      366          ,input-output table-handle v-tth
      367         ) no-error .
      368       if not error-status :error  then do:
      369         assign
      370           v-tmp-str = v-value-character
      371         .
      372       end.
      373       delete object v-tth no-error.
      374       assign
      375         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      376         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      377         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      378         v-num-entries = num-entries( v-tmp-str, chr(44) )
      379         v-email       = "":U
      380       .
      381       do v-ind = 1 to v-num-entries
      382       :
      383         assign
      384           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      385         .
      386         if trim( v-tmp1-str ) <> "":U then do:
      387           if v-email = "":U then do:
      388             assign
      389               v-email = v-tmp1-str
      390             .
      391           end.
      392           else do:
      393             assign
      394               v-email = v-email + chr(44) + v-tmp1-str
      395             .
      396           end.
      397         end.
      398       end.
      399       if v-email <> "":U then do:
      400         run gbl/sendmail.p
      401           ( input v-email
      402           , input p-subject
      403           , input p-text-err
      404           , input p-attach-files
      405           ) no-error .
      406         if error-status :error
      407           or return-value <> "":U
      408         then do:
      409           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      410         end.
      411       end.
      412     end.
      413   end procedure.
      414   define variable mLableText as character no-undo.
      415   define variable mStartTime as datetime-tz no-undo init ?.
      416   procedure addtask:
      417      define input  parameter ITask as character no-undo.
      418      define input  parameter iProc as character no-undo.
      419      define input  parameter iParam as character no-undo.
      420      subscribe "PutFileLogAsunc" anywhere run-procedure "WriteLogAsync".
      421      if mStartTime ne ?
      422      then
      423         mAsyncHelper:AddTask (ITask,iProc,iParam,mStartTime).
      424      else
      425         mAsyncHelper:AddTask (ITask,iProc,iParam).
      426      unsubscribe "PutFileLogAsunc".
      427   end.
      428   procedure addTaskTime:
      429      define input  parameter ITask      as character no-undo.
      430      define input  parameter iProc      as character no-undo.
      431      define input  parameter iParam     as character no-undo.
      432      define input  parameter iStartTime as datetime-tz no-undo.
      433      subscribe "PutFileLogAsunc" anywhere run-procedure "WriteLogAsync".
      434      mAsyncHelper:AddTask (ITask,iProc,iParam,iStartTime).
      435      unsubscribe "PutFileLogAsunc".
      436   end.
      437   procedure waitproc:
      438      define input  parameter itext  as character no-undo.
      439      subscribe "PutFileLogAsunc" anywhere run-procedure "WriteLogAsync".
      440      run ibs\th\file\waithelper.p (mAsyncHelper,?,1,itext + " " + mLableText).
      441      unsubscribe "PutFileLogAsunc".
      442   end.
      443   procedure waitProcLable:
      444      define input  parameter itext  as character no-undo.
      445      mLableText = itext.
      446   end.
      447   procedure waitProcShed:
      448      define input  parameter iSched as character no-undo.
      449      define input  parameter itext  as character no-undo.
      450      subscribe "PutFileLogAsunc" anywhere run-procedure "WriteLogAsync".
      451      run ibs\th\file\waithelper.p (mAsyncHelper,iSched,1,itext).
      452      unsubscribe "PutFileLogAsunc".
      453   end.
      454   procedure WriteLogAsync:
      455      define input  parameter iFile as character no-undo.
      456      define variable vText as character no-undo.
      457      define variable vFile as longchar  no-undo.
      458      define variable vfileName as character no-undo.
      459      define variable vi as int64 no-undo.
      460      define variable vStr  as character no-undo.
      461      vfileName = mAsyncHelper:objExists(iFile,"f").
      462      if vfileName ne ?
      463      then do:
      464         copy-lob from file vfileName to vFile no-error.
      465         if error-status:error
      466         then do:
      467            run write-to-log (substitute ("Не удалось прочесть файл &1",iFile)).
      468         end.
      469         else do:
      470             vFile = replace (vFile,chr(13) + chr(10),chr(10)).
      471             do vi = 1 to num-entries(vFile,chr(10)) - 1:
      472               run write-to-log-notime (entry(vi, vFile,chr(10))).
      473            end.
      474         end.
      475      end.
      476      else do:
      477          assign
      478              vtext = substitute ("Процедура обработки данных не завершена. &1",ifile).
      479          run write-to-log (vtext).
      480      end.
      481   end.
