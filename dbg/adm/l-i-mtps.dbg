        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: 21e3183bea69, 738, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: SShalanin $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Aug 01 17:35:56 2016 +0300 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: l-i-mtps.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: adm/l-i-mtps.p $":U .
        7   define variable vss-description as character no-undo init "Окно входа в систему".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define variable v-cConnect          as character no-undo .
       67   define variable v-fltConnect        as character no-undo .
       68   define variable v-user-entered      as logical   no-undo init false .
       69   define variable v-name-for-load-cfg as character no-undo .
       70   define variable v-name-for-init-db  as character no-undo .
       71   define variable v-fname-cfg         as character no-undo .
       72   define variable v-err-code          as integer   no-undo .
       73   define variable v-try-connect       as logical   no-undo init false .
       74   define variable v-is-copy           as logical   no-undo init false .
       75   DEFINE VAR w-login AS WIDGET-HANDLE NO-UNDO.
       76   DEFINE BUTTON b-OK AUTO-GO
       77        LABEL "&Ввод":L
       78        SIZE 10 BY 1.
       79   DEFINE BUTTON b-quit AUTO-END-KEY
       80        LABEL "&Отмена":L
       81        SIZE 10 BY 1.
       82   DEFINE VARIABLE FILL-IN-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Имя:"
       83         VIEW-AS TEXT
       84        SIZE 5 BY .67 NO-UNDO.
       85   DEFINE VARIABLE FILL-IN-2 AS CHARACTER FORMAT "X(256)":U INITIAL "Пароль:"
       86         VIEW-AS TEXT
       87        SIZE 7.5 BY .67 NO-UNDO.
       88   DEFINE VARIABLE name AS CHARACTER FORMAT "X(12)":U
       89        VIEW-AS FILL-IN
       90        SIZE 13.5 BY 1 NO-UNDO.
       91   DEFINE VARIABLE password AS CHARACTER FORMAT "X(16)":U
       92        VIEW-AS FILL-IN
       93        SIZE 13.5 BY 1 NO-UNDO.
       94   DEFINE IMAGE IMAGE-1
       95        FILENAME "cmp/ith.bmp":U
       96        STRETCH-TO-FIT RETAIN-SHAPE
       97        SIZE 24.75 BY 3.25.
       98   DEFINE FRAME FRAME-A
       99        name AT ROW 5.75 COL 8.5 COLON-ALIGNED NO-LABEL
      100        password AT ROW 7 COL 8.5 COLON-ALIGNED NO-LABEL BLANK
      101        b-OK AT ROW 9 COL 7
      102        b-quit AT ROW 9 COL 17
      103        FILL-IN-1 AT ROW 5.92 COL 2.5 NO-LABEL
      104        FILL-IN-2 AT ROW 7.17 COL 2.5 NO-LABEL
      105        IMAGE-1 AT ROW 1.75 COL 4
      106       WITH 1 DOWN NO-BOX OVERLAY
      107            SIDE-LABELS THREE-D
      108            AT COL 1 ROW 1
      109            SIZE 30.88 BY 10.25.
      110   IF SESSION:DISPLAY-TYPE = "GUI":U THEN
      111     CREATE WINDOW w-login ASSIGN
      112            HIDDEN             = YES
      113            TITLE              = "Mobile TH Сервер касс"
      114            COLUMN             = 27
      115            ROW                = 7.58
      116            HEIGHT             = 10.25
      117            WIDTH              = 30.88
      118            MAX-HEIGHT         = 24.21
      119            MAX-WIDTH          = 100
      120            VIRTUAL-HEIGHT     = 24.21
      121            VIRTUAL-WIDTH      = 100
      122            RESIZE             = no
      123            SCROLL-BARS        = yes
      124            STATUS-AREA        = no
      125            BGCOLOR            = ?
      126            FGCOLOR            = ?
      127            THREE-D            = yes
      128            MESSAGE-AREA       = no
      129            SENSITIVE          = yes.
      130   ELSE w-login = CURRENT-WINDOW.
      131   IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(w-login)
      132   THEN w-login:HIDDEN = no.
      133   ON CHOOSE OF b-OK IN FRAME FRAME-A
      134   DO:
      135     if name :screen-value = ""
      136     then do:
      137       message
      138         "Введите имя пользователя"
      139         view-as alert-box information .
      140       apply "entry" to name .
      141       return no-apply .
      142     end.
      143   END.
      144   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      145   on help of frame FRAME-A
      146   do:
      147     run gbl/app_help.p
      148       (input this-procedure :file-name
      149       ,input ''
      150       ,input ?
      151       ) no-error.
      152     if error-status :error then do:
      153       message
      154         "Ошибка при вызове помощи"
      155         error-status :get-message(1)
      156         view-as alert-box .
      157     end.
      158   end.
      159   procedure proc-alt-shift-f2:
      160     if not ibs.th.gbl.gbl-var:rcode
      161   then
      162     run gbl\inidebug.p .
      163   end.
      164   procedure proc-alt-shift-f3:
      165     run gbl/prvssinf.p
      166       ( input this-procedure
      167       ) .
      168   end.
      169   define variable v-inform-launched as logical no-undo initial false .
      170   procedure proc-alt-shift-f4:
      171     define variable v-action as character no-undo .
      172     if v-inform-launched = false then do:
      173       assign
      174         v-inform-launched = true
      175       .
      176       run gbl/d-inform.w
      177         (  input self
      178         ,  input this-procedure
      179         , output v-action
      180         ) no-error .
      181       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      182       assign
      183         v-inform-launched = false
      184       .
      185     end.
      186   end.
      187   procedure proc-alt-f1:
      188     run gbl/corrhelp.p
      189       (input this-procedure
      190       ) .
      191   end .
      192   on alt-shift-f2 anywhere do:
      193     run proc-alt-shift-f2.
      194   end.
      195   on alt-shift-f3 anywhere do:
      196     run proc-alt-shift-f3 in this-procedure .
      197   end.
      198   on alt-shift-f4 anywhere do:
      199     run proc-alt-shift-f4 in this-procedure.
      200   end.
      201   on alt-f1 anywhere do:
      202     run proc-alt-f1 in this-procedure .
      203   end.
      204   on "ENTRY" of b-ok do:
      205     if lastkey = keycode ("RETURN") then apply "CHOOSE" to b-ok in frame FRAME-A.
      206   end.
      207   on window-close of w-login do:
      208     apply "end-error" to frame FRAME-A.
      209   end.
      210   ASSIGN
      211     CURRENT-WINDOW             = w-login
      212     SESSION:SYSTEM-ALERT-BOXES = (CURRENT-WINDOW:MESSAGE-AREA = NO)
      213     session:three-d = yes
      214   .
      215   PAUSE 0 BEFORE-HIDE.
      216   if session:date-format <> "dmy":U
      217     or session:numeric-decimal-point <> ".":U
      218     or session:numeric-separator <> ",":U
      219   then do:
      220     message
      221       vss-workfile vss-revision vss-description skip
      222       "Неправильные установки сессии progress!" skip
      223       "Формат даты должен быть - " "'dmy'":U skip
      224       "Десятичный разделитель - " "'.'":U skip
      225       "Разделитель тысяч - " "','":U skip
      226       view-as alert-box error .
      227     quit.
      228   end.
      229   IMAGE-1 :load-image("cmp/ith.bmp") .
      230   define variable v-auto-start          as logical   no-undo .
      231   define variable v-num-entries         as integer   no-undo .
      232   define variable v-ind                 as integer   no-undo .
      233   define variable v-param               as character no-undo .
      234   define variable v-port-param          as integer   no-undo .
      235   define variable v-pos-num-param       as integer   no-undo .
      236   define variable v-find-port-param     as logical   no-undo .
      237   define variable v-find-pos-num-param  as logical   no-undo .
      238   if  session :parameter <> "":u
      239   and session :parameter <> ?
      240   then do:
      241     assign
      242       v-auto-start = true
      243     .
      244     assign
      245       v-num-entries = num-entries( session:parameter, ",":u )
      246     .
      247     do v-ind = 1 to v-num-entries :
      248       assign
      249         v-param = entry( v-ind, SESSION:PARAMETER, ",":U )
      250       .
      251       if num-entries( v-param, ":":U ) = 2 then do:
      252         if v-param begins "U:" then do:
      253           assign
      254             name = entry( 2, v-param, ":":U )
      255           .
      256         end.
      257         if v-param begins "P:" then do:
      258           assign
      259             password = entry( 2, v-param, ":":U )
      260           .
      261         end.
      262         if v-param begins "port:" then do:
      263           assign
      264             v-port-param = integer(entry( 2, v-param, ":":U ))
      265           no-error .
      266           if error-status :error
      267           then do:
      268             message
      269               "Неправильное значение параметра port" skip
      270               "Обратитесь к администратору" skip
      271               error-status :get-message(1) skip
      272               return-value skip
      273             view-as alert-box error .
      274             quit.
      275           end.
      276           assign
      277             v-find-port-param = yes
      278           .
      279         end.
      280         if v-param begins "pos:" then do:
      281           assign
      282             v-pos-num-param = integer(entry( 2, v-param, ":":U ))
      283           no-error .
      284           if error-status :error
      285           then do:
      286             message
      287               "Неправильное значение параметра pos" skip
      288               "Обратитесь к администратору" skip
      289               error-status :get-message(1) skip
      290               return-value skip
      291             view-as alert-box error .
      292             quit.
      293           end.
      294           assign
      295             v-find-pos-num-param = yes
      296           .
      297         end.
      298       end.
      299     end.
      300   end.
      301   else do:
      302     message
      303       "Не заданы обязательные параметры port и pos" skip
      304       "Обратитесь к администратору"
      305     view-as alert-box error.
      306     quit.
      307   end.
      308     if v-find-port-param <> yes
      309     then do:
      310       message
      311         "Не задан обязательный параметр port" skip
      312         "Обратитесь к администратору"
      313       view-as alert-box error.
      314       quit.
      315     end.
      316     if v-find-pos-num-param <> yes
      317     then do:
      318       message
      319         "Не задан обязательный параметр pos" skip
      320         "Обратитесь к администратору"
      321       view-as alert-box error.
      322       quit.
      323     end.
      324     assign
      325       v-auto-start = false
      326     .
      327     enable
      328       name password b-ok b-quit
      329       with frame FRAME-A in window w-login .
      330     assign
      331       session :data-entry-return = yes
      332     .
      333   run gbl/font-chk.p no-error .
      334   if error-status :error
      335   then do:
      336     message
      337       "Неправильные установки системных шрифтов" skip
      338       "Обратитесь к администратору" skip
      339       error-status :get-message(1) skip
      340       return-value skip
      341       view-as alert-box information .
      342   end.
      343   do1:
      344   do
      345   on error  undo, leave
      346   on endkey undo, leave
      347   on stop   undo, leave
      348   :
      349     if lookup( '.', propath) > 0
      350     then do:
      351       define variable v-home-directory      as character no-undo .
      352       define variable v-num-entries-propath as integer   no-undo .
      353       define variable v-old-propath         as character no-undo .
      354       define variable v-new-propath         as character no-undo .
      355       define variable v-path-item           as character no-undo .
      356       assign
      357         file-info :file-name = '.'
      358         v-home-directory = file-info :full-pathname
      359       .
      360       assign
      361         v-old-propath = propath
      362         v-new-propath = ''
      363       .
      364       assign
      365         v-num-entries-propath = num-entries(v-old-propath)
      366       .
      367       do v-ind = 1 to v-num-entries-propath
      368       :
      369         assign
      370           v-path-item = entry(v-ind, v-old-propath)
      371         .
      372         if v-path-item = '.'
      373         then do:
      374           assign
      375             v-path-item = v-home-directory
      376           .
      377         end.
      378         assign
      379           v-new-propath = v-new-propath
      380                         + (if v-new-propath <> '' then ',' else '')
      381                         + v-path-item
      382         .
      383       end.
      384       assign
      385         propath = v-new-propath
      386       .
      387     end.
      388     run enable_ui in this-procedure .
      389     if v-auto-start <> true
      390     then do:
      391       WAIT-FOR GO OF frame FRAME-A focus name.
      392       assign
      393         name
      394         password .
      395     end.
      396     GET-KEY-VALUE SECTION "REP-SETS" KEY "ConPar" VALUE v-cConnect.
      397     if v-cConnect = ?
      398     or trim (v-cConnect) = ""
      399     then do:
      400       message
      401         "Не указаны параметры подключения к БД"
      402         "(секция REP-SETS ключ ConPar в .ini файле)."
      403         view-as alert-box error .
      404       undo do1, leave.
      405     end.
      406     if index(v-cConnect, '&1':u) = 0
      407     then do:
      408       message
      409         "В строке подключения к БД не указан комбинация символов &1"
      410         "(секция REP-SETS ключ ConPar в .ini файле)."
      411         view-as alert-box error .
      412       undo do1, leave.
      413     end.
      414     GET-KEY-VALUE SECTION "REP-SETS":U KEY "ConParFlt":U VALUE v-fltConnect .
      415     if trim (v-fltConnect) = "":U
      416       or trim( v-fltConnect ) = trim( v-cConnect )
      417     then do:
      418       assign
      419         v-fltConnect = ?
      420       .
      421     end.
      422     else do:
      423       if index(v-fltConnect, '&1':u) = 0
      424       then do:
      425         message
      426           "В строке подключения к БД параметров не указана комбинация символов &1"
      427           "(секция REP-SETS ключ ConParFlt в .ini файле)."
      428           view-as alert-box error .
      429         undo do1, leave.
      430       end.
      431     end.
      432     assign
      433       v-try-connect = true
      434     .
      435     run gbl/dbconn.p
      436       (input v-cConnect
      437       ,input v-fltConnect
      438       ,input name
      439       ,input password
      440       ,input-output v-user-entered
      441       ) .
      442     if userid('ub':U) = '':U
      443     then do:
      444       message
      445         "Ошибка при подключении к базе данных" skip
      446         "Неизвестный пользователь" skip
      447         view-as alert-box error .
      448       disconnect ub no-error .
      449       quit.
      450     end.
      451   end.
      452   assign
      453     session :data-entry-return = no
      454   .
      455   RUN disable_UI.
      456   if v-user-entered
      457   then do:
      458     run adm/unloaddb.w
      459       ( input name
      460        ,input password
      461        ,output v-is-copy
      462       ).
      463     if v-is-copy = false
      464     then do:
      465       run adm/chkdbkey.p no-error.
      466       if error-status :error
      467       then do:
      468         if error-status :get-message(1) <> ""
      469         then do:
      470           message
      471             vss-workfile vss-revision vss-description skip
      472             error-status :get-message(1) skip
      473             return-value skip
      474             view-as alert-box error .
      475         end.
      476       end.
      477       else do:
      478         run adm/checkcnf.p
      479           ( input "cfg-check":U
      480           ) no-error.
      481         if error-status :error
      482         then do:
      483           if error-status :get-message(1) <> ""
      484           then do:
      485             message
      486               vss-workfile vss-revision vss-description skip
      487               error-status :get-message(1) skip
      488               return-value skip
      489               view-as alert-box error .
      490           end.
      491         end.
      492         else do:
      493           run gbl/mt-serv.w ( input name
      494                             , input password
      495                             , input v-port-param
      496                             , input v-pos-num-param
      497                             , input v-auto-start
      498                             ) no-error .
      499           if error-status :error
      500           then do:
      501             disconnect ub no-error .
      502             quit.
      503           end.
      504         end.
      505       end.
      506     end.
      507   end.
      508   else do:
      509     if v-try-connect = true
      510     then do:
      511       message
      512         "Ошибка при подключении к базе данных" skip
      513         "Обратитесь к администратору" skip
      514         "Строка подключения к БД:" skip
      515         v-cConnect skip
      516         view-as alert-box error .
      517     end.
      518   end.
      519   disconnect ub no-error .
      520   quit.
      521   PROCEDURE ARM-users :
      522   END PROCEDURE.
      523   PROCEDURE disable_UI :
      524     IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(w-login)
      525     THEN DELETE WIDGET w-login.
      526     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
      527   END PROCEDURE.
      528   PROCEDURE enable_UI :
      529     DISPLAY FILL-IN-1 FILL-IN-2
      530         WITH FRAME FRAME-A IN WINDOW w-login.
      531     ENABLE IMAGE-1 name password b-OK b-quit FILL-IN-1 FILL-IN-2
      532         WITH FRAME FRAME-A IN WINDOW w-login.
      533     VIEW w-login.
      534   END PROCEDURE.
