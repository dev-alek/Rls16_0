        1   define new global shared variable g#language as character no-undo .
        2   if g#language <> '' and g#language <> 'rus':U then do:
        3     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        4   end.
        5   define new global shared variable g#library  as handle no-undo .
        6   define new global shared variable g#library2 as handle no-undo .
        7   define new  shared variable g#auto as logical no-undo.
        8   define new  shared variable g#news as logical no-undo.
        9   define new  shared variable g#oxml as logical no-undo.
       10   define new  shared variable g#esys as logical no-undo.
       11   define new  shared variable g#news-source-db as integer no-undo.
       12   define new  shared variable g#esys-source-esys as integer no-undo.
       13   define new  shared variable g#db-num as integer   no-undo .
       14   define new  shared variable g#userid as character no-undo .
       15   define new  shared variable g#passwd as character no-undo .
       16   define stream LogStream .
       17   define variable ttd        as character no-undo .
       18   define variable v-old-time as int64     no-undo .
       19   PROCEDURE write-to-log :
       20     define input parameter p-msg-str   as character no-undo .
       21     define input parameter p-call-back as handle    no-undo .
       22     do
       23     on error undo, return error
       24     :
       25       output stream LogStream to "press_db.log" page-size 0 append.
       26       put stream LogStream unformatted p-msg-str .
       27       output stream LogStream close.
       28       if  valid-handle(p-call-back)
       29       and lookup('callback-write-to-log', p-call-back :internal-entries) > 0
       30       then do:
       31         run callback-write-to-log in p-call-back
       32           (input p-msg-str
       33           ) no-error .
       34       end.
       35     end.
       36   END PROCEDURE.
       37   FUNCTION format-etime RETURNS CHARACTER
       38   (INPUT p-etime AS INT64  )
       39   :
       40     if p-etime = ?
       41     then do:
       42       return "?????????????" .
       43     end.
       44     assign
       45       p-etime = p-etime / 1000
       46     .
       47     return
       48       string( p-etime, '->>>>>>>9')
       49       + ' '
       50       + string( p-etime, 'HH:MM:SS')
       51     .
       52   END FUNCTION.
       53   define variable vWrkDir  as character no-undo init "press-db".
       54   define variable vTables  as character no-undo init "tables.txt".
       55   define variable vFileLog as character no-undo.
       56   define variable v-updating  as logical   no-undo init false .
       57   define stream sToFile.
       58   DEFINE VAR w-login AS WIDGET-HANDLE NO-UNDO.
       59   DEFINE BUTTON b-OK  NO-FOCUS
       60        LABEL "&Выполнить":L
       61        SIZE 13 BY 1
       62        BGCOLOR 15 .
       63   DEFINE BUTTON b-quit AUTO-END-KEY  NO-FOCUS
       64        LABEL "&Закрыть":L
       65        SIZE 12.4 BY 1.
       66   DEFINE VARIABLE log-edit AS CHARACTER
       67        VIEW-AS EDITOR SCROLLBAR-VERTICAL
       68        SIZE 74 BY 7.91 NO-UNDO.
       69   DEFINE VARIABLE f-db-rec AS CHARACTER FORMAT "X(256)":U INITIAL "c:~\baza~\etalon~\ub"
       70        LABEL "БД приемник"
       71        VIEW-AS FILL-IN
       72        SIZE 57.4 BY 1 TOOLTIP "Укажите полный путь к БД-приемник. Например: c:\baza\etalon\db" NO-UNDO.
       73   DEFINE VARIABLE f-db-src AS CHARACTER FORMAT "X(256)":U INITIAL "c:~\baza~\ubd~\ub"
       74        LABEL "БД источник"
       75        VIEW-AS FILL-IN
       76        SIZE 57.2 BY 1 TOOLTIP "Укажите полный путь к БД-источник. Например: c:\baza\ubd\db." NO-UNDO.
       77   DEFINE VARIABLE name AS CHARACTER FORMAT "X(12)":U INITIAL "адм"
       78        LABEL "Логин"
       79        VIEW-AS FILL-IN
       80        SIZE 20 BY 1 NO-UNDO.
       81   DEFINE VARIABLE password AS CHARACTER FORMAT "X(16)":U INITIAL "адм"
       82        LABEL "Пароль"
       83        VIEW-AS FILL-IN
       84        SIZE 20 BY 1 NO-UNDO.
       85   DEFINE VARIABLE password_display AS CHARACTER FORMAT "X(16)":U INITIAL "адм"
       86        LABEL "Пароль"
       87        VIEW-AS FILL-IN
       88        SIZE 20 BY 1 NO-UNDO.
       89   DEFINE VARIABLE radio-mode AS INTEGER INITIAL 1
       90        VIEW-AS RADIO-SET VERTICAL
       91        RADIO-BUTTONS
       92             " - только выгрузка", 1,
       93   " - только загрузка", 2,
       94   " - выгрузка и загрузка", 3
       95        SIZE 31 BY 2.38 NO-UNDO.
       96   DEFINE FRAME FRAME-A
       97        b-OK AT ROW 7.19 COL 13
       98        f-db-src AT ROW 1.76 COL 4.6 WIDGET-ID 2
       99        radio-mode AT ROW 2.91 COL 44 NO-LABEL WIDGET-ID 16
      100        name AT ROW 3 COL 16.8 COLON-ALIGNED
      101        password AT ROW 4.29 COL 16.8 COLON-ALIGNED PASSWORD-FIELD
      102        password_display AT ROW 4.29 COL 16.8 COLON-ALIGNED PASSWORD-FIELD
      103        f-db-rec AT ROW 5.57 COL 3.6 WIDGET-ID 14
      104        log-edit AT ROW 8.57 COL 4 NO-LABEL WIDGET-ID 12
      105        b-quit AT ROW 7.19 COL 26
      106       WITH 1 DOWN NO-BOX OVERLAY
      107            SIDE-LABELS THREE-D
      108            AT COL 1 ROW 1
      109            SIZE 79.8 BY 16.14.
      110   IF SESSION:DISPLAY-TYPE = "GUI":U THEN
      111     CREATE WINDOW w-login ASSIGN
      112            HIDDEN             = YES
      113            TITLE              = "Trade House 16.0"
      114            COLUMN             = 27
      115            ROW                = 7.57
      116            HEIGHT             = 16.95
      117            WIDTH              = 80.2
      118            MAX-HEIGHT         = 48.43
      119            MAX-WIDTH          = 384
      120            VIRTUAL-HEIGHT     = 48.43
      121            VIRTUAL-WIDTH      = 384
      122            RESIZE             = no
      123            SCROLL-BARS        = yes
      124            STATUS-AREA        = no
      125            BGCOLOR            = ?
      126            FGCOLOR            = ?
      127            THREE-D            = yes
      128            MESSAGE-AREA       = no
      129            SENSITIVE          = yes.
      130   ELSE w-login = CURRENT-WINDOW.
      131   ASSIGN
      132          log-edit:READ-ONLY IN FRAME FRAME-A        = TRUE.
      133   IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(w-login)
      134   THEN w-login:HIDDEN = no.
      135   ON VALUE-CHANGED OF password_display IN FRAME FRAME-A DO:
      136       IF NOT v-updating THEN DO:
      137           ASSIGN password:SCREEN-VALUE = password_display:SCREEN-VALUE.
      138       END.
      139   END.
      140   ON ANY-KEY OF password_display IN FRAME FRAME-A DO:
      141       IF LASTKEY = KEY-CODE("CTRL-V") THEN DO:
      142              ASSIGN
      143              v-updating = TRUE
      144              password:SCREEN-VALUE = System.Windows.Forms.Clipboard:GetText()
      145              password_display:SCREEN-VALUE = System.Windows.Forms.Clipboard:GetText()
      146              v-updating = FALSE.
      147              System.Windows.Forms.Clipboard:Clear().
      148              RETURN NO-APPLY.
      149       END.
      150   END.
      151   ON CHOOSE OF b-OK IN FRAME FRAME-A
      152   DO:
      153     define variable vConnect       as character no-undo.
      154     define variable v-user-entered as logical   no-undo init false .
      155     define variable vDbSrc         as character no-undo.
      156     define variable vDbRec         as character no-undo.
      157     define variable vMess          as character no-undo.
      158     assign
      159       f-db-src
      160       name
      161       password
      162       f-db-rec
      163       radio-mode
      164     .
      165     if search(trim(f-db-src) + ".db") = ? then
      166     do:
      167       message
      168        "Не найдена БД источнк."
      169         view-as alert-box information .
      170       apply "entry" to f-db-src .
      171       return no-apply .
      172     end.
      173     if search(trim(f-db-rec) + ".db") = ? then
      174     do:
      175       message
      176        "Не найдена БД приемник."
      177         view-as alert-box information .
      178       apply "entry" to f-db-rec .
      179       return no-apply .
      180     end.
      181     if name :screen-value = ""
      182     then do:
      183       message
      184         "Введите имя пользователя"
      185         view-as alert-box information .
      186       apply "entry" to name .
      187       return no-apply .
      188     end.
      189     assign
      190       vDbSrc = substitute("-db &1 -ld ub -1", trim(f-db-src))
      191       vDbRec = substitute("-db &1 -ld &2 -1 -U sysadm -P sysadm -i" ,trim(f-db-rec), "dst")
      192       vConnect = vDbSrc
      193                  + (if     name ne ""
      194                        and name ne ?
      195                     then " &1 "
      196                     else " ")
      197     .
      198     run gbl/dbconnnodisc.p
      199       (input vConnect
      200       ,input ?
      201       ,input name
      202       ,input password
      203       ,input-output v-user-entered
      204       ) no-error.
      205     if error-status:error
      206     then do:
      207        message return-value view-as alert-box.
      208        return no-apply.
      209     end.
      210     if userid('ub':U) = '':U
      211     then do:
      212       message
      213         "Ошибка при подключении к базе данных" skip
      214         "Неизвестный пользователь" skip
      215         view-as alert-box error .
      216       disconnect ub no-error .
      217       quit.
      218     end.
      219      run gbl/dbconnnodisc.p
      220       (input vDbRec
      221       ,input ?
      222       ,input name
      223       ,input password
      224       ,input-output v-user-entered
      225       ) no-error.
      226     if error-status:error
      227     then do:
      228        message return-value view-as alert-box.
      229       disconnect ub no-error .
      230        quit.
      231     end.
      232     if userid('dst':U) = '':U
      233     then do:
      234       message
      235         "Ошибка при подключении к базе данных" skip
      236         "Неизвестный пользователь" skip
      237         view-as alert-box error .
      238       disconnect ub no-error .
      239       quit.
      240     end.
      241     assign
      242       session :data-entry-return = no
      243     .
      244     if v-user-entered then
      245     do:
      246       if radio-mode = 1 then
      247         vMess = "Выгрузить данные из БД источник?".
      248       else if radio-mode = 2 then
      249         vMess = "Загрузить выгруженные данные в БД приемник?".
      250       else
      251         vMess = "Вы уверены, что хотите произвести перенос данных в другую БД для сжатия базы?".
      252       message
      253         vMess skip
      254         view-as alert-box question buttons yes-no update v-ok as logical.
      255       if v-ok <> true then do:
      256         return no-apply .
      257       end.
      258       disable b-OK b-quit with frame FRAME-A.
      259       if radio-mode = 1 or radio-mode = 3 then
      260       do:
      261         run utl/pressdbbef.p (
      262           input vWrkDir,
      263           input vTables,
      264           input this-procedure :handle
      265         ) no-error.
      266         if error-status :error then do:
      267            message
      268              substitute( "Ошибка при выполнении подготовительных процедур!" ) skip
      269              return-value skip
      270              error-status :get-message ( error-status :num-messages )
      271              view-as alert-box error
      272            .
      273            disconnect ub.
      274            disconnect dst.
      275            enable b-OK b-quit with frame FRAME-A.
      276            return no-apply.
      277         end.
      278         disconnect ub.
      279         disconnect dst.
      280         run utl/pressdbdump.p (
      281           input search(vWrkDir + "\" + vTables),
      282           f-db-src,
      283           input this-procedure :handle
      284         ) no-error.
      285         if error-status :error then do:
      286           message
      287            substitute( "Ошибка при выполнении выгрузки данных БД!" ) skip
      288            return-value skip
      289            error-status :get-message ( error-status :num-messages )
      290            view-as alert-box error
      291           .
      292           enable b-OK b-quit with frame FRAME-A.
      293           return no-apply.
      294         end.
      295       end.
      296       else do:
      297         disconnect ub.
      298         disconnect dst.
      299       end.
      300       if radio-mode = 2 or radio-mode = 3 then
      301       do:
      302         run utl/pressdbload.p (
      303           input vWrkDir,
      304           f-db-rec,
      305           input this-procedure :handle
      306         ) no-error.
      307         if error-status :error then do:
      308           message
      309             substitute( "Ошибка при выполнении зарузки данных БД!" ) skip
      310             return-value skip
      311             error-status :get-message ( error-status :num-messages )
      312            view-as alert-box error
      313           .
      314           enable b-OK b-quit with frame FRAME-A.
      315           return no-apply.
      316         end.
      317         run gbl/dbconnnodisc.p
      318             (input substitute("-db &1 -ld &2 -1 -U sysadm -P sysadm -i" ,trim(f-db-rec), "ub")
      319           ,input ?
      320           ,input name
      321           ,input password
      322           ,input-output v-user-entered
      323         ) no-error.
      324         run write-to-log in this-procedure
      325           ( string(today, '99/99/9999') + " " + string(time, 'HH:MM') +
      326             " Восстановливаем Sequences" + chr(10)
      327          ,this-procedure
      328         ).
      329         run adm/restseqr.p
      330           ( input "rest-no-msg":U
      331            ,input "":U
      332            ,input no
      333         ) no-error .
      334         disconnect ub.
      335       end.
      336       if radio-mode = 1 then
      337         vMess = "Выгрузка данных завершена.".
      338       else if radio-mode = 2 then
      339         vMess = "Загрузка данных завершена.".
      340       else
      341         vMess = "Перенос БД завершен.".
      342       run write-to-log in this-procedure
      343       ( string(today, '99/99/9999') + " " + string(time, 'HH:MM') +
      344         " " + vMess + chr(10)
      345       ,this-procedure
      346       ).
      347       message
      348         vMess
      349         view-as alert-box
      350       .
      351       enable b-OK b-quit with frame FRAME-A.
      352     end.
      353     else do:
      354       if error-status :error then
      355       do:
      356         message
      357           "Ошибка при подключении к БД" skip
      358           error-status :get-message(1) skip
      359           return-value skip
      360           view-as alert-box error .
      361         disconnect ub no-error .
      362       end.
      363       else
      364       do:
      365         message
      366           "Ошибка при подключении к базе данных" skip
      367           "Обратитесь к администратору" skip
      368           "Строка подключения к БД:" skip
      369           vConnect skip
      370           view-as alert-box error .
      371         enable b-OK b-quit with frame FRAME-A.
      372       end.
      373     end.
      374   END.
      375   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME FRAME-A:PARENT eq ?
      376   THEN FRAME FRAME-A:PARENT = ACTIVE-WINDOW.
      377   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      378   on help of frame FRAME-A
      379   do:
      380     run gbl/app_help.p
      381       (input this-procedure :file-name
      382       ,input ''
      383       ,input ?
      384       ) no-error.
      385     if error-status :error then do:
      386       message
      387         "Ошибка при вызове помощи"
      388         error-status :get-message(1)
      389         view-as alert-box .
      390     end.
      391   end.
      392   on "ENTRY" of b-ok do:
      393     if lastkey = keycode ("RETURN") then do:
      394       apply "CHOOSE" to b-ok in frame FRAME-A.
      395     end.
      396   end.
      397   on window-close of w-login do:
      398     apply "end-error" to frame FRAME-A.
      399   end.
      400   MAIN-BLOCK:
      401   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      402      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      403     ASSIGN
      404       CURRENT-WINDOW             = w-login
      405       SESSION:SYSTEM-ALERT-BOXES = (CURRENT-WINDOW:MESSAGE-AREA = NO)
      406       session:three-d = yes
      407     .
      408     PAUSE 0 BEFORE-HIDE.
      409     if session:date-format <> "dmy":U
      410     or session:numeric-decimal-point <> ".":U
      411     or session:numeric-separator <> ",":U
      412     then do:
      413       message
      414         "Неправильные установки сессии progress!" skip
      415         "Формат даты должен быть - " "'dmy'":U skip
      416         "Десятичный разделитель - " "'.'":U skip
      417         "Разделитель тысяч - " "','":U skip
      418         view-as alert-box error .
      419       quit.
      420     end.
      421     run enable_UI in this-procedure .
      422     WAIT-FOR GO OF frame FRAME-A focus name.
      423   END.
      424   RUN disable_UI in this-procedure.
      425   quit.
      426   PROCEDURE callback-write-to-log :
      427     define input parameter p-msg-str as character no-undo .
      428     define variable lok as logical   no-undo .
      429     do with frame FRAME-A
      430     on error undo, return error return-value
      431     :
      432       assign
      433         lok = log-edit :move-to-eof( )
      434         lok = log-edit :insert-string( p-msg-str )
      435         lok = log-edit :move-to-eof( )
      436       .
      437     end.
      438   END PROCEDURE.
      439   PROCEDURE disable_UI :
      440     IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(w-login)
      441     THEN DELETE WIDGET w-login.
      442     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
      443   END PROCEDURE.
      444   PROCEDURE enable_UI :
      445     DISPLAY f-db-src radio-mode f-db-rec log-edit
      446         WITH FRAME FRAME-A IN WINDOW w-login.
      447     ENABLE b-OK f-db-src radio-mode name password password_display f-db-rec log-edit b-quit
      448         WITH FRAME FRAME-A IN WINDOW w-login.
      449     VIEW w-login.
      450   END PROCEDURE.
