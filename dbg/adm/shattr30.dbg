      671   initial "@(#)$Workfile$ $Revision$".
      672   procedure grplib-get-full-name :
      673      define input parameter p-node-code  as integer      no-undo.
      674      define output parameter p-full-name as character    no-undo.
      675      do
      676   on error undo, return error
      677   :
      678       define variable v-upper-code    as integer           no-undo.
      679       define buffer buf_gds-grp       for ub.gds-grp.
      680       define buffer buf_upper_gds-grp for ub.gds-grp.
      681       find first buf_gds-grp no-lock
      682            where buf_gds-grp.node-code = p-node-code
      683       no-error.
      684       if not available buf_gds-grp
      685       then do:
      686           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      687       end.
      688       assign
      689           p-full-name  = ""
      690           v-upper-code = 1
      691       .
      692       do while buf_gds-grp.upper-code <> 0
      693       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      694       :
      695           assign
      696               p-full-name  = buf_gds-grp.node-name
      697                            + (if p-full-name <> "" then chr(47) else "")
      698                            + p-full-name
      699               v-upper-code = buf_gds-grp.upper-code
      700           .
      701           find first buf_gds-grp no-lock
      702                where buf_gds-grp.node-code = v-upper-code
      703           no-error.
      704           if not available buf_gds-grp
      705           then do:
      706               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      707                                   + string( v-upper-code )
      708                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      709           end.
      710       end.
      711       assign
      712       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      713       .
      714   end.
      715   end .
      716   procedure grplib-get-node-from-full-name :
      717   define input parameter p-full-name as character no-undo .
      718   define output parameter p-node-code as integer no-undo .
      719   define variable v-ii as integer no-undo .
      720   define variable v-upper-code as integer no-undo .
      721   define variable v-root-code as integer no-undo .
      722   define variable v-entry as character no-undo .
      723   define buffer buf_gds-grp       for ub.gds-grp.
      724   do
      725   on error undo, return error
      726   :
      727     find first buf_gds-grp no-lock
      728         where buf_gds-grp.upper-code = 0
      729     no-error .
      730     if not available buf_gds-grp
      731     then do:
      732         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      733     end.
      734     else do:
      735       assign
      736       v-root-code = buf_gds-grp.node-code
      737       .
      738     end.
      739     v-upper-code = v-root-code.
      740     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      741       assign
      742       v-entry = entry(v-ii, p-full-name, chr(47)).
      743       if v-entry = '' then leave.
      744       find first buf_gds-grp no-lock where
      745                 buf_gds-grp.node-name = v-entry
      746             and buf_gds-grp.upper-code = v-upper-code
      747             no-error.
      748       if not available buf_gds-grp then do:
      749         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      750       end.
      751       else do:
      752         p-node-code = buf_gds-grp.node-code.
      753         v-upper-code = buf_gds-grp.node-code.
      754       end.
      755     end.
      756   end.
      757   end .
      758   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      759   DEFINE VARIABLE v-db-num LIKE ub.db.db-num NO-UNDO.
      760   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO.
      761   DEFINE VARIABLE v-to-create AS logical NO-UNDO.
      762   DEFINE VARIABLE v-imgorder AS CHARACTER NO-UNDO.
      763   DEFINE BUFFER cli-buf FOR ub.clients .
      764   define variable v-tth as handle no-undo .
      765   assign
      766   v-tth = buffer thbjattr_thbj-attr:table-handle .
      767   DEFINE TEMP-TABLE temp-imgorder NO-UNDO
      768   FIELD frm-name AS CHARACTER
      769   field order as integer
      770   INDEX pi IS UNIQUE PRIMARY frm-name
      771       INDEX iorder order
      772   .
      773   DEFINE BUTTON b-down
      774        IMAGE-UP FILE "btn-down-arrow":U
      775        IMAGE-DOWN FILE "btn-down-arrow":U
      776        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      777        LABEL "Btn 2"
      778        SIZE 4 BY 1.
      779   DEFINE BUTTON B-exit AUTO-GO
      780        LABEL "&Ввод"
      781        SIZE 10 BY 1
      782        BGCOLOR 8 .
      783   DEFINE BUTTON B-Help
      784        LABEL "Помо&щь"
      785        SIZE 3 BY 1
      786        BGCOLOR 8 .
      787   DEFINE BUTTON b-quit AUTO-END-KEY
      788        LABEL "&Отмена"
      789        SIZE 10 BY 1
      790        BGCOLOR 8 .
      791   DEFINE BUTTON B-up
      792        IMAGE-UP FILE "btn-up-arrow":U
      793        IMAGE-DOWN FILE "btn-up-arrow":U
      794        IMAGE-INSENSITIVE FILE "btn-up-arrow":U
      795        LABEL "Btn 1"
      796        SIZE 4 BY 1.
      797   DEFINE QUERY BR-imgorder FOR
      798         temp-imgorder SCROLLING.
      799   DEFINE BROWSE BR-imgorder
      800     QUERY BR-imgorder DISPLAY
      801         temp-imgorder.frm-name  COLUMN-LABEL "Формат" FORMAT "X(25)"
      802   temp-imgorder.order COLUMN-LABEL "№ по пп"
      803       WITH NO-ROW-MARKERS SEPARATORS SIZE 59.5 BY 21.59
      804            TITLE "Порядок форматов изображений для поиска и ввода (при хранении вне БД)" FIT-LAST-COLUMN.
      805   DEFINE FRAME Dialog-Frame
      806        B-exit AT ROW 1 COL 1
      807        b-quit AT ROW 1 COL 11
      808        B-Help AT ROW 1 COL 95
      809        BR-imgorder AT ROW 2 COL 1 WIDGET-ID 100
      810        B-up AT ROW 4 COL 62.5 WIDGET-ID 70
      811        b-down AT ROW 6 COL 62.5 WIDGET-ID 72
      812        SPACE(32.74) SKIP(16.58)
      813       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      814            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      815            TITLE "Набор опций работы с изображениями"
      816            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      817   ASSIGN
      818          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      819          FRAME Dialog-Frame:HIDDEN           = TRUE.
      820   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      821   DO:
      822     APPLY "END-ERROR":U TO SELF.
      823   END.
      824   ON CHOOSE OF b-down IN FRAME Dialog-Frame
      825   DO:
      826   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      827   if lookup(self :type
      828            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      829            ) = 0
      830   then do:
      831     message
      832       "$Workfile$"
      833       "Указанному интерфейсному элементу фокус не может быть передан" skip
      834       "Интерфейсный элемент" self :name  skip
      835       "Тип" self :type  skip
      836       "Процедура" this-procedure :file-name skip
      837       view-as alert-box .
      838   end.
      839   else do:
      840     apply "entry":u to self  .
      841     if focus :handle <> self :handle  then do:
      842       return no-apply .
      843     end.
      844   end.
      845    DEFINE VARIABLE v-new AS INTEGER NO-UNDO.
      846   DEFINE VARIABLE v-old AS INTEGER NO-UNDO.
      847   DEFINE VARIABLE v-rec AS RECID NO-UNDO.
      848   DEFINE BUFFER buf_temp-imgorder FOR temp-imgorder.
      849   IF NOT AVAILABLE temp-imgorder THEN RETURN NO-APPLY.
      850   FIND last buf_temp-imgorder WHERE
      851               USE-INDEX iorder .
      852    IF temp-imgorder.order = buf_temp-imgorder.order THEN DO:
      853        BELL.
      854        RETURN NO-APPLY.
      855    END.
      856    ASSIGN
      857    v-old = temp-imgorder.order
      858    v-new = temp-imgorder.order + 1
      859    v-rec = RECID(temp-imgorder).
      860    .
      861    FIND FIRST buf_temp-imgorder WHERE
      862               buf_temp-imgorder.order = v-new NO-ERROR.
      863    ASSIGN
      864    temp-imgorder.order = 0.
      865    RELEASE temp-imgorder.
      866    buf_temp-imgorder.order = v-old.
      867    RELEASE buf_temp-imgorder.
      868    FIND FIRST buf_temp-imgorder WHERE
      869               buf_temp-imgorder.order = 0.
      870    ASSIGN
      871    buf_temp-imgorder.order = v-new.
      872    RELEASE buf_temp-imgorder.
      873    OPEN QUERY br-imgorder FOR EACH temp-imgorder BY temp-imgorder.order.
      874    REPOSITION br-imgorder TO RECID v-rec.
      875    APPLY "entry" TO BROWSE br-imgorder.
      876   END.
      877   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      878   DO:
      879     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      880     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      881   END.
      882   ON CHOOSE OF B-up IN FRAME Dialog-Frame
      883   DO:
      884   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      885   if lookup(self :type
      886            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      887            ) = 0
      888   then do:
      889     message
      890       "$Workfile$"
      891       "Указанному интерфейсному элементу фокус не может быть передан" skip
      892       "Интерфейсный элемент" self :name  skip
      893       "Тип" self :type  skip
      894       "Процедура" this-procedure :file-name skip
      895       view-as alert-box .
      896   end.
      897   else do:
      898     apply "entry":u to self  .
      899     if focus :handle <> self :handle  then do:
      900       return no-apply .
      901     end.
      902   end.
      903   DEFINE VARIABLE v-new AS INTEGER NO-UNDO.
      904   DEFINE VARIABLE v-old AS INTEGER NO-UNDO.
      905   DEFINE VARIABLE v-rec AS RECID NO-UNDO.
      906   DEFINE BUFFER buf_temp-imgorder FOR temp-imgorder.
      907    IF NOT AVAILABLE temp-imgorder THEN RETURN NO-APPLY.
      908    IF temp-imgorder.order = 1 THEN DO:
      909        BELL.
      910        RETURN NO-APPLY.
      911    END.
      912    ASSIGN
      913    v-old = temp-imgorder.order
      914    v-new = temp-imgorder.order - 1
      915   v-rec = RECID(temp-imgorder)
      916    .
      917    FIND FIRST buf_temp-imgorder WHERE
      918               buf_temp-imgorder.order = v-new NO-ERROR.
      919    ASSIGN
      920    temp-imgorder.order = 0.
      921    RELEASE temp-imgorder.
      922    buf_temp-imgorder.order = v-old.
      923    RELEASE buf_temp-imgorder.
      924    FIND FIRST buf_temp-imgorder WHERE
      925               buf_temp-imgorder.order = 0.
      926    ASSIGN
      927    buf_temp-imgorder.order = v-new.
      928    RELEASE buf_temp-imgorder.
      929    OPEN QUERY br-imgorder FOR EACH temp-imgorder BY temp-imgorder.order.
      930    REPOSITION br-imgorder TO RECID v-rec.
      931    APPLY "entry" TO BROWSE br-imgorder.
      932   END.
      933   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      934   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      935   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      936   on help of frame Dialog-Frame
      937   do:
      938     run gbl/app_help.p
      939       (input this-procedure :file-name
      940       ,input ''
      941       ,input ?
      942       ) no-error.
      943     if error-status :error then do:
      944       message
      945         "Ошибка при вызове помощи"
      946         error-status :get-message(1)
      947         view-as alert-box .
      948     end.
      949   end.
      950   run minbtn-set in this-procedure .
      951   on choose of b-help in frame Dialog-Frame
      952   do:
      953     apply "help":u to frame Dialog-Frame .
      954   end.
      955   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      956   procedure minbtn-set :
      957       do
      958           on error undo, return error return-value
      959           :
      960           define variable ii              as integer       no-undo .
      961           define variable fh              as widget-handle no-undo .
      962           define variable hh              as widget-handle no-undo .
      963           define variable v-h             as handle        extent 4 no-undo .
      964           define variable v-name-button   as character     no-undo .
      965           define variable v-help-old-x    as decimal       no-undo .
      966           define variable v-help-old-y    as decimal       no-undo .
      967           define variable v-help-old-size as decimal       no-undo .
      968           define variable v-frame-width   as decimal       no-undo .
      969           define variable jj              as integer       no-undo .
      970           do
      971               on error undo, return error
      972               :
      973               assign
      974                   v-frame-width = frame Dialog-Frame:width - 0.3
      975                   fh            = frame Dialog-Frame:first-child
      976                   hh            = fh:first-child
      977                   ii            = 1
      978                   .
      979               do while valid-handle(hh):
      980                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      981                   do:
      982                       case lc(hh:name) :
      983                           when "b-help" then
      984                               do:
      985                                   hh:load-image-up("cmp/b-help.bmp":u) .
      986                                   hh:load-image-down("cmp/b-help.bmp":u) .
      987                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      988                                   hh:TOOLTIP = "Помощь" .
      989                                   v-help-old-x = hh:column .
      990                                   v-help-old-y = hh:row    .
      991                                   v-help-old-size = hh:width .
      992                                   hh:width-chars = 2.5 .
      993                               end.
      994                           when "b-print" then
      995                               do:
      996                                   hh:load-image("cmp/b-print.bmp":u) .
      997                                   hh:TOOLTIP = "Печать" .
      998                                   v-h[ii] = hh:handle .
      999                                   ii = ii + 1 .
     1000                                   hh:width-chars = 3 .
     1001                               end.
     1002                           when "b-history" or
     1003                           when "b-hist" then
     1004                               do:
     1005                                   hh:load-image("cmp/b-hist.bmp":u) .
     1006                                   hh:TOOLTIP = "История" .
     1007                                   v-h[ii] = hh:handle .
     1008                                   ii = ii + 1 .
     1009                                   hh:width-chars = 3 .
     1010                               end.
     1011                           when "b-sch" then
     1012                               do:
     1013                                   hh:load-image("cmp/b-sch.bmp":u) .
     1014                                   hh:TOOLTIP = "Установка Фильтра" .
     1015                                   v-h[ii] = hh:handle .
     1016                                   ii = ii + 1 .
     1017                                   hh:width-chars = 3 .
     1018                               end.
     1019                           when "b-hist-user" then
     1020                               do:
     1021                                   hh:load-image("cmp/b-hist.bmp":u) .
     1022                                   hh:TOOLTIP = "История пользователя" .
     1023                                   ii = ii + 1 .
     1024                               end.
     1025                       end case.
     1026                   end.
     1027                   hh = hh:next-sibling.
     1028               end.
     1029               b-help:column = v-frame-width - b-help:width-chars.
     1030               jj = 0.
     1031               repeat ii = 4 to 1 by -1 :
     1032                   if valid-handle (v-h[ii] ) then
     1033                   do:
     1034                       jj  = jj + 1 .
     1035                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1036                       v-h[ii]:row    = v-help-old-y .
     1037                   end.
     1038               end.
     1039           end.
     1040       end.
     1041   end procedure.
     1042   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1043   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1044   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1045   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1046   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1047   define variable v-diasize-current-frame-height as decimal   no-undo .
     1048   define variable v-diasize-change-size          as logical   no-undo .
     1049   define variable v-diasize-resize-button        as handle    no-undo .
     1050   define variable v-diasize-wndmax               as logical   no-undo .
     1051   define variable v-diasize-wndstore             as logical   no-undo .
     1052   define variable v-diasize-proc-name            as character no-undo .
     1053   define variable v-diasize-browse-handle        as handle    no-undo .
     1054   define variable v-diasize-browse-number        as integer   no-undo .
     1055   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1056   define temp-table temp-diasize-handle no-undo
     1057     field handle-value  as handle
     1058     field save-position as decimal
     1059     index xpk is primary unique handle-value
     1060     .
     1061   define temp-table temp-browse-handle no-undo
     1062     field browse-type   as character
     1063     field browse-number as integer
     1064     field browse-handle as handle
     1065     field original-size as decimal
     1066     index xpk is primary unique browse-type browse-number
     1067     index xie browse-type browse-handle
     1068   .
     1069   procedure diasize_change-height :
     1070     define input  parameter p-change-value  as decimal   no-undo .
     1071     define input  parameter p-move-resize   as logical   no-undo .
     1072     define variable v-field-group-handle    as handle    no-undo .
     1073     define variable v-object-handle         as handle    no-undo .
     1074     define variable v-frame-height          as decimal   no-undo .
     1075     define variable v-frame-virtual-height  as decimal   no-undo .
     1076     define variable v-browse-height         as decimal   no-undo .
     1077     define variable v-window-height         as decimal   no-undo .
     1078     define variable v-window-virtual-height as decimal   no-undo .
     1079     define variable v-change-sign           as integer   no-undo .
     1080     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1081     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1082     if p-change-value > 0
     1083     then do:
     1084       if frame Dialog-Frame :height + p-change-value
     1085           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1086       then do:
     1087         assign
     1088           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1089                           - (frame Dialog-Frame :height-chars)
     1090         .
     1091         if p-change-value <= 0
     1092         then do:
     1093           run diasize_position-resize-button in this-procedure .
     1094           return .
     1095         end.
     1096       end.
     1097     end.
     1098     if p-change-value < 0
     1099     then do:
     1100       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1101       then do:
     1102         assign
     1103           p-change-value = v-diasize-orig-frame-height
     1104                          - (frame Dialog-Frame :height-chars)
     1105         .
     1106         if p-change-value >= 0
     1107         then do:
     1108           run diasize_position-resize-button in this-procedure .
     1109           return .
     1110         end.
     1111       end.
     1112     end.
     1113     if p-change-value >= 0
     1114     then do:
     1115       assign
     1116         v-change-sign = 1
     1117       .
     1118     end.
     1119     else do:
     1120       assign
     1121         v-change-sign = -1
     1122       .
     1123     end.
     1124     assign
     1125       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1126     .
     1127     if p-change-value = 0
     1128     then do:
     1129       run diasize_position-resize-button in this-procedure .
     1130       return .
     1131     end.
     1132     move_block:
     1133     do
     1134     on error undo move_block, retry move_block
     1135     :
     1136       if retry
     1137       then do:
     1138         do
     1139         on error undo move_block, leave move_block
     1140         :
     1141           if p-change-value > 0
     1142           then do:
     1143             for each buf_temp-diasize-handle
     1144             on error undo, next
     1145             :
     1146               assign
     1147                 v-object-handle = buf_temp-diasize-handle.handle-value
     1148               .
     1149               if v-object-handle <> v-diasize-resize-button
     1150               then do:
     1151                 assign
     1152                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1153                 .
     1154               end.
     1155             end.
     1156             assign
     1157               v-diasize-browse-handle :height = v-browse-height
     1158             .
     1159             for each buf_temp-browse-handle
     1160               where buf_temp-browse-handle.browse-type = 'height':u
     1161             on error undo, next
     1162             :
     1163               assign
     1164                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1165               .
     1166             end.
     1167             assign
     1168               frame Dialog-Frame :height = v-frame-height
     1169             .
     1170             if frame Dialog-Frame :scrollable = true
     1171             then do:
     1172               assign
     1173                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1174               .
     1175             end.
     1176             run diasize_position-resize-button in this-procedure .
     1177           end.
     1178           else do:
     1179             if frame Dialog-Frame :scrollable = true
     1180             then do:
     1181               assign
     1182                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1183               .
     1184             end.
     1185             assign
     1186               frame Dialog-Frame :height = v-frame-height
     1187             .
     1188             assign
     1189               v-diasize-browse-handle :height = v-browse-height
     1190             .
     1191             for each buf_temp-browse-handle
     1192               where buf_temp-browse-handle.browse-type = 'height':u
     1193             on error undo, next
     1194             :
     1195               assign
     1196                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1197               .
     1198             end.
     1199             for each buf_temp-diasize-handle
     1200             on error undo, next
     1201             :
     1202               assign
     1203                 v-object-handle = buf_temp-diasize-handle.handle-value
     1204               .
     1205               if v-object-handle <> v-diasize-resize-button
     1206               then do:
     1207                 assign
     1208                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1209                 .
     1210               end.
     1211             end.
     1212             run diasize_position-resize-button in this-procedure .
     1213           end.
     1214           assign
     1215             v-diasize-change-size = false
     1216           .
     1217           leave move_block .
     1218         end.
     1219       end.
     1220       assign
     1221         v-diasize-need-full-display = true
     1222       .
     1223       if v-diasize-change-size = false
     1224       then do:
     1225         assign
     1226           v-diasize-change-size = true
     1227         .
     1228       end.
     1229       else do:
     1230         return .
     1231       end.
     1232       assign
     1233         v-frame-height = frame Dialog-Frame :height
     1234         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1235         v-browse-height = v-diasize-browse-handle :height
     1236       .
     1237       for each buf_temp-browse-handle
     1238         where buf_temp-browse-handle.browse-type = 'height':u
     1239       :
     1240         assign
     1241           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1242         .
     1243       end.
     1244       for each buf_temp-diasize-handle
     1245       :
     1246         delete buf_temp-diasize-handle .
     1247       end.
     1248       assign
     1249         v-field-group-handle = frame Dialog-Frame :first-child
     1250       .
     1251       do while valid-handle(v-field-group-handle)
     1252       :
     1253         assign
     1254           v-object-handle = v-field-group-handle :first-child
     1255         .
     1256         do while valid-handle(v-object-handle)
     1257         :
     1258           if  v-object-handle <> v-diasize-browse-handle :handle
     1259           and can-query(v-object-handle, "row")
     1260           and can-query(v-object-handle, "height")
     1261           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1262           then do:
     1263             find first buf_temp-browse-handle
     1264               where buf_temp-browse-handle.browse-type   = 'height':u
     1265                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1266               no-error .
     1267             if available buf_temp-browse-handle
     1268             then do:
     1269             end.
     1270             else do:
     1271               create buf_temp-diasize-handle .
     1272               assign
     1273                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1274                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1275               .
     1276             end.
     1277           end.
     1278           assign
     1279             v-object-handle = v-object-handle :next-sibling
     1280           .
     1281         end.
     1282         assign
     1283           v-field-group-handle = v-field-group-handle :next-sibling
     1284         .
     1285       end.
     1286       do with frame Dialog-Frame
     1287       :
     1288         hide v-diasize-resize-button .
     1289         assign
     1290           v-diasize-resize-button :row    = 1
     1291           v-diasize-resize-button :column = 1
     1292         .
     1293       end.
     1294       if p-change-value > 0
     1295       then do:
     1296         if frame Dialog-Frame :scrollable = true
     1297         then do:
     1298           assign
     1299             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1300             no-error .
     1301           if error-status :error
     1302           or error-status :get-message(1) <> ""
     1303           then do:
     1304             undo move_block, retry move_block .
     1305           end.
     1306         end.
     1307         assign
     1308           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1309           no-error .
     1310         if error-status :error
     1311         or error-status :get-message(1) <> ""
     1312         then do:
     1313           undo move_block, retry move_block .
     1314         end.
     1315         assign
     1316           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1317           no-error .
     1318         if error-status :error
     1319         or error-status :get-message(1) <> ""
     1320         then do:
     1321           undo move_block, retry move_block .
     1322         end.
     1323         for each buf_temp-browse-handle
     1324           where buf_temp-browse-handle.browse-type = 'height':u
     1325         on error undo move_block, retry move_block
     1326         :
     1327           assign
     1328             buf_temp-browse-handle.browse-handle :height
     1329               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1330             no-error .
     1331           if error-status :error
     1332           or error-status :get-message(1) <> ""
     1333           then do:
     1334             undo move_block, retry move_block .
     1335           end.
     1336         end.
     1337         for each buf_temp-diasize-handle
     1338         on error undo move_block, retry move_block
     1339         :
     1340           assign
     1341             v-object-handle = buf_temp-diasize-handle.handle-value
     1342           .
     1343           if v-object-handle <> v-diasize-resize-button
     1344           then do:
     1345             assign
     1346               v-object-handle :row = v-object-handle :row + p-change-value
     1347               no-error .
     1348             if error-status :error
     1349             or error-status :get-message(1) <> ""
     1350             then do:
     1351               undo move_block, retry move_block .
     1352             end.
     1353           end.
     1354         end.
     1355       end.
     1356       else do:
     1357         for each buf_temp-diasize-handle
     1358         on error undo move_block, retry move_block
     1359         :
     1360           assign
     1361             v-object-handle = buf_temp-diasize-handle.handle-value
     1362           .
     1363           if v-object-handle <> v-diasize-resize-button
     1364           then do:
     1365             assign
     1366               v-object-handle :row = v-object-handle :row + p-change-value
     1367               no-error .
     1368             if error-status :error
     1369             or error-status :get-message(1) <> ""
     1370             then do:
     1371               undo move_block, retry move_block .
     1372             end.
     1373           end.
     1374         end.
     1375         assign
     1376           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1377           no-error .
     1378         if error-status :error
     1379         or error-status :get-message(1) <> ""
     1380         then do:
     1381           undo move_block, retry move_block .
     1382         end.
     1383         for each buf_temp-browse-handle
     1384           where buf_temp-browse-handle.browse-type = 'height':u
     1385         on error undo move_block, retry move_block
     1386         :
     1387           assign
     1388             buf_temp-browse-handle.browse-handle :height
     1389               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1390             no-error .
     1391           if error-status :error
     1392           or error-status :get-message(1) <> ""
     1393           then do:
     1394             undo move_block, retry move_block .
     1395           end.
     1396         end.
     1397         assign
     1398           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1399           no-error .
     1400         if error-status :error
     1401         or error-status :get-message(1) <> ""
     1402         then do:
     1403           undo move_block, retry move_block .
     1404         end.
     1405         if frame Dialog-Frame :scrollable = true
     1406         then do:
     1407           assign
     1408             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1409             no-error .
     1410           if error-status :error
     1411           or error-status :get-message(1) <> ""
     1412           then do:
     1413             undo move_block, retry move_block .
     1414           end.
     1415         end.
     1416       end.
     1417       if p-move-resize = true
     1418       then do:
     1419         run diasize_position-resize-button in this-procedure .
     1420       end.
     1421       if v-diasize-wndstore = true
     1422       then do:
     1423         if connected("ub") = true
     1424         then do:
     1425           define variable v-cntxt-db-num        as integer   no-undo .
     1426           define variable v-cntxt-userid        as character no-undo .
     1427           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1428                                             , OUTPUT v-cntxt-userid
     1429                                             ) .
     1430           run gbl/wndsizew.p
     1431             (input  v-cntxt-db-num
     1432             ,input  v-cntxt-userid
     1433             ,input  v-diasize-proc-name
     1434             ,input  'height':u
     1435             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1436             ) .
     1437         end.
     1438       end.
     1439     end.
     1440     assign
     1441       v-diasize-change-size = false
     1442     .
     1443   end procedure.
     1444   procedure diasize_set-height :
     1445     define input  parameter p-new-height  as decimal   no-undo .
     1446     define input  parameter p-move-resize as logical   no-undo .
     1447     do
     1448     on error undo, return error return-value
     1449     :
     1450       run diasize_change-height in this-procedure
     1451         (input  (p-new-height - frame Dialog-Frame :height)
     1452         ,input  p-move-resize
     1453         ) .
     1454     end.
     1455   end procedure.
     1456   procedure diasize_change-width :
     1457     define input  parameter p-change-value as decimal   no-undo .
     1458     define input  parameter p-move-resize  as logical   no-undo .
     1459     define variable v-field-group-handle   as handle    no-undo .
     1460     define variable v-object-handle        as handle    no-undo .
     1461     define variable v-frame-width          as decimal   no-undo .
     1462     define variable v-frame-virtual-width  as decimal   no-undo .
     1463     define variable v-browse-width         as decimal   no-undo .
     1464     define variable v-window-width         as decimal   no-undo .
     1465     define variable v-window-virtual-width as decimal   no-undo .
     1466     define variable v-change-sign          as integer   no-undo .
     1467     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1468     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1469     if p-change-value > 0
     1470     then do:
     1471       if frame Dialog-Frame :width + p-change-value >
     1472           session :width-chars
     1473       then do:
     1474         assign
     1475           p-change-value = session :width-chars - frame Dialog-Frame :width
     1476         .
     1477         if p-change-value <= 0
     1478         then do:
     1479           run diasize_position-resize-button in this-procedure .
     1480           return .
     1481         end.
     1482       end.
     1483     end.
     1484     if p-change-value < 0
     1485     then do:
     1486       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1487       then do:
     1488         assign
     1489           p-change-value = v-diasize-orig-frame-width
     1490                          - frame Dialog-Frame :width
     1491         .
     1492         if p-change-value >= 0
     1493         then do:
     1494           run diasize_position-resize-button in this-procedure .
     1495           return .
     1496         end.
     1497       end.
     1498     end.
     1499     if p-change-value >= 0
     1500     then do:
     1501       assign
     1502         v-change-sign = 1
     1503       .
     1504     end.
     1505     else do:
     1506       assign
     1507         v-change-sign = -1
     1508       .
     1509     end.
     1510     assign
     1511       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1512     .
     1513     if p-change-value = 0
     1514     then do:
     1515       run diasize_position-resize-button in this-procedure .
     1516       return .
     1517     end.
     1518     move_block:
     1519     do
     1520     on error undo move_block, leave move_block
     1521     :
     1522       if retry
     1523       then do:
     1524         do
     1525         on error undo move_block, leave move_block
     1526         :
     1527           if p-change-value > 0
     1528           then do:
     1529             for each buf_temp-diasize-handle
     1530             on error undo, next
     1531             :
     1532               assign
     1533                 v-object-handle = buf_temp-diasize-handle.handle-value
     1534               .
     1535               if v-object-handle <> v-diasize-resize-button
     1536               then do:
     1537                 assign
     1538                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1539                 .
     1540               end.
     1541             end.
     1542             assign
     1543               v-diasize-browse-handle :width = v-browse-width
     1544             .
     1545             for each buf_temp-browse-handle
     1546               where buf_temp-browse-handle.browse-type = 'width':u
     1547             on error undo, next
     1548             :
     1549               assign
     1550                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1551               .
     1552             end.
     1553             assign
     1554               frame Dialog-Frame :width = v-frame-width
     1555             .
     1556             if frame Dialog-Frame :scrollable = true
     1557             then do:
     1558               assign
     1559                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1560               .
     1561             end.
     1562             run diasize_position-resize-button in this-procedure .
     1563           end.
     1564           else do:
     1565             if frame Dialog-Frame :scrollable = true
     1566             then do:
     1567               assign
     1568                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1569               .
     1570             end.
     1571             assign
     1572               frame Dialog-Frame :width = v-frame-width
     1573             .
     1574             for each buf_temp-browse-handle
     1575               where buf_temp-browse-handle.browse-type = 'width':u
     1576             on error undo, next
     1577             :
     1578               assign
     1579                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1580               .
     1581             end.
     1582             assign
     1583               v-diasize-browse-handle :width = v-browse-width
     1584             .
     1585             for each buf_temp-diasize-handle
     1586             on error undo, next
     1587             :
     1588               assign
     1589                 v-object-handle = buf_temp-diasize-handle.handle-value
     1590               .
     1591               if v-object-handle <> v-diasize-resize-button
     1592               then do:
     1593                 assign
     1594                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1595                 .
     1596               end.
     1597             end.
     1598             run diasize_position-resize-button in this-procedure .
     1599           end.
     1600           assign
     1601             v-diasize-change-size = false
     1602           .
     1603           leave move_block .
     1604         end.
     1605       end.
     1606       assign
     1607         v-diasize-need-full-display = true
     1608       .
     1609       if v-diasize-change-size = false
     1610       then do:
     1611         assign
     1612           v-diasize-change-size = true
     1613         .
     1614       end.
     1615       else do:
     1616         return .
     1617       end.
     1618       assign
     1619         v-frame-width = frame Dialog-Frame :width
     1620         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1621         v-browse-width = v-diasize-browse-handle :width
     1622       .
     1623       for each buf_temp-browse-handle
     1624         where buf_temp-browse-handle.browse-type = 'width':u
     1625       :
     1626         assign
     1627           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1628         .
     1629       end.
     1630       for each buf_temp-diasize-handle
     1631       :
     1632         delete buf_temp-diasize-handle .
     1633       end.
     1634       assign
     1635         v-field-group-handle = frame Dialog-Frame :first-child
     1636       .
     1637       do while valid-handle(v-field-group-handle)
     1638       :
     1639         assign
     1640           v-object-handle = v-field-group-handle :first-child
     1641         .
     1642         do while valid-handle(v-object-handle)
     1643         :
     1644           if  v-object-handle <> v-diasize-browse-handle :handle
     1645           and v-object-handle <> v-diasize-resize-button
     1646           and can-query(v-object-handle, "row")
     1647           and can-query(v-object-handle, "height")
     1648           and ( v-object-handle :col + v-object-handle :width
     1649                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1650               )
     1651           then do:
     1652             find first buf_temp-browse-handle
     1653               where buf_temp-browse-handle.browse-type   = 'width':u
     1654                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1655               no-error .
     1656             if available buf_temp-browse-handle
     1657             then do:
     1658             end.
     1659             else do:
     1660               create buf_temp-diasize-handle .
     1661               assign
     1662                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1663                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1664               .
     1665             end.
     1666           end.
     1667           assign
     1668             v-object-handle = v-object-handle :next-sibling
     1669           .
     1670         end.
     1671         assign
     1672           v-field-group-handle = v-field-group-handle :next-sibling
     1673         .
     1674       end.
     1675       do with frame Dialog-Frame
     1676       :
     1677         hide v-diasize-resize-button .
     1678         v-diasize-resize-button :row = 1.
     1679         v-diasize-resize-button :column = 1.
     1680       end.
     1681       if p-change-value > 0
     1682       then do:
     1683         if frame Dialog-Frame :scrollable = true
     1684         then do:
     1685           assign
     1686             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1687             no-error .
     1688           if error-status :error
     1689           or error-status :get-message(1) <> ""
     1690           then do:
     1691             undo move_block, retry move_block.
     1692           end.
     1693         end.
     1694         assign
     1695           frame Dialog-Frame :width = v-frame-width + p-change-value
     1696           no-error .
     1697         if error-status :error
     1698         or error-status :get-message(1) <> ""
     1699         then do:
     1700           undo move_block, retry move_block.
     1701         end.
     1702         assign
     1703           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1704         no-error .
     1705         if error-status :error
     1706         or error-status :get-message(1) <> ""
     1707         then do:
     1708           undo move_block, retry move_block.
     1709         end.
     1710         for each buf_temp-browse-handle
     1711           where buf_temp-browse-handle.browse-type = 'width':u
     1712         on error undo move_block, retry move_block
     1713         :
     1714           assign
     1715             buf_temp-browse-handle.browse-handle :width
     1716               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1717             no-error .
     1718           if error-status :error
     1719           or error-status :get-message(1) <> ""
     1720           then do:
     1721             undo move_block, retry move_block .
     1722           end.
     1723         end.
     1724         for each buf_temp-diasize-handle
     1725         on error undo move_block, retry move_block
     1726         :
     1727           assign
     1728             v-object-handle = buf_temp-diasize-handle.handle-value
     1729           .
     1730           if v-object-handle <> v-diasize-resize-button
     1731           then do:
     1732             assign
     1733               v-object-handle :col = v-object-handle :col + p-change-value
     1734               no-error .
     1735             if error-status :error
     1736             or error-status :get-message(1) <> ""
     1737             then do:
     1738               undo move_block, retry move_block .
     1739             end.
     1740           end.
     1741         end.
     1742       end.
     1743       else do:
     1744         for each buf_temp-diasize-handle
     1745         on error undo move_block, retry move_block
     1746         :
     1747           assign
     1748             v-object-handle = buf_temp-diasize-handle.handle-value
     1749           .
     1750           if v-object-handle <> v-diasize-resize-button
     1751           then do:
     1752             assign
     1753               v-object-handle :col = v-object-handle :col + p-change-value
     1754               no-error .
     1755             if error-status :error
     1756             or error-status :get-message(1) <> ""
     1757             then do:
     1758               undo move_block, retry move_block .
     1759             end.
     1760           end.
     1761         end.
     1762         for each buf_temp-browse-handle
     1763           where buf_temp-browse-handle.browse-type = 'width':u
     1764         on error undo move_block, retry move_block
     1765         :
     1766           assign
     1767             buf_temp-browse-handle.browse-handle :width
     1768               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1769             no-error .
     1770           if error-status :error
     1771           or error-status :get-message(1) <> ""
     1772           then do:
     1773             undo move_block, retry move_block .
     1774           end.
     1775         end.
     1776         assign
     1777           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1778           no-error .
     1779         if error-status :error
     1780         or error-status :get-message(1) <> ""
     1781         then do:
     1782           undo move_block, retry move_block.
     1783         end.
     1784         assign
     1785           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1786         no-error .
     1787         if error-status :error
     1788         or error-status :get-message(1) <> ""
     1789         then do:
     1790           undo move_block, retry move_block.
     1791         end.
     1792         if frame Dialog-Frame :scrollable = true
     1793         then do:
     1794           assign
     1795             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1796           no-error .
     1797           if error-status :error
     1798           or error-status :get-message(1) <> ""
     1799           then do:
     1800             undo move_block, retry move_block.
     1801           end.
     1802         end.
     1803       end.
     1804       if p-move-resize
     1805       then do:
     1806         run diasize_position-resize-button in this-procedure .
     1807       end.
     1808       if v-diasize-wndstore = true
     1809       then do:
     1810         if connected("ub") = true
     1811         then do:
     1812           define variable v-cntxt-db-num        as integer   no-undo .
     1813           define variable v-cntxt-userid        as character no-undo .
     1814           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1815                                             , OUTPUT v-cntxt-userid
     1816                                             ) .
     1817           run gbl/wndsizew.p
     1818             (input  v-cntxt-db-num
     1819             ,input  v-cntxt-userid
     1820             ,input  v-diasize-proc-name
     1821             ,input  'width':u
     1822             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1823             ) .
     1824         end.
     1825       end.
     1826     end.
     1827     assign
     1828       v-diasize-change-size = false
     1829     .
     1830   end procedure.
     1831   procedure diasize_set-width :
     1832     define input  parameter p-new-width  as decimal   no-undo .
     1833     define input  parameter p-move-resize as logical   no-undo .
     1834     do
     1835     on error undo, return error return-value
     1836     :
     1837       run diasize_change-width in this-procedure
     1838         (input  (p-new-width - frame Dialog-Frame :width)
     1839         ,input  p-move-resize
     1840         ) .
     1841     end.
     1842   end procedure.
     1843   procedure diasize_position-resize-button :
     1844     do with frame Dialog-Frame
     1845     :
     1846       hide v-diasize-resize-button .
     1847       assign
     1848         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1849                     - 1
     1850                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1851         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1852                     - 1
     1853                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1854       .
     1855       view v-diasize-resize-button .
     1856     end.
     1857   end procedure.
     1858   on alt-right anywhere
     1859   do:
     1860     run diasize_change-width in this-procedure
     1861       (input 1
     1862       ,input true
     1863       ) .
     1864     return no-apply .
     1865   end.
     1866   on alt-left anywhere
     1867   do:
     1868     run diasize_change-width in this-procedure
     1869       (input -1
     1870       ,input true
     1871       ) .
     1872     return no-apply .
     1873   end.
     1874   on alt-down anywhere
     1875   do:
     1876     run diasize_change-height in this-procedure
     1877       (input 1
     1878       ,input true
     1879       ) .
     1880     return no-apply .
     1881   end.
     1882   on alt-up anywhere
     1883   do:
     1884     run diasize_change-height in this-procedure
     1885       (input -1
     1886       ,input true
     1887       ) .
     1888     return no-apply .
     1889   end.
     1890   on alt-enter of frame Dialog-Frame
     1891   do:
     1892     run diasize_maximize in this-procedure
     1893       (input  ?
     1894       ).
     1895     return no-apply .
     1896   end.
     1897   procedure diasize_end-move :
     1898     do
     1899     on error undo, return error return-value
     1900     :
     1901       define variable v-row-delta as decimal   no-undo .
     1902       define variable v-col-delta as decimal   no-undo .
     1903       define variable v-new-row as decimal   no-undo .
     1904       define variable v-new-col as decimal   no-undo .
     1905       assign
     1906         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1907         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1908       .
     1909       assign
     1910         v-row-delta = v-new-row - frame Dialog-Frame :height
     1911         v-col-delta = v-new-col - frame Dialog-Frame :width
     1912       .
     1913       run diasize_change-height in this-procedure
     1914         (input v-row-delta
     1915         ,input true
     1916         ) .
     1917       run diasize_change-width in this-procedure
     1918         (input v-col-delta
     1919         ,input true
     1920         ) .
     1921     end.
     1922   end procedure.
     1923   procedure diasize_maximize :
     1924     define input  parameter p-action as logical   no-undo .
     1925     do
     1926     on error undo, return error return-value
     1927     :
     1928       if p-action = ?
     1929       then do:
     1930         if v-diasize-need-maximize = true
     1931         then do:
     1932           assign
     1933             p-action = true
     1934           .
     1935         end.
     1936         else do:
     1937           assign
     1938             p-action = false
     1939           .
     1940         end.
     1941       end.
     1942       if p-action = true
     1943       then do:
     1944         run diasize_change-height in this-procedure
     1945           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1946               - frame Dialog-Frame :height-chars
     1947           ,input true
     1948           ) .
     1949         run diasize_change-width in this-procedure
     1950           (input session :width-chars
     1951               - frame Dialog-Frame :width-chars
     1952           ,input true
     1953           ) .
     1954         assign
     1955           v-diasize-need-maximize = false
     1956         .
     1957       end.
     1958       else do:
     1959         run diasize_change-width in this-procedure
     1960           (input v-diasize-orig-frame-width
     1961               - frame Dialog-Frame :width-chars
     1962           ,input true
     1963           ) .
     1964         run diasize_change-height in this-procedure
     1965           (input v-diasize-orig-frame-height
     1966               - frame Dialog-Frame :height-chars
     1967           ,input true
     1968           ) .
     1969         assign
     1970           v-diasize-need-maximize = true
     1971         .
     1972       end.
     1973     end.
     1974   end procedure.
     1975   procedure diasize_restore-orig-size :
     1976     do
     1977     on error undo, return error return-value
     1978     :
     1979       assign
     1980         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1981         v-diasize-current-frame-height = frame Dialog-Frame :height
     1982       .
     1983       run diasize_set-height in this-procedure
     1984         (input  v-diasize-orig-frame-height
     1985         ,input  true
     1986         ) .
     1987       run diasize_set-width in this-procedure
     1988         (input  v-diasize-orig-frame-width
     1989         ,input  true
     1990         ) .
     1991     end.
     1992   end procedure.
     1993   procedure diasize_restore-current-size :
     1994     do
     1995     on error undo, return error return-value
     1996     :
     1997       run diasize_set-height in this-procedure
     1998         (input  v-diasize-current-frame-height
     1999         ,input  true
     2000         ) .
     2001       run diasize_set-width in this-procedure
     2002         (input  v-diasize-current-frame-width
     2003         ,input  true
     2004         ) .
     2005     end.
     2006   end procedure.
     2007   procedure diasize_set-browse-handle :
     2008     define input  parameter p-browse-handle as handle   no-undo .
     2009     define buffer buf_temp-browse-handle for temp-browse-handle .
     2010     do
     2011     on error undo, return error return-value
     2012     :
     2013       assign
     2014         v-diasize-browse-handle = p-browse-handle
     2015       .
     2016       for each buf_temp-browse-handle
     2017       on error undo, return error return-value
     2018       :
     2019         delete buf_temp-browse-handle .
     2020       end.
     2021     end.
     2022   end procedure.
     2023   procedure diasize_add_browse :
     2024     define input  parameter p-browse-type   as character no-undo .
     2025     define input  parameter p-browse-handle as handle    no-undo .
     2026     define buffer buf_temp-browse-handle for temp-browse-handle .
     2027     do
     2028     on error undo, return error return-value
     2029     :
     2030       assign
     2031         v-diasize-browse-number = v-diasize-browse-number + 1
     2032       .
     2033       create buf_temp-browse-handle .
     2034       assign
     2035         buf_temp-browse-handle.browse-type   = p-browse-type
     2036         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2037         buf_temp-browse-handle.browse-handle = p-browse-handle
     2038       .
     2039     end.
     2040   end procedure.
     2041   procedure diasize_init :
     2042     define variable v-default-value    as logical   no-undo .
     2043     define variable v-restore-saved    as logical   no-undo .
     2044     define variable v-resize-value-str as character no-undo .
     2045     do
     2046     on error undo, return error return-value
     2047     :
     2048       do with frame Dialog-Frame
     2049       :
     2050         assign
     2051           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2052           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2053           v-diasize-browse-handle     = browse BR-imgorder :handle
     2054         .
     2055         create button v-diasize-resize-button
     2056         assign
     2057           parent        = frame Dialog-Frame :first-child
     2058           label         = "s"
     2059           height-pixels = 16
     2060           width-pixels  = 16
     2061           visible       = true
     2062           sensitive     = true
     2063           movable       = true
     2064           triggers:
     2065             on end-move persistent run diasize_end-move in this-procedure .
     2066           end triggers.
     2067         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2068         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2069         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2070         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2071         assign
     2072           v-diasize-wndmax = false
     2073         .
     2074         if connected("ub") = true
     2075         then do:
     2076           define variable v-cntxt-db-num        as integer   no-undo .
     2077           define variable v-cntxt-userid        as character no-undo .
     2078           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2079                                             , OUTPUT v-cntxt-userid
     2080                                             ) .
     2081           run gbl/wndpar_r.p
     2082             (input  v-cntxt-db-num
     2083             ,input  v-cntxt-userid
     2084             ,input  'wndmax':U
     2085             ,output v-diasize-wndmax
     2086             ,output v-default-value
     2087             ) .
     2088         end.
     2089         assign
     2090           v-diasize-wndstore = false
     2091         .
     2092         if connected("ub") = true
     2093         then do:
     2094           run gbl/wndpar_r.p
     2095             (input  v-cntxt-db-num
     2096             ,input  v-cntxt-userid
     2097             ,input  'wndstore':U
     2098             ,output v-diasize-wndstore
     2099             ,output v-default-value
     2100             ) .
     2101         end.
     2102         assign
     2103           v-diasize-proc-name = entry(1, program-name(2), '.')
     2104         .
     2105         if v-diasize-wndstore = true
     2106         then do:
     2107           assign
     2108             v-restore-saved = false
     2109           .
     2110           if connected("ub") = true
     2111           then do:
     2112             run gbl/wndsizer.p
     2113               (input  v-cntxt-db-num
     2114               ,input  v-cntxt-userid
     2115               ,input  v-diasize-proc-name
     2116               ,input  'height':u
     2117               ,output v-resize-value-str
     2118               ) .
     2119             if v-resize-value-str <> '':U
     2120             then do:
     2121               run diasize_change-height in this-procedure
     2122                 (input  integer(v-resize-value-str)
     2123                 ,input  true
     2124                 ) .
     2125               assign
     2126                 v-restore-saved = true
     2127               .
     2128             end.
     2129           end.
     2130           if connected("ub") = true
     2131           then do:
     2132             run gbl/wndsizer.p
     2133               (input  v-cntxt-db-num
     2134               ,input  v-cntxt-userid
     2135               ,input  v-diasize-proc-name
     2136               ,input  'width':u
     2137               ,output v-resize-value-str
     2138               ) .
     2139             if v-resize-value-str <> '':U
     2140             then do:
     2141               run diasize_change-width in this-procedure
     2142                 (input  integer(v-resize-value-str)
     2143                 ,input  true
     2144                 ) .
     2145               assign
     2146                 v-restore-saved = true
     2147               .
     2148             end.
     2149           end.
     2150           if v-restore-saved <> true
     2151           then do:
     2152             if v-diasize-wndmax = true
     2153             then do:
     2154               run diasize_maximize in this-procedure
     2155                 (input  true
     2156                 ) .
     2157             end.
     2158           end.
     2159         end.
     2160         else do:
     2161           if v-diasize-wndmax = true
     2162           then do:
     2163             run diasize_maximize in this-procedure
     2164               (input  true
     2165               ) .
     2166           end.
     2167         end.
     2168       end.
     2169     end.
     2170   end procedure.
     2171   procedure diasize_need-full-display :
     2172     define output parameter p-need-full-display as logical   no-undo .
     2173     do
     2174     on error undo, return error return-value
     2175     :
     2176       assign
     2177         p-need-full-display = v-diasize-need-full-display
     2178       .
     2179       assign
     2180         v-diasize-need-full-display = false
     2181       .
     2182     end.
     2183   end procedure.
     2184   procedure get-context :
     2185      define output parameter p-db-num as integer          no-undo.
     2186      define output parameter p-user-id as character        no-undo.
     2187      define variable v-login               as character    no-undo.
     2188      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2189      define buffer buf_user-login  for ub.user-login .
     2190      do
     2191      on error undo, return error
     2192      :
     2193            FIND FIRST buf_sys-ctrl no-lock.
     2194            ASSIGN
     2195               v-login = USERID("ub")
     2196               p-db-num = buf_sys-ctrl.db-num
     2197            .
     2198            FIND FIRST buf_user-login
     2199                 WHERE buf_user-login.db-num = p-db-num
     2200                   AND buf_user-login.user-login = v-login
     2201                 no-lock
     2202                 no-error
     2203                 .
     2204            IF AVAILABLE buf_user-login
     2205            THEN DO:
     2206               assign
     2207                  p-user-id = buf_user-login.user-id
     2208               .
     2209            END.
     2210      end.
     2211   end procedure.
     2212       run diasize_init in this-procedure .
     2213   MAIN-BLOCK:
     2214   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2215      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2216   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2217     run mainmenu_getcntxt in parparentproc
     2218       (output v-cntxt-db-num
     2219       ,output v-cntxt-userid
     2220       ,output v-cntxt-level
     2221       ,output v-cntxt-host-code-obj
     2222       ,output v-cntxt-obj-type
     2223       ,output v-cntxt-obj-code
     2224       ,output v-cntxt-db-num-obj
     2225       ,output v-cntxt-is-admin
     2226       ) .
     2227   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2228   ON TAB ANYWHERE
     2229   DO:
     2230   define variable ii as integer no-undo .
     2231   define variable fh as widget-handle no-undo .
     2232   define variable hh as widget-handle no-undo .
     2233   define variable v-next-widget-name as character no-undo .
     2234   if v-tab-order <> '' then do:
     2235     if self:type = "TOGGLE-BOX" then
     2236     self:BGCOLOR = ?.
     2237     assign
     2238     ii = lookup(self:name, v-tab-order).
     2239     assign
     2240     ii = ii + 1
     2241     v-next-widget-name = entry(ii, v-tab-order)
     2242     no-error .
     2243     if error-status:error then do:
     2244       assign
     2245       ii = 1
     2246       v-next-widget-name = entry( ii, v-tab-order)
     2247       .
     2248     end.
     2249     assign
     2250     fh = frame Dialog-Frame:first-child
     2251     hh = fh:first-child
     2252     .
     2253     do while valid-handle(hh):
     2254       if hh:name = v-next-widget-name then do:
     2255         if hh:sensitive  = yes
     2256         AND hh:visible = yes then do:
     2257           if hh:type = "TOGGLE-BOX":U then do:
     2258             assign
     2259             hh:BGcolor = 1
     2260             .
     2261           end.
     2262           APPLY "ENTRY" to hh.
     2263           return no-apply.
     2264         end.
     2265         else do:
     2266           APPLY "TAB" to hh.
     2267           return no-apply.
     2268         end.
     2269       end.
     2270       hh = hh:next-sibling.
     2271     end.
     2272   end.
     2273   END.
     2274   ON BACK-TAB ANYWHERE
     2275   DO:
     2276   define variable ii as integer no-undo .
     2277   define variable fh as widget-handle no-undo .
     2278   define variable hh as widget-handle no-undo .
     2279   define variable v-next-widget-name as character no-undo .
     2280   if v-tab-order <> '' then do:
     2281     assign
     2282     ii = lookup(self:name, v-tab-order).
     2283     .
     2284     assign
     2285     ii = (if ii = 1
     2286           then  num-entries(v-tab-order)
     2287           else ii - 1
     2288           )
     2289     v-next-widget-name = entry(ii, v-tab-order)
     2290     .
     2291     assign
     2292     fh = frame Dialog-Frame:first-child
     2293     hh = fh:first-child
     2294     .
     2295     do while valid-handle(hh):
     2296       if hh:name = v-next-widget-name then do:
     2297         if hh:sensitive  = yes
     2298         AND hh:visible = yes then do:
     2299           if hh:type = "TOGGLE-BOX":U then do:
     2300             assign
     2301             hh:BGcolor = 1
     2302             .
     2303           end.
     2304           APPLY "ENTRY" to hh.
     2305           return no-apply.
     2306         end.
     2307         else do:
     2308         APPLY "BACK-TAB" to hh.
     2309         return no-apply.
     2310         end.
     2311       end.
     2312       hh = hh:next-sibling.
     2313     end.
     2314     end.
     2315   END.
     2316   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2317   ON RETURN ANYWHERE
     2318   DO:
     2319   define variable ii as integer no-undo .
     2320   define variable fh as widget-handle no-undo .
     2321   define variable hh as widget-handle no-undo .
     2322   define variable v-next-widget-name as character no-undo .
     2323     if v-tab-order <> '' then do:
     2324       assign
     2325       ii = lookup(self:name, v-tab-order).
     2326       if ii = num-entries(v-tab-order) then do:
     2327           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     2328           return no-apply.
     2329       end.
     2330       if self:type <> "BUTTON" and
     2331         self:type <> "EDITOR"  then do:
     2332         run proc-move-forward in this-procedure .
     2333         return no-apply.
     2334       end.
     2335       if self:type = "BUTTON" then do:
     2336         APPLY "CHOOSE" to self.
     2337       end.
     2338       if self:type = "TOGGLE-BOX" then
     2339       self:BGCOLOR = ?.
     2340       assign
     2341       ii = ii + 1
     2342       v-next-widget-name = entry(ii, v-tab-order)
     2343       no-error .
     2344       if error-status:error then do:
     2345         assign
     2346         ii = 1
     2347         v-next-widget-name = entry( ii, v-tab-order)
     2348         .
     2349       end.
     2350       assign
     2351       fh = frame Dialog-Frame:first-child
     2352       hh = fh:first-child
     2353       .
     2354       do while valid-handle(hh):
     2355         if hh:name = v-next-widget-name then do:
     2356           if hh:sensitive  = yes
     2357           AND hh:visible = yes then do:
     2358             if hh:type = "TOGGLE-BOX":U then do:
     2359               assign
     2360               hh:BGcolor = 1
     2361               .
     2362             end.
     2363             APPLY "ENTRY" to hh.
     2364             return no-apply.
     2365           end.
     2366           else do:
     2367             APPLY "TAB" to hh.
     2368             return no-apply.
     2369           end.
     2370         end.
     2371         hh = hh:next-sibling.
     2372       end.
     2373     end.
     2374   END.
     2375   procedure proc-move-forward :
     2376   define variable ii as integer no-undo .
     2377   define variable fh as widget-handle no-undo .
     2378   define variable hh as widget-handle no-undo .
     2379   define variable v-next-widget-name as character no-undo .
     2380   do
     2381   on error undo, return error
     2382   :
     2383     if v-tab-order <> '' then do:
     2384       if self:type = "TOGGLE-BOX" then
     2385       self:BGCOLOR = ?.
     2386       assign
     2387       ii = lookup(self:name, v-tab-order).
     2388       assign
     2389       ii = ii + 1
     2390       v-next-widget-name = entry(ii, v-tab-order)
     2391       no-error .
     2392       if error-status:error then do:
     2393         assign
     2394         ii = 1
     2395         v-next-widget-name = entry( ii, v-tab-order)
     2396         .
     2397       end.
     2398       assign
     2399       fh = frame Dialog-Frame:first-child
     2400       hh = fh:first-child
     2401       .
     2402       do while valid-handle(hh):
     2403         if hh:name = v-next-widget-name then do:
     2404           if hh:sensitive  = yes
     2405           AND hh:visible = yes then do:
     2406             if hh:type = "TOGGLE-BOX":U then do:
     2407               assign
     2408               hh:BGcolor = 1
     2409               .
     2410             end.
     2411             APPLY "ENTRY" to hh.
     2412             return.
     2413           end.
     2414           else do:
     2415             assign
     2416             ii = ii + 1
     2417             v-next-widget-name = entry(ii, v-tab-order)
     2418             no-error .
     2419             if error-status:error then do:
     2420               assign
     2421               ii = 1
     2422               v-next-widget-name = entry( ii, v-tab-order)
     2423               .
     2424             end.
     2425           end.
     2426         end.
     2427         hh = hh:next-sibling.
     2428       end.
     2429     end.
     2430   end.
     2431   end procedure.
     2432     IF p-mode <> 'ПРОСМОТР':U
     2433     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     2434         MESSAGE
     2435         vss-workfile vss-revision vss-description skip
     2436         "Неверное значение параметра p-mode" p-mode
     2437         VIEW-AS ALERT-BOX ERROR.
     2438         UNDO, RETURN ERROR.
     2439     END.
     2440     IF p-obj-type <> ""
     2441     THEN DO:
     2442         MESSAGE
     2443         vss-workfile vss-revision vss-description skip
     2444         "Неверное значение параметра p-obj-type" p-obj-type
     2445         VIEW-AS ALERT-BOX ERROR.
     2446         UNDO, RETURN ERROR.
     2447     END.
     2448     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     2449       if v-cntxt-db-num > 0 then do:
     2450         MESSAGE
     2451         vss-workfile vss-revision vss-description skip
     2452         "Нельзя редактировать параметр в УБД"
     2453         VIEW-AS ALERT-BOX ERROR.
     2454         UNDO, RETURN ERROR.
     2455       end.
     2456       FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
     2457                 LOCKED_thbj-attr.obj-type = p-obj-type
     2458           AND   LOCKED_thbj-attr.obj-code = p-obj-code
     2459           AND   LOCKED_thbj-attr.upper-prop-code = 'images':U
     2460           AND LOCKED_thbj-attr.prop-code = "":U
     2461           NO-WAIT NO-ERROR.
     2462        if locked locked_thbj-attr then do:
     2463           message
     2464           vss-workfile vss-revision vss-description skip
     2465            "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
     2466           view-as alert-box error .
     2467           undo, return error.
     2468         end.
     2469     END.
     2470     ELSE DO:
     2471         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
     2472             LOCKED_thbj-attr.obj-type = p-obj-type
     2473       AND   LOCKED_thbj-attr.obj-code = p-obj-code
     2474       AND   LOCKED_thbj-attr.upper-prop-code = 'images':U
     2475       AND   LOCKED_thbj-attr.prop-code = '':U NO-ERROR.
     2476     END.
     2477     if not available locked_thbj-attr then do:
     2478       ASSIGN
     2479       v-to-create  = YES.
     2480       message
     2481       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     2482                   chr(10))
     2483       view-as alert-box WARNING.
     2484     end.
     2485     RUN FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     2486     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     2487     RUN Myenable in this-procedure .
     2488     WAIT-FOR GO OF FRAME Dialog-Frame.
     2489   END.
     2490   RUN disable_UI.
     2491   PROCEDURE disable_UI :
     2492     HIDE FRAME Dialog-Frame.
     2493   END PROCEDURE.
     2494   PROCEDURE enable_UI :
     2495     ENABLE B-exit b-quit B-Help BR-imgorder B-up b-down
     2496         WITH FRAME Dialog-Frame.
     2497     VIEW FRAME Dialog-Frame.
     2498     OPEN QUERY br-imgorder FOR EACH temp-imgorder BY temp-imgorder.order.
     2499   END PROCEDURE.
     2500   PROCEDURE fill-widgets :
     2501   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     2502   DEFINE VARIABLE v-entry AS CHARACTER NO-UNDO.
     2503   define variable v-param-type as character no-undo .
     2504   define variable v-value-character as character no-undo .
     2505   define variable v-value-date as date no-undo .
     2506   define variable v-value-decimal as decimal no-undo .
     2507   define variable v-value-integer as INTEGER no-undo .
     2508   define variable v-value-logical AS LOGICAL no-undo .
     2509   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     2510   FOR EACH thbjattr_thbj-attr:
     2511     delete thbjattr_thbj-attr.
     2512   end.
     2513   FOR EACH temp-thbj-attr:
     2514     delete temp-thbj-attr.
     2515   end.
     2516   run adm/shattri.p (
     2517                 input "init":U
     2518               , input p-obj-type
     2519               , input p-obj-code
     2520               , input 'images':U
     2521               , input "":U
     2522               , output v-value-character
     2523               , output v-value-date
     2524               , output v-value-decimal
     2525               , output v-value-integer
     2526               , output v-value-logical
     2527               , output v-param-type
     2528               , INPUT-OUTPUT table-handle v-tth
     2529               ) no-error .
     2530   if error-status:error
     2531   and not available locked_thbj-attr then do:
     2532     message
     2533     "Не удалось получить начальные значения настроек" skip
     2534     error-status:get-message(1) return-value
     2535     view-as alert-box error .
     2536     undo, return error .
     2537   end.
     2538   FOR EACH thbjattr_thbj-attr:
     2539     ASSIGN
     2540     v-entry = thbjattr_thbj-attr.prop-code.
     2541     IF v-entry = 'imgorder':U THEN DO:
     2542       ASSIGN
     2543       v-imgorder = thbjattr_thbj-attr.property-value-character
     2544       .
     2545     END.
     2546     create temp-thbj-attr.
     2547     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     2548   END.
     2549   END PROCEDURE.
     2550   PROCEDURE MyEnable :
     2551   define variable v-ii as integer no-undo .
     2552   DEFINE BUFFER buf_temp-imgorder FOR temp-imgorder.
     2553   for each buf_temp-imgorder:
     2554     delete buf_temp-imgorder.
     2555   end.
     2556   do v-ii = 1 to num-entries(v-imgorder):
     2557     CREATE buf_temp-imgorder.
     2558     ASSIGN
     2559     buf_temp-imgorder.frm-name = entry(v-ii, v-imgorder)
     2560     buf_temp-imgorder.order = v-ii
     2561     .
     2562   end.
     2563   display
     2564   with frame Dialog-Frame .
     2565   ENABLE
     2566   B-exit WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2567   b-quit
     2568   B-Help
     2569   b-up when p-mode = 'ИЗМЕНЕНИЕ':U
     2570   b-down when p-mode = 'ИЗМЕНЕНИЕ':U
     2571   br-imgorder
     2572   WITH FRAME Dialog-Frame.
     2573   VIEW FRAME Dialog-Frame.
     2574   IF p-mode = 'ПРОСМОТР':U THEN DO:
     2575       HIDE
     2576       b-exit
     2577       IN FRAME Dialog-Frame.
     2578       ASSIGN
     2579       b-quit:LABEL = "&Выход"
     2580       b-quit:column = 1
     2581       .
     2582   END.
     2583   OPEN QUERY br-imgorder FOR EACH temp-imgorder BY temp-imgorder.order.
     2584   END PROCEDURE.
     2585   PROCEDURE proc-save :
     2586   define variable v-value-character as character no-undo .
     2587   define variable v-value-date as date no-undo .
     2588   define variable v-value-decimal as decimal no-undo .
     2589   define variable v-value-integer as INTEGER no-undo .
     2590   define variable v-value-logical AS LOGICAL no-undo .
     2591   define variable v-param-type as character no-undo .
     2592   define variable v-gds-copy-list as character no-undo .
     2593   define variable v-gdsreffi as character no-undo .
     2594   define variable wh as widget-handle no-undo .
     2595   define variable fh as widget-handle no-undo .
     2596   define variable v-same as logical no-undo .
     2597   DEFINE BUFFER buf_temp-imgorder FOR temp-imgorder.
     2598   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     2599   v-imgorder = ''.
     2600   fOR EACH buf_temp-imgorder
     2601   BY buf_temp-imgorder.order:
     2602     ASSIGN
     2603     v-imgorder =  substitute("&1,&2"
     2604                             ,v-imgorder
     2605                             , buf_temp-imgorder.frm-name
     2606                             ).
     2607   END.
     2608   ASSIGN
     2609   v-imgorder = TRIM(v-imgorder, chr(44)).
     2610   assign
     2611   fh = frame Dialog-Frame:first-child
     2612   wh = fh:first-child
     2613   .
     2614   do while valid-handle(wh):
     2615     if wh:private-data begins "recid=" then do:
     2616       find first thbjattr_thbj-attr where
     2617                 recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     2618       assign
     2619       buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     2620     end.
     2621     wh = wh:next-sibling.
     2622   end.
     2623   release thbjattr_thbj-attr.
     2624   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'imgorder':U.
     2625   assign
     2626   thbjattr_thbj-attr.property-value-character = v-imgorder
     2627   .
     2628   release thbjattr_thbj-attr.
     2629   v-same = yes.
     2630   for each thbjattr_thbj-attr,
     2631       first temp-thbj-attr where
     2632             temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     2633         and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     2634         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     2635         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code:
     2636      buffer-compare
     2637      thbjattr_thbj-attr
     2638      to temp-thbj-attr
     2639      save result in v-same.
     2640      if not v-same then leave.
     2641   end.
     2642   v-same = no.
     2643   IF v-same  and not v-to-create THEN RETURN.
     2644   run adm/shattri.p (
     2645                 input "check":U
     2646               , input p-obj-type
     2647               , input p-obj-code
     2648               , input 'images':U
     2649               , INPUT '':U
     2650                , output v-value-character
     2651                , output v-value-date
     2652                , output v-value-decimal
     2653                , output v-value-integer
     2654                , output v-value-logical
     2655                , output v-param-type
     2656                , input-output table-handle v-tth
     2657                ) no-error .
     2658   if error-status:error then do:
     2659     message
     2660     "Некорректное значение ПАРАМЕТРОВ" skip
     2661     error-status:get-message(1) skip
     2662     return-value
     2663     view-as alert-box error .
     2664     undo, return error .
     2665   end.
     2666   do TRANSACTION
     2667   on error undo, return error return-value
     2668   :
     2669     RUN thbjattr_set-section IN THIS-PROCEDURE (
     2670          input p-obj-type
     2671         ,input p-obj-code
     2672         ,input 'images':U
     2673         ,INPUT table thbjattr_thbj-attr
     2674     ) NO-ERROR.
     2675     IF ERROR-STATUS:error THEN do:
     2676       MESSAGE ERROR-STATUS:get-message(1)  SKIP
     2677       RETURN-VALUE
     2678       VIEW-AS ALERT-BOX.
     2679       UNDO, RETURN ERROR.
     2680     END.
     2681   end.
     2682   END PROCEDURE.
