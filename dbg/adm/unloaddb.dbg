        1   CREATE WIDGET-POOL.
        2   define input parameter  p-user-name as character no-undo .
        3   define input parameter  p-user-pswd as character no-undo .
        4   define output parameter p-is-copy   as logical   no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Âûãðóçêà ÓÁÄ".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   procedure proc-alt-shift-f2:
       66     if not ibs.th.gbl.gbl-var:rcode
       67   then
       68     run gbl\inidebug.p .
       69   end.
       70   procedure proc-alt-shift-f3:
       71     run gbl/prvssinf.p
       72       ( input this-procedure
       73       ) .
       74   end.
       75   define variable v-inform-launched as logical no-undo initial false .
       76   procedure proc-alt-shift-f4:
       77     define variable v-action as character no-undo .
       78     if v-inform-launched = false then do:
       79       assign
       80         v-inform-launched = true
       81       .
       82       run gbl/d-inform.w
       83         (  input self
       84         ,  input this-procedure
       85         , output v-action
       86         ) no-error .
       87       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       88       assign
       89         v-inform-launched = false
       90       .
       91     end.
       92   end.
       93   procedure proc-alt-f1:
       94     run gbl/corrhelp.p
       95       (input this-procedure
       96       ) .
       97   end .
       98   on alt-shift-f2 anywhere do:
       99     run proc-alt-shift-f2.
      100   end.
      101   on alt-shift-f3 anywhere do:
      102     run proc-alt-shift-f3 in this-procedure .
      103   end.
      104   on alt-shift-f4 anywhere do:
      105     run proc-alt-shift-f4 in this-procedure.
      106   end.
      107   on alt-f1 anywhere do:
      108     run proc-alt-f1 in this-procedure .
      109   end.
      110   define new global shared variable g#language as character no-undo .
      111   if g#language <> '' and g#language <> 'rus':U then do:
      112     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      113   end.
      114   define new global shared variable g#library  as handle no-undo .
      115   define new global shared variable g#library2 as handle no-undo .
      116   define new  shared variable g#auto as logical no-undo.
      117   define new  shared variable g#news as logical no-undo.
      118   define new  shared variable g#oxml as logical no-undo.
      119   define new  shared variable g#esys as logical no-undo.
      120   define new  shared variable g#news-source-db as integer no-undo.
      121   define new  shared variable g#esys-source-esys as integer no-undo.
      122   define new  shared variable g#db-num as integer   no-undo .
      123   define new  shared variable g#userid as character no-undo .
      124   define new  shared variable g#passwd as character no-undo .
      125   DEFINE VAR C-Win AS WIDGET-HANDLE NO-UNDO.
      126   DEFINE FRAME DEFAULT-FRAME
      127       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      128            SIDE-LABELS NO-UNDERLINE THREE-D
      129            AT COL 1.25 ROW 1.04
      130            SIZE 29.88 BY 3.92.
      131   IF SESSION:DISPLAY-TYPE = "GUI":U THEN
      132     CREATE WINDOW C-Win ASSIGN
      133            HIDDEN             = YES
      134            TITLE              = "Âûãðóçêà ÓÁÄ"
      135            HEIGHT             = 4.08
      136            WIDTH              = 32
      137            MAX-HEIGHT         = 40.33
      138            MAX-WIDTH          = 160
      139            VIRTUAL-HEIGHT     = 40.33
      140            VIRTUAL-WIDTH      = 160
      141            RESIZE             = yes
      142            SCROLL-BARS        = no
      143            STATUS-AREA        = no
      144            BGCOLOR            = ?
      145            FGCOLOR            = ?
      146            KEEP-FRAME-Z-ORDER = yes
      147            THREE-D            = yes
      148            MESSAGE-AREA       = no
      149            SENSITIVE          = yes.
      150   ELSE C-Win = CURRENT-WINDOW.
      151   IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(C-Win)
      152   THEN C-Win:HIDDEN = yes.
      153   ON END-ERROR OF C-Win
      154   OR ENDKEY OF C-Win ANYWHERE DO:
      155     IF THIS-PROCEDURE:PERSISTENT THEN RETURN NO-APPLY.
      156   END.
      157   ON WINDOW-CLOSE OF C-Win
      158   DO:
      159     APPLY "CLOSE":U TO THIS-PROCEDURE.
      160     RETURN NO-APPLY.
      161   END.
      162   ASSIGN CURRENT-WINDOW                = C-Win
      163          THIS-PROCEDURE:CURRENT-WINDOW = C-Win.
      164   ON CLOSE OF THIS-PROCEDURE
      165      RUN disable_UI.
      166   PAUSE 0 BEFORE-HIDE.
      167   MAIN-BLOCK:
      168   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      169      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      170     define variable v-rid# as recid no-undo.
      171     define buffer buf_sys-ctrl for ub.sys-ctrl .
      172     find first buf_sys-ctrl no-lock .
      173     if buf_sys-ctrl.status_ = 'copy-DB':U then do:
      174       RUN enable_UI.
      175       assign
      176         p-is-copy = true
      177         g#news    = false
      178         g#auto    = false
      179         g#userid  = p-user-name
      180         g#passwd  = p-user-pswd
      181       .
      182       run adm/dbs.w (
      183                  input ?
      184                 ,input 'ÈÇÌÅÍÅÍÈÅ':U
      185                 ,output v-rid#
      186               ) no-error .
      187       if error-status :error then do:
      188         message
      189           vss-workfile vss-revision vss-description skip
      190           substitute( "" ) skip
      191           return-value skip
      192           error-status :get-message ( error-status :num-messages )
      193           view-as alert-box error
      194         .
      195       end.
      196     end.
      197     APPLY "CLOSE":U TO THIS-PROCEDURE.
      198   END.
      199   PROCEDURE disable_UI :
      200     IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(C-Win)
      201     THEN DELETE WIDGET C-Win.
      202     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
      203   END PROCEDURE.
      204   PROCEDURE enable_UI :
      205     VIEW FRAME DEFAULT-FRAME IN WINDOW C-Win.
      206     VIEW C-Win.
      207   END PROCEDURE.
