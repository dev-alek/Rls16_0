      628   procedure proc-alt-shift-f2:
      629     if not ibs.th.gbl.gbl-var:rcode
      630   then
      631     run gbl\inidebug.p .
      632   end.
      633   procedure proc-alt-shift-f3:
      634     run gbl/prvssinf.p
      635       ( input this-procedure
      636       ) .
      637   end.
      638   define variable v-inform-launched as logical no-undo initial false .
      639   procedure proc-alt-shift-f4:
      640     define variable v-action as character no-undo .
      641     if v-inform-launched = false then do:
      642       assign
      643         v-inform-launched = true
      644       .
      645       run gbl/d-inform.w
      646         (  input self
      647         ,  input this-procedure
      648         , output v-action
      649         ) no-error .
      650       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      651       assign
      652         v-inform-launched = false
      653       .
      654     end.
      655   end.
      656   procedure proc-alt-f1:
      657     run gbl/corrhelp.p
      658       (input this-procedure
      659       ) .
      660   end .
      661   on alt-shift-f2 anywhere do:
      662     run proc-alt-shift-f2.
      663   end.
      664   on alt-shift-f3 anywhere do:
      665     run proc-alt-shift-f3 in this-procedure .
      666   end.
      667   on alt-shift-f4 anywhere do:
      668     run proc-alt-shift-f4 in this-procedure.
      669   end.
      670   on alt-f1 anywhere do:
      671     run proc-alt-f1 in this-procedure .
      672   end.
      673   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      674     define variable v-cntxt-db-num        as integer   no-undo .
      675     define variable v-cntxt-userid        as character no-undo .
      676     define variable v-cntxt-level         as character no-undo .
      677     define variable v-cntxt-host-code-obj as integer   no-undo .
      678     define variable v-cntxt-obj-type      as character no-undo .
      679     define variable v-cntxt-obj-code      as integer   no-undo .
      680     define variable v-cntxt-db-num-obj    as integer   no-undo .
      681     define variable v-cntxt-is-admin      as logical   no-undo .
      682   DEFINE VARIABLE v-db-num LIKE ub.db.db-num NO-UNDO.
      683   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO.
      684   DEFINE VARIABLE v-to-create AS logical NO-UNDO.
      685   DEFINE VARIABLE v-host-code LIKE ub.shop.host-code NO-UNDO.
      686   DEFINE VARIABLE v-base-code LIKE ub.sysconf.base-code NO-UNDO.
      687   DEFINE VARIABLE dr-list AS CHARACTER NO-UNDO.
      688   DEFINE VARIABLE drgrouprank AS CHARACTER NO-UNDO.
      689   DEFINE VARIABLE drcprank AS CHARACTER NO-UNDO.
      690   DEFINE VARIABLE drdcrank AS CHARACTER NO-UNDO.
      691   DEFINE VARIABLE drgdsrank AS CHARACTER NO-UNDO.
      692   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      693   define variable v-tth as handle no-undo .
      694   assign
      695   v-tth = buffer thbjattr_thbj-attr:table-handle .
      696   DEFINE BUTTON B-add  NO-FOCUS
      697        LABEL "&Добавить"
      698        SIZE 10 BY 1.
      699   DEFINE BUTTON B-add-cpp  NO-FOCUS
      700        LABEL "&Добавить"
      701        SIZE 10 BY 1.
      702   DEFINE BUTTON B-chg-cp  NO-FOCUS
      703        LABEL "&Изменить"
      704        SIZE 10 BY 1.
      705   DEFINE BUTTON B-del
      706        LABEL "&Удалить"
      707        SIZE 10 BY 1.
      708   DEFINE BUTTON B-del-cpp
      709        LABEL "&Удалить"
      710        SIZE 10 BY 1.
      711   DEFINE BUTTON B-discnt
      712        LABEL "&Скидки"
      713        SIZE 10 BY 1.
      714   DEFINE BUTTON B-exit AUTO-GO
      715        LABEL "&Ввод"
      716        SIZE 10 BY 1
      717        BGCOLOR 8 .
      718   DEFINE BUTTON B-Help
      719        LABEL "Помо&щь"
      720        SIZE 10 BY 1
      721        BGCOLOR 8 .
      722   DEFINE BUTTON b-quit AUTO-END-KEY
      723        LABEL "&Отмена"
      724        SIZE 10 BY 1
      725        BGCOLOR 8 .
      726   DEFINE QUERY BR-cash-pay FOR
      727         tt-cash-pay-mar SCROLLING.
      728   DEFINE QUERY BR-cash-payp FOR
      729         tt-cash-pay-mar-pet SCROLLING.
      730   DEFINE QUERY BR-tax-rate-code FOR
      731         tt-tax-rate-code SCROLLING.
      732   DEFINE BROWSE BR-cash-pay
      733     QUERY BR-cash-pay NO-LOCK DISPLAY
      734         tt-cash-pay-mar.cdpay-code-mar COLUMN-LABEL "Код оплаты!на кассе" FORMAT ">>>>9":U
      735   tt-cash-pay-mar.obj-name-mar COLUMN-LABEL "Описание" FORMAT "X(10)":U
      736   tt-cash-pay-mar.cdpay-code COLUMN-LABEL "Тип кассового!платежа (в BO)" FORMAT ">>>9":U
      737   tt-cash-pay-mar.curr-code COLUMN-LABEL "Код!валюты" FORMAT ">>9":U
      738   tt-cash-pay-mar.obj-name COLUMN-LABEL "Название типа кассового платежа" FORMAT "X(40)":U
      739       WIDTH 40
      740       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 6
      741            TITLE "Соответствие кодов оплат ТОВАРОВ НА КАССЕ типам кассовых платежей в BO" EXPANDABLE.
      742   DEFINE BROWSE BR-cash-payp
      743     QUERY BR-cash-payp NO-LOCK DISPLAY
      744         tt-cash-pay-mar-pet.cdpay-code-mar-pet COLUMN-LABEL "Код оплаты!на кассе" FORMAT "9":U
      745   tt-cash-pay-mar-pet.emitent COLUMN-LABEL "Код!эмитента" FORMAT ">9":U
      746   tt-cash-pay-mar-pet.obj-name-mar COLUMN-LABEL "Описание" FORMAT "X(25)":U
      747   tt-cash-pay-mar-pet.cdpay-code COLUMN-LABEL "Тип кассового!платежа (в BO)" FORMAT ">>>9":U
      748   tt-cash-pay-mar-pet.curr-code COLUMN-LABEL "Код!валюты" FORMAT ">>9":U
      749   tt-cash-pay-mar-pet.obj-name COLUMN-LABEL "Название типа кассового платежа" FORMAT "X(40)":U
      750       WIDTH 50
      751       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 6.42
      752            TITLE "Соответствие кодов оплат ТОПЛИВА НА КАССЕ типам кассовых платежей в BO" ROW-HEIGHT-CHARS .67 EXPANDABLE.
      753   DEFINE BROWSE BR-tax-rate-code
      754     QUERY BR-tax-rate-code NO-LOCK DISPLAY
      755         tt-tax-rate-code.rate-code COLUMN-LABEL "Код!ставки" FORMAT ">>9":U
      756   bo-tax-code COLUMN-LABEL "Код налога" FORMAT ">9":U WIDTH 16.75
      757   tt-tax-rate-code.rate-name COLUMN-LABEL "Название ставки" FORMAT "X(40)":U
      758   tt-tax-rate-code.tax-code COLUMN-LABEL "Схема налогооблож!на кассе" FORMAT "9":U
      759       WIDTH 8
      760   ENABLE
      761   tt-tax-rate-code.tax-code
      762       WITH NO-ROW-MARKERS SEPARATORS SIZE 86 BY 5.5
      763            TITLE "Соответствие ставок налогов категориям налога на кассе" EXPANDABLE.
      764   DEFINE FRAME Dialog-Frame
      765        B-exit AT ROW 1 COL 1
      766        b-quit AT ROW 1 COL 11
      767        B-discnt AT ROW 1 COL 31
      768        B-Help AT ROW 1 COL 54.88
      769        B-del AT ROW 2 COL 11
      770        BR-tax-rate-code AT ROW 3 COL 1
      771        BR-cash-pay AT ROW 9.5 COL 1
      772        B-del-cpp AT ROW 15.5 COL 11
      773        B-add-cpp AT ROW 15.5 COL 1
      774        BR-cash-payp AT ROW 16.5 COL 1
      775        B-chg-cp AT ROW 8.5 COL 1
      776        B-add AT ROW 2 COL 1
      777        "(Для платежей через MAGIC достаточно задать префиксы карт в атрибутах платежа)" VIEW-AS TEXT
      778             SIZE 77.5 BY 1 AT ROW 15.5 COL 21
      779             FGCOLOR 4
      780        SPACE(0.74) SKIP(6.42)
      781       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      782            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      783            TITLE "Параметры кассы Maria"
      784            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      785   ASSIGN
      786          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      787          FRAME Dialog-Frame:HIDDEN           = TRUE.
      788   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      789   DO:
      790     APPLY "END-ERROR":U TO SELF.
      791   END.
      792   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      793   DO:
      794     DEFINE VARIABLE v-value AS CHARACTER NO-UNDO.
      795     DEFINE VARIABLE v-log AS logical NO-UNDO.
      796     DEFINE VARIABLE v-tax-rid AS RECID NO-UNDO.
      797     DEFINE VARIABLE v-tax-rate-rid AS RECID NO-UNDO.
      798     DEFINE BUFFER buf_tax FOR ub.tax.
      799     DEFINE BUFFER buf_tax-rate FOR ub.tax-rate.
      800     FIND FIRST buf_tax NO-LOCK WHERE
      801               buf_tax.tax-code = INTEGER('1':U).
      802     run ref/tax-tree.w (
      803         input parparentproc
      804         ,INPUT "b-seltax-rate"
      805         ,INPUT "ALL-TAX-RATES"
      806         ,INPUT 0
      807         ,INPUT p-obj-type
      808         ,INPUT p-obj-code
      809         ,INPUT RECID(buf_tax)
      810         ,INPUT-OUTPUT v-tax-rate-rid
      811         ) NO-ERROR.
      812   IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      813   IF v-tax-rate-rid <> ? THEN DO:
      814       FIND FIRST buf_tax-rate NO-LOCK WHERE
      815             recid(buf_tax-rate) = v-tax-rate-rid.
      816      FIND FIRST tt-tax-rate-code NO-LOCK WHERE
      817                 tt-tax-rate-code.rate-code = buf_tax-rate.rate-code NO-ERROR.
      818       IF AVAILABLE tt-tax-rate-code THEN DO:
      819           MESSAGE
      820           "Вы уже выбрали ставку налога с кодом ставки" tt-tax-rate-code.rate-code
      821           VIEW-AS ALERT-BOX.
      822           RETURN NO-APPLY.
      823      END.
      824      IF buf_tax-rate.STATUS_ = 'удал':U  THEN DO:
      825           MESSAGE
      826           "Нельзя выбрать ставку налога в статусе УДАЛЕН"
      827           VIEW-AS ALERT-BOX.
      828           RETURN NO-APPLY.
      829      END.
      830      CREATE tt-tax-rate-code.
      831      BUFFER-COPY buf_tax-rate
      832      TO tt-tax-rate-code
      833      ASSIGN
      834      tt-tax-rate-code.bo-tax-code = buf_tax-rate.tax-code
      835      tt-tax-rate-code.tax-code = 0
      836      v-tax-rate-rid = RECID(tt-tax-rate-code)
      837      .
      838      run openbr IN THIS-PROCEDURE.
      839      REPOSITION br-tax-rate-code TO RECID v-tax-rate-rid.
      840   END.
      841   END.
      842   ON CHOOSE OF B-add-cpp IN FRAME Dialog-Frame
      843   DO:
      844     DEFINE VARIABLE v-value AS CHARACTER NO-UNDO.
      845     DEFINE VARIABLE v-log AS logical NO-UNDO.
      846     DEFINE variable v-rid AS RECID NO-UNDO.
      847     DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      848     DEFINE VARIABLE v-type AS CHARACTER NO-UNDO.
      849     DEFINE VARIABLE v-emitent AS integer NO-UNDO.
      850     DEFINE BUFFER buf_tt-cash-pay-mar-pet FOR tt-cash-pay-mar-pet.
      851     DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
      852     run gbl/d-list.w (
      853                 INPUT "b-sel":U
      854                 ,INPUT "Выберите типы оплаты на кассе"
      855                 ,INPUT "1,2,3,4-5"
      856                 ,INPUT "Наличные,Дебетовая ведомость и Дебетные талоны(карты),Кредитная ведомость или Кредитные талоны(карты),Платежные карты"
      857                 ,INPUT chr(44)
      858                 ,INPUT "":U
      859                 ,output v-type).
      860   IF v-type = "":u THEN do:
      861     RETURN no-apply.
      862   end.
      863   if v-type = "4-5" then v-type = "4".
      864     run ref/cashpays.w (
      865                  input parparentproc
      866                 ,input  "b-sel":U
      867                 ,input 'все':U
      868                 ,input (if p-obj-type = 'орг':U then p-obj-code else v-host-code)
      869                 ,input (if p-obj-type = 'орг':U then '':U else p-obj-type)
      870                 ,input (if p-obj-type = 'орг':U then 0 else p-obj-code)
      871                 ,OUTPUT v-rid-list) NO-ERROR.
      872   IF ERROR-STATUS:ERROR OR v-rid-list = "":U  THEN RETURN no-apply.
      873   FIND FIRST buf_cash-pay NO-LOCK WHERE
      874           RECID(buf_cash-pay) = INTEGER(ENTRY(1, v-rid-list)) NO-ERROR.
      875   IF NOT AVAILABLE buf_cash-pay  THEN RETURN NO-APPLY.
      876   if v-type <> "1" then do:
      877       run gbl/d-prompt.w (
      878         'title=':u + "Введите идентификатор эмитента НА КАССЕ" + '\':u
      879       + 'text1=':u + "0 для ВЕДОМОСТИ" + '\':u
      880       + 'text2=':u + "1-20 для КАРТ НП-ТАЛОНОВ" + '\':u
      881       + 'format=' + ">9" + '\':u
      882       + 'type=' + 'I':U + '\':u
      883       + 'fillin_row=4\':u
      884       + 'fillin_col=4\':u
      885       + 'fillin_width=7\':u
      886       + 'fillin_height=1\':u
      887       + 'max-chars=5\':u
      888       + 'readonly=no\':u
      889       , input-output v-value
      890       ).
      891       if return-value = 'false':u then return NO-apply.
      892      IF INTEGER(v-value) > 20 OR
      893      integer(v-value) < 0 THEN DO:
      894          MESSAGE
      895          "Значение идентификатора эмитента может быть только числом от 0 до 20"
      896          VIEW-AS ALERT-BOX ERROR.
      897          RETURN NO-APPLY.
      898      END.
      899   end.
      900   else do:
      901     v-value = "0".
      902   end.
      903      v-emitent = INTEGER(v-value).
      904      FIND FIRST buf_tt-cash-pay-mar-pet WHERE
      905                buf_tt-cash-pay-mar-pet.cdpay-code-mar-pet = INTEGER(v-type)
      906            AND buf_tt-cash-pay-mar-pet.emitent = v-emitent NO-ERROR.
      907      IF AVAILABLE buf_tt-cash-pay-mar-pet THEN DO:
      908          MESSAGE
      909          SUBSTITUTE("Уже есть КОД ОПЛАТЫ ТОПЛИВА НА КАССЕ типа &1 с эмитентом &2"
      910                     ,buf_tt-cash-pay-mar-pet.obj-name-mar
      911                     ,v-emitent)
      912          VIEW-AS ALERT-BOX ERROR.
      913          RETURN NO-APPLY.
      914      END.
      915      CREATE tt-cash-pay-mar-pet.
      916      BUFFER-COPY buf_cash-pay
      917      TO tt-cash-pay-mar-pet
      918      ASSIGN
      919      tt-cash-pay-mar-pet.cdpay-code-mar-pet = INTEGER(v-type)
      920      tt-cash-pay-mar-pet.emitent = v-emitent
      921      tt-cash-pay-mar-pet.obj-name-mar = IF tt-cash-pay-mar-pet.emitent = 0
      922                                         THEN ENTRY(tt-cash-pay-mar-pet.cdpay-code-mar-pet, 'Наличные,Дебетовая ведомость,Кредитная ведомость,Платежные карты')
      923                                         ELSE ENTRY(tt-cash-pay-mar-pet.cdpay-code-mar-pet, 'Наличные,Дебетовые карты(талоны),Кредитные карты(талоны),Платежные карты')
      924      v-rid = RECID(tt-cash-pay-mar-pet)
      925      .
      926      run openbr-cpp IN THIS-PROCEDURE.
      927      REPOSITION br-cash-payp TO RECID v-rid.
      928   END.
      929   ON CHOOSE OF B-chg-cp IN FRAME Dialog-Frame
      930   DO:
      931     DEFINE VARIABLE v-value AS CHARACTER NO-UNDO.
      932     DEFINE VARIABLE v-log AS logical NO-UNDO.
      933     DEFINE variable v-rid AS RECID NO-UNDO.
      934     DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      935     define variable glog as logical no-undo .
      936     DEFINE BUFFER buf_tt-cash-pay-mar FOR tt-cash-pay-mar.
      937     DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
      938     IF NOT AVAILABLE tt-cash-pay-mar  THEN DO:
      939        MESSAGE
      940        "Выберите КОД ОПЛАТЫ ТОВАРА НА КАССE, для которого Вы хотите изменить соответствие"
      941        VIEW-AS ALERT-BOX .
      942        RETURN NO-APPLY.
      943     END.
      944     run ref/cashpays.w (
      945                  input parparentproc
      946                 ,input  "b-sel":U
      947                 ,input 'все':U
      948                 ,input (if p-obj-type = 'орг':U then p-obj-code else v-host-code)
      949                 ,input (if p-obj-type = 'орг':U then '':U else p-obj-type)
      950                 ,input (if p-obj-type = 'орг':U then 0 else p-obj-code)
      951                 ,OUTPUT v-rid-list) NO-ERROR.
      952   IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      953   if v-rid-list = "":U  THEN do:
      954     MESSAGE
      955     substitute("Вы действительно хотите удалить соответствие между КОДОМ ОПЛАТЫ ТОВАРА &1 &2&3" +
      956                "и типом кассового платежа &4"
      957                , tt-cash-pay-mar.cdpay-code-mar
      958                , tt-cash-pay-mar.obj-name-mar
      959                , chr(10)
      960                , tt-cash-pay-mar.obj-name
      961                ) VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
      962     IF NOT glog THEN RETURN NO-APPLY.
      963     FIND FIRST buf_tt-cash-pay-mar WHERE recid(buf_tt-cash-pay-mar) = RECID(tt-cash-pay-mar).
      964     ASSIGN
      965     buf_tt-cash-pay-mar.cdpay-code = 0
      966     buf_tt-cash-pay-mar.curr-code = 0
      967     buf_tt-cash-pay-mar.obj-name = ''
      968     v-rid = RECID(tt-cash-pay-mar)
      969     .
      970     br-cash-pay:REFRESH().
      971   END.
      972   ELSE DO:
      973       FIND FIRST buf_cash-pay NO-LOCK WHERE
      974               RECID(buf_cash-pay) = INTEGER(ENTRY(1, v-rid-list)) NO-ERROR.
      975      IF NOT AVAILABLE buf_cash-pay THEN RETURN NO-APPLY.
      976      BUFFER-COPY buf_cash-pay TO tt-cash-pay-mar
      977      ASSIGN
      978      v-rid = RECID(tt-cash-pay-mar)
      979      .
      980      run openbr-cp IN THIS-PROCEDURE.
      981      REPOSITION br-cash-pay TO RECID v-rid.
      982   END.
      983   END.
      984   ON CHOOSE OF B-del IN FRAME Dialog-Frame
      985   DO:
      986     IF NOT AVAILABLE tt-tax-rate-code THEN RETURN NO-APPLY.
      987     DELETE tt-tax-rate-code.
      988     run openbr IN THIS-PROCEDURE.
      989     REPOSITION br-tax-rate-code TO ROW 1.
      990   END.
      991   ON CHOOSE OF B-del-cpp IN FRAME Dialog-Frame
      992   DO:
      993     IF NOT AVAILABLE tt-cash-pay-mar-pet THEN RETURN NO-APPLY.
      994     DELETE tt-cash-pay-mar-pet.
      995     run openbr-cpp IN THIS-PROCEDURE.
      996     REPOSITION br-cash-payp TO ROW 1.
      997   END.
      998   ON CHOOSE OF B-discnt IN FRAME Dialog-Frame
      999   DO:
     1000     run adm/shatt19d.w (
     1001                     INPUT parparentproc
     1002                    ,INPUT p-mode
     1003                    ,input p-obj-type
     1004                    ,input p-obj-code
     1005                    ,INPUT-OUTPUT dr-list
     1006                    ,INPUT-OUTPUT drgrouprank
     1007                    ,INPUT-OUTPUT drcprank
     1008                    ,INPUT-OUTPUT drdcrank
     1009                    ,INPUT-OUTPUT drgdsrank).
     1010   END.
     1011   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1012   DO:
     1013     run proc-save IN THIS-PROCEDURE NO-ERROR.
     1014     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1015   END.
     1016   ON LEAVE OF tt-cash-pay-mar.cdpay-code-mar IN BROWSE br-cash-pay DO:
     1017   DEFINE VARIABLE old-cdpay-code-mar AS INTEGER NO-UNDO.
     1018    DEFINE BUFFER buf_tt-cash-pay-mar FOR tt-cash-pay-mar.
     1019   ASSIGN
     1020   old-cdpay-code-mar = tt-cash-pay-mar.cdpay-code-mar.
     1021    FIND FIRST buf_tt-cash-pay-mar NO-LOCK WHERE
     1022              buf_tt-cash-pay-mar.cdpay-code = INPUT BROWSE br-cash-pay tt-cash-pay-mar.cdpay-code-mar
     1023          AND recid(buf_tt-cash-pay-mar) <> recid(tt-cash-pay-mar) NO-ERROR.
     1024    IF AVAILABLE buf_tt-cash-pay-mar  THEN DO:
     1025        MESSAGE
     1026        "Уже задано соответствие для КОДА ОПЛАТЫ НА КАССЕ" INPUT BROWSE br-cash-pay tt-cash-pay-mar.cdpay-code-mar
     1027        VIEW-AS ALERT-BOX ERROR.
     1028        ASSIGN
     1029        tt-cash-pay-mar.cdpay-code-mar = old-cdpay-code-mar.
     1030        DISPLAY
     1031        tt-cash-pay-mar.cdpay-code-mar
     1032        WITH BROWSE br-cash-pay.
     1033        RETURN NO-APPLY.
     1034    END.
     1035    ASSIGN
     1036    tt-cash-pay-mar.cdpay-code-mar = INPUT BROWSE br-cash-pay tt-cash-pay-mar.cdpay-code-mar
     1037    .
     1038   END.
     1039   ON LEAVE OF tt-cash-pay-mar-pet.cdpay-code-mar-pet IN BROWSE br-cash-payp,
     1040               tt-cash-pay-mar-pet.emitent IN BROWSE br-cash-payp DO:
     1041   DEFINE VARIABLE old-cdpay-code-mar-pet AS INTEGER NO-UNDO.
     1042   DEFINE VARIABLE old-emitent AS INTEGER NO-UNDO.
     1043    DEFINE BUFFER buf_tt-cash-pay-mar-pet FOR tt-cash-pay-mar-pet.
     1044   ASSIGN
     1045   old-cdpay-code-mar-pet = tt-cash-pay-mar-pet.cdpay-code-mar-pet
     1046   old-emitent =     tt-cash-pay-mar-pet.emitent
     1047       .
     1048    FIND FIRST buf_tt-cash-pay-mar-pet NO-LOCK WHERE
     1049              buf_tt-cash-pay-mar-pet.cdpay-code-mar-pet = INPUT BROWSE br-cash-payp tt-cash-pay-mar-pet.cdpay-code-mar-pet
     1050          AND buf_tt-cash-pay-mar-pet.emitent = INPUT BROWSE br-cash-payp tt-cash-pay-mar-pet.emitent
     1051          AND recid(buf_tt-cash-pay-mar-pet) <> recid(tt-cash-pay-mar) NO-ERROR.
     1052    IF AVAILABLE buf_tt-cash-pay-mar-pet  THEN DO:
     1053        MESSAGE
     1054        substitute("Уже задано соответствие для КОДА ОПЛАТЫ НА КАССЕ &1 для ЭМИТЕНТА &2"
     1055                   , (INPUT BROWSE br-cash-payp tt-cash-pay-mar-pet.cdpay-code-mar)
     1056                   ,  (INPUT BROWSE br-cash-payp tt-cash-pay-mar-pet.emitent))
     1057        VIEW-AS ALERT-BOX ERROR.
     1058        ASSIGN
     1059        tt-cash-pay-mar-pet.cdpay-code-mar = old-cdpay-code-mar-pet
     1060        tt-cash-pay-mar-pet.emitent = old-emitent
     1061        .
     1062        DISPLAY
     1063        tt-cash-pay-mar-pet.cdpay-code-mar-pet
     1064        tt-cash-pay-mar-pet.emitent
     1065        WITH BROWSE br-cash-payp.
     1066        RETURN NO-APPLY.
     1067    END.
     1068    ASSIGN
     1069    tt-cash-pay-mar-pet.cdpay-code-mar-pet = INPUT BROWSE br-cash-payp tt-cash-pay-mar-pet.cdpay-code-mar-pet
     1070    tt-cash-pay-mar-pet.emitent = INPUT BROWSE br-cash-payp tt-cash-pay-mar-pet.emitent
     1071    .
     1072   END.
     1073   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1074   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1075   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1076   on help of frame Dialog-Frame
     1077   do:
     1078     run gbl/app_help.p
     1079       (input this-procedure :file-name
     1080       ,input ''
     1081       ,input ?
     1082       ) no-error.
     1083     if error-status :error then do:
     1084       message
     1085         "Ошибка при вызове помощи"
     1086         error-status :get-message(1)
     1087         view-as alert-box .
     1088     end.
     1089   end.
     1090   run minbtn-set in this-procedure .
     1091   on choose of b-help in frame Dialog-Frame
     1092   do:
     1093     apply "help":u to frame Dialog-Frame .
     1094   end.
     1095   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1096   procedure minbtn-set :
     1097       do
     1098           on error undo, return error return-value
     1099           :
     1100           define variable ii              as integer       no-undo .
     1101           define variable fh              as widget-handle no-undo .
     1102           define variable hh              as widget-handle no-undo .
     1103           define variable v-h             as handle        extent 4 no-undo .
     1104           define variable v-name-button   as character     no-undo .
     1105           define variable v-help-old-x    as decimal       no-undo .
     1106           define variable v-help-old-y    as decimal       no-undo .
     1107           define variable v-help-old-size as decimal       no-undo .
     1108           define variable v-frame-width   as decimal       no-undo .
     1109           define variable jj              as integer       no-undo .
     1110           do
     1111               on error undo, return error
     1112               :
     1113               assign
     1114                   v-frame-width = frame Dialog-Frame:width - 0.3
     1115                   fh            = frame Dialog-Frame:first-child
     1116                   hh            = fh:first-child
     1117                   ii            = 1
     1118                   .
     1119               do while valid-handle(hh):
     1120                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1121                   do:
     1122                       case lc(hh:name) :
     1123                           when "b-help" then
     1124                               do:
     1125                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1126                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1127                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1128                                   hh:TOOLTIP = "Помощь" .
     1129                                   v-help-old-x = hh:column .
     1130                                   v-help-old-y = hh:row    .
     1131                                   v-help-old-size = hh:width .
     1132                                   hh:width-chars = 2.5 .
     1133                               end.
     1134                           when "b-print" then
     1135                               do:
     1136                                   hh:load-image("cmp/b-print.bmp":u) .
     1137                                   hh:TOOLTIP = "Печать" .
     1138                                   v-h[ii] = hh:handle .
     1139                                   ii = ii + 1 .
     1140                                   hh:width-chars = 3 .
     1141                               end.
     1142                           when "b-history" or
     1143                           when "b-hist" then
     1144                               do:
     1145                                   hh:load-image("cmp/b-hist.bmp":u) .
     1146                                   hh:TOOLTIP = "История" .
     1147                                   v-h[ii] = hh:handle .
     1148                                   ii = ii + 1 .
     1149                                   hh:width-chars = 3 .
     1150                               end.
     1151                           when "b-sch" then
     1152                               do:
     1153                                   hh:load-image("cmp/b-sch.bmp":u) .
     1154                                   hh:TOOLTIP = "Установка Фильтра" .
     1155                                   v-h[ii] = hh:handle .
     1156                                   ii = ii + 1 .
     1157                                   hh:width-chars = 3 .
     1158                               end.
     1159                           when "b-hist-user" then
     1160                               do:
     1161                                   hh:load-image("cmp/b-hist.bmp":u) .
     1162                                   hh:TOOLTIP = "История пользователя" .
     1163                                   ii = ii + 1 .
     1164                               end.
     1165                       end case.
     1166                   end.
     1167                   hh = hh:next-sibling.
     1168               end.
     1169               b-help:column = v-frame-width - b-help:width-chars.
     1170               jj = 0.
     1171               repeat ii = 4 to 1 by -1 :
     1172                   if valid-handle (v-h[ii] ) then
     1173                   do:
     1174                       jj  = jj + 1 .
     1175                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1176                       v-h[ii]:row    = v-help-old-y .
     1177                   end.
     1178               end.
     1179           end.
     1180       end.
     1181   end procedure.
     1182   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1183   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1184   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1185   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1186   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1187   define variable v-diasize-current-frame-height as decimal   no-undo .
     1188   define variable v-diasize-change-size          as logical   no-undo .
     1189   define variable v-diasize-resize-button        as handle    no-undo .
     1190   define variable v-diasize-wndmax               as logical   no-undo .
     1191   define variable v-diasize-wndstore             as logical   no-undo .
     1192   define variable v-diasize-proc-name            as character no-undo .
     1193   define variable v-diasize-browse-handle        as handle    no-undo .
     1194   define variable v-diasize-browse-number        as integer   no-undo .
     1195   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1196   define temp-table temp-diasize-handle no-undo
     1197     field handle-value  as handle
     1198     field save-position as decimal
     1199     index xpk is primary unique handle-value
     1200     .
     1201   define temp-table temp-browse-handle no-undo
     1202     field browse-type   as character
     1203     field browse-number as integer
     1204     field browse-handle as handle
     1205     field original-size as decimal
     1206     index xpk is primary unique browse-type browse-number
     1207     index xie browse-type browse-handle
     1208   .
     1209   procedure diasize_change-height :
     1210     define input  parameter p-change-value  as decimal   no-undo .
     1211     define input  parameter p-move-resize   as logical   no-undo .
     1212     define variable v-field-group-handle    as handle    no-undo .
     1213     define variable v-object-handle         as handle    no-undo .
     1214     define variable v-frame-height          as decimal   no-undo .
     1215     define variable v-frame-virtual-height  as decimal   no-undo .
     1216     define variable v-browse-height         as decimal   no-undo .
     1217     define variable v-window-height         as decimal   no-undo .
     1218     define variable v-window-virtual-height as decimal   no-undo .
     1219     define variable v-change-sign           as integer   no-undo .
     1220     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1221     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1222     if p-change-value > 0
     1223     then do:
     1224       if frame Dialog-Frame :height + p-change-value
     1225           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1226       then do:
     1227         assign
     1228           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1229                           - (frame Dialog-Frame :height-chars)
     1230         .
     1231         if p-change-value <= 0
     1232         then do:
     1233           run diasize_position-resize-button in this-procedure .
     1234           return .
     1235         end.
     1236       end.
     1237     end.
     1238     if p-change-value < 0
     1239     then do:
     1240       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1241       then do:
     1242         assign
     1243           p-change-value = v-diasize-orig-frame-height
     1244                          - (frame Dialog-Frame :height-chars)
     1245         .
     1246         if p-change-value >= 0
     1247         then do:
     1248           run diasize_position-resize-button in this-procedure .
     1249           return .
     1250         end.
     1251       end.
     1252     end.
     1253     if p-change-value >= 0
     1254     then do:
     1255       assign
     1256         v-change-sign = 1
     1257       .
     1258     end.
     1259     else do:
     1260       assign
     1261         v-change-sign = -1
     1262       .
     1263     end.
     1264     assign
     1265       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1266     .
     1267     if p-change-value = 0
     1268     then do:
     1269       run diasize_position-resize-button in this-procedure .
     1270       return .
     1271     end.
     1272     move_block:
     1273     do
     1274     on error undo move_block, retry move_block
     1275     :
     1276       if retry
     1277       then do:
     1278         do
     1279         on error undo move_block, leave move_block
     1280         :
     1281           if p-change-value > 0
     1282           then do:
     1283             for each buf_temp-diasize-handle
     1284             on error undo, next
     1285             :
     1286               assign
     1287                 v-object-handle = buf_temp-diasize-handle.handle-value
     1288               .
     1289               if v-object-handle <> v-diasize-resize-button
     1290               then do:
     1291                 assign
     1292                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1293                 .
     1294               end.
     1295             end.
     1296             assign
     1297               v-diasize-browse-handle :height = v-browse-height
     1298             .
     1299             for each buf_temp-browse-handle
     1300               where buf_temp-browse-handle.browse-type = 'height':u
     1301             on error undo, next
     1302             :
     1303               assign
     1304                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1305               .
     1306             end.
     1307             assign
     1308               frame Dialog-Frame :height = v-frame-height
     1309             .
     1310             if frame Dialog-Frame :scrollable = true
     1311             then do:
     1312               assign
     1313                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1314               .
     1315             end.
     1316             run diasize_position-resize-button in this-procedure .
     1317           end.
     1318           else do:
     1319             if frame Dialog-Frame :scrollable = true
     1320             then do:
     1321               assign
     1322                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1323               .
     1324             end.
     1325             assign
     1326               frame Dialog-Frame :height = v-frame-height
     1327             .
     1328             assign
     1329               v-diasize-browse-handle :height = v-browse-height
     1330             .
     1331             for each buf_temp-browse-handle
     1332               where buf_temp-browse-handle.browse-type = 'height':u
     1333             on error undo, next
     1334             :
     1335               assign
     1336                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1337               .
     1338             end.
     1339             for each buf_temp-diasize-handle
     1340             on error undo, next
     1341             :
     1342               assign
     1343                 v-object-handle = buf_temp-diasize-handle.handle-value
     1344               .
     1345               if v-object-handle <> v-diasize-resize-button
     1346               then do:
     1347                 assign
     1348                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1349                 .
     1350               end.
     1351             end.
     1352             run diasize_position-resize-button in this-procedure .
     1353           end.
     1354           assign
     1355             v-diasize-change-size = false
     1356           .
     1357           leave move_block .
     1358         end.
     1359       end.
     1360       assign
     1361         v-diasize-need-full-display = true
     1362       .
     1363       if v-diasize-change-size = false
     1364       then do:
     1365         assign
     1366           v-diasize-change-size = true
     1367         .
     1368       end.
     1369       else do:
     1370         return .
     1371       end.
     1372       assign
     1373         v-frame-height = frame Dialog-Frame :height
     1374         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1375         v-browse-height = v-diasize-browse-handle :height
     1376       .
     1377       for each buf_temp-browse-handle
     1378         where buf_temp-browse-handle.browse-type = 'height':u
     1379       :
     1380         assign
     1381           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1382         .
     1383       end.
     1384       for each buf_temp-diasize-handle
     1385       :
     1386         delete buf_temp-diasize-handle .
     1387       end.
     1388       assign
     1389         v-field-group-handle = frame Dialog-Frame :first-child
     1390       .
     1391       do while valid-handle(v-field-group-handle)
     1392       :
     1393         assign
     1394           v-object-handle = v-field-group-handle :first-child
     1395         .
     1396         do while valid-handle(v-object-handle)
     1397         :
     1398           if  v-object-handle <> v-diasize-browse-handle :handle
     1399           and can-query(v-object-handle, "row")
     1400           and can-query(v-object-handle, "height")
     1401           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1402           then do:
     1403             find first buf_temp-browse-handle
     1404               where buf_temp-browse-handle.browse-type   = 'height':u
     1405                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1406               no-error .
     1407             if available buf_temp-browse-handle
     1408             then do:
     1409             end.
     1410             else do:
     1411               create buf_temp-diasize-handle .
     1412               assign
     1413                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1414                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1415               .
     1416             end.
     1417           end.
     1418           assign
     1419             v-object-handle = v-object-handle :next-sibling
     1420           .
     1421         end.
     1422         assign
     1423           v-field-group-handle = v-field-group-handle :next-sibling
     1424         .
     1425       end.
     1426       do with frame Dialog-Frame
     1427       :
     1428         hide v-diasize-resize-button .
     1429         assign
     1430           v-diasize-resize-button :row    = 1
     1431           v-diasize-resize-button :column = 1
     1432         .
     1433       end.
     1434       if p-change-value > 0
     1435       then do:
     1436         if frame Dialog-Frame :scrollable = true
     1437         then do:
     1438           assign
     1439             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1440             no-error .
     1441           if error-status :error
     1442           or error-status :get-message(1) <> ""
     1443           then do:
     1444             undo move_block, retry move_block .
     1445           end.
     1446         end.
     1447         assign
     1448           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1449           no-error .
     1450         if error-status :error
     1451         or error-status :get-message(1) <> ""
     1452         then do:
     1453           undo move_block, retry move_block .
     1454         end.
     1455         assign
     1456           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1457           no-error .
     1458         if error-status :error
     1459         or error-status :get-message(1) <> ""
     1460         then do:
     1461           undo move_block, retry move_block .
     1462         end.
     1463         for each buf_temp-browse-handle
     1464           where buf_temp-browse-handle.browse-type = 'height':u
     1465         on error undo move_block, retry move_block
     1466         :
     1467           assign
     1468             buf_temp-browse-handle.browse-handle :height
     1469               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1470             no-error .
     1471           if error-status :error
     1472           or error-status :get-message(1) <> ""
     1473           then do:
     1474             undo move_block, retry move_block .
     1475           end.
     1476         end.
     1477         for each buf_temp-diasize-handle
     1478         on error undo move_block, retry move_block
     1479         :
     1480           assign
     1481             v-object-handle = buf_temp-diasize-handle.handle-value
     1482           .
     1483           if v-object-handle <> v-diasize-resize-button
     1484           then do:
     1485             assign
     1486               v-object-handle :row = v-object-handle :row + p-change-value
     1487               no-error .
     1488             if error-status :error
     1489             or error-status :get-message(1) <> ""
     1490             then do:
     1491               undo move_block, retry move_block .
     1492             end.
     1493           end.
     1494         end.
     1495       end.
     1496       else do:
     1497         for each buf_temp-diasize-handle
     1498         on error undo move_block, retry move_block
     1499         :
     1500           assign
     1501             v-object-handle = buf_temp-diasize-handle.handle-value
     1502           .
     1503           if v-object-handle <> v-diasize-resize-button
     1504           then do:
     1505             assign
     1506               v-object-handle :row = v-object-handle :row + p-change-value
     1507               no-error .
     1508             if error-status :error
     1509             or error-status :get-message(1) <> ""
     1510             then do:
     1511               undo move_block, retry move_block .
     1512             end.
     1513           end.
     1514         end.
     1515         assign
     1516           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1517           no-error .
     1518         if error-status :error
     1519         or error-status :get-message(1) <> ""
     1520         then do:
     1521           undo move_block, retry move_block .
     1522         end.
     1523         for each buf_temp-browse-handle
     1524           where buf_temp-browse-handle.browse-type = 'height':u
     1525         on error undo move_block, retry move_block
     1526         :
     1527           assign
     1528             buf_temp-browse-handle.browse-handle :height
     1529               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1530             no-error .
     1531           if error-status :error
     1532           or error-status :get-message(1) <> ""
     1533           then do:
     1534             undo move_block, retry move_block .
     1535           end.
     1536         end.
     1537         assign
     1538           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1539           no-error .
     1540         if error-status :error
     1541         or error-status :get-message(1) <> ""
     1542         then do:
     1543           undo move_block, retry move_block .
     1544         end.
     1545         if frame Dialog-Frame :scrollable = true
     1546         then do:
     1547           assign
     1548             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1549             no-error .
     1550           if error-status :error
     1551           or error-status :get-message(1) <> ""
     1552           then do:
     1553             undo move_block, retry move_block .
     1554           end.
     1555         end.
     1556       end.
     1557       if p-move-resize = true
     1558       then do:
     1559         run diasize_position-resize-button in this-procedure .
     1560       end.
     1561       if v-diasize-wndstore = true
     1562       then do:
     1563         if connected("ub") = true
     1564         then do:
     1565           define variable v-cntxt-db-num        as integer   no-undo .
     1566           define variable v-cntxt-userid        as character no-undo .
     1567           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1568                                             , OUTPUT v-cntxt-userid
     1569                                             ) .
     1570           run gbl/wndsizew.p
     1571             (input  v-cntxt-db-num
     1572             ,input  v-cntxt-userid
     1573             ,input  v-diasize-proc-name
     1574             ,input  'height':u
     1575             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1576             ) .
     1577         end.
     1578       end.
     1579     end.
     1580     assign
     1581       v-diasize-change-size = false
     1582     .
     1583   end procedure.
     1584   procedure diasize_set-height :
     1585     define input  parameter p-new-height  as decimal   no-undo .
     1586     define input  parameter p-move-resize as logical   no-undo .
     1587     do
     1588     on error undo, return error return-value
     1589     :
     1590       run diasize_change-height in this-procedure
     1591         (input  (p-new-height - frame Dialog-Frame :height)
     1592         ,input  p-move-resize
     1593         ) .
     1594     end.
     1595   end procedure.
     1596   procedure diasize_change-width :
     1597     define input  parameter p-change-value as decimal   no-undo .
     1598     define input  parameter p-move-resize  as logical   no-undo .
     1599     define variable v-field-group-handle   as handle    no-undo .
     1600     define variable v-object-handle        as handle    no-undo .
     1601     define variable v-frame-width          as decimal   no-undo .
     1602     define variable v-frame-virtual-width  as decimal   no-undo .
     1603     define variable v-browse-width         as decimal   no-undo .
     1604     define variable v-window-width         as decimal   no-undo .
     1605     define variable v-window-virtual-width as decimal   no-undo .
     1606     define variable v-change-sign          as integer   no-undo .
     1607     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1608     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1609     if p-change-value > 0
     1610     then do:
     1611       if frame Dialog-Frame :width + p-change-value >
     1612           session :width-chars
     1613       then do:
     1614         assign
     1615           p-change-value = session :width-chars - frame Dialog-Frame :width
     1616         .
     1617         if p-change-value <= 0
     1618         then do:
     1619           run diasize_position-resize-button in this-procedure .
     1620           return .
     1621         end.
     1622       end.
     1623     end.
     1624     if p-change-value < 0
     1625     then do:
     1626       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1627       then do:
     1628         assign
     1629           p-change-value = v-diasize-orig-frame-width
     1630                          - frame Dialog-Frame :width
     1631         .
     1632         if p-change-value >= 0
     1633         then do:
     1634           run diasize_position-resize-button in this-procedure .
     1635           return .
     1636         end.
     1637       end.
     1638     end.
     1639     if p-change-value >= 0
     1640     then do:
     1641       assign
     1642         v-change-sign = 1
     1643       .
     1644     end.
     1645     else do:
     1646       assign
     1647         v-change-sign = -1
     1648       .
     1649     end.
     1650     assign
     1651       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1652     .
     1653     if p-change-value = 0
     1654     then do:
     1655       run diasize_position-resize-button in this-procedure .
     1656       return .
     1657     end.
     1658     move_block:
     1659     do
     1660     on error undo move_block, leave move_block
     1661     :
     1662       if retry
     1663       then do:
     1664         do
     1665         on error undo move_block, leave move_block
     1666         :
     1667           if p-change-value > 0
     1668           then do:
     1669             for each buf_temp-diasize-handle
     1670             on error undo, next
     1671             :
     1672               assign
     1673                 v-object-handle = buf_temp-diasize-handle.handle-value
     1674               .
     1675               if v-object-handle <> v-diasize-resize-button
     1676               then do:
     1677                 assign
     1678                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1679                 .
     1680               end.
     1681             end.
     1682             assign
     1683               v-diasize-browse-handle :width = v-browse-width
     1684             .
     1685             for each buf_temp-browse-handle
     1686               where buf_temp-browse-handle.browse-type = 'width':u
     1687             on error undo, next
     1688             :
     1689               assign
     1690                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1691               .
     1692             end.
     1693             assign
     1694               frame Dialog-Frame :width = v-frame-width
     1695             .
     1696             if frame Dialog-Frame :scrollable = true
     1697             then do:
     1698               assign
     1699                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1700               .
     1701             end.
     1702             run diasize_position-resize-button in this-procedure .
     1703           end.
     1704           else do:
     1705             if frame Dialog-Frame :scrollable = true
     1706             then do:
     1707               assign
     1708                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1709               .
     1710             end.
     1711             assign
     1712               frame Dialog-Frame :width = v-frame-width
     1713             .
     1714             for each buf_temp-browse-handle
     1715               where buf_temp-browse-handle.browse-type = 'width':u
     1716             on error undo, next
     1717             :
     1718               assign
     1719                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1720               .
     1721             end.
     1722             assign
     1723               v-diasize-browse-handle :width = v-browse-width
     1724             .
     1725             for each buf_temp-diasize-handle
     1726             on error undo, next
     1727             :
     1728               assign
     1729                 v-object-handle = buf_temp-diasize-handle.handle-value
     1730               .
     1731               if v-object-handle <> v-diasize-resize-button
     1732               then do:
     1733                 assign
     1734                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1735                 .
     1736               end.
     1737             end.
     1738             run diasize_position-resize-button in this-procedure .
     1739           end.
     1740           assign
     1741             v-diasize-change-size = false
     1742           .
     1743           leave move_block .
     1744         end.
     1745       end.
     1746       assign
     1747         v-diasize-need-full-display = true
     1748       .
     1749       if v-diasize-change-size = false
     1750       then do:
     1751         assign
     1752           v-diasize-change-size = true
     1753         .
     1754       end.
     1755       else do:
     1756         return .
     1757       end.
     1758       assign
     1759         v-frame-width = frame Dialog-Frame :width
     1760         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1761         v-browse-width = v-diasize-browse-handle :width
     1762       .
     1763       for each buf_temp-browse-handle
     1764         where buf_temp-browse-handle.browse-type = 'width':u
     1765       :
     1766         assign
     1767           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1768         .
     1769       end.
     1770       for each buf_temp-diasize-handle
     1771       :
     1772         delete buf_temp-diasize-handle .
     1773       end.
     1774       assign
     1775         v-field-group-handle = frame Dialog-Frame :first-child
     1776       .
     1777       do while valid-handle(v-field-group-handle)
     1778       :
     1779         assign
     1780           v-object-handle = v-field-group-handle :first-child
     1781         .
     1782         do while valid-handle(v-object-handle)
     1783         :
     1784           if  v-object-handle <> v-diasize-browse-handle :handle
     1785           and v-object-handle <> v-diasize-resize-button
     1786           and can-query(v-object-handle, "row")
     1787           and can-query(v-object-handle, "height")
     1788           and ( v-object-handle :col + v-object-handle :width
     1789                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1790               )
     1791           then do:
     1792             find first buf_temp-browse-handle
     1793               where buf_temp-browse-handle.browse-type   = 'width':u
     1794                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1795               no-error .
     1796             if available buf_temp-browse-handle
     1797             then do:
     1798             end.
     1799             else do:
     1800               create buf_temp-diasize-handle .
     1801               assign
     1802                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1803                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1804               .
     1805             end.
     1806           end.
     1807           assign
     1808             v-object-handle = v-object-handle :next-sibling
     1809           .
     1810         end.
     1811         assign
     1812           v-field-group-handle = v-field-group-handle :next-sibling
     1813         .
     1814       end.
     1815       do with frame Dialog-Frame
     1816       :
     1817         hide v-diasize-resize-button .
     1818         v-diasize-resize-button :row = 1.
     1819         v-diasize-resize-button :column = 1.
     1820       end.
     1821       if p-change-value > 0
     1822       then do:
     1823         if frame Dialog-Frame :scrollable = true
     1824         then do:
     1825           assign
     1826             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1827             no-error .
     1828           if error-status :error
     1829           or error-status :get-message(1) <> ""
     1830           then do:
     1831             undo move_block, retry move_block.
     1832           end.
     1833         end.
     1834         assign
     1835           frame Dialog-Frame :width = v-frame-width + p-change-value
     1836           no-error .
     1837         if error-status :error
     1838         or error-status :get-message(1) <> ""
     1839         then do:
     1840           undo move_block, retry move_block.
     1841         end.
     1842         assign
     1843           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1844         no-error .
     1845         if error-status :error
     1846         or error-status :get-message(1) <> ""
     1847         then do:
     1848           undo move_block, retry move_block.
     1849         end.
     1850         for each buf_temp-browse-handle
     1851           where buf_temp-browse-handle.browse-type = 'width':u
     1852         on error undo move_block, retry move_block
     1853         :
     1854           assign
     1855             buf_temp-browse-handle.browse-handle :width
     1856               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1857             no-error .
     1858           if error-status :error
     1859           or error-status :get-message(1) <> ""
     1860           then do:
     1861             undo move_block, retry move_block .
     1862           end.
     1863         end.
     1864         for each buf_temp-diasize-handle
     1865         on error undo move_block, retry move_block
     1866         :
     1867           assign
     1868             v-object-handle = buf_temp-diasize-handle.handle-value
     1869           .
     1870           if v-object-handle <> v-diasize-resize-button
     1871           then do:
     1872             assign
     1873               v-object-handle :col = v-object-handle :col + p-change-value
     1874               no-error .
     1875             if error-status :error
     1876             or error-status :get-message(1) <> ""
     1877             then do:
     1878               undo move_block, retry move_block .
     1879             end.
     1880           end.
     1881         end.
     1882       end.
     1883       else do:
     1884         for each buf_temp-diasize-handle
     1885         on error undo move_block, retry move_block
     1886         :
     1887           assign
     1888             v-object-handle = buf_temp-diasize-handle.handle-value
     1889           .
     1890           if v-object-handle <> v-diasize-resize-button
     1891           then do:
     1892             assign
     1893               v-object-handle :col = v-object-handle :col + p-change-value
     1894               no-error .
     1895             if error-status :error
     1896             or error-status :get-message(1) <> ""
     1897             then do:
     1898               undo move_block, retry move_block .
     1899             end.
     1900           end.
     1901         end.
     1902         for each buf_temp-browse-handle
     1903           where buf_temp-browse-handle.browse-type = 'width':u
     1904         on error undo move_block, retry move_block
     1905         :
     1906           assign
     1907             buf_temp-browse-handle.browse-handle :width
     1908               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1909             no-error .
     1910           if error-status :error
     1911           or error-status :get-message(1) <> ""
     1912           then do:
     1913             undo move_block, retry move_block .
     1914           end.
     1915         end.
     1916         assign
     1917           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1918           no-error .
     1919         if error-status :error
     1920         or error-status :get-message(1) <> ""
     1921         then do:
     1922           undo move_block, retry move_block.
     1923         end.
     1924         assign
     1925           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1926         no-error .
     1927         if error-status :error
     1928         or error-status :get-message(1) <> ""
     1929         then do:
     1930           undo move_block, retry move_block.
     1931         end.
     1932         if frame Dialog-Frame :scrollable = true
     1933         then do:
     1934           assign
     1935             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1936           no-error .
     1937           if error-status :error
     1938           or error-status :get-message(1) <> ""
     1939           then do:
     1940             undo move_block, retry move_block.
     1941           end.
     1942         end.
     1943       end.
     1944       if p-move-resize
     1945       then do:
     1946         run diasize_position-resize-button in this-procedure .
     1947       end.
     1948       if v-diasize-wndstore = true
     1949       then do:
     1950         if connected("ub") = true
     1951         then do:
     1952           define variable v-cntxt-db-num        as integer   no-undo .
     1953           define variable v-cntxt-userid        as character no-undo .
     1954           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1955                                             , OUTPUT v-cntxt-userid
     1956                                             ) .
     1957           run gbl/wndsizew.p
     1958             (input  v-cntxt-db-num
     1959             ,input  v-cntxt-userid
     1960             ,input  v-diasize-proc-name
     1961             ,input  'width':u
     1962             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1963             ) .
     1964         end.
     1965       end.
     1966     end.
     1967     assign
     1968       v-diasize-change-size = false
     1969     .
     1970   end procedure.
     1971   procedure diasize_set-width :
     1972     define input  parameter p-new-width  as decimal   no-undo .
     1973     define input  parameter p-move-resize as logical   no-undo .
     1974     do
     1975     on error undo, return error return-value
     1976     :
     1977       run diasize_change-width in this-procedure
     1978         (input  (p-new-width - frame Dialog-Frame :width)
     1979         ,input  p-move-resize
     1980         ) .
     1981     end.
     1982   end procedure.
     1983   procedure diasize_position-resize-button :
     1984     do with frame Dialog-Frame
     1985     :
     1986       hide v-diasize-resize-button .
     1987       assign
     1988         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1989                     - 1
     1990                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1991         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1992                     - 1
     1993                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1994       .
     1995       view v-diasize-resize-button .
     1996     end.
     1997   end procedure.
     1998   on alt-right anywhere
     1999   do:
     2000     run diasize_change-width in this-procedure
     2001       (input 1
     2002       ,input true
     2003       ) .
     2004     return no-apply .
     2005   end.
     2006   on alt-left anywhere
     2007   do:
     2008     run diasize_change-width in this-procedure
     2009       (input -1
     2010       ,input true
     2011       ) .
     2012     return no-apply .
     2013   end.
     2014   on alt-down anywhere
     2015   do:
     2016     run diasize_change-height in this-procedure
     2017       (input 1
     2018       ,input true
     2019       ) .
     2020     return no-apply .
     2021   end.
     2022   on alt-up anywhere
     2023   do:
     2024     run diasize_change-height in this-procedure
     2025       (input -1
     2026       ,input true
     2027       ) .
     2028     return no-apply .
     2029   end.
     2030   on alt-enter of frame Dialog-Frame
     2031   do:
     2032     run diasize_maximize in this-procedure
     2033       (input  ?
     2034       ).
     2035     return no-apply .
     2036   end.
     2037   procedure diasize_end-move :
     2038     do
     2039     on error undo, return error return-value
     2040     :
     2041       define variable v-row-delta as decimal   no-undo .
     2042       define variable v-col-delta as decimal   no-undo .
     2043       define variable v-new-row as decimal   no-undo .
     2044       define variable v-new-col as decimal   no-undo .
     2045       assign
     2046         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2047         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2048       .
     2049       assign
     2050         v-row-delta = v-new-row - frame Dialog-Frame :height
     2051         v-col-delta = v-new-col - frame Dialog-Frame :width
     2052       .
     2053       run diasize_change-height in this-procedure
     2054         (input v-row-delta
     2055         ,input true
     2056         ) .
     2057       run diasize_change-width in this-procedure
     2058         (input v-col-delta
     2059         ,input true
     2060         ) .
     2061     end.
     2062   end procedure.
     2063   procedure diasize_maximize :
     2064     define input  parameter p-action as logical   no-undo .
     2065     do
     2066     on error undo, return error return-value
     2067     :
     2068       if p-action = ?
     2069       then do:
     2070         if v-diasize-need-maximize = true
     2071         then do:
     2072           assign
     2073             p-action = true
     2074           .
     2075         end.
     2076         else do:
     2077           assign
     2078             p-action = false
     2079           .
     2080         end.
     2081       end.
     2082       if p-action = true
     2083       then do:
     2084         run diasize_change-height in this-procedure
     2085           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2086               - frame Dialog-Frame :height-chars
     2087           ,input true
     2088           ) .
     2089         run diasize_change-width in this-procedure
     2090           (input session :width-chars
     2091               - frame Dialog-Frame :width-chars
     2092           ,input true
     2093           ) .
     2094         assign
     2095           v-diasize-need-maximize = false
     2096         .
     2097       end.
     2098       else do:
     2099         run diasize_change-width in this-procedure
     2100           (input v-diasize-orig-frame-width
     2101               - frame Dialog-Frame :width-chars
     2102           ,input true
     2103           ) .
     2104         run diasize_change-height in this-procedure
     2105           (input v-diasize-orig-frame-height
     2106               - frame Dialog-Frame :height-chars
     2107           ,input true
     2108           ) .
     2109         assign
     2110           v-diasize-need-maximize = true
     2111         .
     2112       end.
     2113     end.
     2114   end procedure.
     2115   procedure diasize_restore-orig-size :
     2116     do
     2117     on error undo, return error return-value
     2118     :
     2119       assign
     2120         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2121         v-diasize-current-frame-height = frame Dialog-Frame :height
     2122       .
     2123       run diasize_set-height in this-procedure
     2124         (input  v-diasize-orig-frame-height
     2125         ,input  true
     2126         ) .
     2127       run diasize_set-width in this-procedure
     2128         (input  v-diasize-orig-frame-width
     2129         ,input  true
     2130         ) .
     2131     end.
     2132   end procedure.
     2133   procedure diasize_restore-current-size :
     2134     do
     2135     on error undo, return error return-value
     2136     :
     2137       run diasize_set-height in this-procedure
     2138         (input  v-diasize-current-frame-height
     2139         ,input  true
     2140         ) .
     2141       run diasize_set-width in this-procedure
     2142         (input  v-diasize-current-frame-width
     2143         ,input  true
     2144         ) .
     2145     end.
     2146   end procedure.
     2147   procedure diasize_set-browse-handle :
     2148     define input  parameter p-browse-handle as handle   no-undo .
     2149     define buffer buf_temp-browse-handle for temp-browse-handle .
     2150     do
     2151     on error undo, return error return-value
     2152     :
     2153       assign
     2154         v-diasize-browse-handle = p-browse-handle
     2155       .
     2156       for each buf_temp-browse-handle
     2157       on error undo, return error return-value
     2158       :
     2159         delete buf_temp-browse-handle .
     2160       end.
     2161     end.
     2162   end procedure.
     2163   procedure diasize_add_browse :
     2164     define input  parameter p-browse-type   as character no-undo .
     2165     define input  parameter p-browse-handle as handle    no-undo .
     2166     define buffer buf_temp-browse-handle for temp-browse-handle .
     2167     do
     2168     on error undo, return error return-value
     2169     :
     2170       assign
     2171         v-diasize-browse-number = v-diasize-browse-number + 1
     2172       .
     2173       create buf_temp-browse-handle .
     2174       assign
     2175         buf_temp-browse-handle.browse-type   = p-browse-type
     2176         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2177         buf_temp-browse-handle.browse-handle = p-browse-handle
     2178       .
     2179     end.
     2180   end procedure.
     2181   procedure diasize_init :
     2182     define variable v-default-value    as logical   no-undo .
     2183     define variable v-restore-saved    as logical   no-undo .
     2184     define variable v-resize-value-str as character no-undo .
     2185     do
     2186     on error undo, return error return-value
     2187     :
     2188       do with frame Dialog-Frame
     2189       :
     2190         assign
     2191           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2192           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2193           v-diasize-browse-handle     = browse BR-cash-pay :handle
     2194         .
     2195         create button v-diasize-resize-button
     2196         assign
     2197           parent        = frame Dialog-Frame :first-child
     2198           label         = "s"
     2199           height-pixels = 16
     2200           width-pixels  = 16
     2201           visible       = true
     2202           sensitive     = true
     2203           movable       = true
     2204           triggers:
     2205             on end-move persistent run diasize_end-move in this-procedure .
     2206           end triggers.
     2207         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2208         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2209         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2210         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2211         assign
     2212           v-diasize-wndmax = false
     2213         .
     2214         if connected("ub") = true
     2215         then do:
     2216           define variable v-cntxt-db-num        as integer   no-undo .
     2217           define variable v-cntxt-userid        as character no-undo .
     2218           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2219                                             , OUTPUT v-cntxt-userid
     2220                                             ) .
     2221           run gbl/wndpar_r.p
     2222             (input  v-cntxt-db-num
     2223             ,input  v-cntxt-userid
     2224             ,input  'wndmax':U
     2225             ,output v-diasize-wndmax
     2226             ,output v-default-value
     2227             ) .
     2228         end.
     2229         assign
     2230           v-diasize-wndstore = false
     2231         .
     2232         if connected("ub") = true
     2233         then do:
     2234           run gbl/wndpar_r.p
     2235             (input  v-cntxt-db-num
     2236             ,input  v-cntxt-userid
     2237             ,input  'wndstore':U
     2238             ,output v-diasize-wndstore
     2239             ,output v-default-value
     2240             ) .
     2241         end.
     2242         assign
     2243           v-diasize-proc-name = entry(1, program-name(2), '.')
     2244         .
     2245         if v-diasize-wndstore = true
     2246         then do:
     2247           assign
     2248             v-restore-saved = false
     2249           .
     2250           if connected("ub") = true
     2251           then do:
     2252             run gbl/wndsizer.p
     2253               (input  v-cntxt-db-num
     2254               ,input  v-cntxt-userid
     2255               ,input  v-diasize-proc-name
     2256               ,input  'height':u
     2257               ,output v-resize-value-str
     2258               ) .
     2259             if v-resize-value-str <> '':U
     2260             then do:
     2261               run diasize_change-height in this-procedure
     2262                 (input  integer(v-resize-value-str)
     2263                 ,input  true
     2264                 ) .
     2265               assign
     2266                 v-restore-saved = true
     2267               .
     2268             end.
     2269           end.
     2270           if connected("ub") = true
     2271           then do:
     2272             run gbl/wndsizer.p
     2273               (input  v-cntxt-db-num
     2274               ,input  v-cntxt-userid
     2275               ,input  v-diasize-proc-name
     2276               ,input  'width':u
     2277               ,output v-resize-value-str
     2278               ) .
     2279             if v-resize-value-str <> '':U
     2280             then do:
     2281               run diasize_change-width in this-procedure
     2282                 (input  integer(v-resize-value-str)
     2283                 ,input  true
     2284                 ) .
     2285               assign
     2286                 v-restore-saved = true
     2287               .
     2288             end.
     2289           end.
     2290           if v-restore-saved <> true
     2291           then do:
     2292             if v-diasize-wndmax = true
     2293             then do:
     2294               run diasize_maximize in this-procedure
     2295                 (input  true
     2296                 ) .
     2297             end.
     2298           end.
     2299         end.
     2300         else do:
     2301           if v-diasize-wndmax = true
     2302           then do:
     2303             run diasize_maximize in this-procedure
     2304               (input  true
     2305               ) .
     2306           end.
     2307         end.
     2308       end.
     2309     end.
     2310   end procedure.
     2311   procedure diasize_need-full-display :
     2312     define output parameter p-need-full-display as logical   no-undo .
     2313     do
     2314     on error undo, return error return-value
     2315     :
     2316       assign
     2317         p-need-full-display = v-diasize-need-full-display
     2318       .
     2319       assign
     2320         v-diasize-need-full-display = false
     2321       .
     2322     end.
     2323   end procedure.
     2324   procedure get-context :
     2325      define output parameter p-db-num as integer          no-undo.
     2326      define output parameter p-user-id as character        no-undo.
     2327      define variable v-login               as character    no-undo.
     2328      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2329      define buffer buf_user-login  for ub.user-login .
     2330      do
     2331      on error undo, return error
     2332      :
     2333            FIND FIRST buf_sys-ctrl no-lock.
     2334            ASSIGN
     2335               v-login = USERID("ub")
     2336               p-db-num = buf_sys-ctrl.db-num
     2337            .
     2338            FIND FIRST buf_user-login
     2339                 WHERE buf_user-login.db-num = p-db-num
     2340                   AND buf_user-login.user-login = v-login
     2341                 no-lock
     2342                 no-error
     2343                 .
     2344            IF AVAILABLE buf_user-login
     2345            THEN DO:
     2346               assign
     2347                  p-user-id = buf_user-login.user-id
     2348               .
     2349            END.
     2350      end.
     2351   end procedure.
     2352       run diasize_init in this-procedure .
     2353   MAIN-BLOCK:
     2354   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2355      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2356   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2357     run mainmenu_getcntxt in parparentproc
     2358       (output v-cntxt-db-num
     2359       ,output v-cntxt-userid
     2360       ,output v-cntxt-level
     2361       ,output v-cntxt-host-code-obj
     2362       ,output v-cntxt-obj-type
     2363       ,output v-cntxt-obj-code
     2364       ,output v-cntxt-db-num-obj
     2365       ,output v-cntxt-is-admin
     2366       ) .
     2367   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2368   ON TAB ANYWHERE
     2369   DO:
     2370   define variable ii as integer no-undo .
     2371   define variable fh as widget-handle no-undo .
     2372   define variable hh as widget-handle no-undo .
     2373   define variable v-next-widget-name as character no-undo .
     2374   if v-tab-order <> '' then do:
     2375     if self:type = "TOGGLE-BOX" then
     2376     self:BGCOLOR = ?.
     2377     assign
     2378     ii = lookup(self:name, v-tab-order).
     2379     assign
     2380     ii = ii + 1
     2381     v-next-widget-name = entry(ii, v-tab-order)
     2382     no-error .
     2383     if error-status:error then do:
     2384       assign
     2385       ii = 1
     2386       v-next-widget-name = entry( ii, v-tab-order)
     2387       .
     2388     end.
     2389     assign
     2390     fh = frame Dialog-Frame:first-child
     2391     hh = fh:first-child
     2392     .
     2393     do while valid-handle(hh):
     2394       if hh:name = v-next-widget-name then do:
     2395         if hh:sensitive  = yes
     2396         AND hh:visible = yes then do:
     2397           if hh:type = "TOGGLE-BOX":U then do:
     2398             assign
     2399             hh:BGcolor = 1
     2400             .
     2401           end.
     2402           APPLY "ENTRY" to hh.
     2403           return no-apply.
     2404         end.
     2405         else do:
     2406           APPLY "TAB" to hh.
     2407           return no-apply.
     2408         end.
     2409       end.
     2410       hh = hh:next-sibling.
     2411     end.
     2412   end.
     2413   END.
     2414   ON BACK-TAB ANYWHERE
     2415   DO:
     2416   define variable ii as integer no-undo .
     2417   define variable fh as widget-handle no-undo .
     2418   define variable hh as widget-handle no-undo .
     2419   define variable v-next-widget-name as character no-undo .
     2420   if v-tab-order <> '' then do:
     2421     assign
     2422     ii = lookup(self:name, v-tab-order).
     2423     .
     2424     assign
     2425     ii = (if ii = 1
     2426           then  num-entries(v-tab-order)
     2427           else ii - 1
     2428           )
     2429     v-next-widget-name = entry(ii, v-tab-order)
     2430     .
     2431     assign
     2432     fh = frame Dialog-Frame:first-child
     2433     hh = fh:first-child
     2434     .
     2435     do while valid-handle(hh):
     2436       if hh:name = v-next-widget-name then do:
     2437         if hh:sensitive  = yes
     2438         AND hh:visible = yes then do:
     2439           if hh:type = "TOGGLE-BOX":U then do:
     2440             assign
     2441             hh:BGcolor = 1
     2442             .
     2443           end.
     2444           APPLY "ENTRY" to hh.
     2445           return no-apply.
     2446         end.
     2447         else do:
     2448         APPLY "BACK-TAB" to hh.
     2449         return no-apply.
     2450         end.
     2451       end.
     2452       hh = hh:next-sibling.
     2453     end.
     2454     end.
     2455   END.
     2456   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2457   ON RETURN ANYWHERE
     2458   DO:
     2459   define variable ii as integer no-undo .
     2460   define variable fh as widget-handle no-undo .
     2461   define variable hh as widget-handle no-undo .
     2462   define variable v-next-widget-name as character no-undo .
     2463     if v-tab-order <> '' then do:
     2464       assign
     2465       ii = lookup(self:name, v-tab-order).
     2466       if ii = num-entries(v-tab-order) then do:
     2467           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     2468           return no-apply.
     2469       end.
     2470       if self:type <> "BUTTON" and
     2471         self:type <> "EDITOR"  then do:
     2472         run proc-move-forward in this-procedure .
     2473         return no-apply.
     2474       end.
     2475       if self:type = "BUTTON" then do:
     2476         APPLY "CHOOSE" to self.
     2477       end.
     2478       if self:type = "TOGGLE-BOX" then
     2479       self:BGCOLOR = ?.
     2480       assign
     2481       ii = ii + 1
     2482       v-next-widget-name = entry(ii, v-tab-order)
     2483       no-error .
     2484       if error-status:error then do:
     2485         assign
     2486         ii = 1
     2487         v-next-widget-name = entry( ii, v-tab-order)
     2488         .
     2489       end.
     2490       assign
     2491       fh = frame Dialog-Frame:first-child
     2492       hh = fh:first-child
     2493       .
     2494       do while valid-handle(hh):
     2495         if hh:name = v-next-widget-name then do:
     2496           if hh:sensitive  = yes
     2497           AND hh:visible = yes then do:
     2498             if hh:type = "TOGGLE-BOX":U then do:
     2499               assign
     2500               hh:BGcolor = 1
     2501               .
     2502             end.
     2503             APPLY "ENTRY" to hh.
     2504             return no-apply.
     2505           end.
     2506           else do:
     2507             APPLY "TAB" to hh.
     2508             return no-apply.
     2509           end.
     2510         end.
     2511         hh = hh:next-sibling.
     2512       end.
     2513     end.
     2514   END.
     2515   procedure proc-move-forward :
     2516   define variable ii as integer no-undo .
     2517   define variable fh as widget-handle no-undo .
     2518   define variable hh as widget-handle no-undo .
     2519   define variable v-next-widget-name as character no-undo .
     2520   do
     2521   on error undo, return error
     2522   :
     2523     if v-tab-order <> '' then do:
     2524       if self:type = "TOGGLE-BOX" then
     2525       self:BGCOLOR = ?.
     2526       assign
     2527       ii = lookup(self:name, v-tab-order).
     2528       assign
     2529       ii = ii + 1
     2530       v-next-widget-name = entry(ii, v-tab-order)
     2531       no-error .
     2532       if error-status:error then do:
     2533         assign
     2534         ii = 1
     2535         v-next-widget-name = entry( ii, v-tab-order)
     2536         .
     2537       end.
     2538       assign
     2539       fh = frame Dialog-Frame:first-child
     2540       hh = fh:first-child
     2541       .
     2542       do while valid-handle(hh):
     2543         if hh:name = v-next-widget-name then do:
     2544           if hh:sensitive  = yes
     2545           AND hh:visible = yes then do:
     2546             if hh:type = "TOGGLE-BOX":U then do:
     2547               assign
     2548               hh:BGcolor = 1
     2549               .
     2550             end.
     2551             APPLY "ENTRY" to hh.
     2552             return.
     2553           end.
     2554           else do:
     2555             assign
     2556             ii = ii + 1
     2557             v-next-widget-name = entry(ii, v-tab-order)
     2558             no-error .
     2559             if error-status:error then do:
     2560               assign
     2561               ii = 1
     2562               v-next-widget-name = entry( ii, v-tab-order)
     2563               .
     2564             end.
     2565           end.
     2566         end.
     2567         hh = hh:next-sibling.
     2568       end.
     2569     end.
     2570   end.
     2571   end procedure.
     2572     IF p-mode <> 'ПРОСМОТР':U
     2573     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     2574         MESSAGE
     2575         vss-workfile vss-revision vss-description skip
     2576         "Неверное значение параметра p-mode" p-mode
     2577         VIEW-AS ALERT-BOX ERROR.
     2578         UNDO, RETURN ERROR.
     2579     END.
     2580     IF p-obj-type <> 'маг':U
     2581     and p-obj-type <> 'орг':U
     2582     and p-obj-type <> '':U
     2583     THEN DO:
     2584         MESSAGE
     2585         vss-workfile vss-revision vss-description skip
     2586         "Неверное значение параметра p-obj-type" p-obj-type
     2587         VIEW-AS ALERT-BOX ERROR.
     2588         UNDO, RETURN ERROR.
     2589     END.
     2590     if p-obj-type = 'маг':U then do:
     2591       FIND FIRST X_shop NO-LOCK WHERE X_shop.obj-code = p-obj-code NO-ERROR.
     2592       IF NOT AVAILABLE X_shop THEN DO:
     2593           MESSAGE
     2594           vss-workfile vss-revision vss-description skip
     2595           "Неверное значение параметра p-obj-code" p-obj-code
     2596           VIEW-AS ALERT-BOX ERROR.
     2597           UNDO, RETURN ERROR.
     2598       END.
     2599   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2600   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2601     (input  'маг':U
     2602     ,input  p-obj-code
     2603     ,output v-db-num
     2604     )  .
     2605       IF v-db-num <> v-cntxt-db-num AND v-cntxt-db-num <> 0 THEN DO:
     2606           MESSAGE
     2607           "Нельзя менять параметры магазина в чужой БД" skip
     2608           "магазин принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     2609           VIEW-AS ALERT-BOX ERROR.
     2610           UNDO, RETURN ERROR.
     2611       END.
     2612   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2613   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2614     (input  p-obj-type
     2615     ,input  p-obj-code
     2616     ,output v-host-code
     2617     )  .
     2618     end.
     2619     if p-obj-type = 'орг':U then do:
     2620       FIND FIRST X_sysconf NO-LOCK WHERE X_sysconf.host-code = p-obj-code NO-ERROR.
     2621       IF NOT AVAILABLE X_sysconf THEN DO:
     2622           MESSAGE
     2623           vss-workfile vss-revision vss-description skip
     2624           "Неверное значение параметра p-obj-code" p-obj-code
     2625           VIEW-AS ALERT-BOX ERROR.
     2626           UNDO, RETURN ERROR.
     2627       END.
     2628       if v-cntxt-db-num <> 0
     2629       and p-mode <> 'ПРОСМОТР':U
     2630       then do:
     2631           MESSAGE
     2632           "Нельзя менять параметры ФИРМЫ в УБД" skip
     2633           VIEW-AS ALERT-BOX ERROR.
     2634           UNDO, RETURN ERROR.
     2635       end.
     2636       v-host-code = p-obj-code.
     2637     end.
     2638     if p-obj-type = '':U then do:
     2639       if v-cntxt-db-num <> 0
     2640       and p-mode <> 'ПРОСМОТР':U
     2641       then do:
     2642           MESSAGE
     2643           "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" skip
     2644           VIEW-AS ALERT-BOX ERROR.
     2645           UNDO, RETURN ERROR.
     2646       end.
     2647     end.
     2648     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     2649       FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
     2650                 LOCKED_thbj-attr.obj-type = p-obj-type
     2651           AND   LOCKED_thbj-attr.obj-code = p-obj-code
     2652           AND   LOCKED_thbj-attr.upper-prop-code = 'cd-type-maria':U
     2653           AND   locked_thbj-attr.prop-code = '':U NO-WAIT NO-ERROR.
     2654        if locked locked_thbj-attr then do:
     2655           message
     2656           vss-workfile vss-revision vss-description skip
     2657            "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
     2658           view-as alert-box error .
     2659           undo, return error.
     2660         end.
     2661     END.
     2662     ELSE DO:
     2663         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
     2664             LOCKED_thbj-attr.obj-type = p-obj-type
     2665       AND   LOCKED_thbj-attr.obj-code = p-obj-code
     2666       AND   LOCKED_thbj-attr.upper-prop-code = 'cd-type-maria':U
     2667       AND   locked_thbj-attr.prop-code = "":u NO-ERROR.
     2668     END.
     2669     if not available locked_thbj-attr then do:
     2670       ASSIGN
     2671       v-to-create  = YES.
     2672       message
     2673       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     2674                   chr(10))
     2675       view-as alert-box WARNING.
     2676     end.
     2677     run FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     2678     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     2679     run Myenable in this-procedure .
     2680     WAIT-FOR GO OF FRAME Dialog-Frame.
     2681   END.
     2682   run disable_UI.
     2683   PROCEDURE disable_UI :
     2684     HIDE FRAME Dialog-Frame.
     2685   END PROCEDURE.
     2686   PROCEDURE enable_UI :
     2687     ENABLE B-exit b-quit B-discnt B-Help BR-tax-rate-code BR-cash-pay
     2688            BR-cash-payp
     2689         WITH FRAME Dialog-Frame.
     2690     VIEW FRAME Dialog-Frame.
     2691   END PROCEDURE.
     2692   PROCEDURE fill-widgets :
     2693   define variable v-value-character as character no-undo .
     2694   define variable v-value-date as date no-undo .
     2695   define variable v-value-decimal as decimal no-undo .
     2696   define variable v-value-integer as INTEGER no-undo .
     2697   define variable v-value-logical AS LOGICAL no-undo .
     2698   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     2699   DEFINE VARIABLE v-entry AS CHARACTER NO-UNDO.
     2700   DEFINE VARIABLE v-rate-code LIKE ub.tax-rate.rate-code NO-UNDO.
     2701   DEFINE VARIABLE v-cdtaxlst AS CHARACTER NO-UNDO.
     2702   DEFINE VARIABLE v-mariapayg AS CHARACTER NO-UNDO.
     2703   DEFINE VARIABLE v-mariapayp AS CHARACTER NO-UNDO.
     2704   DEFINE BUFFER buf_tax-rate FOR ub.tax-rate.
     2705   define variable v-param-type as character no-undo .
     2706   define variable v-param-value as character no-undo .
     2707   DEFINE VARIABLE v-cdpay-code LIKE ub.cash-pay.cdpay-code NO-UNDO.
     2708   DEFINE VARIABLE v-curr-code LIKE ub.cash-pay.curr-code NO-UNDO.
     2709   DEFINE VARIABLE v-cdpay-code-mar LIKE ub.cash-pay.cdpay-code NO-UNDO.
     2710   DEFINE VARIABLE v-cdpay-code-mar-pet LIKE ub.cash-pay.cdpay-code NO-UNDO.
     2711   DEFINE VARIABLE v-emitent AS INTEGER NO-UNDO.
     2712   DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
     2713   FOR EACH thbjattr_thbj-attr:
     2714     delete thbjattr_thbj-attr.
     2715   end.
     2716   FOR EACH temp-thbj-attr:
     2717     delete temp-thbj-attr.
     2718   end.
     2719   run adm/shattri.p (
     2720                 input "init":U
     2721               , input p-obj-type
     2722               , input p-obj-code
     2723               , input 'cd-type-maria':U
     2724               , input "":U
     2725               , output v-value-character
     2726               , output v-value-date
     2727               , output v-value-decimal
     2728               , output v-value-integer
     2729               , output v-value-logical
     2730               , output v-param-type
     2731               , INPUT-OUTPUT TABLE-handle v-tth
     2732               ) no-error .
     2733   if error-status:error
     2734   and not available locked_thbj-attr then do:
     2735     message
     2736     "Не удалось получить начальные значения настроек" skip
     2737     error-status:get-message(1) return-value
     2738     view-as alert-box error .
     2739     undo, return error .
     2740   end.
     2741   FOR EACH thbjattr_thbj-attr:
     2742     ASSIGN
     2743     v-entry = thbjattr_thbj-attr.prop-code.
     2744     IF v-entry = 'cdtaxlst':U THEN DO:
     2745       ASSIGN
     2746       v-cdtaxlst = thbjattr_thbj-attr.property-value-character
     2747       .
     2748     END.
     2749     IF v-entry = 'mariapayg':U THEN DO:
     2750       ASSIGN
     2751       v-mariapayg = thbjattr_thbj-attr.property-value-character.
     2752     END.
     2753     IF v-entry = 'mariapayp':U THEN DO:
     2754       ASSIGN
     2755       v-mariapayp = thbjattr_thbj-attr.property-value-character.
     2756     END.
     2757     IF v-entry = 'dr-list':U THEN DO:
     2758       ASSIGN
     2759       dr-list = thbjattr_thbj-attr.property-value-character.
     2760     END.
     2761     IF v-entry = 'drgrouprank':U THEN DO:
     2762       ASSIGN
     2763       drgrouprank = thbjattr_thbj-attr.property-value-character.
     2764     END.
     2765     IF v-entry = 'drgdsrank':U THEN DO:
     2766       ASSIGN
     2767       drgdsrank = thbjattr_thbj-attr.property-value-character.
     2768     END.
     2769     create temp-thbj-attr.
     2770     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     2771   END.
     2772   if v-cdtaxlst <> "":U then do:
     2773     _ii:
     2774     DO ii = 1 TO NUM-ENTRIES(v-cdtaxlst, ";"):
     2775       ASSIGN
     2776       v-rate-code = INTEGER (ENTRY(1, ENTRY(ii, v-cdtaxlst, ";":U), "-":U))
     2777       .
     2778       FIND FIRST buf_tax-rate NO-LOCK WHERE
     2779                     buf_tax-rate.rate-code = v-rate-code NO-ERROR.
     2780       IF NOT AVAILABLE buf_tax-rate THEN NEXT _ii.
     2781         CREATE tt-tax-rate-code.
     2782         BUFFER-COPY buf_tax-rate TO tt-tax-rate-code
     2783         ASSIGN
     2784         tt-tax-rate-code.tax-code = integer(ENTRY(2, ENTRY(ii, v-cdtaxlst, ";":U), "-":U))
     2785         tt-tax-rate-code.bo-tax-code = buf_tax-rate.tax-code
     2786         .
     2787     END.
     2788   end.
     2789   if v-mariapayg = '':u then do:
     2790     v-mariapayg = '1/1,0;2/0,0;3/0,0;4/0,0'.
     2791   end.
     2792   if v-mariapayg <> "":U then do:
     2793   _ii:
     2794   DO ii = 1 TO  NUM-ENTRIES(v-mariapayg, ";"):
     2795      ASSIGN
     2796      v-entry = entry(ii, v-mariapayg, ";":U)
     2797      v-cdpay-code-mar = integer(entry(1, entry(1, v-entry, chr(47)), chr(44)))
     2798      v-cdpay-code = integer(entry(1, entry(2, v-entry, chr(47)), chr(44)))
     2799      v-curr-code = integer(entry(2, entry(2, v-entry, chr(47)), chr(44)))
     2800      .
     2801      FIND FIRST buf_cash-pay NO-LOCK WHERE
     2802                   buf_cash-pay.cdpay-code = v-cdpay-code
     2803           AND buf_cash-pay.curr-code = v-curr-code  NO-ERROR.
     2804       CREATE tt-cash-pay-mar.
     2805       ASSIGN
     2806       tt-cash-pay-mar.cdpay-code-mar = v-cdpay-code-mar
     2807       tt-cash-pay-mar.cdpay-code = (IF AVAILABLE buf_cash-pay THEN buf_cash-pay.cdpay-code ELSE 0)
     2808       tt-cash-pay-mar.curr-code = (IF AVAILABLE buf_cash-pay THEN buf_cash-pay.curr-code ELSE 0)
     2809       tt-cash-pay-mar.obj-name = (IF AVAILABLE buf_cash-pay THEN buf_cash-pay.obj-name ELSE '':U)
     2810       tt-cash-pay-mar.obj-name-mar = entry(tt-cash-pay-mar.cdpay-code-mar, 'Наличные,Безнал 1,Безнал 2,Безнал 3')
     2811       .
     2812       RELEASE tt-cash-pay-mar.
     2813   END.
     2814   end.
     2815   if v-mariapayp <> "":U then do:
     2816   _ii:
     2817   DO ii = 1 TO  NUM-ENTRIES(v-mariapayp, ";"):
     2818      ASSIGN
     2819      v-entry = entry(ii, v-mariapayp, ";":U)
     2820      v-cdpay-code-mar-pet = integer(entry(1, entry(1, v-entry, chr(47)), chr(44)))
     2821      v-emitent = integer(entry(2, entry(1, v-entry, chr(47)), chr(44)))
     2822      v-cdpay-code = integer(entry(1, entry(2, v-entry, chr(47)), chr(44)))
     2823      v-curr-code = integer(entry(2, entry(2, v-entry, chr(47)), chr(44)))
     2824      .
     2825      FIND FIRST buf_cash-pay NO-LOCK WHERE
     2826                   buf_cash-pay.cdpay-code = v-cdpay-code
     2827           AND buf_cash-pay.curr-code = v-curr-code  NO-ERROR.
     2828      CREATE tt-cash-pay-mar-pet.
     2829      ASSIGN
     2830      tt-cash-pay-mar-pet.cdpay-code-mar-pet = v-cdpay-code-mar-pet
     2831      tt-cash-pay-mar-pet.emitent = v-emitent
     2832      tt-cash-pay-mar-pet.cdpay-code = (IF AVAILABLE buf_cash-pay THEN buf_cash-pay.cdpay-code ELSE 0)
     2833      tt-cash-pay-mar-pet.curr-code = (IF AVAILABLE buf_cash-pay THEN buf_cash-pay.curr-code ELSE 0)
     2834      tt-cash-pay-mar-pet.obj-name = (IF AVAILABLE buf_cash-pay THEN buf_cash-pay.obj-name ELSE '')
     2835      tt-cash-pay-mar-pet.obj-name-mar = (IF tt-cash-pay-mar-pet.emitent = 0
     2836                                          THEN entry(tt-cash-pay-mar-pet.cdpay-code-mar-pet, 'Наличные,Дебетовая ведомость,Кредитная ведомость,Платежные карты')
     2837                                          ELSE entry(tt-cash-pay-mar-pet.cdpay-code-mar-pet, 'Наличные,Дебетовые карты(талоны),Кредитные карты(талоны),Платежные карты'))
     2838      .
     2839      RELEASE tt-cash-pay-mar-pet.
     2840   END.
     2841   end.
     2842   END PROCEDURE.
     2843   PROCEDURE MyEnable :
     2844   ASSIGN
     2845   FRAME Dialog-Frame:TITLE = FRAME Dialog-Frame:TITLE + (if p-obj-type = 'орг':U then " фирма" else " маг") + STRING(p-obj-code)
     2846   v-tab-order = "b-exit,b-quit,b-discnt,b-help,b-add,b-del,br-tax-rate-code,b-chg-cp,br-cash-pay,b-add-cpp,b-del-cpp,br-cash-payp".
     2847   ENABLE
     2848   B-exit WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2849   b-quit
     2850   B-Help
     2851   br-tax-rate-code
     2852   br-cash-pay
     2853   br-cash-payp
     2854   b-add   WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2855   b-del   WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2856   b-chg-cp   WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2857   b-add-cpp   WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2858   b-del-cpp   WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2859   b-discnt
     2860   WITH FRAME Dialog-Frame.
     2861   VIEW FRAME Dialog-Frame.
     2862   IF p-mode = 'ПРОСМОТР':U THEN DO:
     2863       HIDE
     2864       b-exit
     2865       IN FRAME Dialog-Frame.
     2866       ASSIGN
     2867       b-quit:LABEL = "&Выход"
     2868       tt-tax-rate-code.tax-code:read-only  in browse br-tax-rate-code = yes
     2869       .
     2870   END.
     2871   ELSE DO:
     2872     ASSIGN
     2873     tt-tax-rate-code.tax-code:read-only  in browse br-tax-rate-code = NO
     2874     .
     2875   END.
     2876   run openbr IN THIS-PROCEDURE.
     2877   run openbr-cp IN THIS-PROCEDURE.
     2878   run openbr-cpp IN THIS-PROCEDURE.
     2879   END PROCEDURE.
     2880   PROCEDURE OpenBr :
     2881   OPEN QUERY br-tax-rate-code FOR EACH tt-tax-rate-code SHARE-LOCK.
     2882   END PROCEDURE.
     2883   PROCEDURE OpenBr-cp :
     2884   OPEN QUERY br-cash-pay FOR EACH tt-cash-pay-mar SHARE-LOCK.
     2885   END PROCEDURE.
     2886   PROCEDURE OpenBr-cpp :
     2887   OPEN QUERY br-cash-payp FOR EACH tt-cash-pay-mar-pet SHARE-LOCK.
     2888   END PROCEDURE.
     2889   PROCEDURE proc-save :
     2890   define variable v-value-character as character no-undo .
     2891   define variable v-value-date as date no-undo .
     2892   define variable v-value-decimal as decimal no-undo .
     2893   define variable v-value-integer as INTEGER no-undo .
     2894   define variable v-value-logical AS LOGICAL no-undo .
     2895   define variable ii as integer no-undo .
     2896   DEFINE VARIABLE v-cdtaxlst AS CHARACTER NO-UNDO.
     2897   DEFINE VARIABLE v-mariapayg AS CHARACTER NO-UNDO.
     2898   DEFINE VARIABLE v-mariapayp AS CHARACTER NO-UNDO.
     2899   DEFINE VARIABLE v-nal AS INTEGER NO-UNDO.
     2900   DEFINE VARIABLE v-2 AS INTEGER NO-UNDO.
     2901   DEFINE VARIABLE v-3 AS INTEGER NO-UNDO.
     2902   DEFINE VARIABLE v-4 AS INTEGER NO-UNDO.
     2903   DEFINE VARIABLE v-5 AS INTEGER NO-UNDO.
     2904   define variable v-same as logical no-undo .
     2905   define variable v-param-type as character no-undo .
     2906   DEFINE BUFFER buf_tt-tax-rate-code FOR tt-tax-rate-code.
     2907   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     2908   FIND FIRST buf_tt-tax-rate-code NO-LOCK WHERE
     2909             buf_tt-tax-rate-code.tax-code = 0 NO-ERROR.
     2910   IF AVAILABLE buf_tt-tax-rate-code THEN DO:
     2911       MESSAGE
     2912       "Вы не ввели категорию налога НА КАССЕ для ставки с кодом " buf_tt-tax-rate-code.rate-code
     2913       VIEW-AS ALERT-BOX ERROR.
     2914       RETURN ERROR.
     2915   END.
     2916   ASSIGN
     2917   v-cdtaxlst = "cdtaxlst=".
     2918   FOR EACH tt-tax-rate-code BY tt-tax-rate-code.rate-code:
     2919       IF tt-tax-rate-code.tax-code > 8 THEN DO:
     2920           MESSAGE
     2921           "Неверное значение СХЕМЫ НАЛООГБЛОЖЕНИЯ НАЛОГА НА КАССЕ" SKIP
     2922           "Разрешены в виде значений только 0, 1, 2, 3, 4, 5, 6, 8"
     2923           VIEW-AS ALERT-BOX ERROR.
     2924           UNDO, RETURN ERROR.
     2925       END.
     2926       ASSIGN
     2927       ii = ii + 1
     2928       v-cdtaxlst = v-cdtaxlst + (if ii = 1 then "":U else ";":U)  +
     2929                     STRING(tt-tax-rate-code.rate-code) + "-":U + STRING(tt-tax-rate-code.tax-code)
     2930       .
     2931   END.
     2932   ASSIGN
     2933   v-mariapayg = "mariapayg="
     2934   ii = 0    .
     2935   FOR EACH tt-cash-pay-mar BY tt-cash-pay-mar.cdpay-code-mar:
     2936       IF tt-cash-pay-mar.cdpay-code-mar < 1
     2937       OR tt-cash-pay-mar.cdpay-code-mar > 4 THEN DO:
     2938           MESSAGE
     2939           "Неверное значение КОДА ОПЛАТЫ ТОВАРОВ НА КАССЕ" SKIP
     2940           "Разрешены в виде значений только 1, 2, 3, 4"
     2941           VIEW-AS ALERT-BOX ERROR.
     2942           UNDO, RETURN ERROR.
     2943        END.
     2944       ASSIGN
     2945       ii = ii + 1
     2946       v-mariapayg = v-mariapayg  + (IF ii = 1 THEN '':U ELSE ';') +
     2947                     STRING(tt-cash-pay-mar.cdpay-code-mar) + chr(47) +
     2948                     STRING(tt-cash-pay-mar.cdpay-code) + chr(44) +
     2949                     STRING(tt-cash-pay-mar.curr-code)
     2950       .
     2951   END.
     2952   ASSIGN
     2953   v-mariapayp = "mariapayp="
     2954   ii = 0.
     2955   FOR EACH tt-cash-pay-mar-pet
     2956       BY tt-cash-pay-mar-pet.cdpay-code-mar-pet
     2957       BY tt-cash-pay-mar-pet.emitent:
     2958       IF tt-cash-pay-mar-pet.cdpay-code-mar < 1
     2959       OR tt-cash-pay-mar-pet.cdpay-code-mar > 5 THEN DO:
     2960           MESSAGE
     2961           "Неверное значение КОДА ОПЛАТЫ ТОПЛИВА НА КАССЕ" SKIP
     2962           "Разрешены в виде значений только 1, 2, 3, 4, 5"
     2963           VIEW-AS ALERT-BOX ERROR.
     2964           UNDO, RETURN ERROR.
     2965       END.
     2966       IF NOT (tt-cash-pay-mar-pet.emitent <= 20
     2967       or tt-cash-pay-mar-pet.cdpay-code-mar = 31) THEN DO:
     2968           MESSAGE
     2969           "Неверное значение КОДА ОПЛАТЫ ТОПЛИВА НА КАССЕ" SKIP
     2970           "Разрешены в виде значений только 0-20 или 31"
     2971           VIEW-AS ALERT-BOX ERROR.
     2972           UNDO, RETURN ERROR.
     2973      END.
     2974      IF tt-cash-pay-mar-pet.cdpay-code-mar-pet = 1 THEN DO:
     2975          ASSIGN
     2976          v-nal = v-nal + 1.
     2977          IF v-nal > 1 THEN DO:
     2978              MESSAGE
     2979              "Не может быть более одного кода оплаты типа НАЛИЧНЫЕ"
     2980              VIEW-AS ALERT-BOX.
     2981              RETURN no-apply.
     2982          END.
     2983      END.
     2984      IF tt-cash-pay-mar-pet.cdpay-code-mar-pet = 2 THEN DO:
     2985          ASSIGN
     2986          v-2 = v-2 + 1.
     2987          IF v-2 > 21 THEN DO:
     2988              MESSAGE
     2989              "Не может быть более 21 кода оплаты типа ДЕБЕТОВАЯ ВЕДОМОСТЬ ИЛИ ДЕБЕТОВЫЕ КАРТЫ/ТАЛОНЫ"
     2990              VIEW-AS ALERT-BOX.
     2991              RETURN no-apply.
     2992          END.
     2993      END.
     2994      IF tt-cash-pay-mar-pet.cdpay-code-mar-pet = 3 THEN DO:
     2995          ASSIGN
     2996          v-3 = v-3 + 1.
     2997          IF v-3 > 21 THEN DO:
     2998              MESSAGE
     2999              "Не может быть более 21 кода оплаты типа КРЕДИТНАЯ ВЕДОМОСТЬ ИЛИ КРЕДИТНЫЕ КАРТЫ ТАЛОНЫ"
     3000              VIEW-AS ALERT-BOX.
     3001              RETURN no-apply.
     3002          END.
     3003      END.
     3004      IF tt-cash-pay-mar-pet.cdpay-code-mar-pet = 4 THEN DO:
     3005          ASSIGN
     3006          v-4 = v-4 + 1.
     3007          IF v-4 > 20 THEN DO:
     3008              MESSAGE
     3009              "Не может быть более 20 кодов оплаты типа ПЛАТЕЖНЫЕ КАРТЫ"
     3010              VIEW-AS ALERT-BOX.
     3011              RETURN no-apply.
     3012          END.
     3013      END.
     3014      ASSIGN
     3015      ii = ii + 1
     3016      v-mariapayp = v-mariapayp + (IF ii = 1 THEN '':U ELSE ';') +
     3017                    STRING(tt-cash-pay-mar-pet.cdpay-code-mar-pet) + chr(44) +
     3018                    STRING(tt-cash-pay-mar-pet.emitent)  + chr(47) +
     3019                    STRING(tt-cash-pay-mar-pet.cdpay-code) + chr(44) +
     3020                    STRING(tt-cash-pay-mar-pet.curr-code)
     3021      .
     3022   END.
     3023   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'cdtaxlst':U.
     3024   assign
     3025   thbjattr_thbj-attr.property-value-character = v-cdtaxlst.
     3026   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'mariapayg':U.
     3027   assign
     3028   thbjattr_thbj-attr.property-value-character = v-mariapayg.
     3029   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'mariapayp':U.
     3030   assign
     3031   thbjattr_thbj-attr.property-value-character = v-mariapayp.
     3032   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'dr-list':U.
     3033   assign
     3034   thbjattr_thbj-attr.property-value-character = dr-list.
     3035   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'drgrouprank':U.
     3036   assign
     3037   thbjattr_thbj-attr.property-value-character =  (if drgrouprank = '':U
     3038                                                   then '%-46,%сумма-49':U
     3039                                                   else drgrouprank).
     3040   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'drgdsrank':U.
     3041   assign
     3042   thbjattr_thbj-attr.property-value-character =   (if drgdsrank = '':U
     3043                                                   then '%/std-discnt-rule,abs/abs-discnt-rule,%кол-во/qnty-discnt-rule,%сумма/tot-discnt-rule':U
     3044                                                   else drgdsrank).
     3045   v-same = yes.
     3046   for each thbjattr_thbj-attr,
     3047       first temp-thbj-attr where
     3048             temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     3049         and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     3050         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     3051         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code:
     3052      buffer-compare
     3053      thbjattr_thbj-attr
     3054      to temp-thbj-attr
     3055      save result in v-same.
     3056      if not v-same then leave.
     3057   end.
     3058   v-same = no.
     3059   IF v-same  and not v-to-create THEN RETURN.
     3060   run adm/shattri.p (
     3061                 input "check":U
     3062               , input p-obj-type
     3063               , input p-obj-code
     3064               , input 'cd-type-maria':U
     3065               , INPUT '':U
     3066                , output v-value-character
     3067                , output v-value-date
     3068                , output v-value-decimal
     3069                , output v-value-integer
     3070                , output v-value-logical
     3071                , output v-param-type
     3072                , input-output TABLE-handle v-tth
     3073                ) no-error .
     3074   if error-status:error then do:
     3075     message
     3076     "Некорректное значение ПАРАМЕТРОВ" skip
     3077     error-status:get-message(1) skip
     3078     return-value
     3079     view-as alert-box error .
     3080     undo, return error .
     3081   end.
     3082   do TRANSACTION
     3083   on error undo, return error return-value
     3084   :
     3085     RUN thbjattr_set-section IN THIS-PROCEDURE (
     3086          input p-obj-type
     3087         ,input p-obj-code
     3088         ,input 'cd-type-maria':U
     3089         ,INPUT table thbjattr_thbj-attr
     3090     ) NO-ERROR.
     3091     IF ERROR-STATUS:error THEN do:
     3092       MESSAGE ERROR-STATUS:get-message(1)  SKIP
     3093       RETURN-VALUE
     3094       VIEW-AS ALERT-BOX.
     3095       UNDO, RETURN ERROR.
     3096     END.
     3097   end.
     3098   END PROCEDURE.
