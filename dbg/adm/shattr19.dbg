      376   procedure thbjattr_code_reg :
      377   define input  parameter p-upper-code     as character no-undo .
      378   define input  parameter p-code           as character no-undo .
      379   define output parameter p-label          as character no-undo .
      380   define output parameter p-user-can-edit  as logical   no-undo .
      381   define output parameter p-output-display as logical   no-undo .
      382   define output parameter p-other          as character no-undo .
