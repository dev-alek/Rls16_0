      499   do
      500   on error undo, return error return-value
      501   :
      502       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_get-section in g#attr-lib
      503       (input  p-obj-type
      504       ,input  p-obj-code
      505       ,input  p-upper-param-code
      506       ,input  p-mode
      507       ,input-output table-handle p-tth
      508       ,output p-all-found
      509       ) no-error .
      510     if error-status :error
      511     then do:
      512       delete object p-tth.
      513       undo, return error return-value .
      514     end.
      515     delete object p-tth.
      516   end.
      517   end procedure.
