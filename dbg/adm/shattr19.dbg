        1   DEFINE BUFFER locked_thbj-attr FOR ub.thbj-attr.
        2   DEFINE TEMP-TABLE tt-cash-pay-mar NO-UNDO LIKE ub.cash-pay
        3          field cdpay-code-mar like ub.cash-pay.cdpay-code
        4          field obj-name-mar as character
        5          index pi is unique primary cdpay-code-mar.
        6   DEFINE TEMP-TABLE tt-cash-pay-mar-pet NO-UNDO LIKE ub.cash-pay
        7          field cdpay-code-mar-pet like ub.cash-pay.cdpay-code
        8          field emitent like ub.cash-pay.cdpay-code
        9          field obj-name-mar as character
       10          index pi is unique primary cdpay-code-mar-pet
       11          emitent.
       12   DEFINE TEMP-TABLE tt-tax-rate-code NO-UNDO LIKE ub.tax-rate
       13          field bo-tax-code like ub.tax-rate.tax-code
       14          index pi is unique primary rate-code.
       15   DEFINE BUFFER X_shop FOR ub.shop.
       16   DEFINE BUFFER X_sysconf FOR ub.sysconf.
       17   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
       18   DEFINE INPUT PARAMETER p-mode AS CHARACTER NO-UNDO.
       19   DEFINE INPUT PARAMETER p-obj-type LIKE ub.clients.obj-type NO-UNDO.
       20   DEFINE INPUT PARAMETER p-obj-code LIKE ub.shop.obj-code NO-UNDO.
       21   define variable vss-revision    as character no-undo init "$Revision$":U .
       22   define variable vss-author      as character no-undo init "$Author$":U .
       23   define variable vss-date        as character no-undo init "$Date$":U .
       24   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       25   define variable vss-archive     as character no-undo init "$Archive$":U .
       26   define variable vss-description as character no-undo init "Редактирование атрибута магазина (thbj-attr) 'cd-type-maria'".
       27   procedure vss-get-info :
       28     define output parameter p-vss-revision    like vss-revision    no-undo .
       29     define output parameter p-vss-author      like vss-author      no-undo .
       30     define output parameter p-vss-date        like vss-date        no-undo .
       31     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       32     define output parameter p-vss-archive     like vss-archive     no-undo .
       33     define output parameter p-vss-description like vss-description no-undo .
       34     assign
       35       p-vss-revision    = vss-revision
       36       p-vss-author      = vss-author
       37       p-vss-date        = vss-date
       38       p-vss-workfile    = vss-workfile
       39       p-vss-archive     = vss-archive
       40       p-vss-description = vss-description
       41     .
       42   end procedure.
       43   procedure vss-get-parameters :
       44     define output parameter p-vss-parameters as character no-undo .
       45   end procedure.
       46   define new global shared variable g#vssrevis-logger as handle    no-undo .
       47   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       48   define variable v-vssrevis-logger                   as handle    no-undo .
       49   procedure vss-logevent :
       50     define input  parameter p-extra-paramters as character no-undo .
       51     define variable v-vssrevis-parameters as character no-undo .
       52     do
       53     on error undo, return error return-value
       54     :
       55       if  valid-handle(v-vssrevis-logger)
       56       and v-vssrevis-logger :get-signature("logevent") <> ""
       57       then do:
       58         run vss-get-parameters in this-procedure
       59           (output v-vssrevis-parameters
       60           ).
       61         run logevent in v-vssrevis-logger
       62           (input vss-workfile
       63           ,input vss-revision
       64           ,input v-vssrevis-parameters
       65           ,input p-extra-paramters
       66           ).
       67       end.
       68     end.
       69   end procedure.
       70   assign
       71     v-vssrevis-logger = g#vssrevis-logger
       72   .
       73   if  valid-handle(v-vssrevis-logger)
       74   and v-vssrevis-logger :get-signature("logevent") <> ""
       75   then do:
       76     assign
       77       v-vssrevis-logevent = true
       78     .
       79     run vss-logevent in this-procedure (input vss-description) .
       80   end.
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   define variable v-waitfram-action01         as character   no-undo .
       83   define variable v-waitfram-action02         as character   no-undo .
       84   define variable v-waitfram-action03         as character   no-undo .
       85   define variable mWaitFramTextBeg            as character   no-undo.
       86   define variable mWaitFramTextEnd            as character   no-undo.
       87   define variable mWaitFramView               as logical     no-undo.
       88   define variable mWaitProcEvent              as logical     no-undo init yes.
       89   define variable mWaitFramInterval           as integer     no-undo init 1 .
       90   define variable mWaitFramStop               as logical     no-undo.
       91   define variable mWaitFramStopUser           as logical     no-undo.
       92   define variable mWaitFramStopTimeOut        as logical     no-undo.
       93   define variable mWaitFramStartProc          as datetime-tz no-undo.
       94   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       95   define button B-WaitFramStop auto-end-key
       96        label "Стоп"
       97        size 10 by 1 tooltip "Остоновить процесс".
       98   define button B-viewProcInfo
       99        label "Информация"
      100        size 15 by 1 tooltip "Информация о процесс".
      101   define frame waitfram
      102     v-waitfram-action01 format "x(72)" no-label skip
      103     v-waitfram-action02 format "x(72)" no-label skip
      104     v-waitfram-action03 format "x(72)" no-label skip
      105     B-viewProcInfo
      106     B-WaitFramStop at row 4 col 30
      107     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      108     .
      109   define new global shared variable mBatchMode as logical no-undo init ?.
      110   define variable mFramBachModHandle as handle no-undo.
      111   mFramBachModHandle = frame waitfram:handle.
      112   define variable mFameOldVis as logical no-undo.
      113   define variable mVisCUrentVin as logical no-undo.
      114   if session:batch-mode
      115   then
      116      mBatchMode = yes.
      117   if mBatchMode = ? then do:
      118     mVisCUrentVin = current-window:visible.
      119     mFameOldVis = mFramBachModHandle:visible.
      120     mFramBachModHandle:visible  = yes.
      121     mBatchMode = mFramBachModHandle:visible ne yes.
      122     mFramBachModHandle:visible = mFameOldVis.
      123     current-window:visible = mVisCUrentVin.
      124   end.
      125    if  log-manager:logfile-name ne ?
      126     then DO:
      127         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      128         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      129         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      130     end.
      131   on choose of B-WaitFramStop in frame waitfram
      132   do:
      133     mWaitFramStop = yes.
      134     mWaitFramStopUser = yes.
      135   end.
      136   function waitfram-check-timeout returns logical():
      137      define variable vtime as int64 no-undo.
      138      if mWaitFramStopTimeOut
      139      then
      140         return yes.
      141      vtime = ( now - mWaitFramStartProc ) / 1000 .
      142      if     mWaitFramTimeOut ne ?
      143         and mWaitFramTimeOut ne 0
      144         and mWaitFramTimeOut lt vtime
      145      then do:
      146         mWaitFramStopTimeOut = yes.
      147      end.
      148      return mWaitFramStopTimeOut.
      149   end.
      150   procedure waitfram-hide :
      151     if not session:batch-mode
      152     then do
      153     on error undo, return error return-value
      154     :
      155       pause 0 before-hide .
      156       if not mBatchMode then
      157         hide frame waitfram .
      158     if     not mWaitFramView
      159        and mWaitProcEvent
      160     then
      161       process events .
      162     end.
      163   end procedure.
      164   procedure waitfram-show :
      165     define input  parameter p-message as character no-undo .
      166     define variable v-left-margin as integer   no-undo .
      167     if not session:batch-mode
      168     then do
      169     on error undo, return error return-value
      170     :
      171       if length(p-message) <= 70 then do:
      172         assign
      173           v-left-margin = integer((70 - length(p-message)) / 2)
      174         .
      175         assign
      176           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      177         .
      178         assign
      179           v-waitfram-action01 = " "
      180           v-waitfram-action02 = " "
      181                                    + fill(" ", v-left-margin)
      182                                    + p-message
      183           v-waitfram-action03 = " "
      184         .
      185       end.
      186       else do:
      187         define variable vRindex1 as integer no-undo.
      188         define variable vRindex2 as integer no-undo.
      189         vRindex1 = r-index(p-message," ",70).
      190         if vRindex1 = 0
      191         then
      192            vRindex1 = 70.
      193         if length(p-message)  <= vRindex1 + 70 then do:
      194           assign
      195             v-waitfram-action01 = " "
      196             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      197             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      198           .
      199         end.
      200         else do:
      201           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      202           if vRindex2 <= vRindex1
      203           then
      204              vRindex2 = vRindex1 + 70.
      205           assign
      206             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      207             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      208             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      209           .
      210         end.
      211       end.
      212       B-viewProcInfo:visible   in frame waitfram = no.
      213       B-viewProcInfo:sensitive in frame waitfram = no.
      214       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      215       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      216       if  (   mWaitFramView
      217          or  mWaitProcEvent)
      218          and not mBatchMode
      219       then
      220          display
      221             v-waitfram-action01 skip
      222             v-waitfram-action02 skip
      223             v-waitfram-action03 skip
      224          with frame waitfram .
      225       if     mWaitFramView
      226          then do:
      227             if     mWaitFramInterval ne ?
      228                and not mBatchMode
      229             then
      230                wait-for go of frame waitfram pause mWaitFramInterval.
      231          end.
      232          else
      233             if     mWaitProcEvent
      234                and not mBatchMode
      235             then
      236                process events .
      237     end.
      238   end procedure.
      239      procedure waitfram-show-this:
      240         define input  parameter iInterval as int64 no-undo.
      241         define variable vtime as int64 no-undo.
      242         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      243         mWaitFramInterval = iInterval.
      244         run waitfram-show (substitute("&1&2 &3&4" ,
      245                                       mWaitFramTextBeg ,
      246                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      247                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      248                                       mWaitFramTextEnd
      249                                      )
      250                           ).
      251      end.
      252      procedure WaitFramRunPause:
      253         define input  parameter iInterval as dec no-undo.
      254         define variable vStart  as datetime-tz no-undo.
      255         define variable vend    as datetime-tz no-undo.
      256         define variable vint as int64 no-undo.
      257         define variable vOk as logical no-undo.
      258         vStart = now.
      259         vend   = vStart.
      260         publish "WaitFramPause" (iInterval,output vOk).
      261         vend   =  now.
      262         vint = vend - vStart.
      263         vint = iInterval - vint / 1000.
      264         if     not mWaitFramStop
      265            and (   vint > 0
      266                 or (    not vOk
      267                     and iInterval eq ?
      268                     )
      269                 )
      270         then
      271            run waitfram-show-this (iInterval).
      272         vend   =  now.
      273         vint = vend - vStart.
      274         vint = iInterval - vint / 1000.
      275         if     not mWaitFramStop
      276            and vint > 0
      277         then do:
      278            run gbl/pause.p (vint * 1000).
      279         end.
      280         if iInterval ne ?
      281         then
      282            publish "WaitFramStop".
      283         waitfram-check-timeout().
      284      end.
      285      procedure WaitFramWaitFor:
      286         define input  parameter iInterval as dec no-undo.
      287         assign
      288            mWaitFramStartProc   = now
      289            mWaitFramStopUser    = no
      290            mWaitFramStopTimeOut = no
      291         .
      292         block-wait:
      293         do while not mWaitFramStop:
      294            run WaitFramRunPause (iInterval).
      295            if  waitfram-check-timeout()
      296            then do:
      297               leave block-wait.
      298            end.
      299         end.
      300         run waitfram-hide.
      301      end.
      302   procedure waitfram-join :
      303     define input  parameter p-line-1  as character no-undo .
      304     define input  parameter p-line-2  as character no-undo .
      305     define input  parameter p-line-3  as character no-undo .
      306     define output parameter p-message as character no-undo .
      307     do
      308     on error undo, return error return-value
      309     :
      310       assign
      311         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      312                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      313                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      314       .
      315     end.
      316   end procedure.
      317   function waitfram-join-function returns character
      318     (input p-line-1 as character
      319     ,input p-line-2 as character
      320     ,input p-line-3 as character
      321     ).
      322     define variable v-message as character no-undo .
      323     run waitfram-join in this-procedure
      324       (input  p-line-1
      325       ,input  p-line-2
      326       ,input  p-line-3
      327       ,output v-message
      328       ) .
      329     return v-message .
      330   end function .
      331   define new global shared variable g#language as character no-undo .
      332   if g#language <> '' and g#language <> 'rus':U then do:
      333     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      334   end.
      335   define new global shared variable g#library  as handle no-undo .
      336   define new global shared variable g#library2 as handle no-undo .
      337   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      338   define new global shared variable g#attr-lib  as handle no-undo .
      339   define variable v-attr-lib-variable as handle no-undo .
      340   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      341   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      342   procedure thbjattr_code :
