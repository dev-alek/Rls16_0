      385   define output parameter p-prop-label-list as character no-undo .
      386   define output parameter p-global          as logical no-undo .
      387   define output parameter p-host           as logical no-undo .
      388   define output parameter p-shop           as logical no-undo .
      389   define output parameter p-store          as logical no-undo .
      390   define output parameter p-db             as logical no-undo .
      391   define output parameter p-region         as logical no-undo .
      392   do
      393   on error undo, return error return-value
      394   :
      395       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      396       (input  p-upper-code
      397       ,input  p-code
      398       ,output p-label
      399       ,output p-user-can-edit
      400       ,output p-output-display
      401       ,output p-other
      402       ,output p-prop-list
      403       ,output p-prop-type-list
      404       ,output p-prop-label-list
      405       ,output p-global
      406       ,output p-host
      407       ,output p-shop
      408       ,output p-store
      409       ,output p-db
      410       ,output p-region
      411       ) no-error .
      412     if error-status :error
      413     then do:
      414       undo, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message (1)).
      415     end.
      416   end.
      417   end procedure.
