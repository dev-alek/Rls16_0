        1   define input  parameter parparentproc  as widget-handle no-undo .
        2   define input  parameter p-db-num       as integer   no-undo .
        3   define input  parameter p-user-id      as character no-undo .
        4   define input  parameter p-user-login   as character no-undo .
        5   define input  parameter p-user-Name    as character no-undo .
        6   define input  parameter p-user-adm     as logical   no-undo .
        7   define input  parameter p-LastPassVis  as logical   no-undo .
        8   if p-user-adm eq yes
        9      then
       10      p-LastPassVis = no.
       11   define input  parameter p-old-password as character no-undo .
       12   define input  parameter p-login        as logical   no-undo .
       13   define input  parameter i-CheckAdm     as logical   no-undo .
       14   define output parameter p-password     as character no-undo initial ? .
       15   define output parameter ochgpdwnextcon as logical   no-undo .
       16   define variable vss-revision    as character no-undo init "$Revision$":U .
       17   define variable vss-author      as character no-undo init "$Author$":U .
       18   define variable vss-date        as character no-undo init "$Date$":U .
       19   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       20   define variable vss-archive     as character no-undo init "$Archive$":U .
       21   define variable vss-description as character no-undo init "Диалог задания пароля пользователя".
       22   procedure vss-get-info :
       23     define output parameter p-vss-revision    like vss-revision    no-undo .
       24     define output parameter p-vss-author      like vss-author      no-undo .
       25     define output parameter p-vss-date        like vss-date        no-undo .
       26     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       27     define output parameter p-vss-archive     like vss-archive     no-undo .
       28     define output parameter p-vss-description like vss-description no-undo .
       29     assign
       30       p-vss-revision    = vss-revision
       31       p-vss-author      = vss-author
       32       p-vss-date        = vss-date
       33       p-vss-workfile    = vss-workfile
       34       p-vss-archive     = vss-archive
       35       p-vss-description = vss-description
       36     .
       37   end procedure.
       38   procedure vss-get-parameters :
       39     define output parameter p-vss-parameters as character no-undo .
       40   end procedure.
       41   define new global shared variable g#vssrevis-logger as handle    no-undo .
       42   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       43   define variable v-vssrevis-logger                   as handle    no-undo .
       44   procedure vss-logevent :
       45     define input  parameter p-extra-paramters as character no-undo .
       46     define variable v-vssrevis-parameters as character no-undo .
       47     do
       48     on error undo, return error return-value
       49     :
       50       if  valid-handle(v-vssrevis-logger)
       51       and v-vssrevis-logger :get-signature("logevent") <> ""
       52       then do:
       53         run vss-get-parameters in this-procedure
       54           (output v-vssrevis-parameters
       55           ).
       56         run logevent in v-vssrevis-logger
       57           (input vss-workfile
       58           ,input vss-revision
       59           ,input v-vssrevis-parameters
       60           ,input p-extra-paramters
       61           ).
       62       end.
       63     end.
       64   end procedure.
       65   assign
       66     v-vssrevis-logger = g#vssrevis-logger
       67   .
       68   if  valid-handle(v-vssrevis-logger)
       69   and v-vssrevis-logger :get-signature("logevent") <> ""
       70   then do:
       71     assign
       72       v-vssrevis-logevent = true
       73     .
       74     run vss-logevent in this-procedure (input vss-description) .
       75   end.
       76   define new global shared variable g#language as character no-undo .
       77   if g#language <> '' and g#language <> 'rus':U then do:
       78     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       79   end.
       80   define new global shared variable g#library  as handle no-undo .
       81   define new global shared variable g#library2 as handle no-undo .
       82   procedure proc-alt-shift-f2:
       83     if not ibs.th.gbl.gbl-var:rcode
       84   then
       85     run gbl\inidebug.p .
       86   end.
       87   procedure proc-alt-shift-f3:
       88     run gbl/prvssinf.p
       89       ( input this-procedure
       90       ) .
       91   end.
       92   define variable v-inform-launched as logical no-undo initial false .
       93   procedure proc-alt-shift-f4:
       94     define variable v-action as character no-undo .
       95     if v-inform-launched = false then do:
       96       assign
       97         v-inform-launched = true
       98       .
       99       run gbl/d-inform.w
      100         (  input self
      101         ,  input this-procedure
      102         , output v-action
      103         ) no-error .
      104       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      105       assign
      106         v-inform-launched = false
      107       .
      108     end.
      109   end.
      110   procedure proc-alt-f1:
      111     run gbl/corrhelp.p
      112       (input this-procedure
      113       ) .
      114   end .
      115   on alt-shift-f2 anywhere do:
      116     run proc-alt-shift-f2.
      117   end.
      118   on alt-shift-f3 anywhere do:
      119     run proc-alt-shift-f3 in this-procedure .
      120   end.
      121   on alt-shift-f4 anywhere do:
      122     run proc-alt-shift-f4 in this-procedure.
      123   end.
      124   on alt-f1 anywhere do:
      125     run proc-alt-f1 in this-procedure .
      126   end.
      127   define   shared variable g#auto as logical no-undo.
      128   define   shared variable g#news as logical no-undo.
      129   define   shared variable g#oxml as logical no-undo.
      130   define   shared variable g#esys as logical no-undo.
      131   define   shared variable g#news-source-db as integer no-undo.
      132   define   shared variable g#esys-source-esys as integer no-undo.
      133   define   shared variable g#db-num as integer   no-undo .
      134   define   shared variable g#userid as character no-undo .
      135   define   shared variable g#passwd as character no-undo .
      136   define temp-table UserDbAdm
      137   field db-num as integer
      138   field db-adm as logical
      139   field db-usr as logical
      140   field db-block as logical
      141   index pi is unique db-num
      142   index adm db-adm db-usr
      143   .
      144   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      145   procedure cur-time :
      146      define output parameter p-today as date      no-undo .
      147      define output parameter p-time  as integer   no-undo .
      148     do
      149     on error undo, return error
      150     :
      151       define variable v-date1 as date      no-undo .
      152       define variable v-date2 as date      no-undo .
      153       define variable v-time  as integer   no-undo .
      154       assign
      155         v-date1 = today
      156         v-time  = time
      157         v-date2 = today
      158       .
      159       if v-date1 <> v-date2
      160       then do:
      161         assign
      162           v-date1 = today
      163           v-time  = v-time
      164         .
      165       end.
      166       assign
      167         p-today = v-date1
      168         p-time  = v-time
      169       .
      170     end.
      171   end.
      172   function cur-time-date returns character
      173   :
      174     return string(today, '99/99/9999':U) .
      175   end.
      176   function cur-time-mjd returns decimal
      177   :
      178     define variable v-date as date      no-undo .
      179     define variable v-time as integer   no-undo .
      180     run cur-time in this-procedure
      181       (output v-date
      182       ,output v-time
      183       ) .
      184     return integer(v-date) - 2400002 + (v-time / 86400) .
      185   end.
      186   function cur-time-get-ending-index returns integer
      187   (input p-number as integer
      188   )
      189   :
      190     if p-number < 0
      191     or p-number = ?
      192     then do:
      193       return 1 .
      194     end.
      195     define variable v-rest as integer   no-undo .
      196     assign
      197       p-number = p-number modulo 100
      198     .
      199     if p-number < 20
      200     then do:
      201       assign
      202         v-rest = p-number
      203       .
      204     end.
      205     else do:
      206       assign
      207         v-rest = p-number modulo 10
      208       .
      209     end.
      210     case v-rest :
      211       when 1
      212       then do:
      213         return 2 .
      214       end.
      215       when 2 or
      216       when 3 or
      217       when 4
      218       then do:
      219         return 3 .
      220       end.
      221       otherwise do:
      222         return 1 .
      223       end.
      224     end case .
      225   end.
      226   procedure cur-time-mjd-to-date :
      227      define input  parameter i-mjd-diff as decimal no-undo.
      228      define output parameter o-Date     as date    no-undo.
      229      define output parameter o-Time     as integer no-undo.
      230      define variable v-day-number as integer   no-undo .
      231      if    i-mjd-diff < 0
      232         or i-mjd-diff = ?
      233      then do:
      234         return "?" .
      235      end.
      236      assign
      237         v-day-number = truncate(i-mjd-diff,0).
      238         o-Date = date(v-day-number + 2400002).
      239         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      240     .
      241   end.
      242   function cur-time-mjd-to-string returns character
      243   (input p-mjd-diff as decimal
      244   )
      245   :
      246     define variable v-day-number as integer   no-undo .
      247     define variable v-seconds    as integer   no-undo .
      248     define variable v-hour       as integer   no-undo .
      249     define variable v-min        as integer   no-undo .
      250     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      251     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      252     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      253     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      254     if p-mjd-diff < 0
      255     or p-mjd-diff = ?
      256     then do:
      257       return "?" .
      258     end.
      259     assign
      260       v-day-number = integer(truncate(p-mjd-diff,0))
      261       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      262     .
      263     if v-seconds > 86400
      264     then do:
      265       assign
      266         v-seconds = 86400 - 1
      267       .
      268     end.
      269     if v-seconds < 0
      270     then do:
      271       assign
      272         v-seconds = 0
      273       .
      274     end.
      275     assign
      276       v-hour = truncate(v-seconds / 3600, 0)
      277     .
      278     assign
      279       v-seconds = v-seconds modulo 3600
      280     .
      281     assign
      282       v-min = truncate(v-seconds / 60, 0)
      283     .
      284     assign
      285       v-seconds = v-seconds modulo 60
      286     .
      287     return
      288         (if v-day-number <> 0
      289           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      290           else ""
      291         )
      292       + (if v-day-number <> 0 or v-hour <> 0
      293           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      294           else ""
      295         )
      296       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      297           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      298           else ""
      299         )
      300       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      301       .
      302   end.
      303   function cur-time-string returns character
      304   :
      305     define variable v-date as date      no-undo .
      306     define variable v-time as integer   no-undo .
      307     run cur-time in this-procedure
      308       (output v-date
      309       ,output v-time
      310       ) .
      311     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      312   end.
      313   function cur-time-string-sec returns character
      314   :
      315     define variable v-date as date      no-undo .
      316     define variable v-time as integer   no-undo .
      317     run cur-time in this-procedure
      318       (output v-date
      319       ,output v-time
      320       ) .
      321     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      322   end.
      323   function cur-time-custom  returns character
      324   (input p-prefix as character
      325   ,input p-date-format as character
      326   ,input p-delimiter as character
      327   ,input p-time-format as character
      328   ,input p-suffix as character
      329   )
      330   :
      331     define variable v-date as date      no-undo .
      332     define variable v-time as integer   no-undo .
      333     run cur-time in this-procedure
      334       (output v-date
      335       ,output v-time
      336       ) .
      337     return
      338       p-prefix
      339       + string(v-date, p-date-format)
      340       + p-delimiter
      341       + string(v-time, p-time-format)
      342       + p-suffix
      343       .
      344   end.
      345   function cur-time-print  returns character
      346   :
      347     define variable v-date as date      no-undo .
      348     define variable v-time as integer   no-undo .
      349     run cur-time in this-procedure
      350       (output v-date
      351       ,output v-time
      352       ) .
      353     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      354   end.
      355   function cur-time-datetime returns datetime
      356   :
      357     define variable v-char as character no-undo .
      358     define variable v-datetime as datetime no-undo .
      359     v-char = cur-time-string().
      360     v-datetime = datetime(v-char).
      361     return  v-datetime.
      362   end.
      363   function cur-time-string-msec returns character
      364   :
      365     define variable v-date as datetime  no-undo .
      366     v-date = now.
      367     return string(v-date) .
      368   end.
      369   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      370   procedure sys-time_get-sys :
      371     define output parameter p-year         as integer   no-undo .
      372     define output parameter p-month        as integer   no-undo .
      373     define output parameter p-day          as integer   no-undo .
      374     define output parameter p-hour         as integer   no-undo .
      375     define output parameter p-minute       as integer   no-undo .
      376     define output parameter p-second       as integer   no-undo .
      377     define output parameter p-milliseconds as integer   no-undo .
      378     define variable v-system-time-structure as memptr    no-undo.
      379     do
      380     on error undo, return error return-value
      381     :
      382       assign
      383         set-size(v-system-time-structure) = 16
      384       .
      385       run GetSystemTime
      386         (input  get-pointer-value(v-system-time-structure)
      387         ) .
      388       assign
      389         p-year         = get-short(v-system-time-structure,  1)
      390         p-month        = get-short(v-system-time-structure,  3)
      391         p-day          = get-short(v-system-time-structure,  7)
      392         p-hour         = get-short(v-system-time-structure,  9)
      393         p-minute       = get-short(v-system-time-structure, 11)
      394         p-second       = get-short(v-system-time-structure, 13)
      395         p-milliseconds = get-short(v-system-time-structure, 15)
      396       .
      397       assign
      398         set-size(v-system-time-structure) = 0
      399       .
      400     end.
      401   end procedure.
      402   procedure sys-time_get-comp-user-name :
      403     define output parameter p-computer-name as character no-undo .
      404     define output parameter p-user-name     as character no-undo .
      405     define output parameter p-process-pid   as integer   no-undo .
      406     define variable v-return-value  as integer   no-undo .
      407     define variable v-buffer-length as integer   no-undo .
      408     define variable v-buffer-memptr as memptr    no-undo .
      409     do
      410     on error undo, return error return-value
      411     :
      412       assign
      413         v-buffer-length = 1024
      414         set-size(v-buffer-memptr) = v-buffer-length + 4
      415       .
      416       assign
      417         put-long(v-buffer-memptr, 1) = v-buffer-length
      418       .
      419       run GetComputerNameA
      420         (input  get-pointer-value(v-buffer-memptr) + 4
      421         ,input  get-pointer-value(v-buffer-memptr)
      422         ,output v-return-value
      423         ) .
      424       if v-return-value <> 0
      425       then do:
      426         assign
      427           p-computer-name = get-string(v-buffer-memptr, 5)
      428         .
      429       end.
      430       assign
      431         put-long(v-buffer-memptr, 1) = v-buffer-length
      432       .
      433       run GetUserNameA
      434         (input  get-pointer-value(v-buffer-memptr) + 4
      435         ,input  get-pointer-value(v-buffer-memptr)
      436         ,output v-return-value
      437         ) .
      438       if v-return-value <> 0
      439       then do:
      440         assign
      441           p-user-name = get-string(v-buffer-memptr, 5)
      442         .
      443       end.
      444       run GetCurrentProcessId
      445         (output p-process-pid
      446         ) .
      447       assign
      448         set-size(v-buffer-memptr) = 0
      449       .
      450     end.
      451   end procedure.
      452   procedure sys-time_get-http :
      453     define output parameter p-http-time as character no-undo .
      454     define variable v-year         as integer   no-undo .
      455     define variable v-month        as integer   no-undo .
      456     define variable v-day-of-week  as integer   no-undo .
      457     define variable v-day          as integer   no-undo .
      458     define variable v-hour         as integer   no-undo .
      459     define variable v-minute       as integer   no-undo .
      460     define variable v-second       as integer   no-undo .
      461     define variable v-milliseconds as integer   no-undo .
      462     do
      463     on error undo, return error return-value
      464     :
      465       run sys-time_get-sys in this-procedure
      466         (output v-year
      467         ,output v-month
      468         ,output v-day
      469         ,output v-hour
      470         ,output v-minute
      471         ,output v-second
      472         ,output v-milliseconds
      473         ) .
      474       assign
      475         v-day-of-week = weekday(date(v-month, v-day, v-year))
      476         p-http-time = entry(v-day-of-week, 'Sun,Mon,Tue,Wed,Thu,Fri,Sat')
      477                     + ', ':u
      478                     + string(v-day, '99':u)
      479                     + ' ':u
      480                     + entry(v-month, 'Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec':u)
      481                     + ' ':u
      482                     + string(v-year, '9999':u)
      483                     + ' ':u
      484                     + string(v-hour, '99':u)
      485                     + ':':u
      486                     + string(v-minute, '99':u)
      487                     + ':':u
      488                     + string(v-second, '99':u)
      489                     + ' ':u
      490                     + 'GMT':u
      491       .
      492     end.
      493   end procedure.
      494   procedure sys-time_set-sys :
      495     define input  parameter p-year         as integer   no-undo .
      496     define input  parameter p-month        as integer   no-undo .
      497     define input  parameter p-day          as integer   no-undo .
      498     define input  parameter p-hour         as integer   no-undo .
      499     define input  parameter p-minute       as integer   no-undo .
      500     define input  parameter p-second       as integer   no-undo .
      501     define input  parameter p-milliseconds as integer   no-undo .
      502     define variable v-system-time-structure as memptr    no-undo.
      503     define variable v-return-value as integer   no-undo .
      504     define variable v-day-of-week  as integer   no-undo .
      505     do
      506     on error undo, return error return-value
      507     :
      508       assign
      509         v-day-of-week = weekday(date(p-month, p-day, p-year))
      510       .
      511       assign
      512         set-size(v-system-time-structure) = 16
      513       .
      514       assign
      515         put-short(v-system-time-structure,  1) = p-year
      516         put-short(v-system-time-structure,  3) = p-month
      517         put-short(v-system-time-structure,  5) = v-day-of-week
      518         put-short(v-system-time-structure,  7) = p-day
      519         put-short(v-system-time-structure,  9) = p-hour
      520         put-short(v-system-time-structure, 11) = p-minute
      521         put-short(v-system-time-structure, 13) = p-second
      522         put-short(v-system-time-structure, 15) = p-milliseconds
      523       .
      524       run SetSystemTime
      525         (input  get-pointer-value(v-system-time-structure)
      526         ,output v-return-value
      527         ) .
      528       assign
      529         set-size(v-system-time-structure) = 0
      530       .
      531       if v-return-value = 0
      532       then do:
      533         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      534       end.
      535     end.
      536   end procedure.
      537   procedure sys-time_sys-to-mjd :
      538     define input  parameter p-year         as integer   no-undo .
      539     define input  parameter p-month        as integer   no-undo .
      540     define input  parameter p-day          as integer   no-undo .
      541     define input  parameter p-hour         as integer   no-undo .
      542     define input  parameter p-minute       as integer   no-undo .
      543     define input  parameter p-second       as integer   no-undo .
      544     define input  parameter p-milliseconds as integer   no-undo .
      545     define output parameter p-mjd          as decimal   no-undo .
      546     define variable v-year-correction as decimal   no-undo .
      547     define variable v-shift-year as decimal   no-undo .
      548     do
      549     on error undo, return error return-value
      550     :
      551       assign
      552         v-year-correction = truncate((decimal(p-month) - 14.0) / 12, 0)
      553         v-shift-year      = decimal(p-year) + v-year-correction
      554         p-mjd = truncate( (1461.0 * (v-shift-year + 4800.0 ) ) / 4, 0)
      555               + truncate( (367.0 * (decimal(p-month) - 2.0 - v-year-correction * 12) ) / 12, 0)
      556               - truncate( (3 * truncate((v-shift-year + 4900 ) / 100,0) ) / 4, 0)
      557               + decimal(p-day) - 2432076.0
      558               + p-hour / 24.0
      559               + p-minute / 1440.0
      560               + p-second / 86400.0
      561               + p-milliseconds / 86400000.0
      562       .
      563     end.
      564   end procedure.
      565   procedure sys-time_sys-to-loc :
      566     define input  parameter p-sys-year         as integer   no-undo .
      567     define input  parameter p-sys-month        as integer   no-undo .
      568     define input  parameter p-sys-day          as integer   no-undo .
      569     define input  parameter p-sys-hour         as integer   no-undo .
      570     define input  parameter p-sys-minute       as integer   no-undo .
      571     define input  parameter p-sys-second       as integer   no-undo .
      572     define input  parameter p-sys-milliseconds as integer   no-undo .
      573     define output parameter p-loc-year         as integer   no-undo .
      574     define output parameter p-loc-month        as integer   no-undo .
      575     define output parameter p-loc-day          as integer   no-undo .
      576     define output parameter p-loc-hour         as integer   no-undo .
      577     define output parameter p-loc-minute       as integer   no-undo .
      578     define output parameter p-loc-second       as integer   no-undo .
      579     define output parameter p-loc-milliseconds as integer   no-undo .
      580     define variable v-system-time-structure as memptr    no-undo.
      581     define variable v-return-value          as integer   no-undo .
      582     define variable v-sys-day-of-week       as integer   no-undo .
      583     do
      584     on error undo, return error return-value
      585     :
      586       assign
      587         v-sys-day-of-week = weekday(date(p-sys-month, p-sys-day, p-sys-year))
      588       .
      589       assign
      590         set-size(v-system-time-structure) = 32
      591       .
      592       assign
      593         put-short(v-system-time-structure,  1) = p-sys-year
      594         put-short(v-system-time-structure,  3) = p-sys-month
      595         put-short(v-system-time-structure,  5) = v-sys-day-of-week
      596         put-short(v-system-time-structure,  7) = p-sys-day
      597         put-short(v-system-time-structure,  9) = p-sys-hour
      598         put-short(v-system-time-structure, 11) = p-sys-minute
      599         put-short(v-system-time-structure, 13) = p-sys-second
      600         put-short(v-system-time-structure, 15) = p-sys-milliseconds
      601       .
      602       run SystemTimeToTzSpecificLocalTime
      603         (input  0
      604         ,input  get-pointer-value(v-system-time-structure)
      605         ,input  get-pointer-value(v-system-time-structure) + 16
      606         ,output v-return-value
      607         ) .
      608       assign
      609         p-loc-year         = get-short(v-system-time-structure,  1 + 16)
      610         p-loc-month        = get-short(v-system-time-structure,  3 + 16)
      611         p-loc-day          = get-short(v-system-time-structure,  7 + 16)
      612         p-loc-hour         = get-short(v-system-time-structure,  9 + 16)
      613         p-loc-minute       = get-short(v-system-time-structure, 11 + 16)
      614         p-loc-second       = get-short(v-system-time-structure, 13 + 16)
      615         p-loc-milliseconds = get-short(v-system-time-structure, 15 + 16)
      616       .
      617       assign
      618         set-size(v-system-time-structure) = 0
      619       .
      620       if v-return-value = 0
      621       then do:
      622         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      623       end.
      624     end.
      625   end procedure.
      626   procedure sys-time_mjd-to-sys :
      627     define input  parameter p-mjd          as decimal   no-undo .
      628     define output parameter p-year         as integer   no-undo .
      629     define output parameter p-month        as integer   no-undo .
      630     define output parameter p-day          as integer   no-undo .
      631     define output parameter p-hour         as integer   no-undo .
      632     define output parameter p-minute       as integer   no-undo .
      633     define output parameter p-second       as integer   no-undo .
      634     define output parameter p-milliseconds as integer   no-undo .
      635     define variable v-year-correction as decimal   no-undo .
      636     define variable v-shift-year      as decimal   no-undo .
      637     define variable v-conv-date     as date      no-undo .
      638     define variable v-int-part      as integer   no-undo .
      639     define variable v-fraction-part as decimal   no-undo .
      640     do
      641     on error undo, return error return-value
      642     :
      643       assign
      644         v-int-part      = integer(truncate(p-mjd, 0))
      645         v-fraction-part = p-mjd - v-int-part
      646         v-conv-date     = date(11, 17, 1858) + v-int-part
      647         p-year          = year(v-conv-date)
      648         p-month         = month(v-conv-date)
      649         p-day           = day(v-conv-date)
      650         v-fraction-part = v-fraction-part * 24.0
      651         p-hour          = integer(truncate(v-fraction-part, 0))
      652         v-fraction-part = (v-fraction-part - p-hour) * 60.0
      653         p-minute        = integer(truncate(v-fraction-part, 0))
      654         v-fraction-part = (v-fraction-part - p-minute) * 60.0
      655         p-second        = integer(truncate(v-fraction-part, 0))
      656         v-fraction-part = (v-fraction-part - p-second) * 1000.0
      657         p-milliseconds  = integer(v-fraction-part)
      658       .
      659     end.
      660   end procedure.
      661   procedure sys-time_mjd-to-loc :
      662     define input  parameter p-mjd              as decimal   no-undo .
      663     define output parameter p-loc-year         as integer   no-undo .
      664     define output parameter p-loc-month        as integer   no-undo .
      665     define output parameter p-loc-day          as integer   no-undo .
      666     define output parameter p-loc-hour         as integer   no-undo .
      667     define output parameter p-loc-minute       as integer   no-undo .
      668     define output parameter p-loc-second       as integer   no-undo .
      669     define output parameter p-loc-milliseconds as integer   no-undo .
      670     define variable v-sys-year         as integer   no-undo .
      671     define variable v-sys-month        as integer   no-undo .
      672     define variable v-sys-day          as integer   no-undo .
      673     define variable v-sys-hour         as integer   no-undo .
      674     define variable v-sys-minute       as integer   no-undo .
      675     define variable v-sys-second       as integer   no-undo .
      676     define variable v-sys-milliseconds as integer   no-undo .
      677     do
      678     on error undo, return error return-value
      679     :
      680       run sys-time_mjd-to-sys
      681         (input  p-mjd
      682         ,output v-sys-year
      683         ,output v-sys-month
      684         ,output v-sys-day
      685         ,output v-sys-hour
      686         ,output v-sys-minute
      687         ,output v-sys-second
      688         ,output v-sys-milliseconds
      689         ) .
      690       run sys-time_sys-to-loc
      691         (input  v-sys-year
      692         ,input  v-sys-month
      693         ,input  v-sys-day
      694         ,input  v-sys-hour
      695         ,input  v-sys-minute
      696         ,input  v-sys-second
      697         ,input  v-sys-milliseconds
      698         ,output p-loc-year
      699         ,output p-loc-month
      700         ,output p-loc-day
      701         ,output p-loc-hour
      702         ,output p-loc-minute
      703         ,output p-loc-second
      704         ,output p-loc-milliseconds
      705         ) .
      706     end.
      707   end procedure.
      708   function sys-time_get-mjd-func returns decimal
      709   :
      710     define variable v-year         as integer   no-undo .
      711     define variable v-month        as integer   no-undo .
      712     define variable v-day          as integer   no-undo .
      713     define variable v-hour         as integer   no-undo .
      714     define variable v-minute       as integer   no-undo .
      715     define variable v-second       as integer   no-undo .
      716     define variable v-milliseconds as integer   no-undo .
      717     define variable v-mjd          as decimal   no-undo .
      718     run sys-time_get-sys in this-procedure
      719       (output v-year
      720       ,output v-month
      721       ,output v-day
      722       ,output v-hour
      723       ,output v-minute
      724       ,output v-second
      725       ,output v-milliseconds
      726       ) .
      727     run sys-time_sys-to-mjd in this-procedure
      728       (input  v-year
      729       ,input  v-month
      730       ,input  v-day
      731       ,input  v-hour
      732       ,input  v-minute
      733       ,input  v-second
      734       ,input  v-milliseconds
      735       ,output v-mjd
      736       ) .
      737     return v-mjd .
      738   end function .
      739   function sys-time_get-sys-str-func returns character
      740   :
      741     define variable v-utc-time as character no-undo .
      742     define variable v-year         as integer   no-undo .
      743     define variable v-month        as integer   no-undo .
      744     define variable v-day          as integer   no-undo .
      745     define variable v-hour         as integer   no-undo .
      746     define variable v-minute       as integer   no-undo .
      747     define variable v-second       as integer   no-undo .
      748     define variable v-milliseconds as integer   no-undo .
      749     run sys-time_get-sys in this-procedure
      750       (output v-year
      751       ,output v-month
      752       ,output v-day
      753       ,output v-hour
      754       ,output v-minute
      755       ,output v-second
      756       ,output v-milliseconds
      757       ) .
      758     assign
      759       v-utc-time  = 'UTC ':u
      760                   + string(v-year,         '9999':u)
      761                   + '/':u
      762                   + string(v-month,        '99':u)
      763                   + '/':u
      764                   + string(v-day,          '99':u)
      765                   + ' ':u
      766                   + string(v-hour,         '99':u)
      767                   + ':':u
      768                   + string(v-minute,       '99':u)
      769                   + ':':u
      770                   + string(v-second,       '99':u)
      771                   + ' ':u
      772                   + string(v-milliseconds, '999':u)
      773     .
      774     return v-utc-time.
      775   end function .
      776   function sys-time_mjd-to-loc-str-func returns character
      777     (v-sys-mjd as decimal)
      778   :
      779     define variable v-loc-str          as character no-undo .
      780     define variable v-loc-year         as integer   no-undo .
      781     define variable v-loc-month        as integer   no-undo .
      782     define variable v-loc-day          as integer   no-undo .
      783     define variable v-loc-hour         as integer   no-undo .
      784     define variable v-loc-minute       as integer   no-undo .
      785     define variable v-loc-second       as integer   no-undo .
      786     define variable v-loc-milliseconds as integer   no-undo .
      787     run sys-time_mjd-to-loc in this-procedure
      788       (input  v-sys-mjd
      789       ,output v-loc-year
      790       ,output v-loc-month
      791       ,output v-loc-day
      792       ,output v-loc-hour
      793       ,output v-loc-minute
      794       ,output v-loc-second
      795       ,output v-loc-milliseconds
      796       ) .
      797     assign
      798       v-loc-str = substitute('&1/&2/&3 &4:&5'
      799                             ,string(v-loc-day,    '99':U)
      800                             ,string(v-loc-month,  '99':U)
      801                             ,string(v-loc-year,   '9999':U)
      802                             ,string(v-loc-hour,   '99':U)
      803                             ,string(v-loc-minute, '99':U)
      804                             )
      805     .
      806     return v-loc-str .
      807   end function .
