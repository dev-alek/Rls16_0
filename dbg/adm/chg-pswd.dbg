      845   function get-user-login returns character
      846     ( p-user-id as character ) :
      847     define variable v-user-login as character no-undo .
      848     run procedure-get-user-login in this-procedure (
      849         input p-user-id
      850       , output v-user-login
      851     ) .
      852     return v-user-login .
      853   end function.
      854   procedure procedure-get-user-login :
      855   define input  parameter p-user-id    as character no-undo .
      856   define output parameter p-user-login as character no-undo .
      857       define buffer buf_user-login for ub.user-login .
      858   do
      859   for buf_user-login
      860   on error undo, return error return-value
      861   :
      862       assign
      863           p-user-login = "":U
      864       .
      865       for each buf_user-login no-lock
      866          where buf_user-login.user-id = p-user-id
      867       by buf_user-login.db-num
      868       :
      869           assign
      870               p-user-login = substitute( "&1&2&3"
      871                                   , p-user-login
      872                                   , ( if p-user-login = "":U then "":U else ",":U )
      873                                   , buf_user-login.db-num )
      874           .
      875       end.
      876   end.
      877   end procedure.
      878   procedure SetAttrUserId:
      879      define input  parameter iDb-num      as integer   no-undo.
      880      define input  parameter iUserId      as character no-undo.
      881      define input  parameter iAttrCode    as character no-undo.
      882      define input  parameter iAttrValue   as character no-undo.
      883      define buffer user-login-attr  for ub.user-login-attr .
      884      find first user-login-attr where user-login-attr.db-num    eq idb-num
      885                                   and user-login-attr.user-id   eq iuserid
      886                                   and user-login-attr.attr-code eq iAttrCode
      887      exclusive-lock no-error.
      888      if     not available user-login-attr
      889         and iAttrValue ne ?
      890      then do:
      891         create user-login-attr.
      892         assign
      893            user-login-attr.db-num     = idb-num
      894            user-login-attr.user-id    = iuserid
      895            user-login-attr.attr-code  = iAttrCode
      896         .
      897      end.
      898      if iAttrValue eq ?
      899      then do:
      900         if available ub.user-login-attr
      901         then
      902            delete ub.user-login-attr.
      903      end.
      904      else
      905         user-login-attr.attr-value = iAttrValue.
      906   end procedure.
      907   function GetAttrUserId returns character (
      908      input iDb-num      as integer  ,
      909      input iUserId      as character,
      910      input iAttrCode    as character):
      911      define buffer user-login-attr  for ub.user-login-attr .
      912      find first user-login-attr where user-login-attr.db-num    eq idb-num
      913                                   and user-login-attr.user-id   eq iuserid
      914                                   and user-login-attr.attr-code eq iAttrCode
      915      no-lock no-error.
      916      return if not available ub.user-login-attr then ? else ub.user-login-attr.attr-value.
      917   end function.
      918   procedure getAccountSetting :
      919      define input  parameter i-user-id  as character no-undo.
      920      define output parameter o-adm-Ubd  as logical no-undo init ?.
      921      define output parameter v-adm-GBD  as logical no-undo.
      922      define output parameter o-superAdm as logical no-undo.
      923      define input-output parameter table for UserDbAdm .
      924      define variable v-adm-Ubd-int as integer no-undo.
      925      define buffer user-login for ub.user-login.
      926      define buffer db         for ub.db.
      927      define buffer user-account-attr for ub.user-account-attr.
      928      find first user-login where user-login.db-num  eq 0
      929                              and user-login.user-id eq i-user-id
      930      no-lock no-error.
      931      if available user-login
      932      then
      933         v-adm-gbd = user-login.user-administrator.
      934      else
      935         v-adm-gbd = ?.
      936      for each userDbAdm:
      937         delete userDbAdm.
      938      end.
      939      block-db:
      940      for each db where db.db-num ne 0 no-lock:
      941         if G#db-num ne 0
      942            and G#db-num ne db.db-num
      943         then
      944            next block-db.
      945         create UserDbAdm.
      946         UserDbAdm.db-num = ub.db.db-num.
      947         find first user-login where user-login.db-num  eq db.db-num
      948                                 and user-login.user-id eq i-user-id
      949         no-lock no-error.
      950         if not available user-login
      951         then
      952            v-adm-Ubd-int = 2.
      953         else if user-login.status_ eq 1
      954         then do:
      955            v-adm-Ubd-int = 2.
      956             UserDbAdm.db-block = yes.
      957             UserDbAdm.db-usr   = yes.
      958         end.
      959         else if user-login.user-administrator
      960         then do:
      961            UserDbAdm.db-adm = yes.
      962            UserDbAdm.db-usr = yes.
      963            if v-adm-Ubd-int eq 0
      964            then
      965               v-adm-Ubd-int = 1.
      966            else if v-adm-Ubd-int eq 3
      967            then do:
      968               v-adm-Ubd-int = 2.
      969            end.
      970         end.
      971         else do:
      972            if available ub.user-login
      973            then
      974               UserDbAdm.db-usr = yes.
      975            if v-adm-Ubd-int eq 0
      976            then
      977               v-adm-Ubd-int = 3.
      978            else if v-adm-Ubd-int eq 1
      979            then do:
      980               v-adm-Ubd-int = 2.
      981            end.
      982         end.
      983      end.
      984      if  v-adm-Ubd-int eq 1
      985      then
      986         o-adm-Ubd = true.
      987      else if v-adm-Ubd-int eq 3
      988      then
      989         o-adm-Ubd = false.
      990      find first user-account-attr where user-account-attr.user-id  eq i-user-id
      991                                     and user-account-attr.attr-code  eq "superADm"
      992      no-lock no-error.
      993      o-superAdm =  available user-account-attr and logical (user-account-attr.attr-value ) no-error.
      994   end.
      995   function check_alphanumeric returns character (
      996   input ipwd as character ,
      997   input itype as character ):
      998      define variable vCharEng as character no-undo
      999      init "abcdefghijklmnopqrstuvwxyz".
     1000      define variable vCharRus as character no-undo
     1001      init "йцукенгшщзхъфывапролджэячсмитьбюёЙЦУКЕНГШЩЗХЪФЫВАПРОЛДЖЯЧСМИТЬБЮЁЭ".
     1002      define variable vi as integer no-undo.
     1003      define variable vdigitFl as logical no-undo.
     1004      define variable vCharEngFl as logical no-undo.
     1005      define variable vCharRusFl as logical no-undo.
     1006      define variable vCharSpeFl as logical no-undo.
     1007      define variable vTextNew as character no-undo.
     1008      define variable vTextOld as character no-undo.
     1009      vTextNew = ipwd.
     1010      vTextOld = vTextNew.
     1011      do vi = 0 to 9:
     1012         vTextNew = replace(vTextNew,string (vi),"").
     1013      end.
     1014      if length(vTextOld) ne length(vTextNew)
     1015      then
     1016         vdigitFL = yes.
     1017      vTextOld = vTextNew.
     1018      do vi = 1 to length(vCharEng):
     1019         vTextNew = replace(vtextNew,substring(vCharEng,vi,1),"").
     1020      end.
     1021      if length(vTextOld) ne length(vTextNew)
     1022      then
     1023         vCharEngFl = yes.
     1024      vTextOld = vTextNew.
     1025      do vi = 1 to length(vCharRus):
     1026         vTextNew = replace(vtextNew,substring(vCharRus,vi,1),"").
     1027      end.
     1028      if length(vTextOld) ne length(vTextNew)
     1029      then
     1030         vCharEngFl = yes.
     1031      if length(vTextNew) > 0
     1032      then
     1033         vCharSpeFl = yes.
     1034      define variable vReturn as character no-undo.
     1035      assign
     1036         vReturn = vReturn + ", " + "не содержит цифр"           when lookup ("digit",   itype) > 0 and not vdigitFl
     1037         vReturn = vReturn + ", " + "не содержит латинских букв" when lookup ("CharEng", itype) > 0 and not vCharEngFl
     1038         vReturn = vReturn + ", " + "не содержит русских букв"   when lookup ("CharRus", itype) > 0 and not vCharRusFl
     1039         vReturn = vReturn + ", " + "не содержит спец символов"  when lookup ("CharSpe", itype) > 0 and not vCharSpeFl
     1040         vReturn = vReturn + ", " + "не содержит символов"       when lookup ("Char",    itype) > 0 and not (vCharEngFl or vCharRusFl or vCharSpeFl)
     1041      .
     1042      vReturn = substring (vReturn,3) no-error.
     1043      return vReturn.
     1044   end.
     1045   procedure SaveLastPWD:
     1046      define input  parameter iDb-num as integer   no-undo.
     1047      define input  parameter iUserId as character no-undo.
     1048      define input  parameter IPWD    as character no-undo.
     1049      define buffer user-login-attr  for ub.user-login-attr .
     1050      find first user-login-attr where user-login-attr.db-num    eq idb-num
     1051                                   and user-login-attr.user-id   eq iuserid
     1052                                   and user-login-attr.attr-code eq "LastPWD"
     1053      exclusive-lock no-error.
     1054      if not available user-login-attr
     1055      then do:
     1056         create user-login-attr.
     1057         assign
     1058            user-login-attr.db-num     = idb-num
     1059            user-login-attr.user-id    = iuserid
     1060            user-login-attr.attr-code  = "LastPWD"
     1061            user-login-attr.attr-value = ipwd
     1062         .
     1063      end.
     1064      else do:
     1065         user-login-attr.attr-value = user-login.user-password-encoded + chr(5) + user-login-attr.attr-value .
     1066         if num-entries (user-login-attr.attr-value , chr(5)) > 50
     1067         then
     1068            user-login-attr.attr-value = substring (user-login-attr.attr-value,1,r-index(user-login-attr.attr-value, chr(5)) - 1).
     1069      end.
     1070   end procedure.
     1071   function  CheckLastPWD returns character  (
     1072      input  iDb-num    as integer  ,
     1073      input  iUserId    as character,
     1074      input  IPWD       as character,
     1075      input  Iadm       as logical ) :
     1076      define buffer user-login       for ub.user-login .
     1077      define buffer user-login-attr  for ub.user-login-attr .
     1078      define variable vError as character  no-undo.
     1079      define variable v-obyznumbukv as logical no-undo .
     1080      define variable v-minparol as integer no-undo .
     1081      define variable v-tth as handle no-undo .
     1082      define variable VadmSuff as character no-undo.
     1083      define variable v-param-type as character no-undo .
     1084      define variable v-value-character as character no-undo .
     1085      define variable v-value-date as date no-undo .
     1086      define variable v-value-decimal as decimal no-undo .
     1087      define variable v-value-integer as integer no-undo .
     1088      define variable v-value-logical as logical no-undo .
     1089      find first user-login where user-login.db-num    eq idb-num
     1090                              and user-login.user-id   eq iUserId
     1091      no-lock no-error.
     1092      if Iadm
     1093      then
     1094         VadmSuff = 'Adm':U.
     1095      run adm/shattri.p (
     1096           input "get":U
     1097           ,input  '':U
     1098           ,input  0
     1099           ,input  'staff':U
     1100           ,input  'minparol':U + VadmSuff
     1101           ,output v-value-character
     1102           ,output v-value-date
     1103           ,output v-value-decimal
     1104           ,output v-minparol
     1105           ,output v-value-logical
     1106           ,output v-param-type
     1107           ,input-output table-handle v-tth
     1108           )  .
     1109       if v-minparol <> 0  then do:
     1110          if length(ipwd) < v-minparol
     1111           then do:
     1112              vError = substitute ("Длина поля должна быть не менее &1" , v-minparol).
     1113           end.
     1114       end.
     1115       run adm/shattri.p (
     1116           input "get":U
     1117           ,input  '':U
     1118           ,input  0
     1119           ,input  'staff':U
     1120           ,input  'obyznumbukv':U + VadmSuff
     1121           ,output v-value-character
     1122           ,output v-value-date
     1123           ,output v-value-decimal
     1124           ,output v-value-integer
     1125           ,output v-obyznumbukv
     1126           ,output v-param-type
     1127           ,input-output table-handle v-tth
     1128           )  .
     1129      if v-obyznumbukv = true
     1130      then do:
     1131         if check_alphanumeric(ipwd,"Digit,Char") ne ""
     1132         then do:
     1133            vError = vError + (if vError eq "" then "" else ", " )
     1134                   + "В пароле должны содержаться буквы и цифры".
     1135         end.
     1136      end.
     1137      define variable v-encode-value as character no-undo.
     1138      define variable v-Lastpaswd    as integer no-undo.
     1139      run adm/pswd-enc.p
     1140         (input  encode(ipwd)
     1141         ,output v-encode-value
     1142         ).
     1143      v-encode-value = encode(v-encode-value).
     1144      run adm/shattri.p (
     1145           input "get":U
     1146           ,input  '':U
     1147           ,input  0
     1148           ,input  'staff':U
     1149           ,input  'LastPaswd':U + VadmSuff
     1150           ,output v-value-character
     1151           ,output v-value-date
     1152           ,output v-value-decimal
     1153           ,output v-Lastpaswd
     1154           ,output v-value-logical
     1155           ,output v-param-type
     1156           ,input-output table-handle v-tth
     1157           )  .
     1158      if v-Lastpaswd ne 0
     1159      then do:
     1160         define variable vLastPwd as character no-undo.
     1161         vLastPwd = GetAttrUserId(iDb-num, iUserId, "LastPWD").
     1162         if vLastPwd ne ?
     1163         then do:
     1164            define variable Vi as integer no-undo.
     1165            vi = lookup (v-encode-value,vLastPwd,chr(5)).
     1166            if     vi ne 0
     1167               and vi le v-Lastpaswd
     1168            then
     1169               vError = vError + (if vError eq "" then "" else ", " )
     1170                      + substitute ("пароль не должен совпадать с последими &1 паролями",v-Lastpaswd).
     1171         end.
     1172      end.
     1173      delete object v-tth.
     1174      return vError.
     1175   end function.
     1176   procedure availOneAdm:
     1177      define input-output parameter table for UserDbAdm.
     1178      define output parameter oAdm as logical no-undo.
     1179      find first UserDbAdm where UserDbAdm.db-adm no-lock no-error.
     1180      oadm = available UserDbAdm.
     1181   end.
     1182   procedure update-user-login:
     1183      define input  parameter i-db-num     as integer          no-undo.
     1184      define input  parameter i-user-id    as character        no-undo.
     1185      define input  parameter i-user-login as character no-undo.
     1186      define input  parameter i-max-discnt as decimal no-undo.
     1187      define input  parameter i-quest-print as logical no-undo.
     1188      define input  parameter i-encoded-pass as character no-undo.
     1189      define input  parameter i-nextcon as logical no-undo.
     1190      define input  parameter i-user-administrator as logical no-undo.
     1191      define input  parameter i-Manual     as logical no-undo.
     1192      define input  parameter i-adm-gbd as logical no-undo.
     1193      define input  parameter i-adm-ubd as logical no-undo.
     1194      define input-output parameter table for UserDbAdm.
     1195      define buffer buf_user-login        for user-login.
     1196      do
     1197   for buf_user-login
     1198   on error undo, return error
     1199   :
     1200           if     i-Manual
     1201              and G#db-num eq 0
     1202           then do:
     1203              if     i-adm-gbd ne ?
     1204              then do:
     1205                 do transaction
     1206                 on error undo, return error return-value
     1207                 :
     1208                     find first buf_user-login where buf_user-login.db-num             eq 0
     1209                                                 and buf_user-login.user-login         eq i-user-login
     1210                                                 and buf_user-login.status_            eq 0
     1211                                                 and buf_user-login.user-id            ne i-user-id
     1212                     no-lock no-error.
     1213                     if available buf_user-login
     1214                     then
     1215                        undo, return error "Уже есть такой логин в ГБД".
     1216                     find first buf_user-login where buf_user-login.db-num             = 0
     1217                                                 and buf_user-login.user-id            = i-user-id
     1218                     exclusive-lock no-error.
     1219                     if not available buf_user-login
     1220                     then do:
     1221                        create buf_user-login .
     1222                        assign
     1223                            buf_user-login.db-num             = 0
     1224                            buf_user-login.user-id            = i-user-id
     1225                            buf_user-login.status_            = 0
     1226                        .
     1227                     end.
     1228                     assign
     1229                         buf_user-login.user-login         = i-user-login
     1230                         buf_user-login.user-administrator = i-adm-gbd
     1231                         buf_user-login.max-discnt         = i-max-discnt
     1232                         buf_user-login.quest-print        = i-quest-print
     1233                         buf_user-login.user-password-encoded = i-encoded-pass
     1234                     .
     1235                     if i-nextcon ne ?
     1236                     then do:
     1237                        run SetAttrUserId(buf_user-login.db-num, buf_user-login.user-id, "ChangPwdNextConect", string(i-nextcon )).
     1238                     end.
     1239                     run addobj(buf_user-login.db-num,buf_user-login.user-id) no-error.
     1240                     if error-status:error
     1241                     then
     1242                        return error return-value.
     1243                 end.
     1244              end.
     1245              else do transaction on error undo, return error return-value:
     1246                  find first buf_user-login where buf_user-login.db-num             = 0
     1247                                              and buf_user-login.user-id            = i-user-id
     1248                  exclusive-lock no-error.
     1249                  if available buf_user-login
     1250                  then
     1251                     delete buf_user-login.
     1252              end.
     1253              if     i-adm-ubd ne ?
     1254              then do:
     1255                 do transaction
     1256                 on error undo, return error return-value
     1257                 :
     1258                     define variable vDbError as character no-undo.
     1259                     block-db:
     1260                     for each db where db.db-num ne 0
     1261                     no-lock:
     1262                        find first buf_user-login where buf_user-login.db-num             eq db.db-num
     1263                                                    and buf_user-login.user-login         eq i-user-login
     1264                                                    and buf_user-login.status_            eq 0
     1265                                                    and buf_user-login.user-id            ne i-user-id
     1266                        no-lock no-error.
     1267                        if available buf_user-login
     1268                        then do:
     1269                           vDbError = vDbError + "," + String(db.db-num) no-error.
     1270                           next block-db.
     1271                        end.
     1272                        find first buf_user-login where buf_user-login.db-num             = db.db-num
     1273                                                    and buf_user-login.user-id            = i-user-id
     1274                        exclusive-lock no-error.
     1275                        if not available buf_user-login
     1276                        then do:
     1277                           create buf_user-login .
     1278                           assign
     1279                               buf_user-login.db-num             = db.db-num
     1280                               buf_user-login.user-id            = i-user-id
     1281                               buf_user-login.status_            = 0
     1282                               buf_user-login.user-password-encoded = i-encoded-pass
     1283                           .
     1284                        end.
     1285                        assign
     1286                            buf_user-login.status_            = 0 when i-db-num ne G#db-num
     1287                            buf_user-login.user-login         = i-user-login
     1288                            buf_user-login.user-administrator = i-adm-ubd
     1289                            buf_user-login.max-discnt         = i-max-discnt
     1290                            buf_user-login.quest-print        = i-quest-print
     1291                        .
     1292                        if i-nextcon ne ?
     1293                        then do:
     1294                           run SetAttrUserId(buf_user-login.db-num, buf_user-login.user-id, "ChangPwdNextConect", string(i-nextcon )).
     1295                        end.
     1296                        run addobj(buf_user-login.db-num,buf_user-login.user-id)no-error.
     1297                        if error-status:error
     1298                        then
     1299                           return error return-value.
     1300                    end.
     1301                    if vDbError ne ""
     1302                    then
     1303                       undo, return error substitute ("Уже есть такой логин в УБД &1",substring (vDbError,2,4000)).
     1304                 end.
     1305              end.
     1306              else do:
     1307                 do transaction
     1308                 on error undo, return error return-value
     1309                 :
     1310                     block-UserDb:
     1311                     for each UserDbAdm where UserDbAdm.db-num ne 0
     1312                     no-lock:
     1313                        find first buf_user-login where buf_user-login.db-num             eq UserDbAdm.db-num
     1314                                                    and buf_user-login.user-login         eq i-user-login
     1315                                                    and buf_user-login.status_            eq 0
     1316                                                    and buf_user-login.user-id            ne i-user-id
     1317                        no-lock no-error.
     1318                        if available buf_user-login and UserDbAdm.db-usr
     1319                        then do:
     1320                           vDbError = vDbError + "," + String(db.db-num) no-error.
     1321                           next block-UserDb.
     1322                        end.
     1323                        find first buf_user-login where buf_user-login.db-num             = UserDbAdm.db-num
     1324                                                    and buf_user-login.user-id            = i-user-id
     1325                        exclusive-lock no-error.
     1326                        if UserDbAdm.db-usr
     1327                        then do:
     1328                           if not available buf_user-login
     1329                           then do:
     1330                              create buf_user-login .
     1331                              assign
     1332                                  buf_user-login.db-num             = UserDbAdm.db-num
     1333                                  buf_user-login.user-id            = i-user-id
     1334                                  buf_user-login.status_            = if UserDbAdm.db-block then 1 else 0
     1335                                  buf_user-login.user-password-encoded = i-encoded-pass
     1336                              .
     1337                           end.
     1338                           assign
     1339                               buf_user-login.status_            = if UserDbAdm.db-block then 1 else 0 when i-db-num ne G#db-num or G#db-num = 0
     1340                               buf_user-login.user-login         = i-user-login
     1341                               buf_user-login.user-administrator = UserDbAdm.db-adm
     1342                               buf_user-login.max-discnt         = i-max-discnt
     1343                               buf_user-login.quest-print        = i-quest-print
     1344                           .
     1345                           if i-nextcon ne ?
     1346                           then do:
     1347                              run SetAttrUserId(buf_user-login.db-num, buf_user-login.user-id, "ChangPwdNextConect", string(i-nextcon )).
     1348                           end.
     1349                           if UserDbAdm.db-adm
     1350                           then do:
     1351                              run addobj(buf_user-login.db-num,buf_user-login.user-id)no-error.
     1352                              if error-status:error
     1353                              then
     1354                                 undo, return error return-value.
     1355                           end.
     1356                       end.
     1357                       else do:
     1358                          if available buf_user-login
     1359                          then do:
     1360                             define variable vok as logical no-undo.
     1361                             run procedure-user-login-delete-question (UserDbAdm.db-num,i-user-id, no, output vok).
     1362                             if not vok
     1363                             then
     1364                                undo, return error return-value.
     1365                          end.
     1366                       end.
     1367                    end.
     1368                     if vDbError ne ""
     1369                     then
     1370                       undo, return error substitute ("Уже есть такой логин в УБД &1",substring (vDbError,2,4000)).
     1371                 end.
     1372              end.
     1373           end.
     1374           else do transaction
     1375           on error undo, return error return-value
     1376           :
     1377              find first buf_user-login where buf_user-login.db-num             = i-db-num
     1378                                          and buf_user-login.user-id            = i-user-id
     1379              exclusive-lock no-error.
     1380              if not available buf_user-login
     1381              then do:
     1382                 create buf_user-login .
     1383                 assign
     1384                    buf_user-login.db-num             = i-db-num
     1385                    buf_user-login.user-id            = i-user-id
     1386                    buf_user-login.status_            = 0
     1387                 .
     1388              end.
     1389              assign
     1390                   buf_user-login.user-login         = i-user-login
     1391                   buf_user-login.user-administrator = i-user-administrator
     1392                   buf_user-login.max-discnt         = i-max-discnt
     1393                   buf_user-login.quest-print        = i-quest-print
     1394                   buf_user-login.user-password-encoded = i-encoded-pass
     1395               .
     1396               if i-user-administrator
     1397               then
     1398                  run addobj(buf_user-login.db-num,buf_user-login.user-id).
     1399               if i-nextcon ne ?
     1400               then do:
     1401                  run SetAttrUserId(buf_user-login.db-num, buf_user-login.user-id, "ChangPwdNextConect", string(i-nextcon )).
     1402               end.
     1403           end.
     1404       end.
     1405   end procedure.
     1406   procedure addobj:
     1407      define input  parameter i-db-num as integer no-undo.
     1408      define input  parameter i-user-id as character no-undo.
     1409      define buffer buf_user-obj     for ub.user-obj.
     1410      define buffer buf_clients      for ub.clients.
     1411      if i-db-num <> 0 then do:
     1412          for each buf_clients
     1413              where buf_clients.db-num = i-db-num
     1414              and ( buf_clients.obj-type = 'маг':U
     1415                 or buf_clients.obj-type = 'скл':U
     1416                  )
     1417              no-lock:
     1418             if can-find (buf_user-obj where buf_user-obj.obj-type = buf_clients.obj-type
     1419                                     and buf_user-obj.obj-code     = buf_clients.obj-code
     1420                                     and buf_user-obj.user-id      = i-user-id
     1421                                     and buf_user-obj.db-num       = i-db-num
     1422                                   no-lock)
     1423                                   then next.
     1424             run enbl-obj (i-db-num, i-user-id, buf_clients.obj-type, buf_clients.obj-code).
     1425          end.
     1426       end.
     1427       else do:
     1428          for each buf_clients
     1429              where
     1430                  ( buf_clients.obj-type = 'маг':U
     1431                 or buf_clients.obj-type = 'скл':U
     1432                  )
     1433              no-lock:
     1434             if can-find (buf_user-obj where buf_user-obj.obj-type = buf_clients.obj-type
     1435                                     and buf_user-obj.obj-code     = buf_clients.obj-code
     1436                                     and buf_user-obj.user-id      = i-user-id
     1437                                     and buf_user-obj.db-num       = i-db-num
     1438                                   no-lock)
     1439                                   then next.
     1440             run enbl-obj (i-db-num, i-user-id, buf_clients.obj-type, buf_clients.obj-code).
     1441          end.
     1442       end.
     1443   end.
     1444   procedure enbl-obj :
     1445      define input  parameter i-db-num  as integer   no-undo.
     1446      define input  parameter i-user-id as character no-undo.
     1447      define input  parameter i-type    as character no-undo.
     1448      define input  parameter i-code    as integer   no-undo.
     1449       define variable v-host-code    as integer      no-undo.
     1450       define variable v-host-name    as character    no-undo.
     1451       define variable v-base-code    as integer      no-undo.
     1452       define buffer buf_user-obj      for ub.user-obj.
     1453       define buffer buf_user-host     for ub.user-host.
     1454       define buffer buf_clients       for ub.clients.
     1455   do
     1456   for buf_user-obj
     1457     , buf_user-host
     1458     , buf_clients
     1459   on error undo, return error
     1460   :
     1461       find first buf_user-obj exclusive-lock
     1462            where buf_user-obj.db-num    = i-db-num
     1463              and buf_user-obj.user-id   = i-user-id
     1464              and buf_user-obj.obj-type  = i-type
     1465              and buf_user-obj.obj-code  = i-code
     1466       no-error.
     1467       if not available buf_user-obj
     1468       then do:
     1469           find first buf_clients no-lock
     1470                where buf_clients.obj-type = i-type
     1471                  and buf_clients.obj-code = i-code
     1472           .
     1473   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1474   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     1475     (input  i-type
     1476     ,input  i-code
     1477     ,output v-host-code
     1478     ,output v-host-name
     1479     )  .
     1480   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1481   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1482     (input  v-host-code
     1483     ,output v-base-code
     1484     )  .
     1485           create buf_user-obj.
     1486           assign
     1487               buf_user-obj.db-num    = i-db-num
     1488               buf_user-obj.user-id   = i-user-id
     1489               buf_user-obj.obj-type  = i-type
     1490               buf_user-obj.obj-code  = i-code
     1491               buf_user-obj.host-code = v-host-code
     1492           .
     1493           find first buf_user-host exclusive-lock
     1494                where buf_user-host.db-num    = i-db-num
     1495                  and buf_user-host.user-id   = i-user-id
     1496                  and buf_user-host.host-code = v-host-code
     1497           no-error.
     1498           if not available buf_user-host
     1499           then do:
     1500               create buf_user-host.
     1501               assign
     1502                   buf_user-host.db-num    = i-db-num
     1503                   buf_user-host.user-id   = i-user-id
     1504                   buf_user-host.host-code = v-host-code
     1505               .
     1506           end.
     1507      end.
     1508   end.
     1509   end procedure.
     1510   procedure procedure-user-login-change-password :
     1511      define input  parameter p-db-num         as integer          no-undo.
     1512      define input  parameter p-user-id        as character        no-undo.
     1513      define input  parameter iChange          as logical          no-undo.
     1514      define variable v-can-edit         as logical   no-undo .
     1515      define variable v-encoded-pass     as character no-undo .
     1516      define variable v-encoded-pass-old as character no-undo .
     1517      define variable v-nextcon          as logical   no-undo .
     1518      define variable VadmSuff           as character no-undo.
     1519      define variable vChange as logical no-undo.
     1520      define variable v-param-type as character no-undo .
     1521      define variable v-value-character as character no-undo .
     1522      define variable v-value-date as date no-undo .
     1523      define variable v-value-decimal as decimal no-undo .
     1524      define variable v-value-integer as integer no-undo .
     1525      define variable v-value-logical as logical no-undo .
     1526      define variable v-tth           as handle  no-undo .
     1527      define buffer buf_lock_user-login for user-login.
     1528      define buffer buf_init_user-account for user-account.
     1529      do:
     1530         find first buf_lock_user-login no-lock
     1531                 where buf_lock_user-login.db-num  = p-db-num
     1532                   and buf_lock_user-login.user-id = p-user-id
     1533         no-error.
     1534         if not available buf_lock_user-login then do:
     1535            message
     1536               "Нельзя редактировать пароль пока не заведен логин для пользователя" skip
     1537               view-as alert-box error .
     1538               undo, return error "Нельзя редактировать пароль пока не заведен логин для пользователя" .
     1539         end.
     1540         vChange = buf_lock_user-login.user-login eq userid ("ub") or iChange.
     1541         if     available buf_lock_user-login
     1542            and buf_lock_user-login.user-administrator
     1543         then
     1544            VadmSuff = 'Adm':U.
     1545         define variable v-TimeAvail as integer no-undo.
     1546         define variable v-DateChg   as date    no-undo.
     1547         define variable v-Time      as integer no-undo.
     1548         run cur-time-mjd-to-date (buf_lock_user-login.user-password-set-mjd, output v-DateChg, output v-Time).
     1549         run adm/shattri.p (
     1550              input "get":U
     1551              ,input  '':U
     1552              ,input  0
     1553              ,input  'staff':U
     1554              ,input  'TimeBlock':U + VadmSuff
     1555              ,output v-value-character
     1556              ,output v-value-date
     1557              ,output v-value-decimal
     1558              ,output v-TimeAvail
     1559              ,output v-value-logical
     1560              ,output v-param-type
     1561              ,input-output table-handle v-tth
     1562              )  .
     1563         if     not iChange
     1564            and v-TimeAvail ne 0
     1565            and v-DateChg + v-TimeAvail < today
     1566         then do:
     1567            do trans:
     1568               find current buf_lock_user-login exclusive-lock.
     1569               buf_lock_user-login.status_ = 1.
     1570            end.
     1571            return error "Ваша учетная запись заблокирована." .
     1572         end.
     1573         run adm/shattri.p (
     1574              input "get":U
     1575              ,input  '':U
     1576              ,input  0
     1577              ,input  'staff':U
     1578              ,input  'TimeAvail':U + VadmSuff
     1579              ,output v-value-character
     1580              ,output v-value-date
     1581              ,output v-value-decimal
     1582              ,output v-TimeAvail
     1583              ,output v-value-logical
     1584              ,output v-param-type
     1585              ,input-output table-handle v-tth
     1586              )  .
     1587         delete object v-tth.
     1588         define variable vfl as logical no-undo.
     1589         vfl = logical(GetAttrUserId(buf_lock_user-login.db-num, buf_lock_user-login.user-id, "ChangPwdNextConect")) no-error.
     1590         if    vfl eq yes
     1591            or (     v-TimeAvail ne 0
     1592                 and v-DateChg + v-TimeAvail < today)
     1593            or iChange
     1594         then do:
     1595             find first buf_init_user-account where buf_init_user-account.user-id = buf_lock_user-login.user-id
     1596             no-lock.
     1597             assign
     1598             v-encoded-pass-old = buf_lock_user-login.user-password-encoded
     1599             v-encoded-pass     = buf_lock_user-login.user-password-encoded.
     1600             do while v-encoded-pass = v-encoded-pass-old or v-encoded-pass eq ?:
     1601                v-encoded-pass = v-encoded-pass-old.
     1602                run adm/chg-pswd.w ( input  this-procedure
     1603                                   , input  p-db-num
     1604                                   , input  buf_lock_user-login.user-id
     1605                                   , input  buf_lock_user-login.user-login
     1606                                   , input  substitute('&1 &2 &3':U, buf_init_user-account.last-name
     1607                                                                   , buf_init_user-account.first-name
     1608                                                                   , buf_init_user-account.second-name
     1609                                          )
     1610                                   , input  iChange
     1611                                   , input  yes
     1612                                   , input  buf_lock_user-login.user-password-encoded
     1613                                   , input  yes
     1614                                   , input  buf_lock_user-login.user-administrator
     1615                                   , output v-encoded-pass
     1616                                   , output v-nextcon
     1617                                   ) no-error .
     1618               if error-status :error
     1619               then do:
     1620                 message
     1621                    vss-workfile vss-revision vss-description skip
     1622                    "Ошибка при вызове процедуры" 'adm/chg-pswd.w':U skip
     1623                    error-status :get-message(1) skip
     1624                    return-value skip
     1625                    view-as alert-box error .
     1626                 undo, return error return-value .
     1627                end.
     1628                if    v-encoded-pass = v-encoded-pass-old
     1629                then do:
     1630                    message
     1631                       vss-workfile vss-revision vss-description skip
     1632                       "Старый пароль и новый равны. Смените пароль.":U skip
     1633                       error-status :get-message(1) skip
     1634                       return-value skip
     1635                       view-as alert-box error .
     1636                end.
     1637                else if v-encoded-pass eq ?
     1638                then do:
     1639                   message  "Отказ от смены пароля. Работа дальше не возможна"
     1640                   view-as alert-box error.
     1641                   return error "Отказ от смены пароля. Работа дальше не возможна".
     1642                end.
     1643             end.
     1644             if v-encoded-pass <> ? then
     1645             do trans:
     1646                find current buf_lock_user-login
     1647                      exclusive-lock
     1648                   .
     1649                assign
     1650                   buf_lock_user-login.user-password-encoded = v-encoded-pass
     1651                .
     1652                run SetAttrUserId(buf_lock_user-login.db-num, buf_lock_user-login.user-id, "ChangPwdNextConect", if vChange then v-nextcon else ?).
     1653                run SetAttrUserId(buf_lock_user-login.db-num, buf_lock_user-login.user-id, "ChangPwdUserId", string(g#userid)).
     1654                release buf_lock_user-login .
     1655                message
     1656                   "Пароль успешно изменен"
     1657                   view-as alert-box information
     1658                .
     1659             end.
     1660          end.
     1661      end.
     1662   end procedure.
     1663   procedure procedure-user-login-delete :
     1664      define input  parameter i-db-num     as integer          no-undo.
     1665      define input  parameter i-user-id    as character        no-undo.
     1666      define output parameter o-deleted   as logical          no-undo.
     1667      run procedure-user-login-delete-question (i-db-num,i-user-id,yes,output o-deleted).
     1668   end.
     1669   procedure procedure-user-login-delete-question :
     1670   define input  parameter i-db-num     as integer          no-undo.
     1671   define input  parameter i-user-id    as character        no-undo.
     1672   define input  parameter i-question as logical no-undo.
     1673   define output parameter o-deleted   as logical          no-undo.
     1674     define variable v-can-edit as logical   no-undo .
     1675       define buffer buf_user-login         for user-login .
     1676       define buffer buf_user-account       for user-account.
     1677       define buffer buf_init_user-account  for user-account.
     1678   do
     1679   for buf_user-login
     1680     , buf_user-account
     1681   on error undo, return error return-value
     1682   :
     1683       assign
     1684           o-deleted = no
     1685       .
     1686       find first buf_init_user-account no-lock
     1687            where buf_init_user-account.user-id = i-user-id
     1688           .
     1689       if available buf_init_user-account
     1690       then do:
     1691         do transaction
     1692         on error undo, return error return-value
     1693         :
     1694           run can-edit-login in this-procedure (
     1695                 input  i-db-num
     1696               , output v-can-edit
     1697           ).
     1698           if v-can-edit <> true
     1699           then do:
     1700             message
     1701               "Нельзя удалять логин пользователя для базы" i-db-num
     1702             view-as alert-box error .
     1703             undo, return error return-value .
     1704           end.
     1705           find first buf_user-login exclusive-lock
     1706                where buf_user-login.db-num  = i-db-num
     1707                  and buf_user-login.user-id = i-user-id
     1708           no-error no-wait.
     1709           if not available buf_user-login
     1710           then do:
     1711             if locked( buf_user-login )
     1712             then do:
     1713               find first buf_user-login no-lock
     1714                    where buf_user-login.db-num  = i-db-num
     1715                      and buf_user-login.user-id = i-user-id
     1716               .
     1717               message
     1718                 "Удаление логина невозможно" skip
     1719                 "Пользователь в данный момент работает в системе" skip
     1720                 "БД" i-db-num skip
     1721                 "Идентификатор" i-user-id skip
     1722                 "Псевдоним"                    buf_init_user-account.nik skip
     1723                 "Имя пользователя"             buf_init_user-account.last-name buf_init_user-account.first-name buf_init_user-account.second-name skip
     1724                 "Компьютер"                    buf_user-login.last-login-computer-name skip
     1725                 "Пользователь компьютера"      buf_user-login.last-login-computer-user skip
     1726                 "TCP имя компьютера"           buf_user-login.last-login-computer-tcp-name skip
     1727                 "IP адрес компьютера"          buf_user-login.last-login-computer-ip-addr skip
     1728                 "Идентификатор процесса"       buf_user-login.last-login-process-id skip
     1729                 "Номер подключения к БД"       buf_user-login.last-login-connection-id skip
     1730                 "Дата и время входа в систему" sys-time_mjd-to-loc-str-func( buf_user-login.last-login-mjd ) skip
     1731                 view-as alert-box error .
     1732             end.
     1733             else do:
     1734               message
     1735                 "У пользователя нет логина" skip
     1736                 "БД" i-db-num skip
     1737                 "Идентификатор" i-user-id skip
     1738                 "Удаление невозможно" skip
     1739                 view-as alert-box error .
     1740             end.
     1741             undo, return error return-value .
     1742           end.
     1743           define variable v-ok as logical   no-undo .
     1744           if not i-question
     1745           then
     1746              v-ok = yes.
     1747           else do:
     1748              find first buf_user-account no-lock
     1749                   where buf_user-account.user-id = buf_user-login.user-id
     1750              .
     1751              message
     1752                "Удаление логина пользователя"
     1753                skip "Идентификатор" buf_user-account.user-id
     1754                skip "Псевдоним"    buf_user-account.nik
     1755                skip "Пользователь" buf_user-account.last-name buf_user-account.first-name buf_user-account.second-name
     1756                skip "Логин для базы данных" buf_user-login.db-num
     1757                skip "Логин" buf_user-login.user-login
     1758                skip (1)
     1759                "После удаления пользователь не сможет работать в базе данных" buf_user-login.db-num skip
     1760                skip (1)
     1761                "Продолжить?"
     1762              view-as alert-box question
     1763              buttons yes-no
     1764              update v-ok .
     1765           end.
     1766           if v-ok = yes
     1767           then do:
     1768               run str/usrlog03.p (
     1769                     input buf_user-login.db-num
     1770                   , input buf_user-login.user-id
     1771               ).
     1772               assign
     1773                   o-deleted = yes
     1774               .
     1775           end.
     1776         end.
     1777       end.
     1778     end.
     1779   end procedure.
     1780   define variable v-param-type      as character no-undo .
     1781   define variable v-value-character AS character no-undo .
     1782   define variable v-value-date      as date      no-undo .
     1783   define variable v-value-decimal   as decimal   no-undo .
     1784   define variable v-value-integer   as INTEGER   no-undo .
     1785   define variable v-value-logical   as logical   no-undo .
     1786   define variable v-noanshftstaff   as logical   no-undo .
     1787   DEFINE BUTTON b-exit AUTO-GO
     1788      LABEL "&Ввод"
     1789      SIZE 10 BY 1
     1790      BGCOLOR 8 .
     1791   DEFINE BUTTON b-help
     1792      LABEL "Помо&щь"
     1793      SIZE 10 BY 1
     1794      BGCOLOR 8 .
     1795   DEFINE BUTTON b-quit AUTO-END-KEY
     1796      LABEL "&Отмена"
     1797      SIZE 10 BY 1
     1798      BGCOLOR 8 .
     1799   DEFINE VARIABLE fi-db             AS CHARACTER FORMAT "X(256)":U
     1800      LABEL "БД"
     1801      VIEW-AS TEXT
     1802      SIZE 40.6 BY .67
     1803      FGCOLOR 4 NO-UNDO.
     1804   DEFINE VARIABLE fi-new-password   AS CHARACTER FORMAT "X(16)":U
     1805      LABEL "Новый пароль"
     1806      VIEW-AS FILL-IN
     1807      SIZE 20.6 BY 1 NO-UNDO.
     1808   DEFINE VARIABLE fi-new-password-2 AS CHARACTER FORMAT "X(16)":U
     1809      LABEL "Подтверждение пароля"
     1810      VIEW-AS FILL-IN
     1811      SIZE 20.6 BY 1 NO-UNDO.
     1812   DEFINE VARIABLE fi-old-password   AS CHARACTER FORMAT "X(16)":U
     1813      LABEL "Старый пароль"
     1814      VIEW-AS FILL-IN
     1815      SIZE 20.6 BY 1 NO-UNDO.
     1816   DEFINE VARIABLE fi-userid         AS CHARACTER FORMAT "X(256)":U
     1817      LABEL "Идентификатор"
     1818      VIEW-AS TEXT
     1819      SIZE 40.6 BY .67
     1820      FGCOLOR 4 NO-UNDO.
     1821   DEFINE VARIABLE fi-username       AS CHARACTER FORMAT "X(256)":U
     1822      LABEL "Пользователь"
     1823      VIEW-AS TEXT
     1824      SIZE 40.6 BY .67
     1825      FGCOLOR 4 NO-UNDO.
     1826   DEFINE VARIABLE chgpwdextcon      AS LOGICAL   INITIAL yes
     1827      LABEL "Сменить пароль при следующем входе в систему"
     1828      VIEW-AS TOGGLE-BOX
     1829      SIZE 55.6 BY .81.
     1830   DEFINE FRAME Dialog-Frame
     1831      b-exit AT ROW 1 COL 1
     1832      b-quit AT ROW 1 COL 11
     1833      b-help AT ROW 1 COL 61
     1834      fi-old-password AT ROW 7.76 COL 22.6 COLON-ALIGNED WIDGET-ID 6 PASSWORD-FIELD
     1835      fi-new-password AT ROW 9.24 COL 22.6 COLON-ALIGNED WIDGET-ID 8 PASSWORD-FIELD
     1836      fi-new-password-2 AT ROW 10.52 COL 2.6 WIDGET-ID 10 PASSWORD-FIELD
     1837      chgpwdextcon AT ROW 11.76 COL 3 WIDGET-ID 14
     1838      fi-db AT ROW 3.24 COL 22.6 COLON-ALIGNED WIDGET-ID 12
     1839      fi-userid AT ROW 4.76 COL 22.6 COLON-ALIGNED WIDGET-ID 2
     1840      fi-username AT ROW 6.24 COL 22.6 COLON-ALIGNED WIDGET-ID 4
     1841      SPACE(7.79) SKIP(6.50)
     1842      WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1843      SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1844      TITLE "Изменение пароля"
     1845      DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit WIDGET-ID 100.
     1846   ASSIGN
     1847      FRAME Dialog-Frame:SCROLLABLE = FALSE
     1848      FRAME Dialog-Frame:HIDDEN     = TRUE.
     1849   ASSIGN
     1850      fi-old-password:HIDDEN IN FRAME Dialog-Frame = TRUE.
     1851   ON GO OF FRAME Dialog-Frame
     1852      DO:
     1853         run change-password in this-procedure no-error .
     1854         if error-status :error
     1855            then
     1856         do:
     1857            ASSIGN
     1858               p-password     = ?
     1859               ochgpdwnextcon = ?
     1860               .
     1861            return no-apply .
     1862         end.
     1863      END.
     1864   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1865      DO:
     1866         APPLY "END-ERROR":U TO SELF.
     1867      END.
     1868   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     1869      DO:
     1870         assign
     1871            p-password     = ?
     1872            ochgpdwnextcon = ?
     1873            .
     1874      END.
     1875   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1876      THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1877   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1878   on help of frame Dialog-Frame
     1879   do:
     1880     run gbl/app_help.p
     1881       (input this-procedure :file-name
     1882       ,input ''
     1883       ,input ?
     1884       ) no-error.
     1885     if error-status :error then do:
     1886       message
     1887         "Ошибка при вызове помощи"
     1888         error-status :get-message(1)
     1889         view-as alert-box .
     1890     end.
     1891   end.
     1892   run minbtn-set in this-procedure .
     1893   on choose of b-help in frame Dialog-Frame
     1894   do:
     1895     apply "help":u to frame Dialog-Frame .
     1896   end.
     1897   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1898   procedure minbtn-set :
     1899       do
     1900           on error undo, return error return-value
     1901           :
     1902           define variable ii              as integer       no-undo .
     1903           define variable fh              as widget-handle no-undo .
     1904           define variable hh              as widget-handle no-undo .
     1905           define variable v-h             as handle        extent 4 no-undo .
     1906           define variable v-name-button   as character     no-undo .
     1907           define variable v-help-old-x    as decimal       no-undo .
     1908           define variable v-help-old-y    as decimal       no-undo .
     1909           define variable v-help-old-size as decimal       no-undo .
     1910           define variable v-frame-width   as decimal       no-undo .
     1911           define variable jj              as integer       no-undo .
     1912           do
     1913               on error undo, return error
     1914               :
     1915               assign
     1916                   v-frame-width = frame Dialog-Frame:width - 0.3
     1917                   fh            = frame Dialog-Frame:first-child
     1918                   hh            = fh:first-child
     1919                   ii            = 1
     1920                   .
     1921               do while valid-handle(hh):
     1922                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1923                   do:
     1924                       case lc(hh:name) :
     1925                           when "b-help" then
     1926                               do:
     1927                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1928                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1929                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1930                                   hh:TOOLTIP = "Помощь" .
     1931                                   v-help-old-x = hh:column .
     1932                                   v-help-old-y = hh:row    .
     1933                                   v-help-old-size = hh:width .
     1934                                   hh:width-chars = 2.5 .
     1935                               end.
     1936                           when "b-print" then
     1937                               do:
     1938                                   hh:load-image("cmp/b-print.bmp":u) .
     1939                                   hh:TOOLTIP = "Печать" .
     1940                                   v-h[ii] = hh:handle .
     1941                                   ii = ii + 1 .
     1942                                   hh:width-chars = 3 .
     1943                               end.
     1944                           when "b-history" or
     1945                           when "b-hist" then
     1946                               do:
     1947                                   hh:load-image("cmp/b-hist.bmp":u) .
     1948                                   hh:TOOLTIP = "История" .
     1949                                   v-h[ii] = hh:handle .
     1950                                   ii = ii + 1 .
     1951                                   hh:width-chars = 3 .
     1952                               end.
     1953                           when "b-sch" then
     1954                               do:
     1955                                   hh:load-image("cmp/b-sch.bmp":u) .
     1956                                   hh:TOOLTIP = "Установка Фильтра" .
     1957                                   v-h[ii] = hh:handle .
     1958                                   ii = ii + 1 .
     1959                                   hh:width-chars = 3 .
     1960                               end.
     1961                           when "b-hist-user" then
     1962                               do:
     1963                                   hh:load-image("cmp/b-hist.bmp":u) .
     1964                                   hh:TOOLTIP = "История пользователя" .
     1965                                   ii = ii + 1 .
     1966                               end.
     1967                       end case.
     1968                   end.
     1969                   hh = hh:next-sibling.
     1970               end.
     1971               b-help:column = v-frame-width - b-help:width-chars.
     1972               jj = 0.
     1973               repeat ii = 4 to 1 by -1 :
     1974                   if valid-handle (v-h[ii] ) then
     1975                   do:
     1976                       jj  = jj + 1 .
     1977                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1978                       v-h[ii]:row    = v-help-old-y .
     1979                   end.
     1980               end.
     1981           end.
     1982       end.
     1983   end procedure.
     1984   MAIN-BLOCK:
     1985   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1986      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1987      assign
     1988         fi-db       = STRING(p-db-num)
     1989         fi-userid   = p-user-login
     1990         fi-username = p-user-name
     1991         .
     1992      if p-LastPassVis ne no
     1993         then
     1994      do:
     1995         chgpwdextcon = no.
     1996         assign
     1997            fi-old-password :visible   = true
     1998            fi-old-password :sensitive = true
     1999            .
     2000      end.
     2001      RUN enable_UI.
     2002      run display-data in this-procedure .
     2003      if p-LastPassVis eq no
     2004         then
     2005      do:
     2006         apply 'entry':U to fi-old-password .
     2007      end.
     2008      else
     2009      do:
     2010         chgpwdextcon    :visible   = false.
     2011         apply 'entry':U to fi-new-password .
     2012      end.
     2013      WAIT-FOR GO OF FRAME Dialog-Frame.
     2014   END.
     2015   RUN disable_UI.
     2016   PROCEDURE change-password :
     2017      define variable v-encode-value as character no-undo .
     2018      do
     2019         on error undo, return error return-value
     2020         :
     2021         if p-LastPassVis ne no
     2022            then
     2023         do:
     2024            do with frame Dialog-Frame
     2025               :
     2026               assign
     2027                  fi-old-password
     2028                  .
     2029            end.
     2030            if fi-old-password = '':U
     2031               or fi-old-password = ?
     2032               then
     2033            do:
     2034               message
     2035                  "Необходимо ввести старое значение пароля"
     2036                  view-as alert-box information .
     2037               apply 'entry':U to fi-old-password .
     2038               undo, return error return-value .
     2039            end.
     2040            run adm/pswd-enc.p
     2041               (input  encode(fi-old-password)
     2042               ,output v-encode-value
     2043               ).
     2044            assign
     2045               v-encode-value = encode(v-encode-value)
     2046               .
     2047            if p-old-password <> v-encode-value
     2048               then
     2049            do:
     2050               message
     2051                  "Неправильное введено значение старого пароля" skip
     2052                  view-as alert-box error .
     2053               apply 'entry':U to fi-old-password .
     2054               undo, return error return-value .
     2055            end.
     2056         end.
     2057         do with frame Dialog-Frame
     2058            :
     2059            assign
     2060               fi-new-password
     2061               fi-new-password-2
     2062               .
     2063         end.
     2064         if fi-new-password = '':U
     2065            or fi-new-password = ?
     2066            then
     2067         do:
     2068            message
     2069               "Необходимо ввести новое значение пароля"
     2070               view-as alert-box information .
     2071            apply 'entry':U to fi-new-password .
     2072            undo, return error return-value .
     2073         end.
     2074         define variable vText as character no-undo.
     2075         vText = CheckLastPWD(p-db-num,p-user-id,fi-new-password,i-CheckAdm).
     2076         if vText ne ""
     2077            then
     2078         do:
     2079            message
     2080               vText
     2081               view-as alert-box information .
     2082            apply 'entry':U to fi-new-password .
     2083            undo, return error return-value .
     2084         end.
     2085         if fi-new-password-2 = '':U
     2086            or fi-new-password-2 = ?
     2087            then
     2088         do:
     2089            message
     2090               "Необходимо ввести значение пароля для проверки"
     2091               view-as alert-box information .
     2092            apply 'entry':U to fi-new-password-2 .
     2093            undo, return error return-value .
     2094         end.
     2095         if fi-new-password <> fi-new-password-2
     2096            then
     2097         do:
     2098            message
     2099               "Не совпадают значение нового пароля и значение пароля для проверки"
     2100               view-as alert-box error .
     2101            apply 'entry':U to fi-new-password .
     2102            undo, return error return-value .
     2103         end.
     2104         run adm/pswd-enc.p
     2105            (input  encode(fi-new-password)
     2106            ,output v-encode-value
     2107            ).
     2108         assign
     2109            chgpwdextcon
     2110            p-password     = encode(v-encode-value)
     2111            ochgpdwnextcon = chgpwdextcon
     2112            .
     2113      end.
     2114   END PROCEDURE.
     2115   PROCEDURE disable_UI :
     2116      HIDE FRAME Dialog-Frame.
     2117   END PROCEDURE.
     2118   PROCEDURE display-data :
     2119      define buffer buf_db for ub.db .
     2120      do
     2121         with frame Dialog-Frame
     2122         on error undo, return error return-value
     2123         :
     2124         display
     2125            fi-userid
     2126            fi-username
     2127            with frame Dialog-Frame .
     2128      end.
     2129   END PROCEDURE.
     2130   PROCEDURE enable_UI :
     2131      DISPLAY fi-new-password fi-new-password-2 chgpwdextcon fi-db fi-userid
     2132         fi-username
     2133         WITH FRAME Dialog-Frame.
     2134      ENABLE b-exit b-quit b-help fi-new-password fi-new-password-2 chgpwdextcon
     2135         fi-db fi-userid fi-username
     2136         WITH FRAME Dialog-Frame.
     2137      VIEW FRAME Dialog-Frame.
     2138   END PROCEDURE.
