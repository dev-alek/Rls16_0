        1   define new global shared variable g#language as character no-undo .
        2   if g#language <> '' and g#language <> 'rus':U then do:
        3     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        4   end.
        5   define variable v-updating      as logical   no-undo init false .
        6   DEFINE VAR w-login AS WIDGET-HANDLE NO-UNDO.
        7   DEFINE BUTTON b-OK AUTO-GO  NO-FOCUS
        8        LABEL "&Ввод":L
        9        SIZE 10 BY 1
       10        BGCOLOR 15 .
       11   DEFINE BUTTON b-quit AUTO-END-KEY  NO-FOCUS
       12        LABEL "&Отмена":L
       13        SIZE 10 BY 1.
       14   DEFINE VARIABLE f-dst AS CHARACTER FORMAT "X(1000)":U INITIAL "-db c:\baza\16_etalon\ub -ld dst -1 -U sysadm -P sysadm -i "
       15        LABEL "DST"
       16        VIEW-AS FILL-IN
       17        SIZE 59 BY 1 NO-UNDO.
       18   DEFINE VARIABLE f-ub AS CHARACTER FORMAT "X(256)":U INITIAL "-db c:\baza\16_TBD\ub -ld ub -1"
       19        LABEL "UB"
       20        VIEW-AS FILL-IN
       21        SIZE 59 BY 1 NO-UNDO.
       22   DEFINE VARIABLE name AS CHARACTER FORMAT "X(12)":U INITIAL "адм"
       23        LABEL "Логин"
       24        VIEW-AS FILL-IN
       25        SIZE 20 BY 1 NO-UNDO.
       26   DEFINE VARIABLE password AS CHARACTER FORMAT "X(16)":U INITIAL "адм"
       27        LABEL "Пароль"
       28        VIEW-AS FILL-IN
       29        SIZE 20 BY 1 NO-UNDO.
       30   DEFINE VARIABLE password_display AS CHARACTER FORMAT "X(16)":U INITIAL "адм"
       31        LABEL "Пароль"
       32        VIEW-AS FILL-IN
       33        SIZE 20 BY 1 NO-UNDO.
       34   DEFINE FRAME FRAME-A
       35        b-OK AT ROW 7 COL 12
       36        f-ub AT ROW 2 COL 10 COLON-ALIGNED WIDGET-ID 2
       37        name AT ROW 3.25 COL 10 COLON-ALIGNED
       38        password AT ROW 4.5 COL 10 COLON-ALIGNED PASSWORD-FIELD
       39        password_display AT ROW 4.5 COL 10 COLON-ALIGNED PASSWORD-FIELD
       40        b-quit AT ROW 7 COL 22.5
       41        f-dst AT ROW 5.75 COL 10 COLON-ALIGNED WIDGET-ID 6
       42       WITH 1 DOWN NO-BOX OVERLAY
       43            SIDE-LABELS THREE-D
       44            AT COL 1 ROW 1
       45            SIZE 72.63 BY 7.58.
       46   IF SESSION:DISPLAY-TYPE = "GUI":U THEN
       47     CREATE WINDOW w-login ASSIGN
       48            HIDDEN             = YES
       49            TITLE              = "Trade House 15.0"
       50            COLUMN             = 27
       51            ROW                = 7.58
       52            HEIGHT             = 7.75
       53            WIDTH              = 72.63
       54            MAX-HEIGHT         = 35.63
       55            MAX-WIDTH          = 160
       56            VIRTUAL-HEIGHT     = 35.63
       57            VIRTUAL-WIDTH      = 160
       58            RESIZE             = no
       59            SCROLL-BARS        = yes
       60            STATUS-AREA        = no
       61            BGCOLOR            = ?
       62            FGCOLOR            = ?
       63            THREE-D            = yes
       64            MESSAGE-AREA       = no
       65            SENSITIVE          = yes.
       66   ELSE w-login = CURRENT-WINDOW.
       67   IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(w-login)
       68   THEN w-login:HIDDEN = no.
       69   ON VALUE-CHANGED OF password_display IN FRAME FRAME-A DO:
       70       IF NOT v-updating THEN DO:
       71           ASSIGN password:SCREEN-VALUE = password_display:SCREEN-VALUE.
       72       END.
       73   END.
       74   ON ANY-KEY OF password_display IN FRAME FRAME-A DO:
       75       IF LASTKEY = KEY-CODE("CTRL-V") THEN DO:
       76              ASSIGN
       77              v-updating = TRUE
       78              password:SCREEN-VALUE = System.Windows.Forms.Clipboard:GetText()
       79              password_display:SCREEN-VALUE = System.Windows.Forms.Clipboard:GetText()
       80              v-updating = FALSE.
       81              System.Windows.Forms.Clipboard:Clear().
       82              RETURN NO-APPLY.
       83       END.
       84   END.
       85   ON CHOOSE OF b-OK IN FRAME FRAME-A
       86   DO:
       87     if name :screen-value = ""
       88     then do:
       89       message
       90         "Введите имя пользователя"
       91         view-as alert-box information .
       92       apply "entry" to name .
       93       return no-apply .
       94     end.
       95   END.
       96   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       97   on help of frame FRAME-A
       98   do:
       99     run gbl/app_help.p
      100       (input this-procedure :file-name
      101       ,input ''
      102       ,input ?
      103       ) no-error.
      104     if error-status :error then do:
      105       message
      106         "Ошибка при вызове помощи"
      107         error-status :get-message(1)
      108         view-as alert-box .
      109     end.
      110   end.
      111   on "ENTRY" of b-ok do:
      112     if lastkey = keycode ("RETURN") then do:
      113       apply "CHOOSE" to b-ok in frame FRAME-A.
      114     end.
      115   end.
      116   on window-close of w-login do:
      117     apply "end-error" to frame FRAME-A.
      118   end.
      119   ASSIGN
      120     CURRENT-WINDOW             = w-login
      121     SESSION:SYSTEM-ALERT-BOXES = (CURRENT-WINDOW:MESSAGE-AREA = NO)
      122     session:three-d = yes
      123   .
      124   PAUSE 0 BEFORE-HIDE.
      125   if session:date-format <> "dmy":U
      126     or session:numeric-decimal-point <> ".":U
      127     or session:numeric-separator <> ",":U
      128   then do:
      129     message
      130       "Неправильные установки сессии progress!" skip
      131       "Формат даты должен быть - " "'dmy'":U skip
      132       "Десятичный разделитель - " "'.'":U skip
      133       "Разделитель тысяч - " "','":U skip
      134       view-as alert-box error .
      135     quit.
      136   end.
      137   enable
      138     name password_display b-ok b-quit
      139     with frame FRAME-A in window w-login .
      140   assign
      141     session :data-entry-return = yes
      142   .
      143   run gbl/font-chk.p no-error .
      144   if error-status :error
      145   then do:
      146     message
      147       "Неправильные установки системных шрифтов" skip
      148       "Обратитесь к администратору" skip
      149       error-status :get-message(1) skip
      150       return-value skip
      151       view-as alert-box information .
      152   end.
      153   do1:
      154   do
      155   on error  undo, leave
      156   on endkey undo, leave
      157   on stop   undo, leave
      158   :
      159     if lookup( '.', propath) > 0
      160     then do:
      161       define variable v-home-directory as character no-undo .
      162       define variable v-ind as integer   no-undo .
      163       define variable v-num-entries-propath as integer   no-undo .
      164       define variable v-old-propath         as character no-undo .
      165       define variable v-new-propath         as character no-undo .
      166       define variable v-path-item           as character no-undo .
      167       assign
      168         file-info :file-name = '.'
      169         v-home-directory = file-info :full-pathname
      170       .
      171       assign
      172         v-old-propath = propath
      173         v-new-propath = ''
      174       .
      175       assign
      176         v-num-entries-propath = num-entries(v-old-propath)
      177       .
      178       do v-ind = 1 to v-num-entries-propath
      179       :
      180         assign
      181           v-path-item = entry(v-ind, v-old-propath)
      182         .
      183         if v-path-item = '.'
      184         then do:
      185           assign
      186             v-path-item = v-home-directory
      187           .
      188         end.
      189         assign
      190           v-new-propath = v-new-propath
      191                         + (if v-new-propath <> '' then ',' else '')
      192                         + v-path-item
      193         .
      194       end.
      195       assign
      196         propath = v-new-propath
      197       .
      198     end.
      199     run enable_ui in this-procedure .
      200     WAIT-FOR GO OF frame FRAME-A focus name.
      201     assign
      202       f-ub
      203       name
      204       password
      205       f-dst .
      206     def vAR  v-cConnect AS CHAR NO-UNDO.
      207     DEF VAR v-try-connect AS logical no-undo.
      208     define variable v-user-entered      as logical   no-undo init false .
      209     assign
      210       v-cConnect = f-ub
      211                  + (if     name ne ""
      212                        and name ne ?
      213                     then " &1 "
      214                     else " ")
      215       v-try-connect = true
      216     .
      217     run gbl/dbconnnodisc.p
      218       (input v-cConnect
      219       ,input ?
      220       ,input name
      221       ,input password
      222       ,input-output v-user-entered
      223       ) no-error.
      224     if error-status:error
      225     then do:
      226        message return-value view-as alert-box.
      227        quit.
      228     end.
      229     if userid('ub':U) = '':U
      230     then do:
      231       message
      232         "Ошибка при подключении к базе данных" skip
      233         "Неизвестный пользователь" skip
      234         view-as alert-box error .
      235       disconnect ub no-error .
      236       quit.
      237     end.
      238      run gbl/dbconnnodisc.p
      239       (input f-dst
      240       ,input ?
      241       ,input name
      242       ,input password
      243       ,input-output v-user-entered
      244       ) no-error.
      245     if error-status:error
      246     then do:
      247        message return-value view-as alert-box.
      248       disconnect ub no-error .
      249        quit.
      250     end.
      251     if userid('dst':U) = '':U
      252     then do:
      253       message
      254         "Ошибка при подключении к базе данных" skip
      255         "Неизвестный пользователь" skip
      256         view-as alert-box error .
      257       disconnect ub no-error .
      258       quit.
      259     end.
      260   end.
      261   assign
      262     session :data-entry-return = no
      263   .
      264   RUN disable_UI.
      265   if v-user-entered
      266   then
      267   DO2:
      268   do
      269   :
      270     RUN UTL\CUT-LOAD.W  no-error.
      271   end.
      272   else do:
      273     if v-try-connect = true
      274     then do:
      275        if error-status :error then do:
      276           message
      277              "Ошибка при подключении к БД" skip
      278              error-status :get-message(1) skip
      279              return-value skip
      280              view-as alert-box error .
      281           disconnect ub no-error .
      282           quit.
      283        end.
      284        ELSE DO:
      285           message
      286              "Ошибка при подключении к базе данных" skip
      287              "Обратитесь к администратору" skip
      288              "Строка подключения к БД:" skip
      289              v-cConnect skip
      290              view-as alert-box error .
      291        end.
      292     end.
      293   end.
      294   disconnect ub no-error .
      295   quit.
      296   PROCEDURE ARM-users :
      297   END PROCEDURE.
      298   PROCEDURE disable_UI :
      299     IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(w-login)
      300     THEN DELETE WIDGET w-login.
      301     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
      302   END PROCEDURE.
      303   PROCEDURE enable_UI :
      304     DISPLAY f-ub f-dst
      305         WITH FRAME FRAME-A IN WINDOW w-login.
      306     ENABLE b-OK f-ub name password_display b-quit f-dst
      307         WITH FRAME FRAME-A IN WINDOW w-login.
      308     VIEW w-login.
      309   END PROCEDURE.
