        1   DEFINE BUFFER X_wi-mode FOR ub.wi-mode.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter bttns as character no-undo.
        4   define input parameter p-list-mode as character no-undo .
        5   define input parameter p-mode-type as character no-undo .
        6   define input-output parameter p-rid-list as character no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Список режимов работы".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   define variable v-waitfram-action01         as character   no-undo .
       69   define variable v-waitfram-action02         as character   no-undo .
       70   define variable v-waitfram-action03         as character   no-undo .
       71   define variable mWaitFramTextBeg            as character   no-undo.
       72   define variable mWaitFramTextEnd            as character   no-undo.
       73   define variable mWaitFramView               as logical     no-undo.
       74   define variable mWaitProcEvent              as logical     no-undo init yes.
       75   define variable mWaitFramInterval           as integer     no-undo init 1 .
       76   define variable mWaitFramStop               as logical     no-undo.
       77   define variable mWaitFramStopUser           as logical     no-undo.
       78   define variable mWaitFramStopTimeOut        as logical     no-undo.
       79   define variable mWaitFramStartProc          as datetime-tz no-undo.
       80   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       81   define button B-WaitFramStop auto-end-key
       82        label "Стоп"
       83        size 10 by 1 tooltip "Остоновить процесс".
       84   define button B-viewProcInfo
       85        label "Информация"
       86        size 15 by 1 tooltip "Информация о процесс".
       87   define frame waitfram
       88     v-waitfram-action01 format "x(72)" no-label skip
       89     v-waitfram-action02 format "x(72)" no-label skip
       90     v-waitfram-action03 format "x(72)" no-label skip
       91     B-viewProcInfo
       92     B-WaitFramStop at row 4 col 30
       93     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       94     .
       95   define new global shared variable mBatchMode as logical no-undo init ?.
       96   define variable mFramBachModHandle as handle no-undo.
       97   mFramBachModHandle = frame waitfram:handle.
       98   define variable mFameOldVis as logical no-undo.
       99   define variable mVisCUrentVin as logical no-undo.
      100   if session:batch-mode
      101   then
      102      mBatchMode = yes.
      103   if mBatchMode = ? then do:
      104     mVisCUrentVin = current-window:visible.
      105     mFameOldVis = mFramBachModHandle:visible.
      106     mFramBachModHandle:visible  = yes.
      107     mBatchMode = mFramBachModHandle:visible ne yes.
      108     mFramBachModHandle:visible = mFameOldVis.
      109     current-window:visible = mVisCUrentVin.
      110   end.
      111    if  log-manager:logfile-name ne ?
      112     then DO:
      113         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      114         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      115         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      116     end.
      117   on choose of B-WaitFramStop in frame waitfram
      118   do:
      119     mWaitFramStop = yes.
      120     mWaitFramStopUser = yes.
      121   end.
      122   function waitfram-check-timeout returns logical():
      123      define variable vtime as int64 no-undo.
      124      if mWaitFramStopTimeOut
      125      then
      126         return yes.
      127      vtime = ( now - mWaitFramStartProc ) / 1000 .
      128      if     mWaitFramTimeOut ne ?
      129         and mWaitFramTimeOut ne 0
      130         and mWaitFramTimeOut lt vtime
      131      then do:
      132         mWaitFramStopTimeOut = yes.
      133      end.
      134      return mWaitFramStopTimeOut.
      135   end.
      136   procedure waitfram-hide :
      137     if not session:batch-mode
      138     then do
      139     on error undo, return error return-value
      140     :
      141       pause 0 before-hide .
      142       if not mBatchMode then
      143         hide frame waitfram .
      144     if     not mWaitFramView
      145        and mWaitProcEvent
      146     then
      147       process events .
      148     end.
      149   end procedure.
      150   procedure waitfram-show :
      151     define input  parameter p-message as character no-undo .
      152     define variable v-left-margin as integer   no-undo .
      153     if not session:batch-mode
      154     then do
      155     on error undo, return error return-value
      156     :
      157       if length(p-message) <= 70 then do:
      158         assign
      159           v-left-margin = integer((70 - length(p-message)) / 2)
      160         .
      161         assign
      162           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      163         .
      164         assign
      165           v-waitfram-action01 = " "
      166           v-waitfram-action02 = " "
      167                                    + fill(" ", v-left-margin)
      168                                    + p-message
      169           v-waitfram-action03 = " "
      170         .
      171       end.
      172       else do:
      173         define variable vRindex1 as integer no-undo.
      174         define variable vRindex2 as integer no-undo.
      175         vRindex1 = r-index(p-message," ",70).
      176         if vRindex1 = 0
      177         then
      178            vRindex1 = 70.
      179         if length(p-message)  <= vRindex1 + 70 then do:
      180           assign
      181             v-waitfram-action01 = " "
      182             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      183             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      184           .
      185         end.
      186         else do:
      187           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      188           if vRindex2 <= vRindex1
      189           then
      190              vRindex2 = vRindex1 + 70.
      191           assign
      192             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      193             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      194             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      195           .
      196         end.
      197       end.
      198       B-viewProcInfo:visible   in frame waitfram = no.
      199       B-viewProcInfo:sensitive in frame waitfram = no.
      200       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      201       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      202       if  (   mWaitFramView
      203          or  mWaitProcEvent)
      204          and not mBatchMode
      205       then
      206          display
      207             v-waitfram-action01 skip
      208             v-waitfram-action02 skip
      209             v-waitfram-action03 skip
      210          with frame waitfram .
      211       if     mWaitFramView
      212          then do:
      213             if     mWaitFramInterval ne ?
      214                and not mBatchMode
      215             then
      216                wait-for go of frame waitfram pause mWaitFramInterval.
      217          end.
      218          else
      219             if     mWaitProcEvent
      220                and not mBatchMode
      221             then
      222                process events .
      223     end.
      224   end procedure.
      225      procedure waitfram-show-this:
      226         define input  parameter iInterval as int64 no-undo.
      227         define variable vtime as int64 no-undo.
      228         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      229         mWaitFramInterval = iInterval.
      230         run waitfram-show (substitute("&1&2 &3&4" ,
      231                                       mWaitFramTextBeg ,
      232                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      233                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      234                                       mWaitFramTextEnd
      235                                      )
      236                           ).
      237      end.
      238      procedure WaitFramRunPause:
      239         define input  parameter iInterval as dec no-undo.
      240         define variable vStart  as datetime-tz no-undo.
      241         define variable vend    as datetime-tz no-undo.
      242         define variable vint as int64 no-undo.
      243         define variable vOk as logical no-undo.
      244         vStart = now.
      245         vend   = vStart.
      246         publish "WaitFramPause" (iInterval,output vOk).
      247         vend   =  now.
      248         vint = vend - vStart.
      249         vint = iInterval - vint / 1000.
      250         if     not mWaitFramStop
      251            and (   vint > 0
      252                 or (    not vOk
      253                     and iInterval eq ?
      254                     )
      255                 )
      256         then
      257            run waitfram-show-this (iInterval).
      258         vend   =  now.
      259         vint = vend - vStart.
      260         vint = iInterval - vint / 1000.
      261         if     not mWaitFramStop
      262            and vint > 0
      263         then do:
      264            run gbl/pause.p (vint * 1000).
      265         end.
      266         if iInterval ne ?
      267         then
      268            publish "WaitFramStop".
      269         waitfram-check-timeout().
      270      end.
      271      procedure WaitFramWaitFor:
      272         define input  parameter iInterval as dec no-undo.
      273         assign
      274            mWaitFramStartProc   = now
      275            mWaitFramStopUser    = no
      276            mWaitFramStopTimeOut = no
      277         .
      278         block-wait:
      279         do while not mWaitFramStop:
      280            run WaitFramRunPause (iInterval).
      281            if  waitfram-check-timeout()
      282            then do:
      283               leave block-wait.
      284            end.
      285         end.
      286         run waitfram-hide.
      287      end.
      288   procedure waitfram-join :
      289     define input  parameter p-line-1  as character no-undo .
      290     define input  parameter p-line-2  as character no-undo .
      291     define input  parameter p-line-3  as character no-undo .
      292     define output parameter p-message as character no-undo .
      293     do
      294     on error undo, return error return-value
      295     :
      296       assign
      297         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      298                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      299                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      300       .
      301     end.
      302   end procedure.
      303   function waitfram-join-function returns character
      304     (input p-line-1 as character
      305     ,input p-line-2 as character
      306     ,input p-line-3 as character
      307     ).
      308     define variable v-message as character no-undo .
      309     run waitfram-join in this-procedure
      310       (input  p-line-1
      311       ,input  p-line-2
      312       ,input  p-line-3
      313       ,output v-message
      314       ) .
      315     return v-message .
      316   end function .
      317   define new global shared variable g#language as character no-undo .
      318   if g#language <> '' and g#language <> 'rus':U then do:
      319     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      320   end.
      321   procedure proc-alt-shift-f2:
      322     if not ibs.th.gbl.gbl-var:rcode
      323   then
      324     run gbl\inidebug.p .
      325   end.
      326   procedure proc-alt-shift-f3:
      327     run gbl/prvssinf.p
      328       ( input this-procedure
      329       ) .
      330   end.
      331   define variable v-inform-launched as logical no-undo initial false .
      332   procedure proc-alt-shift-f4:
      333     define variable v-action as character no-undo .
      334     if v-inform-launched = false then do:
      335       assign
      336         v-inform-launched = true
      337       .
      338       run gbl/d-inform.w
      339         (  input self
      340         ,  input this-procedure
      341         , output v-action
      342         ) no-error .
      343       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      344       assign
      345         v-inform-launched = false
      346       .
      347     end.
      348   end.
      349   procedure proc-alt-f1:
      350     run gbl/corrhelp.p
      351       (input this-procedure
      352       ) .
      353   end .
      354   on alt-shift-f2 anywhere do:
      355     run proc-alt-shift-f2.
      356   end.
      357   on alt-shift-f3 anywhere do:
      358     run proc-alt-shift-f3 in this-procedure .
      359   end.
      360   on alt-shift-f4 anywhere do:
      361     run proc-alt-shift-f4 in this-procedure.
      362   end.
      363   on alt-f1 anywhere do:
      364     run proc-alt-f1 in this-procedure .
      365   end.
      366   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      367   FUNCTION mark-string RETURNS CHARACTER
      368     ( input p-recid as recid, input mark-list as character  ) :
      369     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      370   END FUNCTION.
      371   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      372     define variable v-cntxt-db-num        as integer   no-undo .
      373     define variable v-cntxt-userid        as character no-undo .
      374     define variable v-cntxt-level         as character no-undo .
      375     define variable v-cntxt-host-code-obj as integer   no-undo .
      376     define variable v-cntxt-obj-type      as character no-undo .
      377     define variable v-cntxt-obj-code      as integer   no-undo .
      378     define variable v-cntxt-db-num-obj    as integer   no-undo .
      379     define variable v-cntxt-is-admin      as logical   no-undo .
      380   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      381   procedure gen-key-rec :
      382     define input  parameter p-tbl-name    as character no-undo.
      383     define input  parameter p-bh_tbl-name as handle    no-undo.
      384     define output parameter p-key-rec     as character no-undo.
      385     do
      386     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      387     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      388     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      389     :
      390       define variable fh               as handle    no-undo .
      391       define variable v-ok             as logical   no-undo .
      392       define variable v-inform         as character no-undo .
      393       define variable v-ind            as integer   no-undo .
      394       define variable v-idx-field-qnty as integer   no-undo .
      395       if p-tbl-name = ?
      396         or p-tbl-name = "":U
      397       then do:
      398         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      399       end.
      400       if not p-bh_tbl-name:available then do:
      401         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      402       end.
      403       assign
      404         p-key-rec = p-tbl-name
      405         v-inform  = p-bh_tbl-name:index-information(1)
      406         v-ind     = 2
      407       .
      408       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      409       on error undo, return error
      410       :
      411         assign
      412           v-inform = p-bh_tbl-name:index-information( v-ind )
      413           v-ind    = v-ind + 1
      414         .
      415       end.
      416       if v-inform = ?
      417         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      418         or entry( 3, v-inform, ",":U ) <> "1":U
      419       then do:
      420         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      421       end.
      422       else do:
      423         assign
      424           v-idx-field-qnty = num-entries( v-inform ) - 4
      425         .
      426         if v-idx-field-qnty < 2 then do:
      427           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      428         end.
      429         do v-ind = 1 to v-idx-field-qnty by 2
      430         on error undo, return error
      431         :
      432           assign
      433             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      434             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      435           .
      436         end.
      437       end.
      438       if p-key-rec = ? then do:
      439         assign
      440           p-key-rec = "":U
      441         .
      442         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      443       end.
      444     end.
      445     return.
      446   end procedure.
      447   procedure gen-where-keyr-tab :
      448     define input  parameter i-tableSerach as character no-undo.
      449     define input  parameter i-tablekey   as character  no-undo.
      450     define input  parameter p-key-rec    as character  no-undo.
      451     define input  parameter p-key-handle as handle     no-undo .
      452     define input  parameter p-db-name    as character  no-undo .
      453     define input  parameter p-tt-handle  as handle     no-undo .
      454     define output parameter o-Where      as character  no-undo.
      455     do
      456     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      457     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      458     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      459     :
      460       define variable v-full-tbl-name  as character no-undo .
      461       define variable bh_tbl-name      as handle    no-undo .
      462       define variable fh_key           as handle    no-undo .
      463       define variable fh_search        as handle    no-undo .
      464       define variable v-field-num      as integer   no-undo .
      465       define variable v-count-fld      as integer   no-undo .
      466       define variable v-inform         as character no-undo .
      467       define variable v-ind            as integer   no-undo .
      468       define variable v-idx-field-qnty as integer   no-undo .
      469       define variable v-field-name     as character no-undo .
      470       define variable v-field-val      as character no-undo .
      471       define variable v-word-link      as character no-undo .
      472       define variable vTable           as character no-undo.
      473       define variable bh_tbl-key       as handle    no-undo .
      474       assign
      475         p-key-rec = trim( p-key-rec )
      476       .
      477       if p-key-handle <> ? then do:
      478         if not valid-handle(p-key-handle)
      479            or p-key-handle:type <> "buffer"
      480         then do:
      481           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      482         end.
      483         if num-entries( p-key-rec, chr(3) ) > 1
      484           or p-key-rec = ?
      485           or p-key-rec = "":U
      486         then do:
      487           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      488         end.
      489       end.
      490       else do:
      491         if p-key-rec = ?
      492           or p-key-rec = "":U
      493         then do:
      494           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      495         end.
      496       end.
      497       assign
      498         vTable = entry( 1 , p-key-rec, chr(3) )
      499       .
      500       if p-tt-handle <> ?
      501         and ( not valid-handle(p-tt-handle)
      502               or p-tt-handle:type <> "buffer"
      503             )
      504       then do:
      505         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      506       end.
      507       if p-tt-handle = ? then do:
      508         assign
      509           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      510         .
      511         create buffer bh_tbl-name for table v-full-tbl-name .
      512       end.
      513       else do:
      514         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      515       end.
      516       assign
      517         v-inform = bh_tbl-name:index-information(1)
      518         v-ind    = 2
      519       .
      520       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      521       on error undo, return error
      522       :
      523         assign
      524           v-inform = bh_tbl-name:index-information( v-ind )
      525           v-ind    = v-ind + 1
      526         .
      527       end.
      528       if v-inform = ?
      529         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      530         or entry( 3, v-inform, ",":U ) <> "1":U
      531       then do:
      532         delete object bh_tbl-name no-error.
      533         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      534       end.
      535       assign
      536         v-idx-field-qnty = num-entries( v-inform ) - 4
      537       .
      538       if v-idx-field-qnty < 2 then do:
      539         delete object bh_tbl-name no-error.
      540         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      541       end.
      542       assign
      543         o-where     = "where":U
      544         v-word-link = "":U
      545         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      546         v-count-fld = 0
      547       .
      548       if i-tablekey ne "" and i-tablekey ne ?
      549       then do:
      550         assign
      551           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      552         .
      553         create buffer bh_tbl-key for table v-full-tbl-name .
      554       end.
      555       if i-tableSerach ne "" and i-tableSerach ne ?
      556       then do:
      557         delete object bh_tbl-name no-error.
      558         assign
      559           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      560         .
      561         create buffer bh_tbl-name for table v-full-tbl-name .
      562       end.
      563       block_where:
      564       do v-ind = 1 to v-idx-field-qnty by 2
      565       on error undo, return error
      566       :
      567         assign
      568           v-count-fld = v-count-fld + 1
      569         .
      570         if p-key-handle = ?
      571           and v-count-fld > v-field-num
      572         then do:
      573           leave block_where.
      574         end.
      575         define variable VfieldKeyTable as handle no-undo.
      576         assign
      577           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      578           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      579         .
      580         if     bh_tbl-key ne ?
      581         then do:
      582            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      583            if VfieldKeyTable eq ?
      584            then next block_where.
      585         end.
      586         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      587         then
      588            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      589         else
      590            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      591         if p-key-handle = ? then do:
      592           assign
      593             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      594           .
      595         end.
      596         else do:
      597           assign
      598             fh_key = p-key-handle:buffer-field( v-field-name )
      599           .
      600           if fh_key = ?
      601             or not valid-handle( fh_key )
      602           then do:
      603             delete object bh_tbl-name.
      604             if     bh_tbl-key ne ?
      605             then
      606                delete object bh_tbl-key.
      607             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      608           end.
      609           assign
      610             v-field-val = fh_key:buffer-value
      611           .
      612         end.
      613         if fh_search:data-type ="character":U then do:
      614           assign
      615             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      616             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      617             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      618             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      619             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      620             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      621             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      622             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      623             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      624             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      625             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      626             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      627             v-field-val = substitute( '"&1"', v-field-val )
      628           .
      629         end.
      630         assign
      631           o-where = substitute( "&1 &2", o-where, v-field-val )
      632         .
      633         if v-word-link = "":U then do:
      634           assign
      635             v-word-link = "and":U
      636           .
      637         end.
      638       end.
      639       delete object bh_tbl-name.
      640       if     bh_tbl-key ne ?
      641       then
      642          delete object bh_tbl-key.
      643       if p-key-handle = ?
      644         and v-count-fld <> v-field-num
      645       then do:
      646         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      647       end.
      648     end.
      649   end procedure.
      650   procedure gen-hn-keyr-tab :
      651     define input  parameter i-tableSerach as character no-undo.
      652     define input  parameter i-tablekey   as character no-undo.
      653     define input  parameter p-key-rec    as character no-undo.
      654     define input  parameter p-key-handle as handle    no-undo .
      655     define input  parameter p-db-name    as character no-undo .
      656     define input  parameter p-tt-handle  as handle    no-undo .
      657     define input  parameter p-stts-lock  as integer   no-undo .
      658     define output parameter o-hn         as handle    no-undo.
      659     define variable v-full-tbl-name as character no-undo.
      660     define variable v-where         as character no-undo.
      661     define variable bh_tbl-name     as handle    no-undo.
      662     define variable vTable          as character no-undo.
      663     do
      664     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      665     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      666     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      667         run gen-where-keyr-tab(i-tableSerach,
      668                                i-tablekey,
      669                                p-key-rec,
      670                                p-key-handle,
      671                                p-db-name,
      672                                p-tt-handle,
      673                                output v-where).
      674         if i-tableSerach ne "" and i-tableSerach ne ?
      675         then do:
      676            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      677            create buffer bh_tbl-name for table v-full-tbl-name .
      678         end.
      679         else do:
      680            if p-tt-handle = ? then do:
      681               assign
      682                  vTable = entry( 1 , p-key-rec, chr(3) )
      683               .
      684               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      685               create buffer bh_tbl-name for table v-full-tbl-name .
      686            end.
      687            else do:
      688               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      689            end.
      690         end.
      691         if p-tt-handle = ? then do:
      692            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      693         end.
      694         else do:
      695            bh_tbl-name:find-first( v-where ) no-error .
      696         end.
      697         o-hn = bh_tbl-name.
      698      end.
      699   end procedure.
      700   procedure gen-hn-keyr :
      701     define input  parameter p-key-rec    as character no-undo.
      702     define input  parameter p-key-handle as handle    no-undo .
      703     define input  parameter p-db-name    as character no-undo .
      704     define input  parameter p-tt-handle  as handle    no-undo .
      705     define input  parameter p-stts-lock  as integer   no-undo .
      706     define output parameter o-hn         as handle    no-undo.
      707     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      708   end.
      709   procedure gen-row-keyr :
      710     define input  parameter p-key-rec    as character no-undo.
      711     define input  parameter p-key-handle as handle    no-undo .
      712     define input  parameter p-db-name    as character no-undo .
      713     define input  parameter p-tt-handle  as handle    no-undo .
      714     define input  parameter p-stts-lock  as integer   no-undo .
      715     define output parameter p-tbl-row    as rowid     no-undo.
      716     define output parameter p-tbl-name   as character no-undo.
      717     define variable vHn as handle no-undo.
      718       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      719       p-tbl-row = if vHn:available then vHn:rowid else ?.
      720       p-tbl-name =  vHn:table.
      721       delete object vHn no-error.
      722     if p-tbl-row = ? then do:
      723       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      724     end.
      725     else do:
      726       return.
      727     end.
      728   end procedure.
      729   procedure gen-key-fv :
      730     define input  parameter p-key-rec    as character no-undo .
      731     define output parameter p-field-list as character no-undo .
      732     define output parameter p-value-list as character no-undo.
      733     do
      734     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      735     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      736     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      737     :
      738       define variable v-full-tbl-name  as character no-undo .
      739       define variable bh_tbl-name      as handle    no-undo .
      740       define variable v-tbl-name       as character no-undo .
      741       define variable v-field-num      as integer   no-undo .
      742       define variable v-count-fld      as integer   no-undo .
      743       define variable v-inform         as character no-undo .
      744       define variable v-ind            as integer   no-undo .
      745       define variable v-idx-field-qnty as integer   no-undo .
      746       define variable v-delim-key      as character no-undo .
      747       if p-key-rec = ?
      748         or p-key-rec = "":U
      749       then do:
      750         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      751       end.
      752       assign
      753         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      754         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      755       .
      756       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      757       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      758       assign
      759         v-inform = bh_tbl-name:index-information(1)
      760         v-ind    = 2
      761       .
      762       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      763       on error undo, return error
      764       :
      765         assign
      766           v-inform = bh_tbl-name:index-information( v-ind )
      767           v-ind    = v-ind + 1
      768         .
      769       end.
      770       if v-inform = ?
      771         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      772         or entry( 3, v-inform, ",":U ) <> "1":U
      773       then do:
      774         delete object bh_tbl-name no-error.
      775         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      776       end.
      777       assign
      778         v-idx-field-qnty = num-entries( v-inform ) - 4
      779       .
      780       if v-idx-field-qnty < 2 then do:
      781         delete object bh_tbl-name no-error.
      782         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      783       end.
      784       assign
      785         p-field-list = "":U
      786         p-value-list = "":U
      787         v-delim-key  = "":U
      788         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      789         v-count-fld  = 0
      790       .
      791       block_where:
      792       do v-ind = 1 to v-idx-field-qnty by 2
      793       on error undo, return error
      794       :
      795         assign
      796           v-count-fld = v-count-fld + 1
      797         .
      798         if v-count-fld > v-field-num then do:
      799           leave block_where.
      800         end.
      801         assign
      802           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      803           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      804         .
      805         if v-ind = 1 then do:
      806           assign
      807             v-delim-key = chr(3)
      808           .
      809         end.
      810       end.
      811       delete object bh_tbl-name.
      812       if v-count-fld <> v-field-num then do:
      813         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      814       end.
      815     end.
      816   end procedure.
      817   procedure gen-key-field :
      818     define input  parameter p-table      as character no-undo .
      819     define output parameter p-field-list as character no-undo .
      820     do
      821     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      822     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      823     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      824     :
      825       define variable v-full-tbl-name  as character no-undo .
      826       define variable bh_tbl-name      as handle    no-undo .
      827       define variable v-tbl-name       as character no-undo .
      828       define variable v-field-num      as integer   no-undo .
      829       define variable v-count-fld      as integer   no-undo .
      830       define variable v-inform         as character no-undo .
      831       define variable v-ind            as integer   no-undo .
      832       define variable v-idx-field-qnty as integer   no-undo .
      833       define variable v-delim-key      as character no-undo .
      834       if p-table = ?
      835         or p-table = "":U
      836       then do:
      837         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
      838       end.
      839       assign
      840         v-tbl-name      = p-table
      841         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      842       .
      843       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      844       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
      845       assign
      846         v-inform = bh_tbl-name:index-information(1)
      847         v-ind    = 2
      848       .
      849       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      850       on error undo, return error
      851       :
      852         assign
      853           v-inform = bh_tbl-name:index-information( v-ind )
      854           v-ind    = v-ind + 1
      855         .
      856       end.
      857       if v-inform = ?
      858         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      859         or entry( 3, v-inform, ",":U ) <> "1":U
      860       then do:
      861         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      862       end.
      863       assign
      864         v-idx-field-qnty = num-entries( v-inform ) - 4
      865       .
      866       if v-idx-field-qnty < 2 then do:
      867         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      868       end.
      869       assign
      870         p-field-list = "":U
      871         v-delim-key  = "":U
      872         v-count-fld  = 0
      873       .
      874       block_where:
      875       do v-ind = 1 to v-idx-field-qnty by 2
      876       on error undo, return error
      877       :
      878         assign
      879           v-count-fld = v-count-fld + 1
      880         .
      881         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      882         if v-ind = 1 then do:
      883           assign
      884             v-delim-key = chr(3)
      885           .
      886         end.
      887       end.
      888       delete object bh_tbl-name.
      889     end.
      890   end procedure.
      891   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
      892   define variable v-admin as logical no-undo .
      893   DEFINE VARIABLE link-option AS CHARACTER NO-UNDO.
      894   define variable v-rid-list as character no-undo .
      895   DEFINE VARIABLE lkp-option AS CHARACTER NO-UNDO.
      896   DEFINE VARIABLE vh-mode-type-name AS HANDLE NO-UNDO.
      897   DEFINE BUTTON b-add
      898        LABEL "&Добавить"
      899        SIZE 10 BY 1.
      900   DEFINE BUTTON b-chg
      901        LABEL "&Изменить"
      902        SIZE 10 BY 1.
      903   DEFINE BUTTON b-del
      904        LABEL "&Удалить"
      905        SIZE 10 BY 1.
      906   DEFINE BUTTON B-Help
      907        LABEL "Помо&щь"
      908        SIZE 3 BY 1
      909        BGCOLOR 8 .
      910   DEFINE BUTTON b-lkp
      911        LABEL "&Просмотр"
      912        SIZE 10 BY 1.
      913   DEFINE BUTTON b-mark
      914        LABEL "&*"
      915        SIZE 4 BY 1.
      916   DEFINE BUTTON b-quit AUTO-END-KEY
      917        LABEL "&Выход"
      918        SIZE 10 BY 1
      919        BGCOLOR 8 .
      920   DEFINE BUTTON b-sel AUTO-GO
      921        LABEL "Выбор"
      922        SIZE 10 BY 1.
      923   DEFINE VARIABLE e-des AS CHARACTER
      924        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      925        SIZE 97 BY 4.27 NO-UNDO.
      926   DEFINE VARIABLE mark-num AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      927         VIEW-AS TEXT
      928        SIZE 9 BY .67
      929        FGCOLOR 10  NO-UNDO.
      930   DEFINE QUERY br-wi-mode FOR
      931         X_wi-mode SCROLLING.
      932   DEFINE BROWSE br-wi-mode
      933     QUERY br-wi-mode NO-LOCK DISPLAY
      934         mark-string(recid(X_wi-mode), v-rid-list) Format "X(1)" COLUMN-LABEL "*"
      935   entry (lookup (X_wi-mode.mode-type, 'cd-IBS-TH':U) + 1, ',' + 'Режимы работы кассы IBS TH POS':U) COLUMN-LABEL "Тип режима" FORMAT "X(255)" WIDTH 30
      936   X_wi-mode.mode-id COLUMN-LABEL "ID режима" FORMAT "X(10)"
      937   X_wi-mode.prev-mode-id COLUMN-LABEL "ID пред.!режима" FORMAT "X(10)"
      938   X_wi-mode.mode-name COLUMN-LABEL "Название" FORMAT "X(255)" WIDTH 35
      939   X_wi-mode.codex_id COLUMN-LABEL "Кодекс" FORMAT ">>9"
      940   X_wi-mode.ruleset_id COLUMN-LABEL "Набор!правил" FORMAT ">>>9"
      941       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 16 FIT-LAST-COLUMN.
      942   DEFINE FRAME Dialog-Frame
      943        b-quit AT ROW 1 COL 1
      944        b-mark AT ROW 1 COL 20 WIDGET-ID 12
      945        b-sel AT ROW 1 COL 24 WIDGET-ID 10
      946        b-add AT ROW 1 COL 34 WIDGET-ID 2
      947        b-chg AT ROW 1 COL 44 WIDGET-ID 4
      948        b-del AT ROW 1 COL 54 WIDGET-ID 8
      949        b-lkp AT ROW 1 COL 64 WIDGET-ID 6
      950        B-Help AT ROW 1 COL 95
      951        br-wi-mode AT ROW 2.33 COL 1.5 WIDGET-ID 100
      952        e-des AT ROW 18.6 COL 1.5 NO-LABEL WIDGET-ID 16
      953        mark-num AT ROW 1 COL 11 NO-LABEL WIDGET-ID 14
      954        SPACE(78.59) SKIP(21.19)
      955       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      956            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      957            TITLE ""
      958            CANCEL-BUTTON b-quit.
      959   ASSIGN
      960          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      961          FRAME Dialog-Frame:HIDDEN           = TRUE.
      962   ASSIGN
      963          e-des:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      964   ON GO OF FRAME Dialog-Frame
      965   DO:
      966     p-rid-list = v-rid-list.
      967   END.
      968   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      969   DO:
      970     APPLY "END-ERROR":U TO SELF.
      971   END.
      972   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      973   DO:
      974    define variable v-rec as recid no-undo.
      975     run adm/wi-modei.w ( input parparentproc
      976                          ,input 'ДОБАВЛЕНИЕ':U + chr(44) + (if v-admin then "admin" else '')
      977                          ,input ''
      978                          ,input ''
      979                          ,input-output v-rec) no-error.
      980     if v-rec <> ? then do:
      981       RUN openbr IN THIS-PROCEDURE.
      982       APPLY "VALUE-CHANGED" TO br-wi-mode.
      983     end.
      984   END.
      985   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      986   DO:
      987     define variable v-rec as recid no-undo.
      988     if not available X_wi-mode then return no-apply.
      989     v-rec = recid(X_wi-mode).
      990     run adm/wi-modei.w ( input parparentproc
      991                          ,input 'ИЗМЕНЕНИЕ':U + chr(44) + (if v-admin then "admin" else '')
      992                          ,input X_wi-mode.mode-type
      993                          ,input X_wi-mode.mode-id
      994                          ,input-output v-rec) no-error.
      995     if v-rec <> ? then do:
      996        br-wi-mode:refresh().
      997        APPLY "VALUE-CHANGED" TO br-wi-mode.
      998     end.
      999   END.
     1000   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1001   DO:
     1002     define variable v-rec as recid no-undo.
     1003     define variable glog as logical no-undo.
     1004     if not available X_wi-mode then return no-apply.
     1005     v-rec = recid(X_wi-mode).
     1006     message
     1007     "Вы уверены, что хотите удалить режим?"
     1008     view-as alert-box question buttons yes-no update glog.
     1009     if not glog then return no-apply.
     1010    run adm/wi-mode3.p (
     1011                              input no
     1012                             ,input v-rec
     1013                             ) no-error.
     1014    if error-status:error then return no-apply.
     1015    run Openbr in this-procedure .
     1016    APPLY "VALUE-CHANGED" TO br-wi-mode.
     1017   END.
     1018   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1019   DO:
     1020   if not available X_wi-mode then return no-apply.
     1021   run proc-b-lkp IN THIS-PROCEDURE ( INPUT 'wi-mode':U) NO-ERROR.
     1022   IF ERROR-STATUS:ERROR THEN DO:
     1023       lkp-option = '':U.
     1024       RETURN NO-APPLY.
     1025   END.
     1026   lkp-option = '':U.
     1027   END.
     1028   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1029   DO:
     1030     define variable glog as logical no-undo .
     1031     if available X_wi-mode then do:
     1032   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1033   define variable v-str-recid5 as character no-undo .
     1034   define variable v-num-entry5 as integer   no-undo .
     1035   assign
     1036     v-str-recid5 = trim( string( recid( X_wi-mode ) , "->>>>>>>>>>>9":U ) )
     1037     v-num-entry5 = lookup( v-str-recid5 , v-rid-list )
     1038   .
     1039   if v-num-entry5 > 0 then do:
     1040     assign
     1041       entry( v-num-entry5, v-rid-list ) = "":U
     1042       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1043     .
     1044   end.
     1045   else do:
     1046     assign
     1047       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid5
     1048     .
     1049   end.
     1050     glog = br-wi-mode:refresh() .
     1051     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1052         glog = br-wi-mode:select-next-row ().
     1053         apply "VALUE-CHANGED" to br-wi-mode in frame Dialog-Frame.
     1054     end.
     1055     if num-entries( v-rid-list ) = 0
     1056     then
     1057         hide mark-num in frame Dialog-Frame.
     1058     else
     1059         disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1060   end.
     1061   apply "entry" to br-wi-mode in frame Dialog-Frame.
     1062   END.
     1063   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1064   DO:
     1065     if available X_wi-mode then do:
     1066       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1067       then  v-rid-list = string( recid( X_wi-mode ) ) .
     1068     end.
     1069   END.
     1070   ON VALUE-CHANGED OF br-wi-mode IN FRAME Dialog-Frame
     1071   DO:
     1072     IF AVAILABLE X_wi-mode THEN DO:
     1073        ASSIGN
     1074        e-des:SCREEN-VALUE = X_wi-mode.des.
     1075     END.
     1076     ELSE DO:
     1077         ASSIGN
     1078         e-des:SCREEN-VALUE = ''.
     1079     END.
     1080   END.
     1081   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1082   on f5 of frame Dialog-Frame anywhere
     1083   do:
     1084      v-doc-rec = recid(X_wi-mode).    RUn OpenBR in this-procedure.  REPOSITION br-wi-mode to recid v-doc-rec No-ERROR.   apply 'value-changed' to br-wi-mode.
     1085       apply "VALUE-CHANGED" to br-wi-mode.
     1086   end.
     1087   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1088   on help of frame Dialog-Frame
     1089   do:
     1090     run gbl/app_help.p
     1091       (input this-procedure :file-name
     1092       ,input ''
     1093       ,input ?
     1094       ) no-error.
     1095     if error-status :error then do:
     1096       message
     1097         "Ошибка при вызове помощи"
     1098         error-status :get-message(1)
     1099         view-as alert-box .
     1100     end.
     1101   end.
     1102   run minbtn-set in this-procedure .
     1103   on choose of b-help in frame Dialog-Frame
     1104   do:
     1105     apply "help":u to frame Dialog-Frame .
     1106   end.
     1107   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1108   procedure minbtn-set :
     1109       do
     1110           on error undo, return error return-value
     1111           :
     1112           define variable ii              as integer       no-undo .
     1113           define variable fh              as widget-handle no-undo .
     1114           define variable hh              as widget-handle no-undo .
     1115           define variable v-h             as handle        extent 4 no-undo .
     1116           define variable v-name-button   as character     no-undo .
     1117           define variable v-help-old-x    as decimal       no-undo .
     1118           define variable v-help-old-y    as decimal       no-undo .
     1119           define variable v-help-old-size as decimal       no-undo .
     1120           define variable v-frame-width   as decimal       no-undo .
     1121           define variable jj              as integer       no-undo .
     1122           do
     1123               on error undo, return error
     1124               :
     1125               assign
     1126                   v-frame-width = frame Dialog-Frame:width - 0.3
     1127                   fh            = frame Dialog-Frame:first-child
     1128                   hh            = fh:first-child
     1129                   ii            = 1
     1130                   .
     1131               do while valid-handle(hh):
     1132                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1133                   do:
     1134                       case lc(hh:name) :
     1135                           when "b-help" then
     1136                               do:
     1137                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1138                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1139                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1140                                   hh:TOOLTIP = "Помощь" .
     1141                                   v-help-old-x = hh:column .
     1142                                   v-help-old-y = hh:row    .
     1143                                   v-help-old-size = hh:width .
     1144                                   hh:width-chars = 2.5 .
     1145                               end.
     1146                           when "b-print" then
     1147                               do:
     1148                                   hh:load-image("cmp/b-print.bmp":u) .
     1149                                   hh:TOOLTIP = "Печать" .
     1150                                   v-h[ii] = hh:handle .
     1151                                   ii = ii + 1 .
     1152                                   hh:width-chars = 3 .
     1153                               end.
     1154                           when "b-history" or
     1155                           when "b-hist" then
     1156                               do:
     1157                                   hh:load-image("cmp/b-hist.bmp":u) .
     1158                                   hh:TOOLTIP = "История" .
     1159                                   v-h[ii] = hh:handle .
     1160                                   ii = ii + 1 .
     1161                                   hh:width-chars = 3 .
     1162                               end.
     1163                           when "b-sch" then
     1164                               do:
     1165                                   hh:load-image("cmp/b-sch.bmp":u) .
     1166                                   hh:TOOLTIP = "Установка Фильтра" .
     1167                                   v-h[ii] = hh:handle .
     1168                                   ii = ii + 1 .
     1169                                   hh:width-chars = 3 .
     1170                               end.
     1171                           when "b-hist-user" then
     1172                               do:
     1173                                   hh:load-image("cmp/b-hist.bmp":u) .
     1174                                   hh:TOOLTIP = "История пользователя" .
     1175                                   ii = ii + 1 .
     1176                               end.
     1177                       end case.
     1178                   end.
     1179                   hh = hh:next-sibling.
     1180               end.
     1181               b-help:column = v-frame-width - b-help:width-chars.
     1182               jj = 0.
     1183               repeat ii = 4 to 1 by -1 :
     1184                   if valid-handle (v-h[ii] ) then
     1185                   do:
     1186                       jj  = jj + 1 .
     1187                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1188                       v-h[ii]:row    = v-help-old-y .
     1189                   end.
     1190               end.
     1191           end.
     1192       end.
     1193   end procedure.
     1194   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1195   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1196   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1197   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1198   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1199   define variable v-diasize-current-frame-height as decimal   no-undo .
     1200   define variable v-diasize-change-size          as logical   no-undo .
     1201   define variable v-diasize-resize-button        as handle    no-undo .
     1202   define variable v-diasize-wndmax               as logical   no-undo .
     1203   define variable v-diasize-wndstore             as logical   no-undo .
     1204   define variable v-diasize-proc-name            as character no-undo .
     1205   define variable v-diasize-browse-handle        as handle    no-undo .
     1206   define variable v-diasize-browse-number        as integer   no-undo .
     1207   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1208   define temp-table temp-diasize-handle no-undo
     1209     field handle-value  as handle
     1210     field save-position as decimal
     1211     index xpk is primary unique handle-value
     1212     .
     1213   define temp-table temp-browse-handle no-undo
     1214     field browse-type   as character
     1215     field browse-number as integer
     1216     field browse-handle as handle
     1217     field original-size as decimal
     1218     index xpk is primary unique browse-type browse-number
     1219     index xie browse-type browse-handle
     1220   .
     1221   procedure diasize_change-height :
     1222     define input  parameter p-change-value  as decimal   no-undo .
     1223     define input  parameter p-move-resize   as logical   no-undo .
     1224     define variable v-field-group-handle    as handle    no-undo .
     1225     define variable v-object-handle         as handle    no-undo .
     1226     define variable v-frame-height          as decimal   no-undo .
     1227     define variable v-frame-virtual-height  as decimal   no-undo .
     1228     define variable v-browse-height         as decimal   no-undo .
     1229     define variable v-window-height         as decimal   no-undo .
     1230     define variable v-window-virtual-height as decimal   no-undo .
     1231     define variable v-change-sign           as integer   no-undo .
     1232     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1233     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1234     if p-change-value > 0
     1235     then do:
     1236       if frame Dialog-Frame :height + p-change-value
     1237           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1238       then do:
     1239         assign
     1240           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1241                           - (frame Dialog-Frame :height-chars)
     1242         .
     1243         if p-change-value <= 0
     1244         then do:
     1245           run diasize_position-resize-button in this-procedure .
     1246           return .
     1247         end.
     1248       end.
     1249     end.
     1250     if p-change-value < 0
     1251     then do:
     1252       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1253       then do:
     1254         assign
     1255           p-change-value = v-diasize-orig-frame-height
     1256                          - (frame Dialog-Frame :height-chars)
     1257         .
     1258         if p-change-value >= 0
     1259         then do:
     1260           run diasize_position-resize-button in this-procedure .
     1261           return .
     1262         end.
     1263       end.
     1264     end.
     1265     if p-change-value >= 0
     1266     then do:
     1267       assign
     1268         v-change-sign = 1
     1269       .
     1270     end.
     1271     else do:
     1272       assign
     1273         v-change-sign = -1
     1274       .
     1275     end.
     1276     assign
     1277       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1278     .
     1279     if p-change-value = 0
     1280     then do:
     1281       run diasize_position-resize-button in this-procedure .
     1282       return .
     1283     end.
     1284     move_block:
     1285     do
     1286     on error undo move_block, retry move_block
     1287     :
     1288       if retry
     1289       then do:
     1290         do
     1291         on error undo move_block, leave move_block
     1292         :
     1293           if p-change-value > 0
     1294           then do:
     1295             for each buf_temp-diasize-handle
     1296             on error undo, next
     1297             :
     1298               assign
     1299                 v-object-handle = buf_temp-diasize-handle.handle-value
     1300               .
     1301               if v-object-handle <> v-diasize-resize-button
     1302               then do:
     1303                 assign
     1304                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1305                 .
     1306               end.
     1307             end.
     1308             assign
     1309               v-diasize-browse-handle :height = v-browse-height
     1310             .
     1311             for each buf_temp-browse-handle
     1312               where buf_temp-browse-handle.browse-type = 'height':u
     1313             on error undo, next
     1314             :
     1315               assign
     1316                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1317               .
     1318             end.
     1319             assign
     1320               frame Dialog-Frame :height = v-frame-height
     1321             .
     1322             if frame Dialog-Frame :scrollable = true
     1323             then do:
     1324               assign
     1325                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1326               .
     1327             end.
     1328             run diasize_position-resize-button in this-procedure .
     1329           end.
     1330           else do:
     1331             if frame Dialog-Frame :scrollable = true
     1332             then do:
     1333               assign
     1334                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1335               .
     1336             end.
     1337             assign
     1338               frame Dialog-Frame :height = v-frame-height
     1339             .
     1340             assign
     1341               v-diasize-browse-handle :height = v-browse-height
     1342             .
     1343             for each buf_temp-browse-handle
     1344               where buf_temp-browse-handle.browse-type = 'height':u
     1345             on error undo, next
     1346             :
     1347               assign
     1348                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1349               .
     1350             end.
     1351             for each buf_temp-diasize-handle
     1352             on error undo, next
     1353             :
     1354               assign
     1355                 v-object-handle = buf_temp-diasize-handle.handle-value
     1356               .
     1357               if v-object-handle <> v-diasize-resize-button
     1358               then do:
     1359                 assign
     1360                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1361                 .
     1362               end.
     1363             end.
     1364             run diasize_position-resize-button in this-procedure .
     1365           end.
     1366           assign
     1367             v-diasize-change-size = false
     1368           .
     1369           leave move_block .
     1370         end.
     1371       end.
     1372       assign
     1373         v-diasize-need-full-display = true
     1374       .
     1375       if v-diasize-change-size = false
     1376       then do:
     1377         assign
     1378           v-diasize-change-size = true
     1379         .
     1380       end.
     1381       else do:
     1382         return .
     1383       end.
     1384       assign
     1385         v-frame-height = frame Dialog-Frame :height
     1386         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1387         v-browse-height = v-diasize-browse-handle :height
     1388       .
     1389       for each buf_temp-browse-handle
     1390         where buf_temp-browse-handle.browse-type = 'height':u
     1391       :
     1392         assign
     1393           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1394         .
     1395       end.
     1396       for each buf_temp-diasize-handle
     1397       :
     1398         delete buf_temp-diasize-handle .
     1399       end.
     1400       assign
     1401         v-field-group-handle = frame Dialog-Frame :first-child
     1402       .
     1403       do while valid-handle(v-field-group-handle)
     1404       :
     1405         assign
     1406           v-object-handle = v-field-group-handle :first-child
     1407         .
     1408         do while valid-handle(v-object-handle)
     1409         :
     1410           if  v-object-handle <> v-diasize-browse-handle :handle
     1411           and can-query(v-object-handle, "row")
     1412           and can-query(v-object-handle, "height")
     1413           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1414           then do:
     1415             find first buf_temp-browse-handle
     1416               where buf_temp-browse-handle.browse-type   = 'height':u
     1417                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1418               no-error .
     1419             if available buf_temp-browse-handle
     1420             then do:
     1421             end.
     1422             else do:
     1423               create buf_temp-diasize-handle .
     1424               assign
     1425                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1426                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1427               .
     1428             end.
     1429           end.
     1430           assign
     1431             v-object-handle = v-object-handle :next-sibling
     1432           .
     1433         end.
     1434         assign
     1435           v-field-group-handle = v-field-group-handle :next-sibling
     1436         .
     1437       end.
     1438       do with frame Dialog-Frame
     1439       :
     1440         hide v-diasize-resize-button .
     1441         assign
     1442           v-diasize-resize-button :row    = 1
     1443           v-diasize-resize-button :column = 1
     1444         .
     1445       end.
     1446       if p-change-value > 0
     1447       then do:
     1448         if frame Dialog-Frame :scrollable = true
     1449         then do:
     1450           assign
     1451             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1452             no-error .
     1453           if error-status :error
     1454           or error-status :get-message(1) <> ""
     1455           then do:
     1456             undo move_block, retry move_block .
     1457           end.
     1458         end.
     1459         assign
     1460           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1461           no-error .
     1462         if error-status :error
     1463         or error-status :get-message(1) <> ""
     1464         then do:
     1465           undo move_block, retry move_block .
     1466         end.
     1467         assign
     1468           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1469           no-error .
     1470         if error-status :error
     1471         or error-status :get-message(1) <> ""
     1472         then do:
     1473           undo move_block, retry move_block .
     1474         end.
     1475         for each buf_temp-browse-handle
     1476           where buf_temp-browse-handle.browse-type = 'height':u
     1477         on error undo move_block, retry move_block
     1478         :
     1479           assign
     1480             buf_temp-browse-handle.browse-handle :height
     1481               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1482             no-error .
     1483           if error-status :error
     1484           or error-status :get-message(1) <> ""
     1485           then do:
     1486             undo move_block, retry move_block .
     1487           end.
     1488         end.
     1489         for each buf_temp-diasize-handle
     1490         on error undo move_block, retry move_block
     1491         :
     1492           assign
     1493             v-object-handle = buf_temp-diasize-handle.handle-value
     1494           .
     1495           if v-object-handle <> v-diasize-resize-button
     1496           then do:
     1497             assign
     1498               v-object-handle :row = v-object-handle :row + p-change-value
     1499               no-error .
     1500             if error-status :error
     1501             or error-status :get-message(1) <> ""
     1502             then do:
     1503               undo move_block, retry move_block .
     1504             end.
     1505           end.
     1506         end.
     1507       end.
     1508       else do:
     1509         for each buf_temp-diasize-handle
     1510         on error undo move_block, retry move_block
     1511         :
     1512           assign
     1513             v-object-handle = buf_temp-diasize-handle.handle-value
     1514           .
     1515           if v-object-handle <> v-diasize-resize-button
     1516           then do:
     1517             assign
     1518               v-object-handle :row = v-object-handle :row + p-change-value
     1519               no-error .
     1520             if error-status :error
     1521             or error-status :get-message(1) <> ""
     1522             then do:
     1523               undo move_block, retry move_block .
     1524             end.
     1525           end.
     1526         end.
     1527         assign
     1528           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1529           no-error .
     1530         if error-status :error
     1531         or error-status :get-message(1) <> ""
     1532         then do:
     1533           undo move_block, retry move_block .
     1534         end.
     1535         for each buf_temp-browse-handle
     1536           where buf_temp-browse-handle.browse-type = 'height':u
     1537         on error undo move_block, retry move_block
     1538         :
     1539           assign
     1540             buf_temp-browse-handle.browse-handle :height
     1541               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1542             no-error .
     1543           if error-status :error
     1544           or error-status :get-message(1) <> ""
     1545           then do:
     1546             undo move_block, retry move_block .
     1547           end.
     1548         end.
     1549         assign
     1550           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1551           no-error .
     1552         if error-status :error
     1553         or error-status :get-message(1) <> ""
     1554         then do:
     1555           undo move_block, retry move_block .
     1556         end.
     1557         if frame Dialog-Frame :scrollable = true
     1558         then do:
     1559           assign
     1560             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1561             no-error .
     1562           if error-status :error
     1563           or error-status :get-message(1) <> ""
     1564           then do:
     1565             undo move_block, retry move_block .
     1566           end.
     1567         end.
     1568       end.
     1569       if p-move-resize = true
     1570       then do:
     1571         run diasize_position-resize-button in this-procedure .
     1572       end.
     1573       if v-diasize-wndstore = true
     1574       then do:
     1575         if connected("ub") = true
     1576         then do:
     1577           define variable v-cntxt-db-num        as integer   no-undo .
     1578           define variable v-cntxt-userid        as character no-undo .
     1579           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1580                                             , OUTPUT v-cntxt-userid
     1581                                             ) .
     1582           run gbl/wndsizew.p
     1583             (input  v-cntxt-db-num
     1584             ,input  v-cntxt-userid
     1585             ,input  v-diasize-proc-name
     1586             ,input  'height':u
     1587             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1588             ) .
     1589         end.
     1590       end.
     1591     end.
     1592     assign
     1593       v-diasize-change-size = false
     1594     .
     1595   end procedure.
     1596   procedure diasize_set-height :
     1597     define input  parameter p-new-height  as decimal   no-undo .
     1598     define input  parameter p-move-resize as logical   no-undo .
     1599     do
     1600     on error undo, return error return-value
     1601     :
     1602       run diasize_change-height in this-procedure
     1603         (input  (p-new-height - frame Dialog-Frame :height)
     1604         ,input  p-move-resize
     1605         ) .
     1606     end.
     1607   end procedure.
     1608   procedure diasize_change-width :
     1609     define input  parameter p-change-value as decimal   no-undo .
     1610     define input  parameter p-move-resize  as logical   no-undo .
     1611     define variable v-field-group-handle   as handle    no-undo .
     1612     define variable v-object-handle        as handle    no-undo .
     1613     define variable v-frame-width          as decimal   no-undo .
     1614     define variable v-frame-virtual-width  as decimal   no-undo .
     1615     define variable v-browse-width         as decimal   no-undo .
     1616     define variable v-window-width         as decimal   no-undo .
     1617     define variable v-window-virtual-width as decimal   no-undo .
     1618     define variable v-change-sign          as integer   no-undo .
     1619     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1620     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1621     if p-change-value > 0
     1622     then do:
     1623       if frame Dialog-Frame :width + p-change-value >
     1624           session :width-chars
     1625       then do:
     1626         assign
     1627           p-change-value = session :width-chars - frame Dialog-Frame :width
     1628         .
     1629         if p-change-value <= 0
     1630         then do:
     1631           run diasize_position-resize-button in this-procedure .
     1632           return .
     1633         end.
     1634       end.
     1635     end.
     1636     if p-change-value < 0
     1637     then do:
     1638       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1639       then do:
     1640         assign
     1641           p-change-value = v-diasize-orig-frame-width
     1642                          - frame Dialog-Frame :width
     1643         .
     1644         if p-change-value >= 0
     1645         then do:
     1646           run diasize_position-resize-button in this-procedure .
     1647           return .
     1648         end.
     1649       end.
     1650     end.
     1651     if p-change-value >= 0
     1652     then do:
     1653       assign
     1654         v-change-sign = 1
     1655       .
     1656     end.
     1657     else do:
     1658       assign
     1659         v-change-sign = -1
     1660       .
     1661     end.
     1662     assign
     1663       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1664     .
     1665     if p-change-value = 0
     1666     then do:
     1667       run diasize_position-resize-button in this-procedure .
     1668       return .
     1669     end.
     1670     move_block:
     1671     do
     1672     on error undo move_block, leave move_block
     1673     :
     1674       if retry
     1675       then do:
     1676         do
     1677         on error undo move_block, leave move_block
     1678         :
     1679           if p-change-value > 0
     1680           then do:
     1681             for each buf_temp-diasize-handle
     1682             on error undo, next
     1683             :
     1684               assign
     1685                 v-object-handle = buf_temp-diasize-handle.handle-value
     1686               .
     1687               if v-object-handle <> v-diasize-resize-button
     1688               then do:
     1689                 assign
     1690                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1691                 .
     1692               end.
     1693             end.
     1694             assign
     1695               v-diasize-browse-handle :width = v-browse-width
     1696             .
     1697             for each buf_temp-browse-handle
     1698               where buf_temp-browse-handle.browse-type = 'width':u
     1699             on error undo, next
     1700             :
     1701               assign
     1702                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1703               .
     1704             end.
     1705             assign
     1706               frame Dialog-Frame :width = v-frame-width
     1707             .
     1708             if frame Dialog-Frame :scrollable = true
     1709             then do:
     1710               assign
     1711                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1712               .
     1713             end.
     1714             run diasize_position-resize-button in this-procedure .
     1715           end.
     1716           else do:
     1717             if frame Dialog-Frame :scrollable = true
     1718             then do:
     1719               assign
     1720                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1721               .
     1722             end.
     1723             assign
     1724               frame Dialog-Frame :width = v-frame-width
     1725             .
     1726             for each buf_temp-browse-handle
     1727               where buf_temp-browse-handle.browse-type = 'width':u
     1728             on error undo, next
     1729             :
     1730               assign
     1731                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1732               .
     1733             end.
     1734             assign
     1735               v-diasize-browse-handle :width = v-browse-width
     1736             .
     1737             for each buf_temp-diasize-handle
     1738             on error undo, next
     1739             :
     1740               assign
     1741                 v-object-handle = buf_temp-diasize-handle.handle-value
     1742               .
     1743               if v-object-handle <> v-diasize-resize-button
     1744               then do:
     1745                 assign
     1746                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1747                 .
     1748               end.
     1749             end.
     1750             run diasize_position-resize-button in this-procedure .
     1751           end.
     1752           assign
     1753             v-diasize-change-size = false
     1754           .
     1755           leave move_block .
     1756         end.
     1757       end.
     1758       assign
     1759         v-diasize-need-full-display = true
     1760       .
     1761       if v-diasize-change-size = false
     1762       then do:
     1763         assign
     1764           v-diasize-change-size = true
     1765         .
     1766       end.
     1767       else do:
     1768         return .
     1769       end.
     1770       assign
     1771         v-frame-width = frame Dialog-Frame :width
     1772         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1773         v-browse-width = v-diasize-browse-handle :width
     1774       .
     1775       for each buf_temp-browse-handle
     1776         where buf_temp-browse-handle.browse-type = 'width':u
     1777       :
     1778         assign
     1779           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1780         .
     1781       end.
     1782       for each buf_temp-diasize-handle
     1783       :
     1784         delete buf_temp-diasize-handle .
     1785       end.
     1786       assign
     1787         v-field-group-handle = frame Dialog-Frame :first-child
     1788       .
     1789       do while valid-handle(v-field-group-handle)
     1790       :
     1791         assign
     1792           v-object-handle = v-field-group-handle :first-child
     1793         .
     1794         do while valid-handle(v-object-handle)
     1795         :
     1796           if  v-object-handle <> v-diasize-browse-handle :handle
     1797           and v-object-handle <> v-diasize-resize-button
     1798           and can-query(v-object-handle, "row")
     1799           and can-query(v-object-handle, "height")
     1800           and ( v-object-handle :col + v-object-handle :width
     1801                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1802               )
     1803           then do:
     1804             find first buf_temp-browse-handle
     1805               where buf_temp-browse-handle.browse-type   = 'width':u
     1806                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1807               no-error .
     1808             if available buf_temp-browse-handle
     1809             then do:
     1810             end.
     1811             else do:
     1812               create buf_temp-diasize-handle .
     1813               assign
     1814                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1815                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1816               .
     1817             end.
     1818           end.
     1819           assign
     1820             v-object-handle = v-object-handle :next-sibling
     1821           .
     1822         end.
     1823         assign
     1824           v-field-group-handle = v-field-group-handle :next-sibling
     1825         .
     1826       end.
     1827       do with frame Dialog-Frame
     1828       :
     1829         hide v-diasize-resize-button .
     1830         v-diasize-resize-button :row = 1.
     1831         v-diasize-resize-button :column = 1.
     1832       end.
     1833       if p-change-value > 0
     1834       then do:
     1835         if frame Dialog-Frame :scrollable = true
     1836         then do:
     1837           assign
     1838             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1839             no-error .
     1840           if error-status :error
     1841           or error-status :get-message(1) <> ""
     1842           then do:
     1843             undo move_block, retry move_block.
     1844           end.
     1845         end.
     1846         assign
     1847           frame Dialog-Frame :width = v-frame-width + p-change-value
     1848           no-error .
     1849         if error-status :error
     1850         or error-status :get-message(1) <> ""
     1851         then do:
     1852           undo move_block, retry move_block.
     1853         end.
     1854         assign
     1855           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1856         no-error .
     1857         if error-status :error
     1858         or error-status :get-message(1) <> ""
     1859         then do:
     1860           undo move_block, retry move_block.
     1861         end.
     1862         for each buf_temp-browse-handle
     1863           where buf_temp-browse-handle.browse-type = 'width':u
     1864         on error undo move_block, retry move_block
     1865         :
     1866           assign
     1867             buf_temp-browse-handle.browse-handle :width
     1868               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1869             no-error .
     1870           if error-status :error
     1871           or error-status :get-message(1) <> ""
     1872           then do:
     1873             undo move_block, retry move_block .
     1874           end.
     1875         end.
     1876         for each buf_temp-diasize-handle
     1877         on error undo move_block, retry move_block
     1878         :
     1879           assign
     1880             v-object-handle = buf_temp-diasize-handle.handle-value
     1881           .
     1882           if v-object-handle <> v-diasize-resize-button
     1883           then do:
     1884             assign
     1885               v-object-handle :col = v-object-handle :col + p-change-value
     1886               no-error .
     1887             if error-status :error
     1888             or error-status :get-message(1) <> ""
     1889             then do:
     1890               undo move_block, retry move_block .
     1891             end.
     1892           end.
     1893         end.
     1894       end.
     1895       else do:
     1896         for each buf_temp-diasize-handle
     1897         on error undo move_block, retry move_block
     1898         :
     1899           assign
     1900             v-object-handle = buf_temp-diasize-handle.handle-value
     1901           .
     1902           if v-object-handle <> v-diasize-resize-button
     1903           then do:
     1904             assign
     1905               v-object-handle :col = v-object-handle :col + p-change-value
     1906               no-error .
     1907             if error-status :error
     1908             or error-status :get-message(1) <> ""
     1909             then do:
     1910               undo move_block, retry move_block .
     1911             end.
     1912           end.
     1913         end.
     1914         for each buf_temp-browse-handle
     1915           where buf_temp-browse-handle.browse-type = 'width':u
     1916         on error undo move_block, retry move_block
     1917         :
     1918           assign
     1919             buf_temp-browse-handle.browse-handle :width
     1920               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1921             no-error .
     1922           if error-status :error
     1923           or error-status :get-message(1) <> ""
     1924           then do:
     1925             undo move_block, retry move_block .
     1926           end.
     1927         end.
     1928         assign
     1929           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1930           no-error .
     1931         if error-status :error
     1932         or error-status :get-message(1) <> ""
     1933         then do:
     1934           undo move_block, retry move_block.
     1935         end.
     1936         assign
     1937           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1938         no-error .
     1939         if error-status :error
     1940         or error-status :get-message(1) <> ""
     1941         then do:
     1942           undo move_block, retry move_block.
     1943         end.
     1944         if frame Dialog-Frame :scrollable = true
     1945         then do:
     1946           assign
     1947             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1948           no-error .
     1949           if error-status :error
     1950           or error-status :get-message(1) <> ""
     1951           then do:
     1952             undo move_block, retry move_block.
     1953           end.
     1954         end.
     1955       end.
     1956       if p-move-resize
     1957       then do:
     1958         run diasize_position-resize-button in this-procedure .
     1959       end.
     1960       if v-diasize-wndstore = true
     1961       then do:
     1962         if connected("ub") = true
     1963         then do:
     1964           define variable v-cntxt-db-num        as integer   no-undo .
     1965           define variable v-cntxt-userid        as character no-undo .
     1966           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1967                                             , OUTPUT v-cntxt-userid
     1968                                             ) .
     1969           run gbl/wndsizew.p
     1970             (input  v-cntxt-db-num
     1971             ,input  v-cntxt-userid
     1972             ,input  v-diasize-proc-name
     1973             ,input  'width':u
     1974             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1975             ) .
     1976         end.
     1977       end.
     1978     end.
     1979     assign
     1980       v-diasize-change-size = false
     1981     .
     1982   end procedure.
     1983   procedure diasize_set-width :
     1984     define input  parameter p-new-width  as decimal   no-undo .
     1985     define input  parameter p-move-resize as logical   no-undo .
     1986     do
     1987     on error undo, return error return-value
     1988     :
     1989       run diasize_change-width in this-procedure
     1990         (input  (p-new-width - frame Dialog-Frame :width)
     1991         ,input  p-move-resize
     1992         ) .
     1993     end.
     1994   end procedure.
     1995   procedure diasize_position-resize-button :
     1996     do with frame Dialog-Frame
     1997     :
     1998       hide v-diasize-resize-button .
     1999       assign
     2000         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2001                     - 1
     2002                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2003         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2004                     - 1
     2005                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2006       .
     2007       view v-diasize-resize-button .
     2008     end.
     2009   end procedure.
     2010   on alt-right anywhere
     2011   do:
     2012     run diasize_change-width in this-procedure
     2013       (input 1
     2014       ,input true
     2015       ) .
     2016     return no-apply .
     2017   end.
     2018   on alt-left anywhere
     2019   do:
     2020     run diasize_change-width in this-procedure
     2021       (input -1
     2022       ,input true
     2023       ) .
     2024     return no-apply .
     2025   end.
     2026   on alt-down anywhere
     2027   do:
     2028     run diasize_change-height in this-procedure
     2029       (input 1
     2030       ,input true
     2031       ) .
     2032     return no-apply .
     2033   end.
     2034   on alt-up anywhere
     2035   do:
     2036     run diasize_change-height in this-procedure
     2037       (input -1
     2038       ,input true
     2039       ) .
     2040     return no-apply .
     2041   end.
     2042   on alt-enter of frame Dialog-Frame
     2043   do:
     2044     run diasize_maximize in this-procedure
     2045       (input  ?
     2046       ).
     2047     return no-apply .
     2048   end.
     2049   procedure diasize_end-move :
     2050     do
     2051     on error undo, return error return-value
     2052     :
     2053       define variable v-row-delta as decimal   no-undo .
     2054       define variable v-col-delta as decimal   no-undo .
     2055       define variable v-new-row as decimal   no-undo .
     2056       define variable v-new-col as decimal   no-undo .
     2057       assign
     2058         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2059         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2060       .
     2061       assign
     2062         v-row-delta = v-new-row - frame Dialog-Frame :height
     2063         v-col-delta = v-new-col - frame Dialog-Frame :width
     2064       .
     2065       run diasize_change-height in this-procedure
     2066         (input v-row-delta
     2067         ,input true
     2068         ) .
     2069       run diasize_change-width in this-procedure
     2070         (input v-col-delta
     2071         ,input true
     2072         ) .
     2073     end.
     2074   end procedure.
     2075   procedure diasize_maximize :
     2076     define input  parameter p-action as logical   no-undo .
     2077     do
     2078     on error undo, return error return-value
     2079     :
     2080       if p-action = ?
     2081       then do:
     2082         if v-diasize-need-maximize = true
     2083         then do:
     2084           assign
     2085             p-action = true
     2086           .
     2087         end.
     2088         else do:
     2089           assign
     2090             p-action = false
     2091           .
     2092         end.
     2093       end.
     2094       if p-action = true
     2095       then do:
     2096         run diasize_change-height in this-procedure
     2097           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2098               - frame Dialog-Frame :height-chars
     2099           ,input true
     2100           ) .
     2101         run diasize_change-width in this-procedure
     2102           (input session :width-chars
     2103               - frame Dialog-Frame :width-chars
     2104           ,input true
     2105           ) .
     2106         assign
     2107           v-diasize-need-maximize = false
     2108         .
     2109       end.
     2110       else do:
     2111         run diasize_change-width in this-procedure
     2112           (input v-diasize-orig-frame-width
     2113               - frame Dialog-Frame :width-chars
     2114           ,input true
     2115           ) .
     2116         run diasize_change-height in this-procedure
     2117           (input v-diasize-orig-frame-height
     2118               - frame Dialog-Frame :height-chars
     2119           ,input true
     2120           ) .
     2121         assign
     2122           v-diasize-need-maximize = true
     2123         .
     2124       end.
     2125     end.
     2126   end procedure.
     2127   procedure diasize_restore-orig-size :
     2128     do
     2129     on error undo, return error return-value
     2130     :
     2131       assign
     2132         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2133         v-diasize-current-frame-height = frame Dialog-Frame :height
     2134       .
     2135       run diasize_set-height in this-procedure
     2136         (input  v-diasize-orig-frame-height
     2137         ,input  true
     2138         ) .
     2139       run diasize_set-width in this-procedure
     2140         (input  v-diasize-orig-frame-width
     2141         ,input  true
     2142         ) .
     2143     end.
     2144   end procedure.
     2145   procedure diasize_restore-current-size :
     2146     do
     2147     on error undo, return error return-value
     2148     :
     2149       run diasize_set-height in this-procedure
     2150         (input  v-diasize-current-frame-height
     2151         ,input  true
     2152         ) .
     2153       run diasize_set-width in this-procedure
     2154         (input  v-diasize-current-frame-width
     2155         ,input  true
     2156         ) .
     2157     end.
     2158   end procedure.
     2159   procedure diasize_set-browse-handle :
     2160     define input  parameter p-browse-handle as handle   no-undo .
     2161     define buffer buf_temp-browse-handle for temp-browse-handle .
     2162     do
     2163     on error undo, return error return-value
     2164     :
     2165       assign
     2166         v-diasize-browse-handle = p-browse-handle
     2167       .
     2168       for each buf_temp-browse-handle
     2169       on error undo, return error return-value
     2170       :
     2171         delete buf_temp-browse-handle .
     2172       end.
     2173     end.
     2174   end procedure.
     2175   procedure diasize_add_browse :
     2176     define input  parameter p-browse-type   as character no-undo .
     2177     define input  parameter p-browse-handle as handle    no-undo .
     2178     define buffer buf_temp-browse-handle for temp-browse-handle .
     2179     do
     2180     on error undo, return error return-value
     2181     :
     2182       assign
     2183         v-diasize-browse-number = v-diasize-browse-number + 1
     2184       .
     2185       create buf_temp-browse-handle .
     2186       assign
     2187         buf_temp-browse-handle.browse-type   = p-browse-type
     2188         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2189         buf_temp-browse-handle.browse-handle = p-browse-handle
     2190       .
     2191     end.
     2192   end procedure.
     2193   procedure diasize_init :
     2194     define variable v-default-value    as logical   no-undo .
     2195     define variable v-restore-saved    as logical   no-undo .
     2196     define variable v-resize-value-str as character no-undo .
     2197     do
     2198     on error undo, return error return-value
     2199     :
     2200       do with frame Dialog-Frame
     2201       :
     2202         assign
     2203           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2204           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2205           v-diasize-browse-handle     = browse br-wi-mode :handle
     2206         .
     2207         create button v-diasize-resize-button
     2208         assign
     2209           parent        = frame Dialog-Frame :first-child
     2210           label         = "s"
     2211           height-pixels = 16
     2212           width-pixels  = 16
     2213           visible       = true
     2214           sensitive     = true
     2215           movable       = true
     2216           triggers:
     2217             on end-move persistent run diasize_end-move in this-procedure .
     2218           end triggers.
     2219         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2220         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2221         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2222         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2223         assign
     2224           v-diasize-wndmax = false
     2225         .
     2226         if connected("ub") = true
     2227         then do:
     2228           define variable v-cntxt-db-num        as integer   no-undo .
     2229           define variable v-cntxt-userid        as character no-undo .
     2230           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2231                                             , OUTPUT v-cntxt-userid
     2232                                             ) .
     2233           run gbl/wndpar_r.p
     2234             (input  v-cntxt-db-num
     2235             ,input  v-cntxt-userid
     2236             ,input  'wndmax':U
     2237             ,output v-diasize-wndmax
     2238             ,output v-default-value
     2239             ) .
     2240         end.
     2241         assign
     2242           v-diasize-wndstore = false
     2243         .
     2244         if connected("ub") = true
     2245         then do:
     2246           run gbl/wndpar_r.p
     2247             (input  v-cntxt-db-num
     2248             ,input  v-cntxt-userid
     2249             ,input  'wndstore':U
     2250             ,output v-diasize-wndstore
     2251             ,output v-default-value
     2252             ) .
     2253         end.
     2254         assign
     2255           v-diasize-proc-name = entry(1, program-name(2), '.')
     2256         .
     2257         if v-diasize-wndstore = true
     2258         then do:
     2259           assign
     2260             v-restore-saved = false
     2261           .
     2262           if connected("ub") = true
     2263           then do:
     2264             run gbl/wndsizer.p
     2265               (input  v-cntxt-db-num
     2266               ,input  v-cntxt-userid
     2267               ,input  v-diasize-proc-name
     2268               ,input  'height':u
     2269               ,output v-resize-value-str
     2270               ) .
     2271             if v-resize-value-str <> '':U
     2272             then do:
     2273               run diasize_change-height in this-procedure
     2274                 (input  integer(v-resize-value-str)
     2275                 ,input  true
     2276                 ) .
     2277               assign
     2278                 v-restore-saved = true
     2279               .
     2280             end.
     2281           end.
     2282           if connected("ub") = true
     2283           then do:
     2284             run gbl/wndsizer.p
     2285               (input  v-cntxt-db-num
     2286               ,input  v-cntxt-userid
     2287               ,input  v-diasize-proc-name
     2288               ,input  'width':u
     2289               ,output v-resize-value-str
     2290               ) .
     2291             if v-resize-value-str <> '':U
     2292             then do:
     2293               run diasize_change-width in this-procedure
     2294                 (input  integer(v-resize-value-str)
     2295                 ,input  true
     2296                 ) .
     2297               assign
     2298                 v-restore-saved = true
     2299               .
     2300             end.
     2301           end.
     2302           if v-restore-saved <> true
     2303           then do:
     2304             if v-diasize-wndmax = true
     2305             then do:
     2306               run diasize_maximize in this-procedure
     2307                 (input  true
     2308                 ) .
     2309             end.
     2310           end.
     2311         end.
     2312         else do:
     2313           if v-diasize-wndmax = true
     2314           then do:
     2315             run diasize_maximize in this-procedure
     2316               (input  true
     2317               ) .
     2318           end.
     2319         end.
     2320       end.
     2321     end.
     2322   end procedure.
     2323   procedure diasize_need-full-display :
     2324     define output parameter p-need-full-display as logical   no-undo .
     2325     do
     2326     on error undo, return error return-value
     2327     :
     2328       assign
     2329         p-need-full-display = v-diasize-need-full-display
     2330       .
     2331       assign
     2332         v-diasize-need-full-display = false
     2333       .
     2334     end.
     2335   end procedure.
     2336   procedure get-context :
     2337      define output parameter p-db-num as integer          no-undo.
     2338      define output parameter p-user-id as character        no-undo.
     2339      define variable v-login               as character    no-undo.
     2340      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2341      define buffer buf_user-login  for ub.user-login .
     2342      do
     2343      on error undo, return error
     2344      :
     2345            FIND FIRST buf_sys-ctrl no-lock.
     2346            ASSIGN
     2347               v-login = USERID("ub")
     2348               p-db-num = buf_sys-ctrl.db-num
     2349            .
     2350            FIND FIRST buf_user-login
     2351                 WHERE buf_user-login.db-num = p-db-num
     2352                   AND buf_user-login.user-login = v-login
     2353                 no-lock
     2354                 no-error
     2355                 .
     2356            IF AVAILABLE buf_user-login
     2357            THEN DO:
     2358               assign
     2359                  p-user-id = buf_user-login.user-id
     2360               .
     2361            END.
     2362      end.
     2363   end procedure.
     2364       run diasize_init in this-procedure .
     2365   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2366   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2367   MAIN-BLOCK:
     2368   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2369      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2370   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2371     run mainmenu_getcntxt in parparentproc
     2372       (output v-cntxt-db-num
     2373       ,output v-cntxt-userid
     2374       ,output v-cntxt-level
     2375       ,output v-cntxt-host-code-obj
     2376       ,output v-cntxt-obj-type
     2377       ,output v-cntxt-obj-code
     2378       ,output v-cntxt-db-num-obj
     2379       ,output v-cntxt-is-admin
     2380       ) .
     2381     v-admin = lookup('admin', bttns) > 0.
     2382     if p-list-mode = "mode-type"
     2383     and lookup(p-mode-type, 'cd-IBS-TH':U) = 0 then do:
     2384       message
     2385       substitute("Неверное значение параметра p-mode-type = &1", p-mode-type)
     2386       view-as alert-box error .
     2387       undo main-block, return error .
     2388     end.
     2389     run Myenable in this-procedure .
     2390     v-rid-list = p-rid-list.
     2391     WAIT-FOR GO OF FRAME Dialog-Frame.
     2392   END.
     2393   RUN disable_UI.
     2394   PROCEDURE disable_UI :
     2395     HIDE FRAME Dialog-Frame.
     2396   END PROCEDURE.
     2397   PROCEDURE enable_UI :
     2398     DISPLAY e-des mark-num
     2399         WITH FRAME Dialog-Frame.
     2400     ENABLE b-quit b-mark b-sel b-add b-chg b-del b-lkp B-Help br-wi-mode e-des
     2401            mark-num
     2402         WITH FRAME Dialog-Frame.
     2403     VIEW FRAME Dialog-Frame.
     2404   END PROCEDURE.
     2405   PROCEDURE MyEnable :
     2406   define variable v-h as handle no-undo .
     2407   define variable vh-mode-type-name as handle no-undo .
     2408   ASSIGN
     2409   v-h = br-wi-mode:FIRST-COLUMN in frame Dialog-Frame
     2410   .
     2411   DO while valid-handle(v-h) :
     2412     if v-h:LABEL = "Тип режима" then do:
     2413       vh-mode-type-name = v-h.
     2414       leave.
     2415     end.
     2416     ELSE DO:
     2417       v-h = v-h:NEXT-COLUMN.
     2418     END.
     2419   END.
     2420   ASSIGN
     2421   X_wi-mode.mode-name:RESIZABLE IN BROWSE br-wi-mode = YES
     2422   vh-mode-type-name:RESIZABLE = YES
     2423   vh-mode-type-name:visible = not (p-list-mode = "mode-type")
     2424   .
     2425   ENABLE
     2426   b-quit
     2427   b-add when (lookup("b-add", bttns) > 0)
     2428   b-chg when (lookup("b-add", bttns) > 0)
     2429   b-del when (lookup("b-add", bttns) > 0)
     2430   b-lkp
     2431   B-Help
     2432   b-mark when lookup("b-mark", bttns) > 0
     2433   b-sel when lookup("b-sel", bttns) > 0
     2434   br-wi-mode
     2435   WITH FRAME Dialog-Frame.
     2436   VIEW FRAME Dialog-Frame.
     2437   run Openbr in this-procedure .
     2438   APPLY "VALUE-CHANGED" TO br-wi-mode.
     2439   END PROCEDURE.
     2440   PROCEDURE Openbr :
     2441   CASE p-list-mode:
     2442      when 'все':U then do:
     2443         frame Dialog-Frame :title = "Все режимы".
     2444         OPEN QUERY br-wi-mode
     2445         FOR EACH X_wi-mode NO-LOCK where X_wi-mode.mode-id > '' INDEXED-REPOSITION.
     2446      end.
     2447      when "mode-type" then do:
     2448         frame Dialog-Frame :title = substitute("Режимы типа &1", p-mode-type).
     2449         OPEN QUERY br-wi-mode
     2450         FOR EACH X_wi-mode NO-LOCK where
     2451                  X_wi-mode.mode-type = p-mode-type
     2452        INDEXED-REPOSITION
     2453         .
     2454      end.
     2455   end case.
     2456   END PROCEDURE.
     2457   PROCEDURE proc-b-lkp :
     2458   DEFINE INPUT PARAMETER p-option AS CHARACTER NO-UNDO.
     2459   define variable v-rec as recid no-undo.
     2460   CASE p-option:
     2461     WHEN 'wi-mode':U THEN DO:
     2462         run adm/wi-modei.w ( input parparentproc
     2463                              ,input 'ПРОСМОТР':U + chr(44) + (if v-admin then "admin" else '')
     2464                              ,input X_wi-mode.mode-type
     2465                              ,input X_wi-mode.mode-id
     2466                              ,input-output v-rec) no-error.
     2467     END.
     2468   END CASE.
     2469   IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     2470   END PROCEDURE.
