        1   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE       NO-UNDO.
        2   DEFINE INPUT PARAMETER p-mode        AS CHARACTER           NO-UNDO.
        3   DEFINE INPUT PARAMETER p-obj-type  LIKE ub.clients.obj-type NO-UNDO.
        4   DEFINE INPUT PARAMETER p-obj-code  LIKE ub.shop.obj-code    NO-UNDO.
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "????????? ????".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   procedure proc-alt-shift-f2:
       72     if not ibs.th.gbl.gbl-var:rcode
       73   then
       74     run gbl\inidebug.p .
       75   end.
       76   procedure proc-alt-shift-f3:
       77     run gbl/prvssinf.p
       78       ( input this-procedure
       79       ) .
       80   end.
       81   define variable v-inform-launched as logical no-undo initial false .
       82   procedure proc-alt-shift-f4:
       83     define variable v-action as character no-undo .
       84     if v-inform-launched = false then do:
       85       assign
       86         v-inform-launched = true
       87       .
       88       run gbl/d-inform.w
       89         (  input self
       90         ,  input this-procedure
       91         , output v-action
       92         ) no-error .
       93       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       94       assign
       95         v-inform-launched = false
       96       .
       97     end.
       98   end.
       99   procedure proc-alt-f1:
      100     run gbl/corrhelp.p
      101       (input this-procedure
      102       ) .
      103   end .
      104   on alt-shift-f2 anywhere do:
      105     run proc-alt-shift-f2.
      106   end.
      107   on alt-shift-f3 anywhere do:
      108     run proc-alt-shift-f3 in this-procedure .
      109   end.
      110   on alt-shift-f4 anywhere do:
      111     run proc-alt-shift-f4 in this-procedure.
      112   end.
      113   on alt-f1 anywhere do:
      114     run proc-alt-f1 in this-procedure .
      115   end.
      116   DEFINE BUFFER locked_thbj-attr FOR ub.thbj-attr.
      117   define new global shared variable g#attr-lib  as handle no-undo .
      118   define variable v-attr-lib-variable as handle no-undo .
      119   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      120   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      121   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      122   procedure thbjattr_code :
      123      define input  parameter p-upper-code     as character no-undo .
      124      define input  parameter p-code           as character no-undo .
      125      define output parameter p-label          as character no-undo .
      126      define output parameter p-user-can-edit  as logical   no-undo .
      127      define output parameter p-output-display as logical   no-undo .
      128      define output parameter p-other          as character no-undo .
      129      define output parameter p-prop-list      as character no-undo .
      130      define output parameter p-prop-type-list as character no-undo .
      131      define output parameter p-prop-label-list as character no-undo .
      132      define output parameter p-global          as logical no-undo .
      133      define output parameter p-host           as logical no-undo .
      134      define output parameter p-shop           as logical no-undo .
      135      define output parameter p-store          as logical no-undo .
      136      define output parameter p-db             as logical no-undo .
      137      define variable p-region as logical no-undo.
      138      run thbjattr_code_reg in this-procedure (
      139                                               p-upper-code,
      140                                               p-code,
      141                                               output p-label,
      142                                               output p-user-can-edit,
      143                                               output p-output-display,
      144                                               output p-other,
      145                                               output p-prop-list,
      146                                               output p-prop-type-list,
      147                                               output p-prop-label-list,
      148                                               output p-global,
      149                                               output p-host,
      150                                               output p-shop,
      151                                               output p-store,
      152                                               output p-db,
      153                                               output p-region
      154                                               ).
      155   end procedure.
      156   procedure thbjattr_code_reg :
      157   define input  parameter p-upper-code     as character no-undo .
      158   define input  parameter p-code           as character no-undo .
      159   define output parameter p-label          as character no-undo .
      160   define output parameter p-user-can-edit  as logical   no-undo .
      161   define output parameter p-output-display as logical   no-undo .
      162   define output parameter p-other          as character no-undo .
      163   define output parameter p-prop-list      as character no-undo .
      164   define output parameter p-prop-type-list as character no-undo .
      165   define output parameter p-prop-label-list as character no-undo .
      166   define output parameter p-global          as logical no-undo .
      167   define output parameter p-host           as logical no-undo .
      168   define output parameter p-shop           as logical no-undo .
      169   define output parameter p-store          as logical no-undo .
      170   define output parameter p-db             as logical no-undo .
      171   define output parameter p-region         as logical no-undo .
      172   do
      173   on error undo, return error return-value
      174   :
      175       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      176       (input  p-upper-code
      177       ,input  p-code
      178       ,output p-label
      179       ,output p-user-can-edit
      180       ,output p-output-display
      181       ,output p-other
      182       ,output p-prop-list
      183       ,output p-prop-type-list
      184       ,output p-prop-label-list
      185       ,output p-global
      186       ,output p-host
      187       ,output p-shop
      188       ,output p-store
      189       ,output p-db
      190       ,output p-region
      191       ) no-error .
      192     if error-status :error
      193     then do:
      194       undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      195     end.
      196   end.
      197   end procedure.
