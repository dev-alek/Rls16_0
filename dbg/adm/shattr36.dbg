      408   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      409   define variable v-tth           as handle   no-undo .
      410   define variable v-to-create    as logical      no-undo.
      411   DEFINE BUTTON b-exit AUTO-GO
      412        LABEL "&Ввод"
      413        SIZE 10 BY 1
      414        BGCOLOR 8 .
      415   DEFINE BUTTON b-help
      416        LABEL "Помо&щь"
      417        SIZE 10 BY 1
      418        BGCOLOR 8 .
      419   DEFINE BUTTON b-quit AUTO-END-KEY
      420        LABEL "&Отмена"
      421        SIZE 10 BY 1
      422        BGCOLOR 8 .
      423   DEFINE VARIABLE v-diffshft AS INTEGER FORMAT ">>9":U INITIAL 0
      424        VIEW-AS FILL-IN
      425        SIZE 8 BY 1 NO-UNDO.
      426   DEFINE VARIABLE v-difftime AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
      427        VIEW-AS FILL-IN
      428        SIZE 8 BY 1 NO-UNDO.
      429   DEFINE VARIABLE tb-autodate AS LOGICAL INITIAL no
      430        LABEL "Автоматическое изменение даты на обычном объекте"
      431        VIEW-AS TOGGLE-BOX
      432        SIZE 50.5 BY .83 TOOLTIP "Автоматическое изменение даты для обычных объектов" NO-UNDO.
      433   DEFINE VARIABLE tb-autodtsh AS LOGICAL INITIAL no
      434        LABEL "Автоматическое изменение даты на сменном объекте"
      435        VIEW-AS TOGGLE-BOX
      436        SIZE 51 BY .83 NO-UNDO.
      437   DEFINE VARIABLE tb-newordsh AS LOGICAL INITIAL no
      438        LABEL "Новый принцип формирования номеров смен"
      439        VIEW-AS TOGGLE-BOX
      440        SIZE 50.5 BY .83 NO-UNDO.
      441   DEFINE FRAME Dialog-Frame
      442        b-exit AT ROW 1 COL 1
      443        b-quit AT ROW 1 COL 11
      444        b-help AT ROW 1 COL 46.5
      445        tb-autodate AT ROW 3 COL 6 WIDGET-ID 2
      446        tb-autodtsh AT ROW 4 COL 6 WIDGET-ID 4
      447        tb-newordsh AT ROW 5 COL 6 WIDGET-ID 10
      448        v-diffshft AT ROW 6 COL 4 COLON-ALIGNED NO-LABEL WIDGET-ID 6
      449        v-difftime AT ROW 7.25 COL 4 COLON-ALIGNED NO-LABEL WIDGET-ID 22
      450        "- Допустимая разница между календарной и сменной датами" VIEW-AS TEXT
      451             SIZE 57.5 BY 1 AT ROW 6 COL 15 WIDGET-ID 12
      452        "- Допустимое превышение ВРЕМЕНИ ЗАКРЫТИЯ СМЕНЫ над текущим (в минутах)" VIEW-AS TEXT
      453             SIZE 70.5 BY 1 AT ROW 7.25 COL 15 WIDGET-ID 18
      454        SPACE(2.37) SKIP(0.49)
      455       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      456            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      457            TITLE "Настройка даты и смены на объекте"
      458            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit WIDGET-ID 100.
      459   ASSIGN
      460          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      461          FRAME Dialog-Frame:HIDDEN           = TRUE.
      462   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      463   DO:
      464     APPLY "END-ERROR":U TO SELF.
      465   END.
      466   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      467   DO:
      468      if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      469         run save-attr in this-procedure
      470           no-error .
      471         if error-status :error then do:
      472           return no-apply .
      473         end.
      474      END.
      475   END.
      476   ON CHOOSE OF b-help IN FRAME Dialog-Frame
      477   OR HELP OF FRAME Dialog-Frame
      478   DO:
      479     MESSAGE "Help for File: c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\adm\shattr36.w" VIEW-AS ALERT-BOX INFORMATION.
      480   END.
      481   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      482   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      483   MAIN-BLOCK:
      484   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      485      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      486      CASE p-obj-type:
      487         WHEN ""
      488         THEN DO:
      489            ASSIGN
      490               FRAME Dialog-Frame:TITLE = FRAME Dialog-Frame:TITLE + " глобально"
      491            .
      492         END.
      493         WHEN 'орг':U
      494         THEN DO:
      495            ASSIGN
      496               FRAME Dialog-Frame:TITLE = FRAME Dialog-Frame:TITLE + SUBSTITUTE(" по фирме &1", p-obj-code)
      497            .
      498         END.
      499         WHEN 'маг':U OR
      500         WHEN 'скл':U
      501         THEN DO:
      502            ASSIGN
      503               FRAME Dialog-Frame:TITLE = FRAME Dialog-Frame:TITLE + SUBSTITUTE(" &1 &2", p-obj-type, p-obj-code)
      504            .
      505         END.
      506         OTHERWISE DO:
      507         END.
      508      END CASE.
      509   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      510   on help of frame Dialog-Frame
      511   do:
      512     run gbl/app_help.p
      513       (input this-procedure :file-name
      514       ,input ''
      515       ,input ?
      516       ) no-error.
      517     if error-status :error then do:
      518       message
      519         "Ошибка при вызове помощи"
      520         error-status :get-message(1)
      521         view-as alert-box .
      522     end.
      523   end.
      524   run minbtn-set in this-procedure .
      525   on choose of b-help in frame Dialog-Frame
      526   do:
      527     apply "help":u to frame Dialog-Frame .
      528   end.
      529   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      530   procedure minbtn-set :
      531       do
      532           on error undo, return error return-value
      533           :
      534           define variable ii              as integer       no-undo .
      535           define variable fh              as widget-handle no-undo .
      536           define variable hh              as widget-handle no-undo .
      537           define variable v-h             as handle        extent 4 no-undo .
      538           define variable v-name-button   as character     no-undo .
      539           define variable v-help-old-x    as decimal       no-undo .
      540           define variable v-help-old-y    as decimal       no-undo .
      541           define variable v-help-old-size as decimal       no-undo .
      542           define variable v-frame-width   as decimal       no-undo .
      543           define variable jj              as integer       no-undo .
      544           do
      545               on error undo, return error
      546               :
      547               assign
      548                   v-frame-width = frame Dialog-Frame:width - 0.3
      549                   fh            = frame Dialog-Frame:first-child
      550                   hh            = fh:first-child
      551                   ii            = 1
      552                   .
      553               do while valid-handle(hh):
      554                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      555                   do:
      556                       case lc(hh:name) :
      557                           when "b-help" then
      558                               do:
      559                                   hh:load-image-up("cmp/b-help.bmp":u) .
      560                                   hh:load-image-down("cmp/b-help.bmp":u) .
      561                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      562                                   hh:TOOLTIP = "Помощь" .
      563                                   v-help-old-x = hh:column .
      564                                   v-help-old-y = hh:row    .
      565                                   v-help-old-size = hh:width .
      566                                   hh:width-chars = 2.5 .
      567                               end.
      568                           when "b-print" then
      569                               do:
      570                                   hh:load-image("cmp/b-print.bmp":u) .
      571                                   hh:TOOLTIP = "Печать" .
      572                                   v-h[ii] = hh:handle .
      573                                   ii = ii + 1 .
      574                                   hh:width-chars = 3 .
      575                               end.
      576                           when "b-history" or
      577                           when "b-hist" then
      578                               do:
      579                                   hh:load-image("cmp/b-hist.bmp":u) .
      580                                   hh:TOOLTIP = "История" .
      581                                   v-h[ii] = hh:handle .
      582                                   ii = ii + 1 .
      583                                   hh:width-chars = 3 .
      584                               end.
      585                           when "b-sch" then
      586                               do:
      587                                   hh:load-image("cmp/b-sch.bmp":u) .
      588                                   hh:TOOLTIP = "Установка Фильтра" .
      589                                   v-h[ii] = hh:handle .
      590                                   ii = ii + 1 .
      591                                   hh:width-chars = 3 .
      592                               end.
      593                           when "b-hist-user" then
      594                               do:
      595                                   hh:load-image("cmp/b-hist.bmp":u) .
      596                                   hh:TOOLTIP = "История пользователя" .
      597                                   ii = ii + 1 .
      598                               end.
      599                       end case.
      600                   end.
      601                   hh = hh:next-sibling.
      602               end.
      603               b-help:column = v-frame-width - b-help:width-chars.
      604               jj = 0.
      605               repeat ii = 4 to 1 by -1 :
      606                   if valid-handle (v-h[ii] ) then
      607                   do:
      608                       jj  = jj + 1 .
      609                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      610                       v-h[ii]:row    = v-help-old-y .
      611                   end.
      612               end.
      613           end.
      614       end.
      615   end procedure.
      616     if  p-mode <> 'ПРОСМОТР':U and
      617         p-mode <> 'ИЗМЕНЕНИЕ':U
      618     then do:
      619         message
      620         vss-workfile vss-revision vss-description skip
      621         "Неизвестный режим вызова" p-mode
      622         view-as alert-box error.
      623         undo, return error.
      624     end.
      625     RUN load-attr IN THIS-PROCEDURE .
      626     RUN enable_UI.
      627     RUN post_enable_UI IN THIS-PROCEDURE.
      628     WAIT-FOR GO OF FRAME Dialog-Frame.
      629   END.
      630   RUN disable_UI.
      631   PROCEDURE disable_UI :
      632     HIDE FRAME Dialog-Frame.
      633   END PROCEDURE.
      634   PROCEDURE enable_UI :
      635     DISPLAY tb-autodate tb-autodtsh tb-newordsh v-diffshft v-difftime
      636         WITH FRAME Dialog-Frame.
      637     ENABLE b-exit b-quit b-help tb-autodate tb-autodtsh tb-newordsh v-diffshft
      638            v-difftime
      639         WITH FRAME Dialog-Frame.
      640     VIEW FRAME Dialog-Frame.
      641   END PROCEDURE.
      642   PROCEDURE load-attr :
      643   define variable v-value-character as character      no-undo .
      644   define variable v-value-date      as date           no-undo .
      645   define variable v-value-decimal   as decimal        no-undo .
      646   define variable v-value-integer   as integer        no-undo .
      647   define variable v-value-logical   as logical        no-undo .
      648   define variable v-param-type      as character      no-undo .
      649   define variable v-entry           as character  no-undo .
      650   do
      651   on error undo, return error
      652   :
      653      if p-mode = 'ИЗМЕНЕНИЕ':U then
      654      do
      655      transaction
      656      :
      657         find first locked_thbj-attr
      658               where locked_thbj-attr.upper-prop-code = 'obj-date':U
      659               exclusive-lock
      660               no-wait
      661               no-error
      662               .
      663         if locked locked_thbj-attr then do:
      664            message
      665               vss-workfile vss-revision vss-description skip
      666                  "Запись настроек занята другим пользователем"
      667               view-as alert-box error .
      668            undo, return error.
      669         end.
      670      end.
      671      else do:
      672         find first locked_thbj-attr
      673               where locked_thbj-attr.upper-prop-code = 'obj-date':U
      674               no-lock
      675               no-error
      676               .
      677      end.
      678      if not available locked_thbj-attr then do:
      679         assign
      680            v-to-create  = yes
      681         .
      682         message
      683            substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
      684                        chr(10)
      685                        )
      686         view-as alert-box WARNING.
      687      end.
      688      assign
      689         v-tth = buffer thbjattr_thbj-attr:table-handle
      690      .
      691      empty temp-table thbjattr_thbj-attr.
      692      empty temp-table temp-thbj-attr.
      693     run adm/shattri.p (
      694                   input "init":U
      695                 , input p-obj-type
      696                 , input p-obj-code
      697                 , input 'obj-date':U
      698                 , input "":U
      699                 , output v-value-character
      700                 , output v-value-date
      701                 , output v-value-decimal
      702                 , output v-value-integer
      703                 , output v-value-logical
      704                 , output v-param-type
      705                 , INPUT-OUTPUT table-handle v-tth
      706                 ) no-error .
      707     if error-status:error
      708     and not available locked_thbj-attr then do:
      709       message
      710       "Не удалось получить начальные значения настроек" skip
      711       error-status:get-message(1) return-value
      712       view-as alert-box error .
      713       undo, return error .
      714     end.
      715     for each thbjattr_thbj-attr:
      716       assign
      717         v-entry = thbjattr_thbj-attr.prop-code
      718       .
      719       case v-entry:
      720         when 'autodate':U then do:
      721           assign
      722             tb-autodate = thbjattr_thbj-attr.property-value-logical
      723             tb-autodate :private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
      724           .
      725         end.
      726         when 'autodtsh':U then do:
      727           assign
      728             tb-autodtsh = thbjattr_thbj-attr.property-value-logical
      729             tb-autodtsh :private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
      730           .
      731         end.
      732         when 'newordsh':U then do:
      733           assign
      734             tb-newordsh = thbjattr_thbj-attr.property-value-logical
      735             tb-newordsh :private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
      736           .
      737         end.
      738         when 'diffshft':U then do:
      739           assign
      740             v-diffshft = thbjattr_thbj-attr.property-value-integer
      741             v-diffshft :private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
      742           .
      743         end.
      744         when 'difftime':U then do:
      745           assign
      746             v-difftime = thbjattr_thbj-attr.property-value-integer
      747             v-difftime :private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
      748           .
      749         end.
      750       end case.
      751       create temp-thbj-attr.
      752       buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
      753     end.
      754   end.
      755   END PROCEDURE.
      756   PROCEDURE post_enable_UI :
      757   do
      758   on error undo, return error
      759   :
      760      if  p-mode = 'ПРОСМОТР':U
      761      then do:
      762         DISABLE
      763            tb-autodate
      764            tb-autodtsh
      765            tb-newordsh
      766            v-diffshft
      767            v-difftime
      768         WITH FRAME Dialog-Frame.
      769      END.
      770   END.
      771   END PROCEDURE.
      772   PROCEDURE save-attr :
      773   define variable v-value-character as character      no-undo .
      774   define variable v-value-date      as date           no-undo .
      775   define variable v-value-decimal   as decimal        no-undo .
      776   define variable v-value-integer   as integer        no-undo .
      777   define variable v-value-logical   as logical        no-undo .
      778   define variable v-param-type      as character      no-undo .
      779   define variable wh                as widget-handle  no-undo .
      780   define variable fh                as widget-handle  no-undo .
      781   define variable v-same            as logical        no-undo .
      782   do
      783   on error undo, return error
      784   :
      785      assign
      786      frame Dialog-Frame
      787         tb-autodate
      788         tb-autodtsh
      789         tb-newordsh
      790         v-diffshft
      791         v-difftime
      792         fh = frame Dialog-Frame:first-child
      793         wh = fh:first-child
      794      .
      795      do while valid-handle(wh):
      796         if wh:private-data begins "recid="
      797         then do:
      798            find first thbjattr_thbj-attr
      799            where recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '='))
      800            .
      801            assign
      802            buffer
      803            thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value
      804            .
      805         end.
      806         wh = wh:next-sibling.
      807      end.
      808      assign
      809         v-same = yes
      810      .
      811      for each thbjattr_thbj-attr,
      812            first temp-thbj-attr
      813            where temp-thbj-attr.obj-type          = thbjattr_thbj-attr.obj-type
      814               and temp-thbj-attr.obj-code         = thbjattr_thbj-attr.obj-code
      815               and temp-thbj-attr.upper-prop-code  = thbjattr_thbj-attr.upper-prop-code
      816               and temp-thbj-attr.prop-code        = thbjattr_thbj-attr.prop-code
      817      :
      818         buffer-compare thbjattr_thbj-attr to temp-thbj-attr save result in v-same.
      819         if not v-same then leave.
      820      end.
      821      if v-same  and not v-to-create then return.
      822      run adm/shattri.p ( input "check":U
      823                        , input p-obj-type
      824                        , input p-obj-code
      825                        , input 'obj-date':U
      826                        , INPUT '':U
      827                        , output v-value-character
      828                        , output v-value-date
      829                        , output v-value-decimal
      830                        , output v-value-integer
      831                        , output v-value-logical
      832                        , output v-param-type
      833                        , input-output table-handle v-tth
      834                        ) no-error .
      835      if error-status :error then do:
      836         message
      837            "Некорректное значение ПАРАМЕТРОВ"  skip
      838            error-status:get-message(1)         skip
      839            return-value
      840         view-as alert-box error .
      841         undo, return error .
      842      end.
      843      do transaction
      844      on error undo, return error return-value
      845      :
      846         run thbjattr_set-section in this-procedure ( input p-obj-type
      847                                                   , input p-obj-code
      848                                                   , input 'obj-date':U
      849                                                   , input table thbjattr_thbj-attr
      850                                                   ) no-error.
      851         if error-status:error then do:
      852            message
      853            error-status:get-message(1)  skip
      854            return-value
      855            view-as alert-box.
      856            undo, return error.
      857         end.
      858      end.
      859   end. END PROCEDURE.
