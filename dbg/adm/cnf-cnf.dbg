        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U.
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U.
        5   define variable vss-workfile    as character no-undo init "$Workfile: cnf-cnf.p $":U.
        6   define variable vss-archive     as character no-undo init "$Archive: adm/cnf-cnf.p $":U.
        7   define variable vss-description as character no-undo init "Процедуры работы с таблицей конфигурации".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define  shared temp-table cnf no-undo
       67       field param-code    as character   format "x(8)"        column-label "Код"                               field param-type    as character                        column-label "Тип"                               field param-value   as character   format "x(250)"      column-label "Значение"                          field param-encoded as character                        column-label "Кодированное значение"             field host-code     as integer                          column-label "Фирма"                             field obj-type      as character                        column-label "Тип объекта"                       field obj-code      as integer     format ">>>>>>"      column-label "Код объекта"                       field conf-type     as character                        column-label "Кодировка"                         field beg-date      as date                             column-label "Начало действия параметра"         field end-date      as date                             column-label "Окончание действия параметра"      field db-num        as integer     format ">>>>>"       column-label "БД"                                field stts          as integer                          column-label "Статус"
       68       field db-key        as character   format "x(12)"       column-label "Ключ БД"
       69       field param-PS      as character   format "x(40)"       column-label "PS"
       70       field param-name    as character   format "x(30)"       column-label "Название"
       71       field is-changed    as logical initial false            column-label "Изменен"
       72       field NotUsed       as logical initial False            column-label "Выключен"
       73       field ErrorExist    as integer initial 0  format ">>"   column-label "Уровень ошибки"
       74       index pi
       75         is unique
       76         param-code
       77         host-code
       78         obj-type
       79         obj-code
       80         beg-date
       81         end-date
       82         db-num
       83       index db-num
       84         db-num
       85       index db-key
       86         db-key
       87       index par-name
       88         is word-index
       89         param-name
       90       index par-value
       91         is word-index
       92         param-value
       93    .
       94   def  shared temp-table log-table no-undo
       95       field stroka       as character format "x(256)".
       96   def  shared variable err-level as integer no-undo.
       97   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       98   Function reverse returns character (str as character).
       99      define variable rev_incl_s as character init "" no-undo .
      100      define variable rev_incl_i as integer no-undo .
      101      define variable rev_incl_l as integer no-undo .
      102      rev_incl_l = length(str).
      103      do rev_incl_i = 1 to rev_incl_l:
      104         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      105      end.
      106      return rev_incl_s.
      107   end.
      108   procedure check-enc.
      109     define input  parameter p-db-num    as integer   no-undo .
      110     define input  parameter p-db-key    as character no-undo .
      111     define input  parameter p-code      as character no-undo .
      112     define input  parameter p-value     as character no-undo .
      113     define input  parameter p-beg-date  as date      no-undo .
      114     define input  parameter p-end-date  as date      no-undo .
      115     define input  parameter p-enc-value as character no-undo .
      116     define output parameter p-answer    as logical   no-undo .
      117     define variable tmp         as character no-undo .
      118     define variable v-enc-value as character no-undo .
      119     if p-db-num <> 0
      120       and p-db-key = "":U
      121     then do:
      122       assign
      123         p-answer = true
      124       .
      125       return.
      126     end.
      127     if p-db-key = "unload-db":U then do:
      128       assign
      129         p-answer = true
      130       .
      131       return.
      132     end.
      133     if p-code = ""  then do:
      134       assign
      135         tmp = string( p-db-num ) + reverse (p-db-key).
      136       .
      137     end.
      138     else do:
      139       assign
      140         tmp = string( p-db-num )
      141               + trim( p-db-key )
      142               + reverse( trim( p-code ) )
      143               + reverse( trim( p-value ) )
      144               + reverse( string( p-beg-date, "99.99.9999" ) )
      145               + reverse( string( p-end-date, "99.99.9999" ) )
      146       .
      147     end.
      148     run pswd-enc in this-procedure
      149       ( input tmp
      150        ,output v-enc-value
      151       ) no-error .
      152     if error-status:error then do:
      153       message
      154         vss-workfile vss-revision vss-description skip
      155         "Ошибка при вызове процедуры pswd-enc" skip
      156         return-value skip
      157         error-status :get-message(1) skip
      158         view-as alert-box error .
      159       undo, return error .
      160     end.
      161     if v-enc-value = p-enc-value then do:
      162       assign
      163         p-answer = true
      164       .
      165     end.
      166     else do:
      167       assign
      168         p-answer = false
      169       .
      170     end.
      171   end.
      172   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      173   procedure pswd-enc :
      174     define input parameter  pswd     as character no-undo .
      175     define output parameter enc-pswd as character no-undo .
      176     do
      177     on error undo, return error return-value
      178     :
      179       assign
      180         enc-pswd = encode(pswd + string(index(pswd, "k")))
      181       .
      182     end.
      183   end procedure.
      184   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      185   define  shared temp-table cnf-struct no-undo
      186     field param-code    as character
      187     field param-type    as character
      188     field data-type     as character
      189     field param-name    as character
      190     field attach-type   as character
      191     field list-value    as character
      192     field default-value as character
      193     field PS            as character
      194     field param-group   as character
      195     field user-resp     as character
      196     index by-code is unique param-code
      197   .
      198   define temp-table t_cnf-struct no-undo like cnf-struct .
      199   define stream TxtStream.
      200   define stream temp-stream .
      201   function coding-user-resp returns character
      202     ( input p-param-code as character
      203      ,input p-user-resp  as character
      204     )
      205   :
      206     return encode( p-param-code + p-user-resp ) .
      207   end function.
      208   function decoding-user-resp returns character
      209     ( input p-param-code as character
      210      ,input p-code-usr   as character
      211     )
      212   :
      213     define variable v-ind         as integer   no-undo .
      214     define variable v-user-list   as character no-undo .
      215     define variable v-num-entries as integer   no-undo .
      216     define variable v-user-resp   as character no-undo .
      217     assign
      218       v-user-list   = "Бахтадзе,Булгаков,Белоусов,Гюнтнер,Исаков,Перваков,Суслов,Уханов,Чернова,Кочетков,Степанов,Хныкин,Гридчина,Шальнев,Сливенко,Харитонов,Кирюхин,Морозов"
      219       v-num-entries = num-entries( v-user-list )
      220       v-user-resp   = "":U
      221     .
      222     block_do:
      223     do v-ind = 1 to v-num-entries :
      224       if encode( p-param-code + entry( v-ind, v-user-list ) ) = p-code-usr then do:
      225         assign
      226           v-user-resp = entry( v-ind, v-user-list )
      227         .
      228         leave block_do.
      229       end.
      230     end.
      231     if v-user-resp = "":U then do:
      232       message
      233         vss-include-info2 skip
      234         substitute( "Невозможно распознать ответственного за параметр <&1>!",  p-param-code) skip
      235         substitute( "Возможно его нет в списке." ) skip
      236         view-as alert-box error
      237       .
      238       return "unknown":U.
      239     end.
      240     else do:
      241       return v-user-resp .
      242     end.
      243   end function.
      244   function sum-enc returns character (str as character, num-rev as integer).
      245      define variable rev_incl_s as character init "" no-undo .
      246      define variable rev_incl_i as integer no-undo .
      247      define variable rev_incl_l as integer no-undo .
      248      rev_incl_l = length(str).
      249      do rev_incl_i = 1 to rev_incl_l:
      250         if rev_incl_i <= num-rev
      251           or rev_incl_l - rev_incl_i < num-rev
      252         then do:
      253           assign
      254             rev_incl_s = rev_incl_s + substr(str, rev_incl_l - rev_incl_i + 1, 1)
      255           .
      256         end.
      257         else do:
      258           assign
      259             rev_incl_s = rev_incl_s + substr(str, rev_incl_i, 1)
      260           .
      261         end.
      262      end.
      263      return rev_incl_s.
      264   end.
      265   procedure check-cfg :
      266     define input-output parameter p-param-code    as character no-undo .
      267     define input-output parameter p-param-type    as character no-undo .
      268     define input-output parameter p-data-type     as character no-undo .
      269     define input-output parameter p-param-name    as character no-undo .
      270     define input-output parameter p-attach-type   as character no-undo .
      271     define input-output parameter p-list-value    as character no-undo .
      272     define input-output parameter p-default-value as character no-undo .
      273     define input-output parameter p-param-PS      as character no-undo .
      274     define input-output parameter p-param-group   as character no-undo .
      275     define input-output parameter p-user-resp     as character no-undo .
      276     do
      277     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info2, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      278     on stop   undo, return error substitute( "&1. stop", vss-include-info2 )
      279     on endkey undo, return error substitute( "&1. endkey", vss-include-info2 )
      280     :
      281       define variable v-ind as character no-undo .
      282       assign
      283         p-param-code    = trim( p-param-code )
      284         p-param-type    = trim( p-param-type )
      285         p-data-type     = trim( p-data-type )
      286         p-param-name    = trim( p-param-name )
      287         p-attach-type   = trim( p-attach-type )
      288         p-list-value    = trim( p-list-value )
      289         p-default-value = trim( p-default-value )
      290         p-param-PS      = trim( p-param-PS )
      291         p-param-group   = trim( p-param-group )
      292         p-user-resp     = trim( p-user-resp )
      293       .
      294       if p-param-code = "":U then do:
      295         undo, return error substitute( "&1. Не задана метка параметра", vss-include-info2 ).
      296       end.
      297       if length( p-param-code ) > 8 then do:
      298         undo, return error substitute( "&1. Длина метки параметра не может превышать 8 символов (&2)", vss-include-info2, p-param-code ).
      299       end.
      300       if lookup( p-param-type, ',о,к,п':U ) = 0 then do:
      301         undo, return error substitute( '&1. Значение типа настройки "&2" не допустимо (&3)', vss-include-info2, p-param-type, p-param-code ).
      302       end.
      303       if lookup( p-param-type, 'к,п':U ) <> 0
      304         and lookup( p-attach-type, 'Нет':U ) = 0
      305       then do:
      306         undo, return error substitute( '&1. Для параметров с типом "&2" допустимы только привязки "&3" (&4)', vss-include-info2, 'к,п':U, 'Нет':U, p-param-code ).
      307       end.
      308       if p-param-name = "":U then do:
      309         undo, return error substitute( "&1. Не задано название параметра &2", vss-include-info2, p-param-code  ).
      310       end.
      311       if lookup( entry( 1, p-data-type ), "logical,integer,decimal,date,character":U ) = 0
      312         or num-entries( p-data-type ) > 2
      313         or ( num-entries( p-data-type ) = 2
      314              and entry( 2, p-data-type ) <> "list":U
      315            )
      316       then do:
      317         undo, return error substitute( "&1. Значение типа параметра &2 не допустимо (&3)", vss-include-info2, p-data-type, p-param-code ).
      318       end.
      319       if lookup( p-attach-type, 'Нет,Фирма,Объект':U ) = 0
      320       then do:
      321         undo, return error substitute( '&1. Значение привязки "&2" не допустимо (&3)', vss-include-info2, p-attach-type, p-param-code ).
      322       end.
      323     end.
      324     return.
      325   end procedure.
      326   procedure fill-cnf-struct :
      327     define input parameter p-file-name as character no-undo .
      328     do
      329     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      330     on stop   undo, return error substitute( "&1. stop", vss-workfile )
      331     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      332     :
      333       define variable v-file-name as character no-undo .
      334       define variable v-counter as integer   no-undo .
      335       define variable v-temp-fname       as character           no-undo.
      336       define variable v-last-key         as integer             no-undo .
      337       define variable v-new-line         as integer             no-undo .
      338       define variable v-read-chksum      as logical             no-undo .
      339       define variable v-md5-signature-av as character           no-undo .
      340       define variable v-md5-signature    as character           no-undo .
      341       define frame inf-cfg
      342         v-counter label "Просмотрено"
      343         with view-as dialog-box side-labels 1 columns three-d title ""
      344       .
      345       assign
      346         v-file-name = search( p-file-name )
      347       .
      348       if v-file-name = ""
      349         or v-file-name = ?
      350       then do:
      351         return error substitute( "&1. Не задан файл схемы конфигурации!", vss-include-info2 ).
      352       end.
      353       assign
      354         v-last-key         = 0
      355         v-read-chksum      = false
      356         v-md5-signature-av = "":U
      357         file-info:file-name = ".":U
      358         v-temp-fname = substitute( "&1\&2-&3-&4.tmp", file-info:full-pathname, time, etime, random( 1111111 , 9999999 ) )
      359       .
      360       input stream TxtStream from value( v-file-name ).
      361       output stream temp-stream to value(v-temp-fname) .
      362       block_read:
      363       repeat while v-last-key <> -2
      364       on error undo, return error
      365       :
      366         readkey stream TxtStream pause 0.
      367         assign
      368           v-last-key = lastkey
      369         .
      370         if chr( v-last-key ) = chr(1) then do:
      371           assign
      372             v-read-chksum = true
      373           .
      374         end.
      375         else do:
      376           if v-read-chksum = true then do:
      377             if v-last-key = 13 then do:
      378               leave block_read.
      379             end.
      380             else do:
      381               assign
      382                 v-md5-signature-av = v-md5-signature-av + chr( v-last-key )
      383               .
      384             end.
      385           end.
      386           else do:
      387             if v-last-key = 13 then do:
      388               put stream temp-stream skip(v-new-line).
      389               assign
      390                 v-new-line = 1
      391               .
      392             end.
      393             else do:
      394               put stream temp-stream unformatted chr( v-last-key ).
      395               assign
      396                 v-new-line = 0
      397               .
      398             end.
      399           end.
      400         end.
      401       end.
      402       output stream temp-stream close.
      403       input stream TxtStream close.
      404       run gbl/md5.p
      405         ( input  search( v-temp-fname )
      406          ,output v-md5-signature
      407         ) no-error.
      408       if error-status :error then do:
      409         return error substitute("Ошибка при подсчете контрольной суммы текстового файла схемы &1", v-file-name ) .
      410       end.
      411       os-delete value( v-temp-fname ).
      412       assign
      413         v-md5-signature = sum-enc( v-md5-signature, 8 )
      414       .
      415       if v-md5-signature-av <> v-md5-signature then do:
      416         return error substitute( "Некорректная контрольная сумма текстового файла схемы &1", v-file-name ) .
      417       end.
      418       input stream TxtStream from value( v-file-name ).
      419       assign
      420         v-counter = 0
      421       .
      422       assign
      423         frame inf-cfg:title = "Чтение параметров конфигурации"
      424       .
      425       view frame inf-cfg.
      426       for each t_cnf-struct:
      427         delete t_cnf-struct.
      428       end.
      429       create t_cnf-struct no-error.
      430       read-cycle:
      431       repeat transaction
      432       on error  undo, return error substitute( "&1. &2&3&4", vss-include-info2, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      433       :
      434         assign
      435           v-counter = v-counter + 1
      436         .
      437         if ( v-counter modulo 10 ) = 0 then do:
      438           display
      439             v-counter
      440             with frame inf-cfg.
      441         end.
      442         import stream TxtStream delimiter '`':U t_cnf-struct.param-code t_cnf-struct.param-type t_cnf-struct.data-type t_cnf-struct.param-name t_cnf-struct.attach-type t_cnf-struct.list-value t_cnf-struct.default-value t_cnf-struct.PS t_cnf-struct.param-group t_cnf-struct.user-resp no-error.
      443         if error-status:error then do:
      444           return error substitute( "&1. Ошибка при чтении текстового файла схемы! Cтрока &1. (&2)", vss-include-info2, v-counter, error-status :get-message ( error-status :num-messages ) ).
      445         end.
      446         else do:
      447           if not ( t_cnf-struct.param-code begins chr(1) ) then do:
      448             assign
      449               t_cnf-struct.user-resp = decoding-user-resp( t_cnf-struct.param-code, t_cnf-struct.user-resp )
      450             .
      451             if t_cnf-struct.user-resp = "unknown":U then do:
      452               return error substitute( "&1. Ошибка параметра! Cтрока &2.", vss-include-info2, v-counter ).
      453             end.
      454             run check-cfg in this-procedure
      455               ( input-output t_cnf-struct.param-code
      456               ,input-output t_cnf-struct.param-type
      457               ,input-output t_cnf-struct.data-type
      458               ,input-output t_cnf-struct.param-name
      459               ,input-output t_cnf-struct.attach-type
      460               ,input-output t_cnf-struct.list-value
      461               ,input-output t_cnf-struct.default-value
      462               ,input-output t_cnf-struct.PS
      463               ,input-output t_cnf-struct.param-group
      464               ,input-output t_cnf-struct.user-resp
      465               ) no-error .
      466             if error-status :error then do:
      467               return error substitute( "&1. Ошибка параметра! Cтрока &2. &3 (&4)", vss-include-info2, v-counter, return-value, error-status :get-message ( error-status :num-messages ) ).
      468             end.
      469             else do:
      470               find first cnf-struct
      471                 where cnf-struct.param-code = t_cnf-struct.param-code
      472                 no-error
      473               .
      474               if not available cnf-struct then do:
      475                 create cnf-struct .
      476               end.
      477               buffer-copy t_cnf-struct to cnf-struct .
      478             end.
      479           end.
      480         end.
      481       end.
      482       delete t_cnf-struct no-error.
      483       hide frame inf-cfg.
      484       input stream TxtStream close.
      485     end.
      486     return.
      487   end procedure.
      488   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      489   define variable v-waitfram-action01         as character   no-undo .
      490   define variable v-waitfram-action02         as character   no-undo .
      491   define variable v-waitfram-action03         as character   no-undo .
      492   define variable mWaitFramTextBeg            as character   no-undo.
      493   define variable mWaitFramTextEnd            as character   no-undo.
      494   define variable mWaitFramView               as logical     no-undo.
      495   define variable mWaitProcEvent              as logical     no-undo init yes.
      496   define variable mWaitFramInterval           as integer     no-undo init 1 .
      497   define variable mWaitFramStop               as logical     no-undo.
      498   define variable mWaitFramStopUser           as logical     no-undo.
      499   define variable mWaitFramStopTimeOut        as logical     no-undo.
      500   define variable mWaitFramStartProc          as datetime-tz no-undo.
      501   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      502   define button B-WaitFramStop auto-end-key
      503        label "Стоп"
      504        size 10 by 1 tooltip "Остоновить процесс".
      505   define button B-viewProcInfo
      506        label "Информация"
      507        size 15 by 1 tooltip "Информация о процесс".
      508   define frame waitfram
      509     v-waitfram-action01 format "x(72)" no-label skip
      510     v-waitfram-action02 format "x(72)" no-label skip
      511     v-waitfram-action03 format "x(72)" no-label skip
      512     B-viewProcInfo
      513     B-WaitFramStop at row 4 col 30
      514     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      515     .
      516   define new global shared variable mBatchMode as logical no-undo init ?.
      517   define variable mFramBachModHandle as handle no-undo.
      518   mFramBachModHandle = frame waitfram:handle.
      519   define variable mFameOldVis as logical no-undo.
      520   define variable mVisCUrentVin as logical no-undo.
      521   if session:batch-mode
      522   then
      523      mBatchMode = yes.
      524   if mBatchMode = ? then do:
      525     mVisCUrentVin = current-window:visible.
      526     mFameOldVis = mFramBachModHandle:visible.
      527     mFramBachModHandle:visible  = yes.
      528     mBatchMode = mFramBachModHandle:visible ne yes.
      529     mFramBachModHandle:visible = mFameOldVis.
      530     current-window:visible = mVisCUrentVin.
      531   end.
      532    if  log-manager:logfile-name ne ?
      533     then DO:
      534         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      535         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      536         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      537     end.
      538   on choose of B-WaitFramStop in frame waitfram
      539   do:
      540     mWaitFramStop = yes.
      541     mWaitFramStopUser = yes.
      542   end.
      543   function waitfram-check-timeout returns logical():
      544      define variable vtime as int64 no-undo.
      545      if mWaitFramStopTimeOut
      546      then
      547         return yes.
      548      vtime = ( now - mWaitFramStartProc ) / 1000 .
      549      if     mWaitFramTimeOut ne ?
      550         and mWaitFramTimeOut ne 0
      551         and mWaitFramTimeOut lt vtime
      552      then do:
      553         mWaitFramStopTimeOut = yes.
      554      end.
      555      return mWaitFramStopTimeOut.
      556   end.
      557   procedure waitfram-hide :
      558     if not session:batch-mode
      559     then do
      560     on error undo, return error return-value
      561     :
      562       pause 0 before-hide .
      563       if not mBatchMode then
      564         hide frame waitfram .
      565     if     not mWaitFramView
      566        and mWaitProcEvent
      567     then
      568       process events .
      569     end.
      570   end procedure.
      571   procedure waitfram-show :
      572     define input  parameter p-message as character no-undo .
      573     define variable v-left-margin as integer   no-undo .
      574     if not session:batch-mode
      575     then do
      576     on error undo, return error return-value
      577     :
      578       if length(p-message) <= 70 then do:
      579         assign
      580           v-left-margin = integer((70 - length(p-message)) / 2)
      581         .
      582         assign
      583           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      584         .
      585         assign
      586           v-waitfram-action01 = " "
      587           v-waitfram-action02 = " "
      588                                    + fill(" ", v-left-margin)
      589                                    + p-message
      590           v-waitfram-action03 = " "
      591         .
      592       end.
      593       else do:
      594         define variable vRindex1 as integer no-undo.
      595         define variable vRindex2 as integer no-undo.
      596         vRindex1 = r-index(p-message," ",70).
      597         if vRindex1 = 0
      598         then
      599            vRindex1 = 70.
      600         if length(p-message)  <= vRindex1 + 70 then do:
      601           assign
      602             v-waitfram-action01 = " "
      603             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      604             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      605           .
      606         end.
      607         else do:
      608           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      609           if vRindex2 <= vRindex1
      610           then
      611              vRindex2 = vRindex1 + 70.
      612           assign
      613             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      614             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      615             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      616           .
      617         end.
      618       end.
      619       B-viewProcInfo:visible   in frame waitfram = no.
      620       B-viewProcInfo:sensitive in frame waitfram = no.
      621       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      622       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      623       if  (   mWaitFramView
      624          or  mWaitProcEvent)
      625          and not mBatchMode
      626       then
      627          display
      628             v-waitfram-action01 skip
      629             v-waitfram-action02 skip
      630             v-waitfram-action03 skip
      631          with frame waitfram .
      632       if     mWaitFramView
      633          then do:
      634             if     mWaitFramInterval ne ?
      635                and not mBatchMode
      636             then
      637                wait-for go of frame waitfram pause mWaitFramInterval.
      638          end.
      639          else
      640             if     mWaitProcEvent
      641                and not mBatchMode
      642             then
      643                process events .
      644     end.
      645   end procedure.
      646      procedure waitfram-show-this:
      647         define input  parameter iInterval as int64 no-undo.
      648         define variable vtime as int64 no-undo.
      649         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      650         mWaitFramInterval = iInterval.
      651         run waitfram-show (substitute("&1&2 &3&4" ,
      652                                       mWaitFramTextBeg ,
      653                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      654                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      655                                       mWaitFramTextEnd
      656                                      )
      657                           ).
      658      end.
      659      procedure WaitFramRunPause:
      660         define input  parameter iInterval as dec no-undo.
      661         define variable vStart  as datetime-tz no-undo.
      662         define variable vend    as datetime-tz no-undo.
      663         define variable vint as int64 no-undo.
      664         define variable vOk as logical no-undo.
      665         vStart = now.
      666         vend   = vStart.
      667         publish "WaitFramPause" (iInterval,output vOk).
      668         vend   =  now.
      669         vint = vend - vStart.
      670         vint = iInterval - vint / 1000.
      671         if     not mWaitFramStop
      672            and (   vint > 0
      673                 or (    not vOk
      674                     and iInterval eq ?
      675                     )
      676                 )
      677         then
      678            run waitfram-show-this (iInterval).
      679         vend   =  now.
      680         vint = vend - vStart.
      681         vint = iInterval - vint / 1000.
      682         if     not mWaitFramStop
      683            and vint > 0
      684         then do:
      685            run gbl/pause.p (vint * 1000).
      686         end.
      687         if iInterval ne ?
      688         then
      689            publish "WaitFramStop".
      690         waitfram-check-timeout().
      691      end.
      692      procedure WaitFramWaitFor:
      693         define input  parameter iInterval as dec no-undo.
      694         assign
      695            mWaitFramStartProc   = now
      696            mWaitFramStopUser    = no
      697            mWaitFramStopTimeOut = no
      698         .
      699         block-wait:
      700         do while not mWaitFramStop:
      701            run WaitFramRunPause (iInterval).
      702            if  waitfram-check-timeout()
      703            then do:
      704               leave block-wait.
      705            end.
      706         end.
      707         run waitfram-hide.
      708      end.
      709   procedure waitfram-join :
      710     define input  parameter p-line-1  as character no-undo .
      711     define input  parameter p-line-2  as character no-undo .
      712     define input  parameter p-line-3  as character no-undo .
      713     define output parameter p-message as character no-undo .
      714     do
      715     on error undo, return error return-value
      716     :
      717       assign
      718         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      719                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      720                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      721       .
      722     end.
      723   end procedure.
      724   function waitfram-join-function returns character
      725     (input p-line-1 as character
      726     ,input p-line-2 as character
      727     ,input p-line-3 as character
      728     ).
      729     define variable v-message as character no-undo .
      730     run waitfram-join in this-procedure
      731       (input  p-line-1
      732       ,input  p-line-2
      733       ,input  p-line-3
      734       ,output v-message
      735       ) .
      736     return v-message .
      737   end function .
      738   define variable str-hdl      as handle  no-undo .
      739   define variable db-hdl       as handle  no-undo .
      740   define variable stand-alone  as logical no-undo .
      741   define stream txt-file.
      742   define stream temp-stream.
      743   define temp-table t-cnf no-undo like cnf.
      744   procedure init.
      745   define input parameter  par-str-hdl as handle.
      746   define input parameter  par-db-hdl  as handle.
      747   if valid-handle (par-str-hdl) then
      748      assign str-hdl = par-str-hdl.
      749   else
      750      return "2".
      751   if valid-handle (par-db-hdl) then
      752      assign db-hdl      = par-db-hdl
      753             stand-alone = false.
      754      else
      755             stand-alone = true.
      756   this-procedure:private-data = "Work-with-config".
      757   return.
      758   end procedure.
      759   Procedure Kill.
      760       Delete Procedure This-procedure.
      761       Return.
      762   End Procedure.
      763   function valid-length returns logical (par-str as character, par-len as integer, par-label as character).
      764   if length(par-str) > par-len then do:
      765      run log-error in str-hdl ("Превышена максимальная длина "  + string(par-len) + " для " + par-label, 2).
      766      return false.
      767   end.
      768      return true.
      769   end.
      770   PROCEDURE Import.
      771   define input parameter par-FName   as character no-undo.
      772   define input parameter par-Clear   as logical   no-undo.
      773   define input parameter par-UseLast as logical   no-undo.
      774   define input parameter p-stand-alone as logical    no-undo.
      775   define input parameter p-db-load     as character  no-undo.
      776   define variable Fname              as character           no-undo.
      777   define variable Count              as integer   initial 0 no-undo.
      778   define variable v-ok               as logical             no-undo .
      779   define variable v-last-key         as integer             no-undo .
      780   define variable v-new-line         as integer             no-undo .
      781   define variable v-read-chksum      as logical             no-undo .
      782   define variable v-md5-signature-av as character           no-undo .
      783   define variable v-md5-signature    as character           no-undo .
      784   define variable v-db-list          as character           no-undo .
      785   define buffer buf_sys-ctrl for ub.sys-ctrl .
      786   define buffer buf_db for ub.db .
      787   assign
      788     err-level  = 0
      789   .
      790   if par-fname = "" then par-fname = "config.cfg".
      791     assign
      792       par-fname = SEARCH( par-fname )
      793     .
      794   IF par-fname = ? then do:
      795      run log-error in str-hdl ("Не найден файл конфигурации " + par-fname, 2).
      796      return string (err-level).
      797   end.
      798   else do:
      799     run log-error in str-hdl("Чтение конфигурационных параметров " + par-fname, 0).
      800   end.
      801   assign
      802     v-last-key         = 0
      803     v-read-chksum      = false
      804     v-md5-signature-av = "":U
      805     file-info:file-name = ".":U
      806     FName = substitute( "&1\&2-&3-&4.tmp", file-info:full-pathname, time, etime, random( 1111111 , 9999999 ) )
      807   .
      808   input stream txt-file from value( par-fname ).
      809   output stream temp-stream to value(FName) .
      810   block_read:
      811   repeat while v-last-key <> -2
      812   on error undo, return error return-value
      813   :
      814     readkey stream txt-file pause 0.
      815     assign
      816       v-last-key = lastkey
      817     .
      818     if chr( v-last-key ) = chr(1) then do:
      819       assign
      820         v-read-chksum = true
      821       .
      822     end.
      823     else do:
      824       if v-read-chksum = true then do:
      825         if v-last-key = 13 then do:
      826           leave block_read.
      827         end.
      828         else do:
      829           assign
      830             v-md5-signature-av = v-md5-signature-av + chr( v-last-key )
      831           .
      832         end.
      833       end.
      834       else do:
      835         if v-last-key = 13 then do:
      836           put stream temp-stream skip(v-new-line).
      837           assign
      838             v-new-line = 1
      839           .
      840         end.
      841         else do:
      842           put stream temp-stream unformatted chr( v-last-key ).
      843           assign
      844             v-new-line = 0
      845           .
      846         end.
      847       end.
      848     end.
      849   end.
      850   output stream temp-stream close.
      851   input stream txt-file close.
      852   run gbl/md5.p
      853     ( input  search( FName )
      854     ,output v-md5-signature
      855     ) no-error.
      856   if error-status :error then do:
      857     run log-error in str-hdl
      858       ( input substitute( "Ошибка при подсчете контрольной суммы файла конфигурации &1", par-fname )
      859        ,input 2
      860       ).
      861     return "2":U.
      862   end.
      863   os-delete value( FName ).
      864   assign
      865     v-md5-signature = sum-enc( v-md5-signature, 10 )
      866   .
      867   if v-md5-signature-av <> v-md5-signature then do:
      868     run log-error in str-hdl
      869       ( input substitute( "Некорректная контрольная сумма файла конфигурации &1", par-fname )
      870        ,input 2
      871       ).
      872     if not p-stand-alone then do:
      873       return "2":U.
      874     end.
      875     else do:
      876       message
      877         substitute( "Некорректная контрольная сумма файла конфигурации &1!", par-fname ) skip
      878         substitute( "Вы действительно хотите загрузить этот файл?" )
      879         view-as alert-box question BUTTONS yes-no update v-ok.
      880       if v-ok <> true then do:
      881         return "2":U.
      882       end.
      883     end.
      884   end.
      885   main-block:
      886   do on error undo main-block, leave main-block:
      887     if not p-stand-alone then do:
      888       find first buf_sys-ctrl no-lock .
      889     end.
      890     For each cnf
      891       where par-clear
      892          or cnf.NotUsed = true
      893     :
      894       delete cnf .
      895     end.
      896     for each t-cnf
      897     :
      898       delete t-cnf .
      899     end.
      900     create t-cnf .
      901     input stream txt-file from value( par-fname ).
      902   read-cycle:
      903     Repeat transaction
      904     on error undo read-cycle, leave main-block
      905     :
      906           count = count + 1 .
      907           import stream Txt-File delimiter "`" t-cnf except stts                           param-PS                       param-name                     is-changed                     NotUsed                        ErrorExist no-error.
      908           if error-status:error then do:
      909              message
      910                t-cnf.param-name skip
      911                error-status :get-message(1) skip
      912                return-value skip
      913                view-as alert-box error .
      914              run log-error in str-hdl ("ошибка при чтении файла конфигурации, строка " + string(count), 2).
      915              input stream txt-file close.
      916              undo, return "2":U.
      917           end.
      918           if t-cnf.param-code begins chr(1) then do:
      919             if not p-stand-alone then do:
      920               if t-cnf.param-code = chr(1) + v-md5-signature then do:
      921                 leave read-cycle.
      922               end.
      923               else do:
      924                 run log-error in str-hdl
      925                   ( input substitute( "Некорректная контрольная сумма файла конфигурации &1", par-fname )
      926                    ,input 2
      927                   ).
      928                 input stream txt-file close.
      929                 undo, return "2":U.
      930               end.
      931             end.
      932             else do:
      933               leave read-cycle.
      934             end.
      935           end.
      936           if not valid-length (t-cnf.param-code, 8 , "Метка параметра")     then next read-cycle.
      937           if not valid-length (t-cnf.obj-type,   8 , "Тип объекта")         then next read-cycle.
      938           if p-db-load <> "":U
      939             and lookup( string( t-cnf.db-num ), p-db-load ) = 0
      940           then do:
      941             next read-cycle.
      942           end.
      943           if lookup( t-cnf.conf-type, 'к,п':U ) > 0
      944             and not p-stand-alone
      945           then do:
      946              find first buf_db no-lock
      947                where buf_db.db-num = t-cnf.db-num
      948                .
      949              run check-enc in this-procedure
      950                ( input t-cnf.db-num
      951                 ,input buf_db.db-key
      952                 ,input t-cnf.param-code
      953                 ,input t-cnf.param-value
      954                 ,input t-cnf.beg-date
      955                 ,input t-cnf.end-date
      956                 ,input t-cnf.param-encoded
      957                 ,output v-ok
      958                ) no-error.
      959              if error-status :error
      960                or v-ok <> true
      961              then do:
      962                 if t-cnf.db-num = buf_sys-ctrl.db-num
      963                 then do:
      964                   run log-error in str-hdl
      965                     ( input substitute("Параметр &1 для БД &2 (строка &3) - ошибка кодирования (&4)", t-cnf.param-code, t-cnf.db-num, Count, t-cnf.param-encoded )
      966                      ,input 2
      967                     ).
      968                   input stream txt-file close.
      969                   undo, return "2".
      970                 end.
      971                 else do:
      972                   run log-error in str-hdl
      973                     ( input substitute("Параметр &1 для БД &2 (строка &3) - ошибка кодирования (&4). Параметр игнорируется", t-cnf.param-code, t-cnf.db-num, Count, t-cnf.param-encoded )
      974                      ,input 1
      975                     ).
      976                   next read-cycle.
      977                 end.
      978              end.
      979           end.
      980           if t-cnf.beg-date = ? then do:
      981             assign
      982               t-cnf.beg-date = 01/01/1900
      983             .
      984           end.
      985           if t-cnf.end-date = ? then do:
      986             assign
      987               t-cnf.end-date = 01/01/9999
      988             .
      989           end.
      990           find first cnf
      991             where cnf.param-code = t-cnf.param-code and                  cnf.host-code  = t-cnf.host-code  and                  cnf.obj-type   = t-cnf.obj-type   and                  cnf.obj-code   = t-cnf.obj-code   and                  cnf.beg-date   = t-cnf.beg-date   and                  cnf.end-date   = t-cnf.end-date   and                  cnf.db-num     = t-cnf.db-num
      992             no-error.
      993           if available cnf then do:
      994              if cnf.param-value   <> t-cnf.param-value or
      995                 cnf.param-encoded <> t-cnf.param-encoded or
      996                 cnf.param-type    <> t-cnf.param-type  or
      997                 cnf.conf-type     <> t-cnf.conf-type   or
      998                 cnf.NotUsed       =  true
      999              then do:
     1000                 if par-UseLast then do:
     1001                     if cnf.param-value <> t-cnf.param-value
     1002                     then do:
     1003                       run log-error in str-hdl
     1004                         ( input substitute( "Параметр &1 для БД &2. Значение &3 заменено на &4", cnf.param-code, cnf.db-num, cnf.param-value, t-cnf.param-value )
     1005                         ,input 0
     1006                         ).
     1007                     end.
     1008                     else do:
     1009                       if cnf.param-encoded <> t-cnf.param-encoded
     1010                       then do:
     1011                         run log-error in str-hdl
     1012                           ( input substitute( "Параметр &1 для БД &2 перекодирован", cnf.param-code, cnf.db-num )
     1013                           ,input 0
     1014                           ).
     1015                       end.
     1016                       else do:
     1017                         run log-error in str-hdl
     1018                           ( input substitute( "Изменены атрибуты параметра &1 для БД &2 ", cnf.param-code, cnf.db-num )
     1019                           ,input 0
     1020                           ).
     1021                       end.
     1022                     end.
     1023                     if lookup( cnf.conf-type, 'к,п':U ) > 0
     1024                       and lookup( t-cnf.conf-type, 'к,п':U ) = 0
     1025                       and not p-stand-alone
     1026                     then do:
     1027                       assign
     1028                         cnf.ErrorExist = 2
     1029                       .
     1030                     end.
     1031                     else do:
     1032                       assign
     1033                         cnf.ErrorExist = 0
     1034                       .
     1035                     end.
     1036                     buffer-copy t-cnf to cnf no-error.
     1037                     if error-status:error then do:
     1038                       run log-sys-error in str-hdl ("Системная ошибка").
     1039                       input stream txt-file close.
     1040                       undo, return "2" .
     1041                     end.
     1042                     assign
     1043                       cnf.is-changed    = true
     1044                       cnf.NotUsed       = false
     1045                     .
     1046                 end.
     1047                 else
     1048                    run log-error in str-hdl
     1049                      ( input substitute( "Параметр &1 для БД &2. Новое значение игнорируется", cnf.param-code, cnf.db-num )
     1050                       ,input 0
     1051                      ).
     1052              end.
     1053           end.
     1054           else do:
     1055             create cnf no-error.
     1056             if error-status:error then do:
     1057               run log-sys-error in str-hdl ("Системная ошибка").
     1058               input stream txt-file close.
     1059               undo, return "2" .
     1060             end.
     1061             buffer-copy t-cnf to cnf no-error.
     1062             if error-status:error then do:
     1063               run log-sys-error in str-hdl ("Системная ошибка").
     1064               input stream txt-file close.
     1065               undo, return "2" .
     1066             end.
     1067             assign
     1068               cnf.is-changed  = true
     1069             .
     1070           end.
     1071        release cnf no-error.
     1072         if error-status:error then do:
     1073           run log-sys-error in str-hdl ("Системная ошибка").
     1074           input stream txt-file close.
     1075           undo, return "2" .
     1076         end.
     1077     end.
     1078     input stream txt-file close.
     1079     for each cnf
     1080     on error undo, return error return-value
     1081     :
     1082       run chk-param (buffer cnf) no-error.
     1083       if error-status:error then do:                                          run log-sys-error in str-hdl ("Системная ошибка").                   undo, return "2" .                                                      end.
     1084     end.
     1085     run chk-unref in this-procedure
     1086       ( input ?
     1087       , input ?
     1088       , input ?
     1089       , input p-stand-alone
     1090       ) no-error.
     1091     if error-status:error then do:                                          run log-sys-error in str-hdl ("Системная ошибка").                   undo, return "2" .                                                      end.
     1092     return if err-level > 0 then string (err-level) else "".
     1093   end.
     1094   run log-sys-error in str-hdl ("При загрузке параметров возникла непредвиденная ошибка").
     1095   input stream txt-file close.
     1096   return if err-level > 0 then string (err-level) else "".
     1097   END PROCEDURE.
     1098   procedure get-db-list-for-cnf :
     1099     define input  parameter p-stand-alone as logical          no-undo .
     1100     define output parameter p-db-list     as character        no-undo .
     1101     do
     1102     on error  undo, return error substitute( "&1 (get-db-list-for-cnf). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1103     on stop   undo, return error substitute( "&1 (get-db-list-for-cnf). stop", vss-workfile )
     1104     on endkey undo, return error substitute( "&1 (get-db-list-for-cnf). endkey", vss-workfile )
     1105     :
     1106       define variable v-num-entries as integer   no-undo .
     1107       define variable v-ind         as integer   no-undo .
     1108       define buffer buf_cnf      for cnf .
     1109       define buffer buf_sys-ctrl for ub.sys-ctrl .
     1110       define buffer buf_db       for ub.db .
     1111       assign
     1112         p-db-list = "":U
     1113       .
     1114       if p-stand-alone = true then do:
     1115         assign
     1116           p-db-list = "?":U
     1117         .
     1118         for each buf_cnf
     1119           where buf_cnf.db-num <> ?
     1120           break by buf_cnf.db-num
     1121         :
     1122           if first-of( buf_cnf.db-num ) then do:
     1123             assign
     1124               p-db-list = substitute( "&1&2&3", p-db-list, chr(44), buf_cnf.db-num )
     1125             .
     1126           end.
     1127         end.
     1128       end.
     1129       else do:
     1130         find first buf_sys-ctrl no-lock .
     1131         if buf_sys-ctrl.db-num <> 0 then do:
     1132           assign
     1133             p-db-list = string( buf_sys-ctrl.db-num )
     1134           .
     1135         end.
     1136         else do:
     1137           for each buf_db no-lock
     1138           on error undo, return error return-value
     1139           :
     1140             if buf_db.db-key <> "":U
     1141               and buf_db.db-key <> ?
     1142             then do:
     1143               assign
     1144                 p-db-list = substitute( "&1&2&3", p-db-list, chr(44), buf_db.db-num )
     1145               .
     1146             end.
     1147           end.
     1148           assign
     1149             p-db-list = left-trim( p-db-list, chr(44) )
     1150           .
     1151         end.
     1152       end.
     1153     end.
     1154     return .
     1155   end procedure.
     1156   PROCEDURE chk-unref .
     1157     define input parameter p-param-code   like cnf.param-code no-undo .
     1158     define input parameter p-db-list      as character        no-undo .
     1159     define input parameter p-ingnore-type as character        no-undo .
     1160     define input parameter p-stand-alone  as logical          no-undo .
     1161     do
     1162     on error  undo, return error substitute( "&1 (chk-unref). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1163     on stop   undo, return error substitute( "&1 (chk-unref). stop", vss-workfile )
     1164     on endkey undo, return error substitute( "&1 (chk-unref). endkey", vss-workfile )
     1165     :
     1166       define variable v-db-num      as integer   no-undo .
     1167       define variable v-num-entries as integer   no-undo .
     1168       define variable v-ind         as integer   no-undo .
     1169       define buffer buf_cnf        for cnf .
     1170       define buffer buf_cnf-struct for cnf-struct .
     1171       if p-db-list = ? then do:
     1172         run get-db-list-for-cnf in this-procedure
     1173           ( input p-stand-alone
     1174           , output p-db-list
     1175           ) .
     1176       end.
     1177       for each buf_cnf-struct
     1178         where p-param-code = ?
     1179           or ( p-param-code <> ?
     1180                 and buf_cnf-struct.param-code = p-param-code
     1181               )
     1182       :
     1183         if p-ingnore-type <> ?
     1184           and lookup( buf_cnf-struct.param-type, p-ingnore-type ) > 0
     1185         then do:
     1186           next.
     1187         end.
     1188         assign
     1189           v-num-entries = num-entries( p-db-list, chr(44) )
     1190         .
     1191         do v-ind = 1 to v-num-entries
     1192         on error undo, return error return-value
     1193         :
     1194           assign
     1195             v-db-num = integer( entry( v-ind, p-db-list, chr(44) ) )
     1196           .
     1197           find first buf_cnf no-lock
     1198             where buf_cnf.param-code = buf_cnf-struct.param-code
     1199               and buf_cnf.host-code  = 0
     1200               and buf_cnf.obj-type   = ""
     1201               and buf_cnf.obj-code   = 0
     1202               and buf_cnf.beg-date   = 01/01/1900
     1203               and buf_cnf.end-date   = 01/01/9999
     1204               and buf_cnf.db-num     = v-db-num
     1205             no-error .
     1206           if not available buf_cnf then do:
     1207             create cnf.
     1208             assign
     1209               cnf.param-code = buf_cnf-struct.param-code
     1210               cnf.host-code  = 0
     1211               cnf.obj-type   = ""
     1212               cnf.obj-code   = 0
     1213               cnf.beg-date   = 01/01/1900
     1214               cnf.end-date   = 01/01/9999
     1215               cnf.db-num     = v-db-num
     1216               cnf.NotUsed    = True
     1217             .
     1218             run fill-default (buffer cnf).
     1219           end.
     1220         end.
     1221       end.
     1222     end.
     1223   END PROCEDURE.
     1224   PROCEDURE fill-default.
     1225     define parameter buffer b-cnf for cnf.
     1226     define buffer b2-cnf for cnf.
     1227     find first cnf-struct
     1228       where cnf-struct.param-code = b-cnf.param-code
     1229       no-error.
     1230     if not available cnf-struct then do:
     1231       return .
     1232     end.
     1233     assign
     1234       b-cnf.param-value = if b-cnf.param-value = "" then cnf-struct.default-value else b-cnf.param-value
     1235       b-cnf.param-ps    = cnf-struct.PS
     1236       b-cnf.param-name  = cnf-struct.param-name
     1237       b-cnf.conf-type   = cnf-struct.param-type
     1238     .
     1239     run cnv-param-type in str-hdl
     1240       ( input cnf-struct.data-type
     1241       ) no-error.
     1242     if error-status:error then do:                                          run log-sys-error in str-hdl ("Системная ошибка").                   undo, return "2" .                                                      end.
     1243     assign
     1244       b-cnf.param-type = return-value
     1245     .
     1246     if cnf-struct.attach-type <> 'Фирма':U
     1247       and cnf-struct.attach-type <> 'Объект':U
     1248     then do:
     1249       assign
     1250         b-cnf.host-code  = 0
     1251       .
     1252     end.
     1253     if cnf-struct.attach-type <> 'Объект':U  then do:
     1254       assign
     1255         b-cnf.obj-code   = 0
     1256         b-cnf.obj-type   = "":U
     1257       .
     1258     end.
     1259     find first b2-cnf
     1260       where b2-cnf.param-code = b-cnf.param-code and                  b2-cnf.host-code  = b-cnf.host-code  and                  b2-cnf.obj-type   = b-cnf.obj-type   and                  b2-cnf.obj-code   = b-cnf.obj-code   and                  b2-cnf.beg-date   = b-cnf.beg-date   and                  b2-cnf.end-date   = b-cnf.end-date   and                  b2-cnf.db-num     = b-cnf.db-num
     1261         and recid(b2-cnf) <> recid(b-cnf)
     1262       no-error.
     1263     if available b2-cnf then do:
     1264       if b2-cnf.NotUsed = true then do:
     1265           delete b2-cnf .
     1266       end.
     1267       else do:
     1268           delete b-cnf .
     1269       end.
     1270     end.
     1271   END PROCEDURE.
     1272   PROCEDURE export-cnf.
     1273     define input  parameter p-conf-handle   as handle    no-undo .
     1274     define input  parameter p-stand-alone   as logical   no-undo .
     1275     define input  parameter p-cur-recid-cnf as recid     no-undo .
     1276     define input  parameter p-mark-cnf      as character no-undo .
     1277     define output parameter p-qnty-cnf      as integer   no-undo .
     1278     do
     1279     on error  undo, return error substitute( "&1 (export-cnf). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1280     on stop   undo, return error substitute( "&1 (export-cnf). stop", vss-workfile )
     1281     on endkey undo, return error substitute( "&1 (export-cnf). endkey", vss-workfile )
     1282     :
     1283       define variable v-md5-signature as character no-undo .
     1284       define variable v-file-name     as character no-undo .
     1285       define variable v-exp-type      as character no-undo .
     1286       define variable v-db-list       as character no-undo .
     1287       define variable v-sel-dbs       as character no-undo .
     1288       define variable v-new-db-num    as integer   no-undo .
     1289       define variable v-new-db-key    as character no-undo .
     1290       define variable v-selected      as logical   no-undo .
     1291       define variable v-ok            as logical   no-undo .
     1292       define variable v-with-err      as logical   no-undo .
     1293       define variable v-err-msg       as character no-undo .
     1294       define buffer buf_cnf        for cnf .
     1295       define buffer buf1_cnf       for cnf .
     1296       define buffer buf_cnf-struct for cnf-struct .
     1297       for each buf_cnf
     1298         where buf_cnf.db-num  <> ?
     1299           and buf_cnf.notused = false
     1300         break by buf_cnf.db-num
     1301       :
     1302         if first-of( buf_cnf.db-num )
     1303         then do:
     1304           assign
     1305             v-db-list = substitute( "&1&2&3", v-db-list, chr(44), buf_cnf.db-num )
     1306           .
     1307         end.
     1308       end.
     1309       assign
     1310         v-db-list  = left-trim( v-db-list, chr(44) )
     1311         p-qnty-cnf = ?
     1312       .
     1313       if trim( v-db-list ) = "":U then do:
     1314         message
     1315           substitute("Нет включенных параметров ни для одной БД") skip
     1316           view-as alert-box information .
     1317         return .
     1318       end.
     1319       assign
     1320         v-selected = false
     1321       .
     1322       if p-cur-recid-cnf <> ? then do:
     1323         find first buf_cnf
     1324           where recid( buf_cnf ) = p-cur-recid-cnf
     1325           no-error .
     1326         if available buf_cnf
     1327           and buf_cnf.db-num <> ?
     1328           and buf_cnf.NotUsed = false
     1329           and buf_cnf.ErrorExist = 0
     1330         then do:
     1331           assign
     1332             v-selected = true
     1333           .
     1334         end.
     1335       end.
     1336       assign
     1337         v-file-name = "config.cfg"
     1338       .
     1339       run adm/expi.w
     1340         ( input p-stand-alone
     1341         , input v-selected
     1342         , input-output v-file-name
     1343         , input  v-db-list
     1344         , output v-sel-dbs
     1345         , output v-exp-type
     1346         , output v-new-db-num
     1347         , output v-new-db-key
     1348         ) no-error.
     1349       if error-status :error then do:
     1350         return error substitute( "&1 (export-cnf). Ошибка при запуске процедуры выбора параметров экспорта. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) ).
     1351       end.
     1352       if v-exp-type = ? then do:
     1353         return .
     1354       end.
     1355       for each buf_cnf
     1356         where buf_cnf.NotUsed = true
     1357         ,first buf_cnf-struct
     1358         where buf_cnf-struct.param-code = buf_cnf.param-code
     1359       on error undo, return error return-value
     1360       :
     1361         if lookup( buf_cnf-struct.param-type, 'к,о':U) > 0
     1362           and lookup( string( buf_cnf.db-num ), v-sel-dbs ) > 0
     1363         then do:
     1364           message
     1365             "Не все обязательные параметры включены для выбранных БД"
     1366             "Продолжить вывод?"
     1367             view-as alert-box buttons yes-no update v-ok.
     1368           if v-ok = false then do:
     1369             return .
     1370           end.
     1371           else do:
     1372             leave .
     1373           end.
     1374         end.
     1375       end.
     1376       for first buf_cnf
     1377         where buf_cnf.ErrorExist <> 0
     1378       on error undo, return error return-value
     1379       :
     1380         message
     1381           "В наборе есть параметры с ошибками!" skip
     1382           "Вывести их в файл?" skip(1)
     1383           view-as alert-box buttons yes-no-cancel update v-with-err .
     1384         if v-with-err = ? then do:
     1385           return .
     1386         end.
     1387       end.
     1388       assign
     1389         p-qnty-cnf = 0
     1390       .
     1391       run waitfram-show in this-procedure ("Экспорт конфигурации").
     1392       for each t-cnf
     1393       :
     1394         delete t-cnf .
     1395       end.
     1396       create t-cnf .
     1397       output stream txt-file to value(v-file-name).
     1398       block_exp:
     1399       for each buf_cnf
     1400         where buf_cnf.db-num <> ?
     1401           and buf_cnf.NotUsed = false
     1402         ,first buf_cnf-struct
     1403         where buf_cnf-struct.param-code = buf_cnf.param-code
     1404       on error  undo, retry block_exp
     1405       on stop   undo, retry block_exp
     1406       on endkey undo, retry block_exp
     1407       :
     1408         if retry then do:
     1409           assign
     1410             v-err-msg = substitute( "&1 (export-cnf). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1411           .
     1412           output stream txt-file close.
     1413           return error v-err-msg .
     1414         end.
     1415         else do:
     1416           if v-with-err = false
     1417             and buf_cnf.ErrorExist <> 0
     1418           then do:
     1419             next block_exp .
     1420           end.
     1421           if ( lookup( string( buf_cnf.db-num ), v-sel-dbs ) > 0
     1422               and ( v-exp-type = "all":U
     1423                     or ( v-exp-type = "mark":U    and lookup(string( recid( buf_cnf ) ), p-mark-cnf) > 0 )
     1424                     or ( v-exp-type = "all-protect":U and lookup( buf_cnf-struct.param-type, 'к,п':U) > 0 )
     1425                     or ( v-exp-type = "all-mandatory":U and lookup( buf_cnf-struct.param-type, 'к,о':U) > 0 )
     1426                   )
     1427             )
     1428             or ( v-exp-type = "curr":U
     1429                   and recid( buf_cnf ) = p-cur-recid-cnf
     1430                 )
     1431           then do:
     1432             buffer-copy buf_cnf to t-cnf .
     1433             if v-new-db-num <> ? then do:
     1434               assign
     1435                 t-cnf.db-num = v-new-db-num
     1436                 t-cnf.db-key        = v-new-db-key
     1437                 t-cnf.param-encoded = "":U
     1438               .
     1439             end.
     1440             if p-stand-alone = true
     1441               and lookup( t-cnf.conf-type, 'к,п':U ) > 0
     1442             then do:
     1443               run conf-enc in p-conf-handle
     1444                 ( input  t-cnf.db-num
     1445                 , input  t-cnf.db-key
     1446                 , input  t-cnf.param-code
     1447                 , input  t-cnf.param-value
     1448                 , input  t-cnf.beg-date
     1449                 , input  t-cnf.end-date
     1450                 , output t-cnf.param-encoded
     1451                 ) no-error.
     1452               if error-status :error then do:
     1453                 message
     1454                   vss-workfile vss-revision vss-description skip
     1455                   substitute("Ошибка кодировки параметра &1 для БД &2", t-cnf.param-code, t-cnf.db-num ) skip
     1456                   error-status :get-message(1) skip
     1457                   return-value skip
     1458                   view-as alert-box error .
     1459                 undo block_exp, retry block_exp .
     1460               end.
     1461             end.
     1462             export stream txt-file delimiter "`" t-cnf except stts                           param-PS                       param-name                     is-changed                     NotUsed                        ErrorExist.
     1463             assign
     1464               p-qnty-cnf = p-qnty-cnf + 1
     1465             .
     1466           end.
     1467         end.
     1468       end.
     1469       output stream txt-file close.
     1470       delete t-cnf .
     1471       assign
     1472         file-info:file-name = search( v-file-name )
     1473         v-file-name         = file-info:full-pathname
     1474       .
     1475       run gbl/md5.p
     1476         ( input  v-file-name
     1477         , output v-md5-signature
     1478         ) no-error.
     1479       if error-status :error
     1480         or trim( v-md5-signature ) = "":U
     1481       then do:
     1482         return error substitute( "&1 (export-cnf). Ошибка при подсчете контрольной суммы (&2) файла конфигурации!. &3&4&5"
     1483                                  , vss-workfile
     1484                                  , v-md5-signature
     1485                                  , return-value
     1486                                  , chr(10)
     1487                                  , error-status :get-message ( 1 )
     1488                                ).
     1489       end.
     1490       output stream txt-file to value(v-file-name) append.
     1491       put stream txt-file unformatted substitute( "&1&2", chr(1), sum-enc( v-md5-signature, 10 ) ) skip.
     1492       output stream txt-file close.
     1493       run waitfram-hide in this-procedure .
     1494     end.
     1495   end procedure.
     1496   PROCEDURE chk-param.
     1497     define parameter buffer par-cnf for cnf.
     1498     assign
     1499       err-level = par-cnf.ErrorExist
     1500     .
     1501     find first cnf-struct
     1502       where cnf-struct.param-code = par-cnf.param-code
     1503       no-error.
     1504     if not available cnf-struct then do:
     1505       assign
     1506         par-cnf.NotUsed    = true
     1507         par-cnf.ErrorExist = 2
     1508       .
     1509       run log-error in str-hdl ("параметр " + par-cnf.param-code + " не допустим в текущей схеме", 1).
     1510       return.
     1511     end.
     1512     assign
     1513       par-cnf.param-name = cnf-struct.param-name
     1514       par-cnf.param-PS   = cnf-struct.PS
     1515     .
     1516     if stand-alone = true then do:
     1517       assign
     1518         par-cnf.conf-type = cnf-struct.param-type
     1519       .
     1520     end.
     1521     if cnf-struct.param-type <> par-cnf.conf-type then do:
     1522       run log-error in str-hdl ("параметр " + par-cnf.param-code + " имеет тип настройки (" +
     1523                                 par-cnf.conf-type + "), несоответствующий схеме (" + cnf-struct.param-type + ")", 2).
     1524     end.
     1525     run cnv-param-type in str-hdl (cnf-struct.data-type).
     1526     if par-cnf.param-type <> return-value then do:
     1527       run log-error in str-hdl ("параметр " + par-cnf.param-code + " имеет тип параметра (" +
     1528                                   par-cnf.param-type + "), несоответствующий схеме (" + cnf-struct.data-type + ")", 2).
     1529     end.
     1530     case cnf-struct.attach-type:
     1531       when 'Фирма':U then do:
     1532           if par-cnf.host-code <> 0 and not stand-alone then do:
     1533             run chk-company in db-hdl (par-cnf.host-code) no-error.
     1534             if return-value <> "" then do:
     1535                 run log-error in str-hdl ("параметр "  + par-cnf.param-code + " имеет неправильный код фирмы "
     1536                                           + string(par-cnf.host-code), 1).
     1537                 if can-find (first cnf where cnf.param-code  = par-cnf.param-code and
     1538                                               cnf.host-code   = 0                  and
     1539                                               recid (cnf)    <> recid (par-cnf))  then do:
     1540                   run log-error in str-hdl ("параметр "  + par-cnf.param-code + " код фирмы "
     1541                                               + string(par-cnf.host-code) + " удален", 1).
     1542                   return.
     1543                 end.
     1544                 else do:
     1545                   par-cnf.host-code = 0 .
     1546                   run log-error in str-hdl ("параметр "  + par-cnf.param-code + " код фирмы "
     1547                                               + string(par-cnf.host-code) + " привязка отменена", 1).
     1548                 end.
     1549             end.
     1550           end.
     1551           if (par-cnf.obj-code <> 0   or
     1552               par-cnf.obj-type <> "" ) then do:
     1553                 run log-error in str-hdl ("параметр "  + par-cnf.param-code + " не может иметь привязки к объекту "
     1554                                           + par-cnf.obj-type + " " + string (par-cnf.obj-code), 1).
     1555                 assign par-cnf.is-changed  = true
     1556                         par-cnf.obj-code = 0
     1557                         par-cnf.obj-type = "".
     1558           end.
     1559       end.
     1560       when 'Объект':U then do:
     1561           define variable obj-host-code like par-cnf.host-code no-undo.
     1562           if not stand-alone then do:
     1563               if par-cnf.host-code <> 0 then do:
     1564                 run chk-company in db-hdl (par-cnf.host-code) no-error.
     1565                 if return-value <> "" then do:
     1566                     run log-error in str-hdl ("параметр "  + par-cnf.param-code + " имеет неправильный код фирмы "
     1567                                               + string(par-cnf.host-code), 1).
     1568                     if can-find (first cnf where cnf.param-code  = par-cnf.param-code and
     1569                                                   cnf.host-code   = 0                  and
     1570                                                   cnf.obj-type    = ""                 and
     1571                                                   cnf.Obj-code    = 0                  and
     1572                                                   recid (cnf)    <> recid (par-cnf))  then do:
     1573                       run log-error in str-hdl ("параметр "  + par-cnf.param-code + " код фирмы "
     1574                                                   + string(par-cnf.host-code) + " удален", 1).
     1575                       delete par-cnf.
     1576                       return.
     1577                     end.
     1578                     else do:
     1579                       assign
     1580                         par-cnf.host-code = 0
     1581                         par-cnf.obj-type  = ""
     1582                         par-cnf.obj-code  = 0 .
     1583                       run log-error in str-hdl ("параметр "  + par-cnf.param-code + " код фирмы "
     1584                                                   + string(par-cnf.host-code) + " привязка отменена", 1).
     1585                     end.
     1586                 end.
     1587               end.
     1588               if par-cnf.obj-code  <> 0 then do:
     1589                 run chk-host-code in db-hdl (par-cnf.obj-type, par-cnf.obj-code, output obj-host-code).
     1590                 if obj-host-code      = ?              or
     1591                   par-cnf.host-code <> obj-host-code   then do:
     1592                   run log-error in str-hdl ("параметр "  + string (par-cnf.param-code) + " код фирмы " + string(par-cnf.host-code)
     1593                                               + " номер объекта " + string(par-cnf.obj-code)
     1594                                               + " тип объекта " + string(par-cnf.obj-type)
     1595                                               + " имеет несоответствие объекта и фирмы ", 1).
     1596                   if can-find (first cnf where cnf.param-code  = par-cnf.param-code and
     1597                                               cnf.host-code   = par-cnf.host-code  and
     1598                                               cnf.obj-type    = ""                 and
     1599                                               cnf.Obj-code    = 0                  and
     1600                                               recid (cnf)    <> recid (par-cnf))  then do:
     1601                     run log-error in str-hdl ("параметр "  + par-cnf.param-code + " код фирмы " + string(par-cnf.host-code)
     1602                                                 + " номер объекта " + string(par-cnf.obj-code)
     1603                                                 + " тип объекта " + string(par-cnf.obj-type)
     1604                                                 + " удален", 1).
     1605                     delete par-cnf.
     1606                     return.
     1607                   end.
     1608                   else do:
     1609                     assign
     1610                       par-cnf.obj-type  = ""
     1611                       par-cnf.obj-code  = 0 .
     1612                     run log-error in str-hdl ("параметр "  + par-cnf.param-code + " код фирмы "
     1613                                               + string(par-cnf.host-code) + " привязка к объекту отменена", 1).
     1614                   end.
     1615                 end.
     1616               end.
     1617           end.
     1618       end.
     1619       otherwise do:
     1620           if par-cnf.host-code <> 0 then do:
     1621                 run log-error in str-hdl ("параметр "  + string(par-cnf.param-code) + " не может иметь привязки к фирме "
     1622                                           + string(par-cnf.host-code), 1).
     1623                 assign par-cnf.is-changed    = true
     1624                         par-cnf.host-code = 0 .
     1625           end.
     1626           if par-cnf.obj-code <> 0   or
     1627             par-cnf.obj-type <> ""  then do:
     1628                 run log-error in str-hdl ("параметр "  + string(par-cnf.param-code) + " не может иметь привязки к объекту "
     1629                                           + par-cnf.obj-type + " " + string (par-cnf.obj-code), 1).
     1630                 assign par-cnf.is-changed   = true
     1631                         par-cnf.obj-code = 0
     1632                         par-cnf.obj-type = "".
     1633           end.
     1634       end.
     1635     end case.
     1636     if cnf-struct.list-value <> "" then do:
     1637       if lookup(par-cnf.param-value, cnf-struct.list-value) = 0 then do:
     1638           run log-error in str-hdl ("параметр "  + string(par-cnf.param-code) + " имеет недопустимое значение "
     1639                                     + par-cnf.param-value + "(из " + cnf-struct.list-value + ")", 1).
     1640       end.
     1641     end.
     1642     par-cnf.ErrorExist = maximum (err-level, par-cnf.ErrorExist) .
     1643   END PROCEDURE.
