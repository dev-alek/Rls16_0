        1   CREATE WIDGET-POOL.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Настройки online backup (SmartObject)".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   procedure proc-alt-shift-f2:
       67     if not ibs.th.gbl.gbl-var:rcode
       68   then
       69     run gbl\inidebug.p .
       70   end.
       71   procedure proc-alt-shift-f3:
       72     run gbl/prvssinf.p
       73       ( input this-procedure
       74       ) .
       75   end.
       76   define variable v-inform-launched as logical no-undo initial false .
       77   procedure proc-alt-shift-f4:
       78     define variable v-action as character no-undo .
       79     if v-inform-launched = false then do:
       80       assign
       81         v-inform-launched = true
       82       .
       83       run gbl/d-inform.w
       84         (  input self
       85         ,  input this-procedure
       86         , output v-action
       87         ) no-error .
       88       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       89       assign
       90         v-inform-launched = false
       91       .
       92     end.
       93   end.
       94   procedure proc-alt-f1:
       95     run gbl/corrhelp.p
       96       (input this-procedure
       97       ) .
       98   end .
       99   on alt-shift-f2 anywhere do:
      100     run proc-alt-shift-f2.
      101   end.
      102   on alt-shift-f3 anywhere do:
      103     run proc-alt-shift-f3 in this-procedure .
      104   end.
      105   on alt-shift-f4 anywhere do:
      106     run proc-alt-shift-f4 in this-procedure.
      107   end.
      108   on alt-f1 anywhere do:
      109     run proc-alt-f1 in this-procedure .
      110   end.
      111   define stream test.
      112   DEFINE BUTTON b-save DEFAULT
      113        LABEL "&Сохранить"
      114        SIZE 10 BY 1
      115        BGCOLOR 8 .
      116   DEFINE BUTTON b-sel-bat-name DEFAULT
      117        IMAGE-UP FILE "btn-down-arrow":U
      118        IMAGE-DOWN FILE "btn-down-arrow":U
      119        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      120        LABEL "":L
      121        SIZE 2.5 BY 1.08.
      122   DEFINE BUTTON b-sel-msg-name DEFAULT
      123        IMAGE-UP FILE "btn-down-arrow":U
      124        IMAGE-DOWN FILE "btn-down-arrow":U
      125        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      126        LABEL "":L
      127        SIZE 2.5 BY 1.08.
      128   DEFINE BUTTON b-sel-path-dlc DEFAULT
      129        IMAGE-UP FILE "btn-down-arrow":U
      130        IMAGE-DOWN FILE "btn-down-arrow":U
      131        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      132        LABEL "":L
      133        SIZE 2.5 BY 1.08.
      134   DEFINE BUTTON b-sel-path-dst-db DEFAULT
      135        IMAGE-UP FILE "btn-down-arrow":U
      136        IMAGE-DOWN FILE "btn-down-arrow":U
      137        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      138        LABEL "":L
      139        SIZE 2.5 BY 1.08.
      140   DEFINE BUTTON b-sel-path-src-db DEFAULT
      141        IMAGE-UP FILE "btn-down-arrow":U
      142        IMAGE-DOWN FILE "btn-down-arrow":U
      143        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      144        LABEL "":L
      145        SIZE 2.5 BY 1.08.
      146   DEFINE VARIABLE v-bat-name AS CHARACTER FORMAT "X(256)":U
      147        LABEL "Файл запуска"
      148        VIEW-AS FILL-IN
      149        SIZE 38 BY 1 NO-UNDO.
      150   DEFINE VARIABLE v-msg-name AS CHARACTER FORMAT "X(256)":U
      151        LABEL "Файл сообщений"
      152        VIEW-AS FILL-IN
      153        SIZE 38 BY 1 NO-UNDO.
      154   DEFINE VARIABLE v-path-dlc AS CHARACTER FORMAT "X(256)":U
      155        LABEL "Каталог Progress"
      156        VIEW-AS FILL-IN
      157        SIZE 38 BY 1 NO-UNDO.
      158   DEFINE VARIABLE v-path-dst-db AS CHARACTER FORMAT "X(256)":U
      159        LABEL "Каталог для копии БД"
      160        VIEW-AS FILL-IN
      161        SIZE 38 BY 1 NO-UNDO.
      162   DEFINE VARIABLE v-path-src-db AS CHARACTER FORMAT "X(256)":U
      163        LABEL "БД для backup"
      164        VIEW-AS FILL-IN
      165        SIZE 38 BY 1 NO-UNDO.
      166   DEFINE VARIABLE v-run-bkp AS LOGICAL INITIAL no
      167        LABEL "Проводить online backup в СПН"
      168        VIEW-AS TOGGLE-BOX
      169        SIZE 33.13 BY .67 NO-UNDO.
      170   DEFINE FRAME F-bkp-prop
      171        b-save AT ROW 1.13 COL 1
      172        v-run-bkp AT ROW 2.5 COL 2.5
      173        b-sel-bat-name AT ROW 3.42 COL 63.5
      174        v-bat-name AT ROW 3.5 COL 23 COLON-ALIGNED
      175        v-msg-name AT ROW 4.63 COL 23 COLON-ALIGNED
      176        b-sel-msg-name AT ROW 4.63 COL 63.5
      177        b-sel-path-dlc AT ROW 5.71 COL 63.5
      178        v-path-dlc AT ROW 5.79 COL 23 COLON-ALIGNED
      179        b-sel-path-src-db AT ROW 6.88 COL 63.5
      180        v-path-src-db AT ROW 6.96 COL 23 COLON-ALIGNED
      181        b-sel-path-dst-db AT ROW 8 COL 63.5
      182        v-path-dst-db AT ROW 8.08 COL 23 COLON-ALIGNED
      183       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      184            SIDE-LABELS NO-UNDERLINE THREE-D
      185            AT COL 1 ROW 1
      186            SIZE 66.13 BY 8.13.
      187   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      188   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      189   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      190   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      191   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      192   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      193   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      194   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      195       ASSIGN adm-object-hdl = FRAME F-bkp-prop:HANDLE.
      196   RUN ensure-broker.
      197   THIS-PROCEDURE:ADM-DATA =
      198        'ADM1.1~`':U +
      199        'SmartObject~`':U +
      200        'FRAME~`':U +
      201        'NO ~`':U +
      202        '~`':U +
      203        '~`':U +
      204        '~`':U +
      205        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      206           + "~`":U +
      207        'Layout,Hide-on-Init~`':U +
      208        '~`':U +
      209        '~`':U +
      210        '~`~`~`~`~`~`~`~`~`~`~`':U +
      211        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      212            THEN "^^":U
      213        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      214             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      215   PROCEDURE adm-apply-entry :
      216     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      217   END PROCEDURE.
      218   PROCEDURE adm-destroy :
      219    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      220   END PROCEDURE.
      221   PROCEDURE adm-disable :
      222       DISABLE b-save v-run-bkp b-sel-bat-name v-bat-name v-msg-name b-sel-msg-name b-sel-path-dlc v-path-dlc b-sel-path-src-db v-path-src-db b-sel-path-dst-db v-path-dst-db WITH FRAME F-bkp-prop.
      223       RUN dispatch ('disable-fields':U).
      224       RUN set-attribute-list ('ENABLED=no':U).
      225       RETURN.
      226   END PROCEDURE.
      227   PROCEDURE adm-edit-attribute-list :
      228         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
      229         RETURN.
      230   END PROCEDURE.
      231   PROCEDURE adm-enable :
      232       ENABLE UNLESS-HIDDEN b-save v-run-bkp b-sel-bat-name v-bat-name v-msg-name b-sel-msg-name b-sel-path-dlc v-path-dlc b-sel-path-src-db v-path-src-db b-sel-path-dst-db v-path-dst-db WITH FRAME F-bkp-prop.
      233       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      234       RUN set-attribute-list ('ENABLED=yes':U).
      235       RETURN.
      236   END PROCEDURE.
      237   PROCEDURE adm-exit :
      238        RUN notify ('exit':U).
      239     RETURN.
      240   END PROCEDURE.
      241   PROCEDURE adm-hide :
      242     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      243   END PROCEDURE.
      244   PROCEDURE adm-initialize :
      245     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      246   END PROCEDURE.
      247   PROCEDURE adm-show-errors :
      248       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      249       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      250           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      251       END.
      252       RETURN.
      253   END PROCEDURE.
      254   PROCEDURE adm-UIB-mode :
      255     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      256   END PROCEDURE.
      257   PROCEDURE adm-view :
      258     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      259   END PROCEDURE.
      260   PROCEDURE dispatch :
      261       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      262       RUN broker-dispatch IN adm-broker-hdl
      263           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      264       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      265   END PROCEDURE.
      266   PROCEDURE ensure-broker :
      267   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      268   IF RETURN-VALUE NE "ADM-Broker":U THEN
      269   DO:
      270       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      271       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      272   END.
      273   END PROCEDURE.
      274   PROCEDURE get-attribute :
      275     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      276     RUN broker-get-attribute IN adm-broker-hdl
      277         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      278     RETURN RETURN-VALUE.
      279   END PROCEDURE.
      280   PROCEDURE get-attribute-list :
      281     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      282     RUN broker-get-attribute-list IN adm-broker-hdl
      283         (INPUT THIS-PROCEDURE,
      284          INPUT ?,
      285          OUTPUT p-attr-list) NO-ERROR.
      286     RETURN.
      287   END PROCEDURE.
      288   PROCEDURE new-state :
      289     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      290     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      291     RETURN.
      292   END PROCEDURE.
      293   PROCEDURE notify :
      294     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      295     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      296     IF RETURN-VALUE = "ADM-ERROR":U THEN
      297         RETURN "ADM-ERROR":U.
      298     RETURN.
      299   END PROCEDURE.
      300   PROCEDURE set-attribute-list :
      301     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      302     RUN ensure-broker.
      303     RUN broker-set-attribute-list IN adm-broker-hdl
      304         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      305     RETURN.
      306   END PROCEDURE.
      307   PROCEDURE set-position :
      308       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      309       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      310       IF VALID-HANDLE(adm-object-hdl) THEN
      311       DO:
      312           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
      313           IF adm-object-hdl:TYPE = "WINDOW":U THEN
      314           DO:
      315             IF p-row = 0 THEN p-row =
      316               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
      317             IF p-col = 0 THEN p-col =
      318               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
      319           END.
      320           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
      321           DO:
      322             parent-hdl = adm-object-hdl:PARENT.
      323             IF p-row = 0 THEN p-row =
      324               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
      325                 parent-hdl:ROW.
      326             IF p-col = 0 THEN p-col =
      327               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
      328                 parent-hdl:COL.
      329           END.
      330           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
      331           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
      332         ASSIGN adm-object-hdl:ROW    =   p-row
      333                adm-object-hdl:COLUMN =   p-col.
      334       END.
      335       RETURN.
      336   END PROCEDURE.
      337   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
      338       STRING(adm-object-hdl)).
      339   PAUSE 0 BEFORE-HIDE.
      340   PROCEDURE adm-change-page :
      341     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
      342     END PROCEDURE.
      343   PROCEDURE delete-page :
      344     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
      345     RUN broker-delete-page IN adm-broker-hdl
      346         (INPUT THIS-PROCEDURE, INPUT p-page#).
      347     END PROCEDURE.
      348   PROCEDURE init-object :
      349     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
      350     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
      351     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
      352     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
      353     RUN broker-init-object IN adm-broker-hdl
      354         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
      355          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
      356     RETURN.
      357   END PROCEDURE.
      358   PROCEDURE init-pages :
      359     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
      360     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      361         INPUT p-page-list) NO-ERROR.
      362     END PROCEDURE.
      363   PROCEDURE select-page :
      364     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
      365     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      366         INPUT p-page#) NO-ERROR.
      367     END PROCEDURE.
      368   PROCEDURE view-page :
      369     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
      370     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      371         INPUT p-page#).
      372     END PROCEDURE.
      373   ON CHOOSE OF b-save IN FRAME F-bkp-prop
      374   DO:
      375     define variable v2-run-bkp-str as character no-undo .
      376     assign
      377       v-run-bkp
      378       v-bat-name
      379       v-msg-name
      380       v-path-dlc
      381       v-path-src-db
      382       v-path-dst-db
      383     .
      384     if v-run-bkp = true then do:
      385       assign
      386         v2-run-bkp-str = "YES":U
      387       .
      388       if search( v-bat-name ) = ? then do:
      389         message
      390           vss-workfile vss-revision vss-description skip
      391           substitute( "Файл запуска online backup (&1) не найден!", v-bat-name ) skip
      392           view-as alert-box error.
      393         return no-apply.
      394       end.
      395       put-key-value section "onlinebkp":U key "bat-name":U value v-bat-name  no-error.
      396       if error-status:error then do:
      397         message
      398           vss-workfile vss-revision vss-description skip
      399           "Файл настроек progress доступен только для чтения!" skip
      400           "Сохранение параметров невозможно."
      401           view-as alert-box error.
      402         return no-apply.
      403       end.
      404       put-key-value section "onlinebkp":U key "msg-name":U value v-msg-name  no-error.
      405       if error-status:error then do:
      406         message
      407           vss-workfile vss-revision vss-description skip
      408           "Файл настроек progress доступен только для чтения!" skip
      409           "Сохранение параметров невозможно."
      410           view-as alert-box error.
      411         return no-apply.
      412       end.
      413       if v-path-dlc = "":U then do:
      414         message
      415           vss-workfile vss-revision vss-description skip
      416           "Не задан каталог Progress!" skip
      417           view-as alert-box error.
      418         apply "entry" to v-path-dlc in frame F-bkp-prop .
      419         return no-apply.
      420       end.
      421       run check-dir ( input-output v-path-dlc ) no-error.
      422       if error-status :error then do:
      423         message
      424           vss-workfile vss-revision vss-description skip
      425           return-value skip
      426           "Задайте каталог Progress!" skip
      427           error-status :get-message(0) skip
      428           error-status :get-message(1)
      429           view-as alert-box error.
      430         apply "entry" to v-path-dlc in frame F-bkp-prop .
      431         return no-apply.
      432       end.
      433       else do:
      434         put-key-value section "onlinebkp":U key "path-dlc":U value v-path-dlc  no-error.
      435         if error-status:error then do:
      436           message
      437             vss-workfile vss-revision vss-description skip
      438             "Файл настроек progress доступен только для чтения!" skip
      439             "Сохранение параметров невозможно."
      440             view-as alert-box error.
      441           return no-apply.
      442         end.
      443       end.
      444       put-key-value section "onlinebkp":U key "path-src-db":U value v-path-src-db .
      445       if error-status:error then do:
      446         message
      447           vss-workfile vss-revision vss-description skip
      448           "Файл настроек progress доступен только для чтения!" skip
      449           "Сохранение параметров невозможно."
      450           view-as alert-box error.
      451         return no-apply.
      452       end.
      453       put-key-value section "onlinebkp":U key "path-dst-db":U value v-path-dst-db .
      454       if error-status:error then do:
      455         message
      456           vss-workfile vss-revision vss-description skip
      457           "Файл настроек progress доступен только для чтения!" skip
      458           "Сохранение параметров невозможно."
      459           view-as alert-box error.
      460         return no-apply.
      461       end.
      462     end.
      463     else do:
      464       assign
      465         v2-run-bkp-str = "NO":U
      466       .
      467     end.
      468     put-key-value section "onlinebkp":U key "run-bkp":U value v2-run-bkp-str .
      469     if error-status:error then do:
      470       message
      471         vss-workfile vss-revision vss-description skip
      472         "Файл настроек progress доступен только для чтения!" skip
      473         "Сохранение параметров невозможно."
      474         view-as alert-box error.
      475       return no-apply.
      476     end.
      477     message
      478       "Настройки Online backup сохранены"
      479       view-as alert-box information.
      480   END.
      481   ON CHOOSE OF b-sel-bat-name IN FRAME F-bkp-prop
      482   DO:
      483     define variable v-file-name as character no-undo .
      484     define variable v-ok        as logical no-undo .
      485     system-dialog get-file v-file-name
      486       filters "Исполняемые файлы (*.exe,*.bat)" "*.exe,*.bat",
      487               "Все файлы (*.*)" "*.*"
      488       title "Выберите имя файла для запуска online backup"
      489       update v-ok
      490     .
      491     if v-ok = true then do:
      492       assign
      493         v-bat-name = v-file-name
      494       .
      495       display
      496         v-bat-name
      497         with frame F-bkp-prop
      498       .
      499     end.
      500     APPLY "ENTRY" TO v-bat-name IN FRAME F-bkp-prop .
      501   END.
      502   ON CHOOSE OF b-sel-msg-name IN FRAME F-bkp-prop
      503   DO:
      504     define variable v-file-name as character no-undo .
      505     define variable v-ok        as logical no-undo .
      506     system-dialog get-file v-file-name
      507       filters "Текстовые файлы (*.txt,*.log)" "(*.txt,*.log)",
      508               "Все файлы (*.*)" "*.*"
      509       title "Выберите имя файла сообщений"
      510       update v-ok
      511     .
      512     if v-ok = true then do:
      513       assign
      514         v-msg-name = v-file-name
      515       .
      516       display
      517         v-msg-name
      518         with frame F-bkp-prop
      519       .
      520     end.
      521     APPLY "ENTRY" TO v-msg-name IN FRAME F-bkp-prop .
      522   END.
      523   ON CHOOSE OF b-sel-path-dlc IN FRAME F-bkp-prop
      524   DO:
      525     define variable v-dir-name  as character no-undo .
      526     define variable v-type      as character no-undo .
      527     define variable v-can-write as logical   no-undo .
      528     run gbl/dir-sel.p ( output v-dir-name
      529                    ,output v-type
      530                    ,output v-can-write
      531                   ).
      532     if v-can-write then do:
      533       assign
      534         v-path-dlc = v-dir-name
      535       .
      536       display
      537         v-path-dlc
      538         with frame F-bkp-prop
      539       .
      540     end.
      541     APPLY "ENTRY" TO v-path-dlc IN FRAME F-bkp-prop .
      542   END.
      543   ON CHOOSE OF b-sel-path-dst-db IN FRAME F-bkp-prop
      544   DO:
      545     define variable v-dir-name  as character no-undo .
      546     define variable v-type      as character no-undo .
      547     define variable v-can-write as logical   no-undo .
      548     run gbl/dir-sel.p ( output v-dir-name
      549                    ,output v-type
      550                    ,output v-can-write
      551                   ).
      552     if v-can-write then do:
      553       assign
      554         v-path-dst-db = v-dir-name
      555       .
      556       display
      557         v-path-dst-db
      558         with frame F-bkp-prop
      559       .
      560     end.
      561     APPLY "ENTRY" TO v-path-dst-db IN FRAME F-bkp-prop .
      562   END.
      563   ON CHOOSE OF b-sel-path-src-db IN FRAME F-bkp-prop
      564   DO:
      565     define variable v-file-name as character no-undo .
      566     define variable v-ok        as logical no-undo .
      567     system-dialog get-file v-file-name
      568       filters "Файлы баз данных (*.db)" "*.db",
      569               "Все файлы (*.*)" "*.*"
      570       title "Укажите БД для online backup"
      571       update v-ok
      572     .
      573     if v-ok = true then do:
      574       assign
      575         v-path-src-db = v-file-name
      576       .
      577       display
      578         v-path-src-db
      579         with frame F-bkp-prop
      580       .
      581     end.
      582     APPLY "ENTRY" TO v-path-src-db IN FRAME F-bkp-prop .
      583   END.
      584   ON VALUE-CHANGED OF v-run-bkp IN FRAME F-bkp-prop
      585   DO:
      586     assign
      587       v-run-bkp
      588     .
      589     if v-run-bkp = true then do:
      590       enable b-sel-bat-name v-bat-name b-sel-msg-name v-msg-name
      591              b-sel-path-dlc v-path-dlc b-sel-path-src-db v-path-src-db
      592              b-sel-path-dst-db v-path-dst-db
      593           with frame F-bkp-prop.
      594     end.
      595     else do:
      596       disable b-sel-bat-name v-bat-name b-sel-msg-name v-msg-name
      597               b-sel-path-dlc v-path-dlc b-sel-path-src-db v-path-src-db
      598               b-sel-path-dst-db v-path-dst-db
      599           with frame F-bkp-prop.
      600     end.
      601   END.
      602   if not this-procedure :persistent
      603   then do:
      604     message
      605       vss-workfile vss-revision vss-description skip
      606       "Ошибка при запуске процедуры" skip
      607       "Данную процедуру следует запускать только с параметром persistent" skip
      608       view-as alert-box error .
      609     undo, return error .
      610   end.
      611   define variable v-run-bkp-str as character no-undo .
      612   get-key-value section "onlinebkp":U key "run-bkp":U value v-run-bkp-str .
      613   get-key-value section "onlinebkp":U key "bat-name":U value v-bat-name .
      614   get-key-value section "onlinebkp":U key "msg-name":U value v-msg-name .
      615   get-key-value section "onlinebkp":U key "path-dlc":U value v-path-dlc .
      616   get-key-value section "onlinebkp":U key "path-src-db":U value v-path-src-db .
      617   get-key-value section "onlinebkp":U key "path-dst-db":U value v-path-dst-db .
      618   if v-run-bkp-str = ?
      619     or CAPS( v-run-bkp-str ) = "FALSE":U
      620     or CAPS( v-run-bkp-str ) = "NO":U
      621   then do:
      622     assign
      623       v-run-bkp = false
      624     .
      625   end.
      626   else do:
      627     assign
      628       v-run-bkp = true
      629     .
      630   end.
      631   if v-bat-name = ? then do:
      632     assign
      633       v-bat-name = "":U
      634     .
      635   end.
      636   if v-msg-name = ? then do:
      637     assign
      638       v-msg-name = "":U
      639     .
      640   end.
      641   if v-path-dlc = ? then do:
      642     assign
      643       v-path-dlc = "":U
      644     .
      645   end.
      646   if v-path-src-db = ? then do:
      647     assign
      648       v-path-src-db = "":U
      649     .
      650   end.
      651   if v-path-dst-db = ? then do:
      652     assign
      653       v-path-dst-db = "":U
      654     .
      655   end.
      656   PROCEDURE adm-create-objects :
      657   END PROCEDURE.
      658   PROCEDURE adm-row-available :
      659     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
      660     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
      661     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
      662     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
      663     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
      664     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
      665     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
      666     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
      667     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
      668     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
      669     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      670     IF adm-updating-record THEN RETURN.
      671     RUN get-attribute ('FIELDS-ENABLED':U).
      672     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
      673     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
      674         OUTPUT link-handle) NO-ERROR.
      675     IF link-handle = "":U THEN
      676         RETURN.
      677     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
      678     IF NUM-ENTRIES(link-handle) > 1 THEN
      679         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
      680             "encountered more than one RECORD-SOURCE.":U SKIP
      681             "The first - ":U record-source-hdl:file-name " - will be used.":U
      682                VIEW-AS ALERT-BOX ERROR.
      683     RUN get-attribute ('Key-Name':U).
      684     key-name = RETURN-VALUE.
      685     IF key-name = "":U THEN key-name = ?.
      686     IF key-name NE ? THEN DO:
      687       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
      688         NO-ERROR.
      689       IF key-value NE ? THEN
      690         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
      691     END.
      692   IF VALID-HANDLE (adm-object-hdl) THEN
      693       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      694   RUN notify IN THIS-PROCEDURE ('row-available':U).
      695   END PROCEDURE.
      696   PROCEDURE check-dir :
      697   define input-output parameter p-dir-name as character no-undo .
      698   do
      699   on error undo, return error
      700   :
      701     define variable v-log as logical no-undo .
      702     assign
      703       file-info:file-name = p-dir-name
      704     .
      705     if file-info:file-type = ?
      706       or index( file-info:file-type, "D":U ) = 0
      707     then do:
      708       return error substitute( "Каталог &1 не существует!", p-dir-name ).
      709     end.
      710     if file-info:file-type <> ? then do:
      711       assign
      712         p-dir-name = file-info:full-pathname
      713       .
      714     end.
      715   end.
      716   END PROCEDURE.
      717   PROCEDURE disable_UI :
      718     HIDE FRAME F-bkp-prop.
      719     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
      720   END PROCEDURE.
      721   PROCEDURE enable_UI :
      722     DISPLAY v-run-bkp v-bat-name v-msg-name v-path-dlc v-path-src-db v-path-dst-db
      723         WITH FRAME F-bkp-prop.
      724     ENABLE b-save v-run-bkp b-sel-bat-name v-bat-name v-msg-name b-sel-msg-name
      725            b-sel-path-dlc v-path-dlc b-sel-path-src-db v-path-src-db
      726            b-sel-path-dst-db v-path-dst-db
      727         WITH FRAME F-bkp-prop.
      728   END PROCEDURE.
      729   PROCEDURE local-initialize :
      730     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
      731     apply "value-changed" to v-run-bkp in frame F-bkp-prop.
      732   END PROCEDURE.
      733   PROCEDURE send-records :
      734   END PROCEDURE.
      735   PROCEDURE state-changed :
      736     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
      737     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      738   END PROCEDURE.
