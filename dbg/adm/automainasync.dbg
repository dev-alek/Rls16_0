        1   create widget-pool.
        2   define input parameter i-auto-type as character no-undo .
        3   define input parameter i-mode      as character no-undo .
        4   define input parameter inumSession as integer no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Главное окно запуска автоматических процедур по расписанию".
       11   define variable mAsyncHelper as class ibs.th.file.AsyncHelperth  no-undo.
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define new  shared variable g#auto as logical no-undo.
       73   define new  shared variable g#news as logical no-undo.
       74   define new  shared variable g#oxml as logical no-undo.
       75   define new  shared variable g#esys as logical no-undo.
       76   define new  shared variable g#news-source-db as integer no-undo.
       77   define new  shared variable g#esys-source-esys as integer no-undo.
       78   define new  shared variable g#db-num as integer   no-undo .
       79   define new  shared variable g#userid as character no-undo .
       80   define new  shared variable g#passwd as character no-undo .
       81   procedure proc-alt-shift-f2:
       82     if not ibs.th.gbl.gbl-var:rcode
       83   then
       84     run gbl\inidebug.p .
       85   end.
       86   procedure proc-alt-shift-f3:
       87     run gbl/prvssinf.p
       88       ( input this-procedure
       89       ) .
       90   end.
       91   define variable v-inform-launched as logical no-undo initial false .
       92   procedure proc-alt-shift-f4:
       93     define variable v-action as character no-undo .
       94     if v-inform-launched = false then do:
       95       assign
       96         v-inform-launched = true
       97       .
       98       run gbl/d-inform.w
       99         (  input self
      100         ,  input this-procedure
      101         , output v-action
      102         ) no-error .
      103       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      104       assign
      105         v-inform-launched = false
      106       .
      107     end.
      108   end.
      109   procedure proc-alt-f1:
      110     run gbl/corrhelp.p
      111       (input this-procedure
      112       ) .
      113   end .
      114   on alt-shift-f2 anywhere do:
      115     run proc-alt-shift-f2.
      116   end.
      117   on alt-shift-f3 anywhere do:
      118     run proc-alt-shift-f3 in this-procedure .
      119   end.
      120   on alt-shift-f4 anywhere do:
      121     run proc-alt-shift-f4 in this-procedure.
      122   end.
      123   on alt-f1 anywhere do:
      124     run proc-alt-f1 in this-procedure .
      125   end.
      126   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      127   define  shared variable g#auto-pid           as integer   no-undo .
      128   define  shared variable conn-par             as character no-undo .
      129   define  shared variable g#auto-user-id       as character no-undo .
      130   define  shared variable g#auto-user-login    as character no-undo .
      131   define  shared variable g#auto-user-password as character no-undo .
      132   define  shared variable v-socket             as logical   no-undo .
      133   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      134   define  shared variable auto-window-h     as handle    no-undo .
      135   define  shared variable auto-log-msg-h    as handle    no-undo .
      136   define  shared variable hand-log-msg-h    as handle    no-undo .
      137   define  shared variable log-file-name     as character no-undo initial ? .
      138   define  shared variable add-log-file-name as character no-undo initial ? .
      139   define  shared variable writelogvalue     as character no-undo initial ? .
      140   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      141   procedure cur-time :
      142      define output parameter p-today as date      no-undo .
      143      define output parameter p-time  as integer   no-undo .
      144     do
      145     on error undo, return error
      146     :
      147       define variable v-date1 as date      no-undo .
      148       define variable v-date2 as date      no-undo .
      149       define variable v-time  as integer   no-undo .
      150       assign
      151         v-date1 = today
      152         v-time  = time
      153         v-date2 = today
      154       .
      155       if v-date1 <> v-date2
      156       then do:
      157         assign
      158           v-date1 = today
      159           v-time  = v-time
      160         .
      161       end.
      162       assign
      163         p-today = v-date1
      164         p-time  = v-time
      165       .
      166     end.
      167   end.
      168   function cur-time-date returns character
      169   :
      170     return string(today, '99/99/9999':U) .
      171   end.
      172   function cur-time-mjd returns decimal
      173   :
      174     define variable v-date as date      no-undo .
      175     define variable v-time as integer   no-undo .
      176     run cur-time in this-procedure
      177       (output v-date
      178       ,output v-time
      179       ) .
      180     return integer(v-date) - 2400002 + (v-time / 86400) .
      181   end.
      182   function cur-time-get-ending-index returns integer
      183   (input p-number as integer
      184   )
      185   :
      186     if p-number < 0
      187     or p-number = ?
      188     then do:
      189       return 1 .
      190     end.
      191     define variable v-rest as integer   no-undo .
      192     assign
      193       p-number = p-number modulo 100
      194     .
      195     if p-number < 20
      196     then do:
      197       assign
      198         v-rest = p-number
      199       .
      200     end.
      201     else do:
      202       assign
      203         v-rest = p-number modulo 10
      204       .
      205     end.
      206     case v-rest :
      207       when 1
      208       then do:
      209         return 2 .
      210       end.
      211       when 2 or
      212       when 3 or
      213       when 4
      214       then do:
      215         return 3 .
      216       end.
      217       otherwise do:
      218         return 1 .
      219       end.
      220     end case .
      221   end.
      222   procedure cur-time-mjd-to-date :
      223      define input  parameter i-mjd-diff as decimal no-undo.
      224      define output parameter o-Date     as date    no-undo.
      225      define output parameter o-Time     as integer no-undo.
      226      define variable v-day-number as integer   no-undo .
      227      if    i-mjd-diff < 0
      228         or i-mjd-diff = ?
      229      then do:
      230         return "?" .
      231      end.
      232      assign
      233         v-day-number = truncate(i-mjd-diff,0).
      234         o-Date = date(v-day-number + 2400002).
      235         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      236     .
      237   end.
      238   function cur-time-mjd-to-string returns character
      239   (input p-mjd-diff as decimal
      240   )
      241   :
      242     define variable v-day-number as integer   no-undo .
      243     define variable v-seconds    as integer   no-undo .
      244     define variable v-hour       as integer   no-undo .
      245     define variable v-min        as integer   no-undo .
      246     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      247     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      248     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      249     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      250     if p-mjd-diff < 0
      251     or p-mjd-diff = ?
      252     then do:
      253       return "?" .
      254     end.
      255     assign
      256       v-day-number = integer(truncate(p-mjd-diff,0))
      257       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      258     .
      259     if v-seconds > 86400
      260     then do:
      261       assign
      262         v-seconds = 86400 - 1
      263       .
      264     end.
      265     if v-seconds < 0
      266     then do:
      267       assign
      268         v-seconds = 0
      269       .
      270     end.
      271     assign
      272       v-hour = truncate(v-seconds / 3600, 0)
      273     .
      274     assign
      275       v-seconds = v-seconds modulo 3600
      276     .
      277     assign
      278       v-min = truncate(v-seconds / 60, 0)
      279     .
      280     assign
      281       v-seconds = v-seconds modulo 60
      282     .
      283     return
      284         (if v-day-number <> 0
      285           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      286           else ""
      287         )
      288       + (if v-day-number <> 0 or v-hour <> 0
      289           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      290           else ""
      291         )
      292       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      293           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      294           else ""
      295         )
      296       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      297       .
      298   end.
      299   function cur-time-string returns character
      300   :
      301     define variable v-date as date      no-undo .
      302     define variable v-time as integer   no-undo .
      303     run cur-time in this-procedure
      304       (output v-date
      305       ,output v-time
      306       ) .
      307     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      308   end.
      309   function cur-time-string-sec returns character
      310   :
      311     define variable v-date as date      no-undo .
      312     define variable v-time as integer   no-undo .
      313     run cur-time in this-procedure
      314       (output v-date
      315       ,output v-time
      316       ) .
      317     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      318   end.
      319   function cur-time-custom  returns character
      320   (input p-prefix as character
      321   ,input p-date-format as character
      322   ,input p-delimiter as character
      323   ,input p-time-format as character
      324   ,input p-suffix as character
      325   )
      326   :
      327     define variable v-date as date      no-undo .
      328     define variable v-time as integer   no-undo .
      329     run cur-time in this-procedure
      330       (output v-date
      331       ,output v-time
      332       ) .
      333     return
      334       p-prefix
      335       + string(v-date, p-date-format)
      336       + p-delimiter
      337       + string(v-time, p-time-format)
      338       + p-suffix
      339       .
      340   end.
      341   function cur-time-print  returns character
      342   :
      343     define variable v-date as date      no-undo .
      344     define variable v-time as integer   no-undo .
      345     run cur-time in this-procedure
      346       (output v-date
      347       ,output v-time
      348       ) .
      349     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      350   end.
      351   function cur-time-datetime returns datetime
      352   :
      353     define variable v-char as character no-undo .
      354     define variable v-datetime as datetime no-undo .
      355     v-char = cur-time-string().
      356     v-datetime = datetime(v-char).
      357     return  v-datetime.
      358   end.
      359   function cur-time-string-msec returns character
      360   :
      361     define variable v-date as datetime  no-undo .
      362     v-date = now.
      363     return string(v-date) .
      364   end.
      365   define stream LogStream .
      366   define variable mNoTime as logical no-undo.
      367   procedure write-to-log-notime :
      368     define input param i-str as character no-undo .
      369     mNoTime = yes.
      370     run write-to-log (i-str).
      371     mNoTime = no.
      372   end.
      373   procedure write-to-log :
      374     define input param p-str as character no-undo .
      375     do
      376     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      377     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      378     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      379     :
      380       define variable log-res        as logical   no-undo .
      381       define variable v-jj           as integer   no-undo .
      382       if    mNoTime
      383          or writelogvalue eq "AsyncProc"
      384       then
      385          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      386       else
      387          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      388       if auto-log-msg-h <> ? then do:
      389         log-res = auto-log-msg-h:move-to-eof( ) .
      390         log-res = auto-log-msg-h:insert-string( p-str ).
      391       end.
      392       if hand-log-msg-h <> ? then do:
      393         log-res = hand-log-msg-h:move-to-eof( ) .
      394         log-res = hand-log-msg-h:insert-string( p-str ).
      395       end.
      396       assign
      397         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      398         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      399         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      400       .
      401       if add-log-file-name <> ? then do:
      402         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      403           run gbl/fileapnd.p
      404             ( input entry(v-jj, add-log-file-name, chr(1) )
      405             ,input p-str
      406             ,input 20
      407             ) no-error .
      408           if error-status:error then do:
      409             return error return-value .
      410           end.
      411         end.
      412       end.
      413       if writelogvalue eq "AsyncProc"
      414       then do:
      415          p-str = trim(p-str, (chr(13) + chr(10)) )
      416       .
      417          Publish "WriteLogAsunc" (p-str,yes).
      418       end.
      419       else if writelogvalue <> "yes" then do:
      420         run gbl/fileapnd.p
      421           ( input log-file-name
      422           ,input p-str
      423           ,input 20
      424           ) no-error .
      425         if error-status:error then do:
      426           return error return-value .
      427         end.
      428       end.
      429     end.
      430   end procedure.
      431   procedure write-to-screen :
      432     define input param p-str as character no-undo .
      433     do
      434     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      435     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      436     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      437     :
      438       define variable log-res as logical no-undo.
      439       assign
      440         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      441       .
      442       if auto-log-msg-h <> ?
      443       then do:
      444         log-res = auto-log-msg-h:move-to-eof( ) .
      445         log-res = auto-log-msg-h:insert-string( p-str ).
      446       end.
      447       if hand-log-msg-h <> ?
      448       then do:
      449         log-res = hand-log-msg-h:move-to-eof( ) .
      450         log-res = hand-log-msg-h:insert-string( p-str ).
      451       end.
      452     end.
      453   end procedure.
      454   procedure send-msg-to-email :
      455     define input  parameter p-subject      as character no-undo .
      456     define input  parameter p-text-err     as character no-undo .
      457     define input  parameter p-attach-files as character no-undo .
      458     do
      459     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      460     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      461     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      462     :
      463       define variable v-tth             as handle    no-undo .
      464       define variable v-value-character as character no-undo .
      465       define variable v-value-date      as date      no-undo .
      466       define variable v-value-decimal   as decimal   no-undo .
      467       define variable v-value-integer   as integer   no-undo .
      468       define variable v-value-logical   as logical   no-undo .
      469       define variable v-param-type      as character no-undo .
      470       define variable v-email       as character no-undo .
      471       define variable v-tmp-str     as character no-undo .
      472       define variable v-tmp1-str    as character no-undo .
      473       define variable v-ind         as integer   no-undo .
      474       define variable v-num-entries as integer   no-undo .
      475       delete object v-tth no-error.
      476       run adm/shattri.p
      477         ( input "get":U
      478          ,input  "":U
      479          ,input  0
      480          ,input  'auto-task':U
      481          ,input  'send-msg-to-email':U
      482          ,output v-value-character
      483          ,output v-value-date
      484          ,output v-value-decimal
      485          ,output v-value-integer
      486          ,output v-value-logical
      487          ,output v-param-type
      488          ,input-output table-handle v-tth
      489         ) no-error .
      490       if not error-status :error  then do:
      491         assign
      492           v-tmp-str = v-value-character
      493         .
      494       end.
      495       delete object v-tth no-error.
      496       assign
      497         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      498         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      499         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      500         v-num-entries = num-entries( v-tmp-str, chr(44) )
      501         v-email       = "":U
      502       .
      503       do v-ind = 1 to v-num-entries
      504       :
      505         assign
      506           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      507         .
      508         if trim( v-tmp1-str ) <> "":U then do:
      509           if v-email = "":U then do:
      510             assign
      511               v-email = v-tmp1-str
      512             .
      513           end.
      514           else do:
      515             assign
      516               v-email = v-email + chr(44) + v-tmp1-str
      517             .
      518           end.
      519         end.
      520       end.
      521       if v-email <> "":U then do:
      522         run gbl/sendmail.p
      523           ( input v-email
      524           , input p-subject
      525           , input p-text-err
      526           , input p-attach-files
      527           ) no-error .
      528         if error-status :error
      529           or return-value <> "":U
      530         then do:
      531           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      532         end.
      533       end.
      534     end.
      535   end procedure.
      536   define variable mAllTypeSuport as character no-undo.
      537   mAllTypeSuport = 'autonws':U + "," + 'is_diadoc':U + "," + 'mercury':U + "," + 'is_motp':U
      538                  + "," + 'autoarh':U + "," + 'hddtest':U + "," + 'autoexp':U.
      539   define variable mLableText as character no-undo.
      540   define variable mStartTime as datetime-tz no-undo init ?.
      541   procedure addtask:
      542      define input  parameter ITask as character no-undo.
      543      define input  parameter iProc as character no-undo.
      544      define input  parameter iParam as character no-undo.
      545      subscribe "PutFileLogAsunc" anywhere run-procedure "WriteLogAsync".
      546      if mStartTime ne ?
      547      then
      548         mAsyncHelper:AddTask (ITask,iProc,iParam,mStartTime).
      549      else
      550         mAsyncHelper:AddTask (ITask,iProc,iParam).
      551      unsubscribe "PutFileLogAsunc".
      552   end.
      553   procedure addTaskTime:
      554      define input  parameter ITask      as character no-undo.
      555      define input  parameter iProc      as character no-undo.
      556      define input  parameter iParam     as character no-undo.
      557      define input  parameter iStartTime as datetime-tz no-undo.
      558      subscribe "PutFileLogAsunc" anywhere run-procedure "WriteLogAsync".
      559      mAsyncHelper:AddTask (ITask,iProc,iParam,iStartTime).
      560      unsubscribe "PutFileLogAsunc".
      561   end.
      562   procedure waitproc:
      563      define input  parameter itext  as character no-undo.
      564      subscribe "PutFileLogAsunc" anywhere run-procedure "WriteLogAsync".
      565      run ibs\th\file\waithelper.p (mAsyncHelper,?,1,itext + " " + mLableText).
      566      unsubscribe "PutFileLogAsunc".
      567   end.
      568   procedure waitProcLable:
      569      define input  parameter itext  as character no-undo.
      570      mLableText = itext.
      571   end.
      572   procedure waitProcShed:
      573      define input  parameter iSched as character no-undo.
      574      define input  parameter itext  as character no-undo.
      575      subscribe "PutFileLogAsunc" anywhere run-procedure "WriteLogAsync".
      576      run ibs\th\file\waithelper.p (mAsyncHelper,iSched,1,itext).
      577      unsubscribe "PutFileLogAsunc".
      578   end.
      579   procedure WriteLogAsync:
      580      define input  parameter iFile as character no-undo.
      581      define variable vText as character no-undo.
      582      define variable vFile as longchar  no-undo.
      583      define variable vfileName as character no-undo.
      584      define variable vi as int64 no-undo.
      585      define variable vStr  as character no-undo.
      586      vfileName = mAsyncHelper:objExists(iFile,"f").
      587      if vfileName ne ?
      588      then do:
      589         copy-lob from file vfileName to vFile no-error.
      590         if error-status:error
      591         then do:
      592            run write-to-log (substitute ("Не удалось прочесть файл &1",iFile)).
      593         end.
      594         else do:
      595             vFile = replace (vFile,chr(13) + chr(10),chr(10)).
      596             do vi = 1 to num-entries(vFile,chr(10)) - 1:
      597               run write-to-log-notime (entry(vi, vFile,chr(10))).
      598            end.
      599         end.
      600      end.
      601      else do:
      602          assign
      603              vtext = substitute ("Процедура обработки данных не завершена. &1",ifile).
      604          run write-to-log (vtext).
      605      end.
      606   end.
      607   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      608   define variable v-loc-counter as integer no-undo .
      609   define variable v-counter-visible as logical no-undo .
      610   define variable v-view-log as logical no-undo .
      611   define stream auto2dia.
      612   PROCEDURE write-log-and-file :
      613   do
      614   on error undo, return error
      615   :
      616     define input parameter p-tab-position   as integer   no-undo.
      617     define input parameter p-file-name      as character no-undo .
      618     define input parameter p-log-level      as integer   no-undo .
      619     define input parameter p-log-string     AS CHARacter NO-UNDO.
      620     define variable v-jj as integer   no-undo .
      621     run write-to-screen in this-procedure( input ( fill( chr(32), p-tab-position) + p-log-string)) .
      622     if p-file-name <> '':U then do:
      623       do v-jj = 1 to num-entries(p-file-name, chr(1)):
      624         run  auto2dia-writefile in this-procedure (
      625                                         input entry(v-jj, p-file-name, chr(1))
      626                                         ,input p-log-level
      627                                         ,input (p-log-string + chr(10))
      628                                       ) no-error .
      629       end.
      630     end.
      631     if writelogvalue eq "AsyncProc"
      632     then
      633        run write-to-log in this-procedure( p-log-string) .
      634   end.
      635   END PROCEDURE.
      636   PROCEDURE get-title :
      637   do
      638   on error undo, return error
      639   :
      640   define output parameter p-title     as character    no-undo.
      641   end.
      642   END PROCEDURE.
      643   PROCEDURE set-title :
      644   do
      645   on error undo, return error
      646   :
      647   define input parameter p-title     as character    no-undo.
      648   run write-to-log in this-procedure( input ( fill( chr(32), 15) + p-title)) .
      649   end.
      650   END PROCEDURE.
      651   PROCEDURE get-counter-value :
      652   do
      653   on error undo, return error
      654   :
      655   define output parameter p-counter     as integer    no-undo.
      656       assign
      657       p-counter  = v-loc-counter
      658       .
      659   end.
      660   END PROCEDURE.
      661   PROCEDURE set-counter-value :
      662   do
      663   on error undo, return error
      664   :
      665   define input parameter p-counter     as integer    no-undo.
      666       assign
      667       v-loc-counter = p-counter
      668       .
      669   end.
      670   END PROCEDURE.
      671   PROCEDURE show-counter :
      672   do
      673   on error undo, return error
      674   :
      675       assign
      676       v-counter-visible = true
      677       .
      678       process events.
      679   end.
      680   END PROCEDURE.
      681   PROCEDURE hide-counter :
      682   do
      683   on error undo, return error
      684   :
      685       assign
      686       v-counter-visible = false
      687       .
      688       run hide-message in (this-procedure:handle) .
      689       process events.
      690   end.
      691   END PROCEDURE.
      692   PROCEDURE write-counter :
      693   do
      694   on error undo, return error
      695   :
      696   define input parameter p-counter-string     as character    no-undo.
      697   if v-counter-visible then
      698   run write-message in (this-procedure:handle) ( input p-counter-string) .
      699   process events.
      700   end.
      701   END PROCEDURE.
      702   PROCEDURE get-stop-state :
      703   do
      704   on error undo, return error
      705   :
      706   define output parameter p-stop-state    as logical      no-undo.
      707   end.
      708   END PROCEDURE.
      709   PROCEDURE set-view-log :
      710   do
      711   on error undo, return error
      712   :
      713   define input parameter p-view-log     as logical    no-undo.
      714       assign
      715       v-view-log = p-view-log
      716       .
      717   end.
      718   END PROCEDURE.
      719   PROCEDURE get-view-log :
      720   do
      721   on error undo, return error
      722   :
      723   define output parameter p-view-log     as logical    no-undo.
      724       assign
      725       p-view-log = v-view-log
      726       .
      727   end.
      728   END PROCEDURE.
      729   PROCEDURE write-log :
      730   do
      731   on error undo, return error
      732   :
      733   define input parameter p-tab-position   as integer      no-undo.
      734   define input parameter p-log-string     as character    no-undo.
      735   run write-to-log in this-procedure( input ( fill( chr(32), 2  * p-tab-position)  +
      736                                       (IF p-log-string = "&Line" THEN FILL("-", 80)
      737                                       ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
      738                                       ELSE p-log-string))).
      739   end.
      740   END PROCEDURE.
      741   procedure writelog :
      742   do
      743   on error undo, return error
      744   :
      745   define input parameter p-file-name AS CHAR     NO-UNDO.
      746   define input parameter p-log-level AS INTEGER  NO-UNDO.
      747   define input parameter p-log-string  AS CHAR     NO-UNDO.
      748     if p-file-name <> "" then
      749     run  auto2dia-Writefile in this-procedure (
      750                                       input p-file-name
      751                                     ,input p-log-level
      752                                     ,input p-log-string
      753                                   ) no-error .
      754      process events.
      755   end.
      756   end procedure.
      757   PROCEDURE auto2dia-writefile:
      758     define input parameter sFileName AS CHAR     NO-UNDO.
      759     define input parameter iLogLevel AS INTEGER  NO-UNDO.
      760     define input parameter sToWrite  AS CHAR     NO-UNDO.
      761     define variable v-SlashPos  as integer no-undo .
      762     define variable v-lDirName  as character no-undo .
      763     define variable v-lDirName2 as character no-undo .
      764     v-SlashPos  = maximum (  r-index(sFileName, "\"),  r-index(sFileName, "/")  ) .
      765     v-lDirName  = if v-SlashPos > 0 then substring (sFileName, 1, v-SlashPos - 1) else "".
      766     FILE-INFO:FILE-NAME = v-lDirName .
      767     v-lDirName2 = FILE-INFO:FULL-PATHNAME .
      768     if v-lDirName2 <> ? then do :
      769   OUTPUT STREAM auto2dia TO VALUE(sFileName) APPEND.
      770       PUT STREAM auto2dia UNFORMATTED chr(10).
      771       PUT STREAM auto2dia UNFORMATTED (IF (iLogLevel = 0 OR sToWrite = "&DLine"
      772                                         OR sToWrite = "&Line") THEN "" ELSE
      773                                         cur-time-string-sec() + " ").
      774       PUT STREAM auto2dia UNFORMATTED
      775               (IF sToWrite = "&Line" THEN FILL("-", 80)
      776                ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
      777                ELSE sToWrite).
      778   OUTPUT STREAM auto2dia CLOSE.
      779     end .
      780   END PROCEDURE.
      781   define variable v-list-key            as character no-undo .
      782   define variable v-for-extsys          as character no-undo .
      783   define variable mForExtsys as character no-undo.
      784   define variable mHiddenMode as logical no-undo.
      785   define variable mForDb as longchar no-undo.
      786   define variable mForProc as character no-undo.
      787   define variable mSessionBegin as logical no-undo init yes.
      788   define variable mListDb       as character no-undo.
      789   define variable mListDbAll    as character no-undo.
      790   define variable mListKey      as character no-undo.
      791   define variable mListKeyAll   as character no-undo.
      792   define temp-table tt-db no-undo
      793      field db-num as integer
      794      index pi is unique primary
      795       db-num ascending
      796   .
      797   define temp-table tt-extsys no-undo
      798      field extsys_id as integer
      799      index pi is unique primary
      800         extsys_id ascending
      801   .
      802   define temp-table tt-BatchProcess
      803    field BP_Type as char
      804    field CharKey_One as char
      805    field CharKey_Two as char
      806    field CharKey_Three as char
      807    field BP_ExecSysDate as date
      808    field BP_ExecSysTimeInt as int
      809    index dt BP_ExecSysDate BP_ExecSysTimeInt.
      810   function objExists return character
      811   (input  ifolder as character,
      812    input  iType   as character  ):
      813       define variable vFileType as character no-undo init "D,F".
      814       define variable vi        as integer no-undo.
      815       define variable vtype as character no-undo.
      816       if iType ne ?
      817       then
      818          vFileType = iType.
      819       do vi = 1 to num-entries(vFileType):
      820          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
      821          vtype = file-information:file-type.
      822          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
      823             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
      824             index(vtype , entry(vi,vFileType )) > 0
      825          then return file-information:full-pathname .
      826          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
      827          vtype = file-information:file-type.
      828          if file-information:file-name <> "" and
      829             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
      830             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
      831             index( vtype, entry(vi,vFileType )) > 0
      832          then return file-information:full-pathname .
      833       end.
      834       return ? .
      835   end.
      836   function SearchFile return character
      837   (input  ifile as character):
      838      return objExists(ifile,?).
      839   end.
      840   function SearchPFile return character
      841   (input inFile as char):
      842        define variable oFile       as character no-undo.
      843        define variable vFileSearch as character no-undo.
      844        define variable vNumEntry   as integer no-undo.
      845        if inFile = "" then return ?.
      846        vNumEntry = num-entries(inFile,".").
      847        vFileSearch = inFile.
      848        if    vNumEntry > 0
      849           and (   entry(vNumEntry,inFile,".") eq "p"
      850                or entry(vNumEntry,inFile,".") eq "w")
      851        then do:
      852           entry(vNumEntry,vFileSearch, ".") = "r".
      853           oFile = search(vFileSearch ).
      854           if oFile eq ?
      855           then
      856              oFile = search(inFile).
      857        end.
      858        else
      859           oFile = search(vFileSearch).
      860        return oFile.
      861     end.
      862   procedure initProcMode:
      863      define input  parameter iAutoTypeList as character no-undo.
      864      define input  parameter iMode as character no-undo.
      865      define variable v-ind as integer no-undo.
      866      if lookup( "H":U, iMode, "+":U ) = 0
      867      then do:
      868         mHiddenMode = false.
      869         run myenable in this-procedure
      870            ( input iAutoTypeList
      871            ) .
      872      end.
      873      else do:
      874         mHiddenMode = true.
      875      end.
      876      assign
      877         mForDb      = "":U
      878         mForExtsys  = "":U
      879      .
      880      block_db-list:
      881      do v-ind = 1 to num-entries( iMode, "+":U )
      882      :
      883         if entry( 1, entry( v-ind, imode, "+":U), ":":U ) = "DB":U
      884         then do:
      885            mForDb = entry( 2, entry( v-ind, imode, "+":U), ":":U ).
      886            for each tt-db
      887            :
      888              delete tt-db .
      889            end.
      890            run gbl/prcs-lst.p
      891               ( input mForDb
      892               , input 0
      893               , input 99999
      894               , input false
      895               , input (buffer tt-db:handle)
      896               , input "db-num":U
      897               ) no-error .
      898            mForDb = "".
      899            for each tt-db
      900            :
      901               mForDb = mForDb + ",":U + string( tt-db.db-num ).
      902               delete tt-db .
      903            end.
      904            mForDb = substring( mForDb, 2 ).
      905            leave block_db-list .
      906         end.
      907         if entry( 1, entry( v-ind, iMode, "+":U), ":":U ) = "ExtSys":U
      908         then do:
      909            mForExtsys = entry( 2, entry( v-ind, iMode, "+":U), ":":U ).
      910            for each tt-extsys
      911            :
      912               delete tt-extsys .
      913            end.
      914            run gbl/prcs-lst.p
      915               ( input mForExtsys
      916               , input 0
      917               , input 99999
      918               , input false
      919               , input (buffer tt-extsys:handle)
      920               , input "extsys_id":U
      921               ) no-error .
      922            mForExtsys = "".
      923            for each tt-extsys
      924            :
      925               mForExtsys = mForExtsys + ";":U + string( tt-extsys.extsys_id ).
      926               delete tt-extsys .
      927            end.
      928            mForExtsys = substring( mForExtsys, 2 ).
      929            leave block_db-list .
      930         end.
      931         if entry( 1, entry( v-ind, iMode, "+":U), ":":U ) = "ProcName":U
      932         then do:
      933            mForProc = entry( 2, entry( v-ind, iMode, "+":U), ":":U ).
      934            leave block_db-list .
      935         end.
      936      end.
      937   end.
      938   define variable mAsyncProcRun as logical no-undo.
      939   procedure startproc:
      940      define input  parameter iAutoType as character no-undo.
      941      define input  parameter iListDb as character no-undo.
      942      define input  parameter iListKey as character no-undo.
      943      define input  parameter iStart as datetime-tz no-undo.
      944      mStartTime = iStart.
      945    define variable v-db-num as integer no-undo.
      946    define variable v-ind as integer no-undo.
      947    define variable v-num-entries-db-list as integer no-undo.
      948    v-num-entries-db-list = num-entries(iListDb, chr(44))
      949               .
      950      case iAutoType :
      951         when 'autonws':U
      952         then do:
      953            define variable mreadini as character no-undo.
      954            define variable msesnws as integer no-undo.
      955            get-key-value section "THAutoSessions" key "NumAsyncSessionsNWS" value mreadini.
      956            assign
      957               msesnws = 1
      958               msesnws = integer (mreadini)
      959            no-error.
      960            if    mAsyncProcRun
      961               or msesnws > 1
      962            then do:
      963               mAsyncHelper:maxproc = msesnws.
      964               run bge/auto-nws.p
      965                  (input iAutoType
      966                  ,input this-procedure
      967                  ,input iListDb
      968               ) no-error.
      969            end.
      970            else do:
      971               run nws/exch-nws.p
      972                     (input this-procedure
      973                     ,input g#auto-user-id
      974                     ,input g#auto-user-password
      975                     ,input iListDb
      976                     ) no-error.
      977            end.
      978             if error-status :error
      979               then do:
      980                  run write-to-log in this-procedure
      981                     (input vss-workfile + chr(32)
      982                       + "Ошибка при запуске новостей" + chr(10)
      983                       + error-status :get-message(error-status :num-messages) + chr(10)
      984                       + return-value
      985                  ) .
      986               end.
      987         end.
      988         when 'mercury':U
      989         then do:
      990            run bge/auto-merc-asunc.p
      991               (input iAutoType
      992               ,input this-procedure
      993               ,input iListDb
      994            ) no-error.
      995         end.
      996         when 'is_motp':U
      997         then do:
      998            if mAsyncProcRun
      999            then
     1000               run addtask (iAutoType,"utl\proc-anyproc.p",substitute ("&2&1&3&1&4&1&5&1&6",
     1001                                                   chr(4),
     1002                                                   "bge/auto-motp.p",
     1003                                                   g#auto-user-id,
     1004                                                   g#auto-user-password,
     1005                                                   iListDb,
     1006                                                   no)).
     1007            else
     1008               run bge/auto-motp.p
     1009                  (input g#auto-user-id
     1010                  ,input g#auto-user-password
     1011                  ,input iListDb
     1012                  ,input no
     1013               ) no-error.
     1014         end.
     1015         when 'is_diadoc':U
     1016         then do:
     1017            run bge/auto-diadoc.p
     1018               (input iAutoType
     1019               ,input this-procedure
     1020               , input iListDb
     1021               ) no-error.
     1022         end.
     1023         when 'hddtest':U
     1024         then do:
     1025            define variable Vdbinfo as char no-undo.
     1026            run adm/db-info.p ( output v-db-num, output Vdbinfo ) no-error.
     1027            if mAsyncProcRun
     1028            then
     1029               run addtask (iAutoType,"utl\proc-anyproc.p",substitute ("&2&1&3&1&4&1&5",
     1030                                                   chr(4),
     1031                                                   "bge/auto-hddtest.p",
     1032                                                   g#auto-user-id,
     1033                                                   g#auto-user-password,
     1034                                                   v-db-num)).
     1035            else
     1036               run bge/auto-hddtest.p
     1037                  (input g#auto-user-id
     1038                  ,input g#auto-user-password
     1039                  ,input v-db-num
     1040               ) no-error.
     1041         end.
     1042         when 'autoarh':U
     1043         then do:
     1044            do v-ind = 1 to v-num-entries-db-list
     1045            :
     1046               define variable v-rec-key as character no-undo.
     1047               define variable v-cre-db-num as integer no-undo.
     1048               define variable v-task-type as character no-undo.
     1049               define variable v-task-num as integer no-undo.
     1050               assign
     1051                  v-db-num     = integer( entry( v-ind, iListDb, chr(44) ) )
     1052                  v-rec-key    =          entry( v-ind, iListKey, chr(1) )
     1053                  v-cre-db-num = integer( entry( 1, v-rec-key, chr(3) ) )
     1054                  v-task-type  =          entry( 2, v-rec-key, chr(3) )
     1055                  v-task-num   = integer( entry( 3, v-rec-key, chr(3) ) )
     1056               .
     1057                if mAsyncProcRun
     1058                then
     1059                   run addtask (iAutoType,"utl\proc-anyproc.p",substitute ("&2&1&3&1&4&1&5&1&6",
     1060                                                      chr(4),
     1061                                                      "adm/calc-arc.p",
     1062                                                      v-db-num,
     1063                                                      v-cre-db-num,
     1064                                                      v-task-type,
     1065                                                      v-task-num)).
     1066                else do:
     1067                  run adm/calc-arc.p
     1068                     (input v-db-num
     1069                     ,input v-cre-db-num
     1070                     ,input v-task-type
     1071                     ,input v-task-num
     1072                  ) no-error.
     1073                  if error-status :error
     1074                  then do:
     1075                  run write-to-log in this-procedure
     1076                     (input vss-workfile + chr(32)
     1077                          + "Ошибка при расчете архива" + chr(10)
     1078                          + error-status :get-message(error-status :num-messages) + chr(10)
     1079                          + return-value
     1080                     ) .
     1081                  end.
     1082               end.
     1083            end.
     1084         end.
     1085         when 'autoexp':U
     1086         then do:
     1087            do v-ind = 1 to v-num-entries-db-list :
     1088               assign
     1089                  v-db-num     = integer( entry( v-ind, iListDb, chr(44) ) )
     1090                  v-rec-key    =          entry( v-ind, iListKey, chr(1) )
     1091                  v-cre-db-num = integer( entry( 1, v-rec-key, chr(3) ) )
     1092                  v-task-type  =          entry( 2, v-rec-key, chr(3) )
     1093                  v-task-num   = integer( entry( 3, v-rec-key, chr(3) ) )
     1094               .
     1095               if mAsyncProcRun
     1096                then
     1097                   run addtask (iAutoType,"utl\proc-anyproc.p",substitute ("&2&1&3&1&4&1&5&1&6",
     1098                                                      chr(4),
     1099                                                      "bge/bge-shd.p",
     1100                                                      v-cre-db-num,
     1101                                                      v-task-type,
     1102                                                      v-task-num,
     1103                                                      v-db-num)).
     1104                else do:
     1105                  run bge/bge-shd.p
     1106                     (input v-cre-db-num
     1107                     ,input v-task-type
     1108                     ,input v-task-num
     1109                     ,input v-db-num
     1110                  ) no-error.
     1111               end.
     1112            end.
     1113         end.
     1114         when 'autooxml':U
     1115         then do:
     1116            do v-ind = 1 to v-num-entries-db-list :
     1117               assign
     1118                  v-db-num     = integer( entry( v-ind, iListDb, chr(44) ) )
     1119                  v-rec-key    =          entry( v-ind, iListKey, chr(1) )
     1120                  v-cre-db-num = integer( entry( 1, v-rec-key, chr(3) ) )
     1121                  v-task-type  =          entry( 2, v-rec-key, chr(3) )
     1122                  v-task-num   = integer( entry( 3, v-rec-key, chr(3) ) )
     1123               .
     1124               run bge/oxmlshd.p
     1125               (input this-procedure:handle
     1126               ,input v-cre-db-num
     1127               ,input v-task-type
     1128               ,input v-task-num
     1129               ,input v-db-num
     1130               ,input mForExtsys
     1131               ) no-error.
     1132            end.
     1133         end.
     1134         when 'autogcd':U
     1135         then do:
     1136            do v-ind = 1 to v-num-entries-db-list :
     1137               assign
     1138                  v-db-num     = integer( entry( v-ind, iListDb, chr(44) ) )
     1139                  v-rec-key    =          entry( v-ind, iListKey, chr(1) )
     1140                  v-cre-db-num = integer( entry( 1, v-rec-key, chr(3) ) )
     1141                  v-task-type  =          entry( 2, v-rec-key, chr(3) )
     1142                  v-task-num   = integer( entry( 3, v-rec-key, chr(3) ) )
     1143               .
     1144               run str/gcd-shd.p
     1145                  (input this-procedure:handle
     1146                  ,input v-cre-db-num
     1147                  ,input v-task-type
     1148                  ,input v-task-num
     1149                  ,input v-db-num
     1150                  ) no-error.
     1151            end.
     1152         end.
     1153         when 'autosuz':U
     1154         then do:
     1155            do v-ind = 1 to v-num-entries-db-list
     1156            :
     1157               assign
     1158                  v-db-num     = integer( entry( v-ind, iListDb, chr(44) ) )
     1159                  v-rec-key    =          entry( v-ind, iListKey, chr(1) )
     1160                  v-cre-db-num = integer( entry( 1, v-rec-key, chr(3) ) )
     1161                  v-task-type  =          entry( 2, v-rec-key, chr(3) )
     1162                  v-task-num   = integer( entry( 3, v-rec-key, chr(3) ) )
     1163               .
     1164               run str/suz-shd.p
     1165                  (
     1166                  input this-procedure:handle
     1167                  ,input v-cre-db-num
     1168                  ,input v-task-type
     1169                  ,input v-task-num
     1170                  ,input v-db-num
     1171               ) no-error.
     1172               if error-status :error
     1173               then do:
     1174                  run write-to-log in this-procedure
     1175                     (input vss-workfile + chr(32)
     1176                       + "Ошибка при запуске отчета" + chr(10)
     1177                       + error-status :get-message(error-status :num-messages) + chr(10)
     1178                       + return-value
     1179                  ) .
     1180               end.
     1181            end.
     1182         end.
     1183         when 'autosale':U
     1184         then do:
     1185            do v-ind = 1 to v-num-entries-db-list :
     1186               assign
     1187                  v-db-num     = integer( entry( v-ind, iListDb, chr(44) ) )
     1188                  v-rec-key    =          entry( v-ind, iListKey, chr(1) )
     1189                  v-cre-db-num = integer( entry( 1, v-rec-key, chr(3) ) )
     1190                  v-task-type  =          entry( 2, v-rec-key, chr(3) )
     1191                  v-task-num   = integer( entry( 3, v-rec-key, chr(3) ) )
     1192               .
     1193               run str/sal-shd.p
     1194                  (input this-procedure:handle
     1195                  ,input v-cre-db-num
     1196                  ,input v-task-type
     1197                  ,input v-task-num
     1198                  ,input v-db-num
     1199                  ) no-error.
     1200            end.
     1201         end.
     1202         when 'autocbnk':U
     1203         then do:
     1204            do v-ind = 1 to v-num-entries-db-list :
     1205               assign
     1206                  v-db-num     = integer( entry( v-ind, iListDb, chr(44) ) )
     1207                  v-rec-key    =          entry( v-ind, iListKey, chr(1) )
     1208                  v-cre-db-num = integer( entry( 1, v-rec-key, chr(3) ) )
     1209                  v-task-type  =          entry( 2, v-rec-key, chr(3) )
     1210                  v-task-num   = integer( entry( 3, v-rec-key, chr(3) ) )
     1211               .
     1212               run bge/clb-shd.p
     1213                  (input this-procedure:handle
     1214                  ,input v-cre-db-num
     1215                  ,input v-task-type
     1216                  ,input v-task-num
     1217                  ,input v-db-num
     1218               ) no-error.
     1219            end.
     1220         end.
     1221         when 'autofree':U
     1222         then do:
     1223            do v-ind = 1 to v-num-entries-db-list :
     1224               assign
     1225                  v-db-num     = integer( entry( v-ind, iListDb, chr(44) ) )
     1226                  v-rec-key    =          entry( v-ind, iListKey, chr(1) )
     1227                  v-cre-db-num = integer( entry( 1, v-rec-key, chr(3) ) )
     1228                  v-task-type  =          entry( 2, v-rec-key, chr(3) )
     1229                  v-task-num   = integer( entry( 3, v-rec-key, chr(3) ) )
     1230               .
     1231               run adm/freeshdr.p
     1232                  (input this-procedure:handle
     1233                  ,input v-cre-db-num
     1234                  ,input v-task-type
     1235                  ,input v-task-num
     1236                  ,input v-db-num
     1237               ) no-error.
     1238            end.
     1239         end.
     1240         when 'is_PM':U
     1241         then do:
     1242            do v-ind = 1 to v-num-entries-db-list :
     1243               assign
     1244                  v-db-num     = integer( entry( v-ind, iListDb, chr(44) ) )
     1245                  v-rec-key    =          entry( v-ind, iListKey, chr(1) )
     1246                  v-cre-db-num = integer( entry( 1, v-rec-key, chr(3) ) )
     1247                  v-task-type  =          entry( 2, v-rec-key, chr(3) )
     1248                  v-task-num   = integer( entry( 3, v-rec-key, chr(3) ) )
     1249               .
     1250               run bge/auto-exp-is_PM.p
     1251                          (input this-procedure:handle
     1252                           ,input v-db-num
     1253                           ,input v-cre-db-num
     1254                           ,input v-task-type
     1255                           ,input v-task-num
     1256                           ) no-error.
     1257            end.
     1258         end.
     1259      end case.
     1260   end.
     1261   define variable volddate as date no-undo init ?.
     1262   define stream sOutCash.
     1263   define variable mFileCashParLog as character no-undo.
     1264   procedure AddCashParam:
     1265      define input  parameter p-auto-type-list as character no-undo.
     1266      define input  parameter iToday as date no-undo.
     1267      define input  parameter iTime as integer no-undo.
     1268      if mFileCashParLog eq ""
     1269      then do:
     1270         mFileCashParLog = searchfile("cashparam.log").
     1271         if mFileCashParLog eq ?
     1272         then do:
     1273            output stream sOutCash to "cashparam.log" append.
     1274            output stream sOutCash close.
     1275            mFileCashParLog = searchfile("cashparam.log").
     1276            if mFileCashParLog eq ?
     1277            then
     1278               mFileCashParLog = "".
     1279         end.
     1280      end.
     1281      if (    lookup ('autooxml':U  ,p-auto-type-list) > 0
     1282         )
     1283         and voldDate ne iToday
     1284      then do:
     1285         mAsyncHelper:setTimeOutTask("cashParam",600).
     1286         voldDate = iToday.
     1287         if iTime < 7200
     1288         then
     1289            run addTaskTime in this-procedure ("cashParam","utl/proc-send-all.p" , mFileCashParLog, datetime-tz (month (iToday),day (iToday), year (iToday),2,0 )).
     1290         if iTime < 50400
     1291         then
     1292            run addTaskTime in this-procedure("cashParam","utl/proc-send-all.p" , mFileCashParLog, datetime-tz (month (iToday),day (iToday), year (iToday),14,0 )).
     1293      end.
     1294   end.
     1295   procedure AddUtil:
     1296      define input  parameter p-auto-type-list as character no-undo.
     1297      define variable vRun as logical no-undo.
     1298      if mFileCashParLog eq ""
     1299      then do:
     1300         mFileCashParLog = searchfile("utils.log").
     1301         if mFileCashParLog eq ?
     1302         then do:
     1303            output stream sOutCash to "utils.log" append.
     1304            output stream sOutCash close.
     1305            mFileCashParLog = searchfile("utils.log").
     1306            if mFileCashParLog eq ?
     1307            then
     1308               mFileCashParLog = "".
     1309         end.
     1310      end.
     1311      if (    lookup ('autooxml':U  ,p-auto-type-list) > 0
     1312         )
     1313      then do:
     1314         mAsyncHelper:setTimeOutTask("Utils",600).
     1315         run utl/chknds22.p (output vRun).
     1316         if vRun then
     1317         do:
     1318           run addTaskTime in this-procedure("Смена кода ставки НДС с 1 на 11.","utl/run_nds22.p" , mFileCashParLog, datetime-tz (1,1,2026,0,0 )).
     1319         end.
     1320      end.
     1321   end.
     1322   define variable mPrintNextMes as logical no-undo init yes.
     1323   procedure checkConect:
     1324      define input  parameter iTitle  as character no-undo.
     1325      define input  parameter iAutoType as character no-undo.
     1326      define output parameter oDbNum  as integer   no-undo.
     1327      define output parameter oDBInfo as character no-undo.
     1328      define variable v-log as logical no-undo.
     1329      run adm/chk-db.p no-error .
     1330      if error-status :error then do:
     1331         run write-to-log (  substitute( "&1. Проверка возможности работы сессии.&2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message(1) ) ).
     1332         run gbl/dbdiscon.p no-error.
     1333         if error-status :error then do:
     1334            run write-to-log (  substitute( "&1. Не удалось отсоединиться от БД&2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message(1) ) ).
     1335         end.
     1336         return error.
     1337      end.
     1338      if v-socket = false
     1339      then do:
     1340         if iAutoType = 'autonws':U
     1341         then do:
     1342            message
     1343               vss-workfile vss-revision vss-description skip
     1344               substitute( 'В параметрах соединения с БД отсутствуют параметры "-S" и "-1".' ) skip
     1345               substitute( 'Работа СПН возможна только в ручном режиме.' ) skip
     1346               substitute( 'Продолжить работу в ручном режиме?' ) skip
     1347               view-as alert-box question buttons yes-no update v-log
     1348            .
     1349            if v-log = true
     1350            then do:
     1351               run gbl/dbdiscon.p no-error.
     1352               if error-status :error then do:
     1353                  run write-to-log (  substitute( "&1. Не удалось отсоединиться от БД&2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message(1) ) ).
     1354               end.
     1355               return error "HandMode".
     1356            end.
     1357         end.
     1358         else do:
     1359            message
     1360               vss-workfile vss-revision vss-description skip
     1361               substitute( 'В параметрах соединения с БД отсутствуют параметры "-S" и "-1".' ) skip
     1362               substitute( '&1 работать не может.', ititle ) skip
     1363               view-as alert-box error
     1364            .
     1365         end.
     1366         return error.
     1367      end.
     1368      run adm/db-info.p ( output oDbNum, output oDBInfo ) no-error.
     1369      if error-status :error
     1370      then do:
     1371         if mPrintNextMes = true then do:
     1372            run write-to-log( vss-workfile + chr(32)
     1373                            + "Ошибка при считывании информации о текущей БД." + chr(10)
     1374                            + error-status :get-message(error-status :num-messages) + chr(10)
     1375                            + return-value
     1376                            ) .
     1377            mPrintNextMes = false.
     1378         end.
     1379         return error "WaitOK".
     1380      end.
     1381      else do:
     1382         mPrintNextMes = true.
     1383      end.
     1384   end procedure.
     1385   procedure initAsyncProc:
     1386      define input  parameter iTitle as character no-undo.
     1387      define input  parameter iAutoTypeList as character no-undo.
     1388      define input  parameter iWorkType     as character no-undo.
     1389      define input  parameter iNextPeriod as logical no-undo.
     1390      define output parameter oDbInfo as character no-undo.
     1391      define variable vi as integer no-undo.
     1392      define variable vAutoType as character  no-undo.
     1393      define variable vError as logical no-undo.
     1394      define variable vConect as logical no-undo.
     1395      define variable vDbNum as integer no-undo.
     1396      do vi = 1 to num-entries (iAutoTypeList):
     1397         vAutoType = entry(vi,iAutoTypeList).
     1398         if lookup(vAutoType, iWorkType) eq 0
     1399         then do:
     1400            if not vConect
     1401            then do:
     1402               run adm/autoconn.p no-error.
     1403               if error-status :error
     1404               then do:
     1405                  run write-to-log ( substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1) ) ).
     1406               end.
     1407               else do:
     1408                  vConect = yes.
     1409                  run checkConect (input  iTitle,
     1410                                input  i-auto-type,
     1411                                output vDbNum,
     1412                                output oDbInfo) no-error.
     1413                  if error-status:error
     1414                  then do:
     1415                     return error return-value.
     1416                  end.
     1417               end.
     1418            end.
     1419            if iNextPeriod
     1420            then do:
     1421               run adm/chk-sch.p
     1422               ( input  vAutoType
     1423               , input  mForDb
     1424               , output mListDb
     1425               , output mListDbAll
     1426               , output mListKey
     1427               , output mListKeyAll
     1428               , input mForExtsys
     1429               , input mForProc
     1430               , output table tt-BatchProcess
     1431               ) no-error.
     1432               run adm/wr-n-bp.p
     1433                   ( input this-procedure:handle
     1434                   ,input mSessionBegin
     1435                   ,input vAutoType
     1436                   ,input mListDb
     1437                   ,input mForExtsys
     1438                   ,input mForProc
     1439                   ) no-error.
     1440               if error-status :error
     1441               then do:
     1442                  vError = yes.
     1443                  run write-to-log( vss-workfile + chr(32)
     1444                               + "Ошибка при анализе начала следующего сеанса" + chr(10)
     1445                               + error-status :get-message(error-status :num-messages) + chr(10)
     1446                               + return-value
     1447                               ) no-error.
     1448                  if error-status:error
     1449                  then do:
     1450                     run write-to-screen (return-value).
     1451                  end.
     1452               end.
     1453            end.
     1454            run adm/chk-sch.p
     1455               ( input  vAutoType
     1456               , input  mForDb
     1457               , output mListDb
     1458               , output mListDbAll
     1459               , output mListKey
     1460               , output mListKeyAll
     1461               , input mForExtsys
     1462               , input mForProc
     1463               , output table tt-BatchProcess
     1464               ) no-error.
     1465            if error-status :error
     1466            then do:
     1467               run write-to-log( vss-workfile + chr(32)
     1468                               + "Ошибка при чтении расписания." + chr(10)
     1469                               + error-status :get-message(error-status :num-messages) + chr(10)
     1470                               + return-value
     1471                               ) .
     1472               return error.
     1473            end.
     1474            for each tt-BatchProcess:
     1475               run startproc(tt-BatchProcess.BP_Type,
     1476                             tt-BatchProcess.CharKey_One,
     1477                             tt-BatchProcess.CharKey_Three,
     1478                             datetime-tz (tt-BatchProcess.BP_ExecSysDate,tt-BatchProcess.BP_ExecSysTimeInt * 1000)).
     1479            end.
     1480         end.
     1481      end.
     1482      if iNextPeriod and not vError
     1483      then
     1484         mSessionBegin = false.
     1485      if vConect
     1486      then do:
     1487         run gbl/dbdiscon.p no-error.
     1488         if error-status :error then do:
     1489            run write-to-log (  substitute( "&1. Не удалось отсоединиться от БД&2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message(1) ) ) no-error.
     1490            if error-status:error
     1491            then do:
     1492               run write-to-screen (return-value).
     1493            end.
     1494         end.
     1495      end.
     1496   end procedure.
     1497   define stream VarStream.
     1498   procedure ReedFileContext:
     1499      define variable v-varfile as character no-undo.
     1500      define variable v-varstr as character no-undo.
     1501      define variable mNewHiddenMode as logical no-undo.
     1502      assign
     1503         file-info:file-name = substitute( "./ATH&1.var", g#auto-pid )
     1504         v-varfile           = file-info:full-pathname
     1505      .
     1506      if v-varfile <> ?
     1507      then do:
     1508         v-varstr = "".
     1509         input stream VarStream from value( v-varfile ) .
     1510         block_read-var:
     1511         repeat :
     1512            import stream VarStream unformatted v-varstr no-error .
     1513            leave block_read-var .
     1514         end.
     1515         input stream VarStream close.
     1516         if lookup( "H":U, v-varstr, "+":U ) = 0
     1517         then do:
     1518            mNewHiddenMode = false.
     1519         end.
     1520         else do:
     1521            mNewHiddenMode = true.
     1522         end.
     1523         os-delete value( v-varfile ) .
     1524         if mNewHiddenMode <> mHiddenMode
     1525         then do:
     1526            mHiddenMode = mNewHiddenMode.
     1527            run write-to-log ( substitute( "Смена статуса 'видимости' сессии. Теперь сессия &1видна.", (if mHiddenMode = true then "не":U else "") ) ) no-error.
     1528            if error-status:error
     1529            then do:
     1530               run write-to-screen (return-value).
     1531            end.
     1532         end.
     1533      end.
     1534   end.
     1535   procedure CheckUpdate:
     1536     define variable CheckUpd      as class ibs.th.adm.upd.CheckUpd no-undo.
     1537     CheckUpd = new ibs.th.adm.upd.CheckUpd ().
     1538     if CheckUpd:isStopWork
     1539     then do:
     1540        run write-to-log ("Идет установка r-кодов. Попробуйте через несколько минут.") .
     1541        delete object CheckUpd no-error.
     1542        return error "Идет установка r-кодов. Попробуйте через несколько минут.".
     1543     end.
     1544     if CheckUpd:isNeedUpd
     1545     then do:
     1546        run write-to-log ("Необходимо обновить базу. Запустите ТН") .
     1547        delete object CheckUpd no-error.
     1548        return error "Необходимо обновить базу. Запустите ТН".
     1549     end.
     1550     delete object CheckUpd no-error.
     1551   end.
     1552   mAsyncProcRun = yes.
     1553   define variable v-time          as integer   no-undo .
     1554   define variable v-today         as date      no-undo .
     1555   define variable log-exit      as logical   no-undo .
     1556   define variable mtitle as character no-undo.
     1557   define variable mDbInfo as character no-undo.
     1558   define var automain as widget-handle no-undo.
     1559   define button b-exit auto-go default
     1560        label "Вы&ход "
     1561        size 10 by 1 tooltip "Выход из автоматической системы"
     1562        bgcolor 8 .
     1563   define button b-hand default
     1564        label "&РРежим"
     1565        size 10 by 1 tooltip "Ручной режим приема и отправки новостей"
     1566        bgcolor 8 .
     1567   define button b-start default
     1568        label "&Запуск"
     1569        size 10 by 1 tooltip "Запустить один цикл"
     1570        bgcolor 8 .
     1571   define button b-help default
     1572        label "Помо&щь"
     1573        size 10 by 1 tooltip "Помощь"
     1574        bgcolor 8 .
     1575   define button b-prop default
     1576        label "&Настройки"
     1577        size 10 by 1 tooltip "Настройка СПН"
     1578        bgcolor 8 .
     1579   define variable auto-log as character
     1580        view-as editor no-word-wrap scrollbar-horizontal scrollbar-vertical large
     1581        size 96.88 by 19.75 no-undo.
     1582   define variable curr-date as date format "99/99/9999":U
     1583         view-as text
     1584        size 11 by .67 no-undo.
     1585   define variable curr-time as character format "X(8)":U
     1586         view-as text
     1587        size 8 by .67 no-undo.
     1588   define variable f-msg as character format "X(256)":U
     1589         view-as text
     1590        size 63 by .67
     1591        fgcolor 12  no-undo.
     1592   define frame f-amain
     1593        b-exit at row 1.17 col 2.25
     1594        b-hand at row 1.17 col 12.25
     1595        b-prop at row 1.17 col 22.25
     1596        b-start at row 1.17 col 32.25
     1597        b-help at row 1.17 col 89
     1598        auto-log at row 3.38 col 2.25 no-label
     1599        f-msg at row 2.5 col 13 colon-aligned no-label
     1600        curr-date at row 2.5 col 79 no-label
     1601        curr-time at row 2.5 col 90.5 no-label
     1602        "Сообщения:" view-as text
     1603             size 10.5 by .67 at row 2.5 col 3
     1604       with 1 down no-box keep-tab-order overlay
     1605            side-labels no-underline three-d
     1606            at col 1 row 1
     1607            size 99.38 by 22.42.
     1608   if session:display-type = "GUI":U then
     1609     create window automain assign
     1610            hidden             = yes
     1611            title              = ""
     1612            height             = 22.75
     1613            width              = 99.38
     1614            max-height         = 22.75
     1615            max-width          = 99.38
     1616            virtual-height     = 22.75
     1617            virtual-width      = 99.38
     1618            resize             = no
     1619            scroll-bars        = no
     1620            status-area        = no
     1621            bgcolor            = ?
     1622            fgcolor            = ?
     1623            keep-frame-z-order = yes
     1624            three-d            = yes
     1625            message-area       = no
     1626            sensitive          = yes.
     1627   else automain = current-window.
     1628   assign
     1629          auto-log:READ-ONLY in frame f-amain        = true.
     1630   assign
     1631          b-hand:HIDDEN in frame f-amain           = true.
     1632   assign
     1633         b-start:HIDDEN in frame f-amain           = true.
     1634   assign
     1635          b-prop:HIDDEN in frame f-amain           = true.
     1636   assign
     1637          f-msg:READ-ONLY in frame f-amain        = true.
     1638   if session:display-type = "GUI":U and VALID-HANDLE(automain)
     1639   then automain:hidden = yes.
     1640   on end-error of automain
     1641   or endkey of automain anywhere do:
     1642     return no-apply.
     1643   end.
     1644   on window-close of automain
     1645   do:
     1646     return no-apply.
     1647   end.
     1648   on choose of b-exit in frame f-amain
     1649   do:
     1650     define variable v-answer as logical   no-undo .
     1651     run gbl/q-wait.w
     1652       ( input substitute( "Вы хотите завершить работу авторежима?" )
     1653        ,input false
     1654        ,input 20
     1655        ,output v-answer
     1656       ) no-error .
     1657     if error-status :error
     1658       or v-answer = true
     1659     then do:
     1660       if error-status :error then do:
     1661         run write-to-log ( substitute( "&1. Ошибка при завершении работы. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1) )
     1662                         ).
     1663       end.
     1664       assign
     1665         log-exit = yes
     1666       .
     1667     end.
     1668   end.
     1669   on choose of b-start in frame f-amain
     1670   do:
     1671   end.
     1672   on choose of b-hand in frame f-amain
     1673   do:
     1674      message "Будет реализован чуть позже"
     1675      view-as alert-box.
     1676   end.
     1677   on choose of b-prop in frame f-amain
     1678   do:
     1679      message "что за шляпа"
     1680      view-as alert-box.
     1681   end.
     1682   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1683   on help of frame f-amain
     1684   do:
     1685     run gbl/app_help.p
     1686       (input this-procedure :file-name
     1687       ,input ''
     1688       ,input ?
     1689       ) no-error.
     1690     if error-status :error then do:
     1691       message
     1692         "Ошибка при вызове помощи"
     1693         error-status :get-message(1)
     1694         view-as alert-box .
     1695     end.
     1696   end.
     1697   run minbtn-set in this-procedure .
     1698   on choose of b-help in frame f-amain
     1699   do:
     1700     apply "help":u to frame f-amain .
     1701   end.
     1702   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1703   procedure minbtn-set :
     1704       do
     1705           on error undo, return error return-value
     1706           :
     1707           define variable ii              as integer       no-undo .
     1708           define variable fh              as widget-handle no-undo .
     1709           define variable hh              as widget-handle no-undo .
     1710           define variable v-h             as handle        extent 4 no-undo .
     1711           define variable v-name-button   as character     no-undo .
     1712           define variable v-help-old-x    as decimal       no-undo .
     1713           define variable v-help-old-y    as decimal       no-undo .
     1714           define variable v-help-old-size as decimal       no-undo .
     1715           define variable v-frame-width   as decimal       no-undo .
     1716           define variable jj              as integer       no-undo .
     1717           do
     1718               on error undo, return error
     1719               :
     1720               assign
     1721                   v-frame-width = frame f-amain:width - 0.3
     1722                   fh            = frame f-amain:first-child
     1723                   hh            = fh:first-child
     1724                   ii            = 1
     1725                   .
     1726               do while valid-handle(hh):
     1727                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1728                   do:
     1729                       case lc(hh:name) :
     1730                           when "b-help" then
     1731                               do:
     1732                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1733                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1734                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1735                                   hh:TOOLTIP = "Помощь" .
     1736                                   v-help-old-x = hh:column .
     1737                                   v-help-old-y = hh:row    .
     1738                                   v-help-old-size = hh:width .
     1739                                   hh:width-chars = 2.5 .
     1740                               end.
     1741                           when "b-print" then
     1742                               do:
     1743                                   hh:load-image("cmp/b-print.bmp":u) .
     1744                                   hh:TOOLTIP = "Печать" .
     1745                                   v-h[ii] = hh:handle .
     1746                                   ii = ii + 1 .
     1747                                   hh:width-chars = 3 .
     1748                               end.
     1749                           when "b-history" or
     1750                           when "b-hist" then
     1751                               do:
     1752                                   hh:load-image("cmp/b-hist.bmp":u) .
     1753                                   hh:TOOLTIP = "История" .
     1754                                   v-h[ii] = hh:handle .
     1755                                   ii = ii + 1 .
     1756                                   hh:width-chars = 3 .
     1757                               end.
     1758                           when "b-sch" then
     1759                               do:
     1760                                   hh:load-image("cmp/b-sch.bmp":u) .
     1761                                   hh:TOOLTIP = "Установка Фильтра" .
     1762                                   v-h[ii] = hh:handle .
     1763                                   ii = ii + 1 .
     1764                                   hh:width-chars = 3 .
     1765                               end.
     1766                           when "b-hist-user" then
     1767                               do:
     1768                                   hh:load-image("cmp/b-hist.bmp":u) .
     1769                                   hh:TOOLTIP = "История пользователя" .
     1770                                   ii = ii + 1 .
     1771                               end.
     1772                       end case.
     1773                   end.
     1774                   hh = hh:next-sibling.
     1775               end.
     1776               b-help:column = v-frame-width - b-help:width-chars.
     1777               jj = 0.
     1778               repeat ii = 4 to 1 by -1 :
     1779                   if valid-handle (v-h[ii] ) then
     1780                   do:
     1781                       jj  = jj + 1 .
     1782                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1783                       v-h[ii]:row    = v-help-old-y .
     1784                   end.
     1785               end.
     1786           end.
     1787       end.
     1788   end procedure.
     1789   assign CURRENT-WINDOW                = automain
     1790          THIS-PROCEDURE:CURRENT-WINDOW = automain.
     1791   on close of this-procedure
     1792   do:
     1793     apply "choose" to b-exit in frame f-amain.
     1794     return no-apply.
     1795   end.
     1796   pause 0 before-hide.
     1797   run gbl\inidebug.p.
     1798   MAIN-BLOCK:
     1799   do on error   undo MAIN-BLOCK, leave MAIN-BLOCK
     1800      on end-key undo MAIN-BLOCK, retry MAIN-BLOCK
     1801      on stop    undo MAIN-BLOCK, retry MAIN-BLOCK:
     1802      define variable start-time            as int64     no-undo .
     1803      run initProcMode (i-auto-type,i-mode).
     1804      run adm/autoconn.p no-error.
     1805      if error-status :error then do:
     1806         run write-to-log ( substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1) ) ).
     1807      end.
     1808      run CheckUpdate no-error.
     1809      if error-status :error then do:
     1810        return error return-value.
     1811      end.
     1812      run adm/chk-db.p no-error .
     1813      if error-status :error then do:
     1814         run write-to-log (  substitute( "&1. Проверка возможности работы сессии.&2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message(1) ) ).
     1815         run gbl/dbdiscon.p no-error.
     1816         if error-status :error then do:
     1817            run write-to-log (  substitute( "&1. Не удалось отсоединиться от БД&2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message(1) ) ).
     1818         end.
     1819         log-exit = true.
     1820      end.
     1821      else do:
     1822         define variable Vdbinfo as character no-undo.
     1823         run adm/db-info.p ( output g#db-num, output Vdbinfo ) no-error.
     1824         run gbl/dbdiscon.p no-error.
     1825         if error-status :error then do:
     1826            run write-to-log (  substitute( "&1. Не удалось отсоединиться от БД&2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message(1) ) ).
     1827         end.
     1828         g#auto = false.
     1829         assign
     1830            auto-log-msg-h = auto-log:handle
     1831            auto-window-h = this-procedure:handle
     1832            hand-log-msg-h = ?
     1833            automain:title = substitute( "PID: &1 &2 Выполнение паралельных процесов.", g#auto-pid, automain:title )
     1834         .
     1835         run write-to-log ( "Запущена система выполнения автозаданий" ) no-error.
     1836         if error-status:error
     1837         then do:
     1838             run write-to-screen (return-value).
     1839         end.
     1840         if mHiddenMode = false then do:
     1841            run write-to-log ( "Через 5 секунд будет запущено выполнении автозаданий" ) no-error.
     1842            if error-status:error
     1843            then do:
     1844               run write-to-screen (return-value).
     1845            end.
     1846            wait-for
     1847               go of frame f-amain
     1848               or close of this-procedure
     1849               or choose of b-hand in frame f-amain
     1850               or choose of b-help in frame f-amain
     1851               or choose of b-prop in frame f-amain
     1852               or choose of b-start in frame f-amain
     1853               focus frame f-amain
     1854               pause 5
     1855            .
     1856         end.
     1857         if not log-exit
     1858         then do:
     1859            run write-to-log ( "Запущен автоматический режим выполнения заданий" ) no-error.
     1860            if error-status:error
     1861            then do:
     1862               run write-to-screen (return-value).
     1863            end.
     1864         end.
     1865         mtitle = automain:title.
     1866         if mForDb <> "":U then do:
     1867            run write-to-log ( substitute( "Сессия работает с БД &1", mForDb ) ).
     1868         end.
     1869         if mForExtsys <> "":U then do:
     1870            run write-to-log ( substitute( "Сессия работает с Внешними Системами &1", mForExtsys ) ).
     1871         end.
     1872         if mForProc <> "":U then do:
     1873            run write-to-log ( substitute( "Сессия работает с Произвольными заданиями &1", mForProc ) ).
     1874         end.
     1875         define variable mAutoType as character no-undo.
     1876         define variable mTypeProc as character no-undo.
     1877         if i-auto-type ne ""
     1878         then
     1879            run write-to-log ( substitute( "Переданые типы &1", i-auto-type ) ).
     1880         define variable vi as integer no-undo.
     1881         do vi = 1 to num-entries (i-auto-type):
     1882            mTypeProc = entry(vi,i-auto-type).
     1883            if lookup(mTypeProc,mAllTypeSuport) ne 0
     1884            then
     1885               mAutoType = mAutoType +  "," + mTypeProc.
     1886         end.
     1887         i-auto-type = trim (mAutoType,",").
     1888         if i-auto-type eq ""
     1889         then do:
     1890            i-auto-type = 'autonws':U + "," + 'is_diadoc':U + "," + 'mercury':U + "," + 'is_motp':U .
     1891            run write-to-log ( substitute( "Выставлены типы автозаданий по умолчанию &1", i-auto-type ) ).
     1892         end.
     1893         run write-to-log ( substitute( "Типы для обработки &1", i-auto-type ) ).
     1894         run write-to-log ( substitute( "Типы количество сессий задаются -param N:5,T:&1", replace(mAllTypeSuport,",","+") ) ).
     1895         run write-to-log ( substitute( "   N - Количество сессий по умолчанию 10 ") ).
     1896         run write-to-log ( substitute( "   T - Список типов процесов разделитель + ") ).
     1897         run write-to-log ( substitute( "   Поддерживымые типы: ") ).
     1898         run write-to-log ( substitute( "      &1 - Новости", string('autonws':U  ,"x(15)") ) ).
     1899         run write-to-log ( substitute( "      &1 - Диадок ", string('is_diadoc':U,"x(15)") ) ).
     1900         run write-to-log ( substitute( "      &1 - Меркурий", string('mercury':U  ,"x(15)") ) ).
     1901         run write-to-log ( substitute( "      &1 - МОТП", string('is_motp':U  ,"x(15)") ) ).
     1902         run write-to-log ( substitute( "      &1 - Архивы", string('autoarh':U  ,"x(15)") ) ).
     1903         run write-to-log ( substitute( "      &1 - SmartHDD", string('hddtest':U  ,"x(15)") ) ).
     1904         run write-to-log ( substitute( "      &1 - Экспрт данных", string('autoexp':U  ,"x(15)") ) ).
     1905         mAsyncHelper = new ibs.th.file.AsyncHelperth().
     1906         mAsyncHelper:mProcPublish = this-procedure.
     1907         mAsyncHelper:setCurrentUserPasswd().
     1908         mAsyncHelper:MyBachMode = yes.
     1909         mAsyncHelper:WritelogInter = 5.
     1910         mAsyncHelper:MyBachMode = yes.
     1911         if inumSession > 0 and inumSession ne ?
     1912         then
     1913            mAsyncHelper:maxproc = inumSession.
     1914         run write-to-log ( substitute( "Колличество сессий &1", mAsyncHelper:maxproc ) ).
     1915         subscribe "EndTaskAsunc" anywhere run-procedure "RunNewTask".
     1916         run initAsyncProc (automain:title,
     1917                            i-auto-type,
     1918                            mAsyncHelper:getListTask(),
     1919                            no,
     1920                            output mDbInfo) no-error.
     1921         main-cycl:
     1922         do while not log-exit
     1923         on error  undo, leave main-cycl
     1924         on stop   undo, next
     1925         on endkey undo, next
     1926         :
     1927            run cur-time( output v-today
     1928                         ,output v-time
     1929                      ) no-error.
     1930            run CheckUpdate no-error.
     1931            if error-status :error then do:
     1932                 return error return-value.
     1933            end.
     1934            run AddCashParam(i-auto-type,v-today, v-time).
     1935            run initAsyncProc (automain:title,
     1936                               i-auto-type,
     1937                               mAsyncHelper:getListTask(),
     1938                               yes,
     1939                               output mDbInfo) no-error.
     1940            if error-status:error
     1941            then do:
     1942               assign
     1943                  automain:title = mTitle
     1944               .
     1945               if return-value = "WaitOK"
     1946               then
     1947                  next main-cycl .
     1948               log-exit = true.
     1949               leave main-cycl .
     1950            end.
     1951            automain:title = mtitle + chr(32) + mDbInfo.
     1952            if num-entries( mListDb ) > 0
     1953            then do:
     1954               run write-to-log ( "Текущая" + chr(32) + mDbInfo ) no-error.
     1955               if error-status:error
     1956               then do:
     1957                  run write-to-screen (return-value).
     1958               end.
     1959            end.
     1960            if mAsyncHelper:isWorkShed()
     1961            then do:
     1962               run waitproc("Ожидаем получение данных").
     1963               run adm/autoconn.p no-error.
     1964               if error-status :error
     1965               then do:
     1966                  run write-to-log ( substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1) ) ).
     1967                  assign
     1968                     automain:title = mtitle
     1969                  .
     1970               end.
     1971            end.
     1972            assign
     1973               start-time = etime
     1974             .
     1975            do while not log-exit:
     1976               if mHiddenMode = false then do:
     1977                  wait-for
     1978                        go of frame f-amain
     1979                     or close of this-procedure
     1980                     or choose of b-hand in frame f-amain
     1981                     or choose of b-help in frame f-amain
     1982                     or choose of b-prop in frame f-amain
     1983                     or choose of b-start in frame f-amain
     1984                     focus frame f-amain
     1985                     pause 1
     1986                  .
     1987                  display
     1988                     string( time, "HH:MM:SS" ) @ curr-time
     1989                     today @ curr-date
     1990                     with frame f-amain
     1991                  no-error.
     1992               end.
     1993               else do:
     1994                  wait-for
     1995                        go of frame f-amain
     1996                     or close of this-procedure
     1997                     pause 1
     1998                  .
     1999               end.
     2000               run ReedFileContext.
     2001               if     mHiddenMode = false
     2002                  and frame f-amain:visible = false
     2003               then do:
     2004                  run myenable in this-procedure
     2005                     ( input i-auto-type
     2006                     ) .
     2007               end.
     2008               if     mHiddenMode = true
     2009                  and frame f-amain:visible = true
     2010               then do:
     2011                  run myhide in this-procedure .
     2012               end.
     2013               if    etime - start-time > 60000
     2014                  or time mod 60 = 1
     2015               then do:
     2016                  leave .
     2017               end.
     2018            end.
     2019            if mHiddenMode = false
     2020            then do:
     2021               display
     2022                 "" @ curr-time
     2023                 "" @ curr-date
     2024                 with frame f-amain
     2025                 no-error
     2026               .
     2027            end.
     2028         end.
     2029      end.
     2030   end.
     2031   unsubscribe "EndTaskAsunc".
     2032   delete object mAsyncHelper.
     2033   run write-to-log ( "Закончен сеанс выполнения автозаданий" ) no-error.
     2034   if error-status:error
     2035   then do:
     2036      run write-to-screen (return-value).
     2037   end.
     2038   run disable_UI.
     2039   procedure disable_UI :
     2040     if session:display-type = "GUI":U and VALID-HANDLE(automain)
     2041     then delete widget automain.
     2042     if this-procedure:persistent then delete procedure this-procedure.
     2043   end procedure.
     2044   procedure enable_UI :
     2045     display auto-log curr-date curr-time
     2046         with frame f-amain in window automain.
     2047     enable b-exit b-help auto-log
     2048         with frame f-amain in window automain.
     2049     view automain.
     2050   end procedure.
     2051   procedure get-db-num :
     2052     define output parameter p-db-num as integer no-undo .
     2053     do
     2054     on error undo, return error return-value
     2055     :
     2056         run gbl/getdbnum.p (output p-db-num).
     2057     end.
     2058   end procedure.
     2059   procedure get-report-num :
     2060   define output parameter p-report-num as integer no-undo .
     2061     do
     2062     on error undo, return error return-value
     2063     :
     2064       run gbl/getrpnum.p (output p-report-num).
     2065     end.
     2066   end procedure.
     2067   procedure get-userid :
     2068   do
     2069   on error undo, return error
     2070   :
     2071   define output parameter p-userid  as character    no-undo.
     2072       assign
     2073           p-userid = g#userid
     2074       .
     2075   end.
     2076   end procedure.
     2077   procedure hide-message :
     2078   assign
     2079       f-msg = "":U
     2080     .
     2081     hide f-msg in frame f-amain.
     2082     return .
     2083   end procedure.
     2084   procedure myenable :
     2085     define input  parameter pe-auto-type as character no-undo .
     2086     assign
     2087       automain:hidden = false
     2088     .
     2089     run enable_UI.
     2090     if pe-auto-type = 'autonws':U
     2091       or pe-auto-type = 'autooxml':U
     2092     then do:
     2093       enable b-hand b-prop with frame f-amain.
     2094     end.
     2095     if session:debug-alert
     2096     then do:
     2097       enable b-start b-prop with frame f-amain.
     2098     end.
     2099   end procedure.
     2100   procedure myhide :
     2101     disable all with frame f-amain .
     2102     hide all no-pause in window automain .
     2103     assign
     2104       automain:hidden = true
     2105     .
     2106   end procedure.
     2107   procedure write-message :
     2108   define input  parameter p-msg as character no-undo .
     2109     assign
     2110       f-msg = p-msg
     2111     .
     2112     enable f-msg with frame f-amain.
     2113     display
     2114       f-msg
     2115       with frame f-amain
     2116       .
     2117     return .
     2118   end procedure.
     2119   procedure RunNewTask :
     2120   define input  parameter iTask as character no-undo .
     2121     run initAsyncProc (automain:title,
     2122                        i-auto-type,
     2123                        mAsyncHelper:getListTask(),
     2124                        yes,
     2125                        output mDbInfo) no-error.
     2126   end procedure.
