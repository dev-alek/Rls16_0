        1   block-level on error undo, throw.
        2   define parameter buffer buf_ext-file for ub.ext-file.
        3   define input parameter p-tree as logical no-undo .
        4   define input parameter p-status_ as character no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: extf-del.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: adm/extf-del.p $":U .
       10   define variable vss-description as character no-undo init "Удаление пакета обновлений".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   define  temp-table tt-ext-file-par no-undo like ub.ext-file-par.
       82   procedure ext-file-par-clear-temp :
       83     define buffer buf_tt-ext-file-par for tt-ext-file-par .
       84     do
       85     on error undo, return error return-value
       86     :
       87       for each buf_tt-ext-file-par
       88       on error undo, return error
       89       :
       90         delete buf_tt-ext-file-par .
       91       end.
       92     end.
       93   end procedure.
       94   procedure ext-file-par-write-temp :
       95     define input  parameter p-db-num      as integer no-undo .
       96     define input  parameter p-from-db-num      as integer no-undo .
       97     define input  parameter p-file-num      as integer no-undo .
       98     define input  parameter p-param-num      as integer no-undo .
       99     define input  parameter p-value-type as character no-undo .
      100     define input  parameter p-value-name as character no-undo .
      101     define input  parameter p-value-char as character no-undo .
      102     define input  parameter p-value-date as date      no-undo .
      103     define input  parameter p-value-integer as integer      no-undo .
      104     define input  parameter p-value-decimal as decimal      no-undo .
      105     define input  parameter p-value-logical as logical      no-undo .
      106     define buffer buf_tt-ext-file-par for tt-ext-file-par .
      107     do
      108     on error undo, return error return-value
      109     :
      110       find first buf_tt-ext-file-par
      111         where buf_tt-ext-file-par.db-num        = p-db-num
      112           and buf_tt-ext-file-par.file-num      = p-file-num
      113           and buf_tt-ext-file-par.from-db-num   = p-from-db-num
      114           and buf_tt-ext-file-par.param-type    = p-value-type
      115           and buf_tt-ext-file-par.param-name    = p-value-name
      116         no-error .
      117       if not available buf_tt-ext-file-par then do:
      118         create buf_tt-ext-file-par .
      119         assign
      120           buf_tt-ext-file-par.db-num         = p-db-num
      121           buf_tt-ext-file-par.from-db-num    = p-from-db-num
      122           buf_tt-ext-file-par.file-num       = p-file-num
      123           buf_tt-ext-file-par.param-num      = p-param-num
      124           buf_tt-ext-file-par.param-type     = p-value-type
      125           buf_tt-ext-file-par.user-db-num    = p-db-num
      126                 .
      127       end.
      128       CASE p-value-type:
      129         when 'C':U
      130         or when 'uniq-key-rec':U
      131         then do:
      132           assign
      133           buf_tt-ext-file-par.param-name = p-value-name
      134           buf_tt-ext-file-par.param-value = p-value-char
      135           .
      136         end.
      137         when 'T':U then do:
      138           assign
      139           buf_tt-ext-file-par.param-date-name = p-value-name
      140           buf_tt-ext-file-par.param-date-value = p-value-date
      141           .
      142         end.
      143         when 'I':U then do:
      144           assign
      145           buf_tt-ext-file-par.param-int-name = p-value-name
      146           buf_tt-ext-file-par.param-int-value = p-value-integer
      147           .
      148         end.
      149         when 'L':U then do:
      150           assign
      151           buf_tt-ext-file-par.param-log-name = p-value-name
      152           buf_tt-ext-file-par.param-log-value = p-value-logical
      153           .
      154         end.
      155         when 'D':U then do:
      156           assign
      157           buf_tt-ext-file-par.param-decimal-name = p-value-name
      158           buf_tt-ext-file-par.param-decimal-value = p-value-decimal
      159           .
      160         end.
      161       END CASE.
      162     end.
      163   end procedure.
      164   procedure ext-file-par-write-and-send :
      165     define input  parameter p-db-num      as integer no-undo .
      166     define input  parameter p-from-db-num      as integer no-undo .
      167     define input  parameter p-file-num      as integer no-undo .
      168     define input  parameter p-param-num      as integer no-undo .
      169     define input  parameter p-value-type as character no-undo .
      170     define input  parameter p-value-name as character no-undo .
      171     define input  parameter p-value-char as character no-undo .
      172     define input  parameter p-value-date as date      no-undo .
      173     define input  parameter p-value-integer as integer      no-undo .
      174     define input  parameter p-value-decimal as decimal      no-undo .
      175     define input  parameter p-value-logical as logical      no-undo .
      176     define input  parameter p-send        as logical no-undo .
      177     define input  parameter p-list-db-num as character no-undo .
      178     define buffer buf_ext-file-par for ub.ext-file-par .
      179     do
      180     on error undo, return error return-value
      181     :
      182       find first buf_ext-file-par
      183         where buf_ext-file-par.db-num         = p-db-num
      184           and buf_ext-file-par.from-db-num    = p-from-db-num
      185           and buf_ext-file-par.file-num       = p-file-num
      186           and buf_ext-file-par.param-num      = p-param-num
      187         no-error .
      188       if not available buf_ext-file-par then do:
      189         create buf_ext-file-par .
      190         assign
      191           buf_ext-file-par.db-num    = p-db-num
      192           buf_ext-file-par.from-db-num    = p-from-db-num
      193           buf_ext-file-par.file-num    = p-file-num
      194           buf_ext-file-par.param-num    = p-param-num
      195           buf_ext-file-par.param-type   = p-value-type
      196           buf_ext-file-par.user-db-num    = p-db-num
      197         .
      198       end.
      199       CASE p-value-type:
      200         when 'C':U
      201         or when ''
      202         or when 'uniq-key-rec':U
      203         then do:
      204           assign
      205           buf_ext-file-par.param-name = p-value-name
      206           buf_ext-file-par.param-value = p-value-char
      207           .
      208           if p-value-type = ''
      209           and p-param-num = 0 then do:
      210             buf_ext-file-par.param-log-value = p-value-logical.
      211           end.
      212         end.
      213         when 'T':U then do:
      214           assign
      215           buf_ext-file-par.param-date-name = p-value-name
      216           buf_ext-file-par.param-date-value = p-value-date
      217           .
      218         end.
      219         when 'I':U then do:
      220           assign
      221           buf_ext-file-par.param-int-name = p-value-name
      222           buf_ext-file-par.param-int-value = p-value-integer
      223           .
      224         end.
      225         when 'D':U then do:
      226           assign
      227           buf_ext-file-par.param-decimal-name = p-value-name
      228           buf_ext-file-par.param-decimal-value = p-value-decimal
      229           .
      230         end.
      231         when 'L':U then do:
      232           assign
      233           buf_ext-file-par.param-log-name = p-value-name
      234           buf_ext-file-par.param-log-value = p-value-logical
      235           .
      236         end.
      237       END CASE.
      238       if p-send then do:
      239         run nws/cr-route.p (
      240                         input 'send-tbl':U
      241                       , input 'ext-file-par':U
      242                       , input buffer buf_ext-file-par:handle
      243                       , input p-list-db-num) no-error.
      244       end.
      245     end.
      246   end procedure.
      247   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      248   procedure gen-key-rec :
      249     define input  parameter p-tbl-name    as character no-undo.
      250     define input  parameter p-bh_tbl-name as handle    no-undo.
      251     define output parameter p-key-rec     as character no-undo.
      252     do
      253     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      254     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      255     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      256     :
      257       define variable fh               as handle    no-undo .
      258       define variable v-ok             as logical   no-undo .
      259       define variable v-inform         as character no-undo .
      260       define variable v-ind            as integer   no-undo .
      261       define variable v-idx-field-qnty as integer   no-undo .
      262       if p-tbl-name = ?
      263         or p-tbl-name = "":U
      264       then do:
      265         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
      266       end.
      267       if not p-bh_tbl-name:available then do:
      268         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      269       end.
      270       assign
      271         p-key-rec = p-tbl-name
      272         v-inform  = p-bh_tbl-name:index-information(1)
      273         v-ind     = 2
      274       .
      275       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      276       on error undo, return error
      277       :
      278         assign
      279           v-inform = p-bh_tbl-name:index-information( v-ind )
      280           v-ind    = v-ind + 1
      281         .
      282       end.
      283       if v-inform = ?
      284         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      285         or entry( 3, v-inform, ",":U ) <> "1":U
      286       then do:
      287         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      288       end.
      289       else do:
      290         assign
      291           v-idx-field-qnty = num-entries( v-inform ) - 4
      292         .
      293         if v-idx-field-qnty < 2 then do:
      294           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      295         end.
      296         do v-ind = 1 to v-idx-field-qnty by 2
      297         on error undo, return error
      298         :
      299           assign
      300             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      301             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      302           .
      303         end.
      304       end.
      305       if p-key-rec = ? then do:
      306         assign
      307           p-key-rec = "":U
      308         .
      309         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      310       end.
      311     end.
      312     return.
      313   end procedure.
      314   procedure gen-where-keyr-tab :
      315     define input  parameter i-tableSerach as character no-undo.
      316     define input  parameter i-tablekey   as character  no-undo.
      317     define input  parameter p-key-rec    as character  no-undo.
      318     define input  parameter p-key-handle as handle     no-undo .
      319     define input  parameter p-db-name    as character  no-undo .
      320     define input  parameter p-tt-handle  as handle     no-undo .
      321     define output parameter o-Where      as character  no-undo.
      322     do
      323     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      324     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      325     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      326     :
      327       define variable v-full-tbl-name  as character no-undo .
      328       define variable bh_tbl-name      as handle    no-undo .
      329       define variable fh_key           as handle    no-undo .
      330       define variable fh_search        as handle    no-undo .
      331       define variable v-field-num      as integer   no-undo .
      332       define variable v-count-fld      as integer   no-undo .
      333       define variable v-inform         as character no-undo .
      334       define variable v-ind            as integer   no-undo .
      335       define variable v-idx-field-qnty as integer   no-undo .
      336       define variable v-field-name     as character no-undo .
      337       define variable v-field-val      as character no-undo .
      338       define variable v-word-link      as character no-undo .
      339       define variable vTable           as character no-undo.
      340       define variable bh_tbl-key       as handle    no-undo .
      341       assign
      342         p-key-rec = trim( p-key-rec )
      343       .
      344       if p-key-handle <> ? then do:
      345         if not valid-handle(p-key-handle)
      346            or p-key-handle:type <> "buffer"
      347         then do:
      348           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      349         end.
      350         if num-entries( p-key-rec, chr(3) ) > 1
      351           or p-key-rec = ?
      352           or p-key-rec = "":U
      353         then do:
      354           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      355         end.
      356       end.
      357       else do:
      358         if p-key-rec = ?
      359           or p-key-rec = "":U
      360         then do:
      361           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      362         end.
      363       end.
      364       assign
      365         vTable = entry( 1 , p-key-rec, chr(3) )
      366       .
      367       if p-tt-handle <> ?
      368         and ( not valid-handle(p-tt-handle)
      369               or p-tt-handle:type <> "buffer"
      370             )
      371       then do:
      372         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      373       end.
      374       if p-tt-handle = ? then do:
      375         assign
      376           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      377         .
      378         create buffer bh_tbl-name for table v-full-tbl-name .
      379       end.
      380       else do:
      381         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      382       end.
      383       assign
      384         v-inform = bh_tbl-name:index-information(1)
      385         v-ind    = 2
      386       .
      387       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      388       on error undo, return error
      389       :
      390         assign
      391           v-inform = bh_tbl-name:index-information( v-ind )
      392           v-ind    = v-ind + 1
      393         .
      394       end.
      395       if v-inform = ?
      396         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      397         or entry( 3, v-inform, ",":U ) <> "1":U
      398       then do:
      399         delete object bh_tbl-name no-error.
      400         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      401       end.
      402       assign
      403         v-idx-field-qnty = num-entries( v-inform ) - 4
      404       .
      405       if v-idx-field-qnty < 2 then do:
      406         delete object bh_tbl-name no-error.
      407         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      408       end.
      409       assign
      410         o-where     = "where":U
      411         v-word-link = "":U
      412         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      413         v-count-fld = 0
      414       .
      415       if i-tablekey ne "" and i-tablekey ne ?
      416       then do:
      417         assign
      418           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      419         .
      420         create buffer bh_tbl-key for table v-full-tbl-name .
      421       end.
      422       if i-tableSerach ne "" and i-tableSerach ne ?
      423       then do:
      424         delete object bh_tbl-name no-error.
      425         assign
      426           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      427         .
      428         create buffer bh_tbl-name for table v-full-tbl-name .
      429       end.
      430       block_where:
      431       do v-ind = 1 to v-idx-field-qnty by 2
      432       on error undo, return error
      433       :
      434         assign
      435           v-count-fld = v-count-fld + 1
      436         .
      437         if p-key-handle = ?
      438           and v-count-fld > v-field-num
      439         then do:
      440           leave block_where.
      441         end.
      442         define variable VfieldKeyTable as handle no-undo.
      443         assign
      444           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      445           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      446         .
      447         if     bh_tbl-key ne ?
      448         then do:
      449            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      450            if VfieldKeyTable eq ?
      451            then next block_where.
      452         end.
      453         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      454         then
      455            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      456         else
      457            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      458         if p-key-handle = ? then do:
      459           assign
      460             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      461           .
      462         end.
      463         else do:
      464           assign
      465             fh_key = p-key-handle:buffer-field( v-field-name )
      466           .
      467           if fh_key = ?
      468             or not valid-handle( fh_key )
      469           then do:
      470             delete object bh_tbl-name.
      471             if     bh_tbl-key ne ?
      472             then
      473                delete object bh_tbl-key.
      474             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      475           end.
      476           assign
      477             v-field-val = fh_key:buffer-value
      478           .
      479         end.
      480         if fh_search:data-type ="character":U then do:
      481           assign
      482             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      483             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      484             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      485             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      486             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      487             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      488             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      489             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      490             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      491             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      492             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      493             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      494             v-field-val = substitute( '"&1"', v-field-val )
      495           .
      496         end.
      497         assign
      498           o-where = substitute( "&1 &2", o-where, v-field-val )
      499         .
      500         if v-word-link = "":U then do:
      501           assign
      502             v-word-link = "and":U
      503           .
      504         end.
      505       end.
      506       delete object bh_tbl-name.
      507       if     bh_tbl-key ne ?
      508       then
      509          delete object bh_tbl-key.
      510       if p-key-handle = ?
      511         and v-count-fld <> v-field-num
      512       then do:
      513         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      514       end.
      515     end.
      516   end procedure.
      517   procedure gen-hn-keyr-tab :
      518     define input  parameter i-tableSerach as character no-undo.
      519     define input  parameter i-tablekey   as character no-undo.
      520     define input  parameter p-key-rec    as character no-undo.
      521     define input  parameter p-key-handle as handle    no-undo .
      522     define input  parameter p-db-name    as character no-undo .
      523     define input  parameter p-tt-handle  as handle    no-undo .
      524     define input  parameter p-stts-lock  as integer   no-undo .
      525     define output parameter o-hn         as handle    no-undo.
      526     define variable v-full-tbl-name as character no-undo.
      527     define variable v-where         as character no-undo.
      528     define variable bh_tbl-name     as handle    no-undo.
      529     define variable vTable          as character no-undo.
      530     do
      531     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      532     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      533     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      534         run gen-where-keyr-tab(i-tableSerach,
      535                                i-tablekey,
      536                                p-key-rec,
      537                                p-key-handle,
      538                                p-db-name,
      539                                p-tt-handle,
      540                                output v-where).
      541         if i-tableSerach ne "" and i-tableSerach ne ?
      542         then do:
      543            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      544            create buffer bh_tbl-name for table v-full-tbl-name .
      545         end.
      546         else do:
      547            if p-tt-handle = ? then do:
      548               assign
      549                  vTable = entry( 1 , p-key-rec, chr(3) )
      550               .
      551               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      552               create buffer bh_tbl-name for table v-full-tbl-name .
      553            end.
      554            else do:
      555               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      556            end.
      557         end.
      558         if p-tt-handle = ? then do:
      559            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      560         end.
      561         else do:
      562            bh_tbl-name:find-first( v-where ) no-error .
      563         end.
      564         o-hn = bh_tbl-name.
      565      end.
      566   end procedure.
      567   procedure gen-hn-keyr :
      568     define input  parameter p-key-rec    as character no-undo.
      569     define input  parameter p-key-handle as handle    no-undo .
      570     define input  parameter p-db-name    as character no-undo .
      571     define input  parameter p-tt-handle  as handle    no-undo .
      572     define input  parameter p-stts-lock  as integer   no-undo .
      573     define output parameter o-hn         as handle    no-undo.
      574     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      575   end.
      576   procedure gen-row-keyr :
      577     define input  parameter p-key-rec    as character no-undo.
      578     define input  parameter p-key-handle as handle    no-undo .
      579     define input  parameter p-db-name    as character no-undo .
      580     define input  parameter p-tt-handle  as handle    no-undo .
      581     define input  parameter p-stts-lock  as integer   no-undo .
      582     define output parameter p-tbl-row    as rowid     no-undo.
      583     define output parameter p-tbl-name   as character no-undo.
      584     define variable vHn as handle no-undo.
      585       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      586       p-tbl-row = if vHn:available then vHn:rowid else ?.
      587       p-tbl-name =  vHn:table.
      588       delete object vHn no-error.
      589     if p-tbl-row = ? then do:
      590       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      591     end.
      592     else do:
      593       return.
      594     end.
      595   end procedure.
      596   procedure gen-key-fv :
      597     define input  parameter p-key-rec    as character no-undo .
      598     define output parameter p-field-list as character no-undo .
      599     define output parameter p-value-list as character no-undo.
      600     do
      601     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      602     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      603     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      604     :
      605       define variable v-full-tbl-name  as character no-undo .
      606       define variable bh_tbl-name      as handle    no-undo .
      607       define variable v-tbl-name       as character no-undo .
      608       define variable v-field-num      as integer   no-undo .
      609       define variable v-count-fld      as integer   no-undo .
      610       define variable v-inform         as character no-undo .
      611       define variable v-ind            as integer   no-undo .
      612       define variable v-idx-field-qnty as integer   no-undo .
      613       define variable v-delim-key      as character no-undo .
      614       if p-key-rec = ?
      615         or p-key-rec = "":U
      616       then do:
      617         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      618       end.
      619       assign
      620         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      621         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      622       .
      623       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      624       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      625       assign
      626         v-inform = bh_tbl-name:index-information(1)
      627         v-ind    = 2
      628       .
      629       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      630       on error undo, return error
      631       :
      632         assign
      633           v-inform = bh_tbl-name:index-information( v-ind )
      634           v-ind    = v-ind + 1
      635         .
      636       end.
      637       if v-inform = ?
      638         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      639         or entry( 3, v-inform, ",":U ) <> "1":U
      640       then do:
      641         delete object bh_tbl-name no-error.
      642         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      643       end.
      644       assign
      645         v-idx-field-qnty = num-entries( v-inform ) - 4
      646       .
      647       if v-idx-field-qnty < 2 then do:
      648         delete object bh_tbl-name no-error.
      649         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      650       end.
      651       assign
      652         p-field-list = "":U
      653         p-value-list = "":U
      654         v-delim-key  = "":U
      655         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      656         v-count-fld  = 0
      657       .
      658       block_where:
      659       do v-ind = 1 to v-idx-field-qnty by 2
      660       on error undo, return error
      661       :
      662         assign
      663           v-count-fld = v-count-fld + 1
      664         .
      665         if v-count-fld > v-field-num then do:
      666           leave block_where.
      667         end.
      668         assign
      669           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      670           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      671         .
      672         if v-ind = 1 then do:
      673           assign
      674             v-delim-key = chr(3)
      675           .
      676         end.
      677       end.
      678       delete object bh_tbl-name.
      679       if v-count-fld <> v-field-num then do:
      680         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      681       end.
      682     end.
      683   end procedure.
      684   procedure gen-key-field :
      685     define input  parameter p-table      as character no-undo .
      686     define output parameter p-field-list as character no-undo .
      687     do
      688     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      689     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      690     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      691     :
      692       define variable v-full-tbl-name  as character no-undo .
      693       define variable bh_tbl-name      as handle    no-undo .
      694       define variable v-tbl-name       as character no-undo .
      695       define variable v-field-num      as integer   no-undo .
      696       define variable v-count-fld      as integer   no-undo .
      697       define variable v-inform         as character no-undo .
      698       define variable v-ind            as integer   no-undo .
      699       define variable v-idx-field-qnty as integer   no-undo .
      700       define variable v-delim-key      as character no-undo .
      701       if p-table = ?
      702         or p-table = "":U
      703       then do:
      704         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      705       end.
      706       assign
      707         v-tbl-name      = p-table
      708         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      709       .
      710       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      711       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      712       assign
      713         v-inform = bh_tbl-name:index-information(1)
      714         v-ind    = 2
      715       .
      716       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      717       on error undo, return error
      718       :
      719         assign
      720           v-inform = bh_tbl-name:index-information( v-ind )
      721           v-ind    = v-ind + 1
      722         .
      723       end.
      724       if v-inform = ?
      725         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      726         or entry( 3, v-inform, ",":U ) <> "1":U
      727       then do:
      728         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      729       end.
      730       assign
      731         v-idx-field-qnty = num-entries( v-inform ) - 4
      732       .
      733       if v-idx-field-qnty < 2 then do:
      734         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      735       end.
      736       assign
      737         p-field-list = "":U
      738         v-delim-key  = "":U
      739         v-count-fld  = 0
      740       .
      741       block_where:
      742       do v-ind = 1 to v-idx-field-qnty by 2
      743       on error undo, return error
      744       :
      745         assign
      746           v-count-fld = v-count-fld + 1
      747         .
      748         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      749         if v-ind = 1 then do:
      750           assign
      751             v-delim-key = chr(3)
      752           .
      753         end.
      754       end.
      755       delete object bh_tbl-name.
      756     end.
      757   end procedure.
      758   define variable v-tbl-row as rowid no-undo .
      759   define variable v-tbl-name as character no-undo .
      760   define buffer locked_ext-file for ub.ext-file.
      761   define buffer buf_Ext-file-line for ub.ext-file-line.
      762   define buffer buf2_ext-file for ub.ext-file.
      763   define buffer buf_ext-file-par for ub.ext-file-par.
      764   define buffer tree_ext-file for ub.ext-file.
      765   main-block:
      766   do transaction
      767   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      768   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      769   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      770   :
      771     if buf_ext-file.from-db-num <> g#db-num
      772     and not g#news
      773     and not p-tree
      774     then do:
      775       undo, return error substitute("Нельзя удалить файл БД &1 (от БД &2) &3№ файла &4&3&5 - он создан в другой БД"
      776                                       , buf_ext-file.db-num
      777                                       , buf_ext-file.from-db-num
      778                                       , chr(10)
      779                                       , buf_ext-file.file-num
      780                                       , buf_ext-file.file-name
      781                                       ).
      782     end.
      783     if buf_ext-file.file-type begins 'cash-desk':U + chr(3)
      784     and buf_ext-file.file-type <> 'cash-desk':U + chr(3)
      785     and not p-tree
      786     then do:
      787       undo, return error substitute("Нельзя удалить файл БД &1 (от БД &2) &3№ файла &4&3&5 - логи и ответы с касс удаляются ТОЛЬКО вместе с файлом-запросом"
      788                                       , buf_ext-file.db-num
      789                                       , buf_ext-file.from-db-num
      790                                       , chr(10)
      791                                       , buf_ext-file.file-num
      792                                       , buf_ext-file.file-name
      793                                       ).
      794     end.
      795     if p-status_ = '':U
      796     and buf_ext-file.file-type begins "u" then do:
      797       find first buf2_ext-file no-lock where
      798                 buf2_ext-file.db-num = buf_ext-file.db-num
      799            and  buf2_ext-file.from-db-num = buf_ext-file.from-db-num
      800            and  buf2_ext-file.file-name = buf_ext-file.file-type no-error.
      801        if available buf2_ext-file then do:
      802         undo, return error substitute("Нельзя удалить файл БД &1 (от БД &2) &3№ файла &4&3&5" +
      803                                       "Для удаления файлов пакетов обновлений существует специальный режим"
      804                                       , buf_ext-file.db-num
      805                                       , buf_ext-file.from-db-num
      806                                       , chr(10)
      807                                       , buf_ext-file.file-num
      808                                       , buf_ext-file.file-name
      809                                       ).
      810       end.
      811     end.
      812     find first locked_ext-file exclusive-lock where recid(locked_Ext-file) = recid(buf_ext-file).
      813     if locked_Ext-file.file-type = locked_ext-file.file-name then do:
      814       if p-status_ = '':U
      815       and buf_ext-file.file-type begins "u" then do:
      816       for each buf2_ext-file where
      817             buf2_ext-file.db-num = locked_ext-file.db-num
      818         and buf2_ext-file.from-db-num = locked_ext-file.from-db-num
      819         and buf2_ext-file.file-type = locked_ext-file.file-type
      820       on error undo, return error return-value
      821       on stop undo, return error return-value :
      822         for each buf_Ext-file-line where
      823                 buf_Ext-file-line.db-num = locked_Ext-file.db-num
      824             and buf_Ext-file-line.from-db-num = locked_Ext-file.from-db-num
      825             and buf_Ext-file-line.file-num = buf2_Ext-file.file-num
      826         on error undo, return error return-value
      827         on stop undo, return error return-value :
      828             delete buf_Ext-file-line.
      829         end.
      830         for each buf_ext-file-par where
      831                 buf_ext-file-par.db-num = locked_ext-file.db-num
      832             and buf_ext-file-par.from-db-num = locked_ext-file.from-db-num
      833             and buf_ext-file-par.file-num = locked_ext-file.file-num
      834         on error undo, return error return-value
      835         on stop undo, return error return-value :
      836             delete buf_ext-file-par.
      837         end.
      838         end.
      839       end.
      840     end.
      841     if buf_ext-file.file-type = 'cash-desk':U + chr(3) then do:
      842       for each buf_ext-file-par no-lock where
      843               buf_ext-file-par.db-num = buf_ext-file.db-num
      844           and buf_ext-file-par.from-db-num = buf_ext-file.from-db-num
      845           and buf_ext-file-par.file-num = buf_ext-file.file-num
      846       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      847       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      848       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      849       :
      850           if buf_ext-file-par.param-type = 'uniq-key-rec':U
      851           and buf_ext-file-par.param-value begins 'ext-file':U then do:
      852             run gen-row-keyr in this-procedure (
      853                                               input  buf_ext-file-par.param-value
      854                                               ,input  ?
      855                                               ,input  "ub"
      856                                               ,input  ?
      857                                               ,input  EXCLUSIVE-LOCK
      858                                               ,output v-tbl-row
      859                                               ,output v-tbl-name   ) no-error.
      860             if error-status:error then do:
      861               undo main-block, return error substitute("Ошибка при удалении файла БД &1 (от БД &2) &3№ файла &4&3&5 - не найден связанный файл &6"
      862                                                       , buf_ext-file.db-num
      863                                                       , buf_ext-file.from-db-num
      864                                                       , chr(10)
      865                                                       , buf_ext-file.file-num
      866                                                       , buf_ext-file.file-name
      867                                                       , buf_ext-file-par.param-value
      868                                                       ).
      869             end.
      870             if v-tbl-row <> ? then do:
      871             find first tree_ext-file exclusive-lock where
      872                       rowid(tree_ext-file) = v-tbl-row.
      873             run adm/extf-del.p (  buffer tree_ext-file
      874                                 ,input yes
      875                                 ,input p-status_ ) no-error.
      876             if error-status:error then do:
      877               undo main-block, return error substitute("Ошибка при удалении файла БД &1 (от БД &2) &3№ файла &4&3&5 - ошибка при удалении связанного файла &6"
      878                                                       , buf_ext-file.db-num
      879                                                       , buf_ext-file.from-db-num
      880                                                       , chr(10)
      881                                                       , buf_ext-file.file-num
      882                                                       , buf_ext-file.file-name
      883                                                       , buf_ext-file-par.param-value
      884                                                       ).
      885             end.
      886           end.
      887       end.
      888     end.
      889     end.
      890     for each buf_Ext-file-line where
      891             buf_Ext-file-line.db-num = locked_Ext-file.db-num
      892         and buf_Ext-file-line.from-db-num = locked_Ext-file.from-db-num
      893         and buf_Ext-file-line.file-num = locked_Ext-file.file-num
      894     on error undo, return error return-value
      895     on stop undo, return error return-value :
      896       delete buf_Ext-file-line.
      897     end.
      898     for each buf_Ext-file-par where
      899             buf_Ext-file-par.db-num = locked_Ext-file.db-num
      900         and buf_Ext-file-par.from-db-num = locked_Ext-file.from-db-num
      901         and buf_Ext-file-par.file-num = locked_Ext-file.file-num
      902     on error undo, return error return-value
      903     on stop undo, return error return-value :
      904       delete buf_Ext-file-par.
      905     end.
      906     if not (
      907             g#db-num = locked_ext-file.db-num
      908             and
      909             locked_ext-file.db-num = locked_ext-file.from-db-num
      910           )
      911     and not g#news
      912     and not p-tree
      913       then do:
      914         run nws/cmd-del.p
      915           ( input 'ext-file':U
      916           ,input (buffer locked_ext-file:handle)
      917           ,input string(if g#db-num > 0 then 0 else abs(locked_ext-file.db-num))
      918           ) no-error .
      919         if error-status :error then do:
      920           return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
      921         end.
      922       end.
      923     delete buf_Ext-file.
      924   end.
