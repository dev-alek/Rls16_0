        1   define input  parameter parParentProc  as widget-handle no-undo.
        2   define input-output parameter p-company               LIKE ub.user-account.company NO-UNDO.
        3   define input-output parameter p-department            LIKE ub.user-account.department NO-UNDO.
        4   define input-output parameter p-e-mail                LIKE ub.user-account.e-mail NO-UNDO.
        5   define input-output parameter p-first-name            LIKE ub.user-account.first-name NO-UNDO.
        6   define input-output parameter p-internal-phone-number LIKE ub.user-account.internal-phone-number NO-UNDO.
        7   define input-output parameter p-last-name             LIKE ub.user-account.last-name NO-UNDO.
        8   define input-output parameter p-mobile-phone-number   LIKE ub.user-account.mobile-phone-number NO-UNDO.
        9   define input-output parameter p-phone-number          LIKE ub.user-account.phone-number NO-UNDO.
       10   define input-output parameter p-position              LIKE ub.user-account.position NO-UNDO.
       11   define input-output parameter p-room                  LIKE ub.user-account.room NO-UNDO.
       12   define input-output parameter p-second-name           LIKE ub.user-account.second-name NO-UNDO.
       13   define variable vss-revision    as character no-undo init "$Revision$":U .
       14   define variable vss-author      as character no-undo init "$Author$":U .
       15   define variable vss-date        as character no-undo init "$Date$":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       17   define variable vss-archive     as character no-undo init "$Archive$":U .
       18   define variable vss-description as character no-undo init "Редактирование записи пользователь (temp-table)".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   procedure proc-alt-shift-f2:
       78     if not ibs.th.gbl.gbl-var:rcode
       79   then
       80     run gbl\inidebug.p .
       81   end.
       82   procedure proc-alt-shift-f3:
       83     run gbl/prvssinf.p
       84       ( input this-procedure
       85       ) .
       86   end.
       87   define variable v-inform-launched as logical no-undo initial false .
       88   procedure proc-alt-shift-f4:
       89     define variable v-action as character no-undo .
       90     if v-inform-launched = false then do:
       91       assign
       92         v-inform-launched = true
       93       .
       94       run gbl/d-inform.w
       95         (  input self
       96         ,  input this-procedure
       97         , output v-action
       98         ) no-error .
       99       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      100       assign
      101         v-inform-launched = false
      102       .
      103     end.
      104   end.
      105   procedure proc-alt-f1:
      106     run gbl/corrhelp.p
      107       (input this-procedure
      108       ) .
      109   end .
      110   on alt-shift-f2 anywhere do:
      111     run proc-alt-shift-f2.
      112   end.
      113   on alt-shift-f3 anywhere do:
      114     run proc-alt-shift-f3 in this-procedure .
      115   end.
      116   on alt-shift-f4 anywhere do:
      117     run proc-alt-shift-f4 in this-procedure.
      118   end.
      119   on alt-f1 anywhere do:
      120     run proc-alt-f1 in this-procedure .
      121   end.
      122   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      124   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      125   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      126   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      127   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      128   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      129   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      130   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      131   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      132   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      133   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      134   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      135   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      136   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      137   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      138   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      139   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      140   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      141     define variable v-cntxt-db-num        as integer   no-undo .
      142     define variable v-cntxt-userid        as character no-undo .
      143     define variable v-cntxt-level         as character no-undo .
      144     define variable v-cntxt-host-code-obj as integer   no-undo .
      145     define variable v-cntxt-obj-type      as character no-undo .
      146     define variable v-cntxt-obj-code      as integer   no-undo .
      147     define variable v-cntxt-db-num-obj    as integer   no-undo .
      148     define variable v-cntxt-is-admin      as logical   no-undo .
      149   DEFINE BUTTON b-exit AUTO-GO
      150        LABEL "&Ввод"
      151        SIZE 10 BY 1
      152        BGCOLOR 8 .
      153   DEFINE BUTTON b-help
      154        LABEL "Помо&щь"
      155        SIZE 10 BY 1
      156        BGCOLOR 8 .
      157   DEFINE BUTTON b-quit AUTO-END-KEY
      158        LABEL "&Отмена"
      159        SIZE 10 BY 1
      160        BGCOLOR 8 .
      161   DEFINE VARIABLE fi-company LIKE ub.user-account.company
      162        VIEW-AS FILL-IN
      163        SIZE 33 BY 1 NO-UNDO.
      164   DEFINE VARIABLE fi-department LIKE ub.user-account.department
      165        VIEW-AS FILL-IN
      166        SIZE 33 BY 1 NO-UNDO.
      167   DEFINE VARIABLE fi-e-mail LIKE ub.user-account.e-mail
      168        VIEW-AS FILL-IN
      169        SIZE 33 BY 1 NO-UNDO.
      170   DEFINE VARIABLE fi-first-name LIKE ub.user-account.first-name
      171        VIEW-AS FILL-IN
      172        SIZE 33 BY 1 NO-UNDO.
      173   DEFINE VARIABLE fi-internal-phone-number LIKE ub.user-account.internal-phone-number
      174        VIEW-AS FILL-IN
      175        SIZE 33 BY 1 NO-UNDO.
      176   DEFINE VARIABLE fi-last-name LIKE ub.user-account.last-name
      177        VIEW-AS FILL-IN
      178        SIZE 33 BY 1 NO-UNDO.
      179   DEFINE VARIABLE fi-mobile-phone-number LIKE ub.user-account.mobile-phone-number
      180        VIEW-AS FILL-IN
      181        SIZE 33 BY 1 NO-UNDO.
      182   DEFINE VARIABLE fi-phone-number LIKE ub.user-account.phone-number
      183        VIEW-AS FILL-IN
      184        SIZE 33 BY 1 NO-UNDO.
      185   DEFINE VARIABLE fi-position LIKE ub.user-account.position
      186        VIEW-AS FILL-IN
      187        SIZE 33 BY 1 NO-UNDO.
      188   DEFINE VARIABLE fi-room LIKE ub.user-account.room
      189        VIEW-AS FILL-IN
      190        SIZE 33 BY 1 NO-UNDO.
      191   DEFINE VARIABLE fi-second-name LIKE ub.user-account.second-name
      192        VIEW-AS FILL-IN
      193        SIZE 33 BY 1 NO-UNDO.
      194   DEFINE FRAME Dialog-Frame
      195        b-exit AT ROW 1 COL 1
      196        b-quit AT ROW 1 COL 11
      197        b-help AT ROW 1 COL 81
      198        fi-last-name AT ROW 4 COL 22 COLON-ALIGNED HELP
      199             "" WIDGET-ID 4
      200        fi-first-name AT ROW 5.27 COL 22 COLON-ALIGNED HELP
      201             "" WIDGET-ID 10
      202        fi-second-name AT ROW 6.77 COL 22 COLON-ALIGNED HELP
      203             "" WIDGET-ID 8
      204        fi-position AT ROW 8.27 COL 22 COLON-ALIGNED HELP
      205             "" WIDGET-ID 12
      206        fi-room AT ROW 9.77 COL 22 COLON-ALIGNED HELP
      207             "" WIDGET-ID 14
      208        fi-company AT ROW 11 COL 22 COLON-ALIGNED HELP
      209             "" WIDGET-ID 16
      210        fi-department AT ROW 12.27 COL 22 COLON-ALIGNED HELP
      211             "" WIDGET-ID 18
      212        fi-e-mail AT ROW 13.5 COL 22 COLON-ALIGNED HELP
      213             "" WIDGET-ID 20
      214        fi-phone-number AT ROW 14.77 COL 22 COLON-ALIGNED HELP
      215             "" WIDGET-ID 22
      216        fi-internal-phone-number AT ROW 16 COL 22 COLON-ALIGNED HELP
      217             "" WIDGET-ID 24
      218        fi-mobile-phone-number AT ROW 17.5 COL 22 COLON-ALIGNED HELP
      219             "" WIDGET-ID 26
      220        SPACE(34.00) SKIP(0.00)
      221       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      222            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      223            TITLE "Редактирование пользователя"
      224            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit WIDGET-ID 100.
      225   ASSIGN
      226          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      227          FRAME Dialog-Frame:HIDDEN           = TRUE.
      228   ON GO OF FRAME Dialog-Frame
      229   DO:
      230     run update-info in this-procedure
      231       no-error .
      232     if error-status :error
      233     then do:
      234       undo, return no-apply .
      235     end.
      236   END.
      237   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      238   DO:
      239     APPLY "END-ERROR":U TO SELF.
      240   END.
      241   ON LEAVE OF fi-last-name IN FRAME Dialog-Frame
      242   DO:
      243     IF fi-last-name :screen-value = ?
      244     OR fi-last-name :screen-value = '':U
      245     THEN DO:
      246       MESSAGE "Фамилию заполнять обязательно"
      247       VIEW-AS ALERT-BOX.
      248       undo, return no-apply .
      249     END.
      250   END.
      251   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      252   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      253   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      254   on help of frame Dialog-Frame
      255   do:
      256     run gbl/app_help.p
      257       (input this-procedure :file-name
      258       ,input ''
      259       ,input ?
      260       ) no-error.
      261     if error-status :error then do:
      262       message
      263         "Ошибка при вызове помощи"
      264         error-status :get-message(1)
      265         view-as alert-box .
      266     end.
      267   end.
      268   run minbtn-set in this-procedure .
      269   on choose of b-help in frame Dialog-Frame
      270   do:
      271     apply "help":u to frame Dialog-Frame .
      272   end.
      273   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      274   procedure minbtn-set :
      275       do
      276           on error undo, return error return-value
      277           :
      278           define variable ii              as integer       no-undo .
      279           define variable fh              as widget-handle no-undo .
      280           define variable hh              as widget-handle no-undo .
      281           define variable v-h             as handle        extent 4 no-undo .
      282           define variable v-name-button   as character     no-undo .
      283           define variable v-help-old-x    as decimal       no-undo .
      284           define variable v-help-old-y    as decimal       no-undo .
      285           define variable v-help-old-size as decimal       no-undo .
      286           define variable v-frame-width   as decimal       no-undo .
      287           define variable jj              as integer       no-undo .
      288           do
      289               on error undo, return error
      290               :
      291               assign
      292                   v-frame-width = frame Dialog-Frame:width - 0.3
      293                   fh            = frame Dialog-Frame:first-child
      294                   hh            = fh:first-child
      295                   ii            = 1
      296                   .
      297               do while valid-handle(hh):
      298                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      299                   do:
      300                       case lc(hh:name) :
      301                           when "b-help" then
      302                               do:
      303                                   hh:load-image-up("cmp/b-help.bmp":u) .
      304                                   hh:load-image-down("cmp/b-help.bmp":u) .
      305                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      306                                   hh:TOOLTIP = "Помощь" .
      307                                   v-help-old-x = hh:column .
      308                                   v-help-old-y = hh:row    .
      309                                   v-help-old-size = hh:width .
      310                                   hh:width-chars = 2.5 .
      311                               end.
      312                           when "b-print" then
      313                               do:
      314                                   hh:load-image("cmp/b-print.bmp":u) .
      315                                   hh:TOOLTIP = "Печать" .
      316                                   v-h[ii] = hh:handle .
      317                                   ii = ii + 1 .
      318                                   hh:width-chars = 3 .
      319                               end.
      320                           when "b-history" or
      321                           when "b-hist" then
      322                               do:
      323                                   hh:load-image("cmp/b-hist.bmp":u) .
      324                                   hh:TOOLTIP = "История" .
      325                                   v-h[ii] = hh:handle .
      326                                   ii = ii + 1 .
      327                                   hh:width-chars = 3 .
      328                               end.
      329                           when "b-sch" then
      330                               do:
      331                                   hh:load-image("cmp/b-sch.bmp":u) .
      332                                   hh:TOOLTIP = "Установка Фильтра" .
      333                                   v-h[ii] = hh:handle .
      334                                   ii = ii + 1 .
      335                                   hh:width-chars = 3 .
      336                               end.
      337                           when "b-hist-user" then
      338                               do:
      339                                   hh:load-image("cmp/b-hist.bmp":u) .
      340                                   hh:TOOLTIP = "История пользователя" .
      341                                   ii = ii + 1 .
      342                               end.
      343                       end case.
      344                   end.
      345                   hh = hh:next-sibling.
      346               end.
      347               b-help:column = v-frame-width - b-help:width-chars.
      348               jj = 0.
      349               repeat ii = 4 to 1 by -1 :
      350                   if valid-handle (v-h[ii] ) then
      351                   do:
      352                       jj  = jj + 1 .
      353                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      354                       v-h[ii]:row    = v-help-old-y .
      355                   end.
      356               end.
      357           end.
      358       end.
      359   end procedure.
      360   MAIN-BLOCK:
      361   DO ON ERROR   UNDO MAIN-BLOCK, RETURN ERROR
      362      ON END-KEY UNDO MAIN-BLOCK, RETURN ERROR:
      363     RUN enable_UI.
      364     run display-info in this-procedure .
      365     WAIT-FOR GO OF FRAME Dialog-Frame.
      366   END.
      367   RUN disable_UI.
      368   PROCEDURE disable_UI :
      369     HIDE FRAME Dialog-Frame.
      370   END PROCEDURE.
      371   PROCEDURE display-info :
      372     do
      373     with frame Dialog-Frame
      374     on error undo, return error return-value
      375     :
      376        assign
      377          fi-last-name :screen-value             = p-last-name
      378          fi-first-name :screen-value            = p-first-name
      379          fi-second-name :screen-value           = p-second-name
      380          fi-position :screen-value              = p-position
      381          fi-room :screen-value                  = p-room
      382          fi-company :screen-value               = p-company
      383          fi-department :screen-value            = p-department
      384          fi-e-mail :screen-value                = p-e-mail
      385          fi-phone-number :screen-value          = p-phone-number
      386          fi-internal-phone-number :screen-value = p-internal-phone-number
      387          fi-mobile-phone-number :screen-value   = p-mobile-phone-number
      388          fi-last-name             :sensitive = true
      389          fi-last-name             :fgcolor   = black_color
      390          fi-first-name            :sensitive = true
      391          fi-first-name            :fgcolor   = black_color
      392          fi-second-name           :sensitive = true
      393          fi-second-name           :fgcolor   = black_color
      394          fi-position              :sensitive = true
      395          fi-position              :fgcolor   = black_color
      396          fi-room                  :sensitive = true
      397          fi-room                  :fgcolor   = black_color
      398          fi-company               :sensitive = true
      399          fi-company               :fgcolor   = black_color
      400          fi-department            :sensitive = true
      401          fi-department            :fgcolor   = black_color
      402          fi-e-mail                :sensitive = true
      403          fi-e-mail                :fgcolor   = black_color
      404          fi-phone-number          :sensitive = true
      405          fi-phone-number          :fgcolor   = black_color
      406          fi-internal-phone-number :sensitive = true
      407          fi-internal-phone-number :fgcolor   = black_color
      408          fi-mobile-phone-number   :sensitive = true
      409          fi-mobile-phone-number   :fgcolor   = black_color
      410        .
      411     end.
      412   END PROCEDURE.
      413   PROCEDURE enable_UI :
      414     ENABLE b-exit b-quit b-help
      415         WITH FRAME Dialog-Frame.
      416     VIEW FRAME Dialog-Frame.
      417   END PROCEDURE.
      418   PROCEDURE update-info :
      419     do
      420     on error undo, return error return-value
      421     :
      422        do with frame Dialog-Frame
      423        :
      424            assign
      425              p-last-name             = fi-last-name :screen-value
      426              p-first-name            = fi-first-name :screen-value
      427              p-second-name           = fi-second-name :screen-value
      428              p-position              = fi-position :screen-value
      429              p-room                  = fi-room :screen-value
      430              p-company               = fi-company :screen-value
      431              p-department            = fi-department :screen-value
      432              p-e-mail                = fi-e-mail :screen-value
      433              p-phone-number          = fi-phone-number :screen-value
      434              p-internal-phone-number = fi-internal-phone-number :screen-value
      435              p-mobile-phone-number   = fi-mobile-phone-number :screen-value
      436            .
      437        end.
      438     end.
      439   END PROCEDURE.
