        1   CREATE WIDGET-POOL.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Настройки АСПН".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   procedure proc-alt-shift-f2:
       63     if not ibs.th.gbl.gbl-var:rcode
       64   then
       65     run gbl\inidebug.p .
       66   end.
       67   procedure proc-alt-shift-f3:
       68     run gbl/prvssinf.p
       69       ( input this-procedure
       70       ) .
       71   end.
       72   define variable v-inform-launched as logical no-undo initial false .
       73   procedure proc-alt-shift-f4:
       74     define variable v-action as character no-undo .
       75     if v-inform-launched = false then do:
       76       assign
       77         v-inform-launched = true
       78       .
       79       run gbl/d-inform.w
       80         (  input self
       81         ,  input this-procedure
       82         , output v-action
       83         ) no-error .
       84       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       85       assign
       86         v-inform-launched = false
       87       .
       88     end.
       89   end.
       90   procedure proc-alt-f1:
       91     run gbl/corrhelp.p
       92       (input this-procedure
       93       ) .
       94   end .
       95   on alt-shift-f2 anywhere do:
       96     run proc-alt-shift-f2.
       97   end.
       98   on alt-shift-f3 anywhere do:
       99     run proc-alt-shift-f3 in this-procedure .
      100   end.
      101   on alt-shift-f4 anywhere do:
      102     run proc-alt-shift-f4 in this-procedure.
      103   end.
      104   on alt-f1 anywhere do:
      105     run proc-alt-f1 in this-procedure .
      106   end.
      107   DEFINE VARIABLE h_bkp-prop AS HANDLE NO-UNDO.
      108   DEFINE VARIABLE h_folder AS HANDLE NO-UNDO.
      109   DEFINE VARIABLE h_nws-prop AS HANDLE NO-UNDO.
      110   DEFINE VARIABLE h_oxmlprop AS HANDLE NO-UNDO.
      111   DEFINE VARIABLE h_upg-prop AS HANDLE NO-UNDO.
      112   DEFINE BUTTON b-exit AUTO-GO
      113        LABEL "&Выход"
      114        SIZE 10 BY 1
      115        BGCOLOR 8 .
      116   DEFINE BUTTON b-help
      117        LABEL "Помо&щь"
      118        SIZE 10 BY 1
      119        BGCOLOR 8 .
      120   DEFINE FRAME autoprop
      121        b-exit AT ROW 1.17 COL 2
      122        b-help AT ROW 1.17 COL 12
      123        SPACE(53.37) SKIP(10.11)
      124       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      125            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      126            TITLE "Настройки".
      127   ASSIGN
      128          FRAME autoprop:SCROLLABLE       = FALSE
      129          FRAME autoprop:HIDDEN           = TRUE.
      130   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      131   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      132   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      133   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      134   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      135   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      136   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      137   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      138       ASSIGN adm-object-hdl = FRAME autoprop:HANDLE.
      139   RUN ensure-broker.
      140   THIS-PROCEDURE:ADM-DATA =
      141        'ADM1.1~`':U +
      142        'SmartDialog~`':U +
      143        'DIALOG-BOX~`':U +
      144        'NO ~`':U +
      145        '~`':U +
      146        '~`':U +
      147        '~`':U +
      148        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      149           + "~`":U +
      150        'Layout,Hide-on-Init~`':U +
      151        '~`':U +
      152        '~`':U +
      153        '~`~`~`~`~`~`~`~`~`~`~`':U +
      154        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      155            THEN "^^":U
      156        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      157             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      158   PROCEDURE adm-apply-entry :
      159     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      160   END PROCEDURE.
      161   PROCEDURE adm-destroy :
      162    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      163   END PROCEDURE.
      164   PROCEDURE adm-disable :
      165       DISABLE b-exit b-help WITH FRAME autoprop.
      166       RUN dispatch ('disable-fields':U).
      167       RUN set-attribute-list ('ENABLED=no':U).
      168       RETURN.
      169   END PROCEDURE.
      170   PROCEDURE adm-edit-attribute-list :
      171         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
      172         RETURN.
      173   END PROCEDURE.
      174   PROCEDURE adm-enable :
      175       ENABLE UNLESS-HIDDEN b-exit b-help WITH FRAME autoprop.
      176       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      177       RUN set-attribute-list ('ENABLED=yes':U).
      178       RETURN.
      179   END PROCEDURE.
      180   PROCEDURE adm-exit :
      181        RUN notify ('exit':U).
      182     RETURN.
      183   END PROCEDURE.
      184   PROCEDURE adm-hide :
      185     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      186   END PROCEDURE.
      187   PROCEDURE adm-initialize :
      188     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      189   END PROCEDURE.
      190   PROCEDURE adm-show-errors :
      191       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      192       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      193           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      194       END.
      195       RETURN.
      196   END PROCEDURE.
      197   PROCEDURE adm-UIB-mode :
      198     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      199   END PROCEDURE.
      200   PROCEDURE adm-view :
      201     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      202   END PROCEDURE.
      203   PROCEDURE dispatch :
      204       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      205       RUN broker-dispatch IN adm-broker-hdl
      206           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      207       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      208   END PROCEDURE.
      209   PROCEDURE ensure-broker :
      210   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      211   IF RETURN-VALUE NE "ADM-Broker":U THEN
      212   DO:
      213       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      214       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      215   END.
      216   END PROCEDURE.
      217   PROCEDURE get-attribute :
      218     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      219     RUN broker-get-attribute IN adm-broker-hdl
      220         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      221     RETURN RETURN-VALUE.
      222   END PROCEDURE.
      223   PROCEDURE get-attribute-list :
      224     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      225     RUN broker-get-attribute-list IN adm-broker-hdl
      226         (INPUT THIS-PROCEDURE,
      227          INPUT ?,
      228          OUTPUT p-attr-list) NO-ERROR.
      229     RETURN.
      230   END PROCEDURE.
      231   PROCEDURE new-state :
      232     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      233     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      234     RETURN.
      235   END PROCEDURE.
      236   PROCEDURE notify :
      237     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      238     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      239     IF RETURN-VALUE = "ADM-ERROR":U THEN
      240         RETURN "ADM-ERROR":U.
      241     RETURN.
      242   END PROCEDURE.
      243   PROCEDURE set-attribute-list :
      244     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      245     RUN ensure-broker.
      246     RUN broker-set-attribute-list IN adm-broker-hdl
      247         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      248     RETURN.
      249   END PROCEDURE.
      250   PROCEDURE set-position :
      251       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      252       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      253       IF VALID-HANDLE(adm-object-hdl) THEN
      254       DO:
      255           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
      256           IF adm-object-hdl:TYPE = "WINDOW":U THEN
      257           DO:
      258             IF p-row = 0 THEN p-row =
      259               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
      260             IF p-col = 0 THEN p-col =
      261               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
      262           END.
      263           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
      264           DO:
      265             parent-hdl = adm-object-hdl:PARENT.
      266             IF p-row = 0 THEN p-row =
      267               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
      268                 parent-hdl:ROW.
      269             IF p-col = 0 THEN p-col =
      270               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
      271                 parent-hdl:COL.
      272           END.
      273           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
      274           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
      275         ASSIGN adm-object-hdl:ROW    =   p-row
      276                adm-object-hdl:COLUMN =   p-col.
      277       END.
      278       RETURN.
      279   END PROCEDURE.
      280   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
      281       STRING(adm-object-hdl)).
      282   PAUSE 0 BEFORE-HIDE.
      283   PROCEDURE adm-change-page :
      284     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
      285     END PROCEDURE.
      286   PROCEDURE delete-page :
      287     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
      288     RUN broker-delete-page IN adm-broker-hdl
      289         (INPUT THIS-PROCEDURE, INPUT p-page#).
      290     END PROCEDURE.
      291   PROCEDURE init-object :
      292     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
      293     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
      294     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
      295     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
      296     RUN broker-init-object IN adm-broker-hdl
      297         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
      298          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
      299     RETURN.
      300   END PROCEDURE.
      301   PROCEDURE init-pages :
      302     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
      303     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      304         INPUT p-page-list) NO-ERROR.
      305     END PROCEDURE.
      306   PROCEDURE select-page :
      307     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
      308     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      309         INPUT p-page#) NO-ERROR.
      310     END PROCEDURE.
      311   PROCEDURE view-page :
      312     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
      313     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      314         INPUT p-page#).
      315     END PROCEDURE.
      316   ON WINDOW-CLOSE OF FRAME autoprop
      317   DO:
      318     APPLY "END-ERROR":U TO SELF.
      319   END.
      320   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      321   on help of frame autoprop
      322   do:
      323     run gbl/app_help.p
      324       (input this-procedure :file-name
      325       ,input ''
      326       ,input ?
      327       ) no-error.
      328     if error-status :error then do:
      329       message
      330         "Ошибка при вызове помощи"
      331         error-status :get-message(1)
      332         view-as alert-box .
      333     end.
      334   end.
      335   run minbtn-set in this-procedure .
      336   on choose of b-help in frame autoprop
      337   do:
      338     apply "help":u to frame autoprop .
      339   end.
      340   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      341   procedure minbtn-set :
      342       do
      343           on error undo, return error return-value
      344           :
      345           define variable ii              as integer       no-undo .
      346           define variable fh              as widget-handle no-undo .
      347           define variable hh              as widget-handle no-undo .
      348           define variable v-h             as handle        extent 4 no-undo .
      349           define variable v-name-button   as character     no-undo .
      350           define variable v-help-old-x    as decimal       no-undo .
      351           define variable v-help-old-y    as decimal       no-undo .
      352           define variable v-help-old-size as decimal       no-undo .
      353           define variable v-frame-width   as decimal       no-undo .
      354           define variable jj              as integer       no-undo .
      355           do
      356               on error undo, return error
      357               :
      358               assign
      359                   v-frame-width = frame autoprop:width - 0.3
      360                   fh            = frame autoprop:first-child
      361                   hh            = fh:first-child
      362                   ii            = 1
      363                   .
      364               do while valid-handle(hh):
      365                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      366                   do:
      367                       case lc(hh:name) :
      368                           when "b-help" then
      369                               do:
      370                                   hh:load-image-up("cmp/b-help.bmp":u) .
      371                                   hh:load-image-down("cmp/b-help.bmp":u) .
      372                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      373                                   hh:TOOLTIP = "Помощь" .
      374                                   v-help-old-x = hh:column .
      375                                   v-help-old-y = hh:row    .
      376                                   v-help-old-size = hh:width .
      377                                   hh:width-chars = 2.5 .
      378                               end.
      379                           when "b-print" then
      380                               do:
      381                                   hh:load-image("cmp/b-print.bmp":u) .
      382                                   hh:TOOLTIP = "Печать" .
      383                                   v-h[ii] = hh:handle .
      384                                   ii = ii + 1 .
      385                                   hh:width-chars = 3 .
      386                               end.
      387                           when "b-history" or
      388                           when "b-hist" then
      389                               do:
      390                                   hh:load-image("cmp/b-hist.bmp":u) .
      391                                   hh:TOOLTIP = "История" .
      392                                   v-h[ii] = hh:handle .
      393                                   ii = ii + 1 .
      394                                   hh:width-chars = 3 .
      395                               end.
      396                           when "b-sch" then
      397                               do:
      398                                   hh:load-image("cmp/b-sch.bmp":u) .
      399                                   hh:TOOLTIP = "Установка Фильтра" .
      400                                   v-h[ii] = hh:handle .
      401                                   ii = ii + 1 .
      402                                   hh:width-chars = 3 .
      403                               end.
      404                           when "b-hist-user" then
      405                               do:
      406                                   hh:load-image("cmp/b-hist.bmp":u) .
      407                                   hh:TOOLTIP = "История пользователя" .
      408                                   ii = ii + 1 .
      409                               end.
      410                       end case.
      411                   end.
      412                   hh = hh:next-sibling.
      413               end.
      414               b-help:column = v-frame-width - b-help:width-chars.
      415               jj = 0.
      416               repeat ii = 4 to 1 by -1 :
      417                   if valid-handle (v-h[ii] ) then
      418                   do:
      419                       jj  = jj + 1 .
      420                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      421                       v-h[ii]:row    = v-help-old-y .
      422                   end.
      423               end.
      424           end.
      425       end.
      426   end procedure.
      427   IF THIS-PROCEDURE:PERSISTENT THEN DO:
      428       MESSAGE "A SmartDialog is not intended ":U SKIP
      429               "to be run Persistent or to be placed ":U SKIP
      430               "in another SmartObject at UIB design time.":U
      431               VIEW-AS ALERT-BOX ERROR.
      432       RUN disable_UI.
      433       DELETE PROCEDURE THIS-PROCEDURE.
      434       RETURN.
      435   END.
      436   RUN dispatch ('create-objects':U).
      437   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME autoprop:PARENT eq ?
      438   THEN FRAME autoprop:PARENT = ACTIVE-WINDOW.
      439   MAIN-BLOCK:
      440   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      441      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      442     RUN dispatch IN THIS-PROCEDURE ('initialize':U).
      443     WAIT-FOR GO OF FRAME autoprop.
      444   END.
      445   RUN dispatch IN THIS-PROCEDURE ('destroy':U).
      446   PROCEDURE adm-create-objects :
      447     DEFINE VARIABLE adm-current-page  AS INTEGER NO-UNDO.
      448     RUN get-attribute IN THIS-PROCEDURE ('Current-Page':U).
      449     ASSIGN adm-current-page = INTEGER(RETURN-VALUE).
      450     CASE adm-current-page:
      451       WHEN 0 THEN DO:
      452          RUN init-object IN THIS-PROCEDURE (
      453                INPUT  'adm/objects/folder.w':U ,
      454                INPUT  FRAME autoprop:HANDLE ,
      455                INPUT  'FOLDER-LABELS = ':U + 'СПН|Upgrade|Online bkp|OpenXML' + ',
      456                        FOLDER-TAB-TYPE = 1':U ,
      457                OUTPUT h_folder ).
      458          RUN set-position IN h_folder ( 2.38 , 2.00 ) NO-ERROR.
      459          RUN set-size IN h_folder ( 9.58 , 72.38 ) NO-ERROR.
      460          RUN add-link IN adm-broker-hdl ( h_folder , 'Page':U , THIS-PROCEDURE ).
      461       END.
      462       WHEN 1 THEN DO:
      463          RUN init-object IN THIS-PROCEDURE (
      464                INPUT  'nws/nws-prop.w':U ,
      465                INPUT  FRAME autoprop:HANDLE ,
      466                INPUT  'Layout = ,
      467                        Hide-on-Init = no':U ,
      468                OUTPUT h_nws-prop ).
      469          RUN set-position IN h_nws-prop ( 3.63 , 2.75 ) NO-ERROR.
      470       END.
      471       WHEN 2 THEN DO:
      472          RUN init-object IN THIS-PROCEDURE (
      473                INPUT  'adm/upg-prop.w':U ,
      474                INPUT  FRAME autoprop:HANDLE ,
      475                INPUT  'Layout = ':U ,
      476                OUTPUT h_upg-prop ).
      477          RUN set-position IN h_upg-prop ( 3.54 , 2.50 ) NO-ERROR.
      478       END.
      479       WHEN 3 THEN DO:
      480          RUN init-object IN THIS-PROCEDURE (
      481                INPUT  'adm/bkp-prop.w':U ,
      482                INPUT  FRAME autoprop:HANDLE ,
      483                INPUT  'Layout = ':U ,
      484                OUTPUT h_bkp-prop ).
      485          RUN set-position IN h_bkp-prop ( 3.63 , 2.75 ) NO-ERROR.
      486       END.
      487       WHEN 4 THEN DO:
      488          RUN init-object IN THIS-PROCEDURE (
      489                INPUT  'bge/oxmlprop.w':U ,
      490                INPUT  FRAME autoprop:HANDLE ,
      491                INPUT  'Layout = ,
      492                        Hide-on-Init = no':U ,
      493                OUTPUT h_oxmlprop ).
      494          RUN set-position IN h_oxmlprop ( 3.63 , 2.75 ) NO-ERROR.
      495       END.
      496     END CASE.
      497     IF adm-current-page eq 0
      498     THEN RUN select-page IN THIS-PROCEDURE ( 1 ).
      499   END PROCEDURE.
      500   PROCEDURE adm-row-available :
      501     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
      502     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
      503     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
      504     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
      505     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
      506     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
      507     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
      508     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
      509     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
      510     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
      511     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      512     IF adm-updating-record THEN RETURN.
      513     RUN get-attribute ('FIELDS-ENABLED':U).
      514     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
      515     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
      516         OUTPUT link-handle) NO-ERROR.
      517     IF link-handle = "":U THEN
      518         RETURN.
      519     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
      520     IF NUM-ENTRIES(link-handle) > 1 THEN
      521         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
      522             "encountered more than one RECORD-SOURCE.":U SKIP
      523             "The first - ":U record-source-hdl:file-name " - will be used.":U
      524                VIEW-AS ALERT-BOX ERROR.
      525     RUN get-attribute ('Key-Name':U).
      526     key-name = RETURN-VALUE.
      527     IF key-name = "":U THEN key-name = ?.
      528     IF key-name NE ? THEN DO:
      529       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
      530         NO-ERROR.
      531       IF key-value NE ? THEN
      532         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
      533     END.
      534   IF VALID-HANDLE (adm-object-hdl) THEN
      535       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      536   RUN notify IN THIS-PROCEDURE ('row-available':U).
      537   END PROCEDURE.
      538   PROCEDURE disable_UI :
      539     HIDE FRAME autoprop.
      540   END PROCEDURE.
      541   PROCEDURE enable_UI :
      542     ENABLE b-exit b-help
      543         WITH FRAME autoprop.
      544     VIEW FRAME autoprop.
      545   END PROCEDURE.
      546   PROCEDURE send-records :
      547   END PROCEDURE.
      548   PROCEDURE state-changed :
      549     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
      550     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      551   END PROCEDURE.
