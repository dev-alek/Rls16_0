      964   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      965   define variable vss-include-info6 as character format "X(65)" no-undo
      966   initial "@(#)$Workfile$ $Revision$".
      967   define temp-table temp_twowin_items no-undo
      968       field itm-key       as integer
      969       field itmExtKey     as character
      970       field itmName       as character
      971       field itmDesc       as character
      972       field itmSelected   as logical
      973       field selLeft       as logical
      974       field selRight      as logical
      975       index pi is primary unique
      976           itm-key
      977       index ie
      978           itmExtKey
      979   .
      980   define temp-table temp_twowin_itemsSelected no-undo
      981       field its-key   as integer
      982       field itm-key   as integer
      983       field itmExtKey as character
      984       index pi is primary unique
      985           its-key
      986       index im
      987           itm-key
      988   .
      989   define variable v-twowin6-itm-key    as integer      no-undo.
      990   procedure twowin_clear :
      991       define buffer buf_temp_twowin_items        for temp_twowin_items.
      992   do
      993   for buf_temp_twowin_items
      994   on error undo, return error
      995   :
      996       empty temp-table buf_temp_twowin_items.
      997   end.
      998   end procedure.
      999   procedure twowin_add-item :
     1000   define input parameter p-ext-key   as character        no-undo.
     1001   define input parameter p-item-name as character        no-undo.
     1002   define input parameter p-item-desc as character        no-undo.
     1003   define input parameter p-selected  as logical          no-undo.
     1004       define buffer buf_temp_twowin_items        for temp_twowin_items.
     1005   do
     1006   for buf_temp_twowin_items
     1007   on error undo, return error
     1008   :
     1009       assign
     1010           v-twowin6-itm-key = v-twowin6-itm-key + 1
     1011       .
     1012       create temp_twowin_items.
     1013       assign
     1014           temp_twowin_items.itm-key      = v-twowin6-itm-key
     1015           temp_twowin_items.itmExtKey    = p-ext-key
     1016           temp_twowin_items.itmName      = p-item-name
     1017           temp_twowin_items.itmDesc      = p-item-desc
     1018           temp_twowin_items.itmSelected  = p-selected
     1019           temp_twowin_items.selLeft      = no
     1020           temp_twowin_items.selRight     = no
     1021       .
     1022   end.
     1023   end procedure.
     1024   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1025   define new global shared variable g#trdcalib as handle no-undo.
     1026   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1027   procedure cur-time :
     1028      define output parameter p-today as date      no-undo .
     1029      define output parameter p-time  as integer   no-undo .
     1030     do
     1031     on error undo, return error
     1032     :
     1033       define variable v-date1 as date      no-undo .
     1034       define variable v-date2 as date      no-undo .
     1035       define variable v-time  as integer   no-undo .
     1036       assign
     1037         v-date1 = today
     1038         v-time  = time
     1039         v-date2 = today
     1040       .
     1041       if v-date1 <> v-date2
     1042       then do:
     1043         assign
     1044           v-date1 = today
     1045           v-time  = v-time
     1046         .
     1047       end.
     1048       assign
     1049         p-today = v-date1
     1050         p-time  = v-time
     1051       .
     1052     end.
     1053   end.
     1054   function cur-time-date returns character
     1055   :
     1056     return string(today, '99/99/9999':U) .
     1057   end.
     1058   function cur-time-mjd returns decimal
     1059   :
     1060     define variable v-date as date      no-undo .
     1061     define variable v-time as integer   no-undo .
     1062     run cur-time in this-procedure
     1063       (output v-date
     1064       ,output v-time
     1065       ) .
     1066     return integer(v-date) - 2400002 + (v-time / 86400) .
     1067   end.
     1068   function cur-time-get-ending-index returns integer
     1069   (input p-number as integer
     1070   )
     1071   :
     1072     if p-number < 0
     1073     or p-number = ?
     1074     then do:
     1075       return 1 .
     1076     end.
     1077     define variable v-rest as integer   no-undo .
     1078     assign
     1079       p-number = p-number modulo 100
     1080     .
     1081     if p-number < 20
     1082     then do:
     1083       assign
     1084         v-rest = p-number
     1085       .
     1086     end.
     1087     else do:
     1088       assign
     1089         v-rest = p-number modulo 10
     1090       .
     1091     end.
     1092     case v-rest :
     1093       when 1
     1094       then do:
     1095         return 2 .
     1096       end.
     1097       when 2 or
     1098       when 3 or
     1099       when 4
     1100       then do:
     1101         return 3 .
     1102       end.
     1103       otherwise do:
     1104         return 1 .
     1105       end.
     1106     end case .
     1107   end.
     1108   procedure cur-time-mjd-to-date :
     1109      define input  parameter i-mjd-diff as decimal no-undo.
     1110      define output parameter o-Date     as date    no-undo.
     1111      define output parameter o-Time     as integer no-undo.
     1112      define variable v-day-number as integer   no-undo .
     1113      if    i-mjd-diff < 0
     1114         or i-mjd-diff = ?
     1115      then do:
     1116         return "?" .
     1117      end.
     1118      assign
     1119         v-day-number = truncate(i-mjd-diff,0).
     1120         o-Date = date(v-day-number + 2400002).
     1121         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1122     .
     1123   end.
     1124   function cur-time-mjd-to-string returns character
     1125   (input p-mjd-diff as decimal
     1126   )
     1127   :
     1128     define variable v-day-number as integer   no-undo .
     1129     define variable v-seconds    as integer   no-undo .
     1130     define variable v-hour       as integer   no-undo .
     1131     define variable v-min        as integer   no-undo .
     1132     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1133     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1134     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1135     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1136     if p-mjd-diff < 0
     1137     or p-mjd-diff = ?
     1138     then do:
     1139       return "?" .
     1140     end.
     1141     assign
     1142       v-day-number = integer(truncate(p-mjd-diff,0))
     1143       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1144     .
     1145     if v-seconds > 86400
     1146     then do:
     1147       assign
     1148         v-seconds = 86400 - 1
     1149       .
     1150     end.
     1151     if v-seconds < 0
     1152     then do:
     1153       assign
     1154         v-seconds = 0
     1155       .
     1156     end.
     1157     assign
     1158       v-hour = truncate(v-seconds / 3600, 0)
     1159     .
     1160     assign
     1161       v-seconds = v-seconds modulo 3600
     1162     .
     1163     assign
     1164       v-min = truncate(v-seconds / 60, 0)
     1165     .
     1166     assign
     1167       v-seconds = v-seconds modulo 60
     1168     .
     1169     return
     1170         (if v-day-number <> 0
     1171           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1172           else ""
     1173         )
     1174       + (if v-day-number <> 0 or v-hour <> 0
     1175           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1176           else ""
     1177         )
     1178       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1179           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1180           else ""
     1181         )
     1182       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1183       .
     1184   end.
     1185   function cur-time-string returns character
     1186   :
     1187     define variable v-date as date      no-undo .
     1188     define variable v-time as integer   no-undo .
     1189     run cur-time in this-procedure
     1190       (output v-date
     1191       ,output v-time
     1192       ) .
     1193     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1194   end.
     1195   function cur-time-string-sec returns character
     1196   :
     1197     define variable v-date as date      no-undo .
     1198     define variable v-time as integer   no-undo .
     1199     run cur-time in this-procedure
     1200       (output v-date
     1201       ,output v-time
     1202       ) .
     1203     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1204   end.
     1205   function cur-time-custom  returns character
     1206   (input p-prefix as character
     1207   ,input p-date-format as character
     1208   ,input p-delimiter as character
     1209   ,input p-time-format as character
     1210   ,input p-suffix as character
     1211   )
     1212   :
     1213     define variable v-date as date      no-undo .
     1214     define variable v-time as integer   no-undo .
     1215     run cur-time in this-procedure
     1216       (output v-date
     1217       ,output v-time
     1218       ) .
     1219     return
     1220       p-prefix
     1221       + string(v-date, p-date-format)
     1222       + p-delimiter
     1223       + string(v-time, p-time-format)
     1224       + p-suffix
     1225       .
     1226   end.
     1227   function cur-time-print  returns character
     1228   :
     1229     define variable v-date as date      no-undo .
     1230     define variable v-time as integer   no-undo .
     1231     run cur-time in this-procedure
     1232       (output v-date
     1233       ,output v-time
     1234       ) .
     1235     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1236   end.
     1237   function cur-time-datetime returns datetime
     1238   :
     1239     define variable v-char as character no-undo .
     1240     define variable v-datetime as datetime no-undo .
     1241     v-char = cur-time-string().
     1242     v-datetime = datetime(v-char).
     1243     return  v-datetime.
     1244   end.
     1245   function cur-time-string-msec returns character
     1246   :
     1247     define variable v-date as datetime  no-undo .
     1248     v-date = now.
     1249     return string(v-date) .
     1250   end.
     1251   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1252   procedure sys-time_get-sys :
     1253     define output parameter p-year         as integer   no-undo .
     1254     define output parameter p-month        as integer   no-undo .
     1255     define output parameter p-day          as integer   no-undo .
     1256     define output parameter p-hour         as integer   no-undo .
     1257     define output parameter p-minute       as integer   no-undo .
     1258     define output parameter p-second       as integer   no-undo .
     1259     define output parameter p-milliseconds as integer   no-undo .
     1260     define variable v-system-time-structure as memptr    no-undo.
     1261     do
     1262     on error undo, return error return-value
     1263     :
     1264       assign
     1265         set-size(v-system-time-structure) = 16
     1266       .
     1267       run GetSystemTime
     1268         (input  get-pointer-value(v-system-time-structure)
     1269         ) .
     1270       assign
     1271         p-year         = get-short(v-system-time-structure,  1)
     1272         p-month        = get-short(v-system-time-structure,  3)
     1273         p-day          = get-short(v-system-time-structure,  7)
     1274         p-hour         = get-short(v-system-time-structure,  9)
     1275         p-minute       = get-short(v-system-time-structure, 11)
     1276         p-second       = get-short(v-system-time-structure, 13)
     1277         p-milliseconds = get-short(v-system-time-structure, 15)
     1278       .
     1279       assign
     1280         set-size(v-system-time-structure) = 0
     1281       .
     1282     end.
     1283   end procedure.
     1284   procedure sys-time_get-comp-user-name :
     1285     define output parameter p-computer-name as character no-undo .
     1286     define output parameter p-user-name     as character no-undo .
     1287     define output parameter p-process-pid   as integer   no-undo .
     1288     define variable v-return-value  as integer   no-undo .
     1289     define variable v-buffer-length as integer   no-undo .
     1290     define variable v-buffer-memptr as memptr    no-undo .
     1291     do
     1292     on error undo, return error return-value
     1293     :
     1294       assign
     1295         v-buffer-length = 1024
     1296         set-size(v-buffer-memptr) = v-buffer-length + 4
     1297       .
     1298       assign
     1299         put-long(v-buffer-memptr, 1) = v-buffer-length
     1300       .
     1301       run GetComputerNameA
     1302         (input  get-pointer-value(v-buffer-memptr) + 4
     1303         ,input  get-pointer-value(v-buffer-memptr)
     1304         ,output v-return-value
     1305         ) .
     1306       if v-return-value <> 0
     1307       then do:
     1308         assign
     1309           p-computer-name = get-string(v-buffer-memptr, 5)
     1310         .
     1311       end.
     1312       assign
     1313         put-long(v-buffer-memptr, 1) = v-buffer-length
     1314       .
     1315       run GetUserNameA
     1316         (input  get-pointer-value(v-buffer-memptr) + 4
     1317         ,input  get-pointer-value(v-buffer-memptr)
     1318         ,output v-return-value
     1319         ) .
     1320       if v-return-value <> 0
     1321       then do:
     1322         assign
     1323           p-user-name = get-string(v-buffer-memptr, 5)
     1324         .
     1325       end.
     1326       run GetCurrentProcessId
     1327         (output p-process-pid
     1328         ) .
     1329       assign
     1330         set-size(v-buffer-memptr) = 0
     1331       .
     1332     end.
     1333   end procedure.
     1334   procedure sys-time_get-http :
     1335     define output parameter p-http-time as character no-undo .
     1336     define variable v-year         as integer   no-undo .
     1337     define variable v-month        as integer   no-undo .
     1338     define variable v-day-of-week  as integer   no-undo .
     1339     define variable v-day          as integer   no-undo .
     1340     define variable v-hour         as integer   no-undo .
     1341     define variable v-minute       as integer   no-undo .
     1342     define variable v-second       as integer   no-undo .
     1343     define variable v-milliseconds as integer   no-undo .
     1344     do
     1345     on error undo, return error return-value
     1346     :
     1347       run sys-time_get-sys in this-procedure
     1348         (output v-year
     1349         ,output v-month
     1350         ,output v-day
     1351         ,output v-hour
     1352         ,output v-minute
     1353         ,output v-second
     1354         ,output v-milliseconds
     1355         ) .
     1356       assign
     1357         v-day-of-week = weekday(date(v-month, v-day, v-year))
     1358         p-http-time = entry(v-day-of-week, 'Sun,Mon,Tue,Wed,Thu,Fri,Sat')
     1359                     + ', ':u
     1360                     + string(v-day, '99':u)
     1361                     + ' ':u
     1362                     + entry(v-month, 'Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec':u)
     1363                     + ' ':u
     1364                     + string(v-year, '9999':u)
     1365                     + ' ':u
     1366                     + string(v-hour, '99':u)
     1367                     + ':':u
     1368                     + string(v-minute, '99':u)
     1369                     + ':':u
     1370                     + string(v-second, '99':u)
     1371                     + ' ':u
     1372                     + 'GMT':u
     1373       .
     1374     end.
     1375   end procedure.
     1376   procedure sys-time_set-sys :
     1377     define input  parameter p-year         as integer   no-undo .
     1378     define input  parameter p-month        as integer   no-undo .
     1379     define input  parameter p-day          as integer   no-undo .
     1380     define input  parameter p-hour         as integer   no-undo .
     1381     define input  parameter p-minute       as integer   no-undo .
     1382     define input  parameter p-second       as integer   no-undo .
     1383     define input  parameter p-milliseconds as integer   no-undo .
     1384     define variable v-system-time-structure as memptr    no-undo.
     1385     define variable v-return-value as integer   no-undo .
     1386     define variable v-day-of-week  as integer   no-undo .
     1387     do
     1388     on error undo, return error return-value
     1389     :
     1390       assign
     1391         v-day-of-week = weekday(date(p-month, p-day, p-year))
     1392       .
     1393       assign
     1394         set-size(v-system-time-structure) = 16
     1395       .
     1396       assign
     1397         put-short(v-system-time-structure,  1) = p-year
     1398         put-short(v-system-time-structure,  3) = p-month
     1399         put-short(v-system-time-structure,  5) = v-day-of-week
     1400         put-short(v-system-time-structure,  7) = p-day
     1401         put-short(v-system-time-structure,  9) = p-hour
     1402         put-short(v-system-time-structure, 11) = p-minute
     1403         put-short(v-system-time-structure, 13) = p-second
     1404         put-short(v-system-time-structure, 15) = p-milliseconds
     1405       .
     1406       run SetSystemTime
     1407         (input  get-pointer-value(v-system-time-structure)
     1408         ,output v-return-value
     1409         ) .
     1410       assign
     1411         set-size(v-system-time-structure) = 0
     1412       .
     1413       if v-return-value = 0
     1414       then do:
     1415         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
     1416       end.
     1417     end.
     1418   end procedure.
     1419   procedure sys-time_sys-to-mjd :
     1420     define input  parameter p-year         as integer   no-undo .
     1421     define input  parameter p-month        as integer   no-undo .
     1422     define input  parameter p-day          as integer   no-undo .
     1423     define input  parameter p-hour         as integer   no-undo .
     1424     define input  parameter p-minute       as integer   no-undo .
     1425     define input  parameter p-second       as integer   no-undo .
     1426     define input  parameter p-milliseconds as integer   no-undo .
     1427     define output parameter p-mjd          as decimal   no-undo .
     1428     define variable v-year-correction as decimal   no-undo .
     1429     define variable v-shift-year as decimal   no-undo .
     1430     do
     1431     on error undo, return error return-value
     1432     :
     1433       assign
     1434         v-year-correction = truncate((decimal(p-month) - 14.0) / 12, 0)
     1435         v-shift-year      = decimal(p-year) + v-year-correction
     1436         p-mjd = truncate( (1461.0 * (v-shift-year + 4800.0 ) ) / 4, 0)
     1437               + truncate( (367.0 * (decimal(p-month) - 2.0 - v-year-correction * 12) ) / 12, 0)
     1438               - truncate( (3 * truncate((v-shift-year + 4900 ) / 100,0) ) / 4, 0)
     1439               + decimal(p-day) - 2432076.0
     1440               + p-hour / 24.0
     1441               + p-minute / 1440.0
     1442               + p-second / 86400.0
     1443               + p-milliseconds / 86400000.0
     1444       .
     1445     end.
     1446   end procedure.
     1447   procedure sys-time_sys-to-loc :
     1448     define input  parameter p-sys-year         as integer   no-undo .
     1449     define input  parameter p-sys-month        as integer   no-undo .
     1450     define input  parameter p-sys-day          as integer   no-undo .
     1451     define input  parameter p-sys-hour         as integer   no-undo .
     1452     define input  parameter p-sys-minute       as integer   no-undo .
     1453     define input  parameter p-sys-second       as integer   no-undo .
     1454     define input  parameter p-sys-milliseconds as integer   no-undo .
     1455     define output parameter p-loc-year         as integer   no-undo .
     1456     define output parameter p-loc-month        as integer   no-undo .
     1457     define output parameter p-loc-day          as integer   no-undo .
     1458     define output parameter p-loc-hour         as integer   no-undo .
     1459     define output parameter p-loc-minute       as integer   no-undo .
     1460     define output parameter p-loc-second       as integer   no-undo .
     1461     define output parameter p-loc-milliseconds as integer   no-undo .
     1462     define variable v-system-time-structure as memptr    no-undo.
     1463     define variable v-return-value          as integer   no-undo .
     1464     define variable v-sys-day-of-week       as integer   no-undo .
     1465     do
     1466     on error undo, return error return-value
     1467     :
     1468       assign
     1469         v-sys-day-of-week = weekday(date(p-sys-month, p-sys-day, p-sys-year))
     1470       .
     1471       assign
     1472         set-size(v-system-time-structure) = 32
     1473       .
     1474       assign
     1475         put-short(v-system-time-structure,  1) = p-sys-year
     1476         put-short(v-system-time-structure,  3) = p-sys-month
     1477         put-short(v-system-time-structure,  5) = v-sys-day-of-week
     1478         put-short(v-system-time-structure,  7) = p-sys-day
     1479         put-short(v-system-time-structure,  9) = p-sys-hour
     1480         put-short(v-system-time-structure, 11) = p-sys-minute
     1481         put-short(v-system-time-structure, 13) = p-sys-second
     1482         put-short(v-system-time-structure, 15) = p-sys-milliseconds
     1483       .
     1484       run SystemTimeToTzSpecificLocalTime
     1485         (input  0
     1486         ,input  get-pointer-value(v-system-time-structure)
     1487         ,input  get-pointer-value(v-system-time-structure) + 16
     1488         ,output v-return-value
     1489         ) .
     1490       assign
     1491         p-loc-year         = get-short(v-system-time-structure,  1 + 16)
     1492         p-loc-month        = get-short(v-system-time-structure,  3 + 16)
     1493         p-loc-day          = get-short(v-system-time-structure,  7 + 16)
     1494         p-loc-hour         = get-short(v-system-time-structure,  9 + 16)
     1495         p-loc-minute       = get-short(v-system-time-structure, 11 + 16)
     1496         p-loc-second       = get-short(v-system-time-structure, 13 + 16)
     1497         p-loc-milliseconds = get-short(v-system-time-structure, 15 + 16)
     1498       .
     1499       assign
     1500         set-size(v-system-time-structure) = 0
     1501       .
     1502       if v-return-value = 0
     1503       then do:
     1504         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
     1505       end.
     1506     end.
     1507   end procedure.
     1508   procedure sys-time_mjd-to-sys :
     1509     define input  parameter p-mjd          as decimal   no-undo .
     1510     define output parameter p-year         as integer   no-undo .
     1511     define output parameter p-month        as integer   no-undo .
     1512     define output parameter p-day          as integer   no-undo .
     1513     define output parameter p-hour         as integer   no-undo .
     1514     define output parameter p-minute       as integer   no-undo .
     1515     define output parameter p-second       as integer   no-undo .
     1516     define output parameter p-milliseconds as integer   no-undo .
     1517     define variable v-year-correction as decimal   no-undo .
     1518     define variable v-shift-year      as decimal   no-undo .
     1519     define variable v-conv-date     as date      no-undo .
     1520     define variable v-int-part      as integer   no-undo .
     1521     define variable v-fraction-part as decimal   no-undo .
     1522     do
     1523     on error undo, return error return-value
     1524     :
     1525       assign
     1526         v-int-part      = integer(truncate(p-mjd, 0))
     1527         v-fraction-part = p-mjd - v-int-part
     1528         v-conv-date     = date(11, 17, 1858) + v-int-part
     1529         p-year          = year(v-conv-date)
     1530         p-month         = month(v-conv-date)
     1531         p-day           = day(v-conv-date)
     1532         v-fraction-part = v-fraction-part * 24.0
     1533         p-hour          = integer(truncate(v-fraction-part, 0))
     1534         v-fraction-part = (v-fraction-part - p-hour) * 60.0
     1535         p-minute        = integer(truncate(v-fraction-part, 0))
     1536         v-fraction-part = (v-fraction-part - p-minute) * 60.0
     1537         p-second        = integer(truncate(v-fraction-part, 0))
     1538         v-fraction-part = (v-fraction-part - p-second) * 1000.0
     1539         p-milliseconds  = integer(v-fraction-part)
     1540       .
     1541     end.
     1542   end procedure.
     1543   procedure sys-time_mjd-to-loc :
     1544     define input  parameter p-mjd              as decimal   no-undo .
     1545     define output parameter p-loc-year         as integer   no-undo .
     1546     define output parameter p-loc-month        as integer   no-undo .
     1547     define output parameter p-loc-day          as integer   no-undo .
     1548     define output parameter p-loc-hour         as integer   no-undo .
     1549     define output parameter p-loc-minute       as integer   no-undo .
     1550     define output parameter p-loc-second       as integer   no-undo .
     1551     define output parameter p-loc-milliseconds as integer   no-undo .
     1552     define variable v-sys-year         as integer   no-undo .
     1553     define variable v-sys-month        as integer   no-undo .
     1554     define variable v-sys-day          as integer   no-undo .
     1555     define variable v-sys-hour         as integer   no-undo .
     1556     define variable v-sys-minute       as integer   no-undo .
     1557     define variable v-sys-second       as integer   no-undo .
     1558     define variable v-sys-milliseconds as integer   no-undo .
     1559     do
     1560     on error undo, return error return-value
     1561     :
     1562       run sys-time_mjd-to-sys
     1563         (input  p-mjd
     1564         ,output v-sys-year
     1565         ,output v-sys-month
     1566         ,output v-sys-day
     1567         ,output v-sys-hour
     1568         ,output v-sys-minute
     1569         ,output v-sys-second
     1570         ,output v-sys-milliseconds
     1571         ) .
     1572       run sys-time_sys-to-loc
     1573         (input  v-sys-year
     1574         ,input  v-sys-month
     1575         ,input  v-sys-day
     1576         ,input  v-sys-hour
     1577         ,input  v-sys-minute
     1578         ,input  v-sys-second
     1579         ,input  v-sys-milliseconds
     1580         ,output p-loc-year
     1581         ,output p-loc-month
     1582         ,output p-loc-day
     1583         ,output p-loc-hour
     1584         ,output p-loc-minute
     1585         ,output p-loc-second
     1586         ,output p-loc-milliseconds
     1587         ) .
     1588     end.
     1589   end procedure.
     1590   function sys-time_get-mjd-func returns decimal
     1591   :
     1592     define variable v-year         as integer   no-undo .
     1593     define variable v-month        as integer   no-undo .
     1594     define variable v-day          as integer   no-undo .
     1595     define variable v-hour         as integer   no-undo .
     1596     define variable v-minute       as integer   no-undo .
     1597     define variable v-second       as integer   no-undo .
     1598     define variable v-milliseconds as integer   no-undo .
     1599     define variable v-mjd          as decimal   no-undo .
     1600     run sys-time_get-sys in this-procedure
     1601       (output v-year
     1602       ,output v-month
     1603       ,output v-day
     1604       ,output v-hour
     1605       ,output v-minute
     1606       ,output v-second
     1607       ,output v-milliseconds
     1608       ) .
     1609     run sys-time_sys-to-mjd in this-procedure
     1610       (input  v-year
     1611       ,input  v-month
     1612       ,input  v-day
     1613       ,input  v-hour
     1614       ,input  v-minute
     1615       ,input  v-second
     1616       ,input  v-milliseconds
     1617       ,output v-mjd
     1618       ) .
     1619     return v-mjd .
     1620   end function .
     1621   function sys-time_get-sys-str-func returns character
     1622   :
     1623     define variable v-utc-time as character no-undo .
     1624     define variable v-year         as integer   no-undo .
     1625     define variable v-month        as integer   no-undo .
     1626     define variable v-day          as integer   no-undo .
     1627     define variable v-hour         as integer   no-undo .
     1628     define variable v-minute       as integer   no-undo .
     1629     define variable v-second       as integer   no-undo .
     1630     define variable v-milliseconds as integer   no-undo .
     1631     run sys-time_get-sys in this-procedure
     1632       (output v-year
     1633       ,output v-month
     1634       ,output v-day
     1635       ,output v-hour
     1636       ,output v-minute
     1637       ,output v-second
     1638       ,output v-milliseconds
     1639       ) .
     1640     assign
     1641       v-utc-time  = 'UTC ':u
     1642                   + string(v-year,         '9999':u)
     1643                   + '/':u
     1644                   + string(v-month,        '99':u)
     1645                   + '/':u
     1646                   + string(v-day,          '99':u)
     1647                   + ' ':u
     1648                   + string(v-hour,         '99':u)
     1649                   + ':':u
     1650                   + string(v-minute,       '99':u)
     1651                   + ':':u
     1652                   + string(v-second,       '99':u)
     1653                   + ' ':u
     1654                   + string(v-milliseconds, '999':u)
     1655     .
     1656     return v-utc-time.
     1657   end function .
     1658   function sys-time_mjd-to-loc-str-func returns character
     1659     (v-sys-mjd as decimal)
     1660   :
     1661     define variable v-loc-str          as character no-undo .
     1662     define variable v-loc-year         as integer   no-undo .
     1663     define variable v-loc-month        as integer   no-undo .
     1664     define variable v-loc-day          as integer   no-undo .
     1665     define variable v-loc-hour         as integer   no-undo .
     1666     define variable v-loc-minute       as integer   no-undo .
     1667     define variable v-loc-second       as integer   no-undo .
     1668     define variable v-loc-milliseconds as integer   no-undo .
     1669     run sys-time_mjd-to-loc in this-procedure
     1670       (input  v-sys-mjd
     1671       ,output v-loc-year
     1672       ,output v-loc-month
     1673       ,output v-loc-day
     1674       ,output v-loc-hour
     1675       ,output v-loc-minute
     1676       ,output v-loc-second
     1677       ,output v-loc-milliseconds
     1678       ) .
     1679     assign
     1680       v-loc-str = substitute('&1/&2/&3 &4:&5'
     1681                             ,string(v-loc-day,    '99':U)
     1682                             ,string(v-loc-month,  '99':U)
     1683                             ,string(v-loc-year,   '9999':U)
     1684                             ,string(v-loc-hour,   '99':U)
     1685                             ,string(v-loc-minute, '99':U)
     1686                             )
     1687     .
     1688     return v-loc-str .
     1689   end function .
