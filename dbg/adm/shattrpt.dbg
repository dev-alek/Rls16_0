      903   define variable v-inform-launched as logical no-undo initial false .
      904   procedure proc-alt-shift-f4:
      905     define variable v-action as character no-undo .
      906     if v-inform-launched = false then do:
      907       assign
      908         v-inform-launched = true
      909       .
      910       run gbl/d-inform.w
      911         (  input self
      912         ,  input this-procedure
      913         , output v-action
      914         ) no-error .
      915       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      916       assign
      917         v-inform-launched = false
      918       .
      919     end.
      920   end.
      921   procedure proc-alt-f1:
      922     run gbl/corrhelp.p
      923       (input this-procedure
      924       ) .
      925   end .
      926   on alt-shift-f2 anywhere do:
      927     run proc-alt-shift-f2.
      928   end.
      929   on alt-shift-f3 anywhere do:
      930     run proc-alt-shift-f3 in this-procedure .
      931   end.
      932   on alt-shift-f4 anywhere do:
      933     run proc-alt-shift-f4 in this-procedure.
      934   end.
      935   on alt-f1 anywhere do:
      936     run proc-alt-f1 in this-procedure .
      937   end.
      938   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      939     define variable v-cntxt-db-num        as integer   no-undo .
      940     define variable v-cntxt-userid        as character no-undo .
      941     define variable v-cntxt-level         as character no-undo .
      942     define variable v-cntxt-host-code-obj as integer   no-undo .
      943     define variable v-cntxt-obj-type      as character no-undo .
      944     define variable v-cntxt-obj-code      as integer   no-undo .
      945     define variable v-cntxt-db-num-obj    as integer   no-undo .
      946     define variable v-cntxt-is-admin      as logical   no-undo .
      947   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      948   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      949   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      950   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
