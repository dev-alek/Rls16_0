     2054        "л." VIEW-AS TEXT
     2055             SIZE 2.5 BY 1 AT ROW 32.58 COL 56 WIDGET-ID 10
     2056        RECT-1 AT ROW 20 COL 2.5 WIDGET-ID 38
     2057        RECT-2 AT ROW 13.5 COL 2.5 WIDGET-ID 64
     2058        RECT-3 AT ROW 6.08 COL 2.5 WIDGET-ID 66
     2059        RECT-4 AT ROW 23.5 COL 2.5 WIDGET-ID 84
     2060        RECT-5 AT ROW 28.5 COL 2.63 WIDGET-ID 500
     2061        RECT-6 AT ROW 28.5 COL 59 WIDGET-ID 502
     2062        RECT-7 AT ROW 31 COL 2.63 WIDGET-ID 612
     2063        SPACE(40.86) SKIP(8.13)
     2064       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2065            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2066            TITLE "Настройки работы с ТОПЛИВНЫМ товаром" WIDGET-ID 100.
     2067   ASSIGN
     2068          FRAME shattrpt:SCROLLABLE       = FALSE.
     2069   ASSIGN
     2070          dop-info:HIDDEN IN FRAME shattrpt           = TRUE
     2071          dop-info:READ-ONLY IN FRAME shattrpt        = TRUE.
     2072   ASSIGN
     2073          f-invclipt-name:READ-ONLY IN FRAME shattrpt        = TRUE.
     2074   ASSIGN
     2075          sec-fields:READ-ONLY IN FRAME shattrpt        = TRUE.
     2076   ON WINDOW-CLOSE OF FRAME shattrpt
     2077   DO:
     2078     APPLY "END-ERROR":U TO SELF.
     2079   END.
     2080   ON CHOOSE OF B-exit IN FRAME shattrpt
     2081   DO:
     2082     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
     2083     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     2084   END.
     2085   ON CHOOSE OF b-invclipt IN FRAME shattrpt
     2086   DO:
     2087     define variable rid-list as character no-undo .
     2088     define buffer buf_clients for ub.clients.
     2089       run ref/cli-all.w
     2090         ( input parParentProc
     2091         , input "b-sel"
     2092         , input 'орг':U
     2093         , input 'все':U
     2094         , input 'текущие':U
     2095         , input ?
     2096         , input "yes,yes,yes,,,,ИЛИ"
     2097         , input "lock-cli-type":U
     2098         , output rid-list
     2099         ) .
     2100       find first buf_clients no-lock
     2101         where recid(buf_clients) = integer( rid-list )
     2102         no-error.
     2103       if available buf_clients then do:
     2104         assign
     2105           f-invclipt      = buf_clients.obj-code
     2106           f-invclipt-name = buf_clients.obj-name
     2107         .
     2108       end.
     2109       else do:
     2110         assign
     2111           f-invclipt      = ?
     2112           f-invclipt-name = "":U
     2113         .
     2114       end.
     2115       display
     2116         f-invclipt
     2117         f-invclipt-name
     2118         with frame shattrpt .
     2119   END.
     2120   ON CHOOSE OF B-set_dop-info IN FRAME shattrpt
     2121   DO:
     2122     run select-dop-info in this-procedure.
     2123   END.
     2124   ON CHOOSE OF B-set_sec-fields IN FRAME shattrpt
     2125   DO:
     2126     run select-sec-fields in this-procedure.
     2127   END.
     2128   ON LEAVE OF otkl-density IN FRAME shattrpt
     2129   DO:
     2130     assign
     2131     otkl-density no-error  .
     2132     if error-status:error or decimal (otkl-density) > 1 then do:
     2133       message "Формат поля должен быть: Больше единицы и три знака после запятой"
     2134       view-as alert-box.
     2135       RETURN NO-APPLY.
     2136     end.
     2137   END.
     2138   ON LEAVE OF otkl-fact-volue IN FRAME shattrpt
     2139   DO:
     2140     assign
     2141     otkl-fact-volue
     2142     .
     2143   END.
     2144   ON LEAVE OF otkl-temp IN FRAME shattrpt
     2145   DO:
     2146     assign
     2147     otkl-temp
     2148     .
     2149   END.
     2150   ON LEAVE OF otkl-water IN FRAME shattrpt
     2151   DO:
     2152     assign
     2153     otkl-water
     2154     .
     2155   END.
     2156   ON VALUE-CHANGED OF t-block-nozzle IN FRAME shattrpt
     2157   DO:
     2158     assign t-block-nozzle .
     2159   END.
     2160   ON VALUE-CHANGED OF t-invclipt IN FRAME shattrpt
     2161   DO:
     2162     assign
     2163       t-invclipt
     2164     .
     2165     if t-invclipt = true then do:
     2166       enable
     2167         f-invclipt
     2168         b-invclipt
     2169         with frame shattrpt .
     2170       display
     2171         f-invclipt-name
     2172         with frame shattrpt .
     2173     end.
     2174     else do:
     2175       assign
     2176         f-invclipt       = ?
     2177         f-invclipt-name = "":U
     2178       .
     2179       display
     2180         f-invclipt
     2181         f-invclipt-name
     2182         with frame shattrpt .
     2183       hide
     2184         f-invclipt
     2185         b-invclipt
     2186         f-invclipt
     2187         in frame shattrpt .
     2188     end.
     2189   END.
     2190   ON LEAVE OF timeout-block-nozzle IN FRAME shattrpt
     2191   DO:
     2192     assign timeout-block-nozzle .
     2193   END.
     2194   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME shattrpt:PARENT eq ?
     2195   THEN FRAME shattrpt:PARENT = ACTIVE-WINDOW.
     2196   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2197   on help of frame shattrpt
     2198   do:
     2199     run gbl/app_help.p
     2200       (input this-procedure :file-name
     2201       ,input ''
     2202       ,input ?
     2203       ) no-error.
     2204     if error-status :error then do:
     2205       message
     2206         "Ошибка при вызове помощи"
     2207         error-status :get-message(1)
     2208         view-as alert-box .
     2209     end.
     2210   end.
     2211   run minbtn-set in this-procedure .
     2212   on choose of b-help in frame shattrpt
     2213   do:
     2214     apply "help":u to frame shattrpt .
     2215   end.
     2216   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2217   procedure minbtn-set :
     2218       do
     2219           on error undo, return error return-value
     2220           :
     2221           define variable ii              as integer       no-undo .
     2222           define variable fh              as widget-handle no-undo .
     2223           define variable hh              as widget-handle no-undo .
     2224           define variable v-h             as handle        extent 4 no-undo .
     2225           define variable v-name-button   as character     no-undo .
     2226           define variable v-help-old-x    as decimal       no-undo .
     2227           define variable v-help-old-y    as decimal       no-undo .
     2228           define variable v-help-old-size as decimal       no-undo .
     2229           define variable v-frame-width   as decimal       no-undo .
     2230           define variable jj              as integer       no-undo .
     2231           do
     2232               on error undo, return error
     2233               :
     2234               assign
     2235                   v-frame-width = frame shattrpt:width - 0.3
     2236                   fh            = frame shattrpt:first-child
     2237                   hh            = fh:first-child
     2238                   ii            = 1
     2239                   .
     2240               do while valid-handle(hh):
     2241                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2242                   do:
     2243                       case lc(hh:name) :
     2244                           when "b-help" then
     2245                               do:
     2246                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2247                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2248                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2249                                   hh:TOOLTIP = "Помощь" .
     2250                                   v-help-old-x = hh:column .
     2251                                   v-help-old-y = hh:row    .
     2252                                   v-help-old-size = hh:width .
     2253                                   hh:width-chars = 2.5 .
     2254                               end.
     2255                           when "b-print" then
     2256                               do:
     2257                                   hh:load-image("cmp/b-print.bmp":u) .
     2258                                   hh:TOOLTIP = "Печать" .
     2259                                   v-h[ii] = hh:handle .
     2260                                   ii = ii + 1 .
     2261                                   hh:width-chars = 3 .
     2262                               end.
     2263                           when "b-history" or
     2264                           when "b-hist" then
     2265                               do:
     2266                                   hh:load-image("cmp/b-hist.bmp":u) .
     2267                                   hh:TOOLTIP = "История" .
     2268                                   v-h[ii] = hh:handle .
     2269                                   ii = ii + 1 .
     2270                                   hh:width-chars = 3 .
     2271                               end.
     2272                           when "b-sch" then
     2273                               do:
     2274                                   hh:load-image("cmp/b-sch.bmp":u) .
     2275                                   hh:TOOLTIP = "Установка Фильтра" .
     2276                                   v-h[ii] = hh:handle .
     2277                                   ii = ii + 1 .
     2278                                   hh:width-chars = 3 .
     2279                               end.
     2280                           when "b-hist-user" then
     2281                               do:
     2282                                   hh:load-image("cmp/b-hist.bmp":u) .
     2283                                   hh:TOOLTIP = "История пользователя" .
     2284                                   ii = ii + 1 .
     2285                               end.
     2286                       end case.
     2287                   end.
     2288                   hh = hh:next-sibling.
     2289               end.
     2290               b-help:column = v-frame-width - b-help:width-chars.
     2291               jj = 0.
     2292               repeat ii = 4 to 1 by -1 :
     2293                   if valid-handle (v-h[ii] ) then
     2294                   do:
     2295                       jj  = jj + 1 .
     2296                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2297                       v-h[ii]:row    = v-help-old-y .
     2298                   end.
     2299               end.
     2300           end.
     2301       end.
     2302   end procedure.
     2303   MAIN-BLOCK:
     2304   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2305      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2306     define buffer buf_shop    for ub.shop .
     2307     define buffer buf_store   for ub.store .
     2308     define buffer buf_sysconf for ub.sysconf .
     2309     define buffer buf_clients for ub.clients .
     2310   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2311     run mainmenu_getcntxt in parparentproc
     2312       (output v-cntxt-db-num
     2313       ,output v-cntxt-userid
     2314       ,output v-cntxt-level
     2315       ,output v-cntxt-host-code-obj
     2316       ,output v-cntxt-obj-type
     2317       ,output v-cntxt-obj-code
     2318       ,output v-cntxt-db-num-obj
     2319       ,output v-cntxt-is-admin
     2320       ) .
     2321     if p-mode <> 'ПРОСМОТР':U
     2322       and p-mode <> 'ИЗМЕНЕНИЕ':U
     2323     then do:
     2324       message
     2325       vss-workfile vss-revision vss-description skip
     2326       "Неверное значение параметра p-mode" p-mode
     2327       view-as alert-box error.
     2328       undo, return error.
     2329     end.
     2330     if p-obj-type <> 'маг':U
     2331       and p-obj-type <> 'скл':U
     2332       and p-obj-type <> 'орг':U
     2333       and p-obj-type <> '':U
     2334     then do:
     2335         message
     2336           vss-workfile vss-revision vss-description skip
     2337           "Неверное значение параметра p-obj-type" p-obj-type
     2338           view-as alert-box error.
     2339         undo, return error.
     2340     end.
     2341     case p-obj-type :
     2342       when 'маг':U then do:
     2343         find first buf_shop no-lock
     2344           where buf_shop.obj-code = p-obj-code
     2345           no-error.
     2346         if not available buf_shop then do:
     2347           message
     2348             vss-workfile vss-revision vss-description skip
     2349             substitute( "Неверное значение параметра p-obj-code" ) skip
     2350             substitute( "Магазин с кодом &1 не найден", p-obj-code ) skip
     2351             view-as alert-box error.
     2352           undo, return error.
     2353         end.
     2354       end.
     2355       when 'скл':U then do:
     2356         find first buf_store no-lock
     2357           where buf_store.obj-code = p-obj-code
     2358           no-error.
     2359         if not available buf_store then do:
     2360           message
     2361             vss-workfile vss-revision vss-description skip
     2362             substitute( "Неверное значение параметра p-obj-code" ) skip
     2363             substitute( "Склад с кодом &1 не найден", p-obj-code ) skip
     2364             view-as alert-box error.
     2365           undo, return error.
     2366         end.
     2367       end.
     2368       when 'орг':U then do:
     2369         find first buf_sysconf no-lock
     2370           where buf_sysconf.host-code = p-obj-code
     2371           no-error.
     2372         if not available buf_sysconf then do:
     2373           message
     2374             vss-workfile vss-revision vss-description skip
     2375             substitute( "Неверное значение параметра p-obj-code" ) skip
     2376             substitute( "Фирма с кодом &1 не найдена", p-obj-code ) skip
     2377             view-as alert-box error.
     2378           undo, return error.
     2379         end.
     2380       end.
     2381     end case.
     2382     if p-mode <> 'ПРОСМОТР':U
     2383       and v-cntxt-db-num <> 0
     2384     then do:
     2385       case trim( p-obj-type ) :
     2386         when '':U then do:
     2387           message
     2388             "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" Skip
     2389             view-as alert-box error.
     2390           undo, return error.
     2391         end.
     2392         when 'маг':U
     2393         or when 'скл':U
     2394         then do:
     2395   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2396   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2397     (input  p-obj-type
     2398     ,input  p-obj-code
     2399     ,output v-db-num
     2400     )  .
     2401           if v-db-num <> v-cntxt-db-num then do:
     2402             message
     2403               "Нельзя менять параметры объекта в чужой БД" skip
     2404               "объект принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     2405               view-as alert-box error.
     2406             undo, return error.
     2407           end.
     2408         end.
     2409         when 'орг':U then do:
     2410           message
     2411             "Нельзя менять параметры ФИРМЫ в УБД" Skip
     2412             view-as alert-box error.
     2413           undo, return error.
     2414         end.
     2415       end case.
     2416     end.
     2417     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     2418       find first locked_thbj-attr exclusive-lock
     2419         where locked_thbj-attr.obj-type = p-obj-type
     2420           and locked_thbj-attr.obj-code = p-obj-code
     2421           and locked_thbj-attr.upper-prop-code = 'petrol':U
     2422           and locked_thbj-attr.prop-code = "":u
     2423       no-wait no-error.
     2424       if locked locked_thbj-attr then do:
     2425         message
     2426           vss-workfile vss-revision vss-description skip
     2427           "Запись ПАРАМЕТРЫ(АТРИБУТЫ) занята"
     2428         view-as alert-box error .
     2429         undo, return error.
     2430       end.
     2431     end.
     2432     else do:
     2433       find first locked_thbj-attr no-lock
     2434         where locked_thbj-attr.obj-type = p-obj-type
     2435           and locked_thbj-attr.obj-code = p-obj-code
     2436           and locked_thbj-attr.upper-prop-code = 'petrol':U
     2437           and locked_thbj-attr.prop-code = '':u
     2438         no-error.
     2439     end.
     2440     if not available locked_thbj-attr then do:
     2441       assign
     2442         v-to-create  = yes
     2443       .
     2444       message
     2445         substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ", chr(10) )
     2446       view-as alert-box WARNING.
     2447     end.
     2448     assign
     2449       v-tth = buffer thbjattr_thbj-attr:table-handle
     2450     .
     2451     run fill-widgets in this-procedure no-error.
     2452     if error-status:error then undo, return error.
     2453     find first buf_clients no-lock
     2454       where buf_clients.obj-code = f-invclipt
     2455         and buf_clients.obj-type = 'орг':U
     2456       no-error.
     2457     if available buf_clients then do:
     2458       assign
     2459         t-invclipt      = true
     2460         f-invclipt-name = buf_clients.obj-name
     2461       .
     2462     end.
     2463     else do:
     2464       assign
     2465         t-invclipt      = false
     2466         f-invclipt-name = "":U
     2467       .
     2468     end.
     2469     RUN proc-init-dop-info.
     2470     RUN proc-init-sec-fields.
     2471     RUN enable_UI.
     2472     define variable v-obj-code as integer no-undo .
     2473     define variable v-obj-type as character no-undo .
     2474     if p-obj-code = 0 then do:
     2475         assign
     2476         v-obj-code = v-cntxt-obj-code
     2477         v-obj-type = v-cntxt-obj-type
     2478         .
     2479     end.
     2480     else do:
     2481         assign
     2482         v-obj-code = p-obj-code
     2483         v-obj-type = p-obj-type
     2484         .
     2485     end.
     2486       find last ub.shift-obj no-lock where ub.shift-obj.obj-code = v-obj-code and
     2487           ub.shift-obj.obj-type = v-obj-type no-error .
     2488       if available (ub.shift-obj) then
     2489       do:
     2490           find first ub.shift-param no-lock where ub.shift-param.obj-code = ub.shift-obj.obj-code and
     2491               ub.shift-param.obj-type = ub.shift-obj.obj-type and
     2492               ub.shift-param.shift-date = ub.shift-obj.shift-date and
     2493               ub.shift-param.shift-name = ub.shift-obj.shift-name and
     2494               ub.shift-param.shift-num = ub.shift-obj.shift-num no-error .
     2495           if not available (ub.shift-param) then
     2496           do:
     2497               find first ub.shift-param no-lock where ub.shift-param.obj-code = 0 and
     2498                   ub.shift-param.obj-type = "" and
     2499                   ub.shift-param.shift-date = 01.01.1900 no-error .
     2500               if available (ub.shift-param) then
     2501                   assign
     2502                       dev-paid-trans = ub.shift-param.dev-paid-trans
     2503                       prc-dev-mass   = ub.shift-param.prc-dev-mass
     2504                       .
     2505           end.
     2506           else
     2507           do:
     2508               assign
     2509                   dev-paid-trans = ub.shift-param.dev-paid-trans
     2510                   prc-dev-mass   = ub.shift-param.prc-dev-mass
     2511                   .
     2512           end.
     2513       end.
     2514       display dev-paid-trans prc-dev-mass with frame shattrpt .
     2515     apply "value-changed" to t-invclipt in frame shattrpt .
     2516     if p-mode = 'ПРОСМОТР':U then do:
     2517       disable
     2518         all
     2519         with frame shattrpt .
     2520       enable
     2521         b-quit
     2522         B-set_dop-info
     2523         B-set_sec-fields
     2524         with frame shattrpt .
     2525     end.
     2526     hide dop-info in frame shattrpt .
     2527     hide sec-fields in frame shattrpt .
     2528     WAIT-FOR GO OF FRAME shattrpt.
     2529   END.
     2530   RUN disable_UI.
     2531   PROCEDURE disable_UI :
     2532     HIDE FRAME shattrpt.
     2533   END PROCEDURE.
     2534   PROCEDURE enable_UI :
     2535     DISPLAY t-autopump-izm t-autopump t-avtinvpm t-olddens r-expptrl dop-info
     2536             r-inpptrl sec-fields rvs-wt-email r-algrvspt t-rvsnmter t-invclipt
     2537             f-invclipt r-temp-for-pomi r-denstclc mass-proc mass-proc-in-lgas
     2538             r-algoincptrl t-mand-chioce-autocar otkl-fact-volue otkl-temp
     2539             Prc-dev-mass otkl-density otkl-water Dev-paid-trans t-calc-free-vol
     2540             t-calc-free-vol-sug t-trn-reas-sug t-trnscanqr t-rvd-own-nb
     2541             qr-scan-time t-autopump-skip-time t-block-nozzle timeout-block-nozzle
     2542             v-dop-info v-sec-fields f-invclipt-name
     2543         WITH FRAME shattrpt.
     2544     ENABLE B-exit b-quit B-Help RECT-1 RECT-2 RECT-3 RECT-4 RECT-5 RECT-6 RECT-7
     2545            t-autopump-izm t-autopump t-avtinvpm t-olddens r-expptrl r-inpptrl
     2546            sec-fields rvs-wt-email B-set_dop-info B-set_sec-fields r-algrvspt
     2547            t-rvsnmter t-invclipt f-invclipt b-invclipt r-temp-for-pomi r-denstclc
     2548            mass-proc mass-proc-in-lgas r-algoincptrl t-mand-chioce-autocar
     2549            otkl-fact-volue otkl-temp otkl-density otkl-water t-calc-free-vol
     2550            t-calc-free-vol-sug t-trn-reas-sug t-trnscanqr t-rvd-own-nb
     2551            qr-scan-time t-autopump-skip-time t-block-nozzle timeout-block-nozzle
     2552            v-dop-info v-sec-fields
     2553         WITH FRAME shattrpt.
     2554   END PROCEDURE.
     2555   PROCEDURE fill-widgets :
     2556   define variable v-param-type      as character  no-undo .
     2557   define variable v-value-character as character  no-undo .
     2558   define variable v-value-date      as date       no-undo .
     2559   define variable v-value-decimal   as decimal    no-undo .
     2560   define variable v-value-integer   as integer    no-undo .
     2561   define variable v-value-logical   as logical    no-undo .
     2562   define variable v-entry           as character  no-undo .
     2563   do
     2564   on error undo, return error return-value
     2565   :
     2566     for each thbjattr_thbj-attr
     2567     :
     2568       delete thbjattr_thbj-attr .
     2569     end.
     2570     for each temp-thbj-attr
     2571     :
     2572       delete temp-thbj-attr .
     2573     end.
     2574     run adm/shattri.p
     2575       ( input "init":U
     2576       , input p-obj-type
     2577       , input p-obj-code
     2578       , input 'petrol':U
     2579       , input "":U
     2580       , output v-value-character
     2581       , output v-value-date
     2582       , output v-value-decimal
     2583       , output v-value-integer
     2584       , output v-value-logical
     2585       , output v-param-type
     2586       , input-output table-handle v-tth
     2587       ) no-error .
     2588     if error-status:error
     2589       and not available locked_thbj-attr
     2590     then do:
     2591       message
     2592       "Не удалось получить начальные значения настроек" skip
     2593       error-status:get-message(1) return-value
     2594       view-as alert-box error .
     2595       undo, return error .
     2596     end.
     2597     for each thbjattr_thbj-attr:
     2598       assign
     2599         v-entry = thbjattr_thbj-attr.prop-code
     2600       .
     2601       case v-entry:
     2602         when 'denstclc':U then do:
     2603           assign
     2604             r-denstclc = thbjattr_thbj-attr.property-value-character
     2605             r-denstclc :private-data in frame shattrpt = "recid=" + string(recid(thbjattr_thbj-attr))
     2606           .
     2607         end.
     2608         when 'autopump':U then do:
     2609           assign
     2610             t-autopump = thbjattr_thbj-attr.property-value-logical
     2611             t-autopump :private-data in frame shattrpt = "recid=" + string(recid(thbjattr_thbj-attr))
     2612           .
     2613         end.
     2614           when 'autopump-izm':U then do:
     2615             assign t-autopump-izm =  thbjattr_thbj-attr.property-value-logical
     2616                t-autopump-izm :private-data in frame shattrpt = "recid=" + string(recid(thbjattr_thbj-attr))
     2617           .
     2618             end.
     2619         when 'autopump-skip-time':U then do:
     2620             assign t-autopump-skip-time =  thbjattr_thbj-attr.property-value-integer
     2621                t-autopump-skip-time :private-data in frame shattrpt = "recid=" + string(recid(thbjattr_thbj-attr))
     2622           .
     2623         end.
     2624         when 'avtinvpm':U then do:
     2625           assign
     2626             t-avtinvpm = thbjattr_thbj-attr.property-value-logical
     2627             t-avtinvpm :private-data in frame shattrpt = "recid=" + string(recid(thbjattr_thbj-attr))
     2628           .
     2629         end.
     2630         when 'expptrl':U then do:
     2631           assign
     2632             r-expptrl = thbjattr_thbj-attr.property-value-character
     2633             r-expptrl :private-data in frame shattrpt = "recid=" + string(recid(thbjattr_thbj-attr))
     2634           .
     2635         end.
     2636         when 'inpptrl':U then do:
     2637           assign
     2638             r-inpptrl = thbjattr_thbj-attr.property-value-character
     2639             r-inpptrl :private-data in frame shattrpt = "recid=" + string(recid(thbjattr_thbj-attr))
     2640           .
     2641         end.
     2642         when 'rvsnmter':U then do:
     2643           assign
     2644             t-rvsnmter = thbjattr_thbj-attr.property-value-logical
     2645             t-rvsnmter :private-data in frame shattrpt = "recid=" + string(recid(thbjattr_thbj-attr))
     2646           .
     2647         end.
     2648         when 'invclipt':U then do:
     2649           assign
     2650             f-invclipt = thbjattr_thbj-attr.property-value-integer
     2651             f-invclipt :private-data in frame shattrpt = "recid=" + string(recid(thbjattr_thbj-attr))
     2652           .
     2653         end.
     2654         when 'olddens':U then do:
     2655           assign
     2656             t-olddens = thbjattr_thbj-attr.property-value-logical
     2657             t-olddens :private-data in frame shattrpt = "recid=" + string(recid(thbjattr_thbj-attr))
     2658           .
     2659         end.
     2660         when 'algrvspt':U then do:
     2661           assign
     2662             r-algrvspt = thbjattr_thbj-attr.property-value-integer
     2663             r-algrvspt :private-data in frame shattrpt = "recid=" + string(recid(thbjattr_thbj-attr))
     2664           .
     2665         end.
     2666         when 'temp-for-pomi':U then do:
     2667           assign
     2668             r-temp-for-pomi = thbjattr_thbj-attr.property-value-integer
     2669             r-temp-for-pomi :private-data in frame shattrpt = "recid=" + string(recid(thbjattr_thbj-attr))
     2670           .
     2671         end.
     2672         when 'rvs-wt-email':U then do:
     2673           assign
     2674             rvs-wt-email = thbjattr_thbj-attr.property-value-character
     2675             rvs-wt-email :private-data in frame shattrpt = "recid=" + string(recid(thbjattr_thbj-attr))
     2676           .
     2677         end.
     2678         when 'CriticalDif':U then
     2679             do:
     2680               assign
     2681                 mass-proc = thbjattr_thbj-attr.property-value-character
     2682                 mass-proc :private-data in frame shattrpt = "recid=" + string(recid(thbjattr_thbj-attr))
     2683               .
     2684             end.
     2685         when 'algoincome':U then
     2686             do:
     2687               assign
     2688                 r-algoincptrl = thbjattr_thbj-attr.property-value-integer
     2689                 r-algoincptrl :private-data in frame shattrpt = "recid=" + string(recid(thbjattr_thbj-attr))
     2690                 .
     2691             end.
     2692         when 'otkl-fact-volue':U then
     2693             do:
     2694               assign
     2695                 otkl-fact-volue = thbjattr_thbj-attr.property-value-decimal
     2696                 otkl-fact-volue :private-data in frame shattrpt = "recid=" + string(recid(thbjattr_thbj-attr))
     2697                 .
     2698             end.
     2699         when 'otkl-temp':U then
     2700             do:
     2701               assign
     2702                 otkl-temp = thbjattr_thbj-attr.property-value-decimal
     2703                 otkl-temp :private-data in frame shattrpt = "recid=" + string(recid(thbjattr_thbj-attr))
     2704                 .
     2705             end.
     2706         when 'otkl-density':U then
     2707             do:
     2708               assign
     2709                 otkl-density = thbjattr_thbj-attr.property-value-character
     2710                 otkl-density :private-data in frame shattrpt = "recid=" + string(recid(thbjattr_thbj-attr))
     2711                 .
     2712                 if otkl-density = "" then otkl-density = "0.000" .
     2713             end.
     2714         when 'otkl-water':U then
     2715             do:
     2716               assign
     2717                 otkl-water = thbjattr_thbj-attr.property-value-decimal
     2718                 otkl-water :private-data in frame shattrpt = "recid=" + string(recid(thbjattr_thbj-attr))
     2719                 .
     2720             end.
     2721         when 'mand-choice-autocar':U then
     2722             do:
     2723               assign
     2724                 t-mand-chioce-autocar = thbjattr_thbj-attr.property-value-logical
     2725                 t-mand-chioce-autocar :private-data in frame shattrpt = "recid=" + string(recid(thbjattr_thbj-attr))
     2726               .
     2727             end.
     2728         when 'block-nozzle':U then
     2729             do:
     2730               assign
     2731                 t-block-nozzle = thbjattr_thbj-attr.property-value-logical
     2732                 t-block-nozzle :private-data in frame shattrpt = "recid=" + string(recid(thbjattr_thbj-attr))
     2733               .
     2734             end.
     2735         when 'timeout-block-nozzle':U then
     2736             do:
     2737               assign
     2738                 timeout-block-nozzle = thbjattr_thbj-attr.property-value-integer
     2739                 timeout-block-nozzle :private-data in frame shattrpt = "recid=" + string(recid(thbjattr_thbj-attr))
     2740               .
     2741             end.
     2742           when 'dop-info':U then
     2743             do:
     2744               assign
     2745                 dop-info = thbjattr_thbj-attr.property-value-character
     2746                 dop-info :private-data in frame shattrpt = "recid=" + string(recid(thbjattr_thbj-attr))
     2747               .
     2748             end.
     2749           when 'sec-fields':U then
     2750             do:
     2751               assign
     2752                 sec-fields = thbjattr_thbj-attr.property-value-character
     2753                 sec-fields :private-data in frame shattrpt = "recid=" + string(recid(thbjattr_thbj-attr))
     2754               .
     2755             end.
     2756           when 'CriticalDifInLgas':U then
     2757             do:
     2758               assign
     2759                 mass-proc-in-lgas = thbjattr_thbj-attr.property-value-decimal
     2760                 mass-proc-in-lgas :private-data in frame shattrpt = "recid=" + string(recid(thbjattr_thbj-attr))
     2761               .
     2762             end.
     2763           when 'calc-free-vol':U then
     2764             do:
     2765               assign
     2766                 t-calc-free-vol = thbjattr_thbj-attr.property-value-logical
     2767                 t-calc-free-vol :private-data in frame shattrpt = "recid=" + string(recid(thbjattr_thbj-attr))
     2768               .
     2769             end.
     2770           when 'calc-free-vol-sug':U then
     2771             do:
     2772               assign
     2773                 t-calc-free-vol-sug = thbjattr_thbj-attr.property-value-logical
     2774                 t-calc-free-vol-sug :private-data in frame shattrpt = "recid=" + string(recid(thbjattr_thbj-attr))
     2775               .
     2776             end.
     2777           when 'trn-reas-sug':U then
     2778             do:
     2779               assign
     2780                 t-trn-reas-sug = thbjattr_thbj-attr.property-value-logical
     2781                 t-trn-reas-sug :private-data in frame shattrpt = "recid=" + string(recid(thbjattr_thbj-attr))
     2782               .
     2783             end.
     2784           when 'rvd-own-nb':U then
     2785             do:
     2786               assign
     2787                 t-rvd-own-nb = thbjattr_thbj-attr.property-value-logical
     2788                 t-rvd-own-nb :private-data in frame shattrpt = "recid=" + string(recid(thbjattr_thbj-attr))
     2789               .
     2790             end.
     2791           when 'qr-scan-time':U then
     2792             do:
     2793               assign
     2794                 qr-scan-time = thbjattr_thbj-attr.property-value-integer
     2795                 qr-scan-time :private-data in frame shattrpt = "recid=" + string(recid(thbjattr_thbj-attr))
     2796               .
     2797           end.
     2798           when 'trnscanqr':U then
     2799             do:
     2800               assign
     2801                 t-trnscanqr = thbjattr_thbj-attr.property-value-logical
     2802                 t-trnscanqr :private-data in frame shattrpt = "recid=" + string(recid(thbjattr_thbj-attr))
     2803               .
     2804             end.
     2805       end case.
     2806       create temp-thbj-attr.
     2807       buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     2808     end.
     2809   end.
     2810   END PROCEDURE.
     2811   PROCEDURE proc-init-dop-info :
     2812      assign
     2813         v-list-dop-info      = 'car-num':U + "," + 'fio-driver':U + "," + 'time-income':U + "," + 'date-income':U + "," + 'time-pour':U + "," + 'date-pour':U + "," + 'inspection-cert':U + ","
     2814         + 'date-cert':U + "," + 'date-pasport':U  + "," + 'num-pasport':U + "," + 'condition':U + "," + 'seals-condition':U + "," + 'acc-ship':U + "," + 'doc-not':U + "," + 'spisok-not-doc':U + "," + 'ptbobj':U +
     2815         "," + 'ptb-item-pour':U + "," + 'autoent':U.
     2816         v-list-dop-info-full = "Гос. № автоцистерны" + "," + "Ф.И.О. водителя-экспедитора" + "," + "Время прибытия на АЗС" + "," + "Дата прибытия на АЗС" + "," + "Время налива" + "," + "Дата налива" + "," + "Свидетельство о поверке" + ","
     2817         + "Дата свидетельства о поверке" + "," + "Паспорт качества дата" + "," + "Паспорт качества номер" + "," + "Техническое состояние" + "," + "Пломбы и их состояние" + "," + "Допустимый % погрешности поставщика" + "," + "Документы НЕ предоставлены" + "," + "Список не предоставленных документов" +
     2818          "," + "Нефтебаза/ГНС" + "," + "Примечание к нефтебазе" + "," + "Автопредприятие".
     2819   END PROCEDURE.
     2820   PROCEDURE proc-init-sec-fields :
     2821      assign
     2822         v-list-sec-fields      = "section-name,cli-qnty,doc-dens,group-np,list-tank,"
     2823                                + "ttn-temp,acc-ship,doc-dens-st,doc-qnty,doc-volume,"
     2824                                + "shape,pour,num-passport,car-vol,pasp-dens,"
     2825                                + "a-b-tarir,tank-density,tank-temp,dens-temp,"
     2826                                + "place-si,place-si-temp,accessIDLowerLevel".
     2827         v-list-sec-fields-full = "Номер секции,Масса по док.,Плотность по док. (при раб. темп.),Группа НП/Давление насыщенных паров,Резервуар,"
     2828                                + "Температура по ТТН,Погр. изм. пост.,Плотность по док. (при станд. темп.),Кол-во по док.,Объем по док.,"
     2829                                + "Форма горловины,Тип налива,Дата и номер паспорта качества,Объем по свидетельству о поверке,Плотность по паспорту,"
     2830                                + "Отклонение от тарировочной планки,Плотность топлива,Температура замера объема,Температура замера плотности,"
     2831                                + "Средство измерения плотности,Средство измерения температуры,Идентиф. доступа (ключ) «нижнего уровня»".
     2832   END PROCEDURE.
     2833   PROCEDURE proc-save :
     2834   define variable v-value-character as character      no-undo .
     2835   define variable v-value-date      as date           no-undo .
     2836   define variable v-value-decimal   as decimal        no-undo .
     2837   define variable v-value-integer   as integer        no-undo .
     2838   define variable v-value-logical   as logical        no-undo .
     2839   define variable v-sale-add        as character      no-undo .
     2840   define variable v-param-type      as character      no-undo .
     2841   define variable wh                as widget-handle  no-undo .
     2842   define variable fh                as widget-handle  no-undo .
     2843   define variable v-same            as logical        no-undo .
     2844   define variable v-change-temp     as logical        no-undo .
     2845   define variable v-change-volume   as logical        no-undo .
     2846   define variable v-change-density  as logical        no-undo .
     2847   define variable v-change-water    as logical        no-undo .
     2848   define variable v-change-param    as character      no-undo .
     2849   define variable v-vid-param       as longchar       no-undo .
     2850   define variable v-vid-action           as integer   no-undo .
     2851   define variable v-computer-name        as character no-undo .
     2852   define variable v-computer-tcp-name    as character no-undo .
     2853   define variable v-computer-ip-addr     as character no-undo .
     2854   define variable v-computer-login-name  as character no-undo .
     2855   define variable v-computer-process-pid as integer   no-undo .
     2856   define variable v-date                 as character no-undo .
     2857   define variable v-time                 as character no-undo .
     2858   do
     2859   on error undo, return error return-value
     2860   :
     2861   display dop-info sec-fields with frame shattrpt .
     2862   hide dop-info sec-fields in frame shattrpt .
     2863     if p-mode = 'ПРОСМОТР':U then do:
     2864       return error.
     2865     end.
     2866     define buffer buf_clients for ub.clients .
     2867     assign
     2868       frame shattrpt t-invclipt
     2869       frame shattrpt f-invclipt
     2870       fh = frame shattrpt:first-child
     2871       wh = fh:first-child
     2872     .
     2873     if t-invclipt = true then do:
     2874       find first buf_clients no-lock
     2875         where buf_clients.obj-code = f-invclipt
     2876           and buf_clients.obj-type = 'орг':U
     2877         no-error.
     2878       if not available buf_clients then do:
     2879         message
     2880           "Некорректное значение НАСТРОЙКИ"    skip
     2881           t-invclipt:label                     skip
     2882           view-as alert-box error .
     2883         undo, return error .
     2884       end.
     2885     end.
     2886     do while valid-handle(wh):
     2887       if wh:private-data begins "recid=" then do:
     2888         find first thbjattr_thbj-attr
     2889           where recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '='))
     2890         .
     2891         assign
     2892           buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value
     2893         .
     2894       end.
     2895       wh = wh:next-sibling.
     2896     end.
     2897     assign
     2898       v-same = yes
     2899     .
     2900     for each thbjattr_thbj-attr,
     2901         first temp-thbj-attr
     2902           where temp-thbj-attr.obj-type         = thbjattr_thbj-attr.obj-type
     2903             and temp-thbj-attr.obj-code         = thbjattr_thbj-attr.obj-code
     2904             and temp-thbj-attr.upper-prop-code  = thbjattr_thbj-attr.upper-prop-code
     2905             and temp-thbj-attr.prop-code        = thbjattr_thbj-attr.prop-code
     2906     :
     2907       buffer-compare thbjattr_thbj-attr to temp-thbj-attr save result in v-same.
     2908       if v-same = false then do:
     2909         leave.
     2910       end.
     2911     end.
     2912     if v-same = true
     2913       and v-to-create = false
     2914     then do:
     2915       return.
     2916     end.
     2917     run adm/shattri.p
     2918       ( input "check":U
     2919       , input p-obj-type
     2920       , input p-obj-code
     2921       , input 'petrol':U
     2922       , INPUT '':U
     2923       , output v-value-character
     2924       , output v-value-date
     2925       , output v-value-decimal
     2926       , output v-value-integer
     2927       , output v-value-logical
     2928       , output v-param-type
     2929       , input-output table-handle v-tth
     2930       ) no-error .
     2931     if error-status :error then do:
     2932       message
     2933         "Некорректное значение ПАРАМЕТРОВ"  skip
     2934         error-status:get-message(1)         skip
     2935         return-value
     2936       view-as alert-box error .
     2937       undo, return error .
     2938     end.
     2939       run thbjattr_set-section in this-procedure
     2940       ( input p-obj-type
     2941       , input p-obj-code
     2942       , input 'petrol':U
     2943       , input table thbjattr_thbj-attr
     2944       ) no-error.
     2945     if error-status:error then do:
     2946       message
     2947         error-status:get-message(1)  skip
     2948         return-value
     2949       view-as alert-box.
     2950       undo, return error.
     2951     end.
     2952     for each temp-thbj-attr no-lock:
     2953       v-change-param = "" .
     2954       case temp-thbj-attr.prop-code:
     2955         when 'otkl-fact-volue':U then
     2956           do:
     2957             if temp-thbj-attr.property-value-decimal <> otkl-fact-volue then
     2958             do:
     2959               v-change-param = "IDParam="  + "otkl-fact-volume" + chr(4) +
     2960                 "NameParam=" + "Макс.допустимое значение фактического объема" + chr(4) +
     2961                 "ParamBefore=" + string(temp-thbj-attr.property-value-decimal) + chr(4) +
     2962                 "ParamAfter=" + string(otkl-fact-volue) no-error.
     2963             end.
     2964           end.
     2965         when 'otkl-temp':U then
     2966           do:
     2967             if temp-thbj-attr.property-value-decimal <> otkl-temp then
     2968             do:
     2969               v-change-param = "IDParam="  + "otkl-temp" + chr(4) +
     2970                 "NameParam=" + "Макс.допустимое значение температуры" + chr(4) +
     2971                 "ParamBefore=" + string(temp-thbj-attr.property-value-decimal) + chr(4) +
     2972                 "ParamAfter=" + string(otkl-temp) no-error.
     2973             end.
     2974           end.
     2975         when 'otkl-density':U then
     2976           do:
     2977             if temp-thbj-attr.property-value-character <> otkl-density then
     2978             do:
     2979               v-change-param = "IDParam="  + "otkl-density" + chr(4) +
     2980                 "NameParam=" + "Макс.допустимое значение плотности" + chr(4) +
     2981                 "ParamBefore=" + string(temp-thbj-attr.property-value-character) + chr(4) +
     2982                 "ParamAfter=" + string(otkl-density) no-error.
     2983             end.
     2984           end.
     2985         when 'otkl-water':U then
     2986           do:
     2987             if temp-thbj-attr.property-value-decimal <> otkl-water then
     2988             do:
     2989               v-change-param = "IDParam="  + "otkl-water" + chr(4) +
     2990                 "NameParam=" + "Макс.допустимое значение воды" + chr(4) +
     2991                 "ParamBefore=" + string(temp-thbj-attr.property-value-decimal) + chr(4) +
     2992                 "ParamAfter=" + string(otkl-water) no-error.
     2993             end.
     2994           end.
     2995       end.
     2996       if v-change-param <> "" then
     2997       do:
     2998         define variable v-time-hour    as integer   no-undo .
     2999         define variable v-time-min     as integer   no-undo .
     3000         define variable v-nik          as character no-undo .
     3001         define variable v-name         as character no-undo .
     3002         define variable v-cntxt-userid as character no-undo .
     3003         run get-userid in parparentproc ( output v-cntxt-userid) .
     3004         run get-userid in parparentproc ( output v-cntxt-userid) .
     3005         find first ub.user-account no-lock where ub.user-account.user-id = v-cntxt-userid no-error .
     3006         if available (ub.user-account) then
     3007         do:
     3008           assign
     3009             v-nik  = ub.user-account.nik
     3010             v-name = ub.user-account.last-name + " " + ub.user-account.first-name
     3011             .
     3012         end.
     3013         run cur-time in this-procedure ( output v-date, output v-time).
     3014         v-time-hour = truncate(integer(v-time) / 3600, 0).
     3015         v-time-min  = (integer(v-time) - (v-time-hour * 3600)) / 60 .
     3016         run sys-time_get-comp-user-name in this-procedure
     3017           (output v-computer-name
     3018           ,output v-computer-login-name
     3019           ,output v-computer-process-pid
     3020           ) .
     3021         v-vid-action = 66 .
     3022   define variable v-initiator  as character no-undo.
     3023   case true:
     3024     when g#auto then v-initiator = "Auto".
     3025     when g#news then v-initiator = "Nws".
     3026     when g#esys then v-initiator = "Esys".
     3027     otherwise v-initiator = "User".
     3028   end case.
     3029         v-vid-param =
     3030           "UniqueIdRecordARM=" + v-initiator + chr(4) +
     3031           "UserName=" + v-name + chr(4) +
     3032           "UserNik=" + v-nik + chr(4) +
     3033           "NumShop=" + string(temp-thbj-attr.obj-code) + chr(4) + v-change-param
     3034           no-error.
     3035         run trg/userlog.p (
     3036           input 'update':U
     3037           , input 'thbj-attr':U
     3038           , input ( buffer temp-thbj-attr :handle )
     3039           , input v-vid-action
     3040           , input v-vid-param
     3041           ) no-error.
     3042         if error-status :error
     3043           then
     3044         do:
     3045           return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
     3046             , chr(10)
     3047             , vss-workfile
     3048             , return-value
     3049             , error-status :get-message ( 1 ) ).
     3050         end.
     3051       end.
     3052     end.
     3053   end.
     3054   END PROCEDURE.
     3055   PROCEDURE select-dop-info :
     3056   define variable v-counter       as integer      no-undo.
     3057   define variable v-label         as character    no-undo.
     3058   define variable v-value         as character    no-undo.
     3059   define variable v-list          as character    no-undo.
     3060   define variable v-changed       as logical    no-undo.
     3061   define variable v-accepted      as logical    no-undo.
     3062   define variable v-mode          as integer    no-undo.
     3063   define variable V-EX as logical   no-undo .
     3064   do
     3065   with frame shattrpt
     3066   on error undo, return error
     3067   :
     3068   if p-mode = 'ПРОСМОТР':U then v-mode = 0 .
     3069   else v-mode = 1 .
     3070       run twowin_clear in this-procedure.
     3071       do v-counter = 1 to num-entries( v-list-dop-info-full )
     3072       on error undo, return error
     3073       :
     3074           assign
     3075               v-label = entry( v-counter, v-list-dop-info-full )
     3076               v-value = entry( v-counter, v-list-dop-info )
     3077               v-ex = false
     3078           .
     3079              if  lookup (v-value , dop-info ) > 0 then  v-ex = true .
     3080              else v-ex = false .
     3081           run twowin_add-item in this-procedure (
     3082                 input v-value
     3083               , input v-label
     3084               , input substitute( "Обязательные поля: &1", v-VALUE)
     3085               , input  V-EX
     3086           ).
     3087       end.
     3088       run gbl/twowin.w (
     3089             input ?
     3090           , input v-mode
     3091           , input "Выбор обязательного поля доп.инфо ПН":U
     3092           , input "":U
     3093           , input "&Тест"
     3094           , input table temp_twowin_items
     3095           , output table temp_twowin_itemsSelected_col
     3096           , output v-changed
     3097           , output v-accepted
     3098       ).
     3099       if v-changed then do:
     3100           dop-info = "" .
     3101           for each temp_twowin_itemsSelected_col :
     3102           dop-info = dop-info +  temp_twowin_itemsSelected_col.itmExtKey + "," .
     3103           end.
     3104           dop-info = trim(dop-info, ",") .
     3105           display dop-info with frame shattrpt .
     3106                       hide dop-info in frame shattrpt .
     3107       end.
     3108   end.
     3109   END PROCEDURE.
     3110   PROCEDURE select-sec-fields :
     3111   define variable v-counter       as integer      no-undo.
     3112   define variable v-label         as character    no-undo.
     3113   define variable v-value         as character    no-undo.
     3114   define variable v-list          as character    no-undo.
     3115   define variable v-changed       as logical    no-undo.
     3116   define variable v-accepted      as logical    no-undo.
     3117   define variable v-mode          as integer    no-undo.
     3118   define variable V-EX as logical   no-undo .
     3119   do
     3120   with frame shattrpt
     3121   on error undo, return error
     3122   :
     3123   if p-mode = 'ПРОСМОТР':U then v-mode = 0 .
     3124   else v-mode = 1 .
     3125       run twowin_clear in this-procedure.
     3126       do v-counter = 1 to num-entries( v-list-sec-fields-full )
     3127       on error undo, return error
     3128       :
     3129           assign
     3130               v-label = entry( v-counter, v-list-sec-fields-full )
     3131               v-value = entry( v-counter, v-list-sec-fields )
     3132               v-ex = false
     3133           .
     3134              if  lookup (v-value , sec-fields ) > 0 then  v-ex = true .
     3135              else v-ex = false .
     3136           run twowin_add-item in this-procedure (
     3137                 input v-value
     3138               , input v-label
     3139               , input substitute( "Обязательные поля: &1", v-VALUE)
     3140               , input  V-EX
     3141           ).
     3142       end.
     3143       run gbl/twowin.w (
     3144             input ?
     3145           , input v-mode
     3146           , input "Выбор обязательного поля в секциях ПН":U
     3147           , input "":U
     3148           , input "&Тест"
     3149           , input table temp_twowin_items
     3150           , output table sect_twowin_itemsSelected_col
     3151           , output v-changed
     3152           , output v-accepted
     3153       ).
     3154       if v-changed then do:
     3155           sec-fields = "" .
     3156           for each sect_twowin_itemsSelected_col :
     3157           sec-fields = sec-fields +  sect_twowin_itemsSelected_col.itmExtKey + "," .
     3158           end.
     3159           sec-fields = trim(sec-fields, ",") .
     3160       end.
     3161   end.
     3162   END PROCEDURE.
