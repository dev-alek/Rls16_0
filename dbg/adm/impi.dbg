        1   define input-output parameter par-fname    as character format "x(80)" no-undo.
        2   define       output parameter par-clearcnf as logical   initial false  no-undo.
        3   define       output parameter par-uselast  as logical   initial true   no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Экспорт конфигурационных параметров".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   procedure proc-alt-shift-f2:
       65     if not ibs.th.gbl.gbl-var:rcode
       66   then
       67     run gbl\inidebug.p .
       68   end.
       69   procedure proc-alt-shift-f3:
       70     run gbl/prvssinf.p
       71       ( input this-procedure
       72       ) .
       73   end.
       74   define variable v-inform-launched as logical no-undo initial false .
       75   procedure proc-alt-shift-f4:
       76     define variable v-action as character no-undo .
       77     if v-inform-launched = false then do:
       78       assign
       79         v-inform-launched = true
       80       .
       81       run gbl/d-inform.w
       82         (  input self
       83         ,  input this-procedure
       84         , output v-action
       85         ) no-error .
       86       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       87       assign
       88         v-inform-launched = false
       89       .
       90     end.
       91   end.
       92   procedure proc-alt-f1:
       93     run gbl/corrhelp.p
       94       (input this-procedure
       95       ) .
       96   end .
       97   on alt-shift-f2 anywhere do:
       98     run proc-alt-shift-f2.
       99   end.
      100   on alt-shift-f3 anywhere do:
      101     run proc-alt-shift-f3 in this-procedure .
      102   end.
      103   on alt-shift-f4 anywhere do:
      104     run proc-alt-shift-f4 in this-procedure.
      105   end.
      106   on alt-f1 anywhere do:
      107     run proc-alt-f1 in this-procedure .
      108   end.
      109   DEFINE BUTTON b-exit AUTO-GO
      110        LABEL "&Ввод ":L
      111        SIZE 10 BY 1.
      112   DEFINE BUTTON b-file
      113        IMAGE-UP FILE "btn-down-arrow":U
      114        IMAGE-DOWN FILE "btn-down-arrow":U
      115        IMAGE-INSENSITIVE FILE "btn-down-arrow":U NO-FOCUS
      116        LABEL "b-file"
      117        SIZE 2.88 BY .92.
      118   DEFINE BUTTON b-help
      119        LABEL "Помо&щь":L
      120        SIZE 10 BY 1.
      121   DEFINE BUTTON b-quit AUTO-END-KEY
      122        LABEL "&Отмена":L
      123        SIZE 10 BY 1.
      124   DEFINE VARIABLE FName AS CHARACTER FORMAT "X(256)":U
      125        LABEL "Имя файла"
      126        VIEW-AS FILL-IN NATIVE
      127        SIZE 51.13 BY 1 TOOLTIP "Имя файла конфигурации" NO-UNDO.
      128   DEFINE VARIABLE ClearCnf AS LOGICAL INITIAL no
      129        LABEL "Удалить существующие"
      130        VIEW-AS TOGGLE-BOX
      131        SIZE 30.25 BY .83 TOOLTIP "Существующий набор параметров будет полностью удален" NO-UNDO.
      132   DEFINE VARIABLE UseLast AS LOGICAL INITIAL yes
      133        LABEL "Заменять дублируемые"
      134        VIEW-AS TOGGLE-BOX
      135        SIZE 25.75 BY .83 TOOLTIP "Параметры из импортируемого файла заменят ранее существующие" NO-UNDO.
      136   DEFINE FRAME d-cnf
      137        b-exit AT ROW 1 COL 2
      138        b-quit AT ROW 1 COL 12
      139        b-help AT ROW 1 COL 60
      140        ClearCnf AT ROW 3 COL 14
      141        UseLast AT ROW 4 COL 14
      142        FName AT ROW 5 COL 12 COLON-ALIGNED
      143        b-file AT ROW 5 COL 66
      144        SPACE(1.49) SKIP(0.65)
      145       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      146            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      147            TITLE "Импорт конфигурации":L.
      148   ASSIGN
      149          FRAME d-cnf:SCROLLABLE       = FALSE.
      150   ASSIGN
      151          ClearCnf:AUTO-RESIZE IN FRAME d-cnf      = TRUE.
      152   ON CHOOSE OF b-exit IN FRAME d-cnf
      153   DO:
      154     assign
      155       UseLast
      156       ClearCnf
      157       fname
      158     .
      159     assign
      160       par-fname = fname
      161       par-clearcnf = ClearCnf
      162       par-uselast = UseLast
      163     .
      164   END.
      165   ON CHOOSE OF b-file IN FRAME d-cnf
      166   DO:
      167       define variable is-choosen as logical no-undo.
      168       SYSTEM-DIALOG GET-FILE fname
      169       FILTERS "Файлы конфигурации *.cfg" "*.cfg",
      170               "Все файлы"  "*.*"
      171       must-exist
      172       TITLE "Выберите файл для импорта конфигурации"
      173       USE-FILENAME
      174       UPDATE is-choosen.
      175       if is-choosen then do:
      176          display
      177            fname
      178            with frame d-cnf.
      179       end.
      180   END.
      181   ON CHOOSE OF b-quit IN FRAME d-cnf
      182   DO:
      183     par-fname = "".
      184   END.
      185   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      186   on help of frame d-cnf
      187   do:
      188     run gbl/app_help.p
      189       (input this-procedure :file-name
      190       ,input ''
      191       ,input ?
      192       ) no-error.
      193     if error-status :error then do:
      194       message
      195         "Ошибка при вызове помощи"
      196         error-status :get-message(1)
      197         view-as alert-box .
      198     end.
      199   end.
      200   run minbtn-set in this-procedure .
      201   on choose of b-help in frame d-cnf
      202   do:
      203     apply "help":u to frame d-cnf .
      204   end.
      205   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      206   procedure minbtn-set :
      207       do
      208           on error undo, return error return-value
      209           :
      210           define variable ii              as integer       no-undo .
      211           define variable fh              as widget-handle no-undo .
      212           define variable hh              as widget-handle no-undo .
      213           define variable v-h             as handle        extent 4 no-undo .
      214           define variable v-name-button   as character     no-undo .
      215           define variable v-help-old-x    as decimal       no-undo .
      216           define variable v-help-old-y    as decimal       no-undo .
      217           define variable v-help-old-size as decimal       no-undo .
      218           define variable v-frame-width   as decimal       no-undo .
      219           define variable jj              as integer       no-undo .
      220           do
      221               on error undo, return error
      222               :
      223               assign
      224                   v-frame-width = frame d-cnf:width - 0.3
      225                   fh            = frame d-cnf:first-child
      226                   hh            = fh:first-child
      227                   ii            = 1
      228                   .
      229               do while valid-handle(hh):
      230                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      231                   do:
      232                       case lc(hh:name) :
      233                           when "b-help" then
      234                               do:
      235                                   hh:load-image-up("cmp/b-help.bmp":u) .
      236                                   hh:load-image-down("cmp/b-help.bmp":u) .
      237                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      238                                   hh:TOOLTIP = "Помощь" .
      239                                   v-help-old-x = hh:column .
      240                                   v-help-old-y = hh:row    .
      241                                   v-help-old-size = hh:width .
      242                                   hh:width-chars = 2.5 .
      243                               end.
      244                           when "b-print" then
      245                               do:
      246                                   hh:load-image("cmp/b-print.bmp":u) .
      247                                   hh:TOOLTIP = "Печать" .
      248                                   v-h[ii] = hh:handle .
      249                                   ii = ii + 1 .
      250                                   hh:width-chars = 3 .
      251                               end.
      252                           when "b-history" or
      253                           when "b-hist" then
      254                               do:
      255                                   hh:load-image("cmp/b-hist.bmp":u) .
      256                                   hh:TOOLTIP = "История" .
      257                                   v-h[ii] = hh:handle .
      258                                   ii = ii + 1 .
      259                                   hh:width-chars = 3 .
      260                               end.
      261                           when "b-sch" then
      262                               do:
      263                                   hh:load-image("cmp/b-sch.bmp":u) .
      264                                   hh:TOOLTIP = "Установка Фильтра" .
      265                                   v-h[ii] = hh:handle .
      266                                   ii = ii + 1 .
      267                                   hh:width-chars = 3 .
      268                               end.
      269                           when "b-hist-user" then
      270                               do:
      271                                   hh:load-image("cmp/b-hist.bmp":u) .
      272                                   hh:TOOLTIP = "История пользователя" .
      273                                   ii = ii + 1 .
      274                               end.
      275                       end case.
      276                   end.
      277                   hh = hh:next-sibling.
      278               end.
      279               b-help:column = v-frame-width - b-help:width-chars.
      280               jj = 0.
      281               repeat ii = 4 to 1 by -1 :
      282                   if valid-handle (v-h[ii] ) then
      283                   do:
      284                       jj  = jj + 1 .
      285                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      286                       v-h[ii]:row    = v-help-old-y .
      287                   end.
      288               end.
      289           end.
      290       end.
      291   end procedure.
      292   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-cnf:PARENT eq ?
      293   THEN FRAME d-cnf:PARENT = ACTIVE-WINDOW.
      294   define variable cur-der as logical no-undo.
      295     cur-der = session:data-entry-return.
      296     session:data-entry-return = yes.
      297   fname = search (par-fname).
      298   if fname <> ? then par-fname = fname.
      299   MAIN-BLOCK:
      300   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      301      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      302      run enable_UI.
      303      WAIT-FOR GO OF FRAME d-cnf.
      304   END.
      305   RUN disable_UI.
      306   session:data-entry-return = cur-der .
      307   PROCEDURE disable_UI :
      308     HIDE FRAME d-cnf.
      309   END PROCEDURE.
      310   PROCEDURE enable_UI :
      311     DISPLAY ClearCnf UseLast FName
      312         WITH FRAME d-cnf.
      313     ENABLE b-exit b-quit b-help ClearCnf UseLast FName b-file
      314         WITH FRAME d-cnf.
      315   END PROCEDURE.
