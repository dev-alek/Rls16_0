        1   block-level on error undo, throw.
        2   define temp-table tt-BatchProcess
        3    field BP_Type as char
        4    field CharKey_One as char
        5    field CharKey_Two as char
        6    field CharKey_Three as char
        7    field BP_ExecSysDate as date
        8    field BP_ExecSysTimeInt as int
        9    index dt BP_ExecSysDate BP_ExecSysTimeInt.
       10   define input  parameter p-task-type   as character no-undo .
       11   define input  parameter p-for-db      as longchar no-undo .
       12   define output parameter p-list-db     as character no-undo .
       13   define output parameter p-list-db-All as character no-undo .
       14   define output parameter p-list-key     as character no-undo .
       15   define output parameter p-list-key-all  as character no-undo .
       16   define input  parameter p-for-extsys  as character no-undo .
       17   define input  parameter p-for-proc    as character no-undo .
       18   define output parameter table for tt-BatchProcess .
       19   define variable vss-revision    as character no-undo init "$Revision$":U .
       20   define variable vss-author      as character no-undo init "$Author$":U .
       21   define variable vss-date        as character no-undo init "$Date$":U .
       22   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       23   define variable vss-archive     as character no-undo init "$Archive$":U .
       24   define variable vss-description as character no-undo init "проверка необходимости выполнения действия по расписанию".
       25   procedure vss-get-info :
       26     define output parameter p-vss-revision    like vss-revision    no-undo .
       27     define output parameter p-vss-author      like vss-author      no-undo .
       28     define output parameter p-vss-date        like vss-date        no-undo .
       29     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       30     define output parameter p-vss-archive     like vss-archive     no-undo .
       31     define output parameter p-vss-description like vss-description no-undo .
       32     assign
       33       p-vss-revision    = vss-revision
       34       p-vss-author      = vss-author
       35       p-vss-date        = vss-date
       36       p-vss-workfile    = vss-workfile
       37       p-vss-archive     = vss-archive
       38       p-vss-description = vss-description
       39     .
       40   end procedure.
       41   procedure vss-get-parameters :
       42     define output parameter p-vss-parameters as character no-undo .
       43   end procedure.
       44   define new global shared variable g#vssrevis-logger as handle    no-undo .
       45   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       46   define variable v-vssrevis-logger                   as handle    no-undo .
       47   procedure vss-logevent :
       48     define input  parameter p-extra-paramters as character no-undo .
       49     define variable v-vssrevis-parameters as character no-undo .
       50     do
       51     on error undo, return error return-value
       52     :
       53       if  valid-handle(v-vssrevis-logger)
       54       and v-vssrevis-logger :get-signature("logevent") <> ""
       55       then do:
       56         run vss-get-parameters in this-procedure
       57           (output v-vssrevis-parameters
       58           ).
       59         run logevent in v-vssrevis-logger
       60           (input vss-workfile
       61           ,input vss-revision
       62           ,input v-vssrevis-parameters
       63           ,input p-extra-paramters
       64           ).
       65       end.
       66     end.
       67   end procedure.
       68   assign
       69     v-vssrevis-logger = g#vssrevis-logger
       70   .
       71   if  valid-handle(v-vssrevis-logger)
       72   and v-vssrevis-logger :get-signature("logevent") <> ""
       73   then do:
       74     assign
       75       v-vssrevis-logevent = true
       76     .
       77     run vss-logevent in this-procedure (input vss-description) .
       78   end.
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   define  shared variable g#auto-pid           as integer   no-undo .
       81   define  shared variable conn-par             as character no-undo .
       82   define  shared variable g#auto-user-id       as character no-undo .
       83   define  shared variable g#auto-user-login    as character no-undo .
       84   define  shared variable g#auto-user-password as character no-undo .
       85   define  shared variable v-socket             as logical   no-undo .
       86   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       87   define  shared variable auto-window-h     as handle    no-undo .
       88   define  shared variable auto-log-msg-h    as handle    no-undo .
       89   define  shared variable hand-log-msg-h    as handle    no-undo .
       90   define  shared variable log-file-name     as character no-undo initial ? .
       91   define  shared variable add-log-file-name as character no-undo initial ? .
       92   define  shared variable writelogvalue     as character no-undo initial ? .
       93   define new global shared variable g#language as character no-undo .
       94   if g#language <> '' and g#language <> 'rus':U then do:
       95     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       96   end.
       97   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       98   procedure cur-time :
       99      define output parameter p-today as date      no-undo .
      100      define output parameter p-time  as integer   no-undo .
      101     do
      102     on error undo, return error
      103     :
      104       define variable v-date1 as date      no-undo .
      105       define variable v-date2 as date      no-undo .
      106       define variable v-time  as integer   no-undo .
      107       assign
      108         v-date1 = today
      109         v-time  = time
      110         v-date2 = today
      111       .
      112       if v-date1 <> v-date2
      113       then do:
      114         assign
      115           v-date1 = today
      116           v-time  = v-time
      117         .
      118       end.
      119       assign
      120         p-today = v-date1
      121         p-time  = v-time
      122       .
      123     end.
      124   end.
      125   function cur-time-date returns character
      126   :
      127     return string(today, '99/99/9999':U) .
      128   end.
      129   function cur-time-mjd returns decimal
      130   :
      131     define variable v-date as date      no-undo .
      132     define variable v-time as integer   no-undo .
      133     run cur-time in this-procedure
      134       (output v-date
      135       ,output v-time
      136       ) .
      137     return integer(v-date) - 2400002 + (v-time / 86400) .
      138   end.
      139   function cur-time-get-ending-index returns integer
      140   (input p-number as integer
      141   )
      142   :
      143     if p-number < 0
      144     or p-number = ?
      145     then do:
      146       return 1 .
      147     end.
      148     define variable v-rest as integer   no-undo .
      149     assign
      150       p-number = p-number modulo 100
      151     .
      152     if p-number < 20
      153     then do:
      154       assign
      155         v-rest = p-number
      156       .
      157     end.
      158     else do:
      159       assign
      160         v-rest = p-number modulo 10
      161       .
      162     end.
      163     case v-rest :
      164       when 1
      165       then do:
      166         return 2 .
      167       end.
      168       when 2 or
      169       when 3 or
      170       when 4
      171       then do:
      172         return 3 .
      173       end.
      174       otherwise do:
      175         return 1 .
      176       end.
      177     end case .
      178   end.
      179   procedure cur-time-mjd-to-date :
      180      define input  parameter i-mjd-diff as decimal no-undo.
      181      define output parameter o-Date     as date    no-undo.
      182      define output parameter o-Time     as integer no-undo.
      183      define variable v-day-number as integer   no-undo .
      184      if    i-mjd-diff < 0
      185         or i-mjd-diff = ?
      186      then do:
      187         return "?" .
      188      end.
      189      assign
      190         v-day-number = truncate(i-mjd-diff,0).
      191         o-Date = date(v-day-number + 2400002).
      192         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      193     .
      194   end.
      195   function cur-time-mjd-to-string returns character
      196   (input p-mjd-diff as decimal
      197   )
      198   :
      199     define variable v-day-number as integer   no-undo .
      200     define variable v-seconds    as integer   no-undo .
      201     define variable v-hour       as integer   no-undo .
      202     define variable v-min        as integer   no-undo .
      203     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      204     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      205     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      206     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      207     if p-mjd-diff < 0
      208     or p-mjd-diff = ?
      209     then do:
      210       return "?" .
      211     end.
      212     assign
      213       v-day-number = integer(truncate(p-mjd-diff,0))
      214       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      215     .
      216     if v-seconds > 86400
      217     then do:
      218       assign
      219         v-seconds = 86400 - 1
      220       .
      221     end.
      222     if v-seconds < 0
      223     then do:
      224       assign
      225         v-seconds = 0
      226       .
      227     end.
      228     assign
      229       v-hour = truncate(v-seconds / 3600, 0)
      230     .
      231     assign
      232       v-seconds = v-seconds modulo 3600
      233     .
      234     assign
      235       v-min = truncate(v-seconds / 60, 0)
      236     .
      237     assign
      238       v-seconds = v-seconds modulo 60
      239     .
      240     return
      241         (if v-day-number <> 0
      242           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      243           else ""
      244         )
      245       + (if v-day-number <> 0 or v-hour <> 0
      246           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      247           else ""
      248         )
      249       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      250           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      251           else ""
      252         )
      253       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      254       .
      255   end.
      256   function cur-time-string returns character
      257   :
      258     define variable v-date as date      no-undo .
      259     define variable v-time as integer   no-undo .
      260     run cur-time in this-procedure
      261       (output v-date
      262       ,output v-time
      263       ) .
      264     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      265   end.
      266   function cur-time-string-sec returns character
      267   :
      268     define variable v-date as date      no-undo .
      269     define variable v-time as integer   no-undo .
      270     run cur-time in this-procedure
      271       (output v-date
      272       ,output v-time
      273       ) .
      274     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      275   end.
      276   function cur-time-custom  returns character
      277   (input p-prefix as character
      278   ,input p-date-format as character
      279   ,input p-delimiter as character
      280   ,input p-time-format as character
      281   ,input p-suffix as character
      282   )
      283   :
      284     define variable v-date as date      no-undo .
      285     define variable v-time as integer   no-undo .
      286     run cur-time in this-procedure
      287       (output v-date
      288       ,output v-time
      289       ) .
      290     return
      291       p-prefix
      292       + string(v-date, p-date-format)
      293       + p-delimiter
      294       + string(v-time, p-time-format)
      295       + p-suffix
      296       .
      297   end.
      298   function cur-time-print  returns character
      299   :
      300     define variable v-date as date      no-undo .
      301     define variable v-time as integer   no-undo .
      302     run cur-time in this-procedure
      303       (output v-date
      304       ,output v-time
      305       ) .
      306     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      307   end.
      308   function cur-time-datetime returns datetime
      309   :
      310     define variable v-char as character no-undo .
      311     define variable v-datetime as datetime no-undo .
      312     v-char = cur-time-string().
      313     v-datetime = datetime(v-char).
      314     return  v-datetime.
      315   end.
      316   function cur-time-string-msec returns character
      317   :
      318     define variable v-date as datetime  no-undo .
      319     v-date = now.
      320     return string(v-date) .
      321   end.
      322   define stream LogStream .
      323   define variable mNoTime as logical no-undo.
      324   procedure write-to-log-notime :
      325     define input param i-str as character no-undo .
      326     mNoTime = yes.
      327     run write-to-log (i-str).
      328     mNoTime = no.
      329   end.
      330   procedure write-to-log :
      331     define input param p-str as character no-undo .
      332     do
      333     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      334     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      335     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      336     :
      337       define variable log-res        as logical   no-undo .
      338       define variable v-jj           as integer   no-undo .
      339       if    mNoTime
      340          or writelogvalue eq "AsyncProc"
      341       then
      342          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      343       else
      344          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      345       if auto-log-msg-h <> ? then do:
      346         log-res = auto-log-msg-h:move-to-eof( ) .
      347         log-res = auto-log-msg-h:insert-string( p-str ).
      348       end.
      349       if hand-log-msg-h <> ? then do:
      350         log-res = hand-log-msg-h:move-to-eof( ) .
      351         log-res = hand-log-msg-h:insert-string( p-str ).
      352       end.
      353       assign
      354         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      355         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      356         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      357       .
      358       if add-log-file-name <> ? then do:
      359         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      360           run gbl/fileapnd.p
      361             ( input entry(v-jj, add-log-file-name, chr(1) )
      362             ,input p-str
      363             ,input 20
      364             ) no-error .
      365           if error-status:error then do:
      366             return error return-value .
      367           end.
      368         end.
      369       end.
      370       if writelogvalue eq "AsyncProc"
      371       then do:
      372          p-str = trim(p-str, (chr(13) + chr(10)) )
      373       .
      374          Publish "WriteLogAsunc" (p-str,yes).
      375       end.
      376       else if writelogvalue <> "yes" then do:
      377         run gbl/fileapnd.p
      378           ( input log-file-name
      379           ,input p-str
      380           ,input 20
      381           ) no-error .
      382         if error-status:error then do:
      383           return error return-value .
      384         end.
      385       end.
      386     end.
      387   end procedure.
      388   procedure write-to-screen :
      389     define input param p-str as character no-undo .
      390     do
      391     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      392     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      393     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      394     :
      395       define variable log-res as logical no-undo.
      396       assign
      397         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      398       .
      399       if auto-log-msg-h <> ?
      400       then do:
      401         log-res = auto-log-msg-h:move-to-eof( ) .
      402         log-res = auto-log-msg-h:insert-string( p-str ).
      403       end.
      404       if hand-log-msg-h <> ?
      405       then do:
      406         log-res = hand-log-msg-h:move-to-eof( ) .
      407         log-res = hand-log-msg-h:insert-string( p-str ).
      408       end.
      409     end.
      410   end procedure.
      411   procedure send-msg-to-email :
      412     define input  parameter p-subject      as character no-undo .
      413     define input  parameter p-text-err     as character no-undo .
      414     define input  parameter p-attach-files as character no-undo .
      415     do
      416     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      417     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      418     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      419     :
      420       define variable v-tth             as handle    no-undo .
      421       define variable v-value-character as character no-undo .
      422       define variable v-value-date      as date      no-undo .
      423       define variable v-value-decimal   as decimal   no-undo .
      424       define variable v-value-integer   as integer   no-undo .
      425       define variable v-value-logical   as logical   no-undo .
      426       define variable v-param-type      as character no-undo .
      427       define variable v-email       as character no-undo .
      428       define variable v-tmp-str     as character no-undo .
      429       define variable v-tmp1-str    as character no-undo .
      430       define variable v-ind         as integer   no-undo .
      431       define variable v-num-entries as integer   no-undo .
      432       delete object v-tth no-error.
      433       run adm/shattri.p
      434         ( input "get":U
      435          ,input  "":U
      436          ,input  0
      437          ,input  'auto-task':U
      438          ,input  'send-msg-to-email':U
      439          ,output v-value-character
      440          ,output v-value-date
      441          ,output v-value-decimal
      442          ,output v-value-integer
      443          ,output v-value-logical
      444          ,output v-param-type
      445          ,input-output table-handle v-tth
      446         ) no-error .
      447       if not error-status :error  then do:
      448         assign
      449           v-tmp-str = v-value-character
      450         .
      451       end.
      452       delete object v-tth no-error.
      453       assign
      454         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      455         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      456         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      457         v-num-entries = num-entries( v-tmp-str, chr(44) )
      458         v-email       = "":U
      459       .
      460       do v-ind = 1 to v-num-entries
      461       :
      462         assign
      463           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      464         .
      465         if trim( v-tmp1-str ) <> "":U then do:
      466           if v-email = "":U then do:
      467             assign
      468               v-email = v-tmp1-str
      469             .
      470           end.
      471           else do:
      472             assign
      473               v-email = v-email + chr(44) + v-tmp1-str
      474             .
      475           end.
      476         end.
      477       end.
      478       if v-email <> "":U then do:
      479         run gbl/sendmail.p
      480           ( input v-email
      481           , input p-subject
      482           , input p-text-err
      483           , input p-attach-files
      484           ) no-error .
      485         if error-status :error
      486           or return-value <> "":U
      487         then do:
      488           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      489         end.
      490       end.
      491     end.
      492   end procedure.
      493   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      494   define new global shared variable g#attr-lib  as handle no-undo .
      495   define variable v-attr-lib-variable as handle no-undo .
      496   procedure db-attr-code :
      497     define input  parameter p-code           as character no-undo .
      498     define output parameter p-type           as character no-undo .
      499     define output parameter p-format         as character no-undo .
      500     define output parameter p-label          as character no-undo .
      501     define output parameter p-user-can-edit  as logical   no-undo .
      502     define output parameter p-output-display as logical   no-undo .
      503     define output parameter p-other          as character no-undo .
      504     do
      505     on error undo, return error
      506     :
      507           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-code in g#attr-lib
      508         (input  p-code
      509         ,output p-type
      510         ,output p-format
      511         ,output p-label
      512         ,output p-user-can-edit
      513         ,output p-output-display
      514         ,output p-other
      515         ) no-error .
      516       if error-status :error
      517       then do:
      518         undo, return error return-value .
      519       end.
      520     end.
      521   end procedure.
      522   procedure db-attr-tooltip :
      523     define input  parameter p-code    as character no-undo .
      524     define output parameter p-tooltip as character no-undo .
      525     define output parameter p-label   as character no-undo .
      526     do
      527     on error undo, return error
      528     :
      529           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-tooltip in g#attr-lib
      530         (input  p-code
      531         ,output p-tooltip
      532         ,output p-label
      533         ) no-error .
      534       if error-status :error
      535       then do:
      536         undo, return error return-value .
      537       end.
      538     end.
      539   end procedure.
      540   procedure db-attr-value :
      541     define input  parameter p-db-num    like ub.db-attr.db-num     no-undo .
      542     define input  parameter p-code      like ub.db-attr.attr-code  no-undo .
      543     define output parameter p-value     like ub.db-attr.attr-value no-undo .
      544     define output parameter p-type      as character no-undo .
      545     do
      546     on error undo, return error
      547     :
      548           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-value in g#attr-lib
      549         (input  p-db-num
      550         ,input  p-code
      551         ,output p-value
      552         ,output p-type
      553         ) no-error .
      554       if error-status :error
      555       then do:
      556         undo, return error return-value .
      557       end.
      558     end.
      559   end procedure.
