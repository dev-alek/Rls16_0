      662   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      663   PROCEDURE verify-ini-entry:
      664   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
      665   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
      666   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
      667   DEFINE INPUT  PARAMETER silence          as logical no-undo.
      668   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
      669   define variable v-mess as character no-undo .
      670   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
      671   if ini-entry-value = ? and ini-key-name begins "spl"
      672   then
      673   get-key-value section ini-section-name key "splall" value ini-entry-value.
      674   if ini-entry-value = ? and ini-key-name begins "sav"
      675   then
      676   get-key-value section ini-section-name key "savall" value ini-entry-value.
      677   if ini-entry-value = ? then do:
      678     assign
      679     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
      680                       , chr(10)
      681                       , ini-section-name
      682                       , ini-key-name
      683                       , error-msg-text).
      684       if not silence then do:
      685         message
      686         v-mess
      687         view-as alert-box ERROR  .
      688         return error.
      689       end.
      690       else do:
      691         return error v-mess.
      692       end.
      693   end.
      694   END PROCEDURE.
      695   PROCEDURE verify-file:
      696   DEFINE INPUT  PARAMETER filename       as character no-undo.
      697   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
      698   DEFINE INPUT  PARAMETER silence        as logical no-undo.
      699   DEFINE OUTPUT PARAMETER found          as logical no-undo.
      700   file-info:file-name = filename.
      701   found = NOT (file-info:full-pathname = ?).
      702   if NOT found  then do:
      703     if not silence then do:
      704       message error-msg-text
      705       view-as alert-box ERROR.
      706       return error.
      707     end.
      708     else return error error-msg-text.
      709   end.
      710   END PROCEDURE.
      711   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      712     function get-attr-code returns character (input p-task-type as character ).
      713       define variable v-db-attr-code as character no-undo .
      714       case p-task-type :
      715         when 'autonws':U then do:
      716           assign
      717             v-db-attr-code = 'schedule-nws':U.
      718           .
      719         end.
      720         when 'autoarh':U then do:
      721           assign
      722             v-db-attr-code = 'schedule-arc':U
      723           .
      724         end.
      725         when 'autoexp':U then do:
      726           assign
      727             v-db-attr-code = 'schedule-exp':U
      728           .
      729         end.
      730         when 'autooxml':U then do:
      731           assign
      732             v-db-attr-code = 'schedule-oxml':U
      733           .
      734         end.
      735         when 'autogcd':U then do:
      736           assign
      737             v-db-attr-code = 'schedule-getcd':U
      738           .
      739         end.
      740         when 'autosale':U then do:
      741           assign
      742             v-db-attr-code = 'schedule-sale':U
      743           .
      744         end.
      745         when 'autosuz':U then do:
      746           assign
      747             v-db-attr-code = 'schedule-suz':U
      748           .
      749         end.
      750         when 'autocbnk':U then do:
      751           assign
      752             v-db-attr-code = 'schedule-cbnk':U
      753           .
      754         end.
      755         when 'autofree':U then do:
      756           assign
      757             v-db-attr-code = 'schedule-free':U
      758           .
      759         end.
      760         when 'mercury':U then do:
      761           assign
      762             v-db-attr-code = 'schedule-merc':U
      763           .
      764         end.
      765         when 'hddtest':U then do:
      766           assign
      767             v-db-attr-code = 'schedule-hdd':U
      768           .
      769         end.
      770         when 'is_motp':U then do:
      771           assign
      772             v-db-attr-code = 'schedule-motp':U
      773           .
      774         end.
      775         when 'is_diadoc':U then do:
      776           assign
      777             v-db-attr-code = 'schedule-diadoc':U
      778           .
      779         end.
      780         when 'is_PM':U then do:
      781           assign
      782             v-db-attr-code = 'schedule-isPM':U
      783           .
      784         end.
      785         otherwise do:
      786           assign
      787             v-db-attr-code = ?
      788           .
      789         end.
      790       end.
      791       return v-db-attr-code.
      792     end function.
      793   function get-str-type returns character (input p-task-type as character ).
      794     define variable v-str as character no-undo .
      795     case p-task-type :
      796       when 'autonws':U then do:
      797         assign
      798           v-str = "связи с БД"
      799         .
      800       end.
      801       when 'autoarh':U then do:
      802         assign
      803           v-str = "расчета архивов по БД"
      804         .
      805       end.
      806       when 'autoexp':U then do:
      807         assign
      808           v-str = "экспорта по БД"
      809         .
      810       end.
      811       when 'autooxml':U then do:
      812         assign
      813           v-str = "OpenXML по БД"
      814         .
      815       end.
      816       when 'autogcd':U then do:
      817         assign
      818           v-str = "приема информации с касс по БД"
      819         .
      820       end.
      821       when 'autosale':U then do:
      822         assign
      823           v-str = "работы с документами продажи по БД"
      824         .
      825       end.
      826       when 'autosuz':U then do:
      827         assign
      828           v-str = "запуска отчетов по БД"
      829         .
      830       end.
      831       when 'autocbnk':U then do:
      832         assign
      833           v-str = "эксп/имп в КЛИЕНТ-БАНК"
      834         .
      835       end.
      836       when 'autofree':U then do:
      837         assign
      838           v-str = "выполнение произ.заданий"
      839         .
      840       end.
      841       when 'mercury':U then do:
      842         assign
      843           v-str = "обмена с ФГИС Меркурий по БД"
      844         .
      845       end.
      846       when 'hddtest':U then do:
      847         assign
      848           v-str = "мониторинга HDD по БД"
      849         .
      850       end.
      851       when 'is_motp':U then do:
      852         assign
      853           v-str = "обмена с ИС МОТП по БД"
      854         .
      855       end.
      856       when 'is_diadoc':U then do:
      857         assign
      858           v-str = "обмена с ИС Диадок по БД"
      859         .
      860       end.
      861       when 'is_diadoc':U then do:
      862         assign
      863           v-str = "выгрузки в ИС Президентский мониторинг по БД"
      864         .
      865       end.
      866       otherwise do:
      867         assign
      868           v-str = "экспорта по БД"
      869         .
      870       end.
      871     end.
      872     return v-str.
      873   end function.
      874   procedure push-abtpr :
      875     define input parameter parparentproc as handle    no-undo .
      876     define input parameter p-db-num      as integer   no-undo .
      877     define input parameter p-task-type   as character no-undo .
      878     define input parameter p-start-type  as character no-undo .
      879     define input parameter p-date        as date      no-undo .
      880     define input parameter p-time        as integer   no-undo .
      881     do
      882     on error undo, return error
      883     :
      884       define buffer buf_BatchProcess for ub.BatchProcess .
      885       define buffer buf_sys-ctrl     for ub.sys-ctrl .
      886       define variable v-curr-date as date      no-undo .
      887       define variable v-curr-time as integer   no-undo .
      888       define variable v-str       as character no-undo .
      889       define variable v-user-id   as character no-undo .
      890       run cur-time in this-procedure
      891         ( output v-curr-date
      892          ,output v-curr-time
      893         ) no-error.
      894       if error-status :error then do:
      895         return error substitute( "&1. Ошибка при определении текущей даты!", vss-include-info5 ).
      896       end.
      897       if p-date = ? then do:
      898         assign
      899           p-date = v-curr-date
      900         .
      901       end.
      902       if p-time = ? then do:
      903         assign
      904           p-time = v-curr-time
      905         .
      906       end.
      907       assign
      908         v-str = get-str-type( p-task-type )
      909       .
      910       if v-str = ? then do:
      911         return error substitute( "&1. НЕТ ОБРАБОТКИ АТРИБУТА &2!", vss-include-info5, p-task-type ).
      912       end.
      913       run get-userid in parparentproc
      914         ( output v-user-id
      915         ).
      916       find first buf_sys-ctrl no-lock .
      917       find first buf_BatchProcess no-lock
      918         where buf_BatchProcess.BP_Status   = 'N':U
      919           and buf_BatchProcess.BP_Type     = p-task-type
      920           and buf_BatchProcess.CharKey_One = string( p-db-num )
      921           and buf_BatchProcess.CharKey_Two = "auto":U
      922         no-error
      923       .
      924       if available buf_BatchProcess
      925         and ( buf_BatchProcess.BP_ExecSysDate < v-curr-date
      926               or (buf_BatchProcess.BP_ExecSysDate = v-curr-date
      927                   and buf_BatchProcess.BP_ExecSysTimeInt < v-curr-time
      928                   )
      929             )
      930       then do:
      931         return error substitute( "Автоматический режим &1 для БД &2 не запущен или в данный момент идет обработка!"
      932                                 ,v-str ,p-db-num
      933                               ).
      934       end.
      935       find first buf_BatchProcess exclusive-lock
      936         where buf_BatchProcess.BP_Status   = 'N':U
      937           and buf_BatchProcess.BP_Type     = p-task-type
      938           and buf_BatchProcess.CharKey_One = string( p-db-num )
      939           and buf_BatchProcess.CharKey_Two = p-start-type
      940         no-error
      941       .
      942       if not available buf_BatchProcess then do:
      943         create buf_BatchProcess.
      944         assign
      945           buf_BatchProcess.BatchProcess# = next-value (s-btpr, ub)
      946           buf_BatchProcess.BP_Status     = 'N':U
      947           buf_BatchProcess.BP_Type       = p-task-type
      948           buf_BatchProcess.CharKey_One   = string( p-db-num )
      949           buf_BatchProcess.CharKey_Two   = p-start-type
      950         .
      951       end.
      952       assign
      953         buf_BatchProcess.CharKey_Three     = string( buf_sys-ctrl.db-num ) + chr(3) + p-task-type + chr(3) + "-1":U
      954         buf_BatchProcess.User_ID           = v-user-id
      955         buf_BatchProcess.Key#_One          = (if p-start-type = "manual":U then 1 else 0)
      956         buf_BatchProcess.BP_SysDate        = v-curr-date
      957         buf_BatchProcess.BP_SysTimeInt     = v-curr-time
      958         buf_BatchProcess.BP_SysTime        = string(v-curr-time, 'HH:MM:SS':U)
      959         buf_BatchProcess.BP_ExecSysDate    = p-date
      960         buf_BatchProcess.BP_ExecSysTimeInt = p-time
      961         buf_BatchProcess.BP_ExecSysTime    = string(p-time, 'HH:MM:SS':U)
      962       .
      963     end.
      964     return.
      965   end procedure.
      966   do
      967   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      968   on stop   undo, return error substitute( "&1. stop", vss-workfile )
      969   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      970   :
      971     define temp-table tt-db no-undo
      972       field db-num as integer
      973       index pi is unique primary
      974         db-num ascending
      975     .
      976     define buffer buf_sys-ctrl         for ub.sys-ctrl .
      977     define buffer buf_db               for ub.db .
      978     define buffer buf_schedule         for ub.schedule .
      979     define buffer buf_BatchProcess     for ub.BatchProcess .
      980     define buffer buf-all_BatchProcess for ub.BatchProcess .
      981     define variable v-str           as character no-undo .
      982     define variable v-db-attr-value as character no-undo .
      983     define variable v-db-attr-type  as character no-undo .
      984     define variable v-db-attr-code  as character no-undo .
      985     define variable v-db-attr-exist as logical   no-undo .
      986     define variable v-db-attr-del   as logical   no-undo .
      987     define variable v-time          as integer   no-undo .
      988     define variable v-today         as date      no-undo .
      989     define variable v-new-time      as character no-undo .
      990     define variable v-new-date      as date      no-undo .
      991     define variable v-user-id       as character no-undo .
      992     define variable v-process       as character no-undo .
      993     define variable v-chg-manual    as logical   no-undo .
      994     define variable v-out           as character no-undo.
      995     define variable vWaitNextRunTime as logical no-undo.
      996     run cur-time( output v-today
      997                  ,output v-time
      998                 ) no-error.
      999     if error-status :error then do:
     1000       run write-to-log( vss-workfile + chr(32)
     1001                         + "Ошибка при определении текущего времени"
     1002                       ) .
     1003     end.
     1004     run verify-ini-entry in this-procedure (
     1005                                            input  'WaitNextRunTime'
     1006                                           ,input    'schedule-free'
     1007                                           ,input substitute("отсутствует параметр &1 секция &2 в ini-файле"
     1008                                                             , 'WaitNextRunTime'
     1009                                                             , 'schedule-free')
     1010                                           ,input yes
     1011                                           ,output v-out) no-error.
     1012     if    not error-status:error
     1013        and v-out ne ?
     1014        and v-out ne ""
     1015     then
     1016        vWaitNextRunTime =  logical( v-out) no-error.
     1017     assign
     1018       v-str          = get-str-type( p-task-type )
     1019       v-db-attr-code = get-attr-code( p-task-type )
     1020     .
     1021     if v-str = ? then do:
     1022       return error string( vss-workfile + chr(32) + "НЕТ ОБРАБОТКИ АТРИБУТА" + chr(32) + p-task-type ) .
     1023     end.
     1024     assign
     1025       p-list-db = "":U
     1026     .
     1027     find first buf_sys-ctrl no-lock.
     1028     if trim( buf_sys-ctrl.status_ ) <> "":U then do:
     1029       return error substitute( "&1. При статусе БД равном &2 работа сеанса &3 не допускается!"
     1030                                ,vss-workfile
     1031                                ,buf_sys-ctrl.status_
     1032                                ,v-str
     1033                               ) .
     1034     end.
     1035     for each tt-db
     1036     on error undo, return error return-value
     1037     :
     1038       delete tt-db.
     1039     end.
     1040     for each buf_schedule no-lock
     1041       where buf_schedule.task-type = p-task-type
     1042         and buf_schedule.db-num-char <> "*":U
     1043     on error undo, return error return-value
     1044     :
     1045       if buf_schedule.active = true then do:
     1046         run gbl/prcs-lst.p
     1047           ( input buf_schedule.db-num-char
     1048           , input 0
     1049           , input 99999
     1050           , input false
     1051           , input (buffer tt-db:handle)
     1052           , input "db-num":U
     1053           ) no-error .
     1054       end.
     1055     end.
     1056     block1_db:
     1057     for each buf_db no-lock
     1058     on error undo, return error return-value
     1059     :
     1060       find first buf_schedule no-lock
     1061         where buf_schedule.task-type   = p-task-type
     1062           and buf_schedule.db-num-char = "*":U
     1063           and buf_schedule.active      = true
     1064         no-error
     1065       .
     1066       if not available buf_schedule then do:
     1067         find first tt-db no-lock
     1068           where tt-db.db-num = buf_db.db-num
     1069           no-error
     1070         .
     1071         if not available tt-db then do:
     1072           run db-attr-exist ( input buf_db.db-num
     1073                              ,input v-db-attr-code
     1074                              ,output v-db-attr-exist
     1075                             ) no-error.
     1076           if error-status :error then do:
     1077             run write-to-log( substitute( "&1. Ошибка при определении наличия атрибута расписания для БД &2"
     1078                                           ,vss-workfile
     1079                                           ,buf_db.db-num
     1080                                         )
     1081                             ) .
     1082           end.
     1083           if v-db-attr-exist = true then do:
     1084             run db-attr-value ( input buf_db.db-num
     1085                                ,input v-db-attr-code
     1086                                ,output v-db-attr-value
     1087                                ,output v-db-attr-type
     1088                               ) no-error.
     1089             if error-status :error then do:
     1090               run write-to-log( substitute( "&1. Ошибка при чтении атрибута наличия расписания для БД &2"
     1091                                             ,vss-workfile
     1092                                             ,buf_db.db-num
     1093                                           )
     1094                               ) .
     1095             end.
     1096             if v-db-attr-value = "yes":U then do:
     1097               run db-attr-delete ( input buf_db.db-num
     1098                                   ,input v-db-attr-code
     1099                                   ,output v-db-attr-del
     1100                                 ) no-error.
     1101               if error-status :error
     1102                 or v-db-attr-del = false
     1103               then do:
     1104                 run write-to-log( substitute( "&1. Ошибка при удалении атрибута отсутствия расписания для БД &2&3"
     1105                                               ,vss-workfile
     1106                                               ,buf_db.db-num
     1107                                               ,chr(10)
     1108                                               ,return-value
     1109                                             )
     1110                                 ) .
     1111               end.
     1112             end.
     1113             next block1_db.
     1114           end.
     1115         end.
     1116       end.
     1117       find first buf_BatchProcess no-lock
     1118         where buf_BatchProcess.BP_Status   = 'N':U
     1119           and buf_BatchProcess.BP_Type     = p-task-type
     1120           and buf_BatchProcess.CharKey_One = string( buf_db.db-num )
     1121           and buf_BatchProcess.CharKey_Two = "auto":U
     1122           and (p-task-type <> 'autooxml':U or
     1123                 (p-task-type = 'autooxml':U and
     1124                   (  (num-entries (buf_BatchProcess.CharKey_Three, chr(3)) <= 3 and p-for-extsys = ""
     1125                       )
     1126                   or (p-for-extsys <> ""
     1127                       and num-entries (buf_BatchProcess.CharKey_Three, chr(3)) > 3
     1128                       and entry (4, buf_BatchProcess.CharKey_Three, chr(3)) = p-for-extsys
     1129                       )
     1130                    )
     1131                  )
     1132                )
     1133             and (p-task-type <> 'autofree':U or
     1134                   (p-task-type = 'autofree':U and
     1135                     (  (num-entries (buf_BatchProcess.CharKey_Three, chr(3)) <= 3 and p-for-proc = ""
     1136                         )
     1137                     or (p-for-proc <> ""
     1138                         and num-entries (buf_BatchProcess.CharKey_Three, chr(3)) > 3
     1139                         and entry (4, buf_BatchProcess.CharKey_Three, chr(3)) = p-for-proc
     1140                         )
     1141                      )
     1142                    )
     1143                  )
     1144         no-error
     1145       .
     1146       if not available buf_BatchProcess then do:
     1147         run db-attr-exist ( input buf_db.db-num
     1148                             ,input v-db-attr-code
     1149                             ,output v-db-attr-exist
     1150                           ) no-error.
     1151         if error-status :error then do:
     1152           run write-to-log( substitute( "&1. Ошибка при определении наличия атрибута расписания для БД &2"
     1153                                         ,vss-workfile
     1154                                         ,buf_db.db-num
     1155                                       )
     1156                           ) .
     1157         end.
     1158         if v-db-attr-exist then do:
     1159           run db-attr-write ( input buf_db.db-num
     1160                               ,input v-db-attr-code
     1161                               ,input "no":U
     1162                             ) no-error.
     1163           if error-status :error then do:
     1164             run write-to-log( substitute( "&1. Ошибка при записи атрибута отсутствия расписания для БД &2"
     1165                                           ,vss-workfile
     1166                                           ,buf_db.db-num
     1167                                         )
     1168                             ) .
     1169           end.
     1170         end.
     1171       end.
     1172     end.
     1173     for each tt-db
     1174     on error undo, return error return-value
     1175     :
     1176       delete tt-db.
     1177     end.
     1178     for each buf_db no-lock
     1179     on error undo, return error
     1180     :
     1181       if p-task-type = 'autonws':U
     1182          and ( ( buf_sys-ctrl.db-num = 0
     1183                  and buf_db.db-num = 0
     1184                )
     1185                or ( buf_sys-ctrl.db-num <> 0
     1186                     and buf_db.db-num <> 0
     1187                   )
     1188              )
     1189       then do:
     1190         next.
     1191       end.
     1192       if p-task-type = 'autooxml':U
     1193          and ( ( buf_sys-ctrl.db-num = 0
     1194                  and buf_db.db-num <> 0
     1195                )
     1196                or ( buf_sys-ctrl.db-num <> 0
     1197                     and buf_db.db-num <> buf_sys-ctrl.db-num
     1198                   )
     1199              )
     1200       then do:
     1201         next.
     1202       end.
     1203       if p-for-db <> "":U
     1204         and lookup( string( buf_db.db-num), p-for-db ) = 0
     1205       then do:
     1206         next.
     1207       end.
     1208       find first buf_BatchProcess exclusive-lock
     1209         where buf_BatchProcess.BP_Status   = 'N':U
     1210           and buf_BatchProcess.BP_Type     = p-task-type
     1211           and buf_BatchProcess.CharKey_One = string( buf_db.db-num )
     1212           and buf_BatchProcess.CharKey_Two = "auto":U
     1213           and (p-task-type <> 'autooxml':U or
     1214                 (p-task-type = 'autooxml':U and
     1215                   (  (num-entries (buf_BatchProcess.CharKey_Three, chr(3)) <= 3 and p-for-extsys = ""
     1216                       )
     1217                   or (p-for-extsys <> ""
     1218                       and num-entries (buf_BatchProcess.CharKey_Three, chr(3)) > 3
     1219                       and entry (4, buf_BatchProcess.CharKey_Three, chr(3)) = p-for-extsys
     1220                       )
     1221                    )
     1222                  )
     1223                )
     1224             and (p-task-type <> 'autofree':U or
     1225                   (p-task-type = 'autofree':U and
     1226                     (  (num-entries (buf_BatchProcess.CharKey_Three, chr(3)) <= 3 and p-for-proc = ""
     1227                         )
     1228                     or (p-for-proc <> ""
     1229                         and num-entries (buf_BatchProcess.CharKey_Three, chr(3)) > 3
     1230                         and entry (4, buf_BatchProcess.CharKey_Three, chr(3)) = p-for-proc
     1231                         )
     1232                      )
     1233                    )
     1234                  )
     1235         no-error
     1236       .
     1237       if available buf_BatchProcess then do:
     1238         for each buf-all_BatchProcess exclusive-lock
     1239           where buf-all_BatchProcess.BP_Status   = 'N':U
     1240             and buf-all_BatchProcess.BP_Type     = p-task-type
     1241             and buf-all_BatchProcess.CharKey_One = string( buf_db.db-num )
     1242             and buf-all_BatchProcess.CharKey_Two = "auto":U
     1243             and (p-task-type <> 'autooxml':U or
     1244                   (p-task-type = 'autooxml':U and
     1245                     (  (num-entries (buf-all_BatchProcess.CharKey_Three, chr(3)) <= 3 and p-for-extsys = ""
     1246                         )
     1247                     or (p-for-extsys <> ""
     1248                         and num-entries (buf-all_BatchProcess.CharKey_Three, chr(3)) > 3
     1249                         and entry (4, buf-all_BatchProcess.CharKey_Three, chr(3)) = p-for-extsys
     1250                         )
     1251                      )
     1252                    )
     1253                  )
     1254             and (p-task-type <> 'autofree':U or
     1255                   (p-task-type = 'autofree':U and
     1256                     (  (num-entries (buf-all_BatchProcess.CharKey_Three, chr(3)) <= 3 and p-for-proc = ""
     1257                         )
     1258                     or (p-for-proc <> ""
     1259                         and num-entries (buf-all_BatchProcess.CharKey_Three, chr(3)) > 3
     1260                         and entry (4, buf-all_BatchProcess.CharKey_Three, chr(3)) = p-for-proc
     1261                         )
     1262                      )
     1263                    )
     1264                  )
     1265         on error undo, return error
     1266         :
     1267           if buf-all_BatchProcess.BatchProcess# <> buf_BatchProcess.BatchProcess# then do:
     1268             delete buf-all_BatchProcess.
     1269           end.
     1270         end.
     1271       end.
     1272       assign
     1273         v-process    = "":U
     1274         v-chg-manual = false
     1275       .
     1276       for each buf-all_BatchProcess exclusive-lock
     1277          where buf-all_BatchProcess.BP_Status   = 'N':U
     1278            and buf-all_BatchProcess.BP_Type     = p-task-type
     1279            and buf-all_BatchProcess.CharKey_One = string( buf_db.db-num )
     1280       on error undo, return error
     1281       :
     1282         if buf-all_BatchProcess.CharKey_Two <> "auto":U then do:
     1283           if v-chg-manual = false then do:
     1284             if not available buf_BatchProcess then do:
     1285               create buf_BatchProcess .
     1286               buffer-copy buf-all_BatchProcess to buf_BatchProcess
     1287                 assign
     1288                   buf_BatchProcess.BatchProcess# = next-value (s-btpr, ub)
     1289                   buf_BatchProcess.CharKey_Two   = "auto":U
     1290                 .
     1291             end.
     1292             if buf-all_BatchProcess.CharKey_Two = "manual":U
     1293               or
     1294               ( buf-all_BatchProcess.BP_ExecSysDate < buf_BatchProcess.BP_ExecSysDate
     1295                 or ( buf-all_BatchProcess.BP_ExecSysDate = buf_BatchProcess.BP_ExecSysDate
     1296                     and buf-all_BatchProcess.BP_ExecSysTimeInt < buf_BatchProcess.BP_ExecSysTimeInt
     1297                   )
     1298               )
     1299             then do:
     1300               buffer-copy buf-all_BatchProcess except BatchProcess# CharKey_Two to buf_BatchProcess .
     1301               assign
     1302                 v-process  = buf-all_BatchProcess.CharKey_Two
     1303                 v-new-date = buf-all_BatchProcess.BP_ExecSysDate
     1304                 v-new-time = buf-all_BatchProcess.BP_ExecSysTime
     1305                 v-user-id  = buf-all_BatchProcess.User_ID
     1306               .
     1307               if buf-all_BatchProcess.CharKey_Two = "manual":U then do:
     1308                 assign
     1309                   v-chg-manual = true
     1310                 .
     1311               end.
     1312             end.
     1313           end.
     1314           delete buf-all_BatchProcess.
     1315         end.
     1316       end.
     1317       if v-process <> "":U then do:
     1318         run write-to-log( substitute( "Следующий сеанс &1 &2 после &3 &4 (изменил &5) (&6)"
     1319                                       ,v-str
     1320                                       ,buf_db.db-num
     1321                                       ,v-new-time
     1322                                       ,string( v-new-date , "99.99.9999" )
     1323                                       ,v-user-id
     1324                                       ,v-process
     1325                                     )
     1326                         ) .
     1327       end.
     1328       find first buf_BatchProcess no-lock
     1329         where buf_BatchProcess.BP_Status         = 'N':U
     1330           and buf_BatchProcess.BP_Type           = p-task-type
     1331           and buf_BatchProcess.CharKey_One       = string( buf_db.db-num )
     1332           and buf_BatchProcess.CharKey_Two       = "auto":U
     1333           and ( buf_BatchProcess.BP_ExecSysDate < v-today
     1334                 or (buf_BatchProcess.BP_ExecSysDate = v-today
     1335                     and buf_BatchProcess.BP_ExecSysTimeInt < v-time
     1336                   )
     1337               )
     1338           and (p-task-type <> 'autooxml':U or
     1339                 (p-task-type = 'autooxml':U and
     1340                   (  (num-entries (buf_BatchProcess.CharKey_Three, chr(3)) <= 3 and p-for-extsys = ""
     1341                       )
     1342                   or (p-for-extsys <> ""
     1343                       and num-entries (buf_BatchProcess.CharKey_Three, chr(3)) > 3
     1344                       and entry (4, buf_BatchProcess.CharKey_Three, chr(3)) = p-for-extsys
     1345                       )
     1346                    )
     1347                  )
     1348                )
     1349           and (p-task-type <> 'autofree':U or
     1350                 (p-task-type = 'autofree':U and
     1351                   (  (num-entries (buf_BatchProcess.CharKey_Three, chr(3)) <= 3 and p-for-proc = ""
     1352                       )
     1353                   or (p-for-proc <> ""
     1354                       and num-entries (buf_BatchProcess.CharKey_Three, chr(3)) > 3
     1355                       and entry (4, buf_BatchProcess.CharKey_Three, chr(3)) = p-for-proc
     1356                       )
     1357                    )
     1358                  )
     1359                )
     1360         no-error
     1361       .
     1362       if available buf_BatchProcess then do:
     1363          if p-list-db = "":U then do:
     1364           assign
     1365             p-list-db  = string( buf_db.db-num )
     1366             p-list-key = buf_BatchProcess.CharKey_Three
     1367           .
     1368         end.
     1369         else do:
     1370           assign
     1371             p-list-db  = p-list-db + chr(44) + string( buf_db.db-num )
     1372             p-list-key = p-list-key + chr(1) + buf_BatchProcess.CharKey_Three
     1373           .
     1374         end.
     1375       end.
     1376        for each buf_BatchProcess no-lock
     1377            where buf_BatchProcess.BP_Status         = 'N':U
     1378              and buf_BatchProcess.BP_Type           = p-task-type
     1379              and buf_BatchProcess.CharKey_One       = string( buf_db.db-num )
     1380              and buf_BatchProcess.CharKey_Two       = "auto":U
     1381              and ( buf_BatchProcess.BP_ExecSysDate > v-today
     1382                    or (buf_BatchProcess.BP_ExecSysDate = v-today
     1383                        and buf_BatchProcess.BP_ExecSysTimeInt > v-time
     1384                      )
     1385                  )
     1386              and (p-task-type <> 'autooxml':U or
     1387                    (p-task-type = 'autooxml':U and
     1388                      (  (num-entries (buf_BatchProcess.CharKey_Three, chr(3)) <= 3 and p-for-extsys = ""
     1389                          )
     1390                      or (p-for-extsys <> ""
     1391                          and num-entries (buf_BatchProcess.CharKey_Three, chr(3)) > 3
     1392                          and entry (4, buf_BatchProcess.CharKey_Three, chr(3)) = p-for-extsys
     1393                          )
     1394                       )
     1395                     )
     1396                   )
     1397              and (p-task-type <> 'autofree':U or
     1398                    (p-task-type = 'autofree':U and
     1399                      (  (num-entries (buf_BatchProcess.CharKey_Three, chr(3)) <= 3 and p-for-proc = ""
     1400                          )
     1401                      or (p-for-proc <> ""
     1402                          and num-entries (buf_BatchProcess.CharKey_Three, chr(3)) > 3
     1403                          and entry (4, buf_BatchProcess.CharKey_Three, chr(3)) = p-for-proc
     1404                          )
     1405                       )
     1406                     )
     1407                   )
     1408        :
     1409           if vWaitNextRunTime
     1410           then do:
     1411              create tt-BatchProcess.
     1412              buffer-copy buf_BatchProcess to tt-BatchProcess .
     1413           end.
     1414           if p-list-db = "":U then do:
     1415           assign
     1416             p-list-db-all  = string( buf_db.db-num )
     1417             p-list-key-all = buf_BatchProcess.CharKey_Three
     1418           .
     1419         end.
     1420         else do:
     1421           assign
     1422             p-list-db-all  = p-list-db-all  + chr(44) + string( buf_db.db-num )
     1423             p-list-key-all = p-list-key-all + chr(1) + buf_BatchProcess.CharKey_Three
     1424           .
     1425         end.
     1426        end.
     1427     end.
     1428     run gbl/delatrlb.p .
     1429   end.
