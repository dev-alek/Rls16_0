      625   procedure proc-alt-shift-f2:
      626     if not ibs.th.gbl.gbl-var:rcode
      627   then
      628     run gbl\inidebug.p .
      629   end.
      630   procedure proc-alt-shift-f3:
      631     run gbl/prvssinf.p
      632       ( input this-procedure
      633       ) .
      634   end.
      635   define variable v-inform-launched as logical no-undo initial false .
      636   procedure proc-alt-shift-f4:
      637     define variable v-action as character no-undo .
      638     if v-inform-launched = false then do:
      639       assign
      640         v-inform-launched = true
      641       .
      642       run gbl/d-inform.w
      643         (  input self
      644         ,  input this-procedure
      645         , output v-action
      646         ) no-error .
      647       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      648       assign
      649         v-inform-launched = false
      650       .
      651     end.
      652   end.
      653   procedure proc-alt-f1:
      654     run gbl/corrhelp.p
      655       (input this-procedure
      656       ) .
      657   end .
      658   on alt-shift-f2 anywhere do:
      659     run proc-alt-shift-f2.
      660   end.
      661   on alt-shift-f3 anywhere do:
      662     run proc-alt-shift-f3 in this-procedure .
      663   end.
      664   on alt-shift-f4 anywhere do:
      665     run proc-alt-shift-f4 in this-procedure.
      666   end.
      667   on alt-f1 anywhere do:
      668     run proc-alt-f1 in this-procedure .
      669   end.
      670   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      671     define variable v-cntxt-db-num        as integer   no-undo .
      672     define variable v-cntxt-userid        as character no-undo .
      673     define variable v-cntxt-level         as character no-undo .
      674     define variable v-cntxt-host-code-obj as integer   no-undo .
      675     define variable v-cntxt-obj-type      as character no-undo .
      676     define variable v-cntxt-obj-code      as integer   no-undo .
      677     define variable v-cntxt-db-num-obj    as integer   no-undo .
      678     define variable v-cntxt-is-admin      as logical   no-undo .
      679   DEFINE VARIABLE v-db-num LIKE ub.db.db-num NO-UNDO.
      680   DEFINE VARIABLE v-host-code LIKE ub.shop.host-code NO-UNDO.
      681   DEFINE VARIABLE v-to-create AS logical NO-UNDO.
      682   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      683   define variable v-tth as handle no-undo .
      684   assign
      685   v-tth = buffer thbjattr_thbj-attr:table-handle .
      686   DEFINE BUTTON B-exit AUTO-GO
      687        LABEL "&Ввод"
      688        SIZE 10 BY 1
      689        BGCOLOR 8 .
      690   DEFINE BUTTON B-Help
      691        LABEL "&Помощь"
      692        SIZE 10 BY 1
      693        BGCOLOR 8 .
      694   DEFINE BUTTON b-quit AUTO-END-KEY
      695        LABEL "&Отмена"
      696        SIZE 10 BY 1
      697        BGCOLOR 8 .
      698   DEFINE BUTTON r-obj-firm
      699        IMAGE-UP FILE "btn-down-arrow":U
      700        IMAGE-DOWN FILE "btn-down-arrow":U
      701        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      702        LABEL ""
      703        SIZE 3 BY 1 TOOLTIP "Выбор из списка объектов".
      704   DEFINE VARIABLE v-obj-code AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
      705        LABEL "Объект посредник"
      706         VIEW-AS TEXT
      707        SIZE 9.5 BY .67 NO-UNDO.
      708   DEFINE VARIABLE v-obj-name AS CHARACTER FORMAT "X(40)":U
      709         VIEW-AS TEXT
      710        SIZE 31 BY .67
      711        FGCOLOR 4  NO-UNDO.
      712   DEFINE VARIABLE v-obj-type AS CHARACTER FORMAT "X(3)":U
      713         VIEW-AS TEXT
      714        SIZE 3.5 BY .67 NO-UNDO.
      715   DEFINE VARIABLE RS-alias-type-price AS INTEGER
      716        VIEW-AS RADIO-SET VERTICAL
      717        RADIO-BUTTONS
      718             "Item 1", 1,
      719   "Item 2", 2,
      720   "Item 3", 3
      721        SIZE 64.5 BY 4.25 NO-UNDO.
      722   DEFINE FRAME Dialog-Frame
      723        B-exit AT ROW 1 COL 1
      724        b-quit AT ROW 1 COL 11
      725        B-Help AT ROW 1 COL 21
      726        RS-alias-type-price AT ROW 2.25 COL 2 NO-LABEL
      727        r-obj-firm AT ROW 7 COL 35.5
      728        v-obj-code AT ROW 7.25 COL 19 COLON-ALIGNED
      729        v-obj-type AT ROW 7.25 COL 29.5 COLON-ALIGNED NO-LABEL
      730        v-obj-name AT ROW 7.25 COL 36.5 COLON-ALIGNED NO-LABEL
      731        SPACE(12.87) SKIP(2.11)
      732       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      733            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      734            TITLE "Тип цены межфирменного и внутреннего перемещения при продаже товара другой фирмой"
      735            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      736   ASSIGN
      737          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      738          FRAME Dialog-Frame:HIDDEN           = TRUE.
      739   ON GO OF FRAME Dialog-Frame
      740   DO:
      741     run proc-save IN THIS-PROCEDURE NO-ERROR.
      742     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      743   END.
      744   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      745   DO:
      746     APPLY "END-ERROR":U TO SELF.
      747   END.
      748   ON CHOOSE OF r-obj-firm IN FRAME Dialog-Frame
      749   DO:
      750   DEFINE buffer b#clients for ub.clients.
      751   define variable  rid-list AS CHAR NO-UNDO.
      752   define variable rep-rec2 as recid no-undo .
      753   run ref/cli-all.w ( parParentProc, input "b-sel", 'маг':U, ?, ?, ?, ?, ?, output  rid-list).
      754   Assign rep-rec2 = integer(rid-list) no-error.
      755   find first b#clients WHERE recid(b#clients) = rep-rec2 No-LOCK No-ERROR.
      756         if avail b#clients then do:
      757             Assign
      758                 v-obj-code = b#clients.obj-code
      759                 v-obj-type = b#clients.obj-type
      760                 v-obj-name = b#clients.obj-name .
      761         end.
      762         Display   v-obj-code  v-obj-name  v-obj-type
      763         with frame Dialog-Frame .
      764   END.
      765   ON VALUE-CHANGED OF RS-alias-type-price IN FRAME Dialog-Frame
      766   DO:
      767     ASSIGN rs-alias-type-price.
      768     IF  rs-alias-type-price = INTEGER('4':U) THEN DO:
      769         DISPLAY r-obj-firm v-obj-code v-obj-name v-obj-type WITH FRAME Dialog-Frame.
      770         ENABLE  r-obj-firm  WITH FRAME Dialog-Frame.
      771     END.
      772     ELSE DO:
      773         HIDE r-obj-firm v-obj-code v-obj-name v-obj-type IN FRAME Dialog-Frame.
      774     END.
      775   END.
      776   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      777   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      778   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      779   on help of frame Dialog-Frame
      780   do:
      781     run gbl/app_help.p
      782       (input this-procedure :file-name
      783       ,input ''
      784       ,input ?
      785       ) no-error.
      786     if error-status :error then do:
      787       message
      788         "Ошибка при вызове помощи"
      789         error-status :get-message(1)
      790         view-as alert-box .
      791     end.
      792   end.
      793   run minbtn-set in this-procedure .
      794   on choose of b-help in frame Dialog-Frame
      795   do:
      796     apply "help":u to frame Dialog-Frame .
      797   end.
      798   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      799   procedure minbtn-set :
      800       do
      801           on error undo, return error return-value
      802           :
      803           define variable ii              as integer       no-undo .
      804           define variable fh              as widget-handle no-undo .
      805           define variable hh              as widget-handle no-undo .
      806           define variable v-h             as handle        extent 4 no-undo .
      807           define variable v-name-button   as character     no-undo .
      808           define variable v-help-old-x    as decimal       no-undo .
      809           define variable v-help-old-y    as decimal       no-undo .
      810           define variable v-help-old-size as decimal       no-undo .
      811           define variable v-frame-width   as decimal       no-undo .
      812           define variable jj              as integer       no-undo .
      813           do
      814               on error undo, return error
      815               :
      816               assign
      817                   v-frame-width = frame Dialog-Frame:width - 0.3
      818                   fh            = frame Dialog-Frame:first-child
      819                   hh            = fh:first-child
      820                   ii            = 1
      821                   .
      822               do while valid-handle(hh):
      823                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      824                   do:
      825                       case lc(hh:name) :
      826                           when "b-help" then
      827                               do:
      828                                   hh:load-image-up("cmp/b-help.bmp":u) .
      829                                   hh:load-image-down("cmp/b-help.bmp":u) .
      830                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      831                                   hh:TOOLTIP = "Помощь" .
      832                                   v-help-old-x = hh:column .
      833                                   v-help-old-y = hh:row    .
      834                                   v-help-old-size = hh:width .
      835                                   hh:width-chars = 2.5 .
      836                               end.
      837                           when "b-print" then
      838                               do:
      839                                   hh:load-image("cmp/b-print.bmp":u) .
      840                                   hh:TOOLTIP = "Печать" .
      841                                   v-h[ii] = hh:handle .
      842                                   ii = ii + 1 .
      843                                   hh:width-chars = 3 .
      844                               end.
      845                           when "b-history" or
      846                           when "b-hist" then
      847                               do:
      848                                   hh:load-image("cmp/b-hist.bmp":u) .
      849                                   hh:TOOLTIP = "История" .
      850                                   v-h[ii] = hh:handle .
      851                                   ii = ii + 1 .
      852                                   hh:width-chars = 3 .
      853                               end.
      854                           when "b-sch" then
      855                               do:
      856                                   hh:load-image("cmp/b-sch.bmp":u) .
      857                                   hh:TOOLTIP = "Установка Фильтра" .
      858                                   v-h[ii] = hh:handle .
      859                                   ii = ii + 1 .
      860                                   hh:width-chars = 3 .
      861                               end.
      862                           when "b-hist-user" then
      863                               do:
      864                                   hh:load-image("cmp/b-hist.bmp":u) .
      865                                   hh:TOOLTIP = "История пользователя" .
      866                                   ii = ii + 1 .
      867                               end.
      868                       end case.
      869                   end.
      870                   hh = hh:next-sibling.
      871               end.
      872               b-help:column = v-frame-width - b-help:width-chars.
      873               jj = 0.
      874               repeat ii = 4 to 1 by -1 :
      875                   if valid-handle (v-h[ii] ) then
      876                   do:
      877                       jj  = jj + 1 .
      878                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      879                       v-h[ii]:row    = v-help-old-y .
      880                   end.
      881               end.
      882           end.
      883       end.
      884   end procedure.
      885   MAIN-BLOCK:
      886   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      887      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      888     IF p-mode <> 'ПРОСМОТР':U
      889     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
      890         MESSAGE
      891         vss-workfile vss-revision vss-description skip
      892         "Неверное значение параметра p-mode" p-mode
      893         VIEW-AS ALERT-BOX ERROR.
      894         UNDO, RETURN ERROR.
      895     END.
      896     IF p-obj-type <> 'маг':U
      897     and p-obj-type <> 'орг':U
      898     AND p-obj-type <> 'скл':U THEN DO:
      899         MESSAGE
      900         vss-workfile vss-revision vss-description skip
      901         "Неверное значение параметра p-obj-type" p-obj-type
      902         VIEW-AS ALERT-BOX ERROR.
      903         UNDO, RETURN ERROR.
      904     END.
      905     if p-obj-type = 'маг':U then do:
      906       FIND FIRST X_shop NO-LOCK WHERE X_shop.obj-code = p-obj-code NO-ERROR.
      907       IF NOT AVAILABLE X_shop THEN DO:
      908           MESSAGE
      909           vss-workfile vss-revision vss-description skip
      910           "Неверное значение параметра p-obj-code" p-obj-code
      911           VIEW-AS ALERT-BOX ERROR.
      912           UNDO, RETURN ERROR.
      913       END.
      914   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      915   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      916     (input  'маг':U
      917     ,input  p-obj-code
      918     ,output v-db-num
      919     )  .
      920       IF v-db-num <> v-cntxt-db-num AND v-cntxt-db-num <> 0 THEN DO:
      921           MESSAGE
      922           "Нельзя менять параметры магазина в чужой БД" skip
      923           "магазин принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
      924           VIEW-AS ALERT-BOX ERROR.
      925           UNDO, RETURN ERROR.
      926       END.
      927   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      928   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      929     (input  p-obj-type
      930     ,input  p-obj-code
      931     ,output v-host-code
      932     )  .
      933     end.
      934     if p-obj-type = 'скл':U then do:
      935       FIND FIRST X_store NO-LOCK WHERE X_store.obj-code = p-obj-code NO-ERROR.
      936       IF NOT AVAILABLE X_store THEN DO:
      937           MESSAGE
      938           vss-workfile vss-revision vss-description skip
      939           "Неверное значение параметра p-obj-code" p-obj-code
      940           VIEW-AS ALERT-BOX ERROR.
      941           UNDO, RETURN ERROR.
      942       END.
      943   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      944   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      945     (input  'маг':U
      946     ,input  p-obj-code
      947     ,output v-db-num
      948     )  .
      949       IF v-db-num <> v-cntxt-db-num AND v-cntxt-db-num <> 0 THEN DO:
      950           MESSAGE
      951           "Нельзя менять параметры склада в чужой БД" skip
      952           "магазин принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
      953           VIEW-AS ALERT-BOX ERROR.
      954           UNDO, RETURN ERROR.
      955       END.
      956   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      957   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      958     (input  p-obj-type
      959     ,input  p-obj-code
      960     ,output v-host-code
      961     )  .
      962     end.
      963     if p-obj-type = 'орг':U then do:
      964       FIND FIRST X_sysconf NO-LOCK WHERE X_sysconf.host-code = p-obj-code NO-ERROR.
      965       IF NOT AVAILABLE X_sysconf THEN DO:
      966           MESSAGE
      967           vss-workfile vss-revision vss-description skip
      968           "Неверное значение параметра p-obj-code" p-obj-code
      969           VIEW-AS ALERT-BOX ERROR.
      970           UNDO, RETURN ERROR.
      971       END.
      972       if v-cntxt-db-num <> 0
      973       and p-mode <> 'ПРОСМОТР':U
      974       then do:
      975           MESSAGE
      976           "Нельзя менять параметры ФИРМЫ в УБД" skip
      977           VIEW-AS ALERT-BOX ERROR.
      978           UNDO, RETURN ERROR.
      979       end.
      980       v-host-code = p-obj-code.
      981     end.
      982     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
      983       FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
      984                 LOCKED_thbj-attr.obj-type = p-obj-type
      985           AND   LOCKED_thbj-attr.obj-code = p-obj-code
      986           AND   LOCKED_thbj-attr.upper-prop-code = 'alias-tpsi':U
      987           AND   locked_thbj-attr.prop-code = '':U NO-WAIT NO-ERROR.
      988        if locked locked_thbj-attr then do:
      989           message
      990           vss-workfile vss-revision vss-description skip
      991            "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
      992           view-as alert-box error .
      993           undo, return error.
      994         end.
      995     END.
      996     ELSE DO:
      997         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
      998             LOCKED_thbj-attr.obj-type = p-obj-type
      999       AND   LOCKED_thbj-attr.obj-code = p-obj-code
     1000       AND   LOCKED_thbj-attr.upper-prop-code = 'alias-tpsi':U
     1001       AND   locked_thbj-attr.prop-code = '':U NO-ERROR.
     1002     END.
     1003     if not available locked_thbj-attr then do:
     1004       ASSIGN
     1005       v-to-create  = YES.
     1006       message
     1007       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     1008                   chr(10))
     1009       view-as alert-box WARNING.
     1010     end.
     1011     run FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     1012     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     1013     run Myenable in this-procedure .
     1014     WAIT-FOR GO OF FRAME Dialog-Frame.
     1015   END.
     1016   RUN disable_UI.
     1017   PROCEDURE disable_UI :
     1018     HIDE FRAME Dialog-Frame.
     1019   END PROCEDURE.
     1020   PROCEDURE enable_UI :
     1021     DISPLAY RS-alias-type-price v-obj-code v-obj-type v-obj-name
     1022         WITH FRAME Dialog-Frame.
     1023     ENABLE B-exit b-quit B-Help RS-alias-type-price v-obj-code v-obj-type
     1024            v-obj-name
     1025         WITH FRAME Dialog-Frame.
     1026     VIEW FRAME Dialog-Frame.
     1027   END PROCEDURE.
     1028   PROCEDURE fill-widgets :
     1029   define variable v-value-character as character no-undo .
     1030   define variable v-value-date as date no-undo .
     1031   define variable v-value-decimal as decimal no-undo .
     1032   define variable v-value-integer as INTEGER no-undo .
     1033   define variable v-value-logical AS LOGICAL no-undo .
     1034   define variable v-param-type as character no-undo .
     1035   define variable v-param-value as character no-undo .
     1036   FOR EACH thbjattr_thbj-attr:
     1037     delete thbjattr_thbj-attr.
     1038   end.
     1039   FOR EACH temp-thbj-attr:
     1040     delete temp-thbj-attr.
     1041   end.
     1042   run adm/shattri.p (
     1043                 input "init":U
     1044               , input p-obj-type
     1045               , input p-obj-code
     1046               , input 'alias-tpsi':U
     1047               , input "":U
     1048               , output v-value-character
     1049               , output v-value-date
     1050               , output v-value-decimal
     1051               , output v-value-integer
     1052               , output v-value-logical
     1053               , output v-param-type
     1054               , INPUT-OUTPUT TABLE-handle v-tth
     1055               ) no-error .
     1056   if error-status:error
     1057   and not available locked_thbj-attr then do:
     1058     message
     1059     "Не удалось получить начальные значения настроек" skip
     1060     error-status:get-message(1) return-value
     1061     view-as alert-box error .
     1062     undo, return error .
     1063   end.
     1064   FOR EACH thbjattr_thbj-attr:
     1065     IF thbjattr_thbj-attr.prop-code = 'alias-type-price':U THEN DO:
     1066       rs-alias-type-price = thbjattr_thbj-attr.property-value-integer.
     1067     END.
     1068     IF thbjattr_thbj-attr.prop-code = 'alias-object-price':U THEN DO:
     1069       ASSIGN
     1070       v-obj-type = entry(1, thbjattr_thbj-attr.property-value-character)
     1071       v-obj-code = integer(entry(2, thbjattr_thbj-attr.property-value-character))
     1072       no-error
     1073       .
     1074     END.
     1075     create temp-thbj-attr.
     1076     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     1077   END.
     1078   END PROCEDURE.
     1079   PROCEDURE myenable :
     1080   DEFINE buffer b#clients for ub.clients.
     1081   RS-alias-type-price:RADIO-BUTTONS IN FRAME Dialog-Frame = "Не задан,0," +  'Учетная,1,Продажная поставщика,2,Продажная приемника,3,Цена посредника,4,Цена и ск-ка док.про-жи,5':U  .
     1082   if rs-alias-type-price = INTEGER('4':U) then do:
     1083   find first b#clients WHERE
     1084             b#clients.obj-type = v-obj-type
     1085         and b#clients.obj-code = v-obj-code no-lock no-error.
     1086   if avail b#clients then do:
     1087     Assign
     1088         v-obj-code = b#clients.obj-code
     1089         v-obj-type = b#clients.obj-type
     1090         v-obj-name = b#clients.obj-name .
     1091   end.
     1092   else
     1093     Assign
     1094     v-obj-code = 0
     1095     v-obj-type = ""
     1096     v-obj-name = "" .
     1097     Display
     1098     v-obj-code
     1099     v-obj-name
     1100     v-obj-type
     1101     with frame Dialog-Frame .
     1102   end.
     1103   DISPLAY
     1104   RS-alias-type-price
     1105   v-obj-code
     1106   v-obj-type
     1107   v-obj-name
     1108   WITH FRAME Dialog-Frame.
     1109   ENABLE
     1110   B-exit when p-mode = 'ИЗМЕНЕНИЕ':U
     1111   b-quit
     1112   B-Help  when p-mode = 'ИЗМЕНЕНИЕ':U
     1113   RS-alias-type-price  when p-mode = 'ИЗМЕНЕНИЕ':U
     1114   r-obj-firm when p-mode = 'ИЗМЕНЕНИЕ':U
     1115   WITH FRAME Dialog-Frame.
     1116   IF p-mode = 'ПРОСМОТР':U THEN DO:
     1117     DISABLE
     1118     RS-alias-type-price
     1119     r-obj-firm
     1120     v-obj-code
     1121     v-obj-name
     1122     v-obj-type WITH FRAME Dialog-Frame.
     1123     HIDE B-exit IN FRAME Dialog-Frame.
     1124     b-quit:LABEL = "&Выход".
     1125     b-quit:column = 1.
     1126     DISPLAY
     1127     b-quit
     1128     WITH FRAME Dialog-Frame.
     1129   END.
     1130   view frame Dialog-Frame .
     1131   APPLY "VALUE-CHANGED":U TO RS-alias-type-price IN FRAME Dialog-Frame.
     1132   END PROCEDURE.
     1133   PROCEDURE proc-save :
     1134   define variable v-value-character as character no-undo .
     1135   define variable v-value-date as date no-undo .
     1136   define variable v-value-decimal as decimal no-undo .
     1137   define variable v-value-integer as INTEGER no-undo .
     1138   define variable v-value-logical AS LOGICAL no-undo .
     1139   define variable ii as integer no-undo .
     1140   define variable v-same as logical no-undo .
     1141   define variable v-param-type as character no-undo .
     1142   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     1143   ASSIGN
     1144   FRAME Dialog-Frame
     1145   RS-alias-type-price
     1146   v-obj-code
     1147   v-obj-type .
     1148   IF v-obj-code = 0
     1149   AND RS-alias-type-price = INT('4':U) THEN DO:
     1150     MESSAGE
     1151     "Не задан Объект посредник!".
     1152     RETURN ERROR.
     1153   END.
     1154   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'alias-type-price':U.
     1155   assign
     1156   thbjattr_thbj-attr.property-value-integer = rs-alias-type-price.
     1157   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'alias-object-price':U.
     1158   assign
     1159   thbjattr_thbj-attr.property-value-character = v-obj-type + chr(44) + STRING(v-obj-code).
     1160   v-same = yes.
     1161   for each thbjattr_thbj-attr,
     1162       first temp-thbj-attr where
     1163             temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     1164         and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     1165         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     1166         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code:
     1167      buffer-compare
     1168      thbjattr_thbj-attr
     1169      to temp-thbj-attr
     1170      save result in v-same.
     1171      if not v-same then leave.
     1172   end.
     1173   v-same = no.
     1174   IF v-same  and not v-to-create THEN RETURN.
     1175   run adm/shattri.p (
     1176                 input "check":U
     1177               , input p-obj-type
     1178               , input p-obj-code
     1179               , input 'alias-tpsi':U
     1180               , INPUT '':U
     1181                , output v-value-character
     1182                , output v-value-date
     1183                , output v-value-decimal
     1184                , output v-value-integer
     1185                , output v-value-logical
     1186                , output v-param-type
     1187                , input-output table-handle v-tth
     1188                ) no-error .
     1189   if error-status:error then do:
     1190     message
     1191     "Некорректное значение ПАРАМЕТРОВ" skip
     1192     error-status:get-message(1) skip
     1193     return-value
     1194     view-as alert-box error .
     1195     undo, return error .
     1196   end.
     1197   do TRANSACTION
     1198   on error undo, return error return-value
     1199   :
     1200     RUN thbjattr_set-section IN THIS-PROCEDURE (
     1201          input p-obj-type
     1202         ,input p-obj-code
     1203         ,input 'alias-tpsi':U
     1204         ,INPUT table thbjattr_thbj-attr
     1205     ) NO-ERROR.
     1206     IF ERROR-STATUS:error THEN do:
     1207       MESSAGE ERROR-STATUS:get-message(1)  SKIP
     1208       RETURN-VALUE
     1209       VIEW-AS ALERT-BOX.
     1210       UNDO, RETURN ERROR.
     1211     END.
     1212   end.
     1213   END PROCEDURE.
