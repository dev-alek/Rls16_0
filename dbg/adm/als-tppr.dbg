      489   procedure thbjattr_get-section :
      490   define input  parameter p-obj-type like ub.thbj-attr.obj-type   no-undo .
      491   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
      492   define input  parameter p-upper-param-code  like ub.thbj-attr.upper-prop-code  no-undo .
      493   define input  parameter p-mode as character no-undo .
      494   define input-output parameter table-handle p-tth.
      495   define output parameter p-all-found as decimal no-undo .
      496   do
      497   on error undo, return error return-value
      498   :
