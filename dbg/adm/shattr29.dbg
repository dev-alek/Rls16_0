     4369   PROCEDURE proc-save :
     4370   define variable v-value-character as character no-undo .
     4371   define variable v-value-date as date no-undo .
     4372   define variable v-value-decimal as decimal no-undo .
     4373   define variable v-value-integer as INTEGER no-undo .
     4374   define variable v-value-logical AS LOGICAL no-undo .
     4375   define variable v-param-type as character no-undo .
     4376   define variable wh as widget-handle no-undo .
     4377   define variable fh as widget-handle no-undo .
     4378   define variable v-same as logical no-undo .
     4379   define variable v-loc-same as logical no-undo .
     4380   define variable v-cash-pay-list as character no-undo .
     4381   define variable v-pay-names as character no-undo .
     4382   define variable l-write-cd as logical no-undo .
     4383   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     4384   MESSAGE
     4385   substitute( "Применить сделанные Вами изменения ко всем POS IBS TH&1&2?"
     4386              ,chr(10)
     4387              ,(IF p-obj-type <> '' THEN substitute("&1&2", p-obj-type, p-obj-code) ELSE "")
     4388              )
     4389   VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO-CANCEL UPDATE l-write-cd.
     4390   IF l-write-cd = ? THEN UNDO, RETURN ERROR.
     4391   run  set-cash-pay-list in this-procedure ( output v-cash-pay-list) no-error.
     4392   if error-status:error then do:
     4393     message
     4394     error-status:get-message(1)  skip
     4395     return-value
     4396     view-as alert-box error .
     4397     undo, return error .
     4398   end.
     4399   run set-pay-names in this-procedure ( output v-pay-names) no-error.
     4400   if error-status:error then do:
     4401     message
     4402     error-status:get-message(1)  skip
     4403     return-value
     4404     view-as alert-box error .
     4405     undo, return error .
     4406   end.
     4407   assign
     4408   fh = frame Dialog-Frame:first-child
     4409   wh = fh:first-child
     4410   .
     4411   do while valid-handle(wh):
     4412    if wh:private-data begins "recid=" then do:
     4413       find first thbjattr_thbj-attr where
     4414                 recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     4415       IF wh:DATA-TYPE = 'logical':U
     4416       AND thbjattr_thbj-attr.prop-value-type = 'integer':U THEN DO:
     4417         assign
     4418         thbjattr_thbj-attr.property-value-integer = (IF wh:INPUT-VALUE = YES THEN 1 ELSE 0).
     4419       END.
     4420       ELSE DO:
     4421         assign
     4422         buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     4423       END.
     4424     end.
     4425     wh = wh:next-sibling.
     4426   end.
     4427   find first thbjattr_thbj-attr where
     4428             thbjattr_thbj-attr.upper-prop-code = 'ibs-th_fisreg':U
     4429         and thbjattr_thbj-attr.prop-code = 'cash-pay-list':U
     4430         and thbjattr_thbj-attr.obj-type = p-obj-type
     4431         and thbjattr_thbj-attr.obj-code = p-obj-code  .
     4432   assign
     4433   thbjattr_thbj-attr.property-value-character = v-cash-pay-list.
     4434   find first thbjattr_thbj-attr where
     4435             thbjattr_thbj-attr.upper-prop-code = 'ibs-th_fisreg':U
     4436         and thbjattr_thbj-attr.prop-code = 'pay-names':U
     4437         and thbjattr_thbj-attr.obj-type = p-obj-type
     4438         and thbjattr_thbj-attr.obj-code = p-obj-code  .
     4439   assign
     4440   thbjattr_thbj-attr.property-value-character = v-pay-names.
     4441   v-same = yes.
     4442   for each thbjattr_thbj-attr,
     4443       first temp-thbj-attr where
     4444             temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     4445         and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     4446         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     4447         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code
     4448   break
     4449   by thbjattr_thbj-attr.upper-prop-code :
     4450      buffer-compare
     4451      thbjattr_thbj-attr
     4452      to temp-thbj-attr
     4453      save result in v-loc-same.
     4454      if v-loc-same = no then do:
     4455        v-same = v-loc-same.
     4456        if l-write-cd = yes
     4457        and thbjattr_thbj-attr.upper-prop-code <> 'cd-type-IBS-TH':U
     4458        then do:
     4459          run update-cda in this-procedure ( buffer thbjattr_thbj-attr).
     4460        end.
     4461        else do:
     4462          leave.
     4463       end.
     4464      end.
     4465   end.
     4466   v-same = no.
     4467   IF v-same  and not v-to-create THEN RETURN.
     4468   for each thbjattr_thbj-attr
     4469   break by thbjattr_thbj-attr.upper-prop-code
     4470   :
     4471     if first-of(thbjattr_thbj-attr.upper-prop-code) then do:
     4472       empty temp-table thbjattr___thbj-attr.
     4473     end.
     4474     create thbjattr___thbj-attr.
     4475     buffer-copy
     4476     thbjattr_thbj-attr
     4477     to
     4478     thbjattr___thbj-attr.
     4479     if last-of(thbjattr_thbj-attr.upper-prop-code) then do:
     4480       run adm/shattri.p (
     4481                     input "check":U
     4482                   , input p-obj-type
     4483                   , input p-obj-code
     4484                   , input thbjattr_thbj-attr.upper-prop-code
     4485                   , input '':U
     4486                   , output v-value-character
     4487                   , output v-value-date
     4488                   , output v-value-decimal
     4489                   , output v-value-integer
     4490                   , output v-value-logical
     4491                   , output v-param-type
     4492                   , input-output TABLE-handle v-tth_
     4493                   ) no-error .
     4494       if error-status:error then do:
     4495         message
     4496         "Некорректное значение ПАРАМЕТРОВ" skip
     4497         error-status:get-message(1) skip
     4498         return-value
     4499         view-as alert-box error .
     4500         undo, return error .
     4501       end.
     4502       empty temp-table thbjattr___thbj-attr.
     4503     end.
     4504   end.
     4505   RUN thbjattr_set-section IN THIS-PROCEDURE (
     4506        input p-obj-type
     4507       ,input p-obj-code
     4508       ,input 'cd-type-IBS-TH':U
     4509       ,input table thbjattr_thbj-attr
     4510   ) NO-ERROR.
     4511   IF ERROR-STATUS:error THEN do:
     4512     MESSAGE ERROR-STATUS:get-message(1)  SKIP
     4513     RETURN-VALUE
     4514     VIEW-AS ALERT-BOX.
     4515     UNDO, RETURN ERROR.
     4516   END.
     4517   END PROCEDURE.
     4518   PROCEDURE update-cda :
     4519   DEFINE PARAMETER BUFFER buf_thbjattr_thbj-attr FOR thbjattr_thbj-attr.
     4520   define variable v-obj-db-num as integer no-undo .
     4521   define buffer buf_cash-desk for ub.cash-desk.
     4522   define buffer buf_cash-desk-attr for ub.cash-desk-attr.
     4523   case p-obj-type:
     4524     when '':U then do:
     4525       main-block:
     4526       for each buf_Cash-desk no-lock where
     4527               buf_cash-desk.pos-type = 'IBS-TH':U
     4528       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4529       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     4530       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     4531       :
     4532          find first   buf_cash-desk-attr share-lock where
     4533                buf_cash-desk-attr.db-num = buf_Cash-desk.db-num
     4534            and buf_cash-desk-attr.obj-code = buf_Cash-desk.obj-code
     4535            and buf_cash-desk-attr.pos-type = buf_Cash-desk.pos-type
     4536            and buf_cash-desk-attr.cash-num = buf_cash-desk.cash-num
     4537            and buf_cash-desk-attr.upper-attr-code = buf_thbjattr_thbj-attr.upper-prop-code
     4538           and buf_cash-desk-attr.attr-code = buf_thbjattr_thbj-attr.prop-code
     4539           no-error.
     4540          if not available buf_Cash-desk-attr then do:
     4541            create buf_cash-desk-attr.
     4542            assign
     4543            buf_cash-desk-attr.db-num = buf_Cash-desk.db-num
     4544            buf_cash-desk-attr.obj-code = buf_Cash-desk.obj-code
     4545            buf_cash-desk-attr.pos-type = buf_Cash-desk.pos-type
     4546            buf_cash-desk-attr.cash-num = buf_cash-desk.cash-num
     4547            buf_cash-desk-attr.upper-attr-code = buf_thbjattr_thbj-attr.upper-prop-code
     4548            buf_cash-desk-attr.attr-code = buf_thbjattr_thbj-attr.prop-code
     4549            .
     4550          end.
     4551          assign
     4552          buf_cash-desk-attr.attr-value-character = buf_thbjattr_thbj-attr.property-value-character
     4553          buf_cash-desk-attr.attr-value-date = buf_thbjattr_thbj-attr.property-value-date
     4554          buf_cash-desk-attr.attr-value-decimal = buf_thbjattr_thbj-attr.property-value-decimal
     4555          buf_cash-desk-attr.attr-value-integer = buf_thbjattr_thbj-attr.property-value-integer
     4556          buf_cash-desk-attr.attr-value-logical = buf_thbjattr_thbj-attr.property-value-logical
     4557          buf_cash-desk-attr.attr-value-type = buf_thbjattr_thbj-attr.prop-value-type
     4558          .
     4559       end.
     4560     end.
     4561     when 'маг':U then do:
     4562   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4563   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     4564     (input  'маг':U
     4565     ,input  p-obj-code
     4566     ,output v-obj-db-num
     4567     )  .
     4568       main-block:
     4569       for each buf_Cash-desk no-lock where
     4570               buf_cash-desk.pos-type = 'IBS-TH':U
     4571           and buf_cash-desk.obj-code = p-obj-code
     4572           and buf_cash-desk.db-num = v-obj-db-num
     4573       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4574       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     4575       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     4576       :
     4577          find first   buf_cash-desk-attr share-lock where
     4578                buf_cash-desk-attr.db-num = buf_Cash-desk.db-num
     4579            and buf_cash-desk-attr.obj-code = buf_Cash-desk.obj-code
     4580            and buf_cash-desk-attr.pos-type = buf_Cash-desk.pos-type
     4581            and buf_cash-desk-attr.cash-num = buf_cash-desk.cash-num
     4582            and buf_cash-desk-attr.upper-attr-code = buf_thbjattr_thbj-attr.upper-prop-code
     4583           and buf_cash-desk-attr.attr-code = buf_thbjattr_thbj-attr.prop-code
     4584           no-error.
     4585          if not available buf_Cash-desk-attr then do:
     4586            create buf_cash-desk-attr.
     4587            assign
     4588            buf_cash-desk-attr.db-num = buf_Cash-desk.db-num
     4589            buf_cash-desk-attr.obj-code = buf_Cash-desk.obj-code
     4590            buf_cash-desk-attr.pos-type = buf_Cash-desk.pos-type
     4591            buf_cash-desk-attr.cash-num = buf_cash-desk.cash-num
     4592            buf_cash-desk-attr.upper-attr-code = buf_thbjattr_thbj-attr.upper-prop-code
     4593            buf_cash-desk-attr.attr-code = buf_thbjattr_thbj-attr.prop-code
     4594            .
     4595          end.
     4596          assign
     4597          buf_cash-desk-attr.attr-value-character = buf_thbjattr_thbj-attr.property-value-character
     4598          buf_cash-desk-attr.attr-value-date = buf_thbjattr_thbj-attr.property-value-date
     4599          buf_cash-desk-attr.attr-value-decimal = buf_thbjattr_thbj-attr.property-value-decimal
     4600          buf_cash-desk-attr.attr-value-integer = buf_thbjattr_thbj-attr.property-value-integer
     4601          buf_cash-desk-attr.attr-value-logical = buf_thbjattr_thbj-attr.property-value-logical
     4602          buf_cash-desk-attr.attr-value-type = buf_thbjattr_thbj-attr.prop-value-type
     4603          .
     4604       end.
     4605     end.
     4606   end case.
     4607   END PROCEDURE.
     4608   FUNCTION get-frpay-name RETURNS CHARACTER
     4609     ( INPUT p-frpay-code AS INTEGER ) :
     4610   DEFINE BUFFER buf_temp-pay-names FOR temp-pay-names.
     4611   FIND first buf_temp-pay-names WHERE
     4612           buf_temp-pay-names.frpay-code = p-frpay-code NO-ERROR.
     4613   IF NOT AVAILABLE buf_temp-pay-names THEN RETURN "".
     4614   RETURN buf_temp-pay-names.frpay-name.
     4615   END FUNCTION.
     4616   FUNCTION getcp-name RETURNS CHARACTER
     4617     ( INPUT p-cdpay-code AS INTEGER , INPUT p-curr-code AS INTEGER) :
     4618   DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
     4619   FIND first buf_cash-pay NO-LOCK  WHERE
     4620           buf_cash-pay.cdpay-code = p-cdpay-code
     4621       AND buf_Cash-pay.curr-code = p-curr-code NO-ERROR.
     4622   IF NOT AVAILABLE buf_cash-pay THEN RETURN "!!!НЕИЗВЕСТНЫЙ ТИП КАСС.ПЛАТЕЖА".
     4623   RETURN buf_cash-pay.obj-name.
     4624   END FUNCTION.
