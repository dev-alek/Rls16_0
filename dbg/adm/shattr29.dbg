      769   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      770   define variable v-tth as handle no-undo .
      771   define variable v-tth_ as handle NO-UNDO .
      772   define variable v-tth_main as handle NO-UNDO .
      773   define variable v-tth_devices as handle NO-UNDO .
      774   define variable v-tth_fisreg as handle NO-UNDO .
      775   define variable v-tth_rec-print as handle NO-UNDO .
      776   define variable v-tth_interface as handle NO-UNDO .
      777   DEFINE VARIABLE v-frpay-name AS CHARACTER NO-UNDO.
      778   assign
      779   v-tth = buffer thbjattr_thbj-attr:table-handle
