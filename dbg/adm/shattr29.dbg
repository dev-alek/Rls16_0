     3599            f-cliche-lines5 f-customer-display-port f-cliche-lines6
     3600            f-customer-display-adv1 t-print-good-code f-customer-display-adv2
     3601            f-max-netto CB-keyboard-type rs-rmethod-type b-keyboard-layout-id
     3602            b-curr f-nalc rs-rmethod-coeff CB-cashless-system t-card-reader-plug
     3603            t-rcpt-ord-slip-print t-rcpt-ord-alt-print CB-cctv-system
     3604            f-cctv-system-address b-interface B-devices b-rec-print B-main
