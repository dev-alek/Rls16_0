     1375   ASSIGN
     1376          f-advert-text:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1377   ASSIGN
     1378          f-cliche-lines:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1379   ASSIGN
     1380          f-customer-display-adv:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1381   ASSIGN
     1382          f-rmethod-coeff:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1383   ASSIGN
     1384          v-rmethod-coeff:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1385   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1386   DO:
     1387     APPLY "END-ERROR":U TO SELF.
     1388   END.
     1389   ON CHOOSE OF b-add-cash-pay IN FRAME Dialog-Frame
     1390   DO:
     1391   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1392   DEFINE VARIABLE v-rid AS recid NO-UNDO.
     1393   DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
     1394   DEFINE BUFFER buf_temp-cash-pay-list FOR temp-cash-pay-list.
     1395     run ref/cashpays.w (
     1396                  input parparentproc
     1397                 ,input  "b-sel":U
     1398                 ,input 'все':U
     1399                 ,input (if p-obj-type = "" then 0 else v-host-code)
     1400                 ,input (if p-obj-type = '' then '':U else p-obj-type)
     1401                 ,input (if p-obj-type = '' then 0 else p-obj-code)
     1402                 ,OUTPUT v-rid-list) NO-ERROR.
     1403   IF ERROR-STATUS:ERROR OR v-rid-list = "":U  THEN RETURN no-apply.
     1404   FIND FIRST buf_cash-pay NO-LOCK WHERE
     1405           RECID(buf_cash-pay) = INTEGER(ENTRY(1, v-rid-list)) NO-ERROR.
     1406   IF NOT AVAILABLE buf_cash-pay  THEN RETURN NO-APPLY.
     1407   if buf_cash-pay.cdpay-code = 1 then do:
     1408     message
     1409     "Для платежа типа НАЛИЧНЫЕ (тип касс. платежа = 1) соответствие с типами оплат ФР определять НЕ НАДО!"
     1410     view-as alert-box error .
     1411     undo, return no-apply.
     1412   end.
     1413   FIND FIRST buf_temp-cash-pay-list WHERE
     1414               buf_temp-cash-pay-list.cdpay-code = buf_cash-pay.cdpay-code
     1415       AND     buf_temp-cash-pay-list.curr-code = buf_cash-pay.curr-code NO-ERROR.
     1416   IF AVAILABLE buf_temp-cash-pay-list THEN DO:
     1417       MESSAGE
     1418       SUBSTITUTE("Вы уже добавили соответствие между типом кассового платежа в IBS TH с кодом &1 и валютой &2"
     1419                 , buf_cash-pay.cdpay-code
     1420                 , buf_cash-pay.curr-code)
     1421       VIEW-AS ALERT-BOX ERROR.
     1422       RETURN NO-APPLY.
     1423   END.
     1424   CREATE buf_temp-cash-pay-list.
     1425   ASSIGN
     1426   buf_temp-cash-pay-list.cdpay-code = buf_cash-pay.cdpay-code
     1427   buf_temp-cash-pay-list.curr-code = buf_cash-pay.curr-code
     1428   buf_temp-cash-pay-list.frpay-code = 0
     1429   .
     1430   v-rid = RECID(buf_temp-cash-pay-list).
     1431   OPEN QUERY br-cash-pay-list FOR EACH temp-cash-pay-list.
     1432   REPOSITION br-cash-pay-list TO RECID v-rid NO-ERROR.
     1433   APPLY "ENTRY" TO br-cash-pay-list.
     1434   END.
     1435   ON CHOOSE OF b-curr IN FRAME Dialog-Frame
     1436   DO:
     1437       define variable rr as recid no-undo.
     1438       DEFINE BUFFER buf_currency FOR ub.currency.
     1439       rr = ? .
     1440       run ref/currency.w (
     1441                       input parparentproc
     1442                     , input "b-sel"
     1443                     , input-output rr ).
     1444       if rr <> ? then do:
     1445         FIND FIRST buf_currency WHERE
     1446                   recid( buf_currency ) = rr NO-LOCK .
     1447         DISPLAY
     1448         buf_currency.curr-code @ f-nalc
     1449         buf_currency.curr-abbr @ for-curr-name
     1450         with frame Dialog-Frame .
     1451       end.
     1452   END.
     1453   ON CHOOSE OF b-del-cash-pay IN FRAME Dialog-Frame
     1454   DO:
     1455   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     1456   MESSAGE
     1457   "Вы действительно хотите удалить это соответствие?"
     1458    VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     1459    IF NOT glog  THEN RETURN NO-APPLY.
     1460     IF NOT AVAILABLE temp-cash-pay-list THEN RETURN NO-APPLY.
     1461     DELETE temp-cash-pay-list.
     1462     OPEN QUERY br-cash-pay-list FOR EACH temp-cash-pay-list.
     1463     REPOSITION br-cash-pay-list TO ROW 1.
     1464   END.
     1465   ON CHOOSE OF B-devices IN FRAME Dialog-Frame
     1466   DO:
     1467   run proc-init-devices in this-procedure .
     1468   END.
     1469   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1470   DO:
     1471     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
     1472     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1473   END.
     1474   ON CHOOSE OF b-fisreg IN FRAME Dialog-Frame
     1475   DO:
     1476   run proc-init-fisreg in this-procedure .
     1477   END.
     1478   ON CHOOSE OF b-interface IN FRAME Dialog-Frame
     1479   DO:
     1480   run proc-init-interface in this-procedure .
     1481   END.
     1482   ON CHOOSE OF b-keyboard-layout-id IN FRAME Dialog-Frame
     1483   DO:
     1484       DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1485     DEFINE BUFFER buf_layout FOR ub.layout.
     1486     IF f-keyboard-layout-id <> '' THEN DO:
     1487         FIND FIRST buf_layout NO-LOCK WHERE
     1488                   buf_layout.layout-id = f-keyboard-layout-id NO-ERROR.
     1489     END.
     1490         run adm/layoutss.w (
     1491                              INPUT parparentproc
     1492                            ,input "b-sel"
     1493                            ,INPUT "layout-type"
     1494                             ,INPUT 'th-pos-keyboard':U
     1495                             ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     1496       IF v-rid-list <> ''
     1497       AND v-rid-list <> STRING(RECID(buf_layout)) THEN DO:
     1498         FIND FIRST buf_layout NO-LOCK WHERE
     1499                   recid(buf_layout) = INTEGER(v-rid-list) NO-ERROR.
     1500         IF NOT AVAILABLE buf_layout THEN DO:
     1501             ASSIGN
     1502             f-keyboard-layout-id = ''
     1503             f-keyboard-layout-name = ?
     1504             .
     1505         END.
     1506         ELSE DO:
     1507             ASSIGN
     1508             f-keyboard-layout-id = buf_layout.layout-id
     1509             f-keyboard-layout-name = buf_layout.layout-name
     1510             .
     1511         END.
     1512         DISPLAY
     1513         f-keyboard-layout-id
     1514         f-keyboard-layout-name
     1515         WITH FRAME Dialog-Frame.
     1516       END.
     1517   END.
     1518   ON CHOOSE OF B-main IN FRAME Dialog-Frame
     1519   DO:
     1520      run proc-init-main in this-procedure .
     1521   END.
     1522   ON CHOOSE OF b-rec-print IN FRAME Dialog-Frame
     1523   DO:
     1524   run proc-init-rec-print in this-procedure .
     1525   END.
     1526   ON CHOOSE OF b-screen-layout-id IN FRAME Dialog-Frame
     1527   DO:
     1528     DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1529     DEFINE BUFFER buf_layout FOR ub.layout.
     1530     IF f-screen-layout-id <> '' THEN DO:
     1531         FIND FIRST buf_layout NO-LOCK WHERE
     1532                   buf_layout.layout-id = f-screen-layout-id NO-ERROR.
     1533     END.
     1534         run adm/layoutss.w (
     1535                              INPUT parparentproc
     1536                            ,input "b-sel"
     1537                            ,INPUT "layout-type"
     1538                             ,INPUT 'th-pos-screen':U
     1539                             ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     1540       IF v-rid-list <> ''
     1541       AND v-rid-list <> STRING(RECID(buf_layout)) THEN DO:
     1542         FIND FIRST buf_layout NO-LOCK WHERE
     1543                   recid(buf_layout) = INTEGER(v-rid-list) NO-ERROR.
     1544         IF NOT AVAILABLE buf_layout THEN DO:
     1545             ASSIGN
     1546             f-screen-layout-id = ''
     1547             f-screen-layout-name = ?
     1548             .
     1549         END.
     1550         ELSE DO:
     1551             ASSIGN
     1552             f-screen-layout-id = buf_layout.layout-id
     1553             f-screen-layout-name = buf_layout.layout-name
     1554             .
     1555         END.
     1556         DISPLAY
     1557         f-screen-layout-id
     1558         f-screen-layout-name
     1559         WITH FRAME Dialog-Frame.
     1560     END.
     1561   END.
     1562   ON VALUE-CHANGED OF CB-cashless-system IN FRAME Dialog-Frame
     1563   DO:
     1564     ASSIGN
     1565     cb-cashless-system.
     1566   END.
     1567   ON VALUE-CHANGED OF CB-cctv-system IN FRAME Dialog-Frame
     1568   DO:
     1569     ASSIGN
     1570     cb-cctv-system.
     1571     case cb-cctv-system:
     1572       when '' then do:
     1573         f-cctv-system-address = ''.
     1574         display
     1575         f-cctv-system-address
     1576         with frame Dialog-Frame .
     1577         disable
     1578         f-cctv-system-address
     1579         with frame Dialog-Frame .
     1580       end.
     1581       otherwise do:
     1582         if p-mode <> 'ПРОСМОТР':U then do:
     1583           enable
     1584           f-cctv-system-address
     1585           with frame Dialog-Frame .
     1586         end.
     1587       end.
     1588     end case.
     1589   END.
     1590   ON VALUE-CHANGED OF CB-keyboard-type IN FRAME Dialog-Frame
     1591   DO:
     1592     ASSIGN
     1593     cb-keyboard-type.
     1594     CASE cb-keyboard-type:
     1595         WHEN '' THEN DO:
     1596           ASSIGN
     1597           f-keyboard-layout-id = ''
     1598           f-keyboard-layout-name = ''
     1599           .
     1600           DISPLAY
     1601           f-keyboard-layout-id
     1602           f-keyboard-layout-name
     1603           WITH FRAME Dialog-Frame.
     1604           DISABLE
     1605           b-keyboard-layout-id
     1606           WITH FRAME Dialog-Frame.
     1607         END.
     1608         OTHERWISE DO:
     1609             Enable
     1610             b-keyboard-layout-id
     1611             WITH FRAME Dialog-Frame.
     1612            APPLY "CHOOSE" TO b-keyboard-layout-id .
     1613         END.
     1614     END CASE.
     1615   END.
     1616   ON VALUE-CHANGED OF CB-screen-type IN FRAME Dialog-Frame
     1617   DO:
     1618       ASSIGN
     1619     cb-screen-type.
     1620     APPLY "CHOOSE" TO b-screen-layout-id .
     1621   END.
     1622   ON LEAVE OF f-advert-text1 IN FRAME Dialog-Frame
     1623   DO:
     1624     ASSIGN
     1625     f-advert-text1
     1626     f-advert-text = f-advert-text1 + chr(4) +
     1627                     f-advert-text2 + chr(4) +
     1628                     f-advert-text3
     1629     f-advert-text:screen-value = f-advert-text
     1630     .
     1631   END.
     1632   ON LEAVE OF f-advert-text2 IN FRAME Dialog-Frame
     1633   DO:
     1634     ASSIGN
     1635     f-advert-text2
     1636     f-advert-text = f-advert-text1 + chr(4) +
     1637                     f-advert-text2 + chr(4) +
     1638                     f-advert-text3
     1639     f-advert-text:screen-value = f-advert-text
     1640     .
     1641   END.
     1642   ON LEAVE OF f-advert-text3 IN FRAME Dialog-Frame
     1643   DO:
     1644     ASSIGN
     1645     f-advert-text3
     1646     f-advert-text = f-advert-text1 + chr(4) +
     1647                     f-advert-text2 + chr(4) +
     1648                     f-advert-text3
     1649    f-advert-text:SCREEN-VALUE = f-advert-text
     1650     .
     1651   END.
     1652   ON LEAVE OF f-cliche-lines1 IN FRAME Dialog-Frame
     1653   DO:
