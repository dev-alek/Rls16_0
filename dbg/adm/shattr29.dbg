      721   on error undo, return error
      722   :
      723     find first buf_temp-widget where
      724               buf_temp-widget.name = p-name no-error.
      725     if available buf_temp-widget then do:
      726       assign
      727       buf_temp-widget.character_ = p-character
      728       buf_temp-widget.data-type_ = 'character':U
      729       .
      730     end.
      731   end.
      732   end procedure.
