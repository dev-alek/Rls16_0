     4190   f-cliche-lines2 WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     4191   f-cliche-lines3 WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     4192   f-cliche-lines4 WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     4193   b-add-cash-pay  WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     4194   b-del-cash-pay WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     4195   WITH FRAME Dialog-Frame.
