     1669     f-cliche-lines = f-cliche-lines1 + chr(4) +
     1670                      f-cliche-lines2 + chr(4) +
     1671                      f-cliche-lines3 + chr(4) +
     1672                      f-cliche-lines4 + chr(4) +
     1673                      f-cliche-lines5 + chr(4) +
     1674                      f-cliche-lines6
     1675   f-cliche-lines:SCREEN-VALUE = f-cliche-lines
     1676     .
     1677   END.
     1678   ON LEAVE OF f-cliche-lines3 IN FRAME Dialog-Frame
     1679   DO:
     1680     ASSIGN
     1681     f-cliche-lines3
     1682     f-cliche-lines = f-cliche-lines1 + chr(4) +
     1683                      f-cliche-lines2 + chr(4) +
     1684                      f-cliche-lines3 + chr(4) +
     1685                      f-cliche-lines4 + chr(4) +
     1686                      f-cliche-lines5 + chr(4) +
     1687                      f-cliche-lines6
     1688   f-cliche-lines:SCREEN-VALUE = f-cliche-lines
     1689     .
     1690   END.
     1691   ON LEAVE OF f-cliche-lines4 IN FRAME Dialog-Frame
     1692   DO:
     1693     ASSIGN
     1694       f-cliche-lines4
     1695     f-cliche-lines = f-cliche-lines1 + chr(4) +
     1696                      f-cliche-lines2 + chr(4) +
     1697                      f-cliche-lines3 + chr(4) +
     1698                      f-cliche-lines4 + chr(4) +
     1699                      f-cliche-lines5 + chr(4) +
     1700                      f-cliche-lines6
     1701   f-cliche-lines:SCREEN-VALUE = f-cliche-lines
     1702     .
     1703   END.
     1704   ON LEAVE OF f-cliche-lines5 IN FRAME Dialog-Frame
     1705   DO:
     1706     ASSIGN
     1707       f-cliche-lines5
     1708     f-cliche-lines = f-cliche-lines1 + chr(4) +
     1709                      f-cliche-lines2 + chr(4) +
     1710                      f-cliche-lines3 + chr(4) +
     1711                      f-cliche-lines4 + chr(4) +
     1712                      f-cliche-lines5 + chr(4) +
     1713                      f-cliche-lines6
     1714   f-cliche-lines:SCREEN-VALUE = f-cliche-lines
     1715     .
     1716   END.
     1717   ON LEAVE OF f-cliche-lines6 IN FRAME Dialog-Frame
     1718   DO:
