     1272   temp-cash-pay-list.frpay-code COLUMN-LABEL "Код ФР"
     1273   get-frpay-name( INPUT temp-cash-pay-list.frpay-code) @ v-frpay-name COLUMN-LABEL "Наим. кода оплаты на ФР" FORMAT "X(40)"
     1274   ENABLE
     1275   temp-cash-pay-list.frpay-code
     1276       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 12
