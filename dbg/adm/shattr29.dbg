      758       .
      759   DEFINE TEMP-TABLE temp-pay-names
      760   FIELD frpay-code AS INTEGER
      761   FIELD frpay-name AS CHARACTER
      762   INDEX pi IS UNIQUE PRIMARY frpay-code.
      763   DEFINE VARIABLE v-db-num LIKE ub.db.db-num NO-UNDO.
      764   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO EXTENT 5.
      765   DEFINE VARIABLE v-labels AS CHARACTER NO-UNDO EXTENT 5.
      766   DEFINE VARIABLE v-current-tab-order AS CHARACTER NO-UNDO .
      767   DEFINE VARIABLE v-to-create AS logical NO-UNDO.
