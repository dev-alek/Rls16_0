     1655     f-cliche-lines1
     1656     f-cliche-lines = f-cliche-lines1 + chr(4) +
     1657                      f-cliche-lines2 + chr(4) +
     1658                      f-cliche-lines3 + chr(4) +
     1659                      f-cliche-lines4 + chr(4) +
     1660                      f-cliche-lines5 + chr(4) +
     1661                      f-cliche-lines6
     1662     f-cliche-lines:SCREEN-VALUE = f-cliche-lines
     1663     .
     1664   END.
