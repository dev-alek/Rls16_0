     4203     b-quit:COLUMN = 1
     4204     temp-cash-pay-list.frpay-code:read-only IN BROWSE br-cash-pay-list = YES
     4205     .
     4206   END.
     4207   HIDE
     4208   f-cliche-lines5
     4209   f-cliche-lines6
     4210   IN FRAME Dialog-Frame.
     4211   OPEN QUERY br-cash-pay-list FOR EACH temp-cash-pay-list.
     4212   OPEN QUERY br-pay-names FOR EACH temp-pay-names.
     4213   APPLY "CHOOSE" TO b-main.
     4214   END PROCEDURE.
     4215   PROCEDURE proc-init-devices :
     4216   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     4217   DO on error undo, return error return-value:
     4218    b-devices:LOAD-IMAGE-UP("adeicon\ts-up110":U)           in frame Dialog-Frame .
     4219    f-devices:fgcolor = 1   .
     4220    b-main:LOAD-IMAGE-Up("adeicon\ts-dn110":U)      in frame Dialog-Frame .
     4221    b-fisreg:LOAD-IMAGE-Up("adeicon\ts-dn110":U)      in frame Dialog-Frame .
     4222    b-rec-print:LOAD-IMAGE-Up("adeicon\ts-dn110":U)      in frame Dialog-Frame .
     4223    b-interface:LOAD-IMAGE-Up("adeicon\ts-dn110":U)      in frame Dialog-Frame .
     4224    ASSIGN
     4225    f-main:fgcolor = ?
     4226    f-fisreg:fgcolor = ?
     4227    f-rec-print:fgcolor = ?
     4228    f-interface:fgcolor = ?
     4229    .
     4230    FOR EACH temp-widget WHERE
     4231           temp-widget.SECTION_ = "2":
     4232      ASSIGN
     4233       temp-widget.HANDLE_:VISIBLE = YES.
     4234   END.
     4235   FOR EACH temp-widget WHERE
     4236           temp-widget.SECTION_ <> "2"
     4237       AND temp-widget.SECTION_ <> "":
     4238      ASSIGN
     4239       temp-widget.HANDLE_:VISIBLE = no.
     4240    END.
     4241    .
     4242    v-current-tab-order = v-tab-order[2].
     4243    APPLY "VALUE-CHANGED" TO t-cash-drawer-plug.
     4244    APPLY "VALUE-CHANGED" TO t-customer-display-plug.
     4245    APPLY "VALUE-CHANGED" TO cb-cctv-system.
     4246   end.
     4247   END PROCEDURE.
