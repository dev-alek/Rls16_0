      782   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      783   procedure get-cash-pay-list :
      784   define input parameter p-cp-list as character no-undo .
      785   define variable v-ii as integer no-undo .
      786   define variable v-jj as integer no-undo .
      787   define variable v-dop1 as character no-undo .
      788   define variable v-fr-code as integer no-undo .
      789   define variable v-cp-list as character no-undo .
      790   define buffer buf_temp-cash-pay-list for temp-cash-pay-list.
      791   do
      792   on error undo, return error
      793   :
      794     DO v-ii = 1 TO num-entries(p-cp-list, chr(4)):
      795       v-dop1 = ENTRY(v-ii, p-cp-list, chr(4)).
      796       ASSIGN
      797       v-fr-code = INTEGER(ENTRY(1, v-dop1, "="))
      798       v-cp-list = ENTRY(2, v-dop1, "=")
      799       NO-ERROR.
      800       IF v-fr-code >= 2
      801       AND v-fr-code <= 4 THEN DO:
      802         DO v-jj = 1 TO num-entries(v-cp-list, ";"):
      803           FIND FIRST buf_temp-cash-pay-list WHERE
      804                     buf_temp-cash-pay-list.cdpay-code = integer(ENTRY(1, ENTRY(v-jj, v-cp-list, ";"), chr(58)))
      805               AND buf_temp-cash-pay-list.curr-code = integer(ENTRY(2, ENTRY(v-jj, v-cp-list, ";"), chr(58))) NO-ERROR.
      806           IF NOT AVAILABLE buf_temp-cash-pay-list THEN DO:
      807             CREATE buf_temp-cash-pay-list.
      808             ASSIGN
      809             buf_temp-cash-pay-list.cdpay-code = integer(ENTRY(1, ENTRY(v-jj, v-cp-list, ";"), chr(58)))
      810             buf_temp-cash-pay-list.curr-code = integer(ENTRY(2, ENTRY(v-jj, v-cp-list, ";"), chr(58)))
      811             buf_temp-cash-pay-list.frpay-code = v-fr-code
      812             .
      813           END.
      814         end.
      815       end.
      816     end.
      817   END.
      818   end procedure.
      819   procedure get-pay-names :
      820   define input parameter p-pay-names-list as character no-undo .
      821   define variable v-ii as integer no-undo .
      822   define variable v-fr-code as integer no-undo .
      823   define variable v-name as character no-undo .
      824   define buffer buf_temp-pay-names for temp-pay-names.
      825   do
      826   on error undo, return error
      827   :
      828     DO v-ii = 1 TO num-entries(p-pay-names-list, chr(4)):
      829       ASSIGN
      830       v-fr-code = v-ii + 1
      831       v-name = ENTRY(v-ii, p-pay-names-list, chr(4))
      832       NO-ERROR.
      833       IF v-fr-code >= 2
      834       AND v-fr-code <= 4 THEN DO:
      835         FIND FIRST buf_temp-pay-names WHERE
      836                   buf_temp-pay-names.frpay-code = v-fr-code NO-ERROR.
      837         IF NOT AVAILABLE buf_temp-pay-names THEN DO:
      838           CREATE buf_temp-pay-names.
      839           ASSIGN
      840           buf_temp-pay-names.frpay-code = v-fr-code
      841           buf_temp-pay-names.frpay-name = v-name
      842           .
      843         END.
      844       END.
      845     END.
      846   end.
      847   end procedure.
      848   procedure set-cash-pay-list :
      849   define output parameter p-cash-pay-list as character no-undo .
      850   define buffer buf_temp-cash-pay-list for temp-cash-pay-list.
      851   do
      852   on error undo, return error
      853   :
      854     FOR EACH buf_temp-cash-pay-list
      855     BREAK BY
      856     buf_temp-cash-pay-list.frpay-code:
      857       IF not(buf_temp-cash-pay-list.frpay-code  >= 2
      858            AND
      859            buf_temp-cash-pay-list.frpay-code  <= 4) THEN DO:
      860       undo, return error  substitute("Неверно заполнено соответствие для типа кассового платежа TH с кодом &1 и валютой &2"
      861                  , buf_temp-cash-pay-list.cdpay-code
      862                  , buf_temp-cash-pay-list.curr-code).
      863       END.
      864       IF FIRST-OF(buf_temp-cash-pay-list.frpay-code) THEN DO:
      865         ASSIGN
      866         p-cash-pay-list = substitute("&1&2&3="
      867                                     ,p-cash-pay-list
      868                                     ,chr(4)
      869                                       ,buf_temp-cash-pay-list.frpay-code) .
      870       END.
      871       ASSIGN
      872       p-cash-pay-list = substitute("&1&2:&3;"
      873                                   ,p-cash-pay-list
      874                                     ,buf_temp-cash-pay-list.cdpay-code
      875                                     ,buf_temp-cash-pay-list.curr-code
      876                                     ) .
      877       IF last-OF(buf_temp-cash-pay-list.frpay-code) THEN DO:
      878         ASSIGN
      879         p-cash-pay-list = right-trim(p-cash-pay-list, ";").
      880       END.
      881     END.
      882     assign
      883     p-cash-pay-list = LEFT-TRIM(p-cash-pay-list, chr(4))
      884     p-cash-pay-list = right-TRIM(p-cash-pay-list, ";")
      885     .
      886   end.
      887   end procedure.
      888   procedure set-pay-names :
      889   define output parameter p-pay-names as character no-undo .
      890   define buffer buf_temp-pay-names for temp-pay-names.
      891   do
      892   on error undo, return error
      893   :
      894     FOR EACH buf_temp-pay-names
      895     BY buf_temp-pay-names.frpay-code
      896         :
      897       IF buf_temp-pay-names.frpay-code >= 2
      898       OR buf_temp-pay-names.frpay-code <= 2
      899       THEN
      900       ASSIGN
      901       p-pay-names = substitute("&1&2&3"
      902                                     ,p-pay-names
      903                                     ,chr(4)
      904                                     ,buf_temp-pay-names.frpay-name) .
      905     END.
      906     ASSIGN
      907     p-pay-names = left-trim(p-pay-names, chr(4))
      908     .
      909   end.
      910   end procedure.
