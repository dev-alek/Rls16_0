     3611   PROCEDURE fill-widgets :
     3612   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     3613   DEFINE VARIABLE v-entry AS CHARACTER NO-UNDO.
     3614   define variable v-param-type as character no-undo .
     3615   define variable v-param-value as character no-undo .
     3616   define variable v-value-character as character no-undo .
     3617   define variable v-value-date as date no-undo .
     3618   define variable v-value-decimal as decimal no-undo .
     3619   define variable v-value-integer as INTEGER no-undo .
     3620   define variable v-value-logical AS LOGICAL no-undo .
     3621   DEFINE VARIABLE v-dop1 AS CHARACTER NO-UNDO.
     3622   DEFINE VARIABLE v-fr-code AS integer NO-UNDO.
     3623   DEFINE VARIABLE v-cp-list AS character NO-UNDO.
     3624   DEFINE VARIABLE v-name AS character NO-UNDO.
     3625   DEFINE VARIABLE v-ii AS integer NO-UNDO.
     3626   DEFINE VARIABLE v-jj AS integer NO-UNDO.
     3627   DEFINE BUFFER buf_currency FOR ub.currency.
     3628   FOR EACH thbjattr_thbj-attr:
     3629     delete thbjattr_thbj-attr.
     3630   end.
     3631   FOR EACH temp-thbj-attr:
     3632     delete temp-thbj-attr.
     3633   end.
     3634   run adm/shattri.p (
     3635                 input "init":U
     3636               , input p-obj-type
     3637               , input p-obj-code
     3638               , input 'cd-type-IBS-TH':U
     3639               , input "":U
     3640               , output v-value-character
     3641               , output v-value-date
     3642               , output v-value-decimal
     3643               , output v-value-integer
     3644               , output v-value-logical
     3645               , output v-param-type
     3646               , INPUT-OUTPUT TABLE-handle v-tth
     3647               ) no-error .
     3648   if error-status:error
     3649   and not available locked_thbj-attr then do:
     3650     message
     3651     "Не удалось получить начальные значения настроек" skip
     3652     error-status:get-message(1) return-value
     3653     view-as alert-box error .
     3654     undo, return error .
     3655   end.
     3656   FOR EACH thbjattr_thbj-attr:
     3657     ASSIGN
     3658     v-entry = thbjattr_thbj-attr.prop-code.
     3659     CASE thbjattr_thbj-attr.upper-prop-code :
     3660       WHEN 'ibs-th_main':U THEN DO:
     3661         CASE v-entry:
     3662           WHEN 'cash-shift':U THEN DO:
     3663             ASSIGN
     3664             t-cash-shift = logical(thbjattr_thbj-attr.property-value-integer)
     3665             t-cash-shift:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3666             .
     3667           END.
     3668          WHEN 'nalc':U THEN DO:
     3669             ASSIGN
     3670             f-nalc = thbjattr_thbj-attr.property-value-integer
     3671             f-nalc:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3672             .
     3673             FIND FIRST buf_currency NO-LOCK WHERE
     3674                       buf_currency.curr-code = f-nalc NO-ERROR.
     3675             IF AVAILABLE buf_currency THEN DO:
     3676                 ASSIGN
     3677                 for-curr-name = buf_currency.curr-abbr.
     3678             END.
     3679           END.
     3680          WHEN 'salesman-mandatory':U THEN DO:
     3681             ASSIGN
     3682             t-salesman-mandatory = logical(thbjattr_thbj-attr.property-value-integer)
     3683             t-salesman-mandatory:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3684             .
     3685           END.
     3686           WHEN 'manual-discnt':U THEN DO:
     3687             ASSIGN
     3688             t-manual-discnt = logical(thbjattr_thbj-attr.property-value-integer)
     3689             t-manual-discnt:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3690             .
     3691           END.
     3692           WHEN 'log-level':U THEN DO:
     3693             ASSIGN
     3694             rs-log-level = thbjattr_thbj-attr.property-value-integer
     3695             rs-log-level:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3696             .
     3697           END.
     3698           WHEN 'clear-cash-counter':U THEN DO:
     3699             ASSIGN
     3700             t-clear-cash-counter = logical(thbjattr_thbj-attr.property-value-integer)
     3701             t-clear-cash-counter:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3702             .
     3703           END.
     3704           WHEN 'qnty-change':U THEN DO:
     3705             ASSIGN
     3706             t-qnty-change = logical(thbjattr_thbj-attr.property-value-integer)
     3707             t-qnty-change:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3708             .
     3709           END.
     3710        END CASE.
     3711      END.
     3712      WHEN 'ibs-th_devices':U THEN DO:
     3713        CASE v-entry:
     3714          WHEN 'cash-drawer-plug':U THEN DO:
     3715            ASSIGN
     3716            t-cash-drawer-plug = logical(thbjattr_thbj-attr.property-value-integer)
     3717            t-cash-drawer-plug:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3718            .
     3719          END.
     3720          WHEN 'cash-drawer-plug-type':U THEN DO:
     3721            ASSIGN
     3722            rs-cash-drawer-plug-type = thbjattr_thbj-attr.property-value-integer
     3723            rs-cash-drawer-plug-type:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3724              .
     3725          END.
     3726          WHEN 'cash-drawer-plug-port':U THEN DO:
     3727            ASSIGN
     3728            f-cash-drawer-plug-port = thbjattr_thbj-attr.property-value-integer
     3729            f-cash-drawer-plug-port:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3730            .
     3731          END.
     3732          WHEN 'cash-drawer-plug-imp':U THEN DO:
     3733            ASSIGN
     3734            f-cash-drawer-plug-imp = thbjattr_thbj-attr.property-value-integer
     3735            f-cash-drawer-plug-imp:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3736            .
     3737          END.
     3738         WHEN 'cash-drawer-open':U THEN DO:
     3739           ASSIGN
     3740           t-cash-drawer-open = logical(thbjattr_thbj-attr.property-value-integer)
     3741           t-cash-drawer-open:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3742           .
     3743         END.
     3744         WHEN 'cash-drawer-limit':U THEN DO:
     3745           ASSIGN
     3746           f-cash-drawer-limit = thbjattr_thbj-attr.property-value-decimal
     3747           f-cash-drawer-limit:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3748           .
     3749         END.
     3750          WHEN 'card-reader-plug':U THEN DO:
     3751            ASSIGN
     3752            t-card-reader-plug = logical(thbjattr_thbj-attr.property-value-integer)
     3753            t-card-reader-plug:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3754            .
     3755          END.
     3756          WHEN 'customer-display-plug':U THEN DO:
     3757            ASSIGN
     3758            t-customer-display-plug = logical(thbjattr_thbj-attr.property-value-integer)
     3759            t-customer-display-plug:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3760            .
     3761          END.
     3762           WHEN 'customer-display-adv':U THEN DO:
     3763             ASSIGN
     3764             f-customer-display-adv = thbjattr_thbj-attr.property-value-character
     3765             f-customer-display-adv1 = entry(1, thbjattr_thbj-attr.property-value-character, chr(4))
     3766             f-customer-display-adv2 = entry(2, thbjattr_thbj-attr.property-value-character, chr(4))
     3767             NO-ERROR
     3768             .
     3769             f-customer-display-adv:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr)).
     3770           END.
     3771          WHEN 'keyboard-type':U THEN DO:
     3772            ASSIGN
     3773            cb-keyboard-type = thbjattr_thbj-attr.property-value-character
     3774            cb-keyboard-type:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3775            .
     3776          END.
     3777          WHEN 'keyboard-layout-id':U THEN DO:
     3778            ASSIGN
     3779            f-keyboard-layout-id = thbjattr_thbj-attr.property-value-character
     3780            f-keyboard-layout-id:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3781            .
     3782          END.
     3783          WHEN 'cashless-system':U THEN DO:
     3784            ASSIGN
     3785            cb-cashless-system = thbjattr_thbj-attr.property-value-character
     3786            cb-cashless-system:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3787            .
     3788          END.
     3789          WHEN 'customer-display-type':U THEN DO:
     3790            ASSIGN
     3791            cb-customer-display-type = thbjattr_thbj-attr.property-value-character
     3792            cb-customer-display-type:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3793            .
     3794          END.
     3795          WHEN 'customer-display-port':U THEN DO:
     3796            ASSIGN
     3797            f-customer-display-port = thbjattr_thbj-attr.property-value-character
     3798            f-customer-display-port:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3799            .
     3800          END.
     3801          WHEN 'cctv-system':U THEN DO:
     3802            ASSIGN
     3803            cb-cctv-system = thbjattr_thbj-attr.property-value-character
     3804            cb-cctv-system:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3805            .
     3806          END.
     3807          WHEN 'cctv-system-address':U THEN DO:
     3808            ASSIGN
     3809            f-cctv-system-address = thbjattr_thbj-attr.property-value-character
     3810            f-cctv-system-address:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3811            .
     3812          END.
     3813         END CASE.
     3814       END.
     3815       WHEN 'ibs-th_fisreg':U THEN DO:
     3816         CASE v-entry:
     3817           WHEN 'cash-drawer-level':U THEN DO:
     3818            ASSIGN
     3819            rs-cash-drawer-level = thbjattr_thbj-attr.property-value-integer
     3820            rs-cash-drawer-level:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3821              .
     3822           END.
     3823            WHEN 'cash-pay-list':U THEN DO:
     3824               run get-cash-pay-list in this-procedure ( input thbjattr_thbj-attr.property-value-character).
     3825            END.
     3826            WHEN 'pay-names':U THEN DO:
     3827              run get-pay-names in this-procedure ( input thbjattr_thbj-attr.property-value-character).
     3828            END.
     3829            WHEN 'cutter':U THEN DO:
     3830             ASSIGN
     3831             t-cutter = logical(thbjattr_thbj-attr.property-value-integer)
     3832             t-cutter:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3833             .
     3834            END.
     3835            WHEN 'com-port':U THEN DO:
     3836               ASSIGN
     3837               f-com-port = thbjattr_thbj-attr.property-value-character
     3838               f-com-port:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3839               .
     3840             END.
     3841         end case.
     3842       END.
     3843       WHEN 'ibs-th_rec-print':U THEN DO:
     3844         CASE v-entry:
     3845           WHEN 'max-netto':U THEN DO:
     3846             ASSIGN
     3847             f-max-netto = thbjattr_thbj-attr.property-value-decimal
     3848             f-max-netto:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3849             .
     3850           END.
     3851           WHEN 'advert-text':U THEN DO:
     3852            ASSIGN
     3853            f-advert-text = thbjattr_thbj-attr.property-value-character
     3854            f-advert-text:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3855            f-advert-text1 = ENTRY(1, f-advert-text, chr(4))
     3856            f-advert-text2 = ENTRY(2, f-advert-text, chr(4))
     3857            f-advert-text3 = ENTRY(3, f-advert-text, chr(4))
     3858            .
     3859           END.
     3860           WHEN 'cliche-lines':U THEN DO:
     3861             ASSIGN
     3862             f-cliche-lines = thbjattr_thbj-attr.property-value-character
     3863             f-cliche-lines:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3864             f-cliche-lines1 = ENTRY(1, f-cliche-lines, chr(4))
     3865             f-cliche-lines2 = ENTRY(2, f-cliche-lines, chr(4))
     3866             f-cliche-lines3 = ENTRY(3, f-cliche-lines, chr(4))
     3867             f-cliche-lines4 = ENTRY(4, f-cliche-lines, chr(4))
     3868             f-cliche-lines5 = ENTRY(5, f-cliche-lines, chr(4))
     3869             f-cliche-lines6 = ENTRY(6, f-cliche-lines, chr(4))
     3870             .
     3871           END.
     3872           WHEN 'print-good-code':U THEN DO:
     3873                ASSIGN
     3874                t-print-good-code = logical(thbjattr_thbj-attr.property-value-integer)
     3875                t-print-good-code:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3876                .
     3877           END.
     3878           when 'rmethod-type':U then do:
     3879            ASSIGN
     3880            rs-rmethod-type = thbjattr_thbj-attr.property-value-character
     3881            rs-rmethod-type:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3882            .
     3883           end.
     3884           when 'rmethod-coeff':U then do:
     3885            ASSIGN
     3886            v-rmethod-coeff = thbjattr_thbj-attr.property-value-decimal
     3887            v-rmethod-coeff:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3888            .
     3889          end.
     3890          when 'rcpt-ord-slip-print':U then do:
     3891            ASSIGN
     3892            t-rcpt-ord-slip-print = logical(thbjattr_thbj-attr.property-value-integer)
     3893            t-rcpt-ord-slip-print:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3894            .
     3895          end.
     3896          when 'rcpt-ord-alt-print':U then do:
     3897            ASSIGN
     3898            t-rcpt-ord-alt-print = logical(thbjattr_thbj-attr.property-value-integer)
     3899            t-rcpt-ord-alt-print:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3900            .
     3901          end.
     3902         END CASE.
     3903       END.
     3904       WHEN 'ibs-th_interface':U THEN DO:
     3905         CASE v-entry:
     3906           WHEN 'screen-type':U THEN DO:
     3907             ASSIGN
     3908             cb-screen-type = thbjattr_thbj-attr.property-value-character
     3909             cb-screen-type:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3910             .
     3911           END.
     3912           WHEN 'screen-layout-id':U THEN DO:
     3913             ASSIGN
     3914             f-screen-layout-id = thbjattr_thbj-attr.property-value-character
     3915             f-screen-layout-id:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3916             .
     3917           END.
     3918         end CASE.
     3919       END.
     3920     END CASE.
     3921     create temp-thbj-attr.
     3922     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     3923   END.
     3924   if rs-rmethod-type = "MROUND" then do:
     3925     ASSIGN
     3926     rs-rmethod-coeff = v-rmethod-coeff
     3927     f-rmethod-coeff = 0
     3928     .
     3929   end.
     3930   else do:
     3931     assign
     3932     f-rmethod-coeff = v-rmethod-coeff
     3933     rs-rmethod-coeff = 2
     3934     .
     3935   end.
     3936   END PROCEDURE.
     3937   PROCEDURE MyEnable :
     3938   DEFINE VARIABLE v-h AS HANDLE NO-UNDO.
     3939   DEFINE VARIABLE v-h1 AS HANDLE NO-UNDO.
     3940   DEFINE VARIABLE v-ii AS integer NO-UNDO.
     3941   DEFINE VARIABLE v-jj AS integer NO-UNDO.
     3942   define variable v-list-items as character no-undo .
     3943   define variable wh as widget-handle no-undo .
     3944   define variable fh as widget-handle no-undo .
     3945   DEFINE BUFFER buf_layout FOR ub.layout.
     3946   v-list-items = chr(44).
     3947   do v-ii = 1 to num-entries('IBM-VFD,Shtrih-M_v_A1.40,Posiflex-pd2800-320':U):
     3948     v-list-items = v-list-items + chr(44) +
     3949                    entry(v-ii, 'IBM VFD,Штрих-М v.A1.40,Posiflex-pd2800-320':U) + chr(44) + entry(v-ii, 'IBM-VFD,Shtrih-M_v_A1.40,Posiflex-pd2800-320':U)
     3950     .
     3951   end.
     3952   assign
     3953   cb-customer-display-type:list-item-pairs in frame Dialog-Frame = v-list-items
     3954   .
     3955   v-list-items = ''.
     3956   do v-ii = 1 to num-entries('0,1,2,3':U):
     3957     v-list-items = v-list-items + (if v-ii = 1 then '' else chr(44)) +
     3958                    entry(v-ii, 'Нет логирования,Низкий,Средний,Высокий':U) + chr(44) + entry(v-ii, '0,1,2,3':U)
     3959     .
     3960   end.
     3961   assign
     3962   rs-log-level:radio-buttons in frame Dialog-Frame = v-list-items
     3963   .
     3964   v-list-items = ''.
     3965   assign
     3966   rs-rmethod-type:radio-buttons in frame Dialog-Frame = "Отсечение до n-знака после зап." + chr(44) + "MROUND" + chr(44) +
     3967                                                           "Нет номиналов меньше чем" + chr(44) + "NO-COINS"
     3968   .
     3969   rs-rmethod-coeff:radio-buttons in frame Dialog-Frame = "Сотни" + chr(44) +  "-2" + chr(44) +
     3970                                                         "Десятки" + chr(44) + "-1"  + chr(44) +
     3971                                                         "Рубли" + chr(44) + "0" + chr(44)  +
     3972                                                         "Десятки копеек" + chr(44) + "1"  + chr(44) +
     3973                                                         "копейки" + chr(44) + "2"
     3974                                                         .
     3975   assign
     3976   cb-keyboard-type:list-items in frame Dialog-Frame  = chr(44) + 'IBM-50':U.
     3977   cb-screen-type:list-items in frame Dialog-Frame  =  'Screen,TouchScreen':U.
     3978   v-list-items = chr(44).
     3979   do v-ii = 1 to  num-entries('sberbank':U):
     3980     assign
     3981     v-list-items = v-list-items + chr(44) + entry (lookup (entry(v-ii, 'sberbank':U), 'sberbank':U) + 1, ',' + 'Сбербанк':U) + chr(44) + entry(v-ii, 'sberbank':U).
     3982   end.
     3983   assign
     3984   cb-cashless-system:list-item-pairs in frame Dialog-Frame =  v-list-items
     3985   .
     3986   v-list-items = chr(44).
     3987   do v-ii = 1 to  num-entries('Intellect,Prizma':U):
     3988     assign
     3989     v-list-items = v-list-items + chr(44) + entry (lookup (entry(v-ii, 'Intellect,Prizma':U), 'Intellect,Prizma':U) + 1, ',' + 'Интеллект,Призма':U) + chr(44) + entry(v-ii, 'Intellect,Prizma':U).
     3990   end.
     3991   assign
     3992   cb-cctv-system:list-item-pairs in frame Dialog-Frame =  v-list-items
     3993   .
     3994   if rs-rmethod-type = "MROUND" then do:
     3995     ASSIGN
     3996     rs-rmethod-coeff = v-rmethod-coeff
     3997     f-rmethod-coeff = 0
     3998     rs-rmethod-coeff:screen-value in frame Dialog-Frame = string(v-rmethod-coeff) no-error
     3999     .
     4000   end.
     4001   else do:
     4002     assign
     4003     f-rmethod-coeff = v-rmethod-coeff
     4004     rs-rmethod-coeff = 2
     4005     rs-rmethod-coeff:screen-value in frame Dialog-Frame = string(2)
     4006     .
     4007   end.
     4008   ASSIGN
     4009   l-rmethod = "Тип и коэфф.округления суммы чека".
     4010   ASSIGN
     4011   FRAME Dialog-Frame:TITLE = substitute("&1 &2&3"
     4012                                          ,FRAME Dialog-Frame:TITLE
     4013                                          ,(if p-obj-type = ""
     4014                                            then ""
     4015                                            else 'маг':U)
     4016                                          ,(IF p-obj-type = "" THEN "" ELSE string(p-obj-code)))
     4017   v-tab-order[1] = "t-cash-shift,t-salesman-mandatory,t-manual-discnt,t-clear-cash-counter,t-qnty-change,b-curr,rs-log-level"
     4018   v-labels[1] = 'f-nalc,for-curr-name,l-log-level'
     4019   v-tab-order[2] = "t-cash-drawer-plug,rs-cash-drawer-plug-type,f-cash-drawer-plug-port,f-cash-drawer-plug-imp,f-cash-drawer-limit,t-cash-drawer-open," +
     4020                    "t-customer-display-plug,cb-customer-display-type,f-customer-display-port,f-customer-display-adv1,f-customer-display-adv2," +
     4021                    "cb-keyboard-type,b-keyboard-layout-id,cb-cashless-system,t-card-reader-plug,cb-cctv-system,f-cctv-system-address"
     4022   v-labels[2] = 'l-cash-drawer-plug-type,f-keyboard-layout-id,f-keyboard-layout-name'
     4023   v-tab-order[3] = "rs-cash-drawer-level,br-cash-pay-list,b-add-cash-pay,b-del-cash-pay,br-pay-names,t-cutter,f-com-port"
     4024   v-labels[3] = "l-cash-drawer-level"
     4025   v-tab-order[4] = "f-advert-text1,f-advert-text2,f-advert-text3," +
     4026                      "f-cliche-lines1,f-cliche-lines2,f-cliche-lines3,f-cliche-lines4," +
     4027                     "t-print-good-code,f-max-netto,rs-rmethod-type,rs-rmethod-coeff,f-rmethod-coeff,t-rcpt-ord-slip-print,t-rcpt-ord-alt-print"
     4028   v-labels[4] = "l-rmethod"
     4029   v-tab-order[5] = "cb-screen-type,b-screen-layout-id"
     4030   v-labels[5] = "f-screen-layout-id,f-screen-layout-name"
     4031   .
     4032   v-h = FRAME Dialog-Frame:FIRST-CHILD.
     4033   DO WHILE valid-handle(v-h).
     4034     IF v-h:TYPE = "field-group"  THEN DO:
     4035        v-h1 = v-h:FIRST-CHILD.
     4036        DO WHILE valid-handle(v-h1).
     4037         RUN tempwidg_create-record IN THIS-PROCEDURE ( INPUT v-h1).
     4038         ASSIGN
     4039         v-h1 = v-h1:NEXT-sibling.
     4040       END.
     4041     END.
     4042     v-h = v-h:NEXT-SIBLING.
     4043   END.
     4044   DO v-ii = 1 TO 5:
     4045     IF v-tab-order[v-ii] > '' THEN do:
     4046       DO v-jj = 1 TO NUM-ENTRIES(v-tab-order[v-ii]):
     4047        FIND FIRST temp-widget WHERE
     4048                   temp-widget.name_ = ENTRY(v-jj,v-tab-order[v-ii]) NO-ERROR.
     4049        IF AVAILABLE temp-widget THEN DO:
     4050            temp-widget.section_ = STRING(v-ii).
     4051        END.
     4052       END.
     4053     END.
     4054     IF v-labels[v-ii] > '' THEN do:
     4055       DO v-jj = 1 TO NUM-ENTRIES(v-labels[v-ii]):
     4056        FIND FIRST temp-widget WHERE
     4057                   temp-widget.name_ = ENTRY(v-jj,v-labels[v-ii]) NO-ERROR.
     4058        IF AVAILABLE temp-widget THEN DO:
     4059           temp-widget.section_ = STRING(v-ii).
     4060         END.
     4061       END.
     4062     END.
     4063   END.
     4064   RUN tempwidg_write-character IN THIS-PROCEDURE ( INPUT "f-cliche-lines1", f-cliche-lines1).
     4065   RUN tempwidg_write-character IN THIS-PROCEDURE ( INPUT "f-cliche-lines2", f-cliche-lines2).
     4066   RUN tempwidg_write-character IN THIS-PROCEDURE ( INPUT "f-cliche-lines3", f-cliche-lines3).
     4067   RUN tempwidg_write-character IN THIS-PROCEDURE ( INPUT "f-cliche-lines4", f-cliche-lines4).
     4068   RUN tempwidg_write-character IN THIS-PROCEDURE ( INPUT "f-advert-text1", f-advert-text1).
     4069   RUN tempwidg_write-character IN THIS-PROCEDURE ( INPUT "f-advert-text2", f-advert-text2).
     4070   RUN tempwidg_write-character IN THIS-PROCEDURE ( INPUT "f-advert-text3", f-advert-text3).
     4071   RUN tempwidg_write-character IN THIS-PROCEDURE ( INPUT "f-customer-display-adv1", f-customer-display-adv1).
     4072   RUN tempwidg_write-character IN THIS-PROCEDURE ( INPUT "f-customer-display-adv2", f-customer-display-adv2).
     4073   RUN tempwidg_write-character IN THIS-PROCEDURE ( INPUT "f-rmethod-coeff", f-rmethod-coeff).
     4074   FIND FIRST buf_layout NO-LOCK WHERE
     4075             buf_layout.layout-id = f-keyboard-layout-id NO-ERROR.
     4076   IF AVAILABLE buf_layout THEN DO:
     4077       ASSIGN
     4078       f-keyboard-layout-name = buf_layout.layout-name.
     4079   END.
     4080   ELSE DO:
     4081       ASSIGN
     4082       f-keyboard-layout-name = ?.
     4083   END.
     4084   FIND FIRST buf_layout NO-LOCK WHERE
     4085             buf_layout.layout-id = f-screen-layout-id NO-ERROR.
     4086   IF AVAILABLE buf_layout THEN DO:
     4087       ASSIGN
     4088       f-screen-layout-name = buf_layout.layout-name.
     4089   END.
     4090   ELSE DO:
     4091       ASSIGN
     4092       f-screen-layout-name = ?.
     4093   END.
     4094   DISPLAY
     4095   f-main
     4096   f-devices
     4097   f-fisreg
     4098   f-rec-print
     4099   f-interface
     4100   for-curr-name
     4101   l-cash-drawer-plug-type
     4102   l-cash-drawer-level
     4103   l-log-level
     4104   f-keyboard-layout-name
     4105   f-screen-layout-name
     4106   t-clear-cash-counter
     4107   t-qnty-change
     4108   WITH FRAME Dialog-Frame.
     4109   assign
     4110   fh = frame Dialog-Frame:first-child
     4111   wh = fh:first-child
     4112   .
     4113   do while valid-handle(wh):
     4114   if wh:private-data begins "recid=" then do:
     4115     find first thbjattr_thbj-attr where
     4116               recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     4117     IF wh:DATA-TYPE = 'logical':U
     4118     AND thbjattr_thbj-attr.prop-value-type = 'integer':U THEN DO:
     4119        wh:screen-value = string(IF thbjattr_thbj-attr.property-value-integer = 1 THEN YES ELSE NO).
     4120     END.
     4121     ELSE DO:
     4122       assign
     4123       wh:screen-value = string(buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value).
     4124     END.
     4125   end.
     4126   ELSE DO:
     4127      FIND FIRST temp-widget NO-LOCK WHERE
     4128                temp-widget.NAME_ = wh:NAME NO-ERROR.
     4129      IF AVAILABLE temp-widget THEN DO:
     4130         CASE temp-widget.DATA-TYPE_:
     4131           WHEN 'character':U THEN DO:
     4132               ASSIGN
     4133               wh:SCREEN-VALUE = temp-widget.CHARACTER_.
     4134           END.
     4135         END CASE.
     4136      END.
     4137   END.
     4138   wh = wh:next-sibling.
     4139   end.
