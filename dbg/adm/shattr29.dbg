     1720       f-cliche-lines6
     1721     f-cliche-lines = f-cliche-lines1 + chr(4) +
     1722                      f-cliche-lines2 + chr(4) +
     1723                      f-cliche-lines3 + chr(4) +
     1724                      f-cliche-lines4 + chr(4) +
     1725                      f-cliche-lines5 + chr(4) +
     1726                      f-cliche-lines6
     1727   f-cliche-lines:SCREEN-VALUE = f-cliche-lines
     1728     .
     1729   END.
     1730   ON VALUE-CHANGED OF f-com-port IN FRAME Dialog-Frame
     1731   DO:
     1732     assign f-com-port.
     1733   END.
     1734   ON LEAVE OF f-customer-display-adv1 IN FRAME Dialog-Frame
     1735   DO:
     1736     ASSIGN
     1737     f-customer-display-adv1
     1738     f-customer-display-adv = f-customer-display-adv1 + chr(4) + f-customer-display-adv2
     1739     f-customer-display-adv:SCREEN-VALUE = f-customer-display-adv
     1740     .
     1741   END.
     1742   ON LEAVE OF f-customer-display-adv2 IN FRAME Dialog-Frame
     1743   DO:
     1744       ASSIGN
     1745       f-customer-display-adv2
     1746       f-customer-display-adv = f-customer-display-adv1 + chr(4) + f-customer-display-adv2
     1747       f-customer-display-adv:SCREEN-VALUE = f-customer-display-adv
     1748       .
     1749   END.
     1750   ON LEAVE OF f-rmethod-coeff IN FRAME Dialog-Frame
     1751   DO:
     1752   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1753   if lookup(self :type
     1754            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1755            ) = 0
     1756   then do:
     1757     message
     1758       "$Workfile$"
     1759       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1760       "Интерфейсный элемент" self :name  skip
     1761       "Тип" self :type  skip
     1762       "Процедура" this-procedure :file-name skip
     1763       view-as alert-box .
     1764   end.
     1765   else do:
     1766     apply "entry":u to self  .
     1767     if focus :handle <> self :handle  then do:
     1768       return no-apply .
     1769     end.
     1770   end.
     1771     IF rs-rmethod-type = "NO-COINS" THEN DO:
     1772       ASSIGN
     1773       f-rmethod-coeff
     1774       v-rmethod-coeff = f-rmethod-coeff
     1775       v-rmethod-coeff:screen-value = string(v-rmethod-coeff)
     1776       .
     1777     END.
     1778   END.
     1779   ON VALUE-CHANGED OF RS-cash-drawer-plug-type IN FRAME Dialog-Frame
     1780   DO:
     1781       ASSIGN
     1782     rs-cash-drawer-plug-type.
     1783     CASE rs-cash-drawer-plug-type:
     1784       WHEN 1 THEN DO:
     1785          DISPLAY
     1786          f-cash-drawer-plug-port
     1787          WITH FRAME Dialog-Frame.
     1788       END.
     1789       WHEN 0 THEN DO:
     1790           hide
     1791           f-cash-drawer-plug-port
     1792           IN FRAME Dialog-Frame.
     1793       END.
     1794     END CASE.
     1795   END.
     1796   ON VALUE-CHANGED OF rs-rmethod-coeff IN FRAME Dialog-Frame
     1797   DO:
     1798   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1799   if lookup(self :type
     1800            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1801            ) = 0
     1802   then do:
     1803     message
     1804       "$Workfile$"
     1805       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1806       "Интерфейсный элемент" self :name  skip
     1807       "Тип" self :type  skip
     1808       "Процедура" this-procedure :file-name skip
     1809       view-as alert-box .
     1810   end.
     1811   else do:
     1812     apply "entry":u to self  .
     1813     if focus :handle <> self :handle  then do:
     1814       return no-apply .
     1815     end.
     1816   end.
     1817     IF rs-rmethod-type = "MROUND" THEN DO:
     1818       ASSIGN
     1819       rs-rmethod-coeff
     1820       v-rmethod-coeff = rs-rmethod-coeff
     1821       v-rmethod-coeff:screen-value = string(v-rmethod-coeff)
     1822       .
     1823     END.
     1824   END.
     1825   ON VALUE-CHANGED OF rs-rmethod-type IN FRAME Dialog-Frame
     1826   DO:
     1827    ASSIGN
     1828    rs-rmethod-type.
     1829    disable
     1830    f-rmethod-coeff
     1831    with frame Dialog-Frame .
     1832    DISPLAY
     1833    l-rmethod
     1834    WITH FRAME Dialog-Frame.
     1835    CASE rs-rmethod-type:
     1836      WHEN "MROUND" THEN DO:
     1837        ASSIGN
     1838        rs-rmethod-coeff:VISIBLE IN FRAME Dialog-Frame = YES
     1839        f-rmethod-coeff:VISIBLE IN FRAME Dialog-Frame = NO
     1840        .
     1841      END.
     1842      WHEN "NO-COINS" THEN DO:
     1843          ASSIGN
     1844          rs-rmethod-coeff:VISIBLE IN FRAME Dialog-Frame = NO
     1845          f-rmethod-coeff:VISIBLE IN FRAME Dialog-Frame = YES
     1846          f-rmethod-coeff:sensitive IN FRAME Dialog-Frame = (p-mode <> 'ПРОСМОТР':U)
     1847          .
     1848      END.
     1849   END CASE.
     1850   END.
     1851   ON VALUE-CHANGED OF t-cash-drawer-plug IN FRAME Dialog-Frame
     1852   DO:
     1853     ASSIGN
     1854     t-cash-drawer-plug.
     1855     CASE t-cash-drawer-plug:
     1856       WHEN no THEN DO:
     1857         IF p-mode <> 'ПРОСМОТР':U THEN DO:
     1858           ASSIGN
     1859           t-cash-drawer-open = NO
     1860           rs-cash-drawer-plug-type = 0
     1861           f-cash-drawer-plug-imp = 1
     1862           f-cash-drawer-plug-port = 0
     1863           rs-cash-drawer-level = 1
     1864           f-cash-drawer-limit = 1000000.00
     1865           .
     1866           DISPLAY
     1867           rs-cash-drawer-plug-type
     1868           f-cash-drawer-plug-port
     1869           f-cash-drawer-plug-imp
     1870           f-cash-drawer-limit
     1871           WITH FRAME Dialog-Frame.
     1872           disable
     1873           f-cash-drawer-plug-imp
     1874           f-cash-drawer-plug-port
     1875           RS-cash-drawer-level
     1876           rs-cash-drawer-plug-type
     1877           t-cash-drawer-open
     1878           f-cash-drawer-limit
     1879           with FRAME Dialog-Frame.
     1880         END.
     1881       END.
     1882       WHEN YES THEN DO:
     1883           IF p-mode <> 'ПРОСМОТР':U THEN DO:
     1884             enable
     1885             f-cash-drawer-plug-imp
     1886             f-cash-drawer-plug-port
     1887             RS-cash-drawer-level
     1888             rs-cash-drawer-plug-type
     1889             t-cash-drawer-open
     1890             f-cash-drawer-limit
     1891             WITH FRAME Dialog-Frame.
     1892           END.
     1893           ASSIGN
     1894           RS-cash-drawer-level:VISIBLE IN FRAME Dialog-Frame = no
     1895           t-cash-drawer-open:VISIBLE IN FRAME Dialog-Frame = yes
     1896           .
     1897       END.
     1898     END CASE.
     1899     APPLY "VALUE-CHANGED" TO rs-cash-drawer-plug-type.
     1900   END.
     1901   ON VALUE-CHANGED OF t-customer-display-plug IN FRAME Dialog-Frame
     1902   DO:
     1903     ASSIGN
     1904     t-customer-display-plug.
     1905     CASE t-customer-display-plug:
     1906       WHEN no THEN DO:
     1907         IF p-mode <> 'ПРОСМОТР':U THEN DO:
     1908           ASSIGN
     1909           cb-customer-display-type = ''
     1910           f-customer-display-port = ''
     1911           f-customer-display-adv1 = fill('_', 20)
     1912           f-customer-display-adv2 = fill('_', 20)
     1913           .
     1914           DISPLAY
     1915           cb-customer-display-type
     1916           f-customer-display-port
     1917           f-customer-display-adv1
     1918           f-customer-display-adv2
     1919           WITH FRAME Dialog-Frame.
     1920           disable
     1921           f-customer-display-port
     1922           CB-customer-display-type
     1923           f-customer-display-adv1
     1924           f-customer-display-adv2
     1925           with FRAME Dialog-Frame.
     1926         END.
     1927       END.
     1928       WHEN YES THEN DO:
     1929           IF p-mode <> 'ПРОСМОТР':U THEN DO:
     1930             enable
     1931             f-customer-display-port
     1932             cb-customer-display-type
     1933             f-customer-display-adv1
     1934             f-customer-display-adv2
     1935             WITH FRAME Dialog-Frame.
     1936           END.
     1937           ASSIGN
     1938           CB-customer-display-type:VISIBLE IN FRAME Dialog-Frame = yes
     1939           f-customer-display-port:VISIBLE IN FRAME Dialog-Frame = yes
     1940           f-customer-display-adv1:VISIBLE IN FRAME Dialog-Frame = yes
     1941           f-customer-display-adv2:VISIBLE IN FRAME Dialog-Frame = yes
     1942           .
     1943       END.
     1944     END CASE.
     1945   END.
     1946   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1947   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1948   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1949   on help of frame Dialog-Frame
     1950   do:
     1951     run gbl/app_help.p
     1952       (input this-procedure :file-name
     1953       ,input ''
     1954       ,input ?
     1955       ) no-error.
     1956     if error-status :error then do:
     1957       message
     1958         "Ошибка при вызове помощи"
     1959         error-status :get-message(1)
     1960         view-as alert-box .
     1961     end.
     1962   end.
     1963   run minbtn-set in this-procedure .
     1964   on choose of b-help in frame Dialog-Frame
     1965   do:
     1966     apply "help":u to frame Dialog-Frame .
     1967   end.
     1968   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1969   procedure minbtn-set :
     1970       do
     1971           on error undo, return error return-value
     1972           :
     1973           define variable ii              as integer       no-undo .
     1974           define variable fh              as widget-handle no-undo .
     1975           define variable hh              as widget-handle no-undo .
     1976           define variable v-h             as handle        extent 4 no-undo .
     1977           define variable v-name-button   as character     no-undo .
     1978           define variable v-help-old-x    as decimal       no-undo .
     1979           define variable v-help-old-y    as decimal       no-undo .
     1980           define variable v-help-old-size as decimal       no-undo .
     1981           define variable v-frame-width   as decimal       no-undo .
     1982           define variable jj              as integer       no-undo .
     1983           do
     1984               on error undo, return error
     1985               :
     1986               assign
     1987                   v-frame-width = frame Dialog-Frame:width - 0.3
     1988                   fh            = frame Dialog-Frame:first-child
     1989                   hh            = fh:first-child
     1990                   ii            = 1
     1991                   .
     1992               do while valid-handle(hh):
     1993                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1994                   do:
     1995                       case lc(hh:name) :
     1996                           when "b-help" then
     1997                               do:
     1998                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1999                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2000                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2001                                   hh:TOOLTIP = "Помощь" .
     2002                                   v-help-old-x = hh:column .
     2003                                   v-help-old-y = hh:row    .
     2004                                   v-help-old-size = hh:width .
     2005                                   hh:width-chars = 2.5 .
     2006                               end.
     2007                           when "b-print" then
     2008                               do:
     2009                                   hh:load-image("cmp/b-print.bmp":u) .
     2010                                   hh:TOOLTIP = "Печать" .
     2011                                   v-h[ii] = hh:handle .
     2012                                   ii = ii + 1 .
     2013                                   hh:width-chars = 3 .
     2014                               end.
     2015                           when "b-history" or
     2016                           when "b-hist" then
     2017                               do:
     2018                                   hh:load-image("cmp/b-hist.bmp":u) .
     2019                                   hh:TOOLTIP = "История" .
     2020                                   v-h[ii] = hh:handle .
     2021                                   ii = ii + 1 .
     2022                                   hh:width-chars = 3 .
     2023                               end.
     2024                           when "b-sch" then
     2025                               do:
     2026                                   hh:load-image("cmp/b-sch.bmp":u) .
     2027                                   hh:TOOLTIP = "Установка Фильтра" .
     2028                                   v-h[ii] = hh:handle .
     2029                                   ii = ii + 1 .
     2030                                   hh:width-chars = 3 .
     2031                               end.
     2032                           when "b-hist-user" then
     2033                               do:
     2034                                   hh:load-image("cmp/b-hist.bmp":u) .
     2035                                   hh:TOOLTIP = "История пользователя" .
     2036                                   ii = ii + 1 .
     2037                               end.
     2038                       end case.
     2039                   end.
     2040                   hh = hh:next-sibling.
     2041               end.
     2042               b-help:column = v-frame-width - b-help:width-chars.
     2043               jj = 0.
     2044               repeat ii = 4 to 1 by -1 :
     2045                   if valid-handle (v-h[ii] ) then
     2046                   do:
     2047                       jj  = jj + 1 .
     2048                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2049                       v-h[ii]:row    = v-help-old-y .
     2050                   end.
     2051               end.
     2052           end.
     2053       end.
     2054   end procedure.
     2055   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2056   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2057   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2058   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2059   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2060   define variable v-diasize-current-frame-height as decimal   no-undo .
     2061   define variable v-diasize-change-size          as logical   no-undo .
     2062   define variable v-diasize-resize-button        as handle    no-undo .
     2063   define variable v-diasize-wndmax               as logical   no-undo .
     2064   define variable v-diasize-wndstore             as logical   no-undo .
     2065   define variable v-diasize-proc-name            as character no-undo .
     2066   define variable v-diasize-browse-handle        as handle    no-undo .
     2067   define variable v-diasize-browse-number        as integer   no-undo .
     2068   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2069   define temp-table temp-diasize-handle no-undo
     2070     field handle-value  as handle
     2071     field save-position as decimal
     2072     index xpk is primary unique handle-value
     2073     .
     2074   define temp-table temp-browse-handle no-undo
     2075     field browse-type   as character
     2076     field browse-number as integer
     2077     field browse-handle as handle
     2078     field original-size as decimal
     2079     index xpk is primary unique browse-type browse-number
     2080     index xie browse-type browse-handle
     2081   .
     2082   procedure diasize_change-height :
     2083     define input  parameter p-change-value  as decimal   no-undo .
     2084     define input  parameter p-move-resize   as logical   no-undo .
     2085     define variable v-field-group-handle    as handle    no-undo .
     2086     define variable v-object-handle         as handle    no-undo .
     2087     define variable v-frame-height          as decimal   no-undo .
     2088     define variable v-frame-virtual-height  as decimal   no-undo .
     2089     define variable v-browse-height         as decimal   no-undo .
     2090     define variable v-window-height         as decimal   no-undo .
     2091     define variable v-window-virtual-height as decimal   no-undo .
     2092     define variable v-change-sign           as integer   no-undo .
     2093     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2094     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2095     if p-change-value > 0
     2096     then do:
     2097       if frame Dialog-Frame :height + p-change-value
     2098           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2099       then do:
     2100         assign
     2101           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2102                           - (frame Dialog-Frame :height-chars)
     2103         .
     2104         if p-change-value <= 0
     2105         then do:
     2106           run diasize_position-resize-button in this-procedure .
     2107           return .
     2108         end.
     2109       end.
     2110     end.
     2111     if p-change-value < 0
     2112     then do:
     2113       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2114       then do:
     2115         assign
     2116           p-change-value = v-diasize-orig-frame-height
     2117                          - (frame Dialog-Frame :height-chars)
     2118         .
     2119         if p-change-value >= 0
     2120         then do:
     2121           run diasize_position-resize-button in this-procedure .
     2122           return .
     2123         end.
     2124       end.
     2125     end.
     2126     if p-change-value >= 0
     2127     then do:
     2128       assign
     2129         v-change-sign = 1
     2130       .
     2131     end.
     2132     else do:
     2133       assign
     2134         v-change-sign = -1
     2135       .
     2136     end.
     2137     assign
     2138       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2139     .
     2140     if p-change-value = 0
     2141     then do:
     2142       run diasize_position-resize-button in this-procedure .
     2143       return .
     2144     end.
     2145     move_block:
     2146     do
     2147     on error undo move_block, retry move_block
     2148     :
     2149       if retry
     2150       then do:
     2151         do
     2152         on error undo move_block, leave move_block
     2153         :
     2154           if p-change-value > 0
     2155           then do:
     2156             for each buf_temp-diasize-handle
     2157             on error undo, next
     2158             :
     2159               assign
     2160                 v-object-handle = buf_temp-diasize-handle.handle-value
     2161               .
     2162               if v-object-handle <> v-diasize-resize-button
     2163               then do:
     2164                 assign
     2165                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2166                 .
     2167               end.
     2168             end.
     2169             assign
     2170               v-diasize-browse-handle :height = v-browse-height
     2171             .
     2172             for each buf_temp-browse-handle
     2173               where buf_temp-browse-handle.browse-type = 'height':u
     2174             on error undo, next
     2175             :
     2176               assign
     2177                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2178               .
     2179             end.
     2180             assign
     2181               frame Dialog-Frame :height = v-frame-height
     2182             .
     2183             if frame Dialog-Frame :scrollable = true
     2184             then do:
     2185               assign
     2186                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2187               .
     2188             end.
     2189             run diasize_position-resize-button in this-procedure .
     2190           end.
     2191           else do:
     2192             if frame Dialog-Frame :scrollable = true
     2193             then do:
     2194               assign
     2195                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2196               .
     2197             end.
     2198             assign
     2199               frame Dialog-Frame :height = v-frame-height
     2200             .
     2201             assign
     2202               v-diasize-browse-handle :height = v-browse-height
     2203             .
     2204             for each buf_temp-browse-handle
     2205               where buf_temp-browse-handle.browse-type = 'height':u
     2206             on error undo, next
     2207             :
     2208               assign
     2209                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2210               .
     2211             end.
     2212             for each buf_temp-diasize-handle
     2213             on error undo, next
     2214             :
     2215               assign
     2216                 v-object-handle = buf_temp-diasize-handle.handle-value
     2217               .
     2218               if v-object-handle <> v-diasize-resize-button
     2219               then do:
     2220                 assign
     2221                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2222                 .
     2223               end.
     2224             end.
     2225             run diasize_position-resize-button in this-procedure .
     2226           end.
     2227           assign
     2228             v-diasize-change-size = false
     2229           .
     2230           leave move_block .
     2231         end.
     2232       end.
     2233       assign
     2234         v-diasize-need-full-display = true
     2235       .
     2236       if v-diasize-change-size = false
     2237       then do:
     2238         assign
     2239           v-diasize-change-size = true
     2240         .
     2241       end.
     2242       else do:
     2243         return .
     2244       end.
     2245       assign
     2246         v-frame-height = frame Dialog-Frame :height
     2247         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2248         v-browse-height = v-diasize-browse-handle :height
     2249       .
     2250       for each buf_temp-browse-handle
     2251         where buf_temp-browse-handle.browse-type = 'height':u
     2252       :
     2253         assign
     2254           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2255         .
     2256       end.
     2257       for each buf_temp-diasize-handle
     2258       :
     2259         delete buf_temp-diasize-handle .
     2260       end.
     2261       assign
     2262         v-field-group-handle = frame Dialog-Frame :first-child
     2263       .
     2264       do while valid-handle(v-field-group-handle)
     2265       :
     2266         assign
     2267           v-object-handle = v-field-group-handle :first-child
     2268         .
     2269         do while valid-handle(v-object-handle)
     2270         :
     2271           if  v-object-handle <> v-diasize-browse-handle :handle
     2272           and can-query(v-object-handle, "row")
     2273           and can-query(v-object-handle, "height")
     2274           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2275           then do:
     2276             find first buf_temp-browse-handle
     2277               where buf_temp-browse-handle.browse-type   = 'height':u
     2278                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2279               no-error .
     2280             if available buf_temp-browse-handle
     2281             then do:
     2282             end.
     2283             else do:
     2284               create buf_temp-diasize-handle .
     2285               assign
     2286                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2287                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2288               .
     2289             end.
     2290           end.
     2291           assign
     2292             v-object-handle = v-object-handle :next-sibling
     2293           .
     2294         end.
     2295         assign
     2296           v-field-group-handle = v-field-group-handle :next-sibling
     2297         .
     2298       end.
     2299       do with frame Dialog-Frame
     2300       :
     2301         hide v-diasize-resize-button .
     2302         assign
     2303           v-diasize-resize-button :row    = 1
     2304           v-diasize-resize-button :column = 1
     2305         .
     2306       end.
     2307       if p-change-value > 0
     2308       then do:
     2309         if frame Dialog-Frame :scrollable = true
     2310         then do:
     2311           assign
     2312             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2313             no-error .
     2314           if error-status :error
     2315           or error-status :get-message(1) <> ""
     2316           then do:
     2317             undo move_block, retry move_block .
     2318           end.
     2319         end.
     2320         assign
     2321           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2322           no-error .
     2323         if error-status :error
     2324         or error-status :get-message(1) <> ""
     2325         then do:
     2326           undo move_block, retry move_block .
     2327         end.
     2328         assign
     2329           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2330           no-error .
     2331         if error-status :error
     2332         or error-status :get-message(1) <> ""
     2333         then do:
     2334           undo move_block, retry move_block .
     2335         end.
     2336         for each buf_temp-browse-handle
     2337           where buf_temp-browse-handle.browse-type = 'height':u
     2338         on error undo move_block, retry move_block
     2339         :
     2340           assign
     2341             buf_temp-browse-handle.browse-handle :height
     2342               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2343             no-error .
     2344           if error-status :error
     2345           or error-status :get-message(1) <> ""
     2346           then do:
     2347             undo move_block, retry move_block .
     2348           end.
     2349         end.
     2350         for each buf_temp-diasize-handle
     2351         on error undo move_block, retry move_block
     2352         :
     2353           assign
     2354             v-object-handle = buf_temp-diasize-handle.handle-value
     2355           .
     2356           if v-object-handle <> v-diasize-resize-button
     2357           then do:
     2358             assign
     2359               v-object-handle :row = v-object-handle :row + p-change-value
     2360               no-error .
     2361             if error-status :error
     2362             or error-status :get-message(1) <> ""
     2363             then do:
     2364               undo move_block, retry move_block .
     2365             end.
     2366           end.
     2367         end.
     2368       end.
     2369       else do:
     2370         for each buf_temp-diasize-handle
     2371         on error undo move_block, retry move_block
     2372         :
     2373           assign
     2374             v-object-handle = buf_temp-diasize-handle.handle-value
     2375           .
     2376           if v-object-handle <> v-diasize-resize-button
     2377           then do:
     2378             assign
     2379               v-object-handle :row = v-object-handle :row + p-change-value
     2380               no-error .
     2381             if error-status :error
     2382             or error-status :get-message(1) <> ""
     2383             then do:
     2384               undo move_block, retry move_block .
     2385             end.
     2386           end.
     2387         end.
     2388         assign
     2389           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2390           no-error .
     2391         if error-status :error
     2392         or error-status :get-message(1) <> ""
     2393         then do:
     2394           undo move_block, retry move_block .
     2395         end.
     2396         for each buf_temp-browse-handle
     2397           where buf_temp-browse-handle.browse-type = 'height':u
     2398         on error undo move_block, retry move_block
     2399         :
     2400           assign
     2401             buf_temp-browse-handle.browse-handle :height
     2402               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2403             no-error .
     2404           if error-status :error
     2405           or error-status :get-message(1) <> ""
     2406           then do:
     2407             undo move_block, retry move_block .
     2408           end.
     2409         end.
     2410         assign
     2411           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2412           no-error .
     2413         if error-status :error
     2414         or error-status :get-message(1) <> ""
     2415         then do:
     2416           undo move_block, retry move_block .
     2417         end.
     2418         if frame Dialog-Frame :scrollable = true
     2419         then do:
     2420           assign
     2421             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2422             no-error .
     2423           if error-status :error
     2424           or error-status :get-message(1) <> ""
     2425           then do:
     2426             undo move_block, retry move_block .
     2427           end.
     2428         end.
     2429       end.
     2430       if p-move-resize = true
     2431       then do:
     2432         run diasize_position-resize-button in this-procedure .
     2433       end.
     2434       if v-diasize-wndstore = true
     2435       then do:
     2436         if connected("ub") = true
     2437         then do:
     2438           define variable v-cntxt-db-num        as integer   no-undo .
     2439           define variable v-cntxt-userid        as character no-undo .
     2440           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2441                                             , OUTPUT v-cntxt-userid
     2442                                             ) .
     2443           run gbl/wndsizew.p
     2444             (input  v-cntxt-db-num
     2445             ,input  v-cntxt-userid
     2446             ,input  v-diasize-proc-name
     2447             ,input  'height':u
     2448             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2449             ) .
     2450         end.
     2451       end.
     2452     end.
     2453     assign
     2454       v-diasize-change-size = false
     2455     .
     2456   end procedure.
     2457   procedure diasize_set-height :
     2458     define input  parameter p-new-height  as decimal   no-undo .
     2459     define input  parameter p-move-resize as logical   no-undo .
     2460     do
     2461     on error undo, return error return-value
     2462     :
     2463       run diasize_change-height in this-procedure
     2464         (input  (p-new-height - frame Dialog-Frame :height)
     2465         ,input  p-move-resize
     2466         ) .
     2467     end.
     2468   end procedure.
     2469   procedure diasize_change-width :
     2470     define input  parameter p-change-value as decimal   no-undo .
     2471     define input  parameter p-move-resize  as logical   no-undo .
     2472     define variable v-field-group-handle   as handle    no-undo .
     2473     define variable v-object-handle        as handle    no-undo .
     2474     define variable v-frame-width          as decimal   no-undo .
     2475     define variable v-frame-virtual-width  as decimal   no-undo .
     2476     define variable v-browse-width         as decimal   no-undo .
     2477     define variable v-window-width         as decimal   no-undo .
     2478     define variable v-window-virtual-width as decimal   no-undo .
     2479     define variable v-change-sign          as integer   no-undo .
     2480     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2481     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2482     if p-change-value > 0
     2483     then do:
     2484       if frame Dialog-Frame :width + p-change-value >
     2485           session :width-chars
     2486       then do:
     2487         assign
     2488           p-change-value = session :width-chars - frame Dialog-Frame :width
     2489         .
     2490         if p-change-value <= 0
     2491         then do:
     2492           run diasize_position-resize-button in this-procedure .
     2493           return .
     2494         end.
     2495       end.
     2496     end.
     2497     if p-change-value < 0
     2498     then do:
     2499       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2500       then do:
     2501         assign
     2502           p-change-value = v-diasize-orig-frame-width
     2503                          - frame Dialog-Frame :width
     2504         .
     2505         if p-change-value >= 0
     2506         then do:
     2507           run diasize_position-resize-button in this-procedure .
     2508           return .
     2509         end.
     2510       end.
     2511     end.
     2512     if p-change-value >= 0
     2513     then do:
     2514       assign
     2515         v-change-sign = 1
     2516       .
     2517     end.
     2518     else do:
     2519       assign
     2520         v-change-sign = -1
     2521       .
     2522     end.
     2523     assign
     2524       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2525     .
     2526     if p-change-value = 0
     2527     then do:
     2528       run diasize_position-resize-button in this-procedure .
     2529       return .
     2530     end.
     2531     move_block:
     2532     do
     2533     on error undo move_block, leave move_block
     2534     :
     2535       if retry
     2536       then do:
     2537         do
     2538         on error undo move_block, leave move_block
     2539         :
     2540           if p-change-value > 0
     2541           then do:
     2542             for each buf_temp-diasize-handle
     2543             on error undo, next
     2544             :
     2545               assign
     2546                 v-object-handle = buf_temp-diasize-handle.handle-value
     2547               .
     2548               if v-object-handle <> v-diasize-resize-button
     2549               then do:
     2550                 assign
     2551                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2552                 .
     2553               end.
     2554             end.
     2555             assign
     2556               v-diasize-browse-handle :width = v-browse-width
     2557             .
     2558             for each buf_temp-browse-handle
     2559               where buf_temp-browse-handle.browse-type = 'width':u
     2560             on error undo, next
     2561             :
     2562               assign
     2563                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2564               .
     2565             end.
     2566             assign
     2567               frame Dialog-Frame :width = v-frame-width
     2568             .
     2569             if frame Dialog-Frame :scrollable = true
     2570             then do:
     2571               assign
     2572                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2573               .
     2574             end.
     2575             run diasize_position-resize-button in this-procedure .
     2576           end.
     2577           else do:
     2578             if frame Dialog-Frame :scrollable = true
     2579             then do:
     2580               assign
     2581                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2582               .
     2583             end.
     2584             assign
     2585               frame Dialog-Frame :width = v-frame-width
     2586             .
     2587             for each buf_temp-browse-handle
     2588               where buf_temp-browse-handle.browse-type = 'width':u
     2589             on error undo, next
     2590             :
     2591               assign
     2592                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2593               .
     2594             end.
     2595             assign
     2596               v-diasize-browse-handle :width = v-browse-width
     2597             .
     2598             for each buf_temp-diasize-handle
     2599             on error undo, next
     2600             :
     2601               assign
     2602                 v-object-handle = buf_temp-diasize-handle.handle-value
     2603               .
     2604               if v-object-handle <> v-diasize-resize-button
     2605               then do:
     2606                 assign
     2607                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2608                 .
     2609               end.
     2610             end.
     2611             run diasize_position-resize-button in this-procedure .
     2612           end.
     2613           assign
     2614             v-diasize-change-size = false
     2615           .
     2616           leave move_block .
     2617         end.
     2618       end.
     2619       assign
     2620         v-diasize-need-full-display = true
     2621       .
     2622       if v-diasize-change-size = false
     2623       then do:
     2624         assign
     2625           v-diasize-change-size = true
     2626         .
     2627       end.
     2628       else do:
     2629         return .
     2630       end.
     2631       assign
     2632         v-frame-width = frame Dialog-Frame :width
     2633         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2634         v-browse-width = v-diasize-browse-handle :width
     2635       .
     2636       for each buf_temp-browse-handle
     2637         where buf_temp-browse-handle.browse-type = 'width':u
     2638       :
     2639         assign
     2640           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2641         .
     2642       end.
     2643       for each buf_temp-diasize-handle
     2644       :
     2645         delete buf_temp-diasize-handle .
     2646       end.
     2647       assign
     2648         v-field-group-handle = frame Dialog-Frame :first-child
     2649       .
     2650       do while valid-handle(v-field-group-handle)
     2651       :
     2652         assign
     2653           v-object-handle = v-field-group-handle :first-child
     2654         .
     2655         do while valid-handle(v-object-handle)
     2656         :
     2657           if  v-object-handle <> v-diasize-browse-handle :handle
     2658           and v-object-handle <> v-diasize-resize-button
     2659           and can-query(v-object-handle, "row")
     2660           and can-query(v-object-handle, "height")
     2661           and ( v-object-handle :col + v-object-handle :width
     2662                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2663               )
     2664           then do:
     2665             find first buf_temp-browse-handle
     2666               where buf_temp-browse-handle.browse-type   = 'width':u
     2667                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2668               no-error .
     2669             if available buf_temp-browse-handle
     2670             then do:
     2671             end.
     2672             else do:
     2673               create buf_temp-diasize-handle .
     2674               assign
     2675                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2676                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2677               .
     2678             end.
     2679           end.
     2680           assign
     2681             v-object-handle = v-object-handle :next-sibling
     2682           .
     2683         end.
     2684         assign
     2685           v-field-group-handle = v-field-group-handle :next-sibling
     2686         .
     2687       end.
     2688       do with frame Dialog-Frame
     2689       :
     2690         hide v-diasize-resize-button .
     2691         v-diasize-resize-button :row = 1.
     2692         v-diasize-resize-button :column = 1.
     2693       end.
     2694       if p-change-value > 0
     2695       then do:
     2696         if frame Dialog-Frame :scrollable = true
     2697         then do:
     2698           assign
     2699             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2700             no-error .
     2701           if error-status :error
     2702           or error-status :get-message(1) <> ""
     2703           then do:
     2704             undo move_block, retry move_block.
     2705           end.
     2706         end.
     2707         assign
     2708           frame Dialog-Frame :width = v-frame-width + p-change-value
     2709           no-error .
     2710         if error-status :error
     2711         or error-status :get-message(1) <> ""
     2712         then do:
     2713           undo move_block, retry move_block.
     2714         end.
     2715         assign
     2716           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2717         no-error .
     2718         if error-status :error
     2719         or error-status :get-message(1) <> ""
     2720         then do:
     2721           undo move_block, retry move_block.
     2722         end.
     2723         for each buf_temp-browse-handle
     2724           where buf_temp-browse-handle.browse-type = 'width':u
     2725         on error undo move_block, retry move_block
     2726         :
     2727           assign
     2728             buf_temp-browse-handle.browse-handle :width
     2729               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2730             no-error .
     2731           if error-status :error
     2732           or error-status :get-message(1) <> ""
     2733           then do:
     2734             undo move_block, retry move_block .
     2735           end.
     2736         end.
     2737         for each buf_temp-diasize-handle
     2738         on error undo move_block, retry move_block
     2739         :
     2740           assign
     2741             v-object-handle = buf_temp-diasize-handle.handle-value
     2742           .
     2743           if v-object-handle <> v-diasize-resize-button
     2744           then do:
     2745             assign
     2746               v-object-handle :col = v-object-handle :col + p-change-value
     2747               no-error .
     2748             if error-status :error
     2749             or error-status :get-message(1) <> ""
     2750             then do:
     2751               undo move_block, retry move_block .
     2752             end.
     2753           end.
     2754         end.
     2755       end.
     2756       else do:
     2757         for each buf_temp-diasize-handle
     2758         on error undo move_block, retry move_block
     2759         :
     2760           assign
     2761             v-object-handle = buf_temp-diasize-handle.handle-value
     2762           .
     2763           if v-object-handle <> v-diasize-resize-button
     2764           then do:
     2765             assign
     2766               v-object-handle :col = v-object-handle :col + p-change-value
     2767               no-error .
     2768             if error-status :error
     2769             or error-status :get-message(1) <> ""
     2770             then do:
     2771               undo move_block, retry move_block .
     2772             end.
     2773           end.
     2774         end.
     2775         for each buf_temp-browse-handle
     2776           where buf_temp-browse-handle.browse-type = 'width':u
     2777         on error undo move_block, retry move_block
     2778         :
     2779           assign
     2780             buf_temp-browse-handle.browse-handle :width
     2781               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2782             no-error .
     2783           if error-status :error
     2784           or error-status :get-message(1) <> ""
     2785           then do:
     2786             undo move_block, retry move_block .
     2787           end.
     2788         end.
     2789         assign
     2790           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2791           no-error .
     2792         if error-status :error
     2793         or error-status :get-message(1) <> ""
     2794         then do:
     2795           undo move_block, retry move_block.
     2796         end.
     2797         assign
     2798           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2799         no-error .
     2800         if error-status :error
     2801         or error-status :get-message(1) <> ""
     2802         then do:
     2803           undo move_block, retry move_block.
     2804         end.
     2805         if frame Dialog-Frame :scrollable = true
     2806         then do:
     2807           assign
     2808             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2809           no-error .
     2810           if error-status :error
     2811           or error-status :get-message(1) <> ""
     2812           then do:
     2813             undo move_block, retry move_block.
     2814           end.
     2815         end.
     2816       end.
     2817       if p-move-resize
     2818       then do:
     2819         run diasize_position-resize-button in this-procedure .
     2820       end.
     2821       if v-diasize-wndstore = true
     2822       then do:
     2823         if connected("ub") = true
     2824         then do:
     2825           define variable v-cntxt-db-num        as integer   no-undo .
     2826           define variable v-cntxt-userid        as character no-undo .
     2827           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2828                                             , OUTPUT v-cntxt-userid
     2829                                             ) .
     2830           run gbl/wndsizew.p
     2831             (input  v-cntxt-db-num
     2832             ,input  v-cntxt-userid
     2833             ,input  v-diasize-proc-name
     2834             ,input  'width':u
     2835             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2836             ) .
     2837         end.
     2838       end.
     2839     end.
     2840     assign
     2841       v-diasize-change-size = false
     2842     .
     2843   end procedure.
     2844   procedure diasize_set-width :
     2845     define input  parameter p-new-width  as decimal   no-undo .
     2846     define input  parameter p-move-resize as logical   no-undo .
     2847     do
     2848     on error undo, return error return-value
     2849     :
     2850       run diasize_change-width in this-procedure
     2851         (input  (p-new-width - frame Dialog-Frame :width)
     2852         ,input  p-move-resize
     2853         ) .
     2854     end.
     2855   end procedure.
     2856   procedure diasize_position-resize-button :
     2857     do with frame Dialog-Frame
     2858     :
     2859       hide v-diasize-resize-button .
     2860       assign
     2861         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2862                     - 1
     2863                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2864         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2865                     - 1
     2866                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2867       .
     2868       view v-diasize-resize-button .
     2869     end.
     2870   end procedure.
     2871   on alt-right anywhere
     2872   do:
     2873     run diasize_change-width in this-procedure
     2874       (input 1
     2875       ,input true
     2876       ) .
     2877     return no-apply .
     2878   end.
     2879   on alt-left anywhere
     2880   do:
     2881     run diasize_change-width in this-procedure
     2882       (input -1
     2883       ,input true
     2884       ) .
     2885     return no-apply .
     2886   end.
     2887   on alt-down anywhere
     2888   do:
     2889     run diasize_change-height in this-procedure
     2890       (input 1
     2891       ,input true
     2892       ) .
     2893     return no-apply .
     2894   end.
     2895   on alt-up anywhere
     2896   do:
     2897     run diasize_change-height in this-procedure
     2898       (input -1
     2899       ,input true
     2900       ) .
     2901     return no-apply .
     2902   end.
     2903   on alt-enter of frame Dialog-Frame
     2904   do:
     2905     run diasize_maximize in this-procedure
     2906       (input  ?
     2907       ).
     2908     return no-apply .
     2909   end.
     2910   procedure diasize_end-move :
     2911     do
     2912     on error undo, return error return-value
     2913     :
     2914       define variable v-row-delta as decimal   no-undo .
     2915       define variable v-col-delta as decimal   no-undo .
     2916       define variable v-new-row as decimal   no-undo .
     2917       define variable v-new-col as decimal   no-undo .
     2918       assign
     2919         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2920         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2921       .
     2922       assign
     2923         v-row-delta = v-new-row - frame Dialog-Frame :height
     2924         v-col-delta = v-new-col - frame Dialog-Frame :width
     2925       .
     2926       run diasize_change-height in this-procedure
     2927         (input v-row-delta
     2928         ,input true
     2929         ) .
     2930       run diasize_change-width in this-procedure
     2931         (input v-col-delta
     2932         ,input true
     2933         ) .
     2934     end.
     2935   end procedure.
     2936   procedure diasize_maximize :
     2937     define input  parameter p-action as logical   no-undo .
     2938     do
     2939     on error undo, return error return-value
     2940     :
     2941       if p-action = ?
     2942       then do:
     2943         if v-diasize-need-maximize = true
     2944         then do:
     2945           assign
     2946             p-action = true
     2947           .
     2948         end.
     2949         else do:
     2950           assign
     2951             p-action = false
     2952           .
     2953         end.
     2954       end.
     2955       if p-action = true
     2956       then do:
     2957         run diasize_change-height in this-procedure
     2958           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2959               - frame Dialog-Frame :height-chars
     2960           ,input true
     2961           ) .
     2962         run diasize_change-width in this-procedure
     2963           (input session :width-chars
     2964               - frame Dialog-Frame :width-chars
     2965           ,input true
     2966           ) .
     2967         assign
     2968           v-diasize-need-maximize = false
     2969         .
     2970       end.
     2971       else do:
     2972         run diasize_change-width in this-procedure
     2973           (input v-diasize-orig-frame-width
     2974               - frame Dialog-Frame :width-chars
     2975           ,input true
     2976           ) .
     2977         run diasize_change-height in this-procedure
     2978           (input v-diasize-orig-frame-height
     2979               - frame Dialog-Frame :height-chars
     2980           ,input true
     2981           ) .
     2982         assign
     2983           v-diasize-need-maximize = true
     2984         .
     2985       end.
     2986     end.
     2987   end procedure.
     2988   procedure diasize_restore-orig-size :
     2989     do
     2990     on error undo, return error return-value
     2991     :
     2992       assign
     2993         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2994         v-diasize-current-frame-height = frame Dialog-Frame :height
     2995       .
     2996       run diasize_set-height in this-procedure
     2997         (input  v-diasize-orig-frame-height
     2998         ,input  true
     2999         ) .
     3000       run diasize_set-width in this-procedure
     3001         (input  v-diasize-orig-frame-width
     3002         ,input  true
     3003         ) .
     3004     end.
     3005   end procedure.
     3006   procedure diasize_restore-current-size :
     3007     do
     3008     on error undo, return error return-value
     3009     :
     3010       run diasize_set-height in this-procedure
     3011         (input  v-diasize-current-frame-height
     3012         ,input  true
     3013         ) .
     3014       run diasize_set-width in this-procedure
     3015         (input  v-diasize-current-frame-width
     3016         ,input  true
     3017         ) .
     3018     end.
     3019   end procedure.
     3020   procedure diasize_set-browse-handle :
     3021     define input  parameter p-browse-handle as handle   no-undo .
     3022     define buffer buf_temp-browse-handle for temp-browse-handle .
     3023     do
     3024     on error undo, return error return-value
     3025     :
     3026       assign
     3027         v-diasize-browse-handle = p-browse-handle
     3028       .
     3029       for each buf_temp-browse-handle
     3030       on error undo, return error return-value
     3031       :
     3032         delete buf_temp-browse-handle .
     3033       end.
     3034     end.
     3035   end procedure.
     3036   procedure diasize_add_browse :
     3037     define input  parameter p-browse-type   as character no-undo .
     3038     define input  parameter p-browse-handle as handle    no-undo .
     3039     define buffer buf_temp-browse-handle for temp-browse-handle .
     3040     do
     3041     on error undo, return error return-value
     3042     :
     3043       assign
     3044         v-diasize-browse-number = v-diasize-browse-number + 1
     3045       .
     3046       create buf_temp-browse-handle .
     3047       assign
     3048         buf_temp-browse-handle.browse-type   = p-browse-type
     3049         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3050         buf_temp-browse-handle.browse-handle = p-browse-handle
     3051       .
     3052     end.
     3053   end procedure.
     3054   procedure diasize_init :
     3055     define variable v-default-value    as logical   no-undo .
     3056     define variable v-restore-saved    as logical   no-undo .
     3057     define variable v-resize-value-str as character no-undo .
     3058     do
     3059     on error undo, return error return-value
     3060     :
     3061       do with frame Dialog-Frame
     3062       :
     3063         assign
     3064           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3065           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3066           v-diasize-browse-handle     = browse BR-cash-pay-list :handle
     3067         .
     3068         create button v-diasize-resize-button
     3069         assign
     3070           parent        = frame Dialog-Frame :first-child
     3071           label         = "s"
     3072           height-pixels = 16
     3073           width-pixels  = 16
     3074           visible       = true
     3075           sensitive     = true
     3076           movable       = true
     3077           triggers:
     3078             on end-move persistent run diasize_end-move in this-procedure .
     3079           end triggers.
     3080         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3081         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3082         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3083         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3084         assign
     3085           v-diasize-wndmax = false
     3086         .
     3087         if connected("ub") = true
     3088         then do:
     3089           define variable v-cntxt-db-num        as integer   no-undo .
     3090           define variable v-cntxt-userid        as character no-undo .
     3091           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3092                                             , OUTPUT v-cntxt-userid
     3093                                             ) .
     3094           run gbl/wndpar_r.p
     3095             (input  v-cntxt-db-num
     3096             ,input  v-cntxt-userid
     3097             ,input  'wndmax':U
     3098             ,output v-diasize-wndmax
     3099             ,output v-default-value
     3100             ) .
     3101         end.
     3102         assign
     3103           v-diasize-wndstore = false
     3104         .
     3105         if connected("ub") = true
     3106         then do:
     3107           run gbl/wndpar_r.p
     3108             (input  v-cntxt-db-num
     3109             ,input  v-cntxt-userid
     3110             ,input  'wndstore':U
     3111             ,output v-diasize-wndstore
     3112             ,output v-default-value
     3113             ) .
     3114         end.
     3115         assign
     3116           v-diasize-proc-name = entry(1, program-name(2), '.')
     3117         .
     3118         if v-diasize-wndstore = true
     3119         then do:
     3120           assign
     3121             v-restore-saved = false
     3122           .
     3123           if connected("ub") = true
     3124           then do:
     3125             run gbl/wndsizer.p
     3126               (input  v-cntxt-db-num
     3127               ,input  v-cntxt-userid
     3128               ,input  v-diasize-proc-name
     3129               ,input  'height':u
     3130               ,output v-resize-value-str
     3131               ) .
     3132             if v-resize-value-str <> '':U
     3133             then do:
     3134               run diasize_change-height in this-procedure
     3135                 (input  integer(v-resize-value-str)
     3136                 ,input  true
     3137                 ) .
     3138               assign
     3139                 v-restore-saved = true
     3140               .
     3141             end.
     3142           end.
     3143           if connected("ub") = true
     3144           then do:
     3145             run gbl/wndsizer.p
     3146               (input  v-cntxt-db-num
     3147               ,input  v-cntxt-userid
     3148               ,input  v-diasize-proc-name
     3149               ,input  'width':u
     3150               ,output v-resize-value-str
     3151               ) .
     3152             if v-resize-value-str <> '':U
     3153             then do:
     3154               run diasize_change-width in this-procedure
     3155                 (input  integer(v-resize-value-str)
     3156                 ,input  true
     3157                 ) .
     3158               assign
     3159                 v-restore-saved = true
     3160               .
     3161             end.
     3162           end.
     3163           if v-restore-saved <> true
     3164           then do:
     3165             if v-diasize-wndmax = true
     3166             then do:
     3167               run diasize_maximize in this-procedure
     3168                 (input  true
     3169                 ) .
     3170             end.
     3171           end.
     3172         end.
     3173         else do:
     3174           if v-diasize-wndmax = true
     3175           then do:
     3176             run diasize_maximize in this-procedure
     3177               (input  true
     3178               ) .
     3179           end.
     3180         end.
     3181       end.
     3182     end.
     3183   end procedure.
     3184   procedure diasize_need-full-display :
     3185     define output parameter p-need-full-display as logical   no-undo .
     3186     do
     3187     on error undo, return error return-value
     3188     :
     3189       assign
     3190         p-need-full-display = v-diasize-need-full-display
     3191       .
     3192       assign
     3193         v-diasize-need-full-display = false
     3194       .
     3195     end.
     3196   end procedure.
     3197   procedure get-context :
     3198      define output parameter p-db-num as integer          no-undo.
     3199      define output parameter p-user-id as character        no-undo.
     3200      define variable v-login               as character    no-undo.
     3201      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3202      define buffer buf_user-login  for ub.user-login .
     3203      do
     3204      on error undo, return error
     3205      :
     3206            FIND FIRST buf_sys-ctrl no-lock.
     3207            ASSIGN
     3208               v-login = USERID("ub")
     3209               p-db-num = buf_sys-ctrl.db-num
     3210            .
     3211            FIND FIRST buf_user-login
     3212                 WHERE buf_user-login.db-num = p-db-num
     3213                   AND buf_user-login.user-login = v-login
     3214                 no-lock
     3215                 no-error
     3216                 .
     3217            IF AVAILABLE buf_user-login
     3218            THEN DO:
     3219               assign
     3220                  p-user-id = buf_user-login.user-id
     3221               .
     3222            END.
     3223      end.
     3224   end procedure.
     3225       run diasize_init in this-procedure .
     3226   ON LEAVE OF temp-cash-pay-list.frpay-code IN BROWSE br-cash-pay-list do:
     3227   define variable old-frpay-code    AS integer no-undo .
     3228   if not avail temp-cash-pay-list then return no-apply.
     3229   ASSIGN
     3230   OLD-frpay-code = temp-cash-pay-list.frpay-code
     3231   .
     3232   IF NOT (INTEGER(temp-cash-pay-list.frpay-code) >= 2
     3233           OR
     3234           INTEGER(temp-cash-pay-list.frpay-code) <= 4
     3235           )
     3236           THEN DO:
     3237     MESSAGE
     3238     "Неверный код вида оплаты ФР"
     3239     VIEW-AS ALERT-BOX ERROR.
     3240     ASSIGN
     3241     temp-cash-pay-list.frpay-code = old-frpay-code
     3242     .
     3243     DISPLAY
     3244     temp-cash-pay-list.frpay-code
     3245     with BROWSE br-cash-pay-list.
     3246     RETURN NO-APPLY.
     3247   END.
     3248   ASSIGN
     3249   temp-cash-pay-list.frpay-code = INTEGER(temp-cash-pay-list.frpay-code:SCREEN-VALUE IN BROWSE br-cash-pay-list)
     3250   .
     3251   DISPLAY
     3252   get-frpay-name (temp-cash-pay-list.frpay-code) @ v-frpay-name
     3253   WITH BROWSE br-cash-pay-list.
     3254   br-cash-pay-list:REFRESH() IN FRAME Dialog-Frame.
     3255   end.
     3256   MAIN-BLOCK:
     3257   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3258      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3259   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3260     run mainmenu_getcntxt in parparentproc
     3261       (output v-cntxt-db-num
     3262       ,output v-cntxt-userid
     3263       ,output v-cntxt-level
     3264       ,output v-cntxt-host-code-obj
     3265       ,output v-cntxt-obj-type
     3266       ,output v-cntxt-obj-code
     3267       ,output v-cntxt-db-num-obj
     3268       ,output v-cntxt-is-admin
     3269       ) .
     3270   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3271   ON TAB ANYWHERE
     3272   DO:
     3273   define variable ii as integer no-undo .
     3274   define variable fh as widget-handle no-undo .
     3275   define variable hh as widget-handle no-undo .
     3276   define variable v-next-widget-name as character no-undo .
     3277   if v-current-tab-order <> '' then do:
     3278     if self:type = "TOGGLE-BOX" then
     3279     self:BGCOLOR = ?.
     3280     assign
     3281     ii = lookup(self:name, v-current-tab-order).
     3282     assign
     3283     ii = ii + 1
     3284     v-next-widget-name = entry(ii, v-current-tab-order)
     3285     no-error .
     3286     if error-status:error then do:
     3287       assign
     3288       ii = 1
     3289       v-next-widget-name = entry( ii, v-current-tab-order)
     3290       .
     3291     end.
     3292     assign
     3293     fh = frame Dialog-Frame:first-child
     3294     hh = fh:first-child
     3295     .
     3296     do while valid-handle(hh):
     3297       if hh:name = v-next-widget-name then do:
     3298         if hh:sensitive  = yes
     3299         AND hh:visible = yes then do:
     3300           if hh:type = "TOGGLE-BOX":U then do:
     3301             assign
     3302             hh:BGcolor = 1
     3303             .
     3304           end.
     3305           APPLY "ENTRY" to hh.
     3306           return no-apply.
     3307         end.
     3308         else do:
     3309           APPLY "TAB" to hh.
     3310           return no-apply.
     3311         end.
     3312       end.
     3313       hh = hh:next-sibling.
     3314     end.
     3315   end.
     3316   END.
     3317   ON BACK-TAB ANYWHERE
     3318   DO:
     3319   define variable ii as integer no-undo .
     3320   define variable fh as widget-handle no-undo .
     3321   define variable hh as widget-handle no-undo .
     3322   define variable v-next-widget-name as character no-undo .
     3323   if v-current-tab-order <> '' then do:
     3324     assign
     3325     ii = lookup(self:name, v-current-tab-order).
     3326     .
     3327     assign
     3328     ii = (if ii = 1
     3329           then  num-entries(v-current-tab-order)
     3330           else ii - 1
     3331           )
     3332     v-next-widget-name = entry(ii, v-current-tab-order)
     3333     .
     3334     assign
     3335     fh = frame Dialog-Frame:first-child
     3336     hh = fh:first-child
     3337     .
     3338     do while valid-handle(hh):
     3339       if hh:name = v-next-widget-name then do:
     3340         if hh:sensitive  = yes
     3341         AND hh:visible = yes then do:
     3342           if hh:type = "TOGGLE-BOX":U then do:
     3343             assign
     3344             hh:BGcolor = 1
     3345             .
     3346           end.
     3347           APPLY "ENTRY" to hh.
     3348           return no-apply.
     3349         end.
     3350         else do:
     3351         APPLY "BACK-TAB" to hh.
     3352         return no-apply.
     3353         end.
     3354       end.
     3355       hh = hh:next-sibling.
     3356     end.
     3357     end.
     3358   END.
     3359   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3360   ON RETURN ANYWHERE
     3361   DO:
     3362   define variable ii as integer no-undo .
     3363   define variable fh as widget-handle no-undo .
     3364   define variable hh as widget-handle no-undo .
     3365   define variable v-next-widget-name as character no-undo .
     3366     if v-current-tab-order <> '' then do:
     3367       assign
     3368       ii = lookup(self:name, v-current-tab-order).
     3369       if ii = num-entries(v-current-tab-order) then do:
     3370           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     3371           return no-apply.
     3372       end.
     3373       if self:type <> "BUTTON" and
     3374         self:type <> "EDITOR"  then do:
     3375         run proc-move-forward in this-procedure .
     3376         return no-apply.
     3377       end.
     3378       if self:type = "BUTTON" then do:
     3379         APPLY "CHOOSE" to self.
     3380       end.
     3381       if self:type = "TOGGLE-BOX" then
     3382       self:BGCOLOR = ?.
     3383       assign
     3384       ii = ii + 1
     3385       v-next-widget-name = entry(ii, v-current-tab-order)
     3386       no-error .
     3387       if error-status:error then do:
     3388         assign
     3389         ii = 1
     3390         v-next-widget-name = entry( ii, v-current-tab-order)
     3391         .
     3392       end.
     3393       assign
     3394       fh = frame Dialog-Frame:first-child
     3395       hh = fh:first-child
     3396       .
     3397       do while valid-handle(hh):
     3398         if hh:name = v-next-widget-name then do:
     3399           if hh:sensitive  = yes
     3400           AND hh:visible = yes then do:
     3401             if hh:type = "TOGGLE-BOX":U then do:
     3402               assign
     3403               hh:BGcolor = 1
     3404               .
     3405             end.
     3406             APPLY "ENTRY" to hh.
     3407             return no-apply.
     3408           end.
     3409           else do:
     3410             APPLY "TAB" to hh.
     3411             return no-apply.
     3412           end.
     3413         end.
     3414         hh = hh:next-sibling.
     3415       end.
     3416     end.
     3417   END.
     3418   procedure proc-move-forward :
     3419   define variable ii as integer no-undo .
     3420   define variable fh as widget-handle no-undo .
     3421   define variable hh as widget-handle no-undo .
     3422   define variable v-next-widget-name as character no-undo .
     3423   do
     3424   on error undo, return error
     3425   :
     3426     if v-current-tab-order <> '' then do:
     3427       if self:type = "TOGGLE-BOX" then
     3428       self:BGCOLOR = ?.
     3429       assign
     3430       ii = lookup(self:name, v-current-tab-order).
     3431       assign
     3432       ii = ii + 1
     3433       v-next-widget-name = entry(ii, v-current-tab-order)
     3434       no-error .
     3435       if error-status:error then do:
     3436         assign
     3437         ii = 1
     3438         v-next-widget-name = entry( ii, v-current-tab-order)
     3439         .
     3440       end.
     3441       assign
     3442       fh = frame Dialog-Frame:first-child
     3443       hh = fh:first-child
     3444       .
     3445       do while valid-handle(hh):
     3446         if hh:name = v-next-widget-name then do:
     3447           if hh:sensitive  = yes
     3448           AND hh:visible = yes then do:
     3449             if hh:type = "TOGGLE-BOX":U then do:
     3450               assign
     3451               hh:BGcolor = 1
     3452               .
     3453             end.
     3454             APPLY "ENTRY" to hh.
     3455             return.
     3456           end.
     3457           else do:
     3458             assign
     3459             ii = ii + 1
     3460             v-next-widget-name = entry(ii, v-current-tab-order)
     3461             no-error .
     3462             if error-status:error then do:
     3463               assign
     3464               ii = 1
     3465               v-next-widget-name = entry( ii, v-current-tab-order)
     3466               .
     3467             end.
     3468           end.
     3469         end.
     3470         hh = hh:next-sibling.
     3471       end.
     3472     end.
     3473   end.
     3474   end procedure.
     3475     IF p-mode <> 'ПРОСМОТР':U
     3476     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     3477         MESSAGE
     3478         vss-workfile vss-revision vss-description skip
     3479         "Неверное значение параметра p-mode" p-mode
     3480         VIEW-AS ALERT-BOX ERROR.
     3481         UNDO, RETURN ERROR.
     3482     END.
     3483     IF p-obj-type <> 'маг':U
     3484     and p-obj-type <> '':U
     3485     THEN DO:
     3486         MESSAGE
     3487         vss-workfile vss-revision vss-description skip
     3488         "Неверное значение параметра p-obj-type" p-obj-type
     3489         VIEW-AS ALERT-BOX ERROR.
     3490         UNDO, RETURN ERROR.
     3491     END.
     3492     if p-obj-type = 'маг':U then do:
     3493       FIND FIRST X_shop NO-LOCK WHERE X_shop.obj-code = p-obj-code NO-ERROR.
     3494       IF NOT AVAILABLE X_shop THEN DO:
     3495           MESSAGE
     3496           vss-workfile vss-revision vss-description skip
     3497           "Неверное значение параметра p-obj-code" p-obj-code
     3498           VIEW-AS ALERT-BOX ERROR.
     3499           UNDO, RETURN ERROR.
     3500       END.
     3501   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3502   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     3503     (input  'маг':U
     3504     ,input  p-obj-code
     3505     ,output v-db-num
     3506     )  .
     3507       IF v-db-num <> v-cntxt-db-num
     3508       AND v-cntxt-db-num <> 0
     3509       and p-mode <> 'ПРОСМОТР':U
     3510       THEN DO:
     3511           MESSAGE
     3512           "Нельзя менять параметры магазина в чужой БД" skip
     3513           "магазин принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     3514           VIEW-AS ALERT-BOX ERROR.
     3515           UNDO, RETURN ERROR.
     3516       END.
     3517   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3518   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3519     (input  p-obj-type
     3520     ,input  p-obj-code
     3521     ,output v-host-code
     3522     )  .
     3523     end.
     3524     if p-obj-type = '':U then do:
     3525       if v-cntxt-db-num <> 0
     3526       and p-mode <> 'ПРОСМОТР':U
     3527       then do:
     3528           MESSAGE
     3529           "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" skip
     3530           VIEW-AS ALERT-BOX ERROR.
     3531           UNDO, RETURN ERROR.
     3532       end.
     3533     end.
     3534     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     3535       FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
     3536                 LOCKED_thbj-attr.obj-type = p-obj-type
     3537           AND   LOCKED_thbj-attr.obj-code = p-obj-code
     3538           AND   LOCKED_thbj-attr.upper-prop-code = 'cd-type-IBS-TH':U
     3539           AND   locked_thbj-attr.prop-code = '':U NO-WAIT NO-ERROR.
     3540        if locked locked_thbj-attr then do:
     3541           message
     3542           vss-workfile vss-revision vss-description skip
     3543            "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
     3544           view-as alert-box error .
     3545           undo, return error.
     3546         end.
     3547     END.
     3548     ELSE DO:
     3549         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
     3550             LOCKED_thbj-attr.obj-type = p-obj-type
     3551       AND   LOCKED_thbj-attr.obj-code = p-obj-code
     3552       AND   LOCKED_thbj-attr.upper-prop-code = 'cd-type-IBS-TH':U
     3553       and   locked_thbj-attr.prop-code = '':U
     3554       NO-ERROR.
     3555     END.
     3556     if not available locked_thbj-attr then do:
     3557       ASSIGN
     3558       v-to-create  = YES.
     3559       message
     3560       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     3561                   chr(10))
     3562       view-as alert-box WARNING.
     3563     end.
     3564     RUN FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     3565     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     3566     RUN Myenable.
     3567     WAIT-FOR GO OF FRAME Dialog-Frame.
     3568   END.
     3569   RUN disable_UI.
     3570   PROCEDURE disable_UI :
     3571     HIDE FRAME Dialog-Frame.
