     1860             , input 0
     1861             , input 'shd':U
     1862             , input buf_schedule.cre-db-num
     1863             , input buf_schedule.task-type
     1864             , input buf_schedule.task-num
     1865             , input ?
     1866             , output v-cancel
     1867             , output v-params
     1868             , output v-object-list
     1869             , output v-doc-type-list
     1870             , output v-date-list
     1871             , output v-hsch-list
     1872             , output v-csch-list
     1873         ) no-error.
     1874         if error-status :error
     1875         then do:
     1876             message
     1877               vss-workfile vss-revision vss-description
     1878               skip "Ошибка изменения параметров для строки расписания."
     1879               skip return-value
     1880               skip trim(error-status :get-message(1))
     1881                   trim(error-status :get-message(2))
     1882                   trim(error-status :get-message(3))
     1883             view-as alert-box error.
     1884             undo, return no-apply.
     1885         end.
     1886       end.
     1887       when 'autofree':U then do:
     1888         run schedule-attr-get-free-id  in this-procedure (
     1889                                                            input buf_schedule.cre-db-num
     1890                                                           ,input buf_schedule.task-type
     1891                                                           ,input buf_schedule.task-num
     1892                                                           ,output v-free-id) no-error .
     1893         if error-status:error then do:
     1894           message
     1895           "Невозможно получить название  произвольного задания по строке расписания"
     1896           view-as alert-box error .
     1897           undo, return no-apply.
     1898         end.
     1899         run adm/freeshdp.w (
     1900               input parparentproc
     1901             , input 0
     1902             , input '':U
     1903             , input 0
     1904             , input 'shd':U
     1905             , input buf_schedule.cre-db-num
     1906             , input buf_schedule.task-type
     1907             , input buf_schedule.task-num
     1908             , input ?
     1909             , input-output v-free-id
     1910             , output v-cancel
     1911             , output v-params
     1912         ) no-error.
     1913         if error-status :error
     1914         then do:
     1915             message
     1916               vss-workfile vss-revision vss-description
     1917               skip "Ошибка изменения параметров для строки расписания."
     1918               skip return-value
     1919               skip trim(error-status :get-message(1))
     1920                   trim(error-status :get-message(2))
     1921                   trim(error-status :get-message(3))
     1922             view-as alert-box error.
     1923             undo, return no-apply.
     1924         end.
     1925       end.
     1926       otherwise do:
     1927         message vss-workfile vss-revision vss-description skip
     1928           "НЕТ ОБРАБОТКИ АТРИБУТА" v-task-type
     1929           view-as alert-box error.
     1930         return no-apply.
     1931       end.
     1932     end case.
     1933   END.
     1934   ON VALUE-CHANGED OF v-cre-db-num IN FRAME Dialog-Frame
     1935   DO:
     1936     assign
     1937       v-cre-db-num
     1938     .
     1939     OPEN QUERY br-schedule FOR EACH buf_schedule no-lock where buf_schedule.cre-db-num = v-cre-db-num AND buf_schedule.task-type = v-btpr-type .
     1940   END.
     1941   ON VALUE-CHANGED OF v-task-type IN FRAME Dialog-Frame
     1942   DO:
     1943     assign
     1944       v-task-type
     1945       v-btpr-type = v-task-type
     1946     .
     1947     case v-task-type:
     1948          when 'autonws':U
     1949       or when 'autooxml':U
     1950       or when 'mercury':U
     1951       or when 'hddtest':U
     1952       or when 'is_motp':U
     1953       or when 'is_diadoc':U
     1954       then do:
     1955         disable bt-param with frame Dialog-Frame .
     1956       end.
     1957          when 'autogcd':U
     1958       or when 'autoarh':U
     1959       or when 'autoexp':U
     1960       or when 'autosale':U
     1961       or when 'autosuz':U
     1962       or when 'autocbnk':U
     1963       or when 'autofree':U
     1964       or when 'is_PM':U
     1965       then do:
     1966         enable bt-param with frame Dialog-Frame .
     1967       end.
     1968       otherwise do:
     1969         message vss-workfile vss-revision vss-description skip
     1970           "НЕТ ОБРАБОТКИ АТРИБУТА" v-task-type
     1971           view-as alert-box error.
     1972         return no-apply.
     1973       end.
     1974     end case.
     1975     OPEN QUERY br-schedule FOR EACH buf_schedule no-lock where buf_schedule.cre-db-num = v-cre-db-num AND buf_schedule.task-type = v-btpr-type .
     1976   END.
     1977   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1978   on help of frame Dialog-Frame
     1979   do:
     1980     run gbl/app_help.p
     1981       (input this-procedure :file-name
     1982       ,input ''
     1983       ,input ?
     1984       ) no-error.
     1985     if error-status :error then do:
     1986       message
     1987         "Ошибка при вызове помощи"
     1988         error-status :get-message(1)
     1989         view-as alert-box .
     1990     end.
     1991   end.
     1992   run minbtn-set in this-procedure .
     1993   on choose of b-help in frame Dialog-Frame
     1994   do:
     1995     apply "help":u to frame Dialog-Frame .
     1996   end.
     1997   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1998   procedure minbtn-set :
     1999       do
     2000           on error undo, return error return-value
     2001           :
     2002           define variable ii              as integer       no-undo .
     2003           define variable fh              as widget-handle no-undo .
     2004           define variable hh              as widget-handle no-undo .
     2005           define variable v-h             as handle        extent 4 no-undo .
     2006           define variable v-name-button   as character     no-undo .
     2007           define variable v-help-old-x    as decimal       no-undo .
     2008           define variable v-help-old-y    as decimal       no-undo .
     2009           define variable v-help-old-size as decimal       no-undo .
     2010           define variable v-frame-width   as decimal       no-undo .
     2011           define variable jj              as integer       no-undo .
     2012           do
     2013               on error undo, return error
     2014               :
     2015               assign
     2016                   v-frame-width = frame Dialog-Frame:width - 0.3
     2017                   fh            = frame Dialog-Frame:first-child
     2018                   hh            = fh:first-child
     2019                   ii            = 1
     2020                   .
     2021               do while valid-handle(hh):
     2022                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2023                   do:
     2024                       case lc(hh:name) :
     2025                           when "b-help" then
     2026                               do:
     2027                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2028                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2029                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2030                                   hh:TOOLTIP = "Помощь" .
     2031                                   v-help-old-x = hh:column .
     2032                                   v-help-old-y = hh:row    .
     2033                                   v-help-old-size = hh:width .
     2034                                   hh:width-chars = 2.5 .
     2035                               end.
     2036                           when "b-print" then
     2037                               do:
     2038                                   hh:load-image("cmp/b-print.bmp":u) .
     2039                                   hh:TOOLTIP = "Печать" .
     2040                                   v-h[ii] = hh:handle .
     2041                                   ii = ii + 1 .
     2042                                   hh:width-chars = 3 .
     2043                               end.
     2044                           when "b-history" or
     2045                           when "b-hist" then
     2046                               do:
     2047                                   hh:load-image("cmp/b-hist.bmp":u) .
     2048                                   hh:TOOLTIP = "История" .
     2049                                   v-h[ii] = hh:handle .
     2050                                   ii = ii + 1 .
     2051                                   hh:width-chars = 3 .
     2052                               end.
     2053                           when "b-sch" then
     2054                               do:
     2055                                   hh:load-image("cmp/b-sch.bmp":u) .
     2056                                   hh:TOOLTIP = "Установка Фильтра" .
     2057                                   v-h[ii] = hh:handle .
     2058                                   ii = ii + 1 .
     2059                                   hh:width-chars = 3 .
     2060                               end.
     2061                           when "b-hist-user" then
     2062                               do:
     2063                                   hh:load-image("cmp/b-hist.bmp":u) .
     2064                                   hh:TOOLTIP = "История пользователя" .
     2065                                   ii = ii + 1 .
     2066                               end.
     2067                       end case.
     2068                   end.
     2069                   hh = hh:next-sibling.
     2070               end.
     2071               b-help:column = v-frame-width - b-help:width-chars.
     2072               jj = 0.
     2073               repeat ii = 4 to 1 by -1 :
     2074                   if valid-handle (v-h[ii] ) then
     2075                   do:
     2076                       jj  = jj + 1 .
     2077                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2078                       v-h[ii]:row    = v-help-old-y .
     2079                   end.
     2080               end.
     2081           end.
     2082       end.
     2083   end procedure.
     2084   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2085   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2086   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2087   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2088   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2089   define variable v-diasize-current-frame-height as decimal   no-undo .
     2090   define variable v-diasize-change-size          as logical   no-undo .
     2091   define variable v-diasize-resize-button        as handle    no-undo .
     2092   define variable v-diasize-wndmax               as logical   no-undo .
     2093   define variable v-diasize-wndstore             as logical   no-undo .
     2094   define variable v-diasize-proc-name            as character no-undo .
     2095   define variable v-diasize-browse-handle        as handle    no-undo .
     2096   define variable v-diasize-browse-number        as integer   no-undo .
     2097   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2098   define temp-table temp-diasize-handle no-undo
     2099     field handle-value  as handle
     2100     field save-position as decimal
     2101     index xpk is primary unique handle-value
     2102     .
     2103   define temp-table temp-browse-handle no-undo
     2104     field browse-type   as character
     2105     field browse-number as integer
     2106     field browse-handle as handle
     2107     field original-size as decimal
     2108     index xpk is primary unique browse-type browse-number
     2109     index xie browse-type browse-handle
     2110   .
     2111   procedure diasize_change-height :
     2112     define input  parameter p-change-value  as decimal   no-undo .
     2113     define input  parameter p-move-resize   as logical   no-undo .
     2114     define variable v-field-group-handle    as handle    no-undo .
     2115     define variable v-object-handle         as handle    no-undo .
     2116     define variable v-frame-height          as decimal   no-undo .
     2117     define variable v-frame-virtual-height  as decimal   no-undo .
     2118     define variable v-browse-height         as decimal   no-undo .
     2119     define variable v-window-height         as decimal   no-undo .
     2120     define variable v-window-virtual-height as decimal   no-undo .
     2121     define variable v-change-sign           as integer   no-undo .
     2122     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2123     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2124     if p-change-value > 0
     2125     then do:
     2126       if frame Dialog-Frame :height + p-change-value
     2127           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2128       then do:
     2129         assign
     2130           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2131                           - (frame Dialog-Frame :height-chars)
     2132         .
     2133         if p-change-value <= 0
     2134         then do:
     2135           run diasize_position-resize-button in this-procedure .
     2136           return .
     2137         end.
     2138       end.
     2139     end.
     2140     if p-change-value < 0
     2141     then do:
     2142       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2143       then do:
     2144         assign
     2145           p-change-value = v-diasize-orig-frame-height
     2146                          - (frame Dialog-Frame :height-chars)
     2147         .
     2148         if p-change-value >= 0
     2149         then do:
     2150           run diasize_position-resize-button in this-procedure .
     2151           return .
     2152         end.
     2153       end.
     2154     end.
     2155     if p-change-value >= 0
     2156     then do:
     2157       assign
     2158         v-change-sign = 1
     2159       .
     2160     end.
     2161     else do:
     2162       assign
     2163         v-change-sign = -1
     2164       .
     2165     end.
     2166     assign
     2167       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2168     .
     2169     if p-change-value = 0
     2170     then do:
     2171       run diasize_position-resize-button in this-procedure .
     2172       return .
     2173     end.
     2174     move_block:
     2175     do
     2176     on error undo move_block, retry move_block
     2177     :
     2178       if retry
     2179       then do:
     2180         do
