      883         (  input self
      884         ,  input this-procedure
      885         , output v-action
      886         ) no-error .
      887       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      888       assign
      889         v-inform-launched = false
      890       .
      891     end.
      892   end.
      893   procedure proc-alt-f1:
      894     run gbl/corrhelp.p
      895       (input this-procedure
      896       ) .
      897   end .
