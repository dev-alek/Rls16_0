     1785             , input buf_schedule.task-type
     1786             , input buf_schedule.task-num
     1787             , output v-cancel
     1788         ) no-error.
     1789         if error-status :error
     1790         then do:
     1791             message
     1792               vss-workfile vss-revision vss-description
     1793               skip "Ошибка изменения параметров для строки расписания."
     1794               skip return-value
     1795               skip trim(error-status :get-message(1))
