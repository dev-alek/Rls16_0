     3330   RUN disable_UI.
     3331   PROCEDURE add-modify-task :
     3332     if lookup( v-btpr-type, v-modify-btpr ) = 0 then do:
     3333       if v-modify-btpr <> "":U then do:
     3334         assign
     3335           v-modify-btpr = v-modify-btpr + ",":U
     3336           v-modify-task = v-modify-task + ",":U
     3337         .
     3338       end.
     3339       assign
     3340         v-modify-btpr = v-modify-btpr + v-btpr-type
     3341         v-modify-task = v-modify-task + '"':U + v-task-type + '"':U
     3342       .
     3343     end.
     3344   END PROCEDURE.
     3345   PROCEDURE delete-btpr :
     3346     define input        parameter p-btpr-type  as character no-undo .
     3347     define input        parameter p-btpr-task  as character no-undo .
     3348     define input-output parameter p-not-change as character no-undo .
     3349     do
     3350     on error undo, return error
     3351     :
     3352       define variable v-str    as character no-undo .
     3353       define buffer buf_BatchProcess for ub.BatchProcess .
     3354       assign
     3355         v-str = "":U
     3356       .
     3357       for each buf_BatchProcess exclusive-lock
     3358         where buf_BatchProcess.BP_Status = 'N':U
     3359           and buf_BatchProcess.BP_Type   = p-btpr-type
     3360       on error undo, return error
     3361       :
     3362         if buf_BatchProcess.Key#_One = 1 then do:
     3363           if v-str = "":U then do:
     3364             assign
     3365               v-str = substitute( "&1 для БД: &2", p-btpr-task, buf_BatchProcess.CharKey_One )
     3366             .
     3367           end.
     3368           else do:
     3369             assign
     3370               v-str = v-str + substitute( ",&1", buf_BatchProcess.CharKey_One )
     3371             .
     3372           end.
     3373         end.
     3374         else do:
     3375           delete buf_BatchProcess.
     3376         end.
     3377         if v-str <> "":U then do:
     3378           if p-not-change = "":U then do:
     3379             assign
     3380               p-not-change = v-str
     3381             .
     3382           end.
     3383           else do:
     3384             assign
     3385               p-not-change = p-not-change + chr(44) + v-str
     3386             .
     3387           end.
     3388         end.
     3389       end.
     3390     end.
     3391     return.
     3392   END PROCEDURE.
     3393   PROCEDURE disable_UI :
     3394     HIDE FRAME Dialog-Frame.
     3395   END PROCEDURE.
     3396   PROCEDURE enable_UI :
     3397     DISPLAY v-cre-db-num v-task-type
     3398         WITH FRAME Dialog-Frame.
     3399     ENABLE b-quit b-add b-chg b-copy b-del b-help v-cre-db-num v-task-type
     3400            br-schedule
     3401         WITH FRAME Dialog-Frame.
     3402     VIEW FRAME Dialog-Frame.
     3403     OPEN QUERY br-schedule FOR EACH buf_schedule no-lock where buf_schedule.cre-db-num = v-cre-db-num AND buf_schedule.task-type = v-btpr-type .
     3404   END PROCEDURE.
     3405   FUNCTION get-free-task-name RETURNS CHARACTER
     3406     ( input p-cre-db-num as integer, INPUT p-task-type AS character, INPUT p-task-num AS integer ) :
     3407   define variable v-dop as character no-undo .
     3408   define variable v-value as character no-undo .
     3409   define variable v-type as character no-undo .
     3410   IF p-task-type <> 'autofree':U THEN
     3411     RETURN "".
     3412   run schedule-attr-value in this-procedure (
     3413                                                input  p-cre-db-num
     3414                                               ,input  p-task-type
     3415                                               ,input  p-task-num
     3416                                               ,input  ('schd-free-id':U + chr(4))
     3417                                               ,output v-value
     3418                                               ,output v-type ) no-error .
     3419   if error-status:error then return chr(63).
     3420   assign
     3421   v-dop = entry(1, v-value, chr(4) )
     3422   no-error .
     3423   if error-status:error then do:
     3424     return chr(63).
     3425   end.
     3426   return v-dop.
     3427   END FUNCTION.
