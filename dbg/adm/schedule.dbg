        1   define input parameter parparentproc as widget-handle no-undo .
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Расписание автоматических заданий".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   PROCEDURE LastDate:
       80       def input parameter in-date as date no-undo.
       81       def output parameter LastDate as date no-undo.
       82       LastDate = ((DATE(MONTH(in-date),28,YEAR(in-date)) + 4) - DAY(DATE(MONTH(in-date),28,YEAR(in-date)) + 4)).
       83   END PROCEDURE.
       84   define temp-table curr-task no-undo
       85     field db-num      as character column-label "БД" format "X(5)"
       86     field db-num-char as character column-label "БД" format "X(5)"
       87     field task-num    as integer   column-label "N задачи" format ">>>>>>>9"
       88     field task-type   as character
       89     field cre-db-num    as integer
       90     field task-date   as date      column-label "Дата"  format "99.99.9999"
       91     field task-time   as integer   column-label "Время"
       92     field task-free-id  as character column-label "ID произвольного задания"
       93     index pi is unique primary
       94       task-type
       95       db-num
       96       task-num
       97     index pii
       98       task-type
       99       db-num
      100       task-date
      101       task-time
      102   .
      103   define temp-table tt-weekday no-undo
      104     field weekday as integer
      105     index pi is unique primary
      106       weekday ascending
      107   .
      108   define temp-table tt-hour no-undo
      109     field hour as integer
      110     index pi is unique primary
      111       hour ascending
      112   .
      113   define temp-table tt-minute no-undo
      114     field minute as integer
      115     index pi is unique primary
      116       minute ascending
      117   .
      118   define temp-table tt-db no-undo
      119     field db-num as integer
      120     index pi is unique primary
      121       db-num ascending
      122   .
      123   procedure trans-task :
      124     define input parameter p-task-type as character no-undo .
      125     do
      126     on error undo, return error
      127     :
      128       define variable v-curr-weekday  as integer   no-undo .
      129       define variable v-today         as date      no-undo .
      130       define variable v-curr-time     as integer   no-undo .
      131       define variable v-curr-time-str as character no-undo .
      132       define variable v-curr-hour     as integer   no-undo .
      133       define variable v-curr-minute   as integer   no-undo .
      134       define variable v-curr-sec      as integer   no-undo .
      135       define variable v-task-date     as date      no-undo .
      136       define variable v-task-time     as integer   no-undo .
      137       define variable v-last-date     as date      no-undo .
      138       define variable v-num-entries   as integer   no-undo .
      139       define variable v-ind           as integer   no-undo .
      140       define variable v-set-task      as logical   no-undo .
      141       define variable v-task-time-h   as integer   no-undo .
      142       define variable v-first-hour    as integer   no-undo .
      143       define variable v-task-time-m   as integer   no-undo .
      144       define variable v-first-minute  as integer   no-undo .
      145       define variable v-create-task   as logical   no-undo .
      146       define buffer buf_schedule for ub.schedule .
      147       define buffer buf_db       for ub.db .
      148       define buffer buf_sys-ctrl for ub.sys-ctrl .
      149       find first buf_sys-ctrl no-lock .
      150       block_sch:
      151       for each buf_schedule no-lock
      152         where buf_schedule.cre-db-num = buf_sys-ctrl.db-num
      153           and buf_schedule.task-type  = p-task-type
      154           and buf_schedule.active     = TRUE
      155       on error undo, return error
      156       :
      157         assign
      158           v-today         = today
      159           v-curr-time     = time
      160           v-curr-time-str = string( time, "HH:MM:SS":U )
      161           v-curr-hour     = integer( entry( 1, v-curr-time-str, ":":U ) )
      162           v-curr-minute   = integer( entry( 2, v-curr-time-str, ":":U ) )
      163           v-curr-sec      = integer( entry( 3, v-curr-time-str, ":":U ) )
      164           v-task-date     = v-today
      165           v-task-time     = v-curr-time
      166         .
      167         if trim( buf_schedule.task-weekday ) <> "*":U then do:
      168           for each tt-weekday
      169           on error undo, return error return-value
      170           :
      171             delete tt-weekday.
      172           end.
      173           run gbl/prcs-lst.p
      174             ( input  buf_schedule.task-weekday
      175              ,input  1
      176              ,input  7
      177              ,input  false
      178              ,input (buffer tt-weekday:handle)
      179              ,input "weekday":U
      180             ) no-error .
      181           find first tt-weekday no-lock
      182             where tt-weekday.weekday >= weekday( v-task-date ) - 1
      183             no-error .
      184           if available tt-weekday then do:
      185             assign
      186               v-task-date = v-task-date + tt-weekday.weekday - weekday( v-task-date ) + 1
      187             .
      188           end.
      189           else do:
      190             for first tt-weekday no-lock
      191               by tt-weekday.weekday
      192             on error undo, return error return-value
      193             :
      194               assign
      195                 v-task-date = v-task-date + 7 + tt-weekday.weekday - weekday( v-task-date + 7 ) + 1
      196               .
      197             end.
      198           end.
      199           if v-task-date < v-today then do:
      200             next block_sch.
      201           end.
      202         end.
      203         else do:
      204           if trim( buf_schedule.task-year ) <> "*":U then do:
      205             assign
      206               v-task-date = date( month( v-task-date )
      207                                   ,day( v-task-date )
      208                                   ,integer( buf_schedule.task-year )
      209                                 )
      210             .
      211             if v-task-date < v-today then do:
      212               next block_sch.
      213             end.
      214           end.
      215           if trim( buf_schedule.task-month ) <> "*":U then do:
      216             assign
      217               v-task-date = date( integer( buf_schedule.task-month )
      218                                   ,day( v-task-date )
      219                                   ,year( v-task-date )
      220                                 )
      221             .
      222             if v-task-date < v-today then do:
      223               run next-task-year ( input recid( buf_schedule )
      224                                   ,input-output v-task-date
      225                                 ) no-error.
      226               if error-status :error then do:
      227                 next block_sch.
      228               end.
      229             end.
      230           end.
      231           if trim( buf_schedule.task-day ) <> "*":U then do:
      232             run lastdate in this-procedure
      233               (input  v-task-date
      234               ,output v-last-date
      235               ) no-error .
      236             if error-status :error then do:
      237               next block_sch.
      238             end.
      239             if integer( buf_schedule.task-day ) > day( v-last-date ) then do:
      240               next block_sch.
      241             end.
      242             assign
      243               v-task-date = date( month( v-task-date )
      244                                  ,integer( buf_schedule.task-day )
      245                                  ,year( v-task-date )
      246                                 )
      247             .
      248             if v-task-date < v-today then do:
      249               run next-task-month in this-procedure
      250                 ( input recid( buf_schedule )
      251                  ,input-output v-task-date
      252                 ) no-error.
      253               if error-status :error then do:
      254                 next block_sch.
      255               end.
      256             end.
      257           end.
      258         end.
      259         if trim( buf_schedule.task-hour ) <> "*":U then do:
      260           for each tt-hour
      261           on error undo, return error return-value
      262           :
      263             delete tt-hour.
      264           end.
      265           run gbl/prcs-lst.p
      266             ( input  buf_schedule.task-hour
      267              ,input  0
      268              ,input  24
      269              ,input  false
      270              ,input (buffer tt-hour:handle)
      271              ,input "hour":U
      272             ) no-error .
      273           for first tt-hour no-lock
      274             by tt-hour.hour
      275           on error undo, return error return-value
      276           :
      277             assign
      278               v-first-hour = tt-hour.hour
      279             .
      280           end.
      281           if v-task-date > v-today then do:
      282             assign
      283               v-task-time = v-task-time + ( v-first-hour - v-curr-hour ) * 3600
      284             .
      285           end.
      286           else do:
      287             if v-task-date = v-today then do:
      288               assign
      289                 v-task-time-h = v-task-time
      290                 v-set-task    = false
      291               .
      292               block_hour:
      293               for each tt-hour no-lock
      294                 by tt-hour.hour
      295               on error undo, return error return-value
      296               :
      297                 assign
      298                   v-task-time-h = v-task-time + ( tt-hour.hour - v-curr-hour ) * 3600
      299                 .
      300                 if v-task-time-h >= v-curr-time then do:
      301                   assign
      302                     v-task-time = v-task-time-h
      303                     v-set-task  = true
      304                   .
      305                   leave block_hour.
      306                 end.
      307               end.
      308               if v-task-time < v-curr-time
      309                 or v-set-task = false
      310               then do:
      311                 assign
      312                   v-task-time = v-task-time + ( v-first-hour - v-curr-hour ) * 3600
      313                 .
      314                 run next-task-day ( input recid( buf_schedule )
      315                                    ,input-output v-task-date
      316                                   ) no-error.
      317                 if error-status :error then do:
      318                   next block_sch.
      319                 end.
      320               end.
      321             end.
      322           end.
      323         end.
      324         else do:
      325           if v-task-date > v-today then do:
      326             assign
      327               v-task-time = v-task-time + ( 0 - v-curr-hour ) * 3600
      328             .
      329           end.
      330         end.
      331         if trim( buf_schedule.task-minute ) <> "*":U then do:
      332           for each tt-minute
      333           on error undo, return error return-value
      334           :
      335             delete tt-minute.
      336           end.
      337           run gbl/prcs-lst.p
      338             ( input buf_schedule.task-minute
      339              ,input 0
      340              ,input 60
      341              ,input false
      342              ,input (buffer tt-minute:handle)
      343              ,input "minute":U
      344             ) no-error .
      345           for first tt-minute no-lock
      346             by tt-minute.minute
      347           on error undo, return error return-value
      348           :
      349             assign
      350               v-first-minute = tt-minute.minute
      351             .
      352           end.
      353           if v-task-date > v-today then do:
      354             assign
      355               v-task-time = v-task-time + ( v-first-minute - v-curr-minute ) * 60
      356             .
      357           end.
      358           else do:
      359             if v-task-date = v-today then do:
      360               assign
      361                 v-task-time-m = v-task-time
      362                 v-set-task    = false
      363               .
      364               block_minute:
      365               for each tt-minute no-lock
      366                 by tt-minute.minute
      367               on error undo, return error return-value
      368               :
      369                 assign
      370                   v-task-time-m = v-task-time + ( tt-minute.minute - v-curr-minute ) * 60
      371                 .
      372                 if v-task-time-m >= v-curr-time then do:
      373                   assign
      374                     v-task-time = v-task-time-m
      375                     v-set-task  = true
      376                   .
      377                   leave block_minute.
      378                 end.
      379               end.
      380               if v-task-time < v-curr-time
      381                 or v-set-task = false
      382               then do:
      383                 assign
      384                   v-task-time = v-task-time + ( v-first-minute - v-curr-minute ) * 60
      385                 .
      386                 run next-task-hour ( input recid( buf_schedule )
      387                                     ,input-output v-task-date
      388                                     ,input-output v-task-time
      389                                   ) no-error.
      390                 if error-status :error then do:
      391                   next block_sch.
      392                 end.
      393               end.
      394             end.
      395           end.
      396         end.
      397         else do:
      398           assign
      399             v-task-time-h = integer( entry( 1, string( v-task-time, "HH:MM:SS":U ), ":":U ) )
      400           .
      401           if v-task-date > v-today
      402             or ( v-task-date = v-today
      403                  and v-task-time-h > v-curr-hour
      404                )
      405           then do:
      406             assign
      407               v-task-time = v-task-time + ( 0 - v-curr-minute ) * 60
      408             .
      409           end.
      410         end.
      411         if trim( buf_schedule.task-second ) <> "*":U then do:
      412           assign
      413             v-task-time = v-task-time - v-curr-sec + integer( buf_schedule.task-second )
      414           .
      415           if v-task-date = v-today
      416             and v-task-time + 10 <= v-curr-time
      417           then do:
      418             run next-task-minute ( input recid( buf_schedule )
      419                                   ,input-output v-task-date
      420                                   ,input-output v-task-time
      421                                  ) no-error.
      422             if error-status :error then do:
      423               next block_sch.
      424             end.
      425           end.
      426         end.
      427         if v-task-date = v-today
      428           and v-task-time <= v-curr-time
      429         then do:
      430           run next-task-minute ( input recid( buf_schedule )
      431                                 ,input-output v-task-date
      432                                 ,input-output v-task-time
      433                                 ) no-error.
      434           if error-status :error then do:
      435             next block_sch.
      436           end.
      437         end.
      438         if buf_schedule.db-num-char <> "*":U then do:
      439           for each tt-db
      440           on error undo, return error return-value
      441           :
      442             delete tt-db.
      443           end.
      444           run gbl/prcs-lst.p
      445             ( input buf_schedule.db-num-char
      446             ,input 0
      447             ,input 99999
      448             ,input false
      449             ,input (buffer tt-db:handle)
      450             ,input "db-num":U
      451             ) no-error .
      452         end.
      453         for each buf_db no-lock
      454         on error undo, return error return-value
      455         :
      456           assign
      457             v-create-task = true
      458           .
      459           if buf_schedule.db-num-char <> "*":U then do:
      460             find first tt-db no-lock
      461               where tt-db.db-num = buf_db.db-num
      462               no-error .
      463             if not available tt-db then do:
      464               assign
      465                 v-create-task = false
      466               .
      467             end.
      468           end.
      469           if v-create-task = true then do:
      470             create curr-task .
      471             assign
      472               curr-task.db-num      = string( buf_db.db-num )
      473               curr-task.db-num-char = buf_schedule.db-num-char
      474               curr-task.task-num    = buf_schedule.task-num
      475               curr-task.task-type   = buf_schedule.task-type
      476               curr-task.cre-db-num    = buf_schedule.cre-db-num
      477               curr-task.task-date   = v-task-date
      478               curr-task.task-time   = v-task-time
      479             .
      480           end.
      481         end.
      482       end.
      483       for each tt-weekday
      484       on error undo, return error return-value
      485       :
      486         delete tt-weekday.
      487       end.
      488       for each tt-hour
      489       on error undo, return error return-value
      490       :
      491         delete tt-hour.
      492       end.
      493       for each tt-minute
      494       on error undo, return error return-value
      495       :
      496         delete tt-minute.
      497       end.
      498       for each tt-db
      499       on error undo, return error return-value
      500       :
      501         delete tt-db.
      502       end.
      503     end.
      504   end procedure.
      505   procedure next-task-year :
      506     define input        parameter p-recid-sch as recid no-undo .
      507     define input-output parameter p-task-date as date no-undo.
      508     do
      509     on error undo, return error
      510     :
      511       define buffer buf_schedule for ub.schedule .
      512       find first buf_schedule no-lock
      513         where recid( buf_schedule ) = p-recid-sch
      514       .
      515       if trim( buf_schedule.task-year ) <> "*":U then do:
      516         assign
      517           p-task-date = ?
      518         .
      519         return error.
      520       end.
      521       else do:
      522         if month( p-task-date ) = 2
      523           and day( p-task-date ) = 29
      524         then do:
      525           if trim( buf_schedule.task-day ) <> "*":U then do:
      526             assign
      527               p-task-date = date( month( p-task-date )
      528                                   ,day( p-task-date )
      529                                   ,year( p-task-date ) + 4
      530                                 )
      531             .
      532           end.
      533           else do:
      534             assign
      535               p-task-date = date( month( p-task-date )
      536                                   ,28
      537                                   ,year( p-task-date ) + 1
      538                                 )
      539             .
      540           end.
      541         end.
      542         else do:
      543           assign
      544             p-task-date = date( month( p-task-date )
      545                                 ,day( p-task-date )
      546                                 ,year( p-task-date ) + 1
      547                               )
      548           .
      549         end.
      550       end.
      551     end.
      552   end procedure.
      553   procedure next-task-month :
      554     define input        parameter p-recid-sch as recid no-undo .
      555     define input-output parameter p-task-date as date no-undo.
      556     do
      557     on error undo, return error
      558     :
      559       define variable v-date      as date no-undo .
      560       define variable v-last-date as date no-undo .
      561       define buffer buf_schedule for ub.schedule .
      562       find first buf_schedule no-lock
      563         where recid( buf_schedule ) = p-recid-sch
      564       .
      565       if trim( buf_schedule.task-month ) <> "*":U then do:
      566         run next-task-year ( input p-recid-sch
      567                             ,input-output p-task-date
      568                            ) no-error.
      569         if error-status :error then do:
      570           assign
      571             p-task-date = ?
      572           .
      573           return error.
      574         end.
      575       end.
      576       else do:
      577         if month( p-task-date ) = 12 then do:
      578           assign
      579             p-task-date = date( 1
      580                                ,day( p-task-date )
      581                                ,year( p-task-date )
      582                                )
      583           .
      584           run next-task-year ( input p-recid-sch
      585                               ,input-output p-task-date
      586                             ) no-error.
      587           if error-status :error then do:
      588             assign
      589               p-task-date = ?
      590             .
      591             return error.
      592           end.
      593         end.
      594         else do:
      595           assign
      596             v-date = date( month( p-task-date ) + 1
      597                           ,1
      598                           ,year( p-task-date )
      599                          )
      600           .
      601           run lastdate in this-procedure
      602             ( input  v-date
      603              ,output v-last-date
      604             ) no-error .
      605           if error-status :error then do:
      606             assign
      607               p-task-date = ?
      608             .
      609             return error.
      610           end.
      611           if day( p-task-date ) > day( v-last-date ) then do:
      612             if trim( buf_schedule.task-day ) <> "*":U then do:
      613               do while true :
      614                 assign
      615                   v-date = date( month( v-date ) + 1
      616                                 ,1
      617                                 ,year( v-date )
      618                               )
      619                 .
      620                 run lastdate in this-procedure
      621                   ( input  v-date
      622                    ,output v-date
      623                   ) no-error .
      624                 if error-status :error then do:
      625                   assign
      626                     p-task-date = ?
      627                   .
      628                   return error.
      629                 end.
      630                 if day( p-task-date ) = day( v-date ) then do:
      631                   assign
      632                     p-task-date = v-date
      633                   .
      634                   leave.
      635                 end.
      636               end.
      637             end.
      638             else do:
      639               assign
      640                 p-task-date = v-last-date
      641               .
      642             end.
      643           end.
      644           else do:
      645             assign
      646               p-task-date = date( month( p-task-date ) + 1
      647                                  ,day( p-task-date )
      648                                  ,year( p-task-date )
      649                                 )
      650             .
      651           end.
      652         end.
      653       end.
      654     end.
      655   end procedure.
      656   procedure next-task-day :
      657     define input        parameter p-recid-sch as recid no-undo .
      658     define input-output parameter p-task-date as date no-undo.
      659     do
      660     on error undo, return error
      661     :
      662       define buffer buf_schedule for ub.schedule .
      663       find first buf_schedule no-lock
      664         where recid( buf_schedule ) = p-recid-sch
      665       .
      666       if trim( buf_schedule.task-weekday ) <> "*":U then do:
      667         find first tt-weekday no-lock
      668           where tt-weekday.weekday > weekday( p-task-date ) - 1
      669           no-error .
      670         if available tt-weekday then do:
      671           assign
      672             p-task-date = p-task-date + tt-weekday.weekday - weekday( p-task-date ) + 1
      673           .
      674         end.
      675         else do:
      676           for first tt-weekday no-lock
      677             by tt-weekday.weekday
      678           on error undo, return error return-value
      679           :
      680             assign
      681               p-task-date = p-task-date + 7 + tt-weekday.weekday - weekday( p-task-date + 7 ) + 1
      682             .
      683           end.
      684         end.
      685       end.
      686       else do:
      687         if trim( buf_schedule.task-day ) <> "*":U then do:
      688           run next-task-month ( input p-recid-sch
      689                               ,input-output p-task-date
      690                               ) no-error.
      691           if error-status :error then do:
      692             assign
      693               p-task-date = ?
      694             .
      695             return error.
      696           end.
      697         end.
      698         else do:
      699           if month( p-task-date ) <> month( p-task-date + 1 ) then do:
      700             assign
      701               p-task-date = date( month( p-task-date )
      702                                   ,1
      703                                   ,year( p-task-date )
      704                                 )
      705             .
      706             run next-task-month ( input p-recid-sch
      707                                 ,input-output p-task-date
      708                                 ) no-error.
      709             if error-status :error then do:
      710               assign
      711                 p-task-date = ?
      712               .
      713               return error.
      714             end.
      715           end.
      716           else do:
      717             assign
      718               p-task-date = p-task-date + 1
      719             .
      720           end.
      721         end.
      722       end.
      723     end.
      724   end procedure.
      725   procedure next-task-hour :
      726     define input        parameter p-recid-sch as recid   no-undo .
      727     define input-output parameter p-task-date as date    no-undo.
      728     define input-output parameter p-task-time as integer no-undo.
      729     do
      730     on error undo, return error
      731     :
      732       define buffer buf_schedule for ub.schedule .
      733       define variable v-task-hour as integer   no-undo .
      734       find first buf_schedule no-lock
      735         where recid( buf_schedule ) = p-recid-sch
      736       .
      737       if trim( buf_schedule.task-hour ) <> "*":U then do:
      738         assign
      739           v-task-hour = integer( entry( 1, string( p-task-time, "HH:MM:SS":U ), ":":U ) )
      740         .
      741         find first tt-hour no-lock
      742           where tt-hour.hour > v-task-hour
      743           no-error .
      744         if available tt-hour then do:
      745           assign
      746             p-task-time = p-task-time + ( tt-hour.hour - v-task-hour ) * 3600
      747           .
      748         end.
      749         else do:
      750           for first tt-hour no-lock
      751             by tt-hour.hour
      752           on error undo, return error return-value
      753           :
      754             assign
      755               p-task-time = p-task-time + ( tt-hour.hour - v-task-hour ) * 3600
      756             .
      757           end.
      758           run next-task-day ( input p-recid-sch
      759                             ,input-output p-task-date
      760                             ) no-error.
      761           if error-status :error then do:
      762             assign
      763               p-task-date = ?
      764               p-task-time = ?
      765             .
      766             return error.
      767           end.
      768         end.
      769       end.
      770       else do:
      771         if p-task-time + 3600 >= 86400 then do:
      772           run next-task-day ( input p-recid-sch
      773                              ,input-output p-task-date
      774                             ) no-error.
      775           if error-status :error then do:
      776             assign
      777               p-task-date = ?
      778               p-task-time = ?
      779             .
      780             return error.
      781           end.
      782           assign
      783             p-task-time = p-task-time + 3600 - 86400
      784           .
      785         end.
      786         else do:
      787           assign
      788             p-task-time = p-task-time + 3600
      789           .
      790         end.
      791       end.
      792     end.
      793   end procedure.
      794   procedure next-task-minute :
      795     define input        parameter p-recid-sch as recid   no-undo .
      796     define input-output parameter p-task-date as date    no-undo.
      797     define input-output parameter p-task-time as integer no-undo.
      798     do
      799     on error undo, return error
      800     :
      801       define buffer buf_schedule for ub.schedule .
      802       define variable v-task-minute as integer   no-undo .
      803       find first buf_schedule no-lock
      804         where recid( buf_schedule ) = p-recid-sch
      805       .
      806       if trim( buf_schedule.task-minute ) <> "*":U then do:
      807         assign
      808           v-task-minute = integer( entry( 2, string( p-task-time, "HH:MM:SS":U ), ":":U ) )
      809         .
      810         find first tt-minute no-lock
      811           where tt-minute.minute > v-task-minute
      812           no-error .
      813         if available tt-minute then do:
      814           assign
      815             p-task-time = p-task-time + ( tt-minute.minute - v-task-minute ) * 60
      816           .
      817         end.
      818         else do:
      819           for first tt-minute no-lock
      820             by tt-minute.minute
      821           on error undo, return error return-value
      822           :
      823             assign
      824               p-task-time = p-task-time + ( tt-minute.minute - v-task-minute ) * 60
      825             .
      826           end.
      827           run next-task-hour ( input p-recid-sch
      828                               ,input-output p-task-date
      829                               ,input-output p-task-time
      830                             ) no-error.
      831           if error-status :error then do:
      832             assign
      833               p-task-date = ?
      834               p-task-time = ?
      835             .
      836             return error.
      837           end.
      838         end.
      839       end.
      840       else do:
      841         if truncate( p-task-time / 3600, 0 ) <> truncate( ( p-task-time + 60 ) / 3600, 0 ) then do:
      842           run next-task-hour ( input p-recid-sch
      843                               ,input-output p-task-date
      844                               ,input-output p-task-time
      845                             ) no-error.
      846           if error-status :error then do:
      847             assign
      848               p-task-date = ?
      849               p-task-time = ?
      850             .
      851             return error.
      852           end.
      853           assign
      854             p-task-time = p-task-time + 60 - 3600
      855           .
      856         end.
      857         else do:
      858           assign
      859             p-task-time = p-task-time + 60
      860           .
      861         end.
      862       end.
      863     end.
      864   end procedure.
      865   procedure proc-alt-shift-f2:
      866     if not ibs.th.gbl.gbl-var:rcode
      867   then
      868     run gbl\inidebug.p .
      869   end.
      870   procedure proc-alt-shift-f3:
