      899     run proc-alt-shift-f2.
      900   end.
      901   on alt-shift-f3 anywhere do:
      902     run proc-alt-shift-f3 in this-procedure .
      903   end.
      904   on alt-shift-f4 anywhere do:
      905     run proc-alt-shift-f4 in this-procedure.
      906   end.
      907   on alt-f1 anywhere do:
      908     run proc-alt-f1 in this-procedure .
      909   end.
      910   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      911   define temp-table temp-schedule-free no-undo
      912   field free-id as character
      913   field free-task-name as character
      914   field proc-run-name as character
      915   field proc-param-edit-name as character
      916   field conf-param as character
      917   field is-gbd as logical
      918   field is-ubd as logical
      919   field enable-concurrent-0 as logical
      920   field enable-concurrent-db as logical
      921   field other-info as character
      922   field enc-key as character
      923   field is-rum as logical
      924   index pi is unique primary
      925   free-id.
      926   procedure schedule-attr-name :
      927   do
      928     on error undo, return error
      929     :
      930     define input  parameter p-code           as character no-undo .
      931     define output parameter p-type           as character no-undo .
      932     define output parameter p-format         as character no-undo .
      933     define output parameter p-label          as character no-undo .
      934     define output parameter p-user-can-edit  as logical   no-undo .
      935     define output parameter p-output-display as logical   no-undo .
      936     define output parameter p-other          as character no-undo .
      937       if index(p-code, chr(4)) > 0 then do:
      938         p-code = entry(1, p-code, chr(4)).
      939       end.
      940       case p-code :
      941               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      942               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      943               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      944               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      945               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      946               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      947               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      948               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      949               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      950         otherwise do:
      951           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      952         end.
      953       end.
      954     end.
      955   end procedure.
      956   procedure schedule-attr-tooltip :
      957   do
      958     on error undo, return error
      959     :
      960       define input  parameter p-code    as character no-undo .
      961       define output parameter p-tooltip as character no-undo .
      962       define output parameter p-label   as character no-undo .
      963       if index(p-code, chr(4)) > 0 then do:
      964         p-code = entry(1, p-code, chr(4)).
      965       end.
      966       case p-code :
      967               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      968               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      969               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      970               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      971               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      972               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      973               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      974               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      975               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      976         otherwise do:
      977               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      978         end.
      979       end.
      980     end.
      981   end procedure.
      982   procedure schedule-attr-value :
      983   do
      984   on error undo, return error return-value
      985   :
      986   define input parameter  p-cre-db-num as integer    no-undo.
      987   define input parameter  p-task-type  as character  no-undo.
      988   define input parameter  p-task-num   as integer    no-undo.
      989   define input parameter  p-code       as character  no-undo.
      990   define output parameter p-value      as character  no-undo.
      991   define output parameter p-type       as character  no-undo.
      992       define variable v-format         as character no-undo .
      993       define variable v-label          as character no-undo .
      994       define variable v-user-can-edit  as logical   no-undo .
      995       define variable v-output-display as logical   no-undo .
      996       define variable v-other          as character no-undo .
      997       define buffer buf_schedule-attr for ub.schedule-attr.
      998       run schedule-attr-name in this-procedure (
      999             input  p-code
     1000           , output p-type
     1001           , output v-format
     1002           , output v-label
     1003           , output v-user-can-edit
     1004           , output v-output-display
     1005           , output v-other
     1006       ) no-error .
     1007       if error-status :error
     1008       then do:
     1009           undo, return error return-value .
     1010       end.
     1011       if p-code begins ('schd-free-id':U + chr(4))
     1012       and entry(2, p-code, chr(4)) = '':U then do:
     1013         find first buf_schedule-attr no-lock
     1014             where buf_schedule-attr.cre-db-num = p-cre-db-num
     1015               and buf_schedule-attr.task-type  = p-task-type
     1016               and buf_schedule-attr.task-num   = p-task-num
     1017               and buf_schedule-attr.attr-code  begins p-code
     1018         no-error .
     1019       end.
     1020       else do:
     1021         find first buf_schedule-attr no-lock
     1022             where buf_schedule-attr.cre-db-num = p-cre-db-num
     1023               and buf_schedule-attr.task-type  = p-task-type
     1024               and buf_schedule-attr.task-num   = p-task-num
     1025               and buf_schedule-attr.attr-code  = p-code
     1026         no-error .
     1027       end.
     1028       if available buf_schedule-attr
     1029       then do:
     1030           assign
     1031               p-value = buf_schedule-attr.attr-value
     1032           .
     1033       end.
     1034       else do:
     1035         if p-code begins ('schd-free-id':U + chr(4) ) then do:
     1036            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
     1037         end.
     1038         else do:
     1039           assign
     1040               p-value = if p-type = 'L':U then "no":U else ""
     1041           .
     1042         end.
     1043       end.
     1044   end.
     1045   end procedure.
     1046   procedure schedule-attr-write :
     1047   do
     1048   on error undo, return error
     1049   :
     1050   define input parameter p-cre-db-num  as integer   no-undo.
     1051   define input parameter p-task-type   as character no-undo.
     1052   define input parameter p-task-num    as integer   no-undo.
     1053   define input parameter p-code        as character no-undo.
     1054   define input parameter p-value       as character no-undo.
     1055       define variable v-type              as character                no-undo.
     1056       define variable v-format            as character                no-undo.
     1057       define variable v-label             as character                no-undo.
     1058       define variable v-user-can-edit     as logical                  no-undo.
     1059       define variable v-output-display    as logical                  no-undo.
     1060       define variable v-other             as character                no-undo.
     1061       define buffer buf_schedule-attr for ub.schedule-attr .
     1062       run schedule-attr-name in this-procedure (
     1063             input  p-code
     1064           , output v-type
     1065           , output v-format
     1066           , output v-label
     1067           , output v-user-can-edit
     1068           , output v-output-display
     1069           , output v-other
     1070       ) no-error.
     1071       if error-status :error
     1072       then do:
     1073           undo, return error return-value.
     1074       end.
     1075       find first buf_schedule-attr exclusive-lock
     1076            where buf_schedule-attr.cre-db-num = p-cre-db-num
     1077              and buf_schedule-attr.task-type  = p-task-type
     1078              and buf_schedule-attr.task-num   = p-task-num
     1079              and buf_schedule-attr.attr-code  = p-code
     1080       no-error.
     1081       if not available buf_schedule-attr
     1082       then do:
     1083           create buf_schedule-attr.
     1084           assign
     1085             buf_schedule-attr.cre-db-num = p-cre-db-num
     1086             buf_schedule-attr.task-type  = p-task-type
     1087             buf_schedule-attr.task-num   = p-task-num
     1088             buf_schedule-attr.attr-code  = p-code
     1089             buf_schedule-attr.attr-value = p-value
     1090           .
     1091       end.
     1092       else do:
     1093           assign
     1094               buf_schedule-attr.attr-value = p-value
     1095           .
     1096       end.
     1097   end.
     1098   end procedure.
     1099   procedure schedule-attr-delete :
     1100   do
     1101   on error undo, return error
     1102   :
     1103   define input  parameter p-cre-db-num  as integer   no-undo.
     1104   define input  parameter p-task-type   as character no-undo.
     1105   define input  parameter p-task-num    as integer   no-undo.
     1106   define input  parameter p-code        as character no-undo.
     1107   define output parameter p-deleted     as logical   no-undo.
     1108       define buffer buf_schedule-attr for ub.schedule-attr .
     1109       define variable v-type              as character                no-undo.
     1110       define variable v-format            as character                no-undo.
     1111       define variable v-label             as character                no-undo.
     1112       define variable v-user-can-edit     as logical                  no-undo.
     1113       define variable v-output-display    as logical                  no-undo.
     1114       define variable v-other             as character                no-undo.
     1115       run schedule-attr-name in this-procedure (
     1116             input p-code
     1117           , output v-type
     1118           , output v-format
     1119           , output v-label
     1120           , output v-user-can-edit
     1121           , output v-output-display
     1122           , output v-other
     1123       ) no-error .
     1124       if error-status :error
     1125       then do:
     1126           undo, return error return-value .
     1127       end.
     1128       find first buf_schedule-attr exclusive-lock
     1129            where buf_schedule-attr.cre-db-num = p-cre-db-num
     1130              and buf_schedule-attr.task-type  = p-task-type
     1131              and buf_schedule-attr.task-num   = p-task-num
     1132              and buf_schedule-attr.attr-code  = p-code
     1133       no-error.
     1134       if not available buf_schedule-attr
     1135       then do:
     1136           assign
     1137               p-deleted = no
     1138           .
     1139       end.
     1140       else do:
     1141           delete buf_schedule-attr.
     1142           assign
     1143               p-deleted = yes
     1144           .
     1145       end.
     1146   end.
     1147   end procedure.
     1148   procedure schedule-attr-news :
     1149   do
     1150   on error undo, return error
     1151   :
     1152       define input  parameter p-code           as character no-undo .
     1153       define output parameter p-news           as logical   no-undo .
     1154       if index(p-code, chr(4)) > 0 then do:
     1155         p-code = entry(1, p-code, chr(4)).
     1156       end.
     1157       case p-code :
     1158               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
     1159               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
     1160               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
     1161               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
     1162               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
     1163               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
     1164               when 'schedule-filter':U then do:     assign     p-news = false.   end.
     1165               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
     1166               when 'schd-free-id':U then do:     assign     p-news = false.   end.
     1167         otherwise do:
     1168           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
     1169         end.
     1170       end.
     1171   end.
     1172   end procedure.
     1173   procedure schedule-attr-extract-logical :
     1174   do
     1175   on error undo, return error
     1176   :
     1177   define input  parameter p-parameter-number   as integer      no-undo.
     1178   define input  parameter p-parameter-list     as character    no-undo.
     1179   define output parameter p-parameter-value   as logical      no-undo.
     1180       if num-entries( p-parameter-list ) > p-parameter-number - 1
     1181       then do:
     1182           assign
     1183               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
     1184           .
     1185       end.
     1186       else do:
     1187           assign
     1188               p-parameter-value   = no
     1189           .
     1190       end.
     1191   end.
     1192   end procedure.
     1193   procedure schedule-attr-get-free-id :
     1194   do
     1195   on error undo, return error return-value
     1196   :
     1197     define input  parameter p-cre-db-num  as integer   no-undo.
     1198     define input  parameter p-task-type   as character no-undo.
     1199     define input  parameter p-task-num    as integer   no-undo.
     1200     define output parameter p-free-id     as character no-undo.
     1201     define buffer buf_schedule-attr for ub.schedule-attr.
     1202     find first buf_schedule-attr no-lock
     1203         where buf_schedule-attr.cre-db-num = p-cre-db-num
     1204           and buf_schedule-attr.task-type  = p-task-type
     1205           and buf_schedule-attr.task-num   = p-task-num
     1206           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
     1207     no-error .
     1208     if available buf_schedule-attr then
     1209     assign
     1210     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
     1211     no-error
     1212     .
     1213   end.
     1214   end procedure.
     1215   procedure schedule-attr-get-free-props :
     1216     define input parameter p-free-id as character no-undo .
     1217     define output parameter p-value as character no-undo .
     1218     define buffer buf_temp-schedule-free for temp-schedule-free.
     1219     do
     1220     on error undo, return error return-value
     1221     :
     1222       find first buf_temp-schedule-free no-lock no-error .
     1223       if not available buf_temp-schedule-free then do:
     1224         run schedule-attr-fill-free-props in this-procedure .
     1225       end.
     1226       find first buf_temp-schedule-free where
     1227               buf_temp-schedule-free.free-id = p-free-id no-error.
     1228       if available buf_temp-schedule-free then do:
     1229         assign
     1230         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
     1231                   buf_temp-schedule-free.proc-run-name        + chr(4) +
     1232                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
     1233                   buf_temp-schedule-free.conf-param           + chr(4) +
     1234                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
     1235                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
     1236                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
     1237                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
     1238                   buf_temp-schedule-free.other-info
     1239         .
     1240       end.
     1241       else do:
     1242        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
     1243                              "id произвольной задачи - &5"
     1244                              ,vss-workfile
     1245                              ,vss-revision
     1246                              ,vss-description
     1247                              ,chr(10)
     1248                              ,p-free-id).
     1249       end.
     1250     end.
     1251   end procedure.
     1252   procedure schedule-attr-is-rum-free-id :
     1253   define input parameter p-free-id as character no-undo .
     1254   define output parameter p-is-rum as logical no-undo .
     1255   define buffer buf_temp-schedule-free for temp-schedule-free.
     1256   do
     1257   on error undo, return error
     1258   :
     1259       find first buf_temp-schedule-free no-lock no-error .
     1260       if not available buf_temp-schedule-free then do:
     1261         run schedule-attr-fill-free-props in this-procedure .
     1262       end.
     1263       find first buf_temp-schedule-free where
     1264               buf_temp-schedule-free.free-id = p-free-id no-error.
     1265       if available buf_temp-schedule-free
     1266       and buf_temp-schedule-free.is-rum
     1267       then do:
     1268         p-is-rum = yes.
     1269       end.
     1270   end.
     1271   end procedure.
     1272   procedure schedule-attr-fill-free-props :
     1273   define variable v-path                    as character                no-undo .
     1274   DEFINE VARIABLE v-full-path               as character                no-undo .
     1275   DEFINE VARIABLE v-file-name               as character                no-undo .
     1276   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
     1277   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
     1278   define buffer buf_temp-schedule-free for temp-schedule-free.
     1279   define variable v-answer as logical no-undo .
     1280     do
     1281     on error undo, return error substitute("&1 &2 &3&4&5&4"
     1282                                           ,vss-workfile
     1283                                           ,vss-revision
     1284                                           ,vss-description
     1285                                           ,chr(10)
     1286                                           ,error-status:get-message(1) )
     1287     :
     1288       run gbl/filename.p (
     1289                       input 'cmp/shd-free.d'
     1290                     ,output v-full-path
     1291                     ,output v-path
     1292                     ,output v-file-name
     1293                     ,output v-file-name-no-ext
     1294                     ,output v-file-name-ext
     1295                     ) .
     1296       input from value(v-full-path).
     1297       repeat :
     1298         create buf_temp-schedule-free.
     1299         import buf_temp-schedule-free.
     1300       END.
     1301       input close.
     1302       _ff:
     1303       for each buf_temp-schedule-free :
     1304         if buf_temp-schedule-free.free-id = '':U then do:
     1305            delete buf_temp-schedule-free.
     1306            next _ff.
     1307          end.
     1308          run schedule-attr-check-enc in this-procedure (
     1309                                                       input  buf_temp-schedule-free.free-id
     1310                                                      ,input  (buf_temp-schedule-free.proc-run-name +
     1311                                                               buf_temp-schedule-free.proc-param-edit-name +
     1312                                                               buf_temp-schedule-free.conf-param +
     1313                                                               string(buf_temp-schedule-free.is-gbd) +
     1314                                                               string(buf_temp-schedule-free.is-ubd) +
     1315                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
     1316                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
     1317                                                               string(buf_temp-schedule-free.other-info)
     1318                                                               )
     1319                                                       ,input  buf_temp-schedule-free.enc-key
     1320                                                       ,output v-answer    ) no-error .
     1321          if error-status:error
     1322          or not v-answer then delete buf_temp-schedule-free.
     1323        end.
     1324     end.
     1325   end procedure.
     1326   Function schedule-attr-reverse returns character (str as character).
     1327      define variable rev_incl_s as character init "" no-undo .
     1328      define variable rev_incl_i as integer no-undo .
     1329      define variable rev_incl_l as integer no-undo .
     1330      rev_incl_l = length(str).
     1331      do rev_incl_i = 1 to rev_incl_l:
     1332         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
     1333      end.
     1334      return rev_incl_s.
     1335   end.
     1336   procedure schedule-attr-check-enc.
     1337     define input  parameter p-free-id   as character no-undo .
     1338     define input  parameter p-value     as character no-undo .
     1339     define input  parameter p-enc-value as character no-undo .
     1340     define output parameter p-answer    as logical   no-undo .
     1341     define variable tmp         as character no-undo .
     1342     define variable v-enc-value as character no-undo .
     1343     assign
     1344     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
     1345     .
     1346     run schedule-attr-pswd-enc in this-procedure
     1347       ( input tmp
     1348        ,output v-enc-value
     1349       ) no-error .
     1350     if error-status:error then do:
     1351       message
     1352         vss-workfile vss-revision vss-description skip
     1353         "Ошибка при вызове процедуры pswd-enc" skip
     1354         return-value skip
     1355         error-status :get-message(1) skip
     1356         view-as alert-box error .
     1357       undo, return error .
     1358     end.
     1359     if v-enc-value = p-enc-value then do:
     1360       assign
     1361         p-answer = true
     1362       .
     1363     end.
     1364     else do:
     1365       assign
     1366         p-answer = false
     1367       .
     1368     end.
     1369   end.
     1370   procedure schedule-attr-conf-enc.
     1371     define input  parameter p-free-id   as character no-undo .
     1372     define input  parameter p-value     as character no-undo .
     1373     define output parameter p-enc-value as character no-undo .
     1374     define variable tmp         as character no-undo .
     1375     assign
     1376       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
     1377     .
     1378     run schedule-attr-pswd-enc in this-procedure
     1379       ( input tmp
     1380        ,output p-enc-value
     1381       ) no-error .
     1382     if error-status:error then do:
     1383       message
     1384         vss-workfile vss-revision vss-description skip
     1385         "Ошибка при вызове процедуры pswd-enc" skip
     1386         return-value skip
     1387         error-status :get-message(1) skip
     1388         view-as alert-box error .
     1389       undo, return error .
     1390     end.
     1391   end procedure.
     1392   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1393   procedure schedule-attr-pswd-enc :
     1394     define input parameter  pswd     as character no-undo .
     1395     define output parameter enc-pswd as character no-undo .
     1396     do
     1397     on error undo, return error return-value
     1398     :
     1399       assign
     1400         enc-pswd = encode(pswd + string(index(pswd, "k")))
     1401       .
     1402     end.
     1403   end procedure.
     1404   define buffer buf_schedule for ub.schedule .
     1405   define buffer buf_sys-ctrl for ub.sys-ctrl .
     1406   define variable v-btpr-type   as character no-undo .
     1407   define variable v-par-val     as character no-undo .
     1408   define variable v-par-type    as character no-undo .
     1409   define variable v-log         as logical   no-undo .
     1410   define variable v-modify-task as character no-undo .
     1411   define variable v-modify-btpr as character no-undo .
     1412   define variable v-PS          as character no-undo .
     1413   define variable v-curr-db     as integer   no-undo .
     1414   FUNCTION get-free-task-name RETURNS CHARACTER
     1415     ( input p-cre-db-num as integer, INPUT p-task-type AS character, INPUT p-task-num AS integer )  FORWARD.
     1416   DEFINE BUTTON b-add DEFAULT
     1417        LABEL "&Добавить"
     1418        SIZE 10 BY 1
     1419        BGCOLOR 8 .
     1420   DEFINE BUTTON b-chg DEFAULT
     1421        LABEL "&Изменить"
     1422        SIZE 10 BY 1
     1423        BGCOLOR 8 .
     1424   DEFINE BUTTON b-copy DEFAULT
     1425        LABEL "Копи&я"
     1426        SIZE 10 BY 1
     1427        BGCOLOR 8 .
     1428   DEFINE BUTTON b-del DEFAULT
     1429        LABEL "&Удалить"
     1430        SIZE 10 BY 1
     1431        BGCOLOR 8 .
     1432   DEFINE BUTTON b-help
     1433        LABEL "Помо&щь"
     1434        SIZE 10 BY 1
     1435        BGCOLOR 8 .
     1436   DEFINE BUTTON b-quit AUTO-END-KEY DEFAULT
     1437        LABEL "&Выход"
     1438        SIZE 10 BY 1
     1439        BGCOLOR 8 .
     1440   DEFINE BUTTON bt-param
     1441        LABEL "&Параметры"
     1442        SIZE 10 BY 1.
     1443   DEFINE VARIABLE v-cre-db-num AS INTEGER FORMAT "->>>>9":U INITIAL 0
     1444        LABEL "Расписание для БД"
     1445        VIEW-AS COMBO-BOX INNER-LINES 10
     1446        LIST-ITEMS "0"
     1447        DROP-DOWN-LIST
     1448        SIZE 9.5 BY 1 NO-UNDO.
     1449   DEFINE VARIABLE v-task-type AS CHARACTER FORMAT "X(256)":U
     1450        VIEW-AS COMBO-BOX INNER-LINES 12
     1451        DROP-DOWN-LIST
     1452        SIZE 40.3 BY 1 NO-UNDO.
     1453   DEFINE QUERY br-schedule FOR
     1454         buf_schedule SCROLLING.
     1455   DEFINE BROWSE br-schedule
     1456     QUERY br-schedule DISPLAY
     1457         buf_schedule.active format "+/-"
     1458   buf_schedule.db-num-char format "x(255)"
     1459   buf_schedule.task-year
     1460   buf_schedule.task-month format "x(2)"
     1461   buf_schedule.task-day column-label "Число"
     1462   buf_schedule.task-weekday column-label "Дни недели" format "x(13)"
     1463   buf_schedule.task-hour column-label "Часы" format "x(72)"
     1464   buf_schedule.task-minute column-label "Минуты" format "x(183)"
     1465   buf_schedule.task-num column-label "N задачи" format ">>>>>>>>>9"
     1466   get-free-task-name(buf_schedule.cre-db-num, buf_schedule.task-type, buf_schedule.task-num) @ v-ps column-label "Примечание" format "x(40)"
     1467       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.43.
     1468   DEFINE FRAME Dialog-Frame
     1469        b-quit AT ROW 1 COL 1
     1470        b-add AT ROW 1 COL 11
     1471        b-chg AT ROW 1 COL 21
     1472        b-copy AT ROW 1 COL 31
     1473        b-del AT ROW 1 COL 41
     1474        bt-param AT ROW 1 COL 51
     1475        b-help AT ROW 1 COL 71
     1476        v-cre-db-num AT ROW 2.5 COL 2.5
     1477        v-task-type AT ROW 2.5 COL 32.5 NO-LABEL
     1478        br-schedule AT ROW 3.8 COL 1
     1479        SPACE(0.00) SKIP(0.26)
     1480       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1481            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1482            TITLE "Расписание"
     1483            CANCEL-BUTTON b-quit.
     1484   ASSIGN
     1485          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1486          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1487   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1488   DO:
     1489     APPLY "END-ERROR":U TO SELF.
     1490   END.
     1491   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     1492   DO:
     1493     define variable v-recid as recid   no-undo.
     1494     define variable v-mod   as logical no-undo .
     1495     define buffer buf-check_db for ub.db .
     1496     find first buf-check_db share-lock
     1497       where buf-check_db.db-num = v-cre-db-num
     1498       .
     1499     if v-cre-db-num = v-curr-db
     1500       or ( v-cre-db-num <> v-curr-db
     1501            and v-curr-db = 0
     1502            and ( buf-check_db.db-key = "":U
     1503                  or buf-check_db.db-key = ?
     1504                )
     1505          )
     1506     then do:
     1507       assign
     1508         v-recid = ?
     1509       .
     1510       run adm/sch-edit.w
     1511         ( input parparentproc
     1512         ,input 'ДОБАВЛЕНИЕ':U
     1513         ,input v-cre-db-num
     1514         ,input v-btpr-type
     1515         ,input-output v-recid
     1516         ,output v-mod
     1517         ) no-error.
     1518       if error-status :error then do:
     1519         message vss-workfile vss-revision vss-description skip
     1520           "Не удалось создать строку расписания!"
     1521           view-as alert-box error.
     1522         return no-apply.
     1523       end.
     1524       if v-mod = true then do:
     1525         if v-curr-db = v-cre-db-num then do:
     1526           run add-modify-task in this-procedure.
     1527         end.
     1528         OPEN QUERY br-schedule FOR EACH buf_schedule no-lock where buf_schedule.cre-db-num = v-cre-db-num AND buf_schedule.task-type = v-btpr-type .
     1529         reposition br-schedule to recid v-recid no-error.
     1530       end.
     1531       if v-btpr-type = 'is_PM':U
     1532       then do :
     1533         apply "choose" to bt-param IN FRAME Dialog-Frame .
     1534       end .
     1535     end.
     1536     else do:
     1537       message
     1538         substitute( "Новую строку расписания можно создавать только для текущей БД" ) skip
     1539         substitute( "или в ГБД для невыгруженной БД (т.е. БД у которой нет ключа)") skip
     1540         view-as alert-box error .
     1541     end.
     1542   END.
     1543   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     1544   DO:
     1545     define variable v-recid as recid   no-undo.
     1546     define variable v-mod   as logical no-undo .
     1547     if not available buf_schedule then do:
     1548       message vss-workfile vss-revision vss-description skip
     1549         "Не выбрана строка расписания!"
     1550         view-as alert-box error.
     1551       return no-apply.
     1552     end.
     1553     assign
     1554       v-recid = recid( buf_schedule )
     1555     .
     1556     run adm/sch-edit.w
     1557       ( input parparentproc
     1558        ,input 'ИЗМЕНЕНИЕ':U
     1559        ,input v-cre-db-num
     1560        ,input v-btpr-type
     1561        ,input-output v-recid
     1562        ,output v-mod
     1563       ) no-error.
     1564     if error-status :error then do:
     1565       message vss-workfile vss-revision vss-description skip
     1566         "Не удалось изменить строку расписания!"
     1567         view-as alert-box error.
     1568       return no-apply.
     1569     end.
     1570     if v-mod = true then do:
     1571       if v-curr-db = v-cre-db-num then do:
     1572         run add-modify-task in this-procedure.
     1573       end.
     1574       OPEN QUERY br-schedule FOR EACH buf_schedule no-lock where buf_schedule.cre-db-num = v-cre-db-num AND buf_schedule.task-type = v-btpr-type .
     1575       reposition br-schedule to recid v-recid no-error.
     1576     end.
     1577   END.
     1578   ON CHOOSE OF b-copy IN FRAME Dialog-Frame
     1579   DO:
     1580     define variable v-recid as recid   no-undo.
     1581     define variable v-mod   as logical no-undo .
     1582     if not available buf_schedule then do:
     1583       message vss-workfile vss-revision vss-description skip
     1584         "Не выбрана строка расписания!"
     1585         view-as alert-box error.
     1586       return no-apply.
     1587     end.
     1588     assign
     1589       v-recid = recid( buf_schedule )
     1590     .
     1591     run adm/sch-edit.w
     1592       ( input parparentproc
     1593        ,input 'КОПИРОВАНИЕ':U
     1594        ,input v-cre-db-num
     1595        ,input v-btpr-type
     1596        ,input-output v-recid
     1597        ,output v-mod
     1598       ) no-error.
     1599     if error-status :error then do:
     1600       message
     1601         vss-workfile vss-revision vss-description skip
     1602         substitute("Не удалось скопировать строку расписания!") skip
     1603         error-status :get-message(1) skip
     1604         return-value skip
     1605         view-as alert-box error .
     1606       undo, return no-apply.
     1607     end.
     1608     if v-mod = true then do:
     1609       if v-curr-db = v-cre-db-num then do:
     1610         run add-modify-task in this-procedure.
     1611       end.
     1612       OPEN QUERY br-schedule FOR EACH buf_schedule no-lock where buf_schedule.cre-db-num = v-cre-db-num AND buf_schedule.task-type = v-btpr-type .
     1613       reposition br-schedule to recid v-recid no-error.
     1614     end.
     1615   END.
     1616   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1617   DO:
     1618     define variable v-log as logical no-undo .
     1619     if not available buf_schedule then do:
     1620       message vss-workfile vss-revision vss-description skip
     1621         "Не выбрана строка расписания!"
     1622         view-as alert-box error.
     1623       return no-apply.
     1624     end.
     1625     assign
     1626       v-log = false
     1627     .
     1628     message "Вы действительно хотите удалить строку расписания?"
     1629       view-as alert-box question buttons yes-no update v-log.
     1630     if v-log = false
     1631     then do:
     1632       return no-apply.
     1633     end.
     1634     else do:
     1635       run adm/schedul3.p (  input parparentproc
     1636                            ,input recid( buf_schedule )
     1637                            ,input no
     1638                           ) no-error.
     1639       if error-status:error then do:
     1640         undo, return no-apply.
     1641       end.
     1642       if v-curr-db = v-cre-db-num then do:
     1643         run add-modify-task in this-procedure.
     1644       end.
     1645       OPEN QUERY br-schedule FOR EACH buf_schedule no-lock where buf_schedule.cre-db-num = v-cre-db-num AND buf_schedule.task-type = v-btpr-type .
     1646     end.
     1647   END.
     1648   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     1649   DO:
     1650     define variable v-ind           as integer   no-undo .
     1651     define variable v-num-entries   as integer   no-undo .
     1652     define variable v-loc-btpr-type as character no-undo .
     1653     define variable v-loc-btpr-task as character no-undo .
     1654     define variable v-not-change    as character no-undo .
     1655     if v-modify-btpr <> "":U then do:
     1656       message
     1657         "Были произведены изменения расписания для задач:" skip
     1658         v-modify-task skip
     1659         "Вы хотите переформировать время выполнения этих задач в соответствии с новым расписанием?"
     1660         view-as alert-box question buttons yes-no update v-log.
     1661       assign
     1662         v-not-change = "":U
     1663       .
     1664       if v-log = true then do:
     1665         assign
     1666           v-num-entries = num-entries( v-modify-btpr )
     1667         .
     1668         do v-ind = 1 to v-num-entries:
     1669           assign
     1670             v-loc-btpr-type = entry( v-ind, v-modify-btpr )
     1671             v-loc-btpr-task = entry( v-ind, v-modify-task )
     1672           .
     1673           run delete-btpr in this-procedure
     1674             ( input        v-loc-btpr-type
     1675              ,input        v-loc-btpr-task
     1676              ,input-output v-not-change
     1677             ) no-error.
     1678           if error-status :error then do:
     1679             message
     1680               "Ошибка при удалении времени очередного сеанса." skip
     1681               return-value skip
     1682               error-status :get-message(1)
     1683               view-as alert-box error .
     1684             return no-apply.
     1685           end.
     1686         end.
     1687         if v-not-change = "":U then do:
     1688           message
     1689             "Время очередного(ых) сеанса(ов) будет обновлено в течении минуты," skip
     1690             "если соответствующие сеансы активны."
     1691             view-as alert-box information.
     1692         end.
     1693         else do:
     1694           message
     1695             substitute( "Время сеансов &1 не изменено т.к. оно задано вручную", v-not-change ) skip
     1696             "Время остальных очередных сеансов будет обновлено в течении минуты," skip
     1697             "если соответствующие сеансы активны."
     1698             view-as alert-box information.
     1699         end.
     1700       end.
     1701     end.
     1702   END.
