     2795               v-object-handle :col = v-object-handle :col + p-change-value
     2796               no-error .
     2797             if error-status :error
     2798             or error-status :get-message(1) <> ""
     2799             then do:
     2800               undo move_block, retry move_block .
     2801             end.
     2802           end.
     2803         end.
     2804         for each buf_temp-browse-handle
     2805           where buf_temp-browse-handle.browse-type = 'width':u
     2806         on error undo move_block, retry move_block
     2807         :
     2808           assign
     2809             buf_temp-browse-handle.browse-handle :width
     2810               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2811             no-error .
     2812           if error-status :error
     2813           or error-status :get-message(1) <> ""
     2814           then do:
     2815             undo move_block, retry move_block .
     2816           end.
     2817         end.
     2818         assign
     2819           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2820           no-error .
     2821         if error-status :error
     2822         or error-status :get-message(1) <> ""
     2823         then do:
     2824           undo move_block, retry move_block.
     2825         end.
     2826         assign
     2827           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2828         no-error .
     2829         if error-status :error
     2830         or error-status :get-message(1) <> ""
     2831         then do:
     2832           undo move_block, retry move_block.
     2833         end.
     2834         if frame Dialog-Frame :scrollable = true
     2835         then do:
     2836           assign
     2837             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2838           no-error .
     2839           if error-status :error
     2840           or error-status :get-message(1) <> ""
     2841           then do:
     2842             undo move_block, retry move_block.
     2843           end.
     2844         end.
     2845       end.
     2846       if p-move-resize
     2847       then do:
     2848         run diasize_position-resize-button in this-procedure .
     2849       end.
     2850       if v-diasize-wndstore = true
     2851       then do:
     2852         if connected("ub") = true
     2853         then do:
     2854           define variable v-cntxt-db-num        as integer   no-undo .
     2855           define variable v-cntxt-userid        as character no-undo .
     2856           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2857                                             , OUTPUT v-cntxt-userid
     2858                                             ) .
     2859           run gbl/wndsizew.p
     2860             (input  v-cntxt-db-num
     2861             ,input  v-cntxt-userid
     2862             ,input  v-diasize-proc-name
     2863             ,input  'width':u
     2864             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2865             ) .
     2866         end.
     2867       end.
     2868     end.
     2869     assign
     2870       v-diasize-change-size = false
     2871     .
     2872   end procedure.
     2873   procedure diasize_set-width :
     2874     define input  parameter p-new-width  as decimal   no-undo .
     2875     define input  parameter p-move-resize as logical   no-undo .
     2876     do
     2877     on error undo, return error return-value
     2878     :
     2879       run diasize_change-width in this-procedure
     2880         (input  (p-new-width - frame Dialog-Frame :width)
     2881         ,input  p-move-resize
     2882         ) .
     2883     end.
     2884   end procedure.
     2885   procedure diasize_position-resize-button :
     2886     do with frame Dialog-Frame
     2887     :
     2888       hide v-diasize-resize-button .
     2889       assign
     2890         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2891                     - 1
     2892                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2893         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2894                     - 1
     2895                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2896       .
     2897       view v-diasize-resize-button .
     2898     end.
     2899   end procedure.
     2900   on alt-right anywhere
     2901   do:
     2902     run diasize_change-width in this-procedure
     2903       (input 1
     2904       ,input true
     2905       ) .
     2906     return no-apply .
     2907   end.
     2908   on alt-left anywhere
     2909   do:
     2910     run diasize_change-width in this-procedure
     2911       (input -1
     2912       ,input true
     2913       ) .
     2914     return no-apply .
     2915   end.
     2916   on alt-down anywhere
     2917   do:
     2918     run diasize_change-height in this-procedure
     2919       (input 1
     2920       ,input true
     2921       ) .
     2922     return no-apply .
     2923   end.
     2924   on alt-up anywhere
     2925   do:
     2926     run diasize_change-height in this-procedure
     2927       (input -1
     2928       ,input true
     2929       ) .
     2930     return no-apply .
     2931   end.
     2932   on alt-enter of frame Dialog-Frame
     2933   do:
     2934     run diasize_maximize in this-procedure
     2935       (input  ?
     2936       ).
     2937     return no-apply .
     2938   end.
     2939   procedure diasize_end-move :
     2940     do
     2941     on error undo, return error return-value
     2942     :
     2943       define variable v-row-delta as decimal   no-undo .
     2944       define variable v-col-delta as decimal   no-undo .
     2945       define variable v-new-row as decimal   no-undo .
     2946       define variable v-new-col as decimal   no-undo .
     2947       assign
     2948         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2949         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2950       .
     2951       assign
     2952         v-row-delta = v-new-row - frame Dialog-Frame :height
     2953         v-col-delta = v-new-col - frame Dialog-Frame :width
     2954       .
     2955       run diasize_change-height in this-procedure
     2956         (input v-row-delta
     2957         ,input true
     2958         ) .
     2959       run diasize_change-width in this-procedure
     2960         (input v-col-delta
     2961         ,input true
     2962         ) .
     2963     end.
     2964   end procedure.
     2965   procedure diasize_maximize :
     2966     define input  parameter p-action as logical   no-undo .
     2967     do
     2968     on error undo, return error return-value
     2969     :
     2970       if p-action = ?
     2971       then do:
     2972         if v-diasize-need-maximize = true
     2973         then do:
     2974           assign
     2975             p-action = true
     2976           .
     2977         end.
     2978         else do:
     2979           assign
     2980             p-action = false
     2981           .
     2982         end.
     2983       end.
     2984       if p-action = true
     2985       then do:
     2986         run diasize_change-height in this-procedure
     2987           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2988               - frame Dialog-Frame :height-chars
     2989           ,input true
     2990           ) .
     2991         run diasize_change-width in this-procedure
     2992           (input session :width-chars
     2993               - frame Dialog-Frame :width-chars
     2994           ,input true
     2995           ) .
     2996         assign
     2997           v-diasize-need-maximize = false
     2998         .
     2999       end.
     3000       else do:
     3001         run diasize_change-width in this-procedure
     3002           (input v-diasize-orig-frame-width
     3003               - frame Dialog-Frame :width-chars
     3004           ,input true
     3005           ) .
     3006         run diasize_change-height in this-procedure
     3007           (input v-diasize-orig-frame-height
     3008               - frame Dialog-Frame :height-chars
     3009           ,input true
     3010           ) .
     3011         assign
     3012           v-diasize-need-maximize = true
     3013         .
     3014       end.
     3015     end.
     3016   end procedure.
     3017   procedure diasize_restore-orig-size :
     3018     do
     3019     on error undo, return error return-value
     3020     :
     3021       assign
     3022         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3023         v-diasize-current-frame-height = frame Dialog-Frame :height
     3024       .
     3025       run diasize_set-height in this-procedure
     3026         (input  v-diasize-orig-frame-height
     3027         ,input  true
     3028         ) .
     3029       run diasize_set-width in this-procedure
     3030         (input  v-diasize-orig-frame-width
     3031         ,input  true
     3032         ) .
     3033     end.
     3034   end procedure.
     3035   procedure diasize_restore-current-size :
     3036     do
     3037     on error undo, return error return-value
     3038     :
     3039       run diasize_set-height in this-procedure
     3040         (input  v-diasize-current-frame-height
     3041         ,input  true
     3042         ) .
     3043       run diasize_set-width in this-procedure
     3044         (input  v-diasize-current-frame-width
     3045         ,input  true
     3046         ) .
     3047     end.
     3048   end procedure.
     3049   procedure diasize_set-browse-handle :
     3050     define input  parameter p-browse-handle as handle   no-undo .
     3051     define buffer buf_temp-browse-handle for temp-browse-handle .
     3052     do
     3053     on error undo, return error return-value
     3054     :
     3055       assign
     3056         v-diasize-browse-handle = p-browse-handle
     3057       .
     3058       for each buf_temp-browse-handle
     3059       on error undo, return error return-value
     3060       :
     3061         delete buf_temp-browse-handle .
     3062       end.
     3063     end.
