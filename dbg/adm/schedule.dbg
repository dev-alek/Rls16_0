     1804               input parparentproc
     1805             , input buf_schedule.cre-db-num
     1806             , input buf_schedule.task-type
     1807             , input buf_schedule.task-num
     1808             , output v-cancel
     1809         ) no-error.
     1810         if error-status :error
     1811         then do:
