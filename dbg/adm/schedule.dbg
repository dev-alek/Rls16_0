     3108           end triggers.
     3109         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3110         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3111         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3112         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3113         assign
     3114           v-diasize-wndmax = false
     3115         .
     3116         if connected("ub") = true
     3117         then do:
     3118           define variable v-cntxt-db-num        as integer   no-undo .
     3119           define variable v-cntxt-userid        as character no-undo .
     3120           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3121                                             , OUTPUT v-cntxt-userid
     3122                                             ) .
     3123           run gbl/wndpar_r.p
     3124             (input  v-cntxt-db-num
