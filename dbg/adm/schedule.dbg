     3070     on error undo, return error return-value
     3071     :
     3072       assign
     3073         v-diasize-browse-number = v-diasize-browse-number + 1
     3074       .
     3075       create buf_temp-browse-handle .
     3076       assign
     3077         buf_temp-browse-handle.browse-type   = p-browse-type
     3078         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3079         buf_temp-browse-handle.browse-handle = p-browse-handle
     3080       .
     3081     end.
