     2486   procedure diasize_set-height :
     2487     define input  parameter p-new-height  as decimal   no-undo .
     2488     define input  parameter p-move-resize as logical   no-undo .
     2489     do
     2490     on error undo, return error return-value
     2491     :
     2492       run diasize_change-height in this-procedure
     2493         (input  (p-new-height - frame Dialog-Frame :height)
     2494         ,input  p-move-resize
     2495         ) .
     2496     end.
     2497   end procedure.
     2498   procedure diasize_change-width :
     2499     define input  parameter p-change-value as decimal   no-undo .
     2500     define input  parameter p-move-resize  as logical   no-undo .
     2501     define variable v-field-group-handle   as handle    no-undo .
     2502     define variable v-object-handle        as handle    no-undo .
     2503     define variable v-frame-width          as decimal   no-undo .
     2504     define variable v-frame-virtual-width  as decimal   no-undo .
     2505     define variable v-browse-width         as decimal   no-undo .
     2506     define variable v-window-width         as decimal   no-undo .
     2507     define variable v-window-virtual-width as decimal   no-undo .
     2508     define variable v-change-sign          as integer   no-undo .
     2509     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2510     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2511     if p-change-value > 0
     2512     then do:
     2513       if frame Dialog-Frame :width + p-change-value >
     2514           session :width-chars
     2515       then do:
     2516         assign
     2517           p-change-value = session :width-chars - frame Dialog-Frame :width
     2518         .
     2519         if p-change-value <= 0
     2520         then do:
     2521           run diasize_position-resize-button in this-procedure .
     2522           return .
     2523         end.
     2524       end.
     2525     end.
     2526     if p-change-value < 0
     2527     then do:
     2528       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2529       then do:
     2530         assign
     2531           p-change-value = v-diasize-orig-frame-width
     2532                          - frame Dialog-Frame :width
     2533         .
     2534         if p-change-value >= 0
     2535         then do:
     2536           run diasize_position-resize-button in this-procedure .
     2537           return .
     2538         end.
     2539       end.
     2540     end.
     2541     if p-change-value >= 0
     2542     then do:
     2543       assign
     2544         v-change-sign = 1
     2545       .
     2546     end.
     2547     else do:
     2548       assign
     2549         v-change-sign = -1
     2550       .
     2551     end.
     2552     assign
     2553       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2554     .
     2555     if p-change-value = 0
     2556     then do:
     2557       run diasize_position-resize-button in this-procedure .
     2558       return .
     2559     end.
