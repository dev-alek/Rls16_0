     3130         end.
     3131         assign
     3132           v-diasize-wndstore = false
     3133         .
     3134         if connected("ub") = true
     3135         then do:
     3136           run gbl/wndpar_r.p
     3137             (input  v-cntxt-db-num
     3138             ,input  v-cntxt-userid
     3139             ,input  'wndstore':U
     3140             ,output v-diasize-wndstore
     3141             ,output v-default-value
     3142             ) .
     3143         end.
     3144         assign
     3145           v-diasize-proc-name = entry(1, program-name(2), '.')
     3146         .
     3147         if v-diasize-wndstore = true
     3148         then do:
     3149           assign
     3150             v-restore-saved = false
     3151           .
     3152           if connected("ub") = true
     3153           then do:
     3154             run gbl/wndsizer.p
     3155               (input  v-cntxt-db-num
     3156               ,input  v-cntxt-userid
     3157               ,input  v-diasize-proc-name
     3158               ,input  'height':u
     3159               ,output v-resize-value-str
     3160               ) .
     3161             if v-resize-value-str <> '':U
     3162             then do:
     3163               run diasize_change-height in this-procedure
     3164                 (input  integer(v-resize-value-str)
     3165                 ,input  true
     3166                 ) .
     3167               assign
     3168                 v-restore-saved = true
     3169               .
     3170             end.
     3171           end.
     3172           if connected("ub") = true
     3173           then do:
     3174             run gbl/wndsizer.p
     3175               (input  v-cntxt-db-num
     3176               ,input  v-cntxt-userid
     3177               ,input  v-diasize-proc-name
     3178               ,input  'width':u
     3179               ,output v-resize-value-str
     3180               ) .
     3181             if v-resize-value-str <> '':U
     3182             then do:
     3183               run diasize_change-width in this-procedure
     3184                 (input  integer(v-resize-value-str)
     3185                 ,input  true
     3186                 ) .
     3187               assign
     3188                 v-restore-saved = true
     3189               .
     3190             end.
     3191           end.
     3192           if v-restore-saved <> true
     3193           then do:
     3194             if v-diasize-wndmax = true
     3195             then do:
     3196               run diasize_maximize in this-procedure
     3197                 (input  true
     3198                 ) .
     3199             end.
     3200           end.
     3201         end.
     3202         else do:
     3203           if v-diasize-wndmax = true
     3204           then do:
     3205             run diasize_maximize in this-procedure
     3206               (input  true
     3207               ) .
     3208           end.
     3209         end.
     3210       end.
     3211     end.
     3212   end procedure.
     3213   procedure diasize_need-full-display :
     3214     define output parameter p-need-full-display as logical   no-undo .
     3215     do
     3216     on error undo, return error return-value
     3217     :
     3218       assign
     3219         p-need-full-display = v-diasize-need-full-display
     3220       .
     3221       assign
     3222         v-diasize-need-full-display = false
     3223       .
     3224     end.
     3225   end procedure.
     3226   procedure get-context :
     3227      define output parameter p-db-num as integer          no-undo.
     3228      define output parameter p-user-id as character        no-undo.
     3229      define variable v-login               as character    no-undo.
     3230      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3231      define buffer buf_user-login  for ub.user-login .
     3232      do
     3233      on error undo, return error
     3234      :
     3235            FIND FIRST buf_sys-ctrl no-lock.
     3236            ASSIGN
     3237               v-login = USERID("ub")
     3238               p-db-num = buf_sys-ctrl.db-num
     3239            .
     3240            FIND FIRST buf_user-login
     3241                 WHERE buf_user-login.db-num = p-db-num
     3242                   AND buf_user-login.user-login = v-login
     3243                 no-lock
     3244                 no-error
     3245                 .
     3246            IF AVAILABLE buf_user-login
     3247            THEN DO:
     3248               assign
     3249                  p-user-id = buf_user-login.user-id
     3250               .
     3251            END.
     3252      end.
     3253   end procedure.
     3254       run diasize_init in this-procedure .
     3255   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     3256   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     3257   MAIN-BLOCK:
     3258   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3259      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3260     define buffer buf_db for ub.db .
     3261     for each buf_db no-lock
     3262       where buf_db.db-num > 0
     3263     on error undo, return error return-value
     3264     :
     3265       v-cre-db-num:add-last( string( buf_db.db-num ) ).
     3266     end.
     3267     find first buf_sys-ctrl no-lock .
     3268     assign
     3269       v-curr-db    = buf_sys-ctrl.db-num
     3270       v-cre-db-num = v-curr-db
     3271       v-task-type:list-item-pairs = 'Обмен новостями':U + chr(44) + 'autonws':U + chr(44) +
     3272                                      'Расчет архивов':U + chr(44) + 'autoarh':U + chr(44) +
     3273                                      'Прием информации с касс':U + chr(44) + 'autogcd':U + chr(44) +
     3274                                      'Работа с документами продажи':U + chr(44) + 'autosale':U + chr(44) +
     3275                                      'Запуск отчетов':U + chr(44)  + 'autosuz':U + chr(44) +
     3276                                      'Эксп/имп в КЛИЕНТ-БАНК':U + chr(44)  + 'autocbnk':U + chr(44) +
     3277                                      'Произвольные задания':U + chr(44)  + 'autofree':U + chr(44) +
     3278                                      'Меркурий':U + chr(44)  + 'mercury':U + chr(44) +
     3279                                      'Мониторинг HDD':U + chr(44)  + 'hddtest':U + chr(44) +
     3280                                      'ИС МОТП':U + chr(44)  + 'is_motp':U + chr(44) +
     3281                                      'ИС Диадок':U + chr(44)  + 'is_diadoc':U + chr(44) +
     3282                                      'Президентский мониторинг':U + chr(44)  + 'is_PM':U
     3283       v-task-type   = 'autonws':U
     3284       v-btpr-type   = 'autonws':U
     3285       v-modify-task = "":U
     3286       v-modify-btpr = "":U
     3287       buf_schedule.db-num-char:resizable in browse br-schedule = yes
     3288       buf_schedule.db-num-char:width = 5
     3289       buf_schedule.task-weekday:resizable in browse br-schedule = yes
     3290       buf_schedule.task-weekday:width = 10
     3291       buf_schedule.task-hour:resizable in browse br-schedule = yes
     3292       buf_schedule.task-hour:width = 15
     3293       buf_schedule.task-minute:resizable in browse br-schedule = yes
     3294       buf_schedule.task-minute:width = 15
     3295       v-PS:resizable in browse br-schedule = yes
     3296       v-PS:width = 40
     3297     .
     3298   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3299     (input  'is-bge'
