        1   DEFINE TEMP-TABLE find_c-layout NO-UNDO LIKE ub.c-layout.
        2   DEFINE BUFFER X_c-layout FOR ub.c-layout.
        3   DEFINE BUFFER X_layout FOR ub.layout.
        4   define input parameter parparentproc as widget-handle no-undo .
        5   define input parameter bttns  as char   no-undo .
        6   define input parameter p-mode  as char   no-undo .
        7   define input parameter p-layout-id like ub.layout.layout-id no-undo .
        8   define input-output param p-rid-list    as  char no-undo .
        9   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       10   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       11   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       12   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       13   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
       14   define variable vss-description AS CHAR NO-UNDO INIT "Список истории раскладок":U.
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   define variable c-point  as character no-undo .
       77   define variable tbl      as character no-undo .
       78   define variable join-tbl as character no-undo .
       79   define variable fld      as character no-undo .
       80   define variable lab      as character no-undo .
       81   define variable spr      as character no-undo .
       82   define variable dim      as character no-undo .
       83   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       84   procedure fltfield-clear :
       85     define output parameter loc-fld as character no-undo.
       86     define output parameter loc-lab as character no-undo .
       87     define output parameter loc-spr as character no-undo .
       88     define output parameter loc-dim as character no-undo .
       89     assign
       90       loc-fld = ""
       91       loc-lab = ""
       92       loc-spr = ""
       93       loc-dim = "0"
       94     .
       95   end procedure .
       96   procedure fltfield-add :
       97     define input        parameter par-fld as character no-undo.
       98     define input        parameter par-lab as character no-undo .
       99     define input        parameter par-spr as character no-undo .
      100     define input-output parameter loc-fld as character no-undo.
      101     define input-output parameter loc-lab as character no-undo .
      102     define input-output parameter loc-spr as character no-undo .
      103     define input-output parameter loc-dim as character no-undo .
      104     do
      105     on error undo, return error
      106     :
      107       assign
      108       loc-fld = if loc-dim = '0'
      109                 then par-fld
      110                 else (loc-fld + chr(44) + par-fld)
      111       loc-lab = if loc-dim = '0'
      112                 then par-lab
      113                 else (loc-lab + chr(44) + par-lab)
      114       loc-spr = if loc-dim = '0'
      115                 then par-spr
      116                 else (loc-spr + chr(44) + par-spr)
      117       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      118                 string(integer(if num-entries(loc-dim) > 1
      119                               then entry(2, loc-dim)
      120                               else entry(1, loc-dim)
      121                               ) + 1)
      122       no-error
      123       .
      124     end.
      125   end procedure.
      126   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      127   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      128   define new shared variable RepPathName        as character no-undo .
      129   define new shared variable PrintRubl          as logical   no-undo .
      130   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      131   define  stream PrnLibStream.
      132   procedure prn-lib-prn-file :
      133     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      134     define input parameter p-DIsabledoptions as integer no-undo .
      135     define variable v-report-name as character no-undo .
      136     define variable v-user-action as character no-undo .
      137     define variable v-printed     as logical   no-undo .
      138     define variable v-exist       as logical   no-undo .
      139     do
      140       on error undo, return error
      141       :
      142       run prn-lib-get-report-name  in this-procedure (
      143         input parParentProc
      144         ,output v-report-name
      145         ).
      146   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      147   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      148     (input  v-report-name
      149     ,input  2
      150     ,output v-exist
      151     )  .
      152       if NOT v-exist then
      153       DO:
      154         Message
      155           "Нет заданий на печать ! "
      156           view-as alert-box .
      157         Return  .
      158       End.
      159       run gbl/prnfilen.w
      160         (input  ""
      161         ,input  p-DisabledOptions
      162         ,input  string(v-report-name )
      163         ,input  7
      164         ,output v-user-action
      165         ,output v-printed
      166         ) .
      167       if v-printed then
      168       do:
      169         return "YES" .
      170       end.
      171       else
      172       do:
      173         return "NO" .
      174       end.
      175     end.
      176   end procedure.
      177   procedure prn-lib-open-stream :
      178     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      179     define input parameter p-page-size    as integer no-undo .
      180     define input parameter p-is-stream    as logical no-undo .
      181     define input parameter p-append       as logical no-undo .
      182     define variable v-report-name as character no-undo .
      183     do
      184       on error undo, return error
      185       :
      186       run prn-lib-get-report-name  in this-procedure (
      187         input parParentProc
      188         ,output v-report-name
      189         ).
      190       if p-is-stream then
      191       do:
      192         if p-append then
      193         do:
      194           output stream PrnLibStream to value( v-report-name )
      195             page-size value(p-page-size) append .
      196         end.
      197         if not p-append then
      198         do:
      199           output stream PrnLibStream to value( v-report-name )
      200             page-size value(p-page-size) .
      201         end.
      202       end.
      203       if not p-is-stream then
      204       do:
      205         if p-append then
      206         do:
      207           output to value( v-report-name )
      208             page-size value(p-page-size) append .
      209         end.
      210         if not p-append then
      211         do:
      212           output to value( v-report-name )
      213             page-size value(p-page-size) .
      214         end.
      215       end.
      216     end.
      217   end procedure.
      218   procedure prn-lib-open-exp :
      219     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      220     define input parameter p-is-stream    as logical no-undo .
      221     define input parameter p-is-append    as logical no-undo .
      222     define output parameter p-ReportFileName as char init "report" no-undo.
      223     define output parameter p-process as logical no-undo .
      224     define variable glog as logical no-undo .
      225     do
      226       on error undo, return error
      227       :
      228       SYSTEM-DIALOG GET-FILE p-ReportFileName
      229         TITLE      "Укажите путь"
      230         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      231         ASK-OVERWRITE
      232         CREATE-TEST-FILE
      233         SAVE-AS
      234         USE-FILENAME
      235         DEFAULT-EXTENSION "txt"
      236         UPDATE glog
      237         .
      238       if not glog then  return.
      239       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      240       if p-is-stream then
      241       do:
      242         if p-is-append then
      243         do:
      244           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      245         end.
      246         else
      247         do:
      248           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      249         end.
      250       end.
      251       else
      252       do:
      253         if p-is-append then
      254         do:
      255           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      256         end.
      257         else
      258         do:
      259           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      260         end.
      261       end.
      262       p-process = yes.
      263     end.
      264   end procedure.
      265   procedure prn-lib-get-report-name :
      266     define input parameter parParentProc  as widget-handle no-undo.
      267     define output parameter p-report-name as character no-undo .
      268     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      269   end procedure.
      270   procedure prn-lib-reportviewer-report-name :
      271     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      272     define input parameter p-report-name-html as character no-undo .
      273     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      274   end procedure.
      275   procedure prn-lib-reportviewer :
      276     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      277     define input parameter p-report-name-html as character no-undo .
      278     define input parameter p-param        as character no-undo .
      279     define variable v-excel           as character no-undo init 'TRUE' .
      280     define variable v-value-character as character no-undo .
      281     define variable v-value-integer   as character no-undo .
      282     define variable v-value-date      as date      no-undo .
      283     define variable v-value-decimal   as decimal   no-undo .
      284     define variable rep-excel         as logical   no-undo .
      285     define variable excel-string      as character no-undo .
      286     define variable v-param-type      as character no-undo .
      287     define variable v-tth             as handle    no-undo .
      288     run adm/shattri.p (
      289       input "get":U
      290       ,input  ""
      291       ,input  0
      292       ,input  'report-glob':U
      293       ,input  'rep-excel':U
      294       ,output v-value-character
      295       ,output v-value-date
      296       ,output v-value-decimal
      297       ,output v-value-integer
      298       ,output rep-excel
      299       ,output v-param-type
      300       ,INPUT-OUTPUT table-handle v-tth
      301       )  .
      302     if rep-excel then v-excel = "TRUE" .
      303     else v-excel = "FALSE" .
      304     if p-param eq ""
      305     then
      306        p-param = "EXCEL:" + v-excel.
      307     else
      308        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      309     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      310   end procedure.
      311   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      312   define  temp-table temp-changes no-undo
      313   field f_name as character
      314   field l_name as character
      315   field v_old as character
      316   field v_new as character
      317   field t_name as character
      318   field num_ as integer
      319   field uniq-key-rec as character
      320   field action as integer
      321   field fNotChange as logical
      322   index pi is unique primary
      323   num_
      324   t_name
      325   f_name
      326   index
      327   Chan
      328   fnotChange
      329   t_name
      330   f_name
      331   index imain uniq-key-rec
      332   .
      333   FUNCTION get-all-fields returns character (p-file-name as character ):
      334   define variable v-dop as character no-undo .
      335     find first _file no-lock where _file._file-name = p-file-name no-error .
      336     if not available _file then return "":U.
      337     for each _field no-lock where
      338              _field._file-recid = recid(_file) :
      339       assign
      340       v-dop = v-dop + _field._field-name + chr(44)
      341       .
      342     end.
      343     return trim(v-dop).
      344   END FUNCTION.
      345   PROCEDURE proc-full-temp-changes :
      346     define input  parameter p-hst-handle as handle    no-undo .
      347     define input  parameter p-main-table as character no-undo .
      348     define input  parameter p-field-list as character no-undo .
      349     define input  parameter p-label-form as character no-undo .
      350     define variable h-new-buf         as handle    no-undo .
      351     define variable h-main-buf        as handle    no-undo .
      352     define variable h-for-comp        as handle    no-undo .
      353     define variable v-inform          as character no-undo .
      354     define variable v-ind             as integer   no-undo .
      355     define variable v-idx-field-qnty  as integer   no-undo .
      356     define variable v-num-entries     as integer   no-undo .
      357     define variable fh                as handle    no-undo .
      358     define variable fh-main           as handle    no-undo .
      359     define variable fh-old            as handle    no-undo .
      360     define variable fh-new            as handle    no-undo .
      361     define variable v-field-name      as character no-undo .
      362     define variable v-field-lvl       as character no-undo .
      363     define variable v-field-form      as character no-undo .
      364     define variable v-search-exp      as character no-undo .
      365     define variable v-srch-main       as character no-undo .
      366     define variable v-word-link       as character no-undo .
      367     define variable v-av-chip-num     as logical   no-undo .
      368     define variable v-main-pi-fld-lst as character no-undo .
      369     define variable v-main-fld-lst    as character no-undo .
      370     define variable v-delim-list      as character no-undo .
      371     define variable v-label           as character no-undo .
      372     define variable v-old-value       as character no-undo case-sensitive.
      373     define variable v-new-value       as character no-undo case-sensitive.
      374     define variable v-chg-fields as character no-undo.
      375     for each temp-changes:
      376       delete temp-changes.
      377     end.
      378     if not p-hst-handle:available then do:
      379       return .
      380     end.
      381     create buffer h-new-buf  for table p-hst-handle .
      382     create buffer h-main-buf for table p-main-table .
      383     assign
      384       v-inform = h-main-buf:index-information(1)
      385       v-ind    = 2
      386     .
      387     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      388     on error undo, return error
      389     :
      390       assign
      391         v-inform = h-main-buf:index-information( v-ind )
      392         v-ind    = v-ind + 1
      393       .
      394     end.
      395     if v-inform = ?
      396       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      397       or entry( 3, v-inform, ",":U ) <> "1":U
      398     then do:
      399       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      400     end.
      401     assign
      402       v-idx-field-qnty = num-entries( v-inform ) - 4
      403     .
      404     if v-idx-field-qnty < 2 then do:
      405       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      406     end.
      407     assign
      408       v-srch-main   = "where":U
      409       v-word-link   = "":U
      410       v-av-chip-num = false
      411       v-delim-list  = "":U
      412     .
      413     do v-ind = 1 to v-idx-field-qnty by 2
      414     on error undo, return error
      415     :
      416       assign
      417         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      418         fh                = p-hst-handle:buffer-field( v-field-name )
      419         fh-main           = h-main-buf:buffer-field( v-field-name )
      420         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      421         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      422       .
      423       if fh:data-type ="character":U then do:
      424         assign
      425           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      426         .
      427       end.
      428       else do:
      429         assign
      430           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      431         .
      432       end.
      433       if v-delim-list = "":U then do:
      434         assign
      435           v-delim-list = ",":U
      436         .
      437       end.
      438       if v-word-link = "":U then do:
      439         assign
      440           v-word-link = "and":U
      441         .
      442       end.
      443     end.
      444     assign
      445       v-delim-list  = "":U
      446     .
      447     do v-ind = 1 to h-main-buf:num-fields
      448     on error undo, return error
      449     :
      450       assign
      451         fh-main      = h-main-buf:buffer-field( v-ind )
      452         v-field-name = fh-main:name
      453       .
      454         assign
      455           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      456         .
      457         if v-delim-list = "":U then do:
      458           assign
      459             v-delim-list = ",":U
      460           .
      461         end.
      462     end.
      463     assign
      464       v-inform = p-hst-handle:index-information(1)
      465       v-ind    = 2
      466     .
      467     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      468     on error undo, return error
      469     :
      470       assign
      471         v-inform = p-hst-handle:index-information( v-ind )
      472         v-ind    = v-ind + 1
      473       .
      474     end.
      475     if v-inform = ?
      476       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      477       or entry( 3, v-inform, ",":U ) <> "1":U
      478     then do:
      479       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      480     end.
      481     assign
      482       v-idx-field-qnty = num-entries( v-inform ) - 4
      483     .
      484     if v-idx-field-qnty < 2 then do:
      485       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      486     end.
      487     assign
      488       v-search-exp  = "where":U
      489       v-word-link   = "":U
      490       v-av-chip-num = false
      491     .
      492     do v-ind = 1 to v-idx-field-qnty by 2
      493     on error undo, return error
      494     :
      495       assign
      496         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      497         fh           = p-hst-handle:buffer-field( v-field-name )
      498         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      499       .
      500       if v-field-name = "chip-num":U then do:
      501         assign
      502           v-search-exp  = substitute( "&1 >", v-search-exp )
      503           v-av-chip-num = true
      504         .
      505       end.
      506       else do:
      507         assign
      508           v-search-exp = substitute( "&1 =", v-search-exp )
      509         .
      510       end.
      511       if fh:data-type ="character":U then do:
      512         assign
      513           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      514         .
      515       end.
      516       else do:
      517         assign
      518           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
      519         .
      520       end.
      521       if v-word-link = "":U then do:
      522         assign
      523           v-word-link = "and":U
      524         .
      525       end.
      526     end.
      527     if v-av-chip-num = false then do:
      528       message
      529         vss-workfile vss-revision vss-description skip
      530         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
      531         "Использование данной процедуры невозможно!" skip
      532         view-as alert-box error .
      533       return error .
      534     end.
      535     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
      536     if not h-new-buf:available then do:
      537       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
      538       if not h-main-buf:available then do:
      539         assign
      540           h-for-comp = ?
      541         .
      542       end.
      543       else do:
      544         assign
      545           h-for-comp = h-main-buf
      546         .
      547       end.
      548     end.
      549     else do:
      550       assign
      551         h-for-comp = h-new-buf
      552       .
      553     end.
      554     assign
      555       v-num-entries = num-entries( v-main-fld-lst, ",":U )
      556     .
      557     do v-ind = 1 to v-num-entries
      558     on error undo, return error return-value
      559     :
      560       assign
      561         v-field-name = entry( v-ind, v-main-fld-lst )
      562         fh-old       = p-hst-handle:buffer-field( v-field-name )
      563         v-old-value  = fh-old:buffer-value()
      564         v-label      = trim( fh-old:label )
      565       .
      566       if ( trim( p-field-list ) <> "":U
      567            and lookup( v-field-name, p-field-list ) > 0
      568          )
      569          or trim( p-field-list ) = "":U
      570       then do:
      571         if h-for-comp <> ? then do:
      572           assign
      573             fh-new      = h-for-comp:buffer-field( v-field-name )
      574             v-new-value = fh-new:buffer-value()
      575           .
      576         end.
      577         else do:
      578           assign
      579             v-new-value = "":U
      580           .
      581         end.
      582         if v-old-value <> v-new-value
      583         then do:
      584           create temp-changes.
      585           assign
      586             temp-changes.t_name = p-main-table
      587             temp-changes.f_name = v-field-name
      588             temp-changes.l_name = replace( v-label, "&":U, "":U )
      589             temp-changes.v_old  = trim( v-old-value )
      590             temp-changes.v_new  = trim( v-new-value )
      591             temp-changes.num_   = 0
      592             temp-changes.fNotChange = v-old-value eq v-new-value
      593           .
      594         end.
      595       end.
      596     end.
      597     assign
      598       v-num-entries = num-entries( p-label-form, chr(8) )
      599     .
      600     do v-ind = 1 to v-num-entries
      601     on error undo, return error return-value
      602     :
      603       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
      604         assign
      605           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      606           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      607           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      608         .
      609         find first temp-changes
      610           where temp-changes.f_name = v-field-name
      611           no-error .
      612         if available temp-changes then do:
      613           if trim( v-field-lvl ) <> "":U then do:
      614             assign
      615               temp-changes.l_name = v-field-lvl
      616             .
      617           end.
      618           if trim( v-field-form ) <> "":U then do:
      619             assign
      620               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
      621             .
      622             if h-for-comp <> ? then do:
      623               assign
      624                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
      625               .
      626             end.
      627           end.
      628         end.
      629       end.
      630       else do:
      631         message
      632           vss-workfile vss-revision vss-description skip
      633           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
      634           substitute( "список для поля '&1': '&2'"
      635                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      636                       ,entry( v-ind, p-label-form, chr(8) )
      637                     ) skip
      638           substitute( "полный список: &2", p-label-form ) skip
      639           view-as alert-box error .
      640       end.
      641     end.
      642     delete object h-new-buf .
      643     delete object h-main-buf .
      644   END PROCEDURE.
      645   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      646   define variable v-waitfram-action01         as character   no-undo .
      647   define variable v-waitfram-action02         as character   no-undo .
      648   define variable v-waitfram-action03         as character   no-undo .
      649   define variable mWaitFramTextBeg            as character   no-undo.
      650   define variable mWaitFramTextEnd            as character   no-undo.
      651   define variable mWaitFramView               as logical     no-undo.
      652   define variable mWaitProcEvent              as logical     no-undo init yes.
      653   define variable mWaitFramInterval           as integer     no-undo init 1 .
      654   define variable mWaitFramStop               as logical     no-undo.
      655   define variable mWaitFramStopUser           as logical     no-undo.
      656   define variable mWaitFramStopTimeOut        as logical     no-undo.
      657   define variable mWaitFramStartProc          as datetime-tz no-undo.
      658   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      659   define button B-WaitFramStop auto-end-key
      660        label "Стоп"
      661        size 10 by 1 tooltip "Остоновить процесс".
      662   define button B-viewProcInfo
      663        label "Информация"
      664        size 15 by 1 tooltip "Информация о процесс".
      665   define frame waitfram
      666     v-waitfram-action01 format "x(72)" no-label skip
      667     v-waitfram-action02 format "x(72)" no-label skip
      668     v-waitfram-action03 format "x(72)" no-label skip
      669     B-viewProcInfo
      670     B-WaitFramStop at row 4 col 30
      671     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      672     .
      673   define new global shared variable mBatchMode as logical no-undo init ?.
      674   define variable mFramBachModHandle as handle no-undo.
      675   mFramBachModHandle = frame waitfram:handle.
      676   define variable mFameOldVis as logical no-undo.
      677   define variable mVisCUrentVin as logical no-undo.
      678   if session:batch-mode
      679   then
      680      mBatchMode = yes.
      681   if mBatchMode = ? then do:
      682     mVisCUrentVin = current-window:visible.
      683     mFameOldVis = mFramBachModHandle:visible.
      684     mFramBachModHandle:visible  = yes.
      685     mBatchMode = mFramBachModHandle:visible ne yes.
      686     mFramBachModHandle:visible = mFameOldVis.
      687     current-window:visible = mVisCUrentVin.
      688   end.
      689    if  log-manager:logfile-name ne ?
      690     then DO:
      691         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      692         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      693         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      694     end.
      695   on choose of B-WaitFramStop in frame waitfram
      696   do:
      697     mWaitFramStop = yes.
      698     mWaitFramStopUser = yes.
      699   end.
      700   function waitfram-check-timeout returns logical():
      701      define variable vtime as int64 no-undo.
      702      if mWaitFramStopTimeOut
      703      then
      704         return yes.
      705      vtime = ( now - mWaitFramStartProc ) / 1000 .
      706      if     mWaitFramTimeOut ne ?
      707         and mWaitFramTimeOut ne 0
      708         and mWaitFramTimeOut lt vtime
      709      then do:
      710         mWaitFramStopTimeOut = yes.
      711      end.
      712      return mWaitFramStopTimeOut.
      713   end.
      714   procedure waitfram-hide :
      715     if not session:batch-mode
      716     then do
      717     on error undo, return error return-value
      718     :
      719       pause 0 before-hide .
      720       if not mBatchMode then
      721         hide frame waitfram .
      722     if     not mWaitFramView
      723        and mWaitProcEvent
      724     then
      725       process events .
      726     end.
      727   end procedure.
      728   procedure waitfram-show :
      729     define input  parameter p-message as character no-undo .
      730     define variable v-left-margin as integer   no-undo .
      731     if not session:batch-mode
      732     then do
      733     on error undo, return error return-value
      734     :
      735       if length(p-message) <= 70 then do:
      736         assign
      737           v-left-margin = integer((70 - length(p-message)) / 2)
      738         .
      739         assign
      740           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      741         .
      742         assign
      743           v-waitfram-action01 = " "
      744           v-waitfram-action02 = " "
      745                                    + fill(" ", v-left-margin)
      746                                    + p-message
      747           v-waitfram-action03 = " "
      748         .
      749       end.
      750       else do:
      751         define variable vRindex1 as integer no-undo.
      752         define variable vRindex2 as integer no-undo.
      753         vRindex1 = r-index(p-message," ",70).
      754         if vRindex1 = 0
      755         then
      756            vRindex1 = 70.
      757         if length(p-message)  <= vRindex1 + 70 then do:
      758           assign
      759             v-waitfram-action01 = " "
      760             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      761             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      762           .
      763         end.
      764         else do:
      765           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      766           if vRindex2 <= vRindex1
      767           then
      768              vRindex2 = vRindex1 + 70.
      769           assign
      770             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      771             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      772             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      773           .
      774         end.
      775       end.
      776       B-viewProcInfo:visible   in frame waitfram = no.
      777       B-viewProcInfo:sensitive in frame waitfram = no.
      778       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      779       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      780       if  (   mWaitFramView
      781          or  mWaitProcEvent)
      782          and not mBatchMode
      783       then
      784          display
      785             v-waitfram-action01 skip
      786             v-waitfram-action02 skip
      787             v-waitfram-action03 skip
      788          with frame waitfram .
      789       if     mWaitFramView
      790          then do:
      791             if     mWaitFramInterval ne ?
      792                and not mBatchMode
      793             then
      794                wait-for go of frame waitfram pause mWaitFramInterval.
      795          end.
      796          else
      797             if     mWaitProcEvent
      798                and not mBatchMode
      799             then
      800                process events .
      801     end.
      802   end procedure.
      803      procedure waitfram-show-this:
      804         define input  parameter iInterval as int64 no-undo.
      805         define variable vtime as int64 no-undo.
      806         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      807         mWaitFramInterval = iInterval.
      808         run waitfram-show (substitute("&1&2 &3&4" ,
      809                                       mWaitFramTextBeg ,
      810                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      811                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      812                                       mWaitFramTextEnd
      813                                      )
      814                           ).
      815      end.
      816      procedure WaitFramRunPause:
      817         define input  parameter iInterval as dec no-undo.
      818         define variable vStart  as datetime-tz no-undo.
      819         define variable vend    as datetime-tz no-undo.
      820         define variable vint as int64 no-undo.
      821         define variable vOk as logical no-undo.
      822         vStart = now.
      823         vend   = vStart.
      824         publish "WaitFramPause" (iInterval,output vOk).
      825         vend   =  now.
      826         vint = vend - vStart.
      827         vint = iInterval - vint / 1000.
      828         if     not mWaitFramStop
      829            and (   vint > 0
      830                 or (    not vOk
      831                     and iInterval eq ?
      832                     )
      833                 )
      834         then
      835            run waitfram-show-this (iInterval).
      836         vend   =  now.
      837         vint = vend - vStart.
      838         vint = iInterval - vint / 1000.
      839         if     not mWaitFramStop
      840            and vint > 0
      841         then do:
      842            run gbl/pause.p (vint * 1000).
      843         end.
      844         if iInterval ne ?
      845         then
      846            publish "WaitFramStop".
      847         waitfram-check-timeout().
      848      end.
      849      procedure WaitFramWaitFor:
      850         define input  parameter iInterval as dec no-undo.
      851         assign
      852            mWaitFramStartProc   = now
      853            mWaitFramStopUser    = no
      854            mWaitFramStopTimeOut = no
      855         .
      856         block-wait:
      857         do while not mWaitFramStop:
      858            run WaitFramRunPause (iInterval).
      859            if  waitfram-check-timeout()
      860            then do:
      861               leave block-wait.
      862            end.
      863         end.
      864         run waitfram-hide.
      865      end.
      866   procedure waitfram-join :
      867     define input  parameter p-line-1  as character no-undo .
      868     define input  parameter p-line-2  as character no-undo .
      869     define input  parameter p-line-3  as character no-undo .
      870     define output parameter p-message as character no-undo .
      871     do
      872     on error undo, return error return-value
      873     :
      874       assign
      875         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      876                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      877                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      878       .
      879     end.
      880   end procedure.
      881   function waitfram-join-function returns character
      882     (input p-line-1 as character
      883     ,input p-line-2 as character
      884     ,input p-line-3 as character
      885     ).
      886     define variable v-message as character no-undo .
      887     run waitfram-join in this-procedure
      888       (input  p-line-1
      889       ,input  p-line-2
      890       ,input  p-line-3
      891       ,output v-message
      892       ) .
      893     return v-message .
      894   end function .
      895   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      896   procedure cur-time :
      897      define output parameter p-today as date      no-undo .
      898      define output parameter p-time  as integer   no-undo .
      899     do
      900     on error undo, return error
      901     :
      902       define variable v-date1 as date      no-undo .
      903       define variable v-date2 as date      no-undo .
      904       define variable v-time  as integer   no-undo .
      905       assign
      906         v-date1 = today
      907         v-time  = time
      908         v-date2 = today
      909       .
      910       if v-date1 <> v-date2
      911       then do:
      912         assign
      913           v-date1 = today
      914           v-time  = v-time
      915         .
      916       end.
      917       assign
      918         p-today = v-date1
      919         p-time  = v-time
      920       .
      921     end.
      922   end.
      923   function cur-time-date returns character
      924   :
      925     return string(today, '99/99/9999':U) .
      926   end.
      927   function cur-time-mjd returns decimal
      928   :
      929     define variable v-date as date      no-undo .
      930     define variable v-time as integer   no-undo .
      931     run cur-time in this-procedure
      932       (output v-date
      933       ,output v-time
      934       ) .
      935     return integer(v-date) - 2400002 + (v-time / 86400) .
      936   end.
      937   function cur-time-get-ending-index returns integer
      938   (input p-number as integer
      939   )
      940   :
      941     if p-number < 0
      942     or p-number = ?
      943     then do:
      944       return 1 .
      945     end.
      946     define variable v-rest as integer   no-undo .
      947     assign
      948       p-number = p-number modulo 100
      949     .
      950     if p-number < 20
      951     then do:
      952       assign
      953         v-rest = p-number
      954       .
      955     end.
      956     else do:
      957       assign
      958         v-rest = p-number modulo 10
      959       .
      960     end.
      961     case v-rest :
      962       when 1
      963       then do:
      964         return 2 .
      965       end.
      966       when 2 or
      967       when 3 or
      968       when 4
      969       then do:
      970         return 3 .
      971       end.
      972       otherwise do:
      973         return 1 .
      974       end.
      975     end case .
      976   end.
      977   procedure cur-time-mjd-to-date :
      978      define input  parameter i-mjd-diff as decimal no-undo.
      979      define output parameter o-Date     as date    no-undo.
      980      define output parameter o-Time     as integer no-undo.
      981      define variable v-day-number as integer   no-undo .
      982      if    i-mjd-diff < 0
      983         or i-mjd-diff = ?
      984      then do:
      985         return "?" .
      986      end.
      987      assign
      988         v-day-number = truncate(i-mjd-diff,0).
      989         o-Date = date(v-day-number + 2400002).
      990         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      991     .
      992   end.
      993   function cur-time-mjd-to-string returns character
      994   (input p-mjd-diff as decimal
      995   )
      996   :
      997     define variable v-day-number as integer   no-undo .
      998     define variable v-seconds    as integer   no-undo .
      999     define variable v-hour       as integer   no-undo .
     1000     define variable v-min        as integer   no-undo .
     1001     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1002     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1003     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1004     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1005     if p-mjd-diff < 0
     1006     or p-mjd-diff = ?
     1007     then do:
     1008       return "?" .
     1009     end.
     1010     assign
     1011       v-day-number = integer(truncate(p-mjd-diff,0))
     1012       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1013     .
     1014     if v-seconds > 86400
     1015     then do:
     1016       assign
     1017         v-seconds = 86400 - 1
     1018       .
     1019     end.
     1020     if v-seconds < 0
     1021     then do:
     1022       assign
     1023         v-seconds = 0
     1024       .
     1025     end.
     1026     assign
     1027       v-hour = truncate(v-seconds / 3600, 0)
     1028     .
     1029     assign
     1030       v-seconds = v-seconds modulo 3600
     1031     .
     1032     assign
     1033       v-min = truncate(v-seconds / 60, 0)
     1034     .
     1035     assign
     1036       v-seconds = v-seconds modulo 60
     1037     .
     1038     return
     1039         (if v-day-number <> 0
     1040           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1041           else ""
     1042         )
     1043       + (if v-day-number <> 0 or v-hour <> 0
     1044           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1045           else ""
     1046         )
     1047       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1048           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1049           else ""
     1050         )
     1051       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1052       .
     1053   end.
     1054   function cur-time-string returns character
     1055   :
     1056     define variable v-date as date      no-undo .
     1057     define variable v-time as integer   no-undo .
     1058     run cur-time in this-procedure
     1059       (output v-date
     1060       ,output v-time
     1061       ) .
     1062     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1063   end.
     1064   function cur-time-string-sec returns character
     1065   :
     1066     define variable v-date as date      no-undo .
     1067     define variable v-time as integer   no-undo .
     1068     run cur-time in this-procedure
     1069       (output v-date
     1070       ,output v-time
     1071       ) .
     1072     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1073   end.
     1074   function cur-time-custom  returns character
     1075   (input p-prefix as character
     1076   ,input p-date-format as character
     1077   ,input p-delimiter as character
     1078   ,input p-time-format as character
     1079   ,input p-suffix as character
     1080   )
     1081   :
     1082     define variable v-date as date      no-undo .
     1083     define variable v-time as integer   no-undo .
     1084     run cur-time in this-procedure
     1085       (output v-date
     1086       ,output v-time
     1087       ) .
     1088     return
     1089       p-prefix
     1090       + string(v-date, p-date-format)
     1091       + p-delimiter
     1092       + string(v-time, p-time-format)
     1093       + p-suffix
     1094       .
     1095   end.
     1096   function cur-time-print  returns character
     1097   :
     1098     define variable v-date as date      no-undo .
     1099     define variable v-time as integer   no-undo .
     1100     run cur-time in this-procedure
     1101       (output v-date
     1102       ,output v-time
     1103       ) .
     1104     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1105   end.
     1106   function cur-time-datetime returns datetime
     1107   :
     1108     define variable v-char as character no-undo .
     1109     define variable v-datetime as datetime no-undo .
     1110     v-char = cur-time-string().
     1111     v-datetime = datetime(v-char).
     1112     return  v-datetime.
     1113   end.
     1114   function cur-time-string-msec returns character
     1115   :
     1116     define variable v-date as datetime  no-undo .
     1117     v-date = now.
     1118     return string(v-date) .
     1119   end.
     1120   procedure proc-alt-shift-f2:
     1121     if not ibs.th.gbl.gbl-var:rcode
     1122   then
     1123     run gbl\inidebug.p .
     1124   end.
     1125   procedure proc-alt-shift-f3:
     1126     run gbl/prvssinf.p
     1127       ( input this-procedure
     1128       ) .
     1129   end.
     1130   define variable v-inform-launched as logical no-undo initial false .
     1131   procedure proc-alt-shift-f4:
     1132     define variable v-action as character no-undo .
     1133     if v-inform-launched = false then do:
     1134       assign
     1135         v-inform-launched = true
     1136       .
     1137       run gbl/d-inform.w
     1138         (  input self
     1139         ,  input this-procedure
     1140         , output v-action
     1141         ) no-error .
     1142       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1143       assign
     1144         v-inform-launched = false
     1145       .
     1146     end.
     1147   end.
     1148   procedure proc-alt-f1:
     1149     run gbl/corrhelp.p
     1150       (input this-procedure
     1151       ) .
     1152   end .
     1153   on alt-shift-f2 anywhere do:
     1154     run proc-alt-shift-f2.
     1155   end.
     1156   on alt-shift-f3 anywhere do:
     1157     run proc-alt-shift-f3 in this-procedure .
     1158   end.
     1159   on alt-shift-f4 anywhere do:
     1160     run proc-alt-shift-f4 in this-procedure.
     1161   end.
     1162   on alt-f1 anywhere do:
     1163     run proc-alt-f1 in this-procedure .
     1164   end.
     1165   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1166     define variable v-cntxt-db-num        as integer   no-undo .
     1167     define variable v-cntxt-userid        as character no-undo .
     1168     define variable v-cntxt-level         as character no-undo .
     1169     define variable v-cntxt-host-code-obj as integer   no-undo .
     1170     define variable v-cntxt-obj-type      as character no-undo .
     1171     define variable v-cntxt-obj-code      as integer   no-undo .
     1172     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1173     define variable v-cntxt-is-admin      as logical   no-undo .
     1174   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1175   FUNCTION mark-string RETURNS CHARACTER
     1176     ( input p-recid as recid, input mark-list as character  ) :
     1177     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     1178   END FUNCTION.
     1179   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1180   function usrfulnf returns character ( input p-user-id as character):
     1181   define variable v-user-name as character no-undo .
     1182   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1183   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
     1184     (input  p-user-id
     1185     ,output v-user-name
     1186     ) no-error .
     1187   if error-status:error
     1188   or v-user-name = ""
     1189   then do:
     1190     return p-user-id.
     1191   end.
     1192   else do:
     1193     return v-user-name.
     1194   end.
     1195   end function.
     1196   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1197   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1198   procedure fltopend_fltopend :
     1199   define input parameter p-parent-handle as handle no-undo .
     1200   define input parameter p-qh as handle no-undo .
     1201   define input parameter p-flt-open-open-query  as character no-undo .
     1202   define input parameter p-where-cond as character no-undo .
     1203   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1204   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1205   define input parameter p-indexed-reposition as character no-undo .
     1206     do
     1207     on error undo, return error
     1208     :
     1209   define variable v-prepare-string as character no-undo .
     1210   define variable glog as logical no-undo .
     1211   assign
     1212   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1213                      p-where-cond + chr(32)  +
     1214                      p-use-indFIRST-query-tail + chr(32) +
     1215                      p-use-ind-sort-clmn-by + chr(32) +
     1216                      p-indexed-reposition
     1217   .
     1218   assign
     1219   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1220   if not glog
     1221   or error-status:error then do:
     1222     message error-status:get-message(1) view-as alert-box .
     1223     undo, return error .
     1224   end.
     1225   assign
     1226   glog = p-qh:query-open no-error .
     1227   if not glog
     1228   or error-status:error then do:
     1229     message error-status:get-message(1) view-as alert-box .
     1230     undo, return error .
     1231   end.
     1232     end.
     1233   end procedure.
     1234   procedure fltopend_fltfindd :
     1235   define input parameter p-parent-handle as handle no-undo .
     1236   define input parameter p-qh as handle no-undo .
     1237   define input parameter p-rowid as rowid no-undo .
     1238   define input parameter p-next as logical no-undo .
     1239   define input parameter p-lock as integer no-undo .
     1240   define input parameter p-bh as handle no-undo .
     1241   define input parameter p-where-cond as character no-undo .
     1242   define input parameter p-use-index-phrase as character no-undo .
     1243   define variable glog as logical no-undo .
     1244   define variable v-qh as handle no-undo .
     1245   define variable v-bh as handle no-undo .
     1246   define variable v-recid as recid no-undo .
     1247   define variable v-prepare-string as character no-undo .
     1248   do
     1249   on error undo, return error
     1250   on stop undo, return error
     1251   :
     1252     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1253     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1254     create query v-qh.
     1255     v-qh:set-buffers(v-bh).
     1256     v-prepare-string = substitute("for each &1 &2 &3"
     1257                                     ,v-bh:name
     1258                                     ,p-where-cond
     1259                                     ,p-use-index-phrase).
     1260     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1261     if not glog then do:
     1262       delete object v-qh.
     1263       delete object v-bh.
     1264       undo, return error .
     1265     end.
     1266     glog = v-qh:query-open no-error .
     1267     if not glog then do:
     1268       delete object v-qh.
     1269       delete object v-bh.
     1270       undo, return error .
     1271     end.
     1272     if p-next then do:
     1273       v-qh:reposition-to-rowid(p-rowid) no-error .
     1274       glog = v-qh:get-next( p-lock) no-error .
     1275       glog = v-qh:get-next( p-lock) no-error .
     1276       if not glog or v-qh:query-off-end = yes then do:
     1277         glog = v-qh:get-first( p-lock) no-error .
     1278       end.
     1279     end.
     1280     else do:
     1281       glog = v-qh:get-first( p-lock) no-error .
     1282     end.
     1283     v-recid = v-bh:recid no-error .
     1284     delete object v-qh.
     1285     delete object v-bh.
     1286     return string(v-recid) .
     1287   end.
     1288   end procedure.
     1289   procedure fltopend_fltfindq :
     1290   define input parameter p-parent-handle as handle no-undo .
     1291   define input parameter p-qh as handle no-undo .
     1292   define input parameter p-next as logical no-undo .
     1293   define input parameter p-lock as integer no-undo .
     1294   define input parameter p-flt-open-open-query  as character no-undo .
     1295   define input parameter p-where-cond as character no-undo .
     1296   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1297   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1298   define input parameter p-indexed-reposition as character no-undo .
     1299   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1300   define variable glog as logical no-undo .
     1301   define variable v-qh as handle no-undo .
     1302   define variable v-bh as handle no-undo extent 18.
     1303   define variable v-rowid as rowid no-undo extent 18.
     1304   define variable v-ii as integer no-undo .
     1305   define variable v-prepare-string as character no-undo .
     1306   do
     1307   on error undo, return error
     1308   on stop undo, return error
     1309   :
     1310     create query v-qh.
     1311     do v-ii = 1 to p-qh:num-buffers:
     1312       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1313       assign
     1314       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1315       no-error.
     1316       v-qh:add-buffer(v-bh[v-ii]).
     1317     end.
     1318     assign
     1319     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1320                       p-where-cond + chr(32)  +
     1321                       p-use-indFIRST-query-tail + chr(32) +
     1322                       p-use-ind-sort-clmn-by + chr(32) +
     1323                       p-indexed-reposition
     1324     .
     1325     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1326     if not glog then do:
     1327       delete object v-qh.
     1328       do v-ii = 1 to p-qh:num-buffers:
     1329         delete object v-bh[v-ii].
     1330       end.
     1331       undo, return error .
     1332     end.
     1333     glog = v-qh:query-open no-error .
     1334     if not glog then do:
     1335       delete object v-qh.
     1336       do v-ii = 1 to p-qh:num-buffers:
     1337         delete object v-bh[v-ii].
     1338       end.
     1339       undo, return error .
     1340     end.
     1341     if p-next then do:
     1342       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1343       glog = v-qh:get-next( p-lock) no-error .
     1344       glog = v-qh:get-next( p-lock) no-error .
     1345       if not glog or v-qh:query-off-end = yes then do:
     1346         glog = v-qh:get-first( p-lock) no-error .
     1347       end.
     1348     end.
     1349     else do:
     1350       glog = v-qh:get-first( p-lock) no-error .
     1351     end.
     1352     do v-ii = 1 to p-qh:num-buffers:
     1353       assign
     1354       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1355       no-error.
     1356     end.
     1357     delete object v-qh.
     1358     do v-ii = 1 to p-qh:num-buffers:
     1359       delete object v-bh[v-ii].
     1360     end.
     1361   end.
     1362   end procedure.
     1363   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1364   procedure gen-key-rec :
     1365     define input  parameter p-tbl-name    as character no-undo.
     1366     define input  parameter p-bh_tbl-name as handle    no-undo.
     1367     define output parameter p-key-rec     as character no-undo.
     1368     do
     1369     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1370     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1371     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1372     :
     1373       define variable fh               as handle    no-undo .
     1374       define variable v-ok             as logical   no-undo .
     1375       define variable v-inform         as character no-undo .
     1376       define variable v-ind            as integer   no-undo .
     1377       define variable v-idx-field-qnty as integer   no-undo .
     1378       if p-tbl-name = ?
     1379         or p-tbl-name = "":U
     1380       then do:
     1381         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info14 ).
     1382       end.
     1383       if not p-bh_tbl-name:available then do:
     1384         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info14, p-tbl-name ).
     1385       end.
     1386       assign
     1387         p-key-rec = p-tbl-name
     1388         v-inform  = p-bh_tbl-name:index-information(1)
     1389         v-ind     = 2
     1390       .
     1391       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1392       on error undo, return error
     1393       :
     1394         assign
     1395           v-inform = p-bh_tbl-name:index-information( v-ind )
     1396           v-ind    = v-ind + 1
     1397         .
     1398       end.
     1399       if v-inform = ?
     1400         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1401         or entry( 3, v-inform, ",":U ) <> "1":U
     1402       then do:
     1403         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info14, p-tbl-name ).
     1404       end.
     1405       else do:
     1406         assign
     1407           v-idx-field-qnty = num-entries( v-inform ) - 4
     1408         .
     1409         if v-idx-field-qnty < 2 then do:
     1410           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info14, v-inform, p-tbl-name ).
     1411         end.
     1412         do v-ind = 1 to v-idx-field-qnty by 2
     1413         on error undo, return error
     1414         :
     1415           assign
     1416             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1417             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1418           .
     1419         end.
     1420       end.
     1421       if p-key-rec = ? then do:
     1422         assign
     1423           p-key-rec = "":U
     1424         .
     1425         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info14, p-tbl-name ).
     1426       end.
     1427     end.
     1428     return.
     1429   end procedure.
     1430   procedure gen-where-keyr-tab :
     1431     define input  parameter i-tableSerach as character no-undo.
     1432     define input  parameter i-tablekey   as character  no-undo.
     1433     define input  parameter p-key-rec    as character  no-undo.
     1434     define input  parameter p-key-handle as handle     no-undo .
     1435     define input  parameter p-db-name    as character  no-undo .
     1436     define input  parameter p-tt-handle  as handle     no-undo .
     1437     define output parameter o-Where      as character  no-undo.
     1438     do
     1439     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1440     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1441     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1442     :
     1443       define variable v-full-tbl-name  as character no-undo .
     1444       define variable bh_tbl-name      as handle    no-undo .
     1445       define variable fh_key           as handle    no-undo .
     1446       define variable fh_search        as handle    no-undo .
     1447       define variable v-field-num      as integer   no-undo .
     1448       define variable v-count-fld      as integer   no-undo .
     1449       define variable v-inform         as character no-undo .
     1450       define variable v-ind            as integer   no-undo .
     1451       define variable v-idx-field-qnty as integer   no-undo .
     1452       define variable v-field-name     as character no-undo .
     1453       define variable v-field-val      as character no-undo .
     1454       define variable v-word-link      as character no-undo .
     1455       define variable vTable           as character no-undo.
     1456       define variable bh_tbl-key       as handle    no-undo .
     1457       assign
     1458         p-key-rec = trim( p-key-rec )
     1459       .
     1460       if p-key-handle <> ? then do:
     1461         if not valid-handle(p-key-handle)
     1462            or p-key-handle:type <> "buffer"
     1463         then do:
     1464           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info14 ).
     1465         end.
     1466         if num-entries( p-key-rec, chr(3) ) > 1
     1467           or p-key-rec = ?
     1468           or p-key-rec = "":U
     1469         then do:
     1470           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info14, p-key-rec ).
     1471         end.
     1472       end.
     1473       else do:
     1474         if p-key-rec = ?
     1475           or p-key-rec = "":U
     1476         then do:
     1477           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info14 ).
     1478         end.
     1479       end.
     1480       assign
     1481         vTable = entry( 1 , p-key-rec, chr(3) )
     1482       .
     1483       if p-tt-handle <> ?
     1484         and ( not valid-handle(p-tt-handle)
     1485               or p-tt-handle:type <> "buffer"
     1486             )
     1487       then do:
     1488         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info14, vTable, chr(10) ).
     1489       end.
     1490       if p-tt-handle = ? then do:
     1491         assign
     1492           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1493         .
     1494         create buffer bh_tbl-name for table v-full-tbl-name .
     1495       end.
     1496       else do:
     1497         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1498       end.
     1499       assign
     1500         v-inform = bh_tbl-name:index-information(1)
     1501         v-ind    = 2
     1502       .
     1503       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1504       on error undo, return error
     1505       :
     1506         assign
     1507           v-inform = bh_tbl-name:index-information( v-ind )
     1508           v-ind    = v-ind + 1
     1509         .
     1510       end.
     1511       if v-inform = ?
     1512         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1513         or entry( 3, v-inform, ",":U ) <> "1":U
     1514       then do:
     1515         delete object bh_tbl-name no-error.
     1516         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info14, vTable ).
     1517       end.
     1518       assign
     1519         v-idx-field-qnty = num-entries( v-inform ) - 4
     1520       .
     1521       if v-idx-field-qnty < 2 then do:
     1522         delete object bh_tbl-name no-error.
     1523         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info14, v-inform, vTable ).
     1524       end.
     1525       assign
     1526         o-where     = "where":U
     1527         v-word-link = "":U
     1528         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1529         v-count-fld = 0
     1530       .
     1531       if i-tablekey ne "" and i-tablekey ne ?
     1532       then do:
     1533         assign
     1534           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1535         .
     1536         create buffer bh_tbl-key for table v-full-tbl-name .
     1537       end.
     1538       if i-tableSerach ne "" and i-tableSerach ne ?
     1539       then do:
     1540         delete object bh_tbl-name no-error.
     1541         assign
     1542           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1543         .
     1544         create buffer bh_tbl-name for table v-full-tbl-name .
     1545       end.
     1546       block_where:
     1547       do v-ind = 1 to v-idx-field-qnty by 2
     1548       on error undo, return error
     1549       :
     1550         assign
     1551           v-count-fld = v-count-fld + 1
     1552         .
     1553         if p-key-handle = ?
     1554           and v-count-fld > v-field-num
     1555         then do:
     1556           leave block_where.
     1557         end.
     1558         define variable VfieldKeyTable as handle no-undo.
     1559         assign
     1560           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1561           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1562         .
     1563         if     bh_tbl-key ne ?
     1564         then do:
     1565            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1566            if VfieldKeyTable eq ?
     1567            then next block_where.
     1568         end.
     1569         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1570         then
     1571            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1572         else
     1573            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1574         if p-key-handle = ? then do:
     1575           assign
     1576             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1577           .
     1578         end.
     1579         else do:
     1580           assign
     1581             fh_key = p-key-handle:buffer-field( v-field-name )
     1582           .
     1583           if fh_key = ?
     1584             or not valid-handle( fh_key )
     1585           then do:
     1586             delete object bh_tbl-name.
     1587             if     bh_tbl-key ne ?
     1588             then
     1589                delete object bh_tbl-key.
     1590             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info14, p-key-handle:name, v-field-name ).
     1591           end.
     1592           assign
     1593             v-field-val = fh_key:buffer-value
     1594           .
     1595         end.
     1596         if fh_search:data-type ="character":U then do:
     1597           assign
     1598             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1599             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1600             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1601             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1602             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1603             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1604             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1605             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1606             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1607             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1608             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1609             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1610             v-field-val = substitute( '"&1"', v-field-val )
     1611           .
     1612         end.
     1613         assign
     1614           o-where = substitute( "&1 &2", o-where, v-field-val )
     1615         .
     1616         if v-word-link = "":U then do:
     1617           assign
     1618             v-word-link = "and":U
     1619           .
     1620         end.
     1621       end.
     1622       delete object bh_tbl-name.
     1623       if     bh_tbl-key ne ?
     1624       then
     1625          delete object bh_tbl-key.
     1626       if p-key-handle = ?
     1627         and v-count-fld <> v-field-num
     1628       then do:
     1629         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info14, vTable ).
     1630       end.
     1631     end.
     1632   end procedure.
     1633   procedure gen-hn-keyr-tab :
     1634     define input  parameter i-tableSerach as character no-undo.
     1635     define input  parameter i-tablekey   as character no-undo.
     1636     define input  parameter p-key-rec    as character no-undo.
     1637     define input  parameter p-key-handle as handle    no-undo .
     1638     define input  parameter p-db-name    as character no-undo .
     1639     define input  parameter p-tt-handle  as handle    no-undo .
     1640     define input  parameter p-stts-lock  as integer   no-undo .
     1641     define output parameter o-hn         as handle    no-undo.
     1642     define variable v-full-tbl-name as character no-undo.
     1643     define variable v-where         as character no-undo.
     1644     define variable bh_tbl-name     as handle    no-undo.
     1645     define variable vTable          as character no-undo.
     1646     do
     1647     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1648     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1649     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1650         run gen-where-keyr-tab(i-tableSerach,
     1651                                i-tablekey,
     1652                                p-key-rec,
     1653                                p-key-handle,
     1654                                p-db-name,
     1655                                p-tt-handle,
     1656                                output v-where).
     1657         if i-tableSerach ne "" and i-tableSerach ne ?
     1658         then do:
     1659            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1660            create buffer bh_tbl-name for table v-full-tbl-name .
     1661         end.
     1662         else do:
     1663            if p-tt-handle = ? then do:
     1664               assign
     1665                  vTable = entry( 1 , p-key-rec, chr(3) )
     1666               .
     1667               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1668               create buffer bh_tbl-name for table v-full-tbl-name .
     1669            end.
     1670            else do:
     1671               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1672            end.
     1673         end.
     1674         if p-tt-handle = ? then do:
     1675            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1676         end.
     1677         else do:
     1678            bh_tbl-name:find-first( v-where ) no-error .
     1679         end.
     1680         o-hn = bh_tbl-name.
     1681      end.
     1682   end procedure.
     1683   procedure gen-hn-keyr :
     1684     define input  parameter p-key-rec    as character no-undo.
     1685     define input  parameter p-key-handle as handle    no-undo .
     1686     define input  parameter p-db-name    as character no-undo .
     1687     define input  parameter p-tt-handle  as handle    no-undo .
     1688     define input  parameter p-stts-lock  as integer   no-undo .
     1689     define output parameter o-hn         as handle    no-undo.
     1690     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1691   end.
     1692   procedure gen-row-keyr :
     1693     define input  parameter p-key-rec    as character no-undo.
     1694     define input  parameter p-key-handle as handle    no-undo .
     1695     define input  parameter p-db-name    as character no-undo .
     1696     define input  parameter p-tt-handle  as handle    no-undo .
     1697     define input  parameter p-stts-lock  as integer   no-undo .
     1698     define output parameter p-tbl-row    as rowid     no-undo.
     1699     define output parameter p-tbl-name   as character no-undo.
     1700     define variable vHn as handle no-undo.
     1701       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1702       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1703       p-tbl-name =  vHn:table.
     1704       delete object vHn no-error.
     1705     if p-tbl-row = ? then do:
     1706       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info14, p-tbl-name, p-key-rec ).
     1707     end.
     1708     else do:
     1709       return.
     1710     end.
     1711   end procedure.
     1712   procedure gen-key-fv :
     1713     define input  parameter p-key-rec    as character no-undo .
     1714     define output parameter p-field-list as character no-undo .
     1715     define output parameter p-value-list as character no-undo.
     1716     do
     1717     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1718     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1719     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1720     :
     1721       define variable v-full-tbl-name  as character no-undo .
     1722       define variable bh_tbl-name      as handle    no-undo .
     1723       define variable v-tbl-name       as character no-undo .
     1724       define variable v-field-num      as integer   no-undo .
     1725       define variable v-count-fld      as integer   no-undo .
     1726       define variable v-inform         as character no-undo .
     1727       define variable v-ind            as integer   no-undo .
     1728       define variable v-idx-field-qnty as integer   no-undo .
     1729       define variable v-delim-key      as character no-undo .
     1730       if p-key-rec = ?
     1731         or p-key-rec = "":U
     1732       then do:
     1733         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info14 ).
     1734       end.
     1735       assign
     1736         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1737         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1738       .
     1739       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1740       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info14 ).
     1741       assign
     1742         v-inform = bh_tbl-name:index-information(1)
     1743         v-ind    = 2
     1744       .
     1745       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1746       on error undo, return error
     1747       :
     1748         assign
     1749           v-inform = bh_tbl-name:index-information( v-ind )
     1750           v-ind    = v-ind + 1
     1751         .
     1752       end.
     1753       if v-inform = ?
     1754         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1755         or entry( 3, v-inform, ",":U ) <> "1":U
     1756       then do:
     1757         delete object bh_tbl-name no-error.
     1758         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info14, v-tbl-name ).
     1759       end.
     1760       assign
     1761         v-idx-field-qnty = num-entries( v-inform ) - 4
     1762       .
     1763       if v-idx-field-qnty < 2 then do:
     1764         delete object bh_tbl-name no-error.
     1765         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info14, v-inform, v-tbl-name ).
     1766       end.
     1767       assign
     1768         p-field-list = "":U
     1769         p-value-list = "":U
     1770         v-delim-key  = "":U
     1771         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1772         v-count-fld  = 0
     1773       .
     1774       block_where:
     1775       do v-ind = 1 to v-idx-field-qnty by 2
     1776       on error undo, return error
     1777       :
     1778         assign
     1779           v-count-fld = v-count-fld + 1
     1780         .
     1781         if v-count-fld > v-field-num then do:
     1782           leave block_where.
     1783         end.
     1784         assign
     1785           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1786           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1787         .
     1788         if v-ind = 1 then do:
     1789           assign
     1790             v-delim-key = chr(3)
     1791           .
     1792         end.
     1793       end.
     1794       delete object bh_tbl-name.
     1795       if v-count-fld <> v-field-num then do:
     1796         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info14, v-tbl-name ).
     1797       end.
     1798     end.
     1799   end procedure.
     1800   procedure gen-key-field :
     1801     define input  parameter p-table      as character no-undo .
     1802     define output parameter p-field-list as character no-undo .
     1803     do
     1804     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1805     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1806     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1807     :
     1808       define variable v-full-tbl-name  as character no-undo .
     1809       define variable bh_tbl-name      as handle    no-undo .
     1810       define variable v-tbl-name       as character no-undo .
     1811       define variable v-field-num      as integer   no-undo .
     1812       define variable v-count-fld      as integer   no-undo .
     1813       define variable v-inform         as character no-undo .
     1814       define variable v-ind            as integer   no-undo .
     1815       define variable v-idx-field-qnty as integer   no-undo .
     1816       define variable v-delim-key      as character no-undo .
     1817       if p-table = ?
     1818         or p-table = "":U
     1819       then do:
     1820         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info14 ).
     1821       end.
     1822       assign
     1823         v-tbl-name      = p-table
     1824         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1825       .
     1826       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1827       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info14 ).
     1828       assign
     1829         v-inform = bh_tbl-name:index-information(1)
     1830         v-ind    = 2
     1831       .
     1832       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1833       on error undo, return error
     1834       :
     1835         assign
     1836           v-inform = bh_tbl-name:index-information( v-ind )
     1837           v-ind    = v-ind + 1
     1838         .
     1839       end.
     1840       if v-inform = ?
     1841         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1842         or entry( 3, v-inform, ",":U ) <> "1":U
     1843       then do:
     1844         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info14, v-tbl-name ).
     1845       end.
     1846       assign
     1847         v-idx-field-qnty = num-entries( v-inform ) - 4
     1848       .
     1849       if v-idx-field-qnty < 2 then do:
     1850         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info14, v-inform, v-tbl-name ).
     1851       end.
     1852       assign
     1853         p-field-list = "":U
     1854         v-delim-key  = "":U
     1855         v-count-fld  = 0
     1856       .
     1857       block_where:
     1858       do v-ind = 1 to v-idx-field-qnty by 2
     1859       on error undo, return error
     1860       :
     1861         assign
     1862           v-count-fld = v-count-fld + 1
     1863         .
     1864         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1865         if v-ind = 1 then do:
     1866           assign
     1867             v-delim-key = chr(3)
     1868           .
     1869         end.
     1870       end.
     1871       delete object bh_tbl-name.
     1872     end.
     1873   end procedure.
     1874   define variable filter-label as character no-undo init "Список истории раскладок" .
     1875   define variable filter-label0 as character no-undo init "Список истории раскладок" .
     1876   define variable filter-point as character no-undo init "clayouts" .
     1877   define variable filter-point0 as character no-undo init "clayouts" .
     1878   define variable sort-column-name as character no-undo .
     1879   define variable print-option as character no-undo.
     1880   define variable glog as logical no-undo .
     1881   define variable v-doc-rec as recid no-undo .
     1882   define variable v-rid-list as character no-undo .
     1883   FUNCTION get-action RETURNS CHARACTER
     1884     ( p-action as integer )  FORWARD.
     1885   FUNCTION get-is-default-name RETURNS CHARACTER
     1886     ( p-is-default as integer )  FORWARD.
     1887   FUNCTION get-is-mandatory-name RETURNS CHARACTER
     1888     ( p-is-mandatory as integer )  FORWARD.
     1889   FUNCTION get-layout-type-name RETURNS CHARACTER
     1890     ( input p-layout-type as character )  FORWARD.
     1891   FUNCTION get-status-name RETURNS CHARACTER
     1892     ( input p-sts as integer )  FORWARD.
     1893   DEFINE BUTTON B-Help
     1894        LABEL "Помо&щь"
     1895        SIZE 3 BY 1
     1896        BGCOLOR 8 .
     1897   DEFINE BUTTON B-lkp
     1898        LABEL "&Просмотр"
     1899        SIZE 10 BY 1.
     1900   DEFINE BUTTON B-mark
     1901        LABEL "&*"
     1902        SIZE 3 BY 1.
     1903   DEFINE BUTTON b-quit AUTO-END-KEY
     1904        LABEL "&Выход"
     1905        SIZE 10 BY 1
     1906        BGCOLOR 8 .
     1907   DEFINE BUTTON B-sch
     1908        LABEL "&Фильтр"
     1909        SIZE 3 BY 1.
     1910   DEFINE BUTTON b-sel AUTO-GO
     1911        LABEL "Вы&бор"
     1912        SIZE 10 BY 1
     1913        BGCOLOR 8 .
     1914   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1915         VIEW-AS TEXT
     1916        SIZE 6 BY 1
     1917        FGCOLOR 4  NO-UNDO.
     1918   DEFINE QUERY BR-changes FOR
     1919         temp-changes SCROLLING.
     1920   DEFINE QUERY BR-docs FOR X_c-layout SCROLLING.
     1921   DEFINE BROWSE BR-changes
     1922     QUERY BR-changes DISPLAY
     1923         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(255)" WIDTH 50
     1924   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1925   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1926       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 8.5.
     1927   DEFINE BROWSE BR-docs
     1928     QUERY BR-docs DISPLAY
     1929         mark-string(RECID( X_c-layout), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1930         X_c-layout.corr-date COLUMN-LABEL "Дата корр" FORMAT "99/99/9999":U
     1931         string(X_c-layout.corr-time, "HH:MM")
     1932         X_c-layout.corr-user-db-num FORMAT ">>>>9":U
     1933         usrfulnf(X_c-layout.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1934         get-action(X_c-layout.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1935         X_c-layout.layout-id COLUMN-LABEL "ID" FORMAT "X(15)":U
     1936     ENABLE
     1937         X_c-layout.layout-id
     1938       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.03.
     1939   DEFINE FRAME Dialog-Frame
     1940        b-quit AT ROW 1 COL 1
     1941        B-mark AT ROW 1 COL 11
     1942        b-sel AT ROW 1 COL 21
     1943        B-lkp AT ROW 1 COL 41
     1944        B-sch AT ROW 1 COL 92
     1945        B-Help AT ROW 1 COL 95
     1946        BR-docs AT ROW 2.67 COL 1
     1947        BR-changes AT ROW 12 COL 1
     1948        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1949        SPACE(78.50) SKIP(18.67)
     1950       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1951            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1952            TITLE ""
     1953            CANCEL-BUTTON b-quit.
     1954   ASSIGN
     1955          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1956          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1957   ON GO OF FRAME Dialog-Frame
     1958   DO:
     1959     p-rid-list = v-rid-list.
     1960   END.
     1961   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1962   DO:
     1963     APPLY "END-ERROR":U TO SELF.
     1964   END.
     1965   ON CHOOSE OF B-lkp IN FRAME Dialog-Frame
     1966   DO:
     1967     run proc-b-lkp IN THIS-PROCEDURE NO-ERROR.
     1968     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1969   END.
     1970   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1971   DO:
     1972     if available X_c-layout then do:
     1973   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1974   define variable v-str-recid16 as character no-undo .
     1975   define variable v-num-entry16 as integer   no-undo .
     1976   assign
     1977     v-str-recid16 = trim( string( recid( X_c-layout ) , "->>>>>>>>>>>9":U ) )
     1978     v-num-entry16 = lookup( v-str-recid16 , v-rid-list )
     1979   .
     1980   if v-num-entry16 > 0 then do:
     1981     assign
     1982       entry( v-num-entry16, v-rid-list ) = "":U
     1983       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1984     .
     1985   end.
     1986   else do:
     1987     assign
     1988       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid16
     1989     .
     1990   end.
     1991       glog = br-docs:refresh() .
     1992       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1993           glog = br-docs:select-next-row ().
     1994           apply "VALUE-CHANGED" to br-docs in frame Dialog-Frame.
     1995       end.
     1996       if num-entries( v-rid-list ) = 0
     1997       then
     1998           hide mark-num in frame Dialog-Frame.
     1999       else
     2000           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     2001     end.
     2002     apply "entry" to br-docs in frame Dialog-Frame.
     2003   END.
     2004   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     2005   DO:
     2006     run proc-b-sch in this-procedure no-error.
     2007     if error-status:error then return no-apply.
     2008   END.
     2009   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     2010   DO:
     2011     if ( available X_c-layout ) AND
     2012     ( v-rid-list = ""
     2013     or
     2014     b-mark:sensitive = no
     2015     ) then
     2016       v-rid-list = string( recid( X_c-layout ) ) .
     2017   END.
     2018   ON DELETE-CHARACTER OF BR-docs IN FRAME Dialog-Frame
     2019   DO:
     2020     if b-mark:sensitive in frame Dialog-Frame then
     2021     APPLY "CHOOSE" to b-mark.
     2022   END.
     2023   ON INSERT-MODE OF BR-docs IN FRAME Dialog-Frame
     2024   DO:
     2025     if b-mark:sensitive in frame Dialog-Frame then
     2026     APPLY "CHOOSE" to b-mark.
     2027       else do:
     2028         if b-sel:sensitive in frame Dialog-Frame then
     2029         APPLY "CHOOSE" to b-sel.
     2030       end.
     2031   END.
     2032   ON RETURN OF BR-docs IN FRAME Dialog-Frame
     2033   OR MOUSE-SELECT-DBLCLICK OF BR-docs IN FRAME Dialog-Frame
     2034   DO:
     2035   if b-sel:sensitive in frame Dialog-Frame then dO:
     2036       if b-mark:sensitive then do:
     2037           apply "choose" to b-mark in frame Dialog-Frame.
     2038       end.
     2039       else do:
     2040           apply "choose" to b-sel in frame Dialog-Frame.
     2041       end.
     2042   end.
     2043   END.
     2044   ON VALUE-CHANGED OF BR-docs IN FRAME Dialog-Frame
     2045   DO:
     2046     run proc-view-changes in this-procedure .
     2047   END.
     2048   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2049   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2050   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2051   on help of frame Dialog-Frame
     2052   do:
     2053     run gbl/app_help.p
     2054       (input this-procedure :file-name
     2055       ,input ''
     2056       ,input ?
     2057       ) no-error.
     2058     if error-status :error then do:
     2059       message
     2060         "Ошибка при вызове помощи"
     2061         error-status :get-message(1)
     2062         view-as alert-box .
     2063     end.
     2064   end.
     2065   run minbtn-set in this-procedure .
     2066   on choose of b-help in frame Dialog-Frame
     2067   do:
     2068     apply "help":u to frame Dialog-Frame .
     2069   end.
     2070   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2071   procedure minbtn-set :
     2072       do
     2073           on error undo, return error return-value
     2074           :
     2075           define variable ii              as integer       no-undo .
     2076           define variable fh              as widget-handle no-undo .
     2077           define variable hh              as widget-handle no-undo .
     2078           define variable v-h             as handle        extent 4 no-undo .
     2079           define variable v-name-button   as character     no-undo .
     2080           define variable v-help-old-x    as decimal       no-undo .
     2081           define variable v-help-old-y    as decimal       no-undo .
     2082           define variable v-help-old-size as decimal       no-undo .
     2083           define variable v-frame-width   as decimal       no-undo .
     2084           define variable jj              as integer       no-undo .
     2085           do
     2086               on error undo, return error
     2087               :
     2088               assign
     2089                   v-frame-width = frame Dialog-Frame:width - 0.3
     2090                   fh            = frame Dialog-Frame:first-child
     2091                   hh            = fh:first-child
     2092                   ii            = 1
     2093                   .
     2094               do while valid-handle(hh):
     2095                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2096                   do:
     2097                       case lc(hh:name) :
     2098                           when "b-help" then
     2099                               do:
     2100                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2101                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2102                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2103                                   hh:TOOLTIP = "Помощь" .
     2104                                   v-help-old-x = hh:column .
     2105                                   v-help-old-y = hh:row    .
     2106                                   v-help-old-size = hh:width .
     2107                                   hh:width-chars = 2.5 .
     2108                               end.
     2109                           when "b-print" then
     2110                               do:
     2111                                   hh:load-image("cmp/b-print.bmp":u) .
     2112                                   hh:TOOLTIP = "Печать" .
     2113                                   v-h[ii] = hh:handle .
     2114                                   ii = ii + 1 .
     2115                                   hh:width-chars = 3 .
     2116                               end.
     2117                           when "b-history" or
     2118                           when "b-hist" then
     2119                               do:
     2120                                   hh:load-image("cmp/b-hist.bmp":u) .
     2121                                   hh:TOOLTIP = "История" .
     2122                                   v-h[ii] = hh:handle .
     2123                                   ii = ii + 1 .
     2124                                   hh:width-chars = 3 .
     2125                               end.
     2126                           when "b-sch" then
     2127                               do:
     2128                                   hh:load-image("cmp/b-sch.bmp":u) .
     2129                                   hh:TOOLTIP = "Установка Фильтра" .
     2130                                   v-h[ii] = hh:handle .
     2131                                   ii = ii + 1 .
     2132                                   hh:width-chars = 3 .
     2133                               end.
     2134                           when "b-hist-user" then
     2135                               do:
     2136                                   hh:load-image("cmp/b-hist.bmp":u) .
     2137                                   hh:TOOLTIP = "История пользователя" .
     2138                                   ii = ii + 1 .
     2139                               end.
     2140                       end case.
     2141                   end.
     2142                   hh = hh:next-sibling.
     2143               end.
     2144               b-help:column = v-frame-width - b-help:width-chars.
     2145               jj = 0.
     2146               repeat ii = 4 to 1 by -1 :
     2147                   if valid-handle (v-h[ii] ) then
     2148                   do:
     2149                       jj  = jj + 1 .
     2150                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2151                       v-h[ii]:row    = v-help-old-y .
     2152                   end.
     2153               end.
     2154           end.
     2155       end.
     2156   end procedure.
     2157   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2158   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2159   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2160   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2161   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2162   define variable v-diasize-current-frame-height as decimal   no-undo .
     2163   define variable v-diasize-change-size          as logical   no-undo .
     2164   define variable v-diasize-resize-button        as handle    no-undo .
     2165   define variable v-diasize-wndmax               as logical   no-undo .
     2166   define variable v-diasize-wndstore             as logical   no-undo .
     2167   define variable v-diasize-proc-name            as character no-undo .
     2168   define variable v-diasize-browse-handle        as handle    no-undo .
     2169   define variable v-diasize-browse-number        as integer   no-undo .
     2170   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2171   define temp-table temp-diasize-handle no-undo
     2172     field handle-value  as handle
     2173     field save-position as decimal
     2174     index xpk is primary unique handle-value
     2175     .
     2176   define temp-table temp-browse-handle no-undo
     2177     field browse-type   as character
     2178     field browse-number as integer
     2179     field browse-handle as handle
     2180     field original-size as decimal
     2181     index xpk is primary unique browse-type browse-number
     2182     index xie browse-type browse-handle
     2183   .
     2184   procedure diasize_change-height :
     2185     define input  parameter p-change-value  as decimal   no-undo .
     2186     define input  parameter p-move-resize   as logical   no-undo .
     2187     define variable v-field-group-handle    as handle    no-undo .
     2188     define variable v-object-handle         as handle    no-undo .
     2189     define variable v-frame-height          as decimal   no-undo .
     2190     define variable v-frame-virtual-height  as decimal   no-undo .
     2191     define variable v-browse-height         as decimal   no-undo .
     2192     define variable v-window-height         as decimal   no-undo .
     2193     define variable v-window-virtual-height as decimal   no-undo .
     2194     define variable v-change-sign           as integer   no-undo .
     2195     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2196     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2197     if p-change-value > 0
     2198     then do:
     2199       if frame Dialog-Frame :height + p-change-value
     2200           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2201       then do:
     2202         assign
     2203           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2204                           - (frame Dialog-Frame :height-chars)
     2205         .
     2206         if p-change-value <= 0
     2207         then do:
     2208           run diasize_position-resize-button in this-procedure .
     2209           return .
     2210         end.
     2211       end.
     2212     end.
     2213     if p-change-value < 0
     2214     then do:
     2215       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2216       then do:
     2217         assign
     2218           p-change-value = v-diasize-orig-frame-height
     2219                          - (frame Dialog-Frame :height-chars)
     2220         .
     2221         if p-change-value >= 0
     2222         then do:
     2223           run diasize_position-resize-button in this-procedure .
     2224           return .
     2225         end.
     2226       end.
     2227     end.
     2228     if p-change-value >= 0
     2229     then do:
     2230       assign
     2231         v-change-sign = 1
     2232       .
     2233     end.
     2234     else do:
     2235       assign
     2236         v-change-sign = -1
     2237       .
     2238     end.
     2239     assign
     2240       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2241     .
     2242     if p-change-value = 0
     2243     then do:
     2244       run diasize_position-resize-button in this-procedure .
     2245       return .
     2246     end.
     2247     move_block:
     2248     do
     2249     on error undo move_block, retry move_block
     2250     :
     2251       if retry
     2252       then do:
     2253         do
     2254         on error undo move_block, leave move_block
     2255         :
     2256           if p-change-value > 0
     2257           then do:
     2258             for each buf_temp-diasize-handle
     2259             on error undo, next
     2260             :
     2261               assign
     2262                 v-object-handle = buf_temp-diasize-handle.handle-value
     2263               .
     2264               if v-object-handle <> v-diasize-resize-button
     2265               then do:
     2266                 assign
     2267                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2268                 .
     2269               end.
     2270             end.
     2271             assign
     2272               v-diasize-browse-handle :height = v-browse-height
     2273             .
     2274             for each buf_temp-browse-handle
     2275               where buf_temp-browse-handle.browse-type = 'height':u
     2276             on error undo, next
     2277             :
     2278               assign
     2279                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2280               .
     2281             end.
     2282             assign
     2283               frame Dialog-Frame :height = v-frame-height
     2284             .
     2285             if frame Dialog-Frame :scrollable = true
     2286             then do:
     2287               assign
     2288                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2289               .
     2290             end.
     2291             run diasize_position-resize-button in this-procedure .
     2292           end.
     2293           else do:
     2294             if frame Dialog-Frame :scrollable = true
     2295             then do:
     2296               assign
     2297                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2298               .
     2299             end.
     2300             assign
     2301               frame Dialog-Frame :height = v-frame-height
     2302             .
     2303             assign
     2304               v-diasize-browse-handle :height = v-browse-height
     2305             .
     2306             for each buf_temp-browse-handle
     2307               where buf_temp-browse-handle.browse-type = 'height':u
     2308             on error undo, next
     2309             :
     2310               assign
     2311                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2312               .
     2313             end.
     2314             for each buf_temp-diasize-handle
     2315             on error undo, next
     2316             :
     2317               assign
     2318                 v-object-handle = buf_temp-diasize-handle.handle-value
     2319               .
     2320               if v-object-handle <> v-diasize-resize-button
     2321               then do:
     2322                 assign
     2323                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2324                 .
     2325               end.
     2326             end.
     2327             run diasize_position-resize-button in this-procedure .
     2328           end.
     2329           assign
     2330             v-diasize-change-size = false
     2331           .
     2332           leave move_block .
     2333         end.
     2334       end.
     2335       assign
     2336         v-diasize-need-full-display = true
     2337       .
     2338       if v-diasize-change-size = false
     2339       then do:
     2340         assign
     2341           v-diasize-change-size = true
     2342         .
     2343       end.
     2344       else do:
     2345         return .
     2346       end.
     2347       assign
     2348         v-frame-height = frame Dialog-Frame :height
     2349         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2350         v-browse-height = v-diasize-browse-handle :height
     2351       .
     2352       for each buf_temp-browse-handle
     2353         where buf_temp-browse-handle.browse-type = 'height':u
     2354       :
     2355         assign
     2356           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2357         .
     2358       end.
     2359       for each buf_temp-diasize-handle
     2360       :
     2361         delete buf_temp-diasize-handle .
     2362       end.
     2363       assign
     2364         v-field-group-handle = frame Dialog-Frame :first-child
     2365       .
     2366       do while valid-handle(v-field-group-handle)
     2367       :
     2368         assign
     2369           v-object-handle = v-field-group-handle :first-child
     2370         .
     2371         do while valid-handle(v-object-handle)
     2372         :
     2373           if  v-object-handle <> v-diasize-browse-handle :handle
     2374           and can-query(v-object-handle, "row")
     2375           and can-query(v-object-handle, "height")
     2376           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2377           then do:
     2378             find first buf_temp-browse-handle
     2379               where buf_temp-browse-handle.browse-type   = 'height':u
     2380                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2381               no-error .
     2382             if available buf_temp-browse-handle
     2383             then do:
     2384             end.
     2385             else do:
     2386               create buf_temp-diasize-handle .
     2387               assign
     2388                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2389                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2390               .
     2391             end.
     2392           end.
     2393           assign
     2394             v-object-handle = v-object-handle :next-sibling
     2395           .
     2396         end.
     2397         assign
     2398           v-field-group-handle = v-field-group-handle :next-sibling
     2399         .
     2400       end.
     2401       do with frame Dialog-Frame
     2402       :
     2403         hide v-diasize-resize-button .
     2404         assign
     2405           v-diasize-resize-button :row    = 1
     2406           v-diasize-resize-button :column = 1
     2407         .
     2408       end.
     2409       if p-change-value > 0
     2410       then do:
     2411         if frame Dialog-Frame :scrollable = true
     2412         then do:
     2413           assign
     2414             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2415             no-error .
     2416           if error-status :error
     2417           or error-status :get-message(1) <> ""
     2418           then do:
     2419             undo move_block, retry move_block .
     2420           end.
     2421         end.
     2422         assign
     2423           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2424           no-error .
     2425         if error-status :error
     2426         or error-status :get-message(1) <> ""
     2427         then do:
     2428           undo move_block, retry move_block .
     2429         end.
     2430         assign
     2431           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2432           no-error .
     2433         if error-status :error
     2434         or error-status :get-message(1) <> ""
     2435         then do:
     2436           undo move_block, retry move_block .
     2437         end.
     2438         for each buf_temp-browse-handle
     2439           where buf_temp-browse-handle.browse-type = 'height':u
     2440         on error undo move_block, retry move_block
     2441         :
     2442           assign
     2443             buf_temp-browse-handle.browse-handle :height
     2444               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2445             no-error .
     2446           if error-status :error
     2447           or error-status :get-message(1) <> ""
     2448           then do:
     2449             undo move_block, retry move_block .
     2450           end.
     2451         end.
     2452         for each buf_temp-diasize-handle
     2453         on error undo move_block, retry move_block
     2454         :
     2455           assign
     2456             v-object-handle = buf_temp-diasize-handle.handle-value
     2457           .
     2458           if v-object-handle <> v-diasize-resize-button
     2459           then do:
     2460             assign
     2461               v-object-handle :row = v-object-handle :row + p-change-value
     2462               no-error .
     2463             if error-status :error
     2464             or error-status :get-message(1) <> ""
     2465             then do:
     2466               undo move_block, retry move_block .
     2467             end.
     2468           end.
     2469         end.
     2470       end.
     2471       else do:
     2472         for each buf_temp-diasize-handle
     2473         on error undo move_block, retry move_block
     2474         :
     2475           assign
     2476             v-object-handle = buf_temp-diasize-handle.handle-value
     2477           .
     2478           if v-object-handle <> v-diasize-resize-button
     2479           then do:
     2480             assign
     2481               v-object-handle :row = v-object-handle :row + p-change-value
     2482               no-error .
     2483             if error-status :error
     2484             or error-status :get-message(1) <> ""
     2485             then do:
     2486               undo move_block, retry move_block .
     2487             end.
     2488           end.
     2489         end.
     2490         assign
     2491           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2492           no-error .
     2493         if error-status :error
     2494         or error-status :get-message(1) <> ""
     2495         then do:
     2496           undo move_block, retry move_block .
     2497         end.
     2498         for each buf_temp-browse-handle
     2499           where buf_temp-browse-handle.browse-type = 'height':u
     2500         on error undo move_block, retry move_block
     2501         :
     2502           assign
     2503             buf_temp-browse-handle.browse-handle :height
     2504               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2505             no-error .
     2506           if error-status :error
     2507           or error-status :get-message(1) <> ""
     2508           then do:
     2509             undo move_block, retry move_block .
     2510           end.
     2511         end.
     2512         assign
     2513           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2514           no-error .
     2515         if error-status :error
     2516         or error-status :get-message(1) <> ""
     2517         then do:
     2518           undo move_block, retry move_block .
     2519         end.
     2520         if frame Dialog-Frame :scrollable = true
     2521         then do:
     2522           assign
     2523             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2524             no-error .
     2525           if error-status :error
     2526           or error-status :get-message(1) <> ""
     2527           then do:
     2528             undo move_block, retry move_block .
     2529           end.
     2530         end.
     2531       end.
     2532       if p-move-resize = true
     2533       then do:
     2534         run diasize_position-resize-button in this-procedure .
     2535       end.
     2536       if v-diasize-wndstore = true
     2537       then do:
     2538         if connected("ub") = true
     2539         then do:
     2540           define variable v-cntxt-db-num        as integer   no-undo .
     2541           define variable v-cntxt-userid        as character no-undo .
     2542           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2543                                             , OUTPUT v-cntxt-userid
     2544                                             ) .
     2545           run gbl/wndsizew.p
     2546             (input  v-cntxt-db-num
     2547             ,input  v-cntxt-userid
     2548             ,input  v-diasize-proc-name
     2549             ,input  'height':u
     2550             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2551             ) .
     2552         end.
     2553       end.
     2554     end.
     2555     assign
     2556       v-diasize-change-size = false
     2557     .
     2558   end procedure.
     2559   procedure diasize_set-height :
     2560     define input  parameter p-new-height  as decimal   no-undo .
     2561     define input  parameter p-move-resize as logical   no-undo .
     2562     do
     2563     on error undo, return error return-value
     2564     :
     2565       run diasize_change-height in this-procedure
     2566         (input  (p-new-height - frame Dialog-Frame :height)
     2567         ,input  p-move-resize
     2568         ) .
     2569     end.
     2570   end procedure.
     2571   procedure diasize_change-width :
     2572     define input  parameter p-change-value as decimal   no-undo .
     2573     define input  parameter p-move-resize  as logical   no-undo .
     2574     define variable v-field-group-handle   as handle    no-undo .
     2575     define variable v-object-handle        as handle    no-undo .
     2576     define variable v-frame-width          as decimal   no-undo .
     2577     define variable v-frame-virtual-width  as decimal   no-undo .
     2578     define variable v-browse-width         as decimal   no-undo .
     2579     define variable v-window-width         as decimal   no-undo .
     2580     define variable v-window-virtual-width as decimal   no-undo .
     2581     define variable v-change-sign          as integer   no-undo .
     2582     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2583     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2584     if p-change-value > 0
     2585     then do:
     2586       if frame Dialog-Frame :width + p-change-value >
     2587           session :width-chars
     2588       then do:
     2589         assign
     2590           p-change-value = session :width-chars - frame Dialog-Frame :width
     2591         .
     2592         if p-change-value <= 0
     2593         then do:
     2594           run diasize_position-resize-button in this-procedure .
     2595           return .
     2596         end.
     2597       end.
     2598     end.
     2599     if p-change-value < 0
     2600     then do:
     2601       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2602       then do:
     2603         assign
     2604           p-change-value = v-diasize-orig-frame-width
     2605                          - frame Dialog-Frame :width
     2606         .
     2607         if p-change-value >= 0
     2608         then do:
     2609           run diasize_position-resize-button in this-procedure .
     2610           return .
     2611         end.
     2612       end.
     2613     end.
     2614     if p-change-value >= 0
     2615     then do:
     2616       assign
     2617         v-change-sign = 1
     2618       .
     2619     end.
     2620     else do:
     2621       assign
     2622         v-change-sign = -1
     2623       .
     2624     end.
     2625     assign
     2626       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2627     .
     2628     if p-change-value = 0
     2629     then do:
     2630       run diasize_position-resize-button in this-procedure .
     2631       return .
     2632     end.
     2633     move_block:
     2634     do
     2635     on error undo move_block, leave move_block
     2636     :
     2637       if retry
     2638       then do:
     2639         do
     2640         on error undo move_block, leave move_block
     2641         :
     2642           if p-change-value > 0
     2643           then do:
     2644             for each buf_temp-diasize-handle
     2645             on error undo, next
     2646             :
     2647               assign
     2648                 v-object-handle = buf_temp-diasize-handle.handle-value
     2649               .
     2650               if v-object-handle <> v-diasize-resize-button
     2651               then do:
     2652                 assign
     2653                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2654                 .
     2655               end.
     2656             end.
     2657             assign
     2658               v-diasize-browse-handle :width = v-browse-width
     2659             .
     2660             for each buf_temp-browse-handle
     2661               where buf_temp-browse-handle.browse-type = 'width':u
     2662             on error undo, next
     2663             :
     2664               assign
     2665                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2666               .
     2667             end.
     2668             assign
     2669               frame Dialog-Frame :width = v-frame-width
     2670             .
     2671             if frame Dialog-Frame :scrollable = true
     2672             then do:
     2673               assign
     2674                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2675               .
     2676             end.
     2677             run diasize_position-resize-button in this-procedure .
     2678           end.
     2679           else do:
     2680             if frame Dialog-Frame :scrollable = true
     2681             then do:
     2682               assign
     2683                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2684               .
     2685             end.
     2686             assign
     2687               frame Dialog-Frame :width = v-frame-width
     2688             .
     2689             for each buf_temp-browse-handle
     2690               where buf_temp-browse-handle.browse-type = 'width':u
     2691             on error undo, next
     2692             :
     2693               assign
     2694                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2695               .
     2696             end.
     2697             assign
     2698               v-diasize-browse-handle :width = v-browse-width
     2699             .
     2700             for each buf_temp-diasize-handle
     2701             on error undo, next
     2702             :
     2703               assign
     2704                 v-object-handle = buf_temp-diasize-handle.handle-value
     2705               .
     2706               if v-object-handle <> v-diasize-resize-button
     2707               then do:
     2708                 assign
     2709                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2710                 .
     2711               end.
     2712             end.
     2713             run diasize_position-resize-button in this-procedure .
     2714           end.
     2715           assign
     2716             v-diasize-change-size = false
     2717           .
     2718           leave move_block .
     2719         end.
     2720       end.
     2721       assign
     2722         v-diasize-need-full-display = true
     2723       .
     2724       if v-diasize-change-size = false
     2725       then do:
     2726         assign
     2727           v-diasize-change-size = true
     2728         .
     2729       end.
     2730       else do:
     2731         return .
     2732       end.
     2733       assign
     2734         v-frame-width = frame Dialog-Frame :width
     2735         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2736         v-browse-width = v-diasize-browse-handle :width
     2737       .
     2738       for each buf_temp-browse-handle
     2739         where buf_temp-browse-handle.browse-type = 'width':u
     2740       :
     2741         assign
     2742           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2743         .
     2744       end.
     2745       for each buf_temp-diasize-handle
     2746       :
     2747         delete buf_temp-diasize-handle .
     2748       end.
     2749       assign
     2750         v-field-group-handle = frame Dialog-Frame :first-child
     2751       .
     2752       do while valid-handle(v-field-group-handle)
     2753       :
     2754         assign
     2755           v-object-handle = v-field-group-handle :first-child
     2756         .
     2757         do while valid-handle(v-object-handle)
     2758         :
     2759           if  v-object-handle <> v-diasize-browse-handle :handle
     2760           and v-object-handle <> v-diasize-resize-button
     2761           and can-query(v-object-handle, "row")
     2762           and can-query(v-object-handle, "height")
     2763           and ( v-object-handle :col + v-object-handle :width
     2764                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2765               )
     2766           then do:
     2767             find first buf_temp-browse-handle
     2768               where buf_temp-browse-handle.browse-type   = 'width':u
     2769                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2770               no-error .
     2771             if available buf_temp-browse-handle
     2772             then do:
     2773             end.
     2774             else do:
     2775               create buf_temp-diasize-handle .
     2776               assign
     2777                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2778                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2779               .
     2780             end.
     2781           end.
     2782           assign
     2783             v-object-handle = v-object-handle :next-sibling
     2784           .
     2785         end.
     2786         assign
     2787           v-field-group-handle = v-field-group-handle :next-sibling
     2788         .
     2789       end.
     2790       do with frame Dialog-Frame
     2791       :
     2792         hide v-diasize-resize-button .
     2793         v-diasize-resize-button :row = 1.
     2794         v-diasize-resize-button :column = 1.
     2795       end.
     2796       if p-change-value > 0
     2797       then do:
     2798         if frame Dialog-Frame :scrollable = true
     2799         then do:
     2800           assign
     2801             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2802             no-error .
     2803           if error-status :error
     2804           or error-status :get-message(1) <> ""
     2805           then do:
     2806             undo move_block, retry move_block.
     2807           end.
     2808         end.
     2809         assign
     2810           frame Dialog-Frame :width = v-frame-width + p-change-value
     2811           no-error .
     2812         if error-status :error
     2813         or error-status :get-message(1) <> ""
     2814         then do:
     2815           undo move_block, retry move_block.
     2816         end.
     2817         assign
     2818           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2819         no-error .
     2820         if error-status :error
     2821         or error-status :get-message(1) <> ""
     2822         then do:
     2823           undo move_block, retry move_block.
     2824         end.
     2825         for each buf_temp-browse-handle
     2826           where buf_temp-browse-handle.browse-type = 'width':u
     2827         on error undo move_block, retry move_block
     2828         :
     2829           assign
     2830             buf_temp-browse-handle.browse-handle :width
     2831               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2832             no-error .
     2833           if error-status :error
     2834           or error-status :get-message(1) <> ""
     2835           then do:
     2836             undo move_block, retry move_block .
     2837           end.
     2838         end.
     2839         for each buf_temp-diasize-handle
     2840         on error undo move_block, retry move_block
     2841         :
     2842           assign
     2843             v-object-handle = buf_temp-diasize-handle.handle-value
     2844           .
     2845           if v-object-handle <> v-diasize-resize-button
     2846           then do:
     2847             assign
     2848               v-object-handle :col = v-object-handle :col + p-change-value
     2849               no-error .
     2850             if error-status :error
     2851             or error-status :get-message(1) <> ""
     2852             then do:
     2853               undo move_block, retry move_block .
     2854             end.
     2855           end.
     2856         end.
     2857       end.
     2858       else do:
     2859         for each buf_temp-diasize-handle
     2860         on error undo move_block, retry move_block
     2861         :
     2862           assign
     2863             v-object-handle = buf_temp-diasize-handle.handle-value
     2864           .
     2865           if v-object-handle <> v-diasize-resize-button
     2866           then do:
     2867             assign
     2868               v-object-handle :col = v-object-handle :col + p-change-value
     2869               no-error .
     2870             if error-status :error
     2871             or error-status :get-message(1) <> ""
     2872             then do:
     2873               undo move_block, retry move_block .
     2874             end.
     2875           end.
     2876         end.
     2877         for each buf_temp-browse-handle
     2878           where buf_temp-browse-handle.browse-type = 'width':u
     2879         on error undo move_block, retry move_block
     2880         :
     2881           assign
     2882             buf_temp-browse-handle.browse-handle :width
     2883               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2884             no-error .
     2885           if error-status :error
     2886           or error-status :get-message(1) <> ""
     2887           then do:
     2888             undo move_block, retry move_block .
     2889           end.
     2890         end.
     2891         assign
     2892           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2893           no-error .
     2894         if error-status :error
     2895         or error-status :get-message(1) <> ""
     2896         then do:
     2897           undo move_block, retry move_block.
     2898         end.
     2899         assign
     2900           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2901         no-error .
     2902         if error-status :error
     2903         or error-status :get-message(1) <> ""
     2904         then do:
     2905           undo move_block, retry move_block.
     2906         end.
     2907         if frame Dialog-Frame :scrollable = true
     2908         then do:
     2909           assign
     2910             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2911           no-error .
     2912           if error-status :error
     2913           or error-status :get-message(1) <> ""
     2914           then do:
     2915             undo move_block, retry move_block.
     2916           end.
     2917         end.
     2918       end.
     2919       if p-move-resize
     2920       then do:
     2921         run diasize_position-resize-button in this-procedure .
     2922       end.
     2923       if v-diasize-wndstore = true
     2924       then do:
     2925         if connected("ub") = true
     2926         then do:
     2927           define variable v-cntxt-db-num        as integer   no-undo .
     2928           define variable v-cntxt-userid        as character no-undo .
     2929           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2930                                             , OUTPUT v-cntxt-userid
     2931                                             ) .
     2932           run gbl/wndsizew.p
     2933             (input  v-cntxt-db-num
     2934             ,input  v-cntxt-userid
     2935             ,input  v-diasize-proc-name
     2936             ,input  'width':u
     2937             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2938             ) .
     2939         end.
     2940       end.
     2941     end.
     2942     assign
     2943       v-diasize-change-size = false
     2944     .
     2945   end procedure.
     2946   procedure diasize_set-width :
     2947     define input  parameter p-new-width  as decimal   no-undo .
     2948     define input  parameter p-move-resize as logical   no-undo .
     2949     do
     2950     on error undo, return error return-value
     2951     :
     2952       run diasize_change-width in this-procedure
     2953         (input  (p-new-width - frame Dialog-Frame :width)
     2954         ,input  p-move-resize
     2955         ) .
     2956     end.
     2957   end procedure.
     2958   procedure diasize_position-resize-button :
     2959     do with frame Dialog-Frame
     2960     :
     2961       hide v-diasize-resize-button .
     2962       assign
     2963         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2964                     - 1
     2965                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2966         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2967                     - 1
     2968                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2969       .
     2970       view v-diasize-resize-button .
     2971     end.
     2972   end procedure.
     2973   on alt-right anywhere
     2974   do:
     2975     run diasize_change-width in this-procedure
     2976       (input 1
     2977       ,input true
     2978       ) .
     2979     return no-apply .
     2980   end.
     2981   on alt-left anywhere
     2982   do:
     2983     run diasize_change-width in this-procedure
     2984       (input -1
     2985       ,input true
     2986       ) .
     2987     return no-apply .
     2988   end.
     2989   on alt-down anywhere
     2990   do:
     2991     run diasize_change-height in this-procedure
     2992       (input 1
     2993       ,input true
     2994       ) .
     2995     return no-apply .
     2996   end.
     2997   on alt-up anywhere
     2998   do:
     2999     run diasize_change-height in this-procedure
     3000       (input -1
     3001       ,input true
     3002       ) .
     3003     return no-apply .
     3004   end.
     3005   on alt-enter of frame Dialog-Frame
     3006   do:
     3007     run diasize_maximize in this-procedure
     3008       (input  ?
     3009       ).
     3010     return no-apply .
     3011   end.
     3012   procedure diasize_end-move :
     3013     do
     3014     on error undo, return error return-value
     3015     :
     3016       define variable v-row-delta as decimal   no-undo .
     3017       define variable v-col-delta as decimal   no-undo .
     3018       define variable v-new-row as decimal   no-undo .
     3019       define variable v-new-col as decimal   no-undo .
     3020       assign
     3021         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3022         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3023       .
     3024       assign
     3025         v-row-delta = v-new-row - frame Dialog-Frame :height
     3026         v-col-delta = v-new-col - frame Dialog-Frame :width
     3027       .
     3028       run diasize_change-height in this-procedure
     3029         (input v-row-delta
     3030         ,input true
     3031         ) .
     3032       run diasize_change-width in this-procedure
     3033         (input v-col-delta
     3034         ,input true
     3035         ) .
     3036     end.
     3037   end procedure.
     3038   procedure diasize_maximize :
     3039     define input  parameter p-action as logical   no-undo .
     3040     do
     3041     on error undo, return error return-value
     3042     :
     3043       if p-action = ?
     3044       then do:
     3045         if v-diasize-need-maximize = true
     3046         then do:
     3047           assign
     3048             p-action = true
     3049           .
     3050         end.
     3051         else do:
     3052           assign
     3053             p-action = false
     3054           .
     3055         end.
     3056       end.
     3057       if p-action = true
     3058       then do:
     3059         run diasize_change-height in this-procedure
     3060           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3061               - frame Dialog-Frame :height-chars
     3062           ,input true
     3063           ) .
     3064         run diasize_change-width in this-procedure
     3065           (input session :width-chars
     3066               - frame Dialog-Frame :width-chars
     3067           ,input true
     3068           ) .
     3069         assign
     3070           v-diasize-need-maximize = false
     3071         .
     3072       end.
     3073       else do:
     3074         run diasize_change-width in this-procedure
     3075           (input v-diasize-orig-frame-width
     3076               - frame Dialog-Frame :width-chars
     3077           ,input true
     3078           ) .
     3079         run diasize_change-height in this-procedure
     3080           (input v-diasize-orig-frame-height
     3081               - frame Dialog-Frame :height-chars
     3082           ,input true
     3083           ) .
     3084         assign
     3085           v-diasize-need-maximize = true
     3086         .
     3087       end.
     3088     end.
     3089   end procedure.
     3090   procedure diasize_restore-orig-size :
     3091     do
     3092     on error undo, return error return-value
     3093     :
     3094       assign
     3095         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3096         v-diasize-current-frame-height = frame Dialog-Frame :height
     3097       .
     3098       run diasize_set-height in this-procedure
     3099         (input  v-diasize-orig-frame-height
     3100         ,input  true
     3101         ) .
     3102       run diasize_set-width in this-procedure
     3103         (input  v-diasize-orig-frame-width
     3104         ,input  true
     3105         ) .
     3106     end.
     3107   end procedure.
     3108   procedure diasize_restore-current-size :
     3109     do
     3110     on error undo, return error return-value
     3111     :
     3112       run diasize_set-height in this-procedure
     3113         (input  v-diasize-current-frame-height
     3114         ,input  true
     3115         ) .
     3116       run diasize_set-width in this-procedure
     3117         (input  v-diasize-current-frame-width
     3118         ,input  true
     3119         ) .
     3120     end.
     3121   end procedure.
     3122   procedure diasize_set-browse-handle :
     3123     define input  parameter p-browse-handle as handle   no-undo .
     3124     define buffer buf_temp-browse-handle for temp-browse-handle .
     3125     do
     3126     on error undo, return error return-value
     3127     :
     3128       assign
     3129         v-diasize-browse-handle = p-browse-handle
     3130       .
     3131       for each buf_temp-browse-handle
     3132       on error undo, return error return-value
     3133       :
     3134         delete buf_temp-browse-handle .
     3135       end.
     3136     end.
     3137   end procedure.
     3138   procedure diasize_add_browse :
     3139     define input  parameter p-browse-type   as character no-undo .
     3140     define input  parameter p-browse-handle as handle    no-undo .
     3141     define buffer buf_temp-browse-handle for temp-browse-handle .
     3142     do
     3143     on error undo, return error return-value
     3144     :
     3145       assign
     3146         v-diasize-browse-number = v-diasize-browse-number + 1
     3147       .
     3148       create buf_temp-browse-handle .
     3149       assign
     3150         buf_temp-browse-handle.browse-type   = p-browse-type
     3151         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3152         buf_temp-browse-handle.browse-handle = p-browse-handle
     3153       .
     3154     end.
     3155   end procedure.
     3156   procedure diasize_init :
     3157     define variable v-default-value    as logical   no-undo .
     3158     define variable v-restore-saved    as logical   no-undo .
     3159     define variable v-resize-value-str as character no-undo .
     3160     do
     3161     on error undo, return error return-value
     3162     :
     3163       do with frame Dialog-Frame
     3164       :
     3165         assign
     3166           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3167           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3168           v-diasize-browse-handle     = browse BR-docs :handle
     3169         .
     3170         create button v-diasize-resize-button
     3171         assign
     3172           parent        = frame Dialog-Frame :first-child
     3173           label         = "s"
     3174           height-pixels = 16
     3175           width-pixels  = 16
     3176           visible       = true
     3177           sensitive     = true
     3178           movable       = true
     3179           triggers:
     3180             on end-move persistent run diasize_end-move in this-procedure .
     3181           end triggers.
     3182         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3183         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3184         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3185         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3186         assign
     3187           v-diasize-wndmax = false
     3188         .
     3189         if connected("ub") = true
     3190         then do:
     3191           define variable v-cntxt-db-num        as integer   no-undo .
     3192           define variable v-cntxt-userid        as character no-undo .
     3193           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3194                                             , OUTPUT v-cntxt-userid
     3195                                             ) .
     3196           run gbl/wndpar_r.p
     3197             (input  v-cntxt-db-num
     3198             ,input  v-cntxt-userid
     3199             ,input  'wndmax':U
     3200             ,output v-diasize-wndmax
     3201             ,output v-default-value
     3202             ) .
     3203         end.
     3204         assign
     3205           v-diasize-wndstore = false
     3206         .
     3207         if connected("ub") = true
     3208         then do:
     3209           run gbl/wndpar_r.p
     3210             (input  v-cntxt-db-num
     3211             ,input  v-cntxt-userid
     3212             ,input  'wndstore':U
     3213             ,output v-diasize-wndstore
     3214             ,output v-default-value
     3215             ) .
     3216         end.
     3217         assign
     3218           v-diasize-proc-name = entry(1, program-name(2), '.')
     3219         .
     3220         if v-diasize-wndstore = true
     3221         then do:
     3222           assign
     3223             v-restore-saved = false
     3224           .
     3225           if connected("ub") = true
     3226           then do:
     3227             run gbl/wndsizer.p
     3228               (input  v-cntxt-db-num
     3229               ,input  v-cntxt-userid
     3230               ,input  v-diasize-proc-name
     3231               ,input  'height':u
     3232               ,output v-resize-value-str
     3233               ) .
     3234             if v-resize-value-str <> '':U
     3235             then do:
     3236               run diasize_change-height in this-procedure
     3237                 (input  integer(v-resize-value-str)
     3238                 ,input  true
     3239                 ) .
     3240               assign
     3241                 v-restore-saved = true
     3242               .
     3243             end.
     3244           end.
     3245           if connected("ub") = true
     3246           then do:
     3247             run gbl/wndsizer.p
     3248               (input  v-cntxt-db-num
     3249               ,input  v-cntxt-userid
     3250               ,input  v-diasize-proc-name
     3251               ,input  'width':u
     3252               ,output v-resize-value-str
     3253               ) .
     3254             if v-resize-value-str <> '':U
     3255             then do:
     3256               run diasize_change-width in this-procedure
     3257                 (input  integer(v-resize-value-str)
     3258                 ,input  true
     3259                 ) .
     3260               assign
     3261                 v-restore-saved = true
     3262               .
     3263             end.
     3264           end.
     3265           if v-restore-saved <> true
     3266           then do:
     3267             if v-diasize-wndmax = true
     3268             then do:
     3269               run diasize_maximize in this-procedure
     3270                 (input  true
     3271                 ) .
     3272             end.
     3273           end.
     3274         end.
     3275         else do:
     3276           if v-diasize-wndmax = true
     3277           then do:
     3278             run diasize_maximize in this-procedure
     3279               (input  true
     3280               ) .
     3281           end.
     3282         end.
     3283       end.
     3284     end.
     3285   end procedure.
     3286   procedure diasize_need-full-display :
     3287     define output parameter p-need-full-display as logical   no-undo .
     3288     do
     3289     on error undo, return error return-value
     3290     :
     3291       assign
     3292         p-need-full-display = v-diasize-need-full-display
     3293       .
     3294       assign
     3295         v-diasize-need-full-display = false
     3296       .
     3297     end.
     3298   end procedure.
     3299   procedure get-context :
     3300      define output parameter p-db-num as integer          no-undo.
     3301      define output parameter p-user-id as character        no-undo.
     3302      define variable v-login               as character    no-undo.
     3303      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3304      define buffer buf_user-login  for ub.user-login .
     3305      do
     3306      on error undo, return error
     3307      :
     3308            FIND FIRST buf_sys-ctrl no-lock.
     3309            ASSIGN
     3310               v-login = USERID("ub")
     3311               p-db-num = buf_sys-ctrl.db-num
     3312            .
     3313            FIND FIRST buf_user-login
     3314                 WHERE buf_user-login.db-num = p-db-num
     3315                   AND buf_user-login.user-login = v-login
     3316                 no-lock
     3317                 no-error
     3318                 .
     3319            IF AVAILABLE buf_user-login
     3320            THEN DO:
     3321               assign
     3322                  p-user-id = buf_user-login.user-id
     3323               .
     3324            END.
     3325      end.
     3326   end procedure.
     3327   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3328   on INS of frame Dialog-Frame anywhere do:
     3329     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     3330     return no-apply.
     3331   end.
     3332   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3333   on F2 of frame Dialog-Frame anywhere do:
     3334     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     3335     return no-apply.
     3336   end.
     3337   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3338   procedure set-filter-name :
     3339   define input parameter p-filter-name as character no-undo .
     3340     do with frame Dialog-Frame:
     3341       if p-filter-name > "" then do:
     3342         assign
     3343           frame Dialog-Frame:title
     3344             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     3345         .
     3346         assign
     3347           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     3348         .
     3349       end.
     3350       else do:
     3351         assign
     3352           b-sch :tooltip = ""
     3353         .
     3354       end.
     3355     end.
     3356   end procedure.
     3357   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3358   on f5 of frame Dialog-Frame anywhere
     3359   do:
     3360     v-doc-rec = recid(X_c-layout). run OpenBr in this-procedure ( input yes, input no, input '':U). reposition br-docs to recid v-doc-rec no-error. v-doc-rec = ?.               apply 'value-changed' to br-docs.
     3361       apply "VALUE-CHANGED" to BR-changes.
     3362   end.
     3363   def var sort-labelbr-docs   as character no-undo .
     3364   def var sort-clmnbr-docs    as handle    no-undo .
     3365   def var cur-clmnbr-docs     as handle    no-undo .
     3366   def var cur-clmn-locbr-docs as integer   no-undo .
     3367   def var re-querybr-docs     as logical   initial no no-undo .
     3368   on start-search, ctrl-o of br-docs in frame Dialog-Frame do:
     3369      run sort-brbr-docs
     3370        (input (if available X_c-layout
     3371                then recid(X_c-layout)
     3372                else ?
     3373               )
     3374        ).
     3375   end.
     3376   PROCEDURE sort-brbr-docs :
     3377     define input parameter p-recid as recid no-undo .
     3378     if re-querybr-docs = no then do:
     3379       assign
     3380          cur-clmnbr-docs = br-docs:current-column in frame Dialog-Frame
     3381       .
     3382       if sort-clmnbr-docs <> ? then sort-clmnbr-docs:column-fgcolor = 0.
     3383       if cur-clmnbr-docs = sort-clmnbr-docs then do:
     3384         assign
     3385            sort-labelbr-docs = ""
     3386            sort-clmnbr-docs = ?
     3387         .
     3388        end.
     3389        else do:
     3390          assign
     3391            sort-labelbr-docs = cur-clmnbr-docs:label
     3392            sort-clmnbr-docs  = cur-clmnbr-docs
     3393            sort-clmnbr-docs:column-fgcolor = 4
     3394          .
     3395        end.
     3396      end.
     3397     assign
     3398       cur-clmn-locbr-docs = 1
     3399     .
     3400     def var column-handle as handle no-undo .
     3401     column-handle = br-docs:first-column.
     3402     do while valid-handle(column-handle) :
     3403       if column-handle = cur-clmnbr-docs then do:
     3404         leave .
     3405       end.
     3406       column-handle = column-handle:NEXT-COLUMN.
     3407       assign
     3408         cur-clmn-locbr-docs = cur-clmn-locbr-docs + 1
     3409       .
     3410     end.
     3411     case sort-labelbr-docs:
     3412           when X_c-layout.corr-date:label in browse br-docs then DO:    assign       sort-column-name = "X_c-layout.corr-date"     .     run OpenBr  in this-procedure ( input yes, input no, input '').   . END.
     3413           when X_c-layout.layout-id:label in browse br-docs then DO:    assign       sort-column-name = "X_c-layout.layout-id"     .     run OpenBr  in this-procedure ( input yes, input no, input '').   . END.
     3414       otherwise do:
     3415         assign
     3416           sort-column-name = ""
     3417         .
     3418         run OpenBr in this-procedure ( input yes, input no, input '').
     3419           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-docs') then do:
     3420             run mv-brw-defaultbr-docs.
     3421           end.
     3422         if sort-labelbr-docs <> "" then do:
     3423           assign
     3424             cur-clmnbr-docs:column-fgcolor = 0
     3425           .
     3426         end.
     3427         assign
     3428           cur-clmn-locbr-docs = ?
     3429         .
     3430       end.
     3431     end case.
     3432     if p-recid <> ? then do:
     3433       reposition br-docs to recid p-recid no-error.
     3434       apply "value-changed" to br-docs in frame Dialog-Frame.
     3435     end.
     3436     apply "entry" to br-docs in frame Dialog-Frame.
     3437   END PROCEDURE.
     3438   procedure re-open-query-srt-clmnbr-docs:
     3439   if cur-clmnbr-docs = ? then do:
     3440      run OpenBr in this-procedure ( input yes, input no, input '').
     3441   end.
     3442   else do:
     3443      assign re-querybr-docs = yes.
     3444      run sort-brbr-docs
     3445        (input (if available X_c-layout
     3446                then recid(X_c-layout)
     3447                else ?
     3448               )
     3449        ).
     3450      assign re-querybr-docs = no.
     3451   end.
     3452   end.
     3453   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3454   DEF VAR cur-clmn-numbr-docs as INT EXTENT 17 no-undo.
     3455   DEF VAR varmvibr-docs       as INT no-undo.
     3456   DEF VAR varmvjbr-docs       as INT no-undo.
     3457   DEF VAR varmvkbr-docs       as INT no-undo.
     3458   DEF VAR varmvlbr-docs       as INT no-undo.
     3459   DEF VAR move-elementbr-docs as INT no-undo.
     3460   def var jjbr-docs           as int no-undo.
     3461   do varmvibr-docs = 1 to EXTENT(cur-clmn-numbr-docs):
     3462     ASSIGN cur-clmn-numbr-docs[varmvibr-docs] = varmvibr-docs.
     3463   END.
     3464   RUN start-mv-clmnbr-docs.
     3465   PROCEDURE start-mv-clmnbr-docs:
     3466   def var old-session as logical no-undo.
     3467      old-session = SESSION:IMMEDIATE-DISPLAY.
     3468      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3469      SESSION:IMMEDIATE-DISPLAY = old-session.
     3470   END.
     3471   ON ctrl-cursor-right OF BROWSE br-docs do:
     3472     RUN re-move-clmnbr-docs ( 7, 17).
     3473   END.
     3474   ON ctrl-cursor-left OF BROWSE br-docs do:
     3475     RUN re-move-clmnbr-docs (17, 7).
     3476   END.
     3477   PROCEDURE re-move-clmnbr-docs:
     3478     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3479     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3480     DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3481       if cur-clmn-numbr-docs[varmvibr-docs] = source-column THEN cur-clmn-numbr-docs[varmvibr-docs] = -1.
     3482     END.
     3483     if br-docs:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     3484     if source-column > target-column THEN
     3485     DO varmvjbr-docs = source-column - 1 to target-column BY -1:
     3486       DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3487           if cur-clmn-numbr-docs[varmvibr-docs] = varmvjbr-docs THEN DO:
     3488             cur-clmn-numbr-docs[varmvibr-docs] = cur-clmn-numbr-docs[varmvibr-docs] + 1.
     3489           END.
     3490       END.
     3491     END.
     3492     ELSE
     3493     DO varmvjbr-docs = source-column + 1 to target-column:
     3494       DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3495         if cur-clmn-numbr-docs[varmvibr-docs] = varmvjbr-docs THEN DO:
     3496           cur-clmn-numbr-docs[varmvibr-docs] = cur-clmn-numbr-docs[varmvibr-docs] - 1.
     3497         END.
     3498       END.
     3499     END.
     3500     DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3501       if cur-clmn-numbr-docs[varmvibr-docs] = -1 THEN cur-clmn-numbr-docs[varmvibr-docs] = target-column.
     3502     END.
     3503   END PROCEDURE.
     3504   PROCEDURE ch-clmnbr-docs:
     3505     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3506     if cur-clmn-loc <= 7 then do:
     3507       return .
     3508     end.
     3509     DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3510       if cur-clmn-numbr-docs[varmvibr-docs] = cur-clmn-loc THEN move-elementbr-docs = varmvibr-docs.
     3511     END.
     3512     RUN re-move-clmnbr-docs (cur-clmn-loc, 7).
     3513   END PROCEDURE.
     3514   PROCEDURE mv-brw-defaultbr-docs:
     3515   def var old-session as logical no-undo.
     3516     old-session = SESSION:IMMEDIATE-DISPLAY.
     3517     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3518     do varmvlbr-docs = 7 to EXTENT(cur-clmn-numbr-docs):
     3519       RUN re-move-clmnbr-docs (cur-clmn-numbr-docs[varmvlbr-docs], varmvlbr-docs).
     3520     END.
     3521     RUN start-mv-clmnbr-docs.
     3522     SESSION:IMMEDIATE-DISPLAY = old-session.
     3523   END PROCEDURE.
     3524   .
     3525   MAIN-BLOCK:
     3526   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3527      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3528   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3529     run mainmenu_getcntxt in parparentproc
     3530       (output v-cntxt-db-num
     3531       ,output v-cntxt-userid
     3532       ,output v-cntxt-level
     3533       ,output v-cntxt-host-code-obj
     3534       ,output v-cntxt-obj-type
     3535       ,output v-cntxt-obj-code
     3536       ,output v-cntxt-db-num-obj
     3537       ,output v-cntxt-is-admin
     3538       ) .
     3539   if p-mode <> "one":U
     3540   and p-mode <> 'удаление':U
     3541   and p-mode <> 'ДОБАВЛЕНИЕ':U
     3542   then do:
     3543     message vss-workfile vss-revision vss-description skip
     3544     "Неверное значение параметра вызова p-mode" p-mode
     3545     view-as alert-box ERROR.
     3546     return.
     3547   end.
     3548     if p-mode = "one":U then do:
     3549       FIND FIRST X_layout No-LOCK where
     3550                   X_layout.layout-id = p-layout-id No-ERROR.
     3551       if not avail X_layout then do:
     3552         message
     3553         vss-workfile vss-revision vss-description skip
     3554         "Неверное значение параметра вызова p-layout-id" p-layout-id
     3555         view-as alert-box error .
     3556         return error.
     3557       end.
     3558     end.
     3559     v-rid-list = p-rid-list.
     3560     if v-rid-list <> "" then do:
     3561         FIND FIRST find_c-layout No-LOCK where
     3562                    recid(find_c-layout) = integer(entry(1, v-rid-list)) No-ERROR.
     3563         if not avail find_c-layout then do:
     3564           message
     3565           vss-workfile vss-revision vss-description skip
     3566           "Неверное значение параметра вызова v-rid-list" v-rid-list
     3567           view-as alert-box error .
     3568           return error.
     3569         end.
     3570         v-doc-rec = integer(entry(1, v-rid-list)).
     3571     end.
     3572     run MyEnable in this-procedure .
     3573     RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     3574     HIDE mark-num in frame Dialog-Frame .
     3575     REPOSITION br-docs to row 1 No-ERROR.
     3576     run diasize_add_browse in this-procedure
     3577       (input  'width':u
     3578       ,input  browse br-changes :handle
     3579       ) .
     3580     run diasize_init in this-procedure .
     3581     WAIT-FOR GO OF FRAME Dialog-Frame.
     3582   END.
     3583   RUN disable_UI.
     3584   PROCEDURE disable_UI :
     3585     HIDE FRAME Dialog-Frame.
     3586   END PROCEDURE.
     3587   PROCEDURE enable_UI :
     3588     DISPLAY mark-num
     3589         WITH FRAME Dialog-Frame.
     3590     ENABLE b-quit B-mark b-sel B-lkp B-sch B-Help BR-docs BR-changes mark-num
     3591         WITH FRAME Dialog-Frame.
     3592     VIEW FRAME Dialog-Frame.
     3593   END PROCEDURE.
     3594   PROCEDURE get-line-changes-current :
     3595   define input parameter p-corr-user-db-num as integer   no-undo .
     3596   define input parameter p-chip-num like ub.c-layout.chip-num no-undo .
     3597   define variable v-chg-fields as character no-undo .
     3598   define variable ii as integer no-undo .
     3599   define variable jj as integer no-undo .
     3600   define variable v-field-name as character no-undo .
     3601   define variable v-field-label as character no-undo .
     3602   define variable v-field-function as character no-undo .
     3603   define variable v-real-field-name as character no-undo .
     3604   define variable v-field-list as character no-undo.
     3605   define variable v-value-list as character no-undo.
     3606   define variable v-mode-id as character no-undo.
     3607   define variable v-widget-id as character no-undo.
     3608   define variable fields-name-list as character no-undo .
     3609   define variable fields-label-list as character no-undo .
     3610   define variable fields-function-list as character no-undo .
     3611   define variable v-type as character no-undo .
     3612   define buffer buf_layout-elem-rule for ub.layout-elem-rule.
     3613   define buffer buf_rule-call-param for ub.rule-call-param.
     3614   define buffer buf_layout-attr for ub.layout-attr.
     3615   define buffer buf_c-layout-elem-rule for ub.c-layout-elem-rule.
     3616   define buffer buf_c-rule-call-param for ub.c-rule-call-param.
     3617   for each buf_c-layout-elem-rule no-lock where
     3618            buf_c-layout-elem-rule.layout-id = p-layout-id
     3619        AND buf_c-layout-elem-rule.corr-user-db-num = p-corr-user-db-num
     3620        AND buf_c-layout-elem-rule.chip-num = p-chip-num:
     3621     find first buf_layout-elem-rule  no-lock where
     3622               buf_layout-elem-rule.layout-id = buf_c-layout-elem-rule.layout-id
     3623           and buf_layout-elem-rule.mode-id = buf_c-layout-elem-rule.mode-id
     3624           and buf_layout-elem-rule.widget-id = buf_c-layout-elem-rule.widget-id no-error.
     3625     if available buf_layout-elem-rule then do:
     3626       buffer-compare
     3627       buf_layout-elem-rule to buf_c-layout-elem-rule
     3628       case-sensitive
     3629       save result in v-chg-fields.
     3630     end.
     3631     else do:
     3632      v-chg-fields = "mode-id,widget-id,elem-label,elem-tooltip,image-id-down,image-id-insen,image-id-up,is-mandatory,rule_id,sts".
     3633     end.
     3634     _ii:
     3635     do ii = 1 to num-entries(v-chg-fields):
     3636       assign
     3637       v-field-name = entry(ii, v-chg-fields)
     3638       jj = lookup(v-field-name, "mode-id,widget-id,elem-label,elem-tooltip,image-id-down,image-id-insen,image-id-up,is-mandatory,rule_id,sts").
     3639       if jj = 0 then next _ii.
     3640       assign
     3641       v-field-label = entry(jj, "Режим,Элемент,Лейбл элемента,Тултип элемента,Изображение DOWN,Изображение INSEN,Изображение UP,Обяз,Функция,Статус")
     3642       v-field-function = entry(jj, ",,,,,,,get-is-mandatory-name,,get-status-name")
     3643       v-real-field-name = entry(1, v-field-name, ':')
     3644       .
     3645       create temp-changes.
     3646       assign
     3647       temp-changes.f_name = substitute("layout-elem-rule&1&2&1&3&4"
     3648                                        ,chr(4)
     3649                                        ,buf_c-layout-elem-rule.mode-id
     3650                                        ,buf_c-layout-elem-rule.widget-id
     3651                                        ,v-field-name)
     3652       temp-changes.l_name = substitute("&4Элемент &1 в режиме &2: &3"
     3653                                        ,buf_c-layout-elem-rule.widget-id
     3654                                        ,buf_c-layout-elem-rule.mode-id
     3655                                        ,v-field-label
     3656                                        ,(if buf_c-layout-elem-rule.action = integer('1':U)
     3657                                          then "+"
     3658                                          else (if buf_c-layout-elem-rule.action = integer('99':U)
     3659                                                then "-"
     3660                                                else chr(126))
     3661                                          )
     3662                                         )
     3663       temp-changes.v_old = string(buffer buf_c-layout-elem-rule:buffer-field(v-real-field-name):buffer-value)
     3664       temp-changes.v_new = (if available buf_layout-elem-rule
     3665                             then string(buffer buf_layout-elem-rule:buffer-field(v-real-field-name):buffer-value)
     3666                             else '')
     3667       .
     3668       if v-field-function <> '':U then do:
     3669         assign
     3670         temp-changes.v_old = DYNAMIC-function(v-field-function, temp-changes.v_old)
     3671         temp-changes.v_new = DYNAMIC-function(v-field-function, temp-changes.v_new)
     3672         .
     3673       end.
     3674       if buf_c-layout-elem-rule.action = integer('1':U) then do:
     3675         assign
     3676         temp-changes.v_old = ''
     3677         .
     3678       end.
     3679       if buf_c-layout-elem-rule.action = integer('99':U) then do:
     3680         assign
     3681         temp-changes.v_new = ''
     3682         .
     3683       end.
     3684     end.
     3685   end.
     3686   for each buf_c-rule-call-param no-lock where
     3687             buf_c-rule-call-param.call_id begins ('layout-elem-rule':U + chr(3) + p-layout-id)
     3688         AND buf_c-rule-call-param.corr-user-db-num = p-corr-user-db-num
     3689        AND buf_c-rule-call-param.chip-num = p-chip-num :
     3690     find first buf_rule-call-param no-lock where
     3691               buf_rule-call-param.call_id = buf_c-rule-call-param.call_id
     3692         and buf_rule-call-param.codex_id = buf_c-rule-call-param.codex_id
     3693         and buf_rule-call-param.ruleset_id = buf_c-rule-call-param.ruleset_id
     3694         and buf_rule-call-param.order_id = buf_c-rule-call-param.order_id
     3695         and buf_rule-call-param.param-name = buf_c-rule-call-param.param-name
     3696         and buf_rule-call-param.p-index = buf_c-rule-call-param.p-index no-error.
     3697     assign
     3698     fields-name-list  = "param-name,param-data-type,param-label,rule_id"
     3699     fields-label-list  = "Имя параметра,Тип данных,Лейбл,№ правила"
     3700     fields-function-list  = ",,,"
     3701     .
     3702     if buf_c-rule-call-param.action = integer('1':U) then do:
     3703       assign
     3704       v-type = (if available buf_rule-call-param
     3705                 then buf_rule-call-param.param-data-type
     3706                 else '').
     3707     end.
     3708     else do:
     3709       assign
     3710       v-type = buf_c-rule-call-param.param-data-type.
     3711     end.
     3712     if v-type = 'character':U then do:
     3713       assign
     3714       fields-name-list = fields-name-list + chr(44) + "param-value-character"
     3715       fields-label-list = fields-label-list + chr(44) + "Знач.(строковое)"
     3716       fields-function-list = fields-function-list + chr(44)
     3717       .
     3718     end.
     3719     if v-type = 'date':U then do:
     3720       assign
     3721       fields-name-list = fields-name-list + chr(44) + "param-value-date"
     3722       fields-label-list = fields-label-list + chr(44) + "Знач.(дата)"
     3723       fields-function-list = fields-function-list + chr(44)
     3724       .
     3725     end.
     3726     if v-type = 'decimal':U then do:
     3727       assign
     3728       fields-name-list = fields-name-list + chr(44) + "param-value-decimal"
     3729       fields-label-list = fields-label-list + chr(44) + "Знач.(десятичн.)"
     3730       fields-function-list = fields-function-list + chr(44)
     3731       .
     3732     end.
     3733     if v-type = 'integer':U then do:
     3734       assign
     3735       fields-name-list = fields-name-list + chr(44) + "param-value-integer"
     3736       fields-label-list = fields-label-list + chr(44) + "Знач.(целое)"
     3737       fields-function-list = fields-function-list + chr(44)
     3738       .
     3739     end.
     3740     if v-type = 'logical':U then do:
     3741       assign
     3742       fields-name-list = fields-name-list + chr(44) + "param-value-logical"
     3743       fields-label-list = fields-label-list + chr(44) + "Знач.(логич.)"
     3744       fields-function-list = fields-function-list + chr(44)
     3745       .
     3746     end.
     3747     if available buf_rule-call-param then do:
     3748       buffer-compare
     3749       buf_rule-call-param
     3750       to buf_c-rule-call-param
     3751       case-sensitive
     3752       save result in v-chg-fields.
     3753     end.
     3754     else do:
     3755       v-chg-fields = "param-name,param-data-type,param-label,rule_id".
     3756     end.
     3757     _ii:
     3758     do ii = 1 to num-entries(v-chg-fields):
     3759       assign
     3760       v-field-name = entry(ii, v-chg-fields)
     3761       jj = lookup(v-field-name, fields-name-list).
     3762       if jj = 0 then next _ii.
     3763       assign
     3764       v-field-label = entry(jj, fields-label-list)
     3765       v-field-function = entry(jj, fields-function-list)
     3766       v-real-field-name = entry(1, v-field-name, ':')
     3767       .
     3768       run gen-key-fv in this-procedure ( input buf_c-rule-call-param.call_id
     3769                                          ,output v-field-list
     3770                                          ,output v-value-list) no-error.
     3771       assign
     3772       v-widget-id =  entry(lookup("widget-id", v-field-list, chr(3)), v-value-list, chr(3))
     3773       v-mode-id = entry(lookup("mode-id", v-field-list, chr(3)), v-value-list, chr(3))
     3774       .
     3775       create temp-changes.
     3776       assign
     3777       temp-changes.f_name = substitute("rule-call-param &1&2&1&3&1&4":U
     3778                                        ,chr(4)
     3779                                        ,buf_c-rule-call-param.call_id
     3780                                        ,v-field-name
     3781                                        ,buf_c-rule-call-param.param-name)
     3782       temp-changes.l_name = substitute("&6Пар-р &1 функции &2 эл.&3 режим &4: &5"
     3783                                         ,buf_c-rule-call-param.param-name
     3784                                         ,(if buf_c-rule-call-param.rule_id > 0 then string(buf_c-rule-call-param.rule_id) else '')
     3785                                         ,v-widget-id
     3786                                         ,v-mode-id
     3787                                         ,v-field-label
     3788                                        ,(if buf_c-rule-call-param.action = integer('1':U)
     3789                                          then "+"
     3790                                          else (if buf_c-rule-call-param.action = integer('99':U)
     3791                                                then "-"
     3792                                                else chr(126))
     3793                                          )
     3794                                         )
     3795       temp-changes.v_old = string(buffer buf_c-rule-call-param:buffer-field(v-real-field-name):buffer-value)
     3796       temp-changes.v_new = (if available buf_rule-call-param
     3797                            then string(buffer buf_rule-call-param:buffer-field(v-real-field-name):buffer-value)
     3798                            else '')
     3799       .
     3800       if v-field-function <> '':U then do:
     3801         assign
     3802         temp-changes.v_old = DYNAMIC-function(v-field-function, temp-changes.v_old)
     3803         temp-changes.v_new = DYNAMIC-function(v-field-function, temp-changes.v_new)
     3804         .
     3805       end.
     3806       if buf_c-rule-call-param.action = integer('1':U) then do:
     3807         assign
     3808         temp-changes.v_old = ''
     3809         .
     3810       end.
     3811       if buf_c-rule-call-param.action = integer('99':U) then do:
     3812         assign
     3813         temp-changes.v_new = ''
     3814         .
     3815       end.
     3816     end.
     3817   end.
     3818   END PROCEDURE.
     3819   PROCEDURE get-line-changes-hist :
     3820   define input parameter p-layout-id like ub.c-layout.layout-id no-undo .
     3821   define input parameter p-corr-user-db-num as integer   no-undo .
     3822   define input parameter p-chip-num like ub.c-layout.chip-num no-undo.
     3823   define input parameter p-new-corr-user-db-num as integer   no-undo .
     3824   define input parameter p-new-chip-num like ub.c-layout.chip-num no-undo.
     3825   define variable v-chg-fields as character no-undo .
     3826   define variable ii as integer no-undo .
     3827   define variable jj as integer no-undo .
     3828   define variable v-field-name as character no-undo .
     3829   define variable v-field-label as character no-undo .
     3830   define variable v-field-function as character no-undo .
     3831   define variable v-real-field-name as character no-undo .
     3832   define variable v-field-list as character no-undo.
     3833   define variable v-value-list as character no-undo.
     3834   define variable v-mode-id as character no-undo.
     3835   define variable v-widget-id as character no-undo.
     3836   define variable fields-name-list as character no-undo .
     3837   define variable fields-label-list as character no-undo .
     3838   define variable fields-function-list as character no-undo .
     3839   define variable v-type as character no-undo .
     3840   define buffer new_c-layout-elem-rule for ub.c-layout-elem-rule.
     3841   define buffer new_c-rule-call-param for ub.c-rule-call-param.
     3842   define buffer buf_c-layout-elem-rule for ub.c-layout-elem-rule.
     3843   define buffer buf_c-rule-call-param for ub.c-rule-call-param.
     3844   for each  buf_c-layout-elem-rule no-lock where
     3845            buf_c-layout-elem-rule.layout-id = p-layout-id
     3846        AND buf_c-layout-elem-rule.corr-user-db-num = p-corr-user-db-num
     3847        AND buf_c-layout-elem-rule.chip-num = p-chip-num
     3848               :
     3849     find first new_c-layout-elem-rule no-lock where
     3850               new_c-layout-elem-rule.layout-id = p-layout-id
     3851           AND new_c-layout-elem-rule.chip-num = p-new-chip-num
     3852           AND new_c-layout-elem-rule.corr-user-db-num = p-new-corr-user-db-num
     3853        AND new_c-layout-elem-rule.mode-id = buf_c-layout-elem-rule.mode-id
     3854        AND new_c-layout-elem-rule.widget-id = buf_c-layout-elem-rule.widget-id no-error.
     3855     if available new_c-layout-elem-rule then do:
     3856       buffer-compare
     3857       new_c-layout-elem-rule to buf_c-layout-elem-rule
     3858       case-sensitive
     3859       save result in v-chg-fields.
     3860     end.
     3861     else do:
     3862        v-chg-fields = "mode-id,widget-id,elem-label,elem-tooltip,image-id-down,image-id-insen,image-id-up,is-mandatory,rule_id,sts".
     3863     end.
     3864     _ii:
     3865     do ii = 1 to num-entries(v-chg-fields):
     3866       assign
     3867       v-field-name = entry(ii, v-chg-fields)
     3868       jj = lookup(v-field-name, "mode-id,widget-id,elem-label,elem-tooltip,image-id-down,image-id-insen,image-id-up,is-mandatory,rule_id,sts").
     3869       if jj = 0 then next _ii.
     3870       assign
     3871       v-field-label = entry(jj, "Режим,Элемент,Лейбл элемента,Тултип элемента,Изображение DOWN,Изображение INSEN,Изображение UP,Обяз,Функция,Статус")
     3872       v-field-function = entry(jj, ",,,,,,,get-is-mandatory-name,,get-status-name")
     3873       v-real-field-name = entry(1, v-field-name, ":")
     3874       .
     3875       create temp-changes.
     3876       assign
     3877       temp-changes.f_name = substitute("layout-elem-rule&1&2&1&3&1&4"
     3878                                         ,chr(4)
     3879                                         ,buf_c-layout-elem-rule.mode-id
     3880                                         ,buf_c-layout-elem-rule.widget-id
     3881                                         ,v-field-name)
     3882       temp-changes.l_name = substitute("&4Элемент &1 в режиме &2: &3"
     3883                                         ,buf_c-layout-elem-rule.widget-id
     3884                                         ,buf_c-layout-elem-rule.mode-id
     3885                                         ,v-field-label
     3886                                        ,(if buf_c-layout-elem-rule.action = integer('1':U)
     3887                                          then "+"
     3888                                          else (if buf_c-layout-elem-rule.action = integer('99':U)
     3889                                                then "-"
     3890                                                else chr(126))
     3891                                          )
     3892                                         )
     3893       temp-changes.v_old = string(buffer buf_c-layout-elem-rule:buffer-field(v-real-field-name):buffer-value)
     3894       temp-changes.v_new = (if available new_c-layout-elem-rule
     3895                             then string(buffer new_c-layout-elem-rule:buffer-field(v-real-field-name):buffer-value)
     3896                             else '')
     3897       .
     3898       if v-field-function <> '':U then do:
     3899         assign
     3900         temp-changes.v_old = DYNAMIC-function(v-field-function, temp-changes.v_old)
     3901         temp-changes.v_new = DYNAMIC-function(v-field-function, temp-changes.v_new)
     3902         .
     3903       end.
     3904       if buf_c-layout-elem-rule.action = integer('1':U) then do:
     3905         assign
     3906         temp-changes.v_old = ''
     3907         .
     3908       end.
     3909       if buf_c-layout-elem-rule.action = integer('99':U) then do:
     3910         assign
     3911         temp-changes.v_new = ''
     3912         .
     3913       end.
     3914     end.
     3915   end.
     3916   for each  buf_c-rule-call-param no-lock where
     3917             buf_c-rule-call-param.call_id begins ('layout-elem-rule':U + chr(3) + p-layout-id)
     3918         AND buf_c-rule-call-param.chip-num = p-chip-num
     3919         AND buf_c-rule-call-param.corr-user-db-num = p-corr-user-db-num
     3920         :
     3921     find first new_c-rule-call-param no-lock where
     3922               new_c-rule-call-param.call_id = buf_c-rule-call-param.call_id
     3923         and new_c-rule-call-param.codex_id = buf_c-rule-call-param.codex_id
     3924         and new_c-rule-call-param.ruleset_id = buf_c-rule-call-param.ruleset_id
     3925         and new_c-rule-call-param.order_id = buf_c-rule-call-param.order_id
     3926         and new_c-rule-call-param.param-name = buf_c-rule-call-param.param-name
     3927         and new_c-rule-call-param.p-index = buf_c-rule-call-param.p-index
     3928           AND new_c-rule-call-param.chip-num = p-new-chip-num
     3929           AND new_c-rule-call-param.corr-user-db-num = p-new-corr-user-db-num  no-error.
     3930     assign
     3931     fields-name-list  = "param-name,param-data-type,param-label,rule_id"
     3932     fields-label-list  = "Имя параметра,Тип данных,Лейбл,№ правила"
     3933     fields-function-list  = ",,,"
     3934     .
     3935     if buf_c-rule-call-param.action = integer('1':U) then do:
     3936       assign
     3937       v-type = (if available new_c-rule-call-param
     3938                 then new_c-rule-call-param.param-data-type
     3939                 else '').
     3940     end.
     3941     else do:
     3942       assign
     3943       v-type = buf_c-rule-call-param.param-data-type.
     3944     end.
     3945     if v-type = 'character':U then do:
     3946       assign
     3947       fields-name-list = fields-name-list + chr(44) + "param-value-character"
     3948       fields-label-list = fields-label-list + chr(44) + "Знач.(строковое)"
     3949       fields-function-list = fields-function-list + chr(44)
     3950       .
     3951     end.
     3952     if v-type = 'date':U then do:
     3953       assign
     3954       fields-name-list = fields-name-list + chr(44) + "param-value-date"
     3955       fields-label-list = fields-label-list + chr(44) + "Знач.(дата)"
     3956       fields-function-list = fields-function-list + chr(44)
     3957       .
     3958     end.
     3959     if v-type = 'decimal':U then do:
     3960       assign
     3961       fields-name-list = fields-name-list + chr(44) + "param-value-decimal"
     3962       fields-label-list = fields-label-list + chr(44) + "Знач.(десятичн.)"
     3963       fields-function-list = fields-function-list + chr(44)
     3964       .
     3965     end.
     3966     if v-type = 'integer':U then do:
     3967       assign
     3968       fields-name-list = fields-name-list + chr(44) + "param-value-integer"
     3969       fields-label-list = fields-label-list + chr(44) + "Знач.(целое)"
     3970       fields-function-list = fields-function-list + chr(44)
     3971       .
     3972     end.
     3973     if v-type = 'logical':U then do:
     3974       assign
     3975       fields-name-list = fields-name-list + chr(44) + "param-value-logical"
     3976       fields-label-list = fields-label-list + chr(44) + "Знач.(логич.)"
     3977       fields-function-list = fields-function-list + chr(44)
     3978       .
     3979     end.
     3980     if available new_c-rule-call-param then do:
     3981       buffer-compare
     3982       new_c-rule-call-param to buf_c-rule-call-param
     3983       case-sensitive
     3984       save result in v-chg-fields.
     3985     end.
     3986     else do:
     3987       v-chg-fields = fields-name-list.
     3988     end.
     3989     _ii:
     3990     do ii = 1 to num-entries(v-chg-fields):
     3991       assign
     3992       v-field-name = entry(ii, v-chg-fields)
     3993       jj = lookup(v-field-name, fields-name-list).
     3994       if jj = 0 then next _ii.
     3995       assign
     3996       v-field-label = entry(jj, fields-label-list)
     3997       v-field-function = entry(jj, fields-function-list)
     3998       v-real-field-name = entry(1, v-field-name, ':')
     3999       .
     4000       run gen-key-fv in this-procedure ( input buf_c-rule-call-param.call_id
     4001                                          ,output v-field-list
     4002                                          ,output v-value-list) no-error.
     4003       assign
     4004       v-widget-id =  entry(lookup("widget-id", v-field-list, chr(3)), v-value-list, chr(3))
     4005       v-mode-id = entry(lookup("mode-id", v-field-list, chr(3)), v-value-list, chr(3))
     4006       .
     4007       create temp-changes.
     4008       assign
     4009       temp-changes.f_name = substitute("rule-call-param &1&2&1&3&1&4":U
     4010                                        ,chr(4)
     4011                                        ,buf_c-rule-call-param.call_id
     4012                                        ,v-field-name
     4013                                        ,buf_c-rule-call-param.param-name)
     4014       temp-changes.l_name = substitute("&6Пар-р &1 функции &2 эл.&3 режим &4: &5"
     4015                                         ,buf_c-rule-call-param.param-name
     4016                                         ,(if buf_c-rule-call-param.rule_id > 0 then string(buf_c-rule-call-param.rule_id) else '')
     4017                                         ,v-widget-id
     4018                                         ,v-mode-id
     4019                                         ,v-field-label
     4020                                        ,(if buf_c-rule-call-param.action = integer('1':U)
     4021                                          then "+"
     4022                                          else (if buf_c-rule-call-param.action = integer('99':U)
     4023                                                then "-"
     4024                                                else chr(126))
     4025                                          )
     4026                                         )
     4027       temp-changes.v_old = string(buffer buf_c-rule-call-param:buffer-field(v-field-name):buffer-value)
     4028       temp-changes.v_new = (if available new_c-rule-call-param
     4029                             then string(buffer new_c-rule-call-param:buffer-field(v-field-name):buffer-value)
     4030                             else '')
     4031       .
     4032       if v-field-function <> '':U then do:
     4033         assign
     4034         temp-changes.v_old = DYNAMIC-function(v-field-function, temp-changes.v_old)
     4035         temp-changes.v_new = DYNAMIC-function(v-field-function, temp-changes.v_new)
     4036         .
     4037       end.
     4038       if buf_c-rule-call-param.action = integer('1':U) then do:
     4039         assign
     4040         temp-changes.v_old = ''
     4041         .
     4042       end.
     4043       if buf_c-rule-call-param.action = integer('99':U) then do:
     4044         assign
     4045         temp-changes.v_new = ''
     4046         .
     4047       end.
     4048     end.
     4049   end.
     4050   END PROCEDURE.
     4051   PROCEDURE MyEnable :
     4052   ASSIGN
     4053   br-docs:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame = 6
     4054   X_c-layout.layout-id:READ-ONLY IN BROWSE br-docs = YES
     4055   temp-changes.l_name:resizable in browse br-changes = true
     4056   temp-changes.v_old:resizable in browse br-changes = true
     4057   temp-changes.v_new:resizable in browse br-changes = true
     4058   temp-changes.l_name:width in browse br-changes = 50
     4059   temp-changes.v_old:width in browse br-changes = 25
     4060   temp-changes.v_new:width in browse br-changes = 25
     4061   .
     4062   DISPLAY
     4063   mark-num
     4064   WITH FRAME Dialog-Frame.
     4065   ENABLE
     4066   b-quit
     4067   b-help
     4068   br-docs
     4069   b-sel  when LOOKUP("b-sel":U, bttns) > 0
     4070   b-mark when LOOKUP("b-mark":U, bttns) > 0
     4071   b-sch
     4072   br-changes
     4073   WITH FRAME Dialog-Frame.
     4074   VIEW FRAME Dialog-Frame.
     4075   hide
     4076   b-lkp
     4077   in frame Dialog-Frame.
     4078   END PROCEDURE.
     4079   PROCEDURE OpenBr :
     4080   define input  parameter p-open-query     as logical   no-undo .
     4081   define input  parameter p-find-next      as logical   no-undo .
     4082   define input  parameter p-find-condition as character no-undo .
     4083   define variable l-query-was-opened as logical no-undo .
     4084   define variable title0 as character no-undo.
     4085   title0 = "Список истории раскладок" + chr(32).
     4086   run waitfram-show in this-procedure ( input "Ждите...").
     4087   define variable sort-column-phrase as character no-undo .
     4088   case sort-column-name :
     4089     when "" then do:
     4090       assign
     4091         sort-column-phrase = ""
     4092       .
     4093     end.
     4094     otherwise do:
     4095       assign
     4096         sort-column-phrase = "by " + sort-column-name
     4097       .
     4098     end.
     4099   end case.
     4100   define variable l-open-query as logical   no-undo .
     4101     CASE p-mode :
     4102       WHEN "one":U        THEN DO:
     4103        assign
     4104        filter-point = filter-point0 + p-mode
     4105        filter-label = substitute("&1", filter-label0)
     4106        frame Dialog-Frame :title = substitute("История изменения раскладки &1", p-layout-id)
     4107        .
     4108   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4109   define variable  l-disable-where-27  as logical   no-undo .
     4110   define variable  l-filter-open-27    as logical   .
     4111   define variable  flt-rec-27       as recid     no-undo .
     4112   define variable  filter-name-27      as character no-undo .
     4113   define variable  where-phrase-27     as character no-undo .
     4114   define variable  sort-phrase-27      as character no-undo .
     4115   define variable  where-phrase-rus-27 as character no-undo .
     4116   define variable  sort-phrase-rus-27  as character no-undo .
     4117     run waitfram-show in this-procedure
     4118       (input "ЖДИТЕ ..."
     4119       ).
     4120   run gbl/flt-get.p
     4121     (input filter-point
     4122     ,output flt-rec-27
     4123     ,output filter-name-27
     4124     ,output where-phrase-27
     4125     ,output sort-phrase-27
     4126     ,output where-phrase-rus-27
     4127     ,output sort-phrase-rus-27
     4128     ).
     4129   if p-open-query then do:
     4130       run set-filter-name in this-procedure
     4131         (INPUT filter-name-27
     4132         ) no-error .
     4133     assign
     4134       l-filter-open-27 = false
     4135     .
     4136     if flt-rec-27 <> ?
     4137       or sort-column-phrase > ""
     4138     then do:
     4139       define variable  parameter-2-27 as character no-undo .
     4140       define variable  parameter-3-27 as character no-undo .
     4141       define variable  parameter-4-27 as character no-undo .
     4142       define variable  parameter-5-27 as character no-undo .
     4143       define variable  parameter-6-27 as character no-undo .
     4144       define variable  parameter-7-27 as character no-undo .
     4145         assign
     4146         parameter-3-27 =
     4147                                 "FOR EACH X_c-layout"
     4148         parameter-4-27 =
     4149           (
     4150             if (" X_c-layout.layout-id = p-layout-id " + " " + where-phrase-27) <> ""
     4151             then  substitute('X_c-layout.layout-id = &1&2&1', chr(34), p-layout-id )  + " " + where-phrase-27
     4152             else "true"
     4153           )
     4154         parameter-5-27 = (" " + "" + " " + "")
     4155         parameter-6-27 = if sort-phrase-27 = ''
     4156                              then
     4157           (
     4158           " " + "  " +
     4159             " " + sort-column-phrase +
     4160           " " + " by X_c-layout.corr-user-db-num  by X_c-layout.chip-num descending  "
     4161           )
     4162                              else
     4163           (
     4164           " " + "  " +
     4165             " " + sort-column-phrase +
     4166           " " + sort-phrase-27
     4167           )
     4168         parameter-7-27 =
     4169           " indexed-reposition  "
     4170       .
     4171       do
     4172       on stop undo, leave
     4173       on error undo, leave
     4174       :
     4175         assign
     4176           l-disable-where-27 =
     4177             (" X_c-layout.layout-id = p-layout-id " + " " + where-phrase-27 = "")
     4178         .
     4179         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4180                             ,input QUERY br-docs:handle
     4181                             ,input parameter-3-27
     4182                             ,input parameter-4-27
     4183                             ,input parameter-5-27
     4184                             ,input parameter-6-27
     4185                             ,input parameter-7-27
     4186                             )
     4187         .
     4188         assign
     4189           l-filter-open-27 = true
     4190         .
     4191       end.
     4192       if l-filter-open-27 = false then do:
     4193         message
     4194           "Ошибка при фильтрации / сортировке" skip
     4195           "Будут показаны записи без учета фильтра" skip
     4196           view-as alert-box .
     4197       end.
     4198       else do:
     4199           assign
     4200             l-query-was-opened = true
     4201           .
     4202       end.
     4203     end.
     4204     if l-filter-open-27 = false then do:
     4205       OPEN QUERY br-docs FOR EACH X_c-layout
     4206         where  X_c-layout.layout-id = p-layout-id
     4207          by X_c-layout.corr-user-db-num  by X_c-layout.chip-num descending
     4208         indexed-reposition
     4209     .
     4210         assign
     4211           l-query-was-opened = true
     4212         .
     4213     end.
     4214   end.
     4215   else do:
     4216     assign
     4217       v-doc-rec = recid( X_c-layout )
     4218     .
     4219     do
     4220     on stop undo, leave
     4221     on error undo, leave
     4222     :
     4223       if QUERY br-docs:handle:get-buffer-handle(1) = (buffer X_c-layout:handle) then do:
     4224         assign
     4225         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     4226         parameter-4-27 =
     4227           "where ":u +  substitute('X_c-layout.layout-id = &1&2&1', chr(34), p-layout-id )  + " ":u + where-phrase-27 + " ":u + p-find-condition + " " + ""
     4228         parameter-5-27 = "  "
     4229       .
     4230         run fltopend_fltfindd in this-procedure  (
     4231                             input this-procedure:handle
     4232                             ,input QUERY br-docs:handle
     4233                             ,input rowid(X_c-layout)
     4234                             ,input logical(parameter-2-27)
     4235                             ,input no-lock
     4236                             ,input (buffer X_c-layout:handle)
     4237                             ,input parameter-4-27
     4238                             ,input parameter-5-27
     4239                             ) no-error.
     4240         .
     4241         assign
     4242           v-doc-rec = integer(return-value)
     4243           v-fltopend-rowid[1] = ?
     4244         .
     4245       end.
     4246       else do:
     4247         assign
     4248         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     4249         parameter-3-27 =  "FOR EACH X_c-layout"
     4250         parameter-4-27 =
     4251           (
     4252             if (" X_c-layout.layout-id = p-layout-id " + " " + where-phrase-27) <> ""
     4253             then  substitute('X_c-layout.layout-id = &1&2&1', chr(34), p-layout-id )  + " " + where-phrase-27
     4254             else "true"
     4255           )
     4256         parameter-5-27 = (" " + "" + " " + "" + " " + p-find-condition)
     4257         parameter-6-27 = if sort-phrase-27 = ''
     4258                              then
     4259           (
     4260           " " + "  " +
     4261             " " + sort-column-phrase +
     4262           " " + " by X_c-layout.corr-user-db-num  by X_c-layout.chip-num descending  "
     4263           )
     4264                              else
     4265           (
     4266           " " + "  " +
     4267             " " + sort-column-phrase +
     4268           " " + sort-phrase-27
     4269           )
     4270         parameter-7-27 =
     4271           " indexed-reposition  "
     4272       .
     4273         run fltopend_fltfindq in this-procedure  (
     4274                             input this-procedure:handle
     4275                             ,input QUERY br-docs:handle
     4276                             ,input logical(parameter-2-27)
     4277                             ,input no-lock
     4278                             ,input parameter-3-27
     4279                             ,input parameter-4-27
     4280                             ,input parameter-5-27
     4281                             ,input parameter-6-27
     4282                             ,input parameter-7-27
     4283                             ,output v-fltopend-rowid
     4284                             ) no-error.
     4285         .
     4286         v-doc-rec = ?.
     4287       end.
     4288       assign
     4289         l-query-was-opened = true
     4290       .
     4291     end.
     4292   end.
     4293     run waitfram-hide in this-procedure .
     4294       END.
     4295   END CASE.
     4296   if not p-open-query then
     4297   REPOSITION br-docs to recid v-doc-rec No-ERROR.
     4298   if not p-open-query and v-fltopend-rowid[1] <> ? then
     4299   query br-docs:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     4300   run waitfram-hide in this-procedure .
     4301   APPLY "VALUE-CHANGED" TO br-docs in frame Dialog-Frame.
     4302   APPLY "ENTRY" TO br-docs.
     4303   END PROCEDURE.
     4304   PROCEDURE proc-b-lkp :
     4305   define variable next-prev as character no-undo .
     4306   define variable v-doc-rec as recid no-undo .
     4307   if not available X_c-layout then return.
     4308   v-doc-rec = recid(X_c-layout).
     4309   DO WHILE next-prev = '':U:
     4310     if NOT available X_c-layout then do:
     4311       message "Неправильно выбрана запись истории раскладки." view-as alert-box ERROR.
     4312       return no-apply.
     4313     end.
     4314     v-doc-rec = recid (X_c-layout).
     4315     END .
     4316   reposition br-docs to recid v-doc-rec no-error.
     4317   apply "entry" to br-docs in frame Dialog-Frame.
     4318   apply "value-changed" to br-docs in frame Dialog-Frame.
     4319   END PROCEDURE.
     4320   PROCEDURE proc-b-sch :
     4321   assign
     4322     tbl = 'c-layout'
     4323     join-tbl = 'X_c-layout'
     4324     fld = ""
     4325     lab = ""
     4326     spr = ""
     4327     dim = '0'
     4328     .
     4329   run fltfield-add in this-procedure('corr-date', '', '',
     4330   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4331   run fltfield-add in this-procedure('corr-time', 'Время корр.', 'time',
     4332   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4333   run fltfield-add in this-procedure('corr-user-db-num', '', '',
     4334   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4335   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     4336   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4337   run fltfield-add in this-procedure('layout-id', 'Номер в базе', '',
     4338   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4339   Filter-Block:
     4340   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4341       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4342       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4343     run gbl/filter.w (
     4344                       input parparentproc
     4345                     , INPUT (filter-point + chr(4) + filter-label)
     4346                     , INPUT tbl
     4347                     , INPUT join-tbl
     4348                     , INPUT fld
     4349                     , INPUT lab
     4350                     , INPUT spr
     4351                     , INPUT dim ).
     4352     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     4353   END.
     4354   END PROCEDURE.
     4355   PROCEDURE proc-view-changes :
     4356   define buffer new_c-layout for ub.c-layout.
     4357   define buffer current_layout for ub.layout.
     4358   define variable v-chg-fields as character no-undo.
     4359   define variable v-old-fields as character no-undo.
     4360   define variable v-new-fields as character no-undo.
     4361   define variable ii as integer no-undo.
     4362   define variable jj as integer no-undo .
     4363   define variable v-field-name as character no-undo .
     4364   define variable v-field-label as character no-undo .
     4365   define variable v-field-function as character no-undo .
     4366   define variable v-real-field-name as character no-undo .
     4367   for each temp-changes:
     4368       delete temp-changes.
     4369   END.
     4370   if not available X_c-layout then do:
     4371     Open QUery br-changes for each temp-changes.
     4372     return.
     4373   end.
     4374   find first new_c-layout no-lock where
     4375               new_c-layout.layout-id = X_c-layout.layout-id
     4376                 AND new_c-layout.chip-num > X_c-layout.chip-num no-error.
     4377   if not available new_c-layout then do:
     4378       find first current_layout no-lock where
     4379                   current_layout.layout-id = X_c-layout.layout-id no-error.
     4380       if not available current_layout then do:
     4381           return error.
     4382       end.
     4383       buffer-compare current_layout to X_c-layout
     4384       case-sensitive
     4385       save result in v-chg-fields.
     4386       run get-line-changes-current in this-procedure ( input X_c-layout.corr-user-db-num
     4387                                                       ,input X_c-layout.chip-num).
     4388   end.
     4389   else do:
     4390       buffer-compare new_c-layout except chip-num corr-date corr-user-name corr-user-db-num  to X_c-layout
     4391       case-sensitive
     4392       save result in v-chg-fields.
     4393       run get-line-changes-hist in this-procedure (
     4394                                                     input X_c-layout.layout-id
     4395                                                   , input X_c-layout.corr-user-db-num
     4396                                                   , input X_c-layout.chip-num
     4397                                                   , input new_c-layout.corr-user-db-num
     4398                                                   , input new_c-layout.chip-num
     4399                                                   ).
     4400   end.
     4401     _ii:
     4402     do ii = 1 to num-entries(v-chg-fields):
     4403       assign
     4404       v-field-name = entry(ii, v-chg-fields)
     4405       jj = lookup(v-field-name, "layout-id,des,device-type,is-default,layout-name,layout-type,sts").
     4406       if jj = 0 then next _ii.
     4407       assign
     4408       v-field-label = entry(jj, "ID,Описание,Устройство,Обяз/пользв/Шаблон,Название,Тип,Статус")
     4409       v-field-function = entry(jj, ",,,get-is-default-name,,get-layout-type-name,get-status-name")
     4410       v-real-field-name = entry(1, v-field-name, ':')
     4411       .
     4412       create temp-changes.
     4413       assign
     4414       temp-changes.f_name = substitute("layout&1&2"
     4415                                        ,chr(4)
     4416                                        ,v-field-name)
     4417       temp-changes.l_name = substitute("Шапка раскладки &1"
     4418                                        ,v-field-label)
     4419       temp-changes.v_old =  string(buffer X_c-layout:buffer-field(v-field-name):buffer-value)
     4420       temp-changes.v_new = (if available new_c-layout
     4421                                 then string(buffer new_c-layout:buffer-field(v-field-name):buffer-value)
     4422                                 else string(buffer current_layout:buffer-field(v-field-name):buffer-value)
     4423                            )
     4424       .
     4425        if v-field-function <> '':U then do:
     4426         assign
     4427         temp-changes.v_old = DYNAMIC-function(v-field-function, temp-changes.v_old)
     4428         temp-changes.v_new = DYNAMIC-function(v-field-function, temp-changes.v_new)
     4429         .
     4430       end.
     4431   end.
     4432   Open QUery br-changes for each temp-changes.
     4433   END PROCEDURE.
     4434   PROCEDURE reposition-c-layout :
     4435   define input  parameter p-direction   as character no-undo .
     4436   define output parameter p-layout-recid as recid no-undo .
     4437     case p-direction :
     4438       when "first":U
     4439       then do:
     4440         get first br-docs.
     4441       end.
     4442       when "last":U
     4443       then do:
     4444         get last br-docs.
     4445       end.
     4446       when "prev":U
     4447       then do:
     4448         get prev br-docs.
     4449         if not available X_c-layout then do:
     4450           message
     4451           "Это первый чек списка"
     4452           view-as alert-box.
     4453         end.
     4454       end.
     4455       when "next":U
     4456       then do:
     4457         get next br-docs.
     4458         if not available X_c-layout then do:
     4459           message
     4460           "Это последний чек списка"
     4461           view-as alert-box.
     4462         end.
     4463       end.
     4464     end case .
     4465     assign
     4466     p-layout-recid = recid(X_c-layout)
     4467     .
     4468     run reposition-query in this-procedure
     4469       (input p-layout-recid
     4470       ).
     4471   END PROCEDURE.
     4472   PROCEDURE reposition-query :
     4473   define input parameter p-recid as recid no-undo .
     4474     if p-recid <> ?
     4475     then do:
     4476       reposition br-docs to recid p-recid no-error.
     4477     end.
     4478     do with frame Dialog-Frame:
     4479       apply "entry":u to browse BR-changes .
     4480       apply "VALUE-CHANGED":u to browse BR-changes .
     4481     end.
     4482   END PROCEDURE.
     4483   FUNCTION get-action RETURNS CHARACTER
     4484     ( p-action as integer ) :
     4485     define variable dops as character no-undo.
     4486   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     4487   RETURN dops.
     4488   END FUNCTION.
     4489   FUNCTION get-is-default-name RETURNS CHARACTER
     4490     ( p-is-default as integer ) :
     4491   define variable v-layout-kind-name as character no-undo.
     4492   assign
     4493   v-layout-kind-name = entry (lookup (string(p-is-default), '0,1,-1':U) + 1, ',' + 'Пользовательская,Шаблон IBS TH,Обязательная':U) no-error.
     4494   RETURN v-layout-kind-name.
     4495   END FUNCTION.
     4496   FUNCTION get-is-mandatory-name RETURNS CHARACTER
     4497     ( p-is-mandatory as integer ) :
     4498   define variable v-layout-elem-kind-name as character no-undo.
     4499   assign
     4500   v-layout-elem-kind-name = entry (lookup (string(p-is-mandatory), '0,1':U) + 1, ',' + ',Обязательная':U) no-error.
     4501   RETURN v-layout-elem-kind-name.
     4502   END FUNCTION.
     4503   FUNCTION get-layout-type-name RETURNS CHARACTER
     4504     ( input p-layout-type as character ) :
     4505   define variable v-layout-type-name as character no-undo.
     4506   assign
     4507   v-layout-type-name = entry (lookup (p-layout-type, 'th-pos-screen,th-pos-keyboard':U) + 1, ',' + 'Экран IBS TH POS,Клавиатура IBS TH POS':U) no-error.
     4508   RETURN v-layout-type-name.
     4509   END FUNCTION.
     4510   FUNCTION get-status-name RETURNS CHARACTER
     4511     ( input p-sts as integer ) :
     4512   define variable v-status-name as character no-undo.
     4513   assign
     4514   v-status-name = entry (lookup (string(p-sts), '0,1,50,99':U), 'тек,удал,блок,удаление':U) no-error.
     4515   return v-status-name.
     4516   END FUNCTION.
