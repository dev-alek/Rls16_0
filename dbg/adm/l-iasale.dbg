        1   def var vss-revision    as character no-undo init "$Revision: 138b369dad6e, 2892, rls $":U .
        2   def var vss-author      as character no-undo init "$Author: DRuban $":U .
        3   def var vss-date        as character no-undo init "$Date: Пн ноя 22 19:49:12 2021 +0300 $":U .
        4   def var vss-workfile    as character no-undo init "$Workfile: l-iasale.w $":U .
        5   def var vss-archive     as character no-undo init "$Archive: adm/l-iasale.w $":U .
        6   def var vss-description as character no-undo init "Окно входа в САРП".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       66   define new shared variable g#auto-pid           as integer   no-undo .
       67   define new shared variable conn-par             as character no-undo .
       68   define new shared variable g#auto-user-id       as character no-undo .
       69   define new shared variable g#auto-user-login    as character no-undo .
       70   define new shared variable g#auto-user-password as character no-undo .
       71   define new shared variable v-socket             as logical   no-undo .
       72   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   define new shared variable auto-window-h     as handle    no-undo .
       74   define new shared variable auto-log-msg-h    as handle    no-undo .
       75   define new shared variable hand-log-msg-h    as handle    no-undo .
       76   define new shared variable log-file-name     as character no-undo initial ? .
       77   define new shared variable add-log-file-name as character no-undo initial ? .
       78   define new shared variable writelogvalue     as character no-undo initial ? .
       79   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   procedure cur-time :
       81      define output parameter p-today as date      no-undo .
       82      define output parameter p-time  as integer   no-undo .
       83     do
       84     on error undo, return error
       85     :
       86       define variable v-date1 as date      no-undo .
       87       define variable v-date2 as date      no-undo .
       88       define variable v-time  as integer   no-undo .
       89       assign
       90         v-date1 = today
       91         v-time  = time
       92         v-date2 = today
       93       .
       94       if v-date1 <> v-date2
       95       then do:
       96         assign
       97           v-date1 = today
       98           v-time  = v-time
       99         .
      100       end.
      101       assign
      102         p-today = v-date1
      103         p-time  = v-time
      104       .
      105     end.
      106   end.
      107   function cur-time-date returns character
      108   :
      109     return string(today, '99/99/9999':U) .
      110   end.
      111   function cur-time-mjd returns decimal
      112   :
      113     define variable v-date as date      no-undo .
      114     define variable v-time as integer   no-undo .
      115     run cur-time in this-procedure
      116       (output v-date
      117       ,output v-time
      118       ) .
      119     return integer(v-date) - 2400002 + (v-time / 86400) .
      120   end.
      121   function cur-time-get-ending-index returns integer
      122   (input p-number as integer
      123   )
      124   :
      125     if p-number < 0
      126     or p-number = ?
      127     then do:
      128       return 1 .
      129     end.
      130     define variable v-rest as integer   no-undo .
      131     assign
      132       p-number = p-number modulo 100
      133     .
      134     if p-number < 20
      135     then do:
      136       assign
      137         v-rest = p-number
      138       .
      139     end.
      140     else do:
      141       assign
      142         v-rest = p-number modulo 10
      143       .
      144     end.
      145     case v-rest :
      146       when 1
      147       then do:
      148         return 2 .
      149       end.
      150       when 2 or
      151       when 3 or
      152       when 4
      153       then do:
      154         return 3 .
      155       end.
      156       otherwise do:
      157         return 1 .
      158       end.
      159     end case .
      160   end.
      161   procedure cur-time-mjd-to-date :
      162      define input  parameter i-mjd-diff as decimal no-undo.
      163      define output parameter o-Date     as date    no-undo.
      164      define output parameter o-Time     as integer no-undo.
      165      define variable v-day-number as integer   no-undo .
      166      if    i-mjd-diff < 0
      167         or i-mjd-diff = ?
      168      then do:
      169         return "?" .
      170      end.
      171      assign
      172         v-day-number = truncate(i-mjd-diff,0).
      173         o-Date = date(v-day-number + 2400002).
      174         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      175     .
      176   end.
      177   function cur-time-mjd-to-string returns character
      178   (input p-mjd-diff as decimal
      179   )
      180   :
      181     define variable v-day-number as integer   no-undo .
      182     define variable v-seconds    as integer   no-undo .
      183     define variable v-hour       as integer   no-undo .
      184     define variable v-min        as integer   no-undo .
      185     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      186     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      187     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      188     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      189     if p-mjd-diff < 0
      190     or p-mjd-diff = ?
      191     then do:
      192       return "?" .
      193     end.
      194     assign
      195       v-day-number = integer(truncate(p-mjd-diff,0))
      196       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      197     .
      198     if v-seconds > 86400
      199     then do:
      200       assign
      201         v-seconds = 86400 - 1
      202       .
      203     end.
      204     if v-seconds < 0
      205     then do:
      206       assign
      207         v-seconds = 0
      208       .
      209     end.
      210     assign
      211       v-hour = truncate(v-seconds / 3600, 0)
      212     .
      213     assign
      214       v-seconds = v-seconds modulo 3600
      215     .
      216     assign
      217       v-min = truncate(v-seconds / 60, 0)
      218     .
      219     assign
      220       v-seconds = v-seconds modulo 60
      221     .
      222     return
      223         (if v-day-number <> 0
      224           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      225           else ""
      226         )
      227       + (if v-day-number <> 0 or v-hour <> 0
      228           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      229           else ""
      230         )
      231       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      232           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      233           else ""
      234         )
      235       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      236       .
      237   end.
      238   function cur-time-string returns character
      239   :
      240     define variable v-date as date      no-undo .
      241     define variable v-time as integer   no-undo .
      242     run cur-time in this-procedure
      243       (output v-date
      244       ,output v-time
      245       ) .
      246     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      247   end.
      248   function cur-time-string-sec returns character
      249   :
      250     define variable v-date as date      no-undo .
      251     define variable v-time as integer   no-undo .
      252     run cur-time in this-procedure
      253       (output v-date
      254       ,output v-time
      255       ) .
      256     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      257   end.
      258   function cur-time-custom  returns character
      259   (input p-prefix as character
      260   ,input p-date-format as character
      261   ,input p-delimiter as character
      262   ,input p-time-format as character
      263   ,input p-suffix as character
      264   )
      265   :
      266     define variable v-date as date      no-undo .
      267     define variable v-time as integer   no-undo .
      268     run cur-time in this-procedure
      269       (output v-date
      270       ,output v-time
      271       ) .
      272     return
      273       p-prefix
      274       + string(v-date, p-date-format)
      275       + p-delimiter
      276       + string(v-time, p-time-format)
      277       + p-suffix
      278       .
      279   end.
      280   function cur-time-print  returns character
      281   :
      282     define variable v-date as date      no-undo .
      283     define variable v-time as integer   no-undo .
      284     run cur-time in this-procedure
      285       (output v-date
      286       ,output v-time
      287       ) .
      288     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      289   end.
      290   function cur-time-datetime returns datetime
      291   :
      292     define variable v-char as character no-undo .
      293     define variable v-datetime as datetime no-undo .
      294     v-char = cur-time-string().
      295     v-datetime = datetime(v-char).
      296     return  v-datetime.
      297   end.
      298   function cur-time-string-msec returns character
      299   :
      300     define variable v-date as datetime  no-undo .
      301     v-date = now.
      302     return string(v-date) .
      303   end.
      304   define stream LogStream .
      305   define variable mNoTime as logical no-undo.
      306   procedure write-to-log-notime :
      307     define input param i-str as character no-undo .
      308     mNoTime = yes.
      309     run write-to-log (i-str).
      310     mNoTime = no.
      311   end.
      312   procedure write-to-log :
      313     define input param p-str as character no-undo .
      314     do
      315     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      316     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      317     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      318     :
      319       define variable log-res        as logical   no-undo .
      320       define variable v-jj           as integer   no-undo .
      321       if    mNoTime
      322          or writelogvalue eq "AsyncProc"
      323       then
      324          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      325       else
      326          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      327       if auto-log-msg-h <> ? then do:
      328         log-res = auto-log-msg-h:move-to-eof( ) .
      329         log-res = auto-log-msg-h:insert-string( p-str ).
      330       end.
      331       if hand-log-msg-h <> ? then do:
      332         log-res = hand-log-msg-h:move-to-eof( ) .
      333         log-res = hand-log-msg-h:insert-string( p-str ).
      334       end.
      335       assign
      336         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      337         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      338         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      339       .
      340       if add-log-file-name <> ? then do:
      341         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      342           run gbl/fileapnd.p
      343             ( input entry(v-jj, add-log-file-name, chr(1) )
      344             ,input p-str
      345             ,input 20
      346             ) no-error .
      347           if error-status:error then do:
      348             return error return-value .
      349           end.
      350         end.
      351       end.
      352       if writelogvalue eq "AsyncProc"
      353       then do:
      354          p-str = trim(p-str, (chr(13) + chr(10)) )
      355       .
      356          Publish "WriteLogAsunc" (p-str,yes).
      357       end.
      358       else if writelogvalue <> "yes" then do:
      359         run gbl/fileapnd.p
      360           ( input log-file-name
      361           ,input p-str
      362           ,input 20
      363           ) no-error .
      364         if error-status:error then do:
      365           return error return-value .
      366         end.
      367       end.
      368     end.
      369   end procedure.
      370   procedure write-to-screen :
      371     define input param p-str as character no-undo .
      372     do
      373     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      374     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      375     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      376     :
      377       define variable log-res as logical no-undo.
      378       assign
      379         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      380       .
      381       if auto-log-msg-h <> ?
      382       then do:
      383         log-res = auto-log-msg-h:move-to-eof( ) .
      384         log-res = auto-log-msg-h:insert-string( p-str ).
      385       end.
      386       if hand-log-msg-h <> ?
      387       then do:
      388         log-res = hand-log-msg-h:move-to-eof( ) .
      389         log-res = hand-log-msg-h:insert-string( p-str ).
      390       end.
      391     end.
      392   end procedure.
      393   procedure send-msg-to-email :
      394     define input  parameter p-subject      as character no-undo .
      395     define input  parameter p-text-err     as character no-undo .
      396     define input  parameter p-attach-files as character no-undo .
      397     do
      398     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      399     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      400     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      401     :
      402       define variable v-tth             as handle    no-undo .
      403       define variable v-value-character as character no-undo .
      404       define variable v-value-date      as date      no-undo .
      405       define variable v-value-decimal   as decimal   no-undo .
      406       define variable v-value-integer   as integer   no-undo .
      407       define variable v-value-logical   as logical   no-undo .
      408       define variable v-param-type      as character no-undo .
      409       define variable v-email       as character no-undo .
      410       define variable v-tmp-str     as character no-undo .
      411       define variable v-tmp1-str    as character no-undo .
      412       define variable v-ind         as integer   no-undo .
      413       define variable v-num-entries as integer   no-undo .
      414       delete object v-tth no-error.
      415       run adm/shattri.p
      416         ( input "get":U
      417          ,input  "":U
      418          ,input  0
      419          ,input  'auto-task':U
      420          ,input  'send-msg-to-email':U
      421          ,output v-value-character
      422          ,output v-value-date
      423          ,output v-value-decimal
      424          ,output v-value-integer
      425          ,output v-value-logical
      426          ,output v-param-type
      427          ,input-output table-handle v-tth
      428         ) no-error .
      429       if not error-status :error  then do:
      430         assign
      431           v-tmp-str = v-value-character
      432         .
      433       end.
      434       delete object v-tth no-error.
      435       assign
      436         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      437         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      438         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      439         v-num-entries = num-entries( v-tmp-str, chr(44) )
      440         v-email       = "":U
      441       .
      442       do v-ind = 1 to v-num-entries
      443       :
      444         assign
      445           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      446         .
      447         if trim( v-tmp1-str ) <> "":U then do:
      448           if v-email = "":U then do:
      449             assign
      450               v-email = v-tmp1-str
      451             .
      452           end.
      453           else do:
      454             assign
      455               v-email = v-email + chr(44) + v-tmp1-str
      456             .
      457           end.
      458         end.
      459       end.
      460       if v-email <> "":U then do:
      461         run gbl/sendmail.p
      462           ( input v-email
      463           , input p-subject
      464           , input p-text-err
      465           , input p-attach-files
      466           ) no-error .
      467         if error-status :error
      468           or return-value <> "":U
      469         then do:
      470           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      471         end.
      472       end.
      473     end.
      474   end procedure.
      475   define variable v-preconnection as logical   no-undo .
      476   define variable v-connection    as logical   no-undo .
      477   define variable v-param         as character no-undo .
      478   define variable v-param-name    as character no-undo .
      479   define variable v-param-value   as character no-undo .
      480   define variable ind             as integer   no-undo .
      481   define variable v-num-entries   as integer   no-undo .
      482   define variable v-par-val       as character no-undo .
      483   define variable v-par-type      as character no-undo .
      484   define variable v-mode          as character no-undo .
      485   define variable v-updating      as logical   no-undo init false .
      486   DEFINE VAR w-login AS WIDGET-HANDLE NO-UNDO.
      487   DEFINE BUTTON b-OK AUTO-GO
      488        LABEL "&Ввод":L
      489        SIZE 10 BY 1.
      490   DEFINE BUTTON b-quit AUTO-END-KEY
      491        LABEL "&Отмена":L
      492        SIZE 10 BY 1.
      493   DEFINE VARIABLE name AS CHARACTER FORMAT "X(12)":U
      494        LABEL "Логин"
      495        VIEW-AS FILL-IN
      496        SIZE 20 BY 1 NO-UNDO.
      497   DEFINE VARIABLE password AS CHARACTER FORMAT "X(16)":U
      498        LABEL "Пароль"
      499        VIEW-AS FILL-IN
      500        SIZE 20 BY 1 NO-UNDO.
      501   DEFINE VARIABLE password_display AS CHARACTER FORMAT "X(16)":U
      502        LABEL "Пароль"
      503        VIEW-AS FILL-IN
      504        SIZE 20 BY 1 NO-UNDO.
      505   DEFINE IMAGE IMAGE-1
      506        FILENAME "cmp/ith.bmp":U
      507        SIZE 40 BY 8.88.
      508   DEFINE FRAME FRAME-A
      509        name AT ROW 4.96 COL 10 COLON-ALIGNED
      510        password AT ROW 6.17 COL 10 COLON-ALIGNED BLANK
      511        password_display AT ROW 6.17 COL 10 COLON-ALIGNED  PASSWORD-FIELD
      512        b-OK AT ROW 8 COL 11.75
      513        b-quit AT ROW 8 COL 21.88
      514        IMAGE-1 AT ROW 1.08 COL 1.13
      515       WITH 1 DOWN NO-BOX OVERLAY
      516            SIDE-LABELS THREE-D
      517            AT COL 1 ROW 1
      518            SIZE 40.13 BY 8.96.
      519   IF SESSION:DISPLAY-TYPE = "GUI":U and not session:batch-mode THEN
      520     CREATE WINDOW w-login ASSIGN
      521            HIDDEN             = YES
      522            TITLE              = "TH САРП"
      523            COLUMN             = 27
      524            ROW                = 7.58
      525            HEIGHT             = 9.13
      526            WIDTH              = 40.25
      527            MAX-HEIGHT         = 35.63
      528            MAX-WIDTH          = 160
      529            VIRTUAL-HEIGHT     = 35.63
      530            VIRTUAL-WIDTH      = 160
      531            RESIZE             = no
      532            SCROLL-BARS        = yes
      533            STATUS-AREA        = no
      534            BGCOLOR            = ?
      535            FGCOLOR            = ?
      536            THREE-D            = yes
      537            MESSAGE-AREA       = no
      538            SENSITIVE          = yes.
      539   ELSE w-login = CURRENT-WINDOW.
      540   IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(w-login)
      541   THEN w-login:HIDDEN = no.
      542   ON VALUE-CHANGED OF password_display IN FRAME FRAME-A DO:
      543       IF NOT v-updating THEN DO:
      544           ASSIGN password:SCREEN-VALUE = password_display:SCREEN-VALUE.
      545       END.
      546   END.
      547   ON ANY-KEY OF password_display IN FRAME FRAME-A DO:
      548       IF LASTKEY = KEY-CODE("CTRL-V") THEN DO:
      549              ASSIGN
      550              v-updating = TRUE
      551              password:SCREEN-VALUE = System.Windows.Forms.Clipboard:GetText()
      552              password_display:SCREEN-VALUE = System.Windows.Forms.Clipboard:GetText()
      553              v-updating = FALSE.
      554              System.Windows.Forms.Clipboard:Clear().
      555              RETURN NO-APPLY.
      556       END.
      557   END.
      558   ON CHOOSE OF b-OK IN FRAME FRAME-A
      559   DO:
      560     if name :screen-value = "" then do:
      561       message
      562         "Введите имя пользователя"
      563         view-as alert-box information .
      564       apply "entry" to name .
      565       return no-apply .
      566     end.
      567   END.
      568   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      569   on help of frame FRAME-A
      570   do:
      571     run gbl/app_help.p
      572       (input this-procedure :file-name
      573       ,input ''
      574       ,input ?
      575       ) no-error.
      576     if error-status :error then do:
      577       message
      578         "Ошибка при вызове помощи"
      579         error-status :get-message(1)
      580         view-as alert-box .
      581     end.
      582   end.
      583   procedure proc-alt-shift-f2:
      584     if not ibs.th.gbl.gbl-var:rcode
      585   then
      586     run gbl\inidebug.p .
      587   end.
      588   procedure proc-alt-shift-f3:
      589     run gbl/prvssinf.p
      590       ( input this-procedure
      591       ) .
      592   end.
      593   define variable v-inform-launched as logical no-undo initial false .
      594   procedure proc-alt-shift-f4:
      595     define variable v-action as character no-undo .
      596     if v-inform-launched = false then do:
      597       assign
      598         v-inform-launched = true
      599       .
      600       run gbl/d-inform.w
      601         (  input self
      602         ,  input this-procedure
      603         , output v-action
      604         ) no-error .
      605       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      606       assign
      607         v-inform-launched = false
      608       .
      609     end.
      610   end.
      611   procedure proc-alt-f1:
      612     run gbl/corrhelp.p
      613       (input this-procedure
      614       ) .
      615   end .
      616   on alt-shift-f2 anywhere do:
      617     run proc-alt-shift-f2.
      618   end.
      619   on alt-shift-f3 anywhere do:
      620     run proc-alt-shift-f3 in this-procedure .
      621   end.
      622   on alt-shift-f4 anywhere do:
      623     run proc-alt-shift-f4 in this-procedure.
      624   end.
      625   on alt-f1 anywhere do:
      626     run proc-alt-f1 in this-procedure .
      627   end.
      628   on "ENTRY" of b-ok do:
      629     if lastkey = keycode ("RETURN") then apply "CHOOSE" to b-ok in frame FRAME-A.
      630   end.
      631   if valid-handle(w-login) then
      632   do:
      633   on window-close of w-login do:
      634     apply "end-error" to frame FRAME-A.
      635   end.
      636   ASSIGN CURRENT-WINDOW             = w-login
      637       SESSION:SYSTEM-ALERT-BOXES = (CURRENT-WINDOW:MESSAGE-AREA = NO).
      638       session:three-d = yes.
      639   end.
      640   PAUSE 0 BEFORE-HIDE.
      641   if session:date-format <> "dmy":U
      642     or session:numeric-decimal-point <> ".":U
      643     or session:numeric-separator <> ",":U
      644   then do:
      645     message
      646       vss-workfile vss-revision vss-description skip
      647       "Неправильные установки сессии progress!" skip
      648       "Формат даты должен быть - " "'dmy'":U skip
      649       "Десятичный разделитель - " "'.'":U skip
      650       "Разделитель тысяч - " "','":U skip
      651       view-as alert-box error .
      652     quit.
      653   end.
      654   assign
      655     v-preconnection = FALSE
      656     name            = "":U
      657     password        = "":U
      658   .
      659   if SESSION:PARAMETER <> "":U
      660     and SESSION:PARAMETER <> ?
      661   then do:
      662     assign
      663       v-num-entries = num-entries( SESSION:PARAMETER, ",":U )
      664     .
      665     do ind = 1 to v-num-entries :
      666       assign
      667         v-param = entry( ind, SESSION:PARAMETER, ",":U )
      668       .
      669       if num-entries( v-param, ":":U ) > 1 then do:
      670         assign
      671           v-param-name  = entry( 1, v-param, ":":U )
      672           v-param-value = substring( v-param, length( v-param-name ) + 2 )
      673         .
      674         case v-param-name :
      675           when "U":U then do:
      676             assign
      677               name = v-param-value
      678             .
      679           end.
      680           when "P":U then do:
      681             assign
      682               password = v-param-value
      683             .
      684           end.
      685           when "M":U then do:
      686             assign
      687               v-mode = replace( v-param-value, chr(4), ",":U )
      688             .
      689           end.
      690           when "A":U then .
      691           otherwise do:
      692             message
      693               substitute("Неизвестный параметр сессии СПН: &1", v-param) skip
      694               substitute("Параметр игнорируется.") skip
      695               view-as alert-box information .
      696           end.
      697         end case.
      698       end.
      699       else do:
      700         message
      701           substitute("Неизвестный параметр сессии СПН: &1", v-param) skip
      702           substitute("Параметр игнорируется.") skip
      703           view-as alert-box information .
      704       end.
      705     end.
      706     if name <> "":U
      707       and password <> "":U
      708     then do:
      709       run adm/autoinit.p ( input name
      710                       ,input password
      711                     ) no-error.
      712       run adm/autoconn.p no-error.
      713       if error-status :error then do:
      714         assign
      715           password = "":U
      716         .
      717       end.
      718       else do:
      719         assign
      720           v-preconnection = TRUE
      721         .
      722       end.
      723       run gbl/dbdiscon.p no-error.
      724     end.
      725   end.
      726   if v-preconnection = FALSE then do:
      727     run enable_UI.
      728   end.
      729   assign
      730     session :data-entry-return = yes
      731   .
      732   run gbl/font-chk.p no-error .
      733   if error-status :error then do:
      734     message
      735       vss-workfile vss-revision vss-description skip
      736       "Неправильные установки системных шрифтов" skip
      737       "Обратитесь к администратору" skip
      738       error-status :get-message(1) skip
      739       return-value skip
      740       view-as alert-box information .
      741   end.
      742   do1:
      743   do
      744   on error  undo, leave
      745   on endkey undo, leave
      746   on stop   undo, leave
      747   :
      748     if v-preconnection = FALSE then do:
      749       WAIT-FOR GO OF frame FRAME-A focus name.
      750     end.
      751     assign
      752       name
      753       password
      754       v-connection = FALSE
      755     .
      756     run adm/autoinit.p ( input name
      757                     ,input password
      758                    ) no-error.
      759     if error-status :error then do:
      760       message
      761         vss-workfile vss-revision vss-description skip
      762         "Ошибка инициализации переменных для системы автоматического запуска" skip
      763         return-value
      764         view-as alert-box error.
      765       leave do1.
      766     end.
      767     run adm/autoconn.p no-error.
      768     if error-status:error then do:
      769       message
      770         vss-workfile vss-revision vss-description skip
      771         return-value
      772         view-as alert-box error.
      773       leave do1.
      774     end.
      775     assign
      776       v-connection = TRUE
      777     .
      778     run gbl/dbdiscon.p no-error.
      779   end.
      780   assign
      781     session :data-entry-return = no
      782   .
      783   RUN disable_UI.
      784   if v-connection
      785     and not error-status:error then do:
      786     assign
      787       log-file-name = "ext-sale.log"
      788     .
      789     run adm/automain.w
      790       ( input 'autosale':U
      791        ,input v-mode
      792       ) no-error.
      793   end.
      794   run gbl/dbdiscon.p no-error.
      795   quit.
      796   PROCEDURE disable_UI :
      797     IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(w-login)
      798     THEN DELETE WIDGET w-login.
      799     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
      800   END PROCEDURE.
      801   PROCEDURE enable_UI :
      802     ENABLE IMAGE-1 name password password_display  b-OK b-quit
      803         WITH FRAME FRAME-A IN WINDOW w-login.
      804     VIEW w-login.
      805   END PROCEDURE.
