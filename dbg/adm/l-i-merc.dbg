        1   def var vss-revision    as character no-undo init "$Revision: 138b369dad6e, 2892, rls $":U .
        2   def var vss-author      as character no-undo init "$Author: DRuban $":U .
        3   def var vss-date        as character no-undo init "$Date: Пн ноя 22 19:49:12 2021 +0300 $":U .
        4   def var vss-workfile    as character no-undo init "$Workfile: l-i-merc.w $":U .
        5   def var vss-archive     as character no-undo init "$Archive: adm/l-i-merc.w $":U .
        6   def var vss-description as character no-undo init "Окно входа в ФГИС Меркурий".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   procedure proc-alt-shift-f2:
       66     if not ibs.th.gbl.gbl-var:rcode
       67   then
       68     run gbl\inidebug.p .
       69   end.
       70   procedure proc-alt-shift-f3:
       71     run gbl/prvssinf.p
       72       ( input this-procedure
       73       ) .
       74   end.
       75   define variable v-inform-launched as logical no-undo initial false .
       76   procedure proc-alt-shift-f4:
       77     define variable v-action as character no-undo .
       78     if v-inform-launched = false then do:
       79       assign
       80         v-inform-launched = true
       81       .
       82       run gbl/d-inform.w
       83         (  input self
       84         ,  input this-procedure
       85         , output v-action
       86         ) no-error .
       87       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       88       assign
       89         v-inform-launched = false
       90       .
       91     end.
       92   end.
       93   procedure proc-alt-f1:
       94     run gbl/corrhelp.p
       95       (input this-procedure
       96       ) .
       97   end .
       98   on alt-shift-f2 anywhere do:
       99     run proc-alt-shift-f2.
      100   end.
      101   on alt-shift-f3 anywhere do:
      102     run proc-alt-shift-f3 in this-procedure .
      103   end.
      104   on alt-shift-f4 anywhere do:
      105     run proc-alt-shift-f4 in this-procedure.
      106   end.
      107   on alt-f1 anywhere do:
      108     run proc-alt-f1 in this-procedure .
      109   end.
      110   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      111   define new shared variable g#auto-pid           as integer   no-undo .
      112   define new shared variable conn-par             as character no-undo .
      113   define new shared variable g#auto-user-id       as character no-undo .
      114   define new shared variable g#auto-user-login    as character no-undo .
      115   define new shared variable g#auto-user-password as character no-undo .
      116   define new shared variable v-socket             as logical   no-undo .
      117   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      118   define new shared variable auto-window-h     as handle    no-undo .
      119   define new shared variable auto-log-msg-h    as handle    no-undo .
      120   define new shared variable hand-log-msg-h    as handle    no-undo .
      121   define new shared variable log-file-name     as character no-undo initial ? .
      122   define new shared variable add-log-file-name as character no-undo initial ? .
      123   define new shared variable writelogvalue     as character no-undo initial ? .
      124   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125   procedure cur-time :
      126      define output parameter p-today as date      no-undo .
      127      define output parameter p-time  as integer   no-undo .
      128     do
      129     on error undo, return error
      130     :
      131       define variable v-date1 as date      no-undo .
      132       define variable v-date2 as date      no-undo .
      133       define variable v-time  as integer   no-undo .
      134       assign
      135         v-date1 = today
      136         v-time  = time
      137         v-date2 = today
      138       .
      139       if v-date1 <> v-date2
      140       then do:
      141         assign
      142           v-date1 = today
      143           v-time  = v-time
      144         .
      145       end.
      146       assign
      147         p-today = v-date1
      148         p-time  = v-time
      149       .
      150     end.
      151   end.
      152   function cur-time-date returns character
      153   :
      154     return string(today, '99/99/9999':U) .
      155   end.
      156   function cur-time-mjd returns decimal
      157   :
      158     define variable v-date as date      no-undo .
      159     define variable v-time as integer   no-undo .
      160     run cur-time in this-procedure
      161       (output v-date
      162       ,output v-time
      163       ) .
      164     return integer(v-date) - 2400002 + (v-time / 86400) .
      165   end.
      166   function cur-time-get-ending-index returns integer
      167   (input p-number as integer
      168   )
      169   :
      170     if p-number < 0
      171     or p-number = ?
      172     then do:
      173       return 1 .
      174     end.
      175     define variable v-rest as integer   no-undo .
      176     assign
      177       p-number = p-number modulo 100
      178     .
      179     if p-number < 20
      180     then do:
      181       assign
      182         v-rest = p-number
      183       .
      184     end.
      185     else do:
      186       assign
      187         v-rest = p-number modulo 10
      188       .
      189     end.
      190     case v-rest :
      191       when 1
      192       then do:
      193         return 2 .
      194       end.
      195       when 2 or
      196       when 3 or
      197       when 4
      198       then do:
      199         return 3 .
      200       end.
      201       otherwise do:
      202         return 1 .
      203       end.
      204     end case .
      205   end.
      206   procedure cur-time-mjd-to-date :
      207      define input  parameter i-mjd-diff as decimal no-undo.
      208      define output parameter o-Date     as date    no-undo.
      209      define output parameter o-Time     as integer no-undo.
      210      define variable v-day-number as integer   no-undo .
      211      if    i-mjd-diff < 0
      212         or i-mjd-diff = ?
      213      then do:
      214         return "?" .
      215      end.
      216      assign
      217         v-day-number = truncate(i-mjd-diff,0).
      218         o-Date = date(v-day-number + 2400002).
      219         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      220     .
      221   end.
      222   function cur-time-mjd-to-string returns character
      223   (input p-mjd-diff as decimal
      224   )
      225   :
      226     define variable v-day-number as integer   no-undo .
      227     define variable v-seconds    as integer   no-undo .
      228     define variable v-hour       as integer   no-undo .
      229     define variable v-min        as integer   no-undo .
      230     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      231     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      232     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      233     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      234     if p-mjd-diff < 0
      235     or p-mjd-diff = ?
      236     then do:
      237       return "?" .
      238     end.
      239     assign
      240       v-day-number = integer(truncate(p-mjd-diff,0))
      241       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      242     .
      243     if v-seconds > 86400
      244     then do:
      245       assign
      246         v-seconds = 86400 - 1
      247       .
      248     end.
      249     if v-seconds < 0
      250     then do:
      251       assign
      252         v-seconds = 0
      253       .
      254     end.
      255     assign
      256       v-hour = truncate(v-seconds / 3600, 0)
      257     .
      258     assign
      259       v-seconds = v-seconds modulo 3600
      260     .
      261     assign
      262       v-min = truncate(v-seconds / 60, 0)
      263     .
      264     assign
      265       v-seconds = v-seconds modulo 60
      266     .
      267     return
      268         (if v-day-number <> 0
      269           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      270           else ""
      271         )
      272       + (if v-day-number <> 0 or v-hour <> 0
      273           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      274           else ""
      275         )
      276       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      277           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      278           else ""
      279         )
      280       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      281       .
      282   end.
      283   function cur-time-string returns character
      284   :
      285     define variable v-date as date      no-undo .
      286     define variable v-time as integer   no-undo .
      287     run cur-time in this-procedure
      288       (output v-date
      289       ,output v-time
      290       ) .
      291     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      292   end.
      293   function cur-time-string-sec returns character
      294   :
      295     define variable v-date as date      no-undo .
      296     define variable v-time as integer   no-undo .
      297     run cur-time in this-procedure
      298       (output v-date
      299       ,output v-time
      300       ) .
      301     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      302   end.
      303   function cur-time-custom  returns character
      304   (input p-prefix as character
      305   ,input p-date-format as character
      306   ,input p-delimiter as character
      307   ,input p-time-format as character
      308   ,input p-suffix as character
      309   )
      310   :
      311     define variable v-date as date      no-undo .
      312     define variable v-time as integer   no-undo .
      313     run cur-time in this-procedure
      314       (output v-date
      315       ,output v-time
      316       ) .
      317     return
      318       p-prefix
      319       + string(v-date, p-date-format)
      320       + p-delimiter
      321       + string(v-time, p-time-format)
      322       + p-suffix
      323       .
      324   end.
      325   function cur-time-print  returns character
      326   :
      327     define variable v-date as date      no-undo .
      328     define variable v-time as integer   no-undo .
      329     run cur-time in this-procedure
      330       (output v-date
      331       ,output v-time
      332       ) .
      333     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      334   end.
      335   function cur-time-datetime returns datetime
      336   :
      337     define variable v-char as character no-undo .
      338     define variable v-datetime as datetime no-undo .
      339     v-char = cur-time-string().
      340     v-datetime = datetime(v-char).
      341     return  v-datetime.
      342   end.
      343   function cur-time-string-msec returns character
      344   :
      345     define variable v-date as datetime  no-undo .
      346     v-date = now.
      347     return string(v-date) .
      348   end.
      349   define stream LogStream .
      350   define variable mNoTime as logical no-undo.
      351   procedure write-to-log-notime :
      352     define input param i-str as character no-undo .
      353     mNoTime = yes.
      354     run write-to-log (i-str).
      355     mNoTime = no.
      356   end.
      357   procedure write-to-log :
      358     define input param p-str as character no-undo .
      359     do
      360     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      361     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      362     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      363     :
      364       define variable log-res        as logical   no-undo .
      365       define variable v-jj           as integer   no-undo .
      366       if    mNoTime
      367          or writelogvalue eq "AsyncProc"
      368       then
      369          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      370       else
      371          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      372       if auto-log-msg-h <> ? then do:
      373         log-res = auto-log-msg-h:move-to-eof( ) .
      374         log-res = auto-log-msg-h:insert-string( p-str ).
      375       end.
      376       if hand-log-msg-h <> ? then do:
      377         log-res = hand-log-msg-h:move-to-eof( ) .
      378         log-res = hand-log-msg-h:insert-string( p-str ).
      379       end.
      380       assign
      381         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      382         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      383         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      384       .
      385       if add-log-file-name <> ? then do:
      386         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      387           run gbl/fileapnd.p
      388             ( input entry(v-jj, add-log-file-name, chr(1) )
      389             ,input p-str
      390             ,input 20
      391             ) no-error .
      392           if error-status:error then do:
      393             return error return-value .
      394           end.
      395         end.
      396       end.
      397       if writelogvalue eq "AsyncProc"
      398       then do:
      399          p-str = trim(p-str, (chr(13) + chr(10)) )
      400       .
      401          Publish "WriteLogAsunc" (p-str,yes).
      402       end.
      403       else if writelogvalue <> "yes" then do:
      404         run gbl/fileapnd.p
      405           ( input log-file-name
      406           ,input p-str
      407           ,input 20
      408           ) no-error .
      409         if error-status:error then do:
      410           return error return-value .
      411         end.
      412       end.
      413     end.
      414   end procedure.
      415   procedure write-to-screen :
      416     define input param p-str as character no-undo .
      417     do
      418     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      419     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      420     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      421     :
      422       define variable log-res as logical no-undo.
      423       assign
      424         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      425       .
      426       if auto-log-msg-h <> ?
      427       then do:
      428         log-res = auto-log-msg-h:move-to-eof( ) .
      429         log-res = auto-log-msg-h:insert-string( p-str ).
      430       end.
      431       if hand-log-msg-h <> ?
      432       then do:
      433         log-res = hand-log-msg-h:move-to-eof( ) .
      434         log-res = hand-log-msg-h:insert-string( p-str ).
      435       end.
      436     end.
      437   end procedure.
      438   procedure send-msg-to-email :
      439     define input  parameter p-subject      as character no-undo .
      440     define input  parameter p-text-err     as character no-undo .
      441     define input  parameter p-attach-files as character no-undo .
      442     do
      443     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      444     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      445     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      446     :
      447       define variable v-tth             as handle    no-undo .
      448       define variable v-value-character as character no-undo .
      449       define variable v-value-date      as date      no-undo .
      450       define variable v-value-decimal   as decimal   no-undo .
      451       define variable v-value-integer   as integer   no-undo .
      452       define variable v-value-logical   as logical   no-undo .
      453       define variable v-param-type      as character no-undo .
      454       define variable v-email       as character no-undo .
      455       define variable v-tmp-str     as character no-undo .
      456       define variable v-tmp1-str    as character no-undo .
      457       define variable v-ind         as integer   no-undo .
      458       define variable v-num-entries as integer   no-undo .
      459       delete object v-tth no-error.
      460       run adm/shattri.p
      461         ( input "get":U
      462          ,input  "":U
      463          ,input  0
      464          ,input  'auto-task':U
      465          ,input  'send-msg-to-email':U
      466          ,output v-value-character
      467          ,output v-value-date
      468          ,output v-value-decimal
      469          ,output v-value-integer
      470          ,output v-value-logical
      471          ,output v-param-type
      472          ,input-output table-handle v-tth
      473         ) no-error .
      474       if not error-status :error  then do:
      475         assign
      476           v-tmp-str = v-value-character
      477         .
      478       end.
      479       delete object v-tth no-error.
      480       assign
      481         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      482         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      483         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      484         v-num-entries = num-entries( v-tmp-str, chr(44) )
      485         v-email       = "":U
      486       .
      487       do v-ind = 1 to v-num-entries
      488       :
      489         assign
      490           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      491         .
      492         if trim( v-tmp1-str ) <> "":U then do:
      493           if v-email = "":U then do:
      494             assign
      495               v-email = v-tmp1-str
      496             .
      497           end.
      498           else do:
      499             assign
      500               v-email = v-email + chr(44) + v-tmp1-str
      501             .
      502           end.
      503         end.
      504       end.
      505       if v-email <> "":U then do:
      506         run gbl/sendmail.p
      507           ( input v-email
      508           , input p-subject
      509           , input p-text-err
      510           , input p-attach-files
      511           ) no-error .
      512         if error-status :error
      513           or return-value <> "":U
      514         then do:
      515           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      516         end.
      517       end.
      518     end.
      519   end procedure.
      520   define variable v-preconnection as logical   no-undo .
      521   define variable v-connection as logical no-undo .
      522   define variable v-param         as character no-undo .
      523   define variable v-param-name    as character no-undo .
      524   define variable v-param-value   as character no-undo .
      525   define variable ind             as integer   no-undo .
      526   define variable v-num-entries   as integer   no-undo .
      527   define variable v-mode          as character no-undo .
      528   define variable v-updating      as logical   no-undo init false .
      529   DEFINE VAR w-login AS WIDGET-HANDLE NO-UNDO.
      530   DEFINE BUTTON b-OK AUTO-GO
      531        LABEL "&Ввод":L
      532        SIZE 10 BY 1.
      533   DEFINE BUTTON b-quit AUTO-END-KEY
      534        LABEL "&Отмена":L
      535        SIZE 10 BY 1.
      536   DEFINE VARIABLE name AS CHARACTER FORMAT "X(12)":U
      537        LABEL "Логин"
      538        VIEW-AS FILL-IN
      539        SIZE 20 BY 1 NO-UNDO.
      540   DEFINE VARIABLE password AS CHARACTER FORMAT "X(16)":U
      541        LABEL "Пароль"
      542        VIEW-AS FILL-IN
      543        SIZE 20 BY 1 NO-UNDO.
      544   DEFINE VARIABLE password_display AS CHARACTER FORMAT "X(16)":U
      545        LABEL "Пароль"
      546        VIEW-AS FILL-IN
      547        SIZE 20 BY 1 NO-UNDO.
      548   DEFINE IMAGE IMAGE-1
      549        FILENAME "cmp/ith.bmp":U
      550        SIZE 40 BY 8.88.
      551   DEFINE FRAME FRAME-A
      552        name AT ROW 4.96 COL 10 COLON-ALIGNED
      553        password AT ROW 6.17 COL 10 COLON-ALIGNED BLANK
      554        password_display AT ROW 6.17 COL 10 COLON-ALIGNED  PASSWORD-FIELD
      555        b-OK AT ROW 8 COL 11.75
      556        b-quit AT ROW 8 COL 21.88
      557        IMAGE-1 AT ROW 1 COL 1.13
      558       WITH 1 DOWN NO-BOX OVERLAY
      559            SIDE-LABELS THREE-D
      560            AT COL 1 ROW 1
      561            SIZE 40.13 BY 8.96.
      562   IF SESSION:DISPLAY-TYPE = "GUI":U and not session:batch-mode THEN
      563     CREATE WINDOW w-login ASSIGN
      564            HIDDEN             = YES
      565            TITLE              = "TH ФГИС Меркурий"
      566            COLUMN             = 27
      567            ROW                = 7.58
      568            HEIGHT             = 9.13
      569            WIDTH              = 40.25
      570            MAX-HEIGHT         = 35.63
      571            MAX-WIDTH          = 160
      572            VIRTUAL-HEIGHT     = 35.63
      573            VIRTUAL-WIDTH      = 160
      574            RESIZE             = no
      575            SCROLL-BARS        = yes
      576            STATUS-AREA        = no
      577            BGCOLOR            = ?
      578            FGCOLOR            = ?
      579            THREE-D            = yes
      580            MESSAGE-AREA       = no
      581            SENSITIVE          = yes.
      582   ELSE w-login = CURRENT-WINDOW.
      583   IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(w-login)
      584   THEN w-login:HIDDEN = no.
      585   ON VALUE-CHANGED OF password_display IN FRAME FRAME-A DO:
      586       IF NOT v-updating THEN DO:
      587           ASSIGN password:SCREEN-VALUE = password_display:SCREEN-VALUE.
      588       END.
      589   END.
      590   ON ANY-KEY OF password_display IN FRAME FRAME-A DO:
      591       IF LASTKEY = KEY-CODE("CTRL-V") THEN DO:
      592              ASSIGN
      593              v-updating = TRUE
      594              password:SCREEN-VALUE = System.Windows.Forms.Clipboard:GetText()
      595              password_display:SCREEN-VALUE = System.Windows.Forms.Clipboard:GetText()
      596              v-updating = FALSE.
      597              System.Windows.Forms.Clipboard:Clear().
      598              RETURN NO-APPLY.
      599       END.
      600   END.
      601   ON CHOOSE OF b-OK IN FRAME FRAME-A
      602   DO:
      603     if name :screen-value = "" then do:
      604       message
      605         "Введите имя пользователя"
      606         view-as alert-box information .
      607       apply "entry" to name .
      608       return no-apply .
      609     end.
      610   END.
      611   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      612   on help of frame FRAME-A
      613   do:
      614     run gbl/app_help.p
      615       (input this-procedure :file-name
      616       ,input ''
      617       ,input ?
      618       ) no-error.
      619     if error-status :error then do:
      620       message
      621         "Ошибка при вызове помощи"
      622         error-status :get-message(1)
      623         view-as alert-box .
      624     end.
      625   end.
      626   on "ENTRY" of b-ok do:
      627     if lastkey = keycode ("RETURN") then apply "CHOOSE" to b-ok in frame FRAME-A.
      628   end.
      629   if valid-handle(w-login) then
      630   do:
      631   on window-close of w-login do:
      632     apply "end-error" to frame FRAME-A.
      633   end.
      634   ASSIGN CURRENT-WINDOW             = w-login
      635       SESSION:SYSTEM-ALERT-BOXES = (CURRENT-WINDOW:MESSAGE-AREA = NO).
      636       session:three-d = yes.
      637   end.
      638   PAUSE 0 BEFORE-HIDE.
      639   if session:date-format <> "dmy":U
      640     or session:numeric-decimal-point <> ".":U
      641     or session:numeric-separator <> ",":U
      642   then do:
      643     message
      644       vss-workfile vss-revision vss-description skip
      645       "Неправильные установки сессии progress!" skip
      646       "Формат даты должен быть - " "'dmy'":U skip
      647       "Десятичный разделитель - " "'.'":U skip
      648       "Разделитель тысяч - " "','":U skip
      649       view-as alert-box error .
      650     quit.
      651   end.
      652   assign
      653     v-preconnection = FALSE
      654     name            = "":U
      655     password        = "":U
      656   .
      657   if SESSION:PARAMETER <> "":U
      658     and SESSION:PARAMETER <> ?
      659   then do:
      660     assign
      661       v-num-entries = num-entries( SESSION:PARAMETER, ",":U )
      662     .
      663     do ind = 1 to v-num-entries :
      664       assign
      665         v-param = entry( ind, SESSION:PARAMETER, ",":U )
      666       .
      667       if num-entries( v-param, ":":U ) > 1 then do:
      668         assign
      669           v-param-name  = entry( 1, v-param, ":":U )
      670           v-param-value = substring( v-param, length( v-param-name ) + 2 )
      671         .
      672         case v-param-name :
      673           when "U":U then do:
      674             assign
      675               name = v-param-value
      676             .
      677           end.
      678           when "P":U then do:
      679             assign
      680               password = v-param-value
      681             .
      682           end.
      683           when "M":U then do:
      684             assign
      685               v-mode = replace( v-param-value, chr(4), ",":U )
      686             .
      687           end.
      688           when "A":U then .
      689           otherwise do:
      690             message
      691               substitute("Неизвестный параметр сессии СПН: &1", v-param) skip
      692               substitute("Параметр игнорируется.") skip
      693               view-as alert-box information .
      694           end.
      695         end case.
      696       end.
      697       else do:
      698         message
      699           substitute("Неизвестный параметр сессии СПН: &1", v-param) skip
      700           substitute("Параметр игнорируется.") skip
      701           view-as alert-box information .
      702       end.
      703     end.
      704     if name <> "":U
      705       and password <> "":U
      706     then do:
      707       run adm/autoinit.p ( input name
      708                       ,input password
      709                     ) no-error.
      710       run adm/autoconn.p no-error.
      711       if error-status :error then do:
      712         assign
      713           password = "":U
      714         .
      715       end.
      716       else do:
      717         assign
      718           v-preconnection = TRUE
      719         .
      720       end.
      721       run gbl/dbdiscon.p no-error.
      722     end.
      723   end.
      724   if v-preconnection = FALSE then do:
      725     run enable_UI.
      726   end.
      727   assign
      728     session :data-entry-return = yes
      729   .
      730   run gbl/font-chk.p no-error .
      731   if error-status :error then do:
      732     message
      733       vss-workfile vss-revision vss-description skip
      734       "Неправильные установки системных шрифтов" skip
      735       "Обратитесь к администратору" skip
      736       error-status :get-message(1) skip
      737       return-value skip
      738       view-as alert-box information .
      739   end.
      740   do1:
      741   do
      742   on error  undo, leave
      743   on endkey undo, leave
      744   on stop   undo, leave
      745   :
      746     if v-preconnection = FALSE then do:
      747       WAIT-FOR GO OF frame FRAME-A focus name.
      748     end.
      749     assign
      750       name
      751       password
      752       v-connection = FALSE
      753     .
      754     run adm/autoinit.p ( input name
      755                     ,input password
      756                    ) no-error.
      757     if error-status :error then do:
      758       message
      759         vss-workfile vss-revision vss-description skip
      760         "Ошибка инициализации переменных для системы автоматического запуска" skip
      761         return-value
      762         view-as alert-box error.
      763       leave do1.
      764     end.
      765     run adm/autoconn.p no-error.
      766     if error-status:error then do:
      767       message
      768         vss-workfile vss-revision vss-description skip
      769         return-value
      770         view-as alert-box error.
      771       leave do1.
      772     end.
      773     assign
      774       v-connection = TRUE
      775     .
      776     run gbl/dbdiscon.p no-error.
      777   end.
      778   assign
      779     session :data-entry-return = no
      780   .
      781   RUN disable_UI.
      782   if v-connection
      783     and not error-status:error then do:
      784     assign
      785       log-file-name = "mercury.log"
      786     .
      787     run adm/automain.w
      788       ( input 'mercury':U
      789        ,input v-mode
      790       ) no-error.
      791   end.
      792   run gbl/dbdiscon.p no-error.
      793   quit.
      794   PROCEDURE disable_UI :
      795     IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(w-login)
      796     THEN DELETE WIDGET w-login.
      797     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
      798   END PROCEDURE.
      799   PROCEDURE enable_UI :
      800     ENABLE IMAGE-1 name password password_display b-OK b-quit
      801         WITH FRAME FRAME-A IN WINDOW w-login.
      802     VIEW w-login.
      803   END PROCEDURE.
