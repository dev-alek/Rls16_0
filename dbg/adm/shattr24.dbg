     1601               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1602             no-error .
     1603           if error-status :error
     1604           or error-status :get-message(1) <> ""
     1605           then do:
     1606             undo move_block, retry move_block .
     1607           end.
     1608         end.
     1609         assign
     1610           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1611           no-error .
     1612         if error-status :error
     1613         or error-status :get-message(1) <> ""
     1614         then do:
     1615           undo move_block, retry move_block.
     1616         end.
     1617         assign
     1618           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1619         no-error .
     1620         if error-status :error
     1621         or error-status :get-message(1) <> ""
     1622         then do:
     1623           undo move_block, retry move_block.
     1624         end.
     1625         if frame Dialog-Frame :scrollable = true
     1626         then do:
     1627           assign
     1628             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1629           no-error .
     1630           if error-status :error
     1631           or error-status :get-message(1) <> ""
     1632           then do:
     1633             undo move_block, retry move_block.
     1634           end.
     1635         end.
     1636       end.
     1637       if p-move-resize
     1638       then do:
     1639         run diasize_position-resize-button in this-procedure .
     1640       end.
     1641       if v-diasize-wndstore = true
     1642       then do:
     1643         if connected("ub") = true
     1644         then do:
     1645           define variable v-cntxt-db-num        as integer   no-undo .
     1646           define variable v-cntxt-userid        as character no-undo .
     1647           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1648                                             , OUTPUT v-cntxt-userid
     1649                                             ) .
     1650           run gbl/wndsizew.p
     1651             (input  v-cntxt-db-num
     1652             ,input  v-cntxt-userid
     1653             ,input  v-diasize-proc-name
     1654             ,input  'width':u
     1655             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1656             ) .
     1657         end.
     1658       end.
     1659     end.
     1660     assign
     1661       v-diasize-change-size = false
     1662     .
     1663   end procedure.
     1664   procedure diasize_set-width :
     1665     define input  parameter p-new-width  as decimal   no-undo .
     1666     define input  parameter p-move-resize as logical   no-undo .
     1667     do
     1668     on error undo, return error return-value
     1669     :
     1670       run diasize_change-width in this-procedure
     1671         (input  (p-new-width - frame Dialog-Frame :width)
     1672         ,input  p-move-resize
     1673         ) .
     1674     end.
     1675   end procedure.
     1676   procedure diasize_position-resize-button :
     1677     do with frame Dialog-Frame
     1678     :
     1679       hide v-diasize-resize-button .
     1680       assign
     1681         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1682                     - 1
     1683                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1684         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1685                     - 1
     1686                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1687       .
     1688       view v-diasize-resize-button .
     1689     end.
     1690   end procedure.
     1691   on alt-right anywhere
     1692   do:
     1693     run diasize_change-width in this-procedure
     1694       (input 1
     1695       ,input true
     1696       ) .
     1697     return no-apply .
     1698   end.
     1699   on alt-left anywhere
     1700   do:
     1701     run diasize_change-width in this-procedure
     1702       (input -1
     1703       ,input true
     1704       ) .
     1705     return no-apply .
     1706   end.
     1707   on alt-down anywhere
     1708   do:
     1709     run diasize_change-height in this-procedure
     1710       (input 1
     1711       ,input true
     1712       ) .
     1713     return no-apply .
     1714   end.
     1715   on alt-up anywhere
     1716   do:
     1717     run diasize_change-height in this-procedure
     1718       (input -1
     1719       ,input true
     1720       ) .
     1721     return no-apply .
     1722   end.
     1723   on alt-enter of frame Dialog-Frame
     1724   do:
     1725     run diasize_maximize in this-procedure
     1726       (input  ?
     1727       ).
     1728     return no-apply .
     1729   end.
     1730   procedure diasize_end-move :
     1731     do
     1732     on error undo, return error return-value
     1733     :
     1734       define variable v-row-delta as decimal   no-undo .
     1735       define variable v-col-delta as decimal   no-undo .
     1736       define variable v-new-row as decimal   no-undo .
     1737       define variable v-new-col as decimal   no-undo .
     1738       assign
     1739         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1740         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1741       .
     1742       assign
     1743         v-row-delta = v-new-row - frame Dialog-Frame :height
     1744         v-col-delta = v-new-col - frame Dialog-Frame :width
     1745       .
     1746       run diasize_change-height in this-procedure
     1747         (input v-row-delta
     1748         ,input true
     1749         ) .
     1750       run diasize_change-width in this-procedure
     1751         (input v-col-delta
     1752         ,input true
     1753         ) .
     1754     end.
     1755   end procedure.
     1756   procedure diasize_maximize :
     1757     define input  parameter p-action as logical   no-undo .
     1758     do
     1759     on error undo, return error return-value
     1760     :
     1761       if p-action = ?
     1762       then do:
     1763         if v-diasize-need-maximize = true
     1764         then do:
     1765           assign
     1766             p-action = true
     1767           .
     1768         end.
     1769         else do:
     1770           assign
     1771             p-action = false
     1772           .
     1773         end.
     1774       end.
     1775       if p-action = true
     1776       then do:
     1777         run diasize_change-height in this-procedure
     1778           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1779               - frame Dialog-Frame :height-chars
     1780           ,input true
     1781           ) .
     1782         run diasize_change-width in this-procedure
     1783           (input session :width-chars
     1784               - frame Dialog-Frame :width-chars
     1785           ,input true
     1786           ) .
     1787         assign
     1788           v-diasize-need-maximize = false
     1789         .
     1790       end.
     1791       else do:
     1792         run diasize_change-width in this-procedure
     1793           (input v-diasize-orig-frame-width
     1794               - frame Dialog-Frame :width-chars
     1795           ,input true
     1796           ) .
     1797         run diasize_change-height in this-procedure
     1798           (input v-diasize-orig-frame-height
     1799               - frame Dialog-Frame :height-chars
     1800           ,input true
     1801           ) .
     1802         assign
     1803           v-diasize-need-maximize = true
     1804         .
     1805       end.
     1806     end.
     1807   end procedure.
     1808   procedure diasize_restore-orig-size :
     1809     do
     1810     on error undo, return error return-value
     1811     :
     1812       assign
     1813         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1814         v-diasize-current-frame-height = frame Dialog-Frame :height
     1815       .
     1816       run diasize_set-height in this-procedure
     1817         (input  v-diasize-orig-frame-height
     1818         ,input  true
     1819         ) .
     1820       run diasize_set-width in this-procedure
     1821         (input  v-diasize-orig-frame-width
     1822         ,input  true
     1823         ) .
     1824     end.
     1825   end procedure.
     1826   procedure diasize_restore-current-size :
     1827     do
     1828     on error undo, return error return-value
     1829     :
     1830       run diasize_set-height in this-procedure
     1831         (input  v-diasize-current-frame-height
     1832         ,input  true
     1833         ) .
     1834       run diasize_set-width in this-procedure
     1835         (input  v-diasize-current-frame-width
     1836         ,input  true
     1837         ) .
     1838     end.
     1839   end procedure.
     1840   procedure diasize_set-browse-handle :
     1841     define input  parameter p-browse-handle as handle   no-undo .
     1842     define buffer buf_temp-browse-handle for temp-browse-handle .
     1843     do
     1844     on error undo, return error return-value
     1845     :
     1846       assign
     1847         v-diasize-browse-handle = p-browse-handle
     1848       .
     1849       for each buf_temp-browse-handle
     1850       on error undo, return error return-value
     1851       :
     1852         delete buf_temp-browse-handle .
     1853       end.
     1854     end.
     1855   end procedure.
     1856   procedure diasize_add_browse :
     1857     define input  parameter p-browse-type   as character no-undo .
     1858     define input  parameter p-browse-handle as handle    no-undo .
     1859     define buffer buf_temp-browse-handle for temp-browse-handle .
     1860     do
     1861     on error undo, return error return-value
     1862     :
     1863       assign
     1864         v-diasize-browse-number = v-diasize-browse-number + 1
     1865       .
     1866       create buf_temp-browse-handle .
     1867       assign
     1868         buf_temp-browse-handle.browse-type   = p-browse-type
     1869         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1870         buf_temp-browse-handle.browse-handle = p-browse-handle
     1871       .
     1872     end.
     1873   end procedure.
     1874   procedure diasize_init :
     1875     define variable v-default-value    as logical   no-undo .
     1876     define variable v-restore-saved    as logical   no-undo .
     1877     define variable v-resize-value-str as character no-undo .
     1878     do
     1879     on error undo, return error return-value
     1880     :
     1881       do with frame Dialog-Frame
     1882       :
     1883         assign
     1884           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1885           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1886           v-diasize-browse-handle     = browse br-cp-grp :handle
     1887         .
     1888         create button v-diasize-resize-button
     1889         assign
     1890           parent        = frame Dialog-Frame :first-child
     1891           label         = "s"
     1892           height-pixels = 16
     1893           width-pixels  = 16
     1894           visible       = true
     1895           sensitive     = true
     1896           movable       = true
     1897           triggers:
     1898             on end-move persistent run diasize_end-move in this-procedure .
     1899           end triggers.
     1900         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1901         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1902         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1903         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1904         assign
     1905           v-diasize-wndmax = false
     1906         .
     1907         if connected("ub") = true
     1908         then do:
     1909           define variable v-cntxt-db-num        as integer   no-undo .
     1910           define variable v-cntxt-userid        as character no-undo .
     1911           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1912                                             , OUTPUT v-cntxt-userid
     1913                                             ) .
     1914           run gbl/wndpar_r.p
     1915             (input  v-cntxt-db-num
     1916             ,input  v-cntxt-userid
     1917             ,input  'wndmax':U
     1918             ,output v-diasize-wndmax
     1919             ,output v-default-value
     1920             ) .
     1921         end.
     1922         assign
     1923           v-diasize-wndstore = false
     1924         .
     1925         if connected("ub") = true
     1926         then do:
     1927           run gbl/wndpar_r.p
     1928             (input  v-cntxt-db-num
     1929             ,input  v-cntxt-userid
     1930             ,input  'wndstore':U
     1931             ,output v-diasize-wndstore
     1932             ,output v-default-value
     1933             ) .
     1934         end.
     1935         assign
     1936           v-diasize-proc-name = entry(1, program-name(2), '.')
     1937         .
     1938         if v-diasize-wndstore = true
     1939         then do:
     1940           assign
     1941             v-restore-saved = false
     1942           .
     1943           if connected("ub") = true
     1944           then do:
     1945             run gbl/wndsizer.p
     1946               (input  v-cntxt-db-num
     1947               ,input  v-cntxt-userid
     1948               ,input  v-diasize-proc-name
     1949               ,input  'height':u
     1950               ,output v-resize-value-str
     1951               ) .
     1952             if v-resize-value-str <> '':U
     1953             then do:
     1954               run diasize_change-height in this-procedure
     1955                 (input  integer(v-resize-value-str)
     1956                 ,input  true
     1957                 ) .
     1958               assign
     1959                 v-restore-saved = true
     1960               .
     1961             end.
     1962           end.
     1963           if connected("ub") = true
     1964           then do:
     1965             run gbl/wndsizer.p
     1966               (input  v-cntxt-db-num
     1967               ,input  v-cntxt-userid
     1968               ,input  v-diasize-proc-name
     1969               ,input  'width':u
     1970               ,output v-resize-value-str
     1971               ) .
     1972             if v-resize-value-str <> '':U
     1973             then do:
     1974               run diasize_change-width in this-procedure
     1975                 (input  integer(v-resize-value-str)
     1976                 ,input  true
     1977                 ) .
     1978               assign
     1979                 v-restore-saved = true
     1980               .
     1981             end.
     1982           end.
     1983           if v-restore-saved <> true
     1984           then do:
     1985             if v-diasize-wndmax = true
     1986             then do:
     1987               run diasize_maximize in this-procedure
     1988                 (input  true
     1989                 ) .
     1990             end.
     1991           end.
     1992         end.
     1993         else do:
     1994           if v-diasize-wndmax = true
     1995           then do:
     1996             run diasize_maximize in this-procedure
     1997               (input  true
     1998               ) .
     1999           end.
     2000         end.
     2001       end.
     2002     end.
     2003   end procedure.
     2004   procedure diasize_need-full-display :
     2005     define output parameter p-need-full-display as logical   no-undo .
     2006     do
     2007     on error undo, return error return-value
     2008     :
     2009       assign
     2010         p-need-full-display = v-diasize-need-full-display
     2011       .
     2012       assign
     2013         v-diasize-need-full-display = false
     2014       .
     2015     end.
     2016   end procedure.
     2017   procedure get-context :
     2018      define output parameter p-db-num as integer          no-undo.
     2019      define output parameter p-user-id as character        no-undo.
     2020      define variable v-login               as character    no-undo.
     2021      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2022      define buffer buf_user-login  for ub.user-login .
     2023      do
     2024      on error undo, return error
     2025      :
     2026            FIND FIRST buf_sys-ctrl no-lock.
     2027            ASSIGN
     2028               v-login = USERID("ub")
     2029               p-db-num = buf_sys-ctrl.db-num
     2030            .
     2031            FIND FIRST buf_user-login
     2032                 WHERE buf_user-login.db-num = p-db-num
     2033                   AND buf_user-login.user-login = v-login
     2034                 no-lock
     2035                 no-error
     2036                 .
     2037            IF AVAILABLE buf_user-login
     2038            THEN DO:
     2039               assign
     2040                  p-user-id = buf_user-login.user-id
     2041               .
     2042            END.
     2043      end.
     2044   end procedure.
     2045       run diasize_init in this-procedure .
     2046   MAIN-BLOCK:
     2047   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2048      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2049   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2050     run mainmenu_getcntxt in parparentproc
     2051       (output v-cntxt-db-num
     2052       ,output v-cntxt-userid
     2053       ,output v-cntxt-level
     2054       ,output v-cntxt-host-code-obj
     2055       ,output v-cntxt-obj-type
     2056       ,output v-cntxt-obj-code
     2057       ,output v-cntxt-db-num-obj
     2058       ,output v-cntxt-is-admin
     2059       ) .
     2060   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2061   ON TAB ANYWHERE
     2062   DO:
     2063   define variable ii as integer no-undo .
     2064   define variable fh as widget-handle no-undo .
     2065   define variable hh as widget-handle no-undo .
     2066   define variable v-next-widget-name as character no-undo .
     2067   if v-tab-order <> '' then do:
     2068     if self:type = "TOGGLE-BOX" then
     2069     self:BGCOLOR = ?.
     2070     assign
     2071     ii = lookup(self:name, v-tab-order).
     2072     assign
     2073     ii = ii + 1
     2074     v-next-widget-name = entry(ii, v-tab-order)
     2075     no-error .
     2076     if error-status:error then do:
     2077       assign
     2078       ii = 1
     2079       v-next-widget-name = entry( ii, v-tab-order)
     2080       .
     2081     end.
     2082     assign
     2083     fh = frame Dialog-Frame:first-child
     2084     hh = fh:first-child
     2085     .
     2086     do while valid-handle(hh):
     2087       if hh:name = v-next-widget-name then do:
     2088         if hh:sensitive  = yes
     2089         AND hh:visible = yes then do:
     2090           if hh:type = "TOGGLE-BOX":U then do:
     2091             assign
     2092             hh:BGcolor = 1
     2093             .
     2094           end.
     2095           APPLY "ENTRY" to hh.
     2096           return no-apply.
     2097         end.
     2098         else do:
     2099           APPLY "TAB" to hh.
     2100           return no-apply.
     2101         end.
     2102       end.
     2103       hh = hh:next-sibling.
     2104     end.
     2105   end.
     2106   END.
     2107   ON BACK-TAB ANYWHERE
     2108   DO:
     2109   define variable ii as integer no-undo .
     2110   define variable fh as widget-handle no-undo .
     2111   define variable hh as widget-handle no-undo .
     2112   define variable v-next-widget-name as character no-undo .
     2113   if v-tab-order <> '' then do:
     2114     assign
     2115     ii = lookup(self:name, v-tab-order).
     2116     .
     2117     assign
     2118     ii = (if ii = 1
     2119           then  num-entries(v-tab-order)
     2120           else ii - 1
     2121           )
     2122     v-next-widget-name = entry(ii, v-tab-order)
     2123     .
     2124     assign
     2125     fh = frame Dialog-Frame:first-child
     2126     hh = fh:first-child
     2127     .
     2128     do while valid-handle(hh):
     2129       if hh:name = v-next-widget-name then do:
     2130         if hh:sensitive  = yes
     2131         AND hh:visible = yes then do:
     2132           if hh:type = "TOGGLE-BOX":U then do:
     2133             assign
     2134             hh:BGcolor = 1
     2135             .
     2136           end.
     2137           APPLY "ENTRY" to hh.
     2138           return no-apply.
     2139         end.
     2140         else do:
     2141         APPLY "BACK-TAB" to hh.
     2142         return no-apply.
     2143         end.
     2144       end.
     2145       hh = hh:next-sibling.
     2146     end.
     2147     end.
     2148   END.
     2149   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2150   ON RETURN ANYWHERE
     2151   DO:
     2152   define variable ii as integer no-undo .
     2153   define variable fh as widget-handle no-undo .
     2154   define variable hh as widget-handle no-undo .
     2155   define variable v-next-widget-name as character no-undo .
     2156     if v-tab-order <> '' then do:
     2157       assign
     2158       ii = lookup(self:name, v-tab-order).
     2159       if ii = num-entries(v-tab-order) then do:
     2160           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     2161           return no-apply.
     2162       end.
     2163       if self:type <> "BUTTON" and
     2164         self:type <> "EDITOR"  then do:
     2165         run proc-move-forward in this-procedure .
     2166         return no-apply.
     2167       end.
     2168       if self:type = "BUTTON" then do:
     2169         APPLY "CHOOSE" to self.
     2170       end.
     2171       if self:type = "TOGGLE-BOX" then
     2172       self:BGCOLOR = ?.
     2173       assign
     2174       ii = ii + 1
     2175       v-next-widget-name = entry(ii, v-tab-order)
     2176       no-error .
     2177       if error-status:error then do:
     2178         assign
     2179         ii = 1
     2180         v-next-widget-name = entry( ii, v-tab-order)
     2181         .
     2182       end.
     2183       assign
     2184       fh = frame Dialog-Frame:first-child
     2185       hh = fh:first-child
     2186       .
     2187       do while valid-handle(hh):
     2188         if hh:name = v-next-widget-name then do:
     2189           if hh:sensitive  = yes
     2190           AND hh:visible = yes then do:
     2191             if hh:type = "TOGGLE-BOX":U then do:
     2192               assign
     2193               hh:BGcolor = 1
     2194               .
     2195             end.
     2196             APPLY "ENTRY" to hh.
     2197             return no-apply.
     2198           end.
     2199           else do:
     2200             APPLY "TAB" to hh.
     2201             return no-apply.
     2202           end.
     2203         end.
     2204         hh = hh:next-sibling.
     2205       end.
     2206     end.
     2207   END.
     2208   procedure proc-move-forward :
     2209   define variable ii as integer no-undo .
     2210   define variable fh as widget-handle no-undo .
     2211   define variable hh as widget-handle no-undo .
     2212   define variable v-next-widget-name as character no-undo .
     2213   do
     2214   on error undo, return error
     2215   :
     2216     if v-tab-order <> '' then do:
     2217       if self:type = "TOGGLE-BOX" then
     2218       self:BGCOLOR = ?.
     2219       assign
     2220       ii = lookup(self:name, v-tab-order).
     2221       assign
     2222       ii = ii + 1
     2223       v-next-widget-name = entry(ii, v-tab-order)
     2224       no-error .
     2225       if error-status:error then do:
     2226         assign
     2227         ii = 1
     2228         v-next-widget-name = entry( ii, v-tab-order)
     2229         .
     2230       end.
     2231       assign
     2232       fh = frame Dialog-Frame:first-child
     2233       hh = fh:first-child
     2234       .
     2235       do while valid-handle(hh):
     2236         if hh:name = v-next-widget-name then do:
     2237           if hh:sensitive  = yes
     2238           AND hh:visible = yes then do:
     2239             if hh:type = "TOGGLE-BOX":U then do:
     2240               assign
     2241               hh:BGcolor = 1
     2242               .
     2243             end.
     2244             APPLY "ENTRY" to hh.
     2245             return.
     2246           end.
     2247           else do:
     2248             assign
     2249             ii = ii + 1
     2250             v-next-widget-name = entry(ii, v-tab-order)
     2251             no-error .
     2252             if error-status:error then do:
     2253               assign
     2254               ii = 1
     2255               v-next-widget-name = entry( ii, v-tab-order)
     2256               .
     2257             end.
     2258           end.
     2259         end.
     2260         hh = hh:next-sibling.
     2261       end.
     2262     end.
     2263   end.
     2264   end procedure.
     2265     IF p-mode <> 'ПРОСМОТР':U
     2266     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     2267         MESSAGE
     2268         vss-workfile vss-revision vss-description skip
     2269         "Неверное значение параметра p-mode" p-mode
     2270         VIEW-AS ALERT-BOX ERROR.
     2271         UNDO, RETURN ERROR.
     2272     END.
     2273     IF p-obj-type <> 'маг':U
     2274     and p-obj-type <> 'орг':U
     2275     and p-obj-type <> '':U
     2276     THEN DO:
     2277         MESSAGE
     2278         vss-workfile vss-revision vss-description skip
     2279         "Неверное значение параметра p-obj-type" p-obj-type
     2280         VIEW-AS ALERT-BOX ERROR.
     2281         UNDO, RETURN ERROR.
     2282     END.
     2283     if p-obj-type = 'маг':U then do:
     2284       FIND FIRST X_shop NO-LOCK WHERE X_shop.obj-code = p-obj-code NO-ERROR.
     2285       IF NOT AVAILABLE X_shop THEN DO:
     2286           MESSAGE
     2287           vss-workfile vss-revision vss-description skip
     2288           "Неверное значение параметра p-obj-code" p-obj-code
     2289           VIEW-AS ALERT-BOX ERROR.
     2290           UNDO, RETURN ERROR.
     2291       END.
     2292   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2293   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2294     (input  'маг':U
     2295     ,input  p-obj-code
     2296     ,output v-db-num
     2297     )  .
     2298       IF v-db-num <> v-cntxt-db-num
     2299       AND v-cntxt-db-num <> 0
     2300       and p-mode <> 'ПРОСМОТР':U
     2301       THEN DO:
     2302           MESSAGE
     2303           "Нельзя менять параметры магазина в чужой БД" skip
     2304           "магазин принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     2305           VIEW-AS ALERT-BOX ERROR.
     2306           UNDO, RETURN ERROR.
     2307       END.
     2308   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2309   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2310     (input  p-obj-type
     2311     ,input  p-obj-code
     2312     ,output v-host-code
     2313     )  .
     2314     end.
     2315     if p-obj-type = 'орг':U then do:
     2316       FIND FIRST X_sysconf NO-LOCK WHERE X_sysconf.host-code = p-obj-code NO-ERROR.
     2317       IF NOT AVAILABLE X_sysconf THEN DO:
     2318           MESSAGE
     2319           vss-workfile vss-revision vss-description skip
     2320           "Неверное значение параметра p-obj-code" p-obj-code
     2321           VIEW-AS ALERT-BOX ERROR.
     2322           UNDO, RETURN ERROR.
     2323       END.
     2324       if v-cntxt-db-num <> 0
     2325       and p-mode <> 'ПРОСМОТР':U
     2326       then do:
     2327           MESSAGE
     2328           "Нельзя менять параметры ФИРМЫ в УБД" skip
     2329           VIEW-AS ALERT-BOX ERROR.
     2330           UNDO, RETURN ERROR.
     2331       end.
     2332       v-host-code = p-obj-code.
     2333     end.
     2334     if p-obj-type = '':U then do:
     2335       if v-cntxt-db-num <> 0
     2336       and p-mode <> 'ПРОСМОТР':U
     2337       then do:
     2338           MESSAGE
     2339           "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" skip
     2340           VIEW-AS ALERT-BOX ERROR.
     2341           UNDO, RETURN ERROR.
     2342       end.
     2343     end.
     2344     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     2345       FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
     2346                 LOCKED_thbj-attr.obj-type = p-obj-type
     2347           AND   LOCKED_thbj-attr.obj-code = p-obj-code
     2348           AND   LOCKED_thbj-attr.upper-prop-code = 'cashpays':U
     2349           AND   locked_thbj-attr.prop-code = '':U NO-ERROR.
     2350        if locked locked_thbj-attr then do:
     2351           message
     2352           vss-workfile vss-revision vss-description skip
     2353            "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
     2354           view-as alert-box error .
     2355           undo, return error.
     2356         end.
     2357     END.
     2358     ELSE DO:
     2359         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
     2360             LOCKED_thbj-attr.obj-type = p-obj-type
     2361       AND   LOCKED_thbj-attr.obj-code = p-obj-code
     2362       AND   LOCKED_thbj-attr.upper-prop-code = 'cashpays':U
     2363       AND   locked_thbj-attr.prop-code = '':U NO-ERROR.
     2364     END.
     2365     if not available locked_thbj-attr then do:
     2366       ASSIGN
     2367       v-to-create  = YES.
     2368       message
     2369       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     2370                   chr(10))
     2371       view-as alert-box WARNING.
     2372     end.
     2373     RUN FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     2374     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     2375     RUN Myenable.
     2376     WAIT-FOR GO OF FRAME Dialog-Frame.
     2377   END.
     2378   RUN disable_UI.
     2379   PROCEDURE disable_UI :
     2380     HIDE FRAME Dialog-Frame.
     2381   END PROCEDURE.
     2382   PROCEDURE enable_UI :
     2383     ENABLE B-exit b-quit B-Help br-cp-grp
     2384         WITH FRAME Dialog-Frame.
     2385     VIEW FRAME Dialog-Frame.
     2386   END PROCEDURE.
     2387   PROCEDURE fill-widgets :
     2388   define variable v-value-character as character no-undo .
     2389   define variable v-value-date as date no-undo .
     2390   define variable v-value-decimal as decimal no-undo .
     2391   define variable v-value-integer as INTEGER no-undo .
     2392   define variable v-value-logical AS LOGICAL no-undo .
     2393   DEFINE VARIABLE v-entry AS CHARACTER NO-UNDO.
     2394   define variable v-param-type as character no-undo .
     2395   define variable v-param-value as character no-undo .
     2396   define variable v-cpgrpnam as character no-undo .
     2397   define variable ii as integer no-undo .
     2398   FOR EACH thbjattr_thbj-attr:
     2399     delete thbjattr_thbj-attr.
     2400   end.
     2401   FOR EACH temp-thbj-attr:
     2402     delete temp-thbj-attr.
     2403   end.
     2404   run adm/shattri.p (
     2405                 input "init":U
     2406               , input p-obj-type
     2407               , input p-obj-code
     2408               , input 'cashpays':U
     2409               , input "":U
     2410               , output v-value-character
     2411               , output v-value-date
     2412               , output v-value-decimal
     2413               , output v-value-integer
     2414               , output v-value-logical
     2415               , output v-param-type
     2416               , INPUT-OUTPUT TABLE-handle v-tth
     2417               ) no-error .
     2418   if error-status:error
     2419   and not available locked_thbj-attr then do:
     2420     message
     2421     "Не удалось получить начальные значения настроек" skip
     2422     error-status:get-message(1) return-value
     2423     view-as alert-box error .
     2424     undo, return error .
     2425   end.
     2426   FOR EACH thbjattr_thbj-attr:
     2427     ASSIGN
     2428     v-entry = thbjattr_thbj-attr.prop-code.
     2429     IF v-entry = 'cpgrpnam':U THEN DO:
     2430       ASSIGN
     2431       v-cpgrpnam = thbjattr_thbj-attr.property-value-character
     2432       .
     2433     END.
     2434     create temp-thbj-attr.
     2435     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     2436   END.
     2437   for each tt-cp-grp:
     2438     delete tt-cp-grp.
     2439   end.
     2440   DO ii = 1 TO NUM-ENTRIES (v-cpgrpnam) by 2:
     2441     CREATE tt-cp-grp.
     2442     ASSIGN
     2443     tt-cp-grp.grp-code =  integer(ENTRY(ii + 1, v-cpgrpnam))
     2444     tt-cp-grp.grp-name =  ENTRY(ii, v-cpgrpnam)
     2445     .
     2446     release tt-cp-grp.
     2447   END.
     2448   END PROCEDURE.
     2449   PROCEDURE MyEnable :
     2450   ASSIGN
     2451   FRAME Dialog-Frame:TITLE = substitute("&1 &2&3"
     2452                                          ,FRAME Dialog-Frame:TITLE
     2453                                          ,p-obj-type
     2454                                          ,(if p-obj-code > 0 then string(p-obj-code) else '':U)
     2455                                          )
     2456   v-tab-order = "b-add,b-del".
     2457   ENABLE
     2458   B-exit WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2459   b-quit
     2460   B-Help
     2461   b-add when p-mode = 'ИЗМЕНЕНИЕ':U
     2462   b-del when p-mode = 'ИЗМЕНЕНИЕ':U
     2463   br-cp-grp
     2464   WITH FRAME Dialog-Frame.
     2465   VIEW FRAME Dialog-Frame.
     2466   IF p-mode = 'ПРОСМОТР':U THEN DO:
     2467       HIDE
     2468       b-exit
     2469       IN FRAME Dialog-Frame.
     2470       ASSIGN
     2471       b-quit:LABEL = "&Выход"
     2472       .
     2473   END.
     2474   OPEN QUERY br-cp-grp FOR EACH tt-cp-grp NO-LOCK INDEXED-REPOSITION.
     2475   END PROCEDURE.
     2476   PROCEDURE proc-save :
     2477   define variable v-value-character as character no-undo .
     2478   define variable v-value-date as date no-undo .
     2479   define variable v-value-decimal as decimal no-undo .
     2480   define variable v-value-integer as INTEGER no-undo .
     2481   define variable v-value-logical AS LOGICAL no-undo .
     2482   define variable v-param-type as character no-undo .
     2483   define variable wh as widget-handle no-undo .
     2484   define variable fh as widget-handle no-undo .
     2485   define variable v-same as logical no-undo .
     2486   define variable v-cpgrpname as character no-undo .
     2487   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     2488   for each tt-cp-grp:
     2489     assign
     2490     v-cpgrpname = v-cpgrpname + (if v-cpgrpname = '':U then '':U else chr(44)) +
     2491                   tt-cp-grp.grp-name  + chr(44) + string(tt-cp-grp.grp-code)
     2492     .
     2493   end.
     2494   assign
     2495   fh = frame Dialog-Frame:first-child
     2496   wh = fh:first-child
     2497   .
     2498   do while valid-handle(wh):
     2499     if wh:private-data begins "recid=" then do:
     2500       find first thbjattr_thbj-attr where
     2501                 recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     2502       assign
     2503       buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     2504     end.
     2505     wh = wh:next-sibling.
     2506   end.
     2507   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'cpgrpnam':U.
     2508   assign
     2509   thbjattr_thbj-attr.property-value-character = v-cpgrpname
     2510   .
     2511   v-same = yes.
     2512   for each thbjattr_thbj-attr,
     2513       first temp-thbj-attr where
     2514             temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     2515         and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     2516         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     2517         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code:
     2518      buffer-compare
     2519      thbjattr_thbj-attr
     2520      to temp-thbj-attr
     2521      save result in v-same.
     2522      if not v-same then leave.
     2523   end.
     2524   v-same = no.
     2525   IF v-same  and not v-to-create THEN RETURN.
     2526   run adm/shattri.p (
     2527                 input "check":U
     2528               , input p-obj-type
     2529               , input p-obj-code
     2530               , input 'cashpays':U
     2531               , INPUT '':U
     2532                , output v-value-character
     2533                , output v-value-date
     2534                , output v-value-decimal
     2535                , output v-value-integer
     2536                , output v-value-logical
     2537                , output v-param-type
     2538                , input-output table-handle v-tth
     2539                ) no-error .
     2540   if error-status:error then do:
     2541     message
     2542     "Некорректное значение ПАРАМЕТРОВ" skip
     2543     error-status:get-message(1) skip
     2544     return-value
     2545     view-as alert-box error .
     2546     undo, return error .
     2547   end.
     2548   do TRANSACTION
     2549   on error undo, return error return-value
     2550   :
     2551     RUN thbjattr_set-section IN THIS-PROCEDURE (
     2552          input p-obj-type
     2553         ,input p-obj-code
     2554         ,input 'cashpays':U
     2555         ,INPUT table thbjattr_thbj-attr
     2556     ) NO-ERROR.
     2557     IF ERROR-STATUS:error THEN do:
     2558       MESSAGE ERROR-STATUS:get-message(1)  SKIP
     2559       RETURN-VALUE
     2560       VIEW-AS ALERT-BOX.
     2561       UNDO, RETURN ERROR.
     2562     END.
     2563   end.
     2564   END PROCEDURE.
