     1299     define variable v-change-sign          as integer   no-undo .
     1300     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1301     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1302     if p-change-value > 0
     1303     then do:
     1304       if frame Dialog-Frame :width + p-change-value >
     1305           session :width-chars
     1306       then do:
     1307         assign
     1308           p-change-value = session :width-chars - frame Dialog-Frame :width
     1309         .
     1310         if p-change-value <= 0
     1311         then do:
     1312           run diasize_position-resize-button in this-procedure .
     1313           return .
     1314         end.
     1315       end.
     1316     end.
     1317     if p-change-value < 0
     1318     then do:
     1319       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1320       then do:
     1321         assign
     1322           p-change-value = v-diasize-orig-frame-width
     1323                          - frame Dialog-Frame :width
     1324         .
     1325         if p-change-value >= 0
     1326         then do:
     1327           run diasize_position-resize-button in this-procedure .
     1328           return .
     1329         end.
     1330       end.
     1331     end.
     1332     if p-change-value >= 0
     1333     then do:
     1334       assign
     1335         v-change-sign = 1
     1336       .
     1337     end.
     1338     else do:
     1339       assign
     1340         v-change-sign = -1
     1341       .
     1342     end.
     1343     assign
     1344       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1345     .
     1346     if p-change-value = 0
     1347     then do:
     1348       run diasize_position-resize-button in this-procedure .
     1349       return .
     1350     end.
