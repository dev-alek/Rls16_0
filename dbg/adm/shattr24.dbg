      616   procedure proc-alt-shift-f2:
      617     if not ibs.th.gbl.gbl-var:rcode
      618   then
      619     run gbl\inidebug.p .
      620   end.
      621   procedure proc-alt-shift-f3:
      622     run gbl/prvssinf.p
      623       ( input this-procedure
      624       ) .
      625   end.
      626   define variable v-inform-launched as logical no-undo initial false .
      627   procedure proc-alt-shift-f4:
      628     define variable v-action as character no-undo .
      629     if v-inform-launched = false then do:
      630       assign
      631         v-inform-launched = true
      632       .
      633       run gbl/d-inform.w
      634         (  input self
      635         ,  input this-procedure
      636         , output v-action
      637         ) no-error .
      638       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      639       assign
      640         v-inform-launched = false
      641       .
      642     end.
      643   end.
      644   procedure proc-alt-f1:
      645     run gbl/corrhelp.p
      646       (input this-procedure
      647       ) .
      648   end .
      649   on alt-shift-f2 anywhere do:
      650     run proc-alt-shift-f2.
      651   end.
      652   on alt-shift-f3 anywhere do:
      653     run proc-alt-shift-f3 in this-procedure .
      654   end.
      655   on alt-shift-f4 anywhere do:
      656     run proc-alt-shift-f4 in this-procedure.
      657   end.
      658   on alt-f1 anywhere do:
      659     run proc-alt-f1 in this-procedure .
      660   end.
      661   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      662     define variable v-cntxt-db-num        as integer   no-undo .
      663     define variable v-cntxt-userid        as character no-undo .
      664     define variable v-cntxt-level         as character no-undo .
      665     define variable v-cntxt-host-code-obj as integer   no-undo .
      666     define variable v-cntxt-obj-type      as character no-undo .
      667     define variable v-cntxt-obj-code      as integer   no-undo .
      668     define variable v-cntxt-db-num-obj    as integer   no-undo .
      669     define variable v-cntxt-is-admin      as logical   no-undo .
      670   DEFINE VARIABLE v-db-num LIKE ub.db.db-num NO-UNDO.
      671   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO.
      672   DEFINE VARIABLE v-to-create AS logical NO-UNDO.
      673   define variable v-host-code as integer no-undo .
      674   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      675   define variable v-tth as handle no-undo .
      676   assign
      677   v-tth = buffer thbjattr_thbj-attr:table-handle .
      678   DEFINE BUTTON B-add  NO-FOCUS
      679        LABEL "&Добавить"
      680        SIZE 10 BY 1.
      681   DEFINE BUTTON B-del
      682        LABEL "&Удалить"
      683        SIZE 10 BY 1.
      684   DEFINE BUTTON B-exit AUTO-GO
      685        LABEL "&Ввод"
      686        SIZE 10 BY 1
      687        BGCOLOR 8 .
      688   DEFINE BUTTON B-Help
      689        LABEL "Помо&щь"
      690        SIZE 3 BY 1
      691        BGCOLOR 8 .
      692   DEFINE BUTTON b-quit AUTO-END-KEY
      693        LABEL "&Отмена"
      694        SIZE 10 BY 1
      695        BGCOLOR 8 .
      696   DEFINE QUERY br-cp-grp FOR
      697         tt-cp-grp SCROLLING.
      698   DEFINE BROWSE br-cp-grp
      699     QUERY br-cp-grp NO-LOCK DISPLAY
      700         tt-cp-grp.grp-code COLUMN-LABEL "Код группы платежей" FORMAT ">>>9":U
      701         tt-cp-grp.grp-name COLUMN-LABEL "Описание" FORMAT "X(30)":U
      702       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 12.33
      703            TITLE "Коды и названия групп типов кассовых платажей" ROW-HEIGHT-CHARS .58 FIT-LAST-COLUMN.
      704   DEFINE FRAME Dialog-Frame
      705        B-add AT ROW 3 COL 1
      706        B-exit AT ROW 1 COL 1
      707        b-quit AT ROW 1 COL 11
      708        B-Help AT ROW 1 COL 54.9
      709        B-del AT ROW 3 COL 11
      710        br-cp-grp AT ROW 4 COL 1
      711        SPACE(0.24) SKIP(0.00)
      712       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      713            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      714            TITLE "Набор опций работы со справочником типов кассовых платежей"
      715            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      716   ASSIGN
      717          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      718          FRAME Dialog-Frame:HIDDEN           = TRUE.
      719   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      720   DO:
      721     APPLY "END-ERROR":U TO SELF.
      722   END.
      723   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      724   DO:
      725     DEFINE VARIABLE v-code AS integer NO-UNDO.
      726     define variable v-name as character no-undo.
      727     DEFINE VARIABLE v-log AS logical NO-UNDO.
      728     DEFINE variable v-rid AS RECID NO-UNDO.
      729     DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      730     DEFINE BUFFER buf_tt-cp-grp FOR tt-cp-grp.
      731   run adm/cpgrpnam.w ( output v-code
      732               ,output v-name
      733               ,output v-log) no-error .
      734   if error-status:error
      735   or not v-log then return no-apply.
      736   FIND FIRST buf_tt-cp-grp NO-LOCK WHERE
      737             buf_tt-cp-grp.grp-code = v-code NO-ERROR.
      738   IF AVAILABLE buf_tt-cp-grp THEN DO:
      739        MESSAGE
      740           "Вы уже задали соответствие для кода группы платежей" v-code
      741           VIEW-AS ALERT-BOX.
      742           RETURN NO-APPLY.
      743   END.
      744   CREATE tt-cp-grp.
      745   ASSIGN
      746   tt-cp-grp.grp-code = v-code
      747   tt-cp-grp.grp-name = v-name
      748   v-rid = RECID(tt-cp-grp)
      749   .
      750   release tt-cp-grp.
      751   OPEN QUERY br-cp-grp FOR EACH tt-cp-grp NO-LOCK INDEXED-REPOSITION.
      752   REPOSITION br-cp-grp TO RECID v-rid.
      753   END.
      754   ON CHOOSE OF B-del IN FRAME Dialog-Frame
      755   DO:
      756     IF NOT AVAILABLE tt-cp-grp THEN RETURN NO-APPLY.
      757     DELETE tt-cp-grp.
      758     OPEN QUERY br-cp-grp FOR EACH tt-cp-grp NO-LOCK INDEXED-REPOSITION.
      759     REPOSITION br-cp-grp TO ROW 1.
      760   END.
      761   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      762   DO:
      763     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      764     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      765   END.
      766   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      767   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      768   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      769   on help of frame Dialog-Frame
      770   do:
      771     run gbl/app_help.p
      772       (input this-procedure :file-name
      773       ,input ''
      774       ,input ?
      775       ) no-error.
      776     if error-status :error then do:
      777       message
      778         "Ошибка при вызове помощи"
      779         error-status :get-message(1)
      780         view-as alert-box .
      781     end.
      782   end.
      783   run minbtn-set in this-procedure .
      784   on choose of b-help in frame Dialog-Frame
      785   do:
      786     apply "help":u to frame Dialog-Frame .
      787   end.
      788   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      789   procedure minbtn-set :
      790       do
      791           on error undo, return error return-value
      792           :
      793           define variable ii              as integer       no-undo .
      794           define variable fh              as widget-handle no-undo .
      795           define variable hh              as widget-handle no-undo .
      796           define variable v-h             as handle        extent 4 no-undo .
      797           define variable v-name-button   as character     no-undo .
      798           define variable v-help-old-x    as decimal       no-undo .
      799           define variable v-help-old-y    as decimal       no-undo .
      800           define variable v-help-old-size as decimal       no-undo .
      801           define variable v-frame-width   as decimal       no-undo .
      802           define variable jj              as integer       no-undo .
      803           do
      804               on error undo, return error
      805               :
      806               assign
      807                   v-frame-width = frame Dialog-Frame:width - 0.3
      808                   fh            = frame Dialog-Frame:first-child
      809                   hh            = fh:first-child
      810                   ii            = 1
      811                   .
      812               do while valid-handle(hh):
      813                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      814                   do:
      815                       case lc(hh:name) :
      816                           when "b-help" then
      817                               do:
      818                                   hh:load-image-up("cmp/b-help.bmp":u) .
      819                                   hh:load-image-down("cmp/b-help.bmp":u) .
      820                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      821                                   hh:TOOLTIP = "Помощь" .
      822                                   v-help-old-x = hh:column .
      823                                   v-help-old-y = hh:row    .
      824                                   v-help-old-size = hh:width .
      825                                   hh:width-chars = 2.5 .
      826                               end.
      827                           when "b-print" then
      828                               do:
      829                                   hh:load-image("cmp/b-print.bmp":u) .
      830                                   hh:TOOLTIP = "Печать" .
      831                                   v-h[ii] = hh:handle .
      832                                   ii = ii + 1 .
      833                                   hh:width-chars = 3 .
      834                               end.
      835                           when "b-history" or
      836                           when "b-hist" then
      837                               do:
      838                                   hh:load-image("cmp/b-hist.bmp":u) .
      839                                   hh:TOOLTIP = "История" .
      840                                   v-h[ii] = hh:handle .
      841                                   ii = ii + 1 .
      842                                   hh:width-chars = 3 .
      843                               end.
      844                           when "b-sch" then
      845                               do:
      846                                   hh:load-image("cmp/b-sch.bmp":u) .
      847                                   hh:TOOLTIP = "Установка Фильтра" .
      848                                   v-h[ii] = hh:handle .
      849                                   ii = ii + 1 .
      850                                   hh:width-chars = 3 .
      851                               end.
      852                           when "b-hist-user" then
      853                               do:
      854                                   hh:load-image("cmp/b-hist.bmp":u) .
      855                                   hh:TOOLTIP = "История пользователя" .
      856                                   ii = ii + 1 .
      857                               end.
      858                       end case.
      859                   end.
      860                   hh = hh:next-sibling.
      861               end.
      862               b-help:column = v-frame-width - b-help:width-chars.
      863               jj = 0.
      864               repeat ii = 4 to 1 by -1 :
      865                   if valid-handle (v-h[ii] ) then
      866                   do:
      867                       jj  = jj + 1 .
      868                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      869                       v-h[ii]:row    = v-help-old-y .
      870                   end.
      871               end.
      872           end.
      873       end.
      874   end procedure.
      875   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      876   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      877   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      878   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      879   define variable v-diasize-current-frame-width  as decimal   no-undo .
      880   define variable v-diasize-current-frame-height as decimal   no-undo .
      881   define variable v-diasize-change-size          as logical   no-undo .
      882   define variable v-diasize-resize-button        as handle    no-undo .
      883   define variable v-diasize-wndmax               as logical   no-undo .
      884   define variable v-diasize-wndstore             as logical   no-undo .
      885   define variable v-diasize-proc-name            as character no-undo .
      886   define variable v-diasize-browse-handle        as handle    no-undo .
      887   define variable v-diasize-browse-number        as integer   no-undo .
      888   define variable v-diasize-need-full-display    as logical   no-undo init false .
      889   define temp-table temp-diasize-handle no-undo
      890     field handle-value  as handle
      891     field save-position as decimal
      892     index xpk is primary unique handle-value
      893     .
      894   define temp-table temp-browse-handle no-undo
      895     field browse-type   as character
      896     field browse-number as integer
      897     field browse-handle as handle
      898     field original-size as decimal
      899     index xpk is primary unique browse-type browse-number
      900     index xie browse-type browse-handle
      901   .
      902   procedure diasize_change-height :
      903     define input  parameter p-change-value  as decimal   no-undo .
      904     define input  parameter p-move-resize   as logical   no-undo .
      905     define variable v-field-group-handle    as handle    no-undo .
      906     define variable v-object-handle         as handle    no-undo .
      907     define variable v-frame-height          as decimal   no-undo .
      908     define variable v-frame-virtual-height  as decimal   no-undo .
      909     define variable v-browse-height         as decimal   no-undo .
      910     define variable v-window-height         as decimal   no-undo .
      911     define variable v-window-virtual-height as decimal   no-undo .
      912     define variable v-change-sign           as integer   no-undo .
      913     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      914     define buffer buf_temp-browse-handle  for temp-browse-handle .
      915     if p-change-value > 0
      916     then do:
      917       if frame Dialog-Frame :height + p-change-value
      918           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      919       then do:
      920         assign
      921           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      922                           - (frame Dialog-Frame :height-chars)
      923         .
      924         if p-change-value <= 0
      925         then do:
      926           run diasize_position-resize-button in this-procedure .
      927           return .
      928         end.
      929       end.
      930     end.
      931     if p-change-value < 0
      932     then do:
      933       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      934       then do:
      935         assign
      936           p-change-value = v-diasize-orig-frame-height
      937                          - (frame Dialog-Frame :height-chars)
      938         .
      939         if p-change-value >= 0
      940         then do:
      941           run diasize_position-resize-button in this-procedure .
      942           return .
      943         end.
      944       end.
      945     end.
      946     if p-change-value >= 0
      947     then do:
      948       assign
      949         v-change-sign = 1
      950       .
      951     end.
      952     else do:
      953       assign
      954         v-change-sign = -1
      955       .
      956     end.
      957     assign
      958       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      959     .
      960     if p-change-value = 0
      961     then do:
      962       run diasize_position-resize-button in this-procedure .
      963       return .
      964     end.
      965     move_block:
      966     do
      967     on error undo move_block, retry move_block
      968     :
      969       if retry
      970       then do:
      971         do
      972         on error undo move_block, leave move_block
      973         :
      974           if p-change-value > 0
      975           then do:
      976             for each buf_temp-diasize-handle
      977             on error undo, next
      978             :
      979               assign
      980                 v-object-handle = buf_temp-diasize-handle.handle-value
      981               .
      982               if v-object-handle <> v-diasize-resize-button
      983               then do:
      984                 assign
      985                   v-object-handle :row = buf_temp-diasize-handle.save-position
      986                 .
