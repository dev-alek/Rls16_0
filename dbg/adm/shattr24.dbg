     1284         (input  (p-new-height - frame Dialog-Frame :height)
     1285         ,input  p-move-resize
     1286         ) .
     1287     end.
     1288   end procedure.
     1289   procedure diasize_change-width :
     1290     define input  parameter p-change-value as decimal   no-undo .
     1291     define input  parameter p-move-resize  as logical   no-undo .
     1292     define variable v-field-group-handle   as handle    no-undo .
