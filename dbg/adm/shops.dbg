     3063     return no-apply.
     3064   end.
     3065   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3066   on F2 of frame d-shop anywhere do:
     3067     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame d-shop. END.
     3068     return no-apply.
     3069   end.
     3070   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3071   on F2 of frame d-shop anywhere do:
