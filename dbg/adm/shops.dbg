      441   define buffer buf_clients for ub.clients.
      442   define buffer buf_sysconf for ub.sysconf.
      443   define buffer buf_shop for ub.shop.
      444   define buffer buf_store for ub.store.
      445   define buffer buf_db for ub.db.
      446   do
      447   on error undo, return error
      448   :
      449   assign
      450   vattr-codes = "":U
      451   vattr-labels = "":U
      452   .
      453   _II:
      454   DO ii = 1 to num-entries('autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U):
      455     run thbjattr_code (
      456                          input entry(ii, 'autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U)
      457                         ,input   '':U
      458                         ,output  attr-label
      459                         ,output  attr-user-can-edit
      460                         ,output  attr-output-display
      461                         ,output  attr-other
      462                         ,output v-prop-list
      463                         ,output v-prop-type-list
      464                         ,output v-prop-label-list
      465                         ,output v-global
      466                         ,output v-host
      467                         ,output v-shop
      468                         ,output v-store
      469                         ,output v-db
      470                       ) no-error.
      471       .
      472       if NOT error-status:error
      473       and attr-user-can-edit
      474       and index(attr-other, "spr-ext=") > 0
      475       anD (if p-obj-type = 'маг':U
      476            then v-shop
      477            else (if p-obj-type = 'скл':U
      478                  then v-store
      479                  else (if p-obj-type = 'орг':U
      480                        then v-host
      481                        else (if p-obj-type = 'БД':U
      482                             then v-db
      483                             else v-global)
      484                       )
      485                  )
      486            ) then do:
      487         if entry(ii, 'autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U) = 'alias-tpsi':U then do:
      488   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      489     (input  'tpsi'
      490     ,input  0
      491     ,input  ''
      492     ,input  0
      493     ,input  ''
      494     ,input  ''
      495     ,input  ''
      496     ,input  no
      497     ,output conf-par
      498     ,output par-type
      499     ) no-error .
      500           if error-status:error
      501           or (conf-par <> "yes") then next _ii.
      502         end.
      503         assign
      504         vattr-codes = vattr-codes + chr(44) + entry(ii, 'autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U)
      505         vattr-labels = vattr-labels + chr(44) + attr-label
      506         .
      507       end.
      508   end.
      509   CASE p-mode:
      510     when 'ПРОСМОТР':U then do:
      511       assign
      512       v-title = "Выберите типы параметров для просмотра".
      513     end.
      514     when 'ИЗМЕНЕНИЕ':U then do:
      515       assign
      516       v-title = "Выберите типы параметров для редактирования".
      517     end.
      518     when  'КОПИРОВАНИЕ':U then do:
      519       assign
      520       v-title = "Выберите типы параметров для копирования".
      521     end.
      522   END CASE.
      523   run gbl/d-list.w (
      524                  INPUT (if p-mode = 'КОПИРОВАНИЕ':U then "b-sel,b-mark":U else "b-sel":U)
      525                 ,INPUT v-title
      526                 ,INPUT vattr-codes
      527                 ,INPUT vattr-labels
      528                 ,INPUT chr(44)
      529                 ,INPUT "":U
      530                 ,output v-attr-code).
      531   IF v-attr-code = "":u THEN do:
      532     RETURN ''.
      533   end.
      534   if p-mode = 'ПРОСМОТР':U
      535   or p-mode = 'ИЗМЕНЕНИЕ':U then do:
      536     run thbjattr_code  in this-procedure (
      537          input   v-attr-code
      538         ,input   '':U
      539         ,output  attr-label
      540         ,output  attr-user-can-edit
      541         ,output  attr-output-display
      542         ,output  attr-other
      543         ,output v-prop-list
      544         ,output v-prop-type-list
      545         ,output v-prop-label-list
      546         ,output v-global
      547         ,output v-host
      548         ,output v-shop
      549         ,output v-store
      550         ,output v-db
      551     ).
      552     do ii = 1 to num-entries(attr-other, chr(47)):
      553       if entry(ii, attr-other, chr(47)) begins "spr-ext=":U then do:
      554         assign
      555         v-spr = entry(2, entry(ii, attr-other, chr(47)), "=").
      556       end.
      557     end.
      558     run value(v-spr) (
      559                      input parparentproc
      560                     ,input p-mode
      561                     ,input p-obj-type
      562                     ,input p-obj-code
      563                     ).
      564   end.
      565   else do:
      566      if p-obj-type = 'маг':U then do:
      567       message
      568       "Выберите магазин для копирования ПАРАМЕТРОВ"
      569       view-as alert-box WARNING.
      570         run adm/shops.w ( input parparentproc
      571                          ,input "b-sel"
      572                          ,input-output v-rid-list
      573                          ,no ).
      574        if v-rid-list = "":U then return.
      575        find first buf_shop no-lock where
      576                 recid(buf_shop) = integer(v-rid-list) .
      577        v-from-obj-code = buf_shop.obj-code.
      578      end.
      579      if p-obj-type = 'орг':U then do:
      580         message
      581         "Выберите ФИРМУ для копирования ПАРАМЕТРОВ"
      582         view-as alert-box WARNING.
      583         run adm/sconfs.w (
      584               input parParentProc
      585             , input "b-sel":U
      586             , input no
      587             , input 0
      588             , output v-firm-code
      589             , input-output v-rid-list
      590         ) no-error.
      591         if v-rid-list = "":U then return.
      592       find first buf_sysconf no-lock
      593                         where recid(buf_sysconf) = integer(entry(1, v-rid-list)).
      594       v-from-obj-code = buf_sysconf.host-code.
      595      end.
      596      if p-obj-type = 'скл':U then do:
      597       message
      598       "Выберите склад для копирования ПАРАМЕТРОВ"
      599       view-as alert-box WARNING.
      600         run adm/stores.w ( input parparentproc
      601                           ,input "b-sel"
      602                           ,input-output v-rid-list
      603                           ,input no ).
      604        if v-rid-list = "":U then return.
      605        find first buf_store no-lock where
      606                 recid(buf_store) = integer(v-rid-list) .
      607        v-from-obj-code = buf_store.obj-code.
      608      end.
      609      if p-obj-type = 'БД':U then do:
      610         message
      611         "Выберите БД для копирования ПАРАМЕТРОВ"
      612         view-as alert-box WARNING.
      613         run adm/dbs.w (
      614               input parParentProc
      615             , input 'ПРОСМОТР':U
      616             , output v-rec
      617         ) no-error.
      618         if v-rec = ? then return.
      619       find first buf_db no-lock
      620                         where recid(buf_db) = v-rec.
      621       v-from-obj-code = buf_db.db-num.
      622      end.
      623      if (p-obj-type = 'маг':U
      624      AND p-obj-code = buf_shop.obj-code )
      625      or (p-obj-type = 'скл':U
      626      AND p-obj-code = buf_store.obj-code )
      627      or (p-obj-type = 'орг':U
      628      AND p-obj-code = buf_sysconf.host-code )
      629      or (p-obj-type = 'БД':U
      630      AND p-obj-code = buf_db.db-num )
      631      or (p-obj-type = '':U
      632      AND p-obj-code = 0 )
      633      then do:
      634        message "Нельзя копировать ПАРАМЕТРЫ самих в себя"
      635        view-as alert-box error .
      636        return error .
      637      end.
      638      run waitfram-show in this-procedure ( input "Ждите..." ).
      639      DO ii = 1 to num-entries(v-attr-code):
      640         for each thbjattr_thbj-attr:
      641           delete thbjattr_thbj-attr.
      642         end.
      643         assign
      644         v-ii = v-ii + 1.
      645         run thbjattr_get-section  in this-procedure (
      646              input  p-obj-type
      647             ,input  v-from-obj-code
      648             ,input  entry(ii, v-attr-code)
      649             ,input '':U
      650             ,input-output table thbjattr_thbj-attr
      651             ,output v-found
      652                                                 ) no-error .
      653         if not error-status:error then do:
      654           run thbjattr_set-section in this-procedure (
      655                                                  input p-obj-type
      656                                                 ,input p-obj-code
      657                                                 ,input entry(ii, v-attr-code)
      658                                                 ,input table thbjattr_thbj-attr ) no-error .
      659           if not error-status:error then
      660           assign
      661           v-ok = v-ok + 1
      662           .
      663         end.
      664      end.
      665      run waitfram-hide in this-procedure .
      666      if v-ii = v-ok then do:
      667         message
      668         substitute("Скопировано &1 параметров с &4&5 на &2&3"
      669                    , v-ok
      670                    , p-obj-type
      671                    , p-obj-code
      672                    , p-obj-type
      673                    , v-from-obj-code
      674                    )
      675         view-as alert-box .
      676      end.
      677      else do:
      678         message
      679         substitute("Из &1 параметров удалось скопировать &2 параметров с &3&4 на &5&6"
      680                    , v-ii
      681                    , v-ok
      682                    , p-obj-type
      683                    , p-obj-code
      684                    , p-obj-type
      685                    , v-from-obj-code
      686                    )
      687         view-as alert-box WARNING.
      688      end.
      689   end.
      690   end.
      691   end procedure.
      692   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      693   define variable v-waitfram-action01         as character   no-undo .
      694   define variable v-waitfram-action02         as character   no-undo .
      695   define variable v-waitfram-action03         as character   no-undo .
      696   define variable mWaitFramTextBeg            as character   no-undo.
      697   define variable mWaitFramTextEnd            as character   no-undo.
      698   define variable mWaitFramView               as logical     no-undo.
      699   define variable mWaitProcEvent              as logical     no-undo init yes.
      700   define variable mWaitFramInterval           as integer     no-undo init 1 .
      701   define variable mWaitFramStop               as logical     no-undo.
      702   define variable mWaitFramStopUser           as logical     no-undo.
      703   define variable mWaitFramStopTimeOut        as logical     no-undo.
      704   define variable mWaitFramStartProc          as datetime-tz no-undo.
      705   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      706   define button B-WaitFramStop auto-end-key
      707        label "Стоп"
      708        size 10 by 1 tooltip "Остоновить процесс".
      709   define button B-viewProcInfo
      710        label "Информация"
      711        size 15 by 1 tooltip "Информация о процесс".
      712   define frame waitfram
      713     v-waitfram-action01 format "x(72)" no-label skip
      714     v-waitfram-action02 format "x(72)" no-label skip
      715     v-waitfram-action03 format "x(72)" no-label skip
      716     B-viewProcInfo
      717     B-WaitFramStop at row 4 col 30
      718     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      719     .
      720   define new global shared variable mBatchMode as logical no-undo init ?.
      721   define variable mFramBachModHandle as handle no-undo.
      722   mFramBachModHandle = frame waitfram:handle.
      723   define variable mFameOldVis as logical no-undo.
      724   define variable mVisCUrentVin as logical no-undo.
      725   if session:batch-mode
      726   then
      727      mBatchMode = yes.
      728   if mBatchMode = ? then do:
      729     mVisCUrentVin = current-window:visible.
      730     mFameOldVis = mFramBachModHandle:visible.
      731     mFramBachModHandle:visible  = yes.
      732     mBatchMode = mFramBachModHandle:visible ne yes.
      733     mFramBachModHandle:visible = mFameOldVis.
      734     current-window:visible = mVisCUrentVin.
      735   end.
      736    if  log-manager:logfile-name ne ?
      737     then DO:
      738         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      739         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      740         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      741     end.
      742   on choose of B-WaitFramStop in frame waitfram
      743   do:
      744     mWaitFramStop = yes.
      745     mWaitFramStopUser = yes.
      746   end.
      747   function waitfram-check-timeout returns logical():
      748      define variable vtime as int64 no-undo.
      749      if mWaitFramStopTimeOut
      750      then
      751         return yes.
      752      vtime = ( now - mWaitFramStartProc ) / 1000 .
      753      if     mWaitFramTimeOut ne ?
      754         and mWaitFramTimeOut ne 0
      755         and mWaitFramTimeOut lt vtime
      756      then do:
      757         mWaitFramStopTimeOut = yes.
      758      end.
      759      return mWaitFramStopTimeOut.
      760   end.
      761   procedure waitfram-hide :
      762     if not session:batch-mode
      763     then do
      764     on error undo, return error return-value
      765     :
      766       pause 0 before-hide .
      767       if not mBatchMode then
      768         hide frame waitfram .
      769     if     not mWaitFramView
      770        and mWaitProcEvent
      771     then
      772       process events .
      773     end.
      774   end procedure.
      775   procedure waitfram-show :
      776     define input  parameter p-message as character no-undo .
      777     define variable v-left-margin as integer   no-undo .
      778     if not session:batch-mode
      779     then do
      780     on error undo, return error return-value
      781     :
      782       if length(p-message) <= 70 then do:
      783         assign
      784           v-left-margin = integer((70 - length(p-message)) / 2)
      785         .
      786         assign
      787           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      788         .
      789         assign
      790           v-waitfram-action01 = " "
      791           v-waitfram-action02 = " "
      792                                    + fill(" ", v-left-margin)
      793                                    + p-message
      794           v-waitfram-action03 = " "
      795         .
      796       end.
      797       else do:
      798         define variable vRindex1 as integer no-undo.
      799         define variable vRindex2 as integer no-undo.
      800         vRindex1 = r-index(p-message," ",70).
      801         if vRindex1 = 0
      802         then
      803            vRindex1 = 70.
      804         if length(p-message)  <= vRindex1 + 70 then do:
      805           assign
      806             v-waitfram-action01 = " "
      807             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      808             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      809           .
      810         end.
      811         else do:
      812           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      813           if vRindex2 <= vRindex1
      814           then
      815              vRindex2 = vRindex1 + 70.
      816           assign
      817             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      818             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      819             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      820           .
      821         end.
      822       end.
      823       B-viewProcInfo:visible   in frame waitfram = no.
      824       B-viewProcInfo:sensitive in frame waitfram = no.
      825       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      826       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      827       if  (   mWaitFramView
      828          or  mWaitProcEvent)
      829          and not mBatchMode
      830       then
      831          display
      832             v-waitfram-action01 skip
      833             v-waitfram-action02 skip
      834             v-waitfram-action03 skip
      835          with frame waitfram .
      836       if     mWaitFramView
      837          then do:
      838             if     mWaitFramInterval ne ?
      839                and not mBatchMode
      840             then
      841                wait-for go of frame waitfram pause mWaitFramInterval.
      842          end.
      843          else
      844             if     mWaitProcEvent
      845                and not mBatchMode
      846             then
      847                process events .
      848     end.
      849   end procedure.
      850      procedure waitfram-show-this:
      851         define input  parameter iInterval as int64 no-undo.
      852         define variable vtime as int64 no-undo.
      853         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      854         mWaitFramInterval = iInterval.
      855         run waitfram-show (substitute("&1&2 &3&4" ,
      856                                       mWaitFramTextBeg ,
      857                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      858                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      859                                       mWaitFramTextEnd
      860                                      )
      861                           ).
      862      end.
      863      procedure WaitFramRunPause:
      864         define input  parameter iInterval as dec no-undo.
      865         define variable vStart  as datetime-tz no-undo.
      866         define variable vend    as datetime-tz no-undo.
      867         define variable vint as int64 no-undo.
      868         define variable vOk as logical no-undo.
      869         vStart = now.
      870         vend   = vStart.
      871         publish "WaitFramPause" (iInterval,output vOk).
      872         vend   =  now.
      873         vint = vend - vStart.
      874         vint = iInterval - vint / 1000.
      875         if     not mWaitFramStop
      876            and (   vint > 0
      877                 or (    not vOk
      878                     and iInterval eq ?
      879                     )
      880                 )
      881         then
      882            run waitfram-show-this (iInterval).
      883         vend   =  now.
      884         vint = vend - vStart.
      885         vint = iInterval - vint / 1000.
      886         if     not mWaitFramStop
      887            and vint > 0
      888         then do:
      889            run gbl/pause.p (vint * 1000).
      890         end.
      891         if iInterval ne ?
      892         then
      893            publish "WaitFramStop".
      894         waitfram-check-timeout().
      895      end.
      896      procedure WaitFramWaitFor:
      897         define input  parameter iInterval as dec no-undo.
      898         assign
      899            mWaitFramStartProc   = now
      900            mWaitFramStopUser    = no
      901            mWaitFramStopTimeOut = no
      902         .
      903         block-wait:
      904         do while not mWaitFramStop:
      905            run WaitFramRunPause (iInterval).
      906            if  waitfram-check-timeout()
      907            then do:
      908               leave block-wait.
      909            end.
      910         end.
      911         run waitfram-hide.
      912      end.
      913   procedure waitfram-join :
      914     define input  parameter p-line-1  as character no-undo .
      915     define input  parameter p-line-2  as character no-undo .
      916     define input  parameter p-line-3  as character no-undo .
      917     define output parameter p-message as character no-undo .
      918     do
      919     on error undo, return error return-value
      920     :
      921       assign
      922         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      923                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      924                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      925       .
      926     end.
      927   end procedure.
      928   function waitfram-join-function returns character
      929     (input p-line-1 as character
      930     ,input p-line-2 as character
      931     ,input p-line-3 as character
      932     ).
      933     define variable v-message as character no-undo .
      934     run waitfram-join in this-procedure
      935       (input  p-line-1
      936       ,input  p-line-2
      937       ,input  p-line-3
      938       ,output v-message
      939       ) .
      940     return v-message .
      941   end function .
      942   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      943     define variable v-cntxt-db-num        as integer   no-undo .
      944     define variable v-cntxt-userid        as character no-undo .
      945     define variable v-cntxt-level         as character no-undo .
      946     define variable v-cntxt-host-code-obj as integer   no-undo .
      947     define variable v-cntxt-obj-type      as character no-undo .
      948     define variable v-cntxt-obj-code      as integer   no-undo .
      949     define variable v-cntxt-db-num-obj    as integer   no-undo .
      950     define variable v-cntxt-is-admin      as logical   no-undo .
      951   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      952   FUNCTION mark-string RETURNS CHARACTER
      953     ( input p-recid as recid, input mark-list as character  ) :
      954     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      955   END FUNCTION.
      956   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      957   define temp-table x_obj-group no-undo like ub.clients  .
      958   define temp-table x_grp-obj-price no-undo like ub.grp-obj-price .
      959   procedure metod-gop-obj :
      960     do
      961     on error undo, return error return-value
      962     :
      963   define input  parameter p-cntxt-db-num as integer   no-undo .
      964   define input  parameter p-gop-id       as integer   no-undo .
      965   define input  parameter p-gop-db-num   as integer   no-undo .
      966   define buffer buf1_clients for ub.clients  .
      967   define buffer buf_db-grp-obj-price   for ub.db-grp-obj-price  .
      968   define buffer buf_host-grp-obj-price for ub.host-grp-obj-price  .
      969   define buffer buf_obj-grp-obj-price  for ub.obj-grp-obj-price  .
      970   for each  x_obj-group : delete x_obj-group. end.
      971   if p-gop-id = 0 or p-gop-id = ?  then do:
      972      if p-cntxt-db-num = 0  then do:
      973           for each buf1_clients no-lock where
      974                   (buf1_clients.obj-type = 'маг':U  or
      975                    buf1_clients.obj-type = 'скл':U  )
      976                   and
      977                   buf1_clients.db-num >= 0  and
      978                   buf1_clients.stts = 0
      979                   :
      980             create x_obj-group .
      981             assign
      982               x_obj-group.obj-code   = buf1_clients.obj-code
      983               x_obj-group.obj-type   = buf1_clients.obj-type
      984               x_obj-group.obj-name   = buf1_clients.obj-name
      985               x_obj-group.db-num     = buf1_clients.db-num
      986             .
      987           end.
      988      end.
      989      else do:
      990           for each buf1_clients no-lock where
      991                   (buf1_clients.obj-type = 'маг':U  or
      992                    buf1_clients.obj-type = 'скл':U  ) and
      993                    buf1_clients.db-num = p-cntxt-db-num  and
      994                    buf1_clients.stts = 0
      995                   :
      996             create x_obj-group .
      997             assign
      998               x_obj-group.obj-code   = buf1_clients.obj-code
      999               x_obj-group.obj-type   = buf1_clients.obj-type
     1000               x_obj-group.obj-name   = buf1_clients.obj-name
     1001               x_obj-group.db-num     = buf1_clients.db-num
     1002             .
     1003           end.
     1004      end.
     1005   end.
     1006   else do:
     1007         for each buf_db-grp-obj-price  where
     1008                 buf_db-grp-obj-price.gop-id     = p-gop-id and
     1009                 buf_db-grp-obj-price.gop-db-num = p-gop-db-num and
     1010                 buf_db-grp-obj-price.stts = 0  no-lock :
     1011           for each buf1_clients no-lock where
     1012                  (buf1_clients.obj-type = 'маг':U  or
     1013                   buf1_clients.obj-type = 'скл':U  ) and
     1014                   buf1_clients.db-num = buf_db-grp-obj-price.dgo-db-num  and
     1015                   buf1_clients.stts = 0
     1016                   :
     1017             create x_obj-group .
     1018             assign
     1019               x_obj-group.obj-code   = buf1_clients.obj-code
     1020               x_obj-group.obj-type   = buf1_clients.obj-type
     1021               x_obj-group.obj-name   = buf1_clients.obj-name
     1022               x_obj-group.db-num     = buf1_clients.db-num
     1023             .
     1024           end.
     1025         end.
     1026       for each buf_host-grp-obj-price where
     1027               buf_host-grp-obj-price.gop-id     = p-gop-id and
     1028               buf_host-grp-obj-price.gop-db-num = p-gop-db-num and
     1029               buf_host-grp-obj-price.stts = 0
     1030               no-lock :
     1031         for each buf1_clients no-lock where
     1032                (buf1_clients.obj-type = 'маг':U  or
     1033                 buf1_clients.obj-type = 'скл':U  ) and
     1034                 buf1_clients.host-code = buf_host-grp-obj-price.host-code and
     1035                 buf1_clients.stts = 0
     1036                 :
     1037             find first x_obj-group no-lock  where
     1038                       x_obj-group.obj-code   = buf1_clients.obj-code and
     1039                       x_obj-group.obj-type   = buf1_clients.obj-type no-error .
     1040             if not available  x_obj-group then   create x_obj-group .
     1041             assign
     1042               x_obj-group.obj-code   = buf1_clients.obj-code
     1043               x_obj-group.obj-type   = buf1_clients.obj-type
     1044               x_obj-group.obj-name   = buf1_clients.obj-name
     1045               x_obj-group.db-num     = buf1_clients.db-num
     1046             .
     1047         end.
     1048       end.
     1049       for each buf_obj-grp-obj-price where
     1050               buf_obj-grp-obj-price.gop-id     = p-gop-id and
     1051               buf_obj-grp-obj-price.gop-db-num = p-gop-db-num and
     1052               buf_obj-grp-obj-price.stts = 0
     1053               no-lock :
     1054         for each buf1_clients no-lock where
     1055                   buf1_clients.obj-type = buf_obj-grp-obj-price.obj-type and
     1056                   buf1_clients.obj-code = buf_obj-grp-obj-price.obj-code and
     1057                   buf1_clients.stts     = 0
     1058                   :
     1059             find first  x_obj-group no-lock  where
     1060                         x_obj-group.obj-code   = buf1_clients.obj-code and
     1061                         x_obj-group.obj-type   = buf1_clients.obj-type no-error .
     1062             if not available  x_obj-group then   create x_obj-group .
     1063             assign
     1064               x_obj-group.obj-code   = buf1_clients.obj-code
     1065               x_obj-group.obj-type   = buf1_clients.obj-type
     1066               x_obj-group.obj-name   = buf1_clients.obj-name
     1067               x_obj-group.db-num     = buf1_clients.db-num
     1068             .
     1069         end.
     1070       end.
     1071   end.
     1072   end.
     1073   end procedure.
     1074   procedure metod-obj-in-gop :
     1075   define input  parameter p-curr-db-num as integer   no-undo .
     1076   define input  parameter p-obj-type as character no-undo .
     1077   define input  parameter p-obj-code as integer   no-undo .
     1078   define buffer buf_grp-obj-price for ub.grp-obj-price  .
     1079     do
     1080     on error undo, return error return-value
     1081     :
     1082       empty temp-table x_grp-obj-price.
     1083       for each buf_grp-obj-price where
     1084                buf_grp-obj-price.stts = 0
     1085                no-lock :
     1086                  run metod-gop-obj (p-curr-db-num , buf_grp-obj-price.gop-id ,buf_grp-obj-price.gop-db-num) .
     1087                  for each x_obj-group where
     1088                           x_obj-group.obj-type = p-obj-type and
     1089                           x_obj-group.obj-code = p-obj-code :
     1090                       create  x_grp-obj-price.
     1091                       buffer-copy buf_grp-obj-price to x_grp-obj-price .
     1092                  end.
     1093       end.
     1094     end.
     1095   end procedure.
     1096   procedure metod-delobj-usr :
     1097   define input  parameter p-pdf-id  as integer   no-undo .
     1098   define input  parameter p-pdf-db  as integer   no-undo .
     1099   define input  parameter p-plt-id  as integer   no-undo .
     1100   define input  parameter p-plt-db-num as integer   no-undo .
     1101   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
     1102     do
     1103     on error undo, return error return-value
     1104     :
     1105   for each buf_price-doc-forming-attr no-lock  where
     1106            buf_price-doc-forming-attr.pdf-id =     p-pdf-id and
     1107            buf_price-doc-forming-attr.pdf-db =     p-pdf-db and
     1108            buf_price-doc-forming-attr.plt-id =     p-plt-id and
     1109            buf_price-doc-forming-attr.plt-db-num = p-plt-db-num and
     1110            buf_price-doc-forming-attr.attr-code begins "obj" :
     1111      for each x_obj-group  where
     1112               x_obj-group.obj-type = substring(buf_price-doc-forming-attr.attr-code,4,3) and
     1113               x_obj-group.obj-code = int(substring(buf_price-doc-forming-attr.attr-code,7,20)) :
     1114        delete x_obj-group.
     1115      end.
     1116   end.
     1117     if not can-find (first x_obj-group) then do:
     1118        return "nullobj" .
     1119     end.
     1120   end.
     1121   end procedure.
     1122   procedure metod-obj-pdf :
     1123   define input  parameter p-cntxt-db-num as integer   no-undo .
     1124   define input  parameter p-pdf-id     like ub.price-doc-forming.pdf-id   no-undo .
     1125   define input  parameter p-pdf-db-num like ub.price-doc-forming.pdf-db   no-undo .
     1126   define input  parameter p-plt-id     like ub.price-doc-forming.plt-id   no-undo .
     1127   define input  parameter p-plt-db-num like ub.price-doc-forming.plt-db-num  no-undo .
     1128   define buffer buf_price-list-type for ub.price-list-type  .
     1129   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     1130     do
     1131     on error undo, return error return-value
     1132     :
     1133    for each  x_obj-group : delete x_obj-group. end.
     1134    find first buf_price-list-type no-lock where
     1135               buf_price-list-type.plt-id = p-plt-id and
     1136               buf_price-list-type.plt-db-num = p-plt-db-num no-error .
     1137   if error-status :error then return error return-value .
     1138    find first buf_price-doc-forming no-lock where
     1139               buf_price-doc-forming.plt-id     = p-plt-id and
     1140               buf_price-doc-forming.plt-db-num = p-plt-db-num and
     1141               buf_price-doc-forming.pdf-id     = p-pdf-id and
     1142               buf_price-doc-forming.pdf-db     = p-pdf-db-num
     1143               no-error .
     1144   if error-status :error then return error return-value .
     1145     run metod-gop-obj in this-procedure (
     1146         p-cntxt-db-num,
     1147         buf_price-list-type.gop-id ,
     1148         buf_price-list-type.gop-db-num
     1149         ) no-error .
     1150     run metod-delobj-usr in this-procedure (
     1151       buf_price-doc-forming.pdf-id ,
     1152       buf_price-doc-forming.pdf-db ,
     1153       buf_price-doc-forming.plt-id ,
     1154       buf_price-doc-forming.plt-db-num
     1155       ) no-error .
     1156     end.
     1157   end procedure.
     1158   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1159   define temp-table x_obj-grp-obj-price no-undo like ub.obj-grp-obj-price .
     1160   procedure metod-gop-obj-all :
     1161   define input  parameter p-curr-db-num as integer   no-undo .
     1162     do
     1163     on error undo, return error return-value
     1164     :
     1165    empty temp-table x_obj-group .
     1166    empty temp-table x_obj-grp-obj-price .
     1167    define buffer buf_grp-obj-price for ub.grp-obj-price  .
     1168    for each buf_grp-obj-price no-lock where
     1169             buf_grp-obj-price.stts = 0 :
     1170         run metod-gop-obj in this-procedure (
     1171             input  p-curr-db-num ,
     1172             input  buf_grp-obj-price.gop-id       ,
     1173             input  buf_grp-obj-price.gop-db-num   ).
     1174             for each x_obj-group :
     1175                create x_obj-grp-obj-price.
     1176                buffer-copy buf_grp-obj-price to x_obj-grp-obj-price
     1177                assign
     1178                   x_obj-grp-obj-price.obj-type = x_obj-group.obj-type
     1179                   x_obj-grp-obj-price.obj-code = x_obj-group.obj-code
     1180                .
     1181             end.
     1182    end.
     1183     end.
     1184   end procedure.
     1185   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1186   FUNCTION price-grp RETURNS CHARACTER
     1187   (buffer buf_clients for ub.clients):
     1188   define variable tt-grp-obj as character no-undo .
     1189   tt-grp-obj =  "" .
     1190     for each x_obj-grp-obj-price  where
     1191              x_obj-grp-obj-price.stts = 0 and
     1192              x_obj-grp-obj-price.obj-type = buf_clients.obj-type and
     1193              x_obj-grp-obj-price.obj-code = buf_clients.obj-code :
     1194              tt-grp-obj = tt-grp-obj + string(x_obj-grp-obj-price.gop-id ) +
     1195              ( if x_obj-grp-obj-price.gop-db-num = 0 then "" else
     1196              "БД"  + string (x_obj-grp-obj-price.gop-db-num)) + "," .
     1197     end.
     1198   return trim(tt-grp-obj, ",") .
     1199   END FUNCTION.
     1200   define variable mark-num as integer no-undo.
     1201   define variable attr-option as character no-undo .
     1202   define variable cli-attr-option as character no-undo .
     1203   define variable v-is-deploy as logical no-undo .
     1204   define variable v-rid-list as character no-undo .
     1205   define variable v-doc-rec as recid no-undo .
     1206   define variable v-grp as character no-undo .
     1207   define variable v-exist-price-grp as logical   no-undo .
     1208   define buffer X_cli-host for ub.clients.
     1209   define buffer X_shop for ub.shop.
     1210   define buffer X_clients for ub.clients.
     1211   DEFINE BUTTON b-mark
     1212        LABEL " * ":L
     1213        SIZE 3 BY 1.
     1214   DEFINE BUTTON b-add
     1215        LABEL "&Добавить":L
     1216        SIZE 10 BY 1.
     1217   DEFINE BUTTON b-chg
     1218        LABEL "&Изменить":L
     1219        SIZE 10 BY 1.
     1220   DEFINE BUTTON b-del
     1221        LABEL "&Удалить":L
     1222        SIZE 10 BY 1.
     1223   DEFINE BUTTON b-lkp
     1224        LABEL "&Просм"
     1225        SIZE 10 BY 1.
     1226   DEFINE BUTTON b-quit AUTO-END-KEY DEFAULT
     1227        LABEL "&Выход ":L
     1228        SIZE 10 BY 1
     1229        BGCOLOR 8 .
     1230   DEFINE BUTTON b-help
     1231        LABEL "Помо&щь":L
     1232        SIZE 3 BY 1.
     1233   DEFINE BUTTON B-dis-rule
     1234        LABEL "&Скидки"
     1235        SIZE 10 BY 1.
     1236   DEFINE BUTTON B-hist
     1237        LABEL "Ис&тория"
     1238        SIZE 3 BY 1.
     1239   DEFINE BUTTON b-print
     1240        LABEL "Пе&чать":L
     1241        SIZE 3 BY 1.
     1242   DEFINE BUTTON b-sel AUTO-GO
     1243        LABEL "Вы&бор ":L
     1244        SIZE 10 BY 1.
     1245   DEFINE BUTTON b-rights
     1246        LABEL "Пр&ава ":L
     1247        SIZE 10 BY 1.
     1248   DEFINE BUTTON b-price
     1249        LABEL "&Цены":L
     1250        SIZE 10 BY 1.
     1251   DEFINE BUTTON b-attr
     1252        LABEL "Параметры":L
     1253        SIZE 10 BY 1.
     1254   DEFINE BUTTON b-cli-attr
     1255        LABEL "Атрибуты":L
     1256        SIZE 10 BY 1.
     1257   DEFINE BUTTON B-grp
     1258        LABEL "&Группа"
     1259        SIZE 10 BY 1.
     1260   DEFINE MENU MENU-B-attr
     1261          MENU-ITEM m_lookup       LABEL "&Просмотр"
     1262          MENU-ITEM m_update          LABEL "Изменение"
     1263          MENU-ITEM m_copy         LABEL "&Копирование"
     1264          rule
     1265          MENU-ITEM m_price-grp    LABEL "Группа ценообразования"
     1266          .
     1267   DEFINE MENU MENU-B-cli-attr
     1268          MENU-ITEM m_lookup-cli       LABEL "&Просмотр"
     1269          MENU-ITEM m_update-cli        LABEL "Изменение"
     1270          .
     1271   DEFINE VARIABLE sch-code AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
     1272        LABEL "код"
     1273        VIEW-AS FILL-IN
     1274        SIZE 6 BY 1 NO-UNDO.
     1275   DEFINE QUERY br-shops FOR X_shop, X_clients, X_cli-host SCROLLING.
     1276   DEFINE BROWSE br-shops QUERY br-shops NO-LOCK DISPLAY
     1277   mark-string(recid(X_shop), v-rid-list) Format "X(1)" COLUMN-LABEL "*"
     1278   X_shop.obj-code COLUMN-LABEL "Код " FORMAT ">>>>>>>>9"
     1279   X_clients.obj-name COLUMN-LABEL "Название " FORMAT "x(80)" width 25
     1280   X_cli-host.obj-name COLUMN-LABEL "Фирма" FORMAT "x(80)" width 25
     1281   (if X_clients.stts = 0 then " " else "+") format "x(1)" column-label "Удал"
     1282   X_clients.db-num FORMAT ">>>>>>>>9"
     1283   X_shop.shift-on COLUMN-LABEL "Смены":L format " + / - "
     1284   X_clients.grp-name COLUMN-LABEL "Группа" format "X(80)" width 25
     1285   price-grp ( buffer X_clients ) @ v-grp COLUMN-LABEL "Группа ценообразования" FORMAT "x(80)" width 25
     1286   WITH SIZE 98 BY 19 separators.
     1287   DEFINE FRAME d-shop
     1288        b-quit AT ROW 1 COL 1
     1289        b-mark AT ROW 1 COL 11
     1290        b-sel AT ROW 1 COL 14
     1291        b-add AT ROW 1 COL 24
     1292        b-lkp AT ROW 1 COL 34
     1293        b-chg AT ROW 1 COL 44
     1294        b-del AT ROW 1 COL 54
     1295        b-attr AT ROW 1 COL 64
     1296        b-rights AT ROW 1 COL 74
     1297        b-print AT ROW 1 COL 89
     1298        b-hist AT ROW 1 COL 92
     1299        b-help AT ROW 1 COL 95
     1300        mark-num at row 2 col 14 colon-aligned no-label view-as fill-in size 3 by 1 fgcolor 4
     1301        sch-code AT ROW 2 COL 25
     1302        b-cli-attr AT ROW 2 COL 54
     1303        b-price AT ROW 2 COL 64
     1304        b-dis-rule AT ROW 2 COL 74
     1305        b-grp AT ROW 2 COL 84
     1306        br-shops AT ROW 3.25 COL 1
     1307        SPACE(0.74) SKIP(0.66)
     1308       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1309            SIDE-LABELS NO-UNDERLINE THREE-D SCROLLABLE
     1310            TITLE "   Магазины" .
     1311   ASSIGN
     1312          FRAME d-shop:SCROLLABLE       = FALSE
     1313          br-shops:NUM-LOCKED-COLUMNS IN FRAME d-shop = 1.
     1314   ON CHOOSE OF b-add IN FRAME d-shop
     1315   DO:
     1316     define variable ri as recid no-undo.
     1317     define buffer buf_shop for ub.shop.
     1318     define buffer buf_clients for ub.clients.
     1319     run adm/shopi.w ( input parparentproc
     1320                      ,input v-cntxt-host-code-obj
     1321                      ,input 0
     1322                      ,input 'ДОБАВЛЕНИЕ':U
     1323                      ,input-output ri).
     1324     if ri <> ? then do:
     1325         find buf_clients where
     1326              recid (buf_clients) = ri no-lock.
     1327         find buf_shop where
     1328             buf_shop.obj-code = buf_clients.obj-code no-lock.
     1329         ri = recid (buf_shop).
     1330         run enable_UI.
     1331         reposition br-shops to recid ri no-error.
     1332         apply "ENTRY" to br-shops.
     1333     end.
     1334     return no-apply.
     1335   END.
     1336   ON CHOOSE OF b-chg IN FRAME d-shop
     1337   DO:
     1338     define variable ri as recid no-undo.
     1339     if available X_shop then do:
     1340         ri = recid (X_clients).
     1341         run adm/shopi.w ( input parparentproc
     1342                          ,input  X_shop.host-code
     1343                          ,input X_shop.obj-code, 'ИЗМЕНЕНИЕ':U, input-output ri).
     1344         display
     1345         X_clients.obj-name
     1346         X_clients.grp-name
     1347         X_shop.shift-on
     1348         with browse br-shops.
     1349     end.
     1350   END.
     1351   ON CHOOSE OF b-del IN FRAME d-shop
     1352   DO:
     1353     define variable  ri as recid no-undo.
     1354     if available X_shop then do:
     1355       ri = recid(X_shop).
     1356       run ref/clients2.p ( input parparentproc
     1357                           ,input recid(X_clients)
     1358                           ,input ?
     1359                           ,input no
     1360                           ,input yes
     1361                           ,input '':U
     1362                           ,input '':U
     1363                           ,input '':U
     1364                           ) no-error .
     1365       if error-status:error then do:
     1366         return no-apply.
     1367       end.
     1368       run Openbr in this-procedure .
     1369       reposition br-shops to recid ri no-error.
     1370       apply "ENTRY" to br-shops.
     1371       apply "value-changed" to br-shops.
     1372     end.
     1373   END.
     1374   ON CHOOSE OF b-lkp IN FRAME d-shop
     1375   DO:
     1376     define variable ri as recid no-undo.
     1377     if available X_shop then do:
     1378         ri = recid (X_clients).
     1379         run adm/shopi.w ( input parparentproc
     1380                          ,input  v-cntxt-host-code-obj
     1381                          ,input X_shop.obj-code
     1382                          ,input 'ПРОСМОТР':U
     1383                          ,input-output ri).
     1384         apply "entry" to browse br-shops.
     1385     end.
     1386   END.
     1387   ON CHOOSE OF b-quit IN FRAME d-shop
     1388   DO:
     1389   END.
     1390   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1391   on help of frame d-shop
     1392   do:
     1393     run gbl/app_help.p
     1394       (input this-procedure :file-name
     1395       ,input ''
     1396       ,input ?
     1397       ) no-error.
     1398     if error-status :error then do:
     1399       message
     1400         "Ошибка при вызове помощи"
     1401         error-status :get-message(1)
     1402         view-as alert-box .
     1403     end.
     1404   end.
     1405   run minbtn-set in this-procedure .
     1406   on choose of b-help in frame d-shop
     1407   do:
     1408     apply "help":u to frame d-shop .
     1409   end.
     1410   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1411   procedure minbtn-set :
     1412       do
     1413           on error undo, return error return-value
     1414           :
     1415           define variable ii              as integer       no-undo .
     1416           define variable fh              as widget-handle no-undo .
     1417           define variable hh              as widget-handle no-undo .
     1418           define variable v-h             as handle        extent 4 no-undo .
     1419           define variable v-name-button   as character     no-undo .
     1420           define variable v-help-old-x    as decimal       no-undo .
     1421           define variable v-help-old-y    as decimal       no-undo .
     1422           define variable v-help-old-size as decimal       no-undo .
     1423           define variable v-frame-width   as decimal       no-undo .
     1424           define variable jj              as integer       no-undo .
     1425           do
     1426               on error undo, return error
     1427               :
     1428               assign
     1429                   v-frame-width = frame d-shop:width - 0.3
     1430                   fh            = frame d-shop:first-child
     1431                   hh            = fh:first-child
     1432                   ii            = 1
     1433                   .
     1434               do while valid-handle(hh):
     1435                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1436                   do:
     1437                       case lc(hh:name) :
     1438                           when "b-help" then
     1439                               do:
     1440                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1441                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1442                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1443                                   hh:TOOLTIP = "Помощь" .
     1444                                   v-help-old-x = hh:column .
     1445                                   v-help-old-y = hh:row    .
     1446                                   v-help-old-size = hh:width .
     1447                                   hh:width-chars = 2.5 .
     1448                               end.
     1449                           when "b-print" then
     1450                               do:
     1451                                   hh:load-image("cmp/b-print.bmp":u) .
     1452                                   hh:TOOLTIP = "Печать" .
     1453                                   v-h[ii] = hh:handle .
     1454                                   ii = ii + 1 .
     1455                                   hh:width-chars = 3 .
     1456                               end.
     1457                           when "b-history" or
     1458                           when "b-hist" then
     1459                               do:
     1460                                   hh:load-image("cmp/b-hist.bmp":u) .
     1461                                   hh:TOOLTIP = "История" .
     1462                                   v-h[ii] = hh:handle .
     1463                                   ii = ii + 1 .
     1464                                   hh:width-chars = 3 .
     1465                               end.
     1466                           when "b-sch" then
     1467                               do:
     1468                                   hh:load-image("cmp/b-sch.bmp":u) .
     1469                                   hh:TOOLTIP = "Установка Фильтра" .
     1470                                   v-h[ii] = hh:handle .
     1471                                   ii = ii + 1 .
     1472                                   hh:width-chars = 3 .
     1473                               end.
     1474                           when "b-hist-user" then
     1475                               do:
     1476                                   hh:load-image("cmp/b-hist.bmp":u) .
     1477                                   hh:TOOLTIP = "История пользователя" .
     1478                                   ii = ii + 1 .
     1479                               end.
     1480                       end case.
     1481                   end.
     1482                   hh = hh:next-sibling.
     1483               end.
     1484               b-help:column = v-frame-width - b-help:width-chars.
     1485               jj = 0.
     1486               repeat ii = 4 to 1 by -1 :
     1487                   if valid-handle (v-h[ii] ) then
     1488                   do:
     1489                       jj  = jj + 1 .
     1490                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1491                       v-h[ii]:row    = v-help-old-y .
     1492                   end.
     1493               end.
     1494           end.
     1495       end.
     1496   end procedure.
     1497   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1498   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1499   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1500   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1501   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1502   define variable v-diasize-current-frame-height as decimal   no-undo .
     1503   define variable v-diasize-change-size          as logical   no-undo .
     1504   define variable v-diasize-resize-button        as handle    no-undo .
     1505   define variable v-diasize-wndmax               as logical   no-undo .
     1506   define variable v-diasize-wndstore             as logical   no-undo .
     1507   define variable v-diasize-proc-name            as character no-undo .
     1508   define variable v-diasize-browse-handle        as handle    no-undo .
     1509   define variable v-diasize-browse-number        as integer   no-undo .
     1510   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1511   define temp-table temp-diasize-handle no-undo
     1512     field handle-value  as handle
     1513     field save-position as decimal
     1514     index xpk is primary unique handle-value
     1515     .
     1516   define temp-table temp-browse-handle no-undo
     1517     field browse-type   as character
     1518     field browse-number as integer
     1519     field browse-handle as handle
     1520     field original-size as decimal
     1521     index xpk is primary unique browse-type browse-number
     1522     index xie browse-type browse-handle
     1523   .
     1524   procedure diasize_change-height :
     1525     define input  parameter p-change-value  as decimal   no-undo .
     1526     define input  parameter p-move-resize   as logical   no-undo .
     1527     define variable v-field-group-handle    as handle    no-undo .
     1528     define variable v-object-handle         as handle    no-undo .
     1529     define variable v-frame-height          as decimal   no-undo .
     1530     define variable v-frame-virtual-height  as decimal   no-undo .
     1531     define variable v-browse-height         as decimal   no-undo .
     1532     define variable v-window-height         as decimal   no-undo .
     1533     define variable v-window-virtual-height as decimal   no-undo .
     1534     define variable v-change-sign           as integer   no-undo .
     1535     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1536     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1537     if p-change-value > 0
     1538     then do:
     1539       if frame d-shop :height + p-change-value
     1540           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1541       then do:
     1542         assign
     1543           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1544                           - (frame d-shop :height-chars)
     1545         .
     1546         if p-change-value <= 0
     1547         then do:
     1548           run diasize_position-resize-button in this-procedure .
     1549           return .
     1550         end.
     1551       end.
     1552     end.
     1553     if p-change-value < 0
     1554     then do:
     1555       if frame d-shop :height + p-change-value < v-diasize-orig-frame-height
     1556       then do:
     1557         assign
     1558           p-change-value = v-diasize-orig-frame-height
     1559                          - (frame d-shop :height-chars)
     1560         .
     1561         if p-change-value >= 0
     1562         then do:
     1563           run diasize_position-resize-button in this-procedure .
     1564           return .
     1565         end.
     1566       end.
     1567     end.
     1568     if p-change-value >= 0
     1569     then do:
     1570       assign
     1571         v-change-sign = 1
     1572       .
     1573     end.
     1574     else do:
     1575       assign
     1576         v-change-sign = -1
     1577       .
     1578     end.
     1579     assign
     1580       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1581     .
     1582     if p-change-value = 0
     1583     then do:
     1584       run diasize_position-resize-button in this-procedure .
     1585       return .
     1586     end.
     1587     move_block:
     1588     do
     1589     on error undo move_block, retry move_block
     1590     :
     1591       if retry
     1592       then do:
     1593         do
     1594         on error undo move_block, leave move_block
     1595         :
     1596           if p-change-value > 0
     1597           then do:
     1598             for each buf_temp-diasize-handle
     1599             on error undo, next
     1600             :
     1601               assign
     1602                 v-object-handle = buf_temp-diasize-handle.handle-value
     1603               .
     1604               if v-object-handle <> v-diasize-resize-button
     1605               then do:
     1606                 assign
     1607                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1608                 .
     1609               end.
     1610             end.
     1611             assign
     1612               v-diasize-browse-handle :height = v-browse-height
     1613             .
     1614             for each buf_temp-browse-handle
     1615               where buf_temp-browse-handle.browse-type = 'height':u
     1616             on error undo, next
     1617             :
     1618               assign
     1619                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1620               .
     1621             end.
     1622             assign
     1623               frame d-shop :height = v-frame-height
     1624             .
     1625             if frame d-shop :scrollable = true
     1626             then do:
     1627               assign
     1628                 frame d-shop :virtual-height = v-frame-virtual-height
     1629               .
     1630             end.
     1631             run diasize_position-resize-button in this-procedure .
     1632           end.
     1633           else do:
     1634             if frame d-shop :scrollable = true
     1635             then do:
     1636               assign
     1637                 frame d-shop :virtual-height = v-frame-virtual-height
     1638               .
     1639             end.
     1640             assign
     1641               frame d-shop :height = v-frame-height
     1642             .
     1643             assign
     1644               v-diasize-browse-handle :height = v-browse-height
     1645             .
     1646             for each buf_temp-browse-handle
     1647               where buf_temp-browse-handle.browse-type = 'height':u
     1648             on error undo, next
     1649             :
     1650               assign
     1651                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1652               .
     1653             end.
     1654             for each buf_temp-diasize-handle
     1655             on error undo, next
     1656             :
     1657               assign
     1658                 v-object-handle = buf_temp-diasize-handle.handle-value
     1659               .
     1660               if v-object-handle <> v-diasize-resize-button
     1661               then do:
     1662                 assign
     1663                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1664                 .
     1665               end.
     1666             end.
     1667             run diasize_position-resize-button in this-procedure .
     1668           end.
     1669           assign
     1670             v-diasize-change-size = false
     1671           .
     1672           leave move_block .
     1673         end.
     1674       end.
     1675       assign
     1676         v-diasize-need-full-display = true
     1677       .
     1678       if v-diasize-change-size = false
     1679       then do:
     1680         assign
     1681           v-diasize-change-size = true
     1682         .
     1683       end.
     1684       else do:
     1685         return .
     1686       end.
     1687       assign
     1688         v-frame-height = frame d-shop :height
     1689         v-frame-virtual-height = frame d-shop :virtual-height
     1690         v-browse-height = v-diasize-browse-handle :height
     1691       .
     1692       for each buf_temp-browse-handle
     1693         where buf_temp-browse-handle.browse-type = 'height':u
     1694       :
     1695         assign
     1696           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1697         .
     1698       end.
     1699       for each buf_temp-diasize-handle
     1700       :
     1701         delete buf_temp-diasize-handle .
     1702       end.
     1703       assign
     1704         v-field-group-handle = frame d-shop :first-child
     1705       .
     1706       do while valid-handle(v-field-group-handle)
     1707       :
     1708         assign
     1709           v-object-handle = v-field-group-handle :first-child
     1710         .
     1711         do while valid-handle(v-object-handle)
     1712         :
     1713           if  v-object-handle <> v-diasize-browse-handle :handle
     1714           and can-query(v-object-handle, "row")
     1715           and can-query(v-object-handle, "height")
     1716           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1717           then do:
     1718             find first buf_temp-browse-handle
     1719               where buf_temp-browse-handle.browse-type   = 'height':u
     1720                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1721               no-error .
     1722             if available buf_temp-browse-handle
     1723             then do:
     1724             end.
     1725             else do:
     1726               create buf_temp-diasize-handle .
     1727               assign
     1728                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1729                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1730               .
     1731             end.
     1732           end.
     1733           assign
     1734             v-object-handle = v-object-handle :next-sibling
     1735           .
     1736         end.
     1737         assign
     1738           v-field-group-handle = v-field-group-handle :next-sibling
     1739         .
     1740       end.
     1741       do with frame d-shop
     1742       :
     1743         hide v-diasize-resize-button .
     1744         assign
     1745           v-diasize-resize-button :row    = 1
     1746           v-diasize-resize-button :column = 1
     1747         .
     1748       end.
     1749       if p-change-value > 0
     1750       then do:
     1751         if frame d-shop :scrollable = true
     1752         then do:
     1753           assign
     1754             frame d-shop :virtual-height = frame d-shop :virtual-height + p-change-value
     1755             no-error .
     1756           if error-status :error
     1757           or error-status :get-message(1) <> ""
     1758           then do:
     1759             undo move_block, retry move_block .
     1760           end.
     1761         end.
     1762         assign
     1763           frame d-shop :height = frame d-shop :height + p-change-value
     1764           no-error .
     1765         if error-status :error
     1766         or error-status :get-message(1) <> ""
     1767         then do:
     1768           undo move_block, retry move_block .
     1769         end.
     1770         assign
     1771           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1772           no-error .
     1773         if error-status :error
     1774         or error-status :get-message(1) <> ""
     1775         then do:
     1776           undo move_block, retry move_block .
     1777         end.
     1778         for each buf_temp-browse-handle
     1779           where buf_temp-browse-handle.browse-type = 'height':u
     1780         on error undo move_block, retry move_block
     1781         :
     1782           assign
     1783             buf_temp-browse-handle.browse-handle :height
     1784               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1785             no-error .
     1786           if error-status :error
     1787           or error-status :get-message(1) <> ""
     1788           then do:
     1789             undo move_block, retry move_block .
     1790           end.
     1791         end.
     1792         for each buf_temp-diasize-handle
     1793         on error undo move_block, retry move_block
     1794         :
     1795           assign
     1796             v-object-handle = buf_temp-diasize-handle.handle-value
     1797           .
     1798           if v-object-handle <> v-diasize-resize-button
     1799           then do:
     1800             assign
     1801               v-object-handle :row = v-object-handle :row + p-change-value
     1802               no-error .
     1803             if error-status :error
     1804             or error-status :get-message(1) <> ""
     1805             then do:
     1806               undo move_block, retry move_block .
     1807             end.
     1808           end.
     1809         end.
     1810       end.
     1811       else do:
     1812         for each buf_temp-diasize-handle
     1813         on error undo move_block, retry move_block
     1814         :
     1815           assign
     1816             v-object-handle = buf_temp-diasize-handle.handle-value
     1817           .
     1818           if v-object-handle <> v-diasize-resize-button
     1819           then do:
     1820             assign
     1821               v-object-handle :row = v-object-handle :row + p-change-value
     1822               no-error .
     1823             if error-status :error
     1824             or error-status :get-message(1) <> ""
     1825             then do:
     1826               undo move_block, retry move_block .
     1827             end.
     1828           end.
     1829         end.
     1830         assign
     1831           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1832           no-error .
     1833         if error-status :error
     1834         or error-status :get-message(1) <> ""
     1835         then do:
     1836           undo move_block, retry move_block .
     1837         end.
     1838         for each buf_temp-browse-handle
     1839           where buf_temp-browse-handle.browse-type = 'height':u
     1840         on error undo move_block, retry move_block
     1841         :
     1842           assign
     1843             buf_temp-browse-handle.browse-handle :height
     1844               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1845             no-error .
     1846           if error-status :error
     1847           or error-status :get-message(1) <> ""
     1848           then do:
     1849             undo move_block, retry move_block .
     1850           end.
     1851         end.
     1852         assign
     1853           frame d-shop :height = frame d-shop :height + p-change-value
     1854           no-error .
     1855         if error-status :error
     1856         or error-status :get-message(1) <> ""
     1857         then do:
     1858           undo move_block, retry move_block .
     1859         end.
     1860         if frame d-shop :scrollable = true
     1861         then do:
     1862           assign
     1863             frame d-shop :virtual-height = frame d-shop :virtual-height + p-change-value
     1864             no-error .
     1865           if error-status :error
     1866           or error-status :get-message(1) <> ""
     1867           then do:
     1868             undo move_block, retry move_block .
     1869           end.
     1870         end.
     1871       end.
     1872       if p-move-resize = true
     1873       then do:
     1874         run diasize_position-resize-button in this-procedure .
     1875       end.
     1876       if v-diasize-wndstore = true
     1877       then do:
     1878         if connected("ub") = true
     1879         then do:
     1880           define variable v-cntxt-db-num        as integer   no-undo .
     1881           define variable v-cntxt-userid        as character no-undo .
     1882           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1883                                             , OUTPUT v-cntxt-userid
     1884                                             ) .
     1885           run gbl/wndsizew.p
     1886             (input  v-cntxt-db-num
     1887             ,input  v-cntxt-userid
     1888             ,input  v-diasize-proc-name
     1889             ,input  'height':u
     1890             ,input  string(frame d-shop :height - v-diasize-orig-frame-height)
     1891             ) .
     1892         end.
     1893       end.
     1894     end.
     1895     assign
     1896       v-diasize-change-size = false
     1897     .
     1898   end procedure.
     1899   procedure diasize_set-height :
     1900     define input  parameter p-new-height  as decimal   no-undo .
     1901     define input  parameter p-move-resize as logical   no-undo .
     1902     do
     1903     on error undo, return error return-value
     1904     :
     1905       run diasize_change-height in this-procedure
     1906         (input  (p-new-height - frame d-shop :height)
     1907         ,input  p-move-resize
     1908         ) .
     1909     end.
     1910   end procedure.
     1911   procedure diasize_change-width :
     1912     define input  parameter p-change-value as decimal   no-undo .
     1913     define input  parameter p-move-resize  as logical   no-undo .
     1914     define variable v-field-group-handle   as handle    no-undo .
     1915     define variable v-object-handle        as handle    no-undo .
     1916     define variable v-frame-width          as decimal   no-undo .
     1917     define variable v-frame-virtual-width  as decimal   no-undo .
     1918     define variable v-browse-width         as decimal   no-undo .
     1919     define variable v-window-width         as decimal   no-undo .
     1920     define variable v-window-virtual-width as decimal   no-undo .
     1921     define variable v-change-sign          as integer   no-undo .
     1922     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1923     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1924     if p-change-value > 0
     1925     then do:
     1926       if frame d-shop :width + p-change-value >
     1927           session :width-chars
     1928       then do:
     1929         assign
     1930           p-change-value = session :width-chars - frame d-shop :width
     1931         .
     1932         if p-change-value <= 0
     1933         then do:
     1934           run diasize_position-resize-button in this-procedure .
     1935           return .
     1936         end.
     1937       end.
     1938     end.
     1939     if p-change-value < 0
     1940     then do:
     1941       if frame d-shop :width + p-change-value < v-diasize-orig-frame-width
     1942       then do:
     1943         assign
     1944           p-change-value = v-diasize-orig-frame-width
     1945                          - frame d-shop :width
     1946         .
     1947         if p-change-value >= 0
     1948         then do:
     1949           run diasize_position-resize-button in this-procedure .
     1950           return .
     1951         end.
     1952       end.
     1953     end.
     1954     if p-change-value >= 0
     1955     then do:
     1956       assign
     1957         v-change-sign = 1
     1958       .
     1959     end.
     1960     else do:
     1961       assign
     1962         v-change-sign = -1
     1963       .
     1964     end.
     1965     assign
     1966       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1967     .
     1968     if p-change-value = 0
     1969     then do:
     1970       run diasize_position-resize-button in this-procedure .
     1971       return .
     1972     end.
     1973     move_block:
     1974     do
     1975     on error undo move_block, leave move_block
     1976     :
     1977       if retry
     1978       then do:
     1979         do
     1980         on error undo move_block, leave move_block
     1981         :
     1982           if p-change-value > 0
     1983           then do:
     1984             for each buf_temp-diasize-handle
     1985             on error undo, next
     1986             :
     1987               assign
     1988                 v-object-handle = buf_temp-diasize-handle.handle-value
     1989               .
     1990               if v-object-handle <> v-diasize-resize-button
     1991               then do:
     1992                 assign
     1993                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1994                 .
     1995               end.
     1996             end.
     1997             assign
     1998               v-diasize-browse-handle :width = v-browse-width
     1999             .
     2000             for each buf_temp-browse-handle
     2001               where buf_temp-browse-handle.browse-type = 'width':u
     2002             on error undo, next
     2003             :
     2004               assign
     2005                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2006               .
     2007             end.
     2008             assign
     2009               frame d-shop :width = v-frame-width
     2010             .
     2011             if frame d-shop :scrollable = true
     2012             then do:
     2013               assign
     2014                 frame d-shop :virtual-width = v-frame-virtual-width
     2015               .
     2016             end.
     2017             run diasize_position-resize-button in this-procedure .
     2018           end.
     2019           else do:
     2020             if frame d-shop :scrollable = true
     2021             then do:
     2022               assign
     2023                 frame d-shop :virtual-width = v-frame-virtual-width
     2024               .
     2025             end.
     2026             assign
     2027               frame d-shop :width = v-frame-width
     2028             .
     2029             for each buf_temp-browse-handle
     2030               where buf_temp-browse-handle.browse-type = 'width':u
     2031             on error undo, next
     2032             :
     2033               assign
     2034                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2035               .
     2036             end.
     2037             assign
     2038               v-diasize-browse-handle :width = v-browse-width
     2039             .
     2040             for each buf_temp-diasize-handle
     2041             on error undo, next
     2042             :
     2043               assign
     2044                 v-object-handle = buf_temp-diasize-handle.handle-value
     2045               .
     2046               if v-object-handle <> v-diasize-resize-button
     2047               then do:
     2048                 assign
     2049                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2050                 .
     2051               end.
     2052             end.
     2053             run diasize_position-resize-button in this-procedure .
     2054           end.
     2055           assign
     2056             v-diasize-change-size = false
     2057           .
     2058           leave move_block .
     2059         end.
     2060       end.
     2061       assign
     2062         v-diasize-need-full-display = true
     2063       .
     2064       if v-diasize-change-size = false
     2065       then do:
     2066         assign
     2067           v-diasize-change-size = true
     2068         .
     2069       end.
     2070       else do:
     2071         return .
     2072       end.
     2073       assign
     2074         v-frame-width = frame d-shop :width
     2075         v-frame-virtual-width = frame d-shop :virtual-width
     2076         v-browse-width = v-diasize-browse-handle :width
     2077       .
     2078       for each buf_temp-browse-handle
     2079         where buf_temp-browse-handle.browse-type = 'width':u
     2080       :
     2081         assign
     2082           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2083         .
     2084       end.
     2085       for each buf_temp-diasize-handle
     2086       :
     2087         delete buf_temp-diasize-handle .
     2088       end.
     2089       assign
     2090         v-field-group-handle = frame d-shop :first-child
     2091       .
     2092       do while valid-handle(v-field-group-handle)
     2093       :
     2094         assign
     2095           v-object-handle = v-field-group-handle :first-child
     2096         .
     2097         do while valid-handle(v-object-handle)
     2098         :
     2099           if  v-object-handle <> v-diasize-browse-handle :handle
     2100           and v-object-handle <> v-diasize-resize-button
     2101           and can-query(v-object-handle, "row")
     2102           and can-query(v-object-handle, "height")
     2103           and ( v-object-handle :col + v-object-handle :width
     2104                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2105               )
     2106           then do:
     2107             find first buf_temp-browse-handle
     2108               where buf_temp-browse-handle.browse-type   = 'width':u
     2109                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2110               no-error .
     2111             if available buf_temp-browse-handle
     2112             then do:
     2113             end.
     2114             else do:
     2115               create buf_temp-diasize-handle .
     2116               assign
     2117                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2118                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2119               .
     2120             end.
     2121           end.
     2122           assign
     2123             v-object-handle = v-object-handle :next-sibling
     2124           .
     2125         end.
     2126         assign
     2127           v-field-group-handle = v-field-group-handle :next-sibling
     2128         .
     2129       end.
     2130       do with frame d-shop
     2131       :
     2132         hide v-diasize-resize-button .
     2133         v-diasize-resize-button :row = 1.
     2134         v-diasize-resize-button :column = 1.
     2135       end.
     2136       if p-change-value > 0
     2137       then do:
     2138         if frame d-shop :scrollable = true
     2139         then do:
     2140           assign
     2141             frame d-shop :virtual-width = frame d-shop :virtual-width + p-change-value
     2142             no-error .
     2143           if error-status :error
     2144           or error-status :get-message(1) <> ""
     2145           then do:
     2146             undo move_block, retry move_block.
     2147           end.
     2148         end.
     2149         assign
     2150           frame d-shop :width = v-frame-width + p-change-value
     2151           no-error .
     2152         if error-status :error
     2153         or error-status :get-message(1) <> ""
     2154         then do:
     2155           undo move_block, retry move_block.
     2156         end.
     2157         assign
     2158           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2159         no-error .
     2160         if error-status :error
     2161         or error-status :get-message(1) <> ""
     2162         then do:
     2163           undo move_block, retry move_block.
     2164         end.
     2165         for each buf_temp-browse-handle
     2166           where buf_temp-browse-handle.browse-type = 'width':u
     2167         on error undo move_block, retry move_block
     2168         :
     2169           assign
     2170             buf_temp-browse-handle.browse-handle :width
     2171               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2172             no-error .
     2173           if error-status :error
     2174           or error-status :get-message(1) <> ""
     2175           then do:
     2176             undo move_block, retry move_block .
     2177           end.
     2178         end.
     2179         for each buf_temp-diasize-handle
     2180         on error undo move_block, retry move_block
     2181         :
     2182           assign
     2183             v-object-handle = buf_temp-diasize-handle.handle-value
     2184           .
     2185           if v-object-handle <> v-diasize-resize-button
     2186           then do:
     2187             assign
     2188               v-object-handle :col = v-object-handle :col + p-change-value
     2189               no-error .
     2190             if error-status :error
     2191             or error-status :get-message(1) <> ""
     2192             then do:
     2193               undo move_block, retry move_block .
     2194             end.
     2195           end.
     2196         end.
     2197       end.
     2198       else do:
     2199         for each buf_temp-diasize-handle
     2200         on error undo move_block, retry move_block
     2201         :
     2202           assign
     2203             v-object-handle = buf_temp-diasize-handle.handle-value
     2204           .
     2205           if v-object-handle <> v-diasize-resize-button
     2206           then do:
     2207             assign
     2208               v-object-handle :col = v-object-handle :col + p-change-value
     2209               no-error .
     2210             if error-status :error
     2211             or error-status :get-message(1) <> ""
     2212             then do:
     2213               undo move_block, retry move_block .
     2214             end.
     2215           end.
     2216         end.
     2217         for each buf_temp-browse-handle
     2218           where buf_temp-browse-handle.browse-type = 'width':u
     2219         on error undo move_block, retry move_block
     2220         :
     2221           assign
     2222             buf_temp-browse-handle.browse-handle :width
     2223               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2224             no-error .
     2225           if error-status :error
     2226           or error-status :get-message(1) <> ""
     2227           then do:
     2228             undo move_block, retry move_block .
     2229           end.
     2230         end.
     2231         assign
     2232           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2233           no-error .
     2234         if error-status :error
     2235         or error-status :get-message(1) <> ""
     2236         then do:
     2237           undo move_block, retry move_block.
     2238         end.
     2239         assign
     2240           frame d-shop :width = frame d-shop :width + p-change-value
     2241         no-error .
     2242         if error-status :error
     2243         or error-status :get-message(1) <> ""
     2244         then do:
     2245           undo move_block, retry move_block.
     2246         end.
     2247         if frame d-shop :scrollable = true
     2248         then do:
     2249           assign
     2250             frame d-shop :virtual-width = frame d-shop :virtual-width + p-change-value
     2251           no-error .
     2252           if error-status :error
     2253           or error-status :get-message(1) <> ""
     2254           then do:
     2255             undo move_block, retry move_block.
     2256           end.
     2257         end.
     2258       end.
     2259       if p-move-resize
     2260       then do:
     2261         run diasize_position-resize-button in this-procedure .
     2262       end.
     2263       if v-diasize-wndstore = true
     2264       then do:
     2265         if connected("ub") = true
     2266         then do:
     2267           define variable v-cntxt-db-num        as integer   no-undo .
     2268           define variable v-cntxt-userid        as character no-undo .
     2269           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2270                                             , OUTPUT v-cntxt-userid
     2271                                             ) .
     2272           run gbl/wndsizew.p
     2273             (input  v-cntxt-db-num
     2274             ,input  v-cntxt-userid
     2275             ,input  v-diasize-proc-name
     2276             ,input  'width':u
     2277             ,input  string(frame d-shop :width - v-diasize-orig-frame-width)
     2278             ) .
     2279         end.
     2280       end.
     2281     end.
     2282     assign
     2283       v-diasize-change-size = false
     2284     .
     2285   end procedure.
     2286   procedure diasize_set-width :
     2287     define input  parameter p-new-width  as decimal   no-undo .
     2288     define input  parameter p-move-resize as logical   no-undo .
     2289     do
     2290     on error undo, return error return-value
     2291     :
     2292       run diasize_change-width in this-procedure
     2293         (input  (p-new-width - frame d-shop :width)
     2294         ,input  p-move-resize
     2295         ) .
     2296     end.
     2297   end procedure.
     2298   procedure diasize_position-resize-button :
     2299     do with frame d-shop
     2300     :
     2301       hide v-diasize-resize-button .
     2302       assign
     2303         v-diasize-resize-button :row = frame d-shop :height - v-diasize-resize-button :height
     2304                     - 1
     2305                     - (frame d-shop :border-bottom-pixels / session :pixels-per-row)
     2306         v-diasize-resize-button :col = frame d-shop :width - v-diasize-resize-button :width
     2307                     - 1
     2308                     - (frame d-shop :border-right-pixels / session :pixels-per-column)
     2309       .
     2310       view v-diasize-resize-button .
     2311     end.
     2312   end procedure.
     2313   on alt-right anywhere
     2314   do:
     2315     run diasize_change-width in this-procedure
     2316       (input 1
     2317       ,input true
     2318       ) .
     2319     return no-apply .
     2320   end.
     2321   on alt-left anywhere
     2322   do:
     2323     run diasize_change-width in this-procedure
     2324       (input -1
     2325       ,input true
     2326       ) .
     2327     return no-apply .
     2328   end.
     2329   on alt-down anywhere
     2330   do:
     2331     run diasize_change-height in this-procedure
     2332       (input 1
     2333       ,input true
     2334       ) .
     2335     return no-apply .
     2336   end.
     2337   on alt-up anywhere
     2338   do:
     2339     run diasize_change-height in this-procedure
     2340       (input -1
     2341       ,input true
     2342       ) .
     2343     return no-apply .
     2344   end.
     2345   on alt-enter of frame d-shop
     2346   do:
     2347     run diasize_maximize in this-procedure
     2348       (input  ?
     2349       ).
     2350     return no-apply .
     2351   end.
     2352   procedure diasize_end-move :
     2353     do
     2354     on error undo, return error return-value
     2355     :
     2356       define variable v-row-delta as decimal   no-undo .
     2357       define variable v-col-delta as decimal   no-undo .
     2358       define variable v-new-row as decimal   no-undo .
     2359       define variable v-new-col as decimal   no-undo .
     2360       assign
     2361         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2362         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2363       .
     2364       assign
     2365         v-row-delta = v-new-row - frame d-shop :height
     2366         v-col-delta = v-new-col - frame d-shop :width
     2367       .
     2368       run diasize_change-height in this-procedure
     2369         (input v-row-delta
     2370         ,input true
     2371         ) .
     2372       run diasize_change-width in this-procedure
     2373         (input v-col-delta
     2374         ,input true
     2375         ) .
     2376     end.
     2377   end procedure.
     2378   procedure diasize_maximize :
     2379     define input  parameter p-action as logical   no-undo .
     2380     do
     2381     on error undo, return error return-value
     2382     :
     2383       if p-action = ?
     2384       then do:
     2385         if v-diasize-need-maximize = true
     2386         then do:
     2387           assign
     2388             p-action = true
     2389           .
     2390         end.
     2391         else do:
     2392           assign
     2393             p-action = false
     2394           .
     2395         end.
     2396       end.
     2397       if p-action = true
     2398       then do:
     2399         run diasize_change-height in this-procedure
     2400           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2401               - frame d-shop :height-chars
     2402           ,input true
     2403           ) .
     2404         run diasize_change-width in this-procedure
     2405           (input session :width-chars
     2406               - frame d-shop :width-chars
     2407           ,input true
     2408           ) .
     2409         assign
     2410           v-diasize-need-maximize = false
     2411         .
     2412       end.
     2413       else do:
     2414         run diasize_change-width in this-procedure
     2415           (input v-diasize-orig-frame-width
     2416               - frame d-shop :width-chars
     2417           ,input true
     2418           ) .
     2419         run diasize_change-height in this-procedure
     2420           (input v-diasize-orig-frame-height
     2421               - frame d-shop :height-chars
     2422           ,input true
     2423           ) .
     2424         assign
     2425           v-diasize-need-maximize = true
     2426         .
     2427       end.
     2428     end.
     2429   end procedure.
     2430   procedure diasize_restore-orig-size :
     2431     do
     2432     on error undo, return error return-value
     2433     :
     2434       assign
     2435         v-diasize-current-frame-width  = frame d-shop :width
     2436         v-diasize-current-frame-height = frame d-shop :height
     2437       .
     2438       run diasize_set-height in this-procedure
     2439         (input  v-diasize-orig-frame-height
     2440         ,input  true
     2441         ) .
     2442       run diasize_set-width in this-procedure
     2443         (input  v-diasize-orig-frame-width
     2444         ,input  true
     2445         ) .
     2446     end.
     2447   end procedure.
     2448   procedure diasize_restore-current-size :
     2449     do
     2450     on error undo, return error return-value
     2451     :
     2452       run diasize_set-height in this-procedure
     2453         (input  v-diasize-current-frame-height
     2454         ,input  true
     2455         ) .
     2456       run diasize_set-width in this-procedure
     2457         (input  v-diasize-current-frame-width
     2458         ,input  true
     2459         ) .
     2460     end.
     2461   end procedure.
     2462   procedure diasize_set-browse-handle :
     2463     define input  parameter p-browse-handle as handle   no-undo .
     2464     define buffer buf_temp-browse-handle for temp-browse-handle .
     2465     do
     2466     on error undo, return error return-value
     2467     :
     2468       assign
     2469         v-diasize-browse-handle = p-browse-handle
     2470       .
     2471       for each buf_temp-browse-handle
     2472       on error undo, return error return-value
     2473       :
     2474         delete buf_temp-browse-handle .
     2475       end.
     2476     end.
     2477   end procedure.
     2478   procedure diasize_add_browse :
     2479     define input  parameter p-browse-type   as character no-undo .
     2480     define input  parameter p-browse-handle as handle    no-undo .
     2481     define buffer buf_temp-browse-handle for temp-browse-handle .
     2482     do
     2483     on error undo, return error return-value
     2484     :
     2485       assign
     2486         v-diasize-browse-number = v-diasize-browse-number + 1
     2487       .
     2488       create buf_temp-browse-handle .
     2489       assign
     2490         buf_temp-browse-handle.browse-type   = p-browse-type
     2491         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2492         buf_temp-browse-handle.browse-handle = p-browse-handle
     2493       .
     2494     end.
     2495   end procedure.
     2496   procedure diasize_init :
     2497     define variable v-default-value    as logical   no-undo .
     2498     define variable v-restore-saved    as logical   no-undo .
     2499     define variable v-resize-value-str as character no-undo .
     2500     do
     2501     on error undo, return error return-value
     2502     :
     2503       do with frame d-shop
     2504       :
     2505         assign
     2506           v-diasize-orig-frame-height = frame d-shop :height
     2507           v-diasize-orig-frame-width  = frame d-shop :width
     2508           v-diasize-browse-handle     = browse br-shops :handle
     2509         .
     2510         create button v-diasize-resize-button
     2511         assign
     2512           parent        = frame d-shop :first-child
     2513           label         = "s"
     2514           height-pixels = 16
     2515           width-pixels  = 16
     2516           visible       = true
     2517           sensitive     = true
     2518           movable       = true
     2519           triggers:
     2520             on end-move persistent run diasize_end-move in this-procedure .
     2521           end triggers.
     2522         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2523         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2524         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2525         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2526         assign
     2527           v-diasize-wndmax = false
     2528         .
     2529         if connected("ub") = true
     2530         then do:
     2531           define variable v-cntxt-db-num        as integer   no-undo .
     2532           define variable v-cntxt-userid        as character no-undo .
     2533           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2534                                             , OUTPUT v-cntxt-userid
     2535                                             ) .
     2536           run gbl/wndpar_r.p
     2537             (input  v-cntxt-db-num
     2538             ,input  v-cntxt-userid
     2539             ,input  'wndmax':U
     2540             ,output v-diasize-wndmax
     2541             ,output v-default-value
     2542             ) .
     2543         end.
     2544         assign
     2545           v-diasize-wndstore = false
     2546         .
     2547         if connected("ub") = true
     2548         then do:
     2549           run gbl/wndpar_r.p
     2550             (input  v-cntxt-db-num
     2551             ,input  v-cntxt-userid
     2552             ,input  'wndstore':U
     2553             ,output v-diasize-wndstore
     2554             ,output v-default-value
     2555             ) .
     2556         end.
     2557         assign
     2558           v-diasize-proc-name = entry(1, program-name(2), '.')
     2559         .
     2560         if v-diasize-wndstore = true
     2561         then do:
     2562           assign
     2563             v-restore-saved = false
     2564           .
     2565           if connected("ub") = true
     2566           then do:
     2567             run gbl/wndsizer.p
     2568               (input  v-cntxt-db-num
     2569               ,input  v-cntxt-userid
     2570               ,input  v-diasize-proc-name
     2571               ,input  'height':u
     2572               ,output v-resize-value-str
     2573               ) .
     2574             if v-resize-value-str <> '':U
     2575             then do:
     2576               run diasize_change-height in this-procedure
     2577                 (input  integer(v-resize-value-str)
     2578                 ,input  true
     2579                 ) .
     2580               assign
     2581                 v-restore-saved = true
     2582               .
     2583             end.
     2584           end.
     2585           if connected("ub") = true
     2586           then do:
     2587             run gbl/wndsizer.p
     2588               (input  v-cntxt-db-num
     2589               ,input  v-cntxt-userid
     2590               ,input  v-diasize-proc-name
     2591               ,input  'width':u
     2592               ,output v-resize-value-str
     2593               ) .
     2594             if v-resize-value-str <> '':U
     2595             then do:
     2596               run diasize_change-width in this-procedure
     2597                 (input  integer(v-resize-value-str)
     2598                 ,input  true
     2599                 ) .
     2600               assign
     2601                 v-restore-saved = true
     2602               .
     2603             end.
     2604           end.
     2605           if v-restore-saved <> true
     2606           then do:
     2607             if v-diasize-wndmax = true
     2608             then do:
     2609               run diasize_maximize in this-procedure
     2610                 (input  true
     2611                 ) .
     2612             end.
     2613           end.
     2614         end.
     2615         else do:
     2616           if v-diasize-wndmax = true
     2617           then do:
     2618             run diasize_maximize in this-procedure
     2619               (input  true
     2620               ) .
     2621           end.
     2622         end.
     2623       end.
     2624     end.
     2625   end procedure.
     2626   procedure diasize_need-full-display :
     2627     define output parameter p-need-full-display as logical   no-undo .
     2628     do
     2629     on error undo, return error return-value
     2630     :
     2631       assign
     2632         p-need-full-display = v-diasize-need-full-display
     2633       .
     2634       assign
     2635         v-diasize-need-full-display = false
     2636       .
     2637     end.
     2638   end procedure.
     2639   procedure get-context :
     2640      define output parameter p-db-num as integer          no-undo.
     2641      define output parameter p-user-id as character        no-undo.
     2642      define variable v-login               as character    no-undo.
     2643      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2644      define buffer buf_user-login  for ub.user-login .
     2645      do
     2646      on error undo, return error
     2647      :
     2648            FIND FIRST buf_sys-ctrl no-lock.
     2649            ASSIGN
     2650               v-login = USERID("ub")
     2651               p-db-num = buf_sys-ctrl.db-num
     2652            .
     2653            FIND FIRST buf_user-login
     2654                 WHERE buf_user-login.db-num = p-db-num
     2655                   AND buf_user-login.user-login = v-login
     2656                 no-lock
     2657                 no-error
     2658                 .
     2659            IF AVAILABLE buf_user-login
     2660            THEN DO:
     2661               assign
     2662                  p-user-id = buf_user-login.user-id
     2663               .
     2664            END.
     2665      end.
     2666   end procedure.
     2667       run diasize_init in this-procedure .
     2668   ON CHOOSE OF B-hist IN FRAME d-shop
