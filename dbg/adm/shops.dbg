     3073     return no-apply.
     3074   end.
     3075   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3076   on CTRL-P, CTRL-З of frame d-shop anywhere do:
     3077     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame d-shop. END.
     3078     return no-apply.
     3079   end.
     3080   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3081   on f5 of frame d-shop anywhere
     3082   do:
     3083      v-doc-rec = recid(X_shop).    run OpenBR in this-procedure.   REPOSITION br-shops to recid v-doc-rec No-ERROR.   apply 'value-changed' to br-shops.
     3084   end.
     3085   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3086   do:
     3087     br-shops :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     3088   end.
     3089   MAIN-BLOCK:
     3090   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3091      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3092    if lookup('s-deploy', bttns) > 0 then do:
     3093     assign
     3094     v-is-deploy = yes.
     3095    end.
     3096   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3097     run mainmenu_getcntxt in parparentproc
     3098       (output v-cntxt-db-num
     3099       ,output v-cntxt-userid
     3100       ,output v-cntxt-level
     3101       ,output v-cntxt-host-code-obj
     3102       ,output v-cntxt-obj-type
     3103       ,output v-cntxt-obj-code
     3104       ,output v-cntxt-db-num-obj
     3105       ,output v-cntxt-is-admin
     3106       ) .
     3107     v-exist-price-grp = false  .
     3108     RUN enable_UI.
     3109     WAIT-FOR GO OF FRAME d-shop.
     3110   END.
     3111   RUN disable_UI.
     3112   PROCEDURE disable_UI :
     3113     HIDE FRAME d-shop.
     3114   END PROCEDURE.
     3115   PROCEDURE enable_UI :
     3116   v-grp:VISIBLE IN BROWSe br-shops = v-exist-price-grp .
     3117   ASSIGN
     3118   B-attr:POPUP-MENU IN FRAME d-shop       = MENU MENU-B-attr:HANDLE
     3119   b-attr:MENU-MOUSE in frame d-shop = 1
     3120   B-cli-attr:POPUP-MENU IN FRAME d-shop       = MENU MENU-B-cli-attr:HANDLE
     3121   b-cli-attr:MENU-MOUSE in frame d-shop = 1
     3122   X_clients.obj-name:resizable  in browse br-shops = true
     3123   X_cli-host.obj-name:resizable in browse br-shops = true
     3124   X_clients.grp-name:resizable  in browse br-shops = true
     3125   v-grp:resizable  in browse br-shops = true
     3126   .
     3127   hide mark-num in frame d-shop.
     3128   v-rid-list = p-rid-list.
     3129   ENABLE
     3130   br-shops
     3131   b-quit
     3132   b-lkp
     3133   b-print when not v-is-deploy
     3134   b-rights
     3135   b-help
     3136   b-price
     3137   b-add WHEN v-cntxt-db-num = 0 and can-do (bttns, "b-add")
     3138   b-chg WHEN v-cntxt-db-num = 0 and can-do (bttns, "b-add")
     3139   b-del WHEN v-cntxt-db-num = 0 and can-do (bttns, "b-add")
     3140   b-grp WHEN v-cntxt-db-num = 0 and can-do (bttns, "b-add")
     3141   b-mark when can-do (bttns, "b-mark")
     3142   b-sel when can-do (bttns, "b-sel")
     3143   b-dis-rule when not v-is-deploy
     3144   b-hist when not v-is-deploy
     3145   b-attr when not v-is-deploy
     3146   b-cli-attr when not v-is-deploy
     3147   sch-code
     3148   WITH FRAME d-shop .
     3149   run openbr in this-procedure .
     3150   if v-rid-list <> '':U then do:
     3151     reposition br-shops to recid(integer(entry(1, v-rid-list))) no-error.
     3152     apply "ENTRY" to br-shops.
     3153     apply "VALUE-CHANGED" to br-shops.
     3154   end.
     3155   END PROCEDURE.
     3156   procedure openbr :
     3157     if p-only-cur-db-num  = yes then do:
     3158       OPEN QUERY br-shops
     3159       FOR EACH X_shop NO-LOCK,
     3160       EACH X_clients WHERE
     3161            X_clients.obj-code = X_shop.obj-code
     3162        and X_clients.obj-type = 'маг':U
     3163        and X_clients.db-num   = v-cntxt-db-num NO-LOCK,
     3164        each X_cli-host where
     3165             X_cli-host.obj-code = X_shop.host-code
     3166        and X_cli-host.obj-type = 'орг':U no-lock
     3167       BY X_shop.obj-code.
     3168     end.
     3169     else do:
     3170       OPEN QUERY br-shops
     3171       FOR EACH X_shop NO-LOCK,
     3172       EACH X_clients WHERE
     3173            X_clients.obj-code = X_shop.obj-code
     3174        and X_clients.obj-type = 'маг':U NO-LOCK,
     3175        each X_cli-host where
     3176             X_cli-host.obj-code = X_shop.host-code
     3177        and X_cli-host.obj-type = 'орг':U no-lock
     3178       BY X_shop.obj-code.
     3179     end.
     3180   end procedure.
