     2708   ON CHOOSE OF b-attr IN FRAME d-shop
     2709   DO:
     2710   define variable v-param as character no-undo .
     2711   define variable v-db-num like ub.db.db-num no-undo .
     2712   if not available X_shop then return no-apply.
     2713   if attr-option = '':U then do:
     2714      run gbl/pop-up.p ( input self:handle, input no) no-error.
     2715   end.
     2716   if attr-option = '':U then return no-apply.
     2717   if attr-option = 'ИЗМЕНЕНИЕ':U
     2718   or attr-option = 'КОПИРОВАНИЕ':U
     2719   then do:
     2720     if v-cntxt-db-num <> 0
     2721     then do:
     2722   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2723   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2724     (input  'маг':U
     2725     ,input  X_shop.obj-code
     2726     ,output v-db-num
     2727     )  .
     2728       if v-db-num <> v-cntxt-db-num then do:
     2729         message
     2730         "Нельзя менять ПАРАМЕТРЫ в чужой УБД"
     2731         view-as alert-box error .
     2732         return no-apply.
     2733       end.
     2734     end.
     2735   end.
     2736   run proc-b-attr in this-procedure (
     2737                                       input attr-option
     2738                                      ,input 'маг':U
     2739                                      ,input X_shop.obj-code) no-error .
     2740   if error-status:error then do:
     2741     assign
     2742     attr-option = "":u.
     2743     return no-apply.
     2744   end.
     2745   attr-option = "":u.
     2746   END.
     2747   ON CHOOSE OF b-cli-attr IN FRAME d-shop
     2748   DO:
     2749    define variable v-updated as logical no-undo .
     2750    define variable v-is-error as logical no-undo .
     2751    define variable v-db-num as integer no-undo .
     2752    define variable ri as recid no-undo .
     2753     if not available X_shop then do:
     2754       return no-apply.
     2755     end.
     2756     ri = recid(X_shop).
     2757     if cli-attr-option = "":U then do:
     2758       run gbl/pop-up.p ( input self :handle, input no ) no-error.
     2759       if error-status :error then do: return no-apply. end.
     2760     end.
     2761     if cli-attr-option = "":U then do:
     2762         return no-apply.
     2763     end.
     2764     if cli-attr-option = 'ИЗМЕНЕНИЕ':U
     2765     or cli-attr-option = 'КОПИРОВАНИЕ':U then do:
     2766       if v-cntxt-db-num > 0 then do:
     2767   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2768   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2769     (input  'маг':U
     2770     ,input  X_shop.obj-code
     2771     ,output v-db-num
     2772     )  .
     2773         if v-db-num <> v-cntxt-db-num then do:
     2774           message
     2775           "Нельзя менять АТРИБУТЫ в чужой УБД"
     2776           view-as alert-box error .
     2777           return no-apply.
     2778         end.
     2779       end.
     2780     end.
     2781     run ref/ca-attrr.p (
     2782                       input parparentproc
     2783                      ,input (if lookup("b-add", bttns) > 0
     2784                             AND cli-attr-option = 'ИЗМЕНЕНИЕ':U
     2785                             then 'ИЗМЕНЕНИЕ':U
     2786                             else 'ПРОСМОТР':U)
     2787                      ,input 'маг':U
     2788                      ,input X_shop.obj-code
     2789                      ,input yes
     2790                      ,output v-updated
     2791                      ,output v-is-error
     2792                      ) no-error.
     2793     if error-status:error
     2794     or v-is-error then do:
     2795       message
     2796       "Ошибка при вызове списка атрибутов клиента" skip
     2797       error-status:get-message(1) skip
     2798       return-value
     2799       view-as alert-box .
     2800       assign
     2801       cli-attr-option = "":U
     2802       .
     2803       undo, return no-apply.
     2804     end.
     2805     cli-attr-option = "":U.
     2806   END.
