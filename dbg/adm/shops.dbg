     2867   ON CHOOSE OF b-sel IN FRAME d-shop
     2868   DO:
     2869     define variable v-ind         as integer   no-undo .
     2870     define variable v-num-entries as integer   no-undo .
     2871     define buffer buf_shop    for ub.shop .
     2872     define buffer buf_clients for ub.clients .
     2873     if v-rid-list = "":U
     2874     or b-mark:sensitive = no
     2875     then do:
     2876       v-rid-list = string (recid (X_shop)).
     2877     end.
     2878     assign
     2879       v-num-entries = num-entries( v-rid-list )
     2880     .
     2881     do v-ind = 1 to v-num-entries
     2882     :
     2883       find first buf_shop no-lock
     2884         where recid( buf_shop ) = integer( entry( v-ind, v-rid-list ) )
     2885       .
     2886       find first buf_clients no-lock
     2887         where buf_clients.obj-type = 'маг':U
     2888           and buf_clients.obj-code = buf_shop.obj-code
     2889         no-error
     2890       .
     2891       if available buf_clients
     2892         and buf_clients.stts <> 0
     2893       then do:
     2894         entry(v-ind, v-rid-list) = '':U.
     2895         v-rid-list  = replace(v-rid-list, chr(44) + chr(44), chr(44)).
     2896         message substitute( "Магазин &1 удален и не может быть выбран.", buf_shop.obj-code ).
     2897         return no-apply.
     2898       end.
     2899     end.
     2900   END.
     2901   on go of frame d-shop do:
     2902     p-rid-list = v-rid-list.
     2903   end.
     2904   ON CHOOSE OF b-rights IN FRAME d-shop
     2905   DO:
     2906     if available X_shop then do:
     2907       run adm/obj-usr.w
     2908         (input  parparentproc
     2909         ,input  v-cntxt-db-num
     2910         ,input  'маг':U
     2911         ,input  X_shop.obj-code
     2912         ).
     2913     end.
     2914   END.
     2915   on return, MOUSE-SELECT-DBLCLICK of br-shops in frame d-shop do:
     2916     if b-sel:sensitive then
     2917       if b-mark:sensitive then apply "choose" to b-mark in frame d-shop.
     2918       else apply "choose" to b-sel in frame d-shop.
     2919     else if b-chg:sensitive then apply "choose" to b-chg in frame d-shop.
     2920   end.
     2921   on choose of b-mark in frame d-shop do:
     2922   define variable glog as logical no-undo .
     2923     if available X_clients then do:
     2924       if X_clients.stts <> 0 then do:
     2925         message "Данный объект удален и не может быть выбран."
     2926         view-as alert-box
     2927         .
     2928         return no-apply.
     2929       end.
     2930     end.
     2931     else return no-apply.
     2932   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2933   define variable v-str-recid15 as character no-undo .
     2934   define variable v-num-entry15 as integer   no-undo .
     2935   assign
     2936     v-str-recid15 = trim( string( recid( X_shop ) , "->>>>>>>>>>>9":U ) )
     2937     v-num-entry15 = lookup( v-str-recid15 , v-rid-list )
     2938   .
     2939   if v-num-entry15 > 0 then do:
     2940     assign
     2941       entry( v-num-entry15, v-rid-list ) = "":U
     2942       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     2943     .
     2944   end.
     2945   else do:
     2946     assign
     2947       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid15
     2948     .
     2949   end.
     2950     glog = br-shops:refresh() in frame d-shop.
     2951     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     2952       glog = br-shops:select-next-row ().
     2953       apply "iteration-changed" to br-shops in frame d-shop.
     2954     end.
     2955     if num-entries (v-rid-list) = 0 then hide mark-num in frame d-shop.
     2956     else
     2957     display
     2958     num-entries (v-rid-list) @ mark-num with frame d-shop.
     2959     apply "entry" to br-shops in frame d-shop.
     2960   end.
     2961   ON RETURN OF sch-code IN FRAME d-shop
     2962   DO:
     2963   define buffer buf_shop for ub.shop.
     2964   assign
     2965   sch-code.
     2966     find first buf_shop no-lock where
     2967               buf_shop.obj-code = sch-code no-error .
     2968     if available buf_shop then do:
     2969       reposition br-shops to recid recid(buf_shop) no-error .
     2970       apply "ENTRY" to br-shops.
     2971     end.
     2972   END.
     2973   ON CHOOSE OF B-grp IN FRAME d-shop
     2974   DO:
     2975   define variable lns-cnt as integer no-undo .
     2976   define variable g-grp as character no-undo .
     2977   define variable v-gds-rec as recid no-undo.
     2978   define variable ri as recid no-undo .
     2979   define variable glog as logical no-undo .
     2980   define buffer buf_clients for ub.clients.
     2981   define buffer buf_cli-grp for ub.cli-grp.
     2982   define buffer buf_shop for ub.shop.
     2983   if not available X_clients then return no-apply.
     2984   ri = recid(X_shop).
     2985   glog = yes.
     2986   message
     2987   "Выберите группу, в которую нужно" skip
     2988   "переместить магазин(-ы)."
     2989   view-as alert-box question buttons OK-Cancel update glog.
     2990   if not glog then   do:
     2991     apply "entry" to br-shops in frame d-shop.
     2992     return no-apply.
     2993   end.
     2994   g-grp = "".
     2995   run ref/cli-grps.w (
     2996                      input parparentproc
     2997                    , input 'терм':U + ",b-sel"
     2998                    , input-output g-grp ) .
     2999   if g-grp = "" then  do:
     3000     apply "ENTRY" to br-shops.
     3001     return no-apply.
     3002   end.
     3003   else do transaction:
     3004       FIND buf_cli-grp where recid( buf_cli-grp ) = integer( g-grp ) .
     3005       if v-rid-list = "" then
     3006       v-rid-list = string( recid( X_shop) ) .
     3007       lns-cnt = 1.
     3008       DO WHILE lns-cnt <= num-entries( v-rid-list ) :
     3009         v-gds-rec = integer( entry( lns-cnt, v-rid-list ) ) .
     3010         if lns-cnt = 1 then ri = v-gds-rec.
     3011         for each buf_shop share-lock where recid(buf_shop) = v-gds-rec,
     3012                 first buf_clients where
     3013                     buf_clients.obj-type = 'маг':U
     3014                 and buf_clients.obj-code = buf_shop.obj-code
     3015         on error  undo , next
     3016         on stop   undo , next
     3017         on endkey undo , next
     3018         :
     3019           buf_clients.grp-code = buf_cli-grp.node-code.
     3020           lns-cnt = lns-cnt + 1.
     3021         end.
     3022       END .
     3023       if lns-cnt < num-entries(v-rid-list) + 1 then do:
     3024         message
     3025         substitute("Удалось сменить группу для &1 магазинов", lns-cnt - 1)
     3026         view-as alert-box error.
     3027       end.
     3028       v-rid-list = "".
     3029       mark-num = 0.
     3030       hide mark-num in frame d-shop.
     3031   end.
     3032   run Openbr in this-procedure .
     3033   reposition br-shops to recid ri no-error.
     3034   apply "ENTRY" to br-shops.
     3035   apply "value-changed" to br-shops.
     3036   END.
     3037   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-shop:PARENT eq ?
     3038   THEN FRAME d-shop:PARENT = ACTIVE-WINDOW.
     3039   ON WINDOW-CLOSE OF FRAME d-shop APPLY "END-ERROR":U TO SELF.
     3040   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
