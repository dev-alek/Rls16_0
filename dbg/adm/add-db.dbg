      328   function pascur returns handle ():
      329   define buffer  Buf_user for  _user.
      330    find first gPasSysAdm no-error.
      331    if not available gPasSysAdm then crpas().
      332    define variable vReturn as handle no-undo.
      333    find first Buf_user
      334              where Buf_user._userid    = mloginsysadm
      335              no-error
      336              .
      337      if available Buf_user
      338      then do:
      339          block-pas:
      340          for each gPasSysAdm where gPasSysAdm.fLogin eq mloginsysadm no-lock:
      341             if Buf_user._password eq encode(gpasSysadm.pasw)
      342             then
      343                leave block-pas.
      344          end.
      345      end.
      346      release Buf_user.
      347      if not available gPasSysAdm
      348      then
      349         find last gPasSysAdm where gPasSysAdm.fLogin eq mloginsysadm.
      350      vReturn = buffer gPasSysAdm:handle.
      351      return vReturn.
      352   end.
      353   function pasNew returns handle ():
      354      define buffer  sys-ctrl for ub.sys-ctrl.
      355      define buffer  upgrade for ub.upgrade.
      356      define buffer  upgrade-attr for ub.upgrade-attr.
      357      find first gPasSysAdm where gPasSysAdm.fLogin eq mloginsysadm no-error.
      358      if not available gPasSysAdm then crpas().
      359      define variable vReturn as handle no-undo.
      360      find first sys-ctrl no-lock .
      361      block-upg:
      362      for each  upgrade  where upgrade.db-num = sys-ctrl.db-num
      363      no-lock
      364       by upgrade.db-num descending by upgrade.step-num descending
      365          :
      366        leave block-upg.
      367      end.
      368      find first upgrade-attr no-lock where
      369                 upgrade-attr.db-num      = upgrade.db-num and
      370                 upgrade-attr.version-num = upgrade.version-num and
      371                 upgrade-attr.attr-code   = "releace" no-error .
      372      find first  gPasSysAdm where gPasSysAdm.fLogin eq mloginsysadm and
      373                                   gPasSysAdm.num eq integer (upgrade-attr.attr-value) no-lock no-error.
      374      release sys-ctrl.
      375      release upgrade.
      376      release upgrade-attr.
      377      if not available gPasSysAdm
      378      then
      379         find last gPasSysAdm where gPasSysAdm.fLogin eq mloginsysadm.
      380      vReturn = buffer gPasSysAdm:handle.
      381      return vReturn.
      382   end.
      383   define buffer buf_sys-ctrl for ub.sys-ctrl .
      384   DEFINE BUTTON b-exit AUTO-GO
      385        LABEL "&Ввод":L
      386        SIZE 10 BY 1.
      387   DEFINE BUTTON b-help
      388        LABEL "Помо&щь":L
      389        SIZE 10 BY 1.
      390   DEFINE BUTTON b-quit AUTO-END-KEY
      391        LABEL "&Отмена":L
      392        SIZE 10 BY 1.
      393   DEFINE VARIABLE v-db-dst AS CHARACTER FORMAT "X(256)":U
      394        LABEL "Целевая БД"
      395        VIEW-AS FILL-IN
      396        SIZE 30.88 BY 1 NO-UNDO.
      397   DEFINE VARIABLE v-db-src AS CHARACTER FORMAT "X(256)":U
      398        LABEL "Исходная БД"
      399        VIEW-AS FILL-IN
      400        SIZE 30.88 BY 1 NO-UNDO.
      401   DEFINE VARIABLE v-sel-src-db AS CHARACTER
      402        VIEW-AS RADIO-SET VERTICAL
      403        RADIO-BUTTONS
      404             "Выгрузка online", "unload-online":U,
      405   "Выгрузка из копии БД", "unload-copy":U
      406        SIZE 24.13 BY 1.83 NO-UNDO.
      407   DEFINE RECTANGLE RECT-1
      408        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      409        SIZE 47 BY 5.
      410   DEFINE RECTANGLE RECT-2
      411        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      412        SIZE 47 BY 3.13.
      413   DEFINE FRAME d-add-db
      414        b-exit AT ROW 1.17 COL 2
      415        b-quit AT ROW 1.17 COL 12
      416        b-help AT ROW 1.17 COL 39
      417        v-sel-src-db AT ROW 3.92 COL 4.25 NO-LABEL
      418        v-db-src AT ROW 6 COL 14.5 COLON-ALIGNED
      419        v-db-dst AT ROW 9 COL 14.5 COLON-ALIGNED
      420        RECT-2 AT ROW 7.42 COL 2
      421        "Целевая база данных" VIEW-AS TEXT
      422             SIZE 21.38 BY .75 AT ROW 7.63 COL 3
      423        "База данных источник" VIEW-AS TEXT
      424             SIZE 21.38 BY .75 AT ROW 2.63 COL 3
      425        RECT-1 AT ROW 2.42 COL 2
      426        SPACE(0.99) SKIP(3.49)
      427       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      428            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      429            TITLE "Введите параметры подсоединения к БД":L
      430            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit.
      431   ASSIGN
      432          FRAME d-add-db:SCROLLABLE       = FALSE.
      433   ON CHOOSE OF b-exit IN FRAME d-add-db
      434   DO:
      435     define buffer buf_user-login      for ub.user-login .
      436     define variable v-user-pswd-enc as character no-undo .
      437     define variable v-create-adm    as logical      no-undo.
      438     assign
      439       v-db-src
      440       v-db-dst
      441       v-sel-src-db
      442     .
      443     run adm/unloaddc.p no-error .
      444     if error-status :error then do:
      445       message
      446         vss-workfile vss-revision vss-description skip
      447         substitute( "Не удалось отключить БД" ) skip
      448         return-value skip
      449         error-status :get-message ( error-status :num-messages )
      450         view-as alert-box error
      451       .
      452       return no-apply .
      453     end.
      454     case v-sel-src-db :
      455       when 'unload-online':U then do:
      456         create alias src for database ub no-error.
      457         if error-status :error then do:
      458           message
      459             vss-workfile vss-revision vss-description skip
      460             substitute( "Ошибка при создании вымышленного имени src" ) skip
      461             error-status :get-message ( error-status :num-messages )
      462             view-as alert-box error
      463           .
      464           return no-apply.
      465         end.
      466       end.
      467       when 'unload-copy':U then do:
      468         if v-db-src = "":U then do:
      469           message
      470             vss-workfile vss-revision vss-description skip
      471             substitute( "Нeобходимо указать параметры соединения с исходной ГБД!" ) skip
      472             view-as alert-box error
      473           .
      474           apply "entry":U to v-db-src in frame d-add-db .
      475           return no-apply.
      476         end.
      477         run adm/pswd-enc.p (input encode(g#passwd), output v-user-pswd-enc) no-error.
      478         if error-status:error then do:
      479           message
      480             vss-workfile vss-revision vss-description skip
      481             substitute( "Ошибка кодировки." ) skip
      482             error-status :get-message ( error-status :num-messages ) skip
      483             return-value
      484             view-as alert-box error
      485           .
      486           return no-apply.
      487         end.
      488         connect value( v-db-src ) -ld src -U value( g#userid ) -P value( v-user-pswd-enc ) no-error.
      489         if not connected ("src":U) then do:
      490           connect value( v-db-src ) -ld src -U odbc - P odbc no-error.
      491           if not connected ("src":U) then do:
      492             message
      493               vss-workfile vss-revision vss-description skip
      494               substitute( "Не могу соединиться с исходной ГБД!" ) skip
      495               error-status :get-message ( error-status :num-messages )
      496               view-as alert-box error
      497             .
      498             apply "entry":U to v-db-src in frame d-add-db .
      499             return no-apply.
      500           end.
      501           else do:
      502             disconnect src.
      503             message
      504               vss-workfile vss-revision vss-description skip
      505               substitute( "Не могу соединиться с исходной ГБД!" ) skip
      506               substitute( "В исходной ГБД нет пользователя &1 или", g#userid ) skip
      507               substitute( "он имеет пароль отличный от пароля в копии ГБД" ) skip
      508               view-as alert-box error
      509             .
      510             return no-apply.
      511           end.
      512         end.
      513   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      514   create alias db-orig for database 'src':U no-error.
      515   create alias db-copy for database 'ub':U no-error.
      516   if pdbname( 'src':U ) = pdbname( 'ub':U )
      517     or pdbname( 'ub':U ) = "ub":U
      518   then do:
      519     delete alias db-orig .
      520     delete alias db-copy .
      521     message
      522       vss-workfile vss-revision vss-description skip
      523       substitute( "Копии БД должна иметь ФИЗИЧЕСКОЕ ИМЯ отличное от имени исходной БД и от ub." ) skip
      524       substitute( "Физическое имя исходной БД: &1", pdbname( 'src':U ) ) skip
      525       substitute( "Физическое имя копии БД: &1", pdbname( 'ub':U ) ) skip
      526       view-as alert-box error
      527     .
      528     return no-apply.
      529   end.
      530   run adm/chk-c-db.p ( input 'check':U
      531                  ,input p-db-num
      532                 ) no-error .
      533   if error-status :error then do:
      534     delete alias db-orig .
      535     delete alias db-copy .
      536     message
      537       vss-workfile vss-revision vss-description skip
      538       substitute( "Ошибка при проверке корректности и подготовке копии БД." ) skip
      539       error-status :get-message ( error-status :num-messages ) skip
      540       return-value
      541       view-as alert-box error
      542     .
      543     return no-apply.
      544   end.
      545   delete alias db-orig .
      546   delete alias db-copy .
      547       end.
      548     end case.
      549     if v-db-dst = "":U then do:
      550       message
      551         vss-workfile vss-revision vss-description skip
      552         substitute( "Нeобходимо указать параметры соединения с целевой базой!" ) skip
      553         view-as alert-box error
      554       .
      555       apply "entry" to v-db-dst in frame d-add-db .
      556       return no-apply.
      557     end.
      558     FIND FIRST buf_user-login
      559          WHERE buf_user-login.db-num     = p-db-num
      560            AND buf_user-login.user-login = "адм"
      561            and buf_user-login.status_    = 0
      562          no-lock
      563          no-error
      564          .
      565     IF NOT AVAILABLE buf_user-login
      566     THEN DO:
      567        ASSIGN
      568           v-create-adm = TRUE
      569        .
      570     END.
      571     define variable vConect as character no-undo.
      572     vConect = SUBSTITUTE("&1 -ld dst -U sysadm -P &2", v-db-dst,"sysadm") .
      573     connect value(vConect) no-error.
      574     if not connected ("dst") then do:
      575       message
      576         vss-workfile vss-revision vss-description skip
      577         substitute( "Не могу соединиться с проинициированой целевой базой!" ) skip
      578         error-status :get-message ( error-status :num-messages )
      579         view-as alert-box error
      580       .
      581       apply "entry" to v-db-dst in frame d-add-db .
      582       return no-apply.
      583     end.
      584     run adm/init-db.p
      585       ( input p-db-num
      586        ,input "dst":U
      587        ,input buf_sys-ctrl.language
      588        ,input buf_sys-ctrl.r-b
      589        ,input buf_sys-ctrl.sys-key
      590        ,input no
      591        ,input v-create-adm
      592        ,input 0
      593       ) no-error.
      594     if error-status:error then do:
      595       message
      596         vss-workfile vss-revision vss-description skip
      597         substitute( "Ошибка при инициализации целевой базой!" ) skip
      598         return-value skip
      599         error-status :get-message ( error-status :num-messages )
      600         view-as alert-box error
      601       .
      602       return no-apply.
      603     end.
      604     assign
      605       p-type-unload = v-sel-src-db
      606     .
      607   END.
      608   ON CHOOSE OF b-quit IN FRAME d-add-db
      609   DO:
      610     assign
      611       p-type-unload = ?
      612     .
      613   END.
      614   ON VALUE-CHANGED OF v-sel-src-db IN FRAME d-add-db
      615   DO:
      616     assign
      617       v-sel-src-db
      618     .
      619     disable v-db-src with frame d-add-db.
      620     case v-sel-src-db :
      621       when 'unload-online':U then do:
      622       end.
      623       when 'unload-copy':U then do:
      624         enable v-db-src with frame d-add-db.
      625       end.
      626       otherwise do:
      627         message
      628           vss-workfile vss-revision vss-description skip
      629           substitute( 'Отсутствует обработка выгрузки "&1"', v-sel-src-db:screen-value ) skip
      630           view-as alert-box error
      631         .
      632         return no-apply.
      633       end.
      634     end case.
      635   END.
      636   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-add-db:PARENT eq ?
      637   THEN FRAME d-add-db:PARENT = ACTIVE-WINDOW.
      638   ON WINDOW-CLOSE OF FRAME d-add-db APPLY "END-ERROR":U TO SELF.
      639   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      640   on help of frame d-add-db
      641   do:
      642     run gbl/app_help.p
      643       (input this-procedure :file-name
      644       ,input ''
      645       ,input ?
      646       ) no-error.
      647     if error-status :error then do:
      648       message
      649         "Ошибка при вызове помощи"
      650         error-status :get-message(1)
      651         view-as alert-box .
      652     end.
      653   end.
      654   run minbtn-set in this-procedure .
      655   on choose of b-help in frame d-add-db
      656   do:
      657     apply "help":u to frame d-add-db .
      658   end.
      659   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      660   procedure minbtn-set :
      661       do
      662           on error undo, return error return-value
      663           :
      664           define variable ii              as integer       no-undo .
      665           define variable fh              as widget-handle no-undo .
      666           define variable hh              as widget-handle no-undo .
      667           define variable v-h             as handle        extent 4 no-undo .
      668           define variable v-name-button   as character     no-undo .
      669           define variable v-help-old-x    as decimal       no-undo .
      670           define variable v-help-old-y    as decimal       no-undo .
      671           define variable v-help-old-size as decimal       no-undo .
      672           define variable v-frame-width   as decimal       no-undo .
      673           define variable jj              as integer       no-undo .
      674           do
      675               on error undo, return error
      676               :
      677               assign
      678                   v-frame-width = frame d-add-db:width - 0.3
      679                   fh            = frame d-add-db:first-child
      680                   hh            = fh:first-child
      681                   ii            = 1
      682                   .
      683               do while valid-handle(hh):
      684                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      685                   do:
      686                       case lc(hh:name) :
      687                           when "b-help" then
      688                               do:
      689                                   hh:load-image-up("cmp/b-help.bmp":u) .
      690                                   hh:load-image-down("cmp/b-help.bmp":u) .
      691                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      692                                   hh:TOOLTIP = "Помощь" .
      693                                   v-help-old-x = hh:column .
      694                                   v-help-old-y = hh:row    .
      695                                   v-help-old-size = hh:width .
      696                                   hh:width-chars = 2.5 .
      697                               end.
      698                           when "b-print" then
      699                               do:
      700                                   hh:load-image("cmp/b-print.bmp":u) .
      701                                   hh:TOOLTIP = "Печать" .
      702                                   v-h[ii] = hh:handle .
      703                                   ii = ii + 1 .
      704                                   hh:width-chars = 3 .
      705                               end.
      706                           when "b-history" or
      707                           when "b-hist" then
      708                               do:
      709                                   hh:load-image("cmp/b-hist.bmp":u) .
      710                                   hh:TOOLTIP = "История" .
      711                                   v-h[ii] = hh:handle .
      712                                   ii = ii + 1 .
      713                                   hh:width-chars = 3 .
      714                               end.
      715                           when "b-sch" then
      716                               do:
      717                                   hh:load-image("cmp/b-sch.bmp":u) .
      718                                   hh:TOOLTIP = "Установка Фильтра" .
      719                                   v-h[ii] = hh:handle .
      720                                   ii = ii + 1 .
      721                                   hh:width-chars = 3 .
      722                               end.
      723                           when "b-hist-user" then
      724                               do:
      725                                   hh:load-image("cmp/b-hist.bmp":u) .
      726                                   hh:TOOLTIP = "История пользователя" .
      727                                   ii = ii + 1 .
      728                               end.
      729                       end case.
      730                   end.
      731                   hh = hh:next-sibling.
      732               end.
      733               b-help:column = v-frame-width - b-help:width-chars.
      734               jj = 0.
      735               repeat ii = 4 to 1 by -1 :
      736                   if valid-handle (v-h[ii] ) then
      737                   do:
      738                       jj  = jj + 1 .
      739                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      740                       v-h[ii]:row    = v-help-old-y .
      741                   end.
      742               end.
      743           end.
      744       end.
      745   end procedure.
      746   MAIN-BLOCK:
      747   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      748      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      749      ON STOP       UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      750     define variable v-log as logical no-undo .
      751     session:data-entry-return = yes .
      752     find first buf_sys-ctrl no-lock .
      753     assign
      754       p-type-unload = ?
      755     .
      756     RUN enable_UI.
      757     if buf_sys-ctrl.status_ = 'copy-DB':U then do:
      758       assign
      759         v-sel-src-db = 'unload-copy':U
      760         v-log = v-sel-src-db:disable( "Выгрузка online" )
      761       .
      762     end.
      763     else do:
      764       assign
      765         v-sel-src-db = 'unload-online':U
      766         v-log = v-sel-src-db:disable( "Выгрузка из копии БД" )
      767       .
      768     end.
      769     display v-sel-src-db with frame d-add-db .
      770     apply "value-changed" to v-sel-src-db in frame d-add-db .
      771     WAIT-FOR GO OF FRAME d-add-db.
      772   END.
      773   RUN disable_UI.
      774   session:data-entry-return = no .
      775   PROCEDURE disable_UI :
      776     HIDE FRAME d-add-db.
      777   END PROCEDURE.
      778   PROCEDURE enable_UI :
      779     DISPLAY v-sel-src-db v-db-src v-db-dst
      780         WITH FRAME d-add-db.
      781     ENABLE RECT-2 RECT-1 b-exit b-quit b-help v-sel-src-db v-db-src v-db-dst
      782         WITH FRAME d-add-db.
      783   END PROCEDURE.
