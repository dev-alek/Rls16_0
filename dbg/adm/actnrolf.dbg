        1   define input-output parameter p-name        as character no-undo .
        2   define input-output parameter p-name-2      as character no-undo .
        3   define output       parameter p-ok          as logical no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Запрос строки для поиска и фильтрации в правах по объекту или фирме".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   DEFINE BUTTON b-clear AUTO-GO
      116        LABEL "Очистить"
      117        SIZE 10 BY 1.
      118   DEFINE BUTTON B-exit AUTO-GO
      119        LABEL "Ввод"
      120        SIZE 10 BY 1
      121        BGCOLOR 8 .
      122   DEFINE BUTTON b-help
      123        LABEL "Помо&щь"
      124        SIZE 10 BY 1
      125        BGCOLOR 8 .
      126   DEFINE BUTTON b-quit AUTO-END-KEY
      127        LABEL "Отмена"
      128        SIZE 10 BY 1
      129        BGCOLOR 8 .
      130   DEFINE VARIABLE v-name AS CHARACTER FORMAT "X(40)":U
      131        LABEL "В группах"
      132        VIEW-AS FILL-IN
      133        SIZE 53 BY 1 NO-UNDO.
      134   DEFINE VARIABLE v-name-2 AS CHARACTER FORMAT "X(256)":U
      135        LABEL "В правах"
      136        VIEW-AS FILL-IN
      137        SIZE 53 BY 1 NO-UNDO.
      138   DEFINE FRAME Dialog-Frame
      139        B-exit AT ROW 1 COL 1
      140        b-quit AT ROW 1 COL 11
      141        b-clear AT ROW 1 COL 21 WIDGET-ID 6
      142        b-help AT ROW 1 COL 57.5
      143        v-name AT ROW 2.5 COL 11.5 COLON-ALIGNED WIDGET-ID 2
      144        v-name-2 AT ROW 3.75 COL 11.5 COLON-ALIGNED WIDGET-ID 8
      145        SPACE(0.99) SKIP(0.24)
      146       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      147            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      148            TITLE "Поиск в правах (в названиях и описаниях прав и групп прав)"
      149            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit WIDGET-ID 100.
      150   ASSIGN
      151          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      152          FRAME Dialog-Frame:HIDDEN           = TRUE.
      153   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      154   DO:
      155     APPLY "END-ERROR":U TO SELF.
      156   END.
      157   ON CHOOSE OF b-clear IN FRAME Dialog-Frame
      158   DO:
      159     assign
      160       p-name = ""
      161       p-name-2 = ""
      162       p-ok = TRUE
      163     .
      164   END.
      165   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      166   DO:
      167     assign
      168       v-name
      169       v-name-2
      170     .
      171     assign
      172       p-name   = v-name
      173       p-name-2 = v-name-2
      174       p-ok = TRUE
      175     .
      176   END.
      177   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      178   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      179   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      180   on help of frame Dialog-Frame
      181   do:
      182     run gbl/app_help.p
      183       (input this-procedure :file-name
      184       ,input ''
      185       ,input ?
      186       ) no-error.
      187     if error-status :error then do:
      188       message
      189         "Ошибка при вызове помощи"
      190         error-status :get-message(1)
      191         view-as alert-box .
      192     end.
      193   end.
      194   run minbtn-set in this-procedure .
      195   on choose of b-help in frame Dialog-Frame
      196   do:
      197     apply "help":u to frame Dialog-Frame .
      198   end.
      199   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      200   procedure minbtn-set :
      201       do
      202           on error undo, return error return-value
      203           :
      204           define variable ii              as integer       no-undo .
      205           define variable fh              as widget-handle no-undo .
      206           define variable hh              as widget-handle no-undo .
      207           define variable v-h             as handle        extent 4 no-undo .
      208           define variable v-name-button   as character     no-undo .
      209           define variable v-help-old-x    as decimal       no-undo .
      210           define variable v-help-old-y    as decimal       no-undo .
      211           define variable v-help-old-size as decimal       no-undo .
      212           define variable v-frame-width   as decimal       no-undo .
      213           define variable jj              as integer       no-undo .
      214           do
      215               on error undo, return error
      216               :
      217               assign
      218                   v-frame-width = frame Dialog-Frame:width - 0.3
      219                   fh            = frame Dialog-Frame:first-child
      220                   hh            = fh:first-child
      221                   ii            = 1
      222                   .
      223               do while valid-handle(hh):
      224                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      225                   do:
      226                       case lc(hh:name) :
      227                           when "b-help" then
      228                               do:
      229                                   hh:load-image-up("cmp/b-help.bmp":u) .
      230                                   hh:load-image-down("cmp/b-help.bmp":u) .
      231                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      232                                   hh:TOOLTIP = "Помощь" .
      233                                   v-help-old-x = hh:column .
      234                                   v-help-old-y = hh:row    .
      235                                   v-help-old-size = hh:width .
      236                                   hh:width-chars = 2.5 .
      237                               end.
      238                           when "b-print" then
      239                               do:
      240                                   hh:load-image("cmp/b-print.bmp":u) .
      241                                   hh:TOOLTIP = "Печать" .
      242                                   v-h[ii] = hh:handle .
      243                                   ii = ii + 1 .
      244                                   hh:width-chars = 3 .
      245                               end.
      246                           when "b-history" or
      247                           when "b-hist" then
      248                               do:
      249                                   hh:load-image("cmp/b-hist.bmp":u) .
      250                                   hh:TOOLTIP = "История" .
      251                                   v-h[ii] = hh:handle .
      252                                   ii = ii + 1 .
      253                                   hh:width-chars = 3 .
      254                               end.
      255                           when "b-sch" then
      256                               do:
      257                                   hh:load-image("cmp/b-sch.bmp":u) .
      258                                   hh:TOOLTIP = "Установка Фильтра" .
      259                                   v-h[ii] = hh:handle .
      260                                   ii = ii + 1 .
      261                                   hh:width-chars = 3 .
      262                               end.
      263                           when "b-hist-user" then
      264                               do:
      265                                   hh:load-image("cmp/b-hist.bmp":u) .
      266                                   hh:TOOLTIP = "История пользователя" .
      267                                   ii = ii + 1 .
      268                               end.
      269                       end case.
      270                   end.
      271                   hh = hh:next-sibling.
      272               end.
      273               b-help:column = v-frame-width - b-help:width-chars.
      274               jj = 0.
      275               repeat ii = 4 to 1 by -1 :
      276                   if valid-handle (v-h[ii] ) then
      277                   do:
      278                       jj  = jj + 1 .
      279                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      280                       v-h[ii]:row    = v-help-old-y .
      281                   end.
      282               end.
      283           end.
      284       end.
      285   end procedure.
      286   MAIN-BLOCK:
      287   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      288      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      289     assign
      290       v-name = p-name
      291       v-name-2 = p-name-2
      292     .
      293     RUN enable_UI.
      294     WAIT-FOR GO OF FRAME Dialog-Frame FOCUS v-name.
      295   END.
      296   RUN disable_UI.
      297   PROCEDURE disable_UI :
      298     HIDE FRAME Dialog-Frame.
      299   END PROCEDURE.
      300   PROCEDURE enable_UI :
      301     DISPLAY v-name v-name-2
      302         WITH FRAME Dialog-Frame.
      303     ENABLE B-exit b-quit b-clear b-help v-name v-name-2
      304         WITH FRAME Dialog-Frame.
      305     VIEW FRAME Dialog-Frame.
      306   END PROCEDURE.
