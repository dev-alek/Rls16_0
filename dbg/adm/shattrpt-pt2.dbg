     1509   DEFINE VARIABLE parparentproc AS WIDGET-HANDLE       NO-UNDO.
     1510   DEFINE VARIABLE p-mode        AS CHARACTER           NO-UNDO.
     1511   DEFINE VARIABLE p-obj-type  LIKE ub.clients.obj-type NO-UNDO.
     1512   DEFINE VARIABLE p-obj-code  LIKE ub.shop.obj-code    NO-UNDO.
     1513   RUN set-attribute-list (
     1514       'Keys-Accepted = "",
     1515        Keys-Supplied = ""':U).
     1516   DEFINE VARIABLE qr-scan-time AS INTEGER FORMAT ">>>>>9":U INITIAL 5000
     1517        LABEL "Время на сканирование QR-кода (мс)"
     1518        VIEW-AS FILL-IN
     1519        SIZE 9 BY 1 NO-UNDO.
     1520   DEFINE VARIABLE rvs-wt-email AS CHARACTER FORMAT "X(256)":U
     1521        VIEW-AS FILL-IN
     1522        SIZE 90 BY .92 NO-UNDO.
     1523   DEFINE VARIABLE t-autopump-skip-time AS INTEGER FORMAT "->,>>>,>>9" INITIAL 0
     1524        LABEL "Время после приема НП (мин)"
     1525        VIEW-AS FILL-IN
     1526        SIZE 5 BY 1 NO-UNDO.
     1527   DEFINE VARIABLE timeout-block-nozzle AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 5
     1528        VIEW-AS FILL-IN
     1529        SIZE 7.5 BY 1 NO-UNDO.
     1530   DEFINE RECTANGLE RECT-8
     1531        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1532        SIZE 118.5 BY 27.25.
     1533   DEFINE VARIABLE t-autopump AS LOGICAL INITIAL no
     1534        LABEL "Автоматические сверки создавать с чтением всех счетчиков ТРК"
     1535        VIEW-AS TOGGLE-BOX
     1536        SIZE 82.5 BY .83 NO-UNDO.
     1537   DEFINE VARIABLE t-autopump-izm AS LOGICAL INITIAL no
     1538        LABEL "Автоматические сверки создавать только по измеряемым резервуарам"
     1539        VIEW-AS TOGGLE-BOX
     1540        SIZE 82.5 BY .83 NO-UNDO.
     1541   DEFINE VARIABLE t-avtinvpm AS LOGICAL INITIAL no
     1542        LABEL "Автомат. создание инв. счетчиков ТРК при переполнении разрядности эл. счетчика"
     1543        VIEW-AS TOGGLE-BOX
     1544        SIZE 82.5 BY .83 TOOLTIP "если включено, то контроль и создание происходит при закрытии сверки" NO-UNDO.
     1545   DEFINE VARIABLE t-block-nozzle AS LOGICAL INITIAL yes
     1546        LABEL "Отправлять блокировку пистолетов при приемке"
     1547        VIEW-AS TOGGLE-BOX
     1548        SIZE 47.5 BY .83 NO-UNDO.
     1549   DEFINE VARIABLE t-olddens AS LOGICAL INITIAL no
     1550        LABEL "В документы по умолчанию ставится плотность и темп. из предыдущего документа"
     1551        VIEW-AS TOGGLE-BOX
     1552        SIZE 81.5 BY .83 NO-UNDO.
     1553   DEFINE VARIABLE t-rvd-own-nb AS LOGICAL INITIAL no
     1554        LABEL "Разрешить ручное заполнение документа приёма НП при поставках с собственных НБ"
     1555        VIEW-AS TOGGLE-BOX
     1556        SIZE 83 BY .83 NO-UNDO.
     1557   DEFINE VARIABLE t-trnscanqr AS LOGICAL INITIAL no
     1558        LABEL "Автозаполнение НП"
     1559        VIEW-AS TOGGLE-BOX
     1560        SIZE 30 BY .83 NO-UNDO.
     1561   DEFINE FRAME F-Main
     1562        t-autopump-izm AT ROW 1.25 COL 2.5 WIDGET-ID 40
     1563        t-autopump AT ROW 2 COL 2.5 WIDGET-ID 542
     1564        t-avtinvpm AT ROW 2.75 COL 2.5 WIDGET-ID 42
     1565        t-olddens AT ROW 3.5 COL 2.5 WIDGET-ID 76
     1566        t-trnscanqr AT ROW 4.25 COL 2.5 WIDGET-ID 128
     1567        t-rvd-own-nb AT ROW 5 COL 2.5 WIDGET-ID 544
     1568        qr-scan-time AT ROW 6 COL 37 COLON-ALIGNED WIDGET-ID 546
     1569        t-autopump-skip-time AT ROW 6 COL 79 COLON-ALIGNED WIDGET-ID 250
     1570        t-block-nozzle AT ROW 7 COL 3 WIDGET-ID 600
     1571        timeout-block-nozzle AT ROW 8 COL 3 NO-LABEL WIDGET-ID 604
     1572        rvs-wt-email AT ROW 11 COL 3 NO-LABEL WIDGET-ID 90
     1573        "на список почтовых адресов(разделять адреса запятыми):" VIEW-AS TEXT
     1574             SIZE 62.5 BY .96 AT ROW 10.04 COL 3 WIDGET-ID 94
     1575        "При приеме новостей, если в сверке вода, отправлять сообщения" VIEW-AS TEXT
     1576             SIZE 64.5 BY .96 AT ROW 9.25 COL 3 WIDGET-ID 92
     1577        "Timeout ожидания подтверждения блокировки пистолетов, с" VIEW-AS TEXT
     1578             SIZE 57.5 BY .67 AT ROW 8.25 COL 11.5 WIDGET-ID 606
     1579        RECT-8 AT ROW 1 COL 1 WIDGET-ID 608
     1580       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1581            SIDE-LABELS NO-UNDERLINE THREE-D
     1582            AT COL 1 ROW 1 SCROLLABLE .
     1583   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1584   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1585   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1586   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1587   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1588   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1589   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1590   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1591         adm-object-hdl = FRAME F-Main:HANDLE.
     1592   RUN ensure-broker.
     1593   THIS-PROCEDURE:ADM-DATA =
     1594        'ADM1.1~`':U +
     1595        'SmartObject~`':U +
     1596        '~`':U +
     1597        'NO ~`':U +
     1598        '~`':U +
     1599        '~`':U +
     1600        '~`':U +
     1601        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1602           + "~`":U +
     1603        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1604        'Record-Source,Record-Target,TableIO-Target~`':U +
     1605        '~`':U +
     1606        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1607        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1608            THEN "^^":U
     1609        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1610             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1611   PROCEDURE adm-apply-entry :
     1612     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1613   END PROCEDURE.
     1614   PROCEDURE adm-destroy :
     1615    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1616   END PROCEDURE.
     1617   PROCEDURE adm-disable :
     1618       DISABLE RECT-8 t-autopump-izm t-autopump t-avtinvpm t-olddens t-trnscanqr t-rvd-own-nb qr-scan-time t-autopump-skip-time t-block-nozzle timeout-block-nozzle rvs-wt-email WITH FRAME F-Main.
     1619       RUN dispatch ('disable-fields':U).
     1620       RUN set-attribute-list ('ENABLED=no':U).
     1621       RETURN.
     1622   END PROCEDURE.
     1623   PROCEDURE adm-edit-attribute-list :
     1624         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1625         RETURN.
     1626   END PROCEDURE.
     1627   PROCEDURE adm-enable :
     1628       ENABLE UNLESS-HIDDEN RECT-8 t-autopump-izm t-autopump t-avtinvpm t-olddens t-trnscanqr t-rvd-own-nb qr-scan-time t-autopump-skip-time t-block-nozzle timeout-block-nozzle rvs-wt-email WITH FRAME F-Main.
     1629       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1630       RUN set-attribute-list ('ENABLED=yes':U).
     1631       RETURN.
     1632   END PROCEDURE.
     1633   PROCEDURE adm-exit :
     1634        RUN notify ('exit':U).
     1635     RETURN.
     1636   END PROCEDURE.
     1637   PROCEDURE adm-hide :
     1638     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1639   END PROCEDURE.
     1640   PROCEDURE adm-initialize :
     1641     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1642   END PROCEDURE.
     1643   PROCEDURE adm-show-errors :
     1644       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1645       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1646           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1647       END.
     1648       RETURN.
     1649   END PROCEDURE.
     1650   PROCEDURE adm-UIB-mode :
     1651     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1652   END PROCEDURE.
     1653   PROCEDURE adm-view :
     1654     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1655   END PROCEDURE.
     1656   PROCEDURE dispatch :
     1657       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1658       RUN broker-dispatch IN adm-broker-hdl
     1659           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1660       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1661   END PROCEDURE.
     1662   PROCEDURE ensure-broker :
     1663   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1664   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1665   DO:
     1666       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1667       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1668   END.
     1669   END PROCEDURE.
     1670   PROCEDURE get-attribute :
     1671     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1672     RUN broker-get-attribute IN adm-broker-hdl
     1673         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1674     RETURN RETURN-VALUE.
     1675   END PROCEDURE.
     1676   PROCEDURE get-attribute-list :
     1677     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1678     RUN broker-get-attribute-list IN adm-broker-hdl
     1679         (INPUT THIS-PROCEDURE,
     1680          INPUT ?,
     1681          OUTPUT p-attr-list) NO-ERROR.
     1682     RETURN.
     1683   END PROCEDURE.
     1684   PROCEDURE new-state :
     1685     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1686     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1687     RETURN.
     1688   END PROCEDURE.
     1689   PROCEDURE notify :
     1690     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1691     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1692     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1693         RETURN "ADM-ERROR":U.
     1694     RETURN.
     1695   END PROCEDURE.
     1696   PROCEDURE set-attribute-list :
     1697     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1698     RUN ensure-broker.
     1699     RUN broker-set-attribute-list IN adm-broker-hdl
     1700         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1701     RETURN.
     1702   END PROCEDURE.
     1703   PROCEDURE set-position :
     1704       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1705       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1706       IF VALID-HANDLE(adm-object-hdl) THEN
     1707       DO:
     1708         ASSIGN adm-object-hdl:ROW    =   p-row
     1709                adm-object-hdl:COLUMN =   p-col.
     1710       END.
     1711       RETURN.
     1712   END PROCEDURE.
     1713   PROCEDURE adm-display-fields :
     1714       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1715       RETURN.
     1716   END PROCEDURE.
     1717   PROCEDURE adm-open-query :
     1718     RETURN.
     1719   END PROCEDURE.
     1720   PROCEDURE adm-row-changed :
     1721         IF VALID-HANDLE(adm-object-hdl) THEN
     1722           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1723         RUN notify ('row-available':U).
     1724         RETURN.
     1725   END PROCEDURE.
     1726   PROCEDURE reposition-query :
     1727       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1728       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1729       RETURN.
     1730   END PROCEDURE.
     1731     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1732     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1733     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1734     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1735     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1736     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1737     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1738     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1739     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1740     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1741     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1742     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1743     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1744     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1745     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1746     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1747     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1748     IF "":U = "":U THEN
     1749       RUN modify-list-attribute IN adm-broker-hdl
     1750         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1751     RUN use-create-on-add(?).
     1752   PROCEDURE adm-add-record :
     1753       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1754          "must have at least one Enabled Table to perform Add.":U
     1755          VIEW-AS ALERT-BOX ERROR.
     1756       RETURN.
     1757   END PROCEDURE.
     1758   PROCEDURE adm-assign-record :
     1759    MESSAGE
     1760          "Object ":U THIS-PROCEDURE:FILE-NAME
     1761            "must have at least one Enabled Table to perform Assign.":U
     1762              VIEW-AS ALERT-BOX ERROR.
     1763      RETURN.
     1764     END PROCEDURE.
     1765   PROCEDURE adm-assign-statement :
     1766     RETURN.
     1767   END PROCEDURE.
     1768   PROCEDURE adm-cancel-record :
     1769      RETURN.
     1770     END PROCEDURE.
     1771   PROCEDURE adm-copy-record :
     1772       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1773        "must have at least one Enabled Table to perform Copy.":U
     1774          VIEW-AS ALERT-BOX ERROR.
     1775       RETURN.
     1776   END PROCEDURE.
     1777   PROCEDURE adm-create-record :
     1778      RETURN.
     1779   END PROCEDURE.
     1780   PROCEDURE adm-current-changed :
     1781     RETURN.
     1782   END PROCEDURE.
     1783   PROCEDURE adm-delete-record :
     1784    MESSAGE
     1785          "Object ":U THIS-PROCEDURE:FILE-NAME
     1786            "must have at least one Enabled Table to perform Delete.":U
     1787              VIEW-AS ALERT-BOX ERROR.
     1788       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1789       RETURN.
     1790   END PROCEDURE.
     1791   PROCEDURE adm-disable-fields :
     1792         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1793       RETURN.
     1794   END PROCEDURE.
     1795   PROCEDURE adm-enable-fields :
     1796       RETURN.
     1797   END PROCEDURE.
     1798   PROCEDURE adm-end-update :
     1799     RETURN.
     1800   END PROCEDURE.
     1801   PROCEDURE adm-reset-record :
     1802       RETURN.
     1803   END PROCEDURE.
     1804   PROCEDURE adm-update-record :
     1805       MESSAGE
     1806         "Object ":U THIS-PROCEDURE:FILE-NAME
     1807           "must have at least one Enabled Table to perform Update.":U
     1808             VIEW-AS ALERT-BOX ERROR.
     1809      RETURN.
     1810   END PROCEDURE.
     1811   PROCEDURE check-modified :
     1812   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1813   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1814   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1815   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1816     IF check-state = "check":U THEN
     1817     DO:
     1818       RUN get-link-handle IN adm-broker-hdl
     1819         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1820            OUTPUT group-target-list).
     1821       IF group-target-list NE "":U THEN
     1822       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1823         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1824         RUN check-modified IN curr-widget ('group-check':U).
     1825         IF RETURN-VALUE NE "":U THEN
     1826         DO:
     1827           RUN check-modified-message(RETURN-VALUE).
     1828           RETURN "":U.
     1829         END.
     1830       END.
     1831     END.
     1832     RETURN "":U.
     1833   END PROCEDURE.
     1834   PROCEDURE check-modified-message :
     1835     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1836        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1837           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1838        IF RETURN-VALUE = "YES":U THEN
     1839           RUN notify ('view,CONTAINER-SOURCE':U).
     1840        MESSAGE IF p-changed-table NE ? THEN
     1841           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1842           ELSE "Current values have been changed."
     1843           SKIP "  Do you wish to save those changes?"
     1844           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1845        IF ANS THEN
     1846        DO:
     1847           IF group-assign-target THEN
     1848             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1849           ELSE RUN dispatch('update-record':U).
     1850           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1851           DO:
     1852               MESSAGE "Changes to the previous record were not saved."
     1853                 VIEW-AS ALERT-BOX ERROR.
     1854               IF group-assign-target THEN
     1855                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1856               ELSE RUN dispatch ('cancel-record':U).
     1857           END.
     1858        END.
     1859        ELSE DO:
     1860          IF group-assign-target THEN
     1861             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1862          ELSE RUN dispatch('cancel-record':U).
     1863        END.
     1864        RETURN.
     1865   END PROCEDURE.
     1866   PROCEDURE get-rowid :
     1867       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1868       ASSIGN
     1869       p-table   =   adm-first-table.
     1870       RETURN.
     1871   END PROCEDURE.
     1872   PROCEDURE init-group-assign :
     1873       RUN request-attribute IN adm-broker-hdl
     1874         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1875       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1876         group-assign-target = yes.
     1877       ELSE group-assign-target = no.
     1878       RETURN.
     1879   END PROCEDURE.
     1880   PROCEDURE set-editors :
     1881       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1882       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1883       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1884       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1885       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1886       DO WHILE VALID-HANDLE (curr-widget):
     1887           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1888              curr-widget:HIDDEN = no THEN DO:
     1889             CASE p-field-setting:
     1890               WHEN "INITIALIZE":U THEN
     1891               DO:
     1892                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1893                     read-only-list +
     1894                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1895                        STRING(curr-widget).
     1896               END.
     1897               WHEN "DISABLE":U OR
     1898               WHEN "ENABLE":U THEN
     1899               DO:
     1900                   curr-widget:SENSITIVE = yes.
     1901                   RUN get-attribute ('Read-Only-Editors':U).
     1902                   IF RETURN-VALUE = ? OR
     1903                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1904                       curr-widget:READ-ONLY =
     1905                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1906               END.
     1907               WHEN "CLEAR":U THEN
     1908                   curr-widget:SCREEN-VALUE = "":U.
     1909             END CASE.
     1910           END.
     1911           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1912       END.
     1913       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1914         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1915           + '"':U).
     1916       RETURN.
     1917   END PROCEDURE.
     1918   PROCEDURE use-check-modified-all :
     1919    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1920     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1921     RETURN.
     1922   END PROCEDURE.
     1923   PROCEDURE use-create-on-add :
     1924   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1925      RETURN.
     1926   END PROCEDURE.
     1927   PROCEDURE use-initial-lock :
     1928     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1929     ASSIGN adm-initial-lock = p-attr-value.
     1930     RETURN.
     1931   END PROCEDURE.
     1932     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1933   ASSIGN
     1934          FRAME F-Main:SCROLLABLE       = FALSE
     1935          FRAME F-Main:HIDDEN           = TRUE.
     1936   ASSIGN
     1937          RECT-8:HIDDEN IN FRAME F-Main           = TRUE.
     1938   ON VALUE-CHANGED OF t-block-nozzle IN FRAME F-Main
     1939   DO:
     1940     assign t-block-nozzle .
     1941   END.
     1942   ON LEAVE OF timeout-block-nozzle IN FRAME F-Main
     1943   DO:
     1944     assign timeout-block-nozzle .
     1945   END.
     1946   if not this-procedure :persistent
     1947   then do:
     1948     message
     1949       vss-workfile vss-revision vss-description skip
     1950       "Ошибка при запуске процедуры" skip
     1951       "Данную процедуру следует запускать только с параметром persistent" skip
     1952       view-as alert-box error .
     1953     undo, return error .
     1954   end.
     1955   PROCEDURE adm-row-available :
     1956     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1957     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1958     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1959     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1960     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1961     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1962     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1963     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1964     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1965     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1966     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1967     IF adm-updating-record THEN RETURN.
     1968     RUN get-attribute ('FIELDS-ENABLED':U).
     1969     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1970     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1971         OUTPUT link-handle) NO-ERROR.
     1972     IF link-handle = "":U THEN
     1973         RETURN.
     1974     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1975     IF NUM-ENTRIES(link-handle) > 1 THEN
     1976         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1977             "encountered more than one RECORD-SOURCE.":U SKIP
     1978             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1979                VIEW-AS ALERT-BOX ERROR.
     1980     RUN get-attribute ('Key-Name':U).
     1981     key-name = RETURN-VALUE.
     1982     IF key-name = "":U THEN key-name = ?.
     1983     IF key-name NE ? THEN DO:
     1984       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1985         NO-ERROR.
     1986       IF key-value NE ? THEN
     1987         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1988     END.
     1989   IF VALID-HANDLE (adm-object-hdl) THEN
     1990       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1991   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1992     if p-mode = 'ПРОСМОТР':U then do:
     1993         run disable-all IN THIS-PROCEDURE.
     1994     end.
     1995   END PROCEDURE.
     1996   PROCEDURE disable_UI :
     1997     HIDE FRAME F-Main.
     1998     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1999   END PROCEDURE.
     2000   PROCEDURE disable-all :
     2001       disable
     2002         all
     2003         with frame F-Main .
     2004   END PROCEDURE.
     2005   PROCEDURE PartTwo-Init :
     2006     DEFINE INPUT PARAMETER iParparentproc AS WIDGET-HANDLE       NO-UNDO.
     2007     DEFINE INPUT PARAMETER iMode          AS CHARACTER           NO-UNDO.
     2008     DEFINE INPUT PARAMETER iObjtype       LIKE ub.clients.obj-type NO-UNDO.
     2009     DEFINE INPUT PARAMETER iObjcode       LIKE ub.shop.obj-code    NO-UNDO.
     2010     DEFINE INPUT PARAMETER TABLE FOR temp-thbj-attr.
     2011     define variable v-entry           as character  no-undo .
     2012     assign
     2013        parparentproc = iParparentproc
     2014        p-mode        = iMode
     2015        p-obj-type    = iObjtype
     2016        p-obj-code    = iObjcode
     2017        .
     2018     for each temp-thbj-attr no-lock
     2019           :
     2020       assign
     2021         v-entry = temp-thbj-attr.prop-code
     2022       .
     2023       case v-entry:
     2024         when 'autopump':U then do:
     2025           assign
     2026             t-autopump = temp-thbj-attr.property-value-logical
     2027             t-autopump :private-data in frame F-Main = "recid=" + string(recid(temp-thbj-attr))
     2028           .
     2029         end.
     2030           when 'autopump-izm':U then do:
     2031             assign t-autopump-izm =  temp-thbj-attr.property-value-logical
     2032                    t-autopump-izm :private-data in frame F-Main = "recid=" + string(recid(temp-thbj-attr))
     2033           .
     2034             end.
     2035         when 'autopump-skip-time':U then do:
     2036             assign t-autopump-skip-time =  temp-thbj-attr.property-value-integer
     2037                t-autopump-skip-time :private-data in frame F-Main = "recid=" + string(recid(temp-thbj-attr))
     2038           .
     2039         end.
     2040         when 'avtinvpm':U then do:
     2041           assign
     2042             t-avtinvpm = temp-thbj-attr.property-value-logical
     2043             t-avtinvpm :private-data in frame F-Main = "recid=" + string(recid(temp-thbj-attr))
     2044           .
     2045         end.
     2046         when 'olddens':U then do:
     2047           assign
     2048             t-olddens = temp-thbj-attr.property-value-logical
     2049             t-olddens :private-data in frame F-Main = "recid=" + string(recid(temp-thbj-attr))
     2050           .
     2051         end.
     2052         when 'rvs-wt-email':U then do:
     2053           assign
     2054             rvs-wt-email = temp-thbj-attr.property-value-character
     2055             rvs-wt-email :private-data in frame F-Main = "recid=" + string(recid(temp-thbj-attr))
     2056           .
     2057         end.
     2058         when 'block-nozzle':U then
     2059             do:
     2060               assign
     2061                 t-block-nozzle = temp-thbj-attr.property-value-logical
     2062                 t-block-nozzle :private-data in frame F-Main = "recid=" + string(recid(temp-thbj-attr))
     2063               .
     2064             end.
     2065         when 'timeout-block-nozzle':U then
     2066             do:
     2067               assign
     2068                 timeout-block-nozzle = temp-thbj-attr.property-value-integer
     2069                 timeout-block-nozzle :private-data in frame F-Main = "recid=" + string(recid(temp-thbj-attr))
     2070               .
     2071             end.
     2072           when 'rvd-own-nb':U then
     2073             do:
     2074               assign
     2075                 t-rvd-own-nb = temp-thbj-attr.property-value-logical
     2076                 t-rvd-own-nb :private-data in frame F-Main = "recid=" + string(recid(temp-thbj-attr))
     2077               .
     2078             end.
     2079           when 'qr-scan-time':U then
     2080             do:
     2081               assign
     2082                 qr-scan-time = temp-thbj-attr.property-value-integer
     2083                 qr-scan-time :private-data in frame F-Main = "recid=" + string(recid(temp-thbj-attr))
     2084               .
     2085           end.
     2086           when 'trnscanqr':U then
     2087             do:
     2088               assign
     2089                 t-trnscanqr = temp-thbj-attr.property-value-logical
     2090                 t-trnscanqr :private-data in frame F-Main = "recid=" + string(recid(temp-thbj-attr))
     2091               .
     2092             end.
     2093           otherwise do:
     2094               delete temp-thbj-attr.
     2095           end.
     2096       end case.
     2097     end.
     2098     DISPLAY t-autopump-izm t-autopump t-avtinvpm t-olddens t-trnscanqr t-rvd-own-nb qr-scan-time t-autopump-skip-time t-block-nozzle timeout-block-nozzle rvs-wt-email
     2099         WITH FRAME F-Main.
     2100   END PROCEDURE.
     2101   PROCEDURE send-records :
     2102   END PROCEDURE.
     2103   PROCEDURE state-changed :
     2104     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     2105     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     2106     CASE p-state:
     2107       WHEN 'update-begin':U THEN DO:
     2108           RUN dispatch('enable-fields':U).
     2109           IF RETURN-VALUE = "ADM-ERROR":U THEN
     2110           DO:
     2111             RUN new-state('update-failed,TABLEIO-SOURCE':U).
     2112             RUN new-state('update-complete':U).
     2113           END.
     2114           ELSE RUN new-state ('update':U).
     2115       END.
     2116       WHEN 'update-complete':U THEN DO:
     2117           RUN new-state ('update-complete':U).
     2118       END.
     2119     END CASE.
     2120   END PROCEDURE.
     2121   PROCEDURE PartTwo-Get :
     2122      DEFINE INPUT-OUTPUT PARAMETER TABLE FOR temp-thbj-attr append.
     2123      define variable wh                as widget-handle  no-undo .
     2124      define variable fh                as widget-handle  no-undo .
     2125      define buffer buf_clients for ub.clients .
     2126      ASSIGN FRAME F-Main t-autopump-izm t-autopump t-avtinvpm t-olddens t-trnscanqr t-rvd-own-nb qr-scan-time t-autopump-skip-time t-block-nozzle timeout-block-nozzle rvs-wt-email.
     2127     assign
     2128       fh = frame F-Main:first-child
     2129       wh = fh:first-child
     2130     .
     2131     do while valid-handle(wh):
     2132       if wh:private-data begins "recid=" then do:
     2133         find first temp-thbj-attr
     2134           where recid(temp-thbj-attr) = integer(entry(2, wh:private-data, '='))
     2135         .
     2136         assign
     2137           buffer temp-thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value
     2138         .
     2139       end.
     2140       wh = wh:next-sibling.
     2141     end.
     2142   END PROCEDURE.
