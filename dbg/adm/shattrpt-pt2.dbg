      711   define variable vss-include-info5 as character format "X(65)" no-undo
      712   initial "@(#)$Workfile$ $Revision$".
      713   define temp-table temp_twowin_items no-undo
      714       field itm-key       as integer
      715       field itmExtKey     as character
      716       field itmName       as character
      717       field itmDesc       as character
