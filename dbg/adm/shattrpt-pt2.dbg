     1481   define   shared variable g#passwd as character no-undo .
     1482   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
     1483   DEFINE BUFFER locked_thbj-attr FOR thbj-attr.
     1484   define variable v-tth           as   handle       no-undo .
