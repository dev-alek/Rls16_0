     3985   PROCEDURE proc-b-del :
     3986   DEFINE INPUT PARAMETER p-del-option AS CHARACTER NO-UNDO.
     3987   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     3988   DEFINE VARIABLE glog AS logical NO-UNDO.
     3989   define variable v-loc-rid-list as character no-undo .
     3990   define variable v-entry as character no-undo .
     3991   DEFINE BUFFER buf_exT-FILE FOR UB.EXT-FILE.
     3992   if v-rid-list = '':U then do:
     3993     MESSAGE
     3994     "Вы действительно хотите удалить запись о выделенном файле?" skip
     3995     "(с диска файла не удаляется)" skip
     3996     VIEW-AS ALERT-BOX QUESTION buttons YES-NO UPDATE glog.
     3997     IF NOT glog THEN RETURN.
     3998     v-loc-rid-list = string(recid(X_ext-file)).
     3999   end.
     4000   else  do:
     4001     MESSAGE
     4002     "Вы действительно хотите удалить записи о выделенных файлах?" skip
     4003     "(с диска файлы не удаляются)" skip
     4004     VIEW-AS ALERT-BOX QUESTION buttons YES-NO UPDATE glog.
     4005     IF NOT glog THEN RETURN.
     4006     v-loc-rid-list = v-rid-list.
     4007   end.
     4008   DO ii = 1 TO NUM-ENTRIES(v-loc-rid-list):
     4009     FIND FIRST BUF_EXT-FILE NO-LOCK WHERE
     4010               RECID(BUF_eXT-FILE) = INTEGER( ENTRY(II, V-loc-RID-LIST)) NO-ERROR.
     4011       IF AVAILABLE BUF_eXT-FILE  THEN DO:
     4012         v-entry = string(recid(buf_ext-file)).
     4013         run adm/extf-del.p ( BUFFER BUF_eXT-FILE
     4014                             , input no
     4015                             , INPUT buf_ext-file.status_) no-error .
     4016         if error-status:error then do:
     4017           message
     4018           substitute("Ошибка при удалении файла БД&1&2№ файла &3&2&4&2&5&2&6"
     4019                       , buf_ext-file.db-num
     4020                       , chr(10)
     4021                       , buf_Ext-file.file-num
     4022                       , buf_ext-file.file-name-exec
     4023                       , error-status:get-message(1)
     4024                       , return-value )
     4025           view-as alert-box error.
     4026         end.
     4027         else do:
     4028           if lookup(v-entry, v-rid-list) <> 0 then do:
     4029             entry(lookup(v-entry, v-rid-list), v-rid-list) = ''.
     4030             v-rid-list = replace(v-rid-list, chr(44) + chr(44), chr(44)).
     4031             v-rid-list = trim(v-rid-list, chr(44)).
     4032           end.
     4033         end.
     4034         if num-entries( v-rid-list ) > 0 then do:
     4035           DISPLAY
     4036           num-entries( v-rid-list ) @ mark-num
     4037           with frame Dialog-Frame.
     4038         end.
     4039         else do:
     4040           hide
     4041           mark-num
     4042           in frame Dialog-Frame .
     4043         end.
     4044       END.
     4045   END.
     4046   run OpenBr in this-procedure ( input yes, input no, input no) .
     4047   END PROCEDURE.
