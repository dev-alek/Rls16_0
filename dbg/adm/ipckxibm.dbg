      335       assign
      336         v-inform-launched = true
      337       .
      338       run gbl/d-inform.w
      339         (  input self
      340         ,  input this-procedure
      341         , output v-action
      342         ) no-error .
      343       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      344       assign
      345         v-inform-launched = false
      346       .
      347     end.
      348   end.
      349   procedure proc-alt-f1:
      350     run gbl/corrhelp.p
      351       (input this-procedure
      352       ) .
      353   end .
      354   on alt-shift-f2 anywhere do:
      355     run proc-alt-shift-f2.
      356   end.
      357   on alt-shift-f3 anywhere do:
      358     run proc-alt-shift-f3 in this-procedure .
      359   end.
      360   on alt-shift-f4 anywhere do:
      361     run proc-alt-shift-f4 in this-procedure.
      362   end.
      363   on alt-f1 anywhere do:
      364     run proc-alt-f1 in this-procedure .
      365   end.
      366   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      367   FUNCTION mark-string RETURNS CHARACTER
      368     ( input p-recid as recid, input mark-list as character  ) :
      369     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      370   END FUNCTION.
      371   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      372   define variable c-point  as character no-undo .
      373   define variable tbl      as character no-undo .
      374   define variable join-tbl as character no-undo .
      375   define variable fld      as character no-undo .
      376   define variable lab      as character no-undo .
      377   define variable spr      as character no-undo .
      378   define variable dim      as character no-undo .
      379   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      380   procedure fltfield-clear :
      381     define output parameter loc-fld as character no-undo.
      382     define output parameter loc-lab as character no-undo .
      383     define output parameter loc-spr as character no-undo .
      384     define output parameter loc-dim as character no-undo .
      385     assign
      386       loc-fld = ""
      387       loc-lab = ""
      388       loc-spr = ""
      389       loc-dim = "0"
      390     .
      391   end procedure .
      392   procedure fltfield-add :
      393     define input        parameter par-fld as character no-undo.
      394     define input        parameter par-lab as character no-undo .
      395     define input        parameter par-spr as character no-undo .
      396     define input-output parameter loc-fld as character no-undo.
      397     define input-output parameter loc-lab as character no-undo .
      398     define input-output parameter loc-spr as character no-undo .
      399     define input-output parameter loc-dim as character no-undo .
      400     do
      401     on error undo, return error
      402     :
      403       assign
      404       loc-fld = if loc-dim = '0'
      405                 then par-fld
      406                 else (loc-fld + chr(44) + par-fld)
      407       loc-lab = if loc-dim = '0'
      408                 then par-lab
      409                 else (loc-lab + chr(44) + par-lab)
      410       loc-spr = if loc-dim = '0'
      411                 then par-spr
      412                 else (loc-spr + chr(44) + par-spr)
      413       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      414                 string(integer(if num-entries(loc-dim) > 1
      415                               then entry(2, loc-dim)
      416                               else entry(1, loc-dim)
      417                               ) + 1)
      418       no-error
      419       .
      420     end.
      421   end procedure.
      422   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      423     define variable v-cntxt-db-num        as integer   no-undo .
      424     define variable v-cntxt-userid        as character no-undo .
      425     define variable v-cntxt-level         as character no-undo .
      426     define variable v-cntxt-host-code-obj as integer   no-undo .
      427     define variable v-cntxt-obj-type      as character no-undo .
      428     define variable v-cntxt-obj-code      as integer   no-undo .
      429     define variable v-cntxt-db-num-obj    as integer   no-undo .
      430     define variable v-cntxt-is-admin      as logical   no-undo .
      431   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      432   define NEW SHARED temp-table tt-ext-file-par no-undo like ub.ext-file-par.
      433   procedure ext-file-par-clear-temp :
      434     define buffer buf_tt-ext-file-par for tt-ext-file-par .
      435     do
      436     on error undo, return error return-value
      437     :
      438       for each buf_tt-ext-file-par
      439       on error undo, return error
      440       :
      441         delete buf_tt-ext-file-par .
      442       end.
      443     end.
      444   end procedure.
      445   procedure ext-file-par-write-temp :
      446     define input  parameter p-db-num      as integer no-undo .
      447     define input  parameter p-from-db-num      as integer no-undo .
      448     define input  parameter p-file-num      as integer no-undo .
      449     define input  parameter p-param-num      as integer no-undo .
      450     define input  parameter p-value-type as character no-undo .
      451     define input  parameter p-value-name as character no-undo .
      452     define input  parameter p-value-char as character no-undo .
      453     define input  parameter p-value-date as date      no-undo .
      454     define input  parameter p-value-integer as integer      no-undo .
      455     define input  parameter p-value-decimal as decimal      no-undo .
      456     define input  parameter p-value-logical as logical      no-undo .
      457     define buffer buf_tt-ext-file-par for tt-ext-file-par .
      458     do
      459     on error undo, return error return-value
      460     :
      461       find first buf_tt-ext-file-par
      462         where buf_tt-ext-file-par.db-num        = p-db-num
      463           and buf_tt-ext-file-par.file-num      = p-file-num
      464           and buf_tt-ext-file-par.from-db-num   = p-from-db-num
      465           and buf_tt-ext-file-par.param-type    = p-value-type
      466           and buf_tt-ext-file-par.param-name    = p-value-name
      467         no-error .
      468       if not available buf_tt-ext-file-par then do:
      469         create buf_tt-ext-file-par .
      470         assign
      471           buf_tt-ext-file-par.db-num         = p-db-num
      472           buf_tt-ext-file-par.from-db-num    = p-from-db-num
      473           buf_tt-ext-file-par.file-num       = p-file-num
      474           buf_tt-ext-file-par.param-num      = p-param-num
      475           buf_tt-ext-file-par.param-type     = p-value-type
      476           buf_tt-ext-file-par.user-db-num    = p-db-num
      477                 .
      478       end.
      479       CASE p-value-type:
      480         when 'C':U
      481         or when 'uniq-key-rec':U
      482         then do:
      483           assign
      484           buf_tt-ext-file-par.param-name = p-value-name
      485           buf_tt-ext-file-par.param-value = p-value-char
      486           .
      487         end.
      488         when 'T':U then do:
      489           assign
      490           buf_tt-ext-file-par.param-date-name = p-value-name
      491           buf_tt-ext-file-par.param-date-value = p-value-date
      492           .
      493         end.
      494         when 'I':U then do:
      495           assign
      496           buf_tt-ext-file-par.param-int-name = p-value-name
      497           buf_tt-ext-file-par.param-int-value = p-value-integer
      498           .
      499         end.
      500         when 'L':U then do:
      501           assign
      502           buf_tt-ext-file-par.param-log-name = p-value-name
      503           buf_tt-ext-file-par.param-log-value = p-value-logical
      504           .
      505         end.
      506         when 'D':U then do:
      507           assign
      508           buf_tt-ext-file-par.param-decimal-name = p-value-name
      509           buf_tt-ext-file-par.param-decimal-value = p-value-decimal
      510           .
      511         end.
      512       END CASE.
      513     end.
      514   end procedure.
      515   procedure ext-file-par-write-and-send :
      516     define input  parameter p-db-num      as integer no-undo .
      517     define input  parameter p-from-db-num      as integer no-undo .
      518     define input  parameter p-file-num      as integer no-undo .
      519     define input  parameter p-param-num      as integer no-undo .
      520     define input  parameter p-value-type as character no-undo .
      521     define input  parameter p-value-name as character no-undo .
      522     define input  parameter p-value-char as character no-undo .
      523     define input  parameter p-value-date as date      no-undo .
      524     define input  parameter p-value-integer as integer      no-undo .
      525     define input  parameter p-value-decimal as decimal      no-undo .
      526     define input  parameter p-value-logical as logical      no-undo .
      527     define input  parameter p-send        as logical no-undo .
      528     define input  parameter p-list-db-num as character no-undo .
      529     define buffer buf_ext-file-par for ub.ext-file-par .
      530     do
      531     on error undo, return error return-value
      532     :
      533       find first buf_ext-file-par
      534         where buf_ext-file-par.db-num         = p-db-num
      535           and buf_ext-file-par.from-db-num    = p-from-db-num
      536           and buf_ext-file-par.file-num       = p-file-num
      537           and buf_ext-file-par.param-num      = p-param-num
      538         no-error .
      539       if not available buf_ext-file-par then do:
      540         create buf_ext-file-par .
      541         assign
      542           buf_ext-file-par.db-num    = p-db-num
      543           buf_ext-file-par.from-db-num    = p-from-db-num
      544           buf_ext-file-par.file-num    = p-file-num
      545           buf_ext-file-par.param-num    = p-param-num
      546           buf_ext-file-par.param-type   = p-value-type
      547           buf_ext-file-par.user-db-num    = p-db-num
      548         .
      549       end.
      550       CASE p-value-type:
      551         when 'C':U
      552         or when ''
      553         or when 'uniq-key-rec':U
      554         then do:
      555           assign
      556           buf_ext-file-par.param-name = p-value-name
      557           buf_ext-file-par.param-value = p-value-char
      558           .
      559           if p-value-type = ''
      560           and p-param-num = 0 then do:
      561             buf_ext-file-par.param-log-value = p-value-logical.
      562           end.
      563         end.
      564         when 'T':U then do:
      565           assign
      566           buf_ext-file-par.param-date-name = p-value-name
      567           buf_ext-file-par.param-date-value = p-value-date
      568           .
      569         end.
      570         when 'I':U then do:
      571           assign
      572           buf_ext-file-par.param-int-name = p-value-name
      573           buf_ext-file-par.param-int-value = p-value-integer
      574           .
      575         end.
      576         when 'D':U then do:
      577           assign
      578           buf_ext-file-par.param-decimal-name = p-value-name
      579           buf_ext-file-par.param-decimal-value = p-value-decimal
      580           .
      581         end.
      582         when 'L':U then do:
      583           assign
      584           buf_ext-file-par.param-log-name = p-value-name
      585           buf_ext-file-par.param-log-value = p-value-logical
      586           .
      587         end.
      588       END CASE.
      589       if p-send then do:
      590         run nws/cr-route.p (
      591                         input 'send-tbl':U
      592                       , input 'ext-file-par':U
      593                       , input buffer buf_ext-file-par:handle
      594                       , input p-list-db-num) no-error.
      595       end.
      596     end.
      597   end procedure.
      598   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      599   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      600   procedure fltopend_fltopend :
      601   define input parameter p-parent-handle as handle no-undo .
      602   define input parameter p-qh as handle no-undo .
      603   define input parameter p-flt-open-open-query  as character no-undo .
      604   define input parameter p-where-cond as character no-undo .
      605   define input parameter p-use-indFIRST-query-tail as character no-undo .
      606   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      607   define input parameter p-indexed-reposition as character no-undo .
      608     do
      609     on error undo, return error
      610     :
      611   define variable v-prepare-string as character no-undo .
      612   define variable glog as logical no-undo .
      613   assign
      614   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      615                      p-where-cond + chr(32)  +
      616                      p-use-indFIRST-query-tail + chr(32) +
      617                      p-use-ind-sort-clmn-by + chr(32) +
      618                      p-indexed-reposition
      619   .
      620   assign
      621   glog = p-qh:query-prepare(v-prepare-string) no-error .
      622   if not glog
      623   or error-status:error then do:
      624     message error-status:get-message(1) view-as alert-box .
      625     undo, return error .
      626   end.
      627   assign
      628   glog = p-qh:query-open no-error .
      629   if not glog
      630   or error-status:error then do:
      631     message error-status:get-message(1) view-as alert-box .
      632     undo, return error .
      633   end.
      634     end.
      635   end procedure.
      636   procedure fltopend_fltfindd :
      637   define input parameter p-parent-handle as handle no-undo .
      638   define input parameter p-qh as handle no-undo .
      639   define input parameter p-rowid as rowid no-undo .
      640   define input parameter p-next as logical no-undo .
      641   define input parameter p-lock as integer no-undo .
      642   define input parameter p-bh as handle no-undo .
      643   define input parameter p-where-cond as character no-undo .
      644   define input parameter p-use-index-phrase as character no-undo .
      645   define variable glog as logical no-undo .
      646   define variable v-qh as handle no-undo .
      647   define variable v-bh as handle no-undo .
      648   define variable v-recid as recid no-undo .
      649   define variable v-prepare-string as character no-undo .
      650   do
      651   on error undo, return error
      652   on stop undo, return error
      653   :
      654     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      655     create buffer v-bh for table p-bh buffer-name p-bh:name.
      656     create query v-qh.
      657     v-qh:set-buffers(v-bh).
      658     v-prepare-string = substitute("for each &1 &2 &3"
      659                                     ,v-bh:name
      660                                     ,p-where-cond
      661                                     ,p-use-index-phrase).
      662     glog = v-qh:query-prepare(v-prepare-string) no-error.
      663     if not glog then do:
      664       delete object v-qh.
      665       delete object v-bh.
      666       undo, return error .
      667     end.
      668     glog = v-qh:query-open no-error .
      669     if not glog then do:
      670       delete object v-qh.
      671       delete object v-bh.
      672       undo, return error .
      673     end.
      674     if p-next then do:
      675       v-qh:reposition-to-rowid(p-rowid) no-error .
      676       glog = v-qh:get-next( p-lock) no-error .
      677       glog = v-qh:get-next( p-lock) no-error .
      678       if not glog or v-qh:query-off-end = yes then do:
      679         glog = v-qh:get-first( p-lock) no-error .
      680       end.
      681     end.
      682     else do:
      683       glog = v-qh:get-first( p-lock) no-error .
      684     end.
      685     v-recid = v-bh:recid no-error .
      686     delete object v-qh.
      687     delete object v-bh.
      688     return string(v-recid) .
      689   end.
      690   end procedure.
      691   procedure fltopend_fltfindq :
      692   define input parameter p-parent-handle as handle no-undo .
      693   define input parameter p-qh as handle no-undo .
      694   define input parameter p-next as logical no-undo .
      695   define input parameter p-lock as integer no-undo .
      696   define input parameter p-flt-open-open-query  as character no-undo .
      697   define input parameter p-where-cond as character no-undo .
      698   define input parameter p-use-indFIRST-query-tail as character no-undo .
      699   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      700   define input parameter p-indexed-reposition as character no-undo .
      701   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      702   define variable glog as logical no-undo .
      703   define variable v-qh as handle no-undo .
      704   define variable v-bh as handle no-undo extent 18.
      705   define variable v-rowid as rowid no-undo extent 18.
      706   define variable v-ii as integer no-undo .
      707   define variable v-prepare-string as character no-undo .
      708   do
      709   on error undo, return error
      710   on stop undo, return error
      711   :
      712     create query v-qh.
      713     do v-ii = 1 to p-qh:num-buffers:
      714       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      715       assign
      716       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      717       no-error.
      718       v-qh:add-buffer(v-bh[v-ii]).
      719     end.
      720     assign
      721     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      722                       p-where-cond + chr(32)  +
      723                       p-use-indFIRST-query-tail + chr(32) +
      724                       p-use-ind-sort-clmn-by + chr(32) +
      725                       p-indexed-reposition
      726     .
      727     glog = v-qh:query-prepare( v-prepare-string) no-error .
      728     if not glog then do:
      729       delete object v-qh.
      730       do v-ii = 1 to p-qh:num-buffers:
      731         delete object v-bh[v-ii].
      732       end.
      733       undo, return error .
      734     end.
      735     glog = v-qh:query-open no-error .
      736     if not glog then do:
      737       delete object v-qh.
      738       do v-ii = 1 to p-qh:num-buffers:
      739         delete object v-bh[v-ii].
      740       end.
      741       undo, return error .
      742     end.
      743     if p-next then do:
      744       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      745       glog = v-qh:get-next( p-lock) no-error .
      746       glog = v-qh:get-next( p-lock) no-error .
      747       if not glog or v-qh:query-off-end = yes then do:
      748         glog = v-qh:get-first( p-lock) no-error .
      749       end.
      750     end.
      751     else do:
      752       glog = v-qh:get-first( p-lock) no-error .
      753     end.
      754     do v-ii = 1 to p-qh:num-buffers:
      755       assign
      756       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      757       no-error.
      758     end.
      759     delete object v-qh.
      760     do v-ii = 1 to p-qh:num-buffers:
      761       delete object v-bh[v-ii].
      762     end.
      763   end.
      764   end procedure.
      765   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      766   function usrfulnf returns character ( input p-user-id as character):
      767   define variable v-user-name as character no-undo .
      768   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      769   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      770     (input  p-user-id
      771     ,output v-user-name
      772     ) no-error .
      773   if error-status:error
      774   or v-user-name = ""
      775   then do:
      776     return p-user-id.
      777   end.
      778   else do:
      779     return v-user-name.
      780   end.
      781   end function.
      782   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      783   procedure gen-key-rec :
      784     define input  parameter p-tbl-name    as character no-undo.
      785     define input  parameter p-bh_tbl-name as handle    no-undo.
      786     define output parameter p-key-rec     as character no-undo.
      787     do
      788     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      789     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      790     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      791     :
      792       define variable fh               as handle    no-undo .
      793       define variable v-ok             as logical   no-undo .
      794       define variable v-inform         as character no-undo .
      795       define variable v-ind            as integer   no-undo .
      796       define variable v-idx-field-qnty as integer   no-undo .
      797       if p-tbl-name = ?
      798         or p-tbl-name = "":U
      799       then do:
      800         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info10 ).
      801       end.
      802       if not p-bh_tbl-name:available then do:
      803         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info10, p-tbl-name ).
      804       end.
      805       assign
      806         p-key-rec = p-tbl-name
      807         v-inform  = p-bh_tbl-name:index-information(1)
      808         v-ind     = 2
      809       .
      810       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      811       on error undo, return error
      812       :
      813         assign
      814           v-inform = p-bh_tbl-name:index-information( v-ind )
      815           v-ind    = v-ind + 1
      816         .
      817       end.
      818       if v-inform = ?
      819         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      820         or entry( 3, v-inform, ",":U ) <> "1":U
      821       then do:
      822         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info10, p-tbl-name ).
      823       end.
      824       else do:
      825         assign
      826           v-idx-field-qnty = num-entries( v-inform ) - 4
      827         .
      828         if v-idx-field-qnty < 2 then do:
      829           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info10, v-inform, p-tbl-name ).
      830         end.
      831         do v-ind = 1 to v-idx-field-qnty by 2
      832         on error undo, return error
      833         :
      834           assign
      835             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      836             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      837           .
      838         end.
      839       end.
      840       if p-key-rec = ? then do:
      841         assign
      842           p-key-rec = "":U
      843         .
      844         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info10, p-tbl-name ).
      845       end.
      846     end.
      847     return.
      848   end procedure.
      849   procedure gen-where-keyr-tab :
      850     define input  parameter i-tableSerach as character no-undo.
      851     define input  parameter i-tablekey   as character  no-undo.
      852     define input  parameter p-key-rec    as character  no-undo.
      853     define input  parameter p-key-handle as handle     no-undo .
      854     define input  parameter p-db-name    as character  no-undo .
      855     define input  parameter p-tt-handle  as handle     no-undo .
      856     define output parameter o-Where      as character  no-undo.
      857     do
      858     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      859     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      860     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      861     :
      862       define variable v-full-tbl-name  as character no-undo .
      863       define variable bh_tbl-name      as handle    no-undo .
      864       define variable fh_key           as handle    no-undo .
      865       define variable fh_search        as handle    no-undo .
      866       define variable v-field-num      as integer   no-undo .
      867       define variable v-count-fld      as integer   no-undo .
      868       define variable v-inform         as character no-undo .
      869       define variable v-ind            as integer   no-undo .
      870       define variable v-idx-field-qnty as integer   no-undo .
      871       define variable v-field-name     as character no-undo .
      872       define variable v-field-val      as character no-undo .
      873       define variable v-word-link      as character no-undo .
      874       define variable vTable           as character no-undo.
      875       define variable bh_tbl-key       as handle    no-undo .
      876       assign
      877         p-key-rec = trim( p-key-rec )
      878       .
      879       if p-key-handle <> ? then do:
      880         if not valid-handle(p-key-handle)
      881            or p-key-handle:type <> "buffer"
      882         then do:
      883           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info10 ).
      884         end.
      885         if num-entries( p-key-rec, chr(3) ) > 1
      886           or p-key-rec = ?
      887           or p-key-rec = "":U
      888         then do:
      889           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info10, p-key-rec ).
      890         end.
      891       end.
      892       else do:
      893         if p-key-rec = ?
      894           or p-key-rec = "":U
      895         then do:
      896           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info10 ).
      897         end.
      898       end.
      899       assign
      900         vTable = entry( 1 , p-key-rec, chr(3) )
      901       .
      902       if p-tt-handle <> ?
      903         and ( not valid-handle(p-tt-handle)
      904               or p-tt-handle:type <> "buffer"
      905             )
      906       then do:
      907         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info10, vTable, chr(10) ).
      908       end.
      909       if p-tt-handle = ? then do:
      910         assign
      911           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      912         .
      913         create buffer bh_tbl-name for table v-full-tbl-name .
      914       end.
      915       else do:
      916         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      917       end.
      918       assign
      919         v-inform = bh_tbl-name:index-information(1)
      920         v-ind    = 2
      921       .
      922       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      923       on error undo, return error
      924       :
      925         assign
      926           v-inform = bh_tbl-name:index-information( v-ind )
      927           v-ind    = v-ind + 1
      928         .
      929       end.
      930       if v-inform = ?
      931         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      932         or entry( 3, v-inform, ",":U ) <> "1":U
      933       then do:
      934         delete object bh_tbl-name no-error.
      935         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info10, vTable ).
      936       end.
      937       assign
      938         v-idx-field-qnty = num-entries( v-inform ) - 4
      939       .
      940       if v-idx-field-qnty < 2 then do:
      941         delete object bh_tbl-name no-error.
      942         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info10, v-inform, vTable ).
      943       end.
      944       assign
      945         o-where     = "where":U
      946         v-word-link = "":U
      947         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      948         v-count-fld = 0
      949       .
      950       if i-tablekey ne "" and i-tablekey ne ?
      951       then do:
      952         assign
      953           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      954         .
      955         create buffer bh_tbl-key for table v-full-tbl-name .
      956       end.
      957       if i-tableSerach ne "" and i-tableSerach ne ?
      958       then do:
      959         delete object bh_tbl-name no-error.
      960         assign
      961           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      962         .
      963         create buffer bh_tbl-name for table v-full-tbl-name .
      964       end.
      965       block_where:
      966       do v-ind = 1 to v-idx-field-qnty by 2
      967       on error undo, return error
      968       :
      969         assign
      970           v-count-fld = v-count-fld + 1
      971         .
      972         if p-key-handle = ?
      973           and v-count-fld > v-field-num
      974         then do:
      975           leave block_where.
      976         end.
      977         define variable VfieldKeyTable as handle no-undo.
      978         assign
      979           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      980           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      981         .
      982         if     bh_tbl-key ne ?
      983         then do:
      984            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      985            if VfieldKeyTable eq ?
      986            then next block_where.
      987         end.
      988         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      989         then
      990            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      991         else
      992            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      993         if p-key-handle = ? then do:
      994           assign
      995             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      996           .
      997         end.
      998         else do:
      999           assign
     1000             fh_key = p-key-handle:buffer-field( v-field-name )
     1001           .
     1002           if fh_key = ?
     1003             or not valid-handle( fh_key )
     1004           then do:
     1005             delete object bh_tbl-name.
     1006             if     bh_tbl-key ne ?
     1007             then
     1008                delete object bh_tbl-key.
     1009             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info10, p-key-handle:name, v-field-name ).
     1010           end.
     1011           assign
     1012             v-field-val = fh_key:buffer-value
     1013           .
     1014         end.
     1015         if fh_search:data-type ="character":U then do:
     1016           assign
     1017             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1018             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1019             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1020             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1021             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1022             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1023             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1024             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1025             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1026             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1027             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1028             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1029             v-field-val = substitute( '"&1"', v-field-val )
     1030           .
     1031         end.
     1032         assign
     1033           o-where = substitute( "&1 &2", o-where, v-field-val )
     1034         .
     1035         if v-word-link = "":U then do:
     1036           assign
     1037             v-word-link = "and":U
     1038           .
     1039         end.
     1040       end.
     1041       delete object bh_tbl-name.
     1042       if     bh_tbl-key ne ?
     1043       then
     1044          delete object bh_tbl-key.
     1045       if p-key-handle = ?
     1046         and v-count-fld <> v-field-num
     1047       then do:
     1048         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info10, vTable ).
     1049       end.
     1050     end.
     1051   end procedure.
     1052   procedure gen-hn-keyr-tab :
     1053     define input  parameter i-tableSerach as character no-undo.
     1054     define input  parameter i-tablekey   as character no-undo.
     1055     define input  parameter p-key-rec    as character no-undo.
     1056     define input  parameter p-key-handle as handle    no-undo .
     1057     define input  parameter p-db-name    as character no-undo .
     1058     define input  parameter p-tt-handle  as handle    no-undo .
     1059     define input  parameter p-stts-lock  as integer   no-undo .
     1060     define output parameter o-hn         as handle    no-undo.
     1061     define variable v-full-tbl-name as character no-undo.
     1062     define variable v-where         as character no-undo.
     1063     define variable bh_tbl-name     as handle    no-undo.
     1064     define variable vTable          as character no-undo.
     1065     do
     1066     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1067     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1068     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1069         run gen-where-keyr-tab(i-tableSerach,
     1070                                i-tablekey,
     1071                                p-key-rec,
     1072                                p-key-handle,
     1073                                p-db-name,
     1074                                p-tt-handle,
     1075                                output v-where).
     1076         if i-tableSerach ne "" and i-tableSerach ne ?
     1077         then do:
     1078            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1079            create buffer bh_tbl-name for table v-full-tbl-name .
     1080         end.
     1081         else do:
     1082            if p-tt-handle = ? then do:
     1083               assign
     1084                  vTable = entry( 1 , p-key-rec, chr(3) )
     1085               .
     1086               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1087               create buffer bh_tbl-name for table v-full-tbl-name .
     1088            end.
     1089            else do:
     1090               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1091            end.
     1092         end.
     1093         if p-tt-handle = ? then do:
     1094            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1095         end.
     1096         else do:
     1097            bh_tbl-name:find-first( v-where ) no-error .
     1098         end.
     1099         o-hn = bh_tbl-name.
     1100      end.
     1101   end procedure.
     1102   procedure gen-hn-keyr :
     1103     define input  parameter p-key-rec    as character no-undo.
     1104     define input  parameter p-key-handle as handle    no-undo .
     1105     define input  parameter p-db-name    as character no-undo .
     1106     define input  parameter p-tt-handle  as handle    no-undo .
     1107     define input  parameter p-stts-lock  as integer   no-undo .
     1108     define output parameter o-hn         as handle    no-undo.
     1109     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1110   end.
     1111   procedure gen-row-keyr :
     1112     define input  parameter p-key-rec    as character no-undo.
     1113     define input  parameter p-key-handle as handle    no-undo .
     1114     define input  parameter p-db-name    as character no-undo .
     1115     define input  parameter p-tt-handle  as handle    no-undo .
     1116     define input  parameter p-stts-lock  as integer   no-undo .
     1117     define output parameter p-tbl-row    as rowid     no-undo.
     1118     define output parameter p-tbl-name   as character no-undo.
     1119     define variable vHn as handle no-undo.
     1120       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1121       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1122       p-tbl-name =  vHn:table.
     1123       delete object vHn no-error.
     1124     if p-tbl-row = ? then do:
     1125       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info10, p-tbl-name, p-key-rec ).
     1126     end.
     1127     else do:
     1128       return.
     1129     end.
     1130   end procedure.
     1131   procedure gen-key-fv :
     1132     define input  parameter p-key-rec    as character no-undo .
     1133     define output parameter p-field-list as character no-undo .
     1134     define output parameter p-value-list as character no-undo.
     1135     do
     1136     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1137     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1138     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1139     :
     1140       define variable v-full-tbl-name  as character no-undo .
     1141       define variable bh_tbl-name      as handle    no-undo .
     1142       define variable v-tbl-name       as character no-undo .
     1143       define variable v-field-num      as integer   no-undo .
     1144       define variable v-count-fld      as integer   no-undo .
     1145       define variable v-inform         as character no-undo .
     1146       define variable v-ind            as integer   no-undo .
     1147       define variable v-idx-field-qnty as integer   no-undo .
     1148       define variable v-delim-key      as character no-undo .
     1149       if p-key-rec = ?
     1150         or p-key-rec = "":U
     1151       then do:
     1152         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info10 ).
     1153       end.
     1154       assign
     1155         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1156         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1157       .
     1158       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1159       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info10 ).
     1160       assign
     1161         v-inform = bh_tbl-name:index-information(1)
     1162         v-ind    = 2
     1163       .
     1164       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1165       on error undo, return error
     1166       :
     1167         assign
     1168           v-inform = bh_tbl-name:index-information( v-ind )
     1169           v-ind    = v-ind + 1
     1170         .
     1171       end.
     1172       if v-inform = ?
     1173         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1174         or entry( 3, v-inform, ",":U ) <> "1":U
     1175       then do:
     1176         delete object bh_tbl-name no-error.
     1177         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info10, v-tbl-name ).
     1178       end.
     1179       assign
     1180         v-idx-field-qnty = num-entries( v-inform ) - 4
     1181       .
     1182       if v-idx-field-qnty < 2 then do:
     1183         delete object bh_tbl-name no-error.
     1184         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info10, v-inform, v-tbl-name ).
     1185       end.
     1186       assign
     1187         p-field-list = "":U
     1188         p-value-list = "":U
     1189         v-delim-key  = "":U
     1190         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1191         v-count-fld  = 0
     1192       .
     1193       block_where:
     1194       do v-ind = 1 to v-idx-field-qnty by 2
     1195       on error undo, return error
     1196       :
     1197         assign
     1198           v-count-fld = v-count-fld + 1
     1199         .
     1200         if v-count-fld > v-field-num then do:
     1201           leave block_where.
     1202         end.
     1203         assign
     1204           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1205           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1206         .
     1207         if v-ind = 1 then do:
     1208           assign
     1209             v-delim-key = chr(3)
     1210           .
     1211         end.
     1212       end.
     1213       delete object bh_tbl-name.
     1214       if v-count-fld <> v-field-num then do:
     1215         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info10, v-tbl-name ).
     1216       end.
     1217     end.
     1218   end procedure.
     1219   procedure gen-key-field :
     1220     define input  parameter p-table      as character no-undo .
     1221     define output parameter p-field-list as character no-undo .
     1222     do
     1223     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1224     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1225     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1226     :
     1227       define variable v-full-tbl-name  as character no-undo .
     1228       define variable bh_tbl-name      as handle    no-undo .
     1229       define variable v-tbl-name       as character no-undo .
     1230       define variable v-field-num      as integer   no-undo .
     1231       define variable v-count-fld      as integer   no-undo .
     1232       define variable v-inform         as character no-undo .
     1233       define variable v-ind            as integer   no-undo .
     1234       define variable v-idx-field-qnty as integer   no-undo .
     1235       define variable v-delim-key      as character no-undo .
     1236       if p-table = ?
     1237         or p-table = "":U
     1238       then do:
     1239         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info10 ).
     1240       end.
     1241       assign
     1242         v-tbl-name      = p-table
     1243         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1244       .
     1245       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1246       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info10 ).
     1247       assign
     1248         v-inform = bh_tbl-name:index-information(1)
     1249         v-ind    = 2
     1250       .
     1251       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1252       on error undo, return error
     1253       :
     1254         assign
     1255           v-inform = bh_tbl-name:index-information( v-ind )
     1256           v-ind    = v-ind + 1
     1257         .
     1258       end.
     1259       if v-inform = ?
     1260         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1261         or entry( 3, v-inform, ",":U ) <> "1":U
     1262       then do:
     1263         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info10, v-tbl-name ).
     1264       end.
     1265       assign
     1266         v-idx-field-qnty = num-entries( v-inform ) - 4
     1267       .
     1268       if v-idx-field-qnty < 2 then do:
     1269         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info10, v-inform, v-tbl-name ).
     1270       end.
     1271       assign
     1272         p-field-list = "":U
     1273         v-delim-key  = "":U
     1274         v-count-fld  = 0
     1275       .
     1276       block_where:
     1277       do v-ind = 1 to v-idx-field-qnty by 2
     1278       on error undo, return error
     1279       :
     1280         assign
     1281           v-count-fld = v-count-fld + 1
     1282         .
     1283         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1284         if v-ind = 1 then do:
     1285           assign
     1286             v-delim-key = chr(3)
     1287           .
     1288         end.
     1289       end.
     1290       delete object bh_tbl-name.
     1291     end.
     1292   end procedure.
     1293   DEFINE VARIABLE del-option AS CHARACTER NO-UNDO.
     1294   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1295   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
     1296   define variable sort-column-name as character no-undo .
     1297   define variable filter-point-name as character no-undo .
     1298   define variable filter-point as character no-undo init "ipckxibm" .
     1299   define variable filter-point0 as character no-undo init "ipckxibm" .
     1300   DEFINE variable p-db-num AS INTEGER NO-UNDO.
     1301   DEFINE variable p-file-type AS character NO-UNDO.
     1302   define variable p-obj-type as character no-undo .
     1303   define variable p-obj-code as integer no-undo .
     1304   define variable p-pos-type as character no-undo .
     1305   define variable p-cash-num as integer no-undo .
     1306   DEFINE VARIABLE v-cd-db-num AS INTEGER NO-UNDO.
     1307   DEFINE VARIABLE v-cd-obj-code AS INTEGER NO-UNDO.
     1308   DEFINE VARIABLE v-cd-cash-num AS INTEGER NO-UNDO.
     1309   DEFINE VARIABLE v-ch-db AS WIDGET-HANDLE NO-UNDO.
     1310   FUNCTION get-cd RETURNS INTEGER
     1311     ( INPUT p-db-num AS integer
     1312     , INPUT p-from-db-num AS integer
     1313     , INPUT p-file-num AS INTEGER )  FORWARD.
     1314   DEFINE BUTTON B-add
     1315        LABEL "&Добавить"
     1316        SIZE 10 BY 1.
     1317   DEFINE BUTTON b-db
     1318        IMAGE-UP FILE "btn-down-arrow":U
     1319        IMAGE-DOWN FILE "btn-down-arrow":U
     1320        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1321        LABEL "&БД"
     1322        SIZE 4 BY 1.
     1323   DEFINE BUTTON B-del
     1324        LABEL "&Удалить"
     1325        SIZE 10 BY 1.
     1326   DEFINE BUTTON B-Help
     1327        LABEL "Помо&щь"
     1328        SIZE 3 BY 1
     1329        BGCOLOR 8 .
     1330   DEFINE BUTTON b-lkp
     1331        LABEL "&Просмотр"
     1332        SIZE 10 BY 1 TOOLTIP "Просмотр".
     1333   DEFINE BUTTON b-mark
     1334        LABEL "&*"
     1335        SIZE 4 BY 1.
     1336   DEFINE BUTTON b-output-params
     1337        LABEL "&Рез.вып."
     1338        SIZE 10 BY 1.
     1339   DEFINE BUTTON b-params
     1340        LABEL "Пар-тры"
     1341        SIZE 10 BY 1.
     1342   DEFINE BUTTON b-quit AUTO-END-KEY
     1343        LABEL "&Выход"
     1344        SIZE 10 BY 1
     1345        BGCOLOR 8 .
     1346   DEFINE BUTTON b-save
     1347        LABEL "&Сохр."
     1348        SIZE 10 BY 1 TOOLTIP "Сохранить на диск".
     1349   DEFINE BUTTON b-sch
     1350        LABEL "&Фильтр"
     1351        SIZE 3 BY 1.
     1352   DEFINE VARIABLE f-db-num AS INTEGER FORMAT ">>>>9":U INITIAL 0
     1353        LABEL "БД"
     1354         VIEW-AS TEXT
     1355        SIZE 6 BY .67
     1356        FGCOLOR 4  NO-UNDO.
     1357   DEFINE VARIABLE mark-num AS INTEGER FORMAT ">,>>>,>>9":U INITIAL 0
     1358         VIEW-AS TEXT
     1359        SIZE 10.5 BY .67
     1360        FGCOLOR 10  NO-UNDO.
     1361   DEFINE VARIABLE rs-file-type AS CHARACTER
     1362        VIEW-AS RADIO-SET HORIZONTAL
     1363        RADIO-BUTTONS
     1364             "На кассу", "request",
     1365   "С кассы", "reply"
     1366        SIZE 21 BY 1 NO-UNDO.
     1367   DEFINE QUERY br-ipck FOR
     1368         X_db, X_ext-file SCROLLING.
     1369   DEFINE BROWSE br-ipck
     1370     QUERY br-ipck NO-LOCK DISPLAY
     1371         mark-string ( input recid(x_ext-file), input v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1372       WIDTH 2
     1373   get-cd(X_ext-file.db-num, X_ext-file.from-db-num, X_ext-file.file-num) COLUMN-LABEL 'БД' FORMAT ">>>>9"
     1374   v-cd-obj-code COLUMN-LABEL "Маг" FORMAT ">>>>9"
     1375   v-cd-cash-num COLUMN-LABEL "Касса" FORMAT ">>>>9"
     1376   X_ext-file.file-name-exec COLUMN-LABEL "Файл манифеста" FORMAT "X(255)":U WIDTH 40
     1377   X_ext-file.update-sys-date COLUMN-LABEL "Дата устан." FORMAT "99/99/9999":U
     1378   X_ext-file.update-sys-time COLUMN-LABEL "Время устан." FORMAT "X(8)":U
     1379   usrfulnf(X_ext-file.update-user-name) column-label 'Установил' FORMAT "X(12)":U
     1380   X_ext-file.file-num COLUMN-LABEL "№ файла" FORMAT "->>>>>>>>9":U
     1381   X_ext-file.db-num column-label 'Для БД' FORMAT "->>>>9":U
     1382   X_ext-file.from-db-num COLUMN-LABEL "Из Бд" FORMAT ">>>>>>>>9":U
     1383   X_ext-file.file-size COLUMN-LABEL "Размер" FORMAT ">>>>>>>>9":U
     1384   X_ext-file.create-sys-time COLUMN-LABEL "Дата файла" FORMAT "X(5)":U
     1385   X_ext-file.create-sys-date COLUMN-LABEL "Время файла" FORMAT "99/99/9999":U
     1386   ENABLE
     1387   X_ext-file.create-sys-time
     1388       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 16
     1389            TITLE "" FIT-LAST-COLUMN.
     1390   DEFINE FRAME Dialog-Frame
     1391        b-quit AT ROW 1 COL 1
     1392        b-mark AT ROW 1 COL 17
     1393        B-add AT ROW 1 COL 21
     1394        B-del AT ROW 1 COL 31
     1395        b-params AT ROW 1 COL 41
     1396        b-output-params AT ROW 1 COL 51
     1397        b-save AT ROW 1 COL 61
     1398        b-lkp AT ROW 1 COL 71 WIDGET-ID 2
     1399        b-sch AT ROW 1 COL 92
     1400        B-Help AT ROW 1 COL 95
     1401        b-db AT ROW 2 COL 25 WIDGET-ID 6
     1402        rs-file-type AT ROW 2 COL 32 NO-LABEL WIDGET-ID 8
     1403        br-ipck AT ROW 3 COL 1
     1404        mark-num AT ROW 2 COL 2 NO-LABEL
     1405        f-db-num AT ROW 2 COL 15 COLON-ALIGNED WIDGET-ID 4
     1406        SPACE(76.24) SKIP(16.99)
     1407       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1408            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1409            TITLE "Зарегистрированные пакеты обновлений"
     1410            CANCEL-BUTTON b-quit.
     1411   ASSIGN
     1412          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1413          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1414   ASSIGN
     1415          f-db-num:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1416   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1417   DO:
     1418     APPLY "END-ERROR":U TO SELF.
     1419   END.
     1420   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1421   DO:
     1422     run proc-b-add in this-procedure  no-error.
     1423     if error-status:error then do:
     1424       return no-apply.
     1425     end.
     1426     APPLY "ENTRY" to br-ipck.
     1427   END.
     1428   ON CHOOSE OF b-db IN FRAME Dialog-Frame
     1429   DO:
     1430    define variable ri as recid no-undo.
     1431    define buffer buf_db for ub.db.
     1432     run adm/dbs.w (
     1433                   input parparentproc
     1434                  ,input 'ПРОСМОТР':U
     1435                  ,output ri) no-error.
     1436     if ri <> ?
     1437     then do:
     1438       find buf_db where recid (buf_db) = ri .
     1439       display
     1440       buf_db.db-num @ f-db-num
     1441       with frame Dialog-Frame.
     1442       p-db-num = buf_db.db-num.
     1443     end.
     1444     else do:
     1445       p-db-num = ?.
     1446       display
     1447       ? @ f-db-num
     1448       with frame Dialog-Frame.
     1449     end.
     1450     RUN manage-rs-file-type IN THIS-PROCEDURE.
     1451     run OpenBr IN THIS-PROCEDURE ( input yes, input no, input no).
     1452   END.
     1453   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1454   DO:
     1455     DEFINE VARIABLE del-option AS CHARACTER NO-UNDO.
     1456     IF NOT AVAILABLE X_ext-file THEN RETURN NO-APPLY.
     1457     IF LOOKUP('auto':U, X_ext-file.STATUS_) > 0 THEN do:
     1458       del-option = 'auto':U.
     1459     END.
     1460     ELSE do:
     1461       del-option = 'manual':U.
     1462     END.
     1463     run proc-b-del in this-procedure ( input del-option) no-error.
     1464     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1465     APPLY "ENTRY" to br-ipck.
     1466   END.
     1467   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1468   DO:
     1469     IF NOT AVAILABLE X_ext-file THEN RETURN NO-APPLY.
     1470     run proc-lkp IN THIS-PROCEDURE NO-ERROR.
     1471     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1472   END.
     1473   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1474   DO:
     1475       define variable loc#log as logical no-undo .
     1476       if available X_ext-file then do:
     1477   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1478   define variable v-str-recid12 as character no-undo .
     1479   define variable v-num-entry12 as integer   no-undo .
     1480   assign
     1481     v-str-recid12 = trim( string( recid( X_ext-file ) , "->>>>>>>>>>>9":U ) )
     1482     v-num-entry12 = lookup( v-str-recid12 , v-rid-list )
     1483   .
     1484   if v-num-entry12 > 0 then do:
     1485     assign
     1486       entry( v-num-entry12, v-rid-list ) = "":U
     1487       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1488     .
     1489   end.
     1490   else do:
     1491     assign
     1492       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid12
     1493     .
     1494   end.
     1495         loc#log = br-ipck:refresh() .
     1496         if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1497             loc#log = br-ipck:select-next-row ().
     1498             apply "VALUE-CHANGED" to br-ipck in frame Dialog-Frame.
     1499         end.
     1500         if num-entries( v-rid-list ) = 0
     1501         then
     1502             hide mark-num in frame Dialog-Frame.
     1503         else
     1504             DISPLAY
     1505              num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1506       end.
     1507       apply "entry" to br-ipck in frame Dialog-Frame.
     1508   END.
     1509   ON CHOOSE OF b-output-params IN FRAME Dialog-Frame
     1510   DO:
     1511     IF NOT AVAILABLE X_ext-file THEN RETURN NO-APPLY.
     1512     if NOT (ENTRY(1, X_ext-file.STATUS_, chr(4))  = 'save-disk-and-run':U
     1513             OR entry(1, X_ext-file.STATUS_, chr(4))  = 'save-db-and-run':U
     1514             OR X_ext-file.file-type begins ('cash-desk':U  + chr(3))
     1515             )
     1516             THEN DO:
     1517         MESSAGE
     1518         substitute("Просмотр результатов выполнения доступен только для файлов, переданных в режиме &1 и &2"
     1519                    , 'save-db-and-run':U
     1520                    , 'save-disk-and-run':U)
     1521         VIEW-AS ALERT-BOX.
     1522         RETURN NO-APPLY.
     1523     END.
     1524     run nws/sndfnwp.w ( INPUT parparentproc
     1525                     ,INPUT 'ПРОСМОТР':U
     1526                     ,INPUT "output"
     1527                     ,INPUT X_ext-file.db-num
     1528                     ,INPUT X_ext-file.from-db-num
     1529                     ,INPUT X_ext-file.file-num
     1530                     ).
     1531   END.
     1532   ON CHOOSE OF b-params IN FRAME Dialog-Frame
     1533   DO:
     1534     IF NOT AVAILABLE X_ext-file THEN RETURN NO-APPLY.
     1535     IF not (entry(1, X_ext-file.STATUS_, chr(4)) = 'save-disk-and-run':U
     1536     or      entry(1, X_ext-file.STATUS_, chr(4)) <> 'save-db-and-run':U
     1537     or X_ext-file.file-type begins ('cash-desk':U + chr(3) ))
     1538     THEN DO:
     1539        MESSAGE
     1540        substitute("Просмотр параметров доступен только для файлов, переданных в режиме &1 и &2"
     1541                   , 'save-db-and-run':U
     1542                   , 'save-disk-and-run':U)
     1543        VIEW-AS ALERT-BOX.
     1544        RETURN NO-APPLY.
     1545     END.
     1546     run nws/sndfnwp.w ( INPUT parparentproc
     1547                     ,INPUT 'ПРОСМОТР':U
     1548                     ,INPUT "input"
     1549                     ,INPUT X_ext-file.db-num
     1550                     ,INPUT X_ext-file.from-db-num
     1551                     ,INPUT X_ext-file.file-num).
     1552   END.
     1553   ON CHOOSE OF b-save IN FRAME Dialog-Frame
     1554   DO:
     1555     IF NOT AVAILABLE X_ext-file THEN RETURN NO-APPLY.
     1556     run proc-save-disk IN THIS-PROCEDURE NO-ERROR.
     1557     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1558   END.
     1559   ON CHOOSE OF b-sch IN FRAME Dialog-Frame
     1560   DO:
     1561     run proc-b-sch IN THIS-PROCEDURE NO-ERROR.
     1562     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1563   END.
     1564   ON VALUE-CHANGED OF br-ipck IN FRAME Dialog-Frame
     1565   DO:
     1566     IF NOT AVAILABLE X_ext-file then do:
     1567       DISABLE
     1568       b-output-params
     1569       b-params
     1570       WITH FRAME Dialog-Frame.
     1571     END.
     1572     ELSE DO:
     1573       ENABLE
     1574       b-output-params when rs-file-type = "request"
     1575       b-params
     1576       WITH FRAME Dialog-Frame.
     1577     END.
     1578   END.
     1579   ON VALUE-CHANGED OF rs-file-type IN FRAME Dialog-Frame
     1580   DO:
     1581     ASSIGN
     1582     rs-file-type.
     1583     RUN manage-rs-file-type IN THIS-PROCEDURE.
     1584     run OpenBr IN THIS-PROCEDURE ( input yes, input no, input no).
     1585   END.
     1586   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1587   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1588   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1589   on help of frame Dialog-Frame
     1590   do:
     1591     run gbl/app_help.p
     1592       (input this-procedure :file-name
     1593       ,input ''
     1594       ,input ?
     1595       ) no-error.
     1596     if error-status :error then do:
     1597       message
     1598         "Ошибка при вызове помощи"
     1599         error-status :get-message(1)
     1600         view-as alert-box .
     1601     end.
     1602   end.
     1603   run minbtn-set in this-procedure .
     1604   on choose of b-help in frame Dialog-Frame
     1605   do:
     1606     apply "help":u to frame Dialog-Frame .
     1607   end.
     1608   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1609   procedure minbtn-set :
     1610       do
     1611           on error undo, return error return-value
     1612           :
     1613           define variable ii              as integer       no-undo .
     1614           define variable fh              as widget-handle no-undo .
     1615           define variable hh              as widget-handle no-undo .
     1616           define variable v-h             as handle        extent 4 no-undo .
     1617           define variable v-name-button   as character     no-undo .
     1618           define variable v-help-old-x    as decimal       no-undo .
     1619           define variable v-help-old-y    as decimal       no-undo .
     1620           define variable v-help-old-size as decimal       no-undo .
     1621           define variable v-frame-width   as decimal       no-undo .
     1622           define variable jj              as integer       no-undo .
     1623           do
     1624               on error undo, return error
     1625               :
     1626               assign
     1627                   v-frame-width = frame Dialog-Frame:width - 0.3
     1628                   fh            = frame Dialog-Frame:first-child
     1629                   hh            = fh:first-child
     1630                   ii            = 1
     1631                   .
     1632               do while valid-handle(hh):
     1633                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1634                   do:
     1635                       case lc(hh:name) :
     1636                           when "b-help" then
     1637                               do:
     1638                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1639                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1640                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1641                                   hh:TOOLTIP = "Помощь" .
     1642                                   v-help-old-x = hh:column .
     1643                                   v-help-old-y = hh:row    .
     1644                                   v-help-old-size = hh:width .
     1645                                   hh:width-chars = 2.5 .
     1646                               end.
     1647                           when "b-print" then
     1648                               do:
     1649                                   hh:load-image("cmp/b-print.bmp":u) .
     1650                                   hh:TOOLTIP = "Печать" .
     1651                                   v-h[ii] = hh:handle .
     1652                                   ii = ii + 1 .
     1653                                   hh:width-chars = 3 .
     1654                               end.
     1655                           when "b-history" or
     1656                           when "b-hist" then
     1657                               do:
     1658                                   hh:load-image("cmp/b-hist.bmp":u) .
     1659                                   hh:TOOLTIP = "История" .
     1660                                   v-h[ii] = hh:handle .
     1661                                   ii = ii + 1 .
     1662                                   hh:width-chars = 3 .
     1663                               end.
     1664                           when "b-sch" then
     1665                               do:
     1666                                   hh:load-image("cmp/b-sch.bmp":u) .
     1667                                   hh:TOOLTIP = "Установка Фильтра" .
     1668                                   v-h[ii] = hh:handle .
     1669                                   ii = ii + 1 .
     1670                                   hh:width-chars = 3 .
     1671                               end.
     1672                           when "b-hist-user" then
     1673                               do:
     1674                                   hh:load-image("cmp/b-hist.bmp":u) .
     1675                                   hh:TOOLTIP = "История пользователя" .
     1676                                   ii = ii + 1 .
     1677                               end.
     1678                       end case.
     1679                   end.
     1680                   hh = hh:next-sibling.
     1681               end.
     1682               b-help:column = v-frame-width - b-help:width-chars.
     1683               jj = 0.
     1684               repeat ii = 4 to 1 by -1 :
     1685                   if valid-handle (v-h[ii] ) then
     1686                   do:
     1687                       jj  = jj + 1 .
     1688                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1689                       v-h[ii]:row    = v-help-old-y .
     1690                   end.
     1691               end.
     1692           end.
     1693       end.
     1694   end procedure.
     1695   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1696   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1697   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1698   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1699   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1700   define variable v-diasize-current-frame-height as decimal   no-undo .
     1701   define variable v-diasize-change-size          as logical   no-undo .
     1702   define variable v-diasize-resize-button        as handle    no-undo .
     1703   define variable v-diasize-wndmax               as logical   no-undo .
     1704   define variable v-diasize-wndstore             as logical   no-undo .
     1705   define variable v-diasize-proc-name            as character no-undo .
     1706   define variable v-diasize-browse-handle        as handle    no-undo .
     1707   define variable v-diasize-browse-number        as integer   no-undo .
     1708   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1709   define temp-table temp-diasize-handle no-undo
     1710     field handle-value  as handle
     1711     field save-position as decimal
     1712     index xpk is primary unique handle-value
     1713     .
     1714   define temp-table temp-browse-handle no-undo
     1715     field browse-type   as character
     1716     field browse-number as integer
     1717     field browse-handle as handle
     1718     field original-size as decimal
     1719     index xpk is primary unique browse-type browse-number
     1720     index xie browse-type browse-handle
     1721   .
     1722   procedure diasize_change-height :
     1723     define input  parameter p-change-value  as decimal   no-undo .
     1724     define input  parameter p-move-resize   as logical   no-undo .
     1725     define variable v-field-group-handle    as handle    no-undo .
     1726     define variable v-object-handle         as handle    no-undo .
     1727     define variable v-frame-height          as decimal   no-undo .
     1728     define variable v-frame-virtual-height  as decimal   no-undo .
     1729     define variable v-browse-height         as decimal   no-undo .
     1730     define variable v-window-height         as decimal   no-undo .
     1731     define variable v-window-virtual-height as decimal   no-undo .
     1732     define variable v-change-sign           as integer   no-undo .
     1733     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1734     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1735     if p-change-value > 0
     1736     then do:
     1737       if frame Dialog-Frame :height + p-change-value
     1738           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1739       then do:
     1740         assign
     1741           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1742                           - (frame Dialog-Frame :height-chars)
     1743         .
     1744         if p-change-value <= 0
     1745         then do:
     1746           run diasize_position-resize-button in this-procedure .
     1747           return .
     1748         end.
     1749       end.
     1750     end.
     1751     if p-change-value < 0
     1752     then do:
     1753       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1754       then do:
     1755         assign
     1756           p-change-value = v-diasize-orig-frame-height
     1757                          - (frame Dialog-Frame :height-chars)
     1758         .
     1759         if p-change-value >= 0
     1760         then do:
     1761           run diasize_position-resize-button in this-procedure .
     1762           return .
     1763         end.
     1764       end.
     1765     end.
     1766     if p-change-value >= 0
     1767     then do:
     1768       assign
     1769         v-change-sign = 1
     1770       .
     1771     end.
     1772     else do:
     1773       assign
     1774         v-change-sign = -1
     1775       .
     1776     end.
     1777     assign
     1778       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1779     .
     1780     if p-change-value = 0
     1781     then do:
     1782       run diasize_position-resize-button in this-procedure .
     1783       return .
     1784     end.
     1785     move_block:
     1786     do
     1787     on error undo move_block, retry move_block
     1788     :
     1789       if retry
     1790       then do:
     1791         do
     1792         on error undo move_block, leave move_block
     1793         :
     1794           if p-change-value > 0
     1795           then do:
     1796             for each buf_temp-diasize-handle
     1797             on error undo, next
     1798             :
     1799               assign
     1800                 v-object-handle = buf_temp-diasize-handle.handle-value
     1801               .
     1802               if v-object-handle <> v-diasize-resize-button
     1803               then do:
     1804                 assign
     1805                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1806                 .
     1807               end.
     1808             end.
     1809             assign
     1810               v-diasize-browse-handle :height = v-browse-height
     1811             .
     1812             for each buf_temp-browse-handle
     1813               where buf_temp-browse-handle.browse-type = 'height':u
     1814             on error undo, next
     1815             :
     1816               assign
     1817                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1818               .
     1819             end.
     1820             assign
     1821               frame Dialog-Frame :height = v-frame-height
     1822             .
     1823             if frame Dialog-Frame :scrollable = true
     1824             then do:
     1825               assign
     1826                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1827               .
     1828             end.
     1829             run diasize_position-resize-button in this-procedure .
     1830           end.
     1831           else do:
     1832             if frame Dialog-Frame :scrollable = true
     1833             then do:
     1834               assign
     1835                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1836               .
     1837             end.
     1838             assign
     1839               frame Dialog-Frame :height = v-frame-height
     1840             .
     1841             assign
     1842               v-diasize-browse-handle :height = v-browse-height
     1843             .
     1844             for each buf_temp-browse-handle
     1845               where buf_temp-browse-handle.browse-type = 'height':u
     1846             on error undo, next
     1847             :
     1848               assign
     1849                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1850               .
     1851             end.
     1852             for each buf_temp-diasize-handle
     1853             on error undo, next
     1854             :
     1855               assign
     1856                 v-object-handle = buf_temp-diasize-handle.handle-value
     1857               .
     1858               if v-object-handle <> v-diasize-resize-button
     1859               then do:
     1860                 assign
     1861                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1862                 .
     1863               end.
     1864             end.
     1865             run diasize_position-resize-button in this-procedure .
     1866           end.
     1867           assign
     1868             v-diasize-change-size = false
     1869           .
     1870           leave move_block .
     1871         end.
     1872       end.
     1873       assign
     1874         v-diasize-need-full-display = true
     1875       .
     1876       if v-diasize-change-size = false
     1877       then do:
     1878         assign
     1879           v-diasize-change-size = true
     1880         .
     1881       end.
     1882       else do:
     1883         return .
     1884       end.
     1885       assign
     1886         v-frame-height = frame Dialog-Frame :height
     1887         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1888         v-browse-height = v-diasize-browse-handle :height
     1889       .
     1890       for each buf_temp-browse-handle
     1891         where buf_temp-browse-handle.browse-type = 'height':u
     1892       :
     1893         assign
     1894           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1895         .
     1896       end.
     1897       for each buf_temp-diasize-handle
     1898       :
     1899         delete buf_temp-diasize-handle .
     1900       end.
     1901       assign
     1902         v-field-group-handle = frame Dialog-Frame :first-child
     1903       .
     1904       do while valid-handle(v-field-group-handle)
     1905       :
     1906         assign
     1907           v-object-handle = v-field-group-handle :first-child
     1908         .
     1909         do while valid-handle(v-object-handle)
     1910         :
     1911           if  v-object-handle <> v-diasize-browse-handle :handle
     1912           and can-query(v-object-handle, "row")
     1913           and can-query(v-object-handle, "height")
     1914           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1915           then do:
     1916             find first buf_temp-browse-handle
     1917               where buf_temp-browse-handle.browse-type   = 'height':u
     1918                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1919               no-error .
     1920             if available buf_temp-browse-handle
     1921             then do:
     1922             end.
     1923             else do:
     1924               create buf_temp-diasize-handle .
     1925               assign
     1926                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1927                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1928               .
     1929             end.
     1930           end.
     1931           assign
     1932             v-object-handle = v-object-handle :next-sibling
     1933           .
     1934         end.
     1935         assign
     1936           v-field-group-handle = v-field-group-handle :next-sibling
     1937         .
     1938       end.
     1939       do with frame Dialog-Frame
     1940       :
     1941         hide v-diasize-resize-button .
     1942         assign
     1943           v-diasize-resize-button :row    = 1
     1944           v-diasize-resize-button :column = 1
     1945         .
     1946       end.
     1947       if p-change-value > 0
     1948       then do:
     1949         if frame Dialog-Frame :scrollable = true
     1950         then do:
     1951           assign
     1952             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1953             no-error .
     1954           if error-status :error
     1955           or error-status :get-message(1) <> ""
     1956           then do:
     1957             undo move_block, retry move_block .
     1958           end.
     1959         end.
     1960         assign
     1961           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1962           no-error .
     1963         if error-status :error
     1964         or error-status :get-message(1) <> ""
     1965         then do:
     1966           undo move_block, retry move_block .
     1967         end.
     1968         assign
     1969           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1970           no-error .
     1971         if error-status :error
     1972         or error-status :get-message(1) <> ""
     1973         then do:
     1974           undo move_block, retry move_block .
     1975         end.
     1976         for each buf_temp-browse-handle
     1977           where buf_temp-browse-handle.browse-type = 'height':u
     1978         on error undo move_block, retry move_block
     1979         :
     1980           assign
     1981             buf_temp-browse-handle.browse-handle :height
     1982               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1983             no-error .
     1984           if error-status :error
     1985           or error-status :get-message(1) <> ""
     1986           then do:
     1987             undo move_block, retry move_block .
     1988           end.
     1989         end.
     1990         for each buf_temp-diasize-handle
     1991         on error undo move_block, retry move_block
     1992         :
     1993           assign
     1994             v-object-handle = buf_temp-diasize-handle.handle-value
     1995           .
     1996           if v-object-handle <> v-diasize-resize-button
     1997           then do:
     1998             assign
     1999               v-object-handle :row = v-object-handle :row + p-change-value
     2000               no-error .
     2001             if error-status :error
     2002             or error-status :get-message(1) <> ""
     2003             then do:
     2004               undo move_block, retry move_block .
     2005             end.
     2006           end.
     2007         end.
     2008       end.
     2009       else do:
     2010         for each buf_temp-diasize-handle
     2011         on error undo move_block, retry move_block
     2012         :
     2013           assign
     2014             v-object-handle = buf_temp-diasize-handle.handle-value
     2015           .
     2016           if v-object-handle <> v-diasize-resize-button
     2017           then do:
     2018             assign
     2019               v-object-handle :row = v-object-handle :row + p-change-value
     2020               no-error .
     2021             if error-status :error
     2022             or error-status :get-message(1) <> ""
     2023             then do:
     2024               undo move_block, retry move_block .
     2025             end.
     2026           end.
     2027         end.
     2028         assign
     2029           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2030           no-error .
     2031         if error-status :error
     2032         or error-status :get-message(1) <> ""
     2033         then do:
     2034           undo move_block, retry move_block .
     2035         end.
     2036         for each buf_temp-browse-handle
     2037           where buf_temp-browse-handle.browse-type = 'height':u
     2038         on error undo move_block, retry move_block
     2039         :
     2040           assign
     2041             buf_temp-browse-handle.browse-handle :height
     2042               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2043             no-error .
     2044           if error-status :error
     2045           or error-status :get-message(1) <> ""
     2046           then do:
     2047             undo move_block, retry move_block .
     2048           end.
     2049         end.
     2050         assign
     2051           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2052           no-error .
     2053         if error-status :error
     2054         or error-status :get-message(1) <> ""
     2055         then do:
     2056           undo move_block, retry move_block .
     2057         end.
     2058         if frame Dialog-Frame :scrollable = true
     2059         then do:
     2060           assign
     2061             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2062             no-error .
     2063           if error-status :error
     2064           or error-status :get-message(1) <> ""
     2065           then do:
     2066             undo move_block, retry move_block .
     2067           end.
     2068         end.
     2069       end.
     2070       if p-move-resize = true
     2071       then do:
     2072         run diasize_position-resize-button in this-procedure .
     2073       end.
     2074       if v-diasize-wndstore = true
     2075       then do:
     2076         if connected("ub") = true
     2077         then do:
     2078           define variable v-cntxt-db-num        as integer   no-undo .
     2079           define variable v-cntxt-userid        as character no-undo .
     2080           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2081                                             , OUTPUT v-cntxt-userid
     2082                                             ) .
     2083           run gbl/wndsizew.p
     2084             (input  v-cntxt-db-num
     2085             ,input  v-cntxt-userid
     2086             ,input  v-diasize-proc-name
     2087             ,input  'height':u
     2088             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2089             ) .
     2090         end.
     2091       end.
     2092     end.
     2093     assign
     2094       v-diasize-change-size = false
     2095     .
     2096   end procedure.
     2097   procedure diasize_set-height :
     2098     define input  parameter p-new-height  as decimal   no-undo .
     2099     define input  parameter p-move-resize as logical   no-undo .
     2100     do
     2101     on error undo, return error return-value
     2102     :
     2103       run diasize_change-height in this-procedure
     2104         (input  (p-new-height - frame Dialog-Frame :height)
     2105         ,input  p-move-resize
     2106         ) .
     2107     end.
     2108   end procedure.
     2109   procedure diasize_change-width :
     2110     define input  parameter p-change-value as decimal   no-undo .
     2111     define input  parameter p-move-resize  as logical   no-undo .
     2112     define variable v-field-group-handle   as handle    no-undo .
     2113     define variable v-object-handle        as handle    no-undo .
     2114     define variable v-frame-width          as decimal   no-undo .
     2115     define variable v-frame-virtual-width  as decimal   no-undo .
     2116     define variable v-browse-width         as decimal   no-undo .
     2117     define variable v-window-width         as decimal   no-undo .
     2118     define variable v-window-virtual-width as decimal   no-undo .
     2119     define variable v-change-sign          as integer   no-undo .
     2120     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2121     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2122     if p-change-value > 0
     2123     then do:
     2124       if frame Dialog-Frame :width + p-change-value >
     2125           session :width-chars
     2126       then do:
     2127         assign
     2128           p-change-value = session :width-chars - frame Dialog-Frame :width
     2129         .
     2130         if p-change-value <= 0
     2131         then do:
     2132           run diasize_position-resize-button in this-procedure .
     2133           return .
     2134         end.
     2135       end.
     2136     end.
     2137     if p-change-value < 0
     2138     then do:
     2139       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2140       then do:
     2141         assign
     2142           p-change-value = v-diasize-orig-frame-width
     2143                          - frame Dialog-Frame :width
     2144         .
     2145         if p-change-value >= 0
     2146         then do:
     2147           run diasize_position-resize-button in this-procedure .
     2148           return .
     2149         end.
     2150       end.
     2151     end.
     2152     if p-change-value >= 0
     2153     then do:
     2154       assign
     2155         v-change-sign = 1
     2156       .
     2157     end.
     2158     else do:
     2159       assign
     2160         v-change-sign = -1
     2161       .
     2162     end.
     2163     assign
     2164       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2165     .
     2166     if p-change-value = 0
     2167     then do:
     2168       run diasize_position-resize-button in this-procedure .
     2169       return .
     2170     end.
     2171     move_block:
     2172     do
     2173     on error undo move_block, leave move_block
     2174     :
     2175       if retry
     2176       then do:
     2177         do
     2178         on error undo move_block, leave move_block
     2179         :
     2180           if p-change-value > 0
     2181           then do:
     2182             for each buf_temp-diasize-handle
     2183             on error undo, next
     2184             :
     2185               assign
     2186                 v-object-handle = buf_temp-diasize-handle.handle-value
     2187               .
     2188               if v-object-handle <> v-diasize-resize-button
     2189               then do:
     2190                 assign
     2191                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2192                 .
     2193               end.
     2194             end.
     2195             assign
     2196               v-diasize-browse-handle :width = v-browse-width
     2197             .
     2198             for each buf_temp-browse-handle
     2199               where buf_temp-browse-handle.browse-type = 'width':u
     2200             on error undo, next
     2201             :
     2202               assign
     2203                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2204               .
     2205             end.
     2206             assign
     2207               frame Dialog-Frame :width = v-frame-width
     2208             .
     2209             if frame Dialog-Frame :scrollable = true
     2210             then do:
     2211               assign
     2212                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2213               .
     2214             end.
     2215             run diasize_position-resize-button in this-procedure .
     2216           end.
     2217           else do:
     2218             if frame Dialog-Frame :scrollable = true
     2219             then do:
     2220               assign
     2221                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2222               .
     2223             end.
     2224             assign
     2225               frame Dialog-Frame :width = v-frame-width
     2226             .
     2227             for each buf_temp-browse-handle
     2228               where buf_temp-browse-handle.browse-type = 'width':u
     2229             on error undo, next
     2230             :
     2231               assign
     2232                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2233               .
     2234             end.
     2235             assign
     2236               v-diasize-browse-handle :width = v-browse-width
     2237             .
     2238             for each buf_temp-diasize-handle
     2239             on error undo, next
     2240             :
     2241               assign
     2242                 v-object-handle = buf_temp-diasize-handle.handle-value
     2243               .
     2244               if v-object-handle <> v-diasize-resize-button
     2245               then do:
     2246                 assign
     2247                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2248                 .
     2249               end.
     2250             end.
     2251             run diasize_position-resize-button in this-procedure .
     2252           end.
     2253           assign
     2254             v-diasize-change-size = false
     2255           .
     2256           leave move_block .
     2257         end.
     2258       end.
     2259       assign
     2260         v-diasize-need-full-display = true
     2261       .
     2262       if v-diasize-change-size = false
     2263       then do:
     2264         assign
     2265           v-diasize-change-size = true
     2266         .
     2267       end.
     2268       else do:
     2269         return .
     2270       end.
     2271       assign
     2272         v-frame-width = frame Dialog-Frame :width
     2273         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2274         v-browse-width = v-diasize-browse-handle :width
     2275       .
     2276       for each buf_temp-browse-handle
     2277         where buf_temp-browse-handle.browse-type = 'width':u
     2278       :
     2279         assign
     2280           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2281         .
     2282       end.
     2283       for each buf_temp-diasize-handle
     2284       :
     2285         delete buf_temp-diasize-handle .
     2286       end.
     2287       assign
     2288         v-field-group-handle = frame Dialog-Frame :first-child
     2289       .
     2290       do while valid-handle(v-field-group-handle)
     2291       :
     2292         assign
     2293           v-object-handle = v-field-group-handle :first-child
     2294         .
     2295         do while valid-handle(v-object-handle)
     2296         :
     2297           if  v-object-handle <> v-diasize-browse-handle :handle
     2298           and v-object-handle <> v-diasize-resize-button
     2299           and can-query(v-object-handle, "row")
     2300           and can-query(v-object-handle, "height")
     2301           and ( v-object-handle :col + v-object-handle :width
     2302                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2303               )
     2304           then do:
     2305             find first buf_temp-browse-handle
     2306               where buf_temp-browse-handle.browse-type   = 'width':u
     2307                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2308               no-error .
     2309             if available buf_temp-browse-handle
     2310             then do:
     2311             end.
     2312             else do:
     2313               create buf_temp-diasize-handle .
     2314               assign
     2315                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2316                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2317               .
     2318             end.
     2319           end.
     2320           assign
     2321             v-object-handle = v-object-handle :next-sibling
     2322           .
     2323         end.
     2324         assign
     2325           v-field-group-handle = v-field-group-handle :next-sibling
     2326         .
     2327       end.
     2328       do with frame Dialog-Frame
     2329       :
     2330         hide v-diasize-resize-button .
     2331         v-diasize-resize-button :row = 1.
     2332         v-diasize-resize-button :column = 1.
     2333       end.
     2334       if p-change-value > 0
     2335       then do:
     2336         if frame Dialog-Frame :scrollable = true
     2337         then do:
     2338           assign
     2339             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2340             no-error .
     2341           if error-status :error
     2342           or error-status :get-message(1) <> ""
     2343           then do:
     2344             undo move_block, retry move_block.
     2345           end.
     2346         end.
     2347         assign
     2348           frame Dialog-Frame :width = v-frame-width + p-change-value
     2349           no-error .
     2350         if error-status :error
     2351         or error-status :get-message(1) <> ""
     2352         then do:
     2353           undo move_block, retry move_block.
     2354         end.
     2355         assign
     2356           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2357         no-error .
     2358         if error-status :error
     2359         or error-status :get-message(1) <> ""
     2360         then do:
     2361           undo move_block, retry move_block.
     2362         end.
     2363         for each buf_temp-browse-handle
     2364           where buf_temp-browse-handle.browse-type = 'width':u
     2365         on error undo move_block, retry move_block
     2366         :
     2367           assign
     2368             buf_temp-browse-handle.browse-handle :width
     2369               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2370             no-error .
     2371           if error-status :error
     2372           or error-status :get-message(1) <> ""
     2373           then do:
     2374             undo move_block, retry move_block .
     2375           end.
     2376         end.
     2377         for each buf_temp-diasize-handle
     2378         on error undo move_block, retry move_block
     2379         :
     2380           assign
     2381             v-object-handle = buf_temp-diasize-handle.handle-value
     2382           .
     2383           if v-object-handle <> v-diasize-resize-button
     2384           then do:
     2385             assign
     2386               v-object-handle :col = v-object-handle :col + p-change-value
     2387               no-error .
     2388             if error-status :error
     2389             or error-status :get-message(1) <> ""
     2390             then do:
     2391               undo move_block, retry move_block .
     2392             end.
     2393           end.
     2394         end.
     2395       end.
     2396       else do:
     2397         for each buf_temp-diasize-handle
     2398         on error undo move_block, retry move_block
     2399         :
     2400           assign
     2401             v-object-handle = buf_temp-diasize-handle.handle-value
     2402           .
     2403           if v-object-handle <> v-diasize-resize-button
     2404           then do:
     2405             assign
     2406               v-object-handle :col = v-object-handle :col + p-change-value
     2407               no-error .
     2408             if error-status :error
     2409             or error-status :get-message(1) <> ""
     2410             then do:
     2411               undo move_block, retry move_block .
     2412             end.
     2413           end.
     2414         end.
     2415         for each buf_temp-browse-handle
     2416           where buf_temp-browse-handle.browse-type = 'width':u
     2417         on error undo move_block, retry move_block
     2418         :
     2419           assign
     2420             buf_temp-browse-handle.browse-handle :width
     2421               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2422             no-error .
     2423           if error-status :error
     2424           or error-status :get-message(1) <> ""
     2425           then do:
     2426             undo move_block, retry move_block .
     2427           end.
     2428         end.
     2429         assign
     2430           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2431           no-error .
     2432         if error-status :error
     2433         or error-status :get-message(1) <> ""
     2434         then do:
     2435           undo move_block, retry move_block.
     2436         end.
     2437         assign
     2438           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2439         no-error .
     2440         if error-status :error
     2441         or error-status :get-message(1) <> ""
     2442         then do:
     2443           undo move_block, retry move_block.
     2444         end.
     2445         if frame Dialog-Frame :scrollable = true
     2446         then do:
     2447           assign
     2448             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2449           no-error .
     2450           if error-status :error
     2451           or error-status :get-message(1) <> ""
     2452           then do:
     2453             undo move_block, retry move_block.
     2454           end.
     2455         end.
     2456       end.
     2457       if p-move-resize
     2458       then do:
     2459         run diasize_position-resize-button in this-procedure .
     2460       end.
     2461       if v-diasize-wndstore = true
     2462       then do:
     2463         if connected("ub") = true
     2464         then do:
     2465           define variable v-cntxt-db-num        as integer   no-undo .
     2466           define variable v-cntxt-userid        as character no-undo .
     2467           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2468                                             , OUTPUT v-cntxt-userid
     2469                                             ) .
     2470           run gbl/wndsizew.p
     2471             (input  v-cntxt-db-num
     2472             ,input  v-cntxt-userid
     2473             ,input  v-diasize-proc-name
     2474             ,input  'width':u
     2475             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2476             ) .
     2477         end.
     2478       end.
     2479     end.
     2480     assign
     2481       v-diasize-change-size = false
     2482     .
     2483   end procedure.
     2484   procedure diasize_set-width :
     2485     define input  parameter p-new-width  as decimal   no-undo .
     2486     define input  parameter p-move-resize as logical   no-undo .
     2487     do
     2488     on error undo, return error return-value
     2489     :
     2490       run diasize_change-width in this-procedure
     2491         (input  (p-new-width - frame Dialog-Frame :width)
     2492         ,input  p-move-resize
     2493         ) .
     2494     end.
     2495   end procedure.
     2496   procedure diasize_position-resize-button :
     2497     do with frame Dialog-Frame
     2498     :
     2499       hide v-diasize-resize-button .
     2500       assign
     2501         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2502                     - 1
     2503                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2504         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2505                     - 1
     2506                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2507       .
     2508       view v-diasize-resize-button .
     2509     end.
     2510   end procedure.
     2511   on alt-right anywhere
     2512   do:
     2513     run diasize_change-width in this-procedure
     2514       (input 1
     2515       ,input true
     2516       ) .
     2517     return no-apply .
     2518   end.
     2519   on alt-left anywhere
     2520   do:
     2521     run diasize_change-width in this-procedure
     2522       (input -1
     2523       ,input true
     2524       ) .
     2525     return no-apply .
     2526   end.
     2527   on alt-down anywhere
     2528   do:
     2529     run diasize_change-height in this-procedure
     2530       (input 1
     2531       ,input true
     2532       ) .
     2533     return no-apply .
     2534   end.
     2535   on alt-up anywhere
     2536   do:
     2537     run diasize_change-height in this-procedure
     2538       (input -1
     2539       ,input true
     2540       ) .
     2541     return no-apply .
     2542   end.
     2543   on alt-enter of frame Dialog-Frame
     2544   do:
     2545     run diasize_maximize in this-procedure
     2546       (input  ?
     2547       ).
     2548     return no-apply .
     2549   end.
     2550   procedure diasize_end-move :
     2551     do
     2552     on error undo, return error return-value
     2553     :
     2554       define variable v-row-delta as decimal   no-undo .
     2555       define variable v-col-delta as decimal   no-undo .
     2556       define variable v-new-row as decimal   no-undo .
     2557       define variable v-new-col as decimal   no-undo .
     2558       assign
     2559         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2560         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2561       .
     2562       assign
     2563         v-row-delta = v-new-row - frame Dialog-Frame :height
     2564         v-col-delta = v-new-col - frame Dialog-Frame :width
     2565       .
     2566       run diasize_change-height in this-procedure
     2567         (input v-row-delta
     2568         ,input true
     2569         ) .
     2570       run diasize_change-width in this-procedure
     2571         (input v-col-delta
     2572         ,input true
     2573         ) .
     2574     end.
     2575   end procedure.
     2576   procedure diasize_maximize :
     2577     define input  parameter p-action as logical   no-undo .
     2578     do
     2579     on error undo, return error return-value
     2580     :
     2581       if p-action = ?
     2582       then do:
     2583         if v-diasize-need-maximize = true
     2584         then do:
     2585           assign
     2586             p-action = true
     2587           .
     2588         end.
     2589         else do:
     2590           assign
     2591             p-action = false
     2592           .
     2593         end.
     2594       end.
     2595       if p-action = true
     2596       then do:
     2597         run diasize_change-height in this-procedure
     2598           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2599               - frame Dialog-Frame :height-chars
     2600           ,input true
     2601           ) .
     2602         run diasize_change-width in this-procedure
     2603           (input session :width-chars
     2604               - frame Dialog-Frame :width-chars
     2605           ,input true
     2606           ) .
     2607         assign
     2608           v-diasize-need-maximize = false
     2609         .
     2610       end.
     2611       else do:
     2612         run diasize_change-width in this-procedure
     2613           (input v-diasize-orig-frame-width
     2614               - frame Dialog-Frame :width-chars
     2615           ,input true
     2616           ) .
     2617         run diasize_change-height in this-procedure
     2618           (input v-diasize-orig-frame-height
     2619               - frame Dialog-Frame :height-chars
     2620           ,input true
     2621           ) .
     2622         assign
     2623           v-diasize-need-maximize = true
     2624         .
     2625       end.
     2626     end.
     2627   end procedure.
     2628   procedure diasize_restore-orig-size :
     2629     do
     2630     on error undo, return error return-value
     2631     :
     2632       assign
     2633         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2634         v-diasize-current-frame-height = frame Dialog-Frame :height
     2635       .
     2636       run diasize_set-height in this-procedure
     2637         (input  v-diasize-orig-frame-height
     2638         ,input  true
     2639         ) .
     2640       run diasize_set-width in this-procedure
     2641         (input  v-diasize-orig-frame-width
     2642         ,input  true
     2643         ) .
     2644     end.
     2645   end procedure.
     2646   procedure diasize_restore-current-size :
     2647     do
     2648     on error undo, return error return-value
     2649     :
     2650       run diasize_set-height in this-procedure
     2651         (input  v-diasize-current-frame-height
     2652         ,input  true
     2653         ) .
     2654       run diasize_set-width in this-procedure
     2655         (input  v-diasize-current-frame-width
     2656         ,input  true
     2657         ) .
     2658     end.
     2659   end procedure.
     2660   procedure diasize_set-browse-handle :
     2661     define input  parameter p-browse-handle as handle   no-undo .
     2662     define buffer buf_temp-browse-handle for temp-browse-handle .
     2663     do
     2664     on error undo, return error return-value
     2665     :
     2666       assign
     2667         v-diasize-browse-handle = p-browse-handle
     2668       .
     2669       for each buf_temp-browse-handle
     2670       on error undo, return error return-value
     2671       :
     2672         delete buf_temp-browse-handle .
     2673       end.
     2674     end.
     2675   end procedure.
     2676   procedure diasize_add_browse :
     2677     define input  parameter p-browse-type   as character no-undo .
     2678     define input  parameter p-browse-handle as handle    no-undo .
     2679     define buffer buf_temp-browse-handle for temp-browse-handle .
     2680     do
     2681     on error undo, return error return-value
     2682     :
     2683       assign
     2684         v-diasize-browse-number = v-diasize-browse-number + 1
     2685       .
     2686       create buf_temp-browse-handle .
     2687       assign
     2688         buf_temp-browse-handle.browse-type   = p-browse-type
     2689         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2690         buf_temp-browse-handle.browse-handle = p-browse-handle
     2691       .
     2692     end.
     2693   end procedure.
     2694   procedure diasize_init :
     2695     define variable v-default-value    as logical   no-undo .
     2696     define variable v-restore-saved    as logical   no-undo .
     2697     define variable v-resize-value-str as character no-undo .
     2698     do
     2699     on error undo, return error return-value
     2700     :
     2701       do with frame Dialog-Frame
     2702       :
     2703         assign
     2704           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2705           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2706           v-diasize-browse-handle     = browse br-ipck :handle
     2707         .
     2708         create button v-diasize-resize-button
     2709         assign
     2710           parent        = frame Dialog-Frame :first-child
     2711           label         = "s"
     2712           height-pixels = 16
     2713           width-pixels  = 16
     2714           visible       = true
     2715           sensitive     = true
     2716           movable       = true
     2717           triggers:
     2718             on end-move persistent run diasize_end-move in this-procedure .
     2719           end triggers.
     2720         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2721         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2722         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2723         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2724         assign
     2725           v-diasize-wndmax = false
     2726         .
     2727         if connected("ub") = true
     2728         then do:
     2729           define variable v-cntxt-db-num        as integer   no-undo .
     2730           define variable v-cntxt-userid        as character no-undo .
     2731           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2732                                             , OUTPUT v-cntxt-userid
     2733                                             ) .
     2734           run gbl/wndpar_r.p
     2735             (input  v-cntxt-db-num
     2736             ,input  v-cntxt-userid
     2737             ,input  'wndmax':U
     2738             ,output v-diasize-wndmax
     2739             ,output v-default-value
     2740             ) .
     2741         end.
     2742         assign
     2743           v-diasize-wndstore = false
     2744         .
     2745         if connected("ub") = true
     2746         then do:
     2747           run gbl/wndpar_r.p
     2748             (input  v-cntxt-db-num
     2749             ,input  v-cntxt-userid
     2750             ,input  'wndstore':U
     2751             ,output v-diasize-wndstore
     2752             ,output v-default-value
     2753             ) .
     2754         end.
     2755         assign
     2756           v-diasize-proc-name = entry(1, program-name(2), '.')
     2757         .
     2758         if v-diasize-wndstore = true
     2759         then do:
     2760           assign
     2761             v-restore-saved = false
     2762           .
     2763           if connected("ub") = true
     2764           then do:
     2765             run gbl/wndsizer.p
     2766               (input  v-cntxt-db-num
     2767               ,input  v-cntxt-userid
     2768               ,input  v-diasize-proc-name
     2769               ,input  'height':u
     2770               ,output v-resize-value-str
     2771               ) .
     2772             if v-resize-value-str <> '':U
     2773             then do:
     2774               run diasize_change-height in this-procedure
     2775                 (input  integer(v-resize-value-str)
     2776                 ,input  true
     2777                 ) .
     2778               assign
     2779                 v-restore-saved = true
     2780               .
     2781             end.
     2782           end.
     2783           if connected("ub") = true
     2784           then do:
     2785             run gbl/wndsizer.p
     2786               (input  v-cntxt-db-num
     2787               ,input  v-cntxt-userid
     2788               ,input  v-diasize-proc-name
     2789               ,input  'width':u
     2790               ,output v-resize-value-str
     2791               ) .
     2792             if v-resize-value-str <> '':U
     2793             then do:
     2794               run diasize_change-width in this-procedure
     2795                 (input  integer(v-resize-value-str)
     2796                 ,input  true
     2797                 ) .
     2798               assign
     2799                 v-restore-saved = true
     2800               .
     2801             end.
     2802           end.
     2803           if v-restore-saved <> true
     2804           then do:
     2805             if v-diasize-wndmax = true
     2806             then do:
     2807               run diasize_maximize in this-procedure
     2808                 (input  true
     2809                 ) .
     2810             end.
     2811           end.
     2812         end.
     2813         else do:
     2814           if v-diasize-wndmax = true
     2815           then do:
     2816             run diasize_maximize in this-procedure
     2817               (input  true
     2818               ) .
     2819           end.
     2820         end.
     2821       end.
     2822     end.
     2823   end procedure.
     2824   procedure diasize_need-full-display :
     2825     define output parameter p-need-full-display as logical   no-undo .
     2826     do
     2827     on error undo, return error return-value
     2828     :
     2829       assign
     2830         p-need-full-display = v-diasize-need-full-display
     2831       .
     2832       assign
     2833         v-diasize-need-full-display = false
     2834       .
     2835     end.
     2836   end procedure.
     2837   procedure get-context :
     2838      define output parameter p-db-num as integer          no-undo.
     2839      define output parameter p-user-id as character        no-undo.
     2840      define variable v-login               as character    no-undo.
     2841      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2842      define buffer buf_user-login  for ub.user-login .
     2843      do
     2844      on error undo, return error
     2845      :
     2846            FIND FIRST buf_sys-ctrl no-lock.
     2847            ASSIGN
     2848               v-login = USERID("ub")
     2849               p-db-num = buf_sys-ctrl.db-num
     2850            .
     2851            FIND FIRST buf_user-login
     2852                 WHERE buf_user-login.db-num = p-db-num
     2853                   AND buf_user-login.user-login = v-login
     2854                 no-lock
     2855                 no-error
     2856                 .
     2857            IF AVAILABLE buf_user-login
     2858            THEN DO:
     2859               assign
     2860                  p-user-id = buf_user-login.user-id
     2861               .
     2862            END.
     2863      end.
     2864   end procedure.
     2865       run diasize_init in this-procedure .
     2866   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2867     run mainmenu_getcntxt in parparentproc
     2868       (output v-cntxt-db-num
     2869       ,output v-cntxt-userid
     2870       ,output v-cntxt-level
     2871       ,output v-cntxt-host-code-obj
     2872       ,output v-cntxt-obj-type
     2873       ,output v-cntxt-obj-code
     2874       ,output v-cntxt-db-num-obj
     2875       ,output v-cntxt-is-admin
     2876       ) .
     2877   define variable vss-include-info17 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2878   on INS of frame Dialog-Frame anywhere do:
     2879     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     2880     return no-apply.
     2881   end.
     2882   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2883   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     2884     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     2885     return no-apply.
     2886   end.
     2887   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2888   on F8 of frame Dialog-Frame anywhere do:
     2889     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame Dialog-Frame. END.
     2890     return no-apply.
     2891   end.
     2892   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2893   on F2 of frame Dialog-Frame anywhere do:
     2894     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     2895     return no-apply.
     2896   end.
     2897   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2898   procedure set-filter-name :
     2899   define input parameter p-filter-name as character no-undo .
     2900     do with frame Dialog-Frame:
     2901       if p-filter-name > "" then do:
     2902         assign
     2903           frame Dialog-Frame:title
     2904             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2905         .
     2906         assign
     2907           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2908         .
     2909       end.
     2910       else do:
     2911         assign
     2912           b-sch :tooltip = ""
     2913         .
     2914       end.
     2915     end.
     2916   end procedure.
     2917   def var sort-labelbr-ipck   as character no-undo .
     2918   def var sort-clmnbr-ipck    as handle    no-undo .
     2919   def var cur-clmnbr-ipck     as handle    no-undo .
     2920   def var cur-clmn-locbr-ipck as integer   no-undo .
     2921   def var re-querybr-ipck     as logical   initial no no-undo .
     2922   on start-search, ctrl-o of br-ipck in frame Dialog-Frame do:
     2923      run sort-brbr-ipck
     2924        (input (if available X_db
     2925                then recid(X_db)
     2926                else ?
     2927               )
     2928        ).
     2929   end.
     2930   PROCEDURE sort-brbr-ipck :
     2931     define input parameter p-recid as recid no-undo .
     2932     if re-querybr-ipck = no then do:
     2933       assign
     2934          cur-clmnbr-ipck = br-ipck:current-column in frame Dialog-Frame
     2935       .
     2936       if sort-clmnbr-ipck <> ? then sort-clmnbr-ipck:column-fgcolor = 0.
     2937       if cur-clmnbr-ipck = sort-clmnbr-ipck then do:
     2938         assign
     2939            sort-labelbr-ipck = ""
     2940            sort-clmnbr-ipck = ?
     2941         .
     2942        end.
     2943        else do:
     2944          assign
     2945            sort-labelbr-ipck = cur-clmnbr-ipck:label
     2946            sort-clmnbr-ipck  = cur-clmnbr-ipck
     2947            sort-clmnbr-ipck:column-fgcolor = 4
     2948          .
     2949        end.
     2950      end.
     2951     assign
     2952       cur-clmn-locbr-ipck = 1
     2953     .
     2954     def var column-handle as handle no-undo .
     2955     column-handle = br-ipck:first-column.
     2956     do while valid-handle(column-handle) :
     2957       if column-handle = cur-clmnbr-ipck then do:
     2958         leave .
     2959       end.
     2960       column-handle = column-handle:NEXT-COLUMN.
     2961       assign
     2962         cur-clmn-locbr-ipck = cur-clmn-locbr-ipck + 1
     2963       .
     2964     end.
     2965     case sort-labelbr-ipck:
     2966           when 'Для БД'  then DO:    assign       sort-column-name = "X_ext-file.db-num"     .     run OpenBr in this-procedure ( input yes, input no, input no) .   . END.
     2967           when 'Установил'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1usrfulnf&1, X_ext-file.update-user-name)', chr(34))     .     run OpenBr in this-procedure ( input yes, input no, input no) .   . END.
     2968           when 'Для БД'  then DO:    assign       sort-column-name = "X_ext-file.file-num"     .     run OpenBr in this-procedure ( input yes, input no, input no) .   . END.
     2969       otherwise do:
     2970         assign
     2971           sort-column-name = ""
     2972         .
     2973         run OpenBr in this-procedure ( input yes, input no, input no).
     2974         if sort-labelbr-ipck <> "" then do:
     2975           assign
     2976             cur-clmnbr-ipck:column-fgcolor = 0
     2977           .
     2978         end.
     2979         assign
     2980           cur-clmn-locbr-ipck = ?
     2981         .
     2982       end.
     2983     end case.
     2984     if p-recid <> ? then do:
     2985       reposition br-ipck to recid p-recid no-error.
     2986       apply "value-changed" to br-ipck in frame Dialog-Frame.
     2987     end.
     2988     apply "entry" to br-ipck in frame Dialog-Frame.
     2989   END PROCEDURE.
     2990   procedure re-open-query-srt-clmnbr-ipck:
     2991   if cur-clmnbr-ipck = ? then do:
     2992      run OpenBr in this-procedure ( input yes, input no, input no).
     2993   end.
     2994   else do:
     2995      assign re-querybr-ipck = yes.
     2996      run sort-brbr-ipck
     2997        (input (if available X_db
     2998                then recid(X_db)
     2999                else ?
     3000               )
     3001        ).
     3002      assign re-querybr-ipck = no.
     3003   end.
     3004   end.
     3005   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3006   do:
     3007     br-ipck :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     3008   end.
     3009   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3010   on f5 of frame Dialog-Frame anywhere
     3011   do:
     3012      assign v-doc-rec = ?. if available X_ext-file then v-doc-rec = recid(X_ext-file).              run OpenBr in this-procedure (input yes, input no, input no) no-error. reposition br-ipck to recid v-doc-rec no-error.              APPLY 'Entry' TO br-ipck.
     3013       apply "VALUE-CHANGED" to br-ipck.
     3014   end.
     3015   MAIN-BLOCK:
     3016   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3017      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3018   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3019     run mainmenu_getcntxt in parparentproc
     3020       (output v-cntxt-db-num
     3021       ,output v-cntxt-userid
     3022       ,output v-cntxt-level
     3023       ,output v-cntxt-host-code-obj
     3024       ,output v-cntxt-obj-type
     3025       ,output v-cntxt-obj-code
     3026       ,output v-cntxt-db-num-obj
     3027       ,output v-cntxt-is-admin
     3028       ) .
     3029     ASSIGN
     3030     v-rid-list = p-rid-list.
     3031     if v-cntxt-db-num = 0 then do:
     3032       p-db-num = ?.
     3033     end.
     3034     else do:
     3035       p-db-num = v-cntxt-db-num.
     3036     end.
     3037     run Myenable in this-procedure .
     3038     IF  v-rid-list = '':U THEN
     3039     HIDE mark-num in frame Dialog-Frame .
     3040     WAIT-FOR GO OF FRAME Dialog-Frame.
     3041   END.
     3042   run disable_UI.
     3043   PROCEDURE disable_UI :
     3044     HIDE FRAME Dialog-Frame.
     3045   END PROCEDURE.
     3046   PROCEDURE enable_UI :
     3047     DISPLAY rs-file-type mark-num f-db-num
     3048         WITH FRAME Dialog-Frame.
     3049     ENABLE b-quit b-mark B-add B-del b-params b-output-params b-save b-lkp b-sch
     3050            B-Help b-db rs-file-type br-ipck mark-num
     3051         WITH FRAME Dialog-Frame.
     3052     VIEW FRAME Dialog-Frame.
     3053     OPEN QUERY br-ipck FOR EACH X_db no-lock,        each X_ext-file NO-LOCK WHERE X_ext-file.file-num < 2147483647      INDEXED-REPOSITION .
     3054   END PROCEDURE.
     3055   PROCEDURE manage-rs-file-type :
     3056   CASE rs-file-type:
     3057       WHEN "request" THEN DO:
     3058         p-file-type = 'cash-desk':U + chr(3).
     3059         assign
     3060         b-params:label in frame Dialog-Frame = "Лог"
     3061         b-output-params:label = "Ответ"
     3062         .
     3063         assign
     3064         v-ch-db:VISIBLE = NO
     3065         v-cd-obj-code:VISIBLE IN BROWSE br-ipck = NO
     3066         v-cd-cash-num:VISIBLE IN BROWSE br-ipck = NO
     3067         .
     3068         enable
     3069         b-output-params
     3070         b-add
     3071         with frame Dialog-Frame .
     3072       END.
     3073       WHEN "reply" THEN DO:
     3074         assign
     3075         v-ch-db:VISIBLE = YES
     3076         v-cd-obj-code:VISIBLE IN BROWSE br-ipck = YES
     3077         v-cd-cash-num:VISIBLE IN BROWSE br-ipck = YES
     3078         .
     3079         p-file-type = 'cash-desk':U + chr(3) + chr(3).
     3080         assign
     3081         b-params:label = "Запрос"
     3082         b-output-params:label = ""
     3083         .
     3084         disable
     3085         b-output-params
     3086         b-add
     3087         with frame Dialog-Frame .
     3088         b-output-params:visible in frame Dialog-Frame = no.
     3089       END.
     3090     END CASE.
     3091   END PROCEDURE.
     3092   PROCEDURE MyEnable :
     3093   DEFINE VARIABLE v-ch0 AS WIDGET-HANDLE NO-UNDO.
     3094   ASSIGN
     3095   v-ch0 = br-ipck:FIRST-COLUMN IN FRAME Dialog-Frame.
     3096   REPEAT WHILE valid-handle(v-ch0):
     3097      IF v-ch0:LABEL = 'БД' THEN DO:
     3098        v-ch-db = v-ch0.
     3099        LEAVE.
     3100      END.
     3101      v-ch0 = v-ch0:NEXT-COLUMN.
     3102   END.
     3103   ASSIGN
     3104   X_ext-file.create-sys-time:READ-ONLY IN BROWSE br-ipck = YES
     3105   X_ext-file.file-name-exec:RESIZABLE IN BROWSE br-ipck = YES
     3106   .
     3107   f-db-num = p-db-num.
     3108   display
     3109   f-db-num
     3110   with frame Dialog-Frame .
     3111   ENABLE
     3112   b-quit
     3113   b-mark
     3114   b-add
     3115   B-del
     3116   b-sch
     3117   B-Help
     3118   b-save
     3119   b-lkp
     3120   br-ipck
     3121   b-params
     3122   b-output-params
     3123   rs-file-type
     3124   b-db when v-cntxt-db-num = 0
     3125   WITH FRAME Dialog-Frame .
     3126   ASSIGN
     3127   X_ext-file.file-name-exec:LABEL IN BROWSE br-ipck = "Файл"
     3128   X_ext-file.FILE-NAME-exec:resizable IN BROWSE br-ipck = YES
     3129   .
     3130   VIEW FRAME Dialog-Frame .
     3131   APPLY "VALUE-CHANGED" TO rs-file-type IN FRAME Dialog-Frame.
     3132   END PROCEDURE.
     3133   PROCEDURE Openbr :
     3134   define input  parameter p-open-query     as logical   no-undo .
     3135   define input  parameter p-find-next      as logical   no-undo .
     3136   define input  parameter p-find-condition as character no-undo .
     3137   DEFINE VARIABLE l-query-was-opened as logical no-undo .
     3138   define variable title00 as character no-undo.
     3139   define variable title01 as character no-undo.
     3140   assign
     3141   title00 = substitute("Файлы и ссылки на файлы для IBM-XML, принадлежащих БД &1", p-db-num).
     3142   .
     3143   run waitfram-show in this-procedure ( INPUT "Ждите...").
     3144   DEFINE VARIABLE sort-column-phrase as character no-undo .
     3145   case sort-column-name :
     3146     when "" then do:
     3147       assign
     3148         sort-column-phrase = ""
     3149       .
     3150     end.
     3151     otherwise do:
     3152       assign
     3153         sort-column-phrase = "by " + sort-column-name
     3154       .
     3155     end.
     3156   end case.
     3157   define variable l-open-query as logical   no-undo .
     3158     IF p-db-num = ? THEN DO:
     3159         assign
     3160        filter-point-name = substitute("Работа с файлами IBM-XML") .
     3161         ASSIGN
     3162         frame Dialog-Frame:TITLE = SUBSTITUTE("&1", title00).
     3163         CASE p-file-type:
     3164            WHEN 'cash-desk':U + chr(3) THEN DO:
     3165   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
