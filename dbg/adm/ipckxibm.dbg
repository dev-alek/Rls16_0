     4074                       , INPUT (filter-point + chr(4) +
     4075                               filter-point-name)
     4076                       , INPUT tbl
     4077                       , INPUT join-tbl
     4078                       , INPUT fld
     4079                       , INPUT lab
     4080                       , INPUT spr
     4081                       , INPUT dim ).
