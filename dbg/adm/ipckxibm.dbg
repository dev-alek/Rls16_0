     4087   DEFINE VARIABLE v-override AS INTEGER no-UNDO.
     4088   DEFINE VARIABLE v-printed AS logical no-UNDO.
     4089   DEFINE VARIABLE v-temp-file-name AS CHARACTER NO-UNDO.
     4090   run gbl/_tmpfile.p (
     4091          input  't':U
     4092         ,input  "." + entry( num-entries(X_ext-file.file-name-exec, "."), X_ext-file.FILE-NAME-exec, ".")
     4093         ,output v-temp-file-name
     4094         ) .
     4095   run adm/extfsavd.p (
     4096                INPUT X_ext-file.db-num
     4097               ,INPUT X_ext-file.from-db-num
     4098               ,INPUT X_ext-file.file-num
     4099               ,INPUT v-temp-file-name
     4100               ,INPUT-OUTPUT v-override) NO-ERROR.
     4101   IF ERROR-STATUS:ERROR THEN DO:
     4102     MESSAGE
     4103     SUBSTITUTE("Ошибка при сохранении файла &1 на диск во временный файл&2&3&2&4&2"
     4104             , X_ext-file.FILE-NAME-exec
     4105             , chr(10)
     4106             ,error-status:get-message(1)
     4107             , RETURN-VALUE)
     4108     VIEW-AS ALERT-BOX ERROR.
     4109     RETURN ERROR.
     4110   END.
     4111   os-command  value ('start /wait /b ' + v-temp-file-name).
     4112   OS-DELETE VALUE(v-temp-file-name).
     4113   END PROCEDURE.
     4114   PROCEDURE proc-save-disk :
     4115   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     4116   DEFINE VARIABLE v-override AS INTEGER no-UNDO.
     4117   DEFINE VARIABLE v-dir-path AS CHARACTER NO-UNDO.
     4118   DEFINE VARIABLE v-dir-type AS CHARACTER NO-UNDO.
     4119   DEFINE VARIABLE v-can-write AS logical NO-UNDO.
     4120   DEFINE VARIABLE v-num-files AS integer NO-UNDO.
     4121   DEFINE VARIABLE v-ok AS integer NO-UNDO.
     4122   DEFINE VARIABLE ii AS integer NO-UNDO.
     4123   DEFINE VARIABLE v-loc-rid-list AS CHARACTER NO-UNDO.
     4124   DEFINE BUFFER buf_Ext-file FOR ub.ext-file.
     4125   MESSAGE
     4126   "Вы действительно хотите сохранить на диск выбранный файл/файлы?"
     4127   VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     4128   IF NOT glog THEN RETURN.
     4129    run gbl/dir-sel.p (
     4130                     output v-dir-path
     4131                   , output v-dir-type
     4132                   , output v-can-write
     4133                         )
     4134   .
     4135   if not v-can-write then do:
     4136       message
     4137       substitute("Вы не имеет прав на запись в выбранный каталог &1", v-dir-path)
     4138       view-as alert-box error .
     4139       return error.
     4140   end.
     4141   IF v-rid-list = '':U THEN DO:
     4142     v-loc-rid-list = STRING(RECID(X_ext-file)).
     4143   END.
     4144   ELSE DO:
     4145     v-loc-rid-list = v-rid-list.
     4146   END.
     4147   v-num-files = NUM-ENTRIES(v-loc-rid-list).
     4148   _ii:
     4149   DO ii = 1 TO v-NUM-files
     4150   on stop UNDO _ii, NEXT _ii:
     4151     FIND FIRST buf_ext-file NO-LOCK WHERE
     4152              recid(buf_Ext-file) = INTEGER(ENTRY(ii, v-loc-rid-list)) NO-ERROR.
     4153     IF NOT AVAILABLE buf_ext-file THEN NEXT _ii.
     4154     run adm/extfsavd.p (
     4155                    INPUT buf_ext-file.db-num
     4156                   ,INPUT buf_ext-file.from-db-num
     4157                   ,INPUT buf_ext-file.file-num
     4158                   ,INPUT v-dir-path
     4159                   ,INPUT-OUTPUT v-override) NO-ERROR.
     4160     IF ERROR-STATUS:ERROR THEN DO:
     4161       MESSAGE
     4162       SUBSTITUTE("Ошибка при сохранении файла &1 на диск&2&3&2&4&2"
     4163                 , buf_ext-file.FILE-NAME-exec
     4164                 , chr(10)
     4165                 ,error-status:get-message(1)
     4166                 , RETURN-VALUE)
     4167       VIEW-AS ALERT-BOX ERROR.
     4168       RETURN ERROR.
     4169     END.
     4170     ELSE DO:
     4171         v-ok = v-ok + 1.
     4172     END.
     4173   END.
     4174   IF v-ok <> v-NUM-files THEN DO:
     4175      MESSAGE
     4176      SUBSTITUTE("Выбрано файлов &1, удалось сохранить на диск &2"
     4177                 , v-num-files
     4178                 , v-ok)
     4179      VIEW-AS ALERT-BOX.
     4180   END.
     4181   END PROCEDURE.
     4182   FUNCTION get-cd RETURNS INTEGER
     4183     ( INPUT p-db-num AS integer
     4184     , INPUT p-from-db-num AS integer
     4185     , INPUT p-file-num AS INTEGER ) :
     4186   define variable v-field-list as character no-undo .
     4187   define variable v-value-list as character no-undo.
     4188   DEFINE BUFFER buf_ext-file-par FOR ub.ext-file-par.
     4189   FIND FIRST buf_ext-file-par NO-LOCK WHERE
     4190           buf_ext-file-par.db-num = p-db-num
     4191       AND buf_ext-file-par.from-db-num = p-from-db-num
     4192       AND buf_ext-file-par.file-num = p-file-num
     4193       AND buf_ext-file-par.param-num = 1 NO-ERROR.
     4194   IF AVAILABLE buf_ext-file-par
     4195   AND buf_ext-file-par.param-type = 'uniq-key-rec':U THEN DO:
     4196       run gen-key-fv in this-procedure ( input buf_ext-file-par.param-name
     4197                                         ,output v-field-list
     4198                                         ,output v-value-list) .
     4199       ASSIGN
     4200       v-cd-db-num = INTEGER(entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3)))
     4201       v-cd-obj-code = INTEGER(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)))
     4202       v-cd-cash-num = INTEGER(entry(lookup("cash-num", v-field-list, chr(3)), v-value-list, chr(3)))
     4203       .
     4204       RETURN v-cd-db-num.
     4205   END.
     4206   ELSE DO:
     4207       ASSIGN
     4208       v-cd-db-num = ?
     4209       v-cd-obj-code = 0
     4210       v-cd-cash-num = 0
     4211       .
     4212      RETURN v-cd-db-num.
     4213   END.
     4214   END FUNCTION.
