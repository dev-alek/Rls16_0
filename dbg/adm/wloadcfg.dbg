        1   define input-output parameter par-fname    as character format "x(80)" no-undo.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Экспорт конфигурационных параметров".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   procedure proc-alt-shift-f2:
       63     if not ibs.th.gbl.gbl-var:rcode
       64   then
       65     run gbl\inidebug.p .
       66   end.
       67   procedure proc-alt-shift-f3:
       68     run gbl/prvssinf.p
       69       ( input this-procedure
       70       ) .
       71   end.
       72   define variable v-inform-launched as logical no-undo initial false .
       73   procedure proc-alt-shift-f4:
       74     define variable v-action as character no-undo .
       75     if v-inform-launched = false then do:
       76       assign
       77         v-inform-launched = true
       78       .
       79       run gbl/d-inform.w
       80         (  input self
       81         ,  input this-procedure
       82         , output v-action
       83         ) no-error .
       84       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       85       assign
       86         v-inform-launched = false
       87       .
       88     end.
       89   end.
       90   procedure proc-alt-f1:
       91     run gbl/corrhelp.p
       92       (input this-procedure
       93       ) .
       94   end .
       95   on alt-shift-f2 anywhere do:
       96     run proc-alt-shift-f2.
       97   end.
       98   on alt-shift-f3 anywhere do:
       99     run proc-alt-shift-f3 in this-procedure .
      100   end.
      101   on alt-shift-f4 anywhere do:
      102     run proc-alt-shift-f4 in this-procedure.
      103   end.
      104   on alt-f1 anywhere do:
      105     run proc-alt-f1 in this-procedure .
      106   end.
      107   DEFINE BUTTON b-exit AUTO-GO
      108        LABEL "&Ввод ":L
      109        SIZE 9 BY 1.
      110   DEFINE BUTTON b-file
      111        IMAGE-UP FILE "btn-down-arrow":U
      112        IMAGE-DOWN FILE "btn-down-arrow":U
      113        IMAGE-INSENSITIVE FILE "btn-down-arrow":U NO-FOCUS
      114        LABEL "b-file"
      115        SIZE 2.88 BY .92.
      116   DEFINE BUTTON b-help
      117        LABEL "Помо&щь":L
      118        SIZE 9 BY 1.
      119   DEFINE BUTTON b-quit AUTO-END-KEY
      120        LABEL "&Отмена":L
      121        SIZE 9 BY 1.
      122   DEFINE VARIABLE FName AS CHARACTER FORMAT "X(256)":U
      123        LABEL "Имя файла"
      124        VIEW-AS FILL-IN NATIVE
      125        SIZE 51 BY 1 TOOLTIP "Имя файла конфигурации" NO-UNDO.
      126   DEFINE VARIABLE loc-db-key AS CHARACTER FORMAT "X(256)":U
      127        LABEL "Ключ базы"
      128         VIEW-AS TEXT
      129        SIZE 51 BY .67 NO-UNDO.
      130   DEFINE FRAME d-cnf
      131        b-exit AT ROW 1 COL 2
      132        b-file AT ROW 3.54 COL 64
      133        b-quit AT ROW 1 COL 12
      134        b-help AT ROW 1 COL 60
      135        FName AT ROW 3.5 COL 11 COLON-ALIGNED
      136        loc-db-key AT ROW 2.5 COL 11 COLON-ALIGNED
      137        SPACE(6.37) SKIP(2.07)
      138       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      139            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      140            TITLE "Загрузка конфигурационных параметров":L.
      141   ASSIGN
      142          FRAME d-cnf:SCROLLABLE       = FALSE.
      143   ON CHOOSE OF b-exit IN FRAME d-cnf
      144   DO:
      145     apply "leave" to FName in frame d-cnf.
      146   END.
      147   ON CHOOSE OF b-file IN FRAME d-cnf
      148   DO:
      149   define variable is-choosen as logical no-undo.
      150       SYSTEM-DIALOG GET-FILE Fname
      151       FILTERS "Файлы конфигурации *.cfg" "*.cfg",
      152               "Все файлы"  "*.*"
      153       must-exist
      154       TITLE "Выберите файл для импорта конфигурации"
      155       USE-FILENAME
      156       UPDATE is-choosen.
      157       if is-choosen then do:
      158          display fname with frame d-cnf.
      159          par-fname = fname.
      160       end.
      161   END.
      162   ON CHOOSE OF b-quit IN FRAME d-cnf
      163   DO:
      164     par-fname = "".
      165   END.
      166   ON LEAVE OF FName IN FRAME d-cnf
      167   DO:
      168     assign fname.
      169     par-fname = fname.
      170   END.
      171   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      172   on help of frame d-cnf
      173   do:
      174     run gbl/app_help.p
      175       (input this-procedure :file-name
      176       ,input ''
      177       ,input ?
      178       ) no-error.
      179     if error-status :error then do:
      180       message
      181         "Ошибка при вызове помощи"
      182         error-status :get-message(1)
      183         view-as alert-box .
      184     end.
      185   end.
      186   run minbtn-set in this-procedure .
      187   on choose of b-help in frame d-cnf
      188   do:
      189     apply "help":u to frame d-cnf .
      190   end.
      191   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      192   procedure minbtn-set :
      193       do
      194           on error undo, return error return-value
      195           :
      196           define variable ii              as integer       no-undo .
      197           define variable fh              as widget-handle no-undo .
      198           define variable hh              as widget-handle no-undo .
      199           define variable v-h             as handle        extent 4 no-undo .
      200           define variable v-name-button   as character     no-undo .
      201           define variable v-help-old-x    as decimal       no-undo .
      202           define variable v-help-old-y    as decimal       no-undo .
      203           define variable v-help-old-size as decimal       no-undo .
      204           define variable v-frame-width   as decimal       no-undo .
      205           define variable jj              as integer       no-undo .
      206           do
      207               on error undo, return error
      208               :
      209               assign
      210                   v-frame-width = frame d-cnf:width - 0.3
      211                   fh            = frame d-cnf:first-child
      212                   hh            = fh:first-child
      213                   ii            = 1
      214                   .
      215               do while valid-handle(hh):
      216                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      217                   do:
      218                       case lc(hh:name) :
      219                           when "b-help" then
      220                               do:
      221                                   hh:load-image-up("cmp/b-help.bmp":u) .
      222                                   hh:load-image-down("cmp/b-help.bmp":u) .
      223                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      224                                   hh:TOOLTIP = "Помощь" .
      225                                   v-help-old-x = hh:column .
      226                                   v-help-old-y = hh:row    .
      227                                   v-help-old-size = hh:width .
      228                                   hh:width-chars = 2.5 .
      229                               end.
      230                           when "b-print" then
      231                               do:
      232                                   hh:load-image("cmp/b-print.bmp":u) .
      233                                   hh:TOOLTIP = "Печать" .
      234                                   v-h[ii] = hh:handle .
      235                                   ii = ii + 1 .
      236                                   hh:width-chars = 3 .
      237                               end.
      238                           when "b-history" or
      239                           when "b-hist" then
      240                               do:
      241                                   hh:load-image("cmp/b-hist.bmp":u) .
      242                                   hh:TOOLTIP = "История" .
      243                                   v-h[ii] = hh:handle .
      244                                   ii = ii + 1 .
      245                                   hh:width-chars = 3 .
      246                               end.
      247                           when "b-sch" then
      248                               do:
      249                                   hh:load-image("cmp/b-sch.bmp":u) .
      250                                   hh:TOOLTIP = "Установка Фильтра" .
      251                                   v-h[ii] = hh:handle .
      252                                   ii = ii + 1 .
      253                                   hh:width-chars = 3 .
      254                               end.
      255                           when "b-hist-user" then
      256                               do:
      257                                   hh:load-image("cmp/b-hist.bmp":u) .
      258                                   hh:TOOLTIP = "История пользователя" .
      259                                   ii = ii + 1 .
      260                               end.
      261                       end case.
      262                   end.
      263                   hh = hh:next-sibling.
      264               end.
      265               b-help:column = v-frame-width - b-help:width-chars.
      266               jj = 0.
      267               repeat ii = 4 to 1 by -1 :
      268                   if valid-handle (v-h[ii] ) then
      269                   do:
      270                       jj  = jj + 1 .
      271                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      272                       v-h[ii]:row    = v-help-old-y .
      273                   end.
      274               end.
      275           end.
      276       end.
      277   end procedure.
      278   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-cnf:PARENT eq ?
      279   THEN FRAME d-cnf:PARENT = ACTIVE-WINDOW.
      280   define variable cur-der as logical no-undo.
      281   define buffer buf_sys-ctrl for ub.sys-ctrl .
      282   define buffer buf_db       for ub.db .
      283   cur-der = session:data-entry-return.
      284   session:data-entry-return = yes.
      285   fname = search (par-fname).
      286   if fname <> ? then par-fname = fname.
      287   find first buf_sys-ctrl no-lock.
      288   find buf_db no-lock
      289     where buf_db.db-num = buf_sys-ctrl.db-num
      290   .
      291   assign
      292     loc-db-key = buf_db.db-key
      293   .
      294   MAIN-BLOCK:
      295   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      296      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      297      run enable_UI.
      298      WAIT-FOR GO OF FRAME d-cnf.
      299   END.
      300   RUN disable_UI.
      301   session:data-entry-return = cur-der .
      302   PROCEDURE disable_UI :
      303     HIDE FRAME d-cnf.
      304   END PROCEDURE.
      305   PROCEDURE enable_UI :
      306     DISPLAY FName loc-db-key
      307         WITH FRAME d-cnf.
      308     ENABLE b-exit b-file b-quit b-help FName
      309         WITH FRAME d-cnf.
      310   END PROCEDURE.
