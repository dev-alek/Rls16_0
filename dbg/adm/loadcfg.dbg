        1   block-level on error undo, throw.
        2   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   def var vss-author      as character no-undo init "$Author: expertek $":U.
        4   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U.
        5   def var vss-workfile    as character no-undo init "$Workfile: loadcfg.p $":U.
        6   def var vss-archive     as character no-undo init "$Archive: adm/loadcfg.p $":U.
        7   def var vss-description as character no-undo init "Загрузка конфигурационных параметров".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new shared temp-table cnf no-undo
       63       field param-code    as character   format "x(8)"        column-label "Код"                               field param-type    as character                        column-label "Тип"                               field param-value   as character   format "x(250)"      column-label "Значение"                          field param-encoded as character                        column-label "Кодированное значение"             field host-code     as integer                          column-label "Фирма"                             field obj-type      as character                        column-label "Тип объекта"                       field obj-code      as integer     format ">>>>>>"      column-label "Код объекта"                       field conf-type     as character                        column-label "Кодировка"                         field beg-date      as date                             column-label "Начало действия параметра"         field end-date      as date                             column-label "Окончание действия параметра"      field db-num        as integer     format ">>>>>"       column-label "БД"                                field stts          as integer                          column-label "Статус"
       64       field db-key        as character   format "x(12)"       column-label "Ключ БД"
       65       field param-PS      as character   format "x(40)"       column-label "PS"
       66       field param-name    as character   format "x(30)"       column-label "Название"
       67       field is-changed    as logical initial false            column-label "Изменен"
       68       field NotUsed       as logical initial False            column-label "Выключен"
       69       field ErrorExist    as integer initial 0  format ">>"   column-label "Уровень ошибки"
       70       index pi
       71         is unique
       72         param-code
       73         host-code
       74         obj-type
       75         obj-code
       76         beg-date
       77         end-date
       78         db-num
       79       index db-num
       80         db-num
       81       index db-key
       82         db-key
       83       index par-name
       84         is word-index
       85         param-name
       86       index par-value
       87         is word-index
       88         param-value
       89    .
       90   def new shared temp-table log-table no-undo
       91       field stroka       as character format "x(256)".
       92   def new shared variable err-level as integer no-undo.
       93   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       94   define new global shared variable g#language as character no-undo .
       95   if g#language <> '' and g#language <> 'rus':U then do:
       96     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       97   end.
       98   define new shared temp-table cnf-struct no-undo
       99     field param-code    as character
      100     field param-type    as character
      101     field data-type     as character
      102     field param-name    as character
      103     field attach-type   as character
      104     field list-value    as character
      105     field default-value as character
      106     field PS            as character
      107     field param-group   as character
      108     field user-resp     as character
      109     index by-code is unique param-code
      110   .
      111   define temp-table t_cnf-struct no-undo like cnf-struct .
      112   define stream TxtStream.
      113   define stream temp-stream .
      114   function coding-user-resp returns character
      115     ( input p-param-code as character
      116      ,input p-user-resp  as character
      117     )
      118   :
      119     return encode( p-param-code + p-user-resp ) .
      120   end function.
      121   function decoding-user-resp returns character
      122     ( input p-param-code as character
      123      ,input p-code-usr   as character
      124     )
      125   :
      126     define variable v-ind         as integer   no-undo .
      127     define variable v-user-list   as character no-undo .
      128     define variable v-num-entries as integer   no-undo .
      129     define variable v-user-resp   as character no-undo .
      130     assign
      131       v-user-list   = "Бахтадзе,Булгаков,Белоусов,Гюнтнер,Исаков,Перваков,Суслов,Уханов,Чернова,Кочетков,Степанов,Хныкин,Гридчина,Шальнев,Сливенко,Харитонов,Кирюхин,Морозов"
      132       v-num-entries = num-entries( v-user-list )
      133       v-user-resp   = "":U
      134     .
      135     block_do:
      136     do v-ind = 1 to v-num-entries :
      137       if encode( p-param-code + entry( v-ind, v-user-list ) ) = p-code-usr then do:
      138         assign
      139           v-user-resp = entry( v-ind, v-user-list )
      140         .
      141         leave block_do.
      142       end.
      143     end.
      144     if v-user-resp = "":U then do:
      145       message
      146         vss-include-info0 skip
      147         substitute( "Невозможно распознать ответственного за параметр <&1>!",  p-param-code) skip
      148         substitute( "Возможно его нет в списке." ) skip
      149         view-as alert-box error
      150       .
      151       return "unknown":U.
      152     end.
      153     else do:
      154       return v-user-resp .
      155     end.
      156   end function.
      157   function sum-enc returns character (str as character, num-rev as integer).
      158      define variable rev_incl_s as character init "" no-undo .
      159      define variable rev_incl_i as integer no-undo .
      160      define variable rev_incl_l as integer no-undo .
      161      rev_incl_l = length(str).
      162      do rev_incl_i = 1 to rev_incl_l:
      163         if rev_incl_i <= num-rev
      164           or rev_incl_l - rev_incl_i < num-rev
      165         then do:
      166           assign
      167             rev_incl_s = rev_incl_s + substr(str, rev_incl_l - rev_incl_i + 1, 1)
      168           .
      169         end.
      170         else do:
      171           assign
      172             rev_incl_s = rev_incl_s + substr(str, rev_incl_i, 1)
      173           .
      174         end.
      175      end.
      176      return rev_incl_s.
      177   end.
      178   procedure check-cfg :
      179     define input-output parameter p-param-code    as character no-undo .
      180     define input-output parameter p-param-type    as character no-undo .
      181     define input-output parameter p-data-type     as character no-undo .
      182     define input-output parameter p-param-name    as character no-undo .
      183     define input-output parameter p-attach-type   as character no-undo .
      184     define input-output parameter p-list-value    as character no-undo .
      185     define input-output parameter p-default-value as character no-undo .
      186     define input-output parameter p-param-PS      as character no-undo .
      187     define input-output parameter p-param-group   as character no-undo .
      188     define input-output parameter p-user-resp     as character no-undo .
      189     do
      190     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      191     on stop   undo, return error substitute( "&1. stop", vss-include-info0 )
      192     on endkey undo, return error substitute( "&1. endkey", vss-include-info0 )
      193     :
      194       define variable v-ind as character no-undo .
      195       assign
      196         p-param-code    = trim( p-param-code )
      197         p-param-type    = trim( p-param-type )
      198         p-data-type     = trim( p-data-type )
      199         p-param-name    = trim( p-param-name )
      200         p-attach-type   = trim( p-attach-type )
      201         p-list-value    = trim( p-list-value )
      202         p-default-value = trim( p-default-value )
      203         p-param-PS      = trim( p-param-PS )
      204         p-param-group   = trim( p-param-group )
      205         p-user-resp     = trim( p-user-resp )
      206       .
      207       if p-param-code = "":U then do:
      208         undo, return error substitute( "&1. Не задана метка параметра", vss-include-info0 ).
      209       end.
      210       if length( p-param-code ) > 8 then do:
      211         undo, return error substitute( "&1. Длина метки параметра не может превышать 8 символов (&2)", vss-include-info0, p-param-code ).
      212       end.
      213       if lookup( p-param-type, ',о,к,п':U ) = 0 then do:
      214         undo, return error substitute( '&1. Значение типа настройки "&2" не допустимо (&3)', vss-include-info0, p-param-type, p-param-code ).
      215       end.
      216       if lookup( p-param-type, 'к,п':U ) <> 0
      217         and lookup( p-attach-type, 'Нет':U ) = 0
      218       then do:
      219         undo, return error substitute( '&1. Для параметров с типом "&2" допустимы только привязки "&3" (&4)', vss-include-info0, 'к,п':U, 'Нет':U, p-param-code ).
      220       end.
      221       if p-param-name = "":U then do:
      222         undo, return error substitute( "&1. Не задано название параметра &2", vss-include-info0, p-param-code  ).
      223       end.
      224       if lookup( entry( 1, p-data-type ), "logical,integer,decimal,date,character":U ) = 0
      225         or num-entries( p-data-type ) > 2
      226         or ( num-entries( p-data-type ) = 2
      227              and entry( 2, p-data-type ) <> "list":U
      228            )
      229       then do:
      230         undo, return error substitute( "&1. Значение типа параметра &2 не допустимо (&3)", vss-include-info0, p-data-type, p-param-code ).
      231       end.
      232       if lookup( p-attach-type, 'Нет,Фирма,Объект':U ) = 0
      233       then do:
      234         undo, return error substitute( '&1. Значение привязки "&2" не допустимо (&3)', vss-include-info0, p-attach-type, p-param-code ).
      235       end.
      236     end.
      237     return.
      238   end procedure.
      239   procedure fill-cnf-struct :
      240     define input parameter p-file-name as character no-undo .
      241     do
      242     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      243     on stop   undo, return error substitute( "&1. stop", vss-workfile )
      244     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      245     :
      246       define variable v-file-name as character no-undo .
      247       define variable v-counter as integer   no-undo .
      248       define variable v-temp-fname       as character           no-undo.
      249       define variable v-last-key         as integer             no-undo .
      250       define variable v-new-line         as integer             no-undo .
      251       define variable v-read-chksum      as logical             no-undo .
      252       define variable v-md5-signature-av as character           no-undo .
      253       define variable v-md5-signature    as character           no-undo .
      254       define frame inf-cfg
      255         v-counter label "Просмотрено"
      256         with view-as dialog-box side-labels 1 columns three-d title ""
      257       .
      258       assign
      259         v-file-name = search( p-file-name )
      260       .
      261       if v-file-name = ""
      262         or v-file-name = ?
      263       then do:
      264         return error substitute( "&1. Не задан файл схемы конфигурации!", vss-include-info0 ).
      265       end.
      266       assign
      267         v-last-key         = 0
      268         v-read-chksum      = false
      269         v-md5-signature-av = "":U
      270         file-info:file-name = ".":U
      271         v-temp-fname = substitute( "&1\&2-&3-&4.tmp", file-info:full-pathname, time, etime, random( 1111111 , 9999999 ) )
      272       .
      273       input stream TxtStream from value( v-file-name ).
      274       output stream temp-stream to value(v-temp-fname) .
      275       block_read:
      276       repeat while v-last-key <> -2
      277       on error undo, return error
      278       :
      279         readkey stream TxtStream pause 0.
      280         assign
      281           v-last-key = lastkey
      282         .
      283         if chr( v-last-key ) = chr(1) then do:
      284           assign
      285             v-read-chksum = true
      286           .
      287         end.
      288         else do:
      289           if v-read-chksum = true then do:
      290             if v-last-key = 13 then do:
      291               leave block_read.
      292             end.
      293             else do:
      294               assign
      295                 v-md5-signature-av = v-md5-signature-av + chr( v-last-key )
      296               .
      297             end.
      298           end.
      299           else do:
      300             if v-last-key = 13 then do:
      301               put stream temp-stream skip(v-new-line).
      302               assign
      303                 v-new-line = 1
      304               .
      305             end.
      306             else do:
      307               put stream temp-stream unformatted chr( v-last-key ).
      308               assign
      309                 v-new-line = 0
      310               .
      311             end.
      312           end.
      313         end.
      314       end.
      315       output stream temp-stream close.
      316       input stream TxtStream close.
      317       run gbl/md5.p
      318         ( input  search( v-temp-fname )
      319          ,output v-md5-signature
      320         ) no-error.
      321       if error-status :error then do:
      322         return error substitute("Ошибка при подсчете контрольной суммы текстового файла схемы &1", v-file-name ) .
      323       end.
      324       os-delete value( v-temp-fname ).
      325       assign
      326         v-md5-signature = sum-enc( v-md5-signature, 8 )
      327       .
      328       if v-md5-signature-av <> v-md5-signature then do:
      329         return error substitute( "Некорректная контрольная сумма текстового файла схемы &1", v-file-name ) .
      330       end.
      331       input stream TxtStream from value( v-file-name ).
      332       assign
      333         v-counter = 0
      334       .
      335       assign
      336         frame inf-cfg:title = "Чтение параметров конфигурации"
      337       .
      338       view frame inf-cfg.
      339       for each t_cnf-struct:
      340         delete t_cnf-struct.
      341       end.
      342       create t_cnf-struct no-error.
      343       read-cycle:
      344       repeat transaction
      345       on error  undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      346       :
      347         assign
      348           v-counter = v-counter + 1
      349         .
      350         if ( v-counter modulo 10 ) = 0 then do:
      351           display
      352             v-counter
      353             with frame inf-cfg.
      354         end.
      355         import stream TxtStream delimiter '`':U t_cnf-struct.param-code t_cnf-struct.param-type t_cnf-struct.data-type t_cnf-struct.param-name t_cnf-struct.attach-type t_cnf-struct.list-value t_cnf-struct.default-value t_cnf-struct.PS t_cnf-struct.param-group t_cnf-struct.user-resp no-error.
      356         if error-status:error then do:
      357           return error substitute( "&1. Ошибка при чтении текстового файла схемы! Cтрока &1. (&2)", vss-include-info0, v-counter, error-status :get-message ( error-status :num-messages ) ).
      358         end.
      359         else do:
      360           if not ( t_cnf-struct.param-code begins chr(1) ) then do:
      361             assign
      362               t_cnf-struct.user-resp = decoding-user-resp( t_cnf-struct.param-code, t_cnf-struct.user-resp )
      363             .
      364             if t_cnf-struct.user-resp = "unknown":U then do:
      365               return error substitute( "&1. Ошибка параметра! Cтрока &2.", vss-include-info0, v-counter ).
      366             end.
      367             run check-cfg in this-procedure
      368               ( input-output t_cnf-struct.param-code
      369               ,input-output t_cnf-struct.param-type
      370               ,input-output t_cnf-struct.data-type
      371               ,input-output t_cnf-struct.param-name
      372               ,input-output t_cnf-struct.attach-type
      373               ,input-output t_cnf-struct.list-value
      374               ,input-output t_cnf-struct.default-value
      375               ,input-output t_cnf-struct.PS
      376               ,input-output t_cnf-struct.param-group
      377               ,input-output t_cnf-struct.user-resp
      378               ) no-error .
      379             if error-status :error then do:
      380               return error substitute( "&1. Ошибка параметра! Cтрока &2. &3 (&4)", vss-include-info0, v-counter, return-value, error-status :get-message ( error-status :num-messages ) ).
      381             end.
      382             else do:
      383               find first cnf-struct
      384                 where cnf-struct.param-code = t_cnf-struct.param-code
      385                 no-error
      386               .
      387               if not available cnf-struct then do:
      388                 create cnf-struct .
      389               end.
      390               buffer-copy t_cnf-struct to cnf-struct .
      391             end.
      392           end.
      393         end.
      394       end.
      395       delete t_cnf-struct no-error.
      396       hide frame inf-cfg.
      397       input stream TxtStream close.
      398     end.
      399     return.
      400   end procedure.
      401   define input parameter  cnf-fname        as character no-undo .
      402   define input parameter  cnf-struct-fname as character no-undo .
      403   define input parameter  log-fname        as character no-undo .
      404   define input parameter  app-parameter    as logical   no-undo .
      405   define input parameter  app-message      as logical   no-undo .
      406   define input parameter  chg-encode       as logical   no-undo .
      407   define input parameter  err-block        as integer   no-undo .
      408   define output parameter result           as integer   no-undo .
      409   do
      410   on error undo, return error return-value
      411   :
      412     define buffer buf_sys-ctrl for ub.sys-ctrl .
      413     create widget-pool .
      414     define variable w-loadcfg as widget-handle no-undo.
      415     create window w-loadcfg
      416     assign
      417       title              = "Загрузка параметров конфигурации"
      418       column             = 31.5
      419       row                = 9
      420       height             = 2.0
      421       width              = 35
      422       resize             = false
      423       scroll-bars        = false
      424       status-area        = false
      425       three-d            = true
      426       message-area       = false
      427       sensitive          = true
      428       visible            = true
      429     .
      430     assign
      431       current-window = w-loadcfg
      432     .
      433     define variable Cnf-hdl      as handle    no-undo .
      434     define variable CurCnf-hdl   as handle    no-undo .
      435     define variable dbCnf-hdl    as handle    no-undo .
      436     define variable v-err-code   as integer   no-undo .
      437     assign
      438       result = 0
      439     .
      440     run adm/cnf-str.p persistent set cnf-hdl no-error.
      441     if not valid-handle (cnf-hdl) then do:
      442       do: result = 3 . run go-out in this-procedure . return. end.
      443     end.
      444     if log-fname = "" then do:
      445       assign
      446         log-fname = "err-conf.txt"
      447       .
      448     end.
      449     run init in cnf-hdl
      450       (input  log-fname
      451       ,input  no
      452       ,input  app-message
      453       ) no-error .
      454     if return-value <> "":U then do:
      455       do: result = 3 . run go-out in this-procedure . return. end.
      456     end.
      457     run adm/cnf-db.p persistent set dbCnf-hdl no-error.
      458     if not valid-handle (dbCnf-hdl) then do:
      459       do: result = 3 . run go-out in this-procedure . return. end.
      460     end.
      461     run init in dbCnf-hdl
      462       ( input cnf-hdl
      463       ) no-error.
      464     if return-value <> "":U then do:
      465       do: result = 3 . run go-out in this-procedure . return. end.
      466     end.
      467     run adm/cnf-cnf.p persistent set CurCnf-hdl no-error.
      468     if not valid-handle (CurCnf-hdl) then do:
      469       do: result = 3 . run go-out in this-procedure . return. end.
      470     end.
      471     run init in CurCnf-hdl
      472       ( input cnf-hdl
      473       , input dbcnf-hdl
      474       ) no-error.
      475     if return-value <> "":U then do:
      476       do: result = 3 . run go-out in this-procedure . return. end.
      477     end.
      478     if cnf-struct-fname = "":U then do:
      479       assign
      480         cnf-struct-fname = search( "cmp/mold_db.sch" )
      481       .
      482       if cnf-struct-fname = ? then do:
      483         run log-sys-error in cnf-hdl( "Не найден файл схемы конфигурации" ).
      484         do: result = 3 . run go-out in this-procedure . return. end.
      485       end.
      486     end.
      487     run fill-cnf-struct in this-procedure
      488       ( input cnf-struct-fname
      489       ) no-error.
      490     if error-status :error then do:
      491       run log-sys-error in cnf-hdl( "Ошибка при чтении файл схемы конфигурации" ).
      492       do: result = 3 . run go-out in this-procedure . return. end.
      493     end.
      494     find first buf_sys-ctrl no-lock no-error.
      495     if not available buf_sys-ctrl then do:
      496       run log-sys-error in cnf-hdl( "Ошибка при чтении sys-ctrl" ).
      497       do: result = 3 . run go-out in this-procedure . return. end.
      498     end.
      499     if app-parameter = true then do:
      500         run LoadDB in dbCnf-hdl
      501           no-error.
      502         if error-status:error then do:
      503           run log-sys-error in cnf-hdl (substitute( "&1", return-value ) ).
      504           do: result = 3 . run go-out in this-procedure . return. end.
      505         end.
      506         if return-value <> "" then do:
      507           assign
      508             v-err-code = integer( return-value )
      509           .
      510           if v-err-code > 1 then do:
      511             assign
      512               result = v-err-code
      513             .
      514             run go-out in this-procedure .
      515             return.
      516           end.
      517         end.
      518     end.
      519     run import in CurCnf-hdl
      520       ( input cnf-fname
      521        ,input no
      522        ,input yes
      523        ,input no
      524        ,input (if buf_sys-ctrl.db-num = 0 then "":U else string( buf_sys-ctrl.db-num ) )
      525       ) no-error.
      526     if error-status:error then do:
      527       run log-sys-error in cnf-hdl (substitute( "&1", return-value ) ).
      528       do: result = 3 . run go-out in this-procedure . return. end.
      529     end.
      530     if return-value <> "" then do:
      531       assign
      532         v-err-code = integer( return-value )
      533       .
      534       if v-err-code > 1 then do:
      535         assign
      536           result = v-err-code
      537         .
      538         run go-out in this-procedure .
      539         return.
      540       end.
      541     end.
      542     run save-cfg in dbcnf-hdl
      543       ( input chg-encode
      544       ) no-error.
      545     if error-status:error then do:
      546       run log-sys-error in cnf-hdl (substitute( "&1", return-value ) ).
      547       do: result = 3 . run go-out in this-procedure . return. end.
      548     end.
      549     if return-value <> "" then do:
      550       assign
      551         v-err-code = integer( return-value )
      552       .
      553       if v-err-code > 1 then do:
      554         assign
      555           result = v-err-code
      556         .
      557         run go-out in this-procedure .
      558         return.
      559       end.
      560     end.
      561     run go-out in this-procedure .
      562     delete object w-loadcfg .
      563   end.
      564   procedure go-out :
      565     if valid-handle (cnf-hdl)
      566     then do:
      567       run kill in cnf-hdl no-error.
      568     end.
      569     if valid-handle (curcnf-hdl)
      570     then do:
      571       run kill in curcnf-hdl no-error.
      572     end.
      573     if valid-handle (dbcnf-hdl)
      574     then do:
      575       run kill in dbcnf-hdl no-error.
      576     end.
      577     return.
      578   end procedure.
