      616   procedure proc-alt-shift-f2:
      617     if not ibs.th.gbl.gbl-var:rcode
      618   then
      619     run gbl\inidebug.p .
      620   end.
      621   procedure proc-alt-shift-f3:
      622     run gbl/prvssinf.p
      623       ( input this-procedure
      624       ) .
      625   end.
      626   define variable v-inform-launched as logical no-undo initial false .
      627   procedure proc-alt-shift-f4:
      628     define variable v-action as character no-undo .
      629     if v-inform-launched = false then do:
      630       assign
      631         v-inform-launched = true
      632       .
      633       run gbl/d-inform.w
      634         (  input self
      635         ,  input this-procedure
      636         , output v-action
      637         ) no-error .
      638       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      639       assign
      640         v-inform-launched = false
      641       .
      642     end.
      643   end.
