      772   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      773   DEFINE VARIABLE v-db-num LIKE ub.db.db-num NO-UNDO.
      774   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO.
      775   DEFINE VARIABLE v-to-create AS logical NO-UNDO.
      776   DEFINE VARIABLE v-gdsscrvw AS CHARACTER NO-UNDO.
      777   DEFINE BUFFER cli-buf FOR ub.clients .
      778   define variable v-tth as handle no-undo .
      779   assign
      780   v-tth = buffer thbjattr_thbj-attr:table-handle .
      781   DEFINE TEMP-TABLE temp-gdsscrvw NO-UNDO
      782   FIELD tbl-name AS CHARACTER
      783   FIELD fld-name AS CHARACTER
      784   FIELD custom-label AS CHARACTER
      785   FIELD is-on AS LOGICAL
      786   INDEX pi IS UNIQUE PRIMARY tbl-name fld-name
      787   .
      788   DEFINE BUTTON B-dfltggrp
      789        IMAGE-UP FILE "btn-down-arrow":U
      790        IMAGE-DOWN FILE "btn-down-arrow":U
      791        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      792        LABEL "Btn 1"
      793        SIZE 4 BY 1.
      794   DEFINE BUTTON B-exit AUTO-GO
      795        LABEL "&Ввод"
      796        SIZE 10 BY 1
      797        BGCOLOR 8 .
      798   DEFINE BUTTON B-Help
      799        LABEL "Помо&щь"
      800        SIZE 3 BY 1
      801        BGCOLOR 8 .
      802   DEFINE BUTTON b-quit AUTO-END-KEY
      803        LABEL "&Отмена"
      804        SIZE 10 BY 1
      805        BGCOLOR 8 .
      806   DEFINE VARIABLE f-dfltggrp AS INTEGER FORMAT "->,>>>,>>9":U INITIAL -1
      807        LABEL "Гр.товаров по умолч."
      808        VIEW-AS FILL-IN NATIVE
      809        SIZE 9 BY 1 NO-UNDO.
      810   DEFINE VARIABLE f-grp-name AS CHARACTER FORMAT "X(256)":U
      811        VIEW-AS FILL-IN NATIVE
      812        SIZE 61 BY 1
      813        FGCOLOR 3  NO-UNDO.
      814   DEFINE VARIABLE f-image-dir AS CHARACTER FORMAT "X(256)":U
      815        label "Директория для фото"
      816        VIEW-AS FILL-IN NATIVE
      817        SIZE 61 BY 1
      818        FGCOLOR 3  NO-UNDO.
      819   DEFINE VARIABLE t-chg-bcod AS LOGICAL INITIAL no
      820        LABEL "Запрещена работа с Доп-БК"
      821        VIEW-AS TOGGLE-BOX
      822        SIZE 49.4 BY .81 NO-UNDO.
      823   DEFINE QUERY BR-gdsscrvw FOR
      824         temp-gdsscrvw SCROLLING.
      825   DEFINE BROWSE BR-gdsscrvw
      826     QUERY BR-gdsscrvw DISPLAY
      827         temp-gdsscrvw.custom-label  COLUMN-LABEL "Поле" FORMAT "X(25)"
      828   temp-gdsscrvw.is-on COLUMN-LABEL "Показывать" VIEW-AS TOGGLE-BOX
      829   ENABLE
      830   temp-gdsscrvw.is-on
      831       WITH NO-ROW-MARKERS SEPARATORS SIZE 42 BY 6.13
      832            TITLE "Поля в экране покупателя" FIT-LAST-COLUMN.
      833   DEFINE FRAME Dialog-Frame
      834        B-exit AT ROW 1 COL 1
      835        b-quit AT ROW 1 COL 11
      836        B-Help AT ROW 1 COL 95
      837        f-dfltggrp AT ROW 3.13 COL 21 COLON-ALIGNED WIDGET-ID 22
      838        B-dfltggrp AT ROW 3.13 COL 32.5 WIDGET-ID 24
      839        f-grp-name AT ROW 3.13 COL 35 COLON-ALIGNED NO-LABEL WIDGET-ID 68
      840        t-chg-bcod AT ROW 5.91 COL 2.6 WIDGET-ID 70
      841        f-image-dir at row 12 col 2.6 widget-id 80
      842        BR-gdsscrvw AT ROW 5 COL 57 WIDGET-ID 100
      843        SPACE(0.24) SKIP(12.45)
      844       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      845            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      846            TITLE "Набор опций работы со справочниками товаров"
      847            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      848   ASSIGN
      849          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      850          FRAME Dialog-Frame:HIDDEN           = TRUE.
      851   ASSIGN
      852          f-dfltggrp:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      853   ASSIGN
      854          f-grp-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      855   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      856   DO:
      857     APPLY "END-ERROR":U TO SELF.
      858   END.
      859   ON CHOOSE OF B-dfltggrp IN FRAME Dialog-Frame
      860   DO:
      861   DEFINE VARIABLE v-grp AS INTEGER NO-UNDO.
      862   define variable v-rid-list as character no-undo .
      863   define variable glog as logical no-undo .
      864   define buffer buf_gds-grp for ub.gds-grp.
      865   IF f-dfltggrp <> -1  THEN DO:
      866     v-grp = f-dfltggrp.
      867   END.
      868   find first buf_gds-grp no-lock where
      869            buf_gds-grp.node-code = v-grp no-error.
      870   if available buf_gds-grp then do:
      871     v-rid-list = string(recid(buf_gds-grp)).
      872   end.
      873       run ref/gds-grp.w (
      874                     input parparentproc
      875                   , input ('терм':U + ',b-sel')
      876                   , input p-obj-type
      877                   , input p-obj-code
      878                   , input-output v-rid-list) NO-ERROR.
      879   IF NOT ERROR-STATUS:ERROR
      880   and v-rid-list <> '':U
      881   THEN DO:
      882     find first buf_gds-grp no-lock where
      883               recid(buf_gds-grp) = integer(v-rid-list) no-error.
      884     if available buf_gds-grp then do:
      885       f-dfltggrp = buf_gds-grp.node-code.
      886     end.
      887     RUN set-full-grp-name IN THIS-PROCEDURE ( INPUT f-dfltggrp) .
      888   END.
      889   if error-status:error
      890   or v-rid-list = '':U then do:
      891     message
      892     "Хотите УБРАТЬ ЗАДАНИЕ ГРУППЫ ПО УМОЛЧАНИЮ?"
      893     view-as alert-box question buttons yes-no update glog.
      894     if glog then do:
      895       f-dfltggrp = -1.
      896       RUN set-full-grp-name IN THIS-PROCEDURE ( INPUT f-dfltggrp) .
      897     end.
      898   end.
      899   END.
      900   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      901   DO:
      902     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      903     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      904   END.
      905   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      906   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      907   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      908   on help of frame Dialog-Frame
      909   do:
      910     run gbl/app_help.p
      911       (input this-procedure :file-name
      912       ,input ''
      913       ,input ?
      914       ) no-error.
      915     if error-status :error then do:
      916       message
      917         "Ошибка при вызове помощи"
      918         error-status :get-message(1)
      919         view-as alert-box .
      920     end.
      921   end.
      922   run minbtn-set in this-procedure .
      923   on choose of b-help in frame Dialog-Frame
      924   do:
      925     apply "help":u to frame Dialog-Frame .
      926   end.
      927   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      928   procedure minbtn-set :
      929       do
      930           on error undo, return error return-value
      931           :
      932           define variable ii              as integer       no-undo .
      933           define variable fh              as widget-handle no-undo .
      934           define variable hh              as widget-handle no-undo .
      935           define variable v-h             as handle        extent 4 no-undo .
      936           define variable v-name-button   as character     no-undo .
      937           define variable v-help-old-x    as decimal       no-undo .
      938           define variable v-help-old-y    as decimal       no-undo .
      939           define variable v-help-old-size as decimal       no-undo .
      940           define variable v-frame-width   as decimal       no-undo .
      941           define variable jj              as integer       no-undo .
      942           do
      943               on error undo, return error
      944               :
      945               assign
      946                   v-frame-width = frame Dialog-Frame:width - 0.3
      947                   fh            = frame Dialog-Frame:first-child
      948                   hh            = fh:first-child
      949                   ii            = 1
      950                   .
      951               do while valid-handle(hh):
      952                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      953                   do:
      954                       case lc(hh:name) :
      955                           when "b-help" then
      956                               do:
      957                                   hh:load-image-up("cmp/b-help.bmp":u) .
      958                                   hh:load-image-down("cmp/b-help.bmp":u) .
      959                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      960                                   hh:TOOLTIP = "Помощь" .
      961                                   v-help-old-x = hh:column .
      962                                   v-help-old-y = hh:row    .
      963                                   v-help-old-size = hh:width .
      964                                   hh:width-chars = 2.5 .
      965                               end.
      966                           when "b-print" then
      967                               do:
      968                                   hh:load-image("cmp/b-print.bmp":u) .
      969                                   hh:TOOLTIP = "Печать" .
      970                                   v-h[ii] = hh:handle .
      971                                   ii = ii + 1 .
      972                                   hh:width-chars = 3 .
      973                               end.
      974                           when "b-history" or
      975                           when "b-hist" then
      976                               do:
      977                                   hh:load-image("cmp/b-hist.bmp":u) .
      978                                   hh:TOOLTIP = "История" .
      979                                   v-h[ii] = hh:handle .
      980                                   ii = ii + 1 .
      981                                   hh:width-chars = 3 .
      982                               end.
      983                           when "b-sch" then
      984                               do:
      985                                   hh:load-image("cmp/b-sch.bmp":u) .
      986                                   hh:TOOLTIP = "Установка Фильтра" .
      987                                   v-h[ii] = hh:handle .
      988                                   ii = ii + 1 .
      989                                   hh:width-chars = 3 .
      990                               end.
      991                           when "b-hist-user" then
      992                               do:
      993                                   hh:load-image("cmp/b-hist.bmp":u) .
      994                                   hh:TOOLTIP = "История пользователя" .
      995                                   ii = ii + 1 .
      996                               end.
      997                       end case.
      998                   end.
      999                   hh = hh:next-sibling.
     1000               end.
     1001               b-help:column = v-frame-width - b-help:width-chars.
     1002               jj = 0.
     1003               repeat ii = 4 to 1 by -1 :
     1004                   if valid-handle (v-h[ii] ) then
     1005                   do:
     1006                       jj  = jj + 1 .
     1007                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1008                       v-h[ii]:row    = v-help-old-y .
     1009                   end.
     1010               end.
     1011           end.
     1012       end.
     1013   end procedure.
     1014   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1015   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1016   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1017   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1018   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1019   define variable v-diasize-current-frame-height as decimal   no-undo .
     1020   define variable v-diasize-change-size          as logical   no-undo .
     1021   define variable v-diasize-resize-button        as handle    no-undo .
     1022   define variable v-diasize-wndmax               as logical   no-undo .
     1023   define variable v-diasize-wndstore             as logical   no-undo .
     1024   define variable v-diasize-proc-name            as character no-undo .
     1025   define variable v-diasize-browse-handle        as handle    no-undo .
     1026   define variable v-diasize-browse-number        as integer   no-undo .
     1027   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1028   define temp-table temp-diasize-handle no-undo
     1029     field handle-value  as handle
     1030     field save-position as decimal
     1031     index xpk is primary unique handle-value
     1032     .
     1033   define temp-table temp-browse-handle no-undo
     1034     field browse-type   as character
     1035     field browse-number as integer
     1036     field browse-handle as handle
     1037     field original-size as decimal
     1038     index xpk is primary unique browse-type browse-number
     1039     index xie browse-type browse-handle
     1040   .
     1041   procedure diasize_change-height :
     1042     define input  parameter p-change-value  as decimal   no-undo .
     1043     define input  parameter p-move-resize   as logical   no-undo .
     1044     define variable v-field-group-handle    as handle    no-undo .
     1045     define variable v-object-handle         as handle    no-undo .
     1046     define variable v-frame-height          as decimal   no-undo .
     1047     define variable v-frame-virtual-height  as decimal   no-undo .
     1048     define variable v-browse-height         as decimal   no-undo .
     1049     define variable v-window-height         as decimal   no-undo .
     1050     define variable v-window-virtual-height as decimal   no-undo .
     1051     define variable v-change-sign           as integer   no-undo .
     1052     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1053     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1054     if p-change-value > 0
     1055     then do:
     1056       if frame Dialog-Frame :height + p-change-value
     1057           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1058       then do:
     1059         assign
     1060           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1061                           - (frame Dialog-Frame :height-chars)
     1062         .
     1063         if p-change-value <= 0
     1064         then do:
     1065           run diasize_position-resize-button in this-procedure .
     1066           return .
     1067         end.
     1068       end.
     1069     end.
     1070     if p-change-value < 0
     1071     then do:
     1072       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1073       then do:
     1074         assign
     1075           p-change-value = v-diasize-orig-frame-height
     1076                          - (frame Dialog-Frame :height-chars)
     1077         .
     1078         if p-change-value >= 0
     1079         then do:
     1080           run diasize_position-resize-button in this-procedure .
     1081           return .
     1082         end.
     1083       end.
     1084     end.
     1085     if p-change-value >= 0
     1086     then do:
     1087       assign
     1088         v-change-sign = 1
     1089       .
     1090     end.
     1091     else do:
     1092       assign
     1093         v-change-sign = -1
     1094       .
     1095     end.
     1096     assign
     1097       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1098     .
     1099     if p-change-value = 0
     1100     then do:
     1101       run diasize_position-resize-button in this-procedure .
     1102       return .
     1103     end.
     1104     move_block:
     1105     do
     1106     on error undo move_block, retry move_block
     1107     :
     1108       if retry
     1109       then do:
     1110         do
     1111         on error undo move_block, leave move_block
     1112         :
     1113           if p-change-value > 0
     1114           then do:
     1115             for each buf_temp-diasize-handle
     1116             on error undo, next
     1117             :
     1118               assign
     1119                 v-object-handle = buf_temp-diasize-handle.handle-value
     1120               .
     1121               if v-object-handle <> v-diasize-resize-button
     1122               then do:
     1123                 assign
     1124                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1125                 .
     1126               end.
     1127             end.
     1128             assign
     1129               v-diasize-browse-handle :height = v-browse-height
     1130             .
     1131             for each buf_temp-browse-handle
     1132               where buf_temp-browse-handle.browse-type = 'height':u
     1133             on error undo, next
     1134             :
     1135               assign
     1136                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1137               .
     1138             end.
     1139             assign
     1140               frame Dialog-Frame :height = v-frame-height
     1141             .
     1142             if frame Dialog-Frame :scrollable = true
     1143             then do:
     1144               assign
     1145                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1146               .
     1147             end.
     1148             run diasize_position-resize-button in this-procedure .
     1149           end.
     1150           else do:
     1151             if frame Dialog-Frame :scrollable = true
     1152             then do:
     1153               assign
     1154                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1155               .
     1156             end.
     1157             assign
     1158               frame Dialog-Frame :height = v-frame-height
     1159             .
     1160             assign
     1161               v-diasize-browse-handle :height = v-browse-height
     1162             .
     1163             for each buf_temp-browse-handle
     1164               where buf_temp-browse-handle.browse-type = 'height':u
     1165             on error undo, next
     1166             :
     1167               assign
     1168                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1169               .
     1170             end.
     1171             for each buf_temp-diasize-handle
     1172             on error undo, next
     1173             :
     1174               assign
     1175                 v-object-handle = buf_temp-diasize-handle.handle-value
     1176               .
     1177               if v-object-handle <> v-diasize-resize-button
     1178               then do:
     1179                 assign
     1180                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1181                 .
     1182               end.
     1183             end.
     1184             run diasize_position-resize-button in this-procedure .
     1185           end.
     1186           assign
     1187             v-diasize-change-size = false
     1188           .
     1189           leave move_block .
     1190         end.
     1191       end.
     1192       assign
     1193         v-diasize-need-full-display = true
     1194       .
     1195       if v-diasize-change-size = false
     1196       then do:
     1197         assign
     1198           v-diasize-change-size = true
     1199         .
     1200       end.
     1201       else do:
     1202         return .
     1203       end.
     1204       assign
     1205         v-frame-height = frame Dialog-Frame :height
     1206         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1207         v-browse-height = v-diasize-browse-handle :height
     1208       .
     1209       for each buf_temp-browse-handle
     1210         where buf_temp-browse-handle.browse-type = 'height':u
     1211       :
     1212         assign
     1213           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1214         .
     1215       end.
     1216       for each buf_temp-diasize-handle
     1217       :
     1218         delete buf_temp-diasize-handle .
     1219       end.
     1220       assign
     1221         v-field-group-handle = frame Dialog-Frame :first-child
     1222       .
     1223       do while valid-handle(v-field-group-handle)
     1224       :
     1225         assign
     1226           v-object-handle = v-field-group-handle :first-child
     1227         .
     1228         do while valid-handle(v-object-handle)
     1229         :
     1230           if  v-object-handle <> v-diasize-browse-handle :handle
     1231           and can-query(v-object-handle, "row")
     1232           and can-query(v-object-handle, "height")
     1233           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1234           then do:
     1235             find first buf_temp-browse-handle
     1236               where buf_temp-browse-handle.browse-type   = 'height':u
     1237                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1238               no-error .
     1239             if available buf_temp-browse-handle
     1240             then do:
     1241             end.
     1242             else do:
     1243               create buf_temp-diasize-handle .
     1244               assign
     1245                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1246                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1247               .
     1248             end.
     1249           end.
     1250           assign
     1251             v-object-handle = v-object-handle :next-sibling
     1252           .
     1253         end.
     1254         assign
     1255           v-field-group-handle = v-field-group-handle :next-sibling
     1256         .
     1257       end.
     1258       do with frame Dialog-Frame
     1259       :
     1260         hide v-diasize-resize-button .
     1261         assign
     1262           v-diasize-resize-button :row    = 1
     1263           v-diasize-resize-button :column = 1
     1264         .
     1265       end.
     1266       if p-change-value > 0
     1267       then do:
     1268         if frame Dialog-Frame :scrollable = true
     1269         then do:
     1270           assign
     1271             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1272             no-error .
     1273           if error-status :error
     1274           or error-status :get-message(1) <> ""
     1275           then do:
     1276             undo move_block, retry move_block .
     1277           end.
     1278         end.
     1279         assign
     1280           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1281           no-error .
     1282         if error-status :error
     1283         or error-status :get-message(1) <> ""
     1284         then do:
     1285           undo move_block, retry move_block .
     1286         end.
     1287         assign
     1288           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1289           no-error .
     1290         if error-status :error
     1291         or error-status :get-message(1) <> ""
     1292         then do:
     1293           undo move_block, retry move_block .
     1294         end.
     1295         for each buf_temp-browse-handle
     1296           where buf_temp-browse-handle.browse-type = 'height':u
     1297         on error undo move_block, retry move_block
     1298         :
     1299           assign
     1300             buf_temp-browse-handle.browse-handle :height
     1301               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1302             no-error .
     1303           if error-status :error
     1304           or error-status :get-message(1) <> ""
     1305           then do:
     1306             undo move_block, retry move_block .
     1307           end.
     1308         end.
     1309         for each buf_temp-diasize-handle
     1310         on error undo move_block, retry move_block
     1311         :
     1312           assign
     1313             v-object-handle = buf_temp-diasize-handle.handle-value
     1314           .
     1315           if v-object-handle <> v-diasize-resize-button
     1316           then do:
     1317             assign
     1318               v-object-handle :row = v-object-handle :row + p-change-value
     1319               no-error .
     1320             if error-status :error
     1321             or error-status :get-message(1) <> ""
     1322             then do:
     1323               undo move_block, retry move_block .
     1324             end.
     1325           end.
     1326         end.
     1327       end.
     1328       else do:
     1329         for each buf_temp-diasize-handle
     1330         on error undo move_block, retry move_block
     1331         :
     1332           assign
     1333             v-object-handle = buf_temp-diasize-handle.handle-value
     1334           .
     1335           if v-object-handle <> v-diasize-resize-button
     1336           then do:
     1337             assign
     1338               v-object-handle :row = v-object-handle :row + p-change-value
     1339               no-error .
     1340             if error-status :error
     1341             or error-status :get-message(1) <> ""
     1342             then do:
     1343               undo move_block, retry move_block .
     1344             end.
     1345           end.
     1346         end.
     1347         assign
     1348           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1349           no-error .
     1350         if error-status :error
     1351         or error-status :get-message(1) <> ""
     1352         then do:
     1353           undo move_block, retry move_block .
     1354         end.
     1355         for each buf_temp-browse-handle
     1356           where buf_temp-browse-handle.browse-type = 'height':u
     1357         on error undo move_block, retry move_block
     1358         :
     1359           assign
     1360             buf_temp-browse-handle.browse-handle :height
     1361               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1362             no-error .
     1363           if error-status :error
     1364           or error-status :get-message(1) <> ""
     1365           then do:
     1366             undo move_block, retry move_block .
     1367           end.
     1368         end.
     1369         assign
     1370           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1371           no-error .
     1372         if error-status :error
     1373         or error-status :get-message(1) <> ""
     1374         then do:
     1375           undo move_block, retry move_block .
     1376         end.
     1377         if frame Dialog-Frame :scrollable = true
     1378         then do:
     1379           assign
     1380             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1381             no-error .
     1382           if error-status :error
     1383           or error-status :get-message(1) <> ""
     1384           then do:
     1385             undo move_block, retry move_block .
     1386           end.
     1387         end.
     1388       end.
     1389       if p-move-resize = true
     1390       then do:
     1391         run diasize_position-resize-button in this-procedure .
     1392       end.
     1393       if v-diasize-wndstore = true
     1394       then do:
     1395         if connected("ub") = true
     1396         then do:
     1397           define variable v-cntxt-db-num        as integer   no-undo .
     1398           define variable v-cntxt-userid        as character no-undo .
     1399           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1400                                             , OUTPUT v-cntxt-userid
     1401                                             ) .
     1402           run gbl/wndsizew.p
     1403             (input  v-cntxt-db-num
     1404             ,input  v-cntxt-userid
     1405             ,input  v-diasize-proc-name
     1406             ,input  'height':u
     1407             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1408             ) .
     1409         end.
     1410       end.
     1411     end.
     1412     assign
     1413       v-diasize-change-size = false
     1414     .
     1415   end procedure.
     1416   procedure diasize_set-height :
     1417     define input  parameter p-new-height  as decimal   no-undo .
     1418     define input  parameter p-move-resize as logical   no-undo .
     1419     do
     1420     on error undo, return error return-value
     1421     :
     1422       run diasize_change-height in this-procedure
     1423         (input  (p-new-height - frame Dialog-Frame :height)
     1424         ,input  p-move-resize
     1425         ) .
     1426     end.
     1427   end procedure.
     1428   procedure diasize_change-width :
     1429     define input  parameter p-change-value as decimal   no-undo .
     1430     define input  parameter p-move-resize  as logical   no-undo .
     1431     define variable v-field-group-handle   as handle    no-undo .
     1432     define variable v-object-handle        as handle    no-undo .
     1433     define variable v-frame-width          as decimal   no-undo .
     1434     define variable v-frame-virtual-width  as decimal   no-undo .
     1435     define variable v-browse-width         as decimal   no-undo .
     1436     define variable v-window-width         as decimal   no-undo .
     1437     define variable v-window-virtual-width as decimal   no-undo .
     1438     define variable v-change-sign          as integer   no-undo .
     1439     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1440     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1441     if p-change-value > 0
     1442     then do:
     1443       if frame Dialog-Frame :width + p-change-value >
     1444           session :width-chars
     1445       then do:
     1446         assign
     1447           p-change-value = session :width-chars - frame Dialog-Frame :width
     1448         .
     1449         if p-change-value <= 0
     1450         then do:
     1451           run diasize_position-resize-button in this-procedure .
     1452           return .
     1453         end.
     1454       end.
     1455     end.
     1456     if p-change-value < 0
     1457     then do:
     1458       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1459       then do:
     1460         assign
     1461           p-change-value = v-diasize-orig-frame-width
     1462                          - frame Dialog-Frame :width
     1463         .
     1464         if p-change-value >= 0
     1465         then do:
     1466           run diasize_position-resize-button in this-procedure .
     1467           return .
     1468         end.
     1469       end.
     1470     end.
     1471     if p-change-value >= 0
     1472     then do:
     1473       assign
     1474         v-change-sign = 1
     1475       .
     1476     end.
     1477     else do:
     1478       assign
     1479         v-change-sign = -1
     1480       .
     1481     end.
     1482     assign
     1483       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1484     .
     1485     if p-change-value = 0
     1486     then do:
     1487       run diasize_position-resize-button in this-procedure .
     1488       return .
     1489     end.
     1490     move_block:
     1491     do
     1492     on error undo move_block, leave move_block
     1493     :
     1494       if retry
     1495       then do:
     1496         do
     1497         on error undo move_block, leave move_block
     1498         :
     1499           if p-change-value > 0
     1500           then do:
     1501             for each buf_temp-diasize-handle
     1502             on error undo, next
     1503             :
     1504               assign
     1505                 v-object-handle = buf_temp-diasize-handle.handle-value
     1506               .
     1507               if v-object-handle <> v-diasize-resize-button
     1508               then do:
     1509                 assign
     1510                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1511                 .
     1512               end.
     1513             end.
     1514             assign
     1515               v-diasize-browse-handle :width = v-browse-width
     1516             .
     1517             for each buf_temp-browse-handle
     1518               where buf_temp-browse-handle.browse-type = 'width':u
     1519             on error undo, next
     1520             :
     1521               assign
     1522                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1523               .
     1524             end.
     1525             assign
     1526               frame Dialog-Frame :width = v-frame-width
     1527             .
     1528             if frame Dialog-Frame :scrollable = true
     1529             then do:
     1530               assign
     1531                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1532               .
     1533             end.
     1534             run diasize_position-resize-button in this-procedure .
     1535           end.
     1536           else do:
     1537             if frame Dialog-Frame :scrollable = true
     1538             then do:
     1539               assign
     1540                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1541               .
     1542             end.
     1543             assign
     1544               frame Dialog-Frame :width = v-frame-width
     1545             .
     1546             for each buf_temp-browse-handle
     1547               where buf_temp-browse-handle.browse-type = 'width':u
     1548             on error undo, next
     1549             :
     1550               assign
     1551                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1552               .
     1553             end.
     1554             assign
     1555               v-diasize-browse-handle :width = v-browse-width
     1556             .
     1557             for each buf_temp-diasize-handle
     1558             on error undo, next
     1559             :
     1560               assign
     1561                 v-object-handle = buf_temp-diasize-handle.handle-value
     1562               .
     1563               if v-object-handle <> v-diasize-resize-button
     1564               then do:
     1565                 assign
     1566                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1567                 .
     1568               end.
     1569             end.
     1570             run diasize_position-resize-button in this-procedure .
     1571           end.
     1572           assign
     1573             v-diasize-change-size = false
     1574           .
     1575           leave move_block .
     1576         end.
     1577       end.
     1578       assign
     1579         v-diasize-need-full-display = true
     1580       .
     1581       if v-diasize-change-size = false
     1582       then do:
     1583         assign
     1584           v-diasize-change-size = true
     1585         .
     1586       end.
     1587       else do:
     1588         return .
     1589       end.
     1590       assign
     1591         v-frame-width = frame Dialog-Frame :width
     1592         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1593         v-browse-width = v-diasize-browse-handle :width
     1594       .
     1595       for each buf_temp-browse-handle
     1596         where buf_temp-browse-handle.browse-type = 'width':u
     1597       :
     1598         assign
     1599           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1600         .
     1601       end.
     1602       for each buf_temp-diasize-handle
     1603       :
     1604         delete buf_temp-diasize-handle .
     1605       end.
     1606       assign
     1607         v-field-group-handle = frame Dialog-Frame :first-child
     1608       .
     1609       do while valid-handle(v-field-group-handle)
     1610       :
     1611         assign
     1612           v-object-handle = v-field-group-handle :first-child
     1613         .
     1614         do while valid-handle(v-object-handle)
     1615         :
     1616           if  v-object-handle <> v-diasize-browse-handle :handle
     1617           and v-object-handle <> v-diasize-resize-button
     1618           and can-query(v-object-handle, "row")
     1619           and can-query(v-object-handle, "height")
     1620           and ( v-object-handle :col + v-object-handle :width
     1621                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1622               )
     1623           then do:
     1624             find first buf_temp-browse-handle
     1625               where buf_temp-browse-handle.browse-type   = 'width':u
     1626                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1627               no-error .
     1628             if available buf_temp-browse-handle
     1629             then do:
     1630             end.
     1631             else do:
     1632               create buf_temp-diasize-handle .
     1633               assign
     1634                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1635                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1636               .
     1637             end.
     1638           end.
     1639           assign
     1640             v-object-handle = v-object-handle :next-sibling
     1641           .
     1642         end.
     1643         assign
     1644           v-field-group-handle = v-field-group-handle :next-sibling
     1645         .
     1646       end.
     1647       do with frame Dialog-Frame
     1648       :
     1649         hide v-diasize-resize-button .
     1650         v-diasize-resize-button :row = 1.
     1651         v-diasize-resize-button :column = 1.
     1652       end.
     1653       if p-change-value > 0
     1654       then do:
     1655         if frame Dialog-Frame :scrollable = true
     1656         then do:
     1657           assign
     1658             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1659             no-error .
     1660           if error-status :error
     1661           or error-status :get-message(1) <> ""
     1662           then do:
     1663             undo move_block, retry move_block.
     1664           end.
     1665         end.
     1666         assign
     1667           frame Dialog-Frame :width = v-frame-width + p-change-value
     1668           no-error .
     1669         if error-status :error
     1670         or error-status :get-message(1) <> ""
     1671         then do:
     1672           undo move_block, retry move_block.
     1673         end.
     1674         assign
     1675           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1676         no-error .
     1677         if error-status :error
     1678         or error-status :get-message(1) <> ""
     1679         then do:
     1680           undo move_block, retry move_block.
     1681         end.
     1682         for each buf_temp-browse-handle
     1683           where buf_temp-browse-handle.browse-type = 'width':u
     1684         on error undo move_block, retry move_block
     1685         :
     1686           assign
     1687             buf_temp-browse-handle.browse-handle :width
     1688               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1689             no-error .
     1690           if error-status :error
     1691           or error-status :get-message(1) <> ""
     1692           then do:
     1693             undo move_block, retry move_block .
     1694           end.
     1695         end.
     1696         for each buf_temp-diasize-handle
     1697         on error undo move_block, retry move_block
     1698         :
     1699           assign
     1700             v-object-handle = buf_temp-diasize-handle.handle-value
     1701           .
     1702           if v-object-handle <> v-diasize-resize-button
     1703           then do:
     1704             assign
     1705               v-object-handle :col = v-object-handle :col + p-change-value
     1706               no-error .
     1707             if error-status :error
     1708             or error-status :get-message(1) <> ""
     1709             then do:
     1710               undo move_block, retry move_block .
     1711             end.
     1712           end.
     1713         end.
     1714       end.
     1715       else do:
     1716         for each buf_temp-diasize-handle
     1717         on error undo move_block, retry move_block
     1718         :
     1719           assign
     1720             v-object-handle = buf_temp-diasize-handle.handle-value
     1721           .
     1722           if v-object-handle <> v-diasize-resize-button
     1723           then do:
     1724             assign
     1725               v-object-handle :col = v-object-handle :col + p-change-value
     1726               no-error .
     1727             if error-status :error
     1728             or error-status :get-message(1) <> ""
     1729             then do:
     1730               undo move_block, retry move_block .
     1731             end.
     1732           end.
     1733         end.
     1734         for each buf_temp-browse-handle
     1735           where buf_temp-browse-handle.browse-type = 'width':u
     1736         on error undo move_block, retry move_block
     1737         :
     1738           assign
     1739             buf_temp-browse-handle.browse-handle :width
     1740               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1741             no-error .
     1742           if error-status :error
     1743           or error-status :get-message(1) <> ""
     1744           then do:
     1745             undo move_block, retry move_block .
     1746           end.
     1747         end.
     1748         assign
     1749           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1750           no-error .
     1751         if error-status :error
     1752         or error-status :get-message(1) <> ""
     1753         then do:
     1754           undo move_block, retry move_block.
     1755         end.
     1756         assign
     1757           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1758         no-error .
     1759         if error-status :error
     1760         or error-status :get-message(1) <> ""
     1761         then do:
     1762           undo move_block, retry move_block.
     1763         end.
     1764         if frame Dialog-Frame :scrollable = true
     1765         then do:
     1766           assign
     1767             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1768           no-error .
     1769           if error-status :error
     1770           or error-status :get-message(1) <> ""
     1771           then do:
     1772             undo move_block, retry move_block.
     1773           end.
     1774         end.
     1775       end.
     1776       if p-move-resize
     1777       then do:
     1778         run diasize_position-resize-button in this-procedure .
     1779       end.
     1780       if v-diasize-wndstore = true
     1781       then do:
     1782         if connected("ub") = true
     1783         then do:
     1784           define variable v-cntxt-db-num        as integer   no-undo .
     1785           define variable v-cntxt-userid        as character no-undo .
     1786           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1787                                             , OUTPUT v-cntxt-userid
     1788                                             ) .
     1789           run gbl/wndsizew.p
     1790             (input  v-cntxt-db-num
     1791             ,input  v-cntxt-userid
     1792             ,input  v-diasize-proc-name
     1793             ,input  'width':u
     1794             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1795             ) .
     1796         end.
     1797       end.
     1798     end.
     1799     assign
     1800       v-diasize-change-size = false
     1801     .
     1802   end procedure.
     1803   procedure diasize_set-width :
     1804     define input  parameter p-new-width  as decimal   no-undo .
     1805     define input  parameter p-move-resize as logical   no-undo .
     1806     do
     1807     on error undo, return error return-value
     1808     :
     1809       run diasize_change-width in this-procedure
     1810         (input  (p-new-width - frame Dialog-Frame :width)
     1811         ,input  p-move-resize
     1812         ) .
     1813     end.
     1814   end procedure.
     1815   procedure diasize_position-resize-button :
     1816     do with frame Dialog-Frame
     1817     :
     1818       hide v-diasize-resize-button .
     1819       assign
     1820         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1821                     - 1
     1822                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1823         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1824                     - 1
     1825                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1826       .
     1827       view v-diasize-resize-button .
     1828     end.
     1829   end procedure.
     1830   on alt-right anywhere
     1831   do:
     1832     run diasize_change-width in this-procedure
     1833       (input 1
     1834       ,input true
     1835       ) .
     1836     return no-apply .
     1837   end.
     1838   on alt-left anywhere
     1839   do:
     1840     run diasize_change-width in this-procedure
     1841       (input -1
     1842       ,input true
     1843       ) .
     1844     return no-apply .
     1845   end.
     1846   on alt-down anywhere
     1847   do:
     1848     run diasize_change-height in this-procedure
     1849       (input 1
     1850       ,input true
     1851       ) .
     1852     return no-apply .
     1853   end.
     1854   on alt-up anywhere
     1855   do:
     1856     run diasize_change-height in this-procedure
     1857       (input -1
     1858       ,input true
     1859       ) .
     1860     return no-apply .
     1861   end.
     1862   on alt-enter of frame Dialog-Frame
     1863   do:
     1864     run diasize_maximize in this-procedure
     1865       (input  ?
     1866       ).
     1867     return no-apply .
     1868   end.
     1869   procedure diasize_end-move :
     1870     do
     1871     on error undo, return error return-value
     1872     :
     1873       define variable v-row-delta as decimal   no-undo .
     1874       define variable v-col-delta as decimal   no-undo .
     1875       define variable v-new-row as decimal   no-undo .
     1876       define variable v-new-col as decimal   no-undo .
     1877       assign
     1878         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1879         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1880       .
     1881       assign
     1882         v-row-delta = v-new-row - frame Dialog-Frame :height
     1883         v-col-delta = v-new-col - frame Dialog-Frame :width
     1884       .
     1885       run diasize_change-height in this-procedure
     1886         (input v-row-delta
     1887         ,input true
     1888         ) .
     1889       run diasize_change-width in this-procedure
     1890         (input v-col-delta
     1891         ,input true
     1892         ) .
     1893     end.
     1894   end procedure.
     1895   procedure diasize_maximize :
     1896     define input  parameter p-action as logical   no-undo .
     1897     do
     1898     on error undo, return error return-value
     1899     :
     1900       if p-action = ?
     1901       then do:
     1902         if v-diasize-need-maximize = true
     1903         then do:
     1904           assign
     1905             p-action = true
     1906           .
     1907         end.
     1908         else do:
     1909           assign
     1910             p-action = false
     1911           .
     1912         end.
     1913       end.
     1914       if p-action = true
     1915       then do:
     1916         run diasize_change-height in this-procedure
     1917           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1918               - frame Dialog-Frame :height-chars
     1919           ,input true
     1920           ) .
     1921         run diasize_change-width in this-procedure
     1922           (input session :width-chars
     1923               - frame Dialog-Frame :width-chars
     1924           ,input true
     1925           ) .
     1926         assign
     1927           v-diasize-need-maximize = false
     1928         .
     1929       end.
     1930       else do:
     1931         run diasize_change-width in this-procedure
     1932           (input v-diasize-orig-frame-width
     1933               - frame Dialog-Frame :width-chars
     1934           ,input true
     1935           ) .
     1936         run diasize_change-height in this-procedure
     1937           (input v-diasize-orig-frame-height
     1938               - frame Dialog-Frame :height-chars
     1939           ,input true
     1940           ) .
     1941         assign
     1942           v-diasize-need-maximize = true
     1943         .
     1944       end.
     1945     end.
     1946   end procedure.
     1947   procedure diasize_restore-orig-size :
     1948     do
     1949     on error undo, return error return-value
     1950     :
     1951       assign
     1952         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1953         v-diasize-current-frame-height = frame Dialog-Frame :height
     1954       .
     1955       run diasize_set-height in this-procedure
     1956         (input  v-diasize-orig-frame-height
     1957         ,input  true
     1958         ) .
     1959       run diasize_set-width in this-procedure
     1960         (input  v-diasize-orig-frame-width
     1961         ,input  true
     1962         ) .
     1963     end.
     1964   end procedure.
     1965   procedure diasize_restore-current-size :
     1966     do
     1967     on error undo, return error return-value
     1968     :
     1969       run diasize_set-height in this-procedure
     1970         (input  v-diasize-current-frame-height
     1971         ,input  true
     1972         ) .
     1973       run diasize_set-width in this-procedure
     1974         (input  v-diasize-current-frame-width
     1975         ,input  true
     1976         ) .
     1977     end.
     1978   end procedure.
     1979   procedure diasize_set-browse-handle :
     1980     define input  parameter p-browse-handle as handle   no-undo .
     1981     define buffer buf_temp-browse-handle for temp-browse-handle .
     1982     do
     1983     on error undo, return error return-value
     1984     :
     1985       assign
     1986         v-diasize-browse-handle = p-browse-handle
     1987       .
     1988       for each buf_temp-browse-handle
     1989       on error undo, return error return-value
     1990       :
     1991         delete buf_temp-browse-handle .
     1992       end.
     1993     end.
     1994   end procedure.
     1995   procedure diasize_add_browse :
     1996     define input  parameter p-browse-type   as character no-undo .
     1997     define input  parameter p-browse-handle as handle    no-undo .
     1998     define buffer buf_temp-browse-handle for temp-browse-handle .
     1999     do
     2000     on error undo, return error return-value
     2001     :
     2002       assign
     2003         v-diasize-browse-number = v-diasize-browse-number + 1
     2004       .
     2005       create buf_temp-browse-handle .
     2006       assign
     2007         buf_temp-browse-handle.browse-type   = p-browse-type
     2008         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2009         buf_temp-browse-handle.browse-handle = p-browse-handle
     2010       .
     2011     end.
     2012   end procedure.
     2013   procedure diasize_init :
     2014     define variable v-default-value    as logical   no-undo .
     2015     define variable v-restore-saved    as logical   no-undo .
     2016     define variable v-resize-value-str as character no-undo .
     2017     do
     2018     on error undo, return error return-value
     2019     :
     2020       do with frame Dialog-Frame
     2021       :
     2022         assign
     2023           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2024           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2025           v-diasize-browse-handle     = browse BR-gdsscrvw :handle
     2026         .
     2027         create button v-diasize-resize-button
     2028         assign
     2029           parent        = frame Dialog-Frame :first-child
     2030           label         = "s"
     2031           height-pixels = 16
     2032           width-pixels  = 16
     2033           visible       = true
     2034           sensitive     = true
     2035           movable       = true
     2036           triggers:
     2037             on end-move persistent run diasize_end-move in this-procedure .
     2038           end triggers.
     2039         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2040         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2041         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2042         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2043         assign
     2044           v-diasize-wndmax = false
     2045         .
     2046         if connected("ub") = true
     2047         then do:
     2048           define variable v-cntxt-db-num        as integer   no-undo .
     2049           define variable v-cntxt-userid        as character no-undo .
     2050           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2051                                             , OUTPUT v-cntxt-userid
     2052                                             ) .
     2053           run gbl/wndpar_r.p
     2054             (input  v-cntxt-db-num
     2055             ,input  v-cntxt-userid
     2056             ,input  'wndmax':U
     2057             ,output v-diasize-wndmax
     2058             ,output v-default-value
     2059             ) .
     2060         end.
     2061         assign
     2062           v-diasize-wndstore = false
     2063         .
     2064         if connected("ub") = true
     2065         then do:
     2066           run gbl/wndpar_r.p
     2067             (input  v-cntxt-db-num
     2068             ,input  v-cntxt-userid
     2069             ,input  'wndstore':U
     2070             ,output v-diasize-wndstore
     2071             ,output v-default-value
     2072             ) .
     2073         end.
     2074         assign
     2075           v-diasize-proc-name = entry(1, program-name(2), '.')
     2076         .
     2077         if v-diasize-wndstore = true
     2078         then do:
     2079           assign
     2080             v-restore-saved = false
     2081           .
     2082           if connected("ub") = true
     2083           then do:
     2084             run gbl/wndsizer.p
     2085               (input  v-cntxt-db-num
     2086               ,input  v-cntxt-userid
     2087               ,input  v-diasize-proc-name
     2088               ,input  'height':u
     2089               ,output v-resize-value-str
     2090               ) .
     2091             if v-resize-value-str <> '':U
     2092             then do:
     2093               run diasize_change-height in this-procedure
     2094                 (input  integer(v-resize-value-str)
     2095                 ,input  true
     2096                 ) .
     2097               assign
     2098                 v-restore-saved = true
     2099               .
     2100             end.
     2101           end.
     2102           if connected("ub") = true
     2103           then do:
     2104             run gbl/wndsizer.p
     2105               (input  v-cntxt-db-num
     2106               ,input  v-cntxt-userid
     2107               ,input  v-diasize-proc-name
     2108               ,input  'width':u
     2109               ,output v-resize-value-str
     2110               ) .
     2111             if v-resize-value-str <> '':U
     2112             then do:
     2113               run diasize_change-width in this-procedure
     2114                 (input  integer(v-resize-value-str)
     2115                 ,input  true
     2116                 ) .
     2117               assign
     2118                 v-restore-saved = true
     2119               .
     2120             end.
     2121           end.
     2122           if v-restore-saved <> true
     2123           then do:
     2124             if v-diasize-wndmax = true
     2125             then do:
     2126               run diasize_maximize in this-procedure
     2127                 (input  true
     2128                 ) .
     2129             end.
     2130           end.
     2131         end.
     2132         else do:
     2133           if v-diasize-wndmax = true
     2134           then do:
     2135             run diasize_maximize in this-procedure
     2136               (input  true
     2137               ) .
     2138           end.
     2139         end.
     2140       end.
     2141     end.
     2142   end procedure.
     2143   procedure diasize_need-full-display :
     2144     define output parameter p-need-full-display as logical   no-undo .
     2145     do
     2146     on error undo, return error return-value
     2147     :
     2148       assign
     2149         p-need-full-display = v-diasize-need-full-display
     2150       .
     2151       assign
     2152         v-diasize-need-full-display = false
     2153       .
     2154     end.
     2155   end procedure.
     2156   procedure get-context :
     2157      define output parameter p-db-num as integer          no-undo.
     2158      define output parameter p-user-id as character        no-undo.
     2159      define variable v-login               as character    no-undo.
     2160      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2161      define buffer buf_user-login  for ub.user-login .
     2162      do
     2163      on error undo, return error
     2164      :
     2165            FIND FIRST buf_sys-ctrl no-lock.
     2166            ASSIGN
     2167               v-login = USERID("ub")
     2168               p-db-num = buf_sys-ctrl.db-num
     2169            .
     2170            FIND FIRST buf_user-login
     2171                 WHERE buf_user-login.db-num = p-db-num
     2172                   AND buf_user-login.user-login = v-login
     2173                 no-lock
     2174                 no-error
     2175                 .
     2176            IF AVAILABLE buf_user-login
     2177            THEN DO:
     2178               assign
     2179                  p-user-id = buf_user-login.user-id
     2180               .
     2181            END.
     2182      end.
     2183   end procedure.
     2184       run diasize_init in this-procedure .
     2185   ON value-changed OF temp-gdsscrvw.is-on IN BROWSE br-gdsscrvw DO:
     2186   DEFINE BUFFER buf_temp-gdsscrvw FOR temp-gdsscrvw.
     2187   if not avail temp-gdsscrvw then return no-apply.
     2188   FIND FIRST buf_temp-gdsscrvw WHERE RECID(buf_temp-gdsscrvw) = RECID(temp-gdsscrvw).
     2189   ASSIGN
     2190   buf_temp-gdsscrvw.is-on = LOGICAL(temp-gdsscrvw.is-on:SCREEN-VALUE IN BROWSE br-gdsscrvw).
     2191   end.
     2192   MAIN-BLOCK:
     2193   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2194      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2195   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2196     run mainmenu_getcntxt in parparentproc
     2197       (output v-cntxt-db-num
     2198       ,output v-cntxt-userid
     2199       ,output v-cntxt-level
     2200       ,output v-cntxt-host-code-obj
     2201       ,output v-cntxt-obj-type
     2202       ,output v-cntxt-obj-code
     2203       ,output v-cntxt-db-num-obj
     2204       ,output v-cntxt-is-admin
     2205       ) .
     2206   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2207   ON TAB ANYWHERE
     2208   DO:
     2209   define variable ii as integer no-undo .
     2210   define variable fh as widget-handle no-undo .
     2211   define variable hh as widget-handle no-undo .
     2212   define variable v-next-widget-name as character no-undo .
     2213   if v-tab-order <> '' then do:
     2214     if self:type = "TOGGLE-BOX" then
     2215     self:BGCOLOR = ?.
     2216     assign
     2217     ii = lookup(self:name, v-tab-order).
     2218     assign
     2219     ii = ii + 1
     2220     v-next-widget-name = entry(ii, v-tab-order)
     2221     no-error .
     2222     if error-status:error then do:
     2223       assign
     2224       ii = 1
     2225       v-next-widget-name = entry( ii, v-tab-order)
     2226       .
     2227     end.
     2228     assign
     2229     fh = frame Dialog-Frame:first-child
     2230     hh = fh:first-child
     2231     .
     2232     do while valid-handle(hh):
     2233       if hh:name = v-next-widget-name then do:
     2234         if hh:sensitive  = yes
     2235         AND hh:visible = yes then do:
     2236           if hh:type = "TOGGLE-BOX":U then do:
     2237             assign
     2238             hh:BGcolor = 1
     2239             .
     2240           end.
     2241           APPLY "ENTRY" to hh.
     2242           return no-apply.
     2243         end.
     2244         else do:
     2245           APPLY "TAB" to hh.
     2246           return no-apply.
     2247         end.
     2248       end.
     2249       hh = hh:next-sibling.
     2250     end.
     2251   end.
     2252   END.
     2253   ON BACK-TAB ANYWHERE
     2254   DO:
     2255   define variable ii as integer no-undo .
     2256   define variable fh as widget-handle no-undo .
     2257   define variable hh as widget-handle no-undo .
     2258   define variable v-next-widget-name as character no-undo .
     2259   if v-tab-order <> '' then do:
     2260     assign
     2261     ii = lookup(self:name, v-tab-order).
     2262     .
     2263     assign
     2264     ii = (if ii = 1
     2265           then  num-entries(v-tab-order)
     2266           else ii - 1
     2267           )
     2268     v-next-widget-name = entry(ii, v-tab-order)
     2269     .
     2270     assign
     2271     fh = frame Dialog-Frame:first-child
     2272     hh = fh:first-child
     2273     .
     2274     do while valid-handle(hh):
     2275       if hh:name = v-next-widget-name then do:
     2276         if hh:sensitive  = yes
     2277         AND hh:visible = yes then do:
     2278           if hh:type = "TOGGLE-BOX":U then do:
     2279             assign
     2280             hh:BGcolor = 1
     2281             .
     2282           end.
     2283           APPLY "ENTRY" to hh.
     2284           return no-apply.
     2285         end.
     2286         else do:
     2287         APPLY "BACK-TAB" to hh.
     2288         return no-apply.
     2289         end.
     2290       end.
     2291       hh = hh:next-sibling.
     2292     end.
     2293     end.
     2294   END.
     2295   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2296   ON RETURN ANYWHERE
     2297   DO:
     2298   define variable ii as integer no-undo .
     2299   define variable fh as widget-handle no-undo .
     2300   define variable hh as widget-handle no-undo .
     2301   define variable v-next-widget-name as character no-undo .
     2302     if v-tab-order <> '' then do:
     2303       assign
     2304       ii = lookup(self:name, v-tab-order).
     2305       if ii = num-entries(v-tab-order) then do:
     2306           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     2307           return no-apply.
     2308       end.
     2309       if self:type <> "BUTTON" and
     2310         self:type <> "EDITOR"  then do:
     2311         run proc-move-forward in this-procedure .
     2312         return no-apply.
     2313       end.
     2314       if self:type = "BUTTON" then do:
     2315         APPLY "CHOOSE" to self.
     2316       end.
     2317       if self:type = "TOGGLE-BOX" then
     2318       self:BGCOLOR = ?.
     2319       assign
     2320       ii = ii + 1
     2321       v-next-widget-name = entry(ii, v-tab-order)
     2322       no-error .
     2323       if error-status:error then do:
     2324         assign
     2325         ii = 1
     2326         v-next-widget-name = entry( ii, v-tab-order)
     2327         .
     2328       end.
     2329       assign
     2330       fh = frame Dialog-Frame:first-child
     2331       hh = fh:first-child
     2332       .
     2333       do while valid-handle(hh):
     2334         if hh:name = v-next-widget-name then do:
     2335           if hh:sensitive  = yes
     2336           AND hh:visible = yes then do:
     2337             if hh:type = "TOGGLE-BOX":U then do:
     2338               assign
     2339               hh:BGcolor = 1
     2340               .
     2341             end.
     2342             APPLY "ENTRY" to hh.
     2343             return no-apply.
     2344           end.
     2345           else do:
     2346             APPLY "TAB" to hh.
     2347             return no-apply.
     2348           end.
     2349         end.
     2350         hh = hh:next-sibling.
     2351       end.
     2352     end.
     2353   END.
     2354   procedure proc-move-forward :
     2355   define variable ii as integer no-undo .
     2356   define variable fh as widget-handle no-undo .
     2357   define variable hh as widget-handle no-undo .
     2358   define variable v-next-widget-name as character no-undo .
     2359   do
     2360   on error undo, return error
     2361   :
     2362     if v-tab-order <> '' then do:
     2363       if self:type = "TOGGLE-BOX" then
     2364       self:BGCOLOR = ?.
     2365       assign
     2366       ii = lookup(self:name, v-tab-order).
     2367       assign
     2368       ii = ii + 1
     2369       v-next-widget-name = entry(ii, v-tab-order)
     2370       no-error .
     2371       if error-status:error then do:
     2372         assign
     2373         ii = 1
     2374         v-next-widget-name = entry( ii, v-tab-order)
     2375         .
     2376       end.
     2377       assign
     2378       fh = frame Dialog-Frame:first-child
     2379       hh = fh:first-child
     2380       .
     2381       do while valid-handle(hh):
     2382         if hh:name = v-next-widget-name then do:
     2383           if hh:sensitive  = yes
     2384           AND hh:visible = yes then do:
     2385             if hh:type = "TOGGLE-BOX":U then do:
     2386               assign
     2387               hh:BGcolor = 1
     2388               .
     2389             end.
     2390             APPLY "ENTRY" to hh.
     2391             return.
     2392           end.
     2393           else do:
     2394             assign
     2395             ii = ii + 1
     2396             v-next-widget-name = entry(ii, v-tab-order)
     2397             no-error .
     2398             if error-status:error then do:
     2399               assign
     2400               ii = 1
     2401               v-next-widget-name = entry( ii, v-tab-order)
     2402               .
     2403             end.
     2404           end.
     2405         end.
     2406         hh = hh:next-sibling.
     2407       end.
     2408     end.
     2409   end.
     2410   end procedure.
     2411     IF p-mode <> 'ПРОСМОТР':U
     2412     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     2413         MESSAGE
     2414         vss-workfile vss-revision vss-description skip
     2415         "Неверное значение параметра p-mode" p-mode
     2416         VIEW-AS ALERT-BOX ERROR.
     2417         UNDO, RETURN ERROR.
     2418     END.
     2419     IF p-obj-type <> 'маг':U
     2420     and p-obj-type <> 'скл':U
     2421     THEN DO:
     2422         MESSAGE
     2423         vss-workfile vss-revision vss-description skip
     2424         "Неверное значение параметра p-obj-type" p-obj-type
     2425         VIEW-AS ALERT-BOX ERROR.
     2426         UNDO, RETURN ERROR.
     2427     END.
     2428     if p-obj-type = 'маг':U then do:
     2429       FIND FIRST X_shop NO-LOCK WHERE X_shop.obj-code = p-obj-code NO-ERROR.
     2430       IF NOT AVAILABLE X_shop THEN DO:
     2431           MESSAGE
     2432           vss-workfile vss-revision vss-description skip
     2433           "Неверное значение параметра p-obj-code" p-obj-code
     2434           VIEW-AS ALERT-BOX ERROR.
     2435           UNDO, RETURN ERROR.
     2436       END.
     2437   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2438   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2439     (input  'маг':U
     2440     ,input  p-obj-code
     2441     ,output v-db-num
     2442     )  .
     2443       IF v-db-num <> v-cntxt-db-num
     2444       AND v-cntxt-db-num <> 0
     2445       and p-mode <> 'ПРОСМОТР':U
     2446       THEN DO:
     2447           MESSAGE
     2448           "Нельзя менять параметры магазина в чужой БД" skip
     2449           "магазин принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     2450           VIEW-AS ALERT-BOX ERROR.
     2451           UNDO, RETURN ERROR.
     2452       END.
     2453     end.
     2454     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     2455       FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
     2456                 LOCKED_thbj-attr.obj-type = p-obj-type
     2457           AND   LOCKED_thbj-attr.obj-code = p-obj-code
     2458           AND   LOCKED_thbj-attr.upper-prop-code = 'gds-ref_obj':U
     2459           AND LOCKED_thbj-attr.prop-code = "":U
     2460           NO-WAIT NO-ERROR.
     2461        if locked locked_thbj-attr then do:
     2462           message
     2463           vss-workfile vss-revision vss-description skip
     2464            "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
     2465           view-as alert-box error .
     2466           undo, return error.
     2467         end.
     2468     END.
     2469     ELSE DO:
     2470         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
     2471             LOCKED_thbj-attr.obj-type = p-obj-type
     2472       AND   LOCKED_thbj-attr.obj-code = p-obj-code
     2473       AND   LOCKED_thbj-attr.upper-prop-code = 'gds-ref_obj':U
     2474       AND   LOCKED_thbj-attr.prop-code = '':U NO-ERROR.
     2475     END.
     2476     if not available locked_thbj-attr then do:
     2477       ASSIGN
     2478       v-to-create  = YES.
     2479       message
     2480       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     2481                   chr(10))
     2482       view-as alert-box WARNING.
     2483     end.
     2484     RUN FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     2485     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     2486     RUN Myenable in this-procedure .
     2487     WAIT-FOR GO OF FRAME Dialog-Frame.
     2488   END.
     2489   RUN disable_UI.
     2490   PROCEDURE disable_UI :
     2491     HIDE FRAME Dialog-Frame.
     2492   END PROCEDURE.
     2493   PROCEDURE enable_UI :
     2494     DISPLAY f-dfltggrp f-grp-name t-chg-bcod f-image-dir
     2495         WITH FRAME Dialog-Frame.
     2496     ENABLE B-exit b-quit B-Help B-dfltggrp t-chg-bcod BR-gdsscrvw f-image-dir
     2497         WITH FRAME Dialog-Frame.
     2498     VIEW FRAME Dialog-Frame.
     2499     OPEN QUERY br-gdsscrvw FOR EACH temp-gdsscrvw.
     2500   END PROCEDURE.
     2501   PROCEDURE fill-widgets :
     2502   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     2503   DEFINE VARIABLE v-entry AS CHARACTER NO-UNDO.
     2504   define variable v-param-type as character no-undo .
     2505   define variable v-value-character as character no-undo .
     2506   define variable v-value-date as date no-undo .
     2507   define variable v-value-decimal as decimal no-undo .
     2508   define variable v-value-integer as INTEGER no-undo .
     2509   define variable v-value-logical AS LOGICAL no-undo .
     2510   DEFINE VARIABLE v-gds-copy-list AS CHARACTER NO-UNDO.
     2511   DEFINE VARIABLE v-gdsreffi-list AS CHARACTER NO-UNDO.
     2512   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     2513   define variable attr-label as character no-undo .
     2514   define variable attr-user-can-edit as logical no-undo .
     2515   define variable attr-output-display as logical no-undo .
     2516   define variable attr-other as char no-undo .
     2517   define variable attr-value as char no-undo .
     2518   define variable v-db as logical   no-undo .
     2519   define variable v-host as logical no-undo .
     2520   define variable v-shop as logical no-undo .
     2521   define variable v-store as logical no-undo .
     2522   define variable v-global as logical no-undo .
     2523   define variable v-need-prop-list as character no-undo .
     2524   define variable v-prop-type-list as character no-undo .
     2525   define variable v-prop-label-list as character no-undo .
     2526   FOR EACH thbjattr_thbj-attr:
     2527     delete thbjattr_thbj-attr.
     2528   end.
     2529   FOR EACH temp-thbj-attr:
     2530     delete temp-thbj-attr.
     2531   end.
     2532   run thbjattr_code in this-procedure (
     2533      input  'gds-ref_obj':U
     2534     ,input ''
     2535     ,output attr-label
     2536     ,output attr-user-can-edit
     2537     ,output attr-output-display
     2538     ,output attr-other
     2539     ,output v-need-prop-list
     2540     ,output v-prop-type-list
     2541     ,output v-prop-label-list
     2542     ,output v-global
     2543     ,output v-host
     2544     ,output v-shop
     2545     ,output v-store
     2546     ,output v-db
     2547     ) no-error .
     2548   run adm/shattri.p (
     2549                 input "init":U
     2550               , input p-obj-type
     2551               , input p-obj-code
     2552               , input 'gds-ref_obj':U
     2553               , input "":U
     2554               , output v-value-character
     2555               , output v-value-date
     2556               , output v-value-decimal
     2557               , output v-value-integer
     2558               , output v-value-logical
     2559               , output v-param-type
     2560               , INPUT-OUTPUT table-handle v-tth
     2561               ) no-error .
     2562   if error-status:error
     2563   and not available locked_thbj-attr then do:
     2564     message
     2565     "Не удалось получить начальные значения настроек" skip
     2566     error-status:get-message(1) return-value
     2567     view-as alert-box error .
     2568     undo, return error .
     2569   end.
     2570   FOR EACH thbjattr_thbj-attr:
     2571     if lookup(thbjattr_thbj-attr.prop-code, v-need-prop-list) = 0 then do:
     2572       delete thbjattr_thbj-attr.
     2573       next.
     2574     end.
     2575     ASSIGN
     2576     v-entry = thbjattr_thbj-attr.prop-code.
     2577     IF v-entry = 'dfltggrp':U THEN DO:
     2578       ASSIGN
     2579       f-dfltggrp = thbjattr_thbj-attr.property-value-integer
     2580       f-dfltggrp:private-data IN FRAME Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2581       .
     2582       RUN set-full-grp-name IN THIS-PROCEDURE ( INPUT f-dfltggrp) .
     2583     END.
     2584     IF v-entry = 'chg-bcod':U THEN DO:
     2585       ASSIGN
     2586       t-chg-bcod = thbjattr_thbj-attr.property-value-logical
     2587       t-chg-bcod:private-data IN FRAME Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2588       .
     2589     END.
     2590     IF v-entry = 'gdsscrvw':U THEN DO:
     2591       ASSIGN
     2592       v-gdsscrvw = thbjattr_thbj-attr.property-value-character
     2593       .
     2594     END.
     2595     IF v-entry = 'image-dir':U THEN DO:
     2596       ASSIGN
     2597       f-image-dir = thbjattr_thbj-attr.property-value-character
     2598       f-image-dir:private-data IN FRAME Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2599       .
     2600     END.
     2601     create temp-thbj-attr.
     2602     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     2603   END.
     2604   END PROCEDURE.
     2605   PROCEDURE MyEnable :
     2606   DEFINE BUFFER buf_custom-labels FOR ub.custom-labels.
     2607   DEFINE BUFFER buf_temp-gdsscrvw FOR temp-gdsscrvw.
     2608   FOR EACH buf_custom-labels NO-LOCK WHERE
     2609           buf_custom-labels.CALL-TYPE = "add-fields"
     2610       AND buf_custom-labels.CALL-point = "gdsscrvw":
     2611     CREATE buf_temp-gdsscrvw.
     2612     ASSIGN
     2613     buf_temp-gdsscrvw.tbl-name = buf_custom-labels.tbl-name
     2614     buf_temp-gdsscrvw.fld-name = buf_custom-labels.fld-name
     2615     buf_temp-gdsscrvw.custom-label = buf_custom-labels.custom-label
     2616     buf_temp-gdsscrvw.is-on = LOOKUP(substitute("&1.&2"
     2617                                                 , buf_custom-labels.tbl-name
     2618                                                 , buf_custom-labels.fld-name
     2619                                                 )
     2620                                       , v-gdsscrvw) > 0
     2621     .
     2622   END.
     2623   ASSIGN
     2624   temp-gdsscrvw.is-on:read-only IN BROWSE br-gdsscrvw = (p-mode = 'ПРОСМОТР':U).
     2625   if p-obj-type = 'маг':U
     2626   or p-obj-type = 'скл':U then do:
     2627     ASSIGN
     2628     FRAME Dialog-Frame:TITLE = substitute("&1 &2&3"
     2629                                            ,FRAME Dialog-Frame:TITLE
     2630                                            ,p-obj-type
     2631                                            ,p-obj-code)
     2632     .
     2633   end.
     2634   v-tab-order = "b-dfltggrp,t-chg-bcod,f-image-dir".
     2635   display
     2636   f-dfltggrp
     2637   f-grp-name
     2638   t-chg-bcod
     2639   f-image-dir
     2640   with frame Dialog-Frame .
     2641   ENABLE
     2642   B-exit WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2643   b-quit
     2644   B-Help
     2645   b-dfltggrp WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2646   t-chg-bcod WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2647   f-image-dir WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2648   br-gdsscrvw
     2649   WITH FRAME Dialog-Frame.
     2650   VIEW FRAME Dialog-Frame.
     2651   IF p-mode = 'ПРОСМОТР':U THEN DO:
     2652       HIDE
     2653       b-exit
     2654       IN FRAME Dialog-Frame.
     2655       ASSIGN
     2656       b-quit:LABEL = "&Выход"
     2657       b-quit:column = 1
     2658       .
     2659   END.
     2660   OPEN QUERY br-gdsscrvw FOR EACH temp-gdsscrvw.
     2661   END PROCEDURE.
     2662   PROCEDURE proc-save :
     2663   define variable v-value-character as character no-undo .
     2664   define variable v-value-date as date no-undo .
     2665   define variable v-value-decimal as decimal no-undo .
     2666   define variable v-value-integer as INTEGER no-undo .
     2667   define variable v-value-logical AS LOGICAL no-undo .
     2668   define variable v-param-type as character no-undo .
     2669   define variable v-gds-copy-list as character no-undo .
     2670   define variable v-gdsreffi as character no-undo .
     2671   define variable wh as widget-handle no-undo .
     2672   define variable fh as widget-handle no-undo .
     2673   define variable v-same as logical no-undo .
     2674   DEFINE BUFFER buf_temp-gdsscrvw FOR temp-gdsscrvw.
     2675   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     2676   v-gdsscrvw = "".
     2677   fOR EACH buf_temp-gdsscrvw:
     2678      IF buf_temp-gdsscrvw.is-on THEN DO:
     2679         ASSIGN
     2680         v-gdsscrvw =  substitute("&1,&2.&3"
     2681                                 ,v-gdsscrvw
     2682                                 , buf_temp-gdsscrvw.tbl-name
     2683                                 , buf_temp-gdsscrvw.fld-name).
     2684      END.
     2685   END.
     2686   ASSIGN
     2687   v-gdsscrvw = TRIM(v-gdsscrvw, chr(44)).
     2688   ASSIGN
     2689   FRAME Dialog-Frame
     2690   f-dfltggrp
     2691   t-chg-bcod
     2692   f-image-dir
     2693   .
     2694   assign
     2695   fh = frame Dialog-Frame:first-child
     2696   wh = fh:first-child
     2697   .
     2698   do while valid-handle(wh):
     2699     if wh:private-data begins "recid=" then do:
     2700       find first thbjattr_thbj-attr where
     2701                 recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     2702       assign
     2703       buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     2704     end.
     2705     wh = wh:next-sibling.
     2706   end.
     2707   release thbjattr_thbj-attr.
     2708   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'gdsscrvw':U.
     2709   assign
     2710   thbjattr_thbj-attr.property-value-character = v-gdsscrvw
     2711   .
     2712   release thbjattr_thbj-attr.
     2713   v-same = yes.
     2714   for each thbjattr_thbj-attr,
     2715       first temp-thbj-attr where
     2716             temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     2717         and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     2718         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     2719         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code:
     2720      buffer-compare
     2721      thbjattr_thbj-attr
     2722      to temp-thbj-attr
     2723      save result in v-same.
     2724      if not v-same then leave.
     2725   end.
     2726   v-same = no.
     2727   IF v-same  and not v-to-create THEN RETURN.
     2728   run adm/shattri.p (
     2729                 input "check":U
     2730               , input p-obj-type
     2731               , input p-obj-code
     2732               , input 'gds-ref_obj':U
     2733               , INPUT '':U
     2734                , output v-value-character
     2735                , output v-value-date
     2736                , output v-value-decimal
     2737                , output v-value-integer
     2738                , output v-value-logical
     2739                , output v-param-type
     2740                , input-output table-handle v-tth
     2741                ) no-error .
     2742   if error-status:error then do:
     2743     message
     2744     "Некорректное значение ПАРАМЕТРОВ" skip
     2745     error-status:get-message(1) skip
     2746     return-value
     2747     view-as alert-box error .
     2748     undo, return error .
     2749   end.
     2750   do TRANSACTION
     2751   on error undo, return error return-value
     2752   :
     2753     RUN thbjattr_set-section IN THIS-PROCEDURE (
     2754          input p-obj-type
     2755         ,input p-obj-code
     2756         ,input 'gds-ref_obj':U
     2757         ,INPUT table thbjattr_thbj-attr
     2758     ) NO-ERROR.
     2759     IF ERROR-STATUS:error THEN do:
     2760       MESSAGE ERROR-STATUS:get-message(1)  SKIP
     2761       RETURN-VALUE
     2762       VIEW-AS ALERT-BOX.
     2763       UNDO, RETURN ERROR.
     2764     END.
     2765   end.
     2766   END PROCEDURE.
     2767   PROCEDURE set-full-grp-name :
     2768   DEFINE INPUT PARAMETER p-node-code AS INTEGER NO-UNDO.
     2769   DEFINE BUFFER buf_gds-grp FOR ub.gds-grp.
     2770   if p-node-code <> -1 then do:
     2771     find first buf_gds-grp no-lock where
     2772               buf_gds-grp.node-code = p-node-code no-error.
     2773     if not available buf_gds-grp then do:
     2774       assign
     2775       f-grp-name = '!!!!НЕВЕРНЫЙ КОД ГРУППЫ':U
     2776       .
     2777     END.
     2778    else do:
     2779      run grplib-get-full-name in this-procedure ( input buf_gds-grp.node-code, output f-grp-name) no-error.
     2780      if error-status:error then do:
     2781       assign
     2782       f-grp-name = '!!!!НЕ УДАЛОСЬ НАЙТИ ПОЛНОЕ ИМЯ ГРУППЫ':U
     2783       .
     2784      end.
     2785    end.
     2786   end.
     2787   else do:
     2788     ASSIGN
     2789     f-grp-name = '':U
     2790     .
     2791   end.
     2792   DISPLAY
     2793   f-grp-name
     2794   f-dfltggrp
     2795   WITH FRAME Dialog-Frame.
     2796   END PROCEDURE.
