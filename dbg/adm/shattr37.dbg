      706   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      707   define variable v-tth           as handle   no-undo .
      708   define variable v-to-create    as logical      no-undo.
      709   DEFINE BUTTON b-exit AUTO-GO
      710        LABEL "&Ввод"
      711        SIZE 10 BY 1
      712        BGCOLOR 8 .
      713   DEFINE BUTTON b-help
      714        LABEL "Помо&щь"
      715        SIZE 10 BY 1
      716        BGCOLOR 8 .
      717   DEFINE BUTTON b-quit AUTO-END-KEY
      718        LABEL "&Отмена"
      719        SIZE 10 BY 1
      720        BGCOLOR 8 .
      721   DEFINE VARIABLE v-fbr-mrgn-max AS DECIMAL FORMAT ">9.9":U INITIAL 0
      722        LABEL "и макс."
      723        VIEW-AS FILL-IN
      724        SIZE 4.5 BY 1 NO-UNDO.
      725   DEFINE VARIABLE v-fbr-mrgn-min AS DECIMAL FORMAT ">9.9":U INITIAL 0
      726        LABEL "Мин"
      727        VIEW-AS FILL-IN
      728        SIZE 4.5 BY 1 NO-UNDO.
      729   DEFINE VARIABLE v-fbrhstlv AS INTEGER FORMAT "9":U INITIAL 0
      730        VIEW-AS FILL-IN
      731        SIZE 2 BY 1 TOOLTIP "0 - запись в историю не производится. 9 - максимальная детализация" NO-UNDO.
      732   DEFINE VARIABLE tb-fbr-frcp AS LOGICAL INITIAL no
      733        LABEL "Первый подходящий рецепт при рекурсивном производстве"
      734        VIEW-AS TOGGLE-BOX
      735        SIZE 56 BY .83 TOOLTIP "при нескольких рецептах брать первый подходящий, иначе только однозначный выбор" NO-UNDO.
      736   DEFINE VARIABLE tb-fbr-ioff AS LOGICAL INITIAL no
      737        LABEL "Ручное заполнение альтернативного производства"
      738        VIEW-AS TOGGLE-BOX
      739        SIZE 55.5 BY .83 TOOLTIP "Отключение распределения количеств ингредиентов для альтернативных рецептов" NO-UNDO.
      740   DEFINE VARIABLE tb-fbr-qntc AS LOGICAL INITIAL no
      741        LABEL "При раскрутке рецептов прибавлять требуемое количество к уже произведенному"
      742        VIEW-AS TOGGLE-BOX
      743        SIZE 78 BY .83 TOOLTIP "При рекурсивном производстве если требуемый товар уже есть в рецепте" NO-UNDO.
      744   DEFINE VARIABLE tb-fbrrcpgb AS LOGICAL INITIAL no
      745        LABEL "Возможность изменения локальных рецептов на глобальные"
      746        VIEW-AS TOGGLE-BOX
      747        SIZE 59 BY .83 TOOLTIP "При включенном параметре, локальный рецепт можно сделать глобальным." NO-UNDO.
      748   DEFINE FRAME Dialog-Frame
      749        b-exit AT ROW 1 COL 1
      750        b-quit AT ROW 1 COL 11
      751        b-help AT ROW 1 COL 55
      752        tb-fbr-frcp AT ROW 3 COL 6 WIDGET-ID 2
      753        tb-fbr-ioff AT ROW 4 COL 6 WIDGET-ID 4
      754        tb-fbr-qntc AT ROW 5 COL 6 WIDGET-ID 6
      755        tb-fbrrcpgb AT ROW 6 COL 6 WIDGET-ID 8
      756        v-fbrhstlv AT ROW 7.5 COL 4 COLON-ALIGNED NO-LABEL WIDGET-ID 10
      757        v-fbr-mrgn-min AT ROW 9 COL 9 COLON-ALIGNED WIDGET-ID 14
      758        v-fbr-mrgn-max AT ROW 9 COL 25 COLON-ALIGNED WIDGET-ID 16
      759        "%" VIEW-AS TEXT
      760             SIZE 1.5 BY .67 AT ROW 9.21 COL 16 WIDGET-ID 18
      761        "Детализация записи в историю" VIEW-AS TEXT
      762             SIZE 74 BY .67 TOOLTIP "0 - запись в историю не производится. 9 - максимальная детализация" AT ROW 7.71 COL 9 WIDGET-ID 12
      763        "% наценки производства" VIEW-AS TEXT
      764             SIZE 23.5 BY .67 TOOLTIP "Вычисляется для каждого производимого товара по каждому рецепту" AT ROW 9.21 COL 32.5 WIDGET-ID 20
      765        SPACE(32.62) SKIP(2.40)
      766       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      767            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      768            TITLE "Параметры производства"
      769            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit WIDGET-ID 100.
      770   ASSIGN
      771          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      772          FRAME Dialog-Frame:HIDDEN           = TRUE.
      773   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      774   DO:
      775     APPLY "END-ERROR":U TO SELF.
      776   END.
      777   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      778   DO:
      779      if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      780         run save-attr in this-procedure .
      781      END.
      782   END.
      783   ON CHOOSE OF b-help IN FRAME Dialog-Frame
      784   OR HELP OF FRAME Dialog-Frame
      785   DO:
      786     MESSAGE "Help for File: c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\adm\shattr37.w" VIEW-AS ALERT-BOX INFORMATION.
      787   END.
      788   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      789   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      790   MAIN-BLOCK:
      791   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      792      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      793   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      794   on help of frame Dialog-Frame
      795   do:
      796     run gbl/app_help.p
      797       (input this-procedure :file-name
      798       ,input ''
      799       ,input ?
      800       ) no-error.
      801     if error-status :error then do:
      802       message
      803         "Ошибка при вызове помощи"
      804         error-status :get-message(1)
      805         view-as alert-box .
      806     end.
      807   end.
      808   run minbtn-set in this-procedure .
      809   on choose of b-help in frame Dialog-Frame
      810   do:
      811     apply "help":u to frame Dialog-Frame .
      812   end.
      813   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      814   procedure minbtn-set :
      815       do
      816           on error undo, return error return-value
      817           :
      818           define variable ii              as integer       no-undo .
      819           define variable fh              as widget-handle no-undo .
      820           define variable hh              as widget-handle no-undo .
      821           define variable v-h             as handle        extent 4 no-undo .
      822           define variable v-name-button   as character     no-undo .
      823           define variable v-help-old-x    as decimal       no-undo .
      824           define variable v-help-old-y    as decimal       no-undo .
      825           define variable v-help-old-size as decimal       no-undo .
      826           define variable v-frame-width   as decimal       no-undo .
      827           define variable jj              as integer       no-undo .
      828           do
      829               on error undo, return error
      830               :
      831               assign
      832                   v-frame-width = frame Dialog-Frame:width - 0.3
      833                   fh            = frame Dialog-Frame:first-child
      834                   hh            = fh:first-child
      835                   ii            = 1
      836                   .
      837               do while valid-handle(hh):
      838                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      839                   do:
      840                       case lc(hh:name) :
      841                           when "b-help" then
      842                               do:
      843                                   hh:load-image-up("cmp/b-help.bmp":u) .
      844                                   hh:load-image-down("cmp/b-help.bmp":u) .
      845                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      846                                   hh:TOOLTIP = "Помощь" .
      847                                   v-help-old-x = hh:column .
      848                                   v-help-old-y = hh:row    .
      849                                   v-help-old-size = hh:width .
      850                                   hh:width-chars = 2.5 .
      851                               end.
      852                           when "b-print" then
      853                               do:
      854                                   hh:load-image("cmp/b-print.bmp":u) .
      855                                   hh:TOOLTIP = "Печать" .
      856                                   v-h[ii] = hh:handle .
      857                                   ii = ii + 1 .
      858                                   hh:width-chars = 3 .
      859                               end.
      860                           when "b-history" or
      861                           when "b-hist" then
      862                               do:
      863                                   hh:load-image("cmp/b-hist.bmp":u) .
      864                                   hh:TOOLTIP = "История" .
      865                                   v-h[ii] = hh:handle .
      866                                   ii = ii + 1 .
      867                                   hh:width-chars = 3 .
      868                               end.
      869                           when "b-sch" then
      870                               do:
      871                                   hh:load-image("cmp/b-sch.bmp":u) .
      872                                   hh:TOOLTIP = "Установка Фильтра" .
      873                                   v-h[ii] = hh:handle .
      874                                   ii = ii + 1 .
      875                                   hh:width-chars = 3 .
      876                               end.
      877                           when "b-hist-user" then
      878                               do:
      879                                   hh:load-image("cmp/b-hist.bmp":u) .
      880                                   hh:TOOLTIP = "История пользователя" .
      881                                   ii = ii + 1 .
      882                               end.
      883                       end case.
      884                   end.
      885                   hh = hh:next-sibling.
      886               end.
      887               b-help:column = v-frame-width - b-help:width-chars.
      888               jj = 0.
      889               repeat ii = 4 to 1 by -1 :
      890                   if valid-handle (v-h[ii] ) then
      891                   do:
      892                       jj  = jj + 1 .
      893                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      894                       v-h[ii]:row    = v-help-old-y .
      895                   end.
      896               end.
      897           end.
      898       end.
      899   end procedure.
      900      CASE p-obj-type:
      901         WHEN ""
      902         THEN DO:
      903            ASSIGN
      904               FRAME Dialog-Frame:TITLE = FRAME Dialog-Frame:TITLE + " глобально"
      905            .
      906         END.
      907         WHEN 'орг':U
      908         THEN DO:
      909            ASSIGN
      910               FRAME Dialog-Frame:TITLE = FRAME Dialog-Frame:TITLE + SUBSTITUTE(" по фирме &1", p-obj-code)
      911            .
      912         END.
      913         WHEN 'маг':U OR
      914         WHEN 'скл':U
      915         THEN DO:
      916            ASSIGN
      917               FRAME Dialog-Frame:TITLE = FRAME Dialog-Frame:TITLE + SUBSTITUTE(" по объекту &1 &2", p-obj-type, p-obj-code)
      918            .
      919         END.
      920         OTHERWISE DO:
      921         END.
      922      END CASE.
      923     if  p-mode <> 'ПРОСМОТР':U and
      924         p-mode <> 'ИЗМЕНЕНИЕ':U
      925     then do:
      926         message
      927           vss-workfile vss-revision vss-description skip
      928           "Неверное значение параметра p-mode" p-mode
      929         view-as alert-box error.
      930         undo, return error.
      931     end.
      932     RUN load-attr IN THIS-PROCEDURE .
      933     RUN enable_UI.
      934     RUN post_enable_UI IN THIS-PROCEDURE.
      935     WAIT-FOR GO OF FRAME Dialog-Frame.
      936   END.
      937   RUN disable_UI.
      938   PROCEDURE disable_UI :
      939     HIDE FRAME Dialog-Frame.
      940   END PROCEDURE.
      941   PROCEDURE enable_UI :
      942     DISPLAY tb-fbr-frcp tb-fbr-ioff tb-fbr-qntc tb-fbrrcpgb v-fbrhstlv
      943             v-fbr-mrgn-min v-fbr-mrgn-max
      944         WITH FRAME Dialog-Frame.
      945     ENABLE b-exit b-quit b-help tb-fbr-frcp tb-fbr-ioff tb-fbr-qntc tb-fbrrcpgb
      946            v-fbrhstlv v-fbr-mrgn-min v-fbr-mrgn-max
      947         WITH FRAME Dialog-Frame.
      948     VIEW FRAME Dialog-Frame.
      949   END PROCEDURE.
      950   PROCEDURE load-attr :
      951   define variable v-value-character as character      no-undo .
      952   define variable v-value-date      as date           no-undo .
      953   define variable v-value-decimal   as decimal        no-undo .
      954   define variable v-value-integer   as integer        no-undo .
      955   define variable v-value-logical   as logical        no-undo .
      956   define variable v-param-type      as character      no-undo .
      957   define variable v-entry           as character  no-undo .
      958   do
      959   on error undo, return error
      960   :
      961      if p-mode = 'ИЗМЕНЕНИЕ':U then
      962      do
      963      transaction
      964      :
      965         find first locked_thbj-attr
      966               where locked_thbj-attr.upper-prop-code = 'fbrattr':U
      967               exclusive-lock
      968               no-wait
      969               no-error
      970               .
      971         if locked locked_thbj-attr then do:
      972            message
      973               vss-workfile vss-revision vss-description skip
      974                  "Запись !!!"
      975               view-as alert-box error .
      976            undo, return error.
      977         end.
      978      end.
      979      else do:
      980         find first locked_thbj-attr
      981               where locked_thbj-attr.upper-prop-code = 'fbrattr':U
      982               no-lock
      983               no-error
      984               .
      985      end.
      986      if not available locked_thbj-attr then do:
      987         assign
      988            v-to-create  = yes
      989         .
      990         message
      991            substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
      992                        chr(10)
      993                        )
      994         view-as alert-box WARNING.
      995      end.
      996      assign
      997         v-tth = buffer thbjattr_thbj-attr:table-handle
      998      .
      999      empty temp-table thbjattr_thbj-attr.
     1000      empty temp-table temp-thbj-attr.
     1001     run adm/shattri.p (
     1002                   input "init":U
     1003                 , input p-obj-type
     1004                 , input p-obj-code
     1005                 , input 'fbrattr':U
     1006                 , input "":U
     1007                 , output v-value-character
     1008                 , output v-value-date
     1009                 , output v-value-decimal
     1010                 , output v-value-integer
     1011                 , output v-value-logical
     1012                 , output v-param-type
     1013                 , INPUT-OUTPUT table-handle v-tth
     1014                 ) no-error .
     1015     if error-status:error
     1016     and not available locked_thbj-attr then do:
     1017       message
     1018       "Не удалось получить начальные значения настроек" skip
     1019       error-status:get-message(1) return-value
     1020       view-as alert-box error .
     1021       undo, return error .
     1022     end.
     1023     for each thbjattr_thbj-attr:
     1024       assign
     1025         v-entry = thbjattr_thbj-attr.prop-code
     1026       .
     1027       case v-entry:
     1028         when 'fbr-frcp':U then do:
     1029           assign
     1030             tb-fbr-frcp = thbjattr_thbj-attr.property-value-logical
     1031             tb-fbr-frcp :private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1032           .
     1033         end.
     1034         when 'fbr-ioff':U then do:
     1035           assign
     1036             tb-fbr-ioff = thbjattr_thbj-attr.property-value-logical
     1037             tb-fbr-ioff :private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1038           .
     1039         end.
     1040         when 'fbr-qntc':U then do:
     1041           assign
     1042             tb-fbr-qntc = thbjattr_thbj-attr.property-value-logical
     1043             tb-fbr-qntc :private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1044           .
     1045         end.
     1046         when 'fbrrcpgb':U then do:
     1047           assign
     1048             tb-fbrrcpgb = thbjattr_thbj-attr.property-value-logical
     1049             tb-fbrrcpgb :private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1050           .
     1051         end.
     1052         when 'fbrhstlv':U then do:
     1053           assign
     1054             v-fbrhstlv = thbjattr_thbj-attr.property-value-integer
     1055             v-fbrhstlv :private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1056           .
     1057         end.
     1058         when 'fbr-mrgn-min':U then do:
     1059           assign
     1060             v-fbr-mrgn-min = thbjattr_thbj-attr.property-value-decimal
     1061             v-fbr-mrgn-min :private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1062           .
     1063         end.
     1064         when 'fbr-mrgn-max':U then do:
     1065           assign
     1066             v-fbr-mrgn-max = thbjattr_thbj-attr.property-value-decimal
     1067             v-fbr-mrgn-max :private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1068           .
     1069         end.
     1070       end case.
     1071       create temp-thbj-attr.
     1072       buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     1073     end.
     1074   end.
     1075   END PROCEDURE.
     1076   PROCEDURE post_enable_UI :
     1077   do
     1078   on error undo, return error
     1079   :
     1080      if  p-mode = 'ПРОСМОТР':U
     1081      then do:
     1082       assign
     1083         v-fbr-mrgn-min :fgcolor in frame Dialog-Frame = BROWN_COLOR
     1084         v-fbr-mrgn-max :fgcolor in frame Dialog-Frame = BROWN_COLOR
     1085         v-fbrhstlv     :fgcolor in frame Dialog-Frame = BROWN_COLOR
     1086         b-exit :hidden  = yes
     1087         b-quit :label   = "&Выход":U
     1088       .
     1089       disable
     1090         tb-fbr-frcp
     1091         tb-fbr-ioff
     1092         tb-fbr-qntc
     1093         tb-fbrrcpgb
     1094         v-fbrhstlv
     1095         v-fbr-mrgn-min
     1096         v-fbr-mrgn-max
     1097       with frame Dialog-Frame.
     1098       view frame Dialog-Frame.
     1099      END.
     1100   END.
     1101   END PROCEDURE.
     1102   PROCEDURE save-attr :
     1103   define variable v-value-character as character      no-undo .
     1104   define variable v-value-date      as date           no-undo .
     1105   define variable v-value-decimal   as decimal        no-undo .
     1106   define variable v-value-integer   as integer        no-undo .
     1107   define variable v-value-logical   as logical        no-undo .
     1108   define variable v-param-type      as character      no-undo .
     1109   define variable wh                as widget-handle  no-undo .
     1110   define variable fh                as widget-handle  no-undo .
     1111   define variable v-same            as logical        no-undo .
     1112   do
     1113   on error undo, return error
     1114   :
     1115      assign
     1116      frame Dialog-Frame
     1117           tb-fbr-frcp
     1118           tb-fbr-ioff
     1119           tb-fbr-qntc
     1120           tb-fbrrcpgb
     1121           v-fbrhstlv
     1122           v-fbr-mrgn-min
     1123           v-fbr-mrgn-max
     1124         fh = frame Dialog-Frame:first-child
     1125         wh = fh:first-child
     1126      .
     1127      do while valid-handle(wh):
     1128         if wh:private-data begins "recid="
     1129         then do:
     1130            find first thbjattr_thbj-attr
     1131            where recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '='))
     1132            .
     1133            assign
     1134            buffer
     1135            thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value
     1136            .
     1137         end.
     1138         wh = wh:next-sibling.
     1139      end.
     1140      assign
     1141         v-same = yes
     1142      .
     1143      for each thbjattr_thbj-attr,
     1144            first temp-thbj-attr
     1145            where temp-thbj-attr.obj-type          = thbjattr_thbj-attr.obj-type
     1146               and temp-thbj-attr.obj-code         = thbjattr_thbj-attr.obj-code
     1147               and temp-thbj-attr.upper-prop-code  = thbjattr_thbj-attr.upper-prop-code
     1148               and temp-thbj-attr.prop-code        = thbjattr_thbj-attr.prop-code
     1149      :
     1150         buffer-compare thbjattr_thbj-attr to temp-thbj-attr save result in v-same.
     1151         if not v-same then leave.
     1152      end.
     1153      if v-same  and not v-to-create then return.
     1154      run adm/shattri.p ( input "check":U
     1155                        , input p-obj-type
     1156                        , input p-obj-code
     1157                        , input 'fbrattr':U
     1158                        , INPUT '':U
     1159                        , output v-value-character
     1160                        , output v-value-date
     1161                        , output v-value-decimal
     1162                        , output v-value-integer
     1163                        , output v-value-logical
     1164                        , output v-param-type
     1165                        , input-output table-handle v-tth
     1166                        ) no-error .
     1167      if error-status :error then do:
     1168         message
     1169            "Некорректное значение ПАРАМЕТРОВ"  skip
     1170            error-status:get-message(1)         skip
     1171            return-value
     1172         view-as alert-box error .
     1173         undo, return error .
     1174      end.
     1175      do transaction
     1176      on error undo, return error return-value
     1177      :
     1178         run thbjattr_set-section in this-procedure ( input p-obj-type
     1179                                                   , input p-obj-code
     1180                                                   , input 'fbrattr':U
     1181                                                   , input table thbjattr_thbj-attr
     1182                                                   ) no-error.
     1183         if error-status:error then do:
     1184            message
     1185            error-status:get-message(1)  skip
     1186            return-value
     1187            view-as alert-box.
     1188            undo, return error.
     1189         end.
     1190      end.
     1191   END.
     1192   END PROCEDURE.
