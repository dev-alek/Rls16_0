      294   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      295     define variable v-cntxt-db-num        as integer   no-undo .
      296     define variable v-cntxt-userid        as character no-undo .
      297     define variable v-cntxt-level         as character no-undo .
      298     define variable v-cntxt-host-code-obj as integer   no-undo .
      299     define variable v-cntxt-obj-type      as character no-undo .
      300     define variable v-cntxt-obj-code      as integer   no-undo .
      301     define variable v-cntxt-db-num-obj    as integer   no-undo .
      302     define variable v-cntxt-is-admin      as logical   no-undo .
      303   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      304   define temp-table tt-attr-property  no-undo
      305   field upper-attr-code as character
      306   field attr-code as character
      307   field table-name as character
      308   field edit-menu-section-num as integer
      309   field attr-label as character
      310   field menu-item-handle as widget-handle
      311   field user-can-edit as logical
      312   field menu-name as character
      313   field parent-handle as handle
      314   index pi is unique primary
      315   table-name
      316   menu-name
      317   upper-attr-code
      318   attr-code
      319   index i-section
      320   edit-menu-section-num
      321   .
      322   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      323   procedure attr-pop-create-items :
      324   define input parameter p-table-name as character no-undo .
      325   define input parameter p-get-section-num-proc-name as character no-undo .
      326   define input parameter p-get-attr-label-proc-name as character no-undo .
      327   define input parameter p-attr-choose-proc-name as character no-undo .
      328   define input parameter p-menu-handle as widget-handle no-undo .
      329   define input parameter p-attr-list as character no-undo .
      330   define variable ii as integer no-undo .
      331   define variable V-CREATED as logical no-undo .
      332   define variable v-tool-tip as character no-undo .
      333   define variable v-dop as character no-undo .
      334   define variable v-attr-item as character no-undo .
      335   define variable p-upper-attr-code as character no-undo .
      336   define buffer buf_tt-attr-property for tt-attr-property.
      337     do
      338     on error undo, return error return-value
      339     :
      340        do ii = 1 to num-entries (p-attr-list):
      341          v-attr-item = entry(ii, p-attr-list) .
      342          find first tt-attr-property where
      343                    tt-attr-property.table-name = p-table-name
      344                and tt-attr-property.attr-code = v-attr-item
      345                and tt-attr-property.upper-attr-code = p-upper-attr-code
      346                and tt-attr-property.menu-name = p-menu-handle:name  no-error .
      347          if not available tt-attr-property then do:
      348            create tt-attr-property.
      349            assign
      350            tt-attr-property.table-name = p-table-name
      351            tt-attr-property.attr-code = v-attr-item
      352            tt-attr-property.upper-attr-code = p-upper-attr-code
      353            tt-attr-property.menu-name = p-menu-handle:name
      354            .
      355            run value ( p-get-section-num-proc-name) (
      356                                                      input tt-attr-property.attr-code
      357                                                     ,output tt-attr-property.edit-menu-section-num ) no-error .
      358            run value ( p-get-attr-label-proc-name ) (
      359                                           input tt-attr-property.attr-code
      360                                          ,output v-tool-tip
      361                                          ,output tt-attr-property.attr-label
      362                                         ) no-error .
      363            release tt-attr-property.
      364          end.
      365        end.
      366        for each tt-attr-property where tt-attr-property.menu-name = p-menu-handle:name
      367        break
      368        by  tt-attr-property.edit-menu-section-num
      369        by  tt-attr-property.attr-label
      370        :
      371          if tt-attr-property.edit-menu-section-num > 0
      372          then do:
      373             if not valid-handle(tt-attr-property.menu-item-handle) then do:
      374               if num-entries(tt-attr-property.attr-code, chr(4)) > 1
      375               and entry(2, tt-attr-property.attr-code, chr(4)) <> '':U
      376               then do:
      377                 find first buf_tt-attr-property where
      378                           buf_tt-attr-property.table-name = p-table-name
      379                       and buf_tt-attr-property.menu-name = p-menu-handle:name
      380                       and buf_tt-attr-property.upper-attr-code = p-upper-attr-code
      381                       and buf_tt-attr-property.attr-code = entry(1, tt-attr-property.attr-code, chr(4)) no-error .
      382                 if not available buf_tt-attr-property then do:
      383                   create buf_tt-attr-property.
      384                   assign
      385                   buf_tt-attr-property.table-name = p-table-name
      386                   buf_tt-attr-property.attr-code = entry(1, tt-attr-property.attr-code, chr(4))
      387                   buf_tt-attr-property.upper-attr-code = p-upper-attr-code
      388                   buf_tt-attr-property.menu-name = p-menu-handle:name
      389                   .
      390                   create sub-menu buf_tt-attr-property.menu-item-handle
      391                   assign
      392                   name = entry(1, tt-attr-property.attr-code, chr(4))  + chr(4)  + p-menu-handle:name
      393                   parent = p-menu-handle.
      394                 end.
      395                 create menu-item tt-attr-property.menu-item-handle
      396                 assign
      397                 label = tt-attr-property.attr-label
      398                 name = tt-attr-property.attr-code  + chr(4)  + p-menu-handle:name
      399                 parent = buf_tt-attr-property.menu-item-handle
      400                 triggers:
      401                   on choose
      402                     persistent run value(p-attr-choose-proc-name + "-2") (
      403                                                                            input  entry(1, tt-attr-property.attr-code, chr(4) )
      404                                                                           ,input entry(2, tt-attr-property.attr-code, chr(4) )
      405                                                                             ) .
      406                 end triggers.
      407                 assign
      408                 v-created = yes.
      409               end.
      410               else do:
      411                 create menu-item tt-attr-property.menu-item-handle
      412                 assign
      413                 label = tt-attr-property.attr-label
      414                 name = entry(1, tt-attr-property.attr-code, chr(4)) + chr(4)  + p-menu-handle:name
      415                 parent = p-menu-handle
      416                 triggers:
      417                   on choose
      418                     persistent run value(p-attr-choose-proc-name) (
      419                                                                    input  entry(1, tt-attr-property.attr-code, chr(4) )) .
      420                 end triggers.
      421                 assign
      422                 v-created = yes.
      423               end.
      424             end.
      425             if last-of(tt-attr-property.edit-menu-section-num)
      426               then do:
      427               find first buf_tt-attr-property where
      428                         buf_tt-attr-property.table-name = p-table-name
      429                    and  buf_tt-attr-property.attr-code = substitute("&1&2&3"
      430                                                            , p-table-name
      431                                                            , tt-attr-property.edit-menu-section-num
      432                                                            , p-menu-handle:name
      433                                                            )
      434                     and buf_tt-attr-property.menu-name = p-menu-handle:name  no-error .
      435               if not available buf_tt-attr-property then do:
      436                 create buf_tt-attr-property.
      437                 assign
      438                 buf_tt-attr-property.table-name = p-table-name
      439                 buf_tt-attr-property.edit-menu-section-num =  - 1
      440                 buf_tt-attr-property.menu-name = p-menu-handle:name
      441                 buf_tt-attr-property.upper-attr-code = ''
      442                 buf_tt-attr-property.attr-code = substitute("&1&2&3"
      443                                                             , p-table-name
      444                                                             , tt-attr-property.edit-menu-section-num
      445                                                             , p-menu-handle:name
      446                                                             )
      447                 .
      448                 create menu-item buf_tt-attr-property.menu-item-handle
      449                 assign
      450                 subtype = "rule"
      451                 parent = p-menu-handle
      452                 .
      453               end.
      454             end.
      455          end.
      456        end.
      457        if not v-created then do:
      458           run attr-pop-clean-up in this-procedure ( input p-table-name).
      459        end.
      460     end.
      461   end procedure.
      462   procedure attr-pop-clean-up :
      463   define input parameter p-table-name as character no-undo .
      464     for each tt-attr-property where
      465             tt-attr-property.table-name = p-table-name
      466       and tt-attr-property.edit-menu-section-num > 0:
      467       if valid-handle ( tt-attr-property.menu-item-handle) then do:
      468         delete widget tt-attr-property.menu-item-handle.
      469       end.
      470       delete tt-attr-property.
      471     end.
      472     for each tt-attr-property where
      473              tt-attr-property.table-name = p-table-name
      474          and tt-attr-property.edit-menu-section-num =  - 1:
      475       if valid-handle ( tt-attr-property.menu-item-handle) then do:
      476         delete widget tt-attr-property.menu-item-handle.
      477       end.
      478       delete tt-attr-property.
      479     end.
      480   end procedure.
      481   define variable updated as logical no-undo.
      482   DEFINE VARIABLE added  as logical no-undo .
      483   define variable add-option as char no-undo.
      484   define variable ini-title as char no-undo.
      485   define variable temp-doc-rec as recid no-undo.
      486   define variable dops as character no-undo.
      487   define variable dopst as character no-undo.
      488   define variable v-tab-order as character no-undo .
      489   define variable alco-val-log as logical no-undo .
      490   define buffer buf_db for ub.db.
      491   define buffer bufc_db for ub.db.
      492   DEFINE MENU MENU-b-add .
      493   DEFINE BUTTON b-add
      494        LABEL "&Добавить":L
      495        SIZE 10 BY 1 TOOLTIP "Добавить атрибут БД".
      496   DEFINE BUTTON b-chg
      497        LABEL "&Изменить":L
      498        SIZE 10 BY 1 TOOLTIP "Изменить атрибут БД".
      499   DEFINE BUTTON b-del
      500        LABEL "&Удалить":L
      501        SIZE 10 BY 1 TOOLTIP "Удалить  атрибут БД".
      502   DEFINE BUTTON b-help
      503        LABEL "Помо&щь":L
      504        SIZE 10 BY 1.
      505   DEFINE BUTTON b-lkp
      506        LABEL "&Просмотр"
      507        SIZE 10 BY 1.
      508   DEFINE BUTTON b-quit AUTO-GO
      509        LABEL "&Выход":L
      510        SIZE 10 BY 1 TOOLTIP "Выход из режима".
      511   DEFINE VARIABLE db-db-num AS INTEGER FORMAT ">>>>9":U INITIAL 0
      512        LABEL "БД"
      513         VIEW-AS TEXT
      514        SIZE 11 BY 1
      515        BGCOLOR 3  NO-UNDO.
      516   DEFINE QUERY br-attr FOR
      517         temp-attr SCROLLING.
      518   DEFINE BROWSE br-attr
      519     QUERY br-attr DISPLAY
      520         temp-attr.attr-code COLUMN-LABEL "Атрибут" FORMAT "X(100)":U
      521         temp-attr.attr-value COLUMN-LABEL "Значение" FORMAT "X(34)":U
      522       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.8 BY 15.33.
      523   DEFINE FRAME Dialog-Frame
      524        b-quit AT ROW 1 COL 1
      525        b-add AT ROW 1 COL 21
      526        b-lkp AT ROW 1 COL 31
      527        b-chg AT ROW 1 COL 41
      528        b-del AT ROW 1 COL 51
      529        b-help AT ROW 1.03 COL 70.1
      530        br-attr AT ROW 4.47 COL 1
      531        db-db-num AT ROW 3.13 COL 2
      532        SPACE(82.80) SKIP(18.06)
      533       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      534            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      535            TITLE "Атрибуты БД".
      536   ASSIGN
      537          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      538          FRAME Dialog-Frame:HIDDEN           = TRUE.
      539   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      540   DO:
      541     APPLY "END-ERROR":U TO SELF.
      542   END.
      543   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      544   DO:
      545   define variable attr-type as character no-undo .
      546   define variable attr-format as character no-undo .
      547   define variable attr-label as character no-undo .
      548   define variable attr-user-can-edit as logical no-undo .
      549   define variable attr-output-display as logical no-undo .
      550   define variable attr-other as char no-undo .
      551   define variable loc#log as logical no-undo.
      552   define buffer buf_temp-attr for temp-attr.
      553   if add-option = "" then do:
      554     run gbl/pop-up.p ( input self:handle, input no) no-error.
      555   end.
      556   if add-option = "":U then return no-apply.
      557   run proc-add-chg in this-procedure ( input yes) no-error .
      558   if error-status:error then do:
      559     add-option = "":U.
      560     return no-apply.
      561   end.
      562   Run init-proc in this-procedure .
      563   find first buf_temp-attr no-lock where
      564                           buf_temp-attr.code = add-option no-error.
      565   add-option = "":U.
      566   if avail buf_temp-attr then
      567       temp-doc-rec = recid(buf_temp-attr).
      568       else temp-doc-rec = ?.
      569   reposition BR-attr to recid temp-doc-rec no-error.
      570   if error-status:error then return no-apply.
      571   END.
      572   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      573   DO:
      574     if not avail temp-attr then return no-apply.
      575     run proc-add-chg in this-procedure ( input no) no-error .
      576     if error-status:error then return no-apply.
      577     RUN init-proc in this-procedure .
      578   END.
      579   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      580   DO:
      581   define variable loc#log as logical no-undo.
      582   define variable attr-type as character no-undo .
      583   define variable attr-format as character no-undo .
      584   define variable attr-label as character no-undo .
      585   define variable attr-user-can-edit as logical no-undo .
      586   define variable attr-output-display as logical no-undo .
      587   define variable attr-other as char no-undo .
      588   define variable glog as logical no-undo .
      589   DEFINE VARIABLE v-check AS CHARACTER NO-UNDO.
      590   define variable v-correct as logical no-undo .
      591   define variable v-error-code as character no-undo .
      592   DEFINE VARIABLE jj AS INTEGER NO-UNDO.
      593     if not avail temp-attr then return no-apply.
      594     run db-attr-code in this-procedure (
      595                          input  temp-attr.code
      596                         ,output attr-type
      597                         ,output attr-format
      598                         ,output attr-label
      599                         ,output attr-user-can-edit
      600                         ,output attr-output-display
      601                         ,output attr-other
      602                         ) .
      603     if not attr-user-can-edit then do:
      604       message
      605       "Атрибут нельзя удалить вручную"
      606       view-as alert-box error .
      607       return no-apply.
      608     end.
      609        do jj = 1 to num-entries(attr-other, chr(47)):
      610       if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "check":U then do:
      611         assign
      612         v-check = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
      613         .
      614       end.
      615     end.
      616     if v-check <> "":U then do:
      617       run value(v-check) (
      618                          input p-db-num
      619                         ,input temp-attr.code
      620                         ,input "0":U
      621                         ,input 'удаление':U
      622                         ,output v-correct
      623                         ,output v-error-code) no-error.
      624       if error-status:error then do:
      625         message
      626         "Ошибка при проверке корректности удаления атрибута" skip
      627         error-status:get-message(1) skip
      628         view-as alert-box error .
      629         undo, return no-apply .
      630       end.
      631       if not v-correct then do:
      632         message
      633         "Удаление атрибута некорректно" skip
      634         return-value
      635         view-as alert-box error .
      636         undo, return no-apply .
      637       end.
      638     end.
      639     glog = no.
      640     message
      641     "Вы уверены, что хотите удалить атрибут " temp-attr.attr-code skip
      642     " для БД"
      643     view-as alert-box QUESTIOn buttons YES-NO update glog.
      644     if NOT glog then return no-apply.
      645       run db-attr-delete in this-procedure (
      646                                              input p-db-num
      647                                             ,input temp-attr.code
      648                                             ,output loc#log) no-error .
      649       if error-status:error or not loc#log then do:
      650          return no-apply.
      651       end.
      652       delete temp-attr.
      653       updated = yes.
      654       run init-proc in this-procedure .
      655   END.
      656   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
      657   DO:
      658     IF not AVAILABLE temp-attr then return no-apply.
      659     RUN proc-b-lkp IN THIS-PROCEDURE NO-ERROR.
      660     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      661   END.
      662   ON MOUSE-SELECT-DBLCLICK OF br-attr IN FRAME Dialog-Frame
      663   DO:
      664     if not avail temp-attr then return no-apply.
      665     RUN proc-b-lkp IN THIS-PROCEDURE NO-ERROR.
      666     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      667   END.
      668   ON RETURN OF br-attr IN FRAME Dialog-Frame
      669   DO:
      670     if not avail temp-attr then return no-apply.
      671     RUN proc-b-lkp IN THIS-PROCEDURE NO-ERROR.
      672     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      673   END.
      674   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      675   on help of frame Dialog-Frame
      676   do:
      677     run gbl/app_help.p
      678       (input this-procedure :file-name
      679       ,input ''
      680       ,input ?
      681       ) no-error.
      682     if error-status :error then do:
      683       message
      684         "Ошибка при вызове помощи"
      685         error-status :get-message(1)
      686         view-as alert-box .
      687     end.
      688   end.
      689   run minbtn-set in this-procedure .
      690   on choose of b-help in frame Dialog-Frame
      691   do:
      692     apply "help":u to frame Dialog-Frame .
      693   end.
      694   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      695   procedure minbtn-set :
      696       do
      697           on error undo, return error return-value
      698           :
      699           define variable ii              as integer       no-undo .
      700           define variable fh              as widget-handle no-undo .
      701           define variable hh              as widget-handle no-undo .
      702           define variable v-h             as handle        extent 4 no-undo .
      703           define variable v-name-button   as character     no-undo .
      704           define variable v-help-old-x    as decimal       no-undo .
      705           define variable v-help-old-y    as decimal       no-undo .
      706           define variable v-help-old-size as decimal       no-undo .
      707           define variable v-frame-width   as decimal       no-undo .
      708           define variable jj              as integer       no-undo .
      709           do
      710               on error undo, return error
      711               :
      712               assign
      713                   v-frame-width = frame Dialog-Frame:width - 0.3
      714                   fh            = frame Dialog-Frame:first-child
      715                   hh            = fh:first-child
      716                   ii            = 1
      717                   .
      718               do while valid-handle(hh):
      719                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      720                   do:
      721                       case lc(hh:name) :
      722                           when "b-help" then
      723                               do:
      724                                   hh:load-image-up("cmp/b-help.bmp":u) .
      725                                   hh:load-image-down("cmp/b-help.bmp":u) .
      726                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      727                                   hh:TOOLTIP = "Помощь" .
      728                                   v-help-old-x = hh:column .
      729                                   v-help-old-y = hh:row    .
      730                                   v-help-old-size = hh:width .
      731                                   hh:width-chars = 2.5 .
      732                               end.
      733                           when "b-print" then
      734                               do:
      735                                   hh:load-image("cmp/b-print.bmp":u) .
      736                                   hh:TOOLTIP = "Печать" .
      737                                   v-h[ii] = hh:handle .
      738                                   ii = ii + 1 .
      739                                   hh:width-chars = 3 .
      740                               end.
      741                           when "b-history" or
      742                           when "b-hist" then
      743                               do:
      744                                   hh:load-image("cmp/b-hist.bmp":u) .
      745                                   hh:TOOLTIP = "История" .
      746                                   v-h[ii] = hh:handle .
      747                                   ii = ii + 1 .
      748                                   hh:width-chars = 3 .
      749                               end.
      750                           when "b-sch" then
      751                               do:
      752                                   hh:load-image("cmp/b-sch.bmp":u) .
      753                                   hh:TOOLTIP = "Установка Фильтра" .
      754                                   v-h[ii] = hh:handle .
      755                                   ii = ii + 1 .
      756                                   hh:width-chars = 3 .
      757                               end.
      758                           when "b-hist-user" then
      759                               do:
      760                                   hh:load-image("cmp/b-hist.bmp":u) .
      761                                   hh:TOOLTIP = "История пользователя" .
      762                                   ii = ii + 1 .
      763                               end.
      764                       end case.
      765                   end.
      766                   hh = hh:next-sibling.
      767               end.
      768               b-help:column = v-frame-width - b-help:width-chars.
      769               jj = 0.
      770               repeat ii = 4 to 1 by -1 :
      771                   if valid-handle (v-h[ii] ) then
      772                   do:
      773                       jj  = jj + 1 .
      774                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      775                       v-h[ii]:row    = v-help-old-y .
      776                   end.
      777               end.
      778           end.
      779       end.
      780   end procedure.
      781   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      782   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      783   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      784   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      785   define variable v-diasize-current-frame-width  as decimal   no-undo .
      786   define variable v-diasize-current-frame-height as decimal   no-undo .
      787   define variable v-diasize-change-size          as logical   no-undo .
      788   define variable v-diasize-resize-button        as handle    no-undo .
      789   define variable v-diasize-wndmax               as logical   no-undo .
      790   define variable v-diasize-wndstore             as logical   no-undo .
      791   define variable v-diasize-proc-name            as character no-undo .
      792   define variable v-diasize-browse-handle        as handle    no-undo .
      793   define variable v-diasize-browse-number        as integer   no-undo .
      794   define variable v-diasize-need-full-display    as logical   no-undo init false .
      795   define temp-table temp-diasize-handle no-undo
      796     field handle-value  as handle
      797     field save-position as decimal
      798     index xpk is primary unique handle-value
      799     .
      800   define temp-table temp-browse-handle no-undo
      801     field browse-type   as character
      802     field browse-number as integer
      803     field browse-handle as handle
      804     field original-size as decimal
      805     index xpk is primary unique browse-type browse-number
      806     index xie browse-type browse-handle
      807   .
      808   procedure diasize_change-height :
      809     define input  parameter p-change-value  as decimal   no-undo .
      810     define input  parameter p-move-resize   as logical   no-undo .
      811     define variable v-field-group-handle    as handle    no-undo .
      812     define variable v-object-handle         as handle    no-undo .
      813     define variable v-frame-height          as decimal   no-undo .
      814     define variable v-frame-virtual-height  as decimal   no-undo .
      815     define variable v-browse-height         as decimal   no-undo .
      816     define variable v-window-height         as decimal   no-undo .
      817     define variable v-window-virtual-height as decimal   no-undo .
      818     define variable v-change-sign           as integer   no-undo .
      819     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      820     define buffer buf_temp-browse-handle  for temp-browse-handle .
      821     if p-change-value > 0
      822     then do:
      823       if frame Dialog-Frame :height + p-change-value
      824           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      825       then do:
      826         assign
      827           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      828                           - (frame Dialog-Frame :height-chars)
      829         .
      830         if p-change-value <= 0
      831         then do:
      832           run diasize_position-resize-button in this-procedure .
      833           return .
      834         end.
      835       end.
      836     end.
      837     if p-change-value < 0
      838     then do:
      839       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      840       then do:
      841         assign
      842           p-change-value = v-diasize-orig-frame-height
      843                          - (frame Dialog-Frame :height-chars)
      844         .
      845         if p-change-value >= 0
      846         then do:
      847           run diasize_position-resize-button in this-procedure .
      848           return .
      849         end.
      850       end.
      851     end.
      852     if p-change-value >= 0
      853     then do:
      854       assign
      855         v-change-sign = 1
      856       .
      857     end.
      858     else do:
      859       assign
      860         v-change-sign = -1
      861       .
      862     end.
      863     assign
      864       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      865     .
      866     if p-change-value = 0
      867     then do:
      868       run diasize_position-resize-button in this-procedure .
      869       return .
      870     end.
      871     move_block:
      872     do
      873     on error undo move_block, retry move_block
      874     :
      875       if retry
      876       then do:
      877         do
      878         on error undo move_block, leave move_block
      879         :
      880           if p-change-value > 0
      881           then do:
      882             for each buf_temp-diasize-handle
      883             on error undo, next
      884             :
      885               assign
      886                 v-object-handle = buf_temp-diasize-handle.handle-value
      887               .
      888               if v-object-handle <> v-diasize-resize-button
      889               then do:
      890                 assign
      891                   v-object-handle :row = buf_temp-diasize-handle.save-position
      892                 .
      893               end.
      894             end.
      895             assign
      896               v-diasize-browse-handle :height = v-browse-height
      897             .
      898             for each buf_temp-browse-handle
      899               where buf_temp-browse-handle.browse-type = 'height':u
      900             on error undo, next
      901             :
      902               assign
      903                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      904               .
      905             end.
      906             assign
      907               frame Dialog-Frame :height = v-frame-height
      908             .
      909             if frame Dialog-Frame :scrollable = true
      910             then do:
      911               assign
      912                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      913               .
      914             end.
      915             run diasize_position-resize-button in this-procedure .
      916           end.
      917           else do:
      918             if frame Dialog-Frame :scrollable = true
      919             then do:
      920               assign
      921                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      922               .
      923             end.
      924             assign
      925               frame Dialog-Frame :height = v-frame-height
      926             .
      927             assign
      928               v-diasize-browse-handle :height = v-browse-height
      929             .
      930             for each buf_temp-browse-handle
      931               where buf_temp-browse-handle.browse-type = 'height':u
      932             on error undo, next
      933             :
      934               assign
      935                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      936               .
      937             end.
      938             for each buf_temp-diasize-handle
      939             on error undo, next
      940             :
      941               assign
      942                 v-object-handle = buf_temp-diasize-handle.handle-value
      943               .
      944               if v-object-handle <> v-diasize-resize-button
      945               then do:
      946                 assign
      947                   v-object-handle :row = buf_temp-diasize-handle.save-position
      948                 .
      949               end.
      950             end.
      951             run diasize_position-resize-button in this-procedure .
      952           end.
      953           assign
      954             v-diasize-change-size = false
      955           .
      956           leave move_block .
      957         end.
      958       end.
      959       assign
      960         v-diasize-need-full-display = true
      961       .
      962       if v-diasize-change-size = false
      963       then do:
      964         assign
      965           v-diasize-change-size = true
      966         .
      967       end.
      968       else do:
      969         return .
      970       end.
      971       assign
      972         v-frame-height = frame Dialog-Frame :height
      973         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      974         v-browse-height = v-diasize-browse-handle :height
      975       .
      976       for each buf_temp-browse-handle
      977         where buf_temp-browse-handle.browse-type = 'height':u
      978       :
      979         assign
      980           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      981         .
      982       end.
      983       for each buf_temp-diasize-handle
      984       :
      985         delete buf_temp-diasize-handle .
      986       end.
      987       assign
      988         v-field-group-handle = frame Dialog-Frame :first-child
      989       .
      990       do while valid-handle(v-field-group-handle)
      991       :
      992         assign
      993           v-object-handle = v-field-group-handle :first-child
      994         .
      995         do while valid-handle(v-object-handle)
      996         :
      997           if  v-object-handle <> v-diasize-browse-handle :handle
      998           and can-query(v-object-handle, "row")
      999           and can-query(v-object-handle, "height")
     1000           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1001           then do:
     1002             find first buf_temp-browse-handle
     1003               where buf_temp-browse-handle.browse-type   = 'height':u
     1004                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1005               no-error .
     1006             if available buf_temp-browse-handle
     1007             then do:
     1008             end.
     1009             else do:
     1010               create buf_temp-diasize-handle .
     1011               assign
     1012                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1013                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1014               .
     1015             end.
     1016           end.
     1017           assign
     1018             v-object-handle = v-object-handle :next-sibling
     1019           .
     1020         end.
     1021         assign
     1022           v-field-group-handle = v-field-group-handle :next-sibling
     1023         .
     1024       end.
     1025       do with frame Dialog-Frame
     1026       :
     1027         hide v-diasize-resize-button .
     1028         assign
     1029           v-diasize-resize-button :row    = 1
     1030           v-diasize-resize-button :column = 1
     1031         .
     1032       end.
     1033       if p-change-value > 0
     1034       then do:
     1035         if frame Dialog-Frame :scrollable = true
     1036         then do:
     1037           assign
     1038             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1039             no-error .
     1040           if error-status :error
     1041           or error-status :get-message(1) <> ""
     1042           then do:
     1043             undo move_block, retry move_block .
     1044           end.
     1045         end.
     1046         assign
     1047           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1048           no-error .
     1049         if error-status :error
     1050         or error-status :get-message(1) <> ""
     1051         then do:
     1052           undo move_block, retry move_block .
     1053         end.
     1054         assign
     1055           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1056           no-error .
     1057         if error-status :error
     1058         or error-status :get-message(1) <> ""
     1059         then do:
     1060           undo move_block, retry move_block .
     1061         end.
     1062         for each buf_temp-browse-handle
     1063           where buf_temp-browse-handle.browse-type = 'height':u
     1064         on error undo move_block, retry move_block
     1065         :
     1066           assign
     1067             buf_temp-browse-handle.browse-handle :height
     1068               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1069             no-error .
     1070           if error-status :error
     1071           or error-status :get-message(1) <> ""
     1072           then do:
     1073             undo move_block, retry move_block .
     1074           end.
     1075         end.
     1076         for each buf_temp-diasize-handle
     1077         on error undo move_block, retry move_block
     1078         :
     1079           assign
     1080             v-object-handle = buf_temp-diasize-handle.handle-value
     1081           .
     1082           if v-object-handle <> v-diasize-resize-button
     1083           then do:
     1084             assign
     1085               v-object-handle :row = v-object-handle :row + p-change-value
     1086               no-error .
     1087             if error-status :error
     1088             or error-status :get-message(1) <> ""
     1089             then do:
     1090               undo move_block, retry move_block .
     1091             end.
     1092           end.
     1093         end.
     1094       end.
     1095       else do:
     1096         for each buf_temp-diasize-handle
     1097         on error undo move_block, retry move_block
     1098         :
     1099           assign
     1100             v-object-handle = buf_temp-diasize-handle.handle-value
     1101           .
     1102           if v-object-handle <> v-diasize-resize-button
     1103           then do:
     1104             assign
     1105               v-object-handle :row = v-object-handle :row + p-change-value
     1106               no-error .
     1107             if error-status :error
     1108             or error-status :get-message(1) <> ""
     1109             then do:
     1110               undo move_block, retry move_block .
     1111             end.
     1112           end.
     1113         end.
     1114         assign
     1115           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1116           no-error .
     1117         if error-status :error
     1118         or error-status :get-message(1) <> ""
     1119         then do:
     1120           undo move_block, retry move_block .
     1121         end.
     1122         for each buf_temp-browse-handle
     1123           where buf_temp-browse-handle.browse-type = 'height':u
     1124         on error undo move_block, retry move_block
     1125         :
     1126           assign
     1127             buf_temp-browse-handle.browse-handle :height
     1128               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1129             no-error .
     1130           if error-status :error
     1131           or error-status :get-message(1) <> ""
     1132           then do:
     1133             undo move_block, retry move_block .
     1134           end.
     1135         end.
     1136         assign
     1137           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1138           no-error .
     1139         if error-status :error
     1140         or error-status :get-message(1) <> ""
     1141         then do:
     1142           undo move_block, retry move_block .
     1143         end.
     1144         if frame Dialog-Frame :scrollable = true
     1145         then do:
     1146           assign
     1147             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1148             no-error .
     1149           if error-status :error
     1150           or error-status :get-message(1) <> ""
     1151           then do:
     1152             undo move_block, retry move_block .
     1153           end.
     1154         end.
     1155       end.
     1156       if p-move-resize = true
     1157       then do:
     1158         run diasize_position-resize-button in this-procedure .
     1159       end.
     1160       if v-diasize-wndstore = true
     1161       then do:
     1162         if connected("ub") = true
     1163         then do:
     1164           define variable v-cntxt-db-num        as integer   no-undo .
     1165           define variable v-cntxt-userid        as character no-undo .
     1166           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1167                                             , OUTPUT v-cntxt-userid
     1168                                             ) .
     1169           run gbl/wndsizew.p
     1170             (input  v-cntxt-db-num
     1171             ,input  v-cntxt-userid
     1172             ,input  v-diasize-proc-name
     1173             ,input  'height':u
     1174             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1175             ) .
     1176         end.
     1177       end.
     1178     end.
     1179     assign
     1180       v-diasize-change-size = false
     1181     .
     1182   end procedure.
     1183   procedure diasize_set-height :
     1184     define input  parameter p-new-height  as decimal   no-undo .
     1185     define input  parameter p-move-resize as logical   no-undo .
     1186     do
     1187     on error undo, return error return-value
     1188     :
     1189       run diasize_change-height in this-procedure
     1190         (input  (p-new-height - frame Dialog-Frame :height)
     1191         ,input  p-move-resize
     1192         ) .
     1193     end.
     1194   end procedure.
     1195   procedure diasize_change-width :
     1196     define input  parameter p-change-value as decimal   no-undo .
     1197     define input  parameter p-move-resize  as logical   no-undo .
     1198     define variable v-field-group-handle   as handle    no-undo .
     1199     define variable v-object-handle        as handle    no-undo .
     1200     define variable v-frame-width          as decimal   no-undo .
     1201     define variable v-frame-virtual-width  as decimal   no-undo .
     1202     define variable v-browse-width         as decimal   no-undo .
     1203     define variable v-window-width         as decimal   no-undo .
     1204     define variable v-window-virtual-width as decimal   no-undo .
     1205     define variable v-change-sign          as integer   no-undo .
     1206     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1207     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1208     if p-change-value > 0
     1209     then do:
     1210       if frame Dialog-Frame :width + p-change-value >
     1211           session :width-chars
     1212       then do:
     1213         assign
     1214           p-change-value = session :width-chars - frame Dialog-Frame :width
     1215         .
     1216         if p-change-value <= 0
     1217         then do:
     1218           run diasize_position-resize-button in this-procedure .
     1219           return .
     1220         end.
     1221       end.
     1222     end.
     1223     if p-change-value < 0
     1224     then do:
     1225       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1226       then do:
     1227         assign
     1228           p-change-value = v-diasize-orig-frame-width
     1229                          - frame Dialog-Frame :width
     1230         .
     1231         if p-change-value >= 0
     1232         then do:
     1233           run diasize_position-resize-button in this-procedure .
     1234           return .
     1235         end.
     1236       end.
     1237     end.
     1238     if p-change-value >= 0
     1239     then do:
     1240       assign
     1241         v-change-sign = 1
     1242       .
     1243     end.
     1244     else do:
     1245       assign
     1246         v-change-sign = -1
     1247       .
     1248     end.
     1249     assign
     1250       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1251     .
     1252     if p-change-value = 0
     1253     then do:
     1254       run diasize_position-resize-button in this-procedure .
     1255       return .
     1256     end.
     1257     move_block:
     1258     do
     1259     on error undo move_block, leave move_block
     1260     :
     1261       if retry
     1262       then do:
     1263         do
     1264         on error undo move_block, leave move_block
     1265         :
     1266           if p-change-value > 0
     1267           then do:
     1268             for each buf_temp-diasize-handle
     1269             on error undo, next
     1270             :
     1271               assign
     1272                 v-object-handle = buf_temp-diasize-handle.handle-value
     1273               .
     1274               if v-object-handle <> v-diasize-resize-button
     1275               then do:
     1276                 assign
     1277                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1278                 .
     1279               end.
     1280             end.
     1281             assign
     1282               v-diasize-browse-handle :width = v-browse-width
     1283             .
     1284             for each buf_temp-browse-handle
     1285               where buf_temp-browse-handle.browse-type = 'width':u
     1286             on error undo, next
     1287             :
     1288               assign
     1289                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1290               .
     1291             end.
     1292             assign
     1293               frame Dialog-Frame :width = v-frame-width
     1294             .
     1295             if frame Dialog-Frame :scrollable = true
     1296             then do:
     1297               assign
     1298                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1299               .
     1300             end.
     1301             run diasize_position-resize-button in this-procedure .
     1302           end.
     1303           else do:
     1304             if frame Dialog-Frame :scrollable = true
     1305             then do:
     1306               assign
     1307                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1308               .
     1309             end.
     1310             assign
     1311               frame Dialog-Frame :width = v-frame-width
     1312             .
     1313             for each buf_temp-browse-handle
     1314               where buf_temp-browse-handle.browse-type = 'width':u
     1315             on error undo, next
     1316             :
     1317               assign
     1318                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1319               .
     1320             end.
     1321             assign
     1322               v-diasize-browse-handle :width = v-browse-width
     1323             .
     1324             for each buf_temp-diasize-handle
     1325             on error undo, next
     1326             :
     1327               assign
     1328                 v-object-handle = buf_temp-diasize-handle.handle-value
     1329               .
     1330               if v-object-handle <> v-diasize-resize-button
     1331               then do:
     1332                 assign
     1333                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1334                 .
     1335               end.
     1336             end.
     1337             run diasize_position-resize-button in this-procedure .
     1338           end.
     1339           assign
     1340             v-diasize-change-size = false
     1341           .
     1342           leave move_block .
     1343         end.
     1344       end.
     1345       assign
     1346         v-diasize-need-full-display = true
     1347       .
     1348       if v-diasize-change-size = false
     1349       then do:
     1350         assign
     1351           v-diasize-change-size = true
     1352         .
     1353       end.
     1354       else do:
     1355         return .
     1356       end.
     1357       assign
     1358         v-frame-width = frame Dialog-Frame :width
     1359         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1360         v-browse-width = v-diasize-browse-handle :width
     1361       .
     1362       for each buf_temp-browse-handle
     1363         where buf_temp-browse-handle.browse-type = 'width':u
     1364       :
     1365         assign
     1366           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1367         .
     1368       end.
     1369       for each buf_temp-diasize-handle
     1370       :
     1371         delete buf_temp-diasize-handle .
     1372       end.
     1373       assign
     1374         v-field-group-handle = frame Dialog-Frame :first-child
     1375       .
     1376       do while valid-handle(v-field-group-handle)
     1377       :
     1378         assign
     1379           v-object-handle = v-field-group-handle :first-child
     1380         .
     1381         do while valid-handle(v-object-handle)
     1382         :
     1383           if  v-object-handle <> v-diasize-browse-handle :handle
     1384           and v-object-handle <> v-diasize-resize-button
     1385           and can-query(v-object-handle, "row")
     1386           and can-query(v-object-handle, "height")
     1387           and ( v-object-handle :col + v-object-handle :width
     1388                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1389               )
     1390           then do:
     1391             find first buf_temp-browse-handle
     1392               where buf_temp-browse-handle.browse-type   = 'width':u
     1393                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1394               no-error .
     1395             if available buf_temp-browse-handle
     1396             then do:
     1397             end.
     1398             else do:
     1399               create buf_temp-diasize-handle .
     1400               assign
     1401                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1402                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1403               .
     1404             end.
     1405           end.
     1406           assign
     1407             v-object-handle = v-object-handle :next-sibling
     1408           .
     1409         end.
     1410         assign
     1411           v-field-group-handle = v-field-group-handle :next-sibling
     1412         .
     1413       end.
     1414       do with frame Dialog-Frame
     1415       :
     1416         hide v-diasize-resize-button .
     1417         v-diasize-resize-button :row = 1.
     1418         v-diasize-resize-button :column = 1.
     1419       end.
     1420       if p-change-value > 0
     1421       then do:
     1422         if frame Dialog-Frame :scrollable = true
     1423         then do:
     1424           assign
     1425             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1426             no-error .
     1427           if error-status :error
     1428           or error-status :get-message(1) <> ""
     1429           then do:
     1430             undo move_block, retry move_block.
     1431           end.
     1432         end.
     1433         assign
     1434           frame Dialog-Frame :width = v-frame-width + p-change-value
     1435           no-error .
     1436         if error-status :error
     1437         or error-status :get-message(1) <> ""
     1438         then do:
     1439           undo move_block, retry move_block.
     1440         end.
     1441         assign
     1442           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1443         no-error .
     1444         if error-status :error
     1445         or error-status :get-message(1) <> ""
     1446         then do:
     1447           undo move_block, retry move_block.
     1448         end.
     1449         for each buf_temp-browse-handle
     1450           where buf_temp-browse-handle.browse-type = 'width':u
     1451         on error undo move_block, retry move_block
     1452         :
     1453           assign
     1454             buf_temp-browse-handle.browse-handle :width
     1455               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1456             no-error .
     1457           if error-status :error
     1458           or error-status :get-message(1) <> ""
     1459           then do:
     1460             undo move_block, retry move_block .
     1461           end.
     1462         end.
     1463         for each buf_temp-diasize-handle
     1464         on error undo move_block, retry move_block
     1465         :
     1466           assign
     1467             v-object-handle = buf_temp-diasize-handle.handle-value
     1468           .
     1469           if v-object-handle <> v-diasize-resize-button
     1470           then do:
     1471             assign
     1472               v-object-handle :col = v-object-handle :col + p-change-value
     1473               no-error .
     1474             if error-status :error
     1475             or error-status :get-message(1) <> ""
     1476             then do:
     1477               undo move_block, retry move_block .
     1478             end.
     1479           end.
     1480         end.
     1481       end.
     1482       else do:
     1483         for each buf_temp-diasize-handle
     1484         on error undo move_block, retry move_block
     1485         :
     1486           assign
     1487             v-object-handle = buf_temp-diasize-handle.handle-value
     1488           .
     1489           if v-object-handle <> v-diasize-resize-button
     1490           then do:
     1491             assign
     1492               v-object-handle :col = v-object-handle :col + p-change-value
     1493               no-error .
     1494             if error-status :error
     1495             or error-status :get-message(1) <> ""
     1496             then do:
     1497               undo move_block, retry move_block .
     1498             end.
     1499           end.
     1500         end.
     1501         for each buf_temp-browse-handle
     1502           where buf_temp-browse-handle.browse-type = 'width':u
     1503         on error undo move_block, retry move_block
     1504         :
     1505           assign
     1506             buf_temp-browse-handle.browse-handle :width
     1507               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1508             no-error .
     1509           if error-status :error
     1510           or error-status :get-message(1) <> ""
     1511           then do:
     1512             undo move_block, retry move_block .
     1513           end.
     1514         end.
     1515         assign
     1516           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1517           no-error .
     1518         if error-status :error
     1519         or error-status :get-message(1) <> ""
     1520         then do:
     1521           undo move_block, retry move_block.
     1522         end.
     1523         assign
     1524           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1525         no-error .
     1526         if error-status :error
     1527         or error-status :get-message(1) <> ""
     1528         then do:
     1529           undo move_block, retry move_block.
     1530         end.
     1531         if frame Dialog-Frame :scrollable = true
     1532         then do:
     1533           assign
     1534             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1535           no-error .
     1536           if error-status :error
     1537           or error-status :get-message(1) <> ""
     1538           then do:
     1539             undo move_block, retry move_block.
     1540           end.
     1541         end.
     1542       end.
     1543       if p-move-resize
     1544       then do:
     1545         run diasize_position-resize-button in this-procedure .
     1546       end.
     1547       if v-diasize-wndstore = true
     1548       then do:
     1549         if connected("ub") = true
     1550         then do:
     1551           define variable v-cntxt-db-num        as integer   no-undo .
     1552           define variable v-cntxt-userid        as character no-undo .
     1553           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1554                                             , OUTPUT v-cntxt-userid
     1555                                             ) .
     1556           run gbl/wndsizew.p
     1557             (input  v-cntxt-db-num
     1558             ,input  v-cntxt-userid
     1559             ,input  v-diasize-proc-name
     1560             ,input  'width':u
     1561             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1562             ) .
     1563         end.
     1564       end.
     1565     end.
     1566     assign
     1567       v-diasize-change-size = false
     1568     .
     1569   end procedure.
     1570   procedure diasize_set-width :
     1571     define input  parameter p-new-width  as decimal   no-undo .
     1572     define input  parameter p-move-resize as logical   no-undo .
     1573     do
     1574     on error undo, return error return-value
     1575     :
     1576       run diasize_change-width in this-procedure
     1577         (input  (p-new-width - frame Dialog-Frame :width)
     1578         ,input  p-move-resize
     1579         ) .
     1580     end.
     1581   end procedure.
     1582   procedure diasize_position-resize-button :
     1583     do with frame Dialog-Frame
     1584     :
     1585       hide v-diasize-resize-button .
     1586       assign
     1587         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1588                     - 1
     1589                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1590         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1591                     - 1
     1592                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1593       .
     1594       view v-diasize-resize-button .
     1595     end.
     1596   end procedure.
     1597   on alt-right anywhere
     1598   do:
     1599     run diasize_change-width in this-procedure
     1600       (input 1
     1601       ,input true
     1602       ) .
     1603     return no-apply .
     1604   end.
     1605   on alt-left anywhere
     1606   do:
     1607     run diasize_change-width in this-procedure
     1608       (input -1
     1609       ,input true
     1610       ) .
     1611     return no-apply .
     1612   end.
     1613   on alt-down anywhere
     1614   do:
     1615     run diasize_change-height in this-procedure
     1616       (input 1
     1617       ,input true
     1618       ) .
     1619     return no-apply .
     1620   end.
     1621   on alt-up anywhere
     1622   do:
     1623     run diasize_change-height in this-procedure
     1624       (input -1
     1625       ,input true
     1626       ) .
     1627     return no-apply .
     1628   end.
     1629   on alt-enter of frame Dialog-Frame
     1630   do:
     1631     run diasize_maximize in this-procedure
     1632       (input  ?
     1633       ).
     1634     return no-apply .
     1635   end.
     1636   procedure diasize_end-move :
     1637     do
     1638     on error undo, return error return-value
     1639     :
     1640       define variable v-row-delta as decimal   no-undo .
     1641       define variable v-col-delta as decimal   no-undo .
     1642       define variable v-new-row as decimal   no-undo .
     1643       define variable v-new-col as decimal   no-undo .
     1644       assign
     1645         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1646         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1647       .
     1648       assign
     1649         v-row-delta = v-new-row - frame Dialog-Frame :height
     1650         v-col-delta = v-new-col - frame Dialog-Frame :width
     1651       .
     1652       run diasize_change-height in this-procedure
     1653         (input v-row-delta
     1654         ,input true
     1655         ) .
     1656       run diasize_change-width in this-procedure
     1657         (input v-col-delta
     1658         ,input true
     1659         ) .
     1660     end.
     1661   end procedure.
     1662   procedure diasize_maximize :
     1663     define input  parameter p-action as logical   no-undo .
     1664     do
     1665     on error undo, return error return-value
     1666     :
     1667       if p-action = ?
     1668       then do:
     1669         if v-diasize-need-maximize = true
     1670         then do:
     1671           assign
     1672             p-action = true
     1673           .
     1674         end.
     1675         else do:
     1676           assign
     1677             p-action = false
     1678           .
     1679         end.
     1680       end.
     1681       if p-action = true
     1682       then do:
     1683         run diasize_change-height in this-procedure
     1684           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1685               - frame Dialog-Frame :height-chars
     1686           ,input true
     1687           ) .
     1688         run diasize_change-width in this-procedure
     1689           (input session :width-chars
     1690               - frame Dialog-Frame :width-chars
     1691           ,input true
     1692           ) .
     1693         assign
     1694           v-diasize-need-maximize = false
     1695         .
     1696       end.
     1697       else do:
     1698         run diasize_change-width in this-procedure
     1699           (input v-diasize-orig-frame-width
     1700               - frame Dialog-Frame :width-chars
     1701           ,input true
     1702           ) .
     1703         run diasize_change-height in this-procedure
     1704           (input v-diasize-orig-frame-height
     1705               - frame Dialog-Frame :height-chars
     1706           ,input true
     1707           ) .
     1708         assign
     1709           v-diasize-need-maximize = true
     1710         .
     1711       end.
     1712     end.
     1713   end procedure.
     1714   procedure diasize_restore-orig-size :
     1715     do
     1716     on error undo, return error return-value
     1717     :
     1718       assign
     1719         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1720         v-diasize-current-frame-height = frame Dialog-Frame :height
     1721       .
     1722       run diasize_set-height in this-procedure
     1723         (input  v-diasize-orig-frame-height
     1724         ,input  true
     1725         ) .
     1726       run diasize_set-width in this-procedure
     1727         (input  v-diasize-orig-frame-width
     1728         ,input  true
     1729         ) .
     1730     end.
     1731   end procedure.
     1732   procedure diasize_restore-current-size :
     1733     do
     1734     on error undo, return error return-value
     1735     :
     1736       run diasize_set-height in this-procedure
     1737         (input  v-diasize-current-frame-height
     1738         ,input  true
     1739         ) .
     1740       run diasize_set-width in this-procedure
     1741         (input  v-diasize-current-frame-width
     1742         ,input  true
     1743         ) .
     1744     end.
     1745   end procedure.
     1746   procedure diasize_set-browse-handle :
     1747     define input  parameter p-browse-handle as handle   no-undo .
     1748     define buffer buf_temp-browse-handle for temp-browse-handle .
     1749     do
     1750     on error undo, return error return-value
     1751     :
     1752       assign
     1753         v-diasize-browse-handle = p-browse-handle
     1754       .
     1755       for each buf_temp-browse-handle
     1756       on error undo, return error return-value
     1757       :
     1758         delete buf_temp-browse-handle .
     1759       end.
     1760     end.
     1761   end procedure.
     1762   procedure diasize_add_browse :
     1763     define input  parameter p-browse-type   as character no-undo .
     1764     define input  parameter p-browse-handle as handle    no-undo .
     1765     define buffer buf_temp-browse-handle for temp-browse-handle .
     1766     do
     1767     on error undo, return error return-value
     1768     :
     1769       assign
     1770         v-diasize-browse-number = v-diasize-browse-number + 1
     1771       .
     1772       create buf_temp-browse-handle .
     1773       assign
     1774         buf_temp-browse-handle.browse-type   = p-browse-type
     1775         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1776         buf_temp-browse-handle.browse-handle = p-browse-handle
     1777       .
     1778     end.
     1779   end procedure.
     1780   procedure diasize_init :
     1781     define variable v-default-value    as logical   no-undo .
     1782     define variable v-restore-saved    as logical   no-undo .
     1783     define variable v-resize-value-str as character no-undo .
     1784     do
     1785     on error undo, return error return-value
     1786     :
     1787       do with frame Dialog-Frame
     1788       :
     1789         assign
     1790           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1791           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1792           v-diasize-browse-handle     = browse br-attr :handle
     1793         .
     1794         create button v-diasize-resize-button
     1795         assign
     1796           parent        = frame Dialog-Frame :first-child
     1797           label         = "s"
     1798           height-pixels = 16
     1799           width-pixels  = 16
     1800           visible       = true
     1801           sensitive     = true
     1802           movable       = true
     1803           triggers:
     1804             on end-move persistent run diasize_end-move in this-procedure .
     1805           end triggers.
     1806         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1807         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1808         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1809         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1810         assign
     1811           v-diasize-wndmax = false
     1812         .
     1813         if connected("ub") = true
     1814         then do:
     1815           define variable v-cntxt-db-num        as integer   no-undo .
     1816           define variable v-cntxt-userid        as character no-undo .
     1817           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1818                                             , OUTPUT v-cntxt-userid
     1819                                             ) .
     1820           run gbl/wndpar_r.p
     1821             (input  v-cntxt-db-num
     1822             ,input  v-cntxt-userid
     1823             ,input  'wndmax':U
     1824             ,output v-diasize-wndmax
     1825             ,output v-default-value
     1826             ) .
     1827         end.
     1828         assign
     1829           v-diasize-wndstore = false
     1830         .
     1831         if connected("ub") = true
     1832         then do:
     1833           run gbl/wndpar_r.p
     1834             (input  v-cntxt-db-num
     1835             ,input  v-cntxt-userid
     1836             ,input  'wndstore':U
     1837             ,output v-diasize-wndstore
     1838             ,output v-default-value
     1839             ) .
     1840         end.
     1841         assign
     1842           v-diasize-proc-name = entry(1, program-name(2), '.')
     1843         .
     1844         if v-diasize-wndstore = true
     1845         then do:
     1846           assign
     1847             v-restore-saved = false
     1848           .
     1849           if connected("ub") = true
     1850           then do:
     1851             run gbl/wndsizer.p
     1852               (input  v-cntxt-db-num
     1853               ,input  v-cntxt-userid
     1854               ,input  v-diasize-proc-name
     1855               ,input  'height':u
     1856               ,output v-resize-value-str
     1857               ) .
     1858             if v-resize-value-str <> '':U
     1859             then do:
     1860               run diasize_change-height in this-procedure
     1861                 (input  integer(v-resize-value-str)
     1862                 ,input  true
     1863                 ) .
     1864               assign
     1865                 v-restore-saved = true
     1866               .
     1867             end.
     1868           end.
     1869           if connected("ub") = true
     1870           then do:
     1871             run gbl/wndsizer.p
     1872               (input  v-cntxt-db-num
     1873               ,input  v-cntxt-userid
     1874               ,input  v-diasize-proc-name
     1875               ,input  'width':u
     1876               ,output v-resize-value-str
     1877               ) .
     1878             if v-resize-value-str <> '':U
     1879             then do:
     1880               run diasize_change-width in this-procedure
     1881                 (input  integer(v-resize-value-str)
     1882                 ,input  true
     1883                 ) .
     1884               assign
     1885                 v-restore-saved = true
     1886               .
     1887             end.
     1888           end.
     1889           if v-restore-saved <> true
     1890           then do:
     1891             if v-diasize-wndmax = true
     1892             then do:
     1893               run diasize_maximize in this-procedure
     1894                 (input  true
     1895                 ) .
     1896             end.
     1897           end.
     1898         end.
     1899         else do:
     1900           if v-diasize-wndmax = true
     1901           then do:
     1902             run diasize_maximize in this-procedure
     1903               (input  true
     1904               ) .
     1905           end.
     1906         end.
     1907       end.
     1908     end.
     1909   end procedure.
     1910   procedure diasize_need-full-display :
     1911     define output parameter p-need-full-display as logical   no-undo .
     1912     do
     1913     on error undo, return error return-value
     1914     :
     1915       assign
     1916         p-need-full-display = v-diasize-need-full-display
     1917       .
     1918       assign
     1919         v-diasize-need-full-display = false
     1920       .
     1921     end.
     1922   end procedure.
     1923   procedure get-context :
     1924      define output parameter p-db-num as integer          no-undo.
     1925      define output parameter p-user-id as character        no-undo.
     1926      define variable v-login               as character    no-undo.
     1927      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1928      define buffer buf_user-login  for ub.user-login .
     1929      do
     1930      on error undo, return error
     1931      :
     1932            FIND FIRST buf_sys-ctrl no-lock.
     1933            ASSIGN
     1934               v-login = USERID("ub")
     1935               p-db-num = buf_sys-ctrl.db-num
     1936            .
     1937            FIND FIRST buf_user-login
     1938                 WHERE buf_user-login.db-num = p-db-num
     1939                   AND buf_user-login.user-login = v-login
     1940                 no-lock
     1941                 no-error
     1942                 .
     1943            IF AVAILABLE buf_user-login
     1944            THEN DO:
     1945               assign
     1946                  p-user-id = buf_user-login.user-id
     1947               .
     1948            END.
     1949      end.
     1950   end procedure.
     1951       run diasize_init in this-procedure .
     1952   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1953   do:
     1954     br-attr :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     1955   end.
     1956   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1957   on f5 of frame Dialog-Frame anywhere
     1958   do:
     1959     OPEN QUERY br-attr FOR EACH temp-attr NO-LOCK.
     1960       apply "VALUE-CHANGED" to br-attr.
     1961   end.
     1962   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1963   ON TAB ANYWHERE
     1964   DO:
     1965   define variable ii as integer no-undo .
     1966   define variable fh as widget-handle no-undo .
     1967   define variable hh as widget-handle no-undo .
     1968   define variable v-next-widget-name as character no-undo .
     1969   if v-tab-order <> '' then do:
     1970     if self:type = "TOGGLE-BOX" then
     1971     self:BGCOLOR = ?.
     1972     assign
     1973     ii = lookup(self:name, v-tab-order).
     1974     assign
     1975     ii = ii + 1
     1976     v-next-widget-name = entry(ii, v-tab-order)
     1977     no-error .
     1978     if error-status:error then do:
     1979       assign
     1980       ii = 1
     1981       v-next-widget-name = entry( ii, v-tab-order)
     1982       .
     1983     end.
     1984     assign
     1985     fh = frame Dialog-Frame:first-child
     1986     hh = fh:first-child
     1987     .
     1988     do while valid-handle(hh):
     1989       if hh:name = v-next-widget-name then do:
     1990         if hh:sensitive  = yes
     1991         AND hh:visible = yes then do:
     1992           if hh:type = "TOGGLE-BOX":U then do:
     1993             assign
     1994             hh:BGcolor = 1
     1995             .
     1996           end.
     1997           APPLY "ENTRY" to hh.
     1998           return no-apply.
     1999         end.
     2000         else do:
     2001           APPLY "TAB" to hh.
     2002           return no-apply.
     2003         end.
     2004       end.
     2005       hh = hh:next-sibling.
     2006     end.
     2007   end.
     2008   END.
     2009   ON BACK-TAB ANYWHERE
     2010   DO:
     2011   define variable ii as integer no-undo .
     2012   define variable fh as widget-handle no-undo .
     2013   define variable hh as widget-handle no-undo .
     2014   define variable v-next-widget-name as character no-undo .
     2015   if v-tab-order <> '' then do:
     2016     assign
     2017     ii = lookup(self:name, v-tab-order).
     2018     .
     2019     assign
     2020     ii = (if ii = 1
     2021           then  num-entries(v-tab-order)
     2022           else ii - 1
     2023           )
     2024     v-next-widget-name = entry(ii, v-tab-order)
     2025     .
     2026     assign
     2027     fh = frame Dialog-Frame:first-child
     2028     hh = fh:first-child
     2029     .
     2030     do while valid-handle(hh):
     2031       if hh:name = v-next-widget-name then do:
     2032         if hh:sensitive  = yes
     2033         AND hh:visible = yes then do:
     2034           if hh:type = "TOGGLE-BOX":U then do:
     2035             assign
     2036             hh:BGcolor = 1
     2037             .
     2038           end.
     2039           APPLY "ENTRY" to hh.
     2040           return no-apply.
     2041         end.
     2042         else do:
     2043         APPLY "BACK-TAB" to hh.
     2044         return no-apply.
     2045         end.
     2046       end.
     2047       hh = hh:next-sibling.
     2048     end.
     2049     end.
     2050   END.
     2051   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2052   ON RETURN ANYWHERE
     2053   DO:
     2054   define variable ii as integer no-undo .
     2055   define variable fh as widget-handle no-undo .
     2056   define variable hh as widget-handle no-undo .
     2057   define variable v-next-widget-name as character no-undo .
     2058     if v-tab-order <> '' then do:
     2059       assign
     2060       ii = lookup(self:name, v-tab-order).
     2061       if ii = num-entries(v-tab-order) then do:
     2062           APPLY 'CHOOSE' TO b-quit in frame Dialog-Frame.
     2063           return no-apply.
     2064       end.
     2065       if self:type <> "BUTTON" and
     2066         self:type <> "EDITOR"  then do:
     2067         run proc-move-forward in this-procedure .
     2068         return no-apply.
     2069       end.
     2070       if self:type = "BUTTON" then do:
     2071         APPLY "CHOOSE" to self.
     2072       end.
     2073       if self:type = "TOGGLE-BOX" then
     2074       self:BGCOLOR = ?.
     2075       assign
     2076       ii = ii + 1
     2077       v-next-widget-name = entry(ii, v-tab-order)
     2078       no-error .
     2079       if error-status:error then do:
     2080         assign
     2081         ii = 1
     2082         v-next-widget-name = entry( ii, v-tab-order)
     2083         .
     2084       end.
     2085       assign
     2086       fh = frame Dialog-Frame:first-child
     2087       hh = fh:first-child
     2088       .
     2089       do while valid-handle(hh):
     2090         if hh:name = v-next-widget-name then do:
     2091           if hh:sensitive  = yes
     2092           AND hh:visible = yes then do:
     2093             if hh:type = "TOGGLE-BOX":U then do:
     2094               assign
     2095               hh:BGcolor = 1
     2096               .
     2097             end.
     2098             APPLY "ENTRY" to hh.
     2099             return no-apply.
     2100           end.
     2101           else do:
     2102             APPLY "TAB" to hh.
     2103             return no-apply.
     2104           end.
     2105         end.
     2106         hh = hh:next-sibling.
     2107       end.
     2108     end.
     2109   END.
     2110   procedure proc-move-forward :
     2111   define variable ii as integer no-undo .
     2112   define variable fh as widget-handle no-undo .
     2113   define variable hh as widget-handle no-undo .
     2114   define variable v-next-widget-name as character no-undo .
     2115   do
     2116   on error undo, return error
     2117   :
     2118     if v-tab-order <> '' then do:
     2119       if self:type = "TOGGLE-BOX" then
     2120       self:BGCOLOR = ?.
     2121       assign
     2122       ii = lookup(self:name, v-tab-order).
     2123       assign
     2124       ii = ii + 1
     2125       v-next-widget-name = entry(ii, v-tab-order)
     2126       no-error .
     2127       if error-status:error then do:
     2128         assign
     2129         ii = 1
     2130         v-next-widget-name = entry( ii, v-tab-order)
     2131         .
     2132       end.
     2133       assign
     2134       fh = frame Dialog-Frame:first-child
     2135       hh = fh:first-child
     2136       .
     2137       do while valid-handle(hh):
     2138         if hh:name = v-next-widget-name then do:
     2139           if hh:sensitive  = yes
     2140           AND hh:visible = yes then do:
     2141             if hh:type = "TOGGLE-BOX":U then do:
     2142               assign
     2143               hh:BGcolor = 1
     2144               .
     2145             end.
     2146             APPLY "ENTRY" to hh.
     2147             return.
     2148           end.
     2149           else do:
     2150             assign
     2151             ii = ii + 1
     2152             v-next-widget-name = entry(ii, v-tab-order)
     2153             no-error .
     2154             if error-status:error then do:
     2155               assign
     2156               ii = 1
     2157               v-next-widget-name = entry( ii, v-tab-order)
     2158               .
     2159             end.
     2160           end.
     2161         end.
     2162         hh = hh:next-sibling.
     2163       end.
     2164     end.
     2165   end.
     2166   end procedure.
     2167   frame Dialog-Frame:TITLE = frame Dialog-Frame:TITLE.
     2168   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2169   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2170   MAIN-BLOCK:
     2171   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2172      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2173   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2174     RUN MyEnable in this-procedure no-error.
     2175     if error-status:error then return error.
     2176     Run init-proc in this-procedure .
     2177     view frame Dialog-Frame .
     2178     WAIT-FOR GO OF FRAME Dialog-Frame.
     2179   END.
     2180   RUN disable_UI in this-procedure .
     2181   run attr-pop-clean-up in this-procedure ( input 'db-attr':U ).
     2182   if updated then return 'ИЗМЕНЕНИЕ':U.
     2183   PROCEDURE choose-to-edit :
     2184   define input parameter p-attr-code as character no-undo .
     2185   assign
     2186   add-option = p-attr-code
     2187   .
     2188   APPLY "CHOOSE" to b-add in frame Dialog-Frame .
     2189   END PROCEDURE.
     2190   PROCEDURE disable_UI :
     2191     HIDE FRAME Dialog-Frame.
     2192   END PROCEDURE.
     2193   PROCEDURE enable_UI :
     2194     DISPLAY db-db-num
     2195         WITH FRAME Dialog-Frame.
     2196     ENABLE b-quit b-add b-lkp b-chg b-del b-help db-db-num
     2197         WITH FRAME Dialog-Frame.
     2198     VIEW FRAME Dialog-Frame.
     2199     OPEN QUERY br-attr FOR EACH temp-attr NO-LOCK.
     2200   END PROCEDURE.
     2201   PROCEDURE init-proc :
     2202   define var  attr-type as character no-undo .
     2203   define var  attr-format as character no-undo .
     2204   define var  attr-label as character no-undo .
     2205   define var  attr-value as character no-undo .
     2206   define var  attr-user-can-edit as logical no-undo .
     2207   define var  attr-output-display as logical no-undo .
     2208   define var  attr-other as char no-undo .
     2209   define buffer buf_db for ub.db.
     2210   define buffer buf_db-attr for ub.db-attr.
     2211   for each  Temp-attr share-lock: delete Temp-attr. end.
     2212   add-option = "".
     2213   find first buf_db where
     2214            buf_db.db-num =  p-db-num  no-lock no-error .
     2215   Assign
     2216   db-db-num = buf_db.db-num
     2217   .
     2218   display db-db-num
     2219   with frame Dialog-Frame  .
     2220      For each buf_db-attr where
     2221               buf_db-attr.db-num  = p-db-num  no-lock :
     2222         run db-attr-code in this-procedure (
     2223                            input buf_db-attr.attr-code ,
     2224                             output attr-type ,
     2225                             output attr-format,
     2226                             output attr-label,
     2227                             output attr-user-can-edit,
     2228                             output attr-output-display,
     2229                             output attr-other ).
     2230         if attr-output-display = true then DO:
     2231             run db-attr-value in this-procedure (
     2232                                  input buf_db-attr.db-num
     2233                                 ,input buf_db-attr.attr-code
     2234                                 ,output attr-value
     2235                                 ,output attr-type ).
     2236             create temp-attr.
     2237             assign
     2238             temp-attr.attr-code = attr-label
     2239             temp-attr.value_ = buf_db-attr.attr-value
     2240             temp-attr.attr-value = (if attr-type = 'L':U
     2241                                     then string(attr-value = "yes":U, attr-format)
     2242                                     else attr-value)
     2243             temp-attr.user-can-edit = attr-user-can-edit
     2244             temp-attr.code = buf_db-attr.attr-code
     2245             .
     2246         End.
     2247       End.
     2248       OPEN QUERY br-attr FOR EACH temp-attr NO-LOCK.
     2249   END PROCEDURE.
     2250   PROCEDURE MyEnable :
     2251   define variable alco-val as character no-undo .
     2252   define variable alco-type as character no-undo .
     2253   assign
     2254   b-add:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-add:HANDLE
     2255   v-tab-order = "b-quit,b-add,b-lkp,b-chg,b-del,b-help,br-attr"
     2256   temp-attr.attr-code:width in browse br-attr = 50
     2257   temp-attr.attr-code:resizable in browse br-attr = yes
     2258   .
     2259   if p-mode <> 'ПРОСМОТР':U then do:
     2260     run attr-pop-create-items in this-procedure  (
     2261                                                   input 'db-attr':U
     2262                                                   ,input 'db-attr-manual-edit'
     2263                                                   ,input 'db-attr-tooltip'
     2264                                                   ,input 'choose-to-edit'
     2265                                                   ,input menu menu-b-add:handle
     2266                                                   ,input 'schedule-nws,schedule-arc,schedule-exp,schedule-oxml,need-gen-new-pack,last-unload-db-key,schedule-cdimp,schedule-getcd,schedule-sale,schedule-suz,cut-date,cut-fin-date,unload-after-cut,cut-db-list,schedule-cbnk,arh-disable,ahsp-disable,aht-disable,schedule-free,ora-exp-seq':u
     2267                                                 ).
     2268   end.
     2269   DISPLAY db-db-num
     2270   WITH FRAME Dialog-Frame .
     2271   ENABLE
     2272   b-quit
     2273   b-help br-attr db-db-num
     2274   WITH FRAME Dialog-Frame .
     2275   VIEW FRAME Dialog-Frame .
     2276   ASSIGN b-add:MENU-MOUSE = 1.
     2277   HIDE
     2278   b-add
     2279   b-del
     2280   b-chg
     2281   b-lkp
     2282   IN FRAME Dialog-Frame.
     2283   OPEN QUERY br-attr FOR EACH temp-attr NO-LOCK.
     2284   APPLY "ENTRY" to br-attr.
     2285   END PROCEDURE.
     2286   PROCEDURE proc-add-chg :
     2287   define input parameter p-add as logical no-undo .
     2288   define variable attr-type as character no-undo .
     2289   define variable attr-format as character no-undo .
     2290   define variable attr-label as character no-undo .
     2291   define variable attr-user-can-edit as logical no-undo .
     2292   define variable attr-output-display as logical no-undo .
     2293   define variable attr-other as char no-undo .
     2294   define variable attr-value as character no-undo .
     2295   define variable v-attr-value as character no-undo .
     2296   define variable v-init as character no-undo .
     2297   define variable jj as integer no-undo.
     2298   DEFINE VARIABLE v-spr as character no-undo .
     2299   define variable v-spr-param as character no-undo .
     2300   DEFINE VARIABLE v-setted as logical no-undo .
     2301   DEFINE VARIABLE v-deleted as logical no-undo .
     2302   define variable v-check as character no-undo .
     2303   define variable v-error-code as character no-undo .
     2304   define variable v-correct as logical no-undo .
     2305   define variable v-host-code like ub.sysconf.host-code no-undo .
     2306   define variable v-obj-type like ub.clients.obj-type no-undo .
     2307   define variable v-obj-code like ub.clients.obj-code no-undo .
     2308   define variable v-ask-labels as character no-undo .
     2309   define variable choice as integer no-undo .
     2310   define var loc#log as logical no-undo.
     2311   case p-add:
     2312     when yes then do:
     2313       run db-attr-code in this-procedure (
     2314          input  add-option
     2315         ,output attr-type
     2316         ,output attr-format
     2317         ,output attr-label
     2318         ,output attr-user-can-edit
     2319         ,output attr-output-display
     2320         ,output attr-other
     2321         ) no-error .
     2322       if error-status :error then do:
     2323         return error .
     2324       end.
     2325       assign
     2326       added = yes.
     2327       if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
     2328         run temp-db-attr-exist in this-procedure (
     2329                                        input p-db-num
     2330                                       ,input add-option
     2331                                       ,output loc#log)  no-error.
     2332         if error-status:error then return error.
     2333         if loc#log then do:
     2334           message
     2335           "Данный атрибут уже существует"
     2336           view-as alert-box error .
     2337           return error.
     2338         end.
     2339       end.
     2340       do jj = 1 to num-entries(attr-other, chr(47)):
     2341         if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "init":U then do:
     2342           assign
     2343           v-init = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     2344           .
     2345         end.
     2346       end.
     2347       if  v-init <> "":U then do:
     2348           run  value(v-init)
     2349                       in this-procedure (
     2350                                             input p-db-num
     2351                                           , output attr-value) no-error .
     2352             if error-status:error then do:
     2353                 assign
     2354                 attr-value = "":U
     2355                 .
     2356             end.
     2357       end.
     2358       CASE attr-type:
     2359         when 'L':U then do:
     2360           assign
     2361           v-attr-value = "yes":U
     2362           .
     2363         end.
     2364         when 'I':U or when 'D':U then do:
     2365           assign
     2366           v-attr-value = if v-init <> "":U
     2367                         then attr-value
     2368                         else string(0)
     2369           .
     2370         end.
     2371         when 'T':U then do:
     2372           assign
     2373           v-attr-value = ?
     2374           .
     2375         end.
     2376         when 'C':U then do:
     2377           assign
     2378           v-attr-value = if v-init <> "":U
     2379                         then attr-value
     2380                         else "":U
     2381           .
     2382         end.
     2383       END CASE.
     2384       assign
     2385       attr-value = v-attr-value
     2386       .
     2387     end.
     2388     when no then do:
     2389       run db-attr-code in this-procedure (
     2390                                        input temp-attr.code
     2391                                       ,output attr-type
     2392                                       ,output attr-format
     2393                                       ,output attr-label
     2394                                       ,output attr-user-can-edit
     2395                                       ,output attr-output-display
     2396                                       ,output attr-other) no-error.
     2397       IF ERROR-STATUS:ERROR THEN DO:
     2398           message "Ошибка при определении названия и типа атрибута БД"         "Обратитесь к администратору системы" skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     2399           return error.
     2400       END.
     2401       RUN db-attr-VALUE IN THIS-PROCEDURE (
     2402                                             INPUT p-db-num
     2403                                            ,input temp-attr.code
     2404                                            ,OUTPUT ATTR-VALUE
     2405                                            ,OUTPUT attr-type) NO-ERROR.
     2406       IF ERROR-STATUS:ERROR THEN DO:
     2407           message "Ошибка при определении значения атрибута БД!"         "Обратитесь к администратору системы" skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     2408           return error.
     2409       END.
     2410     end.
     2411   END CASE.
     2412   IF attr-user-can-edit Then DO:
     2413     do jj = 1 to num-entries(attr-other, chr(47)):
     2414       if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "spr":U then do:
     2415         assign
     2416         v-spr = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     2417         .
     2418       end.
     2419       if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "spr-param":U then do:
     2420         assign
     2421         v-spr-param = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     2422         .
     2423       end.
     2424       if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "check":U then do:
     2425         assign
     2426         v-check = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     2427         .
     2428       end.
     2429     end.
     2430     if v-spr = "":U then do:
     2431       run gbl/d-prompt.w (
     2432         'title=':u + "Изменение атрибута БД" + '\':u
     2433       + 'text1=':u + attr-label + '\':u
     2434       + 'format=' + (if attr-type = 'L':U then "yes/no" else attr-format) + '\':u
     2435       + 'type=' + attr-type + '\':u
     2436       + 'fillin_row=2\':u
     2437       + 'fillin_col=4\':u
     2438       + 'fillin_width=20\':u
     2439       + 'fillin_height=1\':u
     2440       + 'max-chars=70\':u
     2441       + 'readonly=' + (if p-mode <> 'ИЗМЕНЕНИЕ':U then 'yes':u else 'no':u) + '\':u
     2442       , input-output attr-value
     2443           ).
     2444       if return-value = 'false':u then return error.
     2445     END.
     2446     ELSE DO:
     2447       if v-spr-param = "":U then do:
     2448         run  value(v-spr)
     2449                     in this-procedure (
     2450                                          input p-db-num
     2451                                         ,input-output attr-value
     2452                                         ,output v-setted) no-error .
     2453       end.
     2454       else do:
     2455         run  value( v-spr )
     2456                   in this-procedure (
     2457                                          input p-db-num
     2458                                         ,input v-spr-param
     2459                                         ,input-output attr-value
     2460                                         ,output v-setted) no-error .
     2461       end.
     2462       if not v-setted then return error.
     2463     end.
     2464     if v-check <> "":U then do:
     2465       run value(v-check)(
     2466                          input p-db-num
     2467                         ,input (if p-add = yes then add-option else temp-attr.attr-code)
     2468                         ,input attr-value
     2469                         ,input (if p-add then 'ДОБАВЛЕНИЕ':U else 'ИЗМЕНЕНИЕ':U)
     2470                         ,output v-correct
     2471                         ,output v-error-code) no-error.
     2472       if error-status:error then do:
     2473         message
     2474         "Ошибка при проверке корректности задаваемого значения атрибута" skip
     2475         error-status:get-message(1) skip
     2476         view-as alert-box error .
     2477         undo, return error .
     2478       end.
     2479       if not v-correct then do:
     2480         message
     2481         "Задаваемое значение атрибута некорректно" skip
     2482         return-value
     2483         view-as alert-box error .
     2484         undo, return error .
     2485       end.
     2486     end.
     2487     run db-attr-write in this-procedure (
     2488                                        input p-db-num
     2489                                       ,input (if p-add then add-option else temp-attr.code)
     2490                                       ,input attr-value
     2491                                      ) no-error .
     2492     IF NOT error-status:error then do:
     2493         assign
     2494         updated = yes
     2495         .
     2496     END.
     2497     else do:
     2498     end.
     2499   End.
     2500   Else message "Изменение атрибута невозможно !" view-as alert-box error.
     2501   END PROCEDURE.
     2502   PROCEDURE proc-b-lkp :
     2503   define variable attr-type as character no-undo .
     2504   define variable attr-format as character no-undo .
     2505   define variable attr-label as character no-undo .
     2506   define variable attr-user-can-edit as logical no-undo .
     2507   define variable attr-output-display as logical no-undo .
     2508   define variable attr-other as char no-undo .
     2509   define variable attr-value as char no-undo .
     2510   define variable v-run-name as character no-undo .
     2511   define variable jj as integer no-undo .
     2512   run db-attr-code in this-procedure (
     2513                                         input temp-attr.code
     2514                                         ,output attr-type
     2515                                         ,output attr-format
     2516                                         ,output attr-label
     2517                                         ,output attr-user-can-edit
     2518                                         ,output attr-output-display
     2519                                         ,output attr-other) no-error.
     2520   IF ERROR-STATUS:ERROR THEN DO:
     2521       message "Ошибка при определении названия и типа атрибута БД"         "Обратитесь к администратору системы" skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     2522       return error.
     2523   END.
     2524   do jj = 1 to num-entries(attr-other, chr(47)):
     2525     if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "display" then do:
     2526       v-run-name = entry(2, entry(jj, attr-other, chr(47)), "=":U).
     2527       run value(v-run-name) in this-procedure (
     2528                                                input p-db-num
     2529                                               ,input temp-attr.attr-code
     2530                                               ,input temp-attr.value_
     2531                                                )
     2532                                                no-error .
     2533       if error-status:error then undo, return error .
     2534       return .
     2535     end.
     2536   END.
     2537   BELL.
     2538   END PROCEDURE.
     2539   PROCEDURE temp-db-attr-exist :
     2540     do
     2541     on error undo, return error
     2542     :
     2543       define input parameter p-db-num like ub.db-attr.db-num   no-undo .
     2544       define input parameter p-code     like ub.db-attr.attr-code  no-undo .
     2545       define output parameter p-exist    as logical no-undo .
     2546       define buffer buf_db-attr for ub.db-attr .
     2547       define buffer buf_temp-attr for temp-attr .
     2548       define variable v-type           as character no-undo .
     2549       define variable v-format         as character no-undo .
     2550       define variable v-label          as character no-undo .
     2551       define variable v-user-can-edit  as logical   no-undo .
     2552       define variable v-output-display as logical   no-undo .
     2553       define variable v-other          as character no-undo .
     2554       run db-attr-code in this-procedure (
     2555                                               input  p-code
     2556                                               ,output v-type
     2557                                               ,output v-format
     2558                                               ,output v-label
     2559                                               ,output v-user-can-edit
     2560                                               ,output v-output-display
     2561                                               ,output v-other
     2562                                               ) no-error .
     2563       if error-status :error then do:
     2564         undo, return error return-value .
     2565       end.
     2566       find first buf_temp-attr no-lock where
     2567                  buf_temp-attr.db-num  = p-db-num AND
     2568                  buf_temp-attr.attr-code = p-code no-error .
     2569       if available buf_temp-attr then do:
     2570         P-EXIST = YES.
     2571       end.
     2572     end.
     2573   END PROCEDURE.
