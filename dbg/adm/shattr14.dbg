      615   procedure proc-alt-shift-f2:
      616     if not ibs.th.gbl.gbl-var:rcode
      617   then
      618     run gbl\inidebug.p .
      619   end.
      620   procedure proc-alt-shift-f3:
      621     run gbl/prvssinf.p
      622       ( input this-procedure
      623       ) .
      624   end.
      625   define variable v-inform-launched as logical no-undo initial false .
      626   procedure proc-alt-shift-f4:
      627     define variable v-action as character no-undo .
      628     if v-inform-launched = false then do:
      629       assign
      630         v-inform-launched = true
      631       .
      632       run gbl/d-inform.w
      633         (  input self
      634         ,  input this-procedure
      635         , output v-action
      636         ) no-error .
      637       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      638       assign
      639         v-inform-launched = false
      640       .
      641     end.
      642   end.
      643   procedure proc-alt-f1:
      644     run gbl/corrhelp.p
      645       (input this-procedure
      646       ) .
      647   end .
      648   on alt-shift-f2 anywhere do:
      649     run proc-alt-shift-f2.
      650   end.
      651   on alt-shift-f3 anywhere do:
      652     run proc-alt-shift-f3 in this-procedure .
      653   end.
      654   on alt-shift-f4 anywhere do:
      655     run proc-alt-shift-f4 in this-procedure.
      656   end.
      657   on alt-f1 anywhere do:
      658     run proc-alt-f1 in this-procedure .
      659   end.
      660   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      661     define variable v-cntxt-db-num        as integer   no-undo .
      662     define variable v-cntxt-userid        as character no-undo .
      663     define variable v-cntxt-level         as character no-undo .
      664     define variable v-cntxt-host-code-obj as integer   no-undo .
      665     define variable v-cntxt-obj-type      as character no-undo .
      666     define variable v-cntxt-obj-code      as integer   no-undo .
      667     define variable v-cntxt-db-num-obj    as integer   no-undo .
      668     define variable v-cntxt-is-admin      as logical   no-undo .
      669   DEFINE VARIABLE v-db-num LIKE ub.db.db-num NO-UNDO.
      670   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO.
      671   DEFINE VARIABLE v-to-create AS logical NO-UNDO.
      672   DEFINE VARIABLE v-host-code LIKE ub.shop.host-code NO-UNDO.
      673   DEFINE VARIABLE v-base-code LIKE ub.sysconf.base-code NO-UNDO.
      674   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      675   define variable v-tth as handle no-undo .
      676   assign
      677   v-tth = buffer thbjattr_thbj-attr:table-handle .
      678   define temp-table temp-xtd no-undo
      679   field id as integer format "99"
      680   field f-value AS CHARACTER
      681   field f-label AS CHARACTER
      682   index pi is unique
      683   primary
      684   id
      685   .
      686   DEFINE BUTTON B-down
      687        LABEL "В&низ"
      688        SIZE 10 BY 1.
      689   DEFINE BUTTON B-exit AUTO-GO
      690        LABEL "&Ввод"
      691        SIZE 10 BY 1
      692        BGCOLOR 8 .
      693   DEFINE BUTTON B-Help
      694        LABEL "Помо&щь"
      695        SIZE 3 BY 1
      696        BGCOLOR 8 .
      697   DEFINE BUTTON b-quit AUTO-END-KEY
      698        LABEL "&Отмена"
      699        SIZE 10 BY 1
      700        BGCOLOR 8 .
      701   DEFINE BUTTON B-up
      702        LABEL "Вв&ерх"
      703        SIZE 10 BY 1.
      704   DEFINE VARIABLE E-save-param AS CHARACTER
      705        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      706        SIZE 49 BY 8 NO-UNDO.
      707   DEFINE VARIABLE l-ncrdrank AS CHARACTER FORMAT "X(256)":U INITIAL "Приоритет скидки на товар"
      708         VIEW-AS TEXT
      709        SIZE 31.5 BY .67 NO-UNDO.
      710   DEFINE VARIABLE l-ncrdrank-2 AS CHARACTER FORMAT "X(256)":U INITIAL "при наличии скидок неск. типов:"
      711         VIEW-AS TEXT
      712        SIZE 31.5 BY .67 NO-UNDO.
      713   DEFINE VARIABLE l-ncrpgpfx AS CHARACTER FORMAT "X(256)":U INITIAL "Префикс штучного бар-кода для весов:"
      714         VIEW-AS TEXT
      715        SIZE 35 BY .67 NO-UNDO.
      716   DEFINE VARIABLE l-ncrscpfx AS CHARACTER FORMAT "X(256)":U INITIAL "Префикс весового бар-кода:"
      717         VIEW-AS TEXT
      718        SIZE 26 BY .67 NO-UNDO.
      719   DEFINE VARIABLE l-save-param AS CHARACTER FORMAT "X(256)":U INITIAL "Расположение резервных копий неизменяемых"
      720         VIEW-AS TEXT
      721        SIZE 46.5 BY .67 NO-UNDO.
      722   DEFINE VARIABLE l-save-param-2 AS CHARACTER FORMAT "X(256)":U INITIAL "'ручных настроек' для кассы"
      723         VIEW-AS TEXT
      724        SIZE 45.5 BY .67 NO-UNDO.
      725   DEFINE VARIABLE RS-ncrpgpfx AS INTEGER
      726        VIEW-AS RADIO-SET HORIZONTAL
      727        RADIO-BUTTONS
      728             "24", 24,
      729   "28", 28
      730        SIZE 12 BY 1 NO-UNDO.
      731   DEFINE VARIABLE RS-ncrscpfx AS INTEGER
      732        VIEW-AS RADIO-SET HORIZONTAL
      733        RADIO-BUTTONS
      734             "23", 23,
      735   "25", 25
      736        SIZE 12 BY 1 NO-UNDO.
      737   DEFINE VARIABLE RS-save-param AS CHARACTER
      738        VIEW-AS RADIO-SET VERTICAL
      739        RADIO-BUTTONS
      740             "Не используется", "no",
      741   "В директории файлов кассовых настроек", "NCR",
      742   "В директории кодов IBS TH", "IBS"
      743        SIZE 45.5 BY 3.77 NO-UNDO.
      744   DEFINE QUERY BR-xtd FOR
      745         temp-xtd SCROLLING.
      746   DEFINE BROWSE BR-xtd
      747     QUERY BR-xtd DISPLAY
      748         temp-xtd.id COLUMN-LABEL "Приоритет"
      749   temp-xtd.f-label COLUMN-LABEL "Тип скидки" FORMAT "X(20)"
      750       WITH NO-ROW-MARKERS SEPARATORS SIZE 34 BY 9.2 ROW-HEIGHT-CHARS .67.
      751   DEFINE FRAME Dialog-Frame
      752        B-exit AT ROW 1 COL 1
      753        b-quit AT ROW 1 COL 11
      754        B-Help AT ROW 1 COL 95
      755        RS-ncrscpfx AT ROW 2 COL 27 NO-LABEL
      756        RS-ncrpgpfx AT ROW 2 COL 80 NO-LABEL WIDGET-ID 4
      757        RS-save-param AT ROW 4.77 COL 49.5 NO-LABEL
      758        BR-xtd AT ROW 5.77 COL 2
      759        B-up AT ROW 5.77 COL 37
      760        B-down AT ROW 6.77 COL 37
      761        E-save-param AT ROW 8.5 COL 49.5 NO-LABEL
      762        l-ncrscpfx AT ROW 2 COL 1 NO-LABEL
      763        l-ncrpgpfx AT ROW 2 COL 42 NO-LABEL WIDGET-ID 2
      764        l-save-param AT ROW 3 COL 49.5 NO-LABEL
      765        l-save-param-2 AT ROW 3.77 COL 49.5 NO-LABEL
      766        l-ncrdrank AT ROW 4 COL 2.5 NO-LABEL
      767        l-ncrdrank-2 AT ROW 4.77 COL 2.5 NO-LABEL
      768        SPACE(65.24) SKIP(11.13)
      769       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      770            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      771            TITLE "Параметры POS NCR-AS@R"
      772            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      773   ASSIGN
      774          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      775          FRAME Dialog-Frame:HIDDEN           = TRUE.
      776   ASSIGN
      777          E-save-param:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      778   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      779   DO:
      780     APPLY "END-ERROR":U TO SELF.
      781   END.
      782   ON CHOOSE OF B-down IN FRAME Dialog-Frame
      783   DO:
      784   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      785   if lookup(self :type
      786            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      787            ) = 0
      788   then do:
      789     message
      790       "$Workfile$"
      791       "Указанному интерфейсному элементу фокус не может быть передан" skip
      792       "Интерфейсный элемент" self :name  skip
      793       "Тип" self :type  skip
      794       "Процедура" this-procedure :file-name skip
      795       view-as alert-box .
      796   end.
      797   else do:
      798     apply "entry":u to self  .
      799     if focus :handle <> self :handle  then do:
      800       return no-apply .
      801     end.
      802   end.
      803    DEFINE VARIABLE v-new AS INTEGER NO-UNDO.
      804   DEFINE VARIABLE v-old AS INTEGER NO-UNDO.
      805   DEFINE BUFFER buf_temp-xtd FOR temp-xtd.
      806    IF NOT AVAILABLE temp-xtd THEN RETURN NO-APPLY.
      807   FIND last buf_temp-xtd WHERE
      808               USE-INDEX pi .
      809    IF temp-xtd.id = buf_temp-xtd.id THEN DO:
      810        BELL.
      811        RETURN NO-APPLY.
      812    END.
      813    ASSIGN
      814    v-old = temp-xtd.Id
      815    v-new = temp-xtd.id + 1
      816    .
      817    FIND FIRST buf_temp-xtd WHERE
      818               buf_temp-xtd.id = v-new NO-ERROR.
      819    ASSIGN
      820    temp-xtd.id = 0.
      821    RELEASE temp-xtd.
      822    buf_temp-xtd.id = v-old.
      823    RELEASE buf_temp-xtd.
      824    FIND FIRST buf_temp-xtd WHERE
      825               buf_temp-xtd.id = 0.
      826    ASSIGN
      827    buf_temp-xtd.id = v-new.
      828    RELEASE buf_temp-xtd.
      829    OPEN QUERY BR-xtd FOR EACH temp-xtd.
      830   END.
      831   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      832   DO:
      833     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      834     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      835   END.
      836   ON CHOOSE OF B-up IN FRAME Dialog-Frame
      837   DO:
      838   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      839   if lookup(self :type
      840            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      841            ) = 0
      842   then do:
      843     message
      844       "$Workfile$"
      845       "Указанному интерфейсному элементу фокус не может быть передан" skip
      846       "Интерфейсный элемент" self :name  skip
      847       "Тип" self :type  skip
      848       "Процедура" this-procedure :file-name skip
      849       view-as alert-box .
      850   end.
      851   else do:
      852     apply "entry":u to self  .
      853     if focus :handle <> self :handle  then do:
      854       return no-apply .
      855     end.
      856   end.
      857   DEFINE VARIABLE v-new AS INTEGER NO-UNDO.
      858   DEFINE VARIABLE v-old AS INTEGER NO-UNDO.
      859   DEFINE BUFFER buf_temp-xtd FOR temp-xtd.
      860    IF NOT AVAILABLE temp-xtd THEN RETURN NO-APPLY.
      861    IF temp-xtd.id = 1 THEN DO:
      862        BELL.
      863        RETURN NO-APPLY.
      864    END.
      865    ASSIGN
      866    v-old = temp-xtd.Id
      867    v-new = temp-xtd.id - 1
      868    .
      869    FIND FIRST buf_temp-xtd WHERE
      870               buf_temp-xtd.id = v-new NO-ERROR.
      871    ASSIGN
      872    temp-xtd.id = 0.
      873    RELEASE temp-xtd.
      874    buf_temp-xtd.id = v-old.
      875    RELEASE buf_temp-xtd.
      876    FIND FIRST buf_temp-xtd WHERE
      877               buf_temp-xtd.id = 0.
      878    ASSIGN
      879    buf_temp-xtd.id = v-new.
      880    RELEASE buf_temp-xtd.
      881    OPEN QUERY BR-xtd FOR EACH temp-xtd.
      882   END.
      883   ON VALUE-CHANGED OF RS-save-param IN FRAME Dialog-Frame
      884   DO:
      885     ASSIGN
      886     rs-save-param.
      887     CASE rs-save-param:
      888         WHEN 'no':U THEN DO:
      889             ASSIGN
      890             e-save-param:SCREEN-VALUE = "При передаче на кассы различных типов скидок " +
      891                                        "(на итог чека, скидок для различных категорий покупателей и т.д.) или настроек," +
      892                                        " хранящихся в файлах кассовых настроек S_PLURBT.DAT " +
      893                                        "и/или group_xx.dat и/или P_REGPAR.DAT, НЕ ИСПОЛЬЗУЕТСЯ дополнительная проверка, " +
      894                                        "можно ли данный тип скидки или настройки задавать пересылкой через IBS TH " +
      895                                        "или же данная скидка может быть изменена ТОЛЬКО администратором вручную - " +
      896                                        "РЕЗЕРВНЫЕ КОПИИ для данных файлов НЕ ХРАНЯТСЯ".
      897         END.
      898         WHEN 'IBS':U THEN DO:
      899             ASSIGN
      900             e-save-param:SCREEN-VALUE = "При передаче на кассы различных типов скидок " +
      901                                        "(на итог чека, скидок для различных категорий покупателей и т.д.) или настроек," +
      902                                        " хранящихся в файлах кассовых настроек S_PLURBT.DAT " +
      903                                        "и/или group_xx.dat и/или P_REGPAR.DAT, ИСПОЛЬЗУЕТСЯ дополнительная проверка, " +
      904                                        "можно ли данный тип скидки или настройки задавать пересылкой через IBS TH " +
      905                                        "или же данная скидка может быть изменена ТОЛЬКО администратором вручную - " +
      906                                        "РЕЗЕРВНЫЕ КОПИИ для данных файлов (с расширением .sav) ХРАНЯТСЯ в директориях системы IBS TH".
      907         END.
      908         WHEN 'NCR':U THEN DO:
      909             ASSIGN
      910             e-save-param:SCREEN-VALUE = "При передаче на кассы различных типов скидок " +
      911                                        "(на итог чека, скидок для различных категорий покупателей и т.д.) или настроек," +
      912                                        " хранящихся в файлах кассовых настроек S_PLURBT.DAT " +
      913                                        "и/или group_xx.dat и/или P_REGPAR.DAT, ИСПОЛЬЗУЕТСЯ дополнительная проверка, " +
      914                                        "можно ли данный тип скидки или настройки задавать пересылкой через IBS TH " +
      915                                        "или же данная скидка может быть изменена ТОЛЬКО администратором вручную - " +
      916                                        "РЕЗЕРВНЫЕ КОПИИ для данных файлов (с расширением .sav) ХРАНЯТСЯ " +
      917                                        "рядом с основными файлами - в директориях, " +
      918                                        "задаваемых настройками out2, out3, out4 секции [kassa-ncr-as-r] ini-файла системы IBS TH".
      919         END.
      920     ENd CASE.
      921   END.
      922   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      923   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      924   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      925   on help of frame Dialog-Frame
      926   do:
      927     run gbl/app_help.p
      928       (input this-procedure :file-name
      929       ,input ''
      930       ,input ?
      931       ) no-error.
      932     if error-status :error then do:
      933       message
      934         "Ошибка при вызове помощи"
      935         error-status :get-message(1)
      936         view-as alert-box .
      937     end.
      938   end.
      939   run minbtn-set in this-procedure .
      940   on choose of b-help in frame Dialog-Frame
      941   do:
      942     apply "help":u to frame Dialog-Frame .
      943   end.
      944   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      945   procedure minbtn-set :
      946       do
      947           on error undo, return error return-value
      948           :
      949           define variable ii              as integer       no-undo .
      950           define variable fh              as widget-handle no-undo .
      951           define variable hh              as widget-handle no-undo .
      952           define variable v-h             as handle        extent 4 no-undo .
      953           define variable v-name-button   as character     no-undo .
      954           define variable v-help-old-x    as decimal       no-undo .
      955           define variable v-help-old-y    as decimal       no-undo .
      956           define variable v-help-old-size as decimal       no-undo .
      957           define variable v-frame-width   as decimal       no-undo .
      958           define variable jj              as integer       no-undo .
      959           do
      960               on error undo, return error
      961               :
      962               assign
      963                   v-frame-width = frame Dialog-Frame:width - 0.3
      964                   fh            = frame Dialog-Frame:first-child
      965                   hh            = fh:first-child
      966                   ii            = 1
      967                   .
      968               do while valid-handle(hh):
      969                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      970                   do:
      971                       case lc(hh:name) :
      972                           when "b-help" then
      973                               do:
      974                                   hh:load-image-up("cmp/b-help.bmp":u) .
      975                                   hh:load-image-down("cmp/b-help.bmp":u) .
      976                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      977                                   hh:TOOLTIP = "Помощь" .
      978                                   v-help-old-x = hh:column .
      979                                   v-help-old-y = hh:row    .
      980                                   v-help-old-size = hh:width .
      981                                   hh:width-chars = 2.5 .
      982                               end.
      983                           when "b-print" then
      984                               do:
      985                                   hh:load-image("cmp/b-print.bmp":u) .
      986                                   hh:TOOLTIP = "Печать" .
      987                                   v-h[ii] = hh:handle .
      988                                   ii = ii + 1 .
      989                                   hh:width-chars = 3 .
      990                               end.
      991                           when "b-history" or
      992                           when "b-hist" then
      993                               do:
      994                                   hh:load-image("cmp/b-hist.bmp":u) .
      995                                   hh:TOOLTIP = "История" .
      996                                   v-h[ii] = hh:handle .
      997                                   ii = ii + 1 .
      998                                   hh:width-chars = 3 .
      999                               end.
     1000                           when "b-sch" then
     1001                               do:
     1002                                   hh:load-image("cmp/b-sch.bmp":u) .
     1003                                   hh:TOOLTIP = "Установка Фильтра" .
     1004                                   v-h[ii] = hh:handle .
     1005                                   ii = ii + 1 .
     1006                                   hh:width-chars = 3 .
     1007                               end.
     1008                           when "b-hist-user" then
     1009                               do:
     1010                                   hh:load-image("cmp/b-hist.bmp":u) .
     1011                                   hh:TOOLTIP = "История пользователя" .
     1012                                   ii = ii + 1 .
     1013                               end.
     1014                       end case.
     1015                   end.
     1016                   hh = hh:next-sibling.
     1017               end.
     1018               b-help:column = v-frame-width - b-help:width-chars.
     1019               jj = 0.
     1020               repeat ii = 4 to 1 by -1 :
     1021                   if valid-handle (v-h[ii] ) then
     1022                   do:
     1023                       jj  = jj + 1 .
     1024                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1025                       v-h[ii]:row    = v-help-old-y .
     1026                   end.
     1027               end.
     1028           end.
     1029       end.
     1030   end procedure.
     1031   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1032   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1033   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1034   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1035   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1036   define variable v-diasize-current-frame-height as decimal   no-undo .
     1037   define variable v-diasize-change-size          as logical   no-undo .
     1038   define variable v-diasize-resize-button        as handle    no-undo .
     1039   define variable v-diasize-wndmax               as logical   no-undo .
     1040   define variable v-diasize-wndstore             as logical   no-undo .
     1041   define variable v-diasize-proc-name            as character no-undo .
     1042   define variable v-diasize-browse-handle        as handle    no-undo .
     1043   define variable v-diasize-browse-number        as integer   no-undo .
     1044   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1045   define temp-table temp-diasize-handle no-undo
     1046     field handle-value  as handle
     1047     field save-position as decimal
     1048     index xpk is primary unique handle-value
     1049     .
     1050   define temp-table temp-browse-handle no-undo
     1051     field browse-type   as character
     1052     field browse-number as integer
     1053     field browse-handle as handle
     1054     field original-size as decimal
     1055     index xpk is primary unique browse-type browse-number
     1056     index xie browse-type browse-handle
     1057   .
     1058   procedure diasize_change-height :
     1059     define input  parameter p-change-value  as decimal   no-undo .
     1060     define input  parameter p-move-resize   as logical   no-undo .
     1061     define variable v-field-group-handle    as handle    no-undo .
     1062     define variable v-object-handle         as handle    no-undo .
     1063     define variable v-frame-height          as decimal   no-undo .
     1064     define variable v-frame-virtual-height  as decimal   no-undo .
     1065     define variable v-browse-height         as decimal   no-undo .
     1066     define variable v-window-height         as decimal   no-undo .
     1067     define variable v-window-virtual-height as decimal   no-undo .
     1068     define variable v-change-sign           as integer   no-undo .
     1069     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1070     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1071     if p-change-value > 0
     1072     then do:
     1073       if frame Dialog-Frame :height + p-change-value
     1074           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1075       then do:
     1076         assign
     1077           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1078                           - (frame Dialog-Frame :height-chars)
     1079         .
     1080         if p-change-value <= 0
     1081         then do:
     1082           run diasize_position-resize-button in this-procedure .
     1083           return .
     1084         end.
     1085       end.
     1086     end.
     1087     if p-change-value < 0
     1088     then do:
     1089       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1090       then do:
     1091         assign
     1092           p-change-value = v-diasize-orig-frame-height
     1093                          - (frame Dialog-Frame :height-chars)
     1094         .
     1095         if p-change-value >= 0
     1096         then do:
     1097           run diasize_position-resize-button in this-procedure .
     1098           return .
     1099         end.
     1100       end.
     1101     end.
     1102     if p-change-value >= 0
     1103     then do:
     1104       assign
     1105         v-change-sign = 1
     1106       .
     1107     end.
     1108     else do:
     1109       assign
     1110         v-change-sign = -1
     1111       .
     1112     end.
     1113     assign
     1114       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1115     .
     1116     if p-change-value = 0
     1117     then do:
     1118       run diasize_position-resize-button in this-procedure .
     1119       return .
     1120     end.
     1121     move_block:
     1122     do
     1123     on error undo move_block, retry move_block
     1124     :
     1125       if retry
     1126       then do:
     1127         do
     1128         on error undo move_block, leave move_block
     1129         :
     1130           if p-change-value > 0
     1131           then do:
     1132             for each buf_temp-diasize-handle
     1133             on error undo, next
     1134             :
     1135               assign
     1136                 v-object-handle = buf_temp-diasize-handle.handle-value
     1137               .
     1138               if v-object-handle <> v-diasize-resize-button
     1139               then do:
     1140                 assign
     1141                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1142                 .
     1143               end.
     1144             end.
     1145             assign
     1146               v-diasize-browse-handle :height = v-browse-height
     1147             .
     1148             for each buf_temp-browse-handle
     1149               where buf_temp-browse-handle.browse-type = 'height':u
     1150             on error undo, next
     1151             :
     1152               assign
     1153                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1154               .
     1155             end.
     1156             assign
     1157               frame Dialog-Frame :height = v-frame-height
     1158             .
     1159             if frame Dialog-Frame :scrollable = true
     1160             then do:
     1161               assign
     1162                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1163               .
     1164             end.
     1165             run diasize_position-resize-button in this-procedure .
     1166           end.
     1167           else do:
     1168             if frame Dialog-Frame :scrollable = true
     1169             then do:
     1170               assign
     1171                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1172               .
     1173             end.
     1174             assign
     1175               frame Dialog-Frame :height = v-frame-height
     1176             .
     1177             assign
     1178               v-diasize-browse-handle :height = v-browse-height
     1179             .
     1180             for each buf_temp-browse-handle
     1181               where buf_temp-browse-handle.browse-type = 'height':u
     1182             on error undo, next
     1183             :
     1184               assign
     1185                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1186               .
     1187             end.
     1188             for each buf_temp-diasize-handle
     1189             on error undo, next
     1190             :
     1191               assign
     1192                 v-object-handle = buf_temp-diasize-handle.handle-value
     1193               .
     1194               if v-object-handle <> v-diasize-resize-button
     1195               then do:
     1196                 assign
     1197                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1198                 .
     1199               end.
     1200             end.
     1201             run diasize_position-resize-button in this-procedure .
     1202           end.
     1203           assign
     1204             v-diasize-change-size = false
     1205           .
     1206           leave move_block .
     1207         end.
     1208       end.
     1209       assign
     1210         v-diasize-need-full-display = true
     1211       .
     1212       if v-diasize-change-size = false
     1213       then do:
     1214         assign
     1215           v-diasize-change-size = true
     1216         .
     1217       end.
     1218       else do:
     1219         return .
     1220       end.
     1221       assign
     1222         v-frame-height = frame Dialog-Frame :height
     1223         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1224         v-browse-height = v-diasize-browse-handle :height
     1225       .
     1226       for each buf_temp-browse-handle
     1227         where buf_temp-browse-handle.browse-type = 'height':u
     1228       :
     1229         assign
     1230           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1231         .
     1232       end.
     1233       for each buf_temp-diasize-handle
     1234       :
     1235         delete buf_temp-diasize-handle .
     1236       end.
     1237       assign
     1238         v-field-group-handle = frame Dialog-Frame :first-child
     1239       .
     1240       do while valid-handle(v-field-group-handle)
     1241       :
     1242         assign
     1243           v-object-handle = v-field-group-handle :first-child
     1244         .
     1245         do while valid-handle(v-object-handle)
     1246         :
     1247           if  v-object-handle <> v-diasize-browse-handle :handle
     1248           and can-query(v-object-handle, "row")
     1249           and can-query(v-object-handle, "height")
     1250           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1251           then do:
     1252             find first buf_temp-browse-handle
     1253               where buf_temp-browse-handle.browse-type   = 'height':u
     1254                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1255               no-error .
     1256             if available buf_temp-browse-handle
     1257             then do:
     1258             end.
     1259             else do:
     1260               create buf_temp-diasize-handle .
     1261               assign
     1262                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1263                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1264               .
     1265             end.
     1266           end.
     1267           assign
     1268             v-object-handle = v-object-handle :next-sibling
     1269           .
     1270         end.
     1271         assign
     1272           v-field-group-handle = v-field-group-handle :next-sibling
     1273         .
     1274       end.
     1275       do with frame Dialog-Frame
     1276       :
     1277         hide v-diasize-resize-button .
     1278         assign
     1279           v-diasize-resize-button :row    = 1
     1280           v-diasize-resize-button :column = 1
     1281         .
     1282       end.
     1283       if p-change-value > 0
     1284       then do:
     1285         if frame Dialog-Frame :scrollable = true
     1286         then do:
     1287           assign
     1288             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1289             no-error .
     1290           if error-status :error
     1291           or error-status :get-message(1) <> ""
     1292           then do:
     1293             undo move_block, retry move_block .
     1294           end.
     1295         end.
     1296         assign
     1297           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1298           no-error .
     1299         if error-status :error
     1300         or error-status :get-message(1) <> ""
     1301         then do:
     1302           undo move_block, retry move_block .
     1303         end.
     1304         assign
     1305           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1306           no-error .
     1307         if error-status :error
     1308         or error-status :get-message(1) <> ""
     1309         then do:
     1310           undo move_block, retry move_block .
     1311         end.
     1312         for each buf_temp-browse-handle
     1313           where buf_temp-browse-handle.browse-type = 'height':u
     1314         on error undo move_block, retry move_block
     1315         :
     1316           assign
     1317             buf_temp-browse-handle.browse-handle :height
     1318               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1319             no-error .
     1320           if error-status :error
     1321           or error-status :get-message(1) <> ""
     1322           then do:
     1323             undo move_block, retry move_block .
     1324           end.
     1325         end.
     1326         for each buf_temp-diasize-handle
     1327         on error undo move_block, retry move_block
     1328         :
     1329           assign
     1330             v-object-handle = buf_temp-diasize-handle.handle-value
     1331           .
     1332           if v-object-handle <> v-diasize-resize-button
     1333           then do:
     1334             assign
     1335               v-object-handle :row = v-object-handle :row + p-change-value
     1336               no-error .
     1337             if error-status :error
     1338             or error-status :get-message(1) <> ""
     1339             then do:
     1340               undo move_block, retry move_block .
     1341             end.
     1342           end.
     1343         end.
     1344       end.
     1345       else do:
     1346         for each buf_temp-diasize-handle
     1347         on error undo move_block, retry move_block
     1348         :
     1349           assign
     1350             v-object-handle = buf_temp-diasize-handle.handle-value
     1351           .
     1352           if v-object-handle <> v-diasize-resize-button
     1353           then do:
     1354             assign
     1355               v-object-handle :row = v-object-handle :row + p-change-value
     1356               no-error .
     1357             if error-status :error
     1358             or error-status :get-message(1) <> ""
     1359             then do:
     1360               undo move_block, retry move_block .
     1361             end.
     1362           end.
     1363         end.
     1364         assign
     1365           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1366           no-error .
     1367         if error-status :error
     1368         or error-status :get-message(1) <> ""
     1369         then do:
     1370           undo move_block, retry move_block .
     1371         end.
     1372         for each buf_temp-browse-handle
     1373           where buf_temp-browse-handle.browse-type = 'height':u
     1374         on error undo move_block, retry move_block
     1375         :
     1376           assign
     1377             buf_temp-browse-handle.browse-handle :height
     1378               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1379             no-error .
     1380           if error-status :error
     1381           or error-status :get-message(1) <> ""
     1382           then do:
     1383             undo move_block, retry move_block .
     1384           end.
     1385         end.
     1386         assign
     1387           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1388           no-error .
     1389         if error-status :error
     1390         or error-status :get-message(1) <> ""
     1391         then do:
     1392           undo move_block, retry move_block .
     1393         end.
     1394         if frame Dialog-Frame :scrollable = true
     1395         then do:
     1396           assign
     1397             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1398             no-error .
     1399           if error-status :error
     1400           or error-status :get-message(1) <> ""
     1401           then do:
     1402             undo move_block, retry move_block .
     1403           end.
     1404         end.
     1405       end.
     1406       if p-move-resize = true
     1407       then do:
     1408         run diasize_position-resize-button in this-procedure .
     1409       end.
     1410       if v-diasize-wndstore = true
     1411       then do:
     1412         if connected("ub") = true
     1413         then do:
     1414           define variable v-cntxt-db-num        as integer   no-undo .
     1415           define variable v-cntxt-userid        as character no-undo .
     1416           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1417                                             , OUTPUT v-cntxt-userid
     1418                                             ) .
     1419           run gbl/wndsizew.p
     1420             (input  v-cntxt-db-num
     1421             ,input  v-cntxt-userid
     1422             ,input  v-diasize-proc-name
     1423             ,input  'height':u
     1424             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1425             ) .
     1426         end.
     1427       end.
     1428     end.
     1429     assign
     1430       v-diasize-change-size = false
     1431     .
     1432   end procedure.
     1433   procedure diasize_set-height :
     1434     define input  parameter p-new-height  as decimal   no-undo .
     1435     define input  parameter p-move-resize as logical   no-undo .
     1436     do
     1437     on error undo, return error return-value
     1438     :
     1439       run diasize_change-height in this-procedure
     1440         (input  (p-new-height - frame Dialog-Frame :height)
     1441         ,input  p-move-resize
     1442         ) .
     1443     end.
     1444   end procedure.
     1445   procedure diasize_change-width :
     1446     define input  parameter p-change-value as decimal   no-undo .
     1447     define input  parameter p-move-resize  as logical   no-undo .
     1448     define variable v-field-group-handle   as handle    no-undo .
     1449     define variable v-object-handle        as handle    no-undo .
     1450     define variable v-frame-width          as decimal   no-undo .
     1451     define variable v-frame-virtual-width  as decimal   no-undo .
     1452     define variable v-browse-width         as decimal   no-undo .
     1453     define variable v-window-width         as decimal   no-undo .
     1454     define variable v-window-virtual-width as decimal   no-undo .
     1455     define variable v-change-sign          as integer   no-undo .
     1456     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1457     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1458     if p-change-value > 0
     1459     then do:
     1460       if frame Dialog-Frame :width + p-change-value >
     1461           session :width-chars
     1462       then do:
     1463         assign
     1464           p-change-value = session :width-chars - frame Dialog-Frame :width
     1465         .
     1466         if p-change-value <= 0
     1467         then do:
     1468           run diasize_position-resize-button in this-procedure .
     1469           return .
     1470         end.
     1471       end.
     1472     end.
     1473     if p-change-value < 0
     1474     then do:
     1475       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1476       then do:
     1477         assign
     1478           p-change-value = v-diasize-orig-frame-width
     1479                          - frame Dialog-Frame :width
     1480         .
     1481         if p-change-value >= 0
     1482         then do:
     1483           run diasize_position-resize-button in this-procedure .
     1484           return .
     1485         end.
     1486       end.
     1487     end.
     1488     if p-change-value >= 0
     1489     then do:
     1490       assign
     1491         v-change-sign = 1
     1492       .
     1493     end.
     1494     else do:
     1495       assign
     1496         v-change-sign = -1
     1497       .
     1498     end.
     1499     assign
     1500       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1501     .
     1502     if p-change-value = 0
     1503     then do:
     1504       run diasize_position-resize-button in this-procedure .
     1505       return .
     1506     end.
     1507     move_block:
     1508     do
     1509     on error undo move_block, leave move_block
     1510     :
     1511       if retry
     1512       then do:
     1513         do
     1514         on error undo move_block, leave move_block
     1515         :
     1516           if p-change-value > 0
     1517           then do:
     1518             for each buf_temp-diasize-handle
     1519             on error undo, next
     1520             :
     1521               assign
     1522                 v-object-handle = buf_temp-diasize-handle.handle-value
     1523               .
     1524               if v-object-handle <> v-diasize-resize-button
     1525               then do:
     1526                 assign
     1527                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1528                 .
     1529               end.
     1530             end.
     1531             assign
     1532               v-diasize-browse-handle :width = v-browse-width
     1533             .
     1534             for each buf_temp-browse-handle
     1535               where buf_temp-browse-handle.browse-type = 'width':u
     1536             on error undo, next
     1537             :
     1538               assign
     1539                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1540               .
     1541             end.
     1542             assign
     1543               frame Dialog-Frame :width = v-frame-width
     1544             .
     1545             if frame Dialog-Frame :scrollable = true
     1546             then do:
     1547               assign
     1548                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1549               .
     1550             end.
     1551             run diasize_position-resize-button in this-procedure .
     1552           end.
     1553           else do:
     1554             if frame Dialog-Frame :scrollable = true
     1555             then do:
     1556               assign
     1557                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1558               .
     1559             end.
     1560             assign
     1561               frame Dialog-Frame :width = v-frame-width
     1562             .
     1563             for each buf_temp-browse-handle
     1564               where buf_temp-browse-handle.browse-type = 'width':u
     1565             on error undo, next
     1566             :
     1567               assign
     1568                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1569               .
     1570             end.
     1571             assign
     1572               v-diasize-browse-handle :width = v-browse-width
     1573             .
     1574             for each buf_temp-diasize-handle
     1575             on error undo, next
     1576             :
     1577               assign
     1578                 v-object-handle = buf_temp-diasize-handle.handle-value
     1579               .
     1580               if v-object-handle <> v-diasize-resize-button
     1581               then do:
     1582                 assign
     1583                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1584                 .
     1585               end.
     1586             end.
     1587             run diasize_position-resize-button in this-procedure .
     1588           end.
     1589           assign
     1590             v-diasize-change-size = false
     1591           .
     1592           leave move_block .
     1593         end.
     1594       end.
     1595       assign
     1596         v-diasize-need-full-display = true
     1597       .
     1598       if v-diasize-change-size = false
     1599       then do:
     1600         assign
     1601           v-diasize-change-size = true
     1602         .
     1603       end.
     1604       else do:
     1605         return .
     1606       end.
     1607       assign
     1608         v-frame-width = frame Dialog-Frame :width
     1609         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1610         v-browse-width = v-diasize-browse-handle :width
     1611       .
     1612       for each buf_temp-browse-handle
     1613         where buf_temp-browse-handle.browse-type = 'width':u
     1614       :
     1615         assign
     1616           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1617         .
     1618       end.
     1619       for each buf_temp-diasize-handle
     1620       :
     1621         delete buf_temp-diasize-handle .
     1622       end.
     1623       assign
     1624         v-field-group-handle = frame Dialog-Frame :first-child
     1625       .
     1626       do while valid-handle(v-field-group-handle)
     1627       :
     1628         assign
     1629           v-object-handle = v-field-group-handle :first-child
     1630         .
     1631         do while valid-handle(v-object-handle)
     1632         :
     1633           if  v-object-handle <> v-diasize-browse-handle :handle
     1634           and v-object-handle <> v-diasize-resize-button
     1635           and can-query(v-object-handle, "row")
     1636           and can-query(v-object-handle, "height")
     1637           and ( v-object-handle :col + v-object-handle :width
     1638                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1639               )
     1640           then do:
     1641             find first buf_temp-browse-handle
     1642               where buf_temp-browse-handle.browse-type   = 'width':u
     1643                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1644               no-error .
     1645             if available buf_temp-browse-handle
     1646             then do:
     1647             end.
     1648             else do:
     1649               create buf_temp-diasize-handle .
     1650               assign
     1651                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1652                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1653               .
     1654             end.
     1655           end.
     1656           assign
     1657             v-object-handle = v-object-handle :next-sibling
     1658           .
     1659         end.
     1660         assign
     1661           v-field-group-handle = v-field-group-handle :next-sibling
     1662         .
     1663       end.
     1664       do with frame Dialog-Frame
     1665       :
     1666         hide v-diasize-resize-button .
     1667         v-diasize-resize-button :row = 1.
     1668         v-diasize-resize-button :column = 1.
     1669       end.
     1670       if p-change-value > 0
     1671       then do:
     1672         if frame Dialog-Frame :scrollable = true
     1673         then do:
     1674           assign
     1675             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1676             no-error .
     1677           if error-status :error
     1678           or error-status :get-message(1) <> ""
     1679           then do:
     1680             undo move_block, retry move_block.
     1681           end.
     1682         end.
     1683         assign
     1684           frame Dialog-Frame :width = v-frame-width + p-change-value
     1685           no-error .
     1686         if error-status :error
     1687         or error-status :get-message(1) <> ""
     1688         then do:
     1689           undo move_block, retry move_block.
     1690         end.
     1691         assign
     1692           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1693         no-error .
     1694         if error-status :error
     1695         or error-status :get-message(1) <> ""
     1696         then do:
     1697           undo move_block, retry move_block.
     1698         end.
     1699         for each buf_temp-browse-handle
     1700           where buf_temp-browse-handle.browse-type = 'width':u
     1701         on error undo move_block, retry move_block
     1702         :
     1703           assign
     1704             buf_temp-browse-handle.browse-handle :width
     1705               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1706             no-error .
     1707           if error-status :error
     1708           or error-status :get-message(1) <> ""
     1709           then do:
     1710             undo move_block, retry move_block .
     1711           end.
     1712         end.
     1713         for each buf_temp-diasize-handle
     1714         on error undo move_block, retry move_block
     1715         :
     1716           assign
     1717             v-object-handle = buf_temp-diasize-handle.handle-value
     1718           .
     1719           if v-object-handle <> v-diasize-resize-button
     1720           then do:
     1721             assign
     1722               v-object-handle :col = v-object-handle :col + p-change-value
     1723               no-error .
     1724             if error-status :error
     1725             or error-status :get-message(1) <> ""
     1726             then do:
     1727               undo move_block, retry move_block .
     1728             end.
     1729           end.
     1730         end.
     1731       end.
     1732       else do:
     1733         for each buf_temp-diasize-handle
     1734         on error undo move_block, retry move_block
     1735         :
     1736           assign
     1737             v-object-handle = buf_temp-diasize-handle.handle-value
     1738           .
     1739           if v-object-handle <> v-diasize-resize-button
     1740           then do:
     1741             assign
     1742               v-object-handle :col = v-object-handle :col + p-change-value
     1743               no-error .
     1744             if error-status :error
     1745             or error-status :get-message(1) <> ""
     1746             then do:
     1747               undo move_block, retry move_block .
     1748             end.
     1749           end.
     1750         end.
     1751         for each buf_temp-browse-handle
     1752           where buf_temp-browse-handle.browse-type = 'width':u
     1753         on error undo move_block, retry move_block
     1754         :
     1755           assign
     1756             buf_temp-browse-handle.browse-handle :width
     1757               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1758             no-error .
     1759           if error-status :error
     1760           or error-status :get-message(1) <> ""
     1761           then do:
     1762             undo move_block, retry move_block .
     1763           end.
     1764         end.
     1765         assign
     1766           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1767           no-error .
     1768         if error-status :error
     1769         or error-status :get-message(1) <> ""
     1770         then do:
     1771           undo move_block, retry move_block.
     1772         end.
     1773         assign
     1774           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1775         no-error .
     1776         if error-status :error
     1777         or error-status :get-message(1) <> ""
     1778         then do:
     1779           undo move_block, retry move_block.
     1780         end.
     1781         if frame Dialog-Frame :scrollable = true
     1782         then do:
     1783           assign
     1784             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1785           no-error .
     1786           if error-status :error
     1787           or error-status :get-message(1) <> ""
     1788           then do:
     1789             undo move_block, retry move_block.
     1790           end.
     1791         end.
     1792       end.
     1793       if p-move-resize
     1794       then do:
     1795         run diasize_position-resize-button in this-procedure .
     1796       end.
     1797       if v-diasize-wndstore = true
     1798       then do:
     1799         if connected("ub") = true
     1800         then do:
     1801           define variable v-cntxt-db-num        as integer   no-undo .
     1802           define variable v-cntxt-userid        as character no-undo .
     1803           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1804                                             , OUTPUT v-cntxt-userid
     1805                                             ) .
     1806           run gbl/wndsizew.p
     1807             (input  v-cntxt-db-num
     1808             ,input  v-cntxt-userid
     1809             ,input  v-diasize-proc-name
     1810             ,input  'width':u
     1811             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1812             ) .
     1813         end.
     1814       end.
     1815     end.
     1816     assign
     1817       v-diasize-change-size = false
     1818     .
     1819   end procedure.
     1820   procedure diasize_set-width :
     1821     define input  parameter p-new-width  as decimal   no-undo .
     1822     define input  parameter p-move-resize as logical   no-undo .
     1823     do
     1824     on error undo, return error return-value
     1825     :
     1826       run diasize_change-width in this-procedure
     1827         (input  (p-new-width - frame Dialog-Frame :width)
     1828         ,input  p-move-resize
     1829         ) .
     1830     end.
     1831   end procedure.
     1832   procedure diasize_position-resize-button :
     1833     do with frame Dialog-Frame
     1834     :
     1835       hide v-diasize-resize-button .
     1836       assign
     1837         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1838                     - 1
     1839                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1840         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1841                     - 1
     1842                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1843       .
     1844       view v-diasize-resize-button .
     1845     end.
     1846   end procedure.
     1847   on alt-right anywhere
     1848   do:
     1849     run diasize_change-width in this-procedure
     1850       (input 1
     1851       ,input true
     1852       ) .
     1853     return no-apply .
     1854   end.
     1855   on alt-left anywhere
     1856   do:
     1857     run diasize_change-width in this-procedure
     1858       (input -1
     1859       ,input true
     1860       ) .
     1861     return no-apply .
     1862   end.
     1863   on alt-down anywhere
     1864   do:
     1865     run diasize_change-height in this-procedure
     1866       (input 1
     1867       ,input true
     1868       ) .
     1869     return no-apply .
     1870   end.
     1871   on alt-up anywhere
     1872   do:
     1873     run diasize_change-height in this-procedure
     1874       (input -1
     1875       ,input true
     1876       ) .
     1877     return no-apply .
     1878   end.
     1879   on alt-enter of frame Dialog-Frame
     1880   do:
     1881     run diasize_maximize in this-procedure
     1882       (input  ?
     1883       ).
     1884     return no-apply .
     1885   end.
     1886   procedure diasize_end-move :
     1887     do
     1888     on error undo, return error return-value
     1889     :
     1890       define variable v-row-delta as decimal   no-undo .
     1891       define variable v-col-delta as decimal   no-undo .
     1892       define variable v-new-row as decimal   no-undo .
     1893       define variable v-new-col as decimal   no-undo .
     1894       assign
     1895         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1896         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1897       .
     1898       assign
     1899         v-row-delta = v-new-row - frame Dialog-Frame :height
     1900         v-col-delta = v-new-col - frame Dialog-Frame :width
     1901       .
     1902       run diasize_change-height in this-procedure
     1903         (input v-row-delta
     1904         ,input true
     1905         ) .
     1906       run diasize_change-width in this-procedure
     1907         (input v-col-delta
     1908         ,input true
     1909         ) .
     1910     end.
     1911   end procedure.
     1912   procedure diasize_maximize :
     1913     define input  parameter p-action as logical   no-undo .
     1914     do
     1915     on error undo, return error return-value
     1916     :
     1917       if p-action = ?
     1918       then do:
     1919         if v-diasize-need-maximize = true
     1920         then do:
     1921           assign
     1922             p-action = true
     1923           .
     1924         end.
     1925         else do:
     1926           assign
     1927             p-action = false
     1928           .
     1929         end.
     1930       end.
     1931       if p-action = true
     1932       then do:
     1933         run diasize_change-height in this-procedure
     1934           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1935               - frame Dialog-Frame :height-chars
     1936           ,input true
     1937           ) .
     1938         run diasize_change-width in this-procedure
     1939           (input session :width-chars
     1940               - frame Dialog-Frame :width-chars
     1941           ,input true
     1942           ) .
     1943         assign
     1944           v-diasize-need-maximize = false
     1945         .
     1946       end.
     1947       else do:
     1948         run diasize_change-width in this-procedure
     1949           (input v-diasize-orig-frame-width
     1950               - frame Dialog-Frame :width-chars
     1951           ,input true
     1952           ) .
     1953         run diasize_change-height in this-procedure
     1954           (input v-diasize-orig-frame-height
     1955               - frame Dialog-Frame :height-chars
     1956           ,input true
     1957           ) .
     1958         assign
     1959           v-diasize-need-maximize = true
     1960         .
     1961       end.
     1962     end.
     1963   end procedure.
     1964   procedure diasize_restore-orig-size :
     1965     do
     1966     on error undo, return error return-value
     1967     :
     1968       assign
     1969         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1970         v-diasize-current-frame-height = frame Dialog-Frame :height
     1971       .
     1972       run diasize_set-height in this-procedure
     1973         (input  v-diasize-orig-frame-height
     1974         ,input  true
     1975         ) .
     1976       run diasize_set-width in this-procedure
     1977         (input  v-diasize-orig-frame-width
     1978         ,input  true
     1979         ) .
     1980     end.
     1981   end procedure.
     1982   procedure diasize_restore-current-size :
     1983     do
     1984     on error undo, return error return-value
     1985     :
     1986       run diasize_set-height in this-procedure
     1987         (input  v-diasize-current-frame-height
     1988         ,input  true
     1989         ) .
     1990       run diasize_set-width in this-procedure
     1991         (input  v-diasize-current-frame-width
     1992         ,input  true
     1993         ) .
     1994     end.
     1995   end procedure.
     1996   procedure diasize_set-browse-handle :
     1997     define input  parameter p-browse-handle as handle   no-undo .
     1998     define buffer buf_temp-browse-handle for temp-browse-handle .
     1999     do
     2000     on error undo, return error return-value
     2001     :
     2002       assign
     2003         v-diasize-browse-handle = p-browse-handle
     2004       .
     2005       for each buf_temp-browse-handle
     2006       on error undo, return error return-value
     2007       :
     2008         delete buf_temp-browse-handle .
     2009       end.
     2010     end.
     2011   end procedure.
     2012   procedure diasize_add_browse :
     2013     define input  parameter p-browse-type   as character no-undo .
     2014     define input  parameter p-browse-handle as handle    no-undo .
     2015     define buffer buf_temp-browse-handle for temp-browse-handle .
     2016     do
     2017     on error undo, return error return-value
     2018     :
     2019       assign
     2020         v-diasize-browse-number = v-diasize-browse-number + 1
     2021       .
     2022       create buf_temp-browse-handle .
     2023       assign
     2024         buf_temp-browse-handle.browse-type   = p-browse-type
     2025         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2026         buf_temp-browse-handle.browse-handle = p-browse-handle
     2027       .
     2028     end.
     2029   end procedure.
     2030   procedure diasize_init :
     2031     define variable v-default-value    as logical   no-undo .
     2032     define variable v-restore-saved    as logical   no-undo .
     2033     define variable v-resize-value-str as character no-undo .
     2034     do
     2035     on error undo, return error return-value
     2036     :
     2037       do with frame Dialog-Frame
     2038       :
     2039         assign
     2040           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2041           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2042           v-diasize-browse-handle     = browse BR-xtd :handle
     2043         .
     2044         create button v-diasize-resize-button
     2045         assign
     2046           parent        = frame Dialog-Frame :first-child
     2047           label         = "s"
     2048           height-pixels = 16
     2049           width-pixels  = 16
     2050           visible       = true
     2051           sensitive     = true
     2052           movable       = true
     2053           triggers:
     2054             on end-move persistent run diasize_end-move in this-procedure .
     2055           end triggers.
     2056         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2057         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2058         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2059         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2060         assign
     2061           v-diasize-wndmax = false
     2062         .
     2063         if connected("ub") = true
     2064         then do:
     2065           define variable v-cntxt-db-num        as integer   no-undo .
     2066           define variable v-cntxt-userid        as character no-undo .
     2067           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2068                                             , OUTPUT v-cntxt-userid
     2069                                             ) .
     2070           run gbl/wndpar_r.p
     2071             (input  v-cntxt-db-num
     2072             ,input  v-cntxt-userid
     2073             ,input  'wndmax':U
     2074             ,output v-diasize-wndmax
     2075             ,output v-default-value
     2076             ) .
     2077         end.
     2078         assign
     2079           v-diasize-wndstore = false
     2080         .
     2081         if connected("ub") = true
     2082         then do:
     2083           run gbl/wndpar_r.p
     2084             (input  v-cntxt-db-num
     2085             ,input  v-cntxt-userid
     2086             ,input  'wndstore':U
     2087             ,output v-diasize-wndstore
     2088             ,output v-default-value
     2089             ) .
     2090         end.
     2091         assign
     2092           v-diasize-proc-name = entry(1, program-name(2), '.')
     2093         .
     2094         if v-diasize-wndstore = true
     2095         then do:
     2096           assign
     2097             v-restore-saved = false
     2098           .
     2099           if connected("ub") = true
     2100           then do:
     2101             run gbl/wndsizer.p
     2102               (input  v-cntxt-db-num
     2103               ,input  v-cntxt-userid
     2104               ,input  v-diasize-proc-name
     2105               ,input  'height':u
     2106               ,output v-resize-value-str
     2107               ) .
     2108             if v-resize-value-str <> '':U
     2109             then do:
     2110               run diasize_change-height in this-procedure
     2111                 (input  integer(v-resize-value-str)
     2112                 ,input  true
     2113                 ) .
     2114               assign
     2115                 v-restore-saved = true
     2116               .
     2117             end.
     2118           end.
     2119           if connected("ub") = true
     2120           then do:
     2121             run gbl/wndsizer.p
     2122               (input  v-cntxt-db-num
     2123               ,input  v-cntxt-userid
     2124               ,input  v-diasize-proc-name
     2125               ,input  'width':u
     2126               ,output v-resize-value-str
     2127               ) .
     2128             if v-resize-value-str <> '':U
     2129             then do:
     2130               run diasize_change-width in this-procedure
     2131                 (input  integer(v-resize-value-str)
     2132                 ,input  true
     2133                 ) .
     2134               assign
     2135                 v-restore-saved = true
     2136               .
     2137             end.
     2138           end.
     2139           if v-restore-saved <> true
     2140           then do:
     2141             if v-diasize-wndmax = true
     2142             then do:
     2143               run diasize_maximize in this-procedure
     2144                 (input  true
     2145                 ) .
     2146             end.
     2147           end.
     2148         end.
     2149         else do:
     2150           if v-diasize-wndmax = true
     2151           then do:
     2152             run diasize_maximize in this-procedure
     2153               (input  true
     2154               ) .
     2155           end.
     2156         end.
     2157       end.
     2158     end.
     2159   end procedure.
     2160   procedure diasize_need-full-display :
     2161     define output parameter p-need-full-display as logical   no-undo .
     2162     do
     2163     on error undo, return error return-value
     2164     :
     2165       assign
     2166         p-need-full-display = v-diasize-need-full-display
     2167       .
     2168       assign
     2169         v-diasize-need-full-display = false
     2170       .
     2171     end.
     2172   end procedure.
     2173   procedure get-context :
     2174      define output parameter p-db-num as integer          no-undo.
     2175      define output parameter p-user-id as character        no-undo.
     2176      define variable v-login               as character    no-undo.
     2177      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2178      define buffer buf_user-login  for ub.user-login .
     2179      do
     2180      on error undo, return error
     2181      :
     2182            FIND FIRST buf_sys-ctrl no-lock.
     2183            ASSIGN
     2184               v-login = USERID("ub")
     2185               p-db-num = buf_sys-ctrl.db-num
     2186            .
     2187            FIND FIRST buf_user-login
     2188                 WHERE buf_user-login.db-num = p-db-num
     2189                   AND buf_user-login.user-login = v-login
     2190                 no-lock
     2191                 no-error
     2192                 .
     2193            IF AVAILABLE buf_user-login
     2194            THEN DO:
     2195               assign
     2196                  p-user-id = buf_user-login.user-id
     2197               .
     2198            END.
     2199      end.
     2200   end procedure.
     2201       run diasize_init in this-procedure .
     2202   MAIN-BLOCK:
     2203   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2204      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2205   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2206     run mainmenu_getcntxt in parparentproc
     2207       (output v-cntxt-db-num
     2208       ,output v-cntxt-userid
     2209       ,output v-cntxt-level
     2210       ,output v-cntxt-host-code-obj
     2211       ,output v-cntxt-obj-type
     2212       ,output v-cntxt-obj-code
     2213       ,output v-cntxt-db-num-obj
     2214       ,output v-cntxt-is-admin
     2215       ) .
     2216   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2217   ON TAB ANYWHERE
     2218   DO:
     2219   define variable ii as integer no-undo .
     2220   define variable fh as widget-handle no-undo .
     2221   define variable hh as widget-handle no-undo .
     2222   define variable v-next-widget-name as character no-undo .
     2223   if v-tab-order <> '' then do:
     2224     if self:type = "TOGGLE-BOX" then
     2225     self:BGCOLOR = ?.
     2226     assign
     2227     ii = lookup(self:name, v-tab-order).
     2228     assign
     2229     ii = ii + 1
     2230     v-next-widget-name = entry(ii, v-tab-order)
     2231     no-error .
     2232     if error-status:error then do:
     2233       assign
     2234       ii = 1
     2235       v-next-widget-name = entry( ii, v-tab-order)
     2236       .
     2237     end.
     2238     assign
     2239     fh = frame Dialog-Frame:first-child
     2240     hh = fh:first-child
     2241     .
     2242     do while valid-handle(hh):
     2243       if hh:name = v-next-widget-name then do:
     2244         if hh:sensitive  = yes
     2245         AND hh:visible = yes then do:
     2246           if hh:type = "TOGGLE-BOX":U then do:
     2247             assign
     2248             hh:BGcolor = 1
     2249             .
     2250           end.
     2251           APPLY "ENTRY" to hh.
     2252           return no-apply.
     2253         end.
     2254         else do:
     2255           APPLY "TAB" to hh.
     2256           return no-apply.
     2257         end.
     2258       end.
     2259       hh = hh:next-sibling.
     2260     end.
     2261   end.
     2262   END.
     2263   ON BACK-TAB ANYWHERE
     2264   DO:
     2265   define variable ii as integer no-undo .
     2266   define variable fh as widget-handle no-undo .
     2267   define variable hh as widget-handle no-undo .
     2268   define variable v-next-widget-name as character no-undo .
     2269   if v-tab-order <> '' then do:
     2270     assign
     2271     ii = lookup(self:name, v-tab-order).
     2272     .
     2273     assign
     2274     ii = (if ii = 1
     2275           then  num-entries(v-tab-order)
     2276           else ii - 1
     2277           )
     2278     v-next-widget-name = entry(ii, v-tab-order)
     2279     .
     2280     assign
     2281     fh = frame Dialog-Frame:first-child
     2282     hh = fh:first-child
     2283     .
     2284     do while valid-handle(hh):
     2285       if hh:name = v-next-widget-name then do:
     2286         if hh:sensitive  = yes
     2287         AND hh:visible = yes then do:
     2288           if hh:type = "TOGGLE-BOX":U then do:
     2289             assign
     2290             hh:BGcolor = 1
     2291             .
     2292           end.
     2293           APPLY "ENTRY" to hh.
     2294           return no-apply.
     2295         end.
     2296         else do:
     2297         APPLY "BACK-TAB" to hh.
     2298         return no-apply.
     2299         end.
     2300       end.
     2301       hh = hh:next-sibling.
     2302     end.
     2303     end.
     2304   END.
     2305   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2306   ON RETURN ANYWHERE
     2307   DO:
     2308   define variable ii as integer no-undo .
     2309   define variable fh as widget-handle no-undo .
     2310   define variable hh as widget-handle no-undo .
     2311   define variable v-next-widget-name as character no-undo .
     2312     if v-tab-order <> '' then do:
     2313       assign
     2314       ii = lookup(self:name, v-tab-order).
     2315       if ii = num-entries(v-tab-order) then do:
     2316           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     2317           return no-apply.
     2318       end.
     2319       if self:type <> "BUTTON" and
     2320         self:type <> "EDITOR"  then do:
     2321         run proc-move-forward in this-procedure .
     2322         return no-apply.
     2323       end.
     2324       if self:type = "BUTTON" then do:
     2325         APPLY "CHOOSE" to self.
     2326       end.
     2327       if self:type = "TOGGLE-BOX" then
     2328       self:BGCOLOR = ?.
     2329       assign
     2330       ii = ii + 1
     2331       v-next-widget-name = entry(ii, v-tab-order)
     2332       no-error .
     2333       if error-status:error then do:
     2334         assign
     2335         ii = 1
     2336         v-next-widget-name = entry( ii, v-tab-order)
     2337         .
     2338       end.
     2339       assign
     2340       fh = frame Dialog-Frame:first-child
     2341       hh = fh:first-child
     2342       .
     2343       do while valid-handle(hh):
     2344         if hh:name = v-next-widget-name then do:
     2345           if hh:sensitive  = yes
     2346           AND hh:visible = yes then do:
     2347             if hh:type = "TOGGLE-BOX":U then do:
     2348               assign
     2349               hh:BGcolor = 1
     2350               .
     2351             end.
     2352             APPLY "ENTRY" to hh.
     2353             return no-apply.
     2354           end.
     2355           else do:
     2356             APPLY "TAB" to hh.
     2357             return no-apply.
     2358           end.
     2359         end.
     2360         hh = hh:next-sibling.
     2361       end.
     2362     end.
     2363   END.
     2364   procedure proc-move-forward :
     2365   define variable ii as integer no-undo .
     2366   define variable fh as widget-handle no-undo .
     2367   define variable hh as widget-handle no-undo .
     2368   define variable v-next-widget-name as character no-undo .
     2369   do
     2370   on error undo, return error
     2371   :
     2372     if v-tab-order <> '' then do:
     2373       if self:type = "TOGGLE-BOX" then
     2374       self:BGCOLOR = ?.
     2375       assign
     2376       ii = lookup(self:name, v-tab-order).
     2377       assign
     2378       ii = ii + 1
     2379       v-next-widget-name = entry(ii, v-tab-order)
     2380       no-error .
     2381       if error-status:error then do:
     2382         assign
     2383         ii = 1
     2384         v-next-widget-name = entry( ii, v-tab-order)
     2385         .
     2386       end.
     2387       assign
     2388       fh = frame Dialog-Frame:first-child
     2389       hh = fh:first-child
     2390       .
     2391       do while valid-handle(hh):
     2392         if hh:name = v-next-widget-name then do:
     2393           if hh:sensitive  = yes
     2394           AND hh:visible = yes then do:
     2395             if hh:type = "TOGGLE-BOX":U then do:
     2396               assign
     2397               hh:BGcolor = 1
     2398               .
     2399             end.
     2400             APPLY "ENTRY" to hh.
     2401             return.
     2402           end.
     2403           else do:
     2404             assign
     2405             ii = ii + 1
     2406             v-next-widget-name = entry(ii, v-tab-order)
     2407             no-error .
     2408             if error-status:error then do:
     2409               assign
     2410               ii = 1
     2411               v-next-widget-name = entry( ii, v-tab-order)
     2412               .
     2413             end.
     2414           end.
     2415         end.
     2416         hh = hh:next-sibling.
     2417       end.
     2418     end.
     2419   end.
     2420   end procedure.
     2421     IF p-mode <> 'ПРОСМОТР':U
     2422     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     2423         MESSAGE
     2424         vss-workfile vss-revision vss-description skip
     2425         "Неверное значение параметра p-mode" p-mode
     2426         VIEW-AS ALERT-BOX ERROR.
     2427         UNDO, RETURN ERROR.
     2428     END.
     2429     IF p-obj-type <> 'маг':U
     2430     and p-obj-type <> 'орг':U
     2431     and p-obj-type <> '':U
     2432     THEN DO:
     2433         MESSAGE
     2434         vss-workfile vss-revision vss-description skip
     2435         "Неверное значение параметра p-obj-type" p-obj-type
     2436         VIEW-AS ALERT-BOX ERROR.
     2437         UNDO, RETURN ERROR.
     2438     END.
     2439     if p-obj-type = 'маг':U then do:
     2440       FIND FIRST X_shop NO-LOCK WHERE X_shop.obj-code = p-obj-code NO-ERROR.
     2441       IF NOT AVAILABLE X_shop THEN DO:
     2442           MESSAGE
     2443           vss-workfile vss-revision vss-description skip
     2444           "Неверное значение параметра p-obj-code" p-obj-code
     2445           VIEW-AS ALERT-BOX ERROR.
     2446           UNDO, RETURN ERROR.
     2447       END.
     2448   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2449   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2450     (input  'маг':U
     2451     ,input  p-obj-code
     2452     ,output v-db-num
     2453     )  .
     2454       IF v-db-num <> v-cntxt-db-num
     2455       AND v-cntxt-db-num <> 0
     2456       and p-mode <> 'ПРОСМОТР':U
     2457       THEN DO:
     2458           MESSAGE
     2459           "Нельзя менять параметры магазина в чужой БД" skip
     2460           "магазин принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     2461           VIEW-AS ALERT-BOX ERROR.
     2462           UNDO, RETURN ERROR.
     2463       END.
     2464   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2465   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2466     (input  'маг':U
     2467     ,input  p-obj-code
     2468     ,output v-host-code
     2469     )  .
     2470     end.
     2471     if p-obj-type = 'орг':U then do:
     2472       FIND FIRST X_sysconf NO-LOCK WHERE X_sysconf.host-code = p-obj-code NO-ERROR.
     2473       IF NOT AVAILABLE X_sysconf THEN DO:
     2474           MESSAGE
     2475           vss-workfile vss-revision vss-description skip
     2476           "Неверное значение параметра p-obj-code" p-obj-code
     2477           VIEW-AS ALERT-BOX ERROR.
     2478           UNDO, RETURN ERROR.
     2479       END.
     2480       if v-cntxt-db-num <> 0
     2481       and p-mode <> 'ПРОСМОТР':U
     2482       then do:
     2483           MESSAGE
     2484           "Нельзя менять параметры ФИРМЫ в УБД" skip
     2485           VIEW-AS ALERT-BOX ERROR.
     2486           UNDO, RETURN ERROR.
     2487       end.
     2488       v-host-code = p-obj-code.
     2489     end.
     2490     if p-obj-type = '':U then do:
     2491       if v-cntxt-db-num <> 0
     2492       and p-mode <> 'ПРОСМОТР':U
     2493       then do:
     2494           MESSAGE
     2495           "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" skip
     2496           VIEW-AS ALERT-BOX ERROR.
     2497           UNDO, RETURN ERROR.
     2498       end.
     2499     end.
     2500     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     2501       FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
     2502                 LOCKED_thbj-attr.obj-type = p-obj-type
     2503           AND   LOCKED_thbj-attr.obj-code = p-obj-code
     2504           AND   LOCKED_thbj-attr.upper-prop-code = 'cd-type-NCR-AS-R':U
     2505           AND   locked_thbj-attr.prop-code = "":U NO-WAIT NO-ERROR.
     2506        if locked locked_thbj-attr then do:
     2507           message
     2508           vss-workfile vss-revision vss-description skip
     2509            "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
     2510           view-as alert-box error .
     2511           undo, return error.
     2512         end.
     2513     END.
     2514     ELSE DO:
     2515         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
     2516             LOCKED_thbj-attr.obj-type = p-obj-type
     2517       AND   LOCKED_thbj-attr.obj-code = p-obj-code
     2518       AND   LOCKED_thbj-attr.upper-prop-code = 'cd-type-NCR-AS-R':U
     2519       AND   locked_thbj-attr.prop-code = '':U NO-ERROR.
     2520     END.
     2521     if not available locked_thbj-attr then do:
     2522       ASSIGN
     2523       v-to-create  = YES.
     2524       message
     2525       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     2526                   chr(10))
     2527       view-as alert-box WARNING.
     2528     end.
     2529     RUN FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     2530     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     2531     RUN Myenable.
     2532     WAIT-FOR GO OF FRAME Dialog-Frame.
     2533   END.
     2534   RUN disable_UI.
     2535   PROCEDURE disable_UI :
     2536     HIDE FRAME Dialog-Frame.
     2537   END PROCEDURE.
     2538   PROCEDURE enable_UI :
     2539     DISPLAY RS-ncrscpfx RS-ncrpgpfx RS-save-param E-save-param l-ncrscpfx
     2540             l-ncrpgpfx l-save-param l-save-param-2 l-ncrdrank l-ncrdrank-2
     2541         WITH FRAME Dialog-Frame.
     2542     ENABLE B-exit b-quit B-Help RS-ncrscpfx RS-ncrpgpfx RS-save-param BR-xtd B-up
     2543            B-down E-save-param l-ncrscpfx l-ncrpgpfx l-save-param l-save-param-2
     2544            l-ncrdrank l-ncrdrank-2
     2545         WITH FRAME Dialog-Frame.
     2546     VIEW FRAME Dialog-Frame.
     2547     OPEN QUERY BR-xtd FOR EACH temp-xtd.
     2548   END PROCEDURE.
     2549   PROCEDURE fill-widgets :
     2550   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     2551   DEFINE VARIABLE v-entry AS CHARACTER NO-UNDO.
     2552   define variable v-value-character as character no-undo .
     2553   define variable v-value-date as date no-undo .
     2554   define variable v-value-decimal as decimal no-undo .
     2555   define variable v-value-integer as INTEGER no-undo .
     2556   define variable v-value-logical AS LOGICAL no-undo .
     2557   define variable v-kat-id as integer no-undo.
     2558   define variable v-dop as character no-undo.
     2559   define variable v-pcnt as decimal no-undo.
     2560   define variable v-ncrgmdsc as character no-undo.
     2561   define variable v-ncrdrank as character no-undo.
     2562   define variable v-param-type as character no-undo .
     2563   define variable v-param-value as character no-undo .
     2564   FOR EACH temp-xtd:
     2565     DELETE temp-xtd.
     2566   END.
     2567   FOR EACH thbjattr_thbj-attr:
     2568     delete thbjattr_thbj-attr.
     2569   end.
     2570   FOR EACH temp-thbj-attr:
     2571     delete temp-thbj-attr.
     2572   end.
     2573   run adm/shattri.p (
     2574                 input "init":U
     2575               , input p-obj-type
     2576               , input p-obj-code
     2577               , input 'cd-type-NCR-AS-R':U
     2578               , input "":U
     2579               , output v-value-character
     2580               , output v-value-date
     2581               , output v-value-decimal
     2582               , output v-value-integer
     2583               , output v-value-logical
     2584               , output v-param-type
     2585               , INPUT-OUTPUT TABLE-handle v-tth
     2586               ) no-error .
     2587   if error-status:error
     2588   and not available locked_thbj-attr then do:
     2589     message
     2590     "Не удалось получить начальные значения настроек" skip
     2591     error-status:get-message(1) return-value
     2592     view-as alert-box error .
     2593     undo, return error .
     2594   end.
     2595   FOR EACH thbjattr_thbj-attr:
     2596     ASSIGN
     2597     v-entry = thbjattr_thbj-attr.prop-code.
     2598     IF v-entry = 'ncrscpfx':U THEN DO:
     2599       ASSIGN
     2600       RS-ncrscpfx = thbjattr_thbj-attr.property-value-integer.
     2601     END.
     2602     IF v-entry = 'ncrpgpfx':U THEN DO:
     2603       ASSIGN
     2604       RS-ncrpgpfx = thbjattr_thbj-attr.property-value-integer.
     2605     END.
     2606     IF v-entry = 'ncrdrank':U THEN DO:
     2607       ASSIGN
     2608       v-ncrdrank = thbjattr_thbj-attr.property-value-character.
     2609     END.
     2610     IF v-entry = 'save-param':U THEN DO:
     2611       ASSIGN
     2612       RS-save-param = thbjattr_thbj-attr.property-value-character.
     2613     END.
     2614     create temp-thbj-attr.
     2615     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     2616   END.
     2617    DO ii = 1 TO LENGTH(v-ncrdrank):
     2618        CREATE temp-xtd.
     2619        ASSIGN
     2620        temp-xtd.id = ii
     2621        temp-xtd.f-value = SUBSTRING(v-ncrdrank, ii, 1)
     2622        temp-xtd.f-label = (IF substring(v-ncrdrank, ii, 1) = "X":u
     2623                            THEN "Скидка на кол-во"
     2624                            ELSE (IF substring(v-ncrdrank, ii, 1) = "T":u
     2625                                  THEN "Скидка по времени"
     2626                                  ELSE "Скидка по дате")
     2627                             )
     2628        .
     2629    END.
     2630   END PROCEDURE.
     2631   PROCEDURE MyEnable :
     2632   ASSIGN
     2633   FRAME Dialog-Frame:TITLE = FRAME Dialog-Frame:TITLE + (if p-obj-type = 'орг':U then " фирма" else " маг") + STRING(p-obj-code)
     2634   v-tab-order = "rs-ncrscpfx,rs-ncrpgpfx,br-xtd,b-up,b-down,rs-save-param,e-save-param".
     2635   DISPLAY
     2636   RS-ncrscpfx
     2637   l-ncrscpfx
     2638   RS-ncrpgpfx
     2639   l-ncrpgpfx
     2640   l-ncrdrank
     2641   l-ncrdrank-2
     2642   l-save-param
     2643   l-save-param-2
     2644   RS-save-param
     2645   WITH FRAME Dialog-Frame.
     2646   ENABLE
     2647   B-exit WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2648   b-quit
     2649   B-Help
     2650   br-xtd
     2651   RS-ncrscpfx WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2652   RS-ncrpgpfx WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2653   b-up   WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2654   b-down   WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2655   rs-save-param WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2656   e-save-param WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2657   WITH FRAME Dialog-Frame.
     2658   VIEW FRAME Dialog-Frame.
     2659   IF p-mode = 'ПРОСМОТР':U THEN DO:
     2660       HIDE
     2661       b-exit
     2662       IN FRAME Dialog-Frame.
     2663       ASSIGN
     2664       b-quit:LABEL = "&Выход"
     2665       .
     2666   END.
     2667   OPEN QUERY BR-xtd FOR EACH temp-xtd.
     2668   APPLY "value-changed" TO rs-save-param.
     2669   END PROCEDURE.
     2670   PROCEDURE proc-save :
     2671   define variable v-same as logical no-undo .
     2672   define variable v-value-character as character no-undo .
     2673   define variable v-value-date as date no-undo .
     2674   define variable v-value-decimal as decimal no-undo .
     2675   define variable v-value-integer as INTEGER no-undo .
     2676   define variable v-value-logical AS LOGICAL no-undo .
     2677   define variable v-param-type as character no-undo .
     2678   define variable v-ncrgmdsc as character no-undo.
     2679   define variable v-ncrdrank as character no-undo.
     2680   define variable ii as integer no-undo.
     2681   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     2682   ASSIGN
     2683   FRAME Dialog-Frame
     2684   RS-ncrscpfx
     2685   RS-ncrpgpfx
     2686   RS-save-param
     2687   .
     2688   for each temp-xtd no-lock:
     2689       assign
     2690       v-ncrdrank = v-ncrdrank + temp-xtd.f-value
     2691       .
     2692   end.
     2693   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'ncrscpfx':U.
     2694   assign
     2695   thbjattr_thbj-attr.property-value-integer = RS-ncrscpfx.
     2696   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'ncrpgpfx':U.
     2697   assign
     2698   thbjattr_thbj-attr.property-value-integer = RS-ncrpgpfx.
     2699   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'ncrdrank':U.
     2700   assign
     2701   thbjattr_thbj-attr.property-value-character = v-ncrdrank.
     2702   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'save-param':U.
     2703   assign
     2704   thbjattr_thbj-attr.property-value-character = rs-save-param.
     2705   v-same = yes.
     2706   for each thbjattr_thbj-attr,
     2707       first temp-thbj-attr where
     2708             temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     2709         and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     2710         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     2711         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code:
     2712      buffer-compare
     2713      thbjattr_thbj-attr
     2714      to temp-thbj-attr
     2715      save result in v-same.
     2716      if not v-same then leave.
     2717   end.
     2718   v-same = no.
     2719   IF v-same  and not v-to-create THEN RETURN.
     2720   run adm/shattri.p (
     2721                 input "check":U
     2722               , input p-obj-type
     2723               , input p-obj-code
     2724               , input 'cd-type-NCR-AS-R':U
     2725               , INPUT '':U
     2726                , output v-value-character
     2727                , output v-value-date
     2728                , output v-value-decimal
     2729                , output v-value-integer
     2730                , output v-value-logical
     2731                , output v-param-type
     2732                , input-output TABLE-handle v-tth
     2733                ) no-error .
     2734   if error-status:error then do:
     2735     message
     2736     "Некорректное значение ПАРАМЕТРОВ" skip
     2737     error-status:get-message(1) skip
     2738     return-value
     2739     view-as alert-box error .
     2740     undo, return error .
     2741   end.
     2742   do TRANSACTION
     2743   on error undo, return error return-value
     2744   :
     2745     RUN thbjattr_set-section IN THIS-PROCEDURE (
     2746          input p-obj-type
     2747         ,input p-obj-code
     2748         ,input 'cd-type-NCR-AS-R':U
     2749         ,INPUT table thbjattr_thbj-attr
     2750     ) NO-ERROR.
     2751     IF ERROR-STATUS:error THEN do:
     2752       MESSAGE ERROR-STATUS:get-message(1)  SKIP
     2753       RETURN-VALUE
     2754       VIEW-AS ALERT-BOX.
     2755       UNDO, RETURN ERROR.
     2756     END.
     2757   end.
     2758   END PROCEDURE.
