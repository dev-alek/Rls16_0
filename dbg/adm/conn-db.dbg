      320   function pascur returns handle ():
      321   define buffer  Buf_user for  _user.
      322    find first gPasSysAdm no-error.
      323    if not available gPasSysAdm then crpas().
      324    define variable vReturn as handle no-undo.
      325    find first Buf_user
      326              where Buf_user._userid    = mloginsysadm
      327              no-error
      328              .
      329      if available Buf_user
      330      then do:
      331          block-pas:
      332          for each gPasSysAdm where gPasSysAdm.fLogin eq mloginsysadm no-lock:
      333             if Buf_user._password eq encode(gpasSysadm.pasw)
      334             then
      335                leave block-pas.
      336          end.
      337      end.
      338      release Buf_user.
      339      if not available gPasSysAdm
      340      then
      341         find last gPasSysAdm where gPasSysAdm.fLogin eq mloginsysadm.
      342      vReturn = buffer gPasSysAdm:handle.
      343      return vReturn.
      344   end.
      345   function pasNew returns handle ():
      346      define buffer  sys-ctrl for ub.sys-ctrl.
      347      define buffer  upgrade for ub.upgrade.
      348      define buffer  upgrade-attr for ub.upgrade-attr.
      349      find first gPasSysAdm where gPasSysAdm.fLogin eq mloginsysadm no-error.
      350      if not available gPasSysAdm then crpas().
      351      define variable vReturn as handle no-undo.
      352      find first sys-ctrl no-lock .
      353      block-upg:
      354      for each  upgrade  where upgrade.db-num = sys-ctrl.db-num
      355      no-lock
      356       by upgrade.db-num descending by upgrade.step-num descending
      357          :
      358        leave block-upg.
      359      end.
      360      find first upgrade-attr no-lock where
      361                 upgrade-attr.db-num      = upgrade.db-num and
      362                 upgrade-attr.version-num = upgrade.version-num and
      363                 upgrade-attr.attr-code   = "releace" no-error .
      364      find first  gPasSysAdm where gPasSysAdm.fLogin eq mloginsysadm and
      365                                   gPasSysAdm.num eq integer (upgrade-attr.attr-value) no-lock no-error.
      366      release sys-ctrl.
      367      release upgrade.
      368      release upgrade-attr.
      369      if not available gPasSysAdm
      370      then
      371         find last gPasSysAdm where gPasSysAdm.fLogin eq mloginsysadm.
      372      vReturn = buffer gPasSysAdm:handle.
      373      return vReturn.
      374   end.
      375   DEFINE BUTTON b-exit AUTO-GO
      376        LABEL "&Ввод":L
      377        SIZE 10 BY 1.
      378   DEFINE BUTTON b-help
      379        LABEL "Помо&щь":L
      380        SIZE 3 BY 1.
      381   DEFINE BUTTON b-quit AUTO-END-KEY
      382        LABEL "&Отмена":L
      383        SIZE 10 BY 1.
      384   DEFINE VARIABLE v-conn-par AS CHARACTER FORMAT "X(256)":U
      385        VIEW-AS FILL-IN
      386        SIZE 86.5 BY 1 NO-UNDO.
      387   DEFINE VARIABLE v-title-par AS CHARACTER FORMAT "X(256)":U INITIAL "Параметры подключения к БД"
      388         VIEW-AS TEXT
      389        SIZE 86.5 BY .67 NO-UNDO.
      390   DEFINE FRAME d-get-conn-par
      391        b-exit AT ROW 1 COL 2
      392        b-quit AT ROW 1 COL 12
      393        b-help AT ROW 1 COL 87
      394        v-conn-par AT ROW 4 COL 3.5 NO-LABEL
      395        v-title-par AT ROW 2.75 COL 1.5 COLON-ALIGNED NO-LABEL WIDGET-ID 2
      396        SPACE(0.87) SKIP(2.11)
      397       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      398            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      399            TITLE "Ввод параметров подключения к БД":L
      400            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit.
      401   ASSIGN
      402          FRAME d-get-conn-par:SCROLLABLE       = FALSE.
      403   ASSIGN
      404          v-title-par:READ-ONLY IN FRAME d-get-conn-par        = TRUE.
      405   ON CHOOSE OF b-exit IN FRAME d-get-conn-par
      406   DO:
      407     define variable v-user-pswd-enc as character no-undo .
      408     define variable v-tmp-conn      as character no-undo .
      409     assign
      410       v-conn-par
      411     .
      412     if v-conn-par = "":U then do:
      413       message
      414         vss-workfile vss-revision vss-description skip
      415         substitute( "Нeобходимо указать параметры соединения с исходной ГБД!" ) skip
      416         view-as alert-box error
      417       .
      418       apply "entry":U to v-conn-par in frame d-get-conn-par .
      419       return no-apply.
      420     end.
      421     run proc-conn in this-procedure
      422       ( input v-conn-par
      423       , input p-user-name
      424       , input p-user-pswd
      425       , input p-ld-name
      426       ) no-error .
      427     if error-status :error then do:
      428       message
      429         vss-workfile vss-revision vss-description skip
      430         error-status :get-message(1) skip
      431         return-value skip
      432         view-as alert-box error .
      433       apply "entry":U to v-conn-par in frame d-get-conn-par .
      434       return no-apply .
      435     end.
      436     if connected( p-ld-name ) then do:
      437       assign
      438         p-new-conn = v-conn-par
      439       .
      440     end.
      441   END.
      442   ON CHOOSE OF b-quit IN FRAME d-get-conn-par
      443   DO:
      444     assign
      445       p-new-conn = ?
      446     .
      447   END.
      448   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-get-conn-par:PARENT eq ?
      449   THEN FRAME d-get-conn-par:PARENT = ACTIVE-WINDOW.
      450   ON WINDOW-CLOSE OF FRAME d-get-conn-par APPLY "END-ERROR":U TO SELF.
      451   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      452   on help of frame d-get-conn-par
      453   do:
      454     run gbl/app_help.p
      455       (input this-procedure :file-name
      456       ,input ''
      457       ,input ?
      458       ) no-error.
      459     if error-status :error then do:
      460       message
      461         "Ошибка при вызове помощи"
      462         error-status :get-message(1)
      463         view-as alert-box .
      464     end.
      465   end.
      466   run minbtn-set in this-procedure .
      467   on choose of b-help in frame d-get-conn-par
      468   do:
      469     apply "help":u to frame d-get-conn-par .
      470   end.
      471   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      472   procedure minbtn-set :
      473       do
      474           on error undo, return error return-value
      475           :
      476           define variable ii              as integer       no-undo .
      477           define variable fh              as widget-handle no-undo .
      478           define variable hh              as widget-handle no-undo .
      479           define variable v-h             as handle        extent 4 no-undo .
      480           define variable v-name-button   as character     no-undo .
      481           define variable v-help-old-x    as decimal       no-undo .
      482           define variable v-help-old-y    as decimal       no-undo .
      483           define variable v-help-old-size as decimal       no-undo .
      484           define variable v-frame-width   as decimal       no-undo .
      485           define variable jj              as integer       no-undo .
      486           do
      487               on error undo, return error
      488               :
      489               assign
      490                   v-frame-width = frame d-get-conn-par:width - 0.3
      491                   fh            = frame d-get-conn-par:first-child
      492                   hh            = fh:first-child
      493                   ii            = 1
      494                   .
      495               do while valid-handle(hh):
      496                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      497                   do:
      498                       case lc(hh:name) :
      499                           when "b-help" then
      500                               do:
      501                                   hh:load-image-up("cmp/b-help.bmp":u) .
      502                                   hh:load-image-down("cmp/b-help.bmp":u) .
      503                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      504                                   hh:TOOLTIP = "Помощь" .
      505                                   v-help-old-x = hh:column .
      506                                   v-help-old-y = hh:row    .
      507                                   v-help-old-size = hh:width .
      508                                   hh:width-chars = 2.5 .
      509                               end.
      510                           when "b-print" then
      511                               do:
      512                                   hh:load-image("cmp/b-print.bmp":u) .
      513                                   hh:TOOLTIP = "Печать" .
      514                                   v-h[ii] = hh:handle .
      515                                   ii = ii + 1 .
      516                                   hh:width-chars = 3 .
      517                               end.
      518                           when "b-history" or
      519                           when "b-hist" then
      520                               do:
      521                                   hh:load-image("cmp/b-hist.bmp":u) .
      522                                   hh:TOOLTIP = "История" .
      523                                   v-h[ii] = hh:handle .
      524                                   ii = ii + 1 .
      525                                   hh:width-chars = 3 .
      526                               end.
      527                           when "b-sch" then
      528                               do:
      529                                   hh:load-image("cmp/b-sch.bmp":u) .
      530                                   hh:TOOLTIP = "Установка Фильтра" .
      531                                   v-h[ii] = hh:handle .
      532                                   ii = ii + 1 .
      533                                   hh:width-chars = 3 .
      534                               end.
      535                           when "b-hist-user" then
      536                               do:
      537                                   hh:load-image("cmp/b-hist.bmp":u) .
      538                                   hh:TOOLTIP = "История пользователя" .
      539                                   ii = ii + 1 .
      540                               end.
      541                       end case.
      542                   end.
      543                   hh = hh:next-sibling.
      544               end.
      545               b-help:column = v-frame-width - b-help:width-chars.
      546               jj = 0.
      547               repeat ii = 4 to 1 by -1 :
      548                   if valid-handle (v-h[ii] ) then
      549                   do:
      550                       jj  = jj + 1 .
      551                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      552                       v-h[ii]:row    = v-help-old-y .
      553                   end.
      554               end.
      555           end.
      556       end.
      557   end procedure.
      558   MAIN-BLOCK:
      559   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      560      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      561      ON STOP       UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      562     if p-ld-name = ?
      563       or trim( p-ld-name ) = "":U
      564       or trim( p-ld-name ) = "ub":U
      565     then do:
      566       message
      567         vss-workfile vss-revision vss-description skip
      568         substitute('Ошибка задания входных параметров.') skip
      569         substitute('Логическое имя БД должно быть не пустым и не "ub".') skip
      570         substitute('Логическое имя БД &1', p-ld-name ) skip
      571         view-as alert-box error .
      572     end.
      573     if p-user-name = "":U
      574       or p-user-name = ?
      575       or p-user-pswd = "":U
      576       or p-user-pswd = ?
      577     then do:
      578       assign
      579         p-user-name = "sysadm":U
      580         p-user-pswd = pasCur()::pasw
      581       .
      582     end.
      583     assign
      584       p-new-conn = ?
      585       v-conn-par = p-conn-par
      586     .
      587     if p-title-par <> ?
      588       or trim( p-title-par ) <> "":U
      589     then do:
      590       assign
      591         v-title-par = p-title-par
      592       .
      593     end.
      594     if connected( p-ld-name ) then do:
      595       return error substitute( "БД с логическим именем &1 уже подключена", p-ld-name ) .
      596     end.
      597     if trim( p-conn-par ) <> "":U
      598       and p-conn-par <> ?
      599     then do:
      600       run proc-conn in this-procedure
      601         ( input p-conn-par
      602         , input p-user-name
      603         , input p-user-pswd
      604         , input p-ld-name
      605         ) no-error .
      606       if not error-status :error then do:
      607         assign
      608           p-new-conn = p-conn-par
      609         .
      610         return .
      611       end.
      612     end.
      613     RUN enable_UI.
      614     WAIT-FOR GO OF FRAME d-get-conn-par.
      615   END.
      616   RUN disable_UI.
      617   PROCEDURE disable_UI :
      618     HIDE FRAME d-get-conn-par.
      619   END PROCEDURE.
      620   PROCEDURE enable_UI :
      621     DISPLAY v-conn-par v-title-par
      622         WITH FRAME d-get-conn-par.
      623     ENABLE b-exit b-quit b-help v-conn-par
      624         WITH FRAME d-get-conn-par.
      625   END PROCEDURE.
      626   PROCEDURE proc-conn :
      627   define input  parameter par-conn-par  as character no-undo .
      628     define input  parameter par-user-name as character no-undo .
      629     define input  parameter par-user-pswd as character no-undo .
      630     define input  parameter par-ld-name   as character no-undo .
      631     connect value( par-conn-par ) -ld value( par-ld-name ) -U value( par-user-name ) -P value( par-user-pswd ) no-error.
      632     if not connected( par-ld-name ) then do:
      633       connect value( par-conn-par ) -ld test-conn -U odbc -P odbc no-error.
      634       if connected( "test-conn":U ) then do:
      635         disconnect test-conn .
      636         return error substitute( "Не удалось подключиться к БД с пользователем &1", par-user-name ).
      637       end.
      638       else do:
      639         return error substitute( "Не удалось подключиться к БД с параметрами &2!&1&3", chr(10), par-conn-par, error-status :get-message ( 1 ) ).
      640       end.
      641     end.
      642   END PROCEDURE.
