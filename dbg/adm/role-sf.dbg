        1   define input-output parameter p-name        as character no-undo .
        2   define output       parameter p-ok          as logical no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Запрос строки для поиска и фильтрации в правах".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   procedure proc-alt-shift-f2:
       70     if not ibs.th.gbl.gbl-var:rcode
       71   then
       72     run gbl\inidebug.p .
       73   end.
       74   procedure proc-alt-shift-f3:
       75     run gbl/prvssinf.p
       76       ( input this-procedure
       77       ) .
       78   end.
       79   define variable v-inform-launched as logical no-undo initial false .
       80   procedure proc-alt-shift-f4:
       81     define variable v-action as character no-undo .
       82     if v-inform-launched = false then do:
       83       assign
       84         v-inform-launched = true
       85       .
       86       run gbl/d-inform.w
       87         (  input self
       88         ,  input this-procedure
       89         , output v-action
       90         ) no-error .
       91       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       92       assign
       93         v-inform-launched = false
       94       .
       95     end.
       96   end.
       97   procedure proc-alt-f1:
       98     run gbl/corrhelp.p
       99       (input this-procedure
      100       ) .
      101   end .
      102   on alt-shift-f2 anywhere do:
      103     run proc-alt-shift-f2.
      104   end.
      105   on alt-shift-f3 anywhere do:
      106     run proc-alt-shift-f3 in this-procedure .
      107   end.
      108   on alt-shift-f4 anywhere do:
      109     run proc-alt-shift-f4 in this-procedure.
      110   end.
      111   on alt-f1 anywhere do:
      112     run proc-alt-f1 in this-procedure .
      113   end.
      114   DEFINE BUTTON b-clear AUTO-GO
      115        LABEL "Очистить"
      116        SIZE 10 BY 1.
      117   DEFINE BUTTON B-exit AUTO-GO
      118        LABEL "Ввод"
      119        SIZE 10 BY 1
      120        BGCOLOR 8 .
      121   DEFINE BUTTON b-help
      122        LABEL "Помо&щь"
      123        SIZE 10 BY 1
      124        BGCOLOR 8 .
      125   DEFINE BUTTON b-quit AUTO-END-KEY
      126        LABEL "Отмена"
      127        SIZE 10 BY 1
      128        BGCOLOR 8 .
      129   DEFINE VARIABLE v-name AS CHARACTER FORMAT "X(40)":U
      130        LABEL "Строка фильтра"
      131        VIEW-AS FILL-IN
      132        SIZE 53 BY 1 NO-UNDO.
      133   DEFINE FRAME Dialog-Frame
      134        B-exit AT ROW 1 COL 1
      135        b-quit AT ROW 1 COL 11
      136        b-clear AT ROW 1 COL 21 WIDGET-ID 6
      137        b-help AT ROW 1 COL 57.5
      138        v-name AT ROW 2.5 COL 11.5  WIDGET-ID 2
      139        SPACE(0.99) SKIP(0.37)
      140       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      141            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      142            TITLE "Поиск в правах (в названиях и описаниях прав и темах)"
      143            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit WIDGET-ID 100.
      144   ASSIGN
      145          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      146          FRAME Dialog-Frame:HIDDEN           = TRUE.
      147   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      148   DO:
      149     APPLY "END-ERROR":U TO SELF.
      150   END.
      151   ON CHOOSE OF b-clear IN FRAME Dialog-Frame
      152   DO:
      153     assign
      154       p-name = ""
      155       p-ok = TRUE
      156     .
      157   END.
      158   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      159   DO:
      160     assign
      161       v-name
      162     .
      163     assign
      164       p-name = v-name
      165       p-ok = TRUE
      166     .
      167   END.
      168   ON CHOOSE OF b-help IN FRAME Dialog-Frame
      169   OR HELP OF FRAME Dialog-Frame
      170   DO:
      171     MESSAGE "Help for File: c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\adm\role-sf.w" VIEW-AS ALERT-BOX INFORMATION.
      172   END.
      173   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      174   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      175   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      176   on help of frame Dialog-Frame
      177   do:
      178     run gbl/app_help.p
      179       (input this-procedure :file-name
      180       ,input ''
      181       ,input ?
      182       ) no-error.
      183     if error-status :error then do:
      184       message
      185         "Ошибка при вызове помощи"
      186         error-status :get-message(1)
      187         view-as alert-box .
      188     end.
      189   end.
      190   run minbtn-set in this-procedure .
      191   on choose of b-help in frame Dialog-Frame
      192   do:
      193     apply "help":u to frame Dialog-Frame .
      194   end.
      195   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      196   procedure minbtn-set :
      197       do
      198           on error undo, return error return-value
      199           :
      200           define variable ii              as integer       no-undo .
      201           define variable fh              as widget-handle no-undo .
      202           define variable hh              as widget-handle no-undo .
      203           define variable v-h             as handle        extent 4 no-undo .
      204           define variable v-name-button   as character     no-undo .
      205           define variable v-help-old-x    as decimal       no-undo .
      206           define variable v-help-old-y    as decimal       no-undo .
      207           define variable v-help-old-size as decimal       no-undo .
      208           define variable v-frame-width   as decimal       no-undo .
      209           define variable jj              as integer       no-undo .
      210           do
      211               on error undo, return error
      212               :
      213               assign
      214                   v-frame-width = frame Dialog-Frame:width - 0.3
      215                   fh            = frame Dialog-Frame:first-child
      216                   hh            = fh:first-child
      217                   ii            = 1
      218                   .
      219               do while valid-handle(hh):
      220                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      221                   do:
      222                       case lc(hh:name) :
      223                           when "b-help" then
      224                               do:
      225                                   hh:load-image-up("cmp/b-help.bmp":u) .
      226                                   hh:load-image-down("cmp/b-help.bmp":u) .
      227                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      228                                   hh:TOOLTIP = "Помощь" .
      229                                   v-help-old-x = hh:column .
      230                                   v-help-old-y = hh:row    .
      231                                   v-help-old-size = hh:width .
      232                                   hh:width-chars = 2.5 .
      233                               end.
      234                           when "b-print" then
      235                               do:
      236                                   hh:load-image("cmp/b-print.bmp":u) .
      237                                   hh:TOOLTIP = "Печать" .
      238                                   v-h[ii] = hh:handle .
      239                                   ii = ii + 1 .
      240                                   hh:width-chars = 3 .
      241                               end.
      242                           when "b-history" or
      243                           when "b-hist" then
      244                               do:
      245                                   hh:load-image("cmp/b-hist.bmp":u) .
      246                                   hh:TOOLTIP = "История" .
      247                                   v-h[ii] = hh:handle .
      248                                   ii = ii + 1 .
      249                                   hh:width-chars = 3 .
      250                               end.
      251                           when "b-sch" then
      252                               do:
      253                                   hh:load-image("cmp/b-sch.bmp":u) .
      254                                   hh:TOOLTIP = "Установка Фильтра" .
      255                                   v-h[ii] = hh:handle .
      256                                   ii = ii + 1 .
      257                                   hh:width-chars = 3 .
      258                               end.
      259                           when "b-hist-user" then
      260                               do:
      261                                   hh:load-image("cmp/b-hist.bmp":u) .
      262                                   hh:TOOLTIP = "История пользователя" .
      263                                   ii = ii + 1 .
      264                               end.
      265                       end case.
      266                   end.
      267                   hh = hh:next-sibling.
      268               end.
      269               b-help:column = v-frame-width - b-help:width-chars.
      270               jj = 0.
      271               repeat ii = 4 to 1 by -1 :
      272                   if valid-handle (v-h[ii] ) then
      273                   do:
      274                       jj  = jj + 1 .
      275                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      276                       v-h[ii]:row    = v-help-old-y .
      277                   end.
      278               end.
      279           end.
      280       end.
      281   end procedure.
      282   MAIN-BLOCK:
      283   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      284      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      285     assign
      286       v-name = p-name
      287     .
      288     RUN enable_UI.
      289     WAIT-FOR GO OF FRAME Dialog-Frame FOCUS v-name.
      290   END.
      291   RUN disable_UI.
      292   PROCEDURE disable_UI :
      293     HIDE FRAME Dialog-Frame.
      294   END PROCEDURE.
      295   PROCEDURE enable_UI :
      296     DISPLAY v-name
      297         WITH FRAME Dialog-Frame.
      298     ENABLE B-exit b-quit b-clear b-help v-name
      299         WITH FRAME Dialog-Frame.
      300     VIEW FRAME Dialog-Frame.
      301   END PROCEDURE.
