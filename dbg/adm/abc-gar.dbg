      373   procedure thbjattr_code_reg :
      374   define input  parameter p-upper-code     as character no-undo .
      375   define input  parameter p-code           as character no-undo .
      376   define output parameter p-label          as character no-undo .
      377   define output parameter p-user-can-edit  as logical   no-undo .
      378   define output parameter p-output-display as logical   no-undo .
      379   define output parameter p-other          as character no-undo .
      380   define output parameter p-prop-list      as character no-undo .
      381   define output parameter p-prop-type-list as character no-undo .
      382   define output parameter p-prop-label-list as character no-undo .
      383   define output parameter p-global          as logical no-undo .
      384   define output parameter p-host           as logical no-undo .
      385   define output parameter p-shop           as logical no-undo .
      386   define output parameter p-store          as logical no-undo .
      387   define output parameter p-db             as logical no-undo .
      388   define output parameter p-region         as logical no-undo .
      389   do
      390   on error undo, return error return-value
      391   :
      392       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      393       (input  p-upper-code
      394       ,input  p-code
      395       ,output p-label
      396       ,output p-user-can-edit
      397       ,output p-output-display
      398       ,output p-other
      399       ,output p-prop-list
      400       ,output p-prop-type-list
      401       ,output p-prop-label-list
      402       ,output p-global
      403       ,output p-host
      404       ,output p-shop
      405       ,output p-store
      406       ,output p-db
      407       ,output p-region
      408       ) no-error .
      409     if error-status :error
      410     then do:
      411       undo, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message (1)).
      412     end.
      413   end.
      414   end procedure.
