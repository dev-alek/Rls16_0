      625   procedure proc-alt-shift-f2:
      626     if not ibs.th.gbl.gbl-var:rcode
      627   then
      628     run gbl\inidebug.p .
      629   end.
      630   procedure proc-alt-shift-f3:
      631     run gbl/prvssinf.p
      632       ( input this-procedure
      633       ) .
      634   end.
      635   define variable v-inform-launched as logical no-undo initial false .
      636   procedure proc-alt-shift-f4:
      637     define variable v-action as character no-undo .
      638     if v-inform-launched = false then do:
      639       assign
      640         v-inform-launched = true
      641       .
      642       run gbl/d-inform.w
      643         (  input self
      644         ,  input this-procedure
      645         , output v-action
      646         ) no-error .
      647       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      648       assign
      649         v-inform-launched = false
      650       .
      651     end.
      652   end.
      653   procedure proc-alt-f1:
      654     run gbl/corrhelp.p
      655       (input this-procedure
      656       ) .
      657   end .
      658   on alt-shift-f2 anywhere do:
      659     run proc-alt-shift-f2.
      660   end.
      661   on alt-shift-f3 anywhere do:
      662     run proc-alt-shift-f3 in this-procedure .
      663   end.
      664   on alt-shift-f4 anywhere do:
      665     run proc-alt-shift-f4 in this-procedure.
      666   end.
      667   on alt-f1 anywhere do:
      668     run proc-alt-f1 in this-procedure .
      669   end.
      670   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      671     define variable v-cntxt-db-num        as integer   no-undo .
      672     define variable v-cntxt-userid        as character no-undo .
      673     define variable v-cntxt-level         as character no-undo .
      674     define variable v-cntxt-host-code-obj as integer   no-undo .
      675     define variable v-cntxt-obj-type      as character no-undo .
      676     define variable v-cntxt-obj-code      as integer   no-undo .
      677     define variable v-cntxt-db-num-obj    as integer   no-undo .
      678     define variable v-cntxt-is-admin      as logical   no-undo .
      679   DEFINE VARIABLE v-db-num LIKE ub.db.db-num NO-UNDO.
      680   DEFINE VARIABLE v-host-code LIKE ub.shop.host-code NO-UNDO.
      681   DEFINE VARIABLE v-to-create AS logical NO-UNDO.
      682   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      683   define variable v-tth as handle no-undo .
      684   assign
      685   v-tth = buffer thbjattr_thbj-attr:table-handle .
      686   define variable str-attr AS CHARACTER NO-UNDO .
      687   DEFINE BUTTON B-exit AUTO-GO
      688        LABEL "&Ввод"
      689        SIZE 10 BY 1
      690        BGCOLOR 8 .
      691   DEFINE BUTTON B-Help
      692        LABEL "&Помощь"
      693        SIZE 10 BY 1
      694        BGCOLOR 8 .
      695   DEFINE BUTTON b-quit AUTO-END-KEY
      696        LABEL "&Отмена"
      697        SIZE 10 BY 1
      698        BGCOLOR 8 .
      699   DEFINE VARIABLE v-a AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
      700        LABEL "A"
      701        VIEW-AS FILL-IN
      702        SIZE 14 BY 1 NO-UNDO.
      703   DEFINE VARIABLE v-b AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
      704        LABEL "B"
      705        VIEW-AS FILL-IN
      706        SIZE 14 BY 1 NO-UNDO.
      707   DEFINE VARIABLE v-c AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
      708        LABEL "C"
      709        VIEW-AS FILL-IN
      710        SIZE 14 BY 1 NO-UNDO.
      711   DEFINE VARIABLE v-d AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
      712        LABEL "D"
      713        VIEW-AS FILL-IN
      714        SIZE 14 BY 1 NO-UNDO.
      715   DEFINE VARIABLE v-E AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
      716        LABEL "E"
      717        VIEW-AS FILL-IN
      718        SIZE 14 BY 1 NO-UNDO.
      719   DEFINE VARIABLE v-F AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
      720        LABEL "F"
      721        VIEW-AS FILL-IN
      722        SIZE 14 BY 1 NO-UNDO.
      723   DEFINE FRAME Dialog-Frame
      724        B-exit AT ROW 1 COL 1
      725        b-quit AT ROW 1 COL 11
      726        B-Help AT ROW 1 COL 21
      727        v-a AT ROW 2.5 COL 10.5 COLON-ALIGNED
      728        v-b AT ROW 3.75 COL 10.5 COLON-ALIGNED
      729        v-c AT ROW 5 COL 10.5 COLON-ALIGNED
      730        v-d AT ROW 6.5 COL 10.5 COLON-ALIGNED
      731        v-E AT ROW 7.75 COL 10.5 COLON-ALIGNED
      732        v-F AT ROW 9 COL 10.5 COLON-ALIGNED
      733        SPACE(11.12) SKIP(1.87)
      734       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      735            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      736            TITLE "Гарантийный запас в днях для ABC"
      737            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      738   ASSIGN
      739          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      740          FRAME Dialog-Frame:HIDDEN           = TRUE.
      741   ON GO OF FRAME Dialog-Frame
      742   DO:
      743     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      744     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      745   END.
      746   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      747   DO:
      748     APPLY "END-ERROR":U TO SELF.
      749   END.
      750   ON LEAVE OF v-a IN FRAME Dialog-Frame
      751   DO:
      752     ASSIGN v-a.
      753   END.
      754   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      755   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      756   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      757   on help of frame Dialog-Frame
      758   do:
      759     run gbl/app_help.p
      760       (input this-procedure :file-name
      761       ,input ''
      762       ,input ?
      763       ) no-error.
      764     if error-status :error then do:
      765       message
      766         "Ошибка при вызове помощи"
      767         error-status :get-message(1)
      768         view-as alert-box .
      769     end.
      770   end.
      771   run minbtn-set in this-procedure .
      772   on choose of b-help in frame Dialog-Frame
      773   do:
      774     apply "help":u to frame Dialog-Frame .
      775   end.
      776   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      777   procedure minbtn-set :
      778       do
      779           on error undo, return error return-value
      780           :
      781           define variable ii              as integer       no-undo .
      782           define variable fh              as widget-handle no-undo .
      783           define variable hh              as widget-handle no-undo .
      784           define variable v-h             as handle        extent 4 no-undo .
      785           define variable v-name-button   as character     no-undo .
      786           define variable v-help-old-x    as decimal       no-undo .
      787           define variable v-help-old-y    as decimal       no-undo .
      788           define variable v-help-old-size as decimal       no-undo .
      789           define variable v-frame-width   as decimal       no-undo .
      790           define variable jj              as integer       no-undo .
      791           do
      792               on error undo, return error
      793               :
      794               assign
      795                   v-frame-width = frame Dialog-Frame:width - 0.3
      796                   fh            = frame Dialog-Frame:first-child
      797                   hh            = fh:first-child
      798                   ii            = 1
      799                   .
      800               do while valid-handle(hh):
      801                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      802                   do:
      803                       case lc(hh:name) :
      804                           when "b-help" then
      805                               do:
      806                                   hh:load-image-up("cmp/b-help.bmp":u) .
      807                                   hh:load-image-down("cmp/b-help.bmp":u) .
      808                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      809                                   hh:TOOLTIP = "Помощь" .
      810                                   v-help-old-x = hh:column .
      811                                   v-help-old-y = hh:row    .
      812                                   v-help-old-size = hh:width .
      813                                   hh:width-chars = 2.5 .
      814                               end.
      815                           when "b-print" then
      816                               do:
      817                                   hh:load-image("cmp/b-print.bmp":u) .
      818                                   hh:TOOLTIP = "Печать" .
      819                                   v-h[ii] = hh:handle .
      820                                   ii = ii + 1 .
      821                                   hh:width-chars = 3 .
      822                               end.
      823                           when "b-history" or
      824                           when "b-hist" then
      825                               do:
      826                                   hh:load-image("cmp/b-hist.bmp":u) .
      827                                   hh:TOOLTIP = "История" .
      828                                   v-h[ii] = hh:handle .
      829                                   ii = ii + 1 .
      830                                   hh:width-chars = 3 .
      831                               end.
      832                           when "b-sch" then
      833                               do:
      834                                   hh:load-image("cmp/b-sch.bmp":u) .
      835                                   hh:TOOLTIP = "Установка Фильтра" .
      836                                   v-h[ii] = hh:handle .
      837                                   ii = ii + 1 .
      838                                   hh:width-chars = 3 .
      839                               end.
      840                           when "b-hist-user" then
      841                               do:
      842                                   hh:load-image("cmp/b-hist.bmp":u) .
      843                                   hh:TOOLTIP = "История пользователя" .
      844                                   ii = ii + 1 .
      845                               end.
      846                       end case.
      847                   end.
      848                   hh = hh:next-sibling.
      849               end.
      850               b-help:column = v-frame-width - b-help:width-chars.
      851               jj = 0.
      852               repeat ii = 4 to 1 by -1 :
      853                   if valid-handle (v-h[ii] ) then
      854                   do:
      855                       jj  = jj + 1 .
      856                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      857                       v-h[ii]:row    = v-help-old-y .
      858                   end.
      859               end.
      860           end.
      861       end.
      862   end procedure.
      863   MAIN-BLOCK:
      864   do on error   undo main-block, leave main-block
      865      on end-key undo main-block, leave main-block:
      866     IF p-mode <> 'ПРОСМОТР':U
      867     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
      868         MESSAGE
      869         vss-workfile vss-revision vss-description skip
      870         "Неверное значение параметра p-mode" p-mode
      871         VIEW-AS ALERT-BOX ERROR.
      872         UNDO, RETURN ERROR.
      873     END.
      874     IF p-obj-type <> 'маг':U
      875     and p-obj-type <> 'орг':U
      876     AND p-obj-type <> 'скл':U
      877     and p-obj-type <> '':U
      878     THEN DO:
      879         MESSAGE
      880         vss-workfile vss-revision vss-description skip
      881         "Неверное значение параметра p-obj-type" p-obj-type
      882         VIEW-AS ALERT-BOX ERROR.
      883         UNDO, RETURN ERROR.
      884     END.
      885     if p-obj-type = 'маг':U then do:
      886       FIND FIRST X_shop NO-LOCK WHERE X_shop.obj-code = p-obj-code NO-ERROR.
      887       IF NOT AVAILABLE X_shop THEN DO:
      888           MESSAGE
      889           vss-workfile vss-revision vss-description skip
      890           "Неверное значение параметра p-obj-code" p-obj-code
      891           VIEW-AS ALERT-BOX ERROR.
      892           UNDO, RETURN ERROR.
      893       END.
      894   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      895   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      896     (input  'маг':U
      897     ,input  p-obj-code
      898     ,output v-db-num
      899     )  .
      900       IF v-db-num <> v-cntxt-db-num AND v-cntxt-db-num <> 0 THEN DO:
      901           MESSAGE
      902           "Нельзя менять параметры магазина в чужой БД" skip
      903           "магазин принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
      904           VIEW-AS ALERT-BOX ERROR.
      905           UNDO, RETURN ERROR.
      906       END.
      907   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      908   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      909     (input  p-obj-type
      910     ,input  p-obj-code
      911     ,output v-host-code
      912     )  .
      913     end.
      914     if p-obj-type = 'орг':U then do:
      915       FIND FIRST X_sysconf NO-LOCK WHERE X_sysconf.host-code = p-obj-code NO-ERROR.
      916       IF NOT AVAILABLE X_sysconf THEN DO:
      917           MESSAGE
      918           vss-workfile vss-revision vss-description skip
      919           "Неверное значение параметра p-obj-code" p-obj-code
      920           VIEW-AS ALERT-BOX ERROR.
      921           UNDO, RETURN ERROR.
      922       END.
      923       if v-cntxt-db-num <> 0
      924       and p-mode <> 'ПРОСМОТР':U
      925       then do:
      926           MESSAGE
      927           "Нельзя менять параметры ФИРМЫ в УБД" skip
      928           VIEW-AS ALERT-BOX ERROR.
      929           UNDO, RETURN ERROR.
      930       end.
      931       v-host-code = p-obj-code.
      932     end.
      933     if p-obj-type = 'скл':U then do:
      934       FIND FIRST X_store NO-LOCK WHERE X_store.obj-code = p-obj-code NO-ERROR.
      935       IF NOT AVAILABLE X_store THEN DO:
      936           MESSAGE
      937           vss-workfile vss-revision vss-description skip
      938           "Неверное значение параметра p-obj-code" p-obj-code
      939           VIEW-AS ALERT-BOX ERROR.
      940           UNDO, RETURN ERROR.
      941       END.
      942   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      943   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      944     (input  'маг':U
      945     ,input  p-obj-code
      946     ,output v-db-num
      947     )  .
      948       IF v-db-num <> v-cntxt-db-num AND v-cntxt-db-num <> 0 THEN DO:
      949           MESSAGE
      950           "Нельзя менять параметры склада в чужой БД" skip
      951           "склад принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
      952           VIEW-AS ALERT-BOX ERROR.
      953           UNDO, RETURN ERROR.
      954       END.
      955   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      956   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      957     (input  p-obj-type
      958     ,input  p-obj-code
      959     ,output v-host-code
      960     )  .
      961     end.
      962     if p-obj-type = '':U then do:
      963       if v-cntxt-db-num <> 0
      964       and p-mode <> 'ПРОСМОТР':U
      965       then do:
      966           MESSAGE
      967           "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" skip
      968           VIEW-AS ALERT-BOX ERROR.
      969           UNDO, RETURN ERROR.
      970       end.
      971     end.
      972     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
      973       FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
      974                 LOCKED_thbj-attr.obj-type = p-obj-type
      975           AND   LOCKED_thbj-attr.obj-code = p-obj-code
      976           AND   LOCKED_thbj-attr.upper-prop-code = 'abc-sale-day':U
      977           AND   locked_thbj-attr.prop-code = '':U NO-WAIT NO-ERROR.
      978        if locked locked_thbj-attr then do:
      979           message
      980           vss-workfile vss-revision vss-description skip
      981            "Запись ПАРАМЕТРЫ(АТРИБУТЫ) ФИРМЫ/МАГАЗИНА/СКЛАДА занята"
      982           view-as alert-box error .
      983           undo, return error.
      984         end.
      985     END.
      986     ELSE DO:
      987         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
      988             LOCKED_thbj-attr.obj-type = p-obj-type
      989       AND   LOCKED_thbj-attr.obj-code = p-obj-code
      990       AND   LOCKED_thbj-attr.upper-prop-code = 'abc-sale-day':U
      991       AND   locked_thbj-attr.prop-code = '':U NO-ERROR.
      992     END.
      993     if not available locked_thbj-attr then do:
      994       ASSIGN
      995       v-to-create  = YES.
      996       message
      997       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
      998                   chr(10))
      999       view-as alert-box WARNING.
     1000     end.
     1001     run FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     1002     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     1003     run Myenable in this-procedure .
     1004      wait-for go of frame Dialog-Frame.
     1005   end.
     1006   run disable_ui in this-procedure .
     1007   PROCEDURE disable_UI :
     1008     HIDE FRAME Dialog-Frame.
     1009   END PROCEDURE.
     1010   PROCEDURE enable_UI :
     1011     DISPLAY v-a v-b v-c v-d v-E v-F
     1012         WITH FRAME Dialog-Frame.
     1013     ENABLE B-exit b-quit B-Help v-a v-b v-c v-d v-E v-F
     1014         WITH FRAME Dialog-Frame.
     1015     VIEW FRAME Dialog-Frame.
     1016   END PROCEDURE.
     1017   PROCEDURE Fill-widgets :
     1018   define variable v-value-character as character no-undo .
     1019   define variable v-value-date as date no-undo .
     1020   define variable v-value-decimal as decimal no-undo .
     1021   define variable v-value-integer as INTEGER no-undo .
     1022   define variable v-value-logical AS LOGICAL no-undo .
     1023   define variable v-param-type as character no-undo .
     1024   define variable v-param-value as character no-undo .
     1025   FOR EACH thbjattr_thbj-attr:
     1026     delete thbjattr_thbj-attr.
     1027   end.
     1028   FOR EACH temp-thbj-attr:
     1029     delete temp-thbj-attr.
     1030   end.
     1031   run adm/shattri.p (
     1032                 input "init":U
     1033               , input p-obj-type
     1034               , input p-obj-code
     1035               , input 'abc-sale-day':U
     1036               , input "":U
     1037               , output v-value-character
     1038               , output v-value-date
     1039               , output v-value-decimal
     1040               , output v-value-integer
     1041               , output v-value-logical
     1042               , output v-param-type
     1043               , INPUT-OUTPUT TABLE-handle v-tth
     1044               ) no-error .
     1045   if error-status:error
     1046   and not available locked_thbj-attr then do:
     1047     message
     1048     "Не удалось получить начальные значения настроек" skip
     1049     error-status:get-message(1) return-value
     1050     view-as alert-box error .
     1051     undo, return error .
     1052   end.
     1053   FOR EACH thbjattr_thbj-attr:
     1054     IF thbjattr_thbj-attr.prop-code = 'A':U THEN DO:
     1055       v-a = thbjattr_thbj-attr.property-value-integer.
     1056       v-a:private-data IN FRAME Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr)).
     1057     END.
     1058     IF thbjattr_thbj-attr.prop-code = 'B':U THEN DO:
     1059       v-b = thbjattr_thbj-attr.property-value-integer.
     1060       v-b:private-data = "recid=" + string(recid(thbjattr_thbj-attr)).
     1061     END.
     1062     IF thbjattr_thbj-attr.prop-code = 'C':U THEN DO:
     1063       v-c = thbjattr_thbj-attr.property-value-integer.
     1064       v-c:private-data = "recid=" + string(recid(thbjattr_thbj-attr)).
     1065     END.
     1066     IF thbjattr_thbj-attr.prop-code = 'D':U THEN DO:
     1067       v-D = thbjattr_thbj-attr.property-value-integer.
     1068       v-d:private-data = "recid=" + string(recid(thbjattr_thbj-attr)).
     1069     END.
     1070     IF thbjattr_thbj-attr.prop-code = 'E':U THEN DO:
     1071       v-E = thbjattr_thbj-attr.property-value-integer.
     1072       v-e:private-data = "recid=" + string(recid(thbjattr_thbj-attr)).
     1073     END.
     1074     IF thbjattr_thbj-attr.prop-code = 'F':U THEN DO:
     1075       v-F = thbjattr_thbj-attr.property-value-integer.
     1076       v-f:private-data = "recid=" + string(recid(thbjattr_thbj-attr)).
     1077     END.
     1078     create temp-thbj-attr.
     1079     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     1080   END.
     1081   END PROCEDURE.
     1082   PROCEDURE MyEnable :
     1083   DISPLAY
     1084   v-a
     1085   v-b
     1086   v-c
     1087   v-d
     1088   v-E
     1089   v-F
     1090   with frame Dialog-Frame .
     1091   ENABLE
     1092   B-exit WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1093   b-quit
     1094   B-Help
     1095   v-a WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1096   v-b WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1097   v-c WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1098   v-d WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1099   v-E WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1100   v-F WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1101   WITH FRAME Dialog-Frame.
     1102   VIEW FRAME Dialog-Frame.
     1103   if p-mode = 'ПРОСМОТР':U then do:
     1104     hide
     1105     b-exit in frame Dialog-Frame.
     1106     b-quit:label = "&Выход".
     1107     b-quit:column = 1.
     1108     display
     1109     b-quit with frame Dialog-Frame.
     1110   END.
     1111   END PROCEDURE.
     1112   PROCEDURE proc-save :
     1113   define variable v-value-character as character no-undo .
     1114   define variable v-value-date as date no-undo .
     1115   define variable v-value-decimal as decimal no-undo .
     1116   define variable v-value-integer as INTEGER no-undo .
     1117   define variable v-value-logical AS LOGICAL no-undo .
     1118   define variable v-sale-add as character no-undo .
     1119   define variable v-trf-type like ub.clients.obj-type no-undo .
     1120   define variable v-trf-code like ub.clients.obj-code no-undo .
     1121   define variable v-param-type as character no-undo .
     1122   define variable wh as widget-handle no-undo .
     1123   define variable fh as widget-handle no-undo .
     1124   define variable v-same as logical no-undo .
     1125   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     1126   ASSIGN
     1127   FRAME Dialog-Frame
     1128   v-a v-b v-c v-d v-E v-F .
     1129   assign
     1130   fh = frame Dialog-Frame:first-child
     1131   wh = fh:first-child
     1132   .
     1133   do while valid-handle(wh):
     1134     if wh:private-data begins "recid=" then do:
     1135       find first thbjattr_thbj-attr where
     1136                 recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     1137       assign
     1138       buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     1139       thbjattr_thbj-attr.obj-type = p-obj-type.
     1140       thbjattr_thbj-attr.obj-code = p-obj-code.
     1141     end.
     1142     wh = wh:next-sibling.
     1143   end.
     1144   v-same = yes.
     1145   for each thbjattr_thbj-attr,
     1146       first temp-thbj-attr where
     1147             temp-thbj-attr.obj-type         = thbjattr_thbj-attr.obj-type
     1148         and temp-thbj-attr.obj-code         = thbjattr_thbj-attr.obj-code
     1149         and temp-thbj-attr.upper-prop-code  = thbjattr_thbj-attr.upper-prop-code
     1150         and temp-thbj-attr.prop-code        = thbjattr_thbj-attr.prop-code:
     1151      buffer-compare
     1152      thbjattr_thbj-attr
     1153      to temp-thbj-attr
     1154      save result in v-same.
     1155      if not v-same then leave.
     1156   end.
     1157   v-same = no.
     1158   IF v-same  and not v-to-create THEN RETURN.
     1159   run adm/shattri.p (
     1160     input "check":U
     1161     , input p-obj-type
     1162     , input p-obj-code
     1163     , input 'abc-sale-day':U
     1164     , INPUT '':U
     1165     , output v-value-character
     1166     , output v-value-date
     1167     , output v-value-decimal
     1168     , output v-value-integer
     1169     , output v-value-logical
     1170     , output v-param-type
     1171     , input-output TABLE-handle v-tth
     1172     ) no-error .
     1173   if error-status:error then do:
     1174     message
     1175     "Некорректное значение ПАРАМЕТРОВ" skip
     1176     error-status:get-message(1) skip
     1177     return-value
     1178     view-as alert-box error .
     1179     undo, return error .
     1180   end.
     1181   do TRANSACTION
     1182   on error undo, return error return-value
     1183   :
     1184     RUN thbjattr_set-section IN THIS-PROCEDURE (
     1185          input p-obj-type
     1186         ,input p-obj-code
     1187         ,input 'abc-sale-day':U
     1188         ,INPUT table thbjattr_thbj-attr
     1189     ) NO-ERROR.
     1190     IF ERROR-STATUS:error THEN do:
     1191       MESSAGE ERROR-STATUS:get-message(1)  SKIP
     1192       RETURN-VALUE
     1193       VIEW-AS ALERT-BOX.
     1194       UNDO, RETURN ERROR.
     1195     END.
     1196   end.
     1197   END PROCEDURE.
