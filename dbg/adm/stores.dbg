     1444      ( input parParentProc,
     1445        input x_clients.obj-type ,
     1446        input x_clients.obj-code ).
     1447     v-exist-price-grp = true .
     1448     run metod-gop-obj-all (input v-cntxt-db-num) .
     1449     v-grp:visible in browse br-stores = true  .
     1450     run enable_UI.
     1451   END.
     1452   ON CHOOSE OF b-add IN FRAME d-store
     1453   DO:
     1454     define variable ri as recid no-undo.
     1455     define buffer buf_store for ub.store.
     1456     define buffer buf_clients for ub.clients.
     1457     run adm/storei.w ( input parparentproc
     1458                       ,input v-cntxt-host-code-obj
     1459                       ,input 0
     1460                       ,input 'ДОБАВЛЕНИЕ':U
     1461                       ,input-output ri).
     1462     if ri <> ? then do:
     1463         find buf_clients where
     1464            recid (buf_clients) = ri no-lock.
     1465         find buf_store where
     1466             buf_store.obj-code = buf_clients.obj-code no-lock.
     1467         ri = recid (buf_store).
     1468         run enable_UI.
     1469         reposition br-stores to recid ri no-error.
     1470         apply "ENTRY" to br-stores.
     1471     end.
     1472     return no-apply.
     1473   END.
     1474   ON CHOOSE OF b-chg IN FRAME d-store
     1475   DO:
     1476     define variable ri as recid no-undo.
     1477     if available X_store then do:
     1478         ri = recid (X_clients).
     1479         run adm/storei.w ( input parparentproc
     1480                           ,input v-cntxt-host-code-obj
     1481                           ,input X_store.obj-code
     1482                           ,input 'ИЗМЕНЕНИЕ':U
     1483                           ,input-output ri).
     1484         display
     1485         X_clients.obj-name
     1486         X_clients.grp-name
     1487         X_store.shift-on
     1488         with browse br-stores.
     1489     end.
     1490   END.
     1491   ON CHOOSE OF b-del IN FRAME d-store
     1492   DO:
     1493     define variable ri as recid no-undo.
     1494     if available X_store then do:
     1495       ri = recid(X_store).
     1496       run ref/clients2.p ( input parparentproc
     1497                           ,input recid(X_clients)
     1498                           ,input ?
     1499                           ,input no
     1500                           ,input yes
     1501                           ,input '':U
     1502                           ,input '':U
     1503                           ,input '':U
     1504                           ) no-error .
     1505       if error-status:error then do:
     1506         return no-apply.
     1507       end.
     1508       run Openbr in this-procedure .
     1509       reposition br-stores to recid ri no-error.
     1510       apply "ENTRY" to br-stores.
     1511       apply "value-changed" to br-stores.
     1512     end.
     1513   END.
     1514   ON CHOOSE OF b-lkp IN FRAME d-store
     1515   DO:
     1516     define variable ri as recid no-undo.
     1517     if available X_store then do:
     1518         ri = recid (X_clients).
     1519         run adm/storei.w ( input parparentproc
     1520                           ,input v-cntxt-host-code-obj
     1521                           ,input X_store.obj-code
     1522                           ,input 'ПРОСМОТР':U
     1523                           ,input-output ri).
     1524         apply "entry" to browse br-stores.
     1525     end.
     1526   END.
     1527   ON CHOOSE OF b-price IN FRAME d-store
     1528   DO:
     1529     if not available X_store then return no-apply.
     1530     define variable v-rec-list as character no-undo .
     1531     run str/pdfobj.w
     1532           ( input parparentproc ,
     1533             input "all" ,
     1534             input 'скл':U ,
     1535             input X_store.obj-code ,
     1536             input ? ,
     1537             input ? ,
     1538             input "b-add,b-del,b-chg" ,
     1539             input-output v-rec-list
     1540             ) .
     1541   END.
     1542   ON CHOOSE OF b-quit IN FRAME d-store
     1543   DO:
     1544   END.
     1545   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1546   on help of frame d-store
     1547   do:
     1548     run gbl/app_help.p
     1549       (input this-procedure :file-name
     1550       ,input ''
     1551       ,input ?
     1552       ) no-error.
     1553     if error-status :error then do:
     1554       message
     1555         "Ошибка при вызове помощи"
     1556         error-status :get-message(1)
     1557         view-as alert-box .
     1558     end.
     1559   end.
     1560   run minbtn-set in this-procedure .
     1561   on choose of b-help in frame d-store
     1562   do:
     1563     apply "help":u to frame d-store .
     1564   end.
     1565   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1566   procedure minbtn-set :
     1567       do
     1568           on error undo, return error return-value
     1569           :
     1570           define variable ii              as integer       no-undo .
     1571           define variable fh              as widget-handle no-undo .
     1572           define variable hh              as widget-handle no-undo .
     1573           define variable v-h             as handle        extent 4 no-undo .
     1574           define variable v-name-button   as character     no-undo .
     1575           define variable v-help-old-x    as decimal       no-undo .
     1576           define variable v-help-old-y    as decimal       no-undo .
     1577           define variable v-help-old-size as decimal       no-undo .
     1578           define variable v-frame-width   as decimal       no-undo .
     1579           define variable jj              as integer       no-undo .
     1580           do
     1581               on error undo, return error
     1582               :
     1583               assign
     1584                   v-frame-width = frame d-store:width - 0.3
     1585                   fh            = frame d-store:first-child
     1586                   hh            = fh:first-child
     1587                   ii            = 1
     1588                   .
     1589               do while valid-handle(hh):
     1590                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1591                   do:
     1592                       case lc(hh:name) :
     1593                           when "b-help" then
     1594                               do:
     1595                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1596                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1597                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1598                                   hh:TOOLTIP = "Помощь" .
     1599                                   v-help-old-x = hh:column .
     1600                                   v-help-old-y = hh:row    .
     1601                                   v-help-old-size = hh:width .
     1602                                   hh:width-chars = 2.5 .
     1603                               end.
     1604                           when "b-print" then
     1605                               do:
     1606                                   hh:load-image("cmp/b-print.bmp":u) .
     1607                                   hh:TOOLTIP = "Печать" .
     1608                                   v-h[ii] = hh:handle .
     1609                                   ii = ii + 1 .
     1610                                   hh:width-chars = 3 .
     1611                               end.
     1612                           when "b-history" or
     1613                           when "b-hist" then
     1614                               do:
     1615                                   hh:load-image("cmp/b-hist.bmp":u) .
     1616                                   hh:TOOLTIP = "История" .
     1617                                   v-h[ii] = hh:handle .
     1618                                   ii = ii + 1 .
     1619                                   hh:width-chars = 3 .
     1620                               end.
     1621                           when "b-sch" then
     1622                               do:
     1623                                   hh:load-image("cmp/b-sch.bmp":u) .
     1624                                   hh:TOOLTIP = "Установка Фильтра" .
     1625                                   v-h[ii] = hh:handle .
     1626                                   ii = ii + 1 .
     1627                                   hh:width-chars = 3 .
     1628                               end.
     1629                           when "b-hist-user" then
     1630                               do:
     1631                                   hh:load-image("cmp/b-hist.bmp":u) .
     1632                                   hh:TOOLTIP = "История пользователя" .
     1633                                   ii = ii + 1 .
     1634                               end.
     1635                       end case.
     1636                   end.
     1637                   hh = hh:next-sibling.
     1638               end.
     1639               b-help:column = v-frame-width - b-help:width-chars.
     1640               jj = 0.
     1641               repeat ii = 4 to 1 by -1 :
     1642                   if valid-handle (v-h[ii] ) then
     1643                   do:
     1644                       jj  = jj + 1 .
     1645                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1646                       v-h[ii]:row    = v-help-old-y .
     1647                   end.
     1648               end.
     1649           end.
     1650       end.
     1651   end procedure.
     1652   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1653   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1654   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1655   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1656   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1657   define variable v-diasize-current-frame-height as decimal   no-undo .
     1658   define variable v-diasize-change-size          as logical   no-undo .
     1659   define variable v-diasize-resize-button        as handle    no-undo .
     1660   define variable v-diasize-wndmax               as logical   no-undo .
     1661   define variable v-diasize-wndstore             as logical   no-undo .
     1662   define variable v-diasize-proc-name            as character no-undo .
     1663   define variable v-diasize-browse-handle        as handle    no-undo .
     1664   define variable v-diasize-browse-number        as integer   no-undo .
     1665   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1666   define temp-table temp-diasize-handle no-undo
     1667     field handle-value  as handle
     1668     field save-position as decimal
     1669     index xpk is primary unique handle-value
     1670     .
     1671   define temp-table temp-browse-handle no-undo
     1672     field browse-type   as character
     1673     field browse-number as integer
     1674     field browse-handle as handle
     1675     field original-size as decimal
     1676     index xpk is primary unique browse-type browse-number
     1677     index xie browse-type browse-handle
     1678   .
     1679   procedure diasize_change-height :
     1680     define input  parameter p-change-value  as decimal   no-undo .
     1681     define input  parameter p-move-resize   as logical   no-undo .
     1682     define variable v-field-group-handle    as handle    no-undo .
     1683     define variable v-object-handle         as handle    no-undo .
     1684     define variable v-frame-height          as decimal   no-undo .
     1685     define variable v-frame-virtual-height  as decimal   no-undo .
     1686     define variable v-browse-height         as decimal   no-undo .
     1687     define variable v-window-height         as decimal   no-undo .
     1688     define variable v-window-virtual-height as decimal   no-undo .
     1689     define variable v-change-sign           as integer   no-undo .
     1690     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1691     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1692     if p-change-value > 0
     1693     then do:
     1694       if frame d-store :height + p-change-value
     1695           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1696       then do:
     1697         assign
     1698           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1699                           - (frame d-store :height-chars)
     1700         .
     1701         if p-change-value <= 0
     1702         then do:
     1703           run diasize_position-resize-button in this-procedure .
     1704           return .
     1705         end.
     1706       end.
     1707     end.
     1708     if p-change-value < 0
     1709     then do:
     1710       if frame d-store :height + p-change-value < v-diasize-orig-frame-height
     1711       then do:
     1712         assign
     1713           p-change-value = v-diasize-orig-frame-height
     1714                          - (frame d-store :height-chars)
     1715         .
     1716         if p-change-value >= 0
     1717         then do:
     1718           run diasize_position-resize-button in this-procedure .
     1719           return .
     1720         end.
     1721       end.
     1722     end.
     1723     if p-change-value >= 0
     1724     then do:
     1725       assign
     1726         v-change-sign = 1
     1727       .
     1728     end.
     1729     else do:
     1730       assign
     1731         v-change-sign = -1
     1732       .
     1733     end.
     1734     assign
     1735       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1736     .
     1737     if p-change-value = 0
     1738     then do:
     1739       run diasize_position-resize-button in this-procedure .
     1740       return .
     1741     end.
     1742     move_block:
     1743     do
     1744     on error undo move_block, retry move_block
     1745     :
     1746       if retry
     1747       then do:
     1748         do
     1749         on error undo move_block, leave move_block
     1750         :
     1751           if p-change-value > 0
     1752           then do:
     1753             for each buf_temp-diasize-handle
     1754             on error undo, next
     1755             :
     1756               assign
     1757                 v-object-handle = buf_temp-diasize-handle.handle-value
     1758               .
     1759               if v-object-handle <> v-diasize-resize-button
     1760               then do:
     1761                 assign
     1762                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1763                 .
     1764               end.
     1765             end.
     1766             assign
     1767               v-diasize-browse-handle :height = v-browse-height
     1768             .
     1769             for each buf_temp-browse-handle
     1770               where buf_temp-browse-handle.browse-type = 'height':u
     1771             on error undo, next
     1772             :
     1773               assign
     1774                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1775               .
     1776             end.
     1777             assign
     1778               frame d-store :height = v-frame-height
     1779             .
     1780             if frame d-store :scrollable = true
     1781             then do:
     1782               assign
     1783                 frame d-store :virtual-height = v-frame-virtual-height
     1784               .
     1785             end.
     1786             run diasize_position-resize-button in this-procedure .
     1787           end.
     1788           else do:
     1789             if frame d-store :scrollable = true
     1790             then do:
     1791               assign
     1792                 frame d-store :virtual-height = v-frame-virtual-height
     1793               .
     1794             end.
     1795             assign
     1796               frame d-store :height = v-frame-height
     1797             .
     1798             assign
     1799               v-diasize-browse-handle :height = v-browse-height
     1800             .
     1801             for each buf_temp-browse-handle
     1802               where buf_temp-browse-handle.browse-type = 'height':u
     1803             on error undo, next
     1804             :
     1805               assign
     1806                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1807               .
     1808             end.
     1809             for each buf_temp-diasize-handle
     1810             on error undo, next
     1811             :
     1812               assign
     1813                 v-object-handle = buf_temp-diasize-handle.handle-value
     1814               .
     1815               if v-object-handle <> v-diasize-resize-button
     1816               then do:
     1817                 assign
     1818                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1819                 .
     1820               end.
     1821             end.
     1822             run diasize_position-resize-button in this-procedure .
     1823           end.
     1824           assign
     1825             v-diasize-change-size = false
     1826           .
     1827           leave move_block .
     1828         end.
     1829       end.
     1830       assign
     1831         v-diasize-need-full-display = true
     1832       .
     1833       if v-diasize-change-size = false
     1834       then do:
     1835         assign
     1836           v-diasize-change-size = true
     1837         .
     1838       end.
     1839       else do:
     1840         return .
     1841       end.
     1842       assign
     1843         v-frame-height = frame d-store :height
     1844         v-frame-virtual-height = frame d-store :virtual-height
     1845         v-browse-height = v-diasize-browse-handle :height
     1846       .
     1847       for each buf_temp-browse-handle
     1848         where buf_temp-browse-handle.browse-type = 'height':u
     1849       :
     1850         assign
     1851           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1852         .
     1853       end.
     1854       for each buf_temp-diasize-handle
     1855       :
     1856         delete buf_temp-diasize-handle .
     1857       end.
     1858       assign
     1859         v-field-group-handle = frame d-store :first-child
     1860       .
     1861       do while valid-handle(v-field-group-handle)
     1862       :
     1863         assign
     1864           v-object-handle = v-field-group-handle :first-child
     1865         .
     1866         do while valid-handle(v-object-handle)
     1867         :
     1868           if  v-object-handle <> v-diasize-browse-handle :handle
     1869           and can-query(v-object-handle, "row")
     1870           and can-query(v-object-handle, "height")
     1871           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1872           then do:
     1873             find first buf_temp-browse-handle
     1874               where buf_temp-browse-handle.browse-type   = 'height':u
     1875                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1876               no-error .
     1877             if available buf_temp-browse-handle
     1878             then do:
     1879             end.
     1880             else do:
     1881               create buf_temp-diasize-handle .
     1882               assign
     1883                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1884                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1885               .
     1886             end.
     1887           end.
     1888           assign
     1889             v-object-handle = v-object-handle :next-sibling
     1890           .
     1891         end.
     1892         assign
     1893           v-field-group-handle = v-field-group-handle :next-sibling
     1894         .
     1895       end.
     1896       do with frame d-store
     1897       :
     1898         hide v-diasize-resize-button .
     1899         assign
     1900           v-diasize-resize-button :row    = 1
     1901           v-diasize-resize-button :column = 1
     1902         .
     1903       end.
     1904       if p-change-value > 0
     1905       then do:
     1906         if frame d-store :scrollable = true
     1907         then do:
     1908           assign
     1909             frame d-store :virtual-height = frame d-store :virtual-height + p-change-value
     1910             no-error .
     1911           if error-status :error
     1912           or error-status :get-message(1) <> ""
     1913           then do:
     1914             undo move_block, retry move_block .
     1915           end.
     1916         end.
     1917         assign
     1918           frame d-store :height = frame d-store :height + p-change-value
     1919           no-error .
     1920         if error-status :error
     1921         or error-status :get-message(1) <> ""
     1922         then do:
     1923           undo move_block, retry move_block .
     1924         end.
     1925         assign
     1926           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1927           no-error .
     1928         if error-status :error
     1929         or error-status :get-message(1) <> ""
     1930         then do:
     1931           undo move_block, retry move_block .
     1932         end.
     1933         for each buf_temp-browse-handle
     1934           where buf_temp-browse-handle.browse-type = 'height':u
     1935         on error undo move_block, retry move_block
     1936         :
     1937           assign
     1938             buf_temp-browse-handle.browse-handle :height
     1939               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1940             no-error .
     1941           if error-status :error
     1942           or error-status :get-message(1) <> ""
     1943           then do:
     1944             undo move_block, retry move_block .
     1945           end.
     1946         end.
     1947         for each buf_temp-diasize-handle
     1948         on error undo move_block, retry move_block
     1949         :
     1950           assign
     1951             v-object-handle = buf_temp-diasize-handle.handle-value
     1952           .
     1953           if v-object-handle <> v-diasize-resize-button
     1954           then do:
     1955             assign
     1956               v-object-handle :row = v-object-handle :row + p-change-value
     1957               no-error .
     1958             if error-status :error
     1959             or error-status :get-message(1) <> ""
     1960             then do:
     1961               undo move_block, retry move_block .
     1962             end.
     1963           end.
     1964         end.
     1965       end.
     1966       else do:
     1967         for each buf_temp-diasize-handle
     1968         on error undo move_block, retry move_block
     1969         :
     1970           assign
     1971             v-object-handle = buf_temp-diasize-handle.handle-value
     1972           .
     1973           if v-object-handle <> v-diasize-resize-button
     1974           then do:
     1975             assign
     1976               v-object-handle :row = v-object-handle :row + p-change-value
     1977               no-error .
     1978             if error-status :error
     1979             or error-status :get-message(1) <> ""
     1980             then do:
     1981               undo move_block, retry move_block .
     1982             end.
     1983           end.
     1984         end.
     1985         assign
     1986           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1987           no-error .
     1988         if error-status :error
     1989         or error-status :get-message(1) <> ""
     1990         then do:
     1991           undo move_block, retry move_block .
     1992         end.
     1993         for each buf_temp-browse-handle
     1994           where buf_temp-browse-handle.browse-type = 'height':u
     1995         on error undo move_block, retry move_block
     1996         :
     1997           assign
     1998             buf_temp-browse-handle.browse-handle :height
     1999               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2000             no-error .
     2001           if error-status :error
     2002           or error-status :get-message(1) <> ""
     2003           then do:
     2004             undo move_block, retry move_block .
     2005           end.
     2006         end.
     2007         assign
     2008           frame d-store :height = frame d-store :height + p-change-value
     2009           no-error .
     2010         if error-status :error
     2011         or error-status :get-message(1) <> ""
     2012         then do:
     2013           undo move_block, retry move_block .
     2014         end.
     2015         if frame d-store :scrollable = true
     2016         then do:
     2017           assign
     2018             frame d-store :virtual-height = frame d-store :virtual-height + p-change-value
     2019             no-error .
     2020           if error-status :error
     2021           or error-status :get-message(1) <> ""
     2022           then do:
     2023             undo move_block, retry move_block .
     2024           end.
     2025         end.
     2026       end.
     2027       if p-move-resize = true
     2028       then do:
     2029         run diasize_position-resize-button in this-procedure .
     2030       end.
     2031       if v-diasize-wndstore = true
     2032       then do:
     2033         if connected("ub") = true
     2034         then do:
     2035           define variable v-cntxt-db-num        as integer   no-undo .
     2036           define variable v-cntxt-userid        as character no-undo .
     2037           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2038                                             , OUTPUT v-cntxt-userid
     2039                                             ) .
     2040           run gbl/wndsizew.p
     2041             (input  v-cntxt-db-num
     2042             ,input  v-cntxt-userid
     2043             ,input  v-diasize-proc-name
     2044             ,input  'height':u
     2045             ,input  string(frame d-store :height - v-diasize-orig-frame-height)
     2046             ) .
     2047         end.
     2048       end.
     2049     end.
     2050     assign
     2051       v-diasize-change-size = false
     2052     .
     2053   end procedure.
     2054   procedure diasize_set-height :
     2055     define input  parameter p-new-height  as decimal   no-undo .
     2056     define input  parameter p-move-resize as logical   no-undo .
     2057     do
     2058     on error undo, return error return-value
     2059     :
     2060       run diasize_change-height in this-procedure
     2061         (input  (p-new-height - frame d-store :height)
     2062         ,input  p-move-resize
     2063         ) .
     2064     end.
     2065   end procedure.
     2066   procedure diasize_change-width :
     2067     define input  parameter p-change-value as decimal   no-undo .
     2068     define input  parameter p-move-resize  as logical   no-undo .
     2069     define variable v-field-group-handle   as handle    no-undo .
     2070     define variable v-object-handle        as handle    no-undo .
     2071     define variable v-frame-width          as decimal   no-undo .
     2072     define variable v-frame-virtual-width  as decimal   no-undo .
     2073     define variable v-browse-width         as decimal   no-undo .
     2074     define variable v-window-width         as decimal   no-undo .
     2075     define variable v-window-virtual-width as decimal   no-undo .
     2076     define variable v-change-sign          as integer   no-undo .
     2077     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2078     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2079     if p-change-value > 0
     2080     then do:
     2081       if frame d-store :width + p-change-value >
     2082           session :width-chars
     2083       then do:
     2084         assign
     2085           p-change-value = session :width-chars - frame d-store :width
     2086         .
     2087         if p-change-value <= 0
     2088         then do:
     2089           run diasize_position-resize-button in this-procedure .
     2090           return .
     2091         end.
     2092       end.
     2093     end.
     2094     if p-change-value < 0
     2095     then do:
     2096       if frame d-store :width + p-change-value < v-diasize-orig-frame-width
     2097       then do:
     2098         assign
     2099           p-change-value = v-diasize-orig-frame-width
     2100                          - frame d-store :width
     2101         .
     2102         if p-change-value >= 0
     2103         then do:
     2104           run diasize_position-resize-button in this-procedure .
     2105           return .
     2106         end.
     2107       end.
     2108     end.
     2109     if p-change-value >= 0
     2110     then do:
     2111       assign
     2112         v-change-sign = 1
     2113       .
     2114     end.
     2115     else do:
     2116       assign
     2117         v-change-sign = -1
     2118       .
     2119     end.
     2120     assign
     2121       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2122     .
     2123     if p-change-value = 0
     2124     then do:
     2125       run diasize_position-resize-button in this-procedure .
     2126       return .
     2127     end.
     2128     move_block:
     2129     do
     2130     on error undo move_block, leave move_block
     2131     :
     2132       if retry
     2133       then do:
     2134         do
     2135         on error undo move_block, leave move_block
     2136         :
     2137           if p-change-value > 0
     2138           then do:
     2139             for each buf_temp-diasize-handle
     2140             on error undo, next
     2141             :
     2142               assign
     2143                 v-object-handle = buf_temp-diasize-handle.handle-value
     2144               .
     2145               if v-object-handle <> v-diasize-resize-button
     2146               then do:
     2147                 assign
     2148                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2149                 .
     2150               end.
     2151             end.
     2152             assign
     2153               v-diasize-browse-handle :width = v-browse-width
     2154             .
     2155             for each buf_temp-browse-handle
     2156               where buf_temp-browse-handle.browse-type = 'width':u
     2157             on error undo, next
     2158             :
     2159               assign
     2160                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2161               .
     2162             end.
     2163             assign
     2164               frame d-store :width = v-frame-width
     2165             .
     2166             if frame d-store :scrollable = true
     2167             then do:
     2168               assign
     2169                 frame d-store :virtual-width = v-frame-virtual-width
     2170               .
     2171             end.
     2172             run diasize_position-resize-button in this-procedure .
     2173           end.
     2174           else do:
     2175             if frame d-store :scrollable = true
     2176             then do:
     2177               assign
     2178                 frame d-store :virtual-width = v-frame-virtual-width
     2179               .
     2180             end.
     2181             assign
     2182               frame d-store :width = v-frame-width
     2183             .
     2184             for each buf_temp-browse-handle
     2185               where buf_temp-browse-handle.browse-type = 'width':u
     2186             on error undo, next
     2187             :
     2188               assign
     2189                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2190               .
     2191             end.
     2192             assign
     2193               v-diasize-browse-handle :width = v-browse-width
     2194             .
     2195             for each buf_temp-diasize-handle
     2196             on error undo, next
     2197             :
     2198               assign
     2199                 v-object-handle = buf_temp-diasize-handle.handle-value
     2200               .
     2201               if v-object-handle <> v-diasize-resize-button
     2202               then do:
     2203                 assign
     2204                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2205                 .
     2206               end.
     2207             end.
     2208             run diasize_position-resize-button in this-procedure .
     2209           end.
     2210           assign
     2211             v-diasize-change-size = false
     2212           .
     2213           leave move_block .
     2214         end.
     2215       end.
     2216       assign
     2217         v-diasize-need-full-display = true
     2218       .
     2219       if v-diasize-change-size = false
     2220       then do:
     2221         assign
     2222           v-diasize-change-size = true
     2223         .
     2224       end.
     2225       else do:
     2226         return .
     2227       end.
     2228       assign
     2229         v-frame-width = frame d-store :width
     2230         v-frame-virtual-width = frame d-store :virtual-width
     2231         v-browse-width = v-diasize-browse-handle :width
     2232       .
     2233       for each buf_temp-browse-handle
     2234         where buf_temp-browse-handle.browse-type = 'width':u
     2235       :
     2236         assign
     2237           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2238         .
     2239       end.
     2240       for each buf_temp-diasize-handle
     2241       :
     2242         delete buf_temp-diasize-handle .
     2243       end.
     2244       assign
     2245         v-field-group-handle = frame d-store :first-child
     2246       .
     2247       do while valid-handle(v-field-group-handle)
     2248       :
     2249         assign
     2250           v-object-handle = v-field-group-handle :first-child
     2251         .
     2252         do while valid-handle(v-object-handle)
     2253         :
     2254           if  v-object-handle <> v-diasize-browse-handle :handle
     2255           and v-object-handle <> v-diasize-resize-button
     2256           and can-query(v-object-handle, "row")
     2257           and can-query(v-object-handle, "height")
     2258           and ( v-object-handle :col + v-object-handle :width
     2259                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2260               )
     2261           then do:
     2262             find first buf_temp-browse-handle
     2263               where buf_temp-browse-handle.browse-type   = 'width':u
     2264                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2265               no-error .
     2266             if available buf_temp-browse-handle
     2267             then do:
     2268             end.
     2269             else do:
     2270               create buf_temp-diasize-handle .
     2271               assign
     2272                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2273                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2274               .
     2275             end.
     2276           end.
     2277           assign
     2278             v-object-handle = v-object-handle :next-sibling
     2279           .
     2280         end.
     2281         assign
     2282           v-field-group-handle = v-field-group-handle :next-sibling
     2283         .
     2284       end.
     2285       do with frame d-store
     2286       :
     2287         hide v-diasize-resize-button .
     2288         v-diasize-resize-button :row = 1.
     2289         v-diasize-resize-button :column = 1.
     2290       end.
     2291       if p-change-value > 0
     2292       then do:
     2293         if frame d-store :scrollable = true
     2294         then do:
     2295           assign
     2296             frame d-store :virtual-width = frame d-store :virtual-width + p-change-value
     2297             no-error .
     2298           if error-status :error
     2299           or error-status :get-message(1) <> ""
     2300           then do:
     2301             undo move_block, retry move_block.
     2302           end.
     2303         end.
     2304         assign
     2305           frame d-store :width = v-frame-width + p-change-value
     2306           no-error .
     2307         if error-status :error
     2308         or error-status :get-message(1) <> ""
     2309         then do:
     2310           undo move_block, retry move_block.
     2311         end.
     2312         assign
     2313           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2314         no-error .
     2315         if error-status :error
     2316         or error-status :get-message(1) <> ""
     2317         then do:
     2318           undo move_block, retry move_block.
     2319         end.
     2320         for each buf_temp-browse-handle
     2321           where buf_temp-browse-handle.browse-type = 'width':u
     2322         on error undo move_block, retry move_block
     2323         :
     2324           assign
     2325             buf_temp-browse-handle.browse-handle :width
     2326               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2327             no-error .
     2328           if error-status :error
     2329           or error-status :get-message(1) <> ""
     2330           then do:
     2331             undo move_block, retry move_block .
     2332           end.
     2333         end.
     2334         for each buf_temp-diasize-handle
     2335         on error undo move_block, retry move_block
     2336         :
     2337           assign
     2338             v-object-handle = buf_temp-diasize-handle.handle-value
     2339           .
     2340           if v-object-handle <> v-diasize-resize-button
     2341           then do:
     2342             assign
     2343               v-object-handle :col = v-object-handle :col + p-change-value
     2344               no-error .
     2345             if error-status :error
     2346             or error-status :get-message(1) <> ""
     2347             then do:
     2348               undo move_block, retry move_block .
     2349             end.
     2350           end.
     2351         end.
     2352       end.
     2353       else do:
     2354         for each buf_temp-diasize-handle
     2355         on error undo move_block, retry move_block
     2356         :
     2357           assign
     2358             v-object-handle = buf_temp-diasize-handle.handle-value
     2359           .
     2360           if v-object-handle <> v-diasize-resize-button
     2361           then do:
     2362             assign
     2363               v-object-handle :col = v-object-handle :col + p-change-value
     2364               no-error .
     2365             if error-status :error
     2366             or error-status :get-message(1) <> ""
     2367             then do:
     2368               undo move_block, retry move_block .
     2369             end.
     2370           end.
     2371         end.
     2372         for each buf_temp-browse-handle
     2373           where buf_temp-browse-handle.browse-type = 'width':u
     2374         on error undo move_block, retry move_block
     2375         :
     2376           assign
     2377             buf_temp-browse-handle.browse-handle :width
     2378               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2379             no-error .
     2380           if error-status :error
     2381           or error-status :get-message(1) <> ""
     2382           then do:
     2383             undo move_block, retry move_block .
     2384           end.
     2385         end.
     2386         assign
     2387           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2388           no-error .
     2389         if error-status :error
     2390         or error-status :get-message(1) <> ""
     2391         then do:
     2392           undo move_block, retry move_block.
     2393         end.
     2394         assign
     2395           frame d-store :width = frame d-store :width + p-change-value
     2396         no-error .
     2397         if error-status :error
     2398         or error-status :get-message(1) <> ""
     2399         then do:
     2400           undo move_block, retry move_block.
     2401         end.
     2402         if frame d-store :scrollable = true
     2403         then do:
     2404           assign
     2405             frame d-store :virtual-width = frame d-store :virtual-width + p-change-value
     2406           no-error .
     2407           if error-status :error
     2408           or error-status :get-message(1) <> ""
     2409           then do:
     2410             undo move_block, retry move_block.
     2411           end.
     2412         end.
     2413       end.
     2414       if p-move-resize
     2415       then do:
     2416         run diasize_position-resize-button in this-procedure .
     2417       end.
     2418       if v-diasize-wndstore = true
     2419       then do:
     2420         if connected("ub") = true
     2421         then do:
     2422           define variable v-cntxt-db-num        as integer   no-undo .
     2423           define variable v-cntxt-userid        as character no-undo .
     2424           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2425                                             , OUTPUT v-cntxt-userid
     2426                                             ) .
     2427           run gbl/wndsizew.p
     2428             (input  v-cntxt-db-num
     2429             ,input  v-cntxt-userid
     2430             ,input  v-diasize-proc-name
     2431             ,input  'width':u
     2432             ,input  string(frame d-store :width - v-diasize-orig-frame-width)
     2433             ) .
     2434         end.
     2435       end.
     2436     end.
     2437     assign
     2438       v-diasize-change-size = false
     2439     .
     2440   end procedure.
     2441   procedure diasize_set-width :
     2442     define input  parameter p-new-width  as decimal   no-undo .
     2443     define input  parameter p-move-resize as logical   no-undo .
     2444     do
     2445     on error undo, return error return-value
     2446     :
     2447       run diasize_change-width in this-procedure
     2448         (input  (p-new-width - frame d-store :width)
     2449         ,input  p-move-resize
     2450         ) .
     2451     end.
     2452   end procedure.
     2453   procedure diasize_position-resize-button :
     2454     do with frame d-store
     2455     :
     2456       hide v-diasize-resize-button .
     2457       assign
     2458         v-diasize-resize-button :row = frame d-store :height - v-diasize-resize-button :height
     2459                     - 1
     2460                     - (frame d-store :border-bottom-pixels / session :pixels-per-row)
     2461         v-diasize-resize-button :col = frame d-store :width - v-diasize-resize-button :width
     2462                     - 1
     2463                     - (frame d-store :border-right-pixels / session :pixels-per-column)
     2464       .
     2465       view v-diasize-resize-button .
     2466     end.
     2467   end procedure.
     2468   on alt-right anywhere
     2469   do:
     2470     run diasize_change-width in this-procedure
     2471       (input 1
     2472       ,input true
     2473       ) .
     2474     return no-apply .
     2475   end.
     2476   on alt-left anywhere
     2477   do:
     2478     run diasize_change-width in this-procedure
     2479       (input -1
     2480       ,input true
     2481       ) .
     2482     return no-apply .
     2483   end.
     2484   on alt-down anywhere
     2485   do:
     2486     run diasize_change-height in this-procedure
     2487       (input 1
     2488       ,input true
     2489       ) .
     2490     return no-apply .
     2491   end.
     2492   on alt-up anywhere
     2493   do:
     2494     run diasize_change-height in this-procedure
     2495       (input -1
     2496       ,input true
     2497       ) .
     2498     return no-apply .
     2499   end.
     2500   on alt-enter of frame d-store
     2501   do:
     2502     run diasize_maximize in this-procedure
     2503       (input  ?
     2504       ).
     2505     return no-apply .
     2506   end.
     2507   procedure diasize_end-move :
     2508     do
     2509     on error undo, return error return-value
     2510     :
     2511       define variable v-row-delta as decimal   no-undo .
     2512       define variable v-col-delta as decimal   no-undo .
     2513       define variable v-new-row as decimal   no-undo .
     2514       define variable v-new-col as decimal   no-undo .
     2515       assign
     2516         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2517         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2518       .
     2519       assign
     2520         v-row-delta = v-new-row - frame d-store :height
     2521         v-col-delta = v-new-col - frame d-store :width
     2522       .
     2523       run diasize_change-height in this-procedure
     2524         (input v-row-delta
     2525         ,input true
     2526         ) .
     2527       run diasize_change-width in this-procedure
     2528         (input v-col-delta
     2529         ,input true
     2530         ) .
     2531     end.
     2532   end procedure.
     2533   procedure diasize_maximize :
     2534     define input  parameter p-action as logical   no-undo .
     2535     do
     2536     on error undo, return error return-value
     2537     :
     2538       if p-action = ?
     2539       then do:
     2540         if v-diasize-need-maximize = true
     2541         then do:
     2542           assign
     2543             p-action = true
     2544           .
     2545         end.
     2546         else do:
     2547           assign
     2548             p-action = false
     2549           .
     2550         end.
     2551       end.
     2552       if p-action = true
     2553       then do:
     2554         run diasize_change-height in this-procedure
     2555           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2556               - frame d-store :height-chars
     2557           ,input true
     2558           ) .
     2559         run diasize_change-width in this-procedure
     2560           (input session :width-chars
     2561               - frame d-store :width-chars
     2562           ,input true
     2563           ) .
     2564         assign
     2565           v-diasize-need-maximize = false
     2566         .
     2567       end.
     2568       else do:
     2569         run diasize_change-width in this-procedure
     2570           (input v-diasize-orig-frame-width
     2571               - frame d-store :width-chars
     2572           ,input true
     2573           ) .
     2574         run diasize_change-height in this-procedure
     2575           (input v-diasize-orig-frame-height
     2576               - frame d-store :height-chars
     2577           ,input true
     2578           ) .
     2579         assign
     2580           v-diasize-need-maximize = true
     2581         .
     2582       end.
     2583     end.
     2584   end procedure.
     2585   procedure diasize_restore-orig-size :
     2586     do
     2587     on error undo, return error return-value
     2588     :
     2589       assign
     2590         v-diasize-current-frame-width  = frame d-store :width
     2591         v-diasize-current-frame-height = frame d-store :height
     2592       .
     2593       run diasize_set-height in this-procedure
     2594         (input  v-diasize-orig-frame-height
     2595         ,input  true
     2596         ) .
     2597       run diasize_set-width in this-procedure
     2598         (input  v-diasize-orig-frame-width
     2599         ,input  true
     2600         ) .
     2601     end.
     2602   end procedure.
     2603   procedure diasize_restore-current-size :
     2604     do
     2605     on error undo, return error return-value
     2606     :
     2607       run diasize_set-height in this-procedure
     2608         (input  v-diasize-current-frame-height
     2609         ,input  true
     2610         ) .
     2611       run diasize_set-width in this-procedure
     2612         (input  v-diasize-current-frame-width
     2613         ,input  true
     2614         ) .
     2615     end.
     2616   end procedure.
     2617   procedure diasize_set-browse-handle :
     2618     define input  parameter p-browse-handle as handle   no-undo .
     2619     define buffer buf_temp-browse-handle for temp-browse-handle .
     2620     do
     2621     on error undo, return error return-value
     2622     :
     2623       assign
     2624         v-diasize-browse-handle = p-browse-handle
     2625       .
     2626       for each buf_temp-browse-handle
     2627       on error undo, return error return-value
     2628       :
     2629         delete buf_temp-browse-handle .
     2630       end.
     2631     end.
     2632   end procedure.
     2633   procedure diasize_add_browse :
     2634     define input  parameter p-browse-type   as character no-undo .
     2635     define input  parameter p-browse-handle as handle    no-undo .
     2636     define buffer buf_temp-browse-handle for temp-browse-handle .
     2637     do
     2638     on error undo, return error return-value
     2639     :
     2640       assign
     2641         v-diasize-browse-number = v-diasize-browse-number + 1
     2642       .
     2643       create buf_temp-browse-handle .
     2644       assign
     2645         buf_temp-browse-handle.browse-type   = p-browse-type
     2646         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2647         buf_temp-browse-handle.browse-handle = p-browse-handle
     2648       .
     2649     end.
     2650   end procedure.
     2651   procedure diasize_init :
     2652     define variable v-default-value    as logical   no-undo .
     2653     define variable v-restore-saved    as logical   no-undo .
     2654     define variable v-resize-value-str as character no-undo .
     2655     do
     2656     on error undo, return error return-value
     2657     :
     2658       do with frame d-store
     2659       :
     2660         assign
     2661           v-diasize-orig-frame-height = frame d-store :height
     2662           v-diasize-orig-frame-width  = frame d-store :width
     2663           v-diasize-browse-handle     = browse br-stores :handle
     2664         .
     2665         create button v-diasize-resize-button
     2666         assign
     2667           parent        = frame d-store :first-child
     2668           label         = "s"
     2669           height-pixels = 16
     2670           width-pixels  = 16
     2671           visible       = true
     2672           sensitive     = true
     2673           movable       = true
     2674           triggers:
     2675             on end-move persistent run diasize_end-move in this-procedure .
     2676           end triggers.
     2677         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2678         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2679         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2680         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2681         assign
     2682           v-diasize-wndmax = false
     2683         .
     2684         if connected("ub") = true
     2685         then do:
     2686           define variable v-cntxt-db-num        as integer   no-undo .
     2687           define variable v-cntxt-userid        as character no-undo .
     2688           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2689                                             , OUTPUT v-cntxt-userid
     2690                                             ) .
     2691           run gbl/wndpar_r.p
     2692             (input  v-cntxt-db-num
     2693             ,input  v-cntxt-userid
     2694             ,input  'wndmax':U
     2695             ,output v-diasize-wndmax
     2696             ,output v-default-value
     2697             ) .
     2698         end.
     2699         assign
     2700           v-diasize-wndstore = false
     2701         .
     2702         if connected("ub") = true
     2703         then do:
     2704           run gbl/wndpar_r.p
     2705             (input  v-cntxt-db-num
     2706             ,input  v-cntxt-userid
     2707             ,input  'wndstore':U
     2708             ,output v-diasize-wndstore
     2709             ,output v-default-value
     2710             ) .
     2711         end.
     2712         assign
     2713           v-diasize-proc-name = entry(1, program-name(2), '.')
     2714         .
     2715         if v-diasize-wndstore = true
     2716         then do:
     2717           assign
     2718             v-restore-saved = false
     2719           .
     2720           if connected("ub") = true
     2721           then do:
     2722             run gbl/wndsizer.p
     2723               (input  v-cntxt-db-num
     2724               ,input  v-cntxt-userid
     2725               ,input  v-diasize-proc-name
     2726               ,input  'height':u
     2727               ,output v-resize-value-str
     2728               ) .
     2729             if v-resize-value-str <> '':U
     2730             then do:
     2731               run diasize_change-height in this-procedure
     2732                 (input  integer(v-resize-value-str)
     2733                 ,input  true
     2734                 ) .
     2735               assign
     2736                 v-restore-saved = true
     2737               .
     2738             end.
     2739           end.
     2740           if connected("ub") = true
     2741           then do:
     2742             run gbl/wndsizer.p
     2743               (input  v-cntxt-db-num
     2744               ,input  v-cntxt-userid
     2745               ,input  v-diasize-proc-name
     2746               ,input  'width':u
     2747               ,output v-resize-value-str
     2748               ) .
     2749             if v-resize-value-str <> '':U
     2750             then do:
     2751               run diasize_change-width in this-procedure
     2752                 (input  integer(v-resize-value-str)
     2753                 ,input  true
     2754                 ) .
     2755               assign
     2756                 v-restore-saved = true
     2757               .
     2758             end.
     2759           end.
     2760           if v-restore-saved <> true
     2761           then do:
     2762             if v-diasize-wndmax = true
     2763             then do:
     2764               run diasize_maximize in this-procedure
     2765                 (input  true
     2766                 ) .
     2767             end.
     2768           end.
     2769         end.
     2770         else do:
     2771           if v-diasize-wndmax = true
     2772           then do:
     2773             run diasize_maximize in this-procedure
     2774               (input  true
     2775               ) .
     2776           end.
     2777         end.
     2778       end.
     2779     end.
     2780   end procedure.
     2781   procedure diasize_need-full-display :
     2782     define output parameter p-need-full-display as logical   no-undo .
     2783     do
     2784     on error undo, return error return-value
     2785     :
     2786       assign
     2787         p-need-full-display = v-diasize-need-full-display
     2788       .
     2789       assign
     2790         v-diasize-need-full-display = false
     2791       .
     2792     end.
     2793   end procedure.
     2794   procedure get-context :
     2795      define output parameter p-db-num as integer          no-undo.
     2796      define output parameter p-user-id as character        no-undo.
     2797      define variable v-login               as character    no-undo.
     2798      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2799      define buffer buf_user-login  for ub.user-login .
     2800      do
     2801      on error undo, return error
     2802      :
     2803            FIND FIRST buf_sys-ctrl no-lock.
     2804            ASSIGN
     2805               v-login = USERID("ub")
     2806               p-db-num = buf_sys-ctrl.db-num
     2807            .
     2808            FIND FIRST buf_user-login
     2809                 WHERE buf_user-login.db-num = p-db-num
     2810                   AND buf_user-login.user-login = v-login
     2811                 no-lock
     2812                 no-error
     2813                 .
     2814            IF AVAILABLE buf_user-login
     2815            THEN DO:
     2816               assign
     2817                  p-user-id = buf_user-login.user-id
     2818               .
     2819            END.
     2820      end.
     2821   end procedure.
     2822       run diasize_init in this-procedure .
     2823   ON CHOOSE OF B-hist IN FRAME d-store
     2824   DO:
     2825     define variable v-loc-rid-list as character no-undo .
     2826        run ref/cclihist.w (
     2827                         input parparentproc
     2828                       , input 0
     2829                       , input "":U
     2830                       , input 0
     2831                       , input "":U
     2832                       , "one":U
     2833                       , input 'скл':U
     2834                       , input X_store.obj-code
     2835                       , input ?
     2836                       , input ?
     2837                       , input "":U
     2838                       , input "":U
     2839                       , input v-cntxt-db-num
     2840                       , input-output v-loc-rid-list  ) no-error .
     2841   END.
     2842   ON CHOOSE OF b-print IN FRAME d-store
     2843   DO:
     2844     run rep/stor-prt.p (input parparentproc) .
     2845   END.
     2846   ON CHOOSE OF b-sel IN FRAME d-store
     2847   DO:
     2848     define variable v-ind         as integer   no-undo .
     2849     define variable v-num-entries as integer   no-undo .
     2850     define buffer buf_store   for ub.store .
     2851     define buffer buf_clients for ub.clients .
     2852     if v-rid-list = ""
     2853     or b-mark:sensitive = no
     2854     then do:
     2855       v-rid-list = string (recid (X_store)).
     2856     end.
     2857     assign
     2858       v-num-entries = num-entries( v-rid-list )
     2859     .
     2860     do v-ind = 1 to v-num-entries
     2861     :
     2862       find first buf_store no-lock
     2863         where recid( buf_store ) = integer( entry( v-ind, v-rid-list ) )
     2864       .
     2865       find first buf_clients no-lock
     2866         where buf_clients.obj-type = 'скл':U
     2867           and buf_clients.obj-code = buf_store.obj-code
     2868         no-error
     2869       .
     2870       if available buf_clients
     2871         and buf_clients.stts <> 0
     2872       then do:
     2873         entry(v-ind, v-rid-list) = '':U.
     2874         v-rid-list  = replace(v-rid-list, chr(44) + chr(44), chr(44)).
     2875         message substitute( "Склад &1 удален и не может быть выбран.", buf_store.obj-code ).
     2876         return no-apply.
     2877       end.
     2878     end.
     2879   END.
     2880   ON CHOOSE OF b-right IN FRAME d-store
     2881   DO:
     2882     if available X_store
     2883     then do:
     2884       run adm/obj-usr.w
     2885         (input  parparentproc
     2886         ,input  v-cntxt-db-num
     2887         ,input  'скл':U
     2888         ,input  X_store.obj-code
     2889         ).
     2890     end.
     2891   END.
     2892   on return, MOUSE-SELECT-DBLCLICK of br-stores in frame d-store do:
     2893     if b-sel:sensitive then
     2894       if b-mark:sensitive then apply "choose" to b-mark in frame d-store.
     2895       else apply "choose" to b-sel in frame d-store.
     2896     else if b-chg:sensitive then apply "choose" to b-chg in frame d-store.
     2897   end.
     2898   on choose of b-mark in frame d-store do:
     2899   define variable glog as logical no-undo .
     2900     if available X_clients then do:
     2901       if X_clients.stts <> 0 then do:
     2902         message
     2903         "Данный объект удален и не может быть выбран."
     2904         view-as alert-box error
     2905         .
     2906         return no-apply.
     2907       end.
     2908     end.
     2909     else return no-apply.
     2910   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2911   define variable v-str-recid15 as character no-undo .
     2912   define variable v-num-entry15 as integer   no-undo .
     2913   assign
     2914     v-str-recid15 = trim( string( recid( X_store ) , "->>>>>>>>>>>9":U ) )
     2915     v-num-entry15 = lookup( v-str-recid15 , v-rid-list )
     2916   .
     2917   if v-num-entry15 > 0 then do:
     2918     assign
     2919       entry( v-num-entry15, v-rid-list ) = "":U
     2920       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     2921     .
     2922   end.
     2923   else do:
     2924     assign
     2925       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid15
     2926     .
     2927   end.
     2928     glog = br-stores:refresh() in frame d-store.
     2929     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     2930       glog = br-stores:select-next-row ().
     2931       apply "iteration-changed" to br-stores in frame d-store.
     2932     end.
     2933     if num-entries (v-rid-list) = 0 then hide mark-num in frame d-store.
     2934     else disp num-entries (v-rid-list) @ mark-num with frame d-store.
     2935     apply "entry" to br-stores in frame d-store.
     2936   end.
     2937   ON RETURN OF sch-code IN FRAME d-store
     2938   DO:
     2939   define buffer buf_store for ub.store.
     2940   assign
     2941   sch-code.
     2942     find first buf_store no-lock where
     2943               buf_store.obj-code = sch-code no-error .
     2944     if available buf_store then do:
     2945       reposition br-stores to recid recid(buf_store) no-error .
     2946       apply "ENTRY" to br-stores.
     2947     end.
     2948   END.
     2949   ON CHOOSE OF B-grp IN FRAME d-store
     2950   DO:
     2951   define variable lns-cnt as integer no-undo .
     2952   define variable g-grp as character no-undo .
     2953   define variable v-gds-rec as recid no-undo.
     2954   define variable ri as recid no-undo .
     2955   define variable glog as logical no-undo .
     2956   define buffer buf_clients for ub.clients.
     2957   define buffer buf_cli-grp for ub.cli-grp.
     2958   define buffer buf_store for ub.store.
     2959   if not available X_clients then return no-apply.
     2960   ri = recid(X_store).
     2961   glog = yes.
     2962   message
     2963   "Выберите группу, в которую нужно" skip
     2964   "переместить склад(-ы)."
     2965   view-as alert-box question buttons OK-Cancel update glog.
     2966   if not glog then   do:
     2967     apply "entry" to br-stores in frame d-store.
     2968     return no-apply.
     2969   end.
     2970   g-grp = "".
     2971   run ref/cli-grps.w (
     2972                      input parparentproc
     2973                    , input 'терм':U + ",b-sel"
     2974                    , input-output g-grp ) .
     2975   if g-grp = "" then  do:
     2976     apply "ENTRY" to br-stores.
     2977     return no-apply.
     2978   end.
     2979   else do transaction:
     2980       FIND buf_cli-grp where recid( buf_cli-grp ) = integer( g-grp ) .
     2981       if v-rid-list = "" then
     2982       v-rid-list = string( recid( X_store ) ) .
     2983       lns-cnt = 1.
     2984       DO WHILE lns-cnt <= num-entries( v-rid-list ) :
     2985         v-gds-rec = integer( entry( lns-cnt, v-rid-list ) ) .
     2986         if lns-cnt = 1 then ri = v-gds-rec.
     2987         for each buf_store share-lock where recid(buf_store) = v-gds-rec,
     2988                 first buf_clients share-lock where
     2989                     buf_clients.obj-type = 'скл':U
     2990                 and buf_clients.obj-code = buf_store.obj-code
     2991         on error  undo , next
     2992         on stop   undo , next
     2993         on endkey undo , next
     2994         :
     2995           buf_clients.grp-code = buf_cli-grp.node-code.
     2996           lns-cnt = lns-cnt + 1.
     2997         end.
     2998       end.
     2999       if lns-cnt < num-entries(v-rid-list) + 1 then do:
     3000         message
     3001         substitute("Удалось сменить групп для &1 складов", lns-cnt - 1)
     3002         view-as alert-box error.
     3003       end.
     3004       v-rid-list = "".
     3005       mark-num = 0.
     3006       hide mark-num in frame d-store.
     3007   end.
     3008   run Openbr in this-procedure .
     3009   reposition br-stores to recid ri no-error.
     3010   apply "ENTRY" to br-stores.
     3011   apply "value-changed" to br-stores.
     3012   END.
     3013   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-store:PARENT eq ?
     3014   THEN FRAME d-store:PARENT = ACTIVE-WINDOW.
     3015   ON WINDOW-CLOSE OF FRAME d-store APPLY "END-ERROR":U TO SELF.
     3016   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3017   on INS of frame d-store anywhere do:
     3018     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame d-store. END.
     3019     return no-apply.
     3020   end.
     3021   define variable vss-include-info17 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3022   on F3 of frame d-store anywhere do:
     3023     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame d-store. END.
     3024     return no-apply.
     3025   end.
     3026   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3027   on CTRL-N, CTRL-Т of frame d-store anywhere do:
     3028     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame d-store. END.
     3029     return no-apply.
     3030   end.
     3031   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3032   on F4 of frame d-store anywhere do:
     3033     if b-chg :sensitive then DO: apply "CHOOSE":U to b-chg in frame d-store. END.
     3034     return no-apply.
     3035   end.
     3036   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3037   on F8 of frame d-store anywhere do:
     3038     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame d-store. END.
     3039     return no-apply.
     3040   end.
     3041   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3042   on F2 of frame d-store anywhere do:
     3043     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame d-store. END.
     3044     return no-apply.
     3045   end.
     3046   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3047   on F2 of frame d-store anywhere do:
     3048     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame d-store. END.
     3049     return no-apply.
     3050   end.
     3051   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3052   on CTRL-P, CTRL-З of frame d-store anywhere do:
     3053     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame d-store. END.
     3054     return no-apply.
     3055   end.
     3056   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3057   on f5 of frame d-store anywhere
     3058   do:
     3059      v-doc-rec = recid(X_store).    run OpenBR in this-procedure.   REPOSITION br-stores to recid v-doc-rec No-ERROR.   apply 'value-changed' to br-stores.
     3060   end.
     3061   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3062   do:
     3063     br-stores :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     3064   end.
     3065   MAIN-BLOCK:
     3066   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3067      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3068    if lookup('s-deploy', bttns) > 0 then do:
     3069     assign
     3070     v-is-deploy = yes.
     3071    end.
     3072   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3073     run mainmenu_getcntxt in parparentproc
     3074       (output v-cntxt-db-num
     3075       ,output v-cntxt-userid
     3076       ,output v-cntxt-level
     3077       ,output v-cntxt-host-code-obj
     3078       ,output v-cntxt-obj-type
     3079       ,output v-cntxt-obj-code
     3080       ,output v-cntxt-db-num-obj
     3081       ,output v-cntxt-is-admin
     3082       ) .
     3083     v-exist-price-grp = false  .
     3084     RUN enable_UI.
     3085     WAIT-FOR GO OF FRAME d-store.
     3086   END.
     3087   RUN disable_UI.
     3088   PROCEDURE disable_UI :
     3089     HIDE FRAME d-store.
     3090   END PROCEDURE.
     3091   PROCEDURE enable_UI :
     3092   v-grp:VISIBLE IN BROWSe br-stores = v-exist-price-grp.
     3093   assign
     3094   B-attr:POPUP-MENU IN FRAME d-store       = MENU MENU-B-attr:HANDLE
     3095   b-attr:MENU-MOUSE in frame d-store = 1
     3096   B-cli-attr:POPUP-MENU IN FRAME d-store       = MENU MENU-B-cli-attr:HANDLE
     3097   b-cli-attr:MENU-MOUSE in frame d-store = 1
     3098   X_clients.obj-name:resizable  in browse br-stores = true
     3099   X_cli-host.obj-name:resizable in browse br-stores = true
     3100   X_clients.grp-name:resizable  in browse br-stores = true
     3101   v-grp:resizable  in browse br-stores = true
     3102   .
     3103   v-rid-list = p-rid-list.
     3104   hide mark-num in frame d-store.
     3105   ENABLE
     3106   br-stores
     3107   b-quit
     3108   b-lkp
     3109   b-print when not v-is-deploy
     3110   b-right
     3111   b-help
     3112   b-price
     3113   b-add WHEN v-cntxt-db-num = 0 and can-do (bttns, "b-add")
     3114   b-chg WHEN v-cntxt-db-num = 0  and can-do (bttns, "b-add")
     3115   b-del WHEN v-cntxt-db-num = 0  and can-do (bttns, "b-add")
     3116   b-grp WHEN v-cntxt-db-num = 0  and can-do (bttns, "b-add")
     3117   b-mark when can-do (bttns, "b-mark")
     3118   b-sel when can-do (bttns, "b-sel")
     3119   b-hist when not v-is-deploy
     3120   b-attr when not v-is-deploy
     3121   b-cli-attr when not v-is-deploy
     3122   sch-code
     3123   WITH FRAME d-store.
     3124   run openbr in this-procedure .
     3125   if v-rid-list <> '':U then do:
     3126     reposition br-stores to recid(integer(entry(1, v-rid-list))) no-error.
     3127   end.
     3128   apply "ENTRY" to br-stores.
     3129   apply "VALUE-CHANGED" to br-stores.
     3130   END PROCEDURE.
     3131   procedure Openbr :
     3132   if p-only-cur-db-num  = yes then do:
     3133     OPEN QUERY br-stores
     3134     FOR EACH X_store NO-LOCK,
     3135     EACH X_clients WHERE
     3136          X_clients.obj-code = X_store.obj-code
     3137      and X_clients.obj-type = 'скл':U
     3138      and X_clients.db-num   = v-cntxt-db-num NO-LOCK,
     3139      each X_cli-host where
     3140           X_cli-host.obj-code = X_store.host-code
     3141      and X_cli-host.obj-type = 'орг':U no-lock BY X_store.obj-code.
     3142   end.
     3143   else do:
     3144     OPEN QUERY br-stores
     3145     FOR EACH X_store NO-LOCK,
     3146     EACH X_clients WHERE
     3147          X_clients.obj-code = X_store.obj-code
     3148      and X_clients.obj-type = 'скл':U NO-LOCK,
     3149      each X_cli-host where
     3150           X_cli-host.obj-code = X_store.host-code
     3151      and X_cli-host.obj-type = 'орг':U no-lock BY X_store.obj-code.
     3152   end.
     3153   end procedure.
