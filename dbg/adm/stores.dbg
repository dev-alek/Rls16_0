      441   define buffer buf_clients for ub.clients.
      442   define buffer buf_sysconf for ub.sysconf.
      443   define buffer buf_shop for ub.shop.
      444   define buffer buf_store for ub.store.
      445   define buffer buf_db for ub.db.
      446   do
      447   on error undo, return error
      448   :
      449   assign
      450   vattr-codes = "":U
      451   vattr-labels = "":U
      452   .
      453   _II:
      454   DO ii = 1 to num-entries('autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U):
      455     run thbjattr_code (
      456                          input entry(ii, 'autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U)
      457                         ,input   '':U
      458                         ,output  attr-label
      459                         ,output  attr-user-can-edit
      460                         ,output  attr-output-display
      461                         ,output  attr-other
      462                         ,output v-prop-list
      463                         ,output v-prop-type-list
      464                         ,output v-prop-label-list
      465                         ,output v-global
      466                         ,output v-host
      467                         ,output v-shop
      468                         ,output v-store
      469                         ,output v-db
      470                       ) no-error.
      471       .
      472       if NOT error-status:error
      473       and attr-user-can-edit
      474       and index(attr-other, "spr-ext=") > 0
      475       anD (if p-obj-type = 'маг':U
      476            then v-shop
      477            else (if p-obj-type = 'скл':U
      478                  then v-store
      479                  else (if p-obj-type = 'орг':U
      480                        then v-host
      481                        else (if p-obj-type = 'БД':U
      482                             then v-db
      483                             else v-global)
      484                       )
      485                  )
      486            ) then do:
      487         if entry(ii, 'autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U) = 'alias-tpsi':U then do:
      488   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      489     (input  'tpsi'
      490     ,input  0
      491     ,input  ''
      492     ,input  0
      493     ,input  ''
      494     ,input  ''
      495     ,input  ''
      496     ,input  no
      497     ,output conf-par
      498     ,output par-type
      499     ) no-error .
      500           if error-status:error
      501           or (conf-par <> "yes") then next _ii.
      502         end.
      503         assign
      504         vattr-codes = vattr-codes + chr(44) + entry(ii, 'autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U)
      505         vattr-labels = vattr-labels + chr(44) + attr-label
      506         .
      507       end.
      508   end.
      509   CASE p-mode:
      510     when 'ПРОСМОТР':U then do:
      511       assign
      512       v-title = "Выберите типы параметров для просмотра".
      513     end.
      514     when 'ИЗМЕНЕНИЕ':U then do:
      515       assign
      516       v-title = "Выберите типы параметров для редактирования".
      517     end.
      518     when  'КОПИРОВАНИЕ':U then do:
      519       assign
      520       v-title = "Выберите типы параметров для копирования".
      521     end.
      522   END CASE.
      523   run gbl/d-list.w (
      524                  INPUT (if p-mode = 'КОПИРОВАНИЕ':U then "b-sel,b-mark":U else "b-sel":U)
      525                 ,INPUT v-title
      526                 ,INPUT vattr-codes
      527                 ,INPUT vattr-labels
      528                 ,INPUT chr(44)
      529                 ,INPUT "":U
      530                 ,output v-attr-code).
      531   IF v-attr-code = "":u THEN do:
      532     RETURN ''.
      533   end.
      534   if p-mode = 'ПРОСМОТР':U
      535   or p-mode = 'ИЗМЕНЕНИЕ':U then do:
      536     run thbjattr_code  in this-procedure (
      537          input   v-attr-code
      538         ,input   '':U
      539         ,output  attr-label
      540         ,output  attr-user-can-edit
      541         ,output  attr-output-display
      542         ,output  attr-other
      543         ,output v-prop-list
      544         ,output v-prop-type-list
      545         ,output v-prop-label-list
      546         ,output v-global
      547         ,output v-host
      548         ,output v-shop
      549         ,output v-store
      550         ,output v-db
      551     ).
      552     do ii = 1 to num-entries(attr-other, chr(47)):
      553       if entry(ii, attr-other, chr(47)) begins "spr-ext=":U then do:
      554         assign
      555         v-spr = entry(2, entry(ii, attr-other, chr(47)), "=").
      556       end.
      557     end.
      558     run value(v-spr) (
      559                      input parparentproc
      560                     ,input p-mode
      561                     ,input p-obj-type
      562                     ,input p-obj-code
      563                     ).
      564   end.
      565   else do:
      566      if p-obj-type = 'маг':U then do:
      567       message
      568       "Выберите магазин для копирования ПАРАМЕТРОВ"
      569       view-as alert-box WARNING.
      570         run adm/shops.w ( input parparentproc
      571                          ,input "b-sel"
      572                          ,input-output v-rid-list
      573                          ,no ).
      574        if v-rid-list = "":U then return.
      575        find first buf_shop no-lock where
      576                 recid(buf_shop) = integer(v-rid-list) .
      577        v-from-obj-code = buf_shop.obj-code.
      578      end.
      579      if p-obj-type = 'орг':U then do:
      580         message
      581         "Выберите ФИРМУ для копирования ПАРАМЕТРОВ"
      582         view-as alert-box WARNING.
      583         run adm/sconfs.w (
      584               input parParentProc
      585             , input "b-sel":U
      586             , input no
      587             , input 0
      588             , output v-firm-code
      589             , input-output v-rid-list
      590         ) no-error.
      591         if v-rid-list = "":U then return.
      592       find first buf_sysconf no-lock
      593                         where recid(buf_sysconf) = integer(entry(1, v-rid-list)).
      594       v-from-obj-code = buf_sysconf.host-code.
      595      end.
      596      if p-obj-type = 'скл':U then do:
      597       message
      598       "Выберите склад для копирования ПАРАМЕТРОВ"
      599       view-as alert-box WARNING.
      600         run adm/stores.w ( input parparentproc
      601                           ,input "b-sel"
      602                           ,input-output v-rid-list
      603                           ,input no ).
      604        if v-rid-list = "":U then return.
      605        find first buf_store no-lock where
      606                 recid(buf_store) = integer(v-rid-list) .
      607        v-from-obj-code = buf_store.obj-code.
      608      end.
      609      if p-obj-type = 'БД':U then do:
      610         message
      611         "Выберите БД для копирования ПАРАМЕТРОВ"
      612         view-as alert-box WARNING.
      613         run adm/dbs.w (
      614               input parParentProc
      615             , input 'ПРОСМОТР':U
      616             , output v-rec
      617         ) no-error.
      618         if v-rec = ? then return.
      619       find first buf_db no-lock
      620                         where recid(buf_db) = v-rec.
      621       v-from-obj-code = buf_db.db-num.
      622      end.
      623      if (p-obj-type = 'маг':U
      624      AND p-obj-code = buf_shop.obj-code )
      625      or (p-obj-type = 'скл':U
      626      AND p-obj-code = buf_store.obj-code )
      627      or (p-obj-type = 'орг':U
      628      AND p-obj-code = buf_sysconf.host-code )
      629      or (p-obj-type = 'БД':U
      630      AND p-obj-code = buf_db.db-num )
      631      or (p-obj-type = '':U
      632      AND p-obj-code = 0 )
      633      then do:
      634        message "Нельзя копировать ПАРАМЕТРЫ самих в себя"
      635        view-as alert-box error .
      636        return error .
      637      end.
      638      run waitfram-show in this-procedure ( input "Ждите..." ).
      639      DO ii = 1 to num-entries(v-attr-code):
      640         for each thbjattr_thbj-attr:
      641           delete thbjattr_thbj-attr.
      642         end.
      643         assign
      644         v-ii = v-ii + 1.
      645         run thbjattr_get-section  in this-procedure (
      646              input  p-obj-type
      647             ,input  v-from-obj-code
      648             ,input  entry(ii, v-attr-code)
      649             ,input '':U
      650             ,input-output table thbjattr_thbj-attr
      651             ,output v-found
      652                                                 ) no-error .
      653         if not error-status:error then do:
      654           run thbjattr_set-section in this-procedure (
      655                                                  input p-obj-type
      656                                                 ,input p-obj-code
      657                                                 ,input entry(ii, v-attr-code)
      658                                                 ,input table thbjattr_thbj-attr ) no-error .
      659           if not error-status:error then
      660           assign
      661           v-ok = v-ok + 1
      662           .
      663         end.
      664      end.
      665      run waitfram-hide in this-procedure .
      666      if v-ii = v-ok then do:
      667         message
      668         substitute("Скопировано &1 параметров с &4&5 на &2&3"
      669                    , v-ok
      670                    , p-obj-type
      671                    , p-obj-code
      672                    , p-obj-type
      673                    , v-from-obj-code
      674                    )
      675         view-as alert-box .
      676      end.
      677      else do:
      678         message
      679         substitute("Из &1 параметров удалось скопировать &2 параметров с &3&4 на &5&6"
      680                    , v-ii
      681                    , v-ok
      682                    , p-obj-type
      683                    , p-obj-code
      684                    , p-obj-type
      685                    , v-from-obj-code
      686                    )
      687         view-as alert-box WARNING.
      688      end.
      689   end.
      690   end.
      691   end procedure.
      692   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      693   define variable v-waitfram-action01         as character   no-undo .
      694   define variable v-waitfram-action02         as character   no-undo .
      695   define variable v-waitfram-action03         as character   no-undo .
      696   define variable mWaitFramTextBeg            as character   no-undo.
      697   define variable mWaitFramTextEnd            as character   no-undo.
      698   define variable mWaitFramView               as logical     no-undo.
      699   define variable mWaitProcEvent              as logical     no-undo init yes.
      700   define variable mWaitFramInterval           as integer     no-undo init 1 .
      701   define variable mWaitFramStop               as logical     no-undo.
      702   define variable mWaitFramStopUser           as logical     no-undo.
      703   define variable mWaitFramStopTimeOut        as logical     no-undo.
      704   define variable mWaitFramStartProc          as datetime-tz no-undo.
      705   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      706   define button B-WaitFramStop auto-end-key
      707        label "Стоп"
      708        size 10 by 1 tooltip "Остоновить процесс".
      709   define button B-viewProcInfo
      710        label "Информация"
      711        size 15 by 1 tooltip "Информация о процесс".
      712   define frame waitfram
      713     v-waitfram-action01 format "x(72)" no-label skip
      714     v-waitfram-action02 format "x(72)" no-label skip
      715     v-waitfram-action03 format "x(72)" no-label skip
      716     B-viewProcInfo
      717     B-WaitFramStop at row 4 col 30
      718     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      719     .
      720   define new global shared variable mBatchMode as logical no-undo init ?.
      721   define variable mFramBachModHandle as handle no-undo.
      722   mFramBachModHandle = frame waitfram:handle.
      723   define variable mFameOldVis as logical no-undo.
      724   define variable mVisCUrentVin as logical no-undo.
      725   if session:batch-mode
      726   then
      727      mBatchMode = yes.
      728   if mBatchMode = ? then do:
      729     mVisCUrentVin = current-window:visible.
      730     mFameOldVis = mFramBachModHandle:visible.
      731     mFramBachModHandle:visible  = yes.
      732     mBatchMode = mFramBachModHandle:visible ne yes.
      733     mFramBachModHandle:visible = mFameOldVis.
      734     current-window:visible = mVisCUrentVin.
      735   end.
      736    if  log-manager:logfile-name ne ?
      737     then DO:
      738         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      739         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      740         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      741     end.
      742   on choose of B-WaitFramStop in frame waitfram
      743   do:
      744     mWaitFramStop = yes.
      745     mWaitFramStopUser = yes.
      746   end.
      747   function waitfram-check-timeout returns logical():
      748      define variable vtime as int64 no-undo.
      749      if mWaitFramStopTimeOut
      750      then
      751         return yes.
      752      vtime = ( now - mWaitFramStartProc ) / 1000 .
      753      if     mWaitFramTimeOut ne ?
      754         and mWaitFramTimeOut ne 0
      755         and mWaitFramTimeOut lt vtime
      756      then do:
      757         mWaitFramStopTimeOut = yes.
      758      end.
      759      return mWaitFramStopTimeOut.
      760   end.
      761   procedure waitfram-hide :
      762     if not session:batch-mode
      763     then do
      764     on error undo, return error return-value
      765     :
      766       pause 0 before-hide .
      767       if not mBatchMode then
      768         hide frame waitfram .
      769     if     not mWaitFramView
      770        and mWaitProcEvent
      771     then
      772       process events .
      773     end.
      774   end procedure.
      775   procedure waitfram-show :
      776     define input  parameter p-message as character no-undo .
      777     define variable v-left-margin as integer   no-undo .
      778     if not session:batch-mode
      779     then do
      780     on error undo, return error return-value
      781     :
      782       if length(p-message) <= 70 then do:
      783         assign
      784           v-left-margin = integer((70 - length(p-message)) / 2)
      785         .
      786         assign
      787           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      788         .
      789         assign
      790           v-waitfram-action01 = " "
      791           v-waitfram-action02 = " "
      792                                    + fill(" ", v-left-margin)
      793                                    + p-message
      794           v-waitfram-action03 = " "
      795         .
      796       end.
      797       else do:
      798         define variable vRindex1 as integer no-undo.
      799         define variable vRindex2 as integer no-undo.
      800         vRindex1 = r-index(p-message," ",70).
      801         if vRindex1 = 0
      802         then
      803            vRindex1 = 70.
      804         if length(p-message)  <= vRindex1 + 70 then do:
      805           assign
      806             v-waitfram-action01 = " "
      807             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      808             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      809           .
      810         end.
      811         else do:
      812           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      813           if vRindex2 <= vRindex1
      814           then
      815              vRindex2 = vRindex1 + 70.
      816           assign
      817             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      818             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      819             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      820           .
      821         end.
      822       end.
      823       B-viewProcInfo:visible   in frame waitfram = no.
      824       B-viewProcInfo:sensitive in frame waitfram = no.
      825       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      826       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      827       if  (   mWaitFramView
      828          or  mWaitProcEvent)
      829          and not mBatchMode
      830       then
      831          display
      832             v-waitfram-action01 skip
      833             v-waitfram-action02 skip
      834             v-waitfram-action03 skip
      835          with frame waitfram .
      836       if     mWaitFramView
      837          then do:
      838             if     mWaitFramInterval ne ?
      839                and not mBatchMode
      840             then
      841                wait-for go of frame waitfram pause mWaitFramInterval.
      842          end.
      843          else
      844             if     mWaitProcEvent
      845                and not mBatchMode
      846             then
      847                process events .
      848     end.
      849   end procedure.
      850      procedure waitfram-show-this:
      851         define input  parameter iInterval as int64 no-undo.
      852         define variable vtime as int64 no-undo.
      853         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      854         mWaitFramInterval = iInterval.
      855         run waitfram-show (substitute("&1&2 &3&4" ,
      856                                       mWaitFramTextBeg ,
      857                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      858                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      859                                       mWaitFramTextEnd
      860                                      )
      861                           ).
      862      end.
      863      procedure WaitFramRunPause:
      864         define input  parameter iInterval as dec no-undo.
      865         define variable vStart  as datetime-tz no-undo.
      866         define variable vend    as datetime-tz no-undo.
      867         define variable vint as int64 no-undo.
      868         define variable vOk as logical no-undo.
      869         vStart = now.
      870         vend   = vStart.
      871         publish "WaitFramPause" (iInterval,output vOk).
      872         vend   =  now.
      873         vint = vend - vStart.
      874         vint = iInterval - vint / 1000.
      875         if     not mWaitFramStop
      876            and (   vint > 0
      877                 or (    not vOk
      878                     and iInterval eq ?
      879                     )
      880                 )
      881         then
      882            run waitfram-show-this (iInterval).
      883         vend   =  now.
      884         vint = vend - vStart.
      885         vint = iInterval - vint / 1000.
      886         if     not mWaitFramStop
      887            and vint > 0
      888         then do:
      889            run gbl/pause.p (vint * 1000).
      890         end.
      891         if iInterval ne ?
      892         then
      893            publish "WaitFramStop".
      894         waitfram-check-timeout().
      895      end.
      896      procedure WaitFramWaitFor:
      897         define input  parameter iInterval as dec no-undo.
      898         assign
      899            mWaitFramStartProc   = now
      900            mWaitFramStopUser    = no
      901            mWaitFramStopTimeOut = no
      902         .
      903         block-wait:
      904         do while not mWaitFramStop:
      905            run WaitFramRunPause (iInterval).
      906            if  waitfram-check-timeout()
      907            then do:
      908               leave block-wait.
      909            end.
      910         end.
      911         run waitfram-hide.
      912      end.
      913   procedure waitfram-join :
      914     define input  parameter p-line-1  as character no-undo .
      915     define input  parameter p-line-2  as character no-undo .
      916     define input  parameter p-line-3  as character no-undo .
      917     define output parameter p-message as character no-undo .
      918     do
      919     on error undo, return error return-value
      920     :
      921       assign
      922         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      923                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      924                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      925       .
      926     end.
      927   end procedure.
      928   function waitfram-join-function returns character
      929     (input p-line-1 as character
      930     ,input p-line-2 as character
      931     ,input p-line-3 as character
      932     ).
      933     define variable v-message as character no-undo .
      934     run waitfram-join in this-procedure
      935       (input  p-line-1
      936       ,input  p-line-2
      937       ,input  p-line-3
      938       ,output v-message
      939       ) .
      940     return v-message .
      941   end function .
      942   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      943     define variable v-cntxt-db-num        as integer   no-undo .
      944     define variable v-cntxt-userid        as character no-undo .
      945     define variable v-cntxt-level         as character no-undo .
      946     define variable v-cntxt-host-code-obj as integer   no-undo .
      947     define variable v-cntxt-obj-type      as character no-undo .
      948     define variable v-cntxt-obj-code      as integer   no-undo .
      949     define variable v-cntxt-db-num-obj    as integer   no-undo .
      950     define variable v-cntxt-is-admin      as logical   no-undo .
      951   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      952   define temp-table x_obj-group no-undo like ub.clients  .
      953   define temp-table x_grp-obj-price no-undo like ub.grp-obj-price .
      954   procedure metod-gop-obj :
      955     do
      956     on error undo, return error return-value
      957     :
      958   define input  parameter p-cntxt-db-num as integer   no-undo .
      959   define input  parameter p-gop-id       as integer   no-undo .
      960   define input  parameter p-gop-db-num   as integer   no-undo .
      961   define buffer buf1_clients for ub.clients  .
      962   define buffer buf_db-grp-obj-price   for ub.db-grp-obj-price  .
      963   define buffer buf_host-grp-obj-price for ub.host-grp-obj-price  .
      964   define buffer buf_obj-grp-obj-price  for ub.obj-grp-obj-price  .
      965   for each  x_obj-group : delete x_obj-group. end.
      966   if p-gop-id = 0 or p-gop-id = ?  then do:
      967      if p-cntxt-db-num = 0  then do:
      968           for each buf1_clients no-lock where
      969                   (buf1_clients.obj-type = 'маг':U  or
      970                    buf1_clients.obj-type = 'скл':U  )
      971                   and
      972                   buf1_clients.db-num >= 0  and
      973                   buf1_clients.stts = 0
      974                   :
      975             create x_obj-group .
      976             assign
      977               x_obj-group.obj-code   = buf1_clients.obj-code
      978               x_obj-group.obj-type   = buf1_clients.obj-type
      979               x_obj-group.obj-name   = buf1_clients.obj-name
      980               x_obj-group.db-num     = buf1_clients.db-num
      981             .
      982           end.
      983      end.
      984      else do:
      985           for each buf1_clients no-lock where
      986                   (buf1_clients.obj-type = 'маг':U  or
      987                    buf1_clients.obj-type = 'скл':U  ) and
      988                    buf1_clients.db-num = p-cntxt-db-num  and
      989                    buf1_clients.stts = 0
      990                   :
      991             create x_obj-group .
      992             assign
      993               x_obj-group.obj-code   = buf1_clients.obj-code
      994               x_obj-group.obj-type   = buf1_clients.obj-type
      995               x_obj-group.obj-name   = buf1_clients.obj-name
      996               x_obj-group.db-num     = buf1_clients.db-num
      997             .
      998           end.
      999      end.
     1000   end.
     1001   else do:
     1002         for each buf_db-grp-obj-price  where
     1003                 buf_db-grp-obj-price.gop-id     = p-gop-id and
     1004                 buf_db-grp-obj-price.gop-db-num = p-gop-db-num and
     1005                 buf_db-grp-obj-price.stts = 0  no-lock :
     1006           for each buf1_clients no-lock where
     1007                  (buf1_clients.obj-type = 'маг':U  or
     1008                   buf1_clients.obj-type = 'скл':U  ) and
     1009                   buf1_clients.db-num = buf_db-grp-obj-price.dgo-db-num  and
     1010                   buf1_clients.stts = 0
     1011                   :
     1012             create x_obj-group .
     1013             assign
     1014               x_obj-group.obj-code   = buf1_clients.obj-code
     1015               x_obj-group.obj-type   = buf1_clients.obj-type
     1016               x_obj-group.obj-name   = buf1_clients.obj-name
     1017               x_obj-group.db-num     = buf1_clients.db-num
     1018             .
     1019           end.
     1020         end.
     1021       for each buf_host-grp-obj-price where
     1022               buf_host-grp-obj-price.gop-id     = p-gop-id and
     1023               buf_host-grp-obj-price.gop-db-num = p-gop-db-num and
     1024               buf_host-grp-obj-price.stts = 0
     1025               no-lock :
     1026         for each buf1_clients no-lock where
     1027                (buf1_clients.obj-type = 'маг':U  or
     1028                 buf1_clients.obj-type = 'скл':U  ) and
     1029                 buf1_clients.host-code = buf_host-grp-obj-price.host-code and
     1030                 buf1_clients.stts = 0
     1031                 :
     1032             find first x_obj-group no-lock  where
     1033                       x_obj-group.obj-code   = buf1_clients.obj-code and
     1034                       x_obj-group.obj-type   = buf1_clients.obj-type no-error .
     1035             if not available  x_obj-group then   create x_obj-group .
     1036             assign
     1037               x_obj-group.obj-code   = buf1_clients.obj-code
     1038               x_obj-group.obj-type   = buf1_clients.obj-type
     1039               x_obj-group.obj-name   = buf1_clients.obj-name
     1040               x_obj-group.db-num     = buf1_clients.db-num
     1041             .
     1042         end.
     1043       end.
     1044       for each buf_obj-grp-obj-price where
     1045               buf_obj-grp-obj-price.gop-id     = p-gop-id and
     1046               buf_obj-grp-obj-price.gop-db-num = p-gop-db-num and
     1047               buf_obj-grp-obj-price.stts = 0
     1048               no-lock :
     1049         for each buf1_clients no-lock where
     1050                   buf1_clients.obj-type = buf_obj-grp-obj-price.obj-type and
     1051                   buf1_clients.obj-code = buf_obj-grp-obj-price.obj-code and
     1052                   buf1_clients.stts     = 0
     1053                   :
     1054             find first  x_obj-group no-lock  where
     1055                         x_obj-group.obj-code   = buf1_clients.obj-code and
     1056                         x_obj-group.obj-type   = buf1_clients.obj-type no-error .
     1057             if not available  x_obj-group then   create x_obj-group .
     1058             assign
     1059               x_obj-group.obj-code   = buf1_clients.obj-code
     1060               x_obj-group.obj-type   = buf1_clients.obj-type
     1061               x_obj-group.obj-name   = buf1_clients.obj-name
     1062               x_obj-group.db-num     = buf1_clients.db-num
     1063             .
     1064         end.
     1065       end.
     1066   end.
     1067   end.
     1068   end procedure.
     1069   procedure metod-obj-in-gop :
     1070   define input  parameter p-curr-db-num as integer   no-undo .
     1071   define input  parameter p-obj-type as character no-undo .
     1072   define input  parameter p-obj-code as integer   no-undo .
     1073   define buffer buf_grp-obj-price for ub.grp-obj-price  .
     1074     do
     1075     on error undo, return error return-value
     1076     :
     1077       empty temp-table x_grp-obj-price.
     1078       for each buf_grp-obj-price where
     1079                buf_grp-obj-price.stts = 0
     1080                no-lock :
     1081                  run metod-gop-obj (p-curr-db-num , buf_grp-obj-price.gop-id ,buf_grp-obj-price.gop-db-num) .
     1082                  for each x_obj-group where
     1083                           x_obj-group.obj-type = p-obj-type and
     1084                           x_obj-group.obj-code = p-obj-code :
     1085                       create  x_grp-obj-price.
     1086                       buffer-copy buf_grp-obj-price to x_grp-obj-price .
     1087                  end.
     1088       end.
     1089     end.
     1090   end procedure.
     1091   procedure metod-delobj-usr :
     1092   define input  parameter p-pdf-id  as integer   no-undo .
     1093   define input  parameter p-pdf-db  as integer   no-undo .
     1094   define input  parameter p-plt-id  as integer   no-undo .
     1095   define input  parameter p-plt-db-num as integer   no-undo .
     1096   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
     1097     do
     1098     on error undo, return error return-value
     1099     :
     1100   for each buf_price-doc-forming-attr no-lock  where
     1101            buf_price-doc-forming-attr.pdf-id =     p-pdf-id and
     1102            buf_price-doc-forming-attr.pdf-db =     p-pdf-db and
     1103            buf_price-doc-forming-attr.plt-id =     p-plt-id and
     1104            buf_price-doc-forming-attr.plt-db-num = p-plt-db-num and
     1105            buf_price-doc-forming-attr.attr-code begins "obj" :
     1106      for each x_obj-group  where
     1107               x_obj-group.obj-type = substring(buf_price-doc-forming-attr.attr-code,4,3) and
     1108               x_obj-group.obj-code = int(substring(buf_price-doc-forming-attr.attr-code,7,20)) :
     1109        delete x_obj-group.
     1110      end.
     1111   end.
     1112     if not can-find (first x_obj-group) then do:
     1113        return "nullobj" .
     1114     end.
     1115   end.
     1116   end procedure.
     1117   procedure metod-obj-pdf :
     1118   define input  parameter p-cntxt-db-num as integer   no-undo .
     1119   define input  parameter p-pdf-id     like ub.price-doc-forming.pdf-id   no-undo .
     1120   define input  parameter p-pdf-db-num like ub.price-doc-forming.pdf-db   no-undo .
     1121   define input  parameter p-plt-id     like ub.price-doc-forming.plt-id   no-undo .
     1122   define input  parameter p-plt-db-num like ub.price-doc-forming.plt-db-num  no-undo .
     1123   define buffer buf_price-list-type for ub.price-list-type  .
     1124   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     1125     do
     1126     on error undo, return error return-value
     1127     :
     1128    for each  x_obj-group : delete x_obj-group. end.
     1129    find first buf_price-list-type no-lock where
     1130               buf_price-list-type.plt-id = p-plt-id and
     1131               buf_price-list-type.plt-db-num = p-plt-db-num no-error .
     1132   if error-status :error then return error return-value .
     1133    find first buf_price-doc-forming no-lock where
     1134               buf_price-doc-forming.plt-id     = p-plt-id and
     1135               buf_price-doc-forming.plt-db-num = p-plt-db-num and
     1136               buf_price-doc-forming.pdf-id     = p-pdf-id and
     1137               buf_price-doc-forming.pdf-db     = p-pdf-db-num
     1138               no-error .
     1139   if error-status :error then return error return-value .
     1140     run metod-gop-obj in this-procedure (
     1141         p-cntxt-db-num,
     1142         buf_price-list-type.gop-id ,
     1143         buf_price-list-type.gop-db-num
     1144         ) no-error .
     1145     run metod-delobj-usr in this-procedure (
     1146       buf_price-doc-forming.pdf-id ,
     1147       buf_price-doc-forming.pdf-db ,
     1148       buf_price-doc-forming.plt-id ,
     1149       buf_price-doc-forming.plt-db-num
     1150       ) no-error .
     1151     end.
     1152   end procedure.
     1153   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1154   define temp-table x_obj-grp-obj-price no-undo like ub.obj-grp-obj-price .
     1155   procedure metod-gop-obj-all :
     1156   define input  parameter p-curr-db-num as integer   no-undo .
     1157     do
     1158     on error undo, return error return-value
     1159     :
     1160    empty temp-table x_obj-group .
     1161    empty temp-table x_obj-grp-obj-price .
     1162    define buffer buf_grp-obj-price for ub.grp-obj-price  .
     1163    for each buf_grp-obj-price no-lock where
     1164             buf_grp-obj-price.stts = 0 :
     1165         run metod-gop-obj in this-procedure (
     1166             input  p-curr-db-num ,
     1167             input  buf_grp-obj-price.gop-id       ,
     1168             input  buf_grp-obj-price.gop-db-num   ).
     1169             for each x_obj-group :
     1170                create x_obj-grp-obj-price.
     1171                buffer-copy buf_grp-obj-price to x_obj-grp-obj-price
     1172                assign
     1173                   x_obj-grp-obj-price.obj-type = x_obj-group.obj-type
     1174                   x_obj-grp-obj-price.obj-code = x_obj-group.obj-code
     1175                .
     1176             end.
     1177    end.
     1178     end.
     1179   end procedure.
     1180   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1181   FUNCTION mark-string RETURNS CHARACTER
     1182     ( input p-recid as recid, input mark-list as character  ) :
     1183     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     1184   END FUNCTION.
     1185   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1186   FUNCTION price-grp RETURNS CHARACTER
     1187   (buffer buf_clients for ub.clients):
     1188   define variable tt-grp-obj as character no-undo .
     1189   tt-grp-obj =  "" .
     1190     for each x_obj-grp-obj-price  where
     1191              x_obj-grp-obj-price.stts = 0 and
     1192              x_obj-grp-obj-price.obj-type = buf_clients.obj-type and
     1193              x_obj-grp-obj-price.obj-code = buf_clients.obj-code :
     1194              tt-grp-obj = tt-grp-obj + string(x_obj-grp-obj-price.gop-id ) +
     1195              ( if x_obj-grp-obj-price.gop-db-num = 0 then "" else
     1196              "БД"  + string (x_obj-grp-obj-price.gop-db-num)) + "," .
     1197     end.
     1198   return trim(tt-grp-obj, ",") .
     1199   END FUNCTION.
     1200   define variable mark-num as integer no-undo.
     1201   define variable attr-option as character no-undo .
     1202   define variable cli-attr-option as character no-undo .
     1203   define variable v-is-deploy as logical no-undo .
     1204   define variable v-rid-list as character no-undo .
     1205   define variable v-doc-rec as recid no-undo .
     1206   define buffer X_cli-host for ub.clients.
     1207   define variable v-grp as character no-undo .
     1208   define variable v-exist-price-grp as logical   no-undo .
     1209   define buffer X_store for ub.store.
     1210   define buffer X_clients for ub.clients.
     1211   DEFINE BUTTON b-mark
     1212        LABEL " * ":L
     1213        SIZE 3 BY 1.
     1214   DEFINE BUTTON b-add
     1215        LABEL "&Добавить":L
     1216        SIZE 10 BY 1.
     1217   DEFINE BUTTON b-chg
     1218        LABEL "&Изменить":L
     1219        SIZE 10 BY 1.
     1220   DEFINE BUTTON b-del
     1221        LABEL "&Удалить":L
     1222        SIZE 10 BY 1.
     1223   DEFINE BUTTON b-lkp
     1224        LABEL "&Просм"
     1225        SIZE 10 BY 1.
     1226   DEFINE BUTTON b-quit AUTO-END-KEY DEFAULT
     1227        LABEL "&Выход ":L
     1228        SIZE 10 BY 1
     1229        BGCOLOR 8 .
     1230   DEFINE BUTTON b-help
     1231        LABEL "Помо&щь":L
     1232        SIZE 3 BY 1.
     1233   DEFINE BUTTON B-hist
     1234        LABEL "Ис&тория"
     1235        SIZE 3 BY 1.
     1236   DEFINE BUTTON b-print
     1237        LABEL "Пе&чать":L
     1238        SIZE 3 BY 1.
     1239   DEFINE BUTTON b-sel AUTO-GO
     1240        LABEL "Вы&бор ":L
     1241        SIZE 10 BY 1.
     1242   DEFINE BUTTON b-right
     1243        LABEL "&Права":L
     1244        SIZE 10 BY 1.
     1245   DEFINE BUTTON b-price
     1246        LABEL "&Цены":L
     1247        SIZE 10 BY 1.
     1248   DEFINE BUTTON b-attr
     1249        LABEL "Параметры":L
     1250        SIZE 10 BY 1.
     1251   DEFINE BUTTON b-cli-attr
     1252        LABEL "Атрибуты":L
     1253        SIZE 10 BY 1.
     1254   DEFINE BUTTON B-grp
     1255        LABEL "&Группа"
     1256        SIZE 10 BY 1.
     1257   DEFINE VARIABLE sch-code AS INTEGER FORMAT ">>>>9":U INITIAL 0
     1258        LABEL "код"
     1259        VIEW-AS FILL-IN
     1260        SIZE 6 BY 1 NO-UNDO.
     1261   DEFINE MENU MENU-B-attr
     1262          MENU-ITEM m_lookup       LABEL "&Просмотр"
     1263          MENU-ITEM m_update       LABEL "Изменение"
     1264          MENU-ITEM m_copy         LABEL "&Копирование"
     1265          rule
     1266          MENU-ITEM m_price-grp    LABEL "Группа ценообразования"
     1267          .
     1268   DEFINE MENU MENU-B-cli-attr
     1269          MENU-ITEM m_lookup-cli       LABEL "&Просмотр"
     1270          MENU-ITEM m_update-cli        LABEL "Изменение"
     1271          .
     1272   DEFINE QUERY br-stores FOR X_store, X_clients, X_cli-host SCROLLING.
     1273   DEFINE BROWSE br-stores QUERY br-stores NO-LOCK DISPLAY
     1274   mark-string(recid(X_store), v-rid-list) Format "X(1)" COLUMN-LABEL "*"
     1275   X_store.obj-code COLUMN-LABEL "Код " FORMAT ">>>>9"
     1276   X_clients.obj-name COLUMN-LABEL "Название " FORMAT "x(80)" width 25
     1277   X_cli-host.obj-name COLUMN-LABEL "Фирма" FORMAT "x(80)" width 25
     1278   (if X_clients.stts = 0 then " " else "+") format "x(1)" column-label "Удал"
     1279   X_clients.db-num format ">>>>9" width 6
     1280   X_store.shift-on COLUMN-LABEL "Смены":L format " + / - "
     1281   X_clients.grp-name COLUMN-LABEL "Группа" FORMAT "x(80)" width 25
     1282   price-grp ( buffer X_clients ) @ v-grp COLUMN-LABEL "Группа ценообразования" FORMAT "x(80)" width 25
     1283   WITH SIZE 98 BY 19 separators.
     1284   DEFINE FRAME d-store
     1285   b-quit AT ROW 1 COL 1
     1286   b-mark AT ROW 1 COL 11
     1287   b-sel AT ROW 1 COL 14
     1288   b-add AT ROW 1 COL 24
     1289   b-lkp AT ROW 1 COL 34
     1290   b-chg AT ROW 1 COL 44
     1291   b-del AT ROW 1 COL 54
     1292   b-attr AT ROW 1 COL 64
     1293   b-right AT ROW 1 COL 74
     1294   b-print AT ROW 1 COL 89
     1295   b-hist AT ROW 1 col 92
     1296   b-help AT ROW 1 COL 95
     1297   b-cli-attr AT ROW 2 COL 64
     1298   b-price AT ROW 2 COL 74
     1299   sch-code AT ROW 2 COL 25
     1300   mark-num at row 2 col 14 colon-aligned no-label view-as fill-in size 3 by 1.5 fgcolor 4
     1301   b-grp at row 2 col 84
     1302   br-stores AT ROW 3.25 COL 1
     1303   SPACE(0.74) SKIP(0.66)
     1304   WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1305   SIDE-LABELS NO-UNDERLINE THREE-D SCROLLABLE
     1306   TITLE "   Склады" .
     1307   ASSIGN
     1308          FRAME d-store:SCROLLABLE       = FALSE
     1309          br-stores:NUM-LOCKED-COLUMNS IN FRAME d-store = 1.
     1310   on go of frame d-store do:
     1311     p-rid-list = v-rid-list.
     1312   end.
     1313   ON CHOOSE OF b-attr IN FRAME d-store
     1314   DO:
     1315   define variable v-param as character no-undo .
     1316   define variable v-db-num like ub.db.db-num no-undo .
     1317   if not available X_store then return no-apply.
     1318   if attr-option = '':U then do:
     1319      run gbl/pop-up.p ( input self:handle
     1320                        ,input no) no-error.
     1321   end.
     1322   if attr-option = '':U then return no-apply.
     1323   if attr-option = 'ИЗМЕНЕНИЕ':U
     1324   or attr-option = 'КОПИРОВАНИЕ':U then do:
     1325     if v-cntxt-db-num <> 0 then do:
     1326   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1327   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1328     (input  'скл':U
     1329     ,input  X_store.obj-code
     1330     ,output v-db-num
     1331     )  .
     1332       if v-db-num <> v-cntxt-db-num then do:
     1333         message
     1334         "Нельзя менять ПАРАМЕТРЫ в чужой УБД"
     1335         view-as alert-box error .
     1336         return no-apply.
     1337       end.
     1338     end.
     1339   end.
     1340   run proc-b-attr in this-procedure (
     1341                                       input attr-option
     1342                                      ,'скл':U
     1343                                      ,X_store.obj-code) no-error .
     1344   if error-status:error then do:
     1345     assign
     1346     attr-option = "":u.
     1347     return no-apply.
     1348   end.
     1349   attr-option = "":u.
     1350   END.
     1351   ON CHOOSE OF b-cli-attr IN FRAME d-store
     1352   DO:
     1353    define variable v-updated as logical no-undo .
     1354    define variable v-is-error as logical no-undo .
     1355    define variable v-db-num as integer no-undo .
     1356    define variable ri as recid no-undo .
     1357     if not available X_store then do:
     1358       return no-apply.
     1359     end.
     1360     ri = recid(X_store).
     1361     if cli-attr-option = "":U then do:
     1362       run gbl/pop-up.p ( input self :handle, input no ) no-error.
     1363       if error-status :error then do: return no-apply. end.
     1364     end.
     1365     if cli-attr-option = "":U then do:
     1366         return no-apply.
     1367     end.
     1368     if cli-attr-option = 'ИЗМЕНЕНИЕ':U
     1369     then do:
     1370       if v-cntxt-db-num > 0 then do:
     1371   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1372   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1373     (input  'скл':U
     1374     ,input  X_store.obj-code
     1375     ,output v-db-num
     1376     )  .
     1377         if v-db-num <> v-cntxt-db-num then do:
     1378           message
     1379           "Нельзя менять АТРИБУТЫ в чужой УБД"
     1380           view-as alert-box error .
     1381           return no-apply.
     1382         end.
     1383       end.
     1384     end.
     1385     run ref/ca-attrr.p (
     1386                       input parparentproc
     1387                      ,input (if lookup("b-add", bttns) > 0
     1388                             AND cli-attr-option = 'ИЗМЕНЕНИЕ':U
     1389                             then 'ИЗМЕНЕНИЕ':U
     1390                             else 'ПРОСМОТР':U)
     1391                      ,input 'скл':U
     1392                      ,input X_store.obj-code
     1393                      ,input yes
     1394                      ,output v-updated
     1395                      ,output v-is-error
     1396                      ) no-error.
     1397     if error-status:error
     1398     or v-is-error then do:
     1399       message
     1400       "Ошибка при вызове списка атрибутов клиента" skip
     1401       error-status:get-message(1) skip
     1402       return-value
     1403       view-as alert-box .
     1404       assign
     1405       cli-attr-option = "":U
     1406       .
     1407       undo, return no-apply.
     1408     end.
     1409     cli-attr-option = "":U.
     1410   END.
