        1   block-level on error undo, throw.
        2   routine-level on error undo, throw.
        3   define variable vss-revision    as character no-undo initial "$Revision: bbf1530230d5, 2753, rls $":U .
        4   define variable vss-author      as character no-undo initial "$Author: EShklyar $":U .
        5   define variable vss-date        as character no-undo initial "$Date: Сб фев 20 15:59:21 2021 +0300 $":U .
        6   define variable vss-workfile    as character no-undo initial "$Workfile: xlssn.p $":U .
        7   define variable vss-archive     as character no-undo initial "$Archive: adm/xlssn.p $":U .
        8   define variable vss-description as character no-undo initial "Импорт серийных номеров для параметра tsd-list из excel".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#library  as handle no-undo .
       64   define new global shared variable g#library2 as handle no-undo .
       65   define output parameter pOutSN as character no-undo.
       66   define variable mExcelApplication as component-handle no-undo.
       67   define variable mWorkBook         as component-handle no-undo.
       68   define variable mWorkSheet        as component-handle no-undo.
       69   define variable mMaxNoLine        as integer          initial 10 no-undo.
       70   define variable mFileName         as character        no-undo.
       71   run proc-main in this-procedure.
       72   catch mError as Progress.Lang.Error:
       73     return error
       74       (if mError:GetMessage(1) > "":U then mError:GetMessage(1)
       75       else
       76       (if return-value > "":U then return-value
       77       else "Неизвестная системная ошибка")).
       78   end catch.
       79   finally:
       80     mWorkbook:Close(false) no-error.
       81     release object mWorkSheet no-error.
       82     release object mWorkbook no-error.
       83     mExcelApplication:QUIT() no-error.
       84     release object mExcelApplication no-error.
       85   end finally.
       86   procedure proc-main:
       87     define variable vFileName as character no-undo.
       88     define variable varlog    as logical   no-undo.
       89     system-dialog get-file mFileName
       90       title "Выберите файл заказа"
       91       filters "Excel"         "*.xls",
       92       "Все файлы"      "*.*"
       93       update varlog.
       94     if not varlog then return error.
       95     vFilename = search(mFileName) .
       96     if vFileName <> ? then .
       97     else return error substitute("Не найден файл &1", mFileName).
       98     create "Excel.Application":U mExcelApplication no-error.
       99         if error-status :error then do:
      100           message
      101           "Ошибка при запуске Excel" skip
      102           error-status :get-message(1) skip
      103           view-as alert-box error .
      104           undo, return error .
      105       end.
      106     assign
      107       mExcelApplication:DisplayAlerts = no
      108       mWorkbook                       = mExcelApplication:WorkBooks:Add(vFileName)
      109       mWorkSheet                      = mWorkbook:Sheets:Item(1)
      110       .
      111     run proc-read-tt in this-procedure.
      112     mWorkbook:Close(true) no-error.
      113     release object mWorkSheet no-error.
      114     release object mWorkbook no-error.
      115     mExcelApplication:QUIT() no-error.
      116     release object mExcelApplication no-error.
      117     pOutSN = trim (pOutSN,";").
      118   end procedure.
      119   procedure proc-read-tt:
      120     define variable vLine   as integer   no-undo.
      121     define variable vstr    as character no-undo.
      122     define variable vChLine as character no-undo.
      123     loopbl:
      124     do vLine = 5 to 1000000:
      125       assign
      126         vChLine = string(vLine)
      127         .
      128       vstr = mWorkSheet:Range("B":U + vChLine):text.
      129       if not (vstr = "" or vstr = ?)
      130       then pOutSN   = pOutSN + ";" + mWorkSheet:Range("B":U + vChLine):value no-error.
      131       else leave loopbl.
      132     end.
      133   end procedure.
