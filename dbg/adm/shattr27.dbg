      445        SIZE 79.5 BY 8
      446        FGCOLOR 4  NO-UNDO.
      447   DEFINE VARIABLE tg-docdstnws AS LOGICAL INITIAL no
      448        LABEL " Не передавать в УБД по СПН документы уничтожения и перемещения зоны погашения ."
      449        VIEW-AS TOGGLE-BOX
      450        SIZE 80.5 BY .83 NO-UNDO.
      451   DEFINE FRAME Dialog-Frame
      452        b-exit AT ROW 1 COL 1
      453        b-quit AT ROW 1 COL 11
      454        b-help AT ROW 1 COL 55
      455        b-cli-grp AT ROW 3 COL 40 WIDGET-ID 2
      456        ed-grp-obj AT ROW 4 COL 3 NO-LABEL WIDGET-ID 20
      457        tg-docdstnws AT ROW 13.25 COL 3.5 WIDGET-ID 22
      458        "Группы клиентов для сводных отчетов:" VIEW-AS TEXT
      459             SIZE 36 BY .67 AT ROW 3.25 COL 2.5 WIDGET-ID 4
      460             FGCOLOR 4
      461        SPACE(45.99) SKIP(11.70)
      462       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      463            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      464            TITLE "Глобальные настройки для работы с МЦ"
      465            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit WIDGET-ID 100.
      466   ASSIGN
      467          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      468          FRAME Dialog-Frame:HIDDEN           = TRUE.
      469   ASSIGN
      470          ed-grp-obj:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      471   ON GO OF FRAME Dialog-Frame
      472   DO:
      473      IF p-mode = 'ПРОСМОТР':U THEN RETURN.
      474      run save-proc in this-procedure no-error.
      475      if error-status :error then return no-apply.
      476   END.
      477   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      478   DO:
      479     APPLY "END-ERROR":U TO SELF.
      480   END.
      481   ON CHOOSE OF b-cli-grp IN FRAME Dialog-Frame
      482   DO:
      483      run grp-list in THIS-PROCEDURE .
      484      display ed-grp-obj WITH frame Dialog-Frame.
      485   END.
      486   ON CHOOSE OF b-help IN FRAME Dialog-Frame
      487   OR HELP OF FRAME Dialog-Frame
      488   DO:
      489     MESSAGE "Help for File: c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\adm\shattr27.w" VIEW-AS ALERT-BOX INFORMATION.
      490   END.
      491   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      492   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      493   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      494   on F2 of frame Dialog-Frame anywhere do:
      495     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
      496     return no-apply.
      497   end.
      498   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      499   on help of frame Dialog-Frame
      500   do:
      501     run gbl/app_help.p
      502       (input this-procedure :file-name
      503       ,input ''
      504       ,input ?
      505       ) no-error.
      506     if error-status :error then do:
      507       message
      508         "Ошибка при вызове помощи"
      509         error-status :get-message(1)
      510         view-as alert-box .
      511     end.
      512   end.
      513   run minbtn-set in this-procedure .
      514   on choose of b-help in frame Dialog-Frame
      515   do:
      516     apply "help":u to frame Dialog-Frame .
      517   end.
      518   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      519   procedure minbtn-set :
      520       do
      521           on error undo, return error return-value
      522           :
      523           define variable ii              as integer       no-undo .
      524           define variable fh              as widget-handle no-undo .
      525           define variable hh              as widget-handle no-undo .
      526           define variable v-h             as handle        extent 4 no-undo .
      527           define variable v-name-button   as character     no-undo .
      528           define variable v-help-old-x    as decimal       no-undo .
      529           define variable v-help-old-y    as decimal       no-undo .
      530           define variable v-help-old-size as decimal       no-undo .
      531           define variable v-frame-width   as decimal       no-undo .
      532           define variable jj              as integer       no-undo .
      533           do
      534               on error undo, return error
      535               :
      536               assign
      537                   v-frame-width = frame Dialog-Frame:width - 0.3
      538                   fh            = frame Dialog-Frame:first-child
      539                   hh            = fh:first-child
      540                   ii            = 1
      541                   .
      542               do while valid-handle(hh):
      543                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      544                   do:
      545                       case lc(hh:name) :
      546                           when "b-help" then
      547                               do:
      548                                   hh:load-image-up("cmp/b-help.bmp":u) .
      549                                   hh:load-image-down("cmp/b-help.bmp":u) .
      550                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      551                                   hh:TOOLTIP = "Помощь" .
      552                                   v-help-old-x = hh:column .
      553                                   v-help-old-y = hh:row    .
      554                                   v-help-old-size = hh:width .
      555                                   hh:width-chars = 2.5 .
      556                               end.
      557                           when "b-print" then
      558                               do:
      559                                   hh:load-image("cmp/b-print.bmp":u) .
      560                                   hh:TOOLTIP = "Печать" .
      561                                   v-h[ii] = hh:handle .
      562                                   ii = ii + 1 .
      563                                   hh:width-chars = 3 .
      564                               end.
      565                           when "b-history" or
      566                           when "b-hist" then
      567                               do:
      568                                   hh:load-image("cmp/b-hist.bmp":u) .
      569                                   hh:TOOLTIP = "История" .
      570                                   v-h[ii] = hh:handle .
      571                                   ii = ii + 1 .
      572                                   hh:width-chars = 3 .
      573                               end.
      574                           when "b-sch" then
      575                               do:
      576                                   hh:load-image("cmp/b-sch.bmp":u) .
      577                                   hh:TOOLTIP = "Установка Фильтра" .
      578                                   v-h[ii] = hh:handle .
      579                                   ii = ii + 1 .
      580                                   hh:width-chars = 3 .
      581                               end.
      582                           when "b-hist-user" then
      583                               do:
      584                                   hh:load-image("cmp/b-hist.bmp":u) .
      585                                   hh:TOOLTIP = "История пользователя" .
      586                                   ii = ii + 1 .
      587                               end.
      588                       end case.
      589                   end.
      590                   hh = hh:next-sibling.
      591               end.
      592               b-help:column = v-frame-width - b-help:width-chars.
      593               jj = 0.
      594               repeat ii = 4 to 1 by -1 :
      595                   if valid-handle (v-h[ii] ) then
      596                   do:
      597                       jj  = jj + 1 .
      598                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      599                       v-h[ii]:row    = v-help-old-y .
      600                   end.
      601               end.
      602           end.
      603       end.
      604   end procedure.
      605   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      606     run mainmenu_getcntxt in parparentproc
      607       (output v-cntxt-db-num
      608       ,output v-cntxt-userid
      609       ,output v-cntxt-level
      610       ,output v-cntxt-host-code-obj
      611       ,output v-cntxt-obj-type
      612       ,output v-cntxt-obj-code
      613       ,output v-cntxt-db-num-obj
      614       ,output v-cntxt-is-admin
      615       ) .
      616   MAIN-BLOCK:
      617   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      618      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      619      assign
      620         v-tth-wthrep = buffer thbjattr_thbj-attr-fin:table-handle
      621      .
      622      if p-mode =  'ИЗМЕНЕНИЕ':U then do:
      623         if v-cntxt-db-num = 0 then p-mode = 'ИЗМЕНЕНИЕ':U.
      624            else p-mode = 'ПРОСМОТР':U .
      625      end.
      626      RUN enable_UI.
      627      run load-attr in this-procedure .
      628      WAIT-FOR GO OF FRAME Dialog-Frame.
      629   END.
      630   RUN disable_UI.
      631   PROCEDURE disable_UI :
      632     HIDE FRAME Dialog-Frame.
      633   END PROCEDURE.
      634   PROCEDURE enable_UI :
      635     DISPLAY ed-grp-obj tg-docdstnws
      636         WITH FRAME Dialog-Frame.
      637     ENABLE b-exit b-quit b-help b-cli-grp ed-grp-obj tg-docdstnws
      638         WITH FRAME Dialog-Frame.
      639     VIEW FRAME Dialog-Frame.
      640   END PROCEDURE.
      641   PROCEDURE fill-widgets :
      642   define variable v-value-character as character no-undo .
      643      define variable v-value-date as date no-undo .
      644      define variable v-value-decimal as decimal no-undo .
      645      define variable v-value-integer as INTEGER no-undo .
      646      define variable v-value-logical AS LOGICAL no-undo .
      647      define variable v-param-type as character no-undo .
      648      define variable v-i    as integer      no-undo.
      649      define buffer buf_cli-grp     for ub.cli-grp .
      650   do
      651   on error undo, return error
      652   :
      653      for each thbjattr_thbj-attr-fin:
      654         delete thbjattr_thbj-attr-fin.
      655      end.
      656      for each temp-thbj-attr:
      657         delete temp-thbj-attr.
      658      end.
      659      run adm/shattri.p (
      660         input "init":U
      661      , input ""
      662      , input 0
      663      , input 'attr-wthrep':U
      664      , input "":U
      665      , output v-value-character
      666      , output v-value-date
      667      , output v-value-decimal
      668      , output v-value-integer
      669      , output v-value-logical
      670      , output v-param-type
      671      , input-output TABLE-HANDLE v-tth-wthrep
      672      ) no-error .
      673      if error-status:error
      674      and not available buf_thbj-attr
      675      then do:
      676         message
      677            "Не удалось получить начальные значения настроек" skip
      678            error-status:get-message(1) return-value
      679         view-as alert-box error .
      680         undo, return error .
      681      end.
      682      FOR EACH thbjattr_thbj-attr-fin:
      683         IF thbjattr_thbj-attr-fin.prop-code = 'cligrplist':U THEN DO:
      684            v-cli-grp-code-list = thbjattr_thbj-attr-fin.property-value-character.
      685         END.
      686         IF thbjattr_thbj-attr-fin.prop-code = 'docdstnws':U THEN DO:
      687                 tg-docdstnws = thbjattr_thbj-attr-fin.property-value-logical.
      688         END.
      689         create temp-thbj-attr.
      690         buffer-copy thbjattr_thbj-attr-fin to temp-thbj-attr.
      691      END.
      692      do v-i = 1 to num-entries(v-cli-grp-code-list)
      693      :
      694         find first buf_cli-grp no-lock
      695         where buf_cli-grp.node-code = integer( entry( v-i, v-cli-grp-code-list, chr(44) ) )
      696         no-error .
      697         if available buf_cli-grp
      698         then do:
      699            assign
      700               ed-grp-obj = ed-grp-obj + buf_cli-grp.node-name + chr(10)
      701            .
      702         end.
      703      end.
      704   end.
      705   END PROCEDURE.
      706   PROCEDURE grp-list :
      707   define buffer buf_cli-grp     for ub.cli-grp .
      708   define variable v-count    as integer      no-undo.
      709   do
      710   on error undo, return error
      711   :
      712      run ref/cli-grps.w   ( INPUT parparentproc
      713                           , INPUT "b-sel,b-mark"
      714                           , INPUT-OUTPUT v-cli-grp-recid-list
      715                           ) .
      716      IF v-cli-grp-recid-list = "":U
      717      THEN DO:
      718         RETURN NO-APPLY.
      719      END.
      720      assign
      721         v-cli-grp-code-list = "":U
      722         ed-grp-obj  = "":U
      723      .
      724      DO v-count = 1 TO NUM-ENTRIES(v-cli-grp-recid-list)
      725      on error undo, next
      726      :
      727         find first buf_cli-grp
      728              where RECID(buf_cli-grp) = INTEGER(ENTRY(v-count, v-cli-grp-recid-list, chr(44)))
      729              no-lock
      730              no-error
      731              .
      732         IF AVAILABLE buf_cli-grp
      733         THEN DO:
      734            assign
      735               v-cli-grp-code-list = IF v-cli-grp-code-list = "":U THEN STRING(buf_cli-grp.node-code)
      736                                                                   ELSE v-cli-grp-code-list + chr(44) + STRING(buf_cli-grp.node-code)
      737               ed-grp-obj = ed-grp-obj + buf_cli-grp.node-name + chr(10)
      738            .
      739         END.
      740      END.
      741   end.
      742   END PROCEDURE.
      743   PROCEDURE load-attr :
      744   define variable v-ok as logical   no-undo .
      745   do
      746   on error undo, return error
      747   :
      748      if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      749   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      750   do:
      751     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      752       (input  v-cntxt-db-num
      753       ,input  v-cntxt-userid
      754       ,input  0
      755       ,input  'actn_wealth_work':U
      756       ,input  'global':U
      757       ,input  0
      758       ,input  '':U
      759       ,input  0
      760       ,input  0
      761       ,input  0
      762       ,input  0
      763       ,input  true
      764       ,output v-ok
      765       )  .
      766   end.
      767         if v-ok <> yes
      768         then do:
      769            return error.
      770         end.
      771         find  first buf_thbj-attr
      772               where buf_thbj-attr.obj-type        = "":u
      773               and   buf_thbj-attr.obj-code        = 0
      774               and   buf_thbj-attr.upper-prop-code = 'attr-wthrep':U
      775               and   buf_thbj-attr.prop-code       = '':u
      776               exclusive-lock
      777               no-wait
      778               no-error
      779               .
      780         if locked buf_thbj-attr then do:
      781            message
      782                       vss-workfile vss-revision vss-description
      783                  skip 'attr-wthrep':U
      784                  skip "Запись Глобальных ПАРАМЕТРОВ для взаиморасчетов занята"
      785                  view-as alert-box error .
      786            undo, return error.
      787         end.
      788      end.
      789      else do:
      790         find  first buf_thbj-attr
      791               where buf_thbj-attr.obj-type        = "":u
      792               and   buf_thbj-attr.obj-code        = 0
      793               and   buf_thbj-attr.upper-prop-code = 'attr-wthrep':U
      794               and   buf_thbj-attr.prop-code       = '':u
      795               no-lock
      796               no-error
      797               .
      798         DISABLE b-quit WITH FRAME Dialog-Frame.
      799         b-exit:LABEL = "Вы&ход"  .
      800         HIDE b-quit IN FRAME Dialog-Frame .
      801      end.
      802      if not available buf_thbj-attr
      803      then do:
      804         assign
      805            v-to-create  = true
      806         .
      807         message
      808            substitute ("Внимание!!!&1Параметра НЕТ в БД!&1 Список пустой."
      809                       , chr(10)
      810                       )
      811         view-as alert-box warning.
      812      end.
      813      run fill-widgets in this-procedure no-error.
      814      if error-status:error
      815      then DO:
      816         undo, return error.
      817      END.
      818      apply "value-changed":u to b-cli-grp in frame Dialog-Frame.
      819      IF p-mode <> 'ИЗМЕНЕНИЕ':U
      820      THEN DO:
      821         DISABLE b-cli-grp WITH frame Dialog-Frame.
      822      END.
      823      display ed-grp-obj tg-docdstnws WITH frame Dialog-Frame.
      824   end.
      825   END PROCEDURE.
      826   PROCEDURE save-proc :
      827   define variable v-value-character as character no-undo .
      828   define variable v-value-date as date no-undo .
      829   define variable v-value-decimal as decimal no-undo .
      830   define variable v-value-integer as INTEGER no-undo .
      831   define variable v-value-logical AS LOGICAL no-undo .
      832   define variable v-trf-type like ub.clients.obj-type no-undo .
      833   define variable v-trf-code like ub.clients.obj-code no-undo .
      834   define variable v-param-type as character no-undo .
      835   define variable wh as widget-handle no-undo .
      836   define variable fh as widget-handle no-undo .
      837   define variable v-same as logical no-undo .
      838   do
      839   on error undo, return error
      840   :
      841      assign frame Dialog-Frame  tg-docdstnws.
      842      FOR EACH thbjattr_thbj-attr-fin:
      843         IF thbjattr_thbj-attr-fin.prop-code = 'cligrplist':U THEN DO:
      844            assign
      845               thbjattr_thbj-attr-fin.property-value-character = v-cli-grp-code-list
      846            .
      847         END.
      848         IF thbjattr_thbj-attr-fin.prop-code = 'docdstnws':U THEN DO:
      849            assign
      850               thbjattr_thbj-attr-fin.property-value-logical = tg-docdstnws
      851            .
      852         END.
      853      END.
      854      do TRANSACTION
      855      on error undo, return error return-value
      856      :
      857         run thbjattr_set-section in this-procedure (
      858                input ""
      859               ,input 0
      860               ,input 'attr-wthrep':U
      861               ,input table thbjattr_thbj-attr-fin
      862         ) no-error.
      863         if error-status:error then do:
      864            message error-status:get-message(1)  skip
      865            return-value
      866            view-as alert-box.
      867            undo, return error.
      868         end.
      869      end.
      870   end.
      871   END PROCEDURE.
