      155   procedure thbjattr_code_reg :
      156   define input  parameter p-upper-code     as character no-undo .
      157   define input  parameter p-code           as character no-undo .
      158   define output parameter p-label          as character no-undo .
      159   define output parameter p-user-can-edit  as logical   no-undo .
      160   define output parameter p-output-display as logical   no-undo .
      161   define output parameter p-other          as character no-undo .
      162   define output parameter p-prop-list      as character no-undo .
      163   define output parameter p-prop-type-list as character no-undo .
      164   define output parameter p-prop-label-list as character no-undo .
      165   define output parameter p-global          as logical no-undo .
      166   define output parameter p-host           as logical no-undo .
      167   define output parameter p-shop           as logical no-undo .
      168   define output parameter p-store          as logical no-undo .
      169   define output parameter p-db             as logical no-undo .
      170   define output parameter p-region         as logical no-undo .
      171   do
      172   on error undo, return error return-value
      173   :
      174       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      175       (input  p-upper-code
      176       ,input  p-code
      177       ,output p-label
      178       ,output p-user-can-edit
      179       ,output p-output-display
      180       ,output p-other
      181       ,output p-prop-list
      182       ,output p-prop-type-list
      183       ,output p-prop-label-list
      184       ,output p-global
      185       ,output p-host
      186       ,output p-shop
      187       ,output p-store
      188       ,output p-db
      189       ,output p-region
      190       ) no-error .
      191     if error-status :error
      192     then do:
      193       undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      194     end.
      195   end.
      196   end procedure.
