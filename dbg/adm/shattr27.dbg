      125      define output parameter p-user-can-edit  as logical   no-undo .
      126      define output parameter p-output-display as logical   no-undo .
      127      define output parameter p-other          as character no-undo .
      128      define output parameter p-prop-list      as character no-undo .
      129      define output parameter p-prop-type-list as character no-undo .
      130      define output parameter p-prop-label-list as character no-undo .
      131      define output parameter p-global          as logical no-undo .
      132      define output parameter p-host           as logical no-undo .
      133      define output parameter p-shop           as logical no-undo .
      134      define output parameter p-store          as logical no-undo .
      135      define output parameter p-db             as logical no-undo .
