      137      run thbjattr_code_reg in this-procedure (
      138                                               p-upper-code,
      139                                               p-code,
      140                                               output p-label,
      141                                               output p-user-can-edit,
      142                                               output p-output-display,
      143                                               output p-other,
      144                                               output p-prop-list,
      145                                               output p-prop-type-list,
      146                                               output p-prop-label-list,
      147                                               output p-global,
