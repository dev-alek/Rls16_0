      489   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      490   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      491   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
