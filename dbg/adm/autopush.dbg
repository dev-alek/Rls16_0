        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo .
        3   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo .
        4   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Автоматические задания".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   procedure cur-time :
       71      define output parameter p-today as date      no-undo .
       72      define output parameter p-time  as integer   no-undo .
       73     do
       74     on error undo, return error
       75     :
       76       define variable v-date1 as date      no-undo .
       77       define variable v-date2 as date      no-undo .
       78       define variable v-time  as integer   no-undo .
       79       assign
       80         v-date1 = today
       81         v-time  = time
       82         v-date2 = today
       83       .
       84       if v-date1 <> v-date2
       85       then do:
       86         assign
       87           v-date1 = today
       88           v-time  = v-time
       89         .
       90       end.
       91       assign
       92         p-today = v-date1
       93         p-time  = v-time
       94       .
       95     end.
       96   end.
       97   function cur-time-date returns character
       98   :
       99     return string(today, '99/99/9999':U) .
      100   end.
      101   function cur-time-mjd returns decimal
      102   :
      103     define variable v-date as date      no-undo .
      104     define variable v-time as integer   no-undo .
      105     run cur-time in this-procedure
      106       (output v-date
      107       ,output v-time
      108       ) .
      109     return integer(v-date) - 2400002 + (v-time / 86400) .
      110   end.
      111   function cur-time-get-ending-index returns integer
      112   (input p-number as integer
      113   )
      114   :
      115     if p-number < 0
      116     or p-number = ?
      117     then do:
      118       return 1 .
      119     end.
      120     define variable v-rest as integer   no-undo .
      121     assign
      122       p-number = p-number modulo 100
      123     .
      124     if p-number < 20
      125     then do:
      126       assign
      127         v-rest = p-number
      128       .
      129     end.
      130     else do:
      131       assign
      132         v-rest = p-number modulo 10
      133       .
      134     end.
      135     case v-rest :
      136       when 1
      137       then do:
      138         return 2 .
      139       end.
      140       when 2 or
      141       when 3 or
      142       when 4
      143       then do:
      144         return 3 .
      145       end.
      146       otherwise do:
      147         return 1 .
      148       end.
      149     end case .
      150   end.
      151   procedure cur-time-mjd-to-date :
      152      define input  parameter i-mjd-diff as decimal no-undo.
      153      define output parameter o-Date     as date    no-undo.
      154      define output parameter o-Time     as integer no-undo.
      155      define variable v-day-number as integer   no-undo .
      156      if    i-mjd-diff < 0
      157         or i-mjd-diff = ?
      158      then do:
      159         return "?" .
      160      end.
      161      assign
      162         v-day-number = truncate(i-mjd-diff,0).
      163         o-Date = date(v-day-number + 2400002).
      164         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      165     .
      166   end.
      167   function cur-time-mjd-to-string returns character
      168   (input p-mjd-diff as decimal
      169   )
      170   :
      171     define variable v-day-number as integer   no-undo .
      172     define variable v-seconds    as integer   no-undo .
      173     define variable v-hour       as integer   no-undo .
      174     define variable v-min        as integer   no-undo .
      175     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      176     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      177     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      178     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      179     if p-mjd-diff < 0
      180     or p-mjd-diff = ?
      181     then do:
      182       return "?" .
      183     end.
      184     assign
      185       v-day-number = integer(truncate(p-mjd-diff,0))
      186       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      187     .
      188     if v-seconds > 86400
      189     then do:
      190       assign
      191         v-seconds = 86400 - 1
      192       .
      193     end.
      194     if v-seconds < 0
      195     then do:
      196       assign
      197         v-seconds = 0
      198       .
      199     end.
      200     assign
      201       v-hour = truncate(v-seconds / 3600, 0)
      202     .
      203     assign
      204       v-seconds = v-seconds modulo 3600
      205     .
      206     assign
      207       v-min = truncate(v-seconds / 60, 0)
      208     .
      209     assign
      210       v-seconds = v-seconds modulo 60
      211     .
      212     return
      213         (if v-day-number <> 0
      214           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      215           else ""
      216         )
      217       + (if v-day-number <> 0 or v-hour <> 0
      218           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      219           else ""
      220         )
      221       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      222           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      223           else ""
      224         )
      225       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      226       .
      227   end.
      228   function cur-time-string returns character
      229   :
      230     define variable v-date as date      no-undo .
      231     define variable v-time as integer   no-undo .
      232     run cur-time in this-procedure
      233       (output v-date
      234       ,output v-time
      235       ) .
      236     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      237   end.
      238   function cur-time-string-sec returns character
      239   :
      240     define variable v-date as date      no-undo .
      241     define variable v-time as integer   no-undo .
      242     run cur-time in this-procedure
      243       (output v-date
      244       ,output v-time
      245       ) .
      246     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      247   end.
      248   function cur-time-custom  returns character
      249   (input p-prefix as character
      250   ,input p-date-format as character
      251   ,input p-delimiter as character
      252   ,input p-time-format as character
      253   ,input p-suffix as character
      254   )
      255   :
      256     define variable v-date as date      no-undo .
      257     define variable v-time as integer   no-undo .
      258     run cur-time in this-procedure
      259       (output v-date
      260       ,output v-time
      261       ) .
      262     return
      263       p-prefix
      264       + string(v-date, p-date-format)
      265       + p-delimiter
      266       + string(v-time, p-time-format)
      267       + p-suffix
      268       .
      269   end.
      270   function cur-time-print  returns character
      271   :
      272     define variable v-date as date      no-undo .
      273     define variable v-time as integer   no-undo .
      274     run cur-time in this-procedure
      275       (output v-date
      276       ,output v-time
      277       ) .
      278     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      279   end.
      280   function cur-time-datetime returns datetime
      281   :
      282     define variable v-char as character no-undo .
      283     define variable v-datetime as datetime no-undo .
      284     v-char = cur-time-string().
      285     v-datetime = datetime(v-char).
      286     return  v-datetime.
      287   end.
      288   function cur-time-string-msec returns character
      289   :
      290     define variable v-date as datetime  no-undo .
      291     v-date = now.
      292     return string(v-date) .
      293   end.
      294   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      295   function get-str-type returns character (input p-task-type as character ).
      296     define variable v-str as character no-undo .
      297     case p-task-type :
      298       when 'autonws':U then do:
      299         assign
      300           v-str = "связи с БД"
      301         .
      302       end.
      303       when 'autoarh':U then do:
      304         assign
      305           v-str = "расчета архивов по БД"
      306         .
      307       end.
      308       when 'autoexp':U then do:
      309         assign
      310           v-str = "экспорта по БД"
      311         .
      312       end.
      313       when 'autooxml':U then do:
      314         assign
      315           v-str = "OpenXML по БД"
      316         .
      317       end.
      318       when 'autogcd':U then do:
      319         assign
      320           v-str = "приема информации с касс по БД"
      321         .
      322       end.
      323       when 'autosale':U then do:
      324         assign
      325           v-str = "работы с документами продажи по БД"
      326         .
      327       end.
      328       when 'autosuz':U then do:
      329         assign
      330           v-str = "запуска отчетов по БД"
      331         .
      332       end.
      333       when 'autocbnk':U then do:
      334         assign
      335           v-str = "эксп/имп в КЛИЕНТ-БАНК"
      336         .
      337       end.
      338       when 'autofree':U then do:
      339         assign
      340           v-str = "выполнение произ.заданий"
      341         .
      342       end.
      343       when 'mercury':U then do:
      344         assign
      345           v-str = "обмена с ФГИС Меркурий по БД"
      346         .
      347       end.
      348       when 'hddtest':U then do:
      349         assign
      350           v-str = "мониторинга HDD по БД"
      351         .
      352       end.
      353       when 'is_motp':U then do:
      354         assign
      355           v-str = "обмена с ИС МОТП по БД"
      356         .
      357       end.
      358       when 'is_diadoc':U then do:
      359         assign
      360           v-str = "обмена с ИС Диадок по БД"
      361         .
      362       end.
      363       when 'is_diadoc':U then do:
      364         assign
      365           v-str = "выгрузки в ИС Президентский мониторинг по БД"
      366         .
      367       end.
      368       otherwise do:
      369         assign
      370           v-str = "экспорта по БД"
      371         .
      372       end.
      373     end.
      374     return v-str.
      375   end function.
      376   procedure push-abtpr :
      377     define input parameter parparentproc as handle    no-undo .
      378     define input parameter p-db-num      as integer   no-undo .
      379     define input parameter p-task-type   as character no-undo .
      380     define input parameter p-start-type  as character no-undo .
      381     define input parameter p-date        as date      no-undo .
      382     define input parameter p-time        as integer   no-undo .
      383     do
      384     on error undo, return error
      385     :
      386       define buffer buf_BatchProcess for ub.BatchProcess .
      387       define buffer buf_sys-ctrl     for ub.sys-ctrl .
      388       define variable v-curr-date as date      no-undo .
      389       define variable v-curr-time as integer   no-undo .
      390       define variable v-str       as character no-undo .
      391       define variable v-user-id   as character no-undo .
      392       run cur-time in this-procedure
      393         ( output v-curr-date
      394          ,output v-curr-time
      395         ) no-error.
      396       if error-status :error then do:
      397         return error substitute( "&1. Ошибка при определении текущей даты!", vss-include-info1 ).
      398       end.
      399       if p-date = ? then do:
      400         assign
      401           p-date = v-curr-date
      402         .
      403       end.
      404       if p-time = ? then do:
      405         assign
      406           p-time = v-curr-time
      407         .
      408       end.
      409       assign
      410         v-str = get-str-type( p-task-type )
      411       .
      412       if v-str = ? then do:
      413         return error substitute( "&1. НЕТ ОБРАБОТКИ АТРИБУТА &2!", vss-include-info1, p-task-type ).
      414       end.
      415       run get-userid in parparentproc
      416         ( output v-user-id
      417         ).
      418       find first buf_sys-ctrl no-lock .
      419       find first buf_BatchProcess no-lock
      420         where buf_BatchProcess.BP_Status   = 'N':U
      421           and buf_BatchProcess.BP_Type     = p-task-type
      422           and buf_BatchProcess.CharKey_One = string( p-db-num )
      423           and buf_BatchProcess.CharKey_Two = "auto":U
      424         no-error
      425       .
      426       if available buf_BatchProcess
      427         and ( buf_BatchProcess.BP_ExecSysDate < v-curr-date
      428               or (buf_BatchProcess.BP_ExecSysDate = v-curr-date
      429                   and buf_BatchProcess.BP_ExecSysTimeInt < v-curr-time
      430                   )
      431             )
      432       then do:
      433         return error substitute( "Автоматический режим &1 для БД &2 не запущен или в данный момент идет обработка!"
      434                                 ,v-str ,p-db-num
      435                               ).
      436       end.
      437       find first buf_BatchProcess exclusive-lock
      438         where buf_BatchProcess.BP_Status   = 'N':U
      439           and buf_BatchProcess.BP_Type     = p-task-type
      440           and buf_BatchProcess.CharKey_One = string( p-db-num )
      441           and buf_BatchProcess.CharKey_Two = p-start-type
      442         no-error
      443       .
      444       if not available buf_BatchProcess then do:
      445         create buf_BatchProcess.
      446         assign
      447           buf_BatchProcess.BatchProcess# = next-value (s-btpr, ub)
      448           buf_BatchProcess.BP_Status     = 'N':U
      449           buf_BatchProcess.BP_Type       = p-task-type
      450           buf_BatchProcess.CharKey_One   = string( p-db-num )
      451           buf_BatchProcess.CharKey_Two   = p-start-type
      452         .
      453       end.
      454       assign
      455         buf_BatchProcess.CharKey_Three     = string( buf_sys-ctrl.db-num ) + chr(3) + p-task-type + chr(3) + "-1":U
      456         buf_BatchProcess.User_ID           = v-user-id
      457         buf_BatchProcess.Key#_One          = (if p-start-type = "manual":U then 1 else 0)
      458         buf_BatchProcess.BP_SysDate        = v-curr-date
      459         buf_BatchProcess.BP_SysTimeInt     = v-curr-time
      460         buf_BatchProcess.BP_SysTime        = string(v-curr-time, 'HH:MM:SS':U)
      461         buf_BatchProcess.BP_ExecSysDate    = p-date
      462         buf_BatchProcess.BP_ExecSysTimeInt = p-time
      463         buf_BatchProcess.BP_ExecSysTime    = string(p-time, 'HH:MM:SS':U)
      464       .
      465     end.
      466     return.
      467   end procedure.
      468   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      469   DEFINE TEMP-TABLE temp-autotask NO-UNDO
