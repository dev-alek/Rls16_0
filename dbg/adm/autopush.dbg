      476   FIELD overtime AS LOGICAL
      477   FIELD corr as character
      478   INDEX pi IS UNIQUE PRIMARY
      479   db-num
      480   task-type
      481   .
      482   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      483   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
