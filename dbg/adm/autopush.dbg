      500   define new global shared variable g#library  as handle no-undo .
      501   define new global shared variable g#library2 as handle no-undo .
      502   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      503   define temp-table temp-schedule-free no-undo
      504   field free-id as character
      505   field free-task-name as character
      506   field proc-run-name as character
      507   field proc-param-edit-name as character
      508   field conf-param as character
      509   field is-gbd as logical
      510   field is-ubd as logical
      511   field enable-concurrent-0 as logical
      512   field enable-concurrent-db as logical
