      518   procedure schedule-attr-name :
      519   do
      520     on error undo, return error
      521     :
      522     define input  parameter p-code           as character no-undo .
      523     define output parameter p-type           as character no-undo .
      524     define output parameter p-format         as character no-undo .
      525     define output parameter p-label          as character no-undo .
      526     define output parameter p-user-can-edit  as logical   no-undo .
      527     define output parameter p-output-display as logical   no-undo .
      528     define output parameter p-other          as character no-undo .
      529       if index(p-code, chr(4)) > 0 then do:
      530         p-code = entry(1, p-code, chr(4)).
      531       end.
      532       case p-code :
      533               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      534               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      535               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      536               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      537               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      538               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      539               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      540               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      541               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      542         otherwise do:
      543           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      544         end.
      545       end.
      546     end.
      547   end procedure.
      548   procedure schedule-attr-tooltip :
      549   do
      550     on error undo, return error
      551     :
      552       define input  parameter p-code    as character no-undo .
      553       define output parameter p-tooltip as character no-undo .
      554       define output parameter p-label   as character no-undo .
      555       if index(p-code, chr(4)) > 0 then do:
      556         p-code = entry(1, p-code, chr(4)).
      557       end.
      558       case p-code :
      559               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      560               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      561               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      562               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      563               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      564               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      565               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      566               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      567               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      568         otherwise do:
      569               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      570         end.
      571       end.
      572     end.
      573   end procedure.
      574   procedure schedule-attr-value :
      575   do
      576   on error undo, return error return-value
      577   :
      578   define input parameter  p-cre-db-num as integer    no-undo.
      579   define input parameter  p-task-type  as character  no-undo.
      580   define input parameter  p-task-num   as integer    no-undo.
      581   define input parameter  p-code       as character  no-undo.
      582   define output parameter p-value      as character  no-undo.
      583   define output parameter p-type       as character  no-undo.
      584       define variable v-format         as character no-undo .
      585       define variable v-label          as character no-undo .
      586       define variable v-user-can-edit  as logical   no-undo .
      587       define variable v-output-display as logical   no-undo .
      588       define variable v-other          as character no-undo .
      589       define buffer buf_schedule-attr for ub.schedule-attr.
      590       run schedule-attr-name in this-procedure (
      591             input  p-code
      592           , output p-type
      593           , output v-format
      594           , output v-label
      595           , output v-user-can-edit
      596           , output v-output-display
      597           , output v-other
      598       ) no-error .
      599       if error-status :error
      600       then do:
      601           undo, return error return-value .
      602       end.
      603       if p-code begins ('schd-free-id':U + chr(4))
      604       and entry(2, p-code, chr(4)) = '':U then do:
      605         find first buf_schedule-attr no-lock
      606             where buf_schedule-attr.cre-db-num = p-cre-db-num
      607               and buf_schedule-attr.task-type  = p-task-type
      608               and buf_schedule-attr.task-num   = p-task-num
      609               and buf_schedule-attr.attr-code  begins p-code
      610         no-error .
      611       end.
      612       else do:
      613         find first buf_schedule-attr no-lock
      614             where buf_schedule-attr.cre-db-num = p-cre-db-num
      615               and buf_schedule-attr.task-type  = p-task-type
      616               and buf_schedule-attr.task-num   = p-task-num
      617               and buf_schedule-attr.attr-code  = p-code
      618         no-error .
      619       end.
      620       if available buf_schedule-attr
      621       then do:
      622           assign
      623               p-value = buf_schedule-attr.attr-value
      624           .
      625       end.
      626       else do:
      627         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      628            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      629         end.
      630         else do:
      631           assign
      632               p-value = if p-type = 'L':U then "no":U else ""
      633           .
      634         end.
      635       end.
      636   end.
      637   end procedure.
      638   procedure schedule-attr-write :
      639   do
      640   on error undo, return error
      641   :
      642   define input parameter p-cre-db-num  as integer   no-undo.
      643   define input parameter p-task-type   as character no-undo.
      644   define input parameter p-task-num    as integer   no-undo.
      645   define input parameter p-code        as character no-undo.
      646   define input parameter p-value       as character no-undo.
      647       define variable v-type              as character                no-undo.
      648       define variable v-format            as character                no-undo.
      649       define variable v-label             as character                no-undo.
      650       define variable v-user-can-edit     as logical                  no-undo.
      651       define variable v-output-display    as logical                  no-undo.
      652       define variable v-other             as character                no-undo.
      653       define buffer buf_schedule-attr for ub.schedule-attr .
      654       run schedule-attr-name in this-procedure (
      655             input  p-code
      656           , output v-type
      657           , output v-format
      658           , output v-label
      659           , output v-user-can-edit
      660           , output v-output-display
      661           , output v-other
      662       ) no-error.
      663       if error-status :error
      664       then do:
      665           undo, return error return-value.
      666       end.
      667       find first buf_schedule-attr exclusive-lock
      668            where buf_schedule-attr.cre-db-num = p-cre-db-num
      669              and buf_schedule-attr.task-type  = p-task-type
      670              and buf_schedule-attr.task-num   = p-task-num
      671              and buf_schedule-attr.attr-code  = p-code
      672       no-error.
      673       if not available buf_schedule-attr
      674       then do:
      675           create buf_schedule-attr.
      676           assign
      677             buf_schedule-attr.cre-db-num = p-cre-db-num
      678             buf_schedule-attr.task-type  = p-task-type
      679             buf_schedule-attr.task-num   = p-task-num
      680             buf_schedule-attr.attr-code  = p-code
      681             buf_schedule-attr.attr-value = p-value
      682           .
      683       end.
      684       else do:
      685           assign
      686               buf_schedule-attr.attr-value = p-value
      687           .
      688       end.
      689   end.
      690   end procedure.
      691   procedure schedule-attr-delete :
      692   do
      693   on error undo, return error
      694   :
      695   define input  parameter p-cre-db-num  as integer   no-undo.
      696   define input  parameter p-task-type   as character no-undo.
      697   define input  parameter p-task-num    as integer   no-undo.
      698   define input  parameter p-code        as character no-undo.
      699   define output parameter p-deleted     as logical   no-undo.
      700       define buffer buf_schedule-attr for ub.schedule-attr .
      701       define variable v-type              as character                no-undo.
      702       define variable v-format            as character                no-undo.
      703       define variable v-label             as character                no-undo.
      704       define variable v-user-can-edit     as logical                  no-undo.
      705       define variable v-output-display    as logical                  no-undo.
      706       define variable v-other             as character                no-undo.
      707       run schedule-attr-name in this-procedure (
      708             input p-code
      709           , output v-type
      710           , output v-format
      711           , output v-label
      712           , output v-user-can-edit
      713           , output v-output-display
      714           , output v-other
      715       ) no-error .
      716       if error-status :error
      717       then do:
      718           undo, return error return-value .
      719       end.
      720       find first buf_schedule-attr exclusive-lock
      721            where buf_schedule-attr.cre-db-num = p-cre-db-num
      722              and buf_schedule-attr.task-type  = p-task-type
      723              and buf_schedule-attr.task-num   = p-task-num
      724              and buf_schedule-attr.attr-code  = p-code
      725       no-error.
      726       if not available buf_schedule-attr
      727       then do:
      728           assign
      729               p-deleted = no
      730           .
      731       end.
      732       else do:
      733           delete buf_schedule-attr.
      734           assign
      735               p-deleted = yes
      736           .
      737       end.
      738   end.
      739   end procedure.
      740   procedure schedule-attr-news :
      741   do
      742   on error undo, return error
      743   :
      744       define input  parameter p-code           as character no-undo .
      745       define output parameter p-news           as logical   no-undo .
      746       if index(p-code, chr(4)) > 0 then do:
      747         p-code = entry(1, p-code, chr(4)).
      748       end.
      749       case p-code :
      750               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      751               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      752               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      753               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      754               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      755               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      756               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      757               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      758               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      759         otherwise do:
      760           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      761         end.
      762       end.
      763   end.
      764   end procedure.
      765   procedure schedule-attr-extract-logical :
      766   do
      767   on error undo, return error
      768   :
      769   define input  parameter p-parameter-number   as integer      no-undo.
      770   define input  parameter p-parameter-list     as character    no-undo.
      771   define output parameter p-parameter-value   as logical      no-undo.
      772       if num-entries( p-parameter-list ) > p-parameter-number - 1
      773       then do:
      774           assign
      775               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      776           .
      777       end.
      778       else do:
      779           assign
      780               p-parameter-value   = no
      781           .
      782       end.
      783   end.
      784   end procedure.
      785   procedure schedule-attr-get-free-id :
      786   do
      787   on error undo, return error return-value
      788   :
      789     define input  parameter p-cre-db-num  as integer   no-undo.
      790     define input  parameter p-task-type   as character no-undo.
      791     define input  parameter p-task-num    as integer   no-undo.
      792     define output parameter p-free-id     as character no-undo.
      793     define buffer buf_schedule-attr for ub.schedule-attr.
      794     find first buf_schedule-attr no-lock
      795         where buf_schedule-attr.cre-db-num = p-cre-db-num
      796           and buf_schedule-attr.task-type  = p-task-type
      797           and buf_schedule-attr.task-num   = p-task-num
      798           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      799     no-error .
      800     if available buf_schedule-attr then
      801     assign
      802     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      803     no-error
      804     .
      805   end.
      806   end procedure.
      807   procedure schedule-attr-get-free-props :
      808     define input parameter p-free-id as character no-undo .
      809     define output parameter p-value as character no-undo .
      810     define buffer buf_temp-schedule-free for temp-schedule-free.
      811     do
      812     on error undo, return error return-value
      813     :
      814       find first buf_temp-schedule-free no-lock no-error .
      815       if not available buf_temp-schedule-free then do:
      816         run schedule-attr-fill-free-props in this-procedure .
      817       end.
      818       find first buf_temp-schedule-free where
      819               buf_temp-schedule-free.free-id = p-free-id no-error.
      820       if available buf_temp-schedule-free then do:
      821         assign
      822         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      823                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      824                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      825                   buf_temp-schedule-free.conf-param           + chr(4) +
      826                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      827                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      828                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      829                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      830                   buf_temp-schedule-free.other-info
      831         .
      832       end.
      833       else do:
      834        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      835                              "id произвольной задачи - &5"
      836                              ,vss-workfile
      837                              ,vss-revision
      838                              ,vss-description
      839                              ,chr(10)
      840                              ,p-free-id).
      841       end.
      842     end.
      843   end procedure.
      844   procedure schedule-attr-is-rum-free-id :
      845   define input parameter p-free-id as character no-undo .
      846   define output parameter p-is-rum as logical no-undo .
      847   define buffer buf_temp-schedule-free for temp-schedule-free.
      848   do
      849   on error undo, return error
      850   :
      851       find first buf_temp-schedule-free no-lock no-error .
      852       if not available buf_temp-schedule-free then do:
      853         run schedule-attr-fill-free-props in this-procedure .
      854       end.
      855       find first buf_temp-schedule-free where
      856               buf_temp-schedule-free.free-id = p-free-id no-error.
      857       if available buf_temp-schedule-free
      858       and buf_temp-schedule-free.is-rum
      859       then do:
      860         p-is-rum = yes.
      861       end.
      862   end.
      863   end procedure.
      864   procedure schedule-attr-fill-free-props :
      865   define variable v-path                    as character                no-undo .
      866   DEFINE VARIABLE v-full-path               as character                no-undo .
      867   DEFINE VARIABLE v-file-name               as character                no-undo .
      868   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      869   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      870   define buffer buf_temp-schedule-free for temp-schedule-free.
      871   define variable v-answer as logical no-undo .
      872     do
      873     on error undo, return error substitute("&1 &2 &3&4&5&4"
      874                                           ,vss-workfile
      875                                           ,vss-revision
      876                                           ,vss-description
      877                                           ,chr(10)
      878                                           ,error-status:get-message(1) )
      879     :
      880       run gbl/filename.p (
      881                       input 'cmp/shd-free.d'
      882                     ,output v-full-path
      883                     ,output v-path
      884                     ,output v-file-name
      885                     ,output v-file-name-no-ext
      886                     ,output v-file-name-ext
      887                     ) .
      888       input from value(v-full-path).
      889       repeat :
      890         create buf_temp-schedule-free.
      891         import buf_temp-schedule-free.
      892       END.
      893       input close.
      894       _ff:
      895       for each buf_temp-schedule-free :
      896         if buf_temp-schedule-free.free-id = '':U then do:
      897            delete buf_temp-schedule-free.
      898            next _ff.
      899          end.
      900          run schedule-attr-check-enc in this-procedure (
      901                                                       input  buf_temp-schedule-free.free-id
      902                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      903                                                               buf_temp-schedule-free.proc-param-edit-name +
      904                                                               buf_temp-schedule-free.conf-param +
      905                                                               string(buf_temp-schedule-free.is-gbd) +
      906                                                               string(buf_temp-schedule-free.is-ubd) +
      907                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      908                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      909                                                               string(buf_temp-schedule-free.other-info)
      910                                                               )
      911                                                       ,input  buf_temp-schedule-free.enc-key
      912                                                       ,output v-answer    ) no-error .
      913          if error-status:error
      914          or not v-answer then delete buf_temp-schedule-free.
      915        end.
      916     end.
      917   end procedure.
      918   Function schedule-attr-reverse returns character (str as character).
      919      define variable rev_incl_s as character init "" no-undo .
      920      define variable rev_incl_i as integer no-undo .
      921      define variable rev_incl_l as integer no-undo .
      922      rev_incl_l = length(str).
      923      do rev_incl_i = 1 to rev_incl_l:
      924         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      925      end.
      926      return rev_incl_s.
      927   end.
      928   procedure schedule-attr-check-enc.
      929     define input  parameter p-free-id   as character no-undo .
      930     define input  parameter p-value     as character no-undo .
      931     define input  parameter p-enc-value as character no-undo .
      932     define output parameter p-answer    as logical   no-undo .
      933     define variable tmp         as character no-undo .
      934     define variable v-enc-value as character no-undo .
      935     assign
      936     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      937     .
      938     run schedule-attr-pswd-enc in this-procedure
      939       ( input tmp
      940        ,output v-enc-value
      941       ) no-error .
      942     if error-status:error then do:
      943       message
      944         vss-workfile vss-revision vss-description skip
      945         "Ошибка при вызове процедуры pswd-enc" skip
      946         return-value skip
      947         error-status :get-message(1) skip
      948         view-as alert-box error .
      949       undo, return error .
      950     end.
      951     if v-enc-value = p-enc-value then do:
      952       assign
      953         p-answer = true
      954       .
      955     end.
      956     else do:
      957       assign
      958         p-answer = false
      959       .
      960     end.
      961   end.
      962   procedure schedule-attr-conf-enc.
      963     define input  parameter p-free-id   as character no-undo .
      964     define input  parameter p-value     as character no-undo .
      965     define output parameter p-enc-value as character no-undo .
      966     define variable tmp         as character no-undo .
      967     assign
      968       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      969     .
      970     run schedule-attr-pswd-enc in this-procedure
      971       ( input tmp
      972        ,output p-enc-value
      973       ) no-error .
      974     if error-status:error then do:
      975       message
      976         vss-workfile vss-revision vss-description skip
      977         "Ошибка при вызове процедуры pswd-enc" skip
      978         return-value skip
      979         error-status :get-message(1) skip
      980         view-as alert-box error .
      981       undo, return error .
      982     end.
      983   end procedure.
      984   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      985   procedure schedule-attr-pswd-enc :
      986     define input parameter  pswd     as character no-undo .
      987     define output parameter enc-pswd as character no-undo .
      988     do
      989     on error undo, return error return-value
      990     :
      991       assign
      992         enc-pswd = encode(pswd + string(index(pswd, "k")))
      993       .
      994     end.
      995   end procedure.
      996   procedure proc-alt-shift-f2:
      997     if not ibs.th.gbl.gbl-var:rcode
      998   then
      999     run gbl\inidebug.p .
     1000   end.
     1001   procedure proc-alt-shift-f3:
     1002     run gbl/prvssinf.p
     1003       ( input this-procedure
     1004       ) .
     1005   end.
     1006   define variable v-inform-launched as logical no-undo initial false .
     1007   procedure proc-alt-shift-f4:
     1008     define variable v-action as character no-undo .
     1009     if v-inform-launched = false then do:
     1010       assign
     1011         v-inform-launched = true
     1012       .
     1013       run gbl/d-inform.w
     1014         (  input self
     1015         ,  input this-procedure
     1016         , output v-action
     1017         ) no-error .
     1018       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1019       assign
     1020         v-inform-launched = false
     1021       .
     1022     end.
     1023   end.
     1024   procedure proc-alt-f1:
     1025     run gbl/corrhelp.p
     1026       (input this-procedure
     1027       ) .
     1028   end .
     1029   on alt-shift-f2 anywhere do:
     1030     run proc-alt-shift-f2.
     1031   end.
     1032   on alt-shift-f3 anywhere do:
     1033     run proc-alt-shift-f3 in this-procedure .
     1034   end.
     1035   on alt-shift-f4 anywhere do:
     1036     run proc-alt-shift-f4 in this-procedure.
     1037   end.
     1038   on alt-f1 anywhere do:
     1039     run proc-alt-f1 in this-procedure .
     1040   end.
     1041   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1042     define variable v-cntxt-db-num        as integer   no-undo .
     1043     define variable v-cntxt-userid        as character no-undo .
     1044     define variable v-cntxt-level         as character no-undo .
     1045     define variable v-cntxt-host-code-obj as integer   no-undo .
     1046     define variable v-cntxt-obj-type      as character no-undo .
     1047     define variable v-cntxt-obj-code      as integer   no-undo .
     1048     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1049     define variable v-cntxt-is-admin      as logical   no-undo .
     1050   define buffer buf_db for ub.db .
     1051   define variable log-exit   as logical   no-undo .
     1052   define variable v-par-val  as character no-undo .
     1053   define variable v-par-type as character no-undo .
     1054   define variable par-is-bge as logical   no-undo .
     1055   define variable par-is-edi as character no-undo .
     1056   define variable par-type   as character no-undo .
     1057   define variable is-edi as logical   no-undo .
     1058   define variable line-row   as rowid     no-undo .
     1059   define variable v-c-date as date      no-undo .
     1060   define variable v-c-time as integer   no-undo .
     1061   DEFINE VARIABLE v-start AS LOGICAL NO-UNDO INIT YES.
     1062   DEFINE BUFFER buf_temp-autotask FOR temp-autotask.
     1063   DEFINE BUTTON b-do-now DEFAULT
     1064        LABEL "_ В&ыполнить"
     1065        SIZE 12 BY 1 TOOLTIP "Выполнить задание без учета расписания".
     1066   DEFINE BUTTON b-exit AUTO-END-KEY DEFAULT
     1067        LABEL "Вы&ход"
     1068        SIZE 10 BY 1 TOOLTIP "Выход"
     1069        BGCOLOR 8 .
     1070   DEFINE BUTTON b-help DEFAULT
     1071        LABEL "Помо&щь"
     1072        SIZE 10 BY 1 TOOLTIP "Помощь"
     1073        BGCOLOR 8 .
     1074   DEFINE BUTTON b-not-send DEFAULT
     1075        LABEL "Новости: Нет &подтверждений"
     1076        SIZE 28 BY 1 TOOLTIP "Просмотр неотправленной и неподтвержденний информации".
     1077   DEFINE BUTTON i-exit
     1078        IMAGE-UP FILE "cmp/i-run.bmp":U
     1079        IMAGE-DOWN FILE "cmp/i-run.bmp":U
     1080        IMAGE-INSENSITIVE FILE "cmp/i-rund.bmp":U
     1081        LABEL ""
     1082        SIZE 2.5 BY .75.
     1083   DEFINE QUERY BR-autotask FOR
     1084         temp-autotask SCROLLING.
     1085   DEFINE QUERY db-list FOR
     1086         buf_db SCROLLING.
     1087   DEFINE BROWSE BR-autotask
     1088     QUERY BR-autotask DISPLAY
     1089         temp-autotask.task-name FORMAT "X(18)" COLUMN-LABEL "Тип задания"
     1090   temp-autotask.date-time FORMAT "X(16)" COLUMN-LABEL "Очередной сеанс"
     1091   temp-autotask.overtime FORMAT "#/" COLUMN-LABEL "Не вып"
     1092   temp-autotask.corr FORMAT "X(3)" NO-LABEL
     1093       WITH NO-ROW-MARKERS SEPARATORS SIZE 52 BY 21.13 FIT-LAST-COLUMN.
     1094   DEFINE BROWSE db-list
     1095     QUERY db-list DISPLAY
     1096         buf_db.db-num
     1097   buf_db.db-name
     1098       WITH NO-ROW-MARKERS SEPARATORS SIZE 46 BY 21.13.
     1099   DEFINE FRAME autopush
     1100        b-exit AT ROW 1 COL 1
     1101        b-not-send AT ROW 1 COL 15
     1102        b-do-now AT ROW 1 COL 47
     1103        b-help AT ROW 1 COL 89
     1104        i-exit AT ROW 1.13 COL 47.13 WIDGET-ID 4
     1105        db-list AT ROW 2 COL 1
     1106        BR-autotask AT ROW 2 COL 47
     1107        SPACE(0.09) SKIP(0.36)
     1108       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1109            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1110            TITLE "Автоматические задания"
     1111            CANCEL-BUTTON b-exit.
     1112   ASSIGN
     1113          FRAME autopush:SCROLLABLE       = FALSE
     1114          FRAME autopush:HIDDEN           = TRUE.
     1115   ASSIGN
     1116          BR-autotask:HIDDEN  IN FRAME autopush                = TRUE.
     1117   ASSIGN
     1118          db-list:HIDDEN  IN FRAME autopush                = TRUE.
     1119   ON WINDOW-CLOSE OF FRAME autopush
     1120   DO:
     1121     APPLY "END-ERROR":U TO SELF.
     1122   END.
     1123   ON CHOOSE OF b-do-now IN FRAME autopush
     1124   DO:
     1125     DEFINE BUFFER buf_sys-ctrl FOR ub.sys-ctrl.
     1126     if not available buf_db then do:
     1127       message "Не выбрана база данных"
     1128         view-as alert-box error.
     1129       return no-apply.
     1130     end.
     1131     if not available temp-autotask then do:
     1132       message "Не выбрано автоматическое задание"
     1133         view-as alert-box error.
     1134       return no-apply.
     1135     end.
     1136     IF temp-autotask.task-type = 'autonws':U  THEN DO:
     1137         find first buf_sys-ctrl no-lock.
     1138         if buf_sys-ctrl.db-num <> 0
     1139           and buf_db.db-num <> 0
     1140         then do:
     1141           message "Обмен новостями возможен только с БД 0 !"
     1142             view-as alert-box error.
     1143           return no-apply.
     1144         end.
     1145         if buf_sys-ctrl.db-num = buf_db.db-num then do:
     1146           message "Обмен новостями с текущей БД невозможен!"
     1147             view-as alert-box error.
     1148           return no-apply.
     1149         end.
     1150     END.
     1151     run write-new-bp in this-procedure
     1152       ( input temp-autotask.task-type
     1153        ,input buf_db.db-num
     1154       ) no-error.
     1155     if error-status :error then do:
     1156       return no-apply.
     1157     end.
     1158   END.
     1159   ON CHOOSE OF b-exit IN FRAME autopush
     1160   DO:
     1161     assign
     1162       log-exit = true
     1163     .
     1164   END.
     1165   ON CHOOSE OF b-not-send IN FRAME autopush
     1166   DO:
     1167     IF NOT AVAILABLE buf_db THEN DO:
     1168       message "Не выбрана база данных"
     1169       view-as alert-box error.
     1170       return no-apply.
     1171     END.
     1172     run nws/v-route.w
     1173       ( input parparentproc
     1174       , input buf_db.db-num
     1175       ) .
     1176   END.
     1177   ON ROW-DISPLAY OF BR-autotask IN FRAME autopush
     1178   DO:
     1179     IF AVAIL temp-autotask THEN DO:
     1180       RUN set-row-color.
     1181     END.
     1182   END.
     1183   ON VALUE-CHANGED OF db-list IN FRAME autopush
     1184   DO:
     1185     RUN fill-autotask IN THIS-PROCEDURE ( input buf_db.db-num).
     1186     OPEN QUERY br-autotask FOR EACH temp-autotask NO-LOCK WHERE
     1187                                     temp-autotask.db-num = buf_db.db-num.
     1188     reposition BR-autotask to rowid line-row no-error .
     1189   END.
     1190   ON VALUE-CHANGED OF br-autotask IN FRAME autopush
     1191   DO:
     1192     if available temp-autotask
     1193     then
     1194     line-row = rowid(temp-autotask) .
     1195   END.
     1196   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1197   on help of frame autopush
     1198   do:
     1199     run gbl/app_help.p
     1200       (input this-procedure :file-name
     1201       ,input ''
     1202       ,input ?
     1203       ) no-error.
     1204     if error-status :error then do:
     1205       message
     1206         "Ошибка при вызове помощи"
     1207         error-status :get-message(1)
     1208         view-as alert-box .
     1209     end.
     1210   end.
     1211   run minbtn-set in this-procedure .
     1212   on choose of b-help in frame autopush
     1213   do:
     1214     apply "help":u to frame autopush .
     1215   end.
     1216   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1217   procedure minbtn-set :
     1218       do
     1219           on error undo, return error return-value
     1220           :
     1221           define variable ii              as integer       no-undo .
     1222           define variable fh              as widget-handle no-undo .
     1223           define variable hh              as widget-handle no-undo .
     1224           define variable v-h             as handle        extent 4 no-undo .
     1225           define variable v-name-button   as character     no-undo .
     1226           define variable v-help-old-x    as decimal       no-undo .
     1227           define variable v-help-old-y    as decimal       no-undo .
     1228           define variable v-help-old-size as decimal       no-undo .
     1229           define variable v-frame-width   as decimal       no-undo .
     1230           define variable jj              as integer       no-undo .
     1231           do
     1232               on error undo, return error
     1233               :
     1234               assign
     1235                   v-frame-width = frame autopush:width - 0.3
     1236                   fh            = frame autopush:first-child
     1237                   hh            = fh:first-child
     1238                   ii            = 1
     1239                   .
     1240               do while valid-handle(hh):
     1241                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1242                   do:
     1243                       case lc(hh:name) :
     1244                           when "b-help" then
     1245                               do:
     1246                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1247                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1248                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1249                                   hh:TOOLTIP = "Помощь" .
     1250                                   v-help-old-x = hh:column .
     1251                                   v-help-old-y = hh:row    .
     1252                                   v-help-old-size = hh:width .
     1253                                   hh:width-chars = 2.5 .
     1254                               end.
     1255                           when "b-print" then
     1256                               do:
     1257                                   hh:load-image("cmp/b-print.bmp":u) .
     1258                                   hh:TOOLTIP = "Печать" .
     1259                                   v-h[ii] = hh:handle .
     1260                                   ii = ii + 1 .
     1261                                   hh:width-chars = 3 .
     1262                               end.
     1263                           when "b-history" or
     1264                           when "b-hist" then
     1265                               do:
     1266                                   hh:load-image("cmp/b-hist.bmp":u) .
     1267                                   hh:TOOLTIP = "История" .
     1268                                   v-h[ii] = hh:handle .
     1269                                   ii = ii + 1 .
     1270                                   hh:width-chars = 3 .
     1271                               end.
     1272                           when "b-sch" then
     1273                               do:
     1274                                   hh:load-image("cmp/b-sch.bmp":u) .
     1275                                   hh:TOOLTIP = "Установка Фильтра" .
     1276                                   v-h[ii] = hh:handle .
     1277                                   ii = ii + 1 .
     1278                                   hh:width-chars = 3 .
     1279                               end.
     1280                           when "b-hist-user" then
     1281                               do:
     1282                                   hh:load-image("cmp/b-hist.bmp":u) .
     1283                                   hh:TOOLTIP = "История пользователя" .
     1284                                   ii = ii + 1 .
     1285                               end.
     1286                       end case.
     1287                   end.
     1288                   hh = hh:next-sibling.
     1289               end.
     1290               b-help:column = v-frame-width - b-help:width-chars.
     1291               jj = 0.
     1292               repeat ii = 4 to 1 by -1 :
     1293                   if valid-handle (v-h[ii] ) then
     1294                   do:
     1295                       jj  = jj + 1 .
     1296                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1297                       v-h[ii]:row    = v-help-old-y .
     1298                   end.
     1299               end.
     1300           end.
     1301       end.
     1302   end procedure.
     1303   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1304   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1305   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1306   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1307   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1308   define variable v-diasize-current-frame-height as decimal   no-undo .
     1309   define variable v-diasize-change-size          as logical   no-undo .
     1310   define variable v-diasize-resize-button        as handle    no-undo .
     1311   define variable v-diasize-wndmax               as logical   no-undo .
     1312   define variable v-diasize-wndstore             as logical   no-undo .
     1313   define variable v-diasize-proc-name            as character no-undo .
     1314   define variable v-diasize-browse-handle        as handle    no-undo .
     1315   define variable v-diasize-browse-number        as integer   no-undo .
     1316   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1317   define temp-table temp-diasize-handle no-undo
     1318     field handle-value  as handle
     1319     field save-position as decimal
     1320     index xpk is primary unique handle-value
     1321     .
     1322   define temp-table temp-browse-handle no-undo
     1323     field browse-type   as character
     1324     field browse-number as integer
     1325     field browse-handle as handle
     1326     field original-size as decimal
     1327     index xpk is primary unique browse-type browse-number
     1328     index xie browse-type browse-handle
     1329   .
     1330   procedure diasize_change-height :
     1331     define input  parameter p-change-value  as decimal   no-undo .
     1332     define input  parameter p-move-resize   as logical   no-undo .
     1333     define variable v-field-group-handle    as handle    no-undo .
     1334     define variable v-object-handle         as handle    no-undo .
     1335     define variable v-frame-height          as decimal   no-undo .
     1336     define variable v-frame-virtual-height  as decimal   no-undo .
     1337     define variable v-browse-height         as decimal   no-undo .
     1338     define variable v-window-height         as decimal   no-undo .
     1339     define variable v-window-virtual-height as decimal   no-undo .
     1340     define variable v-change-sign           as integer   no-undo .
     1341     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1342     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1343     if p-change-value > 0
     1344     then do:
     1345       if frame autopush :height + p-change-value
     1346           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1347       then do:
     1348         assign
     1349           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1350                           - (frame autopush :height-chars)
     1351         .
     1352         if p-change-value <= 0
     1353         then do:
     1354           run diasize_position-resize-button in this-procedure .
     1355           return .
     1356         end.
     1357       end.
     1358     end.
     1359     if p-change-value < 0
     1360     then do:
     1361       if frame autopush :height + p-change-value < v-diasize-orig-frame-height
     1362       then do:
     1363         assign
     1364           p-change-value = v-diasize-orig-frame-height
     1365                          - (frame autopush :height-chars)
     1366         .
     1367         if p-change-value >= 0
     1368         then do:
     1369           run diasize_position-resize-button in this-procedure .
     1370           return .
     1371         end.
     1372       end.
     1373     end.
     1374     if p-change-value >= 0
     1375     then do:
     1376       assign
     1377         v-change-sign = 1
     1378       .
     1379     end.
     1380     else do:
     1381       assign
     1382         v-change-sign = -1
     1383       .
     1384     end.
     1385     assign
     1386       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1387     .
     1388     if p-change-value = 0
     1389     then do:
     1390       run diasize_position-resize-button in this-procedure .
     1391       return .
     1392     end.
     1393     move_block:
     1394     do
     1395     on error undo move_block, retry move_block
     1396     :
     1397       if retry
     1398       then do:
     1399         do
     1400         on error undo move_block, leave move_block
     1401         :
     1402           if p-change-value > 0
     1403           then do:
     1404             for each buf_temp-diasize-handle
     1405             on error undo, next
     1406             :
     1407               assign
     1408                 v-object-handle = buf_temp-diasize-handle.handle-value
     1409               .
     1410               if v-object-handle <> v-diasize-resize-button
     1411               then do:
     1412                 assign
     1413                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1414                 .
     1415               end.
     1416             end.
     1417             assign
     1418               v-diasize-browse-handle :height = v-browse-height
     1419             .
     1420             for each buf_temp-browse-handle
     1421               where buf_temp-browse-handle.browse-type = 'height':u
     1422             on error undo, next
     1423             :
     1424               assign
     1425                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1426               .
     1427             end.
     1428             assign
     1429               frame autopush :height = v-frame-height
     1430             .
     1431             if frame autopush :scrollable = true
     1432             then do:
     1433               assign
     1434                 frame autopush :virtual-height = v-frame-virtual-height
     1435               .
     1436             end.
     1437             run diasize_position-resize-button in this-procedure .
     1438           end.
     1439           else do:
     1440             if frame autopush :scrollable = true
     1441             then do:
     1442               assign
     1443                 frame autopush :virtual-height = v-frame-virtual-height
     1444               .
     1445             end.
     1446             assign
     1447               frame autopush :height = v-frame-height
     1448             .
     1449             assign
     1450               v-diasize-browse-handle :height = v-browse-height
     1451             .
     1452             for each buf_temp-browse-handle
     1453               where buf_temp-browse-handle.browse-type = 'height':u
     1454             on error undo, next
     1455             :
     1456               assign
     1457                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1458               .
     1459             end.
     1460             for each buf_temp-diasize-handle
     1461             on error undo, next
     1462             :
     1463               assign
     1464                 v-object-handle = buf_temp-diasize-handle.handle-value
     1465               .
     1466               if v-object-handle <> v-diasize-resize-button
     1467               then do:
     1468                 assign
     1469                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1470                 .
     1471               end.
     1472             end.
     1473             run diasize_position-resize-button in this-procedure .
     1474           end.
     1475           assign
     1476             v-diasize-change-size = false
     1477           .
     1478           leave move_block .
     1479         end.
     1480       end.
     1481       assign
     1482         v-diasize-need-full-display = true
     1483       .
     1484       if v-diasize-change-size = false
     1485       then do:
     1486         assign
     1487           v-diasize-change-size = true
     1488         .
     1489       end.
     1490       else do:
     1491         return .
     1492       end.
     1493       assign
     1494         v-frame-height = frame autopush :height
     1495         v-frame-virtual-height = frame autopush :virtual-height
     1496         v-browse-height = v-diasize-browse-handle :height
     1497       .
     1498       for each buf_temp-browse-handle
     1499         where buf_temp-browse-handle.browse-type = 'height':u
     1500       :
     1501         assign
     1502           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1503         .
     1504       end.
     1505       for each buf_temp-diasize-handle
     1506       :
     1507         delete buf_temp-diasize-handle .
     1508       end.
     1509       assign
     1510         v-field-group-handle = frame autopush :first-child
     1511       .
     1512       do while valid-handle(v-field-group-handle)
     1513       :
     1514         assign
     1515           v-object-handle = v-field-group-handle :first-child
     1516         .
     1517         do while valid-handle(v-object-handle)
     1518         :
     1519           if  v-object-handle <> v-diasize-browse-handle :handle
     1520           and can-query(v-object-handle, "row")
     1521           and can-query(v-object-handle, "height")
     1522           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1523           then do:
     1524             find first buf_temp-browse-handle
     1525               where buf_temp-browse-handle.browse-type   = 'height':u
     1526                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1527               no-error .
     1528             if available buf_temp-browse-handle
     1529             then do:
     1530             end.
     1531             else do:
     1532               create buf_temp-diasize-handle .
     1533               assign
     1534                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1535                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1536               .
     1537             end.
     1538           end.
     1539           assign
     1540             v-object-handle = v-object-handle :next-sibling
     1541           .
     1542         end.
     1543         assign
     1544           v-field-group-handle = v-field-group-handle :next-sibling
     1545         .
     1546       end.
     1547       do with frame autopush
     1548       :
     1549         hide v-diasize-resize-button .
     1550         assign
     1551           v-diasize-resize-button :row    = 1
     1552           v-diasize-resize-button :column = 1
     1553         .
     1554       end.
     1555       if p-change-value > 0
     1556       then do:
     1557         if frame autopush :scrollable = true
     1558         then do:
     1559           assign
     1560             frame autopush :virtual-height = frame autopush :virtual-height + p-change-value
     1561             no-error .
     1562           if error-status :error
     1563           or error-status :get-message(1) <> ""
     1564           then do:
     1565             undo move_block, retry move_block .
     1566           end.
     1567         end.
     1568         assign
     1569           frame autopush :height = frame autopush :height + p-change-value
     1570           no-error .
     1571         if error-status :error
     1572         or error-status :get-message(1) <> ""
     1573         then do:
     1574           undo move_block, retry move_block .
     1575         end.
     1576         assign
     1577           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1578           no-error .
     1579         if error-status :error
     1580         or error-status :get-message(1) <> ""
     1581         then do:
     1582           undo move_block, retry move_block .
     1583         end.
     1584         for each buf_temp-browse-handle
     1585           where buf_temp-browse-handle.browse-type = 'height':u
     1586         on error undo move_block, retry move_block
     1587         :
     1588           assign
     1589             buf_temp-browse-handle.browse-handle :height
     1590               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1591             no-error .
     1592           if error-status :error
     1593           or error-status :get-message(1) <> ""
     1594           then do:
     1595             undo move_block, retry move_block .
     1596           end.
     1597         end.
     1598         for each buf_temp-diasize-handle
     1599         on error undo move_block, retry move_block
     1600         :
     1601           assign
     1602             v-object-handle = buf_temp-diasize-handle.handle-value
     1603           .
     1604           if v-object-handle <> v-diasize-resize-button
     1605           then do:
     1606             assign
     1607               v-object-handle :row = v-object-handle :row + p-change-value
     1608               no-error .
     1609             if error-status :error
     1610             or error-status :get-message(1) <> ""
     1611             then do:
     1612               undo move_block, retry move_block .
     1613             end.
     1614           end.
     1615         end.
     1616       end.
     1617       else do:
     1618         for each buf_temp-diasize-handle
     1619         on error undo move_block, retry move_block
     1620         :
     1621           assign
     1622             v-object-handle = buf_temp-diasize-handle.handle-value
     1623           .
     1624           if v-object-handle <> v-diasize-resize-button
     1625           then do:
     1626             assign
     1627               v-object-handle :row = v-object-handle :row + p-change-value
     1628               no-error .
     1629             if error-status :error
     1630             or error-status :get-message(1) <> ""
     1631             then do:
     1632               undo move_block, retry move_block .
     1633             end.
     1634           end.
     1635         end.
     1636         assign
     1637           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1638           no-error .
     1639         if error-status :error
     1640         or error-status :get-message(1) <> ""
     1641         then do:
     1642           undo move_block, retry move_block .
     1643         end.
     1644         for each buf_temp-browse-handle
     1645           where buf_temp-browse-handle.browse-type = 'height':u
     1646         on error undo move_block, retry move_block
     1647         :
     1648           assign
     1649             buf_temp-browse-handle.browse-handle :height
     1650               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1651             no-error .
     1652           if error-status :error
     1653           or error-status :get-message(1) <> ""
     1654           then do:
     1655             undo move_block, retry move_block .
     1656           end.
     1657         end.
     1658         assign
     1659           frame autopush :height = frame autopush :height + p-change-value
     1660           no-error .
     1661         if error-status :error
     1662         or error-status :get-message(1) <> ""
     1663         then do:
     1664           undo move_block, retry move_block .
     1665         end.
     1666         if frame autopush :scrollable = true
     1667         then do:
     1668           assign
     1669             frame autopush :virtual-height = frame autopush :virtual-height + p-change-value
     1670             no-error .
     1671           if error-status :error
     1672           or error-status :get-message(1) <> ""
     1673           then do:
     1674             undo move_block, retry move_block .
     1675           end.
     1676         end.
     1677       end.
     1678       if p-move-resize = true
     1679       then do:
     1680         run diasize_position-resize-button in this-procedure .
     1681       end.
     1682       if v-diasize-wndstore = true
     1683       then do:
     1684         if connected("ub") = true
     1685         then do:
     1686           define variable v-cntxt-db-num        as integer   no-undo .
     1687           define variable v-cntxt-userid        as character no-undo .
     1688           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1689                                             , OUTPUT v-cntxt-userid
     1690                                             ) .
     1691           run gbl/wndsizew.p
     1692             (input  v-cntxt-db-num
     1693             ,input  v-cntxt-userid
     1694             ,input  v-diasize-proc-name
     1695             ,input  'height':u
     1696             ,input  string(frame autopush :height - v-diasize-orig-frame-height)
     1697             ) .
     1698         end.
     1699       end.
     1700     end.
     1701     assign
     1702       v-diasize-change-size = false
     1703     .
     1704   end procedure.
     1705   procedure diasize_set-height :
     1706     define input  parameter p-new-height  as decimal   no-undo .
     1707     define input  parameter p-move-resize as logical   no-undo .
     1708     do
     1709     on error undo, return error return-value
     1710     :
     1711       run diasize_change-height in this-procedure
     1712         (input  (p-new-height - frame autopush :height)
     1713         ,input  p-move-resize
     1714         ) .
     1715     end.
     1716   end procedure.
     1717   procedure diasize_change-width :
     1718     define input  parameter p-change-value as decimal   no-undo .
     1719     define input  parameter p-move-resize  as logical   no-undo .
     1720     define variable v-field-group-handle   as handle    no-undo .
     1721     define variable v-object-handle        as handle    no-undo .
     1722     define variable v-frame-width          as decimal   no-undo .
     1723     define variable v-frame-virtual-width  as decimal   no-undo .
     1724     define variable v-browse-width         as decimal   no-undo .
     1725     define variable v-window-width         as decimal   no-undo .
     1726     define variable v-window-virtual-width as decimal   no-undo .
     1727     define variable v-change-sign          as integer   no-undo .
     1728     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1729     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1730     if p-change-value > 0
     1731     then do:
     1732       if frame autopush :width + p-change-value >
     1733           session :width-chars
     1734       then do:
     1735         assign
     1736           p-change-value = session :width-chars - frame autopush :width
     1737         .
     1738         if p-change-value <= 0
     1739         then do:
     1740           run diasize_position-resize-button in this-procedure .
     1741           return .
     1742         end.
     1743       end.
     1744     end.
     1745     if p-change-value < 0
     1746     then do:
     1747       if frame autopush :width + p-change-value < v-diasize-orig-frame-width
     1748       then do:
     1749         assign
     1750           p-change-value = v-diasize-orig-frame-width
     1751                          - frame autopush :width
     1752         .
     1753         if p-change-value >= 0
     1754         then do:
     1755           run diasize_position-resize-button in this-procedure .
     1756           return .
     1757         end.
     1758       end.
     1759     end.
     1760     if p-change-value >= 0
     1761     then do:
     1762       assign
     1763         v-change-sign = 1
     1764       .
     1765     end.
     1766     else do:
     1767       assign
     1768         v-change-sign = -1
     1769       .
     1770     end.
     1771     assign
     1772       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1773     .
     1774     if p-change-value = 0
     1775     then do:
     1776       run diasize_position-resize-button in this-procedure .
     1777       return .
     1778     end.
     1779     move_block:
     1780     do
     1781     on error undo move_block, leave move_block
     1782     :
     1783       if retry
     1784       then do:
     1785         do
     1786         on error undo move_block, leave move_block
     1787         :
     1788           if p-change-value > 0
     1789           then do:
     1790             for each buf_temp-diasize-handle
     1791             on error undo, next
     1792             :
     1793               assign
     1794                 v-object-handle = buf_temp-diasize-handle.handle-value
     1795               .
     1796               if v-object-handle <> v-diasize-resize-button
     1797               then do:
     1798                 assign
     1799                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1800                 .
     1801               end.
     1802             end.
     1803             assign
     1804               v-diasize-browse-handle :width = v-browse-width
     1805             .
     1806             for each buf_temp-browse-handle
     1807               where buf_temp-browse-handle.browse-type = 'width':u
     1808             on error undo, next
     1809             :
     1810               assign
     1811                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1812               .
     1813             end.
     1814             assign
     1815               frame autopush :width = v-frame-width
     1816             .
     1817             if frame autopush :scrollable = true
     1818             then do:
     1819               assign
     1820                 frame autopush :virtual-width = v-frame-virtual-width
     1821               .
     1822             end.
     1823             run diasize_position-resize-button in this-procedure .
     1824           end.
     1825           else do:
     1826             if frame autopush :scrollable = true
     1827             then do:
     1828               assign
     1829                 frame autopush :virtual-width = v-frame-virtual-width
     1830               .
     1831             end.
     1832             assign
     1833               frame autopush :width = v-frame-width
     1834             .
     1835             for each buf_temp-browse-handle
     1836               where buf_temp-browse-handle.browse-type = 'width':u
     1837             on error undo, next
     1838             :
     1839               assign
     1840                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1841               .
     1842             end.
     1843             assign
     1844               v-diasize-browse-handle :width = v-browse-width
     1845             .
     1846             for each buf_temp-diasize-handle
     1847             on error undo, next
     1848             :
     1849               assign
     1850                 v-object-handle = buf_temp-diasize-handle.handle-value
     1851               .
     1852               if v-object-handle <> v-diasize-resize-button
     1853               then do:
     1854                 assign
     1855                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1856                 .
     1857               end.
     1858             end.
     1859             run diasize_position-resize-button in this-procedure .
     1860           end.
     1861           assign
     1862             v-diasize-change-size = false
     1863           .
     1864           leave move_block .
     1865         end.
     1866       end.
     1867       assign
     1868         v-diasize-need-full-display = true
     1869       .
     1870       if v-diasize-change-size = false
     1871       then do:
     1872         assign
     1873           v-diasize-change-size = true
     1874         .
     1875       end.
     1876       else do:
     1877         return .
     1878       end.
     1879       assign
     1880         v-frame-width = frame autopush :width
     1881         v-frame-virtual-width = frame autopush :virtual-width
     1882         v-browse-width = v-diasize-browse-handle :width
     1883       .
     1884       for each buf_temp-browse-handle
     1885         where buf_temp-browse-handle.browse-type = 'width':u
     1886       :
     1887         assign
     1888           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1889         .
     1890       end.
     1891       for each buf_temp-diasize-handle
     1892       :
     1893         delete buf_temp-diasize-handle .
     1894       end.
     1895       assign
     1896         v-field-group-handle = frame autopush :first-child
     1897       .
     1898       do while valid-handle(v-field-group-handle)
     1899       :
     1900         assign
     1901           v-object-handle = v-field-group-handle :first-child
     1902         .
     1903         do while valid-handle(v-object-handle)
     1904         :
     1905           if  v-object-handle <> v-diasize-browse-handle :handle
     1906           and v-object-handle <> v-diasize-resize-button
     1907           and can-query(v-object-handle, "row")
     1908           and can-query(v-object-handle, "height")
     1909           and ( v-object-handle :col + v-object-handle :width
     1910                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1911               )
     1912           then do:
     1913             find first buf_temp-browse-handle
     1914               where buf_temp-browse-handle.browse-type   = 'width':u
     1915                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1916               no-error .
     1917             if available buf_temp-browse-handle
     1918             then do:
     1919             end.
     1920             else do:
     1921               create buf_temp-diasize-handle .
     1922               assign
     1923                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1924                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1925               .
     1926             end.
     1927           end.
     1928           assign
     1929             v-object-handle = v-object-handle :next-sibling
     1930           .
     1931         end.
     1932         assign
     1933           v-field-group-handle = v-field-group-handle :next-sibling
     1934         .
     1935       end.
     1936       do with frame autopush
     1937       :
     1938         hide v-diasize-resize-button .
     1939         v-diasize-resize-button :row = 1.
     1940         v-diasize-resize-button :column = 1.
     1941       end.
     1942       if p-change-value > 0
     1943       then do:
     1944         if frame autopush :scrollable = true
     1945         then do:
     1946           assign
     1947             frame autopush :virtual-width = frame autopush :virtual-width + p-change-value
     1948             no-error .
     1949           if error-status :error
     1950           or error-status :get-message(1) <> ""
     1951           then do:
     1952             undo move_block, retry move_block.
     1953           end.
     1954         end.
     1955         assign
     1956           frame autopush :width = v-frame-width + p-change-value
     1957           no-error .
     1958         if error-status :error
     1959         or error-status :get-message(1) <> ""
     1960         then do:
     1961           undo move_block, retry move_block.
     1962         end.
     1963         assign
     1964           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1965         no-error .
     1966         if error-status :error
     1967         or error-status :get-message(1) <> ""
     1968         then do:
     1969           undo move_block, retry move_block.
     1970         end.
     1971         for each buf_temp-browse-handle
     1972           where buf_temp-browse-handle.browse-type = 'width':u
     1973         on error undo move_block, retry move_block
     1974         :
     1975           assign
     1976             buf_temp-browse-handle.browse-handle :width
     1977               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1978             no-error .
     1979           if error-status :error
     1980           or error-status :get-message(1) <> ""
     1981           then do:
     1982             undo move_block, retry move_block .
     1983           end.
     1984         end.
     1985         for each buf_temp-diasize-handle
     1986         on error undo move_block, retry move_block
     1987         :
     1988           assign
     1989             v-object-handle = buf_temp-diasize-handle.handle-value
     1990           .
     1991           if v-object-handle <> v-diasize-resize-button
     1992           then do:
     1993             assign
     1994               v-object-handle :col = v-object-handle :col + p-change-value
     1995               no-error .
     1996             if error-status :error
     1997             or error-status :get-message(1) <> ""
     1998             then do:
     1999               undo move_block, retry move_block .
     2000             end.
     2001           end.
     2002         end.
     2003       end.
     2004       else do:
     2005         for each buf_temp-diasize-handle
     2006         on error undo move_block, retry move_block
     2007         :
     2008           assign
     2009             v-object-handle = buf_temp-diasize-handle.handle-value
     2010           .
     2011           if v-object-handle <> v-diasize-resize-button
     2012           then do:
     2013             assign
     2014               v-object-handle :col = v-object-handle :col + p-change-value
     2015               no-error .
     2016             if error-status :error
     2017             or error-status :get-message(1) <> ""
     2018             then do:
     2019               undo move_block, retry move_block .
     2020             end.
     2021           end.
     2022         end.
     2023         for each buf_temp-browse-handle
     2024           where buf_temp-browse-handle.browse-type = 'width':u
     2025         on error undo move_block, retry move_block
     2026         :
     2027           assign
     2028             buf_temp-browse-handle.browse-handle :width
     2029               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2030             no-error .
     2031           if error-status :error
     2032           or error-status :get-message(1) <> ""
     2033           then do:
     2034             undo move_block, retry move_block .
     2035           end.
     2036         end.
     2037         assign
     2038           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2039           no-error .
     2040         if error-status :error
     2041         or error-status :get-message(1) <> ""
     2042         then do:
     2043           undo move_block, retry move_block.
     2044         end.
     2045         assign
     2046           frame autopush :width = frame autopush :width + p-change-value
     2047         no-error .
     2048         if error-status :error
     2049         or error-status :get-message(1) <> ""
     2050         then do:
     2051           undo move_block, retry move_block.
     2052         end.
     2053         if frame autopush :scrollable = true
     2054         then do:
     2055           assign
     2056             frame autopush :virtual-width = frame autopush :virtual-width + p-change-value
     2057           no-error .
     2058           if error-status :error
     2059           or error-status :get-message(1) <> ""
     2060           then do:
     2061             undo move_block, retry move_block.
     2062           end.
     2063         end.
     2064       end.
     2065       if p-move-resize
     2066       then do:
     2067         run diasize_position-resize-button in this-procedure .
     2068       end.
     2069       if v-diasize-wndstore = true
     2070       then do:
     2071         if connected("ub") = true
     2072         then do:
     2073           define variable v-cntxt-db-num        as integer   no-undo .
     2074           define variable v-cntxt-userid        as character no-undo .
     2075           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2076                                             , OUTPUT v-cntxt-userid
     2077                                             ) .
     2078           run gbl/wndsizew.p
     2079             (input  v-cntxt-db-num
     2080             ,input  v-cntxt-userid
     2081             ,input  v-diasize-proc-name
     2082             ,input  'width':u
     2083             ,input  string(frame autopush :width - v-diasize-orig-frame-width)
     2084             ) .
     2085         end.
     2086       end.
     2087     end.
     2088     assign
     2089       v-diasize-change-size = false
     2090     .
     2091   end procedure.
     2092   procedure diasize_set-width :
     2093     define input  parameter p-new-width  as decimal   no-undo .
     2094     define input  parameter p-move-resize as logical   no-undo .
     2095     do
     2096     on error undo, return error return-value
     2097     :
     2098       run diasize_change-width in this-procedure
     2099         (input  (p-new-width - frame autopush :width)
     2100         ,input  p-move-resize
     2101         ) .
     2102     end.
     2103   end procedure.
     2104   procedure diasize_position-resize-button :
     2105     do with frame autopush
     2106     :
     2107       hide v-diasize-resize-button .
     2108       assign
     2109         v-diasize-resize-button :row = frame autopush :height - v-diasize-resize-button :height
     2110                     - 1
     2111                     - (frame autopush :border-bottom-pixels / session :pixels-per-row)
     2112         v-diasize-resize-button :col = frame autopush :width - v-diasize-resize-button :width
     2113                     - 1
     2114                     - (frame autopush :border-right-pixels / session :pixels-per-column)
     2115       .
     2116       view v-diasize-resize-button .
     2117     end.
     2118   end procedure.
     2119   on alt-right anywhere
     2120   do:
     2121     run diasize_change-width in this-procedure
     2122       (input 1
     2123       ,input true
     2124       ) .
     2125     return no-apply .
     2126   end.
     2127   on alt-left anywhere
     2128   do:
     2129     run diasize_change-width in this-procedure
     2130       (input -1
     2131       ,input true
     2132       ) .
     2133     return no-apply .
     2134   end.
     2135   on alt-down anywhere
     2136   do:
     2137     run diasize_change-height in this-procedure
     2138       (input 1
     2139       ,input true
     2140       ) .
     2141     return no-apply .
     2142   end.
     2143   on alt-up anywhere
     2144   do:
     2145     run diasize_change-height in this-procedure
     2146       (input -1
     2147       ,input true
     2148       ) .
     2149     return no-apply .
     2150   end.
     2151   on alt-enter of frame autopush
     2152   do:
     2153     run diasize_maximize in this-procedure
     2154       (input  ?
     2155       ).
     2156     return no-apply .
     2157   end.
     2158   procedure diasize_end-move :
     2159     do
     2160     on error undo, return error return-value
     2161     :
     2162       define variable v-row-delta as decimal   no-undo .
     2163       define variable v-col-delta as decimal   no-undo .
     2164       define variable v-new-row as decimal   no-undo .
     2165       define variable v-new-col as decimal   no-undo .
     2166       assign
     2167         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2168         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2169       .
     2170       assign
     2171         v-row-delta = v-new-row - frame autopush :height
     2172         v-col-delta = v-new-col - frame autopush :width
     2173       .
     2174       run diasize_change-height in this-procedure
     2175         (input v-row-delta
     2176         ,input true
     2177         ) .
     2178       run diasize_change-width in this-procedure
     2179         (input v-col-delta
     2180         ,input true
     2181         ) .
     2182     end.
     2183   end procedure.
     2184   procedure diasize_maximize :
     2185     define input  parameter p-action as logical   no-undo .
     2186     do
     2187     on error undo, return error return-value
     2188     :
     2189       if p-action = ?
     2190       then do:
     2191         if v-diasize-need-maximize = true
     2192         then do:
     2193           assign
     2194             p-action = true
     2195           .
     2196         end.
     2197         else do:
     2198           assign
     2199             p-action = false
     2200           .
     2201         end.
     2202       end.
     2203       if p-action = true
     2204       then do:
     2205         run diasize_change-height in this-procedure
     2206           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2207               - frame autopush :height-chars
     2208           ,input true
     2209           ) .
     2210         run diasize_change-width in this-procedure
     2211           (input session :width-chars
     2212               - frame autopush :width-chars
     2213           ,input true
     2214           ) .
     2215         assign
     2216           v-diasize-need-maximize = false
     2217         .
     2218       end.
     2219       else do:
     2220         run diasize_change-width in this-procedure
     2221           (input v-diasize-orig-frame-width
     2222               - frame autopush :width-chars
     2223           ,input true
     2224           ) .
     2225         run diasize_change-height in this-procedure
     2226           (input v-diasize-orig-frame-height
     2227               - frame autopush :height-chars
     2228           ,input true
     2229           ) .
     2230         assign
     2231           v-diasize-need-maximize = true
     2232         .
     2233       end.
     2234     end.
     2235   end procedure.
     2236   procedure diasize_restore-orig-size :
     2237     do
     2238     on error undo, return error return-value
     2239     :
     2240       assign
     2241         v-diasize-current-frame-width  = frame autopush :width
     2242         v-diasize-current-frame-height = frame autopush :height
     2243       .
     2244       run diasize_set-height in this-procedure
     2245         (input  v-diasize-orig-frame-height
     2246         ,input  true
     2247         ) .
     2248       run diasize_set-width in this-procedure
     2249         (input  v-diasize-orig-frame-width
     2250         ,input  true
     2251         ) .
     2252     end.
     2253   end procedure.
     2254   procedure diasize_restore-current-size :
     2255     do
     2256     on error undo, return error return-value
     2257     :
     2258       run diasize_set-height in this-procedure
     2259         (input  v-diasize-current-frame-height
     2260         ,input  true
     2261         ) .
     2262       run diasize_set-width in this-procedure
     2263         (input  v-diasize-current-frame-width
     2264         ,input  true
     2265         ) .
     2266     end.
     2267   end procedure.
     2268   procedure diasize_set-browse-handle :
     2269     define input  parameter p-browse-handle as handle   no-undo .
     2270     define buffer buf_temp-browse-handle for temp-browse-handle .
     2271     do
     2272     on error undo, return error return-value
     2273     :
     2274       assign
     2275         v-diasize-browse-handle = p-browse-handle
     2276       .
     2277       for each buf_temp-browse-handle
     2278       on error undo, return error return-value
     2279       :
     2280         delete buf_temp-browse-handle .
     2281       end.
     2282     end.
     2283   end procedure.
     2284   procedure diasize_add_browse :
     2285     define input  parameter p-browse-type   as character no-undo .
     2286     define input  parameter p-browse-handle as handle    no-undo .
     2287     define buffer buf_temp-browse-handle for temp-browse-handle .
     2288     do
     2289     on error undo, return error return-value
     2290     :
     2291       assign
     2292         v-diasize-browse-number = v-diasize-browse-number + 1
     2293       .
     2294       create buf_temp-browse-handle .
     2295       assign
     2296         buf_temp-browse-handle.browse-type   = p-browse-type
     2297         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2298         buf_temp-browse-handle.browse-handle = p-browse-handle
     2299       .
     2300     end.
     2301   end procedure.
     2302   procedure diasize_init :
     2303     define variable v-default-value    as logical   no-undo .
     2304     define variable v-restore-saved    as logical   no-undo .
     2305     define variable v-resize-value-str as character no-undo .
     2306     do
     2307     on error undo, return error return-value
     2308     :
     2309       do with frame autopush
     2310       :
     2311         assign
     2312           v-diasize-orig-frame-height = frame autopush :height
     2313           v-diasize-orig-frame-width  = frame autopush :width
     2314           v-diasize-browse-handle     = browse BR-autotask :handle
     2315         .
     2316         create button v-diasize-resize-button
     2317         assign
     2318           parent        = frame autopush :first-child
     2319           label         = "s"
     2320           height-pixels = 16
     2321           width-pixels  = 16
     2322           visible       = true
     2323           sensitive     = true
     2324           movable       = true
     2325           triggers:
     2326             on end-move persistent run diasize_end-move in this-procedure .
     2327           end triggers.
     2328         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2329         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2330         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2331         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2332         assign
     2333           v-diasize-wndmax = false
     2334         .
     2335         if connected("ub") = true
     2336         then do:
     2337           define variable v-cntxt-db-num        as integer   no-undo .
     2338           define variable v-cntxt-userid        as character no-undo .
     2339           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2340                                             , OUTPUT v-cntxt-userid
     2341                                             ) .
     2342           run gbl/wndpar_r.p
     2343             (input  v-cntxt-db-num
     2344             ,input  v-cntxt-userid
     2345             ,input  'wndmax':U
     2346             ,output v-diasize-wndmax
     2347             ,output v-default-value
     2348             ) .
     2349         end.
     2350         assign
     2351           v-diasize-wndstore = false
     2352         .
     2353         if connected("ub") = true
     2354         then do:
     2355           run gbl/wndpar_r.p
     2356             (input  v-cntxt-db-num
     2357             ,input  v-cntxt-userid
     2358             ,input  'wndstore':U
     2359             ,output v-diasize-wndstore
     2360             ,output v-default-value
     2361             ) .
     2362         end.
     2363         assign
     2364           v-diasize-proc-name = entry(1, program-name(2), '.')
     2365         .
     2366         if v-diasize-wndstore = true
     2367         then do:
     2368           assign
     2369             v-restore-saved = false
     2370           .
     2371           if connected("ub") = true
     2372           then do:
     2373             run gbl/wndsizer.p
     2374               (input  v-cntxt-db-num
     2375               ,input  v-cntxt-userid
     2376               ,input  v-diasize-proc-name
     2377               ,input  'height':u
     2378               ,output v-resize-value-str
     2379               ) .
     2380             if v-resize-value-str <> '':U
     2381             then do:
     2382               run diasize_change-height in this-procedure
     2383                 (input  integer(v-resize-value-str)
     2384                 ,input  true
     2385                 ) .
     2386               assign
     2387                 v-restore-saved = true
     2388               .
     2389             end.
     2390           end.
     2391           if connected("ub") = true
     2392           then do:
     2393             run gbl/wndsizer.p
     2394               (input  v-cntxt-db-num
     2395               ,input  v-cntxt-userid
     2396               ,input  v-diasize-proc-name
     2397               ,input  'width':u
     2398               ,output v-resize-value-str
     2399               ) .
     2400             if v-resize-value-str <> '':U
     2401             then do:
     2402               run diasize_change-width in this-procedure
     2403                 (input  integer(v-resize-value-str)
     2404                 ,input  true
     2405                 ) .
     2406               assign
     2407                 v-restore-saved = true
     2408               .
     2409             end.
     2410           end.
     2411           if v-restore-saved <> true
     2412           then do:
     2413             if v-diasize-wndmax = true
     2414             then do:
     2415               run diasize_maximize in this-procedure
     2416                 (input  true
     2417                 ) .
     2418             end.
     2419           end.
     2420         end.
     2421         else do:
     2422           if v-diasize-wndmax = true
     2423           then do:
     2424             run diasize_maximize in this-procedure
     2425               (input  true
     2426               ) .
     2427           end.
     2428         end.
     2429       end.
     2430     end.
     2431   end procedure.
     2432   procedure diasize_need-full-display :
     2433     define output parameter p-need-full-display as logical   no-undo .
     2434     do
     2435     on error undo, return error return-value
     2436     :
     2437       assign
     2438         p-need-full-display = v-diasize-need-full-display
     2439       .
     2440       assign
     2441         v-diasize-need-full-display = false
     2442       .
     2443     end.
     2444   end procedure.
     2445   procedure get-context :
     2446      define output parameter p-db-num as integer          no-undo.
     2447      define output parameter p-user-id as character        no-undo.
     2448      define variable v-login               as character    no-undo.
     2449      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2450      define buffer buf_user-login  for ub.user-login .
     2451      do
     2452      on error undo, return error
     2453      :
     2454            FIND FIRST buf_sys-ctrl no-lock.
     2455            ASSIGN
     2456               v-login = USERID("ub")
     2457               p-db-num = buf_sys-ctrl.db-num
     2458            .
     2459            FIND FIRST buf_user-login
     2460                 WHERE buf_user-login.db-num = p-db-num
     2461                   AND buf_user-login.user-login = v-login
     2462                 no-lock
     2463                 no-error
     2464                 .
     2465            IF AVAILABLE buf_user-login
     2466            THEN DO:
     2467               assign
     2468                  p-user-id = buf_user-login.user-id
     2469               .
     2470            END.
     2471      end.
     2472   end procedure.
     2473       run diasize_init in this-procedure .
     2474   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME autopush:PARENT eq ?
     2475   THEN FRAME autopush:PARENT = ACTIVE-WINDOW.
     2476   MAIN-BLOCK:
     2477   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2478      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2479   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2480     run mainmenu_getcntxt in parparentproc
     2481       (output v-cntxt-db-num
     2482       ,output v-cntxt-userid
     2483       ,output v-cntxt-level
     2484       ,output v-cntxt-host-code-obj
     2485       ,output v-cntxt-obj-type
     2486       ,output v-cntxt-obj-code
     2487       ,output v-cntxt-db-num-obj
     2488       ,output v-cntxt-is-admin
     2489       ) .
     2490     define buffer buf_BatchProcess   for ub.BatchProcess .
     2491     define buffer buf-c_BatchProcess for ub.BatchProcess .
     2492     assign
     2493       log-exit = false
     2494     .
     2495     RUN enable_UI.
     2496     APPLY "value-changed" TO BROWSE db-list.
     2497     assign
     2498       par-is-bge = TRUE
     2499     .
     2500   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2501     (input  'is-bge'
     2502     ,input  ''
     2503     ,input  ''
     2504     ,input  0
     2505     ,input  ''
     2506     ,input  ''
     2507     ,input  ''
     2508     ,input  yes
     2509     ,output v-par-val
     2510     ,output v-par-type
     2511     ) no-error .
     2512     if error-status:error
     2513        or v-par-type <> "L":U
     2514     then do:
     2515       message
     2516         vss-workfile vss-revision vss-description skip
     2517         "Ошибка чтения конфигурационного параметра is-bge!"
     2518         view-as alert-box error.
     2519       return error .
     2520     end.
     2521     if v-par-val <> "yes" then do:
     2522       assign
     2523         par-is-bge = FALSE
     2524       .
     2525     end.
     2526   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2527     (input  'is-edi'
     2528     ,input  ''
     2529     ,input  ''
     2530     ,input  0
     2531     ,input  ''
     2532     ,input  ''
     2533     ,input  ''
     2534     ,input  yes
     2535     ,output par-is-edi
     2536     ,output par-type
     2537     )  .
     2538     assign
     2539         is-edi = lookup(par-is-edi, "true,yes":U) > 0
     2540     .
     2541     for each buf_temp-autotask:
     2542       delete buf_temp-autotask.
     2543     end.
     2544     do while not log-exit
     2545     on error undo, return error
     2546     :
     2547       wait-for
     2548         go of frame autopush
     2549         or close of this-procedure
     2550         or value-changed of db-list in frame autopush
     2551         or choose of b-do-now in frame autopush
     2552         focus frame autopush
     2553         pause 1
     2554       .
     2555       IF v-start THEN DO:
     2556           v-start = NO.
     2557           ENABLE
     2558           db-list
     2559           br-autotask
     2560           WITH FRAME autopush.
     2561           APPLY "value-changed" TO BROWSE db-list.
     2562       END.
     2563       else do:
     2564         APPLY "value-changed" TO BROWSE db-list.
     2565       end.
     2566     end.
     2567   END.
     2568   RUN disable_UI.
     2569   PROCEDURE disable_UI :
     2570     HIDE FRAME autopush.
     2571   END PROCEDURE.
     2572   PROCEDURE enable_UI :
     2573     ENABLE b-exit b-not-send b-do-now b-help i-exit db-list BR-autotask
     2574         WITH FRAME autopush.
     2575     VIEW FRAME autopush.
     2576     OPEN QUERY BR-autotask FOR EACH temp-autotask.    OPEN QUERY db-list FOR EACH buf_db NO-LOCK.
     2577   END PROCEDURE.
     2578   PROCEDURE fill-autotask :
     2579   define input parameter p-db-num as integer no-undo .
     2580      run cur-time in this-procedure
     2581         ( output v-c-date
     2582          ,output v-c-time
     2583         ) no-error.
     2584       if error-status :error then do:
     2585         message vss-workfile vss-revision vss-description skip
     2586           "Ошибка при определении текущей даты!"
     2587           view-as alert-box error.
     2588         return error.
     2589       end.
     2590   for each buf_temp-autotask :
     2591     delete buf_temp-autotask.
     2592   end.
     2593   if (p-db-num = 0
     2594   and v-cntxt-db-num > 0)
     2595   or (p-db-num > 0
     2596   and v-cntxt-db-num = 0)
     2597   then do:
     2598   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2599      find first buf_BatchProcess no-lock
     2600         where buf_BatchProcess.BP_Status   = 'N':U
     2601           and buf_BatchProcess.BP_Type     = 'autonws':U
     2602           and buf_BatchProcess.CharKey_One = string( buf_db.db-num )
     2603           and buf_BatchProcess.CharKey_Two = "auto":U
     2604         no-error
     2605       .
     2606       FIND FIRST buf_temp-autotask WHERE
     2607                 buf_temp-autotask.db-num = buf_db.db-num
     2608           AND buf_temp-autotask.task-type = 'autonws':U NO-ERROR.
     2609       IF NOT AVAILABLE buf_temp-autotask THEN DO:
     2610           CREATE buf_temp-autotask.
     2611           ASSIGN
     2612           buf_temp-autotask.db-num = buf_db.db-num
     2613           buf_temp-autotask.task-type = 'autonws':U
     2614           .
     2615           case buf_temp-autotask.task-type:
     2616             when 'autonws':U then do:
     2617               assign
     2618               buf_temp-autotask.task-name = "Новости"
     2619               .
     2620             end.
     2621             when 'autoarh':U then do:
     2622               assign
     2623               buf_temp-autotask.task-name = "Архивы"
     2624               .
     2625             end.
     2626             when 'autoexp':U then do:
     2627               assign
     2628               buf_temp-autotask.task-name = "Экспорт"
     2629               .
     2630             end.
     2631             when 'autooxml':U then do:
     2632               assign
     2633               buf_temp-autotask.task-name = "OpenXML"
     2634               .
     2635             end.
     2636             when 'autogcd':U then do:
     2637               assign
     2638               buf_temp-autotask.task-name = "Прием инф. с касс"
     2639               .
     2640             end.
     2641             when 'autosale':U then do:
     2642               assign
     2643               buf_temp-autotask.task-name = "Обработка продаж"
     2644               .
     2645             end.
     2646             when 'autosuz':U then do:
     2647               assign
     2648               buf_temp-autotask.task-name = "Отчеты"
     2649               .
     2650             end.
     2651             when 'autocbnk':U then do:
     2652               assign
     2653               buf_temp-autotask.task-name = "Эксп/имп в КЛИЕНТ-БАНК"
     2654               .
     2655             end.
     2656             when 'autofree':U then do:
     2657               assign
     2658               buf_temp-autotask.task-name = "Произвольные задания"
     2659               .
     2660             end.
     2661             when 'sktsrv':U then do:
     2662               assign
     2663               buf_temp-autotask.task-name = "Сокет-Сервер"
     2664               .
     2665             end.
     2666             when 'mercury':U then do:
     2667               assign
     2668               buf_temp-autotask.task-name = "Меркурий"
     2669               .
     2670             end.
     2671             when 'hddtest':U then do:
     2672               assign
     2673               buf_temp-autotask.task-name = "Мониторинг HDD"
     2674               .
     2675             end.
     2676             when 'is_motp':U then do:
     2677               assign
     2678               buf_temp-autotask.task-name = "ИС МОТП"
     2679               .
     2680             end.
     2681             when 'is_diadoc':U then do:
     2682               assign
     2683               buf_temp-autotask.task-name = "ИС Диадок"
     2684               .
     2685             end.
     2686             when 'is_PM':U then do:
     2687               assign
     2688               buf_temp-autotask.task-name = "ИС Президентский Мониторинг"
     2689               .
     2690             end.
     2691           END CASE.
     2692       END.
     2693       if available buf_BatchProcess then do:
     2694         assign
     2695           buf_temp-autotask.task-date = buf_BatchProcess.BP_ExecSysDate
     2696           buf_temp-autotask.task-time = buf_BatchProcess.BP_ExecSysTimeInt
     2697         .
     2698         if buf_temp-autotask.task-date < v-c-date
     2699           or ( buf_temp-autotask.task-date = v-c-date
     2700                and buf_BatchProcess.BP_ExecSysTimeInt < v-c-time
     2701              )
     2702         then do:
     2703           assign
     2704           buf_temp-autotask.overtime = YES
     2705           .
     2706         end.
     2707         else do:
     2708           if buf_temp-autotask.overtime = YES then do:
     2709             assign
     2710             buf_temp-autotask.overtime = NO
     2711             .
     2712           end.
     2713         end.
     2714       end.
     2715       else do:
     2716         assign
     2717         buf_temp-autotask.overtime = YES
     2718         buf_temp-autotask.task-date = ?
     2719         buf_temp-autotask.task-time = ?
     2720         .
     2721       end.
     2722       find first buf-c_BatchProcess no-lock
     2723         where buf-c_BatchProcess.BP_Status   = 'N':U
     2724           and buf-c_BatchProcess.BP_Type     = 'autonws':U
     2725           and buf-c_BatchProcess.CharKey_One = string( buf_db.db-num )
     2726           and buf-c_BatchProcess.CharKey_Two <> "auto":U
     2727         no-error
     2728       .
     2729       if available buf-c_BatchProcess then do:
     2730         assign
     2731           buf_temp-autotask.corr = "!!!":U
     2732         .
     2733       end.
     2734       else do:
     2735         assign
     2736         buf_temp-autotask.corr = "":U
     2737         .
     2738       end.
     2739       assign
     2740       buf_temp-autotask.date-time = string(buf_temp-autotask.task-date, "99/99/9999") + chr(32) +
     2741                                     string(buf_temp-autotask.task-time, "HH:MM")
     2742      .
     2743   end.
     2744   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2745      find first buf_BatchProcess no-lock
     2746         where buf_BatchProcess.BP_Status   = 'N':U
     2747           and buf_BatchProcess.BP_Type     = 'autoarh':U
     2748           and buf_BatchProcess.CharKey_One = string( buf_db.db-num )
     2749           and buf_BatchProcess.CharKey_Two = "auto":U
