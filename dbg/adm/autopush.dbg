     4469         where buf-c_BatchProcess.BP_Status   = 'N':U
     4470           and buf-c_BatchProcess.BP_Type     = 'autocbnk':U
     4471           and buf-c_BatchProcess.CharKey_One = string( buf_db.db-num )
     4472           and buf-c_BatchProcess.CharKey_Two <> "auto":U
     4473         no-error
     4474       .
     4475       if available buf-c_BatchProcess then do:
     4476         assign
     4477           buf_temp-autotask.corr = "!!!":U
     4478         .
     4479       end.
     4480       else do:
     4481         assign
     4482         buf_temp-autotask.corr = "":U
     4483         .
     4484       end.
     4485       assign
     4486       buf_temp-autotask.date-time = string(buf_temp-autotask.task-date, "99/99/9999") + chr(32) +
     4487                                     string(buf_temp-autotask.task-time, "HH:MM")
     4488      .
     4489     end.
     4490   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4491      find first buf_BatchProcess no-lock
     4492         where buf_BatchProcess.BP_Status   = 'N':U
     4493           and buf_BatchProcess.BP_Type     = 'autofree':U
     4494           and buf_BatchProcess.CharKey_One = string( buf_db.db-num )
     4495           and buf_BatchProcess.CharKey_Two = "auto":U
     4496         no-error
     4497       .
     4498       FIND FIRST buf_temp-autotask WHERE
     4499                 buf_temp-autotask.db-num = buf_db.db-num
     4500           AND buf_temp-autotask.task-type = 'autofree':U NO-ERROR.
     4501       IF NOT AVAILABLE buf_temp-autotask THEN DO:
     4502           CREATE buf_temp-autotask.
     4503           ASSIGN
     4504           buf_temp-autotask.db-num = buf_db.db-num
     4505           buf_temp-autotask.task-type = 'autofree':U
     4506           .
     4507           case buf_temp-autotask.task-type:
     4508             when 'autonws':U then do:
     4509               assign
     4510               buf_temp-autotask.task-name = "Новости"
     4511               .
     4512             end.
     4513             when 'autoarh':U then do:
     4514               assign
     4515               buf_temp-autotask.task-name = "Архивы"
     4516               .
     4517             end.
     4518             when 'autoexp':U then do:
     4519               assign
     4520               buf_temp-autotask.task-name = "Экспорт"
     4521               .
     4522             end.
     4523             when 'autooxml':U then do:
     4524               assign
     4525               buf_temp-autotask.task-name = "OpenXML"
     4526               .
     4527             end.
     4528             when 'autogcd':U then do:
     4529               assign
     4530               buf_temp-autotask.task-name = "Прием инф. с касс"
     4531               .
     4532             end.
     4533             when 'autosale':U then do:
     4534               assign
     4535               buf_temp-autotask.task-name = "Обработка продаж"
     4536               .
     4537             end.
     4538             when 'autosuz':U then do:
     4539               assign
     4540               buf_temp-autotask.task-name = "Отчеты"
     4541               .
     4542             end.
     4543             when 'autocbnk':U then do:
     4544               assign
     4545               buf_temp-autotask.task-name = "Эксп/имп в КЛИЕНТ-БАНК"
     4546               .
     4547             end.
     4548             when 'autofree':U then do:
     4549               assign
     4550               buf_temp-autotask.task-name = "Произвольные задания"
     4551               .
     4552             end.
     4553             when 'sktsrv':U then do:
     4554               assign
     4555               buf_temp-autotask.task-name = "Сокет-Сервер"
     4556               .
     4557             end.
     4558             when 'mercury':U then do:
     4559               assign
     4560               buf_temp-autotask.task-name = "Меркурий"
     4561               .
     4562             end.
     4563             when 'hddtest':U then do:
     4564               assign
     4565               buf_temp-autotask.task-name = "Мониторинг HDD"
     4566               .
     4567             end.
     4568             when 'is_motp':U then do:
     4569               assign
     4570               buf_temp-autotask.task-name = "ИС МОТП"
     4571               .
     4572             end.
     4573             when 'is_diadoc':U then do:
     4574               assign
     4575               buf_temp-autotask.task-name = "ИС Диадок"
     4576               .
     4577             end.
     4578             when 'is_PM':U then do:
     4579               assign
     4580               buf_temp-autotask.task-name = "ИС Президентский Мониторинг"
     4581               .
     4582             end.
     4583           END CASE.
     4584       END.
     4585       if available buf_BatchProcess then do:
     4586         assign
     4587           buf_temp-autotask.task-date = buf_BatchProcess.BP_ExecSysDate
     4588           buf_temp-autotask.task-time = buf_BatchProcess.BP_ExecSysTimeInt
     4589         .
     4590         if buf_temp-autotask.task-date < v-c-date
     4591           or ( buf_temp-autotask.task-date = v-c-date
     4592                and buf_BatchProcess.BP_ExecSysTimeInt < v-c-time
     4593              )
     4594         then do:
     4595           assign
     4596           buf_temp-autotask.overtime = YES
     4597           .
     4598         end.
     4599         else do:
     4600           if buf_temp-autotask.overtime = YES then do:
     4601             assign
     4602             buf_temp-autotask.overtime = NO
     4603             .
     4604           end.
     4605         end.
     4606       end.
     4607       else do:
     4608         assign
     4609         buf_temp-autotask.overtime = YES
     4610         buf_temp-autotask.task-date = ?
     4611         buf_temp-autotask.task-time = ?
     4612         .
     4613       end.
     4614       find first buf-c_BatchProcess no-lock
     4615         where buf-c_BatchProcess.BP_Status   = 'N':U
     4616           and buf-c_BatchProcess.BP_Type     = 'autofree':U
     4617           and buf-c_BatchProcess.CharKey_One = string( buf_db.db-num )
     4618           and buf-c_BatchProcess.CharKey_Two <> "auto":U
     4619         no-error
     4620       .
     4621       if available buf-c_BatchProcess then do:
     4622         assign
     4623           buf_temp-autotask.corr = "!!!":U
     4624         .
     4625       end.
     4626       else do:
     4627         assign
     4628         buf_temp-autotask.corr = "":U
     4629         .
     4630       end.
     4631       assign
     4632       buf_temp-autotask.date-time = string(buf_temp-autotask.task-date, "99/99/9999") + chr(32) +
     4633                                     string(buf_temp-autotask.task-time, "HH:MM")
     4634      .
     4635       IF NOT v-start THEN DO:
     4636           br-autotask:REFRESH() IN FRAME autopush.
     4637       END.
     4638   END PROCEDURE.
     4639   PROCEDURE set-row-color :
     4640   define variable iFGColor AS INTEGER NO-UNDO.
     4641     define variable iBGColor AS INTEGER NO-UNDO.
     4642     IF temp-autotask.overtime THEN DO:
     4643         ASSIGN
     4644           iFGColor = RED_COLOR
     4645           iBGColor = WHITE_COLOR
     4646         .
     4647       end.
     4648       ELSE do:
     4649         ASSIGN
     4650           iFGColor = Black_COLOR
     4651           iBGColor = White_COLOR
     4652         .
     4653       end.
     4654       ASSIGN
     4655         temp-autotask.date-time:FGCOLOR IN BROWSE BR-autotask = iFGColor
     4656         temp-autotask.date-time:BGCOLOR IN BROWSE BR-autotask = iBGColor
     4657       .
     4658   END PROCEDURE.
     4659   PROCEDURE write-new-bp :
     4660   define input parameter p-task-type as   character    no-undo .
     4661     define input parameter p-db-num    like ub.db.db-num no-undo .
     4662     if transaction then do:
     4663       message
     4664         vss-workfile vss-revision vss-description skip
     4665         "Недопустимо вызывать процедуру из транзакции!" skip
     4666         view-as alert-box error .
     4667     end.
     4668     block_bp:
     4669     do
     4670     on error undo, return error
     4671     :
     4672       define buffer buf_BatchProcess for ub.BatchProcess .
     4673       define buffer buf_sys-ctrl     for ub.sys-ctrl .
     4674       define variable v-curr-date as date      no-undo .
     4675       define variable v-curr-time as integer   no-undo .
     4676       define variable v-date      as date      no-undo .
     4677       define variable v-time      as integer   no-undo .
     4678       define variable v-log       as logical   no-undo .
     4679       define variable v-cancel    as logical   no-undo .
     4680       define variable v-msg       as character no-undo .
     4681       define variable v-str       as character no-undo .
     4682       do for buf_BatchProcess
     4683       on error undo, return error return-value
     4684       :
     4685         find first buf_sys-ctrl no-lock .
     4686         find first buf_BatchProcess
     4687           where buf_BatchProcess.BP_Status   = 'N':U
     4688             and buf_BatchProcess.BP_Type     = p-task-type
     4689             and buf_BatchProcess.CharKey_One = string( p-db-num )
     4690             and buf_BatchProcess.CharKey_Two = "manual":U
     4691           no-error
     4692         .
     4693         if available buf_BatchProcess then do:
     4694           message "Изменение времени запуска уже производилось." skip
     4695                   "Установлено:" string( buf_BatchProcess.BP_ExecSysDate, "99.99.9999") buf_BatchProcess.BP_ExecSysTime skip
     4696                   "Вы действительно хотите его изменить?"
     4697                   view-as alert-box question buttons yes-no update v-log.
     4698         end.
     4699         else do:
     4700           assign
     4701             v-log = true
     4702           .
     4703         end.
     4704       end.
     4705       if v-log = false then do:
     4706         assign
     4707           v-msg = "Время очередного сеанса не изменено!"
     4708         .
     4709         undo, leave block_bp.
     4710       end.
     4711       assign
     4712         v-str = get-str-type( p-task-type )
     4713       .
     4714       if v-str = ? then do:
     4715         message vss-workfile vss-revision vss-description skip
     4716           "НЕТ ОБРАБОТКИ АТРИБУТА" p-task-type
     4717           view-as alert-box error.
     4718         return error.
     4719       end.
     4720       case p-task-type :
     4721         when 'autoarh':U
     4722         then do:
     4723           run adm/arc-shdp.w
     4724             (input  buf_sys-ctrl.db-num
     4725             ,input  p-task-type
     4726             ,input  -1
     4727             ,output v-cancel
     4728             ) no-error .
     4729           if error-status :error
     4730           then do:
     4731             message vss-workfile vss-revision vss-description skip
     4732               "Ошибка при создании (редактировании) атрибута!"
     4733               view-as alert-box error.
     4734             return error.
     4735           end.
     4736           if v-cancel = true
     4737           then do:
     4738             assign
     4739               v-msg = "Время очередного сеанса не изменено!"
     4740             .
     4741             undo, leave block_bp.
     4742           end.
     4743         end.
     4744         when 'autoexp':U
     4745         then do:
     4746           run bge/bge-shdp.w
     4747             (input  parparentproc
     4748             ,input  buf_sys-ctrl.db-num
     4749             ,input  p-task-type
     4750             ,input  -1
     4751             ,output v-cancel
     4752             ) no-error.
     4753           if error-status :error then do:
     4754             message vss-workfile vss-revision vss-description skip
     4755               "Ошибка при создании (редактировании) атрибута!"
     4756               view-as alert-box error.
     4757             return error.
     4758           end.
     4759           if v-cancel = TRUE then do:
     4760             assign
     4761               v-msg = "Время очередного сеанса не изменено!"
     4762             .
     4763             undo, leave block_bp.
     4764           end.
     4765         end.
     4766         when 'autogcd':U
     4767         then do:
     4768           run str/gcd-shdp.w
     4769             ( input  parparentproc
     4770              ,input  buf_sys-ctrl.db-num
     4771              ,input  p-task-type
     4772              ,input  -1
     4773              ,output v-cancel
     4774             ) no-error.
     4775           if error-status :error then do:
     4776             message vss-workfile vss-revision vss-description skip
     4777               "Ошибка при создании (редактировании) атрибута!"
     4778               view-as alert-box error.
     4779             return error.
     4780           end.
     4781           if v-cancel = TRUE then do:
     4782             assign
     4783               v-msg = "Время очередного сеанса не изменено!"
     4784             .
     4785             undo, leave block_bp.
     4786           end.
     4787         end.
     4788         when 'autosale':U
     4789         then do:
     4790           run str/sal-shdp.w
     4791             ( input parparentproc
     4792              ,input  buf_sys-ctrl.db-num
     4793              ,input  p-task-type
     4794              ,input  -1
     4795              ,output v-cancel
     4796             ) no-error.
     4797           if error-status :error then do:
     4798             message vss-workfile vss-revision vss-description skip
     4799               "Ошибка при создании (редактировании) атрибута!"
     4800               view-as alert-box error.
     4801             return error.
     4802           end.
     4803           if v-cancel = TRUE then do:
     4804             assign
     4805               v-msg = "Время очередного сеанса не изменено!"
     4806             .
     4807             undo, leave block_bp.
     4808           end.
     4809         end.
     4810         when 'autosuz':U
     4811         then do:
     4812           run str/suz-shdp.w
     4813             (input parparentproc
     4814             ,input  buf_sys-ctrl.db-num
     4815             ,input  p-task-type
     4816             ,input  -1
     4817             ,output v-cancel
     4818             ) no-error .
     4819           if error-status :error
     4820           then do:
     4821             message vss-workfile vss-revision vss-description skip
     4822               "Ошибка при создании (редактировании) атрибута!"
     4823               view-as alert-box error.
     4824             return error.
     4825           end.
     4826           if v-cancel = true
     4827           then do:
     4828             assign
     4829               v-msg = "Время очередного сеанса не изменено!"
     4830             .
     4831             undo, leave block_bp.
     4832           end.
     4833         end.
     4834         when 'autocbnk':U
     4835         then do:
     4836             define variable v-params        as character    no-undo.
     4837             define variable v-object-list        as character    no-undo.
     4838             define variable v-doc-type-list      as character    no-undo.
     4839             define variable v-hsch-list          as character    no-undo.
     4840             define variable v-csch-list          as character    no-undo.
     4841             define variable v-date-list          as character    no-undo.
     4842           run bge/clb-shdp.w (
     4843                            input parparentproc
     4844                           ,input p-curr-host-code
     4845                           ,input 'shd':U
     4846                           ,input  buf_sys-ctrl.db-num
     4847                           ,input  p-task-type
     4848                           ,input  -1
     4849                           ,input ?
     4850                           ,output v-cancel
     4851                           ,output v-params
     4852                           ,output v-object-list
     4853                           ,output v-doc-type-list
     4854                           ,output v-date-list
     4855                           ,output v-hsch-list
     4856                           ,output v-csch-list
     4857                         ) no-error.
     4858           if error-status :error then do:
     4859             message vss-workfile vss-revision vss-description skip
     4860               "Ошибка при создании (редактировании) атрибута!"
     4861               view-as alert-box error.
     4862             return error.
     4863           end.
     4864           if v-cancel = TRUE then do:
     4865             assign
     4866               v-msg = "Время очередного сеанса не изменено!"
     4867             .
     4868             undo, leave block_bp.
     4869           end.
     4870         end.
     4871         when 'is_PM':U
     4872         then do:
     4873           run adm/isPM-shdp.w
     4874             (input  buf_sys-ctrl.db-num
     4875             ,input  p-task-type
     4876             ,input  -1
     4877             ,output v-cancel
     4878             ) no-error.
     4879           if error-status :error
     4880           then do:
     4881             message vss-workfile vss-revision vss-description skip
     4882               "Ошибка при создании (редактировании) атрибута!"
     4883               view-as alert-box error.
     4884             return error.
     4885           end.
     4886           if v-cancel = TRUE then do:
     4887             assign
     4888               v-msg = "Время очередного сеанса не изменено!"
     4889             .
     4890             undo, leave block_bp.
     4891           end.
     4892         end .
     4893         when 'autofree':U
     4894         then do:
     4895           define variable v-free-id as character no-undo .
     4896           define variable v-value as character no-undo .
     4897           define buffer buf_schedule-attr for ub.schedule-attr.
     4898           run adm/freeshdp.w (
     4899                            input parparentproc
     4900                           ,input p-curr-host-code
     4901                           ,input p-curr-obj-type
     4902                           ,input p-curr-obj-code
     4903                           ,input 'shd':U
     4904                           ,input  buf_sys-ctrl.db-num
     4905                           ,input  p-task-type
     4906                           ,input  -1
     4907                           ,input ?
     4908                           ,input-output v-free-id
     4909                           ,output v-cancel
     4910                           ,output v-params
     4911                         ) no-error.
     4912           if error-status :error then do:
     4913             message vss-workfile vss-revision vss-description skip
     4914               "Ошибка при создании (редактировании) атрибута!"
     4915               view-as alert-box error.
     4916             return error.
     4917           end.
     4918           if v-cancel = TRUE then do:
     4919             assign
     4920               v-msg = "Время очередного сеанса не изменено!"
     4921             .
     4922             undo, leave block_bp.
     4923           end.
     4924           else do:
     4925             run schedule-attr-get-free-props in this-procedure (input v-free-id, output v-value).
     4926             do transaction
     4927             on error undo, return error return-value
     4928             :
     4929               for each buf_schedule-attr where
     4930                       buf_schedule-attr.cre-db-num = buf_sys-ctrl.db-num
     4931                   AND buf_schedule-attr.task-type = p-task-type
     4932                   AND buf_schedule-attr.task-num = - 1
     4933                   and buf_schedule-attr.attr-code begins 'schd-free-id':U + chr(4)
     4934               on error undo, return error error-status:get-message(1) :
     4935                 delete buf_schedule-attr.
     4936               end.
     4937             end.
     4938             run schedule-attr-write in this-procedure (
     4939                                                          input string(p-db-num)
     4940                                                         ,input p-task-type
     4941                                                         ,input - 1
     4942                                                         ,input ('schd-free-id':U + chr(4) + v-free-id)
     4943                                                         ,input v-value ).
     4944           end.
     4945         end.
     4946       end.
     4947       run cur-time in this-procedure
     4948         ( output v-curr-date
     4949          ,output v-curr-time
     4950         ) no-error.
     4951       if error-status :error then do:
     4952         message vss-workfile vss-revision vss-description skip
     4953           "Ошибка при определении текущей даты!"
     4954           view-as alert-box error.
     4955         return error.
     4956       end.
     4957       assign
     4958         v-date = v-curr-date
     4959         v-time = v-curr-time
     4960       .
     4961       block_ed:
     4962       do while true
     4963       on error undo, return error
     4964       :
     4965         run adm/d-ed-d-t.w ( input-output v-date
     4966                         ,input-output v-time
     4967                       ) no-error .
     4968         if error-status :error then do:
     4969           message vss-workfile vss-revision vss-description skip
     4970             "Ошибка при редактировании даты!"
     4971             view-as alert-box error.
     4972           return error.
     4973         end.
     4974         if v-date = ?
     4975           or v-time = ?
     4976         then do:
     4977           assign
     4978             v-msg = "Время очередного сеанса не изменено!"
     4979           .
     4980           undo, leave block_bp.
     4981         end.
     4982         if v-date > v-curr-date
     4983           or ( v-date = v-curr-date
     4984                and v-time >= v-curr-time
     4985              )
     4986         then do:
     4987           leave block_ed.
     4988         end.
     4989         else do:
     4990           message "Время очередного сеанса не может быть меньше текущего!"
     4991             view-as alert-box error.
     4992         end.
     4993       end.
     4994       run push-abtpr in this-procedure
     4995         ( input parparentproc
     4996          ,input p-db-num
     4997          ,input p-task-type
     4998          ,input "manual":U
     4999          ,input v-date
     5000          ,input v-time
     5001         ) no-error .
     5002       if error-status :error
     5003       then do:
     5004         message vss-workfile vss-revision vss-description skip
     5005           "Ошибка при записи времени внеочередного запуска!" skip
     5006           error-status :get-message(1) skip
     5007           return-value skip
     5008           view-as alert-box error.
     5009         return error.
     5010       end.
     5011       assign
     5012         v-msg = substitute( "Команда на запуск &1 для БД &2 отправлена", v-str, p-db-num )
     5013                 + chr(10) + "и должна быть обработана в течении минуты."
     5014       .
     5015     end.
     5016     if v-msg <> "":U then do:
     5017       message v-msg
     5018         view-as alert-box information.
     5019     end.
     5020     return.
     5021   END PROCEDURE.
