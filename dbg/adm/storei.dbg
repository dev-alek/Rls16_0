     1527        fi-holdfirm-code AT ROW 18.52 COL 58 COLON-ALIGNED
     1528        fi-holdfirm-name AT ROW 18.52 COL 68 COLON-ALIGNED NO-LABEL
     1529        "Оплаты :" VIEW-AS TEXT
     1530             SIZE 8.6 BY .91 AT ROW 8.95 COL 2.6
     1531             FGCOLOR 4
     1532        "Примечания" VIEW-AS TEXT
     1533             SIZE 18.2 BY .86 AT ROW 19 COL 2.6
     1534        RECT-10 AT ROW 8.62 COL 1.6
     1535        SPACE(69.15) SKIP(6.16)
     1536       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1537            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1538            TITLE "Склад"
     1539            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     1540   ASSIGN
     1541          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1542          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1543   ASSIGN
     1544          EDITOR-1:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1545   ASSIGN
     1546          tt-store.in-perm:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1547   ASSIGN
     1548          tt-store.obj-code:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-obj-code:HANDLE.
     1549   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1550   DO:
     1551     APPLY "END-ERROR":U TO SELF.
     1552   END.
     1553   ON CHOOSE OF B-attr IN FRAME Dialog-Frame
     1554   DO:
     1555     RUN proc-b-attr IN THIS-PROCEDURE ('ПРОСМОТР':U, 'скл':U, locked_store.obj-code) NO-ERROR.
     1556     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1557   END.
     1558   ON CHOOSE OF b-db IN FRAME Dialog-Frame
     1559   DO:
     1560     define variable ri as recid no-undo.
     1561   define buffer buf_db for ub.db.
     1562     run adm/dbs.w (
     1563                   input parparentproc
     1564                  ,input 'ПРОСМОТР':U
     1565                  ,output ri).
     1566     if ri <> ?
     1567     then do:
     1568       find buf_db where recid (buf_db) = ri .
     1569       display
     1570       buf_db.db-num @ tt-clients.db-num
     1571       with frame Dialog-Frame.
     1572     end.
     1573   END.
     1574   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1575   DO:
     1576       run proc-save in this-procedure no-error.
     1577       if error-status:error then return no-apply.
     1578   END.
     1579   ON CHOOSE OF b-fbrpay IN FRAME Dialog-Frame
     1580   DO:
     1581       define variable ref-rec as character no-undo .
     1582       define buffer buf_pay-type for ub.pay-type.
     1583       run ref/paytype.w (input parparentproc, "b-sel", output ref-rec ).
     1584       apply "ENTRY" to self .
     1585       if ref-rec = "" then  return no-apply.
     1586       else do:
     1587         FIND buf_pay-type WHERE
     1588                recid( buf_pay-type ) = int(ref-rec) NO-LOCK .
     1589         assign
     1590         tt-store.fbr-pay = buf_pay-type.obj-code .
     1591         display
     1592           tt-store.fbr-pay with frame Dialog-Frame.
     1593       end.
     1594   END.
     1595   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
     1596   DO:
     1597      define variable v-rid-list as character no-undo .
     1598        run ref/cclihist.w (
     1599                         input parparentproc
     1600                       , input 0
     1601                       , input "":U
     1602                       , input 0
     1603                       , input "":U
     1604                       , "one":U
     1605                       , input 'скл':U
     1606                       , input tt-store.obj-code
     1607                       , input ?
     1608                       , input ?
     1609                       , input "":U
     1610                       , input "":U
     1611                       , input v-cntxt-db-num
     1612                       , input-output v-rid-list  ) no-error .
     1613   END.
     1614   ON CHOOSE OF b-holdfirm IN FRAME Dialog-Frame
     1615   DO:
     1616       define variable v-ref-list  as character    no-undo.
     1617       define variable v-firm-code as integer    no-undo.
     1618       assign
     1619           fi-holdfirm-code
     1620       .
     1621       run adm/sconfs.w (
     1622             input parParentProc
     1623           , input "b-sel":U
     1624           , input no
     1625           , input fi-holdfirm-code
     1626           , output v-firm-code
     1627           , input-output ref-list
     1628       ) no-error.
     1629       if error-status :error
     1630       then do:
     1631           message
     1632                    vss-workfile vss-revision vss-description
     1633               skip(1)
     1634               skip "Ошибка выбора фирмы."
     1635               skip return-value
     1636               skip trim(error-status :get-message(1))
     1637                    trim(error-status :get-message(2))
     1638                    trim(error-status :get-message(3))
     1639           view-as alert-box error.
     1640           undo, return no-apply .
     1641       end.
     1642       if v-firm-code = ?
     1643       or v-firm-code = 0
     1644       then do:
     1645           message "Фирма не выбрана."
     1646           view-as alert-box warning.
     1647           return no-apply.
     1648       end.
     1649       else do:
     1650           define buffer buf_clients for ub.clients.
     1651           find first buf_clients no-lock
     1652                where buf_clients.obj-type = 'орг':U
     1653                  and buf_clients.obj-code = v-firm-code
     1654           no-error.
     1655           if available buf_clients
     1656           then do:
     1657               assign
     1658                   fi-holdfirm-code = v-firm-code
     1659                   fi-holdfirm-name = buf_clients.obj-name
     1660               .
     1661           end.
     1662           else do:
     1663               assign
     1664                   fi-holdfirm-code = 0
     1665                   fi-holdfirm-name = "":U
     1666               .
     1667           end.
     1668           display
     1669               fi-holdfirm-code
     1670               fi-holdfirm-name
     1671           with frame Dialog-Frame.
     1672       end.
     1673   END.
     1674   ON CHOOSE OF b-host IN FRAME Dialog-Frame
     1675   DO:
     1676   define variable ref-list as char no-undo.
     1677   define variable glog as logical no-undo .
     1678   IF p-mode = 'ДОБАВЛЕНИЕ':U  THEN DO:
     1679     run adm/sconfs.w (
     1680                    input parParentProc
     1681                   ,input "b-sel":U
     1682                   ,input no
     1683                   ,input p-host-code
     1684                   ,output new-host-code
     1685                   ,input-output ref-list ) .
     1686      .
     1687     if new-host-code = ?
     1688     or new-host-code = 0
     1689     then do:
     1690       message "Фирма не выбрана."
     1691               view-as alert-box error.
     1692       return no-apply.
     1693     end.
     1694     if tt-store.host-code <> 0 then do:
     1695       message
     1696       "Проставить коды оплат для типов документов и др. согласно настройкам выбранной фирмы?"
     1697       view-as alert-box question buttons yes-no update glog.
     1698     end.
     1699     else do:
     1700       glog = yes.
     1701     end.
     1702     tt-store.host-code = new-host-code.
     1703     find first buf_cli-host where
     1704               buf_cli-host.obj-type = 'орг':U
     1705           and buf_cli-host.obj-code = tt-store.host-code no-lock.
     1706     CASE p-mode:
     1707       when 'ПРОСМОТР':U then
     1708       frame Dialog-Frame:title = "СКЛАД  фирмы : " + buf_cli-host.obj-name + "               " + "ПРОСМОТР".
     1709       when 'ДОБАВЛЕНИЕ':U then
     1710       frame Dialog-Frame:title = "СКЛАД  фирмы : " + buf_cli-host.obj-name + "               " + "ДОБАВЛЕНИЕ".
     1711       when 'ИЗМЕНЕНИЕ':U then
     1712       frame Dialog-Frame:title = "СКЛАД  фирмы : " + buf_cli-host.obj-name + "               " + "ИЗМЕНЕНИЕ".
     1713     END CASE.
     1714     if glog then do:
     1715       run reset-from-sysconf in this-procedure ( input yes
     1716                                               , input tt-store.host-code
     1717                                                       ).
     1718     end.
     1719   END.
     1720   ELSE DO:
     1721       run adm/config.w (
     1722                             input parparentproc
     1723                            ,input tt-store.host-code
     1724                            ,input  'ПРОСМОТР':U
     1725                            ,input no
     1726                            ) no-error.
     1727       if error-status:error then return no-apply.
     1728   END.
     1729   END.
     1730   ON CHOOSE OF b-inpay IN FRAME Dialog-Frame
     1731   DO:
     1732       define variable ref-rec as character no-undo .
     1733       define buffer buf_pay-type for ub.pay-type.
     1734       run ref/paytype.w (input parparentproc, "b-sel", output ref-rec ).
     1735       apply "ENTRY" to self .
     1736       if ref-rec = "" then return no-apply.
     1737       else do:
     1738           find buf_pay-type where recid( buf_pay-type ) = int(ref-rec) no-lock .
     1739           assign
     1740             tt-store.in-pay = buf_pay-type.obj-code .
     1741           display tt-store.in-pay with frame Dialog-Frame.
     1742      end.
     1743   END.
