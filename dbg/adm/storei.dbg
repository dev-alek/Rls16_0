      358   procedure proc-alt-shift-f2:
      359     if not ibs.th.gbl.gbl-var:rcode
      360   then
      361     run gbl\inidebug.p .
      362   end.
      363   procedure proc-alt-shift-f3:
      364     run gbl/prvssinf.p
      365       ( input this-procedure
      366       ) .
      367   end.
      368   define variable v-inform-launched as logical no-undo initial false .
      369   procedure proc-alt-shift-f4:
      370     define variable v-action as character no-undo .
      371     if v-inform-launched = false then do:
      372       assign
      373         v-inform-launched = true
      374       .
      375       run gbl/d-inform.w
      376         (  input self
      377         ,  input this-procedure
      378         , output v-action
      379         ) no-error .
      380       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      381       assign
      382         v-inform-launched = false
      383       .
      384     end.
      385   end.
      386   procedure proc-alt-f1:
      387     run gbl/corrhelp.p
      388       (input this-procedure
      389       ) .
      390   end .
      391   on alt-shift-f2 anywhere do:
      392     run proc-alt-shift-f2.
      393   end.
      394   on alt-shift-f3 anywhere do:
      395     run proc-alt-shift-f3 in this-procedure .
      396   end.
      397   on alt-shift-f4 anywhere do:
      398     run proc-alt-shift-f4 in this-procedure.
      399   end.
      400   on alt-f1 anywhere do:
      401     run proc-alt-f1 in this-procedure .
      402   end.
