     1295   DEFINE BUTTON b-outpay
     1296        IMAGE-UP FILE "btn-down-arrow":U
     1297        IMAGE-DOWN FILE "btn-down-arrow":U
     1298        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1299        LABEL "":L
     1300        SIZE 3 BY .91.
     1301   DEFINE BUTTON b-quit AUTO-END-KEY
     1302        LABEL "&Отмена"
     1303        SIZE 10 BY 1
     1304        BGCOLOR 8 .
     1305   DEFINE BUTTON b-reset
     1306        LABEL "&Уст.Сист.":L
     1307        SIZE 10 BY 1.
     1308   DEFINE BUTTON b-retpay
     1309        IMAGE-UP FILE "btn-down-arrow":U
     1310        IMAGE-DOWN FILE "btn-down-arrow":U
     1311        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1312        LABEL "":L
     1313        SIZE 3 BY .91.
     1314   DEFINE BUTTON b-spipay
     1315        IMAGE-UP FILE "btn-down-arrow":U
     1316        IMAGE-DOWN FILE "btn-down-arrow":U
     1317        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1318        LABEL "":L
