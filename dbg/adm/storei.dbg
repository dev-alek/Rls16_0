     1320   DEFINE BUTTON b-suppay
     1321        IMAGE-UP FILE "btn-down-arrow":U
     1322        IMAGE-DOWN FILE "btn-down-arrow":U
     1323        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1324        LABEL "":L
     1325        SIZE 3 BY .91.
     1326   DEFINE BUTTON Btn_trn-reason
     1327        LABEL "Коды оснований"
     1328        SIZE 20 BY 1 TOOLTIP "Код оснований (причин) создания документов по умолчанию на складе".
     1329   DEFINE VARIABLE varpurch-code-name AS CHARACTER FORMAT "X(256)":U
     1330        LABEL "Тип приобретения"
     1331        VIEW-AS COMBO-BOX INNER-LINES 5
     1332        LIST-ITEMS "Item 1"
     1333        DROP-DOWN-LIST
     1334        SIZE 26 BY 1 NO-UNDO.
     1335   DEFINE VARIABLE EDITOR-1 AS CHARACTER INITIAL "Система налогообложения для выгрузки в XML:"
     1336        VIEW-AS EDITOR NO-BOX
     1337        SIZE 24.6 BY 1.52 NO-UNDO.
     1338   DEFINE VARIABLE fi-holdfirm-code AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1339        LABEL "Фирма для накладных"
     1340         VIEW-AS TEXT
     1341        SIZE 6.6 BY .67
     1342        FGCOLOR 4  NO-UNDO.
