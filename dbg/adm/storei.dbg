      701   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      702   procedure proc-b-attr :
      703   define input parameter p-mode as character no-undo .
      704   define input parameter p-obj-type like ub.clients.obj-type no-undo .
      705   define input parameter p-obj-code like ub.clients.obj-code no-undo .
      706   define variable v-sts as integer no-undo .
      707   define variable vattr-codes as character no-undo .
      708   define variable vattr-labels as character no-undo .
      709   define variable ii as integer no-undo .
      710   define variable v-attr-code like ub.clients-attr.attr-code no-undo .
      711   define variable attr-label as character no-undo .
      712   define variable attr-user-can-edit as logical no-undo .
      713   define variable attr-output-display as logical no-undo .
      714   define variable attr-other as char no-undo .
      715   define variable v-prop-list as character no-undo .
      716   define variable v-prop-type-list as character no-undo .
      717   define variable v-prop-label-list as character no-undo .
      718   define variable v-global as logical no-undo .
      719   define variable v-host as logical no-undo .
      720   define variable v-shop as logical no-undo .
      721   define variable v-store as logical no-undo .
      722   define variable v-db as logical   no-undo .
      723   define variable attr-value as char no-undo .
      724   define variable v-spr as character no-undo .
      725   define variable v-title as character no-undo .
      726   define variable v-ii as integer no-undo .
      727   define variable v-ok as integer no-undo .
      728   define variable v-rid-list as character no-undo .
      729   define variable v-rec as recid no-undo .
      730   define variable conf-par as character no-undo .
      731   define variable par-type as character no-undo .
      732   define variable v-firm-code as integer   no-undo .
      733   define variable v-from-obj-code  as integer no-undo .
      734   define variable v-found as decimal no-undo .
      735   define buffer buf_clients for ub.clients.
      736   define buffer buf_sysconf for ub.sysconf.
      737   define buffer buf_shop for ub.shop.
      738   define buffer buf_store for ub.store.
      739   define buffer buf_db for ub.db.
      740   do
      741   on error undo, return error
      742   :
      743   assign
      744   vattr-codes = "":U
      745   vattr-labels = "":U
      746   .
      747   _II:
      748   DO ii = 1 to num-entries('autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U):
      749     run thbjattr_code (
      750                          input entry(ii, 'autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U)
      751                         ,input   '':U
      752                         ,output  attr-label
      753                         ,output  attr-user-can-edit
      754                         ,output  attr-output-display
      755                         ,output  attr-other
      756                         ,output v-prop-list
      757                         ,output v-prop-type-list
      758                         ,output v-prop-label-list
      759                         ,output v-global
      760                         ,output v-host
      761                         ,output v-shop
      762                         ,output v-store
      763                         ,output v-db
      764                       ) no-error.
      765       .
      766       if NOT error-status:error
      767       and attr-user-can-edit
      768       and index(attr-other, "spr-ext=") > 0
      769       anD (if p-obj-type = 'маг':U
      770            then v-shop
      771            else (if p-obj-type = 'скл':U
      772                  then v-store
      773                  else (if p-obj-type = 'орг':U
      774                        then v-host
      775                        else (if p-obj-type = 'БД':U
      776                             then v-db
      777                             else v-global)
      778                       )
      779                  )
      780            ) then do:
      781         if entry(ii, 'autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U) = 'alias-tpsi':U then do:
      782   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      783     (input  'tpsi'
      784     ,input  0
      785     ,input  ''
      786     ,input  0
      787     ,input  ''
      788     ,input  ''
      789     ,input  ''
      790     ,input  no
      791     ,output conf-par
      792     ,output par-type
      793     ) no-error .
      794           if error-status:error
      795           or (conf-par <> "yes") then next _ii.
      796         end.
      797         assign
      798         vattr-codes = vattr-codes + chr(44) + entry(ii, 'autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U)
      799         vattr-labels = vattr-labels + chr(44) + attr-label
      800         .
      801       end.
      802   end.
      803   CASE p-mode:
      804     when 'ПРОСМОТР':U then do:
      805       assign
      806       v-title = "Выберите типы параметров для просмотра".
      807     end.
      808     when 'ИЗМЕНЕНИЕ':U then do:
      809       assign
      810       v-title = "Выберите типы параметров для редактирования".
      811     end.
      812     when  'КОПИРОВАНИЕ':U then do:
      813       assign
      814       v-title = "Выберите типы параметров для копирования".
      815     end.
      816   END CASE.
      817   run gbl/d-list.w (
      818                  INPUT (if p-mode = 'КОПИРОВАНИЕ':U then "b-sel,b-mark":U else "b-sel":U)
      819                 ,INPUT v-title
      820                 ,INPUT vattr-codes
      821                 ,INPUT vattr-labels
      822                 ,INPUT chr(44)
      823                 ,INPUT "":U
      824                 ,output v-attr-code).
      825   IF v-attr-code = "":u THEN do:
      826     RETURN ''.
      827   end.
      828   if p-mode = 'ПРОСМОТР':U
      829   or p-mode = 'ИЗМЕНЕНИЕ':U then do:
      830     run thbjattr_code  in this-procedure (
      831          input   v-attr-code
      832         ,input   '':U
      833         ,output  attr-label
      834         ,output  attr-user-can-edit
      835         ,output  attr-output-display
      836         ,output  attr-other
      837         ,output v-prop-list
      838         ,output v-prop-type-list
      839         ,output v-prop-label-list
      840         ,output v-global
      841         ,output v-host
      842         ,output v-shop
      843         ,output v-store
      844         ,output v-db
      845     ).
      846     do ii = 1 to num-entries(attr-other, chr(47)):
      847       if entry(ii, attr-other, chr(47)) begins "spr-ext=":U then do:
      848         assign
      849         v-spr = entry(2, entry(ii, attr-other, chr(47)), "=").
      850       end.
      851     end.
      852     run value(v-spr) (
      853                      input parparentproc
      854                     ,input p-mode
      855                     ,input p-obj-type
      856                     ,input p-obj-code
      857                     ).
      858   end.
      859   else do:
      860      if p-obj-type = 'маг':U then do:
      861       message
      862       "Выберите магазин для копирования ПАРАМЕТРОВ"
      863       view-as alert-box WARNING.
      864         run adm/shops.w ( input parparentproc
      865                          ,input "b-sel"
      866                          ,input-output v-rid-list
      867                          ,no ).
      868        if v-rid-list = "":U then return.
      869        find first buf_shop no-lock where
      870                 recid(buf_shop) = integer(v-rid-list) .
      871        v-from-obj-code = buf_shop.obj-code.
      872      end.
      873      if p-obj-type = 'орг':U then do:
      874         message
      875         "Выберите ФИРМУ для копирования ПАРАМЕТРОВ"
      876         view-as alert-box WARNING.
      877         run adm/sconfs.w (
      878               input parParentProc
      879             , input "b-sel":U
      880             , input no
      881             , input 0
      882             , output v-firm-code
      883             , input-output v-rid-list
      884         ) no-error.
      885         if v-rid-list = "":U then return.
      886       find first buf_sysconf no-lock
      887                         where recid(buf_sysconf) = integer(entry(1, v-rid-list)).
      888       v-from-obj-code = buf_sysconf.host-code.
      889      end.
      890      if p-obj-type = 'скл':U then do:
      891       message
      892       "Выберите склад для копирования ПАРАМЕТРОВ"
      893       view-as alert-box WARNING.
      894         run adm/stores.w ( input parparentproc
      895                           ,input "b-sel"
      896                           ,input-output v-rid-list
      897                           ,input no ).
      898        if v-rid-list = "":U then return.
      899        find first buf_store no-lock where
      900                 recid(buf_store) = integer(v-rid-list) .
      901        v-from-obj-code = buf_store.obj-code.
      902      end.
      903      if p-obj-type = 'БД':U then do:
      904         message
      905         "Выберите БД для копирования ПАРАМЕТРОВ"
      906         view-as alert-box WARNING.
      907         run adm/dbs.w (
      908               input parParentProc
      909             , input 'ПРОСМОТР':U
      910             , output v-rec
      911         ) no-error.
      912         if v-rec = ? then return.
      913       find first buf_db no-lock
      914                         where recid(buf_db) = v-rec.
      915       v-from-obj-code = buf_db.db-num.
      916      end.
      917      if (p-obj-type = 'маг':U
      918      AND p-obj-code = buf_shop.obj-code )
      919      or (p-obj-type = 'скл':U
      920      AND p-obj-code = buf_store.obj-code )
      921      or (p-obj-type = 'орг':U
      922      AND p-obj-code = buf_sysconf.host-code )
      923      or (p-obj-type = 'БД':U
      924      AND p-obj-code = buf_db.db-num )
      925      or (p-obj-type = '':U
      926      AND p-obj-code = 0 )
      927      then do:
      928        message "Нельзя копировать ПАРАМЕТРЫ самих в себя"
      929        view-as alert-box error .
      930        return error .
      931      end.
      932      run waitfram-show in this-procedure ( input "Ждите..." ).
      933      DO ii = 1 to num-entries(v-attr-code):
      934         for each thbjattr_thbj-attr:
      935           delete thbjattr_thbj-attr.
      936         end.
      937         assign
      938         v-ii = v-ii + 1.
      939         run thbjattr_get-section  in this-procedure (
      940              input  p-obj-type
      941             ,input  v-from-obj-code
      942             ,input  entry(ii, v-attr-code)
      943             ,input '':U
      944             ,input-output table thbjattr_thbj-attr
      945             ,output v-found
      946                                                 ) no-error .
      947         if not error-status:error then do:
      948           run thbjattr_set-section in this-procedure (
      949                                                  input p-obj-type
      950                                                 ,input p-obj-code
      951                                                 ,input entry(ii, v-attr-code)
      952                                                 ,input table thbjattr_thbj-attr ) no-error .
      953           if not error-status:error then
      954           assign
      955           v-ok = v-ok + 1
      956           .
      957         end.
      958      end.
      959      run waitfram-hide in this-procedure .
      960      if v-ii = v-ok then do:
      961         message
      962         substitute("Скопировано &1 параметров с &4&5 на &2&3"
      963                    , v-ok
      964                    , p-obj-type
      965                    , p-obj-code
      966                    , p-obj-type
      967                    , v-from-obj-code
      968                    )
      969         view-as alert-box .
      970      end.
      971      else do:
      972         message
      973         substitute("Из &1 параметров удалось скопировать &2 параметров с &3&4 на &5&6"
      974                    , v-ii
      975                    , v-ok
      976                    , p-obj-type
      977                    , p-obj-code
      978                    , p-obj-type
      979                    , v-from-obj-code
      980                    )
      981         view-as alert-box WARNING.
      982      end.
      983   end.
      984   end.
      985   end procedure.
      986   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      987   define variable v-waitfram-action01         as character   no-undo .
      988   define variable v-waitfram-action02         as character   no-undo .
      989   define variable v-waitfram-action03         as character   no-undo .
      990   define variable mWaitFramTextBeg            as character   no-undo.
      991   define variable mWaitFramTextEnd            as character   no-undo.
      992   define variable mWaitFramView               as logical     no-undo.
      993   define variable mWaitProcEvent              as logical     no-undo init yes.
      994   define variable mWaitFramInterval           as integer     no-undo init 1 .
      995   define variable mWaitFramStop               as logical     no-undo.
      996   define variable mWaitFramStopUser           as logical     no-undo.
      997   define variable mWaitFramStopTimeOut        as logical     no-undo.
      998   define variable mWaitFramStartProc          as datetime-tz no-undo.
      999   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1000   define button B-WaitFramStop auto-end-key
     1001        label "Стоп"
     1002        size 10 by 1 tooltip "Остоновить процесс".
     1003   define button B-viewProcInfo
     1004        label "Информация"
     1005        size 15 by 1 tooltip "Информация о процесс".
     1006   define frame waitfram
     1007     v-waitfram-action01 format "x(72)" no-label skip
     1008     v-waitfram-action02 format "x(72)" no-label skip
     1009     v-waitfram-action03 format "x(72)" no-label skip
     1010     B-viewProcInfo
     1011     B-WaitFramStop at row 4 col 30
     1012     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1013     .
     1014   define new global shared variable mBatchMode as logical no-undo init ?.
     1015   define variable mFramBachModHandle as handle no-undo.
     1016   mFramBachModHandle = frame waitfram:handle.
     1017   define variable mFameOldVis as logical no-undo.
     1018   define variable mVisCUrentVin as logical no-undo.
     1019   if session:batch-mode
     1020   then
     1021      mBatchMode = yes.
     1022   if mBatchMode = ? then do:
     1023     mVisCUrentVin = current-window:visible.
     1024     mFameOldVis = mFramBachModHandle:visible.
     1025     mFramBachModHandle:visible  = yes.
     1026     mBatchMode = mFramBachModHandle:visible ne yes.
     1027     mFramBachModHandle:visible = mFameOldVis.
     1028     current-window:visible = mVisCUrentVin.
     1029   end.
     1030    if  log-manager:logfile-name ne ?
     1031     then DO:
     1032         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1033         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1034         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1035     end.
     1036   on choose of B-WaitFramStop in frame waitfram
     1037   do:
     1038     mWaitFramStop = yes.
     1039     mWaitFramStopUser = yes.
     1040   end.
     1041   function waitfram-check-timeout returns logical():
     1042      define variable vtime as int64 no-undo.
     1043      if mWaitFramStopTimeOut
     1044      then
     1045         return yes.
     1046      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1047      if     mWaitFramTimeOut ne ?
     1048         and mWaitFramTimeOut ne 0
     1049         and mWaitFramTimeOut lt vtime
     1050      then do:
     1051         mWaitFramStopTimeOut = yes.
     1052      end.
     1053      return mWaitFramStopTimeOut.
     1054   end.
     1055   procedure waitfram-hide :
     1056     if not session:batch-mode
     1057     then do
     1058     on error undo, return error return-value
     1059     :
     1060       pause 0 before-hide .
     1061       if not mBatchMode then
     1062         hide frame waitfram .
     1063     if     not mWaitFramView
     1064        and mWaitProcEvent
     1065     then
     1066       process events .
     1067     end.
     1068   end procedure.
     1069   procedure waitfram-show :
     1070     define input  parameter p-message as character no-undo .
     1071     define variable v-left-margin as integer   no-undo .
     1072     if not session:batch-mode
     1073     then do
     1074     on error undo, return error return-value
     1075     :
     1076       if length(p-message) <= 70 then do:
     1077         assign
     1078           v-left-margin = integer((70 - length(p-message)) / 2)
     1079         .
     1080         assign
     1081           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1082         .
     1083         assign
     1084           v-waitfram-action01 = " "
     1085           v-waitfram-action02 = " "
     1086                                    + fill(" ", v-left-margin)
     1087                                    + p-message
     1088           v-waitfram-action03 = " "
     1089         .
     1090       end.
     1091       else do:
     1092         define variable vRindex1 as integer no-undo.
     1093         define variable vRindex2 as integer no-undo.
     1094         vRindex1 = r-index(p-message," ",70).
     1095         if vRindex1 = 0
     1096         then
     1097            vRindex1 = 70.
     1098         if length(p-message)  <= vRindex1 + 70 then do:
     1099           assign
     1100             v-waitfram-action01 = " "
     1101             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1102             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1103           .
     1104         end.
     1105         else do:
     1106           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1107           if vRindex2 <= vRindex1
     1108           then
     1109              vRindex2 = vRindex1 + 70.
     1110           assign
     1111             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1112             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1113             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1114           .
     1115         end.
     1116       end.
     1117       B-viewProcInfo:visible   in frame waitfram = no.
     1118       B-viewProcInfo:sensitive in frame waitfram = no.
     1119       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1120       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1121       if  (   mWaitFramView
     1122          or  mWaitProcEvent)
     1123          and not mBatchMode
     1124       then
     1125          display
     1126             v-waitfram-action01 skip
     1127             v-waitfram-action02 skip
     1128             v-waitfram-action03 skip
     1129          with frame waitfram .
     1130       if     mWaitFramView
     1131          then do:
     1132             if     mWaitFramInterval ne ?
     1133                and not mBatchMode
     1134             then
     1135                wait-for go of frame waitfram pause mWaitFramInterval.
     1136          end.
     1137          else
     1138             if     mWaitProcEvent
     1139                and not mBatchMode
     1140             then
     1141                process events .
     1142     end.
     1143   end procedure.
     1144      procedure waitfram-show-this:
     1145         define input  parameter iInterval as int64 no-undo.
     1146         define variable vtime as int64 no-undo.
     1147         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1148         mWaitFramInterval = iInterval.
     1149         run waitfram-show (substitute("&1&2 &3&4" ,
     1150                                       mWaitFramTextBeg ,
     1151                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1152                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1153                                       mWaitFramTextEnd
     1154                                      )
     1155                           ).
     1156      end.
     1157      procedure WaitFramRunPause:
     1158         define input  parameter iInterval as dec no-undo.
     1159         define variable vStart  as datetime-tz no-undo.
     1160         define variable vend    as datetime-tz no-undo.
     1161         define variable vint as int64 no-undo.
     1162         define variable vOk as logical no-undo.
     1163         vStart = now.
     1164         vend   = vStart.
     1165         publish "WaitFramPause" (iInterval,output vOk).
     1166         vend   =  now.
     1167         vint = vend - vStart.
     1168         vint = iInterval - vint / 1000.
     1169         if     not mWaitFramStop
     1170            and (   vint > 0
     1171                 or (    not vOk
     1172                     and iInterval eq ?
     1173                     )
     1174                 )
     1175         then
     1176            run waitfram-show-this (iInterval).
     1177         vend   =  now.
     1178         vint = vend - vStart.
     1179         vint = iInterval - vint / 1000.
     1180         if     not mWaitFramStop
     1181            and vint > 0
     1182         then do:
     1183            run gbl/pause.p (vint * 1000).
     1184         end.
     1185         if iInterval ne ?
     1186         then
     1187            publish "WaitFramStop".
     1188         waitfram-check-timeout().
     1189      end.
     1190      procedure WaitFramWaitFor:
     1191         define input  parameter iInterval as dec no-undo.
     1192         assign
     1193            mWaitFramStartProc   = now
     1194            mWaitFramStopUser    = no
     1195            mWaitFramStopTimeOut = no
     1196         .
     1197         block-wait:
     1198         do while not mWaitFramStop:
     1199            run WaitFramRunPause (iInterval).
     1200            if  waitfram-check-timeout()
     1201            then do:
     1202               leave block-wait.
     1203            end.
     1204         end.
     1205         run waitfram-hide.
     1206      end.
     1207   procedure waitfram-join :
     1208     define input  parameter p-line-1  as character no-undo .
     1209     define input  parameter p-line-2  as character no-undo .
     1210     define input  parameter p-line-3  as character no-undo .
     1211     define output parameter p-message as character no-undo .
     1212     do
     1213     on error undo, return error return-value
     1214     :
     1215       assign
     1216         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1217                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1218                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1219       .
     1220     end.
     1221   end procedure.
     1222   function waitfram-join-function returns character
     1223     (input p-line-1 as character
     1224     ,input p-line-2 as character
     1225     ,input p-line-3 as character
     1226     ).
     1227     define variable v-message as character no-undo .
     1228     run waitfram-join in this-procedure
     1229       (input  p-line-1
     1230       ,input  p-line-2
     1231       ,input  p-line-3
     1232       ,output v-message
     1233       ) .
     1234     return v-message .
     1235   end function .
     1236   define buffer buf_cli-grp for ub.cli-grp .
     1237   define buffer buf_cli-host for ub.clients .
     1238   define variable v-db-num like ub.db.db-num no-undo .
     1239   define variable ref-list as character no-undo .
     1240   define variable new-host-code as integer no-undo .
     1241   DEFINE VARIABLE v-envd AS CHARACTER NO-UNDO.
     1242   DEFINE VARIABLE v-pharm AS CHARACTER NO-UNDO.
     1243   DEFINE VARIABLE v-type AS CHARACTER NO-UNDO.
     1244   define variable v-storei-have-holdfirm    as logical      no-undo.
     1245   DEFINE VARIABLE v-kpp AS CHARACTER NO-UNDO.
     1246   DEFINE MENU MENU-obj-code
     1247          MENU-ITEM m-choose       LABEL "Подобрать свободный код".
     1248   DEFINE BUTTON B-attr
