     1844   ON CHOOSE OF Btn_trn-reason IN FRAME Dialog-Frame
     1845   DO:
     1846     run str/obj-rsn.w ( input parparentproc
     1847                   , input 'скл':U
     1848                   , input p-obj-code
     1849                   , input ( if p-mode = 'ПРОСМОТР':U then 'ПРОСМОТР':U else 'работа':U )
     1850                   ) .
     1851   END.
     1852   ON CTRL-enter OF tt-clients.db-num IN FRAME Dialog-Frame
     1853   DO:
     1854       define variable  ri as recid no-undo.
     1855     define buffer buf_db for ub.db .
     1856     run adm/dbs.w (
     1857                   input parparentproc
     1858                  ,input 'ПРОСМОТР':U
     1859                  ,output ri).
     1860     if ri <> ? then  do:
     1861       FIND first buf_db where recid( ub.db ) = ri .
     1862       display
     1863       buf_db.db-num @ tt-clients.db-num
     1864       with frame Dialog-Frame.
     1865     end.
     1866   END.
     1867   ON RETURN OF tt-clients.db-num IN FRAME Dialog-Frame
     1868   DO:
     1869      RUN chk-db no-error.
     1870     if error-status:error  THEN do:
     1871       apply "ctrl-enter":U to self.
     1872       return no-apply.
     1873     end.
     1874   END.
     1875   ON VALUE-CHANGED OF tt-store.doc-prt IN FRAME Dialog-Frame
     1876   DO:
     1877     define variable glog as logical no-undo .
     1878     if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
     1879       if (tt-store.doc-prt:checked ) <> tt-store.doc-prt
     1880       then do:
     1881         run trg/objatchk.p
     1882           (input 'скл':U
     1883           ,input tt-store.obj-code
     1884           ,input "doc-prt":u
     1885           ,input tt-store.doc-prt :checked in frame Dialog-Frame
     1886           ) no-error .
     1887         if error-status :error then do:
     1888           assign
     1889           tt-store.doc-prt :checked in frame Dialog-Frame = tt-store.doc-prt
     1890           .
     1891           return no-apply .
     1892         end.
     1893       end.
     1894     end.
     1895   END.
     1896   ON CHOOSE OF MENU-ITEM m-choose
     1897   DO:
     1898      DEFINE VARIABLE v-obj-code LIKE ub.clients.obj-code NO-UNDO.
     1899     run ref/chs-code.w ('скл':U, v-cntxt-db-num, OUTPUT v-obj-code) no-error .
     1900     if not error-status:error
     1901     and v-obj-code <> ? then do:
     1902       display
     1903       v-obj-code @ tt-store.obj-code
     1904       with frame Dialog-Frame .
     1905     end.
     1906   END.
     1907   ON VALUE-CHANGED OF tt-store.shift-on IN FRAME Dialog-Frame
     1908   DO:
     1909       if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
     1910       if tt-store.shift-on :checked in frame Dialog-Frame <> tt-store.shift-on
     1911       then do:
     1912         run trg/objatchk.p
     1913           (input 'скл':U
     1914           ,input tt-store.obj-code
     1915           ,input "shift-on":u
     1916           ,input tt-store.shift-on :checked in frame Dialog-Frame
     1917           ) no-error .
     1918         if error-status :error
     1919         then do:
     1920           assign
     1921           tt-store.shift-on :checked in frame Dialog-Frame = tt-store.shift-on
     1922           .
     1923           return no-apply .
     1924         end.
     1925       end.
     1926     end.
     1927   END.
     1928   ON VALUE-CHANGED OF varenvd IN FRAME Dialog-Frame
     1929   DO:
     1930     ASSIGN FRAME
     1931       Dialog-Frame varenvd.
     1932   END.
     1933   ON VALUE-CHANGED OF varpharm IN FRAME Dialog-Frame
     1934   DO:
     1935     ASSIGN FRAME
     1936       Dialog-Frame varpharm.
     1937   END.
     1938   ON VALUE-CHANGED OF varpurch-code-name IN FRAME Dialog-Frame
     1939   DO:
     1940     ASSIGN FRAME Dialog-Frame
     1941       varpurch-code-name.
     1942   END.
     1943   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1944   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1945   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1946   on help of frame Dialog-Frame
     1947   do:
     1948     run gbl/app_help.p
     1949       (input this-procedure :file-name
     1950       ,input ''
     1951       ,input ?
     1952       ) no-error.
     1953     if error-status :error then do:
     1954       message
     1955         "Ошибка при вызове помощи"
     1956         error-status :get-message(1)
     1957         view-as alert-box .
     1958     end.
     1959   end.
     1960   run minbtn-set in this-procedure .
     1961   on choose of b-help in frame Dialog-Frame
     1962   do:
     1963     apply "help":u to frame Dialog-Frame .
     1964   end.
     1965   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1966   procedure minbtn-set :
     1967       do
     1968           on error undo, return error return-value
     1969           :
     1970           define variable ii              as integer       no-undo .
     1971           define variable fh              as widget-handle no-undo .
     1972           define variable hh              as widget-handle no-undo .
     1973           define variable v-h             as handle        extent 4 no-undo .
     1974           define variable v-name-button   as character     no-undo .
     1975           define variable v-help-old-x    as decimal       no-undo .
     1976           define variable v-help-old-y    as decimal       no-undo .
     1977           define variable v-help-old-size as decimal       no-undo .
     1978           define variable v-frame-width   as decimal       no-undo .
     1979           define variable jj              as integer       no-undo .
     1980           do
     1981               on error undo, return error
     1982               :
     1983               assign
     1984                   v-frame-width = frame Dialog-Frame:width - 0.3
     1985                   fh            = frame Dialog-Frame:first-child
     1986                   hh            = fh:first-child
     1987                   ii            = 1
     1988                   .
     1989               do while valid-handle(hh):
     1990                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1991                   do:
     1992                       case lc(hh:name) :
     1993                           when "b-help" then
     1994                               do:
     1995                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1996                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1997                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1998                                   hh:TOOLTIP = "Помощь" .
     1999                                   v-help-old-x = hh:column .
     2000                                   v-help-old-y = hh:row    .
     2001                                   v-help-old-size = hh:width .
     2002                                   hh:width-chars = 2.5 .
     2003                               end.
     2004                           when "b-print" then
     2005                               do:
     2006                                   hh:load-image("cmp/b-print.bmp":u) .
     2007                                   hh:TOOLTIP = "Печать" .
     2008                                   v-h[ii] = hh:handle .
     2009                                   ii = ii + 1 .
     2010                                   hh:width-chars = 3 .
     2011                               end.
     2012                           when "b-history" or
     2013                           when "b-hist" then
     2014                               do:
     2015                                   hh:load-image("cmp/b-hist.bmp":u) .
     2016                                   hh:TOOLTIP = "История" .
     2017                                   v-h[ii] = hh:handle .
     2018                                   ii = ii + 1 .
     2019                                   hh:width-chars = 3 .
     2020                               end.
     2021                           when "b-sch" then
     2022                               do:
     2023                                   hh:load-image("cmp/b-sch.bmp":u) .
     2024                                   hh:TOOLTIP = "Установка Фильтра" .
     2025                                   v-h[ii] = hh:handle .
     2026                                   ii = ii + 1 .
     2027                                   hh:width-chars = 3 .
     2028                               end.
     2029                           when "b-hist-user" then
     2030                               do:
     2031                                   hh:load-image("cmp/b-hist.bmp":u) .
     2032                                   hh:TOOLTIP = "История пользователя" .
     2033                                   ii = ii + 1 .
     2034                               end.
     2035                       end case.
     2036                   end.
     2037                   hh = hh:next-sibling.
     2038               end.
     2039               b-help:column = v-frame-width - b-help:width-chars.
     2040               jj = 0.
     2041               repeat ii = 4 to 1 by -1 :
     2042                   if valid-handle (v-h[ii] ) then
     2043                   do:
     2044                       jj  = jj + 1 .
     2045                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2046                       v-h[ii]:row    = v-help-old-y .
     2047                   end.
     2048               end.
     2049           end.
     2050       end.
     2051   end procedure.
     2052   MAIN-BLOCK:
     2053   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2054      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2055   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2056     run mainmenu_getcntxt in parparentproc
     2057       (output v-cntxt-db-num
     2058       ,output v-cntxt-userid
     2059       ,output v-cntxt-level
     2060       ,output v-cntxt-host-code-obj
     2061       ,output v-cntxt-obj-type
     2062       ,output v-cntxt-obj-code
     2063       ,output v-cntxt-db-num-obj
     2064       ,output v-cntxt-is-admin
     2065       ) .
     2066      if p-mode <> 'ДОБАВЛЕНИЕ':U and
     2067         p-mode <> 'ИЗМЕНЕНИЕ':U  and
     2068         p-mode <> 'ПРОСМОТР':U
     2069    then do:
     2070       message
     2071       vss-workfile vss-revision vss-description skip
     2072       "Неверное значение параметров вызова p-mode"  p-mode
     2073       view-as alert-box ERROR.
     2074       undo, return error.
     2075    end.
     2076   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2077   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2078     (output v-db-num
     2079     )  .
     2080   if p-mode <> 'ПРОСМОТР':U then do:
     2081     if v-db-num <> 0 then do:
     2082       message
     2083       vss-workfile vss-revision vss-description skip
     2084       "Неверное значение параметров вызова p-mode - нельзя изменять/добавлять записи СКЛАД в УБД"
     2085       view-as alert-box ERROR.
     2086       undo, return error.
     2087     end.
     2088   end.
     2089   for each tt-store:
     2090     delete tt-store.
     2091   end.
     2092   for each tt-clients:
     2093     delete tt-clients.
     2094   end.
     2095   if p-mode = 'ДОБАВЛЕНИЕ':U  then do:
     2096       message
     2097       "Вам следует выбрать группу," skip
     2098       "к которой будет относиться склад."
     2099       view-as alert-box.
     2100       ref-list = "".
     2101       run ref/cli-grps.w ( input parparentproc, "b-sel", input-output ref-list ) .
     2102       if ref-list <> "" then  do:
     2103         FIND buf_cli-grp where
     2104             recid( buf_cli-grp ) = integer( ref-list ) .
     2105         if can-find( FIRST ub.cli-grp where ub.cli-grp.upper-code = buf_cli-grp.node-code )
     2106         then do:
     2107           message
     2108           "Добавлять можно только в группы," skip
     2109           "у которых нет подгрупп." skip
     2110           "Выбирайте другую группу !".
     2111           return .
     2112         end.
     2113       end.
     2114       else return .
     2115       create tt-clients.
     2116       create tt-store.
     2117       assign
     2118       tt-clients.grp-code = buf_cli-grp.node-code
     2119       tt-clients.obj-type = 'скл':U
     2120       tt-store.doc-prt = false
     2121       tt-store.work-hours = if tt-store.work-hours <> "" then tt-store.work-hours else "08.00,20.00"
     2122       .
     2123     end.
     2124     else do:
     2125       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     2126         do transaction
     2127         ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2128         ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2129           FIND first locked_clients exclusive-lock where
     2130                   recid( locked_clients ) = p-rid no-error .
     2131           if not available locked_clients then do:
     2132             FIND first locked_clients exclusive-lock where
     2133                     locked_clients.obj-type = 'скл':U
     2134                   AND locked_clients.obj-code = p-obj-code no-wait no-error .
     2135           if locked locked_clients then do:
     2136             message
     2137             vss-workfile vss-revision vss-description skip
     2138             "Запись КЛИЕНТ для СКЛАДА" p-obj-code "занята"
     2139             view-as alert-box error .
     2140             undo, return error.
     2141           end.
     2142           end.
     2143           FIND first locked_store exclusive-lock where
     2144                     locked_store.obj-code = locked_clients.obj-code .
     2145         end.
     2146       end.
     2147       if p-mode = 'ПРОСМОТР':U then do:
     2148         FIND first locked_clients no-lock where
     2149                 recid( locked_clients ) = p-rid.
     2150         FIND first locked_store no-lock where
     2151                   locked_store.obj-code = locked_clients.obj-code .
     2152       end.
     2153       create tt-clients.
     2154       create tt-store.
     2155       buffer-copy locked_clients to tt-clients.
     2156       buffer-copy locked_store to tt-store.
     2157       FIND FIRST buf_cli-host NO-LOCK WHERE
     2158                  buf_cli-host.obj-code = locked_store.host-code AND
     2159                  buf_cli-host.obj-type = 'орг':U NO-ERROR.
     2160         if avail buf_cli-host then do:
     2161           assign
     2162           frame Dialog-Frame:title =
     2163           "Настройки склада фирмы ~"" + buf_cli-host.obj-name +
     2164           "~" ("   + string( tt-store.host-code )   + ").".
     2165         end.
     2166       end.
     2167       assign
     2168       tt-store.work-hours = if tt-store.work-hours <> "" then tt-store.work-hours else "08.00,20.00"
     2169       .
     2170     ASSIGN
     2171       varpurch-code-name:LIST-ITEMS = "по настройкам фирмы" + "," + 'выкуп,консигнация,ответственное хранение,старая консигнация':U.
     2172     IF tt-store.purch-code = ? THEN DO:
     2173       ASSIGN
     2174         varpurch-code-name = "по настройкам фирмы".
     2175     END.
     2176     ELSE DO:
     2177           assign
     2178         varpurch-code-name = entry (lookup (string(tt-store.purch-code), '1,2,3,4':U), 'выкуп,консигнация,ответственное хранение,старая консигнация':U).
     2179     END.
     2180       RUN clntattr-value IN THIS-PROCEDURE
     2181       (INPUT 'скл':U,
     2182        INPUT tt-store.obj-code,
     2183        INPUT 'envd':U,
     2184        OUTPUT v-envd,
     2185        OUTPUT v-type).
     2186     IF v-envd = "yes":u THEN DO:
     2187       ASSIGN
     2188         varenvd = YES.
     2189     END.
     2190     ELSE DO:
     2191       ASSIGN
     2192         varenvd = NO.
     2193     END.
     2194     RUN clntattr-value IN THIS-PROCEDURE
     2195       (INPUT 'скл':U,
     2196        INPUT tt-store.obj-code,
     2197        input 'kpp':U,
     2198        OUTPUT v-kpp,
     2199        OUTPUT v-type).
     2200      kpp:screen-value = v-kpp.
     2201       RUN clntattr-value IN THIS-PROCEDURE
     2202       (INPUT 'скл':U,
     2203        INPUT tt-store.obj-code,
     2204        INPUT 'pharm':U,
     2205        OUTPUT v-pharm,
     2206        OUTPUT v-type).
     2207     IF v-pharm = "yes":u THEN DO:
     2208       ASSIGN
     2209         varpharm = YES.
     2210     END.
     2211     ELSE DO:
     2212       ASSIGN
     2213         varpharm = NO.
     2214     END.
     2215     run init-firmhold in this-procedure.
     2216     RUN Myenable.
     2217     if p-mode = 'ДОБАВЛЕНИЕ':U then
     2218         WAIT-FOR GO OF FRAME Dialog-Frame FOCUS tt-store.obj-code.
     2219     else
     2220         WAIT-FOR GO OF FRAME Dialog-Frame FOCUS tt-clients.obj-name .
     2221   END.
     2222   RUN disable_UI.
     2223   PROCEDURE chk-db :
     2224      if ( not can-find( ub.db where ub.db.db-num = input FRAME Dialog-Frame tt-clients.db-num ))
     2225     then do:
     2226         message "Неверный номер. Номер может быть:" skip
     2227                         "    0, 1, ... -- номер существующей БД" skip
     2228                         " CTRL-ENTER  -- вызов справочника."  view-as alert-box.
     2229         apply "ENTRY":U  to tt-clients.db-num IN FRAME Dialog-Frame.
     2230         return error.
     2231     end.
     2232   END PROCEDURE.
     2233   PROCEDURE disable_UI :
     2234     HIDE FRAME Dialog-Frame.
     2235   END PROCEDURE.
     2236   PROCEDURE enable_UI :
     2237     DISPLAY KPP varpharm varenvd varpurch-code-name EDITOR-1
     2238             fi-holdfirm-code fi-holdfirm-name
     2239         WITH FRAME Dialog-Frame.
     2240     IF AVAILABLE tt-clients THEN
     2241       DISPLAY tt-clients.db-num tt-clients.obj-name tt-clients.PS
     2242         WITH FRAME Dialog-Frame.
     2243     IF AVAILABLE tt-store THEN
     2244       DISPLAY tt-store.obj-code tt-store.store-man tt-store.store-boss
     2245             tt-store.addres1 tt-store.phone tt-store.addres2 tt-store.fax
     2246             tt-store.work-hours tt-store.holidays tt-store.load-time
     2247             tt-store.rsrv-time tt-store.in-pay tt-store.doc-prt tt-store.out-pay
     2248             tt-store.price-calc tt-store.no-eq tt-store.ret-pay
     2249             tt-store.unit-cli-perm tt-store.ret-sup-pay tt-store.out-line-discnt
     2250             tt-store.down-pay tt-store.out-rate tt-store.in-ov tt-store.inv-pay
     2251             tt-store.inout-price tt-store.fbr-pay tt-store.shift-on
     2252         WITH FRAME Dialog-Frame.
     2253     ENABLE B-exit b-quit b-reset b-host tt-clients.db-num b-db B-hist B-Help
     2254            RECT-10 tt-store.obj-code B-attr tt-clients.obj-name Btn_trn-reason
     2255            tt-store.store-man KPP tt-store.store-boss tt-store.addres1
     2256            tt-store.phone tt-store.addres2 tt-store.fax tt-store.work-hours
     2257            tt-store.holidays tt-store.load-time tt-store.rsrv-time
     2258            tt-store.in-pay b-inpay tt-store.doc-prt tt-store.out-pay b-outpay
     2259            tt-store.price-calc tt-store.no-eq tt-store.ret-pay b-retpay
     2260            tt-store.unit-cli-perm tt-store.ret-sup-pay b-suppay
     2261            tt-store.out-line-discnt tt-store.down-pay b-spipay tt-store.out-rate
     2262            tt-store.in-ov tt-store.inv-pay b-invpay tt-store.inout-price
     2263            tt-store.fbr-pay b-fbrpay tt-store.shift-on varpharm varenvd
     2264            b-holdfirm tt-clients.PS
     2265         WITH FRAME Dialog-Frame.
     2266     VIEW FRAME Dialog-Frame.
     2267   END PROCEDURE.
     2268   PROCEDURE init-firmhold :
     2269       define variable v-outhold       as character    no-undo.
     2270       define variable v-par-type      as character    no-undo.
     2271       define variable v-firm-code-str as character    no-undo.
     2272       define variable v-firm-code     as integer      no-undo.
     2273       define buffer buf_clients   for ub.clients.
     2274       define buffer buf_store     for ub.store.
     2275   do
     2276   for buf_clients
     2277     , buf_store
     2278   on error undo, return error
     2279   :
     2280       if available tt-store
     2281       and tt-store.host-code <> 0
     2282       then do:
     2283           find first buf_store no-lock
     2284                where buf_store.obj-code = tt-store.obj-code
     2285           no-error.
     2286           if available buf_store
     2287           then do:
     2288               run gbl/conf-rd.p (
     2289                   input "outhold":U
     2290                   , input tt-store.host-code
     2291                   , input 'скл':U
     2292                   , input tt-store.obj-code
     2293                   , input "":U
     2294                   , input "":U
     2295                   , input "":U
     2296                   , input no
     2297                   , output v-outhold
     2298                   , output v-par-type
     2299               ) no-error.
     2300               if error-status :error
     2301               then do:
     2302                   assign
     2303                       v-outhold            = ""
     2304                   .
     2305               end.
     2306               if v-outhold <> "":U
     2307               then do:
     2308                   assign
     2309                       v-storei-have-holdfirm                              = yes
     2310                   .
     2311                   run clntattr-value in this-procedure (
     2312                       input 'скл':U
     2313                       , input tt-store.obj-code
     2314                       , input 'holdfirm-code':U
     2315                       , output v-firm-code-str
     2316                       , output v-par-type
     2317                   ).
     2318                   assign
     2319                       v-firm-code = integer( v-firm-code-str )
     2320                   no-error.
     2321                   if error-status :error
     2322                   then do:
     2323                       assign
     2324                           v-firm-code = 0
     2325                       .
     2326                   end.
     2327                   else do:
     2328                       if v-firm-code = 0
     2329                       then do:
     2330                           assign
     2331                               fi-holdfirm-code = 0
     2332                               fi-holdfirm-name = "":U
     2333                           .
     2334                       end.
     2335                       else do:
     2336                           find first buf_clients no-lock
     2337                               where buf_clients.obj-type = 'орг':U
     2338                               and buf_clients.obj-code = v-firm-code
     2339                           no-error.
     2340                           if available buf_clients
     2341                           then do:
     2342                               assign
     2343                                   fi-holdfirm-code = v-firm-code
     2344                                   fi-holdfirm-name = buf_clients.obj-name
     2345                               .
     2346                           end.
     2347                           else do:
     2348                               assign
     2349                                   fi-holdfirm-code = 0
     2350                                   fi-holdfirm-name = "":U
     2351                               .
     2352                           end.
     2353                       end.
     2354                   end.
     2355               end.
     2356               else do:
     2357                   assign
     2358                       v-storei-have-holdfirm                              = no
     2359                   .
     2360               end.
     2361           end.
     2362       end.
     2363   end.
     2364   END PROCEDURE.
     2365   PROCEDURE MyENable :
     2366   IF AVAILABLE tt-clients THEN
     2367       DISPLAY
     2368       tt-clients.obj-name
     2369       tt-clients.db-num
     2370       tt-clients.PS
     2371       WITH FRAME Dialog-Frame.
     2372     IF AVAILABLE tt-store THEN
     2373       DISPLAY
     2374       tt-store.obj-code
     2375       tt-store.store-boss
     2376       tt-store.store-man
     2377       tt-store.addres1
     2378       tt-store.phone
     2379       tt-store.addres2
     2380       tt-store.fax
     2381       tt-store.work-hours
     2382       tt-store.holidays
     2383       tt-store.load-time
     2384       tt-store.rsrv-time
     2385       tt-store.in-pay
     2386       tt-store.doc-prt
     2387       tt-store.out-pay
     2388       tt-store.price-calc
     2389       tt-store.no-eq
     2390       tt-store.ret-pay
     2391       tt-store.unit-cli-perm
     2392       tt-store.ret-sup-pay
     2393       tt-store.fbr-pay
     2394       tt-store.down-pay
     2395       tt-store.out-line-discnt
     2396       tt-store.inv-pay
     2397       tt-store.out-rate
     2398       tt-store.in-ov
     2399       tt-store.inout-price
     2400       tt-store.shift-on
     2401       varpurch-code-name
     2402       varenvd
     2403       varpharm
     2404      WITH FRAME Dialog-Frame.
     2405     ENABLE
     2406     RECT-10
     2407     b-quit
     2408     B-Help
     2409     b-hist WHEN p-mode <> 'ДОБАВЛЕНИЕ':U
     2410     b-host
     2411     b-attr WHEN p-mode <> 'ДОБАВЛЕНИЕ':U
     2412     Btn_trn-reason WHEN p-mode <> 'ДОБАВЛЕНИЕ':U
     2413     KPP
     2414     WITH FRAME Dialog-Frame.
     2415     if p-mode = 'ПРОСМОТР':U then do:
     2416       assign
     2417       b-quit:label = "&Выход".
     2418       hide
     2419       b-exit in frame Dialog-Frame.
     2420     end.
     2421     else do:
     2422       ENABLE
     2423       B-exit
     2424       b-reset
     2425       tt-store.obj-code    when p-mode = 'ДОБАВЛЕНИЕ':U
     2426       tt-store.store-boss
     2427       tt-store.store-man
     2428       tt-store.work-hours
     2429       tt-store.holidays
     2430       tt-clients.obj-name
     2431       tt-clients.PS
     2432       tt-store.phone
     2433       tt-store.addres1
     2434       tt-store.addres2
     2435       tt-store.fax
     2436       tt-store.rsrv-time
     2437       tt-store.load-time
     2438       tt-store.doc-prt
     2439       tt-store.price-calc
     2440       tt-store.in-pay
     2441       b-inpay
     2442       tt-store.no-eq
     2443       tt-store.out-pay
     2444       b-outpay
     2445       tt-store.unit-cli-perm
     2446       tt-store.ret-pay
     2447       b-retpay
     2448       tt-store.out-rate
     2449       tt-store.ret-sup-pay
     2450       tt-store.fbr-pay
     2451       tt-store.no-eq
     2452       tt-store.out-rate
     2453       tt-store.price-calc
     2454       b-suppay
     2455       tt-store.out-line-discnt
     2456       tt-store.down-pay
     2457       b-spipay
     2458       tt-store.in-ov
     2459       tt-store.inv-pay
     2460       b-invpay
     2461       tt-store.inout-price
     2462       tt-clients.db-num when p-mode = 'ДОБАВЛЕНИЕ':U
     2463       b-db when p-mode = 'ДОБАВЛЕНИЕ':U
     2464       tt-store.shift-on
     2465       varpurch-code-name
     2466       varenvd
     2467       varpharm
     2468       WITH FRAME Dialog-Frame.
     2469     end.
     2470     if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
     2471        run reset-from-sysconf in this-procedure ( input no, input tt-store.host-code ).
     2472        MENU-ITEM m-choose:SENSITIVE IN MENU MENU-obj-code = NO.
     2473     end.
     2474     VIEW FRAME Dialog-Frame.
     2475       if v-storei-have-holdfirm = yes
     2476       then do:
     2477           assign
     2478               fi-holdfirm-code :visible   in frame Dialog-Frame    = yes
     2479               fi-holdfirm-name :visible   in frame Dialog-Frame    = yes
     2480               b-holdfirm       :visible   in frame Dialog-Frame    = yes
     2481               fi-holdfirm-code :sensitive in frame Dialog-Frame    = no
     2482               fi-holdfirm-name :sensitive in frame Dialog-Frame    = no
     2483           .
     2484           if p-mode = 'ПРОСМОТР':U
     2485           then do:
     2486               assign
     2487                   b-holdfirm       :sensitive in frame Dialog-Frame    = no
     2488               .
     2489           end.
     2490           else do:
     2491               assign
     2492                   b-holdfirm       :sensitive in frame Dialog-Frame    = yes
     2493               .
     2494           end.
     2495           display
     2496               fi-holdfirm-code
     2497               fi-holdfirm-name
     2498           with frame Dialog-Frame.
     2499       end.
     2500       else do:
     2501           assign
     2502               fi-holdfirm-code :visible in frame Dialog-Frame    = no
     2503               fi-holdfirm-name :visible in frame Dialog-Frame    = no
     2504               b-holdfirm       :visible in frame Dialog-Frame    = no
     2505           .
     2506       end.
     2507     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     2508       message
     2509       "Вам следует выбрать фирму," skip
     2510       "к которой будет относиться склад"
     2511       view-as alert-box .
     2512       apply "CHOOSE" to b-host in frame Dialog-Frame .
     2513     end.
     2514   END PROCEDURE.
     2515   PROCEDURE proc-save :
     2516       define buffer buf_clients       for ub.clients.
     2517   do
     2518   for buf_clients
     2519   on error undo, return error
     2520   :
     2521   if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     2522     if new-host-code = ?
     2523     or new-host-code = 0
     2524     then do:
     2525       message
     2526       "Фирма не выбрана."
     2527       view-as alert-box error.
     2528       return error .
     2529     end.
     2530   end.
     2531   assign
     2532   tt-store.obj-code            frame Dialog-Frame
     2533   tt-clients.db-num
     2534   tt-clients.obj-name
     2535   tt-clients.PS
     2536   tt-store.addres1
     2537   tt-store.addres2
     2538   tt-store.doc-prt
     2539   tt-store.down-pay
     2540   tt-store.fax
     2541   tt-store.holidays
     2542   tt-store.host-code           =  if  tt-store.host-code = 0
     2543                                  or tt-store.host-code = ?
     2544                                  then p-host-code
     2545                                  else tt-store.host-code
     2546   tt-store.in-ov
     2547   tt-store.in-pay
     2548   tt-store.in-perm
     2549   tt-store.inout-price
     2550   tt-store.inv-pay
     2551   tt-store.load-time
     2552   tt-store.no-eq
     2553   tt-store.out-line-discnt
     2554   tt-store.out-pay
     2555   tt-store.out-rate
     2556   tt-store.phone
     2557   tt-store.price-calc
     2558   tt-store.ret-pay
     2559   tt-store.ret-sup-pay
     2560   tt-store.fbr-pay
     2561   tt-store.rsrv-time
     2562   tt-store.shift-on
     2563   tt-store.store-boss
     2564   tt-store.store-man
     2565   tt-store.unit-cli-perm
     2566   tt-store.work-hours
     2567   .
     2568   assign
     2569   frame Dialog-Frame
     2570       kpp
     2571   .
     2572   if varpharm = true and  tt-store.doc-prt = true  then do:
     2573      message "Нельзя на объекте вести сразу учет по шкалам и по партиям. Если Вы уверены что нужно использовать режим АПТЕКА, не используйте шкальный товар !"
     2574      view-as alert-box information .
     2575   end.
     2576   run adm/store01.p (
     2577                 input-output p-rid
     2578                ,input        p-mode
     2579                ,input    tt-store.obj-code
     2580                ,input    tt-clients.db-num
     2581                ,input    tt-store.host-code
     2582                ,input    tt-clients.grp-code
     2583                ,input    tt-clients.obj-name
     2584                ,input    tt-clients.PS
     2585                ,input    yes
     2586                ,input    tt-store.addres1
     2587                ,input    tt-store.addres2
     2588                ,input    tt-store.doc-prt
     2589                ,input    tt-store.down-pay
     2590                ,input    tt-store.fax
     2591                ,input    tt-store.holidays
     2592                ,input    tt-store.in-ov
     2593                ,input    tt-store.in-pay
     2594                ,input    tt-store.in-perm
     2595                ,input    tt-store.inout-price
     2596                ,input    tt-store.inv-pay
     2597                ,input    tt-store.load-time
     2598                ,input    tt-store.no-eq
     2599                ,input    tt-store.out-line-discnt
     2600                ,input    tt-store.out-pay
     2601                ,input    tt-store.out-rate
     2602                ,input    tt-store.phone
     2603                ,input    tt-store.price-calc
     2604                ,input    tt-store.ret-pay
     2605                ,input    tt-store.ret-sup-pay
     2606                ,input    tt-store.fbr-pay
     2607                ,input    tt-store.rsrv-time
     2608                ,input    tt-store.shift-on
     2609                ,input    tt-store.store-boss
     2610                ,input    tt-store.store-man
     2611                ,input    tt-store.unit-cli-perm
     2612                ,input    tt-store.work-hours
     2613                ,input    (if varpurch-code-name = "по настройкам фирмы" then ? else lookup (varpurch-code-name, 'выкуп,консигнация,ответственное хранение,старая консигнация':U))
     2614                ,INPUT    varenvd
     2615                ,INPUT    varpharm
     2616                ,INPUT    KPP
     2617               )
     2618                no-error .
     2619   if error-status:error then do:
     2620   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2621   define variable fh as widget-handle no-undo .
     2622   define variable hh as widget-handle no-undo .
     2623   define variable rv as character no-undo .
     2624   assign
     2625   rv = entry(1, return-value , chr(4)).
     2626   if rv <> "":U then do:
     2627     assign
     2628     fh = frame Dialog-Frame:first-child
     2629     hh = fh:first-child
     2630     .
     2631     do while valid-handle(hh):
     2632       if hh:name = rv then do:
     2633         APPLY "ENTRY" to hh.
     2634         undo ,
     2635         return error.
     2636       end.
     2637       hh = hh:next-sibling.
     2638     end.
     2639   end.
     2640     undo, return error.
     2641   end.
     2642       assign
     2643           fi-holdfirm-code
     2644       .
     2645       find first buf_clients no-lock
     2646            where buf_clients.obj-type = 'орг':U
     2647              and buf_clients.obj-code = fi-holdfirm-code
     2648       no-error.
     2649       if available buf_clients
     2650       then do:
     2651           run clntattr-write in this-procedure (
     2652                 input 'скл':U
     2653               , input tt-store.obj-code
     2654               , input 'holdfirm-code':U
     2655               , input string( fi-holdfirm-code )
     2656           ).
     2657       end.
     2658   end.
     2659   END PROCEDURE.
     2660   PROCEDURE reset-from-sysconf :
     2661   define  input parameter p-reset as logical no-undo.
     2662   define input parameter p-host-code as integer no-undo .
     2663   define buffer buf_sysconf for ub.sysconf.
     2664   if p-reset then   do:
     2665       FIND first buf_sysconf where
     2666               buf_sysconf.host-code = p-host-code.
     2667       assign
     2668       tt-store.unit-cli-perm = buf_sysconf.unit-cli-perm
     2669       tt-store.in-ov = buf_sysconf.in-ov
     2670       tt-store.in-perm = buf_sysconf.in-perm
     2671       tt-store.inout-price = buf_sysconf.inout-price
     2672       tt-store.no-eq = buf_sysconf.no-eq
     2673       tt-store.out-line-discnt = buf_sysconf.out-line-discnt
     2674       tt-store.out-rate = buf_sysconf.out-rate
     2675       tt-store.price-calc = buf_sysconf.price-calc
     2676       tt-store.chk-pay = buf_sysconf.chk-pay
     2677       tt-store.down-pay = buf_sysconf.down-pay
     2678       tt-store.in-pay  = buf_sysconf.in-pay
     2679       tt-store.inv-pay  = buf_sysconf.inv-pay
     2680       tt-store.out-pay  = buf_sysconf.out-pay
     2681       tt-store.ret-pay = buf_sysconf.ret-pay
     2682       tt-store.ret-sup-pay = buf_sysconf.ret-sup-pay
     2683       tt-store.fbr-pay = buf_sysconf.fbr-pay
     2684       tt-store.rsrv-time  = buf_sysconf.rsrv-time
     2685       tt-store.load-time  = buf_sysconf.load-time
     2686       tt-store.holidays  = buf_sysconf.holidays
     2687           .
     2688   end.
     2689   display
     2690   tt-store.unit-cli-perm
     2691   tt-store.in-ov
     2692   tt-store.inout-price
     2693   tt-store.no-eq
     2694   tt-store.out-line-discnt
     2695   tt-store.out-rate
     2696   tt-store.price-calc
     2697   tt-store.down-pay
     2698   tt-store.in-pay
     2699   tt-store.out-pay
     2700   tt-store.inv-pay
     2701   tt-store.ret-pay
     2702   tt-store.ret-sup-pay
     2703   tt-store.fbr-pay
     2704   tt-store.rsrv-time
     2705   tt-store.load-time
     2706   tt-store.holidays
     2707   with frame Dialog-Frame.
     2708   END PROCEDURE.
