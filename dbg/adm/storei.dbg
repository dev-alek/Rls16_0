     1760   ON CHOOSE OF b-outpay IN FRAME Dialog-Frame
     1761   DO:
     1762       define variable ref-rec as character no-undo .
     1763       define buffer buf_pay-type for ub.pay-type.
     1764       run ref/paytype.w (input parparentproc, "b-sel", output ref-rec ).
     1765       apply "ENTRY" to self .
     1766       if ref-rec = "" then return no-apply.
     1767       else do:
     1768         find buf_pay-type where
     1769                 recid( buf_pay-type ) = int(ref-rec) no-lock .
