     1777   ON CHOOSE OF b-reset IN FRAME Dialog-Frame
     1778   DO:
     1779   if p-mode = 'ДОБАВЛЕНИЕ':U and tt-store.host-code = 0 then do:
     1780       message
     1781       "Фирма для скалада еще не определена" skip
     1782       "Скопировать настройки с настроек по умолчанию невозможно"
     1783       view-as alert-box error .
     1784       return no-apply.
     1785     end.
     1786     message
     1787     "Скопировать настройки для данного склада" skip
     1788     "из аналогичных настроек для фирмы?" view-as alert-box question
     1789     buttons yes-no set OK as log .
     1790     if OK then do:
     1791       run reset-from-sysconf in this-procedure ( input yes, input tt-store.host-code ).
     1792     end.
     1793   END.
     1794   ON CHOOSE OF b-retpay IN FRAME Dialog-Frame
     1795   DO:
     1796       define variable ref-rec as character no-undo .
     1797       define buffer buf_pay-type for ub.pay-type.
     1798       run ref/paytype.w (input parparentproc, "b-sel", output ref-rec ).
