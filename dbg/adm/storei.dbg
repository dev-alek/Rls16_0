     1276        IMAGE-DOWN FILE "btn-down-arrow":U
     1277        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1278        LABEL "b-db"
     1279        SIZE 3 BY .86.
     1280   DEFINE BUTTON b-host
     1281        LABEL "&Фирма"
     1282        SIZE 10 BY 1.
     1283   DEFINE BUTTON b-inpay
