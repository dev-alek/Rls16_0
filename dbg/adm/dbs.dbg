     3335       (input  select-list
     3336       ) no-error.
     3337     if return-value = "not-create":U
     3338     then do :
     3339       return no-apply .
     3340     end.
     3341     run adm/unloaddc.p
     3342       no-error .
     3343     if error-status :error
     3344     then do:
     3345       message
     3346         vss-workfile vss-revision vss-description skip
     3347         substitute( "Не удалось отключить БД" ) skip
     3348         return-value skip
     3349         error-status :get-message ( error-status :num-messages )
     3350         view-as alert-box error .
     3351     end.
     3352     do v-ii = 1 to num-entries (select-list):
     3353       v-list = entry(v-ii, select-list) no-error .
     3354       find first buf-lst_db where recid(buf-lst_db) = integer(v-list) .
     3355       assign
     3356         v-lock = true
     3357       .
     3358   define variable vss-include-info15 as character format "X(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
     3359   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_lock-route in g#lib-nws
     3360     ( input  'unlock'
     3361     , input  buf-lst_db.db-num
     3362     , input  0
     3363     , input  ''
     3364     , output v-msg
     3365     , output v-lock
     3366     , output v-ok
     3367     ) no-error .
     3368       if error-status :error
     3369       or v-lock = true
     3370       or v-ok   = false
     3371       then do:
     3372         message
     3373           vss-workfile vss-revision vss-description skip
     3374           substitute( "&1", v-msg ) skip
     3375           return-value skip
     3376           error-status :get-message ( error-status :num-messages )
     3377           view-as alert-box error
     3378         .
     3379         return no-apply.
     3380       end.
     3381     end.
     3382     assign     log-res = browse br-db :set-repositioned-row( browse br-db :focused-row, 'CONDITIONAL':u)     v-rowid = rowid( ub.db )   .   OPEN QUERY br-db FOR EACH ub.db NO-LOCK.   reposition br-db to rowid v-rowid no-error.   apply "ENTRY":U to br-db.   apply "VALUE-CHANGED":U to br-db.
     3383   END.
