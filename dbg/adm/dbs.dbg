        1   define input  parameter parparentproc as widget-handle no-undo .
        2   define input  parameter p-mode as char  no-undo.
        3   define output parameter rid  as recid no-undo init ?.
        4   define variable vss-revision    as character no-undo init "$Revision: 19b15f56f81d, 2201, rls $":u .
        5   define variable vss-author      as character no-undo init "$Author: druban $":u .
        6   define variable vss-date        as character no-undo init "$Date: Wed Dec 25 15:23:58 2019 +0300 $":u .
        7   define variable vss-workfile    as character no-undo init "$Workfile: dbs.w $":u .
        8   define variable vss-archive     as character no-undo init "$Archive: adm/dbs.w $":u .
        9   define variable vss-description as character no-undo init "Справочник баз данных" .
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114   define variable v-waitfram-action01         as character   no-undo .
      115   define variable v-waitfram-action02         as character   no-undo .
      116   define variable v-waitfram-action03         as character   no-undo .
      117   define variable mWaitFramTextBeg            as character   no-undo.
      118   define variable mWaitFramTextEnd            as character   no-undo.
      119   define variable mWaitFramView               as logical     no-undo.
      120   define variable mWaitProcEvent              as logical     no-undo init yes.
      121   define variable mWaitFramInterval           as integer     no-undo init 1 .
      122   define variable mWaitFramStop               as logical     no-undo.
      123   define variable mWaitFramStopUser           as logical     no-undo.
      124   define variable mWaitFramStopTimeOut        as logical     no-undo.
      125   define variable mWaitFramStartProc          as datetime-tz no-undo.
      126   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      127   define button B-WaitFramStop auto-end-key
      128        label "Стоп"
      129        size 10 by 1 tooltip "Остоновить процесс".
      130   define button B-viewProcInfo
      131        label "Информация"
      132        size 15 by 1 tooltip "Информация о процесс".
      133   define frame waitfram
      134     v-waitfram-action01 format "x(72)" no-label skip
      135     v-waitfram-action02 format "x(72)" no-label skip
      136     v-waitfram-action03 format "x(72)" no-label skip
      137     B-viewProcInfo
      138     B-WaitFramStop at row 4 col 30
      139     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      140     .
      141   define new global shared variable mBatchMode as logical no-undo init ?.
      142   define variable mFramBachModHandle as handle no-undo.
      143   mFramBachModHandle = frame waitfram:handle.
      144   define variable mFameOldVis as logical no-undo.
      145   define variable mVisCUrentVin as logical no-undo.
      146   if session:batch-mode
      147   then
      148      mBatchMode = yes.
      149   if mBatchMode = ? then do:
      150     mVisCUrentVin = current-window:visible.
      151     mFameOldVis = mFramBachModHandle:visible.
      152     mFramBachModHandle:visible  = yes.
      153     mBatchMode = mFramBachModHandle:visible ne yes.
      154     mFramBachModHandle:visible = mFameOldVis.
      155     current-window:visible = mVisCUrentVin.
      156   end.
      157    if  log-manager:logfile-name ne ?
      158     then DO:
      159         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      160         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      161         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      162     end.
      163   on choose of B-WaitFramStop in frame waitfram
      164   do:
      165     mWaitFramStop = yes.
      166     mWaitFramStopUser = yes.
      167   end.
      168   function waitfram-check-timeout returns logical():
      169      define variable vtime as int64 no-undo.
      170      if mWaitFramStopTimeOut
      171      then
      172         return yes.
      173      vtime = ( now - mWaitFramStartProc ) / 1000 .
      174      if     mWaitFramTimeOut ne ?
      175         and mWaitFramTimeOut ne 0
      176         and mWaitFramTimeOut lt vtime
      177      then do:
      178         mWaitFramStopTimeOut = yes.
      179      end.
      180      return mWaitFramStopTimeOut.
      181   end.
      182   procedure waitfram-hide :
      183     if not session:batch-mode
      184     then do
      185     on error undo, return error return-value
      186     :
      187       pause 0 before-hide .
      188       if not mBatchMode then
      189         hide frame waitfram .
      190     if     not mWaitFramView
      191        and mWaitProcEvent
      192     then
      193       process events .
      194     end.
      195   end procedure.
      196   procedure waitfram-show :
      197     define input  parameter p-message as character no-undo .
      198     define variable v-left-margin as integer   no-undo .
      199     if not session:batch-mode
      200     then do
      201     on error undo, return error return-value
      202     :
      203       if length(p-message) <= 70 then do:
      204         assign
      205           v-left-margin = integer((70 - length(p-message)) / 2)
      206         .
      207         assign
      208           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      209         .
      210         assign
      211           v-waitfram-action01 = " "
      212           v-waitfram-action02 = " "
      213                                    + fill(" ", v-left-margin)
      214                                    + p-message
      215           v-waitfram-action03 = " "
      216         .
      217       end.
      218       else do:
      219         define variable vRindex1 as integer no-undo.
      220         define variable vRindex2 as integer no-undo.
      221         vRindex1 = r-index(p-message," ",70).
      222         if vRindex1 = 0
      223         then
      224            vRindex1 = 70.
      225         if length(p-message)  <= vRindex1 + 70 then do:
      226           assign
      227             v-waitfram-action01 = " "
      228             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      229             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      230           .
      231         end.
      232         else do:
      233           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      234           if vRindex2 <= vRindex1
      235           then
      236              vRindex2 = vRindex1 + 70.
      237           assign
      238             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      239             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      240             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      241           .
      242         end.
      243       end.
      244       B-viewProcInfo:visible   in frame waitfram = no.
      245       B-viewProcInfo:sensitive in frame waitfram = no.
      246       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      247       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      248       if  (   mWaitFramView
      249          or  mWaitProcEvent)
      250          and not mBatchMode
      251       then
      252          display
      253             v-waitfram-action01 skip
      254             v-waitfram-action02 skip
      255             v-waitfram-action03 skip
      256          with frame waitfram .
      257       if     mWaitFramView
      258          then do:
      259             if     mWaitFramInterval ne ?
      260                and not mBatchMode
      261             then
      262                wait-for go of frame waitfram pause mWaitFramInterval.
      263          end.
      264          else
      265             if     mWaitProcEvent
      266                and not mBatchMode
      267             then
      268                process events .
      269     end.
      270   end procedure.
      271      procedure waitfram-show-this:
      272         define input  parameter iInterval as int64 no-undo.
      273         define variable vtime as int64 no-undo.
      274         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      275         mWaitFramInterval = iInterval.
      276         run waitfram-show (substitute("&1&2 &3&4" ,
      277                                       mWaitFramTextBeg ,
      278                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      279                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      280                                       mWaitFramTextEnd
      281                                      )
      282                           ).
      283      end.
      284      procedure WaitFramRunPause:
      285         define input  parameter iInterval as dec no-undo.
      286         define variable vStart  as datetime-tz no-undo.
      287         define variable vend    as datetime-tz no-undo.
      288         define variable vint as int64 no-undo.
      289         define variable vOk as logical no-undo.
      290         vStart = now.
      291         vend   = vStart.
      292         publish "WaitFramPause" (iInterval,output vOk).
      293         vend   =  now.
      294         vint = vend - vStart.
      295         vint = iInterval - vint / 1000.
      296         if     not mWaitFramStop
      297            and (   vint > 0
      298                 or (    not vOk
      299                     and iInterval eq ?
      300                     )
      301                 )
      302         then
      303            run waitfram-show-this (iInterval).
      304         vend   =  now.
      305         vint = vend - vStart.
      306         vint = iInterval - vint / 1000.
      307         if     not mWaitFramStop
      308            and vint > 0
      309         then do:
      310            run gbl/pause.p (vint * 1000).
      311         end.
      312         if iInterval ne ?
      313         then
      314            publish "WaitFramStop".
      315         waitfram-check-timeout().
      316      end.
      317      procedure WaitFramWaitFor:
      318         define input  parameter iInterval as dec no-undo.
      319         assign
      320            mWaitFramStartProc   = now
      321            mWaitFramStopUser    = no
      322            mWaitFramStopTimeOut = no
      323         .
      324         block-wait:
      325         do while not mWaitFramStop:
      326            run WaitFramRunPause (iInterval).
      327            if  waitfram-check-timeout()
      328            then do:
      329               leave block-wait.
      330            end.
      331         end.
      332         run waitfram-hide.
      333      end.
      334   procedure waitfram-join :
      335     define input  parameter p-line-1  as character no-undo .
      336     define input  parameter p-line-2  as character no-undo .
      337     define input  parameter p-line-3  as character no-undo .
      338     define output parameter p-message as character no-undo .
      339     do
      340     on error undo, return error return-value
      341     :
      342       assign
      343         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      344                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      345                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      346       .
      347     end.
      348   end procedure.
      349   function waitfram-join-function returns character
      350     (input p-line-1 as character
      351     ,input p-line-2 as character
      352     ,input p-line-3 as character
      353     ).
      354     define variable v-message as character no-undo .
      355     run waitfram-join in this-procedure
      356       (input  p-line-1
      357       ,input  p-line-2
      358       ,input  p-line-3
      359       ,output v-message
      360       ) .
      361     return v-message .
      362   end function .
      363   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      364   procedure cur-time :
      365      define output parameter p-today as date      no-undo .
      366      define output parameter p-time  as integer   no-undo .
      367     do
      368     on error undo, return error
      369     :
      370       define variable v-date1 as date      no-undo .
      371       define variable v-date2 as date      no-undo .
      372       define variable v-time  as integer   no-undo .
      373       assign
      374         v-date1 = today
      375         v-time  = time
      376         v-date2 = today
      377       .
      378       if v-date1 <> v-date2
      379       then do:
      380         assign
      381           v-date1 = today
      382           v-time  = v-time
      383         .
      384       end.
      385       assign
      386         p-today = v-date1
      387         p-time  = v-time
      388       .
      389     end.
      390   end.
      391   function cur-time-date returns character
      392   :
      393     return string(today, '99/99/9999':U) .
      394   end.
      395   function cur-time-mjd returns decimal
      396   :
      397     define variable v-date as date      no-undo .
      398     define variable v-time as integer   no-undo .
      399     run cur-time in this-procedure
      400       (output v-date
      401       ,output v-time
      402       ) .
      403     return integer(v-date) - 2400002 + (v-time / 86400) .
      404   end.
      405   function cur-time-get-ending-index returns integer
      406   (input p-number as integer
      407   )
      408   :
      409     if p-number < 0
      410     or p-number = ?
      411     then do:
      412       return 1 .
      413     end.
      414     define variable v-rest as integer   no-undo .
      415     assign
      416       p-number = p-number modulo 100
      417     .
      418     if p-number < 20
      419     then do:
      420       assign
      421         v-rest = p-number
      422       .
      423     end.
      424     else do:
      425       assign
      426         v-rest = p-number modulo 10
      427       .
      428     end.
      429     case v-rest :
      430       when 1
      431       then do:
      432         return 2 .
      433       end.
      434       when 2 or
      435       when 3 or
      436       when 4
      437       then do:
      438         return 3 .
      439       end.
      440       otherwise do:
      441         return 1 .
      442       end.
      443     end case .
      444   end.
      445   procedure cur-time-mjd-to-date :
      446      define input  parameter i-mjd-diff as decimal no-undo.
      447      define output parameter o-Date     as date    no-undo.
      448      define output parameter o-Time     as integer no-undo.
      449      define variable v-day-number as integer   no-undo .
      450      if    i-mjd-diff < 0
      451         or i-mjd-diff = ?
      452      then do:
      453         return "?" .
      454      end.
      455      assign
      456         v-day-number = truncate(i-mjd-diff,0).
      457         o-Date = date(v-day-number + 2400002).
      458         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      459     .
      460   end.
      461   function cur-time-mjd-to-string returns character
      462   (input p-mjd-diff as decimal
      463   )
      464   :
      465     define variable v-day-number as integer   no-undo .
      466     define variable v-seconds    as integer   no-undo .
      467     define variable v-hour       as integer   no-undo .
      468     define variable v-min        as integer   no-undo .
      469     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      470     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      471     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      472     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      473     if p-mjd-diff < 0
      474     or p-mjd-diff = ?
      475     then do:
      476       return "?" .
      477     end.
      478     assign
      479       v-day-number = integer(truncate(p-mjd-diff,0))
      480       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      481     .
      482     if v-seconds > 86400
      483     then do:
      484       assign
      485         v-seconds = 86400 - 1
      486       .
      487     end.
      488     if v-seconds < 0
      489     then do:
      490       assign
      491         v-seconds = 0
      492       .
      493     end.
      494     assign
      495       v-hour = truncate(v-seconds / 3600, 0)
      496     .
      497     assign
      498       v-seconds = v-seconds modulo 3600
      499     .
      500     assign
      501       v-min = truncate(v-seconds / 60, 0)
      502     .
      503     assign
      504       v-seconds = v-seconds modulo 60
      505     .
      506     return
      507         (if v-day-number <> 0
      508           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      509           else ""
      510         )
      511       + (if v-day-number <> 0 or v-hour <> 0
      512           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      513           else ""
      514         )
      515       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      516           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      517           else ""
      518         )
      519       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      520       .
      521   end.
      522   function cur-time-string returns character
      523   :
      524     define variable v-date as date      no-undo .
      525     define variable v-time as integer   no-undo .
      526     run cur-time in this-procedure
      527       (output v-date
      528       ,output v-time
      529       ) .
      530     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      531   end.
      532   function cur-time-string-sec returns character
      533   :
      534     define variable v-date as date      no-undo .
      535     define variable v-time as integer   no-undo .
      536     run cur-time in this-procedure
      537       (output v-date
      538       ,output v-time
      539       ) .
      540     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      541   end.
      542   function cur-time-custom  returns character
      543   (input p-prefix as character
      544   ,input p-date-format as character
      545   ,input p-delimiter as character
      546   ,input p-time-format as character
      547   ,input p-suffix as character
      548   )
      549   :
      550     define variable v-date as date      no-undo .
      551     define variable v-time as integer   no-undo .
      552     run cur-time in this-procedure
      553       (output v-date
      554       ,output v-time
      555       ) .
      556     return
      557       p-prefix
      558       + string(v-date, p-date-format)
      559       + p-delimiter
      560       + string(v-time, p-time-format)
      561       + p-suffix
      562       .
      563   end.
      564   function cur-time-print  returns character
      565   :
      566     define variable v-date as date      no-undo .
      567     define variable v-time as integer   no-undo .
      568     run cur-time in this-procedure
      569       (output v-date
      570       ,output v-time
      571       ) .
      572     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      573   end.
      574   function cur-time-datetime returns datetime
      575   :
      576     define variable v-char as character no-undo .
      577     define variable v-datetime as datetime no-undo .
      578     v-char = cur-time-string().
      579     v-datetime = datetime(v-char).
      580     return  v-datetime.
      581   end.
      582   function cur-time-string-msec returns character
      583   :
      584     define variable v-date as datetime  no-undo .
      585     v-date = now.
      586     return string(v-date) .
      587   end.
      588   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      589   procedure gen-key-rec :
      590     define input  parameter p-tbl-name    as character no-undo.
      591     define input  parameter p-bh_tbl-name as handle    no-undo.
      592     define output parameter p-key-rec     as character no-undo.
      593     do
      594     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      595     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      596     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      597     :
      598       define variable fh               as handle    no-undo .
      599       define variable v-ok             as logical   no-undo .
      600       define variable v-inform         as character no-undo .
      601       define variable v-ind            as integer   no-undo .
      602       define variable v-idx-field-qnty as integer   no-undo .
      603       if p-tbl-name = ?
      604         or p-tbl-name = "":U
      605       then do:
      606         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info2 ).
      607       end.
      608       if not p-bh_tbl-name:available then do:
      609         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info2, p-tbl-name ).
      610       end.
      611       assign
      612         p-key-rec = p-tbl-name
      613         v-inform  = p-bh_tbl-name:index-information(1)
      614         v-ind     = 2
      615       .
      616       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      617       on error undo, return error
      618       :
      619         assign
      620           v-inform = p-bh_tbl-name:index-information( v-ind )
      621           v-ind    = v-ind + 1
      622         .
      623       end.
      624       if v-inform = ?
      625         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      626         or entry( 3, v-inform, ",":U ) <> "1":U
      627       then do:
      628         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, p-tbl-name ).
      629       end.
      630       else do:
      631         assign
      632           v-idx-field-qnty = num-entries( v-inform ) - 4
      633         .
      634         if v-idx-field-qnty < 2 then do:
      635           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, p-tbl-name ).
      636         end.
      637         do v-ind = 1 to v-idx-field-qnty by 2
      638         on error undo, return error
      639         :
      640           assign
      641             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      642             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      643           .
      644         end.
      645       end.
      646       if p-key-rec = ? then do:
      647         assign
      648           p-key-rec = "":U
      649         .
      650         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info2, p-tbl-name ).
      651       end.
      652     end.
      653     return.
      654   end procedure.
      655   procedure gen-where-keyr-tab :
      656     define input  parameter i-tableSerach as character no-undo.
      657     define input  parameter i-tablekey   as character  no-undo.
      658     define input  parameter p-key-rec    as character  no-undo.
      659     define input  parameter p-key-handle as handle     no-undo .
      660     define input  parameter p-db-name    as character  no-undo .
      661     define input  parameter p-tt-handle  as handle     no-undo .
      662     define output parameter o-Where      as character  no-undo.
      663     do
      664     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      665     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      666     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      667     :
      668       define variable v-full-tbl-name  as character no-undo .
      669       define variable bh_tbl-name      as handle    no-undo .
      670       define variable fh_key           as handle    no-undo .
      671       define variable fh_search        as handle    no-undo .
      672       define variable v-field-num      as integer   no-undo .
      673       define variable v-count-fld      as integer   no-undo .
      674       define variable v-inform         as character no-undo .
      675       define variable v-ind            as integer   no-undo .
      676       define variable v-idx-field-qnty as integer   no-undo .
      677       define variable v-field-name     as character no-undo .
      678       define variable v-field-val      as character no-undo .
      679       define variable v-word-link      as character no-undo .
      680       define variable vTable           as character no-undo.
      681       define variable bh_tbl-key       as handle    no-undo .
      682       assign
      683         p-key-rec = trim( p-key-rec )
      684       .
      685       if p-key-handle <> ? then do:
      686         if not valid-handle(p-key-handle)
      687            or p-key-handle:type <> "buffer"
      688         then do:
      689           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info2 ).
      690         end.
      691         if num-entries( p-key-rec, chr(3) ) > 1
      692           or p-key-rec = ?
      693           or p-key-rec = "":U
      694         then do:
      695           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info2, p-key-rec ).
      696         end.
      697       end.
      698       else do:
      699         if p-key-rec = ?
      700           or p-key-rec = "":U
      701         then do:
      702           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      703         end.
      704       end.
      705       assign
      706         vTable = entry( 1 , p-key-rec, chr(3) )
      707       .
      708       if p-tt-handle <> ?
      709         and ( not valid-handle(p-tt-handle)
      710               or p-tt-handle:type <> "buffer"
      711             )
      712       then do:
      713         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info2, vTable, chr(10) ).
      714       end.
      715       if p-tt-handle = ? then do:
      716         assign
      717           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      718         .
      719         create buffer bh_tbl-name for table v-full-tbl-name .
      720       end.
      721       else do:
      722         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      723       end.
      724       assign
      725         v-inform = bh_tbl-name:index-information(1)
      726         v-ind    = 2
      727       .
      728       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      729       on error undo, return error
      730       :
      731         assign
      732           v-inform = bh_tbl-name:index-information( v-ind )
      733           v-ind    = v-ind + 1
      734         .
      735       end.
      736       if v-inform = ?
      737         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      738         or entry( 3, v-inform, ",":U ) <> "1":U
      739       then do:
      740         delete object bh_tbl-name no-error.
      741         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info2, vTable ).
      742       end.
      743       assign
      744         v-idx-field-qnty = num-entries( v-inform ) - 4
      745       .
      746       if v-idx-field-qnty < 2 then do:
      747         delete object bh_tbl-name no-error.
      748         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, vTable ).
      749       end.
      750       assign
      751         o-where     = "where":U
      752         v-word-link = "":U
      753         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      754         v-count-fld = 0
      755       .
      756       if i-tablekey ne "" and i-tablekey ne ?
      757       then do:
      758         assign
      759           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      760         .
      761         create buffer bh_tbl-key for table v-full-tbl-name .
      762       end.
      763       if i-tableSerach ne "" and i-tableSerach ne ?
      764       then do:
      765         delete object bh_tbl-name no-error.
      766         assign
      767           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      768         .
      769         create buffer bh_tbl-name for table v-full-tbl-name .
      770       end.
      771       block_where:
      772       do v-ind = 1 to v-idx-field-qnty by 2
      773       on error undo, return error
      774       :
      775         assign
      776           v-count-fld = v-count-fld + 1
      777         .
      778         if p-key-handle = ?
      779           and v-count-fld > v-field-num
      780         then do:
      781           leave block_where.
      782         end.
      783         define variable VfieldKeyTable as handle no-undo.
      784         assign
      785           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      786           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      787         .
      788         if     bh_tbl-key ne ?
      789         then do:
      790            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      791            if VfieldKeyTable eq ?
      792            then next block_where.
      793         end.
      794         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      795         then
      796            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      797         else
      798            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      799         if p-key-handle = ? then do:
      800           assign
      801             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      802           .
      803         end.
      804         else do:
      805           assign
      806             fh_key = p-key-handle:buffer-field( v-field-name )
      807           .
      808           if fh_key = ?
      809             or not valid-handle( fh_key )
      810           then do:
      811             delete object bh_tbl-name.
      812             if     bh_tbl-key ne ?
      813             then
      814                delete object bh_tbl-key.
      815             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info2, p-key-handle:name, v-field-name ).
      816           end.
      817           assign
      818             v-field-val = fh_key:buffer-value
      819           .
      820         end.
      821         if fh_search:data-type ="character":U then do:
      822           assign
      823             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      824             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      825             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      826             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      827             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      828             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      829             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      830             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      831             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      832             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      833             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      834             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      835             v-field-val = substitute( '"&1"', v-field-val )
      836           .
      837         end.
      838         assign
      839           o-where = substitute( "&1 &2", o-where, v-field-val )
      840         .
      841         if v-word-link = "":U then do:
      842           assign
      843             v-word-link = "and":U
      844           .
      845         end.
      846       end.
      847       delete object bh_tbl-name.
      848       if     bh_tbl-key ne ?
      849       then
      850          delete object bh_tbl-key.
      851       if p-key-handle = ?
      852         and v-count-fld <> v-field-num
      853       then do:
      854         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info2, vTable ).
      855       end.
      856     end.
      857   end procedure.
      858   procedure gen-hn-keyr-tab :
      859     define input  parameter i-tableSerach as character no-undo.
      860     define input  parameter i-tablekey   as character no-undo.
      861     define input  parameter p-key-rec    as character no-undo.
      862     define input  parameter p-key-handle as handle    no-undo .
      863     define input  parameter p-db-name    as character no-undo .
      864     define input  parameter p-tt-handle  as handle    no-undo .
      865     define input  parameter p-stts-lock  as integer   no-undo .
      866     define output parameter o-hn         as handle    no-undo.
      867     define variable v-full-tbl-name as character no-undo.
      868     define variable v-where         as character no-undo.
      869     define variable bh_tbl-name     as handle    no-undo.
      870     define variable vTable          as character no-undo.
      871     do
      872     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      873     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      874     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      875         run gen-where-keyr-tab(i-tableSerach,
      876                                i-tablekey,
      877                                p-key-rec,
      878                                p-key-handle,
      879                                p-db-name,
      880                                p-tt-handle,
      881                                output v-where).
      882         if i-tableSerach ne "" and i-tableSerach ne ?
      883         then do:
      884            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      885            create buffer bh_tbl-name for table v-full-tbl-name .
      886         end.
      887         else do:
      888            if p-tt-handle = ? then do:
      889               assign
      890                  vTable = entry( 1 , p-key-rec, chr(3) )
      891               .
      892               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      893               create buffer bh_tbl-name for table v-full-tbl-name .
      894            end.
      895            else do:
      896               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      897            end.
      898         end.
      899         if p-tt-handle = ? then do:
      900            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      901         end.
      902         else do:
      903            bh_tbl-name:find-first( v-where ) no-error .
      904         end.
      905         o-hn = bh_tbl-name.
      906      end.
      907   end procedure.
      908   procedure gen-hn-keyr :
      909     define input  parameter p-key-rec    as character no-undo.
      910     define input  parameter p-key-handle as handle    no-undo .
      911     define input  parameter p-db-name    as character no-undo .
      912     define input  parameter p-tt-handle  as handle    no-undo .
      913     define input  parameter p-stts-lock  as integer   no-undo .
      914     define output parameter o-hn         as handle    no-undo.
      915     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      916   end.
      917   procedure gen-row-keyr :
      918     define input  parameter p-key-rec    as character no-undo.
      919     define input  parameter p-key-handle as handle    no-undo .
      920     define input  parameter p-db-name    as character no-undo .
      921     define input  parameter p-tt-handle  as handle    no-undo .
      922     define input  parameter p-stts-lock  as integer   no-undo .
      923     define output parameter p-tbl-row    as rowid     no-undo.
      924     define output parameter p-tbl-name   as character no-undo.
      925     define variable vHn as handle no-undo.
      926       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      927       p-tbl-row = if vHn:available then vHn:rowid else ?.
      928       p-tbl-name =  vHn:table.
      929       delete object vHn no-error.
      930     if p-tbl-row = ? then do:
      931       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info2, p-tbl-name, p-key-rec ).
      932     end.
      933     else do:
      934       return.
      935     end.
      936   end procedure.
      937   procedure gen-key-fv :
      938     define input  parameter p-key-rec    as character no-undo .
      939     define output parameter p-field-list as character no-undo .
      940     define output parameter p-value-list as character no-undo.
      941     do
      942     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      943     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      944     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      945     :
      946       define variable v-full-tbl-name  as character no-undo .
      947       define variable bh_tbl-name      as handle    no-undo .
      948       define variable v-tbl-name       as character no-undo .
      949       define variable v-field-num      as integer   no-undo .
      950       define variable v-count-fld      as integer   no-undo .
      951       define variable v-inform         as character no-undo .
      952       define variable v-ind            as integer   no-undo .
      953       define variable v-idx-field-qnty as integer   no-undo .
      954       define variable v-delim-key      as character no-undo .
      955       if p-key-rec = ?
      956         or p-key-rec = "":U
      957       then do:
      958         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      959       end.
      960       assign
      961         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      962         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      963       .
      964       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      965       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info2 ).
      966       assign
      967         v-inform = bh_tbl-name:index-information(1)
      968         v-ind    = 2
      969       .
      970       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      971       on error undo, return error
      972       :
      973         assign
      974           v-inform = bh_tbl-name:index-information( v-ind )
      975           v-ind    = v-ind + 1
      976         .
      977       end.
      978       if v-inform = ?
      979         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      980         or entry( 3, v-inform, ",":U ) <> "1":U
      981       then do:
      982         delete object bh_tbl-name no-error.
      983         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      984       end.
      985       assign
      986         v-idx-field-qnty = num-entries( v-inform ) - 4
      987       .
      988       if v-idx-field-qnty < 2 then do:
      989         delete object bh_tbl-name no-error.
      990         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      991       end.
      992       assign
      993         p-field-list = "":U
      994         p-value-list = "":U
      995         v-delim-key  = "":U
      996         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      997         v-count-fld  = 0
      998       .
      999       block_where:
     1000       do v-ind = 1 to v-idx-field-qnty by 2
     1001       on error undo, return error
     1002       :
     1003         assign
     1004           v-count-fld = v-count-fld + 1
     1005         .
     1006         if v-count-fld > v-field-num then do:
     1007           leave block_where.
     1008         end.
     1009         assign
     1010           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1011           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1012         .
     1013         if v-ind = 1 then do:
     1014           assign
     1015             v-delim-key = chr(3)
     1016           .
     1017         end.
     1018       end.
     1019       delete object bh_tbl-name.
     1020       if v-count-fld <> v-field-num then do:
     1021         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info2, v-tbl-name ).
     1022       end.
     1023     end.
     1024   end procedure.
     1025   procedure gen-key-field :
     1026     define input  parameter p-table      as character no-undo .
     1027     define output parameter p-field-list as character no-undo .
     1028     do
     1029     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1030     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1031     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1032     :
     1033       define variable v-full-tbl-name  as character no-undo .
     1034       define variable bh_tbl-name      as handle    no-undo .
     1035       define variable v-tbl-name       as character no-undo .
     1036       define variable v-field-num      as integer   no-undo .
     1037       define variable v-count-fld      as integer   no-undo .
     1038       define variable v-inform         as character no-undo .
     1039       define variable v-ind            as integer   no-undo .
     1040       define variable v-idx-field-qnty as integer   no-undo .
     1041       define variable v-delim-key      as character no-undo .
     1042       if p-table = ?
     1043         or p-table = "":U
     1044       then do:
     1045         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info2 ).
     1046       end.
     1047       assign
     1048         v-tbl-name      = p-table
     1049         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1050       .
     1051       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1052       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info2 ).
     1053       assign
     1054         v-inform = bh_tbl-name:index-information(1)
     1055         v-ind    = 2
     1056       .
     1057       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1058       on error undo, return error
     1059       :
     1060         assign
     1061           v-inform = bh_tbl-name:index-information( v-ind )
     1062           v-ind    = v-ind + 1
     1063         .
     1064       end.
     1065       if v-inform = ?
     1066         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1067         or entry( 3, v-inform, ",":U ) <> "1":U
     1068       then do:
     1069         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
     1070       end.
     1071       assign
     1072         v-idx-field-qnty = num-entries( v-inform ) - 4
     1073       .
     1074       if v-idx-field-qnty < 2 then do:
     1075         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
     1076       end.
     1077       assign
     1078         p-field-list = "":U
     1079         v-delim-key  = "":U
     1080         v-count-fld  = 0
     1081       .
     1082       block_where:
     1083       do v-ind = 1 to v-idx-field-qnty by 2
     1084       on error undo, return error
     1085       :
     1086         assign
     1087           v-count-fld = v-count-fld + 1
     1088         .
     1089         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1090         if v-ind = 1 then do:
     1091           assign
     1092             v-delim-key = chr(3)
     1093           .
     1094         end.
     1095       end.
     1096       delete object bh_tbl-name.
     1097     end.
     1098   end procedure.
     1099   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1100   Function reverse returns character (str as character).
     1101      define variable rev_incl_s as character init "" no-undo .
     1102      define variable rev_incl_i as integer no-undo .
     1103      define variable rev_incl_l as integer no-undo .
     1104      rev_incl_l = length(str).
     1105      do rev_incl_i = 1 to rev_incl_l:
     1106         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
     1107      end.
     1108      return rev_incl_s.
     1109   end.
     1110   procedure check-enc.
     1111     define input  parameter p-db-num    as integer   no-undo .
     1112     define input  parameter p-db-key    as character no-undo .
     1113     define input  parameter p-code      as character no-undo .
     1114     define input  parameter p-value     as character no-undo .
     1115     define input  parameter p-beg-date  as date      no-undo .
     1116     define input  parameter p-end-date  as date      no-undo .
     1117     define input  parameter p-enc-value as character no-undo .
     1118     define output parameter p-answer    as logical   no-undo .
     1119     define variable tmp         as character no-undo .
     1120     define variable v-enc-value as character no-undo .
     1121     if p-db-num <> 0
     1122       and p-db-key = "":U
     1123     then do:
     1124       assign
     1125         p-answer = true
     1126       .
     1127       return.
     1128     end.
     1129     if p-db-key = "unload-db":U then do:
     1130       assign
     1131         p-answer = true
     1132       .
     1133       return.
     1134     end.
     1135     if p-code = ""  then do:
     1136       assign
     1137         tmp = string( p-db-num ) + reverse (p-db-key).
     1138       .
     1139     end.
     1140     else do:
     1141       assign
     1142         tmp = string( p-db-num )
     1143               + trim( p-db-key )
     1144               + reverse( trim( p-code ) )
     1145               + reverse( trim( p-value ) )
     1146               + reverse( string( p-beg-date, "99.99.9999" ) )
     1147               + reverse( string( p-end-date, "99.99.9999" ) )
     1148       .
     1149     end.
     1150     run pswd-enc in this-procedure
     1151       ( input tmp
     1152        ,output v-enc-value
     1153       ) no-error .
     1154     if error-status:error then do:
     1155       message
     1156         vss-workfile vss-revision vss-description skip
     1157         "Ошибка при вызове процедуры pswd-enc" skip
     1158         return-value skip
     1159         error-status :get-message(1) skip
     1160         view-as alert-box error .
     1161       undo, return error .
     1162     end.
     1163     if v-enc-value = p-enc-value then do:
     1164       assign
     1165         p-answer = true
     1166       .
     1167     end.
     1168     else do:
     1169       assign
     1170         p-answer = false
     1171       .
     1172     end.
     1173   end.
     1174   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1175   procedure pswd-enc :
     1176     define input parameter  pswd     as character no-undo .
     1177     define output parameter enc-pswd as character no-undo .
     1178     do
     1179     on error undo, return error return-value
     1180     :
     1181       assign
     1182         enc-pswd = encode(pswd + string(index(pswd, "k")))
     1183       .
     1184     end.
     1185   end procedure.
     1186   function diff-list returns character (
     1187     input parfirst-list  as character,
     1188     input parsecond-list as character,
     1189     input pardelim       as character).
     1190     if pardelim = ""
     1191     or pardelim = ?
     1192     then do:
     1193       assign
     1194         pardelim = ","
     1195       .
     1196     end.
     1197     def var ind as integer no-undo .
     1198     def var v-elem as character no-undo .
     1199     def var v-result-list as character no-undo init "".
     1200     def var v-num-parfirst-list as integer no-undo .
     1201     assign
     1202       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1203     .
     1204     do ind = 1 to v-num-parfirst-list
     1205     :
     1206       assign
     1207         v-elem = entry(ind, parfirst-list, pardelim)
     1208       .
     1209       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
     1210         assign
     1211           v-result-list = v-result-list
     1212                         + (if v-result-list > "" then pardelim else "")
     1213                         + v-elem
     1214         .
     1215       end.
     1216     end.
     1217     return v-result-list .
     1218   end function.
     1219   function add-list returns character (
     1220    input parfirst-list  as character,
     1221    input parsecond-list as character,
     1222    input pardelim       as character).
     1223     if pardelim = ""
     1224     or pardelim = ?
     1225     then do:
     1226       assign
     1227         pardelim = ","
     1228       .
     1229     end.
     1230     def var ind as integer no-undo .
     1231     def var v-elem as character no-undo .
     1232     def var v-result-list as character no-undo init "".
     1233     def var v-num-parfirst-list as integer no-undo .
     1234     assign
     1235       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1236     .
     1237     do ind = 1 to v-num-parfirst-list
     1238     :
     1239       assign
     1240         v-elem = entry(ind, parfirst-list, pardelim)
     1241       .
     1242       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1243         assign
     1244           v-result-list = v-result-list
     1245                         + (if v-result-list > "" then pardelim else "")
     1246                         + v-elem
     1247         .
     1248       end.
     1249     end.
     1250     def var v-num-parsecond-list as integer no-undo .
     1251     assign
     1252       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
     1253     .
     1254     do ind = 1 to v-num-parsecond-list
     1255     :
     1256       assign
     1257         v-elem = entry(ind, parsecond-list, pardelim)
     1258       .
     1259       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1260         assign
     1261           v-result-list = v-result-list
     1262                         + (if v-result-list > "" then pardelim else "")
     1263                         + v-elem
     1264         .
     1265       end.
     1266     end.
     1267     return v-result-list .
     1268   end function.
     1269   function cross-list returns character (
     1270    input parfirst-list  as character,
     1271    input parsecond-list as character,
     1272    input pardelim       as character).
     1273     if pardelim = ""
     1274     or pardelim = ?
     1275     then do:
     1276       assign
     1277         pardelim = ","
     1278       .
     1279     end.
     1280     def var ind as integer no-undo .
     1281     def var v-elem as character no-undo .
     1282     def var v-result-list as character no-undo init "".
     1283     def var v-num-parfirst-list as integer no-undo .
     1284     assign
     1285       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1286     .
     1287     do ind = 1 to v-num-parfirst-list
     1288     :
     1289       assign
     1290         v-elem = entry(ind, parfirst-list, pardelim)
     1291       .
     1292       if lookup(v-elem, v-result-list, pardelim) = 0
     1293       and lookup(v-elem, parsecond-list, pardelim) > 0
     1294       then do:
     1295         assign
     1296           v-result-list = v-result-list
     1297                         + (if v-result-list > "" then pardelim else "")
     1298                         + v-elem
     1299         .
     1300       end.
     1301     end.
     1302     return v-result-list .
     1303   end function.
     1304   function radio-label returns character (
     1305    input par-rs-value  as character,
     1306    input par-rs-radio-buttons as character)
     1307    .
     1308    DEFINE variable v-result-label as character no-undo.
     1309    assign
     1310    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
     1311                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
     1312                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
     1313                             ), par-rs-radio-buttons
     1314                           )
     1315    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1316    .
     1317   return v-result-label.
     1318   end function.
     1319   function m-radio-label returns character (
     1320    input par-rs-value  as character,
     1321    input par-rs-radio-buttons as character,
     1322    input par-delim as character
     1323    )
     1324    .
     1325    DEFINE variable v-result-label as character no-undo.
     1326    assign
     1327    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
     1328                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
     1329                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
     1330                             ), par-rs-radio-buttons, par-delim
     1331                           )
     1332    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1333    .
     1334   return v-result-label.
     1335   end function.
     1336   FUNCTION mixlist returns character
     1337   (
     1338    input parfirst-list  as character
     1339    ,input parsecond-list as character
     1340    ,input pardelim       as character
     1341    ,input pardelim-result as character ) :
     1342     if pardelim = ""
     1343     or pardelim = ?
     1344     then do:
     1345       assign
     1346         pardelim = ","
     1347       .
     1348     end.
     1349     def var ind as integer no-undo .
     1350     def var v-elem1 as character no-undo .
     1351     def var v-elem2 as character no-undo .
     1352     def var v-result-list as character no-undo init "".
     1353     do ind = 1 to num-entries(parfirst-list, pardelim)
     1354     :
     1355       assign
     1356         v-elem1 = entry(ind, parfirst-list, pardelim)
     1357         v-elem2 = entry(ind, parsecond-list, pardelim)
     1358       .
     1359         assign
     1360           v-result-list = v-result-list
     1361                         + (if v-result-list > "" then pardelim-result else "")
     1362                         + v-elem1 + pardelim-result + v-elem2
     1363         .
     1364     end.
     1365     return v-result-list .
     1366   END FUNCTION.
     1367   procedure save-db-key :
     1368     define input parameter p-db-key like ub.db.db-key no-undo .
     1369     do
     1370     on error undo, return error
     1371     :
     1372       define buffer buf_rep for ub.rep .
     1373       find buf_rep
     1374         where buf_rep.rep-num = 1996011200
     1375         no-error
     1376       .
     1377       if not available buf_rep then do:
     1378         create buf_rep.
     1379         assign
     1380           buf_rep.rep-num = 1996011200
     1381         .
     1382       end.
     1383       if lookup( p-db-key, buf_rep.name1 ) = 0 then do:
     1384         assign
     1385           buf_rep.name1 = buf_rep.name1 + ",":U + p-db-key
     1386         .
     1387       end.
     1388     end.
     1389   end procedure.
     1390   procedure del-db-key :
     1391     define input parameter p-db-key like ub.db.db-key no-undo .
     1392     do
     1393     on error undo, return error
     1394     :
     1395       define buffer buf_rep for ub.rep .
     1396       define buffer buf_db  for ub.db .
     1397       find first buf_db
     1398         where buf_db.db-key = p-db-key
     1399         no-error
     1400       .
     1401       if not available buf_db then do:
     1402         find first buf_rep
     1403           where buf_rep.rep-num = 1996011200
     1404           no-error
     1405         .
     1406         if available buf_rep
     1407           and lookup( p-db-key, buf_rep.name1 ) <> 0
     1408         then do:
     1409           assign
     1410             buf_rep.name1 = diff-list( buf_rep.name1, p-db-key, ",":U )
     1411           .
     1412         end.
     1413       end.
     1414     end.
     1415   end procedure.
     1416   procedure chk-db-key :
     1417     define input  parameter p-db-num     like ub.db.db-num     no-undo.
     1418     define input  parameter p-db-key     like ub.db.db-key     no-undo.
     1419     define input  parameter p-db-key-enc like ub.db.db-key-enc no-undo.
     1420     define output parameter p-result     as   integer          no-undo .
     1421     do
     1422     on error undo, return error
     1423     :
     1424       define buffer buf_rep for ub.rep .
     1425       define buffer buf_db  for ub.db .
     1426       define variable v-ok as logical no-undo .
     1427       if p-db-key = ?
     1428         or p-db-key = ""
     1429       then do:
     1430         assign
     1431           p-result = 1
     1432         .
     1433         return string("Не задано значение ключа БД.").
     1434       end.
     1435       if p-db-key-enc = ?
     1436         or p-db-key-enc = ""
     1437       then do:
     1438         assign
     1439           p-result = 2
     1440         .
     1441         return string("Не задано кодированное значение ключа БД.").
     1442       end.
     1443       find buf_rep
     1444         where buf_rep.rep-num = 1996011200
     1445         no-error
     1446       .
     1447       if not available buf_rep then do:
     1448         create buf_rep.
     1449         assign
     1450           buf_rep.rep-num = 1996011200
     1451         .
     1452       end.
     1453       for each buf_db no-lock
     1454       on error undo, return error
     1455       :
     1456         if lookup( buf_db.db-key, buf_rep.name1 ) = 0 then do:
     1457           assign
     1458             buf_rep.name1 = buf_rep.name1 + ",":U + buf_db.db-key
     1459           .
     1460         end.
     1461       end.
     1462       assign
     1463         p-result = 0
     1464       .
     1465       if lookup( p-db-key, buf_rep.name1 ) <> 0 then do:
     1466         assign
     1467           p-result = 1
     1468         .
     1469         return string("Данное значение ключа БД уже существует.").
     1470       end.
     1471       run check-enc in this-procedure
     1472         ( input p-db-num
     1473          ,input p-db-key
     1474          ,input ""
     1475          ,input ""
     1476          ,input ?
     1477          ,input ?
     1478          ,input p-db-key-enc
     1479          ,output v-ok
     1480         ) no-error.
     1481       if error-status:error then do:
     1482         assign
     1483           p-result = 1
     1484         .
     1485         return substitute( "Ошибка при проверке правильности кодирования. &1", error-status:get-message (1) ) .
     1486       end.
     1487       if v-ok <> true then do:
     1488         assign
     1489           p-result = 2
     1490         .
     1491         return string("Неверное кодированное значение ключа БД.").
     1492       end.
     1493     end.
     1494   end procedure.
     1495   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1496   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1497   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1498   procedure progs-name :
     1499     define input  parameter p-action-code         as character no-undo .
     1500     define output parameter p-main-prog-name      as character no-undo .
     1501     define output parameter p-list-db-proc-name   as character no-undo .
     1502     define output parameter p-commit-proc-name    as character no-undo .
     1503     define output parameter p-execution-proc-name as character no-undo .
     1504     define output parameter p-recover-proc-name   as character no-undo .
     1505     define output parameter p-after-proc-name     as character no-undo .
     1506     do
     1507     on error undo, return error
     1508     :
     1509       case p-action-code :
     1510               when 'crush_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-crush-cdrg':U       p-execution-proc-name = 'exec-crush-cdrg':U       p-recover-proc-name   = 'rcvr-crush-cdrg':U       p-after-proc-name     = '':U     .   end.
     1511               when 'delete_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-del-cdrg':U       p-execution-proc-name = 'exec-del-cdrg':U       p-recover-proc-name   = 'rcvr-del-cdrg':U       p-after-proc-name     = '':U     .   end.
     1512               when 'delete_nu-prt-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-prt-bar-code':U       p-execution-proc-name = 'delete-prt-bar-code':U       p-recover-proc-name   = 'undo-delete-prt-bar-code':U       p-after-proc-name     = '':U     .   end.
     1513               when 'delete_nu-part-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-part-bar-code':U       p-execution-proc-name = 'delete-part-bar-code':U       p-recover-proc-name   = 'undo-delete-part-bar-code':U       p-after-proc-name     = '':U     .   end.
     1514               when 'delete_nu-ucli-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-ucli-bar-code':U       p-execution-proc-name = 'delete-ucli-bar-code':U       p-recover-proc-name   = 'undo-delete-ucli-bar-code':U       p-after-proc-name     = '':U     .   end.
     1515               when 'delete_nu-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-del-dis-card':U       p-execution-proc-name = 'delete-dis-card':U       p-recover-proc-name   = 'undo-delete-dis-card':U       p-after-proc-name     = '':U     .   end.
     1516               when 'chown-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-chown-dis-card':U       p-execution-proc-name = 'chown-dis-card':U       p-recover-proc-name   = 'undo-chown-dis-card':U       p-after-proc-name     = 'after-chown-dis-card':U     .   end.
     1517               when 'delete_nu-dis-rule':U then do:     assign       p-main-prog-name      = 'trg/dis-rult.p':U       p-list-db-proc-name   = 'trg/disruldb.p':U       p-commit-proc-name    = 'block-del-dis-rule':U       p-execution-proc-name = 'delete-dis-rule':U       p-recover-proc-name   = 'undo-delete-dis-rule':U       p-after-proc-name     = '':U     .   end.
     1518               when 'ren-art':U then do:     assign       p-main-prog-name      = 'trg/goodst.p':U       p-list-db-proc-name   = 'utl/renartcd.p':U       p-commit-proc-name    = 'comm-ren-art':U       p-execution-proc-name = 'exec-ren-art':U       p-recover-proc-name   = 'rcvr-ren-art':U       p-after-proc-name     = 'after-ren-art':U     .   end.
     1519               when 'delete_nu-clob-data':U then do:     assign       p-main-prog-name      = 'trg/clobdatt.p':U       p-list-db-proc-name   = 'trg/clbdatdb.p':U       p-commit-proc-name    = 'block-del-clob-data':U       p-execution-proc-name = 'delete-clob-data':U       p-recover-proc-name   = 'undo-delete-clob-data':U       p-after-proc-name     = '':U     .   end.
     1520               when 'delete_nu-layout':U then do:     assign       p-main-prog-name      = 'trg/layoutt.p':U       p-list-db-proc-name   = 'trg/layoutdb.p':U       p-commit-proc-name    = 'block-del-layout':U       p-execution-proc-name = 'delete-layout':U       p-recover-proc-name   = 'undo-delete-layout':U       p-after-proc-name     = '':U     .   end.
     1521               otherwise do:
     1522           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info7, p-action-code ).
     1523         end.
     1524       end case.
     1525     end.
     1526     return.
     1527   end procedure.
     1528   procedure progs-title :
     1529     define input  parameter p-action-code         as character no-undo .
     1530     define output parameter p-action-title      as character no-undo .
     1531     do
     1532     on error undo, return error
     1533     :
     1534       case p-action-code :
     1535               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
     1536               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
     1537               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
     1538               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
     1539               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
     1540               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
     1541               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
     1542               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
     1543               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
     1544               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
     1545               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
     1546               otherwise do:
     1547           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info7, p-action-code ).
     1548         end.
     1549       end case.
     1550     end.
     1551     return.
     1552   end procedure.
     1553   FUNCTION progs-title-function returns character(
     1554      input  p-action-code         as character):
     1555   define variable p-action-title      as character no-undo .
     1556     do
     1557     on error undo, return error
     1558     :
     1559       case p-action-code :
     1560               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
     1561               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
     1562               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
     1563               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
     1564               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
     1565               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
     1566               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
     1567               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
     1568               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
     1569               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
     1570               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
     1571               otherwise do:
     1572           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info7, p-action-code ).
     1573         end.
     1574       end case.
     1575     end.
     1576     return p-action-title.
     1577   end FUNCTION.
     1578   procedure get-row-keyr-string :
     1579    define input  parameter p-key-rec  as character no-undo.
     1580    define output parameter p-tbl-title as character no-undo.
     1581    define output parameter p-rec-string  as character no-undo.
     1582     do
     1583     on error undo, return error
     1584     :
     1585       define variable v-full-tbl-name as character no-undo .
     1586       define variable bh_tbl-name     as handle    no-undo .
     1587       define variable fh              as handle    no-undo .
     1588       define variable v-ok            as logical   no-undo .
     1589       define variable v-field-num     as integer   no-undo .
     1590       define variable v-count-fld     as integer   no-undo .
     1591       define variable v-tbl-name as character no-undo.
     1592       if p-key-rec = ?
     1593         or p-key-rec = "":U
     1594       then do:
     1595         return error substitute( "&1 (get-row-keyr-string). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info7 ).
     1596       end.
     1597       assign
     1598         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1599         v-full-tbl-name = "ub.":U + v-tbl-name
     1600         v-field-num     = num-entries( p-key-rec, chr(3) ) - 1
     1601         p-rec-string         = "":U
     1602         v-count-fld     = 0
     1603       .
     1604       find ub._file
     1605         where ub._file._file-name = v-tbl-name
     1606         no-error.
     1607       if not available ub._file then do:
     1608         return error substitute( "&1. Таблица &2 отсутствует в БД", vss-include-info7, v-tbl-name ).
     1609       end.
     1610       assign
     1611       p-tbl-title = ub._file._file-label
     1612       .
     1613       find ub._index
     1614         where recid( ub._index  ) = ub._file._prime-index
     1615         no-error.
     1616       if not available ub._index
     1617         or LC( ub._index._index-name ) = "default":U
     1618       then do:
     1619         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, v-tbl-name ).
     1620       end.
     1621       block_where :
     1622       for each ub._index-field of ub._index  ,
     1623           each ub._field of _index-field
     1624           break by _index-seq
     1625       on error undo, return error
     1626       :
     1627         assign
     1628           v-count-fld = v-count-fld + 1
     1629         .
     1630         if v-count-fld > v-field-num then do:
     1631           leave block_where.
     1632         end.
     1633         if p-rec-string = "":U then do:
     1634           assign
     1635             p-rec-string = "":U
     1636           .
     1637         end.
     1638         else do:
     1639           assign
     1640             p-rec-string = p-rec-string + chr(32) + chr(44)
     1641           .
     1642         end.
     1643         assign
     1644           p-rec-string = p-rec-string + (if p-rec-string = "":u then "":U else chr(32)) + substitute( "&1 = &2":U, ub._field._label, entry( v-count-fld + 1 , p-key-rec, chr(3) ) )
     1645         .
     1646       end.
     1647       if v-count-fld <> v-field-num then do:
     1648         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info7, v-tbl-name ).
     1649       end.
     1650     end.
     1651     return.
     1652   end procedure.
     1653   FUNCTION uniq-key-rec-string-f returns character(
     1654      input  p-uniq-key-rec         as character):
     1655   define variable v-tbl-title as character no-undo .
     1656   define variable v-rec-string as character no-undo .
     1657     do
     1658     on error undo, return error
     1659     :
     1660       run get-row-keyr-string in this-procedure (
     1661                                                 input p-uniq-key-rec
     1662                                                 ,output v-tbl-title
     1663                                                 ,output v-rec-string).
     1664       assign
     1665       v-rec-string = (if v-tbl-title <> ? and
     1666                       v-tbl-title <> "":U
     1667                       then (v-tbl-title + ":")
     1668                      else "":U) + chr(32) + v-rec-string
     1669       .
     1670     end.
     1671     return v-rec-string.
     1672   end FUNCTION.
     1673   procedure create_db-rec_route :
     1674     define input parameter p1-uniq-key-rec as character no-undo .
     1675     define input parameter p1-action       as character no-undo .
     1676     define input parameter p1-operation    as character no-undo .
     1677     define input parameter p1-send-db-list as character no-undo .
     1678     define input parameter p1-db-init      as integer   no-undo .
     1679     define input parameter p1-parameters   as character no-undo .
     1680     define input parameter p1-answer-code  as integer   no-undo .
     1681     define input parameter p1-answer-msg   as character no-undo .
     1682     do
     1683     on error undo, return error
     1684     :
     1685       define variable v-command     as character no-undo .
     1686       define variable v-ind         as integer   no-undo .
     1687       define variable v-num-entries as integer   no-undo .
     1688       define variable v-curr-db     as integer   no-undo .
     1689       define variable v-db-for-send as character no-undo .
     1690       define variable v-db-num      as integer   no-undo .
     1691       define variable v-db-num-char as character no-undo .
     1692       define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1693       find first buf_sys-ctrl no-lock .
     1694       assign
     1695         v-curr-db     = buf_sys-ctrl.db-num
     1696         v-db-for-send = "":U
     1697       .
     1698       if v-curr-db = 0 then do:
     1699         if p1-answer-code >= 0 then do:
     1700           if v-curr-db <> p1-db-init then do:
     1701             assign
     1702               v-db-for-send = string( p1-db-init )
     1703             .
     1704           end.
     1705         end.
     1706         else do:
     1707           assign
     1708             v-num-entries = num-entries( p1-send-db-list, chr(44) )
     1709           .
     1710           do v-ind = 1 to v-num-entries:
     1711             assign
     1712               v-db-num-char = entry( v-ind, p1-send-db-list, chr(44) )
     1713               v-db-num      = integer( v-db-num-char )
     1714             .
     1715             if v-db-num <> v-curr-db
     1716               and v-db-num <> p1-db-init
     1717             then do:
     1718               if v-db-for-send = "":U then do:
     1719                 assign
     1720                   v-db-for-send = v-db-num-char
     1721                 .
     1722               end.
     1723               else do:
     1724                 assign
     1725                   v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
     1726                 .
     1727               end.
     1728             end.
     1729           end.
     1730         end.
     1731       end.
     1732       else do:
     1733         assign
     1734           v-db-for-send = "0":U
     1735         .
     1736       end.
     1737       if v-db-for-send <> "":U then do:
     1738         assign
     1739           v-command = "command":U + chr(1)
     1740                       + "two-commit":U + chr(1)
     1741                       + p1-action + chr(1)
     1742                       + p1-operation + chr(1)
     1743                       + p1-uniq-key-rec + chr(1)
     1744                       + string( p1-db-init ) + chr(1)
     1745                       + p1-parameters + chr(1)
     1746                       + string( p1-answer-code ) + chr(1)
     1747                       + p1-answer-msg
     1748         .
     1749         run nws/cr-route.p ( input 'send-cmd':U
     1750                       ,input v-command
     1751                       ,input ?
     1752                       ,input v-db-for-send
     1753                       ) no-error .
     1754         if error-status :error then do:
     1755           return error return-value.
     1756         end.
     1757       end.
     1758     end.
     1759     return.
     1760   end procedure.
     1761   procedure create_msg_route :
     1762     define input parameter p2-send-db-list as character no-undo .
     1763     define input parameter p2-msg          as character no-undo .
     1764     do
     1765     on error undo, return error
     1766     :
     1767       define variable v-msg-command as character no-undo .
     1768       define variable v-ind         as integer   no-undo .
     1769       define variable v-num-entries as integer   no-undo .
     1770       define variable v-curr-db     as integer   no-undo .
     1771       define variable v-db-for-send as character no-undo .
     1772       define variable v-db-num      as integer   no-undo .
     1773       define variable v-db-num-char as character no-undo .
     1774       define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1775       find first buf_sys-ctrl no-lock .
     1776       assign
     1777         v-curr-db     = buf_sys-ctrl.db-num
     1778         v-db-for-send = "":U
     1779       .
     1780       if v-curr-db = 0 then do:
     1781         assign
     1782           v-num-entries = num-entries( p2-send-db-list, chr(44) )
     1783         .
     1784         do v-ind = 1 to v-num-entries:
     1785           assign
     1786             v-db-num-char = entry( v-ind, p2-send-db-list, chr(44) )
     1787             v-db-num      = integer( v-db-num-char )
     1788           .
     1789           if v-db-num <> v-curr-db then do:
     1790             if v-db-for-send = "":U then do:
     1791               assign
     1792                 v-db-for-send = v-db-num-char
     1793               .
     1794             end.
     1795             else do:
     1796               assign
     1797                 v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
     1798               .
     1799             end.
     1800           end.
     1801         end.
     1802       end.
     1803       else do:
     1804         assign
     1805           v-db-for-send = "0":U
     1806         .
     1807       end.
     1808       if v-db-for-send <> "":U then do:
     1809         assign
     1810           v-msg-command = "command":U + chr(1)
     1811                           + "message-to-log":U + chr(1)
     1812                           + p2-msg
     1813         .
     1814         run nws/cr-route.p ( input 'send-cmd':U
     1815                       ,input v-msg-command
     1816                       ,input ?
     1817                       ,input v-db-for-send
     1818                       ) no-error .
     1819         if error-status :error then do:
     1820           return error substitute( "&1&2&3"
     1821                                     , return-value
     1822                                     , chr(10)
     1823                                     , error-status :get-message(1)
     1824                                   ).
     1825         end.
     1826       end.
     1827     end.
     1828     return.
     1829   end procedure.
     1830   function get-send-db-list returns character
     1831     ( input p-curr-db     as integer
     1832      ,input p-all-db-list as character
     1833     )
     1834   :
     1835     define variable v-send-db-list as character no-undo .
     1836     if p-curr-db = 0 then do:
     1837       assign
     1838         v-send-db-list = p-all-db-list
     1839       .
     1840     end.
     1841     else do:
     1842       assign
     1843         v-send-db-list = string(p-curr-db)
     1844       .
     1845     end.
     1846     return v-send-db-list .
     1847   end function .
     1848   define temp-table temp_db-rec-attr no-undo like ub.db-rec-attr
     1849     field db-list as character
     1850   .
     1851   procedure fill-two-commit-command :
     1852     do
     1853     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1854     on stop   undo, return error substitute( "&1. stop", vss-workfile )
     1855     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     1856     :
     1857       define variable v-main-prog-name      as character no-undo .
     1858       define variable v-list-db-proc-name   as character no-undo .
     1859       define variable v-commit-proc-name    as character no-undo .
     1860       define variable v-execution-proc-name as character no-undo .
     1861       define variable v-recover-proc-name   as character no-undo .
     1862       define variable v-after-proc-name     as character no-undo .
     1863       define buffer buf_db-rec-attr for ub.db-rec-attr .
     1864       for each buf_db-rec-attr exclusive-lock
     1865         break by buf_db-rec-attr.db-num
     1866       on error undo, return error return-value
     1867       :
     1868         find first temp_db-rec-attr
     1869           where temp_db-rec-attr.uniq-key-rec = buf_db-rec-attr.uniq-key-rec
     1870             and temp_db-rec-attr.attr-code    = buf_db-rec-attr.attr-code
     1871           no-error.
     1872         if not available temp_db-rec-attr then do:
     1873           create temp_db-rec-attr.
     1874           buffer-copy buf_db-rec-attr to temp_db-rec-attr
     1875             assign
     1876               temp_db-rec-attr.db-list = string( buf_db-rec-attr.db-num )
     1877           .
     1878           run progs-name in this-procedure
     1879             ( input buf_db-rec-attr.attr-code
     1880              ,output v-main-prog-name
     1881              ,output v-list-db-proc-name
     1882              ,output v-commit-proc-name
     1883              ,output v-execution-proc-name
     1884              ,output v-recover-proc-name
     1885              ,output v-after-proc-name
     1886             ) no-error .
     1887           if error-status :error then do:
     1888             return error substitute( "&1. Ошибка при определении имен процедур. &2", vss-workfile, return-value ).
     1889           end.
     1890           run value( v-list-db-proc-name )
     1891             ( input buf_db-rec-attr.attr-code
     1892              ,input buf_db-rec-attr.uniq-key-rec
     1893              ,output temp_db-rec-attr.db-list
     1894             ) no-error .
     1895           if error-status :error then do:
     1896             return error substitute( "&1. Ошибка при определении списка БД. &2", vss-workfile, return-value ).
     1897           end.
     1898         end.
     1899         if temp_db-rec-attr.db-num <> 0 then do:
     1900           if buf_db-rec-attr.db-num = 0 then do:
     1901             assign
     1902               temp_db-rec-attr.db-num = buf_db-rec-attr.db-num
     1903             .
     1904           end.
     1905           else do:
     1906             assign
     1907               temp_db-rec-attr.db-num = ?
     1908             .
     1909           end.
     1910         end.
     1911       end.
     1912       return.
     1913     end.
     1914   end procedure.
     1915   define new global shared variable g#library  as handle no-undo .
     1916   define new global shared variable g#library2 as handle no-undo .
     1917   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1918   define new global shared variable g#attr-lib  as handle no-undo .
     1919   define variable v-attr-lib-variable as handle no-undo .
     1920   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1921   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1922   procedure thbjattr_code :
     1923      define input  parameter p-upper-code     as character no-undo .
     1924      define input  parameter p-code           as character no-undo .
     1925      define output parameter p-label          as character no-undo .
     1926      define output parameter p-user-can-edit  as logical   no-undo .
     1927      define output parameter p-output-display as logical   no-undo .
     1928      define output parameter p-other          as character no-undo .
     1929      define output parameter p-prop-list      as character no-undo .
     1930      define output parameter p-prop-type-list as character no-undo .
     1931      define output parameter p-prop-label-list as character no-undo .
     1932      define output parameter p-global          as logical no-undo .
     1933      define output parameter p-host           as logical no-undo .
     1934      define output parameter p-shop           as logical no-undo .
     1935      define output parameter p-store          as logical no-undo .
     1936      define output parameter p-db             as logical no-undo .
     1937      define variable p-region as logical no-undo.
     1938      run thbjattr_code_reg in this-procedure (
     1939                                               p-upper-code,
     1940                                               p-code,
     1941                                               output p-label,
     1942                                               output p-user-can-edit,
     1943                                               output p-output-display,
     1944                                               output p-other,
     1945                                               output p-prop-list,
