     2209   procedure proc-b-attrdb :
     2210   define input parameter p-mode as character no-undo .
     2211   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     2212   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     2213   define variable v-sts as integer no-undo .
     2214   define variable vattr-codes as character no-undo .
     2215   define variable vattr-labels as character no-undo .
     2216   define variable ii as integer no-undo .
     2217   define variable v-attr-code like ub.clients-attr.attr-code no-undo .
     2218   define variable attr-label as character no-undo .
     2219   define variable attr-user-can-edit as logical no-undo .
     2220   define variable attr-output-display as logical no-undo .
     2221   define variable attr-other as char no-undo .
     2222   define variable v-prop-list as character no-undo .
     2223   define variable v-prop-type-list as character no-undo .
     2224   define variable v-prop-label-list as character no-undo .
     2225   define variable v-global as logical no-undo .
     2226   define variable v-host as logical no-undo .
     2227   define variable v-shop as logical no-undo .
     2228   define variable v-store as logical no-undo .
     2229   define variable v-db as logical   no-undo .
     2230   define variable attr-value as char no-undo .
     2231   define variable v-spr as character no-undo .
     2232   define variable v-title as character no-undo .
     2233   define variable v-ii as integer no-undo .
     2234   define variable v-ok as integer no-undo .
     2235   define variable v-rid-list as character no-undo .
     2236   define variable v-rec as recid no-undo .
     2237   define variable conf-par as character no-undo .
     2238   define variable par-type as character no-undo .
     2239   define variable v-firm-code as integer   no-undo .
     2240   define variable v-from-obj-code  as integer no-undo .
     2241   define variable v-found as decimal no-undo .
     2242   define buffer buf_clients for ub.clients.
     2243   define buffer buf_sysconf for ub.sysconf.
     2244   define buffer buf_shop for ub.shop.
     2245   define buffer buf_store for ub.store.
     2246   define buffer buf_db for ub.db.
     2247   do
     2248   on error undo, return error
     2249   :
     2250   assign
     2251   vattr-codes = "":U
     2252   vattr-labels = "":U
     2253   .
     2254   _II:
     2255   DO ii = 1 to num-entries('autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U):
     2256     run thbjattr_code (
     2257                          input entry(ii, 'autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U)
     2258                         ,input   '':U
     2259                         ,output  attr-label
     2260                         ,output  attr-user-can-edit
     2261                         ,output  attr-output-display
     2262                         ,output  attr-other
     2263                         ,output v-prop-list
     2264                         ,output v-prop-type-list
     2265                         ,output v-prop-label-list
     2266                         ,output v-global
     2267                         ,output v-host
     2268                         ,output v-shop
     2269                         ,output v-store
     2270                         ,output v-db
     2271                       ) no-error.
     2272       .
     2273       if NOT error-status:error
     2274       and attr-user-can-edit
     2275       and index(attr-other, "spr-ext=") > 0
     2276       anD (if p-obj-type = 'маг':U
     2277            then v-shop
     2278            else (if p-obj-type = 'скл':U
     2279                  then v-store
     2280                  else (if p-obj-type = 'орг':U
     2281                        then v-host
     2282                        else (if p-obj-type = 'БД':U
     2283                             then v-db
     2284                             else v-global)
     2285                       )
     2286                  )
     2287            ) then do:
     2288         if entry(ii, 'autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U) = 'alias-tpsi':U then do:
     2289   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2290     (input  'tpsi'
     2291     ,input  0
     2292     ,input  ''
     2293     ,input  0
     2294     ,input  ''
     2295     ,input  ''
     2296     ,input  ''
     2297     ,input  no
     2298     ,output conf-par
     2299     ,output par-type
     2300     ) no-error .
     2301           if error-status:error
     2302           or (conf-par <> "yes") then next _ii.
     2303         end.
     2304         assign
     2305         vattr-codes = vattr-codes + chr(44) + entry(ii, 'autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U)
     2306         vattr-labels = vattr-labels + chr(44) + attr-label
     2307         .
     2308       end.
     2309   end.
     2310   CASE p-mode:
     2311     when 'ПРОСМОТР':U then do:
     2312       assign
     2313       v-title = "Выберите типы параметров для просмотра".
     2314     end.
     2315     when 'ИЗМЕНЕНИЕ':U then do:
     2316       assign
     2317       v-title = "Выберите типы параметров для редактирования".
     2318     end.
     2319     when  'КОПИРОВАНИЕ':U then do:
     2320       assign
     2321       v-title = "Выберите типы параметров для копирования".
     2322     end.
     2323   END CASE.
     2324   run gbl/d-list.w (
     2325                  INPUT (if p-mode = 'КОПИРОВАНИЕ':U then "b-sel,b-mark":U else "b-sel":U)
     2326                 ,INPUT v-title
     2327                 ,INPUT vattr-codes
     2328                 ,INPUT vattr-labels
     2329                 ,INPUT chr(44)
     2330                 ,INPUT "":U
     2331                 ,output v-attr-code).
     2332   IF v-attr-code = "":u THEN do:
     2333     RETURN ''.
     2334   end.
     2335   if p-mode = 'ПРОСМОТР':U
     2336   or p-mode = 'ИЗМЕНЕНИЕ':U then do:
     2337     run thbjattr_code  in this-procedure (
     2338          input   v-attr-code
     2339         ,input   '':U
     2340         ,output  attr-label
     2341         ,output  attr-user-can-edit
     2342         ,output  attr-output-display
     2343         ,output  attr-other
     2344         ,output v-prop-list
     2345         ,output v-prop-type-list
     2346         ,output v-prop-label-list
     2347         ,output v-global
     2348         ,output v-host
     2349         ,output v-shop
     2350         ,output v-store
     2351         ,output v-db
     2352     ).
     2353     do ii = 1 to num-entries(attr-other, chr(47)):
     2354       if entry(ii, attr-other, chr(47)) begins "spr-ext=":U then do:
     2355         assign
     2356         v-spr = entry(2, entry(ii, attr-other, chr(47)), "=").
     2357       end.
     2358     end.
     2359     run value(v-spr) (
     2360                      input parparentproc
     2361                     ,input p-mode
     2362                     ,input p-obj-type
     2363                     ,input p-obj-code
     2364                     ).
     2365   end.
     2366   else do:
     2367      if p-obj-type = 'маг':U then do:
     2368       message
     2369       "Выберите магазин для копирования ПАРАМЕТРОВ"
     2370       view-as alert-box WARNING.
     2371         run adm/shops.w ( input parparentproc
     2372                          ,input "b-sel"
     2373                          ,input-output v-rid-list
     2374                          ,no ).
     2375        if v-rid-list = "":U then return.
     2376        find first buf_shop no-lock where
     2377                 recid(buf_shop) = integer(v-rid-list) .
     2378        v-from-obj-code = buf_shop.obj-code.
     2379      end.
     2380      if p-obj-type = 'орг':U then do:
     2381         message
     2382         "Выберите ФИРМУ для копирования ПАРАМЕТРОВ"
     2383         view-as alert-box WARNING.
     2384         run adm/sconfs.w (
     2385               input parParentProc
     2386             , input "b-sel":U
     2387             , input no
     2388             , input 0
     2389             , output v-firm-code
     2390             , input-output v-rid-list
     2391         ) no-error.
     2392         if v-rid-list = "":U then return.
     2393       find first buf_sysconf no-lock
     2394                         where recid(buf_sysconf) = integer(entry(1, v-rid-list)).
     2395       v-from-obj-code = buf_sysconf.host-code.
     2396      end.
     2397      if p-obj-type = 'скл':U then do:
     2398       message
     2399       "Выберите склад для копирования ПАРАМЕТРОВ"
     2400       view-as alert-box WARNING.
     2401         run adm/stores.w ( input parparentproc
     2402                           ,input "b-sel"
     2403                           ,input-output v-rid-list
     2404                           ,input no ).
     2405        if v-rid-list = "":U then return.
     2406        find first buf_store no-lock where
     2407                 recid(buf_store) = integer(v-rid-list) .
     2408        v-from-obj-code = buf_store.obj-code.
     2409      end.
     2410      if p-obj-type = 'БД':U then do:
     2411         message
     2412         "Выберите БД для копирования ПАРАМЕТРОВ"
     2413         view-as alert-box WARNING.
     2414         run adm/dbs.w (
     2415               input parParentProc
     2416             , input 'ПРОСМОТР':U
     2417             , output v-rec
     2418         ) no-error.
     2419         if v-rec = ? then return.
     2420       find first buf_db no-lock
     2421                         where recid(buf_db) = v-rec.
     2422       v-from-obj-code = buf_db.db-num.
     2423      end.
     2424      if (p-obj-type = 'маг':U
     2425      AND p-obj-code = buf_shop.obj-code )
     2426      or (p-obj-type = 'скл':U
     2427      AND p-obj-code = buf_store.obj-code )
     2428      or (p-obj-type = 'орг':U
     2429      AND p-obj-code = buf_sysconf.host-code )
     2430      or (p-obj-type = 'БД':U
     2431      AND p-obj-code = buf_db.db-num )
     2432      or (p-obj-type = '':U
     2433      AND p-obj-code = 0 )
     2434      then do:
     2435        message "Нельзя копировать ПАРАМЕТРЫ самих в себя"
     2436        view-as alert-box error .
     2437        return error .
     2438      end.
     2439      run waitfram-show in this-procedure ( input "Ждите..." ).
     2440      DO ii = 1 to num-entries(v-attr-code):
     2441         for each thbjattr_thbj-attr:
     2442           delete thbjattr_thbj-attr.
     2443         end.
     2444         assign
     2445         v-ii = v-ii + 1.
     2446         run thbjattr_get-section  in this-procedure (
     2447              input  p-obj-type
     2448             ,input  v-from-obj-code
     2449             ,input  entry(ii, v-attr-code)
     2450             ,input '':U
     2451             ,input-output table thbjattr_thbj-attr
     2452             ,output v-found
     2453                                                 ) no-error .
     2454         if not error-status:error then do:
     2455           run thbjattr_set-section in this-procedure (
     2456                                                  input p-obj-type
     2457                                                 ,input p-obj-code
     2458                                                 ,input entry(ii, v-attr-code)
     2459                                                 ,input table thbjattr_thbj-attr ) no-error .
     2460           if not error-status:error then
     2461           assign
     2462           v-ok = v-ok + 1
     2463           .
     2464         end.
     2465      end.
     2466      run waitfram-hide in this-procedure .
     2467      if v-ii = v-ok then do:
     2468         message
     2469         substitute("Скопировано &1 параметров с &4&5 на &2&3"
     2470                    , v-ok
     2471                    , p-obj-type
     2472                    , p-obj-code
     2473                    , p-obj-type
     2474                    , v-from-obj-code
     2475                    )
     2476         view-as alert-box .
     2477      end.
     2478      else do:
     2479         message
     2480         substitute("Из &1 параметров удалось скопировать &2 параметров с &3&4 на &5&6"
     2481                    , v-ii
     2482                    , v-ok
     2483                    , p-obj-type
     2484                    , p-obj-code
     2485                    , p-obj-type
     2486                    , v-from-obj-code
     2487                    )
     2488         view-as alert-box WARNING.
     2489      end.
     2490   end.
     2491   end.
     2492   end procedure.
     2493   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2494   define new global shared variable g#lib-nws as handle no-undo .
     2495   define buffer buf_sys-ctrl for ub.sys-ctrl .
     2496   define variable log-res       as logical   no-undo .
     2497   define variable v-rowid       as rowid     no-undo .
     2498   define variable v-type-unload as character no-undo .
     2499   DEFINE VARIABLE hn-option AS CHARACTER NO-UNDO.
     2500   DEFINE VARIABLE attr-option AS CHARACTER NO-UNDO.
     2501   define variable select-list       as longchar  no-undo .
     2502   define variable v-str as character no-undo .
     2503   define variable v-ind as integer   no-undo .
     2504   define frame f-info
     2505     v-str format "x(50)" NO-LABEL skip
     2506     v-ind label "Записей" format ">>>>>>>>9" skip
     2507     with view-as dialog-box side-labels 1 columns three-d title ""
     2508   .
     2509   FUNCTION get-infodb-date RETURNS DATE
     2510     ( INPUT p-db-num as integer)  FORWARD.
     2511   FUNCTION get-infodb-ver RETURNS character
     2512     ( INPUT p-db-num as integer)  FORWARD.
     2513   function get-mark returns character
     2514     (buffer local-db for ub.db ):
     2515     if lookup (string (recid (local-db)), select-list) > 0  then return "*".
     2516     else return "".
     2517   end function.
     2518   DEFINE MENU MENU-b-hn
     2519          MENU-ITEM m_hn-lookup    LABEL "Просмотр"
     2520          MENU-ITEM m_hn-update    LABEL "Изменить"
     2521          MENU-ITEM m_hn-copy      LABEL "Копировать"    .
     2522   DEFINE MENU MENU-b-param
     2523          MENU-ITEM m_lookup       LABEL "Просмотр"
     2524          MENU-ITEM m_update       LABEL "Изменение"
     2525          MENU-ITEM m_copy         LABEL "Копирование"   .
     2526   DEFINE MENU POPUP-MENU-b-print
     2527          MENU-ITEM m_b-print-RC LABEL "Отчет по версиям RC на БД"
     2528          MENU-ITEM m_b-print-hist LABEL "Историческая справка по версиям RC на выбранной БД"
     2529          .
     2530   DEFINE MENU POPUP-MENU-b-unld
     2531          MENU-ITEM m_online-unload LABEL "online-выгрузка" ACCELERATOR "в"
     2532          MENU-ITEM m_prep-copy    LABEL "Подготовка копии" ACCELERATOR "к".
     2533   DEFINE BUTTON b-add
     2534        LABEL "&Создать"
     2535        SIZE 10 BY 1.
     2536   DEFINE BUTTON b-attr
     2537        LABEL "&Атрибуты"
     2538        SIZE 10 BY 1.
     2539   DEFINE BUTTON b-chg
     2540        LABEL "&Изменить"
     2541        SIZE 10 BY 1.
     2542   DEFINE BUTTON b-del
     2543        LABEL "У&далить"
     2544        SIZE 10 BY 1.
     2545   DEFINE BUTTON b-help
     2546        LABEL "Помо&щь":L
     2547        SIZE 3 BY 1.
     2548   DEFINE BUTTON b-hist
     2549        LABEL "Ис&тория":L
     2550        SIZE 3 BY 1.
     2551   DEFINE BUTTON b-hn
     2552        LABEL "Ист+маршр"
     2553        SIZE 10 BY 1.
     2554   DEFINE BUTTON b-lkp
     2555        LABEL "&Просмотр"
     2556        SIZE 10 BY 1.
     2557   DEFINE BUTTON b-print
     2558        LABEL "Печать"
     2559        SIZE 3 BY 1.
     2560   DEFINE BUTTON b-param
     2561        LABEL "Парамет&ры"
     2562        SIZE 10 BY 1.
     2563   DEFINE BUTTON b-quit AUTO-END-KEY
     2564        LABEL "&Выход ":L
     2565        SIZE 10 BY 1.
     2566   DEFINE BUTTON b-sel AUTO-GO
     2567        LABEL "Вы&бор ":L
     2568        SIZE 10 BY 1.
     2569   DEFINE BUTTON b-send
     2570        LABEL "&Остатки"
     2571        SIZE 10 BY 1.
     2572   DEFINE BUTTON b-turn-off
     2573        LABEL "От&ключить"
     2574        SIZE 10 BY 1.
     2575   DEFINE BUTTON b-unld
     2576        LABEL "Вы&грузка"
     2577        SIZE 10 BY 1.
     2578   DEFINE BUTTON b-unld-list
     2579        LABEL "&Мультивыгрузка"
     2580        SIZE 15 BY 1
     2581        tooltip "Выгрузка УБД по списку из онлайн-копии" .
     2582   define button b-mark
     2583     label "&*"
     2584     size 3 by 1.13.
     2585   define button b-sel-all
     2586     label "&+":L
     2587     size 3 by 1.13 tooltip "Отметить все БД".
     2588   define button b-unmark
     2589     label "&-":L
     2590     size 3 by 1.13 tooltip "Снять все отметки".
     2591   DEFINE QUERY br-clients FOR
     2592         ub.clients SCROLLING.
     2593   DEFINE QUERY br-db FOR
     2594         ub.db SCROLLING.
     2595   DEFINE BROWSE br-clients
     2596     QUERY br-clients NO-LOCK DISPLAY
     2597         clients.obj-type FORMAT "X(3)":U
     2598         clients.obj-code FORMAT ">>>>>>>>9":U
     2599         clients.obj-name COLUMN-LABEL "Название" FORMAT "X(40)":U
     2600       WITH SEPARATORS SIZE 35.13 BY 16.5
     2601            TITLE "Объекты БД".
     2602   DEFINE BROWSE br-db
     2603     QUERY br-db NO-LOCK DISPLAY
     2604         get-mark(BUFFER ub.db) column-label "*"  format "X(1)":U
     2605         ub.db.db-num FORMAT ">>>>>>>>9":U
     2606         ub.db.db-name FORMAT "X(25)":U
     2607         ub.db.add-clients COLUMN-LABEL "Клиенты" FORMAT "+/-":U
     2608         ub.db.add-goods COLUMN-LABEL "Товары" FORMAT "+/-":U
     2609         ub.db.remote-stock COLUMN-LABEL "Чужие" FORMAT "+/-":U
     2610         ub.db.send-check COLUMN-LABEL "Чеки" FORMAT "+/-":U
     2611         ub.db.on-line-rest COLUMN-LABEL "Мгнов" FORMAT "+/-":U
     2612         ub.db.max-p-queue COLUMN-LABEL "Неподтв" FORMAT "->>>9":U
     2613         ub.db.max-p-time FORMAT ">>>>>9":U
     2614         ub.db.max-p-size FORMAT ">>>,>>9":U
     2615         ub.db.db-key FORMAT "X(12)":U
     2616         ub.db.reserve1-char COLUMN-LABEL "БД вер." FORMAT "X(12)":U
     2617         ub.db.stts FORMAT "->>>>>>9":U
     2618         get-infodb-date( ub.db.db-num) COLUMN-LABEL "Дата!актуальности!инф. о БД" FORMAT "99/99/9999":U
     2619         get-infodb-ver ( ub.db.db-num) COLUMN-LABEL "Версия r кодов." FORMAT "X(30)":U
     2620       WITH SEPARATORS SIZE 62 BY 16.5
     2621            TITLE "Базы данных".
     2622   DEFINE FRAME d-db
     2623        b-quit AT ROW 1 COL 1
     2624        b-sel AT ROW 1 COL 11
     2625        b-lkp AT ROW 1 COL 21
     2626        b-chg AT ROW 1 COL 31
     2627        b-add AT ROW 1 COL 41
     2628        b-unld AT ROW 1 COL 51
     2629        b-del AT ROW 1 COL 61
     2630        b-unld-list AT ROW 1 COL 71
     2631        b-print AT ROW 1 COL 88.88 WIDGET-ID 62
     2632        b-hist AT ROW 1 COL 92 WIDGET-ID 10
     2633        b-help AT ROW 1 COL 95
     2634        b-mark AT ROW 2 COL 1
     2635        b-sel-all AT ROW 2 COL 4
     2636        b-unmark AT ROW 2 COL 7
     2637        b-attr AT ROW 2 COL 21
     2638        b-param AT ROW 2 COL 31 WIDGET-ID 4
     2639        b-send AT ROW 2 COL 41
     2640        b-hn AT ROW 2 COL 51
     2641        b-turn-off AT ROW 2 COL 61 WIDGET-ID 2
     2642        br-db AT ROW 3.5 COL 1
     2643        br-clients AT ROW 3.5 COL 63.5
     2644        SPACE(0.36) SKIP(0.26)
     2645       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2646            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2647            TITLE "Базы данных":L.
     2648   ASSIGN
     2649          FRAME d-db:SCROLLABLE       = FALSE.
     2650   ASSIGN
     2651          b-hn:POPUP-MENU IN FRAME d-db       = MENU MENU-b-hn:HANDLE.
     2652   ASSIGN
     2653          b-param:POPUP-MENU IN FRAME d-db       = MENU MENU-b-param:HANDLE.
     2654   ASSIGN
     2655          b-print:POPUP-MENU IN FRAME d-db       = MENU POPUP-MENU-b-print:HANDLE.
     2656   ASSIGN b-print :MENU-MOUSE = 1.
     2657   ASSIGN
     2658          b-turn-off:HIDDEN IN FRAME d-db           = TRUE.
     2659   ASSIGN
     2660          b-unld:POPUP-MENU IN FRAME d-db       = MENU POPUP-MENU-b-unld:HANDLE.
     2661   ASSIGN
     2662          br-db:NUM-LOCKED-COLUMNS IN FRAME d-db     = 1.
     2663   ON CHOOSE OF b-add IN FRAME d-db
     2664   DO:
     2665     define variable v-unload-history as logical no-undo .
     2666     define buffer buf-new_db for ub.db .
     2667     assign
     2668       rid = ?
     2669     .
     2670     run adm/dbi.w ( input "add"
     2671                ,input-output rid
     2672                ,output v-unload-history
     2673               ) no-error .
     2674     if error-status :error
     2675     or rid = ?
     2676     then do:
     2677       return no-apply.
     2678     end.
     2679     OPEN QUERY br-db FOR EACH ub.db NO-LOCK.
     2680     reposition br-db to recid rid.
     2681     apply "ENTRY" to br-db.
     2682     apply "VALUE-CHANGED":U to br-db.
     2683   END.
     2684   ON CHOOSE OF b-attr IN FRAME d-db
     2685   DO:
     2686    IF NOT AVAILABLE ub.db THEN RETURN NO-APPLY.
     2687     run adm/db-atti.w ( INPUT parparentproc
     2688                        ,INPUT 'ПРОСМОТР':U
     2689                        ,INPUT ub.db.db-num ) NO-ERROR.
     2690     IF ERROR-STATUS:error THEN RETURN NO-APPLY.
     2691   END.
     2692   ON CHOOSE OF b-chg IN FRAME d-db
     2693   DO:
     2694   define variable v-unload-history as logical no-undo .
     2695     if not available ub.db
     2696     then do:
     2697       message
     2698         "Неправильно выбрана строка."
     2699         view-as alert-box .
     2700       return no-apply.
     2701     end.
     2702     rid = recid (db).
     2703     run adm/dbi.w ( input "upd"
     2704                ,input-output rid
     2705                ,output v-unload-history
     2706               ) no-error .
     2707     assign     log-res = browse br-db :set-repositioned-row( browse br-db :focused-row, 'CONDITIONAL':u)     v-rowid = rowid( ub.db )   .   OPEN QUERY br-db FOR EACH ub.db NO-LOCK.   reposition br-db to rowid v-rowid no-error.   apply "ENTRY":U to br-db.   apply "VALUE-CHANGED":U to br-db.
     2708   END.
     2709   ON CHOOSE OF b-del IN FRAME d-db
     2710   DO:
     2711     define buffer buf_db for ub.db .
     2712     define variable v-log as logical no-undo .
     2713     if not available ub.db
     2714     then do:
     2715       message
     2716         "Не выбрана БД для удаления."
     2717         view-as alert-box .
     2718       return no-apply.
     2719     end.
     2720     find first buf_db exclusive-lock
     2721       where buf_db.db-num = ub.db.db-num
     2722       no-error
     2723     .
     2724     if not available buf_db
     2725     then do:
     2726       message
     2727         substitute( "БД &1 уже удалена.", ub.db.db-num ) skip
     2728         view-as alert-box information
     2729       .
     2730     end.
     2731     else do:
     2732       if buf_db.db-num = 0
     2733       then do:
     2734         message
     2735           "Нельзя удалить ГБД !!!"
     2736           view-as alert-box error.
     2737         return no-apply.
     2738       end.
     2739       assign
     2740         v-log = false
     2741       .
     2742       message
     2743         substitute( "Вы действительно хотите удалить БД &1?",  buf_db.db-num )
     2744         view-as alert-box question buttons yes-no update v-log.
     2745       if v-log = false
     2746       then do:
     2747         return no-apply.
     2748       end.
     2749       delete buf_db no-error.
     2750       if error-status :error
     2751       then do:
     2752         message
     2753           vss-workfile vss-revision vss-description skip
     2754           substitute( "Ошибка при удалении БД" ) skip
     2755           error-status :get-message ( error-status :num-messages )
     2756           view-as alert-box error
     2757         .
     2758         return no-apply .
     2759       end.
     2760     end.
     2761     assign     log-res = browse br-db :set-repositioned-row( browse br-db :focused-row, 'CONDITIONAL':u)     v-rowid = rowid( ub.db )   .   OPEN QUERY br-db FOR EACH ub.db NO-LOCK.   reposition br-db to rowid v-rowid no-error.   apply "ENTRY":U to br-db.   apply "VALUE-CHANGED":U to br-db.
     2762   END.
     2763   ON CHOOSE OF b-hist IN FRAME d-db
     2764   DO:
     2765      if available ub.db then do:
     2766       run adm/db-hist.w
     2767         ( input parparentproc
     2768         , input ub.db.db-num
     2769         ).
     2770      end.
     2771     apply "entry" to browse br-clients.
     2772   END.
     2773   ON CHOOSE OF b-hn IN FRAME d-db
     2774   DO:
     2775    IF hn-option = '':U THEN DO:
     2776       run gbl/pop-up.p ( INPUT self:handle, INPUT no) NO-ERROR.
     2777     END.
     2778     IF hn-option = '':U THEN RETURN NO-APPLY.
     2779     RUN proc-hn IN THIS-PROCEDURE ( INPUT hn-option).
     2780   END.
     2781   ON CHOOSE OF b-lkp IN FRAME d-db
     2782   DO:
     2783   define variable v-unload-history as logical no-undo .
     2784     define buffer buf_db for ub.db .
     2785     if not available ub.db
     2786     then do:
     2787       message
     2788         "Неправильно выбрана строка."
     2789         view-as alert-box .
     2790       return no-apply.
     2791     end.
     2792     rid = recid (db).
     2793     run adm/dbi.w
     2794       ( input "lkp"
     2795       , input-output rid
     2796       , output v-unload-history
     2797       ) no-error .
     2798     assign     log-res = browse br-db :set-repositioned-row( browse br-db :focused-row, 'CONDITIONAL':u)     v-rowid = rowid( ub.db )   .   OPEN QUERY br-db FOR EACH ub.db NO-LOCK.   reposition br-db to rowid v-rowid no-error.   apply "ENTRY":U to br-db.   apply "VALUE-CHANGED":U to br-db.
     2799   END.
     2800   ON choose OF b-mark IN FRAME d-db
     2801   do:
     2802       run proc-b-mark in this-procedure no-error.
     2803     end.
     2804   ON CHOOSE OF b-print IN FRAME d-db
     2805   DO:
     2806         run gbl/pop-up.p (self:handle, no) no-error.
     2807   END.
     2808   ON CHOOSE OF b-quit IN FRAME d-db
     2809   DO:
     2810     assign
     2811       rid = ?.
     2812     .
     2813   END.
     2814   ON CHOOSE OF b-param IN FRAME d-db
     2815   DO:
     2816   define variable v-param as character no-undo .
     2817   define variable v-db-num like ub.db.db-num no-undo .
     2818   if not available ub.db then return no-apply.
     2819   if attr-option = '':U then do:
     2820      run gbl/pop-up.p ( input self:handle, input no) no-error.
     2821   end.
     2822   if attr-option = '':U then return no-apply.
     2823   if attr-option = 'ИЗМЕНЕНИЕ':U
     2824   or attr-option = 'КОПИРОВАНИЕ':U
     2825   then do:
     2826     if buf_sys-ctrl.db-num <> 0
     2827     then do:
     2828       if ub.db.db-num <> buf_sys-ctrl.db-num then do:
     2829         message
     2830         "Нельзя менять параметры в чужой БД"
     2831         view-as alert-box error .
     2832         return no-apply.
     2833       end.
     2834     end.
     2835   end.
     2836   run proc-b-attrdb in this-procedure (
     2837                                       input attr-option
     2838                                      ,input 'БД':U
     2839                                      ,input ub.db.db-num) no-error .
     2840   if error-status:error then do:
     2841     assign
     2842     attr-option = "":u.
     2843     return no-apply.
     2844   end.
     2845   attr-option = "":u.
     2846   END.
     2847   ON CHOOSE OF b-sel IN FRAME d-db
     2848   DO:
     2849     define buffer buf_db for ub.db .
     2850     find first buf_db no-lock
     2851       where buf_db.db-num = ub.db.db-num
     2852       no-error
     2853     .
     2854     if available buf_db
     2855     then do:
     2856       assign
     2857         rid = recid (db).
     2858       .
     2859     end.
     2860     else do:
     2861       message
     2862         substitute( "БД &1 удалена", ub.db.db-num )
     2863         view-as alert-box information
     2864       .
     2865       assign     log-res = browse br-db :set-repositioned-row( browse br-db :focused-row, 'CONDITIONAL':u)     v-rowid = rowid( ub.db )   .   OPEN QUERY br-db FOR EACH ub.db NO-LOCK.   reposition br-db to rowid v-rowid no-error.   apply "ENTRY":U to br-db.   apply "VALUE-CHANGED":U to br-db.
     2866       return no-apply.
     2867     end.
     2868   END.
     2869   ON choose OF b-sel-all IN FRAME d-db
     2870   do:
     2871       assign
     2872         select-list = "".
     2873       if not available ub.db then return.
     2874       for each ub.db no-lock :
     2875   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2876   define variable v-str-recid13 as character no-undo .
     2877   define variable v-num-entry13 as integer   no-undo .
     2878   assign
     2879     v-str-recid13 = trim( string( recid( ub.db ) , "->>>>>>>>>>>9":U ) )
     2880     v-num-entry13 = lookup( v-str-recid13 , select-list )
     2881   .
     2882   if v-num-entry13 > 0 then do:
     2883     assign
     2884       entry( v-num-entry13, select-list ) = "":U
     2885       select-list = trim( replace( select-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     2886     .
     2887   end.
     2888   else do:
     2889     assign
     2890       select-list = select-list + ( if select-list = "":U then "":U else chr(44) ) + v-str-recid13
     2891     .
     2892   end.
     2893       end.
     2894       br-db:refresh() in frame d-db .
     2895     end.
     2896   ON CHOOSE OF b-send IN FRAME d-db
     2897   DO:
     2898     if not available ub.db
     2899     then do:
     2900       message
     2901         "Неправильно выбрана строка."
     2902         view-as alert-box .
     2903       return no-apply.
     2904     end.
     2905     run trg/sendrest.p
     2906       (input ub.db.db-num
     2907       ) no-error .
     2908     assign     log-res = browse br-db :set-repositioned-row( browse br-db :focused-row, 'CONDITIONAL':u)     v-rowid = rowid( ub.db )   .   OPEN QUERY br-db FOR EACH ub.db NO-LOCK.   reposition br-db to rowid v-rowid no-error.   apply "ENTRY":U to br-db.   apply "VALUE-CHANGED":U to br-db.
     2909   END.
     2910   ON CHOOSE OF b-turn-off IN FRAME d-db
     2911   DO:
     2912     define buffer buf_db for ub.db .
     2913     define buffer buf_pck-sent for ub.pck-sent .
     2914     define buffer buf_pck-rcvd for ub.pck-rcvd .
     2915     define buffer buf_route for ub.route .
     2916     define variable v-log as logical no-undo .
     2917     if not available ub.db then do:
     2918       message
     2919         "Не выбрана БД."
     2920         view-as alert-box .
     2921       return no-apply.
     2922     end.
     2923     if ub.db.db-num = 0 then do:
     2924       message
     2925         "Нельзя отключить СПН для ГБД."
     2926         view-as alert-box.
     2927       return no-apply.
     2928     end.
     2929     if transaction then do:
     2930       message
     2931         vss-workfile vss-revision vss-description skip
     2932         "Действует транзакция!" skip
     2933         "Выполнение действия недопустимо!" skip
     2934         view-as alert-box error.
     2935       undo, return no-apply .
     2936     end.
     2937     assign
     2938       v-log = false
     2939     .
     2940     if db.db-key = "":U
     2941       or db.db-key = ?
     2942     then do:
     2943       message
     2944         substitute( "СПН для БД &1 уже отключена!",  db.db-num )
     2945         substitute( "Вы хотите удалить записи маршрутизации для БД &1?",  db.db-num )
     2946           view-as alert-box question buttons yes-no update v-log.
     2947       if v-log = false then do:
     2948         return no-apply.
     2949       end.
     2950     end.
     2951     else do:
     2952       message
     2953         substitute( "Восстановить обмен пакетами с УБД можно будет только ВЫГРУЗИВ ее!!!" ) skip
     2954         substitute( "Вы действительно хотите отключить СПН для БД &1?",  db.db-num )
     2955           view-as alert-box question buttons yes-no update v-log.
     2956       if v-log = false then do:
     2957         return no-apply.
     2958       end.
     2959       assign
     2960         v-log = false
     2961       .
     2962       run gbl/authoriz.p
     2963         (input "Run information dialog"
     2964         ,output v-log
     2965         ).
     2966     end.
     2967     if v-log = true then do:
     2968       do transaction
     2969       on error  undo, return no-apply
     2970       on stop   undo, return no-apply
     2971       on endkey undo, return no-apply
     2972       :
     2973         find first buf_db exclusive-lock
     2974           where buf_db.db-num = db.db-num
     2975           no-error
     2976         .
     2977         if not available buf_db then do:
     2978           message
     2979             substitute( "БД &1 удалена.", db.db-num ) skip
     2980             view-as alert-box information
     2981           .
     2982           return no-apply .
     2983         end.
     2984         assign
     2985           buf_db.db-key     = "":U
     2986           buf_db.db-key-enc = "":U
     2987         .
     2988       end.
     2989       view frame f-info.
     2990       assign
     2991         v-ind = 0
     2992       .
     2993       for each buf_pck-sent
     2994         where buf_pck-sent.db-num = db.db-num
     2995           and buf_pck-sent.rcvd   = false
     2996       on error  undo, return no-apply
     2997       on stop   undo, return no-apply
     2998       on endkey undo, return no-apply
     2999       :
     3000         assign
     3001           buf_pck-sent.rcvd = true
     3002           v-ind = v-ind + 1
     3003         .
     3004         do with frame f-info
     3005         :
     3006           assign
     3007             v-ind :screen-value   = string( v-ind, v-ind :format)
     3008             v-str :screen-value   = string( "Подтверждение отправленных пакетов", v-str :format)
     3009           .
     3010         end.
     3011       end.
     3012       assign
     3013         v-ind = 0
     3014       .
     3015       for each buf_pck-rcvd
     3016         where buf_pck-rcvd.db-num = db.db-num
     3017           and buf_pck-rcvd.rcvd   = false
     3018       on error  undo, return no-apply
     3019       on stop   undo, return no-apply
     3020       on endkey undo, return no-apply
     3021       :
     3022         assign
     3023           buf_pck-rcvd.rcvd = true
     3024           v-ind = v-ind + 1
     3025         .
     3026         do with frame f-info
     3027         :
     3028           assign
     3029             v-ind :screen-value   = string( v-ind, v-ind :format)
     3030             v-str :screen-value   = string( "Подтверждение полученных пакетов", v-str :format)
     3031           .
     3032         end.
     3033       end.
     3034       assign
     3035         v-ind = 0
     3036       .
     3037       for each buf_route
     3038         where buf_route.db-num = db.db-num
     3039       on error  undo, return no-apply
     3040       on stop   undo, return no-apply
     3041       on endkey undo, return no-apply
     3042       :
     3043         delete buf_route .
     3044         assign
     3045           v-ind = v-ind + 1
     3046         .
     3047         do with frame f-info
     3048         :
     3049           assign
     3050             v-ind :screen-value   = string( v-ind, v-ind :format)
     3051             v-str :screen-value   = string( "Удаление маршрутизации", v-str :format)
     3052           .
     3053         end.
     3054       end.
     3055       hide frame f-info.
     3056       message
     3057         substitute( "СПН для БД &1 отключена.", ub.db.db-num )
     3058         view-as alert-box information.
     3059     end.
     3060     assign     log-res = browse br-db :set-repositioned-row( browse br-db :focused-row, 'CONDITIONAL':u)     v-rowid = rowid( ub.db )   .   OPEN QUERY br-db FOR EACH ub.db NO-LOCK.   reposition br-db to rowid v-rowid no-error.   apply "ENTRY":U to br-db.   apply "VALUE-CHANGED":U to br-db.
     3061   END.
     3062   ON CHOOSE OF b-unld IN FRAME d-db
     3063   DO:
     3064     define buffer buf-new_db      for ub.db .
     3065     define buffer buf-chk_db      for ub.db .
     3066     define buffer buf_clients     for ub.clients .
     3067     define variable v-log  as logical   no-undo .
     3068     define variable v-lock as logical   no-undo .
     3069     define variable v-msg  as character no-undo .
     3070     define variable v-ok   as logical   no-undo .
     3071     if  v-type-unload = "":U
     3072     and buf_sys-ctrl.status_ = 'copy-DB':U
     3073     then do:
     3074       assign
     3075         v-type-unload = 'unload-copy':U
     3076       .
     3077     end.
     3078     case v-type-unload :
     3079       when 'unload-online':U or
     3080       when 'unload-copy':U
     3081       then do:
     3082         if not available ub.db
     3083         then do:
     3084           message
     3085             "Не выбрана БД для выгрузки."
     3086             view-as alert-box .
     3087           return no-apply.
     3088         end.
     3089         assign
     3090           rid = recid (db)
     3091         .
     3092         if db.db-num = 0
     3093         then do:
     3094           message
     3095             "Нельзя выгрузить ГБД!!!"
     3096             view-as alert-box error.
     3097           return no-apply.
     3098         end.
     3099         define variable v-can-unload as logical   no-undo .
     3100         define variable v-message    as character no-undo .
     3101         run adm/unlddbck.p
     3102           (input  db.db-num
     3103           ,output v-can-unload
     3104           ,output v-message
     3105           ) .
     3106         if v-can-unload <> true
     3107         then do:
     3108           message
     3109             "Нельзя произвести выгрузку базы данных" skip
     3110             "База данных" db.db-num skip
     3111             v-message skip
     3112             view-as alert-box error.
     3113         end.
     3114         else do:
     3115           if v-type-unload = 'unload-copy':U
     3116           and ( db.db-key = "":U
     3117                 or db.db-key = ?
     3118               )
     3119           then do:
     3120             message
     3121               "Из копии нельзя выгрузить БД не имеющую ключа!!!"
     3122               view-as alert-box error.
     3123           end.
     3124           else do:
     3125             run fill-two-commit-command in this-procedure.
     3126             find first temp_db-rec-attr
     3127               where temp_db-rec-attr.db-num = ?
     3128               no-error .
     3129             if available temp_db-rec-attr
     3130             then do:
     3131               message
     3132                 vss-workfile vss-revision vss-description skip
     3133                 substitute( "Нельзя выгрузить БД!" ) skip
     3134                 substitute( "Есть незавершенные распределенные команды при которых выгрузка недопустима!" ) skip
     3135                 view-as alert-box error
     3136               .
     3137             end.
     3138             else do:
     3139               assign
     3140                 v-log = FALSE
     3141               .
     3142               message
     3143                 "При выгрузке необходимо задать НОВЫЙ ключ БД." skip
     3144                 "Продолжить?"
     3145                 view-as alert-box question buttons yes-no update v-log
     3146               .
     3147               if not v-log
     3148               then do:
     3149                 return no-apply.
     3150               end.
     3151               run adm/unload-m.p
     3152                 (input  db.db-num
     3153                 ) no-error.
     3154               run adm/unloaddc.p
     3155                 no-error .
     3156               if error-status :error
     3157               then do:
     3158                 message
     3159                   vss-workfile vss-revision vss-description skip
     3160                   substitute( "Не удалось отключить БД" ) skip
     3161                   return-value skip
     3162                   error-status :get-message ( error-status :num-messages )
     3163                   view-as alert-box error .
     3164               end.
     3165               assign
     3166                 v-lock = true
     3167               .
     3168   define variable vss-include-info14 as character format "X(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
     3169   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_lock-route in g#lib-nws
     3170     ( input  'unlock'
     3171     , input  ub.db.db-num
     3172     , input  0
     3173     , input  ''
     3174     , output v-msg
     3175     , output v-lock
     3176     , output v-ok
     3177     ) no-error .
     3178               if error-status :error
     3179               or v-lock = true
     3180               or v-ok   = false
     3181               then do:
     3182                 message
     3183                   vss-workfile vss-revision vss-description skip
     3184                   substitute( "&1", v-msg ) skip
     3185                   return-value skip
     3186                   error-status :get-message ( error-status :num-messages )
     3187                   view-as alert-box error
     3188                 .
     3189                 return no-apply.
     3190               end.
     3191             end.
     3192           end.
     3193         end.
     3194       end.
     3195       when 'prop-copy':U
     3196       then do:
     3197         assign
     3198           v-msg = "":U
     3199         .
     3200         for each buf-chk_db
     3201         on error undo, return no-apply
     3202         :
     3203           if buf-chk_db.db-key = "":U
     3204           or buf-chk_db.db-key = ?
     3205           then do:
     3206             assign
     3207               v-msg = v-msg + " ":U + string( buf-chk_db.db-num )
     3208             .
     3209           end.
     3210         end.
     3211         if v-msg <> "":U
     3212         then do:
     3213           message
     3214             substitute( "Из копии нельзя будет выгрузить БД &1", v-msg ) skip
     3215             substitute( "Продолжить подготовку копии?" ) skip
     3216             view-as alert-box question buttons yes-no update v-ok .
     3217           if v-ok <> true
     3218           then do:
     3219             return no-apply.
     3220           end.
     3221         end.
     3222         run adm/copyprep.w
     3223           ( input parparentproc
     3224           , output v-log
     3225           ) no-error.
     3226         if error-status :error
     3227         then do:
     3228           message
     3229             vss-workfile vss-revision vss-description skip
     3230             substitute( "Ошибка при подготовке копии ГБД!" ) skip
     3231             return-value skip
     3232             error-status :get-message ( error-status :num-messages )
     3233             view-as alert-box error
     3234           .
     3235           return no-apply .
     3236         end.
     3237         if v-log = true
     3238         then do:
     3239           message
     3240             substitute( "Копия ГБД подготовлена!" )
     3241             view-as alert-box information
     3242           .
     3243         end.
     3244         else do:
     3245           message
     3246             substitute( "Копия ГБД НЕ ПОДГОТОВЛЕНА!" ) skip
     3247             return-value skip
     3248             view-as alert-box error
     3249           .
     3250           return no-apply .
     3251         end.
     3252       end.
     3253       otherwise do:
     3254         message
     3255           vss-workfile vss-revision vss-description skip
     3256           substitute( 'Нет обработки "&1"', v-type-unload ) skip
     3257           view-as alert-box error
     3258         .
     3259         return no-apply .
     3260       end.
     3261     end case.
     3262     assign     log-res = browse br-db :set-repositioned-row( browse br-db :focused-row, 'CONDITIONAL':u)     v-rowid = rowid( ub.db )   .   OPEN QUERY br-db FOR EACH ub.db NO-LOCK.   reposition br-db to rowid v-rowid no-error.   apply "ENTRY":U to br-db.   apply "VALUE-CHANGED":U to br-db.
     3263   END.
     3264   ON CHOOSE OF b-unld-list IN FRAME d-db
     3265   DO:
     3266     define buffer buf-new_db      for ub.db .
     3267     define buffer buf-lst_db      for ub.db .
     3268     define buffer buf_clients     for ub.clients .
     3269     define variable v-log  as logical   no-undo .
     3270     define variable v-lock as logical   no-undo .
     3271     define variable v-msg  as character no-undo .
     3272     define variable v-ok   as logical   no-undo .
     3273     define variable v-ii   as integer   no-undo .
     3274     define variable v-list as character no-undo .
     3275     if trim(select-list) = ""
     3276     then do :
     3277       message "Не отмечена ни одна БД." view-as alert-box .
     3278       return no-apply .
     3279     end.
     3280     assign
     3281       v-type-unload = 'unload-online':U
     3282     .
     3283     run fill-two-commit-command in this-procedure.
     3284     do v-ii = 1 to num-entries (select-list):
     3285       v-list = entry(v-ii, select-list) no-error .
     3286       find first buf-lst_db where recid(buf-lst_db) = integer(v-list) .
     3287       if buf-lst_db.db-num = 0
     3288       then do:
     3289         message
     3290           "Нельзя выгрузить ГБД!!!"
     3291           view-as alert-box error.
     3292         return no-apply.
     3293       end.
     3294       define variable v-can-unload as logical   no-undo .
     3295       define variable v-message    as character no-undo .
     3296       run adm/unlddbck.p
     3297         (input  buf-lst_db.db-num
     3298         ,output v-can-unload
     3299         ,output v-message
     3300         ) .
     3301       if v-can-unload <> true
     3302       then do:
     3303         message
     3304           "Нельзя произвести выгрузку базы данных" skip
     3305           "База данных" db.db-num skip
     3306           v-message skip
     3307           view-as alert-box error.
     3308       end.
     3309       find first temp_db-rec-attr
     3310         where temp_db-rec-attr.db-num = ?
     3311         no-error .
     3312       if available temp_db-rec-attr
     3313       then do:
     3314         message
     3315           vss-workfile vss-revision vss-description skip
     3316           substitute( "Нельзя выгрузить БД!" ) skip
     3317           substitute( "Есть незавершенные распределенные команды при которых выгрузка недопустима!" ) skip
     3318           view-as alert-box error
     3319         .
     3320       end.
     3321     end .
     3322     assign
     3323       v-log = FALSE
     3324     .
     3325     message
     3326       "При выгрузке необходимо задать НОВЫЙ ключ БД." skip
     3327       "Продолжить?"
     3328       view-as alert-box question buttons yes-no update v-log
     3329     .
     3330     if not v-log
     3331     then do:
     3332       return no-apply.
     3333     end.
