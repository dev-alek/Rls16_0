     3486   ON WINDOW-CLOSE OF FRAME d-db APPLY "END-ERROR":U TO SELF.
     3487   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3488   on help of frame d-db
     3489   do:
     3490     run gbl/app_help.p
     3491       (input this-procedure :file-name
     3492       ,input ''
     3493       ,input ?
     3494       ) no-error.
     3495     if error-status :error then do:
     3496       message
     3497         "Ошибка при вызове помощи"
     3498         error-status :get-message(1)
     3499         view-as alert-box .
     3500     end.
     3501   end.
     3502   run minbtn-set in this-procedure .
     3503   on choose of b-help in frame d-db
     3504   do:
     3505     apply "help":u to frame d-db .
     3506   end.
     3507   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3508   procedure minbtn-set :
     3509       do
     3510           on error undo, return error return-value
     3511           :
     3512           define variable ii              as integer       no-undo .
     3513           define variable fh              as widget-handle no-undo .
     3514           define variable hh              as widget-handle no-undo .
     3515           define variable v-h             as handle        extent 4 no-undo .
     3516           define variable v-name-button   as character     no-undo .
     3517           define variable v-help-old-x    as decimal       no-undo .
     3518           define variable v-help-old-y    as decimal       no-undo .
     3519           define variable v-help-old-size as decimal       no-undo .
     3520           define variable v-frame-width   as decimal       no-undo .
     3521           define variable jj              as integer       no-undo .
     3522           do
     3523               on error undo, return error
     3524               :
     3525               assign
     3526                   v-frame-width = frame d-db:width - 0.3
     3527                   fh            = frame d-db:first-child
     3528                   hh            = fh:first-child
     3529                   ii            = 1
     3530                   .
     3531               do while valid-handle(hh):
     3532                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     3533                   do:
     3534                       case lc(hh:name) :
     3535                           when "b-help" then
     3536                               do:
     3537                                   hh:load-image-up("cmp/b-help.bmp":u) .
     3538                                   hh:load-image-down("cmp/b-help.bmp":u) .
     3539                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     3540                                   hh:TOOLTIP = "Помощь" .
     3541                                   v-help-old-x = hh:column .
     3542                                   v-help-old-y = hh:row    .
     3543                                   v-help-old-size = hh:width .
     3544                                   hh:width-chars = 2.5 .
     3545                               end.
     3546                           when "b-print" then
     3547                               do:
     3548                                   hh:load-image("cmp/b-print.bmp":u) .
     3549                                   hh:TOOLTIP = "Печать" .
     3550                                   v-h[ii] = hh:handle .
     3551                                   ii = ii + 1 .
     3552                                   hh:width-chars = 3 .
     3553                               end.
     3554                           when "b-history" or
     3555                           when "b-hist" then
     3556                               do:
     3557                                   hh:load-image("cmp/b-hist.bmp":u) .
     3558                                   hh:TOOLTIP = "История" .
     3559                                   v-h[ii] = hh:handle .
     3560                                   ii = ii + 1 .
     3561                                   hh:width-chars = 3 .
     3562                               end.
     3563                           when "b-sch" then
     3564                               do:
     3565                                   hh:load-image("cmp/b-sch.bmp":u) .
     3566                                   hh:TOOLTIP = "Установка Фильтра" .
     3567                                   v-h[ii] = hh:handle .
     3568                                   ii = ii + 1 .
     3569                                   hh:width-chars = 3 .
     3570                               end.
     3571                           when "b-hist-user" then
     3572                               do:
     3573                                   hh:load-image("cmp/b-hist.bmp":u) .
     3574                                   hh:TOOLTIP = "История пользователя" .
     3575                                   ii = ii + 1 .
     3576                               end.
     3577                       end case.
     3578                   end.
     3579                   hh = hh:next-sibling.
     3580               end.
     3581               b-help:column = v-frame-width - b-help:width-chars.
     3582               jj = 0.
     3583               repeat ii = 4 to 1 by -1 :
     3584                   if valid-handle (v-h[ii] ) then
     3585                   do:
     3586                       jj  = jj + 1 .
     3587                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3588                       v-h[ii]:row    = v-help-old-y .
     3589                   end.
     3590               end.
     3591           end.
     3592       end.
     3593   end procedure.
     3594   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     3595   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     3596   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     3597   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     3598   define variable v-diasize-current-frame-width  as decimal   no-undo .
     3599   define variable v-diasize-current-frame-height as decimal   no-undo .
     3600   define variable v-diasize-change-size          as logical   no-undo .
     3601   define variable v-diasize-resize-button        as handle    no-undo .
     3602   define variable v-diasize-wndmax               as logical   no-undo .
     3603   define variable v-diasize-wndstore             as logical   no-undo .
     3604   define variable v-diasize-proc-name            as character no-undo .
     3605   define variable v-diasize-browse-handle        as handle    no-undo .
     3606   define variable v-diasize-browse-number        as integer   no-undo .
     3607   define variable v-diasize-need-full-display    as logical   no-undo init false .
     3608   define temp-table temp-diasize-handle no-undo
     3609     field handle-value  as handle
     3610     field save-position as decimal
     3611     index xpk is primary unique handle-value
     3612     .
     3613   define temp-table temp-browse-handle no-undo
     3614     field browse-type   as character
     3615     field browse-number as integer
     3616     field browse-handle as handle
     3617     field original-size as decimal
     3618     index xpk is primary unique browse-type browse-number
     3619     index xie browse-type browse-handle
     3620   .
     3621   procedure diasize_change-height :
     3622     define input  parameter p-change-value  as decimal   no-undo .
     3623     define input  parameter p-move-resize   as logical   no-undo .
     3624     define variable v-field-group-handle    as handle    no-undo .
     3625     define variable v-object-handle         as handle    no-undo .
     3626     define variable v-frame-height          as decimal   no-undo .
     3627     define variable v-frame-virtual-height  as decimal   no-undo .
     3628     define variable v-browse-height         as decimal   no-undo .
     3629     define variable v-window-height         as decimal   no-undo .
     3630     define variable v-window-virtual-height as decimal   no-undo .
     3631     define variable v-change-sign           as integer   no-undo .
     3632     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3633     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3634     if p-change-value > 0
     3635     then do:
     3636       if frame d-db :height + p-change-value
     3637           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     3638       then do:
     3639         assign
     3640           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     3641                           - (frame d-db :height-chars)
     3642         .
     3643         if p-change-value <= 0
     3644         then do:
     3645           run diasize_position-resize-button in this-procedure .
     3646           return .
     3647         end.
     3648       end.
     3649     end.
     3650     if p-change-value < 0
     3651     then do:
     3652       if frame d-db :height + p-change-value < v-diasize-orig-frame-height
     3653       then do:
     3654         assign
     3655           p-change-value = v-diasize-orig-frame-height
     3656                          - (frame d-db :height-chars)
     3657         .
     3658         if p-change-value >= 0
     3659         then do:
     3660           run diasize_position-resize-button in this-procedure .
     3661           return .
     3662         end.
     3663       end.
     3664     end.
     3665     if p-change-value >= 0
     3666     then do:
     3667       assign
     3668         v-change-sign = 1
     3669       .
     3670     end.
     3671     else do:
     3672       assign
     3673         v-change-sign = -1
     3674       .
     3675     end.
     3676     assign
     3677       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3678     .
     3679     if p-change-value = 0
     3680     then do:
     3681       run diasize_position-resize-button in this-procedure .
     3682       return .
     3683     end.
     3684     move_block:
     3685     do
     3686     on error undo move_block, retry move_block
     3687     :
     3688       if retry
     3689       then do:
     3690         do
     3691         on error undo move_block, leave move_block
     3692         :
     3693           if p-change-value > 0
     3694           then do:
     3695             for each buf_temp-diasize-handle
     3696             on error undo, next
     3697             :
     3698               assign
     3699                 v-object-handle = buf_temp-diasize-handle.handle-value
     3700               .
     3701               if v-object-handle <> v-diasize-resize-button
     3702               then do:
     3703                 assign
     3704                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3705                 .
     3706               end.
     3707             end.
     3708             assign
     3709               v-diasize-browse-handle :height = v-browse-height
     3710             .
     3711             for each buf_temp-browse-handle
     3712               where buf_temp-browse-handle.browse-type = 'height':u
     3713             on error undo, next
     3714             :
     3715               assign
     3716                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3717               .
     3718             end.
     3719             assign
     3720               frame d-db :height = v-frame-height
     3721             .
     3722             if frame d-db :scrollable = true
     3723             then do:
     3724               assign
     3725                 frame d-db :virtual-height = v-frame-virtual-height
     3726               .
     3727             end.
     3728             run diasize_position-resize-button in this-procedure .
     3729           end.
     3730           else do:
     3731             if frame d-db :scrollable = true
     3732             then do:
     3733               assign
     3734                 frame d-db :virtual-height = v-frame-virtual-height
     3735               .
     3736             end.
     3737             assign
     3738               frame d-db :height = v-frame-height
     3739             .
     3740             assign
     3741               v-diasize-browse-handle :height = v-browse-height
     3742             .
     3743             for each buf_temp-browse-handle
     3744               where buf_temp-browse-handle.browse-type = 'height':u
     3745             on error undo, next
     3746             :
     3747               assign
     3748                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3749               .
     3750             end.
     3751             for each buf_temp-diasize-handle
     3752             on error undo, next
     3753             :
     3754               assign
     3755                 v-object-handle = buf_temp-diasize-handle.handle-value
     3756               .
     3757               if v-object-handle <> v-diasize-resize-button
     3758               then do:
     3759                 assign
     3760                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3761                 .
     3762               end.
     3763             end.
     3764             run diasize_position-resize-button in this-procedure .
     3765           end.
     3766           assign
     3767             v-diasize-change-size = false
     3768           .
     3769           leave move_block .
     3770         end.
     3771       end.
     3772       assign
     3773         v-diasize-need-full-display = true
     3774       .
     3775       if v-diasize-change-size = false
     3776       then do:
     3777         assign
     3778           v-diasize-change-size = true
     3779         .
     3780       end.
     3781       else do:
     3782         return .
     3783       end.
     3784       assign
     3785         v-frame-height = frame d-db :height
     3786         v-frame-virtual-height = frame d-db :virtual-height
     3787         v-browse-height = v-diasize-browse-handle :height
     3788       .
     3789       for each buf_temp-browse-handle
     3790         where buf_temp-browse-handle.browse-type = 'height':u
     3791       :
     3792         assign
     3793           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3794         .
     3795       end.
     3796       for each buf_temp-diasize-handle
     3797       :
     3798         delete buf_temp-diasize-handle .
     3799       end.
     3800       assign
     3801         v-field-group-handle = frame d-db :first-child
     3802       .
     3803       do while valid-handle(v-field-group-handle)
     3804       :
     3805         assign
     3806           v-object-handle = v-field-group-handle :first-child
     3807         .
     3808         do while valid-handle(v-object-handle)
     3809         :
     3810           if  v-object-handle <> v-diasize-browse-handle :handle
     3811           and can-query(v-object-handle, "row")
     3812           and can-query(v-object-handle, "height")
     3813           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3814           then do:
     3815             find first buf_temp-browse-handle
     3816               where buf_temp-browse-handle.browse-type   = 'height':u
     3817                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3818               no-error .
     3819             if available buf_temp-browse-handle
     3820             then do:
     3821             end.
     3822             else do:
     3823               create buf_temp-diasize-handle .
     3824               assign
     3825                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3826                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3827               .
     3828             end.
     3829           end.
     3830           assign
     3831             v-object-handle = v-object-handle :next-sibling
     3832           .
     3833         end.
     3834         assign
     3835           v-field-group-handle = v-field-group-handle :next-sibling
     3836         .
     3837       end.
     3838       do with frame d-db
     3839       :
     3840         hide v-diasize-resize-button .
     3841         assign
     3842           v-diasize-resize-button :row    = 1
     3843           v-diasize-resize-button :column = 1
     3844         .
     3845       end.
     3846       if p-change-value > 0
     3847       then do:
     3848         if frame d-db :scrollable = true
     3849         then do:
     3850           assign
     3851             frame d-db :virtual-height = frame d-db :virtual-height + p-change-value
     3852             no-error .
     3853           if error-status :error
     3854           or error-status :get-message(1) <> ""
     3855           then do:
     3856             undo move_block, retry move_block .
     3857           end.
     3858         end.
     3859         assign
     3860           frame d-db :height = frame d-db :height + p-change-value
     3861           no-error .
     3862         if error-status :error
     3863         or error-status :get-message(1) <> ""
     3864         then do:
     3865           undo move_block, retry move_block .
     3866         end.
     3867         assign
     3868           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3869           no-error .
     3870         if error-status :error
     3871         or error-status :get-message(1) <> ""
     3872         then do:
     3873           undo move_block, retry move_block .
     3874         end.
     3875         for each buf_temp-browse-handle
     3876           where buf_temp-browse-handle.browse-type = 'height':u
     3877         on error undo move_block, retry move_block
     3878         :
     3879           assign
     3880             buf_temp-browse-handle.browse-handle :height
     3881               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3882             no-error .
     3883           if error-status :error
     3884           or error-status :get-message(1) <> ""
     3885           then do:
     3886             undo move_block, retry move_block .
     3887           end.
     3888         end.
     3889         for each buf_temp-diasize-handle
     3890         on error undo move_block, retry move_block
     3891         :
     3892           assign
     3893             v-object-handle = buf_temp-diasize-handle.handle-value
     3894           .
     3895           if v-object-handle <> v-diasize-resize-button
     3896           then do:
     3897             assign
     3898               v-object-handle :row = v-object-handle :row + p-change-value
     3899               no-error .
     3900             if error-status :error
     3901             or error-status :get-message(1) <> ""
     3902             then do:
     3903               undo move_block, retry move_block .
     3904             end.
     3905           end.
     3906         end.
     3907       end.
     3908       else do:
     3909         for each buf_temp-diasize-handle
     3910         on error undo move_block, retry move_block
     3911         :
     3912           assign
     3913             v-object-handle = buf_temp-diasize-handle.handle-value
     3914           .
     3915           if v-object-handle <> v-diasize-resize-button
     3916           then do:
     3917             assign
     3918               v-object-handle :row = v-object-handle :row + p-change-value
     3919               no-error .
     3920             if error-status :error
     3921             or error-status :get-message(1) <> ""
     3922             then do:
     3923               undo move_block, retry move_block .
     3924             end.
     3925           end.
     3926         end.
     3927         assign
     3928           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3929           no-error .
     3930         if error-status :error
     3931         or error-status :get-message(1) <> ""
     3932         then do:
     3933           undo move_block, retry move_block .
     3934         end.
     3935         for each buf_temp-browse-handle
     3936           where buf_temp-browse-handle.browse-type = 'height':u
     3937         on error undo move_block, retry move_block
     3938         :
     3939           assign
     3940             buf_temp-browse-handle.browse-handle :height
     3941               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3942             no-error .
     3943           if error-status :error
     3944           or error-status :get-message(1) <> ""
     3945           then do:
     3946             undo move_block, retry move_block .
     3947           end.
     3948         end.
     3949         assign
     3950           frame d-db :height = frame d-db :height + p-change-value
     3951           no-error .
     3952         if error-status :error
     3953         or error-status :get-message(1) <> ""
     3954         then do:
     3955           undo move_block, retry move_block .
     3956         end.
     3957         if frame d-db :scrollable = true
     3958         then do:
     3959           assign
     3960             frame d-db :virtual-height = frame d-db :virtual-height + p-change-value
     3961             no-error .
     3962           if error-status :error
     3963           or error-status :get-message(1) <> ""
     3964           then do:
     3965             undo move_block, retry move_block .
     3966           end.
     3967         end.
     3968       end.
     3969       if p-move-resize = true
     3970       then do:
     3971         run diasize_position-resize-button in this-procedure .
     3972       end.
     3973       if v-diasize-wndstore = true
     3974       then do:
     3975         if connected("ub") = true
     3976         then do:
     3977           define variable v-cntxt-db-num        as integer   no-undo .
     3978           define variable v-cntxt-userid        as character no-undo .
     3979           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3980                                             , OUTPUT v-cntxt-userid
     3981                                             ) .
     3982           run gbl/wndsizew.p
     3983             (input  v-cntxt-db-num
     3984             ,input  v-cntxt-userid
     3985             ,input  v-diasize-proc-name
     3986             ,input  'height':u
     3987             ,input  string(frame d-db :height - v-diasize-orig-frame-height)
     3988             ) .
     3989         end.
     3990       end.
     3991     end.
     3992     assign
     3993       v-diasize-change-size = false
     3994     .
     3995   end procedure.
     3996   procedure diasize_set-height :
     3997     define input  parameter p-new-height  as decimal   no-undo .
     3998     define input  parameter p-move-resize as logical   no-undo .
     3999     do
     4000     on error undo, return error return-value
     4001     :
     4002       run diasize_change-height in this-procedure
     4003         (input  (p-new-height - frame d-db :height)
     4004         ,input  p-move-resize
     4005         ) .
     4006     end.
     4007   end procedure.
     4008   procedure diasize_change-width :
     4009     define input  parameter p-change-value as decimal   no-undo .
     4010     define input  parameter p-move-resize  as logical   no-undo .
     4011     define variable v-field-group-handle   as handle    no-undo .
     4012     define variable v-object-handle        as handle    no-undo .
     4013     define variable v-frame-width          as decimal   no-undo .
     4014     define variable v-frame-virtual-width  as decimal   no-undo .
     4015     define variable v-browse-width         as decimal   no-undo .
     4016     define variable v-window-width         as decimal   no-undo .
     4017     define variable v-window-virtual-width as decimal   no-undo .
     4018     define variable v-change-sign          as integer   no-undo .
     4019     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     4020     define buffer buf_temp-browse-handle  for temp-browse-handle .
     4021     if p-change-value > 0
     4022     then do:
     4023       if frame d-db :width + p-change-value >
     4024           session :width-chars
     4025       then do:
     4026         assign
     4027           p-change-value = session :width-chars - frame d-db :width
     4028         .
     4029         if p-change-value <= 0
     4030         then do:
     4031           run diasize_position-resize-button in this-procedure .
     4032           return .
     4033         end.
     4034       end.
     4035     end.
     4036     if p-change-value < 0
     4037     then do:
     4038       if frame d-db :width + p-change-value < v-diasize-orig-frame-width
     4039       then do:
     4040         assign
     4041           p-change-value = v-diasize-orig-frame-width
     4042                          - frame d-db :width
     4043         .
     4044         if p-change-value >= 0
     4045         then do:
     4046           run diasize_position-resize-button in this-procedure .
     4047           return .
     4048         end.
     4049       end.
     4050     end.
     4051     if p-change-value >= 0
     4052     then do:
     4053       assign
     4054         v-change-sign = 1
     4055       .
     4056     end.
     4057     else do:
     4058       assign
     4059         v-change-sign = -1
     4060       .
     4061     end.
     4062     assign
     4063       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     4064     .
     4065     if p-change-value = 0
     4066     then do:
     4067       run diasize_position-resize-button in this-procedure .
     4068       return .
     4069     end.
     4070     move_block:
     4071     do
     4072     on error undo move_block, leave move_block
     4073     :
     4074       if retry
     4075       then do:
     4076         do
     4077         on error undo move_block, leave move_block
     4078         :
     4079           if p-change-value > 0
     4080           then do:
     4081             for each buf_temp-diasize-handle
     4082             on error undo, next
     4083             :
     4084               assign
     4085                 v-object-handle = buf_temp-diasize-handle.handle-value
     4086               .
     4087               if v-object-handle <> v-diasize-resize-button
     4088               then do:
     4089                 assign
     4090                   v-object-handle :col = buf_temp-diasize-handle.save-position
     4091                 .
     4092               end.
     4093             end.
     4094             assign
     4095               v-diasize-browse-handle :width = v-browse-width
     4096             .
     4097             for each buf_temp-browse-handle
     4098               where buf_temp-browse-handle.browse-type = 'width':u
     4099             on error undo, next
     4100             :
     4101               assign
     4102                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     4103               .
     4104             end.
     4105             assign
     4106               frame d-db :width = v-frame-width
     4107             .
     4108             if frame d-db :scrollable = true
     4109             then do:
     4110               assign
     4111                 frame d-db :virtual-width = v-frame-virtual-width
     4112               .
     4113             end.
     4114             run diasize_position-resize-button in this-procedure .
     4115           end.
     4116           else do:
     4117             if frame d-db :scrollable = true
     4118             then do:
     4119               assign
     4120                 frame d-db :virtual-width = v-frame-virtual-width
     4121               .
     4122             end.
     4123             assign
     4124               frame d-db :width = v-frame-width
     4125             .
     4126             for each buf_temp-browse-handle
     4127               where buf_temp-browse-handle.browse-type = 'width':u
     4128             on error undo, next
     4129             :
     4130               assign
     4131                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     4132               .
     4133             end.
     4134             assign
     4135               v-diasize-browse-handle :width = v-browse-width
     4136             .
     4137             for each buf_temp-diasize-handle
     4138             on error undo, next
     4139             :
     4140               assign
     4141                 v-object-handle = buf_temp-diasize-handle.handle-value
     4142               .
     4143               if v-object-handle <> v-diasize-resize-button
     4144               then do:
     4145                 assign
     4146                   v-object-handle :col = buf_temp-diasize-handle.save-position
     4147                 .
     4148               end.
     4149             end.
     4150             run diasize_position-resize-button in this-procedure .
     4151           end.
     4152           assign
     4153             v-diasize-change-size = false
     4154           .
     4155           leave move_block .
     4156         end.
     4157       end.
     4158       assign
     4159         v-diasize-need-full-display = true
     4160       .
     4161       if v-diasize-change-size = false
     4162       then do:
     4163         assign
     4164           v-diasize-change-size = true
     4165         .
     4166       end.
     4167       else do:
     4168         return .
     4169       end.
     4170       assign
     4171         v-frame-width = frame d-db :width
     4172         v-frame-virtual-width = frame d-db :virtual-width
     4173         v-browse-width = v-diasize-browse-handle :width
     4174       .
     4175       for each buf_temp-browse-handle
     4176         where buf_temp-browse-handle.browse-type = 'width':u
     4177       :
     4178         assign
     4179           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     4180         .
     4181       end.
     4182       for each buf_temp-diasize-handle
     4183       :
     4184         delete buf_temp-diasize-handle .
     4185       end.
     4186       assign
     4187         v-field-group-handle = frame d-db :first-child
     4188       .
     4189       do while valid-handle(v-field-group-handle)
     4190       :
     4191         assign
     4192           v-object-handle = v-field-group-handle :first-child
     4193         .
     4194         do while valid-handle(v-object-handle)
     4195         :
     4196           if  v-object-handle <> v-diasize-browse-handle :handle
     4197           and v-object-handle <> v-diasize-resize-button
     4198           and can-query(v-object-handle, "row")
     4199           and can-query(v-object-handle, "height")
     4200           and ( v-object-handle :col + v-object-handle :width
     4201                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     4202               )
     4203           then do:
     4204             find first buf_temp-browse-handle
     4205               where buf_temp-browse-handle.browse-type   = 'width':u
     4206                 and buf_temp-browse-handle.browse-handle = v-object-handle
     4207               no-error .
     4208             if available buf_temp-browse-handle
     4209             then do:
     4210             end.
     4211             else do:
     4212               create buf_temp-diasize-handle .
     4213               assign
     4214                 buf_temp-diasize-handle.handle-value  = v-object-handle
     4215                 buf_temp-diasize-handle.save-position = v-object-handle :col
     4216               .
     4217             end.
     4218           end.
     4219           assign
     4220             v-object-handle = v-object-handle :next-sibling
     4221           .
     4222         end.
     4223         assign
     4224           v-field-group-handle = v-field-group-handle :next-sibling
     4225         .
     4226       end.
     4227       do with frame d-db
     4228       :
     4229         hide v-diasize-resize-button .
     4230         v-diasize-resize-button :row = 1.
     4231         v-diasize-resize-button :column = 1.
     4232       end.
     4233       if p-change-value > 0
     4234       then do:
     4235         if frame d-db :scrollable = true
     4236         then do:
     4237           assign
     4238             frame d-db :virtual-width = frame d-db :virtual-width + p-change-value
     4239             no-error .
     4240           if error-status :error
     4241           or error-status :get-message(1) <> ""
     4242           then do:
     4243             undo move_block, retry move_block.
     4244           end.
     4245         end.
     4246         assign
     4247           frame d-db :width = v-frame-width + p-change-value
     4248           no-error .
     4249         if error-status :error
     4250         or error-status :get-message(1) <> ""
     4251         then do:
     4252           undo move_block, retry move_block.
     4253         end.
     4254         assign
     4255           v-diasize-browse-handle :width = v-browse-width + p-change-value
     4256         no-error .
     4257         if error-status :error
     4258         or error-status :get-message(1) <> ""
     4259         then do:
     4260           undo move_block, retry move_block.
     4261         end.
     4262         for each buf_temp-browse-handle
     4263           where buf_temp-browse-handle.browse-type = 'width':u
     4264         on error undo move_block, retry move_block
     4265         :
     4266           assign
     4267             buf_temp-browse-handle.browse-handle :width
     4268               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4269             no-error .
     4270           if error-status :error
     4271           or error-status :get-message(1) <> ""
     4272           then do:
     4273             undo move_block, retry move_block .
     4274           end.
     4275         end.
     4276         for each buf_temp-diasize-handle
     4277         on error undo move_block, retry move_block
     4278         :
     4279           assign
     4280             v-object-handle = buf_temp-diasize-handle.handle-value
     4281           .
     4282           if v-object-handle <> v-diasize-resize-button
     4283           then do:
     4284             assign
     4285               v-object-handle :col = v-object-handle :col + p-change-value
     4286               no-error .
     4287             if error-status :error
     4288             or error-status :get-message(1) <> ""
     4289             then do:
     4290               undo move_block, retry move_block .
     4291             end.
     4292           end.
     4293         end.
     4294       end.
     4295       else do:
     4296         for each buf_temp-diasize-handle
     4297         on error undo move_block, retry move_block
     4298         :
     4299           assign
     4300             v-object-handle = buf_temp-diasize-handle.handle-value
     4301           .
     4302           if v-object-handle <> v-diasize-resize-button
     4303           then do:
     4304             assign
     4305               v-object-handle :col = v-object-handle :col + p-change-value
     4306               no-error .
     4307             if error-status :error
     4308             or error-status :get-message(1) <> ""
     4309             then do:
     4310               undo move_block, retry move_block .
     4311             end.
     4312           end.
     4313         end.
     4314         for each buf_temp-browse-handle
     4315           where buf_temp-browse-handle.browse-type = 'width':u
     4316         on error undo move_block, retry move_block
     4317         :
     4318           assign
     4319             buf_temp-browse-handle.browse-handle :width
     4320               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4321             no-error .
     4322           if error-status :error
     4323           or error-status :get-message(1) <> ""
     4324           then do:
     4325             undo move_block, retry move_block .
     4326           end.
     4327         end.
     4328         assign
     4329           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     4330           no-error .
     4331         if error-status :error
     4332         or error-status :get-message(1) <> ""
     4333         then do:
     4334           undo move_block, retry move_block.
     4335         end.
     4336         assign
     4337           frame d-db :width = frame d-db :width + p-change-value
     4338         no-error .
     4339         if error-status :error
     4340         or error-status :get-message(1) <> ""
     4341         then do:
     4342           undo move_block, retry move_block.
     4343         end.
     4344         if frame d-db :scrollable = true
     4345         then do:
     4346           assign
     4347             frame d-db :virtual-width = frame d-db :virtual-width + p-change-value
     4348           no-error .
     4349           if error-status :error
     4350           or error-status :get-message(1) <> ""
     4351           then do:
     4352             undo move_block, retry move_block.
     4353           end.
     4354         end.
     4355       end.
     4356       if p-move-resize
     4357       then do:
     4358         run diasize_position-resize-button in this-procedure .
     4359       end.
     4360       if v-diasize-wndstore = true
     4361       then do:
     4362         if connected("ub") = true
     4363         then do:
     4364           define variable v-cntxt-db-num        as integer   no-undo .
     4365           define variable v-cntxt-userid        as character no-undo .
     4366           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4367                                             , OUTPUT v-cntxt-userid
     4368                                             ) .
     4369           run gbl/wndsizew.p
     4370             (input  v-cntxt-db-num
     4371             ,input  v-cntxt-userid
     4372             ,input  v-diasize-proc-name
     4373             ,input  'width':u
     4374             ,input  string(frame d-db :width - v-diasize-orig-frame-width)
     4375             ) .
     4376         end.
     4377       end.
     4378     end.
     4379     assign
     4380       v-diasize-change-size = false
     4381     .
     4382   end procedure.
     4383   procedure diasize_set-width :
     4384     define input  parameter p-new-width  as decimal   no-undo .
     4385     define input  parameter p-move-resize as logical   no-undo .
     4386     do
     4387     on error undo, return error return-value
     4388     :
     4389       run diasize_change-width in this-procedure
     4390         (input  (p-new-width - frame d-db :width)
     4391         ,input  p-move-resize
     4392         ) .
     4393     end.
     4394   end procedure.
     4395   procedure diasize_position-resize-button :
     4396     do with frame d-db
     4397     :
     4398       hide v-diasize-resize-button .
     4399       assign
     4400         v-diasize-resize-button :row = frame d-db :height - v-diasize-resize-button :height
     4401                     - 1
     4402                     - (frame d-db :border-bottom-pixels / session :pixels-per-row)
     4403         v-diasize-resize-button :col = frame d-db :width - v-diasize-resize-button :width
     4404                     - 1
     4405                     - (frame d-db :border-right-pixels / session :pixels-per-column)
     4406       .
     4407       view v-diasize-resize-button .
     4408     end.
     4409   end procedure.
     4410   on alt-right anywhere
     4411   do:
     4412     run diasize_change-width in this-procedure
     4413       (input 1
     4414       ,input true
     4415       ) .
     4416     return no-apply .
     4417   end.
     4418   on alt-left anywhere
     4419   do:
     4420     run diasize_change-width in this-procedure
     4421       (input -1
     4422       ,input true
     4423       ) .
     4424     return no-apply .
     4425   end.
     4426   on alt-down anywhere
     4427   do:
     4428     run diasize_change-height in this-procedure
     4429       (input 1
     4430       ,input true
     4431       ) .
     4432     return no-apply .
     4433   end.
     4434   on alt-up anywhere
     4435   do:
     4436     run diasize_change-height in this-procedure
     4437       (input -1
     4438       ,input true
     4439       ) .
     4440     return no-apply .
     4441   end.
     4442   on alt-enter of frame d-db
     4443   do:
     4444     run diasize_maximize in this-procedure
     4445       (input  ?
     4446       ).
     4447     return no-apply .
     4448   end.
     4449   procedure diasize_end-move :
     4450     do
     4451     on error undo, return error return-value
     4452     :
     4453       define variable v-row-delta as decimal   no-undo .
     4454       define variable v-col-delta as decimal   no-undo .
     4455       define variable v-new-row as decimal   no-undo .
     4456       define variable v-new-col as decimal   no-undo .
     4457       assign
     4458         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     4459         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     4460       .
     4461       assign
     4462         v-row-delta = v-new-row - frame d-db :height
     4463         v-col-delta = v-new-col - frame d-db :width
     4464       .
     4465       run diasize_change-height in this-procedure
     4466         (input v-row-delta
     4467         ,input true
     4468         ) .
     4469       run diasize_change-width in this-procedure
     4470         (input v-col-delta
     4471         ,input true
     4472         ) .
     4473     end.
     4474   end procedure.
     4475   procedure diasize_maximize :
     4476     define input  parameter p-action as logical   no-undo .
     4477     do
     4478     on error undo, return error return-value
     4479     :
     4480       if p-action = ?
     4481       then do:
     4482         if v-diasize-need-maximize = true
     4483         then do:
     4484           assign
     4485             p-action = true
     4486           .
     4487         end.
     4488         else do:
     4489           assign
     4490             p-action = false
     4491           .
     4492         end.
     4493       end.
     4494       if p-action = true
     4495       then do:
     4496         run diasize_change-height in this-procedure
     4497           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     4498               - frame d-db :height-chars
     4499           ,input true
     4500           ) .
     4501         run diasize_change-width in this-procedure
     4502           (input session :width-chars
     4503               - frame d-db :width-chars
     4504           ,input true
     4505           ) .
     4506         assign
     4507           v-diasize-need-maximize = false
     4508         .
     4509       end.
     4510       else do:
     4511         run diasize_change-width in this-procedure
     4512           (input v-diasize-orig-frame-width
     4513               - frame d-db :width-chars
     4514           ,input true
     4515           ) .
     4516         run diasize_change-height in this-procedure
     4517           (input v-diasize-orig-frame-height
     4518               - frame d-db :height-chars
     4519           ,input true
     4520           ) .
     4521         assign
     4522           v-diasize-need-maximize = true
     4523         .
     4524       end.
     4525     end.
     4526   end procedure.
     4527   procedure diasize_restore-orig-size :
     4528     do
     4529     on error undo, return error return-value
     4530     :
     4531       assign
     4532         v-diasize-current-frame-width  = frame d-db :width
     4533         v-diasize-current-frame-height = frame d-db :height
     4534       .
     4535       run diasize_set-height in this-procedure
     4536         (input  v-diasize-orig-frame-height
     4537         ,input  true
     4538         ) .
     4539       run diasize_set-width in this-procedure
     4540         (input  v-diasize-orig-frame-width
     4541         ,input  true
     4542         ) .
     4543     end.
     4544   end procedure.
     4545   procedure diasize_restore-current-size :
     4546     do
     4547     on error undo, return error return-value
     4548     :
     4549       run diasize_set-height in this-procedure
     4550         (input  v-diasize-current-frame-height
     4551         ,input  true
     4552         ) .
     4553       run diasize_set-width in this-procedure
     4554         (input  v-diasize-current-frame-width
     4555         ,input  true
     4556         ) .
     4557     end.
     4558   end procedure.
     4559   procedure diasize_set-browse-handle :
     4560     define input  parameter p-browse-handle as handle   no-undo .
     4561     define buffer buf_temp-browse-handle for temp-browse-handle .
     4562     do
     4563     on error undo, return error return-value
     4564     :
     4565       assign
     4566         v-diasize-browse-handle = p-browse-handle
     4567       .
     4568       for each buf_temp-browse-handle
     4569       on error undo, return error return-value
     4570       :
     4571         delete buf_temp-browse-handle .
     4572       end.
     4573     end.
     4574   end procedure.
     4575   procedure diasize_add_browse :
     4576     define input  parameter p-browse-type   as character no-undo .
     4577     define input  parameter p-browse-handle as handle    no-undo .
     4578     define buffer buf_temp-browse-handle for temp-browse-handle .
     4579     do
     4580     on error undo, return error return-value
     4581     :
     4582       assign
     4583         v-diasize-browse-number = v-diasize-browse-number + 1
     4584       .
     4585       create buf_temp-browse-handle .
     4586       assign
     4587         buf_temp-browse-handle.browse-type   = p-browse-type
     4588         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     4589         buf_temp-browse-handle.browse-handle = p-browse-handle
     4590       .
     4591     end.
     4592   end procedure.
     4593   procedure diasize_init :
     4594     define variable v-default-value    as logical   no-undo .
     4595     define variable v-restore-saved    as logical   no-undo .
     4596     define variable v-resize-value-str as character no-undo .
     4597     do
     4598     on error undo, return error return-value
     4599     :
     4600       do with frame d-db
     4601       :
     4602         assign
     4603           v-diasize-orig-frame-height = frame d-db :height
     4604           v-diasize-orig-frame-width  = frame d-db :width
     4605           v-diasize-browse-handle     = browse br-db :handle
     4606         .
     4607         create button v-diasize-resize-button
     4608         assign
     4609           parent        = frame d-db :first-child
     4610           label         = "s"
     4611           height-pixels = 16
     4612           width-pixels  = 16
     4613           visible       = true
     4614           sensitive     = true
     4615           movable       = true
     4616           triggers:
     4617             on end-move persistent run diasize_end-move in this-procedure .
     4618           end triggers.
     4619         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     4620         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     4621         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     4622         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     4623         assign
     4624           v-diasize-wndmax = false
     4625         .
     4626         if connected("ub") = true
     4627         then do:
     4628           define variable v-cntxt-db-num        as integer   no-undo .
     4629           define variable v-cntxt-userid        as character no-undo .
     4630           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4631                                             , OUTPUT v-cntxt-userid
     4632                                             ) .
     4633           run gbl/wndpar_r.p
     4634             (input  v-cntxt-db-num
     4635             ,input  v-cntxt-userid
     4636             ,input  'wndmax':U
     4637             ,output v-diasize-wndmax
     4638             ,output v-default-value
     4639             ) .
     4640         end.
     4641         assign
     4642           v-diasize-wndstore = false
     4643         .
     4644         if connected("ub") = true
     4645         then do:
     4646           run gbl/wndpar_r.p
     4647             (input  v-cntxt-db-num
     4648             ,input  v-cntxt-userid
     4649             ,input  'wndstore':U
     4650             ,output v-diasize-wndstore
     4651             ,output v-default-value
     4652             ) .
     4653         end.
     4654         assign
     4655           v-diasize-proc-name = entry(1, program-name(2), '.')
     4656         .
     4657         if v-diasize-wndstore = true
     4658         then do:
     4659           assign
     4660             v-restore-saved = false
     4661           .
     4662           if connected("ub") = true
     4663           then do:
     4664             run gbl/wndsizer.p
     4665               (input  v-cntxt-db-num
     4666               ,input  v-cntxt-userid
     4667               ,input  v-diasize-proc-name
     4668               ,input  'height':u
     4669               ,output v-resize-value-str
     4670               ) .
     4671             if v-resize-value-str <> '':U
     4672             then do:
     4673               run diasize_change-height in this-procedure
     4674                 (input  integer(v-resize-value-str)
     4675                 ,input  true
     4676                 ) .
     4677               assign
     4678                 v-restore-saved = true
     4679               .
     4680             end.
     4681           end.
     4682           if connected("ub") = true
     4683           then do:
     4684             run gbl/wndsizer.p
     4685               (input  v-cntxt-db-num
     4686               ,input  v-cntxt-userid
     4687               ,input  v-diasize-proc-name
     4688               ,input  'width':u
     4689               ,output v-resize-value-str
     4690               ) .
     4691             if v-resize-value-str <> '':U
     4692             then do:
     4693               run diasize_change-width in this-procedure
     4694                 (input  integer(v-resize-value-str)
     4695                 ,input  true
     4696                 ) .
     4697               assign
     4698                 v-restore-saved = true
     4699               .
     4700             end.
     4701           end.
     4702           if v-restore-saved <> true
     4703           then do:
     4704             if v-diasize-wndmax = true
     4705             then do:
     4706               run diasize_maximize in this-procedure
     4707                 (input  true
     4708                 ) .
     4709             end.
     4710           end.
     4711         end.
     4712         else do:
     4713           if v-diasize-wndmax = true
     4714           then do:
     4715             run diasize_maximize in this-procedure
     4716               (input  true
     4717               ) .
     4718           end.
     4719         end.
     4720       end.
     4721     end.
     4722   end procedure.
     4723   procedure diasize_need-full-display :
     4724     define output parameter p-need-full-display as logical   no-undo .
     4725     do
     4726     on error undo, return error return-value
     4727     :
     4728       assign
     4729         p-need-full-display = v-diasize-need-full-display
     4730       .
     4731       assign
     4732         v-diasize-need-full-display = false
     4733       .
     4734     end.
     4735   end procedure.
     4736   procedure get-context :
     4737      define output parameter p-db-num as integer          no-undo.
     4738      define output parameter p-user-id as character        no-undo.
     4739      define variable v-login               as character    no-undo.
     4740      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4741      define buffer buf_user-login  for ub.user-login .
     4742      do
     4743      on error undo, return error
     4744      :
     4745            FIND FIRST buf_sys-ctrl no-lock.
     4746            ASSIGN
     4747               v-login = USERID("ub")
     4748               p-db-num = buf_sys-ctrl.db-num
     4749            .
     4750            FIND FIRST buf_user-login
     4751                 WHERE buf_user-login.db-num = p-db-num
     4752                   AND buf_user-login.user-login = v-login
     4753                 no-lock
     4754                 no-error
     4755                 .
     4756            IF AVAILABLE buf_user-login
     4757            THEN DO:
     4758               assign
     4759                  p-user-id = buf_user-login.user-id
     4760               .
     4761            END.
     4762      end.
     4763   end procedure.
     4764   run diasize_add_browse in this-procedure
     4765     (input  'height':u
     4766     ,input  browse br-clients :handle
     4767     ) .
     4768   run diasize_init in this-procedure .
     4769   MAIN-BLOCK:
     4770   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4771      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     4772     find first buf_sys-ctrl no-lock .
     4773     RUN MyEnable IN THIS-PROCEDURE.
     4774     WAIT-FOR GO OF FRAME d-db focus b-quit.
     4775   END.
     4776   RUN disable_UI.
     4777   PROCEDURE disable_UI :
     4778     HIDE FRAME d-db.
     4779   END PROCEDURE.
     4780   PROCEDURE MyEnable :
     4781   define variable v-userid       as character no-undo .
     4782     define variable v-curr-db-num  as integer   no-undo .
     4783     define variable v-curr-user-id as character no-undo .
     4784     define variable v-user-admin   as logical   no-undo .
     4785     ENABLE
     4786       b-quit
     4787       b-hist
     4788       b-help
     4789       br-db
     4790       br-clients
     4791       b-lkp
     4792       b-print
     4793       b-attr when valid-handle( parparentproc )
     4794       b-param when valid-handle( parparentproc )
     4795       b-hn when valid-handle( parparentproc )
     4796       with frame d-db.
     4797     b-hn:menu-mouse in frame d-db = 1.
     4798     b-param:menu-mouse in frame d-db = 1.
     4799     if p-mode = 'ИЗМЕНЕНИЕ':U
     4800     then do:
     4801       if buf_sys-ctrl.db-num = 0
     4802       then do:
     4803         enable
     4804           b-chg
     4805           b-send
     4806           b-add
     4807           b-unld
     4808           b-del
     4809           b-mark
     4810           b-sel-all
     4811           b-unmark
     4812           b-unld-list
     4813           with frame d-db.
     4814         assign
     4815           b-unld:menu-mouse = 1
     4816         .
     4817         if buf_sys-ctrl.status_ = 'copy-DB':U
     4818         then do:
     4819           assign
     4820             b-unld:popup-menu = ?
     4821           .
     4822         end.
     4823   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4824   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run getcurus in g#library2
     4825     (output v-curr-db-num
     4826     ,output v-curr-user-id
     4827     ) no-error .
     4828         if error-status :error
     4829         then do:
     4830           message
     4831             vss-workfile vss-revision vss-description skip
     4832             "Ошибка при определении текущей базы и текущего пользователя" skip
     4833             error-status :get-message(1) skip
     4834             return-value skip
     4835             view-as alert-box error .
     4836           undo, return error return-value .
     4837         end.
     4838   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4839   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run user-adm in g#library2
     4840     (input  v-curr-db-num
     4841     ,input  v-curr-user-id
     4842     ,output v-user-admin
     4843     ) no-error .
     4844         if error-status :error
     4845         then do:
     4846           message
     4847             vss-workfile vss-revision vss-description skip
     4848             "Ошибка при определении является ли пользователем администратор" skip
     4849             error-status :get-message(1) skip
     4850             return-value skip
     4851             view-as alert-box error .
     4852           undo, return error return-value .
     4853         end.
     4854         if v-user-admin = true then do:
     4855           enable
     4856             b-turn-off
     4857             with frame d-db.
     4858         end.
     4859         menu-item m_hn-copy:sensitive in menu menu-b-hn = (buf_sys-ctrl.db-num = 0).
     4860       end.
     4861     end.
     4862     else do:
     4863       enable
     4864         b-sel
     4865         with frame d-db.
     4866       assign
     4867         menu-item m_hn-update:sensitive in menu menu-b-hn = no
     4868         menu-item m_hn-copy:sensitive in menu menu-b-hn = no
     4869       .
     4870     end.
     4871     OPEN QUERY br-db FOR EACH ub.db NO-LOCK.
     4872     apply "VALUE-CHANGED":U to br-db.
     4873   END PROCEDURE.
     4874   PROCEDURE proc-hn :
     4875   DEFINE INPUT PARAMETER p-option AS CHARACTER NO-UNDO.
     4876   DEFINE variable v-rid AS RECID NO-UNDO.
     4877   DEFINE VARIABLE v-today as date no-undo .
     4878   DEFINE VARIABLE v-time as integer no-undo .
     4879   DEFINE BUFFER buf_db FOR ub.db.
     4880   DEFINE BUFFER buf_hist-nws-option FOR ub.hist-nws-option.
     4881   DEFINE BUFFER buft_hist-nws-option FOR ub.hist-nws-option.
     4882   IF NOT AVAILABLE ub.db THEN UNDO, RETURN ERROR.
     4883   IF buf_sys-ctrl.db-num <> 0
     4884   AND buf_sys-ctrl.db-num <> db.db-num
     4885   and p-option <> 'ПРОСМОТР':U
     4886   THEN DO:
     4887      MESSAGE
     4888      "Нельзя изменять настройки записи истории и маршрутизации в чужой УБД"
     4889       VIEW-AS ALERT-BOX.
     4890      UNDO, RETURN ERROR.
     4891   END.
     4892   CASE p-option:
     4893     WHEN 'ИЗМЕНЕНИЕ':U THEN DO:
     4894       run adm/db-hn.w ( input parparentproc
     4895                   , input 'ИЗМЕНЕНИЕ':U
     4896                   , input db.db-num
     4897                   ).
     4898     END.
     4899     WHEN 'ПРОСМОТР':U THEN DO:
     4900         run adm/db-hn.w ( input parparentproc
     4901                     , input 'ПРОСМОТР':U
     4902                     , input db.db-num
     4903                     ).
     4904     END.
     4905     WHEN 'КОПИРОВАНИЕ':U THEN DO:
     4906        MESSAGE
     4907        substitute("Выберите БД, с которой Вы хотите скопировать&1настройки записи истории и маршрутизации на БД &2"
     4908                   , chr(10)
     4909                   , db.db-num)
     4910        VIEW-AS ALERT-BOX.
     4911      run adm/dbs.w ( INPUT parparentproc
     4912         ,INPUT 'ПРОСМОТР':U
     4913         ,OUTPUT v-rid) NO-ERROR.
     4914       IF ERROR-STATUS:ERROR THEN RETURN ERROR.
     4915       FIND FIRST buf_db NO-LOCK WHERE
     4916             recid(buf_db) = v-rid .
     4917       FIND FIRST buf_hist-nws-option NO-LOCK WHERE
     4918                 buf_hist-nws-option.db-num = buf_db.db-num NO-ERROR.
     4919       IF NOT AVAILABLE buf_hist-nws-option THEN DO:
     4920          MESSAGE
     4921          substitute("Для БД &1 настройки записи истории и маршрутизации не заданы"
     4922                     , buf_db.db-num)
     4923          VIEW-AS ALERT-BOX error .
     4924          UNDO, RETURN ERROR.
     4925       END.
     4926       DO TRANSACTION ON ERROR UNDO, RETURN ERROR:
     4927           FOR EACH buf_hist-nws-option NO-LOCK WHERE
     4928                   buf_hist-nws-option.db-num = buf_db.db-num
     4929                AND buf_hist-nws-option.hn-id > 0
     4930           ON error UNDO, RETURN error :
     4931              FIND FIRST buft_hist-nws-option WHERE
     4932                       buft_hist-nws-option.db-num = db.db-num
     4933                   AND buft_hist-nws-option.hn-id = buf_hist-nws-option.hn-id NO-ERROR.
     4934              IF NOT AVAILABLE buft_hist-nws-option THEN DO:
     4935                  CREATE buft_hist-nws-option.
     4936                  BUFFER-COPY buf_hist-nws-option
     4937                  EXCEPT db-num
     4938                  TO buft_hist-nws-option.
     4939              END.
     4940           END.
     4941           run cur-time in THIS-PROCEDURE
     4942             (output v-today
     4943             ,output v-time
     4944             ).
     4945           FIND FIRST buft_hist-nws-option WHERE
     4946                    buft_hist-nws-option.db-num = db.db-num
     4947                AND buft_hist-nws-option.hn-id = 0 NO-ERROR.
     4948           IF NOT AVAILABLE buft_hist-nws-option THEN DO:
     4949               CREATE buft_hist-nws-option.
     4950               BUFFER-COPY buf_hist-nws-option
     4951               EXCEPT option-descr
     4952               TO buft_hist-nws-option
     4953               ASSIGN
     4954               buft_hist-nws-option.option-descr = substitute("&1 &2"
     4955                                                                , string(v-today, "99/99/9999")
     4956                                                                , string(v-time, "HH:MM:SS"))
     4957               .
     4958           END.
     4959       END.
     4960     END.
     4961   END CASE.
     4962   END PROCEDURE.
     4963   procedure local-mark :
     4964     if not available ub.db then
     4965     do:
     4966       message "Неправильный выбор строки.".
     4967       return no-apply.
     4968     end.
     4969   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4970   define variable v-str-recid22 as character no-undo .
     4971   define variable v-num-entry22 as integer   no-undo .
     4972   assign
     4973     v-str-recid22 = trim( string( recid( ub.db ) , "->>>>>>>>>>>9":U ) )
     4974     v-num-entry22 = lookup( v-str-recid22 , select-list )
     4975   .
     4976   if v-num-entry22 > 0 then do:
     4977     assign
     4978       entry( v-num-entry22, select-list ) = "":U
     4979       select-list = trim( replace( select-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     4980     .
     4981   end.
     4982   else do:
     4983     assign
     4984       select-list = select-list + ( if select-list = "":U then "":U else chr(44) ) + v-str-recid22
     4985     .
     4986   end.
     4987     br-db:refresh() in frame d-db .
     4988   end procedure.
     4989   procedure proc-b-mark :
     4990     define variable varlog as logical no-undo .
     4991     if not available ub.db then return.
     4992     run local-mark in this-procedure.
     4993     assign
     4994       varlog = br-db:select-next-row( ) in frame d-db.
     4995     apply "ENTRY":U to br-db in frame d-db.
     4996     br-db:refresh() in frame d-db .
     4997   end procedure.
     4998   FUNCTION get-infodb-date RETURNS DATE
     4999     ( INPUT p-db-num as integer) :
     5000   DEFINE BUFFER buf_db-info FOR ub.db-info.
     5001   find last buf_db-info no-lock where
     5002           buf_db-info.db-num = p-db-num use-index  pi no-error.
     5003   IF AVAILABLE buf_db-info  THEN RETURN buf_db-info.date-info.
     5004   RETURN ?.
     5005   END FUNCTION.
     5006   FUNCTION get-infodb-ver RETURNS character
     5007     ( INPUT p-db-num as integer) :
     5008   DEFINE BUFFER upgrade FOR upgrade.
     5009    block-step:
     5010   for each upgrade where upgrade.db-num   eq p-db-num
     5011      no-lock by upgrade.db-num descending
     5012              by upgrade.step-num descending :
     5013         leave block-step.
     5014      end.
     5015   return if available upgrade then  entry(1,upgrade.version-num,chr(4)) else "?".
     5016   END FUNCTION.
