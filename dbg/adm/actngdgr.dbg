      118   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      119     define variable v-cntxt-db-num        as integer   no-undo .
      120     define variable v-cntxt-userid        as character no-undo .
      121     define variable v-cntxt-level         as character no-undo .
      122     define variable v-cntxt-host-code-obj as integer   no-undo .
      123     define variable v-cntxt-obj-type      as character no-undo .
      124     define variable v-cntxt-obj-code      as integer   no-undo .
      125     define variable v-cntxt-db-num-obj    as integer   no-undo .
      126     define variable v-cntxt-is-admin      as logical   no-undo .
      127   define variable v-ref-list    as character                     no-undo.
      128   define temp-table tt-goods no-undo like ub.goods.
      129   define buffer buf_tt-goods for tt-goods .
      130   DEFINE BUTTON b-add
      131        LABEL "Добавить"
      132        SIZE 10 BY 1.
      133   DEFINE BUTTON b-del
      134        LABEL "Удалить"
      135        SIZE 10 BY 1.
      136   DEFINE BUTTON b-exit AUTO-GO
      137        LABEL "&Ввод"
      138        SIZE 10 BY 1
      139        BGCOLOR 8 .
      140   DEFINE BUTTON b-help
      141        LABEL "Помо&щь"
      142        SIZE 10 BY 1
      143        BGCOLOR 8 .
      144   DEFINE BUTTON b-quit AUTO-GO
      145        LABEL "&Отмена"
      146        SIZE 10 BY 1.
      147   DEFINE QUERY BROWSE-2 FOR
      148         buf_tt-goods SCROLLING.
      149   DEFINE BROWSE BROWSE-2
      150     QUERY BROWSE-2 DISPLAY
      151         buf_tt-goods.gds-name
      152         buf_tt-goods.artic
      153         buf_tt-goods.prod-type
      154         buf_tt-goods.prod-code
      155       WITH NO-ROW-MARKERS SEPARATORS SIZE 64 BY 19.76 ROW-HEIGHT-CHARS .75 FIT-LAST-COLUMN.
      156   DEFINE FRAME Dialog-Frame
      157        b-exit AT ROW 1 COL 1
      158        b-quit AT ROW 1 COL 11 WIDGET-ID 6
      159        b-add AT ROW 1 COL 21 WIDGET-ID 2
      160        b-del AT ROW 1 COL 31 WIDGET-ID 4
      161        b-help AT ROW 1 COL 55
      162        BROWSE-2 AT ROW 2.24 COL 1 WIDGET-ID 200
      163        SPACE(0.13) SKIP(0.99)
      164       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      165            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      166            TITLE "<insert dialog title>"
      167            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit WIDGET-ID 100.
      168   ASSIGN
      169          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      170          FRAME Dialog-Frame:HIDDEN           = TRUE.
      171   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      172   DO:
      173     APPLY "END-ERROR":U TO SELF.
      174   END.
      175   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      176   DO:
      177       run ref/gds-ref.p
      178       ( parParentProc
      179       ,"b-sel,b-mark"
      180       ,'все':U
      181       ,'все':U
      182       ,'все':U
      183       ,?
      184       ,?
      185       ,?
      186       ,?
      187       ,v-cntxt-obj-type
      188       ,v-cntxt-obj-code
      189       ,?
      190       ,output v-ref-list).
      191       if v-ref-list <> "" then do:
      192         RUN create-actn-gds IN THIS-PROCEDURE ( INPUT v-ref-list ) no-error.
      193         if error-status:error then do:
      194            message
      195               vss-workfile vss-revision vss-description skip
      196               "Ошибка при вызове процедуры создания товара" skip
      197               error-status :get-message(1) skip
      198               return-value skip
      199               view-as alert-box error .
      200            return no-apply.
      201         end.
      202         OPEN QUERY BROWSE-2 FOR EACH buf_tt-goods.
      203       end.
      204   END.
      205   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      206   DO:
      207     IF AVAILABLE buf_tt-goods THEN DO:
      208        delete buf_tt-goods.
      209     END.
      210     OPEN QUERY BROWSE-2 FOR EACH buf_tt-goods.
      211   END.
      212   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      213   DO:
      214     for each tt-goods
      215         :
      216         assign
      217            p-gds-list = IF p-gds-list = "":U THEN STRING(tt-goods.gds-code)
      218                                              ELSE p-gds-list + chr(4) + STRING(tt-goods.gds-code)
      219         .
      220     end.
      221     ASSIGN
      222         p-ok = TRUE
      223     .
      224   END.
      225   ON CHOOSE OF b-help IN FRAME Dialog-Frame
      226   OR HELP OF FRAME Dialog-Frame
      227   DO:
      228     MESSAGE "Help for File: c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\adm\actngdgr.w" VIEW-AS ALERT-BOX INFORMATION.
      229   END.
      230   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      231   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      232   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      233   on help of frame Dialog-Frame
      234   do:
      235     run gbl/app_help.p
      236       (input this-procedure :file-name
      237       ,input ''
      238       ,input ?
      239       ) no-error.
      240     if error-status :error then do:
      241       message
      242         "Ошибка при вызове помощи"
      243         error-status :get-message(1)
      244         view-as alert-box .
      245     end.
      246   end.
      247   run minbtn-set in this-procedure .
      248   on choose of b-help in frame Dialog-Frame
      249   do:
      250     apply "help":u to frame Dialog-Frame .
      251   end.
      252   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      253   procedure minbtn-set :
      254       do
      255           on error undo, return error return-value
      256           :
      257           define variable ii              as integer       no-undo .
      258           define variable fh              as widget-handle no-undo .
      259           define variable hh              as widget-handle no-undo .
      260           define variable v-h             as handle        extent 4 no-undo .
      261           define variable v-name-button   as character     no-undo .
      262           define variable v-help-old-x    as decimal       no-undo .
      263           define variable v-help-old-y    as decimal       no-undo .
      264           define variable v-help-old-size as decimal       no-undo .
      265           define variable v-frame-width   as decimal       no-undo .
      266           define variable jj              as integer       no-undo .
      267           do
      268               on error undo, return error
      269               :
      270               assign
      271                   v-frame-width = frame Dialog-Frame:width - 0.3
      272                   fh            = frame Dialog-Frame:first-child
      273                   hh            = fh:first-child
      274                   ii            = 1
      275                   .
      276               do while valid-handle(hh):
      277                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      278                   do:
      279                       case lc(hh:name) :
      280                           when "b-help" then
      281                               do:
      282                                   hh:load-image-up("cmp/b-help.bmp":u) .
      283                                   hh:load-image-down("cmp/b-help.bmp":u) .
      284                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      285                                   hh:TOOLTIP = "Помощь" .
      286                                   v-help-old-x = hh:column .
      287                                   v-help-old-y = hh:row    .
      288                                   v-help-old-size = hh:width .
      289                                   hh:width-chars = 2.5 .
      290                               end.
      291                           when "b-print" then
      292                               do:
      293                                   hh:load-image("cmp/b-print.bmp":u) .
      294                                   hh:TOOLTIP = "Печать" .
      295                                   v-h[ii] = hh:handle .
      296                                   ii = ii + 1 .
      297                                   hh:width-chars = 3 .
      298                               end.
      299                           when "b-history" or
      300                           when "b-hist" then
      301                               do:
      302                                   hh:load-image("cmp/b-hist.bmp":u) .
      303                                   hh:TOOLTIP = "История" .
      304                                   v-h[ii] = hh:handle .
      305                                   ii = ii + 1 .
      306                                   hh:width-chars = 3 .
      307                               end.
      308                           when "b-sch" then
      309                               do:
      310                                   hh:load-image("cmp/b-sch.bmp":u) .
      311                                   hh:TOOLTIP = "Установка Фильтра" .
      312                                   v-h[ii] = hh:handle .
      313                                   ii = ii + 1 .
      314                                   hh:width-chars = 3 .
      315                               end.
      316                           when "b-hist-user" then
      317                               do:
      318                                   hh:load-image("cmp/b-hist.bmp":u) .
      319                                   hh:TOOLTIP = "История пользователя" .
      320                                   ii = ii + 1 .
      321                               end.
      322                       end case.
      323                   end.
      324                   hh = hh:next-sibling.
      325               end.
      326               b-help:column = v-frame-width - b-help:width-chars.
      327               jj = 0.
      328               repeat ii = 4 to 1 by -1 :
      329                   if valid-handle (v-h[ii] ) then
      330                   do:
      331                       jj  = jj + 1 .
      332                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      333                       v-h[ii]:row    = v-help-old-y .
      334                   end.
      335               end.
      336           end.
      337       end.
      338   end procedure.
      339   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      340   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      341   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      342   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      343   define variable v-diasize-current-frame-width  as decimal   no-undo .
      344   define variable v-diasize-current-frame-height as decimal   no-undo .
      345   define variable v-diasize-change-size          as logical   no-undo .
      346   define variable v-diasize-resize-button        as handle    no-undo .
      347   define variable v-diasize-wndmax               as logical   no-undo .
      348   define variable v-diasize-wndstore             as logical   no-undo .
      349   define variable v-diasize-proc-name            as character no-undo .
      350   define variable v-diasize-browse-handle        as handle    no-undo .
      351   define variable v-diasize-browse-number        as integer   no-undo .
      352   define variable v-diasize-need-full-display    as logical   no-undo init false .
      353   define temp-table temp-diasize-handle no-undo
      354     field handle-value  as handle
      355     field save-position as decimal
      356     index xpk is primary unique handle-value
      357     .
      358   define temp-table temp-browse-handle no-undo
      359     field browse-type   as character
      360     field browse-number as integer
      361     field browse-handle as handle
      362     field original-size as decimal
      363     index xpk is primary unique browse-type browse-number
      364     index xie browse-type browse-handle
      365   .
      366   procedure diasize_change-height :
      367     define input  parameter p-change-value  as decimal   no-undo .
      368     define input  parameter p-move-resize   as logical   no-undo .
      369     define variable v-field-group-handle    as handle    no-undo .
      370     define variable v-object-handle         as handle    no-undo .
      371     define variable v-frame-height          as decimal   no-undo .
      372     define variable v-frame-virtual-height  as decimal   no-undo .
      373     define variable v-browse-height         as decimal   no-undo .
      374     define variable v-window-height         as decimal   no-undo .
      375     define variable v-window-virtual-height as decimal   no-undo .
      376     define variable v-change-sign           as integer   no-undo .
      377     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      378     define buffer buf_temp-browse-handle  for temp-browse-handle .
      379     if p-change-value > 0
      380     then do:
      381       if frame Dialog-Frame :height + p-change-value
      382           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      383       then do:
      384         assign
      385           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      386                           - (frame Dialog-Frame :height-chars)
      387         .
      388         if p-change-value <= 0
      389         then do:
      390           run diasize_position-resize-button in this-procedure .
      391           return .
      392         end.
      393       end.
      394     end.
      395     if p-change-value < 0
      396     then do:
      397       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      398       then do:
      399         assign
      400           p-change-value = v-diasize-orig-frame-height
      401                          - (frame Dialog-Frame :height-chars)
      402         .
      403         if p-change-value >= 0
      404         then do:
      405           run diasize_position-resize-button in this-procedure .
      406           return .
      407         end.
      408       end.
      409     end.
      410     if p-change-value >= 0
      411     then do:
      412       assign
      413         v-change-sign = 1
      414       .
      415     end.
      416     else do:
      417       assign
      418         v-change-sign = -1
      419       .
      420     end.
      421     assign
      422       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      423     .
      424     if p-change-value = 0
      425     then do:
      426       run diasize_position-resize-button in this-procedure .
      427       return .
      428     end.
      429     move_block:
      430     do
      431     on error undo move_block, retry move_block
      432     :
      433       if retry
      434       then do:
      435         do
      436         on error undo move_block, leave move_block
      437         :
      438           if p-change-value > 0
      439           then do:
      440             for each buf_temp-diasize-handle
      441             on error undo, next
      442             :
      443               assign
      444                 v-object-handle = buf_temp-diasize-handle.handle-value
      445               .
      446               if v-object-handle <> v-diasize-resize-button
      447               then do:
      448                 assign
      449                   v-object-handle :row = buf_temp-diasize-handle.save-position
      450                 .
      451               end.
      452             end.
      453             assign
      454               v-diasize-browse-handle :height = v-browse-height
      455             .
      456             for each buf_temp-browse-handle
      457               where buf_temp-browse-handle.browse-type = 'height':u
      458             on error undo, next
      459             :
      460               assign
      461                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      462               .
      463             end.
      464             assign
      465               frame Dialog-Frame :height = v-frame-height
      466             .
      467             if frame Dialog-Frame :scrollable = true
      468             then do:
      469               assign
      470                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      471               .
      472             end.
      473             run diasize_position-resize-button in this-procedure .
      474           end.
      475           else do:
      476             if frame Dialog-Frame :scrollable = true
      477             then do:
      478               assign
      479                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      480               .
      481             end.
      482             assign
      483               frame Dialog-Frame :height = v-frame-height
      484             .
      485             assign
      486               v-diasize-browse-handle :height = v-browse-height
      487             .
      488             for each buf_temp-browse-handle
      489               where buf_temp-browse-handle.browse-type = 'height':u
      490             on error undo, next
      491             :
      492               assign
      493                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      494               .
      495             end.
      496             for each buf_temp-diasize-handle
      497             on error undo, next
      498             :
      499               assign
      500                 v-object-handle = buf_temp-diasize-handle.handle-value
      501               .
      502               if v-object-handle <> v-diasize-resize-button
      503               then do:
      504                 assign
      505                   v-object-handle :row = buf_temp-diasize-handle.save-position
      506                 .
      507               end.
      508             end.
      509             run diasize_position-resize-button in this-procedure .
      510           end.
      511           assign
      512             v-diasize-change-size = false
      513           .
      514           leave move_block .
      515         end.
      516       end.
      517       assign
      518         v-diasize-need-full-display = true
      519       .
      520       if v-diasize-change-size = false
      521       then do:
      522         assign
      523           v-diasize-change-size = true
      524         .
      525       end.
      526       else do:
      527         return .
      528       end.
      529       assign
      530         v-frame-height = frame Dialog-Frame :height
      531         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      532         v-browse-height = v-diasize-browse-handle :height
      533       .
      534       for each buf_temp-browse-handle
      535         where buf_temp-browse-handle.browse-type = 'height':u
      536       :
      537         assign
      538           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      539         .
      540       end.
      541       for each buf_temp-diasize-handle
      542       :
      543         delete buf_temp-diasize-handle .
      544       end.
      545       assign
      546         v-field-group-handle = frame Dialog-Frame :first-child
      547       .
      548       do while valid-handle(v-field-group-handle)
      549       :
      550         assign
      551           v-object-handle = v-field-group-handle :first-child
      552         .
      553         do while valid-handle(v-object-handle)
      554         :
      555           if  v-object-handle <> v-diasize-browse-handle :handle
      556           and can-query(v-object-handle, "row")
      557           and can-query(v-object-handle, "height")
      558           and ( v-object-handle :row > v-diasize-browse-handle :row )
      559           then do:
      560             find first buf_temp-browse-handle
      561               where buf_temp-browse-handle.browse-type   = 'height':u
      562                 and buf_temp-browse-handle.browse-handle = v-object-handle
      563               no-error .
      564             if available buf_temp-browse-handle
      565             then do:
      566             end.
      567             else do:
      568               create buf_temp-diasize-handle .
      569               assign
      570                 buf_temp-diasize-handle.handle-value  = v-object-handle
      571                 buf_temp-diasize-handle.save-position = v-object-handle :row
      572               .
      573             end.
      574           end.
      575           assign
      576             v-object-handle = v-object-handle :next-sibling
      577           .
      578         end.
      579         assign
      580           v-field-group-handle = v-field-group-handle :next-sibling
      581         .
      582       end.
      583       do with frame Dialog-Frame
      584       :
      585         hide v-diasize-resize-button .
      586         assign
      587           v-diasize-resize-button :row    = 1
      588           v-diasize-resize-button :column = 1
      589         .
      590       end.
      591       if p-change-value > 0
      592       then do:
      593         if frame Dialog-Frame :scrollable = true
      594         then do:
      595           assign
      596             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      597             no-error .
      598           if error-status :error
      599           or error-status :get-message(1) <> ""
      600           then do:
      601             undo move_block, retry move_block .
      602           end.
      603         end.
      604         assign
      605           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      606           no-error .
      607         if error-status :error
      608         or error-status :get-message(1) <> ""
      609         then do:
      610           undo move_block, retry move_block .
      611         end.
      612         assign
      613           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      614           no-error .
      615         if error-status :error
      616         or error-status :get-message(1) <> ""
      617         then do:
      618           undo move_block, retry move_block .
      619         end.
      620         for each buf_temp-browse-handle
      621           where buf_temp-browse-handle.browse-type = 'height':u
      622         on error undo move_block, retry move_block
      623         :
      624           assign
      625             buf_temp-browse-handle.browse-handle :height
      626               = buf_temp-browse-handle.browse-handle :height + p-change-value
      627             no-error .
      628           if error-status :error
      629           or error-status :get-message(1) <> ""
      630           then do:
      631             undo move_block, retry move_block .
      632           end.
      633         end.
      634         for each buf_temp-diasize-handle
      635         on error undo move_block, retry move_block
      636         :
      637           assign
      638             v-object-handle = buf_temp-diasize-handle.handle-value
      639           .
      640           if v-object-handle <> v-diasize-resize-button
      641           then do:
      642             assign
      643               v-object-handle :row = v-object-handle :row + p-change-value
      644               no-error .
      645             if error-status :error
      646             or error-status :get-message(1) <> ""
      647             then do:
      648               undo move_block, retry move_block .
      649             end.
      650           end.
      651         end.
      652       end.
      653       else do:
      654         for each buf_temp-diasize-handle
      655         on error undo move_block, retry move_block
      656         :
      657           assign
      658             v-object-handle = buf_temp-diasize-handle.handle-value
      659           .
      660           if v-object-handle <> v-diasize-resize-button
      661           then do:
      662             assign
      663               v-object-handle :row = v-object-handle :row + p-change-value
      664               no-error .
      665             if error-status :error
      666             or error-status :get-message(1) <> ""
      667             then do:
      668               undo move_block, retry move_block .
      669             end.
      670           end.
      671         end.
      672         assign
      673           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      674           no-error .
      675         if error-status :error
      676         or error-status :get-message(1) <> ""
      677         then do:
      678           undo move_block, retry move_block .
      679         end.
      680         for each buf_temp-browse-handle
      681           where buf_temp-browse-handle.browse-type = 'height':u
      682         on error undo move_block, retry move_block
      683         :
      684           assign
      685             buf_temp-browse-handle.browse-handle :height
      686               = buf_temp-browse-handle.browse-handle :height + p-change-value
      687             no-error .
      688           if error-status :error
      689           or error-status :get-message(1) <> ""
      690           then do:
      691             undo move_block, retry move_block .
      692           end.
      693         end.
      694         assign
      695           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      696           no-error .
      697         if error-status :error
      698         or error-status :get-message(1) <> ""
      699         then do:
      700           undo move_block, retry move_block .
      701         end.
      702         if frame Dialog-Frame :scrollable = true
      703         then do:
      704           assign
      705             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      706             no-error .
      707           if error-status :error
      708           or error-status :get-message(1) <> ""
      709           then do:
      710             undo move_block, retry move_block .
      711           end.
      712         end.
      713       end.
      714       if p-move-resize = true
      715       then do:
      716         run diasize_position-resize-button in this-procedure .
      717       end.
      718       if v-diasize-wndstore = true
      719       then do:
      720         if connected("ub") = true
      721         then do:
      722           define variable v-cntxt-db-num        as integer   no-undo .
      723           define variable v-cntxt-userid        as character no-undo .
      724           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      725                                             , OUTPUT v-cntxt-userid
      726                                             ) .
      727           run gbl/wndsizew.p
      728             (input  v-cntxt-db-num
      729             ,input  v-cntxt-userid
      730             ,input  v-diasize-proc-name
      731             ,input  'height':u
      732             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      733             ) .
      734         end.
      735       end.
      736     end.
      737     assign
      738       v-diasize-change-size = false
      739     .
      740   end procedure.
      741   procedure diasize_set-height :
      742     define input  parameter p-new-height  as decimal   no-undo .
      743     define input  parameter p-move-resize as logical   no-undo .
      744     do
      745     on error undo, return error return-value
      746     :
      747       run diasize_change-height in this-procedure
      748         (input  (p-new-height - frame Dialog-Frame :height)
      749         ,input  p-move-resize
      750         ) .
      751     end.
      752   end procedure.
      753   procedure diasize_change-width :
      754     define input  parameter p-change-value as decimal   no-undo .
      755     define input  parameter p-move-resize  as logical   no-undo .
      756     define variable v-field-group-handle   as handle    no-undo .
      757     define variable v-object-handle        as handle    no-undo .
      758     define variable v-frame-width          as decimal   no-undo .
      759     define variable v-frame-virtual-width  as decimal   no-undo .
      760     define variable v-browse-width         as decimal   no-undo .
      761     define variable v-window-width         as decimal   no-undo .
      762     define variable v-window-virtual-width as decimal   no-undo .
      763     define variable v-change-sign          as integer   no-undo .
      764     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      765     define buffer buf_temp-browse-handle  for temp-browse-handle .
      766     if p-change-value > 0
      767     then do:
      768       if frame Dialog-Frame :width + p-change-value >
      769           session :width-chars
      770       then do:
      771         assign
      772           p-change-value = session :width-chars - frame Dialog-Frame :width
      773         .
      774         if p-change-value <= 0
      775         then do:
      776           run diasize_position-resize-button in this-procedure .
      777           return .
      778         end.
      779       end.
      780     end.
      781     if p-change-value < 0
      782     then do:
      783       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      784       then do:
      785         assign
      786           p-change-value = v-diasize-orig-frame-width
      787                          - frame Dialog-Frame :width
      788         .
      789         if p-change-value >= 0
      790         then do:
      791           run diasize_position-resize-button in this-procedure .
      792           return .
      793         end.
      794       end.
      795     end.
      796     if p-change-value >= 0
      797     then do:
      798       assign
      799         v-change-sign = 1
      800       .
      801     end.
      802     else do:
      803       assign
      804         v-change-sign = -1
      805       .
      806     end.
      807     assign
      808       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      809     .
      810     if p-change-value = 0
      811     then do:
      812       run diasize_position-resize-button in this-procedure .
      813       return .
      814     end.
      815     move_block:
      816     do
      817     on error undo move_block, leave move_block
      818     :
      819       if retry
      820       then do:
      821         do
      822         on error undo move_block, leave move_block
      823         :
      824           if p-change-value > 0
      825           then do:
      826             for each buf_temp-diasize-handle
      827             on error undo, next
      828             :
      829               assign
      830                 v-object-handle = buf_temp-diasize-handle.handle-value
      831               .
      832               if v-object-handle <> v-diasize-resize-button
      833               then do:
      834                 assign
      835                   v-object-handle :col = buf_temp-diasize-handle.save-position
      836                 .
      837               end.
      838             end.
      839             assign
      840               v-diasize-browse-handle :width = v-browse-width
      841             .
      842             for each buf_temp-browse-handle
      843               where buf_temp-browse-handle.browse-type = 'width':u
      844             on error undo, next
      845             :
      846               assign
      847                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      848               .
      849             end.
      850             assign
      851               frame Dialog-Frame :width = v-frame-width
      852             .
      853             if frame Dialog-Frame :scrollable = true
      854             then do:
      855               assign
      856                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      857               .
      858             end.
      859             run diasize_position-resize-button in this-procedure .
      860           end.
      861           else do:
      862             if frame Dialog-Frame :scrollable = true
      863             then do:
      864               assign
      865                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      866               .
      867             end.
      868             assign
      869               frame Dialog-Frame :width = v-frame-width
      870             .
      871             for each buf_temp-browse-handle
      872               where buf_temp-browse-handle.browse-type = 'width':u
      873             on error undo, next
      874             :
      875               assign
      876                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      877               .
      878             end.
      879             assign
      880               v-diasize-browse-handle :width = v-browse-width
      881             .
      882             for each buf_temp-diasize-handle
      883             on error undo, next
      884             :
      885               assign
      886                 v-object-handle = buf_temp-diasize-handle.handle-value
      887               .
      888               if v-object-handle <> v-diasize-resize-button
      889               then do:
      890                 assign
      891                   v-object-handle :col = buf_temp-diasize-handle.save-position
      892                 .
      893               end.
      894             end.
      895             run diasize_position-resize-button in this-procedure .
      896           end.
      897           assign
      898             v-diasize-change-size = false
      899           .
      900           leave move_block .
      901         end.
      902       end.
      903       assign
      904         v-diasize-need-full-display = true
      905       .
      906       if v-diasize-change-size = false
      907       then do:
      908         assign
      909           v-diasize-change-size = true
      910         .
      911       end.
      912       else do:
      913         return .
      914       end.
      915       assign
      916         v-frame-width = frame Dialog-Frame :width
      917         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      918         v-browse-width = v-diasize-browse-handle :width
      919       .
      920       for each buf_temp-browse-handle
      921         where buf_temp-browse-handle.browse-type = 'width':u
      922       :
      923         assign
      924           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      925         .
      926       end.
      927       for each buf_temp-diasize-handle
      928       :
      929         delete buf_temp-diasize-handle .
      930       end.
      931       assign
      932         v-field-group-handle = frame Dialog-Frame :first-child
      933       .
      934       do while valid-handle(v-field-group-handle)
      935       :
      936         assign
      937           v-object-handle = v-field-group-handle :first-child
      938         .
      939         do while valid-handle(v-object-handle)
      940         :
      941           if  v-object-handle <> v-diasize-browse-handle :handle
      942           and v-object-handle <> v-diasize-resize-button
      943           and can-query(v-object-handle, "row")
      944           and can-query(v-object-handle, "height")
      945           and ( v-object-handle :col + v-object-handle :width
      946                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      947               )
      948           then do:
      949             find first buf_temp-browse-handle
      950               where buf_temp-browse-handle.browse-type   = 'width':u
      951                 and buf_temp-browse-handle.browse-handle = v-object-handle
      952               no-error .
      953             if available buf_temp-browse-handle
      954             then do:
      955             end.
      956             else do:
      957               create buf_temp-diasize-handle .
      958               assign
      959                 buf_temp-diasize-handle.handle-value  = v-object-handle
      960                 buf_temp-diasize-handle.save-position = v-object-handle :col
      961               .
      962             end.
      963           end.
      964           assign
      965             v-object-handle = v-object-handle :next-sibling
      966           .
      967         end.
      968         assign
      969           v-field-group-handle = v-field-group-handle :next-sibling
      970         .
      971       end.
      972       do with frame Dialog-Frame
      973       :
      974         hide v-diasize-resize-button .
      975         v-diasize-resize-button :row = 1.
      976         v-diasize-resize-button :column = 1.
      977       end.
      978       if p-change-value > 0
      979       then do:
      980         if frame Dialog-Frame :scrollable = true
      981         then do:
      982           assign
      983             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      984             no-error .
      985           if error-status :error
      986           or error-status :get-message(1) <> ""
      987           then do:
      988             undo move_block, retry move_block.
      989           end.
      990         end.
      991         assign
      992           frame Dialog-Frame :width = v-frame-width + p-change-value
      993           no-error .
      994         if error-status :error
      995         or error-status :get-message(1) <> ""
      996         then do:
      997           undo move_block, retry move_block.
      998         end.
      999         assign
     1000           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1001         no-error .
     1002         if error-status :error
     1003         or error-status :get-message(1) <> ""
     1004         then do:
     1005           undo move_block, retry move_block.
     1006         end.
     1007         for each buf_temp-browse-handle
     1008           where buf_temp-browse-handle.browse-type = 'width':u
     1009         on error undo move_block, retry move_block
     1010         :
     1011           assign
     1012             buf_temp-browse-handle.browse-handle :width
     1013               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1014             no-error .
     1015           if error-status :error
     1016           or error-status :get-message(1) <> ""
     1017           then do:
     1018             undo move_block, retry move_block .
     1019           end.
     1020         end.
     1021         for each buf_temp-diasize-handle
     1022         on error undo move_block, retry move_block
     1023         :
     1024           assign
     1025             v-object-handle = buf_temp-diasize-handle.handle-value
     1026           .
     1027           if v-object-handle <> v-diasize-resize-button
     1028           then do:
     1029             assign
     1030               v-object-handle :col = v-object-handle :col + p-change-value
     1031               no-error .
     1032             if error-status :error
     1033             or error-status :get-message(1) <> ""
     1034             then do:
     1035               undo move_block, retry move_block .
     1036             end.
     1037           end.
     1038         end.
     1039       end.
     1040       else do:
     1041         for each buf_temp-diasize-handle
     1042         on error undo move_block, retry move_block
     1043         :
     1044           assign
     1045             v-object-handle = buf_temp-diasize-handle.handle-value
     1046           .
     1047           if v-object-handle <> v-diasize-resize-button
     1048           then do:
     1049             assign
     1050               v-object-handle :col = v-object-handle :col + p-change-value
     1051               no-error .
     1052             if error-status :error
     1053             or error-status :get-message(1) <> ""
     1054             then do:
     1055               undo move_block, retry move_block .
     1056             end.
     1057           end.
     1058         end.
     1059         for each buf_temp-browse-handle
     1060           where buf_temp-browse-handle.browse-type = 'width':u
     1061         on error undo move_block, retry move_block
     1062         :
     1063           assign
     1064             buf_temp-browse-handle.browse-handle :width
     1065               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1066             no-error .
     1067           if error-status :error
     1068           or error-status :get-message(1) <> ""
     1069           then do:
     1070             undo move_block, retry move_block .
     1071           end.
     1072         end.
     1073         assign
     1074           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1075           no-error .
     1076         if error-status :error
     1077         or error-status :get-message(1) <> ""
     1078         then do:
     1079           undo move_block, retry move_block.
     1080         end.
     1081         assign
     1082           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1083         no-error .
     1084         if error-status :error
     1085         or error-status :get-message(1) <> ""
     1086         then do:
     1087           undo move_block, retry move_block.
     1088         end.
     1089         if frame Dialog-Frame :scrollable = true
     1090         then do:
     1091           assign
     1092             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1093           no-error .
     1094           if error-status :error
     1095           or error-status :get-message(1) <> ""
     1096           then do:
     1097             undo move_block, retry move_block.
     1098           end.
     1099         end.
     1100       end.
     1101       if p-move-resize
     1102       then do:
     1103         run diasize_position-resize-button in this-procedure .
     1104       end.
     1105       if v-diasize-wndstore = true
     1106       then do:
     1107         if connected("ub") = true
     1108         then do:
     1109           define variable v-cntxt-db-num        as integer   no-undo .
     1110           define variable v-cntxt-userid        as character no-undo .
     1111           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1112                                             , OUTPUT v-cntxt-userid
     1113                                             ) .
     1114           run gbl/wndsizew.p
     1115             (input  v-cntxt-db-num
     1116             ,input  v-cntxt-userid
     1117             ,input  v-diasize-proc-name
     1118             ,input  'width':u
     1119             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1120             ) .
     1121         end.
     1122       end.
     1123     end.
     1124     assign
     1125       v-diasize-change-size = false
     1126     .
     1127   end procedure.
     1128   procedure diasize_set-width :
     1129     define input  parameter p-new-width  as decimal   no-undo .
     1130     define input  parameter p-move-resize as logical   no-undo .
     1131     do
     1132     on error undo, return error return-value
     1133     :
     1134       run diasize_change-width in this-procedure
     1135         (input  (p-new-width - frame Dialog-Frame :width)
     1136         ,input  p-move-resize
     1137         ) .
     1138     end.
     1139   end procedure.
     1140   procedure diasize_position-resize-button :
     1141     do with frame Dialog-Frame
     1142     :
     1143       hide v-diasize-resize-button .
     1144       assign
     1145         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1146                     - 1
     1147                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1148         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1149                     - 1
     1150                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1151       .
     1152       view v-diasize-resize-button .
     1153     end.
     1154   end procedure.
     1155   on alt-right anywhere
     1156   do:
     1157     run diasize_change-width in this-procedure
     1158       (input 1
     1159       ,input true
     1160       ) .
     1161     return no-apply .
     1162   end.
     1163   on alt-left anywhere
     1164   do:
     1165     run diasize_change-width in this-procedure
     1166       (input -1
     1167       ,input true
     1168       ) .
     1169     return no-apply .
     1170   end.
     1171   on alt-down anywhere
     1172   do:
     1173     run diasize_change-height in this-procedure
     1174       (input 1
     1175       ,input true
     1176       ) .
     1177     return no-apply .
     1178   end.
     1179   on alt-up anywhere
     1180   do:
     1181     run diasize_change-height in this-procedure
     1182       (input -1
     1183       ,input true
     1184       ) .
     1185     return no-apply .
     1186   end.
     1187   on alt-enter of frame Dialog-Frame
     1188   do:
     1189     run diasize_maximize in this-procedure
     1190       (input  ?
     1191       ).
     1192     return no-apply .
     1193   end.
     1194   procedure diasize_end-move :
     1195     do
     1196     on error undo, return error return-value
     1197     :
     1198       define variable v-row-delta as decimal   no-undo .
     1199       define variable v-col-delta as decimal   no-undo .
     1200       define variable v-new-row as decimal   no-undo .
     1201       define variable v-new-col as decimal   no-undo .
     1202       assign
     1203         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1204         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1205       .
     1206       assign
     1207         v-row-delta = v-new-row - frame Dialog-Frame :height
     1208         v-col-delta = v-new-col - frame Dialog-Frame :width
     1209       .
     1210       run diasize_change-height in this-procedure
     1211         (input v-row-delta
     1212         ,input true
     1213         ) .
     1214       run diasize_change-width in this-procedure
     1215         (input v-col-delta
     1216         ,input true
     1217         ) .
     1218     end.
     1219   end procedure.
     1220   procedure diasize_maximize :
     1221     define input  parameter p-action as logical   no-undo .
     1222     do
     1223     on error undo, return error return-value
     1224     :
     1225       if p-action = ?
     1226       then do:
     1227         if v-diasize-need-maximize = true
     1228         then do:
     1229           assign
     1230             p-action = true
     1231           .
     1232         end.
     1233         else do:
     1234           assign
     1235             p-action = false
     1236           .
     1237         end.
     1238       end.
     1239       if p-action = true
     1240       then do:
     1241         run diasize_change-height in this-procedure
     1242           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1243               - frame Dialog-Frame :height-chars
     1244           ,input true
     1245           ) .
     1246         run diasize_change-width in this-procedure
     1247           (input session :width-chars
     1248               - frame Dialog-Frame :width-chars
     1249           ,input true
     1250           ) .
     1251         assign
     1252           v-diasize-need-maximize = false
     1253         .
     1254       end.
     1255       else do:
     1256         run diasize_change-width in this-procedure
     1257           (input v-diasize-orig-frame-width
     1258               - frame Dialog-Frame :width-chars
     1259           ,input true
     1260           ) .
     1261         run diasize_change-height in this-procedure
     1262           (input v-diasize-orig-frame-height
     1263               - frame Dialog-Frame :height-chars
     1264           ,input true
     1265           ) .
     1266         assign
     1267           v-diasize-need-maximize = true
     1268         .
     1269       end.
     1270     end.
     1271   end procedure.
     1272   procedure diasize_restore-orig-size :
     1273     do
     1274     on error undo, return error return-value
     1275     :
     1276       assign
     1277         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1278         v-diasize-current-frame-height = frame Dialog-Frame :height
     1279       .
     1280       run diasize_set-height in this-procedure
     1281         (input  v-diasize-orig-frame-height
     1282         ,input  true
     1283         ) .
     1284       run diasize_set-width in this-procedure
     1285         (input  v-diasize-orig-frame-width
     1286         ,input  true
     1287         ) .
     1288     end.
     1289   end procedure.
     1290   procedure diasize_restore-current-size :
     1291     do
     1292     on error undo, return error return-value
     1293     :
     1294       run diasize_set-height in this-procedure
     1295         (input  v-diasize-current-frame-height
     1296         ,input  true
     1297         ) .
     1298       run diasize_set-width in this-procedure
     1299         (input  v-diasize-current-frame-width
     1300         ,input  true
     1301         ) .
     1302     end.
     1303   end procedure.
     1304   procedure diasize_set-browse-handle :
     1305     define input  parameter p-browse-handle as handle   no-undo .
     1306     define buffer buf_temp-browse-handle for temp-browse-handle .
     1307     do
     1308     on error undo, return error return-value
     1309     :
     1310       assign
     1311         v-diasize-browse-handle = p-browse-handle
     1312       .
     1313       for each buf_temp-browse-handle
     1314       on error undo, return error return-value
     1315       :
     1316         delete buf_temp-browse-handle .
     1317       end.
     1318     end.
     1319   end procedure.
     1320   procedure diasize_add_browse :
     1321     define input  parameter p-browse-type   as character no-undo .
     1322     define input  parameter p-browse-handle as handle    no-undo .
     1323     define buffer buf_temp-browse-handle for temp-browse-handle .
     1324     do
     1325     on error undo, return error return-value
     1326     :
     1327       assign
     1328         v-diasize-browse-number = v-diasize-browse-number + 1
     1329       .
     1330       create buf_temp-browse-handle .
     1331       assign
     1332         buf_temp-browse-handle.browse-type   = p-browse-type
     1333         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1334         buf_temp-browse-handle.browse-handle = p-browse-handle
     1335       .
     1336     end.
     1337   end procedure.
     1338   procedure diasize_init :
     1339     define variable v-default-value    as logical   no-undo .
     1340     define variable v-restore-saved    as logical   no-undo .
     1341     define variable v-resize-value-str as character no-undo .
     1342     do
     1343     on error undo, return error return-value
     1344     :
     1345       do with frame Dialog-Frame
     1346       :
     1347         assign
     1348           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1349           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1350           v-diasize-browse-handle     = browse BROWSE-2 :handle
     1351         .
     1352         create button v-diasize-resize-button
     1353         assign
     1354           parent        = frame Dialog-Frame :first-child
     1355           label         = "s"
     1356           height-pixels = 16
     1357           width-pixels  = 16
     1358           visible       = true
     1359           sensitive     = true
     1360           movable       = true
     1361           triggers:
     1362             on end-move persistent run diasize_end-move in this-procedure .
     1363           end triggers.
     1364         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1365         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1366         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1367         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1368         assign
     1369           v-diasize-wndmax = false
     1370         .
     1371         if connected("ub") = true
     1372         then do:
     1373           define variable v-cntxt-db-num        as integer   no-undo .
     1374           define variable v-cntxt-userid        as character no-undo .
     1375           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1376                                             , OUTPUT v-cntxt-userid
     1377                                             ) .
     1378           run gbl/wndpar_r.p
     1379             (input  v-cntxt-db-num
     1380             ,input  v-cntxt-userid
     1381             ,input  'wndmax':U
     1382             ,output v-diasize-wndmax
     1383             ,output v-default-value
     1384             ) .
     1385         end.
     1386         assign
     1387           v-diasize-wndstore = false
     1388         .
     1389         if connected("ub") = true
     1390         then do:
     1391           run gbl/wndpar_r.p
     1392             (input  v-cntxt-db-num
     1393             ,input  v-cntxt-userid
     1394             ,input  'wndstore':U
     1395             ,output v-diasize-wndstore
     1396             ,output v-default-value
     1397             ) .
     1398         end.
     1399         assign
     1400           v-diasize-proc-name = entry(1, program-name(2), '.')
     1401         .
     1402         if v-diasize-wndstore = true
     1403         then do:
     1404           assign
     1405             v-restore-saved = false
     1406           .
     1407           if connected("ub") = true
     1408           then do:
     1409             run gbl/wndsizer.p
     1410               (input  v-cntxt-db-num
     1411               ,input  v-cntxt-userid
     1412               ,input  v-diasize-proc-name
     1413               ,input  'height':u
     1414               ,output v-resize-value-str
     1415               ) .
     1416             if v-resize-value-str <> '':U
     1417             then do:
     1418               run diasize_change-height in this-procedure
     1419                 (input  integer(v-resize-value-str)
     1420                 ,input  true
     1421                 ) .
     1422               assign
     1423                 v-restore-saved = true
     1424               .
     1425             end.
     1426           end.
     1427           if connected("ub") = true
     1428           then do:
     1429             run gbl/wndsizer.p
     1430               (input  v-cntxt-db-num
     1431               ,input  v-cntxt-userid
     1432               ,input  v-diasize-proc-name
     1433               ,input  'width':u
     1434               ,output v-resize-value-str
     1435               ) .
     1436             if v-resize-value-str <> '':U
     1437             then do:
     1438               run diasize_change-width in this-procedure
     1439                 (input  integer(v-resize-value-str)
     1440                 ,input  true
     1441                 ) .
     1442               assign
     1443                 v-restore-saved = true
     1444               .
     1445             end.
     1446           end.
     1447           if v-restore-saved <> true
     1448           then do:
     1449             if v-diasize-wndmax = true
     1450             then do:
     1451               run diasize_maximize in this-procedure
     1452                 (input  true
     1453                 ) .
     1454             end.
     1455           end.
     1456         end.
     1457         else do:
     1458           if v-diasize-wndmax = true
     1459           then do:
     1460             run diasize_maximize in this-procedure
     1461               (input  true
     1462               ) .
     1463           end.
     1464         end.
     1465       end.
     1466     end.
     1467   end procedure.
     1468   procedure diasize_need-full-display :
     1469     define output parameter p-need-full-display as logical   no-undo .
     1470     do
     1471     on error undo, return error return-value
     1472     :
     1473       assign
     1474         p-need-full-display = v-diasize-need-full-display
     1475       .
     1476       assign
     1477         v-diasize-need-full-display = false
     1478       .
     1479     end.
     1480   end procedure.
     1481   procedure get-context :
     1482      define output parameter p-db-num as integer          no-undo.
     1483      define output parameter p-user-id as character        no-undo.
     1484      define variable v-login               as character    no-undo.
     1485      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1486      define buffer buf_user-login  for ub.user-login .
     1487      do
     1488      on error undo, return error
     1489      :
     1490            FIND FIRST buf_sys-ctrl no-lock.
     1491            ASSIGN
     1492               v-login = USERID("ub")
     1493               p-db-num = buf_sys-ctrl.db-num
     1494            .
     1495            FIND FIRST buf_user-login
     1496                 WHERE buf_user-login.db-num = p-db-num
     1497                   AND buf_user-login.user-login = v-login
     1498                 no-lock
     1499                 no-error
     1500                 .
     1501            IF AVAILABLE buf_user-login
     1502            THEN DO:
     1503               assign
     1504                  p-user-id = buf_user-login.user-id
     1505               .
     1506            END.
     1507      end.
     1508   end procedure.
     1509       run diasize_init in this-procedure .
     1510   MAIN-BLOCK:
     1511   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1512      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1513   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1514     run mainmenu_getcntxt in parparentproc
     1515       (output v-cntxt-db-num
     1516       ,output v-cntxt-userid
     1517       ,output v-cntxt-level
     1518       ,output v-cntxt-host-code-obj
     1519       ,output v-cntxt-obj-type
     1520       ,output v-cntxt-obj-code
     1521       ,output v-cntxt-db-num-obj
     1522       ,output v-cntxt-is-admin
     1523       ) .
     1524     run fill-tt-goods in this-procedure.
     1525     RUN enable_UI.
     1526     WAIT-FOR GO OF FRAME Dialog-Frame.
     1527   END.
     1528   RUN disable_UI.
     1529   PROCEDURE create-actn-gds :
     1530   define input parameter p-ref-list as character        no-undo.
     1531   define variable v-count as integer no-undo .
     1532   define buffer buf_goods                   for ub.goods .
     1533   define buffer bf_tt-goods                 for tt-goods .
     1534   define buffer buf_action-role-item-gds    for ub.action-role-item-gds .
     1535   do
     1536   on error undo, return error
     1537   :
     1538      _add-goods:
     1539      DO v-count = 1 TO NUM-ENTRIES(p-ref-list)
     1540      on error undo, next
     1541      :
     1542         find first buf_goods
     1543              where recid( buf_goods ) = INTEGER(ENTRY(v-count, p-ref-list))
     1544              NO-LOCK
     1545              no-error
     1546              .
     1547         IF NOT AVAILABLE buf_goods
     1548         THEN NEXT _add-goods.
     1549         find first bf_tt-goods
     1550              where bf_tt-goods.gds-code = buf_goods.gds-code
     1551              no-lock
     1552              no-error
     1553              .
     1554         IF NOT AVAILABLE bf_tt-goods THEN DO:
     1555            create bf_tt-goods.
     1556            buffer-copy buf_goods to bf_tt-goods .
     1557         END.
     1558      end.
     1559   end.
     1560   END PROCEDURE.
     1561   PROCEDURE delete-actn-gds :
     1562   define input parameter p-gds-code as integer        no-undo.
     1563   define buffer buf_action-role-item-gds    for ub.action-role-item-gds .
     1564   do
     1565   on error undo, return error
     1566   :
     1567   end.
     1568   END PROCEDURE.
     1569   PROCEDURE disable_UI :
     1570     HIDE FRAME Dialog-Frame.
     1571   END PROCEDURE.
     1572   PROCEDURE enable_UI :
     1573     ENABLE b-exit b-quit b-add b-del b-help BROWSE-2
     1574         WITH FRAME Dialog-Frame.
     1575     VIEW FRAME Dialog-Frame.
     1576     OPEN QUERY BROWSE-2 FOR EACH buf_tt-goods.
     1577   END PROCEDURE.
     1578   PROCEDURE fill-tt-goods :
     1579   define buffer buf_goods                   for ub.goods .
     1580   define buffer buf_action-role-item-gds    for ub.action-role-item-gds .
     1581   define variable v-count    as integer      no-undo.
     1582   do
     1583   on error undo, return error
     1584   :
     1585      IF p-gds-list = "":U
     1586      THEN DO:
     1587         FOR EACH  buf_action-role-item-gds
     1588             where buf_action-role-item-gds.db-num           = v-cntxt-db-num
     1589               AND buf_action-role-item-gds.action-head-code = p-head-code
     1590               AND buf_action-role-item-gds.action-role-code = p-role-code
     1591               AND buf_action-role-item-gds.action-item-code = p-item-code
     1592            no-lock
     1593            :
     1594            FIND first buf_goods
     1595                 where buf_goods.gds-code = buf_action-role-item-gds.gds-code
     1596                 no-lock
     1597                 no-error
     1598                 .
     1599            create tt-goods.
     1600            buffer-copy buf_goods to tt-goods .
     1601         END.
     1602      END.
     1603      ELSE DO:
     1604         DO v-count = 1 TO NUM-ENTRIES(p-Gds-List, chr(4))
     1605         on error undo, next
     1606         :
     1607               FIND first buf_goods
     1608               where buf_goods.gds-code = INTEGER(ENTRY(v-count, p-Gds-List, chr(4)))
     1609               no-lock
     1610               no-error
     1611               .
     1612               IF AVAILABLE buf_goods THEN DO:
     1613                  create tt-goods.
     1614                  buffer-copy buf_goods to tt-goods .
     1615               END.
     1616         END.
     1617      END.
     1618   end.
     1619   END PROCEDURE.
