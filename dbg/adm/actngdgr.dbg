        3   define input parameter  p-role-code   as integer       no-undo .
        4   define input parameter  p-item-code   as integer       no-undo .
        5   define INPUT-output parameter p-gds-list  as character     no-undo .
        6   define output parameter p-ok          as logical       no-undo .
