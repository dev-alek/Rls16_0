     4303           "where ":u +  substitute('(X_ext-file.file-num < 2147483647                           and X_ext-file.obj-type = &2&2 AND X_ext-file.obj-code = 0 AND X_ext-file.FILE-TYPE = X_EXT-FILE.FILE-NAME                           and X_ext-file.db-num = &1 and X_ext-file.status_ = &2&3&2)', p-db-num , chr(34), p-status_)  + " ":u + where-phrase-38 + " ":u + p-find-condition + " " + ""
     4304         parameter-5-38 = "  "
     4305       .
     4306         run fltopend_fltfindd in this-procedure  (
     4307                             input this-procedure:handle
     4308                             ,input query br-ipck:handle
     4309                             ,input rowid(X_ext-file)
     4310                             ,input logical(parameter-2-38)
     4311                             ,input no-lock
