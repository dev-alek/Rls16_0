      362     run proc-alt-shift-f3 in this-procedure .
      363   end.
      364   on alt-shift-f4 anywhere do:
      365     run proc-alt-shift-f4 in this-procedure.
      366   end.
      367   on alt-f1 anywhere do:
      368     run proc-alt-f1 in this-procedure .
      369   end.
      370   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      371   FUNCTION mark-string RETURNS CHARACTER
      372     ( input p-recid as recid, input mark-list as character  ) :
      373     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      374   END FUNCTION.
      375   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      376   define variable c-point  as character no-undo .
      377   define variable tbl      as character no-undo .
      378   define variable join-tbl as character no-undo .
      379   define variable fld      as character no-undo .
      380   define variable lab      as character no-undo .
      381   define variable spr      as character no-undo .
      382   define variable dim      as character no-undo .
      383   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      384   procedure fltfield-clear :
      385     define output parameter loc-fld as character no-undo.
      386     define output parameter loc-lab as character no-undo .
      387     define output parameter loc-spr as character no-undo .
      388     define output parameter loc-dim as character no-undo .
      389     assign
      390       loc-fld = ""
      391       loc-lab = ""
      392       loc-spr = ""
      393       loc-dim = "0"
      394     .
      395   end procedure .
      396   procedure fltfield-add :
      397     define input        parameter par-fld as character no-undo.
      398     define input        parameter par-lab as character no-undo .
      399     define input        parameter par-spr as character no-undo .
      400     define input-output parameter loc-fld as character no-undo.
      401     define input-output parameter loc-lab as character no-undo .
      402     define input-output parameter loc-spr as character no-undo .
      403     define input-output parameter loc-dim as character no-undo .
      404     do
      405     on error undo, return error
      406     :
      407       assign
      408       loc-fld = if loc-dim = '0'
      409                 then par-fld
      410                 else (loc-fld + chr(44) + par-fld)
      411       loc-lab = if loc-dim = '0'
      412                 then par-lab
      413                 else (loc-lab + chr(44) + par-lab)
      414       loc-spr = if loc-dim = '0'
      415                 then par-spr
      416                 else (loc-spr + chr(44) + par-spr)
      417       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      418                 string(integer(if num-entries(loc-dim) > 1
      419                               then entry(2, loc-dim)
      420                               else entry(1, loc-dim)
      421                               ) + 1)
      422       no-error
      423       .
      424     end.
      425   end procedure.
      426   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      427     define variable v-cntxt-db-num        as integer   no-undo .
      428     define variable v-cntxt-userid        as character no-undo .
      429     define variable v-cntxt-level         as character no-undo .
      430     define variable v-cntxt-host-code-obj as integer   no-undo .
      431     define variable v-cntxt-obj-type      as character no-undo .
      432     define variable v-cntxt-obj-code      as integer   no-undo .
      433     define variable v-cntxt-db-num-obj    as integer   no-undo .
      434     define variable v-cntxt-is-admin      as logical   no-undo .
      435   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      436   define NEW SHARED temp-table tt-ext-file-par no-undo like ub.ext-file-par.
      437   procedure ext-file-par-clear-temp :
      438     define buffer buf_tt-ext-file-par for tt-ext-file-par .
      439     do
      440     on error undo, return error return-value
      441     :
      442       for each buf_tt-ext-file-par
      443       on error undo, return error
      444       :
      445         delete buf_tt-ext-file-par .
      446       end.
      447     end.
      448   end procedure.
      449   procedure ext-file-par-write-temp :
      450     define input  parameter p-db-num      as integer no-undo .
      451     define input  parameter p-from-db-num      as integer no-undo .
      452     define input  parameter p-file-num      as integer no-undo .
      453     define input  parameter p-param-num      as integer no-undo .
      454     define input  parameter p-value-type as character no-undo .
      455     define input  parameter p-value-name as character no-undo .
      456     define input  parameter p-value-char as character no-undo .
      457     define input  parameter p-value-date as date      no-undo .
      458     define input  parameter p-value-integer as integer      no-undo .
      459     define input  parameter p-value-decimal as decimal      no-undo .
      460     define input  parameter p-value-logical as logical      no-undo .
      461     define buffer buf_tt-ext-file-par for tt-ext-file-par .
      462     do
      463     on error undo, return error return-value
      464     :
      465       find first buf_tt-ext-file-par
      466         where buf_tt-ext-file-par.db-num        = p-db-num
      467           and buf_tt-ext-file-par.file-num      = p-file-num
      468           and buf_tt-ext-file-par.from-db-num   = p-from-db-num
      469           and buf_tt-ext-file-par.param-type    = p-value-type
      470           and buf_tt-ext-file-par.param-name    = p-value-name
      471         no-error .
      472       if not available buf_tt-ext-file-par then do:
      473         create buf_tt-ext-file-par .
      474         assign
      475           buf_tt-ext-file-par.db-num         = p-db-num
      476           buf_tt-ext-file-par.from-db-num    = p-from-db-num
      477           buf_tt-ext-file-par.file-num       = p-file-num
      478           buf_tt-ext-file-par.param-num      = p-param-num
      479           buf_tt-ext-file-par.param-type     = p-value-type
      480           buf_tt-ext-file-par.user-db-num    = p-db-num
      481                 .
      482       end.
      483       CASE p-value-type:
      484         when 'C':U
      485         or when 'uniq-key-rec':U
      486         then do:
      487           assign
      488           buf_tt-ext-file-par.param-name = p-value-name
      489           buf_tt-ext-file-par.param-value = p-value-char
      490           .
      491         end.
      492         when 'T':U then do:
      493           assign
      494           buf_tt-ext-file-par.param-date-name = p-value-name
      495           buf_tt-ext-file-par.param-date-value = p-value-date
      496           .
      497         end.
      498         when 'I':U then do:
      499           assign
      500           buf_tt-ext-file-par.param-int-name = p-value-name
      501           buf_tt-ext-file-par.param-int-value = p-value-integer
      502           .
      503         end.
      504         when 'L':U then do:
      505           assign
      506           buf_tt-ext-file-par.param-log-name = p-value-name
      507           buf_tt-ext-file-par.param-log-value = p-value-logical
      508           .
      509         end.
      510         when 'D':U then do:
      511           assign
      512           buf_tt-ext-file-par.param-decimal-name = p-value-name
      513           buf_tt-ext-file-par.param-decimal-value = p-value-decimal
      514           .
      515         end.
      516       END CASE.
      517     end.
      518   end procedure.
      519   procedure ext-file-par-write-and-send :
      520     define input  parameter p-db-num      as integer no-undo .
      521     define input  parameter p-from-db-num      as integer no-undo .
      522     define input  parameter p-file-num      as integer no-undo .
      523     define input  parameter p-param-num      as integer no-undo .
      524     define input  parameter p-value-type as character no-undo .
      525     define input  parameter p-value-name as character no-undo .
      526     define input  parameter p-value-char as character no-undo .
      527     define input  parameter p-value-date as date      no-undo .
      528     define input  parameter p-value-integer as integer      no-undo .
      529     define input  parameter p-value-decimal as decimal      no-undo .
      530     define input  parameter p-value-logical as logical      no-undo .
      531     define input  parameter p-send        as logical no-undo .
      532     define input  parameter p-list-db-num as character no-undo .
      533     define buffer buf_ext-file-par for ub.ext-file-par .
      534     do
      535     on error undo, return error return-value
      536     :
      537       find first buf_ext-file-par
      538         where buf_ext-file-par.db-num         = p-db-num
      539           and buf_ext-file-par.from-db-num    = p-from-db-num
      540           and buf_ext-file-par.file-num       = p-file-num
      541           and buf_ext-file-par.param-num      = p-param-num
      542         no-error .
      543       if not available buf_ext-file-par then do:
      544         create buf_ext-file-par .
      545         assign
      546           buf_ext-file-par.db-num    = p-db-num
      547           buf_ext-file-par.from-db-num    = p-from-db-num
      548           buf_ext-file-par.file-num    = p-file-num
      549           buf_ext-file-par.param-num    = p-param-num
      550           buf_ext-file-par.param-type   = p-value-type
      551           buf_ext-file-par.user-db-num    = p-db-num
      552         .
      553       end.
      554       CASE p-value-type:
      555         when 'C':U
      556         or when ''
      557         or when 'uniq-key-rec':U
      558         then do:
      559           assign
      560           buf_ext-file-par.param-name = p-value-name
      561           buf_ext-file-par.param-value = p-value-char
      562           .
      563           if p-value-type = ''
      564           and p-param-num = 0 then do:
      565             buf_ext-file-par.param-log-value = p-value-logical.
      566           end.
      567         end.
      568         when 'T':U then do:
      569           assign
      570           buf_ext-file-par.param-date-name = p-value-name
      571           buf_ext-file-par.param-date-value = p-value-date
      572           .
      573         end.
      574         when 'I':U then do:
      575           assign
      576           buf_ext-file-par.param-int-name = p-value-name
      577           buf_ext-file-par.param-int-value = p-value-integer
      578           .
      579         end.
      580         when 'D':U then do:
      581           assign
      582           buf_ext-file-par.param-decimal-name = p-value-name
      583           buf_ext-file-par.param-decimal-value = p-value-decimal
      584           .
      585         end.
      586         when 'L':U then do:
      587           assign
      588           buf_ext-file-par.param-log-name = p-value-name
      589           buf_ext-file-par.param-log-value = p-value-logical
      590           .
      591         end.
      592       END CASE.
      593       if p-send then do:
      594         run nws/cr-route.p (
      595                         input 'send-tbl':U
      596                       , input 'ext-file-par':U
      597                       , input buffer buf_ext-file-par:handle
      598                       , input p-list-db-num) no-error.
      599       end.
      600     end.
      601   end procedure.
      602   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      603   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      604   procedure fltopend_fltopend :
      605   define input parameter p-parent-handle as handle no-undo .
      606   define input parameter p-qh as handle no-undo .
      607   define input parameter p-flt-open-open-query  as character no-undo .
      608   define input parameter p-where-cond as character no-undo .
      609   define input parameter p-use-indFIRST-query-tail as character no-undo .
      610   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      611   define input parameter p-indexed-reposition as character no-undo .
      612     do
      613     on error undo, return error
      614     :
      615   define variable v-prepare-string as character no-undo .
      616   define variable glog as logical no-undo .
      617   assign
      618   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      619                      p-where-cond + chr(32)  +
      620                      p-use-indFIRST-query-tail + chr(32) +
      621                      p-use-ind-sort-clmn-by + chr(32) +
      622                      p-indexed-reposition
      623   .
      624   assign
      625   glog = p-qh:query-prepare(v-prepare-string) no-error .
      626   if not glog
      627   or error-status:error then do:
      628     message error-status:get-message(1) view-as alert-box .
      629     undo, return error .
      630   end.
      631   assign
      632   glog = p-qh:query-open no-error .
      633   if not glog
      634   or error-status:error then do:
      635     message error-status:get-message(1) view-as alert-box .
      636     undo, return error .
      637   end.
      638     end.
      639   end procedure.
      640   procedure fltopend_fltfindd :
      641   define input parameter p-parent-handle as handle no-undo .
      642   define input parameter p-qh as handle no-undo .
      643   define input parameter p-rowid as rowid no-undo .
      644   define input parameter p-next as logical no-undo .
      645   define input parameter p-lock as integer no-undo .
      646   define input parameter p-bh as handle no-undo .
      647   define input parameter p-where-cond as character no-undo .
      648   define input parameter p-use-index-phrase as character no-undo .
      649   define variable glog as logical no-undo .
      650   define variable v-qh as handle no-undo .
      651   define variable v-bh as handle no-undo .
      652   define variable v-recid as recid no-undo .
      653   define variable v-prepare-string as character no-undo .
      654   do
      655   on error undo, return error
      656   on stop undo, return error
      657   :
      658     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      659     create buffer v-bh for table p-bh buffer-name p-bh:name.
      660     create query v-qh.
      661     v-qh:set-buffers(v-bh).
      662     v-prepare-string = substitute("for each &1 &2 &3"
      663                                     ,v-bh:name
      664                                     ,p-where-cond
      665                                     ,p-use-index-phrase).
      666     glog = v-qh:query-prepare(v-prepare-string) no-error.
      667     if not glog then do:
      668       delete object v-qh.
      669       delete object v-bh.
      670       undo, return error .
      671     end.
      672     glog = v-qh:query-open no-error .
      673     if not glog then do:
      674       delete object v-qh.
      675       delete object v-bh.
      676       undo, return error .
      677     end.
      678     if p-next then do:
      679       v-qh:reposition-to-rowid(p-rowid) no-error .
      680       glog = v-qh:get-next( p-lock) no-error .
      681       glog = v-qh:get-next( p-lock) no-error .
      682       if not glog or v-qh:query-off-end = yes then do:
      683         glog = v-qh:get-first( p-lock) no-error .
      684       end.
      685     end.
      686     else do:
      687       glog = v-qh:get-first( p-lock) no-error .
      688     end.
      689     v-recid = v-bh:recid no-error .
      690     delete object v-qh.
      691     delete object v-bh.
      692     return string(v-recid) .
      693   end.
      694   end procedure.
      695   procedure fltopend_fltfindq :
      696   define input parameter p-parent-handle as handle no-undo .
      697   define input parameter p-qh as handle no-undo .
      698   define input parameter p-next as logical no-undo .
      699   define input parameter p-lock as integer no-undo .
      700   define input parameter p-flt-open-open-query  as character no-undo .
      701   define input parameter p-where-cond as character no-undo .
      702   define input parameter p-use-indFIRST-query-tail as character no-undo .
      703   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      704   define input parameter p-indexed-reposition as character no-undo .
      705   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      706   define variable glog as logical no-undo .
      707   define variable v-qh as handle no-undo .
      708   define variable v-bh as handle no-undo extent 18.
      709   define variable v-rowid as rowid no-undo extent 18.
      710   define variable v-ii as integer no-undo .
      711   define variable v-prepare-string as character no-undo .
      712   do
      713   on error undo, return error
      714   on stop undo, return error
      715   :
      716     create query v-qh.
      717     do v-ii = 1 to p-qh:num-buffers:
      718       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      719       assign
      720       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      721       no-error.
      722       v-qh:add-buffer(v-bh[v-ii]).
      723     end.
      724     assign
      725     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      726                       p-where-cond + chr(32)  +
      727                       p-use-indFIRST-query-tail + chr(32) +
      728                       p-use-ind-sort-clmn-by + chr(32) +
      729                       p-indexed-reposition
      730     .
      731     glog = v-qh:query-prepare( v-prepare-string) no-error .
      732     if not glog then do:
      733       delete object v-qh.
      734       do v-ii = 1 to p-qh:num-buffers:
      735         delete object v-bh[v-ii].
      736       end.
      737       undo, return error .
      738     end.
      739     glog = v-qh:query-open no-error .
      740     if not glog then do:
      741       delete object v-qh.
      742       do v-ii = 1 to p-qh:num-buffers:
      743         delete object v-bh[v-ii].
      744       end.
      745       undo, return error .
      746     end.
      747     if p-next then do:
      748       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      749       glog = v-qh:get-next( p-lock) no-error .
      750       glog = v-qh:get-next( p-lock) no-error .
      751       if not glog or v-qh:query-off-end = yes then do:
      752         glog = v-qh:get-first( p-lock) no-error .
      753       end.
      754     end.
      755     else do:
      756       glog = v-qh:get-first( p-lock) no-error .
      757     end.
      758     do v-ii = 1 to p-qh:num-buffers:
      759       assign
      760       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      761       no-error.
      762     end.
      763     delete object v-qh.
      764     do v-ii = 1 to p-qh:num-buffers:
      765       delete object v-bh[v-ii].
      766     end.
      767   end.
      768   end procedure.
      769   DEFINE VARIABLE add-option AS CHARACTER NO-UNDO.
      770   DEFINE VARIABLE del-option AS CHARACTER NO-UNDO.
      771   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      772   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
      773   define variable sort-column-name as character no-undo .
      774   define variable filter-point-name as character no-undo .
      775   define variable filter-point as character no-undo init "ipckwork" .
      776   define variable filter-point0 as character no-undo init "ipckwork" .
      777   DEFINE MENU MENU-B-add
      778          MENU-ITEM m_auto         LABEL "Отослать и зарегистрировать"
      779          MENU-ITEM m_manual       LABEL "Зарегистрировать".
      780   DEFINE BUTTON B-add
      781        LABEL "&Добавить"
      782        SIZE 10 BY 1.
      783   DEFINE BUTTON b-check
      784        LABEL "&Проверка"
      785        SIZE 10 BY 1.
      786   DEFINE BUTTON B-del
      787        LABEL "&Удалить"
      788        SIZE 10 BY 1.
      789   DEFINE BUTTON B-Help
      790        LABEL "Помо&щь"
      791        SIZE 3 BY 1
      792        BGCOLOR 8 .
      793   DEFINE BUTTON b-install
      794        LABEL "&Установить"
      795        SIZE 10 BY 1.
      796   DEFINE BUTTON b-lkp
      797        LABEL "&Просмотр"
      798        SIZE 10 BY 1 TOOLTIP "Сохранить на диск".
      799   DEFINE BUTTON b-mark
      800        LABEL "&*"
      801        SIZE 4 BY 1.
      802   DEFINE BUTTON b-output-params
      803        LABEL "&Рез.вып."
      804        SIZE 10 BY 1.
      805   DEFINE BUTTON b-params
      806        LABEL "Пар-тры"
      807        SIZE 10 BY 1.
      808   DEFINE BUTTON b-quit AUTO-END-KEY
      809        LABEL "&Выход"
      810        SIZE 10 BY 1
      811        BGCOLOR 8 .
      812   DEFINE BUTTON b-save
      813        LABEL "&Сохр."
      814        SIZE 10 BY 1 TOOLTIP "Сохранить на диск".
      815   DEFINE BUTTON b-sch
      816        LABEL "&Фильтр"
      817        SIZE 3 BY 1.
      818   DEFINE VARIABLE mark-num AS INTEGER FORMAT ">,>>>,>>9":U INITIAL 0
      819         VIEW-AS TEXT
      820        SIZE 10.5 BY .67
      821        FGCOLOR 10  NO-UNDO.
      822   DEFINE QUERY br-ipck FOR
      823         X_ext-file SCROLLING.
      824   DEFINE BROWSE br-ipck
      825     QUERY br-ipck NO-LOCK DISPLAY
      826         mark-string ( input recid(x_ext-file), input v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
      827       WIDTH 2
      828   X_ext-file.file-name COLUMN-LABEL "Файл манифеста" FORMAT "X(255)":U WIDTH 40
      829   X_ext-file.db-num column-label 'Для БД' FORMAT "->>>>9":U
      830   X_ext-file.STATUS_ FORMAT "X(12)":U
      831   X_ext-file.update-sys-date COLUMN-LABEL "Дата устан.!/регистр." FORMAT "99/99/9999":U
      832   X_ext-file.update-sys-time COLUMN-LABEL "Время устан.!/регистр." FORMAT "X(8)":U
      833   X_ext-file.update-user-name COLUMN-LABEL "Установил!/Зарегистр." FORMAT "X(12)":U
      834   X_ext-file.file-num COLUMN-LABEL "№ файла" FORMAT "->>>>>>>>9":U
      835   X_ext-file.from-db-num COLUMN-LABEL "Из Бд" FORMAT ">>>>>>>>9":U
      836   X_ext-file.file-size COLUMN-LABEL "Размер" FORMAT ">>>>>>>>9":U
      837   X_ext-file.create-sys-time COLUMN-LABEL "Дата файла" FORMAT "X(5)":U
      838   X_ext-file.create-sys-date COLUMN-LABEL "Время файла" FORMAT "99/99/9999":U
      839   ENABLE
      840   X_ext-file.update-user-name
      841       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 16
      842            TITLE "" FIT-LAST-COLUMN.
      843   DEFINE FRAME Dialog-Frame
      844        b-quit AT ROW 1 COL 1
      845        b-mark AT ROW 1 COL 17
      846        B-add AT ROW 1 COL 21
      847        B-del AT ROW 1 COL 31
      848        b-check AT ROW 1 COL 41
      849        b-params AT ROW 1 COL 41
      850        b-install AT ROW 1 COL 51
      851        b-output-params AT ROW 1 COL 51
      852        b-save AT ROW 1 COL 61
      853        b-lkp AT ROW 1 COL 71 WIDGET-ID 2
      854        b-sch AT ROW 1 COL 92
      855        B-Help AT ROW 1 COL 95
      856        br-ipck AT ROW 3 COL 1
      857        mark-num AT ROW 2 COL 2 NO-LABEL
      858        SPACE(86.74) SKIP(16.99)
      859       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      860            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      861            TITLE "Зарегистрированные пакеты обновлений"
      862            CANCEL-BUTTON b-quit.
      863   ASSIGN
      864          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      865          FRAME Dialog-Frame:HIDDEN           = TRUE.
      866   ASSIGN
      867          B-add:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-add:HANDLE.
      868   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      869   DO:
      870     APPLY "END-ERROR":U TO SELF.
      871   END.
      872   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      873   DO:
      874     if add-option = '':U then do:
      875       run gbl/pop-up.p ( input self:handle, input no) no-error.
      876     end.
      877     if add-option = '':U then return no-apply.
      878     run proc-b-add in this-procedure (input add-option) no-error.
      879     if error-status:error then do:
      880       add-option = '':U.
      881       return no-apply.
      882     end.
      883     add-option = '':U.
      884     APPLY "ENTRY" to br-ipck.
      885   END.
      886   ON CHOOSE OF b-check IN FRAME Dialog-Frame
      887   DO:
      888   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
      889   DEFINE BUFFER buf_ext-file FOR ub.ext-file.
      890   _ii:
      891   DO ii = 1 TO NUM-ENTRIES(v-rid-list):
      892    FIND FIRST buf_Ext-file WHERE
      893              recid(buf_Ext-file) = INTEGER( ENTRY(ii, v-rid-list)) .
      894    IF LOOKUP( "ok", ENTRY(1, buf_ext-file.STATUS_, chr(4))) > 0 THEN DO:
      895        message
      896        substitute("Пакет обновлений &1 на БД &2 инсталлирован&3Отсылка запроса не производится"
      897                     ,buf_Ext-file.FILE-NAME
      898                     ,buf_Ext-file.db-num
      899                     ,chr(10)
      900                      )
      901        view-as ALERT-BOX WARNING .
      902        NEXT _ii.
      903    END.
      904    IF abs(buf_ext-file.db-num) = v-cntxt-db-num
      905    AND v-cntxt-db-num = 0 THEN DO:
      906        run adm/ipck-chk.p ( INPUT parparentproc
      907                             ,INPUT THIS-PROCEDURE:HANDLE
      908                             ,INPUT parparentproc
      909                             ,INPUT (string(buf_ext-file.db-num)
      910                                       + chr(4) + string(buf_ext-file.from-db-num)
      911                                       + chr(4) + buf_ext-file.FILE-NAME
      912                                       + chr(4) + 'query':U)) no-error.
      913       if error-status:error then do:
      914         message
      915         error-status:get-message(1) skip
      916         return-value view-as alert-box error.
      917       end.
      918    END.
      919    ELSE DO:
      920        run nws/cr-route.p (
      921                          input 'send-cmd':U
      922                         ,input ("command"
      923                                 + chr(1) + "run-file"
      924                                 + chr(1) + "ipck-chk.p"
      925                                 + chr(1) + (string(buf_ext-file.db-num)
      926                                 + chr(4) +  string(buf_ext-file.from-db-num)
      927                                 + chr(4) + buf_ext-file.FILE-NAME
      928                                 + chr(4) + 'query':U)  )
      929                         ,input ?
      930                         ,input string(abs(buf_ext-file.db-num))
      931                         ) no-error .
      932         if error-status:error then do:
      933           message
      934           substitute("Ошибка при отсылке запроса корректности зарегистрированного пакета&1&2"  +
      935                        "&3&3&4&2"
      936                        ,buf_Ext-file.FILE-NAME
      937                        , error-status:get-message(1)
      938                        , return-value )
      939           view-as alert-box error .
      940           NEXT _ii.
      941         end.
      942       END.
      943       DEFINE VARIABLE v-dop AS CHARACTER NO-UNDO.
      944       ASSIGN
      945       v-dop = entry(1, buf_Ext-file.STATUS_, chr(4))
      946       v-dop = REPLACE(v-dop, 'ready':U, "":U)
      947       v-dop = trim(v-dop, chr(44))
      948       v-dop = REPLACE(v-dop, chr(44) + chr(44), chr(44))
      949       v-dop = v-dop + chr(44) + chr(63)
      950       v-dop = trim(v-dop, chr(44)).
      951       ENTRY(1, buf_Ext-file.STATUS_, chr(4)) = v-dop.
      952     END.
      953     br-ipck:REFRESH().
      954   END.
      955   ON CHOOSE OF B-del IN FRAME Dialog-Frame
      956   DO:
      957     DEFINE VARIABLE del-option AS CHARACTER NO-UNDO.
      958     IF NOT AVAILABLE X_ext-file THEN RETURN NO-APPLY.
      959     IF LOOKUP('auto':U, X_ext-file.STATUS_) > 0 THEN do:
      960       del-option = 'auto':U.
      961     END.
      962     ELSE do:
      963       del-option = 'manual':U.
      964     END.
      965     run proc-b-del in this-procedure ( input del-option) no-error.
      966     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      967     APPLY "ENTRY" to br-ipck.
      968   END.
      969   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
      970   DO:
      971     IF NOT AVAILABLE X_ext-file THEN RETURN NO-APPLY.
      972     run proc-lkp IN THIS-PROCEDURE NO-ERROR.
      973     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      974   END.
      975   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      976   DO:
      977       define variable loc#log as logical no-undo .
      978       if available X_ext-file then do:
      979   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      980   define variable v-str-recid9 as character no-undo .
      981   define variable v-num-entry9 as integer   no-undo .
      982   assign
      983     v-str-recid9 = trim( string( recid( X_ext-file ) , "->>>>>>>>>>>9":U ) )
      984     v-num-entry9 = lookup( v-str-recid9 , v-rid-list )
      985   .
      986   if v-num-entry9 > 0 then do:
      987     assign
      988       entry( v-num-entry9, v-rid-list ) = "":U
      989       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      990     .
      991   end.
      992   else do:
      993     assign
      994       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid9
      995     .
      996   end.
      997         loc#log = br-ipck:refresh() .
      998         if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      999             loc#log = br-ipck:select-next-row ().
     1000             apply "VALUE-CHANGED" to br-ipck in frame Dialog-Frame.
     1001         end.
     1002         if num-entries( v-rid-list ) = 0
     1003         then
     1004             hide mark-num in frame Dialog-Frame.
     1005         else
     1006             DISPLAY
     1007              num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1008       end.
     1009       apply "entry" to br-ipck in frame Dialog-Frame.
     1010   END.
     1011   ON CHOOSE OF b-output-params IN FRAME Dialog-Frame
     1012   DO:
     1013     IF NOT AVAILABLE X_ext-file THEN RETURN NO-APPLY.
     1014     if NOT (ENTRY(1, X_ext-file.STATUS_, chr(4))  = 'save-disk-and-run':U
     1015             OR entry(1, X_ext-file.STATUS_, chr(4))  = 'save-db-and-run':U
     1016             OR X_ext-file.file-type begins ('cash-desk':U  + chr(3))
     1017             )
     1018             THEN DO:
     1019         MESSAGE
     1020         substitute("Просмотр результатов выполнения доступен только для файлов, переданных в режиме &1 и &2"
     1021                    , 'save-db-and-run':U
     1022                    , 'save-disk-and-run':U)
     1023         VIEW-AS ALERT-BOX.
     1024         RETURN NO-APPLY.
     1025     END.
     1026     run nws/sndfnwp.w ( INPUT parparentproc
     1027                     ,INPUT 'ПРОСМОТР':U
     1028                     ,INPUT "output"
     1029                     ,INPUT X_ext-file.db-num
     1030                     ,INPUT X_ext-file.from-db-num
     1031                     ,INPUT X_ext-file.file-num
     1032                     ).
     1033   END.
     1034   ON CHOOSE OF b-params IN FRAME Dialog-Frame
     1035   DO:
     1036     IF NOT AVAILABLE X_ext-file THEN RETURN NO-APPLY.
     1037     IF not (entry(1, X_ext-file.STATUS_, chr(4)) = 'save-disk-and-run':U
     1038     or      entry(1, X_ext-file.STATUS_, chr(4)) <> 'save-db-and-run':U
     1039     or X_ext-file.file-type begins ('cash-desk':U + chr(3) ))
     1040     THEN DO:
     1041        MESSAGE
     1042        substitute("Просмотр параметров доступен только для файлов, переданных в режиме &1 и &2"
     1043                   , 'save-db-and-run':U
     1044                   , 'save-disk-and-run':U)
     1045        VIEW-AS ALERT-BOX.
     1046        RETURN NO-APPLY.
     1047     END.
     1048     run nws/sndfnwp.w ( INPUT parparentproc
     1049                     ,INPUT 'ПРОСМОТР':U
     1050                     ,INPUT "input"
     1051                     ,INPUT X_ext-file.db-num
     1052                     ,INPUT X_ext-file.from-db-num
     1053                     ,INPUT X_ext-file.file-num).
     1054   END.
     1055   ON CHOOSE OF b-save IN FRAME Dialog-Frame
     1056   DO:
     1057     IF NOT AVAILABLE X_ext-file THEN RETURN NO-APPLY.
     1058     run proc-save-disk IN THIS-PROCEDURE NO-ERROR.
     1059     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1060   END.
     1061   ON CHOOSE OF b-sch IN FRAME Dialog-Frame
     1062   DO:
     1063     run proc-b-sch IN THIS-PROCEDURE NO-ERROR.
     1064     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1065   END.
     1066   ON VALUE-CHANGED OF br-ipck IN FRAME Dialog-Frame
     1067   DO:
     1068     IF NOT AVAILABLE X_ext-file then do:
     1069       DISABLE
     1070       b-output-params
     1071       b-params
     1072       WITH FRAME Dialog-Frame.
     1073     END.
     1074     ELSE DO:
     1075       ENABLE
     1076       b-output-params
     1077       b-params
     1078       WITH FRAME Dialog-Frame.
     1079     END.
     1080   END.
     1081   ON CHOOSE OF MENU-ITEM m_auto
     1082   DO:
     1083     ASSIGN
     1084     add-option = 'auto':U.
     1085     APPLY "CHOOSE" TO b-add in frame Dialog-Frame .
     1086   END.
     1087   ON CHOOSE OF MENU-ITEM m_manual
     1088   DO:
     1089       ASSIGN
     1090     add-option = 'manual':U.
     1091     APPLY "CHOOSE" TO b-add in frame Dialog-Frame .
     1092   END.
     1093   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1094   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1095   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1096   on help of frame Dialog-Frame
     1097   do:
     1098     run gbl/app_help.p
     1099       (input this-procedure :file-name
     1100       ,input ''
     1101       ,input ?
     1102       ) no-error.
     1103     if error-status :error then do:
     1104       message
     1105         "Ошибка при вызове помощи"
     1106         error-status :get-message(1)
     1107         view-as alert-box .
     1108     end.
     1109   end.
     1110   run minbtn-set in this-procedure .
     1111   on choose of b-help in frame Dialog-Frame
     1112   do:
     1113     apply "help":u to frame Dialog-Frame .
     1114   end.
     1115   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1116   procedure minbtn-set :
     1117       do
     1118           on error undo, return error return-value
     1119           :
     1120           define variable ii              as integer       no-undo .
     1121           define variable fh              as widget-handle no-undo .
     1122           define variable hh              as widget-handle no-undo .
     1123           define variable v-h             as handle        extent 4 no-undo .
     1124           define variable v-name-button   as character     no-undo .
     1125           define variable v-help-old-x    as decimal       no-undo .
     1126           define variable v-help-old-y    as decimal       no-undo .
     1127           define variable v-help-old-size as decimal       no-undo .
     1128           define variable v-frame-width   as decimal       no-undo .
     1129           define variable jj              as integer       no-undo .
     1130           do
     1131               on error undo, return error
     1132               :
     1133               assign
     1134                   v-frame-width = frame Dialog-Frame:width - 0.3
     1135                   fh            = frame Dialog-Frame:first-child
     1136                   hh            = fh:first-child
     1137                   ii            = 1
     1138                   .
     1139               do while valid-handle(hh):
     1140                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1141                   do:
     1142                       case lc(hh:name) :
     1143                           when "b-help" then
     1144                               do:
     1145                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1146                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1147                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1148                                   hh:TOOLTIP = "Помощь" .
     1149                                   v-help-old-x = hh:column .
     1150                                   v-help-old-y = hh:row    .
     1151                                   v-help-old-size = hh:width .
     1152                                   hh:width-chars = 2.5 .
     1153                               end.
     1154                           when "b-print" then
     1155                               do:
     1156                                   hh:load-image("cmp/b-print.bmp":u) .
     1157                                   hh:TOOLTIP = "Печать" .
     1158                                   v-h[ii] = hh:handle .
     1159                                   ii = ii + 1 .
     1160                                   hh:width-chars = 3 .
     1161                               end.
     1162                           when "b-history" or
     1163                           when "b-hist" then
     1164                               do:
     1165                                   hh:load-image("cmp/b-hist.bmp":u) .
     1166                                   hh:TOOLTIP = "История" .
     1167                                   v-h[ii] = hh:handle .
     1168                                   ii = ii + 1 .
     1169                                   hh:width-chars = 3 .
     1170                               end.
     1171                           when "b-sch" then
     1172                               do:
     1173                                   hh:load-image("cmp/b-sch.bmp":u) .
     1174                                   hh:TOOLTIP = "Установка Фильтра" .
     1175                                   v-h[ii] = hh:handle .
     1176                                   ii = ii + 1 .
     1177                                   hh:width-chars = 3 .
     1178                               end.
     1179                           when "b-hist-user" then
     1180                               do:
     1181                                   hh:load-image("cmp/b-hist.bmp":u) .
     1182                                   hh:TOOLTIP = "История пользователя" .
     1183                                   ii = ii + 1 .
     1184                               end.
     1185                       end case.
     1186                   end.
     1187                   hh = hh:next-sibling.
     1188               end.
     1189               b-help:column = v-frame-width - b-help:width-chars.
     1190               jj = 0.
     1191               repeat ii = 4 to 1 by -1 :
     1192                   if valid-handle (v-h[ii] ) then
     1193                   do:
     1194                       jj  = jj + 1 .
     1195                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1196                       v-h[ii]:row    = v-help-old-y .
     1197                   end.
     1198               end.
     1199           end.
     1200       end.
     1201   end procedure.
     1202   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1203   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1204   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1205   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1206   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1207   define variable v-diasize-current-frame-height as decimal   no-undo .
     1208   define variable v-diasize-change-size          as logical   no-undo .
     1209   define variable v-diasize-resize-button        as handle    no-undo .
     1210   define variable v-diasize-wndmax               as logical   no-undo .
     1211   define variable v-diasize-wndstore             as logical   no-undo .
     1212   define variable v-diasize-proc-name            as character no-undo .
     1213   define variable v-diasize-browse-handle        as handle    no-undo .
     1214   define variable v-diasize-browse-number        as integer   no-undo .
     1215   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1216   define temp-table temp-diasize-handle no-undo
     1217     field handle-value  as handle
     1218     field save-position as decimal
     1219     index xpk is primary unique handle-value
     1220     .
     1221   define temp-table temp-browse-handle no-undo
     1222     field browse-type   as character
     1223     field browse-number as integer
     1224     field browse-handle as handle
     1225     field original-size as decimal
     1226     index xpk is primary unique browse-type browse-number
     1227     index xie browse-type browse-handle
     1228   .
     1229   procedure diasize_change-height :
     1230     define input  parameter p-change-value  as decimal   no-undo .
     1231     define input  parameter p-move-resize   as logical   no-undo .
     1232     define variable v-field-group-handle    as handle    no-undo .
     1233     define variable v-object-handle         as handle    no-undo .
     1234     define variable v-frame-height          as decimal   no-undo .
     1235     define variable v-frame-virtual-height  as decimal   no-undo .
     1236     define variable v-browse-height         as decimal   no-undo .
     1237     define variable v-window-height         as decimal   no-undo .
     1238     define variable v-window-virtual-height as decimal   no-undo .
     1239     define variable v-change-sign           as integer   no-undo .
     1240     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1241     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1242     if p-change-value > 0
     1243     then do:
     1244       if frame Dialog-Frame :height + p-change-value
     1245           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1246       then do:
     1247         assign
     1248           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1249                           - (frame Dialog-Frame :height-chars)
     1250         .
     1251         if p-change-value <= 0
     1252         then do:
     1253           run diasize_position-resize-button in this-procedure .
     1254           return .
     1255         end.
     1256       end.
     1257     end.
     1258     if p-change-value < 0
     1259     then do:
     1260       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1261       then do:
     1262         assign
     1263           p-change-value = v-diasize-orig-frame-height
     1264                          - (frame Dialog-Frame :height-chars)
     1265         .
     1266         if p-change-value >= 0
     1267         then do:
     1268           run diasize_position-resize-button in this-procedure .
     1269           return .
     1270         end.
     1271       end.
     1272     end.
     1273     if p-change-value >= 0
     1274     then do:
     1275       assign
     1276         v-change-sign = 1
     1277       .
     1278     end.
     1279     else do:
     1280       assign
     1281         v-change-sign = -1
     1282       .
     1283     end.
     1284     assign
     1285       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1286     .
     1287     if p-change-value = 0
     1288     then do:
     1289       run diasize_position-resize-button in this-procedure .
     1290       return .
     1291     end.
     1292     move_block:
     1293     do
     1294     on error undo move_block, retry move_block
     1295     :
     1296       if retry
     1297       then do:
     1298         do
     1299         on error undo move_block, leave move_block
     1300         :
     1301           if p-change-value > 0
     1302           then do:
     1303             for each buf_temp-diasize-handle
     1304             on error undo, next
     1305             :
     1306               assign
     1307                 v-object-handle = buf_temp-diasize-handle.handle-value
     1308               .
     1309               if v-object-handle <> v-diasize-resize-button
     1310               then do:
     1311                 assign
     1312                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1313                 .
     1314               end.
     1315             end.
     1316             assign
     1317               v-diasize-browse-handle :height = v-browse-height
     1318             .
     1319             for each buf_temp-browse-handle
     1320               where buf_temp-browse-handle.browse-type = 'height':u
     1321             on error undo, next
     1322             :
     1323               assign
     1324                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1325               .
     1326             end.
     1327             assign
     1328               frame Dialog-Frame :height = v-frame-height
     1329             .
     1330             if frame Dialog-Frame :scrollable = true
     1331             then do:
     1332               assign
     1333                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1334               .
     1335             end.
     1336             run diasize_position-resize-button in this-procedure .
     1337           end.
     1338           else do:
     1339             if frame Dialog-Frame :scrollable = true
     1340             then do:
     1341               assign
     1342                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1343               .
     1344             end.
     1345             assign
     1346               frame Dialog-Frame :height = v-frame-height
     1347             .
     1348             assign
     1349               v-diasize-browse-handle :height = v-browse-height
     1350             .
     1351             for each buf_temp-browse-handle
     1352               where buf_temp-browse-handle.browse-type = 'height':u
     1353             on error undo, next
     1354             :
     1355               assign
     1356                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1357               .
     1358             end.
     1359             for each buf_temp-diasize-handle
     1360             on error undo, next
     1361             :
     1362               assign
     1363                 v-object-handle = buf_temp-diasize-handle.handle-value
     1364               .
     1365               if v-object-handle <> v-diasize-resize-button
     1366               then do:
     1367                 assign
     1368                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1369                 .
     1370               end.
     1371             end.
     1372             run diasize_position-resize-button in this-procedure .
     1373           end.
     1374           assign
     1375             v-diasize-change-size = false
     1376           .
     1377           leave move_block .
     1378         end.
     1379       end.
     1380       assign
     1381         v-diasize-need-full-display = true
     1382       .
     1383       if v-diasize-change-size = false
     1384       then do:
     1385         assign
     1386           v-diasize-change-size = true
     1387         .
     1388       end.
     1389       else do:
     1390         return .
     1391       end.
     1392       assign
     1393         v-frame-height = frame Dialog-Frame :height
     1394         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1395         v-browse-height = v-diasize-browse-handle :height
     1396       .
     1397       for each buf_temp-browse-handle
     1398         where buf_temp-browse-handle.browse-type = 'height':u
     1399       :
     1400         assign
     1401           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1402         .
     1403       end.
     1404       for each buf_temp-diasize-handle
     1405       :
     1406         delete buf_temp-diasize-handle .
     1407       end.
     1408       assign
     1409         v-field-group-handle = frame Dialog-Frame :first-child
     1410       .
     1411       do while valid-handle(v-field-group-handle)
     1412       :
     1413         assign
     1414           v-object-handle = v-field-group-handle :first-child
     1415         .
     1416         do while valid-handle(v-object-handle)
     1417         :
     1418           if  v-object-handle <> v-diasize-browse-handle :handle
     1419           and can-query(v-object-handle, "row")
     1420           and can-query(v-object-handle, "height")
     1421           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1422           then do:
     1423             find first buf_temp-browse-handle
     1424               where buf_temp-browse-handle.browse-type   = 'height':u
     1425                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1426               no-error .
     1427             if available buf_temp-browse-handle
     1428             then do:
     1429             end.
     1430             else do:
     1431               create buf_temp-diasize-handle .
     1432               assign
     1433                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1434                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1435               .
     1436             end.
     1437           end.
     1438           assign
     1439             v-object-handle = v-object-handle :next-sibling
     1440           .
     1441         end.
     1442         assign
     1443           v-field-group-handle = v-field-group-handle :next-sibling
     1444         .
     1445       end.
     1446       do with frame Dialog-Frame
     1447       :
     1448         hide v-diasize-resize-button .
     1449         assign
     1450           v-diasize-resize-button :row    = 1
     1451           v-diasize-resize-button :column = 1
     1452         .
     1453       end.
     1454       if p-change-value > 0
     1455       then do:
     1456         if frame Dialog-Frame :scrollable = true
     1457         then do:
     1458           assign
     1459             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1460             no-error .
     1461           if error-status :error
     1462           or error-status :get-message(1) <> ""
     1463           then do:
     1464             undo move_block, retry move_block .
     1465           end.
     1466         end.
     1467         assign
     1468           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1469           no-error .
     1470         if error-status :error
     1471         or error-status :get-message(1) <> ""
     1472         then do:
     1473           undo move_block, retry move_block .
     1474         end.
     1475         assign
     1476           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1477           no-error .
     1478         if error-status :error
     1479         or error-status :get-message(1) <> ""
     1480         then do:
     1481           undo move_block, retry move_block .
     1482         end.
     1483         for each buf_temp-browse-handle
     1484           where buf_temp-browse-handle.browse-type = 'height':u
     1485         on error undo move_block, retry move_block
     1486         :
     1487           assign
     1488             buf_temp-browse-handle.browse-handle :height
     1489               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1490             no-error .
     1491           if error-status :error
     1492           or error-status :get-message(1) <> ""
     1493           then do:
     1494             undo move_block, retry move_block .
     1495           end.
     1496         end.
     1497         for each buf_temp-diasize-handle
     1498         on error undo move_block, retry move_block
     1499         :
     1500           assign
     1501             v-object-handle = buf_temp-diasize-handle.handle-value
     1502           .
     1503           if v-object-handle <> v-diasize-resize-button
     1504           then do:
     1505             assign
     1506               v-object-handle :row = v-object-handle :row + p-change-value
     1507               no-error .
     1508             if error-status :error
     1509             or error-status :get-message(1) <> ""
     1510             then do:
     1511               undo move_block, retry move_block .
     1512             end.
     1513           end.
     1514         end.
     1515       end.
     1516       else do:
     1517         for each buf_temp-diasize-handle
     1518         on error undo move_block, retry move_block
     1519         :
     1520           assign
     1521             v-object-handle = buf_temp-diasize-handle.handle-value
     1522           .
     1523           if v-object-handle <> v-diasize-resize-button
     1524           then do:
     1525             assign
     1526               v-object-handle :row = v-object-handle :row + p-change-value
     1527               no-error .
     1528             if error-status :error
     1529             or error-status :get-message(1) <> ""
     1530             then do:
     1531               undo move_block, retry move_block .
     1532             end.
     1533           end.
     1534         end.
     1535         assign
     1536           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1537           no-error .
     1538         if error-status :error
     1539         or error-status :get-message(1) <> ""
     1540         then do:
     1541           undo move_block, retry move_block .
     1542         end.
     1543         for each buf_temp-browse-handle
     1544           where buf_temp-browse-handle.browse-type = 'height':u
     1545         on error undo move_block, retry move_block
     1546         :
     1547           assign
     1548             buf_temp-browse-handle.browse-handle :height
     1549               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1550             no-error .
     1551           if error-status :error
     1552           or error-status :get-message(1) <> ""
     1553           then do:
     1554             undo move_block, retry move_block .
     1555           end.
     1556         end.
     1557         assign
     1558           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1559           no-error .
     1560         if error-status :error
     1561         or error-status :get-message(1) <> ""
     1562         then do:
     1563           undo move_block, retry move_block .
     1564         end.
     1565         if frame Dialog-Frame :scrollable = true
     1566         then do:
     1567           assign
     1568             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1569             no-error .
     1570           if error-status :error
     1571           or error-status :get-message(1) <> ""
     1572           then do:
     1573             undo move_block, retry move_block .
     1574           end.
     1575         end.
     1576       end.
     1577       if p-move-resize = true
     1578       then do:
     1579         run diasize_position-resize-button in this-procedure .
     1580       end.
     1581       if v-diasize-wndstore = true
     1582       then do:
     1583         if connected("ub") = true
     1584         then do:
     1585           define variable v-cntxt-db-num        as integer   no-undo .
     1586           define variable v-cntxt-userid        as character no-undo .
     1587           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1588                                             , OUTPUT v-cntxt-userid
     1589                                             ) .
     1590           run gbl/wndsizew.p
     1591             (input  v-cntxt-db-num
     1592             ,input  v-cntxt-userid
     1593             ,input  v-diasize-proc-name
     1594             ,input  'height':u
     1595             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1596             ) .
     1597         end.
     1598       end.
     1599     end.
     1600     assign
     1601       v-diasize-change-size = false
     1602     .
     1603   end procedure.
     1604   procedure diasize_set-height :
     1605     define input  parameter p-new-height  as decimal   no-undo .
     1606     define input  parameter p-move-resize as logical   no-undo .
     1607     do
     1608     on error undo, return error return-value
     1609     :
     1610       run diasize_change-height in this-procedure
     1611         (input  (p-new-height - frame Dialog-Frame :height)
     1612         ,input  p-move-resize
     1613         ) .
     1614     end.
     1615   end procedure.
     1616   procedure diasize_change-width :
     1617     define input  parameter p-change-value as decimal   no-undo .
     1618     define input  parameter p-move-resize  as logical   no-undo .
     1619     define variable v-field-group-handle   as handle    no-undo .
     1620     define variable v-object-handle        as handle    no-undo .
     1621     define variable v-frame-width          as decimal   no-undo .
     1622     define variable v-frame-virtual-width  as decimal   no-undo .
     1623     define variable v-browse-width         as decimal   no-undo .
     1624     define variable v-window-width         as decimal   no-undo .
     1625     define variable v-window-virtual-width as decimal   no-undo .
     1626     define variable v-change-sign          as integer   no-undo .
     1627     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1628     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1629     if p-change-value > 0
     1630     then do:
     1631       if frame Dialog-Frame :width + p-change-value >
     1632           session :width-chars
     1633       then do:
     1634         assign
     1635           p-change-value = session :width-chars - frame Dialog-Frame :width
     1636         .
     1637         if p-change-value <= 0
     1638         then do:
     1639           run diasize_position-resize-button in this-procedure .
     1640           return .
     1641         end.
     1642       end.
     1643     end.
     1644     if p-change-value < 0
     1645     then do:
     1646       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1647       then do:
     1648         assign
     1649           p-change-value = v-diasize-orig-frame-width
     1650                          - frame Dialog-Frame :width
     1651         .
     1652         if p-change-value >= 0
     1653         then do:
     1654           run diasize_position-resize-button in this-procedure .
     1655           return .
     1656         end.
     1657       end.
     1658     end.
     1659     if p-change-value >= 0
     1660     then do:
     1661       assign
     1662         v-change-sign = 1
     1663       .
     1664     end.
     1665     else do:
     1666       assign
     1667         v-change-sign = -1
     1668       .
     1669     end.
     1670     assign
     1671       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1672     .
     1673     if p-change-value = 0
     1674     then do:
     1675       run diasize_position-resize-button in this-procedure .
     1676       return .
     1677     end.
     1678     move_block:
     1679     do
     1680     on error undo move_block, leave move_block
     1681     :
     1682       if retry
     1683       then do:
     1684         do
     1685         on error undo move_block, leave move_block
     1686         :
     1687           if p-change-value > 0
     1688           then do:
     1689             for each buf_temp-diasize-handle
     1690             on error undo, next
     1691             :
     1692               assign
     1693                 v-object-handle = buf_temp-diasize-handle.handle-value
     1694               .
     1695               if v-object-handle <> v-diasize-resize-button
     1696               then do:
     1697                 assign
     1698                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1699                 .
     1700               end.
     1701             end.
     1702             assign
     1703               v-diasize-browse-handle :width = v-browse-width
     1704             .
     1705             for each buf_temp-browse-handle
     1706               where buf_temp-browse-handle.browse-type = 'width':u
     1707             on error undo, next
     1708             :
     1709               assign
     1710                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1711               .
     1712             end.
     1713             assign
     1714               frame Dialog-Frame :width = v-frame-width
     1715             .
     1716             if frame Dialog-Frame :scrollable = true
     1717             then do:
     1718               assign
     1719                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1720               .
     1721             end.
     1722             run diasize_position-resize-button in this-procedure .
     1723           end.
     1724           else do:
     1725             if frame Dialog-Frame :scrollable = true
     1726             then do:
     1727               assign
     1728                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1729               .
     1730             end.
     1731             assign
     1732               frame Dialog-Frame :width = v-frame-width
     1733             .
     1734             for each buf_temp-browse-handle
     1735               where buf_temp-browse-handle.browse-type = 'width':u
     1736             on error undo, next
     1737             :
     1738               assign
     1739                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1740               .
     1741             end.
     1742             assign
     1743               v-diasize-browse-handle :width = v-browse-width
     1744             .
     1745             for each buf_temp-diasize-handle
     1746             on error undo, next
     1747             :
     1748               assign
     1749                 v-object-handle = buf_temp-diasize-handle.handle-value
     1750               .
     1751               if v-object-handle <> v-diasize-resize-button
     1752               then do:
     1753                 assign
     1754                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1755                 .
     1756               end.
     1757             end.
     1758             run diasize_position-resize-button in this-procedure .
     1759           end.
     1760           assign
     1761             v-diasize-change-size = false
     1762           .
     1763           leave move_block .
     1764         end.
     1765       end.
     1766       assign
     1767         v-diasize-need-full-display = true
     1768       .
     1769       if v-diasize-change-size = false
     1770       then do:
     1771         assign
     1772           v-diasize-change-size = true
     1773         .
     1774       end.
     1775       else do:
     1776         return .
     1777       end.
     1778       assign
     1779         v-frame-width = frame Dialog-Frame :width
     1780         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1781         v-browse-width = v-diasize-browse-handle :width
     1782       .
     1783       for each buf_temp-browse-handle
     1784         where buf_temp-browse-handle.browse-type = 'width':u
     1785       :
     1786         assign
     1787           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1788         .
     1789       end.
     1790       for each buf_temp-diasize-handle
     1791       :
     1792         delete buf_temp-diasize-handle .
     1793       end.
     1794       assign
     1795         v-field-group-handle = frame Dialog-Frame :first-child
     1796       .
     1797       do while valid-handle(v-field-group-handle)
     1798       :
     1799         assign
     1800           v-object-handle = v-field-group-handle :first-child
     1801         .
     1802         do while valid-handle(v-object-handle)
     1803         :
     1804           if  v-object-handle <> v-diasize-browse-handle :handle
     1805           and v-object-handle <> v-diasize-resize-button
     1806           and can-query(v-object-handle, "row")
     1807           and can-query(v-object-handle, "height")
     1808           and ( v-object-handle :col + v-object-handle :width
     1809                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1810               )
     1811           then do:
     1812             find first buf_temp-browse-handle
     1813               where buf_temp-browse-handle.browse-type   = 'width':u
     1814                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1815               no-error .
     1816             if available buf_temp-browse-handle
     1817             then do:
     1818             end.
     1819             else do:
     1820               create buf_temp-diasize-handle .
     1821               assign
     1822                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1823                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1824               .
     1825             end.
     1826           end.
     1827           assign
     1828             v-object-handle = v-object-handle :next-sibling
     1829           .
     1830         end.
     1831         assign
     1832           v-field-group-handle = v-field-group-handle :next-sibling
     1833         .
     1834       end.
     1835       do with frame Dialog-Frame
     1836       :
     1837         hide v-diasize-resize-button .
     1838         v-diasize-resize-button :row = 1.
     1839         v-diasize-resize-button :column = 1.
     1840       end.
     1841       if p-change-value > 0
     1842       then do:
     1843         if frame Dialog-Frame :scrollable = true
     1844         then do:
     1845           assign
     1846             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1847             no-error .
     1848           if error-status :error
     1849           or error-status :get-message(1) <> ""
     1850           then do:
     1851             undo move_block, retry move_block.
     1852           end.
     1853         end.
     1854         assign
     1855           frame Dialog-Frame :width = v-frame-width + p-change-value
     1856           no-error .
     1857         if error-status :error
     1858         or error-status :get-message(1) <> ""
     1859         then do:
     1860           undo move_block, retry move_block.
     1861         end.
     1862         assign
     1863           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1864         no-error .
     1865         if error-status :error
     1866         or error-status :get-message(1) <> ""
     1867         then do:
     1868           undo move_block, retry move_block.
     1869         end.
     1870         for each buf_temp-browse-handle
     1871           where buf_temp-browse-handle.browse-type = 'width':u
     1872         on error undo move_block, retry move_block
     1873         :
     1874           assign
     1875             buf_temp-browse-handle.browse-handle :width
     1876               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1877             no-error .
     1878           if error-status :error
     1879           or error-status :get-message(1) <> ""
     1880           then do:
     1881             undo move_block, retry move_block .
     1882           end.
     1883         end.
     1884         for each buf_temp-diasize-handle
     1885         on error undo move_block, retry move_block
     1886         :
     1887           assign
     1888             v-object-handle = buf_temp-diasize-handle.handle-value
     1889           .
     1890           if v-object-handle <> v-diasize-resize-button
     1891           then do:
     1892             assign
     1893               v-object-handle :col = v-object-handle :col + p-change-value
     1894               no-error .
     1895             if error-status :error
     1896             or error-status :get-message(1) <> ""
     1897             then do:
     1898               undo move_block, retry move_block .
     1899             end.
     1900           end.
     1901         end.
     1902       end.
     1903       else do:
     1904         for each buf_temp-diasize-handle
     1905         on error undo move_block, retry move_block
     1906         :
     1907           assign
     1908             v-object-handle = buf_temp-diasize-handle.handle-value
     1909           .
     1910           if v-object-handle <> v-diasize-resize-button
     1911           then do:
     1912             assign
     1913               v-object-handle :col = v-object-handle :col + p-change-value
     1914               no-error .
     1915             if error-status :error
     1916             or error-status :get-message(1) <> ""
     1917             then do:
     1918               undo move_block, retry move_block .
     1919             end.
     1920           end.
     1921         end.
     1922         for each buf_temp-browse-handle
     1923           where buf_temp-browse-handle.browse-type = 'width':u
     1924         on error undo move_block, retry move_block
     1925         :
     1926           assign
     1927             buf_temp-browse-handle.browse-handle :width
     1928               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1929             no-error .
     1930           if error-status :error
     1931           or error-status :get-message(1) <> ""
     1932           then do:
     1933             undo move_block, retry move_block .
     1934           end.
     1935         end.
     1936         assign
     1937           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1938           no-error .
     1939         if error-status :error
     1940         or error-status :get-message(1) <> ""
     1941         then do:
     1942           undo move_block, retry move_block.
     1943         end.
     1944         assign
     1945           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1946         no-error .
     1947         if error-status :error
     1948         or error-status :get-message(1) <> ""
     1949         then do:
     1950           undo move_block, retry move_block.
     1951         end.
     1952         if frame Dialog-Frame :scrollable = true
     1953         then do:
     1954           assign
     1955             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1956           no-error .
     1957           if error-status :error
     1958           or error-status :get-message(1) <> ""
     1959           then do:
     1960             undo move_block, retry move_block.
     1961           end.
     1962         end.
     1963       end.
     1964       if p-move-resize
     1965       then do:
     1966         run diasize_position-resize-button in this-procedure .
     1967       end.
     1968       if v-diasize-wndstore = true
     1969       then do:
     1970         if connected("ub") = true
     1971         then do:
     1972           define variable v-cntxt-db-num        as integer   no-undo .
     1973           define variable v-cntxt-userid        as character no-undo .
     1974           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1975                                             , OUTPUT v-cntxt-userid
     1976                                             ) .
     1977           run gbl/wndsizew.p
     1978             (input  v-cntxt-db-num
     1979             ,input  v-cntxt-userid
     1980             ,input  v-diasize-proc-name
     1981             ,input  'width':u
     1982             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1983             ) .
     1984         end.
     1985       end.
     1986     end.
     1987     assign
     1988       v-diasize-change-size = false
     1989     .
     1990   end procedure.
     1991   procedure diasize_set-width :
     1992     define input  parameter p-new-width  as decimal   no-undo .
     1993     define input  parameter p-move-resize as logical   no-undo .
     1994     do
     1995     on error undo, return error return-value
     1996     :
     1997       run diasize_change-width in this-procedure
     1998         (input  (p-new-width - frame Dialog-Frame :width)
     1999         ,input  p-move-resize
     2000         ) .
     2001     end.
     2002   end procedure.
     2003   procedure diasize_position-resize-button :
     2004     do with frame Dialog-Frame
     2005     :
     2006       hide v-diasize-resize-button .
     2007       assign
     2008         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2009                     - 1
     2010                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2011         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2012                     - 1
     2013                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2014       .
     2015       view v-diasize-resize-button .
     2016     end.
     2017   end procedure.
     2018   on alt-right anywhere
     2019   do:
     2020     run diasize_change-width in this-procedure
     2021       (input 1
     2022       ,input true
     2023       ) .
     2024     return no-apply .
     2025   end.
     2026   on alt-left anywhere
     2027   do:
     2028     run diasize_change-width in this-procedure
     2029       (input -1
     2030       ,input true
     2031       ) .
     2032     return no-apply .
     2033   end.
     2034   on alt-down anywhere
     2035   do:
     2036     run diasize_change-height in this-procedure
     2037       (input 1
     2038       ,input true
     2039       ) .
     2040     return no-apply .
     2041   end.
     2042   on alt-up anywhere
     2043   do:
     2044     run diasize_change-height in this-procedure
     2045       (input -1
     2046       ,input true
     2047       ) .
     2048     return no-apply .
     2049   end.
     2050   on alt-enter of frame Dialog-Frame
     2051   do:
     2052     run diasize_maximize in this-procedure
     2053       (input  ?
     2054       ).
     2055     return no-apply .
     2056   end.
     2057   procedure diasize_end-move :
     2058     do
     2059     on error undo, return error return-value
     2060     :
     2061       define variable v-row-delta as decimal   no-undo .
     2062       define variable v-col-delta as decimal   no-undo .
     2063       define variable v-new-row as decimal   no-undo .
     2064       define variable v-new-col as decimal   no-undo .
     2065       assign
     2066         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2067         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2068       .
     2069       assign
     2070         v-row-delta = v-new-row - frame Dialog-Frame :height
     2071         v-col-delta = v-new-col - frame Dialog-Frame :width
     2072       .
     2073       run diasize_change-height in this-procedure
     2074         (input v-row-delta
     2075         ,input true
     2076         ) .
     2077       run diasize_change-width in this-procedure
     2078         (input v-col-delta
     2079         ,input true
     2080         ) .
     2081     end.
     2082   end procedure.
     2083   procedure diasize_maximize :
     2084     define input  parameter p-action as logical   no-undo .
     2085     do
     2086     on error undo, return error return-value
     2087     :
     2088       if p-action = ?
     2089       then do:
     2090         if v-diasize-need-maximize = true
     2091         then do:
     2092           assign
     2093             p-action = true
     2094           .
     2095         end.
     2096         else do:
     2097           assign
     2098             p-action = false
     2099           .
     2100         end.
     2101       end.
     2102       if p-action = true
     2103       then do:
     2104         run diasize_change-height in this-procedure
     2105           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2106               - frame Dialog-Frame :height-chars
     2107           ,input true
     2108           ) .
     2109         run diasize_change-width in this-procedure
     2110           (input session :width-chars
     2111               - frame Dialog-Frame :width-chars
     2112           ,input true
     2113           ) .
     2114         assign
     2115           v-diasize-need-maximize = false
     2116         .
     2117       end.
     2118       else do:
     2119         run diasize_change-width in this-procedure
     2120           (input v-diasize-orig-frame-width
     2121               - frame Dialog-Frame :width-chars
     2122           ,input true
     2123           ) .
     2124         run diasize_change-height in this-procedure
     2125           (input v-diasize-orig-frame-height
     2126               - frame Dialog-Frame :height-chars
     2127           ,input true
     2128           ) .
     2129         assign
     2130           v-diasize-need-maximize = true
     2131         .
     2132       end.
     2133     end.
     2134   end procedure.
     2135   procedure diasize_restore-orig-size :
     2136     do
     2137     on error undo, return error return-value
     2138     :
     2139       assign
     2140         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2141         v-diasize-current-frame-height = frame Dialog-Frame :height
     2142       .
     2143       run diasize_set-height in this-procedure
     2144         (input  v-diasize-orig-frame-height
     2145         ,input  true
     2146         ) .
     2147       run diasize_set-width in this-procedure
     2148         (input  v-diasize-orig-frame-width
     2149         ,input  true
     2150         ) .
     2151     end.
     2152   end procedure.
     2153   procedure diasize_restore-current-size :
     2154     do
     2155     on error undo, return error return-value
     2156     :
     2157       run diasize_set-height in this-procedure
     2158         (input  v-diasize-current-frame-height
     2159         ,input  true
     2160         ) .
     2161       run diasize_set-width in this-procedure
     2162         (input  v-diasize-current-frame-width
     2163         ,input  true
     2164         ) .
     2165     end.
     2166   end procedure.
     2167   procedure diasize_set-browse-handle :
     2168     define input  parameter p-browse-handle as handle   no-undo .
     2169     define buffer buf_temp-browse-handle for temp-browse-handle .
     2170     do
     2171     on error undo, return error return-value
     2172     :
     2173       assign
     2174         v-diasize-browse-handle = p-browse-handle
     2175       .
     2176       for each buf_temp-browse-handle
     2177       on error undo, return error return-value
     2178       :
     2179         delete buf_temp-browse-handle .
     2180       end.
     2181     end.
     2182   end procedure.
     2183   procedure diasize_add_browse :
     2184     define input  parameter p-browse-type   as character no-undo .
     2185     define input  parameter p-browse-handle as handle    no-undo .
     2186     define buffer buf_temp-browse-handle for temp-browse-handle .
     2187     do
     2188     on error undo, return error return-value
     2189     :
     2190       assign
     2191         v-diasize-browse-number = v-diasize-browse-number + 1
     2192       .
     2193       create buf_temp-browse-handle .
     2194       assign
     2195         buf_temp-browse-handle.browse-type   = p-browse-type
     2196         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2197         buf_temp-browse-handle.browse-handle = p-browse-handle
     2198       .
     2199     end.
     2200   end procedure.
     2201   procedure diasize_init :
     2202     define variable v-default-value    as logical   no-undo .
     2203     define variable v-restore-saved    as logical   no-undo .
     2204     define variable v-resize-value-str as character no-undo .
     2205     do
     2206     on error undo, return error return-value
     2207     :
     2208       do with frame Dialog-Frame
     2209       :
     2210         assign
     2211           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2212           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2213           v-diasize-browse-handle     = browse br-ipck :handle
     2214         .
     2215         create button v-diasize-resize-button
     2216         assign
     2217           parent        = frame Dialog-Frame :first-child
     2218           label         = "s"
     2219           height-pixels = 16
     2220           width-pixels  = 16
     2221           visible       = true
     2222           sensitive     = true
     2223           movable       = true
     2224           triggers:
     2225             on end-move persistent run diasize_end-move in this-procedure .
     2226           end triggers.
     2227         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2228         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2229         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2230         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2231         assign
     2232           v-diasize-wndmax = false
     2233         .
     2234         if connected("ub") = true
     2235         then do:
     2236           define variable v-cntxt-db-num        as integer   no-undo .
     2237           define variable v-cntxt-userid        as character no-undo .
     2238           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2239                                             , OUTPUT v-cntxt-userid
     2240                                             ) .
     2241           run gbl/wndpar_r.p
     2242             (input  v-cntxt-db-num
     2243             ,input  v-cntxt-userid
     2244             ,input  'wndmax':U
     2245             ,output v-diasize-wndmax
     2246             ,output v-default-value
     2247             ) .
     2248         end.
     2249         assign
     2250           v-diasize-wndstore = false
     2251         .
     2252         if connected("ub") = true
     2253         then do:
     2254           run gbl/wndpar_r.p
     2255             (input  v-cntxt-db-num
     2256             ,input  v-cntxt-userid
     2257             ,input  'wndstore':U
     2258             ,output v-diasize-wndstore
     2259             ,output v-default-value
     2260             ) .
     2261         end.
     2262         assign
     2263           v-diasize-proc-name = entry(1, program-name(2), '.')
     2264         .
     2265         if v-diasize-wndstore = true
     2266         then do:
     2267           assign
     2268             v-restore-saved = false
     2269           .
     2270           if connected("ub") = true
     2271           then do:
     2272             run gbl/wndsizer.p
     2273               (input  v-cntxt-db-num
     2274               ,input  v-cntxt-userid
     2275               ,input  v-diasize-proc-name
     2276               ,input  'height':u
     2277               ,output v-resize-value-str
     2278               ) .
     2279             if v-resize-value-str <> '':U
     2280             then do:
     2281               run diasize_change-height in this-procedure
     2282                 (input  integer(v-resize-value-str)
     2283                 ,input  true
     2284                 ) .
     2285               assign
     2286                 v-restore-saved = true
     2287               .
     2288             end.
     2289           end.
     2290           if connected("ub") = true
     2291           then do:
     2292             run gbl/wndsizer.p
     2293               (input  v-cntxt-db-num
     2294               ,input  v-cntxt-userid
     2295               ,input  v-diasize-proc-name
     2296               ,input  'width':u
     2297               ,output v-resize-value-str
     2298               ) .
     2299             if v-resize-value-str <> '':U
     2300             then do:
     2301               run diasize_change-width in this-procedure
     2302                 (input  integer(v-resize-value-str)
     2303                 ,input  true
     2304                 ) .
     2305               assign
     2306                 v-restore-saved = true
     2307               .
     2308             end.
     2309           end.
     2310           if v-restore-saved <> true
     2311           then do:
     2312             if v-diasize-wndmax = true
     2313             then do:
     2314               run diasize_maximize in this-procedure
     2315                 (input  true
     2316                 ) .
     2317             end.
     2318           end.
     2319         end.
     2320         else do:
     2321           if v-diasize-wndmax = true
     2322           then do:
     2323             run diasize_maximize in this-procedure
     2324               (input  true
     2325               ) .
     2326           end.
     2327         end.
     2328       end.
     2329     end.
     2330   end procedure.
     2331   procedure diasize_need-full-display :
     2332     define output parameter p-need-full-display as logical   no-undo .
     2333     do
     2334     on error undo, return error return-value
     2335     :
     2336       assign
     2337         p-need-full-display = v-diasize-need-full-display
     2338       .
     2339       assign
     2340         v-diasize-need-full-display = false
     2341       .
     2342     end.
     2343   end procedure.
     2344   procedure get-context :
     2345      define output parameter p-db-num as integer          no-undo.
     2346      define output parameter p-user-id as character        no-undo.
     2347      define variable v-login               as character    no-undo.
     2348      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2349      define buffer buf_user-login  for ub.user-login .
     2350      do
     2351      on error undo, return error
     2352      :
     2353            FIND FIRST buf_sys-ctrl no-lock.
     2354            ASSIGN
     2355               v-login = USERID("ub")
     2356               p-db-num = buf_sys-ctrl.db-num
     2357            .
     2358            FIND FIRST buf_user-login
     2359                 WHERE buf_user-login.db-num = p-db-num
     2360                   AND buf_user-login.user-login = v-login
     2361                 no-lock
     2362                 no-error
     2363                 .
     2364            IF AVAILABLE buf_user-login
     2365            THEN DO:
     2366               assign
     2367                  p-user-id = buf_user-login.user-id
     2368               .
     2369            END.
     2370      end.
     2371   end procedure.
     2372       run diasize_init in this-procedure .
     2373   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2374     run mainmenu_getcntxt in parparentproc
     2375       (output v-cntxt-db-num
     2376       ,output v-cntxt-userid
     2377       ,output v-cntxt-level
     2378       ,output v-cntxt-host-code-obj
     2379       ,output v-cntxt-obj-type
     2380       ,output v-cntxt-obj-code
     2381       ,output v-cntxt-db-num-obj
     2382       ,output v-cntxt-is-admin
     2383       ) .
     2384   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2385   on INS of frame Dialog-Frame anywhere do:
     2386     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     2387     return no-apply.
     2388   end.
     2389   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2390   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     2391     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     2392     return no-apply.
     2393   end.
     2394   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2395   on F8 of frame Dialog-Frame anywhere do:
     2396     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame Dialog-Frame. END.
     2397     return no-apply.
     2398   end.
     2399   define variable vss-include-info17 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2400   on F2 of frame Dialog-Frame anywhere do:
     2401     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     2402     return no-apply.
     2403   end.
     2404   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2405   procedure set-filter-name :
     2406   define input parameter p-filter-name as character no-undo .
     2407     do with frame Dialog-Frame:
     2408       if p-filter-name > "" then do:
     2409         assign
     2410           frame Dialog-Frame:title
     2411             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2412         .
     2413         assign
     2414           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2415         .
     2416       end.
     2417       else do:
     2418         assign
     2419           b-sch :tooltip = ""
     2420         .
     2421       end.
     2422     end.
     2423   end procedure.
     2424   def var sort-labelbr-ipck   as character no-undo .
     2425   def var sort-clmnbr-ipck    as handle    no-undo .
     2426   def var cur-clmnbr-ipck     as handle    no-undo .
     2427   def var cur-clmn-locbr-ipck as integer   no-undo .
     2428   def var re-querybr-ipck     as logical   initial no no-undo .
     2429   on start-search, ctrl-o of br-ipck in frame Dialog-Frame do:
     2430      run sort-brbr-ipck
     2431        (input (if available X_ext-file
     2432                then recid(X_ext-file)
     2433                else ?
     2434               )
     2435        ).
     2436   end.
     2437   PROCEDURE sort-brbr-ipck :
     2438     define input parameter p-recid as recid no-undo .
     2439     if re-querybr-ipck = no then do:
     2440       assign
     2441          cur-clmnbr-ipck = br-ipck:current-column in frame Dialog-Frame
     2442       .
     2443       if sort-clmnbr-ipck <> ? then sort-clmnbr-ipck:column-fgcolor = 0.
     2444       if cur-clmnbr-ipck = sort-clmnbr-ipck then do:
     2445         assign
     2446            sort-labelbr-ipck = ""
     2447            sort-clmnbr-ipck = ?
     2448         .
     2449        end.
     2450        else do:
     2451          assign
     2452            sort-labelbr-ipck = cur-clmnbr-ipck:label
     2453            sort-clmnbr-ipck  = cur-clmnbr-ipck
     2454            sort-clmnbr-ipck:column-fgcolor = 4
     2455          .
     2456        end.
     2457      end.
     2458     assign
     2459       cur-clmn-locbr-ipck = 1
     2460     .
     2461     def var column-handle as handle no-undo .
     2462     column-handle = br-ipck:first-column.
     2463     do while valid-handle(column-handle) :
     2464       if column-handle = cur-clmnbr-ipck then do:
     2465         leave .
     2466       end.
     2467       column-handle = column-handle:NEXT-COLUMN.
     2468       assign
     2469         cur-clmn-locbr-ipck = cur-clmn-locbr-ipck + 1
     2470       .
     2471     end.
     2472     case sort-labelbr-ipck:
     2473           when 'Для БД'  then DO:    assign       sort-column-name = "X_ext-file.db-num"     .     run OpenBr in this-procedure ( input yes, input no, input no) .   . END.
     2474           when X_ext-file.file-name:label in browse br-ipck then DO:    assign       sort-column-name = "X_ext-file.file-name"     .     run OpenBr in this-procedure ( input yes, input no, input no) .   . END.
     2475           when 'Для БД'  then DO:    assign       sort-column-name = "X_ext-file.file-num"     .     run OpenBr in this-procedure ( input yes, input no, input no) .   . END.
     2476       otherwise do:
     2477         assign
     2478           sort-column-name = ""
     2479         .
     2480         run OpenBr in this-procedure ( input yes, input no, input no).
     2481         if sort-labelbr-ipck <> "" then do:
     2482           assign
     2483             cur-clmnbr-ipck:column-fgcolor = 0
     2484           .
     2485         end.
     2486         assign
     2487           cur-clmn-locbr-ipck = ?
     2488         .
     2489       end.
     2490     end case.
     2491     if p-recid <> ? then do:
     2492       reposition br-ipck to recid p-recid no-error.
     2493       apply "value-changed" to br-ipck in frame Dialog-Frame.
     2494     end.
     2495     apply "entry" to br-ipck in frame Dialog-Frame.
     2496   END PROCEDURE.
     2497   procedure re-open-query-srt-clmnbr-ipck:
     2498   if cur-clmnbr-ipck = ? then do:
     2499      run OpenBr in this-procedure ( input yes, input no, input no).
     2500   end.
     2501   else do:
     2502      assign re-querybr-ipck = yes.
     2503      run sort-brbr-ipck
     2504        (input (if available X_ext-file
     2505                then recid(X_ext-file)
     2506                else ?
     2507               )
     2508        ).
     2509      assign re-querybr-ipck = no.
     2510   end.
     2511   end.
     2512   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2513   do:
     2514     br-ipck :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2515   end.
     2516   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2517   on f5 of frame Dialog-Frame anywhere
     2518   do:
     2519      assign v-doc-rec = ?. if available X_ext-file then v-doc-rec = recid(X_ext-file).              run OpenBr in this-procedure (input yes, input no, input no) no-error. reposition br-ipck to recid v-doc-rec no-error.              APPLY 'Entry' TO br-ipck.
     2520       apply "VALUE-CHANGED" to br-ipck.
     2521   end.
     2522   MAIN-BLOCK:
     2523   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2524      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2525     if p-all-or-upg = 1 then do:
     2526        message
     2527        "Функционал находится в разработке"
     2528        view-as alert-box warning .
     2529        return.
     2530     end.
     2531     ASSIGN
     2532     v-rid-list = p-rid-list.
     2533     CASE p-all-or-upg:
     2534       when 0 then do:
     2535         if p-file-name <> '':U
     2536         or p-status_ <> '':U then do:
     2537           message
     2538           vss-workfile vss-revision vss-description skip
     2539           "Неверно заданы параметры p-file-name и/или p-status_"
     2540           view-as alert-box error .
     2541           undo, return error .
     2542         end.
     2543       end.
     2544       when 1 then do:
     2545       end.
     2546     END CASE.
     2547     run Myenable in this-procedure .
     2548     IF  v-rid-list = '':U THEN
     2549     HIDE mark-num in frame Dialog-Frame .
     2550     WAIT-FOR GO OF FRAME Dialog-Frame.
     2551   END.
     2552   run disable_UI.
     2553   PROCEDURE disable_UI :
     2554     HIDE FRAME Dialog-Frame.
     2555   END PROCEDURE.
     2556   PROCEDURE enable_UI :
     2557     DISPLAY mark-num
     2558         WITH FRAME Dialog-Frame.
     2559     ENABLE b-quit b-mark B-add B-del b-check b-params b-install b-output-params
     2560            b-save b-lkp b-sch B-Help br-ipck mark-num
     2561         WITH FRAME Dialog-Frame.
     2562     VIEW FRAME Dialog-Frame.
     2563     OPEN QUERY br-ipck FOR EACH X_ext-file NO-LOCK WHERE X_ext-file.file-num < 2147483647      INDEXED-REPOSITION .
     2564   END PROCEDURE.
     2565   PROCEDURE MyEnable :
     2566   ASSIGN
     2567   b-add:menu-mouse IN FRAME Dialog-Frame = 1
     2568   X_ext-file.update-user-name:READ-ONLY IN BROWSE br-ipck = YES
     2569   X_ext-file.file-name:RESIZABLE IN BROWSE br-ipck = YES
     2570   .
     2571   CASE p-all-or-upg:
     2572     WHEN 0 THEN DO:
     2573       ASSIGN
     2574       MENU-ITEM m_auto:LABEL IN menu menu-b-add = "Пересылка"
     2575       MENU-ITEM m_manual:LABEL IN menu menu-b-add = "В текущую БД"
     2576       .
     2577       ENABLE
     2578       b-quit
     2579       b-mark
     2580       b-add
     2581       B-del
     2582       b-sch
     2583       B-Help
     2584       b-save
     2585       b-lkp
     2586       br-ipck
     2587       b-params
     2588       b-output-params
     2589       WITH FRAME Dialog-Frame .
     2590       HIDE
     2591       b-check
     2592       b-install
     2593       IN FRAME Dialog-Frame.
     2594       ASSIGN
     2595       X_ext-file.file-name:LABEL IN BROWSE br-ipck = "Файл"
     2596       X_ext-file.FILE-NAME:resizable IN BROWSE br-ipck = YES
     2597       X_ext-file.create-sys-time:LABEL IN BROWSE br-ipck = "Дата созд.файла"
     2598       X_ext-file.create-sys-date:LABEL IN BROWSE br-ipck = "Время созд.файла"
     2599       X_ext-file.update-sys-date:LABEL IN BROWSE br-ipck = "Дата устан.!/регистр"
     2600       X_ext-file.update-sys-time:LABEL IN BROWSE br-ipck = "Время устан.!/регистр."
     2601       X_ext-file.update-user-name:LABEL IN BROWSE br-ipck = "Польз"
     2602       .
     2603     END.
     2604     WHEN 1 THEN DO:
     2605       ENABLE
     2606       b-quit
     2607       b-mark
     2608       B-add
     2609       B-del
     2610       b-check
     2611       b-install
     2612       b-sch
     2613       B-Help
     2614       br-ipck
     2615       WITH FRAME Dialog-Frame .
     2616       HIDE
     2617       b-save
     2618       b-params
     2619       b-output-params
     2620       IN FRAME Dialog-Frame.
     2621     END.
     2622   END CASE.
     2623   VIEW FRAME Dialog-Frame .
     2624   run OpenBr IN THIS-PROCEDURE ( input yes, input no, input no).
     2625   END PROCEDURE.
     2626   PROCEDURE Openbr :
     2627   define input  parameter p-open-query     as logical   no-undo .
     2628   define input  parameter p-find-next      as logical   no-undo .
     2629   define input  parameter p-find-condition as character no-undo .
     2630   DEFINE VARIABLE l-query-was-opened as logical no-undo .
     2631   define variable title00 as character no-undo.
     2632   define variable title01 as character no-undo.
     2633   assign
     2634   title00 = substitute("Файлы и ссылки на файлы, хранящиеся в БД &1", v-cntxt-db-num).
     2635   title01 = substitute("Зарегистрированные пакеты обновлений в БД &1", v-cntxt-db-num).
     2636   .
     2637   run waitfram-show in this-procedure ( INPUT "Ждите...").
     2638   DEFINE VARIABLE sort-column-phrase as character no-undo .
     2639   case sort-column-name :
     2640     when "" then do:
     2641       assign
     2642         sort-column-phrase = ""
     2643       .
     2644     end.
     2645     otherwise do:
     2646       assign
     2647         sort-column-phrase = "by " + sort-column-name
     2648       .
     2649     end.
     2650   end case.
     2651   define variable l-open-query as logical   no-undo .
     2652   CASE p-all-or-upg:
     2653     when 0 then do:
     2654       assign
     2655       filter-point-name = "Работа с файлами, хранящимися в БД" .
     2656       IF p-from-db-num = ?
     2657       AND p-db-num = ? THEN DO:
     2658         ASSIGN
     2659         frame Dialog-Frame:TITLE = SUBSTITUTE("&1", title00).
     2660   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2661   define variable  l-disable-where-22  as logical   no-undo .
     2662   define variable  l-filter-open-22    as logical   .
     2663   define variable  flt-rec-22       as recid     no-undo .
     2664   define variable  filter-name-22      as character no-undo .
     2665   define variable  where-phrase-22     as character no-undo .
     2666   define variable  sort-phrase-22      as character no-undo .
     2667   define variable  where-phrase-rus-22 as character no-undo .
     2668   define variable  sort-phrase-rus-22  as character no-undo .
     2669     run waitfram-show in this-procedure
     2670       (input "ЖДИТЕ ..."
     2671       ).
     2672   run gbl/flt-get.p
     2673     (input filter-point
     2674     ,output flt-rec-22
     2675     ,output filter-name-22
     2676     ,output where-phrase-22
     2677     ,output sort-phrase-22
     2678     ,output where-phrase-rus-22
     2679     ,output sort-phrase-rus-22
     2680     ).
     2681   if p-open-query then do:
     2682       run set-filter-name in this-procedure
     2683         (INPUT filter-name-22
     2684         ) no-error .
     2685     assign
     2686       l-filter-open-22 = false
     2687     .
     2688     if flt-rec-22 <> ?
     2689       or sort-column-phrase > ""
     2690     then do:
     2691       define variable  parameter-2-22 as character no-undo .
     2692       define variable  parameter-3-22 as character no-undo .
     2693       define variable  parameter-4-22 as character no-undo .
     2694       define variable  parameter-5-22 as character no-undo .
     2695       define variable  parameter-6-22 as character no-undo .
     2696       define variable  parameter-7-22 as character no-undo .
     2697         assign
     2698         parameter-3-22 =
     2699                                 "FOR EACH X_ext-file"
     2700         parameter-4-22 =
     2701           (
     2702             if (" X_ext-file.file-num < 2147483647 " + " " + where-phrase-22) <> ""
     2703             then " X_ext-file.file-num < 2147483647 " + " " + where-phrase-22
     2704             else "true"
     2705           )
     2706         parameter-5-22 = (" " + "" + " " + "")
     2707         parameter-6-22 = if sort-phrase-22 = ''
     2708                              then
     2709           (
     2710           " " + "  " +
     2711             " " + sort-column-phrase +
     2712           " " + "  "
     2713           )
     2714                              else
     2715           (
     2716           " " + "  " +
     2717             " " + sort-column-phrase +
     2718           " " + sort-phrase-22
     2719           )
     2720         parameter-7-22 =
     2721           " indexed-reposition  "
     2722       .
     2723       do
     2724       on stop undo, leave
     2725       on error undo, leave
     2726       :
     2727         assign
     2728           l-disable-where-22 =
     2729             (" X_ext-file.file-num < 2147483647 " + " " + where-phrase-22 = "")
     2730         .
     2731         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2732                             ,input query br-ipck:handle
     2733                             ,input parameter-3-22
     2734                             ,input parameter-4-22
     2735                             ,input parameter-5-22
     2736                             ,input parameter-6-22
     2737                             ,input parameter-7-22
     2738                             )
     2739         .
     2740         assign
     2741           l-filter-open-22 = true
     2742         .
     2743       end.
     2744       if l-filter-open-22 = false then do:
     2745         message
     2746           "Ошибка при фильтрации / сортировке" skip
     2747           "Будут показаны записи без учета фильтра" skip
     2748           view-as alert-box .
     2749       end.
