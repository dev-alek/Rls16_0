     4388     (input filter-point
     4389     ,output flt-rec-40
     4390     ,output filter-name-40
     4391     ,output where-phrase-40
     4392     ,output sort-phrase-40
     4393     ,output where-phrase-rus-40
     4394     ,output sort-phrase-rus-40
     4395     ).
     4396   if p-open-query then do:
     4397       run set-filter-name in this-procedure
     4398         (INPUT filter-name-40
     4399         ) no-error .
     4400     assign
     4401       l-filter-open-40 = false
     4402     .
     4403     if flt-rec-40 <> ?
     4404       or sort-column-phrase > ""
     4405     then do:
     4406       define variable  parameter-2-40 as character no-undo .
     4407       define variable  parameter-3-40 as character no-undo .
     4408       define variable  parameter-4-40 as character no-undo .
     4409       define variable  parameter-5-40 as character no-undo .
     4410       define variable  parameter-6-40 as character no-undo .
     4411       define variable  parameter-7-40 as character no-undo .
     4412         assign
     4413         parameter-3-40 =
     4414                                 "FOR EACH X_ext-file"
     4415         parameter-4-40 =
     4416           (
     4417             if (" (X_ext-file.file-num < 2147483647                         and X_ext-file.obj-type = '':U AND X_ext-file.obj-code = 0 AND X_ext-file.FILE-TYPE = X_EXT-FILE.FILE-NAME                         and X_ext-file.db-num = p-db-num and X_ext-file.file-name = p-file-name) " + " " + where-phrase-40) <> ""
     4418             then  substitute('(X_ext-file.file-num < 2147483647                         and X_ext-file.obj-type = &2&2 AND X_ext-file.obj-code = 0 AND X_ext-file.FILE-TYPE = X_EXT-FILE.FILE-NAME                         and X_ext-file.db-num = &1 and X_ext-file.file-name = &2&3&2)', p-db-num,  chr(34), p-file-name)  + " " + where-phrase-40
     4419             else "true"
     4420           )
     4421         parameter-5-40 = (" " + "" + " " + "")
     4422         parameter-6-40 = if sort-phrase-40 = ''
     4423                              then
     4424           (
     4425           " " + "  " +
     4426             " " + sort-column-phrase +
     4427           " " + "  "
     4428           )
     4429                              else
     4430           (
     4431           " " + "  " +
     4432             " " + sort-column-phrase +
     4433           " " + sort-phrase-40
     4434           )
     4435         parameter-7-40 =
     4436           " indexed-reposition  "
     4437       .
     4438       do
     4439       on stop undo, leave
     4440       on error undo, leave
     4441       :
     4442         assign
     4443           l-disable-where-40 =
     4444             (" (X_ext-file.file-num < 2147483647                         and X_ext-file.obj-type = '':U AND X_ext-file.obj-code = 0 AND X_ext-file.FILE-TYPE = X_EXT-FILE.FILE-NAME                         and X_ext-file.db-num = p-db-num and X_ext-file.file-name = p-file-name) " + " " + where-phrase-40 = "")
     4445         .
     4446         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4447                             ,input query br-ipck:handle
     4448                             ,input parameter-3-40
     4449                             ,input parameter-4-40
     4450                             ,input parameter-5-40
     4451                             ,input parameter-6-40
     4452                             ,input parameter-7-40
     4453                             )
     4454         .
     4455         assign
     4456           l-filter-open-40 = true
     4457         .
     4458       end.
     4459       if l-filter-open-40 = false then do:
     4460         message
     4461           "Ошибка при фильтрации / сортировке" skip
     4462           "Будут показаны записи без учета фильтра" skip
     4463           view-as alert-box .
     4464       end.
     4465       else do:
     4466           assign
     4467             l-query-was-opened = true
     4468           .
     4469       end.
     4470     end.
     4471     if l-filter-open-40 = false then do:
     4472       OPEN QUERY br-ipck FOR EACH X_ext-file
     4473         where  (X_ext-file.file-num < 2147483647                         and X_ext-file.obj-type = '':U AND X_ext-file.obj-code = 0 AND X_ext-file.FILE-TYPE = X_EXT-FILE.FILE-NAME                         and X_ext-file.db-num = p-db-num and X_ext-file.file-name = p-file-name)
     4474         indexed-reposition
     4475     .
     4476         assign
     4477           l-query-was-opened = true
     4478         .
     4479     end.
     4480   end.
     4481   else do:
     4482     assign
     4483       v-doc-rec = recid( X_ext-file )
     4484     .
     4485     do
     4486     on stop undo, leave
     4487     on error undo, leave
     4488     :
     4489       if query br-ipck:handle:get-buffer-handle(1) = (buffer X_ext-file:handle) then do:
     4490         assign
     4491         parameter-2-40 = (if p-find-next then "true":u else "false":u )
     4492         parameter-4-40 =
     4493           "where ":u +  substitute('(X_ext-file.file-num < 2147483647                         and X_ext-file.obj-type = &2&2 AND X_ext-file.obj-code = 0 AND X_ext-file.FILE-TYPE = X_EXT-FILE.FILE-NAME                         and X_ext-file.db-num = &1 and X_ext-file.file-name = &2&3&2)', p-db-num,  chr(34), p-file-name)  + " ":u + where-phrase-40 + " ":u + p-find-condition + " " + ""
     4494         parameter-5-40 = "  "
     4495       .
     4496         run fltopend_fltfindd in this-procedure  (
     4497                             input this-procedure:handle
     4498                             ,input query br-ipck:handle
     4499                             ,input rowid(X_ext-file)
     4500                             ,input logical(parameter-2-40)
     4501                             ,input no-lock
     4502                             ,input (buffer X_ext-file:handle)
     4503                             ,input parameter-4-40
     4504                             ,input parameter-5-40
     4505                             ) no-error.
     4506         .
     4507         assign
     4508           v-doc-rec = integer(return-value)
     4509           v-fltopend-rowid[1] = ?
     4510         .
     4511       end.
     4512       else do:
     4513         assign
     4514         parameter-2-40 = (if p-find-next then "true":u else "false":u )
     4515         parameter-3-40 =  "FOR EACH X_ext-file"
     4516         parameter-4-40 =
     4517           (
     4518             if (" (X_ext-file.file-num < 2147483647                         and X_ext-file.obj-type = '':U AND X_ext-file.obj-code = 0 AND X_ext-file.FILE-TYPE = X_EXT-FILE.FILE-NAME                         and X_ext-file.db-num = p-db-num and X_ext-file.file-name = p-file-name) " + " " + where-phrase-40) <> ""
     4519             then  substitute('(X_ext-file.file-num < 2147483647                         and X_ext-file.obj-type = &2&2 AND X_ext-file.obj-code = 0 AND X_ext-file.FILE-TYPE = X_EXT-FILE.FILE-NAME                         and X_ext-file.db-num = &1 and X_ext-file.file-name = &2&3&2)', p-db-num,  chr(34), p-file-name)  + " " + where-phrase-40
     4520             else "true"
     4521           )
     4522         parameter-5-40 = (" " + "" + " " + "" + " " + p-find-condition)
     4523         parameter-6-40 = if sort-phrase-40 = ''
     4524                              then
     4525           (
     4526           " " + "  " +
     4527             " " + sort-column-phrase +
     4528           " " + "  "
     4529           )
     4530                              else
     4531           (
     4532           " " + "  " +
     4533             " " + sort-column-phrase +
     4534           " " + sort-phrase-40
     4535           )
     4536         parameter-7-40 =
     4537           " indexed-reposition  "
     4538       .
     4539         run fltopend_fltfindq in this-procedure  (
     4540                             input this-procedure:handle
     4541                             ,input query br-ipck:handle
     4542                             ,input logical(parameter-2-40)
     4543                             ,input no-lock
     4544                             ,input parameter-3-40
     4545                             ,input parameter-4-40
     4546                             ,input parameter-5-40
     4547                             ,input parameter-6-40
     4548                             ,input parameter-7-40
     4549                             ,output v-fltopend-rowid
     4550                             ) no-error.
     4551         .
     4552         v-doc-rec = ?.
     4553       end.
     4554       assign
     4555         l-query-was-opened = true
     4556       .
     4557     end.
     4558   end.
     4559     run waitfram-hide in this-procedure .
     4560         END.
     4561       END.
     4562     end.
     4563   END CASE.
     4564   if not p-open-query then
     4565   REPOSITION br-ipck to recid v-doc-rec No-ERROR.
     4566   if not p-open-query and v-fltopend-rowid[1] <> ? then
     4567   query br-ipck:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     4568   run waitfram-hide in this-procedure.
     4569   APPLY "VALUE-CHANGED" TO br-ipck in frame Dialog-Frame.
     4570   APPLY "ENTRY" TO br-ipck.
     4571   END PROCEDURE.
     4572   PROCEDURE proc-b-add :
     4573   DEFINE INPUT PARAMETER p-add-option AS CHARACTER NO-UNDO.
     4574   define variable v_manifest-file as character no-undo .
     4575   define variable ll_commit as logical no-undo .
     4576   define variable v-db-num as integer no-undo .
     4577   define variable v-rid as recid no-undo .
     4578   DEFINE buffer buf_db FOR ub.db.
     4579   CASE p-add-option:
     4580     WHEN 'auto':U THEN DO:
     4581       IF p-all-or-upg = 0 THEN DO:
     4582         run nws/sndfnws.w ( INPUT parparentproc
     4583                        ,INPUT ""
     4584                        ,input ?
     4585                        ,input ?
     4586                        ,input 'auto':U ) no-error.
     4587       END.
     4588       IF p-all-or-upg = 1 THEN DO:
     4589         run nws/sndfnws.w ( INPUT parparentproc
     4590                        ,INPUT 'save-install':U
     4591                        ,input ?
     4592                        ,input ?
     4593                        ,input '':U ) no-error.
     4594       END.
     4595     END.
     4596     WHEN 'manual':U THEN DO:
     4597       IF p-all-or-upg = 0 THEN DO:
     4598         run nws/sndfnws.w ( INPUT parparentproc
     4599                        ,INPUT 'save-this-db':U
     4600                        ,input v-cntxt-db-num
     4601                        ,input v-cntxt-db-num
     4602                        ,input '':U ) no-error.
     4603       END.
     4604       IF p-all-or-upg = 1 THEN DO:
     4605         IF p-db-num = ?
     4606         OR p-db-num < 0 THEN DO:
     4607           IF v-cntxt-db-num = 0 THEN DO:
     4608             run adm/dbs.w ( INPUT parparentproc
     4609                     ,INPUT 'ПРОСМОТР':U
     4610                     ,OUTPUT v-rid) NO-ERROR.
     4611             IF ERROR-STATUS:ERROR THEN RETURN ERROR.
     4612             FIND FIRST buf_db NO-LOCK WHERE
     4613                     recid(buf_db) = v-rid .
     4614           END.
     4615           ELSE DO:
     4616               FIND FIRST buf_db NO-LOCK WHERE
     4617                       buf_db.db-num = v-cntxt-db-num.
     4618           END.
     4619         END.
     4620         run nws/sndfnws.w ( INPUT parparentproc
     4621                        ,INPUT 'save-install':U
     4622                        ,input buf_db.db-num
     4623                        ,input v-cntxt-db-num
     4624                        ,input 'manual':U ) no-error.
     4625       END.
     4626      END.
     4627   END CASE.
     4628   run OpenBr in this-procedure ( input yes, input no, input no) .
     4629   END PROCEDURE.
     4630   PROCEDURE proc-b-del :
     4631   DEFINE INPUT PARAMETER p-del-option AS CHARACTER NO-UNDO.
     4632   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     4633   DEFINE VARIABLE glog AS logical NO-UNDO.
     4634   define variable v-loc-rid-list as character no-undo .
     4635   define variable v-entry as character no-undo .
     4636   DEFINE BUFFER buf_exT-FILE FOR UB.EXT-FILE.
     4637   CASE p-all-or-upg :
     4638     WHEN 0 THEN DO:
     4639       if v-rid-list = '':U then do:
     4640         MESSAGE
     4641         "Вы действительно хотите удалить запись о выделенном файле?" skip
     4642         "(с диска файла не удаляется)" skip
     4643         VIEW-AS ALERT-BOX QUESTION buttons YES-NO UPDATE glog.
     4644         IF NOT glog THEN RETURN.
     4645         v-loc-rid-list = string(recid(X_ext-file)).
     4646       end.
     4647       else  do:
     4648         MESSAGE
     4649         "Вы действительно хотите удалить записи о выделенных файлах?" skip
     4650         "(с диска файлы не удаляются)" skip
     4651         VIEW-AS ALERT-BOX QUESTION buttons YES-NO UPDATE glog.
     4652         IF NOT glog THEN RETURN.
     4653         v-loc-rid-list = v-rid-list.
     4654       end.
     4655       DO ii = 1 TO NUM-ENTRIES(v-loc-rid-list):
     4656         FIND FIRST BUF_EXT-FILE NO-LOCK WHERE
     4657                   RECID(BUF_eXT-FILE) = INTEGER( ENTRY(II, V-loc-RID-LIST)) NO-ERROR.
     4658          IF AVAILABLE BUF_eXT-FILE  THEN DO:
     4659             v-entry = string(recid(buf_ext-file)).
     4660             run adm/extf-del.p ( BUFFER BUF_eXT-FILE
     4661                                , input no
     4662                                , INPUT buf_ext-file.status_) no-error .
     4663             if error-status:error then do:
     4664               message
     4665               substitute("Ошибка при удалении файла БД&1&2№ файла &3&2&4&2&5&2&6"
     4666                           , buf_ext-file.db-num
     4667                           , chr(10)
     4668                           , buf_Ext-file.file-num
     4669                           , buf_ext-file.file-name
     4670                           , error-status:get-message(1)
     4671                           , return-value )
     4672               view-as alert-box error.
     4673             end.
     4674             else do:
     4675               entry(lookup(v-entry, v-rid-list), v-rid-list) = ''.
     4676               v-rid-list = replace(v-rid-list, chr(44) + chr(44), chr(44)).
     4677               v-rid-list = trim(v-rid-list, chr(44)).
     4678               if num-entries( v-rid-list ) > 0 then do:
     4679                 DISPLAY
     4680                 num-entries( v-rid-list ) @ mark-num
     4681                 with frame Dialog-Frame.
     4682               end.
     4683               else do:
     4684                 hide
     4685                 mark-num
     4686                 in frame Dialog-Frame .
     4687               end.
     4688             end.
     4689          END.
     4690       END.
     4691     END.
     4692     WHEN 1 THEN DO:
     4693      if v-rid-list = '':U then do:
     4694         MESSAGE
     4695         "Вы действительно хотите разрегистровать выделенный пакет/пакеты"
     4696         VIEW-AS ALERT-BOX QUESTION buttons YES-NO UPDATE glog.
     4697         IF NOT glog THEN RETURN.
     4698         v-loc-rid-list = string(recid(X_ext-file)).
     4699      end.
     4700      else do:
     4701         MESSAGE
     4702         "Вы действительно хотите разрегистровать выделенный пакет/пакеты"
     4703         VIEW-AS ALERT-BOX QUESTION buttons YES-NO UPDATE glog.
     4704         IF NOT glog THEN RETURN.
     4705         v-loc-rid-list = v-rid-list.
     4706      end.
     4707       DO ii = 1 TO NUM-ENTRIES(v-loc-rid-list):
     4708         FIND FIRST BUF_EXT-FILE NO-LOCK WHERE
     4709                   RECID(BUF_eXT-FILE) = INTEGER( ENTRY(II, V-loc-RID-LIST)) NO-ERROR.
     4710         IF AVAILABLE BUF_eXT-FILE  THEN DO:
     4711           v-entry = string(recid(buf_ext-file)).
     4712           run adm/extf-del.p ( BUFFER BUF_eXT-FILE
     4713                              , input no
     4714                              , INPUT P-DEL-OPTION) no-error .
     4715           if error-status:error then do:
     4716              message
     4717              substitute("Ошибка при удалении файла БД&1 (от БД &2)&3№ файла &4&3&5&3&6&3&7"
     4718                          , buf_ext-file.db-num
     4719                          , buf_ext-file.from-db-num
     4720                          , chr(10)
     4721                          , buf_Ext-file.file-num
     4722                          , buf_ext-file.file-name
     4723                          , error-status:get-message(1)
     4724                          , return-value )
     4725              view-as alert-box error.
     4726           end.
     4727           else do:
     4728             entry(lookup(v-entry, v-rid-list), v-rid-list) = ''.
     4729             v-rid-list = replace(v-rid-list, chr(44) + chr(44), chr(44)).
     4730             v-rid-list = trim(v-rid-list, chr(44)).
     4731             if num-entries( v-rid-list ) > 0 then do:
     4732               DISPLAY
     4733               num-entries( v-rid-list ) @ mark-num
     4734               with frame Dialog-Frame.
     4735             end.
     4736             else do:
     4737               hide
     4738               mark-num
     4739               in frame Dialog-Frame .
     4740             end.
     4741           end.
     4742         END.
     4743       END.
     4744     END.
     4745   END CASE.
     4746   run OpenBr in this-procedure ( input yes, input no, input no) .
     4747   END PROCEDURE.
     4748   PROCEDURE proc-b-sch :
     4749   assign
     4750     tbl = 'ext-file'
     4751     join-tbl = 'X_ext-file'
     4752     fld = ""
     4753     lab = ""
     4754     spr = ""
     4755     dim = '0'
     4756     .
     4757   run fltfield-add in this-procedure('db-num', 'для БД', 'db',
     4758   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4759   run fltfield-add in this-procedure('from-db-num', 'из БД', 'db',
     4760   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4761   run fltfield-add in this-procedure('file-size', 'Размер', 'db',
     4762   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4763   run fltfield-add in this-procedure('file-name', 'Файл манифеста', '',
     4764   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4765   run fltfield-add in this-procedure('status_', 'Статус', '',
     4766   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4767   run fltfield-add in this-procedure('update-sys-date', 'Дата установки', '',
     4768   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4769   Filter-Block:
     4770   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4771       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4772       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4773     run gbl/filter.w ( INPUT parparentproc
     4774                       , INPUT (filter-point + chr(4) +
     4775                               filter-point-name)
     4776                       , INPUT tbl
     4777                       , INPUT join-tbl
     4778                       , INPUT fld
     4779                       , INPUT lab
     4780                       , INPUT spr
     4781                       , INPUT dim ).
     4782     run OpenBr in this-procedure ( input yes, input no, input '':U).
     4783   END.
     4784   END PROCEDURE.
     4785   PROCEDURE proc-lkp :
     4786   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     4787   DEFINE VARIABLE v-override AS INTEGER no-UNDO.
     4788   DEFINE VARIABLE v-printed AS logical no-UNDO.
     4789   DEFINE VARIABLE v-temp-file-name AS CHARACTER NO-UNDO.
     4790   run gbl/_tmpfile.p (
     4791          input  't':U
     4792         ,input  "." + entry( num-entries(X_ext-file.file-name, "."), X_ext-file.FILE-NAME, ".")
     4793         ,output v-temp-file-name
     4794         ) .
     4795   run adm/extfsavd.p (
     4796                INPUT X_ext-file.db-num
     4797               ,INPUT X_ext-file.from-db-num
     4798               ,INPUT X_ext-file.file-num
     4799               ,INPUT v-temp-file-name
     4800               ,INPUT-OUTPUT v-override) NO-ERROR.
     4801   IF ERROR-STATUS:ERROR THEN DO:
     4802     MESSAGE
     4803     SUBSTITUTE("Ошибка при сохранении файла &1 на диск во временный файл&2&3&2&4&2"
     4804             , X_ext-file.FILE-NAME
     4805             , chr(10)
     4806             ,error-status:get-message(1)
     4807             , RETURN-VALUE)
     4808     VIEW-AS ALERT-BOX ERROR.
     4809     RETURN ERROR.
     4810   END.
     4811   os-command  value ('start /wait /b ' + v-temp-file-name).
     4812   OS-DELETE VALUE(v-temp-file-name).
     4813   END PROCEDURE.
     4814   PROCEDURE proc-save-disk :
     4815   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     4816   DEFINE VARIABLE v-override AS INTEGER no-UNDO.
     4817   DEFINE VARIABLE v-dir-path AS CHARACTER NO-UNDO.
     4818   DEFINE VARIABLE v-dir-type AS CHARACTER NO-UNDO.
     4819   DEFINE VARIABLE v-can-write AS logical NO-UNDO.
     4820   DEFINE VARIABLE v-num-files AS integer NO-UNDO.
     4821   DEFINE VARIABLE v-ok AS integer NO-UNDO.
     4822   DEFINE VARIABLE ii AS integer NO-UNDO.
     4823   DEFINE VARIABLE v-loc-rid-list AS CHARACTER NO-UNDO.
     4824   DEFINE BUFFER buf_Ext-file FOR ub.ext-file.
     4825   MESSAGE
     4826   "Вы действительно хотите сохранить на диск выбранный файл/файлы?"
     4827   VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     4828   IF NOT glog THEN RETURN.
     4829    run gbl/dir-sel.p (
     4830                     output v-dir-path
     4831                   , output v-dir-type
     4832                   , output v-can-write
     4833                         )
     4834   .
     4835   if not v-can-write then do:
     4836       message
     4837       substitute("Вы не имеет прав на запись в выбранный каталог &1", v-dir-path)
     4838       view-as alert-box error .
     4839       return error.
     4840   end.
     4841   IF v-rid-list = '':U THEN DO:
     4842     v-loc-rid-list = STRING(RECID(X_ext-file)).
     4843   END.
     4844   ELSE DO:
     4845     v-loc-rid-list = v-rid-list.
     4846   END.
     4847   v-num-files = NUM-ENTRIES(v-loc-rid-list).
     4848   _ii:
     4849   DO ii = 1 TO v-NUM-files
     4850   on stop UNDO _ii, NEXT _ii:
     4851     FIND FIRST buf_ext-file NO-LOCK WHERE
     4852              recid(buf_Ext-file) = INTEGER(ENTRY(ii, v-loc-rid-list)) NO-ERROR.
     4853     IF NOT AVAILABLE buf_ext-file THEN NEXT _ii.
     4854     run adm/extfsavd.p (
     4855                    INPUT buf_ext-file.db-num
     4856                   ,INPUT buf_ext-file.from-db-num
     4857                   ,INPUT buf_ext-file.file-num
     4858                   ,INPUT v-dir-path
     4859                   ,INPUT-OUTPUT v-override) NO-ERROR.
     4860     IF ERROR-STATUS:ERROR THEN DO:
     4861       MESSAGE
     4862       SUBSTITUTE("Ошибка при сохранении файла &1 на диск&2&3&2&4&2"
     4863                 , buf_ext-file.FILE-NAME
     4864                 , chr(10)
     4865                 ,error-status:get-message(1)
     4866                 , RETURN-VALUE)
     4867       VIEW-AS ALERT-BOX ERROR.
     4868       RETURN ERROR.
     4869     END.
     4870     ELSE DO:
     4871         v-ok = v-ok + 1.
     4872     END.
     4873   END.
     4874   IF v-ok <> v-NUM-files THEN DO:
     4875      MESSAGE
     4876      SUBSTITUTE("Выбрано файлов &1, удалось сохранить на диск &2"
     4877                 , v-num-files
     4878                 , v-ok)
     4879      VIEW-AS ALERT-BOX.
     4880   END.
     4881   END PROCEDURE.
