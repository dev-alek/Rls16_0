     4313                             ,input parameter-4-38
     4314                             ,input parameter-5-38
     4315                             ) no-error.
     4316         .
     4317         assign
     4318           v-doc-rec = integer(return-value)
     4319           v-fltopend-rowid[1] = ?
     4320         .
     4321       end.
     4322       else do:
     4323         assign
     4324         parameter-2-38 = (if p-find-next then "true":u else "false":u )
     4325         parameter-3-38 =  "FOR EACH X_ext-file"
     4326         parameter-4-38 =
     4327           (
     4328             if (" (X_ext-file.file-num < 2147483647                           and X_ext-file.obj-type = '':U AND X_ext-file.obj-code = 0 AND X_ext-file.FILE-TYPE = X_EXT-FILE.FILE-NAME                           and X_ext-file.db-num = p-db-num and X_ext-file.status_ = p-status_) " + " " + where-phrase-38) <> ""
     4329             then  substitute('(X_ext-file.file-num < 2147483647                           and X_ext-file.obj-type = &2&2 AND X_ext-file.obj-code = 0 AND X_ext-file.FILE-TYPE = X_EXT-FILE.FILE-NAME                           and X_ext-file.db-num = &1 and X_ext-file.status_ = &2&3&2)', p-db-num , chr(34), p-status_)  + " " + where-phrase-38
     4330             else "true"
     4331           )
     4332         parameter-5-38 = (" " + "" + " " + "" + " " + p-find-condition)
     4333         parameter-6-38 = if sort-phrase-38 = ''
     4334                              then
     4335           (
     4336           " " + "  " +
     4337             " " + sort-column-phrase +
     4338           " " + "  "
     4339           )
     4340                              else
     4341           (
     4342           " " + "  " +
     4343             " " + sort-column-phrase +
     4344           " " + sort-phrase-38
     4345           )
     4346         parameter-7-38 =
     4347           " indexed-reposition  "
     4348       .
     4349         run fltopend_fltfindq in this-procedure  (
     4350                             input this-procedure:handle
     4351                             ,input query br-ipck:handle
     4352                             ,input logical(parameter-2-38)
     4353                             ,input no-lock
     4354                             ,input parameter-3-38
     4355                             ,input parameter-4-38
     4356                             ,input parameter-5-38
     4357                             ,input parameter-6-38
     4358                             ,input parameter-7-38
     4359                             ,output v-fltopend-rowid
     4360                             ) no-error.
     4361         .
     4362         v-doc-rec = ?.
     4363       end.
     4364       assign
     4365         l-query-was-opened = true
     4366       .
     4367     end.
     4368   end.
     4369     run waitfram-hide in this-procedure .
     4370         END.
     4371       END.
     4372       ELSE DO:
     4373           ASSIGN
     4374           frame Dialog-Frame:TITLE = SUBStITUTE("&1 БД &2 Пакет &3", title01, p-db-num, p-file-name).
     4375   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4376   define variable  l-disable-where-40  as logical   no-undo .
     4377   define variable  l-filter-open-40    as logical   .
     4378   define variable  flt-rec-40       as recid     no-undo .
     4379   define variable  filter-name-40      as character no-undo .
     4380   define variable  where-phrase-40     as character no-undo .
     4381   define variable  sort-phrase-40      as character no-undo .
     4382   define variable  where-phrase-rus-40 as character no-undo .
     4383   define variable  sort-phrase-rus-40  as character no-undo .
     4384     run waitfram-show in this-procedure
     4385       (input "ЖДИТЕ ..."
     4386       ).
