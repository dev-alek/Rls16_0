        1   block-level on error undo, throw.
        2   define input  parameter parparentproc  as widget-handle no-undo.
        3   define input  parameter p-user-id      as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: usr-ph.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: adm/usr-ph.p $":U .
        9   define variable vss-description as character no-undo init "Показать изображение клиента".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   PROCEDURE verify-ini-entry:
       72   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
       73   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
       74   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
       75   DEFINE INPUT  PARAMETER silence          as logical no-undo.
       76   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
       77   define variable v-mess as character no-undo .
       78   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
       79   if ini-entry-value = ? and ini-key-name begins "spl"
       80   then
       81   get-key-value section ini-section-name key "splall" value ini-entry-value.
       82   if ini-entry-value = ? and ini-key-name begins "sav"
       83   then
       84   get-key-value section ini-section-name key "savall" value ini-entry-value.
       85   if ini-entry-value = ? then do:
       86     assign
       87     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
       88                       , chr(10)
       89                       , ini-section-name
       90                       , ini-key-name
       91                       , error-msg-text).
       92       if not silence then do:
       93         message
       94         v-mess
       95         view-as alert-box ERROR  .
       96         return error.
       97       end.
       98       else do:
       99         return error v-mess.
      100       end.
      101   end.
      102   END PROCEDURE.
      103   PROCEDURE verify-file:
      104   DEFINE INPUT  PARAMETER filename       as character no-undo.
      105   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
      106   DEFINE INPUT  PARAMETER silence        as logical no-undo.
      107   DEFINE OUTPUT PARAMETER found          as logical no-undo.
      108   file-info:file-name = filename.
      109   found = NOT (file-info:full-pathname = ?).
      110   if NOT found  then do:
      111     if not silence then do:
      112       message error-msg-text
      113       view-as alert-box ERROR.
      114       return error.
      115     end.
      116     else return error error-msg-text.
      117   end.
      118   END PROCEDURE.
      119   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      120     define variable v-cntxt-db-num        as integer   no-undo .
      121     define variable v-cntxt-userid        as character no-undo .
      122     define variable v-cntxt-level         as character no-undo .
      123     define variable v-cntxt-host-code-obj as integer   no-undo .
      124     define variable v-cntxt-obj-type      as character no-undo .
      125     define variable v-cntxt-obj-code      as integer   no-undo .
      126     define variable v-cntxt-db-num-obj    as integer   no-undo .
      127     define variable v-cntxt-is-admin      as logical   no-undo .
      128   define variable loc#log    as logical   no-undo .
      129   define variable v-can-edit as logical no-undo .
      130   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      131     run mainmenu_getcntxt in parparentproc
      132       (output v-cntxt-db-num
      133       ,output v-cntxt-userid
      134       ,output v-cntxt-level
      135       ,output v-cntxt-host-code-obj
      136       ,output v-cntxt-obj-type
      137       ,output v-cntxt-obj-code
      138       ,output v-cntxt-db-num-obj
      139       ,output v-cntxt-is-admin
      140       ) .
      141   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      142   do:
      143     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      144       (input  v-cntxt-db-num
      145       ,input  v-cntxt-userid
      146       ,input  0
      147       ,input  'actn_rights_update':U
      148       ,input  'global':U
      149       ,input  0
      150       ,input  '':U
      151       ,input  0
      152       ,input  0
      153       ,input  0
      154       ,input  0
      155       ,input  true
      156       ,output v-can-edit
      157       )  .
      158   end.
      159   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      160   define variable stat                 as character no-undo .
      161   define variable Path-To-Dir-Pictures as character no-undo .
      162   define variable Path-To-Pictures     as character no-undo .
      163   define variable v-ii                 as integer no-undo .
      164   define variable v-param-type as character no-undo .
      165   define variable v-value-date as date no-undo .
      166   define variable v-value-decimal as decimal no-undo .
      167   define variable v-value-integer as INTEGER no-undo .
      168   define variable v-value-logical AS LOGICAL no-undo .
      169   define variable v-tth as handle no-undo .
      170   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      171   DEFINE VARIABLE v-image-order      AS CHARACTER NO-UNDO INIT "jpg,bmp":U.
      172   define variable v-image-format     as character extent 62 init
      173   [
      174    "Windows bitmap                                                          ", "*.bmp"
      175   ,"Computer-aided Acquisition and Logistics Support                        ", "*.cal"
      176   ,"Microsoft Windows Clipboard                                             ", "*.clp"
      177   ,"Halo CUT                                                                ", "*.cut"
      178   ,"Intel FAX format                                                        ", "*.dcx"
      179   ,"Windows device-independent bitmap                                       ", "*.dib"
      180   ,"Encapsulated PostScript                                                 ", "*.eps"
      181   ,"1 Graphics Interchange Format                                           ", "*.gif"
      182   ,"IBM IOCA                                                                ", "*.ica"
      183   ,"Microsoft Icon File format                                              ", "*.ico"
      184   ,"Amiga IFF                                                               ", "*.iff"
      185   ,"GEM bitmap                                                              ", "*.img"
      186   ,"Joint Bi-level Image Experts Group                                      ", "*.jbig"
      187   ,"JPEG                                                                    ", "*.jpg"
      188   ,"serView                                                                 ", "*.lv "
      189   ,"Macintosh MacPaint                                                      ", "*.mac"
      190   ,"Microsoft Windows Paint                                                 ", "*.msp"
      191   ,"Kodak Photo CD                                                          ", "*.pcd"
      192   ,"Macintosh PICT                                                          ", "*.pct"
      193   ,"PC Paintbrush                                                           ", "*.pcx"
      194   ,"GIF (Graphics Interchange Format) replacement                           ", "*.png"
      195   ,"Adobe Photoshop                                                         ", "*.psd"
      196   ,"Sun Raster (1-, 8-, 24-, or 32-bit Standard, BGR, RGB, and byte encoded)", "*.ras"
      197   ,"TARGA                                                                   ", "*.tga"
      198   ,"Tag image file format                                                   ", "*.tif"
      199   ,"Windows bitmap for wireless devices                                     ", "*.wbmp"
      200   ,"Windows metafiles                                                       ", "*.wmf"
      201   ,"WordPerfect graphics                                                    ", "*.wpg"
      202   ,"(also .bm) X bitmap                                                     ", "*.xbm"
      203   ,"Pixmap                                                                  ", "*.xpm"
      204   ,"UNIX X Window Dump File format                                          ", "*.xwd"
      205   ] no-undo.
      206   procedure get-custom-img-order :
      207   define output parameter p-descriptions as character no-undo .
      208   define output parameter p-extensiond   as character no-undo .
      209   define output parameter p-extensiont   as character no-undo .
      210   define variable ii as integer no-undo .
      211   define variable v-entry as integer no-undo .
      212     do
      213     on error undo, return error
      214     :
      215       assign
      216       p-descriptions = fill(chr(4), 30)
      217       p-extensiond   = fill(chr(4), 30)
      218       p-extensiont   = fill(chr(4), 30)
      219       .
      220       do ii = 2 to 62 by 2:
      221         assign
      222         v-entry = lookup(left-trim(v-image-format[ii], ".*"), v-image-order)
      223         .
      224         if v-entry > 0 then do:
      225           assign
      226           entry(v-entry, p-descriptions, chr(4)) = substitute("&1 &2", trim(v-image-format[ii - 1]), v-image-format[ii])
      227           entry(v-entry, p-extensiond, chr(4)) = v-image-format[ii]
      228           entry(v-entry, p-extensiont, chr(4)) = left-trim(v-image-format[ii], ".*")
      229           .
      230         end.
      231       end.
      232       assign
      233       p-descriptions = trim(p-descriptions, chr(4))
      234       p-extensiond   = trim(p-extensiond, chr(4))
      235       p-extensiont   = trim(p-extensiont, chr(4))
      236       p-descriptions = replace(p-descriptions, (chr(4) + chr(4)), chr(4))
      237       p-extensiond   = replace(p-extensiond, (chr(4) + chr(4)),  chr(4))
      238       p-extensiont   = replace(p-extensiont, (chr(4) + chr(4)), chr(4))
      239       .
      240     end.
      241   end procedure.
      242   do:
      243     RUN verify-ini-entry("pict_path":U,
      244                           "REP-SETS":U,
      245                           "не определен путь к подкаталогу для хранения фото товара" + chr(10) +
      246                           "отсутствует параметр pict_path, секция [REP-SETS] ini-файла",
      247                           no,
      248                           output Path-To-Dir-Pictures) no-error.
      249     if error-status:error or Path-To-Dir-Pictures = ? then return error.
      250     RUN verify-file(Path-To-Dir-Pictures,
      251                     "Не найден каталог " + Path-To-Dir-Pictures + chr(10) +
      252                     "параметр pict_path, секция [REP-SETS] ini-файла",
      253                     no,
      254                     output loc#log) no-error.
      255     if error-status:error or not loc#log then return error.
      256     RUN verify-file((Path-To-Dir-Pictures + "usr\"),
      257                     "Не найден подкаталог " + Path-To-Dir-Pictures + "usr\",
      258                     no,
      259                     output loc#log) no-error.
      260     if error-status:error or not loc#log then return error.
      261     run adm/shattri.p (
      262         input "get":U
      263         ,input  ''
      264         ,input  0
      265         ,input  'images':U
      266         ,input  'imgorder':U
      267         ,output v-image-order
      268         ,output v-value-date
      269         ,output v-value-decimal
      270         ,output v-value-integer
      271         ,output v-value-logical
      272         ,output v-param-type
      273         ,INPUT-OUTPUT table-handle v-tth
      274         ) no-error .
      275     delete object v-tth.
      276     if error-status:error
      277     or v-image-order = '':U then
      278     v-image-order = "jpg,bmp".
      279      assign
      280      Path-To-Pictures = Path-To-Dir-Pictures + "usr\" + string( p-user-id )
      281      .
      282     if length( Path-To-Pictures ) > 56 then do:
      283       message
      284         "Слишком длинное имя файла ( с учетом полного пути )."
      285         view-as alert-box error .
      286     end.
      287     do v-ii = 1 to num-entries(v-image-order):
      288       assign
      289         stat = search( Path-To-Pictures  + "." + entry(v-ii, v-image-order) )
      290       .
      291       if stat <> ? then leave.
      292     end.
      293     if stat <> ? then do:
      294       run ref/view-pic.w ( Path-To-Pictures, entry(v-ii, v-image-order), if v-can-edit then "b-update" else "":U ) .
      295     end.
      296     else do:
      297       if not v-can-edit then do:
      298         message
      299         "Изображение отсутствует"
      300         view-as alert-box .
      301         RETURN.
      302       end.
      303       run ref/photo-n.w ( Path-To-Pictures, 'ДОБАВЛЕНИЕ':U  ) .
      304     end.
      305   end.
