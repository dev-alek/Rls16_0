        1   block-level on error undo, throw.
        2   define input parameter  p-db-num         as integer    no-undo .
        3   define input parameter  p-task-type      as character  no-undo.
        4   define input parameter  p-task-num       as integer    no-undo.
        5   define input parameter  p-code           as character  no-undo.
        6   define parameter buffer pbuf_schedule-attr for ub.schedule-attr.
        7   def var vss-revision    as character no-undo init "$Revision: aeb9a0c708e2, 18, test $":U .
        8   def var vss-author      as character no-undo init "$Author: SKiryxin $":U .
        9   def var vss-date        as character no-undo init "$Date: Wed Mar 05 12:57:20 2014 +0300 $":U .
       10   def var vss-workfile    as character no-undo init "$Workfile: lockshda.p $":U .
       11   def var vss-archive     as character no-undo init "$Archive: adm/lockshda.p $":U .
       12   def var vss-description as character no-undo init "Блокировка атрибутов расписаниЯ".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31       assign
       32         p-vss-parameters = substitute('&1|&2|&3|&4':u,p-db-num,p-task-type,p-task-num,p-code )
       33       .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   define temp-table temp-schedule-free no-undo
       76   field free-id as character
       77   field free-task-name as character
       78   field proc-run-name as character
       79   field proc-param-edit-name as character
       80   field conf-param as character
       81   field is-gbd as logical
       82   field is-ubd as logical
       83   field enable-concurrent-0 as logical
       84   field enable-concurrent-db as logical
       85   field other-info as character
       86   field enc-key as character
       87   field is-rum as logical
       88   index pi is unique primary
       89   free-id.
       90   procedure schedule-attr-name :
       91   do
       92     on error undo, return error
       93     :
       94     define input  parameter p-code           as character no-undo .
       95     define output parameter p-type           as character no-undo .
       96     define output parameter p-format         as character no-undo .
       97     define output parameter p-label          as character no-undo .
       98     define output parameter p-user-can-edit  as logical   no-undo .
       99     define output parameter p-output-display as logical   no-undo .
      100     define output parameter p-other          as character no-undo .
      101       if index(p-code, chr(4)) > 0 then do:
      102         p-code = entry(1, p-code, chr(4)).
      103       end.
      104       case p-code :
      105               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      106               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      107               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      108               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      109               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      110               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      111               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      112               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      113               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      114         otherwise do:
      115           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      116         end.
      117       end.
      118     end.
      119   end procedure.
      120   procedure schedule-attr-tooltip :
      121   do
      122     on error undo, return error
      123     :
      124       define input  parameter p-code    as character no-undo .
      125       define output parameter p-tooltip as character no-undo .
      126       define output parameter p-label   as character no-undo .
      127       if index(p-code, chr(4)) > 0 then do:
      128         p-code = entry(1, p-code, chr(4)).
      129       end.
      130       case p-code :
      131               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      132               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      133               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      134               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      135               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      136               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      137               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      138               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      139               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      140         otherwise do:
      141               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      142         end.
      143       end.
      144     end.
      145   end procedure.
      146   procedure schedule-attr-value :
      147   do
      148   on error undo, return error return-value
      149   :
      150   define input parameter  p-cre-db-num as integer    no-undo.
      151   define input parameter  p-task-type  as character  no-undo.
      152   define input parameter  p-task-num   as integer    no-undo.
      153   define input parameter  p-code       as character  no-undo.
      154   define output parameter p-value      as character  no-undo.
      155   define output parameter p-type       as character  no-undo.
      156       define variable v-format         as character no-undo .
      157       define variable v-label          as character no-undo .
      158       define variable v-user-can-edit  as logical   no-undo .
      159       define variable v-output-display as logical   no-undo .
      160       define variable v-other          as character no-undo .
      161       define buffer buf_schedule-attr for ub.schedule-attr.
      162       run schedule-attr-name in this-procedure (
      163             input  p-code
      164           , output p-type
      165           , output v-format
      166           , output v-label
      167           , output v-user-can-edit
      168           , output v-output-display
      169           , output v-other
      170       ) no-error .
      171       if error-status :error
      172       then do:
      173           undo, return error return-value .
      174       end.
      175       if p-code begins ('schd-free-id':U + chr(4))
      176       and entry(2, p-code, chr(4)) = '':U then do:
      177         find first buf_schedule-attr no-lock
      178             where buf_schedule-attr.cre-db-num = p-cre-db-num
      179               and buf_schedule-attr.task-type  = p-task-type
      180               and buf_schedule-attr.task-num   = p-task-num
      181               and buf_schedule-attr.attr-code  begins p-code
      182         no-error .
      183       end.
      184       else do:
      185         find first buf_schedule-attr no-lock
      186             where buf_schedule-attr.cre-db-num = p-cre-db-num
      187               and buf_schedule-attr.task-type  = p-task-type
      188               and buf_schedule-attr.task-num   = p-task-num
      189               and buf_schedule-attr.attr-code  = p-code
      190         no-error .
      191       end.
      192       if available buf_schedule-attr
      193       then do:
      194           assign
      195               p-value = buf_schedule-attr.attr-value
      196           .
      197       end.
      198       else do:
      199         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      200            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      201         end.
      202         else do:
      203           assign
      204               p-value = if p-type = 'L':U then "no":U else ""
      205           .
      206         end.
      207       end.
      208   end.
      209   end procedure.
      210   procedure schedule-attr-write :
      211   do
      212   on error undo, return error
      213   :
      214   define input parameter p-cre-db-num  as integer   no-undo.
      215   define input parameter p-task-type   as character no-undo.
      216   define input parameter p-task-num    as integer   no-undo.
      217   define input parameter p-code        as character no-undo.
      218   define input parameter p-value       as character no-undo.
      219       define variable v-type              as character                no-undo.
      220       define variable v-format            as character                no-undo.
      221       define variable v-label             as character                no-undo.
      222       define variable v-user-can-edit     as logical                  no-undo.
      223       define variable v-output-display    as logical                  no-undo.
      224       define variable v-other             as character                no-undo.
      225       define buffer buf_schedule-attr for ub.schedule-attr .
      226       run schedule-attr-name in this-procedure (
      227             input  p-code
      228           , output v-type
      229           , output v-format
      230           , output v-label
      231           , output v-user-can-edit
      232           , output v-output-display
      233           , output v-other
      234       ) no-error.
      235       if error-status :error
      236       then do:
      237           undo, return error return-value.
      238       end.
      239       find first buf_schedule-attr exclusive-lock
      240            where buf_schedule-attr.cre-db-num = p-cre-db-num
      241              and buf_schedule-attr.task-type  = p-task-type
      242              and buf_schedule-attr.task-num   = p-task-num
      243              and buf_schedule-attr.attr-code  = p-code
      244       no-error.
      245       if not available buf_schedule-attr
      246       then do:
      247           create buf_schedule-attr.
      248           assign
      249             buf_schedule-attr.cre-db-num = p-cre-db-num
      250             buf_schedule-attr.task-type  = p-task-type
      251             buf_schedule-attr.task-num   = p-task-num
      252             buf_schedule-attr.attr-code  = p-code
      253             buf_schedule-attr.attr-value = p-value
      254           .
      255       end.
      256       else do:
      257           assign
      258               buf_schedule-attr.attr-value = p-value
      259           .
      260       end.
      261   end.
      262   end procedure.
      263   procedure schedule-attr-delete :
      264   do
      265   on error undo, return error
      266   :
      267   define input  parameter p-cre-db-num  as integer   no-undo.
      268   define input  parameter p-task-type   as character no-undo.
      269   define input  parameter p-task-num    as integer   no-undo.
      270   define input  parameter p-code        as character no-undo.
      271   define output parameter p-deleted     as logical   no-undo.
      272       define buffer buf_schedule-attr for ub.schedule-attr .
      273       define variable v-type              as character                no-undo.
      274       define variable v-format            as character                no-undo.
      275       define variable v-label             as character                no-undo.
      276       define variable v-user-can-edit     as logical                  no-undo.
      277       define variable v-output-display    as logical                  no-undo.
      278       define variable v-other             as character                no-undo.
      279       run schedule-attr-name in this-procedure (
      280             input p-code
      281           , output v-type
      282           , output v-format
      283           , output v-label
      284           , output v-user-can-edit
      285           , output v-output-display
      286           , output v-other
      287       ) no-error .
      288       if error-status :error
      289       then do:
      290           undo, return error return-value .
      291       end.
      292       find first buf_schedule-attr exclusive-lock
      293            where buf_schedule-attr.cre-db-num = p-cre-db-num
      294              and buf_schedule-attr.task-type  = p-task-type
      295              and buf_schedule-attr.task-num   = p-task-num
      296              and buf_schedule-attr.attr-code  = p-code
      297       no-error.
      298       if not available buf_schedule-attr
      299       then do:
      300           assign
      301               p-deleted = no
      302           .
      303       end.
      304       else do:
      305           delete buf_schedule-attr.
      306           assign
      307               p-deleted = yes
      308           .
      309       end.
      310   end.
      311   end procedure.
      312   procedure schedule-attr-news :
      313   do
      314   on error undo, return error
      315   :
      316       define input  parameter p-code           as character no-undo .
      317       define output parameter p-news           as logical   no-undo .
      318       if index(p-code, chr(4)) > 0 then do:
      319         p-code = entry(1, p-code, chr(4)).
      320       end.
      321       case p-code :
      322               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      323               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      324               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      325               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      326               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      327               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      328               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      329               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      330               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      331         otherwise do:
      332           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      333         end.
      334       end.
      335   end.
      336   end procedure.
      337   procedure schedule-attr-extract-logical :
      338   do
      339   on error undo, return error
      340   :
      341   define input  parameter p-parameter-number   as integer      no-undo.
      342   define input  parameter p-parameter-list     as character    no-undo.
      343   define output parameter p-parameter-value   as logical      no-undo.
      344       if num-entries( p-parameter-list ) > p-parameter-number - 1
      345       then do:
      346           assign
      347               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      348           .
      349       end.
      350       else do:
      351           assign
      352               p-parameter-value   = no
      353           .
      354       end.
      355   end.
      356   end procedure.
      357   procedure schedule-attr-get-free-id :
      358   do
      359   on error undo, return error return-value
      360   :
      361     define input  parameter p-cre-db-num  as integer   no-undo.
      362     define input  parameter p-task-type   as character no-undo.
      363     define input  parameter p-task-num    as integer   no-undo.
      364     define output parameter p-free-id     as character no-undo.
      365     define buffer buf_schedule-attr for ub.schedule-attr.
      366     find first buf_schedule-attr no-lock
      367         where buf_schedule-attr.cre-db-num = p-cre-db-num
      368           and buf_schedule-attr.task-type  = p-task-type
      369           and buf_schedule-attr.task-num   = p-task-num
      370           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      371     no-error .
      372     if available buf_schedule-attr then
      373     assign
      374     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      375     no-error
      376     .
      377   end.
      378   end procedure.
      379   procedure schedule-attr-get-free-props :
      380     define input parameter p-free-id as character no-undo .
      381     define output parameter p-value as character no-undo .
      382     define buffer buf_temp-schedule-free for temp-schedule-free.
      383     do
      384     on error undo, return error return-value
      385     :
      386       find first buf_temp-schedule-free no-lock no-error .
      387       if not available buf_temp-schedule-free then do:
      388         run schedule-attr-fill-free-props in this-procedure .
      389       end.
      390       find first buf_temp-schedule-free where
      391               buf_temp-schedule-free.free-id = p-free-id no-error.
      392       if available buf_temp-schedule-free then do:
      393         assign
      394         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      395                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      396                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      397                   buf_temp-schedule-free.conf-param           + chr(4) +
      398                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      399                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      400                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      401                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      402                   buf_temp-schedule-free.other-info
      403         .
      404       end.
      405       else do:
      406        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      407                              "id произвольной задачи - &5"
      408                              ,vss-workfile
      409                              ,vss-revision
      410                              ,vss-description
      411                              ,chr(10)
      412                              ,p-free-id).
      413       end.
      414     end.
      415   end procedure.
      416   procedure schedule-attr-is-rum-free-id :
      417   define input parameter p-free-id as character no-undo .
      418   define output parameter p-is-rum as logical no-undo .
      419   define buffer buf_temp-schedule-free for temp-schedule-free.
      420   do
      421   on error undo, return error
      422   :
      423       find first buf_temp-schedule-free no-lock no-error .
      424       if not available buf_temp-schedule-free then do:
      425         run schedule-attr-fill-free-props in this-procedure .
      426       end.
      427       find first buf_temp-schedule-free where
      428               buf_temp-schedule-free.free-id = p-free-id no-error.
      429       if available buf_temp-schedule-free
      430       and buf_temp-schedule-free.is-rum
      431       then do:
      432         p-is-rum = yes.
      433       end.
      434   end.
      435   end procedure.
      436   procedure schedule-attr-fill-free-props :
      437   define variable v-path                    as character                no-undo .
      438   DEFINE VARIABLE v-full-path               as character                no-undo .
      439   DEFINE VARIABLE v-file-name               as character                no-undo .
      440   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      441   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      442   define buffer buf_temp-schedule-free for temp-schedule-free.
      443   define variable v-answer as logical no-undo .
      444     do
      445     on error undo, return error substitute("&1 &2 &3&4&5&4"
      446                                           ,vss-workfile
      447                                           ,vss-revision
      448                                           ,vss-description
      449                                           ,chr(10)
      450                                           ,error-status:get-message(1) )
      451     :
      452       run gbl/filename.p (
      453                       input 'cmp/shd-free.d'
      454                     ,output v-full-path
      455                     ,output v-path
      456                     ,output v-file-name
      457                     ,output v-file-name-no-ext
      458                     ,output v-file-name-ext
      459                     ) .
      460       input from value(v-full-path).
      461       repeat :
      462         create buf_temp-schedule-free.
      463         import buf_temp-schedule-free.
      464       END.
      465       input close.
      466       _ff:
      467       for each buf_temp-schedule-free :
      468         if buf_temp-schedule-free.free-id = '':U then do:
      469            delete buf_temp-schedule-free.
      470            next _ff.
      471          end.
      472          run schedule-attr-check-enc in this-procedure (
      473                                                       input  buf_temp-schedule-free.free-id
      474                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      475                                                               buf_temp-schedule-free.proc-param-edit-name +
      476                                                               buf_temp-schedule-free.conf-param +
      477                                                               string(buf_temp-schedule-free.is-gbd) +
      478                                                               string(buf_temp-schedule-free.is-ubd) +
      479                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      480                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      481                                                               string(buf_temp-schedule-free.other-info)
      482                                                               )
      483                                                       ,input  buf_temp-schedule-free.enc-key
      484                                                       ,output v-answer    ) no-error .
      485          if error-status:error
      486          or not v-answer then delete buf_temp-schedule-free.
      487        end.
      488     end.
      489   end procedure.
      490   Function schedule-attr-reverse returns character (str as character).
      491      define variable rev_incl_s as character init "" no-undo .
      492      define variable rev_incl_i as integer no-undo .
      493      define variable rev_incl_l as integer no-undo .
      494      rev_incl_l = length(str).
      495      do rev_incl_i = 1 to rev_incl_l:
      496         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      497      end.
      498      return rev_incl_s.
      499   end.
      500   procedure schedule-attr-check-enc.
      501     define input  parameter p-free-id   as character no-undo .
      502     define input  parameter p-value     as character no-undo .
      503     define input  parameter p-enc-value as character no-undo .
      504     define output parameter p-answer    as logical   no-undo .
      505     define variable tmp         as character no-undo .
      506     define variable v-enc-value as character no-undo .
      507     assign
      508     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      509     .
      510     run schedule-attr-pswd-enc in this-procedure
      511       ( input tmp
      512        ,output v-enc-value
      513       ) no-error .
      514     if error-status:error then do:
      515       message
      516         vss-workfile vss-revision vss-description skip
      517         "Ошибка при вызове процедуры pswd-enc" skip
      518         return-value skip
      519         error-status :get-message(1) skip
      520         view-as alert-box error .
      521       undo, return error .
      522     end.
      523     if v-enc-value = p-enc-value then do:
      524       assign
      525         p-answer = true
      526       .
      527     end.
      528     else do:
      529       assign
      530         p-answer = false
      531       .
      532     end.
      533   end.
      534   procedure schedule-attr-conf-enc.
      535     define input  parameter p-free-id   as character no-undo .
      536     define input  parameter p-value     as character no-undo .
      537     define output parameter p-enc-value as character no-undo .
      538     define variable tmp         as character no-undo .
      539     assign
      540       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      541     .
      542     run schedule-attr-pswd-enc in this-procedure
      543       ( input tmp
      544        ,output p-enc-value
      545       ) no-error .
      546     if error-status:error then do:
      547       message
      548         vss-workfile vss-revision vss-description skip
      549         "Ошибка при вызове процедуры pswd-enc" skip
      550         return-value skip
      551         error-status :get-message(1) skip
      552         view-as alert-box error .
      553       undo, return error .
      554     end.
      555   end procedure.
      556   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      557   procedure schedule-attr-pswd-enc :
      558     define input parameter  pswd     as character no-undo .
      559     define output parameter enc-pswd as character no-undo .
      560     do
      561     on error undo, return error return-value
      562     :
      563       assign
      564         enc-pswd = encode(pswd + string(index(pswd, "k")))
      565       .
      566     end.
      567   end procedure.
      568   define variable v-incr as logical no-undo.
      569   define variable v-param-list as character no-undo.
      570   define variable v-param-type as character no-undo.
      571   do
      572   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      573   on stop   undo, return error substitute( "&1. stop", vss-workfile )
      574   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      575   :
      576     find first pbuf_schedule-attr exclusive-lock
      577       where pbuf_schedule-attr.cre-db-num  = p-db-num
      578         and pbuf_schedule-attr.task-type   = p-task-type
      579         and pbuf_schedule-attr.task-num    = p-task-num
      580         and pbuf_schedule-attr.attr-code   = p-code
      581     no-wait
      582     no-error .
      583     if not available pbuf_schedule-attr
      584     then do:
      585       if locked pbuf_schedule-attr
      586       then do:
      587         run schedule-attr-value in this-procedure ( input p-db-num
      588                                                   , input p-task-type
      589                                                   , input p-task-num
      590                                                   , input p-code
      591                                                   , output v-param-list
      592                                                   , output v-param-type
      593                                                   ).
      594         run schedule-attr-extract-logical in this-procedure ( input 17
      595                                                             , input v-param-list
      596                                                             , output v-incr
      597                                                             ).
      598         if not v-incr then do:
      599         return error substitute( "&1. Другой пользователь работает с параметрами расписания. Параметры расписания &2|&3|&4|&5"
      600                                , vss-workfile
      601                                , p-db-num
      602                                , p-task-type
      603                                , p-task-num
      604                                , p-code
      605                                ) .
      606         end.
      607         else return.
      608       end.
      609       else do:
      610         return error substitute( "&1. Параметры расписания не найдены. &2|&3|&4|&5"
      611                                , vss-workfile
      612                                , p-db-num
      613                                , p-task-type
      614                                , p-task-num
      615                                , p-code
      616                                ) .
      617       end.
      618     end.
      619     find current pbuf_schedule-attr share-lock.
      620     return.
      621   end.
