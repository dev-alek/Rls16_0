        1   DEFINE BUFFER buf_global-state      FOR ub.global-state .
        2   DEFINE BUFFER buf_global-state-attr FOR ub.global-state-attr .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Глобальные параметры для включения прав".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   procedure proc-alt-shift-f2:
       70     if not ibs.th.gbl.gbl-var:rcode
       71   then
       72     run gbl\inidebug.p .
       73   end.
       74   procedure proc-alt-shift-f3:
       75     run gbl/prvssinf.p
       76       ( input this-procedure
       77       ) .
       78   end.
       79   define variable v-inform-launched as logical no-undo initial false .
       80   procedure proc-alt-shift-f4:
       81     define variable v-action as character no-undo .
       82     if v-inform-launched = false then do:
       83       assign
       84         v-inform-launched = true
       85       .
       86       run gbl/d-inform.w
       87         (  input self
       88         ,  input this-procedure
       89         , output v-action
       90         ) no-error .
       91       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       92       assign
       93         v-inform-launched = false
       94       .
       95     end.
       96   end.
       97   procedure proc-alt-f1:
       98     run gbl/corrhelp.p
       99       (input this-procedure
      100       ) .
      101   end .
      102   on alt-shift-f2 anywhere do:
      103     run proc-alt-shift-f2.
      104   end.
      105   on alt-shift-f3 anywhere do:
      106     run proc-alt-shift-f3 in this-procedure .
      107   end.
      108   on alt-shift-f4 anywhere do:
      109     run proc-alt-shift-f4 in this-procedure.
      110   end.
      111   on alt-f1 anywhere do:
      112     run proc-alt-f1 in this-procedure .
      113   end.
      114   define   shared variable g#auto as logical no-undo.
      115   define   shared variable g#news as logical no-undo.
      116   define   shared variable g#oxml as logical no-undo.
      117   define   shared variable g#esys as logical no-undo.
      118   define   shared variable g#news-source-db as integer no-undo.
      119   define   shared variable g#esys-source-esys as integer no-undo.
      120   define   shared variable g#db-num as integer   no-undo .
      121   define   shared variable g#userid as character no-undo .
      122   define   shared variable g#passwd as character no-undo .
      123   DEFINE BUTTON b-exit AUTO-GO
      124        LABEL "&Ввод"
      125        SIZE 10 BY 1
      126        BGCOLOR 8 .
      127   DEFINE BUTTON b-help
      128        LABEL "Помо&щь"
      129        SIZE 10 BY 1
      130        BGCOLOR 8 .
      131   DEFINE BUTTON b-quit AUTO-END-KEY
      132        LABEL "&Отмена"
      133        SIZE 10 BY 1
      134        BGCOLOR 8 .
      135   DEFINE VARIABLE tg-action-gbl AS LOGICAL INITIAL no
      136        LABEL "Глобальная настройка прав"
      137        VIEW-AS TOGGLE-BOX
      138        SIZE 59 BY .79 NO-UNDO.
      139   DEFINE VARIABLE tg-action-gds-groups AS LOGICAL INITIAL no
      140        LABEL "Включить права на работу с группами товаров"
      141        VIEW-AS TOGGLE-BOX
      142        SIZE 59 BY .79 NO-UNDO.
      143   DEFINE FRAME Dialog-Frame
      144        b-exit AT ROW 1 COL 1
      145        b-quit AT ROW 1 COL 11
      146        b-help AT ROW 1 COL 55
      147        tg-action-gds-groups AT ROW 4.08 COL 4 WIDGET-ID 4
      148        tg-action-gbl AT ROW 5.5 COL 4 WIDGET-ID 6
      149        SPACE(2.24) SKIP(1.24)
      150       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      151            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      152            TITLE "Включение прав на работу"
      153            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit WIDGET-ID 100.
      154   ASSIGN
      155          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      156          FRAME Dialog-Frame:HIDDEN           = TRUE.
      157   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      158   DO:
      159     APPLY "END-ERROR":U TO SELF.
      160   END.
      161   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      162   DO:
      163     assign
      164       tg-action-gds-groups
      165       tg-action-gbl
      166     .
      167     RUN global-save IN THIS-PROCEDURE .
      168       if tg-action-gbl then do:
      169     end.
      170   END.
      171   ON CHOOSE OF b-help IN FRAME Dialog-Frame
      172   OR HELP OF FRAME Dialog-Frame
      173   DO:
      174     MESSAGE "Help for File: c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\adm\actngdsg.w" VIEW-AS ALERT-BOX INFORMATION.
      175   END.
      176   ON VALUE-CHANGED OF tg-action-gbl IN FRAME Dialog-Frame
      177   DO:
      178     assign tg-action-gbl.
      179   END.
      180   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      181   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      182   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      183   on help of frame Dialog-Frame
      184   do:
      185     run gbl/app_help.p
      186       (input this-procedure :file-name
      187       ,input ''
      188       ,input ?
      189       ) no-error.
      190     if error-status :error then do:
      191       message
      192         "Ошибка при вызове помощи"
      193         error-status :get-message(1)
      194         view-as alert-box .
      195     end.
      196   end.
      197   run minbtn-set in this-procedure .
      198   on choose of b-help in frame Dialog-Frame
      199   do:
      200     apply "help":u to frame Dialog-Frame .
      201   end.
      202   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      203   procedure minbtn-set :
      204       do
      205           on error undo, return error return-value
      206           :
      207           define variable ii              as integer       no-undo .
      208           define variable fh              as widget-handle no-undo .
      209           define variable hh              as widget-handle no-undo .
      210           define variable v-h             as handle        extent 4 no-undo .
      211           define variable v-name-button   as character     no-undo .
      212           define variable v-help-old-x    as decimal       no-undo .
      213           define variable v-help-old-y    as decimal       no-undo .
      214           define variable v-help-old-size as decimal       no-undo .
      215           define variable v-frame-width   as decimal       no-undo .
      216           define variable jj              as integer       no-undo .
      217           do
      218               on error undo, return error
      219               :
      220               assign
      221                   v-frame-width = frame Dialog-Frame:width - 0.3
      222                   fh            = frame Dialog-Frame:first-child
      223                   hh            = fh:first-child
      224                   ii            = 1
      225                   .
      226               do while valid-handle(hh):
      227                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      228                   do:
      229                       case lc(hh:name) :
      230                           when "b-help" then
      231                               do:
      232                                   hh:load-image-up("cmp/b-help.bmp":u) .
      233                                   hh:load-image-down("cmp/b-help.bmp":u) .
      234                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      235                                   hh:TOOLTIP = "Помощь" .
      236                                   v-help-old-x = hh:column .
      237                                   v-help-old-y = hh:row    .
      238                                   v-help-old-size = hh:width .
      239                                   hh:width-chars = 2.5 .
      240                               end.
      241                           when "b-print" then
      242                               do:
      243                                   hh:load-image("cmp/b-print.bmp":u) .
      244                                   hh:TOOLTIP = "Печать" .
      245                                   v-h[ii] = hh:handle .
      246                                   ii = ii + 1 .
      247                                   hh:width-chars = 3 .
      248                               end.
      249                           when "b-history" or
      250                           when "b-hist" then
      251                               do:
      252                                   hh:load-image("cmp/b-hist.bmp":u) .
      253                                   hh:TOOLTIP = "История" .
      254                                   v-h[ii] = hh:handle .
      255                                   ii = ii + 1 .
      256                                   hh:width-chars = 3 .
      257                               end.
      258                           when "b-sch" then
      259                               do:
      260                                   hh:load-image("cmp/b-sch.bmp":u) .
      261                                   hh:TOOLTIP = "Установка Фильтра" .
      262                                   v-h[ii] = hh:handle .
      263                                   ii = ii + 1 .
      264                                   hh:width-chars = 3 .
      265                               end.
      266                           when "b-hist-user" then
      267                               do:
      268                                   hh:load-image("cmp/b-hist.bmp":u) .
      269                                   hh:TOOLTIP = "История пользователя" .
      270                                   ii = ii + 1 .
      271                               end.
      272                       end case.
      273                   end.
      274                   hh = hh:next-sibling.
      275               end.
      276               b-help:column = v-frame-width - b-help:width-chars.
      277               jj = 0.
      278               repeat ii = 4 to 1 by -1 :
      279                   if valid-handle (v-h[ii] ) then
      280                   do:
      281                       jj  = jj + 1 .
      282                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      283                       v-h[ii]:row    = v-help-old-y .
      284                   end.
      285               end.
      286           end.
      287       end.
      288   end procedure.
      289   MAIN-BLOCK:
      290   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      291      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      292      RUN global-read IN THIS-PROCEDURE .
      293      RUN enable_UI.
      294      run ui-enable in this-procedure.
      295      WAIT-FOR GO OF FRAME Dialog-Frame.
      296   END.
      297   RUN disable_UI.
      298   PROCEDURE disable_UI :
      299     HIDE FRAME Dialog-Frame.
      300   END PROCEDURE.
      301   PROCEDURE enable_UI :
      302     DISPLAY tg-action-gds-groups tg-action-gbl
      303         WITH FRAME Dialog-Frame.
      304     ENABLE b-exit b-quit b-help tg-action-gds-groups tg-action-gbl
      305         WITH FRAME Dialog-Frame.
      306     VIEW FRAME Dialog-Frame.
      307   END PROCEDURE.
      308   PROCEDURE global-read :
      309      FIND FIRST buf_global-state
      310           NO-LOCK
      311           .
      312      FIND FIRST buf_global-state-attr
      313         WHERE buf_global-state-attr.gls-id = buf_global-state.gls-id
      314            AND buf_global-state-attr.attr-code = "action-gds-groups"
      315         NO-LOCK
      316         NO-error
      317         .
      318      IF AVAILABLE buf_global-state-attr
      319      THEN DO:
      320         assign
      321            tg-action-gds-groups = LOGICAL(buf_global-state-attr.attr-value)
      322         .
      323         RELEASE buf_global-state-attr .
      324      END.
      325      FIND FIRST buf_global-state-attr
      326         WHERE buf_global-state-attr.gls-id = buf_global-state.gls-id
      327            AND buf_global-state-attr.attr-code = "action-gbl"
      328         NO-LOCK
      329         NO-error
      330         .
      331      IF AVAILABLE buf_global-state-attr
      332      THEN DO:
      333         assign
      334            tg-action-gbl = LOGICAL(buf_global-state-attr.attr-value)
      335         .
      336         RELEASE buf_global-state-attr .
      337      END.
      338   END PROCEDURE.
      339   PROCEDURE global-save :
      340      define variable v-on-gbl as logical no-undo.
      341      FIND FIRST buf_global-state-attr
      342         WHERE buf_global-state-attr.gls-id = buf_global-state.gls-id
      343            AND buf_global-state-attr.attr-code = "action-gds-groups"
      344         EXCLUSIVE-LOCK
      345         NO-error
      346         .
      347      IF NOT AVAILABLE buf_global-state-attr
      348      THEN DO:
      349         create buf_global-state-attr.
      350         assign
      351            buf_global-state-attr.gls-id = buf_global-state.gls-id
      352            buf_global-state-attr.attr-code = "action-gds-groups"
      353         .
      354      END.
      355      assign
      356         buf_global-state-attr.attr-value = STRING(tg-action-gds-groups)
      357      .
      358      FIND FIRST buf_global-state-attr
      359         WHERE buf_global-state-attr.gls-id = buf_global-state.gls-id
      360            AND buf_global-state-attr.attr-code = "action-gbl"
      361         EXCLUSIVE-LOCK
      362         NO-error
      363         .
      364      IF NOT AVAILABLE buf_global-state-attr
      365      THEN DO:
      366         create buf_global-state-attr.
      367         assign
      368            buf_global-state-attr.gls-id = buf_global-state.gls-id
      369            buf_global-state-attr.attr-code = "action-gbl"
      370            v-on-gbl = tg-action-gbl
      371         .
      372      END.
      373      ELSE
      374         v-on-gbl = (not logical(buf_global-state-attr.attr-value)) and tg-action-gbl.
      375      assign
      376         buf_global-state-attr.attr-value = STRING(tg-action-gbl)
      377      .
      378      if v-on-gbl then
      379      do:
      380        for each action-role no-lock
      381          where action-role.db-num = 0
      382        :
      383          run str/callnews.p
      384            (input 'action-role':U
      385            ,input (buffer action-role :handle)
      386            ).
      387        end.
      388        for each action-role-attr no-lock
      389          where action-role-attr.db-num = 0
      390        :
      391          run str/callnews.p
      392            (input 'action-role-attr':U
      393            ,input (buffer action-role-attr :handle)
      394            ).
      395        end.
      396        for each action-role-item no-lock
      397          where action-role-item.db-num = 0
      398        :
      399          run str/callnews.p
      400            (input 'action-role-item':U
      401            ,input (buffer action-role-item :handle)
      402            ).
      403        end.
      404        for each action-role-item-attr no-lock
      405          where action-role-item-attr.db-num = 0
      406        :
      407          run str/callnews.p
      408            (input 'action-role-item-attr':U
      409            ,input (buffer action-role-item-attr :handle)
      410            ).
      411        end.
      412      end.
      413      RELEASE buf_global-state-attr .
      414      FIND FIRST buf_global-state
      415           exclusive-LOCK
      416           .
      417      if buf_global-state.whole-send-news = 0 then buf_global-state.whole-send-news = 1.
      418                                               else buf_global-state.whole-send-news = 0.
      419      RELEASE buf_global-state .
      420   END PROCEDURE.
      421   PROCEDURE ui-enable :
      422   do
      423   with frame Dialog-Frame
      424   on error undo, return error
      425   :
      426     if g#db-num <> 0 then do:
      427       assign
      428         tg-action-gbl:sensitive = false
      429       .
      430     end.
      431   end.
      432   END PROCEDURE.
