     1439   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1440     function get-attr-code returns character (input p-task-type as character ).
     1441       define variable v-db-attr-code as character no-undo .
     1442       case p-task-type :
     1443         when 'autonws':U then do:
     1444           assign
     1445             v-db-attr-code = 'schedule-nws':U.
     1446           .
     1447         end.
     1448         when 'autoarh':U then do:
     1449           assign
     1450             v-db-attr-code = 'schedule-arc':U
     1451           .
     1452         end.
     1453         when 'autoexp':U then do:
     1454           assign
     1455             v-db-attr-code = 'schedule-exp':U
     1456           .
     1457         end.
     1458         when 'autooxml':U then do:
     1459           assign
     1460             v-db-attr-code = 'schedule-oxml':U
     1461           .
     1462         end.
     1463         when 'autogcd':U then do:
     1464           assign
     1465             v-db-attr-code = 'schedule-getcd':U
     1466           .
     1467         end.
     1468         when 'autosale':U then do:
     1469           assign
     1470             v-db-attr-code = 'schedule-sale':U
     1471           .
     1472         end.
     1473         when 'autosuz':U then do:
     1474           assign
     1475             v-db-attr-code = 'schedule-suz':U
     1476           .
     1477         end.
     1478         when 'autocbnk':U then do:
     1479           assign
     1480             v-db-attr-code = 'schedule-cbnk':U
     1481           .
     1482         end.
     1483         when 'autofree':U then do:
     1484           assign
     1485             v-db-attr-code = 'schedule-free':U
     1486           .
     1487         end.
     1488         when 'mercury':U then do:
     1489           assign
     1490             v-db-attr-code = 'schedule-merc':U
     1491           .
     1492         end.
     1493         when 'hddtest':U then do:
     1494           assign
     1495             v-db-attr-code = 'schedule-hdd':U
     1496           .
     1497         end.
     1498         when 'is_motp':U then do:
     1499           assign
     1500             v-db-attr-code = 'schedule-motp':U
     1501           .
     1502         end.
     1503         when 'is_diadoc':U then do:
     1504           assign
     1505             v-db-attr-code = 'schedule-diadoc':U
     1506           .
     1507         end.
     1508         when 'is_PM':U then do:
     1509           assign
     1510             v-db-attr-code = 'schedule-isPM':U
     1511           .
     1512         end.
     1513         otherwise do:
     1514           assign
     1515             v-db-attr-code = ?
     1516           .
     1517         end.
     1518       end.
     1519       return v-db-attr-code.
     1520     end function.
     1521   function get-str-type returns character (input p-task-type as character ).
     1522     define variable v-str as character no-undo .
     1523     case p-task-type :
     1524       when 'autonws':U then do:
     1525         assign
     1526           v-str = "связи с БД"
     1527         .
     1528       end.
     1529       when 'autoarh':U then do:
     1530         assign
     1531           v-str = "расчета архивов по БД"
     1532         .
     1533       end.
     1534       when 'autoexp':U then do:
     1535         assign
     1536           v-str = "экспорта по БД"
     1537         .
     1538       end.
     1539       when 'autooxml':U then do:
     1540         assign
     1541           v-str = "OpenXML по БД"
     1542         .
     1543       end.
     1544       when 'autogcd':U then do:
     1545         assign
     1546           v-str = "приема информации с касс по БД"
     1547         .
     1548       end.
     1549       when 'autosale':U then do:
     1550         assign
     1551           v-str = "работы с документами продажи по БД"
     1552         .
     1553       end.
     1554       when 'autosuz':U then do:
     1555         assign
     1556           v-str = "запуска отчетов по БД"
     1557         .
     1558       end.
     1559       when 'autocbnk':U then do:
     1560         assign
     1561           v-str = "эксп/имп в КЛИЕНТ-БАНК"
     1562         .
     1563       end.
     1564       when 'autofree':U then do:
     1565         assign
     1566           v-str = "выполнение произ.заданий"
     1567         .
     1568       end.
     1569       when 'mercury':U then do:
     1570         assign
     1571           v-str = "обмена с ФГИС Меркурий по БД"
     1572         .
     1573       end.
     1574       when 'hddtest':U then do:
     1575         assign
     1576           v-str = "мониторинга HDD по БД"
     1577         .
     1578       end.
     1579       when 'is_motp':U then do:
     1580         assign
     1581           v-str = "обмена с ИС МОТП по БД"
     1582         .
     1583       end.
     1584       when 'is_diadoc':U then do:
     1585         assign
     1586           v-str = "обмена с ИС Диадок по БД"
     1587         .
     1588       end.
     1589       when 'is_diadoc':U then do:
     1590         assign
     1591           v-str = "выгрузки в ИС Президентский мониторинг по БД"
     1592         .
     1593       end.
     1594       otherwise do:
     1595         assign
     1596           v-str = "экспорта по БД"
     1597         .
     1598       end.
     1599     end.
     1600     return v-str.
     1601   end function.
     1602   procedure push-abtpr :
     1603     define input parameter parparentproc as handle    no-undo .
     1604     define input parameter p-db-num      as integer   no-undo .
     1605     define input parameter p-task-type   as character no-undo .
     1606     define input parameter p-start-type  as character no-undo .
     1607     define input parameter p-date        as date      no-undo .
     1608     define input parameter p-time        as integer   no-undo .
     1609     do
     1610     on error undo, return error
     1611     :
     1612       define buffer buf_BatchProcess for ub.BatchProcess .
     1613       define buffer buf_sys-ctrl     for ub.sys-ctrl .
     1614       define variable v-curr-date as date      no-undo .
     1615       define variable v-curr-time as integer   no-undo .
     1616       define variable v-str       as character no-undo .
     1617       define variable v-user-id   as character no-undo .
     1618       run cur-time in this-procedure
     1619         ( output v-curr-date
     1620          ,output v-curr-time
     1621         ) no-error.
     1622       if error-status :error then do:
     1623         return error substitute( "&1. Ошибка при определении текущей даты!", vss-include-info6 ).
     1624       end.
     1625       if p-date = ? then do:
     1626         assign
     1627           p-date = v-curr-date
     1628         .
     1629       end.
     1630       if p-time = ? then do:
     1631         assign
     1632           p-time = v-curr-time
     1633         .
     1634       end.
     1635       assign
     1636         v-str = get-str-type( p-task-type )
     1637       .
     1638       if v-str = ? then do:
     1639         return error substitute( "&1. НЕТ ОБРАБОТКИ АТРИБУТА &2!", vss-include-info6, p-task-type ).
     1640       end.
     1641       run get-userid in parparentproc
     1642         ( output v-user-id
     1643         ).
     1644       find first buf_sys-ctrl no-lock .
     1645       find first buf_BatchProcess no-lock
     1646         where buf_BatchProcess.BP_Status   = 'N':U
     1647           and buf_BatchProcess.BP_Type     = p-task-type
     1648           and buf_BatchProcess.CharKey_One = string( p-db-num )
     1649           and buf_BatchProcess.CharKey_Two = "auto":U
     1650         no-error
     1651       .
     1652       if available buf_BatchProcess
     1653         and ( buf_BatchProcess.BP_ExecSysDate < v-curr-date
     1654               or (buf_BatchProcess.BP_ExecSysDate = v-curr-date
     1655                   and buf_BatchProcess.BP_ExecSysTimeInt < v-curr-time
     1656                   )
     1657             )
     1658       then do:
     1659         return error substitute( "Автоматический режим &1 для БД &2 не запущен или в данный момент идет обработка!"
     1660                                 ,v-str ,p-db-num
     1661                               ).
     1662       end.
     1663       find first buf_BatchProcess exclusive-lock
     1664         where buf_BatchProcess.BP_Status   = 'N':U
     1665           and buf_BatchProcess.BP_Type     = p-task-type
     1666           and buf_BatchProcess.CharKey_One = string( p-db-num )
     1667           and buf_BatchProcess.CharKey_Two = p-start-type
     1668         no-error
     1669       .
     1670       if not available buf_BatchProcess then do:
     1671         create buf_BatchProcess.
     1672         assign
     1673           buf_BatchProcess.BatchProcess# = next-value (s-btpr, ub)
     1674           buf_BatchProcess.BP_Status     = 'N':U
     1675           buf_BatchProcess.BP_Type       = p-task-type
     1676           buf_BatchProcess.CharKey_One   = string( p-db-num )
     1677           buf_BatchProcess.CharKey_Two   = p-start-type
     1678         .
     1679       end.
     1680       assign
     1681         buf_BatchProcess.CharKey_Three     = string( buf_sys-ctrl.db-num ) + chr(3) + p-task-type + chr(3) + "-1":U
     1682         buf_BatchProcess.User_ID           = v-user-id
     1683         buf_BatchProcess.Key#_One          = (if p-start-type = "manual":U then 1 else 0)
     1684         buf_BatchProcess.BP_SysDate        = v-curr-date
     1685         buf_BatchProcess.BP_SysTimeInt     = v-curr-time
     1686         buf_BatchProcess.BP_SysTime        = string(v-curr-time, 'HH:MM:SS':U)
     1687         buf_BatchProcess.BP_ExecSysDate    = p-date
     1688         buf_BatchProcess.BP_ExecSysTimeInt = p-time
     1689         buf_BatchProcess.BP_ExecSysTime    = string(p-time, 'HH:MM:SS':U)
     1690       .
     1691     end.
     1692     return.
     1693   end procedure.
     1694   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1695   define temp-table temp-schedule-free no-undo
     1696   field free-id as character
     1697   field free-task-name as character
     1698   field proc-run-name as character
     1699   field proc-param-edit-name as character
     1700   field conf-param as character
     1701   field is-gbd as logical
     1702   field is-ubd as logical
     1703   field enable-concurrent-0 as logical
     1704   field enable-concurrent-db as logical
     1705   field other-info as character
     1706   field enc-key as character
     1707   field is-rum as logical
     1708   index pi is unique primary
     1709   free-id.
     1710   procedure schedule-attr-name :
     1711   do
     1712     on error undo, return error
     1713     :
     1714     define input  parameter p-code           as character no-undo .
     1715     define output parameter p-type           as character no-undo .
     1716     define output parameter p-format         as character no-undo .
     1717     define output parameter p-label          as character no-undo .
     1718     define output parameter p-user-can-edit  as logical   no-undo .
     1719     define output parameter p-output-display as logical   no-undo .
     1720     define output parameter p-other          as character no-undo .
     1721       if index(p-code, chr(4)) > 0 then do:
     1722         p-code = entry(1, p-code, chr(4)).
     1723       end.
     1724       case p-code :
     1725               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     1726               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     1727               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     1728               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     1729               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     1730               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     1731               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     1732               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     1733               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
     1734         otherwise do:
     1735           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
     1736         end.
     1737       end.
     1738     end.
     1739   end procedure.
     1740   procedure schedule-attr-tooltip :
     1741   do
     1742     on error undo, return error
     1743     :
     1744       define input  parameter p-code    as character no-undo .
     1745       define output parameter p-tooltip as character no-undo .
     1746       define output parameter p-label   as character no-undo .
     1747       if index(p-code, chr(4)) > 0 then do:
     1748         p-code = entry(1, p-code, chr(4)).
     1749       end.
     1750       case p-code :
     1751               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
     1752               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
     1753               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
     1754               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
     1755               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
     1756               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
     1757               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
     1758               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
     1759               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
     1760         otherwise do:
     1761               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
     1762         end.
     1763       end.
     1764     end.
     1765   end procedure.
     1766   procedure schedule-attr-value :
     1767   do
     1768   on error undo, return error return-value
     1769   :
     1770   define input parameter  p-cre-db-num as integer    no-undo.
     1771   define input parameter  p-task-type  as character  no-undo.
     1772   define input parameter  p-task-num   as integer    no-undo.
     1773   define input parameter  p-code       as character  no-undo.
     1774   define output parameter p-value      as character  no-undo.
     1775   define output parameter p-type       as character  no-undo.
     1776       define variable v-format         as character no-undo .
     1777       define variable v-label          as character no-undo .
     1778       define variable v-user-can-edit  as logical   no-undo .
     1779       define variable v-output-display as logical   no-undo .
     1780       define variable v-other          as character no-undo .
     1781       define buffer buf_schedule-attr for ub.schedule-attr.
     1782       run schedule-attr-name in this-procedure (
     1783             input  p-code
     1784           , output p-type
     1785           , output v-format
     1786           , output v-label
     1787           , output v-user-can-edit
     1788           , output v-output-display
     1789           , output v-other
     1790       ) no-error .
     1791       if error-status :error
     1792       then do:
     1793           undo, return error return-value .
     1794       end.
     1795       if p-code begins ('schd-free-id':U + chr(4))
     1796       and entry(2, p-code, chr(4)) = '':U then do:
     1797         find first buf_schedule-attr no-lock
     1798             where buf_schedule-attr.cre-db-num = p-cre-db-num
     1799               and buf_schedule-attr.task-type  = p-task-type
     1800               and buf_schedule-attr.task-num   = p-task-num
     1801               and buf_schedule-attr.attr-code  begins p-code
     1802         no-error .
     1803       end.
     1804       else do:
     1805         find first buf_schedule-attr no-lock
     1806             where buf_schedule-attr.cre-db-num = p-cre-db-num
     1807               and buf_schedule-attr.task-type  = p-task-type
     1808               and buf_schedule-attr.task-num   = p-task-num
     1809               and buf_schedule-attr.attr-code  = p-code
     1810         no-error .
     1811       end.
     1812       if available buf_schedule-attr
     1813       then do:
     1814           assign
     1815               p-value = buf_schedule-attr.attr-value
     1816           .
     1817       end.
     1818       else do:
     1819         if p-code begins ('schd-free-id':U + chr(4) ) then do:
     1820            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
     1821         end.
     1822         else do:
     1823           assign
     1824               p-value = if p-type = 'L':U then "no":U else ""
     1825           .
     1826         end.
     1827       end.
     1828   end.
     1829   end procedure.
     1830   procedure schedule-attr-write :
     1831   do
     1832   on error undo, return error
     1833   :
     1834   define input parameter p-cre-db-num  as integer   no-undo.
     1835   define input parameter p-task-type   as character no-undo.
     1836   define input parameter p-task-num    as integer   no-undo.
     1837   define input parameter p-code        as character no-undo.
     1838   define input parameter p-value       as character no-undo.
     1839       define variable v-type              as character                no-undo.
     1840       define variable v-format            as character                no-undo.
     1841       define variable v-label             as character                no-undo.
     1842       define variable v-user-can-edit     as logical                  no-undo.
     1843       define variable v-output-display    as logical                  no-undo.
     1844       define variable v-other             as character                no-undo.
     1845       define buffer buf_schedule-attr for ub.schedule-attr .
     1846       run schedule-attr-name in this-procedure (
     1847             input  p-code
     1848           , output v-type
     1849           , output v-format
     1850           , output v-label
     1851           , output v-user-can-edit
     1852           , output v-output-display
     1853           , output v-other
     1854       ) no-error.
     1855       if error-status :error
     1856       then do:
     1857           undo, return error return-value.
     1858       end.
     1859       find first buf_schedule-attr exclusive-lock
     1860            where buf_schedule-attr.cre-db-num = p-cre-db-num
     1861              and buf_schedule-attr.task-type  = p-task-type
     1862              and buf_schedule-attr.task-num   = p-task-num
     1863              and buf_schedule-attr.attr-code  = p-code
     1864       no-error.
     1865       if not available buf_schedule-attr
     1866       then do:
     1867           create buf_schedule-attr.
     1868           assign
     1869             buf_schedule-attr.cre-db-num = p-cre-db-num
     1870             buf_schedule-attr.task-type  = p-task-type
     1871             buf_schedule-attr.task-num   = p-task-num
     1872             buf_schedule-attr.attr-code  = p-code
     1873             buf_schedule-attr.attr-value = p-value
     1874           .
     1875       end.
     1876       else do:
     1877           assign
     1878               buf_schedule-attr.attr-value = p-value
     1879           .
     1880       end.
     1881   end.
     1882   end procedure.
     1883   procedure schedule-attr-delete :
     1884   do
     1885   on error undo, return error
     1886   :
     1887   define input  parameter p-cre-db-num  as integer   no-undo.
     1888   define input  parameter p-task-type   as character no-undo.
     1889   define input  parameter p-task-num    as integer   no-undo.
     1890   define input  parameter p-code        as character no-undo.
     1891   define output parameter p-deleted     as logical   no-undo.
     1892       define buffer buf_schedule-attr for ub.schedule-attr .
     1893       define variable v-type              as character                no-undo.
     1894       define variable v-format            as character                no-undo.
     1895       define variable v-label             as character                no-undo.
     1896       define variable v-user-can-edit     as logical                  no-undo.
     1897       define variable v-output-display    as logical                  no-undo.
     1898       define variable v-other             as character                no-undo.
     1899       run schedule-attr-name in this-procedure (
     1900             input p-code
     1901           , output v-type
     1902           , output v-format
     1903           , output v-label
     1904           , output v-user-can-edit
     1905           , output v-output-display
     1906           , output v-other
     1907       ) no-error .
     1908       if error-status :error
     1909       then do:
     1910           undo, return error return-value .
     1911       end.
     1912       find first buf_schedule-attr exclusive-lock
     1913            where buf_schedule-attr.cre-db-num = p-cre-db-num
     1914              and buf_schedule-attr.task-type  = p-task-type
     1915              and buf_schedule-attr.task-num   = p-task-num
     1916              and buf_schedule-attr.attr-code  = p-code
     1917       no-error.
     1918       if not available buf_schedule-attr
     1919       then do:
     1920           assign
     1921               p-deleted = no
     1922           .
     1923       end.
     1924       else do:
     1925           delete buf_schedule-attr.
     1926           assign
     1927               p-deleted = yes
     1928           .
     1929       end.
     1930   end.
     1931   end procedure.
     1932   procedure schedule-attr-news :
     1933   do
     1934   on error undo, return error
     1935   :
     1936       define input  parameter p-code           as character no-undo .
     1937       define output parameter p-news           as logical   no-undo .
     1938       if index(p-code, chr(4)) > 0 then do:
     1939         p-code = entry(1, p-code, chr(4)).
     1940       end.
     1941       case p-code :
     1942               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
     1943               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
     1944               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
     1945               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
     1946               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
     1947               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
     1948               when 'schedule-filter':U then do:     assign     p-news = false.   end.
     1949               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
     1950               when 'schd-free-id':U then do:     assign     p-news = false.   end.
     1951         otherwise do:
     1952           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
     1953         end.
     1954       end.
     1955   end.
     1956   end procedure.
     1957   procedure schedule-attr-extract-logical :
     1958   do
     1959   on error undo, return error
     1960   :
     1961   define input  parameter p-parameter-number   as integer      no-undo.
     1962   define input  parameter p-parameter-list     as character    no-undo.
     1963   define output parameter p-parameter-value   as logical      no-undo.
     1964       if num-entries( p-parameter-list ) > p-parameter-number - 1
     1965       then do:
     1966           assign
     1967               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
     1968           .
     1969       end.
     1970       else do:
     1971           assign
     1972               p-parameter-value   = no
     1973           .
     1974       end.
     1975   end.
     1976   end procedure.
     1977   procedure schedule-attr-get-free-id :
     1978   do
     1979   on error undo, return error return-value
     1980   :
     1981     define input  parameter p-cre-db-num  as integer   no-undo.
     1982     define input  parameter p-task-type   as character no-undo.
     1983     define input  parameter p-task-num    as integer   no-undo.
     1984     define output parameter p-free-id     as character no-undo.
     1985     define buffer buf_schedule-attr for ub.schedule-attr.
     1986     find first buf_schedule-attr no-lock
     1987         where buf_schedule-attr.cre-db-num = p-cre-db-num
     1988           and buf_schedule-attr.task-type  = p-task-type
     1989           and buf_schedule-attr.task-num   = p-task-num
     1990           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
     1991     no-error .
     1992     if available buf_schedule-attr then
     1993     assign
     1994     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
     1995     no-error
     1996     .
     1997   end.
     1998   end procedure.
     1999   procedure schedule-attr-get-free-props :
     2000     define input parameter p-free-id as character no-undo .
     2001     define output parameter p-value as character no-undo .
     2002     define buffer buf_temp-schedule-free for temp-schedule-free.
     2003     do
     2004     on error undo, return error return-value
     2005     :
     2006       find first buf_temp-schedule-free no-lock no-error .
     2007       if not available buf_temp-schedule-free then do:
     2008         run schedule-attr-fill-free-props in this-procedure .
     2009       end.
     2010       find first buf_temp-schedule-free where
     2011               buf_temp-schedule-free.free-id = p-free-id no-error.
     2012       if available buf_temp-schedule-free then do:
     2013         assign
     2014         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
     2015                   buf_temp-schedule-free.proc-run-name        + chr(4) +
     2016                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
     2017                   buf_temp-schedule-free.conf-param           + chr(4) +
     2018                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
     2019                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
     2020                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
     2021                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
     2022                   buf_temp-schedule-free.other-info
     2023         .
     2024       end.
     2025       else do:
     2026        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
     2027                              "id произвольной задачи - &5"
     2028                              ,vss-workfile
     2029                              ,vss-revision
     2030                              ,vss-description
     2031                              ,chr(10)
     2032                              ,p-free-id).
     2033       end.
     2034     end.
     2035   end procedure.
     2036   procedure schedule-attr-is-rum-free-id :
     2037   define input parameter p-free-id as character no-undo .
     2038   define output parameter p-is-rum as logical no-undo .
     2039   define buffer buf_temp-schedule-free for temp-schedule-free.
     2040   do
     2041   on error undo, return error
     2042   :
     2043       find first buf_temp-schedule-free no-lock no-error .
     2044       if not available buf_temp-schedule-free then do:
     2045         run schedule-attr-fill-free-props in this-procedure .
     2046       end.
     2047       find first buf_temp-schedule-free where
     2048               buf_temp-schedule-free.free-id = p-free-id no-error.
     2049       if available buf_temp-schedule-free
     2050       and buf_temp-schedule-free.is-rum
     2051       then do:
     2052         p-is-rum = yes.
     2053       end.
     2054   end.
     2055   end procedure.
     2056   procedure schedule-attr-fill-free-props :
     2057   define variable v-path                    as character                no-undo .
     2058   DEFINE VARIABLE v-full-path               as character                no-undo .
     2059   DEFINE VARIABLE v-file-name               as character                no-undo .
     2060   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
     2061   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
     2062   define buffer buf_temp-schedule-free for temp-schedule-free.
     2063   define variable v-answer as logical no-undo .
     2064     do
     2065     on error undo, return error substitute("&1 &2 &3&4&5&4"
     2066                                           ,vss-workfile
     2067                                           ,vss-revision
     2068                                           ,vss-description
     2069                                           ,chr(10)
     2070                                           ,error-status:get-message(1) )
     2071     :
     2072       run gbl/filename.p (
     2073                       input 'cmp/shd-free.d'
     2074                     ,output v-full-path
     2075                     ,output v-path
     2076                     ,output v-file-name
     2077                     ,output v-file-name-no-ext
     2078                     ,output v-file-name-ext
     2079                     ) .
     2080       input from value(v-full-path).
     2081       repeat :
     2082         create buf_temp-schedule-free.
     2083         import buf_temp-schedule-free.
     2084       END.
     2085       input close.
     2086       _ff:
     2087       for each buf_temp-schedule-free :
     2088         if buf_temp-schedule-free.free-id = '':U then do:
     2089            delete buf_temp-schedule-free.
     2090            next _ff.
     2091          end.
     2092          run schedule-attr-check-enc in this-procedure (
     2093                                                       input  buf_temp-schedule-free.free-id
     2094                                                      ,input  (buf_temp-schedule-free.proc-run-name +
     2095                                                               buf_temp-schedule-free.proc-param-edit-name +
     2096                                                               buf_temp-schedule-free.conf-param +
     2097                                                               string(buf_temp-schedule-free.is-gbd) +
     2098                                                               string(buf_temp-schedule-free.is-ubd) +
     2099                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
     2100                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
     2101                                                               string(buf_temp-schedule-free.other-info)
     2102                                                               )
     2103                                                       ,input  buf_temp-schedule-free.enc-key
     2104                                                       ,output v-answer    ) no-error .
     2105          if error-status:error
     2106          or not v-answer then delete buf_temp-schedule-free.
     2107        end.
     2108     end.
     2109   end procedure.
     2110   Function schedule-attr-reverse returns character (str as character).
     2111      define variable rev_incl_s as character init "" no-undo .
     2112      define variable rev_incl_i as integer no-undo .
     2113      define variable rev_incl_l as integer no-undo .
     2114      rev_incl_l = length(str).
     2115      do rev_incl_i = 1 to rev_incl_l:
     2116         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
     2117      end.
     2118      return rev_incl_s.
     2119   end.
     2120   procedure schedule-attr-check-enc.
     2121     define input  parameter p-free-id   as character no-undo .
     2122     define input  parameter p-value     as character no-undo .
     2123     define input  parameter p-enc-value as character no-undo .
     2124     define output parameter p-answer    as logical   no-undo .
     2125     define variable tmp         as character no-undo .
     2126     define variable v-enc-value as character no-undo .
     2127     assign
     2128     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
     2129     .
     2130     run schedule-attr-pswd-enc in this-procedure
     2131       ( input tmp
     2132        ,output v-enc-value
     2133       ) no-error .
     2134     if error-status:error then do:
     2135       message
     2136         vss-workfile vss-revision vss-description skip
     2137         "Ошибка при вызове процедуры pswd-enc" skip
     2138         return-value skip
     2139         error-status :get-message(1) skip
     2140         view-as alert-box error .
     2141       undo, return error .
     2142     end.
     2143     if v-enc-value = p-enc-value then do:
     2144       assign
     2145         p-answer = true
     2146       .
     2147     end.
     2148     else do:
     2149       assign
     2150         p-answer = false
     2151       .
     2152     end.
     2153   end.
     2154   procedure schedule-attr-conf-enc.
     2155     define input  parameter p-free-id   as character no-undo .
     2156     define input  parameter p-value     as character no-undo .
     2157     define output parameter p-enc-value as character no-undo .
     2158     define variable tmp         as character no-undo .
     2159     assign
     2160       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
     2161     .
     2162     run schedule-attr-pswd-enc in this-procedure
     2163       ( input tmp
     2164        ,output p-enc-value
     2165       ) no-error .
     2166     if error-status:error then do:
     2167       message
     2168         vss-workfile vss-revision vss-description skip
     2169         "Ошибка при вызове процедуры pswd-enc" skip
     2170         return-value skip
     2171         error-status :get-message(1) skip
     2172         view-as alert-box error .
     2173       undo, return error .
     2174     end.
     2175   end procedure.
     2176   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2177   procedure schedule-attr-pswd-enc :
     2178     define input parameter  pswd     as character no-undo .
     2179     define output parameter enc-pswd as character no-undo .
     2180     do
     2181     on error undo, return error return-value
     2182     :
     2183       assign
     2184         enc-pswd = encode(pswd + string(index(pswd, "k")))
     2185       .
     2186     end.
     2187   end procedure.
     2188   do
     2189   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2190   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2191   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     2192   :
     2193     define buffer buf_BatchProcess for ub.BatchProcess .
     2194     define buffer buf_db           for ub.db .
     2195     define buffer buf_sys-ctrl     for ub.sys-ctrl .
     2196     define variable v-str                 as character no-undo .
     2197     define variable v-db-wait             as character no-undo .
     2198     define variable num-entries-v-db-wait as integer   no-undo .
     2199     define variable v-db-list             as character no-undo .
     2200     define variable num-entries-v-db-list as integer   no-undo .
     2201     define variable v-db-num              as character no-undo .
     2202     define variable ind                   as integer   no-undo .
     2203     define variable v-date                as date      no-undo .
     2204     define variable v-time                as integer   no-undo .
     2205     define variable v-user-id             as character no-undo .
     2206     define variable v-recid               as recid     no-undo .
     2207     define variable db-attr-code          as character no-undo .
     2208     define variable db-attr-value         as character no-undo .
     2209     define variable db-attr-type          as character no-undo .
     2210     define variable db-attr-exist         as logical   no-undo .
     2211     define variable v-free-id             as character no-undo .
     2212     if transaction = true then do:
     2213       message
     2214         vss-workfile vss-revision vss-description skip
     2215         substitute( "Вызов данной процедуры не возможен при наличии транзакции" )
     2216         view-as alert-box error
     2217       .
     2218       return error substitute( "&1. Вызов данной процедуры не возможен при наличии активной транзакции.", vss-workfile ).
     2219     end.
     2220     assign
     2221       v-str        = get-str-type( p-task-type )
     2222       db-attr-code = get-attr-code( p-task-type )
     2223     .
     2224     if v-str = ? then do:
     2225       return error string( vss-workfile + chr(32) + "НЕТ ОБРАБОТКИ АТРИБУТА" + chr(32) + p-task-type ) .
     2226     end.
     2227     run trans-task( input p-task-type ) no-error.
     2228     if error-status:error then do:
     2229       run write-to-log( vss-workfile + chr(32)
     2230                         + "Ошибка при выполнении процедуры преобразования расписания." + chr(10)
     2231                         + error-status:get-message(error-status:num-messages) + chr(10)
     2232                         + return-value
     2233                       ) .
     2234       return error.
     2235     end.
     2236     assign
     2237       v-db-wait = "":U
     2238     .
     2239     if p-db-num <> "*":U then do:
     2240       assign
     2241         v-db-list = p-db-num
     2242       .
     2243     end.
     2244     else do:
     2245       assign
     2246         v-db-list = "":U
     2247       .
     2248     end.
     2249     find first buf_sys-ctrl no-lock.
     2250     if p-task-type = 'autonws':U
     2251        and buf_sys-ctrl.db-num <> 0
     2252     then do:
     2253       run db-attr-value ( input 0
     2254                          ,input db-attr-code
     2255                          ,output db-attr-value
     2256                          ,output db-attr-type
     2257                         ) no-error.
     2258       if error-status :error then do:
     2259         run write-to-log( vss-workfile + chr(32)
     2260                           + "Ошибка при чтении атрибута наличия расписания для БД" + chr(32) + v-db-num
     2261                         ) .
     2262       end.
     2263       if v-db-list = "":U then do:
     2264         if db-attr-value = "no":U then do:
     2265           assign
     2266             v-db-list = "0":U
     2267           .
     2268         end.
     2269         else do:
     2270           assign
     2271             v-db-wait = "0":U
     2272           .
     2273         end.
     2274       end.
     2275     end.
     2276     else do:
     2277       _db:
     2278       for each buf_db no-lock
     2279       on error  undo, return error substitute( "&1 (for each db). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2280       on stop   undo, return error substitute( "&1 (for each db). stop", vss-workfile )
     2281       on endkey undo, return error substitute( "&1 (for each db). endkey", vss-workfile )
     2282       :
     2283         if p-task-type = 'autonws':U
     2284            and ( buf_db.db-num = 0
     2285                  or buf_db.db-key = "":U
     2286                  or buf_db.db-key = ?
     2287                )
     2288         then do:
     2289           next.
     2290         end.
     2291         if (p-task-type = 'autosale':U
     2292         or p-task-type = 'autogcd':U
     2293         or p-task-type = 'autocbnk':U
     2294         or p-task-type = 'autooxml':U
     2295         or p-task-type = 'autosuz':U
     2296         or p-task-type = 'autofree':U
     2297         or p-task-type = 'hddtest':U
     2298         )
     2299            and buf_db.db-num <> buf_sys-ctrl.db-num
     2300         then do:
     2301           next _db.
     2302         end.
     2303         run db-attr-value ( input buf_db.db-num
     2304                            ,input db-attr-code
     2305                            ,output db-attr-value
     2306                            ,output db-attr-type
     2307                           ) no-error.
     2308         if error-status :error then do:
     2309           run write-to-log( vss-workfile + chr(32)
     2310                             + "Ошибка при чтении атрибута наличия расписания для БД" + chr(32) + v-db-num
     2311                           ) .
     2312         end.
     2313         if lookup( string( buf_db.db-num ), v-db-list, chr(44) ) = 0 then do:
     2314           if p-db-num = "*":U
     2315             or db-attr-value = "no":U
     2316           then do:
     2317             if v-db-list = "":U then do:
     2318               assign
     2319                 v-db-list = string( buf_db.db-num )
     2320               .
     2321             end.
     2322             else do:
     2323               assign
     2324                 v-db-list = v-db-list + chr(44) + string( buf_db.db-num )
     2325               .
     2326             end.
     2327           end.
     2328           else do:
     2329             if v-db-wait = "":U then do:
     2330               assign
     2331                 v-db-wait = string( buf_db.db-num )
     2332               .
     2333             end.
     2334             else do:
     2335               assign
     2336                 v-db-wait = v-db-wait + chr(44) + string( buf_db.db-num )
     2337               .
     2338             end.
     2339           end.
     2340         end.
     2341       end.
     2342     end.
     2343     assign
     2344       num-entries-v-db-list = num-entries( v-db-list )
     2345     .
     2346     do ind = 1 to num-entries-v-db-list
     2347     on error  undo, return error substitute( "&1 (v-db-list). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2348     on stop   undo, return error substitute( "&1 (v-db-list). stop", vss-workfile )
     2349     on endkey undo, return error substitute( "&1 (v-db-list). endkey", vss-workfile )
     2350     :
     2351       assign
     2352         v-db-num = entry( ind, v-db-list )
     2353         v-recid  = ?
     2354       .
     2355       if v-db-num = "*":U
     2356         or v-db-num = "":U
     2357       then do:
     2358         next.
     2359       end.
     2360       run cur-time ( output v-date
     2361                     ,output v-time
     2362                    ).
     2363       if p-task-type = 'autofree':U and p-for-proc <> "" then do:
     2364         for each curr-task where curr-task.task-type = 'autofree':U:
     2365           run schedule-attr-get-free-id (input curr-task.cre-db-num
     2366                                         ,input curr-task.task-type
     2367                                         ,input curr-task.task-num
     2368                                         ,output v-free-id) no-error.
     2369           curr-task.task-free-id = v-free-id .
     2370         end.
     2371       end.
     2372       find first curr-task no-lock
     2373         where curr-task.task-type = p-task-type
     2374           and curr-task.db-num    = v-db-num
     2375           and curr-task.task-date = v-date
     2376           and curr-task.task-time > v-time
     2377           and (p-for-proc = "" or lookup (string(curr-task.task-free-id), p-for-proc) > 0)
     2378         no-error
     2379       .
     2380       if not available curr-task then do:
     2381         find first curr-task no-lock
     2382           where curr-task.task-type = p-task-type
     2383             and curr-task.db-num    = v-db-num
     2384             and curr-task.task-date > v-date
     2385             and (p-for-proc = "" or lookup (string(curr-task.task-free-id), p-for-proc) > 0)
     2386           no-error
     2387         .
     2388       end.
     2389       do transaction
     2390       on error  undo, return error substitute( "&1 (do transaction). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2391       on stop   undo, return error substitute( "&1 (do transaction). stop", vss-workfile )
     2392       on endkey undo, return error substitute( "&1 (do transaction). endkey", vss-workfile )
     2393       :
     2394         find first buf_BatchProcess exclusive-lock
     2395           where buf_BatchProcess.BP_Status   = 'N':U
     2396             and buf_BatchProcess.BP_Type     = p-task-type
     2397             and buf_BatchProcess.CharKey_One = v-db-num
     2398             and buf_BatchProcess.CharKey_Two = "auto":U
     2399             and (p-task-type <> 'autooxml':U or
     2400                   (p-task-type = 'autooxml':U and
     2401                     (  (num-entries (buf_BatchProcess.CharKey_Three, chr(3)) <= 3 and p-for-extsys = ""
     2402                         )
     2403                     or (p-for-extsys <> ""
     2404                         and num-entries (buf_BatchProcess.CharKey_Three, chr(3)) > 3
     2405                         and entry (4, buf_BatchProcess.CharKey_Three, chr(3)) = p-for-extsys
     2406                         )
     2407                      )
     2408                    )
     2409                  )
     2410             and (p-task-type <> 'autofree':U or
     2411                   (p-task-type = 'autofree':U and
     2412                     (  (num-entries (buf_BatchProcess.CharKey_Three, chr(3)) <= 3 and p-for-proc = ""
     2413                         )
     2414                     or (p-for-proc <> ""
     2415                         and num-entries (buf_BatchProcess.CharKey_Three, chr(3)) > 3
     2416                         and entry (4, buf_BatchProcess.CharKey_Three, chr(3)) = p-for-proc
     2417                         )
     2418                      )
     2419                    )
     2420                  )
     2421           no-error
     2422         .
     2423         run db-attr-exist ( input v-db-num
     2424                           ,input  db-attr-code
     2425                           ,output db-attr-exist
     2426                           ) no-error.
     2427         if error-status :error then do:
     2428           run write-to-log( vss-workfile + chr(32)
     2429                             + "Ошибка при определении наличия атрибута расписания для БД" + chr(32) + v-db-num
     2430                           ) .
     2431         end.
     2432         run db-attr-value ( input  v-db-num
     2433                           ,input  db-attr-code
     2434                           ,output db-attr-value
     2435                           ,output db-attr-type
     2436                           ) no-error.
     2437         if error-status :error then do:
     2438           run write-to-log( vss-workfile + chr(32)
     2439                             + "Ошибка при чтении атрибута наличия расписания для БД" + chr(32) + v-db-num
     2440                           ) .
     2441         end.
     2442         if not available curr-task then do:
     2443           if db-attr-value = "yes":U
     2444             or db-attr-exist = false
     2445             or p-session-begin = true
     2446           then do:
     2447             if p-task-type <> 'mercury':U
     2448             and p-task-type <> 'is_PM':U
     2449             then
     2450             run write-to-log( substitute( "Для БД &1 &2 не составлено расписание!", v-db-num, if p-for-proc <> "" then "и процесса произвольного задания " + p-for-proc else "") ).
     2451             run db-attr-write ( input v-db-num
     2452                               ,input db-attr-code
     2453                               ,input no
     2454                               ) no-error.
     2455             if error-status :error then do:
     2456               run write-to-log( substitute( "&1. Ошибка при записи атрибута отсутствия расписания для БД &2"
     2457                                           ,vss-workfile
     2458                                           ,v-db-num
     2459                                           )
     2460                               ) .
     2461             end.
     2462           end.
     2463           if available buf_BatchProcess
     2464             and ( buf_BatchProcess.BP_ExecSysDate < v-date
     2465                   or ( buf_BatchProcess.BP_ExecSysDate = v-date
     2466                       and buf_BatchProcess.BP_ExecSysTimeInt < v-time
     2467                     )
     2468                 )
     2469           then do:
     2470             delete buf_BatchProcess.
     2471           end.
     2472           next.
     2473         end.
     2474         run get-userid in parparentproc
     2475           ( output v-user-id
     2476           ).
     2477         if not available buf_BatchProcess then do:
     2478           create buf_BatchProcess.
     2479           assign
     2480             buf_BatchProcess.BatchProcess# = next-value (s-btpr, ub)
     2481             buf_BatchProcess.BP_Type       = p-task-type
     2482             buf_BatchProcess.BP_Status     = 'N':U
     2483             buf_BatchProcess.CharKey_One   = v-db-num
     2484             buf_BatchProcess.CharKey_Two   = "auto":U
     2485           .
     2486         end.
     2487         assign
     2488           buf_BatchProcess.CharKey_Three     = substitute( "&1&2&3&2&4&5", buf_sys-ctrl.db-num, chr(3), curr-task.task-type, curr-task.task-num,
     2489               if (p-for-extsys <> "" and p-task-type = 'autooxml':U) then chr(3) + p-for-extsys else
     2490                   if (p-for-proc <> "" and p-task-type = 'autofree':U) then chr(3) + p-for-proc else "")
     2491           buf_BatchProcess.User_ID           = v-user-id
     2492           buf_BatchProcess.Key#_One          = 0
     2493           buf_BatchProcess.BP_SysDate        = v-date
     2494           buf_BatchProcess.BP_SysTimeInt     = v-time
     2495           buf_BatchProcess.BP_SysTime        = string(v-time, 'HH:MM:SS':U)
     2496           buf_BatchProcess.BP_ExecSysDate    = curr-task.task-date
     2497           buf_BatchProcess.BP_ExecSysTimeInt = curr-task.task-time
     2498           buf_BatchProcess.BP_ExecSysTime    = string(curr-task.task-time, 'HH:MM:SS':U)
     2499         .
     2500         run write-to-log( "Следующий сеанс" + chr(32) + v-str
     2501                           + chr(32) + v-db-num
     2502                           + chr(32) + "после" + chr(32) + buf_BatchProcess.BP_ExecSysTime
     2503                           + chr(32) + string( buf_BatchProcess.BP_ExecSysDate , "99.99.9999" )
     2504                         ) .
     2505         run db-attr-write ( input v-db-num
     2506                           ,input db-attr-code
     2507                           ,input "yes":U
     2508                           ) no-error.
     2509         if error-status :error then do:
     2510           run write-to-log( vss-workfile + chr(32)
     2511                             + "Ошибка при записи атрибута наличия расписание для БД" + chr(32) + v-db-num
     2512                           ) .
     2513         end.
     2514       end.
     2515     end.
     2516     if p-session-begin = true then do:
     2517       assign
     2518         num-entries-v-db-wait = num-entries( v-db-wait )
     2519       .
     2520       do ind = 1 to num-entries-v-db-wait
     2521       on error  undo, return error substitute( "&1 (v-db-wait). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2522       on stop   undo, return error substitute( "&1 (v-db-wait). stop", vss-workfile )
     2523       on endkey undo, return error substitute( "&1 (v-db-wait). endkey", vss-workfile )
     2524       :
     2525         find first buf_BatchProcess no-lock
     2526           where buf_BatchProcess.BP_Status   = 'N':U
     2527             and buf_BatchProcess.BP_Type     = p-task-type
     2528             and buf_BatchProcess.CharKey_One = entry( ind, v-db-wait )
     2529             and buf_BatchProcess.CharKey_Two = "auto":U
     2530             and (p-task-type <> 'autooxml':U or
     2531                   (p-task-type = 'autooxml':U and
     2532                     (  (num-entries (buf_BatchProcess.CharKey_Three, chr(3)) <= 3 and p-for-extsys = ""
     2533                         )
     2534                     or (p-for-extsys <> ""
     2535                         and num-entries (buf_BatchProcess.CharKey_Three, chr(3)) > 3
     2536                         and entry (4, buf_BatchProcess.CharKey_Three, chr(3)) = p-for-extsys
     2537                         )
     2538                      )
     2539                    )
     2540                  )
     2541             and (p-task-type <> 'autofree':U or
     2542                   (p-task-type = 'autofree':U and
     2543                     (  (num-entries (buf_BatchProcess.CharKey_Three, chr(3)) <= 3 and p-for-proc = ""
     2544                         )
     2545                     or (p-for-proc <> ""
     2546                         and num-entries (buf_BatchProcess.CharKey_Three, chr(3)) > 3
     2547                         and entry (4, buf_BatchProcess.CharKey_Three, chr(3)) = p-for-proc
     2548                         )
     2549                      )
     2550                    )
     2551                  )
     2552           no-error
     2553         .
     2554         if available buf_BatchProcess then do:
     2555           run write-to-log( "Очередной сеанс" + chr(32) + v-str
     2556                             + chr(32) + entry( ind, v-db-wait )
     2557                             + chr(32) + "после" + chr(32) + buf_BatchProcess.BP_ExecSysTime
     2558                             + chr(32) + string( buf_BatchProcess.BP_ExecSysDate , "99.99.9999" )
     2559                           ) .
     2560         end.
     2561       end.
     2562     end.
     2563     for each buf_db no-lock
     2564     on error  undo, return error substitute( "&1 (for each db 2). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2565     on stop   undo, return error substitute( "&1 (for each db 2). stop", vss-workfile )
     2566     on endkey undo, return error substitute( "&1 (for each db 2). endkey", vss-workfile )
     2567     :
     2568       find first buf_BatchProcess exclusive-lock
     2569         where buf_BatchProcess.BP_Status   = 'N':U
     2570           and buf_BatchProcess.BP_Type     = p-task-type
     2571           and buf_BatchProcess.CharKey_One = string( buf_db.db-num )
     2572           and buf_BatchProcess.CharKey_Two = "auto":U
     2573           and (p-task-type <> 'autooxml':U or
     2574                 (p-task-type = 'autooxml':U and
     2575                   (  (num-entries (buf_BatchProcess.CharKey_Three, chr(3)) <= 3 and p-for-extsys = ""
     2576                       )
     2577                   or (p-for-extsys <> ""
     2578                       and num-entries (buf_BatchProcess.CharKey_Three, chr(3)) > 3
     2579                       and entry (4, buf_BatchProcess.CharKey_Three, chr(3)) = p-for-extsys
     2580                       )
     2581                    )
     2582                  )
     2583                )
     2584             and (p-task-type <> 'autofree':U or
     2585                   (p-task-type = 'autofree':U and
     2586                     (  (num-entries (buf_BatchProcess.CharKey_Three, chr(3)) <= 3 and p-for-proc = ""
     2587                         )
     2588                     or (p-for-proc <> ""
     2589                         and num-entries (buf_BatchProcess.CharKey_Three, chr(3)) > 3
     2590                         and entry (4, buf_BatchProcess.CharKey_Three, chr(3)) = p-for-proc
     2591                         )
     2592                      )
     2593                    )
     2594                  )
     2595         no-error
     2596       .
     2597       if available buf_BatchProcess
     2598         and lookup( string(buf_db.db-num), v-db-list ) = 0
     2599         and lookup( string(buf_db.db-num), v-db-wait ) = 0
     2600       then do:
     2601         delete buf_BatchProcess.
     2602       end.
     2603     end.
     2604   end.
     2605   return.
