        1   block-level on error undo, throw.
        2   define input parameter parparentproc   as handle    no-undo .
        3   define input parameter p-session-begin as logical   no-undo .
        4   define input parameter p-task-type     as character no-undo .
        5   define input parameter p-db-num        as character no-undo .
        6   define input parameter p-for-extsys    as character no-undo .
        7   define input parameter p-for-proc      as character no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision: 784232a2254b, 2720, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
       10   define variable vss-date        as character no-undo init "$Date: Пн янв 18 10:14:30 2021 +0300 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: wr-n-bp.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: adm/wr-n-bp.p $":U .
       13   define variable vss-description as character no-undo init "запись следующего по расписанию задания".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   define  shared variable g#auto-pid           as integer   no-undo .
       70   define  shared variable conn-par             as character no-undo .
       71   define  shared variable g#auto-user-id       as character no-undo .
       72   define  shared variable g#auto-user-login    as character no-undo .
       73   define  shared variable g#auto-user-password as character no-undo .
       74   define  shared variable v-socket             as logical   no-undo .
       75   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   define  shared variable auto-window-h     as handle    no-undo .
       77   define  shared variable auto-log-msg-h    as handle    no-undo .
       78   define  shared variable hand-log-msg-h    as handle    no-undo .
       79   define  shared variable log-file-name     as character no-undo initial ? .
       80   define  shared variable add-log-file-name as character no-undo initial ? .
       81   define  shared variable writelogvalue     as character no-undo initial ? .
       82   define new global shared variable g#language as character no-undo .
       83   if g#language <> '' and g#language <> 'rus':U then do:
       84     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       85   end.
       86   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       87   procedure cur-time :
       88      define output parameter p-today as date      no-undo .
       89      define output parameter p-time  as integer   no-undo .
       90     do
       91     on error undo, return error
       92     :
       93       define variable v-date1 as date      no-undo .
       94       define variable v-date2 as date      no-undo .
       95       define variable v-time  as integer   no-undo .
       96       assign
       97         v-date1 = today
       98         v-time  = time
       99         v-date2 = today
      100       .
      101       if v-date1 <> v-date2
      102       then do:
      103         assign
      104           v-date1 = today
      105           v-time  = v-time
      106         .
      107       end.
      108       assign
      109         p-today = v-date1
      110         p-time  = v-time
      111       .
      112     end.
      113   end.
      114   function cur-time-date returns character
      115   :
      116     return string(today, '99/99/9999':U) .
      117   end.
      118   function cur-time-mjd returns decimal
      119   :
      120     define variable v-date as date      no-undo .
      121     define variable v-time as integer   no-undo .
      122     run cur-time in this-procedure
      123       (output v-date
      124       ,output v-time
      125       ) .
      126     return integer(v-date) - 2400002 + (v-time / 86400) .
      127   end.
      128   function cur-time-get-ending-index returns integer
      129   (input p-number as integer
      130   )
      131   :
      132     if p-number < 0
      133     or p-number = ?
      134     then do:
      135       return 1 .
      136     end.
      137     define variable v-rest as integer   no-undo .
      138     assign
      139       p-number = p-number modulo 100
      140     .
      141     if p-number < 20
      142     then do:
      143       assign
      144         v-rest = p-number
      145       .
      146     end.
      147     else do:
      148       assign
      149         v-rest = p-number modulo 10
      150       .
      151     end.
      152     case v-rest :
      153       when 1
      154       then do:
      155         return 2 .
      156       end.
      157       when 2 or
      158       when 3 or
      159       when 4
      160       then do:
      161         return 3 .
      162       end.
      163       otherwise do:
      164         return 1 .
      165       end.
      166     end case .
      167   end.
      168   procedure cur-time-mjd-to-date :
      169      define input  parameter i-mjd-diff as decimal no-undo.
      170      define output parameter o-Date     as date    no-undo.
      171      define output parameter o-Time     as integer no-undo.
      172      define variable v-day-number as integer   no-undo .
      173      if    i-mjd-diff < 0
      174         or i-mjd-diff = ?
      175      then do:
      176         return "?" .
      177      end.
      178      assign
      179         v-day-number = truncate(i-mjd-diff,0).
      180         o-Date = date(v-day-number + 2400002).
      181         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      182     .
      183   end.
      184   function cur-time-mjd-to-string returns character
      185   (input p-mjd-diff as decimal
      186   )
      187   :
      188     define variable v-day-number as integer   no-undo .
      189     define variable v-seconds    as integer   no-undo .
      190     define variable v-hour       as integer   no-undo .
      191     define variable v-min        as integer   no-undo .
      192     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      193     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      194     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      195     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      196     if p-mjd-diff < 0
      197     or p-mjd-diff = ?
      198     then do:
      199       return "?" .
      200     end.
      201     assign
      202       v-day-number = integer(truncate(p-mjd-diff,0))
      203       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      204     .
      205     if v-seconds > 86400
      206     then do:
      207       assign
      208         v-seconds = 86400 - 1
      209       .
      210     end.
      211     if v-seconds < 0
      212     then do:
      213       assign
      214         v-seconds = 0
      215       .
      216     end.
      217     assign
      218       v-hour = truncate(v-seconds / 3600, 0)
      219     .
      220     assign
      221       v-seconds = v-seconds modulo 3600
      222     .
      223     assign
      224       v-min = truncate(v-seconds / 60, 0)
      225     .
      226     assign
      227       v-seconds = v-seconds modulo 60
      228     .
      229     return
      230         (if v-day-number <> 0
      231           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      232           else ""
      233         )
      234       + (if v-day-number <> 0 or v-hour <> 0
      235           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      236           else ""
      237         )
      238       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      239           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      240           else ""
      241         )
      242       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      243       .
      244   end.
      245   function cur-time-string returns character
      246   :
      247     define variable v-date as date      no-undo .
      248     define variable v-time as integer   no-undo .
      249     run cur-time in this-procedure
      250       (output v-date
      251       ,output v-time
      252       ) .
      253     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      254   end.
      255   function cur-time-string-sec returns character
      256   :
      257     define variable v-date as date      no-undo .
      258     define variable v-time as integer   no-undo .
      259     run cur-time in this-procedure
      260       (output v-date
      261       ,output v-time
      262       ) .
      263     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      264   end.
      265   function cur-time-custom  returns character
      266   (input p-prefix as character
      267   ,input p-date-format as character
      268   ,input p-delimiter as character
      269   ,input p-time-format as character
      270   ,input p-suffix as character
      271   )
      272   :
      273     define variable v-date as date      no-undo .
      274     define variable v-time as integer   no-undo .
      275     run cur-time in this-procedure
      276       (output v-date
      277       ,output v-time
      278       ) .
      279     return
      280       p-prefix
      281       + string(v-date, p-date-format)
      282       + p-delimiter
      283       + string(v-time, p-time-format)
      284       + p-suffix
      285       .
      286   end.
      287   function cur-time-print  returns character
      288   :
      289     define variable v-date as date      no-undo .
      290     define variable v-time as integer   no-undo .
      291     run cur-time in this-procedure
      292       (output v-date
      293       ,output v-time
      294       ) .
      295     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      296   end.
      297   function cur-time-datetime returns datetime
      298   :
      299     define variable v-char as character no-undo .
      300     define variable v-datetime as datetime no-undo .
      301     v-char = cur-time-string().
      302     v-datetime = datetime(v-char).
      303     return  v-datetime.
      304   end.
      305   function cur-time-string-msec returns character
      306   :
      307     define variable v-date as datetime  no-undo .
      308     v-date = now.
      309     return string(v-date) .
      310   end.
      311   define stream LogStream .
      312   define variable mNoTime as logical no-undo.
      313   procedure write-to-log-notime :
      314     define input param i-str as character no-undo .
      315     mNoTime = yes.
      316     run write-to-log (i-str).
      317     mNoTime = no.
      318   end.
      319   procedure write-to-log :
      320     define input param p-str as character no-undo .
      321     do
      322     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      323     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      324     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      325     :
      326       define variable log-res        as logical   no-undo .
      327       define variable v-jj           as integer   no-undo .
      328       if    mNoTime
      329          or writelogvalue eq "AsyncProc"
      330       then
      331          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      332       else
      333          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      334       if auto-log-msg-h <> ? then do:
      335         log-res = auto-log-msg-h:move-to-eof( ) .
      336         log-res = auto-log-msg-h:insert-string( p-str ).
      337       end.
      338       if hand-log-msg-h <> ? then do:
      339         log-res = hand-log-msg-h:move-to-eof( ) .
      340         log-res = hand-log-msg-h:insert-string( p-str ).
      341       end.
      342       assign
      343         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      344         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      345         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      346       .
      347       if add-log-file-name <> ? then do:
      348         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      349           run gbl/fileapnd.p
      350             ( input entry(v-jj, add-log-file-name, chr(1) )
      351             ,input p-str
      352             ,input 20
      353             ) no-error .
      354           if error-status:error then do:
      355             return error return-value .
      356           end.
      357         end.
      358       end.
      359       if writelogvalue eq "AsyncProc"
      360       then do:
      361          p-str = trim(p-str, (chr(13) + chr(10)) )
      362       .
      363          Publish "WriteLogAsunc" (p-str,yes).
      364       end.
      365       else if writelogvalue <> "yes" then do:
      366         run gbl/fileapnd.p
      367           ( input log-file-name
      368           ,input p-str
      369           ,input 20
      370           ) no-error .
      371         if error-status:error then do:
      372           return error return-value .
      373         end.
      374       end.
      375     end.
      376   end procedure.
      377   procedure write-to-screen :
      378     define input param p-str as character no-undo .
      379     do
      380     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      381     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      382     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      383     :
      384       define variable log-res as logical no-undo.
      385       assign
      386         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      387       .
      388       if auto-log-msg-h <> ?
      389       then do:
      390         log-res = auto-log-msg-h:move-to-eof( ) .
      391         log-res = auto-log-msg-h:insert-string( p-str ).
      392       end.
      393       if hand-log-msg-h <> ?
      394       then do:
      395         log-res = hand-log-msg-h:move-to-eof( ) .
      396         log-res = hand-log-msg-h:insert-string( p-str ).
      397       end.
      398     end.
      399   end procedure.
      400   procedure send-msg-to-email :
      401     define input  parameter p-subject      as character no-undo .
      402     define input  parameter p-text-err     as character no-undo .
      403     define input  parameter p-attach-files as character no-undo .
      404     do
      405     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      406     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      407     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      408     :
      409       define variable v-tth             as handle    no-undo .
      410       define variable v-value-character as character no-undo .
      411       define variable v-value-date      as date      no-undo .
      412       define variable v-value-decimal   as decimal   no-undo .
      413       define variable v-value-integer   as integer   no-undo .
      414       define variable v-value-logical   as logical   no-undo .
      415       define variable v-param-type      as character no-undo .
      416       define variable v-email       as character no-undo .
      417       define variable v-tmp-str     as character no-undo .
      418       define variable v-tmp1-str    as character no-undo .
      419       define variable v-ind         as integer   no-undo .
      420       define variable v-num-entries as integer   no-undo .
      421       delete object v-tth no-error.
      422       run adm/shattri.p
      423         ( input "get":U
      424          ,input  "":U
      425          ,input  0
      426          ,input  'auto-task':U
      427          ,input  'send-msg-to-email':U
      428          ,output v-value-character
      429          ,output v-value-date
      430          ,output v-value-decimal
      431          ,output v-value-integer
      432          ,output v-value-logical
      433          ,output v-param-type
      434          ,input-output table-handle v-tth
      435         ) no-error .
      436       if not error-status :error  then do:
      437         assign
      438           v-tmp-str = v-value-character
      439         .
      440       end.
      441       delete object v-tth no-error.
      442       assign
      443         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      444         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      445         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      446         v-num-entries = num-entries( v-tmp-str, chr(44) )
      447         v-email       = "":U
      448       .
      449       do v-ind = 1 to v-num-entries
      450       :
      451         assign
      452           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      453         .
      454         if trim( v-tmp1-str ) <> "":U then do:
      455           if v-email = "":U then do:
      456             assign
      457               v-email = v-tmp1-str
      458             .
      459           end.
      460           else do:
      461             assign
      462               v-email = v-email + chr(44) + v-tmp1-str
      463             .
      464           end.
      465         end.
      466       end.
      467       if v-email <> "":U then do:
      468         run gbl/sendmail.p
      469           ( input v-email
      470           , input p-subject
      471           , input p-text-err
      472           , input p-attach-files
      473           ) no-error .
      474         if error-status :error
      475           or return-value <> "":U
      476         then do:
      477           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      478         end.
      479       end.
      480     end.
      481   end procedure.
      482   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      483   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      484   PROCEDURE LastDate:
      485       def input parameter in-date as date no-undo.
      486       def output parameter LastDate as date no-undo.
      487       LastDate = ((DATE(MONTH(in-date),28,YEAR(in-date)) + 4) - DAY(DATE(MONTH(in-date),28,YEAR(in-date)) + 4)).
      488   END PROCEDURE.
      489   define temp-table curr-task no-undo
      490     field db-num      as character column-label "БД" format "X(5)"
      491     field db-num-char as character column-label "БД" format "X(5)"
      492     field task-num    as integer   column-label "N задачи" format ">>>>>>>9"
      493     field task-type   as character
      494     field cre-db-num    as integer
      495     field task-date   as date      column-label "Дата"  format "99.99.9999"
      496     field task-time   as integer   column-label "Время"
      497     field task-free-id  as character column-label "ID произвольного задания"
      498     index pi is unique primary
      499       task-type
      500       db-num
      501       task-num
      502     index pii
      503       task-type
      504       db-num
      505       task-date
      506       task-time
      507   .
      508   define temp-table tt-weekday no-undo
      509     field weekday as integer
      510     index pi is unique primary
      511       weekday ascending
      512   .
      513   define temp-table tt-hour no-undo
      514     field hour as integer
      515     index pi is unique primary
      516       hour ascending
      517   .
      518   define temp-table tt-minute no-undo
      519     field minute as integer
      520     index pi is unique primary
      521       minute ascending
      522   .
      523   define temp-table tt-db no-undo
      524     field db-num as integer
      525     index pi is unique primary
      526       db-num ascending
      527   .
      528   procedure trans-task :
      529     define input parameter p-task-type as character no-undo .
      530     do
      531     on error undo, return error
      532     :
      533       define variable v-curr-weekday  as integer   no-undo .
      534       define variable v-today         as date      no-undo .
      535       define variable v-curr-time     as integer   no-undo .
      536       define variable v-curr-time-str as character no-undo .
      537       define variable v-curr-hour     as integer   no-undo .
      538       define variable v-curr-minute   as integer   no-undo .
      539       define variable v-curr-sec      as integer   no-undo .
      540       define variable v-task-date     as date      no-undo .
      541       define variable v-task-time     as integer   no-undo .
      542       define variable v-last-date     as date      no-undo .
      543       define variable v-num-entries   as integer   no-undo .
      544       define variable v-ind           as integer   no-undo .
      545       define variable v-set-task      as logical   no-undo .
      546       define variable v-task-time-h   as integer   no-undo .
      547       define variable v-first-hour    as integer   no-undo .
      548       define variable v-task-time-m   as integer   no-undo .
      549       define variable v-first-minute  as integer   no-undo .
      550       define variable v-create-task   as logical   no-undo .
      551       define buffer buf_schedule for ub.schedule .
      552       define buffer buf_db       for ub.db .
      553       define buffer buf_sys-ctrl for ub.sys-ctrl .
      554       find first buf_sys-ctrl no-lock .
      555       block_sch:
      556       for each buf_schedule no-lock
      557         where buf_schedule.cre-db-num = buf_sys-ctrl.db-num
      558           and buf_schedule.task-type  = p-task-type
      559           and buf_schedule.active     = TRUE
      560       on error undo, return error
      561       :
      562         assign
      563           v-today         = today
      564           v-curr-time     = time
      565           v-curr-time-str = string( time, "HH:MM:SS":U )
      566           v-curr-hour     = integer( entry( 1, v-curr-time-str, ":":U ) )
      567           v-curr-minute   = integer( entry( 2, v-curr-time-str, ":":U ) )
      568           v-curr-sec      = integer( entry( 3, v-curr-time-str, ":":U ) )
      569           v-task-date     = v-today
      570           v-task-time     = v-curr-time
      571         .
      572         if trim( buf_schedule.task-weekday ) <> "*":U then do:
      573           for each tt-weekday
      574           on error undo, return error return-value
      575           :
      576             delete tt-weekday.
      577           end.
      578           run gbl/prcs-lst.p
      579             ( input  buf_schedule.task-weekday
      580              ,input  1
      581              ,input  7
      582              ,input  false
      583              ,input (buffer tt-weekday:handle)
      584              ,input "weekday":U
      585             ) no-error .
      586           find first tt-weekday no-lock
      587             where tt-weekday.weekday >= weekday( v-task-date ) - 1
      588             no-error .
      589           if available tt-weekday then do:
      590             assign
      591               v-task-date = v-task-date + tt-weekday.weekday - weekday( v-task-date ) + 1
      592             .
      593           end.
      594           else do:
      595             for first tt-weekday no-lock
      596               by tt-weekday.weekday
      597             on error undo, return error return-value
      598             :
      599               assign
      600                 v-task-date = v-task-date + 7 + tt-weekday.weekday - weekday( v-task-date + 7 ) + 1
      601               .
      602             end.
      603           end.
      604           if v-task-date < v-today then do:
      605             next block_sch.
      606           end.
      607         end.
      608         else do:
      609           if trim( buf_schedule.task-year ) <> "*":U then do:
      610             assign
      611               v-task-date = date( month( v-task-date )
      612                                   ,day( v-task-date )
      613                                   ,integer( buf_schedule.task-year )
      614                                 )
      615             .
      616             if v-task-date < v-today then do:
      617               next block_sch.
      618             end.
      619           end.
      620           if trim( buf_schedule.task-month ) <> "*":U then do:
      621             assign
      622               v-task-date = date( integer( buf_schedule.task-month )
      623                                   ,day( v-task-date )
      624                                   ,year( v-task-date )
      625                                 )
      626             .
      627             if v-task-date < v-today then do:
      628               run next-task-year ( input recid( buf_schedule )
      629                                   ,input-output v-task-date
      630                                 ) no-error.
      631               if error-status :error then do:
      632                 next block_sch.
      633               end.
      634             end.
      635           end.
      636           if trim( buf_schedule.task-day ) <> "*":U then do:
      637             run lastdate in this-procedure
      638               (input  v-task-date
      639               ,output v-last-date
      640               ) no-error .
      641             if error-status :error then do:
      642               next block_sch.
      643             end.
      644             if integer( buf_schedule.task-day ) > day( v-last-date ) then do:
      645               next block_sch.
      646             end.
      647             assign
      648               v-task-date = date( month( v-task-date )
      649                                  ,integer( buf_schedule.task-day )
      650                                  ,year( v-task-date )
      651                                 )
      652             .
      653             if v-task-date < v-today then do:
      654               run next-task-month in this-procedure
      655                 ( input recid( buf_schedule )
      656                  ,input-output v-task-date
      657                 ) no-error.
      658               if error-status :error then do:
      659                 next block_sch.
      660               end.
      661             end.
      662           end.
      663         end.
      664         if trim( buf_schedule.task-hour ) <> "*":U then do:
      665           for each tt-hour
      666           on error undo, return error return-value
      667           :
      668             delete tt-hour.
      669           end.
      670           run gbl/prcs-lst.p
      671             ( input  buf_schedule.task-hour
      672              ,input  0
      673              ,input  24
      674              ,input  false
      675              ,input (buffer tt-hour:handle)
      676              ,input "hour":U
      677             ) no-error .
      678           for first tt-hour no-lock
      679             by tt-hour.hour
      680           on error undo, return error return-value
      681           :
      682             assign
      683               v-first-hour = tt-hour.hour
      684             .
      685           end.
      686           if v-task-date > v-today then do:
      687             assign
      688               v-task-time = v-task-time + ( v-first-hour - v-curr-hour ) * 3600
      689             .
      690           end.
      691           else do:
      692             if v-task-date = v-today then do:
      693               assign
      694                 v-task-time-h = v-task-time
      695                 v-set-task    = false
      696               .
      697               block_hour:
      698               for each tt-hour no-lock
      699                 by tt-hour.hour
      700               on error undo, return error return-value
      701               :
      702                 assign
      703                   v-task-time-h = v-task-time + ( tt-hour.hour - v-curr-hour ) * 3600
      704                 .
      705                 if v-task-time-h >= v-curr-time then do:
      706                   assign
      707                     v-task-time = v-task-time-h
      708                     v-set-task  = true
      709                   .
      710                   leave block_hour.
      711                 end.
      712               end.
      713               if v-task-time < v-curr-time
      714                 or v-set-task = false
      715               then do:
      716                 assign
      717                   v-task-time = v-task-time + ( v-first-hour - v-curr-hour ) * 3600
      718                 .
      719                 run next-task-day ( input recid( buf_schedule )
      720                                    ,input-output v-task-date
      721                                   ) no-error.
      722                 if error-status :error then do:
      723                   next block_sch.
      724                 end.
      725               end.
      726             end.
      727           end.
      728         end.
      729         else do:
      730           if v-task-date > v-today then do:
      731             assign
      732               v-task-time = v-task-time + ( 0 - v-curr-hour ) * 3600
      733             .
      734           end.
      735         end.
      736         if trim( buf_schedule.task-minute ) <> "*":U then do:
      737           for each tt-minute
      738           on error undo, return error return-value
      739           :
      740             delete tt-minute.
      741           end.
      742           run gbl/prcs-lst.p
      743             ( input buf_schedule.task-minute
      744              ,input 0
      745              ,input 60
      746              ,input false
      747              ,input (buffer tt-minute:handle)
      748              ,input "minute":U
      749             ) no-error .
      750           for first tt-minute no-lock
      751             by tt-minute.minute
      752           on error undo, return error return-value
      753           :
      754             assign
      755               v-first-minute = tt-minute.minute
      756             .
      757           end.
      758           if v-task-date > v-today then do:
      759             assign
      760               v-task-time = v-task-time + ( v-first-minute - v-curr-minute ) * 60
      761             .
      762           end.
      763           else do:
      764             if v-task-date = v-today then do:
      765               assign
      766                 v-task-time-m = v-task-time
      767                 v-set-task    = false
      768               .
      769               block_minute:
      770               for each tt-minute no-lock
      771                 by tt-minute.minute
      772               on error undo, return error return-value
      773               :
      774                 assign
      775                   v-task-time-m = v-task-time + ( tt-minute.minute - v-curr-minute ) * 60
      776                 .
      777                 if v-task-time-m >= v-curr-time then do:
      778                   assign
      779                     v-task-time = v-task-time-m
      780                     v-set-task  = true
      781                   .
      782                   leave block_minute.
      783                 end.
      784               end.
      785               if v-task-time < v-curr-time
      786                 or v-set-task = false
      787               then do:
      788                 assign
      789                   v-task-time = v-task-time + ( v-first-minute - v-curr-minute ) * 60
      790                 .
      791                 run next-task-hour ( input recid( buf_schedule )
      792                                     ,input-output v-task-date
      793                                     ,input-output v-task-time
      794                                   ) no-error.
      795                 if error-status :error then do:
      796                   next block_sch.
      797                 end.
      798               end.
      799             end.
      800           end.
      801         end.
      802         else do:
      803           assign
      804             v-task-time-h = integer( entry( 1, string( v-task-time, "HH:MM:SS":U ), ":":U ) )
      805           .
      806           if v-task-date > v-today
      807             or ( v-task-date = v-today
      808                  and v-task-time-h > v-curr-hour
      809                )
      810           then do:
      811             assign
      812               v-task-time = v-task-time + ( 0 - v-curr-minute ) * 60
      813             .
      814           end.
      815         end.
      816         if trim( buf_schedule.task-second ) <> "*":U then do:
      817           assign
      818             v-task-time = v-task-time - v-curr-sec + integer( buf_schedule.task-second )
      819           .
      820           if v-task-date = v-today
      821             and v-task-time + 10 <= v-curr-time
      822           then do:
      823             run next-task-minute ( input recid( buf_schedule )
      824                                   ,input-output v-task-date
      825                                   ,input-output v-task-time
      826                                  ) no-error.
      827             if error-status :error then do:
      828               next block_sch.
      829             end.
      830           end.
      831         end.
      832         if v-task-date = v-today
      833           and v-task-time <= v-curr-time
      834         then do:
      835           run next-task-minute ( input recid( buf_schedule )
      836                                 ,input-output v-task-date
      837                                 ,input-output v-task-time
      838                                 ) no-error.
      839           if error-status :error then do:
      840             next block_sch.
      841           end.
      842         end.
      843         if buf_schedule.db-num-char <> "*":U then do:
      844           for each tt-db
      845           on error undo, return error return-value
      846           :
      847             delete tt-db.
      848           end.
      849           run gbl/prcs-lst.p
      850             ( input buf_schedule.db-num-char
      851             ,input 0
      852             ,input 99999
      853             ,input false
      854             ,input (buffer tt-db:handle)
      855             ,input "db-num":U
      856             ) no-error .
      857         end.
      858         for each buf_db no-lock
      859         on error undo, return error return-value
      860         :
      861           assign
      862             v-create-task = true
      863           .
      864           if buf_schedule.db-num-char <> "*":U then do:
      865             find first tt-db no-lock
      866               where tt-db.db-num = buf_db.db-num
      867               no-error .
      868             if not available tt-db then do:
      869               assign
      870                 v-create-task = false
      871               .
      872             end.
      873           end.
      874           if v-create-task = true then do:
      875             create curr-task .
      876             assign
      877               curr-task.db-num      = string( buf_db.db-num )
      878               curr-task.db-num-char = buf_schedule.db-num-char
      879               curr-task.task-num    = buf_schedule.task-num
      880               curr-task.task-type   = buf_schedule.task-type
      881               curr-task.cre-db-num    = buf_schedule.cre-db-num
      882               curr-task.task-date   = v-task-date
      883               curr-task.task-time   = v-task-time
      884             .
      885           end.
      886         end.
      887       end.
      888       for each tt-weekday
      889       on error undo, return error return-value
      890       :
      891         delete tt-weekday.
      892       end.
      893       for each tt-hour
      894       on error undo, return error return-value
      895       :
      896         delete tt-hour.
      897       end.
      898       for each tt-minute
      899       on error undo, return error return-value
      900       :
      901         delete tt-minute.
      902       end.
      903       for each tt-db
      904       on error undo, return error return-value
      905       :
      906         delete tt-db.
      907       end.
      908     end.
      909   end procedure.
      910   procedure next-task-year :
      911     define input        parameter p-recid-sch as recid no-undo .
      912     define input-output parameter p-task-date as date no-undo.
      913     do
      914     on error undo, return error
      915     :
      916       define buffer buf_schedule for ub.schedule .
      917       find first buf_schedule no-lock
      918         where recid( buf_schedule ) = p-recid-sch
      919       .
      920       if trim( buf_schedule.task-year ) <> "*":U then do:
      921         assign
      922           p-task-date = ?
      923         .
      924         return error.
      925       end.
      926       else do:
      927         if month( p-task-date ) = 2
      928           and day( p-task-date ) = 29
      929         then do:
      930           if trim( buf_schedule.task-day ) <> "*":U then do:
      931             assign
      932               p-task-date = date( month( p-task-date )
      933                                   ,day( p-task-date )
      934                                   ,year( p-task-date ) + 4
      935                                 )
      936             .
      937           end.
      938           else do:
      939             assign
      940               p-task-date = date( month( p-task-date )
      941                                   ,28
      942                                   ,year( p-task-date ) + 1
      943                                 )
      944             .
      945           end.
      946         end.
      947         else do:
      948           assign
      949             p-task-date = date( month( p-task-date )
      950                                 ,day( p-task-date )
      951                                 ,year( p-task-date ) + 1
      952                               )
      953           .
      954         end.
      955       end.
      956     end.
      957   end procedure.
      958   procedure next-task-month :
      959     define input        parameter p-recid-sch as recid no-undo .
      960     define input-output parameter p-task-date as date no-undo.
      961     do
      962     on error undo, return error
      963     :
      964       define variable v-date      as date no-undo .
      965       define variable v-last-date as date no-undo .
      966       define buffer buf_schedule for ub.schedule .
      967       find first buf_schedule no-lock
      968         where recid( buf_schedule ) = p-recid-sch
      969       .
      970       if trim( buf_schedule.task-month ) <> "*":U then do:
      971         run next-task-year ( input p-recid-sch
      972                             ,input-output p-task-date
      973                            ) no-error.
      974         if error-status :error then do:
      975           assign
      976             p-task-date = ?
      977           .
      978           return error.
      979         end.
      980       end.
      981       else do:
      982         if month( p-task-date ) = 12 then do:
      983           assign
      984             p-task-date = date( 1
      985                                ,day( p-task-date )
      986                                ,year( p-task-date )
      987                                )
      988           .
      989           run next-task-year ( input p-recid-sch
      990                               ,input-output p-task-date
      991                             ) no-error.
      992           if error-status :error then do:
      993             assign
      994               p-task-date = ?
      995             .
      996             return error.
      997           end.
      998         end.
      999         else do:
     1000           assign
     1001             v-date = date( month( p-task-date ) + 1
     1002                           ,1
     1003                           ,year( p-task-date )
     1004                          )
     1005           .
     1006           run lastdate in this-procedure
     1007             ( input  v-date
     1008              ,output v-last-date
     1009             ) no-error .
     1010           if error-status :error then do:
     1011             assign
     1012               p-task-date = ?
     1013             .
     1014             return error.
     1015           end.
     1016           if day( p-task-date ) > day( v-last-date ) then do:
     1017             if trim( buf_schedule.task-day ) <> "*":U then do:
     1018               do while true :
     1019                 assign
     1020                   v-date = date( month( v-date ) + 1
     1021                                 ,1
     1022                                 ,year( v-date )
     1023                               )
     1024                 .
     1025                 run lastdate in this-procedure
     1026                   ( input  v-date
     1027                    ,output v-date
     1028                   ) no-error .
     1029                 if error-status :error then do:
     1030                   assign
     1031                     p-task-date = ?
     1032                   .
     1033                   return error.
     1034                 end.
     1035                 if day( p-task-date ) = day( v-date ) then do:
     1036                   assign
     1037                     p-task-date = v-date
     1038                   .
     1039                   leave.
     1040                 end.
     1041               end.
     1042             end.
     1043             else do:
     1044               assign
     1045                 p-task-date = v-last-date
     1046               .
     1047             end.
     1048           end.
     1049           else do:
     1050             assign
     1051               p-task-date = date( month( p-task-date ) + 1
     1052                                  ,day( p-task-date )
     1053                                  ,year( p-task-date )
     1054                                 )
     1055             .
     1056           end.
     1057         end.
     1058       end.
     1059     end.
     1060   end procedure.
     1061   procedure next-task-day :
     1062     define input        parameter p-recid-sch as recid no-undo .
     1063     define input-output parameter p-task-date as date no-undo.
     1064     do
     1065     on error undo, return error
     1066     :
     1067       define buffer buf_schedule for ub.schedule .
     1068       find first buf_schedule no-lock
     1069         where recid( buf_schedule ) = p-recid-sch
     1070       .
     1071       if trim( buf_schedule.task-weekday ) <> "*":U then do:
     1072         find first tt-weekday no-lock
     1073           where tt-weekday.weekday > weekday( p-task-date ) - 1
     1074           no-error .
     1075         if available tt-weekday then do:
     1076           assign
     1077             p-task-date = p-task-date + tt-weekday.weekday - weekday( p-task-date ) + 1
     1078           .
     1079         end.
     1080         else do:
     1081           for first tt-weekday no-lock
     1082             by tt-weekday.weekday
     1083           on error undo, return error return-value
     1084           :
     1085             assign
     1086               p-task-date = p-task-date + 7 + tt-weekday.weekday - weekday( p-task-date + 7 ) + 1
     1087             .
     1088           end.
     1089         end.
     1090       end.
     1091       else do:
     1092         if trim( buf_schedule.task-day ) <> "*":U then do:
     1093           run next-task-month ( input p-recid-sch
     1094                               ,input-output p-task-date
     1095                               ) no-error.
     1096           if error-status :error then do:
     1097             assign
     1098               p-task-date = ?
     1099             .
     1100             return error.
     1101           end.
     1102         end.
     1103         else do:
     1104           if month( p-task-date ) <> month( p-task-date + 1 ) then do:
     1105             assign
     1106               p-task-date = date( month( p-task-date )
     1107                                   ,1
     1108                                   ,year( p-task-date )
     1109                                 )
     1110             .
     1111             run next-task-month ( input p-recid-sch
     1112                                 ,input-output p-task-date
     1113                                 ) no-error.
     1114             if error-status :error then do:
     1115               assign
     1116                 p-task-date = ?
     1117               .
     1118               return error.
     1119             end.
     1120           end.
     1121           else do:
     1122             assign
     1123               p-task-date = p-task-date + 1
     1124             .
     1125           end.
     1126         end.
     1127       end.
     1128     end.
     1129   end procedure.
     1130   procedure next-task-hour :
     1131     define input        parameter p-recid-sch as recid   no-undo .
     1132     define input-output parameter p-task-date as date    no-undo.
     1133     define input-output parameter p-task-time as integer no-undo.
     1134     do
     1135     on error undo, return error
     1136     :
     1137       define buffer buf_schedule for ub.schedule .
     1138       define variable v-task-hour as integer   no-undo .
     1139       find first buf_schedule no-lock
     1140         where recid( buf_schedule ) = p-recid-sch
     1141       .
     1142       if trim( buf_schedule.task-hour ) <> "*":U then do:
     1143         assign
     1144           v-task-hour = integer( entry( 1, string( p-task-time, "HH:MM:SS":U ), ":":U ) )
     1145         .
     1146         find first tt-hour no-lock
     1147           where tt-hour.hour > v-task-hour
     1148           no-error .
     1149         if available tt-hour then do:
     1150           assign
     1151             p-task-time = p-task-time + ( tt-hour.hour - v-task-hour ) * 3600
     1152           .
     1153         end.
     1154         else do:
     1155           for first tt-hour no-lock
     1156             by tt-hour.hour
     1157           on error undo, return error return-value
     1158           :
     1159             assign
     1160               p-task-time = p-task-time + ( tt-hour.hour - v-task-hour ) * 3600
     1161             .
     1162           end.
     1163           run next-task-day ( input p-recid-sch
     1164                             ,input-output p-task-date
     1165                             ) no-error.
     1166           if error-status :error then do:
     1167             assign
     1168               p-task-date = ?
     1169               p-task-time = ?
     1170             .
     1171             return error.
     1172           end.
     1173         end.
     1174       end.
     1175       else do:
     1176         if p-task-time + 3600 >= 86400 then do:
     1177           run next-task-day ( input p-recid-sch
     1178                              ,input-output p-task-date
     1179                             ) no-error.
     1180           if error-status :error then do:
     1181             assign
     1182               p-task-date = ?
     1183               p-task-time = ?
     1184             .
     1185             return error.
     1186           end.
     1187           assign
     1188             p-task-time = p-task-time + 3600 - 86400
     1189           .
     1190         end.
     1191         else do:
     1192           assign
     1193             p-task-time = p-task-time + 3600
     1194           .
     1195         end.
     1196       end.
     1197     end.
     1198   end procedure.
     1199   procedure next-task-minute :
     1200     define input        parameter p-recid-sch as recid   no-undo .
     1201     define input-output parameter p-task-date as date    no-undo.
     1202     define input-output parameter p-task-time as integer no-undo.
     1203     do
     1204     on error undo, return error
     1205     :
     1206       define buffer buf_schedule for ub.schedule .
     1207       define variable v-task-minute as integer   no-undo .
     1208       find first buf_schedule no-lock
     1209         where recid( buf_schedule ) = p-recid-sch
     1210       .
     1211       if trim( buf_schedule.task-minute ) <> "*":U then do:
     1212         assign
     1213           v-task-minute = integer( entry( 2, string( p-task-time, "HH:MM:SS":U ), ":":U ) )
     1214         .
     1215         find first tt-minute no-lock
     1216           where tt-minute.minute > v-task-minute
     1217           no-error .
     1218         if available tt-minute then do:
     1219           assign
     1220             p-task-time = p-task-time + ( tt-minute.minute - v-task-minute ) * 60
     1221           .
     1222         end.
     1223         else do:
     1224           for first tt-minute no-lock
     1225             by tt-minute.minute
     1226           on error undo, return error return-value
     1227           :
     1228             assign
     1229               p-task-time = p-task-time + ( tt-minute.minute - v-task-minute ) * 60
     1230             .
     1231           end.
     1232           run next-task-hour ( input p-recid-sch
     1233                               ,input-output p-task-date
     1234                               ,input-output p-task-time
     1235                             ) no-error.
     1236           if error-status :error then do:
     1237             assign
     1238               p-task-date = ?
     1239               p-task-time = ?
     1240             .
     1241             return error.
     1242           end.
     1243         end.
     1244       end.
     1245       else do:
     1246         if truncate( p-task-time / 3600, 0 ) <> truncate( ( p-task-time + 60 ) / 3600, 0 ) then do:
     1247           run next-task-hour ( input p-recid-sch
     1248                               ,input-output p-task-date
     1249                               ,input-output p-task-time
     1250                             ) no-error.
     1251           if error-status :error then do:
     1252             assign
     1253               p-task-date = ?
     1254               p-task-time = ?
     1255             .
     1256             return error.
     1257           end.
     1258           assign
     1259             p-task-time = p-task-time + 60 - 3600
     1260           .
     1261         end.
     1262         else do:
     1263           assign
     1264             p-task-time = p-task-time + 60
     1265           .
     1266         end.
     1267       end.
     1268     end.
     1269   end procedure.
