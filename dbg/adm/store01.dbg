       42   define variable vss-revision    as character no-undo init "$Revision: 9b43ebeef021, 979, rls $":U .
       43   define variable vss-author      as character no-undo init "$Author: AAShepel $":U .
       44   define variable vss-date        as character no-undo init "$Date: Mon Jun 19 10:51:53 2017 +0300 $":U .
