       48   procedure vss-get-info :
       49     define output parameter p-vss-revision    like vss-revision    no-undo .
       50     define output parameter p-vss-author      like vss-author      no-undo .
       51     define output parameter p-vss-date        like vss-date        no-undo .
       52     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       53     define output parameter p-vss-archive     like vss-archive     no-undo .
       54     define output parameter p-vss-description like vss-description no-undo .
       55     assign
       56       p-vss-revision    = vss-revision
       57       p-vss-author      = vss-author
       58       p-vss-date        = vss-date
       59       p-vss-workfile    = vss-workfile
       60       p-vss-archive     = vss-archive
       61       p-vss-description = vss-description
       62     .
       63   end procedure.
