      402   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
      403     message
      404     vss-workfile vss-revision vss-description skip
      405     "Неверный параметр p-mode" p-mode
      406     view-as alert-box error .
      407     return error '':u.
      408   end.
      409   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      410   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      411     (output v-db-num
      412     )  .
      413   if v-db-num <> 0
      414   then do:
      415     run err-mess in this-procedure (substitute("Нельзя изменять запись СКЛАДА в УБД: Номер текущей БД &1 ", v-db-num ) ).
      416     undo, return error "":U.
      417   end.
      418   run chk-code in this-procedure (p-obj-code, p-mode) no-error .
      419   if error-status:error then do:
      420     undo, return error "obj-code":U.
      421   end.
      422   if p-obj-name = "":U then do:
      423     run err-mess in this-procedure (substitute("Введите название склада &1 ", p-obj-code ) ).
      424     undo, return error "obj-name":U.
      425   end.
      426   if not can-find( ub.db where
      427                      ub.db.db-num = p-db-num )
      428   then do:
      429     run err-mess in this-procedure (substitute("Неверный номер БД. Нет БД с номером &1 ", p-db-num ) ).
      430     undo, return error "db-num":U.
      431   end.
      432   find first buf_sysconf no-lock where
      433               buf_sysconf.host-code = p-host-code no-error .
      434   if not available buf_sysconf then do:
      435     run err-mess in this-procedure (substitute("Не найдена фирма с кодом &1 для склада &2", p-host-code, p-obj-code ) ).
      436     undo, return error "":U.
      437   end.
      438   if buf_sysconf.firm-db-num <> 0
      439   AND p-db-num <> buf_sysconf.firm-db-num
      440   then do:
      441     run err-mess in this-procedure (substitute("Главная БД фирмы &1 не совпадает с БД, к которой относится склад &2: главная БД фирмы - &3, а склад относится к БД &4", p-host-code, p-obj-code, buf_sysconf.firm-db-num, p-db-num ) ).
      442     undo, return error "db-num":U.
      443   end.
      444   if p-down-pay <> 0 then do:
      445     FIND first buf_pay-type no-lock where
      446               buf_pay-type.obj-code = p-down-pay NO-error .
      447     if not available buf_pay-type then do:
      448       run err-mess in this-procedure (substitute("Неверный код оплаты списания для склада &1: &2", p-obj-code, p-down-pay) ).
      449       undo, return error "down-pay":U.
      450     end.
      451   end.
      452   if p-in-pay <> 0 then do:
      453     FIND first buf_pay-type no-lock where
      454               buf_pay-type.obj-code = p-in-pay NO-error .
      455     if not available buf_pay-type then do:
      456       run err-mess in this-procedure (substitute("Неверный код оплаты прихода для склада &1: &2", p-obj-code, p-in-pay) ).
      457       undo, return error "in-pay":U.
      458     end.
      459   end.
      460   if p-inv-pay <> 0 then do:
      461     FIND first buf_pay-type no-lock where
      462               buf_pay-type.obj-code  = p-inv-pay NO-error .
      463     if not available buf_pay-type then do:
      464       run err-mess in this-procedure (substitute("Неверный код оплаты инвентаризации для склада &1: &2", p-obj-code, p-inv-pay) ).
      465       undo, return error "inv-pay":U.
      466     end.
      467   end.
      468   if p-out-pay <> 0 then do:
      469     FIND first buf_pay-type no-lock where
      470               buf_pay-type.obj-code = p-out-pay NO-error .
      471     if not available buf_pay-type then do:
      472       run err-mess in this-procedure (substitute("Неверный код оплаты расхода для склада &1: &2", p-obj-code, p-out-pay) ).
      473       undo, return error "out-pay":U.
      474     end.
      475   end.
      476   if p-ret-pay <> 0 then do:
      477     FIND first buf_pay-type no-lock where
      478               buf_pay-type.obj-code = p-ret-pay NO-error .
      479     if not available buf_pay-type then do:
      480       run err-mess in this-procedure (substitute("Неверный код оплаты возврата от покупателя для склада &1: &2", p-obj-code, p-ret-pay) ).
      481       undo, return error "ret-pay":U.
      482     end.
      483   end.
      484   if p-ret-sup-pay <> 0 then do:
      485     FIND first buf_pay-type no-lock where
      486               buf_pay-type.obj-code = p-ret-sup-pay NO-error .
      487     if not available buf_pay-type then do:
      488       run err-mess in this-procedure (substitute("Неверный код оплаты возврата поставщику для склада &1: &2", p-obj-code, p-ret-sup-pay) ).
      489       undo, return error "ret-sup-pay":U.
      490     end.
      491   end.
      492   if p-fbr-pay <> 0 then do:
      493     FIND first buf_pay-type no-lock where
      494               buf_pay-type.obj-code = p-fbr-pay NO-error .
      495     if not available buf_pay-type then do:
      496       run err-mess in this-procedure (substitute("Неверный код оплаты производства для склада &1: &2", p-obj-code, p-fbr-pay) ).
      497       undo, return error "fbr-pay":U.
      498     end.
      499   end.
      500   _MAIN:
      501   DO ON ERROR UNDO, RETURN ERROR
      502   ON STOP UNDO, RETURN ERROR:
      503     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      504       create ub.store.
      505       create ub.clients.
      506       assign
      507       ub.clients.obj-code = p-obj-code
      508       ub.clients.obj-type = 'скл':U
      509       ub.clients.db-num   = p-db-num
      510       ub.clients.grp-code = p-grp-code
      511       ub.clients.host-code = p-host-code
      512       ub.store.obj-code = p-obj-code
      513       ub.store.host-code   = p-host-code
      514       p-rec = recid(ub.clients)
      515       .
      516     end.
      517     else do:
      518       FIND FIRST ub.clients where
      519                 recid(ub.clients) = p-rec No-ERROR.
      520       if not available ub.clients then do:
      521         message
      522         vss-workfile vss-revision vss-description skip
      523         "Не найдена запись КЛИЕНТ для записи СКЛАДА - p-rec" p-rec
      524         view-as alert-box error .
      525         undo, return error '':u.
      526       end.
      527       find first ub.store where
      528                 ub.store.obj-code = p-obj-code no-error .
      529       if not available ub.store then do:
      530         message
      531         vss-workfile vss-revision vss-description skip
      532         "Не найдена запись СКЛАД с кодом" p-obj-code
      533         view-as alert-box error .
      534         undo, return error '':u.
      535       end.
      536       if ub.store.obj-code <> p-obj-code
      537       or ub.store.host-code <> p-host-code
      538       or ub.clients.db-num    <> p-db-num
      539       then do:
      540         message
      541         vss-workfile vss-revision vss-description skip
      542         "Для уже имеющегося СКЛАДА нельзя изменить номер склада, номер БД и код фирмы" skip
      543         view-as alert-box ERROR.
      544         undo, return error '':U.
      545       end.
      546     end.
      547     assign
      548     ub.clients.obj-name         =  p-obj-name
      549     ub.clients.PS               =  p-PS
      550     ub.store.active              =  p-active
      551     ub.store.addres1             =  p-addres1
      552     ub.store.addres2             =  p-addres2
      553     ub.store.doc-prt             =  p-doc-prt
      554     ub.store.down-pay            =  p-down-pay
      555     ub.store.fax                 =  p-fax
      556     ub.store.holidays            =  p-holidays
      557     ub.store.in-ov               =  p-in-ov
      558     ub.store.in-pay              =  p-in-pay
      559     ub.store.in-perm             =  p-in-perm
      560     ub.store.inout-price         =  p-inout-price
      561     ub.store.inv-pay             =  p-inv-pay
      562     ub.store.load-time           =  p-load-time
      563     ub.store.no-eq               =  p-no-eq
      564     ub.store.out-line-discnt     =  p-out-line-discnt
      565     ub.store.out-pay             =  p-out-pay
      566     ub.store.out-rate            =  p-out-rate
      567     ub.store.phone               =  p-phone
      568     ub.store.price-calc          =  p-price-calc
      569     ub.store.ret-pay             =  p-ret-pay
      570     ub.store.ret-sup-pay         =  p-ret-sup-pay
      571     ub.store.fbr-pay             =  p-fbr-pay
      572     ub.store.rsrv-time           =  p-rsrv-time
      573     ub.store.shift-on            =  p-shift-on
      574     ub.store.store-boss          =  p-store-boss
      575     ub.store.store-man           =  p-store-man
      576     ub.store.unit-cli-perm       =  p-unit-cli-perm
      577     ub.store.work-hours          =  p-work-hours
      578     ub.store.purch-code          =  p-purch-code
      579     p-rec = recid(ub.clients )
      580     .
      581    release ub.clients no-error.
      582    if error-status:error then do:
      583       run err-mess in this-procedure (substitute("Ошибка при сохранении записи КЛИЕНТ для склада &1:&2&3&2&4"
      584                             , p-obj-code
      585                             , chr(10)
      586                             , ERROR-STATUS:GET-message(1)
      587                             , return-value
      588                             )).
      589       undo, return error "":U.
      590    end.
      591    p-obj-code = ub.store.obj-code.
      592    release ub.store no-error.
      593    if error-status:error then do:
      594        run err-mess in this-procedure ( substitute("Ошибка при сохранении записи СКЛАД &1:&2&3&2&4"
      595                                , p-obj-code
      596                                , chr(10)
      597                                , ERROR-STATUS:GET-message(1)
      598                                , return-value
      599                                )).
      600       undo, return error "":U.
      601    end.
      602     run clntattr-value in this-procedure
      603       (input 'скл':U,
      604       input  p-obj-code,
      605       input  'pharm':U,
      606       output v-pharm,
      607       output par-type).
      608     if v-pharm = "yes":u then do:
      609        if p-pharm = no then do:
      610          run clntattr-delete in this-procedure
      611          (input 'скл':U,
      612           input  p-obj-code,
      613           input  'pharm':U,
      614           output v-delete).
      615        end.
      616     end.
      617     else do:
      618       if p-pharm = yes then do:
      619         run clntattr-write in this-procedure
      620          (input  'скл':U,
      621           input  p-obj-code,
      622           input  'pharm':U,
      623           input  "yes":u).
      624       end.
      625     end.
      626    run clntattr-value in this-procedure
      627         (input 'скл':U,
      628         input  p-obj-code,
      629         input  'kpp':U,
      630         output v-kpp,
      631         output par-type).
      632     if v-kpp <> "":u and v-kpp <> ? then do:
      633       if p-kpp = "" or p-kpp = ? then do:
      634         run clntattr-delete in this-procedure
      635          (input 'скл':U,
      636           input  p-obj-code,
      637           input  'kpp':U,
      638           output v-delete).
      639       end.
      640       else do:
      641         if p-kpp <> "" and p-kpp <> ? then do:
      642          run clntattr-write in this-procedure
      643          (input  'скл':U,
      644           input  p-obj-code,
      645           input  'kpp':U,
      646           input  p-kpp).
      647       end.
      648       end.
      649     end.
      650       else do:
      651       if p-kpp <> "" and p-kpp <> ? then do:
      652         run clntattr-write in this-procedure
      653          (input  'скл':U,
      654           input  p-obj-code,
      655           input  'kpp':U,
      656           input  p-kpp).
      657       end.
      658     end.
      659     run clntattr-value in this-procedure
      660       (input 'скл':U,
      661       input  p-obj-code,
      662       input  'envd':U,
      663       output v-envd,
      664       output par-type).
      665     if v-envd = "yes":u then do:
      666        if p-envd = no then do:
      667          run clntattr-delete in this-procedure
      668          (input 'скл':U,
      669           input  p-obj-code,
      670           input  'envd':U,
      671           output v-delete).
      672        end.
      673     end.
      674     else do:
      675       if p-envd = yes then do:
      676         run clntattr-write in this-procedure
      677          (input  'скл':U,
      678           input  p-obj-code,
      679           input  'envd':U,
      680           input  "yes":u).
      681       end.
      682     end.
      683   end.
      684   PROCEDURE chk-code :
      685   define input parameter p-obj-code like ub.store.obj-code no-undo .
      686   define input parameter p-mode     as character no-undo .
      687   define variable  conf-par as character no-undo.
      688   define variable  par-type as character no-undo.
      689   define variable  dopi as integer no-undo.
      690   if p-obj-code = 0 then do:
      691     run err-mess in this-procedure ("Код склада должен быть больше 0 " ).
      692     return error.
      693   end.
      694   if  p-mode = 'ДОБАВЛЕНИЕ':U
      695   and can-find( ub.store where ub.store.obj-code = p-obj-code ) then   do:
      696     run err-mess in this-procedure (substitute("Склад с кодом &1 уже есть, измените код", p-obj-code ) ).
      697     return error.
      698   end.
      699   return.
      700   END PROCEDURE.
      701   PROCEDURE err-mess:
      702     DEFINE INPUT PARAMETER p-mess as character No-UNDO.
      703     message
      704     p-mess
      705     view-as alert-box error .
      706   END PROCEDURE.
