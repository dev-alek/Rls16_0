        1   block-level on error undo, throw.
        2   define input parameter  pswd     as character no-undo .
        3   define output parameter enc-pswd as character no-undo .
        4   do
        5   on error undo, return error return-value
        6   :
        7     run pswd-enc-procedure in this-procedure
        8       (input  pswd
        9       ,output enc-pswd
       10       ) .
       11   end.
       12   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       13   procedure pswd-enc-procedure :
       14     define input parameter  pswd     as character no-undo .
       15     define output parameter enc-pswd as character no-undo .
       16     do
       17     on error undo, return error return-value
       18     :
       19       assign
       20         enc-pswd = encode(pswd + string(index(pswd, "k")))
       21       .
       22     end.
       23   end procedure.
