      615   procedure proc-alt-shift-f2:
      616     if not ibs.th.gbl.gbl-var:rcode
      617   then
      618     run gbl\inidebug.p .
      619   end.
      620   procedure proc-alt-shift-f3:
      621     run gbl/prvssinf.p
      622       ( input this-procedure
      623       ) .
      624   end.
      625   define variable v-inform-launched as logical no-undo initial false .
      626   procedure proc-alt-shift-f4:
      627     define variable v-action as character no-undo .
      628     if v-inform-launched = false then do:
      629       assign
      630         v-inform-launched = true
      631       .
      632       run gbl/d-inform.w
      633         (  input self
      634         ,  input this-procedure
      635         , output v-action
      636         ) no-error .
      637       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      638       assign
      639         v-inform-launched = false
      640       .
      641     end.
      642   end.
      643   procedure proc-alt-f1:
      644     run gbl/corrhelp.p
      645       (input this-procedure
      646       ) .
      647   end .
      648   on alt-shift-f2 anywhere do:
      649     run proc-alt-shift-f2.
      650   end.
      651   on alt-shift-f3 anywhere do:
      652     run proc-alt-shift-f3 in this-procedure .
      653   end.
      654   on alt-shift-f4 anywhere do:
      655     run proc-alt-shift-f4 in this-procedure.
      656   end.
      657   on alt-f1 anywhere do:
      658     run proc-alt-f1 in this-procedure .
      659   end.
      660   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      661     define variable v-cntxt-db-num        as integer   no-undo .
      662     define variable v-cntxt-userid        as character no-undo .
      663     define variable v-cntxt-level         as character no-undo .
      664     define variable v-cntxt-host-code-obj as integer   no-undo .
      665     define variable v-cntxt-obj-type      as character no-undo .
      666     define variable v-cntxt-obj-code      as integer   no-undo .
      667     define variable v-cntxt-db-num-obj    as integer   no-undo .
      668     define variable v-cntxt-is-admin      as logical   no-undo .
      669   DEFINE VARIABLE v-db-num LIKE ub.db.db-num NO-UNDO.
      670   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO.
      671   DEFINE VARIABLE v-to-create AS logical NO-UNDO.
      672   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      673   define variable v-tth as handle no-undo .
      674   assign
      675   v-tth = buffer thbjattr_thbj-attr:table-handle .
      676   DEFINE BUTTON B-exit AUTO-GO
      677        LABEL "&Ввод"
      678        SIZE 10 BY 1
      679        BGCOLOR 8 .
      680   DEFINE BUTTON B-Help
      681        LABEL "Помо&щь"
      682        SIZE 3 BY 1
      683        BGCOLOR 8 .
      684   DEFINE BUTTON b-quit AUTO-END-KEY
      685        LABEL "&Отмена"
      686        SIZE 10 BY 1
      687        BGCOLOR 8 .
      688   DEFINE VARIABLE CB-dflt-cd AS CHARACTER FORMAT "X(20)"
      689        LABEL "Тип касс, используемых на объекте ПО УМОЛЧАНИЮ"
      690        VIEW-AS COMBO-BOX INNER-LINES 15
      691        LIST-ITEMS "1","2","3","4","5","6","7"
      692        DROP-DOWN-LIST
      693        SIZE 15 BY .93
      694        BGCOLOR 15 FGCOLOR 0 .
      695   DEFINE VARIABLE f-cdpcknum AS INTEGER FORMAT ">,>>>,>>9":U INITIAL 200
      696        LABEL "Кол-во записей в пакете для пересылки на кассы"
      697        VIEW-AS FILL-IN
      698        SIZE 14 BY 1 NO-UNDO.
      699   DEFINE VARIABLE t-alllstcs AS LOGICAL INITIAL no
      700        LABEL "Пересылка товаров на кассу только полным списком"
      701        VIEW-AS TOGGLE-BOX
      702        SIZE 77.5 BY 1 NO-UNDO.
      703   DEFINE VARIABLE t-noautocs AS LOGICAL INITIAL no
      704        LABEL "Отключена автоматическая передача товаров на кассы"
      705        VIEW-AS TOGGLE-BOX
      706        SIZE 83 BY 1 NO-UNDO.
      707   DEFINE VARIABLE t-process-sale AS LOGICAL INITIAL no
      708        LABEL "Докачка чеков в продажу и резервирование после чтения чеков или завершения чека в IBS TH POS"
      709        VIEW-AS TOGGLE-BOX
      710        SIZE 96.5 BY 1 NO-UNDO.
      711   DEFINE VARIABLE f-mask_s-c AS CHARACTER FORMAT "X(100)"
      712        LABEL "Маски коротких кодов"
      713        VIEW-AS FILL-IN
      714        SIZE 41 BY 1 TOOLTIP "В маске цифрами указывается префикс, который отрезается при передаче кодов на кассы , а звездочками количество символов короткого кода . Пример ввода 777***" NO-UNDO.
      715   DEFINE FRAME Dialog-Frame
      716        B-exit AT ROW 1 COL 1
      717        b-quit AT ROW 1 COL 11
      718        B-Help AT ROW 1 COL 95
      719        t-alllstcs AT ROW 2.77 COL 2
      720        t-noautocs AT ROW 3.77 COL 2
      721        f-cdpcknum AT ROW 4.77 COL 48 COLON-ALIGNED
      722        CB-dflt-cd AT ROW 6 COL 48 COLON-ALIGNED
      723        t-process-sale AT ROW 7.4 COL 2 WIDGET-ID 2
      724        f-mask_s-c AT ROW 8.65 COL 23 COLON-ALIGNED
      725        SPACE(0.79) SKIP(1.09)
      726       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      727            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      728            TITLE "Общие опции коммуникации с кассами"
      729            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      730   ASSIGN
      731          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      732          FRAME Dialog-Frame:HIDDEN           = TRUE.
      733   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      734   DO:
      735     APPLY "END-ERROR":U TO SELF.
      736   END.
      737   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      738   DO:
      739     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      740     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      741   END.
      742   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      743   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      744   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      745   on help of frame Dialog-Frame
      746   do:
      747     run gbl/app_help.p
      748       (input this-procedure :file-name
      749       ,input ''
      750       ,input ?
      751       ) no-error.
      752     if error-status :error then do:
      753       message
      754         "Ошибка при вызове помощи"
      755         error-status :get-message(1)
      756         view-as alert-box .
      757     end.
      758   end.
      759   run minbtn-set in this-procedure .
      760   on choose of b-help in frame Dialog-Frame
      761   do:
      762     apply "help":u to frame Dialog-Frame .
      763   end.
      764   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      765   procedure minbtn-set :
      766       do
      767           on error undo, return error return-value
      768           :
      769           define variable ii              as integer       no-undo .
      770           define variable fh              as widget-handle no-undo .
      771           define variable hh              as widget-handle no-undo .
      772           define variable v-h             as handle        extent 4 no-undo .
      773           define variable v-name-button   as character     no-undo .
      774           define variable v-help-old-x    as decimal       no-undo .
      775           define variable v-help-old-y    as decimal       no-undo .
      776           define variable v-help-old-size as decimal       no-undo .
      777           define variable v-frame-width   as decimal       no-undo .
      778           define variable jj              as integer       no-undo .
      779           do
      780               on error undo, return error
      781               :
      782               assign
      783                   v-frame-width = frame Dialog-Frame:width - 0.3
      784                   fh            = frame Dialog-Frame:first-child
      785                   hh            = fh:first-child
      786                   ii            = 1
      787                   .
      788               do while valid-handle(hh):
      789                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      790                   do:
      791                       case lc(hh:name) :
      792                           when "b-help" then
      793                               do:
      794                                   hh:load-image-up("cmp/b-help.bmp":u) .
      795                                   hh:load-image-down("cmp/b-help.bmp":u) .
      796                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      797                                   hh:TOOLTIP = "Помощь" .
      798                                   v-help-old-x = hh:column .
      799                                   v-help-old-y = hh:row    .
      800                                   v-help-old-size = hh:width .
      801                                   hh:width-chars = 2.5 .
      802                               end.
      803                           when "b-print" then
      804                               do:
      805                                   hh:load-image("cmp/b-print.bmp":u) .
      806                                   hh:TOOLTIP = "Печать" .
      807                                   v-h[ii] = hh:handle .
      808                                   ii = ii + 1 .
      809                                   hh:width-chars = 3 .
      810                               end.
      811                           when "b-history" or
      812                           when "b-hist" then
      813                               do:
      814                                   hh:load-image("cmp/b-hist.bmp":u) .
      815                                   hh:TOOLTIP = "История" .
      816                                   v-h[ii] = hh:handle .
      817                                   ii = ii + 1 .
      818                                   hh:width-chars = 3 .
      819                               end.
      820                           when "b-sch" then
      821                               do:
      822                                   hh:load-image("cmp/b-sch.bmp":u) .
      823                                   hh:TOOLTIP = "Установка Фильтра" .
      824                                   v-h[ii] = hh:handle .
      825                                   ii = ii + 1 .
      826                                   hh:width-chars = 3 .
      827                               end.
      828                           when "b-hist-user" then
      829                               do:
      830                                   hh:load-image("cmp/b-hist.bmp":u) .
      831                                   hh:TOOLTIP = "История пользователя" .
      832                                   ii = ii + 1 .
      833                               end.
      834                       end case.
      835                   end.
      836                   hh = hh:next-sibling.
      837               end.
      838               b-help:column = v-frame-width - b-help:width-chars.
      839               jj = 0.
      840               repeat ii = 4 to 1 by -1 :
      841                   if valid-handle (v-h[ii] ) then
      842                   do:
      843                       jj  = jj + 1 .
      844                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      845                       v-h[ii]:row    = v-help-old-y .
      846                   end.
      847               end.
      848           end.
      849       end.
      850   end procedure.
      851   MAIN-BLOCK:
      852   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      853      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      854   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      855     run mainmenu_getcntxt in parparentproc
      856       (output v-cntxt-db-num
      857       ,output v-cntxt-userid
      858       ,output v-cntxt-level
      859       ,output v-cntxt-host-code-obj
      860       ,output v-cntxt-obj-type
      861       ,output v-cntxt-obj-code
      862       ,output v-cntxt-db-num-obj
      863       ,output v-cntxt-is-admin
      864       ) .
      865   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      866   ON TAB ANYWHERE
      867   DO:
      868   define variable ii as integer no-undo .
      869   define variable fh as widget-handle no-undo .
      870   define variable hh as widget-handle no-undo .
      871   define variable v-next-widget-name as character no-undo .
      872   if v-tab-order <> '' then do:
      873     if self:type = "TOGGLE-BOX" then
      874     self:BGCOLOR = ?.
      875     assign
      876     ii = lookup(self:name, v-tab-order).
      877     assign
      878     ii = ii + 1
      879     v-next-widget-name = entry(ii, v-tab-order)
      880     no-error .
      881     if error-status:error then do:
      882       assign
      883       ii = 1
      884       v-next-widget-name = entry( ii, v-tab-order)
      885       .
      886     end.
      887     assign
      888     fh = frame Dialog-Frame:first-child
      889     hh = fh:first-child
      890     .
      891     do while valid-handle(hh):
      892       if hh:name = v-next-widget-name then do:
      893         if hh:sensitive  = yes
      894         AND hh:visible = yes then do:
      895           if hh:type = "TOGGLE-BOX":U then do:
      896             assign
      897             hh:BGcolor = 1
      898             .
      899           end.
      900           APPLY "ENTRY" to hh.
      901           return no-apply.
      902         end.
      903         else do:
      904           APPLY "TAB" to hh.
      905           return no-apply.
      906         end.
      907       end.
      908       hh = hh:next-sibling.
      909     end.
      910   end.
      911   END.
      912   ON BACK-TAB ANYWHERE
      913   DO:
      914   define variable ii as integer no-undo .
      915   define variable fh as widget-handle no-undo .
      916   define variable hh as widget-handle no-undo .
      917   define variable v-next-widget-name as character no-undo .
      918   if v-tab-order <> '' then do:
      919     assign
      920     ii = lookup(self:name, v-tab-order).
      921     .
      922     assign
      923     ii = (if ii = 1
      924           then  num-entries(v-tab-order)
      925           else ii - 1
      926           )
      927     v-next-widget-name = entry(ii, v-tab-order)
      928     .
      929     assign
      930     fh = frame Dialog-Frame:first-child
      931     hh = fh:first-child
      932     .
      933     do while valid-handle(hh):
      934       if hh:name = v-next-widget-name then do:
      935         if hh:sensitive  = yes
      936         AND hh:visible = yes then do:
      937           if hh:type = "TOGGLE-BOX":U then do:
      938             assign
      939             hh:BGcolor = 1
      940             .
      941           end.
      942           APPLY "ENTRY" to hh.
      943           return no-apply.
      944         end.
      945         else do:
      946         APPLY "BACK-TAB" to hh.
      947         return no-apply.
      948         end.
      949       end.
      950       hh = hh:next-sibling.
      951     end.
      952     end.
      953   END.
      954   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      955   ON RETURN ANYWHERE
      956   DO:
      957   define variable ii as integer no-undo .
      958   define variable fh as widget-handle no-undo .
      959   define variable hh as widget-handle no-undo .
      960   define variable v-next-widget-name as character no-undo .
      961     if v-tab-order <> '' then do:
      962       assign
      963       ii = lookup(self:name, v-tab-order).
      964       if ii = num-entries(v-tab-order) then do:
      965           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
      966           return no-apply.
      967       end.
      968       if self:type <> "BUTTON" and
      969         self:type <> "EDITOR"  then do:
      970         run proc-move-forward in this-procedure .
      971         return no-apply.
      972       end.
      973       if self:type = "BUTTON" then do:
      974         APPLY "CHOOSE" to self.
      975       end.
      976       if self:type = "TOGGLE-BOX" then
      977       self:BGCOLOR = ?.
      978       assign
      979       ii = ii + 1
      980       v-next-widget-name = entry(ii, v-tab-order)
      981       no-error .
      982       if error-status:error then do:
      983         assign
      984         ii = 1
      985         v-next-widget-name = entry( ii, v-tab-order)
      986         .
      987       end.
      988       assign
      989       fh = frame Dialog-Frame:first-child
      990       hh = fh:first-child
      991       .
      992       do while valid-handle(hh):
      993         if hh:name = v-next-widget-name then do:
      994           if hh:sensitive  = yes
      995           AND hh:visible = yes then do:
      996             if hh:type = "TOGGLE-BOX":U then do:
      997               assign
      998               hh:BGcolor = 1
      999               .
     1000             end.
     1001             APPLY "ENTRY" to hh.
     1002             return no-apply.
     1003           end.
     1004           else do:
     1005             APPLY "TAB" to hh.
     1006             return no-apply.
     1007           end.
     1008         end.
     1009         hh = hh:next-sibling.
     1010       end.
     1011     end.
     1012   END.
     1013   procedure proc-move-forward :
     1014   define variable ii as integer no-undo .
     1015   define variable fh as widget-handle no-undo .
     1016   define variable hh as widget-handle no-undo .
     1017   define variable v-next-widget-name as character no-undo .
     1018   do
     1019   on error undo, return error
     1020   :
     1021     if v-tab-order <> '' then do:
     1022       if self:type = "TOGGLE-BOX" then
     1023       self:BGCOLOR = ?.
     1024       assign
     1025       ii = lookup(self:name, v-tab-order).
     1026       assign
     1027       ii = ii + 1
     1028       v-next-widget-name = entry(ii, v-tab-order)
     1029       no-error .
     1030       if error-status:error then do:
     1031         assign
     1032         ii = 1
     1033         v-next-widget-name = entry( ii, v-tab-order)
     1034         .
     1035       end.
     1036       assign
     1037       fh = frame Dialog-Frame:first-child
     1038       hh = fh:first-child
     1039       .
     1040       do while valid-handle(hh):
     1041         if hh:name = v-next-widget-name then do:
     1042           if hh:sensitive  = yes
     1043           AND hh:visible = yes then do:
     1044             if hh:type = "TOGGLE-BOX":U then do:
     1045               assign
     1046               hh:BGcolor = 1
     1047               .
     1048             end.
     1049             APPLY "ENTRY" to hh.
     1050             return.
     1051           end.
     1052           else do:
     1053             assign
     1054             ii = ii + 1
     1055             v-next-widget-name = entry(ii, v-tab-order)
     1056             no-error .
     1057             if error-status:error then do:
     1058               assign
     1059               ii = 1
     1060               v-next-widget-name = entry( ii, v-tab-order)
     1061               .
     1062             end.
     1063           end.
     1064         end.
     1065         hh = hh:next-sibling.
     1066       end.
     1067     end.
     1068   end.
     1069   end procedure.
     1070     IF p-mode <> 'ПРОСМОТР':U
     1071     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     1072         MESSAGE
     1073         vss-workfile vss-revision vss-description skip
     1074         "Неверное значение параметра p-mode" p-mode
     1075         VIEW-AS ALERT-BOX ERROR.
     1076         UNDO, RETURN ERROR.
     1077     END.
     1078     IF p-obj-type <> 'маг':U
     1079     and p-obj-type <> 'орг':U
     1080     and p-obj-type <> '':U
     1081     THEN DO:
     1082         MESSAGE
     1083         vss-workfile vss-revision vss-description skip
     1084         "Неверное значение параметра p-obj-type" p-obj-type
     1085         VIEW-AS ALERT-BOX ERROR.
     1086         UNDO, RETURN ERROR.
     1087     END.
     1088     if p-obj-type = 'маг':U then do:
     1089       FIND FIRST X_shop NO-LOCK WHERE X_shop.obj-code = p-obj-code NO-ERROR.
     1090       IF NOT AVAILABLE X_shop THEN DO:
     1091           MESSAGE
     1092           vss-workfile vss-revision vss-description skip
     1093           "Неверное значение параметра p-obj-code" p-obj-code
     1094           VIEW-AS ALERT-BOX ERROR.
     1095           UNDO, RETURN ERROR.
     1096       END.
     1097   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1098   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1099     (input  'маг':U
     1100     ,input  p-obj-code
     1101     ,output v-db-num
     1102     )  .
     1103       IF v-db-num <> v-cntxt-db-num
     1104       AND v-cntxt-db-num <> 0
     1105       and p-mode <> 'ПРОСМОТР':U
     1106       THEN DO:
     1107           MESSAGE
     1108           "Нельзя менять параметры магазина в чужой БД" skip
     1109           "магазин принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     1110           VIEW-AS ALERT-BOX ERROR.
     1111           UNDO, RETURN ERROR.
     1112       END.
     1113     end.
     1114     if p-obj-type = 'орг':U then do:
     1115       FIND FIRST X_sysconf NO-LOCK WHERE X_sysconf.host-code = p-obj-code NO-ERROR.
     1116       IF NOT AVAILABLE X_sysconf THEN DO:
     1117           MESSAGE
     1118           vss-workfile vss-revision vss-description skip
     1119           "Неверное значение параметра p-obj-code" p-obj-code
     1120           VIEW-AS ALERT-BOX ERROR.
     1121           UNDO, RETURN ERROR.
     1122       END.
     1123       if v-cntxt-db-num <> 0
     1124       and p-mode <> 'ПРОСМОТР':U
     1125       then do:
     1126           MESSAGE
     1127           "Нельзя менять параметры ФИРМЫ в УБД" skip
     1128           VIEW-AS ALERT-BOX ERROR.
     1129           UNDO, RETURN ERROR.
     1130       end.
     1131     end.
     1132     if p-obj-type = '':U then do:
     1133       if v-cntxt-db-num <> 0
     1134       and p-mode <> 'ПРОСМОТР':U
     1135       then do:
     1136           MESSAGE
     1137           "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" skip
     1138           VIEW-AS ALERT-BOX ERROR.
     1139           UNDO, RETURN ERROR.
     1140       end.
     1141     end.
     1142     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     1143       FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
     1144                 LOCKED_thbj-attr.obj-type = p-obj-type
     1145           AND   LOCKED_thbj-attr.obj-code = p-obj-code
     1146           AND   LOCKED_thbj-attr.upper-prop-code = 'cd-sending':U
     1147           AND   locked_thbj-attr.prop-code = '':U NO-WAIT NO-ERROR.
     1148        if locked locked_thbj-attr then do:
     1149           message
     1150           vss-workfile vss-revision vss-description skip
     1151            "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
     1152           view-as alert-box error .
     1153           undo, return error.
     1154         end.
     1155     END.
     1156     ELSE DO:
     1157         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
     1158             LOCKED_thbj-attr.obj-type = p-obj-type
     1159       AND   LOCKED_thbj-attr.obj-code = p-obj-code
     1160       AND   LOCKED_thbj-attr.upper-prop-code = 'cd-sending':U
     1161       and   locked_thbj-attr.prop-code = '':U
     1162       NO-ERROR.
     1163     END.
     1164     if not available locked_thbj-attr then do:
     1165       ASSIGN
     1166       v-to-create  = YES.
     1167       message
     1168       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     1169                   chr(10))
     1170       view-as alert-box WARNING.
     1171     end.
     1172     RUN FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     1173     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     1174     RUN Myenable.
     1175     WAIT-FOR GO OF FRAME Dialog-Frame.
     1176   END.
     1177   RUN disable_UI.
     1178   PROCEDURE disable_UI :
     1179     HIDE FRAME Dialog-Frame.
     1180   END PROCEDURE.
     1181   PROCEDURE enable_UI :
     1182     DISPLAY t-alllstcs t-noautocs f-cdpcknum CB-dflt-cd t-process-sale f-mask_s-c
     1183         WITH FRAME Dialog-Frame.
     1184     ENABLE B-exit b-quit B-Help t-alllstcs t-noautocs f-cdpcknum CB-dflt-cd f-mask_s-c
     1185            t-process-sale
     1186         WITH FRAME Dialog-Frame.
     1187     VIEW FRAME Dialog-Frame.
     1188   END PROCEDURE.
     1189   PROCEDURE fill-widgets :
     1190   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     1191   DEFINE VARIABLE v-entry AS CHARACTER NO-UNDO.
     1192   define variable v-param-type as character no-undo .
     1193   define variable v-param-value as character no-undo .
     1194   define variable v-value-character as character no-undo .
     1195   define variable v-value-date as date no-undo .
     1196   define variable v-value-decimal as decimal no-undo .
     1197   define variable v-value-integer as INTEGER no-undo .
     1198   define variable v-value-logical AS LOGICAL no-undo .
     1199   FOR EACH thbjattr_thbj-attr:
     1200     delete thbjattr_thbj-attr.
     1201   end.
     1202   FOR EACH temp-thbj-attr:
     1203     delete temp-thbj-attr.
     1204   end.
     1205   run adm/shattri.p (
     1206                 input "init":U
     1207               , input p-obj-type
     1208               , input p-obj-code
     1209               , input 'cd-sending':U
     1210               , input "":U
     1211               , output v-value-character
     1212               , output v-value-date
     1213               , output v-value-decimal
     1214               , output v-value-integer
     1215               , output v-value-logical
     1216               , output v-param-type
     1217               , INPUT-OUTPUT TABLE-handle v-tth
     1218               ) no-error .
     1219   if error-status:error
     1220   and not available locked_thbj-attr then do:
     1221     message
     1222     "Не удалось получить начальные значения настроек" skip
     1223     error-status:get-message(1) return-value
     1224     view-as alert-box error .
     1225     undo, return error .
     1226   end.
     1227   FOR EACH thbjattr_thbj-attr:
     1228     ASSIGN
     1229     v-entry = thbjattr_thbj-attr.prop-code.
     1230     IF v-entry = 'alllstcs':U THEN DO:
     1231       ASSIGN
     1232       t-alllstcs = thbjattr_thbj-attr.property-value-logical
     1233       t-alllstcs:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1234       .
     1235     END.
     1236     IF v-entry = 'noautocs':U THEN DO:
     1237       ASSIGN
     1238       t-noautocs = thbjattr_thbj-attr.property-value-logical
     1239       t-noautocs:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1240       .
     1241     END.
     1242     IF v-entry = 'cdpcknum':U THEN DO:
     1243       ASSIGN
     1244       f-cdpcknum = thbjattr_thbj-attr.property-value-integer
     1245       f-cdpcknum:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1246       .
     1247     END.
     1248     IF v-entry = 'dflt-cd':U THEN DO:
     1249       ASSIGN
     1250       cb-dflt-cd:SCREEN-VALUE IN FRAME Dialog-Frame  = thbjattr_thbj-attr.property-value-character
     1251       cb-dflt-cd:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1252       .
     1253     END.
     1254     IF v-entry = 'process-sale':U THEN DO:
     1255       ASSIGN
     1256       t-process-sale = thbjattr_thbj-attr.property-value-logical
     1257       t-process-sale:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1258       .
     1259     END.
     1260     IF v-entry = 'mask_s-c':U THEN DO:
     1261       ASSIGN
     1262       f-mask_s-c = thbjattr_thbj-attr.property-value-character
     1263       f-mask_s-c:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1264       .
     1265     END.
     1266     create temp-thbj-attr.
     1267     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     1268   END.
     1269   END PROCEDURE.
     1270   PROCEDURE MyEnable :
     1271   ASSIGN
     1272   FRAME Dialog-Frame:TITLE = FRAME Dialog-Frame:TITLE + (if p-obj-type = 'орг':U then " фирма" else " маг") + STRING(p-obj-code)
     1273   v-tab-order = "t-alllstcs,t-noautocs,f-cdpcknum,cb-dflt-cd,t-process-sale,f-mask_s-c".
     1274   ASSIGN
     1275   cb-dflt-cd:LIST-ITEMS IN FRAME Dialog-Frame = chr(44) + 'IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA':U.
     1276   DISPLAY
     1277   t-alllstcs
     1278   t-noautocs
     1279   f-cdpcknum
     1280   cb-dflt-cd
     1281   f-mask_s-c
     1282   t-process-sale
     1283   WITH FRAME Dialog-Frame.
     1284   ENABLE
     1285   B-exit WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1286   b-quit
     1287   B-Help
     1288   t-alllstcs WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1289   t-noautocs WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1290   f-cdpcknum WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1291   cb-dflt-cd WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1292   f-mask_s-c WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1293   t-process-sale WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1294   WITH FRAME Dialog-Frame.
     1295   VIEW FRAME Dialog-Frame.
     1296   IF p-mode = 'ПРОСМОТР':U THEN DO:
     1297       HIDE
     1298       b-exit
     1299       IN FRAME Dialog-Frame.
     1300       ASSIGN
     1301       b-quit:LABEL = "&Выход"
     1302       .
     1303   END.
     1304   END PROCEDURE.
     1305   PROCEDURE proc-save :
     1306   define variable v-value-character as character no-undo .
     1307   define variable v-value-date as date no-undo .
     1308   define variable v-value-decimal as decimal no-undo .
     1309   define variable v-value-integer as INTEGER no-undo .
     1310   define variable v-value-logical AS LOGICAL no-undo .
     1311   define variable v-param-type as character no-undo .
     1312   define variable wh as widget-handle no-undo .
     1313   define variable fh as widget-handle no-undo .
     1314   define variable v-same as logical no-undo .
     1315   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     1316   ASSIGN
     1317   FRAME Dialog-Frame
     1318   t-alllstcs
     1319   t-noautocs
     1320   f-cdpcknum
     1321   cb-dflt-cd
     1322   f-mask_s-c
     1323   .
     1324   assign
     1325   fh = frame Dialog-Frame:first-child
     1326   wh = fh:first-child
     1327   .
     1328   do while valid-handle(wh):
     1329     if wh:private-data begins "recid=" then do:
     1330       find first thbjattr_thbj-attr where
     1331                 recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     1332       assign
     1333       buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     1334     end.
     1335     wh = wh:next-sibling.
     1336   end.
     1337   v-same = yes.
     1338   for each thbjattr_thbj-attr,
     1339       first temp-thbj-attr where
     1340             temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     1341         and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     1342         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     1343         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code:
     1344      buffer-compare
     1345      thbjattr_thbj-attr
     1346      to temp-thbj-attr
     1347      save result in v-same.
     1348      if v-same = no then leave.
     1349   end.
     1350   v-same = no.
     1351   IF v-same  and not v-to-create THEN RETURN.
     1352   run adm/shattri.p (
     1353                  input "check":U
     1354                , input p-obj-type
     1355                , input p-obj-code
     1356                , input 'cd-sending':U
     1357                , input '':U
     1358                , output v-value-character
     1359                , output v-value-date
     1360                , output v-value-decimal
     1361                , output v-value-integer
     1362                , output v-value-logical
     1363                , output v-param-type
     1364                , input-output TABLE-handle v-tth
     1365               ) no-error .
     1366   if error-status:error then do:
     1367     message
     1368     "Некорректное значение ПАРАМЕТРОВ" skip
     1369     error-status:get-message(1) skip
     1370     return-value
     1371     view-as alert-box error .
     1372     undo, return error .
     1373   end.
     1374   RUN thbjattr_set-section IN THIS-PROCEDURE (
     1375        input p-obj-type
     1376       ,input p-obj-code
     1377       ,input 'cd-sending':U
     1378       ,input table thbjattr_thbj-attr
     1379   ) NO-ERROR.
     1380   IF ERROR-STATUS:error THEN do:
     1381     MESSAGE ERROR-STATUS:get-message(1)  SKIP
     1382     RETURN-VALUE
     1383     VIEW-AS ALERT-BOX.
     1384     UNDO, RETURN ERROR.
     1385   END.
     1386   END PROCEDURE.
