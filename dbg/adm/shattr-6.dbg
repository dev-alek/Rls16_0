      368   procedure thbjattr_code_reg :
      369   define input  parameter p-upper-code     as character no-undo .
      370   define input  parameter p-code           as character no-undo .
      371   define output parameter p-label          as character no-undo .
      372   define output parameter p-user-can-edit  as logical   no-undo .
      373   define output parameter p-output-display as logical   no-undo .
      374   define output parameter p-other          as character no-undo .
      375   define output parameter p-prop-list      as character no-undo .
      376   define output parameter p-prop-type-list as character no-undo .
      377   define output parameter p-prop-label-list as character no-undo .
      378   define output parameter p-global          as logical no-undo .
      379   define output parameter p-host           as logical no-undo .
      380   define output parameter p-shop           as logical no-undo .
      381   define output parameter p-store          as logical no-undo .
      382   define output parameter p-db             as logical no-undo .
      383   define output parameter p-region         as logical no-undo .
      384   do
      385   on error undo, return error return-value
      386   :
      387       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      388       (input  p-upper-code
      389       ,input  p-code
      390       ,output p-label
      391       ,output p-user-can-edit
      392       ,output p-output-display
      393       ,output p-other
      394       ,output p-prop-list
      395       ,output p-prop-type-list
      396       ,output p-prop-label-list
      397       ,output p-global
      398       ,output p-host
      399       ,output p-shop
      400       ,output p-store
      401       ,output p-db
      402       ,output p-region
      403       ) no-error .
      404     if error-status :error
      405     then do:
      406       undo, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message (1)).
      407     end.
      408   end.
      409   end procedure.
