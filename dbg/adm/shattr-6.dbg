      620   procedure proc-alt-shift-f2:
      621     if not ibs.th.gbl.gbl-var:rcode
      622   then
      623     run gbl\inidebug.p .
      624   end.
      625   procedure proc-alt-shift-f3:
      626     run gbl/prvssinf.p
      627       ( input this-procedure
      628       ) .
      629   end.
      630   define variable v-inform-launched as logical no-undo initial false .
      631   procedure proc-alt-shift-f4:
      632     define variable v-action as character no-undo .
      633     if v-inform-launched = false then do:
      634       assign
      635         v-inform-launched = true
      636       .
      637       run gbl/d-inform.w
      638         (  input self
      639         ,  input this-procedure
      640         , output v-action
      641         ) no-error .
      642       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      643       assign
      644         v-inform-launched = false
      645       .
      646     end.
      647   end.
      648   procedure proc-alt-f1:
      649     run gbl/corrhelp.p
      650       (input this-procedure
      651       ) .
      652   end .
      653   on alt-shift-f2 anywhere do:
      654     run proc-alt-shift-f2.
      655   end.
      656   on alt-shift-f3 anywhere do:
      657     run proc-alt-shift-f3 in this-procedure .
      658   end.
      659   on alt-shift-f4 anywhere do:
      660     run proc-alt-shift-f4 in this-procedure.
      661   end.
      662   on alt-f1 anywhere do:
      663     run proc-alt-f1 in this-procedure .
      664   end.
      665   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      666     define variable v-cntxt-db-num        as integer   no-undo .
      667     define variable v-cntxt-userid        as character no-undo .
      668     define variable v-cntxt-level         as character no-undo .
      669     define variable v-cntxt-host-code-obj as integer   no-undo .
      670     define variable v-cntxt-obj-type      as character no-undo .
      671     define variable v-cntxt-obj-code      as integer   no-undo .
      672     define variable v-cntxt-db-num-obj    as integer   no-undo .
      673     define variable v-cntxt-is-admin      as logical   no-undo .
      674   DEFINE VARIABLE v-db-num LIKE ub.db.db-num NO-UNDO.
      675   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO.
      676   DEFINE VARIABLE v-to-create AS logical NO-UNDO.
      677   DEFINE VARIABLE v-num-list AS CHARACTER NO-UNDO.
      678   define variable v-noauto-scls as logical no-undo.
      679   define variable v-obj-db-num like ub.db.db-num no-undo .
      680   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      681   define variable v-tth as handle no-undo .
      682   assign
      683   v-tth = buffer thbjattr_thbj-attr:table-handle .
      684   FUNCTION mark-string RETURNS CHARACTER
      685     ( input p-scales-num as integer, input p-list as character )  FORWARD.
      686   DEFINE BUTTON B-add
      687        LABEL "&Добавить"
      688        SIZE 10 BY 1.
      689   DEFINE BUTTON B-del
      690        LABEL "&Удалить"
      691        SIZE 10 BY 1.
      692   DEFINE BUTTON B-etc
      693        LABEL "Дополнительно"
      694        SIZE 14.5 BY 1.
      695   DEFINE BUTTON B-exit AUTO-GO
      696        LABEL "&Ввод"
      697        SIZE 10 BY 1
      698        BGCOLOR 8 .
      699   DEFINE BUTTON B-Help
      700        LABEL "Помо&щь"
      701        SIZE 3 BY 1
      702        BGCOLOR 8 .
      703   DEFINE BUTTON B-mark
      704        LABEL "&*"
      705        SIZE 10 BY 1.
      706   DEFINE BUTTON b-quit AUTO-END-KEY
      707        LABEL "&Отмена"
      708        SIZE 10 BY 1
      709        BGCOLOR 8 .
      710   DEFINE VARIABLE EDITOR-1 AS CHARACTER INITIAL "Установка сроков годности при приходе и переоценке"
      711        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      712        SIZE 30.5 BY 2 NO-UNDO.
      713   DEFINE VARIABLE l-scallist AS CHARACTER FORMAT "X(256)":U INITIAL "Количество весов, используемых на объекте"
      714         VIEW-AS TEXT
      715        SIZE 41 BY .67 NO-UNDO.
      716   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
      717         VIEW-AS TEXT
      718        SIZE 6 BY 1
      719        FGCOLOR 4  NO-UNDO.
      720   DEFINE VARIABLE RS-sclin-ld AS INTEGER
      721        VIEW-AS RADIO-SET VERTICAL
      722        RADIO-BUTTONS
      723             "Из карточки товара", 0,
      724   "Min из партий посл.прихода", 1,
      725   "Max из партий посл.прихода", 2
      726        SIZE 29.5 BY 3 NO-UNDO.
      727   DEFINE QUERY BR-scales FOR
      728         X_scales SCROLLING.
      729   DEFINE QUERY BR-scales-type FOR
      730         tt-scales-type SCROLLING.
      731   DEFINE BROWSE BR-scales
      732     QUERY BR-scales NO-LOCK DISPLAY
      733         mark-string(X_scales.scales-num, v-num-list) COLUMN-LABEL "*" FORMAT "X(1)":U
      734         X_scales.db-num FORMAT ">>>>9":U
      735         X_scales.scales-num FORMAT ">>9":U
      736         X_scales.scales-name FORMAT "X(40)":U
      737         X_scales.scales-type FORMAT "X(12)":U
      738         X_scales.master FORMAT ">>9":U WIDTH 8
      739       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.5 BY 7.5
      740            TITLE "Весы, используемые на объекте" ROW-HEIGHT-CHARS .67.
      741   DEFINE BROWSE BR-scales-type
      742     QUERY BR-scales-type NO-LOCK DISPLAY
      743         tt-scales-type.scales-type COLUMN-LABEL "Тип весов" FORMAT "X(16)":U
      744         tt-scales-type.scales-name COLUMN-LABEL "Название!программы!пересылки!данных" FORMAT "X(20)":U
      745         tt-scales-type.is-tiger COLUMN-LABEL "Задавать!коды тары" FORMAT "+/":U
      746               WIDTH 68.25
      747     ENABLE
      748         tt-scales-type.scales-name
      749       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 8
      750            TITLE "Типы весов" FIT-LAST-COLUMN.
      751   DEFINE FRAME Dialog-Frame
      752        B-exit AT ROW 1 COL 1
      753        b-quit AT ROW 1 COL 11
      754        RS-sclin-ld AT ROW 1 COL 52.5 NO-LABEL WIDGET-ID 2
      755        B-Help AT ROW 1 COL 95
      756        EDITOR-1 AT ROW 2 COL 21 NO-LABEL WIDGET-ID 8
      757        B-add AT ROW 3 COL 1
      758        B-del AT ROW 3 COL 11
      759        B-etc AT ROW 3 COL 84.5
      760        BR-scales-type AT ROW 4 COL 1
      761        B-mark AT ROW 12 COL 1
      762        BR-scales AT ROW 13 COL 1
      763        mark-num AT ROW 12 COL 9.5 COLON-ALIGNED NO-LABEL
      764        l-scallist AT ROW 12 COL 16.5 COLON-ALIGNED NO-LABEL
      765        SPACE(39.74) SKIP(7.90)
      766       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      767            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      768            TITLE "Настройки, необходимые для работы весов"
      769            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      770   ASSIGN
      771          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      772          FRAME Dialog-Frame:HIDDEN           = TRUE.
      773   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      774   DO:
      775     APPLY "END-ERROR":U TO SELF.
      776   END.
      777   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      778   DO:
      779   DEFINE VARIABLE vscales-type AS CHARACTER NO-UNDO.
      780   DEFINE VARIABLE v-type AS CHARACTER NO-UNDO.
      781   DEFINE VARIABLE ii AS integer NO-UNDO.
      782   DEFINE BUFFER buf_tt-scales-type FOR tt-scales-type.
      783   assign
      784   vscales-type = "":U
      785   .
      786   DO ii = 1 to num-entries('CAS_LP-15,CAS_LP-6,HELMAC_net,HELMAC_model-Z,HELMAC_model-T,CAS_LP-485,BOLET_P-280,BZB-SC515,DIGI_SM-80,CAS_LP-15v1.6,TIGER,MIRA,TIGER2,CAS_LP-16x,DIGI-SM,TIGER-SPCT2,SHTRIH-M,CAS_LP-II,CAS_CL5000J,CAS_CL5000,DIGI_AW-4600_FX,TIGER-SPCT1':U):
      787       assign
      788       vscales-type = vscales-type + chr(44) + entry(ii, 'CAS_LP-15,CAS_LP-6,HELMAC_net,HELMAC_model-Z,HELMAC_model-T,CAS_LP-485,BOLET_P-280,BZB-SC515,DIGI_SM-80,CAS_LP-15v1.6,TIGER,MIRA,TIGER2,CAS_LP-16x,DIGI-SM,TIGER-SPCT2,SHTRIH-M,CAS_LP-II,CAS_CL5000J,CAS_CL5000,DIGI_AW-4600_FX,TIGER-SPCT1':U)
      789       .
      790   end.
      791   run gbl/d-list.w (
      792                 INPUT "b-sel":U
      793                 ,INPUT "Выберите типы параметров для редактирования или просмотра"
      794                 ,INPUT vscales-type
      795                 ,INPUT vscales-type
      796                 ,INPUT chr(44)
      797                 ,INPUT "":U
      798                 ,output v-type).
      799   IF v-type = "":u THEN do:
      800     RETURN no-apply.
      801   end.
      802   FIND FIRST buf_tt-scales-type NO-LOCK WHERE
      803              buf_tt-scales-type.scales-type = v-type NO-ERROR.
      804   IF AVAILABLE buf_tt-scales-type THEN DO:
      805       MESSAGE
      806       "В вашем списке уже есть весы типа " v-type
      807       VIEW-AS ALERT-BOX ERROR.
      808       RETURN NO-APPLY.
      809   END.
      810   CREATE buf_tt-scales-type.
      811   ASSIGN
      812   buf_tt-scales-type.scales-type = v-type
      813   buf_tt-scales-type.scales-name = ENTRY(LOOKUP(v-type, 'CAS_LP-15,CAS_LP-6,HELMAC_net,HELMAC_model-Z,HELMAC_model-T,CAS_LP-485,BOLET_P-280,BZB-SC515,DIGI_SM-80,CAS_LP-15v1.6,TIGER,MIRA,TIGER2,CAS_LP-16x,DIGI-SM,TIGER-SPCT2,SHTRIH-M,CAS_LP-II,CAS_CL5000J,CAS_CL5000,DIGI_AW-4600_FX,TIGER-SPCT1':U), 'exe/lp15s.exe,exe/lp15s.exe,exe/hcns.exe,exe/hczs.exe,exe/hcts.exe,exe/lp485s.exe,exe/scalex.exe,exe/bzbs.exe,exe/digis.exe,exe/lp16s.exe,exe/metos.exe,exe/miras.exe,exe/meto2s.exe,exe/lp16xs.exe,,,exe/shtrih.exe,exe/lp16s.exe,exe/cl5000js.exe,exe/cl5000s.exe,,':U)
      814   buf_tt-scales-type.is-tiger = (IF v-type = "TIGER":U OR v-type = "MIRA":U OR v-type = "TIGER2" THEN YES ELSE NO)
      815   .
      816   RUN Openbr-Scales-type IN THIS-PROCEDURE no-error.
      817   END.
      818   ON CHOOSE OF B-del IN FRAME Dialog-Frame
      819   DO:
      820     IF NOT AVAILABLE tt-scales-type  THEN RETURN NO-APPLY.
      821     DELETE tt-scales-type.
      822     RUN Openbr-Scales-type IN THIS-PROCEDURE no-error.
      823   END.
      824   ON CHOOSE OF B-etc IN FRAME Dialog-Frame
      825   DO:
      826     run adm/shattr-6-1.w(input-output v-noauto-scls).
      827   END.
      828   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      829   DO:
      830     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      831     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      832   END.
      833   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
      834   DO:
      835     define variable loc#log as logical no-undo .
      836     if available X_scales then do:
      837         if lookup(string( X_scales.scales-num ), v-num-list ) > 0  then do:
      838             v-num-list = TRIM( v-num-list, chr(44)) .
      839             v-num-list = chr(44) + v-num-list + chr(44).
      840             v-num-list = replace( v-num-list, chr(44) + string( X_scales.scales-num ) + chr(44), "") .
      841             v-num-list = TRIM( v-num-list, chr(44)) .
      842         end.
      843         else
      844         v-num-list = v-num-list + ( if v-num-list = "" then "" else chr(44) ) + string(  X_scales.scales-num ) .
      845         loc#log = br-scales:refresh() .
      846         if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      847             loc#log = br-scales:select-next-row ().
      848             apply "VALUE-CHANGED" to br-scales in frame Dialog-Frame.
      849         end.
      850         if num-entries( v-num-list ) = 0
      851         then
      852             hide mark-num in frame Dialog-Frame.
      853         else
      854             disp num-entries( v-num-list ) @ mark-num with frame Dialog-Frame.
      855     end.
      856     apply "entry" to br-scales in frame Dialog-Frame.
      857   END.
      858   ON VALUE-CHANGED OF RS-sclin-ld IN FRAME Dialog-Frame
      859   DO:
      860     DO:
      861     IF p-mode <> 'ПРОСМОТР':U  THEN
      862     ASSIGN
      863     RS-sclin-ld.
      864     CASE RS-sclin-ld:
      865       WHEN 0 THEN DO:
      866         RS-sclin-ld = 0.
      867       END.
      868       WHEN 1 THEN DO:
      869         RS-sclin-ld = 1.
      870       END.
      871       WHEN 2 THEN DO:
      872         RS-sclin-ld = 2.
      873       END.
      874     END CASE.
      875     EDITOR-1 = string(RS-sclin-ld) .
      876   END.
      877   END.
      878   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      879   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      880   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      881   on help of frame Dialog-Frame
      882   do:
      883     run gbl/app_help.p
      884       (input this-procedure :file-name
      885       ,input ''
      886       ,input ?
      887       ) no-error.
      888     if error-status :error then do:
      889       message
      890         "Ошибка при вызове помощи"
      891         error-status :get-message(1)
      892         view-as alert-box .
      893     end.
      894   end.
      895   run minbtn-set in this-procedure .
      896   on choose of b-help in frame Dialog-Frame
      897   do:
      898     apply "help":u to frame Dialog-Frame .
      899   end.
      900   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      901   procedure minbtn-set :
      902       do
      903           on error undo, return error return-value
      904           :
      905           define variable ii              as integer       no-undo .
      906           define variable fh              as widget-handle no-undo .
      907           define variable hh              as widget-handle no-undo .
      908           define variable v-h             as handle        extent 4 no-undo .
      909           define variable v-name-button   as character     no-undo .
      910           define variable v-help-old-x    as decimal       no-undo .
      911           define variable v-help-old-y    as decimal       no-undo .
      912           define variable v-help-old-size as decimal       no-undo .
      913           define variable v-frame-width   as decimal       no-undo .
      914           define variable jj              as integer       no-undo .
      915           do
      916               on error undo, return error
      917               :
      918               assign
      919                   v-frame-width = frame Dialog-Frame:width - 0.3
      920                   fh            = frame Dialog-Frame:first-child
      921                   hh            = fh:first-child
      922                   ii            = 1
      923                   .
      924               do while valid-handle(hh):
      925                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      926                   do:
      927                       case lc(hh:name) :
      928                           when "b-help" then
      929                               do:
      930                                   hh:load-image-up("cmp/b-help.bmp":u) .
      931                                   hh:load-image-down("cmp/b-help.bmp":u) .
      932                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      933                                   hh:TOOLTIP = "Помощь" .
      934                                   v-help-old-x = hh:column .
      935                                   v-help-old-y = hh:row    .
      936                                   v-help-old-size = hh:width .
      937                                   hh:width-chars = 2.5 .
      938                               end.
      939                           when "b-print" then
      940                               do:
      941                                   hh:load-image("cmp/b-print.bmp":u) .
      942                                   hh:TOOLTIP = "Печать" .
      943                                   v-h[ii] = hh:handle .
      944                                   ii = ii + 1 .
      945                                   hh:width-chars = 3 .
      946                               end.
      947                           when "b-history" or
      948                           when "b-hist" then
      949                               do:
      950                                   hh:load-image("cmp/b-hist.bmp":u) .
      951                                   hh:TOOLTIP = "История" .
      952                                   v-h[ii] = hh:handle .
      953                                   ii = ii + 1 .
      954                                   hh:width-chars = 3 .
      955                               end.
      956                           when "b-sch" then
      957                               do:
      958                                   hh:load-image("cmp/b-sch.bmp":u) .
      959                                   hh:TOOLTIP = "Установка Фильтра" .
      960                                   v-h[ii] = hh:handle .
      961                                   ii = ii + 1 .
      962                                   hh:width-chars = 3 .
      963                               end.
      964                           when "b-hist-user" then
      965                               do:
      966                                   hh:load-image("cmp/b-hist.bmp":u) .
      967                                   hh:TOOLTIP = "История пользователя" .
      968                                   ii = ii + 1 .
      969                               end.
      970                       end case.
      971                   end.
      972                   hh = hh:next-sibling.
      973               end.
      974               b-help:column = v-frame-width - b-help:width-chars.
      975               jj = 0.
      976               repeat ii = 4 to 1 by -1 :
      977                   if valid-handle (v-h[ii] ) then
      978                   do:
      979                       jj  = jj + 1 .
      980                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      981                       v-h[ii]:row    = v-help-old-y .
      982                   end.
      983               end.
      984           end.
      985       end.
      986   end procedure.
      987   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      988   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      989   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      990   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      991   define variable v-diasize-current-frame-width  as decimal   no-undo .
      992   define variable v-diasize-current-frame-height as decimal   no-undo .
      993   define variable v-diasize-change-size          as logical   no-undo .
      994   define variable v-diasize-resize-button        as handle    no-undo .
      995   define variable v-diasize-wndmax               as logical   no-undo .
      996   define variable v-diasize-wndstore             as logical   no-undo .
      997   define variable v-diasize-proc-name            as character no-undo .
      998   define variable v-diasize-browse-handle        as handle    no-undo .
      999   define variable v-diasize-browse-number        as integer   no-undo .
     1000   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1001   define temp-table temp-diasize-handle no-undo
     1002     field handle-value  as handle
     1003     field save-position as decimal
     1004     index xpk is primary unique handle-value
     1005     .
     1006   define temp-table temp-browse-handle no-undo
     1007     field browse-type   as character
     1008     field browse-number as integer
     1009     field browse-handle as handle
     1010     field original-size as decimal
     1011     index xpk is primary unique browse-type browse-number
     1012     index xie browse-type browse-handle
     1013   .
     1014   procedure diasize_change-height :
     1015     define input  parameter p-change-value  as decimal   no-undo .
     1016     define input  parameter p-move-resize   as logical   no-undo .
     1017     define variable v-field-group-handle    as handle    no-undo .
     1018     define variable v-object-handle         as handle    no-undo .
     1019     define variable v-frame-height          as decimal   no-undo .
     1020     define variable v-frame-virtual-height  as decimal   no-undo .
     1021     define variable v-browse-height         as decimal   no-undo .
     1022     define variable v-window-height         as decimal   no-undo .
     1023     define variable v-window-virtual-height as decimal   no-undo .
     1024     define variable v-change-sign           as integer   no-undo .
     1025     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1026     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1027     if p-change-value > 0
     1028     then do:
     1029       if frame Dialog-Frame :height + p-change-value
     1030           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1031       then do:
     1032         assign
     1033           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1034                           - (frame Dialog-Frame :height-chars)
     1035         .
     1036         if p-change-value <= 0
     1037         then do:
     1038           run diasize_position-resize-button in this-procedure .
     1039           return .
     1040         end.
     1041       end.
     1042     end.
     1043     if p-change-value < 0
     1044     then do:
     1045       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1046       then do:
     1047         assign
     1048           p-change-value = v-diasize-orig-frame-height
     1049                          - (frame Dialog-Frame :height-chars)
     1050         .
     1051         if p-change-value >= 0
     1052         then do:
     1053           run diasize_position-resize-button in this-procedure .
     1054           return .
     1055         end.
     1056       end.
     1057     end.
     1058     if p-change-value >= 0
     1059     then do:
     1060       assign
     1061         v-change-sign = 1
     1062       .
     1063     end.
     1064     else do:
     1065       assign
     1066         v-change-sign = -1
     1067       .
     1068     end.
     1069     assign
     1070       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1071     .
     1072     if p-change-value = 0
     1073     then do:
     1074       run diasize_position-resize-button in this-procedure .
     1075       return .
     1076     end.
     1077     move_block:
     1078     do
     1079     on error undo move_block, retry move_block
     1080     :
     1081       if retry
     1082       then do:
     1083         do
     1084         on error undo move_block, leave move_block
     1085         :
     1086           if p-change-value > 0
     1087           then do:
     1088             for each buf_temp-diasize-handle
     1089             on error undo, next
     1090             :
     1091               assign
     1092                 v-object-handle = buf_temp-diasize-handle.handle-value
     1093               .
     1094               if v-object-handle <> v-diasize-resize-button
     1095               then do:
     1096                 assign
     1097                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1098                 .
     1099               end.
     1100             end.
     1101             assign
     1102               v-diasize-browse-handle :height = v-browse-height
     1103             .
     1104             for each buf_temp-browse-handle
     1105               where buf_temp-browse-handle.browse-type = 'height':u
     1106             on error undo, next
     1107             :
     1108               assign
     1109                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1110               .
     1111             end.
     1112             assign
     1113               frame Dialog-Frame :height = v-frame-height
     1114             .
     1115             if frame Dialog-Frame :scrollable = true
     1116             then do:
     1117               assign
     1118                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1119               .
     1120             end.
     1121             run diasize_position-resize-button in this-procedure .
     1122           end.
     1123           else do:
     1124             if frame Dialog-Frame :scrollable = true
     1125             then do:
     1126               assign
     1127                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1128               .
     1129             end.
     1130             assign
     1131               frame Dialog-Frame :height = v-frame-height
     1132             .
     1133             assign
     1134               v-diasize-browse-handle :height = v-browse-height
     1135             .
     1136             for each buf_temp-browse-handle
     1137               where buf_temp-browse-handle.browse-type = 'height':u
     1138             on error undo, next
     1139             :
     1140               assign
     1141                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1142               .
     1143             end.
     1144             for each buf_temp-diasize-handle
     1145             on error undo, next
     1146             :
     1147               assign
     1148                 v-object-handle = buf_temp-diasize-handle.handle-value
     1149               .
     1150               if v-object-handle <> v-diasize-resize-button
     1151               then do:
     1152                 assign
     1153                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1154                 .
     1155               end.
     1156             end.
     1157             run diasize_position-resize-button in this-procedure .
     1158           end.
     1159           assign
     1160             v-diasize-change-size = false
     1161           .
     1162           leave move_block .
     1163         end.
     1164       end.
     1165       assign
     1166         v-diasize-need-full-display = true
     1167       .
     1168       if v-diasize-change-size = false
     1169       then do:
     1170         assign
     1171           v-diasize-change-size = true
     1172         .
     1173       end.
     1174       else do:
     1175         return .
     1176       end.
     1177       assign
     1178         v-frame-height = frame Dialog-Frame :height
     1179         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1180         v-browse-height = v-diasize-browse-handle :height
     1181       .
     1182       for each buf_temp-browse-handle
     1183         where buf_temp-browse-handle.browse-type = 'height':u
     1184       :
     1185         assign
     1186           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1187         .
     1188       end.
     1189       for each buf_temp-diasize-handle
     1190       :
     1191         delete buf_temp-diasize-handle .
     1192       end.
     1193       assign
     1194         v-field-group-handle = frame Dialog-Frame :first-child
     1195       .
     1196       do while valid-handle(v-field-group-handle)
     1197       :
     1198         assign
     1199           v-object-handle = v-field-group-handle :first-child
     1200         .
     1201         do while valid-handle(v-object-handle)
     1202         :
     1203           if  v-object-handle <> v-diasize-browse-handle :handle
     1204           and can-query(v-object-handle, "row")
     1205           and can-query(v-object-handle, "height")
     1206           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1207           then do:
     1208             find first buf_temp-browse-handle
     1209               where buf_temp-browse-handle.browse-type   = 'height':u
     1210                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1211               no-error .
     1212             if available buf_temp-browse-handle
     1213             then do:
     1214             end.
     1215             else do:
     1216               create buf_temp-diasize-handle .
     1217               assign
     1218                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1219                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1220               .
     1221             end.
     1222           end.
     1223           assign
     1224             v-object-handle = v-object-handle :next-sibling
     1225           .
     1226         end.
     1227         assign
     1228           v-field-group-handle = v-field-group-handle :next-sibling
     1229         .
     1230       end.
     1231       do with frame Dialog-Frame
     1232       :
     1233         hide v-diasize-resize-button .
     1234         assign
     1235           v-diasize-resize-button :row    = 1
     1236           v-diasize-resize-button :column = 1
     1237         .
     1238       end.
     1239       if p-change-value > 0
     1240       then do:
     1241         if frame Dialog-Frame :scrollable = true
     1242         then do:
     1243           assign
     1244             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1245             no-error .
     1246           if error-status :error
     1247           or error-status :get-message(1) <> ""
     1248           then do:
     1249             undo move_block, retry move_block .
     1250           end.
     1251         end.
     1252         assign
     1253           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1254           no-error .
     1255         if error-status :error
     1256         or error-status :get-message(1) <> ""
     1257         then do:
     1258           undo move_block, retry move_block .
     1259         end.
     1260         assign
     1261           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1262           no-error .
     1263         if error-status :error
     1264         or error-status :get-message(1) <> ""
     1265         then do:
     1266           undo move_block, retry move_block .
     1267         end.
     1268         for each buf_temp-browse-handle
     1269           where buf_temp-browse-handle.browse-type = 'height':u
     1270         on error undo move_block, retry move_block
     1271         :
     1272           assign
     1273             buf_temp-browse-handle.browse-handle :height
     1274               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1275             no-error .
     1276           if error-status :error
     1277           or error-status :get-message(1) <> ""
     1278           then do:
     1279             undo move_block, retry move_block .
     1280           end.
     1281         end.
     1282         for each buf_temp-diasize-handle
     1283         on error undo move_block, retry move_block
     1284         :
     1285           assign
     1286             v-object-handle = buf_temp-diasize-handle.handle-value
     1287           .
     1288           if v-object-handle <> v-diasize-resize-button
     1289           then do:
     1290             assign
     1291               v-object-handle :row = v-object-handle :row + p-change-value
     1292               no-error .
     1293             if error-status :error
     1294             or error-status :get-message(1) <> ""
     1295             then do:
     1296               undo move_block, retry move_block .
     1297             end.
     1298           end.
     1299         end.
     1300       end.
     1301       else do:
     1302         for each buf_temp-diasize-handle
     1303         on error undo move_block, retry move_block
     1304         :
     1305           assign
     1306             v-object-handle = buf_temp-diasize-handle.handle-value
     1307           .
     1308           if v-object-handle <> v-diasize-resize-button
     1309           then do:
     1310             assign
     1311               v-object-handle :row = v-object-handle :row + p-change-value
     1312               no-error .
     1313             if error-status :error
     1314             or error-status :get-message(1) <> ""
     1315             then do:
     1316               undo move_block, retry move_block .
     1317             end.
     1318           end.
     1319         end.
     1320         assign
     1321           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1322           no-error .
     1323         if error-status :error
     1324         or error-status :get-message(1) <> ""
     1325         then do:
     1326           undo move_block, retry move_block .
     1327         end.
     1328         for each buf_temp-browse-handle
     1329           where buf_temp-browse-handle.browse-type = 'height':u
     1330         on error undo move_block, retry move_block
     1331         :
     1332           assign
     1333             buf_temp-browse-handle.browse-handle :height
     1334               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1335             no-error .
     1336           if error-status :error
     1337           or error-status :get-message(1) <> ""
     1338           then do:
     1339             undo move_block, retry move_block .
     1340           end.
     1341         end.
     1342         assign
     1343           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1344           no-error .
     1345         if error-status :error
     1346         or error-status :get-message(1) <> ""
     1347         then do:
     1348           undo move_block, retry move_block .
     1349         end.
     1350         if frame Dialog-Frame :scrollable = true
     1351         then do:
     1352           assign
     1353             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1354             no-error .
     1355           if error-status :error
     1356           or error-status :get-message(1) <> ""
     1357           then do:
     1358             undo move_block, retry move_block .
     1359           end.
     1360         end.
     1361       end.
     1362       if p-move-resize = true
     1363       then do:
     1364         run diasize_position-resize-button in this-procedure .
     1365       end.
     1366       if v-diasize-wndstore = true
     1367       then do:
     1368         if connected("ub") = true
     1369         then do:
     1370           define variable v-cntxt-db-num        as integer   no-undo .
     1371           define variable v-cntxt-userid        as character no-undo .
     1372           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1373                                             , OUTPUT v-cntxt-userid
     1374                                             ) .
     1375           run gbl/wndsizew.p
     1376             (input  v-cntxt-db-num
     1377             ,input  v-cntxt-userid
     1378             ,input  v-diasize-proc-name
     1379             ,input  'height':u
     1380             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1381             ) .
     1382         end.
     1383       end.
     1384     end.
     1385     assign
     1386       v-diasize-change-size = false
     1387     .
     1388   end procedure.
     1389   procedure diasize_set-height :
     1390     define input  parameter p-new-height  as decimal   no-undo .
     1391     define input  parameter p-move-resize as logical   no-undo .
     1392     do
     1393     on error undo, return error return-value
     1394     :
     1395       run diasize_change-height in this-procedure
     1396         (input  (p-new-height - frame Dialog-Frame :height)
     1397         ,input  p-move-resize
     1398         ) .
     1399     end.
     1400   end procedure.
     1401   procedure diasize_change-width :
     1402     define input  parameter p-change-value as decimal   no-undo .
     1403     define input  parameter p-move-resize  as logical   no-undo .
     1404     define variable v-field-group-handle   as handle    no-undo .
     1405     define variable v-object-handle        as handle    no-undo .
     1406     define variable v-frame-width          as decimal   no-undo .
     1407     define variable v-frame-virtual-width  as decimal   no-undo .
     1408     define variable v-browse-width         as decimal   no-undo .
     1409     define variable v-window-width         as decimal   no-undo .
     1410     define variable v-window-virtual-width as decimal   no-undo .
     1411     define variable v-change-sign          as integer   no-undo .
     1412     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1413     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1414     if p-change-value > 0
     1415     then do:
     1416       if frame Dialog-Frame :width + p-change-value >
     1417           session :width-chars
     1418       then do:
     1419         assign
     1420           p-change-value = session :width-chars - frame Dialog-Frame :width
     1421         .
     1422         if p-change-value <= 0
     1423         then do:
     1424           run diasize_position-resize-button in this-procedure .
     1425           return .
     1426         end.
     1427       end.
     1428     end.
     1429     if p-change-value < 0
     1430     then do:
     1431       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1432       then do:
     1433         assign
     1434           p-change-value = v-diasize-orig-frame-width
     1435                          - frame Dialog-Frame :width
     1436         .
     1437         if p-change-value >= 0
     1438         then do:
     1439           run diasize_position-resize-button in this-procedure .
     1440           return .
     1441         end.
     1442       end.
     1443     end.
     1444     if p-change-value >= 0
     1445     then do:
     1446       assign
     1447         v-change-sign = 1
     1448       .
     1449     end.
     1450     else do:
     1451       assign
     1452         v-change-sign = -1
     1453       .
     1454     end.
     1455     assign
     1456       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1457     .
     1458     if p-change-value = 0
     1459     then do:
     1460       run diasize_position-resize-button in this-procedure .
     1461       return .
     1462     end.
     1463     move_block:
     1464     do
     1465     on error undo move_block, leave move_block
     1466     :
     1467       if retry
     1468       then do:
     1469         do
     1470         on error undo move_block, leave move_block
     1471         :
     1472           if p-change-value > 0
     1473           then do:
     1474             for each buf_temp-diasize-handle
     1475             on error undo, next
     1476             :
     1477               assign
     1478                 v-object-handle = buf_temp-diasize-handle.handle-value
     1479               .
     1480               if v-object-handle <> v-diasize-resize-button
     1481               then do:
     1482                 assign
     1483                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1484                 .
     1485               end.
     1486             end.
     1487             assign
     1488               v-diasize-browse-handle :width = v-browse-width
     1489             .
     1490             for each buf_temp-browse-handle
     1491               where buf_temp-browse-handle.browse-type = 'width':u
     1492             on error undo, next
     1493             :
     1494               assign
     1495                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1496               .
     1497             end.
     1498             assign
     1499               frame Dialog-Frame :width = v-frame-width
     1500             .
     1501             if frame Dialog-Frame :scrollable = true
     1502             then do:
     1503               assign
     1504                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1505               .
     1506             end.
     1507             run diasize_position-resize-button in this-procedure .
     1508           end.
     1509           else do:
     1510             if frame Dialog-Frame :scrollable = true
     1511             then do:
     1512               assign
     1513                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1514               .
     1515             end.
     1516             assign
     1517               frame Dialog-Frame :width = v-frame-width
     1518             .
     1519             for each buf_temp-browse-handle
     1520               where buf_temp-browse-handle.browse-type = 'width':u
     1521             on error undo, next
     1522             :
     1523               assign
     1524                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1525               .
     1526             end.
     1527             assign
     1528               v-diasize-browse-handle :width = v-browse-width
     1529             .
     1530             for each buf_temp-diasize-handle
     1531             on error undo, next
     1532             :
     1533               assign
     1534                 v-object-handle = buf_temp-diasize-handle.handle-value
     1535               .
     1536               if v-object-handle <> v-diasize-resize-button
     1537               then do:
     1538                 assign
     1539                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1540                 .
     1541               end.
     1542             end.
     1543             run diasize_position-resize-button in this-procedure .
     1544           end.
     1545           assign
     1546             v-diasize-change-size = false
     1547           .
     1548           leave move_block .
     1549         end.
     1550       end.
     1551       assign
     1552         v-diasize-need-full-display = true
     1553       .
     1554       if v-diasize-change-size = false
     1555       then do:
     1556         assign
     1557           v-diasize-change-size = true
     1558         .
     1559       end.
     1560       else do:
     1561         return .
     1562       end.
     1563       assign
     1564         v-frame-width = frame Dialog-Frame :width
     1565         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1566         v-browse-width = v-diasize-browse-handle :width
     1567       .
     1568       for each buf_temp-browse-handle
     1569         where buf_temp-browse-handle.browse-type = 'width':u
     1570       :
     1571         assign
     1572           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1573         .
     1574       end.
     1575       for each buf_temp-diasize-handle
     1576       :
     1577         delete buf_temp-diasize-handle .
     1578       end.
     1579       assign
     1580         v-field-group-handle = frame Dialog-Frame :first-child
     1581       .
     1582       do while valid-handle(v-field-group-handle)
     1583       :
     1584         assign
     1585           v-object-handle = v-field-group-handle :first-child
     1586         .
     1587         do while valid-handle(v-object-handle)
     1588         :
     1589           if  v-object-handle <> v-diasize-browse-handle :handle
     1590           and v-object-handle <> v-diasize-resize-button
     1591           and can-query(v-object-handle, "row")
     1592           and can-query(v-object-handle, "height")
     1593           and ( v-object-handle :col + v-object-handle :width
     1594                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1595               )
     1596           then do:
     1597             find first buf_temp-browse-handle
     1598               where buf_temp-browse-handle.browse-type   = 'width':u
     1599                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1600               no-error .
     1601             if available buf_temp-browse-handle
     1602             then do:
     1603             end.
     1604             else do:
     1605               create buf_temp-diasize-handle .
     1606               assign
     1607                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1608                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1609               .
     1610             end.
     1611           end.
     1612           assign
     1613             v-object-handle = v-object-handle :next-sibling
     1614           .
     1615         end.
     1616         assign
     1617           v-field-group-handle = v-field-group-handle :next-sibling
     1618         .
     1619       end.
     1620       do with frame Dialog-Frame
     1621       :
     1622         hide v-diasize-resize-button .
     1623         v-diasize-resize-button :row = 1.
     1624         v-diasize-resize-button :column = 1.
     1625       end.
     1626       if p-change-value > 0
     1627       then do:
     1628         if frame Dialog-Frame :scrollable = true
     1629         then do:
     1630           assign
     1631             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1632             no-error .
     1633           if error-status :error
     1634           or error-status :get-message(1) <> ""
     1635           then do:
     1636             undo move_block, retry move_block.
     1637           end.
     1638         end.
     1639         assign
     1640           frame Dialog-Frame :width = v-frame-width + p-change-value
     1641           no-error .
     1642         if error-status :error
     1643         or error-status :get-message(1) <> ""
     1644         then do:
     1645           undo move_block, retry move_block.
     1646         end.
     1647         assign
     1648           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1649         no-error .
     1650         if error-status :error
     1651         or error-status :get-message(1) <> ""
     1652         then do:
     1653           undo move_block, retry move_block.
     1654         end.
     1655         for each buf_temp-browse-handle
     1656           where buf_temp-browse-handle.browse-type = 'width':u
     1657         on error undo move_block, retry move_block
     1658         :
     1659           assign
     1660             buf_temp-browse-handle.browse-handle :width
     1661               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1662             no-error .
     1663           if error-status :error
     1664           or error-status :get-message(1) <> ""
     1665           then do:
     1666             undo move_block, retry move_block .
     1667           end.
     1668         end.
     1669         for each buf_temp-diasize-handle
     1670         on error undo move_block, retry move_block
     1671         :
     1672           assign
     1673             v-object-handle = buf_temp-diasize-handle.handle-value
     1674           .
     1675           if v-object-handle <> v-diasize-resize-button
     1676           then do:
     1677             assign
     1678               v-object-handle :col = v-object-handle :col + p-change-value
     1679               no-error .
     1680             if error-status :error
     1681             or error-status :get-message(1) <> ""
     1682             then do:
     1683               undo move_block, retry move_block .
     1684             end.
     1685           end.
     1686         end.
     1687       end.
     1688       else do:
     1689         for each buf_temp-diasize-handle
     1690         on error undo move_block, retry move_block
     1691         :
     1692           assign
     1693             v-object-handle = buf_temp-diasize-handle.handle-value
     1694           .
     1695           if v-object-handle <> v-diasize-resize-button
     1696           then do:
     1697             assign
     1698               v-object-handle :col = v-object-handle :col + p-change-value
     1699               no-error .
     1700             if error-status :error
     1701             or error-status :get-message(1) <> ""
     1702             then do:
     1703               undo move_block, retry move_block .
     1704             end.
     1705           end.
     1706         end.
     1707         for each buf_temp-browse-handle
     1708           where buf_temp-browse-handle.browse-type = 'width':u
     1709         on error undo move_block, retry move_block
     1710         :
     1711           assign
     1712             buf_temp-browse-handle.browse-handle :width
     1713               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1714             no-error .
     1715           if error-status :error
     1716           or error-status :get-message(1) <> ""
     1717           then do:
     1718             undo move_block, retry move_block .
     1719           end.
     1720         end.
     1721         assign
     1722           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1723           no-error .
     1724         if error-status :error
     1725         or error-status :get-message(1) <> ""
     1726         then do:
     1727           undo move_block, retry move_block.
     1728         end.
     1729         assign
     1730           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1731         no-error .
     1732         if error-status :error
     1733         or error-status :get-message(1) <> ""
     1734         then do:
     1735           undo move_block, retry move_block.
     1736         end.
     1737         if frame Dialog-Frame :scrollable = true
     1738         then do:
     1739           assign
     1740             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1741           no-error .
     1742           if error-status :error
     1743           or error-status :get-message(1) <> ""
     1744           then do:
     1745             undo move_block, retry move_block.
     1746           end.
     1747         end.
     1748       end.
     1749       if p-move-resize
     1750       then do:
     1751         run diasize_position-resize-button in this-procedure .
     1752       end.
     1753       if v-diasize-wndstore = true
     1754       then do:
     1755         if connected("ub") = true
     1756         then do:
     1757           define variable v-cntxt-db-num        as integer   no-undo .
     1758           define variable v-cntxt-userid        as character no-undo .
     1759           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1760                                             , OUTPUT v-cntxt-userid
     1761                                             ) .
     1762           run gbl/wndsizew.p
     1763             (input  v-cntxt-db-num
     1764             ,input  v-cntxt-userid
     1765             ,input  v-diasize-proc-name
     1766             ,input  'width':u
     1767             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1768             ) .
     1769         end.
     1770       end.
     1771     end.
     1772     assign
     1773       v-diasize-change-size = false
     1774     .
     1775   end procedure.
     1776   procedure diasize_set-width :
     1777     define input  parameter p-new-width  as decimal   no-undo .
     1778     define input  parameter p-move-resize as logical   no-undo .
     1779     do
     1780     on error undo, return error return-value
     1781     :
     1782       run diasize_change-width in this-procedure
     1783         (input  (p-new-width - frame Dialog-Frame :width)
     1784         ,input  p-move-resize
     1785         ) .
     1786     end.
     1787   end procedure.
     1788   procedure diasize_position-resize-button :
     1789     do with frame Dialog-Frame
     1790     :
     1791       hide v-diasize-resize-button .
     1792       assign
     1793         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1794                     - 1
     1795                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1796         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1797                     - 1
     1798                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1799       .
     1800       view v-diasize-resize-button .
     1801     end.
     1802   end procedure.
     1803   on alt-right anywhere
     1804   do:
     1805     run diasize_change-width in this-procedure
     1806       (input 1
     1807       ,input true
     1808       ) .
     1809     return no-apply .
     1810   end.
     1811   on alt-left anywhere
     1812   do:
     1813     run diasize_change-width in this-procedure
     1814       (input -1
     1815       ,input true
     1816       ) .
     1817     return no-apply .
     1818   end.
     1819   on alt-down anywhere
     1820   do:
     1821     run diasize_change-height in this-procedure
     1822       (input 1
     1823       ,input true
     1824       ) .
     1825     return no-apply .
     1826   end.
     1827   on alt-up anywhere
     1828   do:
     1829     run diasize_change-height in this-procedure
     1830       (input -1
     1831       ,input true
     1832       ) .
     1833     return no-apply .
     1834   end.
     1835   on alt-enter of frame Dialog-Frame
     1836   do:
     1837     run diasize_maximize in this-procedure
     1838       (input  ?
     1839       ).
     1840     return no-apply .
     1841   end.
     1842   procedure diasize_end-move :
     1843     do
     1844     on error undo, return error return-value
     1845     :
     1846       define variable v-row-delta as decimal   no-undo .
     1847       define variable v-col-delta as decimal   no-undo .
     1848       define variable v-new-row as decimal   no-undo .
     1849       define variable v-new-col as decimal   no-undo .
     1850       assign
     1851         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1852         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1853       .
     1854       assign
     1855         v-row-delta = v-new-row - frame Dialog-Frame :height
     1856         v-col-delta = v-new-col - frame Dialog-Frame :width
     1857       .
     1858       run diasize_change-height in this-procedure
     1859         (input v-row-delta
     1860         ,input true
     1861         ) .
     1862       run diasize_change-width in this-procedure
     1863         (input v-col-delta
     1864         ,input true
     1865         ) .
     1866     end.
     1867   end procedure.
     1868   procedure diasize_maximize :
     1869     define input  parameter p-action as logical   no-undo .
     1870     do
     1871     on error undo, return error return-value
     1872     :
     1873       if p-action = ?
     1874       then do:
     1875         if v-diasize-need-maximize = true
     1876         then do:
     1877           assign
     1878             p-action = true
     1879           .
     1880         end.
     1881         else do:
     1882           assign
     1883             p-action = false
     1884           .
     1885         end.
     1886       end.
     1887       if p-action = true
     1888       then do:
     1889         run diasize_change-height in this-procedure
     1890           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1891               - frame Dialog-Frame :height-chars
     1892           ,input true
     1893           ) .
     1894         run diasize_change-width in this-procedure
     1895           (input session :width-chars
     1896               - frame Dialog-Frame :width-chars
     1897           ,input true
     1898           ) .
     1899         assign
     1900           v-diasize-need-maximize = false
     1901         .
     1902       end.
     1903       else do:
     1904         run diasize_change-width in this-procedure
     1905           (input v-diasize-orig-frame-width
     1906               - frame Dialog-Frame :width-chars
     1907           ,input true
     1908           ) .
     1909         run diasize_change-height in this-procedure
     1910           (input v-diasize-orig-frame-height
     1911               - frame Dialog-Frame :height-chars
     1912           ,input true
     1913           ) .
     1914         assign
     1915           v-diasize-need-maximize = true
     1916         .
     1917       end.
     1918     end.
     1919   end procedure.
     1920   procedure diasize_restore-orig-size :
     1921     do
     1922     on error undo, return error return-value
     1923     :
     1924       assign
     1925         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1926         v-diasize-current-frame-height = frame Dialog-Frame :height
     1927       .
     1928       run diasize_set-height in this-procedure
     1929         (input  v-diasize-orig-frame-height
     1930         ,input  true
     1931         ) .
     1932       run diasize_set-width in this-procedure
     1933         (input  v-diasize-orig-frame-width
     1934         ,input  true
     1935         ) .
     1936     end.
     1937   end procedure.
     1938   procedure diasize_restore-current-size :
     1939     do
     1940     on error undo, return error return-value
     1941     :
     1942       run diasize_set-height in this-procedure
     1943         (input  v-diasize-current-frame-height
     1944         ,input  true
     1945         ) .
     1946       run diasize_set-width in this-procedure
     1947         (input  v-diasize-current-frame-width
     1948         ,input  true
     1949         ) .
     1950     end.
     1951   end procedure.
     1952   procedure diasize_set-browse-handle :
     1953     define input  parameter p-browse-handle as handle   no-undo .
     1954     define buffer buf_temp-browse-handle for temp-browse-handle .
     1955     do
     1956     on error undo, return error return-value
     1957     :
     1958       assign
     1959         v-diasize-browse-handle = p-browse-handle
     1960       .
     1961       for each buf_temp-browse-handle
     1962       on error undo, return error return-value
     1963       :
     1964         delete buf_temp-browse-handle .
     1965       end.
     1966     end.
     1967   end procedure.
     1968   procedure diasize_add_browse :
     1969     define input  parameter p-browse-type   as character no-undo .
     1970     define input  parameter p-browse-handle as handle    no-undo .
     1971     define buffer buf_temp-browse-handle for temp-browse-handle .
     1972     do
     1973     on error undo, return error return-value
     1974     :
     1975       assign
     1976         v-diasize-browse-number = v-diasize-browse-number + 1
     1977       .
     1978       create buf_temp-browse-handle .
     1979       assign
     1980         buf_temp-browse-handle.browse-type   = p-browse-type
     1981         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1982         buf_temp-browse-handle.browse-handle = p-browse-handle
     1983       .
     1984     end.
     1985   end procedure.
     1986   procedure diasize_init :
     1987     define variable v-default-value    as logical   no-undo .
     1988     define variable v-restore-saved    as logical   no-undo .
     1989     define variable v-resize-value-str as character no-undo .
     1990     do
     1991     on error undo, return error return-value
     1992     :
     1993       do with frame Dialog-Frame
     1994       :
     1995         assign
     1996           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1997           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1998           v-diasize-browse-handle     = browse BR-scales :handle
     1999         .
     2000         create button v-diasize-resize-button
     2001         assign
     2002           parent        = frame Dialog-Frame :first-child
     2003           label         = "s"
     2004           height-pixels = 16
     2005           width-pixels  = 16
     2006           visible       = true
     2007           sensitive     = true
     2008           movable       = true
     2009           triggers:
     2010             on end-move persistent run diasize_end-move in this-procedure .
     2011           end triggers.
     2012         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2013         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2014         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2015         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2016         assign
     2017           v-diasize-wndmax = false
     2018         .
     2019         if connected("ub") = true
     2020         then do:
     2021           define variable v-cntxt-db-num        as integer   no-undo .
     2022           define variable v-cntxt-userid        as character no-undo .
     2023           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2024                                             , OUTPUT v-cntxt-userid
     2025                                             ) .
     2026           run gbl/wndpar_r.p
     2027             (input  v-cntxt-db-num
     2028             ,input  v-cntxt-userid
     2029             ,input  'wndmax':U
     2030             ,output v-diasize-wndmax
     2031             ,output v-default-value
     2032             ) .
     2033         end.
     2034         assign
     2035           v-diasize-wndstore = false
     2036         .
     2037         if connected("ub") = true
     2038         then do:
     2039           run gbl/wndpar_r.p
     2040             (input  v-cntxt-db-num
     2041             ,input  v-cntxt-userid
     2042             ,input  'wndstore':U
     2043             ,output v-diasize-wndstore
     2044             ,output v-default-value
     2045             ) .
     2046         end.
     2047         assign
     2048           v-diasize-proc-name = entry(1, program-name(2), '.')
     2049         .
     2050         if v-diasize-wndstore = true
     2051         then do:
     2052           assign
     2053             v-restore-saved = false
     2054           .
     2055           if connected("ub") = true
     2056           then do:
     2057             run gbl/wndsizer.p
     2058               (input  v-cntxt-db-num
     2059               ,input  v-cntxt-userid
     2060               ,input  v-diasize-proc-name
     2061               ,input  'height':u
     2062               ,output v-resize-value-str
     2063               ) .
     2064             if v-resize-value-str <> '':U
     2065             then do:
     2066               run diasize_change-height in this-procedure
     2067                 (input  integer(v-resize-value-str)
     2068                 ,input  true
     2069                 ) .
     2070               assign
     2071                 v-restore-saved = true
     2072               .
     2073             end.
     2074           end.
     2075           if connected("ub") = true
     2076           then do:
     2077             run gbl/wndsizer.p
     2078               (input  v-cntxt-db-num
     2079               ,input  v-cntxt-userid
     2080               ,input  v-diasize-proc-name
     2081               ,input  'width':u
     2082               ,output v-resize-value-str
     2083               ) .
     2084             if v-resize-value-str <> '':U
     2085             then do:
     2086               run diasize_change-width in this-procedure
     2087                 (input  integer(v-resize-value-str)
     2088                 ,input  true
     2089                 ) .
     2090               assign
     2091                 v-restore-saved = true
     2092               .
     2093             end.
     2094           end.
     2095           if v-restore-saved <> true
     2096           then do:
     2097             if v-diasize-wndmax = true
     2098             then do:
     2099               run diasize_maximize in this-procedure
     2100                 (input  true
     2101                 ) .
     2102             end.
     2103           end.
     2104         end.
     2105         else do:
     2106           if v-diasize-wndmax = true
     2107           then do:
     2108             run diasize_maximize in this-procedure
     2109               (input  true
     2110               ) .
     2111           end.
     2112         end.
     2113       end.
     2114     end.
     2115   end procedure.
     2116   procedure diasize_need-full-display :
     2117     define output parameter p-need-full-display as logical   no-undo .
     2118     do
     2119     on error undo, return error return-value
     2120     :
     2121       assign
     2122         p-need-full-display = v-diasize-need-full-display
     2123       .
     2124       assign
     2125         v-diasize-need-full-display = false
     2126       .
     2127     end.
     2128   end procedure.
     2129   procedure get-context :
     2130      define output parameter p-db-num as integer          no-undo.
     2131      define output parameter p-user-id as character        no-undo.
     2132      define variable v-login               as character    no-undo.
     2133      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2134      define buffer buf_user-login  for ub.user-login .
     2135      do
     2136      on error undo, return error
     2137      :
     2138            FIND FIRST buf_sys-ctrl no-lock.
     2139            ASSIGN
     2140               v-login = USERID("ub")
     2141               p-db-num = buf_sys-ctrl.db-num
     2142            .
     2143            FIND FIRST buf_user-login
     2144                 WHERE buf_user-login.db-num = p-db-num
     2145                   AND buf_user-login.user-login = v-login
     2146                 no-lock
     2147                 no-error
     2148                 .
     2149            IF AVAILABLE buf_user-login
     2150            THEN DO:
     2151               assign
     2152                  p-user-id = buf_user-login.user-id
     2153               .
     2154            END.
     2155      end.
     2156   end procedure.
     2157       run diasize_init in this-procedure .
     2158   MAIN-BLOCK:
     2159   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2160      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2161   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2162     run mainmenu_getcntxt in parparentproc
     2163       (output v-cntxt-db-num
     2164       ,output v-cntxt-userid
     2165       ,output v-cntxt-level
     2166       ,output v-cntxt-host-code-obj
     2167       ,output v-cntxt-obj-type
     2168       ,output v-cntxt-obj-code
     2169       ,output v-cntxt-db-num-obj
     2170       ,output v-cntxt-is-admin
     2171       ) .
     2172   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2173   ON TAB ANYWHERE
     2174   DO:
     2175   define variable ii as integer no-undo .
     2176   define variable fh as widget-handle no-undo .
     2177   define variable hh as widget-handle no-undo .
     2178   define variable v-next-widget-name as character no-undo .
     2179   if v-tab-order <> '' then do:
     2180     if self:type = "TOGGLE-BOX" then
     2181     self:BGCOLOR = ?.
     2182     assign
     2183     ii = lookup(self:name, v-tab-order).
     2184     assign
     2185     ii = ii + 1
     2186     v-next-widget-name = entry(ii, v-tab-order)
     2187     no-error .
     2188     if error-status:error then do:
     2189       assign
     2190       ii = 1
     2191       v-next-widget-name = entry( ii, v-tab-order)
     2192       .
     2193     end.
     2194     assign
     2195     fh = frame Dialog-Frame:first-child
     2196     hh = fh:first-child
     2197     .
     2198     do while valid-handle(hh):
     2199       if hh:name = v-next-widget-name then do:
     2200         if hh:sensitive  = yes
     2201         AND hh:visible = yes then do:
     2202           if hh:type = "TOGGLE-BOX":U then do:
     2203             assign
     2204             hh:BGcolor = 1
     2205             .
     2206           end.
     2207           APPLY "ENTRY" to hh.
     2208           return no-apply.
     2209         end.
     2210         else do:
     2211           APPLY "TAB" to hh.
     2212           return no-apply.
     2213         end.
     2214       end.
     2215       hh = hh:next-sibling.
     2216     end.
     2217   end.
     2218   END.
     2219   ON BACK-TAB ANYWHERE
     2220   DO:
     2221   define variable ii as integer no-undo .
     2222   define variable fh as widget-handle no-undo .
     2223   define variable hh as widget-handle no-undo .
     2224   define variable v-next-widget-name as character no-undo .
     2225   if v-tab-order <> '' then do:
     2226     assign
     2227     ii = lookup(self:name, v-tab-order).
     2228     .
     2229     assign
     2230     ii = (if ii = 1
     2231           then  num-entries(v-tab-order)
     2232           else ii - 1
     2233           )
     2234     v-next-widget-name = entry(ii, v-tab-order)
     2235     .
     2236     assign
     2237     fh = frame Dialog-Frame:first-child
     2238     hh = fh:first-child
     2239     .
     2240     do while valid-handle(hh):
     2241       if hh:name = v-next-widget-name then do:
     2242         if hh:sensitive  = yes
     2243         AND hh:visible = yes then do:
     2244           if hh:type = "TOGGLE-BOX":U then do:
     2245             assign
     2246             hh:BGcolor = 1
     2247             .
     2248           end.
     2249           APPLY "ENTRY" to hh.
     2250           return no-apply.
     2251         end.
     2252         else do:
     2253         APPLY "BACK-TAB" to hh.
     2254         return no-apply.
     2255         end.
     2256       end.
     2257       hh = hh:next-sibling.
     2258     end.
     2259     end.
     2260   END.
     2261   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2262   ON RETURN ANYWHERE
     2263   DO:
     2264   define variable ii as integer no-undo .
     2265   define variable fh as widget-handle no-undo .
     2266   define variable hh as widget-handle no-undo .
     2267   define variable v-next-widget-name as character no-undo .
     2268     if v-tab-order <> '' then do:
     2269       assign
     2270       ii = lookup(self:name, v-tab-order).
     2271       if ii = num-entries(v-tab-order) then do:
     2272           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     2273           return no-apply.
     2274       end.
     2275       if self:type <> "BUTTON" and
     2276         self:type <> "EDITOR"  then do:
     2277         run proc-move-forward in this-procedure .
     2278         return no-apply.
     2279       end.
     2280       if self:type = "BUTTON" then do:
     2281         APPLY "CHOOSE" to self.
     2282       end.
     2283       if self:type = "TOGGLE-BOX" then
     2284       self:BGCOLOR = ?.
     2285       assign
     2286       ii = ii + 1
     2287       v-next-widget-name = entry(ii, v-tab-order)
     2288       no-error .
     2289       if error-status:error then do:
     2290         assign
     2291         ii = 1
     2292         v-next-widget-name = entry( ii, v-tab-order)
     2293         .
     2294       end.
     2295       assign
     2296       fh = frame Dialog-Frame:first-child
     2297       hh = fh:first-child
     2298       .
     2299       do while valid-handle(hh):
     2300         if hh:name = v-next-widget-name then do:
     2301           if hh:sensitive  = yes
     2302           AND hh:visible = yes then do:
     2303             if hh:type = "TOGGLE-BOX":U then do:
     2304               assign
     2305               hh:BGcolor = 1
     2306               .
     2307             end.
     2308             APPLY "ENTRY" to hh.
     2309             return no-apply.
     2310           end.
     2311           else do:
     2312             APPLY "TAB" to hh.
     2313             return no-apply.
     2314           end.
     2315         end.
     2316         hh = hh:next-sibling.
     2317       end.
     2318     end.
     2319   END.
     2320   procedure proc-move-forward :
     2321   define variable ii as integer no-undo .
     2322   define variable fh as widget-handle no-undo .
     2323   define variable hh as widget-handle no-undo .
     2324   define variable v-next-widget-name as character no-undo .
     2325   do
     2326   on error undo, return error
     2327   :
     2328     if v-tab-order <> '' then do:
     2329       if self:type = "TOGGLE-BOX" then
     2330       self:BGCOLOR = ?.
     2331       assign
     2332       ii = lookup(self:name, v-tab-order).
     2333       assign
     2334       ii = ii + 1
     2335       v-next-widget-name = entry(ii, v-tab-order)
     2336       no-error .
     2337       if error-status:error then do:
     2338         assign
     2339         ii = 1
     2340         v-next-widget-name = entry( ii, v-tab-order)
     2341         .
     2342       end.
     2343       assign
     2344       fh = frame Dialog-Frame:first-child
     2345       hh = fh:first-child
     2346       .
     2347       do while valid-handle(hh):
     2348         if hh:name = v-next-widget-name then do:
     2349           if hh:sensitive  = yes
     2350           AND hh:visible = yes then do:
     2351             if hh:type = "TOGGLE-BOX":U then do:
     2352               assign
     2353               hh:BGcolor = 1
     2354               .
     2355             end.
     2356             APPLY "ENTRY" to hh.
     2357             return.
     2358           end.
     2359           else do:
     2360             assign
     2361             ii = ii + 1
     2362             v-next-widget-name = entry(ii, v-tab-order)
     2363             no-error .
     2364             if error-status:error then do:
     2365               assign
     2366               ii = 1
     2367               v-next-widget-name = entry( ii, v-tab-order)
     2368               .
     2369             end.
     2370           end.
     2371         end.
     2372         hh = hh:next-sibling.
     2373       end.
     2374     end.
     2375   end.
     2376   end procedure.
     2377   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2378   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2379     (input  p-obj-type
     2380     ,input  p-obj-code
     2381     ,output v-obj-db-num
     2382     )  .
     2383     IF p-mode <> 'ПРОСМОТР':U
     2384     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     2385         MESSAGE
     2386         vss-workfile vss-revision vss-description skip
     2387         "Неверное значение параметра p-mode" p-mode
     2388         VIEW-AS ALERT-BOX ERROR.
     2389         UNDO, RETURN ERROR.
     2390     END.
     2391     IF p-obj-type <> 'маг':U
     2392     and p-obj-type <> 'орг':U
     2393     and p-obj-type <> '':U
     2394     THEN DO:
     2395         MESSAGE
     2396         vss-workfile vss-revision vss-description skip
     2397         "Неверное значение параметра p-obj-type" p-obj-type
     2398         VIEW-AS ALERT-BOX ERROR.
     2399         UNDO, RETURN ERROR.
     2400     END.
     2401     if p-obj-type = 'маг':U then do:
     2402       FIND FIRST X_shop NO-LOCK WHERE X_shop.obj-code = p-obj-code NO-ERROR.
     2403       IF NOT AVAILABLE X_shop THEN DO:
     2404           MESSAGE
     2405           vss-workfile vss-revision vss-description skip
     2406           "Неверное значение параметра p-obj-code" p-obj-code
     2407           VIEW-AS ALERT-BOX ERROR.
     2408           UNDO, RETURN ERROR.
     2409       END.
     2410   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2411   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2412     (input  'маг':U
     2413     ,input  p-obj-code
     2414     ,output v-db-num
     2415     )  .
     2416       IF v-db-num <> v-cntxt-db-num
     2417       AND v-cntxt-db-num <> 0
     2418       and p-mode <> 'ПРОСМОТР':U
     2419       THEN DO:
     2420           MESSAGE
     2421           "Нельзя менять параметры магазина в чужой БД" skip
     2422           "магазин принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     2423           VIEW-AS ALERT-BOX ERROR.
     2424           UNDO, RETURN ERROR.
     2425       END.
     2426     end.
     2427     if p-obj-type = 'орг':U then do:
     2428       FIND FIRST X_sysconf NO-LOCK WHERE X_sysconf.host-code = p-obj-code NO-ERROR.
     2429       IF NOT AVAILABLE X_sysconf THEN DO:
     2430           MESSAGE
     2431           vss-workfile vss-revision vss-description skip
     2432           "Неверное значение параметра p-obj-code" p-obj-code
     2433           VIEW-AS ALERT-BOX ERROR.
     2434           UNDO, RETURN ERROR.
     2435       END.
     2436       if v-cntxt-db-num <> 0
     2437       and p-mode <> 'ПРОСМОТР':U
     2438       then do:
     2439           MESSAGE
     2440           "Нельзя менять параметры ФИРМЫ в УБД" skip
     2441           VIEW-AS ALERT-BOX ERROR.
     2442           UNDO, RETURN ERROR.
     2443       end.
     2444     end.
     2445     if p-obj-type = '':U then do:
     2446       if v-cntxt-db-num <> 0
     2447       and p-mode <> 'ПРОСМОТР':U
     2448       then do:
     2449           MESSAGE
     2450           "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" skip
     2451           VIEW-AS ALERT-BOX ERROR.
     2452           UNDO, RETURN ERROR.
     2453       end.
     2454     end.
     2455     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     2456       FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
     2457                 LOCKED_thbj-attr.obj-type = p-obj-type
     2458           AND   LOCKED_thbj-attr.obj-code = p-obj-code
     2459           AND   LOCKED_thbj-attr.upper-prop-code = 'scale-inf':U
     2460           AND   locked_thbj-attr.prop-code = '':U NO-WAIT NO-ERROR.
     2461        if locked locked_thbj-attr then do:
     2462           message
     2463           vss-workfile vss-revision vss-description skip
     2464            "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
     2465           view-as alert-box error .
     2466           undo, return error.
     2467         end.
     2468     END.
     2469     ELSE DO:
     2470         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
     2471             LOCKED_thbj-attr.obj-type = p-obj-type
     2472       AND   LOCKED_thbj-attr.obj-code = p-obj-code
     2473       AND   LOCKED_thbj-attr.upper-prop-code = 'scale-inf':U
     2474       and   locked_thbj-attr.prop-code = '':U NO-ERROR.
     2475     END.
     2476     if not available locked_thbj-attr then do:
     2477       ASSIGN
     2478       v-to-create  = YES.
     2479       message
     2480       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     2481                   chr(10))
     2482       view-as alert-box WARNING.
     2483     end.
     2484     RUN FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     2485     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     2486     RUN Myenable.
     2487     WAIT-FOR GO OF FRAME Dialog-Frame.
     2488   END.
     2489   RUN disable_UI.
     2490   PROCEDURE disable_UI :
     2491     HIDE FRAME Dialog-Frame.
     2492   END PROCEDURE.
     2493   PROCEDURE enable_UI :
     2494     DISPLAY RS-sclin-ld EDITOR-1 mark-num l-scallist
     2495         WITH FRAME Dialog-Frame.
     2496     ENABLE B-exit b-quit RS-sclin-ld B-Help EDITOR-1 B-add B-del B-etc
     2497            BR-scales-type B-mark BR-scales mark-num l-scallist
     2498         WITH FRAME Dialog-Frame.
     2499     VIEW FRAME Dialog-Frame.
     2500   END PROCEDURE.
     2501   PROCEDURE fill-widgets :
     2502   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     2503   DEFINE VARIABLE jj AS INTEGER NO-UNDO.
     2504   DEFINE VARIABLE v-entry AS CHARACTER NO-UNDO.
     2505   DEFINE VARIABLE v-value AS CHARACTER NO-UNDO.
     2506   DEFINE VARIABLE v-scales AS CHARACTER NO-UNDO.
     2507   DEFINE VARIABLE v-scale-pr AS CHARACTER NO-UNDO.
     2508   define variable v-scale-pr-all as character no-undo .
     2509   DEFINE BUFFER buf_scales FOR ub.scales .
     2510   define variable v-param-type as character no-undo .
     2511   define variable v-param-value as character no-undo .
     2512   define variable v-value-character as character no-undo .
     2513   define variable v-value-date as date no-undo .
     2514   define variable v-value-decimal as decimal no-undo .
     2515   define variable v-value-integer as INTEGER no-undo .
     2516   define variable v-value-logical AS LOGICAL no-undo .
     2517   FOR EACH thbjattr_thbj-attr:
     2518     delete thbjattr_thbj-attr.
     2519   end.
     2520   FOR EACH temp-thbj-attr:
     2521     delete temp-thbj-attr.
     2522   end.
     2523   run adm/shattri.p (
     2524                 input "init":U
     2525               , input p-obj-type
     2526               , input p-obj-code
     2527               , input 'scale-inf':U
     2528               , input "":U
     2529               ,output v-value-character
     2530               ,output v-value-date
     2531               ,output v-value-decimal
     2532               ,output v-value-integer
     2533               ,output v-value-logical
     2534               ,output v-param-type
     2535               ,INPUT-OUTPUT TABLE-handle v-tth
     2536               ) no-error .
     2537   if error-status:error
     2538   and not available locked_thbj-attr then do:
     2539     message
     2540     "Не удалось получить начальные значения настроек" skip
     2541     error-status:get-message(1) return-value
     2542     view-as alert-box error .
     2543     undo, return error .
     2544   end.
     2545   FOR EACH tt-scales-type:
     2546     DELETE tt-scales-type.
     2547   END.
     2548   for each thbjattr_thbj-attr:
     2549     ASSIGN
     2550     v-entry = thbjattr_thbj-attr.prop-code
     2551     .
     2552     IF v-entry = 'scales-type':U THEN DO:
     2553       DO jj = 1 TO NUM-ENTRIES(thbjattr_thbj-attr.property-value-character):
     2554         ASSIGN
     2555         v-scales = ENTRY(jj, thbjattr_thbj-attr.property-value-character).
     2556         FIND FIRST tt-scales-type WHERE
     2557                     tt-scales-type.scales-type = v-scales NO-ERROR.
     2558         IF NOT AVAILABLE tt-scales-type THEN DO:
     2559             CREATE tt-scales-type.
     2560             ASSIGN
     2561             tt-scales-type.db-num = v-obj-db-num
     2562             tt-scales-type.scales-num = jj
     2563             tt-scales-type.scales-type =  v-scales
     2564             tt-scales-type.is-tiger = (if v-scales = "MIRA":U or v-scales = "TIGER":U or v-scales = "TIGER2" then yes else no)
     2565              .
     2566         END.
     2567       END.
     2568     END.
     2569     IF v-entry = 'scales-pr':U THEN DO:
     2570       v-scale-pr-all = thbjattr_thbj-attr.property-value-character.
     2571     END.
     2572     IF v-entry =  'scallist':U THEN DO:
     2573       v-num-list = "":U.
     2574       DO jj = 1 TO NUM-ENTRIES(thbjattr_thbj-attr.property-value-character):
     2575         FIND FIRST buf_scales WHERE
     2576                   buf_scales.db-num = v-obj-db-num
     2577               AND buf_scales.scales-num = integer(ENTRY(jj, thbjattr_thbj-attr.property-value-character)) NO-ERROR.
     2578         IF AVAILABLE buf_scales THEN DO:
     2579           ASSIGN
     2580           v-num-list = v-num-list + (IF v-num-list = "":U THEN "":U else chr(44)) + STRING(buf_scales.scales-num).
     2581         END.
     2582       END.
     2583     END.
     2584     if v-entry = 'noauto-scls':U then do:
     2585       v-noauto-scls = thbjattr_thbj-attr.property-value-logical.
     2586     end.
     2587     IF v-entry = 'sclin-ld':U THEN DO:
     2588       ASSIGN
     2589       rs-sclin-ld = thbjattr_thbj-attr.property-value-integer
     2590       rs-sclin-ld:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2591       .
     2592     end.
     2593     create temp-thbj-attr.
     2594     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     2595     DO jj = 1 TO NUM-ENTRIES(v-scale-pr-all):
     2596       ASSIGN
     2597       v-scale-pr = ENTRY(jj, v-scale-pr-all).
     2598       FIND FIRST tt-scales-type WHERE
     2599                   tt-scales-type.db-num = v-obj-db-num
     2600               AND tt-scales-type.scales-num = jj NO-ERROR.
     2601       IF AVAILABLE tt-scales-type THEN DO:
     2602         ASSIGN
     2603         tt-scales-type.scales-name =  v-scale-pr
     2604         .
     2605       END.
     2606     end.
     2607   END.
     2608   END PROCEDURE.
     2609   PROCEDURE MyEnable :
     2610   ASSIGN
     2611   FRAME Dialog-Frame:TITLE = FRAME Dialog-Frame:TITLE + (if p-obj-type = 'орг':U then " фирма" else " маг") + STRING(p-obj-code)
     2612   v-tab-order = "rs-sclin-ld,b-add,b-del,br-scales-type,b-mark,br-scales"
     2613   mark-num = string(NUM-ENTRIES(v-num-list))
     2614   .
     2615   DISPLAY
     2616   rs-sclin-ld
     2617   br-scales-type
     2618   br-scales
     2619   mark-num
     2620   l-scallist
     2621   WITH FRAME Dialog-Frame.
     2622   ENABLE
     2623   B-exit WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2624   B-etc when p-mode = 'ИЗМЕНЕНИЕ':U
     2625   b-quit
     2626   B-Help
     2627   br-scales-type
     2628   br-scales
     2629   rs-sclin-ld WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2630   b-mark WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2631   b-add WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2632   b-del WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2633   WITH FRAME Dialog-Frame.
     2634   VIEW FRAME Dialog-Frame.
     2635   IF p-mode = 'ПРОСМОТР':U THEN DO:
     2636       HIDE
     2637       b-exit
     2638       IN FRAME Dialog-Frame.
     2639       ASSIGN
     2640       b-quit:LABEL = "&Выход"
     2641       tt-scales-type.scales-name:READ-ONLY IN browse br-scales-type =  YES
     2642       .
     2643   END.
     2644   APPLY "value-changed" TO rs-sclin-ld.
     2645   RUN OpenBr-scales-type in this-procedure .
     2646   RUN OpenBR-scales in this-procedure .
     2647   END PROCEDURE.
     2648   PROCEDURE OpenBR-scales :
     2649   OPEN QUERY br-scales FOR EACH
     2650   X_scales.
     2651   END PROCEDURE.
     2652   PROCEDURE OpenBr-scales-type :
     2653   OPEN QUERY br-scales-type FOR EACH
     2654   tt-scales-type.
     2655   END PROCEDURE.
     2656   PROCEDURE proc-save :
     2657   define variable v-value-character as character no-undo .
     2658   define variable v-value-date as date no-undo .
     2659   define variable v-value-decimal as decimal no-undo .
     2660   define variable v-value-integer as INTEGER no-undo .
     2661   define variable v-value-logical AS LOGICAL no-undo .
     2662   define variable v-param-type as character no-undo .
     2663   define variable ii as integer no-undo .
     2664   define variable v-same as logical no-undo .
     2665   DEFINE BUFFER buf_scales FOR ub.scales.
     2666   define variable v-scales as character no-undo .
     2667   define variable v-scale-pr as character no-undo .
     2668   define variable v-scallist as character no-undo .
     2669   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     2670   assign
     2671   frame Dialog-Frame
     2672   rs-sclin-ld.
     2673   FOR EACH tt-scales-type NO-LOCK:
     2674    ASSIGN
     2675    v-scales = v-scales + (if v-scales = "":U then "":U else chr(44)) + tt-scales-type.scales-type
     2676    v-scale-pr = v-scale-pr + (if v-scale-pr = "":U then "":U else chr(44)) + tt-scales-type.scales-name
     2677    .
     2678   END.
     2679   FOR EACH buf_scales NO-LOCK where buf_scales.db-num = v-obj-db-num:
     2680     IF lookup(string(buf_scales.scales-num), v-num-list) > 0  THEN DO:
     2681       ASSIGN
     2682       ii = ii + 1
     2683       v-scallist = v-scallist + (IF ii = 1 THEN "":U ELSE chr(44)) + string(buf_scales.scales-num).
     2684     END.
     2685   END.
     2686   if v-scallist = '' then do:
     2687     define variable choice as integer no-undo .
     2688     run gbl/d-askw.w (input "Уточнение"
     2689                           ,input  ("Вы не выбрали список весов для работы в магазине"  + chr(10) +
     2690                                  "Как предполагается использовать весы данной БД в данном магазине")
     2691                           ,input "|"
     2692                           ,input "Все весы БД|Нет весов|Отменить"
     2693                           ,input "Использовать все веcы текущей БД|Не использовать весы ВООБЩЕ|Отменить"
     2694                           ,input 1
     2695                           ,input 3
     2696                           ,output choice) no-error.
     2697     if choice = 3 then do:
     2698       undo, return error.
     2699     end.
     2700     if choice = 2 then do:
     2701       v-scallist = "-".
     2702     end.
     2703   end.
     2704   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'scales-type':U.
     2705   assign
     2706   thbjattr_thbj-attr.property-value-character = v-scales
     2707   .
     2708   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'scales-pr':U.
     2709   assign
     2710   thbjattr_thbj-attr.property-value-character = v-scale-pr
     2711   .
     2712   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'scallist':U.
     2713   assign
     2714   thbjattr_thbj-attr.property-value-character = v-scallist
     2715   .
     2716   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'noauto-scls':U.
     2717   assign
     2718   thbjattr_thbj-attr.property-value-logical = v-noauto-scls
     2719   .
     2720   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'sclin-ld':U.
     2721   assign
     2722   thbjattr_thbj-attr.property-value-integer = RS-sclin-ld
     2723   .
     2724   v-same = yes.
     2725   for each thbjattr_thbj-attr,
     2726       first temp-thbj-attr where
     2727             temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     2728         and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     2729         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     2730         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code:
     2731      buffer-compare
     2732      thbjattr_thbj-attr
     2733      to temp-thbj-attr
     2734      save result in v-same.
     2735      if not v-same then leave.
     2736   end.
     2737   v-same = no.
     2738   IF v-same  and not v-to-create THEN RETURN.
     2739   run adm/shattri.p (
     2740                 input "check":U
     2741               , input p-obj-type
     2742               , input p-obj-code
     2743               , input 'scale-inf':U
     2744               , INPUT '':U
     2745                , output v-value-character
     2746                , output v-value-date
     2747                , output v-value-decimal
     2748                , output v-value-integer
     2749                , output v-value-logical
     2750                , output v-param-type
     2751                , input-output TABLE-handle v-tth
     2752                ) no-error .
     2753   if error-status:error then do:
     2754     message
     2755     "Некорректное значение ПАРАМЕТРОВ" skip
     2756     error-status:get-message(1) skip
     2757     return-value
     2758     view-as alert-box error .
     2759     undo, return error .
     2760   end.
     2761   do TRANSACTION
     2762   on error undo, return error return-value
     2763   :
     2764     RUN thbjattr_set-section IN THIS-PROCEDURE (
     2765          input p-obj-type
     2766         ,input p-obj-code
     2767         ,input 'scale-inf':U
     2768         ,INPUT table thbjattr_thbj-attr
     2769     ) NO-ERROR.
     2770     IF ERROR-STATUS:error THEN do:
     2771       MESSAGE ERROR-STATUS:get-message(1)  SKIP
     2772       RETURN-VALUE
     2773       VIEW-AS ALERT-BOX.
     2774       UNDO, RETURN ERROR.
     2775     END.
     2776   end.
     2777   END PROCEDURE.
     2778   FUNCTION mark-string RETURNS CHARACTER
     2779     ( input p-scales-num as integer, input p-list as character ) :
     2780   if lookup(string(p-scales-num), p-list) > 0 then return "*".
     2781     RETURN "".
     2782   END FUNCTION.
