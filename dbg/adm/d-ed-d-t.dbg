        1   define input-output parameter p-date as date    no-undo .
        2   define input-output parameter p-time as integer no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Задание и(или) редактирование даты и времени".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   procedure proc-alt-shift-f2:
       64     if not ibs.th.gbl.gbl-var:rcode
       65   then
       66     run gbl\inidebug.p .
       67   end.
       68   procedure proc-alt-shift-f3:
       69     run gbl/prvssinf.p
       70       ( input this-procedure
       71       ) .
       72   end.
       73   define variable v-inform-launched as logical no-undo initial false .
       74   procedure proc-alt-shift-f4:
       75     define variable v-action as character no-undo .
       76     if v-inform-launched = false then do:
       77       assign
       78         v-inform-launched = true
       79       .
       80       run gbl/d-inform.w
       81         (  input self
       82         ,  input this-procedure
       83         , output v-action
       84         ) no-error .
       85       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       86       assign
       87         v-inform-launched = false
       88       .
       89     end.
       90   end.
       91   procedure proc-alt-f1:
       92     run gbl/corrhelp.p
       93       (input this-procedure
       94       ) .
       95   end .
       96   on alt-shift-f2 anywhere do:
       97     run proc-alt-shift-f2.
       98   end.
       99   on alt-shift-f3 anywhere do:
      100     run proc-alt-shift-f3 in this-procedure .
      101   end.
      102   on alt-shift-f4 anywhere do:
      103     run proc-alt-shift-f4 in this-procedure.
      104   end.
      105   on alt-f1 anywhere do:
      106     run proc-alt-f1 in this-procedure .
      107   end.
      108   DEFINE BUTTON b-exit AUTO-GO
      109        LABEL "&Ввод"
      110        SIZE 10 BY 1
      111        BGCOLOR 8 .
      112   DEFINE BUTTON b-help
      113        LABEL "Помо&щь"
      114        SIZE 10 BY 1
      115        BGCOLOR 8 .
      116   DEFINE BUTTON b-quit AUTO-END-KEY
      117        LABEL "&Отмена"
      118        SIZE 10 BY 1
      119        BGCOLOR 8 .
      120   DEFINE VARIABLE f-date AS DATE FORMAT "99/99/9999":U
      121        LABEL "Дата"
      122        VIEW-AS FILL-IN
      123        SIZE 11 BY 1 TOOLTIP "Дата" NO-UNDO.
      124   DEFINE VARIABLE f-hour AS INTEGER FORMAT "99":U INITIAL 0
      125        LABEL "Время"
      126        VIEW-AS FILL-IN
      127        SIZE 3.25 BY 1 TOOLTIP "Часы" NO-UNDO.
      128   DEFINE VARIABLE f-minute AS INTEGER FORMAT "99":U INITIAL 0
      129        VIEW-AS FILL-IN
      130        SIZE 3.25 BY 1 TOOLTIP "Минуты" NO-UNDO.
      131   DEFINE VARIABLE f-sec AS INTEGER FORMAT "99":U INITIAL 0
      132        VIEW-AS FILL-IN
      133        SIZE 3 BY 1 TOOLTIP "Секунды" NO-UNDO.
      134   DEFINE FRAME d-ed-d-t
      135        b-exit AT ROW 1.17 COL 2
      136        b-quit AT ROW 1.17 COL 12
      137        b-help AT ROW 1.17 COL 32
      138        f-date AT ROW 3 COL 7 COLON-ALIGNED
      139        f-hour AT ROW 3 COL 27.75 COLON-ALIGNED
      140        f-minute AT ROW 3 COL 30.75 COLON-ALIGNED NO-LABEL
      141        f-sec AT ROW 3 COL 33.75 COLON-ALIGNED NO-LABEL
      142        SPACE(4.24) SKIP(0.78)
      143       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      144            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      145            TITLE "Задайте дату и время"
      146            CANCEL-BUTTON b-quit.
      147   ASSIGN
      148          FRAME d-ed-d-t:SCROLLABLE       = FALSE.
      149   ON WINDOW-CLOSE OF FRAME d-ed-d-t
      150   DO:
      151     APPLY "END-ERROR":U TO SELF.
      152   END.
      153   ON CHOOSE OF b-exit IN FRAME d-ed-d-t
      154   DO:
      155     define variable v-time as integer no-undo .
      156     assign
      157       f-hour
      158       f-minute
      159       f-sec
      160       f-date
      161     .
      162     if f-hour > 23
      163       or f-hour < 0
      164     then do:
      165       message "Часы могут быть в пределах от 0 до 23 !" view-as alert-box error.
      166       apply "entry" to f-hour in frame d-ed-d-t.
      167       return no-apply.
      168     end.
      169     if f-minute > 59
      170       or f-minute < 0
      171     then do:
      172       message "Минуты могут быть в пределах от 0 до 59 !" view-as alert-box error.
      173       apply "entry" to f-minute in frame d-ed-d-t.
      174       return no-apply.
      175     end.
      176     if f-sec > 59
      177       or f-sec < 0
      178     then do:
      179       message "Секунды могут быть в пределах от 0 до 59 !" view-as alert-box error.
      180       apply "entry" to f-sec in frame d-ed-d-t.
      181       return no-apply.
      182     end.
      183     assign
      184       p-date = f-date
      185       p-time = f-hour * 3600 + f-minute * 60 + f-sec
      186     .
      187   END.
      188   ON CHOOSE OF b-quit IN FRAME d-ed-d-t
      189   DO:
      190     assign
      191       p-date = ?
      192       p-time = ?
      193     .
      194   END.
      195   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      196   on help of frame d-ed-d-t
      197   do:
      198     run gbl/app_help.p
      199       (input this-procedure :file-name
      200       ,input ''
      201       ,input ?
      202       ) no-error.
      203     if error-status :error then do:
      204       message
      205         "Ошибка при вызове помощи"
      206         error-status :get-message(1)
      207         view-as alert-box .
      208     end.
      209   end.
      210   run minbtn-set in this-procedure .
      211   on choose of b-help in frame d-ed-d-t
      212   do:
      213     apply "help":u to frame d-ed-d-t .
      214   end.
      215   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      216   procedure minbtn-set :
      217       do
      218           on error undo, return error return-value
      219           :
      220           define variable ii              as integer       no-undo .
      221           define variable fh              as widget-handle no-undo .
      222           define variable hh              as widget-handle no-undo .
      223           define variable v-h             as handle        extent 4 no-undo .
      224           define variable v-name-button   as character     no-undo .
      225           define variable v-help-old-x    as decimal       no-undo .
      226           define variable v-help-old-y    as decimal       no-undo .
      227           define variable v-help-old-size as decimal       no-undo .
      228           define variable v-frame-width   as decimal       no-undo .
      229           define variable jj              as integer       no-undo .
      230           do
      231               on error undo, return error
      232               :
      233               assign
      234                   v-frame-width = frame d-ed-d-t:width - 0.3
      235                   fh            = frame d-ed-d-t:first-child
      236                   hh            = fh:first-child
      237                   ii            = 1
      238                   .
      239               do while valid-handle(hh):
      240                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      241                   do:
      242                       case lc(hh:name) :
      243                           when "b-help" then
      244                               do:
      245                                   hh:load-image-up("cmp/b-help.bmp":u) .
      246                                   hh:load-image-down("cmp/b-help.bmp":u) .
      247                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      248                                   hh:TOOLTIP = "Помощь" .
      249                                   v-help-old-x = hh:column .
      250                                   v-help-old-y = hh:row    .
      251                                   v-help-old-size = hh:width .
      252                                   hh:width-chars = 2.5 .
      253                               end.
      254                           when "b-print" then
      255                               do:
      256                                   hh:load-image("cmp/b-print.bmp":u) .
      257                                   hh:TOOLTIP = "Печать" .
      258                                   v-h[ii] = hh:handle .
      259                                   ii = ii + 1 .
      260                                   hh:width-chars = 3 .
      261                               end.
      262                           when "b-history" or
      263                           when "b-hist" then
      264                               do:
      265                                   hh:load-image("cmp/b-hist.bmp":u) .
      266                                   hh:TOOLTIP = "История" .
      267                                   v-h[ii] = hh:handle .
      268                                   ii = ii + 1 .
      269                                   hh:width-chars = 3 .
      270                               end.
      271                           when "b-sch" then
      272                               do:
      273                                   hh:load-image("cmp/b-sch.bmp":u) .
      274                                   hh:TOOLTIP = "Установка Фильтра" .
      275                                   v-h[ii] = hh:handle .
      276                                   ii = ii + 1 .
      277                                   hh:width-chars = 3 .
      278                               end.
      279                           when "b-hist-user" then
      280                               do:
      281                                   hh:load-image("cmp/b-hist.bmp":u) .
      282                                   hh:TOOLTIP = "История пользователя" .
      283                                   ii = ii + 1 .
      284                               end.
      285                       end case.
      286                   end.
      287                   hh = hh:next-sibling.
      288               end.
      289               b-help:column = v-frame-width - b-help:width-chars.
      290               jj = 0.
      291               repeat ii = 4 to 1 by -1 :
      292                   if valid-handle (v-h[ii] ) then
      293                   do:
      294                       jj  = jj + 1 .
      295                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      296                       v-h[ii]:row    = v-help-old-y .
      297                   end.
      298               end.
      299           end.
      300       end.
      301   end procedure.
      302   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      303   on ' ' of f-date in frame d-ed-d-t
      304   do:
      305     if (can-query (self, "sensitive")
      306        and
      307        self :sensitive = true
      308        )
      309     or (can-query (self, "read-only")
      310        and
      311        self :read-only = false
      312        )
      313     then do:
      314       assign
      315         self :screen-value = ?
      316       .
      317     end.
      318     return no-apply.
      319   end.
      320   on delete-character of f-date in frame d-ed-d-t
      321   do:
      322     if (can-query (self, "sensitive")
      323        and
      324        self :sensitive = true
      325        )
      326     or (can-query (self, "read-only")
      327        and
      328        self :read-only = false
      329        )
      330     then do:
      331       assign
      332         self :screen-value = ?
      333       .
      334     end.
      335     return no-apply.
      336   end.
      337   on ctrl-d of f-date in frame d-ed-d-t
      338   do:
      339     define variable v-curr-sv-date as date no-undo .
      340     if (can-query (self, "sensitive")
      341        and
      342        self :sensitive = true
      343        )
      344     or (can-query (self, "read-only")
      345        and
      346        self :read-only = false
      347        )
      348     then do:
      349       if self :handle <> focus :handle
      350       then do:
      351         apply "entry":u to self .
      352       end.
      353       run gbl/getcurdt.p
      354         (output v-curr-sv-date
      355         ) .
      356       assign
      357         self :screen-value = string(v-curr-sv-date) .
      358       .
      359     end.
      360     return no-apply.
      361   end.
      362   on ctrl-b of f-date in frame d-ed-d-t
      363   do:
      364     if (can-query (self, "sensitive")
      365        and
      366        self :sensitive = true
      367        )
      368     or (can-query (self, "read-only")
      369        and
      370        self :read-only = false
      371        )
      372     then do:
      373       if self :handle <> focus :handle
      374       then do:
      375         apply "entry":u to self .
      376       end.
      377       define variable v-curr-sv-date as date no-undo .
      378       define variable v-new-sv-date  as date no-undo .
      379       assign
      380         v-curr-sv-date = date(self :screen-value) no-error
      381       .
      382       if v-curr-sv-date = ?
      383       then do:
      384         run gbl/getcurdt.p
      385           (output v-curr-sv-date
      386           ) .
      387       end.
      388       if v-curr-sv-date <> ?
      389       then do:
      390         assign
      391           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      392         .
      393         assign
      394           self :screen-value = string(v-new-sv-date) .
      395         .
      396       end.
      397     end.
      398     return no-apply .
      399   end.
      400   on ctrl-e of f-date in frame d-ed-d-t
      401   do:
      402     if (can-query (self, "sensitive")
      403        and
      404        self :sensitive = true
      405        )
      406     or (can-query (self, "read-only")
      407        and
      408        self :read-only = false
      409        )
      410     then do:
      411       if self :handle <> focus :handle
      412       then do:
      413         apply "entry":u to self .
      414       end.
      415       define variable v-curr-sv-date as date no-undo .
      416       define variable v-new-sv-date  as date no-undo .
      417       assign
      418         v-curr-sv-date = date(self :screen-value) no-error
      419       .
      420       if v-curr-sv-date = ?
      421       then do:
      422         run gbl/getcurdt.p
      423           (output v-curr-sv-date
      424           ) .
      425       end.
      426       if v-curr-sv-date <> ?
      427       then do:
      428         run gbl/lastdate.p
      429           (input  v-curr-sv-date
      430           ,output v-new-sv-date
      431           ).
      432         assign
      433           self :screen-value = string(v-new-sv-date) .
      434         .
      435       end.
      436     end.
      437     return no-apply .
      438   end.
      439   on ctrl-f of f-date in frame d-ed-d-t
      440   do:
      441     if (can-query (self, "sensitive")
      442        and
      443        self :sensitive = true
      444        )
      445     or (can-query (self, "read-only")
      446        and
      447        self :read-only = false
      448        )
      449     then do:
      450       if self :handle <> focus :handle
      451       then do:
      452         apply "entry":u to self .
      453       end.
      454       define variable v-ok            as logical   no-undo .
      455       define variable v-curr-sv-date  as date      no-undo .
      456       define variable v-description   as character no-undo .
      457       assign
      458         v-curr-sv-date = date(self :screen-value) no-error
      459       .
      460       if v-curr-sv-date = ?
      461       then do:
      462         run gbl/getcurdt.p
      463           (output v-curr-sv-date
      464           ) .
      465       end.
      466       if v-curr-sv-date <> ?
      467       then do:
      468         run gbl/d-inpday.w
      469           (input ?
      470           ,input "Выбор даты"
      471           ,input v-description
      472           ,input ""
      473           ,input-output v-curr-sv-date
      474           ,output v-ok
      475           ).
      476         if v-ok = true
      477         then do:
      478           assign
      479             self :screen-value = string(v-curr-sv-date) .
      480           .
      481         end.
      482       end.
      483     end.
      484     return no-apply .
      485   end.
      486     define MENU m-ed-date3
      487       MENU-ITEM m-ed-date3-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
      488       MENU-ITEM m-ed-date3-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
      489       MENU-ITEM m-ed-date3-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
      490       MENU-ITEM m-ed-date3-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
      491       .
      492     if f-date :POPUP-MENU in frame d-ed-d-t = ?
      493     then do:
      494       ASSIGN
      495         f-date :POPUP-MENU in frame d-ed-d-t = MENU m-ed-date3 :HANDLE
      496         f-date :MENU-MOUSE in frame d-ed-d-t = 3
      497       .
      498     end.
      499     define variable v-label-handle3 as handle no-undo .
      500     assign
      501       v-label-handle3 = f-date :side-label-handle in frame d-ed-d-t
      502     .
      503     if valid-handle (v-label-handle3)
      504     then do:
      505       if v-label-handle3 :tooltip = ""
      506       or v-label-handle3 :tooltip = ?
      507       then do:
      508         assign
      509           v-label-handle3 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
      510         .
      511       end.
      512     end.
      513     ON CHOOSE OF MENU-ITEM m-ed-date3-1 in menu m-ed-date3 DO:
      514       apply "ctrl-b":U to f-date in frame d-ed-d-t .
      515     END.
      516     ON CHOOSE OF MENU-ITEM m-ed-date3-2 in menu m-ed-date3 DO:
      517       apply "ctrl-d":U to f-date in frame d-ed-d-t .
      518     END.
      519     ON CHOOSE OF MENU-ITEM m-ed-date3-3 in menu m-ed-date3 DO:
      520       apply "ctrl-e":U to f-date in frame d-ed-d-t .
      521     END.
      522     ON CHOOSE OF MENU-ITEM m-ed-date3-4 in menu m-ed-date3 DO:
      523       apply "ctrl-f":U to f-date in frame d-ed-d-t .
      524     END.
      525   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-ed-d-t:PARENT eq ?
      526   THEN FRAME d-ed-d-t:PARENT = ACTIVE-WINDOW.
      527   MAIN-BLOCK:
      528   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      529      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      530     define variable v-time-str as character no-undo .
      531     assign
      532       v-time-str = string( p-time, "HH:MM:SS":U )
      533       f-hour   = integer( entry( 1, v-time-str, ":":U ) )
      534       f-minute = integer( entry( 2, v-time-str, ":":U ) )
      535       f-sec    = integer( entry( 3, v-time-str, ":":U ) )
      536       f-date   = p-date
      537     .
      538     RUN enable_UI.
      539     WAIT-FOR GO OF FRAME d-ed-d-t.
      540   END.
      541   RUN disable_UI.
      542   PROCEDURE disable_UI :
      543     HIDE FRAME d-ed-d-t.
      544   END PROCEDURE.
      545   PROCEDURE enable_UI :
      546     DISPLAY f-date f-hour f-minute f-sec
      547         WITH FRAME d-ed-d-t.
      548     ENABLE b-exit b-quit b-help f-date f-hour f-minute f-sec
      549         WITH FRAME d-ed-d-t.
      550   END PROCEDURE.
