        1   block-level on error undo, throw.
        2   define input parameter        p-mode as character no-undo .
        3   define input parameter        p-silent as logical no-undo .
        4   define input-output parameter p-rec  as recid     no-undo .
        5   define input parameter        p-mode-type as character no-undo .
        6   define input parameter        p-mode-id as character no-undo .
        7   define input parameter        p-prev-mode-id as character no-undo .
        8   define input parameter        p-codex-id as integer no-undo .
        9   define input parameter        p-ruleset-id as integer no-undo .
       10   define input parameter        p-mode-name as character no-undo .
       11   define input parameter        p-des as character no-undo .
       12   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       13   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       14   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile: wi-mode1.p $":U .
       16   define variable vss-archive     as character no-undo init "$Archive: adm/wi-mode1.p $":U .
       17   define variable vss-description as character no-undo init "Сохранение режима работы".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define   shared variable g#auto as logical no-undo.
       79   define   shared variable g#news as logical no-undo.
       80   define   shared variable g#oxml as logical no-undo.
       81   define   shared variable g#esys as logical no-undo.
       82   define   shared variable g#news-source-db as integer no-undo.
       83   define   shared variable g#esys-source-esys as integer no-undo.
       84   define   shared variable g#db-num as integer   no-undo .
       85   define   shared variable g#userid as character no-undo .
       86   define   shared variable g#passwd as character no-undo .
       87   define variable v-mess as character no-undo .
       88   define variable v-entry as character no-undo .
       89   define variable v-codex-id as integer no-undo .
       90   define buffer buf_wi-mode for ub.wi-mode.
       91   define buffer buf_ruleset for ub.ruleset.
       92   if p-mode <> 'ДОБАВЛЕНИЕ':U
       93   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
       94     message vss-workfile vss-revision vss-description skip
       95             "Неверный параметр p-mode - " p-mode
       96     view-as alert-box error .
       97     return error '':u.
       98   end.
       99   if g#db-num <> 0 then do:
      100     message vss-workfile vss-revision vss-description skip
      101             "Запрещено вызывать процедуру в УБД"
      102     view-as alert-box error .
      103     return error '':u.
      104   end.
      105   _main:
      106   do for buf_wi-mode
      107   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      108   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
      109   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
      110   :
      111     if p-prev-mode-id > '' then do:
      112       find first buf_wi-mode no-lock where
      113                 buf_wi-mode.mode-type = p-mode-type
      114             and buf_wi-mode.mode-id = p-prev-mode-id no-error.
      115       if not available buf_wi-mode then do:
      116         assign
      117         v-mess = "Предыдущий режим - не существует режима c таким типом и id".
      118         run err-mess in this-procedure ( input-output v-mess).
      119         return error (if p-silent = yes then v-mess else 'prev-mode-id':U).
      120       end.
      121     end.
      122     if p-codex-id > 0 then do:
      123       find first buf_ruleset no-lock where
      124                 buf_ruleset.codex_id = p-codex-id
      125             and buf_ruleset.ruleset_id = p-ruleset-id no-error.
      126       if not available buf_ruleset then do:
      127         assign
      128         v-mess = substitute("Не найден кодекс/набор правил &1/&2", p-codex-id, p-ruleset-id).
      129         run err-mess in this-procedure ( input-output v-mess).
      130         return error (if p-silent = yes then v-mess else 'codex-id':U).
      131       end.
      132       case p-mode-type:
      133         when 'cd-IBS-TH':U then do:
      134           ASSIGN
      135           v-codex-id = 19.
      136         END.
      137         OTHERWISE DO:
      138           MESSAGE
      139           substitute("Неивестен кодекс для режима работы с типом &1", p-mode-type)
      140           VIEW-AS ALERT-BOX ERROR.
      141           UNDO, RETURN NO-APPLY.
      142         end.
      143       end case.
      144       if v-codex-id <> p-codex-id then do:
      145         assign
      146         v-mess = substitute("Неверное значение p-codex-id=&1 для типа режима &2", p-codex-id, p-mode-type).
      147         run err-mess in this-procedure ( input-output v-mess).
      148         return error (if p-silent = yes then v-mess else 'codex-id':U).
      149       end.
      150     end.
      151     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      152       find first buf_wi-mode no-lock where
      153                 buf_wi-mode.mode-type = p-mode-type
      154             and buf_wi-mode.mode-id = p-mode-id no-error.
      155       if lookup(p-mode-type, 'cd-IBS-TH':U) = 0 then do:
      156         assign
      157         v-mess = substitute("Неверный тип режима &1", p-mode-type).
      158         run err-mess in this-procedure ( input-output v-mess).
      159         return error (if p-silent = yes then v-mess else '':U).
      160       end.
      161       if available buf_wi-mode then do:
      162         assign
      163         v-mess = "Уже существует режим c таким типом и ID".
      164         run err-mess in this-procedure ( input-output v-mess).
      165         return error (if p-silent = yes then v-mess else '':U).
      166       end.
      167       create buf_wi-mode.
      168       assign
      169       buf_wi-mode.mode-type = p-mode-type
      170       buf_wi-mode.mode-id = p-mode-id
      171       .
      172     end.
      173     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      174       find first buf_wi-mode exclusive-lock where
      175                 recid(buf_wi-mode) = p-rec .
      176       if buf_wi-mode.mode-type <> p-mode-type
      177       or buf_wi-mode.mode-id <> p-mode-id
      178       then do:
      179         assign
      180         v-mess = substitute("Для уже существующего wi-mode невозможно изменить тип и ID&1" +
      181                                 "старые значения типа и ID: &2 и &3"
      182                                 , chr(10)
      183                                 , buf_wi-mode.mode-type
      184                                 , buf_wi-mode.mode-id)
      185         .
      186         run err-mess in this-procedure ( input-output v-mess).
      187         return error (if p-silent = yes then v-mess else '':U).
      188       end.
      189     end.
      190     assign
      191     buf_wi-mode.mode-name = p-mode-name
      192     buf_wi-mode.prev-mode-id = p-prev-mode-id
      193     buf_wi-mode.codex_id = p-codex-id
      194     buf_wi-mode.ruleset_id = p-ruleset-id
      195     buf_wi-mode.des = p-des
      196     p-rec = recid(buf_wi-mode)
      197     .
      198   end.
      199   PROCEDURE err-mess:
      200     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      201     CASE p-silent:
      202       when yes then do:
      203         assign
      204         p-mess = substitute("Тип режима: &1 ID: &2: &3"
      205                            , p-mode-type
      206                            , p-mode-id
      207                            , p-mess)
      208         .
      209       end.
      210       when no then do:
      211         message
      212         p-mess
      213         view-as alert-box error .
      214       end.
      215     end.
      216   END PROCEDURE.
