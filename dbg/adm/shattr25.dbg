      616   procedure proc-alt-shift-f2:
      617     if not ibs.th.gbl.gbl-var:rcode
      618   then
      619     run gbl\inidebug.p .
      620   end.
      621   procedure proc-alt-shift-f3:
      622     run gbl/prvssinf.p
      623       ( input this-procedure
      624       ) .
      625   end.
      626   define variable v-inform-launched as logical no-undo initial false .
      627   procedure proc-alt-shift-f4:
      628     define variable v-action as character no-undo .
      629     if v-inform-launched = false then do:
      630       assign
      631         v-inform-launched = true
      632       .
      633       run gbl/d-inform.w
      634         (  input self
      635         ,  input this-procedure
      636         , output v-action
      637         ) no-error .
      638       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      639       assign
      640         v-inform-launched = false
      641       .
      642     end.
      643   end.
      644   procedure proc-alt-f1:
      645     run gbl/corrhelp.p
      646       (input this-procedure
      647       ) .
      648   end .
      649   on alt-shift-f2 anywhere do:
      650     run proc-alt-shift-f2.
      651   end.
      652   on alt-shift-f3 anywhere do:
      653     run proc-alt-shift-f3 in this-procedure .
      654   end.
      655   on alt-shift-f4 anywhere do:
      656     run proc-alt-shift-f4 in this-procedure.
      657   end.
      658   on alt-f1 anywhere do:
      659     run proc-alt-f1 in this-procedure .
      660   end.
      661   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      662     define variable v-cntxt-db-num        as integer   no-undo .
      663     define variable v-cntxt-userid        as character no-undo .
      664     define variable v-cntxt-level         as character no-undo .
      665     define variable v-cntxt-host-code-obj as integer   no-undo .
      666     define variable v-cntxt-obj-type      as character no-undo .
      667     define variable v-cntxt-obj-code      as integer   no-undo .
      668     define variable v-cntxt-db-num-obj    as integer   no-undo .
      669     define variable v-cntxt-is-admin      as logical   no-undo .
      670   DEFINE VARIABLE v-db-num LIKE ub.db.db-num NO-UNDO.
      671   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO.
      672   DEFINE VARIABLE v-to-create AS logical NO-UNDO.
      673   define buffer buf_wth-place   for ub.wth-place.
      674   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      675   define variable v-tth as handle no-undo .
      676   assign
      677   v-tth = buffer thbjattr_thbj-attr:table-handle .
      678   DEFINE BUTTON B-exit AUTO-GO
      679        LABEL "&Ввод"
      680        SIZE 10 BY 1
      681        BGCOLOR 8 .
      682   DEFINE BUTTON B-Help
      683        LABEL "Помо&щь"
      684        SIZE 3 BY 1
      685        BGCOLOR 8 .
      686   DEFINE BUTTON b-quit AUTO-END-KEY
      687        LABEL "&Отмена"
      688        SIZE 10 BY 1
      689        BGCOLOR 8 .
      690   DEFINE BUTTON B-wp
      691        IMAGE-UP FILE "btn-down-arrow":U
      692        IMAGE-DOWN FILE "btn-down-arrow":U
      693        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      694        LABEL ""
      695        SIZE 3 BY 1.
      696   DEFINE VARIABLE CB-rangerule AS INTEGER FORMAT "->,>>>,>>9" INITIAL 0
      697        LABEL "Правило  автоматического  установления  срока годности партий серийных МЦ"
      698        VIEW-AS COMBO-BOX INNER-LINES 7
      699        LIST-ITEM-PAIRS "Не выставлять",0,
      700                        "Следующий месяц",1,
      701                        "Текущий месяц",2,
      702                        "3 месяца",3,
      703                        "1 год",4
      704        DROP-DOWN-LIST
      705        SIZE 18.8 BY 1
      706        BGCOLOR 15 FGCOLOR 0 .
      707   DEFINE VARIABLE f-inwpcode AS INTEGER FORMAT ">,>>>,>>9":U INITIAL 0
      708        VIEW-AS FILL-IN
      709        SIZE 8 BY 1 NO-UNDO.
      710   DEFINE VARIABLE f-numsfact AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      711        LABEL "Последий номер счета-фактуры"
      712        VIEW-AS FILL-IN
      713        SIZE 18.5 BY 1 NO-UNDO.
      714   DEFINE VARIABLE f-stfactpref AS CHARACTER FORMAT "X(256)":U
      715        LABEL "Префикс номера счета-фактуры"
      716        VIEW-AS FILL-IN
      717        SIZE 14 BY 1 NO-UNDO.
      718   DEFINE VARIABLE t-clsfact AS LOGICAL INITIAL no
      719        LABEL "Закрывать документы при формировании по чекам МЦ"
      720        VIEW-AS TOGGLE-BOX
      721        SIZE 55.5 BY 1 NO-UNDO.
      722   DEFINE VARIABLE t-inobjauto AS LOGICAL INITIAL no
      723        LABEL "При закрытии продажи автоматически формировать документ перемещения в"
      724        VIEW-AS TOGGLE-BOX
      725        SIZE 71.5 BY 1 NO-UNDO.
      726   DEFINE VARIABLE t-prsdoc AS LOGICAL INITIAL no
      727        LABEL "Проверка на наличие физ. лиц в документах МЦ"
      728        VIEW-AS TOGGLE-BOX
      729        SIZE 50.5 BY .83 NO-UNDO.
      730   DEFINE FRAME Dialog-Frame
      731        B-exit AT ROW 1 COL 1
      732        b-quit AT ROW 1 COL 11
      733        B-Help AT ROW 1 COL 95
      734        f-stfactpref AT ROW 2.5 COL 30.1 COLON-ALIGNED WIDGET-ID 2
      735        f-numsfact AT ROW 2.5 COL 75 COLON-ALIGNED WIDGET-ID 6
      736        CB-rangerule AT ROW 3.77 COL 75 COLON-ALIGNED
      737        t-clsfact AT ROW 5 COL 2.5
      738        t-inobjauto AT ROW 6.27 COL 2.5
      739        f-inwpcode AT ROW 6.27 COL 72.6 COLON-ALIGNED NO-LABEL
      740        B-wp AT ROW 6.27 COL 83.4 WIDGET-ID 4
      741        t-prsdoc AT ROW 7.5 COL 2.5 WIDGET-ID 8
      742        SPACE(46.24) SKIP(0.51)
      743       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      744            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      745            TITLE "Опции работы с документами МЦ"
      746            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      747   ASSIGN
      748          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      749          FRAME Dialog-Frame:HIDDEN           = TRUE.
      750   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      751   DO:
      752     APPLY "END-ERROR":U TO SELF.
      753   END.
      754   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      755   DO:
      756     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      757     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      758   END.
      759   ON CHOOSE OF B-wp IN FRAME Dialog-Frame
      760   DO:
      761   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      762   if lookup(self :type
      763            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      764            ) = 0
      765   then do:
      766     message
      767       "$Workfile$"
      768       "Указанному интерфейсному элементу фокус не может быть передан" skip
      769       "Интерфейсный элемент" self :name  skip
      770       "Тип" self :type  skip
      771       "Процедура" this-procedure :file-name skip
      772       view-as alert-box .
      773   end.
      774   else do:
      775     apply "entry":u to self  .
      776     if focus :handle <> self :handle  then do:
      777       return no-apply .
      778     end.
      779   end.
      780   define variable v_rid as character no-undo.
      781   define variable ref-rec as recid no-undo .
      782   v_rid = "":U.
      783     run ref/wthplref.w (
      784                      input parparentproc
      785                     ,INPUT "b-sel":U
      786                     ,INPUT '':U
      787                     ,INPUT p-obj-type
      788                     ,INPUT p-obj-code
      789                     ,input 'объект':U
      790                     ,input-OUTPUT v_rid ).
      791       IF v_rid <> ? AND v_rid <> "":U THEN DO:
      792       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
      793       IF ERROR-STATUS:ERROR THEN DO:
      794           RETURN NO-APPLY.
      795       END.
      796       FIND FIRST buf_wth-place NO-LOCK WHERE
      797                         RECID( buf_wth-place ) = ref-rec NO-ERROR.
      798       IF AVAIL buf_wth-place THEN DO:
      799         DISPLAY
      800         buf_wth-place.w-p-code @ f-inwpcode
      801         WITH FRAME Dialog-Frame.
      802       END.
      803       ELSE DO:
      804           RETURN NO-APPLY.
      805       END.
      806     END.
      807     ELSE DO:
      808       RETURN NO-APPLY.
      809     END.
      810   END.
      811   ON VALUE-CHANGED OF t-inobjauto IN FRAME Dialog-Frame
      812   DO:
      813     RUN proc-inobj NO-ERROR.
      814   END.
      815   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      816   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      817   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      818   on help of frame Dialog-Frame
      819   do:
      820     run gbl/app_help.p
      821       (input this-procedure :file-name
      822       ,input ''
      823       ,input ?
      824       ) no-error.
      825     if error-status :error then do:
      826       message
      827         "Ошибка при вызове помощи"
      828         error-status :get-message(1)
      829         view-as alert-box .
      830     end.
      831   end.
      832   run minbtn-set in this-procedure .
      833   on choose of b-help in frame Dialog-Frame
      834   do:
      835     apply "help":u to frame Dialog-Frame .
      836   end.
      837   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      838   procedure minbtn-set :
      839       do
      840           on error undo, return error return-value
      841           :
      842           define variable ii              as integer       no-undo .
      843           define variable fh              as widget-handle no-undo .
      844           define variable hh              as widget-handle no-undo .
      845           define variable v-h             as handle        extent 4 no-undo .
      846           define variable v-name-button   as character     no-undo .
      847           define variable v-help-old-x    as decimal       no-undo .
      848           define variable v-help-old-y    as decimal       no-undo .
      849           define variable v-help-old-size as decimal       no-undo .
      850           define variable v-frame-width   as decimal       no-undo .
      851           define variable jj              as integer       no-undo .
      852           do
      853               on error undo, return error
      854               :
      855               assign
      856                   v-frame-width = frame Dialog-Frame:width - 0.3
      857                   fh            = frame Dialog-Frame:first-child
      858                   hh            = fh:first-child
      859                   ii            = 1
      860                   .
      861               do while valid-handle(hh):
      862                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      863                   do:
      864                       case lc(hh:name) :
      865                           when "b-help" then
      866                               do:
      867                                   hh:load-image-up("cmp/b-help.bmp":u) .
      868                                   hh:load-image-down("cmp/b-help.bmp":u) .
      869                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      870                                   hh:TOOLTIP = "Помощь" .
      871                                   v-help-old-x = hh:column .
      872                                   v-help-old-y = hh:row    .
      873                                   v-help-old-size = hh:width .
      874                                   hh:width-chars = 2.5 .
      875                               end.
      876                           when "b-print" then
      877                               do:
      878                                   hh:load-image("cmp/b-print.bmp":u) .
      879                                   hh:TOOLTIP = "Печать" .
      880                                   v-h[ii] = hh:handle .
      881                                   ii = ii + 1 .
      882                                   hh:width-chars = 3 .
      883                               end.
      884                           when "b-history" or
      885                           when "b-hist" then
      886                               do:
      887                                   hh:load-image("cmp/b-hist.bmp":u) .
      888                                   hh:TOOLTIP = "История" .
      889                                   v-h[ii] = hh:handle .
      890                                   ii = ii + 1 .
      891                                   hh:width-chars = 3 .
      892                               end.
      893                           when "b-sch" then
      894                               do:
      895                                   hh:load-image("cmp/b-sch.bmp":u) .
      896                                   hh:TOOLTIP = "Установка Фильтра" .
      897                                   v-h[ii] = hh:handle .
      898                                   ii = ii + 1 .
      899                                   hh:width-chars = 3 .
      900                               end.
      901                           when "b-hist-user" then
      902                               do:
      903                                   hh:load-image("cmp/b-hist.bmp":u) .
      904                                   hh:TOOLTIP = "История пользователя" .
      905                                   ii = ii + 1 .
      906                               end.
      907                       end case.
      908                   end.
      909                   hh = hh:next-sibling.
      910               end.
      911               b-help:column = v-frame-width - b-help:width-chars.
      912               jj = 0.
      913               repeat ii = 4 to 1 by -1 :
      914                   if valid-handle (v-h[ii] ) then
      915                   do:
      916                       jj  = jj + 1 .
      917                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      918                       v-h[ii]:row    = v-help-old-y .
      919                   end.
      920               end.
      921           end.
      922       end.
      923   end procedure.
      924   MAIN-BLOCK:
      925   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      926      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      927   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      928     run mainmenu_getcntxt in parparentproc
      929       (output v-cntxt-db-num
      930       ,output v-cntxt-userid
      931       ,output v-cntxt-level
      932       ,output v-cntxt-host-code-obj
      933       ,output v-cntxt-obj-type
      934       ,output v-cntxt-obj-code
      935       ,output v-cntxt-db-num-obj
      936       ,output v-cntxt-is-admin
      937       ) .
      938   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      939   ON TAB ANYWHERE
      940   DO:
      941   define variable ii as integer no-undo .
      942   define variable fh as widget-handle no-undo .
      943   define variable hh as widget-handle no-undo .
      944   define variable v-next-widget-name as character no-undo .
      945   if v-tab-order <> '' then do:
      946     if self:type = "TOGGLE-BOX" then
      947     self:BGCOLOR = ?.
      948     assign
      949     ii = lookup(self:name, v-tab-order).
      950     assign
      951     ii = ii + 1
      952     v-next-widget-name = entry(ii, v-tab-order)
      953     no-error .
      954     if error-status:error then do:
      955       assign
      956       ii = 1
      957       v-next-widget-name = entry( ii, v-tab-order)
      958       .
      959     end.
      960     assign
      961     fh = frame Dialog-Frame:first-child
      962     hh = fh:first-child
      963     .
      964     do while valid-handle(hh):
      965       if hh:name = v-next-widget-name then do:
      966         if hh:sensitive  = yes
      967         AND hh:visible = yes then do:
      968           if hh:type = "TOGGLE-BOX":U then do:
      969             assign
      970             hh:BGcolor = 1
      971             .
      972           end.
      973           APPLY "ENTRY" to hh.
      974           return no-apply.
      975         end.
      976         else do:
      977           APPLY "TAB" to hh.
      978           return no-apply.
      979         end.
      980       end.
      981       hh = hh:next-sibling.
      982     end.
      983   end.
      984   END.
      985   ON BACK-TAB ANYWHERE
      986   DO:
      987   define variable ii as integer no-undo .
      988   define variable fh as widget-handle no-undo .
      989   define variable hh as widget-handle no-undo .
      990   define variable v-next-widget-name as character no-undo .
      991   if v-tab-order <> '' then do:
      992     assign
      993     ii = lookup(self:name, v-tab-order).
      994     .
      995     assign
      996     ii = (if ii = 1
      997           then  num-entries(v-tab-order)
      998           else ii - 1
      999           )
     1000     v-next-widget-name = entry(ii, v-tab-order)
     1001     .
     1002     assign
     1003     fh = frame Dialog-Frame:first-child
     1004     hh = fh:first-child
     1005     .
     1006     do while valid-handle(hh):
     1007       if hh:name = v-next-widget-name then do:
     1008         if hh:sensitive  = yes
     1009         AND hh:visible = yes then do:
     1010           if hh:type = "TOGGLE-BOX":U then do:
     1011             assign
     1012             hh:BGcolor = 1
     1013             .
     1014           end.
     1015           APPLY "ENTRY" to hh.
     1016           return no-apply.
     1017         end.
     1018         else do:
     1019         APPLY "BACK-TAB" to hh.
     1020         return no-apply.
     1021         end.
     1022       end.
     1023       hh = hh:next-sibling.
     1024     end.
     1025     end.
     1026   END.
     1027   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1028   ON RETURN ANYWHERE
     1029   DO:
     1030   define variable ii as integer no-undo .
     1031   define variable fh as widget-handle no-undo .
     1032   define variable hh as widget-handle no-undo .
     1033   define variable v-next-widget-name as character no-undo .
     1034     if v-tab-order <> '' then do:
     1035       assign
     1036       ii = lookup(self:name, v-tab-order).
     1037       if ii = num-entries(v-tab-order) then do:
     1038           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     1039           return no-apply.
     1040       end.
     1041       if self:type <> "BUTTON" and
     1042         self:type <> "EDITOR"  then do:
     1043         run proc-move-forward in this-procedure .
     1044         return no-apply.
     1045       end.
     1046       if self:type = "BUTTON" then do:
     1047         APPLY "CHOOSE" to self.
     1048       end.
     1049       if self:type = "TOGGLE-BOX" then
     1050       self:BGCOLOR = ?.
     1051       assign
     1052       ii = ii + 1
     1053       v-next-widget-name = entry(ii, v-tab-order)
     1054       no-error .
     1055       if error-status:error then do:
     1056         assign
     1057         ii = 1
     1058         v-next-widget-name = entry( ii, v-tab-order)
     1059         .
     1060       end.
     1061       assign
     1062       fh = frame Dialog-Frame:first-child
     1063       hh = fh:first-child
     1064       .
     1065       do while valid-handle(hh):
     1066         if hh:name = v-next-widget-name then do:
     1067           if hh:sensitive  = yes
     1068           AND hh:visible = yes then do:
     1069             if hh:type = "TOGGLE-BOX":U then do:
     1070               assign
     1071               hh:BGcolor = 1
     1072               .
     1073             end.
     1074             APPLY "ENTRY" to hh.
     1075             return no-apply.
     1076           end.
     1077           else do:
     1078             APPLY "TAB" to hh.
     1079             return no-apply.
     1080           end.
     1081         end.
     1082         hh = hh:next-sibling.
     1083       end.
     1084     end.
     1085   END.
     1086   procedure proc-move-forward :
     1087   define variable ii as integer no-undo .
     1088   define variable fh as widget-handle no-undo .
     1089   define variable hh as widget-handle no-undo .
     1090   define variable v-next-widget-name as character no-undo .
     1091   do
     1092   on error undo, return error
     1093   :
     1094     if v-tab-order <> '' then do:
     1095       if self:type = "TOGGLE-BOX" then
     1096       self:BGCOLOR = ?.
     1097       assign
     1098       ii = lookup(self:name, v-tab-order).
     1099       assign
     1100       ii = ii + 1
     1101       v-next-widget-name = entry(ii, v-tab-order)
     1102       no-error .
     1103       if error-status:error then do:
     1104         assign
     1105         ii = 1
     1106         v-next-widget-name = entry( ii, v-tab-order)
     1107         .
     1108       end.
     1109       assign
     1110       fh = frame Dialog-Frame:first-child
     1111       hh = fh:first-child
     1112       .
     1113       do while valid-handle(hh):
     1114         if hh:name = v-next-widget-name then do:
     1115           if hh:sensitive  = yes
     1116           AND hh:visible = yes then do:
     1117             if hh:type = "TOGGLE-BOX":U then do:
     1118               assign
     1119               hh:BGcolor = 1
     1120               .
     1121             end.
     1122             APPLY "ENTRY" to hh.
     1123             return.
     1124           end.
     1125           else do:
     1126             assign
     1127             ii = ii + 1
     1128             v-next-widget-name = entry(ii, v-tab-order)
     1129             no-error .
     1130             if error-status:error then do:
     1131               assign
     1132               ii = 1
     1133               v-next-widget-name = entry( ii, v-tab-order)
     1134               .
     1135             end.
     1136           end.
     1137         end.
     1138         hh = hh:next-sibling.
     1139       end.
     1140     end.
     1141   end.
     1142   end procedure.
     1143     IF p-mode <> 'ПРОСМОТР':U
     1144     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     1145         MESSAGE
     1146         vss-workfile vss-revision vss-description skip
     1147         "Неверное значение параметра p-mode" p-mode
     1148         VIEW-AS ALERT-BOX ERROR.
     1149         UNDO, RETURN ERROR.
     1150     END.
     1151     IF p-obj-type <> 'маг':U
     1152     and p-obj-type <> 'скл':U
     1153     and p-obj-type <> 'орг':U
     1154     and p-obj-type <> '':U
     1155     THEN DO:
     1156         MESSAGE
     1157         vss-workfile vss-revision vss-description skip
     1158         "Неверное значение параметра p-obj-type" p-obj-type
     1159         VIEW-AS ALERT-BOX ERROR.
     1160         UNDO, RETURN ERROR.
     1161     END.
     1162     if p-obj-type = 'маг':U then do:
     1163       FIND FIRST X_shop NO-LOCK WHERE X_shop.obj-code = p-obj-code NO-ERROR.
     1164       IF NOT AVAILABLE X_shop THEN DO:
     1165           MESSAGE
     1166           vss-workfile vss-revision vss-description skip
     1167           "Неверное значение параметра p-obj-code" p-obj-code
     1168           VIEW-AS ALERT-BOX ERROR.
     1169           UNDO, RETURN ERROR.
     1170       END.
     1171   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1172   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1173     (input  'маг':U
     1174     ,input  p-obj-code
     1175     ,output v-db-num
     1176     )  .
     1177       IF v-db-num <> v-cntxt-db-num
     1178       AND v-cntxt-db-num <> 0
     1179       and p-mode <> 'ПРОСМОТР':U
     1180       THEN DO:
     1181           MESSAGE
     1182           "Нельзя менять параметры магазина в чужой БД" skip
     1183           "магазин принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     1184           VIEW-AS ALERT-BOX ERROR.
     1185           UNDO, RETURN ERROR.
     1186       END.
     1187     end.
     1188     if p-obj-type = 'скл':U then do:
     1189       FIND FIRST X_store NO-LOCK WHERE X_store.obj-code = p-obj-code NO-ERROR.
     1190       IF NOT AVAILABLE X_store THEN DO:
     1191           MESSAGE
     1192           vss-workfile vss-revision vss-description skip
     1193           "Неверное значение параметра p-obj-code" p-obj-code
     1194           VIEW-AS ALERT-BOX ERROR.
     1195           UNDO, RETURN ERROR.
     1196       END.
     1197   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1198   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1199     (input  'скл':U
     1200     ,input  p-obj-code
     1201     ,output v-db-num
     1202     )  .
     1203       IF v-db-num <> v-cntxt-db-num
     1204       AND v-cntxt-db-num <> 0
     1205       and p-mode <> 'ПРОСМОТР':U
     1206       THEN DO:
     1207           MESSAGE
     1208           "Нельзя менять параметры склада в чужой БД" skip
     1209           "склад принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     1210           VIEW-AS ALERT-BOX ERROR.
     1211           UNDO, RETURN ERROR.
     1212       END.
     1213     end.
     1214     if p-obj-type = 'орг':U then do:
     1215       FIND FIRST X_sysconf NO-LOCK WHERE X_sysconf.host-code = p-obj-code NO-ERROR.
     1216       IF NOT AVAILABLE X_sysconf THEN DO:
     1217           MESSAGE
     1218           vss-workfile vss-revision vss-description skip
     1219           "Неверное значение параметра p-obj-code" p-obj-code
     1220           VIEW-AS ALERT-BOX ERROR.
     1221           UNDO, RETURN ERROR.
     1222       END.
     1223       if v-cntxt-db-num <> 0
     1224       and p-mode <> 'ПРОСМОТР':U
     1225       then do:
     1226           MESSAGE
     1227           "Нельзя менять параметры ФИРМЫ в УБД" skip
     1228           VIEW-AS ALERT-BOX ERROR.
     1229           UNDO, RETURN ERROR.
     1230       end.
     1231     end.
     1232     if p-obj-type = '':U then do:
     1233       if v-cntxt-db-num <> 0
     1234       and p-mode <> 'ПРОСМОТР':U
     1235       then do:
     1236           MESSAGE
     1237           "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" skip
     1238           VIEW-AS ALERT-BOX ERROR.
     1239           UNDO, RETURN ERROR.
     1240       end.
     1241     end.
     1242     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     1243       FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
     1244                 LOCKED_thbj-attr.obj-type = p-obj-type
     1245           AND   LOCKED_thbj-attr.obj-code = p-obj-code
     1246           AND   LOCKED_thbj-attr.upper-prop-code = 'wthdoc_obj':U
     1247           AND   locked_thbj-attr.prop-code = '':U NO-WAIT NO-ERROR.
     1248        if locked locked_thbj-attr then do:
     1249           message
     1250           vss-workfile vss-revision vss-description skip
     1251            "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
     1252           view-as alert-box error .
     1253           undo, return error.
     1254         end.
     1255     END.
     1256     ELSE DO:
     1257         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
     1258             LOCKED_thbj-attr.obj-type = p-obj-type
     1259       AND   LOCKED_thbj-attr.obj-code = p-obj-code
     1260       AND   LOCKED_thbj-attr.upper-prop-code = 'wthdoc_obj':U
     1261       and   locked_thbj-attr.prop-code = '':U
     1262       NO-ERROR.
     1263     END.
     1264     if not available locked_thbj-attr then do:
     1265       ASSIGN
     1266       v-to-create  = YES.
     1267       message
     1268       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     1269                   chr(10))
     1270       view-as alert-box WARNING.
     1271     end.
     1272     RUN FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     1273     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     1274     RUN Myenable.
     1275     WAIT-FOR GO OF FRAME Dialog-Frame.
     1276   END.
     1277   RUN disable_UI.
     1278   PROCEDURE disable_UI :
     1279     HIDE FRAME Dialog-Frame.
     1280   END PROCEDURE.
     1281   PROCEDURE enable_UI :
     1282     DISPLAY f-stfactpref f-numsfact CB-rangerule t-clsfact t-inobjauto f-inwpcode
     1283             t-prsdoc
     1284         WITH FRAME Dialog-Frame.
     1285     ENABLE B-exit b-quit B-Help f-stfactpref f-numsfact CB-rangerule t-clsfact
     1286            t-inobjauto f-inwpcode B-wp t-prsdoc
     1287         WITH FRAME Dialog-Frame.
     1288     VIEW FRAME Dialog-Frame.
     1289   END PROCEDURE.
     1290   PROCEDURE fill-widgets :
     1291   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     1292   DEFINE VARIABLE v-entry AS CHARACTER NO-UNDO.
     1293   define variable v-param-type as character no-undo .
     1294   define variable v-param-value as character no-undo .
     1295   define variable v-value-character as character no-undo .
     1296   define variable v-value-date as date no-undo .
     1297   define variable v-value-decimal as decimal no-undo .
     1298   define variable v-value-integer as INTEGER no-undo .
     1299   define variable v-value-logical AS LOGICAL no-undo .
     1300   FOR EACH thbjattr_thbj-attr:
     1301     delete thbjattr_thbj-attr.
     1302   end.
     1303   FOR EACH temp-thbj-attr:
     1304     delete temp-thbj-attr.
     1305   end.
     1306   run adm/shattri.p (
     1307                 input "init":U
     1308               , input p-obj-type
     1309               , input p-obj-code
     1310               , input 'wthdoc_obj':U
     1311               , input "":U
     1312               , output v-value-character
     1313               , output v-value-date
     1314               , output v-value-decimal
     1315               , output v-value-integer
     1316               , output v-value-logical
     1317               , output v-param-type
     1318               , INPUT-OUTPUT TABLE-handle v-tth
     1319               ) no-error .
     1320   if error-status:error
     1321   and not available locked_thbj-attr then do:
     1322     message
     1323     "Не удалось получить начальные значения настроек" skip
     1324     error-status:get-message(1) return-value
     1325     view-as alert-box error .
     1326     undo, return error .
     1327   end.
     1328   define variable v-tooltip as character no-undo .
     1329   define variable v-label   as character no-undo .
     1330   define variable v-tooltip-code as character no-undo .
     1331   FOR EACH thbjattr_thbj-attr:
     1332     ASSIGN
     1333     v-entry = thbjattr_thbj-attr.prop-code.
     1334     IF v-entry = 'stfactpref':U THEN DO:
     1335       ASSIGN
     1336       f-stfactpref = thbjattr_thbj-attr.property-value-character
     1337       f-stfactpref:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1338       .
     1339               run thbjattr_tooltip in this-procedure (    input   'wthdoc_obj':U   ,input  "stfactpref"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . f-stfactpref:tooltip = REPLACE ( v-tooltip-code , "`" , "," ) .
     1340     END.
     1341     IF v-entry = 'rangerule':U THEN DO:
     1342       ASSIGN
     1343       cb-rangerule = thbjattr_thbj-attr.property-value-integer
     1344       cb-rangerule:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1345       .
     1346               run thbjattr_tooltip in this-procedure (    input   'wthdoc_obj':U   ,input  "rangerule"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . cb-rangerule:tooltip = REPLACE ( v-tooltip-code , "`" , "," ) .
     1347     END.
     1348     IF v-entry = 'inobjauto':U THEN DO:
     1349       ASSIGN
     1350       t-inobjauto = thbjattr_thbj-attr.property-value-logical
     1351       t-inobjauto:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1352       .
     1353               run thbjattr_tooltip in this-procedure (    input   'wthdoc_obj':U   ,input  "inobjauto"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . t-inobjauto:tooltip = REPLACE ( v-tooltip-code , "`" , "," ) .
     1354     END.
     1355     IF v-entry = 'clsfact':U THEN DO:
     1356       ASSIGN
     1357       t-clsfact  = thbjattr_thbj-attr.property-value-logical
     1358       t-clsfact:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1359       .
     1360                   run thbjattr_tooltip in this-procedure (    input   'wthdoc_obj':U   ,input  "clsfact"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . t-clsfact:tooltip = REPLACE ( v-tooltip-code , "`" , "," ) .
     1361     END.
     1362     IF v-entry = 'inwpcode':U THEN DO:
     1363       ASSIGN
     1364       f-inwpcode  = thbjattr_thbj-attr.property-value-integer
     1365       f-inwpcode:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1366       .
     1367               run thbjattr_tooltip in this-procedure (    input   'wthdoc_obj':U   ,input  "inwpcode"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . f-inwpcode:tooltip = REPLACE ( v-tooltip-code , "`" , "," ) .
     1368     END.
     1369     IF v-entry = 'numsfact':U THEN DO:
     1370       ASSIGN
     1371       f-numsfact  = thbjattr_thbj-attr.property-value-integer
     1372       f-numsfact:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1373       .
     1374               run thbjattr_tooltip in this-procedure (    input   'wthdoc_obj':U   ,input  "numsfact"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . f-numsfact:tooltip = REPLACE ( v-tooltip-code , "`" , "," ) .
     1375     END.
     1376     IF v-entry = 'prsdoc':U THEN DO:
     1377       ASSIGN
     1378       t-prsdoc  = thbjattr_thbj-attr.property-value-logical
     1379       t-prsdoc:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1380       .
     1381               run thbjattr_tooltip in this-procedure (    input   'wthdoc_obj':U   ,input  "prsdoc"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . t-prsdoc:tooltip = REPLACE ( v-tooltip-code , "`" , "," ) .
     1382     END.
     1383     create temp-thbj-attr.
     1384     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     1385   END.
     1386   END PROCEDURE.
     1387   PROCEDURE MyEnable :
     1388   ASSIGN
     1389   FRAME Dialog-Frame:TITLE = FRAME Dialog-Frame:TITLE + (if p-obj-type = 'орг':U then " фирма" else " маг") + STRING(p-obj-code)
     1390   v-tab-order = "f-stfactpref,f-numsfact,CB-rangerule,t-clsfact,t-inobjauto,f-inwpcode".
     1391   DISPLAY
     1392   f-stfactpref
     1393   f-numsfact
     1394   CB-rangerule
     1395   t-clsfact
     1396   t-inobjauto
     1397   f-inwpcode
     1398   t-prsdoc
     1399   WITH FRAME Dialog-Frame.
     1400   ENABLE
     1401   B-exit WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1402   b-quit
     1403   B-Help
     1404   f-stfactpref WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1405   f-numsfact WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1406   CB-rangerule WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1407   t-clsfact WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1408   t-inobjauto WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1409   t-prsdoc WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1410   WITH FRAME Dialog-Frame.
     1411   IF p-mode = 'ИЗМЕНЕНИЕ':U THEN
     1412     RUN proc-inobj NO-ERROR.
     1413   VIEW FRAME Dialog-Frame.
     1414   IF p-mode = 'ПРОСМОТР':U THEN DO:
     1415       HIDE
     1416       b-exit
     1417       IN FRAME Dialog-Frame.
     1418       ASSIGN
     1419       b-quit:LABEL = "&Выход"
     1420       .
     1421   END.
     1422   END PROCEDURE.
     1423   PROCEDURE proc-inobj :
     1424     IF t-inobjauto:CHECKED IN FRAME Dialog-Frame THEN
     1425         ENABLE f-inwpcode
     1426                b-wp
     1427         WITH frame Dialog-Frame.
     1428     ELSE DISABLE f-inwpcode
     1429                  b-wp
     1430         WITH frame Dialog-Frame.
     1431   END PROCEDURE.
     1432   PROCEDURE proc-save :
     1433   define variable v-value-character as character no-undo .
     1434   define variable v-value-date as date no-undo .
     1435   define variable v-value-decimal as decimal no-undo .
     1436   define variable v-value-integer as INTEGER no-undo .
     1437   define variable v-value-logical AS LOGICAL no-undo .
     1438   define variable v-param-type as character no-undo .
     1439   define variable wh as widget-handle no-undo .
     1440   define variable fh as widget-handle no-undo .
     1441   define variable v-same as logical no-undo .
     1442   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     1443   ASSIGN
     1444   FRAME Dialog-Frame
     1445   f-stfactpref
     1446   f-numsfact
     1447   CB-rangerule
     1448   t-clsfact
     1449   t-inobjauto
     1450   f-inwpcode
     1451   t-prsdoc
     1452   .
     1453   assign
     1454   fh = frame Dialog-Frame:first-child
     1455   wh = fh:first-child
     1456   .
     1457   do while valid-handle(wh):
     1458     if wh:private-data begins "recid=" then do:
     1459       find first thbjattr_thbj-attr where
     1460                 recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     1461       assign
     1462       buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     1463     end.
     1464     wh = wh:next-sibling.
     1465   end.
     1466   v-same = yes.
     1467   for each thbjattr_thbj-attr,
     1468       first temp-thbj-attr where
     1469             temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     1470         and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     1471         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     1472         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code:
     1473      buffer-compare
     1474      thbjattr_thbj-attr
     1475      to temp-thbj-attr
     1476      save result in v-same.
     1477      if v-same = no then leave.
     1478   end.
     1479   v-same = no.
     1480   IF v-same  and not v-to-create THEN RETURN.
     1481   run adm/shattri.p (
     1482                  input "check":U
     1483                , input p-obj-type
     1484                , input p-obj-code
     1485                , input 'wthdoc_obj':U
     1486                , input '':U
     1487                , output v-value-character
     1488                , output v-value-date
     1489                , output v-value-decimal
     1490                , output v-value-integer
     1491                , output v-value-logical
     1492                , output v-param-type
     1493                , input-output TABLE-handle v-tth
     1494               ) no-error .
     1495   if error-status:error then do:
     1496     message
     1497     "Некорректное значение ПАРАМЕТРОВ" skip
     1498     error-status:get-message(1) skip
     1499     return-value
     1500     view-as alert-box error .
     1501     undo, return error .
     1502   end.
     1503   RUN thbjattr_set-section IN THIS-PROCEDURE (
     1504        input p-obj-type
     1505       ,input p-obj-code
     1506       ,input 'wthdoc_obj':U
     1507       ,input table thbjattr_thbj-attr
     1508   ) NO-ERROR.
     1509   IF ERROR-STATUS:error THEN do:
     1510     MESSAGE ERROR-STATUS:get-message(1)  SKIP
     1511     RETURN-VALUE
     1512     VIEW-AS ALERT-BOX.
     1513     UNDO, RETURN ERROR.
     1514   END.
     1515   END PROCEDURE.
