      493       ,input  p-upper-param-code
      494       ,input  p-mode
      495       ,input-output table-handle p-tth
      496       ,output p-all-found
      497       ) no-error .
      498     if error-status :error
      499     then do:
      500       delete object p-tth.
      501       undo, return error return-value .
      502     end.
      503     delete object p-tth.
      504   end.
      505   end procedure.
      506   procedure thbjattr_write :
