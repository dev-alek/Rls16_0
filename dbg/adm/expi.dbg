        1   define input        parameter p-standalone as logical                  no-undo .
        2   define input        parameter p-selected   as logical                  no-undo .
        3   define input-output parameter p-fname      as character format "x(80)" no-undo .
        4   define input        parameter p-db-list    as character                no-undo .
        5   define       output parameter p-sel-dbs    as character                no-undo .
        6   define       output parameter p-exp-type   as character                no-undo .
        7   define       output parameter p-new-db-num as integer                  no-undo .
        8   define       output parameter p-new-db-key as character                no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision$":U .
       10   define variable vss-author      as character no-undo init "$Author$":U .
       11   define variable vss-date        as character no-undo init "$Date$":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       13   define variable vss-archive     as character no-undo init "$Archive$":U .
       14   define variable vss-description as character no-undo init "Экспорт конфигурационных параметров".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   procedure proc-alt-shift-f2:
       74     if not ibs.th.gbl.gbl-var:rcode
       75   then
       76     run gbl\inidebug.p .
       77   end.
       78   procedure proc-alt-shift-f3:
       79     run gbl/prvssinf.p
       80       ( input this-procedure
       81       ) .
       82   end.
       83   define variable v-inform-launched as logical no-undo initial false .
       84   procedure proc-alt-shift-f4:
       85     define variable v-action as character no-undo .
       86     if v-inform-launched = false then do:
       87       assign
       88         v-inform-launched = true
       89       .
       90       run gbl/d-inform.w
       91         (  input self
       92         ,  input this-procedure
       93         , output v-action
       94         ) no-error .
       95       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       96       assign
       97         v-inform-launched = false
       98       .
       99     end.
      100   end.
      101   procedure proc-alt-f1:
      102     run gbl/corrhelp.p
      103       (input this-procedure
      104       ) .
      105   end .
      106   on alt-shift-f2 anywhere do:
      107     run proc-alt-shift-f2.
      108   end.
      109   on alt-shift-f3 anywhere do:
      110     run proc-alt-shift-f3 in this-procedure .
      111   end.
      112   on alt-shift-f4 anywhere do:
      113     run proc-alt-shift-f4 in this-procedure.
      114   end.
      115   on alt-f1 anywhere do:
      116     run proc-alt-f1 in this-procedure .
      117   end.
      118   define  shared temp-table cnf no-undo
      119       field param-code    as character   format "x(8)"        column-label "Код"                               field param-type    as character                        column-label "Тип"                               field param-value   as character   format "x(250)"      column-label "Значение"                          field param-encoded as character                        column-label "Кодированное значение"             field host-code     as integer                          column-label "Фирма"                             field obj-type      as character                        column-label "Тип объекта"                       field obj-code      as integer     format ">>>>>>"      column-label "Код объекта"                       field conf-type     as character                        column-label "Кодировка"                         field beg-date      as date                             column-label "Начало действия параметра"         field end-date      as date                             column-label "Окончание действия параметра"      field db-num        as integer     format ">>>>>"       column-label "БД"                                field stts          as integer                          column-label "Статус"
      120       field db-key        as character   format "x(12)"       column-label "Ключ БД"
      121       field param-PS      as character   format "x(40)"       column-label "PS"
      122       field param-name    as character   format "x(30)"       column-label "Название"
      123       field is-changed    as logical initial false            column-label "Изменен"
      124       field NotUsed       as logical initial False            column-label "Выключен"
      125       field ErrorExist    as integer initial 0  format ">>"   column-label "Уровень ошибки"
      126       index pi
      127         is unique
      128         param-code
      129         host-code
      130         obj-type
      131         obj-code
      132         beg-date
      133         end-date
      134         db-num
      135       index db-num
      136         db-num
      137       index db-key
      138         db-key
      139       index par-name
      140         is word-index
      141         param-name
      142       index par-value
      143         is word-index
      144         param-value
      145    .
      146   def  shared temp-table log-table no-undo
      147       field stroka       as character format "x(256)".
      148   def  shared variable err-level as integer no-undo.
      149   DEFINE BUTTON b-exit AUTO-GO
      150        LABEL "&Ввод ":L
      151        SIZE 9 BY 1.
      152   DEFINE BUTTON b-file
      153        IMAGE-UP FILE "btn-down-arrow":U
      154        IMAGE-DOWN FILE "btn-down-arrow":U
      155        IMAGE-INSENSITIVE FILE "btn-down-arrow":U NO-FOCUS
      156        LABEL "b-file"
      157        SIZE 3 BY .88 TOOLTIP "Вызов окна выбора файла".
      158   DEFINE BUTTON b-help
      159        LABEL "Помо&щь":L
      160        SIZE 3 BY 1.
      161   DEFINE BUTTON b-quit AUTO-END-KEY
      162        LABEL "&Отмена":L
      163        SIZE 9 BY 1.
      164   DEFINE VARIABLE f-new-db-key LIKE ub.db.db-key
      165        LABEL "Ключ новой БД"
      166        FORMAT "X(25)"
      167        VIEW-AS FILL-IN
      168        SIZE 9 BY 1 NO-UNDO.
      169   DEFINE VARIABLE f-new-db-num LIKE ub.db.db-num
      170        LABEL "Номер новой БД"
      171        VIEW-AS FILL-IN
      172        SIZE 6 BY 1 NO-UNDO.
      173   DEFINE VARIABLE FName AS CHARACTER FORMAT "X(256)":U
      174        LABEL "Имя файла"
      175        VIEW-AS FILL-IN NATIVE
      176        SIZE 56 BY 1 TOOLTIP "Файл конфигурации" NO-UNDO.
      177   DEFINE VARIABLE export-type AS CHARACTER
      178        VIEW-AS RADIO-SET VERTICAL
      179        RADIO-BUTTONS
      180             "Все включенные", "all",
      181   "Текущий", "curr",
      182   "Отмеченные", "mark",
      183   "Все кодированные", "all-protect",
      184   "Все обязательные", "all-mandatory"
      185        SIZE 19.63 BY 4 NO-UNDO.
      186   DEFINE RECTANGLE RECT-1
      187        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      188        SIZE 71.5 BY 9.5.
      189   DEFINE VARIABLE sel-dbs AS CHARACTER
      190        VIEW-AS SELECTION-LIST MULTIPLE SORT SCROLLBAR-VERTICAL
      191        SIZE 9.5 BY 7.5 NO-UNDO.
      192   DEFINE VARIABLE t-for-db AS LOGICAL INITIAL no
      193        LABEL "Для новой БД"
      194        VIEW-AS TOGGLE-BOX
      195        SIZE 16 BY 1 NO-UNDO.
      196   DEFINE FRAME d-cnf
      197        b-file AT ROW 2.5 COL 70
      198        b-exit AT ROW 1 COL 2
      199        b-quit AT ROW 1 COL 11
      200        b-help AT ROW 1 COL 70
      201        FName AT ROW 2.5 COL 11.5 COLON-ALIGNED
      202        export-type AT ROW 5 COL 3.5 NO-LABEL
      203        sel-dbs AT ROW 5.25 COL 34.5 NO-LABEL WIDGET-ID 4
      204        t-for-db AT ROW 9.5 COL 4 WIDGET-ID 8
      205        f-new-db-num AT ROW 10.5 COL 19 COLON-ALIGNED HELP
      206             "" WIDGET-ID 10
      207             LABEL "Номер новой БД"
      208        f-new-db-key AT ROW 11.5 COL 19 COLON-ALIGNED HELP
      209             "" WIDGET-ID 12
      210             LABEL "Ключ новой БД"
      211        "Выводить параметры:" VIEW-AS TEXT
      212             SIZE 19.88 BY .67 AT ROW 4 COL 2.5
      213        "БД:" VIEW-AS TEXT
      214             SIZE 4 BY .67 AT ROW 5.25 COL 29.5 WIDGET-ID 6
      215        RECT-1 AT ROW 3.75 COL 1.5 WIDGET-ID 2
      216        SPACE(0.87) SKIP(0.32)
      217       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      218            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      219            TITLE "Экспорт конфигурационных параметров":L.
      220   ASSIGN
      221          FRAME d-cnf:SCROLLABLE       = FALSE.
      222   ASSIGN
      223          f-new-db-key:HIDDEN IN FRAME d-cnf           = TRUE.
      224   ASSIGN
      225          f-new-db-num:HIDDEN IN FRAME d-cnf           = TRUE.
      226   ON CHOOSE OF b-exit IN FRAME d-cnf
      227   DO:
      228     ASSIGN
      229       export-type
      230       FName
      231       t-for-db
      232       f-new-db-num
      233       f-new-db-key
      234     .
      235     if ( sel-dbs:screen-value = ?
      236          or sel-dbs:screen-value = "":U
      237        )
      238       and export-type <> "curr":U
      239     then do:
      240       message
      241         "Необходимо выбрать хотя бы одну БД параметры которой будут выгружаться !"
      242         view-as alert-box.
      243       return no-apply .
      244     end.
      245     if t-for-db = true
      246       and num-entries( sel-dbs :screen-value ) > 1
      247     then do:
      248       message
      249         substitute("При выгрузке параметров для новой БД допускается выбирать только одну БД источник!") skip
      250         view-as alert-box error .
      251       return no-apply .
      252     end.
      253     if trim( FName ) = "":U then do:
      254       message
      255         "Необходимо указать имя файла в который будут выгружаться параметры !"
      256         view-as alert-box.
      257       return no-apply .
      258     end.
      259     assign
      260       p-fname    = fname
      261       p-exp-type = export-type
      262       p-sel-dbs  = sel-dbs:screen-value
      263     .
      264     if t-for-db = true then do:
      265       assign
      266         p-new-db-num = f-new-db-num
      267         p-new-db-key = f-new-db-key
      268       .
      269     end.
      270     else do:
      271       assign
      272         p-new-db-num = ?
      273         p-new-db-key = "":U
      274       .
      275     end.
      276   END.
      277   ON CHOOSE OF b-file IN FRAME d-cnf
      278   DO:
      279     define variable is-choosen as logical no-undo.
      280     SYSTEM-DIALOG GET-FILE Fname
      281     FILTERS "Файлы конфигурации *.cfg" "*.cfg",
      282             "Все файлы"  "*.*"
      283     ASK-OVERWRITE
      284     CREATE-TEST-FILE
      285     DEFAULT-EXTENSION "*.cfg"
      286     SAVE-AS
      287     TITLE "Выберите файл для вывода конфигурации"
      288     USE-FILENAME
      289     UPDATE is-choosen.
      290     if is-choosen then do:
      291       display
      292         fname
      293         with frame d-cnf.
      294     end.
      295   END.
      296   ON CHOOSE OF b-quit IN FRAME d-cnf
      297   DO:
      298     assign
      299       p-exp-type = ?
      300       p-fname    = ?
      301     .
      302   END.
      303   ON RETURN OF export-type IN FRAME d-cnf
      304   DO:
      305     apply "TAB" to export-type.
      306   END.
      307   ON VALUE-CHANGED OF export-type IN FRAME d-cnf
      308   DO:
      309     assign
      310       export-type
      311     .
      312     if export-type = "curr":U then do:
      313       disable
      314         sel-dbs
      315         with frame d-cnf.
      316     end.
      317     else do:
      318       enable
      319         sel-dbs
      320         with frame d-cnf.
      321     end.
      322   END.
      323   ON VALUE-CHANGED OF t-for-db IN FRAME d-cnf
      324   DO:
      325     assign
      326       t-for-db
      327     .
      328     if t-for-db = true then do:
      329       enable
      330         f-new-db-num
      331         f-new-db-key
      332         with frame d-cnf.
      333     end.
      334     else do:
      335       disable
      336         f-new-db-num
      337         f-new-db-key
      338         with frame d-cnf.
      339       hide
      340         f-new-db-num
      341         f-new-db-key
      342         in frame d-cnf.
      343     end.
      344   END.
      345   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      346   on help of frame d-cnf
      347   do:
      348     run gbl/app_help.p
      349       (input this-procedure :file-name
      350       ,input ''
      351       ,input ?
      352       ) no-error.
      353     if error-status :error then do:
      354       message
      355         "Ошибка при вызове помощи"
      356         error-status :get-message(1)
      357         view-as alert-box .
      358     end.
      359   end.
      360   run minbtn-set in this-procedure .
      361   on choose of b-help in frame d-cnf
      362   do:
      363     apply "help":u to frame d-cnf .
      364   end.
      365   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      366   procedure minbtn-set :
      367       do
      368           on error undo, return error return-value
      369           :
      370           define variable ii              as integer       no-undo .
      371           define variable fh              as widget-handle no-undo .
      372           define variable hh              as widget-handle no-undo .
      373           define variable v-h             as handle        extent 4 no-undo .
      374           define variable v-name-button   as character     no-undo .
      375           define variable v-help-old-x    as decimal       no-undo .
      376           define variable v-help-old-y    as decimal       no-undo .
      377           define variable v-help-old-size as decimal       no-undo .
      378           define variable v-frame-width   as decimal       no-undo .
      379           define variable jj              as integer       no-undo .
      380           do
      381               on error undo, return error
      382               :
      383               assign
      384                   v-frame-width = frame d-cnf:width - 0.3
      385                   fh            = frame d-cnf:first-child
      386                   hh            = fh:first-child
      387                   ii            = 1
      388                   .
      389               do while valid-handle(hh):
      390                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      391                   do:
      392                       case lc(hh:name) :
      393                           when "b-help" then
      394                               do:
      395                                   hh:load-image-up("cmp/b-help.bmp":u) .
      396                                   hh:load-image-down("cmp/b-help.bmp":u) .
      397                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      398                                   hh:TOOLTIP = "Помощь" .
      399                                   v-help-old-x = hh:column .
      400                                   v-help-old-y = hh:row    .
      401                                   v-help-old-size = hh:width .
      402                                   hh:width-chars = 2.5 .
      403                               end.
      404                           when "b-print" then
      405                               do:
      406                                   hh:load-image("cmp/b-print.bmp":u) .
      407                                   hh:TOOLTIP = "Печать" .
      408                                   v-h[ii] = hh:handle .
      409                                   ii = ii + 1 .
      410                                   hh:width-chars = 3 .
      411                               end.
      412                           when "b-history" or
      413                           when "b-hist" then
      414                               do:
      415                                   hh:load-image("cmp/b-hist.bmp":u) .
      416                                   hh:TOOLTIP = "История" .
      417                                   v-h[ii] = hh:handle .
      418                                   ii = ii + 1 .
      419                                   hh:width-chars = 3 .
      420                               end.
      421                           when "b-sch" then
      422                               do:
      423                                   hh:load-image("cmp/b-sch.bmp":u) .
      424                                   hh:TOOLTIP = "Установка Фильтра" .
      425                                   v-h[ii] = hh:handle .
      426                                   ii = ii + 1 .
      427                                   hh:width-chars = 3 .
      428                               end.
      429                           when "b-hist-user" then
      430                               do:
      431                                   hh:load-image("cmp/b-hist.bmp":u) .
      432                                   hh:TOOLTIP = "История пользователя" .
      433                                   ii = ii + 1 .
      434                               end.
      435                       end case.
      436                   end.
      437                   hh = hh:next-sibling.
      438               end.
      439               b-help:column = v-frame-width - b-help:width-chars.
      440               jj = 0.
      441               repeat ii = 4 to 1 by -1 :
      442                   if valid-handle (v-h[ii] ) then
      443                   do:
      444                       jj  = jj + 1 .
      445                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      446                       v-h[ii]:row    = v-help-old-y .
      447                   end.
      448               end.
      449           end.
      450       end.
      451   end procedure.
      452   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-cnf:PARENT eq ?
      453   THEN FRAME d-cnf:PARENT = ACTIVE-WINDOW.
      454   define variable cur-der as logical no-undo.
      455   assign
      456     cur-der                   = session:data-entry-return
      457     session:data-entry-return = yes
      458   .
      459   MAIN-BLOCK:
      460   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      461      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      462     define variable v-log         as logical   no-undo .
      463     assign
      464       fname      = p-fname
      465       p-exp-type = ?
      466     .
      467     run enable_UI.
      468     if p-db-list <> "":U then do:
      469       sel-dbs :list-items in frame d-cnf = p-db-list  .
      470     end.
      471     if p-selected = FALSE then do:
      472       assign
      473         v-log = export-type:disable( "Текущий" )
      474       .
      475     end.
      476     apply "entry" to export-type.
      477     WAIT-FOR GO OF FRAME d-cnf.
      478   END.
      479   RUN disable_UI.
      480   assign
      481     session:data-entry-return = cur-der
      482   .
      483   PROCEDURE disable_UI :
      484     HIDE FRAME d-cnf.
      485   END PROCEDURE.
      486   PROCEDURE enable_UI :
      487     DISPLAY FName export-type sel-dbs t-for-db
      488         WITH FRAME d-cnf.
      489     ENABLE b-file b-exit b-quit b-help RECT-1 FName export-type sel-dbs t-for-db
      490         WITH FRAME d-cnf.
      491   END PROCEDURE.
