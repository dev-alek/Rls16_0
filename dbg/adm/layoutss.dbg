        1   DEFINE BUFFER X_layout FOR ub.layout.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter bttns as character no-undo.
        4   define input parameter p-list-mode as character no-undo .
        5   define input parameter p-layout-type as character no-undo .
        6   define input-output parameter p-rid-list as character no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Список раскладок".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   define variable v-waitfram-action01         as character   no-undo .
       69   define variable v-waitfram-action02         as character   no-undo .
       70   define variable v-waitfram-action03         as character   no-undo .
       71   define variable mWaitFramTextBeg            as character   no-undo.
       72   define variable mWaitFramTextEnd            as character   no-undo.
       73   define variable mWaitFramView               as logical     no-undo.
       74   define variable mWaitProcEvent              as logical     no-undo init yes.
       75   define variable mWaitFramInterval           as integer     no-undo init 1 .
       76   define variable mWaitFramStop               as logical     no-undo.
       77   define variable mWaitFramStopUser           as logical     no-undo.
       78   define variable mWaitFramStopTimeOut        as logical     no-undo.
       79   define variable mWaitFramStartProc          as datetime-tz no-undo.
       80   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       81   define button B-WaitFramStop auto-end-key
       82        label "Стоп"
       83        size 10 by 1 tooltip "Остоновить процесс".
       84   define button B-viewProcInfo
       85        label "Информация"
       86        size 15 by 1 tooltip "Информация о процесс".
       87   define frame waitfram
       88     v-waitfram-action01 format "x(72)" no-label skip
       89     v-waitfram-action02 format "x(72)" no-label skip
       90     v-waitfram-action03 format "x(72)" no-label skip
       91     B-viewProcInfo
       92     B-WaitFramStop at row 4 col 30
       93     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       94     .
       95   define new global shared variable mBatchMode as logical no-undo init ?.
       96   define variable mFramBachModHandle as handle no-undo.
       97   mFramBachModHandle = frame waitfram:handle.
       98   define variable mFameOldVis as logical no-undo.
       99   define variable mVisCUrentVin as logical no-undo.
      100   if session:batch-mode
      101   then
      102      mBatchMode = yes.
      103   if mBatchMode = ? then do:
      104     mVisCUrentVin = current-window:visible.
      105     mFameOldVis = mFramBachModHandle:visible.
      106     mFramBachModHandle:visible  = yes.
      107     mBatchMode = mFramBachModHandle:visible ne yes.
      108     mFramBachModHandle:visible = mFameOldVis.
      109     current-window:visible = mVisCUrentVin.
      110   end.
      111    if  log-manager:logfile-name ne ?
      112     then DO:
      113         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      114         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      115         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      116     end.
      117   on choose of B-WaitFramStop in frame waitfram
      118   do:
      119     mWaitFramStop = yes.
      120     mWaitFramStopUser = yes.
      121   end.
      122   function waitfram-check-timeout returns logical():
      123      define variable vtime as int64 no-undo.
      124      if mWaitFramStopTimeOut
      125      then
      126         return yes.
      127      vtime = ( now - mWaitFramStartProc ) / 1000 .
      128      if     mWaitFramTimeOut ne ?
      129         and mWaitFramTimeOut ne 0
      130         and mWaitFramTimeOut lt vtime
      131      then do:
      132         mWaitFramStopTimeOut = yes.
      133      end.
      134      return mWaitFramStopTimeOut.
      135   end.
      136   procedure waitfram-hide :
      137     if not session:batch-mode
      138     then do
      139     on error undo, return error return-value
      140     :
      141       pause 0 before-hide .
      142       if not mBatchMode then
      143         hide frame waitfram .
      144     if     not mWaitFramView
      145        and mWaitProcEvent
      146     then
      147       process events .
      148     end.
      149   end procedure.
      150   procedure waitfram-show :
      151     define input  parameter p-message as character no-undo .
      152     define variable v-left-margin as integer   no-undo .
      153     if not session:batch-mode
      154     then do
      155     on error undo, return error return-value
      156     :
      157       if length(p-message) <= 70 then do:
      158         assign
      159           v-left-margin = integer((70 - length(p-message)) / 2)
      160         .
      161         assign
      162           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      163         .
      164         assign
      165           v-waitfram-action01 = " "
      166           v-waitfram-action02 = " "
      167                                    + fill(" ", v-left-margin)
      168                                    + p-message
      169           v-waitfram-action03 = " "
      170         .
      171       end.
      172       else do:
      173         define variable vRindex1 as integer no-undo.
      174         define variable vRindex2 as integer no-undo.
      175         vRindex1 = r-index(p-message," ",70).
      176         if vRindex1 = 0
      177         then
      178            vRindex1 = 70.
      179         if length(p-message)  <= vRindex1 + 70 then do:
      180           assign
      181             v-waitfram-action01 = " "
      182             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      183             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      184           .
      185         end.
      186         else do:
      187           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      188           if vRindex2 <= vRindex1
      189           then
      190              vRindex2 = vRindex1 + 70.
      191           assign
      192             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      193             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      194             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      195           .
      196         end.
      197       end.
      198       B-viewProcInfo:visible   in frame waitfram = no.
      199       B-viewProcInfo:sensitive in frame waitfram = no.
      200       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      201       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      202       if  (   mWaitFramView
      203          or  mWaitProcEvent)
      204          and not mBatchMode
      205       then
      206          display
      207             v-waitfram-action01 skip
      208             v-waitfram-action02 skip
      209             v-waitfram-action03 skip
      210          with frame waitfram .
      211       if     mWaitFramView
      212          then do:
      213             if     mWaitFramInterval ne ?
      214                and not mBatchMode
      215             then
      216                wait-for go of frame waitfram pause mWaitFramInterval.
      217          end.
      218          else
      219             if     mWaitProcEvent
      220                and not mBatchMode
      221             then
      222                process events .
      223     end.
      224   end procedure.
      225      procedure waitfram-show-this:
      226         define input  parameter iInterval as int64 no-undo.
      227         define variable vtime as int64 no-undo.
      228         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      229         mWaitFramInterval = iInterval.
      230         run waitfram-show (substitute("&1&2 &3&4" ,
      231                                       mWaitFramTextBeg ,
      232                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      233                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      234                                       mWaitFramTextEnd
      235                                      )
      236                           ).
      237      end.
      238      procedure WaitFramRunPause:
      239         define input  parameter iInterval as dec no-undo.
      240         define variable vStart  as datetime-tz no-undo.
      241         define variable vend    as datetime-tz no-undo.
      242         define variable vint as int64 no-undo.
      243         define variable vOk as logical no-undo.
      244         vStart = now.
      245         vend   = vStart.
      246         publish "WaitFramPause" (iInterval,output vOk).
      247         vend   =  now.
      248         vint = vend - vStart.
      249         vint = iInterval - vint / 1000.
      250         if     not mWaitFramStop
      251            and (   vint > 0
      252                 or (    not vOk
      253                     and iInterval eq ?
      254                     )
      255                 )
      256         then
      257            run waitfram-show-this (iInterval).
      258         vend   =  now.
      259         vint = vend - vStart.
      260         vint = iInterval - vint / 1000.
      261         if     not mWaitFramStop
      262            and vint > 0
      263         then do:
      264            run gbl/pause.p (vint * 1000).
      265         end.
      266         if iInterval ne ?
      267         then
      268            publish "WaitFramStop".
      269         waitfram-check-timeout().
      270      end.
      271      procedure WaitFramWaitFor:
      272         define input  parameter iInterval as dec no-undo.
      273         assign
      274            mWaitFramStartProc   = now
      275            mWaitFramStopUser    = no
      276            mWaitFramStopTimeOut = no
      277         .
      278         block-wait:
      279         do while not mWaitFramStop:
      280            run WaitFramRunPause (iInterval).
      281            if  waitfram-check-timeout()
      282            then do:
      283               leave block-wait.
      284            end.
      285         end.
      286         run waitfram-hide.
      287      end.
      288   procedure waitfram-join :
      289     define input  parameter p-line-1  as character no-undo .
      290     define input  parameter p-line-2  as character no-undo .
      291     define input  parameter p-line-3  as character no-undo .
      292     define output parameter p-message as character no-undo .
      293     do
      294     on error undo, return error return-value
      295     :
      296       assign
      297         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      298                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      299                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      300       .
      301     end.
      302   end procedure.
      303   function waitfram-join-function returns character
      304     (input p-line-1 as character
      305     ,input p-line-2 as character
      306     ,input p-line-3 as character
      307     ).
      308     define variable v-message as character no-undo .
      309     run waitfram-join in this-procedure
      310       (input  p-line-1
      311       ,input  p-line-2
      312       ,input  p-line-3
      313       ,output v-message
      314       ) .
      315     return v-message .
      316   end function .
      317   define new global shared variable g#language as character no-undo .
      318   if g#language <> '' and g#language <> 'rus':U then do:
      319     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      320   end.
      321   procedure proc-alt-shift-f2:
      322     if not ibs.th.gbl.gbl-var:rcode
      323   then
      324     run gbl\inidebug.p .
      325   end.
      326   procedure proc-alt-shift-f3:
      327     run gbl/prvssinf.p
      328       ( input this-procedure
      329       ) .
      330   end.
      331   define variable v-inform-launched as logical no-undo initial false .
      332   procedure proc-alt-shift-f4:
      333     define variable v-action as character no-undo .
      334     if v-inform-launched = false then do:
      335       assign
      336         v-inform-launched = true
      337       .
      338       run gbl/d-inform.w
      339         (  input self
      340         ,  input this-procedure
      341         , output v-action
      342         ) no-error .
      343       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      344       assign
      345         v-inform-launched = false
      346       .
      347     end.
      348   end.
      349   procedure proc-alt-f1:
      350     run gbl/corrhelp.p
      351       (input this-procedure
      352       ) .
      353   end .
      354   on alt-shift-f2 anywhere do:
      355     run proc-alt-shift-f2.
      356   end.
      357   on alt-shift-f3 anywhere do:
      358     run proc-alt-shift-f3 in this-procedure .
      359   end.
      360   on alt-shift-f4 anywhere do:
      361     run proc-alt-shift-f4 in this-procedure.
      362   end.
      363   on alt-f1 anywhere do:
      364     run proc-alt-f1 in this-procedure .
      365   end.
      366   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      367   FUNCTION mark-string RETURNS CHARACTER
      368     ( input p-recid as recid, input mark-list as character  ) :
      369     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      370   END FUNCTION.
      371   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      372     define variable v-cntxt-db-num        as integer   no-undo .
      373     define variable v-cntxt-userid        as character no-undo .
      374     define variable v-cntxt-level         as character no-undo .
      375     define variable v-cntxt-host-code-obj as integer   no-undo .
      376     define variable v-cntxt-obj-type      as character no-undo .
      377     define variable v-cntxt-obj-code      as integer   no-undo .
      378     define variable v-cntxt-db-num-obj    as integer   no-undo .
      379     define variable v-cntxt-is-admin      as logical   no-undo .
      380   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      381   procedure gen-key-rec :
      382     define input  parameter p-tbl-name    as character no-undo.
      383     define input  parameter p-bh_tbl-name as handle    no-undo.
      384     define output parameter p-key-rec     as character no-undo.
      385     do
      386     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      387     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      388     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      389     :
      390       define variable fh               as handle    no-undo .
      391       define variable v-ok             as logical   no-undo .
      392       define variable v-inform         as character no-undo .
      393       define variable v-ind            as integer   no-undo .
      394       define variable v-idx-field-qnty as integer   no-undo .
      395       if p-tbl-name = ?
      396         or p-tbl-name = "":U
      397       then do:
      398         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      399       end.
      400       if not p-bh_tbl-name:available then do:
      401         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      402       end.
      403       assign
      404         p-key-rec = p-tbl-name
      405         v-inform  = p-bh_tbl-name:index-information(1)
      406         v-ind     = 2
      407       .
      408       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      409       on error undo, return error
      410       :
      411         assign
      412           v-inform = p-bh_tbl-name:index-information( v-ind )
      413           v-ind    = v-ind + 1
      414         .
      415       end.
      416       if v-inform = ?
      417         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      418         or entry( 3, v-inform, ",":U ) <> "1":U
      419       then do:
      420         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      421       end.
      422       else do:
      423         assign
      424           v-idx-field-qnty = num-entries( v-inform ) - 4
      425         .
      426         if v-idx-field-qnty < 2 then do:
      427           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      428         end.
      429         do v-ind = 1 to v-idx-field-qnty by 2
      430         on error undo, return error
      431         :
      432           assign
      433             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      434             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      435           .
      436         end.
      437       end.
      438       if p-key-rec = ? then do:
      439         assign
      440           p-key-rec = "":U
      441         .
      442         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      443       end.
      444     end.
      445     return.
      446   end procedure.
      447   procedure gen-where-keyr-tab :
      448     define input  parameter i-tableSerach as character no-undo.
      449     define input  parameter i-tablekey   as character  no-undo.
      450     define input  parameter p-key-rec    as character  no-undo.
      451     define input  parameter p-key-handle as handle     no-undo .
      452     define input  parameter p-db-name    as character  no-undo .
      453     define input  parameter p-tt-handle  as handle     no-undo .
      454     define output parameter o-Where      as character  no-undo.
      455     do
      456     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      457     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      458     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      459     :
      460       define variable v-full-tbl-name  as character no-undo .
      461       define variable bh_tbl-name      as handle    no-undo .
      462       define variable fh_key           as handle    no-undo .
      463       define variable fh_search        as handle    no-undo .
      464       define variable v-field-num      as integer   no-undo .
      465       define variable v-count-fld      as integer   no-undo .
      466       define variable v-inform         as character no-undo .
      467       define variable v-ind            as integer   no-undo .
      468       define variable v-idx-field-qnty as integer   no-undo .
      469       define variable v-field-name     as character no-undo .
      470       define variable v-field-val      as character no-undo .
      471       define variable v-word-link      as character no-undo .
      472       define variable vTable           as character no-undo.
      473       define variable bh_tbl-key       as handle    no-undo .
      474       assign
      475         p-key-rec = trim( p-key-rec )
      476       .
      477       if p-key-handle <> ? then do:
      478         if not valid-handle(p-key-handle)
      479            or p-key-handle:type <> "buffer"
      480         then do:
      481           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      482         end.
      483         if num-entries( p-key-rec, chr(3) ) > 1
      484           or p-key-rec = ?
      485           or p-key-rec = "":U
      486         then do:
      487           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      488         end.
      489       end.
      490       else do:
      491         if p-key-rec = ?
      492           or p-key-rec = "":U
      493         then do:
      494           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      495         end.
      496       end.
      497       assign
      498         vTable = entry( 1 , p-key-rec, chr(3) )
      499       .
      500       if p-tt-handle <> ?
      501         and ( not valid-handle(p-tt-handle)
      502               or p-tt-handle:type <> "buffer"
      503             )
      504       then do:
      505         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      506       end.
      507       if p-tt-handle = ? then do:
      508         assign
      509           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      510         .
      511         create buffer bh_tbl-name for table v-full-tbl-name .
      512       end.
      513       else do:
      514         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      515       end.
      516       assign
      517         v-inform = bh_tbl-name:index-information(1)
      518         v-ind    = 2
      519       .
      520       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      521       on error undo, return error
      522       :
      523         assign
      524           v-inform = bh_tbl-name:index-information( v-ind )
      525           v-ind    = v-ind + 1
      526         .
      527       end.
      528       if v-inform = ?
      529         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      530         or entry( 3, v-inform, ",":U ) <> "1":U
      531       then do:
      532         delete object bh_tbl-name no-error.
      533         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      534       end.
      535       assign
      536         v-idx-field-qnty = num-entries( v-inform ) - 4
      537       .
      538       if v-idx-field-qnty < 2 then do:
      539         delete object bh_tbl-name no-error.
      540         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      541       end.
      542       assign
      543         o-where     = "where":U
      544         v-word-link = "":U
      545         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      546         v-count-fld = 0
      547       .
      548       if i-tablekey ne "" and i-tablekey ne ?
      549       then do:
      550         assign
      551           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      552         .
      553         create buffer bh_tbl-key for table v-full-tbl-name .
      554       end.
      555       if i-tableSerach ne "" and i-tableSerach ne ?
      556       then do:
      557         delete object bh_tbl-name no-error.
      558         assign
      559           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      560         .
      561         create buffer bh_tbl-name for table v-full-tbl-name .
      562       end.
      563       block_where:
      564       do v-ind = 1 to v-idx-field-qnty by 2
      565       on error undo, return error
      566       :
      567         assign
      568           v-count-fld = v-count-fld + 1
      569         .
      570         if p-key-handle = ?
      571           and v-count-fld > v-field-num
      572         then do:
      573           leave block_where.
      574         end.
      575         define variable VfieldKeyTable as handle no-undo.
      576         assign
      577           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      578           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      579         .
      580         if     bh_tbl-key ne ?
      581         then do:
      582            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      583            if VfieldKeyTable eq ?
      584            then next block_where.
      585         end.
      586         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      587         then
      588            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      589         else
      590            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      591         if p-key-handle = ? then do:
      592           assign
      593             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      594           .
      595         end.
      596         else do:
      597           assign
      598             fh_key = p-key-handle:buffer-field( v-field-name )
      599           .
      600           if fh_key = ?
      601             or not valid-handle( fh_key )
      602           then do:
      603             delete object bh_tbl-name.
      604             if     bh_tbl-key ne ?
      605             then
      606                delete object bh_tbl-key.
      607             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      608           end.
      609           assign
      610             v-field-val = fh_key:buffer-value
      611           .
      612         end.
      613         if fh_search:data-type ="character":U then do:
      614           assign
      615             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      616             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      617             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      618             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      619             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      620             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      621             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      622             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      623             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      624             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      625             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      626             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      627             v-field-val = substitute( '"&1"', v-field-val )
      628           .
      629         end.
      630         assign
      631           o-where = substitute( "&1 &2", o-where, v-field-val )
      632         .
      633         if v-word-link = "":U then do:
      634           assign
      635             v-word-link = "and":U
      636           .
      637         end.
      638       end.
      639       delete object bh_tbl-name.
      640       if     bh_tbl-key ne ?
      641       then
      642          delete object bh_tbl-key.
      643       if p-key-handle = ?
      644         and v-count-fld <> v-field-num
      645       then do:
      646         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      647       end.
      648     end.
      649   end procedure.
      650   procedure gen-hn-keyr-tab :
      651     define input  parameter i-tableSerach as character no-undo.
      652     define input  parameter i-tablekey   as character no-undo.
      653     define input  parameter p-key-rec    as character no-undo.
      654     define input  parameter p-key-handle as handle    no-undo .
      655     define input  parameter p-db-name    as character no-undo .
      656     define input  parameter p-tt-handle  as handle    no-undo .
      657     define input  parameter p-stts-lock  as integer   no-undo .
      658     define output parameter o-hn         as handle    no-undo.
      659     define variable v-full-tbl-name as character no-undo.
      660     define variable v-where         as character no-undo.
      661     define variable bh_tbl-name     as handle    no-undo.
      662     define variable vTable          as character no-undo.
      663     do
      664     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      665     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      666     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      667         run gen-where-keyr-tab(i-tableSerach,
      668                                i-tablekey,
      669                                p-key-rec,
      670                                p-key-handle,
      671                                p-db-name,
      672                                p-tt-handle,
      673                                output v-where).
      674         if i-tableSerach ne "" and i-tableSerach ne ?
      675         then do:
      676            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      677            create buffer bh_tbl-name for table v-full-tbl-name .
      678         end.
      679         else do:
      680            if p-tt-handle = ? then do:
      681               assign
      682                  vTable = entry( 1 , p-key-rec, chr(3) )
      683               .
      684               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      685               create buffer bh_tbl-name for table v-full-tbl-name .
      686            end.
      687            else do:
      688               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      689            end.
      690         end.
      691         if p-tt-handle = ? then do:
      692            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      693         end.
      694         else do:
      695            bh_tbl-name:find-first( v-where ) no-error .
      696         end.
      697         o-hn = bh_tbl-name.
      698      end.
      699   end procedure.
      700   procedure gen-hn-keyr :
      701     define input  parameter p-key-rec    as character no-undo.
      702     define input  parameter p-key-handle as handle    no-undo .
      703     define input  parameter p-db-name    as character no-undo .
      704     define input  parameter p-tt-handle  as handle    no-undo .
      705     define input  parameter p-stts-lock  as integer   no-undo .
      706     define output parameter o-hn         as handle    no-undo.
      707     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      708   end.
      709   procedure gen-row-keyr :
      710     define input  parameter p-key-rec    as character no-undo.
      711     define input  parameter p-key-handle as handle    no-undo .
      712     define input  parameter p-db-name    as character no-undo .
      713     define input  parameter p-tt-handle  as handle    no-undo .
      714     define input  parameter p-stts-lock  as integer   no-undo .
      715     define output parameter p-tbl-row    as rowid     no-undo.
      716     define output parameter p-tbl-name   as character no-undo.
      717     define variable vHn as handle no-undo.
      718       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      719       p-tbl-row = if vHn:available then vHn:rowid else ?.
      720       p-tbl-name =  vHn:table.
      721       delete object vHn no-error.
      722     if p-tbl-row = ? then do:
      723       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      724     end.
      725     else do:
      726       return.
      727     end.
      728   end procedure.
      729   procedure gen-key-fv :
      730     define input  parameter p-key-rec    as character no-undo .
      731     define output parameter p-field-list as character no-undo .
      732     define output parameter p-value-list as character no-undo.
      733     do
      734     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      735     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      736     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      737     :
      738       define variable v-full-tbl-name  as character no-undo .
      739       define variable bh_tbl-name      as handle    no-undo .
      740       define variable v-tbl-name       as character no-undo .
      741       define variable v-field-num      as integer   no-undo .
      742       define variable v-count-fld      as integer   no-undo .
      743       define variable v-inform         as character no-undo .
      744       define variable v-ind            as integer   no-undo .
      745       define variable v-idx-field-qnty as integer   no-undo .
      746       define variable v-delim-key      as character no-undo .
      747       if p-key-rec = ?
      748         or p-key-rec = "":U
      749       then do:
      750         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      751       end.
      752       assign
      753         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      754         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      755       .
      756       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      757       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      758       assign
      759         v-inform = bh_tbl-name:index-information(1)
      760         v-ind    = 2
      761       .
      762       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      763       on error undo, return error
      764       :
      765         assign
      766           v-inform = bh_tbl-name:index-information( v-ind )
      767           v-ind    = v-ind + 1
      768         .
      769       end.
      770       if v-inform = ?
      771         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      772         or entry( 3, v-inform, ",":U ) <> "1":U
      773       then do:
      774         delete object bh_tbl-name no-error.
      775         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      776       end.
      777       assign
      778         v-idx-field-qnty = num-entries( v-inform ) - 4
      779       .
      780       if v-idx-field-qnty < 2 then do:
      781         delete object bh_tbl-name no-error.
      782         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      783       end.
      784       assign
      785         p-field-list = "":U
      786         p-value-list = "":U
      787         v-delim-key  = "":U
      788         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      789         v-count-fld  = 0
      790       .
      791       block_where:
      792       do v-ind = 1 to v-idx-field-qnty by 2
      793       on error undo, return error
      794       :
      795         assign
      796           v-count-fld = v-count-fld + 1
      797         .
      798         if v-count-fld > v-field-num then do:
      799           leave block_where.
      800         end.
      801         assign
      802           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      803           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      804         .
      805         if v-ind = 1 then do:
      806           assign
      807             v-delim-key = chr(3)
      808           .
      809         end.
      810       end.
      811       delete object bh_tbl-name.
      812       if v-count-fld <> v-field-num then do:
      813         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      814       end.
      815     end.
      816   end procedure.
      817   procedure gen-key-field :
      818     define input  parameter p-table      as character no-undo .
      819     define output parameter p-field-list as character no-undo .
      820     do
      821     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      822     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      823     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      824     :
      825       define variable v-full-tbl-name  as character no-undo .
      826       define variable bh_tbl-name      as handle    no-undo .
      827       define variable v-tbl-name       as character no-undo .
      828       define variable v-field-num      as integer   no-undo .
      829       define variable v-count-fld      as integer   no-undo .
      830       define variable v-inform         as character no-undo .
      831       define variable v-ind            as integer   no-undo .
      832       define variable v-idx-field-qnty as integer   no-undo .
      833       define variable v-delim-key      as character no-undo .
      834       if p-table = ?
      835         or p-table = "":U
      836       then do:
      837         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
      838       end.
      839       assign
      840         v-tbl-name      = p-table
      841         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      842       .
      843       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      844       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
      845       assign
      846         v-inform = bh_tbl-name:index-information(1)
      847         v-ind    = 2
      848       .
      849       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      850       on error undo, return error
      851       :
      852         assign
      853           v-inform = bh_tbl-name:index-information( v-ind )
      854           v-ind    = v-ind + 1
      855         .
      856       end.
      857       if v-inform = ?
      858         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      859         or entry( 3, v-inform, ",":U ) <> "1":U
      860       then do:
      861         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      862       end.
      863       assign
      864         v-idx-field-qnty = num-entries( v-inform ) - 4
      865       .
      866       if v-idx-field-qnty < 2 then do:
      867         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      868       end.
      869       assign
      870         p-field-list = "":U
      871         v-delim-key  = "":U
      872         v-count-fld  = 0
      873       .
      874       block_where:
      875       do v-ind = 1 to v-idx-field-qnty by 2
      876       on error undo, return error
      877       :
      878         assign
      879           v-count-fld = v-count-fld + 1
      880         .
      881         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      882         if v-ind = 1 then do:
      883           assign
      884             v-delim-key = chr(3)
      885           .
      886         end.
      887       end.
      888       delete object bh_tbl-name.
      889     end.
      890   end procedure.
      891   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      892   define variable c-point  as character no-undo .
      893   define variable tbl      as character no-undo .
      894   define variable join-tbl as character no-undo .
      895   define variable fld      as character no-undo .
      896   define variable lab      as character no-undo .
      897   define variable spr      as character no-undo .
      898   define variable dim      as character no-undo .
      899   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      900   procedure fltfield-clear :
      901     define output parameter loc-fld as character no-undo.
      902     define output parameter loc-lab as character no-undo .
      903     define output parameter loc-spr as character no-undo .
      904     define output parameter loc-dim as character no-undo .
      905     assign
      906       loc-fld = ""
      907       loc-lab = ""
      908       loc-spr = ""
      909       loc-dim = "0"
      910     .
      911   end procedure .
      912   procedure fltfield-add :
      913     define input        parameter par-fld as character no-undo.
      914     define input        parameter par-lab as character no-undo .
      915     define input        parameter par-spr as character no-undo .
      916     define input-output parameter loc-fld as character no-undo.
      917     define input-output parameter loc-lab as character no-undo .
      918     define input-output parameter loc-spr as character no-undo .
      919     define input-output parameter loc-dim as character no-undo .
      920     do
      921     on error undo, return error
      922     :
      923       assign
      924       loc-fld = if loc-dim = '0'
      925                 then par-fld
      926                 else (loc-fld + chr(44) + par-fld)
      927       loc-lab = if loc-dim = '0'
      928                 then par-lab
      929                 else (loc-lab + chr(44) + par-lab)
      930       loc-spr = if loc-dim = '0'
      931                 then par-spr
      932                 else (loc-spr + chr(44) + par-spr)
      933       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      934                 string(integer(if num-entries(loc-dim) > 1
      935                               then entry(2, loc-dim)
      936                               else entry(1, loc-dim)
      937                               ) + 1)
      938       no-error
      939       .
      940     end.
      941   end procedure.
      942   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      943   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      944   procedure fltopend_fltopend :
      945   define input parameter p-parent-handle as handle no-undo .
      946   define input parameter p-qh as handle no-undo .
      947   define input parameter p-flt-open-open-query  as character no-undo .
      948   define input parameter p-where-cond as character no-undo .
      949   define input parameter p-use-indFIRST-query-tail as character no-undo .
      950   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      951   define input parameter p-indexed-reposition as character no-undo .
      952     do
      953     on error undo, return error
      954     :
      955   define variable v-prepare-string as character no-undo .
      956   define variable glog as logical no-undo .
      957   assign
      958   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      959                      p-where-cond + chr(32)  +
      960                      p-use-indFIRST-query-tail + chr(32) +
      961                      p-use-ind-sort-clmn-by + chr(32) +
      962                      p-indexed-reposition
      963   .
      964   assign
      965   glog = p-qh:query-prepare(v-prepare-string) no-error .
      966   if not glog
      967   or error-status:error then do:
      968     message error-status:get-message(1) view-as alert-box .
      969     undo, return error .
      970   end.
      971   assign
      972   glog = p-qh:query-open no-error .
      973   if not glog
      974   or error-status:error then do:
      975     message error-status:get-message(1) view-as alert-box .
      976     undo, return error .
      977   end.
      978     end.
      979   end procedure.
      980   procedure fltopend_fltfindd :
      981   define input parameter p-parent-handle as handle no-undo .
      982   define input parameter p-qh as handle no-undo .
      983   define input parameter p-rowid as rowid no-undo .
      984   define input parameter p-next as logical no-undo .
      985   define input parameter p-lock as integer no-undo .
      986   define input parameter p-bh as handle no-undo .
      987   define input parameter p-where-cond as character no-undo .
      988   define input parameter p-use-index-phrase as character no-undo .
      989   define variable glog as logical no-undo .
      990   define variable v-qh as handle no-undo .
      991   define variable v-bh as handle no-undo .
      992   define variable v-recid as recid no-undo .
      993   define variable v-prepare-string as character no-undo .
      994   do
      995   on error undo, return error
      996   on stop undo, return error
      997   :
      998     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      999     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1000     create query v-qh.
     1001     v-qh:set-buffers(v-bh).
     1002     v-prepare-string = substitute("for each &1 &2 &3"
     1003                                     ,v-bh:name
     1004                                     ,p-where-cond
     1005                                     ,p-use-index-phrase).
     1006     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1007     if not glog then do:
     1008       delete object v-qh.
     1009       delete object v-bh.
     1010       undo, return error .
     1011     end.
     1012     glog = v-qh:query-open no-error .
     1013     if not glog then do:
     1014       delete object v-qh.
     1015       delete object v-bh.
     1016       undo, return error .
     1017     end.
     1018     if p-next then do:
     1019       v-qh:reposition-to-rowid(p-rowid) no-error .
     1020       glog = v-qh:get-next( p-lock) no-error .
     1021       glog = v-qh:get-next( p-lock) no-error .
     1022       if not glog or v-qh:query-off-end = yes then do:
     1023         glog = v-qh:get-first( p-lock) no-error .
     1024       end.
     1025     end.
     1026     else do:
     1027       glog = v-qh:get-first( p-lock) no-error .
     1028     end.
     1029     v-recid = v-bh:recid no-error .
     1030     delete object v-qh.
     1031     delete object v-bh.
     1032     return string(v-recid) .
     1033   end.
     1034   end procedure.
     1035   procedure fltopend_fltfindq :
     1036   define input parameter p-parent-handle as handle no-undo .
     1037   define input parameter p-qh as handle no-undo .
     1038   define input parameter p-next as logical no-undo .
     1039   define input parameter p-lock as integer no-undo .
     1040   define input parameter p-flt-open-open-query  as character no-undo .
     1041   define input parameter p-where-cond as character no-undo .
     1042   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1043   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1044   define input parameter p-indexed-reposition as character no-undo .
     1045   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1046   define variable glog as logical no-undo .
     1047   define variable v-qh as handle no-undo .
     1048   define variable v-bh as handle no-undo extent 18.
     1049   define variable v-rowid as rowid no-undo extent 18.
     1050   define variable v-ii as integer no-undo .
     1051   define variable v-prepare-string as character no-undo .
     1052   do
     1053   on error undo, return error
     1054   on stop undo, return error
     1055   :
     1056     create query v-qh.
     1057     do v-ii = 1 to p-qh:num-buffers:
     1058       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1059       assign
     1060       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1061       no-error.
     1062       v-qh:add-buffer(v-bh[v-ii]).
     1063     end.
     1064     assign
     1065     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1066                       p-where-cond + chr(32)  +
     1067                       p-use-indFIRST-query-tail + chr(32) +
     1068                       p-use-ind-sort-clmn-by + chr(32) +
     1069                       p-indexed-reposition
     1070     .
     1071     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1072     if not glog then do:
     1073       delete object v-qh.
     1074       do v-ii = 1 to p-qh:num-buffers:
     1075         delete object v-bh[v-ii].
     1076       end.
     1077       undo, return error .
     1078     end.
     1079     glog = v-qh:query-open no-error .
     1080     if not glog then do:
     1081       delete object v-qh.
     1082       do v-ii = 1 to p-qh:num-buffers:
     1083         delete object v-bh[v-ii].
     1084       end.
     1085       undo, return error .
     1086     end.
     1087     if p-next then do:
     1088       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1089       glog = v-qh:get-next( p-lock) no-error .
     1090       glog = v-qh:get-next( p-lock) no-error .
     1091       if not glog or v-qh:query-off-end = yes then do:
     1092         glog = v-qh:get-first( p-lock) no-error .
     1093       end.
     1094     end.
     1095     else do:
     1096       glog = v-qh:get-first( p-lock) no-error .
     1097     end.
     1098     do v-ii = 1 to p-qh:num-buffers:
     1099       assign
     1100       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1101       no-error.
     1102     end.
     1103     delete object v-qh.
     1104     do v-ii = 1 to p-qh:num-buffers:
     1105       delete object v-bh[v-ii].
     1106     end.
     1107   end.
     1108   end procedure.
     1109   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
     1110   define variable v-admin as logical no-undo .
     1111   DEFINE VARIABLE link-option AS CHARACTER NO-UNDO.
     1112   define variable v-rid-list as character no-undo .
     1113   DEFINE VARIABLE lkp-option AS CHARACTER NO-UNDO.
     1114   define variable sort-column-name as character no-undo .
     1115   define variable filter-point-label as character no-undo init "Список раскладок" .
     1116   define variable filter-point0 as character no-undo init "layoutss" .
     1117   define variable filter-point as character no-undo init "layoutss" .
     1118   DEFINE BUTTON b-add
     1119        LABEL "&Добавить"
     1120        SIZE 10 BY 1.
     1121   DEFINE BUTTON b-chg
     1122        LABEL "&Изменить"
     1123        SIZE 10 BY 1.
     1124   DEFINE BUTTON b-copy
     1125        LABEL "&Копировать"
     1126        SIZE 10 BY 1.
     1127   DEFINE BUTTON b-del
     1128        LABEL "&Удалить"
     1129        SIZE 10 BY 1.
     1130   DEFINE BUTTON B-Help
     1131        LABEL "Помо&щь"
     1132        SIZE 3 BY 1
     1133        BGCOLOR 8 .
     1134   DEFINE BUTTON b-hist
     1135        LABEL "Btn 1"
     1136        SIZE 3 BY 1.
     1137   DEFINE BUTTON b-lkp
     1138        LABEL "&Просмотр"
     1139        SIZE 10 BY 1.
     1140   DEFINE BUTTON b-mark
     1141        LABEL "&*"
     1142        SIZE 4 BY 1.
     1143   DEFINE BUTTON b-quit AUTO-END-KEY
     1144        LABEL "&Выход"
     1145        SIZE 10 BY 1
     1146        BGCOLOR 8 .
     1147   DEFINE BUTTON b-sch
     1148        LABEL "&Фильтр"
     1149        SIZE 3 BY 1.
     1150   DEFINE BUTTON b-sel AUTO-GO
     1151        LABEL "Выбор"
     1152        SIZE 10 BY 1.
     1153   DEFINE VARIABLE EDITOR-des AS CHARACTER
     1154        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1155        SIZE 97 BY 3 NO-UNDO.
     1156   DEFINE VARIABLE mark-num AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
     1157         VIEW-AS TEXT
     1158        SIZE 9 BY .67
     1159        FGCOLOR 10  NO-UNDO.
     1160   DEFINE QUERY br-layout FOR
     1161         X_layout SCROLLING.
     1162   DEFINE BROWSE br-layout
     1163     QUERY br-layout NO-LOCK DISPLAY
     1164         mark-string(recid(X_layout), v-rid-list) Format "X(1)" COLUMN-LABEL "*"
     1165   entry (lookup (X_layout.layout-type, 'th-pos-screen,th-pos-keyboard':U) + 1, ',' + 'Экран IBS TH POS,Клавиатура IBS TH POS':U) COLUMN-LABEL "Тип раскладки" FORMAT "X(255)" WIDTH 22
     1166   X_layout.device-type COLUMN-LABEL "Устройства" FORMAT "X(15)"
     1167   entry (lookup (string(X_layout.is-default), '0,1,-1':U) + 1, ',' + 'Пользовательская,Шаблон IBS TH,Обязательная':U) COLUMN-LABEL "Вид раскладки" FORMAT "X(13)"
     1168   entry (lookup (string(X_layout.sts), '0,1,50,99':U), 'тек,удал,блок,удаление':U) COLUMn-label "Статус" format "X(6)"
     1169   X_layout.layout-name COLUMN-LABEL "Название" FORMAT "X(255)" WIDTH 35
     1170   X_layout.layout-id COLUMN-LABEL "ID Раскладки" FORMAT "X(15)"
     1171       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 17.5 FIT-LAST-COLUMN.
     1172   DEFINE FRAME Dialog-Frame
     1173        b-quit AT ROW 1 COL 1
     1174        b-mark AT ROW 1 COL 20 WIDGET-ID 12
     1175        b-sel AT ROW 1 COL 24 WIDGET-ID 10
     1176        b-add AT ROW 1 COL 34 WIDGET-ID 2
     1177        b-copy AT ROW 1 COL 44 WIDGET-ID 18
     1178        b-chg AT ROW 1 COL 54 WIDGET-ID 4
     1179        b-del AT ROW 1 COL 64 WIDGET-ID 8
     1180        b-lkp AT ROW 1 COL 74 WIDGET-ID 6
     1181        b-sch AT ROW 1 COL 89 WIDGET-ID 16
     1182        b-hist AT ROW 1 COL 92 WIDGET-ID 22
     1183        B-Help AT ROW 1 COL 95
     1184        br-layout AT ROW 2.33 COL 1.5 WIDGET-ID 100
     1185        EDITOR-des AT ROW 19.88 COL 1.5 NO-LABEL WIDGET-ID 20
     1186        mark-num AT ROW 1 COL 11 NO-LABEL WIDGET-ID 14
     1187        SPACE(78.59) SKIP(21.21)
     1188       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1189            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1190            TITLE ""
     1191            CANCEL-BUTTON b-quit.
     1192   ASSIGN
     1193          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1194          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1195   ASSIGN
     1196          EDITOR-des:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1197   ON GO OF FRAME Dialog-Frame
     1198   DO:
     1199     p-rid-list = v-rid-list.
     1200   END.
     1201   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1202   DO:
     1203     APPLY "END-ERROR":U TO SELF.
     1204   END.
     1205   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     1206   DO:
     1207    define variable v-rec as recid no-undo.
     1208     run adm/layout-i.w ( input parparentproc
     1209                          ,input 'ДОБАВЛЕНИЕ':U + (if v-admin then (chr(44) + "admin") else '')
     1210                          ,input ''
     1211                          ,input-output v-rec) no-error.
     1212     if v-rec <> ? then do:
     1213       RUN openbr IN THIS-PROCEDURE ( input yes, input no, input '':U).
     1214     end.
     1215   END.
     1216   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     1217   DO:
     1218     define variable v-rec as recid no-undo.
     1219     if not available X_layout then return no-apply.
     1220     v-rec = recid(X_layout).
     1221     if X_layout.is-default = integer('1':U)
     1222     and not v-admin then do:
     1223           message
     1224       substitute("Нельзя редактировать &1", entry (lookup (string(X_layout.is-default), '0,1,-1':U) + 1, ',' + 'Пользовательская,Шаблон IBS TH,Обязательная':U))
     1225       view-as alert-box error .
     1226       undo, return no-apply .
     1227     end.
     1228     run adm/layout-i.w ( input parparentproc
     1229                          ,input 'ИЗМЕНЕНИЕ':U + (if v-admin then ( chr(44) + "admin") else '')
     1230                          ,input X_layout.layout-id
     1231                          ,input-output v-rec) no-error.
     1232     if v-rec <> ? then do:
     1233        br-layout:refresh().
     1234     end.
     1235   END.
     1236   ON CHOOSE OF b-copy IN FRAME Dialog-Frame
     1237   DO:
     1238       IF NOT AVAILABLE X_layout THEN DO:
     1239        BELL.
     1240        RETURN NO-APPLY.
     1241       END.
     1242       RUN proc-b-copy IN THIS-PROCEDURE NO-ERROR.
     1243   IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     1244   END.
     1245   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1246   DO:
     1247     define variable v-rec as recid no-undo.
     1248     define variable glog as logical no-undo.
     1249     if not available X_layout then return no-apply.
     1250     v-rec = recid(X_layout).
     1251     message
     1252     "Вы уверены, что хотите удалить раскладку?"
     1253     view-as alert-box question buttons yes-no update glog.
     1254     if not glog then return no-apply.
     1255     run adm/layout30.p (
     1256                          buffer X_layout
     1257                             ) no-error.
     1258    if error-status:error then return no-apply.
     1259    run Openbr in this-procedure ( input yes, input no, input '':U).
     1260   END.
     1261   ON CHOOSE OF b-hist IN FRAME Dialog-Frame
     1262   DO:
     1263   define variable v-rid-list as character no-undo.
     1264         run adm/clayouts.w (
     1265                           input parparentproc
     1266                          , "":U
     1267                          , "one":U
     1268                          , X_layout.layout-id
     1269                          , input-output v-rid-list
     1270                       ) no-error.
     1271   END.
     1272   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1273   DO:
     1274   if not available X_layout then return no-apply.
     1275   run proc-b-lkp IN THIS-PROCEDURE ( INPUT 'layout':U) NO-ERROR.
     1276   IF ERROR-STATUS:ERROR THEN DO:
     1277       lkp-option = '':U.
     1278       RETURN NO-APPLY.
     1279   END.
     1280   lkp-option = '':U.
     1281   END.
     1282   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1283   DO:
     1284     define variable glog as logical no-undo .
     1285     if available X_layout then do:
     1286   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1287   define variable v-str-recid9 as character no-undo .
     1288   define variable v-num-entry9 as integer   no-undo .
     1289   assign
     1290     v-str-recid9 = trim( string( recid( X_layout ) , "->>>>>>>>>>>9":U ) )
     1291     v-num-entry9 = lookup( v-str-recid9 , v-rid-list )
     1292   .
     1293   if v-num-entry9 > 0 then do:
     1294     assign
     1295       entry( v-num-entry9, v-rid-list ) = "":U
     1296       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1297     .
     1298   end.
     1299   else do:
     1300     assign
     1301       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid9
     1302     .
     1303   end.
     1304     glog = br-layout:refresh() .
     1305     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1306         glog = br-layout:select-next-row ().
     1307         apply "VALUE-CHANGED" to br-layout in frame Dialog-Frame.
     1308     end.
     1309     if num-entries( v-rid-list ) = 0
     1310     then
     1311         hide mark-num in frame Dialog-Frame.
     1312     else
     1313         disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1314   end.
     1315   apply "entry" to br-layout in frame Dialog-Frame.
     1316   END.
     1317   ON CHOOSE OF b-sch IN FRAME Dialog-Frame
     1318   DO:
     1319     RUN proc-b-sch IN THIS-PROCEDURE NO-ERROR.
     1320     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     1321   END.
     1322   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1323   DO:
     1324     if available X_layout then do:
     1325       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1326       then  v-rid-list = string( recid( X_layout ) ) .
     1327     end.
     1328   END.
     1329   ON VALUE-CHANGED OF br-layout IN FRAME Dialog-Frame
     1330   DO:
     1331     if available X_layout then do:
     1332       editor-des:screen-value = X_layout.des.
     1333     end.
     1334     else do:
     1335         editor-des:screen-value = '' .
     1336     end.
     1337   END.
     1338   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1339   on f5 of frame Dialog-Frame anywhere
     1340   do:
     1341      v-doc-rec = recid(X_layout).    RUn OpenBR in this-procedure ( input yes, input no, input '':U).  REPOSITION br-layout to recid v-doc-rec No-ERROR.   apply 'value-changed' to br-layout.
     1342       apply "VALUE-CHANGED" to br-layout.
     1343   end.
     1344   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1345   on help of frame Dialog-Frame
     1346   do:
     1347     run gbl/app_help.p
     1348       (input this-procedure :file-name
     1349       ,input ''
     1350       ,input ?
     1351       ) no-error.
     1352     if error-status :error then do:
     1353       message
     1354         "Ошибка при вызове помощи"
     1355         error-status :get-message(1)
     1356         view-as alert-box .
     1357     end.
     1358   end.
     1359   run minbtn-set in this-procedure .
     1360   on choose of b-help in frame Dialog-Frame
     1361   do:
     1362     apply "help":u to frame Dialog-Frame .
     1363   end.
     1364   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1365   procedure minbtn-set :
     1366       do
     1367           on error undo, return error return-value
     1368           :
     1369           define variable ii              as integer       no-undo .
     1370           define variable fh              as widget-handle no-undo .
     1371           define variable hh              as widget-handle no-undo .
     1372           define variable v-h             as handle        extent 4 no-undo .
     1373           define variable v-name-button   as character     no-undo .
     1374           define variable v-help-old-x    as decimal       no-undo .
     1375           define variable v-help-old-y    as decimal       no-undo .
     1376           define variable v-help-old-size as decimal       no-undo .
     1377           define variable v-frame-width   as decimal       no-undo .
     1378           define variable jj              as integer       no-undo .
     1379           do
     1380               on error undo, return error
     1381               :
     1382               assign
     1383                   v-frame-width = frame Dialog-Frame:width - 0.3
     1384                   fh            = frame Dialog-Frame:first-child
     1385                   hh            = fh:first-child
     1386                   ii            = 1
     1387                   .
     1388               do while valid-handle(hh):
     1389                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1390                   do:
     1391                       case lc(hh:name) :
     1392                           when "b-help" then
     1393                               do:
     1394                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1395                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1396                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1397                                   hh:TOOLTIP = "Помощь" .
     1398                                   v-help-old-x = hh:column .
     1399                                   v-help-old-y = hh:row    .
     1400                                   v-help-old-size = hh:width .
     1401                                   hh:width-chars = 2.5 .
     1402                               end.
     1403                           when "b-print" then
     1404                               do:
     1405                                   hh:load-image("cmp/b-print.bmp":u) .
     1406                                   hh:TOOLTIP = "Печать" .
     1407                                   v-h[ii] = hh:handle .
     1408                                   ii = ii + 1 .
     1409                                   hh:width-chars = 3 .
     1410                               end.
     1411                           when "b-history" or
     1412                           when "b-hist" then
     1413                               do:
     1414                                   hh:load-image("cmp/b-hist.bmp":u) .
     1415                                   hh:TOOLTIP = "История" .
     1416                                   v-h[ii] = hh:handle .
     1417                                   ii = ii + 1 .
     1418                                   hh:width-chars = 3 .
     1419                               end.
     1420                           when "b-sch" then
     1421                               do:
     1422                                   hh:load-image("cmp/b-sch.bmp":u) .
     1423                                   hh:TOOLTIP = "Установка Фильтра" .
     1424                                   v-h[ii] = hh:handle .
     1425                                   ii = ii + 1 .
     1426                                   hh:width-chars = 3 .
     1427                               end.
     1428                           when "b-hist-user" then
     1429                               do:
     1430                                   hh:load-image("cmp/b-hist.bmp":u) .
     1431                                   hh:TOOLTIP = "История пользователя" .
     1432                                   ii = ii + 1 .
     1433                               end.
     1434                       end case.
     1435                   end.
     1436                   hh = hh:next-sibling.
     1437               end.
     1438               b-help:column = v-frame-width - b-help:width-chars.
     1439               jj = 0.
     1440               repeat ii = 4 to 1 by -1 :
     1441                   if valid-handle (v-h[ii] ) then
     1442                   do:
     1443                       jj  = jj + 1 .
     1444                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1445                       v-h[ii]:row    = v-help-old-y .
     1446                   end.
     1447               end.
     1448           end.
     1449       end.
     1450   end procedure.
     1451   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1452   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1453   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1454   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1455   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1456   define variable v-diasize-current-frame-height as decimal   no-undo .
     1457   define variable v-diasize-change-size          as logical   no-undo .
     1458   define variable v-diasize-resize-button        as handle    no-undo .
     1459   define variable v-diasize-wndmax               as logical   no-undo .
     1460   define variable v-diasize-wndstore             as logical   no-undo .
     1461   define variable v-diasize-proc-name            as character no-undo .
     1462   define variable v-diasize-browse-handle        as handle    no-undo .
     1463   define variable v-diasize-browse-number        as integer   no-undo .
     1464   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1465   define temp-table temp-diasize-handle no-undo
     1466     field handle-value  as handle
     1467     field save-position as decimal
     1468     index xpk is primary unique handle-value
     1469     .
     1470   define temp-table temp-browse-handle no-undo
     1471     field browse-type   as character
     1472     field browse-number as integer
     1473     field browse-handle as handle
     1474     field original-size as decimal
     1475     index xpk is primary unique browse-type browse-number
     1476     index xie browse-type browse-handle
     1477   .
     1478   procedure diasize_change-height :
     1479     define input  parameter p-change-value  as decimal   no-undo .
     1480     define input  parameter p-move-resize   as logical   no-undo .
     1481     define variable v-field-group-handle    as handle    no-undo .
     1482     define variable v-object-handle         as handle    no-undo .
     1483     define variable v-frame-height          as decimal   no-undo .
     1484     define variable v-frame-virtual-height  as decimal   no-undo .
     1485     define variable v-browse-height         as decimal   no-undo .
     1486     define variable v-window-height         as decimal   no-undo .
     1487     define variable v-window-virtual-height as decimal   no-undo .
     1488     define variable v-change-sign           as integer   no-undo .
     1489     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1490     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1491     if p-change-value > 0
     1492     then do:
     1493       if frame Dialog-Frame :height + p-change-value
     1494           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1495       then do:
     1496         assign
     1497           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1498                           - (frame Dialog-Frame :height-chars)
     1499         .
     1500         if p-change-value <= 0
     1501         then do:
     1502           run diasize_position-resize-button in this-procedure .
     1503           return .
     1504         end.
     1505       end.
     1506     end.
     1507     if p-change-value < 0
     1508     then do:
     1509       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1510       then do:
     1511         assign
     1512           p-change-value = v-diasize-orig-frame-height
     1513                          - (frame Dialog-Frame :height-chars)
     1514         .
     1515         if p-change-value >= 0
     1516         then do:
     1517           run diasize_position-resize-button in this-procedure .
     1518           return .
     1519         end.
     1520       end.
     1521     end.
     1522     if p-change-value >= 0
     1523     then do:
     1524       assign
     1525         v-change-sign = 1
     1526       .
     1527     end.
     1528     else do:
     1529       assign
     1530         v-change-sign = -1
     1531       .
     1532     end.
     1533     assign
     1534       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1535     .
     1536     if p-change-value = 0
     1537     then do:
     1538       run diasize_position-resize-button in this-procedure .
     1539       return .
     1540     end.
     1541     move_block:
     1542     do
     1543     on error undo move_block, retry move_block
     1544     :
     1545       if retry
     1546       then do:
     1547         do
     1548         on error undo move_block, leave move_block
     1549         :
     1550           if p-change-value > 0
     1551           then do:
     1552             for each buf_temp-diasize-handle
     1553             on error undo, next
     1554             :
     1555               assign
     1556                 v-object-handle = buf_temp-diasize-handle.handle-value
     1557               .
     1558               if v-object-handle <> v-diasize-resize-button
     1559               then do:
     1560                 assign
     1561                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1562                 .
     1563               end.
     1564             end.
     1565             assign
     1566               v-diasize-browse-handle :height = v-browse-height
     1567             .
     1568             for each buf_temp-browse-handle
     1569               where buf_temp-browse-handle.browse-type = 'height':u
     1570             on error undo, next
     1571             :
     1572               assign
     1573                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1574               .
     1575             end.
     1576             assign
     1577               frame Dialog-Frame :height = v-frame-height
     1578             .
     1579             if frame Dialog-Frame :scrollable = true
     1580             then do:
     1581               assign
     1582                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1583               .
     1584             end.
     1585             run diasize_position-resize-button in this-procedure .
     1586           end.
     1587           else do:
     1588             if frame Dialog-Frame :scrollable = true
     1589             then do:
     1590               assign
     1591                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1592               .
     1593             end.
     1594             assign
     1595               frame Dialog-Frame :height = v-frame-height
     1596             .
     1597             assign
     1598               v-diasize-browse-handle :height = v-browse-height
     1599             .
     1600             for each buf_temp-browse-handle
     1601               where buf_temp-browse-handle.browse-type = 'height':u
     1602             on error undo, next
     1603             :
     1604               assign
     1605                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1606               .
     1607             end.
     1608             for each buf_temp-diasize-handle
     1609             on error undo, next
     1610             :
     1611               assign
     1612                 v-object-handle = buf_temp-diasize-handle.handle-value
     1613               .
     1614               if v-object-handle <> v-diasize-resize-button
     1615               then do:
     1616                 assign
     1617                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1618                 .
     1619               end.
     1620             end.
     1621             run diasize_position-resize-button in this-procedure .
     1622           end.
     1623           assign
     1624             v-diasize-change-size = false
     1625           .
     1626           leave move_block .
     1627         end.
     1628       end.
     1629       assign
     1630         v-diasize-need-full-display = true
     1631       .
     1632       if v-diasize-change-size = false
     1633       then do:
     1634         assign
     1635           v-diasize-change-size = true
     1636         .
     1637       end.
     1638       else do:
     1639         return .
     1640       end.
     1641       assign
     1642         v-frame-height = frame Dialog-Frame :height
     1643         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1644         v-browse-height = v-diasize-browse-handle :height
     1645       .
     1646       for each buf_temp-browse-handle
     1647         where buf_temp-browse-handle.browse-type = 'height':u
     1648       :
     1649         assign
     1650           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1651         .
     1652       end.
     1653       for each buf_temp-diasize-handle
     1654       :
     1655         delete buf_temp-diasize-handle .
     1656       end.
     1657       assign
     1658         v-field-group-handle = frame Dialog-Frame :first-child
     1659       .
     1660       do while valid-handle(v-field-group-handle)
     1661       :
     1662         assign
     1663           v-object-handle = v-field-group-handle :first-child
     1664         .
     1665         do while valid-handle(v-object-handle)
     1666         :
     1667           if  v-object-handle <> v-diasize-browse-handle :handle
     1668           and can-query(v-object-handle, "row")
     1669           and can-query(v-object-handle, "height")
     1670           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1671           then do:
     1672             find first buf_temp-browse-handle
     1673               where buf_temp-browse-handle.browse-type   = 'height':u
     1674                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1675               no-error .
     1676             if available buf_temp-browse-handle
     1677             then do:
     1678             end.
     1679             else do:
     1680               create buf_temp-diasize-handle .
     1681               assign
     1682                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1683                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1684               .
     1685             end.
     1686           end.
     1687           assign
     1688             v-object-handle = v-object-handle :next-sibling
     1689           .
     1690         end.
     1691         assign
     1692           v-field-group-handle = v-field-group-handle :next-sibling
     1693         .
     1694       end.
     1695       do with frame Dialog-Frame
     1696       :
     1697         hide v-diasize-resize-button .
     1698         assign
     1699           v-diasize-resize-button :row    = 1
     1700           v-diasize-resize-button :column = 1
     1701         .
     1702       end.
     1703       if p-change-value > 0
     1704       then do:
     1705         if frame Dialog-Frame :scrollable = true
     1706         then do:
     1707           assign
     1708             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1709             no-error .
     1710           if error-status :error
     1711           or error-status :get-message(1) <> ""
     1712           then do:
     1713             undo move_block, retry move_block .
     1714           end.
     1715         end.
     1716         assign
     1717           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1718           no-error .
     1719         if error-status :error
     1720         or error-status :get-message(1) <> ""
     1721         then do:
     1722           undo move_block, retry move_block .
     1723         end.
     1724         assign
     1725           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1726           no-error .
     1727         if error-status :error
     1728         or error-status :get-message(1) <> ""
     1729         then do:
     1730           undo move_block, retry move_block .
     1731         end.
     1732         for each buf_temp-browse-handle
     1733           where buf_temp-browse-handle.browse-type = 'height':u
     1734         on error undo move_block, retry move_block
     1735         :
     1736           assign
     1737             buf_temp-browse-handle.browse-handle :height
     1738               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1739             no-error .
     1740           if error-status :error
     1741           or error-status :get-message(1) <> ""
     1742           then do:
     1743             undo move_block, retry move_block .
     1744           end.
     1745         end.
     1746         for each buf_temp-diasize-handle
     1747         on error undo move_block, retry move_block
     1748         :
     1749           assign
     1750             v-object-handle = buf_temp-diasize-handle.handle-value
     1751           .
     1752           if v-object-handle <> v-diasize-resize-button
     1753           then do:
     1754             assign
     1755               v-object-handle :row = v-object-handle :row + p-change-value
     1756               no-error .
     1757             if error-status :error
     1758             or error-status :get-message(1) <> ""
     1759             then do:
     1760               undo move_block, retry move_block .
     1761             end.
     1762           end.
     1763         end.
     1764       end.
     1765       else do:
     1766         for each buf_temp-diasize-handle
     1767         on error undo move_block, retry move_block
     1768         :
     1769           assign
     1770             v-object-handle = buf_temp-diasize-handle.handle-value
     1771           .
     1772           if v-object-handle <> v-diasize-resize-button
     1773           then do:
     1774             assign
     1775               v-object-handle :row = v-object-handle :row + p-change-value
     1776               no-error .
     1777             if error-status :error
     1778             or error-status :get-message(1) <> ""
     1779             then do:
     1780               undo move_block, retry move_block .
     1781             end.
     1782           end.
     1783         end.
     1784         assign
     1785           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1786           no-error .
     1787         if error-status :error
     1788         or error-status :get-message(1) <> ""
     1789         then do:
     1790           undo move_block, retry move_block .
     1791         end.
     1792         for each buf_temp-browse-handle
     1793           where buf_temp-browse-handle.browse-type = 'height':u
     1794         on error undo move_block, retry move_block
     1795         :
     1796           assign
     1797             buf_temp-browse-handle.browse-handle :height
     1798               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1799             no-error .
     1800           if error-status :error
     1801           or error-status :get-message(1) <> ""
     1802           then do:
     1803             undo move_block, retry move_block .
     1804           end.
     1805         end.
     1806         assign
     1807           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1808           no-error .
     1809         if error-status :error
     1810         or error-status :get-message(1) <> ""
     1811         then do:
     1812           undo move_block, retry move_block .
     1813         end.
     1814         if frame Dialog-Frame :scrollable = true
     1815         then do:
     1816           assign
     1817             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1818             no-error .
     1819           if error-status :error
     1820           or error-status :get-message(1) <> ""
     1821           then do:
     1822             undo move_block, retry move_block .
     1823           end.
     1824         end.
     1825       end.
     1826       if p-move-resize = true
     1827       then do:
     1828         run diasize_position-resize-button in this-procedure .
     1829       end.
     1830       if v-diasize-wndstore = true
     1831       then do:
     1832         if connected("ub") = true
     1833         then do:
     1834           define variable v-cntxt-db-num        as integer   no-undo .
     1835           define variable v-cntxt-userid        as character no-undo .
     1836           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1837                                             , OUTPUT v-cntxt-userid
     1838                                             ) .
     1839           run gbl/wndsizew.p
     1840             (input  v-cntxt-db-num
     1841             ,input  v-cntxt-userid
     1842             ,input  v-diasize-proc-name
     1843             ,input  'height':u
     1844             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1845             ) .
     1846         end.
     1847       end.
     1848     end.
     1849     assign
     1850       v-diasize-change-size = false
     1851     .
     1852   end procedure.
     1853   procedure diasize_set-height :
     1854     define input  parameter p-new-height  as decimal   no-undo .
     1855     define input  parameter p-move-resize as logical   no-undo .
     1856     do
     1857     on error undo, return error return-value
     1858     :
     1859       run diasize_change-height in this-procedure
     1860         (input  (p-new-height - frame Dialog-Frame :height)
     1861         ,input  p-move-resize
     1862         ) .
     1863     end.
     1864   end procedure.
     1865   procedure diasize_change-width :
     1866     define input  parameter p-change-value as decimal   no-undo .
     1867     define input  parameter p-move-resize  as logical   no-undo .
     1868     define variable v-field-group-handle   as handle    no-undo .
     1869     define variable v-object-handle        as handle    no-undo .
     1870     define variable v-frame-width          as decimal   no-undo .
     1871     define variable v-frame-virtual-width  as decimal   no-undo .
     1872     define variable v-browse-width         as decimal   no-undo .
     1873     define variable v-window-width         as decimal   no-undo .
     1874     define variable v-window-virtual-width as decimal   no-undo .
     1875     define variable v-change-sign          as integer   no-undo .
     1876     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1877     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1878     if p-change-value > 0
     1879     then do:
     1880       if frame Dialog-Frame :width + p-change-value >
     1881           session :width-chars
     1882       then do:
     1883         assign
     1884           p-change-value = session :width-chars - frame Dialog-Frame :width
     1885         .
     1886         if p-change-value <= 0
     1887         then do:
     1888           run diasize_position-resize-button in this-procedure .
     1889           return .
     1890         end.
     1891       end.
     1892     end.
     1893     if p-change-value < 0
     1894     then do:
     1895       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1896       then do:
     1897         assign
     1898           p-change-value = v-diasize-orig-frame-width
     1899                          - frame Dialog-Frame :width
     1900         .
     1901         if p-change-value >= 0
     1902         then do:
     1903           run diasize_position-resize-button in this-procedure .
     1904           return .
     1905         end.
     1906       end.
     1907     end.
     1908     if p-change-value >= 0
     1909     then do:
     1910       assign
     1911         v-change-sign = 1
     1912       .
     1913     end.
     1914     else do:
     1915       assign
     1916         v-change-sign = -1
     1917       .
     1918     end.
     1919     assign
     1920       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1921     .
     1922     if p-change-value = 0
     1923     then do:
     1924       run diasize_position-resize-button in this-procedure .
     1925       return .
     1926     end.
     1927     move_block:
     1928     do
     1929     on error undo move_block, leave move_block
     1930     :
     1931       if retry
     1932       then do:
     1933         do
     1934         on error undo move_block, leave move_block
     1935         :
     1936           if p-change-value > 0
     1937           then do:
     1938             for each buf_temp-diasize-handle
     1939             on error undo, next
     1940             :
     1941               assign
     1942                 v-object-handle = buf_temp-diasize-handle.handle-value
     1943               .
     1944               if v-object-handle <> v-diasize-resize-button
     1945               then do:
     1946                 assign
     1947                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1948                 .
     1949               end.
     1950             end.
     1951             assign
     1952               v-diasize-browse-handle :width = v-browse-width
     1953             .
     1954             for each buf_temp-browse-handle
     1955               where buf_temp-browse-handle.browse-type = 'width':u
     1956             on error undo, next
     1957             :
     1958               assign
     1959                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1960               .
     1961             end.
     1962             assign
     1963               frame Dialog-Frame :width = v-frame-width
     1964             .
     1965             if frame Dialog-Frame :scrollable = true
     1966             then do:
     1967               assign
     1968                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1969               .
     1970             end.
     1971             run diasize_position-resize-button in this-procedure .
     1972           end.
     1973           else do:
     1974             if frame Dialog-Frame :scrollable = true
     1975             then do:
     1976               assign
     1977                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1978               .
     1979             end.
     1980             assign
     1981               frame Dialog-Frame :width = v-frame-width
     1982             .
     1983             for each buf_temp-browse-handle
     1984               where buf_temp-browse-handle.browse-type = 'width':u
     1985             on error undo, next
     1986             :
     1987               assign
     1988                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1989               .
     1990             end.
     1991             assign
     1992               v-diasize-browse-handle :width = v-browse-width
     1993             .
     1994             for each buf_temp-diasize-handle
     1995             on error undo, next
     1996             :
     1997               assign
     1998                 v-object-handle = buf_temp-diasize-handle.handle-value
     1999               .
     2000               if v-object-handle <> v-diasize-resize-button
     2001               then do:
     2002                 assign
     2003                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2004                 .
     2005               end.
     2006             end.
     2007             run diasize_position-resize-button in this-procedure .
     2008           end.
     2009           assign
     2010             v-diasize-change-size = false
     2011           .
     2012           leave move_block .
     2013         end.
     2014       end.
     2015       assign
     2016         v-diasize-need-full-display = true
     2017       .
     2018       if v-diasize-change-size = false
     2019       then do:
     2020         assign
     2021           v-diasize-change-size = true
     2022         .
     2023       end.
     2024       else do:
     2025         return .
     2026       end.
     2027       assign
     2028         v-frame-width = frame Dialog-Frame :width
     2029         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2030         v-browse-width = v-diasize-browse-handle :width
     2031       .
     2032       for each buf_temp-browse-handle
     2033         where buf_temp-browse-handle.browse-type = 'width':u
     2034       :
     2035         assign
     2036           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2037         .
     2038       end.
     2039       for each buf_temp-diasize-handle
     2040       :
     2041         delete buf_temp-diasize-handle .
     2042       end.
     2043       assign
     2044         v-field-group-handle = frame Dialog-Frame :first-child
     2045       .
     2046       do while valid-handle(v-field-group-handle)
     2047       :
     2048         assign
     2049           v-object-handle = v-field-group-handle :first-child
     2050         .
     2051         do while valid-handle(v-object-handle)
     2052         :
     2053           if  v-object-handle <> v-diasize-browse-handle :handle
     2054           and v-object-handle <> v-diasize-resize-button
     2055           and can-query(v-object-handle, "row")
     2056           and can-query(v-object-handle, "height")
     2057           and ( v-object-handle :col + v-object-handle :width
     2058                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2059               )
     2060           then do:
     2061             find first buf_temp-browse-handle
     2062               where buf_temp-browse-handle.browse-type   = 'width':u
     2063                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2064               no-error .
     2065             if available buf_temp-browse-handle
     2066             then do:
     2067             end.
     2068             else do:
     2069               create buf_temp-diasize-handle .
     2070               assign
     2071                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2072                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2073               .
     2074             end.
     2075           end.
     2076           assign
     2077             v-object-handle = v-object-handle :next-sibling
     2078           .
     2079         end.
     2080         assign
     2081           v-field-group-handle = v-field-group-handle :next-sibling
     2082         .
     2083       end.
     2084       do with frame Dialog-Frame
     2085       :
     2086         hide v-diasize-resize-button .
     2087         v-diasize-resize-button :row = 1.
     2088         v-diasize-resize-button :column = 1.
     2089       end.
     2090       if p-change-value > 0
     2091       then do:
     2092         if frame Dialog-Frame :scrollable = true
     2093         then do:
     2094           assign
     2095             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2096             no-error .
     2097           if error-status :error
     2098           or error-status :get-message(1) <> ""
     2099           then do:
     2100             undo move_block, retry move_block.
     2101           end.
     2102         end.
     2103         assign
     2104           frame Dialog-Frame :width = v-frame-width + p-change-value
     2105           no-error .
     2106         if error-status :error
     2107         or error-status :get-message(1) <> ""
     2108         then do:
     2109           undo move_block, retry move_block.
     2110         end.
     2111         assign
     2112           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2113         no-error .
     2114         if error-status :error
     2115         or error-status :get-message(1) <> ""
     2116         then do:
     2117           undo move_block, retry move_block.
     2118         end.
     2119         for each buf_temp-browse-handle
     2120           where buf_temp-browse-handle.browse-type = 'width':u
     2121         on error undo move_block, retry move_block
     2122         :
     2123           assign
     2124             buf_temp-browse-handle.browse-handle :width
     2125               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2126             no-error .
     2127           if error-status :error
     2128           or error-status :get-message(1) <> ""
     2129           then do:
     2130             undo move_block, retry move_block .
     2131           end.
     2132         end.
     2133         for each buf_temp-diasize-handle
     2134         on error undo move_block, retry move_block
     2135         :
     2136           assign
     2137             v-object-handle = buf_temp-diasize-handle.handle-value
     2138           .
     2139           if v-object-handle <> v-diasize-resize-button
     2140           then do:
     2141             assign
     2142               v-object-handle :col = v-object-handle :col + p-change-value
     2143               no-error .
     2144             if error-status :error
     2145             or error-status :get-message(1) <> ""
     2146             then do:
     2147               undo move_block, retry move_block .
     2148             end.
     2149           end.
     2150         end.
     2151       end.
     2152       else do:
     2153         for each buf_temp-diasize-handle
     2154         on error undo move_block, retry move_block
     2155         :
     2156           assign
     2157             v-object-handle = buf_temp-diasize-handle.handle-value
     2158           .
     2159           if v-object-handle <> v-diasize-resize-button
     2160           then do:
     2161             assign
     2162               v-object-handle :col = v-object-handle :col + p-change-value
     2163               no-error .
     2164             if error-status :error
     2165             or error-status :get-message(1) <> ""
     2166             then do:
     2167               undo move_block, retry move_block .
     2168             end.
     2169           end.
     2170         end.
     2171         for each buf_temp-browse-handle
     2172           where buf_temp-browse-handle.browse-type = 'width':u
     2173         on error undo move_block, retry move_block
     2174         :
     2175           assign
     2176             buf_temp-browse-handle.browse-handle :width
     2177               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2178             no-error .
     2179           if error-status :error
     2180           or error-status :get-message(1) <> ""
     2181           then do:
     2182             undo move_block, retry move_block .
     2183           end.
     2184         end.
     2185         assign
     2186           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2187           no-error .
     2188         if error-status :error
     2189         or error-status :get-message(1) <> ""
     2190         then do:
     2191           undo move_block, retry move_block.
     2192         end.
     2193         assign
     2194           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2195         no-error .
     2196         if error-status :error
     2197         or error-status :get-message(1) <> ""
     2198         then do:
     2199           undo move_block, retry move_block.
     2200         end.
     2201         if frame Dialog-Frame :scrollable = true
     2202         then do:
     2203           assign
     2204             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2205           no-error .
     2206           if error-status :error
     2207           or error-status :get-message(1) <> ""
     2208           then do:
     2209             undo move_block, retry move_block.
     2210           end.
     2211         end.
     2212       end.
     2213       if p-move-resize
     2214       then do:
     2215         run diasize_position-resize-button in this-procedure .
     2216       end.
     2217       if v-diasize-wndstore = true
     2218       then do:
     2219         if connected("ub") = true
     2220         then do:
     2221           define variable v-cntxt-db-num        as integer   no-undo .
     2222           define variable v-cntxt-userid        as character no-undo .
     2223           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2224                                             , OUTPUT v-cntxt-userid
     2225                                             ) .
     2226           run gbl/wndsizew.p
     2227             (input  v-cntxt-db-num
     2228             ,input  v-cntxt-userid
     2229             ,input  v-diasize-proc-name
     2230             ,input  'width':u
     2231             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2232             ) .
     2233         end.
     2234       end.
     2235     end.
     2236     assign
     2237       v-diasize-change-size = false
     2238     .
     2239   end procedure.
     2240   procedure diasize_set-width :
     2241     define input  parameter p-new-width  as decimal   no-undo .
     2242     define input  parameter p-move-resize as logical   no-undo .
     2243     do
     2244     on error undo, return error return-value
     2245     :
     2246       run diasize_change-width in this-procedure
     2247         (input  (p-new-width - frame Dialog-Frame :width)
     2248         ,input  p-move-resize
     2249         ) .
     2250     end.
     2251   end procedure.
     2252   procedure diasize_position-resize-button :
     2253     do with frame Dialog-Frame
     2254     :
     2255       hide v-diasize-resize-button .
     2256       assign
     2257         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2258                     - 1
     2259                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2260         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2261                     - 1
     2262                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2263       .
     2264       view v-diasize-resize-button .
     2265     end.
     2266   end procedure.
     2267   on alt-right anywhere
     2268   do:
     2269     run diasize_change-width in this-procedure
     2270       (input 1
     2271       ,input true
     2272       ) .
     2273     return no-apply .
     2274   end.
     2275   on alt-left anywhere
     2276   do:
     2277     run diasize_change-width in this-procedure
     2278       (input -1
     2279       ,input true
     2280       ) .
     2281     return no-apply .
     2282   end.
     2283   on alt-down anywhere
     2284   do:
     2285     run diasize_change-height in this-procedure
     2286       (input 1
     2287       ,input true
     2288       ) .
     2289     return no-apply .
     2290   end.
     2291   on alt-up anywhere
     2292   do:
     2293     run diasize_change-height in this-procedure
     2294       (input -1
     2295       ,input true
     2296       ) .
     2297     return no-apply .
     2298   end.
     2299   on alt-enter of frame Dialog-Frame
     2300   do:
     2301     run diasize_maximize in this-procedure
     2302       (input  ?
     2303       ).
     2304     return no-apply .
     2305   end.
     2306   procedure diasize_end-move :
     2307     do
     2308     on error undo, return error return-value
     2309     :
     2310       define variable v-row-delta as decimal   no-undo .
     2311       define variable v-col-delta as decimal   no-undo .
     2312       define variable v-new-row as decimal   no-undo .
     2313       define variable v-new-col as decimal   no-undo .
     2314       assign
     2315         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2316         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2317       .
     2318       assign
     2319         v-row-delta = v-new-row - frame Dialog-Frame :height
     2320         v-col-delta = v-new-col - frame Dialog-Frame :width
     2321       .
     2322       run diasize_change-height in this-procedure
     2323         (input v-row-delta
     2324         ,input true
     2325         ) .
     2326       run diasize_change-width in this-procedure
     2327         (input v-col-delta
     2328         ,input true
     2329         ) .
     2330     end.
     2331   end procedure.
     2332   procedure diasize_maximize :
     2333     define input  parameter p-action as logical   no-undo .
     2334     do
     2335     on error undo, return error return-value
     2336     :
     2337       if p-action = ?
     2338       then do:
     2339         if v-diasize-need-maximize = true
     2340         then do:
     2341           assign
     2342             p-action = true
     2343           .
     2344         end.
     2345         else do:
     2346           assign
     2347             p-action = false
     2348           .
     2349         end.
     2350       end.
     2351       if p-action = true
     2352       then do:
     2353         run diasize_change-height in this-procedure
     2354           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2355               - frame Dialog-Frame :height-chars
     2356           ,input true
     2357           ) .
     2358         run diasize_change-width in this-procedure
     2359           (input session :width-chars
     2360               - frame Dialog-Frame :width-chars
     2361           ,input true
     2362           ) .
     2363         assign
     2364           v-diasize-need-maximize = false
     2365         .
     2366       end.
     2367       else do:
     2368         run diasize_change-width in this-procedure
     2369           (input v-diasize-orig-frame-width
     2370               - frame Dialog-Frame :width-chars
     2371           ,input true
     2372           ) .
     2373         run diasize_change-height in this-procedure
     2374           (input v-diasize-orig-frame-height
     2375               - frame Dialog-Frame :height-chars
     2376           ,input true
     2377           ) .
     2378         assign
     2379           v-diasize-need-maximize = true
     2380         .
     2381       end.
     2382     end.
     2383   end procedure.
     2384   procedure diasize_restore-orig-size :
     2385     do
     2386     on error undo, return error return-value
     2387     :
     2388       assign
     2389         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2390         v-diasize-current-frame-height = frame Dialog-Frame :height
     2391       .
     2392       run diasize_set-height in this-procedure
     2393         (input  v-diasize-orig-frame-height
     2394         ,input  true
     2395         ) .
     2396       run diasize_set-width in this-procedure
     2397         (input  v-diasize-orig-frame-width
     2398         ,input  true
     2399         ) .
     2400     end.
     2401   end procedure.
     2402   procedure diasize_restore-current-size :
     2403     do
     2404     on error undo, return error return-value
     2405     :
     2406       run diasize_set-height in this-procedure
     2407         (input  v-diasize-current-frame-height
     2408         ,input  true
     2409         ) .
     2410       run diasize_set-width in this-procedure
     2411         (input  v-diasize-current-frame-width
     2412         ,input  true
     2413         ) .
     2414     end.
     2415   end procedure.
     2416   procedure diasize_set-browse-handle :
     2417     define input  parameter p-browse-handle as handle   no-undo .
     2418     define buffer buf_temp-browse-handle for temp-browse-handle .
     2419     do
     2420     on error undo, return error return-value
     2421     :
     2422       assign
     2423         v-diasize-browse-handle = p-browse-handle
     2424       .
     2425       for each buf_temp-browse-handle
     2426       on error undo, return error return-value
     2427       :
     2428         delete buf_temp-browse-handle .
     2429       end.
     2430     end.
     2431   end procedure.
     2432   procedure diasize_add_browse :
     2433     define input  parameter p-browse-type   as character no-undo .
     2434     define input  parameter p-browse-handle as handle    no-undo .
     2435     define buffer buf_temp-browse-handle for temp-browse-handle .
     2436     do
     2437     on error undo, return error return-value
     2438     :
     2439       assign
     2440         v-diasize-browse-number = v-diasize-browse-number + 1
     2441       .
     2442       create buf_temp-browse-handle .
     2443       assign
     2444         buf_temp-browse-handle.browse-type   = p-browse-type
     2445         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2446         buf_temp-browse-handle.browse-handle = p-browse-handle
     2447       .
     2448     end.
     2449   end procedure.
     2450   procedure diasize_init :
     2451     define variable v-default-value    as logical   no-undo .
     2452     define variable v-restore-saved    as logical   no-undo .
     2453     define variable v-resize-value-str as character no-undo .
     2454     do
     2455     on error undo, return error return-value
     2456     :
     2457       do with frame Dialog-Frame
     2458       :
     2459         assign
     2460           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2461           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2462           v-diasize-browse-handle     = browse br-layout :handle
     2463         .
     2464         create button v-diasize-resize-button
     2465         assign
     2466           parent        = frame Dialog-Frame :first-child
     2467           label         = "s"
     2468           height-pixels = 16
     2469           width-pixels  = 16
     2470           visible       = true
     2471           sensitive     = true
     2472           movable       = true
     2473           triggers:
     2474             on end-move persistent run diasize_end-move in this-procedure .
     2475           end triggers.
     2476         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2477         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2478         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2479         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2480         assign
     2481           v-diasize-wndmax = false
     2482         .
     2483         if connected("ub") = true
     2484         then do:
     2485           define variable v-cntxt-db-num        as integer   no-undo .
     2486           define variable v-cntxt-userid        as character no-undo .
     2487           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2488                                             , OUTPUT v-cntxt-userid
     2489                                             ) .
     2490           run gbl/wndpar_r.p
     2491             (input  v-cntxt-db-num
     2492             ,input  v-cntxt-userid
     2493             ,input  'wndmax':U
     2494             ,output v-diasize-wndmax
     2495             ,output v-default-value
     2496             ) .
     2497         end.
     2498         assign
     2499           v-diasize-wndstore = false
     2500         .
     2501         if connected("ub") = true
     2502         then do:
     2503           run gbl/wndpar_r.p
     2504             (input  v-cntxt-db-num
     2505             ,input  v-cntxt-userid
     2506             ,input  'wndstore':U
     2507             ,output v-diasize-wndstore
     2508             ,output v-default-value
     2509             ) .
     2510         end.
     2511         assign
     2512           v-diasize-proc-name = entry(1, program-name(2), '.')
     2513         .
     2514         if v-diasize-wndstore = true
     2515         then do:
     2516           assign
     2517             v-restore-saved = false
     2518           .
     2519           if connected("ub") = true
     2520           then do:
     2521             run gbl/wndsizer.p
     2522               (input  v-cntxt-db-num
     2523               ,input  v-cntxt-userid
     2524               ,input  v-diasize-proc-name
     2525               ,input  'height':u
     2526               ,output v-resize-value-str
     2527               ) .
     2528             if v-resize-value-str <> '':U
     2529             then do:
     2530               run diasize_change-height in this-procedure
     2531                 (input  integer(v-resize-value-str)
     2532                 ,input  true
     2533                 ) .
     2534               assign
     2535                 v-restore-saved = true
     2536               .
     2537             end.
     2538           end.
     2539           if connected("ub") = true
     2540           then do:
     2541             run gbl/wndsizer.p
     2542               (input  v-cntxt-db-num
     2543               ,input  v-cntxt-userid
     2544               ,input  v-diasize-proc-name
     2545               ,input  'width':u
     2546               ,output v-resize-value-str
     2547               ) .
     2548             if v-resize-value-str <> '':U
     2549             then do:
     2550               run diasize_change-width in this-procedure
     2551                 (input  integer(v-resize-value-str)
     2552                 ,input  true
     2553                 ) .
     2554               assign
     2555                 v-restore-saved = true
     2556               .
     2557             end.
     2558           end.
     2559           if v-restore-saved <> true
     2560           then do:
     2561             if v-diasize-wndmax = true
     2562             then do:
     2563               run diasize_maximize in this-procedure
     2564                 (input  true
     2565                 ) .
     2566             end.
     2567           end.
     2568         end.
     2569         else do:
     2570           if v-diasize-wndmax = true
     2571           then do:
     2572             run diasize_maximize in this-procedure
     2573               (input  true
     2574               ) .
     2575           end.
     2576         end.
     2577       end.
     2578     end.
     2579   end procedure.
     2580   procedure diasize_need-full-display :
     2581     define output parameter p-need-full-display as logical   no-undo .
     2582     do
     2583     on error undo, return error return-value
     2584     :
     2585       assign
     2586         p-need-full-display = v-diasize-need-full-display
     2587       .
     2588       assign
     2589         v-diasize-need-full-display = false
     2590       .
     2591     end.
     2592   end procedure.
     2593   procedure get-context :
     2594      define output parameter p-db-num as integer          no-undo.
     2595      define output parameter p-user-id as character        no-undo.
     2596      define variable v-login               as character    no-undo.
     2597      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2598      define buffer buf_user-login  for ub.user-login .
     2599      do
     2600      on error undo, return error
     2601      :
     2602            FIND FIRST buf_sys-ctrl no-lock.
     2603            ASSIGN
     2604               v-login = USERID("ub")
     2605               p-db-num = buf_sys-ctrl.db-num
     2606            .
     2607            FIND FIRST buf_user-login
     2608                 WHERE buf_user-login.db-num = p-db-num
     2609                   AND buf_user-login.user-login = v-login
     2610                 no-lock
     2611                 no-error
     2612                 .
     2613            IF AVAILABLE buf_user-login
     2614            THEN DO:
     2615               assign
     2616                  p-user-id = buf_user-login.user-id
     2617               .
     2618            END.
     2619      end.
     2620   end procedure.
     2621       run diasize_init in this-procedure .
     2622   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2623   on INS of frame Dialog-Frame anywhere do:
     2624     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     2625     return no-apply.
     2626   end.
     2627   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2628   on F3 of frame Dialog-Frame anywhere do:
     2629     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame Dialog-Frame. END.
     2630     return no-apply.
     2631   end.
     2632   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2633   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     2634     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     2635     return no-apply.
     2636   end.
     2637   define variable vss-include-info17 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2638   on F4 of frame Dialog-Frame anywhere do:
     2639     if b-chg :sensitive then DO: apply "CHOOSE":U to b-chg in frame Dialog-Frame. END.
     2640     return no-apply.
     2641   end.
     2642   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2643   on F8 of frame Dialog-Frame anywhere do:
     2644     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame Dialog-Frame. END.
     2645     return no-apply.
     2646   end.
     2647   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2648   on F2 of frame Dialog-Frame anywhere do:
     2649     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     2650     return no-apply.
     2651   end.
     2652   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2653   on F2 of frame Dialog-Frame anywhere do:
     2654     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     2655     return no-apply.
     2656   end.
     2657   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2658   procedure set-filter-name :
     2659   define input parameter p-filter-name as character no-undo .
     2660     do with frame Dialog-Frame:
     2661       if p-filter-name > "" then do:
     2662         assign
     2663           frame Dialog-Frame:title
     2664             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2665         .
     2666         assign
     2667           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2668         .
     2669       end.
     2670       else do:
     2671         assign
     2672           b-sch :tooltip = ""
     2673         .
     2674       end.
     2675     end.
     2676   end procedure.
     2677   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2678   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2679   MAIN-BLOCK:
     2680   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2681      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2682   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2683     run mainmenu_getcntxt in parparentproc
     2684       (output v-cntxt-db-num
     2685       ,output v-cntxt-userid
     2686       ,output v-cntxt-level
     2687       ,output v-cntxt-host-code-obj
     2688       ,output v-cntxt-obj-type
     2689       ,output v-cntxt-obj-code
     2690       ,output v-cntxt-db-num-obj
     2691       ,output v-cntxt-is-admin
     2692       ) .
     2693     v-admin = lookup('admin', bttns) > 0.
     2694     if p-list-mode = "layout-type"
     2695     and lookup(p-layout-type, 'th-pos-screen,th-pos-keyboard':U) = 0 then do:
     2696       message
     2697       substitute("Неверное значение параметра p-layout-type = &1", p-layout-type)
     2698       view-as alert-box error .
     2699       undo main-block, return error .
     2700     end.
     2701     run Myenable in this-procedure .
     2702     v-rid-list = p-rid-list.
     2703     WAIT-FOR GO OF FRAME Dialog-Frame.
     2704   END.
     2705   RUN disable_UI.
     2706   PROCEDURE disable_UI :
     2707     HIDE FRAME Dialog-Frame.
     2708   END PROCEDURE.
     2709   PROCEDURE enable_UI :
     2710     DISPLAY EDITOR-des mark-num
     2711         WITH FRAME Dialog-Frame.
     2712     ENABLE b-quit b-mark b-sel b-add b-copy b-chg b-del b-lkp b-sch b-hist B-Help
     2713            br-layout EDITOR-des mark-num
     2714         WITH FRAME Dialog-Frame.
     2715     VIEW FRAME Dialog-Frame.
     2716   END PROCEDURE.
     2717   PROCEDURE MyEnable :
     2718   define variable v-h as handle no-undo .
     2719   define variable vh-layout-type-name as handle no-undo .
     2720   ASSIGN
     2721   v-h = br-layout:FIRST-COLUMN in frame Dialog-Frame
     2722   .
     2723   DO while valid-handle(v-h) :
     2724     if v-h:LABEL = "Тип раскладки" then do:
     2725       vh-layout-type-name = v-h.
     2726       leave.
     2727     end.
     2728     ELSE DO:
     2729       v-h = v-h:NEXT-COLUMN.
     2730     END.
     2731   END.
     2732   ASSIGN
     2733   X_layout.device-type:RESIZABLE IN BROWSE br-layout = YES
     2734   X_layout.layout-name:RESIZABLE IN BROWSE br-layout = YES
     2735   vh-layout-type-name:resizable = yes
     2736   .
     2737   ENABLE
     2738   b-quit
     2739   b-add when (lookup("b-add", bttns) > 0)
     2740   b-chg when (lookup("b-add", bttns) > 0)
     2741   b-del when (lookup("b-add", bttns) > 0)
     2742   b-copy when (lookup("b-add", bttns) > 0)
     2743   b-lkp
     2744   B-Help
     2745   b-mark when lookup("b-mark", bttns) > 0
     2746   b-sel when lookup("b-sel", bttns) > 0
     2747   b-sch
     2748   b-hist
     2749   br-layout
     2750   editor-des
     2751   WITH FRAME Dialog-Frame.
     2752   VIEW FRAME Dialog-Frame.
     2753   if p-list-mode = "layout-type" then do:
     2754     assign
     2755     vh-layout-type-name:visible  = no.
     2756   end.
     2757   run Openbr in this-procedure ( input yes, input no, input '':U).
     2758   END PROCEDURE.
     2759   PROCEDURE Openbr :
     2760   define input  parameter p-open-query     as logical   no-undo .
     2761   define input  parameter p-find-next      as logical   no-undo .
     2762   define input  parameter p-find-condition as character no-undo .
     2763   define variable l-query-was-opened as logical no-undo .
     2764   run waitfram-show in this-procedure ("Ждите...").
     2765   define variable sort-column-phrase as character no-undo .
     2766   case sort-column-name :
     2767     when "" then do:
     2768       assign
     2769         sort-column-phrase = ""
     2770       .
     2771     end.
     2772     otherwise do:
     2773       assign
     2774         sort-column-phrase = "by " + sort-column-name
     2775       .
     2776     end.
     2777   end case.
     2778   define variable l-open-query as logical   no-undo .
     2779   filter-point = filter-point0 + p-list-mode.
     2780   CASE p-list-mode :
     2781     WHEN 'все':U        THEN DO:
     2782         assign
     2783         filter-point-label = "Все раскладки"
     2784         frame Dialog-Frame:title = filter-point-label
     2785         .
     2786         if v-admin then do:
     2787           OPEN QUERY br-layout
     2788           FOR EACH X_layout NO-LOCK INDEXED-REPOSITION.
     2789   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2790   define variable  l-disable-where-24  as logical   no-undo .
     2791   define variable  l-filter-open-24    as logical   .
     2792   define variable  flt-rec-24       as recid     no-undo .
     2793   define variable  filter-name-24      as character no-undo .
     2794   define variable  where-phrase-24     as character no-undo .
     2795   define variable  sort-phrase-24      as character no-undo .
     2796   define variable  where-phrase-rus-24 as character no-undo .
     2797   define variable  sort-phrase-rus-24  as character no-undo .
     2798     run waitfram-show in this-procedure
     2799       (input "ЖДИТЕ ..."
     2800       ).
     2801   run gbl/flt-get.p
     2802     (input filter-point
     2803     ,output flt-rec-24
     2804     ,output filter-name-24
     2805     ,output where-phrase-24
     2806     ,output sort-phrase-24
     2807     ,output where-phrase-rus-24
     2808     ,output sort-phrase-rus-24
     2809     ).
     2810   if p-open-query then do:
     2811       run set-filter-name in this-procedure
     2812         (INPUT filter-name-24
     2813         ) no-error .
     2814     assign
     2815       l-filter-open-24 = false
     2816     .
     2817     if flt-rec-24 <> ?
     2818       or sort-column-phrase > ""
     2819     then do:
     2820       define variable  parameter-2-24 as character no-undo .
     2821       define variable  parameter-3-24 as character no-undo .
     2822       define variable  parameter-4-24 as character no-undo .
     2823       define variable  parameter-5-24 as character no-undo .
     2824       define variable  parameter-6-24 as character no-undo .
     2825       define variable  parameter-7-24 as character no-undo .
     2826         assign
     2827         parameter-3-24 =
     2828                                 "FOR EACH X_layout"
     2829         parameter-4-24 =
     2830           (
     2831             if (" true " + " " + where-phrase-24) <> ""
     2832             then " true " + " " + where-phrase-24
     2833             else "true"
     2834           )
     2835         parameter-5-24 = (" " + "" + " " + "")
     2836         parameter-6-24 = if sort-phrase-24 = ''
     2837                              then
     2838           (
     2839           " " + "  " +
     2840             " " + sort-column-phrase +
     2841           " " + "  "
     2842           )
     2843                              else
     2844           (
     2845           " " + "  " +
     2846             " " + sort-column-phrase +
     2847           " " + sort-phrase-24
     2848           )
     2849         parameter-7-24 =
     2850           " indexed-reposition  "
     2851       .
     2852       do
     2853       on stop undo, leave
     2854       on error undo, leave
     2855       :
     2856         assign
     2857           l-disable-where-24 =
     2858             (" true " + " " + where-phrase-24 = "")
     2859         .
     2860         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2861                             ,input QUERY br-layout:handle
     2862                             ,input parameter-3-24
     2863                             ,input parameter-4-24
     2864                             ,input parameter-5-24
     2865                             ,input parameter-6-24
     2866                             ,input parameter-7-24
     2867                             )
     2868         .
     2869         assign
     2870           l-filter-open-24 = true
     2871         .
     2872       end.
     2873       if l-filter-open-24 = false then do:
     2874         message
     2875           "Ошибка при фильтрации / сортировке" skip
     2876           "Будут показаны записи без учета фильтра" skip
     2877           view-as alert-box .
     2878       end.
     2879       else do:
     2880           assign
     2881             l-query-was-opened = true
     2882           .
     2883       end.
     2884     end.
     2885     if l-filter-open-24 = false then do:
     2886       OPEN QUERY br-layout FOR EACH X_layout
     2887         where  true
     2888         indexed-reposition
     2889     .
     2890         assign
     2891           l-query-was-opened = true
     2892         .
     2893     end.
     2894   end.
     2895   else do:
     2896     assign
     2897       v-doc-rec = recid( X_layout )
     2898     .
     2899     do
     2900     on stop undo, leave
     2901     on error undo, leave
     2902     :
     2903       if QUERY br-layout:handle:get-buffer-handle(1) = (buffer X_layout:handle) then do:
     2904         assign
     2905         parameter-2-24 = (if p-find-next then "true":u else "false":u )
     2906         parameter-4-24 =
     2907           "where ":u + " true " + " ":u + where-phrase-24 + " ":u + p-find-condition + " " + ""
     2908         parameter-5-24 = "  "
     2909       .
     2910         run fltopend_fltfindd in this-procedure  (
     2911                             input this-procedure:handle
     2912                             ,input QUERY br-layout:handle
     2913                             ,input rowid(X_layout)
     2914                             ,input logical(parameter-2-24)
     2915                             ,input no-lock
     2916                             ,input (buffer X_layout:handle)
     2917                             ,input parameter-4-24
     2918                             ,input parameter-5-24
     2919                             ) no-error.
     2920         .
     2921         assign
     2922           v-doc-rec = integer(return-value)
     2923           v-fltopend-rowid[1] = ?
     2924         .
     2925       end.
     2926       else do:
     2927         assign
     2928         parameter-2-24 = (if p-find-next then "true":u else "false":u )
     2929         parameter-3-24 =  "FOR EACH X_layout"
     2930         parameter-4-24 =
     2931           (
     2932             if (" true " + " " + where-phrase-24) <> ""
     2933             then " true " + " " + where-phrase-24
     2934             else "true"
     2935           )
     2936         parameter-5-24 = (" " + "" + " " + "" + " " + p-find-condition)
     2937         parameter-6-24 = if sort-phrase-24 = ''
     2938                              then
     2939           (
     2940           " " + "  " +
     2941             " " + sort-column-phrase +
     2942           " " + "  "
     2943           )
     2944                              else
     2945           (
     2946           " " + "  " +
     2947             " " + sort-column-phrase +
     2948           " " + sort-phrase-24
     2949           )
     2950         parameter-7-24 =
     2951           " indexed-reposition  "
     2952       .
     2953         run fltopend_fltfindq in this-procedure  (
     2954                             input this-procedure:handle
     2955                             ,input QUERY br-layout:handle
     2956                             ,input logical(parameter-2-24)
     2957                             ,input no-lock
     2958                             ,input parameter-3-24
     2959                             ,input parameter-4-24
     2960                             ,input parameter-5-24
     2961                             ,input parameter-6-24
     2962                             ,input parameter-7-24
     2963                             ,output v-fltopend-rowid
     2964                             ) no-error.
     2965         .
     2966         v-doc-rec = ?.
     2967       end.
     2968       assign
     2969         l-query-was-opened = true
     2970       .
     2971     end.
     2972   end.
     2973     run waitfram-hide in this-procedure .
     2974          end.
     2975          else do:
     2976           frame Dialog-Frame :title = "Все раскладки".
     2977   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
