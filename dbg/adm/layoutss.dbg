     3162          end.
     3163      END.
     3164      when "layout-type" then do:
     3165         ASSIGN
     3166         filter-point-label = substitute("Раскладки типа: &1", entry (lookup (p-layout-type, 'th-pos-screen,th-pos-keyboard':U) + 1, ',' + 'Экран IBS TH POS,Клавиатура IBS TH POS':U)).
     3167         frame Dialog-Frame:title = filter-point-label
     3168         .
     3169   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3170   define variable  l-disable-where-28  as logical   no-undo .
