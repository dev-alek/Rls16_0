     3190   if p-open-query then do:
     3191       run set-filter-name in this-procedure
     3192         (INPUT filter-name-28
     3193         ) no-error .
     3194     assign
     3195       l-filter-open-28 = false
     3196     .
     3197     if flt-rec-28 <> ?
     3198       or sort-column-phrase > ""
     3199     then do:
     3200       define variable  parameter-2-28 as character no-undo .
     3201       define variable  parameter-3-28 as character no-undo .
     3202       define variable  parameter-4-28 as character no-undo .
     3203       define variable  parameter-5-28 as character no-undo .
     3204       define variable  parameter-6-28 as character no-undo .
     3205       define variable  parameter-7-28 as character no-undo .
     3206         assign
     3207         parameter-3-28 =
     3208                                 "FOR EACH X_layout"
     3209         parameter-4-28 =
     3210           (
     3211             if (" X_layout.layout-type = p-layout-type and X_layout.is-default >= 0 " + " " + where-phrase-28) <> ""
     3212             then  substitute('X_layout.layout-type = &1&2&1 and X_layout.is-default >= 0', chr(34), p-layout-type) + " " + where-phrase-28
