     3236         assign
     3237           l-disable-where-28 =
     3238             (" X_layout.layout-type = p-layout-type and X_layout.is-default >= 0 " + " " + where-phrase-28 = "")
     3239         .
     3240         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3241                             ,input QUERY br-layout:handle
     3242                             ,input parameter-3-28
     3243                             ,input parameter-4-28
     3244                             ,input parameter-5-28
     3245                             ,input parameter-6-28
     3246                             ,input parameter-7-28
     3247                             )
     3248         .
     3249         assign
     3250           l-filter-open-28 = true
     3251         .
     3252       end.
     3253       if l-filter-open-28 = false then do:
     3254         message
     3255           "Ошибка при фильтрации / сортировке" skip
     3256           "Будут показаны записи без учета фильтра" skip
     3257           view-as alert-box .
     3258       end.
     3259       else do:
     3260           assign
     3261             l-query-was-opened = true
     3262           .
     3263       end.
     3264     end.
     3265     if l-filter-open-28 = false then do:
     3266       OPEN QUERY br-layout FOR EACH X_layout
     3267         where  X_layout.layout-type = p-layout-type and X_layout.is-default >= 0
     3268         indexed-reposition
     3269     .
     3270         assign
     3271           l-query-was-opened = true
     3272         .
     3273     end.
     3274   end.
     3275   else do:
     3276     assign
     3277       v-doc-rec = recid( X_layout )
     3278     .
     3279     do
     3280     on stop undo, leave
     3281     on error undo, leave
     3282     :
     3283       if QUERY br-layout:handle:get-buffer-handle(1) = (buffer X_layout:handle) then do:
     3284         assign
     3285         parameter-2-28 = (if p-find-next then "true":u else "false":u )
     3286         parameter-4-28 =
     3287           "where ":u +  substitute('X_layout.layout-type = &1&2&1 and X_layout.is-default >= 0', chr(34), p-layout-type) + " ":u + where-phrase-28 + " ":u + p-find-condition + " " + ""
     3288         parameter-5-28 = " "
     3289       .
     3290         run fltopend_fltfindd in this-procedure  (
     3291                             input this-procedure:handle
     3292                             ,input QUERY br-layout:handle
     3293                             ,input rowid(X_layout)
     3294                             ,input logical(parameter-2-28)
     3295                             ,input no-lock
     3296                             ,input (buffer X_layout:handle)
     3297                             ,input parameter-4-28
     3298                             ,input parameter-5-28
     3299                             ) no-error.
     3300         .
     3301         assign
     3302           v-doc-rec = integer(return-value)
     3303           v-fltopend-rowid[1] = ?
     3304         .
     3305       end.
     3306       else do:
     3307         assign
     3308         parameter-2-28 = (if p-find-next then "true":u else "false":u )
     3309         parameter-3-28 =  "FOR EACH X_layout"
     3310         parameter-4-28 =
     3311           (
     3312             if (" X_layout.layout-type = p-layout-type and X_layout.is-default >= 0 " + " " + where-phrase-28) <> ""
     3313             then  substitute('X_layout.layout-type = &1&2&1 and X_layout.is-default >= 0', chr(34), p-layout-type) + " " + where-phrase-28
     3314             else "true"
     3315           )
     3316         parameter-5-28 = (" " + "" + " " + "" + " " + p-find-condition)
     3317         parameter-6-28 = if sort-phrase-28 = ''
     3318                              then
     3319           (
     3320           " " + " " +
     3321             " " + sort-column-phrase +
     3322           " " + " "
     3323           )
     3324                              else
     3325           (
     3326           " " + " " +
     3327             " " + sort-column-phrase +
     3328           " " + sort-phrase-28
     3329           )
     3330         parameter-7-28 =
     3331           " indexed-reposition  "
     3332       .
     3333         run fltopend_fltfindq in this-procedure  (
     3334                             input this-procedure:handle
     3335                             ,input QUERY br-layout:handle
     3336                             ,input logical(parameter-2-28)
     3337                             ,input no-lock
     3338                             ,input parameter-3-28
     3339                             ,input parameter-4-28
     3340                             ,input parameter-5-28
     3341                             ,input parameter-6-28
     3342                             ,input parameter-7-28
     3343                             ,output v-fltopend-rowid
     3344                             ) no-error.
     3345         .
     3346         v-doc-rec = ?.
     3347       end.
     3348       assign
     3349         l-query-was-opened = true
     3350       .
     3351     end.
     3352   end.
     3353     run waitfram-hide in this-procedure .
     3354     END.
     3355   END CASE.
     3356   if not p-open-query then
     3357   REPOSITION br-layout to recid v-doc-rec No-ERROR.
     3358   if not p-open-query and v-fltopend-rowid[1] <> ? then
     3359   query br-layout:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     3360   run waitfram-hide in this-procedure.
     3361   APPLY "ENTRY" TO br-layout.
     3362   APPLY "VALUE-CHANGED" TO br-layout in frame Dialog-Frame.
     3363   END PROCEDURE.
     3364   PROCEDURE proc-b-copy :
     3365   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     3366    IF NOT v-admin
     3367    AND X_layout.is-default = INTEGER('-1':U) THEN DO:
     3368       MESSAGE
     3369       "Нельзя скопировать обязательную раскладку"
     3370        VIEW-AS ALERT-BOX error.
     3371       UNDO, RETURN ERROR.
     3372    END.
     3373    MESSAGE
     3374    SUBSTITUTE("Вы действительно хотите скопировать новую раскладку с раскладки &1?", X_layout.layout-id)
     3375    VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     3376    IF NOT glog THEN UNDO, RETURN ERROR.
     3377    define variable v-rec as recid no-undo.
     3378     run adm/layout-i.w ( input parparentproc
     3379                          ,input 'КОПИРОВАНИЕ':U + (if v-admin then (chr(44) + "admin") else '')
     3380                          ,input X_layout.layout-id
     3381                          ,input-output v-rec) no-error.
     3382     if v-rec <> ? then do:
     3383       RUN openbr IN THIS-PROCEDURE ( input yes, input no, input '':U).
     3384     end.
     3385   END PROCEDURE.
     3386   PROCEDURE proc-b-lkp :
     3387   DEFINE INPUT PARAMETER p-option AS CHARACTER NO-UNDO.
     3388   define variable v-rec as recid no-undo.
     3389   CASE p-option:
     3390     WHEN 'layout':U THEN DO:
     3391         run adm/layout-i.w ( input parparentproc
     3392                              ,input 'ПРОСМОТР':U +  (if v-admin then (chr(44) + "admin") else '')
     3393                              ,input X_layout.layout-id
     3394                              ,input-output v-rec) no-error.
     3395     END.
     3396   END CASE.
     3397   IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     3398   END PROCEDURE.
     3399   PROCEDURE proc-b-sch :
     3400   assign
     3401     tbl = 'layout'
     3402     join-tbl = 'X_layout'
     3403     fld = ""
     3404     lab = ""
     3405     spr = ""
     3406     dim = '0'
     3407     .
     3408   run fltfield-add in this-procedure('layout-id', 'ID раскладки', '',
     3409   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3410   run fltfield-add in this-procedure('layout-name', 'Название раскладки', '',
     3411   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3412   run fltfield-add in this-procedure('device-type', 'Для устройства', '',
     3413   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3414   run fltfield-add in this-procedure('cr-db-num', 'Создана в БД', '',
     3415   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3416   Filter-Block:
     3417   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     3418       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     3419       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     3420     run gbl/filter.w ( INPUT parparentproc
     3421                      , INPUT filter-point + chr(4) + filter-point-label
     3422                      , INPUT tbl
     3423                      , INPUT join-tbl
     3424                      , INPUT fld
     3425                      , INPUT lab
     3426                      , INPUT spr
     3427                      , INPUT dim ).
     3428     RUN OpenBr IN THIS-PROCEDURE (INPUT yes
     3429                                  ,INPUT no
     3430                                  ,INPUT '':U).
     3431   end.
     3432   END PROCEDURE.
