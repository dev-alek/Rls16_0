        1   DEFINE BUFFER locked_wi-mode FOR ub.wi-mode.
        2   DEFINE TEMP-TABLE tt-wi-mode NO-UNDO LIKE ub.wi-mode.
        3   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        4   DEFINE INPUT PARAMETER p-mode AS CHARACTER NO-UNDO.
        5   DEFINE INPUT PARAMETER p-mode-type AS character NO-UNDO.
        6   DEFINE INPUT PARAMETER p-mode-id AS character NO-UNDO.
        7   DEFINE INPUT-OUTPUT PARAMETER p-rec AS RECID NO-UNDO.
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "Форма для ввода, просмотра и изменения режима работы".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   define variable v-waitfram-action01         as character   no-undo .
       70   define variable v-waitfram-action02         as character   no-undo .
       71   define variable v-waitfram-action03         as character   no-undo .
       72   define variable mWaitFramTextBeg            as character   no-undo.
       73   define variable mWaitFramTextEnd            as character   no-undo.
       74   define variable mWaitFramView               as logical     no-undo.
       75   define variable mWaitProcEvent              as logical     no-undo init yes.
       76   define variable mWaitFramInterval           as integer     no-undo init 1 .
       77   define variable mWaitFramStop               as logical     no-undo.
       78   define variable mWaitFramStopUser           as logical     no-undo.
       79   define variable mWaitFramStopTimeOut        as logical     no-undo.
       80   define variable mWaitFramStartProc          as datetime-tz no-undo.
       81   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       82   define button B-WaitFramStop auto-end-key
       83        label "Стоп"
       84        size 10 by 1 tooltip "Остоновить процесс".
       85   define button B-viewProcInfo
       86        label "Информация"
       87        size 15 by 1 tooltip "Информация о процесс".
       88   define frame waitfram
       89     v-waitfram-action01 format "x(72)" no-label skip
       90     v-waitfram-action02 format "x(72)" no-label skip
       91     v-waitfram-action03 format "x(72)" no-label skip
       92     B-viewProcInfo
       93     B-WaitFramStop at row 4 col 30
       94     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       95     .
       96   define new global shared variable mBatchMode as logical no-undo init ?.
       97   define variable mFramBachModHandle as handle no-undo.
       98   mFramBachModHandle = frame waitfram:handle.
       99   define variable mFameOldVis as logical no-undo.
      100   define variable mVisCUrentVin as logical no-undo.
      101   if session:batch-mode
      102   then
      103      mBatchMode = yes.
      104   if mBatchMode = ? then do:
      105     mVisCUrentVin = current-window:visible.
      106     mFameOldVis = mFramBachModHandle:visible.
      107     mFramBachModHandle:visible  = yes.
      108     mBatchMode = mFramBachModHandle:visible ne yes.
      109     mFramBachModHandle:visible = mFameOldVis.
      110     current-window:visible = mVisCUrentVin.
      111   end.
      112    if  log-manager:logfile-name ne ?
      113     then DO:
      114         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      115         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      116         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      117     end.
      118   on choose of B-WaitFramStop in frame waitfram
      119   do:
      120     mWaitFramStop = yes.
      121     mWaitFramStopUser = yes.
      122   end.
      123   function waitfram-check-timeout returns logical():
      124      define variable vtime as int64 no-undo.
      125      if mWaitFramStopTimeOut
      126      then
      127         return yes.
      128      vtime = ( now - mWaitFramStartProc ) / 1000 .
      129      if     mWaitFramTimeOut ne ?
      130         and mWaitFramTimeOut ne 0
      131         and mWaitFramTimeOut lt vtime
      132      then do:
      133         mWaitFramStopTimeOut = yes.
      134      end.
      135      return mWaitFramStopTimeOut.
      136   end.
      137   procedure waitfram-hide :
      138     if not session:batch-mode
      139     then do
      140     on error undo, return error return-value
      141     :
      142       pause 0 before-hide .
      143       if not mBatchMode then
      144         hide frame waitfram .
      145     if     not mWaitFramView
      146        and mWaitProcEvent
      147     then
      148       process events .
      149     end.
      150   end procedure.
      151   procedure waitfram-show :
      152     define input  parameter p-message as character no-undo .
      153     define variable v-left-margin as integer   no-undo .
      154     if not session:batch-mode
      155     then do
      156     on error undo, return error return-value
      157     :
      158       if length(p-message) <= 70 then do:
      159         assign
      160           v-left-margin = integer((70 - length(p-message)) / 2)
      161         .
      162         assign
      163           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      164         .
      165         assign
      166           v-waitfram-action01 = " "
      167           v-waitfram-action02 = " "
      168                                    + fill(" ", v-left-margin)
      169                                    + p-message
      170           v-waitfram-action03 = " "
      171         .
      172       end.
      173       else do:
      174         define variable vRindex1 as integer no-undo.
      175         define variable vRindex2 as integer no-undo.
      176         vRindex1 = r-index(p-message," ",70).
      177         if vRindex1 = 0
      178         then
      179            vRindex1 = 70.
      180         if length(p-message)  <= vRindex1 + 70 then do:
      181           assign
      182             v-waitfram-action01 = " "
      183             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      184             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      185           .
      186         end.
      187         else do:
      188           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      189           if vRindex2 <= vRindex1
      190           then
      191              vRindex2 = vRindex1 + 70.
      192           assign
      193             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      194             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      195             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      196           .
      197         end.
      198       end.
      199       B-viewProcInfo:visible   in frame waitfram = no.
      200       B-viewProcInfo:sensitive in frame waitfram = no.
      201       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      202       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      203       if  (   mWaitFramView
      204          or  mWaitProcEvent)
      205          and not mBatchMode
      206       then
      207          display
      208             v-waitfram-action01 skip
      209             v-waitfram-action02 skip
      210             v-waitfram-action03 skip
      211          with frame waitfram .
      212       if     mWaitFramView
      213          then do:
      214             if     mWaitFramInterval ne ?
      215                and not mBatchMode
      216             then
      217                wait-for go of frame waitfram pause mWaitFramInterval.
      218          end.
      219          else
      220             if     mWaitProcEvent
      221                and not mBatchMode
      222             then
      223                process events .
      224     end.
      225   end procedure.
      226      procedure waitfram-show-this:
      227         define input  parameter iInterval as int64 no-undo.
      228         define variable vtime as int64 no-undo.
      229         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      230         mWaitFramInterval = iInterval.
      231         run waitfram-show (substitute("&1&2 &3&4" ,
      232                                       mWaitFramTextBeg ,
      233                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      234                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      235                                       mWaitFramTextEnd
      236                                      )
      237                           ).
      238      end.
      239      procedure WaitFramRunPause:
      240         define input  parameter iInterval as dec no-undo.
      241         define variable vStart  as datetime-tz no-undo.
      242         define variable vend    as datetime-tz no-undo.
      243         define variable vint as int64 no-undo.
      244         define variable vOk as logical no-undo.
      245         vStart = now.
      246         vend   = vStart.
      247         publish "WaitFramPause" (iInterval,output vOk).
      248         vend   =  now.
      249         vint = vend - vStart.
      250         vint = iInterval - vint / 1000.
      251         if     not mWaitFramStop
      252            and (   vint > 0
      253                 or (    not vOk
      254                     and iInterval eq ?
      255                     )
      256                 )
      257         then
      258            run waitfram-show-this (iInterval).
      259         vend   =  now.
      260         vint = vend - vStart.
      261         vint = iInterval - vint / 1000.
      262         if     not mWaitFramStop
      263            and vint > 0
      264         then do:
      265            run gbl/pause.p (vint * 1000).
      266         end.
      267         if iInterval ne ?
      268         then
      269            publish "WaitFramStop".
      270         waitfram-check-timeout().
      271      end.
      272      procedure WaitFramWaitFor:
      273         define input  parameter iInterval as dec no-undo.
      274         assign
      275            mWaitFramStartProc   = now
      276            mWaitFramStopUser    = no
      277            mWaitFramStopTimeOut = no
      278         .
      279         block-wait:
      280         do while not mWaitFramStop:
      281            run WaitFramRunPause (iInterval).
      282            if  waitfram-check-timeout()
      283            then do:
      284               leave block-wait.
      285            end.
      286         end.
      287         run waitfram-hide.
      288      end.
      289   procedure waitfram-join :
      290     define input  parameter p-line-1  as character no-undo .
      291     define input  parameter p-line-2  as character no-undo .
      292     define input  parameter p-line-3  as character no-undo .
      293     define output parameter p-message as character no-undo .
      294     do
      295     on error undo, return error return-value
      296     :
      297       assign
      298         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      299                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      300                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      301       .
      302     end.
      303   end procedure.
      304   function waitfram-join-function returns character
      305     (input p-line-1 as character
      306     ,input p-line-2 as character
      307     ,input p-line-3 as character
      308     ).
      309     define variable v-message as character no-undo .
      310     run waitfram-join in this-procedure
      311       (input  p-line-1
      312       ,input  p-line-2
      313       ,input  p-line-3
      314       ,output v-message
      315       ) .
      316     return v-message .
      317   end function .
      318   define new global shared variable g#language as character no-undo .
      319   if g#language <> '' and g#language <> 'rus':U then do:
      320     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      321   end.
      322   procedure proc-alt-shift-f2:
      323     if not ibs.th.gbl.gbl-var:rcode
      324   then
      325     run gbl\inidebug.p .
      326   end.
      327   procedure proc-alt-shift-f3:
      328     run gbl/prvssinf.p
      329       ( input this-procedure
      330       ) .
      331   end.
      332   define variable v-inform-launched as logical no-undo initial false .
      333   procedure proc-alt-shift-f4:
      334     define variable v-action as character no-undo .
      335     if v-inform-launched = false then do:
      336       assign
      337         v-inform-launched = true
      338       .
      339       run gbl/d-inform.w
      340         (  input self
      341         ,  input this-procedure
      342         , output v-action
      343         ) no-error .
      344       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      345       assign
      346         v-inform-launched = false
      347       .
      348     end.
      349   end.
      350   procedure proc-alt-f1:
      351     run gbl/corrhelp.p
      352       (input this-procedure
      353       ) .
      354   end .
      355   on alt-shift-f2 anywhere do:
      356     run proc-alt-shift-f2.
      357   end.
      358   on alt-shift-f3 anywhere do:
      359     run proc-alt-shift-f3 in this-procedure .
      360   end.
      361   on alt-shift-f4 anywhere do:
      362     run proc-alt-shift-f4 in this-procedure.
      363   end.
      364   on alt-f1 anywhere do:
      365     run proc-alt-f1 in this-procedure .
      366   end.
      367   define variable v-admin as logical no-undo .
      368   DEFINE BUFFER buf_wi-mode FOR ub.wi-mode.
      369   DEFINE BUTTON B-codex
      370        IMAGE-UP FILE "btn-down-arrow":U
      371        IMAGE-DOWN FILE "btn-down-arrow":U
      372        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      373        LABEL "Btn 1"
      374        SIZE 3 BY 1.
      375   DEFINE BUTTON B-exit AUTO-GO
      376        LABEL "&Ввод"
      377        SIZE 10 BY 1
      378        BGCOLOR 8 .
      379   DEFINE BUTTON B-Help
      380        LABEL "Помо&щь"
      381        SIZE 3 BY 1
      382        BGCOLOR 8 .
      383   DEFINE BUTTON B-prev-mode-id
      384        IMAGE-UP FILE "btn-down-arrow":U
      385        IMAGE-DOWN FILE "btn-down-arrow":U
      386        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      387        LABEL "Btn 1"
      388        SIZE 3.5 BY 1.
      389   DEFINE BUTTON b-quit AUTO-END-KEY
      390        LABEL "&Отмена"
      391        SIZE 10 BY 1
      392        BGCOLOR 8 .
      393   DEFINE VARIABLE f-prev-mode-id-name AS CHARACTER FORMAT "X(256)":U
      394        VIEW-AS FILL-IN NATIVE
      395        SIZE 66 BY 1 NO-UNDO.
      396   DEFINE VARIABLE f-ruleset-name AS CHARACTER FORMAT "X(256)":U
      397        VIEW-AS FILL-IN NATIVE
      398        SIZE 66 BY 1 NO-UNDO.
      399   DEFINE QUERY Dialog-Frame FOR
      400         tt-wi-mode SCROLLING.
      401   DEFINE FRAME Dialog-Frame
      402        B-exit AT ROW 1 COL 1
      403        b-quit AT ROW 1 COL 11
      404        B-Help AT ROW 1 COL 95
      405        tt-wi-mode.mode-type AT ROW 2.5 COL 14 COLON-ALIGNED WIDGET-ID 22
      406             LABEL "Тип режима" FORMAT "x(255)"
      407             VIEW-AS COMBO-BOX INNER-LINES 5
      408             LIST-ITEM-PAIRS "Item 1","Item 1"
      409             DROP-DOWN-LIST
      410             SIZE 60 BY 1
      411        tt-wi-mode.mode-id AT ROW 4.5 COL 14 COLON-ALIGNED WIDGET-ID 4
      412             LABEL "ID режима"
      413             VIEW-AS FILL-IN
      414             SIZE 10 BY 1
      415        tt-wi-mode.mode-name AT ROW 6.87 COL 31 COLON-ALIGNED WIDGET-ID 20
      416             LABEL "Название" FORMAT "x(40)"
      417             VIEW-AS FILL-IN NATIVE
      418             SIZE 66 BY 1
      419        f-prev-mode-id-name AT ROW 8.47 COL 31 COLON-ALIGNED NO-LABEL WIDGET-ID 24
      420        tt-wi-mode.prev-mode-id AT ROW 8.5 COL 13 COLON-ALIGNED WIDGET-ID 18
      421             LABEL "Пред. режим" FORMAT "x(12)"
      422             VIEW-AS FILL-IN
      423             SIZE 13 BY 1
      424        B-prev-mode-id AT ROW 8.5 COL 29 WIDGET-ID 16
      425        tt-wi-mode.codex_id AT ROW 10.33 COL 13.5 COLON-ALIGNED WIDGET-ID 50
      426             LABEL "Кодекс" FORMAT ">,>>>,>>9"
      427             VIEW-AS FILL-IN
      428             SIZE 9 BY 1
      429        B-codex AT ROW 10.33 COL 25.5 WIDGET-ID 28
      430        f-ruleset-name AT ROW 10.33 COL 31 COLON-ALIGNED NO-LABEL WIDGET-ID 54
      431        tt-wi-mode.ruleset_id AT ROW 11.43 COL 13.5 COLON-ALIGNED WIDGET-ID 52
      432             LABEL "Набор правил" FORMAT ">>>,>>>,>>9"
      433             VIEW-AS FILL-IN
      434             SIZE 9 BY 1
      435        tt-wi-mode.des AT ROW 14 COL 1 NO-LABEL WIDGET-ID 8
      436             VIEW-AS EDITOR SCROLLBAR-VERTICAL
      437             SIZE 98 BY 4
      438        SPACE(0.49) SKIP(0.66)
      439       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      440            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      441            TITLE ""
      442            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      443   ASSIGN
      444          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      445          FRAME Dialog-Frame:HIDDEN           = TRUE.
      446   ON GO OF FRAME Dialog-Frame
      447   DO:
      448     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      449     IF ERROR-STATUS:ERROR THEN DO:
      450         RETURN NO-APPLY.
      451     END.
      452   END.
      453   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      454   DO:
      455     APPLY "END-ERROR":U TO SELF.
      456   END.
      457   ON CHOOSE OF B-codex IN FRAME Dialog-Frame
      458   DO:
      459   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      460   DEFINE VARIABLE v-codex-id AS INTEGER NO-UNDO.
      461   DEFINE BUFFER buf_ruleset FOR ub.ruleset.
      462   IF tt-wi-mode.mode-type = ""
      463   OR tt-wi-mode.mode-type =? THEN DO:
      464      MESSAGE "Не выбран тип режима"
      465      VIEW-AS ALERT-BOX ERROR.
      466      UNDO, RETURN NO-APPLY.
      467   END.
      468   if tt-wi-mode.codex_id <> 0 then do:
      469     find first buf_ruleset no-lock where
      470             buf_ruleset.codex_id = tt-wi-mode.codex_id
      471         and buf_ruleset.ruleset_id = tt-wi-mode.ruleset_id .
      472     v-rid-list = string(recid(buf_ruleset)).
      473   end.
      474   CASE tt-wi-mode.mode-type:
      475       WHEN 'cd-IBS-TH':U THEN DO:
      476           ASSIGN
      477           v-codex-id = 19.
      478       END.
      479       OTHERWISE DO:
      480           MESSAGE
      481           substitute("Неивестен кодекс для режима работы с типом &1", tt-wi-mode.mode-type)
      482           VIEW-AS ALERT-BOX ERROR.
      483           UNDO, RETURN NO-APPLY.
      484       END.
      485   END CASE.
      486   run rul/ruleset-s.w ( INPUT parparentproc
      487                        ,INPUT 'b-sel':U
      488                        ,input "codex"
      489                        ,input v-codex-id
      490                        ,INPUT-OUTPUT v-rid-list) NO-ERROR.
      491   IF v-rid-list <> '':U THEN DO:
      492      FIND FIRST buf_ruleset NO-LOCK WHERE
      493               recid(buf_ruleset) = INTEGER(v-rid-list) NO-ERROR.
      494     IF NOT AVAILABLE buf_RULESET THEN RETURN NO-APPLY.
      495     ASSIGN
      496     tt-wi-mode.codex_id = buf_ruleset.codex_id
      497     tt-wi-mode.ruleset_id = buf_ruleset.ruleset_id
      498     f-ruleset-name = buf_ruleset.NAME
      499     .
      500     DISPLAY
      501     tt-wi-mode.CODEx_id
      502     tt-wi-mode.ruleset_id
      503     f-ruleset-name
      504     WITH FRAME Dialog-Frame.
      505   END.
      506   END.
      507   ON CHOOSE OF B-prev-mode-id IN FRAME Dialog-Frame
      508   DO:
      509   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      510   DEFINE BUFFER buf_wi-mode FOR ub.wi-mode.
      511     IF tt-wi-mode.prev-mode-id > '' THEN DO:
      512         FIND FIRST buf_wi-mode NO-LOCK WHERE
      513                   buf_wi-mode.mode-type = tt-wi-mode.mode-type
      514             AND   buf_wi-mode.mode-id = tt-wi-mode.prev-mode-id NO-ERROR.
      515     END.
      516     run adm/wi-modes.w ( input parparentproc
      517                          ,INPUT "b-sel"
      518                          ,INPUT "mode-type"
      519                          ,INPUT tt-wi-mode.mode-type
      520                          ,INPUT-OUTPUT v-rid-list) NO-ERROR.
      521     IF v-rid-list > '' THEN DO:
      522         FIND FIRST buf_wi-mode NO-LOCK WHERE
      523               RECID(buf_wi-mode) = INTEGER(v-rid-list) NO-ERROR.
      524         IF NOT AVAILABLE buf_wi-mode THEN DO:
      525            ASSIGN
      526            tt-wi-mode.prev-mode-id = ?
      527            f-prev-mode-id-name = ?
      528            .
      529         END.
      530         ELSE DO:
      531            ASSIGN
      532            tt-wi-mode.prev-mode-id = buf_wi-mode.mode-id
      533            f-prev-mode-id-name = buf_wi-mode.mode-name
      534            .
      535         END.
      536         DISPLAY
      537         tt-wi-mode.prev-mode-id
      538         f-prev-mode-id-name
      539         WITH FRAME Dialog-Frame.
      540     END.
      541   END.
      542   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      543   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      544   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      545   on help of frame Dialog-Frame
      546   do:
      547     run gbl/app_help.p
      548       (input this-procedure :file-name
      549       ,input ''
      550       ,input ?
      551       ) no-error.
      552     if error-status :error then do:
      553       message
      554         "Ошибка при вызове помощи"
      555         error-status :get-message(1)
      556         view-as alert-box .
      557     end.
      558   end.
      559   run minbtn-set in this-procedure .
      560   on choose of b-help in frame Dialog-Frame
      561   do:
      562     apply "help":u to frame Dialog-Frame .
      563   end.
      564   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      565   procedure minbtn-set :
      566       do
      567           on error undo, return error return-value
      568           :
      569           define variable ii              as integer       no-undo .
      570           define variable fh              as widget-handle no-undo .
      571           define variable hh              as widget-handle no-undo .
      572           define variable v-h             as handle        extent 4 no-undo .
      573           define variable v-name-button   as character     no-undo .
      574           define variable v-help-old-x    as decimal       no-undo .
      575           define variable v-help-old-y    as decimal       no-undo .
      576           define variable v-help-old-size as decimal       no-undo .
      577           define variable v-frame-width   as decimal       no-undo .
      578           define variable jj              as integer       no-undo .
      579           do
      580               on error undo, return error
      581               :
      582               assign
      583                   v-frame-width = frame Dialog-Frame:width - 0.3
      584                   fh            = frame Dialog-Frame:first-child
      585                   hh            = fh:first-child
      586                   ii            = 1
      587                   .
      588               do while valid-handle(hh):
      589                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      590                   do:
      591                       case lc(hh:name) :
      592                           when "b-help" then
      593                               do:
      594                                   hh:load-image-up("cmp/b-help.bmp":u) .
      595                                   hh:load-image-down("cmp/b-help.bmp":u) .
      596                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      597                                   hh:TOOLTIP = "Помощь" .
      598                                   v-help-old-x = hh:column .
      599                                   v-help-old-y = hh:row    .
      600                                   v-help-old-size = hh:width .
      601                                   hh:width-chars = 2.5 .
      602                               end.
      603                           when "b-print" then
      604                               do:
      605                                   hh:load-image("cmp/b-print.bmp":u) .
      606                                   hh:TOOLTIP = "Печать" .
      607                                   v-h[ii] = hh:handle .
      608                                   ii = ii + 1 .
      609                                   hh:width-chars = 3 .
      610                               end.
      611                           when "b-history" or
      612                           when "b-hist" then
      613                               do:
      614                                   hh:load-image("cmp/b-hist.bmp":u) .
      615                                   hh:TOOLTIP = "История" .
      616                                   v-h[ii] = hh:handle .
      617                                   ii = ii + 1 .
      618                                   hh:width-chars = 3 .
      619                               end.
      620                           when "b-sch" then
      621                               do:
      622                                   hh:load-image("cmp/b-sch.bmp":u) .
      623                                   hh:TOOLTIP = "Установка Фильтра" .
      624                                   v-h[ii] = hh:handle .
      625                                   ii = ii + 1 .
      626                                   hh:width-chars = 3 .
      627                               end.
      628                           when "b-hist-user" then
      629                               do:
      630                                   hh:load-image("cmp/b-hist.bmp":u) .
      631                                   hh:TOOLTIP = "История пользователя" .
      632                                   ii = ii + 1 .
      633                               end.
      634                       end case.
      635                   end.
      636                   hh = hh:next-sibling.
      637               end.
      638               b-help:column = v-frame-width - b-help:width-chars.
      639               jj = 0.
      640               repeat ii = 4 to 1 by -1 :
      641                   if valid-handle (v-h[ii] ) then
      642                   do:
      643                       jj  = jj + 1 .
      644                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      645                       v-h[ii]:row    = v-help-old-y .
      646                   end.
      647               end.
      648           end.
      649       end.
      650   end procedure.
      651   MAIN-BLOCK:
      652   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      653      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      654      ON stop UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      655     if lookup('admin', p-mode) > 0 then do:
      656       v-admin = yes.
      657       p-mode = trim(replace(p-mode, 'admin', ''), chr(44)).
      658     end.
      659     IF p-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
      660       CREATE tt-wi-mode.
      661       assign
      662       tt-wi-mode.mode-type = 'cd-IBS-TH':U.
      663     END.
      664     else do:
      665       IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
      666         FIND FIRST LOCKED_wi-mode EXCLUSIVE-LOCK WHERE
      667                   LOCKED_wi-mode.mode-id = p-mode-id
      668             AND LOCKED_wi-mode.mode-type = p-mode-type .
      669       END.
      670       IF p-mode = 'ПРОСМОТР':U THEN DO:
      671           FIND FIRST LOCKED_wi-mode no-LOCK WHERE
      672                     LOCKED_wi-mode.mode-id = p-mode-id
      673               AND LOCKED_wi-mode.mode-type = p-mode-type NO-ERROR.
      674       END.
      675       create tt-wi-mode.
      676       buffer-copy locked_wi-mode to tt-wi-mode.
      677     end.
      678     RUN Myenable.
      679     WAIT-FOR GO OF FRAME Dialog-Frame.
      680   END.
      681   RUN disable_UI.
      682   PROCEDURE disable_UI :
      683     HIDE FRAME Dialog-Frame.
      684   END PROCEDURE.
      685   PROCEDURE enable_UI :
      686     DISPLAY f-prev-mode-id-name f-ruleset-name
      687         WITH FRAME Dialog-Frame.
      688     IF AVAILABLE tt-wi-mode THEN
      689       DISPLAY tt-wi-mode.mode-type tt-wi-mode.mode-id tt-wi-mode.mode-name
      690             tt-wi-mode.prev-mode-id tt-wi-mode.codex_id tt-wi-mode.ruleset_id
      691             tt-wi-mode.des
      692         WITH FRAME Dialog-Frame.
      693     ENABLE B-exit b-quit B-Help tt-wi-mode.mode-id tt-wi-mode.mode-name
      694            f-prev-mode-id-name tt-wi-mode.prev-mode-id B-prev-mode-id B-codex
      695            tt-wi-mode.des
      696         WITH FRAME Dialog-Frame.
      697     VIEW FRAME Dialog-Frame.
      698   END PROCEDURE.
      699   PROCEDURE MyEnable :
      700   DEFINE BUFFER buf_wi-mode FOR ub.wi-mode.
      701   DEFINE BUFFER buf_ruleset FOR ub.ruleset.
      702   IF tt-wi-mode.prev-mode-id > '' THEN DO:
      703     FIND FIRST buf_wi-mode NO-LOCK WHERE
      704               buf_wi-mode.mode-type = tt-wi-mode.mode-type
      705         AND   buf_wi-mode.mode-id = tt-wi-mode.prev-mode-id NO-ERROR.
      706     IF AVAILABLE buf_wi-mode THEN DO:
      707        f-prev-mode-id-name = buf_wi-mode.mode-name.
      708     END.
      709   END.
      710   if tt-wi-mode.codex_id <> 0 then do:
      711     find first buf_ruleset no-lock where
      712             buf_ruleset.codex_id = tt-wi-mode.codex_id
      713         and buf_ruleset.ruleset_id = tt-wi-mode.ruleset_id .
      714     IF AVAILABLE buf_ruleset THEN DO:
      715         ASSIGN
      716         f-ruleset-name = buf_ruleset.NAME.
      717     END.
      718   end.
      719   tt-wi-mode.MODE-TYPE:LIST-ITEM-PAIRS IN FRAME Dialog-Frame = 'Режимы работы кассы IBS TH POS':U + chr(44) + 'cd-IBS-TH':U.
      720   IF AVAILABLE tt-wi-mode THEN
      721   DISPLAY
      722   tt-wi-mode.mode-type
      723   tt-wi-mode.mode-id
      724   tt-wi-mode.mode-name
      725   tt-wi-mode.prev-mode-id
      726   f-prev-mode-id-name
      727   f-ruleset-name
      728   tt-wi-mode.des
      729   WITH FRAME Dialog-Frame .
      730   ENABLE
      731   B-exit  when p-mode <> 'ПРОСМОТР':U
      732   b-quit
      733   B-Help
      734   tt-wi-mode.mode-type  when p-mode = 'ДОБАВЛЕНИЕ':U AND num-entries(tt-wi-mode.MODE-TYPE:list-item-pairs) > 2
      735   tt-wi-mode.mode-id when p-mode = 'ДОБАВЛЕНИЕ':U
      736   tt-wi-mode.mode-name       when p-mode <> 'ПРОСМОТР':U
      737   b-prev-mode-id WHEN p-mode <> 'ПРОСМОТР':U
      738   b-codex WHEN p-mode <> 'ПРОСМОТР':U
      739   tt-wi-mode.des
      740   WITH FRAME Dialog-Frame .
      741   if p-mode = 'ПРОСМОТР':U then do:
      742     assign
      743     b-quit:label = "&Выход"
      744     b-quit:column = 1
      745     tt-wi-mode.des:READ-ONLY IN FRAME Dialog-Frame = YES .
      746     hide b-exit in frame Dialog-Frame .
      747   end.
      748   VIEW FRAME Dialog-Frame .
      749   END PROCEDURE.
      750   PROCEDURE proc-save :
      751   DEFINE VARIABLE v-rec AS recID  NO-UNDO.
      752   IF p-mode = 'ПРОСМОТР':U THEN DO:
      753       RETURN.
      754   END.
      755   IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
      756     v-rec = p-rec.
      757   END.
      758   ASSIGN
      759   FRAME Dialog-Frame
      760   tt-wi-mode.mode-type
      761   tt-wi-mode.mode-id
      762   tt-wi-mode.mode-name
      763   tt-wi-mode.prev-mode-id
      764   tt-wi-mode.des.
      765   run adm/wi-mode1.p ( INPUT p-mode
      766                   ,INPUT NO
      767                   ,INPUT-OUTPUT v-rec
      768                   ,INPUT tt-wi-mode.mode-type
      769                   ,INPUT tt-wi-mode.mode-id
      770                   ,INPUT tt-wi-mode.prev-mode-id
      771                   ,input tt-wi-mode.codex_id
      772                   ,input tt-wi-mode.ruleset_id
      773                   ,INPUT tt-wi-mode.mode-name
      774                   ,INPUT tt-wi-mode.des
      775                   ) no-error.
      776   if error-status:error then do:
      777   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      778   define variable fh as widget-handle no-undo .
      779   define variable hh as widget-handle no-undo .
      780   define variable rv as character no-undo .
      781   assign
      782   rv = entry(1, return-value , chr(4)).
      783   if rv <> "":U then do:
      784     assign
      785     fh = frame Dialog-Frame:first-child
      786     hh = fh:first-child
      787     .
      788     do while valid-handle(hh):
      789       if hh:name = rv then do:
      790         APPLY "ENTRY" to hh.
      791         undo ,
      792         return error.
      793       end.
      794       hh = hh:next-sibling.
      795     end.
      796   end.
      797     undo, return error.
      798   end.
      799   p-rec = v-rec.
      800   END PROCEDURE.
