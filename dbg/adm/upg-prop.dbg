        1   CREATE WIDGET-POOL.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Настройка Upgrade".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   procedure proc-alt-shift-f2:
       63     if not ibs.th.gbl.gbl-var:rcode
       64   then
       65     run gbl\inidebug.p .
       66   end.
       67   procedure proc-alt-shift-f3:
       68     run gbl/prvssinf.p
       69       ( input this-procedure
       70       ) .
       71   end.
       72   define variable v-inform-launched as logical no-undo initial false .
       73   procedure proc-alt-shift-f4:
       74     define variable v-action as character no-undo .
       75     if v-inform-launched = false then do:
       76       assign
       77         v-inform-launched = true
       78       .
       79       run gbl/d-inform.w
       80         (  input self
       81         ,  input this-procedure
       82         , output v-action
       83         ) no-error .
       84       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       85       assign
       86         v-inform-launched = false
       87       .
       88     end.
       89   end.
       90   procedure proc-alt-f1:
       91     run gbl/corrhelp.p
       92       (input this-procedure
       93       ) .
       94   end .
       95   on alt-shift-f2 anywhere do:
       96     run proc-alt-shift-f2.
       97   end.
       98   on alt-shift-f3 anywhere do:
       99     run proc-alt-shift-f3 in this-procedure .
      100   end.
      101   on alt-shift-f4 anywhere do:
      102     run proc-alt-shift-f4 in this-procedure.
      103   end.
      104   on alt-f1 anywhere do:
      105     run proc-alt-f1 in this-procedure .
      106   end.
      107   define new global shared variable g#language as character no-undo .
      108   if g#language <> '' and g#language <> 'rus':U then do:
      109     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      110   end.
      111   DEFINE BUTTON b-get-dir-src DEFAULT
      112        IMAGE-UP FILE "btn-down-arrow":U
      113        IMAGE-DOWN FILE "btn-down-arrow":U
      114        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      115        LABEL ""
      116        SIZE 3 BY 1
      117        BGCOLOR 8 .
      118   DEFINE BUTTON b-get-dir-trg DEFAULT
      119        IMAGE-UP FILE "btn-down-arrow":U
      120        IMAGE-DOWN FILE "btn-down-arrow":U
      121        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      122        LABEL ""
      123        SIZE 3 BY 1
      124        BGCOLOR 8 .
      125   DEFINE BUTTON b-save DEFAULT
      126        LABEL "&Сохранить"
      127        SIZE 10 BY 1
      128        BGCOLOR 8 .
      129   DEFINE VARIABLE f-prev-ver AS CHARACTER FORMAT "X(5)":U INITIAL "14_0"
      130        LABEL "Номер версии"
      131        VIEW-AS COMBO-BOX INNER-LINES 1
      132        LIST-ITEMS "14_0"
      133        DROP-DOWN-LIST
      134        SIZE 8.63 BY 1 NO-UNDO.
      135   DEFINE VARIABLE f-ini-path AS CHARACTER FORMAT "X(256)":U
      136        LABEL "Путь к progress.ini"
      137        VIEW-AS FILL-IN
      138        SIZE 33.38 BY 1 NO-UNDO.
      139   DEFINE VARIABLE f-src-path AS CHARACTER FORMAT "X(256)":U
      140        LABEL "Путь к пакету upgrade"
      141        VIEW-AS FILL-IN
      142        SIZE 31.88 BY 1 NO-UNDO.
      143   DEFINE VARIABLE f-target-path AS CHARACTER FORMAT "X(256)":U
      144        LABEL "Путь к новой версии"
      145        VIEW-AS FILL-IN
      146        SIZE 31.88 BY 1 NO-UNDO.
      147   DEFINE RECTANGLE RECT-3
      148        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      149        SIZE 69 BY 3.13.
      150   DEFINE RECTANGLE RECT-4
      151        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      152        SIZE 69 BY 3.21.
      153   DEFINE FRAME upg-prop
      154        b-save AT ROW 1.13 COL 1
      155        f-ini-path AT ROW 3 COL 27 COLON-ALIGNED
      156        f-prev-ver AT ROW 4.13 COL 27 COLON-ALIGNED
      157        f-src-path AT ROW 6.08 COL 27 COLON-ALIGNED
      158        b-get-dir-src AT ROW 6.08 COL 61.5
      159        b-get-dir-trg AT ROW 7.25 COL 61.5
      160        f-target-path AT ROW 7.29 COL 27 COLON-ALIGNED
      161        RECT-3 AT ROW 2.5 COL 2
      162        RECT-4 AT ROW 5.67 COL 2
      163       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      164            SIDE-LABELS NO-UNDERLINE THREE-D
      165            AT COL 1 ROW 1
      166            SIZE 71 BY 8.17.
      167   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      168   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      169   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      170   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      171   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      172   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      173   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      174   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      175       ASSIGN adm-object-hdl = FRAME upg-prop:HANDLE.
      176   RUN ensure-broker.
      177   THIS-PROCEDURE:ADM-DATA =
      178        'ADM1.1~`':U +
      179        'SmartObject~`':U +
      180        'FRAME~`':U +
      181        'NO ~`':U +
      182        '~`':U +
      183        '~`':U +
      184        '~`':U +
      185        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      186           + "~`":U +
      187        'Layout,Hide-on-Init~`':U +
      188        '~`':U +
      189        '~`':U +
      190        '~`~`~`~`~`~`~`~`~`~`~`':U +
      191        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      192            THEN "^^":U
      193        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      194             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      195   PROCEDURE adm-apply-entry :
      196     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      197   END PROCEDURE.
      198   PROCEDURE adm-destroy :
      199    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      200   END PROCEDURE.
      201   PROCEDURE adm-disable :
      202       DISABLE b-save RECT-3 RECT-4 f-prev-ver f-src-path b-get-dir-src b-get-dir-trg f-target-path WITH FRAME upg-prop.
      203       RUN dispatch ('disable-fields':U).
      204       RUN set-attribute-list ('ENABLED=no':U).
      205       RETURN.
      206   END PROCEDURE.
      207   PROCEDURE adm-edit-attribute-list :
      208         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
      209         RETURN.
      210   END PROCEDURE.
      211   PROCEDURE adm-enable :
      212       ENABLE UNLESS-HIDDEN b-save RECT-3 RECT-4 f-prev-ver f-src-path b-get-dir-src b-get-dir-trg f-target-path WITH FRAME upg-prop.
      213       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      214       RUN set-attribute-list ('ENABLED=yes':U).
      215       RETURN.
      216   END PROCEDURE.
      217   PROCEDURE adm-exit :
      218        RUN notify ('exit':U).
      219     RETURN.
      220   END PROCEDURE.
      221   PROCEDURE adm-hide :
      222     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      223   END PROCEDURE.
      224   PROCEDURE adm-initialize :
      225     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      226   END PROCEDURE.
      227   PROCEDURE adm-show-errors :
      228       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      229       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      230           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      231       END.
      232       RETURN.
      233   END PROCEDURE.
      234   PROCEDURE adm-UIB-mode :
      235     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      236   END PROCEDURE.
      237   PROCEDURE adm-view :
      238     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      239   END PROCEDURE.
      240   PROCEDURE dispatch :
      241       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      242       RUN broker-dispatch IN adm-broker-hdl
      243           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      244       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      245   END PROCEDURE.
      246   PROCEDURE ensure-broker :
      247   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      248   IF RETURN-VALUE NE "ADM-Broker":U THEN
      249   DO:
      250       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      251       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      252   END.
      253   END PROCEDURE.
      254   PROCEDURE get-attribute :
      255     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      256     RUN broker-get-attribute IN adm-broker-hdl
      257         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      258     RETURN RETURN-VALUE.
      259   END PROCEDURE.
      260   PROCEDURE get-attribute-list :
      261     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      262     RUN broker-get-attribute-list IN adm-broker-hdl
      263         (INPUT THIS-PROCEDURE,
      264          INPUT ?,
      265          OUTPUT p-attr-list) NO-ERROR.
      266     RETURN.
      267   END PROCEDURE.
      268   PROCEDURE new-state :
      269     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      270     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      271     RETURN.
      272   END PROCEDURE.
      273   PROCEDURE notify :
      274     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      275     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      276     IF RETURN-VALUE = "ADM-ERROR":U THEN
      277         RETURN "ADM-ERROR":U.
      278     RETURN.
      279   END PROCEDURE.
      280   PROCEDURE set-attribute-list :
      281     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      282     RUN ensure-broker.
      283     RUN broker-set-attribute-list IN adm-broker-hdl
      284         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      285     RETURN.
      286   END PROCEDURE.
      287   PROCEDURE set-position :
      288       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      289       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      290       IF VALID-HANDLE(adm-object-hdl) THEN
      291       DO:
      292           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
      293           IF adm-object-hdl:TYPE = "WINDOW":U THEN
      294           DO:
      295             IF p-row = 0 THEN p-row =
      296               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
      297             IF p-col = 0 THEN p-col =
      298               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
      299           END.
      300           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
      301           DO:
      302             parent-hdl = adm-object-hdl:PARENT.
      303             IF p-row = 0 THEN p-row =
      304               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
      305                 parent-hdl:ROW.
      306             IF p-col = 0 THEN p-col =
      307               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
      308                 parent-hdl:COL.
      309           END.
      310           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
      311           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
      312         ASSIGN adm-object-hdl:ROW    =   p-row
      313                adm-object-hdl:COLUMN =   p-col.
      314       END.
      315       RETURN.
      316   END PROCEDURE.
      317   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
      318       STRING(adm-object-hdl)).
      319   PAUSE 0 BEFORE-HIDE.
      320   PROCEDURE adm-change-page :
      321     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
      322     END PROCEDURE.
      323   PROCEDURE delete-page :
      324     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
      325     RUN broker-delete-page IN adm-broker-hdl
      326         (INPUT THIS-PROCEDURE, INPUT p-page#).
      327     END PROCEDURE.
      328   PROCEDURE init-object :
      329     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
      330     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
      331     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
      332     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
      333     RUN broker-init-object IN adm-broker-hdl
      334         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
      335          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
      336     RETURN.
      337   END PROCEDURE.
      338   PROCEDURE init-pages :
      339     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
      340     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      341         INPUT p-page-list) NO-ERROR.
      342     END PROCEDURE.
      343   PROCEDURE select-page :
      344     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
      345     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      346         INPUT p-page#) NO-ERROR.
      347     END PROCEDURE.
      348   PROCEDURE view-page :
      349     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
      350     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      351         INPUT p-page#).
      352     END PROCEDURE.
      353   ON CHOOSE OF b-get-dir-src IN FRAME upg-prop
      354   DO:
      355       define variable s-path        as character no-undo .
      356       define variable dir-type      as character no-undo .
      357       define variable dir-can-write as logical   no-undo .
      358       run gbl/dir-sel.p ( output s-path,
      359                       output dir-type,
      360                       output dir-can-write
      361                     ).
      362       if trim( s-path ) <> "" then do:
      363         assign
      364           f-src-path = s-path
      365         .
      366         disp f-src-path with frame upg-prop.
      367       end.
      368   END.
      369   ON CHOOSE OF b-get-dir-trg IN FRAME upg-prop
      370   DO:
      371       define variable t-path        as character no-undo .
      372       define variable dir-type      as character no-undo .
      373       define variable dir-can-write as logical   no-undo .
      374       run gbl/dir-sel.p ( output t-path,
      375                       output dir-type,
      376                       output dir-can-write
      377                     ).
      378       if trim( t-path ) <> "" then do:
      379         if dir-can-write then do:
      380           assign
      381             f-target-path = t-path
      382             .
      383           disp f-target-path with frame upg-prop.
      384         end.
      385         else do:
      386           message "В дир." t-path "невозможна запись." skip
      387                   "Выберете другую, доступную для записи."
      388                   view-as alert-box error.
      389         end.
      390       end.
      391   END.
      392   ON CHOOSE OF b-save IN FRAME upg-prop
      393   DO:
      394     assign
      395       f-prev-ver
      396       f-src-path
      397       f-target-path
      398     .
      399     put-key-value section "upgrade" key "ini-path" value f-ini-path.
      400     put-key-value section "upgrade" key "prev-ver" value f-prev-ver.
      401     put-key-value section "upgrade" key "upg-path"  value f-src-path.
      402     put-key-value section "upgrade" key "dir-ver"  value f-target-path.
      403     if trim( f-src-path ) = "":U
      404        or f-src-path = "?":U
      405        or f-src-path = ?
      406     then do:
      407       message 'Не задан параметр "Путь к пакету upgrade"' view-as alert-box error.
      408       apply "entry" to f-src-path in frame upg-prop.
      409       return no-apply.
      410     end.
      411     if trim( f-target-path ) = "":U
      412        or f-target-path = "?":U
      413        or f-target-path = ?
      414     then do:
      415       message 'Не задан параметр "Путь к новой версии"' view-as alert-box error.
      416       apply "entry" to f-target-path in frame upg-prop.
      417       return no-apply.
      418     end.
      419     else do:
      420       assign
      421         file-info:file-name = f-target-path
      422       .
      423       if file-info:full-pathname = ? then do:
      424         os-create-dir value( f-target-path ) .
      425         if os-error <> 0 then do:
      426           message 'Невозможно создать каталог для новой версии!' view-as alert-box error.
      427           apply "entry" to f-target-path in frame upg-prop.
      428           return no-apply.
      429         end.
      430       end.
      431       os-copy
      432         value( search( 'cmp/str-glbl.i':U ) )
      433         value( f-target-path )
      434         .
      435       if os-error <> 0 then do:
      436         message 'Невозможно записать в каталог для новой версии!' view-as alert-box error.
      437         apply "entry" to f-target-path in frame upg-prop.
      438         return no-apply.
      439       end.
      440       os-command silent value( 'attrib -r':U + chr(32) + f-target-path + chr(47) + 'cmp/str-glbl.i':U ).
      441       os-delete value( f-target-path + chr(47) + 'cmp/str-glbl.i':U ) .
      442     end.
      443     message
      444        vss-workfile vss-revision vss-description skip
      445       "Настройки Upgrade сохранены"
      446       view-as alert-box information.
      447   END.
      448   if not this-procedure :persistent
      449   then do:
      450     message
      451       vss-workfile vss-revision vss-description skip
      452       "Ошибка при запуске процедуры" skip
      453       "Данную процедуру следует запускать только с параметром persistent" skip
      454       view-as alert-box error .
      455     undo, return error .
      456   end.
      457   define variable v-exe-file as character no-undo .
      458   define variable v-prev-ver as character no-undo .
      459   run gbl/getexini.p ( OUTPUT v-exe-file, OUTPUT f-ini-path ) no-error .
      460   if error-status :error then do:
      461     return error.
      462   end.
      463   get-key-value section "upgrade" key "prev-ver" value v-prev-ver.
      464   if lookup( v-prev-ver, f-prev-ver:list-items ) > 0 then do:
      465     assign
      466       f-prev-ver = v-prev-ver
      467     .
      468   end.
      469   get-key-value section "upgrade" key "upg-path" value f-src-path.
      470   get-key-value section "upgrade" key "dir-ver"  value f-target-path.
      471   PROCEDURE adm-create-objects :
      472   END PROCEDURE.
      473   PROCEDURE adm-row-available :
      474     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
      475     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
      476     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
      477     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
      478     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
      479     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
      480     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
      481     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
      482     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
      483     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
      484     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      485     IF adm-updating-record THEN RETURN.
      486     RUN get-attribute ('FIELDS-ENABLED':U).
      487     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
      488     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
      489         OUTPUT link-handle) NO-ERROR.
      490     IF link-handle = "":U THEN
      491         RETURN.
      492     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
      493     IF NUM-ENTRIES(link-handle) > 1 THEN
      494         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
      495             "encountered more than one RECORD-SOURCE.":U SKIP
      496             "The first - ":U record-source-hdl:file-name " - will be used.":U
      497                VIEW-AS ALERT-BOX ERROR.
      498     RUN get-attribute ('Key-Name':U).
      499     key-name = RETURN-VALUE.
      500     IF key-name = "":U THEN key-name = ?.
      501     IF key-name NE ? THEN DO:
      502       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
      503         NO-ERROR.
      504       IF key-value NE ? THEN
      505         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
      506     END.
      507   IF VALID-HANDLE (adm-object-hdl) THEN
      508       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      509   RUN notify IN THIS-PROCEDURE ('row-available':U).
      510   END PROCEDURE.
      511   PROCEDURE disable_UI :
      512     HIDE FRAME upg-prop.
      513     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
      514   END PROCEDURE.
      515   PROCEDURE enable_UI :
      516     DISPLAY f-ini-path f-prev-ver f-src-path f-target-path
      517         WITH FRAME upg-prop.
      518     ENABLE b-save RECT-3 RECT-4 f-prev-ver f-src-path b-get-dir-src b-get-dir-trg
      519            f-target-path
      520         WITH FRAME upg-prop.
      521   END PROCEDURE.
      522   PROCEDURE send-records :
      523   END PROCEDURE.
      524   PROCEDURE state-changed :
      525     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
      526     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      527   END PROCEDURE.
