      369   procedure thbjattr_code_reg :
      370   define input  parameter p-upper-code     as character no-undo .
      371   define input  parameter p-code           as character no-undo .
      372   define output parameter p-label          as character no-undo .
      373   define output parameter p-user-can-edit  as logical   no-undo .
      374   define output parameter p-output-display as logical   no-undo .
      375   define output parameter p-other          as character no-undo .
