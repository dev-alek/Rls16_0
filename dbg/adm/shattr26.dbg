      525       (input  p-obj-type
      526       ,input  p-obj-code
      527       ,input  p-upper-code
      528       ,input  p-code
      529       ,input  p-value-character
      530       ,input  p-value-date
      531       ,input  p-value-decimal
      532       ,input  p-value-integer
      533       ,input  p-value-logical
