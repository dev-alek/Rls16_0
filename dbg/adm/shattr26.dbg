      621   procedure proc-alt-shift-f2:
      622     if not ibs.th.gbl.gbl-var:rcode
      623   then
      624     run gbl\inidebug.p .
      625   end.
      626   procedure proc-alt-shift-f3:
      627     run gbl/prvssinf.p
      628       ( input this-procedure
      629       ) .
      630   end.
      631   define variable v-inform-launched as logical no-undo initial false .
      632   procedure proc-alt-shift-f4:
      633     define variable v-action as character no-undo .
      634     if v-inform-launched = false then do:
      635       assign
      636         v-inform-launched = true
      637       .
      638       run gbl/d-inform.w
      639         (  input self
      640         ,  input this-procedure
      641         , output v-action
      642         ) no-error .
      643       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      644       assign
      645         v-inform-launched = false
      646       .
      647     end.
      648   end.
      649   procedure proc-alt-f1:
      650     run gbl/corrhelp.p
      651       (input this-procedure
      652       ) .
      653   end .
      654   on alt-shift-f2 anywhere do:
      655     run proc-alt-shift-f2.
      656   end.
      657   on alt-shift-f3 anywhere do:
      658     run proc-alt-shift-f3 in this-procedure .
      659   end.
      660   on alt-shift-f4 anywhere do:
      661     run proc-alt-shift-f4 in this-procedure.
      662   end.
      663   on alt-f1 anywhere do:
      664     run proc-alt-f1 in this-procedure .
      665   end.
      666   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      667     define variable v-cntxt-db-num        as integer   no-undo .
      668     define variable v-cntxt-userid        as character no-undo .
      669     define variable v-cntxt-level         as character no-undo .
      670     define variable v-cntxt-host-code-obj as integer   no-undo .
      671     define variable v-cntxt-obj-type      as character no-undo .
      672     define variable v-cntxt-obj-code      as integer   no-undo .
      673     define variable v-cntxt-db-num-obj    as integer   no-undo .
      674     define variable v-cntxt-is-admin      as logical   no-undo .
      675   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      676   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      677   procedure gen-key-rec :
      678     define input  parameter p-tbl-name    as character no-undo.
      679     define input  parameter p-bh_tbl-name as handle    no-undo.
      680     define output parameter p-key-rec     as character no-undo.
      681     do
      682     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      683     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      684     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      685     :
      686       define variable fh               as handle    no-undo .
      687       define variable v-ok             as logical   no-undo .
      688       define variable v-inform         as character no-undo .
      689       define variable v-ind            as integer   no-undo .
      690       define variable v-idx-field-qnty as integer   no-undo .
      691       if p-tbl-name = ?
      692         or p-tbl-name = "":U
      693       then do:
      694         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info5 ).
      695       end.
      696       if not p-bh_tbl-name:available then do:
      697         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info5, p-tbl-name ).
      698       end.
      699       assign
      700         p-key-rec = p-tbl-name
      701         v-inform  = p-bh_tbl-name:index-information(1)
      702         v-ind     = 2
      703       .
      704       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      705       on error undo, return error
      706       :
      707         assign
      708           v-inform = p-bh_tbl-name:index-information( v-ind )
      709           v-ind    = v-ind + 1
      710         .
      711       end.
      712       if v-inform = ?
      713         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      714         or entry( 3, v-inform, ",":U ) <> "1":U
      715       then do:
      716         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, p-tbl-name ).
      717       end.
      718       else do:
      719         assign
      720           v-idx-field-qnty = num-entries( v-inform ) - 4
      721         .
      722         if v-idx-field-qnty < 2 then do:
      723           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, p-tbl-name ).
      724         end.
      725         do v-ind = 1 to v-idx-field-qnty by 2
      726         on error undo, return error
      727         :
      728           assign
      729             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      730             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      731           .
      732         end.
      733       end.
      734       if p-key-rec = ? then do:
      735         assign
      736           p-key-rec = "":U
      737         .
      738         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info5, p-tbl-name ).
      739       end.
      740     end.
      741     return.
      742   end procedure.
      743   procedure gen-where-keyr-tab :
      744     define input  parameter i-tableSerach as character no-undo.
      745     define input  parameter i-tablekey   as character  no-undo.
      746     define input  parameter p-key-rec    as character  no-undo.
      747     define input  parameter p-key-handle as handle     no-undo .
      748     define input  parameter p-db-name    as character  no-undo .
      749     define input  parameter p-tt-handle  as handle     no-undo .
      750     define output parameter o-Where      as character  no-undo.
      751     do
      752     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      753     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      754     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      755     :
      756       define variable v-full-tbl-name  as character no-undo .
      757       define variable bh_tbl-name      as handle    no-undo .
      758       define variable fh_key           as handle    no-undo .
      759       define variable fh_search        as handle    no-undo .
      760       define variable v-field-num      as integer   no-undo .
      761       define variable v-count-fld      as integer   no-undo .
      762       define variable v-inform         as character no-undo .
      763       define variable v-ind            as integer   no-undo .
      764       define variable v-idx-field-qnty as integer   no-undo .
      765       define variable v-field-name     as character no-undo .
      766       define variable v-field-val      as character no-undo .
      767       define variable v-word-link      as character no-undo .
      768       define variable vTable           as character no-undo.
      769       define variable bh_tbl-key       as handle    no-undo .
      770       assign
      771         p-key-rec = trim( p-key-rec )
      772       .
      773       if p-key-handle <> ? then do:
      774         if not valid-handle(p-key-handle)
      775            or p-key-handle:type <> "buffer"
      776         then do:
      777           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info5 ).
      778         end.
      779         if num-entries( p-key-rec, chr(3) ) > 1
      780           or p-key-rec = ?
      781           or p-key-rec = "":U
      782         then do:
      783           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info5, p-key-rec ).
      784         end.
      785       end.
      786       else do:
      787         if p-key-rec = ?
      788           or p-key-rec = "":U
      789         then do:
      790           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      791         end.
      792       end.
      793       assign
      794         vTable = entry( 1 , p-key-rec, chr(3) )
      795       .
      796       if p-tt-handle <> ?
      797         and ( not valid-handle(p-tt-handle)
      798               or p-tt-handle:type <> "buffer"
      799             )
      800       then do:
      801         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info5, vTable, chr(10) ).
      802       end.
      803       if p-tt-handle = ? then do:
      804         assign
      805           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      806         .
      807         create buffer bh_tbl-name for table v-full-tbl-name .
      808       end.
      809       else do:
      810         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      811       end.
      812       assign
      813         v-inform = bh_tbl-name:index-information(1)
      814         v-ind    = 2
      815       .
      816       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      817       on error undo, return error
      818       :
      819         assign
      820           v-inform = bh_tbl-name:index-information( v-ind )
      821           v-ind    = v-ind + 1
      822         .
      823       end.
      824       if v-inform = ?
      825         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      826         or entry( 3, v-inform, ",":U ) <> "1":U
      827       then do:
      828         delete object bh_tbl-name no-error.
      829         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info5, vTable ).
      830       end.
      831       assign
      832         v-idx-field-qnty = num-entries( v-inform ) - 4
      833       .
      834       if v-idx-field-qnty < 2 then do:
      835         delete object bh_tbl-name no-error.
      836         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, vTable ).
      837       end.
      838       assign
      839         o-where     = "where":U
      840         v-word-link = "":U
      841         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      842         v-count-fld = 0
      843       .
      844       if i-tablekey ne "" and i-tablekey ne ?
      845       then do:
      846         assign
      847           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      848         .
      849         create buffer bh_tbl-key for table v-full-tbl-name .
      850       end.
      851       if i-tableSerach ne "" and i-tableSerach ne ?
      852       then do:
      853         delete object bh_tbl-name no-error.
      854         assign
      855           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      856         .
      857         create buffer bh_tbl-name for table v-full-tbl-name .
      858       end.
      859       block_where:
      860       do v-ind = 1 to v-idx-field-qnty by 2
      861       on error undo, return error
      862       :
      863         assign
      864           v-count-fld = v-count-fld + 1
      865         .
      866         if p-key-handle = ?
      867           and v-count-fld > v-field-num
      868         then do:
      869           leave block_where.
      870         end.
      871         define variable VfieldKeyTable as handle no-undo.
      872         assign
      873           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      874           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      875         .
      876         if     bh_tbl-key ne ?
      877         then do:
      878            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      879            if VfieldKeyTable eq ?
      880            then next block_where.
      881         end.
      882         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      883         then
      884            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      885         else
      886            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      887         if p-key-handle = ? then do:
      888           assign
      889             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      890           .
      891         end.
      892         else do:
      893           assign
      894             fh_key = p-key-handle:buffer-field( v-field-name )
      895           .
      896           if fh_key = ?
      897             or not valid-handle( fh_key )
      898           then do:
      899             delete object bh_tbl-name.
      900             if     bh_tbl-key ne ?
      901             then
      902                delete object bh_tbl-key.
      903             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info5, p-key-handle:name, v-field-name ).
      904           end.
      905           assign
      906             v-field-val = fh_key:buffer-value
      907           .
      908         end.
      909         if fh_search:data-type ="character":U then do:
      910           assign
      911             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      912             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      913             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      914             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      915             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      916             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      917             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      918             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      919             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      920             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      921             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      922             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      923             v-field-val = substitute( '"&1"', v-field-val )
      924           .
      925         end.
      926         assign
      927           o-where = substitute( "&1 &2", o-where, v-field-val )
      928         .
      929         if v-word-link = "":U then do:
      930           assign
      931             v-word-link = "and":U
      932           .
      933         end.
      934       end.
      935       delete object bh_tbl-name.
      936       if     bh_tbl-key ne ?
      937       then
      938          delete object bh_tbl-key.
      939       if p-key-handle = ?
      940         and v-count-fld <> v-field-num
      941       then do:
      942         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info5, vTable ).
      943       end.
      944     end.
      945   end procedure.
      946   procedure gen-hn-keyr-tab :
      947     define input  parameter i-tableSerach as character no-undo.
      948     define input  parameter i-tablekey   as character no-undo.
      949     define input  parameter p-key-rec    as character no-undo.
      950     define input  parameter p-key-handle as handle    no-undo .
      951     define input  parameter p-db-name    as character no-undo .
      952     define input  parameter p-tt-handle  as handle    no-undo .
      953     define input  parameter p-stts-lock  as integer   no-undo .
      954     define output parameter o-hn         as handle    no-undo.
      955     define variable v-full-tbl-name as character no-undo.
      956     define variable v-where         as character no-undo.
      957     define variable bh_tbl-name     as handle    no-undo.
      958     define variable vTable          as character no-undo.
      959     do
      960     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      961     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      962     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      963         run gen-where-keyr-tab(i-tableSerach,
      964                                i-tablekey,
      965                                p-key-rec,
      966                                p-key-handle,
      967                                p-db-name,
      968                                p-tt-handle,
      969                                output v-where).
      970         if i-tableSerach ne "" and i-tableSerach ne ?
      971         then do:
      972            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      973            create buffer bh_tbl-name for table v-full-tbl-name .
      974         end.
      975         else do:
      976            if p-tt-handle = ? then do:
      977               assign
      978                  vTable = entry( 1 , p-key-rec, chr(3) )
      979               .
      980               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      981               create buffer bh_tbl-name for table v-full-tbl-name .
      982            end.
      983            else do:
      984               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      985            end.
      986         end.
      987         if p-tt-handle = ? then do:
      988            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      989         end.
      990         else do:
      991            bh_tbl-name:find-first( v-where ) no-error .
      992         end.
      993         o-hn = bh_tbl-name.
      994      end.
      995   end procedure.
      996   procedure gen-hn-keyr :
      997     define input  parameter p-key-rec    as character no-undo.
      998     define input  parameter p-key-handle as handle    no-undo .
      999     define input  parameter p-db-name    as character no-undo .
     1000     define input  parameter p-tt-handle  as handle    no-undo .
     1001     define input  parameter p-stts-lock  as integer   no-undo .
     1002     define output parameter o-hn         as handle    no-undo.
     1003     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1004   end.
     1005   procedure gen-row-keyr :
     1006     define input  parameter p-key-rec    as character no-undo.
     1007     define input  parameter p-key-handle as handle    no-undo .
     1008     define input  parameter p-db-name    as character no-undo .
     1009     define input  parameter p-tt-handle  as handle    no-undo .
     1010     define input  parameter p-stts-lock  as integer   no-undo .
     1011     define output parameter p-tbl-row    as rowid     no-undo.
     1012     define output parameter p-tbl-name   as character no-undo.
     1013     define variable vHn as handle no-undo.
     1014       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1015       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1016       p-tbl-name =  vHn:table.
     1017       delete object vHn no-error.
     1018     if p-tbl-row = ? then do:
     1019       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info5, p-tbl-name, p-key-rec ).
     1020     end.
     1021     else do:
     1022       return.
     1023     end.
     1024   end procedure.
     1025   procedure gen-key-fv :
     1026     define input  parameter p-key-rec    as character no-undo .
     1027     define output parameter p-field-list as character no-undo .
     1028     define output parameter p-value-list as character no-undo.
     1029     do
     1030     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1031     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1032     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1033     :
     1034       define variable v-full-tbl-name  as character no-undo .
     1035       define variable bh_tbl-name      as handle    no-undo .
     1036       define variable v-tbl-name       as character no-undo .
     1037       define variable v-field-num      as integer   no-undo .
     1038       define variable v-count-fld      as integer   no-undo .
     1039       define variable v-inform         as character no-undo .
     1040       define variable v-ind            as integer   no-undo .
     1041       define variable v-idx-field-qnty as integer   no-undo .
     1042       define variable v-delim-key      as character no-undo .
     1043       if p-key-rec = ?
     1044         or p-key-rec = "":U
     1045       then do:
     1046         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
     1047       end.
     1048       assign
     1049         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1050         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1051       .
     1052       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1053       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info5 ).
     1054       assign
     1055         v-inform = bh_tbl-name:index-information(1)
     1056         v-ind    = 2
     1057       .
     1058       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1059       on error undo, return error
     1060       :
     1061         assign
     1062           v-inform = bh_tbl-name:index-information( v-ind )
     1063           v-ind    = v-ind + 1
     1064         .
     1065       end.
     1066       if v-inform = ?
     1067         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1068         or entry( 3, v-inform, ",":U ) <> "1":U
     1069       then do:
     1070         delete object bh_tbl-name no-error.
     1071         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
     1072       end.
     1073       assign
     1074         v-idx-field-qnty = num-entries( v-inform ) - 4
     1075       .
     1076       if v-idx-field-qnty < 2 then do:
     1077         delete object bh_tbl-name no-error.
     1078         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
     1079       end.
     1080       assign
     1081         p-field-list = "":U
     1082         p-value-list = "":U
     1083         v-delim-key  = "":U
     1084         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1085         v-count-fld  = 0
     1086       .
     1087       block_where:
     1088       do v-ind = 1 to v-idx-field-qnty by 2
     1089       on error undo, return error
     1090       :
     1091         assign
     1092           v-count-fld = v-count-fld + 1
     1093         .
     1094         if v-count-fld > v-field-num then do:
     1095           leave block_where.
     1096         end.
     1097         assign
     1098           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1099           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1100         .
     1101         if v-ind = 1 then do:
     1102           assign
     1103             v-delim-key = chr(3)
     1104           .
     1105         end.
     1106       end.
     1107       delete object bh_tbl-name.
     1108       if v-count-fld <> v-field-num then do:
     1109         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info5, v-tbl-name ).
     1110       end.
     1111     end.
     1112   end procedure.
     1113   procedure gen-key-field :
     1114     define input  parameter p-table      as character no-undo .
     1115     define output parameter p-field-list as character no-undo .
     1116     do
     1117     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1118     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1119     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1120     :
     1121       define variable v-full-tbl-name  as character no-undo .
     1122       define variable bh_tbl-name      as handle    no-undo .
     1123       define variable v-tbl-name       as character no-undo .
     1124       define variable v-field-num      as integer   no-undo .
     1125       define variable v-count-fld      as integer   no-undo .
     1126       define variable v-inform         as character no-undo .
     1127       define variable v-ind            as integer   no-undo .
     1128       define variable v-idx-field-qnty as integer   no-undo .
     1129       define variable v-delim-key      as character no-undo .
     1130       if p-table = ?
     1131         or p-table = "":U
     1132       then do:
     1133         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info5 ).
     1134       end.
     1135       assign
     1136         v-tbl-name      = p-table
     1137         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1138       .
     1139       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1140       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info5 ).
     1141       assign
     1142         v-inform = bh_tbl-name:index-information(1)
     1143         v-ind    = 2
     1144       .
     1145       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1146       on error undo, return error
     1147       :
     1148         assign
     1149           v-inform = bh_tbl-name:index-information( v-ind )
     1150           v-ind    = v-ind + 1
     1151         .
     1152       end.
     1153       if v-inform = ?
     1154         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1155         or entry( 3, v-inform, ",":U ) <> "1":U
     1156       then do:
     1157         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
     1158       end.
     1159       assign
     1160         v-idx-field-qnty = num-entries( v-inform ) - 4
     1161       .
     1162       if v-idx-field-qnty < 2 then do:
     1163         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
     1164       end.
     1165       assign
     1166         p-field-list = "":U
     1167         v-delim-key  = "":U
     1168         v-count-fld  = 0
     1169       .
     1170       block_where:
     1171       do v-ind = 1 to v-idx-field-qnty by 2
     1172       on error undo, return error
     1173       :
     1174         assign
     1175           v-count-fld = v-count-fld + 1
     1176         .
     1177         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1178         if v-ind = 1 then do:
     1179           assign
     1180             v-delim-key = chr(3)
     1181           .
     1182         end.
     1183       end.
     1184       delete object bh_tbl-name.
     1185     end.
     1186   end procedure.
     1187   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1188   FUNCTION get-region RETURNS CHARACTER
     1189     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1190     define variable par-region as character no-undo.
     1191     if parhost-code = 0 and
     1192          parobj-type = "":U and
     1193          parobj-code = 0 then do:
     1194          par-region = "Глобально".
     1195          return par-region.
     1196       end.
     1197       if parobj-type = 'орг':U then do:
     1198          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1199          return par-region.
     1200       end.
     1201       if parobj-type = 'регион':U
     1202       then do:
     1203          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1204          return par-region.
     1205       end.
     1206       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1207       return par-region.
     1208   END FUNCTION.
     1209   FUNCTION get-objregion RETURNS CHARACTER
     1210     (  input parobj-type as character, input parobj-code as integer ) :
     1211     define variable par-region as character no-undo.
     1212     if  parobj-type = "":U and
     1213         parobj-code = 0
     1214     then do:
     1215        par-region = "Глобально".
     1216     end.
     1217     else if parobj-type = 'орг':U
     1218     then do:
     1219        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1220     end.
     1221     else if parobj-type = 'регион':U
     1222     then do:
     1223        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1224     end.
     1225     else
     1226        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1227     return par-region.
     1228   END FUNCTION.
     1229   FUNCTION calldscr returns character ( input p-call-id as character):
     1230   define variable v-descr as character no-undo .
     1231   define variable v-field-list as character no-undo .
     1232   define variable v-value-list as character no-undo.
     1233   define variable v-prop-label as character no-undo .
     1234   define variable v-node-label as character no-undo .
     1235   define variable v-dt-code as integer no-undo .
     1236   define variable v-host-code as integer no-undo .
     1237   define variable v-obj-type as character no-undo .
     1238   define variable v-obj-code as integer no-undo .
     1239   define variable v-label as character no-undo .
     1240   define variable v-node-code as integer no-undo .
     1241   define buffer buf_prop-head for ub.prop-head.
     1242   define buffer buf_prop-ref for ub.prop-ref.
     1243   define buffer buf_prop-map for ub.prop-map.
     1244   run gen-key-fv in this-procedure ( input p-call-id
     1245                                     ,output v-field-list
     1246                                     ,output v-value-list) no-error .
     1247   if error-status:error then return p-call-id.
     1248   CASE entry(1, p-call-id, chr(3)):
     1249     when 'dis-card-type':U then do:
     1250       v-descr = substitute("Тип ДК: эмитент &1 тип: &2"
     1251                            ,integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1252                            ,entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
     1253                            ).
     1254     end.
     1255     when 'dis-card':U then do:
     1256       v-descr = substitute("ДК: № &1"
     1257                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1258                            ).
     1259     end.
     1260     when 'dis-card-property':U then do:
     1261       v-dt-code = integer(entry(lookup("dt-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1262       v-node-code = integer(entry(lookup("node-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1263       v-host-code = integer(entry(lookup("host-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1264       v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3)) .
     1265       v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1266       find first buf_prop-ref no-lock where
     1267                 buf_prop-ref.dt-code = v-dt-code no-error .
     1268       if available buf_prop-ref then do:
     1269         find first buf_prop-head no-lock where
     1270                   buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error .
     1271         v-prop-label = buf_prop-head.prop-label.
     1272         find first buf_prop-map no-lock where
     1273                   buf_prop-map.dtm-code = buf_prop-ref.dtm-code
     1274               and buf_prop-map.node-code = v-node-code no-error .
     1275         if available buf_prop-map then do:
     1276           v-label = buf_prop-map.node-label.
     1277         end.
     1278       end.
     1279       v-descr = substitute("ДК: № &1 &2:&3 &4"
     1280                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1281                            ,v-prop-label
     1282                            ,v-label
     1283                            ,get-region(v-host-code, v-obj-type, v-obj-code)
     1284                            ).
     1285     end.
     1286     when 'clients':U then do:
     1287       v-descr = substitute("&1&2"
     1288                            ,entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
     1289                            ,integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1290                            ).
     1291     end.
     1292     when 'ext-system':U then do:
     1293       v-descr = substitute("Внешняя система &1"
     1294                            ,integer(entry(lookup("esys-id", v-field-list, chr(3)), v-value-list, chr(3)))
     1295                            ).
     1296     end.
     1297     WHEN 'thbj-attr':U then do:
     1298       if entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum':U
     1299       or entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum_obj':U
     1300       then do:
     1301         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'goods':U then do:
     1302           v-descr = "Операции с товарами".
     1303         end.
     1304         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'clients':U then do:
     1305           v-descr = "Операции с клиентами".
     1306         end.
     1307         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'gds-grp':U then do:
     1308           v-descr = "Операции с группами товаров".
     1309         end.
     1310         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'cli-grp':U then do:
     1311           v-descr = "Операции с группами клиентов".
     1312         end.
     1313         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th':U then do:
     1314           v-descr = "Операции с чеками на POS IBS-TH".
     1315         end.
     1316         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th-mob':U then do:
     1317           v-descr = "Операции с чеками на POS IBS-TH-MOB".
     1318         end.
     1319         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'edoc':U then do:
     1320           v-descr = "Операции в системе электронного документооборота".
     1321         end.
     1322         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'thref':U then do:
     1323           v-descr = "Операции со справочниками".
     1324         end.
     1325         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'pdf':U then do:
     1326           v-descr = "Операции с ДНЦ и переоценками".
     1327         end.
     1328         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rep':U then do:
     1329           v-descr = "Отчеты".
     1330         end.
     1331         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'ord':U then do:
     1332           v-descr = "Операции с заказами".
     1333         end.
     1334       end.
     1335     end.
     1336     when 'cash-desk':U then do:
     1337       v-descr = substitute("БД &1 Маг &2 Касса № &4 &3"
     1338                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1339                            ,entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3))
     1340                            ,entry(lookup("cash-num", v-field-list, chr(3)), v-value-list, chr(3))
     1341                            ,entry(lookup("pos-type", v-field-list, chr(3)), v-value-list, chr(3))
     1342                            ).
     1343     end.
     1344     when 'ext-file':U then do:
     1345       v-descr = substitute("БД &1 Файл № &3 (из БД &2)"
     1346                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1347                            ,entry(lookup("from-db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1348                            ,entry(lookup("file-num", v-field-list, chr(3)), v-value-list, chr(3))
     1349                            ).
     1350     end.
     1351   end case.
     1352   return v-descr.
     1353   end function.
     1354   DEFINE VARIABLE v-db-num LIKE ub.db.db-num NO-UNDO.
     1355   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO.
     1356   DEFINE VARIABLE v-to-create AS logical NO-UNDO.
     1357   define variable v-host-code as integer no-undo .
     1358   DEFINE VARIABLE v-uniq-key-rec AS CHARACTER NO-UNDO.
     1359   define variable v-processed-uniq-key-rec as character no-undo .
     1360   DEFINE VARIABLE rule-display-option AS CHARACTER NO-UNDO.
     1361   DEFINE VARIABLE rule-proc-option AS CHARACTER NO-UNDO.
     1362   define variable v-current-upper-prop-code as character no-undo .
     1363   DEFINE VARIABLE v-is-obj AS LOGICAL NO-UNDO.
     1364   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
     1365   DEFINE BUFFER buf_temp-thbj-attr FOR temp-thbj-attr.
     1366   define variable v-tth as handle no-undo .
     1367   assign
     1368   v-tth = buffer thbjattr_thbj-attr:table-handle .
     1369   FUNCTION get-profile-dynamic RETURNS LOGICAL
     1370     ( INPUT p-profile-id AS INTEGER )  FORWARD.
     1371   FUNCTION get-profile-name RETURNS CHARACTER
     1372     ( INPUT p-profile-id AS INTEGER )  FORWARD.
     1373   FUNCTION get-prop-label RETURNS CHARACTER
     1374     ( INPUT p-prop-code AS character )  FORWARD.
     1375   DEFINE MENU MENU-b-rule
     1376          MENU-ITEM m_text         LABEL "Текст"
     1377          MENU-ITEM m_graph        LABEL "Схема"         .
     1378   DEFINE MENU menu-b-ruleproc
     1379          MENU-ITEM m_rpoc_text    LABEL "Текст"
     1380          MENU-ITEM m_rpoc_graph   LABEL "Графика"       .
     1381   DEFINE BUTTON B-chg  NO-FOCUS
     1382        LABEL "&Изменить"
     1383        SIZE 10 BY 1.
     1384   DEFINE BUTTON B-Help
     1385        LABEL "Помо&щь"
     1386        SIZE 3 BY 1
     1387        BGCOLOR 8 .
     1388   DEFINE BUTTON B-history
     1389        LABEL "Ис&тория"
     1390        SIZE 3 BY 1.
     1391   DEFINE BUTTON b-params
     1392        LABEL "Пар-ры"
     1393        SIZE 10 BY 1.
     1394   DEFINE BUTTON b-quit AUTO-END-KEY
     1395        LABEL "&Выход"
     1396        SIZE 10 BY 1
     1397        BGCOLOR 8 .
     1398   DEFINE BUTTON b-rule
     1399        LABEL "Правило"
     1400        SIZE 10 BY 1.
     1401   DEFINE BUTTON b-ruleproc
     1402        LABEL "Процессы"
     1403        SIZE 12 BY 1.
     1404   DEFINE BUTTON B-ruleset
     1405        LABEL "Т-ка вызова"
     1406        SIZE 14 BY 1.
     1407   DEFINE VARIABLE E-rule-name AS CHARACTER
     1408        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1409        SIZE 98 BY 2.17
     1410        FGCOLOR 4  NO-UNDO.
     1411   DEFINE VARIABLE Rs-algo-profile AS CHARACTER
     1412        VIEW-AS RADIO-SET HORIZONTAL
     1413        RADIO-BUTTONS
     1414             "Item 1", "1",
     1415   "Item 2", "2"
     1416        SIZE 28 BY 1 NO-UNDO.
     1417   DEFINE VARIABLE rs-algo-types AS INTEGER INITIAL 2
     1418        VIEW-AS RADIO-SET HORIZONTAL
     1419        RADIO-BUTTONS
     1420             "Все", 1,
     1421   "Определенные пользователем", 2
     1422        SIZE 36 BY .77 NO-UNDO.
     1423   DEFINE QUERY br-profile FOR
     1424         X_rp-by-call,
     1425         X2_rule-profile SCROLLING.
     1426   DEFINE QUERY br-rule-by-call FOR
     1427         X_rule-by-call,
     1428         X_rule-profile SCROLLING.
     1429   DEFINE QUERY BR-thbj-attr FOR
     1430         buf_temp-thbj-attr SCROLLING.
     1431   DEFINE BROWSE br-profile
     1432     QUERY br-profile NO-LOCK DISPLAY
     1433         X_rp-by-call.profile_id COLUMN-LABEL "Про!файл" FORMAT ">>9"
     1434   get-profile-name ( INPUT X_rp-by-call.profile_id) COLUMN-LABEL "Название" FORMAT "X(255)"
     1435   get-profile-dynamic ( INPUT X_rp-by-call.profile_id) COLUMN-LABEL "Отклю!чаемый" FORMAT "+/":U
     1436   X_rp-by-call.once-more COLUMN-LABEL "№!привязки" FORMAT ">9"
     1437       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 10
     1438            TITLE "Алгоритмы" ROW-HEIGHT-CHARS .67.
     1439   DEFINE BROWSE br-rule-by-call
     1440     QUERY br-rule-by-call NO-LOCK DISPLAY
     1441         X_rule-by-call.can-calc COLUMN-LABEL "Включен?" FORMAT "+/":U
     1442   X_rule-by-call.algo-des FORMAT "X(255)":U COLUMN-LABEL "Описание алгоритма/правила" WIDTH 56
     1443   X_rule-by-call.is_dynamic COLUMN-LABEL "Отклю!чаемое" FORMAT "+/":U
     1444   X_rule-by-call.codex_id COLUMN-LABEL "Кодекс!правил" FORMAT ">>>>>>9":U WIDTH 7
     1445   X_rule-by-call.ruleset_id COLUMN-LABEL "Набор!правил" FORMAT ">>>>>>9":U width 7
     1446   X_rule-by-call.order_id COLUMN-LABEL "Порядок!вызова" FORMAT ">>9":U WIDTH 9
     1447   X_rule-by-call.rule_id COLUMN-LABEL "Код!правила" FORMAT ">>>>>>>>9":U WIDTH 9
     1448   X_rule-by-call.profile_id COLUMN-LABEL "Алгоритм" FORMAT ">>9":U WIDTH 8
     1449       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 10
     1450            FONT 4
     1451            TITLE "Правила" ROW-HEIGHT-CHARS .67.
     1452   DEFINE BROWSE BR-thbj-attr
     1453     QUERY BR-thbj-attr DISPLAY
     1454         get-prop-label(buf_temp-thbj-attr.prop-code) COLUMN-LABEL "Вид алгоритмов" FORMAT "X(90)"
     1455   buf_temp-thbj-attr.property-value-logical COLUMN-LABEL "Активен" FORMAT "+/-"
     1456       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 8 FIT-LAST-COLUMN.
     1457   DEFINE FRAME Dialog-Frame
     1458        B-chg AT ROW 1 COL 41
     1459        b-quit AT ROW 1 COL 1
     1460        b-ruleproc AT ROW 1 COL 79 WIDGET-ID 24
     1461        B-history AT ROW 1 COL 92 WIDGET-ID 26
     1462        B-Help AT ROW 1 COL 95
     1463        BR-thbj-attr AT ROW 2 COL 1 WIDGET-ID 300
     1464        Rs-algo-profile AT ROW 10 COL 1 NO-LABEL WIDGET-ID 16
     1465        rs-algo-types AT ROW 10 COL 28.5 NO-LABEL WIDGET-ID 20
     1466        b-rule AT ROW 10 COL 64.5 WIDGET-ID 14
     1467        b-params AT ROW 10 COL 74.5 WIDGET-ID 6
     1468        B-ruleset AT ROW 10 COL 84.5 WIDGET-ID 12
     1469        br-rule-by-call AT ROW 11 COL 1 WIDGET-ID 100
     1470        br-profile AT ROW 11 COL 1 WIDGET-ID 200
     1471        E-rule-name AT ROW 21.47 COL 1 NO-LABEL WIDGET-ID 2
     1472        SPACE(0.29) SKIP(0.00)
     1473       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1474            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1475            TITLE "Машина правил (встраиваемые процедуры)"
     1476            CANCEL-BUTTON b-quit.
     1477   ASSIGN
     1478          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1479          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1480   ASSIGN
     1481          b-rule:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-rule:HANDLE.
     1482   ASSIGN
     1483          b-ruleproc:POPUP-MENU IN FRAME Dialog-Frame       = MENU menu-b-ruleproc:HANDLE.
     1484   ASSIGN
     1485          E-rule-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1486   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1487   DO:
     1488     APPLY "END-ERROR":U TO SELF.
     1489   END.
     1490   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1491   DO:
     1492     DEFINE VARIABLE v-code AS integer NO-UNDO.
     1493     define variable v-name as character no-undo.
     1494     DEFINE VARIABLE v-log AS logical NO-UNDO.
     1495     DEFINE variable v-rid AS RECID NO-UNDO.
     1496     DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1497     define variable v-host-code as integer no-undo .
     1498     define variable v-value-character as character no-undo .
     1499     define variable v-value-date as date no-undo .
     1500     define variable v-value-decimal as decimal no-undo .
     1501     define variable v-value-integer as INTEGER no-undo .
     1502     define variable v-value-logical AS LOGICAL no-undo .
     1503     define variable v-param-type as character no-undo .
     1504     define variable v-tbl-row as rowid no-undo .
     1505     define variable v-tbl-name as character no-undo .
     1506     define variable v-rec as recid no-undo .
     1507     define variable v-found as decimal no-undo .
     1508     define variable v-mode as character no-undo .
     1509     define buffer buf_thbj-attr for ub.thbj-attr.
     1510     define buffer buf2_temp-thbj-attr for temp-thbj-attr.
     1511     if p-obj-type = 'маг':U
     1512     or p-obj-type = 'скл':U then do:
     1513   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1514   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1515     (input  p-obj-type
     1516     ,input  p-obj-code
     1517     ,output v-host-code
     1518     )  .
     1519     end.
     1520     run gen-row-keyr in this-procedure (
     1521                                           input  v-processed-uniq-key-rec
     1522                                         ,input  ?
     1523                                         ,input  "ub"
     1524                                         ,input  ?
     1525                                         ,input  NO-LOCK
     1526                                         ,output v-tbl-row
     1527                                         ,output v-tbl-name
     1528                                         ).
     1529     find first buf_thbj-attr no-lock where
     1530               rowid(buf_thbj-attr) = v-tbl-row no-error.
     1531     if not available buf_thbj-attr then do:
     1532       v-to-create = yes.
     1533     end.
     1534     if v-to-create then do:
     1535       run adm/shattri.p (
     1536                     input "check":U
     1537                   , input p-obj-type
     1538                   , input p-obj-code
     1539                   , input v-current-upper-prop-code
     1540                   , INPUT '':U
     1541                   , output v-value-character
     1542                   , output v-value-date
     1543                   , output v-value-decimal
     1544                   , output v-value-integer
     1545                   , output v-value-logical
     1546                   , output v-param-type
     1547                   , input-output table-handle v-tth
     1548                   ) no-error .
     1549       if error-status:error then do:
     1550         message
     1551         "Некорректное значение ПАРАМЕТРОВ" skip
     1552         error-status:get-message(1) skip
     1553         return-value
     1554         view-as alert-box error .
     1555         undo, return no-apply .
     1556       end.
     1557       RUN thbjattr_set-section IN THIS-PROCEDURE (
     1558           input p-obj-type
     1559           ,input p-obj-code
     1560           ,input v-current-upper-prop-code
     1561           ,INPUT table thbjattr_thbj-attr
     1562       ) NO-ERROR.
     1563       IF ERROR-STATUS:error THEN do:
     1564         MESSAGE ERROR-STATUS:get-message(1)  SKIP
     1565         RETURN-VALUE
     1566         VIEW-AS ALERT-BOX.
     1567         UNDO, RETURN no-apply.
     1568       END.
     1569     end.
     1570     if v-to-create
     1571     and not (p-obj-type = ''
     1572             and
     1573             p-obj-code = 0)
     1574     then do:
     1575       v-mode = 'КОПИРОВАНИЕ':U.
     1576     end.
     1577     else do:
     1578       v-mode = p-mode.
     1579     end.
     1580     run adm/thbj-rum.w (
     1581                          input parparentproc
     1582                         ,input v-mode
     1583                         ,input v-host-code
     1584                         ,input (if p-obj-type = 'маг':U
     1585                                or p-obj-type = 'скл':U
     1586                                then p-obj-type
     1587                                else "")
     1588                         ,input (if p-obj-type = 'маг':U
     1589                                or p-obj-type = 'скл':U
     1590                                then p-obj-code
     1591                                else 0)
     1592                         ,input buf_temp-thbj-attr.prop-code
     1593                         ,input v-processed-uniq-key-rec) no-error.
     1594     v-rec = recid(buf_temp-thbj-attr).
     1595     find first buf2_temp-thbj-attr where recid(buf2_temp-thbj-attr) = recid(buf_temp-thbj-attr).
     1596     run  thbjattr_value in this-procedure ( input buf2_temp-thbj-attr.obj-type
     1597                                            ,input buf2_temp-thbj-attr.obj-code
     1598                                            ,input buf2_temp-thbj-attr.upper-prop-code
     1599                                            ,input buf2_temp-thbj-attr.prop-code
     1600                                            ,output buf2_temp-thbj-attr.property-value-character
     1601                                            ,output buf2_temp-thbj-attr.property-value-date
     1602                                            ,output buf2_temp-thbj-attr.property-value-decimal
     1603                                            ,output buf2_temp-thbj-attr.property-value-integer
     1604                                            ,output buf2_temp-thbj-attr.property-value-logical
     1605                                            ,output buf2_temp-thbj-attr.prop-value-type
     1606                                            ,output v-found).
     1607     release buf2_temp-thbj-attr.
     1608     OPEN QUERY BR-thbj-attr FOR EACH buf_temp-thbj-attr WHERE     buf_temp-thbj-attr.obj-type = p-obj-type AND buf_temp-thbj-attr.obj-code = p-obj-code                                                     .
     1609     reposition br-thbj-attr to recid v-rec no-error.
     1610     apply "entry" to br-thbj-attr.
     1611     APPLY "VALUE-CHANGED" to browse br-thbj-attr.
     1612   END.
     1613   ON CHOOSE OF B-history IN FRAME Dialog-Frame
     1614   DO:
     1615     DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1616     run ref/cthbjatr.w (
     1617                          input parparentproc
     1618                         ,input v-cntxt-host-code-obj
     1619                         ,input v-cntxt-obj-type
     1620                         ,input v-cntxt-obj-code
     1621                         ,input ''
     1622                         ,input "one"
     1623                         ,input buf_temp-thbj-attr.obj-type
     1624                         ,input buf_temp-thbj-attr.obj-code
     1625                         ,input buf_temp-thbj-attr.upper-prop-code
     1626                         ,input buf_temp-thbj-attr.prop-code
     1627                         ,input ?
     1628                         ,input "":U
     1629                         ,input "":U
     1630                         ,input v-cntxt-db-num
     1631                         ,input-output v-rid-list  ) no-error .
     1632   END.
     1633   ON CHOOSE OF b-params IN FRAME Dialog-Frame
     1634   DO:
     1635   DEFINE BUFFER buf_rule-call-param FOR ub.rule-call-param.
     1636   define buffer buf_rule-by-call for ub.rule-by-call.
     1637     CASE Rs-algo-profile:
     1638       when 'rule-by-call':U then do:
     1639         IF NOT AVAILABLE X_rule-by-call THEN RETURN NO-APPLY.
     1640         FOR EACH tt0-rule-call-param NO-LOCK:
     1641           DELETE tt0-rule-call-param.
     1642         END.
     1643         FOR EACH buf_rule-call-param NO-LOCK WHERE
     1644                 buf_rule-call-param.codex_id = X_rule-by-call.codex_id
     1645             AND buf_rule-call-param.ruleset_id = X_rule-by-call.ruleset_id
     1646             AND buf_rule-call-param.call_id = X_rule-by-call.call_id:
     1647             CREATE tt0-rule-call-param.
     1648             BUFFER-COPY buf_rule-call-param TO tt0-rule-call-param.
     1649         END.
     1650         run ref/rulercps.w (
     1651                                 input parparentproc
     1652                                 ,input this-procedure:handle
     1653                                 ,input '':U
     1654                                 ,input 'ПРОСМОТР':U
     1655                                 ,input 'rule-call-param':U
     1656                                 ,input 0
     1657                                 ,input ?
     1658                                 ,input X_rule-by-call.call_id
     1659                                 ,input X_rule-by-call.codex_id
     1660                                 ,input X_rule-by-call.ruleset_id
     1661                                 ,input X_rule-by-call.order_id
     1662                                 ,input X_rule-by-call.RULE_id
     1663                                 ,INput substitute("Правило &1", X_rule-by-call.RULE_id)
     1664                                 ,input-output table tt0-rule-call-param  ) no-error.
     1665         IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1666       end.
     1667       when 'rp-by-call':U then do:
     1668         IF NOT AVAILABLE X_rp-by-call THEN RETURN NO-APPLY.
     1669         FOR EACH tt0-rule-call-param NO-LOCK:
     1670           DELETE tt0-rule-call-param.
     1671         END.
     1672         define variable vv-call-id as character no-undo .
     1673         define variable v-ii as integer no-undo .
     1674         define buffer buf_rule-profile for ub.rule-profile.
     1675         define buffer buf_rp-by-call for ub.rp-by-call.
     1676         find first buf_rule-profile no-lock where
     1677                   buf_rule-profile.profile_id = X_rp-by-call.profile_id.
     1678         for each buf_rule-by-call no-lock where
     1679               buf_rule-by-call.call_id = X_rp-by-call.call_id
     1680           and buf_rule-by-call.profile_id = X_rp-by-call.profile_id
     1681           and buf_rule-by-call.once-more = X_rp-by-call.once-more,
     1682            EACH buf_rule-call-param NO-LOCK WHERE
     1683                 buf_rule-call-param.call_id = buf_rule-by-call.call_id
     1684             AND buf_rule-call-param.codex_id = buf_rule-by-call.codex_id
     1685             AND buf_rule-call-param.ruleset_id = buf_rule-by-call.ruleset_id
     1686             AND buf_rule-call-param.order_id = buf_rule-by-call.order_id :
     1687             CREATE tt0-rule-call-param.
     1688             BUFFER-COPY buf_rule-call-param TO tt0-rule-call-param.
     1689         END.
     1690         if buf_rule-profile.profile-type = 'cmb':U then do:
     1691           do v-ii = 1 to num-entries('dis-card-type,goods,clients,gds-grp,cli-grp,chk-doc_IBS-TH,chk-doc_IBS-TH-MOB,edoc,thref,pdf,rep,ord,cmb,fdoc':U):
     1692            assign
     1693            vv-call-id = X_rp-by-call.call_id.
     1694             entry(lookup('cmb':U, X_rp-by-call.call_id, chr(3)), vv-call-id, chr(3)) = entry(v-ii, 'dis-card-type,goods,clients,gds-grp,cli-grp,chk-doc_IBS-TH,chk-doc_IBS-TH-MOB,edoc,thref,pdf,rep,ord,cmb,fdoc':U).
     1695             for each buf_rp-by-call no-lock where
     1696                     buf_rp-by-call.call_id = vv-call-id
     1697                 and buf_rp-by-call.parent-once-more = X_rp-by-call.once-more
     1698                 and buf_rp-by-call.parent-profile_id = X_rp-by-call.profile_id,
     1699                 each  buf_rule-by-call no-lock where
     1700                   buf_rule-by-call.call_id = vv-call-id
     1701               and buf_rule-by-call.profile_id = buf_rp-by-call.profile_id
     1702               and buf_rule-by-call.once-more = buf_rp-by-call.once-more
     1703               ,
     1704               EACH buf_rule-call-param NO-LOCK WHERE
     1705                     buf_rule-call-param.call_id = buf_rule-by-call.call_id
     1706                 AND buf_rule-call-param.codex_id = buf_rule-by-call.codex_id
     1707                 AND buf_rule-call-param.ruleset_id = buf_rule-by-call.ruleset_id
     1708                 AND buf_rule-call-param.order_id = buf_rule-by-call.order_id :
     1709                 CREATE tt0-rule-call-param.
     1710                 BUFFER-COPY buf_rule-call-param TO tt0-rule-call-param.
     1711             end.
     1712           end.
     1713         end.
     1714         define variable v-param-form as character no-undo .
     1715         v-param-form = (if buf_rule-profile.custom-param-form > 0
     1716                         then  substitute("rul/rcps-&1.w", buf_rule-profile.profile_id)
     1717                         else "ref/rulercps.w")
     1718         .
     1719         run value(v-param-form) (
     1720                                  input parparentproc
     1721                                 ,input this-procedure:handle
     1722                                 ,input '':U
     1723                                 ,input 'ПРОСМОТР':U
     1724                                 ,input 'rp-rule-param':U
     1725                                 ,input X_rp-by-call.profile_id
     1726                                 ,input X_rp-by-call.once-more
     1727                                 ,input X_rp-by-call.call_id
     1728                                 ,input 0
     1729                                 ,input 0
     1730                                 ,input ?
     1731                                 ,input 0
     1732                                 ,INput substitute("Профайл &1 Номер привязки &2 &3"
     1733                                       , X_rp-by-call.profile_id
     1734                                       , X_rp-by-call.once-more
     1735                                       , calldscr(X_rp-by-call.call_id)
     1736                                       )
     1737                                 ,input-output table tt0-rule-call-param  ) no-error.
     1738         IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1739       end.
     1740     end case.
     1741   END.
     1742   ON CHOOSE OF b-rule IN FRAME Dialog-Frame
     1743   DO:
     1744     IF NOT AVAILABLE X_rule-by-call THEN RETURN NO-APPLY.
     1745     IF rule-display-option = "" THEN DO:
     1746      run gbl/pop-up.p ( input self:handle, input no) no-error.
     1747     END.
     1748     IF rule-display-option = "" THEN DO:
     1749       RETURN NO-APPLY.
     1750     END.
     1751     RUN proc-display-rule IN THIS-PROCEDURE (
     1752                                               INPUT rule-display-option
     1753                                              ,INPUT X_rule-by-call.codex_id
     1754                                              ,INPUT X_rule-by-call.ruleset_id
     1755                                              ,INPUT X_rule-by-call.call_Id
     1756                                              ,INPUT X_rule-by-call.order_id
     1757                                              ,INPUT X_rule-by-call.rule_id) NO-ERROR.
     1758     IF ERROR-STATUS:ERROR THEN DO:
     1759       ASSIGN
     1760       rule-display-option = "".
     1761       RETURN NO-APPLY.
     1762     END.
     1763     ASSIGN
     1764     rule-display-option = "".
     1765   END.
     1766   ON CHOOSE OF b-ruleproc IN FRAME Dialog-Frame
     1767   DO:
     1768     IF NOT AVAILABLE buf_temp-thbj-attr THEN RETURN NO-APPLY.
     1769   IF rule-proc-option = '':U THEN DO:
     1770      run gbl/pop-up.p ( INPUT SELF:handle, input no ) no-error.
     1771      if error-status :error then do: return no-apply. end.
     1772   end.
     1773   if rule-proc-option = "":U then do:
     1774         return no-apply.
     1775   end.
     1776   run rule-proc IN THIS-PROCEDURE ( v-uniq-key-rec, INPUT rule-proc-option) no-error .
     1777   IF ERROR-STATUS:ERROR THEN DO:
     1778       rule-proc-option = '':U.
     1779       RETURN NO-APPLY.
     1780   END.
     1781   rule-proc-option = '':U.
     1782   END.
     1783   ON CHOOSE OF B-ruleset IN FRAME Dialog-Frame
     1784   DO:
     1785     DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     1786   define buffer buf_ruleset for ub.ruleset.
     1787     IF NOT AVAILABLe X_rule-by-call THEN DO:
     1788         RETURN NO-APPLY.
     1789     END.
     1790     FIND FIRST buf_ruleset NO-LOCK WHERE
     1791               buf_ruleset.codex_id = X_rule-by-call.codex_id
     1792           AND buf_ruleset.ruleset_id = X_rule-by-call.ruleset_id.
     1793     run rul/ruleset-i.w ( input parparentproc
     1794                          ,input 'ПРОСМОТР':U
     1795                          ,input buf_ruleset.codex_id
     1796                          ,input buf_ruleset.ruleset_id
     1797                          ,input-output v-rec) no-error.
     1798   END.
     1799   ON VALUE-CHANGED OF br-profile IN FRAME Dialog-Frame
     1800   DO:
     1801     IF NOT AVAILABLE X_rp-by-call THEN DO:
     1802        e-rule-name:SCREEN-VALUE = ''.
     1803     END.
     1804     ELSE DO:
     1805       e-rule-name:SCREEN-VALUE = X_rp-by-call.ps.
     1806     END.
     1807   END.
     1808   ON VALUE-CHANGED OF br-rule-by-call IN FRAME Dialog-Frame
     1809   DO:
     1810     DEFINE BUFFER buf_rule FOR ub.RULE.
     1811     IF NOT AVAILABLE X_rule-by-call THEN RETURN NO-APPLY.
     1812     FIND FIRST buf_rule NO-LOCK WHERE
     1813               buf_rule.RULE_id = X_rule-by-call.RULE_id NO-ERROR.
     1814     IF NOT AVAILABLE buf_rule THEN DO:
     1815        e-rule-name:SCREEN-VALUE = SUBSTITUTE("!!!Правило &1 не найдено", X_rule-by-call.RULE_Id).
     1816     END.
     1817     ELSE DO:
     1818       e-rule-name:SCREEN-VALUE = buf_rule.name + chr(10) + buf_rule.documentation.
     1819     END.
     1820   END.
     1821   ON VALUE-CHANGED OF BR-thbj-attr IN FRAME Dialog-Frame
     1822   DO:
     1823     define buffer buf_thbj-attr for ub.thbj-attr.
     1824     IF NOT AVAILABLE buf_temp-thbj-attr THEN do:
     1825       v-uniq-key-rec = ''.
     1826       v-processed-uniq-key-rec = ''.
     1827     end.
     1828     RUN gen-key-rec IN THIS-PROCEDURE (
     1829      input  'thbj-attr':U
     1830     ,INPUT (BUFFER buf_temp-thbj-attr:handle)
     1831                                     ,OUTPUT v-processed-uniq-key-rec) no-error.
     1832     if p-obj-type <> '' then do:
     1833       find first buf_thbj-attr share-lock where
     1834                 buf_thbj-attr.obj-type = p-obj-type
     1835             and buf_thbj-attr.obj-code = p-obj-code
     1836             and buf_thbj-attr.upper-prop-code = 'rum_obj':U
     1837             and buf_thbj-attr.prop-code = buf_temp-thbj-attr.prop-code
     1838             and buf_thbj-attr.property-value-logical = yes
     1839             no-error.
     1840       if not available buf_thbj-attr then do:
     1841         find first buf_thbj-attr share-lock where
     1842                   buf_thbj-attr.obj-type = ''
     1843               and buf_thbj-attr.obj-code = 0
     1844               and buf_thbj-attr.upper-prop-code = 'rum':U
     1845               and buf_thbj-attr.prop-code = buf_temp-thbj-attr.prop-code
     1846               no-error.
     1847       end.
     1848       RUN gen-key-rec IN THIS-PROCEDURE (
     1849                                           input  'thbj-attr':U
     1850                                           ,INPUT (BUFFER buf_thbj-attr:handle)
     1851     ,OUTPUT v-uniq-key-rec) no-error.
     1852     end.
     1853     else do:
     1854       v-uniq-key-rec = v-processed-uniq-key-rec.
     1855     end.
     1856      RUN proc-value-changed IN THIS-PROCEDURE NO-ERROR.
     1857   END.
     1858   ON CHOOSE OF MENU-ITEM m_graph
     1859   DO:
     1860     IF NOT AVAILABLE X_rule-by-call THEN RETURN NO-APPLY.
     1861     ASSIGN
     1862     rule-display-option = "graph".
     1863     RUN proc-display-rule IN THIS-PROCEDURE (  INPUT rule-display-option
     1864                                                 ,INPUT X_rule-by-call.codex_id
     1865                                                 ,INPUT X_rule-by-call.ruleset_id
     1866                                                 ,INPUT X_rule-by-call.call_Id
     1867                                                 ,INPUT X_rule-by-call.order_id
     1868                                                 ,INPUT X_rule-by-call.rule_id) NO-ERROR.
     1869     ASSIGN
     1870     rule-display-option = "".
     1871   END.
     1872   ON CHOOSE OF MENU-ITEM m_rpoc_graph
     1873   DO:
     1874     IF NOT AVAILABLE buf_temp-thbj-attr THEN RETURN NO-APPLY.
     1875     ASSIGN
     1876     rule-proc-option = "graph".
     1877     run rule-proc IN THIS-PROCEDURE ( v-uniq-key-rec, INPUT rule-proc-option) NO-ERROR.
     1878     IF ERROR-STATUS:ERROR THEN DO:
     1879         rule-proc-option = '':U.
     1880         RETURN NO-APPLY.
     1881     END.
     1882     rule-proc-option = '':U.
     1883   END.
     1884   ON CHOOSE OF MENU-ITEM m_rpoc_text
     1885   DO:
     1886      IF NOT AVAILABLE buf_temp-thbj-attr THEN RETURN NO-APPLY.
     1887     ASSIGN
     1888     rule-proc-option = "text".
     1889     run rule-proc IN THIS-PROCEDURE ( INPUT v-uniq-key-rec, INPUT rule-proc-option) NO-ERROR.
     1890     IF ERROR-STATUS:ERROR THEN DO:
     1891         rule-proc-option = '':U.
     1892         RETURN NO-APPLY.
     1893     END.
     1894     rule-proc-option = '':U.
     1895   END.
     1896   ON CHOOSE OF MENU-ITEM m_text
     1897   DO:
     1898   IF NOT AVAILABLE X_rule-by-call THEN RETURN NO-APPLY.
     1899     ASSIGN
     1900     rule-display-option = "text".
     1901     RUN proc-display-rule IN THIS-PROCEDURE (  INPUT rule-display-option
     1902                                               ,INPUT X_rule-by-call.codex_id
     1903                                               ,INPUT X_rule-by-call.ruleset_id
     1904                                               ,INPUT X_rule-by-call.call_Id
     1905                                               ,INPUT X_rule-by-call.order_id
     1906                                               ,INPUT X_rule-by-call.rule_id) NO-ERROR.
     1907     ASSIGN
     1908     rule-display-option = "".
     1909   END.
     1910   ON VALUE-CHANGED OF Rs-algo-profile IN FRAME Dialog-Frame
     1911   DO:
     1912     ASSIGN
     1913     rs-algo-profile.
     1914     CASE rs-algo-profile:
     1915       WHEN 'rule-by-call':U THEN DO:
     1916         HIDE
     1917         br-profile
     1918         IN FRAME Dialog-Frame.
     1919         .
     1920         DISPLAY
     1921         rs-algo-types
     1922         br-rule-by-call
     1923         b-rule
     1924         b-ruleset
     1925         e-rule-name
     1926         WITH FRAME Dialog-Frame.
     1927       END.
     1928       WHEN 'rp-by-call':U THEN DO:
     1929           HIDE
     1930           br-rule-by-call
     1931           rs-algo-types
     1932           b-rule
     1933           b-ruleset
     1934           e-rule-name
     1935           IN FRAME Dialog-Frame.
     1936           DISPLAY
     1937           br-profile
     1938           WITH FRAME Dialog-Frame.
     1939       END.
     1940     END CASE.
     1941   END.
     1942   ON VALUE-CHANGED OF rs-algo-types IN FRAME Dialog-Frame
     1943   DO:
     1944     ASSIGN
     1945     rs-algo-types.
     1946     OPEN QUERY br-rule-by-call FOR EACH X_rule-by-call       WHERE X_rule-by-call.call_id = v-uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE          X_rule-profile.profile_id = X_rule-by-call.profile_id      AND (rs-algo-types = 1 OR          X_rule-profile.is_dynamic = yes)     AND ((NOT v-is-obj) OR  LOOKUP( "obj",        X_rule-profile.short-name) > 0) BY X_rule-by-call.codex_id BY X_rule-by-call.ruleset_id BY X_rule-by-call.order_id INDEXED-REPOSITION.
     1947     APPLY "VALUE-CHANGED" TO br-rule-by-call IN FRAME Dialog-Frame.
     1948   END.
     1949   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1950   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1951   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1952   on help of frame Dialog-Frame
     1953   do:
     1954     run gbl/app_help.p
     1955       (input this-procedure :file-name
     1956       ,input ''
     1957       ,input ?
     1958       ) no-error.
     1959     if error-status :error then do:
     1960       message
     1961         "Ошибка при вызове помощи"
     1962         error-status :get-message(1)
     1963         view-as alert-box .
     1964     end.
     1965   end.
     1966   run minbtn-set in this-procedure .
     1967   on choose of b-help in frame Dialog-Frame
     1968   do:
     1969     apply "help":u to frame Dialog-Frame .
     1970   end.
     1971   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1972   procedure minbtn-set :
     1973       do
     1974           on error undo, return error return-value
     1975           :
     1976           define variable ii              as integer       no-undo .
     1977           define variable fh              as widget-handle no-undo .
     1978           define variable hh              as widget-handle no-undo .
     1979           define variable v-h             as handle        extent 4 no-undo .
     1980           define variable v-name-button   as character     no-undo .
     1981           define variable v-help-old-x    as decimal       no-undo .
     1982           define variable v-help-old-y    as decimal       no-undo .
     1983           define variable v-help-old-size as decimal       no-undo .
     1984           define variable v-frame-width   as decimal       no-undo .
     1985           define variable jj              as integer       no-undo .
     1986           do
     1987               on error undo, return error
     1988               :
     1989               assign
     1990                   v-frame-width = frame Dialog-Frame:width - 0.3
     1991                   fh            = frame Dialog-Frame:first-child
     1992                   hh            = fh:first-child
     1993                   ii            = 1
     1994                   .
     1995               do while valid-handle(hh):
     1996                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1997                   do:
     1998                       case lc(hh:name) :
     1999                           when "b-help" then
     2000                               do:
     2001                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2002                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2003                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2004                                   hh:TOOLTIP = "Помощь" .
     2005                                   v-help-old-x = hh:column .
     2006                                   v-help-old-y = hh:row    .
     2007                                   v-help-old-size = hh:width .
     2008                                   hh:width-chars = 2.5 .
     2009                               end.
     2010                           when "b-print" then
     2011                               do:
     2012                                   hh:load-image("cmp/b-print.bmp":u) .
     2013                                   hh:TOOLTIP = "Печать" .
     2014                                   v-h[ii] = hh:handle .
     2015                                   ii = ii + 1 .
     2016                                   hh:width-chars = 3 .
     2017                               end.
     2018                           when "b-history" or
     2019                           when "b-hist" then
     2020                               do:
     2021                                   hh:load-image("cmp/b-hist.bmp":u) .
     2022                                   hh:TOOLTIP = "История" .
     2023                                   v-h[ii] = hh:handle .
     2024                                   ii = ii + 1 .
     2025                                   hh:width-chars = 3 .
     2026                               end.
     2027                           when "b-sch" then
     2028                               do:
     2029                                   hh:load-image("cmp/b-sch.bmp":u) .
     2030                                   hh:TOOLTIP = "Установка Фильтра" .
     2031                                   v-h[ii] = hh:handle .
     2032                                   ii = ii + 1 .
     2033                                   hh:width-chars = 3 .
     2034                               end.
     2035                           when "b-hist-user" then
     2036                               do:
     2037                                   hh:load-image("cmp/b-hist.bmp":u) .
     2038                                   hh:TOOLTIP = "История пользователя" .
     2039                                   ii = ii + 1 .
     2040                               end.
     2041                       end case.
     2042                   end.
     2043                   hh = hh:next-sibling.
     2044               end.
     2045               b-help:column = v-frame-width - b-help:width-chars.
     2046               jj = 0.
     2047               repeat ii = 4 to 1 by -1 :
     2048                   if valid-handle (v-h[ii] ) then
     2049                   do:
     2050                       jj  = jj + 1 .
     2051                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2052                       v-h[ii]:row    = v-help-old-y .
     2053                   end.
     2054               end.
     2055           end.
     2056       end.
     2057   end procedure.
     2058   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2059   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2060   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2061   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2062   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2063   define variable v-diasize-current-frame-height as decimal   no-undo .
     2064   define variable v-diasize-change-size          as logical   no-undo .
     2065   define variable v-diasize-resize-button        as handle    no-undo .
     2066   define variable v-diasize-wndmax               as logical   no-undo .
     2067   define variable v-diasize-wndstore             as logical   no-undo .
     2068   define variable v-diasize-proc-name            as character no-undo .
     2069   define variable v-diasize-browse-handle        as handle    no-undo .
     2070   define variable v-diasize-browse-number        as integer   no-undo .
     2071   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2072   define temp-table temp-diasize-handle no-undo
     2073     field handle-value  as handle
     2074     field save-position as decimal
     2075     index xpk is primary unique handle-value
     2076     .
     2077   define temp-table temp-browse-handle no-undo
     2078     field browse-type   as character
     2079     field browse-number as integer
     2080     field browse-handle as handle
     2081     field original-size as decimal
     2082     index xpk is primary unique browse-type browse-number
     2083     index xie browse-type browse-handle
     2084   .
     2085   procedure diasize_change-height :
     2086     define input  parameter p-change-value  as decimal   no-undo .
     2087     define input  parameter p-move-resize   as logical   no-undo .
     2088     define variable v-field-group-handle    as handle    no-undo .
     2089     define variable v-object-handle         as handle    no-undo .
     2090     define variable v-frame-height          as decimal   no-undo .
     2091     define variable v-frame-virtual-height  as decimal   no-undo .
     2092     define variable v-browse-height         as decimal   no-undo .
     2093     define variable v-window-height         as decimal   no-undo .
     2094     define variable v-window-virtual-height as decimal   no-undo .
     2095     define variable v-change-sign           as integer   no-undo .
     2096     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2097     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2098     if p-change-value > 0
     2099     then do:
     2100       if frame Dialog-Frame :height + p-change-value
     2101           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2102       then do:
     2103         assign
     2104           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2105                           - (frame Dialog-Frame :height-chars)
     2106         .
     2107         if p-change-value <= 0
     2108         then do:
     2109           run diasize_position-resize-button in this-procedure .
     2110           return .
     2111         end.
     2112       end.
     2113     end.
     2114     if p-change-value < 0
     2115     then do:
     2116       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2117       then do:
     2118         assign
     2119           p-change-value = v-diasize-orig-frame-height
     2120                          - (frame Dialog-Frame :height-chars)
     2121         .
     2122         if p-change-value >= 0
     2123         then do:
     2124           run diasize_position-resize-button in this-procedure .
     2125           return .
     2126         end.
     2127       end.
     2128     end.
     2129     if p-change-value >= 0
     2130     then do:
     2131       assign
     2132         v-change-sign = 1
     2133       .
     2134     end.
     2135     else do:
     2136       assign
     2137         v-change-sign = -1
     2138       .
     2139     end.
     2140     assign
     2141       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2142     .
     2143     if p-change-value = 0
     2144     then do:
     2145       run diasize_position-resize-button in this-procedure .
     2146       return .
     2147     end.
     2148     move_block:
     2149     do
     2150     on error undo move_block, retry move_block
     2151     :
     2152       if retry
     2153       then do:
     2154         do
     2155         on error undo move_block, leave move_block
     2156         :
     2157           if p-change-value > 0
     2158           then do:
     2159             for each buf_temp-diasize-handle
     2160             on error undo, next
     2161             :
     2162               assign
     2163                 v-object-handle = buf_temp-diasize-handle.handle-value
     2164               .
     2165               if v-object-handle <> v-diasize-resize-button
     2166               then do:
     2167                 assign
     2168                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2169                 .
     2170               end.
     2171             end.
     2172             assign
     2173               v-diasize-browse-handle :height = v-browse-height
     2174             .
     2175             for each buf_temp-browse-handle
     2176               where buf_temp-browse-handle.browse-type = 'height':u
     2177             on error undo, next
     2178             :
     2179               assign
     2180                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2181               .
     2182             end.
     2183             assign
     2184               frame Dialog-Frame :height = v-frame-height
     2185             .
     2186             if frame Dialog-Frame :scrollable = true
     2187             then do:
     2188               assign
     2189                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2190               .
     2191             end.
     2192             run diasize_position-resize-button in this-procedure .
     2193           end.
     2194           else do:
     2195             if frame Dialog-Frame :scrollable = true
     2196             then do:
     2197               assign
     2198                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2199               .
     2200             end.
     2201             assign
     2202               frame Dialog-Frame :height = v-frame-height
     2203             .
     2204             assign
     2205               v-diasize-browse-handle :height = v-browse-height
     2206             .
     2207             for each buf_temp-browse-handle
     2208               where buf_temp-browse-handle.browse-type = 'height':u
     2209             on error undo, next
     2210             :
     2211               assign
     2212                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2213               .
     2214             end.
     2215             for each buf_temp-diasize-handle
     2216             on error undo, next
     2217             :
     2218               assign
     2219                 v-object-handle = buf_temp-diasize-handle.handle-value
     2220               .
     2221               if v-object-handle <> v-diasize-resize-button
     2222               then do:
     2223                 assign
     2224                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2225                 .
     2226               end.
     2227             end.
     2228             run diasize_position-resize-button in this-procedure .
     2229           end.
     2230           assign
     2231             v-diasize-change-size = false
     2232           .
     2233           leave move_block .
     2234         end.
     2235       end.
     2236       assign
     2237         v-diasize-need-full-display = true
     2238       .
     2239       if v-diasize-change-size = false
     2240       then do:
     2241         assign
     2242           v-diasize-change-size = true
     2243         .
     2244       end.
     2245       else do:
     2246         return .
     2247       end.
     2248       assign
     2249         v-frame-height = frame Dialog-Frame :height
     2250         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2251         v-browse-height = v-diasize-browse-handle :height
     2252       .
     2253       for each buf_temp-browse-handle
     2254         where buf_temp-browse-handle.browse-type = 'height':u
     2255       :
     2256         assign
     2257           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2258         .
     2259       end.
     2260       for each buf_temp-diasize-handle
     2261       :
     2262         delete buf_temp-diasize-handle .
     2263       end.
     2264       assign
     2265         v-field-group-handle = frame Dialog-Frame :first-child
     2266       .
     2267       do while valid-handle(v-field-group-handle)
     2268       :
     2269         assign
     2270           v-object-handle = v-field-group-handle :first-child
     2271         .
     2272         do while valid-handle(v-object-handle)
     2273         :
     2274           if  v-object-handle <> v-diasize-browse-handle :handle
     2275           and can-query(v-object-handle, "row")
     2276           and can-query(v-object-handle, "height")
     2277           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2278           then do:
     2279             find first buf_temp-browse-handle
     2280               where buf_temp-browse-handle.browse-type   = 'height':u
     2281                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2282               no-error .
     2283             if available buf_temp-browse-handle
     2284             then do:
     2285             end.
     2286             else do:
     2287               create buf_temp-diasize-handle .
     2288               assign
     2289                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2290                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2291               .
     2292             end.
     2293           end.
     2294           assign
     2295             v-object-handle = v-object-handle :next-sibling
     2296           .
     2297         end.
     2298         assign
     2299           v-field-group-handle = v-field-group-handle :next-sibling
     2300         .
     2301       end.
     2302       do with frame Dialog-Frame
     2303       :
     2304         hide v-diasize-resize-button .
     2305         assign
     2306           v-diasize-resize-button :row    = 1
     2307           v-diasize-resize-button :column = 1
     2308         .
     2309       end.
     2310       if p-change-value > 0
     2311       then do:
     2312         if frame Dialog-Frame :scrollable = true
     2313         then do:
     2314           assign
     2315             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2316             no-error .
     2317           if error-status :error
     2318           or error-status :get-message(1) <> ""
     2319           then do:
     2320             undo move_block, retry move_block .
     2321           end.
     2322         end.
     2323         assign
     2324           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2325           no-error .
     2326         if error-status :error
     2327         or error-status :get-message(1) <> ""
     2328         then do:
     2329           undo move_block, retry move_block .
     2330         end.
     2331         assign
     2332           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2333           no-error .
     2334         if error-status :error
     2335         or error-status :get-message(1) <> ""
     2336         then do:
     2337           undo move_block, retry move_block .
     2338         end.
     2339         for each buf_temp-browse-handle
     2340           where buf_temp-browse-handle.browse-type = 'height':u
     2341         on error undo move_block, retry move_block
     2342         :
     2343           assign
     2344             buf_temp-browse-handle.browse-handle :height
     2345               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2346             no-error .
     2347           if error-status :error
     2348           or error-status :get-message(1) <> ""
     2349           then do:
     2350             undo move_block, retry move_block .
     2351           end.
     2352         end.
     2353         for each buf_temp-diasize-handle
     2354         on error undo move_block, retry move_block
     2355         :
     2356           assign
     2357             v-object-handle = buf_temp-diasize-handle.handle-value
     2358           .
     2359           if v-object-handle <> v-diasize-resize-button
     2360           then do:
     2361             assign
     2362               v-object-handle :row = v-object-handle :row + p-change-value
     2363               no-error .
     2364             if error-status :error
     2365             or error-status :get-message(1) <> ""
     2366             then do:
     2367               undo move_block, retry move_block .
     2368             end.
     2369           end.
     2370         end.
     2371       end.
     2372       else do:
     2373         for each buf_temp-diasize-handle
     2374         on error undo move_block, retry move_block
     2375         :
     2376           assign
     2377             v-object-handle = buf_temp-diasize-handle.handle-value
     2378           .
     2379           if v-object-handle <> v-diasize-resize-button
     2380           then do:
     2381             assign
     2382               v-object-handle :row = v-object-handle :row + p-change-value
     2383               no-error .
     2384             if error-status :error
     2385             or error-status :get-message(1) <> ""
     2386             then do:
     2387               undo move_block, retry move_block .
     2388             end.
     2389           end.
     2390         end.
     2391         assign
     2392           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2393           no-error .
     2394         if error-status :error
     2395         or error-status :get-message(1) <> ""
     2396         then do:
     2397           undo move_block, retry move_block .
     2398         end.
     2399         for each buf_temp-browse-handle
     2400           where buf_temp-browse-handle.browse-type = 'height':u
     2401         on error undo move_block, retry move_block
     2402         :
     2403           assign
     2404             buf_temp-browse-handle.browse-handle :height
     2405               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2406             no-error .
     2407           if error-status :error
     2408           or error-status :get-message(1) <> ""
     2409           then do:
     2410             undo move_block, retry move_block .
     2411           end.
     2412         end.
     2413         assign
     2414           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2415           no-error .
     2416         if error-status :error
     2417         or error-status :get-message(1) <> ""
     2418         then do:
     2419           undo move_block, retry move_block .
     2420         end.
     2421         if frame Dialog-Frame :scrollable = true
     2422         then do:
     2423           assign
     2424             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2425             no-error .
     2426           if error-status :error
     2427           or error-status :get-message(1) <> ""
     2428           then do:
     2429             undo move_block, retry move_block .
     2430           end.
     2431         end.
     2432       end.
     2433       if p-move-resize = true
     2434       then do:
     2435         run diasize_position-resize-button in this-procedure .
     2436       end.
     2437       if v-diasize-wndstore = true
     2438       then do:
     2439         if connected("ub") = true
     2440         then do:
     2441           define variable v-cntxt-db-num        as integer   no-undo .
     2442           define variable v-cntxt-userid        as character no-undo .
     2443           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2444                                             , OUTPUT v-cntxt-userid
     2445                                             ) .
     2446           run gbl/wndsizew.p
     2447             (input  v-cntxt-db-num
     2448             ,input  v-cntxt-userid
     2449             ,input  v-diasize-proc-name
     2450             ,input  'height':u
     2451             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2452             ) .
     2453         end.
     2454       end.
     2455     end.
     2456     assign
     2457       v-diasize-change-size = false
     2458     .
     2459   end procedure.
     2460   procedure diasize_set-height :
     2461     define input  parameter p-new-height  as decimal   no-undo .
     2462     define input  parameter p-move-resize as logical   no-undo .
     2463     do
     2464     on error undo, return error return-value
     2465     :
     2466       run diasize_change-height in this-procedure
     2467         (input  (p-new-height - frame Dialog-Frame :height)
     2468         ,input  p-move-resize
     2469         ) .
     2470     end.
     2471   end procedure.
     2472   procedure diasize_change-width :
     2473     define input  parameter p-change-value as decimal   no-undo .
     2474     define input  parameter p-move-resize  as logical   no-undo .
     2475     define variable v-field-group-handle   as handle    no-undo .
     2476     define variable v-object-handle        as handle    no-undo .
     2477     define variable v-frame-width          as decimal   no-undo .
     2478     define variable v-frame-virtual-width  as decimal   no-undo .
     2479     define variable v-browse-width         as decimal   no-undo .
     2480     define variable v-window-width         as decimal   no-undo .
     2481     define variable v-window-virtual-width as decimal   no-undo .
     2482     define variable v-change-sign          as integer   no-undo .
     2483     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2484     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2485     if p-change-value > 0
     2486     then do:
     2487       if frame Dialog-Frame :width + p-change-value >
     2488           session :width-chars
     2489       then do:
     2490         assign
     2491           p-change-value = session :width-chars - frame Dialog-Frame :width
     2492         .
     2493         if p-change-value <= 0
     2494         then do:
     2495           run diasize_position-resize-button in this-procedure .
     2496           return .
     2497         end.
     2498       end.
     2499     end.
     2500     if p-change-value < 0
     2501     then do:
     2502       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2503       then do:
     2504         assign
     2505           p-change-value = v-diasize-orig-frame-width
     2506                          - frame Dialog-Frame :width
     2507         .
     2508         if p-change-value >= 0
     2509         then do:
     2510           run diasize_position-resize-button in this-procedure .
     2511           return .
     2512         end.
     2513       end.
     2514     end.
     2515     if p-change-value >= 0
     2516     then do:
     2517       assign
     2518         v-change-sign = 1
     2519       .
     2520     end.
     2521     else do:
     2522       assign
     2523         v-change-sign = -1
     2524       .
     2525     end.
     2526     assign
     2527       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2528     .
     2529     if p-change-value = 0
     2530     then do:
     2531       run diasize_position-resize-button in this-procedure .
     2532       return .
     2533     end.
     2534     move_block:
     2535     do
     2536     on error undo move_block, leave move_block
     2537     :
     2538       if retry
     2539       then do:
     2540         do
     2541         on error undo move_block, leave move_block
     2542         :
     2543           if p-change-value > 0
     2544           then do:
     2545             for each buf_temp-diasize-handle
     2546             on error undo, next
     2547             :
     2548               assign
     2549                 v-object-handle = buf_temp-diasize-handle.handle-value
     2550               .
     2551               if v-object-handle <> v-diasize-resize-button
     2552               then do:
     2553                 assign
     2554                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2555                 .
     2556               end.
     2557             end.
     2558             assign
     2559               v-diasize-browse-handle :width = v-browse-width
     2560             .
     2561             for each buf_temp-browse-handle
     2562               where buf_temp-browse-handle.browse-type = 'width':u
     2563             on error undo, next
     2564             :
     2565               assign
     2566                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2567               .
     2568             end.
     2569             assign
     2570               frame Dialog-Frame :width = v-frame-width
     2571             .
     2572             if frame Dialog-Frame :scrollable = true
     2573             then do:
     2574               assign
     2575                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2576               .
     2577             end.
     2578             run diasize_position-resize-button in this-procedure .
     2579           end.
     2580           else do:
     2581             if frame Dialog-Frame :scrollable = true
     2582             then do:
     2583               assign
     2584                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2585               .
     2586             end.
     2587             assign
     2588               frame Dialog-Frame :width = v-frame-width
     2589             .
     2590             for each buf_temp-browse-handle
     2591               where buf_temp-browse-handle.browse-type = 'width':u
     2592             on error undo, next
     2593             :
     2594               assign
     2595                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2596               .
     2597             end.
     2598             assign
     2599               v-diasize-browse-handle :width = v-browse-width
     2600             .
     2601             for each buf_temp-diasize-handle
     2602             on error undo, next
     2603             :
     2604               assign
     2605                 v-object-handle = buf_temp-diasize-handle.handle-value
     2606               .
     2607               if v-object-handle <> v-diasize-resize-button
     2608               then do:
     2609                 assign
     2610                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2611                 .
     2612               end.
     2613             end.
     2614             run diasize_position-resize-button in this-procedure .
     2615           end.
     2616           assign
     2617             v-diasize-change-size = false
     2618           .
     2619           leave move_block .
     2620         end.
     2621       end.
     2622       assign
     2623         v-diasize-need-full-display = true
     2624       .
     2625       if v-diasize-change-size = false
     2626       then do:
     2627         assign
     2628           v-diasize-change-size = true
     2629         .
     2630       end.
     2631       else do:
     2632         return .
     2633       end.
     2634       assign
     2635         v-frame-width = frame Dialog-Frame :width
     2636         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2637         v-browse-width = v-diasize-browse-handle :width
     2638       .
     2639       for each buf_temp-browse-handle
     2640         where buf_temp-browse-handle.browse-type = 'width':u
     2641       :
     2642         assign
     2643           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2644         .
     2645       end.
     2646       for each buf_temp-diasize-handle
     2647       :
     2648         delete buf_temp-diasize-handle .
     2649       end.
     2650       assign
     2651         v-field-group-handle = frame Dialog-Frame :first-child
     2652       .
     2653       do while valid-handle(v-field-group-handle)
     2654       :
     2655         assign
     2656           v-object-handle = v-field-group-handle :first-child
     2657         .
     2658         do while valid-handle(v-object-handle)
     2659         :
     2660           if  v-object-handle <> v-diasize-browse-handle :handle
     2661           and v-object-handle <> v-diasize-resize-button
     2662           and can-query(v-object-handle, "row")
     2663           and can-query(v-object-handle, "height")
     2664           and ( v-object-handle :col + v-object-handle :width
     2665                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2666               )
     2667           then do:
     2668             find first buf_temp-browse-handle
     2669               where buf_temp-browse-handle.browse-type   = 'width':u
     2670                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2671               no-error .
     2672             if available buf_temp-browse-handle
     2673             then do:
     2674             end.
     2675             else do:
     2676               create buf_temp-diasize-handle .
     2677               assign
     2678                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2679                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2680               .
     2681             end.
     2682           end.
     2683           assign
     2684             v-object-handle = v-object-handle :next-sibling
     2685           .
     2686         end.
     2687         assign
     2688           v-field-group-handle = v-field-group-handle :next-sibling
     2689         .
     2690       end.
     2691       do with frame Dialog-Frame
     2692       :
     2693         hide v-diasize-resize-button .
     2694         v-diasize-resize-button :row = 1.
     2695         v-diasize-resize-button :column = 1.
     2696       end.
     2697       if p-change-value > 0
     2698       then do:
     2699         if frame Dialog-Frame :scrollable = true
     2700         then do:
     2701           assign
     2702             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2703             no-error .
     2704           if error-status :error
     2705           or error-status :get-message(1) <> ""
     2706           then do:
     2707             undo move_block, retry move_block.
     2708           end.
     2709         end.
     2710         assign
     2711           frame Dialog-Frame :width = v-frame-width + p-change-value
     2712           no-error .
     2713         if error-status :error
     2714         or error-status :get-message(1) <> ""
     2715         then do:
     2716           undo move_block, retry move_block.
     2717         end.
     2718         assign
     2719           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2720         no-error .
     2721         if error-status :error
     2722         or error-status :get-message(1) <> ""
     2723         then do:
     2724           undo move_block, retry move_block.
     2725         end.
     2726         for each buf_temp-browse-handle
     2727           where buf_temp-browse-handle.browse-type = 'width':u
     2728         on error undo move_block, retry move_block
     2729         :
     2730           assign
     2731             buf_temp-browse-handle.browse-handle :width
     2732               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2733             no-error .
     2734           if error-status :error
     2735           or error-status :get-message(1) <> ""
     2736           then do:
     2737             undo move_block, retry move_block .
     2738           end.
     2739         end.
     2740         for each buf_temp-diasize-handle
     2741         on error undo move_block, retry move_block
     2742         :
     2743           assign
     2744             v-object-handle = buf_temp-diasize-handle.handle-value
     2745           .
     2746           if v-object-handle <> v-diasize-resize-button
     2747           then do:
     2748             assign
     2749               v-object-handle :col = v-object-handle :col + p-change-value
     2750               no-error .
     2751             if error-status :error
     2752             or error-status :get-message(1) <> ""
     2753             then do:
     2754               undo move_block, retry move_block .
     2755             end.
     2756           end.
     2757         end.
     2758       end.
     2759       else do:
     2760         for each buf_temp-diasize-handle
     2761         on error undo move_block, retry move_block
     2762         :
     2763           assign
     2764             v-object-handle = buf_temp-diasize-handle.handle-value
     2765           .
     2766           if v-object-handle <> v-diasize-resize-button
     2767           then do:
     2768             assign
     2769               v-object-handle :col = v-object-handle :col + p-change-value
     2770               no-error .
     2771             if error-status :error
     2772             or error-status :get-message(1) <> ""
     2773             then do:
     2774               undo move_block, retry move_block .
     2775             end.
     2776           end.
     2777         end.
     2778         for each buf_temp-browse-handle
     2779           where buf_temp-browse-handle.browse-type = 'width':u
     2780         on error undo move_block, retry move_block
     2781         :
     2782           assign
     2783             buf_temp-browse-handle.browse-handle :width
     2784               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2785             no-error .
     2786           if error-status :error
     2787           or error-status :get-message(1) <> ""
     2788           then do:
     2789             undo move_block, retry move_block .
     2790           end.
     2791         end.
     2792         assign
     2793           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2794           no-error .
     2795         if error-status :error
     2796         or error-status :get-message(1) <> ""
     2797         then do:
     2798           undo move_block, retry move_block.
     2799         end.
     2800         assign
     2801           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2802         no-error .
     2803         if error-status :error
     2804         or error-status :get-message(1) <> ""
     2805         then do:
     2806           undo move_block, retry move_block.
     2807         end.
     2808         if frame Dialog-Frame :scrollable = true
     2809         then do:
     2810           assign
     2811             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2812           no-error .
     2813           if error-status :error
     2814           or error-status :get-message(1) <> ""
     2815           then do:
     2816             undo move_block, retry move_block.
     2817           end.
     2818         end.
     2819       end.
     2820       if p-move-resize
     2821       then do:
     2822         run diasize_position-resize-button in this-procedure .
     2823       end.
     2824       if v-diasize-wndstore = true
     2825       then do:
     2826         if connected("ub") = true
     2827         then do:
     2828           define variable v-cntxt-db-num        as integer   no-undo .
     2829           define variable v-cntxt-userid        as character no-undo .
     2830           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2831                                             , OUTPUT v-cntxt-userid
     2832                                             ) .
     2833           run gbl/wndsizew.p
     2834             (input  v-cntxt-db-num
     2835             ,input  v-cntxt-userid
     2836             ,input  v-diasize-proc-name
     2837             ,input  'width':u
     2838             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2839             ) .
     2840         end.
     2841       end.
     2842     end.
     2843     assign
     2844       v-diasize-change-size = false
     2845     .
     2846   end procedure.
     2847   procedure diasize_set-width :
     2848     define input  parameter p-new-width  as decimal   no-undo .
     2849     define input  parameter p-move-resize as logical   no-undo .
     2850     do
     2851     on error undo, return error return-value
     2852     :
     2853       run diasize_change-width in this-procedure
     2854         (input  (p-new-width - frame Dialog-Frame :width)
     2855         ,input  p-move-resize
     2856         ) .
     2857     end.
     2858   end procedure.
     2859   procedure diasize_position-resize-button :
     2860     do with frame Dialog-Frame
     2861     :
     2862       hide v-diasize-resize-button .
     2863       assign
     2864         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2865                     - 1
     2866                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2867         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2868                     - 1
     2869                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2870       .
     2871       view v-diasize-resize-button .
     2872     end.
     2873   end procedure.
     2874   on alt-right anywhere
     2875   do:
     2876     run diasize_change-width in this-procedure
     2877       (input 1
     2878       ,input true
     2879       ) .
     2880     return no-apply .
     2881   end.
     2882   on alt-left anywhere
     2883   do:
     2884     run diasize_change-width in this-procedure
     2885       (input -1
     2886       ,input true
     2887       ) .
     2888     return no-apply .
     2889   end.
     2890   on alt-down anywhere
     2891   do:
     2892     run diasize_change-height in this-procedure
     2893       (input 1
     2894       ,input true
     2895       ) .
     2896     return no-apply .
     2897   end.
     2898   on alt-up anywhere
     2899   do:
     2900     run diasize_change-height in this-procedure
     2901       (input -1
     2902       ,input true
     2903       ) .
     2904     return no-apply .
     2905   end.
     2906   on alt-enter of frame Dialog-Frame
     2907   do:
     2908     run diasize_maximize in this-procedure
     2909       (input  ?
     2910       ).
     2911     return no-apply .
     2912   end.
     2913   procedure diasize_end-move :
     2914     do
     2915     on error undo, return error return-value
     2916     :
     2917       define variable v-row-delta as decimal   no-undo .
     2918       define variable v-col-delta as decimal   no-undo .
     2919       define variable v-new-row as decimal   no-undo .
     2920       define variable v-new-col as decimal   no-undo .
     2921       assign
     2922         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2923         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2924       .
     2925       assign
     2926         v-row-delta = v-new-row - frame Dialog-Frame :height
     2927         v-col-delta = v-new-col - frame Dialog-Frame :width
     2928       .
     2929       run diasize_change-height in this-procedure
     2930         (input v-row-delta
     2931         ,input true
     2932         ) .
     2933       run diasize_change-width in this-procedure
     2934         (input v-col-delta
     2935         ,input true
     2936         ) .
     2937     end.
     2938   end procedure.
     2939   procedure diasize_maximize :
     2940     define input  parameter p-action as logical   no-undo .
     2941     do
     2942     on error undo, return error return-value
     2943     :
     2944       if p-action = ?
     2945       then do:
     2946         if v-diasize-need-maximize = true
     2947         then do:
     2948           assign
     2949             p-action = true
     2950           .
     2951         end.
     2952         else do:
     2953           assign
     2954             p-action = false
     2955           .
     2956         end.
     2957       end.
     2958       if p-action = true
     2959       then do:
     2960         run diasize_change-height in this-procedure
     2961           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2962               - frame Dialog-Frame :height-chars
     2963           ,input true
     2964           ) .
     2965         run diasize_change-width in this-procedure
     2966           (input session :width-chars
     2967               - frame Dialog-Frame :width-chars
     2968           ,input true
     2969           ) .
     2970         assign
     2971           v-diasize-need-maximize = false
     2972         .
     2973       end.
     2974       else do:
     2975         run diasize_change-width in this-procedure
     2976           (input v-diasize-orig-frame-width
     2977               - frame Dialog-Frame :width-chars
     2978           ,input true
     2979           ) .
     2980         run diasize_change-height in this-procedure
     2981           (input v-diasize-orig-frame-height
     2982               - frame Dialog-Frame :height-chars
     2983           ,input true
     2984           ) .
     2985         assign
     2986           v-diasize-need-maximize = true
     2987         .
     2988       end.
     2989     end.
     2990   end procedure.
     2991   procedure diasize_restore-orig-size :
     2992     do
     2993     on error undo, return error return-value
     2994     :
     2995       assign
     2996         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2997         v-diasize-current-frame-height = frame Dialog-Frame :height
     2998       .
     2999       run diasize_set-height in this-procedure
     3000         (input  v-diasize-orig-frame-height
     3001         ,input  true
     3002         ) .
     3003       run diasize_set-width in this-procedure
     3004         (input  v-diasize-orig-frame-width
     3005         ,input  true
     3006         ) .
     3007     end.
     3008   end procedure.
     3009   procedure diasize_restore-current-size :
     3010     do
     3011     on error undo, return error return-value
     3012     :
     3013       run diasize_set-height in this-procedure
     3014         (input  v-diasize-current-frame-height
     3015         ,input  true
     3016         ) .
     3017       run diasize_set-width in this-procedure
     3018         (input  v-diasize-current-frame-width
     3019         ,input  true
     3020         ) .
     3021     end.
     3022   end procedure.
     3023   procedure diasize_set-browse-handle :
     3024     define input  parameter p-browse-handle as handle   no-undo .
     3025     define buffer buf_temp-browse-handle for temp-browse-handle .
     3026     do
     3027     on error undo, return error return-value
     3028     :
     3029       assign
     3030         v-diasize-browse-handle = p-browse-handle
     3031       .
     3032       for each buf_temp-browse-handle
     3033       on error undo, return error return-value
     3034       :
     3035         delete buf_temp-browse-handle .
     3036       end.
     3037     end.
     3038   end procedure.
     3039   procedure diasize_add_browse :
     3040     define input  parameter p-browse-type   as character no-undo .
     3041     define input  parameter p-browse-handle as handle    no-undo .
     3042     define buffer buf_temp-browse-handle for temp-browse-handle .
     3043     do
     3044     on error undo, return error return-value
     3045     :
     3046       assign
     3047         v-diasize-browse-number = v-diasize-browse-number + 1
     3048       .
     3049       create buf_temp-browse-handle .
     3050       assign
     3051         buf_temp-browse-handle.browse-type   = p-browse-type
     3052         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3053         buf_temp-browse-handle.browse-handle = p-browse-handle
     3054       .
     3055     end.
     3056   end procedure.
     3057   procedure diasize_init :
     3058     define variable v-default-value    as logical   no-undo .
     3059     define variable v-restore-saved    as logical   no-undo .
     3060     define variable v-resize-value-str as character no-undo .
     3061     do
     3062     on error undo, return error return-value
     3063     :
     3064       do with frame Dialog-Frame
     3065       :
     3066         assign
     3067           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3068           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3069           v-diasize-browse-handle     = browse br-profile :handle
     3070         .
     3071         create button v-diasize-resize-button
     3072         assign
     3073           parent        = frame Dialog-Frame :first-child
     3074           label         = "s"
     3075           height-pixels = 16
     3076           width-pixels  = 16
     3077           visible       = true
     3078           sensitive     = true
     3079           movable       = true
     3080           triggers:
     3081             on end-move persistent run diasize_end-move in this-procedure .
     3082           end triggers.
     3083         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3084         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3085         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3086         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3087         assign
     3088           v-diasize-wndmax = false
     3089         .
     3090         if connected("ub") = true
     3091         then do:
     3092           define variable v-cntxt-db-num        as integer   no-undo .
     3093           define variable v-cntxt-userid        as character no-undo .
     3094           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3095                                             , OUTPUT v-cntxt-userid
     3096                                             ) .
     3097           run gbl/wndpar_r.p
     3098             (input  v-cntxt-db-num
     3099             ,input  v-cntxt-userid
     3100             ,input  'wndmax':U
     3101             ,output v-diasize-wndmax
     3102             ,output v-default-value
     3103             ) .
     3104         end.
     3105         assign
     3106           v-diasize-wndstore = false
     3107         .
     3108         if connected("ub") = true
     3109         then do:
     3110           run gbl/wndpar_r.p
     3111             (input  v-cntxt-db-num
     3112             ,input  v-cntxt-userid
     3113             ,input  'wndstore':U
     3114             ,output v-diasize-wndstore
     3115             ,output v-default-value
     3116             ) .
     3117         end.
     3118         assign
     3119           v-diasize-proc-name = entry(1, program-name(2), '.')
     3120         .
     3121         if v-diasize-wndstore = true
     3122         then do:
     3123           assign
     3124             v-restore-saved = false
     3125           .
     3126           if connected("ub") = true
     3127           then do:
     3128             run gbl/wndsizer.p
     3129               (input  v-cntxt-db-num
     3130               ,input  v-cntxt-userid
     3131               ,input  v-diasize-proc-name
     3132               ,input  'height':u
     3133               ,output v-resize-value-str
     3134               ) .
     3135             if v-resize-value-str <> '':U
     3136             then do:
     3137               run diasize_change-height in this-procedure
     3138                 (input  integer(v-resize-value-str)
     3139                 ,input  true
     3140                 ) .
     3141               assign
     3142                 v-restore-saved = true
     3143               .
     3144             end.
     3145           end.
     3146           if connected("ub") = true
     3147           then do:
     3148             run gbl/wndsizer.p
     3149               (input  v-cntxt-db-num
     3150               ,input  v-cntxt-userid
     3151               ,input  v-diasize-proc-name
     3152               ,input  'width':u
     3153               ,output v-resize-value-str
     3154               ) .
     3155             if v-resize-value-str <> '':U
     3156             then do:
     3157               run diasize_change-width in this-procedure
     3158                 (input  integer(v-resize-value-str)
     3159                 ,input  true
     3160                 ) .
     3161               assign
     3162                 v-restore-saved = true
     3163               .
     3164             end.
     3165           end.
     3166           if v-restore-saved <> true
     3167           then do:
     3168             if v-diasize-wndmax = true
     3169             then do:
     3170               run diasize_maximize in this-procedure
     3171                 (input  true
     3172                 ) .
     3173             end.
     3174           end.
     3175         end.
     3176         else do:
     3177           if v-diasize-wndmax = true
     3178           then do:
     3179             run diasize_maximize in this-procedure
     3180               (input  true
     3181               ) .
     3182           end.
     3183         end.
     3184       end.
     3185     end.
     3186   end procedure.
     3187   procedure diasize_need-full-display :
     3188     define output parameter p-need-full-display as logical   no-undo .
     3189     do
     3190     on error undo, return error return-value
     3191     :
     3192       assign
     3193         p-need-full-display = v-diasize-need-full-display
     3194       .
     3195       assign
     3196         v-diasize-need-full-display = false
     3197       .
     3198     end.
     3199   end procedure.
     3200   procedure get-context :
     3201      define output parameter p-db-num as integer          no-undo.
     3202      define output parameter p-user-id as character        no-undo.
     3203      define variable v-login               as character    no-undo.
     3204      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3205      define buffer buf_user-login  for ub.user-login .
     3206      do
     3207      on error undo, return error
     3208      :
     3209            FIND FIRST buf_sys-ctrl no-lock.
     3210            ASSIGN
     3211               v-login = USERID("ub")
     3212               p-db-num = buf_sys-ctrl.db-num
     3213            .
     3214            FIND FIRST buf_user-login
     3215                 WHERE buf_user-login.db-num = p-db-num
     3216                   AND buf_user-login.user-login = v-login
     3217                 no-lock
     3218                 no-error
     3219                 .
     3220            IF AVAILABLE buf_user-login
     3221            THEN DO:
     3222               assign
     3223                  p-user-id = buf_user-login.user-id
     3224               .
     3225            END.
     3226      end.
     3227   end procedure.
     3228       run diasize_init in this-procedure .
     3229   procedure rcpscont_get-rule-on-off :
     3230   define input parameter p-codex-id as integer no-undo .
     3231   define input parameter p-ruleset-id as integer no-undo .
     3232   define input parameter p-rule-id as integer no-undo .
     3233   define input parameter p-profile-id as integer no-undo .
     3234   define input parameter p-once-more as integer no-undo .
     3235   define output parameter p-on-off as logical no-undo .
     3236   define buffer buf_tt0-rule-by-call for ub.rule-by-call.
     3237   find first buf_tt0-rule-by-call where
     3238            buf_tt0-rule-by-call.codex_id = p-codex-id
     3239        and buf_tt0-rule-by-call.ruleset_id = p-ruleset-id
     3240        and buf_tt0-rule-by-call.profile_id = p-profile-id
     3241        and buf_tt0-rule-by-call.once-more = p-once-more
     3242        and buf_tt0-rule-by-call.rule_id = p-rule-id
     3243        no-error .
     3244   if available buf_tt0-rule-by-call then do:
     3245      p-on-off = buf_tt0-rule-by-call.can-calc.
     3246   end.
     3247   end procedure.
     3248   procedure rcpscont_set-rule-on-off :
     3249   define input parameter p-codex-id as integer no-undo .
     3250   define input parameter p-ruleset-id as integer no-undo .
     3251   define input parameter p-rule-id as integer no-undo .
     3252   define input parameter p-profile-id as integer no-undo .
     3253   define input parameter p-once-more as integer no-undo .
     3254   define input parameter p-on-off as logical no-undo .
     3255   define variable v-h as handle no-undo .
     3256   define buffer buf_tt0-rule-by-call for ub.rule-by-call.
     3257   v-h = buffer ub.rule-by-call:handle.
     3258   if v-h:table <> ''
     3259   and v-h:table <> ? then do:
     3260     find first buf_tt0-rule-by-call where
     3261             buf_tt0-rule-by-call.codex_id = p-codex-id
     3262         and buf_tt0-rule-by-call.ruleset_id = p-ruleset-id
     3263         and buf_tt0-rule-by-call.profile_id = p-profile-id
     3264         and buf_tt0-rule-by-call.once-more = p-once-more
     3265         and buf_tt0-rule-by-call.rule_id = p-rule-id   no-error .
     3266     if not available buf_tt0-rule-by-call then do:
     3267       undo, return error .
     3268     end.
     3269     buf_tt0-rule-by-call.can-calc = p-on-off .
     3270     release buf_tt0-rule-by-call.
     3271   end.
     3272   OPEN QUERY br-rule-by-call FOR EACH X_rule-by-call       WHERE X_rule-by-call.call_id = v-uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE          X_rule-profile.profile_id = X_rule-by-call.profile_id      AND (rs-algo-types = 1 OR          X_rule-profile.is_dynamic = yes)     AND ((NOT v-is-obj) OR  LOOKUP( "obj",        X_rule-profile.short-name) > 0) BY X_rule-by-call.codex_id BY X_rule-by-call.ruleset_id BY X_rule-by-call.order_id INDEXED-REPOSITION.
     3273   end procedure.
     3274   MAIN-BLOCK:
     3275   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3276      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3277   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3278     run mainmenu_getcntxt in parparentproc
     3279       (output v-cntxt-db-num
     3280       ,output v-cntxt-userid
     3281       ,output v-cntxt-level
     3282       ,output v-cntxt-host-code-obj
     3283       ,output v-cntxt-obj-type
     3284       ,output v-cntxt-obj-code
     3285       ,output v-cntxt-db-num-obj
     3286       ,output v-cntxt-is-admin
     3287       ) .
     3288   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3289   ON TAB ANYWHERE
     3290   DO:
     3291   define variable ii as integer no-undo .
     3292   define variable fh as widget-handle no-undo .
     3293   define variable hh as widget-handle no-undo .
     3294   define variable v-next-widget-name as character no-undo .
     3295   if v-tab-order <> '' then do:
     3296     if self:type = "TOGGLE-BOX" then
     3297     self:BGCOLOR = ?.
     3298     assign
     3299     ii = lookup(self:name, v-tab-order).
     3300     assign
     3301     ii = ii + 1
     3302     v-next-widget-name = entry(ii, v-tab-order)
     3303     no-error .
     3304     if error-status:error then do:
     3305       assign
     3306       ii = 1
     3307       v-next-widget-name = entry( ii, v-tab-order)
     3308       .
     3309     end.
     3310     assign
     3311     fh = frame Dialog-Frame:first-child
     3312     hh = fh:first-child
     3313     .
     3314     do while valid-handle(hh):
     3315       if hh:name = v-next-widget-name then do:
     3316         if hh:sensitive  = yes
     3317         AND hh:visible = yes then do:
     3318           if hh:type = "TOGGLE-BOX":U then do:
     3319             assign
     3320             hh:BGcolor = 1
     3321             .
     3322           end.
     3323           APPLY "ENTRY" to hh.
     3324           return no-apply.
     3325         end.
     3326         else do:
     3327           APPLY "TAB" to hh.
     3328           return no-apply.
     3329         end.
     3330       end.
     3331       hh = hh:next-sibling.
     3332     end.
     3333   end.
     3334   END.
     3335   ON BACK-TAB ANYWHERE
     3336   DO:
     3337   define variable ii as integer no-undo .
     3338   define variable fh as widget-handle no-undo .
     3339   define variable hh as widget-handle no-undo .
     3340   define variable v-next-widget-name as character no-undo .
     3341   if v-tab-order <> '' then do:
     3342     assign
     3343     ii = lookup(self:name, v-tab-order).
     3344     .
     3345     assign
     3346     ii = (if ii = 1
     3347           then  num-entries(v-tab-order)
     3348           else ii - 1
     3349           )
     3350     v-next-widget-name = entry(ii, v-tab-order)
     3351     .
     3352     assign
     3353     fh = frame Dialog-Frame:first-child
     3354     hh = fh:first-child
     3355     .
     3356     do while valid-handle(hh):
     3357       if hh:name = v-next-widget-name then do:
     3358         if hh:sensitive  = yes
     3359         AND hh:visible = yes then do:
     3360           if hh:type = "TOGGLE-BOX":U then do:
     3361             assign
     3362             hh:BGcolor = 1
     3363             .
     3364           end.
     3365           APPLY "ENTRY" to hh.
     3366           return no-apply.
     3367         end.
     3368         else do:
     3369         APPLY "BACK-TAB" to hh.
     3370         return no-apply.
     3371         end.
     3372       end.
     3373       hh = hh:next-sibling.
     3374     end.
     3375     end.
     3376   END.
     3377     IF p-mode <> 'ПРОСМОТР':U
     3378     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     3379         MESSAGE
     3380         vss-workfile vss-revision vss-description skip
     3381         "Неверное значение параметра p-mode" p-mode
     3382         VIEW-AS ALERT-BOX ERROR.
     3383         UNDO, RETURN ERROR.
     3384     END.
     3385     if p-mode <> 'ПРОСМОТР':U
     3386     and v-cntxt-db-num > 0
     3387     and (p-obj-type = '' and p-obj-code = 0) then do:
     3388       message
     3389       "Нельзя изменять ГЛОБАЛЬНЫЕ настройки в УБД"
     3390       view-as alert-box error .
     3391       undo, return error .
     3392     end.
     3393     IF p-obj-type <> 'маг':U
     3394     and p-obj-type <> 'орг':U
     3395     and p-obj-type <> '':U
     3396     THEN DO:
     3397         MESSAGE
     3398         vss-workfile vss-revision vss-description skip
     3399         "Неверное значение параметра p-obj-type" p-obj-type
     3400         VIEW-AS ALERT-BOX ERROR.
     3401         UNDO, RETURN ERROR.
     3402     END.
     3403     if p-obj-type = 'маг':U then do:
     3404       FIND FIRST X_shop NO-LOCK WHERE
     3405                X_shop.obj-code = p-obj-code NO-ERROR.
     3406       IF NOT AVAILABLE X_shop THEN DO:
     3407           MESSAGE
     3408           vss-workfile vss-revision vss-description skip
     3409           "Неверное значение параметра p-obj-code" p-obj-code
     3410           VIEW-AS ALERT-BOX ERROR.
     3411           UNDO, RETURN ERROR.
     3412       END.
     3413   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3414   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     3415     (input  'маг':U
     3416     ,input  p-obj-code
     3417     ,output v-db-num
     3418     )  .
     3419       IF v-db-num <> v-cntxt-db-num
     3420       AND v-cntxt-db-num <> 0
     3421       and p-mode <> 'ПРОСМОТР':U
     3422       THEN DO:
     3423           MESSAGE
     3424           "Нельзя менять параметры магазина в чужой БД" skip
     3425           "магазин принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     3426           VIEW-AS ALERT-BOX ERROR.
     3427           UNDO, RETURN ERROR.
     3428       END.
     3429   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3430   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3431     (input  p-obj-type
     3432     ,input  p-obj-code
     3433     ,output v-host-code
     3434     )  .
     3435       v-current-upper-prop-code = 'rum_obj':U.
     3436     end.
     3437     if p-obj-type = 'скл':U then do:
     3438       FIND FIRST X_store NO-LOCK WHERE
     3439                X_store.obj-code = p-obj-code NO-ERROR.
     3440       IF NOT AVAILABLE X_store THEN DO:
     3441           MESSAGE
     3442           vss-workfile vss-revision vss-description skip
     3443           "Неверное значение параметра p-obj-code" p-obj-code
     3444           VIEW-AS ALERT-BOX ERROR.
     3445           UNDO, RETURN ERROR.
     3446       END.
     3447   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3448   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     3449     (input  'скл':U
     3450     ,input  p-obj-code
     3451     ,output v-db-num
     3452     )  .
     3453       IF v-db-num <> v-cntxt-db-num
     3454       AND v-cntxt-db-num <> 0
     3455       and p-mode <> 'ПРОСМОТР':U
     3456       THEN DO:
     3457           MESSAGE
     3458           "Нельзя менять параметры склада в чужой БД" skip
     3459           "магазин принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     3460           VIEW-AS ALERT-BOX ERROR.
     3461           UNDO, RETURN ERROR.
     3462       END.
     3463   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3464   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3465     (input  p-obj-type
     3466     ,input  p-obj-code
     3467     ,output v-host-code
     3468     )  .
     3469       v-current-upper-prop-code = 'rum_obj':U.
     3470     end.
     3471     if p-obj-type = 'орг':U then do:
     3472       FIND FIRST X_sysconf NO-LOCK WHERE
     3473                 X_sysconf.host-code = p-obj-code NO-ERROR.
     3474       IF NOT AVAILABLE X_sysconf THEN DO:
     3475           MESSAGE
     3476           vss-workfile vss-revision vss-description skip
     3477           "Неверное значение параметра p-obj-code" p-obj-code
     3478           VIEW-AS ALERT-BOX ERROR.
     3479           UNDO, RETURN ERROR.
     3480       END.
     3481       if v-cntxt-db-num <> 0
     3482       and p-mode <> 'ПРОСМОТР':U
     3483       then do:
     3484           MESSAGE
     3485           "Нельзя менять параметры ФИРМЫ в УБД" skip
     3486           VIEW-AS ALERT-BOX ERROR.
     3487           UNDO, RETURN ERROR.
     3488       end.
     3489       v-host-code = p-obj-code.
     3490     end.
     3491     if p-obj-type = '':U then do:
     3492       if v-cntxt-db-num <> 0
     3493       and p-mode <> 'ПРОСМОТР':U
     3494       then do:
     3495           MESSAGE
     3496           "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" skip
     3497           VIEW-AS ALERT-BOX ERROR.
     3498           UNDO, RETURN ERROR.
     3499       end.
     3500       v-current-upper-prop-code = 'rum':U.
     3501     end.
     3502     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     3503       do transaction:
     3504         FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
     3505                   LOCKED_thbj-attr.obj-type = p-obj-type
     3506             AND   LOCKED_thbj-attr.obj-code = p-obj-code
     3507             AND   LOCKED_thbj-attr.upper-prop-code = v-current-upper-prop-code
     3508             AND   locked_thbj-attr.prop-code = '':U NO-ERROR.
     3509         if locked locked_thbj-attr then do:
     3510             message
     3511             vss-workfile vss-revision vss-description skip
     3512             "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
     3513             view-as alert-box error .
     3514             undo, return error.
     3515           end.
     3516        end.
     3517     END.
     3518     ELSE DO:
     3519         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
     3520             LOCKED_thbj-attr.obj-type = p-obj-type
     3521       AND   LOCKED_thbj-attr.obj-code = p-obj-code
     3522       AND   LOCKED_thbj-attr.upper-prop-code = v-current-upper-prop-code
     3523       AND   locked_thbj-attr.prop-code = '':U NO-ERROR.
     3524     END.
     3525     if not available locked_thbj-attr then do:
     3526       ASSIGN
     3527       v-to-create  = YES.
     3528       message
     3529       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     3530                   chr(10))
     3531       view-as alert-box WARNING.
     3532     end.
     3533     v-is-obj = NOT ( p-obj-type = '' AND p-obj-code = 0).
     3534     RUN FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     3535     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     3536     RUN Myenable.
     3537     WAIT-FOR GO OF FRAME Dialog-Frame.
     3538   END.
     3539   RUN disable_UI.
     3540   PROCEDURE disable_UI :
     3541     HIDE FRAME Dialog-Frame.
     3542   END PROCEDURE.
     3543   PROCEDURE enable_UI :
     3544     DISPLAY Rs-algo-profile rs-algo-types E-rule-name
     3545         WITH FRAME Dialog-Frame.
     3546     ENABLE b-quit b-ruleproc B-history B-Help BR-thbj-attr Rs-algo-profile
     3547            rs-algo-types b-rule b-params B-ruleset br-rule-by-call br-profile
     3548            E-rule-name
     3549         WITH FRAME Dialog-Frame.
     3550     VIEW FRAME Dialog-Frame.
     3551     OPEN QUERY br-profile FOR EACH X_rp-by-call NO-LOCK WHERE          X_rp-by-call.call_id = v-uniq-key-rec ,        FIRST X2_rule-profile WHERE     X2_rule-profile.profile_id = X_rp-by-call.profile_id     AND ((NOT v-is-obj) OR LOOKUP('obj',        X2_rule-profile.short-name) > 0) INDEXED-REPOSITION.    OPEN QUERY br-rule-by-call FOR EACH X_rule-by-call       WHERE X_rule-by-call.call_id = v-uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE          X_rule-profile.profile_id = X_rule-by-call.profile_id      AND (rs-algo-types = 1 OR          X_rule-profile.is_dynamic = yes)     AND ((NOT v-is-obj) OR  LOOKUP( "obj",        X_rule-profile.short-name) > 0) BY X_rule-by-call.codex_id BY X_rule-by-call.ruleset_id BY X_rule-by-call.order_id INDEXED-REPOSITION.    OPEN QUERY BR-thbj-attr FOR EACH buf_temp-thbj-attr WHERE     buf_temp-thbj-attr.obj-type = p-obj-type AND buf_temp-thbj-attr.obj-code = p-obj-code                                                     .
     3552   END PROCEDURE.
     3553   PROCEDURE fill-widgets :
     3554   define variable v-value-character as character no-undo .
     3555   define variable v-value-date as date no-undo .
     3556   define variable v-value-decimal as decimal no-undo .
     3557   define variable v-value-integer as INTEGER no-undo .
     3558   define variable v-value-logical AS LOGICAL no-undo .
     3559   DEFINE VARIABLE v-entry AS CHARACTER NO-UNDO.
     3560   define variable v-param-type as character no-undo .
     3561   define variable v-param-value as character no-undo .
     3562   define variable v-edoc as character no-undo .
     3563   define variable v-goods as character no-undo .
     3564   define variable v-clients as character no-undo .
     3565   define variable v-gds-grp as character no-undo .
     3566   define variable v-cli-grp as character no-undo .
     3567   define variable v-chk-doc-ibs-th as character no-undo .
     3568   define variable v-chk-doc-ibs-th-mob as character no-undo .
     3569   define variable v-rep as character no-undo .
     3570   define variable v-fdoc as character no-undo .
     3571   define variable v-thref as character no-undo .
     3572   define variable v-ord as character no-undo .
     3573   define variable v-cmd as character no-undo .
     3574   define variable ii as integer no-undo .
     3575   define variable attr-label as character no-undo .
     3576   define variable attr-user-can-edit as logical no-undo .
     3577   define variable attr-output-display as logical no-undo .
     3578   define variable attr-other as char no-undo .
     3579   define variable attr-value as char no-undo .
     3580   define variable v-db as logical   no-undo .
     3581   define variable v-host as logical no-undo .
     3582   define variable v-shop as logical no-undo .
     3583   define variable v-store as logical no-undo .
     3584   define variable v-global as logical no-undo .
     3585   define variable v-need-prop-list as character no-undo .
     3586   define variable v-prop-type-list as character no-undo .
     3587   define variable v-prop-label-list as character no-undo .
     3588   FOR EACH thbjattr_thbj-attr:
     3589     delete thbjattr_thbj-attr.
     3590   end.
     3591   FOR EACH temp-thbj-attr:
     3592     delete temp-thbj-attr.
     3593   end.
     3594   run thbjattr_code in this-procedure (
     3595       input  v-current-upper-prop-code
     3596     ,input ''
     3597     ,output attr-label
     3598     ,output attr-user-can-edit
     3599     ,output attr-output-display
     3600     ,output attr-other
     3601     ,output v-need-prop-list
     3602     ,output v-prop-type-list
     3603     ,output v-prop-label-list
     3604     ,output v-global
     3605     ,output v-host
     3606     ,output v-shop
     3607     ,output v-store
     3608     ,output v-db
     3609     ) no-error .
     3610   run adm/shattri.p (
     3611                 input "init":U
     3612               , input p-obj-type
     3613               , input p-obj-code
     3614               , input v-current-upper-prop-code
     3615               , input "":U
     3616               , output v-value-character
     3617               , output v-value-date
     3618               , output v-value-decimal
     3619               , output v-value-integer
     3620               , output v-value-logical
     3621               , output v-param-type
     3622               , INPUT-OUTPUT TABLE-handle v-tth
     3623               ) no-error .
     3624   if error-status:error
     3625   and not available locked_thbj-attr then do:
     3626     message
     3627     "Не удалось получить начальные значения настроек" skip
     3628     error-status:get-message(1) return-value
     3629     view-as alert-box error .
     3630     undo, return error .
     3631   end.
     3632   FOR EACH thbjattr_thbj-attr:
     3633     if lookup(thbjattr_thbj-attr.prop-code, v-need-prop-list) = 0 then do:
     3634       delete thbjattr_thbj-attr.
     3635       next.
     3636     end.
     3637     ASSIGN
     3638     v-entry = thbjattr_thbj-attr.prop-code.
     3639   IF v-entry = 'edoc':U THEN DO:
     3640       ASSIGN
     3641       v-edoc = thbjattr_thbj-attr.property-value-character
     3642       .
     3643     END.
     3644     IF v-entry = 'goods':U THEN DO:
     3645       ASSIGN
     3646       v-goods = thbjattr_thbj-attr.property-value-character
     3647       .
     3648     END.
     3649     IF v-entry = 'rep':U THEN DO:
     3650       ASSIGN
     3651       v-rep = thbjattr_thbj-attr.property-value-character    .
     3652     END.
     3653     IF v-entry = 'fdoc':U THEN DO:
     3654       ASSIGN
     3655       v-fdoc = thbjattr_thbj-attr.property-value-character    .
     3656     END.
     3657     IF v-entry = 'clients':U THEN DO:
     3658       ASSIGN
     3659       v-clients = thbjattr_thbj-attr.property-value-character
     3660       .
     3661     END.
     3662     IF v-entry = 'gds-grp':U THEN DO:
     3663       ASSIGN
     3664       v-gds-grp = thbjattr_thbj-attr.property-value-character
     3665       .
     3666     END.
     3667     IF v-entry = 'cli-grp':U THEN DO:
     3668       ASSIGN
     3669       v-cli-grp = thbjattr_thbj-attr.property-value-character
     3670       .
     3671     END.
     3672    IF v-entry = 'thref':U THEN DO:
     3673       ASSIGN
     3674       v-thref = thbjattr_thbj-attr.property-value-character    .
     3675     END.
     3676     IF v-entry = 'ord':U THEN DO:
     3677       ASSIGN
     3678       v-ord = thbjattr_thbj-attr.property-value-character    .
     3679     END.
     3680     IF v-entry = 'cmb':U THEN DO:
     3681       ASSIGN
     3682       v-cmd = thbjattr_thbj-attr.property-value-character    .
     3683     END.
     3684     IF v-entry = 'chk-doc_ibs-th':U THEN DO:
     3685       ASSIGN
     3686       v-chk-doc-ibs-th = thbjattr_thbj-attr.property-value-character
     3687       .
     3688     END.
     3689     IF v-entry = 'chk-doc_ibs-th-mob':U THEN DO:
     3690       ASSIGN
     3691       v-chk-doc-ibs-th-mob = thbjattr_thbj-attr.property-value-character
     3692       .
     3693     END.
     3694     create temp-thbj-attr.
     3695     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     3696   END.
     3697   END PROCEDURE.
     3698   PROCEDURE MyEnable :
     3699   DEFINE VARIABLE clh AS WIDGET-HANDLE NO-UNDO.
     3700   DEFINE VARIABLE ii AS integer NO-UNDO.
     3701   DO ii = 1 TO br-profile:NUM-COLUMNS IN FRAME Dialog-Frame:
     3702       clh = BROWSE br-profile:get-browse-column(ii).
     3703       IF clh:LABEL BEGINS "Название" THEN DO:
     3704         ASSIGN
     3705         clh:RESIZABLE = YES
     3706         clh:width = 72
     3707         .
     3708       END.
     3709   END.
     3710   ASSIGN
     3711   rs-algo-profile:RADIO-BUTTONS = "Алгоритмы" + chr(44) +
     3712                                    'rp-by-call':U + chr(44) +
     3713                                   "Правила" + chr(44) + 'rule-by-call':U.
     3714   rs-algo-profile = 'rp-by-call':U.
     3715   ASSIGN
     3716   X_rule-by-call.algo-des:RESIZABLE IN BROWSE br-rule-by-call = YES
     3717   b-rule:menu-mouse in frame Dialog-Frame = 1
     3718   b-ruleproc:menu-mouse in frame Dialog-Frame = 1
     3719   .
     3720   DISPLAY
     3721   rs-algo-profile
     3722   rs-algo-types
     3723   WITH FRAME Dialog-Frame.
     3724   ASSIGN
     3725   FRAME Dialog-Frame:TITLE = substitute("&1 &2&3"
     3726                                          ,FRAME Dialog-Frame:TITLE
     3727                                          ,p-obj-type
     3728                                          ,(if p-obj-code > 0 then string(p-obj-code) else '':U)
     3729                                          )
     3730   v-tab-order = "b-chg".
     3731   ENABLE
     3732   b-quit
     3733   B-Help
     3734   b-chg when p-mode = 'ИЗМЕНЕНИЕ':U
     3735   BR-thbj-attr
     3736   br-rule-by-call
     3737   br-profile
     3738   b-params
     3739   b-rule
     3740   b-ruleset
     3741   b-ruleproc
     3742   rs-algo-types
     3743   rs-algo-profile
     3744   br-thbj-attr
     3745   e-rule-name
     3746   b-history
     3747   WITH FRAME Dialog-Frame.
     3748   VIEW FRAME Dialog-Frame.
     3749   IF p-mode = 'ПРОСМОТР':U THEN DO:
     3750       ASSIGN
     3751       b-quit:LABEL = "&Выход"
     3752       .
     3753   END.
     3754   OPEN QUERY BR-thbj-attr FOR EACH buf_temp-thbj-attr WHERE     buf_temp-thbj-attr.obj-type = p-obj-type AND buf_temp-thbj-attr.obj-code = p-obj-code                                                     .
     3755   APPLY "ENTRY" TO br-thbj-attr.
     3756   APPLY "VALUE-CHANGED" TO br-thbj-attr.
     3757   APPLY "VALUE-CHANGED" TO rs-algo-profile.
     3758   END PROCEDURE.
     3759   PROCEDURE proc-display-rule :
     3760   DEFINE INPUT PARAMETER p-DISPLAY-MODE AS CHARACTER NO-UNDO.
     3761   DEFINE INPUT PARAMETER p-codex-id AS INTEGER NO-UNDO.
     3762   DEFINE INPUT PARAMETER p-ruleset-id AS INTEGER NO-UNDO.
     3763   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     3764   DEFINE INPUT PARAMETER p-order-id AS INTEGER NO-UNDO.
     3765   DEFINE INPUT PARAMETER p-rule-id AS INTEGER NO-UNDO.
     3766   run rul/disprule.p (
     3767                          input p-DISPLAY-MODE
     3768                         ,input p-rule-id
     3769                         ,input p-codex-id
     3770                         ,input p-ruleset-id
     3771                         ,input p-call-id
     3772                         ,input p-order-id
     3773                          ).
     3774   END PROCEDURE.
     3775   PROCEDURE proc-save :
     3776   define variable v-value-character as character no-undo .
     3777   define variable v-value-date as date no-undo .
     3778   define variable v-value-decimal as decimal no-undo .
     3779   define variable v-value-integer as INTEGER no-undo .
     3780   define variable v-value-logical AS LOGICAL no-undo .
     3781   define variable v-param-type as character no-undo .
     3782   define variable wh as widget-handle no-undo .
     3783   define variable fh as widget-handle no-undo .
     3784   define variable v-same as logical no-undo .
     3785   define variable v-edoc as character no-undo .
     3786   define variable v-goods as character no-undo .
     3787   define variable v-clients as character no-undo .
     3788   define variable v-gds-grp as character no-undo .
     3789   define variable v-cli-grp as character no-undo .
     3790   define variable v-rep as character no-undo .
     3791   define variable v-fdoc as character no-undo .
     3792   define variable v-thref as character no-undo .
     3793   define variable v-ord as character no-undo .
     3794   define variable v-cmb as character no-undo .
     3795   define variable v-chk-doc-ibs-th as character no-undo .
     3796   define variable v-chk-doc-ibs-th-mob as character no-undo .
     3797   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     3798   assign
     3799   fh = frame Dialog-Frame:first-child
     3800   wh = fh:first-child
     3801   .
     3802   do while valid-handle(wh):
     3803     if wh:private-data begins "recid=" then do:
     3804       find first thbjattr_thbj-attr where
     3805                 recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     3806       assign
     3807       buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     3808     end.
     3809     wh = wh:next-sibling.
     3810   end.
     3811   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'edoc':U.
     3812   assign
     3813   thbjattr_thbj-attr.property-value-character = v-edoc
     3814   .
     3815   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'goods':U.
     3816   assign
     3817   thbjattr_thbj-attr.property-value-character = v-goods
     3818   .
     3819   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'clients':U.
     3820   assign
     3821   thbjattr_thbj-attr.property-value-character = v-clients
     3822   .
     3823   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'gds-grp':U.
     3824   assign
     3825   thbjattr_thbj-attr.property-value-character = v-gds-grp
     3826   .
     3827   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'cli-grp':U.
     3828   assign
     3829   thbjattr_thbj-attr.property-value-character = v-cli-grp
     3830   .
     3831   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'rep':U.
     3832   assign
     3833   thbjattr_thbj-attr.property-value-character = v-rep
     3834   .
     3835   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'fdoc':U.
     3836   assign
     3837   thbjattr_thbj-attr.property-value-character = v-fdoc
     3838   .
     3839   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'thref':U.
     3840   assign
     3841   thbjattr_thbj-attr.property-value-character = v-thref
     3842   .
     3843   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'cmb':U.
     3844   assign
     3845   thbjattr_thbj-attr.property-value-character = v-cmb
     3846   .
     3847   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'ord':U.
     3848   assign
     3849   thbjattr_thbj-attr.property-value-character = v-ord
     3850   .
     3851   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'chk-doc_ibs-th':U.
     3852   assign
     3853   thbjattr_thbj-attr.property-value-character = v-chk-doc-ibs-th
     3854   .
     3855   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'chk-doc_ibs-th-mob':U.
     3856   assign
     3857   thbjattr_thbj-attr.property-value-character = v-chk-doc-ibs-th-mob
     3858   .
     3859   v-same = yes.
     3860   for each thbjattr_thbj-attr,
     3861       first temp-thbj-attr where
     3862             temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     3863         and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     3864         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     3865         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code:
     3866      buffer-compare
     3867      thbjattr_thbj-attr
     3868      to temp-thbj-attr
     3869      save result in v-same.
     3870      if not v-same then leave.
     3871   end.
     3872   v-same = no.
     3873   IF v-same  and not v-to-create THEN RETURN.
     3874   run adm/shattri.p (
     3875                 input "check":U
     3876               , input p-obj-type
     3877               , input p-obj-code
     3878               , input v-current-upper-prop-code
     3879               , INPUT '':U
     3880                , output v-value-character
     3881                , output v-value-date
     3882                , output v-value-decimal
     3883                , output v-value-integer
     3884                , output v-value-logical
     3885                , output v-param-type
     3886                , input-output table-handle v-tth
     3887                ) no-error .
     3888   if error-status:error then do:
     3889     message
     3890     "Некорректное значение ПАРАМЕТРОВ" skip
     3891     error-status:get-message(1) skip
     3892     return-value
     3893     view-as alert-box error .
     3894     undo, return error .
     3895   end.
     3896   do TRANSACTION
     3897   on error undo, return error return-value
     3898   :
     3899     RUN thbjattr_set-section IN THIS-PROCEDURE (
     3900          input p-obj-type
     3901         ,input p-obj-code
     3902         ,input v-current-upper-prop-code
     3903         ,INPUT table thbjattr_thbj-attr
     3904     ) NO-ERROR.
     3905     IF ERROR-STATUS:error THEN do:
     3906       MESSAGE ERROR-STATUS:get-message(1)  SKIP
     3907       RETURN-VALUE
     3908       VIEW-AS ALERT-BOX.
     3909       UNDO, RETURN ERROR.
     3910     END.
     3911   end.
     3912   END PROCEDURE.
     3913   PROCEDURE proc-value-changed :
     3914   OPEN QUERY br-rule-by-call FOR EACH X_rule-by-call       WHERE X_rule-by-call.call_id = v-uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE          X_rule-profile.profile_id = X_rule-by-call.profile_id      AND (rs-algo-types = 1 OR          X_rule-profile.is_dynamic = yes)     AND ((NOT v-is-obj) OR  LOOKUP( "obj",        X_rule-profile.short-name) > 0) BY X_rule-by-call.codex_id BY X_rule-by-call.ruleset_id BY X_rule-by-call.order_id INDEXED-REPOSITION.
     3915   OPEN QUERY br-profile FOR EACH X_rp-by-call NO-LOCK WHERE          X_rp-by-call.call_id = v-uniq-key-rec ,        FIRST X2_rule-profile WHERE     X2_rule-profile.profile_id = X_rp-by-call.profile_id     AND ((NOT v-is-obj) OR LOOKUP('obj',        X2_rule-profile.short-name) > 0) INDEXED-REPOSITION.
     3916   IF rs-algo-profile = 'rule-by-call':U THEN DO:
     3917     APPLY "VAlue-changed" TO br-rule-by-call IN FRAME Dialog-Frame.
     3918   END.
     3919   IF rs-algo-profile = 'rp-by-call':U THEN DO:
     3920     APPLY "VAlue-changed" TO br-profile IN FRAME Dialog-Frame.
     3921   END.
     3922   END PROCEDURE.
     3923   PROCEDURE rule-proc :
     3924   DEFINE INPUT PARAMETER p-uniq-key-rec AS CHARACTER NO-UNDO.
     3925   DEFINE INPUT PARAMETER p-option AS CHARACTER NO-UNDO.
     3926   run rul/run-rule-proc-view.p ( INPUT buf_temp-thbj-attr.prop-code
     3927                                 ,INPUT p-uniq-key-rec
     3928                                 ,INPUT 0
     3929                                 ,INPUT p-option
     3930                                 ) NO-ERROR.
     3931   IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     3932   END PROCEDURE.
     3933   FUNCTION get-profile-dynamic RETURNS LOGICAL
     3934     ( INPUT p-profile-id AS INTEGER ) :
     3935   DEFINE BUFFER buf_rule-profile FOR ub.rule-profile.
     3936   FIND FIRST buf_rule-profile NO-LOCK WHERE
     3937             buf_rule-profile.profile_id = p-profile-id NO-ERROR.
     3938   IF NOT AVAILABLE buf_rule-profile THEN RETURN ?.
     3939   RETURN buf_rule-profile.is_dynamic.
     3940   END FUNCTION.
     3941   FUNCTION get-profile-name RETURNS CHARACTER
     3942     ( INPUT p-profile-id AS INTEGER ) :
     3943   DEFINE BUFFER buf_rule-profile FOR ub.rule-profile.
     3944   FIND FIRST buf_rule-profile NO-LOCK WHERE
     3945             buf_rule-profile.profile_id = p-profile-id NO-ERROR.
     3946   IF NOT AVAILABLE buf_rule-profile THEN RETURN chr(63).
     3947   RETURN buf_rule-profile.NAME.
     3948   END FUNCTION.
     3949   FUNCTION get-prop-label RETURNS CHARACTER
     3950     ( INPUT p-prop-code AS character ) :
     3951   DEFINE VARIABLE v-tooltip AS CHARACTER NO-UNDO.
     3952   DEFINE VARIABLE v-label AS CHARACTER NO-UNDO.
     3953   DEFINE VARIABLE v-tooltip-code AS CHARACTER NO-UNDO.
     3954   run thbjattr_tooltip IN THIS-PROCEDURE (
     3955     input  'rum':U
     3956    ,INPUT p-prop-code
     3957     ,OUTPUT v-tooltip
     3958     ,OUTPUT v-label
     3959     ,OUTPUT v-tooltip-code ) NO-ERROR.
     3960   RETURN entry(2, v-label, ":").
     3961   END FUNCTION.
