      485   procedure thbjattr_get-section :
      486   define input  parameter p-obj-type like ub.thbj-attr.obj-type   no-undo .
      487   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
      488   define input  parameter p-upper-param-code  like ub.thbj-attr.upper-prop-code  no-undo .
      489   define input  parameter p-mode as character no-undo .
      490   define input-output parameter table-handle p-tth.
      491   define output parameter p-all-found as decimal no-undo .
      492   do
      493   on error undo, return error return-value
      494   :
      495       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_get-section in g#attr-lib
      496       (input  p-obj-type
      497       ,input  p-obj-code
      498       ,input  p-upper-param-code
      499       ,input  p-mode
      500       ,input-output table-handle p-tth
      501       ,output p-all-found
      502       ) no-error .
      503     if error-status :error
      504     then do:
      505       delete object p-tth.
      506       undo, return error return-value .
      507     end.
      508     delete object p-tth.
      509   end.
      510   end procedure.
