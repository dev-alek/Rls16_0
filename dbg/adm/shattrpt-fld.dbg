      954   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      955   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      956   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      957   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      958   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      959   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      960   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      961   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      962   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      963   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      964   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      965   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      966   define variable vss-include-info6 as character format "X(65)" no-undo
      967   initial "@(#)$Workfile$ $Revision$".
      968   define temp-table temp_twowin_items no-undo
      969       field itm-key       as integer
      970       field itmExtKey     as character
      971       field itmName       as character
      972       field itmDesc       as character
      973       field itmSelected   as logical
      974       field selLeft       as logical
      975       field selRight      as logical
      976       index pi is primary unique
      977           itm-key
      978       index ie
      979           itmExtKey
      980   .
      981   define temp-table temp_twowin_itemsSelected no-undo
      982       field its-key   as integer
      983       field itm-key   as integer
      984       field itmExtKey as character
      985       index pi is primary unique
      986           its-key
      987       index im
      988           itm-key
      989   .
      990   define variable v-twowin6-itm-key    as integer      no-undo.
      991   procedure twowin_clear :
      992       define buffer buf_temp_twowin_items        for temp_twowin_items.
      993   do
      994   for buf_temp_twowin_items
      995   on error undo, return error
      996   :
      997       empty temp-table buf_temp_twowin_items.
      998   end.
      999   end procedure.
     1000   procedure twowin_add-item :
     1001   define input parameter p-ext-key   as character        no-undo.
     1002   define input parameter p-item-name as character        no-undo.
     1003   define input parameter p-item-desc as character        no-undo.
     1004   define input parameter p-selected  as logical          no-undo.
     1005       define buffer buf_temp_twowin_items        for temp_twowin_items.
     1006   do
     1007   for buf_temp_twowin_items
     1008   on error undo, return error
     1009   :
     1010       assign
     1011           v-twowin6-itm-key = v-twowin6-itm-key + 1
     1012       .
     1013       create temp_twowin_items.
     1014       assign
     1015           temp_twowin_items.itm-key      = v-twowin6-itm-key
     1016           temp_twowin_items.itmExtKey    = p-ext-key
     1017           temp_twowin_items.itmName      = p-item-name
     1018           temp_twowin_items.itmDesc      = p-item-desc
     1019           temp_twowin_items.itmSelected  = p-selected
     1020           temp_twowin_items.selLeft      = no
     1021           temp_twowin_items.selRight     = no
     1022       .
     1023   end.
     1024   end procedure.
     1025   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1026   define new global shared variable g#trdcalib as handle no-undo.
     1027   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1028   procedure cur-time :
     1029      define output parameter p-today as date      no-undo .
     1030      define output parameter p-time  as integer   no-undo .
     1031     do
     1032     on error undo, return error
     1033     :
     1034       define variable v-date1 as date      no-undo .
     1035       define variable v-date2 as date      no-undo .
     1036       define variable v-time  as integer   no-undo .
     1037       assign
     1038         v-date1 = today
     1039         v-time  = time
     1040         v-date2 = today
     1041       .
     1042       if v-date1 <> v-date2
     1043       then do:
     1044         assign
     1045           v-date1 = today
     1046           v-time  = v-time
     1047         .
     1048       end.
     1049       assign
     1050         p-today = v-date1
     1051         p-time  = v-time
     1052       .
     1053     end.
     1054   end.
     1055   function cur-time-date returns character
     1056   :
     1057     return string(today, '99/99/9999':U) .
     1058   end.
     1059   function cur-time-mjd returns decimal
     1060   :
     1061     define variable v-date as date      no-undo .
     1062     define variable v-time as integer   no-undo .
     1063     run cur-time in this-procedure
     1064       (output v-date
     1065       ,output v-time
     1066       ) .
     1067     return integer(v-date) - 2400002 + (v-time / 86400) .
     1068   end.
     1069   function cur-time-get-ending-index returns integer
     1070   (input p-number as integer
     1071   )
     1072   :
     1073     if p-number < 0
     1074     or p-number = ?
     1075     then do:
     1076       return 1 .
     1077     end.
     1078     define variable v-rest as integer   no-undo .
     1079     assign
     1080       p-number = p-number modulo 100
     1081     .
     1082     if p-number < 20
     1083     then do:
     1084       assign
     1085         v-rest = p-number
     1086       .
     1087     end.
     1088     else do:
     1089       assign
     1090         v-rest = p-number modulo 10
     1091       .
     1092     end.
     1093     case v-rest :
     1094       when 1
     1095       then do:
     1096         return 2 .
     1097       end.
     1098       when 2 or
     1099       when 3 or
     1100       when 4
     1101       then do:
     1102         return 3 .
     1103       end.
     1104       otherwise do:
     1105         return 1 .
     1106       end.
     1107     end case .
     1108   end.
     1109   procedure cur-time-mjd-to-date :
     1110      define input  parameter i-mjd-diff as decimal no-undo.
     1111      define output parameter o-Date     as date    no-undo.
     1112      define output parameter o-Time     as integer no-undo.
     1113      define variable v-day-number as integer   no-undo .
     1114      if    i-mjd-diff < 0
     1115         or i-mjd-diff = ?
     1116      then do:
     1117         return "?" .
     1118      end.
     1119      assign
     1120         v-day-number = truncate(i-mjd-diff,0).
     1121         o-Date = date(v-day-number + 2400002).
     1122         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1123     .
     1124   end.
     1125   function cur-time-mjd-to-string returns character
     1126   (input p-mjd-diff as decimal
     1127   )
     1128   :
     1129     define variable v-day-number as integer   no-undo .
     1130     define variable v-seconds    as integer   no-undo .
     1131     define variable v-hour       as integer   no-undo .
     1132     define variable v-min        as integer   no-undo .
     1133     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1134     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1135     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1136     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1137     if p-mjd-diff < 0
     1138     or p-mjd-diff = ?
     1139     then do:
     1140       return "?" .
     1141     end.
     1142     assign
     1143       v-day-number = integer(truncate(p-mjd-diff,0))
     1144       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1145     .
     1146     if v-seconds > 86400
     1147     then do:
     1148       assign
     1149         v-seconds = 86400 - 1
     1150       .
     1151     end.
     1152     if v-seconds < 0
     1153     then do:
     1154       assign
     1155         v-seconds = 0
     1156       .
     1157     end.
     1158     assign
     1159       v-hour = truncate(v-seconds / 3600, 0)
     1160     .
     1161     assign
     1162       v-seconds = v-seconds modulo 3600
     1163     .
     1164     assign
     1165       v-min = truncate(v-seconds / 60, 0)
     1166     .
     1167     assign
     1168       v-seconds = v-seconds modulo 60
     1169     .
     1170     return
     1171         (if v-day-number <> 0
     1172           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1173           else ""
     1174         )
     1175       + (if v-day-number <> 0 or v-hour <> 0
     1176           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1177           else ""
     1178         )
     1179       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1180           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1181           else ""
     1182         )
     1183       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1184       .
     1185   end.
     1186   function cur-time-string returns character
     1187   :
     1188     define variable v-date as date      no-undo .
     1189     define variable v-time as integer   no-undo .
     1190     run cur-time in this-procedure
     1191       (output v-date
     1192       ,output v-time
     1193       ) .
     1194     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1195   end.
     1196   function cur-time-string-sec returns character
     1197   :
     1198     define variable v-date as date      no-undo .
     1199     define variable v-time as integer   no-undo .
     1200     run cur-time in this-procedure
     1201       (output v-date
     1202       ,output v-time
     1203       ) .
     1204     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1205   end.
     1206   function cur-time-custom  returns character
     1207   (input p-prefix as character
     1208   ,input p-date-format as character
     1209   ,input p-delimiter as character
     1210   ,input p-time-format as character
     1211   ,input p-suffix as character
     1212   )
     1213   :
     1214     define variable v-date as date      no-undo .
     1215     define variable v-time as integer   no-undo .
     1216     run cur-time in this-procedure
     1217       (output v-date
     1218       ,output v-time
     1219       ) .
     1220     return
     1221       p-prefix
     1222       + string(v-date, p-date-format)
     1223       + p-delimiter
     1224       + string(v-time, p-time-format)
     1225       + p-suffix
     1226       .
     1227   end.
     1228   function cur-time-print  returns character
     1229   :
     1230     define variable v-date as date      no-undo .
     1231     define variable v-time as integer   no-undo .
     1232     run cur-time in this-procedure
     1233       (output v-date
     1234       ,output v-time
     1235       ) .
     1236     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1237   end.
     1238   function cur-time-datetime returns datetime
     1239   :
     1240     define variable v-char as character no-undo .
     1241     define variable v-datetime as datetime no-undo .
     1242     v-char = cur-time-string().
     1243     v-datetime = datetime(v-char).
     1244     return  v-datetime.
     1245   end.
     1246   function cur-time-string-msec returns character
     1247   :
     1248     define variable v-date as datetime  no-undo .
     1249     v-date = now.
     1250     return string(v-date) .
     1251   end.
     1252   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1253   procedure sys-time_get-sys :
     1254     define output parameter p-year         as integer   no-undo .
     1255     define output parameter p-month        as integer   no-undo .
     1256     define output parameter p-day          as integer   no-undo .
     1257     define output parameter p-hour         as integer   no-undo .
     1258     define output parameter p-minute       as integer   no-undo .
     1259     define output parameter p-second       as integer   no-undo .
     1260     define output parameter p-milliseconds as integer   no-undo .
     1261     define variable v-system-time-structure as memptr    no-undo.
     1262     do
     1263     on error undo, return error return-value
     1264     :
     1265       assign
     1266         set-size(v-system-time-structure) = 16
     1267       .
     1268       run GetSystemTime
     1269         (input  get-pointer-value(v-system-time-structure)
     1270         ) .
     1271       assign
     1272         p-year         = get-short(v-system-time-structure,  1)
     1273         p-month        = get-short(v-system-time-structure,  3)
     1274         p-day          = get-short(v-system-time-structure,  7)
     1275         p-hour         = get-short(v-system-time-structure,  9)
     1276         p-minute       = get-short(v-system-time-structure, 11)
     1277         p-second       = get-short(v-system-time-structure, 13)
     1278         p-milliseconds = get-short(v-system-time-structure, 15)
     1279       .
     1280       assign
     1281         set-size(v-system-time-structure) = 0
     1282       .
     1283     end.
     1284   end procedure.
     1285   procedure sys-time_get-comp-user-name :
     1286     define output parameter p-computer-name as character no-undo .
     1287     define output parameter p-user-name     as character no-undo .
     1288     define output parameter p-process-pid   as integer   no-undo .
     1289     define variable v-return-value  as integer   no-undo .
     1290     define variable v-buffer-length as integer   no-undo .
     1291     define variable v-buffer-memptr as memptr    no-undo .
     1292     do
     1293     on error undo, return error return-value
     1294     :
     1295       assign
     1296         v-buffer-length = 1024
     1297         set-size(v-buffer-memptr) = v-buffer-length + 4
     1298       .
     1299       assign
     1300         put-long(v-buffer-memptr, 1) = v-buffer-length
     1301       .
     1302       run GetComputerNameA
     1303         (input  get-pointer-value(v-buffer-memptr) + 4
     1304         ,input  get-pointer-value(v-buffer-memptr)
     1305         ,output v-return-value
     1306         ) .
     1307       if v-return-value <> 0
     1308       then do:
     1309         assign
     1310           p-computer-name = get-string(v-buffer-memptr, 5)
     1311         .
     1312       end.
     1313       assign
     1314         put-long(v-buffer-memptr, 1) = v-buffer-length
     1315       .
     1316       run GetUserNameA
     1317         (input  get-pointer-value(v-buffer-memptr) + 4
     1318         ,input  get-pointer-value(v-buffer-memptr)
     1319         ,output v-return-value
     1320         ) .
     1321       if v-return-value <> 0
     1322       then do:
     1323         assign
     1324           p-user-name = get-string(v-buffer-memptr, 5)
     1325         .
     1326       end.
     1327       run GetCurrentProcessId
     1328         (output p-process-pid
     1329         ) .
     1330       assign
     1331         set-size(v-buffer-memptr) = 0
     1332       .
     1333     end.
     1334   end procedure.
     1335   procedure sys-time_get-http :
     1336     define output parameter p-http-time as character no-undo .
     1337     define variable v-year         as integer   no-undo .
     1338     define variable v-month        as integer   no-undo .
     1339     define variable v-day-of-week  as integer   no-undo .
     1340     define variable v-day          as integer   no-undo .
     1341     define variable v-hour         as integer   no-undo .
     1342     define variable v-minute       as integer   no-undo .
     1343     define variable v-second       as integer   no-undo .
     1344     define variable v-milliseconds as integer   no-undo .
     1345     do
     1346     on error undo, return error return-value
     1347     :
     1348       run sys-time_get-sys in this-procedure
     1349         (output v-year
     1350         ,output v-month
     1351         ,output v-day
     1352         ,output v-hour
     1353         ,output v-minute
     1354         ,output v-second
     1355         ,output v-milliseconds
     1356         ) .
     1357       assign
     1358         v-day-of-week = weekday(date(v-month, v-day, v-year))
     1359         p-http-time = entry(v-day-of-week, 'Sun,Mon,Tue,Wed,Thu,Fri,Sat')
     1360                     + ', ':u
     1361                     + string(v-day, '99':u)
     1362                     + ' ':u
     1363                     + entry(v-month, 'Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec':u)
     1364                     + ' ':u
     1365                     + string(v-year, '9999':u)
     1366                     + ' ':u
     1367                     + string(v-hour, '99':u)
     1368                     + ':':u
     1369                     + string(v-minute, '99':u)
     1370                     + ':':u
     1371                     + string(v-second, '99':u)
     1372                     + ' ':u
     1373                     + 'GMT':u
     1374       .
     1375     end.
     1376   end procedure.
     1377   procedure sys-time_set-sys :
     1378     define input  parameter p-year         as integer   no-undo .
     1379     define input  parameter p-month        as integer   no-undo .
     1380     define input  parameter p-day          as integer   no-undo .
     1381     define input  parameter p-hour         as integer   no-undo .
     1382     define input  parameter p-minute       as integer   no-undo .
     1383     define input  parameter p-second       as integer   no-undo .
     1384     define input  parameter p-milliseconds as integer   no-undo .
     1385     define variable v-system-time-structure as memptr    no-undo.
     1386     define variable v-return-value as integer   no-undo .
     1387     define variable v-day-of-week  as integer   no-undo .
     1388     do
     1389     on error undo, return error return-value
     1390     :
     1391       assign
     1392         v-day-of-week = weekday(date(p-month, p-day, p-year))
     1393       .
     1394       assign
     1395         set-size(v-system-time-structure) = 16
     1396       .
     1397       assign
     1398         put-short(v-system-time-structure,  1) = p-year
     1399         put-short(v-system-time-structure,  3) = p-month
     1400         put-short(v-system-time-structure,  5) = v-day-of-week
     1401         put-short(v-system-time-structure,  7) = p-day
     1402         put-short(v-system-time-structure,  9) = p-hour
     1403         put-short(v-system-time-structure, 11) = p-minute
     1404         put-short(v-system-time-structure, 13) = p-second
     1405         put-short(v-system-time-structure, 15) = p-milliseconds
     1406       .
     1407       run SetSystemTime
     1408         (input  get-pointer-value(v-system-time-structure)
     1409         ,output v-return-value
     1410         ) .
     1411       assign
     1412         set-size(v-system-time-structure) = 0
     1413       .
     1414       if v-return-value = 0
     1415       then do:
     1416         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
     1417       end.
     1418     end.
     1419   end procedure.
     1420   procedure sys-time_sys-to-mjd :
     1421     define input  parameter p-year         as integer   no-undo .
     1422     define input  parameter p-month        as integer   no-undo .
     1423     define input  parameter p-day          as integer   no-undo .
     1424     define input  parameter p-hour         as integer   no-undo .
     1425     define input  parameter p-minute       as integer   no-undo .
     1426     define input  parameter p-second       as integer   no-undo .
     1427     define input  parameter p-milliseconds as integer   no-undo .
     1428     define output parameter p-mjd          as decimal   no-undo .
     1429     define variable v-year-correction as decimal   no-undo .
     1430     define variable v-shift-year as decimal   no-undo .
     1431     do
     1432     on error undo, return error return-value
     1433     :
     1434       assign
     1435         v-year-correction = truncate((decimal(p-month) - 14.0) / 12, 0)
     1436         v-shift-year      = decimal(p-year) + v-year-correction
     1437         p-mjd = truncate( (1461.0 * (v-shift-year + 4800.0 ) ) / 4, 0)
     1438               + truncate( (367.0 * (decimal(p-month) - 2.0 - v-year-correction * 12) ) / 12, 0)
     1439               - truncate( (3 * truncate((v-shift-year + 4900 ) / 100,0) ) / 4, 0)
     1440               + decimal(p-day) - 2432076.0
     1441               + p-hour / 24.0
     1442               + p-minute / 1440.0
     1443               + p-second / 86400.0
     1444               + p-milliseconds / 86400000.0
     1445       .
     1446     end.
     1447   end procedure.
     1448   procedure sys-time_sys-to-loc :
     1449     define input  parameter p-sys-year         as integer   no-undo .
     1450     define input  parameter p-sys-month        as integer   no-undo .
     1451     define input  parameter p-sys-day          as integer   no-undo .
     1452     define input  parameter p-sys-hour         as integer   no-undo .
     1453     define input  parameter p-sys-minute       as integer   no-undo .
     1454     define input  parameter p-sys-second       as integer   no-undo .
     1455     define input  parameter p-sys-milliseconds as integer   no-undo .
     1456     define output parameter p-loc-year         as integer   no-undo .
     1457     define output parameter p-loc-month        as integer   no-undo .
     1458     define output parameter p-loc-day          as integer   no-undo .
     1459     define output parameter p-loc-hour         as integer   no-undo .
     1460     define output parameter p-loc-minute       as integer   no-undo .
     1461     define output parameter p-loc-second       as integer   no-undo .
     1462     define output parameter p-loc-milliseconds as integer   no-undo .
     1463     define variable v-system-time-structure as memptr    no-undo.
     1464     define variable v-return-value          as integer   no-undo .
     1465     define variable v-sys-day-of-week       as integer   no-undo .
     1466     do
     1467     on error undo, return error return-value
     1468     :
     1469       assign
     1470         v-sys-day-of-week = weekday(date(p-sys-month, p-sys-day, p-sys-year))
     1471       .
     1472       assign
     1473         set-size(v-system-time-structure) = 32
     1474       .
     1475       assign
     1476         put-short(v-system-time-structure,  1) = p-sys-year
     1477         put-short(v-system-time-structure,  3) = p-sys-month
     1478         put-short(v-system-time-structure,  5) = v-sys-day-of-week
     1479         put-short(v-system-time-structure,  7) = p-sys-day
     1480         put-short(v-system-time-structure,  9) = p-sys-hour
     1481         put-short(v-system-time-structure, 11) = p-sys-minute
     1482         put-short(v-system-time-structure, 13) = p-sys-second
     1483         put-short(v-system-time-structure, 15) = p-sys-milliseconds
     1484       .
     1485       run SystemTimeToTzSpecificLocalTime
     1486         (input  0
     1487         ,input  get-pointer-value(v-system-time-structure)
     1488         ,input  get-pointer-value(v-system-time-structure) + 16
     1489         ,output v-return-value
     1490         ) .
     1491       assign
     1492         p-loc-year         = get-short(v-system-time-structure,  1 + 16)
     1493         p-loc-month        = get-short(v-system-time-structure,  3 + 16)
     1494         p-loc-day          = get-short(v-system-time-structure,  7 + 16)
     1495         p-loc-hour         = get-short(v-system-time-structure,  9 + 16)
     1496         p-loc-minute       = get-short(v-system-time-structure, 11 + 16)
     1497         p-loc-second       = get-short(v-system-time-structure, 13 + 16)
     1498         p-loc-milliseconds = get-short(v-system-time-structure, 15 + 16)
     1499       .
     1500       assign
     1501         set-size(v-system-time-structure) = 0
     1502       .
     1503       if v-return-value = 0
     1504       then do:
     1505         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
     1506       end.
     1507     end.
     1508   end procedure.
     1509   procedure sys-time_mjd-to-sys :
     1510     define input  parameter p-mjd          as decimal   no-undo .
     1511     define output parameter p-year         as integer   no-undo .
     1512     define output parameter p-month        as integer   no-undo .
     1513     define output parameter p-day          as integer   no-undo .
     1514     define output parameter p-hour         as integer   no-undo .
     1515     define output parameter p-minute       as integer   no-undo .
     1516     define output parameter p-second       as integer   no-undo .
     1517     define output parameter p-milliseconds as integer   no-undo .
     1518     define variable v-year-correction as decimal   no-undo .
     1519     define variable v-shift-year      as decimal   no-undo .
     1520     define variable v-conv-date     as date      no-undo .
     1521     define variable v-int-part      as integer   no-undo .
     1522     define variable v-fraction-part as decimal   no-undo .
     1523     do
     1524     on error undo, return error return-value
     1525     :
     1526       assign
     1527         v-int-part      = integer(truncate(p-mjd, 0))
     1528         v-fraction-part = p-mjd - v-int-part
     1529         v-conv-date     = date(11, 17, 1858) + v-int-part
     1530         p-year          = year(v-conv-date)
     1531         p-month         = month(v-conv-date)
     1532         p-day           = day(v-conv-date)
     1533         v-fraction-part = v-fraction-part * 24.0
     1534         p-hour          = integer(truncate(v-fraction-part, 0))
     1535         v-fraction-part = (v-fraction-part - p-hour) * 60.0
     1536         p-minute        = integer(truncate(v-fraction-part, 0))
     1537         v-fraction-part = (v-fraction-part - p-minute) * 60.0
     1538         p-second        = integer(truncate(v-fraction-part, 0))
     1539         v-fraction-part = (v-fraction-part - p-second) * 1000.0
     1540         p-milliseconds  = integer(v-fraction-part)
     1541       .
     1542     end.
     1543   end procedure.
     1544   procedure sys-time_mjd-to-loc :
     1545     define input  parameter p-mjd              as decimal   no-undo .
     1546     define output parameter p-loc-year         as integer   no-undo .
     1547     define output parameter p-loc-month        as integer   no-undo .
     1548     define output parameter p-loc-day          as integer   no-undo .
     1549     define output parameter p-loc-hour         as integer   no-undo .
     1550     define output parameter p-loc-minute       as integer   no-undo .
     1551     define output parameter p-loc-second       as integer   no-undo .
     1552     define output parameter p-loc-milliseconds as integer   no-undo .
     1553     define variable v-sys-year         as integer   no-undo .
     1554     define variable v-sys-month        as integer   no-undo .
     1555     define variable v-sys-day          as integer   no-undo .
     1556     define variable v-sys-hour         as integer   no-undo .
     1557     define variable v-sys-minute       as integer   no-undo .
     1558     define variable v-sys-second       as integer   no-undo .
     1559     define variable v-sys-milliseconds as integer   no-undo .
     1560     do
     1561     on error undo, return error return-value
     1562     :
     1563       run sys-time_mjd-to-sys
     1564         (input  p-mjd
     1565         ,output v-sys-year
     1566         ,output v-sys-month
     1567         ,output v-sys-day
     1568         ,output v-sys-hour
     1569         ,output v-sys-minute
     1570         ,output v-sys-second
     1571         ,output v-sys-milliseconds
     1572         ) .
     1573       run sys-time_sys-to-loc
     1574         (input  v-sys-year
     1575         ,input  v-sys-month
     1576         ,input  v-sys-day
     1577         ,input  v-sys-hour
     1578         ,input  v-sys-minute
     1579         ,input  v-sys-second
     1580         ,input  v-sys-milliseconds
     1581         ,output p-loc-year
     1582         ,output p-loc-month
     1583         ,output p-loc-day
     1584         ,output p-loc-hour
     1585         ,output p-loc-minute
     1586         ,output p-loc-second
     1587         ,output p-loc-milliseconds
     1588         ) .
     1589     end.
     1590   end procedure.
     1591   function sys-time_get-mjd-func returns decimal
     1592   :
     1593     define variable v-year         as integer   no-undo .
     1594     define variable v-month        as integer   no-undo .
     1595     define variable v-day          as integer   no-undo .
     1596     define variable v-hour         as integer   no-undo .
     1597     define variable v-minute       as integer   no-undo .
     1598     define variable v-second       as integer   no-undo .
     1599     define variable v-milliseconds as integer   no-undo .
     1600     define variable v-mjd          as decimal   no-undo .
     1601     run sys-time_get-sys in this-procedure
     1602       (output v-year
     1603       ,output v-month
     1604       ,output v-day
     1605       ,output v-hour
     1606       ,output v-minute
     1607       ,output v-second
     1608       ,output v-milliseconds
     1609       ) .
     1610     run sys-time_sys-to-mjd in this-procedure
     1611       (input  v-year
     1612       ,input  v-month
     1613       ,input  v-day
     1614       ,input  v-hour
     1615       ,input  v-minute
     1616       ,input  v-second
     1617       ,input  v-milliseconds
     1618       ,output v-mjd
     1619       ) .
     1620     return v-mjd .
     1621   end function .
     1622   function sys-time_get-sys-str-func returns character
     1623   :
     1624     define variable v-utc-time as character no-undo .
     1625     define variable v-year         as integer   no-undo .
     1626     define variable v-month        as integer   no-undo .
     1627     define variable v-day          as integer   no-undo .
     1628     define variable v-hour         as integer   no-undo .
     1629     define variable v-minute       as integer   no-undo .
     1630     define variable v-second       as integer   no-undo .
     1631     define variable v-milliseconds as integer   no-undo .
     1632     run sys-time_get-sys in this-procedure
     1633       (output v-year
     1634       ,output v-month
     1635       ,output v-day
     1636       ,output v-hour
     1637       ,output v-minute
     1638       ,output v-second
     1639       ,output v-milliseconds
     1640       ) .
     1641     assign
     1642       v-utc-time  = 'UTC ':u
     1643                   + string(v-year,         '9999':u)
     1644                   + '/':u
     1645                   + string(v-month,        '99':u)
     1646                   + '/':u
     1647                   + string(v-day,          '99':u)
     1648                   + ' ':u
     1649                   + string(v-hour,         '99':u)
     1650                   + ':':u
     1651                   + string(v-minute,       '99':u)
     1652                   + ':':u
     1653                   + string(v-second,       '99':u)
     1654                   + ' ':u
     1655                   + string(v-milliseconds, '999':u)
     1656     .
     1657     return v-utc-time.
     1658   end function .
     1659   function sys-time_mjd-to-loc-str-func returns character
     1660     (v-sys-mjd as decimal)
     1661   :
     1662     define variable v-loc-str          as character no-undo .
     1663     define variable v-loc-year         as integer   no-undo .
     1664     define variable v-loc-month        as integer   no-undo .
     1665     define variable v-loc-day          as integer   no-undo .
     1666     define variable v-loc-hour         as integer   no-undo .
     1667     define variable v-loc-minute       as integer   no-undo .
     1668     define variable v-loc-second       as integer   no-undo .
     1669     define variable v-loc-milliseconds as integer   no-undo .
     1670     run sys-time_mjd-to-loc in this-procedure
     1671       (input  v-sys-mjd
     1672       ,output v-loc-year
     1673       ,output v-loc-month
     1674       ,output v-loc-day
     1675       ,output v-loc-hour
     1676       ,output v-loc-minute
     1677       ,output v-loc-second
     1678       ,output v-loc-milliseconds
     1679       ) .
     1680     assign
     1681       v-loc-str = substitute('&1/&2/&3 &4:&5'
     1682                             ,string(v-loc-day,    '99':U)
     1683                             ,string(v-loc-month,  '99':U)
     1684                             ,string(v-loc-year,   '9999':U)
     1685                             ,string(v-loc-hour,   '99':U)
     1686                             ,string(v-loc-minute, '99':U)
     1687                             )
     1688     .
     1689     return v-loc-str .
     1690   end function .
     1691   PROCEDURE GetSystemTime EXTERNAL "kernel32.dll"
     1692   :
     1693     DEFINE INPUT  PARAMETER lpSystemTime AS LONG .
     1694   END PROCEDURE.
     1695   PROCEDURE SetSystemTime EXTERNAL "kernel32.dll"
     1696   :
     1697     DEFINE INPUT  PARAMETER lpSystemTime AS LONG .
     1698     DEFINE RETURN PARAMETER ReturnValue  AS LONG .
     1699   END PROCEDURE.
     1700   PROCEDURE GetTimeZoneInformation EXTERNAL "kernel32.dll"
     1701   :
     1702     DEFINE INPUT  PARAMETER lpTimeZoneInformation AS LONG .
     1703     DEFINE RETURN PARAMETER ReturnValue           AS LONG .
     1704   END PROCEDURE.
     1705   PROCEDURE SystemTimeToTzSpecificLocalTime EXTERNAL "kernel32.dll"
     1706   :
     1707     DEFINE INPUT  PARAMETER lpTimeZone      AS LONG .
     1708     DEFINE INPUT  PARAMETER lpUniversalTime AS LONG .
     1709     DEFINE INPUT  PARAMETER lpLocalTime     AS LONG .
     1710     DEFINE RETURN PARAMETER ReturnValue     AS LONG .
     1711   END PROCEDURE.
     1712   PROCEDURE GetUserNameA EXTERNAL "advapi32.dll"
     1713   :
     1714     DEFINE INPUT  PARAMETER lpBuffer    AS LONG .
     1715     DEFINE INPUT  PARAMETER lpnSize     AS LONG .
     1716     DEFINE RETURN PARAMETER ReturnValue AS LONG .
     1717   END PROCEDURE.
     1718   PROCEDURE GetComputerNameA EXTERNAL "kernel32.dll"
     1719   :
     1720     DEFINE INPUT  PARAMETER lpBuffer    AS LONG .
     1721     DEFINE INPUT  PARAMETER lpnSize     AS LONG .
     1722     DEFINE RETURN PARAMETER ReturnValue AS LONG .
     1723   END PROCEDURE.
     1724   PROCEDURE GetCurrentProcessId EXTERNAL "kernel32.dll"
     1725   :
     1726     DEFINE RETURN PARAMETER RetVal          AS LONG.
     1727   END PROCEDURE.
     1728   define   shared variable g#auto as logical no-undo.
     1729   define   shared variable g#news as logical no-undo.
     1730   define   shared variable g#oxml as logical no-undo.
     1731   define   shared variable g#esys as logical no-undo.
     1732   define   shared variable g#news-source-db as integer no-undo.
     1733   define   shared variable g#esys-source-esys as integer no-undo.
     1734   define   shared variable g#db-num as integer   no-undo .
     1735   define   shared variable g#userid as character no-undo .
     1736   define   shared variable g#passwd as character no-undo .
     1737   define variable v-tth           as   handle       no-undo .
     1738   define variable v-tempth        as   handle       no-undo .
     1739   define variable v-to-create     as   logical      no-undo .
     1740   DEFINE VARIABLE v-db-num        like ub.db.db-num no-undo.
     1741   define variable v-list-dop-info-full as character    no-undo.
     1742   define variable v-list-dop-info      as character    no-undo.
     1743   define temp-table temp_twowin_itemsSelected_col no-undo
     1744       field its-key   as integer
     1745       field itm-key   as integer
     1746       field itmExtKey as character
     1747       index pi is primary unique
     1748         its-key
     1749       index im
     1750         itm-key
     1751   .
     1752   define variable v-list-sec-fields-full as character    no-undo.
     1753   define variable v-list-sec-fields      as character    no-undo.
     1754   define temp-table sect_twowin_itemsSelected_col no-undo
     1755       field its-key   as integer
     1756       field itm-key   as integer
     1757       field itmExtKey as character
     1758       index pi is primary unique
     1759         its-key
     1760       index im
     1761         itm-key
     1762   .
     1763   define variable mChkPart1 as logical no-undo.
     1764   define variable mChkPart2 as logical no-undo.
     1765   CREATE WIDGET-POOL.
     1766   DEFINE VARIABLE h_folder AS HANDLE NO-UNDO.
     1767   DEFINE VARIABLE h_part1 AS HANDLE NO-UNDO.
     1768   DEFINE VARIABLE h_part2 AS HANDLE NO-UNDO.
     1769   DEFINE BUTTON B-exit AUTO-GO
     1770        LABEL "&Ввод"
     1771        SIZE 10 BY 1
     1772        BGCOLOR 8 .
     1773   DEFINE BUTTON B-Help
     1774        LABEL "Помо&щь"
     1775        SIZE 3 BY 1
     1776        BGCOLOR 8 .
     1777   DEFINE BUTTON b-quit AUTO-END-KEY
     1778        LABEL "&Отмена"
     1779        SIZE 10 BY 1
     1780        BGCOLOR 8 .
     1781   DEFINE FRAME D-Dialog
     1782        B-exit AT ROW 1 COL 1 WIDGET-ID 2
     1783        b-quit AT ROW 1 COL 11 WIDGET-ID 6
     1784        B-Help AT ROW 1 COL 116 WIDGET-ID 4
     1785        SPACE(2.00) SKIP(29.00)
     1786       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1787            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1788            TITLE "Просмотр информации по документам".
     1789   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1790   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1791   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1792   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1793   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1794   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1795   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1796   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1797       ASSIGN adm-object-hdl = FRAME D-Dialog:HANDLE.
     1798   RUN ensure-broker.
     1799   THIS-PROCEDURE:ADM-DATA =
     1800        'ADM1.1~`':U +
     1801        'SmartDialog~`':U +
     1802        'DIALOG-BOX~`':U +
     1803        'NO ~`':U +
     1804        '~`':U +
     1805        '~`':U +
     1806        '~`':U +
     1807        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1808           + "~`":U +
     1809        'Layout,Hide-on-Init~`':U +
     1810        'Record-Target~`':U +
     1811        '~`':U +
     1812        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1813        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1814            THEN "^^":U
     1815        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1816             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1817   PROCEDURE adm-apply-entry :
     1818     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1819   END PROCEDURE.
     1820   PROCEDURE adm-destroy :
     1821    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1822   END PROCEDURE.
     1823   PROCEDURE adm-disable :
     1824       DISABLE B-exit b-quit B-Help WITH FRAME D-Dialog.
     1825       RUN dispatch ('disable-fields':U).
     1826       RUN set-attribute-list ('ENABLED=no':U).
     1827       RETURN.
     1828   END PROCEDURE.
     1829   PROCEDURE adm-edit-attribute-list :
     1830         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1831         RETURN.
     1832   END PROCEDURE.
     1833   PROCEDURE adm-enable :
     1834       ENABLE UNLESS-HIDDEN B-exit b-quit B-Help WITH FRAME D-Dialog.
     1835       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1836       RUN set-attribute-list ('ENABLED=yes':U).
     1837       RETURN.
     1838   END PROCEDURE.
     1839   PROCEDURE adm-exit :
     1840        RUN notify ('exit':U).
     1841     RETURN.
     1842   END PROCEDURE.
     1843   PROCEDURE adm-hide :
     1844     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1845   END PROCEDURE.
     1846   PROCEDURE adm-initialize :
     1847     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1848   END PROCEDURE.
     1849   PROCEDURE adm-show-errors :
     1850       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1851       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1852           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1853       END.
     1854       RETURN.
     1855   END PROCEDURE.
     1856   PROCEDURE adm-UIB-mode :
     1857     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1858   END PROCEDURE.
     1859   PROCEDURE adm-view :
     1860     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1861   END PROCEDURE.
     1862   PROCEDURE dispatch :
     1863       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1864       RUN broker-dispatch IN adm-broker-hdl
     1865           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1866       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1867   END PROCEDURE.
     1868   PROCEDURE ensure-broker :
     1869   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1870   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1871   DO:
     1872       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1873       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1874   END.
     1875   END PROCEDURE.
     1876   PROCEDURE get-attribute :
     1877     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1878     RUN broker-get-attribute IN adm-broker-hdl
     1879         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1880     RETURN RETURN-VALUE.
     1881   END PROCEDURE.
     1882   PROCEDURE get-attribute-list :
     1883     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1884     RUN broker-get-attribute-list IN adm-broker-hdl
     1885         (INPUT THIS-PROCEDURE,
     1886          INPUT ?,
     1887          OUTPUT p-attr-list) NO-ERROR.
     1888     RETURN.
     1889   END PROCEDURE.
     1890   PROCEDURE new-state :
     1891     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1892     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1893     RETURN.
     1894   END PROCEDURE.
     1895   PROCEDURE notify :
     1896     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1897     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1898     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1899         RETURN "ADM-ERROR":U.
     1900     RETURN.
     1901   END PROCEDURE.
     1902   PROCEDURE set-attribute-list :
     1903     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1904     RUN ensure-broker.
     1905     RUN broker-set-attribute-list IN adm-broker-hdl
     1906         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1907     RETURN.
     1908   END PROCEDURE.
     1909   PROCEDURE set-position :
     1910       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1911       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1912       IF VALID-HANDLE(adm-object-hdl) THEN
     1913       DO:
     1914           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1915           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1916           DO:
     1917             IF p-row = 0 THEN p-row =
     1918               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1919             IF p-col = 0 THEN p-col =
     1920               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1921           END.
     1922           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1923           DO:
     1924             parent-hdl = adm-object-hdl:PARENT.
     1925             IF p-row = 0 THEN p-row =
     1926               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1927                 parent-hdl:ROW.
     1928             IF p-col = 0 THEN p-col =
     1929               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1930                 parent-hdl:COL.
     1931           END.
     1932           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1933           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1934         ASSIGN adm-object-hdl:ROW    =   p-row
     1935                adm-object-hdl:COLUMN =   p-col.
     1936       END.
     1937       RETURN.
     1938   END PROCEDURE.
     1939   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1940       STRING(adm-object-hdl)).
     1941   PAUSE 0 BEFORE-HIDE.
     1942   PROCEDURE adm-change-page :
     1943     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1944     END PROCEDURE.
     1945   PROCEDURE delete-page :
     1946     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1947     RUN broker-delete-page IN adm-broker-hdl
     1948         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1949     END PROCEDURE.
     1950   PROCEDURE init-object :
     1951     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1952     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1953     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1954     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1955     RUN broker-init-object IN adm-broker-hdl
     1956         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1957          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     1958     RETURN.
     1959   END PROCEDURE.
     1960   PROCEDURE init-pages :
     1961     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1962     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1963         INPUT p-page-list) NO-ERROR.
     1964     END PROCEDURE.
     1965   PROCEDURE select-page :
     1966     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1967     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1968         INPUT p-page#) NO-ERROR.
     1969     END PROCEDURE.
     1970   PROCEDURE view-page :
     1971     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1972     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1973         INPUT p-page#).
     1974     END PROCEDURE.
     1975   ASSIGN
     1976          FRAME D-Dialog:SCROLLABLE       = FALSE
     1977          FRAME D-Dialog:HIDDEN           = TRUE.
     1978   ON WINDOW-CLOSE OF FRAME D-Dialog
     1979   DO:
     1980     APPLY "END-ERROR":U TO SELF.
     1981   END.
     1982   ON CHOOSE OF B-exit IN FRAME D-Dialog
     1983   DO:
     1984     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
     1985     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1986   END.
     1987   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1988   on help of frame D-Dialog
     1989   do:
     1990     run gbl/app_help.p
     1991       (input this-procedure :file-name
     1992       ,input ''
     1993       ,input ?
     1994       ) no-error.
     1995     if error-status :error then do:
     1996       message
     1997         "Ошибка при вызове помощи"
     1998         error-status :get-message(1)
     1999         view-as alert-box .
     2000     end.
     2001   end.
     2002   run minbtn-set in this-procedure .
     2003   on choose of b-help in frame D-Dialog
     2004   do:
     2005     apply "help":u to frame D-Dialog .
     2006   end.
     2007   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2008   procedure minbtn-set :
     2009       do
     2010           on error undo, return error return-value
     2011           :
     2012           define variable ii              as integer       no-undo .
     2013           define variable fh              as widget-handle no-undo .
     2014           define variable hh              as widget-handle no-undo .
     2015           define variable v-h             as handle        extent 4 no-undo .
     2016           define variable v-name-button   as character     no-undo .
     2017           define variable v-help-old-x    as decimal       no-undo .
     2018           define variable v-help-old-y    as decimal       no-undo .
     2019           define variable v-help-old-size as decimal       no-undo .
     2020           define variable v-frame-width   as decimal       no-undo .
     2021           define variable jj              as integer       no-undo .
     2022           do
     2023               on error undo, return error
     2024               :
     2025               assign
     2026                   v-frame-width = frame D-Dialog:width - 0.3
     2027                   fh            = frame D-Dialog:first-child
     2028                   hh            = fh:first-child
     2029                   ii            = 1
     2030                   .
     2031               do while valid-handle(hh):
     2032                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2033                   do:
     2034                       case lc(hh:name) :
     2035                           when "b-help" then
     2036                               do:
     2037                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2038                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2039                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2040                                   hh:TOOLTIP = "Помощь" .
     2041                                   v-help-old-x = hh:column .
     2042                                   v-help-old-y = hh:row    .
     2043                                   v-help-old-size = hh:width .
     2044                                   hh:width-chars = 2.5 .
     2045                               end.
     2046                           when "b-print" then
     2047                               do:
     2048                                   hh:load-image("cmp/b-print.bmp":u) .
     2049                                   hh:TOOLTIP = "Печать" .
     2050                                   v-h[ii] = hh:handle .
     2051                                   ii = ii + 1 .
     2052                                   hh:width-chars = 3 .
     2053                               end.
     2054                           when "b-history" or
     2055                           when "b-hist" then
     2056                               do:
     2057                                   hh:load-image("cmp/b-hist.bmp":u) .
     2058                                   hh:TOOLTIP = "История" .
     2059                                   v-h[ii] = hh:handle .
     2060                                   ii = ii + 1 .
     2061                                   hh:width-chars = 3 .
     2062                               end.
     2063                           when "b-sch" then
     2064                               do:
     2065                                   hh:load-image("cmp/b-sch.bmp":u) .
     2066                                   hh:TOOLTIP = "Установка Фильтра" .
     2067                                   v-h[ii] = hh:handle .
     2068                                   ii = ii + 1 .
     2069                                   hh:width-chars = 3 .
     2070                               end.
     2071                           when "b-hist-user" then
     2072                               do:
     2073                                   hh:load-image("cmp/b-hist.bmp":u) .
     2074                                   hh:TOOLTIP = "История пользователя" .
     2075                                   ii = ii + 1 .
     2076                               end.
     2077                       end case.
     2078                   end.
     2079                   hh = hh:next-sibling.
     2080               end.
     2081               b-help:column = v-frame-width - b-help:width-chars.
     2082               jj = 0.
     2083               repeat ii = 4 to 1 by -1 :
     2084                   if valid-handle (v-h[ii] ) then
     2085                   do:
     2086                       jj  = jj + 1 .
     2087                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2088                       v-h[ii]:row    = v-help-old-y .
     2089                   end.
     2090               end.
     2091           end.
     2092       end.
     2093   end procedure.
     2094   IF THIS-PROCEDURE:PERSISTENT THEN DO:
     2095       MESSAGE "A SmartDialog is not intended ":U SKIP
     2096               "to be run Persistent or to be placed ":U SKIP
     2097               "in another SmartObject at UIB design time.":U
     2098               VIEW-AS ALERT-BOX ERROR.
     2099       RUN disable_UI.
     2100       DELETE PROCEDURE THIS-PROCEDURE.
     2101       RETURN.
     2102   END.
     2103   RUN dispatch ('create-objects':U).
     2104   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME D-Dialog:PARENT eq ?
     2105   THEN FRAME D-Dialog:PARENT = ACTIVE-WINDOW.
     2106   MAIN-BLOCK:
     2107   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2108      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2109     RUN dispatch IN THIS-PROCEDURE ('initialize':U).
     2110     WAIT-FOR GO OF FRAME D-Dialog.
     2111   END.
     2112   RUN dispatch IN THIS-PROCEDURE ('destroy':U).
     2113   run fill-widgets in this-procedure no-error.
     2114   if error-status:error then undo, return error.
     2115   PROCEDURE adm-create-objects :
     2116     DEFINE VARIABLE adm-current-page  AS INTEGER NO-UNDO.
     2117     RUN get-attribute IN THIS-PROCEDURE ('Current-Page':U).
     2118     ASSIGN adm-current-page = INTEGER(RETURN-VALUE).
     2119     CASE adm-current-page:
     2120       WHEN 0 THEN DO:
     2121          RUN init-object IN THIS-PROCEDURE (
     2122                INPUT  'adm/objects/folder.w':U ,
     2123                INPUT  FRAME D-Dialog:HANDLE ,
     2124                INPUT  'FOLDER-LABELS = ':U + 'Часть1|Часть2' + ',
     2125                        FOLDER-TAB-TYPE = 1':U ,
     2126                OUTPUT h_folder ).
     2127          RUN set-position IN h_folder ( 2.25 , 1.00 ) NO-ERROR.
     2128          RUN set-size IN h_folder ( 28.75 , 120.00 ) NO-ERROR.
     2129          RUN add-link IN adm-broker-hdl ( h_folder , 'Page':U , THIS-PROCEDURE ).
     2130          RUN adjust-tab-order IN adm-broker-hdl ( h_folder ,
     2131                B-Help:HANDLE , 'AFTER':U ).
     2132       END.
     2133       WHEN 1 THEN DO:
     2134          RUN init-object IN THIS-PROCEDURE (
     2135                INPUT  'adm/shattrpt-pt1.w':U ,
     2136                INPUT  FRAME D-Dialog:HANDLE ,
     2137                INPUT  'Layout = ':U ,
     2138                OUTPUT h_part1 ).
     2139          RUN set-position IN h_part1 ( 3.50 , 1.50 ) NO-ERROR.
     2140          RUN add-link IN adm-broker-hdl ( THIS-PROCEDURE , 'Record':U , h_part1 ).
     2141          RUN adjust-tab-order IN adm-broker-hdl ( h_part1 ,
     2142                h_folder , 'AFTER':U ).
     2143          mChkPart1 = yes.
     2144          RUN PartOne-Init in h_part1 (parparentproc, p-mode, p-obj-type, p-obj-code, input table-handle v-tempth).
     2145       END.
     2146       WHEN 2 THEN DO:
     2147          RUN init-object IN THIS-PROCEDURE (
     2148                INPUT  'adm/shattrpt-pt2.w':U ,
     2149                INPUT  FRAME D-Dialog:HANDLE ,
     2150                INPUT  'Layout = ':U ,
     2151                OUTPUT h_part2 ).
     2152          RUN set-position IN h_part2 ( 3.50 , 1.50 ) NO-ERROR.
     2153          RUN add-link IN adm-broker-hdl ( THIS-PROCEDURE , 'Record':U , h_part2 ).
     2154          RUN adjust-tab-order IN adm-broker-hdl ( h_part2 ,
     2155                h_folder , 'AFTER':U ).
     2156          mChkPart2 = yes.
     2157          RUN PartTwo-Init in h_part2 (parparentproc, p-mode, p-obj-type, p-obj-code, input table-handle v-tempth).
     2158       END.
     2159     END CASE.
     2160     IF adm-current-page eq 0
     2161     THEN do:
     2162        run fill-temp-thbj-attr in this-procedure no-error.
     2163        run proc-open in this-procedure no-error.
     2164        RUN select-page IN THIS-PROCEDURE ( 1 ).
     2165     END.
     2166   END PROCEDURE.
     2167   PROCEDURE adm-row-available :
     2168     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     2169     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     2170     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     2171     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     2172     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     2173     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     2174     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     2175     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     2176     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     2177     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     2178     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     2179     IF adm-updating-record THEN RETURN.
     2180     RUN get-attribute ('FIELDS-ENABLED':U).
     2181     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     2182     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     2183         OUTPUT link-handle) NO-ERROR.
     2184     IF link-handle = "":U THEN
     2185         RETURN.
     2186     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     2187     IF NUM-ENTRIES(link-handle) > 1 THEN
     2188         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     2189             "encountered more than one RECORD-SOURCE.":U SKIP
     2190             "The first - ":U record-source-hdl:file-name " - will be used.":U
     2191                VIEW-AS ALERT-BOX ERROR.
     2192     RUN get-attribute ('Key-Name':U).
     2193     key-name = RETURN-VALUE.
     2194     IF key-name = "":U THEN key-name = ?.
     2195     IF key-name NE ? THEN DO:
     2196       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     2197         NO-ERROR.
     2198       IF key-value NE ? THEN
     2199         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     2200     END.
     2201   IF VALID-HANDLE (adm-object-hdl) THEN
     2202       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     2203   RUN notify IN THIS-PROCEDURE ('row-available':U).
     2204   END PROCEDURE.
     2205   PROCEDURE disable_UI :
     2206     HIDE FRAME D-Dialog.
     2207   END PROCEDURE.
     2208   PROCEDURE enable_UI :
     2209     if p-mode = 'ПРОСМОТР':U then do:
     2210       disable
     2211         B-exit
     2212         with frame D-Dialog .
     2213       run disable-all in h_part1.
     2214     end.
     2215     else
     2216     ENABLE B-exit b-quit B-Help
     2217         WITH FRAME D-Dialog.
     2218     VIEW FRAME D-Dialog.
     2219   END PROCEDURE.
     2220   PROCEDURE fill-temp-thbj-attr :
     2221   define variable v-param-type      as character  no-undo .
     2222   define variable v-value-character as character  no-undo .
     2223   define variable v-value-date      as date       no-undo .
     2224   define variable v-value-decimal   as decimal    no-undo .
     2225   define variable v-value-integer   as integer    no-undo .
     2226   define variable v-value-logical   as logical    no-undo .
     2227   define variable v-entry           as character  no-undo .
     2228   do
     2229   on error undo, return error return-value
     2230   :
     2231     assign
     2232       v-tth = buffer thbjattr_thbj-attr:table-handle
     2233       v-tempth = buffer temp-thbj-attr:table-handle
     2234     .
     2235     for each thbjattr_thbj-attr
     2236     :
     2237       delete thbjattr_thbj-attr .
     2238     end.
     2239     for each temp-thbj-attr
     2240     :
     2241       delete temp-thbj-attr .
     2242     end.
     2243     run adm/shattri.p
     2244       ( input "init":U
     2245       , input p-obj-type
     2246       , input p-obj-code
     2247       , input 'petrol':U
     2248       , input "":U
     2249       , output v-value-character
     2250       , output v-value-date
     2251       , output v-value-decimal
     2252       , output v-value-integer
     2253       , output v-value-logical
     2254       , output v-param-type
     2255       , input-output table-handle v-tth
     2256       ) no-error .
     2257     if error-status:error
     2258       and not available locked_thbj-attr
     2259     then do:
     2260       message
     2261       "Не удалось получить начальные значения настроек" skip
     2262       error-status:get-message(1) return-value
     2263       view-as alert-box error .
     2264       undo, return error .
     2265     end.
     2266     for each thbjattr_thbj-attr:
     2267       create temp-thbj-attr.
     2268       buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     2269     end.
     2270   end.
     2271   END PROCEDURE.
     2272   PROCEDURE fill-widgets :
     2273   END PROCEDURE.
     2274   PROCEDURE proc-open :
     2275     define buffer buf_shop    for ub.shop .
     2276     define buffer buf_store   for ub.store .
     2277     define buffer buf_sysconf for ub.sysconf .
     2278     define buffer buf_clients for ub.clients .
     2279   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2280     run mainmenu_getcntxt in parparentproc
     2281       (output v-cntxt-db-num
     2282       ,output v-cntxt-userid
     2283       ,output v-cntxt-level
     2284       ,output v-cntxt-host-code-obj
     2285       ,output v-cntxt-obj-type
     2286       ,output v-cntxt-obj-code
     2287       ,output v-cntxt-db-num-obj
     2288       ,output v-cntxt-is-admin
     2289       ) .
     2290     if p-mode <> 'ПРОСМОТР':U
     2291       and p-mode <> 'ИЗМЕНЕНИЕ':U
     2292     then do:
     2293       message
     2294       vss-workfile vss-revision vss-description skip
     2295       "Неверное значение параметра p-mode" p-mode
     2296       view-as alert-box error.
     2297       undo, return error.
     2298     end.
     2299     if p-obj-type <> 'маг':U
     2300       and p-obj-type <> 'скл':U
     2301       and p-obj-type <> 'орг':U
     2302       and p-obj-type <> '':U
     2303     then do:
     2304         message
     2305           vss-workfile vss-revision vss-description skip
     2306           "Неверное значение параметра p-obj-type" p-obj-type
     2307           view-as alert-box error.
     2308         undo, return error.
     2309     end.
     2310     case p-obj-type :
     2311       when 'маг':U then do:
     2312         find first buf_shop no-lock
     2313           where buf_shop.obj-code = p-obj-code
     2314           no-error.
     2315         if not available buf_shop then do:
     2316           message
     2317             vss-workfile vss-revision vss-description skip
     2318             substitute( "Неверное значение параметра p-obj-code" ) skip
     2319             substitute( "Магазин с кодом &1 не найден", p-obj-code ) skip
     2320             view-as alert-box error.
     2321           undo, return error.
     2322         end.
     2323       end.
     2324       when 'скл':U then do:
     2325         find first buf_store no-lock
     2326           where buf_store.obj-code = p-obj-code
     2327           no-error.
     2328         if not available buf_store then do:
     2329           message
     2330             vss-workfile vss-revision vss-description skip
     2331             substitute( "Неверное значение параметра p-obj-code" ) skip
     2332             substitute( "Склад с кодом &1 не найден", p-obj-code ) skip
     2333             view-as alert-box error.
     2334           undo, return error.
     2335         end.
     2336       end.
     2337       when 'орг':U then do:
     2338         find first buf_sysconf no-lock
     2339           where buf_sysconf.host-code = p-obj-code
     2340           no-error.
     2341         if not available buf_sysconf then do:
     2342           message
     2343             vss-workfile vss-revision vss-description skip
     2344             substitute( "Неверное значение параметра p-obj-code" ) skip
     2345             substitute( "Фирма с кодом &1 не найдена", p-obj-code ) skip
     2346             view-as alert-box error.
     2347           undo, return error.
     2348         end.
     2349       end.
     2350     end case.
     2351     if p-mode <> 'ПРОСМОТР':U
     2352       and v-cntxt-db-num <> 0
     2353     then do:
     2354       case trim( p-obj-type ) :
     2355         when '':U then do:
     2356           message
     2357             "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" Skip
     2358             view-as alert-box error.
     2359           undo, return error.
     2360         end.
     2361         when 'маг':U
     2362         or when 'скл':U
     2363         then do:
     2364   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2365   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2366     (input  p-obj-type
     2367     ,input  p-obj-code
     2368     ,output v-db-num
     2369     )  .
     2370           if v-db-num <> v-cntxt-db-num then do:
     2371             message
     2372               "Нельзя менять параметры объекта в чужой БД" skip
     2373               "объект принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     2374               view-as alert-box error.
     2375             undo, return error.
     2376           end.
     2377         end.
     2378         when 'орг':U then do:
     2379           message
     2380             "Нельзя менять параметры ФИРМЫ в УБД" Skip
     2381             view-as alert-box error.
     2382           undo, return error.
     2383         end.
     2384       end case.
     2385     end.
     2386     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     2387       find first locked_thbj-attr exclusive-lock
     2388         where locked_thbj-attr.obj-type = p-obj-type
     2389           and locked_thbj-attr.obj-code = p-obj-code
     2390           and locked_thbj-attr.upper-prop-code = 'petrol':U
     2391           and locked_thbj-attr.prop-code = "":u
     2392       no-wait no-error.
     2393       if locked locked_thbj-attr then do:
     2394         message
     2395           vss-workfile vss-revision vss-description skip
     2396           "Запись ПАРАМЕТРЫ(АТРИБУТЫ) занята"
     2397         view-as alert-box error .
     2398         undo, return error.
     2399       end.
     2400     end.
     2401     else do:
     2402       find first locked_thbj-attr no-lock
     2403         where locked_thbj-attr.obj-type = p-obj-type
     2404           and locked_thbj-attr.obj-code = p-obj-code
     2405           and locked_thbj-attr.upper-prop-code = 'petrol':U
     2406           and locked_thbj-attr.prop-code = '':u
     2407         no-error.
     2408     end.
     2409     if not available locked_thbj-attr then do:
     2410       assign
     2411         v-to-create  = yes
     2412       .
     2413       message
     2414         substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ", chr(10) )
     2415       view-as alert-box WARNING.
     2416     end.
     2417   END PROCEDURE.
     2418   PROCEDURE proc-save :
     2419   define variable v-value-character as character      no-undo .
     2420   define variable v-value-date      as date           no-undo .
     2421   define variable v-value-decimal   as decimal        no-undo .
     2422   define variable v-value-integer   as integer        no-undo .
     2423   define variable v-value-logical   as logical        no-undo .
     2424   define variable v-sale-add        as character      no-undo .
     2425   define variable v-param-type      as character      no-undo .
     2426   define variable wh                as widget-handle  no-undo .
     2427   define variable fh                as widget-handle  no-undo .
     2428   define variable v-same            as logical        no-undo .
     2429   define variable v-change-temp     as logical        no-undo .
     2430   define variable v-change-volume   as logical        no-undo .
     2431   define variable v-change-density  as logical        no-undo .
     2432   define variable v-change-water    as logical        no-undo .
     2433   define variable v-change-param    as character      no-undo .
     2434   define variable v-vid-param       as longchar       no-undo .
     2435   define variable v-vid-action           as integer   no-undo .
     2436   define variable v-computer-name        as character no-undo .
     2437   define variable v-computer-tcp-name    as character no-undo .
     2438   define variable v-computer-ip-addr     as character no-undo .
     2439   define variable v-computer-login-name  as character no-undo .
     2440   define variable v-computer-process-pid as integer   no-undo .
     2441   define variable v-date                 as character no-undo .
     2442   define variable v-time                 as character no-undo .
     2443   define buffer buf_clients for ub.clients .
     2444   do
     2445   on error undo, return error return-value
     2446   :
     2447     if p-mode = 'ПРОСМОТР':U then do:
     2448       return error.
     2449     end.
     2450     for each temp-thbj-attr:
     2451         delete temp-thbj-attr.
     2452     end.
     2453     if mChkPart1 then
     2454        RUN PartOne-Get in h_part1 (output table-handle v-tempth).
     2455     if mChkPart2 then do:
     2456        RUN PartTwo-Get in h_part2 (input-output table-handle v-tempth).
     2457     end.
     2458     assign
     2459       v-same = yes
     2460     .
     2461     for each thbjattr_thbj-attr,
     2462         first temp-thbj-attr
     2463           where temp-thbj-attr.obj-type         = thbjattr_thbj-attr.obj-type
     2464             and temp-thbj-attr.obj-code         = thbjattr_thbj-attr.obj-code
     2465             and temp-thbj-attr.upper-prop-code  = thbjattr_thbj-attr.upper-prop-code
     2466             and temp-thbj-attr.prop-code        = thbjattr_thbj-attr.prop-code
     2467     :
     2468       buffer-compare thbjattr_thbj-attr to temp-thbj-attr save result in v-same.
     2469       if v-same = false then do:
     2470         leave.
     2471       end.
     2472     end.
     2473     if v-same = true
     2474       and v-to-create = false
     2475     then do:
     2476       return.
     2477     end.
     2478     for each thbjattr_thbj-attr:
     2479       find first temp-thbj-attr
     2480           where temp-thbj-attr.obj-type         = thbjattr_thbj-attr.obj-type
     2481             and temp-thbj-attr.obj-code         = thbjattr_thbj-attr.obj-code
     2482             and temp-thbj-attr.upper-prop-code  = thbjattr_thbj-attr.upper-prop-code
     2483             and temp-thbj-attr.prop-code        = thbjattr_thbj-attr.prop-code
     2484       no-error.
     2485       if not avail temp-thbj-attr then
     2486       do:
     2487           create temp-thbj-attr.
     2488           buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     2489       end.
     2490     end.
     2491     run adm/shattri.p
     2492       ( input "check":U
     2493       , input p-obj-type
     2494       , input p-obj-code
     2495       , input 'petrol':U
     2496       , INPUT '':U
     2497       , output v-value-character
     2498       , output v-value-date
     2499       , output v-value-decimal
     2500       , output v-value-integer
     2501       , output v-value-logical
     2502       , output v-param-type
     2503       , input-output table-handle v-tempth
     2504       ) no-error .
     2505     if error-status :error then do:
     2506       message
     2507         "Некорректное значение ПАРАМЕТРОВ"  skip
     2508         error-status:get-message(1)         skip
     2509         return-value
     2510       view-as alert-box error .
     2511       undo, return error .
     2512     end.
     2513     run thbjattr_set-section in this-procedure
     2514       ( input p-obj-type
     2515       , input p-obj-code
     2516       , input 'petrol':U
     2517       , input table temp-thbj-attr
     2518       ) no-error.
     2519     if error-status:error then do:
     2520       message
     2521         error-status:get-message(1)  skip
     2522         return-value
     2523       view-as alert-box.
     2524       undo, return error.
     2525     end.
     2526     for each thbjattr_thbj-attr no-lock,
     2527        first temp-thbj-attr
     2528           where temp-thbj-attr.obj-type         = thbjattr_thbj-attr.obj-type
     2529             and temp-thbj-attr.obj-code         = thbjattr_thbj-attr.obj-code
     2530             and temp-thbj-attr.upper-prop-code  = thbjattr_thbj-attr.upper-prop-code
     2531             and temp-thbj-attr.prop-code        = thbjattr_thbj-attr.prop-code:
     2532       v-change-param = "" .
     2533       case thbjattr_thbj-attr.prop-code:
     2534         when 'otkl-fact-volue':U then
     2535           do:
     2536             if temp-thbj-attr.property-value-decimal <> thbjattr_thbj-attr.property-value-decimal then
     2537             do:
     2538               v-change-param = "IDParam="  + "otkl-fact-volume" + chr(4) +
     2539                 "NameParam=" + "Макс.допустимое значение фактического объема" + chr(4) +
     2540                 "ParamBefore=" + string(thbjattr_thbj-attr.property-value-decimal) + chr(4) +
     2541                 "ParamAfter=" + string(temp-thbj-attr.property-value-decimal) no-error.
     2542             end.
     2543           end.
     2544         when 'otkl-temp':U then
     2545           do:
     2546             if temp-thbj-attr.property-value-decimal <> thbjattr_thbj-attr.property-value-decimal then
     2547             do:
     2548               v-change-param = "IDParam="  + "otkl-temp" + chr(4) +
     2549                 "NameParam=" + "Макс.допустимое значение температуры" + chr(4) +
     2550                 "ParamBefore=" + string(thbjattr_thbj-attr.property-value-decimal) + chr(4) +
     2551                 "ParamAfter=" + string(temp-thbj-attr.property-value-decimal) no-error.
     2552             end.
     2553           end.
     2554         when 'otkl-density':U then
     2555           do:
     2556             if temp-thbj-attr.property-value-character <> thbjattr_thbj-attr.property-value-character then
     2557             do:
     2558               v-change-param = "IDParam="  + "otkl-density" + chr(4) +
     2559                 "NameParam=" + "Макс.допустимое значение плотности" + chr(4) +
     2560                 "ParamBefore=" + string(thbjattr_thbj-attr.property-value-character) + chr(4) +
     2561                 "ParamAfter=" + string(temp-thbj-attr.property-value-character) no-error.
     2562             end.
     2563           end.
     2564         when 'otkl-water':U then
     2565           do:
     2566             if temp-thbj-attr.property-value-decimal <> thbjattr_thbj-attr.property-value-decimal then
     2567             do:
     2568               v-change-param = "IDParam="  + "otkl-water" + chr(4) +
     2569                 "NameParam=" + "Макс.допустимое значение воды" + chr(4) +
     2570                 "ParamBefore=" + string(thbjattr_thbj-attr.property-value-decimal) + chr(4) +
     2571                 "ParamAfter=" + string(temp-thbj-attr.property-value-decimal) no-error.
     2572             end.
     2573           end.
     2574       end.
     2575       if v-change-param <> "" then
     2576       do:
     2577         define variable v-time-hour    as integer   no-undo .
     2578         define variable v-time-min     as integer   no-undo .
     2579         define variable v-nik          as character no-undo .
     2580         define variable v-name         as character no-undo .
     2581         define variable v-cntxt-userid as character no-undo .
     2582         run get-userid in parparentproc ( output v-cntxt-userid) .
     2583         find first ub.user-account no-lock where ub.user-account.user-id = v-cntxt-userid no-error .
     2584         if available (ub.user-account) then
     2585         do:
     2586           assign
     2587             v-nik  = ub.user-account.nik
     2588             v-name = ub.user-account.last-name + " " + ub.user-account.first-name
     2589             .
     2590         end.
     2591         run cur-time in this-procedure ( output v-date, output v-time).
     2592         v-time-hour = truncate(integer(v-time) / 3600, 0).
     2593         v-time-min  = (integer(v-time) - (v-time-hour * 3600)) / 60 .
     2594         run sys-time_get-comp-user-name in this-procedure
     2595           (output v-computer-name
     2596           ,output v-computer-login-name
     2597           ,output v-computer-process-pid
     2598           ) .
     2599         v-vid-action = 66 .
     2600   define variable v-initiator  as character no-undo.
     2601   case true:
     2602     when g#auto then v-initiator = "Auto".
     2603     when g#news then v-initiator = "Nws".
     2604     when g#esys then v-initiator = "Esys".
     2605     otherwise v-initiator = "User".
     2606   end case.
     2607         v-vid-param =
     2608           "UniqueIdRecordARM=" + v-initiator + chr(4) +
     2609           "UserName=" + v-name + chr(4) +
     2610           "UserNik=" + v-nik + chr(4) +
     2611           "NumShop=" + string(temp-thbj-attr.obj-code) + chr(4) + v-change-param
     2612           no-error.
     2613         run trg/userlog.p (
     2614           input 'update':U
     2615           , input 'thbj-attr':U
     2616           , input ( buffer thbjattr_thbj-attr :handle )
     2617           , input v-vid-action
     2618           , input v-vid-param
     2619           ) no-error.
     2620         if error-status :error
     2621           then
     2622         do:
     2623           return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
     2624             , chr(10)
     2625             , vss-workfile
     2626             , return-value
     2627             , error-status :get-message ( 1 ) ).
     2628         end.
     2629       end.
     2630     end.
     2631   end.
     2632   END PROCEDURE.
     2633   PROCEDURE send-records :
     2634   END PROCEDURE.
     2635   PROCEDURE state-changed :
     2636     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     2637     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     2638   END PROCEDURE.
