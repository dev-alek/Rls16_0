      608   procedure thbjattr_code :
      609      define input  parameter p-upper-code     as character no-undo .
      610      define input  parameter p-code           as character no-undo .
      611      define output parameter p-label          as character no-undo .
      612      define output parameter p-user-can-edit  as logical   no-undo .
      613      define output parameter p-output-display as logical   no-undo .
      614      define output parameter p-other          as character no-undo .
      615      define output parameter p-prop-list      as character no-undo .
      616      define output parameter p-prop-type-list as character no-undo .
      617      define output parameter p-prop-label-list as character no-undo .
      618      define output parameter p-global          as logical no-undo .
      619      define output parameter p-host           as logical no-undo .
      620      define output parameter p-shop           as logical no-undo .
      621      define output parameter p-store          as logical no-undo .
      622      define output parameter p-db             as logical no-undo .
      623      define variable p-region as logical no-undo.
      624      run thbjattr_code_reg in this-procedure (
      625                                               p-upper-code,
      626                                               p-code,
      627                                               output p-label,
      628                                               output p-user-can-edit,
      629                                               output p-output-display,
      630                                               output p-other,
      631                                               output p-prop-list,
      632                                               output p-prop-type-list,
      633                                               output p-prop-label-list,
      634                                               output p-global,
      635                                               output p-host,
      636                                               output p-shop,
      637                                               output p-store,
      638                                               output p-db,
      639                                               output p-region
      640                                               ).
      641   end procedure.
      642   procedure thbjattr_code_reg :
      643   define input  parameter p-upper-code     as character no-undo .
      644   define input  parameter p-code           as character no-undo .
      645   define output parameter p-label          as character no-undo .
      646   define output parameter p-user-can-edit  as logical   no-undo .
      647   define output parameter p-output-display as logical   no-undo .
      648   define output parameter p-other          as character no-undo .
      649   define output parameter p-prop-list      as character no-undo .
      650   define output parameter p-prop-type-list as character no-undo .
      651   define output parameter p-prop-label-list as character no-undo .
      652   define output parameter p-global          as logical no-undo .
      653   define output parameter p-host           as logical no-undo .
      654   define output parameter p-shop           as logical no-undo .
      655   define output parameter p-store          as logical no-undo .
      656   define output parameter p-db             as logical no-undo .
      657   define output parameter p-region         as logical no-undo .
      658   do
      659   on error undo, return error return-value
      660   :
      661       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      662       (input  p-upper-code
      663       ,input  p-code
      664       ,output p-label
      665       ,output p-user-can-edit
      666       ,output p-output-display
      667       ,output p-other
      668       ,output p-prop-list
      669       ,output p-prop-type-list
      670       ,output p-prop-label-list
      671       ,output p-global
      672       ,output p-host
      673       ,output p-shop
      674       ,output p-store
      675       ,output p-db
      676       ,output p-region
      677       ) no-error .
      678     if error-status :error
      679     then do:
      680       undo, return error substitute( "&1. &2&3&4", vss-include-info2, return-value, chr(10), error-status :get-message (1)).
      681     end.
      682   end.
      683   end procedure.
