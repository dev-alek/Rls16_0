      899   procedure proc-alt-shift-f3:
      900     run gbl/prvssinf.p
      901       ( input this-procedure
      902       ) .
      903   end.
      904   define variable v-inform-launched as logical no-undo initial false .
      905   procedure proc-alt-shift-f4:
      906     define variable v-action as character no-undo .
      907     if v-inform-launched = false then do:
      908       assign
      909         v-inform-launched = true
      910       .
      911       run gbl/d-inform.w
      912         (  input self
      913         ,  input this-procedure
      914         , output v-action
      915         ) no-error .
      916       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      917       assign
      918         v-inform-launched = false
      919       .
      920     end.
      921   end.
      922   procedure proc-alt-f1:
      923     run gbl/corrhelp.p
      924       (input this-procedure
      925       ) .
      926   end .
      927   on alt-shift-f2 anywhere do:
      928     run proc-alt-shift-f2.
      929   end.
      930   on alt-shift-f3 anywhere do:
      931     run proc-alt-shift-f3 in this-procedure .
      932   end.
      933   on alt-shift-f4 anywhere do:
      934     run proc-alt-shift-f4 in this-procedure.
      935   end.
      936   on alt-f1 anywhere do:
      937     run proc-alt-f1 in this-procedure .
      938   end.
      939   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      940     define variable v-cntxt-db-num        as integer   no-undo .
      941     define variable v-cntxt-userid        as character no-undo .
      942     define variable v-cntxt-level         as character no-undo .
      943     define variable v-cntxt-host-code-obj as integer   no-undo .
      944     define variable v-cntxt-obj-type      as character no-undo .
      945     define variable v-cntxt-obj-code      as integer   no-undo .
      946     define variable v-cntxt-db-num-obj    as integer   no-undo .
      947     define variable v-cntxt-is-admin      as logical   no-undo .
      948   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      949   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      950   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      951   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      952   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
