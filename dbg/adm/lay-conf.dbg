        1   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Конфигурация раскладок".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#library  as handle no-undo .
       63   define new global shared variable g#library2 as handle no-undo .
       64   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       65   define variable v-waitfram-action01         as character   no-undo .
       66   define variable v-waitfram-action02         as character   no-undo .
       67   define variable v-waitfram-action03         as character   no-undo .
       68   define variable mWaitFramTextBeg            as character   no-undo.
       69   define variable mWaitFramTextEnd            as character   no-undo.
       70   define variable mWaitFramView               as logical     no-undo.
       71   define variable mWaitProcEvent              as logical     no-undo init yes.
       72   define variable mWaitFramInterval           as integer     no-undo init 1 .
       73   define variable mWaitFramStop               as logical     no-undo.
       74   define variable mWaitFramStopUser           as logical     no-undo.
       75   define variable mWaitFramStopTimeOut        as logical     no-undo.
       76   define variable mWaitFramStartProc          as datetime-tz no-undo.
       77   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       78   define button B-WaitFramStop auto-end-key
       79        label "Стоп"
       80        size 10 by 1 tooltip "Остоновить процесс".
       81   define button B-viewProcInfo
       82        label "Информация"
       83        size 15 by 1 tooltip "Информация о процесс".
       84   define frame waitfram
       85     v-waitfram-action01 format "x(72)" no-label skip
       86     v-waitfram-action02 format "x(72)" no-label skip
       87     v-waitfram-action03 format "x(72)" no-label skip
       88     B-viewProcInfo
       89     B-WaitFramStop at row 4 col 30
       90     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       91     .
       92   define new global shared variable mBatchMode as logical no-undo init ?.
       93   define variable mFramBachModHandle as handle no-undo.
       94   mFramBachModHandle = frame waitfram:handle.
       95   define variable mFameOldVis as logical no-undo.
       96   define variable mVisCUrentVin as logical no-undo.
       97   if session:batch-mode
       98   then
       99      mBatchMode = yes.
      100   if mBatchMode = ? then do:
      101     mVisCUrentVin = current-window:visible.
      102     mFameOldVis = mFramBachModHandle:visible.
      103     mFramBachModHandle:visible  = yes.
      104     mBatchMode = mFramBachModHandle:visible ne yes.
      105     mFramBachModHandle:visible = mFameOldVis.
      106     current-window:visible = mVisCUrentVin.
      107   end.
      108    if  log-manager:logfile-name ne ?
      109     then DO:
      110         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      111         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      112         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      113     end.
      114   on choose of B-WaitFramStop in frame waitfram
      115   do:
      116     mWaitFramStop = yes.
      117     mWaitFramStopUser = yes.
      118   end.
      119   function waitfram-check-timeout returns logical():
      120      define variable vtime as int64 no-undo.
      121      if mWaitFramStopTimeOut
      122      then
      123         return yes.
      124      vtime = ( now - mWaitFramStartProc ) / 1000 .
      125      if     mWaitFramTimeOut ne ?
      126         and mWaitFramTimeOut ne 0
      127         and mWaitFramTimeOut lt vtime
      128      then do:
      129         mWaitFramStopTimeOut = yes.
      130      end.
      131      return mWaitFramStopTimeOut.
      132   end.
      133   procedure waitfram-hide :
      134     if not session:batch-mode
      135     then do
      136     on error undo, return error return-value
      137     :
      138       pause 0 before-hide .
      139       if not mBatchMode then
      140         hide frame waitfram .
      141     if     not mWaitFramView
      142        and mWaitProcEvent
      143     then
      144       process events .
      145     end.
      146   end procedure.
      147   procedure waitfram-show :
      148     define input  parameter p-message as character no-undo .
      149     define variable v-left-margin as integer   no-undo .
      150     if not session:batch-mode
      151     then do
      152     on error undo, return error return-value
      153     :
      154       if length(p-message) <= 70 then do:
      155         assign
      156           v-left-margin = integer((70 - length(p-message)) / 2)
      157         .
      158         assign
      159           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      160         .
      161         assign
      162           v-waitfram-action01 = " "
      163           v-waitfram-action02 = " "
      164                                    + fill(" ", v-left-margin)
      165                                    + p-message
      166           v-waitfram-action03 = " "
      167         .
      168       end.
      169       else do:
      170         define variable vRindex1 as integer no-undo.
      171         define variable vRindex2 as integer no-undo.
      172         vRindex1 = r-index(p-message," ",70).
      173         if vRindex1 = 0
      174         then
      175            vRindex1 = 70.
      176         if length(p-message)  <= vRindex1 + 70 then do:
      177           assign
      178             v-waitfram-action01 = " "
      179             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      180             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      181           .
      182         end.
      183         else do:
      184           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      185           if vRindex2 <= vRindex1
      186           then
      187              vRindex2 = vRindex1 + 70.
      188           assign
      189             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      190             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      191             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      192           .
      193         end.
      194       end.
      195       B-viewProcInfo:visible   in frame waitfram = no.
      196       B-viewProcInfo:sensitive in frame waitfram = no.
      197       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      198       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      199       if  (   mWaitFramView
      200          or  mWaitProcEvent)
      201          and not mBatchMode
      202       then
      203          display
      204             v-waitfram-action01 skip
      205             v-waitfram-action02 skip
      206             v-waitfram-action03 skip
      207          with frame waitfram .
      208       if     mWaitFramView
      209          then do:
      210             if     mWaitFramInterval ne ?
      211                and not mBatchMode
      212             then
      213                wait-for go of frame waitfram pause mWaitFramInterval.
      214          end.
      215          else
      216             if     mWaitProcEvent
      217                and not mBatchMode
      218             then
      219                process events .
      220     end.
      221   end procedure.
      222      procedure waitfram-show-this:
      223         define input  parameter iInterval as int64 no-undo.
      224         define variable vtime as int64 no-undo.
      225         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      226         mWaitFramInterval = iInterval.
      227         run waitfram-show (substitute("&1&2 &3&4" ,
      228                                       mWaitFramTextBeg ,
      229                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      230                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      231                                       mWaitFramTextEnd
      232                                      )
      233                           ).
      234      end.
      235      procedure WaitFramRunPause:
      236         define input  parameter iInterval as dec no-undo.
      237         define variable vStart  as datetime-tz no-undo.
      238         define variable vend    as datetime-tz no-undo.
      239         define variable vint as int64 no-undo.
      240         define variable vOk as logical no-undo.
      241         vStart = now.
      242         vend   = vStart.
      243         publish "WaitFramPause" (iInterval,output vOk).
      244         vend   =  now.
      245         vint = vend - vStart.
      246         vint = iInterval - vint / 1000.
      247         if     not mWaitFramStop
      248            and (   vint > 0
      249                 or (    not vOk
      250                     and iInterval eq ?
      251                     )
      252                 )
      253         then
      254            run waitfram-show-this (iInterval).
      255         vend   =  now.
      256         vint = vend - vStart.
      257         vint = iInterval - vint / 1000.
      258         if     not mWaitFramStop
      259            and vint > 0
      260         then do:
      261            run gbl/pause.p (vint * 1000).
      262         end.
      263         if iInterval ne ?
      264         then
      265            publish "WaitFramStop".
      266         waitfram-check-timeout().
      267      end.
      268      procedure WaitFramWaitFor:
      269         define input  parameter iInterval as dec no-undo.
      270         assign
      271            mWaitFramStartProc   = now
      272            mWaitFramStopUser    = no
      273            mWaitFramStopTimeOut = no
      274         .
      275         block-wait:
      276         do while not mWaitFramStop:
      277            run WaitFramRunPause (iInterval).
      278            if  waitfram-check-timeout()
      279            then do:
      280               leave block-wait.
      281            end.
      282         end.
      283         run waitfram-hide.
      284      end.
      285   procedure waitfram-join :
      286     define input  parameter p-line-1  as character no-undo .
      287     define input  parameter p-line-2  as character no-undo .
      288     define input  parameter p-line-3  as character no-undo .
      289     define output parameter p-message as character no-undo .
      290     do
      291     on error undo, return error return-value
      292     :
      293       assign
      294         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      295                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      296                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      297       .
      298     end.
      299   end procedure.
      300   function waitfram-join-function returns character
      301     (input p-line-1 as character
      302     ,input p-line-2 as character
      303     ,input p-line-3 as character
      304     ).
      305     define variable v-message as character no-undo .
      306     run waitfram-join in this-procedure
      307       (input  p-line-1
      308       ,input  p-line-2
      309       ,input  p-line-3
      310       ,output v-message
      311       ) .
      312     return v-message .
      313   end function .
      314   define new global shared variable g#language as character no-undo .
      315   if g#language <> '' and g#language <> 'rus':U then do:
      316     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      317   end.
      318   procedure proc-alt-shift-f2:
      319     if not ibs.th.gbl.gbl-var:rcode
      320   then
      321     run gbl\inidebug.p .
      322   end.
      323   procedure proc-alt-shift-f3:
      324     run gbl/prvssinf.p
      325       ( input this-procedure
      326       ) .
      327   end.
      328   define variable v-inform-launched as logical no-undo initial false .
      329   procedure proc-alt-shift-f4:
      330     define variable v-action as character no-undo .
      331     if v-inform-launched = false then do:
      332       assign
      333         v-inform-launched = true
      334       .
      335       run gbl/d-inform.w
      336         (  input self
      337         ,  input this-procedure
      338         , output v-action
      339         ) no-error .
      340       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      341       assign
      342         v-inform-launched = false
      343       .
      344     end.
      345   end.
      346   procedure proc-alt-f1:
      347     run gbl/corrhelp.p
      348       (input this-procedure
      349       ) .
      350   end .
      351   on alt-shift-f2 anywhere do:
      352     run proc-alt-shift-f2.
      353   end.
      354   on alt-shift-f3 anywhere do:
      355     run proc-alt-shift-f3 in this-procedure .
      356   end.
      357   on alt-shift-f4 anywhere do:
      358     run proc-alt-shift-f4 in this-procedure.
      359   end.
      360   on alt-f1 anywhere do:
      361     run proc-alt-f1 in this-procedure .
      362   end.
      363   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      364   procedure cur-time :
      365      define output parameter p-today as date      no-undo .
      366      define output parameter p-time  as integer   no-undo .
      367     do
      368     on error undo, return error
      369     :
      370       define variable v-date1 as date      no-undo .
      371       define variable v-date2 as date      no-undo .
      372       define variable v-time  as integer   no-undo .
      373       assign
      374         v-date1 = today
      375         v-time  = time
      376         v-date2 = today
      377       .
      378       if v-date1 <> v-date2
      379       then do:
      380         assign
      381           v-date1 = today
      382           v-time  = v-time
      383         .
      384       end.
      385       assign
      386         p-today = v-date1
      387         p-time  = v-time
      388       .
      389     end.
      390   end.
      391   function cur-time-date returns character
      392   :
      393     return string(today, '99/99/9999':U) .
      394   end.
      395   function cur-time-mjd returns decimal
      396   :
      397     define variable v-date as date      no-undo .
      398     define variable v-time as integer   no-undo .
      399     run cur-time in this-procedure
      400       (output v-date
      401       ,output v-time
      402       ) .
      403     return integer(v-date) - 2400002 + (v-time / 86400) .
      404   end.
      405   function cur-time-get-ending-index returns integer
      406   (input p-number as integer
      407   )
      408   :
      409     if p-number < 0
      410     or p-number = ?
      411     then do:
      412       return 1 .
      413     end.
      414     define variable v-rest as integer   no-undo .
      415     assign
      416       p-number = p-number modulo 100
      417     .
      418     if p-number < 20
      419     then do:
      420       assign
      421         v-rest = p-number
      422       .
      423     end.
      424     else do:
      425       assign
      426         v-rest = p-number modulo 10
      427       .
      428     end.
      429     case v-rest :
      430       when 1
      431       then do:
      432         return 2 .
      433       end.
      434       when 2 or
      435       when 3 or
      436       when 4
      437       then do:
      438         return 3 .
      439       end.
      440       otherwise do:
      441         return 1 .
      442       end.
      443     end case .
      444   end.
      445   procedure cur-time-mjd-to-date :
      446      define input  parameter i-mjd-diff as decimal no-undo.
      447      define output parameter o-Date     as date    no-undo.
      448      define output parameter o-Time     as integer no-undo.
      449      define variable v-day-number as integer   no-undo .
      450      if    i-mjd-diff < 0
      451         or i-mjd-diff = ?
      452      then do:
      453         return "?" .
      454      end.
      455      assign
      456         v-day-number = truncate(i-mjd-diff,0).
      457         o-Date = date(v-day-number + 2400002).
      458         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      459     .
      460   end.
      461   function cur-time-mjd-to-string returns character
      462   (input p-mjd-diff as decimal
      463   )
      464   :
      465     define variable v-day-number as integer   no-undo .
      466     define variable v-seconds    as integer   no-undo .
      467     define variable v-hour       as integer   no-undo .
      468     define variable v-min        as integer   no-undo .
      469     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      470     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      471     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      472     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      473     if p-mjd-diff < 0
      474     or p-mjd-diff = ?
      475     then do:
      476       return "?" .
      477     end.
      478     assign
      479       v-day-number = integer(truncate(p-mjd-diff,0))
      480       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      481     .
      482     if v-seconds > 86400
      483     then do:
      484       assign
      485         v-seconds = 86400 - 1
      486       .
      487     end.
      488     if v-seconds < 0
      489     then do:
      490       assign
      491         v-seconds = 0
      492       .
      493     end.
      494     assign
      495       v-hour = truncate(v-seconds / 3600, 0)
      496     .
      497     assign
      498       v-seconds = v-seconds modulo 3600
      499     .
      500     assign
      501       v-min = truncate(v-seconds / 60, 0)
      502     .
      503     assign
      504       v-seconds = v-seconds modulo 60
      505     .
      506     return
      507         (if v-day-number <> 0
      508           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      509           else ""
      510         )
      511       + (if v-day-number <> 0 or v-hour <> 0
      512           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      513           else ""
      514         )
      515       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      516           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      517           else ""
      518         )
      519       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      520       .
      521   end.
      522   function cur-time-string returns character
      523   :
      524     define variable v-date as date      no-undo .
      525     define variable v-time as integer   no-undo .
      526     run cur-time in this-procedure
      527       (output v-date
      528       ,output v-time
      529       ) .
      530     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      531   end.
      532   function cur-time-string-sec returns character
      533   :
      534     define variable v-date as date      no-undo .
      535     define variable v-time as integer   no-undo .
      536     run cur-time in this-procedure
      537       (output v-date
      538       ,output v-time
      539       ) .
      540     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      541   end.
      542   function cur-time-custom  returns character
      543   (input p-prefix as character
      544   ,input p-date-format as character
      545   ,input p-delimiter as character
      546   ,input p-time-format as character
      547   ,input p-suffix as character
      548   )
      549   :
      550     define variable v-date as date      no-undo .
      551     define variable v-time as integer   no-undo .
      552     run cur-time in this-procedure
      553       (output v-date
      554       ,output v-time
      555       ) .
      556     return
      557       p-prefix
      558       + string(v-date, p-date-format)
      559       + p-delimiter
      560       + string(v-time, p-time-format)
      561       + p-suffix
      562       .
      563   end.
      564   function cur-time-print  returns character
      565   :
      566     define variable v-date as date      no-undo .
      567     define variable v-time as integer   no-undo .
      568     run cur-time in this-procedure
      569       (output v-date
      570       ,output v-time
      571       ) .
      572     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      573   end.
      574   function cur-time-datetime returns datetime
      575   :
      576     define variable v-char as character no-undo .
      577     define variable v-datetime as datetime no-undo .
      578     v-char = cur-time-string().
      579     v-datetime = datetime(v-char).
      580     return  v-datetime.
      581   end.
      582   function cur-time-string-msec returns character
      583   :
      584     define variable v-date as datetime  no-undo .
      585     v-date = now.
      586     return string(v-date) .
      587   end.
      588   define variable v-layout-tables as character no-undo.
      589   define variable v-layout-table-names as character no-undo.
      590   define variable v-sys-key as character no-undo .
      591   define variable v-ibs as logical no-undo .
      592   define variable glog as logical no-undo .
      593   DEFINE BUFFER buf_file FOR dictdb._file.
      594   FUNCTION get-tbl-fname RETURNS CHARACTER ( INPUT p-tbl-name AS CHARACTER )  FORWARD.
      595   DEFINE BUTTON b-export
      596        LABEL "&Экспорт"
      597        SIZE 10 BY 1.
      598   DEFINE BUTTON B-Help
      599        LABEL "Помо&щь"
      600        SIZE 3 BY 1
      601        BGCOLOR 8 .
      602   DEFINE BUTTON b-import
      603        LABEL "&Импорт"
      604        SIZE 10 BY 1.
      605   DEFINE BUTTON b-quit AUTO-END-KEY
      606        LABEL "&Выход"
      607        SIZE 10 BY 1
      608        BGCOLOR 8 .
      609   DEFINE BUTTON B-sel
      610        LABEL "В&ыбор"
      611        SIZE 10 BY 1.
      612   DEFINE VARIABLE rs-language AS CHARACTER
      613        VIEW-AS RADIO-SET HORIZONTAL
      614        RADIO-BUTTONS
      615             "Item 1", "1",
      616   "Item 2", "2"
      617        SIZE 21 BY 1 NO-UNDO.
      618   DEFINE QUERY br-laytables FOR
      619         buf_file SCROLLING.
      620   DEFINE BROWSE br-laytables
      621     QUERY br-laytables DISPLAY
      622         buf_file._file-name FORMAT "X(32)" COLUMN-LABEL "Таблицы"
      623   get-tbl-fname (buf_file._file-name) FORMAT "X(62)" COLUMN-LABEL "Описание"
      624       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 20.27 FIT-LAST-COLUMN.
      625   DEFINE FRAME Dialog-Frame
      626        b-quit AT ROW 1 COL 1
      627        B-sel AT ROW 1 COL 21 WIDGET-ID 2
      628        b-export AT ROW 1 COL 48 WIDGET-ID 4
      629        b-import AT ROW 1 COL 58 WIDGET-ID 10
      630        B-Help AT ROW 1 COL 95
      631        rs-language AT ROW 2 COL 33.5 NO-LABEL WIDGET-ID 6
      632        br-laytables AT ROW 3 COL 1 WIDGET-ID 100
      633        SPACE(0.69) SKIP(0.00)
      634       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      635            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      636            TITLE "Справочники конфигурации раскладок"
      637            CANCEL-BUTTON b-quit.
      638   ASSIGN
      639          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      640          FRAME Dialog-Frame:HIDDEN           = TRUE.
      641   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      642   DO:
      643     APPLY "END-ERROR":U TO SELF.
      644   END.
      645   ON CHOOSE OF b-export IN FRAME Dialog-Frame
      646   DO:
      647   define variable v-file-name as character no-undo .
      648   define variable v-old-file-name as character no-undo .
      649   define variable v-dir-name as character no-undo .
      650   define variable v-yesno as logical no-undo .
      651   define variable v-mode-log as logical no-undo .
      652   define variable v-mode as character no-undo .
      653   message
      654   "Хотите экспортировать уникальное имя каждой записи (uniq-key-rec)?"
      655   view-as alert-box question buttons yes-no-cancel update v-mode-log.
      656   if v-mode-log = ? then return no-apply.
      657   if v-mode-log then do:
      658     v-mode = "full".
      659   end.
      660   message
      661   "Хотите экспортировать ПОЛНУЮ конфигурацию раскладок" skip
      662   "или только измененные записи?"
      663   view-as alert-box question buttons yes-no-cancel update v-yesno.
      664   if v-yesno = ? then return no-apply.
      665   if v-yesno = no then do:
      666     run gbl/d-file.p (
      667           input-output v-old-file-name
      668         , input-output v-dir-name
      669         , input  (" Все файлы txt (*.txt) ")
      670         , input  ("*.txt":U)
      671         , input  chr(44)
      672         , input  (".txt":U)
      673         , input  yes
      674         , input  no
      675         , input  yes
      676         , input  "Введите имя старого файла (для сравнения)"
      677         , output v-yesno
      678     ) no-error.
      679     if error-status:error
      680     or v-yesno = no then return no-apply.
      681   end.
      682   v-yesno = no.
      683     run gbl/d-file.p (
      684           input-output v-file-name
      685         , input-output v-dir-name
      686         , input  (" Все файлы txt (*.txt) ")
      687         , input  ("*.txt":U)
      688         , input  chr(44)
      689         , input  (".txt":U)
      690         , input  no
      691         , input  yes
      692         , input  yes
      693         , input  "Введите имя файла для экспорта"
      694         , output v-yesno
      695     ) no-error.
      696     if error-status:error
      697     or v-yesno = no then return no-apply.
      698     run adm/exporlay.p (
      699                                    input v-file-name
      700                                   ,input v-old-file-name
      701                                   ,input v-mode
      702                                  ) NO-ERROR.
      703     IF ERROR-STATUS:ERROR THEN DO:
      704        MESSAGE
      705        ERROR-STATUS:GET-MESSAGE(1) SKIP
      706        RETURN-VALUE
      707        VIEW-AS ALERT-BOX.
      708        RETURN NO-APPLY.
      709     END.
      710     define variable v-md5-signature as character no-undo .
      711     define variable v-full-file-name          as character                no-undo .
      712     define variable v-path                    as character                no-undo .
      713     DEFINE VARIABLE v-full-path               as character                no-undo .
      714     DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      715     DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      716     run gbl/md5.p ( input v-file-name
      717                    ,output v-md5-signature ) .
      718     run gbl/filename.p (
      719                    input v-file-name
      720                   ,output v-full-path
      721                   ,output v-path
      722                   ,output v-full-file-name
      723                   ,output v-file-name-no-ext
      724                   ,output v-file-name-ext
      725                   ) no-error .
      726     if error-status:error then do:
      727       message
      728       return-value
      729       view-as alert-box ERROR.
      730       return.
      731     end.
      732     output to value(v-path + chr(47) + v-file-name-no-ext + ".md5").
      733     put unformatted v-md5-signature skip.
      734     output close.
      735   END.
      736   ON CHOOSE OF b-import IN FRAME Dialog-Frame
      737   DO:
      738   define variable glog as logical no-undo.
      739   message
      740   "Хотите закачать новую конфигурацию?" skip
      741   "ЕСЛИ НЕ УВЕРЕНЫ, ЧТО ЗНАЕТЕ ЗАЧЕМ ЭТО НАДО - НЕ ЗАКАЧИВАЙТЕ!!!!!"
      742   view-as alert-box question buttons yes-no update glog.
      743   if not glog then return no-apply.
      744   run trg/fix-lay.p ( input yes
      745                      ,input no
      746                       ) no-error.
      747   END.
      748   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
      749   DO:
      750     run proc-b-sel IN THIS-PROCEDURE NO-ERROR.
      751     IF ERROR-STATUS:ERROR THEN DO:
      752        RETURN NO-APPLY.
      753     END.
      754   END.
      755   ON DEFAULT-ACTION OF br-laytables IN FRAME Dialog-Frame
      756   DO:
      757     APPLY "CHOOSE" TO b-sel.
      758   END.
      759   ON VALUE-CHANGED OF rs-language IN FRAME Dialog-Frame
      760   DO:
      761     ASSIGN
      762     rs-language.
      763     CASE rs-language:
      764       WHEN "ABL" THEN DO:
      765         buf_file._file-name:VISIBLE IN BROWSE br-laytables = YES.
      766       END.
      767       WHEN "rus" THEN DO:
      768         buf_file._file-name:VISIBLE IN BROWSE br-laytables = NO.
      769       END.
      770     END CASE.
      771   END.
      772   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      773   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      774   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      775   on help of frame Dialog-Frame
      776   do:
      777     run gbl/app_help.p
      778       (input this-procedure :file-name
      779       ,input ''
      780       ,input ?
      781       ) no-error.
      782     if error-status :error then do:
      783       message
      784         "Ошибка при вызове помощи"
      785         error-status :get-message(1)
      786         view-as alert-box .
      787     end.
      788   end.
      789   run minbtn-set in this-procedure .
      790   on choose of b-help in frame Dialog-Frame
      791   do:
      792     apply "help":u to frame Dialog-Frame .
      793   end.
      794   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      795   procedure minbtn-set :
      796       do
      797           on error undo, return error return-value
      798           :
      799           define variable ii              as integer       no-undo .
      800           define variable fh              as widget-handle no-undo .
      801           define variable hh              as widget-handle no-undo .
      802           define variable v-h             as handle        extent 4 no-undo .
      803           define variable v-name-button   as character     no-undo .
      804           define variable v-help-old-x    as decimal       no-undo .
      805           define variable v-help-old-y    as decimal       no-undo .
      806           define variable v-help-old-size as decimal       no-undo .
      807           define variable v-frame-width   as decimal       no-undo .
      808           define variable jj              as integer       no-undo .
      809           do
      810               on error undo, return error
      811               :
      812               assign
      813                   v-frame-width = frame Dialog-Frame:width - 0.3
      814                   fh            = frame Dialog-Frame:first-child
      815                   hh            = fh:first-child
      816                   ii            = 1
      817                   .
      818               do while valid-handle(hh):
      819                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      820                   do:
      821                       case lc(hh:name) :
      822                           when "b-help" then
      823                               do:
      824                                   hh:load-image-up("cmp/b-help.bmp":u) .
      825                                   hh:load-image-down("cmp/b-help.bmp":u) .
      826                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      827                                   hh:TOOLTIP = "Помощь" .
      828                                   v-help-old-x = hh:column .
      829                                   v-help-old-y = hh:row    .
      830                                   v-help-old-size = hh:width .
      831                                   hh:width-chars = 2.5 .
      832                               end.
      833                           when "b-print" then
      834                               do:
      835                                   hh:load-image("cmp/b-print.bmp":u) .
      836                                   hh:TOOLTIP = "Печать" .
      837                                   v-h[ii] = hh:handle .
      838                                   ii = ii + 1 .
      839                                   hh:width-chars = 3 .
      840                               end.
      841                           when "b-history" or
      842                           when "b-hist" then
      843                               do:
      844                                   hh:load-image("cmp/b-hist.bmp":u) .
      845                                   hh:TOOLTIP = "История" .
      846                                   v-h[ii] = hh:handle .
      847                                   ii = ii + 1 .
      848                                   hh:width-chars = 3 .
      849                               end.
      850                           when "b-sch" then
      851                               do:
      852                                   hh:load-image("cmp/b-sch.bmp":u) .
      853                                   hh:TOOLTIP = "Установка Фильтра" .
      854                                   v-h[ii] = hh:handle .
      855                                   ii = ii + 1 .
      856                                   hh:width-chars = 3 .
      857                               end.
      858                           when "b-hist-user" then
      859                               do:
      860                                   hh:load-image("cmp/b-hist.bmp":u) .
      861                                   hh:TOOLTIP = "История пользователя" .
      862                                   ii = ii + 1 .
      863                               end.
      864                       end case.
      865                   end.
      866                   hh = hh:next-sibling.
      867               end.
      868               b-help:column = v-frame-width - b-help:width-chars.
      869               jj = 0.
      870               repeat ii = 4 to 1 by -1 :
      871                   if valid-handle (v-h[ii] ) then
      872                   do:
      873                       jj  = jj + 1 .
      874                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      875                       v-h[ii]:row    = v-help-old-y .
      876                   end.
      877               end.
      878           end.
      879       end.
      880   end procedure.
      881   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      882   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      883   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      884   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      885   define variable v-diasize-current-frame-width  as decimal   no-undo .
      886   define variable v-diasize-current-frame-height as decimal   no-undo .
      887   define variable v-diasize-change-size          as logical   no-undo .
      888   define variable v-diasize-resize-button        as handle    no-undo .
      889   define variable v-diasize-wndmax               as logical   no-undo .
      890   define variable v-diasize-wndstore             as logical   no-undo .
      891   define variable v-diasize-proc-name            as character no-undo .
      892   define variable v-diasize-browse-handle        as handle    no-undo .
      893   define variable v-diasize-browse-number        as integer   no-undo .
      894   define variable v-diasize-need-full-display    as logical   no-undo init false .
      895   define temp-table temp-diasize-handle no-undo
      896     field handle-value  as handle
      897     field save-position as decimal
      898     index xpk is primary unique handle-value
      899     .
      900   define temp-table temp-browse-handle no-undo
      901     field browse-type   as character
      902     field browse-number as integer
      903     field browse-handle as handle
      904     field original-size as decimal
      905     index xpk is primary unique browse-type browse-number
      906     index xie browse-type browse-handle
      907   .
      908   procedure diasize_change-height :
      909     define input  parameter p-change-value  as decimal   no-undo .
      910     define input  parameter p-move-resize   as logical   no-undo .
      911     define variable v-field-group-handle    as handle    no-undo .
      912     define variable v-object-handle         as handle    no-undo .
      913     define variable v-frame-height          as decimal   no-undo .
      914     define variable v-frame-virtual-height  as decimal   no-undo .
      915     define variable v-browse-height         as decimal   no-undo .
      916     define variable v-window-height         as decimal   no-undo .
      917     define variable v-window-virtual-height as decimal   no-undo .
      918     define variable v-change-sign           as integer   no-undo .
      919     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      920     define buffer buf_temp-browse-handle  for temp-browse-handle .
      921     if p-change-value > 0
      922     then do:
      923       if frame Dialog-Frame :height + p-change-value
      924           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      925       then do:
      926         assign
      927           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      928                           - (frame Dialog-Frame :height-chars)
      929         .
      930         if p-change-value <= 0
      931         then do:
      932           run diasize_position-resize-button in this-procedure .
      933           return .
      934         end.
      935       end.
      936     end.
      937     if p-change-value < 0
      938     then do:
      939       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      940       then do:
      941         assign
      942           p-change-value = v-diasize-orig-frame-height
      943                          - (frame Dialog-Frame :height-chars)
      944         .
      945         if p-change-value >= 0
      946         then do:
      947           run diasize_position-resize-button in this-procedure .
      948           return .
      949         end.
      950       end.
      951     end.
      952     if p-change-value >= 0
      953     then do:
      954       assign
      955         v-change-sign = 1
      956       .
      957     end.
      958     else do:
      959       assign
      960         v-change-sign = -1
      961       .
      962     end.
      963     assign
      964       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      965     .
      966     if p-change-value = 0
      967     then do:
      968       run diasize_position-resize-button in this-procedure .
      969       return .
      970     end.
      971     move_block:
      972     do
      973     on error undo move_block, retry move_block
      974     :
      975       if retry
      976       then do:
      977         do
      978         on error undo move_block, leave move_block
      979         :
      980           if p-change-value > 0
      981           then do:
      982             for each buf_temp-diasize-handle
      983             on error undo, next
      984             :
      985               assign
      986                 v-object-handle = buf_temp-diasize-handle.handle-value
      987               .
      988               if v-object-handle <> v-diasize-resize-button
      989               then do:
      990                 assign
      991                   v-object-handle :row = buf_temp-diasize-handle.save-position
      992                 .
      993               end.
      994             end.
      995             assign
      996               v-diasize-browse-handle :height = v-browse-height
      997             .
      998             for each buf_temp-browse-handle
      999               where buf_temp-browse-handle.browse-type = 'height':u
     1000             on error undo, next
     1001             :
     1002               assign
     1003                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1004               .
     1005             end.
     1006             assign
     1007               frame Dialog-Frame :height = v-frame-height
     1008             .
     1009             if frame Dialog-Frame :scrollable = true
     1010             then do:
     1011               assign
     1012                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1013               .
     1014             end.
     1015             run diasize_position-resize-button in this-procedure .
     1016           end.
     1017           else do:
     1018             if frame Dialog-Frame :scrollable = true
     1019             then do:
     1020               assign
     1021                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1022               .
     1023             end.
     1024             assign
     1025               frame Dialog-Frame :height = v-frame-height
     1026             .
     1027             assign
     1028               v-diasize-browse-handle :height = v-browse-height
     1029             .
     1030             for each buf_temp-browse-handle
     1031               where buf_temp-browse-handle.browse-type = 'height':u
     1032             on error undo, next
     1033             :
     1034               assign
     1035                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1036               .
     1037             end.
     1038             for each buf_temp-diasize-handle
     1039             on error undo, next
     1040             :
     1041               assign
     1042                 v-object-handle = buf_temp-diasize-handle.handle-value
     1043               .
     1044               if v-object-handle <> v-diasize-resize-button
     1045               then do:
     1046                 assign
     1047                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1048                 .
     1049               end.
     1050             end.
     1051             run diasize_position-resize-button in this-procedure .
     1052           end.
     1053           assign
     1054             v-diasize-change-size = false
     1055           .
     1056           leave move_block .
     1057         end.
     1058       end.
     1059       assign
     1060         v-diasize-need-full-display = true
     1061       .
     1062       if v-diasize-change-size = false
     1063       then do:
     1064         assign
     1065           v-diasize-change-size = true
     1066         .
     1067       end.
     1068       else do:
     1069         return .
     1070       end.
     1071       assign
     1072         v-frame-height = frame Dialog-Frame :height
     1073         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1074         v-browse-height = v-diasize-browse-handle :height
     1075       .
     1076       for each buf_temp-browse-handle
     1077         where buf_temp-browse-handle.browse-type = 'height':u
     1078       :
     1079         assign
     1080           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1081         .
     1082       end.
     1083       for each buf_temp-diasize-handle
     1084       :
     1085         delete buf_temp-diasize-handle .
     1086       end.
     1087       assign
     1088         v-field-group-handle = frame Dialog-Frame :first-child
     1089       .
     1090       do while valid-handle(v-field-group-handle)
     1091       :
     1092         assign
     1093           v-object-handle = v-field-group-handle :first-child
     1094         .
     1095         do while valid-handle(v-object-handle)
     1096         :
     1097           if  v-object-handle <> v-diasize-browse-handle :handle
     1098           and can-query(v-object-handle, "row")
     1099           and can-query(v-object-handle, "height")
     1100           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1101           then do:
     1102             find first buf_temp-browse-handle
     1103               where buf_temp-browse-handle.browse-type   = 'height':u
     1104                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1105               no-error .
     1106             if available buf_temp-browse-handle
     1107             then do:
     1108             end.
     1109             else do:
     1110               create buf_temp-diasize-handle .
     1111               assign
     1112                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1113                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1114               .
     1115             end.
     1116           end.
     1117           assign
     1118             v-object-handle = v-object-handle :next-sibling
     1119           .
     1120         end.
     1121         assign
     1122           v-field-group-handle = v-field-group-handle :next-sibling
     1123         .
     1124       end.
     1125       do with frame Dialog-Frame
     1126       :
     1127         hide v-diasize-resize-button .
     1128         assign
     1129           v-diasize-resize-button :row    = 1
     1130           v-diasize-resize-button :column = 1
     1131         .
     1132       end.
     1133       if p-change-value > 0
     1134       then do:
     1135         if frame Dialog-Frame :scrollable = true
     1136         then do:
     1137           assign
     1138             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1139             no-error .
     1140           if error-status :error
     1141           or error-status :get-message(1) <> ""
     1142           then do:
     1143             undo move_block, retry move_block .
     1144           end.
     1145         end.
     1146         assign
     1147           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1148           no-error .
     1149         if error-status :error
     1150         or error-status :get-message(1) <> ""
     1151         then do:
     1152           undo move_block, retry move_block .
     1153         end.
     1154         assign
     1155           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1156           no-error .
     1157         if error-status :error
     1158         or error-status :get-message(1) <> ""
     1159         then do:
     1160           undo move_block, retry move_block .
     1161         end.
     1162         for each buf_temp-browse-handle
     1163           where buf_temp-browse-handle.browse-type = 'height':u
     1164         on error undo move_block, retry move_block
     1165         :
     1166           assign
     1167             buf_temp-browse-handle.browse-handle :height
     1168               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1169             no-error .
     1170           if error-status :error
     1171           or error-status :get-message(1) <> ""
     1172           then do:
     1173             undo move_block, retry move_block .
     1174           end.
     1175         end.
     1176         for each buf_temp-diasize-handle
     1177         on error undo move_block, retry move_block
     1178         :
     1179           assign
     1180             v-object-handle = buf_temp-diasize-handle.handle-value
     1181           .
     1182           if v-object-handle <> v-diasize-resize-button
     1183           then do:
     1184             assign
     1185               v-object-handle :row = v-object-handle :row + p-change-value
     1186               no-error .
     1187             if error-status :error
     1188             or error-status :get-message(1) <> ""
     1189             then do:
     1190               undo move_block, retry move_block .
     1191             end.
     1192           end.
     1193         end.
     1194       end.
     1195       else do:
     1196         for each buf_temp-diasize-handle
     1197         on error undo move_block, retry move_block
     1198         :
     1199           assign
     1200             v-object-handle = buf_temp-diasize-handle.handle-value
     1201           .
     1202           if v-object-handle <> v-diasize-resize-button
     1203           then do:
     1204             assign
     1205               v-object-handle :row = v-object-handle :row + p-change-value
     1206               no-error .
     1207             if error-status :error
     1208             or error-status :get-message(1) <> ""
     1209             then do:
     1210               undo move_block, retry move_block .
     1211             end.
     1212           end.
     1213         end.
     1214         assign
     1215           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1216           no-error .
     1217         if error-status :error
     1218         or error-status :get-message(1) <> ""
     1219         then do:
     1220           undo move_block, retry move_block .
     1221         end.
     1222         for each buf_temp-browse-handle
     1223           where buf_temp-browse-handle.browse-type = 'height':u
     1224         on error undo move_block, retry move_block
     1225         :
     1226           assign
     1227             buf_temp-browse-handle.browse-handle :height
     1228               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1229             no-error .
     1230           if error-status :error
     1231           or error-status :get-message(1) <> ""
     1232           then do:
     1233             undo move_block, retry move_block .
     1234           end.
     1235         end.
     1236         assign
     1237           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1238           no-error .
     1239         if error-status :error
     1240         or error-status :get-message(1) <> ""
     1241         then do:
     1242           undo move_block, retry move_block .
     1243         end.
     1244         if frame Dialog-Frame :scrollable = true
     1245         then do:
     1246           assign
     1247             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1248             no-error .
     1249           if error-status :error
     1250           or error-status :get-message(1) <> ""
     1251           then do:
     1252             undo move_block, retry move_block .
     1253           end.
     1254         end.
     1255       end.
     1256       if p-move-resize = true
     1257       then do:
     1258         run diasize_position-resize-button in this-procedure .
     1259       end.
     1260       if v-diasize-wndstore = true
     1261       then do:
     1262         if connected("ub") = true
     1263         then do:
     1264           define variable v-cntxt-db-num        as integer   no-undo .
     1265           define variable v-cntxt-userid        as character no-undo .
     1266           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1267                                             , OUTPUT v-cntxt-userid
     1268                                             ) .
     1269           run gbl/wndsizew.p
     1270             (input  v-cntxt-db-num
     1271             ,input  v-cntxt-userid
     1272             ,input  v-diasize-proc-name
     1273             ,input  'height':u
     1274             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1275             ) .
     1276         end.
     1277       end.
     1278     end.
     1279     assign
     1280       v-diasize-change-size = false
     1281     .
     1282   end procedure.
     1283   procedure diasize_set-height :
     1284     define input  parameter p-new-height  as decimal   no-undo .
     1285     define input  parameter p-move-resize as logical   no-undo .
     1286     do
     1287     on error undo, return error return-value
     1288     :
     1289       run diasize_change-height in this-procedure
     1290         (input  (p-new-height - frame Dialog-Frame :height)
     1291         ,input  p-move-resize
     1292         ) .
     1293     end.
     1294   end procedure.
     1295   procedure diasize_change-width :
     1296     define input  parameter p-change-value as decimal   no-undo .
     1297     define input  parameter p-move-resize  as logical   no-undo .
     1298     define variable v-field-group-handle   as handle    no-undo .
     1299     define variable v-object-handle        as handle    no-undo .
     1300     define variable v-frame-width          as decimal   no-undo .
     1301     define variable v-frame-virtual-width  as decimal   no-undo .
     1302     define variable v-browse-width         as decimal   no-undo .
     1303     define variable v-window-width         as decimal   no-undo .
     1304     define variable v-window-virtual-width as decimal   no-undo .
     1305     define variable v-change-sign          as integer   no-undo .
     1306     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1307     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1308     if p-change-value > 0
     1309     then do:
     1310       if frame Dialog-Frame :width + p-change-value >
     1311           session :width-chars
     1312       then do:
     1313         assign
     1314           p-change-value = session :width-chars - frame Dialog-Frame :width
     1315         .
     1316         if p-change-value <= 0
     1317         then do:
     1318           run diasize_position-resize-button in this-procedure .
     1319           return .
     1320         end.
     1321       end.
     1322     end.
     1323     if p-change-value < 0
     1324     then do:
     1325       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1326       then do:
     1327         assign
     1328           p-change-value = v-diasize-orig-frame-width
     1329                          - frame Dialog-Frame :width
     1330         .
     1331         if p-change-value >= 0
     1332         then do:
     1333           run diasize_position-resize-button in this-procedure .
     1334           return .
     1335         end.
     1336       end.
     1337     end.
     1338     if p-change-value >= 0
     1339     then do:
     1340       assign
     1341         v-change-sign = 1
     1342       .
     1343     end.
     1344     else do:
     1345       assign
     1346         v-change-sign = -1
     1347       .
     1348     end.
     1349     assign
     1350       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1351     .
     1352     if p-change-value = 0
     1353     then do:
     1354       run diasize_position-resize-button in this-procedure .
     1355       return .
     1356     end.
     1357     move_block:
     1358     do
     1359     on error undo move_block, leave move_block
     1360     :
     1361       if retry
     1362       then do:
     1363         do
     1364         on error undo move_block, leave move_block
     1365         :
     1366           if p-change-value > 0
     1367           then do:
     1368             for each buf_temp-diasize-handle
     1369             on error undo, next
     1370             :
     1371               assign
     1372                 v-object-handle = buf_temp-diasize-handle.handle-value
     1373               .
     1374               if v-object-handle <> v-diasize-resize-button
     1375               then do:
     1376                 assign
     1377                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1378                 .
     1379               end.
     1380             end.
     1381             assign
     1382               v-diasize-browse-handle :width = v-browse-width
     1383             .
     1384             for each buf_temp-browse-handle
     1385               where buf_temp-browse-handle.browse-type = 'width':u
     1386             on error undo, next
     1387             :
     1388               assign
     1389                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1390               .
     1391             end.
     1392             assign
     1393               frame Dialog-Frame :width = v-frame-width
     1394             .
     1395             if frame Dialog-Frame :scrollable = true
     1396             then do:
     1397               assign
     1398                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1399               .
     1400             end.
     1401             run diasize_position-resize-button in this-procedure .
     1402           end.
     1403           else do:
     1404             if frame Dialog-Frame :scrollable = true
     1405             then do:
     1406               assign
     1407                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1408               .
     1409             end.
     1410             assign
     1411               frame Dialog-Frame :width = v-frame-width
     1412             .
     1413             for each buf_temp-browse-handle
     1414               where buf_temp-browse-handle.browse-type = 'width':u
     1415             on error undo, next
     1416             :
     1417               assign
     1418                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1419               .
     1420             end.
     1421             assign
     1422               v-diasize-browse-handle :width = v-browse-width
     1423             .
     1424             for each buf_temp-diasize-handle
     1425             on error undo, next
     1426             :
     1427               assign
     1428                 v-object-handle = buf_temp-diasize-handle.handle-value
     1429               .
     1430               if v-object-handle <> v-diasize-resize-button
     1431               then do:
     1432                 assign
     1433                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1434                 .
     1435               end.
     1436             end.
     1437             run diasize_position-resize-button in this-procedure .
     1438           end.
     1439           assign
     1440             v-diasize-change-size = false
     1441           .
     1442           leave move_block .
     1443         end.
     1444       end.
     1445       assign
     1446         v-diasize-need-full-display = true
     1447       .
     1448       if v-diasize-change-size = false
     1449       then do:
     1450         assign
     1451           v-diasize-change-size = true
     1452         .
     1453       end.
     1454       else do:
     1455         return .
     1456       end.
     1457       assign
     1458         v-frame-width = frame Dialog-Frame :width
     1459         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1460         v-browse-width = v-diasize-browse-handle :width
     1461       .
     1462       for each buf_temp-browse-handle
     1463         where buf_temp-browse-handle.browse-type = 'width':u
     1464       :
     1465         assign
     1466           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1467         .
     1468       end.
     1469       for each buf_temp-diasize-handle
     1470       :
     1471         delete buf_temp-diasize-handle .
     1472       end.
     1473       assign
     1474         v-field-group-handle = frame Dialog-Frame :first-child
     1475       .
     1476       do while valid-handle(v-field-group-handle)
     1477       :
     1478         assign
     1479           v-object-handle = v-field-group-handle :first-child
     1480         .
     1481         do while valid-handle(v-object-handle)
     1482         :
     1483           if  v-object-handle <> v-diasize-browse-handle :handle
     1484           and v-object-handle <> v-diasize-resize-button
     1485           and can-query(v-object-handle, "row")
     1486           and can-query(v-object-handle, "height")
     1487           and ( v-object-handle :col + v-object-handle :width
     1488                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1489               )
     1490           then do:
     1491             find first buf_temp-browse-handle
     1492               where buf_temp-browse-handle.browse-type   = 'width':u
     1493                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1494               no-error .
     1495             if available buf_temp-browse-handle
     1496             then do:
     1497             end.
     1498             else do:
     1499               create buf_temp-diasize-handle .
     1500               assign
     1501                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1502                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1503               .
     1504             end.
     1505           end.
     1506           assign
     1507             v-object-handle = v-object-handle :next-sibling
     1508           .
     1509         end.
     1510         assign
     1511           v-field-group-handle = v-field-group-handle :next-sibling
     1512         .
     1513       end.
     1514       do with frame Dialog-Frame
     1515       :
     1516         hide v-diasize-resize-button .
     1517         v-diasize-resize-button :row = 1.
     1518         v-diasize-resize-button :column = 1.
     1519       end.
     1520       if p-change-value > 0
     1521       then do:
     1522         if frame Dialog-Frame :scrollable = true
     1523         then do:
     1524           assign
     1525             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1526             no-error .
     1527           if error-status :error
     1528           or error-status :get-message(1) <> ""
     1529           then do:
     1530             undo move_block, retry move_block.
     1531           end.
     1532         end.
     1533         assign
     1534           frame Dialog-Frame :width = v-frame-width + p-change-value
     1535           no-error .
     1536         if error-status :error
     1537         or error-status :get-message(1) <> ""
     1538         then do:
     1539           undo move_block, retry move_block.
     1540         end.
     1541         assign
     1542           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1543         no-error .
     1544         if error-status :error
     1545         or error-status :get-message(1) <> ""
     1546         then do:
     1547           undo move_block, retry move_block.
     1548         end.
     1549         for each buf_temp-browse-handle
     1550           where buf_temp-browse-handle.browse-type = 'width':u
     1551         on error undo move_block, retry move_block
     1552         :
     1553           assign
     1554             buf_temp-browse-handle.browse-handle :width
     1555               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1556             no-error .
     1557           if error-status :error
     1558           or error-status :get-message(1) <> ""
     1559           then do:
     1560             undo move_block, retry move_block .
     1561           end.
     1562         end.
     1563         for each buf_temp-diasize-handle
     1564         on error undo move_block, retry move_block
     1565         :
     1566           assign
     1567             v-object-handle = buf_temp-diasize-handle.handle-value
     1568           .
     1569           if v-object-handle <> v-diasize-resize-button
     1570           then do:
     1571             assign
     1572               v-object-handle :col = v-object-handle :col + p-change-value
     1573               no-error .
     1574             if error-status :error
     1575             or error-status :get-message(1) <> ""
     1576             then do:
     1577               undo move_block, retry move_block .
     1578             end.
     1579           end.
     1580         end.
     1581       end.
     1582       else do:
     1583         for each buf_temp-diasize-handle
     1584         on error undo move_block, retry move_block
     1585         :
     1586           assign
     1587             v-object-handle = buf_temp-diasize-handle.handle-value
     1588           .
     1589           if v-object-handle <> v-diasize-resize-button
     1590           then do:
     1591             assign
     1592               v-object-handle :col = v-object-handle :col + p-change-value
     1593               no-error .
     1594             if error-status :error
     1595             or error-status :get-message(1) <> ""
     1596             then do:
     1597               undo move_block, retry move_block .
     1598             end.
     1599           end.
     1600         end.
     1601         for each buf_temp-browse-handle
     1602           where buf_temp-browse-handle.browse-type = 'width':u
     1603         on error undo move_block, retry move_block
     1604         :
     1605           assign
     1606             buf_temp-browse-handle.browse-handle :width
     1607               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1608             no-error .
     1609           if error-status :error
     1610           or error-status :get-message(1) <> ""
     1611           then do:
     1612             undo move_block, retry move_block .
     1613           end.
     1614         end.
     1615         assign
     1616           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1617           no-error .
     1618         if error-status :error
     1619         or error-status :get-message(1) <> ""
     1620         then do:
     1621           undo move_block, retry move_block.
     1622         end.
     1623         assign
     1624           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1625         no-error .
     1626         if error-status :error
     1627         or error-status :get-message(1) <> ""
     1628         then do:
     1629           undo move_block, retry move_block.
     1630         end.
     1631         if frame Dialog-Frame :scrollable = true
     1632         then do:
     1633           assign
     1634             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1635           no-error .
     1636           if error-status :error
     1637           or error-status :get-message(1) <> ""
     1638           then do:
     1639             undo move_block, retry move_block.
     1640           end.
     1641         end.
     1642       end.
     1643       if p-move-resize
     1644       then do:
     1645         run diasize_position-resize-button in this-procedure .
     1646       end.
     1647       if v-diasize-wndstore = true
     1648       then do:
     1649         if connected("ub") = true
     1650         then do:
     1651           define variable v-cntxt-db-num        as integer   no-undo .
     1652           define variable v-cntxt-userid        as character no-undo .
     1653           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1654                                             , OUTPUT v-cntxt-userid
     1655                                             ) .
     1656           run gbl/wndsizew.p
     1657             (input  v-cntxt-db-num
     1658             ,input  v-cntxt-userid
     1659             ,input  v-diasize-proc-name
     1660             ,input  'width':u
     1661             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1662             ) .
     1663         end.
     1664       end.
     1665     end.
     1666     assign
     1667       v-diasize-change-size = false
     1668     .
     1669   end procedure.
     1670   procedure diasize_set-width :
     1671     define input  parameter p-new-width  as decimal   no-undo .
     1672     define input  parameter p-move-resize as logical   no-undo .
     1673     do
     1674     on error undo, return error return-value
     1675     :
     1676       run diasize_change-width in this-procedure
     1677         (input  (p-new-width - frame Dialog-Frame :width)
     1678         ,input  p-move-resize
     1679         ) .
     1680     end.
     1681   end procedure.
     1682   procedure diasize_position-resize-button :
     1683     do with frame Dialog-Frame
     1684     :
     1685       hide v-diasize-resize-button .
     1686       assign
     1687         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1688                     - 1
     1689                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1690         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1691                     - 1
     1692                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1693       .
     1694       view v-diasize-resize-button .
     1695     end.
     1696   end procedure.
     1697   on alt-right anywhere
     1698   do:
     1699     run diasize_change-width in this-procedure
     1700       (input 1
     1701       ,input true
     1702       ) .
     1703     return no-apply .
     1704   end.
     1705   on alt-left anywhere
     1706   do:
     1707     run diasize_change-width in this-procedure
     1708       (input -1
     1709       ,input true
     1710       ) .
     1711     return no-apply .
     1712   end.
     1713   on alt-down anywhere
     1714   do:
     1715     run diasize_change-height in this-procedure
     1716       (input 1
     1717       ,input true
     1718       ) .
     1719     return no-apply .
     1720   end.
     1721   on alt-up anywhere
     1722   do:
     1723     run diasize_change-height in this-procedure
     1724       (input -1
     1725       ,input true
     1726       ) .
     1727     return no-apply .
     1728   end.
     1729   on alt-enter of frame Dialog-Frame
     1730   do:
     1731     run diasize_maximize in this-procedure
     1732       (input  ?
     1733       ).
     1734     return no-apply .
     1735   end.
     1736   procedure diasize_end-move :
     1737     do
     1738     on error undo, return error return-value
     1739     :
     1740       define variable v-row-delta as decimal   no-undo .
     1741       define variable v-col-delta as decimal   no-undo .
     1742       define variable v-new-row as decimal   no-undo .
     1743       define variable v-new-col as decimal   no-undo .
     1744       assign
     1745         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1746         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1747       .
     1748       assign
     1749         v-row-delta = v-new-row - frame Dialog-Frame :height
     1750         v-col-delta = v-new-col - frame Dialog-Frame :width
     1751       .
     1752       run diasize_change-height in this-procedure
     1753         (input v-row-delta
     1754         ,input true
     1755         ) .
     1756       run diasize_change-width in this-procedure
     1757         (input v-col-delta
     1758         ,input true
     1759         ) .
     1760     end.
     1761   end procedure.
     1762   procedure diasize_maximize :
     1763     define input  parameter p-action as logical   no-undo .
     1764     do
     1765     on error undo, return error return-value
     1766     :
     1767       if p-action = ?
     1768       then do:
     1769         if v-diasize-need-maximize = true
     1770         then do:
     1771           assign
     1772             p-action = true
     1773           .
     1774         end.
     1775         else do:
     1776           assign
     1777             p-action = false
     1778           .
     1779         end.
     1780       end.
     1781       if p-action = true
     1782       then do:
     1783         run diasize_change-height in this-procedure
     1784           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1785               - frame Dialog-Frame :height-chars
     1786           ,input true
     1787           ) .
     1788         run diasize_change-width in this-procedure
     1789           (input session :width-chars
     1790               - frame Dialog-Frame :width-chars
     1791           ,input true
     1792           ) .
     1793         assign
     1794           v-diasize-need-maximize = false
     1795         .
     1796       end.
     1797       else do:
     1798         run diasize_change-width in this-procedure
     1799           (input v-diasize-orig-frame-width
     1800               - frame Dialog-Frame :width-chars
     1801           ,input true
     1802           ) .
     1803         run diasize_change-height in this-procedure
     1804           (input v-diasize-orig-frame-height
     1805               - frame Dialog-Frame :height-chars
     1806           ,input true
     1807           ) .
     1808         assign
     1809           v-diasize-need-maximize = true
     1810         .
     1811       end.
     1812     end.
     1813   end procedure.
     1814   procedure diasize_restore-orig-size :
     1815     do
     1816     on error undo, return error return-value
     1817     :
     1818       assign
     1819         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1820         v-diasize-current-frame-height = frame Dialog-Frame :height
     1821       .
     1822       run diasize_set-height in this-procedure
     1823         (input  v-diasize-orig-frame-height
     1824         ,input  true
     1825         ) .
     1826       run diasize_set-width in this-procedure
     1827         (input  v-diasize-orig-frame-width
     1828         ,input  true
     1829         ) .
     1830     end.
     1831   end procedure.
     1832   procedure diasize_restore-current-size :
     1833     do
     1834     on error undo, return error return-value
     1835     :
     1836       run diasize_set-height in this-procedure
     1837         (input  v-diasize-current-frame-height
     1838         ,input  true
     1839         ) .
     1840       run diasize_set-width in this-procedure
     1841         (input  v-diasize-current-frame-width
     1842         ,input  true
     1843         ) .
     1844     end.
     1845   end procedure.
     1846   procedure diasize_set-browse-handle :
     1847     define input  parameter p-browse-handle as handle   no-undo .
     1848     define buffer buf_temp-browse-handle for temp-browse-handle .
     1849     do
     1850     on error undo, return error return-value
     1851     :
     1852       assign
     1853         v-diasize-browse-handle = p-browse-handle
     1854       .
     1855       for each buf_temp-browse-handle
     1856       on error undo, return error return-value
     1857       :
     1858         delete buf_temp-browse-handle .
     1859       end.
     1860     end.
     1861   end procedure.
     1862   procedure diasize_add_browse :
     1863     define input  parameter p-browse-type   as character no-undo .
     1864     define input  parameter p-browse-handle as handle    no-undo .
     1865     define buffer buf_temp-browse-handle for temp-browse-handle .
     1866     do
     1867     on error undo, return error return-value
     1868     :
     1869       assign
     1870         v-diasize-browse-number = v-diasize-browse-number + 1
     1871       .
     1872       create buf_temp-browse-handle .
     1873       assign
     1874         buf_temp-browse-handle.browse-type   = p-browse-type
     1875         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1876         buf_temp-browse-handle.browse-handle = p-browse-handle
     1877       .
     1878     end.
     1879   end procedure.
     1880   procedure diasize_init :
     1881     define variable v-default-value    as logical   no-undo .
     1882     define variable v-restore-saved    as logical   no-undo .
     1883     define variable v-resize-value-str as character no-undo .
     1884     do
     1885     on error undo, return error return-value
     1886     :
     1887       do with frame Dialog-Frame
     1888       :
     1889         assign
     1890           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1891           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1892           v-diasize-browse-handle     = browse br-laytables :handle
     1893         .
     1894         create button v-diasize-resize-button
     1895         assign
     1896           parent        = frame Dialog-Frame :first-child
     1897           label         = "s"
     1898           height-pixels = 16
     1899           width-pixels  = 16
     1900           visible       = true
     1901           sensitive     = true
     1902           movable       = true
     1903           triggers:
     1904             on end-move persistent run diasize_end-move in this-procedure .
     1905           end triggers.
     1906         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1907         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1908         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1909         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1910         assign
     1911           v-diasize-wndmax = false
     1912         .
     1913         if connected("ub") = true
     1914         then do:
     1915           define variable v-cntxt-db-num        as integer   no-undo .
     1916           define variable v-cntxt-userid        as character no-undo .
     1917           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1918                                             , OUTPUT v-cntxt-userid
     1919                                             ) .
     1920           run gbl/wndpar_r.p
     1921             (input  v-cntxt-db-num
     1922             ,input  v-cntxt-userid
     1923             ,input  'wndmax':U
     1924             ,output v-diasize-wndmax
     1925             ,output v-default-value
     1926             ) .
     1927         end.
     1928         assign
     1929           v-diasize-wndstore = false
     1930         .
     1931         if connected("ub") = true
     1932         then do:
     1933           run gbl/wndpar_r.p
     1934             (input  v-cntxt-db-num
     1935             ,input  v-cntxt-userid
     1936             ,input  'wndstore':U
     1937             ,output v-diasize-wndstore
     1938             ,output v-default-value
     1939             ) .
     1940         end.
     1941         assign
     1942           v-diasize-proc-name = entry(1, program-name(2), '.')
     1943         .
     1944         if v-diasize-wndstore = true
     1945         then do:
     1946           assign
     1947             v-restore-saved = false
     1948           .
     1949           if connected("ub") = true
     1950           then do:
     1951             run gbl/wndsizer.p
     1952               (input  v-cntxt-db-num
     1953               ,input  v-cntxt-userid
     1954               ,input  v-diasize-proc-name
     1955               ,input  'height':u
     1956               ,output v-resize-value-str
     1957               ) .
     1958             if v-resize-value-str <> '':U
     1959             then do:
     1960               run diasize_change-height in this-procedure
     1961                 (input  integer(v-resize-value-str)
     1962                 ,input  true
     1963                 ) .
     1964               assign
     1965                 v-restore-saved = true
     1966               .
     1967             end.
     1968           end.
     1969           if connected("ub") = true
     1970           then do:
     1971             run gbl/wndsizer.p
     1972               (input  v-cntxt-db-num
     1973               ,input  v-cntxt-userid
     1974               ,input  v-diasize-proc-name
     1975               ,input  'width':u
     1976               ,output v-resize-value-str
     1977               ) .
     1978             if v-resize-value-str <> '':U
     1979             then do:
     1980               run diasize_change-width in this-procedure
     1981                 (input  integer(v-resize-value-str)
     1982                 ,input  true
     1983                 ) .
     1984               assign
     1985                 v-restore-saved = true
     1986               .
     1987             end.
     1988           end.
     1989           if v-restore-saved <> true
     1990           then do:
     1991             if v-diasize-wndmax = true
     1992             then do:
     1993               run diasize_maximize in this-procedure
     1994                 (input  true
     1995                 ) .
     1996             end.
     1997           end.
     1998         end.
     1999         else do:
     2000           if v-diasize-wndmax = true
     2001           then do:
     2002             run diasize_maximize in this-procedure
     2003               (input  true
     2004               ) .
     2005           end.
     2006         end.
     2007       end.
     2008     end.
     2009   end procedure.
     2010   procedure diasize_need-full-display :
     2011     define output parameter p-need-full-display as logical   no-undo .
     2012     do
     2013     on error undo, return error return-value
     2014     :
     2015       assign
     2016         p-need-full-display = v-diasize-need-full-display
     2017       .
     2018       assign
     2019         v-diasize-need-full-display = false
     2020       .
     2021     end.
     2022   end procedure.
     2023   procedure get-context :
     2024      define output parameter p-db-num as integer          no-undo.
     2025      define output parameter p-user-id as character        no-undo.
     2026      define variable v-login               as character    no-undo.
     2027      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2028      define buffer buf_user-login  for ub.user-login .
     2029      do
     2030      on error undo, return error
     2031      :
     2032            FIND FIRST buf_sys-ctrl no-lock.
     2033            ASSIGN
     2034               v-login = USERID("ub")
     2035               p-db-num = buf_sys-ctrl.db-num
     2036            .
     2037            FIND FIRST buf_user-login
     2038                 WHERE buf_user-login.db-num = p-db-num
     2039                   AND buf_user-login.user-login = v-login
     2040                 no-lock
     2041                 no-error
     2042                 .
     2043            IF AVAILABLE buf_user-login
     2044            THEN DO:
     2045               assign
     2046                  p-user-id = buf_user-login.user-id
     2047               .
     2048            END.
     2049      end.
     2050   end procedure.
     2051       run diasize_init in this-procedure .
     2052   MAIN-BLOCK:
     2053   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2054      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2055   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     2056   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     2057     (output v-sys-key
     2058     ) no-error .
     2059     if error-status:error then return error.
     2060     assign
     2061     v-ibs = (v-sys-key = 'ExpertekIBS':U).
     2062     if not v-ibs then do:
     2063       message
     2064       "Данная программа может вызываться только сотрудниками IBS" skip
     2065       "Продолжать?" view-as alert-box question buttons yes-no update glog.
     2066       if not glog then do:
     2067         undo, return error .
     2068       end.
     2069       DEFINE VARIABLE v-value AS CHARACTER no-undo.
     2070       DEFINE VARIABLE v-password AS CHARACTER no-undo.
     2071       DEFINE VARIABLE v-today as date no-undo .
     2072       DEFINE VARIABLE v-time as integer no-undo .
     2073       run cur-time in this-procedure ( output v-today, output v-time).
     2074       ASSIGN
     2075       v-password = string((if weekday(v-today) = 1
     2076                           then 7
     2077                           else (weekday(v-today) - 1))
     2078                           * 140).
     2079           run gbl/d-prompt.w (
     2080           'title=':u + "ВВЕДИТЕ ПАРОЛЬ" + '\':u
     2081         + 'text1=' + substitute("Пароль") + '\':u
     2082         + 'format=' + ">>>>>>>>9" + '\':u
     2083         + 'type=' + 'I':U + '\':u
     2084         + 'fillin_row=2\':u
     2085         + 'fillin_col=4\':u
     2086         + 'fillin_width=30\':u
     2087         + 'fillin_height=1\':u
     2088         + 'max-chars=70\':u
     2089         + 'readonly=no\':u
     2090         , input-output v-value
     2091         ).
     2092       if return-value = 'false':u
     2093       then do:
     2094         return no-apply.
     2095       end.
     2096       IF v-value <> v-password THEN DO:
     2097           MESSAGE
     2098         "Неверный пароль!"
     2099         VIEW-AS ALERT-BOX.
     2100         RETURN error.
     2101       END.
     2102     end.
     2103     assign
     2104     v-layout-tables = v-layout-tables + chr(44) + 'layout':U +
     2105                                   chr(44) + 'layout-elem':U +
     2106                                   chr(44) + 'wi-mode':U +
     2107                                   chr(44) + 'rule':U +
     2108                                   chr(44) + 'ruleset':U
     2109                                   .
     2110     assign
     2111     v-layout-table-names = v-layout-table-names + chr(44) + 'Раскладка интерфе/клавиатуры':U +
     2112                                   chr(44) + 'Элементы раскладки':U +
     2113                                   chr(44) + 'Режимы работы':U +
     2114                                   chr(44) + "Правила (функции)" +
     2115                                   chr(44) + "Наборы правил (для органичения по режимам)"
     2116                                   .
     2117     assign
     2118     v-layout-tables = trim(v-layout-tables).
     2119     v-layout-table-names = trim(v-layout-table-names).
     2120     run Myenable.
     2121     WAIT-FOR GO OF FRAME Dialog-Frame.
     2122   END.
     2123   run disable_UI.
     2124   PROCEDURE disable_UI :
     2125     HIDE FRAME Dialog-Frame.
     2126   END PROCEDURE.
     2127   PROCEDURE enable_UI :
     2128     DISPLAY rs-language
     2129         WITH FRAME Dialog-Frame.
     2130     ENABLE b-quit B-sel b-export b-import B-Help rs-language br-laytables
     2131         WITH FRAME Dialog-Frame.
     2132     VIEW FRAME Dialog-Frame.
     2133     OPEN QUERY br-laytables FOR EACH buf_file NO-LOCK WHERE lookup(buf_file._file-name,        v-layout-tables) > 0.
     2134   END PROCEDURE.
     2135   PROCEDURE MyEnable :
     2136   ASSIGN
     2137   rs-language:RADIO-BUTTONS IN FRAME Dialog-Frame = "ABL" + chr(44) + "ABL" + chr(44) +
     2138                                                    "rus" + chr(44) + "rus"
     2139   .
     2140   rs-language + "ABL".
     2141   ENABLE
     2142   b-quit
     2143   B-sel
     2144   B-Help
     2145   b-export
     2146   b-import
     2147   br-laytables
     2148   rs-language
     2149   WITH FRAME Dialog-Frame.
     2150   VIEW FRAME Dialog-Frame.
     2151   run waitfram-show in this-procedure ( input "Ждите..." ).
     2152   OPEN QUERY br-laytables FOR EACH buf_file NO-LOCK WHERE lookup(buf_file._file-name,        v-layout-tables) > 0.
     2153   run waitfram-hide in this-procedure .
     2154   END PROCEDURE.
     2155   PROCEDURE proc-b-sel :
     2156   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     2157   IF NOT AVAILABLE buf_file THEN DO:
     2158      RETURN.
     2159   END.
     2160   CASE buf_file._file-name:
     2161     WHEN 'layout':U THEN DO:
     2162       run adm/layoutss.w ( INPUT parparentproc
     2163                            ,INPUT (if v-ibs then
     2164                                   'b-add,admin':U
     2165                                   else '':U)
     2166                            ,input 'все':U
     2167                            ,input ""
     2168                            ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2169     END.
     2170     WHEN 'layout-elem':U THEN DO:
     2171       run adm/layoutes.w ( INPUT parparentproc
     2172                            ,INPUT (if v-ibs then
     2173                                   'b-add,admin':U
     2174                                   else '':U)
     2175                            ,input 'все':U
     2176                            ,input ""
     2177                            ,input ""
     2178                            ,input ""
     2179                            ,input ?
     2180                            ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2181     END.
     2182     WHEN 'wi-mode':U THEN DO:
     2183       run adm/wi-modes.w ( INPUT parparentproc
     2184                            ,INPUT (if v-ibs then
     2185                                   'b-add,admin':U
     2186                                   else '':U)
     2187                            ,input 'все':U
     2188                            ,input ""
     2189                            ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2190     end.
     2191     WHEN 'rule':U THEN DO:
     2192       run rul/rule-s.w ( INPUT parparentproc
     2193                            ,INPUT (if v-ibs then
     2194                                   'b-add,admin':U
     2195                                   else '':U)
     2196                            ,input "codex"
     2197                            ,input 19
     2198                            ,input -999999999
     2199                            ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2200     END.
     2201     WHEN 'ruleset':U THEN DO:
     2202       run rul/ruleset-s.w ( INPUT parparentproc
     2203                            ,INPUT (if v-ibs then
     2204                                   'b-add,admin':U
     2205                                   else '':U)
     2206                            ,input "codex"
     2207                            ,input 19
     2208                            ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2209     END.
     2210   END CASE.
     2211   END PROCEDURE.
     2212   FUNCTION get-tbl-fname RETURNS CHARACTER ( INPUT p-tbl-name AS CHARACTER ) :
     2213   DEFINE VARIABLE v-tbl-fname AS CHARACTER NO-UNDO.
     2214   v-tbl-fname = ENTRY(LOOKUP(p-tbl-name, v-layout-tables), v-layout-table-names).
     2215   return v-tbl-fname.
     2216   END FUNCTION.
