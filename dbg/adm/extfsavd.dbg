      398   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      399   function prepare-path returns character ( input p-nonprepared-path as character ):
      400   define variable v-prepared-path as character no-undo .
      401   assign
      402   v-prepared-path = replace(p-nonprepared-path, chr(92), chr(47))
      403   v-prepared-path = right-trim(v-prepared-path, chr(47))
      404   .
      405   return v-prepared-path.
      406   END FUNCTION.
      407   function prepare-path2 returns character ( input p-nonprepared-path as character ):
      408   define variable v-prepared-path as character no-undo .
      409   assign
      410   v-prepared-path = replace(p-nonprepared-path, chr(47), chr(92))
      411   v-prepared-path = right-trim(v-prepared-path, chr(92))
      412   .
      413   return v-prepared-path.
      414   END FUNCTION.
      415   function quote-spaces returns character ( input p-full-path as character):
      416   define variable v-ii as integer no-undo .
      417   define variable v-result as character no-undo .
      418   do v-ii = 1 to num-entries(p-full-path, chr(92)):
      419     v-result = v-result + (if v-ii = 1 then '' else chr(92)) +
      420                (if index(entry(v-ii, p-full-path, chr(92)), chr(32)) > 0
      421                then  substitute("&1&2&1", chr(34), entry(v-ii, p-full-path, chr(92)))
      422                else entry(v-ii, p-full-path, chr(92))
      423                )
      424     .
      425   end.
      426   return v-result.
      427   end function.
      428   define variable v-full-path-name as character no-undo .
      429   define variable v-md5-signature as character no-undo .
      430   define variable v-dir-type as character no-undo .
      431   define variable v-can-write as logical no-undo .
      432   define variable choice as integer no-undo .
      433   define variable v-is-temp-file as logical no-undo .
      434   define buffer buf_ext-file for ub.ext-file.
      435   do
      436   on error undo, return error return-value
      437   :
      438      find first buf_ext-file  exclusive-lock where
      439               buf_Ext-file.db-num = p-db-num
      440           and buf_Ext-file.from-db-num = p-from-db-num
      441           and buf_Ext-file.file-num = p-file-num no-error .
      442     if not available buf_Ext-file then do:
      443       undo, return error substitute("Не найден файл, сохраненный в БД:&1БД &2 № файла &3"
      444                             , chr(10)
      445                             , p-db-num
      446                             , p-file-num).
      447     end.
      448     if p-dir-path = ? then do:
      449        run gbl/dir-sel.p (
      450                         output p-dir-path
      451                       , output v-dir-type
      452                       , output v-can-write
      453                             )
      454         .
      455       if p-dir-path = ? then do:
      456         return.
      457       end.
      458       if not v-can-write then do:
      459           message
      460           substitute("Вы не имеете прав на запись в выбранный каталог &1", p-dir-path)
      461           view-as alert-box error .
      462           return error.
      463       end.
      464     end.
      465     file-info:file-name = p-dir-path.
      466     if file-info:file-type = ?
      467     or index( file-info:file-type, "D" ) = 0 then do:
      468       assign
      469       v-full-path-name = p-dir-path
      470       v-is-temp-file = yes
      471       .
      472     end.
      473     else do:
      474     assign
      475     v-full-path-name = entry(1, buf_ext-file.file-name, ">")
      476     v-full-path-name = prepare-path(v-full-path-name)
      477     v-full-path-name = p-dir-path + chr(47) +
      478                        entry(num-entries(v-full-path-name, chr(47))
      479                              , v-full-path-name
      480                              , chr(47)
      481                             )
      482     .
      483     end.
      484     assign
      485     file-info:file-name = v-full-path-name.
      486     if file-info:full-pathname <> ? then do:
      487       if p-override = 0
      488       then do:
      489         run gbl/daskfile.w (
      490                       input "Дальнейшие действия"
      491                      ,input v-full-path-name
      492                      ,input file-info:file-size
      493                      ,input file-info:file-mod-date
      494                      ,input file-info:file-mod-time
      495                      ,input buf_ext-file.file-name
      496                      ,input buf_Ext-file.file-size
      497                      ,input buf_Ext-file.update-sys-date
      498                      ,input buf_Ext-file.update-sys-time-int
      499                      ,input 4
      500                      ,input 6
      501                      ,output choice).
      502         if choice = 6
      503         then do:
      504           p-override = choice.
      505           return.
      506         end.
      507       end.
      508       if choice = 2
      509       or choice = 4
      510       or choice = 5
      511       then do:
      512         p-override = choice.
      513       end.
      514       if choice = 3
      515       or choice = 4 then do:
      516         return.
      517       end.
      518     end.
      519     if file-info:full-pathname = ?
      520     or (p-override = 1
      521     or p-override = 2
      522     or (p-override = 5
      523         and  (buf_Ext-file.update-sys-date > file-info:file-mod-date
      524               or
      525               (buf_Ext-file.update-sys-date = file-info:file-mod-date
      526               and buf_Ext-file.update-sys-time-int >= file-info:file-mod-time)
      527               )
      528        )
      529     )
      530     or v-is-temp-file = yes
      531     then do:
      532       run binfile_write-from-db in this-procedure (
      533          input p-db-num
      534         ,input  p-from-db-num
      535         ,input  p-file-num
      536         ,input  v-full-path-name
      537         ) .
      538       run gbl/md5.p (
      539           input  v-full-path-name
      540         ,output v-md5-signature
      541         ) .
      542       if buf_ext-file.crc-field <> v-md5-signature then do:
      543         if p-dir-path = ? then do:
      544           message
      545           substitute("!!!Сохраненный файл &1 имеет неверную сигнатуру md5 - удаляется с диска"
      546                 , v-full-path-name )
      547           view-as alert-box error .
      548           .
      549           os-delete value(v-full-path-name).
      550           return error .
      551         end.
      552         else do:
      553           return error  substitute("!!!Сохраненный файл &1 имеет неверную сигнатуру md5 - удаляется"
      554                 , v-full-path-name ).
      555         end.
      556       end.
      557     end.
      558   end.
