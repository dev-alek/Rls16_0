      165             buf_temp-ext-file-line.from-db-num  = p-from-db-num
      166             buf_temp-ext-file-line.file-num     = p-file-num
      167             buf_temp-ext-file-line.line-num     = v-line-num
      168             buf_temp-ext-file-line.sub-line-num = 0
      169             buf_temp-ext-file-line.line-text    = v-read-line
      170           .
      171         end.
      172       end.
      173       input stream sinp close .
      174       os-delete value(v-temp-full-pathname) .
      175     end.
      176   end procedure.
      177   procedure binfile_write :
      178     define input  parameter p-db-num        as integer   no-undo .
