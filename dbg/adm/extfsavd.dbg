      141                                         ,v-convert-full-pathname
      142                                         ,v-input-full-pathname
      143                                         ,v-temp-full-pathname
      144                                         )
      145       .
      146       os-command silent value(v-command-line) .
      147       input stream sinp from value(v-temp-full-pathname) .
      148       assign
      149         v-line-num = 0
      150       .
      151       repeat
      152       :
      153         assign
      154           v-read-line = '':U
      155         .
      156         import stream sinp unformatted v-read-line .
      157         if v-read-line <> '':U
      158         then do:
      159           assign
      160             v-line-num  = v-line-num + 1
      161           .
