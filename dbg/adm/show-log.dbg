        1   define variable vss-revision    as character no-undo init "$Revision$":U .
        2   define variable vss-author      as character no-undo init "$Author$":U .
        3   define variable vss-date        as character no-undo init "$Date$":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        5   define variable vss-archive     as character no-undo init "$Archive$":U .
        6   define variable vss-description as character no-undo init "Просмотр очереди текстовых сообщений".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   procedure proc-alt-shift-f2:
       66     if not ibs.th.gbl.gbl-var:rcode
       67   then
       68     run gbl\inidebug.p .
       69   end.
       70   procedure proc-alt-shift-f3:
       71     run gbl/prvssinf.p
       72       ( input this-procedure
       73       ) .
       74   end.
       75   define variable v-inform-launched as logical no-undo initial false .
       76   procedure proc-alt-shift-f4:
       77     define variable v-action as character no-undo .
       78     if v-inform-launched = false then do:
       79       assign
       80         v-inform-launched = true
       81       .
       82       run gbl/d-inform.w
       83         (  input self
       84         ,  input this-procedure
       85         , output v-action
       86         ) no-error .
       87       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       88       assign
       89         v-inform-launched = false
       90       .
       91     end.
       92   end.
       93   procedure proc-alt-f1:
       94     run gbl/corrhelp.p
       95       (input this-procedure
       96       ) .
       97   end .
       98   on alt-shift-f2 anywhere do:
       99     run proc-alt-shift-f2.
      100   end.
      101   on alt-shift-f3 anywhere do:
      102     run proc-alt-shift-f3 in this-procedure .
      103   end.
      104   on alt-shift-f4 anywhere do:
      105     run proc-alt-shift-f4 in this-procedure.
      106   end.
      107   on alt-f1 anywhere do:
      108     run proc-alt-f1 in this-procedure .
      109   end.
      110   define  shared temp-table cnf no-undo
      111       field param-code    as character   format "x(8)"        column-label "Код"                               field param-type    as character                        column-label "Тип"                               field param-value   as character   format "x(250)"      column-label "Значение"                          field param-encoded as character                        column-label "Кодированное значение"             field host-code     as integer                          column-label "Фирма"                             field obj-type      as character                        column-label "Тип объекта"                       field obj-code      as integer     format ">>>>>>"      column-label "Код объекта"                       field conf-type     as character                        column-label "Кодировка"                         field beg-date      as date                             column-label "Начало действия параметра"         field end-date      as date                             column-label "Окончание действия параметра"      field db-num        as integer     format ">>>>>"       column-label "БД"                                field stts          as integer                          column-label "Статус"
      112       field db-key        as character   format "x(12)"       column-label "Ключ БД"
      113       field param-PS      as character   format "x(40)"       column-label "PS"
      114       field param-name    as character   format "x(30)"       column-label "Название"
      115       field is-changed    as logical initial false            column-label "Изменен"
      116       field NotUsed       as logical initial False            column-label "Выключен"
      117       field ErrorExist    as integer initial 0  format ">>"   column-label "Уровень ошибки"
      118       index pi
      119         is unique
      120         param-code
      121         host-code
      122         obj-type
      123         obj-code
      124         beg-date
      125         end-date
      126         db-num
      127       index db-num
      128         db-num
      129       index db-key
      130         db-key
      131       index par-name
      132         is word-index
      133         param-name
      134       index par-value
      135         is word-index
      136         param-value
      137    .
      138   def  shared temp-table log-table no-undo
      139       field stroka       as character format "x(256)".
      140   def  shared variable err-level as integer no-undo.
      141   define stream log-file.
      142   DEFINE BUTTON b-clear
      143        LABEL "Очистить"
      144        SIZE 10 BY 1.
      145   DEFINE BUTTON b-help
      146        LABEL "Помо&щь"
      147        SIZE 10 BY 1.
      148   DEFINE BUTTON b-save
      149        LABEL "Сохранить"
      150        SIZE 12 BY 1.
      151   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      152        LABEL "&Выход"
      153        SIZE 10 BY 1
      154        BGCOLOR 8 .
      155   DEFINE QUERY br-log FOR
      156         log-table SCROLLING.
      157   DEFINE BROWSE br-log
      158     QUERY br-log DISPLAY
      159         stroka
      160       WITH NO-LABELS NO-COLUMN-SCROLLING SIZE 76.13 BY 12.88.
      161   DEFINE FRAME Dialog-Frame
      162        Btn_Cancel AT ROW 1 COL 1
      163        b-clear AT ROW 1 COL 11
      164        b-save AT ROW 1 COL 21
      165        b-help AT ROW 1 COL 33
      166        br-log AT ROW 2.63 COL 2.63
      167        SPACE(0.11) SKIP(0.19)
      168       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      169            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      170            TITLE "Просмотр протокола"
      171            CANCEL-BUTTON Btn_Cancel.
      172   ASSIGN
      173          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      174          FRAME Dialog-Frame:HIDDEN           = TRUE.
      175   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      176   DO:
      177     APPLY "END-ERROR":U TO SELF.
      178   END.
      179   ON CHOOSE OF b-clear IN FRAME Dialog-Frame
      180   DO:
      181     for each log-table:
      182        delete log-table.
      183     end.
      184     OPEN QUERY br-log FOR EACH log-table.
      185   END.
      186   ON CHOOSE OF b-save IN FRAME Dialog-Frame
      187   DO:
      188   define variable FName as character initial "cnf.log" no-undo.
      189   define variable OK    as logical   no-undo.
      190   system-dialog get-file fname
      191     filters "Текстовые файлы " "*.log,*.txt",
      192             "Все файлы" "*.*"
      193     ask-overwrite
      194     save-as
      195     title "Выберите имя файла для сохранения протокола"
      196     use-filename
      197     update ok.
      198     if ok = true then do:
      199        output stream log-file to value(Fname).
      200        for each log-table:
      201           put stream log-file  unformatted log-table.stroka skip.
      202        end.
      203        output stream log-file close.
      204     end.
      205   END.
      206   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      207   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      208   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      209   on help of frame Dialog-Frame
      210   do:
      211     run gbl/app_help.p
      212       (input this-procedure :file-name
      213       ,input ''
      214       ,input ?
      215       ) no-error.
      216     if error-status :error then do:
      217       message
      218         "Ошибка при вызове помощи"
      219         error-status :get-message(1)
      220         view-as alert-box .
      221     end.
      222   end.
      223   run minbtn-set in this-procedure .
      224   on choose of b-help in frame Dialog-Frame
      225   do:
      226     apply "help":u to frame Dialog-Frame .
      227   end.
      228   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      229   procedure minbtn-set :
      230       do
      231           on error undo, return error return-value
      232           :
      233           define variable ii              as integer       no-undo .
      234           define variable fh              as widget-handle no-undo .
      235           define variable hh              as widget-handle no-undo .
      236           define variable v-h             as handle        extent 4 no-undo .
      237           define variable v-name-button   as character     no-undo .
      238           define variable v-help-old-x    as decimal       no-undo .
      239           define variable v-help-old-y    as decimal       no-undo .
      240           define variable v-help-old-size as decimal       no-undo .
      241           define variable v-frame-width   as decimal       no-undo .
      242           define variable jj              as integer       no-undo .
      243           do
      244               on error undo, return error
      245               :
      246               assign
      247                   v-frame-width = frame Dialog-Frame:width - 0.3
      248                   fh            = frame Dialog-Frame:first-child
      249                   hh            = fh:first-child
      250                   ii            = 1
      251                   .
      252               do while valid-handle(hh):
      253                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      254                   do:
      255                       case lc(hh:name) :
      256                           when "b-help" then
      257                               do:
      258                                   hh:load-image-up("cmp/b-help.bmp":u) .
      259                                   hh:load-image-down("cmp/b-help.bmp":u) .
      260                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      261                                   hh:TOOLTIP = "Помощь" .
      262                                   v-help-old-x = hh:column .
      263                                   v-help-old-y = hh:row    .
      264                                   v-help-old-size = hh:width .
      265                                   hh:width-chars = 2.5 .
      266                               end.
      267                           when "b-print" then
      268                               do:
      269                                   hh:load-image("cmp/b-print.bmp":u) .
      270                                   hh:TOOLTIP = "Печать" .
      271                                   v-h[ii] = hh:handle .
      272                                   ii = ii + 1 .
      273                                   hh:width-chars = 3 .
      274                               end.
      275                           when "b-history" or
      276                           when "b-hist" then
      277                               do:
      278                                   hh:load-image("cmp/b-hist.bmp":u) .
      279                                   hh:TOOLTIP = "История" .
      280                                   v-h[ii] = hh:handle .
      281                                   ii = ii + 1 .
      282                                   hh:width-chars = 3 .
      283                               end.
      284                           when "b-sch" then
      285                               do:
      286                                   hh:load-image("cmp/b-sch.bmp":u) .
      287                                   hh:TOOLTIP = "Установка Фильтра" .
      288                                   v-h[ii] = hh:handle .
      289                                   ii = ii + 1 .
      290                                   hh:width-chars = 3 .
      291                               end.
      292                           when "b-hist-user" then
      293                               do:
      294                                   hh:load-image("cmp/b-hist.bmp":u) .
      295                                   hh:TOOLTIP = "История пользователя" .
      296                                   ii = ii + 1 .
      297                               end.
      298                       end case.
      299                   end.
      300                   hh = hh:next-sibling.
      301               end.
      302               b-help:column = v-frame-width - b-help:width-chars.
      303               jj = 0.
      304               repeat ii = 4 to 1 by -1 :
      305                   if valid-handle (v-h[ii] ) then
      306                   do:
      307                       jj  = jj + 1 .
      308                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      309                       v-h[ii]:row    = v-help-old-y .
      310                   end.
      311               end.
      312           end.
      313       end.
      314   end procedure.
      315   MAIN-BLOCK:
      316   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      317      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      318     RUN enable_UI.
      319     WAIT-FOR GO OF FRAME Dialog-Frame.
      320   END.
      321   RUN disable_UI.
      322   PROCEDURE disable_UI :
      323     HIDE FRAME Dialog-Frame.
      324   END PROCEDURE.
      325   PROCEDURE enable_UI :
      326     ENABLE Btn_Cancel b-clear b-save b-help br-log
      327         WITH FRAME Dialog-Frame.
      328     VIEW FRAME Dialog-Frame.
      329     OPEN QUERY br-log FOR EACH log-table.
      330   END PROCEDURE.
