      339            DEFAULT-BUTTON b-exit CANCEL-BUTTON B-quit.
      340   DEFINE FRAME Dialog-Frame
      341        "Представитель фирмы (для подписания) :" VIEW-AS TEXT
      342             SIZE 41.4 BY .87 AT ROW 5 COL 3.1
      343        "Коды для док-ов" VIEW-AS TEXT
      344             SIZE 16.8 BY 1 AT ROW 7 COL 24.9
      345             FGCOLOR 4
      346        "Банковские счета" VIEW-AS TEXT
      347             SIZE 25.9 BY 1 AT ROW 12.57 COL 23.3
      348             FGCOLOR 4
      349        "Налоги:" VIEW-AS TEXT
      350             SIZE 8.4 BY 1 AT ROW 17.53 COL 2.5
      351             FGCOLOR 4
      352        RECT-2 AT ROW 1 COL 1
      353        RECT-4 AT ROW 12.47 COL 1
      354        RECT-6 AT ROW 17.53 COL 1
      355        RECT-5 AT ROW 12.47 COL 69.1 WIDGET-ID 20
      356        RECT-7 AT ROW 20.2 COL 1 WIDGET-ID 28
      357        SPACE(30.79) SKIP(0.06)
      358       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      359            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      360            TITLE "Значения по умолчанию в блоке 'Взаиморасчеты' и для Финансовых документов"
      361            DEFAULT-BUTTON b-exit CANCEL-BUTTON B-quit.
      362   ASSIGN
      363          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      364          FRAME Dialog-Frame:HIDDEN           = TRUE.
      365   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      366   DO:
      367     APPLY "END-ERROR":U TO SELF.
      368   END.
      369   ON CHOOSE OF b-an-uchet IN FRAME Dialog-Frame
      370   DO:
      371     define variable rid-list as  char no-undo .
      372     define variable p-rec    as recid no-undo.
      373     define buffer buf_fin-code-an-uchet for ub.fin-code-An-uchet.
      374     assign p-rec = ? .
      375     if p-code-an-uchet <> ? then do:
      376       find first buf_fin-code-an-uchet no-lock where
      377                 buf_fin-code-an-uchet.fin-code = p-code-an-uchet
      378             and buf_fin-code-an-uchet.host-code = p-host-code no-error .
      379       if available buf_fin-code-an-uchet then assign p-rec = recid (buf_fin-code-an-uchet) .
      380     end.
      381     run ref/fwcode-3.w  ( input parParentProc
      382                         , input "b-sel,no-b-firm" + (if not is-fin then ",b-add,b-chg,b-del" else "")
      383                         , input 'фирма':U
      384                         , input p-rec
      385                         , input p-host-code
      386                         , output rid-list )  .
      387     if rid-list <> "" then do:
      388       find first buf_fin-code-an-uchet no-lock where
      389              RECID(buf_fin-code-an-uchet) = int (rid-list) no-error .
      390       if available buf_fin-code-an-uchet then do:
      391         assign
      392           an-uchet-name = buf_fin-code-an-uchet.code-value + "  " + buf_fin-code-an-uchet.descr
      393           p-code-an-uchet = buf_fin-code-an-uchet.fin-code
      394         .
      395         if buf_fin-code-an-uchet.status_ <> integer('0':U) then do:
      396           message
      397           "Вы выбрали удаленный код!"  view-as alert-box.
      398         end.
      399       end.
      400       else assign p-code-an-uchet = 0  an-uchet-name = "" .
      401     end.
      402     else assign p-code-an-uchet = 0  an-uchet-name = "" .
      403     display
      404     an-uchet-name
      405     with frame Dialog-Frame.
      406   END.
      407   ON CHOOSE OF b-bank-rub IN FRAME Dialog-Frame
      408   DO:
      409     define variable rid-list as  char no-undo .
      410     define variable v-status_ like ub.fin-schet.status_ no-undo init 'тек':U.
      411     define buffer buf_fin-schet for ub.fin-schet.
      412     define buffer buf_fin-bank for ub.fin-bank.
      413     if p-schet <> ? then do:
      414       find first buf_fin-schet no-lock where buf_fin-schet.code-schet = p-schet
      415              and buf_fin-schet.host-code = p-host-code no-error .
      416       if available buf_fin-schet then
      417       assign
      418       rid-list = string( recid (buf_fin-schet))
      419       v-status_ = buf_fin-schet.status_
      420       .
      421     end.
      422     run ref/finschts.w ( input parParentProc
      423                        , input p-host-code
      424                        , input "b-sel"
      425                        , input "cmp-host"
      426                        , input 'орг':U
      427                        , input p-host-code
      428                        , input 0
      429                        , input p-host-code
      430                        , input p-bank
      431                        , input-output v-status_
      432                        , input-output rid-list).
      433     if rid-list <> "" then do:
      434       find first buf_fin-schet no-lock where RECID(buf_fin-schet) = int (rid-list) no-error .
      435       if available buf_fin-schet then do:
      436         if buf_fin-schet.status_ = 'удал':U then do:
      437           message "Вы выбрали удаленный счет!"  view-as alert-box.
      438         end.
      439         assign
      440         bank-schet = buf_fin-schet.r-schet
      441         p-schet    = buf_fin-schet.code-schet
      442         p-bank     = buf_fin-schet.code-bank
      443         .
      444         find first buf_fin-bank no-lock where
      445                   buf_fin-bank.code-bank = p-bank
      446               and buf_fin-bank.host-code = p-host-code  no-error .
      447           assign
      448           bank-bik = buf_fin-bank.bik
      449           bank-rub = buf_fin-bank.short-name
      450           .
      451       end.
      452     end.
      453     else assign  p-bank = ?    p-schet = ? .
      454     display
      455     bank-rub
      456     bank-bik
      457     bank-schet
      458     with frame Dialog-Frame.
      459   END.
      460   ON CHOOSE OF b-cel-nazn IN FRAME Dialog-Frame
      461   DO:
      462     define variable rid-list as  char no-undo .
      463     define variable p-rec    as recid no-undo.
      464     define buffer buf_fin-code-cel-nazn for ub.fin-code-cel-nazn.
      465     assign p-rec = ? .
      466     if p-code-cel-nazn <> ? then do:
      467       find first buf_fin-code-cel-nazn no-lock where
      468                 buf_fin-code-cel-nazn.fin-code = p-code-cel-nazn
      469            and buf_fin-code-cel-nazn.host-code = p-host-code no-error .
      470       if available buf_fin-code-cel-nazn then assign p-rec = recid (buf_fin-code-cel-nazn) .
      471     end.
      472     run ref/fwcode-2.w  ( input parParentProc
      473                         , input "b-sel,no-b-firm" + (if not is-fin then ",b-add,b-chg,b-del" else "")
      474                         , input 'фирма':U
      475                         , input p-rec
      476                         , input p-host-code
      477                         , output rid-list )  .
      478     if rid-list <> "" then do:
      479       find first buf_fin-code-cel-nazn no-lock where
      480                 RECID(buf_fin-code-cel-nazn) = int (rid-list) no-error .
      481       if available buf_fin-code-cel-nazn then do:
      482         if buf_fin-code-cel-nazn.status_ <> integer('0':U) then DO:
      483           message
      484           "Вы выбрали удаленный код!"
      485           view-as alert-box.
      486         END.
      487         assign
      488         cel-nazn-name = buf_fin-code-cel-nazn.code-value + "  " + buf_fin-code-cel-nazn.descr
      489         p-code-cel-nazn = buf_fin-code-cel-nazn.fin-code
      490         .
      491       end.
      492       else assign p-code-cel-nazn = 0  cel-nazn-name = "" .
      493     end.
      494     else assign p-code-cel-nazn = 0  cel-nazn-name = "" .
      495     display
      496     cel-nazn-name
      497     with frame Dialog-Frame.
      498   END.
      499   ON CHOOSE OF b-cor-acc IN FRAME Dialog-Frame
      500   DO:
      501     define variable rid-list as  char no-undo .
      502     define variable p-rec    as recid no-undo.
      503     define buffer buf_fin-code-cor-acc for ub.fin-code-cor-acc.
      504     assign p-rec = ? .
      505     if p-code-cor-acc <> ? then do:
      506       find first buf_fin-code-cor-acc no-lock where
      507                 buf_fin-code-cor-acc.fin-code = p-code-cor-acc
      508             and buf_fin-code-cor-acc.host-code = p-host-code no-error .
      509       if available buf_fin-code-cor-acc then assign p-rec = recid (buf_fin-code-cor-acc) .
      510     end.
      511     run ref/fwcode-1.w  ( input parParentProc
      512                         , input "b-sel,no-b-firm" + (if not is-fin then ",b-add,b-chg,b-del" else "")
      513                         , input 'фирма':U
      514                         , input p-rec
      515                         , input p-host-code
      516                         , output rid-list )  .
      517     if rid-list <> "" then do:
      518       find first buf_fin-code-cor-acc no-lock where
      519            RECID(buf_fin-code-cor-acc) = int (rid-list) no-error .
      520       if available buf_fin-code-cor-acc then do:
      521         if buf_fin-code-cor-acc.status_ <> integer('0':U) then do:
      522           message
      523           "Вы выбрали удаленный код!"
      524           view-as alert-box.
      525         end.
      526         assign
      527         cor-acc-name = buf_fin-code-cor-acc.code-value + "  " + buf_fin-code-cor-acc.descr
      528         p-code-cor-acc = buf_fin-code-cor-acc.fin-code
      529         .
      530       end.
      531       else assign p-code-cor-acc = 0  cor-acc-name = "" .
      532     end.
      533     else assign p-code-cor-acc = 0  cor-acc-name = "" .
      534     display
      535     cor-acc-name
      536     with frame Dialog-Frame.
      537   END.
      538   ON CHOOSE OF b-cor-acc-2 IN FRAME Dialog-Frame
      539   DO:
      540     define variable rid-list as  char no-undo .
      541     define variable p-rec    as recid no-undo.
      542     define buffer buf_fin-code-cor-acc for ub.fin-code-cor-acc.
      543     assign p-rec = ? .
      544     if p-code-cor-acc-2 <> ? then do:
      545       find first buf_fin-code-cor-acc no-lock where
      546                 buf_fin-code-cor-acc.fin-code = p-code-cor-acc-2
      547             and buf_fin-code-cor-acc.host-code = p-host-code no-error .
      548       if available buf_fin-code-cor-acc then assign p-rec = recid (buf_fin-code-cor-acc) .
      549     end.
      550     run ref/fwcode-1.w  ( input parParentProc
      551                         , input "b-sel,no-b-firm" + (if not is-fin then ",b-add,b-chg,b-del" else "")
      552                         , input 'фирма':U
      553                         , input p-rec
      554                         , input p-host-code
      555                         , output rid-list )  .
      556     if rid-list <> "" then do:
      557       find first buf_fin-code-cor-acc no-lock where
      558                RECID(buf_fin-code-cor-acc) = int (rid-list) no-error .
      559       if available buf_fin-code-cor-acc then do:
      560         if buf_fin-code-cor-acc.status_ <> integer('0':U) then do:
      561           message
      562           "Вы выбрали удаленный код!"
      563           view-as alert-box.
      564         end.
      565         assign
      566         cor-acc-2-name = buf_fin-code-cor-acc.code-value + "  " + buf_fin-code-cor-acc.descr
      567         p-code-cor-acc-2 = buf_fin-code-cor-acc.fin-code
      568         .
      569       end.
      570       else assign p-code-cor-acc-2 = 0  cor-acc-2-name = "" .
      571     end.
      572     else assign p-code-cor-acc-2 = 0  cor-acc-2-name = "" .
      573     display
      574     cor-acc-2-name
      575     with frame Dialog-Frame.
      576   END.
      577   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      578   DO:
      579     IF p-mode <> 'ИЗМЕНЕНИЕ':U THEN RETURN NO-APPLY.
      580     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      581     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      582   END.
      583   ON VALUE-CHANGED OF RADIO-SET-1 IN FRAME Dialog-Frame
      584   DO:
      585   define buffer buf_fin-code-an-uchet for ub.fin-code-an-uchet.
      586   define buffer buf_fin-code-cel-nazn for ub.fin-code-cel-nazn.
      587   define buffer buf_fin-code-cor-acc for ub.fin-code-cor-acc.
      588     assign
      589       a-code-an-uchet  [RADIO-SET-1] = p-code-an-uchet
      590       a-code-cel-nazn  [RADIO-SET-1] = p-code-cel-nazn
      591       a-code-cor-acc   [RADIO-SET-1] = p-code-cor-acc
      592       a-code-cor-acc-2 [RADIO-SET-1] = p-code-cor-acc-2
      593     .
      594     assign RADIO-SET-1 .
      595     assign
      596       p-code-an-uchet  = a-code-an-uchet  [RADIO-SET-1]
      597       p-code-cel-nazn  = a-code-cel-nazn  [RADIO-SET-1]
      598       p-code-cor-acc   = a-code-cor-acc   [RADIO-SET-1]
      599       p-code-cor-acc-2 = a-code-cor-acc-2 [RADIO-SET-1]
      600     .
      601     find first buf_fin-code-an-uchet no-lock where
      602             buf_fin-code-an-uchet.fin-code = p-code-an-uchet
      603         and buf_fin-code-an-uchet.host-code = p-host-code no-error .
      604     if available buf_fin-code-an-uchet then   do:
      605       assign
      606       an-uchet-name = buf_fin-code-an-uchet.code-value + "  " + buf_fin-code-an-uchet.descr  .
      607     end.
      608     else do:
      609       assign
      610       an-uchet-name = "" .
      611     end.
      612     find first buf_fin-code-cel-nazn no-lock where
      613               buf_fin-code-cel-nazn.fin-code  = p-code-cel-nazn
      614           and buf_fin-code-cel-nazn.host-code = p-host-code no-error .
      615     if available buf_fin-code-cel-nazn then do:
      616       assign
      617       cel-nazn-name = buf_fin-code-cel-nazn.code-value + "  " + buf_fin-code-cel-nazn.descr .
      618     end.
      619     else do:
      620       assign
      621       cel-nazn-name = "" .
      622     end.
      623     find first buf_fin-code-cor-acc no-lock where
      624              buf_fin-code-cor-acc.fin-code  = p-code-cor-acc
      625          and buf_fin-code-cor-acc.host-code = p-host-code no-error .
      626     if available buf_fin-code-cor-acc  then do:
      627       assign
      628       cor-acc-name = buf_fin-code-cor-acc.code-value + "  " + buf_fin-code-cor-acc.descr .
      629     end.
      630     else do:
      631       assign
      632       cor-acc-name = "" .
      633     end.
      634     find first buf_fin-code-cor-acc no-lock where
      635               buf_fin-code-cor-acc.fin-code  = p-code-cor-acc-2
      636           and buf_fin-code-cor-acc.host-code = p-host-code no-error .
      637     if available buf_fin-code-cor-acc  then do:
      638       assign
      639       cor-acc-2-name = buf_fin-code-cor-acc.code-value + "  " + buf_fin-code-cor-acc.descr .
      640     end.
      641     else do:
      642       assign
      643       cor-acc-2-name = "" .
      644     end.
      645     display
      646     cor-acc-2-name
      647     cor-acc-name
      648     cel-nazn-name
      649     an-uchet-name
      650     with frame Dialog-Frame.
      651     if RADIO-SET-1 > 2 then do:
      652       ENABLE
      653       b-cor-acc-2
      654       WITH FRAME Dialog-Frame .
      655      end.
      656     else do:
      657       DISABLE
      658       b-cor-acc-2
      659       WITH FRAME Dialog-Frame .
      660     end.
      661   END.
      662   ON VALUE-CHANGED OF tt-sysconf.usl-opl IN FRAME Dialog-Frame
      663   DO:
      664     assign tt-sysconf.usl-opl .
      665     if tt-sysconf.usl-opl = 'Отсрочка платежа (по реализации)':U
      666     or tt-sysconf.usl-opl = 'Отсрочка платежа (по поставке)':U
      667     or tt-sysconf.usl-opl = 'По реализации части приход. накладной':U
      668     or tt-sysconf.usl-opl = 'Предоплата(%)':U then enable tt-sysconf.srok-opl with frame Dialog-Frame.
      669     else do:
      670       assign tt-sysconf.srok-opl = 0 .
      671       disable tt-sysconf.srok-opl with frame Dialog-Frame.
      672     end.
      673     if tt-sysconf.usl-opl = 'По реализации части приход. накладной':U
      674     or tt-sysconf.usl-opl = 'Предоплата(%)':U then assign tt-sysconf.srok-opl:label = "> %" .
      675     else assign tt-sysconf.srok-opl:label = "Срок" .
      676     display
      677     tt-sysconf.srok-opl
      678     with frame Dialog-Frame.
      679   END.
      680   ON VALUE-CHANGED OF tt-sysconf.usl-opl-sf IN FRAME Dialog-Frame
      681   DO:
      682     assign
      683     tt-sysconf.usl-opl-sf
      684     tt-sysconf.srok-opl-sf = 0
      685     .
      686     disable
      687     tt-sysconf.srok-opl-sf
      688     with frame Dialog-Frame.
      689     display
      690     tt-sysconf.srok-opl-sf
      691     with frame Dialog-Frame.
      692   END.
      693   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      694   on help of frame Dialog-Frame
      695   do:
      696     run gbl/app_help.p
      697       (input this-procedure :file-name
      698       ,input ''
      699       ,input ?
      700       ) no-error.
      701     if error-status :error then do:
      702       message
      703         "Ошибка при вызове помощи"
      704         error-status :get-message(1)
      705         view-as alert-box .
      706     end.
      707   end.
      708   run minbtn-set in this-procedure .
      709   on choose of b-help in frame Dialog-Frame
      710   do:
      711     apply "help":u to frame Dialog-Frame .
      712   end.
      713   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      714   procedure minbtn-set :
      715       do
      716           on error undo, return error return-value
      717           :
      718           define variable ii              as integer       no-undo .
      719           define variable fh              as widget-handle no-undo .
      720           define variable hh              as widget-handle no-undo .
      721           define variable v-h             as handle        extent 4 no-undo .
      722           define variable v-name-button   as character     no-undo .
      723           define variable v-help-old-x    as decimal       no-undo .
      724           define variable v-help-old-y    as decimal       no-undo .
      725           define variable v-help-old-size as decimal       no-undo .
      726           define variable v-frame-width   as decimal       no-undo .
      727           define variable jj              as integer       no-undo .
      728           do
      729               on error undo, return error
      730               :
      731               assign
      732                   v-frame-width = frame Dialog-Frame:width - 0.3
      733                   fh            = frame Dialog-Frame:first-child
      734                   hh            = fh:first-child
      735                   ii            = 1
      736                   .
      737               do while valid-handle(hh):
      738                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      739                   do:
      740                       case lc(hh:name) :
      741                           when "b-help" then
      742                               do:
      743                                   hh:load-image-up("cmp/b-help.bmp":u) .
      744                                   hh:load-image-down("cmp/b-help.bmp":u) .
      745                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      746                                   hh:TOOLTIP = "Помощь" .
      747                                   v-help-old-x = hh:column .
      748                                   v-help-old-y = hh:row    .
      749                                   v-help-old-size = hh:width .
      750                                   hh:width-chars = 2.5 .
      751                               end.
      752                           when "b-print" then
      753                               do:
      754                                   hh:load-image("cmp/b-print.bmp":u) .
      755                                   hh:TOOLTIP = "Печать" .
      756                                   v-h[ii] = hh:handle .
      757                                   ii = ii + 1 .
      758                                   hh:width-chars = 3 .
      759                               end.
      760                           when "b-history" or
      761                           when "b-hist" then
      762                               do:
      763                                   hh:load-image("cmp/b-hist.bmp":u) .
      764                                   hh:TOOLTIP = "История" .
      765                                   v-h[ii] = hh:handle .
      766                                   ii = ii + 1 .
      767                                   hh:width-chars = 3 .
      768                               end.
      769                           when "b-sch" then
      770                               do:
      771                                   hh:load-image("cmp/b-sch.bmp":u) .
      772                                   hh:TOOLTIP = "Установка Фильтра" .
      773                                   v-h[ii] = hh:handle .
      774                                   ii = ii + 1 .
      775                                   hh:width-chars = 3 .
      776                               end.
      777                           when "b-hist-user" then
      778                               do:
      779                                   hh:load-image("cmp/b-hist.bmp":u) .
      780                                   hh:TOOLTIP = "История пользователя" .
      781                                   ii = ii + 1 .
      782                               end.
      783                       end case.
      784                   end.
      785                   hh = hh:next-sibling.
      786               end.
      787               b-help:column = v-frame-width - b-help:width-chars.
      788               jj = 0.
      789               repeat ii = 4 to 1 by -1 :
      790                   if valid-handle (v-h[ii] ) then
      791                   do:
      792                       jj  = jj + 1 .
      793                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      794                       v-h[ii]:row    = v-help-old-y .
      795                   end.
      796               end.
      797           end.
      798       end.
      799   end procedure.
      800   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      801   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      802   MAIN-BLOCK:
      803   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      804      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      805      ON STOP UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      806      :
      807   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      808     run mainmenu_getcntxt in parparentproc
      809       (output v-cntxt-db-num
      810       ,output v-cntxt-userid
      811       ,output v-cntxt-level
      812       ,output v-cntxt-host-code-obj
      813       ,output v-cntxt-obj-type
      814       ,output v-cntxt-obj-code
      815       ,output v-cntxt-db-num-obj
      816       ,output v-cntxt-is-admin
      817       ) .
      818     if  p-mode <> 'ИЗМЕНЕНИЕ':U
      819     and p-mode <> 'ПРОСМОТР':U
      820     then do:
      821       message
      822         vss-workfile vss-revision vss-description skip
      823         "Неверное значение параметров вызова p-mode"  p-mode
      824         view-as alert-box error .
      825       undo, return error.
      826     end.
      827     if p-mode <> 'ПРОСМОТР':U
      828     then do:
      829       if v-cntxt-db-num <> 0
      830       then do:
      831         message
      832         vss-workfile vss-revision vss-description skip
      833         "Неверное значение параметров вызова p-mode - нельзя изменять записи ФИРМЫ в УБД"
      834         view-as alert-box ERROR.
      835         undo, return error.
      836       end.
      837     end.
      838     for each tt-sysconf
      839     :
      840       delete tt-sysconf.
      841     end.
      842   if p-mode = 'ИЗМЕНЕНИЕ':U
      843   then do:
      844     do transaction:
      845     find first locked_sysconf exclusive-lock
      846       where locked_sysconf.host-code = p-host-code
      847       no-wait
      848       no-error .
      849     if not available locked_sysconf
      850     then do:
      851       if locked locked_sysconf
      852       then do:
      853         find first locked_sysconf exclusive-lock
      854           where locked_sysconf.host-code = p-host-code
      855           no-error .
      856       end.
      857       else do:
      858         message
      859           vss-workfile vss-revision vss-description skip
      860           "Ошибка при поиске фирмы" skip
      861           "Код фирмы" p-host-code skip
      862           view-as alert-box error .
      863       end.
      864       undo, return error.
      865     end.
      866     end.
      867     end.
      868     else do:
      869       find first locked_sysconf no-lock
      870         where locked_sysconf.host-code = p-host-code .
      871     end.
      872     create tt-sysconf.
      873     buffer-copy Locked_sysconf to tt-sysconf.
      874     RUN fill-widgets IN THIS-PROCEDURE .
      875     RUN MyEnable IN this-procedure.
      876     WAIT-FOR GO OF FRAME Dialog-Frame.
      877   END.
      878   RUN disable_UI.
      879   PROCEDURE disable_UI :
      880     HIDE FRAME Dialog-Frame.
      881   END PROCEDURE.
      882   PROCEDURE enable_UI :
      883     OPEN QUERY Dialog-Frame FOR EACH tt-sysconf SHARE-LOCK.
      884     GET FIRST Dialog-Frame.
      885     DISPLAY COMBO-auto-pay COMBO-auto-pay-2 RADIO-SET-1 Is-fin-copy COMBO-fin-firm
      886             cor-acc-name an-uchet-name cel-nazn-name cor-acc-2-name bank-schet
      887             bank-bik bank-rub
      888         WITH FRAME Dialog-Frame.
      889     IF AVAILABLE tt-sysconf THEN
      890       DISPLAY tt-sysconf.contract-type tt-sysconf.contract-city tt-sysconf.usl-opl
      891             tt-sysconf.srok-opl tt-sysconf.usl-opl-sf tt-sysconf.srok-opl-sf
      892             tt-sysconf.pay-sign-post tt-sysconf.pay-sign tt-sysconf.is-an-uchet
      893             tt-sysconf.is-code-cel-nazn tt-sysconf.is-corr-acc
      894             tt-sysconf.is-cassa-acc tt-sysconf.fin-VAT-pc tt-sysconf.fin-calc
      895         WITH FRAME Dialog-Frame.
      896     ENABLE b-exit B-quit b-help RECT-2 RECT-4 RECT-6 RECT-5 RECT-7
      897            tt-sysconf.contract-type tt-sysconf.contract-city tt-sysconf.usl-opl
      898            tt-sysconf.srok-opl COMBO-auto-pay tt-sysconf.usl-opl-sf
      899            tt-sysconf.srok-opl-sf COMBO-auto-pay-2 tt-sysconf.pay-sign-post
      900            tt-sysconf.pay-sign RADIO-SET-1 b-cor-acc b-an-uchet b-cel-nazn
      901            b-cor-acc-2 tt-sysconf.is-an-uchet b-bank-rub
      902            tt-sysconf.is-code-cel-nazn tt-sysconf.is-corr-acc
      903            tt-sysconf.is-cassa-acc tt-sysconf.fin-VAT-pc tt-sysconf.fin-calc
      904            Is-fin-copy COMBO-fin-firm
      905         WITH FRAME Dialog-Frame.
      906     VIEW FRAME Dialog-Frame.
      907   END PROCEDURE.
      908   PROCEDURE fill-widgets :
      909   DEFINE BUFFER buf_fin-code-an-uchet FOR ub.fin-code-an-uchet.
      910   DEFINE BUFFER buf_fin-code-cel-nazn FOR ub.fin-code-cel-nazn.
      911   DEFINE BUFFER buf_fin-code-cor-acc FOR ub.fin-code-cor-acc.
      912   DEFINE BUFFER buf_fin-schet FOR ub.fin-schet.
      913   DEFINE BUFFER buf_fin-bank FOR ub.fin-bank.
      914   assign
      915   a-code-an-uchet  [2] = tt-sysconf.an-uchet-code-in
      916   a-code-cel-nazn  [2] = tt-sysconf.cel-nazn-code-in
      917   a-code-cor-acc   [2] = tt-sysconf.cor-acc-in
      918   a-code-cor-acc-2 [2] = tt-sysconf.cor-acc1-in
      919   a-code-an-uchet  [3] = tt-sysconf.an-uchet-code-out-cash
      920   a-code-cel-nazn  [3] = tt-sysconf.cel-nazn-code-out-cash
      921   a-code-cor-acc   [3] = tt-sysconf.cor-acc-out-cash
      922   a-code-cor-acc-2 [3] = tt-sysconf.cor-acc1-out-cash
      923   a-code-an-uchet  [4] = tt-sysconf.an-uchet-code-in-cash
      924   a-code-cel-nazn  [4] = tt-sysconf.cel-nazn-code-in-cash
      925   a-code-cor-acc   [4] = tt-sysconf.cor-acc-in-cash
      926   a-code-cor-acc-2 [4] = tt-sysconf.cor-acc1-in-cash
      927   a-code-an-uchet  [5] = tt-sysconf.an-uchet-code-out-payoff
      928   a-code-cel-nazn  [5] = tt-sysconf.cel-nazn-code-out-payoff
      929   a-code-cor-acc   [5] = tt-sysconf.cor-acc-out-payoff
      930   a-code-cor-acc-2 [5] = tt-sysconf.cor-acc1-out-payoff
      931   a-code-an-uchet  [6] = tt-sysconf.an-uchet-code-in-payoff
      932   a-code-cel-nazn  [6] = tt-sysconf.cel-nazn-code-in-payoff
      933   a-code-cor-acc   [6] = tt-sysconf.cor-acc-in-payoff
      934   a-code-cor-acc-2 [6] = tt-sysconf.cor-acc1-in-payoff
      935   .
      936   find first buf_fin-code-an-uchet no-lock where
      937            buf_fin-code-an-uchet.fin-code = tt-sysconf.an-uchet-code-out
      938        and buf_fin-code-an-uchet.host-code = tt-sysconf.host-code no-error .
      939   if available buf_fin-code-an-uchet then
      940     assign
      941     an-uchet-name = buf_fin-code-an-uchet.code-value + "  " + buf_fin-code-an-uchet.descr
      942     p-code-an-uchet = tt-sysconf.an-uchet-code-out
      943     .
      944   else do:
      945     assign p-code-an-uchet = 0 .
      946   end.
      947   assign
      948   a-code-an-uchet [1] = p-code-an-uchet .
      949   find first buf_fin-code-cel-nazn no-lock where
      950            buf_fin-code-cel-nazn.fin-code  = tt-sysconf.cel-nazn-code-out
      951        and buf_fin-code-cel-nazn.host-code = tt-sysconf.host-code no-error .
      952   if available buf_fin-code-cel-nazn then
      953     assign
      954     cel-nazn-name = buf_fin-code-cel-nazn.code-value + "  " + buf_fin-code-cel-nazn.descr
      955     p-code-cel-nazn = tt-sysconf.cel-nazn-code-out
      956     .
      957   else do:
      958     assign p-code-cel-nazn = ? .
      959   end.
      960   assign
      961   a-code-cel-nazn [1] = p-code-cel-nazn .
      962   find first buf_fin-code-cor-acc no-lock where
      963             buf_fin-code-cor-acc.fin-code  = tt-sysconf.cor-acc-out
      964         and buf_fin-code-cor-acc.host-code = tt-sysconf.host-code no-error .
      965   if available buf_fin-code-cor-acc then
      966     assign
      967       cor-acc-name = buf_fin-code-cor-acc.code-value + "  " + buf_fin-code-cor-acc.descr
      968       p-code-cor-acc = tt-sysconf.cor-acc-out
      969     .
      970   else do:
      971     assign
      972     p-code-cor-acc = ? .
      973   end.
      974   assign
      975   a-code-cor-acc [1] = p-code-cor-acc .
      976   find first buf_fin-code-cor-acc no-lock where
      977             buf_fin-code-cor-acc.fin-code  = tt-sysconf.cor-acc1-out
      978         and buf_fin-code-cor-acc.host-code = tt-sysconf.host-code no-error .
      979   if available buf_fin-code-cor-acc then
      980     assign
      981       cor-acc-2-name = buf_fin-code-cor-acc.code-value + "  " + buf_fin-code-cor-acc.descr
      982       p-code-cor-acc-2 = tt-sysconf.cor-acc1-out
      983     .
      984   else do:
      985     assign p-code-cor-acc-2 = ? .
      986   end.
      987   assign
      988   a-code-cor-acc-2 [1] = p-code-cor-acc-2 .
      989     find first buf_fin-schet no-lock where
      990               buf_fin-schet.code-schet = tt-sysconf.pay-code-schet-rubl
      991           and buf_fin-schet.host-code = tt-sysconf.host-code no-error .
      992     if available buf_fin-schet then do:
      993       assign
      994       bank-schet = buf_fin-schet.r-schet
      995       p-schet    = buf_fin-schet.code-schet
      996       p-bank     = buf_fin-schet.code-bank  .
      997       find first buf_fin-bank no-lock where
      998                 buf_fin-bank.code-bank = p-bank
      999            and buf_fin-bank.host-code = tt-sysconf.host-code no-error .
     1000       assign
     1001       bank-bik = buf_fin-bank.bik
     1002       bank-rub = buf_fin-bank.short-name  .
     1003     end.
     1004     else assign  p-bank = ?    p-schet = ? .
     1005   END PROCEDURE.
     1006   PROCEDURE MyEnable :
     1007   DEFINE VARIABLE temp-string AS CHARACTER NO-UNDO.
     1008   DEFINE BUFFER buf_sysconf FOR ub.sysconf.
     1009   DEFINE BUFFER buf_clients FOR ub.clients.
     1010     assign
     1011       temp-string = ""
     1012     .
     1013     for each buf_sysconf no-lock :
     1014       find first buf_clients NO-LOCK where
     1015                 buf_clients.obj-code = buf_sysconf.host-code
     1016             and buf_clients.obj-type = 'орг':U no-error .
     1017       if temp-string = ""
     1018       then do:
     1019         assign
     1020         temp-string = string(buf_sysconf.host-code,">>>>>>>>>9") + " " + buf_clients.obj-name  .
     1021       end.
     1022       else do:
     1023         assign
     1024         temp-string = temp-string + "," + string(buf_sysconf.host-code,">>>>>>>>>9") + " " + buf_clients.obj-name
     1025         .
     1026       end.
     1027     end.
     1028     ASSIGN
     1029     COMBO-fin-firm:LIST-ITEMS IN FRAME Dialog-Frame = temp-string.
     1030   tt-sysconf.contract-type:list-items IN FRAME Dialog-Frame = "Не задан" + "," + 'Купли-продажи,Консигнации,Ответственного хранения,Агентский договор,Давальческого сырья,Продажи через ТПСИ,о Дополнительных расходах':U .
     1031   if tt-sysconf.contract-type <> "" and tt-sysconf.contract-type <> ?
     1032   then tt-sysconf.contract-type:screen-value = tt-sysconf.contract-type .
     1033   else tt-sysconf.contract-type:screen-value = "Не задан" .
     1034   tt-sysconf.usl-opl:list-items   =  'Не определено,По заказу,По поставке заказа,Отсрочка платежа по заказу,Отсрочка платежа по поставке заказа,По факту поставки,По факту реализации,Отсрочка платежа (по поставке),Отсрочка платежа (по реализации),По реализации части приход. накладной,По спецификации,Отсрочка платежа по спецификации,Предоплата,Предоплата(%),По факту поставки покупателю,Отсрочка платежа по поставке':U .
     1035   if tt-sysconf.usl-opl <> "" and tt-sysconf.usl-opl <> ? then tt-sysconf.usl-opl:screen-value = tt-sysconf.usl-opl .
     1036   else tt-sysconf.usl-opl:screen-value = 'Не определено':U .
     1037   tt-sysconf.usl-opl-sf:list-items   = 'Не определено':U + chr(44)  +
     1038                                        'По приходной накладной':U + chr(44)  +
     1039                                        'По фин. обязательству':U + chr(44)  +
     1040                                        'По платежу':U + chr(44) +
     1041                                        'По накл. смены типа преобр.':U.
     1042   if tt-sysconf.usl-opl-sf <> "" and tt-sysconf.usl-opl-sf <> ?
     1043   then tt-sysconf.usl-opl-sf:screen-value = tt-sysconf.usl-opl-sf .
     1044   COMBO-auto-pay:list-items = "фин.об. авто" + "," + "фин.об. факт" + "," + "платеж новый"  .
     1045   COMBO-auto-pay-2:list-items = "новый" + "," + "факт" .
     1046   case tt-sysconf.auto-pay :
     1047   when 0 then COMBO-auto-pay:screen-value = "фин.об. авто" .
     1048   when 1 then COMBO-auto-pay:screen-value = "фин.об. факт" .
     1049   when 2 then COMBO-auto-pay:screen-value = "платеж новый" .
     1050   when 3 then COMBO-auto-pay:screen-value = "платеж разр" .
     1051   when 4 then COMBO-auto-pay:screen-value = "платеж факт" .
     1052   end.
     1053   case tt-sysconf.auto-pay-sf :
     1054   when 0 then COMBO-auto-pay-2:screen-value = "новый" .
     1055   when 1 then COMBO-auto-pay-2:screen-value = "факт" .
     1056   end.
     1057   if   tt-sysconf.usl-opl = 'Отсрочка платежа (по реализации)':U
     1058   or tt-sysconf.usl-opl = 'Отсрочка платежа (по поставке)':U
     1059   or tt-sysconf.usl-opl = 'Предоплата(%)':U
     1060   or tt-sysconf.usl-opl = 'По реализации части приход. накладной':U  then do:
     1061     assign
     1062     tt-sysconf.srok-opl = tt-sysconf.srok-opl .
     1063     if tt-sysconf.usl-opl = 'По реализации части приход. накладной':U or tt-sysconf.usl-opl = 'Предоплата(%)':U
     1064     then assign tt-sysconf.srok-opl:label = "> %" .
     1065   end.
     1066   IF NOT is-fin THEN DO:
     1067     ASSIGN
     1068     radio-set-1:RADIO-BUTTONS IN FRAME Dialog-Frame =
     1069     'рко':U + chr(44) + "3" + chr(44) +
     1070     'пко':U + chr(44) +  "4"
     1071     .
     1072     radio-set-1 = 3.
     1073   END.
     1074   else do:
     1075     radio-set-1 = 1.
     1076   end.
     1077   DISPLAY
     1078   COMBO-auto-pay
     1079   COMBO-auto-pay-2
     1080   RADIO-SET-1
     1081   cor-acc-name
     1082   an-uchet-name
     1083   cel-nazn-name
     1084   cor-acc-2-name
     1085   bank-schet
     1086   bank-bik
     1087   bank-rub
     1088   WITH FRAME Dialog-Frame.
     1089   IF AVAILABLE tt-sysconf THEN
     1090   DISPLAY
     1091   tt-sysconf.contract-type
     1092   tt-sysconf.contract-city
     1093   tt-sysconf.usl-opl
     1094   tt-sysconf.srok-opl
     1095   tt-sysconf.usl-opl-sf
     1096   tt-sysconf.srok-opl-sf
     1097   tt-sysconf.pay-sign-post
     1098   tt-sysconf.pay-sign
     1099   tt-sysconf.is-an-uchet
     1100   tt-sysconf.is-code-cel-nazn
     1101   tt-sysconf.fin-VAT-pc
     1102   tt-sysconf.is-corr-acc
     1103   tt-sysconf.is-cassa-acc
     1104   tt-sysconf.fin-calc
     1105   WITH FRAME Dialog-Frame.
     1106   ENABLE
     1107   b-exit WHEN p-mode <> 'ПРОСМОТР':U
     1108   RECT-2 RECT-4 RECT-6 RECT-5
     1109   B-quit
     1110   b-help
     1111   tt-sysconf.contract-type WHEN p-mode <> 'ПРОСМОТР':U AND is-fin
     1112   tt-sysconf.contract-city WHEN p-mode <> 'ПРОСМОТР':U AND is-fin
     1113   tt-sysconf.usl-opl  WHEN p-mode <> 'ПРОСМОТР':U AND is-fin
     1114   tt-sysconf.srok-opl WHEN p-mode <> 'ПРОСМОТР':U AND is-fin
     1115   COMBO-auto-pay WHEN p-mode <> 'ПРОСМОТР':U AND is-fin
     1116   tt-sysconf.usl-opl-sf WHEN p-mode <> 'ПРОСМОТР':U AND is-fin
     1117   tt-sysconf.srok-opl-sf WHEN p-mode <> 'ПРОСМОТР':U AND is-fin
     1118   COMBO-auto-pay-2 WHEN p-mode <> 'ПРОСМОТР':U AND is-fin
     1119   tt-sysconf.pay-sign-post WHEN p-mode <> 'ПРОСМОТР':U AND is-fin
     1120   tt-sysconf.pay-sign WHEN p-mode <> 'ПРОСМОТР':U AND is-fin
     1121   RADIO-SET-1
     1122   b-cor-acc   WHEN p-mode <> 'ПРОСМОТР':U AND VALID-HANDLE (parparentproc)
     1123   b-an-uchet WHEN p-mode <> 'ПРОСМОТР':U AND VALID-HANDLE (parparentproc)
     1124   b-cel-nazn WHEN p-mode <> 'ПРОСМОТР':U AND VALID-HANDLE (parparentproc)
     1125   b-cor-acc-2 WHEN p-mode <> 'ПРОСМОТР':U AND VALID-HANDLE (parparentproc)
     1126   b-bank-rub WHEN p-mode <> 'ПРОСМОТР':U AND VALID-HANDLE (parparentproc) AND is-fin
     1127   tt-sysconf.is-an-uchet WHEN p-mode <> 'ПРОСМОТР':U
     1128   tt-sysconf.is-code-cel-nazn WHEN p-mode <> 'ПРОСМОТР':U
     1129   tt-sysconf.fin-VAT-pc WHEN p-mode <> 'ПРОСМОТР':U AND is-fin
     1130   tt-sysconf.is-corr-acc WHEN p-mode <> 'ПРОСМОТР':U
     1131   tt-sysconf.is-cassa-acc WHEN p-mode <> 'ПРОСМОТР':U
     1132   tt-sysconf.fin-calc WHEN p-mode <> 'ПРОСМОТР':U   AND is-fin
     1133   Is-fin-copy WHEN p-mode <> 'ПРОСМОТР':U AND is-fin
     1134   COMBO-fin-firm WHEN p-mode <> 'ПРОСМОТР':U AND is-fin
     1135   WITH FRAME Dialog-Frame.
     1136   VIEW FRAME Dialog-Frame.
     1137   if p-mode = 'ПРОСМОТР':U then do:
     1138       ASSIGN
     1139       b-quit:LABEL = "&Выход"
     1140       b-quit:COLUMN = 1
     1141       .
     1142       HIDE
     1143       b-exit
     1144       Is-fin-copy
     1145       COMBO-fin-firm
     1146       IN FRAME Dialog-Frame.
     1147   end.
     1148   else do:
     1149       if   tt-sysconf.usl-opl = 'Не определено':U
     1150         or tt-sysconf.usl-opl = 'По факту поставки':U
     1151         or tt-sysconf.usl-opl = 'По факту реализации':U
     1152       then  do:
     1153         disable
     1154         tt-sysconf.srok-opl
     1155         with frame Dialog-Frame.
     1156       end.
     1157       disable
     1158       tt-sysconf.srok-opl-sf
     1159       with frame Dialog-Frame.
     1160   end.
     1161   apply "VALUE-CHANGED" to RADIO-SET-1 in frame Dialog-Frame.
     1162   END PROCEDURE.
     1163   PROCEDURE proc-save :
     1164   define variable v-rid as recid no-undo .
     1165   define variable v-fin-host-copy like ub.sysconf.host-code no-undo .
     1166   assign
     1167   FRAME Dialog-Frame
     1168   RADIO-SET-1
     1169   COMBO-auto-pay
     1170   COMBO-auto-pay-2
     1171   is-fin-copy
     1172   COMBO-fin-firm
     1173   .
     1174   assign
     1175   v-fin-host-copy = int(substr(COMBO-fin-firm,1,6))
     1176   no-error
     1177   .
     1178   assign
     1179   a-code-an-uchet  [RADIO-SET-1] = p-code-an-uchet
     1180   a-code-cel-nazn  [RADIO-SET-1] = p-code-cel-nazn
     1181   a-code-cor-acc   [RADIO-SET-1] = p-code-cor-acc
     1182   a-code-cor-acc-2 [RADIO-SET-1] = p-code-cor-acc-2
     1183   .
     1184   case COMBO-auto-pay:screen-value IN FRAME Dialog-Frame:
     1185     when "фин.об. авто" then tt-sysconf.auto-pay = 0 .
     1186     when "фин.об. факт" then tt-sysconf.auto-pay = 1 .
     1187     when "платеж новый" then tt-sysconf.auto-pay = 2 .
     1188     when "платеж разр"  then tt-sysconf.auto-pay = 3 .
     1189     when "платеж факт"  then tt-sysconf.auto-pay = 4 .
     1190   end.
     1191   case COMBO-auto-pay-2:screen-value :
     1192     when "новый" then tt-sysconf.auto-pay-sf = 0 .
     1193     when "факт" then tt-sysconf.auto-pay-sf = 1 .
     1194   end.
     1195   ASSIGN
     1196   tt-sysconf.contract-city
     1197   tt-sysconf.contract-type
     1198   tt-sysconf.pay-sign-post
     1199   tt-sysconf.pay-sign
     1200   tt-sysconf.fin-VAT-pc
     1201   tt-sysconf.srok-opl
     1202   tt-sysconf.srok-opl-sf
     1203   tt-sysconf.usl-opl
     1204   tt-sysconf.usl-opl-sf
     1205   tt-sysconf.is-an-uchet
     1206   tt-sysconf.is-code-cel-nazn
     1207   tt-sysconf.is-corr-acc
     1208   tt-sysconf.is-cassa-acc
     1209   tt-sysconf.fin-calc
     1210   tt-sysconf.pay-code-schet-rubl = p-schet
     1211   tt-sysconf.pay-code-schet-base = p-schet1
     1212   tt-sysconf.an-uchet-code-out        = a-code-an-uchet  [1]
     1213   tt-sysconf.cel-nazn-code-out        = a-code-cel-nazn  [1]
     1214   tt-sysconf.cor-acc-out              = a-code-cor-acc   [1]
     1215   tt-sysconf.cor-acc1-out             = a-code-cor-acc-2 [1]
     1216   tt-sysconf.an-uchet-code-in         = a-code-an-uchet  [2]
     1217   tt-sysconf.cel-nazn-code-in         = a-code-cel-nazn  [2]
     1218   tt-sysconf.cor-acc-in               = a-code-cor-acc   [2]
     1219   tt-sysconf.cor-acc1-in              = a-code-cor-acc-2 [2]
     1220   tt-sysconf.an-uchet-code-out-cash   = a-code-an-uchet  [3]
     1221   tt-sysconf.cel-nazn-code-out-cash   = a-code-cel-nazn  [3]
     1222   tt-sysconf.cor-acc-out-cash         = a-code-cor-acc   [3]
     1223   tt-sysconf.cor-acc1-out-cash        = a-code-cor-acc-2 [3]
     1224   tt-sysconf.an-uchet-code-in-cash    = a-code-an-uchet  [4]
     1225   tt-sysconf.cel-nazn-code-in-cash    = a-code-cel-nazn  [4]
     1226   tt-sysconf.cor-acc-in-cash          = a-code-cor-acc   [4]
     1227   tt-sysconf.cor-acc1-in-cash         = a-code-cor-acc-2 [4]
     1228   tt-sysconf.an-uchet-code-out-payoff = a-code-an-uchet  [5]
     1229   tt-sysconf.cel-nazn-code-out-payoff = a-code-cel-nazn  [5]
     1230   tt-sysconf.cor-acc-out-payoff       = a-code-cor-acc   [5]
     1231   tt-sysconf.cor-acc1-out-payoff      = a-code-cor-acc-2 [5]
     1232   tt-sysconf.an-uchet-code-in-payoff  = a-code-an-uchet  [6]
     1233   tt-sysconf.cel-nazn-code-in-payoff  = a-code-cel-nazn  [6]
     1234   tt-sysconf.cor-acc-in-payoff        = a-code-cor-acc   [6]
     1235   tt-sysconf.cor-acc1-in-payoff       = a-code-cor-acc-2 [6]
     1236   .
     1237   if ( tt-sysconf.usl-opl = 'По реализации части приход. накладной':U
     1238       or tt-sysconf.usl-opl = 'Предоплата(%)':U) and tt-sysconf.srok-opl = 0 then do:
     1239     message
     1240     "Процент реализации не может быть 0 !"
     1241     view-as alert-box ERROR.
     1242     undo, return ERROR.
     1243   end.
     1244   v-rid = recid(locked_sysconf).
     1245   run adm/fin-def1.p (
     1246      input-output v-rid
     1247     ,input p-mode
     1248     ,input no
     1249     ,input  tt-sysconf.host-code
     1250     ,input  is-fin-copy
     1251     ,input  v-fin-host-copy
     1252     ,input  tt-sysconf.contract-city
     1253     ,input  tt-sysconf.contract-type
     1254     ,input  tt-sysconf.pay-sign-post
     1255     ,input  tt-sysconf.pay-sign
     1256     ,input  tt-sysconf.fin-VAT-pc
     1257     ,input  tt-sysconf.srok-opl
     1258     ,input  tt-sysconf.srok-opl-sf
     1259     ,input  tt-sysconf.usl-opl
     1260     ,input  tt-sysconf.usl-opl-sf
     1261     ,input  tt-sysconf.is-an-uchet
     1262     ,input  tt-sysconf.is-code-cel-nazn
     1263     ,input  tt-sysconf.is-corr-acc
     1264     ,input  tt-sysconf.is-cassa-acc
     1265     ,input  tt-sysconf.fin-calc
     1266     ,input  tt-sysconf.pay-code-schet-rubl
     1267     ,input  tt-sysconf.pay-code-schet-base
     1268     ,input  tt-sysconf.an-uchet-code-out
     1269     ,input  tt-sysconf.cel-nazn-code-out
     1270     ,input  tt-sysconf.cor-acc-out
     1271     ,input  tt-sysconf.cor-acc1-out
     1272     ,input  tt-sysconf.an-uchet-code-in
     1273     ,input  tt-sysconf.cel-nazn-code-in
     1274     ,input  tt-sysconf.cor-acc-in
     1275     ,input  tt-sysconf.cor-acc1-in
     1276     ,input  tt-sysconf.an-uchet-code-out-cash
     1277     ,input  tt-sysconf.cel-nazn-code-out-cash
     1278     ,input  tt-sysconf.cor-acc-out-cash
     1279     ,input  tt-sysconf.cor-acc1-out-cash
     1280     ,input  tt-sysconf.an-uchet-code-in-cash
     1281     ,input  tt-sysconf.cel-nazn-code-in-cash
     1282     ,input  tt-sysconf.cor-acc-in-cash
     1283     ,input  tt-sysconf.cor-acc1-in-cash
     1284     ,input  tt-sysconf.an-uchet-code-out-payoff
     1285     ,input  tt-sysconf.cel-nazn-code-out-payoff
     1286     ,input  tt-sysconf.cor-acc-out-payoff
     1287     ,input  tt-sysconf.cor-acc1-out-payoff
     1288     ,input  tt-sysconf.an-uchet-code-in-payoff
     1289     ,input  tt-sysconf.cel-nazn-code-in-payoff
     1290     ,input  tt-sysconf.cor-acc-in-payoff
     1291     ,input  tt-sysconf.cor-acc1-in-payoff
     1292       ) NO-ERROR.
     1293   IF ERROR-STATUS:ERROR  THEN DO:
     1294   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1295   define variable fh as widget-handle no-undo .
     1296   define variable hh as widget-handle no-undo .
     1297   define variable rv as character no-undo .
     1298   assign
     1299   rv = entry(1, return-value , chr(4)).
     1300   if rv <> "":U then do:
     1301     assign
     1302     fh = frame Dialog-Frame:first-child
     1303     hh = fh:first-child
     1304     .
     1305     do while valid-handle(hh):
     1306       if hh:name = rv then do:
     1307         APPLY "ENTRY" to hh.
     1308         undo ,
     1309         return error.
     1310       end.
     1311       hh = hh:next-sibling.
     1312     end.
     1313   end.
     1314     undo, return error.
     1315   END.
     1316   END PROCEDURE.
