      144   define temp-table temp_onewin_items no-undo
      145       field itm-key       as integer
      146       field itmExtKey     as character
      147       field itmName       as character
      148       field itmDesc       as character
      149       field itmSelected   as logical
      150       index pi is primary unique
      151           itm-key
      152       index ie
      153           itmExtKey
      154   .
      155   define temp-table temp_onewin_itemsSelected no-undo
      156       field its-key   as integer
      157       field itm-key   as integer
      158       field itmExtKey as character
      159       index pi is primary unique
      160           its-key
      161       index im
      162           itm-key
      163   .
      164   define variable v-onewin2-itm-key    as integer      no-undo.
      165   procedure onewin_clear :
      166       define buffer buf_temp_onewin_items        for temp_onewin_items.
      167   do
      168   for buf_temp_onewin_items
      169   on error undo, return error
      170   :
      171       empty temp-table buf_temp_onewin_items.
      172   end.
      173   end procedure.
      174   procedure onewin_add-item :
      175   define input parameter p-ext-key   as character        no-undo.
      176   define input parameter p-item-name as character        no-undo.
      177   define input parameter p-item-desc as character        no-undo.
      178   define input parameter p-selected  as logical          no-undo.
      179       define buffer buf_temp_onewin_items        for temp_onewin_items.
      180   do
      181   for buf_temp_onewin_items
      182   on error undo, return error
      183   :
      184       find last buf_temp_onewin_items no-error.
      185       if available buf_temp_onewin_items then do:
      186         v-onewin2-itm-key = buf_temp_onewin_items.itm-key.
      187       end.
      188       else do:
      189         v-onewin2-itm-key = 0.
      190       end.
      191       assign
      192           v-onewin2-itm-key = v-onewin2-itm-key + 1
      193       .
      194       create buf_temp_onewin_items.
      195       assign
      196       buf_temp_onewin_items.itm-key      = v-onewin2-itm-key
      197       buf_temp_onewin_items.itmExtKey    = p-ext-key
      198       buf_temp_onewin_items.itmName      = p-item-name
      199       buf_temp_onewin_items.itmDesc      = p-item-desc
      200       buf_temp_onewin_items.itmSelected  = p-selected
      201       .
      202   end.
      203   end procedure.
      204   procedure onewin_create-selection :
      205   define input parameter p-itm-key as integer no-undo .
      206   define input parameter p-itmextkey as character no-undo .
      207   define variable v-counter as integer no-undo .
      208   define buffer buf_temp_onewin_itemsSelected for temp_onewin_itemsSelected .
      209   do
      210   on error undo, return error
      211   :
      212     find last buf_temp_onewin_itemsSelected use-index pi no-error.
      213     if available buf_temp_onewin_itemsSelected then do:
      214       v-counter = buf_temp_onewin_itemsSelected.its-key.
      215     end.
      216     find first buf_temp_onewin_itemsSelected where
      217          buf_temp_onewin_itemsSelected.itm-key = p-itm-key no-error.
      218     if not available buf_temp_onewin_itemsSelected then do:
      219       create buf_temp_onewin_itemsSelected.
      220       assign
      221       buf_temp_onewin_itemsSelected.its-key   = v-counter + 1
      222       v-counter = v-counter + 1
      223       buf_temp_onewin_itemsSelected.itm-key   = p-itm-key
      224       buf_temp_onewin_itemsSelected.itmExtKey = p-itmExtKey
      225       .
      226     end.
      227   end.
      228   end procedure.
      229   procedure onewin_check-item :
      230   define input parameter p-ext-key   as character        no-undo.
      231   define output parameter p-exists as logical no-undo .
      232   define buffer buf_temp_onewin_items for temp_onewin_items.
      233   find first buf_temp_onewin_items where
      234   buf_temp_onewin_items.itmExtKey    = p-ext-key no-error.
      235   if available buf_temp_onewin_items then do:
      236     p-exists = yes.
      237   end.
      238   end procedure.
      239   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      240   define variable v-waitfram-action01         as character   no-undo .
      241   define variable v-waitfram-action02         as character   no-undo .
      242   define variable v-waitfram-action03         as character   no-undo .
      243   define variable mWaitFramTextBeg            as character   no-undo.
      244   define variable mWaitFramTextEnd            as character   no-undo.
      245   define variable mWaitFramView               as logical     no-undo.
      246   define variable mWaitProcEvent              as logical     no-undo init yes.
      247   define variable mWaitFramInterval           as integer     no-undo init 1 .
      248   define variable mWaitFramStop               as logical     no-undo.
      249   define variable mWaitFramStopUser           as logical     no-undo.
      250   define variable mWaitFramStopTimeOut        as logical     no-undo.
      251   define variable mWaitFramStartProc          as datetime-tz no-undo.
      252   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      253   define button B-WaitFramStop auto-end-key
      254        label "Стоп"
      255        size 10 by 1 tooltip "Остоновить процесс".
      256   define button B-viewProcInfo
      257        label "Информация"
      258        size 15 by 1 tooltip "Информация о процесс".
      259   define frame waitfram
      260     v-waitfram-action01 format "x(72)" no-label skip
      261     v-waitfram-action02 format "x(72)" no-label skip
      262     v-waitfram-action03 format "x(72)" no-label skip
      263     B-viewProcInfo
      264     B-WaitFramStop at row 4 col 30
      265     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      266     .
      267   define new global shared variable mBatchMode as logical no-undo init ?.
      268   define variable mFramBachModHandle as handle no-undo.
      269   mFramBachModHandle = frame waitfram:handle.
      270   define variable mFameOldVis as logical no-undo.
      271   define variable mVisCUrentVin as logical no-undo.
      272   if session:batch-mode
      273   then
      274      mBatchMode = yes.
      275   if mBatchMode = ? then do:
      276     mVisCUrentVin = current-window:visible.
      277     mFameOldVis = mFramBachModHandle:visible.
      278     mFramBachModHandle:visible  = yes.
      279     mBatchMode = mFramBachModHandle:visible ne yes.
      280     mFramBachModHandle:visible = mFameOldVis.
      281     current-window:visible = mVisCUrentVin.
      282   end.
      283    if  log-manager:logfile-name ne ?
      284     then DO:
      285         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      286         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      287         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      288     end.
      289   on choose of B-WaitFramStop in frame waitfram
      290   do:
      291     mWaitFramStop = yes.
      292     mWaitFramStopUser = yes.
      293   end.
      294   function waitfram-check-timeout returns logical():
      295      define variable vtime as int64 no-undo.
      296      if mWaitFramStopTimeOut
      297      then
      298         return yes.
      299      vtime = ( now - mWaitFramStartProc ) / 1000 .
      300      if     mWaitFramTimeOut ne ?
      301         and mWaitFramTimeOut ne 0
      302         and mWaitFramTimeOut lt vtime
      303      then do:
      304         mWaitFramStopTimeOut = yes.
      305      end.
      306      return mWaitFramStopTimeOut.
      307   end.
      308   procedure waitfram-hide :
      309     if not session:batch-mode
      310     then do
      311     on error undo, return error return-value
      312     :
      313       pause 0 before-hide .
      314       if not mBatchMode then
      315         hide frame waitfram .
      316     if     not mWaitFramView
      317        and mWaitProcEvent
      318     then
      319       process events .
      320     end.
      321   end procedure.
      322   procedure waitfram-show :
      323     define input  parameter p-message as character no-undo .
      324     define variable v-left-margin as integer   no-undo .
      325     if not session:batch-mode
      326     then do
      327     on error undo, return error return-value
      328     :
      329       if length(p-message) <= 70 then do:
      330         assign
      331           v-left-margin = integer((70 - length(p-message)) / 2)
      332         .
      333         assign
      334           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      335         .
      336         assign
      337           v-waitfram-action01 = " "
      338           v-waitfram-action02 = " "
      339                                    + fill(" ", v-left-margin)
      340                                    + p-message
      341           v-waitfram-action03 = " "
      342         .
      343       end.
      344       else do:
      345         define variable vRindex1 as integer no-undo.
      346         define variable vRindex2 as integer no-undo.
      347         vRindex1 = r-index(p-message," ",70).
      348         if vRindex1 = 0
      349         then
      350            vRindex1 = 70.
      351         if length(p-message)  <= vRindex1 + 70 then do:
      352           assign
      353             v-waitfram-action01 = " "
      354             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      355             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      356           .
      357         end.
      358         else do:
      359           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      360           if vRindex2 <= vRindex1
      361           then
      362              vRindex2 = vRindex1 + 70.
      363           assign
      364             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      365             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      366             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      367           .
      368         end.
      369       end.
      370       B-viewProcInfo:visible   in frame waitfram = no.
      371       B-viewProcInfo:sensitive in frame waitfram = no.
      372       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      373       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      374       if  (   mWaitFramView
      375          or  mWaitProcEvent)
      376          and not mBatchMode
      377       then
      378          display
      379             v-waitfram-action01 skip
      380             v-waitfram-action02 skip
      381             v-waitfram-action03 skip
      382          with frame waitfram .
      383       if     mWaitFramView
      384          then do:
      385             if     mWaitFramInterval ne ?
      386                and not mBatchMode
      387             then
      388                wait-for go of frame waitfram pause mWaitFramInterval.
      389          end.
      390          else
      391             if     mWaitProcEvent
      392                and not mBatchMode
      393             then
      394                process events .
      395     end.
      396   end procedure.
      397      procedure waitfram-show-this:
      398         define input  parameter iInterval as int64 no-undo.
      399         define variable vtime as int64 no-undo.
      400         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      401         mWaitFramInterval = iInterval.
      402         run waitfram-show (substitute("&1&2 &3&4" ,
      403                                       mWaitFramTextBeg ,
      404                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      405                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      406                                       mWaitFramTextEnd
      407                                      )
      408                           ).
      409      end.
      410      procedure WaitFramRunPause:
      411         define input  parameter iInterval as dec no-undo.
      412         define variable vStart  as datetime-tz no-undo.
      413         define variable vend    as datetime-tz no-undo.
      414         define variable vint as int64 no-undo.
      415         define variable vOk as logical no-undo.
      416         vStart = now.
      417         vend   = vStart.
      418         publish "WaitFramPause" (iInterval,output vOk).
      419         vend   =  now.
      420         vint = vend - vStart.
      421         vint = iInterval - vint / 1000.
      422         if     not mWaitFramStop
      423            and (   vint > 0
      424                 or (    not vOk
      425                     and iInterval eq ?
      426                     )
      427                 )
      428         then
      429            run waitfram-show-this (iInterval).
      430         vend   =  now.
      431         vint = vend - vStart.
      432         vint = iInterval - vint / 1000.
      433         if     not mWaitFramStop
      434            and vint > 0
      435         then do:
      436            run gbl/pause.p (vint * 1000).
      437         end.
      438         if iInterval ne ?
      439         then
      440            publish "WaitFramStop".
      441         waitfram-check-timeout().
      442      end.
      443      procedure WaitFramWaitFor:
      444         define input  parameter iInterval as dec no-undo.
      445         assign
      446            mWaitFramStartProc   = now
      447            mWaitFramStopUser    = no
      448            mWaitFramStopTimeOut = no
      449         .
      450         block-wait:
      451         do while not mWaitFramStop:
      452            run WaitFramRunPause (iInterval).
      453            if  waitfram-check-timeout()
      454            then do:
      455               leave block-wait.
      456            end.
      457         end.
      458         run waitfram-hide.
      459      end.
      460   procedure waitfram-join :
      461     define input  parameter p-line-1  as character no-undo .
      462     define input  parameter p-line-2  as character no-undo .
      463     define input  parameter p-line-3  as character no-undo .
      464     define output parameter p-message as character no-undo .
      465     do
      466     on error undo, return error return-value
      467     :
      468       assign
      469         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      470                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      471                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      472       .
      473     end.
      474   end procedure.
      475   function waitfram-join-function returns character
      476     (input p-line-1 as character
      477     ,input p-line-2 as character
      478     ,input p-line-3 as character
      479     ).
      480     define variable v-message as character no-undo .
      481     run waitfram-join in this-procedure
      482       (input  p-line-1
      483       ,input  p-line-2
      484       ,input  p-line-3
      485       ,output v-message
      486       ) .
      487     return v-message .
      488   end function .
      489   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      490   define new shared stream PrnLibStream.
      491   procedure prn-lib-prn-file :
      492     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      493     define input parameter p-DIsabledoptions as integer no-undo .
      494     define variable v-report-name as character no-undo .
      495     define variable v-user-action as character no-undo .
      496     define variable v-printed     as logical   no-undo .
      497     define variable v-exist       as logical   no-undo .
      498     do
      499       on error undo, return error
      500       :
      501       run prn-lib-get-report-name  in this-procedure (
      502         input parParentProc
      503         ,output v-report-name
      504         ).
      505   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      506   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      507     (input  v-report-name
      508     ,input  2
      509     ,output v-exist
      510     )  .
      511       if NOT v-exist then
      512       DO:
      513         Message
      514           "Нет заданий на печать ! "
      515           view-as alert-box .
      516         Return  .
      517       End.
      518       run gbl/prnfilen.w
      519         (input  ""
      520         ,input  p-DisabledOptions
      521         ,input  string(v-report-name )
      522         ,input  7
      523         ,output v-user-action
      524         ,output v-printed
      525         ) .
      526       if v-printed then
      527       do:
      528         return "YES" .
      529       end.
      530       else
      531       do:
      532         return "NO" .
      533       end.
      534     end.
      535   end procedure.
      536   procedure prn-lib-open-stream :
      537     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      538     define input parameter p-page-size    as integer no-undo .
      539     define input parameter p-is-stream    as logical no-undo .
      540     define input parameter p-append       as logical no-undo .
      541     define variable v-report-name as character no-undo .
      542     do
      543       on error undo, return error
      544       :
      545       run prn-lib-get-report-name  in this-procedure (
      546         input parParentProc
      547         ,output v-report-name
      548         ).
      549       if p-is-stream then
      550       do:
      551         if p-append then
      552         do:
      553           output stream PrnLibStream to value( v-report-name )
      554             page-size value(p-page-size) append .
      555         end.
      556         if not p-append then
      557         do:
      558           output stream PrnLibStream to value( v-report-name )
      559             page-size value(p-page-size) .
      560         end.
      561       end.
      562       if not p-is-stream then
      563       do:
      564         if p-append then
      565         do:
      566           output to value( v-report-name )
      567             page-size value(p-page-size) append .
      568         end.
      569         if not p-append then
      570         do:
      571           output to value( v-report-name )
      572             page-size value(p-page-size) .
      573         end.
      574       end.
      575     end.
      576   end procedure.
      577   procedure prn-lib-open-exp :
      578     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      579     define input parameter p-is-stream    as logical no-undo .
      580     define input parameter p-is-append    as logical no-undo .
      581     define output parameter p-ReportFileName as char init "report" no-undo.
      582     define output parameter p-process as logical no-undo .
      583     define variable glog as logical no-undo .
      584     do
      585       on error undo, return error
      586       :
      587       SYSTEM-DIALOG GET-FILE p-ReportFileName
      588         TITLE      "Укажите путь"
      589         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      590         ASK-OVERWRITE
      591         CREATE-TEST-FILE
      592         SAVE-AS
      593         USE-FILENAME
      594         DEFAULT-EXTENSION "txt"
      595         UPDATE glog
      596         .
      597       if not glog then  return.
      598       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      599       if p-is-stream then
      600       do:
      601         if p-is-append then
      602         do:
      603           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      604         end.
      605         else
      606         do:
      607           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      608         end.
      609       end.
      610       else
      611       do:
      612         if p-is-append then
      613         do:
      614           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      615         end.
      616         else
      617         do:
      618           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      619         end.
      620       end.
      621       p-process = yes.
      622     end.
      623   end procedure.
      624   procedure prn-lib-get-report-name :
      625     define input parameter parParentProc  as widget-handle no-undo.
      626     define output parameter p-report-name as character no-undo .
      627     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      628   end procedure.
      629   procedure prn-lib-reportviewer-report-name :
      630     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      631     define input parameter p-report-name-html as character no-undo .
      632     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      633   end procedure.
      634   procedure prn-lib-reportviewer :
      635     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      636     define input parameter p-report-name-html as character no-undo .
      637     define input parameter p-param        as character no-undo .
      638     define variable v-excel           as character no-undo init 'TRUE' .
      639     define variable v-value-character as character no-undo .
      640     define variable v-value-integer   as character no-undo .
      641     define variable v-value-date      as date      no-undo .
      642     define variable v-value-decimal   as decimal   no-undo .
      643     define variable rep-excel         as logical   no-undo .
      644     define variable excel-string      as character no-undo .
      645     define variable v-param-type      as character no-undo .
      646     define variable v-tth             as handle    no-undo .
      647     run adm/shattri.p (
      648       input "get":U
      649       ,input  ""
      650       ,input  0
      651       ,input  'report-glob':U
      652       ,input  'rep-excel':U
      653       ,output v-value-character
      654       ,output v-value-date
      655       ,output v-value-decimal
      656       ,output v-value-integer
      657       ,output rep-excel
      658       ,output v-param-type
      659       ,INPUT-OUTPUT table-handle v-tth
      660       )  .
      661     if rep-excel then v-excel = "TRUE" .
      662     else v-excel = "FALSE" .
      663     if p-param eq ""
      664     then
      665        p-param = "EXCEL:" + v-excel.
      666     else
      667        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      668     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      669   end procedure.
      670   define temp-table temp_filter-fields no-undo
      671       field action-item-code as integer
      672       field record-on        as logical
      673       index pi is primary unique
      674           action-item-code
      675   .
      676   define temp-table temp_actnrole-user no-undo
      677       field user-id       as character
      678       field nik           as character
      679       field lastName      as character
      680       field firstName     as character
      681       field secondName    as character
      682       index pi is primary unique
      683           user-id
      684   .
      685   define temp-table temp_actnrole no-undo
      686       field action-role-name    as character
      687       field action-role-code    as integer
      688       field action-role-context as character
      689       index pi is primary unique
      690           action-role-code
      691   .
      692   define buffer br_action-item    for ub.action-item .
      693   define buffer br_action-group   for ub.action-group .
      694   define buffer buf_action-item-attr for ub.action-item-attr .
      695   define buffer br_temp_filter-fields for temp_filter-fields .
      696   define stream OutStr-html.
      697   define stream OutStr-html.
      698   define variable actr-print as character no-undo.
      699   define variable v-context  as character no-undo column-label "Привязка"        format "x(15)":u  .
      700   define variable v-brws-mark      as character no-undo COLUMN-LABEL "*"        FORMAT "X(1)":U  .
      701   define variable v-on-gbl    as logical      no-undo.
      702   FUNCTION context RETURNS CHARACTER
      703     ( INPUT p-context AS character )  FORWARD.
      704   FUNCTION chek-action-gds-group RETURNS character
      705    ( INPUT p-action-item-code AS integer )  FORWARD.
      706   DEFINE BUTTON b-filter
      707        LABEL "&ФПоиск"
      708        SIZE 10 BY 1 TOOLTIP "Поиск с фильтрацией".
      709   DEFINE BUTTON b-group
      710        LABEL "&Группы"
      711        SIZE 10 BY 1 TOOLTIP "Группы прав, включающие право".
      712   DEFINE BUTTON b-help
      713        LABEL "Помо&щь"
      714        SIZE 10 BY 1.13
      715        BGCOLOR 8 .
      716   DEFINE BUTTON b-mark
      717        LABEL "*"
      718        SIZE 3 BY 1.
      719   DEFINE BUTTON b-print
      720        LABEL "Печать"
      721        SIZE 9.5 BY 1.
      722   DEFINE BUTTON b-quit AUTO-END-KEY
      723        LABEL "&Отмена"
      724        SIZE 10 BY 1
      725        BGCOLOR 8 .
      726   DEFINE BUTTON b-sel AUTO-GO
      727        LABEL "&Выбор"
      728        SIZE 10 BY 1
      729        BGCOLOR 8 .
      730   DEFINE BUTTON b-user
      731        LABEL "&Польз"
      732        SIZE 10 BY 1 TOOLTIP "Список пользователей с выбранным правом".
      733   DEFINE VARIABLE cb-group AS INTEGER FORMAT "->>>>9":U INITIAL 0
      734        LABEL "Тема"
      735        VIEW-AS COMBO-BOX INNER-LINES 15
      736        LIST-ITEM-PAIRS "0",1
      737        DROP-DOWN-LIST
      738        SIZE 25 BY 1 TOOLTIP "Тема, к которой относится право" NO-UNDO.
      739   DEFINE VARIABLE item-EDITOR AS CHARACTER
      740        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      741        SIZE 97 BY 1.5 NO-UNDO.
      742   DEFINE VARIABLE v-filter AS CHARACTER FORMAT "X(256)":U
      743        VIEW-AS FILL-IN
      744        SIZE 31.38 BY 1 NO-UNDO.
      745   DEFINE VARIABLE rs-scope AS INTEGER
      746        VIEW-AS RADIO-SET HORIZONTAL
      747        RADIO-BUTTONS
      748             "Все", 1,
      749   "Без привязки", 2,
      750   "Фирма", 3,
      751   "Объект", 4
      752        SIZE 38 BY 1 NO-UNDO.
      753   DEFINE VARIABLE tb-filter AS LOGICAL INITIAL no
      754        LABEL ""
      755        VIEW-AS TOGGLE-BOX
      756        SIZE 2.5 BY .83 NO-UNDO.
      757   DEFINE QUERY BROWSE-item FOR
      758         br_action-item,
      759         br_action-group,
      760         br_temp_filter-fields
      761         scrolling.
      762   DEFINE BROWSE BROWSE-item
      763     QUERY BROWSE-item NO-LOCK DISPLAY
      764         (IF ( INDEX (rid-list, string( recid( br_action-item ) ) ) > 0 ) THEN ("*") ELSE (" ")) @ v-brws-mark
      765         br_action-item.action-item-name FORMAT "X(60)":U
      766         br_action-group.action-group-name FORMAT "X(20)":U COLUMN-LABEL "Тема"
      767         br_action-item.action-item-id FORMAT "X(55)":U
      768         context(br_action-item.action-item-context) @ v-context
      769         br_action-item.action-item-description FORMAT "X(60)":U
      770         chek-action-gds-group(br_action-item.action-item-code) FORMAT "X(7)":U COLUMN-LABEL "Тов.гр."
      771         enable  br_action-item.action-item-description
      772       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 17.5 FIT-LAST-COLUMN.
      773   DEFINE FRAME Dialog-Frame
      774        b-quit AT ROW 1 COL 1
      775        b-mark AT ROW 1 COL 11 WIDGET-ID 22
      776        b-sel AT ROW 1 COL 14
      777        b-group AT ROW 1 COL 24 WIDGET-ID 4
      778        b-user AT ROW 1 COL 34 WIDGET-ID 6
      779        b-filter AT ROW 1 COL 44 WIDGET-ID 8
      780        v-filter AT ROW 1 COL 52 COLON-ALIGNED NO-LABEL WIDGET-ID 10 NO-TAB-STOP
      781        b-help AT ROW 1 COL 88.5
      782        b-print AT ROW 2.25 COL 88.5 WIDGET-ID 22
      783        tb-filter AT ROW 1.08 COL 86.13 WIDGET-ID 12
      784        cb-group AT ROW 2.25 COL 8.5 COLON-ALIGNED WIDGET-ID 20
      785        rs-scope AT ROW 2.25 COL 41 HELP
      786             "Привязка права" NO-LABEL WIDGET-ID 14
      787        b-print AT ROW 2.25 COL 88.5 WIDGET-ID 24
      788        BROWSE-item AT ROW 3.5 COL 1.5 WIDGET-ID 200
      789        item-EDITOR AT ROW 21.25 COL 1.5 NO-LABEL WIDGET-ID 2
      790        SPACE(0.50) SKIP(0.24)
      791       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      792            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      793            TITLE "Список прав системы"
      794            DEFAULT-BUTTON b-sel CANCEL-BUTTON b-quit WIDGET-ID 100.
      795   ASSIGN
      796          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      797          FRAME Dialog-Frame:HIDDEN           = TRUE.
      798   ASSIGN
      799          b-quit:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      800   ASSIGN
      801          item-EDITOR:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      802   ASSIGN
      803          v-filter:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      804   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      805   DO:
      806     APPLY "END-ERROR":U TO SELF.
      807   END.
      808   ON CHOOSE OF b-filter IN FRAME Dialog-Frame
      809   DO:
      810        define variable v-ok    as logical      no-undo.
      811         run adm/role-sf.w (
      812             input-output v-filter
      813           , output v-ok
      814       ) no-error.
      815      if error-status :error
      816      then do:
      817         message
      818                  vss-workfile vss-revision vss-description
      819            skip(1)
      820            skip "?????? ????????? ???????."
      821            skip return-value
      822            skip trim( error-status :get-message( 1 ) )
      823                  trim( error-status :get-message( 2 ) )
      824         view-as alert-box error.
      825         undo, return no-apply.
      826      end.
      827      IF NOT v-ok then do:
      828         RETURN NO-APPLY.
      829      end.
      830      if v-filter = "":U
      831      then do:
      832         assign
      833               tb-filter               = no
      834               tb-filter :sensitive    = no
      835         .
      836         assign
      837               v-filter :bgcolor   = GREY_COLOR
      838               b-filter :bgcolor = GREY_COLOR
      839         .
      840      end.
      841      else do:
      842         assign
      843               tb-filter = yes
      844               tb-filter :sensitive    = yes
      845         .
      846         assign
      847               v-filter :bgcolor = RED_COLOR
      848               b-filter :bgcolor = RED_COLOR
      849         .
      850      end.
      851      display
      852         v-filter
      853         tb-filter
      854      with frame Dialog-Frame.
      855   if session :set-wait-state( "compiler" ) then.
      856      RUN enable_UI.
      857      RUN post_enable_UI.
      858   if session :set-wait-state( "" ) then.
      859   END.
      860   ON CHOOSE OF b-group IN FRAME Dialog-Frame
      861   DO:
      862      if available br_action-item
      863      then do:
      864         run show-roles-for-item in this-procedure (
      865              input br_action-item.action-head-code
      866            , input br_action-item.action-item-code
      867            , input br_action-item.action-item-name
      868         ).
      869      end.
      870   END.
      871   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      872   DO:
      873      define variable v-ok as logical no-undo .
      874      if not available br_action-item then do:
      875         return no-apply.
      876      end.
      877   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      878   define variable v-str-recid7 as character no-undo .
      879   define variable v-num-entry7 as integer   no-undo .
      880   assign
      881     v-str-recid7 = trim( string( recid( br_action-item ) , "->>>>>>>>>>>9":U ) )
      882     v-num-entry7 = lookup( v-str-recid7 , rid-list )
      883   .
      884   if v-num-entry7 > 0 then do:
      885     assign
      886       entry( v-num-entry7, rid-list ) = "":U
      887       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      888     .
      889   end.
      890   else do:
      891     assign
      892       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid7
      893     .
      894   end.
      895      v-ok = BROWSE-item:select-next-row ().
      896      v-ok = BROWSE-item:refresh( )  in frame Dialog-Frame.
      897   END.
      898   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
      899   DO:
      900      IF  available br_action-item
      901      AND rid-list = ""
      902      then DO:
      903         assign
      904            rid-list = string( recid( br_action-item ) )
      905         .
      906      end.
      907   END.
      908   ON CHOOSE OF b-print IN FRAME Dialog-Frame
      909   DO:
      910       define var v-act-file as char no-undo.
      911       v-act-file  = session:temp-directory + "rpt" +  "actnitem1.html".
      912    run waitfram-show in this-procedure ( input "Ждите...").
      913     output stream OutStr-html to value(v-act-file) convert target 'UTF-8'.
      914           put stream OutStr-html unformatted
      915       "<!DOCTYPE HTML>" skip
      916       ' <html>' skip
      917       '  <head>' skip
      918       '   <meta charset="utf-8">' skip
      919       '    <style type="text/css">' skip
      920       '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
      921       '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
      922       '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
      923       '   </style>' skip
      924       '  </head>' skip
      925       .
      926     put stream OutStr-html unformatted
      927       '<body>' skip
      928       '<table orientation="landscape" name="лист1" repeat_rows="1:1" hide_zero="True">'skip
      929       '<thead>' skip
      930       .
      931           put stream OutStr-html unformatted
      932               '<tr class="set_columns">' skip
      933               '<td style="width:200px"></td>' skip
      934               '<td style="width:130px"></td>' skip
      935               '<td style="width:170px"></td>' skip
      936               '<td style="width:140px"></td>' skip
      937               '<td style="width:300px"></td>' skip
      938               '</tr>' skip
      939               .
      940       put stream OutStr-html unformatted
      941           '<tr>' skip
      942           '<td colspan="5" style="front-weight: bold; text-align: center;">Список прав</td>' skip
      943           '</tr>' skip
      944           '</thead>' skip
      945           '<tbody>' skip
      946           '<tr>' skip
      947           '<th>Имя права</th>' skip
      948           '<th>Тема</th>' skip
      949           '<th>Идентификатор права</th>' skip
      950           '<th>Привязка</th>' skip
      951           '<th>Описания права</th>' skip
      952           '</tr>'
      953           .
      954                   get first BROWSE-item.
      955                   do while available  br_action-item:
      956        put stream OutStr-html unformatted
      957        '<tr style="height: 60px;">' skip
      958          '<td text_wrap="true">' + br_action-item.action-item-name + '</td>' skip
      959          '<td text_wrap="true">' + br_action-group.action-group-name + '</td>' skip
      960          '<td text_wrap="true">' + br_action-item.action-item-id + '</td>' skip
      961          '<td text_wrap="true">' + context(br_action-item.action-item-context) + '</td>' skip
      962          '<td text_wrap="true">' + br_action-item.action-item-description + '</td>' skip
      963         '</tr>' skip
      964         .
      965        get next BROWSE-item.
      966        end.
      967          put stream OutStr-html unformatted
      968       '</tbody>' skip
      969       '</table>' skip
      970       '</body>' skip
      971       '</html>' skip
      972       .
      973                   run waitfram-hide in this-procedure.
      974       output stream OutStr-html close.
      975       run prn-lib-reportviewer-report-name in this-procedure (
      976                                                             input parParentProc
      977                                                             ,input v-act-file
      978                                                             ).
      979   END.
      980   ON CHOOSE OF b-user IN FRAME Dialog-Frame
      981   DO:
      982      if available br_action-item
      983      then do:
      984         run show-users-for-item in this-procedure (
      985              input v-cntxt-db-num
      986            , input br_action-item.action-head-code
      987            , input br_action-item.action-item-code
      988            , input br_action-item.action-item-name
      989         ).
      990      end.
      991   END.
      992   ON MOUSE-SELECT-CLICK OF BROWSE-item IN FRAME Dialog-Frame
      993   DO:
      994   END.
      995   ON VALUE-CHANGED OF BROWSE-item IN FRAME Dialog-Frame
      996   DO:
      997       if available br_action-item then do:
      998       assign
      999           item-editor = br_action-item.action-item-description
     1000       .
     1001       display
     1002         item-editor
     1003       with frame Dialog-Frame.
     1004     end.
     1005   END.
     1006   ON VALUE-CHANGED OF cb-group IN FRAME Dialog-Frame
     1007   DO:
     1008       assign
     1009           cb-group
     1010       .
     1011       RUN enable_UI.
     1012       RUN post_enable_UI.
     1013   END.
     1014   ON VALUE-CHANGED OF rs-scope IN FRAME Dialog-Frame
     1015   DO:
     1016       assign
     1017           rs-scope
     1018       .
     1019       assign
     1020           v-context = entry( rs-scope, substitute( "&1,&2,&3,&4",'All', 'global':U, 'firm':U, 'object':U ) )
     1021       .
     1022       RUN enable_UI.
     1023       RUN post_enable_UI.
     1024   END.
     1025   ON VALUE-CHANGED OF tb-filter IN FRAME Dialog-Frame
     1026   DO:
     1027        assign
     1028         tb-filter
     1029      .
     1030      if tb-filter = yes
     1031      then do:
     1032         assign
     1033            v-filter :bgcolor = RED_COLOR
     1034            b-filter :bgcolor = RED_COLOR
     1035         .
     1036      end.
     1037      else do:
     1038         assign
     1039            v-filter :bgcolor = GREY_COLOR
     1040            b-filter :bgcolor = GREY_COLOR
     1041         .
     1042      end.
     1043      RUN enable_UI.
     1044      RUN post_enable_UI.
     1045   END.
     1046   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1047   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1048   MAIN-BLOCK:
     1049   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1050      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1051      define buffer buf_action-group for ub.action-group.
     1052   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1053     run mainmenu_getcntxt in parparentproc
     1054       (output v-cntxt-db-num
     1055       ,output v-cntxt-userid
     1056       ,output v-cntxt-level
     1057       ,output v-cntxt-host-code-obj
     1058       ,output v-cntxt-obj-type
     1059       ,output v-cntxt-obj-code
     1060       ,output v-cntxt-db-num-obj
     1061       ,output v-cntxt-is-admin
     1062       ) .
     1063   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1064   on help of frame Dialog-Frame
     1065   do:
     1066     run gbl/app_help.p
     1067       (input this-procedure :file-name
     1068       ,input ''
     1069       ,input ?
     1070       ) no-error.
     1071     if error-status :error then do:
     1072       message
     1073         "Ошибка при вызове помощи"
     1074         error-status :get-message(1)
     1075         view-as alert-box .
     1076     end.
     1077   end.
     1078   run minbtn-set in this-procedure .
     1079   on choose of b-help in frame Dialog-Frame
     1080   do:
     1081     apply "help":u to frame Dialog-Frame .
     1082   end.
     1083   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1084   procedure minbtn-set :
     1085       do
     1086           on error undo, return error return-value
     1087           :
     1088           define variable ii              as integer       no-undo .
     1089           define variable fh              as widget-handle no-undo .
     1090           define variable hh              as widget-handle no-undo .
     1091           define variable v-h             as handle        extent 4 no-undo .
     1092           define variable v-name-button   as character     no-undo .
     1093           define variable v-help-old-x    as decimal       no-undo .
     1094           define variable v-help-old-y    as decimal       no-undo .
     1095           define variable v-help-old-size as decimal       no-undo .
     1096           define variable v-frame-width   as decimal       no-undo .
     1097           define variable jj              as integer       no-undo .
     1098           do
     1099               on error undo, return error
     1100               :
     1101               assign
     1102                   v-frame-width = frame Dialog-Frame:width - 0.3
     1103                   fh            = frame Dialog-Frame:first-child
     1104                   hh            = fh:first-child
     1105                   ii            = 1
     1106                   .
     1107               do while valid-handle(hh):
     1108                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1109                   do:
     1110                       case lc(hh:name) :
     1111                           when "b-help" then
     1112                               do:
     1113                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1114                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1115                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1116                                   hh:TOOLTIP = "Помощь" .
     1117                                   v-help-old-x = hh:column .
     1118                                   v-help-old-y = hh:row    .
     1119                                   v-help-old-size = hh:width .
     1120                                   hh:width-chars = 2.5 .
     1121                               end.
     1122                           when "b-print" then
     1123                               do:
     1124                                   hh:load-image("cmp/b-print.bmp":u) .
     1125                                   hh:TOOLTIP = "Печать" .
     1126                                   v-h[ii] = hh:handle .
     1127                                   ii = ii + 1 .
     1128                                   hh:width-chars = 3 .
     1129                               end.
     1130                           when "b-history" or
     1131                           when "b-hist" then
     1132                               do:
     1133                                   hh:load-image("cmp/b-hist.bmp":u) .
     1134                                   hh:TOOLTIP = "История" .
     1135                                   v-h[ii] = hh:handle .
     1136                                   ii = ii + 1 .
     1137                                   hh:width-chars = 3 .
     1138                               end.
     1139                           when "b-sch" then
     1140                               do:
     1141                                   hh:load-image("cmp/b-sch.bmp":u) .
     1142                                   hh:TOOLTIP = "Установка Фильтра" .
     1143                                   v-h[ii] = hh:handle .
     1144                                   ii = ii + 1 .
     1145                                   hh:width-chars = 3 .
     1146                               end.
     1147                           when "b-hist-user" then
     1148                               do:
     1149                                   hh:load-image("cmp/b-hist.bmp":u) .
     1150                                   hh:TOOLTIP = "История пользователя" .
     1151                                   ii = ii + 1 .
     1152                               end.
     1153                       end case.
     1154                   end.
     1155                   hh = hh:next-sibling.
     1156               end.
     1157               b-help:column = v-frame-width - b-help:width-chars.
     1158               jj = 0.
     1159               repeat ii = 4 to 1 by -1 :
     1160                   if valid-handle (v-h[ii] ) then
     1161                   do:
     1162                       jj  = jj + 1 .
     1163                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1164                       v-h[ii]:row    = v-help-old-y .
     1165                   end.
     1166               end.
     1167           end.
     1168       end.
     1169   end procedure.
     1170   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1171   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1172   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1173   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1174   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1175   define variable v-diasize-current-frame-height as decimal   no-undo .
     1176   define variable v-diasize-change-size          as logical   no-undo .
     1177   define variable v-diasize-resize-button        as handle    no-undo .
     1178   define variable v-diasize-wndmax               as logical   no-undo .
     1179   define variable v-diasize-wndstore             as logical   no-undo .
     1180   define variable v-diasize-proc-name            as character no-undo .
     1181   define variable v-diasize-browse-handle        as handle    no-undo .
     1182   define variable v-diasize-browse-number        as integer   no-undo .
     1183   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1184   define temp-table temp-diasize-handle no-undo
     1185     field handle-value  as handle
     1186     field save-position as decimal
     1187     index xpk is primary unique handle-value
     1188     .
     1189   define temp-table temp-browse-handle no-undo
     1190     field browse-type   as character
     1191     field browse-number as integer
     1192     field browse-handle as handle
     1193     field original-size as decimal
     1194     index xpk is primary unique browse-type browse-number
     1195     index xie browse-type browse-handle
     1196   .
     1197   procedure diasize_change-height :
     1198     define input  parameter p-change-value  as decimal   no-undo .
     1199     define input  parameter p-move-resize   as logical   no-undo .
     1200     define variable v-field-group-handle    as handle    no-undo .
     1201     define variable v-object-handle         as handle    no-undo .
     1202     define variable v-frame-height          as decimal   no-undo .
     1203     define variable v-frame-virtual-height  as decimal   no-undo .
     1204     define variable v-browse-height         as decimal   no-undo .
     1205     define variable v-window-height         as decimal   no-undo .
     1206     define variable v-window-virtual-height as decimal   no-undo .
     1207     define variable v-change-sign           as integer   no-undo .
     1208     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1209     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1210     if p-change-value > 0
     1211     then do:
     1212       if frame Dialog-Frame :height + p-change-value
     1213           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1214       then do:
     1215         assign
     1216           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1217                           - (frame Dialog-Frame :height-chars)
     1218         .
     1219         if p-change-value <= 0
     1220         then do:
     1221           run diasize_position-resize-button in this-procedure .
     1222           return .
     1223         end.
     1224       end.
     1225     end.
     1226     if p-change-value < 0
     1227     then do:
     1228       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1229       then do:
     1230         assign
     1231           p-change-value = v-diasize-orig-frame-height
     1232                          - (frame Dialog-Frame :height-chars)
     1233         .
     1234         if p-change-value >= 0
     1235         then do:
     1236           run diasize_position-resize-button in this-procedure .
     1237           return .
     1238         end.
     1239       end.
     1240     end.
     1241     if p-change-value >= 0
     1242     then do:
     1243       assign
     1244         v-change-sign = 1
     1245       .
     1246     end.
     1247     else do:
     1248       assign
     1249         v-change-sign = -1
     1250       .
     1251     end.
     1252     assign
     1253       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1254     .
     1255     if p-change-value = 0
     1256     then do:
     1257       run diasize_position-resize-button in this-procedure .
     1258       return .
     1259     end.
     1260     move_block:
     1261     do
     1262     on error undo move_block, retry move_block
     1263     :
     1264       if retry
     1265       then do:
     1266         do
     1267         on error undo move_block, leave move_block
     1268         :
     1269           if p-change-value > 0
     1270           then do:
     1271             for each buf_temp-diasize-handle
     1272             on error undo, next
     1273             :
     1274               assign
     1275                 v-object-handle = buf_temp-diasize-handle.handle-value
     1276               .
     1277               if v-object-handle <> v-diasize-resize-button
     1278               then do:
     1279                 assign
     1280                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1281                 .
     1282               end.
     1283             end.
     1284             assign
     1285               v-diasize-browse-handle :height = v-browse-height
     1286             .
     1287             for each buf_temp-browse-handle
     1288               where buf_temp-browse-handle.browse-type = 'height':u
     1289             on error undo, next
     1290             :
     1291               assign
     1292                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1293               .
     1294             end.
     1295             assign
     1296               frame Dialog-Frame :height = v-frame-height
     1297             .
     1298             if frame Dialog-Frame :scrollable = true
     1299             then do:
     1300               assign
     1301                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1302               .
     1303             end.
     1304             run diasize_position-resize-button in this-procedure .
     1305           end.
     1306           else do:
     1307             if frame Dialog-Frame :scrollable = true
     1308             then do:
     1309               assign
     1310                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1311               .
     1312             end.
     1313             assign
     1314               frame Dialog-Frame :height = v-frame-height
     1315             .
     1316             assign
     1317               v-diasize-browse-handle :height = v-browse-height
     1318             .
     1319             for each buf_temp-browse-handle
     1320               where buf_temp-browse-handle.browse-type = 'height':u
     1321             on error undo, next
     1322             :
     1323               assign
     1324                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1325               .
     1326             end.
     1327             for each buf_temp-diasize-handle
     1328             on error undo, next
     1329             :
     1330               assign
     1331                 v-object-handle = buf_temp-diasize-handle.handle-value
     1332               .
     1333               if v-object-handle <> v-diasize-resize-button
     1334               then do:
     1335                 assign
     1336                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1337                 .
     1338               end.
     1339             end.
     1340             run diasize_position-resize-button in this-procedure .
     1341           end.
     1342           assign
     1343             v-diasize-change-size = false
     1344           .
     1345           leave move_block .
     1346         end.
     1347       end.
     1348       assign
     1349         v-diasize-need-full-display = true
     1350       .
     1351       if v-diasize-change-size = false
     1352       then do:
     1353         assign
     1354           v-diasize-change-size = true
     1355         .
     1356       end.
     1357       else do:
     1358         return .
     1359       end.
     1360       assign
     1361         v-frame-height = frame Dialog-Frame :height
     1362         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1363         v-browse-height = v-diasize-browse-handle :height
     1364       .
     1365       for each buf_temp-browse-handle
     1366         where buf_temp-browse-handle.browse-type = 'height':u
     1367       :
     1368         assign
     1369           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1370         .
     1371       end.
     1372       for each buf_temp-diasize-handle
     1373       :
     1374         delete buf_temp-diasize-handle .
     1375       end.
     1376       assign
     1377         v-field-group-handle = frame Dialog-Frame :first-child
     1378       .
     1379       do while valid-handle(v-field-group-handle)
     1380       :
     1381         assign
     1382           v-object-handle = v-field-group-handle :first-child
     1383         .
     1384         do while valid-handle(v-object-handle)
     1385         :
     1386           if  v-object-handle <> v-diasize-browse-handle :handle
     1387           and can-query(v-object-handle, "row")
     1388           and can-query(v-object-handle, "height")
     1389           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1390           then do:
     1391             find first buf_temp-browse-handle
     1392               where buf_temp-browse-handle.browse-type   = 'height':u
     1393                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1394               no-error .
     1395             if available buf_temp-browse-handle
     1396             then do:
     1397             end.
     1398             else do:
     1399               create buf_temp-diasize-handle .
     1400               assign
     1401                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1402                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1403               .
     1404             end.
     1405           end.
     1406           assign
     1407             v-object-handle = v-object-handle :next-sibling
     1408           .
     1409         end.
     1410         assign
     1411           v-field-group-handle = v-field-group-handle :next-sibling
     1412         .
     1413       end.
     1414       do with frame Dialog-Frame
     1415       :
     1416         hide v-diasize-resize-button .
     1417         assign
     1418           v-diasize-resize-button :row    = 1
     1419           v-diasize-resize-button :column = 1
     1420         .
     1421       end.
     1422       if p-change-value > 0
     1423       then do:
     1424         if frame Dialog-Frame :scrollable = true
     1425         then do:
     1426           assign
     1427             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1428             no-error .
     1429           if error-status :error
     1430           or error-status :get-message(1) <> ""
     1431           then do:
     1432             undo move_block, retry move_block .
     1433           end.
     1434         end.
     1435         assign
     1436           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1437           no-error .
     1438         if error-status :error
     1439         or error-status :get-message(1) <> ""
     1440         then do:
     1441           undo move_block, retry move_block .
     1442         end.
     1443         assign
     1444           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1445           no-error .
     1446         if error-status :error
     1447         or error-status :get-message(1) <> ""
     1448         then do:
     1449           undo move_block, retry move_block .
     1450         end.
     1451         for each buf_temp-browse-handle
     1452           where buf_temp-browse-handle.browse-type = 'height':u
     1453         on error undo move_block, retry move_block
     1454         :
     1455           assign
     1456             buf_temp-browse-handle.browse-handle :height
     1457               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1458             no-error .
     1459           if error-status :error
     1460           or error-status :get-message(1) <> ""
     1461           then do:
     1462             undo move_block, retry move_block .
     1463           end.
     1464         end.
     1465         for each buf_temp-diasize-handle
     1466         on error undo move_block, retry move_block
     1467         :
     1468           assign
     1469             v-object-handle = buf_temp-diasize-handle.handle-value
     1470           .
     1471           if v-object-handle <> v-diasize-resize-button
     1472           then do:
     1473             assign
     1474               v-object-handle :row = v-object-handle :row + p-change-value
     1475               no-error .
     1476             if error-status :error
     1477             or error-status :get-message(1) <> ""
     1478             then do:
     1479               undo move_block, retry move_block .
     1480             end.
     1481           end.
     1482         end.
     1483       end.
     1484       else do:
     1485         for each buf_temp-diasize-handle
     1486         on error undo move_block, retry move_block
     1487         :
     1488           assign
     1489             v-object-handle = buf_temp-diasize-handle.handle-value
     1490           .
     1491           if v-object-handle <> v-diasize-resize-button
     1492           then do:
     1493             assign
     1494               v-object-handle :row = v-object-handle :row + p-change-value
     1495               no-error .
     1496             if error-status :error
     1497             or error-status :get-message(1) <> ""
     1498             then do:
     1499               undo move_block, retry move_block .
     1500             end.
     1501           end.
     1502         end.
     1503         assign
     1504           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1505           no-error .
     1506         if error-status :error
     1507         or error-status :get-message(1) <> ""
     1508         then do:
     1509           undo move_block, retry move_block .
     1510         end.
     1511         for each buf_temp-browse-handle
     1512           where buf_temp-browse-handle.browse-type = 'height':u
     1513         on error undo move_block, retry move_block
     1514         :
     1515           assign
     1516             buf_temp-browse-handle.browse-handle :height
     1517               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1518             no-error .
     1519           if error-status :error
     1520           or error-status :get-message(1) <> ""
     1521           then do:
     1522             undo move_block, retry move_block .
     1523           end.
     1524         end.
     1525         assign
     1526           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1527           no-error .
     1528         if error-status :error
     1529         or error-status :get-message(1) <> ""
     1530         then do:
     1531           undo move_block, retry move_block .
     1532         end.
     1533         if frame Dialog-Frame :scrollable = true
     1534         then do:
     1535           assign
     1536             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1537             no-error .
     1538           if error-status :error
     1539           or error-status :get-message(1) <> ""
     1540           then do:
     1541             undo move_block, retry move_block .
     1542           end.
     1543         end.
     1544       end.
     1545       if p-move-resize = true
     1546       then do:
     1547         run diasize_position-resize-button in this-procedure .
     1548       end.
     1549       if v-diasize-wndstore = true
     1550       then do:
     1551         if connected("ub") = true
     1552         then do:
     1553           define variable v-cntxt-db-num        as integer   no-undo .
     1554           define variable v-cntxt-userid        as character no-undo .
     1555           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1556                                             , OUTPUT v-cntxt-userid
     1557                                             ) .
     1558           run gbl/wndsizew.p
     1559             (input  v-cntxt-db-num
     1560             ,input  v-cntxt-userid
     1561             ,input  v-diasize-proc-name
     1562             ,input  'height':u
     1563             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1564             ) .
     1565         end.
     1566       end.
     1567     end.
     1568     assign
     1569       v-diasize-change-size = false
     1570     .
     1571   end procedure.
     1572   procedure diasize_set-height :
     1573     define input  parameter p-new-height  as decimal   no-undo .
     1574     define input  parameter p-move-resize as logical   no-undo .
     1575     do
     1576     on error undo, return error return-value
     1577     :
     1578       run diasize_change-height in this-procedure
     1579         (input  (p-new-height - frame Dialog-Frame :height)
     1580         ,input  p-move-resize
     1581         ) .
     1582     end.
     1583   end procedure.
     1584   procedure diasize_change-width :
     1585     define input  parameter p-change-value as decimal   no-undo .
     1586     define input  parameter p-move-resize  as logical   no-undo .
     1587     define variable v-field-group-handle   as handle    no-undo .
     1588     define variable v-object-handle        as handle    no-undo .
     1589     define variable v-frame-width          as decimal   no-undo .
     1590     define variable v-frame-virtual-width  as decimal   no-undo .
     1591     define variable v-browse-width         as decimal   no-undo .
     1592     define variable v-window-width         as decimal   no-undo .
     1593     define variable v-window-virtual-width as decimal   no-undo .
     1594     define variable v-change-sign          as integer   no-undo .
     1595     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1596     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1597     if p-change-value > 0
     1598     then do:
     1599       if frame Dialog-Frame :width + p-change-value >
     1600           session :width-chars
     1601       then do:
     1602         assign
     1603           p-change-value = session :width-chars - frame Dialog-Frame :width
     1604         .
     1605         if p-change-value <= 0
     1606         then do:
     1607           run diasize_position-resize-button in this-procedure .
     1608           return .
     1609         end.
     1610       end.
     1611     end.
     1612     if p-change-value < 0
     1613     then do:
     1614       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1615       then do:
     1616         assign
     1617           p-change-value = v-diasize-orig-frame-width
     1618                          - frame Dialog-Frame :width
     1619         .
     1620         if p-change-value >= 0
     1621         then do:
     1622           run diasize_position-resize-button in this-procedure .
     1623           return .
     1624         end.
     1625       end.
     1626     end.
     1627     if p-change-value >= 0
     1628     then do:
     1629       assign
     1630         v-change-sign = 1
     1631       .
     1632     end.
     1633     else do:
     1634       assign
     1635         v-change-sign = -1
     1636       .
     1637     end.
     1638     assign
     1639       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1640     .
     1641     if p-change-value = 0
     1642     then do:
     1643       run diasize_position-resize-button in this-procedure .
     1644       return .
     1645     end.
     1646     move_block:
     1647     do
     1648     on error undo move_block, leave move_block
     1649     :
     1650       if retry
     1651       then do:
     1652         do
     1653         on error undo move_block, leave move_block
     1654         :
     1655           if p-change-value > 0
     1656           then do:
     1657             for each buf_temp-diasize-handle
     1658             on error undo, next
     1659             :
     1660               assign
     1661                 v-object-handle = buf_temp-diasize-handle.handle-value
     1662               .
     1663               if v-object-handle <> v-diasize-resize-button
     1664               then do:
     1665                 assign
     1666                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1667                 .
     1668               end.
     1669             end.
     1670             assign
     1671               v-diasize-browse-handle :width = v-browse-width
     1672             .
     1673             for each buf_temp-browse-handle
     1674               where buf_temp-browse-handle.browse-type = 'width':u
     1675             on error undo, next
     1676             :
     1677               assign
     1678                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1679               .
     1680             end.
     1681             assign
     1682               frame Dialog-Frame :width = v-frame-width
     1683             .
     1684             if frame Dialog-Frame :scrollable = true
     1685             then do:
     1686               assign
     1687                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1688               .
     1689             end.
     1690             run diasize_position-resize-button in this-procedure .
     1691           end.
     1692           else do:
     1693             if frame Dialog-Frame :scrollable = true
     1694             then do:
     1695               assign
     1696                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1697               .
     1698             end.
     1699             assign
     1700               frame Dialog-Frame :width = v-frame-width
     1701             .
     1702             for each buf_temp-browse-handle
     1703               where buf_temp-browse-handle.browse-type = 'width':u
     1704             on error undo, next
     1705             :
     1706               assign
     1707                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1708               .
     1709             end.
     1710             assign
     1711               v-diasize-browse-handle :width = v-browse-width
     1712             .
     1713             for each buf_temp-diasize-handle
     1714             on error undo, next
     1715             :
     1716               assign
     1717                 v-object-handle = buf_temp-diasize-handle.handle-value
     1718               .
     1719               if v-object-handle <> v-diasize-resize-button
     1720               then do:
     1721                 assign
     1722                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1723                 .
     1724               end.
     1725             end.
     1726             run diasize_position-resize-button in this-procedure .
     1727           end.
     1728           assign
     1729             v-diasize-change-size = false
     1730           .
     1731           leave move_block .
     1732         end.
     1733       end.
     1734       assign
     1735         v-diasize-need-full-display = true
     1736       .
     1737       if v-diasize-change-size = false
     1738       then do:
     1739         assign
     1740           v-diasize-change-size = true
     1741         .
     1742       end.
     1743       else do:
     1744         return .
     1745       end.
     1746       assign
     1747         v-frame-width = frame Dialog-Frame :width
     1748         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1749         v-browse-width = v-diasize-browse-handle :width
     1750       .
     1751       for each buf_temp-browse-handle
     1752         where buf_temp-browse-handle.browse-type = 'width':u
     1753       :
     1754         assign
     1755           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1756         .
     1757       end.
     1758       for each buf_temp-diasize-handle
     1759       :
     1760         delete buf_temp-diasize-handle .
     1761       end.
     1762       assign
     1763         v-field-group-handle = frame Dialog-Frame :first-child
     1764       .
     1765       do while valid-handle(v-field-group-handle)
     1766       :
     1767         assign
     1768           v-object-handle = v-field-group-handle :first-child
     1769         .
     1770         do while valid-handle(v-object-handle)
     1771         :
     1772           if  v-object-handle <> v-diasize-browse-handle :handle
     1773           and v-object-handle <> v-diasize-resize-button
     1774           and can-query(v-object-handle, "row")
     1775           and can-query(v-object-handle, "height")
     1776           and ( v-object-handle :col + v-object-handle :width
     1777                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1778               )
     1779           then do:
     1780             find first buf_temp-browse-handle
     1781               where buf_temp-browse-handle.browse-type   = 'width':u
     1782                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1783               no-error .
     1784             if available buf_temp-browse-handle
     1785             then do:
     1786             end.
     1787             else do:
     1788               create buf_temp-diasize-handle .
     1789               assign
     1790                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1791                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1792               .
     1793             end.
     1794           end.
     1795           assign
     1796             v-object-handle = v-object-handle :next-sibling
     1797           .
     1798         end.
     1799         assign
     1800           v-field-group-handle = v-field-group-handle :next-sibling
     1801         .
     1802       end.
     1803       do with frame Dialog-Frame
     1804       :
     1805         hide v-diasize-resize-button .
     1806         v-diasize-resize-button :row = 1.
     1807         v-diasize-resize-button :column = 1.
     1808       end.
     1809       if p-change-value > 0
     1810       then do:
     1811         if frame Dialog-Frame :scrollable = true
     1812         then do:
     1813           assign
     1814             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1815             no-error .
     1816           if error-status :error
     1817           or error-status :get-message(1) <> ""
     1818           then do:
     1819             undo move_block, retry move_block.
     1820           end.
     1821         end.
     1822         assign
     1823           frame Dialog-Frame :width = v-frame-width + p-change-value
     1824           no-error .
     1825         if error-status :error
     1826         or error-status :get-message(1) <> ""
     1827         then do:
     1828           undo move_block, retry move_block.
     1829         end.
     1830         assign
     1831           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1832         no-error .
     1833         if error-status :error
     1834         or error-status :get-message(1) <> ""
     1835         then do:
     1836           undo move_block, retry move_block.
     1837         end.
     1838         for each buf_temp-browse-handle
     1839           where buf_temp-browse-handle.browse-type = 'width':u
     1840         on error undo move_block, retry move_block
     1841         :
     1842           assign
     1843             buf_temp-browse-handle.browse-handle :width
     1844               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1845             no-error .
     1846           if error-status :error
     1847           or error-status :get-message(1) <> ""
     1848           then do:
     1849             undo move_block, retry move_block .
     1850           end.
     1851         end.
     1852         for each buf_temp-diasize-handle
     1853         on error undo move_block, retry move_block
     1854         :
     1855           assign
     1856             v-object-handle = buf_temp-diasize-handle.handle-value
     1857           .
     1858           if v-object-handle <> v-diasize-resize-button
     1859           then do:
     1860             assign
     1861               v-object-handle :col = v-object-handle :col + p-change-value
     1862               no-error .
     1863             if error-status :error
     1864             or error-status :get-message(1) <> ""
     1865             then do:
     1866               undo move_block, retry move_block .
     1867             end.
     1868           end.
     1869         end.
     1870       end.
     1871       else do:
     1872         for each buf_temp-diasize-handle
     1873         on error undo move_block, retry move_block
     1874         :
     1875           assign
     1876             v-object-handle = buf_temp-diasize-handle.handle-value
     1877           .
     1878           if v-object-handle <> v-diasize-resize-button
     1879           then do:
     1880             assign
     1881               v-object-handle :col = v-object-handle :col + p-change-value
     1882               no-error .
     1883             if error-status :error
     1884             or error-status :get-message(1) <> ""
     1885             then do:
     1886               undo move_block, retry move_block .
     1887             end.
     1888           end.
     1889         end.
     1890         for each buf_temp-browse-handle
     1891           where buf_temp-browse-handle.browse-type = 'width':u
     1892         on error undo move_block, retry move_block
     1893         :
     1894           assign
     1895             buf_temp-browse-handle.browse-handle :width
     1896               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1897             no-error .
     1898           if error-status :error
     1899           or error-status :get-message(1) <> ""
     1900           then do:
     1901             undo move_block, retry move_block .
     1902           end.
     1903         end.
     1904         assign
     1905           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1906           no-error .
     1907         if error-status :error
     1908         or error-status :get-message(1) <> ""
     1909         then do:
     1910           undo move_block, retry move_block.
     1911         end.
     1912         assign
     1913           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1914         no-error .
     1915         if error-status :error
     1916         or error-status :get-message(1) <> ""
     1917         then do:
     1918           undo move_block, retry move_block.
     1919         end.
     1920         if frame Dialog-Frame :scrollable = true
     1921         then do:
     1922           assign
     1923             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1924           no-error .
     1925           if error-status :error
     1926           or error-status :get-message(1) <> ""
     1927           then do:
     1928             undo move_block, retry move_block.
     1929           end.
     1930         end.
     1931       end.
     1932       if p-move-resize
     1933       then do:
     1934         run diasize_position-resize-button in this-procedure .
     1935       end.
     1936       if v-diasize-wndstore = true
     1937       then do:
     1938         if connected("ub") = true
     1939         then do:
     1940           define variable v-cntxt-db-num        as integer   no-undo .
     1941           define variable v-cntxt-userid        as character no-undo .
     1942           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1943                                             , OUTPUT v-cntxt-userid
     1944                                             ) .
     1945           run gbl/wndsizew.p
     1946             (input  v-cntxt-db-num
     1947             ,input  v-cntxt-userid
     1948             ,input  v-diasize-proc-name
     1949             ,input  'width':u
     1950             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1951             ) .
     1952         end.
     1953       end.
     1954     end.
     1955     assign
     1956       v-diasize-change-size = false
     1957     .
     1958   end procedure.
     1959   procedure diasize_set-width :
     1960     define input  parameter p-new-width  as decimal   no-undo .
     1961     define input  parameter p-move-resize as logical   no-undo .
     1962     do
     1963     on error undo, return error return-value
     1964     :
     1965       run diasize_change-width in this-procedure
     1966         (input  (p-new-width - frame Dialog-Frame :width)
     1967         ,input  p-move-resize
     1968         ) .
     1969     end.
     1970   end procedure.
     1971   procedure diasize_position-resize-button :
     1972     do with frame Dialog-Frame
     1973     :
     1974       hide v-diasize-resize-button .
     1975       assign
     1976         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1977                     - 1
     1978                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1979         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1980                     - 1
     1981                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1982       .
     1983       view v-diasize-resize-button .
     1984     end.
     1985   end procedure.
     1986   on alt-right anywhere
     1987   do:
     1988     run diasize_change-width in this-procedure
     1989       (input 1
     1990       ,input true
     1991       ) .
     1992     return no-apply .
     1993   end.
     1994   on alt-left anywhere
     1995   do:
     1996     run diasize_change-width in this-procedure
     1997       (input -1
     1998       ,input true
     1999       ) .
     2000     return no-apply .
     2001   end.
     2002   on alt-down anywhere
     2003   do:
     2004     run diasize_change-height in this-procedure
     2005       (input 1
     2006       ,input true
     2007       ) .
     2008     return no-apply .
     2009   end.
     2010   on alt-up anywhere
     2011   do:
     2012     run diasize_change-height in this-procedure
     2013       (input -1
     2014       ,input true
     2015       ) .
     2016     return no-apply .
     2017   end.
     2018   on alt-enter of frame Dialog-Frame
     2019   do:
     2020     run diasize_maximize in this-procedure
     2021       (input  ?
     2022       ).
     2023     return no-apply .
     2024   end.
     2025   procedure diasize_end-move :
     2026     do
     2027     on error undo, return error return-value
     2028     :
     2029       define variable v-row-delta as decimal   no-undo .
     2030       define variable v-col-delta as decimal   no-undo .
     2031       define variable v-new-row as decimal   no-undo .
     2032       define variable v-new-col as decimal   no-undo .
     2033       assign
     2034         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2035         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2036       .
     2037       assign
     2038         v-row-delta = v-new-row - frame Dialog-Frame :height
     2039         v-col-delta = v-new-col - frame Dialog-Frame :width
     2040       .
     2041       run diasize_change-height in this-procedure
     2042         (input v-row-delta
     2043         ,input true
     2044         ) .
     2045       run diasize_change-width in this-procedure
     2046         (input v-col-delta
     2047         ,input true
     2048         ) .
     2049     end.
     2050   end procedure.
     2051   procedure diasize_maximize :
     2052     define input  parameter p-action as logical   no-undo .
     2053     do
     2054     on error undo, return error return-value
     2055     :
     2056       if p-action = ?
     2057       then do:
     2058         if v-diasize-need-maximize = true
     2059         then do:
     2060           assign
     2061             p-action = true
     2062           .
     2063         end.
     2064         else do:
     2065           assign
     2066             p-action = false
     2067           .
     2068         end.
     2069       end.
     2070       if p-action = true
     2071       then do:
     2072         run diasize_change-height in this-procedure
     2073           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2074               - frame Dialog-Frame :height-chars
     2075           ,input true
     2076           ) .
     2077         run diasize_change-width in this-procedure
     2078           (input session :width-chars
     2079               - frame Dialog-Frame :width-chars
     2080           ,input true
     2081           ) .
     2082         assign
     2083           v-diasize-need-maximize = false
     2084         .
     2085       end.
     2086       else do:
     2087         run diasize_change-width in this-procedure
     2088           (input v-diasize-orig-frame-width
     2089               - frame Dialog-Frame :width-chars
     2090           ,input true
     2091           ) .
     2092         run diasize_change-height in this-procedure
     2093           (input v-diasize-orig-frame-height
     2094               - frame Dialog-Frame :height-chars
     2095           ,input true
     2096           ) .
     2097         assign
     2098           v-diasize-need-maximize = true
     2099         .
     2100       end.
     2101     end.
     2102   end procedure.
     2103   procedure diasize_restore-orig-size :
     2104     do
     2105     on error undo, return error return-value
     2106     :
     2107       assign
     2108         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2109         v-diasize-current-frame-height = frame Dialog-Frame :height
     2110       .
     2111       run diasize_set-height in this-procedure
     2112         (input  v-diasize-orig-frame-height
     2113         ,input  true
     2114         ) .
     2115       run diasize_set-width in this-procedure
     2116         (input  v-diasize-orig-frame-width
     2117         ,input  true
     2118         ) .
     2119     end.
     2120   end procedure.
     2121   procedure diasize_restore-current-size :
     2122     do
     2123     on error undo, return error return-value
     2124     :
     2125       run diasize_set-height in this-procedure
     2126         (input  v-diasize-current-frame-height
     2127         ,input  true
     2128         ) .
     2129       run diasize_set-width in this-procedure
     2130         (input  v-diasize-current-frame-width
     2131         ,input  true
     2132         ) .
     2133     end.
     2134   end procedure.
     2135   procedure diasize_set-browse-handle :
     2136     define input  parameter p-browse-handle as handle   no-undo .
     2137     define buffer buf_temp-browse-handle for temp-browse-handle .
     2138     do
     2139     on error undo, return error return-value
     2140     :
     2141       assign
     2142         v-diasize-browse-handle = p-browse-handle
     2143       .
     2144       for each buf_temp-browse-handle
     2145       on error undo, return error return-value
     2146       :
     2147         delete buf_temp-browse-handle .
     2148       end.
     2149     end.
     2150   end procedure.
     2151   procedure diasize_add_browse :
     2152     define input  parameter p-browse-type   as character no-undo .
     2153     define input  parameter p-browse-handle as handle    no-undo .
     2154     define buffer buf_temp-browse-handle for temp-browse-handle .
     2155     do
     2156     on error undo, return error return-value
     2157     :
     2158       assign
     2159         v-diasize-browse-number = v-diasize-browse-number + 1
     2160       .
     2161       create buf_temp-browse-handle .
     2162       assign
     2163         buf_temp-browse-handle.browse-type   = p-browse-type
     2164         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2165         buf_temp-browse-handle.browse-handle = p-browse-handle
     2166       .
     2167     end.
     2168   end procedure.
     2169   procedure diasize_init :
     2170     define variable v-default-value    as logical   no-undo .
     2171     define variable v-restore-saved    as logical   no-undo .
     2172     define variable v-resize-value-str as character no-undo .
     2173     do
     2174     on error undo, return error return-value
     2175     :
     2176       do with frame Dialog-Frame
     2177       :
     2178         assign
     2179           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2180           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2181           v-diasize-browse-handle     = browse BROWSE-item :handle
     2182         .
     2183         create button v-diasize-resize-button
     2184         assign
     2185           parent        = frame Dialog-Frame :first-child
     2186           label         = "s"
     2187           height-pixels = 16
     2188           width-pixels  = 16
     2189           visible       = true
     2190           sensitive     = true
     2191           movable       = true
     2192           triggers:
     2193             on end-move persistent run diasize_end-move in this-procedure .
     2194           end triggers.
     2195         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2196         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2197         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2198         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2199         assign
     2200           v-diasize-wndmax = false
     2201         .
     2202         if connected("ub") = true
     2203         then do:
     2204           define variable v-cntxt-db-num        as integer   no-undo .
     2205           define variable v-cntxt-userid        as character no-undo .
     2206           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2207                                             , OUTPUT v-cntxt-userid
     2208                                             ) .
     2209           run gbl/wndpar_r.p
     2210             (input  v-cntxt-db-num
     2211             ,input  v-cntxt-userid
     2212             ,input  'wndmax':U
     2213             ,output v-diasize-wndmax
     2214             ,output v-default-value
     2215             ) .
     2216         end.
     2217         assign
     2218           v-diasize-wndstore = false
     2219         .
     2220         if connected("ub") = true
     2221         then do:
     2222           run gbl/wndpar_r.p
     2223             (input  v-cntxt-db-num
     2224             ,input  v-cntxt-userid
     2225             ,input  'wndstore':U
     2226             ,output v-diasize-wndstore
     2227             ,output v-default-value
     2228             ) .
     2229         end.
     2230         assign
     2231           v-diasize-proc-name = entry(1, program-name(2), '.')
     2232         .
     2233         if v-diasize-wndstore = true
     2234         then do:
     2235           assign
     2236             v-restore-saved = false
     2237           .
     2238           if connected("ub") = true
     2239           then do:
     2240             run gbl/wndsizer.p
     2241               (input  v-cntxt-db-num
     2242               ,input  v-cntxt-userid
     2243               ,input  v-diasize-proc-name
     2244               ,input  'height':u
     2245               ,output v-resize-value-str
     2246               ) .
     2247             if v-resize-value-str <> '':U
     2248             then do:
     2249               run diasize_change-height in this-procedure
     2250                 (input  integer(v-resize-value-str)
     2251                 ,input  true
     2252                 ) .
     2253               assign
     2254                 v-restore-saved = true
     2255               .
     2256             end.
     2257           end.
     2258           if connected("ub") = true
     2259           then do:
     2260             run gbl/wndsizer.p
     2261               (input  v-cntxt-db-num
     2262               ,input  v-cntxt-userid
     2263               ,input  v-diasize-proc-name
     2264               ,input  'width':u
     2265               ,output v-resize-value-str
     2266               ) .
     2267             if v-resize-value-str <> '':U
     2268             then do:
     2269               run diasize_change-width in this-procedure
     2270                 (input  integer(v-resize-value-str)
     2271                 ,input  true
     2272                 ) .
     2273               assign
     2274                 v-restore-saved = true
     2275               .
     2276             end.
     2277           end.
     2278           if v-restore-saved <> true
     2279           then do:
     2280             if v-diasize-wndmax = true
     2281             then do:
     2282               run diasize_maximize in this-procedure
     2283                 (input  true
     2284                 ) .
     2285             end.
     2286           end.
     2287         end.
     2288         else do:
     2289           if v-diasize-wndmax = true
     2290           then do:
     2291             run diasize_maximize in this-procedure
     2292               (input  true
     2293               ) .
     2294           end.
     2295         end.
     2296       end.
     2297     end.
     2298   end procedure.
     2299   procedure diasize_need-full-display :
     2300     define output parameter p-need-full-display as logical   no-undo .
     2301     do
     2302     on error undo, return error return-value
     2303     :
     2304       assign
     2305         p-need-full-display = v-diasize-need-full-display
     2306       .
     2307       assign
     2308         v-diasize-need-full-display = false
     2309       .
     2310     end.
     2311   end procedure.
     2312   procedure get-context :
     2313      define output parameter p-db-num as integer          no-undo.
     2314      define output parameter p-user-id as character        no-undo.
     2315      define variable v-login               as character    no-undo.
     2316      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2317      define buffer buf_user-login  for ub.user-login .
     2318      do
     2319      on error undo, return error
     2320      :
     2321            FIND FIRST buf_sys-ctrl no-lock.
     2322            ASSIGN
     2323               v-login = USERID("ub")
     2324               p-db-num = buf_sys-ctrl.db-num
     2325            .
     2326            FIND FIRST buf_user-login
     2327                 WHERE buf_user-login.db-num = p-db-num
     2328                   AND buf_user-login.user-login = v-login
     2329                 no-lock
     2330                 no-error
     2331                 .
     2332            IF AVAILABLE buf_user-login
     2333            THEN DO:
     2334               assign
     2335                  p-user-id = buf_user-login.user-id
     2336               .
     2337            END.
     2338      end.
     2339   end procedure.
     2340       run diasize_init in this-procedure .
     2341   define variable vss-include-info12 as character format "X(65)" no-undo
     2342   initial "@(#)$Workfile$ $Revision$".
     2343   do:
     2344     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run actn-gbl in g#library2
     2345       ( output v-on-gbl
     2346       ) no-error .
     2347   end.
     2348       assign
     2349           cb-group :list-item-pairs = substitute( "<Все>,&1", -1 )
     2350       .
     2351       for each buf_action-group no-lock
     2352       on error undo, return error
     2353       :
     2354           assign
     2355               cb-group :list-item-pairs = substitute( "&1,&2,&3", cb-group :list-item-pairs, buf_action-group.action-group-name, buf_action-group.action-group-code)
     2356           .
     2357       end.
     2358       assign
     2359           cb-group = -1
     2360       .
     2361     RUN enable_UI.
     2362     RUN post_enable_UI.
     2363     WAIT-FOR GO OF FRAME Dialog-Frame.
     2364   END.
     2365   RUN disable_UI.
     2366   PROCEDURE assign-filter-mark :
     2367   define input parameter p-name-filter    as character        no-undo.
     2368   define buffer buf_action-group         for ub.action-group .
     2369   define buffer buf_action-item          for ub.action-item .
     2370   define buffer buf_temp_filter-fields      for temp_filter-fields .
     2371   do
     2372   on error undo, return error
     2373   :
     2374       FOR EACH  buf_action-item
     2375           WHERE buf_action-item.action-head-code = 0
     2376           NO-LOCK
     2377           ,
     2378           FIRST buf_action-group
     2379           WHERE (buf_action-group.action-head-code  = buf_action-item.action-head-code
     2380             AND buf_action-group.action-group-code = buf_action-item.action-group-code)
     2381              OR (buf_action-group.action-head-code  = buf_action-item.action-head-code
     2382             AND buf_action-group.action-group-id   = buf_action-item.action-group-id)
     2383           NO-LOCK
     2384           :
     2385         find first buf_temp_filter-fields
     2386               where buf_temp_filter-fields.action-item-code = buf_action-item.action-item-code
     2387         no-error.
     2388         if not available buf_temp_filter-fields
     2389         then do:
     2390            create buf_temp_filter-fields.
     2391            assign
     2392                  buf_temp_filter-fields.action-item-code = buf_action-item.action-item-code
     2393                  buf_temp_filter-fields.record-on = no
     2394            .
     2395         end.
     2396         IF ( p-name-filter = "":U )
     2397         OR index( buf_action-item.action-item-name, p-name-filter ) <> 0
     2398         or index( buf_action-item.action-item-description, p-name-filter ) <> 0
     2399         or index( buf_action-group.action-group-name, p-name-filter ) <> 0
     2400         or index( buf_action-item.action-item-id, p-name-filter ) <> 0
     2401         then do:
     2402            assign
     2403               buf_temp_filter-fields.record-on = yes
     2404            .
     2405         end.
     2406         else do:
     2407            assign
     2408               buf_temp_filter-fields.record-on = NO
     2409            .
     2410         end.
     2411       end.
     2412   end.
     2413   END PROCEDURE.
     2414   PROCEDURE disable_UI :
     2415     HIDE FRAME Dialog-Frame.
     2416   END PROCEDURE.
     2417   PROCEDURE enable_UI :
     2418     DISPLAY v-filter tb-filter cb-group rs-scope item-EDITOR
     2419         WITH FRAME Dialog-Frame.
     2420     ENABLE b-mark b-sel b-group b-user b-filter v-filter b-help tb-filter
     2421            cb-group rs-scope b-print BROWSE-item item-EDITOR
     2422         WITH FRAME Dialog-Frame.
     2423     VIEW FRAME Dialog-Frame.
     2424     run local-open-query-item in this-procedure .
     2425   END PROCEDURE.
     2426   PROCEDURE local-open-query-item :
     2427   do
     2428   on error undo, return
     2429   :
     2430      if tb-filter = yes then do:
     2431         run assign-filter-mark IN THIS-PROCEDURE
     2432                        ( input v-filter
     2433                        ) .
     2434      end.
     2435      else do:
     2436         run assign-filter-mark IN THIS-PROCEDURE
     2437                        ( input ""
     2438                        ) .
     2439      end.
     2440      case v-context:
     2441      WHEN 'global':U OR
     2442      WHEN 'firm':U   OR
     2443      WHEN 'object':U THEN DO:
     2444         OPEN QUERY BROWSE-item
     2445         FOR EACH br_action-item
     2446            WHERE br_action-item.action-head-code = 0
     2447            AND br_action-item.action-item-context = v-context
     2448            NO-LOCK
     2449            ,
     2450            FIRST br_action-group
     2451            WHERE (br_action-group.action-head-code  = br_action-item.action-head-code
     2452               AND br_action-group.action-group-code  = br_action-item.action-group-code)
     2453               OR (br_action-group.action-head-code   = br_action-item.action-head-code
     2454               AND br_action-group.action-group-id    = br_action-item.action-group-id)
     2455               AND (br_action-group.action-group-code = cb-group
     2456                OR cb-group = -1)
     2457            NO-LOCK
     2458            ,
     2459            FIRST br_temp_filter-fields
     2460            WHERE br_temp_filter-fields.action-item-code   = br_action-item.action-item-code
     2461               and br_temp_filter-fields.record-on          = YES
     2462            NO-LOCK
     2463               BY br_action-item.action-head-code
     2464               BY br_action-item.action-group-code
     2465               BY br_action-item.action-item-name
     2466               INDEXED-REPOSITION
     2467               .
     2468      END.
     2469      OTHERWISE DO:
     2470         OPEN QUERY BROWSE-item
     2471         FOR EACH br_action-item
     2472            WHERE br_action-item.action-head-code = 0
     2473            NO-LOCK
     2474            ,
     2475            FIRST br_action-group
     2476            WHERE (br_action-group.action-head-code  = br_action-item.action-head-code
     2477               AND br_action-group.action-group-code  = br_action-item.action-group-code)
     2478               OR (br_action-group.action-head-code   = br_action-item.action-head-code
     2479               AND br_action-group.action-group-id    = br_action-item.action-group-id)
     2480               AND (br_action-group.action-group-code = cb-group
     2481                OR cb-group = -1)
     2482            NO-LOCK
     2483            ,
     2484            FIRST br_temp_filter-fields
     2485            WHERE br_temp_filter-fields.action-item-code   = br_action-item.action-item-code
     2486               and br_temp_filter-fields.record-on          = YES
     2487            NO-LOCK
     2488               BY br_action-item.action-head-code
     2489               BY br_action-item.action-group-code
     2490               BY br_action-item.action-item-name
     2491               INDEXED-REPOSITION
     2492               .
     2493      END.
     2494      end case.
     2495      if available br_action-item then do:
     2496         assign
     2497            item-editor = br_action-item.action-item-description
     2498         .
     2499         display
     2500            item-editor
     2501         with frame Dialog-Frame.
     2502      end.
     2503   end.
     2504   END PROCEDURE.
     2505   PROCEDURE mark-string :
     2506   do
     2507   on error undo, return error
     2508   :
     2509   end.
     2510   END PROCEDURE.
     2511   PROCEDURE post_enable_UI :
     2512   do
     2513   on error undo, return error
     2514   :
     2515       disable
     2516           b-sel
     2517           b-mark
     2518           b-quit
     2519       WITH FRAME  Dialog-Frame.
     2520       IF ((lookup( "b-sel" , p-buttons) > 0 ) OR (lookup( "b-mark", p-buttons) > 0 ))
     2521       THEN b-quit:LABEL IN FRAME  Dialog-Frame  = "&Отмена".
     2522       ELSE b-quit:LABEL IN FRAME  Dialog-Frame  = "&Выход".
     2523       ENABLE
     2524           b-quit
     2525           b-sel  WHEN  ((lookup( "b-sel" , p-buttons) > 0 ) OR (lookup( "b-mark", p-buttons) > 0 ))
     2526           b-mark when  (lookup( "b-mark", p-buttons) > 0 )
     2527       WITH FRAME  Dialog-Frame.
     2528       IF ((lookup( "b-sel" , p-buttons) > 0 ) OR (lookup( "b-mark", p-buttons) > 0 ))
     2529       THEN b-quit:LABEL IN FRAME  Dialog-Frame  = "&Отмена".
     2530       ELSE b-quit:LABEL IN FRAME  Dialog-Frame  = "&Выход".
     2531   end.
     2532   END PROCEDURE.
     2533   PROCEDURE show-roles-for-item :
     2534   define input parameter p-action-head-code   as integer          no-undo.
     2535   define input parameter p-action-item-code   as integer          no-undo.
     2536   define input parameter p-action-item-name   as character        no-undo.
     2537       define variable v-accepted      as logical      no-undo.
     2538       define variable v-cur-ext-key   as character    no-undo.
     2539       define buffer buf_action-role-item          for ub.action-role-item.
     2540       define buffer buf_action-role               for ub.action-role.
     2541       define buffer buf_temp_actnrole             for temp_actnrole.
     2542   do
     2543   for buf_action-role-item
     2544     , buf_action-role
     2545   on error undo, return error
     2546   :
     2547       run onewin_clear in this-procedure.
     2548       empty temp-table buf_temp_actnrole.
     2549       for each buf_action-role-item
     2550          where buf_action-role-item.action-head-code = p-action-head-code
     2551            and buf_action-role-item.action-item-code = p-action-item-code
     2552            no-lock
     2553            ,
     2554            FIRST buf_action-role
     2555            where buf_action-role.action-head-code    = buf_action-role-item.action-head-code
     2556              and buf_action-role.action-role-code    = buf_action-role-item.action-role-code
     2557            no-lock
     2558            on error undo, return error
     2559            :
     2560            find first buf_temp_actnrole
     2561                  where buf_temp_actnrole.action-role-code = buf_action-role.action-role-code
     2562            no-error.
     2563            if not available buf_temp_actnrole
     2564            then do:
     2565                  create buf_temp_actnrole.
     2566                  assign
     2567                     buf_temp_actnrole.action-role-code = buf_action-role.action-role-code
     2568                     buf_temp_actnrole.action-role-Name   = buf_action-role.action-role-name
     2569                     buf_temp_actnrole.action-role-context = buf_action-role.action-role-context
     2570                  .
     2571            end.
     2572       end.
     2573       for each buf_temp_actnrole
     2574       on error undo, return error
     2575       :
     2576           run onewin_add-item in this-procedure (
     2577                 input buf_temp_actnrole.action-role-code
     2578               , buf_temp_actnrole.action-role-name
     2579               , context(buf_temp_actnrole.action-role-context)
     2580               , input no
     2581           ).
     2582       end.
     2583       run gbl/onewin.w (
     2584             input parparentproc
     2585           , input 0
     2586           , input substitute( "Список групп для права < &1 >", p-action-item-name )
     2587           , input "":U
     2588           , input "&Тест"
     2589           , input table temp_onewin_items
     2590           , output table temp_onewin_itemsSelected
     2591           , output v-cur-ext-key
     2592           , output v-accepted
     2593       ).
     2594   end.
     2595   END PROCEDURE.
     2596   PROCEDURE show-users-for-item :
     2597   define input parameter p-db-num             as integer          no-undo.
     2598   define input parameter p-action-head-code   as integer          no-undo.
     2599   define input parameter p-action-item-code   as integer          no-undo.
     2600   define input parameter p-action-item-name   as character        no-undo.
     2601       define variable v-accepted      as logical      no-undo.
     2602       define variable v-cur-ext-key   as character    no-undo.
     2603       define buffer buf_action-role-item          for ub.action-role-item.
     2604       define buffer buf_user-login-action-role    for ub.user-login-action-role.
     2605       define buffer buf_temp_actnrole-user        for temp_actnrole-user.
     2606       define buffer buf_user-account              for ub.user-account.
     2607       define buffer buf_user-login                for ub.user-login.
     2608   do
     2609   for buf_action-role-item
     2610     , buf_user-login-action-role
     2611     , buf_temp_actnrole-user
     2612     , buf_user-account
     2613     , buf_user-login
     2614   on error undo, return error
     2615   :
     2616       run onewin_clear in this-procedure.
     2617       empty temp-table buf_temp_actnrole-user.
     2618       for each buf_action-role-item no-lock
     2619          where buf_action-role-item.db-num           = (if v-on-gbl then 0 else p-db-num)
     2620            and buf_action-role-item.action-head-code = p-action-head-code
     2621            and buf_action-role-item.action-item-code = p-action-item-code
     2622       on error undo, return error
     2623       :
     2624           for each buf_user-login-action-role no-lock
     2625              where buf_user-login-action-role.db-num              = p-db-num
     2626                and buf_user-login-action-role.action-head-code    = buf_action-role-item.action-head-code
     2627                and buf_user-login-action-role.action-role-code    = buf_action-role-item.action-role-code
     2628           use-index ie03
     2629           on error undo, return error
     2630           :
     2631               find first buf_temp_actnrole-user
     2632                    where buf_temp_actnrole-user.user-id = buf_user-login-action-role.user-id
     2633               no-error.
     2634               if not available buf_temp_actnrole-user
     2635               then do:
     2636                   create buf_temp_actnrole-user.
     2637                   assign
     2638                       buf_temp_actnrole-user.user-id = buf_user-login-action-role.user-id
     2639                   .
     2640                   find first buf_user-account no-lock
     2641                       where buf_user-account.user-id = buf_user-login-action-role.user-id
     2642                   .
     2643                   assign
     2644                       buf_temp_actnrole-user.nik        = buf_user-account.nik
     2645                       buf_temp_actnrole-user.lastName   = buf_user-account.last-name
     2646                       buf_temp_actnrole-user.firstName  = buf_user-account.first-name
     2647                       buf_temp_actnrole-user.secondName = buf_user-account.second-name
     2648                   .
     2649               end.
     2650           end.
     2651       end.
     2652       for each buf_temp_actnrole-user
     2653       on error undo, return error
     2654       :
     2655           run onewin_add-item in this-procedure (
     2656                 input buf_temp_actnrole-user.user-id
     2657               , input ( if buf_temp_actnrole-user.nik = "":U
     2658                         then buf_temp_actnrole-user.lastName else buf_temp_actnrole-user.nik )
     2659               , input substitute( "&1 &2 &3 (&4)"
     2660                       , buf_temp_actnrole-user.lastName
     2661                       , buf_temp_actnrole-user.firstName
     2662                       , buf_temp_actnrole-user.secondName
     2663                       , buf_temp_actnrole-user.user-id )
     2664               , input no
     2665           ).
     2666       end.
     2667       run gbl/onewin.w (
     2668             input parparentproc
     2669           , input 0
     2670           , input substitute( "Список пользователей для права < &1 >", p-action-item-name )
     2671           , input "":U
     2672           , input "&Тест"
     2673           , input table temp_onewin_items
     2674           , output table temp_onewin_itemsSelected
     2675           , output v-cur-ext-key
     2676           , output v-accepted
     2677       ).
     2678   end.
     2679   END PROCEDURE.
     2680   FUNCTION context RETURNS CHARACTER
     2681     ( INPUT p-context AS character ) :
     2682     CASE p-context:
     2683     WHEN  'global':U THEN DO:
     2684                 RETURN "Без привязки".
     2685     END.
     2686     WHEN  'firm':U THEN DO:
     2687                 RETURN "Фирма".
     2688     END.
     2689     WHEN  'object':U THEN DO:
     2690                 RETURN "Объект".
     2691     END.
     2692     OTHERWISE DO:
     2693                 RETURN "":U.
     2694     END.
     2695     end case.
     2696   END FUNCTION.
     2697   FUNCTION chek-action-gds-group RETURNS character
     2698      ( INPUT p-action-item-code AS integer ):
     2699   find first ub.global-state no-lock .
     2700   if can-find ( first ub.global-state-attr no-lock
     2701        where ub.global-state-attr.gls-id = ub.global-state.gls-id
     2702          and ub.global-state-attr.attr-code = "action-gds-groups"
     2703           and logical(ub.global-state-attr.attr-value ) = true)
     2704   then do :
     2705     find first buf_action-item-attr no-lock
     2706          where buf_action-item-attr.attr-code = "Linking"
     2707            and buf_action-item-attr.action-item-code = br_action-item.action-item-code no-error.
     2708     if available buf_action-item-attr then do :
     2709       if lookup( buf_action-item-attr.attr-value , "gds-grp" ) <> 0
     2710       then do :
     2711         return "   +   " .
     2712       end.
     2713     end.
     2714     else do :
     2715       return "   -   " .
     2716     end.
     2717   end.
     2718   else do :
     2719     return "   -   " .
     2720   end.
     2721   END FUNCTION.
