       92   define new global shared variable g#vssrevis-logger as handle    no-undo .
       93   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       94   define variable v-vssrevis-logger                   as handle    no-undo .
       95   procedure vss-logevent :
       96     define input  parameter p-extra-paramters as character no-undo .
       97     define variable v-vssrevis-parameters as character no-undo .
       98     do
       99     on error undo, return error return-value
      100     :
      101       if  valid-handle(v-vssrevis-logger)
      102       and v-vssrevis-logger :get-signature("logevent") <> ""
      103       then do:
      104         run vss-get-parameters in this-procedure
      105           (output v-vssrevis-parameters
      106           ).
      107         run logevent in v-vssrevis-logger
      108           (input vss-workfile
      109           ,input vss-revision
      110           ,input v-vssrevis-parameters
      111           ,input p-extra-paramters
      112           ).
      113       end.
      114     end.
      115   end procedure.
      116   assign
      117     v-vssrevis-logger = g#vssrevis-logger
      118   .
      119   if  valid-handle(v-vssrevis-logger)
      120   and v-vssrevis-logger :get-signature("logevent") <> ""
      121   then do:
      122     assign
      123       v-vssrevis-logevent = true
      124     .
      125     run vss-logevent in this-procedure (input vss-description) .
      126   end.
