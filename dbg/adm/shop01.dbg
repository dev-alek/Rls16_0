      385         ) no-error .
      386       if error-status :error
      387       then do:
      388         undo, return error return-value .
      389       end.
      390     end.
      391   end procedure.
      392   procedure clntattr-manual-edit :
      393     define input  parameter p-code           as character no-undo .
      394     define output parameter p-section-num    as integer no-undo .
      395     do
      396     on error undo, return error
      397     :
      398           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-manual-edit in g#attr-lib
      399         (input  p-code
      400         ,output p-section-num
      401         ) no-error .
      402       if error-status :error
      403       then do:
      404         undo, return error return-value .
      405       end.
      406     end.
      407   end procedure.
      408   procedure clntattr-batch-edit :
      409     define input  parameter p-code           as character no-undo .
      410     define output parameter p-section-num    as integer no-undo .
      411     do
      412     on error undo, return error
      413     :
      414           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-batch-edit in g#attr-lib
      415         (input  p-code
      416         ,output p-section-num
      417         ) no-error .
      418       if error-status :error
      419       then do:
      420         undo, return error return-value .
      421       end.
      422     end.
      423   end procedure.
      424   define variable v-db-num like ub.db.db-num no-undo .
      425   define variable v-curr-r-b as character no-undo .
      426   define variable par-type as character no-undo .
      427   define variable var-deleted as logical no-undo .
      428   define variable v-envd      as character no-undo.
      429   define variable v-kpp       as character no-undo.
      430   define variable v-pharm     as character no-undo.
      431   define variable v-delete    as logical no-undo.
      432   define variable v-pay-type-list as character no-undo .
      433   define variable v-pay-type-str  as character no-undo .
      434   define buffer buf_sysconf for ub.sysconf.
      435   define buffer buf_clients for ub.clients.
      436   define buffer buf_pay-type for ub.pay-type .
      437   define buffer buf_other_shop for ub.shop.
      438   define buffer buf_cash-desk for ub.cash-desk.
      439   define buffer buf_dis-card-type for ub.dis-card-type.
      440   if p-mode <> 'ДОБАВЛЕНИЕ':U
      441   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
      442     undo, return error
      443       substitute('&5&1 &2 &3&4Неверный параметр p-mode [&6]':u,
      444                  vss-workfile, vss-revision, vss-description, chr(10), chr(4), p-mode).
      445   end.
      446   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      447   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      448     (output v-db-num
      449     )  .
      450   if v-db-num <> 0
      451   then do:
      452     undo, return error
      453       substitute("&2Нельзя изменять запись МАГАЗИНА в УБД: Номер текущей БД &1 ", v-db-num, chr(4)).
      454   end.
      455   run chk-code in this-procedure (p-obj-code, p-mode) no-error .
      456   if error-status:error then
      457     undo, return error substitute("&1&3&2":U, "obj-code":U, return-value, chr(4)) .
      458   if p-obj-name = "":U then
      459     undo, return error substitute("&1&3Введите название магазина &2", "obj-name":U, p-obj-code, chr(4)) .
      460   if not can-find ( ub.db where ub.db.db-num = p-db-num ) then
      461     undo, return error substitute("&1&3Неверный номер БД. Нет БД с номером &2", "db-num":U, p-db-num, chr(4)) .
      462   find first buf_sysconf no-lock where buf_sysconf.host-code = p-host-code no-error .
      463   if not available buf_sysconf then
      464     undo, return error substitute("&3Не найдена фирма с кодом &1 для магазина &2", p-host-code, p-obj-code, chr(4)) .
      465   if buf_sysconf.firm-db-num <> 0
      466   AND p-db-num <> buf_sysconf.firm-db-num
      467   then do:
      468     undo, return error substitute(
      469       "&1&6Главная БД фирмы &2 не совпадает с БД, к которой относится магазин &3: главная БД фирмы - &4, а магазин относится к БД &5",
      470       "db-num":U, p-host-code, p-obj-code, buf_sysconf.firm-db-num, p-db-num, chr(4)
      471     ) .
      472   end.
      473   IF p-sub-store-on = yes then do:
      474     find first buf_clients no-lock
      475       where buf_clients.obj-type = p-sub-store-type
      476         and buf_clients.obj-code = p-sub-store-code  no-error.
      477     if not available buf_clients then
      478       undo, return error substitute("&1&5Не найден объект &2&3, выбранный в качестве склада-подсобки для магазина &4",
      479         "sub-store-code":U, p-sub-store-type, p-sub-store-code, p-obj-code, chr(4)) .
      480     if buf_clients.db-num <> p-db-num then
      481       undo, return error substitute("&1&5Нельзя в качестве склада-подсобки указать объект другой БД: магазин &2 принадлежит БД &3, а склад-подсобка БД &4",
      482         "sub-store-code":U, p-obj-code, buf_clients.db-num, p-db-num, chr(4)) .
      483   end.
      484   IF p-is-kitchen then do:
      485     if p-kitchen-store-type <> 'маг':U then
      486       undo, return error substitute(
      487         "&1&5В качестве СКЛАДА КУХНИ для магазина (кухни) &2 указан объект с типом &3. Допустимо указывать объект только с типом &4",
      488         "kitchen-store-type":U, p-obj-code, p-kitchen-store-type, 'маг':U, chr(4)) .
      489     find first buf_clients no-lock
      490       where buf_clients.obj-type = p-kitchen-store-type
      491         and buf_clients.obj-code = p-kitchen-store-code
      492       no-error.
      493     if not available buf_clients then
      494       undo, return error substitute("&1&5Не найден объект &2&3, выбранный в качестве СКЛАДА для магазина (кухни) &4",
      495         "kitchen-store-code":U, p-kitchen-store-type, p-kitchen-store-code, p-obj-code, chr(4)) .
      496     if buf_clients.db-num <> p-db-num then
      497       undo, return error substitute("&1&5Нельзя в качестве СКЛАДА КУХНИ указать объект другой БД: магазин (кухня) &2 принадлежит БД &3, а СКЛАД - БД &4",
      498         "kitchen-store-code":U, p-obj-code, buf_clients.db-num, p-db-num, chr(4)) .
      499     find first buf_other_shop no-lock
      500          where buf_other_shop.obj-code = buf_clients.obj-code no-error .
      501     if not available buf_other_shop then
      502       undo, return error substitute("&1&4Не найден магазин &2, указанный в качестве СКЛАДА КУХНИ для магазина (кухни) &3",
      503         "kitchen-store-code":U, buf_clients.obj-type, p-obj-code, chr(4)) .
      504     if buf_other_shop.host-code <> p-host-code then
      505       undo, return error substitute("&1&5Нельзя в качестве СКЛАДА КУХНИ указать объект другой ФИРМЫ: магазин(кухня) &2 принадлежит фирме &3, а СКЛАД - фирме &4",
      506         "kitchen-store-code":U, p-obj-code, p-host-code, buf_other_shop.host-code, chr(4)) .
      507   end.
      508   if (p-is-kitchen or p-is-kitchen-store) and not p-is-catering then do:
      509       find first buf_cash-desk no-lock
      510            where buf_cash-desk.obj-code = p-obj-code no-error .
      511       if available buf_cash-desk and
      512                   buf_cash-desk.cash-on then do:
      513         undo, return error substitute(
      514           "&1&6Магазин не можeт иметь признак КУХНЯ и/или СКЛАД КУХНИ и не быть РЕСТОРАНОМ, если у него есть ВКЛЮЧЕННЫЕ КАССЫ: магазин &2, касса: БД&3 тип кассы &4 номер кассы &5",
      515           "kitchen-store-code":U, p-obj-code, buf_cash-desk.db-num, buf_cash-desk.pos-type, buf_cash-desk.cash-num, chr(4)) .
      516       end.
      517   end.
      518   v-pay-type-list = "":U .
      519   if p-chk-pay <> 0 then do:
      520     v-pay-type-str = string(p-chk-pay) .
      521     if not can-find (first buf_pay-type where buf_pay-type.obj-code = p-chk-pay) then
      522       undo, return error substitute("&1&4Неверный код оплаты реализации (продажи) для магазина &2: код оплаты &3",
      523                                     "chk-pay":U, p-obj-code, v-pay-type-str, chr(4)) .
      524     v-pay-type-list = v-pay-type-str .
      525   end.
      526   if p-down-pay <> 0 then do:
      527     v-pay-type-str = string(p-down-pay) .
      528     if not can-do (v-pay-type-list, v-pay-type-str) then do:
      529       if not can-find (first buf_pay-type where buf_pay-type.obj-code = p-down-pay) then
      530       undo, return error substitute("&1&4Неверный код оплаты списания для магазина &2: код оплаты &3",
      531                                     "down-pay":U, p-obj-code, v-pay-type-str, chr(4)) .
      532       v-pay-type-list = substitute("&1,&2", v-pay-type-list, v-pay-type-str) .
      533     end.
      534   end.
      535   if p-in-pay <> 0 then do:
      536     v-pay-type-str = string(p-in-pay) .
      537     if not can-do (v-pay-type-list, v-pay-type-str) then do:
      538       if not can-find (first buf_pay-type where buf_pay-type.obj-code = p-in-pay) then
      539       undo, return error substitute("&1&4Неверный код оплаты прихода для магазина &2: код оплаты &3",
      540                                     "in-pay":U, p-obj-code, v-pay-type-str, chr(4)) .
      541       v-pay-type-list = substitute("&1,&2", v-pay-type-list, v-pay-type-str) .
      542     end.
      543   end.
      544   if p-inv-pay <> 0 then do:
      545     v-pay-type-str = string(p-inv-pay) .
      546     if not can-do (v-pay-type-list, v-pay-type-str) then do:
      547       if not can-find (first buf_pay-type where buf_pay-type.obj-code = p-inv-pay) then
      548       undo, return error substitute("&1&4Неверный код оплаты инвентаризации для магазина &2: код оплаты &3",
      549                                     "inv-pay":U, p-obj-code, p-inv-pay, chr(4)) .
      550       v-pay-type-list = substitute("&1,&2", v-pay-type-list, v-pay-type-str) .
      551     end.
      552   end.
      553   if p-out-pay <> 0 then do:
      554     v-pay-type-str = string(p-out-pay) .
      555     if not can-do (v-pay-type-list, v-pay-type-str) then do:
      556       if not can-find (first buf_pay-type where buf_pay-type.obj-code = p-out-pay) then
      557       undo, return error substitute("&1&4Неверный код оплаты расхода для магазина &2: код оплаты &3",
      558                                      "out-pay":U, p-obj-code, p-out-pay, chr(4)) .
      559       v-pay-type-list = substitute("&1,&2", v-pay-type-list, v-pay-type-str) .
      560     end.
      561   end.
      562   if p-ret-pay <> 0 then do:
      563     v-pay-type-str = string(p-ret-pay) .
      564     if not can-do (v-pay-type-list, v-pay-type-str) then do:
      565       if not can-find (first buf_pay-type where buf_pay-type.obj-code = p-ret-pay) then
      566       undo, return error substitute("&1&4Неверный код оплаты возврата от покупателя для магазина &2: код оплаты &3",
      567                                     "ret-pay":U, p-obj-code, p-ret-pay, chr(4)) .
      568       v-pay-type-list = substitute("&1,&2", v-pay-type-list, v-pay-type-str) .
      569     end.
      570   end.
      571   if p-ret-sup-pay <> 0 then do:
      572     v-pay-type-str = string(p-ret-sup-pay) .
      573     if not can-do (v-pay-type-list, v-pay-type-str) then do:
      574       if not can-find (first buf_pay-type where buf_pay-type.obj-code = p-ret-sup-pay) then
      575       undo, return error substitute("&1&4Неверный код оплаты возврата поставщику для магазина &2: код оплаты &3",
      576                                     "ret-sup-pay":U, p-obj-code, p-ret-sup-pay, chr(4)) .
      577       v-pay-type-list = substitute("&1,&2", v-pay-type-list, v-pay-type-str) .
      578     end.
      579   end.
      580   if p-fbr-pay <> 0 then do:
      581     v-pay-type-str = string(p-fbr-pay) .
      582     if not can-do (v-pay-type-list, v-pay-type-str) then do:
      583       if not can-find (first buf_pay-type where buf_pay-type.obj-code = p-fbr-pay) then
      584       undo, return error substitute("&1&4Неверный код оплаты производства для магазина &2: код оплаты &3",
      585                                     "fbr-pay":U, p-obj-code, p-fbr-pay, chr(4)) .
      586     end.
      587   end.
      588   _MAIN:
      589   DO ON ERROR UNDO, RETURN ERROR
      590   ON STOP UNDO, RETURN ERROR:
      591     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      592       create ub.shop.
      593       create ub.clients.
      594       assign
      595       ub.clients.obj-code = p-obj-code
      596       ub.clients.obj-type = 'маг':U
      597       ub.clients.db-num   = p-db-num
      598       ub.clients.grp-code = p-grp-code
      599       ub.clients.host-code = p-host-code
      600       ub.shop.obj-code = p-obj-code
      601       ub.shop.host-code   = p-host-code
      602       p-rec = recid(ub.clients).
      603     end.
      604     else do:
      605       FIND FIRST ub.clients where
      606                 recid(ub.clients) = p-rec No-ERROR.
      607       if not available ub.clients then
      608         undo, return error substitute('&5&1 &2 &3&4Не найдена запись КЛИЕНТ для записи МАГАЗИН - p-rec [&6]':u,
      609                                        vss-workfile, vss-revision, vss-description, chr(10), chr(4), p-rec).
      610       find first ub.shop where
      611                 ub.shop.obj-code = p-obj-code no-error .
      612       if not available ub.shop then
      613         undo, return error substitute('&5&1 &2 &3&4Не найдена запись МАГАЗИН с кодом [&6]':u,
      614                                        vss-workfile, vss-revision, vss-description, chr(10), chr(4), p-obj-code).
      615       if ub.shop.obj-code <> p-obj-code
      616       or ub.shop.host-code <> p-host-code
      617       or ub.clients.db-num    <> p-db-num
      618       then
      619         undo, return error substitute('&5&1 &2 &3&4Для уже имеющегося МАГАЗИНА нельзя изменить номер магазина, номер БД и код фирмы':u,
      620                                        vss-workfile, vss-revision, vss-description, chr(10), chr(4)).
      621     end.
      622     assign
      623     ub.clients.obj-name         =  p-obj-name
      624     ub.clients.PS               =  p-PS
      625     ub.shop.acct                =  p-acct
      626     ub.shop.addres1             =  p-addres1
      627     ub.shop.addres2             =  p-addres2
      628     ub.shop.all-prt             =  p-all-prt
      629     ub.shop.buy-goods           =  p-buy-goods
      630     ub.shop.cd-bc-alt           =  p-cd-bc-alt
      631     ub.shop.cd-bc-base          =  p-cd-bc-base
      632     ub.shop.cd-loc-alt          =  p-cd-loc-alt
      633     ub.shop.cd-loc-base         =  p-cd-loc-base
      634     ub.shop.cd-parts-all        =  p-cd-parts-all
      635     ub.shop.cd-parts-not-blank  =  p-cd-parts-not-blank
      636     ub.shop.cd-parts-ser        =  p-cd-parts-ser
      637     ub.shop.cd-pb-alt           =  p-cd-pb-alt
      638     ub.shop.cd-pb-base          =  p-cd-pb-base
      639     ub.shop.cd-sc-base          =  p-cd-sc-base
      640     ub.shop.chk-pay             =  p-chk-pay
      641     ub.shop.day-only            =  p-day-only
      642     ub.shop.director            =  p-director
      643     ub.shop.discaloc            =  p-discaloc
      644     ub.shop.doc-prt             =  p-doc-prt
      645     ub.shop.down-pay            =  p-down-pay
      646     ub.shop.fax                 =  p-fax
      647     ub.shop.goods-man           =  p-goods-man
      648     ub.shop.in-ov               =  p-in-ov
      649     ub.shop.in-pay              =  p-in-pay
      650     ub.shop.in-perm             =  p-in-perm
      651     ub.shop.inout-price         =  p-inout-price
      652     ub.shop.inv-pay             =  p-inv-pay
      653     ub.shop.is-catering         =  p-is-catering
      654     ub.shop.is-kitchen          =  p-is-kitchen
      655     ub.shop.is-kitchen-store    =  p-is-kitchen-store
      656     ub.shop.kitchen-store-code  =  if p-is-kitchen
      657                                     then p-kitchen-store-code
      658                                     else 0
      659     ub.shop.kitchen-store-type  =  if p-is-kitchen
      660                                     then p-kitchen-store-type
      661                                     else "":U
      662     ub.shop.no-eq               =  p-no-eq
      663     ub.shop.out-line-discnt     =  p-out-line-discnt
      664     ub.shop.out-pay             =  p-out-pay
      665     ub.shop.out-rate            =  p-out-rate
      666     ub.shop.phone               =  p-phone
      667     ub.shop.pr-cash             =  p-pr-cash
      668     ub.shop.price-calc          =  p-price-calc
      669     ub.shop.ret-pay             =  p-ret-pay
      670     ub.shop.ret-sup-pay         =  p-ret-sup-pay
      671     ub.shop.fbr-pay             =  p-fbr-pay
      672     ub.shop.rsrv-time           =  p-rsrv-time
      673     ub.shop.shift-on            =  p-shift-on
      674     ub.shop.store-boss          =  p-store-boss
      675     ub.shop.store-man           =  p-store-man
      676     ub.shop.sub-store-on        =  p-sub-store-on
      677     ub.shop.sub-store-code      =  if p-sub-store-on
      678                                     then p-sub-store-code
      679                                     else 0
      680     ub.shop.sub-store-type      =  if p-sub-store-on
      681                                     then p-sub-store-type
      682                                     else "":U
      683     ub.shop.unit-cli-perm       =  p-unit-cli-perm
      684     ub.shop.with-serv           =  p-with-serv
      685     ub.shop.work-hours          =  p-work-hours
      686     ub.shop.purch-code          =  p-purch-code
      687     p-rec = recid(ub.clients )
      688     .
      689    release ub.clients no-error.
      690    if error-status:error then do:
      691       undo, return error substitute(
      692         "&5Ошибка при сохранении записи КЛИЕНТ для МАГАЗИНА &1:&2&3&2&4"
      693       , p-obj-code
      694       , chr(10)
      695       , ERROR-STATUS:GET-message(1)
      696       , return-value
      697       , chr(4)
      698       ) .
      699    end.
      700    p-obj-code = ub.shop.obj-code.
      701    release ub.shop no-error.
      702    if error-status:error then do:
      703       undo, return error substitute(
      704         "&5Ошибка при сохранении записи МАГАЗИН &1:&2&3&2&4"
      705       , p-obj-code
      706       , chr(10)
      707       , ERROR-STATUS:GET-message(1)
      708       , return-value
      709       , chr(4)
      710       ) .
      711    end.
      712    run clntattr-value in this-procedure
      713         (input 'маг':U,
      714         input  p-obj-code,
      715         input  'pharm':U,
      716         output v-pharm,
      717         output par-type).
      718     if v-pharm = "yes":u then do:
      719       if p-pharm = no then do:
      720         run clntattr-delete in this-procedure
      721          (input 'маг':U,
      722           input  p-obj-code,
      723           input  'pharm':U,
      724           output v-delete).
      725       end.
      726     end.
      727     else do:
      728       if p-pharm = yes then do:
      729         run clntattr-write in this-procedure
      730          (input  'маг':U,
      731           input  p-obj-code,
      732           input  'pharm':U,
      733           input  "yes":u).
      734       end.
      735     end.
      736    run clntattr-value in this-procedure
      737         (input 'маг':U,
      738         input  p-obj-code,
      739         input  'kpp':U,
      740         output v-kpp,
      741         output par-type).
      742     if v-kpp <> "":u and v-kpp <> ? then do:
      743       if p-kpp = "" or p-kpp = ? then do:
      744         run clntattr-delete in this-procedure
      745          (input 'маг':U,
      746           input  p-obj-code,
      747           input  'kpp':U,
      748           output v-delete).
      749       end.
      750       else do:
      751         if p-kpp <> "" and p-kpp <> ? then do:
      752          run clntattr-write in this-procedure
      753          (input  'маг':U,
      754           input  p-obj-code,
      755           input  'kpp':U,
      756           input  p-kpp).
      757       end.
      758       end.
      759     end.
      760       else do:
      761       if p-kpp <> "" and p-kpp <> ? then do:
      762         run clntattr-write in this-procedure
      763          (input  'маг':U,
      764           input  p-obj-code,
      765           input  'kpp':U,
      766           input  p-kpp).
      767       end.
      768     end.
      769    run clntattr-value in this-procedure
      770         (input 'маг':U,
      771         input  p-obj-code,
      772         input  'envd':U,
      773         output v-envd,
      774         output par-type).
      775     if v-envd = "yes":u then do:
      776       if p-envd = no then do:
      777         run clntattr-delete in this-procedure
      778          (input 'маг':U,
      779           input  p-obj-code,
      780           input  'envd':U,
      781           output v-delete).
      782       end.
      783     end.
      784     else do:
      785       if p-envd = yes then do:
      786         run clntattr-write in this-procedure
      787          (input  'маг':U,
      788           input  p-obj-code,
      789           input  'envd':U,
      790           input  "yes":u).
      791       end.
      792     end.
      793    if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      794       run trg/curr-shc.p (p-obj-code) no-error .
      795       if error-status:error then
      796         undo, return error substitute("&3Ошибка при создании записи курса базовой валюты при создании МАГАЗИНА &1: &2",
      797                                       p-obj-code, ERROR-STATUS:GET-message(1), chr(4)) .
      798    end.
      799   end.
      800   PROCEDURE chk-code :
      801   define input parameter p-obj-code like ub.shop.obj-code no-undo .
      802   define input parameter p-mode     as character no-undo .
      803   define variable hnum as logical no-undo init no.
      804   define variable  par-type as character no-undo.
      805   define variable  dopi as integer no-undo.
      806   define variable v-value-character as character no-undo .
      807   define variable v-value-date as date no-undo .
      808   define variable v-value-decimal as decimal no-undo .
      809   define variable v-value-integer as INTEGER no-undo .
      810   define variable v-value-logical AS LOGICAL no-undo .
      811   define variable v-tth as handle no-undo .
      812   if p-obj-code = 0 then
      813     return error "Код магазина должен быть больше 0 ".
      814   if  p-mode = 'ДОБАВЛЕНИЕ':U
      815   and can-find( ub.shop where ub.shop.obj-code = p-obj-code ) then
      816     return error substitute("Магазин с кодом &1 уже есть, измените код", p-obj-code ).
      817   if p-obj-code > 999 and  p-mode = 'ДОБАВЛЕНИЕ':U  then do:
      818     run adm/shattri.p (
      819         input "get":U
      820         ,input  'орг':U
      821         ,input  p-host-code
      822         ,input  'get-chk':U
      823         ,input  'hnum':U
      824         ,output v-value-character
      825         ,output v-value-date
      826         ,output v-value-decimal
      827         ,output v-value-integer
      828         ,output v-value-logical
      829         ,output par-type
      830         ,INPUT-OUTPUT TABLE-handle v-tth
      831         ) no-error .
      832     if valid-handle(v-tth) then do:
      833       delete object v-tth.
      834     end.
      835     IF not error-status:error then do:
      836       assign
      837       hnum = v-value-logical.
      838     end.
      839     if hnum then do:
      840       return error substitute(
      841         "Вы не можете присвоить магазину номер > 999 (&1)&3" +
      842         "пока настроечный параметр <НОМЕР МАГАЗИНА ПРИ ЧТЕНИИ ДАННЫХ С КАССЫ БРАТЬ ИЗ СПУЛА>&3" +
      843         "для фирмы &2 равен ДА; измените код"
      844       , p-obj-code
      845       , p-host-code
      846       , chr(10)
      847       ) .
      848     end.
      849   end.
      850   return.
      851   END PROCEDURE.
