       73   procedure vss-get-info :
       74     define output parameter p-vss-revision    like vss-revision    no-undo .
       75     define output parameter p-vss-author      like vss-author      no-undo .
       76     define output parameter p-vss-date        like vss-date        no-undo .
       77     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       78     define output parameter p-vss-archive     like vss-archive     no-undo .
       79     define output parameter p-vss-description like vss-description no-undo .
       80     assign
       81       p-vss-revision    = vss-revision
       82       p-vss-author      = vss-author
       83       p-vss-date        = vss-date
       84       p-vss-workfile    = vss-workfile
       85       p-vss-archive     = vss-archive
       86       p-vss-description = vss-description
       87     .
       88   end procedure.
