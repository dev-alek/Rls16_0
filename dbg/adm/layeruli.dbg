     1242   procedure diasize_set-height :
     1243     define input  parameter p-new-height  as decimal   no-undo .
     1244     define input  parameter p-move-resize as logical   no-undo .
     1245     do
     1246     on error undo, return error return-value
     1247     :
     1248       run diasize_change-height in this-procedure
     1249         (input  (p-new-height - frame Dialog-Frame :height)
     1250         ,input  p-move-resize
     1251         ) .
     1252     end.
     1253   end procedure.
     1254   procedure diasize_change-width :
     1255     define input  parameter p-change-value as decimal   no-undo .
     1256     define input  parameter p-move-resize  as logical   no-undo .
     1257     define variable v-field-group-handle   as handle    no-undo .
     1258     define variable v-object-handle        as handle    no-undo .
