      753   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      754   procedure minbtn-set :
      755       do
      756           on error undo, return error return-value
      757           :
      758           define variable ii              as integer       no-undo .
      759           define variable fh              as widget-handle no-undo .
      760           define variable hh              as widget-handle no-undo .
      761           define variable v-h             as handle        extent 4 no-undo .
      762           define variable v-name-button   as character     no-undo .
      763           define variable v-help-old-x    as decimal       no-undo .
      764           define variable v-help-old-y    as decimal       no-undo .
      765           define variable v-help-old-size as decimal       no-undo .
      766           define variable v-frame-width   as decimal       no-undo .
      767           define variable jj              as integer       no-undo .
      768           do
      769               on error undo, return error
      770               :
      771               assign
      772                   v-frame-width = frame Dialog-Frame:width - 0.3
      773                   fh            = frame Dialog-Frame:first-child
      774                   hh            = fh:first-child
      775                   ii            = 1
      776                   .
      777               do while valid-handle(hh):
      778                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      779                   do:
      780                       case lc(hh:name) :
      781                           when "b-help" then
      782                               do:
      783                                   hh:load-image-up("cmp/b-help.bmp":u) .
      784                                   hh:load-image-down("cmp/b-help.bmp":u) .
      785                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      786                                   hh:TOOLTIP = "Помощь" .
      787                                   v-help-old-x = hh:column .
      788                                   v-help-old-y = hh:row    .
      789                                   v-help-old-size = hh:width .
      790                                   hh:width-chars = 2.5 .
      791                               end.
      792                           when "b-print" then
      793                               do:
      794                                   hh:load-image("cmp/b-print.bmp":u) .
      795                                   hh:TOOLTIP = "Печать" .
      796                                   v-h[ii] = hh:handle .
      797                                   ii = ii + 1 .
      798                                   hh:width-chars = 3 .
      799                               end.
      800                           when "b-history" or
      801                           when "b-hist" then
      802                               do:
      803                                   hh:load-image("cmp/b-hist.bmp":u) .
      804                                   hh:TOOLTIP = "История" .
      805                                   v-h[ii] = hh:handle .
      806                                   ii = ii + 1 .
      807                                   hh:width-chars = 3 .
      808                               end.
      809                           when "b-sch" then
      810                               do:
      811                                   hh:load-image("cmp/b-sch.bmp":u) .
      812                                   hh:TOOLTIP = "Установка Фильтра" .
      813                                   v-h[ii] = hh:handle .
      814                                   ii = ii + 1 .
      815                                   hh:width-chars = 3 .
      816                               end.
      817                           when "b-hist-user" then
      818                               do:
      819                                   hh:load-image("cmp/b-hist.bmp":u) .
      820                                   hh:TOOLTIP = "История пользователя" .
      821                                   ii = ii + 1 .
      822                               end.
      823                       end case.
      824                   end.
      825                   hh = hh:next-sibling.
      826               end.
      827               b-help:column = v-frame-width - b-help:width-chars.
      828               jj = 0.
      829               repeat ii = 4 to 1 by -1 :
      830                   if valid-handle (v-h[ii] ) then
      831                   do:
      832                       jj  = jj + 1 .
      833                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      834                       v-h[ii]:row    = v-help-old-y .
      835                   end.
      836               end.
      837           end.
      838       end.
      839   end procedure.
      840   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      841   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      842   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      843   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      844   define variable v-diasize-current-frame-width  as decimal   no-undo .
      845   define variable v-diasize-current-frame-height as decimal   no-undo .
      846   define variable v-diasize-change-size          as logical   no-undo .
      847   define variable v-diasize-resize-button        as handle    no-undo .
      848   define variable v-diasize-wndmax               as logical   no-undo .
      849   define variable v-diasize-wndstore             as logical   no-undo .
      850   define variable v-diasize-proc-name            as character no-undo .
      851   define variable v-diasize-browse-handle        as handle    no-undo .
      852   define variable v-diasize-browse-number        as integer   no-undo .
      853   define variable v-diasize-need-full-display    as logical   no-undo init false .
      854   define temp-table temp-diasize-handle no-undo
      855     field handle-value  as handle
      856     field save-position as decimal
      857     index xpk is primary unique handle-value
      858     .
      859   define temp-table temp-browse-handle no-undo
      860     field browse-type   as character
      861     field browse-number as integer
      862     field browse-handle as handle
      863     field original-size as decimal
      864     index xpk is primary unique browse-type browse-number
      865     index xie browse-type browse-handle
      866   .
      867   procedure diasize_change-height :
      868     define input  parameter p-change-value  as decimal   no-undo .
      869     define input  parameter p-move-resize   as logical   no-undo .
      870     define variable v-field-group-handle    as handle    no-undo .
      871     define variable v-object-handle         as handle    no-undo .
      872     define variable v-frame-height          as decimal   no-undo .
      873     define variable v-frame-virtual-height  as decimal   no-undo .
      874     define variable v-browse-height         as decimal   no-undo .
      875     define variable v-window-height         as decimal   no-undo .
      876     define variable v-window-virtual-height as decimal   no-undo .
      877     define variable v-change-sign           as integer   no-undo .
      878     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      879     define buffer buf_temp-browse-handle  for temp-browse-handle .
      880     if p-change-value > 0
      881     then do:
      882       if frame Dialog-Frame :height + p-change-value
      883           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      884       then do:
      885         assign
      886           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      887                           - (frame Dialog-Frame :height-chars)
      888         .
      889         if p-change-value <= 0
      890         then do:
      891           run diasize_position-resize-button in this-procedure .
      892           return .
      893         end.
      894       end.
      895     end.
      896     if p-change-value < 0
      897     then do:
      898       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      899       then do:
      900         assign
      901           p-change-value = v-diasize-orig-frame-height
      902                          - (frame Dialog-Frame :height-chars)
      903         .
      904         if p-change-value >= 0
      905         then do:
      906           run diasize_position-resize-button in this-procedure .
      907           return .
      908         end.
      909       end.
      910     end.
      911     if p-change-value >= 0
      912     then do:
      913       assign
      914         v-change-sign = 1
      915       .
      916     end.
      917     else do:
      918       assign
      919         v-change-sign = -1
      920       .
      921     end.
      922     assign
      923       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      924     .
      925     if p-change-value = 0
      926     then do:
      927       run diasize_position-resize-button in this-procedure .
      928       return .
      929     end.
      930     move_block:
      931     do
      932     on error undo move_block, retry move_block
      933     :
      934       if retry
      935       then do:
      936         do
      937         on error undo move_block, leave move_block
      938         :
      939           if p-change-value > 0
      940           then do:
      941             for each buf_temp-diasize-handle
      942             on error undo, next
      943             :
      944               assign
      945                 v-object-handle = buf_temp-diasize-handle.handle-value
      946               .
      947               if v-object-handle <> v-diasize-resize-button
      948               then do:
      949                 assign
      950                   v-object-handle :row = buf_temp-diasize-handle.save-position
      951                 .
      952               end.
