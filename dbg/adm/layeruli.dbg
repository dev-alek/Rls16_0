      969             then do:
      970               assign
      971                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      972               .
      973             end.
      974             run diasize_position-resize-button in this-procedure .
      975           end.
      976           else do:
      977             if frame Dialog-Frame :scrollable = true
      978             then do:
      979               assign
      980                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      981               .
      982             end.
      983             assign
