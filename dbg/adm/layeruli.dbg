     1262     define variable v-window-width         as decimal   no-undo .
     1263     define variable v-window-virtual-width as decimal   no-undo .
     1264     define variable v-change-sign          as integer   no-undo .
     1265     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1266     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1267     if p-change-value > 0
     1268     then do:
     1269       if frame Dialog-Frame :width + p-change-value >
     1270           session :width-chars
     1271       then do:
     1272         assign
     1273           p-change-value = session :width-chars - frame Dialog-Frame :width
     1274         .
     1275         if p-change-value <= 0
     1276         then do:
     1277           run diasize_position-resize-button in this-procedure .
     1278           return .
     1279         end.
     1280       end.
     1281     end.
     1282     if p-change-value < 0
     1283     then do:
     1284       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1285       then do:
     1286         assign
     1287           p-change-value = v-diasize-orig-frame-width
     1288                          - frame Dialog-Frame :width
     1289         .
     1290         if p-change-value >= 0
     1291         then do:
     1292           run diasize_position-resize-button in this-procedure .
     1293           return .
     1294         end.
     1295       end.
     1296     end.
     1297     if p-change-value >= 0
     1298     then do:
     1299       assign
     1300         v-change-sign = 1
     1301       .
     1302     end.
     1303     else do:
     1304       assign
     1305         v-change-sign = -1
     1306       .
     1307     end.
     1308     assign
     1309       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1310     .
     1311     if p-change-value = 0
     1312     then do:
     1313       run diasize_position-resize-button in this-procedure .
     1314       return .
     1315     end.
     1316     move_block:
