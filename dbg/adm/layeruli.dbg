     1567             no-error .
     1568           if error-status :error
     1569           or error-status :get-message(1) <> ""
     1570           then do:
     1571             undo move_block, retry move_block .
     1572           end.
     1573         end.
     1574         assign
     1575           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1576           no-error .
     1577         if error-status :error
     1578         or error-status :get-message(1) <> ""
     1579         then do:
     1580           undo move_block, retry move_block.
     1581         end.
     1582         assign
     1583           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1584         no-error .
     1585         if error-status :error
     1586         or error-status :get-message(1) <> ""
     1587         then do:
     1588           undo move_block, retry move_block.
     1589         end.
     1590         if frame Dialog-Frame :scrollable = true
     1591         then do:
     1592           assign
     1593             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1594           no-error .
     1595           if error-status :error
     1596           or error-status :get-message(1) <> ""
     1597           then do:
     1598             undo move_block, retry move_block.
     1599           end.
     1600         end.
     1601       end.
     1602       if p-move-resize
     1603       then do:
     1604         run diasize_position-resize-button in this-procedure .
     1605       end.
     1606       if v-diasize-wndstore = true
     1607       then do:
     1608         if connected("ub") = true
     1609         then do:
     1610           define variable v-cntxt-db-num        as integer   no-undo .
     1611           define variable v-cntxt-userid        as character no-undo .
     1612           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1613                                             , OUTPUT v-cntxt-userid
     1614                                             ) .
     1615           run gbl/wndsizew.p
     1616             (input  v-cntxt-db-num
     1617             ,input  v-cntxt-userid
     1618             ,input  v-diasize-proc-name
     1619             ,input  'width':u
     1620             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1621             ) .
     1622         end.
     1623       end.
     1624     end.
     1625     assign
     1626       v-diasize-change-size = false
     1627     .
     1628   end procedure.
     1629   procedure diasize_set-width :
     1630     define input  parameter p-new-width  as decimal   no-undo .
     1631     define input  parameter p-move-resize as logical   no-undo .
     1632     do
     1633     on error undo, return error return-value
     1634     :
     1635       run diasize_change-width in this-procedure
     1636         (input  (p-new-width - frame Dialog-Frame :width)
     1637         ,input  p-move-resize
     1638         ) .
     1639     end.
     1640   end procedure.
     1641   procedure diasize_position-resize-button :
     1642     do with frame Dialog-Frame
     1643     :
     1644       hide v-diasize-resize-button .
     1645       assign
     1646         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1647                     - 1
     1648                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1649         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1650                     - 1
     1651                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1652       .
     1653       view v-diasize-resize-button .
     1654     end.
     1655   end procedure.
     1656   on alt-right anywhere
     1657   do:
     1658     run diasize_change-width in this-procedure
     1659       (input 1
     1660       ,input true
     1661       ) .
     1662     return no-apply .
     1663   end.
     1664   on alt-left anywhere
     1665   do:
     1666     run diasize_change-width in this-procedure
     1667       (input -1
     1668       ,input true
     1669       ) .
     1670     return no-apply .
     1671   end.
     1672   on alt-down anywhere
     1673   do:
     1674     run diasize_change-height in this-procedure
     1675       (input 1
     1676       ,input true
     1677       ) .
     1678     return no-apply .
     1679   end.
     1680   on alt-up anywhere
     1681   do:
     1682     run diasize_change-height in this-procedure
     1683       (input -1
     1684       ,input true
     1685       ) .
     1686     return no-apply .
     1687   end.
     1688   on alt-enter of frame Dialog-Frame
     1689   do:
     1690     run diasize_maximize in this-procedure
     1691       (input  ?
     1692       ).
     1693     return no-apply .
     1694   end.
     1695   procedure diasize_end-move :
     1696     do
     1697     on error undo, return error return-value
     1698     :
     1699       define variable v-row-delta as decimal   no-undo .
     1700       define variable v-col-delta as decimal   no-undo .
     1701       define variable v-new-row as decimal   no-undo .
     1702       define variable v-new-col as decimal   no-undo .
     1703       assign
     1704         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1705         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1706       .
     1707       assign
     1708         v-row-delta = v-new-row - frame Dialog-Frame :height
     1709         v-col-delta = v-new-col - frame Dialog-Frame :width
     1710       .
     1711       run diasize_change-height in this-procedure
     1712         (input v-row-delta
     1713         ,input true
     1714         ) .
     1715       run diasize_change-width in this-procedure
     1716         (input v-col-delta
     1717         ,input true
     1718         ) .
     1719     end.
     1720   end procedure.
     1721   procedure diasize_maximize :
     1722     define input  parameter p-action as logical   no-undo .
     1723     do
     1724     on error undo, return error return-value
     1725     :
     1726       if p-action = ?
     1727       then do:
     1728         if v-diasize-need-maximize = true
     1729         then do:
     1730           assign
     1731             p-action = true
     1732           .
     1733         end.
     1734         else do:
     1735           assign
     1736             p-action = false
     1737           .
     1738         end.
     1739       end.
     1740       if p-action = true
     1741       then do:
     1742         run diasize_change-height in this-procedure
     1743           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1744               - frame Dialog-Frame :height-chars
     1745           ,input true
     1746           ) .
     1747         run diasize_change-width in this-procedure
     1748           (input session :width-chars
     1749               - frame Dialog-Frame :width-chars
     1750           ,input true
     1751           ) .
     1752         assign
     1753           v-diasize-need-maximize = false
     1754         .
     1755       end.
     1756       else do:
     1757         run diasize_change-width in this-procedure
     1758           (input v-diasize-orig-frame-width
     1759               - frame Dialog-Frame :width-chars
     1760           ,input true
     1761           ) .
     1762         run diasize_change-height in this-procedure
     1763           (input v-diasize-orig-frame-height
     1764               - frame Dialog-Frame :height-chars
     1765           ,input true
     1766           ) .
     1767         assign
     1768           v-diasize-need-maximize = true
     1769         .
     1770       end.
     1771     end.
     1772   end procedure.
     1773   procedure diasize_restore-orig-size :
     1774     do
     1775     on error undo, return error return-value
     1776     :
     1777       assign
     1778         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1779         v-diasize-current-frame-height = frame Dialog-Frame :height
     1780       .
     1781       run diasize_set-height in this-procedure
     1782         (input  v-diasize-orig-frame-height
     1783         ,input  true
     1784         ) .
     1785       run diasize_set-width in this-procedure
     1786         (input  v-diasize-orig-frame-width
     1787         ,input  true
     1788         ) .
     1789     end.
     1790   end procedure.
     1791   procedure diasize_restore-current-size :
     1792     do
     1793     on error undo, return error return-value
     1794     :
     1795       run diasize_set-height in this-procedure
     1796         (input  v-diasize-current-frame-height
     1797         ,input  true
     1798         ) .
     1799       run diasize_set-width in this-procedure
     1800         (input  v-diasize-current-frame-width
     1801         ,input  true
     1802         ) .
     1803     end.
     1804   end procedure.
     1805   procedure diasize_set-browse-handle :
     1806     define input  parameter p-browse-handle as handle   no-undo .
     1807     define buffer buf_temp-browse-handle for temp-browse-handle .
     1808     do
     1809     on error undo, return error return-value
     1810     :
     1811       assign
     1812         v-diasize-browse-handle = p-browse-handle
     1813       .
     1814       for each buf_temp-browse-handle
     1815       on error undo, return error return-value
     1816       :
     1817         delete buf_temp-browse-handle .
     1818       end.
     1819     end.
     1820   end procedure.
     1821   procedure diasize_add_browse :
     1822     define input  parameter p-browse-type   as character no-undo .
     1823     define input  parameter p-browse-handle as handle    no-undo .
     1824     define buffer buf_temp-browse-handle for temp-browse-handle .
     1825     do
     1826     on error undo, return error return-value
     1827     :
     1828       assign
     1829         v-diasize-browse-number = v-diasize-browse-number + 1
     1830       .
     1831       create buf_temp-browse-handle .
     1832       assign
     1833         buf_temp-browse-handle.browse-type   = p-browse-type
     1834         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1835         buf_temp-browse-handle.browse-handle = p-browse-handle
     1836       .
     1837     end.
     1838   end procedure.
     1839   procedure diasize_init :
     1840     define variable v-default-value    as logical   no-undo .
     1841     define variable v-restore-saved    as logical   no-undo .
     1842     define variable v-resize-value-str as character no-undo .
     1843     do
     1844     on error undo, return error return-value
     1845     :
     1846       do with frame Dialog-Frame
     1847       :
     1848         assign
     1849           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1850           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1851           v-diasize-browse-handle     = browse BR-rule-call-param :handle
     1852         .
     1853         create button v-diasize-resize-button
     1854         assign
     1855           parent        = frame Dialog-Frame :first-child
     1856           label         = "s"
     1857           height-pixels = 16
     1858           width-pixels  = 16
     1859           visible       = true
     1860           sensitive     = true
     1861           movable       = true
     1862           triggers:
     1863             on end-move persistent run diasize_end-move in this-procedure .
     1864           end triggers.
     1865         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1866         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1867         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1868         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1869         assign
     1870           v-diasize-wndmax = false
     1871         .
     1872         if connected("ub") = true
     1873         then do:
     1874           define variable v-cntxt-db-num        as integer   no-undo .
     1875           define variable v-cntxt-userid        as character no-undo .
     1876           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1877                                             , OUTPUT v-cntxt-userid
     1878                                             ) .
     1879           run gbl/wndpar_r.p
     1880             (input  v-cntxt-db-num
     1881             ,input  v-cntxt-userid
     1882             ,input  'wndmax':U
     1883             ,output v-diasize-wndmax
     1884             ,output v-default-value
     1885             ) .
     1886         end.
     1887         assign
     1888           v-diasize-wndstore = false
     1889         .
     1890         if connected("ub") = true
     1891         then do:
     1892           run gbl/wndpar_r.p
     1893             (input  v-cntxt-db-num
     1894             ,input  v-cntxt-userid
     1895             ,input  'wndstore':U
     1896             ,output v-diasize-wndstore
     1897             ,output v-default-value
     1898             ) .
     1899         end.
     1900         assign
     1901           v-diasize-proc-name = entry(1, program-name(2), '.')
     1902         .
     1903         if v-diasize-wndstore = true
     1904         then do:
     1905           assign
     1906             v-restore-saved = false
     1907           .
     1908           if connected("ub") = true
     1909           then do:
     1910             run gbl/wndsizer.p
     1911               (input  v-cntxt-db-num
     1912               ,input  v-cntxt-userid
     1913               ,input  v-diasize-proc-name
     1914               ,input  'height':u
     1915               ,output v-resize-value-str
     1916               ) .
     1917             if v-resize-value-str <> '':U
     1918             then do:
     1919               run diasize_change-height in this-procedure
     1920                 (input  integer(v-resize-value-str)
     1921                 ,input  true
     1922                 ) .
     1923               assign
     1924                 v-restore-saved = true
     1925               .
     1926             end.
     1927           end.
     1928           if connected("ub") = true
     1929           then do:
     1930             run gbl/wndsizer.p
     1931               (input  v-cntxt-db-num
     1932               ,input  v-cntxt-userid
     1933               ,input  v-diasize-proc-name
     1934               ,input  'width':u
     1935               ,output v-resize-value-str
     1936               ) .
     1937             if v-resize-value-str <> '':U
     1938             then do:
     1939               run diasize_change-width in this-procedure
     1940                 (input  integer(v-resize-value-str)
     1941                 ,input  true
     1942                 ) .
     1943               assign
     1944                 v-restore-saved = true
     1945               .
     1946             end.
     1947           end.
     1948           if v-restore-saved <> true
     1949           then do:
     1950             if v-diasize-wndmax = true
     1951             then do:
     1952               run diasize_maximize in this-procedure
     1953                 (input  true
     1954                 ) .
     1955             end.
     1956           end.
     1957         end.
     1958         else do:
     1959           if v-diasize-wndmax = true
     1960           then do:
     1961             run diasize_maximize in this-procedure
     1962               (input  true
     1963               ) .
     1964           end.
     1965         end.
     1966       end.
     1967     end.
     1968   end procedure.
     1969   procedure diasize_need-full-display :
     1970     define output parameter p-need-full-display as logical   no-undo .
     1971     do
     1972     on error undo, return error return-value
     1973     :
     1974       assign
     1975         p-need-full-display = v-diasize-need-full-display
     1976       .
     1977       assign
     1978         v-diasize-need-full-display = false
     1979       .
     1980     end.
     1981   end procedure.
     1982   procedure get-context :
     1983      define output parameter p-db-num as integer          no-undo.
     1984      define output parameter p-user-id as character        no-undo.
     1985      define variable v-login               as character    no-undo.
     1986      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1987      define buffer buf_user-login  for ub.user-login .
     1988      do
     1989      on error undo, return error
     1990      :
     1991            FIND FIRST buf_sys-ctrl no-lock.
     1992            ASSIGN
     1993               v-login = USERID("ub")
     1994               p-db-num = buf_sys-ctrl.db-num
     1995            .
     1996            FIND FIRST buf_user-login
     1997                 WHERE buf_user-login.db-num = p-db-num
     1998                   AND buf_user-login.user-login = v-login
     1999                 no-lock
     2000                 no-error
     2001                 .
     2002            IF AVAILABLE buf_user-login
     2003            THEN DO:
     2004               assign
     2005                  p-user-id = buf_user-login.user-id
     2006               .
     2007            END.
     2008      end.
     2009   end procedure.
     2010       run diasize_init in this-procedure .
     2011   MAIN-BLOCK:
     2012   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2013      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2014      ON stop UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2015     if lookup('admin', p-mode) > 0 then do:
     2016       v-admin = yes.
     2017       p-mode = trim(replace(p-mode, 'admin', ''), chr(44)).
     2018     end.
     2019     if lookup( p-mode, 'ДОБАВЛЕНИЕ':U + chr(44) + 'ИЗМЕНЕНИЕ':U) = 0 then do:
     2020        message
     2021        substitute("Неверное значение параметра p-mode=&1", p-mode)
     2022        vss-workfile vss-revision vss-description skip
     2023        view-as alert-box error .
     2024        undo, return error .
     2025     end.
     2026     for each buf_tt-rule-call-param:
     2027       delete buf_tt-rule-call-param.
     2028     end.
     2029     for each buf_tt0-rule-call-param:
     2030       create buf_tt-rule-call-param.
     2031       buffer-copy buf_tt0-rule-call-param to buf_tt-rule-call-param.
     2032     end.
     2033      RUN Myenable in this-procedure .
     2034     WAIT-FOR GO OF FRAME Dialog-Frame.
     2035   END.
     2036   RUN disable_UI.
     2037   PROCEDURE disable_UI :
     2038     HIDE FRAME Dialog-Frame.
     2039   END PROCEDURE.
     2040   PROCEDURE enable_UI :
     2041     DISPLAY f-rule-name E-des f-elem-label f-elem-tooltip f-image-id-up
     2042             f-image-id-down f-image-id-insen
     2043         WITH FRAME Dialog-Frame.
     2044     ENABLE B-exit b-quit B-Help E-des f-elem-label f-elem-tooltip B-image-id-up
     2045            B-image-id-down B-image-id-insen b-chg BR-rule-call-param
     2046         WITH FRAME Dialog-Frame.
     2047     VIEW FRAME Dialog-Frame.
     2048   END PROCEDURE.
     2049   PROCEDURE MyEnable :
     2050   DEFINE BUFFER buf_rule FOR ub.RULE.
     2051   ASSIGN
     2052   tt-rule-call-param.param-data-type:visible in browse br-rule-call-param = (v-admin = yes)
     2053   tt-rule-call-param.param-name:visible in browse br-rule-call-param = (v-admin = yes)
     2054   .
     2055   find first tt0-layout-elem-rule where tt0-layout-elem-rule.uniq-key-rec = p-uniq-key-rec.
     2056   assign
     2057   frame Dialog-Frame:title = substitute("Функции для элемента ракладки &1 &2 &3"
     2058                                        , (if p-mode = 'ДОБАВЛЕНИЕ':U then '' else tt0-layout-elem-rule.layout-id)
     2059                                        , title-mode(p-mode)
     2060                                        ,( if v-admin then  "Режим IBS" else ''))
     2061   .
     2062   FIND FIRST buf_rule NO-LOCK WHERE
     2063             buf_rule.RULE_id = tt0-layout-elem-rule.RULE_id NO-ERROR.
     2064   IF AVAILABLE buf_rule THEN DO:
     2065   ASSIGN
     2066   f-rule-name = buf_rule.NAME
     2067   e-des:SCREEN-VALUE IN FRAME Dialog-Frame  = buf_rule.documentation
     2068   .
     2069   END.
     2070   ELSE DO:
     2071   ASSIGN
     2072   f-rule-name = substitute("!!!Неизвестная функция &1",tt-rule-call-param.RULE_id).
     2073   END.
     2074   DISPLAY
     2075   f-rule-name
     2076   tt0-layout-elem-rule.elem-label  @ f-elem-label
     2077   tt0-layout-elem-rule.elem-tooltip  @ f-elem-tooltip
     2078   tt0-layout-elem-rule.image-id-up  @ f-image-id-up
     2079   tt0-layout-elem-rule.image-id-down  @ f-image-id-down
     2080   tt0-layout-elem-rule.image-id-insen @ f-image-id-insen
     2081   WITH FRAME Dialog-Frame .
     2082   ENABLE
     2083   B-exit
     2084   b-quit
     2085   B-Help
     2086   b-chg when can-find(first tt-rule-call-param where tt-rule-call-param.call_id = p-uniq-key-rec)
     2087   f-image-id-up WHEN p-mode <> 'ПРОСМОТР':U  and p-device-type =  'th-pos-screen':U
     2088   f-image-id-down WHEN p-mode <> 'ПРОСМОТР':U and p-device-type = 'th-pos-screen':U
     2089   f-image-id-insen WHEN p-mode <> 'ПРОСМОТР':U and p-device-type = 'th-pos-screen':U
     2090   f-elem-label
     2091   f-elem-tooltip  when  (p-mode <> 'ПРОСМОТР':U) and p-device-type = 'th-pos-screen':U
     2092   B-image-id-up WHEN (p-mode <> 'ПРОСМОТР':U)   and p-device-type =  'th-pos-screen':U
     2093   B-image-id-down WHEN (p-mode <> 'ПРОСМОТР':U)  and p-device-type = 'th-pos-screen':U
     2094   B-image-id-insen WHEN (p-mode <> 'ПРОСМОТР':U) and p-device-type = 'th-pos-screen':U
     2095   BR-rule-call-param
     2096   WITH FRAME Dialog-Frame .
     2097   VIEW FRAME Dialog-Frame .
     2098   if p-mode = 'ПРОСМОТР':U then do:
     2099     assign
     2100     b-quit:label in frame Dialog-Frame = "&Выход"
     2101     b-quit:column = 1.
     2102     hide b-exit in frame Dialog-Frame .
     2103   end.
     2104   VIEW FRAME Dialog-Frame .
     2105   run Openbr in this-procedure.
     2106   END PROCEDURE.
     2107   PROCEDURE Openbr :
     2108   OPEN QUERY br-rule-call-param
     2109   FOR EACH tt-rule-call-param WHERE tt-rule-call-param.call_id = tt0-layout-elem-rule.uniq-key-rec
     2110   NO-LOCK INDEXED-REPOSITION.
     2111   END PROCEDURE.
     2112   PROCEDURE proc-b-chg :
     2113   DEFINE VARIABLE v-format AS CHARACTER NO-UNDO.
     2114   DEFINE VARIABLE v-value-character AS CHARACTER NO-UNDO.
     2115   DEFINE VARIABLE v-value-integer AS integer NO-UNDO.
     2116   DEFINE VARIABLE v-value-decimal AS decimal NO-UNDO.
     2117   DEFINE VARIABLE v-value-logical AS logical NO-UNDO.
     2118   DEFINE VARIABLE v-value-date AS date NO-UNDO.
     2119   define variable v-ok as logical no-undo .
     2120   DEFINE VARIABLE v-rec AS Rowid NO-UNDO.
     2121   define variable v-param-data-type as character no-undo .
     2122   define variable v-rid-list as character no-undo .
     2123   IF NOT AVAILABLE tt-rule-call-param  THEN DO:
     2124     RETURN ERROR.
     2125   END.
     2126   v-param-data-type = tt-rule-call-param.param-data-type +
     2127                       (if tt-rule-call-param.param-2-data-type = '':U
     2128                        then '':U
     2129                        else chr(44)) +
     2130                       tt-rule-call-param.param-2-data-type
     2131                        .
     2132   if lookup("READ-ONLY", tt-rule-call-param.param-3-data-type) > 0 then do:
     2133     message
     2134     "Данный параметр задан как READ-ONLY (Только для чтения)" skip
     2135     "Изменения не допускаются"
     2136     view-as alert-box error .
     2137     undo, return error .
     2138   end.
     2139   CASE  v-param-data-type:
     2140     when 'integer':U then do:
     2141       assign
     2142       v-value-integer = tt-rule-call-param.param-value-integer.
     2143       run gbl/d-integer.w (
     2144              input ?
     2145             ,input (
     2146             'title=':u + substitute("Изменение параметра &1", tt-rule-call-param.param-label) + '\':u
     2147           + 'text1=':u + tt-rule-call-param.param-label + '\':u
     2148           + 'format=' + (if tt-rule-call-param.param-data-type = 'L':U
     2149                         then "yes/no"
     2150                         else v-format) + '\':u
     2151           + 'fillin_row=3\':u
     2152           + 'fillin_col=4\':u
     2153           + 'fillin_width=20\':u
     2154           + 'fillin_height=1\':u
     2155           + 'max-chars=70\':u
     2156           + 'readonly=' + (if p-mode <> 'ИЗМЕНЕНИЕ':U and p-mode <> 'ДОБАВЛЕНИЕ':U then 'yes':u else 'no':u) + '\':u)
     2157           , input-output v-value-integer
     2158           , output v-ok
     2159               ).
     2160       if not v-ok then return error.
     2161       RUN set-value IN THIS-PROCEDURE (
     2162                                          INPUT tt-rule-call-param.profile_id
     2163                                         ,INPUT tt-rule-call-param.once-more
     2164                                         ,INPUT '':U
     2165                                         ,INPUT tt-rule-call-param.call_id
     2166                                         ,INPUT tt-rule-call-param.codex_id
     2167                                         ,INPUT tt-rule-call-param.ruleset_id
     2168                                         ,INPUT tt-rule-call-param.order_id
     2169                                         ,INPUT tt-rule-call-param.param-name
     2170                                         ,INPUT tt-rule-call-param.p-index
     2171                                         ,INPUT tt-rule-call-param.param-value-character
     2172                                         ,INPUT tt-rule-call-param.param-value-date
     2173                                         ,INPUT tt-rule-call-param.param-value-decimal
     2174                                         ,INPUT v-value-integer
     2175                                         ,INPUT tt-rule-call-param.param-value-logical).
     2176     end.
     2177     when 'decimal':U then do:
     2178       assign
     2179       v-value-decimal = tt-rule-call-param.param-value-decimal.
     2180       run gbl/d-decimal.w (
     2181              input ?
     2182             ,input (
     2183             'title=':u + substitute("Изменение параметра &1", tt-rule-call-param.param-label) + '\':u
     2184           + 'text1=':u + tt-rule-call-param.param-label + '\':u
     2185           + 'format=' + (if tt-rule-call-param.param-data-type = 'L':U
     2186                         then "yes/no"
     2187                         else v-format) + '\':u
     2188           + 'fillin_row=3\':u
     2189           + 'fillin_col=4\':u
     2190           + 'fillin_width=20\':u
     2191           + 'fillin_height=1\':u
     2192           + 'max-chars=70\':u
     2193           + 'readonly=' + (if p-mode <> 'ИЗМЕНЕНИЕ':U and p-mode <> 'ДОБАВЛЕНИЕ':U then 'yes':u else 'no':u) + '\':u)
     2194           , input-output v-value-decimal
     2195           , output v-ok
     2196               ).
     2197       if not v-ok then return error.
     2198       RUN set-value IN THIS-PROCEDURE (
     2199                                          INPUT tt-rule-call-param.profile_id
     2200                                         ,INPUT tt-rule-call-param.once-more
     2201                                         ,INPUT '':U
     2202                                         ,INPUT tt-rule-call-param.call_id
     2203                                         ,INPUT tt-rule-call-param.codex_id
     2204                                         ,INPUT tt-rule-call-param.ruleset_id
     2205                                         ,INPUT tt-rule-call-param.order_id
     2206                                         ,INPUT tt-rule-call-param.param-name
     2207                                         ,INPUT tt-rule-call-param.p-index
     2208                                         ,INPUT tt-rule-call-param.param-value-character
     2209                                         ,INPUT tt-rule-call-param.param-value-date
     2210                                         ,INPUT v-value-decimal
     2211                                         ,INPUT tt-rule-call-param.param-value-decimal
     2212                                         ,INPUT tt-rule-call-param.param-value-logical).
     2213     end.
     2214     when 'character':U then do:
     2215       assign
     2216       v-value-character = tt-rule-call-param.param-value-character.
     2217       run gbl/d-character.w (
     2218             input ?
     2219            ,input (
     2220             'title=':u + substitute("Изменение параметра &1", tt-rule-call-param.param-label) + '\':u
     2221           + 'text1=':u + tt-rule-call-param.param-label + '\':u
     2222           + 'format=' + (if tt-rule-call-param.param-data-type = 'L':U
     2223                         then "yes/no"
     2224                         else v-format) + '\':u
     2225           + 'fillin_row=4\':u
     2226           + 'fillin_col=4\':u
     2227           + 'fillin_width=20\':u
     2228           + 'fillin_height=1\':u
     2229           + 'max-chars=70\':u
     2230           + 'readonly=' + (if p-mode <> 'ИЗМЕНЕНИЕ':U and p-mode <> 'ДОБАВЛЕНИЕ':U then 'yes':u else 'no':u) + '\':u)
     2231           , input-output v-value-character
     2232           , output v-ok
     2233               ).
     2234           if not v-ok then return error.
     2235       RUN set-value IN THIS-PROCEDURE (
     2236                                          INPUT tt-rule-call-param.profile_id
     2237                                         ,INPUT tt-rule-call-param.once-more
     2238                                         ,INPUT '':U
     2239                                         ,INPUT tt-rule-call-param.call_id
     2240                                         ,INPUT tt-rule-call-param.codex_id
     2241                                         ,INPUT tt-rule-call-param.ruleset_id
     2242                                         ,INPUT tt-rule-call-param.order_id
     2243                                         ,INPUT tt-rule-call-param.param-name
     2244                                         ,INPUT tt-rule-call-param.p-index
     2245                                        ,INPUT v-value-character
     2246                                        ,INPUT tt-rule-call-param.param-value-date
     2247                                        ,INPUT tt-rule-call-param.param-value-decimal
     2248                                        ,INPUT tt-rule-call-param.param-value-integer
     2249                                        ,INPUT tt-rule-call-param.param-value-logical).
     2250     end.
     2251     when 'logical':U then do:
     2252       assign
     2253       v-value-logical = tt-rule-call-param.param-value-logical.
     2254       run gbl/d-logical.w (
     2255             input ?
     2256            ,input  (
     2257             'title=':u + substitute("Изменение параметра &1", tt-rule-call-param.param-label) + '\':u
     2258           + 'text1=':u + tt-rule-call-param.param-label + '\':u
     2259           + 'format=' + (if tt-rule-call-param.param-data-type = 'L':U
     2260                         then "yes/no"
     2261                         else v-format) + '\':u
     2262           + 'fillin_row=2\':u
     2263           + 'fillin_col=4\':u
     2264           + 'fillin_width=20\':u
     2265           + 'fillin_height=1\':u
     2266           + 'max-chars=70\':u
     2267           + 'readonly=' + (if p-mode <> 'ИЗМЕНЕНИЕ':U and p-mode <> 'ДОБАВЛЕНИЕ':U then 'yes':u else 'no':u) + '\':u)
     2268           , input-output v-value-logical
     2269           , output v-ok
     2270               ).
     2271       if not v-ok then return error.
     2272       RUN set-value IN THIS-PROCEDURE (
     2273                                          INPUT tt-rule-call-param.profile_id
     2274                                         ,INPUT tt-rule-call-param.once-more
     2275                                         ,INPUT '':U
     2276                                         ,INPUT tt-rule-call-param.call_id
     2277                                         ,INPUT tt-rule-call-param.codex_id
     2278                                         ,INPUT tt-rule-call-param.ruleset_id
     2279                                         ,INPUT tt-rule-call-param.order_id
     2280                                         ,INPUT tt-rule-call-param.param-name
     2281                                         ,INPUT tt-rule-call-param.p-index
     2282                                        ,INPUT tt-rule-call-param.param-value-character
     2283                                        ,INPUT tt-rule-call-param.param-value-date
     2284                                        ,INPUT tt-rule-call-param.param-value-decimal
     2285                                        ,INPUT tt-rule-call-param.param-value-integer
     2286                                        ,INPUT v-value-logical).
     2287     end.
     2288     when 'date':U then do:
     2289       assign
     2290       v-value-date = tt-rule-call-param.param-value-date.
     2291         run gbl/d-inpday.w
     2292           (input ?
     2293           ,input substitute("Изменение параметра &1", tt-rule-call-param.param-label)
     2294           ,input ""
     2295           ,input-output v-value-date
     2296           ,output v-ok
     2297           ) NO-ERROR.
     2298       if not v-ok then return error.
     2299       RUN set-value IN THIS-PROCEDURE (
     2300                                          INPUT tt-rule-call-param.profile_id
     2301                                         ,INPUT tt-rule-call-param.once-more
     2302                                         ,INPUT '':U
     2303                                         ,INPUT tt-rule-call-param.call_id
     2304                                         ,INPUT tt-rule-call-param.codex_id
     2305                                         ,INPUT tt-rule-call-param.ruleset_id
     2306                                         ,INPUT tt-rule-call-param.order_id
     2307                                         ,INPUT tt-rule-call-param.param-name
     2308                                         ,INPUT tt-rule-call-param.p-index
     2309                                        ,INPUT tt-rule-call-param.param-value-character
     2310                                        ,INPUT v-value-date
     2311                                        ,INPUT tt-rule-call-param.param-value-decimal
     2312                                        ,INPUT tt-rule-call-param.param-value-integer
     2313                                        ,INPUT tt-rule-call-param.param-value-logical).
     2314     end.
     2315     otherwise do:
     2316       assign
     2317       v-value-character = tt-rule-call-param.param-value-character
     2318       v-value-date = tt-rule-call-param.param-value-date
     2319       v-value-decimal = tt-rule-call-param.param-value-decimal
     2320       v-value-integer = tt-rule-call-param.param-value-integer
     2321       v-value-logical = tt-rule-call-param.param-value-logical
     2322       .
     2323       run ref/rule-dtt.p (
     2324                            input parparentproc
     2325                           ,input 'ИЗМЕНЕНИЕ':U
     2326                           ,input tt0-layout-elem-rule.uniq-key-rec
     2327                           ,input tt-rule-call-param.param-data-type
     2328                           ,input tt-rule-call-param.param-2-data-type
     2329                           ,input tt-rule-call-param.param-3-data-type
     2330                           ,input tt-rule-call-param.p-index
     2331                           ,input-output v-value-character
     2332                           ,input-output v-value-date
     2333                           ,input-output v-value-decimal
     2334                           ,input-output v-value-integer
     2335                           ,input-output v-value-logical
     2336                           ,output v-ok
     2337                           ) no-error.
     2338       if not error-status:error
     2339       and v-ok then do:
     2340         RUN set-value IN THIS-PROCEDURE (
     2341                                          INPUT tt-rule-call-param.profile_id
     2342                                         ,INPUT tt-rule-call-param.once-more
     2343                                         ,INPUT '':U
     2344                                         ,INPUT tt-rule-call-param.call_id
     2345                                         ,INPUT tt-rule-call-param.codex_id
     2346                                         ,INPUT tt-rule-call-param.ruleset_id
     2347                                         ,INPUT tt-rule-call-param.order_id
     2348                                         ,INPUT tt-rule-call-param.param-name
     2349                                         ,INPUT tt-rule-call-param.p-index
     2350                                          ,INPUT v-value-character
     2351                                          ,INPUT v-value-date
     2352                                          ,INPUT v-value-decimal
     2353                                          ,INPUT v-value-integer
     2354                                          ,INPUT v-value-logical).
     2355       end.
     2356     end.
     2357   end case.
     2358   ASSIGN
     2359   v-rec = Rowid(tt-rule-call-param)
     2360   .
     2361   run openbr in this-procedure .
     2362   REPOSITION br-rule-call-param TO Rowid v-rec NO-ERROR.
     2363   IF ERROR-STATUS:ERROR THEN DO:
     2364     REPOSITION br-rule-call-param TO ROW 1 NO-ERROR.
     2365   END.
     2366   APPLY "ENTRY" TO br-rule-call-param in frame Dialog-Frame .
     2367   APPLY "VALUE-CHANGED" TO br-rule-call-param in frame Dialog-Frame .
     2368   END PROCEDURE.
     2369   PROCEDURE proc-file :
     2370   define output parameter file-name as character no-undo.
     2371   define variable v_os-file   AS CHAR NO-UNDO INIT "".
     2372   define variable ll_commit AS LOG    NO-UNDO INIT NO.
     2373   define variable v-full-path        as character no-undo .
     2374   define variable v-path             as character no-undo .
     2375   define variable v-file-name        as character no-undo .
     2376   define variable v-file-name-no-ext as character no-undo .
     2377   define variable v-file-name-ext    as character no-undo .
     2378   define variable glog as logical no-undo .
     2379   SYSTEM-DIALOG GET-FILE v_os-file
     2380   TITLE "Задайте файл для изображения"
     2381   FILTERS
     2382     "Все ico файлы (*.ico) " "*.ico",
     2383     "Все файлы (*.*)"                      "*.*"
     2384   INITIAL-FILTER 1
     2385   DEFAULT-EXTENSION ".xml"
     2386   USE-FILENAME
     2387   MUST-EXIST
     2388   UPDATE ll_commit
     2389   .
     2390   IF ll_commit <> YES THEN do:
     2391       RETURN NO-APPLY.
     2392   end.
     2393   IF v_os-file = PROGRAM-NAME( 1 ) THEN DO:
     2394       BELL.
     2395       MESSAGE "Рекурсия!" VIEW-AS ALERT-BOX ERROR.
     2396       RETURN NO-APPLY.
     2397   END.
     2398   ASSIGN file-name = ( IF SEARCH( v_os-file ) = ? THEN v_os-file ELSE SEARCH( v_os-file ) ).
     2399   run gbl/filename.p (
     2400                   input  v_os-file
     2401                   ,output v-full-path
     2402                   ,output v-path
     2403                   ,output v-file-name
     2404                   ,output v-file-name-no-ext
     2405                   ,output v-file-name-ext
     2406                   ) no-error .
     2407   if error-status:error  = ? then do:
     2408     return no-apply.
     2409   end.
     2410   assign
     2411   file-name = v-full-path.
     2412   END PROCEDURE.
     2413   PROCEDURE proc-save :
     2414   DEFINE BUFFER buf_tt0-rule-call-param FOR tt0-rule-call-param.
     2415   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     2416   assign
     2417   frame Dialog-Frame
     2418   f-elem-label
     2419   f-elem-tooltip
     2420   f-image-id-up
     2421   f-image-id-down
     2422   f-image-id-insen
     2423   .
     2424   if f-elem-label = '' then do:
     2425     message
     2426     "Вы не определили лейбл"
     2427     view-as alert-box error .
     2428     undo, return error .
     2429   end.
     2430   for each buf_tt-rule-call-param:
     2431     find first buf_tt0-rule-call-param where
     2432              buf_tt0-rule-call-param.call_id = buf_tt-rule-call-param.call_id
     2433          and buf_tt0-rule-call-param.codex_id = buf_tt-rule-call-param.codex_id
     2434          and buf_tt0-rule-call-param.ruleset_id = buf_tt-rule-call-param.ruleset_id
     2435          and buf_tt0-rule-call-param.order_id = buf_tt-rule-call-param.order_id
     2436          and buf_tt0-rule-call-param.param-name = buf_tt-rule-call-param.param-name
     2437          and buf_tt0-rule-call-param.p-index = buf_tt-rule-call-param.p-index
     2438                .
     2439     buffer-copy buf_tt-rule-call-param to buf_tt0-rule-call-param.
     2440   end.
     2441   assign
     2442   tt0-layout-elem-rule.elem-label = f-elem-label
     2443   tt0-layout-elem-rule.elem-tooltip = f-elem-tooltip
     2444   tt0-layout-elem-rule.image-id-up = f-image-id-up
     2445   tt0-layout-elem-rule.image-id-down = f-image-id-down
     2446   tt0-layout-elem-rule.image-id-insen = f-image-id-insen
     2447   .
     2448   END PROCEDURE.
     2449   PROCEDURE set-value :
     2450   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     2451   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     2452   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     2453   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     2454   DEFINE INPUT PARAMETER p-codex-id AS integer NO-UNDO.
     2455   DEFINE INPUT PARAMETER p-ruleset-id AS integer NO-UNDO.
     2456   DEFINE INPUT PARAMETER p-order-id AS integer NO-UNDO.
     2457   DEFINE INPUT PARAMETER p-param-name AS character NO-UNDO.
     2458   DEFINE INPUT PARAMETER p-index AS integer NO-UNDO.
     2459   DEFINE INPUT parameter p-value-character AS CHARACTER NO-UNDO.
     2460   DEFINE INPUT parameter p-value-date AS date NO-UNDO.
     2461   DEFINE INPUT parameter p-value-decimal AS decimal NO-UNDO.
     2462   DEFINE INPUT parameter p-value-integer AS integer NO-UNDO.
     2463   DEFINE INPUT parameter p-value-logical AS logical NO-UNDO.
     2464   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     2465   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     2466   FIND FIRST buf_tt-rule-call-param WHERE
     2467       buf_tt-rule-call-param.call_id = p-call-id
     2468   AND buf_tt-rule-call-param.codex_id = p-codex-id
     2469   AND buf_tt-rule-call-param.ruleset_id = p-ruleset-id
     2470   AND buf_tt-rule-call-param.order_id = p-order-id
     2471   AND buf_tt-rule-call-param.param-name = p-param-name
     2472   AND buf_tt-rule-call-param.p-index = p-index.
     2473   assign
     2474   buf_tt-rule-call-param.param-value-character = p-value-character
     2475   buf_tt-rule-call-param.param-value-date      = p-value-date
     2476   buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     2477   buf_tt-rule-call-param.param-value-integer   = p-value-integer
     2478   buf_tt-rule-call-param.param-value-logical   = p-value-logical
     2479   .
     2480   END PROCEDURE.
