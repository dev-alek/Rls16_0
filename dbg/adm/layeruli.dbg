     1060           then do:
     1061             find first buf_temp-browse-handle
     1062               where buf_temp-browse-handle.browse-type   = 'height':u
     1063                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1064               no-error .
     1065             if available buf_temp-browse-handle
     1066             then do:
     1067             end.
