     1089           v-diasize-resize-button :column = 1
     1090         .
     1091       end.
     1092       if p-change-value > 0
     1093       then do:
     1094         if frame Dialog-Frame :scrollable = true
     1095         then do:
     1096           assign
     1097             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1098             no-error .
