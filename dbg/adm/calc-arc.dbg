     1270   define buffer buf_db for ub.db .
     1271   define buffer buf_clients for ub.clients .
     1272   do
     1273   on error undo, return error return-value
     1274   :
     1275     define variable v-ind as integer   no-undo .
     1276     run gbl/set-gbl.p
     1277       (input true
     1278       ,input g#auto-user-id
     1279       ,input g#auto-user-password
     1280       ) no-error.
     1281     if error-status :error
     1282     then do:
     1283       run write-to-log in this-procedure
     1284         ( vss-workfile + chr(32)
     1285         + "Ошибка при инициализации переменных g#..." + chr(10)
     1286         + error-status :get-message(error-status :num-messages) + chr(10)
     1287         + return-value
     1288         ) .
     1289       return error return-value .
     1290     end.
     1291     define variable v-calc-arh   as logical   no-undo .
     1292     define variable v-calc-ahsp  as logical   no-undo .
     1293     define variable v-calc-aht   as logical   no-undo .
     1294     define variable v-calc-hold  as logical   no-undo .
     1295     define variable v-param-list as character no-undo .
     1296     define variable v-param-type as character no-undo .
     1297     run schedule-attr-value in this-procedure
     1298       (input  p-cre-db-num
     1299       ,input  p-task-type
     1300       ,input  p-task-num
     1301       ,input  'schedule-param-list':U
     1302       ,output v-param-list
     1303       ,output v-param-type
     1304       ) .
     1305     if v-param-list = ""
     1306     then do:
     1307       assign
     1308         v-calc-arh  = true
     1309         v-calc-ahsp = true
     1310         v-calc-aht  = true
     1311         v-calc-hold = true
     1312       .
     1313     end.
     1314     else do:
     1315       run schedule-attr-extract-logical in this-procedure
     1316         (input  1
     1317         ,input  v-param-list
     1318         ,output v-calc-arh
     1319       ).
     1320       run schedule-attr-extract-logical in this-procedure
     1321         (input  2
     1322         ,input  v-param-list
     1323         ,output v-calc-ahsp
     1324       ).
     1325       run schedule-attr-extract-logical in this-procedure
     1326         (input  3
     1327         ,input  v-param-list
     1328         ,output v-calc-aht
     1329       ).
     1330       run schedule-attr-extract-logical in this-procedure
     1331         (input  4
     1332         ,input  v-param-list
     1333         ,output v-calc-hold
     1334       ).
     1335     end.
     1336     find first buf_db no-lock
     1337       where buf_db.db-num = p-db-num
     1338       no-error .
     1339     if not available buf_db
     1340     then do:
     1341       undo, return error
     1342         "Ошибка задания входящих параметров" + chr(10)
     1343         + substitute("Не найдена база данных &1", p-db-num)
     1344         .
     1345     end.
     1346     run write-to-log in this-procedure
     1347       ( substitute("Расчет складских архивов по базе данных &1", buf_db.db-num)
     1348       + (if v-calc-arh  = true then chr(10) + "                         Складской архив по товарам" else "")
     1349       + (if v-calc-ahsp = true then chr(10) + "                         Складской архив по поставщикам" else "")
     1350       + (if v-calc-aht  = true then chr(10) + "                         Складской архив по типам приобретения" else "")
     1351       + (if v-calc-hold = true then chr(10) + "                         Межфирменный архив" else "")
     1352       ) .
     1353     for each buf_clients no-lock
     1354       where buf_clients.db-num = buf_db.db-num
     1355         and buf_clients.stts   = 0
     1356     on error undo, return error return-value
     1357     :
     1358       define variable v-attr-arh-disable-chr  as character no-undo .
     1359       define variable v-attr-arh-disable-type as character no-undo .
     1360       define variable v-attr-arh-disable      as logical   no-undo .
     1361       run clntattr-value in this-procedure
     1362         (input  buf_clients.obj-type
     1363         ,input  buf_clients.obj-code
     1364         ,input  'arh-disable':U
     1365         ,output v-attr-arh-disable-chr
     1366         ,output v-attr-arh-disable-type
     1367         ).
     1368       assign
     1369         v-attr-arh-disable = lookup(v-attr-arh-disable-chr, "yes,true") > 0
     1370       .
     1371       if  v-calc-arh         = true
     1372       and v-attr-arh-disable <> true
     1373       then do:
     1374         run trg/bt_arh.p
     1375           (input buf_clients.obj-type
     1376           ,input buf_clients.obj-code
     1377           ,input ?
     1378           ,input false
     1379           ,input 0
     1380           ,input '':U
     1381           ) no-error .
     1382         if error-status :error
     1383         then do:
     1384           run write-to-log in this-procedure
     1385             ( vss-workfile + chr(32)
     1386               + substitute("Ошибка при расчете складского архива по товарам. Объект &1 &2" + chr(10)
     1387                             + "&3" + chr(10)
     1388                             + "&4" + chr(10)
     1389                           ,buf_clients.obj-type
     1390                           ,buf_clients.obj-code
     1391                           ,error-status :get-message(1)
     1392                           ,return-value
     1393                           )
     1394             ) .
     1395         end.
     1396       end.
     1397       define variable v-attr-ahsp-disable-chr  as character no-undo .
     1398       define variable v-attr-ahsp-disable-type as character no-undo .
     1399       define variable v-attr-ahsp-disable      as logical   no-undo .
     1400       run clntattr-value in this-procedure
     1401         (input  buf_clients.obj-type
     1402         ,input  buf_clients.obj-code
     1403         ,input  'ahsp-disable':U
     1404         ,output v-attr-ahsp-disable-chr
     1405         ,output v-attr-ahsp-disable-type
     1406         ).
     1407       assign
     1408         v-attr-ahsp-disable = lookup(v-attr-ahsp-disable-chr, "yes,true") > 0
     1409       .
     1410       if  v-calc-ahsp = true
     1411       and v-attr-ahsp-disable <> true
     1412       then do:
     1413         run trg/bt_ahsp.p
     1414           (input buf_clients.obj-type
     1415           ,input buf_clients.obj-code
     1416           ,input ?
     1417           ,input false
     1418           ,input 0
     1419           ,input '':U
     1420           ) no-error .
     1421         if error-status :error
     1422         then do:
     1423           run write-to-log in this-procedure
     1424             ( vss-workfile + chr(32)
     1425               + substitute("Ошибка при расчете складского архива по поставщикам. Объект &1 &2" + chr(10)
     1426                             + "&3" + chr(10)
     1427                             + "&4" + chr(10)
     1428                           ,buf_clients.obj-type
     1429                           ,buf_clients.obj-code
     1430                           ,error-status :get-message(1)
     1431                           ,return-value
     1432                           )
     1433             ) .
     1434         end.
     1435       end.
     1436       define variable v-attr-aht-disable-chr  as character no-undo .
     1437       define variable v-attr-aht-disable-type as character no-undo .
     1438       define variable v-attr-aht-disable      as logical   no-undo .
     1439       run clntattr-value in this-procedure
     1440         (input  buf_clients.obj-type
     1441         ,input  buf_clients.obj-code
     1442         ,input  'aht-disable':U
     1443         ,output v-attr-aht-disable-chr
     1444         ,output v-attr-aht-disable-type
     1445         ).
     1446       assign
     1447         v-attr-aht-disable = lookup(v-attr-aht-disable-chr, "yes,true") > 0
     1448       .
     1449       if  v-calc-aht = true
     1450       and v-attr-aht-disable <> true
     1451       then do:
     1452         run trg/bt_aht.p
     1453           (input buf_clients.obj-type
     1454           ,input buf_clients.obj-code
     1455           ,input ?
     1456           ,input false
     1457           ,input 0
     1458           ,input '':U
     1459           ) no-error .
     1460         if error-status :error
     1461         then do:
     1462           run write-to-log in this-procedure
     1463             ( vss-workfile + chr(32)
     1464               + substitute("Ошибка при расчете складского архива по типам приобретения. Объект &1 &2" + chr(10)
     1465                             + "&3" + chr(10)
     1466                             + "&4" + chr(10)
     1467                           ,buf_clients.obj-type
     1468                           ,buf_clients.obj-code
     1469                           ,error-status :get-message(1)
     1470                           ,return-value
     1471                           )
     1472             ) .
     1473         end.
     1474       end.
     1475     end.
     1476     if v-calc-hold = true
     1477     then do:
     1478       define variable hold-value as character no-undo .
     1479       define variable hold-type  as character no-undo.
     1480       define variable v-holding as logical   no-undo .
     1481   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1482     (input  'holding'
     1483     ,input  0
     1484     ,input  ''
     1485     ,input  0
     1486     ,input  ''
     1487     ,input  ''
     1488     ,input  ''
     1489     ,input  no
     1490     ,output hold-value
     1491     ,output hold-type
     1492     ) no-error .
     1493       if  ( not error-status:error )
     1494       and hold-value = "yes"
     1495       then do:
     1496         assign
     1497           v-holding = true
     1498         .
     1499       end.
     1500       else do:
     1501         assign
     1502           v-holding = false
     1503         .
     1504       end.
     1505       if v-holding = true
     1506       then do:
     1507         run trg/bt_hold.p
     1508           (input ?
     1509           ,input false
     1510           ,input 0
     1511           ,input '':U
     1512           ) no-error .
     1513         if error-status :error
     1514         then do:
     1515           run write-to-log in this-procedure
     1516             ( vss-workfile + chr(32)
     1517               + substitute("Ошибка при расчете межфирменных архивов" + chr(10) +
     1518                           "&1" + chr(10) +
     1519                           "&2" + chr(10)
     1520                           ,error-status :get-message(1)
     1521                           ,return-value
     1522                           )
     1523             ) .
     1524         end.
     1525       end.
     1526     end.
     1527     run trg/bt_clr.p .
     1528   end.
