      515     DEFINE BUFFER buf_tt-dis-rule FOR tt-dis-rule.
      516     DEFINE BUFFER buf_dis-rule FOR ub.dis-rule.
      517         run ref/dis-ruls.w (
      518                     input parparentproc
      519                     ,input 0
      520                     ,INPUT p-obj-type
      521                     ,INPUT  p-obj-code
      522                     ,input "b-sel":U
      523                     ,INPUT 'объект':U
      524                     ,INPUT 0
      525                     ,input ?
      526                     ,input 0
      527                     ,input-output v-sts
      528                     ,input-output v-rid-list ) no-error .
      529   IF ERROR-STATUS:ERROR OR v-rid-list = "":U  THEN RETURN no-apply.
      530   FIND FIRST buf_dis-rule NO-LOCK WHERE
      531           RECID(buf_dis-rule) = INTEGER(ENTRY(1, v-rid-list)) NO-ERROR.
      532   IF NOT AVAILABLE buf_dis-rule  THEN RETURN NO-APPLY.
      533   if buf_dis-rule.discnt-type = integer('13':U) then do:
      534     message
      535     "Не надо задавать соответствие для скидки свободного ввода"
      536     view-as alert-box error .
      537     undo, return no-apply.
      538   end.
      539   FIND FIRST buf_tt-dis-rule WHERE
      540             buf_tt-dis-rule.rule-num = buf_Dis-rule.rule-num NO-ERROR.
      541   if available buf_tt-dis-rule then do:
      542     MESSAGE
      543     SUBSTITUTE("Уже задано соответствие для правила &1"
      544               ,buf_tt-dis-rule.rule-num)
      545     VIEW-AS ALERT-BOX ERROR.
      546     RETURN NO-APPLY.
      547   end.
      548       run gbl/d-prompt.w (
      549         'title=':u + "Введите номер модели скидки НА КАССЕ" + '\':u
      550       + 'text1=':u + "(1-20)" + '\':u
      551       + 'format=' + ">9" + '\':u
      552       + 'type=' + 'I':U + '\':u
      553       + 'fillin_row=3\':u
      554       + 'fillin_col=4\':u
      555       + 'fillin_width=7\':u
      556       + 'fillin_height=1\':u
      557       + 'max-chars=5\':u
      558       + 'readonly=no\':u
      559       , input-output v-value
      560       ).
      561       if return-value = 'false':u then return NO-apply.
      562      IF INTEGER(v-value) > 20 OR
      563      integer(v-value) < 0 THEN DO:
      564          MESSAGE
      565          "Значение номера модели может быть только числом от 1 до 20"
      566          VIEW-AS ALERT-BOX ERROR.
      567          RETURN NO-APPLY.
      568      END.
      569      FIND FIRST buf_tt-dis-rule WHERE
      570                buf_tt-dis-rule.maria-rule-num = INTEGER(v-value) NO-ERROR.
      571      IF AVAILABLE buf_tt-dis-rule THEN DO:
      572          MESSAGE
      573          SUBSTITUTE("Уже задано соответствие с номером модели скидки &1"
      574                     ,buf_tt-dis-rule.maria-rule-num)
      575          VIEW-AS ALERT-BOX ERROR.
      576          RETURN NO-APPLY.
      577      END.
      578      CREATE tt-dis-rule.
      579      BUFFER-COPY buf_dis-rule
      580      TO tt-dis-rule
      581      ASSIGN
      582      tt-dis-rule.maria-rule-num = INTEGER(v-value)
      583      v-rid = RECID(tt-dis-rule)
      584      .
      585      run openbr IN THIS-PROCEDURE.
      586      REPOSITION br-dis-rule TO RECID v-rid.
      587   END.
      588   ON CHOOSE OF B-del-dr IN FRAME Dialog-Frame
      589   DO:
      590     IF NOT AVAILABLE tt-dis-rule THEN RETURN NO-APPLY.
      591     DELETE tt-dis-rule.
      592     run openbr IN THIS-PROCEDURE.
      593     REPOSITION br-dis-rule TO ROW 1.
      594   END.
