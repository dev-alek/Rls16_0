      729   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      730   procedure minbtn-set :
      731       do
      732           on error undo, return error return-value
      733           :
      734           define variable ii              as integer       no-undo .
      735           define variable fh              as widget-handle no-undo .
      736           define variable hh              as widget-handle no-undo .
      737           define variable v-h             as handle        extent 4 no-undo .
      738           define variable v-name-button   as character     no-undo .
      739           define variable v-help-old-x    as decimal       no-undo .
      740           define variable v-help-old-y    as decimal       no-undo .
      741           define variable v-help-old-size as decimal       no-undo .
      742           define variable v-frame-width   as decimal       no-undo .
      743           define variable jj              as integer       no-undo .
      744           do
      745               on error undo, return error
      746               :
      747               assign
      748                   v-frame-width = frame Dialog-Frame:width - 0.3
      749                   fh            = frame Dialog-Frame:first-child
      750                   hh            = fh:first-child
      751                   ii            = 1
      752                   .
      753               do while valid-handle(hh):
      754                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      755                   do:
      756                       case lc(hh:name) :
      757                           when "b-help" then
      758                               do:
      759                                   hh:load-image-up("cmp/b-help.bmp":u) .
      760                                   hh:load-image-down("cmp/b-help.bmp":u) .
      761                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      762                                   hh:TOOLTIP = "Помощь" .
      763                                   v-help-old-x = hh:column .
      764                                   v-help-old-y = hh:row    .
      765                                   v-help-old-size = hh:width .
      766                                   hh:width-chars = 2.5 .
      767                               end.
      768                           when "b-print" then
      769                               do:
      770                                   hh:load-image("cmp/b-print.bmp":u) .
      771                                   hh:TOOLTIP = "Печать" .
      772                                   v-h[ii] = hh:handle .
      773                                   ii = ii + 1 .
      774                                   hh:width-chars = 3 .
      775                               end.
      776                           when "b-history" or
      777                           when "b-hist" then
      778                               do:
      779                                   hh:load-image("cmp/b-hist.bmp":u) .
      780                                   hh:TOOLTIP = "История" .
      781                                   v-h[ii] = hh:handle .
      782                                   ii = ii + 1 .
      783                                   hh:width-chars = 3 .
      784                               end.
      785                           when "b-sch" then
      786                               do:
      787                                   hh:load-image("cmp/b-sch.bmp":u) .
      788                                   hh:TOOLTIP = "Установка Фильтра" .
      789                                   v-h[ii] = hh:handle .
      790                                   ii = ii + 1 .
      791                                   hh:width-chars = 3 .
      792                               end.
      793                           when "b-hist-user" then
      794                               do:
      795                                   hh:load-image("cmp/b-hist.bmp":u) .
      796                                   hh:TOOLTIP = "История пользователя" .
      797                                   ii = ii + 1 .
      798                               end.
      799                       end case.
      800                   end.
      801                   hh = hh:next-sibling.
      802               end.
      803               b-help:column = v-frame-width - b-help:width-chars.
      804               jj = 0.
      805               repeat ii = 4 to 1 by -1 :
      806                   if valid-handle (v-h[ii] ) then
      807                   do:
      808                       jj  = jj + 1 .
      809                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      810                       v-h[ii]:row    = v-help-old-y .
      811                   end.
      812               end.
      813           end.
      814       end.
      815   end procedure.
      816   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      817   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      818   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      819   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      820   define variable v-diasize-current-frame-width  as decimal   no-undo .
      821   define variable v-diasize-current-frame-height as decimal   no-undo .
      822   define variable v-diasize-change-size          as logical   no-undo .
      823   define variable v-diasize-resize-button        as handle    no-undo .
      824   define variable v-diasize-wndmax               as logical   no-undo .
      825   define variable v-diasize-wndstore             as logical   no-undo .
      826   define variable v-diasize-proc-name            as character no-undo .
      827   define variable v-diasize-browse-handle        as handle    no-undo .
      828   define variable v-diasize-browse-number        as integer   no-undo .
      829   define variable v-diasize-need-full-display    as logical   no-undo init false .
      830   define temp-table temp-diasize-handle no-undo
      831     field handle-value  as handle
      832     field save-position as decimal
      833     index xpk is primary unique handle-value
      834     .
      835   define temp-table temp-browse-handle no-undo
      836     field browse-type   as character
      837     field browse-number as integer
      838     field browse-handle as handle
      839     field original-size as decimal
      840     index xpk is primary unique browse-type browse-number
      841     index xie browse-type browse-handle
      842   .
      843   procedure diasize_change-height :
      844     define input  parameter p-change-value  as decimal   no-undo .
      845     define input  parameter p-move-resize   as logical   no-undo .
      846     define variable v-field-group-handle    as handle    no-undo .
      847     define variable v-object-handle         as handle    no-undo .
      848     define variable v-frame-height          as decimal   no-undo .
      849     define variable v-frame-virtual-height  as decimal   no-undo .
      850     define variable v-browse-height         as decimal   no-undo .
      851     define variable v-window-height         as decimal   no-undo .
      852     define variable v-window-virtual-height as decimal   no-undo .
      853     define variable v-change-sign           as integer   no-undo .
      854     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      855     define buffer buf_temp-browse-handle  for temp-browse-handle .
      856     if p-change-value > 0
      857     then do:
      858       if frame Dialog-Frame :height + p-change-value
      859           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      860       then do:
      861         assign
      862           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      863                           - (frame Dialog-Frame :height-chars)
      864         .
      865         if p-change-value <= 0
      866         then do:
      867           run diasize_position-resize-button in this-procedure .
      868           return .
      869         end.
      870       end.
      871     end.
      872     if p-change-value < 0
      873     then do:
      874       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      875       then do:
      876         assign
      877           p-change-value = v-diasize-orig-frame-height
      878                          - (frame Dialog-Frame :height-chars)
      879         .
      880         if p-change-value >= 0
      881         then do:
      882           run diasize_position-resize-button in this-procedure .
      883           return .
      884         end.
      885       end.
      886     end.
      887     if p-change-value >= 0
      888     then do:
      889       assign
      890         v-change-sign = 1
      891       .
      892     end.
      893     else do:
      894       assign
      895         v-change-sign = -1
      896       .
      897     end.
      898     assign
      899       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      900     .
      901     if p-change-value = 0
      902     then do:
      903       run diasize_position-resize-button in this-procedure .
      904       return .
      905     end.
      906     move_block:
      907     do
      908     on error undo move_block, retry move_block
      909     :
      910       if retry
      911       then do:
      912         do
      913         on error undo move_block, leave move_block
      914         :
      915           if p-change-value > 0
      916           then do:
      917             for each buf_temp-diasize-handle
      918             on error undo, next
      919             :
      920               assign
      921                 v-object-handle = buf_temp-diasize-handle.handle-value
      922               .
      923               if v-object-handle <> v-diasize-resize-button
      924               then do:
      925                 assign
      926                   v-object-handle :row = buf_temp-diasize-handle.save-position
      927                 .
      928               end.
      929             end.
      930             assign
      931               v-diasize-browse-handle :height = v-browse-height
      932             .
      933             for each buf_temp-browse-handle
      934               where buf_temp-browse-handle.browse-type = 'height':u
      935             on error undo, next
      936             :
      937               assign
      938                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      939               .
      940             end.
      941             assign
      942               frame Dialog-Frame :height = v-frame-height
      943             .
      944             if frame Dialog-Frame :scrollable = true
      945             then do:
      946               assign
      947                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      948               .
      949             end.
      950             run diasize_position-resize-button in this-procedure .
      951           end.
      952           else do:
      953             if frame Dialog-Frame :scrollable = true
      954             then do:
      955               assign
      956                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      957               .
      958             end.
      959             assign
      960               frame Dialog-Frame :height = v-frame-height
      961             .
      962             assign
      963               v-diasize-browse-handle :height = v-browse-height
      964             .
      965             for each buf_temp-browse-handle
      966               where buf_temp-browse-handle.browse-type = 'height':u
      967             on error undo, next
      968             :
      969               assign
      970                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      971               .
      972             end.
      973             for each buf_temp-diasize-handle
      974             on error undo, next
      975             :
      976               assign
      977                 v-object-handle = buf_temp-diasize-handle.handle-value
      978               .
      979               if v-object-handle <> v-diasize-resize-button
      980               then do:
      981                 assign
      982                   v-object-handle :row = buf_temp-diasize-handle.save-position
      983                 .
      984               end.
      985             end.
      986             run diasize_position-resize-button in this-procedure .
      987           end.
      988           assign
      989             v-diasize-change-size = false
      990           .
      991           leave move_block .
      992         end.
      993       end.
      994       assign
      995         v-diasize-need-full-display = true
      996       .
      997       if v-diasize-change-size = false
      998       then do:
      999         assign
     1000           v-diasize-change-size = true
     1001         .
     1002       end.
     1003       else do:
     1004         return .
     1005       end.
     1006       assign
     1007         v-frame-height = frame Dialog-Frame :height
     1008         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1009         v-browse-height = v-diasize-browse-handle :height
     1010       .
     1011       for each buf_temp-browse-handle
     1012         where buf_temp-browse-handle.browse-type = 'height':u
     1013       :
     1014         assign
     1015           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1016         .
     1017       end.
     1018       for each buf_temp-diasize-handle
     1019       :
     1020         delete buf_temp-diasize-handle .
     1021       end.
     1022       assign
     1023         v-field-group-handle = frame Dialog-Frame :first-child
     1024       .
     1025       do while valid-handle(v-field-group-handle)
     1026       :
     1027         assign
     1028           v-object-handle = v-field-group-handle :first-child
     1029         .
     1030         do while valid-handle(v-object-handle)
     1031         :
     1032           if  v-object-handle <> v-diasize-browse-handle :handle
     1033           and can-query(v-object-handle, "row")
     1034           and can-query(v-object-handle, "height")
     1035           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1036           then do:
     1037             find first buf_temp-browse-handle
     1038               where buf_temp-browse-handle.browse-type   = 'height':u
     1039                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1040               no-error .
     1041             if available buf_temp-browse-handle
     1042             then do:
     1043             end.
     1044             else do:
     1045               create buf_temp-diasize-handle .
     1046               assign
     1047                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1048                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1049               .
     1050             end.
     1051           end.
     1052           assign
     1053             v-object-handle = v-object-handle :next-sibling
     1054           .
     1055         end.
     1056         assign
     1057           v-field-group-handle = v-field-group-handle :next-sibling
     1058         .
     1059       end.
     1060       do with frame Dialog-Frame
     1061       :
     1062         hide v-diasize-resize-button .
     1063         assign
     1064           v-diasize-resize-button :row    = 1
     1065           v-diasize-resize-button :column = 1
     1066         .
     1067       end.
     1068       if p-change-value > 0
     1069       then do:
     1070         if frame Dialog-Frame :scrollable = true
     1071         then do:
     1072           assign
     1073             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1074             no-error .
     1075           if error-status :error
     1076           or error-status :get-message(1) <> ""
     1077           then do:
     1078             undo move_block, retry move_block .
     1079           end.
     1080         end.
     1081         assign
     1082           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1083           no-error .
     1084         if error-status :error
     1085         or error-status :get-message(1) <> ""
     1086         then do:
     1087           undo move_block, retry move_block .
     1088         end.
     1089         assign
     1090           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1091           no-error .
     1092         if error-status :error
     1093         or error-status :get-message(1) <> ""
     1094         then do:
     1095           undo move_block, retry move_block .
     1096         end.
     1097         for each buf_temp-browse-handle
     1098           where buf_temp-browse-handle.browse-type = 'height':u
     1099         on error undo move_block, retry move_block
     1100         :
     1101           assign
     1102             buf_temp-browse-handle.browse-handle :height
     1103               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1104             no-error .
     1105           if error-status :error
     1106           or error-status :get-message(1) <> ""
     1107           then do:
     1108             undo move_block, retry move_block .
     1109           end.
     1110         end.
     1111         for each buf_temp-diasize-handle
     1112         on error undo move_block, retry move_block
     1113         :
     1114           assign
     1115             v-object-handle = buf_temp-diasize-handle.handle-value
     1116           .
     1117           if v-object-handle <> v-diasize-resize-button
     1118           then do:
     1119             assign
     1120               v-object-handle :row = v-object-handle :row + p-change-value
     1121               no-error .
     1122             if error-status :error
     1123             or error-status :get-message(1) <> ""
     1124             then do:
     1125               undo move_block, retry move_block .
     1126             end.
     1127           end.
     1128         end.
     1129       end.
     1130       else do:
     1131         for each buf_temp-diasize-handle
     1132         on error undo move_block, retry move_block
     1133         :
     1134           assign
     1135             v-object-handle = buf_temp-diasize-handle.handle-value
     1136           .
     1137           if v-object-handle <> v-diasize-resize-button
     1138           then do:
     1139             assign
     1140               v-object-handle :row = v-object-handle :row + p-change-value
     1141               no-error .
     1142             if error-status :error
     1143             or error-status :get-message(1) <> ""
     1144             then do:
     1145               undo move_block, retry move_block .
     1146             end.
     1147           end.
     1148         end.
     1149         assign
     1150           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1151           no-error .
     1152         if error-status :error
     1153         or error-status :get-message(1) <> ""
     1154         then do:
     1155           undo move_block, retry move_block .
     1156         end.
     1157         for each buf_temp-browse-handle
     1158           where buf_temp-browse-handle.browse-type = 'height':u
     1159         on error undo move_block, retry move_block
     1160         :
     1161           assign
     1162             buf_temp-browse-handle.browse-handle :height
     1163               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1164             no-error .
     1165           if error-status :error
     1166           or error-status :get-message(1) <> ""
     1167           then do:
     1168             undo move_block, retry move_block .
     1169           end.
     1170         end.
     1171         assign
     1172           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1173           no-error .
     1174         if error-status :error
     1175         or error-status :get-message(1) <> ""
     1176         then do:
     1177           undo move_block, retry move_block .
     1178         end.
     1179         if frame Dialog-Frame :scrollable = true
     1180         then do:
     1181           assign
     1182             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1183             no-error .
     1184           if error-status :error
     1185           or error-status :get-message(1) <> ""
     1186           then do:
     1187             undo move_block, retry move_block .
     1188           end.
     1189         end.
     1190       end.
     1191       if p-move-resize = true
     1192       then do:
     1193         run diasize_position-resize-button in this-procedure .
     1194       end.
     1195       if v-diasize-wndstore = true
     1196       then do:
     1197         if connected("ub") = true
     1198         then do:
     1199           define variable v-cntxt-db-num        as integer   no-undo .
     1200           define variable v-cntxt-userid        as character no-undo .
     1201           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1202                                             , OUTPUT v-cntxt-userid
     1203                                             ) .
     1204           run gbl/wndsizew.p
     1205             (input  v-cntxt-db-num
     1206             ,input  v-cntxt-userid
     1207             ,input  v-diasize-proc-name
     1208             ,input  'height':u
     1209             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1210             ) .
     1211         end.
     1212       end.
     1213     end.
     1214     assign
     1215       v-diasize-change-size = false
     1216     .
     1217   end procedure.
     1218   procedure diasize_set-height :
     1219     define input  parameter p-new-height  as decimal   no-undo .
     1220     define input  parameter p-move-resize as logical   no-undo .
     1221     do
     1222     on error undo, return error return-value
     1223     :
     1224       run diasize_change-height in this-procedure
     1225         (input  (p-new-height - frame Dialog-Frame :height)
     1226         ,input  p-move-resize
     1227         ) .
     1228     end.
     1229   end procedure.
     1230   procedure diasize_change-width :
     1231     define input  parameter p-change-value as decimal   no-undo .
     1232     define input  parameter p-move-resize  as logical   no-undo .
     1233     define variable v-field-group-handle   as handle    no-undo .
     1234     define variable v-object-handle        as handle    no-undo .
     1235     define variable v-frame-width          as decimal   no-undo .
     1236     define variable v-frame-virtual-width  as decimal   no-undo .
     1237     define variable v-browse-width         as decimal   no-undo .
     1238     define variable v-window-width         as decimal   no-undo .
     1239     define variable v-window-virtual-width as decimal   no-undo .
     1240     define variable v-change-sign          as integer   no-undo .
     1241     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1242     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1243     if p-change-value > 0
     1244     then do:
     1245       if frame Dialog-Frame :width + p-change-value >
     1246           session :width-chars
     1247       then do:
     1248         assign
     1249           p-change-value = session :width-chars - frame Dialog-Frame :width
     1250         .
     1251         if p-change-value <= 0
     1252         then do:
     1253           run diasize_position-resize-button in this-procedure .
     1254           return .
     1255         end.
     1256       end.
     1257     end.
     1258     if p-change-value < 0
     1259     then do:
     1260       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1261       then do:
     1262         assign
     1263           p-change-value = v-diasize-orig-frame-width
     1264                          - frame Dialog-Frame :width
     1265         .
     1266         if p-change-value >= 0
     1267         then do:
     1268           run diasize_position-resize-button in this-procedure .
     1269           return .
     1270         end.
     1271       end.
     1272     end.
     1273     if p-change-value >= 0
     1274     then do:
     1275       assign
     1276         v-change-sign = 1
     1277       .
     1278     end.
     1279     else do:
     1280       assign
     1281         v-change-sign = -1
     1282       .
     1283     end.
     1284     assign
     1285       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1286     .
     1287     if p-change-value = 0
     1288     then do:
     1289       run diasize_position-resize-button in this-procedure .
     1290       return .
     1291     end.
     1292     move_block:
     1293     do
     1294     on error undo move_block, leave move_block
     1295     :
     1296       if retry
     1297       then do:
     1298         do
     1299         on error undo move_block, leave move_block
     1300         :
     1301           if p-change-value > 0
     1302           then do:
     1303             for each buf_temp-diasize-handle
     1304             on error undo, next
     1305             :
     1306               assign
     1307                 v-object-handle = buf_temp-diasize-handle.handle-value
     1308               .
     1309               if v-object-handle <> v-diasize-resize-button
     1310               then do:
     1311                 assign
     1312                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1313                 .
     1314               end.
     1315             end.
     1316             assign
     1317               v-diasize-browse-handle :width = v-browse-width
     1318             .
     1319             for each buf_temp-browse-handle
     1320               where buf_temp-browse-handle.browse-type = 'width':u
     1321             on error undo, next
     1322             :
     1323               assign
     1324                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1325               .
     1326             end.
     1327             assign
     1328               frame Dialog-Frame :width = v-frame-width
     1329             .
     1330             if frame Dialog-Frame :scrollable = true
     1331             then do:
     1332               assign
     1333                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1334               .
     1335             end.
     1336             run diasize_position-resize-button in this-procedure .
     1337           end.
     1338           else do:
     1339             if frame Dialog-Frame :scrollable = true
     1340             then do:
     1341               assign
     1342                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1343               .
     1344             end.
     1345             assign
     1346               frame Dialog-Frame :width = v-frame-width
     1347             .
     1348             for each buf_temp-browse-handle
     1349               where buf_temp-browse-handle.browse-type = 'width':u
     1350             on error undo, next
     1351             :
     1352               assign
     1353                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1354               .
     1355             end.
     1356             assign
     1357               v-diasize-browse-handle :width = v-browse-width
     1358             .
     1359             for each buf_temp-diasize-handle
     1360             on error undo, next
     1361             :
     1362               assign
     1363                 v-object-handle = buf_temp-diasize-handle.handle-value
     1364               .
     1365               if v-object-handle <> v-diasize-resize-button
     1366               then do:
     1367                 assign
     1368                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1369                 .
     1370               end.
     1371             end.
     1372             run diasize_position-resize-button in this-procedure .
     1373           end.
     1374           assign
     1375             v-diasize-change-size = false
     1376           .
     1377           leave move_block .
     1378         end.
     1379       end.
     1380       assign
     1381         v-diasize-need-full-display = true
     1382       .
     1383       if v-diasize-change-size = false
     1384       then do:
     1385         assign
     1386           v-diasize-change-size = true
     1387         .
     1388       end.
     1389       else do:
     1390         return .
     1391       end.
     1392       assign
     1393         v-frame-width = frame Dialog-Frame :width
     1394         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1395         v-browse-width = v-diasize-browse-handle :width
     1396       .
     1397       for each buf_temp-browse-handle
     1398         where buf_temp-browse-handle.browse-type = 'width':u
     1399       :
     1400         assign
     1401           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1402         .
     1403       end.
     1404       for each buf_temp-diasize-handle
     1405       :
     1406         delete buf_temp-diasize-handle .
     1407       end.
     1408       assign
     1409         v-field-group-handle = frame Dialog-Frame :first-child
     1410       .
     1411       do while valid-handle(v-field-group-handle)
     1412       :
     1413         assign
     1414           v-object-handle = v-field-group-handle :first-child
     1415         .
     1416         do while valid-handle(v-object-handle)
     1417         :
     1418           if  v-object-handle <> v-diasize-browse-handle :handle
     1419           and v-object-handle <> v-diasize-resize-button
     1420           and can-query(v-object-handle, "row")
     1421           and can-query(v-object-handle, "height")
     1422           and ( v-object-handle :col + v-object-handle :width
     1423                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1424               )
     1425           then do:
     1426             find first buf_temp-browse-handle
     1427               where buf_temp-browse-handle.browse-type   = 'width':u
     1428                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1429               no-error .
     1430             if available buf_temp-browse-handle
     1431             then do:
     1432             end.
     1433             else do:
     1434               create buf_temp-diasize-handle .
     1435               assign
     1436                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1437                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1438               .
     1439             end.
     1440           end.
     1441           assign
     1442             v-object-handle = v-object-handle :next-sibling
     1443           .
     1444         end.
     1445         assign
     1446           v-field-group-handle = v-field-group-handle :next-sibling
     1447         .
     1448       end.
     1449       do with frame Dialog-Frame
     1450       :
     1451         hide v-diasize-resize-button .
     1452         v-diasize-resize-button :row = 1.
     1453         v-diasize-resize-button :column = 1.
     1454       end.
     1455       if p-change-value > 0
     1456       then do:
     1457         if frame Dialog-Frame :scrollable = true
     1458         then do:
     1459           assign
     1460             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1461             no-error .
     1462           if error-status :error
     1463           or error-status :get-message(1) <> ""
     1464           then do:
     1465             undo move_block, retry move_block.
     1466           end.
     1467         end.
     1468         assign
     1469           frame Dialog-Frame :width = v-frame-width + p-change-value
     1470           no-error .
     1471         if error-status :error
     1472         or error-status :get-message(1) <> ""
     1473         then do:
     1474           undo move_block, retry move_block.
     1475         end.
     1476         assign
     1477           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1478         no-error .
     1479         if error-status :error
     1480         or error-status :get-message(1) <> ""
     1481         then do:
     1482           undo move_block, retry move_block.
     1483         end.
     1484         for each buf_temp-browse-handle
     1485           where buf_temp-browse-handle.browse-type = 'width':u
     1486         on error undo move_block, retry move_block
     1487         :
     1488           assign
     1489             buf_temp-browse-handle.browse-handle :width
     1490               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1491             no-error .
     1492           if error-status :error
     1493           or error-status :get-message(1) <> ""
     1494           then do:
     1495             undo move_block, retry move_block .
     1496           end.
     1497         end.
     1498         for each buf_temp-diasize-handle
     1499         on error undo move_block, retry move_block
     1500         :
     1501           assign
     1502             v-object-handle = buf_temp-diasize-handle.handle-value
     1503           .
     1504           if v-object-handle <> v-diasize-resize-button
     1505           then do:
     1506             assign
     1507               v-object-handle :col = v-object-handle :col + p-change-value
     1508               no-error .
     1509             if error-status :error
     1510             or error-status :get-message(1) <> ""
     1511             then do:
     1512               undo move_block, retry move_block .
     1513             end.
     1514           end.
     1515         end.
     1516       end.
     1517       else do:
     1518         for each buf_temp-diasize-handle
     1519         on error undo move_block, retry move_block
     1520         :
     1521           assign
     1522             v-object-handle = buf_temp-diasize-handle.handle-value
     1523           .
     1524           if v-object-handle <> v-diasize-resize-button
     1525           then do:
     1526             assign
     1527               v-object-handle :col = v-object-handle :col + p-change-value
     1528               no-error .
     1529             if error-status :error
     1530             or error-status :get-message(1) <> ""
     1531             then do:
     1532               undo move_block, retry move_block .
     1533             end.
     1534           end.
     1535         end.
     1536         for each buf_temp-browse-handle
     1537           where buf_temp-browse-handle.browse-type = 'width':u
     1538         on error undo move_block, retry move_block
     1539         :
     1540           assign
     1541             buf_temp-browse-handle.browse-handle :width
     1542               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1543             no-error .
     1544           if error-status :error
     1545           or error-status :get-message(1) <> ""
     1546           then do:
     1547             undo move_block, retry move_block .
     1548           end.
     1549         end.
     1550         assign
     1551           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1552           no-error .
     1553         if error-status :error
     1554         or error-status :get-message(1) <> ""
     1555         then do:
     1556           undo move_block, retry move_block.
     1557         end.
     1558         assign
     1559           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1560         no-error .
     1561         if error-status :error
     1562         or error-status :get-message(1) <> ""
     1563         then do:
     1564           undo move_block, retry move_block.
     1565         end.
     1566         if frame Dialog-Frame :scrollable = true
     1567         then do:
     1568           assign
     1569             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1570           no-error .
     1571           if error-status :error
     1572           or error-status :get-message(1) <> ""
     1573           then do:
     1574             undo move_block, retry move_block.
     1575           end.
     1576         end.
     1577       end.
     1578       if p-move-resize
     1579       then do:
     1580         run diasize_position-resize-button in this-procedure .
     1581       end.
     1582       if v-diasize-wndstore = true
     1583       then do:
     1584         if connected("ub") = true
     1585         then do:
     1586           define variable v-cntxt-db-num        as integer   no-undo .
     1587           define variable v-cntxt-userid        as character no-undo .
     1588           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1589                                             , OUTPUT v-cntxt-userid
     1590                                             ) .
     1591           run gbl/wndsizew.p
     1592             (input  v-cntxt-db-num
     1593             ,input  v-cntxt-userid
     1594             ,input  v-diasize-proc-name
     1595             ,input  'width':u
     1596             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1597             ) .
     1598         end.
     1599       end.
     1600     end.
     1601     assign
     1602       v-diasize-change-size = false
     1603     .
     1604   end procedure.
     1605   procedure diasize_set-width :
     1606     define input  parameter p-new-width  as decimal   no-undo .
     1607     define input  parameter p-move-resize as logical   no-undo .
     1608     do
     1609     on error undo, return error return-value
     1610     :
     1611       run diasize_change-width in this-procedure
     1612         (input  (p-new-width - frame Dialog-Frame :width)
     1613         ,input  p-move-resize
     1614         ) .
     1615     end.
     1616   end procedure.
     1617   procedure diasize_position-resize-button :
     1618     do with frame Dialog-Frame
     1619     :
     1620       hide v-diasize-resize-button .
     1621       assign
     1622         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1623                     - 1
     1624                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1625         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1626                     - 1
     1627                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1628       .
     1629       view v-diasize-resize-button .
     1630     end.
     1631   end procedure.
     1632   on alt-right anywhere
     1633   do:
     1634     run diasize_change-width in this-procedure
     1635       (input 1
     1636       ,input true
     1637       ) .
     1638     return no-apply .
     1639   end.
     1640   on alt-left anywhere
     1641   do:
     1642     run diasize_change-width in this-procedure
     1643       (input -1
     1644       ,input true
     1645       ) .
     1646     return no-apply .
     1647   end.
     1648   on alt-down anywhere
     1649   do:
     1650     run diasize_change-height in this-procedure
     1651       (input 1
     1652       ,input true
     1653       ) .
     1654     return no-apply .
     1655   end.
     1656   on alt-up anywhere
     1657   do:
     1658     run diasize_change-height in this-procedure
     1659       (input -1
     1660       ,input true
     1661       ) .
     1662     return no-apply .
     1663   end.
     1664   on alt-enter of frame Dialog-Frame
     1665   do:
     1666     run diasize_maximize in this-procedure
     1667       (input  ?
     1668       ).
     1669     return no-apply .
     1670   end.
     1671   procedure diasize_end-move :
     1672     do
     1673     on error undo, return error return-value
     1674     :
     1675       define variable v-row-delta as decimal   no-undo .
     1676       define variable v-col-delta as decimal   no-undo .
     1677       define variable v-new-row as decimal   no-undo .
     1678       define variable v-new-col as decimal   no-undo .
     1679       assign
     1680         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1681         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1682       .
     1683       assign
     1684         v-row-delta = v-new-row - frame Dialog-Frame :height
     1685         v-col-delta = v-new-col - frame Dialog-Frame :width
     1686       .
     1687       run diasize_change-height in this-procedure
     1688         (input v-row-delta
     1689         ,input true
     1690         ) .
     1691       run diasize_change-width in this-procedure
     1692         (input v-col-delta
     1693         ,input true
     1694         ) .
     1695     end.
     1696   end procedure.
     1697   procedure diasize_maximize :
     1698     define input  parameter p-action as logical   no-undo .
     1699     do
     1700     on error undo, return error return-value
     1701     :
     1702       if p-action = ?
     1703       then do:
     1704         if v-diasize-need-maximize = true
     1705         then do:
     1706           assign
     1707             p-action = true
     1708           .
     1709         end.
     1710         else do:
     1711           assign
     1712             p-action = false
     1713           .
     1714         end.
     1715       end.
     1716       if p-action = true
     1717       then do:
     1718         run diasize_change-height in this-procedure
     1719           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1720               - frame Dialog-Frame :height-chars
     1721           ,input true
     1722           ) .
     1723         run diasize_change-width in this-procedure
     1724           (input session :width-chars
     1725               - frame Dialog-Frame :width-chars
     1726           ,input true
     1727           ) .
     1728         assign
     1729           v-diasize-need-maximize = false
     1730         .
     1731       end.
     1732       else do:
     1733         run diasize_change-width in this-procedure
     1734           (input v-diasize-orig-frame-width
     1735               - frame Dialog-Frame :width-chars
     1736           ,input true
     1737           ) .
     1738         run diasize_change-height in this-procedure
     1739           (input v-diasize-orig-frame-height
     1740               - frame Dialog-Frame :height-chars
     1741           ,input true
     1742           ) .
     1743         assign
     1744           v-diasize-need-maximize = true
     1745         .
     1746       end.
     1747     end.
     1748   end procedure.
     1749   procedure diasize_restore-orig-size :
     1750     do
     1751     on error undo, return error return-value
     1752     :
     1753       assign
     1754         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1755         v-diasize-current-frame-height = frame Dialog-Frame :height
     1756       .
     1757       run diasize_set-height in this-procedure
     1758         (input  v-diasize-orig-frame-height
     1759         ,input  true
     1760         ) .
     1761       run diasize_set-width in this-procedure
     1762         (input  v-diasize-orig-frame-width
     1763         ,input  true
     1764         ) .
     1765     end.
     1766   end procedure.
     1767   procedure diasize_restore-current-size :
     1768     do
     1769     on error undo, return error return-value
     1770     :
     1771       run diasize_set-height in this-procedure
     1772         (input  v-diasize-current-frame-height
     1773         ,input  true
     1774         ) .
     1775       run diasize_set-width in this-procedure
     1776         (input  v-diasize-current-frame-width
     1777         ,input  true
     1778         ) .
     1779     end.
     1780   end procedure.
     1781   procedure diasize_set-browse-handle :
     1782     define input  parameter p-browse-handle as handle   no-undo .
     1783     define buffer buf_temp-browse-handle for temp-browse-handle .
     1784     do
     1785     on error undo, return error return-value
     1786     :
     1787       assign
     1788         v-diasize-browse-handle = p-browse-handle
     1789       .
     1790       for each buf_temp-browse-handle
     1791       on error undo, return error return-value
     1792       :
     1793         delete buf_temp-browse-handle .
     1794       end.
     1795     end.
     1796   end procedure.
     1797   procedure diasize_add_browse :
     1798     define input  parameter p-browse-type   as character no-undo .
     1799     define input  parameter p-browse-handle as handle    no-undo .
     1800     define buffer buf_temp-browse-handle for temp-browse-handle .
     1801     do
     1802     on error undo, return error return-value
     1803     :
     1804       assign
     1805         v-diasize-browse-number = v-diasize-browse-number + 1
     1806       .
     1807       create buf_temp-browse-handle .
     1808       assign
     1809         buf_temp-browse-handle.browse-type   = p-browse-type
     1810         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1811         buf_temp-browse-handle.browse-handle = p-browse-handle
     1812       .
     1813     end.
     1814   end procedure.
     1815   procedure diasize_init :
     1816     define variable v-default-value    as logical   no-undo .
     1817     define variable v-restore-saved    as logical   no-undo .
     1818     define variable v-resize-value-str as character no-undo .
     1819     do
     1820     on error undo, return error return-value
     1821     :
     1822       do with frame Dialog-Frame
     1823       :
     1824         assign
     1825           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1826           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1827           v-diasize-browse-handle     = browse BR-dis-rule :handle
     1828         .
     1829         create button v-diasize-resize-button
     1830         assign
     1831           parent        = frame Dialog-Frame :first-child
     1832           label         = "s"
     1833           height-pixels = 16
     1834           width-pixels  = 16
     1835           visible       = true
     1836           sensitive     = true
     1837           movable       = true
     1838           triggers:
     1839             on end-move persistent run diasize_end-move in this-procedure .
     1840           end triggers.
     1841         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1842         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1843         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1844         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1845         assign
     1846           v-diasize-wndmax = false
     1847         .
     1848         if connected("ub") = true
     1849         then do:
     1850           define variable v-cntxt-db-num        as integer   no-undo .
     1851           define variable v-cntxt-userid        as character no-undo .
     1852           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1853                                             , OUTPUT v-cntxt-userid
     1854                                             ) .
     1855           run gbl/wndpar_r.p
     1856             (input  v-cntxt-db-num
     1857             ,input  v-cntxt-userid
     1858             ,input  'wndmax':U
     1859             ,output v-diasize-wndmax
     1860             ,output v-default-value
     1861             ) .
     1862         end.
     1863         assign
     1864           v-diasize-wndstore = false
     1865         .
     1866         if connected("ub") = true
     1867         then do:
     1868           run gbl/wndpar_r.p
     1869             (input  v-cntxt-db-num
     1870             ,input  v-cntxt-userid
     1871             ,input  'wndstore':U
     1872             ,output v-diasize-wndstore
     1873             ,output v-default-value
     1874             ) .
     1875         end.
     1876         assign
     1877           v-diasize-proc-name = entry(1, program-name(2), '.')
     1878         .
     1879         if v-diasize-wndstore = true
     1880         then do:
     1881           assign
     1882             v-restore-saved = false
     1883           .
     1884           if connected("ub") = true
     1885           then do:
     1886             run gbl/wndsizer.p
     1887               (input  v-cntxt-db-num
     1888               ,input  v-cntxt-userid
     1889               ,input  v-diasize-proc-name
     1890               ,input  'height':u
     1891               ,output v-resize-value-str
     1892               ) .
     1893             if v-resize-value-str <> '':U
     1894             then do:
     1895               run diasize_change-height in this-procedure
     1896                 (input  integer(v-resize-value-str)
     1897                 ,input  true
     1898                 ) .
     1899               assign
     1900                 v-restore-saved = true
     1901               .
     1902             end.
     1903           end.
     1904           if connected("ub") = true
     1905           then do:
     1906             run gbl/wndsizer.p
     1907               (input  v-cntxt-db-num
     1908               ,input  v-cntxt-userid
     1909               ,input  v-diasize-proc-name
     1910               ,input  'width':u
     1911               ,output v-resize-value-str
     1912               ) .
     1913             if v-resize-value-str <> '':U
     1914             then do:
     1915               run diasize_change-width in this-procedure
     1916                 (input  integer(v-resize-value-str)
     1917                 ,input  true
     1918                 ) .
     1919               assign
     1920                 v-restore-saved = true
     1921               .
     1922             end.
     1923           end.
     1924           if v-restore-saved <> true
     1925           then do:
     1926             if v-diasize-wndmax = true
     1927             then do:
     1928               run diasize_maximize in this-procedure
     1929                 (input  true
     1930                 ) .
     1931             end.
     1932           end.
     1933         end.
     1934         else do:
     1935           if v-diasize-wndmax = true
     1936           then do:
     1937             run diasize_maximize in this-procedure
     1938               (input  true
     1939               ) .
     1940           end.
     1941         end.
     1942       end.
     1943     end.
     1944   end procedure.
     1945   procedure diasize_need-full-display :
     1946     define output parameter p-need-full-display as logical   no-undo .
     1947     do
     1948     on error undo, return error return-value
     1949     :
     1950       assign
     1951         p-need-full-display = v-diasize-need-full-display
     1952       .
     1953       assign
     1954         v-diasize-need-full-display = false
     1955       .
     1956     end.
     1957   end procedure.
     1958   procedure get-context :
     1959      define output parameter p-db-num as integer          no-undo.
     1960      define output parameter p-user-id as character        no-undo.
     1961      define variable v-login               as character    no-undo.
     1962      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1963      define buffer buf_user-login  for ub.user-login .
     1964      do
     1965      on error undo, return error
     1966      :
     1967            FIND FIRST buf_sys-ctrl no-lock.
     1968            ASSIGN
     1969               v-login = USERID("ub")
     1970               p-db-num = buf_sys-ctrl.db-num
     1971            .
     1972            FIND FIRST buf_user-login
     1973                 WHERE buf_user-login.db-num = p-db-num
     1974                   AND buf_user-login.user-login = v-login
     1975                 no-lock
     1976                 no-error
     1977                 .
     1978            IF AVAILABLE buf_user-login
     1979            THEN DO:
     1980               assign
     1981                  p-user-id = buf_user-login.user-id
     1982               .
     1983            END.
     1984      end.
     1985   end procedure.
     1986       run diasize_init in this-procedure .
     1987   MAIN-BLOCK:
     1988   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1989      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1990     run Myenable in this-procedure .
     1991     WAIT-FOR GO OF FRAME Dialog-Frame.
     1992   END.
     1993   run disable_UI.
     1994   PROCEDURE disable_UI :
     1995     HIDE FRAME Dialog-Frame.
     1996   END PROCEDURE.
     1997   PROCEDURE enable_UI :
     1998     DISPLAY l-dcgdsrank1 l-dcgrouprank1 l-dcgdsrank2 l-dcgrouprank2 l-dcgdsrank3
     1999             l-dcgrouprank3 l-dcgdsrank4 l-dcgrouprank l-dcgdsrank5 l-dcgrouprank5
     2000         WITH FRAME Dialog-Frame.
     2001     ENABLE B-exit b-quit B-Help B-lookup BR-dis-rule B-gds-up B-group-up
     2002            B-gds-down B-group-down BR-gds-rank BR-group-rank l-dcgdsrank1
     2003            l-dcgrouprank1 l-dcgdsrank2 l-dcgrouprank2 l-dcgdsrank3 l-dcgrouprank3
     2004            l-dcgdsrank4 l-dcgrouprank l-dcgdsrank5 l-dcgrouprank5
     2005         WITH FRAME Dialog-Frame.
     2006     VIEW FRAME Dialog-Frame.
     2007     OPEN QUERY BR-gds-rank FOR EACH gds-temp-rank WHERE gds-temp-rank.subject = "gds".    OPEN QUERY BR-group-rank FOR EACH group-temp-rank WHERE group-temp-rank.subject = "group".
     2008   END PROCEDURE.
     2009   PROCEDURE MyEnable :
     2010   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     2011   DEFINE VARIABLE v-maria-rule-num AS INTEGER NO-UNDO.
     2012   DEFINE VARIABLE v-rule-num AS INTEGER NO-UNDO.
     2013   DEFINE BUFFER buf_dis-rule FOR ub.dis-rule.
     2014   FOR EACH tt-dis-rule:
     2015       DELETE tt-dis-rule.
     2016   END.
     2017   DO ii = 1 TO NUM-ENTRIES(dr-list):
     2018     ASSIGN
     2019     v-maria-rule-num = integer(ENTRY(2, ENTRY(ii, dr-list), '-':U))
     2020     v-rule-num = integer(ENTRY(1, ENTRY(ii, dr-list), '-':U))
     2021     NO-ERROR
     2022     .
     2023     IF NOT ERROR-STATUS:ERROR THEN DO:
     2024       FIND FIRST tt-dis-rule NO-LOCK WHERE
     2025               tt-dis-rule.maria-rule-num = v-maria-rule-num NO-ERROR.
     2026       IF NOT AVAILABLE tt-dis-rule THEN DO:
     2027         FIND FIRST tt-dis-rule NO-LOCK WHERE
     2028             tt-dis-rule.rule-num = v-rule-num NO-ERROR.
     2029         IF NOT AVAILABLE tt-dis-rule THEN DO:
     2030           FIND FIRST buf_dis-rule NO-LOCK WHERE
     2031                     buf_dis-rule.rule-num = v-rule-num NO-ERROR.
     2032           IF AVAILABLE buf_dis-rule THEN DO:
     2033             CREATE tt-dis-rule.
     2034             BUFFER-COPY buf_dis-rule TO tt-dis-rule
     2035             ASSIGN
     2036             tt-dis-rule.maria-rule-num = v-maria-rule-num.
     2037             RELEASE tt-dis-rule.
     2038           END.
     2039         END.
     2040       END.
     2041     END.
     2042   END.
     2043   FOR EACH temp-rank:
     2044     DELETE temp-rank.
     2045   END.
     2046   DO ii = 1 TO num-entries(drgdsrank):
     2047    CREATE temp-rank.
     2048    ASSIGN
     2049    temp-rank.subject = "gds"
     2050    temp-rank.id = ii
     2051    temp-rank.f-value = entry(2, ENTRY(ii, drgdsrank), chr(47))
     2052    temp-rank.f-label = entry(1, ENTRY(ii, drgdsrank), chr(47))
     2053    .
     2054    RELEASE temp-rank.
     2055   END.
     2056   DO ii = 1 TO num-entries(drgrouprank):
     2057    CREATE temp-rank.
     2058    ASSIGN
     2059    temp-rank.subject = "group"
     2060    temp-rank.id = ii
     2061    temp-rank.f-value = entry(2, ENTRY(ii, drgrouprank), '-')
     2062    temp-rank.f-label = entry(1, ENTRY(ii, drgrouprank), '-')
     2063    .
     2064    RELEASE temp-rank.
     2065   END.
     2066   DO ii = 1 TO num-entries(drcprank):
     2067    CREATE temp-rank.
     2068    ASSIGN
     2069    temp-rank.subject = "cp"
     2070    temp-rank.id = ii
     2071    temp-rank.f-value = entry(2, ENTRY(ii, drcprank), chr(47))
     2072    temp-rank.f-label = entry(1, ENTRY(ii, drcprank), chr(47))
     2073    .
     2074    RELEASE temp-rank.
     2075   END.
     2076   DO ii = 1 TO num-entries(drdcrank):
     2077    CREATE temp-rank.
     2078    ASSIGN
     2079    temp-rank.subject = "dc"
     2080    temp-rank.id = ii
     2081    temp-rank.f-value = entry(2, ENTRY(ii, drdcrank), chr(47))
     2082    temp-rank.f-label = entry(1, ENTRY(ii, drdcrank), chr(47))
     2083    .
     2084    RELEASE temp-rank.
     2085   END.
     2086     DISPLAY
     2087     l-dcgdsrank1
     2088     l-dcgrouprank1
     2089     l-dcgdsrank2
     2090     l-dcgrouprank2
     2091     l-dcgdsrank3
     2092     l-dcgrouprank3
     2093     l-dcgdsrank4
     2094     l-dcgrouprank
     2095     l-dcgdsrank5
     2096     l-dcgrouprank5
     2097     WITH FRAME Dialog-Frame.
     2098     ENABLE
     2099     B-exit WHEN p-mode <> 'ПРОСМОТР':U
     2100     b-quit
     2101     B-Help
     2102     B-lookup
     2103     BR-dis-rule
     2104     b-add-dr WHEN p-mode <> 'ПРОСМОТР':U
     2105     b-del-dr WHEN p-mode <> 'ПРОСМОТР':U
     2106     B-gds-up WHEN p-mode <> 'ПРОСМОТР':U
     2107     B-group-up  WHEN p-mode <> 'ПРОСМОТР':U
     2108     B-gds-down WHEN p-mode <> 'ПРОСМОТР':U
     2109     B-group-down WHEN p-mode <> 'ПРОСМОТР':U
     2110     BR-gds-rank
     2111     BR-group-rank
     2112     l-dcgdsrank1
     2113     l-dcgrouprank1
     2114     l-dcgdsrank2
     2115     l-dcgrouprank2
     2116     l-dcgdsrank3
     2117     l-dcgrouprank3
     2118     l-dcgdsrank4
     2119     l-dcgrouprank
     2120     l-dcgdsrank5
     2121     l-dcgrouprank5
     2122     WITH FRAME Dialog-Frame.
     2123     VIEW FRAME Dialog-Frame.
     2124     open query BR-dis-rule for each tt-dis-rule .
     2125     OPEN QUERY BR-gds-rank FOR EACH gds-temp-rank WHERE gds-temp-rank.subject = "gds".    OPEN QUERY BR-group-rank FOR EACH group-temp-rank WHERE group-temp-rank.subject = "group".
     2126   ASSIGN
     2127   FRAME Dialog-Frame:TITLE = substitute("&1 &2&3", FRAME Dialog-Frame:TITLE, p-obj-type, p-obj-code).
     2128   IF p-mode  = 'ПРОСМОТР':U THEN DO:
     2129       HIDE
     2130       b-exit
     2131       IN FRAME Dialog-Frame.
     2132       ASSIGN
     2133       b-quit:COLUMN = 1
     2134       b-quit:LABEL = "&Выход".
     2135   END.
     2136   END PROCEDURE.
     2137   PROCEDURE Openbr :
     2138   OPEN QUERY br-dis-rule FOR EACH tt-dis-rule SHARE-LOCK.
     2139   END PROCEDURE.
     2140   PROCEDURE proc-b-down :
     2141   DEFINE PARAMETER BUFFER br_temp-rank FOR temp-rank.
     2142   DEFINE INPUT PARAMETER p-subject AS CHARACTER NO-UNDO.
     2143   DEFINE VARIABLE v-new AS INTEGER NO-UNDO.
     2144   DEFINE VARIABLE v-old AS INTEGER NO-UNDO.
     2145   DEFINE BUFFER buf_temp-rank FOR temp-rank.
     2146   IF NOT AVAILABLE br_temp-rank THEN RETURN NO-APPLY.
     2147   FIND last buf_temp-rank WHERE  buf_temp-rank.subject = p-subject
     2148               USE-INDEX pi .
     2149    IF br_temp-rank.id = buf_temp-rank.id THEN DO:
     2150        BELL.
     2151        RETURN .
     2152    END.
     2153    ASSIGN
     2154    v-old = br_temp-rank.Id
     2155    v-new = br_temp-rank.id + 1
     2156    .
     2157    FIND FIRST buf_temp-rank WHERE
     2158               buf_temp-rank.subject = p-subject
     2159           AND buf_temp-rank.id = v-new NO-ERROR.
     2160    ASSIGN
     2161    br_temp-rank.id = 0.
     2162    RELEASE br_temp-rank.
     2163    buf_temp-rank.id = v-old.
     2164    RELEASE buf_temp-rank.
     2165    FIND FIRST buf_temp-rank WHERE
     2166               buf_temp-rank.subject = p-subject
     2167           AND buf_temp-rank.id = 0.
     2168    ASSIGN
     2169    buf_temp-rank.id = v-new.
     2170    RELEASE buf_temp-rank.
     2171   END PROCEDURE.
     2172   PROCEDURE proc-b-up :
     2173   DEFINE PARAMETER BUFFER br_temp-rank FOR temp-rank.
     2174   DEFINE INPUT PARAMETER p-subject AS CHARACTER NO-UNDO.
     2175   DEFINE VARIABLE v-new AS INTEGER NO-UNDO.
     2176   DEFINE VARIABLE v-old AS INTEGER NO-UNDO.
     2177   DEFINE BUFFER buf_temp-rank FOR temp-rank.
     2178    IF NOT AVAILABLE br_temp-rank THEN RETURN NO-APPLY.
     2179    IF br_temp-rank.id = 1 THEN DO:
     2180        BELL.
     2181        RETURN.
     2182    END.
     2183    ASSIGN
     2184    v-old = br_temp-rank.Id
     2185    v-new = br_temp-rank.id - 1
     2186    .
     2187    FIND FIRST buf_temp-rank WHERE
     2188               buf_temp-rank.subject = p-subject
     2189           AND buf_temp-rank.id = v-new NO-ERROR.
     2190    ASSIGN
     2191    br_temp-rank.id = 0.
     2192    RELEASE br_temp-rank.
     2193    buf_temp-rank.id = v-old.
     2194    RELEASE buf_temp-rank.
     2195    FIND FIRST buf_temp-rank WHERE
     2196               buf_temp-rank.subject = p-subject
     2197           AND buf_temp-rank.id = 0.
     2198    ASSIGN
     2199    buf_temp-rank.id = v-new.
     2200    RELEASE buf_temp-rank.
     2201   END PROCEDURE.
     2202   PROCEDURE proc-save :
     2203   DEFINE VARIABLE v-dr-list AS CHARACTER NO-UNDO.
     2204   DEFINE variable v-drgdsrank AS CHARACTER NO-UNDO.
     2205   DEFINE variable v-drgrouprank AS CHARACTER NO-UNDO.
     2206   DEFINE BUFFER buf_tt-dis-rule FOR tt-dis-rule.
     2207   DEFINE BUFFER buf_temp-rank FOR temp-rank.
     2208   FOR EACH buf_tt-dis-rule:
     2209     ASSIGN
     2210     v-dr-list = v-dr-list + (IF v-dr-list = '':U THEN '':U ELSE chr(44)) +
     2211                 string(buf_tt-dis-rule.rule-num) + '-' + string(buf_tt-dis-rule.maria-rule-num).
     2212   END.
     2213   FOR EACH buf_temp-rank
     2214   BY buf_temp-rank.subject
     2215   BY buf_temp-rank.id:
     2216   CASE BUF_TEMP-RANK.SUBJECT:
     2217           WHEN 'GDS' THEN DO:
     2218               V-DRGDSRANK = V-DRGDSRANK + (IF V-drgdsrank = '':U THEN '':U ELSE chr(44)) +
     2219                             buf_temp-rank.f-label + chr(47) + buf_temp-rank.f-value.
     2220           END.
     2221           WHEN 'Group' THEN DO:
     2222               V-DRGroupRANK = V-DRGroupRANK + (IF V-drgrouprank = '':U THEN '':U ELSE chr(44)) +
     2223                             buf_temp-rank.f-label + '-':U + buf_temp-rank.f-value.
     2224           END.
     2225     END CASE.
     2226   END.
     2227   ASSIGN
     2228   dr-list = v-dr-list
     2229   drgdsrank = v-drgdsrank
     2230   drgrouprank = v-drgrouprank
     2231   .
     2232   END PROCEDURE.
