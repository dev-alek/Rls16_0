      564   end procedure.
      565   procedure db-attr-delete :
      566     define input  parameter p-db-num   like ub.db-attr.db-num     no-undo .
      567     define input  parameter p-code     like ub.db-attr.attr-code  no-undo .
      568     define output parameter p-deleted  as logical no-undo.
      569     do
      570     on error undo, return error
      571     :
      572           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-delete in g#attr-lib
      573         (input  p-db-num
      574         ,input  p-code
      575         ,output p-deleted
      576         ) no-error .
      577       if error-status :error
      578       then do:
      579         undo, return error return-value .
      580       end.
      581     end.
      582   end procedure.
