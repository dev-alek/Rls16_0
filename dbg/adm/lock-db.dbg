      631   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      632   define new global shared variable g#lib-nws as handle no-undo .
      633   define input parameter p-db-num like ub.db.db-num no-undo .
      634   define input parameter p-action as   character    no-undo .
      635   define parameter buffer buf_db for ub.db .
      636   do
      637   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      638   on stop   undo, return error substitute( "&1. stop", vss-workfile )
      639   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      640   :
      641     define variable v-last-key  like ub.db.db-key no-undo .
      642     define variable v-attr-type as   character    no-undo .
      643     define variable v-lock      as   logical      no-undo .
      644     define variable v-msg       as   character    no-undo .
      645     define variable v-ok        as   logical      no-undo .
      646     find first buf_db exclusive-lock
      647       where buf_db.db-num = p-db-num
      648       no-wait no-error
      649     .
      650     if not available buf_db then do:
      651       if locked buf_db then do:
      652         return error substitute( "&1. Другой пользователь работает с базой данных &2!", vss-workfile, p-db-num ) .
      653       end.
      654       else do:
      655         return error substitute( "&1. База данных &2 не найдена!!!", vss-workfile, p-db-num ) .
      656       end.
      657     end.
      658     else do:
      659       case p-action :
      660         when "unload_db":U then do:
      661           case buf_db.stts :
      662             when 0 then do:
      663               assign
      664                 buf_db.stts = 2
      665               .
      666             end.
      667             when 2 then do:
      668               run db-attr-value ( input p-db-num
      669                                  ,input 'last-unload-db-key':U
      670                                  ,output v-last-key
      671                                  ,output v-attr-type
      672                                 ) no-error.
      673               if error-status :error then do:
      674                 return error substitute( "&1. Ошибка при чтении ключа для БД &2, с которым происходила последняя выгрузка!", vss-workfile, p-db-num ) .
      675               end.
      676               run del-db-key ( input v-last-key ).
      677               assign
      678                 v-lock = true
      679               .
      680   define variable vss-include-info4 as character format "X(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
      681   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_lock-route in g#lib-nws
      682     ( input  'unlock'
      683     , input  p-db-num
      684     , input  0
      685     , input  ''
      686     , output v-msg
      687     , output v-lock
      688     , output v-ok
      689     ) no-error .
      690               if error-status :error
      691                 or v-lock = true
      692                 or v-ok   = false
      693               then do:
      694                 return error substitute( "&1. &2&3&4", vss-workfile, v-msg, chr(10), return-value ) .
      695               end.
      696             end.
      697           end case.
      698         end.
      699       end case.
      700     end.
      701   end.
