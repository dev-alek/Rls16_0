      469     define output parameter p-label          as character no-undo .
      470     define output parameter p-user-can-edit  as logical   no-undo .
      471     define output parameter p-output-display as logical   no-undo .
      472     define output parameter p-other          as character no-undo .
      473     do
      474     on error undo, return error
      475     :
      476           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-code in g#attr-lib
      477         (input  p-code
      478         ,output p-type
      479         ,output p-format
      480         ,output p-label
      481         ,output p-user-can-edit
      482         ,output p-output-display
      483         ,output p-other
      484         ) no-error .
      485       if error-status :error
      486       then do:
      487         undo, return error return-value .
      488       end.
      489     end.
      490   end procedure.
