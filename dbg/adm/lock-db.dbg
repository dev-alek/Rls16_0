        1   block-level on error undo, throw.
        2   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   def var vss-author      as character no-undo init "$Author: expertek $":U .
        4   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   def var vss-workfile    as character no-undo init "$Workfile: lock-db.p $":U .
        6   def var vss-archive     as character no-undo init "$Archive: adm/lock-db.p $":U .
        7   def var vss-description as character no-undo init "Блокировка БД".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       67   Function reverse returns character (str as character).
       68      define variable rev_incl_s as character init "" no-undo .
       69      define variable rev_incl_i as integer no-undo .
       70      define variable rev_incl_l as integer no-undo .
       71      rev_incl_l = length(str).
       72      do rev_incl_i = 1 to rev_incl_l:
       73         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
       74      end.
       75      return rev_incl_s.
       76   end.
       77   procedure check-enc.
       78     define input  parameter p-db-num    as integer   no-undo .
       79     define input  parameter p-db-key    as character no-undo .
       80     define input  parameter p-code      as character no-undo .
       81     define input  parameter p-value     as character no-undo .
       82     define input  parameter p-beg-date  as date      no-undo .
       83     define input  parameter p-end-date  as date      no-undo .
       84     define input  parameter p-enc-value as character no-undo .
       85     define output parameter p-answer    as logical   no-undo .
       86     define variable tmp         as character no-undo .
       87     define variable v-enc-value as character no-undo .
       88     if p-db-num <> 0
       89       and p-db-key = "":U
       90     then do:
       91       assign
       92         p-answer = true
       93       .
       94       return.
       95     end.
       96     if p-db-key = "unload-db":U then do:
       97       assign
       98         p-answer = true
       99       .
      100       return.
      101     end.
      102     if p-code = ""  then do:
      103       assign
      104         tmp = string( p-db-num ) + reverse (p-db-key).
      105       .
      106     end.
      107     else do:
      108       assign
      109         tmp = string( p-db-num )
      110               + trim( p-db-key )
      111               + reverse( trim( p-code ) )
      112               + reverse( trim( p-value ) )
      113               + reverse( string( p-beg-date, "99.99.9999" ) )
      114               + reverse( string( p-end-date, "99.99.9999" ) )
      115       .
      116     end.
      117     run pswd-enc in this-procedure
      118       ( input tmp
      119        ,output v-enc-value
      120       ) no-error .
      121     if error-status:error then do:
      122       message
      123         vss-workfile vss-revision vss-description skip
      124         "Ошибка при вызове процедуры pswd-enc" skip
      125         return-value skip
      126         error-status :get-message(1) skip
      127         view-as alert-box error .
      128       undo, return error .
      129     end.
      130     if v-enc-value = p-enc-value then do:
      131       assign
      132         p-answer = true
      133       .
      134     end.
      135     else do:
      136       assign
      137         p-answer = false
      138       .
      139     end.
      140   end.
      141   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      142   procedure pswd-enc :
      143     define input parameter  pswd     as character no-undo .
      144     define output parameter enc-pswd as character no-undo .
      145     do
      146     on error undo, return error return-value
      147     :
      148       assign
      149         enc-pswd = encode(pswd + string(index(pswd, "k")))
      150       .
      151     end.
      152   end procedure.
      153   function diff-list returns character (
      154     input parfirst-list  as character,
      155     input parsecond-list as character,
      156     input pardelim       as character).
      157     if pardelim = ""
      158     or pardelim = ?
      159     then do:
      160       assign
      161         pardelim = ","
      162       .
      163     end.
      164     def var ind as integer no-undo .
      165     def var v-elem as character no-undo .
      166     def var v-result-list as character no-undo init "".
      167     def var v-num-parfirst-list as integer no-undo .
      168     assign
      169       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      170     .
      171     do ind = 1 to v-num-parfirst-list
      172     :
      173       assign
      174         v-elem = entry(ind, parfirst-list, pardelim)
      175       .
      176       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      177         assign
      178           v-result-list = v-result-list
      179                         + (if v-result-list > "" then pardelim else "")
      180                         + v-elem
      181         .
      182       end.
      183     end.
      184     return v-result-list .
      185   end function.
      186   function add-list returns character (
      187    input parfirst-list  as character,
      188    input parsecond-list as character,
      189    input pardelim       as character).
      190     if pardelim = ""
      191     or pardelim = ?
      192     then do:
      193       assign
      194         pardelim = ","
      195       .
      196     end.
      197     def var ind as integer no-undo .
      198     def var v-elem as character no-undo .
      199     def var v-result-list as character no-undo init "".
      200     def var v-num-parfirst-list as integer no-undo .
      201     assign
      202       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      203     .
      204     do ind = 1 to v-num-parfirst-list
      205     :
      206       assign
      207         v-elem = entry(ind, parfirst-list, pardelim)
      208       .
      209       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      210         assign
      211           v-result-list = v-result-list
      212                         + (if v-result-list > "" then pardelim else "")
      213                         + v-elem
      214         .
      215       end.
      216     end.
      217     def var v-num-parsecond-list as integer no-undo .
      218     assign
      219       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      220     .
      221     do ind = 1 to v-num-parsecond-list
      222     :
      223       assign
      224         v-elem = entry(ind, parsecond-list, pardelim)
      225       .
      226       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      227         assign
      228           v-result-list = v-result-list
      229                         + (if v-result-list > "" then pardelim else "")
      230                         + v-elem
      231         .
      232       end.
      233     end.
      234     return v-result-list .
      235   end function.
      236   function cross-list returns character (
      237    input parfirst-list  as character,
      238    input parsecond-list as character,
      239    input pardelim       as character).
      240     if pardelim = ""
      241     or pardelim = ?
      242     then do:
      243       assign
      244         pardelim = ","
      245       .
      246     end.
      247     def var ind as integer no-undo .
      248     def var v-elem as character no-undo .
      249     def var v-result-list as character no-undo init "".
      250     def var v-num-parfirst-list as integer no-undo .
      251     assign
      252       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      253     .
      254     do ind = 1 to v-num-parfirst-list
      255     :
      256       assign
      257         v-elem = entry(ind, parfirst-list, pardelim)
      258       .
      259       if lookup(v-elem, v-result-list, pardelim) = 0
      260       and lookup(v-elem, parsecond-list, pardelim) > 0
      261       then do:
      262         assign
      263           v-result-list = v-result-list
      264                         + (if v-result-list > "" then pardelim else "")
      265                         + v-elem
      266         .
      267       end.
      268     end.
      269     return v-result-list .
      270   end function.
      271   function radio-label returns character (
      272    input par-rs-value  as character,
      273    input par-rs-radio-buttons as character)
      274    .
      275    DEFINE variable v-result-label as character no-undo.
      276    assign
      277    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      278                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      279                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      280                             ), par-rs-radio-buttons
      281                           )
      282    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      283    .
      284   return v-result-label.
      285   end function.
      286   function m-radio-label returns character (
      287    input par-rs-value  as character,
      288    input par-rs-radio-buttons as character,
      289    input par-delim as character
      290    )
      291    .
      292    DEFINE variable v-result-label as character no-undo.
      293    assign
      294    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      295                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      296                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      297                             ), par-rs-radio-buttons, par-delim
      298                           )
      299    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      300    .
      301   return v-result-label.
      302   end function.
      303   FUNCTION mixlist returns character
      304   (
      305    input parfirst-list  as character
      306    ,input parsecond-list as character
      307    ,input pardelim       as character
      308    ,input pardelim-result as character ) :
      309     if pardelim = ""
      310     or pardelim = ?
      311     then do:
      312       assign
      313         pardelim = ","
      314       .
      315     end.
      316     def var ind as integer no-undo .
      317     def var v-elem1 as character no-undo .
      318     def var v-elem2 as character no-undo .
      319     def var v-result-list as character no-undo init "".
      320     do ind = 1 to num-entries(parfirst-list, pardelim)
      321     :
      322       assign
      323         v-elem1 = entry(ind, parfirst-list, pardelim)
      324         v-elem2 = entry(ind, parsecond-list, pardelim)
      325       .
      326         assign
      327           v-result-list = v-result-list
      328                         + (if v-result-list > "" then pardelim-result else "")
      329                         + v-elem1 + pardelim-result + v-elem2
      330         .
      331     end.
      332     return v-result-list .
      333   END FUNCTION.
      334   procedure save-db-key :
      335     define input parameter p-db-key like ub.db.db-key no-undo .
      336     do
      337     on error undo, return error
      338     :
      339       define buffer buf_rep for ub.rep .
      340       find buf_rep
      341         where buf_rep.rep-num = 1996011200
      342         no-error
      343       .
      344       if not available buf_rep then do:
      345         create buf_rep.
      346         assign
      347           buf_rep.rep-num = 1996011200
      348         .
      349       end.
      350       if lookup( p-db-key, buf_rep.name1 ) = 0 then do:
      351         assign
      352           buf_rep.name1 = buf_rep.name1 + ",":U + p-db-key
      353         .
      354       end.
      355     end.
      356   end procedure.
      357   procedure del-db-key :
      358     define input parameter p-db-key like ub.db.db-key no-undo .
      359     do
      360     on error undo, return error
      361     :
      362       define buffer buf_rep for ub.rep .
      363       define buffer buf_db  for ub.db .
      364       find first buf_db
      365         where buf_db.db-key = p-db-key
      366         no-error
      367       .
      368       if not available buf_db then do:
      369         find first buf_rep
      370           where buf_rep.rep-num = 1996011200
      371           no-error
      372         .
      373         if available buf_rep
      374           and lookup( p-db-key, buf_rep.name1 ) <> 0
      375         then do:
      376           assign
      377             buf_rep.name1 = diff-list( buf_rep.name1, p-db-key, ",":U )
      378           .
      379         end.
      380       end.
      381     end.
      382   end procedure.
      383   procedure chk-db-key :
      384     define input  parameter p-db-num     like ub.db.db-num     no-undo.
      385     define input  parameter p-db-key     like ub.db.db-key     no-undo.
      386     define input  parameter p-db-key-enc like ub.db.db-key-enc no-undo.
      387     define output parameter p-result     as   integer          no-undo .
      388     do
      389     on error undo, return error
      390     :
      391       define buffer buf_rep for ub.rep .
      392       define buffer buf_db  for ub.db .
      393       define variable v-ok as logical no-undo .
      394       if p-db-key = ?
      395         or p-db-key = ""
      396       then do:
      397         assign
      398           p-result = 1
      399         .
      400         return string("Не задано значение ключа БД.").
      401       end.
      402       if p-db-key-enc = ?
      403         or p-db-key-enc = ""
      404       then do:
      405         assign
      406           p-result = 2
      407         .
      408         return string("Не задано кодированное значение ключа БД.").
      409       end.
      410       find buf_rep
      411         where buf_rep.rep-num = 1996011200
      412         no-error
      413       .
      414       if not available buf_rep then do:
      415         create buf_rep.
      416         assign
      417           buf_rep.rep-num = 1996011200
      418         .
      419       end.
      420       for each buf_db no-lock
      421       on error undo, return error
      422       :
      423         if lookup( buf_db.db-key, buf_rep.name1 ) = 0 then do:
      424           assign
      425             buf_rep.name1 = buf_rep.name1 + ",":U + buf_db.db-key
      426           .
      427         end.
      428       end.
      429       assign
      430         p-result = 0
      431       .
      432       if lookup( p-db-key, buf_rep.name1 ) <> 0 then do:
      433         assign
      434           p-result = 1
      435         .
      436         return string("Данное значение ключа БД уже существует.").
      437       end.
      438       run check-enc in this-procedure
      439         ( input p-db-num
      440          ,input p-db-key
      441          ,input ""
      442          ,input ""
      443          ,input ?
      444          ,input ?
      445          ,input p-db-key-enc
      446          ,output v-ok
      447         ) no-error.
      448       if error-status:error then do:
      449         assign
      450           p-result = 1
      451         .
      452         return substitute( "Ошибка при проверке правильности кодирования. &1", error-status:get-message (1) ) .
      453       end.
      454       if v-ok <> true then do:
      455         assign
      456           p-result = 2
      457         .
      458         return string("Неверное кодированное значение ключа БД.").
      459       end.
      460     end.
      461   end procedure.
      462   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      463   define new global shared variable g#attr-lib  as handle no-undo .
      464   define variable v-attr-lib-variable as handle no-undo .
      465   procedure db-attr-code :
