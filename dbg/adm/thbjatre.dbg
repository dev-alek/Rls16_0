      476   on error undo, return error return-value
      477   :
      478       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_tooltip in g#attr-lib
      479       (input  p-upper-code
      480       ,input  p-code
      481       ,output p-tooltip
      482       ,output p-label
      483       ,output p-tooltip-code
      484       ) no-error .
