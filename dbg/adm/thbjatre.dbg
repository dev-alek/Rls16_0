      679   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      680   FUNCTION get-region RETURNS CHARACTER
      681     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      682     define variable par-region as character no-undo.
      683     if parhost-code = 0 and
      684          parobj-type = "":U and
      685          parobj-code = 0 then do:
      686          par-region = "Глобально".
      687          return par-region.
      688       end.
      689       if parobj-type = 'орг':U then do:
      690          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      691          return par-region.
      692       end.
      693       if parobj-type = 'регион':U
      694       then do:
      695          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      696          return par-region.
      697       end.
      698       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      699       return par-region.
      700   END FUNCTION.
      701   FUNCTION get-objregion RETURNS CHARACTER
      702     (  input parobj-type as character, input parobj-code as integer ) :
      703     define variable par-region as character no-undo.
      704     if  parobj-type = "":U and
      705         parobj-code = 0
      706     then do:
      707        par-region = "Глобально".
      708     end.
      709     else if parobj-type = 'орг':U
      710     then do:
      711        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      712     end.
      713     else if parobj-type = 'регион':U
      714     then do:
      715        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      716     end.
      717     else
      718        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      719     return par-region.
      720   END FUNCTION.
