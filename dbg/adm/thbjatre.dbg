      943   DEFINE BUTTON b-hist1
      944        LABEL "&История"
      945        SIZE 4 BY 1.
      946   DEFINE BUTTON B-lkp
      947        LABEL "&Просмотр"
      948        SIZE 10 BY 1.
      949   DEFINE BUTTON b-quit AUTO-END-KEY
      950        LABEL "&Выход"
      951        SIZE 10 BY 1
      952        BGCOLOR 8 .
      953   DEFINE IMAGE I-tooltip
      954        FILENAME "cmp/info.bmp":U
      955        SIZE 3 BY 1.04.
      956   DEFINE QUERY BR-2values FOR
      957         X_thbj-attr_2v SCROLLING.
      958   DEFINE QUERY BR-section FOR
      959         section_thbj-attr SCROLLING.
      960   DEFINE QUERY br-tree FOR
      961         X_thbj-attr SCROLLING.
      962   DEFINE QUERY BR-values FOR
      963         X_thbj-attr_v SCROLLING.
      964   DEFINE BROWSE BR-2values
      965     QUERY BR-2values NO-LOCK DISPLAY
      966         get-thbjattr-l-and-v( BUFFER X_thbj-attr_2v, OUTPUT v-2value) FORMAT "X(255)":U WIDTH 60 NO-LABEL
      967   v-2value FORMAT "X(255)" WIDTH 40  NO-LABEL
      968       WITH NO-ROW-MARKERS SEPARATORS SIZE 88 BY 6.5 FIT-LAST-COLUMN.
      969   DEFINE BROWSE BR-section
      970     QUERY BR-section NO-LOCK DISPLAY
      971         section_thbj-attr.upper-prop-name FORMAT "X(255)":U WIDTH 97 COLUMN-LABEL "Название секции"
      972   SECTION_thbj-attr.GLOBAL_ FORMAT "+/" COLUMN-LABEL "Глоб"
      973   SECTION_thbj-attr.region_ FORMAT "+/" COLUMN-LABEL "Рег"
      974   SECTION_thbj-attr.host_ FORMAT "+/" COLUMN-LABEL "Фирма"
      975   SECTION_thbj-attr.shop_ FORMAT "+/" COLUMN-LABEL "Маг"
      976   SECTION_thbj-attr.store_ FORMAT "+/" COLUMN-LABEL "Скл"
      977   SECTION_thbj-attr.db_ FORMAT "+/" COLUMN-LABEL "БД"
      978       WITH NO-ROW-MARKERS SEPARATORS SIZE 123 BY 10.5
      979            TITLE "Все имеющиеся в системе секции параметров" ROW-HEIGHT-CHARS .63.
      980   DEFINE BROWSE br-tree
      981     QUERY br-tree NO-LOCK DISPLAY
      982         get-objregion(X_thbj-attr.obj-type, X_thbj-attr.obj-code) FORMAT "X(20)" COLUMN-LABEL "Действует"
      983       WITH NO-ROW-MARKERS SEPARATORS SIZE 35 BY 14.25 ROW-HEIGHT-CHARS .75 FIT-LAST-COLUMN.
      984   DEFINE BROWSE BR-values
      985     QUERY BR-values NO-LOCK DISPLAY
      986         get-thbjattr-l-and-v( BUFFER X_thbj-attr_v, OUTPUT v-value) FORMAT "X(255)":U WIDTH 60 NO-LABEL
      987   v-value FORMAT "X(255)" WIDTH 40  NO-LABEL
      988       WITH NO-ROW-MARKERS SEPARATORS SIZE 88 BY 9
      989            TITLE "Значения параметров" ROW-HEIGHT-CHARS .58 FIT-LAST-COLUMN.
      990   DEFINE FRAME Dialog-Frame
      991        b-quit AT ROW 1 COL 1
      992        B-exp AT ROW 1 COL 41 WIDGET-ID 96
      993        B-Help AT ROW 1 COL 95
      994        BR-section AT ROW 2 COL 1 WIDGET-ID 200
      995        b-copy AT ROW 12.75 COL 1 WIDGET-ID 96
      996        B-add AT ROW 12.75 COL 11 WIDGET-ID 98
      997        B-chg AT ROW 12.75 COL 21 WIDGET-ID 2
      998        B-del AT ROW 12.75 COL 31 WIDGET-ID 4
      999        B-lkp AT ROW 12.75 COL 41 WIDGET-ID 6
     1000        b-load AT ROW 12.75 COL 108 WIDGET-ID 102
     1001        B-1 AT ROW 12.75 COL 114 WIDGET-ID 94
     1002        b-hist1 AT ROW 12.75 COL 120 WIDGET-ID 100
     1003        br-tree AT ROW 14 COL 1 WIDGET-ID 300
     1004        BR-values AT ROW 14 COL 36 WIDGET-ID 400
     1005        BR-2values AT ROW 21.75 COL 36 WIDGET-ID 500
     1006        I-tooltip AT ROW 12.75 COL 111 WIDGET-ID 10
     1007        SPACE(10.37) SKIP(14.62)
     1008       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1009            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1010            TITLE ""
     1011            CANCEL-BUTTON b-quit.
     1012   ASSIGN
     1013          FRAME Dialog-Frame:SCROLLABLE       = TRUE
     1014          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1015   ASSIGN
     1016          B-add:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-add:HANDLE.
     1017   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1018   DO:
     1019     APPLY "END-ERROR":U TO SELF.
     1020   END.
     1021   ON CHOOSE OF B-1 IN FRAME Dialog-Frame
     1022   DO:
     1023     IF NOT AVAILABLE X_thbj-attr_v THEN DO:
     1024       bell.
     1025     END.
     1026     run gbl/v-taobj.w
     1027         ( INPUT X_thbj-attr_v.upper-prop-code
     1028          ,INPUT X_thbj-attr_v.prop-code
     1029          ) NO-ERROR.
     1030   END.
     1031   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1032   DO:
     1033   DEFINE VARIABLE v-add-obj-type AS CHARACTER NO-UNDO.
     1034   DEFINE VARIABLE v-add-obj-code AS INTEGER NO-UNDO.
     1035   DEFINE BUFFER buf_thbj-attr FOR ub.thbj-attr.
     1036   IF NOT AVAILABLE section_thbj-attr THEN DO:
     1037   add-region = ''.
     1038      RETURN NO-APPLY.
     1039   END.
     1040   if add-region = '':U then do:
     1041      run gbl/pop-up.p ( input self:handle, input no) no-error.
     1042   end.
     1043   if add-region = '':U then return no-apply.
     1044   RUN proc-add IN THIS-PROCEDURE ( INPUT add-region
     1045                                    ,INPUT section_thbj-attr.upper-prop-code
     1046                                    ,OUTPUT v-add-obj-type
     1047                                    ,OUTPUT v-add-obj-code) NO-ERROR.
     1048    APPLY "VALUE-CHANGED" TO br-section.
     1049    IF v-add-obj-code > 0  THEN DO:
     1050       FIND FIRST buf_thbj-attr NO-LOCK WHERE
     1051                 buf_thbj-attr.upper-prop-code = section_thbj-attr.upper-prop-code
     1052            AND  buf_thbj-attr.obj-type = v-add-obj-type
     1053           AND  buf_thbj-attr.obj-code = v-add-obj-code NO-ERROR.
     1054       IF AVAILABLE buf_thbj-attr THEN DO:
     1055          REPOSITION br-tree TO RECID RECID(buf_thbj-attr) NO-ERROR.
     1056          APPLY "entry" TO br-tree.
     1057          APPLY "VALUE-CHANGED" TO br-tree.
     1058       END.
     1059    END.
     1060    ELSE DO:
     1061    END.
     1062   END.
     1063   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1064   DO:
     1065     define variable var-rec-id as recid no-undo.
     1066     IF AVAILABLE X_thbj-attr THEN do:
     1067        var-rec-id = recid (X_thbj-attr).
     1068        RUN proc-upd-lkp IN THIS-PROCEDURE ( INPUT 'ИЗМЕНЕНИЕ':U
     1069                                            ,INPUT X_thbj-attr.upper-prop-code
     1070                                            ,INPUT X_thbj-attr.obj-type
     1071                                            ,INPUT X_thbj-attr.obj-code) NO-ERROR.
     1072         APPLY "VALUE-CHANGED" TO br-section.
     1073         REPOSITION br-tree TO RECID var-rec-id NO-ERROR.
     1074         APPLY "entry" TO br-tree.
     1075         APPLY "VALUE-CHANGED" TO br-tree.
     1076     END.
     1077   END.
     1078   ON CHOOSE OF b-copy IN FRAME Dialog-Frame
     1079   DO:
     1080   if not available X_thbj-attr then return no-apply.
     1081   if X_thbj-attr.obj-type = ''
     1082   and X_thbj-attr.obj-code = 0 then do:
     1083     message
     1084     substitute("CКОПИРОВАТЬ ПАРАМЕТРЫ МОЖНО ТОЛЬКО С ОБЪЕКТА ТОГО ЖЕ ТИПА!!!&1&1&1" +
     1085                "НЕОТКУДА КОПИРОВАТЬ ГЛОБАЛЬНЫЕ ПАРАМЕТРЫ!!!"
     1086                , chr(10))
     1087     view-as alert-box error .
     1088     return no-apply.
     1089   end.
     1090   run proc-b-copy in this-procedure ( input X_thbj-attr.upper-prop-code
     1091                                      ,input X_thbj-attr.obj-type
     1092                                      ,input X_thbj-attr.obj-code ) no-error.
     1093   if error-status:error then do:
     1094     apply "ENTRY" to br-tree.
     1095     return no-apply.
     1096   end.
     1097   APPLY "VALUE-CHANGED" TO br-section.
     1098   END.
     1099   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1100   DO:
     1101   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     1102     IF AVAILABLE X_thbj-attr THEN DO:
     1103      IF X_thbj-attr.obj-type = '' THEN DO:
     1104        MESSAGE
     1105        "НЕЛЬЗЯ УДАЛИТЬ СЕКЦИЮ с областью действия ГЛОБАЛЬНО!"
     1106        VIEW-AS ALERT-BOX ERROR.
     1107        UNDO, RETURN NO-APPLY.
     1108      END.
     1109      MESSAGE
     1110      substitute("Вы действительно хотите удалить ВСЮ СЕКЦИЮ данного параметра с областью действия &1"
     1111                  , get-objregion(X_thbj-attr.obj-type, X_thbj-attr.obj-code))
     1112      VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     1113      IF NOT glog THEN RETURN NO-APPLY.
     1114      RUN thbjattr_delete-section  IN THIS-PROCEDURE (
     1115                                                       input  X_thbj-attr.obj-type
     1116                                                      ,INPUT X_thbj-attr.obj-code
     1117                                                      ,INPUT X_thbj-attr.upper-prop-code) NO-ERROR.
     1118      APPLY "VALUE-CHANGED" TO br-section.
     1119     END.
     1120   END.
     1121   ON CHOOSE OF B-exp IN FRAME Dialog-Frame
     1122   DO:
     1123     run utl/thbjexp.p ( INPUT parparentproc).
     1124   END.
     1125   ON CHOOSE OF b-hist1 IN FRAME Dialog-Frame
     1126   DO:
     1127   DEFINE VARIABLE v-rid-list AS CHARACTER no-undo.
     1128     IF AVAILABLE X_thbj-attr THEN DO:
     1129       run ref/cthbjatr.w (
     1130                          input parparentproc
     1131                         ,input v-cntxt-host-code-obj
     1132                         ,input v-cntxt-obj-type
     1133                         ,input v-cntxt-obj-code
     1134                         ,input ''
     1135                         ,input "section"
     1136                         ,input X_thbj-attr.obj-type
     1137                         ,input X_thbj-attr.obj-code
     1138                         ,input X_thbj-attr.upper-prop-code
     1139                         ,input X_thbj-attr.prop-code
     1140                         ,input ?
     1141                         ,input "":U
     1142                         ,input "":U
     1143                         ,input v-cntxt-db-num
     1144                         ,input-output v-rid-list  ) no-error .
     1145     END.
     1146   END.
     1147   ON CHOOSE OF b-load IN FRAME Dialog-Frame
     1148   DO:
     1149     define variable vFile      as character  no-undo.
     1150     define variable vCurRow    as integer no-undo.
     1151     define variable vSelectRow as logical no-undo.
     1152     define variable exlim      as class ibs.th.bge.execlimpexp no-undo.
     1153     define variable vExcelApp  as component-handle no-undo.
     1154     empty temp-table ttLoad.
     1155     vCurRow = br-values:focused-row.
     1156     if vCurRow = ? then
     1157     do:
     1158       message "Нет параметров для выгрузки." view-as alert-box.
     1159       return no-apply.
     1160     end.
     1161     vSelectRow = br-values:select-row(1).
     1162     do while vSelectRow:
     1163       if br-values:get-browse-column(1):screen-value <> "" then
     1164       do:
     1165         create ttLoad.
     1166         assign
     1167           ttLoad.fName  = br-values:get-browse-column(1):screen-value
     1168           ttLoad.fValue = br-values:get-browse-column(2):screen-value
     1169         .
     1170       end.
     1171       vSelectRow = br-values:select-next-row().
     1172     end.
     1173     br-values:select-row(vCurRow).
     1174     vFile = substitute(
     1175       "sec_&1_&2&3.txt",
     1176       section_thbj-attr.upper-prop-code,
     1177       X_thbj-attr.obj-type,
     1178       X_thbj-attr.obj-code
     1179     ).
     1180     output to value(vFile).
     1181     output close.
     1182     vFile = search(vFile).
     1183     exlim = new ibs.th.bge.execlimpexp ().
     1184     exlim:expToExcel(temp-table ttLoad:handle, vFile).
     1185     os-delete vFile value(vFile).
     1186     os-delete vFile value(search("last.dir")).
     1187     vFile = replace(vFile, ".txt", ".xlsx").
     1188     if search(vFile) <> ? then do:
     1189       create "Excel.Application":U vExcelApp no-error.
     1190       if error-status :error then do:
     1191         message "Не удалось открыть выгруженный файл" vFile "." view-as alert-box.
     1192       end.
     1193       else do:
     1194         vExcelApp:Workbooks:Open(vFile).
     1195         vExcelApp:Visible = TRUE.
     1196         release object vExcelApp.
     1197       end.
     1198     end.
     1199     else
     1200       message "Неизвестная ошибка при выгрузке." view-as alert-box.
     1201   END.
     1202   ON CHOOSE OF B-lkp IN FRAME Dialog-Frame
     1203   DO:
     1204       IF AVAILABLE X_thbj-attr THEN do:
     1205        RUN proc-upd-lkp IN THIS-PROCEDURE ( INPUT 'ПРОСМОТР':U
     1206                                            ,INPUT X_thbj-attr.upper-prop-code
     1207                                            ,INPUT X_thbj-attr.obj-type
     1208                                            ,INPUT X_thbj-attr.obj-code) NO-ERROR.
     1209     END.
     1210     else do:
     1211        message
     1212        "В БД секция параметров отсутствует!"
     1213        view-as alert-box .
     1214     end.
     1215   END.
     1216   ON VALUE-CHANGED OF BR-section IN FRAME Dialog-Frame
     1217   DO:
     1218     IF AVAILABLE sectioN_thbj-attr THEN DO:
     1219       RUN  Openbrtree IN THIS-PROCEDURE ( INPUT SECTION_thbj-attr.upper-prop-code).
     1220     END.
     1221     ELSE DO:
     1222       RUN  Openbrtree IN THIS-PROCEDURE ( INPUT '').
     1223     END.
     1224   END.
     1225   ON VALUE-CHANGED OF br-tree IN FRAME Dialog-Frame
     1226   DO:
     1227     IF AVAILABLE X_thbj-attr THEN DO:
     1228      RUN OpenBrValues IN THIS-PROCEDURE (
     1229                                           INPUT X_thbj-attr.upper-prop-code
     1230                                            ,INPUT X_thbj-attr.obj-type
     1231                                            ,INPUT X_thbj-attr.obj-code) NO-ERROR.
     1232     END.
     1233     ELSE DO:
     1234         RUN OpenBrValues IN THIS-PROCEDURE (
     1235                                              INPUT ''
     1236                                              ,INPUT ?
     1237                                              ,INPUT ?) no-error.
     1238     END.
     1239   END.
     1240   ON VALUE-CHANGED OF BR-values IN FRAME Dialog-Frame
     1241   DO:
     1242     IF AVAILABLE X_thbj-attr_v
     1243     AND X_thbj-attr_v.prop-value-type = 'void':U THEN DO:
     1244      ASSIGN
     1245      br-values:HEIGHT = 6.87.
     1246      BR-values:SCROLL-TO-CURRENT-ROW().
     1247      br-values:REFRESH().
     1248      RUN OpenBr2Values IN THIS-PROCEDURE (
     1249                                           INPUT X_thbj-attr_v.prop-code
     1250                                            ,INPUT X_thbj-attr_v.obj-type
     1251                                            ,INPUT X_thbj-attr_v.obj-code) NO-ERROR.
     1252         br-2values:VISIBLE = TRUE.
     1253         br-2values:REFRESH().
     1254         br-2values:move-to-top().
     1255     END.
     1256     ELSE DO:
     1257            ASSIGN
     1258            br-values:HEIGHT-CHARS = FRAME Dialog-Frame:HEIGHT-CHARS - 15.
     1259            br-values:move-to-top().
     1260            br-2values:VISIBLE = FALSE.
     1261            RUN OpenBr2Values IN THIS-PROCEDURE (
     1262                                              INPUT ''
     1263                                              ,INPUT ?
     1264                                              ,INPUT ?) no-error.
     1265     END.
     1266   END.
     1267   ON MOUSE-SELECT-CLICK OF I-tooltip IN FRAME Dialog-Frame
     1268   DO:
     1269   DEFINE VARIABLE v-tooltip AS CHARACTER NO-UNDO.
     1270   DEFINE VARIABLE v-label AS CHARACTER NO-UNDO.
     1271   DEFINE VARIABLE v-tooltip-code AS CHARACTER NO-UNDO.
     1272     IF NOT AVAILABLE X_thbj-attr_v THEN DO:
     1273       BELL.
     1274     END.
     1275     ELSE DO:
     1276   run thbjattr_tooltip in this-procedure (
     1277                input   X_thbj-attr_v.upper-prop-code
     1278               ,input  X_thbj-attr_v.prop-code
     1279               ,output v-tooltip
     1280               ,output v-label
     1281               ,output v-tooltip-code
     1282               ) no-error .
     1283      MESSAGE
     1284      v-tooltip SKIP
     1285      v-tooltip-code
     1286      VIEW-AS ALERT-BOX.
     1287     END.
     1288   END.
     1289   ON CHOOSE OF MENU-ITEM m_db
     1290   DO:
     1291     ASSIGN
     1292     add-region = 'БД':U.
     1293     APPLY "CHOOSE" to b-add  in frame Dialog-Frame.
     1294   END.
     1295   ON CHOOSE OF MENU-ITEM m_firm
     1296   DO:
     1297     ASSIGN
     1298     add-region = 'орг':U.
     1299     APPLY "CHOOSE" to b-add  in frame Dialog-Frame.
     1300   END.
     1301   ON CHOOSE OF MENU-ITEM m_shop
     1302   DO:
     1303     ASSIGN
     1304     add-region = 'маг':U.
     1305     APPLY "CHOOSE" to b-add  in frame Dialog-Frame.
     1306   END.
     1307   ON CHOOSE OF MENU-ITEM m_stock
     1308   DO:
     1309     ASSIGN
     1310     add-region = 'скл':U.
     1311     APPLY "CHOOSE" to b-add  in frame Dialog-Frame.
     1312   END.
     1313   ON CHOOSE OF MENU-ITEM m_region
     1314   DO:
     1315     ASSIGN
     1316     add-region = 'регион':U.
     1317     APPLY "CHOOSE" to b-add  in frame Dialog-Frame.
     1318   END.
     1319   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1320   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1321   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1322   on help of frame Dialog-Frame
     1323   do:
     1324     run gbl/app_help.p
     1325       (input this-procedure :file-name
     1326       ,input ''
     1327       ,input ?
     1328       ) no-error.
     1329     if error-status :error then do:
     1330       message
     1331         "Ошибка при вызове помощи"
     1332         error-status :get-message(1)
     1333         view-as alert-box .
     1334     end.
     1335   end.
     1336   run minbtn-set in this-procedure .
     1337   on choose of b-help in frame Dialog-Frame
     1338   do:
     1339     apply "help":u to frame Dialog-Frame .
     1340   end.
     1341   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1342   procedure minbtn-set :
     1343       do
     1344           on error undo, return error return-value
     1345           :
     1346           define variable ii              as integer       no-undo .
     1347           define variable fh              as widget-handle no-undo .
     1348           define variable hh              as widget-handle no-undo .
     1349           define variable v-h             as handle        extent 4 no-undo .
     1350           define variable v-name-button   as character     no-undo .
     1351           define variable v-help-old-x    as decimal       no-undo .
     1352           define variable v-help-old-y    as decimal       no-undo .
     1353           define variable v-help-old-size as decimal       no-undo .
     1354           define variable v-frame-width   as decimal       no-undo .
     1355           define variable jj              as integer       no-undo .
     1356           do
     1357               on error undo, return error
     1358               :
     1359               assign
     1360                   v-frame-width = frame Dialog-Frame:width - 0.3
     1361                   fh            = frame Dialog-Frame:first-child
     1362                   hh            = fh:first-child
     1363                   ii            = 1
     1364                   .
     1365               do while valid-handle(hh):
     1366                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1367                   do:
     1368                       case lc(hh:name) :
     1369                           when "b-help" then
     1370                               do:
     1371                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1372                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1373                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1374                                   hh:TOOLTIP = "Помощь" .
     1375                                   v-help-old-x = hh:column .
     1376                                   v-help-old-y = hh:row    .
     1377                                   v-help-old-size = hh:width .
     1378                                   hh:width-chars = 2.5 .
     1379                               end.
     1380                           when "b-print" then
     1381                               do:
     1382                                   hh:load-image("cmp/b-print.bmp":u) .
     1383                                   hh:TOOLTIP = "Печать" .
     1384                                   v-h[ii] = hh:handle .
     1385                                   ii = ii + 1 .
     1386                                   hh:width-chars = 3 .
     1387                               end.
     1388                           when "b-history" or
     1389                           when "b-hist" then
     1390                               do:
     1391                                   hh:load-image("cmp/b-hist.bmp":u) .
     1392                                   hh:TOOLTIP = "История" .
     1393                                   v-h[ii] = hh:handle .
     1394                                   ii = ii + 1 .
     1395                                   hh:width-chars = 3 .
     1396                               end.
     1397                           when "b-sch" then
     1398                               do:
     1399                                   hh:load-image("cmp/b-sch.bmp":u) .
     1400                                   hh:TOOLTIP = "Установка Фильтра" .
     1401                                   v-h[ii] = hh:handle .
     1402                                   ii = ii + 1 .
     1403                                   hh:width-chars = 3 .
     1404                               end.
     1405                           when "b-hist-user" then
     1406                               do:
     1407                                   hh:load-image("cmp/b-hist.bmp":u) .
     1408                                   hh:TOOLTIP = "История пользователя" .
     1409                                   ii = ii + 1 .
     1410                               end.
     1411                       end case.
     1412                   end.
     1413                   hh = hh:next-sibling.
     1414               end.
     1415               b-help:column = v-frame-width - b-help:width-chars.
     1416               jj = 0.
     1417               repeat ii = 4 to 1 by -1 :
     1418                   if valid-handle (v-h[ii] ) then
     1419                   do:
     1420                       jj  = jj + 1 .
     1421                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1422                       v-h[ii]:row    = v-help-old-y .
     1423                   end.
     1424               end.
     1425           end.
     1426       end.
     1427   end procedure.
     1428   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1429   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1430   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1431   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1432   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1433   define variable v-diasize-current-frame-height as decimal   no-undo .
     1434   define variable v-diasize-change-size          as logical   no-undo .
     1435   define variable v-diasize-resize-button        as handle    no-undo .
     1436   define variable v-diasize-wndmax               as logical   no-undo .
     1437   define variable v-diasize-wndstore             as logical   no-undo .
     1438   define variable v-diasize-proc-name            as character no-undo .
     1439   define variable v-diasize-browse-handle        as handle    no-undo .
     1440   define variable v-diasize-browse-number        as integer   no-undo .
     1441   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1442   define temp-table temp-diasize-handle no-undo
     1443     field handle-value  as handle
     1444     field save-position as decimal
     1445     index xpk is primary unique handle-value
     1446     .
     1447   define temp-table temp-browse-handle no-undo
     1448     field browse-type   as character
     1449     field browse-number as integer
     1450     field browse-handle as handle
     1451     field original-size as decimal
     1452     index xpk is primary unique browse-type browse-number
     1453     index xie browse-type browse-handle
     1454   .
     1455   procedure diasize_change-height :
     1456     define input  parameter p-change-value  as decimal   no-undo .
     1457     define input  parameter p-move-resize   as logical   no-undo .
     1458     define variable v-field-group-handle    as handle    no-undo .
     1459     define variable v-object-handle         as handle    no-undo .
     1460     define variable v-frame-height          as decimal   no-undo .
     1461     define variable v-frame-virtual-height  as decimal   no-undo .
     1462     define variable v-browse-height         as decimal   no-undo .
     1463     define variable v-window-height         as decimal   no-undo .
     1464     define variable v-window-virtual-height as decimal   no-undo .
     1465     define variable v-change-sign           as integer   no-undo .
     1466     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1467     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1468     if p-change-value > 0
     1469     then do:
     1470       if frame Dialog-Frame :height + p-change-value
     1471           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1472       then do:
     1473         assign
     1474           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1475                           - (frame Dialog-Frame :height-chars)
     1476         .
     1477         if p-change-value <= 0
     1478         then do:
     1479           run diasize_position-resize-button in this-procedure .
     1480           return .
     1481         end.
     1482       end.
     1483     end.
     1484     if p-change-value < 0
     1485     then do:
     1486       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1487       then do:
     1488         assign
     1489           p-change-value = v-diasize-orig-frame-height
     1490                          - (frame Dialog-Frame :height-chars)
     1491         .
     1492         if p-change-value >= 0
     1493         then do:
     1494           run diasize_position-resize-button in this-procedure .
     1495           return .
     1496         end.
     1497       end.
     1498     end.
     1499     if p-change-value >= 0
     1500     then do:
     1501       assign
     1502         v-change-sign = 1
     1503       .
     1504     end.
     1505     else do:
     1506       assign
     1507         v-change-sign = -1
     1508       .
     1509     end.
     1510     assign
     1511       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1512     .
     1513     if p-change-value = 0
     1514     then do:
     1515       run diasize_position-resize-button in this-procedure .
     1516       return .
     1517     end.
     1518     move_block:
     1519     do
     1520     on error undo move_block, retry move_block
     1521     :
     1522       if retry
     1523       then do:
     1524         do
     1525         on error undo move_block, leave move_block
     1526         :
     1527           if p-change-value > 0
     1528           then do:
     1529             for each buf_temp-diasize-handle
     1530             on error undo, next
     1531             :
     1532               assign
     1533                 v-object-handle = buf_temp-diasize-handle.handle-value
     1534               .
     1535               if v-object-handle <> v-diasize-resize-button
     1536               then do:
     1537                 assign
     1538                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1539                 .
     1540               end.
     1541             end.
     1542             assign
     1543               v-diasize-browse-handle :height = v-browse-height
     1544             .
     1545             for each buf_temp-browse-handle
     1546               where buf_temp-browse-handle.browse-type = 'height':u
     1547             on error undo, next
     1548             :
     1549               assign
     1550                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1551               .
     1552             end.
     1553             assign
     1554               frame Dialog-Frame :height = v-frame-height
     1555             .
     1556             if frame Dialog-Frame :scrollable = true
     1557             then do:
     1558               assign
     1559                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1560               .
     1561             end.
     1562             run diasize_position-resize-button in this-procedure .
     1563           end.
     1564           else do:
     1565             if frame Dialog-Frame :scrollable = true
     1566             then do:
     1567               assign
     1568                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1569               .
     1570             end.
     1571             assign
     1572               frame Dialog-Frame :height = v-frame-height
     1573             .
     1574             assign
     1575               v-diasize-browse-handle :height = v-browse-height
     1576             .
     1577             for each buf_temp-browse-handle
     1578               where buf_temp-browse-handle.browse-type = 'height':u
     1579             on error undo, next
     1580             :
     1581               assign
     1582                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1583               .
     1584             end.
     1585             for each buf_temp-diasize-handle
     1586             on error undo, next
     1587             :
     1588               assign
     1589                 v-object-handle = buf_temp-diasize-handle.handle-value
     1590               .
     1591               if v-object-handle <> v-diasize-resize-button
     1592               then do:
     1593                 assign
     1594                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1595                 .
     1596               end.
     1597             end.
     1598             run diasize_position-resize-button in this-procedure .
     1599           end.
     1600           assign
     1601             v-diasize-change-size = false
     1602           .
     1603           leave move_block .
     1604         end.
     1605       end.
     1606       assign
     1607         v-diasize-need-full-display = true
     1608       .
     1609       if v-diasize-change-size = false
     1610       then do:
     1611         assign
     1612           v-diasize-change-size = true
     1613         .
     1614       end.
     1615       else do:
     1616         return .
     1617       end.
     1618       assign
     1619         v-frame-height = frame Dialog-Frame :height
     1620         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1621         v-browse-height = v-diasize-browse-handle :height
     1622       .
     1623       for each buf_temp-browse-handle
     1624         where buf_temp-browse-handle.browse-type = 'height':u
     1625       :
     1626         assign
     1627           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1628         .
     1629       end.
     1630       for each buf_temp-diasize-handle
     1631       :
     1632         delete buf_temp-diasize-handle .
     1633       end.
     1634       assign
     1635         v-field-group-handle = frame Dialog-Frame :first-child
     1636       .
     1637       do while valid-handle(v-field-group-handle)
     1638       :
     1639         assign
     1640           v-object-handle = v-field-group-handle :first-child
     1641         .
     1642         do while valid-handle(v-object-handle)
     1643         :
     1644           if  v-object-handle <> v-diasize-browse-handle :handle
     1645           and can-query(v-object-handle, "row")
     1646           and can-query(v-object-handle, "height")
     1647           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1648           then do:
     1649             find first buf_temp-browse-handle
     1650               where buf_temp-browse-handle.browse-type   = 'height':u
     1651                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1652               no-error .
     1653             if available buf_temp-browse-handle
     1654             then do:
     1655             end.
     1656             else do:
     1657               create buf_temp-diasize-handle .
     1658               assign
     1659                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1660                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1661               .
     1662             end.
     1663           end.
     1664           assign
     1665             v-object-handle = v-object-handle :next-sibling
     1666           .
     1667         end.
     1668         assign
     1669           v-field-group-handle = v-field-group-handle :next-sibling
     1670         .
     1671       end.
     1672       do with frame Dialog-Frame
     1673       :
     1674         hide v-diasize-resize-button .
     1675         assign
     1676           v-diasize-resize-button :row    = 1
     1677           v-diasize-resize-button :column = 1
     1678         .
     1679       end.
     1680       if p-change-value > 0
     1681       then do:
     1682         if frame Dialog-Frame :scrollable = true
     1683         then do:
     1684           assign
     1685             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1686             no-error .
     1687           if error-status :error
     1688           or error-status :get-message(1) <> ""
     1689           then do:
     1690             undo move_block, retry move_block .
     1691           end.
     1692         end.
     1693         assign
     1694           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1695           no-error .
     1696         if error-status :error
     1697         or error-status :get-message(1) <> ""
     1698         then do:
     1699           undo move_block, retry move_block .
     1700         end.
     1701         assign
     1702           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1703           no-error .
     1704         if error-status :error
     1705         or error-status :get-message(1) <> ""
     1706         then do:
     1707           undo move_block, retry move_block .
     1708         end.
     1709         for each buf_temp-browse-handle
     1710           where buf_temp-browse-handle.browse-type = 'height':u
     1711         on error undo move_block, retry move_block
     1712         :
     1713           assign
     1714             buf_temp-browse-handle.browse-handle :height
     1715               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1716             no-error .
     1717           if error-status :error
     1718           or error-status :get-message(1) <> ""
     1719           then do:
     1720             undo move_block, retry move_block .
     1721           end.
     1722         end.
     1723         for each buf_temp-diasize-handle
     1724         on error undo move_block, retry move_block
     1725         :
     1726           assign
     1727             v-object-handle = buf_temp-diasize-handle.handle-value
     1728           .
     1729           if v-object-handle <> v-diasize-resize-button
     1730           then do:
     1731             assign
     1732               v-object-handle :row = v-object-handle :row + p-change-value
     1733               no-error .
     1734             if error-status :error
     1735             or error-status :get-message(1) <> ""
     1736             then do:
     1737               undo move_block, retry move_block .
     1738             end.
     1739           end.
     1740         end.
     1741       end.
     1742       else do:
     1743         for each buf_temp-diasize-handle
     1744         on error undo move_block, retry move_block
     1745         :
     1746           assign
     1747             v-object-handle = buf_temp-diasize-handle.handle-value
     1748           .
     1749           if v-object-handle <> v-diasize-resize-button
     1750           then do:
     1751             assign
     1752               v-object-handle :row = v-object-handle :row + p-change-value
     1753               no-error .
     1754             if error-status :error
     1755             or error-status :get-message(1) <> ""
     1756             then do:
     1757               undo move_block, retry move_block .
     1758             end.
     1759           end.
     1760         end.
     1761         assign
     1762           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1763           no-error .
     1764         if error-status :error
     1765         or error-status :get-message(1) <> ""
     1766         then do:
     1767           undo move_block, retry move_block .
     1768         end.
     1769         for each buf_temp-browse-handle
     1770           where buf_temp-browse-handle.browse-type = 'height':u
     1771         on error undo move_block, retry move_block
     1772         :
     1773           assign
     1774             buf_temp-browse-handle.browse-handle :height
     1775               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1776             no-error .
     1777           if error-status :error
     1778           or error-status :get-message(1) <> ""
     1779           then do:
     1780             undo move_block, retry move_block .
     1781           end.
     1782         end.
     1783         assign
     1784           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1785           no-error .
     1786         if error-status :error
     1787         or error-status :get-message(1) <> ""
     1788         then do:
     1789           undo move_block, retry move_block .
     1790         end.
     1791         if frame Dialog-Frame :scrollable = true
     1792         then do:
     1793           assign
     1794             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1795             no-error .
     1796           if error-status :error
     1797           or error-status :get-message(1) <> ""
     1798           then do:
     1799             undo move_block, retry move_block .
     1800           end.
     1801         end.
     1802       end.
     1803       if p-move-resize = true
     1804       then do:
     1805         run diasize_position-resize-button in this-procedure .
     1806       end.
     1807       if v-diasize-wndstore = true
     1808       then do:
     1809         if connected("ub") = true
     1810         then do:
     1811           define variable v-cntxt-db-num        as integer   no-undo .
     1812           define variable v-cntxt-userid        as character no-undo .
     1813           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1814                                             , OUTPUT v-cntxt-userid
     1815                                             ) .
     1816           run gbl/wndsizew.p
     1817             (input  v-cntxt-db-num
     1818             ,input  v-cntxt-userid
     1819             ,input  v-diasize-proc-name
     1820             ,input  'height':u
     1821             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1822             ) .
     1823         end.
     1824       end.
     1825     end.
     1826     assign
     1827       v-diasize-change-size = false
     1828     .
     1829   end procedure.
     1830   procedure diasize_set-height :
     1831     define input  parameter p-new-height  as decimal   no-undo .
     1832     define input  parameter p-move-resize as logical   no-undo .
     1833     do
     1834     on error undo, return error return-value
     1835     :
     1836       run diasize_change-height in this-procedure
     1837         (input  (p-new-height - frame Dialog-Frame :height)
     1838         ,input  p-move-resize
     1839         ) .
     1840     end.
     1841   end procedure.
     1842   procedure diasize_change-width :
     1843     define input  parameter p-change-value as decimal   no-undo .
     1844     define input  parameter p-move-resize  as logical   no-undo .
     1845     define variable v-field-group-handle   as handle    no-undo .
     1846     define variable v-object-handle        as handle    no-undo .
     1847     define variable v-frame-width          as decimal   no-undo .
     1848     define variable v-frame-virtual-width  as decimal   no-undo .
     1849     define variable v-browse-width         as decimal   no-undo .
     1850     define variable v-window-width         as decimal   no-undo .
     1851     define variable v-window-virtual-width as decimal   no-undo .
     1852     define variable v-change-sign          as integer   no-undo .
     1853     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1854     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1855     if p-change-value > 0
     1856     then do:
     1857       if frame Dialog-Frame :width + p-change-value >
     1858           session :width-chars
     1859       then do:
     1860         assign
     1861           p-change-value = session :width-chars - frame Dialog-Frame :width
     1862         .
     1863         if p-change-value <= 0
     1864         then do:
     1865           run diasize_position-resize-button in this-procedure .
     1866           return .
     1867         end.
     1868       end.
     1869     end.
     1870     if p-change-value < 0
     1871     then do:
     1872       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1873       then do:
     1874         assign
     1875           p-change-value = v-diasize-orig-frame-width
     1876                          - frame Dialog-Frame :width
     1877         .
     1878         if p-change-value >= 0
     1879         then do:
     1880           run diasize_position-resize-button in this-procedure .
     1881           return .
     1882         end.
     1883       end.
     1884     end.
     1885     if p-change-value >= 0
     1886     then do:
     1887       assign
     1888         v-change-sign = 1
     1889       .
     1890     end.
     1891     else do:
     1892       assign
     1893         v-change-sign = -1
     1894       .
     1895     end.
     1896     assign
     1897       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1898     .
     1899     if p-change-value = 0
     1900     then do:
     1901       run diasize_position-resize-button in this-procedure .
     1902       return .
     1903     end.
     1904     move_block:
     1905     do
     1906     on error undo move_block, leave move_block
     1907     :
     1908       if retry
     1909       then do:
     1910         do
     1911         on error undo move_block, leave move_block
     1912         :
     1913           if p-change-value > 0
     1914           then do:
     1915             for each buf_temp-diasize-handle
     1916             on error undo, next
     1917             :
     1918               assign
     1919                 v-object-handle = buf_temp-diasize-handle.handle-value
     1920               .
     1921               if v-object-handle <> v-diasize-resize-button
     1922               then do:
     1923                 assign
     1924                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1925                 .
     1926               end.
     1927             end.
     1928             assign
     1929               v-diasize-browse-handle :width = v-browse-width
     1930             .
     1931             for each buf_temp-browse-handle
     1932               where buf_temp-browse-handle.browse-type = 'width':u
     1933             on error undo, next
     1934             :
     1935               assign
     1936                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1937               .
     1938             end.
     1939             assign
     1940               frame Dialog-Frame :width = v-frame-width
     1941             .
     1942             if frame Dialog-Frame :scrollable = true
     1943             then do:
     1944               assign
     1945                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1946               .
     1947             end.
     1948             run diasize_position-resize-button in this-procedure .
     1949           end.
     1950           else do:
     1951             if frame Dialog-Frame :scrollable = true
     1952             then do:
     1953               assign
     1954                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1955               .
     1956             end.
     1957             assign
     1958               frame Dialog-Frame :width = v-frame-width
     1959             .
     1960             for each buf_temp-browse-handle
     1961               where buf_temp-browse-handle.browse-type = 'width':u
     1962             on error undo, next
     1963             :
     1964               assign
     1965                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1966               .
     1967             end.
     1968             assign
     1969               v-diasize-browse-handle :width = v-browse-width
     1970             .
     1971             for each buf_temp-diasize-handle
     1972             on error undo, next
     1973             :
     1974               assign
     1975                 v-object-handle = buf_temp-diasize-handle.handle-value
     1976               .
     1977               if v-object-handle <> v-diasize-resize-button
     1978               then do:
     1979                 assign
     1980                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1981                 .
     1982               end.
     1983             end.
     1984             run diasize_position-resize-button in this-procedure .
     1985           end.
     1986           assign
     1987             v-diasize-change-size = false
     1988           .
     1989           leave move_block .
     1990         end.
     1991       end.
     1992       assign
     1993         v-diasize-need-full-display = true
     1994       .
     1995       if v-diasize-change-size = false
     1996       then do:
     1997         assign
     1998           v-diasize-change-size = true
     1999         .
     2000       end.
     2001       else do:
     2002         return .
     2003       end.
     2004       assign
     2005         v-frame-width = frame Dialog-Frame :width
     2006         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2007         v-browse-width = v-diasize-browse-handle :width
     2008       .
     2009       for each buf_temp-browse-handle
     2010         where buf_temp-browse-handle.browse-type = 'width':u
     2011       :
     2012         assign
     2013           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2014         .
     2015       end.
     2016       for each buf_temp-diasize-handle
     2017       :
     2018         delete buf_temp-diasize-handle .
     2019       end.
     2020       assign
     2021         v-field-group-handle = frame Dialog-Frame :first-child
     2022       .
     2023       do while valid-handle(v-field-group-handle)
     2024       :
     2025         assign
     2026           v-object-handle = v-field-group-handle :first-child
     2027         .
     2028         do while valid-handle(v-object-handle)
     2029         :
     2030           if  v-object-handle <> v-diasize-browse-handle :handle
     2031           and v-object-handle <> v-diasize-resize-button
     2032           and can-query(v-object-handle, "row")
     2033           and can-query(v-object-handle, "height")
     2034           and ( v-object-handle :col + v-object-handle :width
     2035                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2036               )
     2037           then do:
     2038             find first buf_temp-browse-handle
     2039               where buf_temp-browse-handle.browse-type   = 'width':u
     2040                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2041               no-error .
     2042             if available buf_temp-browse-handle
     2043             then do:
     2044             end.
     2045             else do:
     2046               create buf_temp-diasize-handle .
     2047               assign
     2048                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2049                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2050               .
     2051             end.
     2052           end.
     2053           assign
     2054             v-object-handle = v-object-handle :next-sibling
     2055           .
     2056         end.
     2057         assign
     2058           v-field-group-handle = v-field-group-handle :next-sibling
     2059         .
     2060       end.
     2061       do with frame Dialog-Frame
     2062       :
     2063         hide v-diasize-resize-button .
     2064         v-diasize-resize-button :row = 1.
     2065         v-diasize-resize-button :column = 1.
     2066       end.
     2067       if p-change-value > 0
     2068       then do:
     2069         if frame Dialog-Frame :scrollable = true
     2070         then do:
     2071           assign
     2072             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2073             no-error .
     2074           if error-status :error
     2075           or error-status :get-message(1) <> ""
     2076           then do:
     2077             undo move_block, retry move_block.
     2078           end.
     2079         end.
     2080         assign
     2081           frame Dialog-Frame :width = v-frame-width + p-change-value
     2082           no-error .
     2083         if error-status :error
     2084         or error-status :get-message(1) <> ""
     2085         then do:
     2086           undo move_block, retry move_block.
     2087         end.
     2088         assign
     2089           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2090         no-error .
     2091         if error-status :error
     2092         or error-status :get-message(1) <> ""
     2093         then do:
     2094           undo move_block, retry move_block.
     2095         end.
     2096         for each buf_temp-browse-handle
     2097           where buf_temp-browse-handle.browse-type = 'width':u
     2098         on error undo move_block, retry move_block
     2099         :
     2100           assign
     2101             buf_temp-browse-handle.browse-handle :width
     2102               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2103             no-error .
     2104           if error-status :error
     2105           or error-status :get-message(1) <> ""
     2106           then do:
     2107             undo move_block, retry move_block .
     2108           end.
     2109         end.
     2110         for each buf_temp-diasize-handle
     2111         on error undo move_block, retry move_block
     2112         :
     2113           assign
     2114             v-object-handle = buf_temp-diasize-handle.handle-value
     2115           .
     2116           if v-object-handle <> v-diasize-resize-button
     2117           then do:
     2118             assign
     2119               v-object-handle :col = v-object-handle :col + p-change-value
     2120               no-error .
     2121             if error-status :error
     2122             or error-status :get-message(1) <> ""
     2123             then do:
     2124               undo move_block, retry move_block .
     2125             end.
     2126           end.
     2127         end.
     2128       end.
     2129       else do:
     2130         for each buf_temp-diasize-handle
     2131         on error undo move_block, retry move_block
     2132         :
     2133           assign
     2134             v-object-handle = buf_temp-diasize-handle.handle-value
     2135           .
     2136           if v-object-handle <> v-diasize-resize-button
     2137           then do:
     2138             assign
     2139               v-object-handle :col = v-object-handle :col + p-change-value
     2140               no-error .
     2141             if error-status :error
     2142             or error-status :get-message(1) <> ""
     2143             then do:
     2144               undo move_block, retry move_block .
     2145             end.
     2146           end.
     2147         end.
     2148         for each buf_temp-browse-handle
     2149           where buf_temp-browse-handle.browse-type = 'width':u
     2150         on error undo move_block, retry move_block
     2151         :
     2152           assign
     2153             buf_temp-browse-handle.browse-handle :width
     2154               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2155             no-error .
     2156           if error-status :error
     2157           or error-status :get-message(1) <> ""
     2158           then do:
     2159             undo move_block, retry move_block .
     2160           end.
     2161         end.
     2162         assign
     2163           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2164           no-error .
     2165         if error-status :error
     2166         or error-status :get-message(1) <> ""
     2167         then do:
     2168           undo move_block, retry move_block.
     2169         end.
     2170         assign
     2171           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2172         no-error .
     2173         if error-status :error
     2174         or error-status :get-message(1) <> ""
     2175         then do:
     2176           undo move_block, retry move_block.
     2177         end.
     2178         if frame Dialog-Frame :scrollable = true
     2179         then do:
     2180           assign
     2181             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2182           no-error .
     2183           if error-status :error
     2184           or error-status :get-message(1) <> ""
     2185           then do:
     2186             undo move_block, retry move_block.
     2187           end.
     2188         end.
     2189       end.
     2190       if p-move-resize
     2191       then do:
     2192         run diasize_position-resize-button in this-procedure .
     2193       end.
     2194       if v-diasize-wndstore = true
     2195       then do:
     2196         if connected("ub") = true
     2197         then do:
     2198           define variable v-cntxt-db-num        as integer   no-undo .
     2199           define variable v-cntxt-userid        as character no-undo .
     2200           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2201                                             , OUTPUT v-cntxt-userid
     2202                                             ) .
     2203           run gbl/wndsizew.p
     2204             (input  v-cntxt-db-num
     2205             ,input  v-cntxt-userid
     2206             ,input  v-diasize-proc-name
     2207             ,input  'width':u
     2208             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2209             ) .
     2210         end.
     2211       end.
     2212     end.
     2213     assign
     2214       v-diasize-change-size = false
     2215     .
     2216   end procedure.
     2217   procedure diasize_set-width :
     2218     define input  parameter p-new-width  as decimal   no-undo .
     2219     define input  parameter p-move-resize as logical   no-undo .
     2220     do
     2221     on error undo, return error return-value
     2222     :
     2223       run diasize_change-width in this-procedure
     2224         (input  (p-new-width - frame Dialog-Frame :width)
     2225         ,input  p-move-resize
     2226         ) .
     2227     end.
     2228   end procedure.
     2229   procedure diasize_position-resize-button :
     2230     do with frame Dialog-Frame
     2231     :
     2232       hide v-diasize-resize-button .
     2233       assign
     2234         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2235                     - 1
     2236                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2237         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2238                     - 1
     2239                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2240       .
     2241       view v-diasize-resize-button .
     2242     end.
     2243   end procedure.
     2244   on alt-right anywhere
     2245   do:
     2246     run diasize_change-width in this-procedure
     2247       (input 1
     2248       ,input true
     2249       ) .
     2250     return no-apply .
     2251   end.
     2252   on alt-left anywhere
     2253   do:
     2254     run diasize_change-width in this-procedure
     2255       (input -1
     2256       ,input true
     2257       ) .
     2258     return no-apply .
     2259   end.
     2260   on alt-down anywhere
     2261   do:
     2262     run diasize_change-height in this-procedure
     2263       (input 1
     2264       ,input true
     2265       ) .
     2266     return no-apply .
     2267   end.
     2268   on alt-up anywhere
     2269   do:
     2270     run diasize_change-height in this-procedure
     2271       (input -1
     2272       ,input true
     2273       ) .
     2274     return no-apply .
     2275   end.
     2276   on alt-enter of frame Dialog-Frame
     2277   do:
     2278     run diasize_maximize in this-procedure
     2279       (input  ?
     2280       ).
     2281     return no-apply .
     2282   end.
     2283   procedure diasize_end-move :
     2284     do
     2285     on error undo, return error return-value
     2286     :
     2287       define variable v-row-delta as decimal   no-undo .
     2288       define variable v-col-delta as decimal   no-undo .
     2289       define variable v-new-row as decimal   no-undo .
     2290       define variable v-new-col as decimal   no-undo .
     2291       assign
     2292         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2293         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2294       .
     2295       assign
     2296         v-row-delta = v-new-row - frame Dialog-Frame :height
     2297         v-col-delta = v-new-col - frame Dialog-Frame :width
     2298       .
     2299       run diasize_change-height in this-procedure
     2300         (input v-row-delta
     2301         ,input true
     2302         ) .
     2303       run diasize_change-width in this-procedure
     2304         (input v-col-delta
     2305         ,input true
     2306         ) .
     2307     end.
     2308   end procedure.
     2309   procedure diasize_maximize :
     2310     define input  parameter p-action as logical   no-undo .
     2311     do
     2312     on error undo, return error return-value
     2313     :
     2314       if p-action = ?
     2315       then do:
     2316         if v-diasize-need-maximize = true
     2317         then do:
     2318           assign
     2319             p-action = true
     2320           .
     2321         end.
     2322         else do:
     2323           assign
     2324             p-action = false
     2325           .
     2326         end.
     2327       end.
     2328       if p-action = true
     2329       then do:
     2330         run diasize_change-height in this-procedure
     2331           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2332               - frame Dialog-Frame :height-chars
     2333           ,input true
     2334           ) .
     2335         run diasize_change-width in this-procedure
     2336           (input session :width-chars
     2337               - frame Dialog-Frame :width-chars
     2338           ,input true
     2339           ) .
     2340         assign
     2341           v-diasize-need-maximize = false
     2342         .
     2343       end.
     2344       else do:
     2345         run diasize_change-width in this-procedure
     2346           (input v-diasize-orig-frame-width
     2347               - frame Dialog-Frame :width-chars
     2348           ,input true
     2349           ) .
     2350         run diasize_change-height in this-procedure
     2351           (input v-diasize-orig-frame-height
     2352               - frame Dialog-Frame :height-chars
     2353           ,input true
     2354           ) .
     2355         assign
     2356           v-diasize-need-maximize = true
     2357         .
     2358       end.
     2359     end.
     2360   end procedure.
     2361   procedure diasize_restore-orig-size :
     2362     do
     2363     on error undo, return error return-value
     2364     :
     2365       assign
     2366         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2367         v-diasize-current-frame-height = frame Dialog-Frame :height
     2368       .
     2369       run diasize_set-height in this-procedure
     2370         (input  v-diasize-orig-frame-height
     2371         ,input  true
     2372         ) .
     2373       run diasize_set-width in this-procedure
     2374         (input  v-diasize-orig-frame-width
     2375         ,input  true
     2376         ) .
     2377     end.
     2378   end procedure.
     2379   procedure diasize_restore-current-size :
     2380     do
     2381     on error undo, return error return-value
     2382     :
     2383       run diasize_set-height in this-procedure
     2384         (input  v-diasize-current-frame-height
     2385         ,input  true
     2386         ) .
     2387       run diasize_set-width in this-procedure
     2388         (input  v-diasize-current-frame-width
     2389         ,input  true
     2390         ) .
     2391     end.
     2392   end procedure.
     2393   procedure diasize_set-browse-handle :
     2394     define input  parameter p-browse-handle as handle   no-undo .
     2395     define buffer buf_temp-browse-handle for temp-browse-handle .
     2396     do
     2397     on error undo, return error return-value
     2398     :
     2399       assign
     2400         v-diasize-browse-handle = p-browse-handle
     2401       .
     2402       for each buf_temp-browse-handle
     2403       on error undo, return error return-value
     2404       :
     2405         delete buf_temp-browse-handle .
     2406       end.
     2407     end.
     2408   end procedure.
     2409   procedure diasize_add_browse :
     2410     define input  parameter p-browse-type   as character no-undo .
     2411     define input  parameter p-browse-handle as handle    no-undo .
     2412     define buffer buf_temp-browse-handle for temp-browse-handle .
     2413     do
     2414     on error undo, return error return-value
     2415     :
     2416       assign
     2417         v-diasize-browse-number = v-diasize-browse-number + 1
     2418       .
     2419       create buf_temp-browse-handle .
     2420       assign
     2421         buf_temp-browse-handle.browse-type   = p-browse-type
     2422         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2423         buf_temp-browse-handle.browse-handle = p-browse-handle
     2424       .
     2425     end.
     2426   end procedure.
     2427   procedure diasize_init :
     2428     define variable v-default-value    as logical   no-undo .
     2429     define variable v-restore-saved    as logical   no-undo .
     2430     define variable v-resize-value-str as character no-undo .
     2431     do
     2432     on error undo, return error return-value
     2433     :
     2434       do with frame Dialog-Frame
     2435       :
     2436         assign
     2437           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2438           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2439           v-diasize-browse-handle     = browse BR-values :handle
     2440         .
     2441         create button v-diasize-resize-button
     2442         assign
     2443           parent        = frame Dialog-Frame :first-child
     2444           label         = "s"
     2445           height-pixels = 16
     2446           width-pixels  = 16
     2447           visible       = true
     2448           sensitive     = true
     2449           movable       = true
     2450           triggers:
     2451             on end-move persistent run diasize_end-move in this-procedure .
     2452           end triggers.
     2453         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2454         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2455         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2456         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2457         assign
     2458           v-diasize-wndmax = false
     2459         .
     2460         if connected("ub") = true
     2461         then do:
     2462           define variable v-cntxt-db-num        as integer   no-undo .
     2463           define variable v-cntxt-userid        as character no-undo .
     2464           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2465                                             , OUTPUT v-cntxt-userid
     2466                                             ) .
     2467           run gbl/wndpar_r.p
     2468             (input  v-cntxt-db-num
     2469             ,input  v-cntxt-userid
     2470             ,input  'wndmax':U
     2471             ,output v-diasize-wndmax
     2472             ,output v-default-value
     2473             ) .
     2474         end.
     2475         assign
     2476           v-diasize-wndstore = false
     2477         .
     2478         if connected("ub") = true
     2479         then do:
     2480           run gbl/wndpar_r.p
     2481             (input  v-cntxt-db-num
     2482             ,input  v-cntxt-userid
     2483             ,input  'wndstore':U
     2484             ,output v-diasize-wndstore
     2485             ,output v-default-value
     2486             ) .
     2487         end.
     2488         assign
     2489           v-diasize-proc-name = entry(1, program-name(2), '.')
     2490         .
     2491         if v-diasize-wndstore = true
     2492         then do:
     2493           assign
     2494             v-restore-saved = false
     2495           .
     2496           if connected("ub") = true
     2497           then do:
     2498             run gbl/wndsizer.p
     2499               (input  v-cntxt-db-num
     2500               ,input  v-cntxt-userid
     2501               ,input  v-diasize-proc-name
     2502               ,input  'height':u
     2503               ,output v-resize-value-str
     2504               ) .
     2505             if v-resize-value-str <> '':U
     2506             then do:
     2507               run diasize_change-height in this-procedure
     2508                 (input  integer(v-resize-value-str)
     2509                 ,input  true
     2510                 ) .
     2511               assign
     2512                 v-restore-saved = true
     2513               .
     2514             end.
     2515           end.
     2516           if connected("ub") = true
     2517           then do:
     2518             run gbl/wndsizer.p
     2519               (input  v-cntxt-db-num
     2520               ,input  v-cntxt-userid
     2521               ,input  v-diasize-proc-name
     2522               ,input  'width':u
     2523               ,output v-resize-value-str
     2524               ) .
     2525             if v-resize-value-str <> '':U
     2526             then do:
     2527               run diasize_change-width in this-procedure
     2528                 (input  integer(v-resize-value-str)
     2529                 ,input  true
     2530                 ) .
     2531               assign
     2532                 v-restore-saved = true
     2533               .
     2534             end.
     2535           end.
     2536           if v-restore-saved <> true
     2537           then do:
     2538             if v-diasize-wndmax = true
     2539             then do:
     2540               run diasize_maximize in this-procedure
     2541                 (input  true
     2542                 ) .
     2543             end.
     2544           end.
     2545         end.
     2546         else do:
     2547           if v-diasize-wndmax = true
     2548           then do:
     2549             run diasize_maximize in this-procedure
     2550               (input  true
     2551               ) .
     2552           end.
     2553         end.
     2554       end.
     2555     end.
     2556   end procedure.
     2557   procedure diasize_need-full-display :
     2558     define output parameter p-need-full-display as logical   no-undo .
     2559     do
     2560     on error undo, return error return-value
     2561     :
     2562       assign
     2563         p-need-full-display = v-diasize-need-full-display
     2564       .
     2565       assign
     2566         v-diasize-need-full-display = false
     2567       .
     2568     end.
     2569   end procedure.
     2570   procedure get-context :
     2571      define output parameter p-db-num as integer          no-undo.
     2572      define output parameter p-user-id as character        no-undo.
     2573      define variable v-login               as character    no-undo.
     2574      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2575      define buffer buf_user-login  for ub.user-login .
     2576      do
     2577      on error undo, return error
     2578      :
     2579            FIND FIRST buf_sys-ctrl no-lock.
     2580            ASSIGN
     2581               v-login = USERID("ub")
     2582               p-db-num = buf_sys-ctrl.db-num
     2583            .
     2584            FIND FIRST buf_user-login
     2585                 WHERE buf_user-login.db-num = p-db-num
     2586                   AND buf_user-login.user-login = v-login
     2587                 no-lock
     2588                 no-error
     2589                 .
     2590            IF AVAILABLE buf_user-login
     2591            THEN DO:
     2592               assign
     2593                  p-user-id = buf_user-login.user-id
     2594               .
     2595            END.
     2596      end.
     2597   end procedure.
     2598       run diasize_init in this-procedure .
     2599   run diasize_add_browse in this-procedure
     2600     (input  'width':u
     2601     ,input  browse BR-2values :handle
     2602     ) .
     2603   run diasize_add_browse in this-procedure
     2604     (input  'height':u
     2605     ,input  browse BR-2values :handle
     2606     ) .
     2607   run diasize_init in this-procedure .
     2608   MAIN-BLOCK:
     2609   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2610      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2611   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2612     run mainmenu_getcntxt in parparentproc
     2613       (output v-cntxt-db-num
     2614       ,output v-cntxt-userid
     2615       ,output v-cntxt-level
     2616       ,output v-cntxt-host-code-obj
     2617       ,output v-cntxt-obj-type
     2618       ,output v-cntxt-obj-code
     2619       ,output v-cntxt-db-num-obj
     2620       ,output v-cntxt-is-admin
     2621       ) .
     2622     RUN fill-section IN THIS-PROCEDURE.
     2623     RUN MYENABLE IN THIS-PROCEDURE.
     2624     WAIT-FOR GO OF FRAME Dialog-Frame.
     2625   END.
     2626   RUN disable_UI.
     2627   PROCEDURE disable_UI :
     2628     HIDE FRAME Dialog-Frame.
     2629   END PROCEDURE.
     2630   PROCEDURE enable_UI :
     2631     ENABLE b-quit B-exp B-Help I-tooltip BR-section b-copy B-add B-chg B-del
     2632            B-lkp B-1 b-hist1 br-tree BR-values BR-2values b-load
     2633         WITH FRAME Dialog-Frame.
     2634     VIEW FRAME Dialog-Frame.
     2635     OPEN QUERY BR-section FOR EACH section_thbj-attr NO-LOCK INDEXED-REPOSITION.
     2636   END PROCEDURE.
     2637   PROCEDURE fill-section :
     2638   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     2639   define variable v-label as character no-undo .
     2640   define variable v-user-can-edit as logical no-undo .
     2641   define variable v-output-display as logical no-undo .
     2642   define variable v-other as char no-undo .
     2643   define variable v-host as logical no-undo .
     2644   define variable v-shop as logical no-undo .
     2645   define variable v-store as logical no-undo .
     2646   define variable v-global as logical no-undo .
     2647   define variable v-db as logical no-undo .
     2648   define variable v-region as logical no-undo .
     2649   define variable v-prop-list as character no-undo .
     2650   define variable v-prop-type-list as character no-undo .
     2651   define variable v-prop-label-list as character no-undo .
     2652   DEFINE BUFFER buf_section FOR SECTION_thbj-attr.
     2653   FOR EACH buf_SECTION:
     2654     DELETE buf_SECTION.
     2655   END.
     2656   DO v-ii = 1 TO NUM-ENTRIES('autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-maria,cd-type-autotank,arh-global,nakl-glob,nakl_par,contr-in,rt-trn-doc,overval,inv-global,inv-obj,rezerv-global,rezerv-obj,ord-global,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,prt-firm,prt-obj,report-glob,report-firm,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U):
     2657      RUN thbjattr_code_reg IN THIS-PROCEDURE (
     2658                                            input ENTRY(v-ii, 'autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-maria,cd-type-autotank,arh-global,nakl-glob,nakl_par,contr-in,rt-trn-doc,overval,inv-global,inv-obj,rezerv-global,rezerv-obj,ord-global,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,prt-firm,prt-obj,report-glob,report-firm,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U)
     2659                                           ,input ''
     2660                                           ,OUTPUT v-label
     2661                                           ,OUTPUT v-user-can-edit
     2662                                           ,OUTPUT v-output-display
     2663                                           ,OUTPUT v-other
     2664                                           ,OUTPUT v-prop-list
     2665                                           ,OUTPUT v-prop-type-list
     2666                                           ,OUTPUT v-prop-label-list
     2667                                           ,OUTPUT v-global
     2668                                           ,OUTPUT v-host
     2669                                           ,OUTPUT v-shop
     2670                                           ,OUTPUT v-store
     2671                                           ,OUTPUT v-db
     2672                                           ,OUTPUT v-region
     2673                                           ) NO-ERROR.
     2674     IF v-user-can-edit
     2675     and index(v-other, "spr-ext=") > 0 THEN DO:
     2676         CREATE buf_SECTION.
     2677         ASSIGN
     2678         buf_SECTION.upper-prop-code = ENTRY(v-ii, 'autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-maria,cd-type-autotank,arh-global,nakl-glob,nakl_par,contr-in,rt-trn-doc,overval,inv-global,inv-obj,rezerv-global,rezerv-obj,ord-global,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,prt-firm,prt-obj,report-glob,report-firm,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U)
     2679         buf_SECTION.upper-prop-name = v-label
     2680         buf_SECTION.GLOBAL_ = v-global
     2681         buf_SECTION.host_ = v-host
     2682         buf_SECTION.shop_ = v-shop
     2683         buf_SECTION.store_ = v-store
     2684         buf_SECTION.db_ = v-db
     2685         buf_SECTION.region_ = v-region
     2686         .
     2687     END.
     2688   END.
     2689   END PROCEDURE.
     2690   PROCEDURE init-tt :
     2691   DEFINE INPUT PARAMETER p-upper-prop-code AS CHARACTER NO-UNDO.
     2692   DEFINE VARIABLE v-host-code AS INTEGER NO-UNDO.
     2693   DEFINE VARIABLE v-region-code AS INTEGER NO-UNDO.
     2694   DEFINE VARIABLE v-db-attr-type AS CHARACTER NO-UNDO.
     2695   define buffer buf_thbj-attr for ub.thbj-attr .
     2696   empty TEMP-TABLE  x_thbj-attr .
     2697   for each buf_thbj-attr no-lock where
     2698            buf_thbj-attr.upper-prop-code = p-upper-prop-code
     2699        AND (buf_thbj-attr.prop-code       = ''
     2700             OR buf_thbj-attr.prop-value-type = 'void':U)
     2701       :
     2702     find first x_thbj-attr where
     2703                 x_thbj-attr.obj-type = buf_thbj-attr.obj-type and
     2704                 x_thbj-attr.obj-code = buf_thbj-attr.obj-code no-error .
     2705     if not available x_thbj-attr then do:
     2706       create  x_thbj-attr.
     2707       BUFFER-COPY buf_thbj-attr TO X_thbj-attr.
     2708     end.
     2709     if buf_thbj-attr.obj-type  = "" THEN DO:
     2710       assign
     2711       x_thbj-attr.ind1 =  "0" + string( 0,"999999999") + "   " + string( 0 ,"999999999" )
     2712       .
     2713     END.
     2714     else if buf_thbj-attr.obj-type  = 'орг':U THEN DO:
     2715       assign
     2716       x_thbj-attr.ind1 =  "0" + string(buf_thbj-attr.obj-code,"999999999") + "   " + string( 0 ,"999999999" )
     2717       .
     2718     END.
     2719     else if buf_thbj-attr.obj-type  = 'регион':U THEN DO:
     2720       assign
     2721       x_thbj-attr.ind1 =  "0" + string(buf_thbj-attr.obj-code,"999999999") + "   " + string( 0 ,"999999999" )
     2722       .
     2723     END.
     2724     ELSE IF buf_thbj-attr.obj-type = 'БД':U THEN DO:
     2725         run db-attr-value in this-procedure (buf_thbj-attr.obj-code,
     2726                                              "reg-code",
     2727                                              output v-region-code,
     2728                                              output v-db-attr-type) no-error.
     2729         if v-region-code = ? then v-region-code = 0.
     2730         x_thbj-attr.ind1 =  "0" + string(v-region-code,"999999999") + "region" + string(buf_thbj-attr.obj-code ,":999999999" ).
     2731     END.
     2732     else do:
     2733   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2734   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2735     (input  buf_thbj-attr.obj-type
     2736     ,input  buf_thbj-attr.obj-code
     2737     ,output v-host-code
     2738     )  .
     2739        x_thbj-attr.ind1 =  "0" + string(v-host-code,"999999999") + buf_thbj-attr.obj-type + string(buf_thbj-attr.obj-code ,"999999999" ).
     2740      end.
     2741   END.
     2742   END PROCEDURE.
     2743   PROCEDURE MyEnable :
     2744   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     2745   assign
     2746   b-add:menu-mouse in frame Dialog-Frame  = 1
     2747   section_thbj-attr.upper-prop-name:RESIZABLE IN BROWSE br-section = YES
     2748       .
     2749   DO v-ii = 1 TO BROWSE br-values:NUM-COLUMNS:
     2750     ASSIGN
     2751     BROWSE br-values:GET-BROWSE-COLUMN(v-ii):RESIZABLE = YES.
     2752   END.
     2753   b-hist1:load-image("cmp/b-hist.bmp":u) .
     2754   b-hist1:TOOLTIP = "&История" .
     2755   DO v-ii = 1 TO BROWSE br-2values:NUM-COLUMNS:
     2756     ASSIGN
     2757     BROWSE br-2values:GET-BROWSE-COLUMN(v-ii):RESIZABLE = YES.
     2758   END.
     2759   br-values:height IN FRAME Dialog-Frame = 12.85.
     2760   ENABLE
     2761   b-quit
     2762   B-Help
     2763   BR-section
     2764   B-copy WHEN LOOKUP("b-chg", bttns) > 0 AND g#db-num = 0 AND NOT TRANSACTION
     2765   B-chg WHEN LOOKUP("b-chg", bttns) > 0 AND g#db-num = 0 AND NOT TRANSACTION
     2766   B-del WHEN LOOKUP("b-chg", bttns) > 0 AND g#db-num = 0 AND NOT TRANSACTION
     2767   b-add WHEN LOOKUP("b-chg", bttns) > 0 AND g#db-num = 0 AND NOT TRANSACTION
     2768   b-exp WHEN g#db-num = 0
     2769   b-lkp
     2770   b-1
     2771   b-hist1
     2772   BR-values
     2773   br-2values
     2774   br-tree
     2775   i-tooltip
     2776   b-load
     2777   WITH FRAME Dialog-Frame.
     2778   VIEW FRAME Dialog-Frame.
     2779   OPEN QUERY BR-section FOR EACH section_thbj-attr NO-LOCK INDEXED-REPOSITION.
     2780   APPLY "ENTRY" TO br-section.
     2781   APPLY "VALUE-CHANGED" TO br-section.
     2782   END PROCEDURE.
     2783   PROCEDURE Openbr2values :
     2784   DEFINE INPUT PARAMETER p-upper-prop-code AS CHARACTER NO-UNDO.
     2785   DEFINE INPUT PARAMETER p-obj-type AS CHARACTER NO-UNDO.
     2786   DEFINE INPUT PARAMETER p-obj-code AS integer NO-UNDO.
     2787   IF p-upper-prop-code = '' THEN DO:
     2788       OPEN QUERY br-2values
     2789       FOR EACH X_thbj-attr_2v NO-LOCK WHERE  FALSE INDEXED-REPOSITION.
     2790   END.
     2791   ELSE DO:
     2792       OPEN QUERY br-2values
     2793       FOR EACH X_thbj-attr_2v NO-LOCK WHERE
     2794              X_thbj-attr_2v.upper-prop-code = p-upper-prop-code
     2795           AND X_thbj-attr_2v.obj-type = p-obj-type
     2796           AND X_thbj-attr_2v.obj-code = p-obj-code
     2797           AND X_thbj-attr_2v.prop-code > ''
     2798           INDEXED-REPOSITION.
     2799   END.
     2800   END PROCEDURE.
     2801   PROCEDURE OpenBrtree :
     2802   DEFINE INPUT PARAMETER p-upper-prop-code AS CHARACTER NO-UNDO.
     2803   define variable v-label as character no-undo .
     2804   define variable v-user-can-edit as logical no-undo .
     2805   define variable v-output-display as logical no-undo .
     2806   define variable v-other as char no-undo .
     2807   define variable v-host as logical no-undo .
     2808   define variable v-shop as logical no-undo .
     2809   define variable v-store as logical no-undo .
     2810   define variable v-global as logical no-undo .
     2811   define variable v-db as logical no-undo .
     2812   define variable v-region as logical no-undo .
     2813   define variable v-prop-list as character no-undo .
     2814   define variable v-prop-type-list as character no-undo .
     2815   define variable v-prop-label-list as character no-undo .
     2816   RUN thbjattr_code_reg IN THIS-PROCEDURE (
     2817                                         input p-upper-prop-code
     2818                                       ,input ''
     2819                                       ,OUTPUT v-label
     2820                                       ,OUTPUT v-user-can-edit
     2821                                       ,OUTPUT v-output-display
     2822                                       ,OUTPUT v-other
     2823                                       ,OUTPUT v-prop-list
     2824                                       ,OUTPUT v-prop-type-list
     2825                                       ,OUTPUT v-prop-label-list
     2826                                       ,OUTPUT v-global
     2827                                       ,OUTPUT v-host
     2828                                       ,OUTPUT v-shop
     2829                                       ,OUTPUT v-store
     2830                                       ,output v-db
     2831                                       ,output v-region
     2832                                       ) NO-ERROR.
     2833   assign
     2834   menu-item m_firm:sensitive in menu menu-b-add = v-host
     2835   menu-item m_shop:sensitive in menu menu-b-add = v-shop
     2836   menu-item m_stock:sensitive in menu menu-b-add = v-store
     2837   menu-item m_db:sensitive in menu menu-b-add = v-db
     2838   menu-item m_region:sensitive in menu menu-b-add = v-region
     2839   .
     2840   RUN init-tt IN THIS-PROCEDURE ( INPUT p-upper-prop-code) NO-ERROR.
     2841   OPEN QUERY br-tree
     2842   FOR EACH X_thbj-attr NO-LOCK
     2843   WHERE X_thbj-attr.upper-prop-code = p-upper-prop-code
     2844       AND (X_thbj-attr.prop-code = '' OR X_thbj-attr.prop-value-type = 'void':U)
     2845   INDEXED-REPOSITION.
     2846   APPLY "VALUE-CHANGED" TO br-tree IN FRAME Dialog-Frame.
     2847   END PROCEDURE.
     2848   PROCEDURE OpenBrValues :
     2849   DEFINE INPUT PARAMETER p-upper-prop-code AS CHARACTER NO-UNDO.
     2850   DEFINE INPUT PARAMETER p-obj-type AS CHARACTER NO-UNDO.
     2851   DEFINE INPUT PARAMETER p-obj-code AS integer NO-UNDO.
     2852   IF p-upper-prop-code = '' THEN DO:
     2853       OPEN QUERY br-values
     2854       FOR EACH X_thbj-attr_v NO-LOCK WHERE  FALSE INDEXED-REPOSITION.
     2855   END.
     2856   ELSE DO:
     2857       OPEN QUERY br-values
     2858       FOR EACH X_thbj-attr_v NO-LOCK WHERE
     2859              X_thbj-attr_v.upper-prop-code = p-upper-prop-code
     2860           AND X_thbj-attr_v.obj-type = p-obj-type
     2861           AND X_thbj-attr_v.obj-code = p-obj-code
     2862           AND X_thbj-attr_v.prop-code > ''
     2863           INDEXED-REPOSITION.
     2864   END.
     2865   APPLY "VALUE-CHANGED" TO br-values IN FRAME Dialog-Frame.
     2866   CLOSE QUERY BR-values.
     2867   OPEN QUERY BR-values
     2868   FOR EACH X_thbj-attr_v NO-LOCK WHERE
     2869          X_thbj-attr_v.upper-prop-code = p-upper-prop-code
     2870       AND X_thbj-attr_v.obj-type = p-obj-type
     2871       AND X_thbj-attr_v.obj-code = p-obj-code
     2872       AND X_thbj-attr_v.prop-code > ''
     2873       INDEXED-REPOSITION.
     2874   APPLY "VALUE-CHANGED" TO br-values IN FRAME Dialog-Frame.
     2875   END PROCEDURE.
     2876   PROCEDURE proc-add :
     2877   DEFINE INPUT PARAMETER p-region AS CHARACTER NO-UNDO.
     2878   DEFINE INPUT PARAMETER p-upper-prop-code AS CHARACTER NO-UNDO.
     2879   define output parameter v-add-obj-type as character no-undo .
     2880   define output parameter v-add-obj-code as integer no-undo .
     2881   define variable v-recids as character no-undo .
     2882   define variable v-firm-code as integer no-undo .
     2883   define variable v-reg-code as integer no-undo .
     2884   define buffer buf_clients for ub.clients.
     2885   define buffer buf_sysconf for ub.sysconf.
     2886   define buffer buf_db      for ub.db.
     2887   define buffer buf_regions for ub.regions.
     2888   add-region = ''.
     2889   case p-region:
     2890     when 'БД':U then do:
     2891        run adm\dbs.w(  input parParentProc
     2892                      , input "b-sel":U
     2893                      , output v-recids
     2894             ).
     2895        if v-recids = '' then return.
     2896        find first buf_db no-lock
     2897                          where recid(buf_db) = integer(entry(1, v-recids)).
     2898        if available buf_db then
     2899        assign
     2900           v-add-obj-type = 'БД':U
     2901           v-add-obj-code = buf_db.db-num
     2902        .
     2903     end.
     2904     when 'орг':U then do:
     2905         run adm/sconfs.w (
     2906               input parParentProc
     2907             , input "b-sel":U
     2908             , input no
     2909             , input 0
     2910             , output v-firm-code
     2911             , input-output v-recids
     2912         ) no-error.
     2913       if v-recids = '' then return.
     2914       find first buf_sysconf no-lock
     2915                         where recid(buf_sysconf) = integer(entry(1, v-recids)).
     2916       assign
     2917       v-add-obj-type = 'орг':U
     2918       v-add-obj-code = buf_sysconf.host-code
     2919       .
     2920     end.
     2921     when 'маг':U then do:
     2922       run ref/thobjs.w
     2923           ( input parparentproc
     2924           , input this-procedure:handle
     2925           , input "b-sel"
     2926           , input 'все':U
     2927           , input 'маг':U
     2928           , input ?
     2929           , input ?
     2930           , input-output v-recids ) no-error .
     2931       if v-recids = '' then return.
     2932       find first buf_clients no-lock
     2933                         where recid(buf_clients) = integer(entry(1, v-recids)).
     2934       assign
     2935       v-add-obj-type = buf_clients.obj-type
     2936       v-add-obj-code = buf_clients.obj-code
     2937       .
     2938     end.
     2939     when 'скл':U then do:
     2940       run ref/thobjs.w
     2941           ( input parparentproc
     2942           , input this-procedure:handle
     2943           , input "b-sel"
     2944           , input 'все':U
     2945           , input 'скл':U
     2946           , input ?
     2947           , input ?
     2948           , input-output v-recids ) no-error .
     2949       if v-recids = '' then return.
     2950       find first buf_clients no-lock
     2951                         where recid(buf_clients) = integer(entry(1, v-recids)).
     2952       assign
     2953       v-add-obj-type = buf_clients.obj-type
     2954       v-add-obj-code = buf_clients.obj-code
     2955       .
     2956     end.
     2957     when 'регион':U then do:
     2958        run ref/regions.w ( input  parparentproc
     2959                           , input  'выбор':U
     2960                           , output v-reg-code
     2961                           ).
     2962        if v-reg-code = ? then return.
     2963        find first buf_regions no-lock
     2964             where buf_regions.reg-code = v-reg-code
     2965        no-error .
     2966        if available buf_regions then
     2967        assign
     2968           v-add-obj-type = 'регион':U
     2969           v-add-obj-code = buf_regions.reg-code
     2970        .
     2971     end.
     2972   end case.
     2973   run proc-upd-lkp in this-procedure (
     2974                                        input 'ИЗМЕНЕНИЕ':U
     2975                                       ,input p-upper-prop-code
     2976                                       ,input v-add-obj-type
     2977                                       ,input v-add-obj-code ) no-error.
     2978   END PROCEDURE.
     2979   PROCEDURE proc-b-copy :
     2980   DEFINE INPUT PARAMETER p-upper-prop-code AS CHARACTER NO-UNDO.
     2981   DEFINE INPUT PARAMETER p-obj-type AS CHARACTER NO-UNDO.
     2982   DEFINE INPUT PARAMETER p-obj-code AS INTEGER NO-UNDO.
     2983   define variable v-rid-list as character no-undo .
     2984   define variable v-firm-code  as integer no-undo .
     2985   define variable v-from-obj-code  as integer no-undo .
     2986   define variable v-found  as decimal no-undo .
     2987   define buffer buf_clients for ub.clients.
     2988   define buffer buf_sysconf for ub.sysconf.
     2989   define buffer buf_shop for ub.shop.
     2990   define buffer buf_store for ub.store.
     2991   define buffer buf_db for ub.db.
     2992   message
     2993   substitute("CКОПИРОВАТЬ ПАРАМЕТРЫ МОЖНО ТОЛЬКО С ОБЪЕКТА ТОГО ЖЕ ТИПА!!!&1&1&1" +
     2994              "Выберите объект, С КОТОРОГО ХОТИТЕ СКОПИРОВАТЬ ПАРАМЕТРЫ В ТЕКУЩИЙ ОБЪЕКТ (&2&3)&1" +
     2995              "Секция:&1&4"
     2996              , chr(10)
     2997              , p-obj-type
     2998              , p-obj-code
     2999              , section_thbj-attr.upper-prop-name
     3000              )
     3001   view-as alert-box.
     3002   CASE p-obj-type:
     3003     WHEN 'орг':U THEN DO:
     3004       message
     3005       "Выберите ФИРМУ для копирования ПАРАМЕТРОВ"
     3006       view-as alert-box WARNING.
     3007       run adm/sconfs.w (
     3008             input parParentProc
     3009           , input "b-sel":U
     3010           , input no
     3011           , input 0
     3012           , output v-firm-code
     3013           , input-output v-rid-list
     3014       ) no-error.
     3015       if v-rid-list = "":U then return.
     3016       find first buf_sysconf no-lock
     3017                         where recid(buf_sysconf) = integer(entry(1, v-rid-list)).
     3018       v-from-obj-code = buf_sysconf.host-code.
     3019     END.
     3020     WHEN 'маг':U THEN DO:
     3021       message
     3022       "Выберите МАГАЗИН для копирования ПАРАМЕТРОВ"
     3023       view-as alert-box WARNING.
     3024       run adm/shops.w ( input parparentproc
     3025                         ,input "b-sel"
     3026                         ,input-output v-rid-list
     3027                         ,no ).
     3028       if v-rid-list = "":U then return.
     3029       find first buf_shop no-lock where
     3030               recid(buf_shop) = integer(v-rid-list) .
     3031       v-from-obj-code = buf_shop.obj-code.
     3032     END.
     3033     WHEN 'скл':U THEN DO:
     3034       message
     3035       "Выберите СКЛАД для копирования ПАРАМЕТРОВ"
     3036       view-as alert-box WARNING.
     3037       run adm/stores.w ( input parparentproc
     3038                         ,input "b-sel"
     3039                         ,input-output v-rid-list
     3040                         ,input no ).
     3041       if v-rid-list = "":U then return.
     3042       find first buf_store no-lock where
     3043               recid(buf_store) = integer(v-rid-list) .
     3044       v-from-obj-code = buf_store.obj-code.
     3045     END.
     3046     when 'БД':U then do:
     3047       message
     3048       "Выберите БД для копирования ПАРАМЕТРОВ"
     3049       view-as alert-box WARNING.
     3050       run adm/dbs.w ( input parparentproc
     3051                         ,input "b-sel"
     3052                         ,output v-rid-list
     3053                          ).
     3054       if v-rid-list = "":U then return.
     3055       find first buf_db no-lock where
     3056               recid(buf_db) = integer(v-rid-list) .
     3057       v-from-obj-code = buf_db.db-num.
     3058     end.
     3059   END CASE.
     3060   run waitfram-show in this-procedure ( input "Ждите..." ).
     3061   FOR each thbjattr_thbj-attr:
     3062     delete thbjattr_thbj-attr.
     3063   end.
     3064   run thbjattr_get-section  in this-procedure (
     3065      input  p-obj-type
     3066     ,input  v-from-obj-code
     3067     ,input p-upper-prop-code
     3068     ,input '':U
     3069     ,input-output table thbjattr_thbj-attr
     3070     ,output v-found
     3071                                         ) no-error .
     3072     if not error-status:error then do:
     3073       run thbjattr_set-section in this-procedure (
     3074                                              input p-obj-type
     3075                                             ,input p-obj-code
     3076                                             ,input p-upper-prop-code
     3077                                             ,input table thbjattr_thbj-attr ) no-error .
     3078       IF ERROR-STATUS:ERROR THEN DO:
     3079         run waitfram-hide in this-procedure .
     3080         MESSAGE
     3081         SUBSTITUTE("Ошибка при записи параметров с объекта-источника:&1&2&1&3"
     3082                     , chr(10)
     3083                     ,  ERROR-STATUS:get-message(1)
     3084                     , RETURN-VALUE)
     3085         VIEW-AS ALERT-BOX ERROR.
     3086         undo, RETURN ERROR.
     3087      END.
     3088     end.
     3089     ELSE DO:
     3090        run waitfram-hide in this-procedure .
     3091        MESSAGE
     3092        SUBSTITUTE("Ошибка при чтении параметров с объекта-источника:&1&2&1&3"
     3093                   , chr(10)
     3094                   ,  ERROR-STATUS:get-message(1)
     3095                   , RETURN-VALUE)
     3096        VIEW-AS ALERT-BOX ERROR.
     3097        undo, RETURN ERROR.
     3098     END.
     3099   run waitfram-hide in this-procedure .
     3100   message
     3101   substitute("Скопирована секция&6&1&6 с &4&5 на &2&3"
     3102               , section_thbj-attr.upper-prop-name
     3103               , p-obj-type
     3104               , p-obj-code
     3105               , p-obj-type
     3106               , v-from-obj-code
     3107               , chr(10)
     3108               )
     3109   view-as alert-box .
     3110   END PROCEDURE.
     3111   PROCEDURE proc-upd-lkp :
     3112   DEFINE INPUT PARAMETER p-mode AS CHARACTER NO-UNDO.
     3113   DEFINE INPUT PARAMETER p-upper-prop-code AS CHARACTER NO-UNDO.
     3114   DEFINE INPUT PARAMETER p-obj-type AS CHARACTER NO-UNDO.
     3115   DEFINE INPUT PARAMETER p-obj-code AS CHARACTER NO-UNDO.
     3116   define variable v-label as character no-undo .
     3117   define variable v-user-can-edit as logical no-undo .
     3118   define variable v-output-display as logical no-undo .
     3119   define variable v-other as char no-undo .
     3120   define variable v-prop-list as character no-undo .
     3121   define variable v-prop-type-list as character no-undo .
     3122   define variable v-prop-label-list as character no-undo .
     3123   define variable v-global as logical no-undo .
     3124   define variable v-host as logical no-undo .
     3125   define variable v-shop as logical no-undo .
     3126   define variable v-store as logical no-undo .
     3127   define variable v-db as logical no-undo .
     3128   define variable v-region as logical no-undo .
     3129   define variable v-spr as character no-undo .
     3130   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     3131     run thbjattr_code_reg  in this-procedure (
     3132          input p-upper-prop-code
     3133         ,input   '':U
     3134         ,output v-label
     3135         ,output v-user-can-edit
     3136         ,output v-output-display
     3137         ,output v-other
     3138         ,output v-prop-list
     3139         ,output v-prop-type-list
     3140         ,output v-prop-label-list
     3141         ,output v-global
     3142         ,output v-host
     3143         ,output v-shop
     3144         ,output v-store
     3145         ,output v-db
     3146         ,output v-region
     3147     ).
     3148     do ii = 1 to num-entries(v-other, chr(47)):
     3149       if entry(ii, v-other, chr(47)) begins "spr-ext=":U then do:
     3150         assign
     3151         v-spr = entry(2, entry(ii, v-other, chr(47)), "=").
     3152       end.
     3153     end.
     3154     run value(v-spr) (
     3155                      input parparentproc
     3156                     ,input p-mode
     3157                     ,input p-obj-type
     3158                     ,input p-obj-code
     3159                     ) NO-ERROR.
     3160   END PROCEDURE.
     3161   FUNCTION get-thbjattr-l-and-v RETURNS CHARACTER
     3162     ( BUFFER buf_thbj-attr FOR ub.thbj-attr
     3163      ,OUTPUT p-value AS CHARACTER
     3164       ) :
     3165   define variable v-label as character no-undo .
     3166   define variable v-user-can-edit as logical no-undo .
     3167   define variable v-output-display as logical no-undo .
     3168   define variable v-other as char no-undo .
     3169   define variable v-host as logical no-undo .
     3170   define variable v-shop as logical no-undo .
     3171   define variable v-store as logical no-undo .
     3172   define variable v-global as logical no-undo .
     3173   define variable v-db as logical no-undo .
     3174   define variable v-region as logical no-undo .
     3175   define variable v-prop-list as character no-undo .
     3176   define variable v-prop-type-list as character no-undo .
     3177   define variable v-prop-label-list as character no-undo .
     3178   RUN thbjattr_code_reg IN THIS-PROCEDURE (
     3179                                       input buf_thbj-attr.upper-prop-code
     3180                                      ,input buf_thbj-attr.prop-code
     3181                                      ,OUTPUT v-label
     3182                                      ,OUTPUT v-user-can-edit
     3183                                      ,OUTPUT v-output-display
     3184                                      ,OUTPUT v-other
     3185                                      ,OUTPUT v-prop-list
     3186                                      ,OUTPUT v-prop-type-list
     3187                                      ,OUTPUT v-prop-label-list
     3188                                      ,OUTPUT v-global
     3189                                      ,OUTPUT v-host
     3190                                      ,OUTPUT v-shop
     3191                                      ,OUTPUT v-store
     3192                                      ,output v-db
     3193                                      ,OUTPUT v-region
     3194                                             ) NO-ERROR.
     3195   IF lookup(buf_thbj-attr.prop-code,v-prop-list) > 0 THEN DO:
     3196   case entry(lookup(buf_thbj-attr.prop-code,v-prop-list) , v-prop-type-list):
     3197     when 'character':U then do:
     3198       p-value = buf_thbj-attr.property-value-character.
     3199     end.
     3200     when 'date':U then do:
     3201       p-value = string(buf_thbj-attr.property-value-date, "99/99/9999").
     3202     end.
     3203     when 'decimal':U then do:
     3204       p-value = string(buf_thbj-attr.property-value-decimal).
     3205     end.
     3206     when 'integer':U then do:
     3207       p-value = string(buf_thbj-attr.property-value-integer).
     3208     end.
     3209     when 'logical':U then do:
     3210       p-value =  string(buf_thbj-attr.property-value-logical).
     3211     end.
     3212      when 'void':U then do:
     3213       p-value =  "...".
     3214     end.
     3215     OTHERWISE DO:
     3216       p-value = "!!!ОШИБКА-НЕИЗВЕСТНЫЙ ТИП ЗНАЧЕНИЯ".
     3217     END.
     3218     END CASE.
     3219     if buf_thbj-attr.upper-prop-code = "gisMT" and
     3220       (buf_thbj-attr.prop-code = "proxyPswd" or
     3221        buf_thbj-attr.prop-code = "OflinePswd" or
     3222        buf_thbj-attr.prop-code = "MaxApiToken") and
     3223        p-value > ""
     3224     then p-value = fill("*",length(p-value)).
     3225     RETURN entry(lookup(buf_thbj-attr.prop-code,v-prop-list),  v-prop-label-list).
     3226   END.
     3227   ELSE DO:
     3228       p-value = "!!!ОШИБКА-НЕИЗВЕСТНЫЙ ПАРАМЕТР".
     3229       RETURN buf_thbj-attr.prop-code.
     3230   END.
     3231   END FUNCTION.
