        1   DEFINE TEMP-TABLE section_thbj-attr NO-UNDO LIKE thbj-attr
        2          field upper-prop-name as character
        3          field global_ as logical
        4          field host_ as logical
        5          field shop_ as logical
        6          field store_ as logical
        7          field db_ as logical
        8          field region_ as logical
        9          .
       10   DEFINE TEMP-TABLE X_thbj-attr LIKE thbj-attr
       11          field ind1 as char
       12          index pi ind1
       13          .
       14   DEFINE BUFFER X_thbj-attr_2v FOR thbj-attr.
       15   DEFINE BUFFER X_thbj-attr_v FOR thbj-attr.
       16   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
       17   DEFINE INPUT PARAMETER bttns AS character NO-UNDO.
       18   define variable vss-revision    as character no-undo init "$Revision$":U .
       19   define variable vss-author      as character no-undo init "$Author$":U .
       20   define variable vss-date        as character no-undo init "$Date$":U .
       21   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       22   define variable vss-archive     as character no-undo init "$Archive$":U .
       23   define variable vss-description as character no-undo init "ДЕРЕВО параметров IBS TH".
       24   procedure vss-get-info :
       25     define output parameter p-vss-revision    like vss-revision    no-undo .
       26     define output parameter p-vss-author      like vss-author      no-undo .
       27     define output parameter p-vss-date        like vss-date        no-undo .
       28     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       29     define output parameter p-vss-archive     like vss-archive     no-undo .
       30     define output parameter p-vss-description like vss-description no-undo .
       31     assign
       32       p-vss-revision    = vss-revision
       33       p-vss-author      = vss-author
       34       p-vss-date        = vss-date
       35       p-vss-workfile    = vss-workfile
       36       p-vss-archive     = vss-archive
       37       p-vss-description = vss-description
       38     .
       39   end procedure.
       40   procedure vss-get-parameters :
       41     define output parameter p-vss-parameters as character no-undo .
       42   end procedure.
       43   define new global shared variable g#vssrevis-logger as handle    no-undo .
       44   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       45   define variable v-vssrevis-logger                   as handle    no-undo .
       46   procedure vss-logevent :
       47     define input  parameter p-extra-paramters as character no-undo .
       48     define variable v-vssrevis-parameters as character no-undo .
       49     do
       50     on error undo, return error return-value
       51     :
       52       if  valid-handle(v-vssrevis-logger)
       53       and v-vssrevis-logger :get-signature("logevent") <> ""
       54       then do:
       55         run vss-get-parameters in this-procedure
       56           (output v-vssrevis-parameters
       57           ).
       58         run logevent in v-vssrevis-logger
       59           (input vss-workfile
       60           ,input vss-revision
       61           ,input v-vssrevis-parameters
       62           ,input p-extra-paramters
       63           ).
       64       end.
       65     end.
       66   end procedure.
       67   assign
       68     v-vssrevis-logger = g#vssrevis-logger
       69   .
       70   if  valid-handle(v-vssrevis-logger)
       71   and v-vssrevis-logger :get-signature("logevent") <> ""
       72   then do:
       73     assign
       74       v-vssrevis-logevent = true
       75     .
       76     run vss-logevent in this-procedure (input vss-description) .
       77   end.
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   define variable v-waitfram-action01         as character   no-undo .
       80   define variable v-waitfram-action02         as character   no-undo .
       81   define variable v-waitfram-action03         as character   no-undo .
       82   define variable mWaitFramTextBeg            as character   no-undo.
       83   define variable mWaitFramTextEnd            as character   no-undo.
       84   define variable mWaitFramView               as logical     no-undo.
       85   define variable mWaitProcEvent              as logical     no-undo init yes.
       86   define variable mWaitFramInterval           as integer     no-undo init 1 .
       87   define variable mWaitFramStop               as logical     no-undo.
       88   define variable mWaitFramStopUser           as logical     no-undo.
       89   define variable mWaitFramStopTimeOut        as logical     no-undo.
       90   define variable mWaitFramStartProc          as datetime-tz no-undo.
       91   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       92   define button B-WaitFramStop auto-end-key
       93        label "Стоп"
       94        size 10 by 1 tooltip "Остоновить процесс".
       95   define button B-viewProcInfo
       96        label "Информация"
       97        size 15 by 1 tooltip "Информация о процесс".
       98   define frame waitfram
       99     v-waitfram-action01 format "x(72)" no-label skip
      100     v-waitfram-action02 format "x(72)" no-label skip
      101     v-waitfram-action03 format "x(72)" no-label skip
      102     B-viewProcInfo
      103     B-WaitFramStop at row 4 col 30
      104     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      105     .
      106   define new global shared variable mBatchMode as logical no-undo init ?.
      107   define variable mFramBachModHandle as handle no-undo.
      108   mFramBachModHandle = frame waitfram:handle.
      109   define variable mFameOldVis as logical no-undo.
      110   define variable mVisCUrentVin as logical no-undo.
      111   if session:batch-mode
      112   then
      113      mBatchMode = yes.
      114   if mBatchMode = ? then do:
      115     mVisCUrentVin = current-window:visible.
      116     mFameOldVis = mFramBachModHandle:visible.
      117     mFramBachModHandle:visible  = yes.
      118     mBatchMode = mFramBachModHandle:visible ne yes.
      119     mFramBachModHandle:visible = mFameOldVis.
      120     current-window:visible = mVisCUrentVin.
      121   end.
      122    if  log-manager:logfile-name ne ?
      123     then DO:
      124         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      125         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      126         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      127     end.
      128   on choose of B-WaitFramStop in frame waitfram
      129   do:
      130     mWaitFramStop = yes.
      131     mWaitFramStopUser = yes.
      132   end.
      133   function waitfram-check-timeout returns logical():
      134      define variable vtime as int64 no-undo.
      135      if mWaitFramStopTimeOut
      136      then
      137         return yes.
      138      vtime = ( now - mWaitFramStartProc ) / 1000 .
      139      if     mWaitFramTimeOut ne ?
      140         and mWaitFramTimeOut ne 0
      141         and mWaitFramTimeOut lt vtime
      142      then do:
      143         mWaitFramStopTimeOut = yes.
      144      end.
      145      return mWaitFramStopTimeOut.
      146   end.
      147   procedure waitfram-hide :
      148     if not session:batch-mode
      149     then do
      150     on error undo, return error return-value
      151     :
      152       pause 0 before-hide .
      153       if not mBatchMode then
      154         hide frame waitfram .
      155     if     not mWaitFramView
      156        and mWaitProcEvent
      157     then
      158       process events .
      159     end.
      160   end procedure.
      161   procedure waitfram-show :
      162     define input  parameter p-message as character no-undo .
      163     define variable v-left-margin as integer   no-undo .
      164     if not session:batch-mode
      165     then do
      166     on error undo, return error return-value
      167     :
      168       if length(p-message) <= 70 then do:
      169         assign
      170           v-left-margin = integer((70 - length(p-message)) / 2)
      171         .
      172         assign
      173           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      174         .
      175         assign
      176           v-waitfram-action01 = " "
      177           v-waitfram-action02 = " "
      178                                    + fill(" ", v-left-margin)
      179                                    + p-message
      180           v-waitfram-action03 = " "
      181         .
      182       end.
      183       else do:
      184         define variable vRindex1 as integer no-undo.
      185         define variable vRindex2 as integer no-undo.
      186         vRindex1 = r-index(p-message," ",70).
      187         if vRindex1 = 0
      188         then
      189            vRindex1 = 70.
      190         if length(p-message)  <= vRindex1 + 70 then do:
      191           assign
      192             v-waitfram-action01 = " "
      193             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      194             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      195           .
      196         end.
      197         else do:
      198           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      199           if vRindex2 <= vRindex1
      200           then
      201              vRindex2 = vRindex1 + 70.
      202           assign
      203             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      204             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      205             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      206           .
      207         end.
      208       end.
      209       B-viewProcInfo:visible   in frame waitfram = no.
      210       B-viewProcInfo:sensitive in frame waitfram = no.
      211       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      212       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      213       if  (   mWaitFramView
      214          or  mWaitProcEvent)
      215          and not mBatchMode
      216       then
      217          display
      218             v-waitfram-action01 skip
      219             v-waitfram-action02 skip
      220             v-waitfram-action03 skip
      221          with frame waitfram .
      222       if     mWaitFramView
      223          then do:
      224             if     mWaitFramInterval ne ?
      225                and not mBatchMode
      226             then
      227                wait-for go of frame waitfram pause mWaitFramInterval.
      228          end.
      229          else
      230             if     mWaitProcEvent
      231                and not mBatchMode
      232             then
      233                process events .
      234     end.
      235   end procedure.
      236      procedure waitfram-show-this:
      237         define input  parameter iInterval as int64 no-undo.
      238         define variable vtime as int64 no-undo.
      239         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      240         mWaitFramInterval = iInterval.
      241         run waitfram-show (substitute("&1&2 &3&4" ,
      242                                       mWaitFramTextBeg ,
      243                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      244                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      245                                       mWaitFramTextEnd
      246                                      )
      247                           ).
      248      end.
      249      procedure WaitFramRunPause:
      250         define input  parameter iInterval as dec no-undo.
      251         define variable vStart  as datetime-tz no-undo.
      252         define variable vend    as datetime-tz no-undo.
      253         define variable vint as int64 no-undo.
      254         define variable vOk as logical no-undo.
      255         vStart = now.
      256         vend   = vStart.
      257         publish "WaitFramPause" (iInterval,output vOk).
      258         vend   =  now.
      259         vint = vend - vStart.
      260         vint = iInterval - vint / 1000.
      261         if     not mWaitFramStop
      262            and (   vint > 0
      263                 or (    not vOk
      264                     and iInterval eq ?
      265                     )
      266                 )
      267         then
      268            run waitfram-show-this (iInterval).
      269         vend   =  now.
      270         vint = vend - vStart.
      271         vint = iInterval - vint / 1000.
      272         if     not mWaitFramStop
      273            and vint > 0
      274         then do:
      275            run gbl/pause.p (vint * 1000).
      276         end.
      277         if iInterval ne ?
      278         then
      279            publish "WaitFramStop".
      280         waitfram-check-timeout().
      281      end.
      282      procedure WaitFramWaitFor:
      283         define input  parameter iInterval as dec no-undo.
      284         assign
      285            mWaitFramStartProc   = now
      286            mWaitFramStopUser    = no
      287            mWaitFramStopTimeOut = no
      288         .
      289         block-wait:
      290         do while not mWaitFramStop:
      291            run WaitFramRunPause (iInterval).
      292            if  waitfram-check-timeout()
      293            then do:
      294               leave block-wait.
      295            end.
      296         end.
      297         run waitfram-hide.
      298      end.
      299   procedure waitfram-join :
      300     define input  parameter p-line-1  as character no-undo .
      301     define input  parameter p-line-2  as character no-undo .
      302     define input  parameter p-line-3  as character no-undo .
      303     define output parameter p-message as character no-undo .
      304     do
      305     on error undo, return error return-value
      306     :
      307       assign
      308         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      309                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      310                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      311       .
      312     end.
      313   end procedure.
      314   function waitfram-join-function returns character
      315     (input p-line-1 as character
      316     ,input p-line-2 as character
      317     ,input p-line-3 as character
      318     ).
      319     define variable v-message as character no-undo .
      320     run waitfram-join in this-procedure
      321       (input  p-line-1
      322       ,input  p-line-2
      323       ,input  p-line-3
      324       ,output v-message
      325       ) .
      326     return v-message .
      327   end function .
      328   define new global shared variable g#language as character no-undo .
      329   if g#language <> '' and g#language <> 'rus':U then do:
      330     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      331   end.
      332   define new global shared variable g#library  as handle no-undo .
      333   define new global shared variable g#library2 as handle no-undo .
      334   define   shared variable g#auto as logical no-undo.
      335   define   shared variable g#news as logical no-undo.
      336   define   shared variable g#oxml as logical no-undo.
      337   define   shared variable g#esys as logical no-undo.
      338   define   shared variable g#news-source-db as integer no-undo.
      339   define   shared variable g#esys-source-esys as integer no-undo.
      340   define   shared variable g#db-num as integer   no-undo .
      341   define   shared variable g#userid as character no-undo .
      342   define   shared variable g#passwd as character no-undo .
      343   procedure proc-alt-shift-f2:
      344     if not ibs.th.gbl.gbl-var:rcode
      345   then
      346     run gbl\inidebug.p .
      347   end.
      348   procedure proc-alt-shift-f3:
      349     run gbl/prvssinf.p
      350       ( input this-procedure
      351       ) .
      352   end.
      353   define variable v-inform-launched as logical no-undo initial false .
      354   procedure proc-alt-shift-f4:
      355     define variable v-action as character no-undo .
      356     if v-inform-launched = false then do:
      357       assign
      358         v-inform-launched = true
      359       .
      360       run gbl/d-inform.w
      361         (  input self
      362         ,  input this-procedure
      363         , output v-action
      364         ) no-error .
      365       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      366       assign
      367         v-inform-launched = false
      368       .
      369     end.
      370   end.
      371   procedure proc-alt-f1:
      372     run gbl/corrhelp.p
      373       (input this-procedure
      374       ) .
      375   end .
      376   on alt-shift-f2 anywhere do:
      377     run proc-alt-shift-f2.
      378   end.
      379   on alt-shift-f3 anywhere do:
      380     run proc-alt-shift-f3 in this-procedure .
      381   end.
      382   on alt-shift-f4 anywhere do:
      383     run proc-alt-shift-f4 in this-procedure.
      384   end.
      385   on alt-f1 anywhere do:
      386     run proc-alt-f1 in this-procedure .
      387   end.
      388   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      389   define new global shared variable g#attr-lib  as handle no-undo .
      390   define variable v-attr-lib-variable as handle no-undo .
      391   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      392   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      393   procedure thbjattr_code :
      394      define input  parameter p-upper-code     as character no-undo .
      395      define input  parameter p-code           as character no-undo .
      396      define output parameter p-label          as character no-undo .
      397      define output parameter p-user-can-edit  as logical   no-undo .
      398      define output parameter p-output-display as logical   no-undo .
      399      define output parameter p-other          as character no-undo .
      400      define output parameter p-prop-list      as character no-undo .
      401      define output parameter p-prop-type-list as character no-undo .
      402      define output parameter p-prop-label-list as character no-undo .
      403      define output parameter p-global          as logical no-undo .
      404      define output parameter p-host           as logical no-undo .
      405      define output parameter p-shop           as logical no-undo .
      406      define output parameter p-store          as logical no-undo .
      407      define output parameter p-db             as logical no-undo .
      408      define variable p-region as logical no-undo.
      409      run thbjattr_code_reg in this-procedure (
      410                                               p-upper-code,
      411                                               p-code,
      412                                               output p-label,
      413                                               output p-user-can-edit,
      414                                               output p-output-display,
      415                                               output p-other,
      416                                               output p-prop-list,
      417                                               output p-prop-type-list,
      418                                               output p-prop-label-list,
      419                                               output p-global,
      420                                               output p-host,
      421                                               output p-shop,
      422                                               output p-store,
      423                                               output p-db,
      424                                               output p-region
      425                                               ).
      426   end procedure.
      427   procedure thbjattr_code_reg :
      428   define input  parameter p-upper-code     as character no-undo .
      429   define input  parameter p-code           as character no-undo .
      430   define output parameter p-label          as character no-undo .
      431   define output parameter p-user-can-edit  as logical   no-undo .
      432   define output parameter p-output-display as logical   no-undo .
      433   define output parameter p-other          as character no-undo .
      434   define output parameter p-prop-list      as character no-undo .
      435   define output parameter p-prop-type-list as character no-undo .
      436   define output parameter p-prop-label-list as character no-undo .
      437   define output parameter p-global          as logical no-undo .
      438   define output parameter p-host           as logical no-undo .
      439   define output parameter p-shop           as logical no-undo .
      440   define output parameter p-store          as logical no-undo .
      441   define output parameter p-db             as logical no-undo .
      442   define output parameter p-region         as logical no-undo .
      443   do
      444   on error undo, return error return-value
      445   :
      446       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      447       (input  p-upper-code
      448       ,input  p-code
      449       ,output p-label
      450       ,output p-user-can-edit
      451       ,output p-output-display
      452       ,output p-other
      453       ,output p-prop-list
      454       ,output p-prop-type-list
      455       ,output p-prop-label-list
      456       ,output p-global
      457       ,output p-host
      458       ,output p-shop
      459       ,output p-store
      460       ,output p-db
      461       ,output p-region
      462       ) no-error .
      463     if error-status :error
      464     then do:
      465       undo, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message (1)).
      466     end.
      467   end.
      468   end procedure.
      469   procedure thbjattr_tooltip :
      470   define input  parameter p-upper-code  as character no-undo .
