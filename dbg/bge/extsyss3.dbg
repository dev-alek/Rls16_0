        1   block-level on error undo, throw.
        2   define input parameter p-silent as logical no-undo .
        3   define input parameter p-rec as recid no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: bfb4ae97be9f, 14, test $":U .
        5   define variable vss-author      as character no-undo init "$Author: ASMorozov $":U .
        6   define variable vss-date        as character no-undo init "$Date: Wed Mar 05 12:48:25 2014 +0300 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: extsyss3.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: bge/extsyss3.p $":U .
        9   define variable vss-description as character no-undo init "Удаление специальной ВС".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   define variable v-waitfram-action01         as character   no-undo .
       81   define variable v-waitfram-action02         as character   no-undo .
       82   define variable v-waitfram-action03         as character   no-undo .
       83   define variable mWaitFramTextBeg            as character   no-undo.
       84   define variable mWaitFramTextEnd            as character   no-undo.
       85   define variable mWaitFramView               as logical     no-undo.
       86   define variable mWaitProcEvent              as logical     no-undo init yes.
       87   define variable mWaitFramInterval           as integer     no-undo init 1 .
       88   define variable mWaitFramStop               as logical     no-undo.
       89   define variable mWaitFramStopUser           as logical     no-undo.
       90   define variable mWaitFramStopTimeOut        as logical     no-undo.
       91   define variable mWaitFramStartProc          as datetime-tz no-undo.
       92   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       93   define button B-WaitFramStop auto-end-key
       94        label "Стоп"
       95        size 10 by 1 tooltip "Остоновить процесс".
       96   define button B-viewProcInfo
       97        label "Информация"
       98        size 15 by 1 tooltip "Информация о процесс".
       99   define frame waitfram
      100     v-waitfram-action01 format "x(72)" no-label skip
      101     v-waitfram-action02 format "x(72)" no-label skip
      102     v-waitfram-action03 format "x(72)" no-label skip
      103     B-viewProcInfo
      104     B-WaitFramStop at row 4 col 30
      105     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      106     .
      107   define new global shared variable mBatchMode as logical no-undo init ?.
      108   define variable mFramBachModHandle as handle no-undo.
      109   mFramBachModHandle = frame waitfram:handle.
      110   define variable mFameOldVis as logical no-undo.
      111   define variable mVisCUrentVin as logical no-undo.
      112   if session:batch-mode
      113   then
      114      mBatchMode = yes.
      115   if mBatchMode = ? then do:
      116     mVisCUrentVin = current-window:visible.
      117     mFameOldVis = mFramBachModHandle:visible.
      118     mFramBachModHandle:visible  = yes.
      119     mBatchMode = mFramBachModHandle:visible ne yes.
      120     mFramBachModHandle:visible = mFameOldVis.
      121     current-window:visible = mVisCUrentVin.
      122   end.
      123    if  log-manager:logfile-name ne ?
      124     then DO:
      125         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      126         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      127         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      128     end.
      129   on choose of B-WaitFramStop in frame waitfram
      130   do:
      131     mWaitFramStop = yes.
      132     mWaitFramStopUser = yes.
      133   end.
      134   function waitfram-check-timeout returns logical():
      135      define variable vtime as int64 no-undo.
      136      if mWaitFramStopTimeOut
      137      then
      138         return yes.
      139      vtime = ( now - mWaitFramStartProc ) / 1000 .
      140      if     mWaitFramTimeOut ne ?
      141         and mWaitFramTimeOut ne 0
      142         and mWaitFramTimeOut lt vtime
      143      then do:
      144         mWaitFramStopTimeOut = yes.
      145      end.
      146      return mWaitFramStopTimeOut.
      147   end.
      148   procedure waitfram-hide :
      149     if not session:batch-mode
      150     then do
      151     on error undo, return error return-value
      152     :
      153       pause 0 before-hide .
      154       if not mBatchMode then
      155         hide frame waitfram .
      156     if     not mWaitFramView
      157        and mWaitProcEvent
      158     then
      159       process events .
      160     end.
      161   end procedure.
      162   procedure waitfram-show :
      163     define input  parameter p-message as character no-undo .
      164     define variable v-left-margin as integer   no-undo .
      165     if not session:batch-mode
      166     then do
      167     on error undo, return error return-value
      168     :
      169       if length(p-message) <= 70 then do:
      170         assign
      171           v-left-margin = integer((70 - length(p-message)) / 2)
      172         .
      173         assign
      174           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      175         .
      176         assign
      177           v-waitfram-action01 = " "
      178           v-waitfram-action02 = " "
      179                                    + fill(" ", v-left-margin)
      180                                    + p-message
      181           v-waitfram-action03 = " "
      182         .
      183       end.
      184       else do:
      185         define variable vRindex1 as integer no-undo.
      186         define variable vRindex2 as integer no-undo.
      187         vRindex1 = r-index(p-message," ",70).
      188         if vRindex1 = 0
      189         then
      190            vRindex1 = 70.
      191         if length(p-message)  <= vRindex1 + 70 then do:
      192           assign
      193             v-waitfram-action01 = " "
      194             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      195             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      196           .
      197         end.
      198         else do:
      199           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      200           if vRindex2 <= vRindex1
      201           then
      202              vRindex2 = vRindex1 + 70.
      203           assign
      204             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      205             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      206             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      207           .
      208         end.
      209       end.
      210       B-viewProcInfo:visible   in frame waitfram = no.
      211       B-viewProcInfo:sensitive in frame waitfram = no.
      212       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      213       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      214       if  (   mWaitFramView
      215          or  mWaitProcEvent)
      216          and not mBatchMode
      217       then
      218          display
      219             v-waitfram-action01 skip
      220             v-waitfram-action02 skip
      221             v-waitfram-action03 skip
      222          with frame waitfram .
      223       if     mWaitFramView
      224          then do:
      225             if     mWaitFramInterval ne ?
      226                and not mBatchMode
      227             then
      228                wait-for go of frame waitfram pause mWaitFramInterval.
      229          end.
      230          else
      231             if     mWaitProcEvent
      232                and not mBatchMode
      233             then
      234                process events .
      235     end.
      236   end procedure.
      237      procedure waitfram-show-this:
      238         define input  parameter iInterval as int64 no-undo.
      239         define variable vtime as int64 no-undo.
      240         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      241         mWaitFramInterval = iInterval.
      242         run waitfram-show (substitute("&1&2 &3&4" ,
      243                                       mWaitFramTextBeg ,
      244                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      245                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      246                                       mWaitFramTextEnd
      247                                      )
      248                           ).
      249      end.
      250      procedure WaitFramRunPause:
      251         define input  parameter iInterval as dec no-undo.
      252         define variable vStart  as datetime-tz no-undo.
      253         define variable vend    as datetime-tz no-undo.
      254         define variable vint as int64 no-undo.
      255         define variable vOk as logical no-undo.
      256         vStart = now.
      257         vend   = vStart.
      258         publish "WaitFramPause" (iInterval,output vOk).
      259         vend   =  now.
      260         vint = vend - vStart.
      261         vint = iInterval - vint / 1000.
      262         if     not mWaitFramStop
      263            and (   vint > 0
      264                 or (    not vOk
      265                     and iInterval eq ?
      266                     )
      267                 )
      268         then
      269            run waitfram-show-this (iInterval).
      270         vend   =  now.
      271         vint = vend - vStart.
      272         vint = iInterval - vint / 1000.
      273         if     not mWaitFramStop
      274            and vint > 0
      275         then do:
      276            run gbl/pause.p (vint * 1000).
      277         end.
      278         if iInterval ne ?
      279         then
      280            publish "WaitFramStop".
      281         waitfram-check-timeout().
      282      end.
      283      procedure WaitFramWaitFor:
      284         define input  parameter iInterval as dec no-undo.
      285         assign
      286            mWaitFramStartProc   = now
      287            mWaitFramStopUser    = no
      288            mWaitFramStopTimeOut = no
      289         .
      290         block-wait:
      291         do while not mWaitFramStop:
      292            run WaitFramRunPause (iInterval).
      293            if  waitfram-check-timeout()
      294            then do:
      295               leave block-wait.
      296            end.
      297         end.
      298         run waitfram-hide.
      299      end.
      300   procedure waitfram-join :
      301     define input  parameter p-line-1  as character no-undo .
      302     define input  parameter p-line-2  as character no-undo .
      303     define input  parameter p-line-3  as character no-undo .
      304     define output parameter p-message as character no-undo .
      305     do
      306     on error undo, return error return-value
      307     :
      308       assign
      309         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      310                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      311                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      312       .
      313     end.
      314   end procedure.
      315   function waitfram-join-function returns character
      316     (input p-line-1 as character
      317     ,input p-line-2 as character
      318     ,input p-line-3 as character
      319     ).
      320     define variable v-message as character no-undo .
      321     run waitfram-join in this-procedure
      322       (input  p-line-1
      323       ,input  p-line-2
      324       ,input  p-line-3
      325       ,output v-message
      326       ) .
      327     return v-message .
      328   end function .
      329   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      330   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      331   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      332   procedure gen-key-rec :
      333     define input  parameter p-tbl-name    as character no-undo.
      334     define input  parameter p-bh_tbl-name as handle    no-undo.
      335     define output parameter p-key-rec     as character no-undo.
      336     do
      337     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      338     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      339     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      340     :
      341       define variable fh               as handle    no-undo .
      342       define variable v-ok             as logical   no-undo .
      343       define variable v-inform         as character no-undo .
      344       define variable v-ind            as integer   no-undo .
      345       define variable v-idx-field-qnty as integer   no-undo .
      346       if p-tbl-name = ?
      347         or p-tbl-name = "":U
      348       then do:
      349         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      350       end.
      351       if not p-bh_tbl-name:available then do:
      352         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      353       end.
      354       assign
      355         p-key-rec = p-tbl-name
      356         v-inform  = p-bh_tbl-name:index-information(1)
      357         v-ind     = 2
      358       .
      359       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      360       on error undo, return error
      361       :
      362         assign
      363           v-inform = p-bh_tbl-name:index-information( v-ind )
      364           v-ind    = v-ind + 1
      365         .
      366       end.
      367       if v-inform = ?
      368         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      369         or entry( 3, v-inform, ",":U ) <> "1":U
      370       then do:
      371         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      372       end.
      373       else do:
      374         assign
      375           v-idx-field-qnty = num-entries( v-inform ) - 4
      376         .
      377         if v-idx-field-qnty < 2 then do:
      378           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      379         end.
      380         do v-ind = 1 to v-idx-field-qnty by 2
      381         on error undo, return error
      382         :
      383           assign
      384             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      385             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      386           .
      387         end.
      388       end.
      389       if p-key-rec = ? then do:
      390         assign
      391           p-key-rec = "":U
      392         .
      393         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      394       end.
      395     end.
      396     return.
      397   end procedure.
      398   procedure gen-where-keyr-tab :
      399     define input  parameter i-tableSerach as character no-undo.
      400     define input  parameter i-tablekey   as character  no-undo.
      401     define input  parameter p-key-rec    as character  no-undo.
      402     define input  parameter p-key-handle as handle     no-undo .
      403     define input  parameter p-db-name    as character  no-undo .
      404     define input  parameter p-tt-handle  as handle     no-undo .
      405     define output parameter o-Where      as character  no-undo.
      406     do
      407     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      408     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      409     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      410     :
      411       define variable v-full-tbl-name  as character no-undo .
      412       define variable bh_tbl-name      as handle    no-undo .
      413       define variable fh_key           as handle    no-undo .
      414       define variable fh_search        as handle    no-undo .
      415       define variable v-field-num      as integer   no-undo .
      416       define variable v-count-fld      as integer   no-undo .
      417       define variable v-inform         as character no-undo .
      418       define variable v-ind            as integer   no-undo .
      419       define variable v-idx-field-qnty as integer   no-undo .
      420       define variable v-field-name     as character no-undo .
      421       define variable v-field-val      as character no-undo .
      422       define variable v-word-link      as character no-undo .
      423       define variable vTable           as character no-undo.
      424       define variable bh_tbl-key       as handle    no-undo .
      425       assign
      426         p-key-rec = trim( p-key-rec )
      427       .
      428       if p-key-handle <> ? then do:
      429         if not valid-handle(p-key-handle)
      430            or p-key-handle:type <> "buffer"
      431         then do:
      432           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      433         end.
      434         if num-entries( p-key-rec, chr(3) ) > 1
      435           or p-key-rec = ?
      436           or p-key-rec = "":U
      437         then do:
      438           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      439         end.
      440       end.
      441       else do:
      442         if p-key-rec = ?
      443           or p-key-rec = "":U
      444         then do:
      445           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      446         end.
      447       end.
      448       assign
      449         vTable = entry( 1 , p-key-rec, chr(3) )
      450       .
      451       if p-tt-handle <> ?
      452         and ( not valid-handle(p-tt-handle)
      453               or p-tt-handle:type <> "buffer"
      454             )
      455       then do:
      456         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      457       end.
      458       if p-tt-handle = ? then do:
      459         assign
      460           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      461         .
      462         create buffer bh_tbl-name for table v-full-tbl-name .
      463       end.
      464       else do:
      465         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      466       end.
      467       assign
      468         v-inform = bh_tbl-name:index-information(1)
      469         v-ind    = 2
      470       .
      471       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      472       on error undo, return error
      473       :
      474         assign
      475           v-inform = bh_tbl-name:index-information( v-ind )
      476           v-ind    = v-ind + 1
      477         .
      478       end.
      479       if v-inform = ?
      480         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      481         or entry( 3, v-inform, ",":U ) <> "1":U
      482       then do:
      483         delete object bh_tbl-name no-error.
      484         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      485       end.
      486       assign
      487         v-idx-field-qnty = num-entries( v-inform ) - 4
      488       .
      489       if v-idx-field-qnty < 2 then do:
      490         delete object bh_tbl-name no-error.
      491         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      492       end.
      493       assign
      494         o-where     = "where":U
      495         v-word-link = "":U
      496         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      497         v-count-fld = 0
      498       .
      499       if i-tablekey ne "" and i-tablekey ne ?
      500       then do:
      501         assign
      502           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      503         .
      504         create buffer bh_tbl-key for table v-full-tbl-name .
      505       end.
      506       if i-tableSerach ne "" and i-tableSerach ne ?
      507       then do:
      508         delete object bh_tbl-name no-error.
      509         assign
      510           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      511         .
      512         create buffer bh_tbl-name for table v-full-tbl-name .
      513       end.
      514       block_where:
      515       do v-ind = 1 to v-idx-field-qnty by 2
      516       on error undo, return error
      517       :
      518         assign
      519           v-count-fld = v-count-fld + 1
      520         .
      521         if p-key-handle = ?
      522           and v-count-fld > v-field-num
      523         then do:
      524           leave block_where.
      525         end.
      526         define variable VfieldKeyTable as handle no-undo.
      527         assign
      528           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      529           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      530         .
      531         if     bh_tbl-key ne ?
      532         then do:
      533            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      534            if VfieldKeyTable eq ?
      535            then next block_where.
      536         end.
      537         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      538         then
      539            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      540         else
      541            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      542         if p-key-handle = ? then do:
      543           assign
      544             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      545           .
      546         end.
      547         else do:
      548           assign
      549             fh_key = p-key-handle:buffer-field( v-field-name )
      550           .
      551           if fh_key = ?
      552             or not valid-handle( fh_key )
      553           then do:
      554             delete object bh_tbl-name.
      555             if     bh_tbl-key ne ?
      556             then
      557                delete object bh_tbl-key.
      558             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      559           end.
      560           assign
      561             v-field-val = fh_key:buffer-value
      562           .
      563         end.
      564         if fh_search:data-type ="character":U then do:
      565           assign
      566             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      567             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      568             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      569             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      570             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      571             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      572             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      573             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      574             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      575             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      576             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      577             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      578             v-field-val = substitute( '"&1"', v-field-val )
      579           .
      580         end.
      581         assign
      582           o-where = substitute( "&1 &2", o-where, v-field-val )
      583         .
      584         if v-word-link = "":U then do:
      585           assign
      586             v-word-link = "and":U
      587           .
      588         end.
      589       end.
      590       delete object bh_tbl-name.
      591       if     bh_tbl-key ne ?
      592       then
      593          delete object bh_tbl-key.
      594       if p-key-handle = ?
      595         and v-count-fld <> v-field-num
      596       then do:
      597         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      598       end.
      599     end.
      600   end procedure.
      601   procedure gen-hn-keyr-tab :
      602     define input  parameter i-tableSerach as character no-undo.
      603     define input  parameter i-tablekey   as character no-undo.
      604     define input  parameter p-key-rec    as character no-undo.
      605     define input  parameter p-key-handle as handle    no-undo .
      606     define input  parameter p-db-name    as character no-undo .
      607     define input  parameter p-tt-handle  as handle    no-undo .
      608     define input  parameter p-stts-lock  as integer   no-undo .
      609     define output parameter o-hn         as handle    no-undo.
      610     define variable v-full-tbl-name as character no-undo.
      611     define variable v-where         as character no-undo.
      612     define variable bh_tbl-name     as handle    no-undo.
      613     define variable vTable          as character no-undo.
      614     do
      615     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      616     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      617     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      618         run gen-where-keyr-tab(i-tableSerach,
      619                                i-tablekey,
      620                                p-key-rec,
      621                                p-key-handle,
      622                                p-db-name,
      623                                p-tt-handle,
      624                                output v-where).
      625         if i-tableSerach ne "" and i-tableSerach ne ?
      626         then do:
      627            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      628            create buffer bh_tbl-name for table v-full-tbl-name .
      629         end.
      630         else do:
      631            if p-tt-handle = ? then do:
      632               assign
      633                  vTable = entry( 1 , p-key-rec, chr(3) )
      634               .
      635               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      636               create buffer bh_tbl-name for table v-full-tbl-name .
      637            end.
      638            else do:
      639               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      640            end.
      641         end.
      642         if p-tt-handle = ? then do:
      643            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      644         end.
      645         else do:
      646            bh_tbl-name:find-first( v-where ) no-error .
      647         end.
      648         o-hn = bh_tbl-name.
      649      end.
      650   end procedure.
      651   procedure gen-hn-keyr :
      652     define input  parameter p-key-rec    as character no-undo.
      653     define input  parameter p-key-handle as handle    no-undo .
      654     define input  parameter p-db-name    as character no-undo .
      655     define input  parameter p-tt-handle  as handle    no-undo .
      656     define input  parameter p-stts-lock  as integer   no-undo .
      657     define output parameter o-hn         as handle    no-undo.
      658     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      659   end.
      660   procedure gen-row-keyr :
      661     define input  parameter p-key-rec    as character no-undo.
      662     define input  parameter p-key-handle as handle    no-undo .
      663     define input  parameter p-db-name    as character no-undo .
      664     define input  parameter p-tt-handle  as handle    no-undo .
      665     define input  parameter p-stts-lock  as integer   no-undo .
      666     define output parameter p-tbl-row    as rowid     no-undo.
      667     define output parameter p-tbl-name   as character no-undo.
      668     define variable vHn as handle no-undo.
      669       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      670       p-tbl-row = if vHn:available then vHn:rowid else ?.
      671       p-tbl-name =  vHn:table.
      672       delete object vHn no-error.
      673     if p-tbl-row = ? then do:
      674       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      675     end.
      676     else do:
      677       return.
      678     end.
      679   end procedure.
      680   procedure gen-key-fv :
      681     define input  parameter p-key-rec    as character no-undo .
      682     define output parameter p-field-list as character no-undo .
      683     define output parameter p-value-list as character no-undo.
      684     do
      685     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      686     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      687     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      688     :
      689       define variable v-full-tbl-name  as character no-undo .
      690       define variable bh_tbl-name      as handle    no-undo .
      691       define variable v-tbl-name       as character no-undo .
      692       define variable v-field-num      as integer   no-undo .
      693       define variable v-count-fld      as integer   no-undo .
      694       define variable v-inform         as character no-undo .
      695       define variable v-ind            as integer   no-undo .
      696       define variable v-idx-field-qnty as integer   no-undo .
      697       define variable v-delim-key      as character no-undo .
      698       if p-key-rec = ?
      699         or p-key-rec = "":U
      700       then do:
      701         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      702       end.
      703       assign
      704         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      705         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      706       .
      707       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      708       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      709       assign
      710         v-inform = bh_tbl-name:index-information(1)
      711         v-ind    = 2
      712       .
      713       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      714       on error undo, return error
      715       :
      716         assign
      717           v-inform = bh_tbl-name:index-information( v-ind )
      718           v-ind    = v-ind + 1
      719         .
      720       end.
      721       if v-inform = ?
      722         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      723         or entry( 3, v-inform, ",":U ) <> "1":U
      724       then do:
      725         delete object bh_tbl-name no-error.
      726         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      727       end.
      728       assign
      729         v-idx-field-qnty = num-entries( v-inform ) - 4
      730       .
      731       if v-idx-field-qnty < 2 then do:
      732         delete object bh_tbl-name no-error.
      733         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      734       end.
      735       assign
      736         p-field-list = "":U
      737         p-value-list = "":U
      738         v-delim-key  = "":U
      739         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      740         v-count-fld  = 0
      741       .
      742       block_where:
      743       do v-ind = 1 to v-idx-field-qnty by 2
      744       on error undo, return error
      745       :
      746         assign
      747           v-count-fld = v-count-fld + 1
      748         .
      749         if v-count-fld > v-field-num then do:
      750           leave block_where.
      751         end.
      752         assign
      753           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      754           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      755         .
      756         if v-ind = 1 then do:
      757           assign
      758             v-delim-key = chr(3)
      759           .
      760         end.
      761       end.
      762       delete object bh_tbl-name.
      763       if v-count-fld <> v-field-num then do:
      764         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      765       end.
      766     end.
      767   end procedure.
      768   procedure gen-key-field :
      769     define input  parameter p-table      as character no-undo .
      770     define output parameter p-field-list as character no-undo .
      771     do
      772     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      773     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      774     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      775     :
      776       define variable v-full-tbl-name  as character no-undo .
      777       define variable bh_tbl-name      as handle    no-undo .
      778       define variable v-tbl-name       as character no-undo .
      779       define variable v-field-num      as integer   no-undo .
      780       define variable v-count-fld      as integer   no-undo .
      781       define variable v-inform         as character no-undo .
      782       define variable v-ind            as integer   no-undo .
      783       define variable v-idx-field-qnty as integer   no-undo .
      784       define variable v-delim-key      as character no-undo .
      785       if p-table = ?
      786         or p-table = "":U
      787       then do:
      788         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
      789       end.
      790       assign
      791         v-tbl-name      = p-table
      792         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      793       .
      794       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      795       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
      796       assign
      797         v-inform = bh_tbl-name:index-information(1)
      798         v-ind    = 2
      799       .
      800       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      801       on error undo, return error
      802       :
      803         assign
      804           v-inform = bh_tbl-name:index-information( v-ind )
      805           v-ind    = v-ind + 1
      806         .
      807       end.
      808       if v-inform = ?
      809         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      810         or entry( 3, v-inform, ",":U ) <> "1":U
      811       then do:
      812         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      813       end.
      814       assign
      815         v-idx-field-qnty = num-entries( v-inform ) - 4
      816       .
      817       if v-idx-field-qnty < 2 then do:
      818         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      819       end.
      820       assign
      821         p-field-list = "":U
      822         v-delim-key  = "":U
      823         v-count-fld  = 0
      824       .
      825       block_where:
      826       do v-ind = 1 to v-idx-field-qnty by 2
      827       on error undo, return error
      828       :
      829         assign
      830           v-count-fld = v-count-fld + 1
      831         .
      832         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      833         if v-ind = 1 then do:
      834           assign
      835             v-delim-key = chr(3)
      836           .
      837         end.
      838       end.
      839       delete object bh_tbl-name.
      840     end.
      841   end procedure.
      842   procedure extsyssl :
      843   define parameter buffer buf_ext-system for ub.ext-system.
      844   define output parameter p-ok as logical   no-undo .
      845   define variable v-resource-id as character no-undo .
      846   define variable v-found as logical   no-undo .
      847   define buffer buf_some-lk for ub.some-lk.
      848   define buffer buf_ext-classif for ub.ext-classif.
      849   do
      850   on error undo, return error return-value
      851   :
      852     for each buf_ext-classif no-lock where
      853           buf_ext-classif.classif-subject = 'clients':U
      854       and buf_ext-classif.classif-name = 'clients-esys':U
      855       AND buf_ext-classif.db-num = 0
      856       AND buf_ext-classif.key#_one = buf_ext-system.esys-id
      857     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      858     on stop   undo , return error substitute( "&1. stop", vss-workfile )
      859     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
      860     :
      861       v-found = yes.
      862       leave.
      863     end.
      864     if v-found then do:
      865       undo, return error substitute("К данной внешней системе привязаны объекты&1" +
      866                           "изменение моды экспорта/импорта или БД для экспорта/импорта НЕВОЗМОЖНО", chr(10)).
      867     end.
      868     for each buf_ext-classif no-lock where
      869           buf_ext-classif.classif-subject = 'clients':U
      870       and buf_ext-classif.classif-name = 'clients-edoc-nn':U
      871       AND buf_ext-classif.db-num = -1
      872       AND buf_ext-classif.key#_one = buf_ext-system.esys-id
      873     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      874     on stop   undo , return error substitute( "&1. stop", vss-workfile )
      875     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
      876     :
      877       v-found = yes.
      878       leave.
      879     end.
      880     if v-found then do:
      881       undo, return error substitute("К данной внешней системе привязаны контрагенты&1" +
      882                           "изменение моды экспорта/импорта или БД для экспорта/импорта НЕВОЗМОЖНО", chr(10)).
      883     end.
      884     for each buf_ext-classif no-lock where
      885           buf_ext-classif.classif-subject = 'clients':U
      886       and buf_ext-classif.classif-name = 'exite-edi':U
      887       AND buf_ext-classif.db-num = -1
      888       AND buf_ext-classif.key#_one = buf_ext-system.esys-id
      889     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      890     on stop   undo , return error substitute( "&1. stop", vss-workfile )
      891     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
      892     :
      893       v-found = yes.
      894       leave.
      895     end.
      896     if v-found then do:
      897       undo, return error substitute("К данной внешней системе привязаны контрагенты&1" +
      898                           "изменение моды экспорта/импорта или БД для экспорта/импорта НЕВОЗМОЖНО", chr(10)).
      899     end.
      900     run gen-key-rec in this-procedure ( input 'ext-system':U
      901                                       ,input (buffer buf_ext-system:handle)
      902                                       ,output v-resource-id).
      903     for each buf_some-lk no-lock where
      904             buf_some-lk.resource_id = v-resource-id :
      905       leave.
      906     end.
      907     if available buf_some-lk then do:
      908       undo, return error substitute("Внешняя система используется").
      909     end.
      910     p-ok = yes.
      911   end.
      912   end procedure.
      913   define variable v-mess as character no-undo .
      914   define variable v-ok as logical   no-undo .
      915   define buffer buf_ext-system  for ub.ext-system.
      916   define buffer buf_esys-pck-sent for ub.esys-pck-sent.
      917   define buffer buf_esys-pck-rcvd for ub.esys-pck-rcvd.
      918   define buffer buf_esys-pck-keys for ub.esys-pck-keys.
      919   define buffer buf_esys-route for ub.esys-route.
      920   main-block:
      921   do
      922   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      923   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      924   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      925   :
      926     if g#db-num <> 0
      927     and not g#news
      928     then do:
      929       message
      930       vss-workfile vss-revision vss-description skip
      931       "Данная процедуры не может вызываться в УБД"
      932       view-as alert-box error .
      933       undo main-block, return error .
      934     end.
      935     find first buf_ext-system exclusive-lock where
      936           recid(buf_ext-system) = p-rec .
      937     if not (buf_ext-system.esys-type > integer('0':U)) then do:
      938       message
      939       vss-workfile vss-revision vss-description skip
      940       "Данная программа предназначена для удаления ТОЛЬКО СПЕЦИАЛЬНЫХ ВС"
      941       view-as alert-box error .
      942       undo, return error '':U.
      943     end.
      944     run extsyssl in this-procedure ( buffer buf_Ext-system
      945                                     ,output v-ok ) NO-ERROR.
      946     if not v-ok then do:
      947       v-mess = substitute("Данная внешняя система используется&1Удаление невозможно:&2&3"
      948                           , chr(10)
      949                           , chr(10)
      950                           ,  return-value
      951                           ).
      952       run err-mess in this-procedure ( input-output v-mess).
      953       return error (if p-silent = yes then v-mess else '':U).
      954     end.
      955     for each ub.rule-call-param no-lock where
      956           ub.rule-call-param.param-2-data-type = "ext-system"
      957     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      958     on stop   undo , return error substitute( "&1. stop", vss-workfile )
      959     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
      960     :
      961       v-ok = no.
      962       v-mess = v-mess + substitute ("профайл №&1 правило №&2&3", ub.rule-call-param.profile_id, ub.rule-call-param.rule_id, chr(10)).
      963     end.
      964     if not v-ok then do:
      965       v-mess = substitute("Данная внешняя система используется в настройках машины правил.&1Удаление невозможно:&2&3"
      966                           , chr(10)
      967                           , chr(10)
      968                           , v-mess
      969                           ).
      970       run err-mess in this-procedure ( input-output v-mess).
      971       return error (if p-silent = yes then v-mess else '':U).
      972     end.
      973     run waitfram-show in this-procedure ( input "Ждите... Идет удаление пакетов и данных маршрутизации").
      974     for each buf_esys-pck-sent where
      975           buf_esys-pck-sent.esys-id = buf_ext-system.esys-id
      976      and  buf_esys-pck-sent.db-num = buf_ext-system.db-num
      977      on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      978      on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      979      on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      980      :
      981       delete buf_esys-pck-sent .
      982     end.
      983     for each buf_esys-pck-rcvd where
      984           buf_esys-pck-rcvd.esys-id = buf_ext-system.esys-id
      985        and  buf_esys-pck-rcvd.db-num = buf_ext-system.db-num
      986      on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      987      on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      988      on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      989      :
      990       delete buf_esys-pck-rcvd .
      991     end.
      992     for each buf_esys-pck-keys where
      993           buf_esys-pck-keys.esys-id = buf_ext-system.esys-id
      994        and  buf_esys-pck-keys.db-num = buf_ext-system.db-num
      995      on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      996      on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      997      on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      998      :
      999       delete buf_esys-pck-keys  .
     1000     end.
     1001     for each buf_esys-route where
     1002           buf_esys-route.esys-id = buf_ext-system.esys-id
     1003        and  buf_esys-route.db-num = buf_ext-system.db-num
     1004      on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1005      on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1006      on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1007      :
     1008       delete buf_esys-route  .
     1009     end.
     1010     run waitfram-hide in this-procedure .
     1011     delete buf_ext-system.
     1012   end.
     1013   PROCEDURE err-mess:
     1014     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
     1015     CASE p-silent:
     1016       when yes then do:
     1017         assign
     1018         p-mess = substitute("Специальная внешняя система: код &1"
     1019                            , buf_ext-system.esys-id
     1020                            , p-mess)
     1021         .
     1022       end.
     1023       when no then do:
     1024         message
     1025         p-mess
     1026         view-as alert-box error .
     1027       end.
     1028     end.
     1029   END PROCEDURE.
