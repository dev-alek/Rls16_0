      602   define buffer buf_clients for ub.clients.
      603   define variable v-host-name as character no-undo.
      604   DEFINE BUTTON bt-sel-obj
      605        IMAGE-UP FILE "btn-down-arrow":U
      606        IMAGE-DOWN FILE "btn-down-arrow":U
      607        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      608        LABEL "..."
      609        SIZE 3.63 BY 1.04.
      610   DEFINE BUTTON Btn_OK AUTO-GO
      611        LABEL "&Выход"
      612        SIZE 15 BY 1.13
      613        BGCOLOR 8 .
      614   DEFINE BUTTON Btn_save
      615        LABEL "Сохранить"
      616        SIZE 15 BY 1.13.
      617   DEFINE VARIABLE cb-type AS CHARACTER FORMAT "X(256)":U
      618       LABEL "Тип выгрузки"
      619       VIEW-AS COMBO-BOX INNER-LINES 3
      620       LIST-ITEM-PAIRS "Малина ","mal ",
      621       "Система АТД", "atd"
      622       DROP-DOWN-LIST
      623       SIZE 16 BY 1 NO-UNDO.
      624   DEFINE VARIABLE EDITOR-objects AS CHARACTER
      625        VIEW-AS EDITOR NO-BOX
      626        SIZE 45 BY 3.38
      627        FGCOLOR 1  NO-UNDO.
      628   DEFINE VARIABLE d_date AS DATE FORMAT "99/99/9999":U
      629        LABEL "Дата"
      630        VIEW-AS FILL-IN
      631        SIZE 12 BY .96 NO-UNDO.
      632   DEFINE VARIABLE i_op-id AS INTEGER FORMAT "->,>>>,>>9" INITIAL 1
      633        LABEL "№ пакета"
      634        VIEW-AS FILL-IN
      635        SIZE 11 BY .96 NO-UNDO.
      636   DEFINE VARIABLE i_shift AS INTEGER FORMAT ">9":U INITIAL 0
      637        LABEL "Порядок смены"
      638        VIEW-AS FILL-IN
      639        SIZE 5 BY .96 NO-UNDO.
      640   DEFINE VARIABLE RADIO-SET_objects AS INTEGER
      641        VIEW-AS RADIO-SET VERTICAL
      642        RADIO-BUTTONS
      643             "по фирме", 1,
      644   "по объектам", 2
      645        SIZE 18 BY 3 NO-UNDO.
      646   DEFINE RECTANGLE RECT-1
      647        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      648        SIZE 69 BY 4.04.
      649   DEFINE RECTANGLE RECT-2
      650       EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      651       SIZE 69 BY 2.
      652   DEFINE FRAME Dialog-Frame
      653       Btn_OK AT ROW 1.25 COL 2
      654       Btn_save AT ROW 1.25 COL 18 WIDGET-ID 2
      655       cb-type AT ROW 4.25 COL 16.5 COLON-ALIGNED WIDGET-ID 22
      656       d_date AT ROW 7 COL 7.5 COLON-ALIGNED WIDGET-ID 4
      657       i_shift AT ROW 7 COL 38 COLON-ALIGNED WIDGET-ID 6
      658       i_op-id AT ROW 7 COL 58 COLON-ALIGNED WIDGET-ID 20
      659       EDITOR-objects AT ROW 9.25 COL 26 NO-LABEL WIDGET-ID 14
      660       RADIO-SET_objects AT ROW 9.5 COL 4 NO-LABEL WIDGET-ID 8
      661       bt-sel-obj AT ROW 11.25 COL 22 WIDGET-ID 18
      662       RECT-1 AT ROW 9 COL 2.5 WIDGET-ID 12
      663       RECT-2 AT ROW 3.75 COL 2.5 WIDGET-ID 24
      664       SPACE(2.12) SKIP(7.74)
      665       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      666       SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      667       TITLE "Изменение даты выгрузки данных "
      668       DEFAULT-BUTTON Btn_OK WIDGET-ID 100.
      669   ASSIGN
      670          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      671          FRAME Dialog-Frame:HIDDEN           = TRUE.
      672   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      673   DO:
      674     APPLY "END-ERROR":U TO SELF.
      675   END.
      676   ON CHOOSE OF bt-sel-obj IN FRAME Dialog-Frame
      677   DO:
      678       define variable v-obj-list as character no-undo.
      679       define variable v-exclude-obj-list as character no-undo.
      680       define variable v-object-available as logical no-undo.
      681       RADIO-SET_objects:screen-value = "2".
      682   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      683   run userobjs_clear in this-procedure  .
      684   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      685   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
      686     (input  v-cntxt-db-num
      687     ,input  0
      688     ,input  v-cntxt-userid
      689     ,input  v-cntxt-obj-type
      690     ,input  v-cntxt-obj-code
      691     ,output v-object-available
      692     ) no-error .
      693       if error-status :error then do:
      694           message vss-workfile vss-revision vss-description skip
      695           "Ошибка при вызове процедуры gbl/usobjava.i" skip
      696           error-status :get-message(1) skip
      697           return-value skip
      698           view-as alert-box error.
      699           undo, return no-apply.
      700       end.
      701       if v-object-available then do:
      702   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      703   run userobjs_append in this-procedure
      704     (input  v-cntxt-obj-type
      705     ,input  v-cntxt-obj-code
      706     )  .
      707       end.
      708       define variable v-user-select as logical no-undo.
      709   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      710   run userobjs_select-many in this-procedure
      711     (input  parparentproc
      712     ,input  v-cntxt-db-num
      713     ,input  v-cntxt-userid
      714     ,input  v-cntxt-host-code-obj
      715     ,input  v-cntxt-obj-type
      716     ,input  v-cntxt-obj-code
      717     ,output v-user-select
      718     )  .
      719       if v-user-select <> true then do:
      720         message "Объект не выбран" view-as alert-box information.
      721         return no-apply.
      722       end.
      723       v-obj-list = "".
      724       for each userobjs_temp-user-obj:
      725           v-obj-list = v-obj-list + (if v-obj-list <> "" then ", " else "")
      726                      + userobjs_temp-user-obj.obj-type + string( userobjs_temp-user-obj.obj-code).
      727       end.
      728       EDITOR-objects :screen-value = v-obj-list.
      729   END.
      730   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
      731   DO:
      732       APPLY "GO" TO FRAME Dialog-Frame.
      733   END.
      734   ON CHOOSE OF Btn_save IN FRAME Dialog-Frame
      735   DO:
      736       ASSIGN
      737       d_date
      738       i_shift
      739       i_op-id
      740       RADIO-SET_objects
      741       cb-type.
      742       if d_date = ? then do:
      743           message "Введите дату." view-as alert-box.
      744           return.
      745       end.
      746       case cb-type:
      747         when "mal" then do:
      748           if RADIO-SET_objects = 1 then do:
      749               for each buf_clients no-lock where buf_clients.host-code = v-cntxt-host-code-obj:
      750                   run clntattr-write in this-procedure (input buf_clients.obj-type
      751                                                        ,input buf_clients.obj-code
      752                                                        ,input 'bge-exp-malina-last-shift':U
      753                                                        ,input substitute ("&1,&2,&3",d_date ,i_shift,i_op-id)).
      754               end.
      755           end.
      756           else do:
      757               for each userobjs_temp-user-obj no-lock:
      758                   run clntattr-write in this-procedure (input userobjs_temp-user-obj.obj-type
      759                                                        ,input userobjs_temp-user-obj.obj-code
      760                                                        ,input 'bge-exp-malina-last-shift':U
      761                                                        ,input substitute ("&1,&2,&3",d_date ,i_shift,i_op-id)).
      762               end.
      763           end.
      764         end.
      765         when 'atd' then do:
      766           if RADIO-SET_objects = 1 then do:
      767               for each buf_clients no-lock where buf_clients.host-code = v-cntxt-host-code-obj:
      768                 run clntattr-write in this-procedure (input buf_clients.obj-type
      769                                   ,input buf_clients.obj-code
      770                                   ,input 'bge-exp-last-atd':U
      771                                   ,input substitute ("&1,&2",d_date ,(i_shift))).
      772               end.
      773           end.
      774           else do:
      775               for each userobjs_temp-user-obj no-lock:
      776                 run clntattr-write in this-procedure (input userobjs_temp-user-obj.obj-type
      777                                   ,input userobjs_temp-user-obj.obj-code
      778                                   ,input 'bge-exp-last-atd':U
      779                                   ,input substitute ("&1,&2",d_date ,(i_shift))).
      780               end.
      781           end.
      782         end.
      783         otherwise .
      784       end case.
      785   APPLY "GO" TO FRAME Dialog-Frame.
      786   END.
      787   ON VALUE-CHANGED OF cb-type IN FRAME Dialog-Frame
      788       DO:
      789           assign cb-type.
      790           if cb-type = "mal" then assign
      791                   i_shift:label  = "Порядок смены"
      792                   i_shift:format = "x(1)"
      793                   .
      794           run get-values in this-procedure.
      795       end.
      796   ON VALUE-CHANGED OF RADIO-SET_objects IN FRAME Dialog-Frame
      797   DO:
      798       case RADIO-SET_objects :screen-value in frame Dialog-frame:
      799           when "1" then do:
      800               EDITOR-objects:screen-value = v-host-name.
      801               hide bt-sel-obj in frame Dialog-Frame.
      802           end.
      803           when "2" then do:
      804               display bt-sel-obj with frame Dialog-Frame.
      805               for each userobjs_temp-user-obj:
      806                   delete userobjs_temp-user-obj.
      807               end.
      808               create userobjs_temp-user-obj.
      809               assign
      810                   userobjs_temp-user-obj.obj-type = v-cntxt-obj-type
      811                   userobjs_temp-user-obj.obj-code = v-cntxt-obj-code
      812                   EDITOR-objects:screen-value = v-cntxt-obj-type + string(v-cntxt-obj-code).
      813           end.
      814       end case.
      815   END.
      816   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      817   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      818   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      819   on ' ' of d_date in frame Dialog-Frame
      820   do:
      821     if (can-query (self, "sensitive")
      822        and
      823        self :sensitive = true
      824        )
      825     or (can-query (self, "read-only")
      826        and
      827        self :read-only = false
      828        )
      829     then do:
      830       assign
      831         self :screen-value = ?
      832       .
      833     end.
      834     return no-apply.
      835   end.
      836   on delete-character of d_date in frame Dialog-Frame
      837   do:
      838     if (can-query (self, "sensitive")
      839        and
      840        self :sensitive = true
      841        )
      842     or (can-query (self, "read-only")
      843        and
      844        self :read-only = false
      845        )
      846     then do:
      847       assign
      848         self :screen-value = ?
      849       .
      850     end.
      851     return no-apply.
      852   end.
      853   on ctrl-d of d_date in frame Dialog-Frame
      854   do:
      855     define variable v-curr-sv-date as date no-undo .
      856     if (can-query (self, "sensitive")
      857        and
      858        self :sensitive = true
      859        )
      860     or (can-query (self, "read-only")
      861        and
      862        self :read-only = false
      863        )
      864     then do:
      865       if self :handle <> focus :handle
      866       then do:
      867         apply "entry":u to self .
      868       end.
      869       run gbl/getcurdt.p
      870         (output v-curr-sv-date
      871         ) .
      872       assign
      873         self :screen-value = string(v-curr-sv-date) .
      874       .
      875     end.
      876     return no-apply.
      877   end.
      878   on ctrl-b of d_date in frame Dialog-Frame
      879   do:
      880     if (can-query (self, "sensitive")
      881        and
      882        self :sensitive = true
      883        )
      884     or (can-query (self, "read-only")
      885        and
      886        self :read-only = false
      887        )
      888     then do:
      889       if self :handle <> focus :handle
      890       then do:
      891         apply "entry":u to self .
      892       end.
      893       define variable v-curr-sv-date as date no-undo .
      894       define variable v-new-sv-date  as date no-undo .
      895       assign
      896         v-curr-sv-date = date(self :screen-value) no-error
      897       .
      898       if v-curr-sv-date = ?
      899       then do:
      900         run gbl/getcurdt.p
      901           (output v-curr-sv-date
      902           ) .
      903       end.
      904       if v-curr-sv-date <> ?
      905       then do:
      906         assign
      907           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      908         .
      909         assign
      910           self :screen-value = string(v-new-sv-date) .
      911         .
      912       end.
      913     end.
      914     return no-apply .
      915   end.
      916   on ctrl-e of d_date in frame Dialog-Frame
      917   do:
      918     if (can-query (self, "sensitive")
      919        and
      920        self :sensitive = true
      921        )
      922     or (can-query (self, "read-only")
      923        and
      924        self :read-only = false
      925        )
      926     then do:
      927       if self :handle <> focus :handle
      928       then do:
      929         apply "entry":u to self .
      930       end.
      931       define variable v-curr-sv-date as date no-undo .
      932       define variable v-new-sv-date  as date no-undo .
      933       assign
      934         v-curr-sv-date = date(self :screen-value) no-error
      935       .
      936       if v-curr-sv-date = ?
      937       then do:
      938         run gbl/getcurdt.p
      939           (output v-curr-sv-date
      940           ) .
      941       end.
      942       if v-curr-sv-date <> ?
      943       then do:
      944         run gbl/lastdate.p
      945           (input  v-curr-sv-date
      946           ,output v-new-sv-date
      947           ).
      948         assign
      949           self :screen-value = string(v-new-sv-date) .
      950         .
      951       end.
      952     end.
      953     return no-apply .
      954   end.
      955   on ctrl-f of d_date in frame Dialog-Frame
      956   do:
      957     if (can-query (self, "sensitive")
      958        and
      959        self :sensitive = true
      960        )
      961     or (can-query (self, "read-only")
      962        and
      963        self :read-only = false
      964        )
      965     then do:
      966       if self :handle <> focus :handle
      967       then do:
      968         apply "entry":u to self .
      969       end.
      970       define variable v-ok            as logical   no-undo .
      971       define variable v-curr-sv-date  as date      no-undo .
      972       define variable v-description   as character no-undo .
      973       assign
      974         v-curr-sv-date = date(self :screen-value) no-error
      975       .
      976       if v-curr-sv-date = ?
      977       then do:
      978         run gbl/getcurdt.p
      979           (output v-curr-sv-date
      980           ) .
      981       end.
      982       if v-curr-sv-date <> ?
      983       then do:
      984         run gbl/d-inpday.w
      985           (input ?
      986           ,input "Выбор даты"
      987           ,input v-description
      988           ,input ""
      989           ,input-output v-curr-sv-date
      990           ,output v-ok
      991           ).
      992         if v-ok = true
      993         then do:
      994           assign
      995             self :screen-value = string(v-curr-sv-date) .
      996           .
      997         end.
      998       end.
      999     end.
     1000     return no-apply .
     1001   end.
     1002     define MENU m-ed-date8
     1003       MENU-ITEM m-ed-date8-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1004       MENU-ITEM m-ed-date8-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1005       MENU-ITEM m-ed-date8-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1006       MENU-ITEM m-ed-date8-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1007       .
     1008     if d_date :POPUP-MENU in frame Dialog-Frame = ?
     1009     then do:
     1010       ASSIGN
     1011         d_date :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date8 :HANDLE
     1012         d_date :MENU-MOUSE in frame Dialog-Frame = 3
     1013       .
     1014     end.
     1015     define variable v-label-handle8 as handle no-undo .
     1016     assign
     1017       v-label-handle8 = d_date :side-label-handle in frame Dialog-Frame
     1018     .
     1019     if valid-handle (v-label-handle8)
     1020     then do:
     1021       if v-label-handle8 :tooltip = ""
     1022       or v-label-handle8 :tooltip = ?
     1023       then do:
     1024         assign
     1025           v-label-handle8 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     1026         .
     1027       end.
     1028     end.
     1029     ON CHOOSE OF MENU-ITEM m-ed-date8-1 in menu m-ed-date8 DO:
     1030       apply "ctrl-b":U to d_date in frame Dialog-Frame .
     1031     END.
     1032     ON CHOOSE OF MENU-ITEM m-ed-date8-2 in menu m-ed-date8 DO:
     1033       apply "ctrl-d":U to d_date in frame Dialog-Frame .
     1034     END.
     1035     ON CHOOSE OF MENU-ITEM m-ed-date8-3 in menu m-ed-date8 DO:
     1036       apply "ctrl-e":U to d_date in frame Dialog-Frame .
     1037     END.
     1038     ON CHOOSE OF MENU-ITEM m-ed-date8-4 in menu m-ed-date8 DO:
     1039       apply "ctrl-f":U to d_date in frame Dialog-Frame .
     1040     END.
     1041   MAIN-BLOCK:
     1042   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1043      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1044   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1045     run mainmenu_getcntxt in parparentproc
     1046       (output v-cntxt-db-num
     1047       ,output v-cntxt-userid
     1048       ,output v-cntxt-level
     1049       ,output v-cntxt-host-code-obj
     1050       ,output v-cntxt-obj-type
     1051       ,output v-cntxt-obj-code
     1052       ,output v-cntxt-db-num-obj
     1053       ,output v-cntxt-is-admin
     1054       ) .
     1055     run get-host-name in this-procedure ( output v-host-name ) no-error .
     1056     if error-status :error
     1057     then do:
     1058         message
     1059           vss-workfile vss-revision vss-description
     1060           skip "Ошибка при определении имени фирмы"
     1061           skip "Код фирмы:" v-cntxt-host-code-obj
     1062           skip "Имя фирмы будет отображаться как '" + 'орг':U + string( v-cntxt-host-code-obj ) + "'"
     1063           skip return-value
     1064           skip trim(error-status :get-message(1))
     1065                trim(error-status :get-message(2))
     1066                trim(error-status :get-message(3))
     1067                trim(error-status :get-message(4))
     1068                trim(error-status :get-message(5))
     1069         view-as alert-box warning.
     1070         assign
     1071             v-host-name = 'орг':U + string(v-cntxt-host-code-obj).
     1072       end.
     1073     run get-values in this-procedure.
     1074     RUN enable_UI.
     1075     WAIT-FOR GO OF FRAME Dialog-Frame.
     1076   END.
     1077   RUN disable_UI.
     1078   PROCEDURE disable_UI :
     1079     HIDE FRAME Dialog-Frame.
     1080   END PROCEDURE.
     1081   PROCEDURE enable_UI :
     1082       DISPLAY cb-type d_date i_shift i_op-id EDITOR-objects RADIO-SET_objects
     1083           WITH FRAME Dialog-Frame.
     1084       ENABLE RECT-1 RECT-2 Btn_OK Btn_save cb-type d_date i_shift i_op-id
     1085           RADIO-SET_objects bt-sel-obj
     1086           WITH FRAME Dialog-Frame.
     1087       VIEW FRAME Dialog-Frame.
     1088   END PROCEDURE.
     1089   PROCEDURE get-host-name :
     1090   do on error undo, return error:
     1091   define output parameter p-host-name as character no-undo.
     1092   define buffer buf_clients for ub.clients.
     1093       find first buf_clients no-lock where buf_clients.obj-type = 'орг':U
     1094                                        and buf_clients.obj-code = v-cntxt-host-code-obj no-error.
     1095       if not available buf_clients then do:
     1096           message vss-workfile vss-revision vss-description skip
     1097             "Не удалось найти текущую фирму" skip
     1098             return-value skip
     1099             trim(error-status :get-message(1))
     1100             trim(error-status :get-message(2))
     1101             trim(error-status :get-message(3))
     1102             trim(error-status :get-message(4))
     1103             trim(error-status :get-message(5))
     1104           view-as alert-box error.
     1105           undo, return error.
     1106       end.
     1107       else do:
     1108           p-host-name = buf_clients.obj-name.
     1109       end.
     1110   end.
     1111   END PROCEDURE.
     1112   PROCEDURE get-values :
     1113   define variable c_value as character no-undo.
     1114   define variable c_type as character no-undo.
     1115       case cb-type:
     1116         when "mal" then do:
     1117           run clntattr-value in this-procedure (input v-cntxt-obj-type,
     1118                                         input v-cntxt-obj-code,
     1119                                         input 'bge-exp-malina-last-shift':U,
     1120                                         output c_value,
     1121                                         output c_type) no-error.
     1122           if num-entries(c_value,",") = 3 then do:
     1123             assign
     1124               RADIO-SET_objects:screen-value in frame dialog-frame = "2"
     1125               EDITOR-objects :screen-value in frame Dialog-frame = v-cntxt-obj-type + string( v-cntxt-obj-code )
     1126             .
     1127             assign
     1128               EDITOR-objects
     1129               RADIO-SET_objects
     1130               d_date = date(entry(1,c_value,","))
     1131               i_shift = integer(entry(2,c_value,","))
     1132               i_op-id = integer(entry(3,c_value,","))
     1133             no-error.
     1134             display d_date i_shift i_op-id with frame Dialog-Frame.
     1135             create userobjs_temp-user-obj.
     1136             assign
     1137               userobjs_temp-user-obj.obj-code = v-cntxt-obj-code
     1138               userobjs_temp-user-obj.obj-type = v-cntxt-obj-type
     1139             .
     1140           end.
     1141         end.
     1142         when 'atd' then do:
     1143           run clntattr-value in this-procedure (input v-cntxt-obj-type,
     1144                                         input v-cntxt-obj-code,
     1145                                         input 'bge-exp-last-atd':U,
     1146                                         output c_value,
     1147                                         output c_type) no-error.
     1148           if num-entries(c_value,",") = 2 then do:
     1149             assign
     1150               RADIO-SET_objects:screen-value in frame dialog-frame = "2"
     1151               EDITOR-objects :screen-value in frame Dialog-frame = v-cntxt-obj-type + string( v-cntxt-obj-code )
     1152             .
     1153             assign
     1154               EDITOR-objects
     1155               RADIO-SET_objects
     1156               d_date = date(entry(1,c_value,","))
     1157               i_shift = integer(entry(2,c_value,","))
     1158               i_op-id = ?
     1159             no-error.
     1160             display d_date i_shift i_op-id with frame Dialog-Frame.
     1161             create userobjs_temp-user-obj.
     1162             assign
     1163               userobjs_temp-user-obj.obj-code = v-cntxt-obj-code
     1164               userobjs_temp-user-obj.obj-type = v-cntxt-obj-type
     1165             .
     1166           end.
     1167         end.
     1168         otherwise .
     1169       end case.
     1170   END PROCEDURE.
