      263         ,input  p-user-id
      264         ,input  p-host-code-obj
      265         ,input  p-obj-type
      266         ,input  p-obj-code
      267         ,INPUT  "b-sel"
      268         ,output p-user-select
      269         ,output p-select-obj-type
      270         ,output p-select-obj-code
      271         ) .
      272     end.
      273   end.
