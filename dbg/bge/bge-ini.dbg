        1   block-level on error undo, throw.
        2   define input  parameter strB        as character        no-undo.
        3   define output parameter strFRG-ACC  as character        no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision: db20b37e7994, 1993, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: SMMolotkov $":U .
        6   define variable vss-date        as character no-undo init "$Date: Fri Aug 23 12:08:20 2019 +0300 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: bge-ini.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: bge/bge-ini.p $":U .
        9   define variable vss-description as character no-undo init "Cоздание каталогов, секции и ключа для Экспорта XML".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define variable strBGE    as character    no-undo.
       65   define variable strDIR    as character    no-undo.
       66   strBGE = ibs.th.gbl.gbl-inipar:dirfrgAcc .
       67   if strBGE = ? then do :
       68        RUN makeFRGdir ( OUTPUT strDIR ).
       69        IF RETURN-VALUE = "OK"
       70        THEN DO:
       71          define variable v-err-message as character no-undo .
       72          v-err-message = ibs.th.gbl.gbl-inipar:PutKeyValue("BGE", "Dirfrg-acc", "\frg-acc") .
       73          if v-err-message > "" then do:
       74                message v-err-message
       75                   skip(1)
       76                        "Не удалось записать значение ключа"
       77                   skip "Dirfrg-acc в секции BGE ini-файла."
       78                   skip "Выгрузка данных невозможна."
       79                   skip(1)
       80                   skip "Снимите защиту от записи"
       81                   skip "или пропишите каталог выгрузки"
       82                   skip "в ini-файле вручную."
       83                view-as alert-box error.
       84                undo, return error .
       85            end.
       86            assign
       87               strFRG-ACC = strDIR + "\frg-acc"
       88            .
       89            RETURN "OK".
       90        END.
       91        ELSE RETURN "ERROR".
       92   end .
       93   else do :
       94     strFRG-ACC = strBGE .
       95     RETURN "OK".
       96   end .
       97   PROCEDURE makeFRGdir :
       98       define output parameter strDIR   as character        no-undo.
       99       define variable strQuest    as character    no-undo.
      100       run bge/bge-ini1.w (
      101             input strB
      102           , output strQuest
      103       ).
      104       IF strQuest = "OK"
      105       THEN DO:
      106           strQuest = "ERROR".
      107           run bge/bge-ini2.w (
      108                 input strB
      109               , OUTPUT strQuest
      110               , OUTPUT strDIR
      111           ) NO-ERROR.
      112           IF strQuest = "OK"
      113           AND NOT ERROR-STATUS:ERROR
      114           THEN DO:
      115             run bge/dir_cd.p (strDir + "\frg-acc", "CA").
      116             IF RETURN-VALUE = "ERROR" THEN RETURN "ERROR".
      117             run bge/dir_cd.p (strDir + "\frg-acc\dict", "CA").
      118             IF RETURN-VALUE = "ERROR" THEN RETURN "ERROR".
      119             run bge/dir_cd.p (strDir + "\frg-acc\exp-acc", "CA").
      120             IF RETURN-VALUE = "ERROR" THEN RETURN "ERROR".
      121             run bge/dir_cd.p (strDir + "\frg-acc\global", "CA").
      122             IF RETURN-VALUE = "ERROR" THEN RETURN "ERROR".
      123             RETURN "OK".
      124           END.
      125       END.
      126       RETURN "ERROR".
      127   END PROCEDURE.
