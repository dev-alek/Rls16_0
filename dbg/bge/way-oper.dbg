      986   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
      987                                             INPUT iFlagEmpty AS INTEGER).
      988       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
      989       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
      990           DO:
      991               IF iFlagEmpty = 0                           THEN RETURN "".
      992               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
      993               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
      994               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
      995               ELSE RETURN "".
      996           END.
      997       ELSE DO:
      998           run xmlchar-encode in this-procedure (
      999                 input sToPlace
     1000               , output sToPlace
     1001           ).
     1002           ASSIGN
     1003               sToPlace = sParName + '="' + sToPlace + '"'
     1004           .
     1005           RETURN sToPlace.
     1006       END.
     1007   END FUNCTION.
     1008   function bge-xml-date returns character
     1009   ( input p-date as date )
     1010   :
     1011     define variable v-date-str as character no-undo .
     1012     run bge-xml-date-to-str in this-procedure ( input   p-date
     1013                                               , output  v-date-str
     1014                                               ) .
     1015     return v-date-str.
     1016   end function.
     1017   function bge-xml-str-date returns character
     1018   ( input p-date-str as character )
     1019   :
     1020     define variable v-date-str as character no-undo .
     1021     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1022                                                   , output  v-date-str
     1023                                                   ) .
     1024     return v-date-str.
     1025   end function.
     1026   function bge-xml-normalize-dec returns decimal
     1027   ( input p-val as decimal )
     1028   :
     1029     return (if p-val = ? then 0 else p-val) .
     1030   end function.
     1031   PROCEDURE wp-XMLTagOpen:
     1032   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1033   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1034   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1035       define variable v-out-string    as character    no-undo.
     1036   do
     1037   on error undo, return error
     1038   :
     1039       if v-bge-xml-bgefmt = "dbf":U
     1040       then do:
     1041       end.
     1042       else do:
     1043           assign
     1044               v-out-string = substitute( "&1&2<&3&4>"
     1045                                       , chr(10)
     1046                                       , fill( " ":U, 4 * iTagLevel)
     1047                                       , sTagName
     1048                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1049                               )
     1050           .
     1051           put stream stmXMLOut unformatted
     1052               v-out-string
     1053           .
     1054       end.
     1055   end.
     1056   END PROCEDURE.
     1057   PROCEDURE wp-XMLTagPut:
     1058     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1059     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1060     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1061     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1062       define variable v-out-string    as character    no-undo.
     1063   do
     1064   on error undo, return error
     1065   :
     1066       if v-bge-xml-bgefmt = "dbf":U
     1067       then do:
     1068           if v-bge-xml-dbf-file-name <> "":U
     1069           then do:
     1070               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1071               export stream stmXMLOut
     1072                   sTagName
     1073                   sParValue
     1074               .
     1075               output stream stmXMLOut close.
     1076           end.
     1077       end.
     1078       else do:
     1079           IF  iFlagEmpty = 1
     1080           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1081           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1082           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1083           THEN DO:
     1084               run xmlchar-encode in this-procedure (
     1085                   input sParValue
     1086                   , output sParValue
     1087               ).
     1088               assign
     1089                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1090                                               , chr(10)
     1091                                               , FILL(" ", 4 * iTagLevel)
     1092                                               , sTagName
     1093                                               , sParValue
     1094                               )
     1095               .
     1096               PUT STREAM stmXMLOut UNFORMATTED
     1097                   v-out-string
     1098               .
     1099           END.
     1100       end.
     1101   end.
     1102   END PROCEDURE.
     1103   PROCEDURE wp-XMLTagClose:
     1104   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1105   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1106       define variable v-out-string    as character    no-undo.
     1107   do
     1108   on error undo, return error
     1109   :
     1110       if v-bge-xml-bgefmt = "dbf":U
     1111       then do:
     1112       end.
     1113       else do:
     1114           assign
     1115               v-out-string = substitute( "&1&2</&3>"
     1116                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1117                                   , fill( " ", 4 * iTagLevel )
     1118                                   , sTagName
     1119                           )
     1120           .
     1121           PUT STREAM stmXMLOut UNFORMATTED
     1122               v-out-string
     1123           .
     1124       end.
     1125   end.
     1126   END PROCEDURE.
     1127   PROCEDURE wp-XMLWriteLog:
     1128     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1129     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1130     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1131   define variable v-str              as character no-undo .
     1132   define variable v-error-append     as logical   no-undo .
     1133   define variable v-error-append-msg as character no-undo .
     1134   assign
     1135     v-str = chr(10)
     1136             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1137             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1138     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1139     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1140     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1141   .
     1142   run bge/bge-log.p (input v-str) no-error .
     1143   if error-status:error then do:
     1144     assign
     1145       v-error-append     = yes
     1146       v-error-append-msg = return-value
     1147     .
     1148   end.
     1149   run gbl/fileapnd.p
     1150     ( input sFileName
     1151     , input v-str
     1152     , input 10
     1153     ) no-error .
     1154   if error-status:error then do:
     1155     assign
     1156       v-error-append     = yes
     1157       v-error-append-msg = substitute( "&1&2&3"
     1158                                       , v-error-append-msg
     1159                                       , chr(10)
     1160                                       , return-value
     1161                                       )
     1162     .
     1163   end.
     1164   if v-error-append
     1165   then do:
     1166     return error substitute( "&1" , v-error-append-msg ) .
     1167   end.
     1168   END PROCEDURE.
     1169   PROCEDURE wp-XMLWriteEDT:
     1170     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1171     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1172     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1173       if valid-handle ( hEDT )
     1174       then do:
     1175           hEDT :move-to-eof().
     1176           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1177                                           OR sToWrite = "&Line") THEN "" ELSE
     1178                                           cur-time-string-sec() + " ").
     1179           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1180                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1181                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1182           hEDT :insert-string(chr(10)).
     1183       end.
     1184       process events.
     1185       output to 'bgescn.txt' append.
     1186           put unformatted
     1187               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1188                                           OR sToWrite = "&Line") THEN "" ELSE
     1189                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1190               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1191                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1192                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1193           .
     1194       output close.
     1195   END PROCEDURE.
     1196   PROCEDURE wp-XMLShowCNT:
     1197     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1198       if valid-handle( hCNT )
     1199       then do:
     1200           ASSIGN hCNT :VISIBLE = TRUE.
     1201       end.
     1202   END PROCEDURE.
     1203   PROCEDURE wp-XMLHideCNT:
     1204     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1205       if valid-handle( hCNT )
     1206       then do:
     1207           ASSIGN hCNT :VISIBLE = FALSE.
     1208       end.
     1209   END PROCEDURE.
     1210   PROCEDURE wp-XMLWriteCNT:
     1211     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1212     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1213       if valid-handle( hCNT )
     1214       then do:
     1215           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1216       end.
     1217   END PROCEDURE.
     1218   procedure bge-xml-write-header:
     1219   do
     1220   on error undo, return error
     1221   :
     1222   define input parameter p-xml-file-name  as character        no-undo.
     1223   define input parameter p-doc-name       as character        no-undo.
     1224   define input parameter p-version        as character        no-undo.
     1225   define input parameter p-db-num         as integer          no-undo.
     1226   define input parameter p-date-from      as date             no-undo.
     1227   define input parameter p-shift-num-from as integer          no-undo.
     1228   define input parameter p-date-to        as date             no-undo.
     1229   define input parameter p-shift-num-to   as integer          no-undo.
     1230   define input parameter p-obj-list       as character        no-undo.
     1231   define input parameter p-doc-type-list  as character        no-undo.
     1232   define input parameter p-pay-code       as logical          no-undo.
     1233   define input parameter p-cst            as logical          no-undo.
     1234   define input parameter p-parts          as logical          no-undo.
     1235   define input parameter p-chk-pay-code   as logical          no-undo.
     1236   define input parameter p-pay-desk       as logical          no-undo.
     1237   define input parameter p-pay-desk-cards as logical          no-undo.
     1238   define input parameter p-deleted        as logical          no-undo.
     1239   define input parameter p-opened-docs    as logical          no-undo.
     1240   define variable v-out-string    as character    no-undo.
     1241   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1242   assign
     1243       v-out-string = substitute( "&1&2&3"
     1244                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1245                           , chr(10)
     1246                           , "<IBS_Trade_House>":U )
     1247   .
     1248   put stream stmXMLOut unformatted
     1249       v-out-string
     1250   .
     1251   run wp-XMLTagOpen(1, "header","").
     1252   if v-bge-xml-bgeflold = "oracle":u
     1253   then do:
     1254     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1255     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1256     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1257     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1258     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1259   end.
     1260   run wp-XMLTagOpen( 2, "manifest", "").
     1261   run wp-XMLTagOpen( 3, "document", "").
     1262   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1263   run wp-XMLTagput( 4, "description", "", 0).
     1264   run wp-XMLTagput( 4, "version", p-version, 0).
     1265   run wp-XMLTagclose( 3, "document" ).
     1266   run wp-XMLTagclose( 2, "manifest" ).
     1267   run wp-XMLTagclose( 1, "header" ).
     1268   run wp-XMLTagOpen(1, "options","").
     1269   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1270   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1271   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1272   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1273   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1274   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1275   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1276   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1277   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1278   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1279   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1280   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1281   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1282   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1283   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1284   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1285   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1286   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1287   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1288   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1289   run wp-XMLTagClose(1, "options").
     1290   run wp-XMLTagOpen( 1, "body", "" ).
     1291   output stream stmXMLOut close.
     1292   end.
     1293   end procedure.
     1294   procedure xml-bge-write-footer:
     1295   do
     1296   on error undo, return error return-value
     1297   :
     1298   define input parameter p-xml-file-name as character    no-undo.
     1299   define variable v-error-num     as integer           no-undo.
     1300   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1301   run wp-XMLTagClose( 1, "body" ).
     1302   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1303   output stream stmXMLOut close.
     1304   if v-bge-xml-bgeflold = "oracle":u
     1305   then do:
     1306     define variable v-tmp-file-name         as character no-undo .
     1307     define variable v-zip-file-name         as character no-undo .
     1308     define variable v-exch-file-name        as character no-undo .
     1309     define variable v-heap-file-name        as character no-undo .
     1310     define variable v-i                     as integer   no-undo .
     1311     define variable v-file-name             as character no-undo .
     1312     define variable v-arc                   as character no-undo .
     1313     define variable v-str                   as character no-undo .
     1314     define variable v-exch-tmp-file-name    as character no-undo .
     1315     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1316     define variable v-bge-xml-exch-dir      as character no-undo .
     1317     define variable v-bge-xml-heap-dir      as character no-undo .
     1318     define variable v-bge-xml-compress-heap as logical   no-undo .
     1319     define variable v-home-dir              as character no-undo .
     1320     define variable v-os-command            as character no-undo .
     1321     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1322     if v-home-dir = ?
     1323     then do:
     1324       undo, return error substitute( "&1&2&3"
     1325                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1326                                     , chr(10)
     1327                                     , "Обратитесь к администратору.":u
     1328                                     ).
     1329     end.
     1330     assign
     1331       v-home-dir = v-home-dir
     1332     .
     1333     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1334     if error-status :error
     1335     then do:
     1336       undo, return error substitute( "&1&2&3"
     1337                                     , "Неверно задан каталог экспорта.":u
     1338                                     , chr(10)
     1339                                     , "Обратитесь к администратору.":u
     1340                                     ).
     1341     end.
     1342     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1343     if v-bge-xml-exch-dir = ?
     1344     then do:
     1345       undo, return error substitute( "&1&2&3"
     1346                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1347                                     , chr(10)
     1348                                     , "Обратитесь к администратору.":u
     1349                                     ).
     1350     end.
     1351     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1352     if error-status :error
     1353     then do:
     1354       undo, return error substitute( "&1&2&3"
     1355                                     , "Неверно задан каталог экспорта (exch).":u
     1356                                     , chr(10)
     1357                                     , "Обратитесь к администратору.":u
     1358                                     ).
     1359     end.
     1360     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1361     if v-bge-xml-heap-dir = ?
     1362     then do:
     1363       undo, return error substitute( "&1&2&3"
     1364                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1365                                     , chr(10)
     1366                                     , "Обратитесь к администратору.":u
     1367                                     ).
     1368     end.
     1369     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1370     if error-status :error
     1371     then do:
     1372       undo, return error substitute( "&1&2&3"
     1373                                     , "Неверно задан каталог экспорта (heap).":u
     1374                                     , chr(10)
     1375                                     , "Обратитесь к администратору.":u
     1376                                     ).
     1377     end.
     1378     get-key-value section "BGE" key "heap-compress" value v-str.
     1379     assign
     1380       v-i = int(v-str)
     1381     no-error .
     1382     if v-i = ? or v-i = 0
     1383     then do:
     1384       assign
     1385         v-bge-xml-compress-heap = no
     1386       .
     1387     end.
     1388     else do:
     1389       assign
     1390         v-bge-xml-compress-heap = yes
     1391       .
     1392     end.
     1393     assign
     1394       v-arc = search( "exe/7za.exe":u )
     1395     .
     1396     if v-arc = ? or v-arc = ""
     1397     then do:
     1398       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     1399     end.
     1400     assign
     1401       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     1402       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     1403       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     1404       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     1405       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     1406       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     1407       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     1408     .
     1409     run gbl/del-file.p (input v-tmp-file-name) .
     1410     run gbl/del-file.p (input v-zip-file-name) .
     1411     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     1412     if v-error-num > 0
     1413     then do:
     1414         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     1415                                      , p-xml-file-name + "xm1":u
     1416                                      , v-tmp-file-name
     1417                                      , v-error-num
     1418                                      ).
     1419     end.
     1420     assign
     1421       v-os-command     = substitute( "&1 a -tzip &2 &3"
     1422                                    , v-arc
     1423                                    , v-zip-file-name
     1424                                    , v-tmp-file-name
     1425                                    )
     1426     .
     1427     os-command silent value ( v-os-command ) .
     1428     run gbl/del-file.p (input v-heap-file-name) .
     1429     if v-bge-xml-compress-heap = no
     1430     then do:
     1431       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     1432       if v-error-num > 0
     1433       then do:
     1434           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1435                                        , v-tmp-file-name
     1436                                        , v-heap-file-name
     1437                                        , v-error-num
     1438                                        ) .
     1439       end.
     1440     end.
     1441     else do:
     1442       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     1443       if v-error-num > 0
     1444       then do:
     1445           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1446                                        , v-zip-file-name
     1447                                        , v-heap-file-name
     1448                                        , v-error-num
     1449                                        ) .
     1450       end.
     1451     end.
     1452     run gbl/del-file.p (input v-tmp-file-name) .
     1453     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     1454     if error-status :error then do:
     1455       undo, return error substitute( "&1&2&3"
     1456                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     1457                                     , chr(10)
     1458                                     , "Обратитесь к администратору."
     1459                                     ).
     1460     end.
     1461     run gbl/del-file.p (input v-exch-file-name) .
     1462     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     1463     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     1464     if v-error-num > 0
     1465     then do:
     1466       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1467                                     , v-zip-file-name
     1468                                     , v-exch-tmp-file-name
     1469                                     , v-error-num
     1470                                     ) .
     1471     end.
     1472     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     1473     if v-error-num > 0
     1474     then do:
     1475       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1476                                     , v-exch-tmp-file-name
     1477                                     , v-exch-file-name
     1478                                     , v-error-num
     1479                                     ) .
     1480     end.
     1481     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     1482   end.
     1483   else do:
     1484     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1485     if v-error-num > 0
     1486     then do:
     1487       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1488                                     , p-xml-file-name + "xm1"
     1489                                     , p-xml-file-name + "xml"
     1490                                     , v-error-num
     1491                                     ) .
     1492     end.
     1493   end.
     1494   if opsys = "unix"
     1495   then do:
     1496       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1497   end.
     1498   end.
     1499   end procedure.
     1500   procedure xml-bge-filename0:
     1501   define input parameter p-prefix   as character no-undo .
     1502   define input parameter p-name     as character no-undo .
     1503   define input parameter p-shared-process as logical no-undo .
     1504   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     1505   define output parameter p-xml-file-name  as character no-undo .
     1506   // define output parameter p-fullfnamenoext as character no-undo .
     1507   define output parameter p-locked         as logical      no-undo.
     1508   define variable v-fullfnamenoext as character no-undo .
     1509   define variable v-fileext        as character no-undo .
     1510   define variable v-fullfname      as character no-undo .
     1511   define variable v-error-num      as integer   no-undo .
     1512   do
     1513   on error undo, return error
     1514   :
     1515     case v-bge-xml-bgeflold :
     1516       when "old" then do:
     1517         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     1518         v-fileext       = ".xml":U .
     1519         v-fullfname     = v-fullfnamenoext + v-fileext .
     1520         p-xml-file-name = v-fullfname .
     1521         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1522         if v-error-num > 0 then do:
     1523           return error.
     1524         end.
     1525       end.
     1526       when "var" then do:
     1527         case p-prefix :
     1528           when "doc" then do:
     1529             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     1530             v-fileext       = ".xml":U .
     1531             v-fullfname     = v-fullfnamenoext + v-fileext .
     1532             p-xml-file-name = v-fullfname .
     1533           end.
     1534           when "day" then do:
     1535             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     1536             v-fileext       = ".xml":U .
     1537             v-fullfname     = v-fullfnamenoext + v-fileext .
     1538             p-xml-file-name = v-fullfname .
     1539           end.
     1540           otherwise do:
     1541             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1542             v-fileext       = ".xml":U .
     1543             v-fullfname     = v-fullfnamenoext + v-fileext .
     1544             p-xml-file-name = v-fullfname .
     1545           end.
     1546         end case.
     1547         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1548         if v-error-num > 0 then do:
     1549           return error.
     1550         end.
     1551       end.
     1552       when "new" then do:
     1553                   run bge/genfname.p (
     1554                       input p-home-dir
     1555                       , input p-prefix
     1556                       , input ""
     1557                       , input "xml"
     1558                       , input ""
     1559                       , output p-xml-file-name
     1560                   ).
     1561       end.
     1562       when "no-parameter" then do:
     1563         if p-shared-process then do:
     1564                       run bge/genfname.p (
     1565                           input p-home-dir
     1566                           , input "d"
     1567                           , input ""
     1568                           , input "xml"
     1569                           , input ""
     1570                           , output p-xml-file-name
     1571                       ).
     1572         end.
     1573         else do:
     1574           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1575           v-fileext       = ".xml":U .
     1576           v-fullfname     = v-fullfnamenoext + v-fileext .
     1577           p-xml-file-name = v-fullfname .
     1578           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1579           if v-error-num > 0 then do:
     1580             return error.
     1581           end.
     1582         end.
     1583       end.
     1584     end case.
     1585     assign
     1586       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1587       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     1588     .
     1589   end .
     1590   end procedure .
     1591   procedure xml-bge-filename :
     1592   do
     1593   on error undo, return error
     1594   :
     1595   define input parameter p-prefix             as character    no-undo.
     1596   define input parameter p-name               as character    no-undo.
     1597   define input parameter p-shared-process     as logical      no-undo.
     1598   define output parameter p-xml-file-name     as character    no-undo.
     1599   define output parameter p-log-file-name     as character    no-undo.
     1600   define output parameter p-locked            as logical      no-undo.
     1601   define variable v-home-dir          as character no-undo .
     1602   define variable v-error-num         as integer   no-undo .
     1603   define variable v-bge-xml-heap-dir  as character no-undo .
     1604       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1605       if v-home-dir = ?
     1606       then do:
     1607           message
     1608             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1609             skip(1)
     1610             skip "Обратитесь к администратору."
     1611           view-as alert-box error.
     1612           undo, return error .
     1613       end.
     1614       if v-bge-xml-bgeflold <> "oracle"
     1615       then do:
     1616         assign
     1617             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     1618         .
     1619       end.
     1620       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1621       if error-status :error
     1622       then do:
     1623           message
     1624             skip "Неверно задан каталог экспорта."
     1625             skip(1)
     1626             skip "Обратитесь к администратору."
     1627           view-as alert-box error.
     1628           undo, return error .
     1629       end.
     1630       if v-bge-xml-bgefmt = "dbf":U
     1631       then do:
     1632           assign
     1633               p-xml-file-name = v-home-dir
     1634               p-locked        = no
     1635           .
     1636       end.
     1637       else do:
     1638           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     1639             output p-xml-file-name, output p-locked) .
     1640       end.
     1641       if v-bge-xml-bgeflold = "oracle"
     1642       then do:
     1643         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1644         if v-bge-xml-heap-dir = ?
     1645         then do:
     1646           undo, return error substitute( "&1&2&3"
     1647                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1648                                         , chr(10)
     1649                                         , "Обратитесь к администратору.":u
     1650                                         ).
     1651         end.
     1652         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1653         if error-status :error
     1654         then do:
     1655           undo, return error substitute( "&1&2&3"
     1656                                         , "Неверно задан каталог экспорта (heap).":u
     1657                                         , chr(10)
     1658                                         , "Обратитесь к администратору.":u
     1659                                         ).
     1660         end.
     1661         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     1662           assign
     1663             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     1664           .
     1665         end.
     1666         else do:
     1667           assign
     1668             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     1669           .
     1670         end.
     1671       end.
     1672       else do:
     1673         assign
     1674             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     1675         .
     1676       end.
     1677       assign
     1678          v-bge-xml-static-log-file-name = p-log-file-name
     1679       .
     1680   end.
     1681   end procedure.
     1682   procedure bge-xml-read-config :
     1683   do
     1684   on error undo, return error return-value
     1685   :
     1686   define input  parameter p-last-date as date      no-undo .
     1687   define input  parameter p-db-num    as integer   no-undo .
     1688       define variable v-bgeclall      as character     no-undo.
     1689       define variable v-bgedict       as character     no-undo.
     1690       define variable v-bgeshift      as character     no-undo.
     1691       define variable v-par-type      as character     no-undo.
     1692       define variable v-bgeflnm       as character     no-undo.
     1693       define variable v-bgecliiv      as character     no-undo .
     1694       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     1695       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     1696       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     1697       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     1698       define variable v-db-num-str    as character     no-undo .
     1699       define variable v-param-type      as character  no-undo .
     1700       define variable v-value-character as character  no-undo .
     1701       define variable v-value-date      as date       no-undo .
     1702       define variable v-value-decimal   as decimal    no-undo .
     1703       define variable v-value-integer   as integer    no-undo .
     1704       define variable v-value-logical   as logical    no-undo .
     1705       define variable v-tth             as handle      no-undo .
     1706       run adm/shattri.p ( input "get":U
     1707                         , input  '':u
     1708                         , input  0
     1709                         , input  'bge-export':U
     1710                         , input  'bgeclall':U
     1711                         , output v-bgecliiv
     1712                         , output v-value-date
     1713                         , output v-value-decimal
     1714                         , output v-value-integer
     1715                         , output v-value-logical
     1716                         , output v-param-type
     1717                         , input-output table-handle v-tth
     1718                         ) no-error .
     1719       if error-status :error
     1720       then do:
     1721         assign
     1722           v-bge-xml-bgecliiv = no
     1723         .
     1724       end.
     1725       else do:
     1726         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     1727       end.
     1728       delete object v-tth.
     1729       assign
     1730           v-bge-xml-bgeclall = no
     1731           v-bge-xml-bgedict  = no
     1732       .
     1733       run adm/shattri.p ( input "get":U
     1734                         , input  '':u
     1735                         , input  0
     1736                         , input  'bge-export':U
     1737                         , input  'bgeclall':U
     1738                         , output v-value-character
     1739                         , output v-value-date
     1740                         , output v-value-decimal
     1741                         , output v-value-integer
     1742                         , output v-value-logical
     1743                         , output v-param-type
     1744                         , input-output table-handle v-tth
     1745                         ) no-error .
     1746       if error-status :error
     1747       then do:
     1748         assign
     1749           v-bge-xml-bgeclall = no
     1750         .
     1751       end.
     1752       else do:
     1753         assign
     1754           v-bge-xml-bgeclall = v-value-logical
     1755         .
     1756       end.
     1757       delete object v-tth.
     1758       run adm/shattri.p ( input "get":U
     1759                         , input  '':u
     1760                         , input  0
     1761                         , input  'bge-export':U
     1762                         , input  'bgedict':U
     1763                         , output v-value-character
     1764                         , output v-value-date
     1765                         , output v-value-decimal
     1766                         , output v-value-integer
     1767                         , output v-value-logical
     1768                         , output v-param-type
     1769                         , input-output table-handle v-tth
     1770                         ) no-error .
     1771       if error-status :error
     1772       then do:
     1773         assign
     1774           v-bge-xml-bgedict = no
     1775         .
     1776       end.
     1777       else do:
     1778         assign
     1779           v-bge-xml-bgedict = v-value-logical
     1780         .
     1781       end.
     1782       delete object v-tth.
     1783       run adm/shattri.p ( input "get":U
     1784                         , input  '':u
     1785                         , input  0
     1786                         , input  'bge-export':U
     1787                         , input  'bgefmt':U
     1788                         , output v-value-character
     1789                         , output v-value-date
     1790                         , output v-value-decimal
     1791                         , output v-value-integer
     1792                         , output v-value-logical
     1793                         , output v-param-type
     1794                         , input-output table-handle v-tth
     1795                         ) no-error .
     1796       if error-status :error
     1797       then do:
     1798         assign
     1799           v-bge-xml-bgefmt  = "xml":U
     1800         .
     1801       end.
     1802       else do:
     1803         assign
     1804           v-bge-xml-bgefmt  = v-value-character
     1805         .
     1806       end.
     1807       delete object v-tth.
     1808       run adm/shattri.p ( input "get":U
     1809                         , input  '':u
     1810                         , input  0
     1811                         , input  'bge-export':U
     1812                         , input  'bgeshift':U
     1813                         , output v-value-character
     1814                         , output v-value-date
     1815                         , output v-value-decimal
     1816                         , output v-value-integer
     1817                         , output v-value-logical
     1818                         , output v-param-type
     1819                         , input-output table-handle v-tth
     1820                         ) no-error .
     1821       if error-status :error
     1822       then do:
     1823         assign
     1824             v-bge-xml-shift-mode = no
     1825         .
     1826       end.
     1827       else do:
     1828         assign
     1829             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     1830         .
     1831       end.
     1832       delete object v-tth.
     1833       run adm/shattri.p ( input "get":U
     1834                         , input  '':u
     1835                         , input  0
     1836                         , input  'bge-export':U
     1837                         , input  'bgeflold':U
     1838                         , output v-value-character
     1839                         , output v-value-date
     1840                         , output v-value-decimal
     1841                         , output v-value-integer
     1842                         , output v-value-logical
     1843                         , output v-param-type
     1844                         , input-output table-handle v-tth
     1845                         ) no-error .
     1846       if error-status :error
     1847       then do:
     1848         assign
     1849           v-bge-xml-bgeflold = "no-parameter":U
     1850         .
     1851       end.
     1852       else do:
     1853         assign
     1854           v-bge-xml-bgeflold  = v-value-character
     1855         .
     1856       end.
     1857       delete object v-tth.
     1858       assign
     1859         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     1860         v-bge-xml-db-num-str  = v-db-num-str
     1861       .
     1862       if p-last-date <> ?
     1863       then do:
     1864           run adm/shattri.p ( input "get":U
     1865                             , input  '':u
     1866                             , input  0
     1867                             , input  'bge-export':U
     1868                             , input  'bgeflnm':U
     1869                             , output v-value-character
     1870                             , output v-value-date
     1871                             , output v-value-decimal
     1872                             , output v-value-integer
     1873                             , output v-value-logical
     1874                             , output v-param-type
     1875                             , input-output table-handle v-tth
     1876                             ) no-error .
     1877           if error-status :error
     1878           then do:
     1879             assign
     1880               v-bgeflnm = '':U
     1881             .
     1882           end.
     1883           else do:
     1884             assign
     1885               v-bgeflnm = v-value-character
     1886             .
     1887           end.
     1888           delete object v-tth.
     1889           if v-bge-xml-bgeflold = "var"
     1890           then do:
     1891               if v-bgeflnm = ?
     1892               or num-entries( v-bgeflnm ) < 2
     1893               then do:
     1894                   assign
     1895                       v-bge-xml-bgeflold = "new"
     1896                   .
     1897               end.
     1898               else do:
     1899                   assign
     1900                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     1901                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     1902                   .
     1903                   assign
     1904                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     1905                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     1906                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1907                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     1908                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     1909                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     1910                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1911                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     1912                   .
     1913               end.
     1914           end.
     1915       end.
     1916   end.
     1917   end procedure.
     1918   procedure bge-xml-get-ref-filename :
     1919   define input parameter p-in-file-name       as character        no-undo.
     1920   define output parameter p-home-dir          as character        no-undo.
     1921   define output parameter p-out-file-name     as character        no-undo.
     1922   define output parameter p-locked            as logical          no-undo.
     1923       define variable v-counter       as integer      no-undo.
     1924       define variable v-error-level   as integer      no-undo.
     1925   do
     1926   on error undo, return error
     1927   :
     1928       run bge/bge-ini.p (
     1929             input "bge"
     1930           , output p-home-dir
     1931       ).
     1932       if return-value <> "OK"
     1933       then do:
     1934           undo, return error.
     1935       end.
     1936       assign
     1937           p-home-dir = p-home-dir + "\dict":U
     1938       .
     1939       run bge/dir_cd.p (
     1940           input p-home-dir
     1941           , input "CA"
     1942       ).
     1943       if return-value = "ERROR"
     1944       then do:
     1945           undo, return error.
     1946       end.
     1947       assign
     1948           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     1949       .
     1950       assign
     1951           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     1952       .
     1953       wait-lock:
     1954       do v-counter = 1 TO 3
     1955       :
     1956           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     1957           if p-locked = no
     1958           then do:
     1959               leave wait-lock.
     1960           end.
     1961           else do:
     1962               readkey pause 1.
     1963           end.
     1964       END.
     1965       if p-locked = yes
     1966       then do:
     1967           undo, return error.
     1968       end.
     1969       run bge/os_copy.p (
     1970             input "D":U
     1971           , input p-out-file-name + "xml":U
     1972           , input "":U
     1973           , output v-error-level
     1974       ).
     1975       if v-error-level > 0
     1976       then do:
     1977           undo, return error.
     1978       end.
     1979   end.
     1980   end procedure.
     1981   procedure bge-xml-write-ref-header :
     1982   define input parameter p-bge-name as character        no-undo.
     1983   define input parameter p-file-name as character        no-undo.
     1984       define variable v-out-string    as character    no-undo.
     1985   do
     1986   on error undo, return error
     1987   :
     1988       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     1989       put stream stmXMLOut unformatted
     1990           "<?xml version='1.0' encoding='windows-1251'?>":U
     1991       .
     1992       assign
     1993           v-out-string = substitute( "&1&2"
     1994                               , chr(10)
     1995                               , "<IBS_Trade_House>":U )
     1996       .
     1997       put stream stmXMLOut unformatted
     1998           v-out-string
     1999       .
     2000       run wp-XMLTagOpen( 1, "header", "" ).
     2001       if v-bge-xml-bgeflold = "oracle":u
     2002       then do:
     2003         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     2004         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     2005         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     2006         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     2007         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     2008       end.
     2009       else do:
     2010         run wp-XMLTagOpen( 2, "delivery", "" ).
     2011         run wp-XMLTagOpen( 3, "to", "" ).
     2012         run wp-XMLTagClose( 3, "to" ).
     2013         run wp-XMLTagOpen( 3, "from", "" ).
     2014         run wp-XMLTagClose( 3, "from" ).
     2015         run wp-XMLTagClose( 2, "delivery" ).
     2016       end.
     2017       run wp-XMLTagOpen( 2, "manifest", "" ).
     2018       run wp-XMLTagOpen( 3, "document", "" ).
     2019       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2020       run wp-XMLTagPut( 4, "description", "", 0 ).
     2021       run wp-XMLTagClose( 3, "document" ).
     2022       run wp-XMLTagClose( 2, "manifest" ).
     2023       run wp-XMLTagClose( 1, "header" ).
     2024       run wp-XMLTagOpen( 1, "body", "" ).
     2025   end.
     2026   end procedure.
     2027   procedure bge-xml-write-ref-footer :
     2028   define input parameter p-file-name as character        no-undo.
     2029       define variable v-error-level   as integer      no-undo.
     2030   do
     2031   on error undo, return error
     2032   :
     2033       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2034       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2035       output stream stmXMLOut close.
     2036       run bge/os_copy.p (
     2037             input "M":U
     2038           , input p-file-name + "xm1":U
     2039           , input p-file-name + "xml":U
     2040           , output v-error-level
     2041       ).
     2042       if v-error-level > 0
     2043       then do:
     2044           undo, return error.
     2045       end.
     2046   end.
     2047   end procedure.
     2048   procedure bge-xml-out-dir :
     2049   define output parameter p-out-dir       as character    no-undo.
     2050   define output parameter p-log-file-name as character    no-undo.
     2051   do
     2052   on error undo, return error
     2053   :
     2054       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2055       if p-out-dir = ?
     2056       then do:
     2057           message
     2058             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2059                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2060             skip(1)
     2061             skip "Обратитесь к администратору."
     2062           view-as alert-box error.
     2063           undo, return error .
     2064       end.
     2065       if v-bge-xml-bgeflold <> "oracle" then assign
     2066         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2067       .
     2068       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2069       if error-status :error  then do:
     2070           run wp-XMLWriteLog in this-procedure (
     2071                 input p-log-file-name
     2072               , input 0
     2073               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2074                                   , p-out-dir
     2075                                   , return-value
     2076                                   , trim( error-status :get-message( 1 ) )
     2077                                   )
     2078           ).
     2079           undo, return error.
     2080       end.
     2081       assign
     2082           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2083           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2084       .
     2085   end.
     2086   end procedure.
     2087   procedure bge-xml-out-dir2 :
     2088   define output parameter p-out-dir       as character    no-undo.
     2089   define output parameter p-out-dirR      as character    no-undo.
     2090   define output parameter p-log-file-name as character    no-undo.
     2091   do
     2092   on error undo, return error
     2093   :
     2094       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2095       if p-out-dir = ?
     2096       then do:
     2097           message
     2098             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2099                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2100             skip(1)
     2101             skip "Обратитесь к администратору."
     2102           view-as alert-box error.
     2103           undo, return error .
     2104       end.
     2105       if v-bge-xml-bgeflold <> "oracle" then assign
     2106             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2107             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2108         .
     2109       else p-out-dirR = p-out-dir .
     2110       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2111       if error-status :error  then do:
     2112           run wp-XMLWriteLog in this-procedure (
     2113                 input p-log-file-name
     2114               , input 0
     2115               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2116                                   , p-out-dir
     2117                                   , return-value
     2118                                   , error-status :get-message( 1 )
     2119                                   )
     2120           ).
     2121           undo, return error.
     2122       end.
     2123       if p-out-dirR <> p-out-dir then do:
     2124         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2125         if error-status :error then do:
     2126           run wp-XMLWriteLog in this-procedure (
     2127                 input p-log-file-name
     2128               , input 0
     2129               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2130                                   , p-out-dirR
     2131                                   , return-value
     2132                                   , error-status :get-message( 1 )
     2133                                   )
     2134           ).
     2135           p-out-dirR = p-out-dir .
     2136         end.
     2137       end .
     2138       assign
     2139         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2140         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2141       .
     2142   end.
     2143   end procedure.
     2144   procedure bge-xml-out-file :
     2145   do
     2146   on error undo, return error
     2147   :
     2148   define input parameter p-out-dir            as character        no-undo.
     2149   define input parameter p-prefix             as character        no-undo.
     2150   define input parameter p-sheduled           as logical          no-undo.
     2151   define output parameter p-xml-file-name     as character        no-undo.
     2152   define output parameter p-locked            as logical          no-undo.
     2153   define variable v-home-dir      as character     no-undo.
     2154   define variable v-error-num     as integer       no-undo.
     2155   define variable v-today             as date         no-undo.
     2156   define variable v-time              as integer      no-undo.
     2157       if v-bge-xml-bgefmt = "dbf":U
     2158       then do:
     2159           assign
     2160               p-xml-file-name = p-out-dir
     2161               p-locked        = no
     2162           .
     2163       end.
     2164       else do:
     2165           if v-bge-xml-bgeflold = "firm":U
     2166           then do:
     2167               run bge/genfname.p (
     2168                     input p-out-dir
     2169                   , input p-prefix
     2170                   , input "":U
     2171                   , input "arj":U
     2172                   , input "":U
     2173                   , output p-xml-file-name
     2174               ).
     2175           end.
     2176           else do:
     2177               run bge/genfname.p (
     2178                     input p-out-dir
     2179                   , input p-prefix
     2180                   , input "":U
     2181                   , input "xml":U
     2182                   , input "":U
     2183                   , output p-xml-file-name
     2184               ).
     2185           end.
     2186           assign
     2187               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2188               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2189           .
     2190       end.
     2191   end.
     2192   end procedure.
     2193   procedure bge-xml-init-ext-doc-type :
     2194       define variable v-counter    as integer      no-undo.
     2195       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2196   do
     2197   for buf_temp_ext-doc-type
     2198   on error undo, return error
     2199   :
     2200       empty temp-table buf_temp_ext-doc-type.
     2201       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2202       :
     2203           create buf_temp_ext-doc-type.
     2204           assign
     2205               buf_temp_ext-doc-type.edt-key               = v-counter
     2206               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2207               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2208           .
     2209       end.
     2210   end.
     2211   end procedure.
     2212   procedure bge-xml-get-decimal-shift-num :
     2213   define input parameter p-shift-date     as date             no-undo.
     2214   define input parameter p-shift-num      as integer          no-undo.
     2215   define output parameter p-shift-decimal as decimal          no-undo.
     2216   do
     2217   on error undo, return error
     2218   :
     2219       assign
     2220           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2221       .
     2222   end.
     2223   end procedure.
     2224   procedure bge-xml-ora-exp-filename :
     2225     define input  parameter p-table-name  as character no-undo .
     2226     define input  parameter p-doc-code    as character no-undo .
     2227     define input  parameter p-obj-code    as integer   no-undo .
     2228     define output parameter p-filename    as character no-undo .
     2229     define output parameter p-seq-num     as integer   no-undo .
     2230     define variable v-ora-exp-seq     as integer   no-undo .
     2231     define variable v-ora-exp-seq-str as character no-undo .
     2232     define variable v-home-dir        as character no-undo.
     2233   do
     2234   on error undo, return error return-value
     2235   :
     2236     if v-bge-xml-bgeflold = "oracle":u
     2237     then do:
     2238       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2239       if v-home-dir = ?
     2240       then do:
     2241         undo, return error substitute( "&1&2&3":U
     2242                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2243                                       , chr(10)
     2244                                       , "Обратитесь к администратору.":U
     2245                                       ).
     2246       end.
     2247       assign
     2248           v-home-dir = v-home-dir
     2249       .
     2250       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2251       if error-status :error
     2252       then do:
     2253         undo, return error substitute( "&1&2&3":U
     2254                                       , "Неверно задан каталог экспорта.":U
     2255                                       , chr(10)
     2256                                       , "Обратитесь к администратору.":U
     2257                                       ).
     2258       end.
     2259       assign
     2260         v-ora-exp-seq = ?
     2261       .
     2262       if  p-table-name <> ? and
     2263           p-doc-code <> ?
     2264       then do:
     2265         run bge/get-oesq.p ( input p-table-name
     2266                            , input p-doc-code
     2267                            , output v-ora-exp-seq
     2268                            ) no-error .
     2269         if error-status :error = yes
     2270         then do:
     2271           undo, return error return-value .
     2272         end.
     2273       end.
     2274       if v-ora-exp-seq = ?
     2275       then do:
     2276         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2277         if error-status :error
     2278         then do:
     2279           undo, return error return-value .
     2280         end.
     2281       end.
     2282       if p-table-name <> ? and
     2283          p-doc-code   <> ?
     2284       then do:
     2285         run bge/oesqdoc.p ( input p-table-name
     2286                           , input p-doc-code
     2287                           , input v-ora-exp-seq
     2288                           ) no-error .
     2289         if error-status :error = yes
     2290         then do:
     2291           undo, return error return-value .
     2292         end.
     2293       end.
     2294       assign
     2295         p-seq-num  = v-ora-exp-seq
     2296         p-filename = substitute("&1/&2-000_&3."
     2297                                , v-home-dir
     2298                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2299                                , string(v-ora-exp-seq , "999999999")
     2300                                )
     2301       .
     2302     end.
     2303   end.
     2304   end procedure.
     2305   procedure bge-xml-date-to-str :
     2306     define input  parameter p-date  as date      no-undo .
     2307     define output parameter p-str   as character no-undo .
     2308   do
     2309   on error undo, return error return-value
     2310   :
     2311     if p-date <> ?
     2312     then do:
     2313       assign
     2314         p-str = substitute( "&1-&2-&3"
     2315                           , string( year(p-date)  , "9999")
     2316                           , string( month(p-date) , "99"  )
     2317                           , string( day(p-date)   , "99"  )
     2318                           )
     2319       .
     2320     end.
     2321     else do:
     2322       assign
     2323         p-str = ?
     2324       .
     2325     end.
     2326   end.
     2327   end procedure.
     2328   procedure bge-xml-date-str-to-str :
     2329     define input  parameter p-date-str  as character no-undo .
     2330     define output parameter p-str       as character no-undo .
     2331     define variable v-date          as date      no-undo .
     2332     define variable v-date-valid    as logical   no-undo .
     2333     define variable v-error-message as character no-undo .
     2334   do
     2335   on error undo, return error return-value
     2336   :
     2337     assign
     2338       p-str = ?
     2339     .
     2340     if p-date-str = ? or p-date-str = ""
     2341     then do:
     2342       return .
     2343     end.
     2344     run strtdate in this-procedure ( input  p-date-str
     2345                                    , output v-date
     2346                                    , output v-date-valid
     2347                                    , output v-error-message
     2348                                    ).
     2349     if v-date-valid <> true
     2350     then do:
     2351       return .
     2352     end.
     2353     assign
     2354       p-str = substitute( "&1-&2-&3"
     2355                         , string( year(v-date)  , "9999")
     2356                         , string( month(v-date) , "99"  )
     2357                         , string( day(v-date)   , "99"  )
     2358                         )
     2359     .
     2360   end.
     2361   end procedure.
     2362   procedure bge-xml-fill-tt-bgecliiv :
     2363     define input  parameter p-str as character no-undo .
     2364     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2365     define buffer buf_clients             for ub.clients.
     2366     define variable v-i         as integer   no-undo .
     2367     define variable v-count     as integer   no-undo .
     2368     define variable v-cli-count as integer   no-undo .
     2369     define variable v-client    as character no-undo .
     2370     define variable v-obj-type  as character no-undo .
     2371     define variable v-obj-code  as integer   no-undo .
     2372   do
     2373   on error undo, return error return-value
     2374   :
     2375     empty temp-table buf_tt-bge-xml-bgecliiv.
     2376     assign
     2377       v-bge-xml-bgecliiv = no
     2378       v-cli-count        = num-entries(p-str,';')
     2379     .
     2380     if v-cli-count > 0
     2381     then do:
     2382       _cli-cycle:
     2383       do v-i = 1 to v-cli-count
     2384       :
     2385         assign
     2386           v-client = entry(v-i , p-str, ';')
     2387         .
     2388         if num-entries(v-client) <> 2
     2389         then do:
     2390           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2391         end.
     2392         assign
     2393           v-obj-type = entry(1, v-client)
     2394         .
     2395         assign
     2396           v-obj-code = integer(entry(2, v-client))
     2397         no-error .
     2398         if error-status :error
     2399         then do:
     2400           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2401         end.
     2402         find first buf_clients no-lock
     2403           where buf_clients.obj-type = v-obj-type
     2404             and buf_clients.obj-code = v-obj-code
     2405         no-error.
     2406         if not available buf_clients
     2407         then do:
     2408           next _cli-cycle.
     2409         end.
     2410         find first buf_tt-bge-xml-bgecliiv no-lock
     2411           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2412             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2413         no-error .
     2414         if available buf_tt-bge-xml-bgecliiv
     2415         then do:
     2416           next _cli-cycle.
     2417         end.
     2418         create buf_tt-bge-xml-bgecliiv.
     2419         assign
     2420           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2421           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2422         .
     2423       end.
     2424     end.
     2425     else do:
     2426       assign
     2427         v-bge-xml-bgecliiv = no
     2428       .
     2429       return .
     2430     end.
     2431     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     2432     if available buf_tt-bge-xml-bgecliiv
     2433     then do:
     2434       assign
     2435         v-bge-xml-bgecliiv = yes
     2436       .
     2437     end.
     2438   end.
     2439   end procedure.
     2440   procedure bge-xml-resolve-ext-doc-type :
     2441     define input  parameter p-ext-doc-type      as character no-undo .
     2442     define input  parameter p-obj-type          as character no-undo .
     2443     define input  parameter p-obj-code          as integer   no-undo .
     2444     define output parameter p-out-ext-doc-type  as character no-undo .
     2445     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2446   do
     2447   on error undo, return error return-value
     2448   :
     2449     assign
     2450       p-out-ext-doc-type = p-ext-doc-type
     2451     .
     2452     if p-ext-doc-type <> 'ie':U
     2453     then do:
     2454       return .
     2455     end.
     2456     if v-bge-xml-bgecliiv = yes
     2457     then do:
     2458       find first buf_tt-bge-xml-bgecliiv no-lock
     2459         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     2460           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     2461       no-error .
     2462       if available buf_tt-bge-xml-bgecliiv
     2463       then do:
     2464         assign
     2465           p-out-ext-doc-type = 'iv':U
     2466         .
     2467       end.
     2468     end.
     2469   end.
     2470   end procedure.
     2471   procedure safe-wp-xmltagput :
     2472     define input  parameter pTagLevel   as integer   no-undo .
     2473     define input  parameter pTagName    as character no-undo .
     2474     define input  parameter pParValue   as character no-undo .
     2475     define input  parameter pFlagEmpty  as integer   no-undo .
     2476   do
     2477   on error undo, return error return-value
     2478   :
     2479     if v-bge-xml-bgeflold = "oracle":u
     2480     then do:
     2481       return .
     2482     end.
     2483     run wp-xmltagput in this-procedure ( input pTagLevel
     2484                                        , input pTagName
     2485                                        , input pParValue
     2486                                        , input pFlagEmpty
     2487                                        ).
     2488   end.
     2489   end procedure.
     2490       define temp-table temp_good no-undo
     2491           field gds-code              like ub.goods.gds-code
     2492           field artic                 like ub.goods.artic
     2493           field prod-type             like ub.goods.prod-type
     2494           field prod-code             like ub.goods.prod-code
     2495           field gds-name              like ub.goods.gds-name
     2496           field doc-qnty              like ub.stk-line.fact-qnty
     2497           field fact-qnty             like ub.stk-line.fact-qnty
     2498           index pi is primary unique artic prod-type prod-code
     2499       .
     2500       define variable v-qnty      as integer          no-undo.
     2501       define variable v-no-goods  as logical init yes no-undo.
     2502       define variable v-host-code as integer       no-undo.
     2503       define variable v-base-code as integer       no-undo.
     2504   define variable v-base-code-okv     as integer       no-undo.
     2505       def buffer buf_goods    for ub.goods.
     2506       def buffer buf_trn-doc  for ub.trn-doc.
     2507       def buffer buf_doc-line for ub.doc-line.
     2508   do
     2509   for buf_goods
     2510     , buf_trn-doc
     2511     , buf_doc-line
     2512   on error undo, return error
     2513   :
     2514   output stream stmXMLOut to value( v-xml-file-name + "xm1" ) convert target "1251" append.
     2515   run wp-XMLWriteCNT( hCNT, "" ).
     2516   run form-temp_good in this-procedure ( input 'при':U,     input  1 ).
     2517   run form-temp_good in this-procedure ( input 'рас':U,    input -1 ).
     2518   run form-temp_good in this-procedure ( input 'возврат':U,     input -1 ).
     2519   run form-temp_good in this-procedure ( input 'спи':U,  input -1 ).
     2520   if v-no-goods = no
     2521   then do:
     2522       run wp-xmltagopen( 2, "operation","").
     2523       run wp-xmltagput( 3, "codeOperation", "objectDay", 0 ).
     2524       run wp-xmltagput( 3, "store"     , p-obj-type + string(p-obj-code), 0 ).
     2525   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2526   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2527     (input  p-obj-type
     2528     ,input  p-obj-code
     2529     ,output v-host-code
     2530     )  .
     2531   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2532   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     2533     (input  v-host-code
     2534     ,output v-base-code
     2535     )  .
     2536       run get-base-code-okv in this-procedure (
     2537             input v-base-code
     2538           , output v-base-code-okv
     2539       ).
     2540       run wp-xmltagput( 3, "valutCode" , string( v-base-code ), 0 ).
     2541       run wp-xmltagput( 3, "valutCodeOKV" , string( v-base-code-okv   ), 0 ).
     2542       run write-result in this-procedure .
     2543       run wp-xmltagclose(2, "operation").
     2544   end.
     2545   output stream stmxmlout close.
     2546   if session :set-wait-state( "" ) then.
     2547   end.
     2548   procedure write-result :
     2549   do
     2550   on error undo, return error
     2551   :
     2552   define variable v-good-counter  as integer   init 0     no-undo.
     2553       process events.
     2554       for each temp_good
     2555       :
     2556           assign
     2557               v-good-counter = v-good-counter + 1
     2558           .
     2559           run wp-xmltagopen( 3, "good", "" ).
     2560           run wp-xmltagput( 4, "code"       , string( temp_good.gds-code )       , 0 ).
     2561           run wp-xmltagput( 4, "artic"      , temp_good.artic                    , 0 ).
     2562           run wp-xmltagput( 4, "prodType"   , temp_good.prod-type                , 0 ).
     2563           run wp-xmltagput( 4, "prodCode"   , string( temp_good.prod-code )      , 0 ).
     2564           run wp-xmltagput( 4, "name"       , temp_good.gds-name                 , 0 ).
     2565           run wp-xmltagput( 4, "docQnty"    , string( temp_good.doc-qnty )       , 0 ).
     2566           run wp-xmltagput( 4, "factQnty"   , string( temp_good.fact-qnty )      , 0 ).
     2567           run wp-xmltagclose( 3, "good" ).
     2568           if v-good-counter modulo 10 = 0
     2569           then do:
     2570               run wp-XMLWriteCnt( hcnt, "Товар " + string( v-good-counter ) ).
     2571               process events.
     2572           end.
     2573       end.
     2574   end.
     2575   end procedure.
     2576   procedure form-temp_good :
     2577   define input parameter p-doc-type       as character    no-undo.
     2578   define input parameter p-operation-sign as integer      no-undo.
     2579       define buffer buf_trn-doc       for ub.trn-doc.
     2580       define buffer buf_doc-line      for ub.doc-line.
     2581       define buffer buf_goods         for ub.goods.
     2582   do
     2583   for buf_trn-doc
     2584     , buf_doc-line
     2585     , buf_goods
     2586   on error undo, return error
     2587   :
     2588   opened-internal-trn-doc:
     2589   for each buf_trn-doc no-lock
     2590      where buf_trn-doc.obj-type = p-obj-type
     2591        and buf_trn-doc.obj-code = p-obj-code
     2592        and buf_trn-doc.internal = yes
     2593        and buf_trn-doc.doc-type = p-doc-type
     2594        and ( buf_trn-doc.status_  = 'накл':U
     2595               or buf_trn-doc.status_ = 'запрос':U
     2596               or buf_trn-doc.status_ = 'прво':U
     2597            )
     2598   :
     2599       for each buf_doc-line no-lock
     2600          where buf_doc-line.doc-code = buf_trn-doc.doc-code
     2601       :
     2602           assign
     2603               v-no-goods = no
     2604           .
     2605           find first temp_good
     2606                where temp_good.artic      = buf_doc-line.artic
     2607                  and temp_good.prod-type  = buf_doc-line.prod-type
     2608                  and temp_good.prod-code  = buf_doc-line.prod-code
     2609           no-error.
     2610           if not available temp_good
     2611           then do:
     2612               create temp_good.
     2613               find first buf_goods no-lock
     2614                    where buf_goods.artic        = buf_doc-line.artic
     2615                      and buf_goods.prod-type    = buf_doc-line.prod-type
     2616                      and buf_goods.prod-code    = buf_doc-line.prod-code
     2617               no-error.
     2618               if available buf_goods
     2619               then do:
     2620                   assign
     2621                       temp_good.gds-code    = buf_goods.gds-code
     2622                       temp_good.gds-name    = buf_goods.gds-name
     2623                   .
     2624               end.
     2625               else do:
     2626                   assign
     2627                       temp_good.gds-code    = 0
     2628                       temp_good.gds-name    = ""
     2629                   .
     2630               end.
     2631               assign
     2632                   temp_good.artic       = buf_doc-line.artic
     2633                   temp_good.prod-type   = buf_doc-line.prod-type
     2634                   temp_good.prod-code   = buf_doc-line.prod-code
     2635                   temp_good.doc-qnty    = 0
     2636                   temp_good.fact-qnty   = 0
     2637               .
     2638           end.
     2639           assign
     2640               temp_good.doc-qnty    = temp_good.doc-qnty  + ( p-operation-sign * buf_doc-line.doc-qnty )
     2641               temp_good.fact-qnty   = temp_good.fact-qnty + ( p-operation-sign * buf_doc-line.fact-qnty )
     2642           .
     2643       end.
     2644   end.
     2645   end.
     2646   end procedure.
     2647   procedure get-base-code-okv :
     2648   define input parameter p-base-code          as integer          no-undo.
     2649   define output parameter p-base-code-okv     as integer          no-undo.
     2650       define buffer buf_currency      for ub.currency.
     2651   do
     2652   for buf_currency
     2653   on error undo, return error
     2654   :
     2655       find first buf_currency no-lock
     2656            where buf_currency.curr-code = p-base-code
     2657       .
     2658       assign
     2659           p-base-code-okv = buf_currency.okv-code
     2660       .
     2661   end.
     2662   end procedure.
