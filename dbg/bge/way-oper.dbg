        1   block-level on error undo, throw.
        2   define input parameter p-obj-type        as character              no-undo.
        3   define input parameter p-obj-code        as integer                no-undo.
        4   define input parameter v-xml-file-name   as character              no-undo.
        5   define input parameter v-log-file-name   as character              no-undo.
        6   define input parameter hedt              as handle                 no-undo.
        7   define input parameter hcnt              as handle                 no-undo.
        8   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: way-oper.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: bge/way-oper.p $":U .
       13   define variable vss-description as character no-undo init "Экспорт товаров в пути".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   define variable vss-include-info0 as character format "X(65)" no-undo
       84   initial "@(#)$Workfile$ $Revision$".
       85   DEF STREAM stmXMLOut.
       86   DEF STREAM stmXMLLog.
       87   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   procedure cur-time :
       89      define output parameter p-today as date      no-undo .
       90      define output parameter p-time  as integer   no-undo .
       91     do
       92     on error undo, return error
       93     :
       94       define variable v-date1 as date      no-undo .
       95       define variable v-date2 as date      no-undo .
       96       define variable v-time  as integer   no-undo .
       97       assign
       98         v-date1 = today
       99         v-time  = time
      100         v-date2 = today
      101       .
      102       if v-date1 <> v-date2
      103       then do:
      104         assign
      105           v-date1 = today
      106           v-time  = v-time
      107         .
      108       end.
      109       assign
      110         p-today = v-date1
      111         p-time  = v-time
      112       .
      113     end.
      114   end.
      115   function cur-time-date returns character
      116   :
      117     return string(today, '99/99/9999':U) .
      118   end.
      119   function cur-time-mjd returns decimal
      120   :
      121     define variable v-date as date      no-undo .
      122     define variable v-time as integer   no-undo .
      123     run cur-time in this-procedure
      124       (output v-date
      125       ,output v-time
      126       ) .
      127     return integer(v-date) - 2400002 + (v-time / 86400) .
      128   end.
      129   function cur-time-get-ending-index returns integer
      130   (input p-number as integer
      131   )
      132   :
      133     if p-number < 0
      134     or p-number = ?
      135     then do:
      136       return 1 .
      137     end.
      138     define variable v-rest as integer   no-undo .
      139     assign
      140       p-number = p-number modulo 100
      141     .
      142     if p-number < 20
      143     then do:
      144       assign
      145         v-rest = p-number
      146       .
      147     end.
      148     else do:
      149       assign
      150         v-rest = p-number modulo 10
      151       .
      152     end.
      153     case v-rest :
      154       when 1
      155       then do:
      156         return 2 .
      157       end.
      158       when 2 or
      159       when 3 or
      160       when 4
      161       then do:
      162         return 3 .
      163       end.
      164       otherwise do:
      165         return 1 .
      166       end.
      167     end case .
      168   end.
      169   procedure cur-time-mjd-to-date :
      170      define input  parameter i-mjd-diff as decimal no-undo.
      171      define output parameter o-Date     as date    no-undo.
      172      define output parameter o-Time     as integer no-undo.
      173      define variable v-day-number as integer   no-undo .
      174      if    i-mjd-diff < 0
      175         or i-mjd-diff = ?
      176      then do:
      177         return "?" .
      178      end.
      179      assign
      180         v-day-number = truncate(i-mjd-diff,0).
      181         o-Date = date(v-day-number + 2400002).
      182         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      183     .
      184   end.
      185   function cur-time-mjd-to-string returns character
      186   (input p-mjd-diff as decimal
      187   )
      188   :
      189     define variable v-day-number as integer   no-undo .
      190     define variable v-seconds    as integer   no-undo .
      191     define variable v-hour       as integer   no-undo .
      192     define variable v-min        as integer   no-undo .
      193     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      194     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      195     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      196     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      197     if p-mjd-diff < 0
      198     or p-mjd-diff = ?
      199     then do:
      200       return "?" .
      201     end.
      202     assign
      203       v-day-number = integer(truncate(p-mjd-diff,0))
      204       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      205     .
      206     if v-seconds > 86400
      207     then do:
      208       assign
      209         v-seconds = 86400 - 1
      210       .
      211     end.
      212     if v-seconds < 0
      213     then do:
      214       assign
      215         v-seconds = 0
      216       .
      217     end.
      218     assign
      219       v-hour = truncate(v-seconds / 3600, 0)
      220     .
      221     assign
      222       v-seconds = v-seconds modulo 3600
      223     .
      224     assign
      225       v-min = truncate(v-seconds / 60, 0)
      226     .
      227     assign
      228       v-seconds = v-seconds modulo 60
      229     .
      230     return
      231         (if v-day-number <> 0
      232           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      233           else ""
      234         )
      235       + (if v-day-number <> 0 or v-hour <> 0
      236           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      237           else ""
      238         )
      239       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      240           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      241           else ""
      242         )
      243       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      244       .
      245   end.
      246   function cur-time-string returns character
      247   :
      248     define variable v-date as date      no-undo .
      249     define variable v-time as integer   no-undo .
      250     run cur-time in this-procedure
      251       (output v-date
      252       ,output v-time
      253       ) .
      254     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      255   end.
      256   function cur-time-string-sec returns character
      257   :
      258     define variable v-date as date      no-undo .
      259     define variable v-time as integer   no-undo .
      260     run cur-time in this-procedure
      261       (output v-date
      262       ,output v-time
      263       ) .
      264     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      265   end.
      266   function cur-time-custom  returns character
      267   (input p-prefix as character
      268   ,input p-date-format as character
      269   ,input p-delimiter as character
      270   ,input p-time-format as character
      271   ,input p-suffix as character
      272   )
      273   :
      274     define variable v-date as date      no-undo .
      275     define variable v-time as integer   no-undo .
      276     run cur-time in this-procedure
      277       (output v-date
      278       ,output v-time
      279       ) .
      280     return
      281       p-prefix
      282       + string(v-date, p-date-format)
      283       + p-delimiter
      284       + string(v-time, p-time-format)
      285       + p-suffix
      286       .
      287   end.
      288   function cur-time-print  returns character
      289   :
      290     define variable v-date as date      no-undo .
      291     define variable v-time as integer   no-undo .
      292     run cur-time in this-procedure
      293       (output v-date
      294       ,output v-time
      295       ) .
      296     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      297   end.
      298   function cur-time-datetime returns datetime
      299   :
      300     define variable v-char as character no-undo .
      301     define variable v-datetime as datetime no-undo .
      302     v-char = cur-time-string().
      303     v-datetime = datetime(v-char).
      304     return  v-datetime.
      305   end.
      306   function cur-time-string-msec returns character
      307   :
      308     define variable v-date as datetime  no-undo .
      309     v-date = now.
      310     return string(v-date) .
      311   end.
      312   define variable vss-include-info2 as character format "X(65)" no-undo
      313   initial "@(#)$Workfile$ $Revision$".
      314   procedure xmlchar-test :
      315   define input parameter p-in-string          as character        no-undo.
      316   define output parameter p-out-string-enc    as character        no-undo.
      317   define output parameter p-out-string-dec    as character        no-undo.
      318   do
      319   on error undo, return error
      320   :
      321          run xmlchar-encode in this-procedure
      322       (
      323             input p-in-string
      324           , output p-out-string-enc
      325       ).
      326          run xmlchar-decode in this-procedure
      327       (
      328             input p-out-string-enc
      329           , output p-out-string-dec
      330       ).
      331   end.
      332   end .
      333   procedure xmlchar-encode :
      334   define input parameter p-in-string      as character        no-undo.
      335   define output parameter p-out-string    as character        no-undo.
      336       define variable v-position      as integer      no-undo.
      337       define variable v-current-char  as character    no-undo.
      338   do
      339   on error undo, return error
      340   :
      341       assign
      342           p-out-string = "":U
      343       .
      344       case p-in-string
      345       :
      346           when ?
      347           then do:
      348               assign
      349                   p-out-string = "?":U
      350               .
      351           end.
      352           when "?":U
      353           then do:
      354               assign
      355                   p-out-string = "&#63;":U
      356               .
      357           end.
      358           otherwise do:
      359               do v-position = 1 to length( p-in-string )
      360               :
      361                   assign
      362                       v-current-char = substring( p-in-string, v-position, 1 )
      363                   .
      364                   case v-current-char
      365                   :
      366                       when "&":U
      367                       then do:
      368                           assign
      369                               p-out-string = p-out-string + "&amp;":U
      370                           .
      371                       end.
      372                       when ">":U
      373                       then do:
      374                           assign
      375                               p-out-string = p-out-string + "&gt;":U
      376                           .
      377                       end.
      378                       when "<":U
      379                       then do:
      380                           assign
      381                               p-out-string = p-out-string + "&lt;":U
      382                           .
      383                       end.
      384                       when "'":U
      385                       then do:
      386                           assign
      387                               p-out-string = p-out-string + "&apos;":U
      388                           .
      389                       end.
      390                       when '"':U
      391                       then do:
      392                           assign
      393                               p-out-string = p-out-string + "&quot;":U
      394                           .
      395                       end.
      396                       when chr(1)
      397                       then do:
      398                           assign
      399                               p-out-string = p-out-string + "":U
      400                           .
      401                       end.
      402                       when chr(2)
      403                       then do:
      404                           assign
      405                               p-out-string = p-out-string + "":U
      406                           .
      407                       end.
      408                       when chr(3)
      409                       then do:
      410                           assign
      411                               p-out-string = p-out-string + "":U
      412                           .
      413                       end.
      414                       when chr(4)
      415                       then do:
      416                           assign
      417                               p-out-string = p-out-string + "":U
      418                           .
      419                       end.
      420                       when chr(5)
      421                       then do:
      422                           assign
      423                               p-out-string = p-out-string + "":U
      424                           .
      425                       end.
      426                       when chr(6)
      427                       then do:
      428                           assign
      429                               p-out-string = p-out-string + "":U
      430                           .
      431                       end.
      432                       when chr(7)
      433                       then do:
      434                           assign
      435                               p-out-string = p-out-string + "":U
      436                           .
      437                       end.
      438                       when chr(8)
      439                       then do:
      440                           assign
      441                               p-out-string = p-out-string + "":U
      442                           .
      443                       end.
      444                       when chr(9)
      445                       then do:
      446                           assign
      447                               p-out-string = p-out-string + "":U
      448                           .
      449                       end.
      450                       when chr(29)
      451                       then do:
      452                           assign
      453                               p-out-string = p-out-string + "":U
      454                           .
      455                       end.
      456                       when chr(10)
      457                       then do:
      458                           assign
      459                               p-out-string = p-out-string + "&#10;":U
      460                           .
      461                       end.
      462                       when chr(13)
      463                       then do:
      464                           assign
      465                               p-out-string = p-out-string + "&#13;":U
      466                           .
      467                       end.
      468                       otherwise do:
      469                           assign
      470                               p-out-string = p-out-string + v-current-char
      471                           .
      472                       end.
      473                   end case.
      474               end.
      475           end.
      476       end case.
      477   end.
      478   end .
      479   procedure xmlchar-encode-1c :
