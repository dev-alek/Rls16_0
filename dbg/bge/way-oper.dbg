      589   procedure xmlchar-decode :
      590   define input parameter p-in-string      as character        no-undo.
      591   define output parameter p-out-string    as character        no-undo.
      592       define variable v-position      as integer      no-undo.
      593       define variable v-last-position as integer      no-undo.
      594       define variable v-temp-integer  as integer      no-undo.
      595       define variable v-current-char  as character    no-undo.
      596       define variable v-next-char     as character    no-undo.
      597       define variable v-success       as logical      no-undo.
      598   do
      599   on error undo, return error
      600   :
      601       assign
      602           p-out-string = "":U
      603           v-position   = 0
      604       .
      605       replace-cycle:
      606       do while yes
      607       on error undo, return error
      608       :
      609           assign
      610               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      611           .
      612           if v-last-position <= v-position
      613           then do:
      614               if v-position = 0
      615               then do:
      616                   assign
      617                       p-out-string = p-in-string
      618                   .
      619               end.
      620               else do:
      621                   assign
      622                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      623                   .
      624               end.
      625               leave replace-cycle.
      626           end.
      627           else do:
      628               assign
      629                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      630                   v-position      = v-last-position
      631                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      632               .
      633               if v-current-char = "#":U
      634               then do:
      635                   assign
      636                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      637                   .
      638                   if v-last-position > 0
      639                   then do:
      640                       run xmlchar-read-integer in this-procedure
      641                        (
      642                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      643                           , output v-temp-integer
      644                           , output v-success
      645                       ).
      646                       if v-success = yes
      647                       and v-temp-integer >= 1
      648                       and v-temp-integer <= 255
      649                       then do:
      650                           assign
      651                               p-out-string = p-out-string + chr( v-temp-integer )
      652                               v-position   = v-last-position + 1
      653                           .
      654                       end.
      655                       else do:
      656                           assign
      657                               p-out-string = p-out-string + "&":U
      658                               v-position   = v-position   + 1
      659                           .
      660                       end.
      661                   end.
      662                   else do:
      663                       assign
      664                           p-out-string = p-out-string + "&":U
      665                           v-position   = v-position   + 1
      666                       .
      667                   end.
      668               end.
      669               else do:
      670                   case substring( p-in-string, v-position + 1, 3 )
      671                   :
      672                       when "lt;":U
      673                       then do:
      674                           assign
      675                               p-out-string = p-out-string + "<":U
      676                               v-position   = v-position   + 3
      677                           .
      678                       end.
      679                       when "gt;":U
      680                       then do:
      681                           assign
      682                               p-out-string = p-out-string + ">":U
      683                               v-position   = v-position   + 3
      684                           .
      685                       end.
      686                       otherwise do:
      687                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      688                           then do:
      689                               assign
      690                                   p-out-string = p-out-string + "&":U
      691                                   v-position   = v-position   + 4
      692                               .
      693                           end.
      694                           else do:
      695                               case substring( p-in-string, v-position + 1, 5 )
      696                               :
      697                                   when "quot;":U
      698                                   then do:
      699                                       assign
      700                                           p-out-string = p-out-string + '"':U
      701                                           v-position   = v-position   + 5
      702                                       .
      703                                   end.
      704                                   when "apos;":U
      705                                   then do:
      706                                       assign
      707                                           p-out-string = p-out-string + "'":U
      708                                           v-position   = v-position   + 5
      709                                       .
      710                                   end.
      711                                   otherwise do:
      712                                       assign
      713                                           p-out-string = p-out-string + "&":U
      714                                       .
      715                                   end.
      716                               end case.
      717                           end.
      718                       end.
      719                   end case.
      720               end.
      721           end.
      722       end.
      723   end.
      724   end .
      725   procedure xmlchar-read-integer :
      726   define input parameter p-input-string      as character        no-undo.
      727   define output parameter p-output-integer   as integer          no-undo.
      728   define output parameter p-success       as logical          no-undo.
      729   do
      730   on error undo, return error
      731   :
      732       assign
      733           p-output-integer = integer( p-input-string )
      734       no-error.
      735       if error-status :error
      736       then do:
      737           assign
      738               p-success           = no
      739               p-output-integer    = 0
      740           .
      741       end.
      742       else do:
      743           assign
      744               p-success           = yes
      745           .
      746       end.
      747   end.
      748   end.
      749   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      750   procedure strtdate :
      751     define input  parameter p-str         as character no-undo .
      752     define output parameter p-value       as date      no-undo .
      753     define output parameter p-data-valid  as logical   no-undo .
      754     define output parameter p-message     as character no-undo .
      755   do
      756   on error undo, return error return-value
      757   :
      758     define variable v-value       as date      no-undo .
      759     define variable v-i           as integer   no-undo .
      760     define variable v-num         as integer   no-undo .
      761     define variable v-delim       as character no-undo .
      762     define variable v-delim-list  as character no-undo .
      763     define variable v-day         as integer   no-undo .
      764     define variable v-month       as integer   no-undo .
      765     define variable v-year        as integer   no-undo .
      766     define variable v-day-str     as character no-undo .
      767     define variable v-month-str   as character no-undo .
      768     define variable v-year-str    as character no-undo .
      769     assign
      770       p-value       = ?
      771       p-data-valid  = false
      772     .
      773     if p-str = ?
      774     then do:
      775       assign
      776         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      777       .
      778       return .
      779     end.
      780     if p-str = ""
      781     then do:
      782       assign
      783         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      784       .
      785       return .
      786     end.
      787     if length(p-str)  > 10
      788     then do:
      789       assign
      790         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      791       .
      792       return .
      793     end.
      794     assign
      795       v-delim-list = '/,-,.':U
      796     .
      797     _delim:
      798     do v-i = 1 to num-entries( v-delim-list )
      799     :
      800       assign
      801         v-delim = entry( v-i , v-delim-list )
      802         v-num   = num-entries( p-str , v-delim )
      803       .
      804       if v-num <> 3
      805       then do:
      806         assign
      807           v-delim = ''
      808         .
      809       end.
      810       else do:
      811         leave _delim.
      812       end.
      813     end.
      814     if v-delim = ''
      815     then do:
      816       assign
      817         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      818       .
      819       return .
      820     end.
      821     assign
      822       v-day-str   = entry( 1, p-str , v-delim)
      823       v-month-str = entry( 2, p-str , v-delim)
      824       v-year-str  = entry( 3, p-str , v-delim)
      825     .
      826     if  length(v-day-str) > 2   or
      827         length(v-day-str) < 1   or
      828         length(v-month-str) > 2 or
      829         length(v-month-str) < 1 or
      830         (
      831           length(v-year-str) <> 2 and
      832           length(v-year-str) <> 4
      833         )
      834     then do:
      835       assign
      836         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      837       .
      838       return .
      839     end.
      840     if length( v-year-str ) = 2
      841     then do:
      842       assign
      843         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      844       .
      845     end.
      846     assign
      847       v-day   = integer( v-day-str )
      848       v-month = integer( v-month-str)
      849       v-year  = integer( v-year-str)
      850     no-error .
      851     if error-status :error
      852     then do:
      853       assign
      854         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      855       .
      856       return .
      857     end.
      858     if v-day < 1  or
      859        v-day > 31 or
      860        v-month < 1 or
      861        v-month > 12 or
      862        v-year < 0   or
      863        v-year > 5000
      864     then do:
      865       assign
      866         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      867       .
      868       return .
      869     end.
      870     assign
      871       v-value = date( v-month, v-day, v-year )
      872     no-error .
      873     if error-status :error
      874     then do:
      875       assign
      876         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      877       .
      878       return .
      879     end.
      880     assign
      881       p-value       = v-value
      882       p-data-valid  = true
      883     .
      884   end.
      885   end procedure.
      886   define variable v-bge-xml-bgecliiv      as logical  init no  no-undo.
      887   define variable v-bge-xml-bgeclall      as logical  init no  no-undo.
