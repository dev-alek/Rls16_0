     2983   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'payer'),  input string(buf_fin-doc.payer-type + string(buf_fin-doc.payer-code)), input 1 ).
     2984   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'payerName'),  input string(buf_fin-doc.payer-name), input 1 ).
     2985   if buf_fin-doc.fin-doc-type = 'ппп':U
     2986   or buf_fin-doc.fin-doc-type = 'рпп':U then do:
     2987         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'payerINN'),  input string(buf_fin-doc.payer-INN), input 1 ).
     2988         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'payerKPP'),  input string(buf_fin-doc.payer-KPP), input 1 ).
     2989     if false then do:
     2990         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'payerOKPO'),  input string(buf_fin-doc.payer-OKPO), input 1 ).
     2991     end.
     2992         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'payerBankName'),  input string((buf_fin-doc.payer-bank-name + chr(44) + chr(32) + buf_fin-doc.payer-bank-city)), input 1 ).
     2993         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'payerBIK'),  input string(buf_fin-doc.payer-bIK), input 1 ).
     2994         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'payerAccountCode'),  input string(buf_fin-doc.payer-code-schet), input 1 ).
     2995         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'payerAccount'),  input string(buf_fin-doc.payer-r-schet), input 1 ).
     2996         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'payerCorrAccount'),  input string(buf_fin-doc.payer-c-schet), input 1 ).
     2997   end.
     2998   if buf_fin-doc.payer-dop1 <> "":U then do:
     2999         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'payerAddInfo1'),  input string(buf_fin-doc.payer-dop1), input 1 ).
     3000   end.
     3001   if buf_fin-doc.payer-dop2 <> "":U then do:
     3002         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'payerAddInfo2'),  input string(buf_fin-doc.payer-dop2), input 1 ).
     3003   end.
     3004   if buf_fin-doc.payer-dop3 <> "":U then do:
     3005         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'payerAddInfo3'),  input string(buf_fin-doc.payer-dop3), input 1 ).
     3006   end.
     3007   if buf_fin-doc.payer-dop4 <> "":U then do:
     3008         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'payerAddInfo4'),  input string(buf_fin-doc.payer-dop4), input 1 ).
     3009   end.
     3010   if buf_fin-doc.fin-doc-type = 'пко':U
     3011   or buf_fin-doc.fin-doc-type = 'рко':U then do:
     3012     if buf_fin-doc.payer-passport <> "":U then do:
     3013               run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'payerPassport'),  input string(buf_fin-doc.payer-passport), input 1 ).
     3014     end.
     3015   end.
     3016   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'receiver'),  input string(buf_fin-doc.receiver-type + string(buf_fin-doc.receiver-code)), input 1 ).
     3017   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'receiverName'),  input string(buf_fin-doc.receiver-name), input 1 ).
     3018   if buf_fin-doc.fin-doc-type = 'ппп':U
     3019   or buf_fin-doc.fin-doc-type = 'рпп':U then do:
     3020         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'receiverINN'),  input string(buf_fin-doc.receiver-INN), input 1 ).
     3021         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'receiverKPP'),  input string(buf_fin-doc.receiver-KPP), input 1 ).
     3022         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'receiverBankName'),  input string((buf_fin-doc.receiver-bank-name + chr(44) + chr(32) + buf_fin-doc.receiver-bank-city)), input 1 ).
     3023         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'receiverBIK'),  input string(buf_fin-doc.receiver-bIK), input 1 ).
     3024         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'receiverAccountCode'),  input string(buf_fin-doc.receiver-code-schet), input 1 ).
     3025         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'receiverAccount'),  input string(buf_fin-doc.receiver-r-schet), input 1 ).
     3026         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'receiverCorrAccount'),  input string(buf_fin-doc.receiver-c-schet), input 1 ).
     3027   end.
     3028   if buf_fin-doc.fin-doc-type = 'пко':U or buf_fin-doc.fin-doc-type = 'апп':U then do:
     3029         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'receiverOKPO'),  input string(buf_fin-doc.receiver-OKPO), input 1 ).
     3030   end.
     3031   if buf_fin-doc.receiver-dop1 <> "":U then do:
     3032         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'receiverAddInfo1'),  input string(buf_fin-doc.receiver-dop1), input 1 ).
     3033   end.
     3034   if buf_fin-doc.receiver-dop2 <> "":U then do:
     3035         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'receiverAddInfo2'),  input string(buf_fin-doc.receiver-dop2), input 1 ).
     3036   end.
     3037   if buf_fin-doc.receiver-dop3 <> "":U then do:
     3038         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'receiverAddInfo3'),  input string(buf_fin-doc.receiver-dop3), input 1 ).
     3039   end.
     3040   if buf_fin-doc.receiver-dop4 <> "":U then do:
     3041         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'receiverAddInfo4'),  input string(buf_fin-doc.receiver-dop4), input 1 ).
     3042   end.
     3043   if buf_fin-doc.fin-doc-type = 'пко':U
     3044   or buf_fin-doc.fin-doc-type = 'рко':U then do:
     3045     if buf_fin-doc.receiver-passport <> "":U then do:
     3046               run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'receiverPassport'),  input string(buf_fin-doc.receiver-passport), input 1 ).
     3047     end.
     3048   end.
     3049   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'comment'),  input string(buf_fin-doc.PS), input 1 ).
     3050   run wp-xmltagclose in this-procedure ( input 0 + 4, substitute("&1", 'findoc')).
     3051   for each buf_fin-doc-tax no-lock
     3052       where buf_fin-doc-tax.fin-doc-code = buf_fin-doc.fin-doc-code
     3053       AND   buf_fin-doc-tax.host-code = buf_fin-doc.host-code
     3054   on error undo, return error
     3055   :
     3056         run wp-xmltagopen in this-procedure ( input 0 + 4, substitute("&1", 'taxLine'),  "" ).
     3057         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'paymentDocID'),  input string(buf_fin-doc.fin-doc-code), input 1 ).
     3058         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'cashbookid'),  input string(buf_fin-doc.cashbookid), input 1 ).
     3059         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'taxLineNum'),  input string(buf_fin-doc-tax.line-num), input 1 ).
     3060         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'lineSumDoc'),  input string(buf_fin-doc-tax.sum-line-doc), input 1 ).
     3061         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'lineSumRubl'),  input string(buf_fin-doc-tax.sum-line-rubl), input 1 ).
     3062         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'lineSumBase'),  input string(buf_fin-doc-tax.sum-line-base), input 1 ).
     3063     if buf_fin-doc.contract-code <> 0 then do:
     3064               run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'lineSumContr'),  input string(buf_fin-doc-tax.sum-line-contr), input 1 ).
     3065     end.
     3066         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'lineVatSumDoc'),  input string(buf_fin-doc-tax.sum-vat-line-doc), input 1 ).
     3067         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'lineVatSumRubl'),  input string(buf_fin-doc-tax.sum-vat-line-rubl), input 1 ).
     3068         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'lineVatSumBase'),  input string(buf_fin-doc-tax.sum-vat-line-base), input 1 ).
     3069     if buf_fin-doc.contract-code <> 0 then do:
     3070               run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'lineVatSumContr'),  input string(buf_fin-doc-tax.sum-vat-line-contr), input 1 ).
     3071     end.
     3072         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'lineVat'),  input string(buf_fin-doc-tax.vat-pc), input 1 ).
     3073         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'lineWithVat'),  input string((if buf_fin-doc-tax.with-vat then "yes" else "no")), input 1 ).
     3074         run wp-xmltagclose in this-procedure ( input 0 + 4, substitute("&1", 'taxLine')).
     3075   end.
     3076     run wp-xmltagput( 3, "comment",  p-doc-PS, 0 ).
     3077     run wp-xmltagclose( 2, "operation" ).
     3078   end.
     3079   end procedure.
     3080   procedure run-callback-write-doc-code :
     3081   do
     3082   on error undo, return error
     3083   :
     3084   define input parameter p-handle           as handle       no-undo.
     3085   define input parameter p-type             as character    no-undo.
     3086   define input parameter p-host-code        as integer      no-undo.
     3087   define input parameter p-fin-doc-code     as integer      no-undo.
     3088   define input parameter p-corr-user-db-num as integer      no-undo.
     3089   define input parameter p-chip-num         as integer      no-undo.
     3090   define input parameter p-log-file         as character    no-undo.
     3091   define variable v-procedure-name    as char no-undo.
     3092   case p-type
     3093   :
     3094     when "fin-doc":U then do:
     3095       assign
     3096       v-procedure-name = "fill-temp-fin-doc-code":U
     3097       .
     3098     end.
     3099     when "c-fin-doc":U then do:
     3100       assign
     3101       v-procedure-name = "fill-temp-del-fin-doc-code":U
     3102       .
     3103     end.
     3104   end case.
     3105   if lookup( v-procedure-name, p-handle :internal-entries ) > 0
     3106   then do:
     3107       run value( v-procedure-name ) in p-handle (
     3108                                                   input p-host-code
     3109                                                  ,input p-fin-doc-code
     3110                                                  ,input p-corr-user-db-num
     3111                                                  ,input p-chip-num
     3112                                                     ) no-error.
     3113       if error-status :error
     3114       then do:
     3115           run wp-XMLWriteLog in this-procedure (
     3116                 input p-log-file
     3117               , input 1
     3118               , input substitute( "Ошибка при вызове callback - процедуры &1.", v-procedure-name )
     3119           ).
     3120       end.
     3121   end.
     3122   else do:
     3123       run wp-XMLWriteLog in this-procedure (
     3124             input p-log-file
     3125           , input 1
     3126           , input substitute( "Не найдена callback - процедура &1.", v-procedure-name )
     3127       ).
     3128   end.
     3129   end.
     3130   end procedure.
     3131   procedure export-deleted-docs :
     3132   define input parameter p-host-code      as integer no-undo .
     3133   define input parameter p-fin-doc-code   as integer no-undo.
     3134   define input parameter p-corr-user-db-num as integer no-undo .
     3135   define input parameter p-chip-num         as integer no-undo .
     3136   define buffer buf_c-fin-doc     for ub.c-fin-doc.
     3137   do
     3138   for
     3139   buf_c-fin-doc
     3140   on error undo, return error
     3141   :
     3142       find first buf_c-fin-doc no-lock
     3143            where buf_c-fin-doc.fin-doc-code = p-fin-doc-code
     3144             AND  buf_c-fin-doc.host-code = p-host-code
     3145             AND buf_c-fin-doc.corr-user-db-num = p-corr-user-db-num
     3146             AND buf_c-fin-doc.chip-num = p-chip-num
     3147       .
     3148       run wp-XMLWriteCnt( input hcnt, input substitute( "Удаленный: &1 от &2", p-fin-doc-code, buf_c-fin-doc.fact-date ) ).
     3149       process events.
     3150       run wp-xmltagopen( input 2, input "operation", input "" ).
     3151       run wp-xmltagput( input 3, input "referenceNo"  , input buf_c-fin-doc.fin-doc-code                               , input 0 ).
     3152       run wp-xmltagput( input 3, input "isDel"        , input "yes"                                                    , input 0 ).
     3153       run wp-xmltagput( input 3, input "flagDel"      , input buf_c-fin-doc.is-del                                     , input 0 ).
     3154       run wp-xmltagput( input 3, input "codeOperation", input string( buf_c-fin-doc.fin-ext-doc-type                  ), input 0 ).
     3155       run wp-xmltagput( input 3, input "host"         , input string( buf_c-fin-doc.host-code                         ), input 0 ).
     3156       run wp-xmltagput( input 3, input "dateDel"      , input string( buf_c-fin-doc.corr-date ,"99.99.9999"           ), input 0 ).
     3157       run wp-xmltagput( input 3, input "dateDoc"      , input string( buf_c-fin-doc.doc-date  ,"99.99.9999"           ), input 0 ).
     3158       run wp-xmltagput( input 3, input "dateFact"     , input string( buf_c-fin-doc.fact-date ,"99.99.9999"           ), input 0 ).
     3159       run wp-xmltagput( input 3, input "comment"      , input buf_c-fin-doc.PS                                         , input 0).
     3160       run wp-xmltagclose( input 2, input "operation" ).
     3161   end.
     3162   end procedure.
