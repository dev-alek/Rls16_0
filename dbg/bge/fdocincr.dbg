      991   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
      992                                             INPUT iFlagEmpty AS INTEGER).
      993       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
      994       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
      995           DO:
      996               IF iFlagEmpty = 0                           THEN RETURN "".
      997               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
      998               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
      999               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
     1000               ELSE RETURN "".
     1001           END.
     1002       ELSE DO:
     1003           run xmlchar-encode in this-procedure (
     1004                 input sToPlace
     1005               , output sToPlace
     1006           ).
     1007           ASSIGN
     1008               sToPlace = sParName + '="' + sToPlace + '"'
     1009           .
     1010           RETURN sToPlace.
     1011       END.
     1012   END FUNCTION.
     1013   function bge-xml-date returns character
     1014   ( input p-date as date )
     1015   :
     1016     define variable v-date-str as character no-undo .
     1017     run bge-xml-date-to-str in this-procedure ( input   p-date
     1018                                               , output  v-date-str
     1019                                               ) .
     1020     return v-date-str.
     1021   end function.
     1022   function bge-xml-str-date returns character
     1023   ( input p-date-str as character )
     1024   :
     1025     define variable v-date-str as character no-undo .
     1026     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1027                                                   , output  v-date-str
     1028                                                   ) .
     1029     return v-date-str.
     1030   end function.
     1031   function bge-xml-normalize-dec returns decimal
     1032   ( input p-val as decimal )
     1033   :
     1034     return (if p-val = ? then 0 else p-val) .
     1035   end function.
     1036   PROCEDURE wp-XMLTagOpen:
     1037   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1038   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1039   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1040       define variable v-out-string    as character    no-undo.
     1041   do
     1042   on error undo, return error
     1043   :
     1044       if v-bge-xml-bgefmt = "dbf":U
     1045       then do:
     1046       end.
     1047       else do:
     1048           assign
     1049               v-out-string = substitute( "&1&2<&3&4>"
     1050                                       , chr(10)
     1051                                       , fill( " ":U, 4 * iTagLevel)
     1052                                       , sTagName
     1053                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1054                               )
     1055           .
     1056           put stream stmXMLOut unformatted
     1057               v-out-string
     1058           .
     1059       end.
     1060   end.
     1061   END PROCEDURE.
     1062   PROCEDURE wp-XMLTagPut:
     1063     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1064     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1065     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1066     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1067       define variable v-out-string    as character    no-undo.
     1068   do
     1069   on error undo, return error
     1070   :
     1071       if v-bge-xml-bgefmt = "dbf":U
     1072       then do:
     1073           if v-bge-xml-dbf-file-name <> "":U
     1074           then do:
     1075               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1076               export stream stmXMLOut
     1077                   sTagName
     1078                   sParValue
     1079               .
     1080               output stream stmXMLOut close.
     1081           end.
     1082       end.
     1083       else do:
     1084           IF  iFlagEmpty = 1
     1085           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1086           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1087           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1088           THEN DO:
     1089               run xmlchar-encode in this-procedure (
     1090                   input sParValue
     1091                   , output sParValue
     1092               ).
     1093               assign
     1094                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1095                                               , chr(10)
     1096                                               , FILL(" ", 4 * iTagLevel)
     1097                                               , sTagName
     1098                                               , sParValue
     1099                               )
     1100               .
     1101               PUT STREAM stmXMLOut UNFORMATTED
     1102                   v-out-string
     1103               .
     1104           END.
     1105       end.
     1106   end.
     1107   END PROCEDURE.
     1108   PROCEDURE wp-XMLTagClose:
     1109   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1110   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1111       define variable v-out-string    as character    no-undo.
     1112   do
     1113   on error undo, return error
     1114   :
     1115       if v-bge-xml-bgefmt = "dbf":U
     1116       then do:
     1117       end.
     1118       else do:
     1119           assign
     1120               v-out-string = substitute( "&1&2</&3>"
     1121                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1122                                   , fill( " ", 4 * iTagLevel )
     1123                                   , sTagName
     1124                           )
     1125           .
     1126           PUT STREAM stmXMLOut UNFORMATTED
     1127               v-out-string
     1128           .
     1129       end.
     1130   end.
     1131   END PROCEDURE.
     1132   PROCEDURE wp-XMLWriteLog:
     1133     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1134     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1135     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1136   define variable v-str              as character no-undo .
     1137   define variable v-error-append     as logical   no-undo .
     1138   define variable v-error-append-msg as character no-undo .
     1139   assign
     1140     v-str = chr(10)
     1141             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1142             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1143     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1144     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1145     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1146   .
     1147   run bge/bge-log.p (input v-str) no-error .
     1148   if error-status:error then do:
     1149     assign
     1150       v-error-append     = yes
     1151       v-error-append-msg = return-value
     1152     .
     1153   end.
     1154   run gbl/fileapnd.p
     1155     ( input sFileName
     1156     , input v-str
     1157     , input 10
     1158     ) no-error .
     1159   if error-status:error then do:
     1160     assign
     1161       v-error-append     = yes
     1162       v-error-append-msg = substitute( "&1&2&3"
     1163                                       , v-error-append-msg
     1164                                       , chr(10)
     1165                                       , return-value
     1166                                       )
     1167     .
     1168   end.
     1169   if v-error-append
     1170   then do:
     1171     return error substitute( "&1" , v-error-append-msg ) .
     1172   end.
     1173   END PROCEDURE.
     1174   PROCEDURE wp-XMLWriteEDT:
     1175     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1176     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1177     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1178       if valid-handle ( hEDT )
     1179       then do:
     1180           hEDT :move-to-eof().
     1181           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1182                                           OR sToWrite = "&Line") THEN "" ELSE
     1183                                           cur-time-string-sec() + " ").
     1184           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1185                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1186                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1187           hEDT :insert-string(chr(10)).
     1188       end.
     1189       process events.
     1190       output to 'bgescn.txt' append.
     1191           put unformatted
     1192               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1193                                           OR sToWrite = "&Line") THEN "" ELSE
     1194                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1195               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1196                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1197                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1198           .
     1199       output close.
     1200   END PROCEDURE.
     1201   PROCEDURE wp-XMLShowCNT:
     1202     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1203       if valid-handle( hCNT )
     1204       then do:
     1205           ASSIGN hCNT :VISIBLE = TRUE.
     1206       end.
     1207   END PROCEDURE.
     1208   PROCEDURE wp-XMLHideCNT:
     1209     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1210       if valid-handle( hCNT )
     1211       then do:
     1212           ASSIGN hCNT :VISIBLE = FALSE.
     1213       end.
     1214   END PROCEDURE.
     1215   PROCEDURE wp-XMLWriteCNT:
     1216     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1217     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1218       if valid-handle( hCNT )
     1219       then do:
     1220           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1221       end.
     1222   END PROCEDURE.
     1223   procedure bge-xml-write-header:
     1224   do
     1225   on error undo, return error
     1226   :
     1227   define input parameter p-xml-file-name  as character        no-undo.
     1228   define input parameter p-doc-name       as character        no-undo.
     1229   define input parameter p-version        as character        no-undo.
     1230   define input parameter p-db-num         as integer          no-undo.
     1231   define input parameter p-date-from      as date             no-undo.
     1232   define input parameter p-shift-num-from as integer          no-undo.
     1233   define input parameter p-date-to        as date             no-undo.
     1234   define input parameter p-shift-num-to   as integer          no-undo.
     1235   define input parameter p-obj-list       as character        no-undo.
     1236   define input parameter p-doc-type-list  as character        no-undo.
     1237   define input parameter p-pay-code       as logical          no-undo.
     1238   define input parameter p-cst            as logical          no-undo.
     1239   define input parameter p-parts          as logical          no-undo.
     1240   define input parameter p-chk-pay-code   as logical          no-undo.
     1241   define input parameter p-pay-desk       as logical          no-undo.
     1242   define input parameter p-pay-desk-cards as logical          no-undo.
     1243   define input parameter p-deleted        as logical          no-undo.
     1244   define input parameter p-opened-docs    as logical          no-undo.
     1245   define variable v-out-string    as character    no-undo.
     1246   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1247   assign
     1248       v-out-string = substitute( "&1&2&3"
     1249                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1250                           , chr(10)
     1251                           , "<IBS_Trade_House>":U )
     1252   .
     1253   put stream stmXMLOut unformatted
     1254       v-out-string
     1255   .
     1256   run wp-XMLTagOpen(1, "header","").
     1257   if v-bge-xml-bgeflold = "oracle":u
     1258   then do:
     1259     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1260     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1261     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1262     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1263     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1264   end.
     1265   run wp-XMLTagOpen( 2, "manifest", "").
     1266   run wp-XMLTagOpen( 3, "document", "").
     1267   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1268   run wp-XMLTagput( 4, "description", "", 0).
     1269   run wp-XMLTagput( 4, "version", p-version, 0).
     1270   run wp-XMLTagclose( 3, "document" ).
     1271   run wp-XMLTagclose( 2, "manifest" ).
     1272   run wp-XMLTagclose( 1, "header" ).
     1273   run wp-XMLTagOpen(1, "options","").
     1274   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1275   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1276   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1277   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1278   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1279   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1280   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1281   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1282   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1283   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1284   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1285   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1286   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1287   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1288   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1289   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1290   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1291   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1292   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1293   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1294   run wp-XMLTagClose(1, "options").
     1295   run wp-XMLTagOpen( 1, "body", "" ).
     1296   output stream stmXMLOut close.
     1297   end.
     1298   end procedure.
     1299   procedure xml-bge-write-footer:
     1300   do
     1301   on error undo, return error return-value
     1302   :
     1303   define input parameter p-xml-file-name as character    no-undo.
     1304   define variable v-error-num     as integer           no-undo.
     1305   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1306   run wp-XMLTagClose( 1, "body" ).
     1307   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1308   output stream stmXMLOut close.
     1309   if v-bge-xml-bgeflold = "oracle":u
     1310   then do:
     1311     define variable v-tmp-file-name         as character no-undo .
     1312     define variable v-zip-file-name         as character no-undo .
     1313     define variable v-exch-file-name        as character no-undo .
     1314     define variable v-heap-file-name        as character no-undo .
     1315     define variable v-i                     as integer   no-undo .
     1316     define variable v-file-name             as character no-undo .
     1317     define variable v-arc                   as character no-undo .
     1318     define variable v-str                   as character no-undo .
     1319     define variable v-exch-tmp-file-name    as character no-undo .
     1320     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1321     define variable v-bge-xml-exch-dir      as character no-undo .
     1322     define variable v-bge-xml-heap-dir      as character no-undo .
     1323     define variable v-bge-xml-compress-heap as logical   no-undo .
     1324     define variable v-home-dir              as character no-undo .
     1325     define variable v-os-command            as character no-undo .
     1326     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1327     if v-home-dir = ?
     1328     then do:
     1329       undo, return error substitute( "&1&2&3"
     1330                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1331                                     , chr(10)
     1332                                     , "Обратитесь к администратору.":u
     1333                                     ).
     1334     end.
     1335     assign
     1336       v-home-dir = v-home-dir
     1337     .
     1338     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1339     if error-status :error
     1340     then do:
     1341       undo, return error substitute( "&1&2&3"
     1342                                     , "Неверно задан каталог экспорта.":u
     1343                                     , chr(10)
     1344                                     , "Обратитесь к администратору.":u
     1345                                     ).
     1346     end.
     1347     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1348     if v-bge-xml-exch-dir = ?
     1349     then do:
     1350       undo, return error substitute( "&1&2&3"
     1351                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1352                                     , chr(10)
     1353                                     , "Обратитесь к администратору.":u
     1354                                     ).
     1355     end.
     1356     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1357     if error-status :error
     1358     then do:
     1359       undo, return error substitute( "&1&2&3"
     1360                                     , "Неверно задан каталог экспорта (exch).":u
     1361                                     , chr(10)
     1362                                     , "Обратитесь к администратору.":u
     1363                                     ).
     1364     end.
     1365     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1366     if v-bge-xml-heap-dir = ?
     1367     then do:
     1368       undo, return error substitute( "&1&2&3"
     1369                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1370                                     , chr(10)
     1371                                     , "Обратитесь к администратору.":u
     1372                                     ).
     1373     end.
     1374     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1375     if error-status :error
     1376     then do:
     1377       undo, return error substitute( "&1&2&3"
     1378                                     , "Неверно задан каталог экспорта (heap).":u
     1379                                     , chr(10)
     1380                                     , "Обратитесь к администратору.":u
     1381                                     ).
     1382     end.
     1383     get-key-value section "BGE" key "heap-compress" value v-str.
     1384     assign
     1385       v-i = int(v-str)
     1386     no-error .
     1387     if v-i = ? or v-i = 0
     1388     then do:
     1389       assign
     1390         v-bge-xml-compress-heap = no
     1391       .
     1392     end.
     1393     else do:
     1394       assign
     1395         v-bge-xml-compress-heap = yes
     1396       .
     1397     end.
     1398     assign
     1399       v-arc = search( "exe/7za.exe":u )
     1400     .
     1401     if v-arc = ? or v-arc = ""
     1402     then do:
     1403       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     1404     end.
     1405     assign
     1406       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     1407       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     1408       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     1409       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     1410       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     1411       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     1412       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     1413     .
     1414     run gbl/del-file.p (input v-tmp-file-name) .
     1415     run gbl/del-file.p (input v-zip-file-name) .
     1416     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     1417     if v-error-num > 0
     1418     then do:
     1419         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     1420                                      , p-xml-file-name + "xm1":u
     1421                                      , v-tmp-file-name
     1422                                      , v-error-num
     1423                                      ).
     1424     end.
     1425     assign
     1426       v-os-command     = substitute( "&1 a -tzip &2 &3"
     1427                                    , v-arc
     1428                                    , v-zip-file-name
     1429                                    , v-tmp-file-name
     1430                                    )
     1431     .
     1432     os-command silent value ( v-os-command ) .
     1433     run gbl/del-file.p (input v-heap-file-name) .
     1434     if v-bge-xml-compress-heap = no
     1435     then do:
     1436       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     1437       if v-error-num > 0
     1438       then do:
     1439           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1440                                        , v-tmp-file-name
     1441                                        , v-heap-file-name
     1442                                        , v-error-num
     1443                                        ) .
     1444       end.
     1445     end.
     1446     else do:
     1447       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     1448       if v-error-num > 0
     1449       then do:
     1450           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1451                                        , v-zip-file-name
     1452                                        , v-heap-file-name
     1453                                        , v-error-num
     1454                                        ) .
     1455       end.
     1456     end.
     1457     run gbl/del-file.p (input v-tmp-file-name) .
     1458     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     1459     if error-status :error then do:
     1460       undo, return error substitute( "&1&2&3"
     1461                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     1462                                     , chr(10)
     1463                                     , "Обратитесь к администратору."
     1464                                     ).
     1465     end.
     1466     run gbl/del-file.p (input v-exch-file-name) .
     1467     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     1468     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     1469     if v-error-num > 0
     1470     then do:
     1471       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1472                                     , v-zip-file-name
     1473                                     , v-exch-tmp-file-name
     1474                                     , v-error-num
     1475                                     ) .
     1476     end.
     1477     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     1478     if v-error-num > 0
     1479     then do:
     1480       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1481                                     , v-exch-tmp-file-name
     1482                                     , v-exch-file-name
     1483                                     , v-error-num
     1484                                     ) .
     1485     end.
     1486     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     1487   end.
     1488   else do:
     1489     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1490     if v-error-num > 0
     1491     then do:
     1492       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1493                                     , p-xml-file-name + "xm1"
     1494                                     , p-xml-file-name + "xml"
     1495                                     , v-error-num
     1496                                     ) .
     1497     end.
     1498   end.
     1499   if opsys = "unix"
     1500   then do:
     1501       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1502   end.
     1503   end.
     1504   end procedure.
     1505   procedure xml-bge-filename0:
     1506   define input parameter p-prefix   as character no-undo .
     1507   define input parameter p-name     as character no-undo .
     1508   define input parameter p-shared-process as logical no-undo .
     1509   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     1510   define output parameter p-xml-file-name  as character no-undo .
     1511   // define output parameter p-fullfnamenoext as character no-undo .
     1512   define output parameter p-locked         as logical      no-undo.
     1513   define variable v-fullfnamenoext as character no-undo .
     1514   define variable v-fileext        as character no-undo .
     1515   define variable v-fullfname      as character no-undo .
     1516   define variable v-error-num      as integer   no-undo .
     1517   do
     1518   on error undo, return error
     1519   :
     1520     case v-bge-xml-bgeflold :
     1521       when "old" then do:
     1522         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     1523         v-fileext       = ".xml":U .
     1524         v-fullfname     = v-fullfnamenoext + v-fileext .
     1525         p-xml-file-name = v-fullfname .
     1526         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1527         if v-error-num > 0 then do:
     1528           return error.
     1529         end.
     1530       end.
     1531       when "var" then do:
     1532         case p-prefix :
     1533           when "doc" then do:
     1534             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     1535             v-fileext       = ".xml":U .
     1536             v-fullfname     = v-fullfnamenoext + v-fileext .
     1537             p-xml-file-name = v-fullfname .
     1538           end.
     1539           when "day" then do:
     1540             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     1541             v-fileext       = ".xml":U .
     1542             v-fullfname     = v-fullfnamenoext + v-fileext .
     1543             p-xml-file-name = v-fullfname .
     1544           end.
     1545           otherwise do:
     1546             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1547             v-fileext       = ".xml":U .
     1548             v-fullfname     = v-fullfnamenoext + v-fileext .
     1549             p-xml-file-name = v-fullfname .
     1550           end.
     1551         end case.
     1552         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1553         if v-error-num > 0 then do:
     1554           return error.
     1555         end.
     1556       end.
     1557       when "new" then do:
     1558                   run bge/genfname.p (
     1559                       input p-home-dir
     1560                       , input p-prefix
     1561                       , input ""
     1562                       , input "xml"
     1563                       , input ""
     1564                       , output p-xml-file-name
     1565                   ).
     1566       end.
     1567       when "no-parameter" then do:
     1568         if p-shared-process then do:
     1569                       run bge/genfname.p (
     1570                           input p-home-dir
     1571                           , input "d"
     1572                           , input ""
     1573                           , input "xml"
     1574                           , input ""
     1575                           , output p-xml-file-name
     1576                       ).
     1577         end.
     1578         else do:
     1579           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1580           v-fileext       = ".xml":U .
     1581           v-fullfname     = v-fullfnamenoext + v-fileext .
     1582           p-xml-file-name = v-fullfname .
     1583           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1584           if v-error-num > 0 then do:
     1585             return error.
     1586           end.
     1587         end.
     1588       end.
     1589     end case.
     1590     assign
     1591       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1592       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     1593     .
     1594   end .
     1595   end procedure .
     1596   procedure xml-bge-filename :
     1597   do
     1598   on error undo, return error
     1599   :
     1600   define input parameter p-prefix             as character    no-undo.
     1601   define input parameter p-name               as character    no-undo.
     1602   define input parameter p-shared-process     as logical      no-undo.
     1603   define output parameter p-xml-file-name     as character    no-undo.
     1604   define output parameter p-log-file-name     as character    no-undo.
     1605   define output parameter p-locked            as logical      no-undo.
     1606   define variable v-home-dir          as character no-undo .
     1607   define variable v-error-num         as integer   no-undo .
     1608   define variable v-bge-xml-heap-dir  as character no-undo .
     1609       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1610       if v-home-dir = ?
     1611       then do:
     1612           message
     1613             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1614             skip(1)
     1615             skip "Обратитесь к администратору."
     1616           view-as alert-box error.
     1617           undo, return error .
     1618       end.
     1619       if v-bge-xml-bgeflold <> "oracle"
     1620       then do:
     1621         assign
     1622             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     1623         .
     1624       end.
     1625       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1626       if error-status :error
     1627       then do:
     1628           message
     1629             skip "Неверно задан каталог экспорта."
     1630             skip(1)
     1631             skip "Обратитесь к администратору."
     1632           view-as alert-box error.
     1633           undo, return error .
     1634       end.
     1635       if v-bge-xml-bgefmt = "dbf":U
     1636       then do:
     1637           assign
     1638               p-xml-file-name = v-home-dir
     1639               p-locked        = no
     1640           .
     1641       end.
     1642       else do:
     1643           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     1644             output p-xml-file-name, output p-locked) .
     1645       end.
     1646       if v-bge-xml-bgeflold = "oracle"
     1647       then do:
     1648         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1649         if v-bge-xml-heap-dir = ?
     1650         then do:
     1651           undo, return error substitute( "&1&2&3"
     1652                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1653                                         , chr(10)
     1654                                         , "Обратитесь к администратору.":u
     1655                                         ).
     1656         end.
     1657         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1658         if error-status :error
     1659         then do:
     1660           undo, return error substitute( "&1&2&3"
     1661                                         , "Неверно задан каталог экспорта (heap).":u
     1662                                         , chr(10)
     1663                                         , "Обратитесь к администратору.":u
     1664                                         ).
     1665         end.
     1666         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     1667           assign
     1668             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     1669           .
     1670         end.
     1671         else do:
     1672           assign
     1673             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     1674           .
     1675         end.
     1676       end.
     1677       else do:
     1678         assign
     1679             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     1680         .
     1681       end.
     1682       assign
     1683          v-bge-xml-static-log-file-name = p-log-file-name
     1684       .
     1685   end.
     1686   end procedure.
     1687   procedure bge-xml-read-config :
     1688   do
     1689   on error undo, return error return-value
     1690   :
     1691   define input  parameter p-last-date as date      no-undo .
     1692   define input  parameter p-db-num    as integer   no-undo .
     1693       define variable v-bgeclall      as character     no-undo.
     1694       define variable v-bgedict       as character     no-undo.
     1695       define variable v-bgeshift      as character     no-undo.
     1696       define variable v-par-type      as character     no-undo.
     1697       define variable v-bgeflnm       as character     no-undo.
     1698       define variable v-bgecliiv      as character     no-undo .
     1699       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     1700       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     1701       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     1702       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     1703       define variable v-db-num-str    as character     no-undo .
     1704       define variable v-param-type      as character  no-undo .
     1705       define variable v-value-character as character  no-undo .
     1706       define variable v-value-date      as date       no-undo .
     1707       define variable v-value-decimal   as decimal    no-undo .
     1708       define variable v-value-integer   as integer    no-undo .
     1709       define variable v-value-logical   as logical    no-undo .
     1710       define variable v-tth             as handle      no-undo .
     1711       run adm/shattri.p ( input "get":U
     1712                         , input  '':u
     1713                         , input  0
     1714                         , input  'bge-export':U
     1715                         , input  'bgeclall':U
     1716                         , output v-bgecliiv
     1717                         , output v-value-date
     1718                         , output v-value-decimal
     1719                         , output v-value-integer
     1720                         , output v-value-logical
     1721                         , output v-param-type
     1722                         , input-output table-handle v-tth
     1723                         ) no-error .
     1724       if error-status :error
     1725       then do:
     1726         assign
     1727           v-bge-xml-bgecliiv = no
     1728         .
     1729       end.
     1730       else do:
     1731         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     1732       end.
     1733       delete object v-tth.
     1734       assign
     1735           v-bge-xml-bgeclall = no
     1736           v-bge-xml-bgedict  = no
     1737       .
     1738       run adm/shattri.p ( input "get":U
     1739                         , input  '':u
     1740                         , input  0
     1741                         , input  'bge-export':U
     1742                         , input  'bgeclall':U
     1743                         , output v-value-character
     1744                         , output v-value-date
     1745                         , output v-value-decimal
     1746                         , output v-value-integer
     1747                         , output v-value-logical
     1748                         , output v-param-type
     1749                         , input-output table-handle v-tth
     1750                         ) no-error .
     1751       if error-status :error
     1752       then do:
     1753         assign
     1754           v-bge-xml-bgeclall = no
     1755         .
     1756       end.
     1757       else do:
     1758         assign
     1759           v-bge-xml-bgeclall = v-value-logical
     1760         .
     1761       end.
     1762       delete object v-tth.
     1763       run adm/shattri.p ( input "get":U
     1764                         , input  '':u
     1765                         , input  0
     1766                         , input  'bge-export':U
     1767                         , input  'bgedict':U
     1768                         , output v-value-character
     1769                         , output v-value-date
     1770                         , output v-value-decimal
     1771                         , output v-value-integer
     1772                         , output v-value-logical
     1773                         , output v-param-type
     1774                         , input-output table-handle v-tth
     1775                         ) no-error .
     1776       if error-status :error
     1777       then do:
     1778         assign
     1779           v-bge-xml-bgedict = no
     1780         .
     1781       end.
     1782       else do:
     1783         assign
     1784           v-bge-xml-bgedict = v-value-logical
     1785         .
     1786       end.
     1787       delete object v-tth.
     1788       run adm/shattri.p ( input "get":U
     1789                         , input  '':u
     1790                         , input  0
     1791                         , input  'bge-export':U
     1792                         , input  'bgefmt':U
     1793                         , output v-value-character
     1794                         , output v-value-date
     1795                         , output v-value-decimal
     1796                         , output v-value-integer
     1797                         , output v-value-logical
     1798                         , output v-param-type
     1799                         , input-output table-handle v-tth
     1800                         ) no-error .
     1801       if error-status :error
     1802       then do:
     1803         assign
     1804           v-bge-xml-bgefmt  = "xml":U
     1805         .
     1806       end.
     1807       else do:
     1808         assign
     1809           v-bge-xml-bgefmt  = v-value-character
     1810         .
     1811       end.
     1812       delete object v-tth.
     1813       run adm/shattri.p ( input "get":U
     1814                         , input  '':u
     1815                         , input  0
     1816                         , input  'bge-export':U
     1817                         , input  'bgeshift':U
     1818                         , output v-value-character
     1819                         , output v-value-date
     1820                         , output v-value-decimal
     1821                         , output v-value-integer
     1822                         , output v-value-logical
     1823                         , output v-param-type
     1824                         , input-output table-handle v-tth
     1825                         ) no-error .
     1826       if error-status :error
     1827       then do:
     1828         assign
     1829             v-bge-xml-shift-mode = no
     1830         .
     1831       end.
     1832       else do:
     1833         assign
     1834             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     1835         .
     1836       end.
     1837       delete object v-tth.
     1838       run adm/shattri.p ( input "get":U
     1839                         , input  '':u
     1840                         , input  0
     1841                         , input  'bge-export':U
     1842                         , input  'bgeflold':U
     1843                         , output v-value-character
     1844                         , output v-value-date
     1845                         , output v-value-decimal
     1846                         , output v-value-integer
     1847                         , output v-value-logical
     1848                         , output v-param-type
     1849                         , input-output table-handle v-tth
     1850                         ) no-error .
     1851       if error-status :error
     1852       then do:
     1853         assign
     1854           v-bge-xml-bgeflold = "no-parameter":U
     1855         .
     1856       end.
     1857       else do:
     1858         assign
     1859           v-bge-xml-bgeflold  = v-value-character
     1860         .
     1861       end.
     1862       delete object v-tth.
     1863       assign
     1864         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     1865         v-bge-xml-db-num-str  = v-db-num-str
     1866       .
     1867       if p-last-date <> ?
     1868       then do:
     1869           run adm/shattri.p ( input "get":U
     1870                             , input  '':u
     1871                             , input  0
     1872                             , input  'bge-export':U
     1873                             , input  'bgeflnm':U
     1874                             , output v-value-character
     1875                             , output v-value-date
     1876                             , output v-value-decimal
     1877                             , output v-value-integer
     1878                             , output v-value-logical
     1879                             , output v-param-type
     1880                             , input-output table-handle v-tth
     1881                             ) no-error .
     1882           if error-status :error
     1883           then do:
     1884             assign
     1885               v-bgeflnm = '':U
     1886             .
     1887           end.
     1888           else do:
     1889             assign
     1890               v-bgeflnm = v-value-character
     1891             .
     1892           end.
     1893           delete object v-tth.
     1894           if v-bge-xml-bgeflold = "var"
     1895           then do:
     1896               if v-bgeflnm = ?
     1897               or num-entries( v-bgeflnm ) < 2
     1898               then do:
     1899                   assign
     1900                       v-bge-xml-bgeflold = "new"
     1901                   .
     1902               end.
     1903               else do:
     1904                   assign
     1905                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     1906                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     1907                   .
     1908                   assign
     1909                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     1910                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     1911                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1912                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     1913                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     1914                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     1915                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1916                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     1917                   .
     1918               end.
     1919           end.
     1920       end.
     1921   end.
     1922   end procedure.
     1923   procedure bge-xml-get-ref-filename :
     1924   define input parameter p-in-file-name       as character        no-undo.
     1925   define output parameter p-home-dir          as character        no-undo.
     1926   define output parameter p-out-file-name     as character        no-undo.
     1927   define output parameter p-locked            as logical          no-undo.
     1928       define variable v-counter       as integer      no-undo.
     1929       define variable v-error-level   as integer      no-undo.
     1930   do
     1931   on error undo, return error
     1932   :
     1933       run bge/bge-ini.p (
     1934             input "bge"
     1935           , output p-home-dir
     1936       ).
     1937       if return-value <> "OK"
     1938       then do:
     1939           undo, return error.
     1940       end.
     1941       assign
     1942           p-home-dir = p-home-dir + "\dict":U
     1943       .
     1944       run bge/dir_cd.p (
     1945           input p-home-dir
     1946           , input "CA"
     1947       ).
     1948       if return-value = "ERROR"
     1949       then do:
     1950           undo, return error.
     1951       end.
     1952       assign
     1953           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     1954       .
     1955       assign
     1956           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     1957       .
     1958       wait-lock:
     1959       do v-counter = 1 TO 3
     1960       :
     1961           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     1962           if p-locked = no
     1963           then do:
     1964               leave wait-lock.
     1965           end.
     1966           else do:
     1967               readkey pause 1.
     1968           end.
     1969       END.
     1970       if p-locked = yes
     1971       then do:
     1972           undo, return error.
     1973       end.
     1974       run bge/os_copy.p (
     1975             input "D":U
     1976           , input p-out-file-name + "xml":U
     1977           , input "":U
     1978           , output v-error-level
     1979       ).
     1980       if v-error-level > 0
     1981       then do:
     1982           undo, return error.
     1983       end.
     1984   end.
     1985   end procedure.
     1986   procedure bge-xml-write-ref-header :
     1987   define input parameter p-bge-name as character        no-undo.
     1988   define input parameter p-file-name as character        no-undo.
     1989       define variable v-out-string    as character    no-undo.
     1990   do
     1991   on error undo, return error
     1992   :
     1993       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     1994       put stream stmXMLOut unformatted
     1995           "<?xml version='1.0' encoding='windows-1251'?>":U
     1996       .
     1997       assign
     1998           v-out-string = substitute( "&1&2"
     1999                               , chr(10)
     2000                               , "<IBS_Trade_House>":U )
     2001       .
     2002       put stream stmXMLOut unformatted
     2003           v-out-string
     2004       .
     2005       run wp-XMLTagOpen( 1, "header", "" ).
     2006       if v-bge-xml-bgeflold = "oracle":u
     2007       then do:
     2008         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     2009         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     2010         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     2011         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     2012         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     2013       end.
     2014       else do:
     2015         run wp-XMLTagOpen( 2, "delivery", "" ).
     2016         run wp-XMLTagOpen( 3, "to", "" ).
     2017         run wp-XMLTagClose( 3, "to" ).
     2018         run wp-XMLTagOpen( 3, "from", "" ).
     2019         run wp-XMLTagClose( 3, "from" ).
     2020         run wp-XMLTagClose( 2, "delivery" ).
     2021       end.
     2022       run wp-XMLTagOpen( 2, "manifest", "" ).
     2023       run wp-XMLTagOpen( 3, "document", "" ).
     2024       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2025       run wp-XMLTagPut( 4, "description", "", 0 ).
     2026       run wp-XMLTagClose( 3, "document" ).
     2027       run wp-XMLTagClose( 2, "manifest" ).
     2028       run wp-XMLTagClose( 1, "header" ).
     2029       run wp-XMLTagOpen( 1, "body", "" ).
     2030   end.
     2031   end procedure.
     2032   procedure bge-xml-write-ref-footer :
     2033   define input parameter p-file-name as character        no-undo.
     2034       define variable v-error-level   as integer      no-undo.
     2035   do
     2036   on error undo, return error
     2037   :
     2038       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2039       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2040       output stream stmXMLOut close.
     2041       run bge/os_copy.p (
     2042             input "M":U
     2043           , input p-file-name + "xm1":U
     2044           , input p-file-name + "xml":U
     2045           , output v-error-level
     2046       ).
     2047       if v-error-level > 0
     2048       then do:
     2049           undo, return error.
     2050       end.
     2051   end.
     2052   end procedure.
     2053   procedure bge-xml-out-dir :
     2054   define output parameter p-out-dir       as character    no-undo.
     2055   define output parameter p-log-file-name as character    no-undo.
     2056   do
     2057   on error undo, return error
     2058   :
     2059       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2060       if p-out-dir = ?
     2061       then do:
     2062           message
     2063             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2064                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2065             skip(1)
     2066             skip "Обратитесь к администратору."
     2067           view-as alert-box error.
     2068           undo, return error .
     2069       end.
     2070       if v-bge-xml-bgeflold <> "oracle" then assign
     2071         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2072       .
     2073       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2074       if error-status :error  then do:
     2075           run wp-XMLWriteLog in this-procedure (
     2076                 input p-log-file-name
     2077               , input 0
     2078               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2079                                   , p-out-dir
     2080                                   , return-value
     2081                                   , trim( error-status :get-message( 1 ) )
     2082                                   )
     2083           ).
     2084           undo, return error.
     2085       end.
     2086       assign
     2087           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2088           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2089       .
     2090   end.
     2091   end procedure.
     2092   procedure bge-xml-out-dir2 :
     2093   define output parameter p-out-dir       as character    no-undo.
     2094   define output parameter p-out-dirR      as character    no-undo.
     2095   define output parameter p-log-file-name as character    no-undo.
     2096   do
     2097   on error undo, return error
     2098   :
     2099       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2100       if p-out-dir = ?
     2101       then do:
     2102           message
     2103             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2104                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2105             skip(1)
     2106             skip "Обратитесь к администратору."
     2107           view-as alert-box error.
     2108           undo, return error .
     2109       end.
     2110       if v-bge-xml-bgeflold <> "oracle" then assign
     2111             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2112             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2113         .
     2114       else p-out-dirR = p-out-dir .
     2115       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2116       if error-status :error  then do:
     2117           run wp-XMLWriteLog in this-procedure (
     2118                 input p-log-file-name
     2119               , input 0
     2120               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2121                                   , p-out-dir
     2122                                   , return-value
     2123                                   , error-status :get-message( 1 )
     2124                                   )
     2125           ).
     2126           undo, return error.
     2127       end.
     2128       if p-out-dirR <> p-out-dir then do:
     2129         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2130         if error-status :error then do:
     2131           run wp-XMLWriteLog in this-procedure (
     2132                 input p-log-file-name
     2133               , input 0
     2134               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2135                                   , p-out-dirR
     2136                                   , return-value
     2137                                   , error-status :get-message( 1 )
     2138                                   )
     2139           ).
     2140           p-out-dirR = p-out-dir .
     2141         end.
     2142       end .
     2143       assign
     2144         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2145         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2146       .
     2147   end.
     2148   end procedure.
     2149   procedure bge-xml-out-file :
     2150   do
     2151   on error undo, return error
     2152   :
     2153   define input parameter p-out-dir            as character        no-undo.
     2154   define input parameter p-prefix             as character        no-undo.
     2155   define input parameter p-sheduled           as logical          no-undo.
     2156   define output parameter p-xml-file-name     as character        no-undo.
     2157   define output parameter p-locked            as logical          no-undo.
     2158   define variable v-home-dir      as character     no-undo.
     2159   define variable v-error-num     as integer       no-undo.
     2160   define variable v-today             as date         no-undo.
     2161   define variable v-time              as integer      no-undo.
     2162       if v-bge-xml-bgefmt = "dbf":U
     2163       then do:
     2164           assign
     2165               p-xml-file-name = p-out-dir
     2166               p-locked        = no
     2167           .
     2168       end.
     2169       else do:
     2170           if v-bge-xml-bgeflold = "firm":U
     2171           then do:
     2172               run bge/genfname.p (
     2173                     input p-out-dir
     2174                   , input p-prefix
     2175                   , input "":U
     2176                   , input "arj":U
     2177                   , input "":U
     2178                   , output p-xml-file-name
     2179               ).
     2180           end.
     2181           else do:
     2182               run bge/genfname.p (
     2183                     input p-out-dir
     2184                   , input p-prefix
     2185                   , input "":U
     2186                   , input "xml":U
     2187                   , input "":U
     2188                   , output p-xml-file-name
     2189               ).
     2190           end.
     2191           assign
     2192               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2193               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2194           .
     2195       end.
     2196   end.
     2197   end procedure.
     2198   procedure bge-xml-init-ext-doc-type :
     2199       define variable v-counter    as integer      no-undo.
     2200       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2201   do
     2202   for buf_temp_ext-doc-type
     2203   on error undo, return error
     2204   :
     2205       empty temp-table buf_temp_ext-doc-type.
     2206       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2207       :
     2208           create buf_temp_ext-doc-type.
     2209           assign
     2210               buf_temp_ext-doc-type.edt-key               = v-counter
     2211               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2212               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2213           .
     2214       end.
     2215   end.
     2216   end procedure.
     2217   procedure bge-xml-get-decimal-shift-num :
     2218   define input parameter p-shift-date     as date             no-undo.
     2219   define input parameter p-shift-num      as integer          no-undo.
     2220   define output parameter p-shift-decimal as decimal          no-undo.
     2221   do
     2222   on error undo, return error
     2223   :
     2224       assign
     2225           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2226       .
     2227   end.
     2228   end procedure.
     2229   procedure bge-xml-ora-exp-filename :
     2230     define input  parameter p-table-name  as character no-undo .
     2231     define input  parameter p-doc-code    as character no-undo .
     2232     define input  parameter p-obj-code    as integer   no-undo .
     2233     define output parameter p-filename    as character no-undo .
     2234     define output parameter p-seq-num     as integer   no-undo .
     2235     define variable v-ora-exp-seq     as integer   no-undo .
     2236     define variable v-ora-exp-seq-str as character no-undo .
     2237     define variable v-home-dir        as character no-undo.
     2238   do
     2239   on error undo, return error return-value
     2240   :
     2241     if v-bge-xml-bgeflold = "oracle":u
     2242     then do:
     2243       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2244       if v-home-dir = ?
     2245       then do:
     2246         undo, return error substitute( "&1&2&3":U
     2247                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2248                                       , chr(10)
     2249                                       , "Обратитесь к администратору.":U
     2250                                       ).
     2251       end.
     2252       assign
     2253           v-home-dir = v-home-dir
     2254       .
     2255       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2256       if error-status :error
     2257       then do:
     2258         undo, return error substitute( "&1&2&3":U
     2259                                       , "Неверно задан каталог экспорта.":U
     2260                                       , chr(10)
     2261                                       , "Обратитесь к администратору.":U
     2262                                       ).
     2263       end.
     2264       assign
     2265         v-ora-exp-seq = ?
     2266       .
     2267       if  p-table-name <> ? and
     2268           p-doc-code <> ?
     2269       then do:
     2270         run bge/get-oesq.p ( input p-table-name
     2271                            , input p-doc-code
     2272                            , output v-ora-exp-seq
     2273                            ) no-error .
     2274         if error-status :error = yes
     2275         then do:
     2276           undo, return error return-value .
     2277         end.
     2278       end.
     2279       if v-ora-exp-seq = ?
     2280       then do:
     2281         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2282         if error-status :error
     2283         then do:
     2284           undo, return error return-value .
     2285         end.
     2286       end.
     2287       if p-table-name <> ? and
     2288          p-doc-code   <> ?
     2289       then do:
     2290         run bge/oesqdoc.p ( input p-table-name
     2291                           , input p-doc-code
     2292                           , input v-ora-exp-seq
     2293                           ) no-error .
     2294         if error-status :error = yes
     2295         then do:
     2296           undo, return error return-value .
     2297         end.
     2298       end.
     2299       assign
     2300         p-seq-num  = v-ora-exp-seq
     2301         p-filename = substitute("&1/&2-000_&3."
     2302                                , v-home-dir
     2303                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2304                                , string(v-ora-exp-seq , "999999999")
     2305                                )
     2306       .
     2307     end.
     2308   end.
     2309   end procedure.
     2310   procedure bge-xml-date-to-str :
     2311     define input  parameter p-date  as date      no-undo .
     2312     define output parameter p-str   as character no-undo .
     2313   do
     2314   on error undo, return error return-value
     2315   :
     2316     if p-date <> ?
     2317     then do:
     2318       assign
     2319         p-str = substitute( "&1-&2-&3"
     2320                           , string( year(p-date)  , "9999")
     2321                           , string( month(p-date) , "99"  )
     2322                           , string( day(p-date)   , "99"  )
     2323                           )
     2324       .
     2325     end.
     2326     else do:
     2327       assign
     2328         p-str = ?
     2329       .
     2330     end.
     2331   end.
     2332   end procedure.
     2333   procedure bge-xml-date-str-to-str :
     2334     define input  parameter p-date-str  as character no-undo .
     2335     define output parameter p-str       as character no-undo .
     2336     define variable v-date          as date      no-undo .
     2337     define variable v-date-valid    as logical   no-undo .
     2338     define variable v-error-message as character no-undo .
     2339   do
     2340   on error undo, return error return-value
     2341   :
     2342     assign
     2343       p-str = ?
     2344     .
     2345     if p-date-str = ? or p-date-str = ""
     2346     then do:
     2347       return .
     2348     end.
     2349     run strtdate in this-procedure ( input  p-date-str
     2350                                    , output v-date
     2351                                    , output v-date-valid
     2352                                    , output v-error-message
     2353                                    ).
     2354     if v-date-valid <> true
     2355     then do:
     2356       return .
     2357     end.
     2358     assign
     2359       p-str = substitute( "&1-&2-&3"
     2360                         , string( year(v-date)  , "9999")
     2361                         , string( month(v-date) , "99"  )
     2362                         , string( day(v-date)   , "99"  )
     2363                         )
     2364     .
     2365   end.
     2366   end procedure.
     2367   procedure bge-xml-fill-tt-bgecliiv :
     2368     define input  parameter p-str as character no-undo .
     2369     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2370     define buffer buf_clients             for ub.clients.
     2371     define variable v-i         as integer   no-undo .
     2372     define variable v-count     as integer   no-undo .
     2373     define variable v-cli-count as integer   no-undo .
     2374     define variable v-client    as character no-undo .
     2375     define variable v-obj-type  as character no-undo .
     2376     define variable v-obj-code  as integer   no-undo .
     2377   do
     2378   on error undo, return error return-value
     2379   :
     2380     empty temp-table buf_tt-bge-xml-bgecliiv.
     2381     assign
     2382       v-bge-xml-bgecliiv = no
     2383       v-cli-count        = num-entries(p-str,';')
     2384     .
     2385     if v-cli-count > 0
     2386     then do:
     2387       _cli-cycle:
     2388       do v-i = 1 to v-cli-count
     2389       :
     2390         assign
     2391           v-client = entry(v-i , p-str, ';')
     2392         .
     2393         if num-entries(v-client) <> 2
     2394         then do:
     2395           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2396         end.
     2397         assign
     2398           v-obj-type = entry(1, v-client)
     2399         .
     2400         assign
     2401           v-obj-code = integer(entry(2, v-client))
     2402         no-error .
     2403         if error-status :error
     2404         then do:
     2405           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2406         end.
     2407         find first buf_clients no-lock
     2408           where buf_clients.obj-type = v-obj-type
     2409             and buf_clients.obj-code = v-obj-code
     2410         no-error.
     2411         if not available buf_clients
     2412         then do:
     2413           next _cli-cycle.
     2414         end.
     2415         find first buf_tt-bge-xml-bgecliiv no-lock
     2416           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2417             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2418         no-error .
     2419         if available buf_tt-bge-xml-bgecliiv
     2420         then do:
     2421           next _cli-cycle.
     2422         end.
     2423         create buf_tt-bge-xml-bgecliiv.
     2424         assign
     2425           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2426           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2427         .
     2428       end.
     2429     end.
     2430     else do:
     2431       assign
     2432         v-bge-xml-bgecliiv = no
     2433       .
     2434       return .
     2435     end.
     2436     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     2437     if available buf_tt-bge-xml-bgecliiv
     2438     then do:
     2439       assign
     2440         v-bge-xml-bgecliiv = yes
     2441       .
     2442     end.
     2443   end.
     2444   end procedure.
     2445   procedure bge-xml-resolve-ext-doc-type :
     2446     define input  parameter p-ext-doc-type      as character no-undo .
     2447     define input  parameter p-obj-type          as character no-undo .
     2448     define input  parameter p-obj-code          as integer   no-undo .
     2449     define output parameter p-out-ext-doc-type  as character no-undo .
     2450     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2451   do
     2452   on error undo, return error return-value
     2453   :
     2454     assign
     2455       p-out-ext-doc-type = p-ext-doc-type
     2456     .
     2457     if p-ext-doc-type <> 'ie':U
     2458     then do:
     2459       return .
     2460     end.
     2461     if v-bge-xml-bgecliiv = yes
     2462     then do:
     2463       find first buf_tt-bge-xml-bgecliiv no-lock
     2464         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     2465           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     2466       no-error .
     2467       if available buf_tt-bge-xml-bgecliiv
     2468       then do:
     2469         assign
     2470           p-out-ext-doc-type = 'iv':U
     2471         .
     2472       end.
     2473     end.
     2474   end.
     2475   end procedure.
     2476   procedure safe-wp-xmltagput :
     2477     define input  parameter pTagLevel   as integer   no-undo .
     2478     define input  parameter pTagName    as character no-undo .
     2479     define input  parameter pParValue   as character no-undo .
     2480     define input  parameter pFlagEmpty  as integer   no-undo .
     2481   do
     2482   on error undo, return error return-value
     2483   :
     2484     if v-bge-xml-bgeflold = "oracle":u
     2485     then do:
     2486       return .
     2487     end.
     2488     run wp-xmltagput in this-procedure ( input pTagLevel
     2489                                        , input pTagName
     2490                                        , input pParValue
     2491                                        , input pFlagEmpty
     2492                                        ).
     2493   end.
     2494   end procedure.
     2495   define new global shared variable g#lib-trn  as handle no-undo .
     2496   define new global shared variable g#lib-trn2 as handle no-undo .
     2497   define new global shared variable g#lib-trn3 as handle no-undo .
     2498   define new global shared variable g#lib-trn4 as handle no-undo .
     2499   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2500   define shared temp-table temp-host no-undo
     2501     field host-code like ub.store.host-code
     2502     index xpk host-code
     2503   .
     2504   define shared temp-table temp-obj no-undo
     2505     field obj-type  like ub.clients.obj-type
     2506     field obj-code  like ub.clients.obj-code
     2507     field host-code like ub.store.host-code
     2508     field db-num    like ub.clients.db-num
     2509     index xpk  obj-type obj-code
     2510     index xie1 host-code
     2511     index xie2 db-num host-code
     2512   .
     2513   procedure init-temphost:
     2514     define buffer buf_store   for ub.store .
     2515     define buffer buf_shop    for ub.shop .
     2516     define buffer buf_clients for ub.clients .
     2517     define buffer buf_db for ub.db .
     2518     define buffer buf_temp-host for temp-host .
     2519     define buffer buf_temp-obj for temp-obj .
     2520     do
     2521     on error undo, return error return-value
     2522     :
     2523       for each buf_store
     2524       on error undo, return error
     2525       :
     2526         find first buf_temp-host
     2527           where buf_temp-host.host-code = buf_store.host-code
     2528           no-error .
     2529         if not available buf_temp-host
     2530         then do:
     2531           create buf_temp-host .
     2532           assign
     2533             buf_temp-host.host-code = buf_store.host-code
     2534           .
     2535         end.
     2536         find first buf_clients no-lock
     2537           where buf_clients.obj-type = 'скл':U
     2538             and buf_clients.obj-code = buf_store.obj-code
     2539           no-error .
     2540         if not available buf_clients
     2541         then do:
     2542           message
     2543             "Ошибка при поиске клиента" skip
     2544             "Клиент" 'скл':U buf_store.obj-code skip
     2545             view-as alert-box error .
     2546           undo, return error .
     2547         end.
     2548         create buf_temp-obj .
     2549         assign
     2550           buf_temp-obj.obj-type  = 'скл':U
     2551           buf_temp-obj.obj-code  = buf_store.obj-code
     2552           buf_temp-obj.host-code = buf_store.host-code
     2553           buf_temp-obj.db-num    = buf_clients.db-num
     2554         .
     2555       end.
     2556       for each buf_shop
     2557       on error undo, return error
     2558       :
     2559         find first buf_temp-host
     2560           where buf_temp-host.host-code = buf_shop.host-code
     2561           no-error .
     2562         if not available buf_temp-host
     2563         then do:
     2564           create buf_temp-host .
     2565           assign
     2566             buf_temp-host.host-code = buf_shop.host-code
     2567           .
     2568         end.
     2569         find first buf_clients no-lock
     2570           where buf_clients.obj-type = 'маг':U
     2571             and buf_clients.obj-code = buf_shop.obj-code
     2572           no-error .
     2573         if not available buf_clients then do:
     2574           message
     2575             "Ошибка при поиске клиента" skip
     2576             "Клиент" 'маг':U buf_shop.obj-code skip
     2577             view-as alert-box error .
     2578           undo, return error .
     2579         end.
     2580         create buf_temp-obj .
     2581         assign
     2582           buf_temp-obj.obj-type  = 'маг':U
     2583           buf_temp-obj.obj-code  = buf_shop.obj-code
     2584           buf_temp-obj.host-code = buf_shop.host-code
     2585           buf_temp-obj.db-num    = buf_clients.db-num
     2586         .
     2587       end.
     2588     end.
     2589   end.
     2590   do
     2591   on error undo, return error
     2592   :
     2593   define variable v-base-code                 as integer       no-undo.
     2594   define variable v-base-abbr       like ub.currency.curr-abbr no-undo .
     2595   define variable v-base-name       like ub.currency.curr-name no-undo .
     2596   define buffer buf_currency for ub.currency.
     2597   define buffer buf_sysconf for ub.sysconf.
     2598   find first buf_sysconf no-lock where buf_sysconf.host-code = p-host-code .
     2599   if not valid-handle( p-parent-proc )
     2600   then do:
     2601       return.
     2602   end.
     2603   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2604   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     2605     (input  p-host-code
     2606     ,output v-base-code
     2607     )  .
     2608   find first buf_currency no-lock where
     2609             buf_currency.curr-code = v-base-code no-error .
     2610   if available buf_currency then
     2611   assign
     2612   v-base-abbr = buf_currency.curr-abbr
     2613   v-base-name = buf_currency.curr-name
     2614   .
     2615   OUTPUT STREAM stmXMLOut TO VALUE( sOutFile + "xm1" ) CONVERT TARGET "1251" APPEND.
     2616   RUN wp-XMLWriteCNT( hCNT, "" ).
     2617   run export-documents in this-procedure .
     2618   output stream stmxmlout close.
     2619   end.
     2620   procedure export-documents :
     2621   do
     2622   on error undo, return error
     2623   :
     2624     define variable v-ext-fin-doc-type  as character    no-undo.
     2625     define variable v-fin-doc-code      as integer      no-undo.
     2626     define variable v-doc-date          as date         no-undo.
     2627     define variable v-fact-date         as date         no-undo.
     2628     define variable v-doc-PS            as character    no-undo.
     2629     define variable v-bge-date          as date         no-undo.
     2630     define variable v-bge-date-str      as character    no-undo.
     2631     define buffer buf_fin-doc            for ub.fin-doc.
     2632     define buffer buf_c-fin-doc          for ub.c-fin-doc.
     2633     export-findocuments:
     2634     for each buf_fin-doc no-lock
     2635         where buf_fin-doc.host-code = p-host-code
     2636           and buf_fin-doc.status_  = 'факт':U
     2637           and buf_fin-doc.fact-date >= p-start-date
     2638           and buf_fin-doc.bge-date = ?
     2639     on error undo, return error
     2640     :
     2641       if buf_fin-doc.obj-type = "":U and buf_fin-doc.obj-code = 0
     2642       then do:
     2643         if buf_sysconf.firm-db-num <> p-db-num then next export-findocuments.
     2644       end.
     2645       if buf_fin-doc.obj-type = "":U and buf_fin-doc.obj-code = 0
     2646       and not (p-range = 1 or p-range = 2) then next export-findocuments.
     2647       if buf_fin-doc.obj-code <> 0
     2648       and p-range = 3
     2649       and not can-find(first temp-obj no-lock where
     2650                              temp-obj.obj-type = buf_fin-doc.obj-type
     2651                          and temp-obj.obj-code = buf_fin-doc.obj-code) then  next export-findocuments.
     2652         assign
     2653         v-ext-fin-doc-type = buf_fin-doc.fin-ext-doc-type
     2654         v-fin-doc-code     = buf_fin-doc.fin-doc-code
     2655         v-doc-date     = buf_fin-doc.doc-date
     2656         v-fact-date    = buf_fin-doc.fact-date
     2657         v-doc-ps       = buf_fin-doc.ps
     2658         .
     2659         run export-fin-doc (
     2660               input v-ext-fin-doc-type
     2661             , input p-host-code
     2662             , input v-fin-doc-code
     2663             , input v-doc-date
     2664             , input v-fact-date
     2665             , input v-doc-ps
     2666           ) no-error.
     2667         if error-status :error then do:
     2668           run wp-XMLWriteLog in this-procedure (
     2669                 input sLogFile
     2670               , input 1
     2671               , input substitute( "Ошибка экспорта финансового документа. Номер документа: &1. &2. &3 &4 "
     2672                                   , v-fin-doc-code
     2673                                   , return-value
     2674                                   , trim(error-status :get-message(1))
     2675                                   , trim(error-status :get-message(2))
     2676                                 )
     2677           ).
     2678           undo export-findocuments, next export-findocuments.
     2679         end.
     2680         run run-callback-write-doc-code in this-procedure (
     2681               input p-parent-proc
     2682             , input "fin-doc":U
     2683             , input buf_fin-doc.host-code
     2684             , input buf_fin-doc.fin-doc-code
     2685             , input 0
     2686             , input 0
     2687             , input slogfile
     2688         ).
     2689       end.
     2690       export-deleted-documents:
     2691       for each buf_c-fin-doc no-lock
     2692          where buf_c-fin-doc.host-code = p-host-code
     2693            AND buf_c-fin-doc.is-del    = yes
     2694       on error undo, return error
     2695       :
     2696         if buf_c-fin-doc.status_ <> 'факт':U then NEXT export-deleted-documents.
     2697         if buf_c-fin-doc.bge-date  <> ? then  NEXT export-deleted-documents.
     2698         assign
     2699         v-fin-doc-code     = buf_c-fin-doc.fin-doc-code
     2700         .
     2701         run export-deleted-docs in this-procedure (
     2702              input p-host-code
     2703            , input v-fin-doc-code
     2704            ,input buf_c-fin-doc.corr-user-db-num
     2705            ,input buf_c-fin-doc.chip-num
     2706         ) no-error.
     2707         if error-status:error then do:
     2708           run wp-XMLWriteLog in this-procedure (
     2709                 input sLogFile
     2710               , input 1
     2711               , input substitute( "Ошибка экспорта удаленного документа. Номер документа: &1. &2. &3 &4 "
     2712                                   , v-fin-doc-code
     2713                                   , return-value
     2714                                   , trim(error-status :get-message(1))
     2715                                   , trim(error-status :get-message(2))
     2716                               )
     2717           ).
     2718           undo export-deleted-documents, next export-deleted-documents.
     2719         end.
     2720         run run-callback-write-doc-code in this-procedure (
     2721               input p-parent-proc
     2722             , input "c-fin-doc":U
     2723             , input buf_c-fin-doc.host-code
     2724             , input buf_c-fin-doc.fin-doc-code
     2725             , input buf_c-fin-doc.corr-user-db-num
     2726             , input buf_c-fin-doc.chip-num
     2727             , input slogfile
     2728         ).
     2729     end.
     2730   end.
     2731   end procedure.
     2732   procedure export-fin-doc :
     2733   define input parameter p-ext-doc-type           as character    no-undo.
     2734   define input parameter p-host-code              as integer      no-undo .
     2735   define input parameter p-fin-doc-code           as integer      no-undo.
     2736   define input parameter p-doc-date               as date         no-undo.
     2737   define input parameter p-fact-date              as date         no-undo.
     2738   define input parameter p-doc-PS                 as character    no-undo.
     2739   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2740     define variable v-doc-code      as character    no-undo.
     2741     define variable v-exch-abbr       like ub.currency.curr-abbr no-undo .
     2742     define variable v-exch-name       like ub.currency.curr-name no-undo .
     2743     define variable v-contr-abbr       like ub.currency.curr-abbr no-undo .
     2744     define variable v-contr-name       like ub.currency.curr-name no-undo .
     2745     define variable v-contract-prn-code like ub.contract.contract-prn-code no-undo .
     2746     define variable v-contract-date     like ub.contract.contract-date no-undo .
     2747     define buffer buf_fin-doc-tax          for ub.fin-doc-tax.
     2748     define buffer buf_fin-doc              for ub.fin-doc.
     2749     define buffer buf_contract for ub.contract.
     2750   define variable v-exists-before     as logical      no-undo.
     2751   define variable v-exists-after      as logical      no-undo.
     2752   define variable v-doc-date          as date         no-undo.
     2753   define variable v-today             as date         no-undo.
     2754   define variable v-time              as integer      no-undo.
     2755   do
     2756   on error undo, return error
     2757   :
     2758    find first buf_fin-doc no-lock where
     2759              buf_fin-doc.host-code = p-host-code
     2760          AND buf_fin-doc.fin-doc-code = p-fin-doc-code no-error .
     2761     if not available buf_fin-doc then do:
     2762     end.
     2763     assign
     2764     v-doc-date  = buf_fin-doc.doc-date
     2765     .
     2766     run wp-XMLWriteCnt( hcnt, "   " + string( p-fin-doc-code ) + " от " + string( p-fact-date ) ) .
     2767     process events.
     2768     run wp-xmltagopen( 2, "operation","" ).
     2769     run wp-xmltagput( 3, "referenceNo",        string( p-fin-doc-code                       ), 0 ).
     2770     run wp-xmltagput( 3, "codeOperation",      string( p-ext-doc-type                       ), 0 ).
     2771     run wp-xmltagput( 3, "host",               string( p-host-code                          ), 0 ).
     2772     run wp-xmltagput( 3, "dateDoc",            string( v-doc-date,"99.99.9999"              ), 0 ).
     2773     run wp-xmltagput( 3, "dateFact",           string( p-fact-date,"99.99.9999"             ), 0 ).
     2774     run wp-xmltagput( 3, "valutCode",          string( v-base-code                          ), 0 ).
     2775   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2776   run wp-xmltagopen in this-procedure ( input 0 + 4, substitute("&1", 'findoc'),  "" ).
     2777   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'paymentDocID'),  input string(buf_fin-doc.fin-doc-code), input 1 ).
     2778   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'cashbookid'),  input string(buf_fin-doc.cashbookid), input 1 ).
     2779   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'paymentCodeOperation'),  input string(buf_fin-doc.fin-ext-doc-type), input 1 ).
     2780   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'paymentStatus'),  input string(buf_fin-doc.status_), input 1 ).
     2781   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'host'),  input string(buf_fin-doc.host-code), input 1 ).
     2782   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'paymentDocCode'),  input string(buf_fin-doc.prn-doc-code), input 1 ).
     2783   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'object'),  input string(buf_fin-doc.obj-type + string(buf_fin-doc.obj-code)), input 1 ).
     2784   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'paymentDateDoc'),  input string(buf_fin-doc.doc-date, '99.99.9999'), input 1 ).
     2785   if buf_fin-doc.fact-date <> ? then do:
     2786         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'paymentDateFact'),  input string(buf_fin-doc.fact-date, '99.99.9999'), input 1 ).
     2787   end.
     2788   if buf_fin-doc.pay-date <> ? then do:
     2789         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'paymentDatePay'),  input string(buf_fin-doc.pay-date, '99.99.9999'), input 1 ).
     2790   end.
     2791   if buf_fin-doc.perm-date <> ? then do:
     2792         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'paymentDatePermission'),  input string(buf_fin-doc.perm-date, '99.99.9999'), input 1 ).
     2793   end.
     2794   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'paymentDocDBNum'),  input string(buf_fin-doc.user-db-num-doc), input 1 ).
     2795   if buf_fin-doc.fact-date <> ? then do:
     2796         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'paymentFactDBNum'),  input string(buf_fin-doc.user-db-num-fact), input 1 ).
     2797   end.
     2798   if buf_fin-doc.pay-date <> ? then do:
     2799         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'paymentPayDBNum'),  input string(buf_fin-doc.user-db-num-pl), input 1 ).
     2800   end.
     2801   if buf_fin-doc.perm-date <> ? then do:
     2802         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'paymentPermissionDBNum'),  input string(buf_fin-doc.user-db-num-perm), input 1 ).
     2803   end.
     2804   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'paymentDocUserName'),  input string(buf_fin-doc.user-name-doc), input 1 ).
     2805   if buf_fin-doc.fact-date <> ? then do:
     2806         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'paymentFactUserName'),  input string(buf_fin-doc.user-name-fact), input 1 ).
     2807   end.
     2808   if buf_fin-doc.pay-date <> ? then do:
     2809         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'paymentPayUserName'),  input string(buf_fin-doc.user-name-pl), input 1 ).
     2810   end.
     2811   if buf_fin-doc.perm-date <> ? then do:
     2812         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'paymentPermissionUserName'),  input string(buf_fin-doc.user-name-perm), input 1 ).
     2813   end.
     2814   find first buf_currency no-lock where
     2815             buf_currency.curr-code = buf_fin-doc.curr-code no-error .
     2816   if available buf_currency then
     2817   assign
     2818   v-exch-abbr = buf_currency.curr-abbr
     2819   v-exch-name = buf_currency.curr-name
