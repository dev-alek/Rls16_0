     2821   else
     2822   assign
     2823   v-exch-abbr = "":U
     2824   v-exch-name = "":U
     2825   .
     2826   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'sumDoc'),  input string(buf_fin-doc.sum-doc), input 1 ).
     2827   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'paymentCrcCode'),  input string(buf_fin-doc.curr-code), input 1 ).
