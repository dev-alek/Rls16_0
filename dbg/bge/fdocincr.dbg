      594   procedure xmlchar-decode :
      595   define input parameter p-in-string      as character        no-undo.
      596   define output parameter p-out-string    as character        no-undo.
      597       define variable v-position      as integer      no-undo.
      598       define variable v-last-position as integer      no-undo.
      599       define variable v-temp-integer  as integer      no-undo.
      600       define variable v-current-char  as character    no-undo.
      601       define variable v-next-char     as character    no-undo.
      602       define variable v-success       as logical      no-undo.
      603   do
      604   on error undo, return error
      605   :
      606       assign
      607           p-out-string = "":U
      608           v-position   = 0
      609       .
      610       replace-cycle:
      611       do while yes
      612       on error undo, return error
      613       :
      614           assign
      615               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      616           .
      617           if v-last-position <= v-position
      618           then do:
      619               if v-position = 0
      620               then do:
      621                   assign
      622                       p-out-string = p-in-string
      623                   .
      624               end.
      625               else do:
      626                   assign
      627                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      628                   .
      629               end.
      630               leave replace-cycle.
      631           end.
      632           else do:
      633               assign
      634                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      635                   v-position      = v-last-position
      636                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      637               .
      638               if v-current-char = "#":U
      639               then do:
      640                   assign
      641                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      642                   .
      643                   if v-last-position > 0
      644                   then do:
      645                       run xmlchar-read-integer in this-procedure
      646                        (
      647                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      648                           , output v-temp-integer
      649                           , output v-success
      650                       ).
      651                       if v-success = yes
      652                       and v-temp-integer >= 1
      653                       and v-temp-integer <= 255
      654                       then do:
      655                           assign
      656                               p-out-string = p-out-string + chr( v-temp-integer )
      657                               v-position   = v-last-position + 1
      658                           .
      659                       end.
      660                       else do:
      661                           assign
      662                               p-out-string = p-out-string + "&":U
      663                               v-position   = v-position   + 1
      664                           .
      665                       end.
      666                   end.
      667                   else do:
      668                       assign
      669                           p-out-string = p-out-string + "&":U
      670                           v-position   = v-position   + 1
      671                       .
      672                   end.
      673               end.
      674               else do:
      675                   case substring( p-in-string, v-position + 1, 3 )
      676                   :
      677                       when "lt;":U
      678                       then do:
      679                           assign
      680                               p-out-string = p-out-string + "<":U
      681                               v-position   = v-position   + 3
      682                           .
      683                       end.
      684                       when "gt;":U
      685                       then do:
      686                           assign
      687                               p-out-string = p-out-string + ">":U
      688                               v-position   = v-position   + 3
      689                           .
      690                       end.
      691                       otherwise do:
      692                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      693                           then do:
      694                               assign
      695                                   p-out-string = p-out-string + "&":U
      696                                   v-position   = v-position   + 4
      697                               .
      698                           end.
      699                           else do:
      700                               case substring( p-in-string, v-position + 1, 5 )
      701                               :
      702                                   when "quot;":U
      703                                   then do:
      704                                       assign
      705                                           p-out-string = p-out-string + '"':U
      706                                           v-position   = v-position   + 5
      707                                       .
      708                                   end.
      709                                   when "apos;":U
      710                                   then do:
      711                                       assign
      712                                           p-out-string = p-out-string + "'":U
      713                                           v-position   = v-position   + 5
      714                                       .
      715                                   end.
      716                                   otherwise do:
      717                                       assign
      718                                           p-out-string = p-out-string + "&":U
      719                                       .
      720                                   end.
      721                               end case.
      722                           end.
      723                       end.
      724                   end case.
      725               end.
      726           end.
      727       end.
      728   end.
      729   end .
      730   procedure xmlchar-read-integer :
      731   define input parameter p-input-string      as character        no-undo.
      732   define output parameter p-output-integer   as integer          no-undo.
      733   define output parameter p-success       as logical          no-undo.
      734   do
      735   on error undo, return error
      736   :
      737       assign
      738           p-output-integer = integer( p-input-string )
      739       no-error.
      740       if error-status :error
      741       then do:
      742           assign
      743               p-success           = no
      744               p-output-integer    = 0
      745           .
      746       end.
      747       else do:
      748           assign
      749               p-success           = yes
      750           .
      751       end.
      752   end.
      753   end.
      754   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      755   procedure strtdate :
      756     define input  parameter p-str         as character no-undo .
      757     define output parameter p-value       as date      no-undo .
      758     define output parameter p-data-valid  as logical   no-undo .
      759     define output parameter p-message     as character no-undo .
      760   do
      761   on error undo, return error return-value
      762   :
      763     define variable v-value       as date      no-undo .
      764     define variable v-i           as integer   no-undo .
      765     define variable v-num         as integer   no-undo .
      766     define variable v-delim       as character no-undo .
      767     define variable v-delim-list  as character no-undo .
      768     define variable v-day         as integer   no-undo .
      769     define variable v-month       as integer   no-undo .
      770     define variable v-year        as integer   no-undo .
      771     define variable v-day-str     as character no-undo .
      772     define variable v-month-str   as character no-undo .
      773     define variable v-year-str    as character no-undo .
      774     assign
      775       p-value       = ?
      776       p-data-valid  = false
      777     .
      778     if p-str = ?
      779     then do:
      780       assign
      781         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      782       .
      783       return .
      784     end.
      785     if p-str = ""
      786     then do:
      787       assign
      788         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      789       .
      790       return .
      791     end.
      792     if length(p-str)  > 10
      793     then do:
      794       assign
      795         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      796       .
      797       return .
      798     end.
      799     assign
      800       v-delim-list = '/,-,.':U
      801     .
      802     _delim:
      803     do v-i = 1 to num-entries( v-delim-list )
      804     :
      805       assign
      806         v-delim = entry( v-i , v-delim-list )
      807         v-num   = num-entries( p-str , v-delim )
      808       .
      809       if v-num <> 3
      810       then do:
      811         assign
      812           v-delim = ''
      813         .
      814       end.
      815       else do:
      816         leave _delim.
      817       end.
      818     end.
      819     if v-delim = ''
      820     then do:
      821       assign
      822         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      823       .
      824       return .
      825     end.
      826     assign
      827       v-day-str   = entry( 1, p-str , v-delim)
      828       v-month-str = entry( 2, p-str , v-delim)
      829       v-year-str  = entry( 3, p-str , v-delim)
      830     .
      831     if  length(v-day-str) > 2   or
      832         length(v-day-str) < 1   or
      833         length(v-month-str) > 2 or
      834         length(v-month-str) < 1 or
      835         (
      836           length(v-year-str) <> 2 and
      837           length(v-year-str) <> 4
      838         )
      839     then do:
      840       assign
      841         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      842       .
      843       return .
      844     end.
      845     if length( v-year-str ) = 2
      846     then do:
      847       assign
      848         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      849       .
      850     end.
      851     assign
      852       v-day   = integer( v-day-str )
      853       v-month = integer( v-month-str)
      854       v-year  = integer( v-year-str)
      855     no-error .
      856     if error-status :error
      857     then do:
      858       assign
      859         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      860       .
      861       return .
      862     end.
      863     if v-day < 1  or
      864        v-day > 31 or
      865        v-month < 1 or
      866        v-month > 12 or
      867        v-year < 0   or
      868        v-year > 5000
      869     then do:
      870       assign
      871         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      872       .
      873       return .
      874     end.
      875     assign
      876       v-value = date( v-month, v-day, v-year )
      877     no-error .
      878     if error-status :error
      879     then do:
      880       assign
      881         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      882       .
      883       return .
      884     end.
      885     assign
      886       p-value       = v-value
      887       p-data-valid  = true
      888     .
      889   end.
      890   end procedure.
