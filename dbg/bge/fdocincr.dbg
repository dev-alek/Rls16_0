        1   block-level on error undo, throw.
        2   define input parameter p-range           as integer                 no-undo.
        3   define input parameter p-db-num          as integer                 no-undo.
        4   define input parameter p-obj-list        as character               no-undo.
        5   define input parameter p-host-code       as integer                 no-undo.
        6   define input parameter p-cur-date        as date                    no-undo.
        7   define input parameter p-start-date      as date                    no-undo.
        8   define input parameter sOutFile          as character               no-undo.
        9   define input parameter sLogFile          as character               no-undo.
       10   define input parameter p-parent-proc     as handle                  no-undo.
       11   define input parameter hEDT              as handle                  no-undo.
       12   define input parameter hCNT              as handle                  no-undo.
       13   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       14   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       15   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile: fdocincr.p $":U .
       17   define variable vss-archive     as character no-undo init "$Archive: bge/fdocincr.p $":U .
       18   define variable vss-description as character no-undo init "Экспорт платежей".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   define   shared variable g#auto as logical no-undo.
       80   define   shared variable g#news as logical no-undo.
       81   define   shared variable g#oxml as logical no-undo.
       82   define   shared variable g#esys as logical no-undo.
       83   define   shared variable g#news-source-db as integer no-undo.
       84   define   shared variable g#esys-source-esys as integer no-undo.
       85   define   shared variable g#db-num as integer   no-undo .
       86   define   shared variable g#userid as character no-undo .
       87   define   shared variable g#passwd as character no-undo .
       88   define variable vss-include-info0 as character format "X(65)" no-undo
       89   initial "@(#)$Workfile$ $Revision$".
       90   DEF STREAM stmXMLOut.
       91   DEF STREAM stmXMLLog.
       92   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       93   procedure cur-time :
       94      define output parameter p-today as date      no-undo .
       95      define output parameter p-time  as integer   no-undo .
       96     do
       97     on error undo, return error
       98     :
       99       define variable v-date1 as date      no-undo .
      100       define variable v-date2 as date      no-undo .
      101       define variable v-time  as integer   no-undo .
      102       assign
      103         v-date1 = today
      104         v-time  = time
      105         v-date2 = today
      106       .
      107       if v-date1 <> v-date2
      108       then do:
      109         assign
      110           v-date1 = today
      111           v-time  = v-time
      112         .
      113       end.
      114       assign
      115         p-today = v-date1
      116         p-time  = v-time
      117       .
      118     end.
      119   end.
      120   function cur-time-date returns character
      121   :
      122     return string(today, '99/99/9999':U) .
      123   end.
      124   function cur-time-mjd returns decimal
      125   :
      126     define variable v-date as date      no-undo .
      127     define variable v-time as integer   no-undo .
      128     run cur-time in this-procedure
      129       (output v-date
      130       ,output v-time
      131       ) .
      132     return integer(v-date) - 2400002 + (v-time / 86400) .
      133   end.
      134   function cur-time-get-ending-index returns integer
      135   (input p-number as integer
      136   )
      137   :
      138     if p-number < 0
      139     or p-number = ?
      140     then do:
      141       return 1 .
      142     end.
      143     define variable v-rest as integer   no-undo .
      144     assign
      145       p-number = p-number modulo 100
      146     .
      147     if p-number < 20
      148     then do:
      149       assign
      150         v-rest = p-number
      151       .
      152     end.
      153     else do:
      154       assign
      155         v-rest = p-number modulo 10
      156       .
      157     end.
      158     case v-rest :
      159       when 1
      160       then do:
      161         return 2 .
      162       end.
      163       when 2 or
      164       when 3 or
      165       when 4
      166       then do:
      167         return 3 .
      168       end.
      169       otherwise do:
      170         return 1 .
      171       end.
      172     end case .
      173   end.
      174   procedure cur-time-mjd-to-date :
      175      define input  parameter i-mjd-diff as decimal no-undo.
      176      define output parameter o-Date     as date    no-undo.
      177      define output parameter o-Time     as integer no-undo.
      178      define variable v-day-number as integer   no-undo .
      179      if    i-mjd-diff < 0
      180         or i-mjd-diff = ?
      181      then do:
      182         return "?" .
      183      end.
      184      assign
      185         v-day-number = truncate(i-mjd-diff,0).
      186         o-Date = date(v-day-number + 2400002).
      187         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      188     .
      189   end.
      190   function cur-time-mjd-to-string returns character
      191   (input p-mjd-diff as decimal
      192   )
      193   :
      194     define variable v-day-number as integer   no-undo .
      195     define variable v-seconds    as integer   no-undo .
      196     define variable v-hour       as integer   no-undo .
      197     define variable v-min        as integer   no-undo .
      198     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      199     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      200     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      201     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      202     if p-mjd-diff < 0
      203     or p-mjd-diff = ?
      204     then do:
      205       return "?" .
      206     end.
      207     assign
      208       v-day-number = integer(truncate(p-mjd-diff,0))
      209       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      210     .
      211     if v-seconds > 86400
      212     then do:
      213       assign
      214         v-seconds = 86400 - 1
      215       .
      216     end.
      217     if v-seconds < 0
      218     then do:
      219       assign
      220         v-seconds = 0
      221       .
      222     end.
      223     assign
      224       v-hour = truncate(v-seconds / 3600, 0)
      225     .
      226     assign
      227       v-seconds = v-seconds modulo 3600
      228     .
      229     assign
      230       v-min = truncate(v-seconds / 60, 0)
      231     .
      232     assign
      233       v-seconds = v-seconds modulo 60
      234     .
      235     return
      236         (if v-day-number <> 0
      237           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      238           else ""
      239         )
      240       + (if v-day-number <> 0 or v-hour <> 0
      241           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      242           else ""
      243         )
      244       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      245           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      246           else ""
      247         )
      248       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      249       .
      250   end.
      251   function cur-time-string returns character
      252   :
      253     define variable v-date as date      no-undo .
      254     define variable v-time as integer   no-undo .
      255     run cur-time in this-procedure
      256       (output v-date
      257       ,output v-time
      258       ) .
      259     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      260   end.
      261   function cur-time-string-sec returns character
      262   :
      263     define variable v-date as date      no-undo .
      264     define variable v-time as integer   no-undo .
      265     run cur-time in this-procedure
      266       (output v-date
      267       ,output v-time
      268       ) .
      269     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      270   end.
      271   function cur-time-custom  returns character
      272   (input p-prefix as character
      273   ,input p-date-format as character
      274   ,input p-delimiter as character
      275   ,input p-time-format as character
      276   ,input p-suffix as character
      277   )
      278   :
      279     define variable v-date as date      no-undo .
      280     define variable v-time as integer   no-undo .
      281     run cur-time in this-procedure
      282       (output v-date
      283       ,output v-time
      284       ) .
      285     return
      286       p-prefix
      287       + string(v-date, p-date-format)
      288       + p-delimiter
      289       + string(v-time, p-time-format)
      290       + p-suffix
      291       .
      292   end.
      293   function cur-time-print  returns character
      294   :
      295     define variable v-date as date      no-undo .
      296     define variable v-time as integer   no-undo .
      297     run cur-time in this-procedure
      298       (output v-date
      299       ,output v-time
      300       ) .
      301     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      302   end.
      303   function cur-time-datetime returns datetime
      304   :
      305     define variable v-char as character no-undo .
      306     define variable v-datetime as datetime no-undo .
      307     v-char = cur-time-string().
      308     v-datetime = datetime(v-char).
      309     return  v-datetime.
      310   end.
      311   function cur-time-string-msec returns character
      312   :
      313     define variable v-date as datetime  no-undo .
      314     v-date = now.
      315     return string(v-date) .
      316   end.
      317   define variable vss-include-info2 as character format "X(65)" no-undo
      318   initial "@(#)$Workfile$ $Revision$".
      319   procedure xmlchar-test :
      320   define input parameter p-in-string          as character        no-undo.
      321   define output parameter p-out-string-enc    as character        no-undo.
      322   define output parameter p-out-string-dec    as character        no-undo.
      323   do
      324   on error undo, return error
      325   :
      326          run xmlchar-encode in this-procedure
      327       (
      328             input p-in-string
      329           , output p-out-string-enc
      330       ).
      331          run xmlchar-decode in this-procedure
      332       (
      333             input p-out-string-enc
      334           , output p-out-string-dec
      335       ).
      336   end.
      337   end .
      338   procedure xmlchar-encode :
      339   define input parameter p-in-string      as character        no-undo.
      340   define output parameter p-out-string    as character        no-undo.
      341       define variable v-position      as integer      no-undo.
      342       define variable v-current-char  as character    no-undo.
      343   do
      344   on error undo, return error
      345   :
      346       assign
      347           p-out-string = "":U
      348       .
      349       case p-in-string
      350       :
      351           when ?
      352           then do:
      353               assign
      354                   p-out-string = "?":U
      355               .
      356           end.
      357           when "?":U
      358           then do:
      359               assign
      360                   p-out-string = "&#63;":U
      361               .
      362           end.
      363           otherwise do:
      364               do v-position = 1 to length( p-in-string )
      365               :
      366                   assign
      367                       v-current-char = substring( p-in-string, v-position, 1 )
      368                   .
      369                   case v-current-char
      370                   :
      371                       when "&":U
      372                       then do:
      373                           assign
      374                               p-out-string = p-out-string + "&amp;":U
      375                           .
      376                       end.
      377                       when ">":U
      378                       then do:
      379                           assign
      380                               p-out-string = p-out-string + "&gt;":U
      381                           .
      382                       end.
      383                       when "<":U
      384                       then do:
      385                           assign
      386                               p-out-string = p-out-string + "&lt;":U
      387                           .
      388                       end.
      389                       when "'":U
      390                       then do:
      391                           assign
      392                               p-out-string = p-out-string + "&apos;":U
      393                           .
      394                       end.
      395                       when '"':U
      396                       then do:
      397                           assign
      398                               p-out-string = p-out-string + "&quot;":U
      399                           .
      400                       end.
      401                       when chr(1)
      402                       then do:
      403                           assign
      404                               p-out-string = p-out-string + "":U
      405                           .
      406                       end.
      407                       when chr(2)
      408                       then do:
      409                           assign
      410                               p-out-string = p-out-string + "":U
      411                           .
      412                       end.
      413                       when chr(3)
      414                       then do:
      415                           assign
      416                               p-out-string = p-out-string + "":U
      417                           .
      418                       end.
      419                       when chr(4)
      420                       then do:
      421                           assign
      422                               p-out-string = p-out-string + "":U
      423                           .
      424                       end.
      425                       when chr(5)
      426                       then do:
      427                           assign
      428                               p-out-string = p-out-string + "":U
      429                           .
      430                       end.
      431                       when chr(6)
      432                       then do:
      433                           assign
      434                               p-out-string = p-out-string + "":U
      435                           .
      436                       end.
      437                       when chr(7)
      438                       then do:
      439                           assign
      440                               p-out-string = p-out-string + "":U
      441                           .
      442                       end.
      443                       when chr(8)
      444                       then do:
      445                           assign
      446                               p-out-string = p-out-string + "":U
      447                           .
      448                       end.
      449                       when chr(9)
      450                       then do:
      451                           assign
      452                               p-out-string = p-out-string + "":U
      453                           .
      454                       end.
      455                       when chr(29)
      456                       then do:
      457                           assign
      458                               p-out-string = p-out-string + "":U
      459                           .
      460                       end.
      461                       when chr(10)
      462                       then do:
      463                           assign
      464                               p-out-string = p-out-string + "&#10;":U
      465                           .
      466                       end.
      467                       when chr(13)
      468                       then do:
      469                           assign
      470                               p-out-string = p-out-string + "&#13;":U
      471                           .
      472                       end.
      473                       otherwise do:
      474                           assign
      475                               p-out-string = p-out-string + v-current-char
      476                           .
      477                       end.
      478                   end case.
      479               end.
      480           end.
      481       end case.
      482   end.
      483   end .
      484   procedure xmlchar-encode-1c :
