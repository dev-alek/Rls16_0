     2830   end.
     2831   if v-exch-name <> "":U then do:
     2832   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'paymentCrcname'),  input string(v-exch-name), input 1 ).
     2833   end.
     2834   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'paymentCrcRate'),  input string(buf_fin-doc.exch-rate), input 1 ).
     2835   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'paymentCrcScale'),  input string(buf_fin-doc.exch-scale), input 1 ).
     2836   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'actualPaymentCrcRate'),  input string(buf_fin-doc.actual-exch-rate), input 1 ).
     2837   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'actualPaymentCrcScale'),  input string(buf_fin-doc.actual-exch-scale), input 1 ).
     2838   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'sumRubl'),  input string(buf_fin-doc.sum-rubl), input 1 ).
     2839   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'sumBase'),  input string(buf_fin-doc.sum-base), input 1 ).
     2840   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'baseCrcCode'),  input string(v-base-code), input 1 ).
     2841   if v-base-abbr <> "":U then do:
     2842   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'baseCrcAbbr'),  input string(v-base-abbr), input 1 ).
     2843   end.
     2844   if v-base-name <> "":U then do:
     2845   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'baseCrcname'),  input string(v-base-name), input 1 ).
     2846   end.
     2847   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'baseCrcRate'),  input string(buf_fin-doc.base-rate), input 1 ).
     2848   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'baseCrcScale'),  input string(buf_fin-doc.base-scale), input 1 ).
     2849   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'actualBaseCrcRate'),  input string(buf_fin-doc.actual-base-rate), input 1 ).
     2850   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'actualBaseCrcScale'),  input string(buf_fin-doc.actual-base-scale), input 1 ).
     2851   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'conStat'),  input string(buf_fin-doc.con-stat), input 1 ).
     2852   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'conSumBase'),  input string(buf_fin-doc.con-sum-base), input 1 ).
     2853   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'conSumRubl'),  input string(buf_fin-doc.con-sum-rubl), input 1 ).
     2854   if buf_fin-doc.contract-code <> 0 then do:
     2855     find first buf_contract no-lock where
     2856               buf_contract.contract-code = buf_fin-doc.contract-code no-error .
     2857     if available buf_contract then
     2858     assign
     2859     v-contract-prn-code = buf_contract.contract-prn-code
     2860     v-contract-date     = buf_contract.contract-date
     2861     .
     2862   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'contractCode'),  input string(buf_fin-doc.contract-code), input 1 ).
     2863     if v-contract-prn-code <> "":U then do:
     2864               run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'contractNo'),  input string(v-contract-prn-code), input 1 ).
     2865     end.
     2866     if v-contract-date <> ? then do:
     2867               run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'contractDate'),  input string(v-contract-date, '99.99.9999'), input 1 ).
     2868     end.
     2869     find first buf_currency no-lock where
     2870               buf_currency.curr-code = buf_fin-doc.contract-curr no-error .
     2871     if available buf_currency then
     2872     assign
     2873     v-contr-abbr = buf_currency.curr-abbr
     2874     v-contr-name = buf_currency.curr-name
     2875     .
     2876     else
     2877     assign
     2878     v-contr-abbr = "":U
     2879     v-contr-name = "":U
     2880     .
     2881         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'sumcontract'),  input string(buf_fin-doc.sum-contr), input 1 ).
     2882         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'contractCrcCode'),  input string(buf_fin-doc.contract-curr), input 1 ).
     2883     if v-exch-abbr <> "":U then do:
     2884         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'contractCrcAbbr'),  input string(v-contr-abbr), input 1 ).
     2885     end.
     2886     if v-exch-name <> "":U then do:
     2887         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'contractCrcname'),  input string(v-contr-name), input 1 ).
     2888     end.
     2889         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'contractCrcRate'),  input string(buf_fin-doc.contract-rate), input 1 ).
     2890         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'contractCrcScale'),  input string(buf_fin-doc.contract-scale), input 1 ).
     2891         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'actualContractCrcRate'),  input string(buf_fin-doc.actual-contract-rate), input 1 ).
     2892         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'actualContractCrcScale'),  input string(buf_fin-doc.actual-contract-scale), input 1 ).
     2893   end.
     2894   if buf_fin-doc.an-uchet-code <> 0 then do:
     2895         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'analiticCode'),  input string(buf_fin-doc.an-uchet-code), input 1 ).
     2896         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'analiticCodeValue'),  input string(buf_fin-doc.an-uchet-value), input 1 ).
     2897   end.
     2898   if buf_fin-doc.cel-nazn-code <> 0 then do:
     2899         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'destinationCode'),  input string(buf_fin-doc.cel-nazn-code), input 1 ).
     2900         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'destinationCodeValue'),  input string(buf_fin-doc.cel-nazn-value), input 1 ).
     2901   end.
     2902   if buf_fin-doc.cor-acc <> 0 then do:
     2903         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'corAccCode'),  input string(buf_fin-doc.cor-acc), input 1 ).
     2904         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'corAccCodeValue'),  input string(buf_fin-doc.cor-acc-value), input 1 ).
     2905   end.
     2906   if buf_fin-doc.cor-acc1 <> 0 then do:
     2907         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'corAcc1Code'),  input string(buf_fin-doc.cor-acc1), input 1 ).
     2908         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'corAcc1CodeValue'),  input string(buf_fin-doc.cor-acc1-value), input 1 ).
     2909   end.
     2910   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'paymentPurpose'),  input string(replace(buf_fin-doc.naznach-plat, "@", "":U)), input 1 ).
     2911   if buf_fin-doc.fin-doc-type = 'пко':U
     2912   or buf_fin-doc.fin-doc-type = 'рко':U then do:
     2913         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'enclosure'),  input string(buf_fin-doc.enclosure), input 1 ).
     2914   end.
     2915   if buf_fin-doc.fin-doc-type = 'пко':U
     2916   or buf_fin-doc.fin-doc-type = 'рко':U
     2917   or buf_fin-doc.fin-doc-type = 'апп':U
     2918   or buf_fin-doc.fin-doc-type = 'апр':U
     2919   then do:
     2920         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'strDepart'),  input string(buf_fin-doc.str-podr-type + string(buf_fin-doc.str-podr-code)), input 1 ).
     2921         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'strDepartName'),  input string(buf_fin-doc.str-podr-name), input 1 ).
     2922   end.
     2923   if buf_fin-doc.fin-doc-type = 'апп':U
     2924   or buf_fin-doc.fin-doc-type = 'апр':U then do:
     2925     if num-entries(buf_fin-doc.payer-sign1, chr(4)) > 1 then do:
     2926               run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'fromPayerHeadPosition'),  input string(entry(1, buf_fin-doc.payer-sign1, chr(4))), input 1 ).
     2927               run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'fromPayer'),  input string(entry(2, buf_fin-doc.payer-sign1, chr(4))), input 1 ).
     2928     end.
     2929     else do:
     2930               run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'fromPayer'),  input string(buf_fin-doc.payer-sign1), input 1 ).
     2931     end.
     2932     if num-entries(buf_fin-doc.receiver-sign1, chr(4)) > 1 then do:
     2933               run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'fromReceiverHeadPosition'),  input string(entry(1, buf_fin-doc.receiver-sign1, chr(4))), input 1 ).
     2934               run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'fromReceiver'),  input string(entry(2, buf_fin-doc.receiver-sign1, chr(4))), input 1 ).
     2935     end.
     2936     else do:
     2937               run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'fromReceiver'),  input string(buf_fin-doc.receiver-sign1), input 1 ).
     2938     end.
     2939   end.
     2940   if buf_fin-doc.fin-doc-type = 'пко':U then do:
