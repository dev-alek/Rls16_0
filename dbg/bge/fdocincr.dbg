     2958         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'seniorAccounter'),  input string(buf_fin-doc.payer-sign2), input 1 ).
     2959   end.
     2960   if buf_fin-doc.fin-doc-type = 'пко':U then do:
     2961         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'including'),  input string(replace(buf_fin-doc.including, "@":U, "":U)), input 1 ).
