      528                       end.
      529                       when chr(7)
      530                       then do:
      531                           assign
      532                               p-out-string = p-out-string + " ":U
      533                           .
      534                       end.
      535                       when chr(8)
      536                       then do:
      537                           assign
      538                               p-out-string = p-out-string + " ":U
      539                           .
      540                       end.
      541                       when chr(9)
      542                       then do:
      543                           assign
