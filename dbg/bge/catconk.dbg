      576   procedure xmlchar-decode :
      577   define input parameter p-in-string      as character        no-undo.
      578   define output parameter p-out-string    as character        no-undo.
      579       define variable v-position      as integer      no-undo.
      580       define variable v-last-position as integer      no-undo.
      581       define variable v-temp-integer  as integer      no-undo.
      582       define variable v-current-char  as character    no-undo.
      583       define variable v-next-char     as character    no-undo.
      584       define variable v-success       as logical      no-undo.
      585   do
      586   on error undo, return error
      587   :
      588       assign
      589           p-out-string = "":U
      590           v-position   = 0
      591       .
      592       replace-cycle:
      593       do while yes
      594       on error undo, return error
      595       :
      596           assign
      597               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      598           .
      599           if v-last-position <= v-position
      600           then do:
      601               if v-position = 0
      602               then do:
      603                   assign
      604                       p-out-string = p-in-string
      605                   .
      606               end.
      607               else do:
      608                   assign
      609                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      610                   .
      611               end.
      612               leave replace-cycle.
      613           end.
      614           else do:
      615               assign
      616                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      617                   v-position      = v-last-position
      618                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      619               .
      620               if v-current-char = "#":U
      621               then do:
      622                   assign
      623                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      624                   .
      625                   if v-last-position > 0
      626                   then do:
      627                       run xmlchar-read-integer in this-procedure
      628                        (
      629                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      630                           , output v-temp-integer
      631                           , output v-success
      632                       ).
      633                       if v-success = yes
      634                       and v-temp-integer >= 1
      635                       and v-temp-integer <= 255
      636                       then do:
      637                           assign
      638                               p-out-string = p-out-string + chr( v-temp-integer )
      639                               v-position   = v-last-position + 1
      640                           .
      641                       end.
      642                       else do:
      643                           assign
      644                               p-out-string = p-out-string + "&":U
      645                               v-position   = v-position   + 1
      646                           .
      647                       end.
      648                   end.
      649                   else do:
      650                       assign
      651                           p-out-string = p-out-string + "&":U
      652                           v-position   = v-position   + 1
      653                       .
      654                   end.
      655               end.
      656               else do:
      657                   case substring( p-in-string, v-position + 1, 3 )
      658                   :
      659                       when "lt;":U
      660                       then do:
      661                           assign
      662                               p-out-string = p-out-string + "<":U
      663                               v-position   = v-position   + 3
      664                           .
      665                       end.
      666                       when "gt;":U
      667                       then do:
      668                           assign
      669                               p-out-string = p-out-string + ">":U
      670                               v-position   = v-position   + 3
      671                           .
      672                       end.
      673                       otherwise do:
      674                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      675                           then do:
      676                               assign
      677                                   p-out-string = p-out-string + "&":U
      678                                   v-position   = v-position   + 4
      679                               .
      680                           end.
      681                           else do:
      682                               case substring( p-in-string, v-position + 1, 5 )
      683                               :
      684                                   when "quot;":U
      685                                   then do:
      686                                       assign
      687                                           p-out-string = p-out-string + '"':U
      688                                           v-position   = v-position   + 5
      689                                       .
      690                                   end.
      691                                   when "apos;":U
      692                                   then do:
      693                                       assign
      694                                           p-out-string = p-out-string + "'":U
      695                                           v-position   = v-position   + 5
      696                                       .
      697                                   end.
      698                                   otherwise do:
      699                                       assign
      700                                           p-out-string = p-out-string + "&":U
      701                                       .
      702                                   end.
      703                               end case.
      704                           end.
      705                       end.
      706                   end case.
      707               end.
      708           end.
      709       end.
      710   end.
      711   end .
      712   procedure xmlchar-read-integer :
      713   define input parameter p-input-string      as character        no-undo.
      714   define output parameter p-output-integer   as integer          no-undo.
      715   define output parameter p-success       as logical          no-undo.
      716   do
      717   on error undo, return error
      718   :
      719       assign
      720           p-output-integer = integer( p-input-string )
      721       no-error.
      722       if error-status :error
      723       then do:
      724           assign
      725               p-success           = no
      726               p-output-integer    = 0
      727           .
      728       end.
      729       else do:
      730           assign
      731               p-success           = yes
      732           .
      733       end.
      734   end.
      735   end.
      736   define variable v-bgelib-bgeclall           as logical      no-undo.
      737   define variable v-bgelib-bgedict            as logical      no-undo.
      738   define temp-table temp_ext-doc-type no-undo
      739       field edt-key               as integer
      740       field ext-doc-type          as character
      741       field ext-doc-type-label    as character
      742       index pi is primary unique
      743           edt-key
      744   .
      745   define temp-table temp_bgelib_goods no-undo
      746       field gds-code as integer
      747       index pi is primary unique
      748           gds-code
      749   .
      750   define temp-table temp_bgelib_clients no-undo
      751       field obj-type as character
      752       field obj-code as integer
      753       index pi is primary unique
      754           obj-type
      755           obj-code
      756   .
      757   define temp-table temp_bgelib_dis-card no-undo
      758       field d-card as character
      759       index pi is primary unique
      760           d-card
      761   .
      762   define temp-table temp_bgelib_trn-doc no-undo
      763       field doc-code as integer
      764   .
      765   procedure bgelib-tag-open:
      766   do
      767   on error undo, return error
      768   :
      769   define input parameter v-tag-level  as integer      no-undo.
      770   define input parameter v-tag-name   as character    no-undo.
      771   define input parameter v-tag-value  as character    no-undo.
      772       put stream stmXMLOut unformatted
      773           chr(10)
      774           + fill(" ", 4 * v-tag-level)
      775           + "<" + v-tag-name
      776           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
      777           + v-tag-value + ">"
      778       .
      779   end.
      780   end procedure.
      781   procedure bgelib-tag-put:
      782   do
      783   on error undo, return error
      784   :
      785   define input parameter v-tag-level      as integer      no-undo.
      786   define input parameter v-tag-name       as character    no-undo.
      787   define input parameter v-tag-value      as character    no-undo.
      788   define input parameter v-empty-mode     as integer      no-undo.
      789       v-tag-name = trim(v-tag-name).
      790       if  v-empty-mode = 1
      791       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
      792       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
      793       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
      794       then do:
      795           run xmlchar-encode in this-procedure (
      796                 input v-tag-value
      797               , output v-tag-value
      798           ).
      799           put stream stmXMLOut unformatted
      800               chr(10) + fill(" ", 4 * v-tag-level)
      801                           + '<' + v-tag-name + '>'
      802                           + v-tag-value
      803                           + '</' + v-tag-name + '>'
      804           .
      805       end.
      806   end.
      807   end procedure.
      808   procedure bgelib-tag-close:
      809   do
      810   on error undo, return error
      811   :
      812   define input parameter v-tag-level as integer      no-undo.
      813   define input parameter v-tag-name  as character    no-undo.
      814       put stream stmXMLOut unformatted
      815           chr(10)
      816           + fill( " ", 4 * v-tag-level)
      817           + '</' + v-tag-name + '>'
      818       .
      819   end.
      820   end procedure.
      821   procedure bgelib-write-log:
      822   do
      823   on error undo, return error
      824   :
      825   define input parameter v-filename   as character    no-undo.
      826   define input parameter v-log-level  as integer      no-undo.
      827   define input parameter v-out-string as character    no-undo.
      828       output stream stmXMLLog to value( v-filename ) append.
      829       put stream stmXMLLog unformatted
      830           chr(10)
      831       .
      832       put stream stmXMLLog unformatted
      833           ( if v-log-level = 0
      834             or v-out-string = "&DLine"
      835             or v-out-string = "&Line"
      836             then ""
      837             else cur-time-string-sec() + " " )
      838       .
      839       put stream stmXMLLog unformatted
      840           ( if v-out-string = "&Line"
      841             then fill( "-", 80 )
      842             else if v-out-string = "&DLine"
      843                  then fill( "=", 80 )
      844                  else v-out-string )
      845       .
      846       output stream stmXMLLog close.
      847   end.
      848   end procedure.
      849   procedure bgelib-write-edt:
      850   do
      851   on error undo, return error
      852   :
      853   define input parameter v-editor-handle    as handle       no-undo.
      854   define input parameter v-log-level        as integer      no-undo.
      855   define input parameter v-out-string       as character    no-undo.
      856       if valid-handle ( v-editor-handle )
      857       then do:
      858           v-editor-handle :move-to-eof().
      859           v-editor-handle :insert-string( ( if v-log-level = 0
      860                                             or v-out-string = "&DLine"
      861                                             or v-out-string = "&Line"
      862                                             then ""
      863                                             else cur-time-string-sec() + " "
      864                                         ) ).
      865           v-editor-handle :insert-string( ( if v-out-string = "&Line"
      866                                             then fill( "-", 80 )
      867                                             else if v-out-string = "&DLine" then fill("=", 80)
      868                                             else fill( " ", v-log-level) + v-out-string
      869                                         ) ).
      870           v-editor-handle :insert-string( chr(10) ).
      871       end.
      872       process events.
      873       output to 'bgescn.txt' append.
      874           put unformatted
      875               chr(10)
      876               string( ( if v-log-level = 0
      877                         or v-out-string = "&DLine"
      878                         or v-out-string = "&Line"
      879                         then ""
      880                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
      881                     ) )
      882               string( ( if v-out-string = "&Line"
      883                         then fill( "-", 80 )
      884                         else if v-out-string = "&DLine"
      885                              then fill( "=", 80 )
      886                              else fill( " ", v-log-level ) + v-out-string
      887                     ) )
      888           .
      889       output close.
      890   end.
      891   end procedure.
      892   procedure bgelib-show-cnt:
      893   do
      894   on error undo, return error
      895   :
      896   define input parameter v-fillin-handle     as handle   no-undo.
      897       if valid-handle( v-fillin-handle )
      898       then do:
      899           assign
      900               v-fillin-handle :visible = true
      901           .
      902       end.
      903   end.
      904   end procedure.
      905   procedure bgelib-hide-cnt:
      906   do
      907   on error undo, return error
      908   :
      909   define input parameter v-fillin-handle     as handle   no-undo.
      910       if valid-handle( v-fillin-handle )
      911       then do:
      912           assign v-fillin-handle :visible = false.
      913       end.
      914   end.
      915   end procedure.
      916   procedure bgelib-write-cnt:
      917   do
      918   on error undo, return error
      919   :
      920   define input parameter v-fillin-handle    as handle       no-undo.
      921   define input parameter v-fillin-string    as character    no-undo.
      922       if valid-handle( v-fillin-handle )
      923       then do:
      924           assign
      925               v-fillin-handle :SCREEN-value = v-fillin-string
      926           .
      927       end.
      928   end.
      929   end procedure.
      930   procedure bgelib-write-header:
      931   do
      932   on error undo, return error
      933   :
      934   define input parameter p-first-file     as logical      no-undo.
      935   define input parameter p-xml-file-name  as character    no-undo.
      936   define input parameter p-list-file-name as character    no-undo.
      937   define input parameter p-file-number    as integer      no-undo.
      938   define input parameter p-have-prev      as logical      no-undo.
      939   define input parameter p-prev-filename  as character    no-undo.
      940   define input parameter p-obj-list       as character    no-undo.
      941   define input parameter p-doc-type-list  as character    no-undo.
      942   define input parameter p-parameter-list as character    no-undo.
      943       define variable v-counter    as integer        no-undo.
      944       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
      945       put stream stmXMLOut unformatted
      946           "<?xml version='1.0' encoding='windows-1251'?>"
      947       .
      948       run bgelib-tag-open( input 0, input "root"  , input "" ).
      949       run bgelib-tag-open( input 0, input "header", input "" ).
      950       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      951       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      952       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      953       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
      954       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
      955       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      956       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      957       :
      958           run bgelib-tag-put(
      959                 input 1
      960               , input entry( 2 * v-counter, p-parameter-list )
      961               , input entry( 2 * v-counter + 1, p-parameter-list )
      962               , input 0
      963           ).
      964       end.
      965       run bgelib-tag-close( input 0, input "header" ).
      966       output stream stmXMLOut close.
      967       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
      968       if p-first-file = yes
      969       then do:
      970           put stream stmXMLOut unformatted
      971               "<?xml version='1.0' encoding='windows-1251'?>"
      972           .
      973           run bgelib-tag-open( input 0, input "export", input "" ).
      974       end.
      975       run bgelib-tag-open( input 1, input "file", input "" ).
      976       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      977       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      978       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      979       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
      980       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
      981       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      982       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      983       :
      984           run bgelib-tag-put(
      985                 input 2
      986               , input trim(entry( 2 * v-counter, p-parameter-list ))
      987               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
      988               , input 0
      989           ).
      990       end.
      991       run bgelib-tag-close( input 1, input "file" ).
      992       output stream stmXMLOut close.
      993   end.
      994   end procedure.
      995   procedure bgelib-write-footer:
      996   do
      997   on error undo, return error
      998   :
      999   define input parameter p-last-file      as logical      no-undo.
     1000   define input parameter p-xml-file-name  as character    no-undo.
     1001   define input parameter p-list-file-name as character    no-undo.
     1002   define input parameter p-have-next      as logical      no-undo.
     1003   define input parameter p-next-file-name as character    no-undo.
     1004       define variable v-error-num     as integer           no-undo.
     1005       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1006       if p-have-next = yes
     1007       then do:
     1008           run bgelib-tag-open( input 0, input "footer", "" ).
     1009           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1010           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1011           run bgelib-tag-close( input 0, input "footer" ).
     1012       end.
     1013       run bgelib-tag-close( input 0, input "root" ).
     1014       output stream stmXMLOut close.
     1015       run bge/os_copy.p (
     1016             input "M"
     1017           , input p-xml-file-name + "tmp"
     1018           , input p-xml-file-name + "xml"
     1019           , output v-error-num
     1020       ).
     1021       if p-last-file = yes
     1022       then do:
     1023           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1024               run bgelib-tag-close( input 0, input "export" ).
     1025           output stream stmXMLOut close.
     1026           run bge/os_copy.p (
     1027                 input "M"
     1028               , input p-list-file-name + "tmp"
     1029               , input p-list-file-name + "xml"
     1030               , output v-error-num
     1031           ).
     1032       end.
     1033   end.
     1034   end procedure.
     1035   procedure bgelib-filename :
     1036   do
     1037   on error undo, return error
     1038   :
     1039   define input parameter p-prefix             as character    no-undo.
     1040   define output parameter p-xml-file-name     as character    no-undo.
     1041   define output parameter p-log-file-name     as character    no-undo.
     1042   define output parameter p-list-file-name    as character    no-undo.
     1043       define variable v-home-dir  as character    no-undo.
     1044       define variable v-error-num as integer      no-undo.
     1045       get-key-value section "BGE" key "outdir" value v-home-dir.
     1046       if v-home-dir = ?
     1047       then do:
     1048           message
     1049             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1050             skip(1)
     1051             skip "Обратитесь к администратору."
     1052           view-as alert-box error.
     1053           undo, return error .
     1054       end.
     1055       run gbl/dir-cre.p (
     1056           input v-home-dir
     1057       ) no-error.
     1058       if error-status :error
     1059       then do:
     1060           message
     1061             skip "Неверно задан каталог экспорта."
     1062             skip(1)
     1063             skip "Обратитесь к администратору."
     1064           view-as alert-box error.
     1065           undo, return error .
     1066       end.
     1067       run bge/genfname.p (
     1068             input v-home-dir
     1069           , input p-prefix
     1070           , input ""
     1071           , input "xml"
     1072           , input "tmp"
     1073           , output p-xml-file-name
     1074       ).
     1075       assign
     1076           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1077           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1078           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1079       .
     1080   end.
     1081   end procedure.
     1082   procedure bgelib-read-config :
     1083   do
     1084   on error undo, return error
     1085   :
     1086   define variable v-par-type as character     no-undo.
     1087     define variable v-param-type      as character  no-undo .
     1088     define variable v-value-character as character  no-undo .
     1089     define variable v-value-date      as date       no-undo .
     1090     define variable v-value-decimal   as decimal    no-undo .
     1091     define variable v-value-integer   as integer    no-undo .
     1092     define variable v-value-logical   as logical    no-undo .
     1093     define variable v-tth             as handle     no-undo .
     1094       assign
     1095           v-bgelib-bgeclall = no
     1096           v-bgelib-bgedict  = no
     1097       .
     1098       run adm/shattri.p ( input "get":U
     1099                         , input  '':u
     1100                         , input  0
     1101                         , input  'bge-export':U
     1102                         , input  'bgeclall':U
     1103                         , output v-value-character
     1104                         , output v-value-date
     1105                         , output v-value-decimal
     1106                         , output v-value-integer
     1107                         , output v-value-logical
     1108                         , output v-param-type
     1109                         , input-output table-handle v-tth
     1110                         ) no-error .
     1111       if error-status :error
     1112       then do:
     1113         assign
     1114           v-bgelib-bgeclall = no
     1115         .
     1116       end.
     1117       else do:
     1118         assign
     1119           v-bgelib-bgeclall = v-value-logical
     1120         .
     1121       end.
     1122       delete object v-tth.
     1123       run adm/shattri.p ( input "get":U
     1124                         , input  '':u
     1125                         , input  0
     1126                         , input  'bge-export':U
     1127                         , input  'bgedict':U
     1128                         , output v-value-character
     1129                         , output v-value-date
     1130                         , output v-value-decimal
     1131                         , output v-value-integer
     1132                         , output v-value-logical
     1133                         , output v-param-type
     1134                         , input-output table-handle v-tth
     1135                         ) no-error .
     1136       if error-status :error
     1137       then do:
     1138         assign
     1139           v-bgelib-bgedict = no
     1140         .
     1141       end.
     1142       else do:
     1143         assign
     1144           v-bgelib-bgedict = v-value-logical
     1145         .
     1146       end.
     1147       delete object v-tth.
     1148       run adm/shattri.p ( input "get":U
     1149                         , input  '':u
     1150                         , input  0
     1151                         , input  'bge-export':U
     1152                         , input  'bgefmt':U
     1153                         , output v-value-character
     1154                         , output v-value-date
     1155                         , output v-value-decimal
     1156                         , output v-value-integer
     1157                         , output v-value-logical
     1158                         , output v-param-type
     1159                         , input-output table-handle v-tth
     1160                         ) no-error .
     1161       if error-status :error
     1162       then do:
     1163         assign
     1164           v-bgelib-bgefmt  = "xml":U
     1165         .
     1166       end.
     1167       else do:
     1168         assign
     1169           v-bgelib-bgefmt  = v-value-character
     1170         .
     1171       end.
     1172       delete object v-tth.
     1173       run adm/shattri.p ( input "get":U
     1174                         , input  '':u
     1175                         , input  0
     1176                         , input  'bge-export':U
     1177                         , input  'bgeflold':U
     1178                         , output v-value-character
     1179                         , output v-value-date
     1180                         , output v-value-decimal
     1181                         , output v-value-integer
     1182                         , output v-value-logical
     1183                         , output v-param-type
     1184                         , input-output table-handle v-tth
     1185                         ) no-error .
     1186       if error-status :error
     1187       then do:
     1188         assign
     1189           v-bgelib-bgeflold  = "old":U
     1190         .
     1191       end.
     1192       else do:
     1193         assign
     1194           v-bgelib-bgeflold  = v-value-character
     1195         .
     1196       end.
     1197       delete object v-tth.
     1198   end.
     1199   end procedure.
     1200   procedure bgelib-check-file-size :
     1201   do
     1202   on error undo, return error
     1203   :
     1204   define input parameter p-out-filename   as character    no-undo.
     1205   define output parameter p-is-big        as logical      no-undo.
     1206       define variable v-current-position    as integer        no-undo.
     1207       assign
     1208           v-current-position = seek( stmXMLOut )
     1209       .
     1210       if v-current-position / 1024 / 1024  >= 100
     1211       then do:
     1212           assign
     1213               p-is-big = yes
     1214           .
     1215       end.
     1216   end.
     1217   end procedure.
     1218   procedure bgelib-init-ext-doc-type :
     1219       define variable v-counter    as integer      no-undo.
     1220       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     1221   do
     1222   for buf_temp_ext-doc-type
     1223   on error undo, return error
     1224   :
     1225       empty temp-table buf_temp_ext-doc-type.
     1226       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1227       :
     1228           create buf_temp_ext-doc-type.
     1229           assign
     1230               buf_temp_ext-doc-type.edt-key               = v-counter
     1231               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1232               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     1233           .
     1234       end.
     1235   end.
     1236   end procedure.
     1237       define variable v-counter               as integer      no-undo.
     1238       define variable v-xml-file-name         as character    no-undo.
     1239       define variable v-log-file-name         as character    no-undo.
     1240       define variable v-list-file-name        as character    no-undo.
     1241       define variable v-xml-file-number       as integer      no-undo.
     1242       define variable v-cancel                as logical      no-undo.
     1243       define variable v-parameter-list        as character    no-undo.
     1244       define buffer buf_condition-keeping     for ub.condition-keeping.
     1245   do
     1246   for buf_condition-keeping
     1247   on error undo, return error
     1248   :
     1249       run bgelib-filename in this-procedure (
     1250             input "cnk"
     1251           , output v-xml-file-name
     1252           , output v-log-file-name
     1253           , output v-list-file-name
     1254       ).
     1255       run gbl/waitfrsp.w (
     1256             input substring( v-xml-file-name, 1, 1 )
     1257           , input 200
     1258           , output v-cancel
     1259       ) .
     1260       if v-cancel = yes
     1261       then do:
     1262           undo, return error .
     1263       end.
     1264       run bgelib-write-log in this-procedure (
     1265             input v-log-file-name
     1266           , input 1
     1267           , input "&DLine"
     1268       ).
     1269       run bgelib-write-log in this-procedure (
     1270             input v-log-file-name
     1271           , input 1
     1272           , input substitute( "Начало выгрузки справочника условий хранения в файл &1"
     1273                                   , replace( v-xml-file-name, "/", "\" ) + "tmp"
     1274                             )
     1275       ).
     1276       assign
     1277           v-parameter-list         =  substitute( "&1,&2,&3,&4,&5,&6,&7,&8,&9"
     1278                                                  , 4
     1279                                                  , "docName"          , "catconk":U
     1280                                                  , "version"          , replace("14.0 " + replace( vss-revision + vss-date, "$", " " ),',','')
     1281                                                  , "exportDate"       , string( today,          "99/99/9999" )
     1282                                                  , "exportTime"       , string( time,           "HH:MM:SS"   )
     1283                                                 )
     1284       .
     1285       run bgelib-write-header in this-procedure (
     1286             input yes
     1287           , input v-xml-file-name
     1288           , input v-list-file-name
     1289           , input 1
     1290           , input no
     1291           , input ""
     1292           , input ""
     1293           , input ""
     1294           , input v-parameter-list
     1295       ).
     1296       for each buf_condition-keeping no-lock
     1297          where buf_condition-keeping.sts <> integer( '1':U )
     1298       on error undo, return error
     1299       :
     1300           run write-condition-keeping-line in this-procedure (
     1301                 input buf_condition-keeping.cond-keep-code
     1302               , input v-parameter-list
     1303               , input v-xml-file-name
     1304               , input v-log-file-name
     1305               , input v-list-file-name
     1306               , input v-xml-file-number
     1307               , output v-xml-file-name
     1308               , output v-xml-file-number
     1309           ).
     1310       end.
     1311       run bgelib-write-footer in this-procedure (
     1312             input yes
     1313           , input v-xml-file-name
     1314           , input v-list-file-name
     1315           , input no
     1316           , input ""
     1317       ).
     1318       run bgelib-write-log in this-procedure (
     1319             input v-log-file-name
     1320           , input 1
     1321           , input substitute( "Данные выгружены в файл &1"
     1322                                   , replace( v-xml-file-name, "/", "\" ) + "xml"
     1323                             )
     1324       ).
     1325       run bgelib-write-log in this-procedure (
     1326             input v-log-file-name
     1327           , input 1
     1328           , input "&DLine"
     1329       ).
     1330   end.
     1331   procedure write-condition-keeping-line :
     1332   define input parameter p-cond-keep-code     as integer          no-undo.
     1333   define input parameter p-parameter-list         as character    no-undo.
     1334   define input parameter p-xml-file-name          as character    no-undo.
     1335   define input parameter p-log-file-name          as character    no-undo.
     1336   define input parameter p-list-file-name         as character    no-undo.
     1337   define input parameter p-xml-file-number        as integer      no-undo.
     1338   define output parameter p-last-xml-file-name    as character    no-undo.
     1339   define output parameter p-last-xml-file-number  as integer      no-undo.
     1340       define variable v-need-new-file as logical      no-undo.
     1341       define variable v-void-string   as character    no-undo.
     1342       define variable v-prev-filename as character    no-undo.
     1343       define buffer buf_condition-keeping     for ub.condition-keeping.
     1344   do
     1345   for buf_condition-keeping
     1346   on error undo, return error
     1347   :
     1348       assign
     1349           p-last-xml-file-name   = p-xml-file-name
     1350           p-last-xml-file-number = p-xml-file-number
     1351       .
     1352       run bgelib-check-file-size in this-procedure (
     1353             input p-xml-file-name + "tmp"
     1354           , output v-need-new-file
     1355       ).
     1356       if v-need-new-file = yes
     1357       then do:
     1358           assign
     1359               v-prev-filename = p-xml-file-name
     1360           .
     1361           run bgelib-filename in this-procedure (
     1362                 input "cnk"
     1363               , output p-xml-file-name
     1364               , output v-void-string
     1365               , output v-void-string
     1366           ).
     1367           run bgelib-write-footer in this-procedure (
     1368                 input no
     1369               , input v-prev-filename
     1370               , input p-list-file-name
     1371               , input yes
     1372               , input p-xml-file-name + "xml":U
     1373           ).
     1374           run bgelib-write-log in this-procedure (
     1375                 input p-log-file-name
     1376               , input 1
     1377               , input substitute( "Данные выгружены в файл &1"
     1378                                       , replace( p-xml-file-name, "/", "\" ) + "xml"
     1379                               )
     1380           ).
     1381           assign
     1382               p-last-xml-file-number   = p-xml-file-number + 1
     1383               p-last-xml-file-name     = p-xml-file-name
     1384           .
     1385           run bgelib-write-header in this-procedure (
     1386                 input no
     1387               , input p-last-xml-file-name
     1388               , input p-list-file-name
     1389               , input p-last-xml-file-number
     1390               , input yes
     1391               , input v-prev-filename + "xml":U
     1392               , input ""
     1393               , input ""
     1394               , input p-parameter-list
     1395           ).
     1396           assign
     1397               v-need-new-file = no
     1398           .
     1399       end.
     1400       output stream stmxmlout to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1401       find first buf_condition-keeping no-lock
     1402            where buf_condition-keeping.cond-keep-code = p-cond-keep-code
     1403       .
     1404       run bgelib-tag-open in this-procedure ( input 0, input "conk":U, input "" ).
     1405       run bgelib-tag-put in this-procedure ( input 1, input "condKeepCode"      , input string( p-cond-keep-code )                      , input 0 ).
     1406       run bgelib-tag-put in this-procedure ( input 1, input "condKeepName"      , input string( buf_condition-keeping.cond-keep-name )  , input 0 ).
     1407       run bgelib-tag-put in this-procedure ( input 1, input "condKeepDes"       , input string( buf_condition-keeping.des )             , input 0 ).
     1408       run bgelib-tag-put in this-procedure ( input 1, input "condKeepHModeFrom" , input string( buf_condition-keeping.h-mode-from )     , input 0 ).
     1409       run bgelib-tag-put in this-procedure ( input 1, input "condKeepHModeTo"   , input string( buf_condition-keeping.h-mode-to )       , input 0 ).
     1410       run bgelib-tag-put in this-procedure ( input 1, input "condKeepTModeFrom" , input string( buf_condition-keeping.t-mode-from )     , input 0 ).
     1411       run bgelib-tag-put in this-procedure ( input 1, input "condKeepTModeTo"   , input string( buf_condition-keeping.t-mode-to )       , input 0 ).
     1412       run bgelib-tag-close in this-procedure ( input 0, input "conk":U ).
     1413       output stream stmxmlout close.
     1414   end.
     1415   end procedure.
