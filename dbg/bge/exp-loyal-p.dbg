      836           hSAXWriter:WRITE-DATA-ELEMENT("Name" , gds-grp.node-name   ) no-error.
      837           hSAXWriter:end-ELEMENT ("Group") no-error.
      838       end.
      839       else do:
      840           hSAXWriter:START-ELEMENT ("Group") no-error.
      841           hSAXWriter:WRITE-DATA-ELEMENT("GrpCode" ,  string(gds-grp.node-code )  ) no-error.
      842           hSAXWriter:WRITE-DATA-ELEMENT("Name" , gds-grp.node-name   ) no-error.
      843           hSAXWriter:end-ELEMENT ("Group") no-error.
      844           end.
      845           end.
      846    hSAXWriter:end-ELEMENT ("Groups") no-error.
      847   hSAXWriter:START-ELEMENT ("Goods") no-error .
      848       if p-type-exp = 1 then
      849       do:
      850           for each buf_goods  :
      851                   if buf_goods.gds-type = "т"  then v-gds-type = "g".
      852                   if buf_goods.gds-type = "у" then v-gds-type = "s".
      853   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      854   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pgtxvalg in g#library
      855     (input  buf_goods.gds-code
      856     ,input  '1':U
      857     ,input  ?
      858     ,output v-vat-pc
      859     ) no-error .
      860               if not  can-find (first goods-attr where goods-attr.gds-code = buf_goods.gds-code and  goods-attr.attr-code = 'office-type':U)
      861                   then
      862               do:
      863                   hSAXWriter:START-ELEMENT ("Good") no-error.
      864                   hSAXWriter:WRITE-DATA-ELEMENT("Gds-code" , string(buf_goods.gds-code, fill("9", p-long-code))  ) no-error.
      865                   hSAXWriter:WRITE-DATA-ELEMENT("Artic" , string(buf_goods.artic)  ) no-error.
      866                   hSAXWriter:WRITE-DATA-ELEMENT("Status" , string(buf_goods.stts)  ) no-error.
      867                   hSAXWriter:WRITE-DATA-ELEMENT("GrpCode" , string(buf_goods.grp-code)  ) no-error.
      868                   hSAXWriter:WRITE-DATA-ELEMENT("Units" , buf_goods.unit-base  ) no-error.
      869                   hSAXWriter:WRITE-DATA-ELEMENT("VAT" , string(v-vat-pc)  ) no-error.
      870                   hSAXWriter:WRITE-DATA-ELEMENT("Type" , v-gds-type  ) no-error.
      871                   hSAXWriter:WRITE-DATA-ELEMENT("Name" , buf_goods.gds-name  ) no-error.
      872                    hSAXWriter:WRITE-DATA-ELEMENT("LabelName" , buf_goods.engl-name) no-error.
      873                   hSAXWriter:end-ELEMENT ("Good") no-error.
      874               end.
      875           end.
      876       end.
      877   if p-type-exp = 2 then
      878   do:
      879       for each buf_goods:
      880   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      881   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pgtxvalg in g#library
      882     (input  buf_goods.gds-code
      883     ,input  '1':U
      884     ,input  ?
      885     ,output v-vat-pc
      886     ) no-error .
      887            if buf_goods.gds-type = "т"  then v-gds-type = "g".
      888                   if buf_goods.gds-type = "у" then v-gds-type = "s".
      889           if not can-find ( goods-attr where goods-attr.gds-code = buf_goods.gds-code and goods-attr.attr-code = 'office-type':U) then
      890           do:
      891               if   can-find  (first buf_c-goods where buf_c-goods.gds-code = buf_goods.gds-code and buf_c-goods.corr-date >= (today - p-izm-N) ) then
      892               do:
