      768   DEFINE INPUT PARAMETER p-log-handle AS HANDLE NO-UNDO.
      769   DEFINE INPUT PARAMETER p-directory AS CHARACTER NO-UNDO.
      770   define input parameter p-place as integer no-undo.
      771   define input parameter p-login as char no-undo.
      772   define input parameter p-password as char no-undo.
      773   define input parameter p-izm-N as integer no-undo.
      774   define input parameter p-code_pool as char no-undo.
      775   define input parameter p-type-exp as integer no-undo.
      776   define input parameter p-long-code as integer no-undo.
      777   define input parameter p-cb-spl-ptrl as character no-undo.
      778   define variable v-localcode   as char      no-undo.
      779   define variable v-is-petrol   as logical   no-undo.
      780   define variable v-is-pieces   as logical   no-undo.
      781   define variable xml-date-file as character no-undo.
      782   define variable xml-time-file as character no-undo.
      783   DEFINE VARIABLE file_name     AS CHARACTER NO-UNDO.
      784   DEFINE VARIABLE v-date-file   AS CHARACTER NO-UNDO.
      785   DEFINE VARIABLE log-file-name AS CHARACTER NO-UNDO.
      786   define variable v-vat-pc      as decimal   no-undo.
      787   define variable v-gds-type as character no-undo.
      788   define buffer buf_ext-classif for ext-classif.
      789   define buffer buf_goods       for goods.
      790   define buffer buf_goods-attr  for goods-attr.
      791   define buffer buf_c-goods for c-goods.
      792   DEFINE VARIABLE MyUUID AS RAW    NO-UNDO.
      793   DEFINE VARIABLE vGUID  AS CHARACTER NO-UNDO.
      794      define variable par-type as character no-undo.
      795   define variable  lty as character no-undo.
      796       ASSIGN
      797        MyUUID = GENERATE-UUID
      798       vGUID  = GUID(MyUUID).
      799   xml-date-file = STRING(YEAR(TODAY), "9999") + "-" + STRING(MONTH(TODAY), "99") + "-" + STRING(DAY(TODAY), "99").
      800   xml-time-file = substring(string(time,"HH:MM"),1,2)  + substring(string(time,"HH:MM"),4,2) + substring(string(time,"HH:MM:SS"),7,2).
      801   v-date-file  = STRING(YEAR(TODAY), "9999") + STRING(MONTH(TODAY), "99") + STRING(DAY(TODAY), "99") + substring(string(time,"HH:MM"),1,2) + substring(string(time,"HH:MM"),4,2).
      802   if p-place = 1 then
      803   do:
      804       log-file-name = p-directory + "GOODSANDGROUPS_Import_AddOrUpdate_.txt":U.
      805       file_name = p-directory + 'GOODSANDGROUPS_Import_AddOrUpdate_':U + v-date-file  + '.xml'.
      806   end.
      807   if p-place = 2 then
      808   do:
      809       file_name = session:temp-directory + 'GOODSANDGROUPS_Import_AddOrUpdate_':U + v-date-file  + '.xml'.
      810       assign
      811           log-file-name = "GOODSANDGROUPS_Import_AddOrUpdate_.log"
      812           .
      813    end.
      814   define variable hSAXWriter as handle no-undo.
      815   create sax-writer hSAXWriter no-error.
      816   hSAXWriter:set-output-destination("file":U, file_name) no-error.
      817   hSAXWriter:formatted = true.
      818   hSAXWriter:encoding = "UTF-8":U.
      819   hSAXWriter:start-document() no-error.
      820   hSAXWriter:START-ELEMENT ("Report") no-error.
      821    hSAXWriter:START-ELEMENT ("Header") no-error.
      822   hSAXWriter:WRITE-data-ELEMENT("Guid" , vGUID ) no-error.
      823   hSAXWriter:WRITE-data-ELEMENT("ReportType" , "GoodsAndGroups" ) no-error.
      824   hSAXWriter:WRITE-DATA-ELEMENT("ReportDate" , xml-date-file ) no-error.
      825   hSAXWriter:WRITE-DATA-ELEMENT("Time_Report" , string(integer (xml-time-file))) no-error.
      826   hSAXWriter:WRITE-data-ELEMENT("PartnerCode" , p-cb-spl-ptrl ) no-error.
      827   hSAXWriter:WRITE-DATA-ELEMENT("DataSetName" , p-code_pool ) no-error.
      828   hSAXWriter:end-ELEMENT ("Header") no-error.
      829   hSAXWriter:START-ELEMENT ("Body") no-error.
      830   hSAXWriter:START-ELEMENT ("Groups") no-error.
      831     for each gds-grp:
      832     if  gds-grp.upper-code <> 0  then do:
      833           hSAXWriter:START-ELEMENT ("Group") no-error.
      834           hSAXWriter:WRITE-DATA-ELEMENT("GrpCode" ,  string(gds-grp.node-code )  ) no-error.
