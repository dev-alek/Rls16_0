      908   hSAXWriter:end-ELEMENT ("Body") no-error.
      909   hSAXWriter:end-ELEMENT ("Report") no-error.
      910   hSAXWriter:end-document() no-error.
      911   if p-place = 2 then
      912   do:
      913       if p-directory <> "":U
      914           then
      915       do:
      916           run ftp-send in this-procedure (input (file_name )) no-error.
      917           if error-status:error
      918               then
      919           do:
      920                                 run write-log-and-file in p-log-handle (           input 1                                                               , input log-file-name                                                   , input 1                                                               , input substitute("Ошибка отправки по FTP: &1", return-value)).
      921           end.
      922           else
      923           do:
      924               os-delete value( file_name  ).
      925           end.
      926       end.
      927   end.
      928   procedure ftp-send :
      929       define input parameter p-file-name as character        no-undo.
      930       define variable v-parameter as character no-undo.
      931       do
      932           on error undo, return error
      933           :
      934           p-directory = trim(trim(replace(p-directory,'ftp:',""),chr(47)),chr(92)).
      935           v-parameter = p-directory + chr(4) +
      936               p-login + chr(4) +
      937               p-password + chr(4) +
      938               string(134217728) + chr(4) + ''
      939               +
      940               p-file-name  + chr(4) +
      941                p-file-name + chr(4) +
      942               string(no) + chr(4) + log-file-name.
      943           run gbl/ftp-put.p   ( input this-procedure:handle
      944               ,input this-procedure:handle
      945               , input p-log-handle
      946               , input v-parameter
      947               ) no-error.
      948       end.
      949   end procedure.
