      894                   hSAXWriter:WRITE-DATA-ELEMENT("Gds-code" , string(buf_goods.gds-code, fill("9", p-long-code))  ) no-error.
      895                   hSAXWriter:WRITE-DATA-ELEMENT("Status" , string(buf_goods.stts)  ) no-error.
      896                   hSAXWriter:WRITE-DATA-ELEMENT("GrpCode" , string(buf_goods.grp-code)  ) no-error.
      897                   hSAXWriter:WRITE-DATA-ELEMENT("Units" , buf_goods.unit-base  ) no-error.
      898                   hSAXWriter:WRITE-DATA-ELEMENT("VAT" , string(v-vat-pc)  ) no-error.
      899                   hSAXWriter:WRITE-DATA-ELEMENT("Type" , v-gds-type  ) no-error.
      900                   hSAXWriter:WRITE-DATA-ELEMENT("Name" , buf_goods.gds-name  ) no-error.
      901                   hSAXWriter:WRITE-DATA-ELEMENT("LabelName" , buf_goods.engl-name) no-error.
