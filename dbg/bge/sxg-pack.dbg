     1803                 buf_esys-pck-sent.esps-sendtxttimeint = 0
     1804                 buf_esys-pck-sent.esps-crenum = buf_esys-pck-sent.esps-crenum - 1
     1805                 buf_esys-pck-sent.esps-total-recs = 0
     1806               .
