     1669                     v-log-file-temp       = p-temp-dir   + chr(92) + p-file-name-no-ext + ".LOG" + ".zip":U
     1670                     v-log-file-target     = p-target-dir + chr(92) + p-file-name-no-ext + ".LOG" + ".zip":U
     1671                   .
     1672                 end.
     1673                 os-command silent
     1674                   value( v-arh-name )
     1675                   value( "-add -path=none -span=700 ":U )
     1676                   value( v-file-source-arj )
     1677                   value( p-fullfile-name )
     1678                 .
     1679                 if v-send-log then do:
