     1561         if p-file-ext = "zip" then do :
     1562           if p-action = "get" then do :
     1563             if v-arh-name = ? then
     1564               return error substitute( "&1. Программа архиватор не найдена", vss-workfile ).
     1565             v-arch = true .
     1566           end .
     1567         end .
     1568         else do :
     1569           if p-action = "get" then do :
     1570             if not can-do ("xml,p7s,p7c", p-file-ext) then return .
     1571             v-arch = false .
     1572           end .
     1573         end .
     1574       end.
     1575       otherwise do :
     1576           v-arh-name = search( "exe/arj32.exe":U ) .
