     1977                                                               , p-file-ext, v-unzip-command)  ) .
     1978               os-command silent value( v-unzip-command ) .
     1979               if os-error <> 0 and log-manager:logfile-name ne ?
     1980               then do:
     1981                   log-manager:write-message("Ошибка при распаковке os-error: " + string(os-error) , "!sxg-pack!").
     1982               end.
     1983               if searchfile(p-target-dir + chr(92) + p-file-name-no-ext + ".xml":U) = ?
     1984               then do :
     1985                 run write-to-log in p-parent-handle ( substitute("Ошибка при распаковке! Файл &1 не является архивом, либо архив битый. Пропускаем..."
     1986                                                               , p-fullfile-name)  ) .
     1987               end .
     1988               else do :
     1989                 run del-file ( input p-fullfile-name ) no-error .
     1990                 if error-status :error then do:
     1991                   return error return-value .
     1992                 end.
     1993               end .
     1994             end.
     1995           end.
     1996           else do :
     1997             run del-file ( input v-file-target ) no-error .
     1998             if error-status :error then do:
     1999               return error return-value .
     2000             end.
     2001             run ren-file ( input p-fullfile-name, input v-file-target ) no-error .
     2002             if error-status :error then do:
     2003               return error return-value .
     2004             end.
     2005           end .
     2006         end .
     2007         else do :
     2008           run ren-file ( input p-fullfile-name, input v-file-temp ) no-error .
     2009           if error-status :error then do:
     2010             return error return-value .
     2011           end.
     2012           run del-file ( input v-file-target ) no-error .
     2013           if error-status :error then do:
     2014             return error return-value .
     2015           end.
     2016           os-copy value( v-file-temp ) value( v-file-target ).
     2017           if os-error <> 0 then do:
     2018             run adm/os-err.p ( output v-err-mess ).
     2019             return error substitute( "&1. Невозможно скопировать файл &2 в каталог &3&4&5", vss-workfile, v-file-temp, p-target-dir, chr(10), v-err-mess ).
     2020           end.
     2021           run del-file ( input v-file-temp ) no-error .
     2022           if error-status :error then do:
     2023             return error return-value .
     2024           end.
     2025           if v-arch then do:
     2026           if lookup( p-file-ext, "zip") <> 0 then do:
     2027             v-unzip-command = substitute("&1 -extract -silent -nofix -over=all &2 &3":U
     2028                                         , v-arh-name
     2029                                         , v-file-target
     2030                                         , p-target-dir
     2031                                         ) .
     2032           end.
     2033           else
     2034           if lookup( p-file-ext, "arj") <> 0 then do:
     2035             v-unzip-command = substitute("&1 e -y &2 &3":U
     2036                                         , v-arh-name
     2037                                         , v-file-target
     2038                                         , p-target-dir
     2039                                         ) .
     2040           end.
     2041             run write-to-log in p-parent-handle (  substitute("Команда на распаковку &1: &2", p-file-ext, v-unzip-command)  ) .
     2042             os-command silent value( v-unzip-command ) .
     2043             run del-file ( input v-file-target ) no-error .
     2044             if error-status :error then do:
     2045               return error return-value .
     2046             end.
     2047         end.
     2048         end .
     2049       end.
     2050     end.
     2051   end procedure.
     2052   procedure del-file :
     2053     define input parameter p-del-file-name as character no-undo .
     2054     do
     2055     on error undo, return error
     2056     :
     2057       define variable v-ind      as integer   no-undo .
     2058       define variable v-err-code as integer   no-undo .
     2059       define variable v-err-mess as character no-undo .
     2060       define variable v-str      as character no-undo .
     2061       assign
     2062         file-info:file-name = p-del-file-name
     2063       .
     2064       if file-info:file-type <> ? then do:
     2065         if file-info:file-type begins "F":U then do:
     2066           assign
     2067             v-str = "файл"
     2068           .
     2069         end.
     2070         else do:
     2071           if file-info:file-type begins "D":U then do:
     2072             assign
     2073               v-str = "каталог"
     2074             .
     2075           end.
     2076           else do:
     2077             assign
     2078               v-str = "не знаю что"
     2079             .
     2080           end.
     2081         end.
     2082         bl1:
     2083         do v-ind = 1 to 60 :
     2084           os-delete value( p-del-file-name ).
     2085           assign
     2086             v-err-code = os-error
     2087             file-info:file-name = p-del-file-name
     2088           .
     2089           if v-err-code = 0
     2090             or file-info:file-type = ?
     2091           then do:
     2092             leave bl1 .
     2093           end.
     2094           pause 1 no-message .
     2095         end.
     2096         if os-error <> 0 then do:
     2097           run adm/os-err.p ( output v-err-mess ).
     2098           return error substitute( "&1. Невозможно удалить &2 &3&4&5", vss-workfile, v-str, p-del-file-name, chr(10), v-err-mess ).
     2099         end.
     2100       end.
     2101     end.
     2102     return.
     2103   end procedure.
     2104   procedure ren-file :
     2105     define input parameter p-file-source as character no-undo .
     2106     define input parameter p-file-target as character no-undo .
     2107     do
     2108     on error undo, return error
     2109     :
     2110       define variable v-ind      as integer   no-undo .
     2111       define variable v-err-code as integer   no-undo .
     2112       define variable v-err-mess as character no-undo .
     2113       run del-file ( input p-file-target ) no-error .
     2114       if error-status :error then do:
     2115         return error return-value .
     2116       end.
     2117       bl1:
     2118       do v-ind = 1 to 60 :
     2119         os-rename value( p-file-source ) value( p-file-target ).
     2120         assign
     2121           v-err-code = os-error
     2122           file-info:file-name = p-file-source
     2123         .
     2124         if v-err-code = 0
     2125           or file-info:file-type = ?
     2126         then do:
     2127           leave bl1 .
     2128         end.
     2129         pause 1 no-message .
     2130       end.
     2131       if v-err-code <> 0 then do:
     2132         run adm/os-err.p ( output v-err-mess ).
     2133         return error substitute( "&1. Невозможно переименовать файл &2 в &3&4&5", vss-workfile, p-file-source, p-file-target, chr(10), v-err-mess ).
     2134       end.
     2135     end.
     2136   end procedure.
     2137   procedure cb_getnextfilename :
     2138   define input-output parameter p-rfile-name as character no-undo .
     2139   define input-output parameter p-lfile-name as character no-undo .
     2140   define buffer buf_temp-filelist for temp-filelist.
     2141   do
     2142   on error undo, return error
     2143   :
     2144     find first buf_temp-filelist where
     2145               buf_temp-filelist.full-name > p-rfile-name no-error .
     2146     if available buf_temp-filelist then do:
     2147       assign
     2148       p-rfile-name = buf_temp-filelist.full-name
     2149       p-lfile-name =  p0-source-dir + chr(47) + buf_temp-filelist.file-name
     2150       .
     2151     end.
     2152     else do:
     2153       assign
     2154       p-rfile-name = ''
     2155       p-lfile-name = ''
     2156       .
     2157     end.
     2158   end.
     2159   end procedure.
