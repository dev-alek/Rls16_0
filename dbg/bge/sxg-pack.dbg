      344   define variable vss-include-info2 as character format "X(65)" no-undo
      345   initial "@(#)$Workfile$ $Revision$".
      346   define variable v-filelist-total-file-num           as integer      no-undo .
      347   define variable v-filelist-total-dir-num            as integer      no-undo .
      348   define variable v-filelist-main-procedure-handle    as handle       no-undo .
      349   define variable v-filelist-main-procedure-name      as character    no-undo .
      350   define temp-table temp-dirlist no-undo
      351       field dir-full-name     as character
      352       field dir-short-name    as character
      353       field need-process      as logical
      354       index xpk is primary unique dir-full-name
      355   .
      356   define temp-table temp-filelist no-undo
      357     field file-name        as character
      358     field file-name-no-ext as character
      359     field file-extension   as character
      360     field directory-name   as character
      361     field full-name        as character
      362     field dir-short-name   as character
      363     field need-process     as logical
      364     index xpk is unique primary full-name
      365     index xie1 directory-name file-name
      366     index xie2 directory-name file-name-no-ext
      367     index xie3 file-name
      368     index xie4 file-name-no-ext
      369     index xie5 need-process file-name
      370     .
      371   define stream dir-list .
      372   procedure filelist-get-file-num :
      373     define output parameter p-file-num as integer   no-undo .
      374     do
      375     on error undo, return error return-value
      376     :
      377       assign
      378         p-file-num = v-filelist-total-file-num
      379       .
      380     end.
      381   end procedure.
      382   procedure filelist-clear :
      383     do
      384     on error undo, return error return-value
      385     :
      386       define buffer buf_filelist for temp-filelist .
      387       assign
      388         v-filelist-total-file-num = 0
      389       .
      390       for each buf_filelist
      391       on error undo, return error
      392       :
      393         delete buf_filelist .
      394       end.
      395     end.
      396   end procedure.
      397   procedure filelist-init :
      398     do
      399     on error undo, return error
      400     :
      401       define input parameter p-dir-name       as character no-undo .
      402       define input parameter p-filter-ext     as logical   no-undo .
      403       define input parameter p-ext-list       as character no-undo .
      404       define input parameter p-dir-short-name as character no-undo .
      405       define buffer buf_temp-filelist for temp-filelist .
      406       if p-filter-ext = true
      407          and p-ext-list = ?
      408       or (p-filter-ext = false
      409          and p-ext-list <> ?
      410          and p-ext-list <> "":U
      411          )
      412       then do:
      413         message
      414           vss-workfile vss-revision vss-description skip
      415           "Ошибка задания входных параметров" skip
      416           "p-filter-ext" p-filter-ext skip
      417           "p-ext-list"   p-ext-list   skip
      418           view-as alert-box error .
      419         undo, return error .
      420       end.
      421       for each buf_temp-filelist
      422         where buf_temp-filelist.directory-name = p-dir-name
      423       on error undo, return error return-value
      424       :
      425         delete buf_temp-filelist .
      426       end.
      427       input stream dir-list from os-dir( p-dir-name ).
      428       define variable v-file                  as character no-undo .
      429       define variable v-path                  as character no-undo .
      430       define variable v-mask                  as character no-undo .
      431       define variable v-extension             as character no-undo .
      432       define variable v-file-name-without-ext as character no-undo .
      433       repeat
      434       on error undo, return error
      435       :
      436         import stream dir-list v-file v-path v-mask .
      437         if  v-mask <> ?
      438         and v-mask begins 'F':u
      439         then do:
      440         end.
      441         else do:
      442           next .
      443         end.
      444         if num-entries(v-file, '.':u) > 1
      445         then do:
      446           assign
      447             v-extension = entry(num-entries(v-file, '.':u), v-file,  '.':u )
      448             v-file-name-without-ext = entry(num-entries(v-file, '.':u) - 1, v-file, '.':u )
      449           .
      450         end.
      451         else do:
      452           assign
      453             v-extension = ''
      454             v-file-name-without-ext = v-file
      455           .
      456         end.
      457         if p-filter-ext = true
      458         then do:
      459           if lookup(v-extension, p-ext-list) = 0
      460           then do:
      461             next .
      462           end.
      463         end.
      464         create buf_temp-filelist .
      465         assign
      466           buf_temp-filelist.file-name        = v-file
      467           buf_temp-filelist.directory-name   = p-dir-name
      468           buf_temp-filelist.file-name-no-ext = v-file-name-without-ext
      469           buf_temp-filelist.file-extension   = v-extension
      470           buf_temp-filelist.full-name        = p-dir-name + '/':u + v-file
      471           buf_temp-filelist.dir-short-name   = p-dir-short-name
      472         .
      473         assign
      474           v-filelist-total-file-num = v-filelist-total-file-num + 1
      475         .
      476         if v-filelist-main-procedure-handle <> ?
      477         then do:
      478           run value( v-filelist-main-procedure-name ) in v-filelist-main-procedure-handle
      479             (input "file":U
      480             , input v-filelist-total-file-num
      481             , input buf_temp-filelist.full-name
      482             , input buf_temp-filelist.file-name
      483             ) no-error.
      484           if error-status :error
      485           then do:
      486             message
      487               vss-workfile vss-revision vss-description skip
      488               "filelist-dirlist-subdir-init" skip(1)
      489               skip "Ошибка при вызове процедуры вывода"
      490               skip "результатов сканирования каталогов."
      491               skip return-value
      492               skip trim(error-status :get-message(1))
      493                       trim(error-status :get-message(2))
      494                       trim(error-status :get-message(3))
      495               view-as alert-box error.
      496             undo, return error .
      497           end.
      498         end.
      499       end.
      500       input stream dir-list close .
      501       return.
      502     end.
      503   end procedure.
      504   procedure filelist-dirlist-init-by-list :
      505     do
      506     on error undo, return error
      507     :
      508       define input parameter p-root-dir   as character no-undo .
      509       define input parameter p-dir-list   as character no-undo .
      510       define input parameter p-filter-ext as logical   no-undo .
      511       define input parameter p-ext-list   as character no-undo .
      512       define variable v-num-appdir as integer   no-undo .
      513       do v-num-appdir = 1 to num-entries(p-dir-list)
      514       :
      515         define variable v-curr-dir  as character no-undo .
      516         assign
      517           v-curr-dir = entry(v-num-appdir, p-dir-list)
      518         .
      519         run filelist-init in this-procedure
      520           (input p-root-dir + '/':u + v-curr-dir
      521           ,input p-filter-ext
      522           ,input p-ext-list
      523           ,input v-curr-dir
      524           ) .
      525       end.
      526     end.
      527   end procedure.
      528   procedure filelist-dirlist-clear :
      529     do
      530     on error undo, return error
      531     :
      532       define buffer buf_temp-dirlist for temp-dirlist .
      533       assign
      534           v-filelist-total-dir-num = 0
      535       .
      536       for each buf_temp-dirlist
      537       on error undo, return error
      538       :
      539         delete buf_temp-dirlist .
      540       end.
      541     end.
      542   end procedure.
      543   procedure filelist-dirlist-subdir-init :
      544   define input parameter p-dir-name   as character no-undo .
      545       define buffer buf_temp-dirlist for temp-dirlist .
      546   do
      547   for buf_temp-dirlist
      548   on error undo, return error
      549   :
      550       assign
      551           file-info :file-name = p-dir-name
      552       .
      553       if file-info :full-pathname = ?
      554       or index( file-info :file-type, "D" ) = 0
      555       then do:
      556           message
      557               vss-workfile vss-revision vss-description skip
      558               "filelist-dirlist-init: Заданного каталога не существует."
      559               skip (1)
      560               skip "Задан каталог:"
      561               skip substitute( "'&1'", p-dir-name )
      562           view-as alert-box error .
      563           undo, return error .
      564       end.
      565       input stream dir-list from os-dir( p-dir-name ).
      566       define variable v-file                  as character no-undo .
      567       define variable v-path                  as character no-undo .
      568       define variable v-mask                  as character no-undo .
      569       file-in-directory:
      570       repeat
      571       on error undo, return error
      572       :
      573           import stream dir-list
      574               v-file
      575               v-path
      576               v-mask
      577           .
      578           if  v-mask = ?
      579           or index( v-mask, 'D':u ) = 0
      580           or v-file = ".":U
      581           or v-file = "..":U
      582           then do:
      583               next file-in-directory.
      584           end.
      585           else do:
      586               find first buf_temp-dirlist
      587                    where buf_temp-dirlist.dir-full-name    = v-path
      588               no-error.
      589               if not available buf_temp-dirlist
      590               then do:
      591                   create buf_temp-dirlist .
      592                   assign
      593                       buf_temp-dirlist.dir-full-name    = v-path
      594                       buf_temp-dirlist.dir-short-name   = v-file
      595                       buf_temp-dirlist.need-process     = yes
      596                   .
      597               end.
      598               assign
      599                   v-filelist-total-dir-num = v-filelist-total-dir-num + 1
      600               .
      601               if v-filelist-main-procedure-handle <> ?
      602               then do:
      603                   run value( v-filelist-main-procedure-name ) in v-filelist-main-procedure-handle (
      604                         input "dir":U
      605                       , input v-filelist-total-dir-num
      606                       , input buf_temp-dirlist.dir-full-name
      607                       , input buf_temp-dirlist.dir-short-name
      608                   ) no-error.
      609                   if error-status :error
      610                   then do:
      611                       message
      612                           vss-workfile vss-revision vss-description skip
      613                           "filelist-dirlist-subdir-init"
      614                           skip(1)
      615                           skip "Ошибка при вызове процедуры вывода"
      616                           skip "результатов сканирования каталогов."
      617                           skip return-value
      618                           skip trim(error-status :get-message(1))
      619                                trim(error-status :get-message(2))
      620                                trim(error-status :get-message(3))
      621                       view-as alert-box error.
      622                       undo, return error .
      623                   end.
      624               end.
      625           end.
      626       end.
      627       input stream dir-list close .
      628   end.
      629   end procedure.
      630   procedure filelist-dirlist-init :
      631   define input parameter p-dir-name   as character no-undo .
      632       define variable v-file  as character no-undo.
      633       define variable v-path  as character no-undo.
      634       define variable v-mask  as character no-undo.
      635       define buffer buf_temp-dirlist for temp-dirlist .
      636   do
      637   for buf_temp-dirlist
      638   on error undo, return error
      639   :
      640       assign
      641           file-info :file-name = p-dir-name
      642       .
      643       if file-info :full-pathname = ?
      644       or index( file-info :file-type, "D" ) = 0
      645       then do:
      646           message
      647               vss-workfile vss-revision vss-description skip
      648               "filelist-dirlist-init: Заданного каталога не существует."
      649               skip (1)
      650               skip "Задан каталог:"
      651               skip substitute( "'&1'", p-dir-name )
      652           view-as alert-box error .
      653           undo, return error .
      654       end.
      655       for each buf_temp-dirlist
      656          where buf_temp-dirlist.dir-full-name begins file-info :full-pathname
      657       on error undo, return error return-value
      658       :
      659           delete buf_temp-dirlist .
      660       end.
      661       create buf_temp-dirlist .
      662       assign
      663           buf_temp-dirlist.dir-full-name    = file-info :full-pathname
      664           buf_temp-dirlist.dir-short-name   = file-info :file-name
      665           buf_temp-dirlist.need-process     = yes
      666       .
      667       do
      668       while available buf_temp-dirlist
      669       on error undo, return error
      670       :
      671           run filelist-dirlist-subdir-init in this-procedure (
      672               input buf_temp-dirlist.dir-full-name
      673           ).
      674           assign
      675               buf_temp-dirlist.need-process = no
      676           .
      677           find first buf_temp-dirlist
      678                where buf_temp-dirlist.need-process = yes
      679           no-error.
      680       end.
      681   end.
      682   end procedure.
      683   procedure filelist-set-procedure-handle :
      684   define input parameter p-proc-handle    as handle           no-undo.
      685   define input parameter p-proc-name      as character        no-undo.
      686       define variable v-signature    as character    no-undo.
      687   do
      688   on error undo, return error
      689   :
      690       if p-proc-handle = ?
      691       or not valid-handle( p-proc-handle )
      692       or p-proc-handle :get-signature( p-proc-name ) = ""
      693       then do:
      694           assign
      695               v-filelist-main-procedure-handle = ?
      696               v-filelist-main-procedure-name   = ""
      697           .
      698           undo, return error "filelist-set-procedure-handle: Ошибка передачи handle основной процедуры или имени процедуры обработки результатов сканирования каталогов.".
      699       end.
      700       else do:
      701           assign
      702               v-signature = p-proc-handle :get-signature( p-proc-name )
      703           .
      704           if entry(   1, v-signature )    = "PROCEDURE":U
      705           and entry( 1, entry(  3, v-signature ), " ":U ) = "INPUT":U
      706           and entry( 3, entry(  3, v-signature ), " ":U ) = "CHARACTER":U
      707           and entry( 1, entry(  4, v-signature ), " ":U ) = "INPUT":U
      708           and entry( 3, entry(  4, v-signature ), " ":U ) = "INTEGER":U
      709           and entry( 1, entry(  5, v-signature ), " ":U ) = "INPUT":U
      710           and entry( 3, entry(  5, v-signature ), " ":U ) = "CHARACTER":U
      711           and entry( 1, entry(  6, v-signature ), " ":U ) = "INPUT":U
      712           and entry( 3, entry(  6, v-signature ), " ":U ) = "CHARACTER":U
      713           then do:
      714               assign
      715                   v-filelist-main-procedure-handle = p-proc-handle
      716                   v-filelist-main-procedure-name   = p-proc-name
      717               .
      718           end.
      719           else do:
      720               assign
      721                   v-filelist-main-procedure-handle = ?
      722                   v-filelist-main-procedure-name   = ""
      723               .
      724               undo, return error "filelist-set-procedure-handle: Ошибка задания параметров процедуры обработки результатов сканирования каталогов.".
      725           end.
      726       end.
      727   end.
      728   end procedure.
      729   procedure filelist-clear-procedure-handle :
      730   do
      731   on error undo, return error
      732   :
      733       assign
      734           v-filelist-main-procedure-handle = ?
      735           v-filelist-main-procedure-name   = ?
      736       .
      737   end.
      738   end procedure.
      739   procedure filelist-build-by-dirlist :
      740       define buffer buf_temp-dirlist      for temp-dirlist.
      741   do
      742   for buf_temp-dirlist
      743   on error undo, return error
      744   :
      745       for each buf_temp-dirlist
      746       on error undo, return error
      747       :
      748           run filelist-init in this-procedure (
      749                 input buf_temp-dirlist.dir-full-name
      750               , input no
      751               , input "":U
      752               , input buf_temp-dirlist.dir-short-name
      753           ).
      754       end.
      755   end.
      756   end procedure.
      757   procedure filelist-check-dir-exists :
      758   define input parameter p-dir-name   as character        no-undo.
      759   define output parameter p-exists    as logical          no-undo.
      760   do
      761   on error undo, return error
      762   :
      763       assign
      764           file-info :file-name = p-dir-name
      765       .
      766       if file-info :file-type <> ?
      767       and substring( file-info :file-type, 1, 1 ) = "D":U
      768       then do:
      769           assign
      770               p-exists = yes
      771           .
      772       end.
      773       else do:
      774           assign
      775               p-exists = no
      776           .
      777       end.
      778   end.
      779   end procedure.
      780   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      781   procedure ftp-fl_CreateFileList :
      782   define input parameter lpFindData   as  memptr no-undo.
      783   define input parameter pcSearchDir  as  char   no-undo.
      784   define variable iFileSize           as  integer no-undo.
      785   define variable lResult             as  logical no-undo.
      786   define variable v-file-name as character no-undo .
      787   define buffer buf_temp-dirlist for temp-dirlist.
      788   define buffer buf_temp-filelist for temp-filelist.
      789   do
      790   on error undo, return error
      791   :
      792       if get-long(lpFindData, 1) = 16 then do:
      793       v-file-name = get-string(lpFindData,45).
      794       find first buf_temp-dirlist where
      795                 buf_temp-dirlist.dir-full-name = pcSearchDir + chr(47) + v-file-name no-error.
      796       if not available buf_temp-dirlist then do:
      797         create buf_temp-dirlist.
      798         assign
      799         buf_temp-dirlist.dir-full-name = pcSearchDir + chr(47) + v-file-name
      800         buf_temp-dirlist.dir-short-name = v-file-name
      801         .
      802       end.
      803     end.
      804     else do:
      805       assign
      806       iFileSize = get-long(lpFindData,33)
      807       .
      808       v-file-name = get-string(lpFindData,45).
      809       if v-file-name <> '' then do:
      810         find first buf_temp-filelist where
      811                   buf_temp-filelist.full-name = pcSearchDir + chr(47) + v-file-name no-error.
      812         if not available buf_temp-filelist then do:
      813           create buf_temp-filelist.
      814           assign
      815           buf_temp-filelist.full-name = pcSearchDir + chr(47) + v-file-name
      816           buf_temp-filelist.directory-name = pcSearchDir
      817           buf_temp-filelist.file-name = v-file-name
      818           .
      819         end.
      820       end.
      821     end.
      822   end.
      823   end procedure.
