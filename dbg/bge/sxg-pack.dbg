      928   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      929   procedure cur-time :
      930      define output parameter p-today as date      no-undo .
      931      define output parameter p-time  as integer   no-undo .
      932     do
      933     on error undo, return error
      934     :
      935       define variable v-date1 as date      no-undo .
      936       define variable v-date2 as date      no-undo .
      937       define variable v-time  as integer   no-undo .
      938       assign
      939         v-date1 = today
      940         v-time  = time
      941         v-date2 = today
      942       .
      943       if v-date1 <> v-date2
      944       then do:
      945         assign
      946           v-date1 = today
      947           v-time  = v-time
      948         .
      949       end.
      950       assign
      951         p-today = v-date1
      952         p-time  = v-time
      953       .
      954     end.
      955   end.
      956   function cur-time-date returns character
      957   :
      958     return string(today, '99/99/9999':U) .
      959   end.
      960   function cur-time-mjd returns decimal
      961   :
      962     define variable v-date as date      no-undo .
      963     define variable v-time as integer   no-undo .
      964     run cur-time in this-procedure
      965       (output v-date
      966       ,output v-time
      967       ) .
      968     return integer(v-date) - 2400002 + (v-time / 86400) .
      969   end.
      970   function cur-time-get-ending-index returns integer
      971   (input p-number as integer
      972   )
      973   :
      974     if p-number < 0
      975     or p-number = ?
      976     then do:
      977       return 1 .
      978     end.
      979     define variable v-rest as integer   no-undo .
      980     assign
      981       p-number = p-number modulo 100
      982     .
      983     if p-number < 20
      984     then do:
      985       assign
      986         v-rest = p-number
      987       .
      988     end.
      989     else do:
      990       assign
      991         v-rest = p-number modulo 10
      992       .
      993     end.
      994     case v-rest :
      995       when 1
      996       then do:
      997         return 2 .
      998       end.
      999       when 2 or
     1000       when 3 or
     1001       when 4
     1002       then do:
     1003         return 3 .
     1004       end.
     1005       otherwise do:
     1006         return 1 .
     1007       end.
     1008     end case .
     1009   end.
     1010   procedure cur-time-mjd-to-date :
     1011      define input  parameter i-mjd-diff as decimal no-undo.
     1012      define output parameter o-Date     as date    no-undo.
     1013      define output parameter o-Time     as integer no-undo.
     1014      define variable v-day-number as integer   no-undo .
     1015      if    i-mjd-diff < 0
     1016         or i-mjd-diff = ?
     1017      then do:
     1018         return "?" .
     1019      end.
     1020      assign
     1021         v-day-number = truncate(i-mjd-diff,0).
     1022         o-Date = date(v-day-number + 2400002).
     1023         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1024     .
     1025   end.
     1026   function cur-time-mjd-to-string returns character
     1027   (input p-mjd-diff as decimal
     1028   )
     1029   :
     1030     define variable v-day-number as integer   no-undo .
     1031     define variable v-seconds    as integer   no-undo .
     1032     define variable v-hour       as integer   no-undo .
     1033     define variable v-min        as integer   no-undo .
     1034     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1035     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1036     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1037     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1038     if p-mjd-diff < 0
     1039     or p-mjd-diff = ?
     1040     then do:
     1041       return "?" .
     1042     end.
     1043     assign
     1044       v-day-number = integer(truncate(p-mjd-diff,0))
     1045       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1046     .
     1047     if v-seconds > 86400
     1048     then do:
     1049       assign
     1050         v-seconds = 86400 - 1
     1051       .
     1052     end.
     1053     if v-seconds < 0
     1054     then do:
     1055       assign
     1056         v-seconds = 0
     1057       .
     1058     end.
     1059     assign
     1060       v-hour = truncate(v-seconds / 3600, 0)
     1061     .
     1062     assign
     1063       v-seconds = v-seconds modulo 3600
     1064     .
     1065     assign
     1066       v-min = truncate(v-seconds / 60, 0)
     1067     .
     1068     assign
     1069       v-seconds = v-seconds modulo 60
     1070     .
     1071     return
     1072         (if v-day-number <> 0
     1073           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1074           else ""
     1075         )
     1076       + (if v-day-number <> 0 or v-hour <> 0
     1077           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1078           else ""
     1079         )
     1080       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1081           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1082           else ""
     1083         )
     1084       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1085       .
     1086   end.
     1087   function cur-time-string returns character
     1088   :
     1089     define variable v-date as date      no-undo .
     1090     define variable v-time as integer   no-undo .
     1091     run cur-time in this-procedure
     1092       (output v-date
     1093       ,output v-time
     1094       ) .
     1095     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1096   end.
     1097   function cur-time-string-sec returns character
     1098   :
     1099     define variable v-date as date      no-undo .
     1100     define variable v-time as integer   no-undo .
     1101     run cur-time in this-procedure
     1102       (output v-date
     1103       ,output v-time
     1104       ) .
     1105     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1106   end.
     1107   function cur-time-custom  returns character
     1108   (input p-prefix as character
     1109   ,input p-date-format as character
     1110   ,input p-delimiter as character
     1111   ,input p-time-format as character
     1112   ,input p-suffix as character
     1113   )
     1114   :
     1115     define variable v-date as date      no-undo .
     1116     define variable v-time as integer   no-undo .
     1117     run cur-time in this-procedure
     1118       (output v-date
     1119       ,output v-time
     1120       ) .
     1121     return
     1122       p-prefix
     1123       + string(v-date, p-date-format)
     1124       + p-delimiter
     1125       + string(v-time, p-time-format)
     1126       + p-suffix
     1127       .
     1128   end.
     1129   function cur-time-print  returns character
     1130   :
     1131     define variable v-date as date      no-undo .
     1132     define variable v-time as integer   no-undo .
     1133     run cur-time in this-procedure
     1134       (output v-date
     1135       ,output v-time
     1136       ) .
     1137     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1138   end.
     1139   function cur-time-datetime returns datetime
     1140   :
     1141     define variable v-char as character no-undo .
     1142     define variable v-datetime as datetime no-undo .
     1143     v-char = cur-time-string().
     1144     v-datetime = datetime(v-char).
     1145     return  v-datetime.
     1146   end.
     1147   function cur-time-string-msec returns character
     1148   :
     1149     define variable v-date as datetime  no-undo .
     1150     v-date = now.
     1151     return string(v-date) .
     1152   end.
     1153   FUNCTION ora-rcpt_get-rcpt-name returns character ( input p-file-name as character):
     1154   define variable v-file-name as character no-undo .
     1155   assign
     1156   v-file-name = substitute("&1-&2_&3"
     1157                             ,entry(2, entry(1, p-file-name, "_"), "-")
     1158                             ,entry(1, entry(1, p-file-name, "_"), "-")
     1159                             ,entry(2, p-file-name, "_")) no-error.
     1160   if error-status:error then v-file-name = p-file-name.
     1161   return v-file-name.
     1162   END FUNCTION.
     1163   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1164     // ext-system-attr-value для проверки сертификатов
     1165   function objExists return character
     1166   (input  ifolder as character,
     1167    input  iType   as character  ):
     1168       define variable vFileType as character no-undo init "D,F".
     1169       define variable vi        as integer no-undo.
     1170       define variable vtype as character no-undo.
     1171       if iType ne ?
     1172       then
     1173          vFileType = iType.
     1174       do vi = 1 to num-entries(vFileType):
     1175          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
     1176          vtype = file-information:file-type.
     1177          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
     1178             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
     1179             index(vtype , entry(vi,vFileType )) > 0
     1180          then return file-information:full-pathname .
     1181          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
     1182          vtype = file-information:file-type.
     1183          if file-information:file-name <> "" and
     1184             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
     1185             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
     1186             index( vtype, entry(vi,vFileType )) > 0
     1187          then return file-information:full-pathname .
     1188       end.
     1189       return ? .
     1190   end.
     1191   function SearchFile return character
     1192   (input  ifile as character):
     1193      return objExists(ifile,?).
     1194   end.
     1195   function SearchPFile return character
     1196   (input inFile as char):
     1197        define variable oFile       as character no-undo.
     1198        define variable vFileSearch as character no-undo.
     1199        define variable vNumEntry   as integer no-undo.
     1200        if inFile = "" then return ?.
     1201        vNumEntry = num-entries(inFile,".").
     1202        vFileSearch = inFile.
     1203        if    vNumEntry > 0
     1204           and (   entry(vNumEntry,inFile,".") eq "p"
     1205                or entry(vNumEntry,inFile,".") eq "w")
     1206        then do:
     1207           entry(vNumEntry,vFileSearch, ".") = "r".
     1208           oFile = search(vFileSearch ).
     1209           if oFile eq ?
     1210           then
     1211              oFile = search(inFile).
     1212        end.
     1213        else
     1214           oFile = search(vFileSearch).
     1215        return oFile.
     1216     end.
     1217   DEFINE VARIABLE v-today as date no-undo .
     1218   DEFINE VARIABLE v-time as integer no-undo .
     1219   FUNCTION availFile RETURNS logical
     1220     ( INPUT ifile AS character ) :
     1221       def var vii as int no-undo.
     1222       do vii = 1 to 5:
     1223          assign
     1224             file-info:file-name = ifile
     1225          .
     1226          if    file-info:file-type = ?
     1227             or not ( file-info:file-type begins "F":U )
     1228             or file-info:file-size = 0
     1229          then do:
     1230             if vii = 5
     1231             then do:
     1232                return false.
     1233             end.
     1234             else do:
     1235                pause 1 no-message.
     1236             end.
     1237          end.
     1238          else do:
     1239             return true.
     1240          end.
     1241       end.
     1242   end.
     1243     define stream FLStream.
     1244     define variable v-filename         as character no-undo .
     1245     define variable v-fullfilename     as character no-undo .
     1246     define variable v-filetype         as character no-undo .
     1247   //  define variable v-num-name-parts   as integer no-undo . 23/VII-2019
     1248     define variable v-r-index          as integer no-undo .
     1249     define variable v-fileext          as character no-undo .
     1250     define variable v-filenamenoext    as character no-undo .
     1251     define variable v-current-pack-num as integer no-undo .
     1252     define variable v-ftp-ip as character no-undo .
     1253     define variable v-ftp-login as character no-undo .
     1254     define variable v-ftp-password as character no-undo .
     1255     define variable v-ftp-path as character no-undo .
     1256     define variable v-ftp-path-in as character no-undo .
     1257     define variable v-ftp-path-out as character no-undo .
     1258     define variable v-flags as character no-undo .
     1259     define variable v-cmd-line as character no-undo .
     1260     define variable l-res as integer no-undo .
     1261     define variable v-type as character no-undo .
     1262     define variable v-parameter as character no-undo .
     1263     define variable log-file-name as character no-undo .
     1264       define variable v-cert-enstr       as character no-undo . // чтение v-cert-enabled строкой
     1265       define variable v-cert-enabled     as logical no-undo . // true - добавить цифровую подпись
     1266       define variable v-attr-type        as character no-undo . // для чтения значений из ext-system-attr
     1267     define buffer buf_esys-all-attr for ub.esys-all-attr.
     1268     define buffer buf_temp-filelist for temp-filelist.
     1269     define buffer buf_esys-pck-sent for ub.esys-pck-sent.
     1270   do
     1271   on error undo, return error
     1272   :
     1273     assign
     1274       file-info:file-name = p0-temp-dir
     1275     .
     1276     if file-info:file-type = ?
     1277       or not ( file-info:file-type begins "D":U )
     1278     then do:
     1279       os-create-dir value( p0-temp-dir ).
     1280       if os-error <> 0 then do:
     1281         return error substitute( "&1. Каталог &2 отсутствует, а создать его не удалось.", vss-workfile, p0-temp-dir ).
     1282       end.
     1283     end.
     1284     if p0-file-name <> ? then do:
     1285       v-fullfilename = p0-source-dir + chr(92) + p0-file-name .
     1286       assign
     1287         file-info:file-name = v-fullfilename
     1288       .
     1289       if file-info:file-type = ?
     1290         or not ( file-info:file-type begins "F":U )
     1291       then do:
     1292         return error substitute( "&1. Исходный файл &2 не найден.", vss-workfile, v-fullfilename ).
     1293       end.
     1294       v-r-index = r-index(p0-file-name, '.':u) .
     1295       if v-r-index > 0 then assign
     1296         v-filenamenoext = substring( p0-file-name, 1, v-r-index - 1 )
     1297         v-fileext       = substring( p0-file-name, v-r-index + 1 )
     1298       .
     1299       else assign
     1300         v-filenamenoext = p0-file-name
     1301         v-fileext       = "":U
     1302       .
     1303       run ext-system-attr-value in this-procedure (
     1304                                         input  p-esys-id
     1305                                        ,input  p-db-num
     1306                                        ,input  'cert-sign':U
     1307                                        ,output v-cert-enstr
     1308                                        ,output v-attr-type) .
     1309       v-cert-enabled = logical (v-cert-enstr) .
     1310       run file-s-g ( input p0-action
     1311                     ,input p0-arch
     1312                     ,input p0-file-name
     1313                     ,input v-fullfilename
     1314                     ,input v-filenamenoext
     1315                     ,input v-fileext
     1316                     ,input p0-source-dir
     1317                     ,input p0-target-dir
     1318                     ,input p0-temp-dir
     1319                     ,input p-pck-num
     1320                     ,input v-cert-enabled
     1321                    ) no-error.
     1322       if error-status :error then do:
     1323         return error return-value.
     1324       end.
     1325     end.
     1326     else do:
     1327       if p-delivery-method = integer('2':U)
     1328       or p-delivery-method = integer('1':U)
     1329       or p-delivery-method = integer('5':U)
     1330       or p-delivery-method = integer('9':U)
     1331       then do:
     1332         run ext-system-attr-value in this-procedure ( input p-esys-id
     1333                                                       ,input p-db-num
     1334                                                       ,input 'FTP':U
     1335                                                       ,output v-ftp-ip
     1336                                                       ,output v-type) no-error.
     1337         run ext-system-attr-value in this-procedure ( input p-esys-id
     1338                                                       ,input p-db-num
     1339                                                       ,input 'Login':U
     1340                                                       ,output v-ftp-login
     1341                                                       ,output v-type) no-error.
     1342         run ext-system-attr-value in this-procedure ( input p-esys-id
     1343                                                       ,input p-db-num
     1344                                                       ,input 'Password':U
     1345                                                       ,output v-ftp-password
     1346                                                       ,output v-type) no-error.
     1347         run ext-system-attr-value in this-procedure ( input p-esys-id
     1348                                                       ,input p-db-num
     1349                                                       ,input 'Path':U
     1350                                                       ,output v-ftp-path
     1351                                                       ,output v-type) no-error.
     1352         if p-delivery-method = integer('5':U) or p-delivery-method = integer('9':U) then do:
     1353           run ext-system-attr-value in this-procedure ( input p-esys-id
     1354                                                         ,input p-db-num
     1355                                                         ,input 'IN-dir':U
     1356                                                         ,output v-ftp-path-in
     1357                                                         ,output v-type) no-error.
     1358           run ext-system-attr-value in this-procedure ( input p-esys-id
     1359                                                         ,input p-db-num
     1360                                                         ,input 'OUT-dir':U
     1361                                                         ,output v-ftp-path-out
     1362                                                         ,output v-type) no-error.
     1363           v-flags = string(134217728).
     1364         end.
     1365         else do:
     1366           v-ftp-path-in = "in".
     1367           v-ftp-path-out = "out".
     1368           v-flags = string(0).
     1369         end.
     1370         run get-log-file-name in p-parent-handle ( output log-file-name) no-error.
     1371         assign
     1372         v-parameter = v-ftp-ip + chr(4) +
     1373                       v-ftp-login + chr(4) +
     1374                       v-ftp-password + chr(4) +
     1375                       v-flags + chr(4) +
     1376                       (if v-ftp-path <> ''
     1377                       then (trim (trim (trim(v-ftp-path
     1378                                       , chr(92))
     1379                                   ,chr(47))
     1380                             ,chr(92)) + chr(47))
     1381                       else '') +
     1382                       v-ftp-path-in + chr(4) +
     1383                       "ftp-fl_CreateFileList" + chr(4) +
     1384                       log-file-name.
     1385         .
     1386         for each buf_temp-filelist :
     1387           delete buf_temp-filelist.
     1388         end.
     1389         run gbl/ftp-ls.p ( input parparentproc
     1390                           ,input this-procedure:handle
     1391                           ,input p-log-handle
     1392                           ,input v-parameter ) no-error.
     1393         if not can-find(first buf_temp-filelist) then do:
     1394           if p-delivery-method = integer('5':U) or p-delivery-method = integer('9':U) then do:
     1395             define variable v-to-return as logical no-undo .
     1396             v-to-return = yes.
     1397           end.
     1398           else do:
     1399           return.
     1400         end.
     1401         end.
     1402         if not v-to-return then do:
     1403           assign
     1404           v-parameter = v-ftp-ip + chr(4) +
     1405                         v-ftp-login + chr(4) +
     1406                         v-ftp-password + chr(4) +
     1407                       v-flags + chr(4) +
     1408                       '' + chr(4) +
     1409                       '' + chr(4) +
     1410                         string(yes) + chr(4) +
     1411                       "cb_getnextfilename" + chr(4) +
     1412                         "process-edoc.txt"
     1413           .
     1414           run gbl/ftp-get.p ( input parparentproc
     1415                             ,input this-procedure:handle
     1416                             ,input p-log-handle
     1417                             ,input v-parameter ) no-error.
     1418           if error-status:error then do:
     1419             return error return-value.
     1420           end.
     1421         end.
     1422       end.
     1423       input stream FLStream from os-dir ( p0-source-dir ) .
     1424       v-current-pack-num = p-pck-num - 1.
     1425       repeat
     1426       on error undo, return error
     1427       :
     1428         import stream FLStream v-filename v-fullfilename v-filetype.
     1429         v-r-index = r-index(v-filename, '.':u) .
     1430         if v-r-index > 0 then assign
     1431           v-filenamenoext = substring( v-filename, 1, v-r-index - 1 )
     1432           v-fileext       = substring( v-filename, v-r-index + 1 )
     1433         .
     1434         else assign
     1435           v-filenamenoext = v-filename
     1436           v-fileext       = "":U
     1437         .
     1438         if v-filetype begins "F"
     1439           and v-r-index > 0
     1440           and lookup(  v-fileext,  "$$$"  ) = 0
     1441         then do:
     1442           assign
     1443             file-info:file-name = v-fullfilename
     1444           .
     1445         //  if lookup(entry( num-entries( v-filename, "." ), v-filename, "." ), "$$$") = 0 and
     1446              if file-info:file-type MATCHES "*W*":U
     1447             and file-info:file-type MATCHES "*R*":U
     1448             and not ( file-info:file-type MATCHES "*H*":U )
     1449           then do:
     1450             v-current-pack-num = v-current-pack-num + 1.
     1451             // переносит пакет из exch в heap и распаковывает его там, если он архив
     1452             run file-s-g ( input p0-action
     1453                           ,input p0-arch
     1454                           ,input v-filename
     1455                           ,input v-fullfilename
     1456                           ,input v-filenamenoext
     1457                           ,input v-fileext
     1458                           ,input p0-source-dir
     1459                           ,input p0-target-dir
     1460                           ,input p0-temp-dir
     1461                           ,input v-current-pack-num
     1462                           ,input false
     1463                         ) no-error.
     1464             if error-status :error then do:
     1465               return error return-value.
     1466             end.
     1467             if p-delivery-method = integer('5':U) or p-delivery-method = integer('9':U) then do:
     1468               define variable v-caller-handle as handle no-undo .
     1469               v-caller-handle = this-procedure:instantiating-procedure.
     1470               if lookup("cb_fill-filelist", v-caller-handle:internal-entries) > 0 then do:
     1471                 run cb_fill-filelist in v-caller-handle ( input v-filename, input p-delivery-method) no-error.
     1472               end.
     1473             end.
     1474           end.
     1475         end.
     1476       END.
     1477       input stream FLStream close.
     1478     end.
     1479     return .
     1480   end.
     1481   procedure file-s-g private :
     1482     define input parameter p-action     as character no-undo .
     1483     define input parameter p-arch       as logical   no-undo .
     1484     define input parameter p-file-name  as character no-undo .
     1485     define input parameter p-fullfile-name    as character no-undo .
     1486     define input parameter p-file-name-no-ext as character no-undo .
     1487     define input parameter p-file-ext   as character no-undo .
     1488     define input parameter p-source-dir as character no-undo .
     1489     define input parameter p-target-dir as character no-undo .
     1490     define input parameter p-temp-dir   as character no-undo .
     1491     define input parameter p-current-pack-num as integer no-undo .
     1492     define input parameter p-cert-enabled as logical no-undo .
     1493       define variable v-arch             as logical   no-undo .
     1494       define variable v-arh-name         as character no-undo .
     1495       define variable v-arh-type         as character no-undo .
     1496       define variable v-file-hash        as character no-undo .
     1497       define variable v-file-source-arj  as character no-undo .
     1498       define variable v-file-temp        as character no-undo .
     1499       define variable v-file-target      as character no-undo .
     1500       define variable v-file-source-all  as character no-undo .
     1501       define variable v-log-file-source      as character no-undo .
     1502       define variable v-log-file-source-arj  as character no-undo .
     1503       define variable v-log-file-temp        as character no-undo .
     1504       define variable v-log-file-target      as character no-undo .
     1505       define variable v-zip-command      as character no-undo .
     1506       define variable v-unzip-command    as character no-undo .
     1507       define variable v-err-mess         as character no-undo .
     1508       define variable v-send-log         as logical   no-undo .
     1509       define buffer buf_esys-pck-rcvd for ub.esys-pck-rcvd.
     1510     do
     1511     on error undo, return error
     1512     :
     1513       assign
     1514         v-file-temp       = p-temp-dir   + chr(92) + p-file-name
     1515         v-file-target     = p-target-dir + chr(92) + p-file-name
     1516       .
     1517     case p-delivery-method:
     1518       when integer('2':U) or
     1519       when integer('1':U) then do:
     1520         v-arh-name = ''.
     1521         p-arch = no.
     1522       end.
     1523       when integer('4':U) then do:
     1524         v-arh-name = "".
     1525         v-arh-type = "".
     1526         p-arch = no.
     1527       end.
     1528       when integer('5':U) then do:
     1529         v-arh-name = ''.
     1530         p-arch = no.
     1531       end.
     1532       when integer('9':U) then do:
     1533         v-arh-name = ''.
     1534         p-arch = no.
     1535       end.
     1536       when integer('3':U) then do:
     1537         v-arh-name = search('exe/pkzipc.exe':U).
     1538         v-arh-type = "zip".
     1539         if p-action = "put" then do :
     1540               if search(p-source-dir + chr(92) + p-file-name-no-ext + ".LOG") <> ? then do:
     1541                 v-send-log = yes.
     1542                 assign
     1543                 v-log-file-source     = p-source-dir + chr(92) + p-file-name-no-ext + ".LOG"
     1544                 v-log-file-temp       = p-temp-dir   + chr(92) + p-file-name-no-ext + ".LOG"
     1545                 v-log-file-target     = p-target-dir + chr(92) + p-file-name-no-ext + ".LOG"
     1546                 .
     1547               end.
     1548         end .
     1549       end.
     1550       when integer('11':U) then do:
     1551         p-arch = yes.
     1552         v-arh-type = "zip".
     1553         if p-action = "put":U
     1554         or p-action = "fput" then do :
     1555                                  v-arh-name = search( "exe/7z.exe":U ) .
     1556           if v-arh-name = ? then v-arh-name = search( "exe/7za.exe":U ) .
     1557         end .
     1558         else do :
     1559                                  v-arh-name = search('exe/pkzipc.exe':U).
