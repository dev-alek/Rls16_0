     1825         end.
     1826         run write-to-log in p-parent-handle ( substitute( "Перенос файла из временной папки &1 в &2)", v-file-temp, v-file-target ) ).
     1827         run ren-file ( input v-file-temp
     1828                       ,input v-file-target
     1829                      ) no-error .
     1830         if error-status :error then do:
