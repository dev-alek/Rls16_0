     1715                   v-file-temp       = p-temp-dir   + chr(92) + p-file-name-no-ext + ".zip":U
     1716                   v-file-target     = p-target-dir + chr(92) + p-file-name-no-ext + ".zip":U
     1717                   v-file-source-all = p-source-dir + chr(92) + p-file-name-no-ext + ".*":U
