     1697                      , v-arh-name
     1698                      , v-file-source-arj
     1699                      , p-fullfile-name
     1700                      , p-source-dir, chr(92) , p-file-name-no-ext
     1701                    )
     1702                 else
     1703                    substitute( "&1 a -tzip -y &2 &3":U, v-arh-name, v-file-source-arj, p-fullfile-name )
     1704                 .
     1705                 os-command silent value( v-zip-command ) .
