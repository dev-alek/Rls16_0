     1809                 return error return-value .
     1810               end.
     1811               run write-to-log in p-parent-handle (  substitute( "&1. Невозможно разархивировать созданный файл &2 . Ошибка архивации", vss-workfile, v-file-temp ) ).
     1812               return .
     1813             end .
     1814             else do :
