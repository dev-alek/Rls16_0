       91   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       92   procedure esallatr-name :
       93   do
       94     on error undo, return error
       95     :
       96     define input  parameter p-code           as character no-undo .
       97     define output parameter p-type           as character no-undo .
       98     define output parameter p-format         as character no-undo .
       99     define output parameter p-label          as character no-undo .
      100     define output parameter p-user-can-edit  as logical   no-undo .
      101     define output parameter p-output-display as logical   no-undo .
      102     define output parameter p-other          as character no-undo .
      103       case p-code :
      104               when 'custom-pack-name':U then do:     assign     p-label = "Имя файла в ВС"     p-type = 'C':U      p-format = "X(255)"     p-label = "Имя файла в ВС"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      105               when 'route-custom-pack-name':U then do:     assign     p-label = "Иям файла в ВС"     p-type = 'C':U      p-format = "X(255)"     p-label = "Иям файла в ВС"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      106         otherwise do:
      107           undo, return error substitute("неизвестный атрибут ВС &1", p-code) .
      108         end.
      109       end.
      110     end.
      111   end procedure.
      112   procedure esallatr-value :
      113   do
      114     on error undo, return error
      115     :
      116     define input  parameter p-table-name as character no-undo .
      117     define input  parameter p-key1     as int64 no-undo .
      118     define input  parameter p-key2     as int64 no-undo .
      119     define input  parameter p-key3     as character no-undo .
      120     define input  parameter p-key4     as character no-undo .
      121     define input  parameter p-key5     as int64 no-undo .
      122     define input  parameter p-key6     as int64 no-undo .
      123     define input  parameter p-key7     as character no-undo .
      124     define input  parameter p-key8     as character no-undo .
      125     define input  parameter p-code     as character no-undo .
      126     define output parameter p-value    as character no-undo .
      127     define output parameter p-type     as character no-undo .
      128     define buffer buf_esys-all-attr for ub.esys-all-attr.
      129     define variable v-format         as character no-undo .
      130     define variable v-label          as character no-undo .
      131     define variable v-user-can-edit  as logical   no-undo .
      132     define variable v-output-display as logical   no-undo .
      133     define variable v-other          as character no-undo .
      134       run esallatr-name in this-procedure
      135         (input  p-code
      136         ,output p-type
      137         ,output v-format
      138         ,output v-label
      139         ,output v-user-can-edit
      140         ,output v-output-display
      141         ,output v-other
      142         ) no-error .
      143       if error-status :error then do:
      144         undo, return error return-value .
      145       end.
      146       Find first  buf_esys-all-attr no-lock where
      147                   buf_esys-all-attr.attr-code = p-code
      148              and  buf_esys-all-attr.table-name  = p-table-name
      149              and  buf_esys-all-attr.key1  = p-key1
      150              and  buf_esys-all-attr.key2  = p-key2
      151              and  buf_esys-all-attr.key3  = p-key3
      152              and  buf_esys-all-attr.key4  = p-key4
      153              and  buf_esys-all-attr.key5  = p-key5
      154              and  buf_esys-all-attr.key6  = p-key6
      155              and  buf_esys-all-attr.key7  = p-key7
      156              and  buf_esys-all-attr.key8  = p-key8  no-error .
      157      if avail buf_esys-all-attr then do:
      158       assign
      159       p-value = buf_esys-all-attr.attr-value.
      160      end.
      161      else do:
      162       assign
      163       p-value = if p-type = 'L':U then "no":U else "".
      164      end.
      165   end.
      166   end procedure.
      167   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      168   define new global shared variable g#attr-lib  as handle no-undo .
