     1907                         v-ftp-login + chr(4) +
     1908                         v-ftp-password + chr(4) +
     1909                         v-flags + chr(4) +
     1910                         (if v-ftp-path <> ''
     1911                         then (trim (trim (trim(v-ftp-path
     1912                                         , chr(92))
     1913                                     ,chr(47))
     1914                               ,chr(92)) + chr(47))
     1915                         else '') +
     1916                         v-ftp-path-out + chr(47) + p-file-name  + chr(4) +
     1917                         p-target-dir + chr(47) + p-file-name + chr(4) +
     1918                         string(no) + chr(4) +
     1919                         log-file-name
     1920           .
     1921           run gbl/ftp-put.p ( input parparentproc
     1922                             ,input this-procedure:handle
     1923                             ,input p-log-handle
     1924                             ,input v-parameter ) no-error.
     1925           if error-status:error then do:
