     1882                                                        ,input p-db-num
     1883                                                        ,input 'Path':U
     1884                                                        ,output v-ftp-path
     1885                                                        ,output v-type) no-error.
     1886           if p-delivery-method = integer('5':U) or p-delivery-method = integer('9':U) then do:
     1887             run ext-system-attr-value in this-procedure ( input p-esys-id
     1888                                                           ,input p-db-num
     1889                                                           ,input 'IN-dir':U
     1890                                                           ,output v-ftp-path-in
     1891                                                           ,output v-type) no-error.
