     1932             run cur-time in this-procedure ( output v-today, output v-time).
     1933             find first buf_esys-pck-sent exclusive-lock where
     1934                       buf_esys-pck-sent.esys-id = p-esys-id
     1935                   and buf_esys-pck-sent.db-num = p-db-num
     1936                   and buf_esys-pck-sent.esps-cr-db-num = p-cr-db-num
     1937                   and buf_esys-pck-sent.esps-pack-num = p-pck-num.
     1938             assign
     1939             buf_esys-pck-sent.esps-rcvd = yes
     1940             buf_esys-pck-sent.esps-RcvdTimeInt    = v-time
     1941             buf_esys-pck-sent.esps-RcvdTime       = string( v-time, "HH:MM:SS" )
     1942             buf_esys-pck-sent.esps-rcvddate       = v-today
     1943             .
