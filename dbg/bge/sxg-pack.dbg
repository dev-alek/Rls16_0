     1590       else do:
     1591         run write-to-log in p-parent-handle ( substitute( "Прием файла &1 (copy)", p-fullfile-name ) ) .
     1592         v-arch = false .
     1593       end.
     1594     end .
     1595       run gbl/md5.p(p-fullfile-name, output v-file-hash).
     1596       run write-to-log in p-parent-handle ( substitute("Файл: &1; Контрольная сумма: &2.", p-fullfile-name,  v-file-hash) ) .
     1597       case p-action :
     1598         when "fput" or
     1599         when "fget" then .
     1600         when "put" then do :
     1601         end .
     1602         otherwise do :
     1603         if p-delivery-method = integer('1':U)
     1604         or p-delivery-method = integer('3':U)
     1605         or p-delivery-method = integer('5':U)
     1606         or p-delivery-method = integer('9':U)
     1607         then do:
     1608           find first buf_esys-all-attr share-lock where
     1609                     buf_esys-all-attr.attr-code = 'custom-pack-name':U
     1610                 and buf_esys-all-attr.table-name = 'esys-pck-rcvd':U
     1611                 and buf_esys-all-attr.key1 = p-current-pack-num
     1612                 and buf_esys-all-attr.key2 = p-esys-id
     1613                 and buf_esys-all-attr.key5 = p-db-num
     1614                 and buf_esys-all-attr.key6 = g#db-num
     1615                 no-error .
     1616           if not available buf_esys-all-attr then do:
     1617             create buf_esys-all-attr.
     1618             assign
     1619             buf_esys-all-attr.attr-code = 'custom-pack-name':U
     1620             buf_esys-all-attr.table-name = 'esys-pck-rcvd':U
     1621             buf_esys-all-attr.key1 = p-current-pack-num
     1622             buf_esys-all-attr.key2 = p-esys-id
     1623             buf_esys-all-attr.key5 = p-db-num
     1624             buf_esys-all-attr.key6 = g#db-num
     1625             .
     1626           end.
     1627           if p-delivery-method = integer('3':U) then do:
     1628             buf_esys-all-attr.attr-value = p-file-name-no-ext + ".DAT".
     1629           end.
     1630           else do:
     1631             buf_esys-all-attr.attr-value = p-file-name.
     1632           end.
     1633         end.
     1634         end .
     1635       end case .
     1636       if p-action = "put":U
     1637       or p-action = "fput"
     1638       then do:
     1639         if p-arch = true then do:
