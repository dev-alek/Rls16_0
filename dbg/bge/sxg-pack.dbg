     1584       or lookup( p-file-ext, "zip") <> 0 then do:
     1585         run write-to-log in p-parent-handle ( substitute( "Прием файла &1 (&2)", p-fullfile-name, v-arh-name ) ) .
     1586         if v-arh-name = ? then
     1587            return error substitute( "&1. Программа архиватор не найдена!", vss-workfile ).
