        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-cre-db-num as integer   no-undo .
        4   define input parameter p-task-type  as character no-undo .
        5   define input parameter p-task-num   as integer   no-undo .
        6   define input parameter p-db-num     as integer   no-undo .
        7   define input parameter p-extsys     as char   no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision: 82f568d3f6c1, 3551, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: ARostovtsev $":U .
       10   define variable vss-date        as character no-undo init "$Date: 2023/11/27 08:31:18 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: oxmlshd.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: bge/oxmlshd.p $":U .
       13   define variable vss-description as character no-undo init "Обмен OpenXML по расписанию.".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       84   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       85   define  shared variable g#auto-pid           as integer   no-undo .
       86   define  shared variable conn-par             as character no-undo .
       87   define  shared variable g#auto-user-id       as character no-undo .
       88   define  shared variable g#auto-user-login    as character no-undo .
       89   define  shared variable g#auto-user-password as character no-undo .
       90   define  shared variable v-socket             as logical   no-undo .
       91   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       92   define  shared variable auto-window-h     as handle    no-undo .
       93   define  shared variable auto-log-msg-h    as handle    no-undo .
       94   define  shared variable hand-log-msg-h    as handle    no-undo .
       95   define  shared variable log-file-name     as character no-undo initial ? .
       96   define  shared variable add-log-file-name as character no-undo initial ? .
       97   define  shared variable writelogvalue     as character no-undo initial ? .
       98   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       99   procedure cur-time :
      100      define output parameter p-today as date      no-undo .
      101      define output parameter p-time  as integer   no-undo .
      102     do
      103     on error undo, return error
      104     :
      105       define variable v-date1 as date      no-undo .
      106       define variable v-date2 as date      no-undo .
      107       define variable v-time  as integer   no-undo .
      108       assign
      109         v-date1 = today
      110         v-time  = time
      111         v-date2 = today
      112       .
      113       if v-date1 <> v-date2
      114       then do:
      115         assign
      116           v-date1 = today
      117           v-time  = v-time
      118         .
      119       end.
      120       assign
      121         p-today = v-date1
      122         p-time  = v-time
      123       .
      124     end.
      125   end.
      126   function cur-time-date returns character
      127   :
      128     return string(today, '99/99/9999':U) .
      129   end.
      130   function cur-time-mjd returns decimal
      131   :
      132     define variable v-date as date      no-undo .
      133     define variable v-time as integer   no-undo .
      134     run cur-time in this-procedure
      135       (output v-date
      136       ,output v-time
      137       ) .
      138     return integer(v-date) - 2400002 + (v-time / 86400) .
      139   end.
      140   function cur-time-get-ending-index returns integer
      141   (input p-number as integer
      142   )
      143   :
      144     if p-number < 0
      145     or p-number = ?
      146     then do:
      147       return 1 .
      148     end.
      149     define variable v-rest as integer   no-undo .
      150     assign
      151       p-number = p-number modulo 100
      152     .
      153     if p-number < 20
      154     then do:
      155       assign
      156         v-rest = p-number
      157       .
      158     end.
      159     else do:
      160       assign
      161         v-rest = p-number modulo 10
      162       .
      163     end.
      164     case v-rest :
      165       when 1
      166       then do:
      167         return 2 .
      168       end.
      169       when 2 or
      170       when 3 or
      171       when 4
      172       then do:
      173         return 3 .
      174       end.
      175       otherwise do:
      176         return 1 .
      177       end.
      178     end case .
      179   end.
      180   procedure cur-time-mjd-to-date :
      181      define input  parameter i-mjd-diff as decimal no-undo.
      182      define output parameter o-Date     as date    no-undo.
      183      define output parameter o-Time     as integer no-undo.
      184      define variable v-day-number as integer   no-undo .
      185      if    i-mjd-diff < 0
      186         or i-mjd-diff = ?
      187      then do:
      188         return "?" .
      189      end.
      190      assign
      191         v-day-number = truncate(i-mjd-diff,0).
      192         o-Date = date(v-day-number + 2400002).
      193         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      194     .
      195   end.
      196   function cur-time-mjd-to-string returns character
      197   (input p-mjd-diff as decimal
      198   )
      199   :
      200     define variable v-day-number as integer   no-undo .
      201     define variable v-seconds    as integer   no-undo .
      202     define variable v-hour       as integer   no-undo .
      203     define variable v-min        as integer   no-undo .
      204     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      205     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      206     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      207     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      208     if p-mjd-diff < 0
      209     or p-mjd-diff = ?
      210     then do:
      211       return "?" .
      212     end.
      213     assign
      214       v-day-number = integer(truncate(p-mjd-diff,0))
      215       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      216     .
      217     if v-seconds > 86400
      218     then do:
      219       assign
      220         v-seconds = 86400 - 1
      221       .
      222     end.
      223     if v-seconds < 0
      224     then do:
      225       assign
      226         v-seconds = 0
      227       .
      228     end.
      229     assign
      230       v-hour = truncate(v-seconds / 3600, 0)
      231     .
      232     assign
      233       v-seconds = v-seconds modulo 3600
      234     .
      235     assign
      236       v-min = truncate(v-seconds / 60, 0)
      237     .
      238     assign
      239       v-seconds = v-seconds modulo 60
      240     .
      241     return
      242         (if v-day-number <> 0
      243           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      244           else ""
      245         )
      246       + (if v-day-number <> 0 or v-hour <> 0
      247           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      248           else ""
      249         )
      250       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      251           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      252           else ""
      253         )
      254       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      255       .
      256   end.
      257   function cur-time-string returns character
      258   :
      259     define variable v-date as date      no-undo .
      260     define variable v-time as integer   no-undo .
      261     run cur-time in this-procedure
      262       (output v-date
      263       ,output v-time
      264       ) .
      265     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      266   end.
      267   function cur-time-string-sec returns character
      268   :
      269     define variable v-date as date      no-undo .
      270     define variable v-time as integer   no-undo .
      271     run cur-time in this-procedure
      272       (output v-date
      273       ,output v-time
      274       ) .
      275     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      276   end.
      277   function cur-time-custom  returns character
      278   (input p-prefix as character
      279   ,input p-date-format as character
      280   ,input p-delimiter as character
      281   ,input p-time-format as character
      282   ,input p-suffix as character
      283   )
      284   :
      285     define variable v-date as date      no-undo .
      286     define variable v-time as integer   no-undo .
      287     run cur-time in this-procedure
      288       (output v-date
      289       ,output v-time
      290       ) .
      291     return
      292       p-prefix
      293       + string(v-date, p-date-format)
      294       + p-delimiter
      295       + string(v-time, p-time-format)
      296       + p-suffix
      297       .
      298   end.
      299   function cur-time-print  returns character
      300   :
      301     define variable v-date as date      no-undo .
      302     define variable v-time as integer   no-undo .
      303     run cur-time in this-procedure
      304       (output v-date
      305       ,output v-time
      306       ) .
      307     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      308   end.
      309   function cur-time-datetime returns datetime
      310   :
      311     define variable v-char as character no-undo .
      312     define variable v-datetime as datetime no-undo .
      313     v-char = cur-time-string().
      314     v-datetime = datetime(v-char).
      315     return  v-datetime.
      316   end.
      317   function cur-time-string-msec returns character
      318   :
      319     define variable v-date as datetime  no-undo .
      320     v-date = now.
      321     return string(v-date) .
      322   end.
      323   define stream LogStream .
      324   define variable mNoTime as logical no-undo.
      325   procedure write-to-log-notime :
      326     define input param i-str as character no-undo .
      327     mNoTime = yes.
      328     run write-to-log (i-str).
      329     mNoTime = no.
      330   end.
      331   procedure write-to-log :
      332     define input param p-str as character no-undo .
      333     do
      334     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      335     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      336     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      337     :
      338       define variable log-res        as logical   no-undo .
      339       define variable v-jj           as integer   no-undo .
      340       if    mNoTime
      341          or writelogvalue eq "AsyncProc"
      342       then
      343          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      344       else
      345          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      346       if auto-log-msg-h <> ? then do:
      347         log-res = auto-log-msg-h:move-to-eof( ) .
      348         log-res = auto-log-msg-h:insert-string( p-str ).
      349       end.
      350       if hand-log-msg-h <> ? then do:
      351         log-res = hand-log-msg-h:move-to-eof( ) .
      352         log-res = hand-log-msg-h:insert-string( p-str ).
      353       end.
      354       assign
      355         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      356         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      357         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      358       .
      359       if add-log-file-name <> ? then do:
      360         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      361           run gbl/fileapnd.p
      362             ( input entry(v-jj, add-log-file-name, chr(1) )
      363             ,input p-str
      364             ,input 20
      365             ) no-error .
      366           if error-status:error then do:
      367             return error return-value .
      368           end.
      369         end.
      370       end.
      371       if writelogvalue eq "AsyncProc"
      372       then do:
      373          p-str = trim(p-str, (chr(13) + chr(10)) )
      374       .
      375          Publish "WriteLogAsunc" (p-str,yes).
      376       end.
      377       else if writelogvalue <> "yes" then do:
      378         run gbl/fileapnd.p
      379           ( input log-file-name
      380           ,input p-str
      381           ,input 20
      382           ) no-error .
      383         if error-status:error then do:
      384           return error return-value .
      385         end.
      386       end.
      387     end.
      388   end procedure.
      389   procedure write-to-screen :
      390     define input param p-str as character no-undo .
      391     do
      392     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      393     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      394     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      395     :
      396       define variable log-res as logical no-undo.
      397       assign
      398         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      399       .
      400       if auto-log-msg-h <> ?
      401       then do:
      402         log-res = auto-log-msg-h:move-to-eof( ) .
      403         log-res = auto-log-msg-h:insert-string( p-str ).
      404       end.
      405       if hand-log-msg-h <> ?
      406       then do:
      407         log-res = hand-log-msg-h:move-to-eof( ) .
      408         log-res = hand-log-msg-h:insert-string( p-str ).
      409       end.
      410     end.
      411   end procedure.
      412   procedure send-msg-to-email :
      413     define input  parameter p-subject      as character no-undo .
      414     define input  parameter p-text-err     as character no-undo .
      415     define input  parameter p-attach-files as character no-undo .
      416     do
      417     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      418     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      419     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      420     :
      421       define variable v-tth             as handle    no-undo .
      422       define variable v-value-character as character no-undo .
      423       define variable v-value-date      as date      no-undo .
      424       define variable v-value-decimal   as decimal   no-undo .
      425       define variable v-value-integer   as integer   no-undo .
      426       define variable v-value-logical   as logical   no-undo .
      427       define variable v-param-type      as character no-undo .
      428       define variable v-email       as character no-undo .
      429       define variable v-tmp-str     as character no-undo .
      430       define variable v-tmp1-str    as character no-undo .
      431       define variable v-ind         as integer   no-undo .
      432       define variable v-num-entries as integer   no-undo .
      433       delete object v-tth no-error.
      434       run adm/shattri.p
      435         ( input "get":U
      436          ,input  "":U
      437          ,input  0
      438          ,input  'auto-task':U
      439          ,input  'send-msg-to-email':U
      440          ,output v-value-character
      441          ,output v-value-date
      442          ,output v-value-decimal
      443          ,output v-value-integer
      444          ,output v-value-logical
      445          ,output v-param-type
      446          ,input-output table-handle v-tth
      447         ) no-error .
      448       if not error-status :error  then do:
      449         assign
      450           v-tmp-str = v-value-character
      451         .
      452       end.
      453       delete object v-tth no-error.
      454       assign
      455         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      456         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      457         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      458         v-num-entries = num-entries( v-tmp-str, chr(44) )
      459         v-email       = "":U
      460       .
      461       do v-ind = 1 to v-num-entries
      462       :
      463         assign
      464           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      465         .
      466         if trim( v-tmp1-str ) <> "":U then do:
      467           if v-email = "":U then do:
      468             assign
      469               v-email = v-tmp1-str
      470             .
      471           end.
      472           else do:
      473             assign
      474               v-email = v-email + chr(44) + v-tmp1-str
      475             .
      476           end.
      477         end.
      478       end.
      479       if v-email <> "":U then do:
      480         run gbl/sendmail.p
      481           ( input v-email
      482           , input p-subject
      483           , input p-text-err
      484           , input p-attach-files
      485           ) no-error .
      486         if error-status :error
      487           or return-value <> "":U
      488         then do:
      489           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      490         end.
      491       end.
      492     end.
      493   end procedure.
      494   define  shared variable oxml-exch-dir as character no-undo .
      495   define  shared variable oxml-heap-dir as character no-undo .
      496   define variable err-mess as character no-undo .
      497   define temp-table t-pck-conf no-undo
      498     field esys-id         as integer
      499     field db-num          as integer
      500     field current-db-num  as integer
      501     field pack-num        as integer
      502     field rcvd-recs       as integer
      503     field total-recs      as integer
      504     field sys-key         as character
      505     field src_db-key      as character
      506     field ver-num         as character
      507     field prev-crc        as character
      508     field actual-date     as date
      509     field actual-time-int as integer
      510   .
      511   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      512   define variable v-loc-counter as integer no-undo .
      513   define variable v-counter-visible as logical no-undo .
      514   define variable v-view-log as logical no-undo .
      515   define stream auto2dia.
      516   PROCEDURE write-log-and-file :
      517   do
      518   on error undo, return error
      519   :
      520     define input parameter p-tab-position   as integer   no-undo.
      521     define input parameter p-file-name      as character no-undo .
      522     define input parameter p-log-level      as integer   no-undo .
      523     define input parameter p-log-string     AS CHARacter NO-UNDO.
      524     define variable v-jj as integer   no-undo .
      525     run write-to-screen in this-procedure( input ( fill( chr(32), p-tab-position) + p-log-string)) .
      526     if p-file-name <> '':U then do:
      527       do v-jj = 1 to num-entries(p-file-name, chr(1)):
      528         run  auto2dia-writefile in this-procedure (
      529                                         input entry(v-jj, p-file-name, chr(1))
      530                                         ,input p-log-level
      531                                         ,input (p-log-string + chr(10))
      532                                       ) no-error .
      533       end.
      534     end.
      535     if writelogvalue eq "AsyncProc"
      536     then
      537        run write-to-log in this-procedure( p-log-string) .
      538   end.
      539   END PROCEDURE.
      540   PROCEDURE get-title :
      541   do
      542   on error undo, return error
      543   :
      544   define output parameter p-title     as character    no-undo.
      545   end.
      546   END PROCEDURE.
      547   PROCEDURE set-title :
      548   do
      549   on error undo, return error
      550   :
      551   define input parameter p-title     as character    no-undo.
      552   run write-to-log in this-procedure( input ( fill( chr(32), 15) + p-title)) .
      553   end.
      554   END PROCEDURE.
      555   PROCEDURE get-counter-value :
      556   do
      557   on error undo, return error
      558   :
      559   define output parameter p-counter     as integer    no-undo.
      560       assign
      561       p-counter  = v-loc-counter
      562       .
      563   end.
      564   END PROCEDURE.
      565   PROCEDURE set-counter-value :
      566   do
      567   on error undo, return error
      568   :
      569   define input parameter p-counter     as integer    no-undo.
      570       assign
      571       v-loc-counter = p-counter
      572       .
      573   end.
      574   END PROCEDURE.
      575   PROCEDURE show-counter :
      576   do
      577   on error undo, return error
      578   :
      579       assign
      580       v-counter-visible = true
      581       .
      582       process events.
      583   end.
      584   END PROCEDURE.
      585   PROCEDURE hide-counter :
      586   do
      587   on error undo, return error
      588   :
      589       assign
      590       v-counter-visible = false
      591       .
      592       run hide-message in parparentproc .
      593       process events.
      594   end.
      595   END PROCEDURE.
      596   PROCEDURE write-counter :
      597   do
      598   on error undo, return error
      599   :
      600   define input parameter p-counter-string     as character    no-undo.
      601   if v-counter-visible then
      602   run write-message in parparentproc ( input p-counter-string) .
      603   process events.
      604   end.
      605   END PROCEDURE.
      606   PROCEDURE get-stop-state :
      607   do
      608   on error undo, return error
      609   :
      610   define output parameter p-stop-state    as logical      no-undo.
      611   end.
      612   END PROCEDURE.
      613   PROCEDURE set-view-log :
      614   do
      615   on error undo, return error
      616   :
      617   define input parameter p-view-log     as logical    no-undo.
      618       assign
      619       v-view-log = p-view-log
      620       .
      621   end.
      622   END PROCEDURE.
      623   PROCEDURE get-view-log :
      624   do
      625   on error undo, return error
      626   :
      627   define output parameter p-view-log     as logical    no-undo.
      628       assign
      629       p-view-log = v-view-log
      630       .
      631   end.
      632   END PROCEDURE.
      633   PROCEDURE write-log :
      634   do
      635   on error undo, return error
      636   :
      637   define input parameter p-tab-position   as integer      no-undo.
      638   define input parameter p-log-string     as character    no-undo.
      639   run write-to-log in this-procedure( input ( fill( chr(32), 2  * p-tab-position)  +
      640                                       (IF p-log-string = "&Line" THEN FILL("-", 80)
      641                                       ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
      642                                       ELSE p-log-string))).
      643   end.
      644   END PROCEDURE.
      645   procedure writelog :
      646   do
      647   on error undo, return error
      648   :
      649   define input parameter p-file-name AS CHAR     NO-UNDO.
      650   define input parameter p-log-level AS INTEGER  NO-UNDO.
      651   define input parameter p-log-string  AS CHAR     NO-UNDO.
      652     if p-file-name <> "" then
      653     run  auto2dia-Writefile in this-procedure (
      654                                       input p-file-name
      655                                     ,input p-log-level
      656                                     ,input p-log-string
      657                                   ) no-error .
      658      process events.
      659   end.
      660   end procedure.
      661   PROCEDURE auto2dia-writefile:
      662     define input parameter sFileName AS CHAR     NO-UNDO.
      663     define input parameter iLogLevel AS INTEGER  NO-UNDO.
      664     define input parameter sToWrite  AS CHAR     NO-UNDO.
      665     define variable v-SlashPos  as integer no-undo .
      666     define variable v-lDirName  as character no-undo .
      667     define variable v-lDirName2 as character no-undo .
      668     v-SlashPos  = maximum (  r-index(sFileName, "\"),  r-index(sFileName, "/")  ) .
      669     v-lDirName  = if v-SlashPos > 0 then substring (sFileName, 1, v-SlashPos - 1) else "".
      670     FILE-INFO:FILE-NAME = v-lDirName .
      671     v-lDirName2 = FILE-INFO:FULL-PATHNAME .
      672     if v-lDirName2 <> ? then do :
      673   OUTPUT STREAM auto2dia TO VALUE(sFileName) APPEND.
      674       PUT STREAM auto2dia UNFORMATTED chr(10).
      675       PUT STREAM auto2dia UNFORMATTED (IF (iLogLevel = 0 OR sToWrite = "&DLine"
      676                                         OR sToWrite = "&Line") THEN "" ELSE
      677                                         cur-time-string-sec() + " ").
      678       PUT STREAM auto2dia UNFORMATTED
      679               (IF sToWrite = "&Line" THEN FILL("-", 80)
      680                ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
      681                ELSE sToWrite).
      682   OUTPUT STREAM auto2dia CLOSE.
      683     end .
      684   END PROCEDURE.
      685   define variable v-err-code as integer no-undo .
      686   define variable v-message as character no-undo .
      687   define variable v-ind as int no-undo .
      688   define buffer buf_BatchProcess      for ub.BatchProcess.
      689   do
      690   on error undo, return error
      691   :
      692       assign
      693       g#esys                = true
      694       .
      695       run gbl/set-gbl.p
      696         (input  true
      697         ,input  g#auto-user-id
      698         ,input  g#auto-user-password
      699         ) no-error.
      700       if error-status :error
      701       then do:
      702           run write-to-log( vss-workfile + chr(32)
      703                           + "!!!Ошибка при инициализации переменных g#..." + chr(10)
      704                           + error-status:get-message(error-status:num-messages)
      705                           + return-value
      706                           ) .
      707           return error.
      708       end.
      709       assign
      710       g#esys                = true
      711       .
      712       run bge/oxmlinx.p (
      713             input parparentproc
      714           , input this-procedure
      715           , input this-procedure
      716           , input substitute("&1,&2,&3,&4"
      717                             , "take+analys"
      718                             , p-db-num
      719                             , p-extsys
      720                             , 0)
      721       ) no-error.
      722       if error-status :error
      723       then do:
      724           run write-to-log in this-procedure ( substitute( "&2&1Ошибка загрузки OpenXML&1&3&1&4"
      725                                           , chr(10)
      726                                           , vss-workfile
      727                                           , return-value
      728                                           , error-status :get-message( error-status :num-messages )
      729                                       )
      730                           ) .
      731       end.
      732       run write-to-log ( substitute( "Подготовка новых пакетов." ) ).
      733       run bge/cnewxpck.p (
      734                         input p-extsys
      735                       , output v-err-code
      736       ) no-error .
      737       if error-status:error
      738       then do:
      739         run write-to-log( substitute( "&1. ERROR!!! Ошибка при подготовке пакетов OpenXML &2&3&4"
      740                                       ,vss-workfile
      741                                       ,error-status:get-message(error-status:num-messages)
      742                                       ,chr(10)
      743                                       ,return-value
      744                                     )
      745                         ) .
      746       end.
      747       else do:
      748         assign
      749           v-message = return-value
      750         .
      751         if v-message <> "":U then do:
      752           run write-to-log ( substitute( "&1", v-message ) ).
      753         end.
      754         run write-to-log ( substitute( "Завершена подготовка новых пакетов." ) ).
      755       end.
      756       if p-extsys > "" then do v-ind = 1 to num-entries(p-extsys,';'):
      757         run bge/oxmloutx.p (
      758               input parparentproc
      759             , input this-procedure
      760             , input this-procedure
      761             , input substitute("one-esys,&1,&2,&3", p-db-num,entry(v-ind,p-extsys,';'),0 )
      762         ) no-error.
      763         if error-status :error
      764         then do:
      765             run write-to-log in this-procedure ( substitute( "&2&1Ошибка выгрузки OpenXML&1&3&1&4"
      766                                             , chr(10)
      767                                             , vss-workfile
      768                                             , return-value
      769                                             , error-status :get-message( error-status :num-messages )
      770                                         )
      771                             ) .
      772         end.
      773       end.
      774       else do:
      775         run bge/oxmloutx.p (
      776               input parparentproc
      777             , input this-procedure
      778             , input this-procedure
      779             , input substitute("all,&1", p-db-num )
      780         ) no-error.
      781         if error-status :error
      782         then do:
      783             run write-to-log in this-procedure ( substitute( "&2&1Ошибка выгрузки OpenXML&1&3&1&4"
      784                                             , chr(10)
      785                                             , vss-workfile
      786                                             , return-value
      787                                             , error-status :get-message( error-status :num-messages )
      788                                         )
      789                             ) .
      790         end.
      791       end.
      792     run nws/mark-clean.p no-error.
      793     if error-status:error then do:
      794       run write-to-log( substitute( "&1. ERROR!!! Ошибка при удалении марок &2&3&4&5"
      795                                     ,vss-workfile
      796                                     ,chr(10)
      797                                     ,error-status:get-message(error-status:num-messages)
      798                                     ,chr(10)
      799                                     ,return-value
      800                                   )
      801                       ) .
      802     end.
      803   end.
