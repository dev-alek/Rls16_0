      641                       end.
      642                       when chr(8)
      643                       then do:
      644                           assign
      645                               p-out-string = p-out-string + " ":U
      646                           .
      647                       end.
      648                       when chr(9)
      649                       then do:
      650                           assign
      651                               p-out-string = p-out-string + " ":U
      652                           .
      653                       end.
      654                       when chr(29)
      655                       then do:
      656                           assign
      657                               p-out-string = p-out-string + " ":U
      658                           .
      659                       end.
      660                       when chr(10)
      661                       then do:
      662                           assign
      663                               p-out-string = p-out-string + " ":U
      664                           .
      665                       end.
      666                       when chr(13)
      667                       then do:
      668                           assign
      669                               p-out-string = p-out-string + " ":U
      670                           .
      671                       end.
      672                       otherwise do:
      673                           assign
      674                               p-out-string = p-out-string + v-current-char
      675                           .
      676                       end.
      677                   end case.
      678               end.
      679           end.
      680       end case.
      681   end.
      682   end .
      683   procedure xmlchar-decode :
      684   define input parameter p-in-string      as character        no-undo.
      685   define output parameter p-out-string    as character        no-undo.
      686       define variable v-position      as integer      no-undo.
      687       define variable v-last-position as integer      no-undo.
      688       define variable v-temp-integer  as integer      no-undo.
      689       define variable v-current-char  as character    no-undo.
      690       define variable v-next-char     as character    no-undo.
      691       define variable v-success       as logical      no-undo.
      692   do
      693   on error undo, return error
      694   :
      695       assign
      696           p-out-string = "":U
      697           v-position   = 0
      698       .
      699       replace-cycle:
      700       do while yes
      701       on error undo, return error
      702       :
      703           assign
      704               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      705           .
      706           if v-last-position <= v-position
      707           then do:
      708               if v-position = 0
      709               then do:
      710                   assign
      711                       p-out-string = p-in-string
      712                   .
      713               end.
      714               else do:
      715                   assign
      716                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      717                   .
      718               end.
      719               leave replace-cycle.
      720           end.
      721           else do:
      722               assign
      723                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      724                   v-position      = v-last-position
      725                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      726               .
      727               if v-current-char = "#":U
      728               then do:
      729                   assign
      730                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      731                   .
      732                   if v-last-position > 0
      733                   then do:
      734                       run xmlchar-read-integer in this-procedure
      735                        (
      736                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      737                           , output v-temp-integer
      738                           , output v-success
      739                       ).
      740                       if v-success = yes
      741                       and v-temp-integer >= 1
      742                       and v-temp-integer <= 255
      743                       then do:
      744                           assign
      745                               p-out-string = p-out-string + chr( v-temp-integer )
      746                               v-position   = v-last-position + 1
      747                           .
      748                       end.
      749                       else do:
      750                           assign
      751                               p-out-string = p-out-string + "&":U
      752                               v-position   = v-position   + 1
      753                           .
      754                       end.
      755                   end.
      756                   else do:
      757                       assign
      758                           p-out-string = p-out-string + "&":U
      759                           v-position   = v-position   + 1
      760                       .
      761                   end.
      762               end.
      763               else do:
      764                   case substring( p-in-string, v-position + 1, 3 )
      765                   :
      766                       when "lt;":U
      767                       then do:
      768                           assign
      769                               p-out-string = p-out-string + "<":U
      770                               v-position   = v-position   + 3
      771                           .
      772                       end.
      773                       when "gt;":U
      774                       then do:
      775                           assign
      776                               p-out-string = p-out-string + ">":U
      777                               v-position   = v-position   + 3
      778                           .
      779                       end.
      780                       otherwise do:
      781                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      782                           then do:
      783                               assign
      784                                   p-out-string = p-out-string + "&":U
      785                                   v-position   = v-position   + 4
      786                               .
      787                           end.
      788                           else do:
      789                               case substring( p-in-string, v-position + 1, 5 )
      790                               :
      791                                   when "quot;":U
      792                                   then do:
      793                                       assign
      794                                           p-out-string = p-out-string + '"':U
      795                                           v-position   = v-position   + 5
      796                                       .
      797                                   end.
      798                                   when "apos;":U
      799                                   then do:
      800                                       assign
      801                                           p-out-string = p-out-string + "'":U
      802                                           v-position   = v-position   + 5
      803                                       .
      804                                   end.
      805                                   otherwise do:
      806                                       assign
      807                                           p-out-string = p-out-string + "&":U
      808                                       .
      809                                   end.
      810                               end case.
      811                           end.
      812                       end.
      813                   end case.
      814               end.
      815           end.
      816       end.
      817   end.
      818   end .
      819   procedure xmlchar-read-integer :
      820   define input parameter p-input-string      as character        no-undo.
      821   define output parameter p-output-integer   as integer          no-undo.
      822   define output parameter p-success       as logical          no-undo.
      823   do
      824   on error undo, return error
      825   :
      826       assign
      827           p-output-integer = integer( p-input-string )
      828       no-error.
      829       if error-status :error
      830       then do:
      831           assign
      832               p-success           = no
      833               p-output-integer    = 0
      834           .
      835       end.
      836       else do:
      837           assign
      838               p-success           = yes
      839           .
      840       end.
      841   end.
      842   end.
      843   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      844   procedure strtdate :
      845     define input  parameter p-str         as character no-undo .
      846     define output parameter p-value       as date      no-undo .
      847     define output parameter p-data-valid  as logical   no-undo .
      848     define output parameter p-message     as character no-undo .
      849   do
      850   on error undo, return error return-value
      851   :
      852     define variable v-value       as date      no-undo .
      853     define variable v-i           as integer   no-undo .
      854     define variable v-num         as integer   no-undo .
      855     define variable v-delim       as character no-undo .
      856     define variable v-delim-list  as character no-undo .
      857     define variable v-day         as integer   no-undo .
      858     define variable v-month       as integer   no-undo .
      859     define variable v-year        as integer   no-undo .
      860     define variable v-day-str     as character no-undo .
      861     define variable v-month-str   as character no-undo .
      862     define variable v-year-str    as character no-undo .
      863     assign
      864       p-value       = ?
      865       p-data-valid  = false
      866     .
      867     if p-str = ?
      868     then do:
      869       assign
      870         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      871       .
      872       return .
      873     end.
      874     if p-str = ""
      875     then do:
      876       assign
      877         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      878       .
      879       return .
      880     end.
      881     if length(p-str)  > 10
      882     then do:
      883       assign
      884         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      885       .
      886       return .
      887     end.
      888     assign
      889       v-delim-list = '/,-,.':U
      890     .
      891     _delim:
      892     do v-i = 1 to num-entries( v-delim-list )
      893     :
      894       assign
      895         v-delim = entry( v-i , v-delim-list )
      896         v-num   = num-entries( p-str , v-delim )
      897       .
      898       if v-num <> 3
      899       then do:
      900         assign
      901           v-delim = ''
      902         .
      903       end.
      904       else do:
      905         leave _delim.
      906       end.
      907     end.
      908     if v-delim = ''
      909     then do:
      910       assign
      911         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      912       .
      913       return .
      914     end.
      915     assign
      916       v-day-str   = entry( 1, p-str , v-delim)
      917       v-month-str = entry( 2, p-str , v-delim)
      918       v-year-str  = entry( 3, p-str , v-delim)
      919     .
      920     if  length(v-day-str) > 2   or
      921         length(v-day-str) < 1   or
      922         length(v-month-str) > 2 or
      923         length(v-month-str) < 1 or
      924         (
      925           length(v-year-str) <> 2 and
      926           length(v-year-str) <> 4
      927         )
      928     then do:
      929       assign
      930         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      931       .
      932       return .
      933     end.
      934     if length( v-year-str ) = 2
      935     then do:
      936       assign
      937         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      938       .
      939     end.
      940     assign
      941       v-day   = integer( v-day-str )
      942       v-month = integer( v-month-str)
      943       v-year  = integer( v-year-str)
      944     no-error .
      945     if error-status :error
      946     then do:
      947       assign
      948         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      949       .
      950       return .
      951     end.
      952     if v-day < 1  or
      953        v-day > 31 or
      954        v-month < 1 or
      955        v-month > 12 or
      956        v-year < 0   or
      957        v-year > 5000
      958     then do:
      959       assign
      960         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      961       .
      962       return .
      963     end.
      964     assign
      965       v-value = date( v-month, v-day, v-year )
      966     no-error .
      967     if error-status :error
      968     then do:
      969       assign
      970         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      971       .
      972       return .
      973     end.
      974     assign
      975       p-value       = v-value
      976       p-data-valid  = true
      977     .
      978   end.
      979   end procedure.
      980   define variable v-bge-xml-bgecliiv      as logical  init no  no-undo.
      981   define variable v-bge-xml-bgeclall      as logical  init no  no-undo.
