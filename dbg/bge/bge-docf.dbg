     2973                                                   , trim( file-info :full-pathname )
     2974                                                   , replace( v-xml-file-name, "/":U, "\":U ) )
     2975               .
     2976               os-command value( v-command ).
     2977           end.
     2978           run wp-XMLWriteLog in this-procedure (
     2979                 input v-log-file-name
     2980               , input 1
     2981               , input "&DLine"
     2982           ).
     2983       end.
     2984   end.
     2985   procedure export-docs-by-object :
     2986   define input parameter p-host-code  as integer      no-undo.
     2987   define input parameter p-obj-type   as character    no-undo.
     2988   define input parameter p-obj-code   as integer      no-undo.
     2989       define variable v-archive-ok        as logical      no-undo.
     2990       define variable v-comment           as character    no-undo.
     2991   do
     2992   on error undo, return error
     2993   :
     2994       run wp-XMLWriteEDT( hEDT, 1, string( p-obj-type ) + " " + string( p-obj-code ) ).
     2995       run wp-XMLWriteEDT( hEDT, 4,  "Расчет архивов").
     2996       run bge/bge-ahz.p (
     2997             input parparentproc
     2998           , input p-obj-type
     2999           , input p-obj-code
     3000           , input yes
     3001           , input yes
     3002           , input no
     3003           , input p-date-from
     3004           , input p-date-to
     3005           , output v-archive-ok
     3006           , output v-comment
     3007       ) no-error.
     3008       if error-status :error
     3009       then do:
     3010           message
     3011           vss-workfile vss-revision vss-description
     3012           skip "Ошибка проверки архивов на объекте."
     3013           skip "Тип объекта:" p-obj-type
     3014           skip "Код объекта:" p-obj-code
     3015           skip return-value
     3016           skip trim(error-status :get-message(1))
     3017               trim(error-status :get-message(2))
     3018               trim(error-status :get-message(3))
     3019           view-as alert-box error.
     3020           undo, return error .
     3021       end.
     3022       if v-archive-ok = no
     3023       then do:
     3024           run wp-XMLWriteLog in this-procedure (
     3025                 input v-log-file-name
     3026               , input 1
     3027               , input substitute( "*** Документы по объекту &1 &2 в интервале дат &3 - &4 не будут выгружены. Архивы по объекту в заданном интервале дат не целостные. &5."
     3028                                       , p-obj-type
     3029                                       , p-obj-code
     3030                                       , p-date-from
     3031                                       , p-date-to
     3032                                       , v-comment       )
     3033           ).
     3034           undo, return error .
     3035       end.
     3036       process events.
     3037       run rep/get-fo.p (
     3038             input  p-obj-type
     3039           , input  p-obj-code
     3040           , input  p-date-from
     3041           , input  p-date-to
     3042           , output v-fact-order-from
     3043           , output v-fact-order-to
     3044           , output v-docs-exists
     3045       ) no-error .
     3046       if error-status :error
     3047       then do:
     3048           message
     3049             vss-workfile vss-revision vss-description
     3050             skip "Ошибка определения границ fact-order для поиска по архивам"
     3051             skip return-value
     3052             skip trim(error-status :get-message(1))
     3053                  trim(error-status :get-message(2))
     3054                  trim(error-status :get-message(3))
     3055                  trim(error-status :get-message(4))
     3056                  trim(error-status :get-message(5))
     3057           view-as alert-box error.
     3058           undo, return error .
     3059       end.
     3060       if v-docs-exists = no
     3061       then do:
     3062           run wp-XMLWriteEDT( hEDT, 4, "В заданном диапазоне дат нет закрытых документов").
     3063       end.
     3064       else do:
     3065           run wp-XMLShowCNT(hCNT).
     3066           for each temp_ext-doc-type
     3067           :
     3068               if lookup( temp_ext-doc-type.ext-doc-type, p-doc-type-list ) <> 0
     3069               or p-doc-type-list = "":U
     3070               then do:
     3071                   run bge/doc-oper.p (
     3072                         input p-host-code
     3073                       , input p-obj-type
     3074                       , input p-obj-code
     3075                       , input temp_ext-doc-type.ext-doc-type
     3076                       , input temp_ext-doc-type.ext-doc-type-label
     3077                       , input v-fact-order-from
     3078                       , input v-fact-order-to
     3079                       , input p-date-from
     3080                       , input p-date-to
     3081                       , input p-pay-code
     3082                       , input p-cst
     3083                       , input p-parts
     3084                       , input p-chk-pay-code
     3085                       , input p-pay-desk
     3086                       , input p-pay-desk-cards
     3087                       , input p-chk
     3088                       , input p-doc-rvs
     3089                       , input v-xml-file-name
     3090                       , input v-log-file-name
     3091                       , input this-procedure
     3092                       , input hEDT
     3093                       , input hCNT
     3094                   ) no-error.
     3095                   if error-status :error
     3096                   then do:
     3097                       run wp-XMLWriteEDT( hEDT, 1, substitute( "&1. &2. &3."
     3098                                               , return-value
     3099                                               , trim(error-status :get-message(1))
     3100                                               , trim(error-status :get-message(2))
     3101                                               )  ).
     3102                   end.
     3103               end.
     3104           end.
     3105           run wp-XMLHideCNT(hCNT).
     3106       end.
     3107       if p-deleted = yes
     3108       then do:
     3109           run wp-XMLShowCNT(hCNT).
     3110           run bge/doc-deld.p (
     3111                 input p-host-code
     3112               , input p-obj-type
     3113               , input p-obj-code
     3114               , input p-date-from
     3115               , input p-date-to
     3116               , input v-xml-file-name
     3117               , input v-log-file-name
     3118               , input hEDT
     3119               , input hCNT
     3120           ) no-error.
     3121           if error-status :error
     3122           then do:
     3123               run wp-XMLWriteEDT( hEDT, 1, substitute( "&1. &2. &3."
     3124                                       , return-value
     3125                                       , trim(error-status :get-message(1))
     3126                                       , trim(error-status :get-message(2))
     3127                                       )  ).
     3128           end.
     3129           run wp-XMLHideCNT(hCNT).
     3130       end.
     3131       process events.
     3132       if p-opened-docs = yes
     3133       then do:
     3134           run wp-XMLShowCNT(hCNT).
     3135           run bge/doc-opnd.p (
     3136                 input p-host-code
     3137               , input p-obj-type
     3138               , input p-obj-code
     3139               , input p-cst
     3140               , input p-parts
     3141               , input v-xml-file-name
     3142               , input v-log-file-name
     3143               , input this-procedure
     3144               , input hEDT
     3145               , input hCNT
     3146           ) no-error.
     3147           if error-status :error
     3148           then do:
     3149               run wp-XMLWriteEDT( hEDT, 1, substitute( "&1. &2. &3."
     3150                                       , return-value
     3151                                       , trim(error-status :get-message(1))
     3152                                       , trim(error-status :get-message(2))
     3153                                       )  ).
     3154           end.
     3155           run wp-XMLHideCNT(hCNT).
     3156       end.
     3157       process events.
     3158   end.
     3159   end procedure.
     3160   procedure cb-fill_bge-xml_goods :
     3161   define input parameter p-gds-code   as integer          no-undo.
     3162   do
     3163   on error undo, return error
     3164   :
     3165       find first temp_bge-xml_goods
     3166            where temp_bge-xml_goods.gds-code = p-gds-code
     3167       no-error.
     3168       if not available temp_bge-xml_goods
     3169       then do:
     3170           create temp_bge-xml_goods.
     3171           assign
     3172               temp_bge-xml_goods.gds-code = p-gds-code
     3173           .
     3174       end.
     3175   end.
     3176   end procedure.
     3177   procedure cb-fill_bge-xml_clients :
     3178   define input parameter p-obj-type   as character        no-undo.
     3179   define input parameter p-obj-code   as integer          no-undo.
     3180       define buffer buf_temp_bge-xml_clients      for temp_bge-xml_clients.
     3181   do
     3182   for buf_temp_bge-xml_clients
     3183   on error undo, return error
     3184   :
     3185       find first buf_temp_bge-xml_clients
     3186            where buf_temp_bge-xml_clients.obj-type = p-obj-type
     3187              and buf_temp_bge-xml_clients.obj-code = p-obj-code
     3188       no-error.
     3189       if not available buf_temp_bge-xml_clients
     3190       then do:
     3191           create buf_temp_bge-xml_clients.
     3192           assign
     3193               buf_temp_bge-xml_clients.obj-type = p-obj-type
     3194               buf_temp_bge-xml_clients.obj-code = p-obj-code
     3195           .
     3196       end.
     3197   end.
     3198   end procedure.
