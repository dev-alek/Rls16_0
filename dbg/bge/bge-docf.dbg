       13   define input parameter p-pay-desk-cards as logical              no-undo.
       14   define input parameter p-deleted        as logical              no-undo.
       15   define input parameter p-chk            as logical              no-undo.
       16   define input parameter p-doc-rvs        as logical              no-undo.
       17   define input parameter p-opened-docs    as logical              no-undo.
