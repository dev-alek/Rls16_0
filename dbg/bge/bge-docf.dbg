     1080   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
     1081                                             INPUT iFlagEmpty AS INTEGER).
     1082       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
     1083       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
     1084           DO:
     1085               IF iFlagEmpty = 0                           THEN RETURN "".
     1086               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
     1087               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
     1088               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
     1089               ELSE RETURN "".
     1090           END.
     1091       ELSE DO:
     1092           run xmlchar-encode in this-procedure (
     1093                 input sToPlace
     1094               , output sToPlace
     1095           ).
     1096           ASSIGN
     1097               sToPlace = sParName + '="' + sToPlace + '"'
     1098           .
     1099           RETURN sToPlace.
     1100       END.
     1101   END FUNCTION.
     1102   function bge-xml-date returns character
     1103   ( input p-date as date )
     1104   :
     1105     define variable v-date-str as character no-undo .
     1106     run bge-xml-date-to-str in this-procedure ( input   p-date
     1107                                               , output  v-date-str
     1108                                               ) .
     1109     return v-date-str.
     1110   end function.
     1111   function bge-xml-str-date returns character
     1112   ( input p-date-str as character )
     1113   :
     1114     define variable v-date-str as character no-undo .
     1115     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1116                                                   , output  v-date-str
     1117                                                   ) .
     1118     return v-date-str.
     1119   end function.
     1120   function bge-xml-normalize-dec returns decimal
     1121   ( input p-val as decimal )
     1122   :
     1123     return (if p-val = ? then 0 else p-val) .
     1124   end function.
     1125   PROCEDURE wp-XMLTagOpen:
     1126   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1127   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1128   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1129       define variable v-out-string    as character    no-undo.
     1130   do
     1131   on error undo, return error
     1132   :
     1133       if v-bge-xml-bgefmt = "dbf":U
     1134       then do:
     1135       end.
     1136       else do:
     1137           assign
     1138               v-out-string = substitute( "&1&2<&3&4>"
     1139                                       , chr(10)
     1140                                       , fill( " ":U, 4 * iTagLevel)
     1141                                       , sTagName
     1142                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1143                               )
     1144           .
     1145           put stream stmXMLOut unformatted
     1146               v-out-string
     1147           .
     1148       end.
     1149   end.
     1150   END PROCEDURE.
     1151   PROCEDURE wp-XMLTagPut:
     1152     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1153     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1154     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1155     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1156       define variable v-out-string    as character    no-undo.
     1157   do
     1158   on error undo, return error
     1159   :
     1160       if v-bge-xml-bgefmt = "dbf":U
     1161       then do:
     1162           if v-bge-xml-dbf-file-name <> "":U
     1163           then do:
     1164               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1165               export stream stmXMLOut
     1166                   sTagName
     1167                   sParValue
     1168               .
     1169               output stream stmXMLOut close.
     1170           end.
     1171       end.
     1172       else do:
     1173           IF  iFlagEmpty = 1
     1174           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1175           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1176           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1177           THEN DO:
     1178               run xmlchar-encode in this-procedure (
     1179                   input sParValue
     1180                   , output sParValue
     1181               ).
     1182               assign
     1183                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1184                                               , chr(10)
     1185                                               , FILL(" ", 4 * iTagLevel)
     1186                                               , sTagName
     1187                                               , sParValue
     1188                               )
     1189               .
     1190               PUT STREAM stmXMLOut UNFORMATTED
     1191                   v-out-string
     1192               .
     1193           END.
     1194       end.
     1195   end.
     1196   END PROCEDURE.
     1197   PROCEDURE wp-XMLTagClose:
     1198   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1199   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1200       define variable v-out-string    as character    no-undo.
     1201   do
     1202   on error undo, return error
     1203   :
     1204       if v-bge-xml-bgefmt = "dbf":U
     1205       then do:
     1206       end.
     1207       else do:
     1208           assign
     1209               v-out-string = substitute( "&1&2</&3>"
     1210                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1211                                   , fill( " ", 4 * iTagLevel )
     1212                                   , sTagName
     1213                           )
     1214           .
     1215           PUT STREAM stmXMLOut UNFORMATTED
     1216               v-out-string
     1217           .
     1218       end.
     1219   end.
     1220   END PROCEDURE.
     1221   PROCEDURE wp-XMLWriteLog:
     1222     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1223     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1224     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1225   define variable v-str              as character no-undo .
     1226   define variable v-error-append     as logical   no-undo .
     1227   define variable v-error-append-msg as character no-undo .
     1228   assign
     1229     v-str = chr(10)
     1230             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1231             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1232     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1233     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1234     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1235   .
     1236   run bge/bge-log.p (input v-str) no-error .
     1237   if error-status:error then do:
     1238     assign
     1239       v-error-append     = yes
     1240       v-error-append-msg = return-value
     1241     .
     1242   end.
     1243   run gbl/fileapnd.p
     1244     ( input sFileName
     1245     , input v-str
     1246     , input 10
     1247     ) no-error .
     1248   if error-status:error then do:
     1249     assign
     1250       v-error-append     = yes
     1251       v-error-append-msg = substitute( "&1&2&3"
     1252                                       , v-error-append-msg
     1253                                       , chr(10)
     1254                                       , return-value
     1255                                       )
     1256     .
     1257   end.
     1258   if v-error-append
     1259   then do:
     1260     return error substitute( "&1" , v-error-append-msg ) .
     1261   end.
     1262   END PROCEDURE.
     1263   PROCEDURE wp-XMLWriteEDT:
     1264     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1265     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1266     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1267       if valid-handle ( hEDT )
     1268       then do:
     1269           hEDT :move-to-eof().
     1270           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1271                                           OR sToWrite = "&Line") THEN "" ELSE
     1272                                           cur-time-string-sec() + " ").
     1273           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1274                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1275                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1276           hEDT :insert-string(chr(10)).
     1277       end.
     1278       process events.
     1279       output to 'bgescn.txt' append.
     1280           put unformatted
     1281               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1282                                           OR sToWrite = "&Line") THEN "" ELSE
     1283                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1284               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1285                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1286                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1287           .
     1288       output close.
     1289   END PROCEDURE.
     1290   PROCEDURE wp-XMLShowCNT:
     1291     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1292       if valid-handle( hCNT )
     1293       then do:
     1294           ASSIGN hCNT :VISIBLE = TRUE.
     1295       end.
     1296   END PROCEDURE.
     1297   PROCEDURE wp-XMLHideCNT:
     1298     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1299       if valid-handle( hCNT )
     1300       then do:
     1301           ASSIGN hCNT :VISIBLE = FALSE.
     1302       end.
     1303   END PROCEDURE.
     1304   PROCEDURE wp-XMLWriteCNT:
     1305     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1306     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1307       if valid-handle( hCNT )
     1308       then do:
     1309           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1310       end.
     1311   END PROCEDURE.
     1312   procedure bge-xml-write-header:
     1313   do
     1314   on error undo, return error
     1315   :
     1316   define input parameter p-xml-file-name  as character        no-undo.
     1317   define input parameter p-doc-name       as character        no-undo.
     1318   define input parameter p-version        as character        no-undo.
     1319   define input parameter p-db-num         as integer          no-undo.
     1320   define input parameter p-date-from      as date             no-undo.
     1321   define input parameter p-shift-num-from as integer          no-undo.
     1322   define input parameter p-date-to        as date             no-undo.
     1323   define input parameter p-shift-num-to   as integer          no-undo.
     1324   define input parameter p-obj-list       as character        no-undo.
     1325   define input parameter p-doc-type-list  as character        no-undo.
     1326   define input parameter p-pay-code       as logical          no-undo.
     1327   define input parameter p-cst            as logical          no-undo.
     1328   define input parameter p-parts          as logical          no-undo.
     1329   define input parameter p-chk-pay-code   as logical          no-undo.
     1330   define input parameter p-pay-desk       as logical          no-undo.
     1331   define input parameter p-pay-desk-cards as logical          no-undo.
     1332   define input parameter p-deleted        as logical          no-undo.
     1333   define input parameter p-opened-docs    as logical          no-undo.
     1334   define variable v-out-string    as character    no-undo.
     1335   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1336   assign
     1337       v-out-string = substitute( "&1&2&3"
     1338                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1339                           , chr(10)
     1340                           , "<IBS_Trade_House>":U )
     1341   .
     1342   put stream stmXMLOut unformatted
     1343       v-out-string
     1344   .
     1345   run wp-XMLTagOpen(1, "header","").
     1346   if v-bge-xml-bgeflold = "oracle":u
     1347   then do:
     1348     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1349     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1350     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1351     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1352     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1353   end.
     1354   run wp-XMLTagOpen( 2, "manifest", "").
     1355   run wp-XMLTagOpen( 3, "document", "").
     1356   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1357   run wp-XMLTagput( 4, "description", "", 0).
     1358   run wp-XMLTagput( 4, "version", p-version, 0).
     1359   run wp-XMLTagclose( 3, "document" ).
     1360   run wp-XMLTagclose( 2, "manifest" ).
     1361   run wp-XMLTagclose( 1, "header" ).
     1362   run wp-XMLTagOpen(1, "options","").
     1363   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1364   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1365   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1366   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1367   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1368   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1369   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1370   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1371   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1372   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1373   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1374   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1375   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1376   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1377   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1378   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1379   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1380   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1381   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1382   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1383   run wp-XMLTagClose(1, "options").
     1384   run wp-XMLTagOpen( 1, "body", "" ).
     1385   output stream stmXMLOut close.
     1386   end.
     1387   end procedure.
     1388   procedure xml-bge-write-footer:
     1389   do
     1390   on error undo, return error return-value
     1391   :
     1392   define input parameter p-xml-file-name as character    no-undo.
     1393   define variable v-error-num     as integer           no-undo.
     1394   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1395   run wp-XMLTagClose( 1, "body" ).
     1396   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1397   output stream stmXMLOut close.
     1398   if v-bge-xml-bgeflold = "oracle":u
     1399   then do:
     1400     define variable v-tmp-file-name         as character no-undo .
     1401     define variable v-zip-file-name         as character no-undo .
     1402     define variable v-exch-file-name        as character no-undo .
     1403     define variable v-heap-file-name        as character no-undo .
     1404     define variable v-i                     as integer   no-undo .
     1405     define variable v-file-name             as character no-undo .
     1406     define variable v-arc                   as character no-undo .
     1407     define variable v-str                   as character no-undo .
     1408     define variable v-exch-tmp-file-name    as character no-undo .
     1409     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1410     define variable v-bge-xml-exch-dir      as character no-undo .
     1411     define variable v-bge-xml-heap-dir      as character no-undo .
     1412     define variable v-bge-xml-compress-heap as logical   no-undo .
     1413     define variable v-home-dir              as character no-undo .
     1414     define variable v-os-command            as character no-undo .
     1415     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1416     if v-home-dir = ?
     1417     then do:
     1418       undo, return error substitute( "&1&2&3"
     1419                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1420                                     , chr(10)
     1421                                     , "Обратитесь к администратору.":u
     1422                                     ).
     1423     end.
     1424     assign
     1425       v-home-dir = v-home-dir
     1426     .
     1427     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1428     if error-status :error
     1429     then do:
     1430       undo, return error substitute( "&1&2&3"
     1431                                     , "Неверно задан каталог экспорта.":u
     1432                                     , chr(10)
     1433                                     , "Обратитесь к администратору.":u
     1434                                     ).
     1435     end.
     1436     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1437     if v-bge-xml-exch-dir = ?
     1438     then do:
     1439       undo, return error substitute( "&1&2&3"
     1440                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1441                                     , chr(10)
     1442                                     , "Обратитесь к администратору.":u
     1443                                     ).
     1444     end.
     1445     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1446     if error-status :error
     1447     then do:
     1448       undo, return error substitute( "&1&2&3"
     1449                                     , "Неверно задан каталог экспорта (exch).":u
     1450                                     , chr(10)
     1451                                     , "Обратитесь к администратору.":u
     1452                                     ).
     1453     end.
     1454     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1455     if v-bge-xml-heap-dir = ?
     1456     then do:
     1457       undo, return error substitute( "&1&2&3"
     1458                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1459                                     , chr(10)
     1460                                     , "Обратитесь к администратору.":u
     1461                                     ).
     1462     end.
     1463     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1464     if error-status :error
     1465     then do:
     1466       undo, return error substitute( "&1&2&3"
     1467                                     , "Неверно задан каталог экспорта (heap).":u
     1468                                     , chr(10)
     1469                                     , "Обратитесь к администратору.":u
     1470                                     ).
     1471     end.
     1472     get-key-value section "BGE" key "heap-compress" value v-str.
     1473     assign
     1474       v-i = int(v-str)
     1475     no-error .
     1476     if v-i = ? or v-i = 0
     1477     then do:
     1478       assign
     1479         v-bge-xml-compress-heap = no
     1480       .
     1481     end.
     1482     else do:
     1483       assign
     1484         v-bge-xml-compress-heap = yes
     1485       .
     1486     end.
     1487     assign
     1488       v-arc = search( "exe/7za.exe":u )
     1489     .
     1490     if v-arc = ? or v-arc = ""
     1491     then do:
     1492       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     1493     end.
     1494     assign
     1495       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     1496       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     1497       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     1498       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     1499       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     1500       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     1501       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     1502     .
     1503     run gbl/del-file.p (input v-tmp-file-name) .
     1504     run gbl/del-file.p (input v-zip-file-name) .
     1505     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     1506     if v-error-num > 0
     1507     then do:
     1508         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     1509                                      , p-xml-file-name + "xm1":u
     1510                                      , v-tmp-file-name
     1511                                      , v-error-num
     1512                                      ).
     1513     end.
     1514     assign
     1515       v-os-command     = substitute( "&1 a -tzip &2 &3"
     1516                                    , v-arc
     1517                                    , v-zip-file-name
     1518                                    , v-tmp-file-name
     1519                                    )
     1520     .
     1521     os-command silent value ( v-os-command ) .
     1522     run gbl/del-file.p (input v-heap-file-name) .
     1523     if v-bge-xml-compress-heap = no
     1524     then do:
     1525       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     1526       if v-error-num > 0
     1527       then do:
     1528           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1529                                        , v-tmp-file-name
     1530                                        , v-heap-file-name
     1531                                        , v-error-num
     1532                                        ) .
     1533       end.
     1534     end.
     1535     else do:
     1536       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     1537       if v-error-num > 0
     1538       then do:
     1539           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1540                                        , v-zip-file-name
     1541                                        , v-heap-file-name
     1542                                        , v-error-num
     1543                                        ) .
     1544       end.
     1545     end.
     1546     run gbl/del-file.p (input v-tmp-file-name) .
     1547     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     1548     if error-status :error then do:
     1549       undo, return error substitute( "&1&2&3"
     1550                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     1551                                     , chr(10)
     1552                                     , "Обратитесь к администратору."
     1553                                     ).
     1554     end.
     1555     run gbl/del-file.p (input v-exch-file-name) .
     1556     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     1557     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     1558     if v-error-num > 0
     1559     then do:
     1560       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1561                                     , v-zip-file-name
     1562                                     , v-exch-tmp-file-name
     1563                                     , v-error-num
     1564                                     ) .
     1565     end.
     1566     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     1567     if v-error-num > 0
     1568     then do:
     1569       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1570                                     , v-exch-tmp-file-name
     1571                                     , v-exch-file-name
     1572                                     , v-error-num
     1573                                     ) .
     1574     end.
     1575     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     1576   end.
     1577   else do:
     1578     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1579     if v-error-num > 0
     1580     then do:
     1581       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1582                                     , p-xml-file-name + "xm1"
     1583                                     , p-xml-file-name + "xml"
     1584                                     , v-error-num
     1585                                     ) .
     1586     end.
     1587   end.
     1588   if opsys = "unix"
     1589   then do:
     1590       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1591   end.
     1592   end.
     1593   end procedure.
     1594   procedure xml-bge-filename0:
     1595   define input parameter p-prefix   as character no-undo .
     1596   define input parameter p-name     as character no-undo .
     1597   define input parameter p-shared-process as logical no-undo .
     1598   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     1599   define output parameter p-xml-file-name  as character no-undo .
     1600   // define output parameter p-fullfnamenoext as character no-undo .
     1601   define output parameter p-locked         as logical      no-undo.
     1602   define variable v-fullfnamenoext as character no-undo .
     1603   define variable v-fileext        as character no-undo .
     1604   define variable v-fullfname      as character no-undo .
     1605   define variable v-error-num      as integer   no-undo .
     1606   do
     1607   on error undo, return error
     1608   :
     1609     case v-bge-xml-bgeflold :
     1610       when "old" then do:
     1611         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     1612         v-fileext       = ".xml":U .
     1613         v-fullfname     = v-fullfnamenoext + v-fileext .
     1614         p-xml-file-name = v-fullfname .
     1615         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1616         if v-error-num > 0 then do:
     1617           return error.
     1618         end.
     1619       end.
     1620       when "var" then do:
     1621         case p-prefix :
     1622           when "doc" then do:
     1623             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     1624             v-fileext       = ".xml":U .
     1625             v-fullfname     = v-fullfnamenoext + v-fileext .
     1626             p-xml-file-name = v-fullfname .
     1627           end.
     1628           when "day" then do:
     1629             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     1630             v-fileext       = ".xml":U .
     1631             v-fullfname     = v-fullfnamenoext + v-fileext .
     1632             p-xml-file-name = v-fullfname .
     1633           end.
     1634           otherwise do:
     1635             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1636             v-fileext       = ".xml":U .
     1637             v-fullfname     = v-fullfnamenoext + v-fileext .
     1638             p-xml-file-name = v-fullfname .
     1639           end.
     1640         end case.
     1641         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1642         if v-error-num > 0 then do:
     1643           return error.
     1644         end.
     1645       end.
     1646       when "new" then do:
     1647                   run bge/genfname.p (
     1648                       input p-home-dir
     1649                       , input p-prefix
     1650                       , input ""
     1651                       , input "xml"
     1652                       , input ""
     1653                       , output p-xml-file-name
     1654                   ).
     1655       end.
     1656       when "no-parameter" then do:
     1657         if p-shared-process then do:
     1658                       run bge/genfname.p (
     1659                           input p-home-dir
     1660                           , input "d"
     1661                           , input ""
     1662                           , input "xml"
     1663                           , input ""
     1664                           , output p-xml-file-name
     1665                       ).
     1666         end.
     1667         else do:
     1668           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1669           v-fileext       = ".xml":U .
     1670           v-fullfname     = v-fullfnamenoext + v-fileext .
     1671           p-xml-file-name = v-fullfname .
     1672           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1673           if v-error-num > 0 then do:
     1674             return error.
     1675           end.
     1676         end.
     1677       end.
     1678     end case.
     1679     assign
     1680       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1681       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     1682     .
     1683   end .
     1684   end procedure .
     1685   procedure xml-bge-filename :
     1686   do
     1687   on error undo, return error
     1688   :
     1689   define input parameter p-prefix             as character    no-undo.
     1690   define input parameter p-name               as character    no-undo.
     1691   define input parameter p-shared-process     as logical      no-undo.
     1692   define output parameter p-xml-file-name     as character    no-undo.
     1693   define output parameter p-log-file-name     as character    no-undo.
     1694   define output parameter p-locked            as logical      no-undo.
     1695   define variable v-home-dir          as character no-undo .
     1696   define variable v-error-num         as integer   no-undo .
     1697   define variable v-bge-xml-heap-dir  as character no-undo .
     1698       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1699       if v-home-dir = ?
     1700       then do:
     1701           message
     1702             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1703             skip(1)
     1704             skip "Обратитесь к администратору."
     1705           view-as alert-box error.
     1706           undo, return error .
     1707       end.
     1708       if v-bge-xml-bgeflold <> "oracle"
     1709       then do:
     1710         assign
     1711             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     1712         .
     1713       end.
     1714       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1715       if error-status :error
     1716       then do:
     1717           message
     1718             skip "Неверно задан каталог экспорта."
     1719             skip(1)
     1720             skip "Обратитесь к администратору."
     1721           view-as alert-box error.
     1722           undo, return error .
     1723       end.
     1724       if v-bge-xml-bgefmt = "dbf":U
     1725       then do:
     1726           assign
     1727               p-xml-file-name = v-home-dir
     1728               p-locked        = no
     1729           .
     1730       end.
     1731       else do:
     1732           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     1733             output p-xml-file-name, output p-locked) .
     1734       end.
     1735       if v-bge-xml-bgeflold = "oracle"
     1736       then do:
     1737         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1738         if v-bge-xml-heap-dir = ?
     1739         then do:
     1740           undo, return error substitute( "&1&2&3"
     1741                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1742                                         , chr(10)
     1743                                         , "Обратитесь к администратору.":u
     1744                                         ).
     1745         end.
     1746         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1747         if error-status :error
     1748         then do:
     1749           undo, return error substitute( "&1&2&3"
     1750                                         , "Неверно задан каталог экспорта (heap).":u
     1751                                         , chr(10)
     1752                                         , "Обратитесь к администратору.":u
     1753                                         ).
     1754         end.
     1755         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     1756           assign
     1757             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     1758           .
     1759         end.
     1760         else do:
     1761           assign
     1762             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     1763           .
     1764         end.
     1765       end.
     1766       else do:
     1767         assign
     1768             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     1769         .
     1770       end.
     1771       assign
     1772          v-bge-xml-static-log-file-name = p-log-file-name
     1773       .
     1774   end.
     1775   end procedure.
     1776   procedure bge-xml-read-config :
     1777   do
     1778   on error undo, return error return-value
     1779   :
     1780   define input  parameter p-last-date as date      no-undo .
     1781   define input  parameter p-db-num    as integer   no-undo .
     1782       define variable v-bgeclall      as character     no-undo.
     1783       define variable v-bgedict       as character     no-undo.
     1784       define variable v-bgeshift      as character     no-undo.
     1785       define variable v-par-type      as character     no-undo.
     1786       define variable v-bgeflnm       as character     no-undo.
     1787       define variable v-bgecliiv      as character     no-undo .
     1788       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     1789       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     1790       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     1791       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     1792       define variable v-db-num-str    as character     no-undo .
     1793       define variable v-param-type      as character  no-undo .
     1794       define variable v-value-character as character  no-undo .
     1795       define variable v-value-date      as date       no-undo .
     1796       define variable v-value-decimal   as decimal    no-undo .
     1797       define variable v-value-integer   as integer    no-undo .
     1798       define variable v-value-logical   as logical    no-undo .
     1799       define variable v-tth             as handle      no-undo .
     1800       run adm/shattri.p ( input "get":U
     1801                         , input  '':u
     1802                         , input  0
     1803                         , input  'bge-export':U
     1804                         , input  'bgeclall':U
     1805                         , output v-bgecliiv
     1806                         , output v-value-date
     1807                         , output v-value-decimal
     1808                         , output v-value-integer
     1809                         , output v-value-logical
     1810                         , output v-param-type
     1811                         , input-output table-handle v-tth
     1812                         ) no-error .
     1813       if error-status :error
     1814       then do:
     1815         assign
     1816           v-bge-xml-bgecliiv = no
     1817         .
     1818       end.
     1819       else do:
     1820         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     1821       end.
     1822       delete object v-tth.
     1823       assign
     1824           v-bge-xml-bgeclall = no
     1825           v-bge-xml-bgedict  = no
     1826       .
     1827       run adm/shattri.p ( input "get":U
     1828                         , input  '':u
     1829                         , input  0
     1830                         , input  'bge-export':U
     1831                         , input  'bgeclall':U
     1832                         , output v-value-character
     1833                         , output v-value-date
     1834                         , output v-value-decimal
     1835                         , output v-value-integer
     1836                         , output v-value-logical
     1837                         , output v-param-type
     1838                         , input-output table-handle v-tth
     1839                         ) no-error .
     1840       if error-status :error
     1841       then do:
     1842         assign
     1843           v-bge-xml-bgeclall = no
     1844         .
     1845       end.
     1846       else do:
     1847         assign
     1848           v-bge-xml-bgeclall = v-value-logical
     1849         .
     1850       end.
     1851       delete object v-tth.
     1852       run adm/shattri.p ( input "get":U
     1853                         , input  '':u
     1854                         , input  0
     1855                         , input  'bge-export':U
     1856                         , input  'bgedict':U
     1857                         , output v-value-character
     1858                         , output v-value-date
     1859                         , output v-value-decimal
     1860                         , output v-value-integer
     1861                         , output v-value-logical
     1862                         , output v-param-type
     1863                         , input-output table-handle v-tth
     1864                         ) no-error .
     1865       if error-status :error
     1866       then do:
     1867         assign
     1868           v-bge-xml-bgedict = no
     1869         .
     1870       end.
     1871       else do:
     1872         assign
     1873           v-bge-xml-bgedict = v-value-logical
     1874         .
     1875       end.
     1876       delete object v-tth.
     1877       run adm/shattri.p ( input "get":U
     1878                         , input  '':u
     1879                         , input  0
     1880                         , input  'bge-export':U
     1881                         , input  'bgefmt':U
     1882                         , output v-value-character
     1883                         , output v-value-date
     1884                         , output v-value-decimal
     1885                         , output v-value-integer
     1886                         , output v-value-logical
     1887                         , output v-param-type
     1888                         , input-output table-handle v-tth
     1889                         ) no-error .
     1890       if error-status :error
     1891       then do:
     1892         assign
     1893           v-bge-xml-bgefmt  = "xml":U
     1894         .
     1895       end.
     1896       else do:
     1897         assign
     1898           v-bge-xml-bgefmt  = v-value-character
     1899         .
     1900       end.
     1901       delete object v-tth.
     1902       run adm/shattri.p ( input "get":U
     1903                         , input  '':u
     1904                         , input  0
     1905                         , input  'bge-export':U
     1906                         , input  'bgeshift':U
     1907                         , output v-value-character
     1908                         , output v-value-date
     1909                         , output v-value-decimal
     1910                         , output v-value-integer
     1911                         , output v-value-logical
     1912                         , output v-param-type
     1913                         , input-output table-handle v-tth
     1914                         ) no-error .
     1915       if error-status :error
     1916       then do:
     1917         assign
     1918             v-bge-xml-shift-mode = no
     1919         .
     1920       end.
     1921       else do:
     1922         assign
     1923             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     1924         .
     1925       end.
     1926       delete object v-tth.
     1927       run adm/shattri.p ( input "get":U
     1928                         , input  '':u
     1929                         , input  0
     1930                         , input  'bge-export':U
     1931                         , input  'bgeflold':U
     1932                         , output v-value-character
     1933                         , output v-value-date
     1934                         , output v-value-decimal
     1935                         , output v-value-integer
     1936                         , output v-value-logical
     1937                         , output v-param-type
     1938                         , input-output table-handle v-tth
     1939                         ) no-error .
     1940       if error-status :error
     1941       then do:
     1942         assign
     1943           v-bge-xml-bgeflold = "no-parameter":U
     1944         .
     1945       end.
     1946       else do:
     1947         assign
     1948           v-bge-xml-bgeflold  = v-value-character
     1949         .
     1950       end.
     1951       delete object v-tth.
     1952       assign
     1953         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     1954         v-bge-xml-db-num-str  = v-db-num-str
     1955       .
     1956       if p-last-date <> ?
     1957       then do:
     1958           run adm/shattri.p ( input "get":U
     1959                             , input  '':u
     1960                             , input  0
     1961                             , input  'bge-export':U
     1962                             , input  'bgeflnm':U
     1963                             , output v-value-character
     1964                             , output v-value-date
     1965                             , output v-value-decimal
     1966                             , output v-value-integer
     1967                             , output v-value-logical
     1968                             , output v-param-type
     1969                             , input-output table-handle v-tth
     1970                             ) no-error .
     1971           if error-status :error
     1972           then do:
     1973             assign
     1974               v-bgeflnm = '':U
     1975             .
     1976           end.
     1977           else do:
     1978             assign
     1979               v-bgeflnm = v-value-character
     1980             .
     1981           end.
     1982           delete object v-tth.
     1983           if v-bge-xml-bgeflold = "var"
     1984           then do:
     1985               if v-bgeflnm = ?
     1986               or num-entries( v-bgeflnm ) < 2
     1987               then do:
     1988                   assign
     1989                       v-bge-xml-bgeflold = "new"
     1990                   .
     1991               end.
     1992               else do:
     1993                   assign
     1994                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     1995                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     1996                   .
     1997                   assign
     1998                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     1999                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     2000                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     2001                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     2002                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     2003                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     2004                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     2005                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     2006                   .
     2007               end.
     2008           end.
     2009       end.
     2010   end.
     2011   end procedure.
     2012   procedure bge-xml-get-ref-filename :
     2013   define input parameter p-in-file-name       as character        no-undo.
     2014   define output parameter p-home-dir          as character        no-undo.
     2015   define output parameter p-out-file-name     as character        no-undo.
     2016   define output parameter p-locked            as logical          no-undo.
     2017       define variable v-counter       as integer      no-undo.
     2018       define variable v-error-level   as integer      no-undo.
     2019   do
     2020   on error undo, return error
     2021   :
     2022       run bge/bge-ini.p (
     2023             input "bge"
     2024           , output p-home-dir
     2025       ).
     2026       if return-value <> "OK"
     2027       then do:
     2028           undo, return error.
     2029       end.
     2030       assign
     2031           p-home-dir = p-home-dir + "\dict":U
     2032       .
     2033       run bge/dir_cd.p (
     2034           input p-home-dir
     2035           , input "CA"
     2036       ).
     2037       if return-value = "ERROR"
     2038       then do:
     2039           undo, return error.
     2040       end.
     2041       assign
     2042           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     2043       .
     2044       assign
     2045           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     2046       .
     2047       wait-lock:
     2048       do v-counter = 1 TO 3
     2049       :
     2050           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     2051           if p-locked = no
     2052           then do:
     2053               leave wait-lock.
     2054           end.
     2055           else do:
     2056               readkey pause 1.
     2057           end.
     2058       END.
     2059       if p-locked = yes
     2060       then do:
     2061           undo, return error.
     2062       end.
     2063       run bge/os_copy.p (
     2064             input "D":U
     2065           , input p-out-file-name + "xml":U
     2066           , input "":U
     2067           , output v-error-level
     2068       ).
     2069       if v-error-level > 0
     2070       then do:
     2071           undo, return error.
     2072       end.
     2073   end.
     2074   end procedure.
     2075   procedure bge-xml-write-ref-header :
     2076   define input parameter p-bge-name as character        no-undo.
     2077   define input parameter p-file-name as character        no-undo.
     2078       define variable v-out-string    as character    no-undo.
     2079   do
     2080   on error undo, return error
     2081   :
     2082       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     2083       put stream stmXMLOut unformatted
     2084           "<?xml version='1.0' encoding='windows-1251'?>":U
     2085       .
     2086       assign
     2087           v-out-string = substitute( "&1&2"
     2088                               , chr(10)
     2089                               , "<IBS_Trade_House>":U )
     2090       .
     2091       put stream stmXMLOut unformatted
     2092           v-out-string
     2093       .
     2094       run wp-XMLTagOpen( 1, "header", "" ).
     2095       if v-bge-xml-bgeflold = "oracle":u
     2096       then do:
     2097         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     2098         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     2099         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     2100         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     2101         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     2102       end.
     2103       else do:
     2104         run wp-XMLTagOpen( 2, "delivery", "" ).
     2105         run wp-XMLTagOpen( 3, "to", "" ).
     2106         run wp-XMLTagClose( 3, "to" ).
     2107         run wp-XMLTagOpen( 3, "from", "" ).
     2108         run wp-XMLTagClose( 3, "from" ).
     2109         run wp-XMLTagClose( 2, "delivery" ).
     2110       end.
     2111       run wp-XMLTagOpen( 2, "manifest", "" ).
     2112       run wp-XMLTagOpen( 3, "document", "" ).
     2113       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2114       run wp-XMLTagPut( 4, "description", "", 0 ).
     2115       run wp-XMLTagClose( 3, "document" ).
     2116       run wp-XMLTagClose( 2, "manifest" ).
     2117       run wp-XMLTagClose( 1, "header" ).
     2118       run wp-XMLTagOpen( 1, "body", "" ).
     2119   end.
     2120   end procedure.
     2121   procedure bge-xml-write-ref-footer :
     2122   define input parameter p-file-name as character        no-undo.
     2123       define variable v-error-level   as integer      no-undo.
     2124   do
     2125   on error undo, return error
     2126   :
     2127       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2128       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2129       output stream stmXMLOut close.
     2130       run bge/os_copy.p (
     2131             input "M":U
     2132           , input p-file-name + "xm1":U
     2133           , input p-file-name + "xml":U
     2134           , output v-error-level
     2135       ).
     2136       if v-error-level > 0
     2137       then do:
     2138           undo, return error.
     2139       end.
     2140   end.
     2141   end procedure.
     2142   procedure bge-xml-out-dir :
     2143   define output parameter p-out-dir       as character    no-undo.
     2144   define output parameter p-log-file-name as character    no-undo.
     2145   do
     2146   on error undo, return error
     2147   :
     2148       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2149       if p-out-dir = ?
     2150       then do:
     2151           message
     2152             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2153                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2154             skip(1)
     2155             skip "Обратитесь к администратору."
     2156           view-as alert-box error.
     2157           undo, return error .
     2158       end.
     2159       if v-bge-xml-bgeflold <> "oracle" then assign
     2160         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2161       .
     2162       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2163       if error-status :error  then do:
     2164           run wp-XMLWriteLog in this-procedure (
     2165                 input p-log-file-name
     2166               , input 0
     2167               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2168                                   , p-out-dir
     2169                                   , return-value
     2170                                   , trim( error-status :get-message( 1 ) )
     2171                                   )
     2172           ).
     2173           undo, return error.
     2174       end.
     2175       assign
     2176           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2177           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2178       .
     2179   end.
     2180   end procedure.
     2181   procedure bge-xml-out-dir2 :
     2182   define output parameter p-out-dir       as character    no-undo.
     2183   define output parameter p-out-dirR      as character    no-undo.
     2184   define output parameter p-log-file-name as character    no-undo.
     2185   do
     2186   on error undo, return error
     2187   :
     2188       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2189       if p-out-dir = ?
     2190       then do:
     2191           message
     2192             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2193                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2194             skip(1)
     2195             skip "Обратитесь к администратору."
     2196           view-as alert-box error.
     2197           undo, return error .
     2198       end.
     2199       if v-bge-xml-bgeflold <> "oracle" then assign
     2200             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2201             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2202         .
     2203       else p-out-dirR = p-out-dir .
     2204       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2205       if error-status :error  then do:
     2206           run wp-XMLWriteLog in this-procedure (
     2207                 input p-log-file-name
     2208               , input 0
     2209               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2210                                   , p-out-dir
     2211                                   , return-value
     2212                                   , error-status :get-message( 1 )
     2213                                   )
     2214           ).
     2215           undo, return error.
     2216       end.
     2217       if p-out-dirR <> p-out-dir then do:
     2218         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2219         if error-status :error then do:
     2220           run wp-XMLWriteLog in this-procedure (
     2221                 input p-log-file-name
     2222               , input 0
     2223               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2224                                   , p-out-dirR
     2225                                   , return-value
     2226                                   , error-status :get-message( 1 )
     2227                                   )
     2228           ).
     2229           p-out-dirR = p-out-dir .
     2230         end.
     2231       end .
     2232       assign
     2233         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2234         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2235       .
     2236   end.
     2237   end procedure.
     2238   procedure bge-xml-out-file :
     2239   do
     2240   on error undo, return error
     2241   :
     2242   define input parameter p-out-dir            as character        no-undo.
     2243   define input parameter p-prefix             as character        no-undo.
     2244   define input parameter p-sheduled           as logical          no-undo.
     2245   define output parameter p-xml-file-name     as character        no-undo.
     2246   define output parameter p-locked            as logical          no-undo.
     2247   define variable v-home-dir      as character     no-undo.
     2248   define variable v-error-num     as integer       no-undo.
     2249   define variable v-today             as date         no-undo.
     2250   define variable v-time              as integer      no-undo.
     2251       if v-bge-xml-bgefmt = "dbf":U
     2252       then do:
     2253           assign
     2254               p-xml-file-name = p-out-dir
     2255               p-locked        = no
     2256           .
     2257       end.
     2258       else do:
     2259           if v-bge-xml-bgeflold = "firm":U
     2260           then do:
     2261               run bge/genfname.p (
     2262                     input p-out-dir
     2263                   , input p-prefix
     2264                   , input "":U
     2265                   , input "arj":U
     2266                   , input "":U
     2267                   , output p-xml-file-name
     2268               ).
     2269           end.
     2270           else do:
     2271               run bge/genfname.p (
     2272                     input p-out-dir
     2273                   , input p-prefix
     2274                   , input "":U
     2275                   , input "xml":U
     2276                   , input "":U
     2277                   , output p-xml-file-name
     2278               ).
     2279           end.
     2280           assign
     2281               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2282               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2283           .
     2284       end.
     2285   end.
     2286   end procedure.
     2287   procedure bge-xml-init-ext-doc-type :
     2288       define variable v-counter    as integer      no-undo.
     2289       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2290   do
     2291   for buf_temp_ext-doc-type
     2292   on error undo, return error
     2293   :
     2294       empty temp-table buf_temp_ext-doc-type.
     2295       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2296       :
     2297           create buf_temp_ext-doc-type.
     2298           assign
     2299               buf_temp_ext-doc-type.edt-key               = v-counter
     2300               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2301               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2302           .
     2303       end.
     2304   end.
     2305   end procedure.
     2306   procedure bge-xml-get-decimal-shift-num :
     2307   define input parameter p-shift-date     as date             no-undo.
     2308   define input parameter p-shift-num      as integer          no-undo.
     2309   define output parameter p-shift-decimal as decimal          no-undo.
     2310   do
     2311   on error undo, return error
     2312   :
     2313       assign
     2314           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2315       .
     2316   end.
     2317   end procedure.
     2318   procedure bge-xml-ora-exp-filename :
     2319     define input  parameter p-table-name  as character no-undo .
     2320     define input  parameter p-doc-code    as character no-undo .
     2321     define input  parameter p-obj-code    as integer   no-undo .
     2322     define output parameter p-filename    as character no-undo .
     2323     define output parameter p-seq-num     as integer   no-undo .
     2324     define variable v-ora-exp-seq     as integer   no-undo .
     2325     define variable v-ora-exp-seq-str as character no-undo .
     2326     define variable v-home-dir        as character no-undo.
     2327   do
     2328   on error undo, return error return-value
     2329   :
     2330     if v-bge-xml-bgeflold = "oracle":u
     2331     then do:
     2332       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2333       if v-home-dir = ?
     2334       then do:
     2335         undo, return error substitute( "&1&2&3":U
     2336                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2337                                       , chr(10)
     2338                                       , "Обратитесь к администратору.":U
     2339                                       ).
     2340       end.
     2341       assign
     2342           v-home-dir = v-home-dir
     2343       .
     2344       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2345       if error-status :error
     2346       then do:
     2347         undo, return error substitute( "&1&2&3":U
     2348                                       , "Неверно задан каталог экспорта.":U
     2349                                       , chr(10)
     2350                                       , "Обратитесь к администратору.":U
     2351                                       ).
     2352       end.
     2353       assign
     2354         v-ora-exp-seq = ?
     2355       .
     2356       if  p-table-name <> ? and
     2357           p-doc-code <> ?
     2358       then do:
     2359         run bge/get-oesq.p ( input p-table-name
     2360                            , input p-doc-code
     2361                            , output v-ora-exp-seq
     2362                            ) no-error .
     2363         if error-status :error = yes
     2364         then do:
     2365           undo, return error return-value .
     2366         end.
     2367       end.
     2368       if v-ora-exp-seq = ?
     2369       then do:
     2370         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2371         if error-status :error
     2372         then do:
     2373           undo, return error return-value .
     2374         end.
     2375       end.
     2376       if p-table-name <> ? and
     2377          p-doc-code   <> ?
     2378       then do:
     2379         run bge/oesqdoc.p ( input p-table-name
     2380                           , input p-doc-code
     2381                           , input v-ora-exp-seq
     2382                           ) no-error .
     2383         if error-status :error = yes
     2384         then do:
     2385           undo, return error return-value .
     2386         end.
     2387       end.
     2388       assign
     2389         p-seq-num  = v-ora-exp-seq
     2390         p-filename = substitute("&1/&2-000_&3."
     2391                                , v-home-dir
     2392                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2393                                , string(v-ora-exp-seq , "999999999")
     2394                                )
     2395       .
     2396     end.
     2397   end.
     2398   end procedure.
     2399   procedure bge-xml-date-to-str :
     2400     define input  parameter p-date  as date      no-undo .
     2401     define output parameter p-str   as character no-undo .
     2402   do
     2403   on error undo, return error return-value
     2404   :
     2405     if p-date <> ?
     2406     then do:
     2407       assign
     2408         p-str = substitute( "&1-&2-&3"
     2409                           , string( year(p-date)  , "9999")
     2410                           , string( month(p-date) , "99"  )
     2411                           , string( day(p-date)   , "99"  )
     2412                           )
     2413       .
     2414     end.
     2415     else do:
     2416       assign
     2417         p-str = ?
     2418       .
     2419     end.
     2420   end.
     2421   end procedure.
     2422   procedure bge-xml-date-str-to-str :
     2423     define input  parameter p-date-str  as character no-undo .
     2424     define output parameter p-str       as character no-undo .
     2425     define variable v-date          as date      no-undo .
     2426     define variable v-date-valid    as logical   no-undo .
     2427     define variable v-error-message as character no-undo .
     2428   do
     2429   on error undo, return error return-value
     2430   :
     2431     assign
     2432       p-str = ?
     2433     .
     2434     if p-date-str = ? or p-date-str = ""
     2435     then do:
     2436       return .
     2437     end.
     2438     run strtdate in this-procedure ( input  p-date-str
     2439                                    , output v-date
     2440                                    , output v-date-valid
     2441                                    , output v-error-message
     2442                                    ).
     2443     if v-date-valid <> true
     2444     then do:
     2445       return .
     2446     end.
     2447     assign
     2448       p-str = substitute( "&1-&2-&3"
     2449                         , string( year(v-date)  , "9999")
     2450                         , string( month(v-date) , "99"  )
     2451                         , string( day(v-date)   , "99"  )
     2452                         )
     2453     .
     2454   end.
     2455   end procedure.
     2456   procedure bge-xml-fill-tt-bgecliiv :
     2457     define input  parameter p-str as character no-undo .
     2458     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2459     define buffer buf_clients             for ub.clients.
     2460     define variable v-i         as integer   no-undo .
     2461     define variable v-count     as integer   no-undo .
     2462     define variable v-cli-count as integer   no-undo .
     2463     define variable v-client    as character no-undo .
     2464     define variable v-obj-type  as character no-undo .
     2465     define variable v-obj-code  as integer   no-undo .
     2466   do
     2467   on error undo, return error return-value
     2468   :
     2469     empty temp-table buf_tt-bge-xml-bgecliiv.
     2470     assign
     2471       v-bge-xml-bgecliiv = no
     2472       v-cli-count        = num-entries(p-str,';')
     2473     .
     2474     if v-cli-count > 0
     2475     then do:
     2476       _cli-cycle:
     2477       do v-i = 1 to v-cli-count
     2478       :
     2479         assign
     2480           v-client = entry(v-i , p-str, ';')
     2481         .
     2482         if num-entries(v-client) <> 2
     2483         then do:
     2484           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2485         end.
     2486         assign
     2487           v-obj-type = entry(1, v-client)
     2488         .
     2489         assign
     2490           v-obj-code = integer(entry(2, v-client))
     2491         no-error .
     2492         if error-status :error
     2493         then do:
     2494           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2495         end.
     2496         find first buf_clients no-lock
     2497           where buf_clients.obj-type = v-obj-type
     2498             and buf_clients.obj-code = v-obj-code
     2499         no-error.
     2500         if not available buf_clients
     2501         then do:
     2502           next _cli-cycle.
     2503         end.
     2504         find first buf_tt-bge-xml-bgecliiv no-lock
     2505           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2506             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2507         no-error .
     2508         if available buf_tt-bge-xml-bgecliiv
     2509         then do:
     2510           next _cli-cycle.
     2511         end.
     2512         create buf_tt-bge-xml-bgecliiv.
     2513         assign
     2514           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2515           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2516         .
     2517       end.
     2518     end.
     2519     else do:
     2520       assign
     2521         v-bge-xml-bgecliiv = no
     2522       .
     2523       return .
     2524     end.
     2525     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     2526     if available buf_tt-bge-xml-bgecliiv
     2527     then do:
     2528       assign
     2529         v-bge-xml-bgecliiv = yes
     2530       .
     2531     end.
     2532   end.
     2533   end procedure.
     2534   procedure bge-xml-resolve-ext-doc-type :
     2535     define input  parameter p-ext-doc-type      as character no-undo .
     2536     define input  parameter p-obj-type          as character no-undo .
     2537     define input  parameter p-obj-code          as integer   no-undo .
     2538     define output parameter p-out-ext-doc-type  as character no-undo .
     2539     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2540   do
     2541   on error undo, return error return-value
     2542   :
     2543     assign
     2544       p-out-ext-doc-type = p-ext-doc-type
     2545     .
     2546     if p-ext-doc-type <> 'ie':U
     2547     then do:
     2548       return .
     2549     end.
     2550     if v-bge-xml-bgecliiv = yes
     2551     then do:
     2552       find first buf_tt-bge-xml-bgecliiv no-lock
     2553         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     2554           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     2555       no-error .
     2556       if available buf_tt-bge-xml-bgecliiv
     2557       then do:
     2558         assign
     2559           p-out-ext-doc-type = 'iv':U
     2560         .
     2561       end.
     2562     end.
     2563   end.
     2564   end procedure.
     2565   procedure safe-wp-xmltagput :
     2566     define input  parameter pTagLevel   as integer   no-undo .
     2567     define input  parameter pTagName    as character no-undo .
     2568     define input  parameter pParValue   as character no-undo .
     2569     define input  parameter pFlagEmpty  as integer   no-undo .
     2570   do
     2571   on error undo, return error return-value
     2572   :
     2573     if v-bge-xml-bgeflold = "oracle":u
     2574     then do:
     2575       return .
     2576     end.
     2577     run wp-xmltagput in this-procedure ( input pTagLevel
     2578                                        , input pTagName
     2579                                        , input pParValue
     2580                                        , input pFlagEmpty
     2581                                        ).
     2582   end.
     2583   end procedure.
     2584   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2585     define variable v-cntxt-db-num        as integer   no-undo .
     2586     define variable v-cntxt-userid        as character no-undo .
     2587     define variable v-cntxt-level         as character no-undo .
     2588     define variable v-cntxt-host-code-obj as integer   no-undo .
     2589     define variable v-cntxt-obj-type      as character no-undo .
     2590     define variable v-cntxt-obj-code      as integer   no-undo .
     2591     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2592     define variable v-cntxt-is-admin      as logical   no-undo .
     2593   define temp-table temp_firm no-undo
     2594       field host-code  as integer
     2595       index pi is primary unique
     2596           host-code
     2597   .
     2598       define variable v-xml-home-dir      as character    no-undo.
     2599       define variable v-xml-out-dir       as character    no-undo.
     2600       define variable v-xml-file-name     as character    no-undo.
     2601       define variable v-log-file-name     as character    no-undo.
     2602       define variable v-locked            as logical      no-undo.
     2603       define variable v-log-string        as character    no-undo.
     2604       define variable v-fact-order-from   as decimal      no-undo.
     2605       define variable v-fact-order-to     as decimal      no-undo.
     2606       define variable v-docs-exists       as logical      no-undo.
     2607       define variable v-obj-counter       as integer      no-undo.
     2608       define variable v-db-num            as integer      no-undo.
     2609       define variable v-yesno             as logical      no-undo.
     2610       define variable v-prefix            as character    no-undo.
     2611       define variable v-today             as date         no-undo.
     2612       define variable v-time              as integer      no-undo.
     2613       define variable v-command           as character    no-undo.
     2614       define variable v-bat-file-path     as character    no-undo.
     2615       define buffer buf_temp_firm     for temp_firm.
     2616   do
     2617   on error undo, return error return-value
     2618   :
     2619   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2620     run mainmenu_getcntxt in parparentproc
     2621       (output v-cntxt-db-num
     2622       ,output v-cntxt-userid
     2623       ,output v-cntxt-level
     2624       ,output v-cntxt-host-code-obj
     2625       ,output v-cntxt-obj-type
     2626       ,output v-cntxt-obj-code
     2627       ,output v-cntxt-db-num-obj
     2628       ,output v-cntxt-is-admin
     2629       ) .
     2630       run bge-xml-init-ext-doc-type in this-procedure .
     2631   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2632   do:
     2633     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2634       (input  v-cntxt-db-num
     2635       ,input  v-cntxt-userid
     2636       ,input  0
     2637       ,input  'actn_documents_export':U
     2638       ,input  'firm':U
     2639       ,input  v-cntxt-host-code-obj
     2640       ,input  '':U
     2641       ,input  0
     2642       ,input  0
     2643       ,input  0
     2644       ,input  0
     2645       ,input  true
     2646       ,output v-yesno
     2647       )  .
     2648   end.
     2649       if v-yesno = no
     2650       then do:
     2651           return error.
     2652       end.
     2653       run init-temphost.
     2654       assign
     2655           v-log-string = ", по всем фирмам"
     2656       .
     2657       case p-range:
     2658       when 1
     2659       then do:
     2660           for each temp-obj
     2661           :
     2662               find first buf_temp_firm
     2663                    where buf_temp_firm.host-code = temp-obj.host-code
     2664               no-error.
     2665               if not available buf_temp_firm
     2666               then do:
     2667   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2668   do:
     2669     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2670       (input  v-cntxt-db-num
     2671       ,input  v-cntxt-userid
     2672       ,input  0
     2673       ,input  'actn_documents_export':U
     2674       ,input  'firm':U
     2675       ,input  temp-obj.host-code
     2676       ,input  '':U
     2677       ,input  0
     2678       ,input  0
     2679       ,input  0
     2680       ,input  0
     2681       ,input  false
     2682       ,output v-yesno
     2683       )  .
     2684   end.
     2685                   if v-yesno = yes
     2686                   then do:
     2687                       create buf_temp_firm.
     2688                       assign
     2689                           buf_temp_firm.host-code = temp-obj.host-code
     2690                       .
     2691                   end.
     2692               end.
     2693           end.
     2694       end.
     2695       when 2
     2696       then do:
     2697           create buf_temp_firm.
     2698           assign
     2699               buf_temp_firm.host-code = v-cntxt-host-code-obj
     2700           .
     2701           for each temp-obj
     2702           where temp-obj.host-code <> v-cntxt-host-code-obj
     2703           :
     2704               delete temp-obj.
     2705           end.
     2706           assign
     2707               v-log-string = ", по фирме (код фирмы " + string( v-cntxt-host-code-obj ) + ")"
     2708           .
     2709       end.
     2710       when 3
     2711       then do:
     2712           for each temp-obj
     2713           :
     2714               delete temp-obj.
     2715           end.
     2716           do v-obj-counter = 1 to num-entries ( p-obj-list ) / 2
     2717           :
     2718               create temp-obj.
     2719               assign
     2720                   temp-obj.obj-type = entry( v-obj-counter * 2 - 1, p-obj-list )
     2721                   temp-obj.obj-code = integer( entry( v-obj-counter * 2, p-obj-list ) )
     2722               no-error .
     2723               if error-status :error
     2724               then do:
     2725                   message
     2726                   vss-workfile vss-revision vss-description
     2727                   skip "Ошибка чтения списка объектов"
     2728                   skip return-value
     2729                   skip trim(error-status :get-message(1))
     2730                       trim(error-status :get-message(2))
     2731                       trim(error-status :get-message(3))
     2732                       trim(error-status :get-message(4))
     2733                       trim(error-status :get-message(5))
     2734                   view-as alert-box error.
     2735                   undo, return error .
     2736               end.
     2737   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2738   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2739     (input  temp-obj.obj-type
     2740     ,input  temp-obj.obj-code
     2741     ,output temp-obj.host-code
     2742     ) no-error .
     2743               if error-status :error
     2744               then do:
     2745                   message
     2746                   vss-workfile vss-revision vss-description
     2747                   skip "Не найдена фирма для объекта" temp-obj.obj-type temp-obj.obj-code
     2748                   skip return-value
     2749                   skip trim(error-status :get-message(1))
     2750                       trim(error-status :get-message(2))
     2751                       trim(error-status :get-message(3))
     2752                       trim(error-status :get-message(4))
     2753                       trim(error-status :get-message(5))
     2754                   view-as alert-box error.
     2755                   undo, return error .
     2756               end.
     2757               find first buf_temp_firm
     2758                    where buf_temp_firm.host-code = temp-obj.host-code
     2759               no-error.
     2760               if not available buf_temp_firm
     2761               then do:
     2762                   create buf_temp_firm.
     2763                   assign
     2764                       buf_temp_firm.host-code = temp-obj.host-code
     2765                   .
     2766               end.
     2767           end.
     2768           assign
     2769               v-log-string = ", по объектам: " + p-obj-list
     2770           .
     2771       end.
     2772       end case.
     2773       run bge-xml-read-config in this-procedure ( input p-date-to
     2774                                                 , input ?
     2775                                                 ) no-error.
     2776       if error-status :error
     2777       then do:
     2778           message
     2779           vss-workfile vss-revision vss-description
     2780           skip "Ошибка чтения параметров экспорта."
     2781           skip "Для экспорта данных будут приняты параметры по умолчанию."
     2782           skip return-value
     2783           skip trim(error-status :get-message(1))
     2784               trim(error-status :get-message(2))
     2785               trim(error-status :get-message(3))
     2786           view-as alert-box error.
     2787       end.
     2788       run bge-xml-out-dir in this-procedure (
     2789             output v-xml-home-dir
     2790           , output v-log-file-name
     2791       ).
     2792       export-by-firm:
     2793       for each buf_temp_firm
     2794       on error undo, return error
     2795       :
     2796           run wp-XMLWriteEDT( hEDT, 1, substitute( "*** Экспорт по фирме: &1 ***", buf_temp_firm.host-code ) ).
     2797           process events.
     2798           run cur-time in this-procedure (
     2799                 output v-today
     2800               , output v-time
     2801           ).
     2802           assign
     2803               v-xml-out-dir   = substitute( "&1/&2" , v-xml-home-dir, trim( string( buf_temp_firm.host-code ) ) )
     2804               v-prefix        = substitute( "d&1_&2&3&4_"
     2805                                           , trim( string( buf_temp_firm.host-code ) )
     2806                                           , string( year( v-today ), "9999" )
     2807                                           , string( month( v-today ), "99"  )
     2808                                           , string( day( v-today ), "99" )
     2809                                           )
     2810           .
     2811           run gbl/dir-cre.p (
     2812               input v-xml-out-dir
     2813           ) no-error.
     2814           if error-status :error
     2815           then do:
     2816               run wp-XMLWriteLog in this-procedure (
     2817                     input v-log-file-name
     2818                   , input 1
     2819                   , input substitute( "*** Ошибка создания каталога. &1. &2. &3. &4."
     2820                                       , v-xml-out-dir
     2821                                       , return-value
     2822                                       , trim( error-status :get-message( 1 ) )
     2823                                       , trim( error-status :get-message( 2 ) )
     2824                                     )
     2825               ).
     2826               undo export-by-firm, next export-by-firm.
     2827           end.
     2828           run bge-xml-out-file in this-procedure (
     2829                 input v-xml-out-dir
     2830               , input v-prefix
     2831               , input no
     2832               , output v-xml-file-name
     2833               , output v-locked
     2834           ).
     2835           run wp-XMLWriteLog in this-procedure (
     2836                 input v-log-file-name
     2837               , input 1
     2838               , input "&DLine"
     2839           ).
     2840           run wp-XMLWriteLog in this-procedure (
     2841                 input v-log-file-name
     2842               , input 1
     2843               , input substitute( "Начало выгрузки в файл &1"
     2844                                       , replace( v-xml-file-name, "/", "\" ) + "xm1"
     2845                               )
     2846           ).
     2847           run wp-XMLWriteLog in this-procedure (
     2848                 input v-log-file-name
     2849               , input 1
     2850               , input substitute( "................с параметрами: Дата с: &1, дата по: &2"
     2851                                       , p-date-from
     2852                                       , p-date-to
     2853                               )
     2854           ).
     2855           run wp-XMLWriteLog in this-procedure (
     2856                 input v-log-file-name
     2857               , input 1
     2858               , input substitute( "................с параметрами: ... список объектов: &1", p-obj-list )
     2859           ).
     2860           run wp-XMLWriteLog in this-procedure (
     2861                 input v-log-file-name
     2862               , input 1
     2863               , input substitute( "................с параметрами: ... типы документов: &1", p-doc-type-list )
     2864           ).
     2865           run wp-XMLWriteLog in this-procedure (
     2866                 input v-log-file-name
     2867               , input 1
     2868               , input substitute( "................с параметрами: ... надо ли виды платежей: &1, ГТД: &2, партии: &3, типы кассовых платежей: &4, кассы: &5, преф.карт: &6, удал.документы: &7, незакр.документы: &8"
     2869                                                           , p-pay-code
     2870                                                           , p-cst
     2871                                                           , p-parts
     2872                                                           , p-chk-pay-code
     2873                                                           , p-pay-desk
     2874                                                           , p-pay-desk-cards
     2875                                                           , p-deleted
     2876                                                           , p-opened-docs )
     2877           ).
     2878           if v-locked = yes
     2879           then do:
     2880               run wp-XMLWriteLog in this-procedure (
     2881                     input v-log-file-name
     2882                   , input 1
     2883                   , input "*** Ошибка выгрузки: Файл выгрузки заблокирован другим процессом."
     2884               ).
     2885               undo, return error .
     2886           end.
     2887           run bge-xml-write-header in this-procedure (
     2888                 input v-xml-file-name
     2889               , input v-xml-file-name + "xml":U
     2890               , input "15.0 " + replace( vss-revision + vss-date, "$", " " )
     2891               , input 0
     2892               , input p-date-from
     2893               , input 0
     2894               , input p-date-to
     2895               , input 0
     2896               , input p-obj-list
     2897               , input p-doc-type-list
     2898               , input p-pay-code
     2899               , input p-cst
     2900               , input p-parts
     2901               , input p-chk-pay-code
     2902               , input p-pay-desk
     2903               , input p-pay-desk-cards
     2904               , input p-deleted
     2905               , input p-opened-docs
     2906           ).
     2907           object-of-list:
     2908           for each temp-obj
     2909              where temp-obj.host-code = buf_temp_firm.host-code
     2910           :
     2911               run export-docs-by-object (
     2912                     input temp-obj.host-code
     2913                   , input temp-obj.obj-type
     2914                   , input temp-obj.obj-code
     2915               ) no-error.
     2916               if error-status :error
     2917               then do:
     2918                   message
     2919                   vss-workfile vss-revision vss-description
     2920                   skip "Ошибка экспорта документов по объекту"
     2921                   skip "Тип объекта:" temp-obj.obj-type
     2922                   skip "Код объекта:" temp-obj.obj-code
     2923                   skip return-value
     2924                   skip trim(error-status :get-message(1))
     2925                       trim(error-status :get-message(2))
     2926                       trim(error-status :get-message(3))
     2927                       trim(error-status :get-message(4))
     2928                       trim(error-status :get-message(5))
     2929                   view-as alert-box error.
