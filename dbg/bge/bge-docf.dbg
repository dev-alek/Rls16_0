       26   procedure vss-get-info :
       27     define output parameter p-vss-revision    like vss-revision    no-undo .
       28     define output parameter p-vss-author      like vss-author      no-undo .
       29     define output parameter p-vss-date        like vss-date        no-undo .
       30     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       31     define output parameter p-vss-archive     like vss-archive     no-undo .
       32     define output parameter p-vss-description like vss-description no-undo .
       33     assign
       34       p-vss-revision    = vss-revision
       35       p-vss-author      = vss-author
       36       p-vss-date        = vss-date
       37       p-vss-workfile    = vss-workfile
       38       p-vss-archive     = vss-archive
       39       p-vss-description = vss-description
       40     .
       41   end procedure.
       42   procedure vss-get-parameters :
       43     define output parameter p-vss-parameters as character no-undo .
       44   end procedure.
       45   define new global shared variable g#vssrevis-logger as handle    no-undo .
       46   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       47   define variable v-vssrevis-logger                   as handle    no-undo .
       48   procedure vss-logevent :
       49     define input  parameter p-extra-paramters as character no-undo .
       50     define variable v-vssrevis-parameters as character no-undo .
       51     do
       52     on error undo, return error return-value
       53     :
       54       if  valid-handle(v-vssrevis-logger)
       55       and v-vssrevis-logger :get-signature("logevent") <> ""
       56       then do:
       57         run vss-get-parameters in this-procedure
       58           (output v-vssrevis-parameters
       59           ).
       60         run logevent in v-vssrevis-logger
       61           (input vss-workfile
       62           ,input vss-revision
       63           ,input v-vssrevis-parameters
       64           ,input p-extra-paramters
       65           ).
       66       end.
       67     end.
       68   end procedure.
       69   assign
       70     v-vssrevis-logger = g#vssrevis-logger
       71   .
       72   if  valid-handle(v-vssrevis-logger)
       73   and v-vssrevis-logger :get-signature("logevent") <> ""
       74   then do:
       75     assign
       76       v-vssrevis-logevent = true
       77     .
       78     run vss-logevent in this-procedure (input vss-description) .
       79   end.
       80   define new global shared variable g#language as character no-undo .
       81   if g#language <> '' and g#language <> 'rus':U then do:
       82     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       83   end.
       84   define new global shared variable g#library  as handle no-undo .
       85   define new global shared variable g#library2 as handle no-undo .
       86   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       87   define  temp-table temp-host no-undo
       88     field host-code like ub.store.host-code
       89     index xpk host-code
       90   .
       91   define  temp-table temp-obj no-undo
       92     field obj-type  like ub.clients.obj-type
       93     field obj-code  like ub.clients.obj-code
       94     field host-code like ub.store.host-code
       95     field db-num    like ub.clients.db-num
       96     index xpk  obj-type obj-code
       97     index xie1 host-code
       98     index xie2 db-num host-code
       99   .
      100   procedure init-temphost:
      101     define buffer buf_store   for ub.store .
      102     define buffer buf_shop    for ub.shop .
      103     define buffer buf_clients for ub.clients .
      104     define buffer buf_db for ub.db .
      105     define buffer buf_temp-host for temp-host .
      106     define buffer buf_temp-obj for temp-obj .
      107     do
      108     on error undo, return error return-value
      109     :
      110       for each buf_store
      111       on error undo, return error
      112       :
      113         find first buf_temp-host
      114           where buf_temp-host.host-code = buf_store.host-code
      115           no-error .
      116         if not available buf_temp-host
      117         then do:
      118           create buf_temp-host .
      119           assign
      120             buf_temp-host.host-code = buf_store.host-code
      121           .
      122         end.
      123         find first buf_clients no-lock
      124           where buf_clients.obj-type = 'скл':U
      125             and buf_clients.obj-code = buf_store.obj-code
      126           no-error .
      127         if not available buf_clients
      128         then do:
      129           message
      130             "Ошибка при поиске клиента" skip
      131             "Клиент" 'скл':U buf_store.obj-code skip
      132             view-as alert-box error .
      133           undo, return error .
      134         end.
      135         create buf_temp-obj .
      136         assign
      137           buf_temp-obj.obj-type  = 'скл':U
      138           buf_temp-obj.obj-code  = buf_store.obj-code
      139           buf_temp-obj.host-code = buf_store.host-code
      140           buf_temp-obj.db-num    = buf_clients.db-num
      141         .
      142       end.
      143       for each buf_shop
      144       on error undo, return error
      145       :
      146         find first buf_temp-host
      147           where buf_temp-host.host-code = buf_shop.host-code
      148           no-error .
      149         if not available buf_temp-host
      150         then do:
      151           create buf_temp-host .
      152           assign
      153             buf_temp-host.host-code = buf_shop.host-code
      154           .
      155         end.
      156         find first buf_clients no-lock
      157           where buf_clients.obj-type = 'маг':U
      158             and buf_clients.obj-code = buf_shop.obj-code
      159           no-error .
      160         if not available buf_clients then do:
      161           message
      162             "Ошибка при поиске клиента" skip
      163             "Клиент" 'маг':U buf_shop.obj-code skip
      164             view-as alert-box error .
      165           undo, return error .
      166         end.
      167         create buf_temp-obj .
      168         assign
      169           buf_temp-obj.obj-type  = 'маг':U
      170           buf_temp-obj.obj-code  = buf_shop.obj-code
      171           buf_temp-obj.host-code = buf_shop.host-code
      172           buf_temp-obj.db-num    = buf_clients.db-num
      173         .
      174       end.
      175     end.
      176   end.
      177   define variable vss-include-info1 as character format "X(65)" no-undo
      178   initial "@(#)$Workfile$ $Revision$".
      179   DEF STREAM stmXMLOut.
      180   DEF STREAM stmXMLLog.
      181   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      182   procedure cur-time :
      183      define output parameter p-today as date      no-undo .
      184      define output parameter p-time  as integer   no-undo .
      185     do
      186     on error undo, return error
      187     :
      188       define variable v-date1 as date      no-undo .
      189       define variable v-date2 as date      no-undo .
      190       define variable v-time  as integer   no-undo .
      191       assign
      192         v-date1 = today
      193         v-time  = time
      194         v-date2 = today
      195       .
      196       if v-date1 <> v-date2
      197       then do:
      198         assign
      199           v-date1 = today
      200           v-time  = v-time
      201         .
      202       end.
      203       assign
      204         p-today = v-date1
      205         p-time  = v-time
      206       .
      207     end.
      208   end.
      209   function cur-time-date returns character
      210   :
      211     return string(today, '99/99/9999':U) .
      212   end.
      213   function cur-time-mjd returns decimal
      214   :
      215     define variable v-date as date      no-undo .
      216     define variable v-time as integer   no-undo .
      217     run cur-time in this-procedure
      218       (output v-date
      219       ,output v-time
      220       ) .
      221     return integer(v-date) - 2400002 + (v-time / 86400) .
      222   end.
      223   function cur-time-get-ending-index returns integer
      224   (input p-number as integer
      225   )
      226   :
      227     if p-number < 0
      228     or p-number = ?
      229     then do:
      230       return 1 .
      231     end.
      232     define variable v-rest as integer   no-undo .
      233     assign
      234       p-number = p-number modulo 100
      235     .
      236     if p-number < 20
      237     then do:
      238       assign
      239         v-rest = p-number
      240       .
      241     end.
      242     else do:
      243       assign
      244         v-rest = p-number modulo 10
      245       .
      246     end.
      247     case v-rest :
      248       when 1
      249       then do:
      250         return 2 .
      251       end.
      252       when 2 or
      253       when 3 or
      254       when 4
      255       then do:
      256         return 3 .
      257       end.
      258       otherwise do:
      259         return 1 .
      260       end.
      261     end case .
      262   end.
      263   procedure cur-time-mjd-to-date :
      264      define input  parameter i-mjd-diff as decimal no-undo.
      265      define output parameter o-Date     as date    no-undo.
      266      define output parameter o-Time     as integer no-undo.
      267      define variable v-day-number as integer   no-undo .
      268      if    i-mjd-diff < 0
      269         or i-mjd-diff = ?
      270      then do:
      271         return "?" .
      272      end.
      273      assign
      274         v-day-number = truncate(i-mjd-diff,0).
      275         o-Date = date(v-day-number + 2400002).
      276         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      277     .
      278   end.
      279   function cur-time-mjd-to-string returns character
      280   (input p-mjd-diff as decimal
      281   )
      282   :
      283     define variable v-day-number as integer   no-undo .
      284     define variable v-seconds    as integer   no-undo .
      285     define variable v-hour       as integer   no-undo .
      286     define variable v-min        as integer   no-undo .
      287     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      288     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      289     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      290     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      291     if p-mjd-diff < 0
      292     or p-mjd-diff = ?
      293     then do:
      294       return "?" .
      295     end.
      296     assign
      297       v-day-number = integer(truncate(p-mjd-diff,0))
      298       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      299     .
      300     if v-seconds > 86400
      301     then do:
      302       assign
      303         v-seconds = 86400 - 1
      304       .
      305     end.
      306     if v-seconds < 0
      307     then do:
      308       assign
      309         v-seconds = 0
      310       .
      311     end.
      312     assign
      313       v-hour = truncate(v-seconds / 3600, 0)
      314     .
      315     assign
      316       v-seconds = v-seconds modulo 3600
      317     .
      318     assign
      319       v-min = truncate(v-seconds / 60, 0)
      320     .
      321     assign
      322       v-seconds = v-seconds modulo 60
      323     .
      324     return
      325         (if v-day-number <> 0
      326           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      327           else ""
      328         )
      329       + (if v-day-number <> 0 or v-hour <> 0
      330           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      331           else ""
      332         )
      333       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      334           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      335           else ""
      336         )
      337       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      338       .
      339   end.
      340   function cur-time-string returns character
      341   :
      342     define variable v-date as date      no-undo .
      343     define variable v-time as integer   no-undo .
      344     run cur-time in this-procedure
      345       (output v-date
      346       ,output v-time
      347       ) .
      348     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      349   end.
      350   function cur-time-string-sec returns character
      351   :
      352     define variable v-date as date      no-undo .
      353     define variable v-time as integer   no-undo .
      354     run cur-time in this-procedure
      355       (output v-date
      356       ,output v-time
      357       ) .
      358     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      359   end.
      360   function cur-time-custom  returns character
      361   (input p-prefix as character
      362   ,input p-date-format as character
      363   ,input p-delimiter as character
      364   ,input p-time-format as character
      365   ,input p-suffix as character
      366   )
      367   :
      368     define variable v-date as date      no-undo .
      369     define variable v-time as integer   no-undo .
      370     run cur-time in this-procedure
      371       (output v-date
      372       ,output v-time
      373       ) .
      374     return
      375       p-prefix
      376       + string(v-date, p-date-format)
      377       + p-delimiter
      378       + string(v-time, p-time-format)
      379       + p-suffix
      380       .
      381   end.
      382   function cur-time-print  returns character
      383   :
      384     define variable v-date as date      no-undo .
      385     define variable v-time as integer   no-undo .
      386     run cur-time in this-procedure
      387       (output v-date
      388       ,output v-time
      389       ) .
      390     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      391   end.
      392   function cur-time-datetime returns datetime
      393   :
      394     define variable v-char as character no-undo .
      395     define variable v-datetime as datetime no-undo .
      396     v-char = cur-time-string().
      397     v-datetime = datetime(v-char).
      398     return  v-datetime.
      399   end.
      400   function cur-time-string-msec returns character
      401   :
      402     define variable v-date as datetime  no-undo .
      403     v-date = now.
      404     return string(v-date) .
      405   end.
      406   define variable vss-include-info3 as character format "X(65)" no-undo
      407   initial "@(#)$Workfile$ $Revision$".
      408   procedure xmlchar-test :
      409   define input parameter p-in-string          as character        no-undo.
      410   define output parameter p-out-string-enc    as character        no-undo.
      411   define output parameter p-out-string-dec    as character        no-undo.
      412   do
      413   on error undo, return error
      414   :
      415          run xmlchar-encode in this-procedure
      416       (
      417             input p-in-string
      418           , output p-out-string-enc
      419       ).
      420          run xmlchar-decode in this-procedure
      421       (
      422             input p-out-string-enc
      423           , output p-out-string-dec
      424       ).
      425   end.
      426   end .
      427   procedure xmlchar-encode :
      428   define input parameter p-in-string      as character        no-undo.
      429   define output parameter p-out-string    as character        no-undo.
      430       define variable v-position      as integer      no-undo.
      431       define variable v-current-char  as character    no-undo.
      432   do
      433   on error undo, return error
      434   :
      435       assign
      436           p-out-string = "":U
      437       .
      438       case p-in-string
      439       :
      440           when ?
      441           then do:
      442               assign
      443                   p-out-string = "?":U
      444               .
      445           end.
      446           when "?":U
      447           then do:
      448               assign
      449                   p-out-string = "&#63;":U
      450               .
      451           end.
      452           otherwise do:
      453               do v-position = 1 to length( p-in-string )
      454               :
      455                   assign
      456                       v-current-char = substring( p-in-string, v-position, 1 )
      457                   .
      458                   case v-current-char
      459                   :
      460                       when "&":U
      461                       then do:
      462                           assign
      463                               p-out-string = p-out-string + "&amp;":U
      464                           .
      465                       end.
      466                       when ">":U
      467                       then do:
      468                           assign
      469                               p-out-string = p-out-string + "&gt;":U
      470                           .
      471                       end.
      472                       when "<":U
      473                       then do:
      474                           assign
      475                               p-out-string = p-out-string + "&lt;":U
      476                           .
      477                       end.
      478                       when "'":U
      479                       then do:
      480                           assign
      481                               p-out-string = p-out-string + "&apos;":U
      482                           .
      483                       end.
      484                       when '"':U
      485                       then do:
      486                           assign
      487                               p-out-string = p-out-string + "&quot;":U
      488                           .
      489                       end.
      490                       when chr(1)
      491                       then do:
      492                           assign
      493                               p-out-string = p-out-string + "":U
      494                           .
      495                       end.
      496                       when chr(2)
      497                       then do:
      498                           assign
      499                               p-out-string = p-out-string + "":U
      500                           .
      501                       end.
      502                       when chr(3)
      503                       then do:
      504                           assign
      505                               p-out-string = p-out-string + "":U
      506                           .
      507                       end.
      508                       when chr(4)
      509                       then do:
      510                           assign
      511                               p-out-string = p-out-string + "":U
      512                           .
      513                       end.
      514                       when chr(5)
      515                       then do:
      516                           assign
      517                               p-out-string = p-out-string + "":U
      518                           .
      519                       end.
      520                       when chr(6)
      521                       then do:
      522                           assign
      523                               p-out-string = p-out-string + "":U
      524                           .
      525                       end.
      526                       when chr(7)
      527                       then do:
      528                           assign
      529                               p-out-string = p-out-string + "":U
      530                           .
      531                       end.
      532                       when chr(8)
      533                       then do:
      534                           assign
      535                               p-out-string = p-out-string + "":U
      536                           .
      537                       end.
      538                       when chr(9)
      539                       then do:
      540                           assign
      541                               p-out-string = p-out-string + "":U
      542                           .
      543                       end.
      544                       when chr(29)
      545                       then do:
      546                           assign
      547                               p-out-string = p-out-string + "":U
      548                           .
      549                       end.
      550                       when chr(10)
      551                       then do:
      552                           assign
      553                               p-out-string = p-out-string + "&#10;":U
      554                           .
      555                       end.
      556                       when chr(13)
      557                       then do:
      558                           assign
      559                               p-out-string = p-out-string + "&#13;":U
      560                           .
      561                       end.
      562                       otherwise do:
      563                           assign
      564                               p-out-string = p-out-string + v-current-char
      565                           .
      566                       end.
      567                   end case.
      568               end.
      569           end.
      570       end case.
      571   end.
      572   end .
      573   procedure xmlchar-encode-1c :
      574   define input parameter p-in-string      as character        no-undo.
      575   define output parameter p-out-string    as character        no-undo.
      576       define variable v-position      as integer      no-undo.
      577       define variable v-current-char  as character    no-undo.
      578   do
      579   on error undo, return error
      580   :
      581       assign
      582           p-out-string = "":U
      583       .
      584       case p-in-string
      585       :
      586           when ?
      587           then do:
