     6503   procedure cp-attr-news :
     6504     do
     6505     on error undo, return error
     6506     :
     6507       define input  parameter p-code           as character no-undo .
     6508       define output parameter p-news           as logical   no-undo .
     6509       case p-code :
     6510               when 'paycard-export-prefix':U then do:     assign     p-news = true.   end.
     6511               when 'grp-code':U then do:     assign     p-news = true.   end.
     6512               when 'is-use':U then do:     assign     p-news = true.   end.
     6513               when 'dop-doc':U then do:     assign     p-news = true.   end.
     6514               when 'paycard-all-prefix':U then do:     assign     p-news = true.   end.
     6515               when 'paycard-edit-prefix':U then do:     assign     p-news = true.   end.
     6516               when 'form_km3':U then do:     assign     p-news = false.   end.
     6517               when 'bal_malina':U then do:     assign     p-news = false.   end.
     6518               when 'max_proc_sum':U then do:     assign     p-news = true.   end.
     6519               when 'mask_card_kup':U then do:     assign     p-news = true.   end.
     6520         otherwise do:
     6521           p-news = no.
     6522         end.
     6523       end.
     6524     end.
     6525   end procedure.
