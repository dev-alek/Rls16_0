     4515   end.
     4516   procedure clcprtsl_calc-ttable :
     4517   define input parameter paris-doc           as   logical                 no-undo.
     4518   define input parameter paris-cur           as   logical                 no-undo.
     4519   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     4520   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     4521   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     4522   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     4523   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     4524   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     4525   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     4526   define input parameter parr-b              as   character               no-undo.
     4527   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     4528   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     4529   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     4530   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     4531   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     4532   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     4533   define buffer bf_tt-allsum      for tt-allsum.
     4534   define buffer bf_tt-clcparts    for tt-clcparts.
     4535   define buffer bf_tt-allsum-line for tt-allsum-line.
     4536   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     4537   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     4538   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     4539   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     4540   define variable varexcise          like ub.price-list.excise     no-undo.
     4541   do on error undo, return error return-value :
     4542   for each bf_tt-allsum-line
     4543   on error undo, return error return-value
     4544    :
     4545     delete bf_tt-allsum-line.
     4546   end.
     4547   for each bf_tt-allsum
     4548   on error undo, return error return-value
     4549   :
     4550     delete bf_tt-allsum.
     4551   end.
     4552   for each bf_tt-clcparts
     4553   on error undo, return error return-value
     4554   :
     4555   if v-calcbypart then do:
     4556             assign
     4557             parcur-base =   bf_tt-clcparts.part-cur-base
     4558             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     4559             parcur-excise =   bf_tt-clcparts.part-cur-excise
     4560             .
     4561   end.
     4562      run clcprtsl_calc-parts in this-procedure (
     4563        input recid(bf_tt-clcparts),
     4564        input paris-doc,
     4565        input paris-cur,
     4566        input parroad-tax,
     4567        input parexcise,
     4568        input parvat-pc,
     4569        input parcons-vat-pc,
     4570        input parslt-pc,
     4571        input parbase-rate,
     4572        input parbase-scale,
     4573        input parr-b,
     4574        input parcur-base,
     4575        input parcur-road-tax,
     4576        input parcur-excise,
     4577        input parcur-vat-pc,
     4578        input parcurcons-vat-pc,
     4579        input parcurslt-pc
     4580        ) no-error.
     4581     if error-status:error then do:
     4582       message
     4583         vss-workfile vss-revision vss-description skip
     4584         vss-include-info5 skip
     4585         "Ошибка при обсчете партии" skip
     4586         "Документ партии " bf_tt-clcparts.out-code skip
     4587         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     4588         return-value skip
     4589         error-status:get-message(1) skip
     4590         error-status:get-message(2) skip
     4591         error-status:get-message(3) skip
     4592         view-as alert-box error .
     4593       undo, return error .
     4594     end.
     4595     for each bf_tt-allsum on error undo, return error return-value :
     4596       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     4597       if not available bf_tt-allsum-line then do:
     4598         create bf_tt-allsum-line.
     4599         assign
     4600           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     4601       end.
     4602       assign
     4603         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     4604         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     4605         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
