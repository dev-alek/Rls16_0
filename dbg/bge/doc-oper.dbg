     4482       run clcprtsl_calc-ttable in this-procedure
     4483         (input yes,
     4484          input yes,
     4485          input bf_doc-line.road-tax,
     4486          input bf_doc-line.excise,
     4487          input bf_doc-line.vat-pc,
     4488          input bf_doc-line.cons-vat-pc,
     4489          input bf_doc-line.slt-pc,
     4490          input bf_trn-doc.base-rate,
     4491          input bf_trn-doc.base-scale,
     4492          input varr-b,
     4493          input varcur-base,
     4494          input varcur-road-tax,
     4495          input varcur-excise,
     4496          input varcur-vat-pc,
     4497          input varcur-cons-vat-pc,
     4498          input varcur-slt-pc
     4499          ) no-error.
     4500       if error-status:error then do:
     4501         message
     4502           vss-workfile vss-revision vss-description skip
     4503           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     4504           return-value skip
     4505           trim(error-status :get-message(1))
     4506           trim(error-status :get-message(2))
     4507           trim(error-status :get-message(3))
     4508           trim(error-status :get-message(4))
     4509           trim(error-status :get-message(5)) skip
