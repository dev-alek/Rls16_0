      907   define variable v-bge-xml-shift-mode    as logical           no-undo.
      908   define variable v-bge-xml-bgeflnm-doc   as character         no-undo.
      909   define variable v-bge-xml-bgeflnm-day   as character         no-undo.
      910   define variable v-bge-xml-log-file-name as character    no-undo.
      911   define variable v-bge-xml-dbf-file-name as character    no-undo.
      912   define variable v-bge-xml-db-num-str    as character    no-undo .
      913   define variable v-bge-xml-static-log-file-name as character    no-undo.
