     4444           and bf_parts.artic     = bf_doc-line.artic
     4445           and bf_parts.prod-type = bf_doc-line.prod-type
     4446           and bf_parts.prod-code = bf_doc-line.prod-code
     4447       on error undo, return error return-value
     4448       :
