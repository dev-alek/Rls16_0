     4012       bfacc_tt-allsum.transport-base-acc  = bf_tt-allsum.transport-base-acc
     4013       bfacc_tt-allsum.transport-rubl-acc  = bf_tt-allsum.transport-rubl-acc
     4014       bfacc_tt-allsum.transport-cli-acc   = bf_tt-allsum.transport-cli-acc
     4015       bfacc_tt-allsum.other-base-acc      = bf_tt-allsum.other-base-acc
     4016       bfacc_tt-allsum.other-rubl-acc      = bf_tt-allsum.other-rubl-acc
     4017       bfacc_tt-allsum.other-cli-acc       = bf_tt-allsum.other-cli-acc
     4018       .
     4019     assign
     4020       bfsacc_tt-allsum.fact-qnty           = bfs_tt-allsum.fact-qnty
     4021       bfsacc_tt-allsum.cli-qnty            = bfs_tt-allsum.cli-qnty
     4022       bfsacc_tt-allsum.sum-dsc-base-doc    = bfs_tt-allsum.sum-dsc-base-acc
     4023       bfsacc_tt-allsum.sum-dsc-rubl-doc    = bfs_tt-allsum.sum-dsc-rubl-acc
     4024       bfsacc_tt-allsum.dsc-base-doc        = bfs_tt-allsum.dsc-base-acc
     4025       bfsacc_tt-allsum.dsc-rubl-doc        = bfs_tt-allsum.dsc-rubl-acc
     4026       bfsacc_tt-allsum.vat-base-doc        = 0
     4027       bfsacc_tt-allsum.vat-rubl-doc        = 0
     4028       bfsacc_tt-allsum.vat-base-buyer-doc  = bfs_tt-allsum.vat-base-acc
     4029       bfsacc_tt-allsum.vat-rubl-buyer-doc  = bfs_tt-allsum.vat-rubl-acc
     4030       bfsacc_tt-allsum.slt-base-doc        = bfs_tt-allsum.slt-base-acc
     4031       bfsacc_tt-allsum.slt-rubl-doc        = bfs_tt-allsum.slt-rubl-acc
     4032       bfsacc_tt-allsum.road-tax-base-doc   = bfs_tt-allsum.road-tax-base-acc
     4033       bfsacc_tt-allsum.road-tax-rubl-doc   = bfs_tt-allsum.road-tax-rubl-acc
     4034       bfsacc_tt-allsum.excise-base-doc     = bfs_tt-allsum.excise-base-acc
     4035       bfsacc_tt-allsum.excise-rubl-doc     = bfs_tt-allsum.excise-rubl-acc
     4036       bfsacc_tt-allsum.sum-dsc-base-cur    = bfs_tt-allsum.sum-dsc-base-acc
     4037       bfsacc_tt-allsum.sum-dsc-rubl-cur    = bfs_tt-allsum.sum-dsc-rubl-acc
     4038       bfsacc_tt-allsum.dsc-base-cur        = bfs_tt-allsum.dsc-base-acc
     4039       bfsacc_tt-allsum.dsc-rubl-cur        = bfs_tt-allsum.dsc-rubl-acc
     4040       bfsacc_tt-allsum.vat-base-cur        = 0
     4041       bfsacc_tt-allsum.vat-rubl-cur        = 0
     4042       bfsacc_tt-allsum.vat-base-buyer-cur  = bfs_tt-allsum.vat-base-acc
     4043       bfsacc_tt-allsum.vat-rubl-buyer-cur  = bfs_tt-allsum.vat-rubl-acc
     4044       bfsacc_tt-allsum.slt-base-cur        = bfs_tt-allsum.slt-base-acc
     4045       bfsacc_tt-allsum.slt-rubl-cur        = bfs_tt-allsum.slt-rubl-acc
     4046       bfsacc_tt-allsum.road-tax-base-cur   = bfs_tt-allsum.road-tax-base-acc
     4047       bfsacc_tt-allsum.road-tax-rubl-cur   = bfs_tt-allsum.road-tax-rubl-acc
     4048       bfsacc_tt-allsum.excise-base-cur     = bfs_tt-allsum.excise-base-acc
     4049       bfsacc_tt-allsum.excise-rubl-cur     = bfs_tt-allsum.excise-rubl-acc
     4050       bfsacc_tt-allsum.sum-dsc-base-acc    = bfs_tt-allsum.sum-dsc-base-acc
     4051       bfsacc_tt-allsum.sum-dsc-rubl-acc    = bfs_tt-allsum.sum-dsc-rubl-acc
     4052       bfsacc_tt-allsum.sum-dsc-cli-acc     = bfs_tt-allsum.sum-dsc-cli-acc
     4053       bfsacc_tt-allsum.dsc-base-acc        = bfs_tt-allsum.dsc-base-acc
     4054       bfsacc_tt-allsum.dsc-rubl-acc        = bfs_tt-allsum.dsc-rubl-acc
     4055       bfsacc_tt-allsum.dsc-cli-acc         = bfs_tt-allsum.dsc-cli-acc
     4056       bfsacc_tt-allsum.vat-base-acc        = bfs_tt-allsum.vat-base-acc
     4057       bfsacc_tt-allsum.vat-rubl-acc        = bfs_tt-allsum.vat-rubl-acc
     4058       bfsacc_tt-allsum.vat-cli-acc         = bfs_tt-allsum.vat-cli-acc
     4059       bfsacc_tt-allsum.slt-base-acc        = bfs_tt-allsum.slt-base-acc
     4060       bfsacc_tt-allsum.slt-rubl-acc        = bfs_tt-allsum.slt-rubl-acc
     4061       bfsacc_tt-allsum.slt-cli-acc         = bfs_tt-allsum.slt-cli-acc
     4062       bfsacc_tt-allsum.excise-base-acc     = bfs_tt-allsum.excise-base-acc
     4063       bfsacc_tt-allsum.excise-rubl-acc     = bfs_tt-allsum.excise-rubl-acc
     4064       bfsacc_tt-allsum.excise-cli-acc      = bfs_tt-allsum.excise-cli-acc
     4065       bfsacc_tt-allsum.road-tax-base-acc   = bfs_tt-allsum.road-tax-base-acc
     4066       bfsacc_tt-allsum.road-tax-rubl-acc   = bfs_tt-allsum.road-tax-rubl-acc
     4067       bfsacc_tt-allsum.road-tax-cli-acc    = bfs_tt-allsum.road-tax-cli-acc
     4068       bfsacc_tt-allsum.transport-base-acc  = bfs_tt-allsum.transport-base-acc
     4069       bfsacc_tt-allsum.transport-rubl-acc  = bfs_tt-allsum.transport-rubl-acc
     4070       bfsacc_tt-allsum.transport-cli-acc   = bfs_tt-allsum.transport-cli-acc
     4071       bfsacc_tt-allsum.other-base-acc      = bfs_tt-allsum.other-base-acc
     4072       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     4073       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     4074       .
     4075   end.
     4076   otherwise do:
     4077     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     4078                              cl_tt-clcparts.purch-code,
     4079                              cl_tt-clcparts.part-code,
     4080                              cl_tt-clcparts.out-code,
     4081                              cl_tt-clcparts.in-code,
     4082                              cl_tt-clcparts.artic,
     4083                              cl_tt-clcparts.prod-type,
     4084                              cl_tt-clcparts.prod-code).
     4085   end.
     4086   end case.
     4087   end.
     4088   end procedure.
     4089   procedure clcprtsl_calc-line :
     4090   define input  parameter parrec-line as recid no-undo.
     4091   define variable v-tax-date         as   date                     no-undo.
     4092   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     4093   define variable varr-b             as   character                no-undo.
     4094   define variable varr-btype         as   character                no-undo.
     4095   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     4096   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     4097   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     4098   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     4099   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     4100   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     4101   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     4102   define variable varb-code          like ub.bar-code.b-code       no-undo.
     4103   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     4104   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     4105   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     4106   define variable varexcise          like ub.price-list.excise     no-undo.
     4107   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     4108   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     4109   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     4110   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     4111   define variable v-varsum           as decimal                  no-undo.
     4112   define variable varprice-salef as decimal   no-undo .
     4113   define buffer bf_trn-doc             for ub.trn-doc.
     4114   define buffer bf_doc-line            for ub.doc-line.
     4115   define buffer bf_gds-dtl             for ub.gds-dtl.
     4116   define buffer bf_goods               for ub.goods.
     4117   define buffer bf_parts               for ub.parts.
     4118   define buffer bf_sysconf             for ub.sysconf.
     4119   define buffer bf_tt-allsum-line      for tt-allsum-line.
     4120   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     4121   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     4122   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     4123   define buffer buf_parts        for ub.parts.
     4124   v-calcbypart = no.
     4125   do on error undo, return error return-value :
     4126   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4127   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4128     (output varr-b
     4129     )  .
     4130     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     4131     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     4132     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     4133                               bf_goods.prod-type = bf_doc-line.prod-type and
     4134                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     4135     if bf_trn-doc.fact-date <> ?        then do:
     4136       assign v-tax-date = bf_trn-doc.fact-date.
     4137     end.
     4138     else do:
     4139       assign v-tax-date = ?.
     4140     end.
     4141   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4142   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     4143     (input  bf_goods.gds-code
     4144     ,input  '1':U
     4145     ,input  v-tax-date
     4146     ,input  bf_trn-doc.host-code
     4147     ,input  bf_trn-doc.obj-type
     4148     ,input  bf_trn-doc.obj-code
     4149     ,output v-vat-pc
     4150     ) no-error .
     4151     if error-status :error
     4152     or v-vat-pc = ? then do:
     4153        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     4154     end.
     4155     if bf_goods.gds-type = 'у':U or
     4156        bf_trn-doc.status_ = 'запрос':U then do:
     4157       for each bf_tt-allsum-line
     4158       on error undo, return error return-value
     4159        :
     4160         delete bf_tt-allsum-line.
     4161       end.
     4162       create bf_tt-allsum-line.
     4163       assign
     4164        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     4165       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     4166                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     4167                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     4168                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     4169         assign
     4170           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     4171           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     4172           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     4173           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     4174           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     4175           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     4176           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     4177           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     4178           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     4179           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     4180           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     4181           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     4182           bf_tt-allsum-line.vat-cli-acc          =  ?
     4183           .
     4184       end.
     4185       assign
     4186         bf_tt-allsum-line.cli-qnty             =  ?
     4187         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     4188         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     4189         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     4190         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     4191         bf_tt-allsum-line.road-tax-base-doc    =  0
     4192         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     4193         bf_tt-allsum-line.excise-base-doc      =  0
     4194         bf_tt-allsum-line.excise-rubl-doc      =  0
     4195         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     4196         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     4197         bf_tt-allsum-line.dsc-base-cur         =  0
     4198         bf_tt-allsum-line.dsc-rubl-cur         =  0
     4199         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     4200         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     4201         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     4202         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     4203         bf_tt-allsum-line.road-tax-base-cur    =  0
     4204         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     4205         bf_tt-allsum-line.excise-base-cur      =  0
     4206         bf_tt-allsum-line.excise-rubl-cur      =  0
     4207         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     4208         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     4209         bf_tt-allsum-line.dsc-base-acc         =  0
     4210         bf_tt-allsum-line.dsc-rubl-acc         =  0
     4211         bf_tt-allsum-line.dsc-cli-acc          =  0
     4212         bf_tt-allsum-line.slt-base-acc         =  0
     4213         bf_tt-allsum-line.slt-rubl-acc         =  0
     4214         bf_tt-allsum-line.slt-cli-acc          =  0
     4215         bf_tt-allsum-line.road-tax-base-acc    =  0
     4216         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     4217         bf_tt-allsum-line.road-tax-cli-acc     =  0
     4218         bf_tt-allsum-line.excise-base-acc      =  0
     4219         bf_tt-allsum-line.excise-rubl-acc      =  0
     4220         bf_tt-allsum-line.excise-cli-acc       =  0
     4221         bf_tt-allsum-line.transport-base-acc   =  0
     4222         bf_tt-allsum-line.transport-rubl-acc   =  0
     4223         bf_tt-allsum-line.transport-cli-acc    =  0
     4224         bf_tt-allsum-line.other-base-acc       =  0
     4225         bf_tt-allsum-line.other-rubl-acc       =  0
     4226         bf_tt-allsum-line.other-cli-acc        =  0
     4227         .
     4228       create bfs_tt-allsum-line.
     4229       assign
     4230       bfs_tt-allsum-line.sum-type = 'основная_сумма_со_знаком':U.
     4231       if bf_trn-doc.doc-type = 'инв':U or
     4232          bf_trn-doc.doc-type = 'при':U    or
     4233          bf_trn-doc.doc-type = 'возврат':U    then do:
     4234          buffer-copy bf_tt-allsum-line except bf_tt-allsum-line.sum-type to bfs_tt-allsum-line.
     4235       end.
     4236       else do:
     4237         assign
     4238           bfs_tt-allsum-line.fact-qnty           =  - bf_tt-allsum-line.fact-qnty
     4239           bfs_tt-allsum-line.cli-qnty            =  - bf_tt-allsum-line.cli-qnty
     4240           bfs_tt-allsum-line.sum-dsc-base-doc    =  - bf_tt-allsum-line.sum-dsc-base-doc
     4241           bfs_tt-allsum-line.sum-dsc-rubl-doc    =  - bf_tt-allsum-line.sum-dsc-rubl-doc
     4242           bfs_tt-allsum-line.dsc-base-doc        =  - bf_tt-allsum-line.dsc-base-doc
     4243           bfs_tt-allsum-line.dsc-rubl-doc        =  - bf_tt-allsum-line.dsc-rubl-doc
     4244           bfs_tt-allsum-line.vat-base-doc        =  - bf_tt-allsum-line.vat-base-doc
     4245           bfs_tt-allsum-line.vat-rubl-doc        =  - bf_tt-allsum-line.vat-rubl-doc
     4246           bfs_tt-allsum-line.vat-base-buyer-doc  =  - bf_tt-allsum-line.vat-base-buyer-doc
     4247           bfs_tt-allsum-line.vat-rubl-buyer-doc  =  - bf_tt-allsum-line.vat-rubl-buyer-doc
     4248           bfs_tt-allsum-line.slt-base-doc        =  - bf_tt-allsum-line.slt-base-doc
     4249           bfs_tt-allsum-line.slt-rubl-doc        =  - bf_tt-allsum-line.slt-rubl-doc
     4250           bfs_tt-allsum-line.road-tax-base-doc   =  - bf_tt-allsum-line.road-tax-base-doc
     4251           bfs_tt-allsum-line.road-tax-rubl-doc   =  - bf_tt-allsum-line.road-tax-rubl-doc
     4252           bfs_tt-allsum-line.excise-base-doc     =  - bf_tt-allsum-line.excise-base-doc
     4253           bfs_tt-allsum-line.excise-rubl-doc     =  - bf_tt-allsum-line.excise-rubl-doc
     4254           bfs_tt-allsum-line.sum-dsc-base-cur    =  - bf_tt-allsum-line.sum-dsc-base-cur
     4255           bfs_tt-allsum-line.sum-dsc-rubl-cur    =  - bf_tt-allsum-line.sum-dsc-rubl-cur
