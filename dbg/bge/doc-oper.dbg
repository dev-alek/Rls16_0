     6293   procedure cp-attr-value :
     6294     do
     6295     on error undo, return error
     6296     :
     6297       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     6298       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     6299       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     6300       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     6301       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     6302       define input  parameter p-code        like ub.cash-pay-attr.attr-code      no-undo .
     6303       define output parameter p-value       like ub.cash-pay-attr.attr-value    no-undo .
     6304       define output parameter p-type        as character no-undo .
     6305       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     6306       define variable v-format         as character no-undo .
     6307       define variable v-label          as character no-undo .
     6308       define variable v-range          as integer   no-undo .
     6309       define variable v-user-can-edit  as logical   no-undo .
     6310       define variable v-output-display as logical   no-undo .
     6311       define variable v-other          as character no-undo .
     6312       run cp-attr-code in this-procedure
     6313         (input  p-code
     6314         ,output p-type
     6315         ,output v-format
     6316         ,output v-label
     6317         ,output v-range
     6318         ,output v-user-can-edit
     6319         ,output v-output-display
     6320         ,output v-other
     6321         ) no-error .
     6322       if error-status :error then do:
     6323         undo, return error return-value .
     6324       end.
     6325       find first buf_cash-pay-attr no-lock
     6326         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     6327           and buf_cash-pay-attr.curr-code  = p-curr-code
     6328           and buf_cash-pay-attr.host-code  = p-host-code
     6329           and buf_cash-pay-attr.obj-type   = p-obj-type
     6330           and buf_cash-pay-attr.obj-code   = p-obj-code
     6331           and buf_cash-pay-attr.attr-code  = p-code
     6332         no-error .
     6333       if avail buf_cash-pay-attr then do:
     6334         assign
     6335           p-value =  buf_cash-pay-attr.attr-value
     6336         .
     6337       end.
     6338       else do:
     6339         assign
     6340           p-value = if p-type = 'L':U then "no":U else ""
     6341         .
     6342       end.
     6343     end.
     6344   end procedure.
     6345   procedure cp-attr-write :
     6346     do
