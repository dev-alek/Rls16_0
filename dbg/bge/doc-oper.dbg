     4377     (input  bf_trn-doc.obj-type
     4378     ,input  bf_trn-doc.obj-code
     4379     ,input  varb-code
     4380     ,input  0
     4381     ,input  bf_trn-doc.fact-order
     4382     ,output vardoc-num
     4383     ,output varprice-sale
     4384     ,output varroad-tax
     4385     ,output varexcise
     4386     )  .
     4387             if varprice-sale = ?
     4388             then do:
     4389               assign
     4390                 varprice-sale = 0
     4391                 varroad-tax   = 0
     4392                 varexcise     = 0
     4393               .
     4394             end.
     4395             assign
     4396               varlastcur-base     = varprice-sale
     4397               varlastcur-road-tax = varroad-tax
     4398               varlastcur-excise   = varexcise
     4399               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     4400               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     4401               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     4402               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     4403             .
     4404         end.
     4405       end.
     4406       if varcur-fact-qnty = 0 then do:
     4407         assign
     4408           varcur-base      = varlastcur-base
     4409           varcur-road-tax  = varlastcur-road-tax
     4410           varcur-excise    = varlastcur-excise
     4411         .
     4412       end.
     4413       else do:
     4414         assign
     4415           varcur-base      = varcur-base      / varcur-fact-qnty
     4416           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     4417           varcur-excise    = varcur-excise    / varcur-fact-qnty
     4418         .
     4419       end.
     4420       if varcur-vat-pc = ?
     4421       then do:
     4422         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     4423       end.
     4424       if varcur-slt-pc = ?
     4425       then do:
     4426         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     4427       end.
     4428       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     4429       assign
     4430         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     4431       if varcur-cons-vat-pc = ? then do:
     4432         return error substitute ("Нет текущего продажного консигнационного НДС по фирме &1", bf_trn-doc.host-code).
     4433       end.
