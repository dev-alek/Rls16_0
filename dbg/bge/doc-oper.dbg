     9180     end.
     9181     else do:
     9182       find first in-vatp_doc-attro no-lock
     9183         where in-vatp_doc-attro.doc-code  = out-vatp_parts.out-code
     9184           and in-vatp_doc-attro.attr-code = 'envd':U
     9185         no-error .
     9186       if not available in-vatp_doc-attro then do:
     9187         assign
     9188           in-vatp-have-vat-slto = yes.
     9189       end.
     9190       else do:
     9191            in-vatp-have-vat-slto = no.
     9192       end.
     9193     end.
     9194     assign
     9195      price-cli-with-tax-loco = out-vatp_parts.price-cli
     9196      cli-base-rateo          = out-vatp_parts.cli-base-rate.
     9197     ASSIGN   road-tax-base-loco  = (if out-vatp_parts.road-tax-base  = ? then 0 else out-vatp_parts.road-tax-base)
     9198              road-tax-rubl-loco  = (if out-vatp_parts.road-tax-rubl  = ? then 0 else out-vatp_parts.road-tax-rubl).
     9199     ASSIGN  transport-base-loco = (if out-vatp_parts.transport-base = ? then 0 else out-vatp_parts.transport-base)
     9200             transport-rubl-loco = (if out-vatp_parts.transport-rubl = ? then 0 else out-vatp_parts.transport-rubl)
     9201             other-base-loco     = (if out-vatp_parts.other-base     = ? then 0 else out-vatp_parts.other-base)
     9202             other-rubl-loco     = (if out-vatp_parts.other-rubl     = ? then 0 else out-vatp_parts.other-rubl)
     9203             vat-pc-loco         = (if out-vatp_parts.vat-pc         = ? then 0 else out-vatp_parts.vat-pc)
     9204             slt-pc-loco         = (if out-vatp_parts.slt-pc         = ? then 0 else out-vatp_parts.slt-pc).
     9205             ASSIGN   slt-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     9206       ASSIGN   slt-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     9207     assign
     9208       exch-rate-cli-loco = (out-vatp_parts.price-rubl - transport-rubl-loco - other-rubl-loco - road-tax-rubl-loco - (if out-vatp_parts.vat-type <> 'в т. ч.':U then vat-rubl-loco else 0) - (if out-vatp_parts.slt-type <> 'в т. ч.':U then slt-rubl-loco else 0)) / out-vatp_parts.price-cli .
     9209     assign
     9210       slt-cli-loco        = slt-rubl-loco       / exch-rate-cli-loco
     9211       vat-cli-loco        = vat-rubl-loco       / exch-rate-cli-loco
     9212       road-tax-cli-loco   = road-tax-rubl-loco  / exch-rate-cli-loco
     9213       transport-cli-loco  = 0
     9214       other-cli-loco      = 0
     9215     .
     9216   ASSIGN
     9217             price-base-without-tax-loco = price-base-with-tax-loco - vat-base-loco - slt-base-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))
     9218       price-rubl-without-tax-loco = price-rubl-with-tax-loco - vat-rubl-loco - slt-rubl-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))
     9219   .
     9220         assign
     9221           varprice-base-cons = varprice-base-cons + (price-base-with-tax-loco - (if road-tax-base-loco = ? then 0 else road-tax-base-loco))* out-vatp_parts.fact-qnty
     9222           varprice-rubl-cons = varprice-rubl-cons + (price-rubl-with-tax-loco - (if road-tax-rubl-loco = ? then 0 else road-tax-rubl-loco))* out-vatp_parts.fact-qnty.
     9223         assign
     9224           varis-cons-parts-have = yes
     9225           varcons-qnty          = varcons-qnty + out-vatp_parts.fact-qnty.
     9226       end.
     9227       assign
     9228         varfact-qnty = varfact-qnty + out-vatp_parts.fact-qnty.
     9229     end.
     9230   end.
     9231   assign
     9232     varprice-base-cons = varprice-base-cons / varcons-qnty
     9233     varprice-rubl-cons = varprice-rubl-cons / varcons-qnty.
     9234   if varprice-base-cons = ? then do:
     9235     assign
     9236       varprice-base-cons = 0.
     9237   end.
     9238   if varprice-rubl-cons = ? then do:
     9239     assign
     9240       varprice-rubl-cons = 0.
     9241   end.
     9242   assign
     9243       slt-base-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
     9244     vat-base-buyer              = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     9245     discnt-base-sale            = buf_gds-dtl.discnt-base
     9246     price-base-with-tax-sale    = (buf_gds-dtl.price-base - buf_gds-dtl.discnt-base)
     9247       slt-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
     9248     vat-rubl-buyer              = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     9249     discnt-rubl-sale            = buf_gds-dtl.discnt-rubl
     9250     price-rubl-with-tax-sale    = (buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl)
     9251     .
     9252   if buf_trn-doc.doc-type = 'инв':U then do:
     9253     assign
     9254       varfact-qnty = buf_gds-dtl.doc-qnty.
     9255   end.
     9256   else do:
     9257     assign
     9258       varfact-qnty = buf_gds-dtl.fact-qnty.
     9259   end.
     9260   if varis-cons-parts-have = no then do:
     9261     assign
     9262           vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     9263           vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc).
     9264   end.
     9265   else do:
     9266     if buf_trn-doc.doc-type = 'инв':U then do:
     9267       assign
     9268               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     9269               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     9270        .
     9271     end.
     9272     else do:
     9273       assign
     9274               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-base-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     9275               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-rubl-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     9276        .
     9277     end.
     9278   end.
     9279   assign
     9280   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     9281   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     9282           assign
     9283               v-doc-qnty            = buf_gds-dtl.doc-qnty
     9284               v-fact-qnty           = buf_gds-dtl.fact-qnty
     9285               v-sum-rubl            = price-rubl-with-tax-sale    * v-fact-qnty
     9286               v-vat-rubl            = vat-rubl-buyer              * v-fact-qnty
     9287               v-slt-rubl            = slt-rubl-sale               * v-fact-qnty
     9288               v-road-tax-rubl       = road-tax-rubl-sale          * v-fact-qnty
     9289               v-sum-base            = price-base-with-tax-sale    * v-fact-qnty
     9290               v-vat-base            = vat-base-buyer              * v-fact-qnty
     9291               v-slt-base            = slt-base-sale               * v-fact-qnty
     9292               v-road-tax-base       = road-tax-base-sale          * v-fact-qnty
     9293           .
     9294           if v-bge-xml-bgefmt = "dbf":U
     9295           then do:
     9296               run set-dbf-out-file-name in this-procedure (
     9297                     input substitute( "ldtl&1&2_":U, buf_gds-dtl.artic, buf_gds-dtl.prt-code )
     9298                   , input p-doc-code
     9299               ).
     9300           end.
     9301           run wp-xmltagopen in this-procedure ( input 5, input "dtl", input "" ).
     9302           run wp-xmltagput in this-procedure ( input 6, input "dtlName"   , input string( buf_gds-prt.f-name ), input 2 ).
     9303           if p-ext-doc-type = 'vt':U
     9304           or p-ext-doc-type = 'vp':U
     9305           or p-ext-doc-type = 'ap':U
     9306           or p-ext-doc-type = 'mp':U
     9307           then do:
     9308               run wp-xmltagput in this-procedure ( input 6, input "qnty"          , input string( v-doc-qnty                  ), input 2 ).
     9309               run wp-xmltagput in this-procedure ( input 6, input "beforeQnty"    , input string( v-fact-qnty - v-doc-qnty    ), input 2 ).
     9310               run wp-xmltagput in this-procedure ( input 6, input "afterQnty"     , input string( v-fact-qnty                 ), input 2 ).
     9311           end.
     9312           else do:
     9313               run wp-xmltagput in this-procedure ( input 6, input "qnty"      , input string( v-fact-qnty        ), input 2 ).
     9314           end.
     9315           run wp-xmltagput in this-procedure ( input 6, input "sumr"      , input string( v-sum-rubl         ), input 1 ).
     9316           run wp-xmltagput in this-procedure ( input 6, input "VATr"      , input string( v-vat-rubl         ), input 2 ).
     9317           run wp-xmltagput in this-procedure ( input 6, input "SLTr"      , input string( v-slt-rubl         ), input 2 ).
     9318           run wp-xmltagput in this-procedure ( input 6, input "roadTaxr"  , input string( v-road-tax-rubl    ), input 2 ).
     9319           run wp-xmltagput in this-procedure ( input 6, input "sumb"      , input string( v-sum-base         ), input 2 ).
     9320           run wp-xmltagput in this-procedure ( input 6, input "VATb"      , input string( v-vat-base         ), input 2 ).
     9321           run wp-xmltagput in this-procedure ( input 6, input "SLTb"      , input string( v-slt-base         ), input 2 ).
     9322           run wp-xmltagput in this-procedure ( input 6, input "roadTaxb"  , input string( v-road-tax-base    ), input 2 ).
     9323           run wp-xmltagclose in this-procedure ( input 5, input "dtl" ).
     9324       end.
     9325   end.
     9326   end procedure.
     9327   procedure export-header :
     9328   define input parameter p-doc-code           as character        no-undo.
     9329   define input parameter p-obj-type           as character        no-undo.
     9330   define input parameter p-obj-code           as integer          no-undo.
     9331   define input parameter p-fact-order         as decimal          no-undo.
     9332   define input parameter p-ext-doc-type       as character        no-undo.
     9333   define output parameter p-doc-exists        as logical          no-undo.
     9334   define output parameter p-trn-doc-out-code  as character        no-undo.
     9335   define output parameter p-trn-doc-office    as logical          no-undo.
     9336       define variable v-doc-date        as date         no-undo.
     9337       define variable v-fact-date       as date         no-undo.
     9338       define variable v-fact-time       as integer      no-undo.
     9339       define variable v-shift-date      as date         no-undo.
     9340       define variable v-shift-num       as integer      no-undo.
     9341       define variable v-shift-name      as character    no-undo.
     9342       define variable v-reason-code     as integer      no-undo.
     9343       define variable v-doc-PS          as character    no-undo.
     9344       define variable v-sys-date        as date         no-undo.
     9345       define variable v-sys-time        as character    no-undo.
     9346       define variable v-temp-char       as character    no-undo.
     9347       define variable v-supp-dog-code   as character    no-undo.
     9348       define variable v-supp-ndog       as character    no-undo.
     9349       define variable v-supp-ddog       as character    no-undo.
     9350       define variable v-attr-value      as character    no-undo.
     9351       define variable v-attr-type       as character    no-undo.
     9352       define variable v-ext-doc-type    as character    no-undo.
     9353       define variable v-d-card          as character    no-undo.
     9354       define variable v-supp-in-doc-no  as character    no-undo.
     9355       define variable v-doc-exch-code   as integer      no-undo.
     9356       define variable v-doc-exch-rate   as decimal      no-undo.
     9357       define variable v-doc-exch-scale  as integer      no-undo.
     9358       define variable v-idContr         as character    no-undo.
     9359       define buffer buf_trn-doc       for ub.trn-doc.
     9360       define buffer buf_price-doc     for ub.price-doc.
     9361       define buffer buf_contract      for ub.contract.
     9362       define buffer buf_ord-chain     for ub.ord-chain.
     9363       define buffer buf_ord-doc-rcv   for ub.ord-doc-rcv.
     9364   do
     9365   for buf_trn-doc
     9366     , buf_price-doc
     9367     , buf_contract
     9368     , buf_ord-chain
     9369     , buf_ord-doc-rcv
     9370   on error undo, return error
     9371   :
     9372       assign
     9373           v-supp-dog-code   = "":U
     9374           v-supp-ndog       = "":U
     9375           v-supp-ddog       = "":U
     9376           v-d-card          = "":U
     9377           v-ext-doc-type    = p-ext-doc-type
     9378           v-doc-exch-code   = ?
     9379           v-doc-exch-rate   = ?
     9380           v-doc-exch-scale  = ?
     9381       .
     9382       if p-ext-doc-type <> 'ot':U
     9383       then do:
