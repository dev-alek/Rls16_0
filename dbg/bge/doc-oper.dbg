     7049           then do:
     7050               run utl/cuaddsum.p (
     7051                   input v-doc-code
     7052               ) no-error.
     7053               if error-status :error
     7054               then do:
     7055                   run wp-XMLWriteLog(
     7056                         input v-bge-xml-log-file-name
     7057                       , input 1
     7058                       , input substitute( "*** WRN: *** Не удалось проверить документ инвентаризации N: &1. &2. &3. &4"
     7059                                           , v-doc-code
     7060                                           , return-value
     7061                                           , trim(error-status :get-message(1))
     7062                                           , trim(error-status :get-message(2))
     7063                                       )
     7064                   ).
     7065               end.
     7066               run export-before-and-after-inv-trn in this-procedure (
     7067                     input v-doc-code
     7068                   , output v-exists-before
     7069                   , output v-exists-after
     7070               ).
     7071           end.
     7072           if p-pay-code = yes
     7073           then do:
     7074               run wp-xmltagopen( 3, "paySum", "" ).
     7075               for each temp_cost_cat-id_ot-supp-tot
     7076               on error undo, return error
     7077               :
     7078                   run wp-xmltagopen( 4,  string( temp_cost_cat-id_ot-supp-tot.cat-id ), "" ).
     7079                   for each temp_cost_cli_ot-supp-tot
     7080                   where temp_cost_cli_ot-supp-tot.cat-id = temp_cost_cat-id_ot-supp-tot.cat-id
     7081                   on error undo, return error
     7082                   :
     7083                       run fill_bge-xml_clients in this-procedure (
     7084                             input p-parent-handle
     7085                           , input temp_cost_cli_ot-supp-tot.cli-type
     7086                           , input temp_cost_cli_ot-supp-tot.cli-code
     7087                       ).
     7088                       if v-bge-xml-bgefmt = "dbf":U
     7089                       then do:
     7090                           run set-dbf-out-file-name in this-procedure (
     7091                                 input substitute( "hspc_&1":U, temp_cost_cli_ot-supp-tot.cat-id )
     7092                               , input v-doc-code
     7093                           ).
     7094                       end.
     7095                       run wp-xmltagopen( 5, "firm", "" ).
     7096                       run wp-xmltagput( 6, "type", string( temp_cost_cli_ot-supp-tot.cli-type ), 2 ).
     7097                       run wp-xmltagput( 6, "code", string( temp_cost_cli_ot-supp-tot.cli-code ), 2 ).
     7098                       run wp-xmltagopen( 6, "cost", "" ).
     7099                       if temp_cost_cli_ot-supp-tot.sum-rubl < 0
     7100                       then do:
     7101                           run wp-xmltagput( 8, "sign", "-1", 0 ).
     7102                       end.
     7103                       run wp-xmltagput( 7, "sumr",         string( bge-xml-normalize-dec( abs( temp_cost_cli_ot-supp-tot.sum-rubl ) ) ), 1 ).
     7104                       run wp-xmltagput( 7, "VATr",         string( abs( temp_cost_cli_ot-supp-tot.vat-rubl         ) ), 2 ).
     7105                       run wp-xmltagput( 7, "SLTr",         string( abs( temp_cost_cli_ot-supp-tot.slt-rubl         ) ), 2 ).
     7106                       run wp-xmltagput( 7, "roadTaxr",     string( abs( temp_cost_cli_ot-supp-tot.road-tax-rubl    ) ), 2 ).
     7107                       run wp-xmltagput( 7, "transportr",   string( abs( temp_cost_cli_ot-supp-tot.transport-rubl   ) ), 2 ).
     7108                       run wp-xmltagput( 7, "otherr",       string( abs( temp_cost_cli_ot-supp-tot.other-rubl       ) ), 2 ).
     7109                       run wp-xmltagput( 7, "exciser",      string( abs( temp_cost_cli_ot-supp-tot.excise-rubl      ) ), 2 ).
     7110                       run wp-xmltagput( 7, "sumb",         string( abs( temp_cost_cli_ot-supp-tot.sum-base         ) ), 2 ).
     7111                       run wp-xmltagput( 7, "VATb",         string( abs( temp_cost_cli_ot-supp-tot.vat-base         ) ), 2 ).
     7112                       run wp-xmltagput( 7, "SLTb",         string( abs( temp_cost_cli_ot-supp-tot.slt-base         ) ), 2 ).
     7113                       run wp-xmltagput( 7, "roadTaxb",     string( abs( temp_cost_cli_ot-supp-tot.road-tax-base    ) ), 2 ).
     7114                       run wp-xmltagput( 7, "transportb",   string( abs( temp_cost_cli_ot-supp-tot.transport-base   ) ), 2 ).
     7115                       run wp-xmltagput( 7, "otherb",       string( abs( temp_cost_cli_ot-supp-tot.other-base       ) ), 2 ).
     7116                       run wp-xmltagput( 7, "exciseb",      string( abs( temp_cost_cli_ot-supp-tot.excise-base      ) ), 2 ).
     7117                       run wp-xmltagclose( 6, "cost" ).
     7118                       find first buf_sale_ot-supp-tot no-lock
     7119                            where buf_sale_ot-supp-tot.doc-code = v-doc-code
     7120                              and buf_sale_ot-supp-tot.cli-type = temp_cost_cli_ot-supp-tot.cli-type
     7121                              and buf_sale_ot-supp-tot.cli-code = temp_cost_cli_ot-supp-tot.cli-code
     7122                              and buf_sale_ot-supp-tot.sum-type = 'sale':U
     7123                              and buf_sale_ot-supp-tot.cat-id   = '##':U
     7124                       no-error.
     7125                       if available buf_sale_ot-supp-tot
     7126                       then do:
     7127                           if v-bge-xml-bgefmt = "dbf":U
     7128                           then do:
     7129                               run set-dbf-out-file-name in this-procedure (
     7130                                     input substitute( "hsps_&1":U, temp_cost_cli_ot-supp-tot.cat-id )
     7131                                   , input v-doc-code
     7132                               ).
     7133                           end.
     7134                           run wp-xmltagopen( 6, "sale" , "" ).
     7135                           if buf_sale_ot-supp-tot.sum-rubl < 0
     7136                           then do:
     7137                               run wp-xmltagput( 8, "sign", "-1", 0 ).
     7138                           end.
     7139                           run wp-xmltagput( 7, "sumr",       string( bge-xml-normalize-dec( abs( buf_sale_ot-supp-tot.sum-rubl       ) / buf_sale_ot-supp-tot.fact-qnty  * temp_cost_cli_ot-supp-tot.fact-qnty ) ), 1 ).
     7140                           run wp-xmltagput( 7, "VATr",       string( abs( buf_sale_ot-supp-tot.vat-rubl       ) / buf_sale_ot-supp-tot.fact-qnty  * temp_cost_cli_ot-supp-tot.fact-qnty ), 2 ).
     7141                           run wp-xmltagput( 7, "SLTr",       string( abs( buf_sale_ot-supp-tot.slt-rubl       ) / buf_sale_ot-supp-tot.fact-qnty  * temp_cost_cli_ot-supp-tot.fact-qnty ), 2 ).
     7142                           run wp-xmltagput( 7, "roadTaxr",   string( abs( buf_sale_ot-supp-tot.road-tax-rubl  ) / buf_sale_ot-supp-tot.fact-qnty  * temp_cost_cli_ot-supp-tot.fact-qnty ), 2 ).
     7143                           run wp-xmltagput( 7, "transportr", string( abs( buf_sale_ot-supp-tot.transport-rubl ) / buf_sale_ot-supp-tot.fact-qnty  * temp_cost_cli_ot-supp-tot.fact-qnty ), 2 ).
     7144                           run wp-xmltagput( 7, "otherr",     string( abs( buf_sale_ot-supp-tot.other-rubl     ) / buf_sale_ot-supp-tot.fact-qnty  * temp_cost_cli_ot-supp-tot.fact-qnty ), 2 ).
     7145                           run wp-xmltagput( 7, "exciser",    string( abs( buf_sale_ot-supp-tot.excise-rubl    ) / buf_sale_ot-supp-tot.fact-qnty  * temp_cost_cli_ot-supp-tot.fact-qnty ), 2 ).
     7146                           run wp-xmltagput( 7, "sumb",       string( abs( buf_sale_ot-supp-tot.sum-base       ) / buf_sale_ot-supp-tot.fact-qnty  * temp_cost_cli_ot-supp-tot.fact-qnty ), 2 ).
     7147                           run wp-xmltagput( 7, "VATb",       string( abs( buf_sale_ot-supp-tot.vat-base       ) / buf_sale_ot-supp-tot.fact-qnty  * temp_cost_cli_ot-supp-tot.fact-qnty ), 2 ).
     7148                           run wp-xmltagput( 7, "SLTb",       string( abs( buf_sale_ot-supp-tot.slt-base       ) / buf_sale_ot-supp-tot.fact-qnty  * temp_cost_cli_ot-supp-tot.fact-qnty ), 2 ).
     7149                           run wp-xmltagput( 7, "roadTaxb",   string( abs( buf_sale_ot-supp-tot.road-tax-base  ) / buf_sale_ot-supp-tot.fact-qnty  * temp_cost_cli_ot-supp-tot.fact-qnty ), 2 ).
     7150                           run wp-xmltagput( 7, "transportb", string( abs( buf_sale_ot-supp-tot.transport-base ) / buf_sale_ot-supp-tot.fact-qnty  * temp_cost_cli_ot-supp-tot.fact-qnty ), 2 ).
     7151                           run wp-xmltagput( 7, "otherb",     string( abs( buf_sale_ot-supp-tot.other-base     ) / buf_sale_ot-supp-tot.fact-qnty  * temp_cost_cli_ot-supp-tot.fact-qnty ), 2 ).
     7152                           run wp-xmltagput( 7, "exciseb",    string( abs( buf_sale_ot-supp-tot.excise-base    ) / buf_sale_ot-supp-tot.fact-qnty  * temp_cost_cli_ot-supp-tot.fact-qnty ), 2 ).
     7153                           run wp-xmltagclose( 6,  "sale" ).
     7154                       end.
     7155                       run wp-xmltagclose( 5, "firm" ).
     7156                   end.
     7157                   run wp-xmltagclose( 4,  string( temp_cost_cat-id_ot-supp-tot.cat-id ) ).
     7158               end.
     7159               run wp-xmltagclose( 3,  "paySum" ).
     7160           end.
     7161           def var f as log no-undo.
     7162           def var l as log no-undo.
     7163           for each buf_ot-line-crsa-loop no-lock
     7164             where buf_ot-line-crsa-loop.doc-code = v-doc-code
     7165             and buf_ot-line-crsa-loop.sum-type = 'crsa':U
     7166             break
     7167             by buf_ot-line-crsa-loop.artic
     7168             by buf_ot-line-crsa-loop.prod-type
     7169             by buf_ot-line-crsa-loop.prod-code
     7170           on error undo, return error
     7171           :
     7172             assign
     7173             f = first-of (buf_ot-line-crsa-loop.artic) or first-of (buf_ot-line-crsa-loop.prod-type) or first-of (buf_ot-line-crsa-loop.prod-code)
     7174             l = last-of (buf_ot-line-crsa-loop.artic) or last-of (buf_ot-line-crsa-loop.prod-type) or last-of (buf_ot-line-crsa-loop.prod-code).
     7175               if f
     7176               then do:
     7177                 create tt-ot-line.
     7178                 buffer-copy buf_ot-line-crsa-loop except buf_ot-line-crsa-loop.cat-id
     7179                     to tt-ot-line.
     7180               end.
     7181               if (l and not f) or (not l and not f)
     7182               then do:
     7183                 assign
     7184                   tt-ot-line.sum-base         =   tt-ot-line.sum-base        +    buf_ot-line-crsa-loop.sum-base
     7185                   tt-ot-line.sum-rubl         =   tt-ot-line.sum-rubl        +    buf_ot-line-crsa-loop.sum-rubl
     7186                   tt-ot-line.VAT-base         =   tt-ot-line.VAT-base        +    buf_ot-line-crsa-loop.VAT-base
     7187                   tt-ot-line.VAT-rubl         =   tt-ot-line.VAT-rubl        +    buf_ot-line-crsa-loop.VAT-rubl
     7188                   tt-ot-line.SLT-base         =   tt-ot-line.SLT-base        +    buf_ot-line-crsa-loop.SLT-base
     7189                   tt-ot-line.SLT-rubl         =   tt-ot-line.SLT-rubl        +    buf_ot-line-crsa-loop.SLT-rubl
     7190                   tt-ot-line.road-tax-base    =   tt-ot-line.road-tax-base   +    buf_ot-line-crsa-loop.road-tax-base
     7191                   tt-ot-line.road-tax-rubl    =   tt-ot-line.road-tax-rubl   +    buf_ot-line-crsa-loop.road-tax-rubl
     7192                   tt-ot-line.transport-base   =   tt-ot-line.transport-base  +    buf_ot-line-crsa-loop.transport-base
     7193                   tt-ot-line.transport-rubl   =   tt-ot-line.transport-rubl  +    buf_ot-line-crsa-loop.transport-rubl
     7194                   tt-ot-line.other-base       =   tt-ot-line.other-base      +    buf_ot-line-crsa-loop.other-base
     7195                   tt-ot-line.other-rubl       =   tt-ot-line.other-rubl      +    buf_ot-line-crsa-loop.other-rubl
     7196                   tt-ot-line.excise-base      =   tt-ot-line.excise-base     +    buf_ot-line-crsa-loop.excise-base
     7197                   tt-ot-line.excise-rubl      =   tt-ot-line.excise-rubl     +    buf_ot-line-crsa-loop.excise-rubl
     7198                   tt-ot-line.fact-qnty        =   tt-ot-line.fact-qnty       +    buf_ot-line-crsa-loop.fact-qnty
     7199                   .
     7200               end.
     7201               if l
     7202               then do:
     7203                 run export-document-lines in this-procedure (
     7204                       input recid( tt-ot-line )
     7205                     , input v-exists-before
     7206                     , input v-exists-after
     7207                     , input v-doc-code
     7208                     , input v-ot-tot-sale-exists
     7209                     , input v-ot-tot-cost-exists
     7210                     , input v-ot-tot-crsa-exists
     7211                     , input v-trn-doc-out-code
     7212                     , input v-is-envd_
     7213                 ).
     7214                 empty temp-table tt-ot-line.
     7215               end.
     7216           end.
     7217           for each buf_ot-line-crsa-loop no-lock
     7218              where buf_ot-line-crsa-loop.doc-code = v-doc-code
     7219                and buf_ot-line-crsa-loop.sum-type = 'cgsr':U
     7220           on error undo, return error
     7221           :
     7222               create tt-ot-line.
     7223               buffer-copy buf_ot-line-crsa-loop
     7224                   to tt-ot-line.
     7225               run export-document-lines in this-procedure (
     7226                     input recid( tt-ot-line )
     7227                   , input v-exists-before
     7228                   , input v-exists-after
     7229                   , input v-doc-code
     7230                   , input v-ot-tot-sale-exists
     7231                   , input v-ot-tot-cost-exists
     7232                   , input v-ot-tot-crsa-exists
     7233                   , input v-trn-doc-out-code
     7234                   , input v-is-envd_
     7235               ).
     7236               empty temp-table tt-ot-line.
     7237           end.
     7238           if p-need-chk = yes
     7239           then do:
     7240               if p-ext-doc-type = 'es':U
     7241               or p-ext-doc-type = 'rs':U
     7242               then do:
     7243                   run export-checks in this-procedure (
     7244                         input p-ext-doc-type
     7245                       , input v-doc-code
     7246                       , input v-obj-type
     7247                       , input v-obj-code
     7248                   ).
     7249               end.
     7250           end.
     7251           run wp-xmltagclose( 2, "operation" ).
     7252           run wp-XMLWriteLog in this-procedure ( input v-bge-xml-log-file-name
     7253                                                , input 1
     7254                                                , input substitute( "Выгрузка документа &1 в пакет &2 завершена."
     7255                                                                  , v-doc-code
     7256                                                                  , sOutFile
     7257                                                                  )
     7258                                                ).
     7259           output stream stmxmlout close.
     7260           if v-bge-xml-bgeflold = "oracle":u
     7261           then do:
     7262             run xml-bge-write-footer in this-procedure ( input v-exp-ora-filename ).
     7263           end.
     7264       end.
     7265   end.
     7266   end procedure.
     7267   procedure export-document-lines :
     7268   do
     7269   on error undo, return error
     7270   :
     7271   define input parameter p-ot-line-loop-recid     as recid            no-undo.
     7272   define input parameter p-exists-before          as logical          no-undo.
     7273   define input parameter p-exists-after           as logical          no-undo.
     7274   define input parameter p-doc-code               as character        no-undo.
     7275   define input parameter p-ot-tot-sale-exists     as logical          no-undo.
     7276   define input parameter p-ot-tot-cost-exists     as logical          no-undo.
     7277   define input parameter p-ot-tot-crsa-exists     as logical          no-undo.
     7278   define input parameter p-trn-doc-out-code       as character        no-undo.
     7279   define input parameter p-is-envd_               as logical          no-undo.
     7280       define variable v-fact-qnty             as decimal      no-undo.
     7281       define variable v-doc-qnty              as decimal      no-undo.
     7282       define variable v-sum-base              as decimal      no-undo.
     7283       define variable v-sum-rubl              as decimal      no-undo.
     7284       define variable v-vat-base              as decimal      no-undo.
     7285       define variable v-vat-rubl              as decimal      no-undo.
     7286       define variable v-slt-base              as decimal      no-undo.
     7287       define variable v-slt-rubl              as decimal      no-undo.
     7288       define variable v-road-tax-base         as decimal      no-undo.
     7289       define variable v-road-tax-rubl         as decimal      no-undo.
     7290       define variable v-excise-base           as decimal      no-undo.
     7291       define variable v-excise-rubl           as decimal      no-undo.
     7292       define variable v-transport-base        as decimal      no-undo.
     7293       define variable v-transport-rubl        as decimal      no-undo.
     7294       define variable v-other-base            as decimal      no-undo.
     7295       define variable v-other-rubl            as decimal      no-undo.
     7296       define variable v-parts-host-code       as integer      no-undo.
     7297       define variable v-parts-contract-code   as integer      no-undo.
     7298       define variable v-price-prev            as decimal      no-undo.
     7299       define variable v-parts-price-cli       as decimal      no-undo.
     7300       define variable v-parts-cli-base-rate   as decimal      no-undo.
     7301       define variable v-parts-vat-type        as character    no-undo.
     7302       define variable v-parts-exch-code       as integer      no-undo.
     7303       define variable v-parts-attr-exch-rate  as decimal      no-undo.
     7304       define variable v-parts-attr-exch-scale as integer      no-undo.
     7305       define variable v-parts-attr-unit-cli   as character    no-undo.
     7306       define variable v-scale-is-empty        as logical      no-undo.
     7307       define variable v-supp-dog-code         as character    no-undo.
     7308       define variable v-supp-ndog             as character    no-undo.
     7309       define variable v-supp-ddog             as character    no-undo.
     7310       define variable v-found-paycode         as logical      no-undo.
     7311       define variable v-found-paycard         as logical      no-undo.
     7312       define variable v-petrol-density        as decimal      no-undo.
     7313       define buffer buf_doc-line              for ub.doc-line.
     7314       define buffer buf_doc-pl                for ub.doc-pl .
     7315       define buffer buf_parts                 for ub.parts.
     7316       define buffer buf_parts-attr            for ub.parts-attr.
     7317       define buffer buf_sale_ot-supp-line     for ub.ot-supp-line.
     7318       define buffer buf_contract              for ub.contract.
     7319       define buffer buf_goods                 for ub.goods.
     7320       define buffer buf_clients               for ub.clients.
     7321       define buffer buf_price-list            for ub.price-list.
     7322       define buffer buf_units                 for ub.units.
     7323       define buffer buf_doc-line-attr         for ub.doc-line-attr.
     7324     define variable ii                   as integer no-undo.
     7325       define variable v-attrcode           as char no-undo.
     7326       define variable v-SectionName        as char no-undo.
     7327       define variable v-DocQnty            as decimal no-undo.
     7328       define variable v-CliQnty            as decimal no-undo .
     7329       define variable v-FactQnty           as decimal no-undo.
     7330       define variable v-DocDensity         as decimal no-undo.
     7331       define variable v-FactDensity        as decimal no-undo.
     7332       define variable v-TankVol            as decimal no-undo.
     7333       define variable v-TankDensity        as decimal no-undo.
     7334       define variable v-TankDensityPomi    as decimal no-undo.
     7335       define variable v-TankVolPomi        as decimal no-undo.
     7336       define variable v-tank-vol           as decimal no-undo .
     7337       define variable v-tank-density       as decimal no-undo .
     7338       define variable v-SectionNum         as integer no-undo.
     7339       define variable v-total-tank-density as decimal no-undo.
     7340       define variable v-tankweight         as decimal no-undo.
     7341       define variable v-sum-line           as decimal no-undo .
     7342       define buffer buf_ot-line-crsa-loop     for tt-ot-line.
     7343       define buffer buf_parts-root            for parts-root.
     7344       find first buf_ot-line-crsa-loop no-lock
     7345            where recid( buf_ot-line-crsa-loop ) = p-ot-line-loop-recid
     7346       .
     7347       if v-bge-xml-bgefmt = "dbf":U
     7348       then do:
     7349           run set-dbf-out-file-name in this-procedure (
     7350                 input substitute( "lhdr&1_":U, buf_ot-line-crsa-loop.artic )
     7351               , input p-doc-code
     7352           ).
     7353       end.
     7354       run wp-xmltagopen( 3, "linedoc", "" ).
     7355       find first buf_goods no-lock
     7356            where buf_goods.artic      = buf_ot-line-crsa-loop.artic
     7357              and buf_goods.prod-type  = buf_ot-line-crsa-loop.prod-type
     7358              and buf_goods.prod-code  = buf_ot-line-crsa-loop.prod-code
     7359       no-error.
     7360       if available buf_goods
     7361       then do:
     7362           run wp-xmltagput( 4, "good",      string( buf_goods.gds-code ), 0 ).
     7363           if p-ext-doc-type = 'vp':U
     7364           then do :
     7365             find first buf_parts-root no-lock where buf_parts-root.doc-code = p-doc-code
     7366                                                 and buf_parts-root.gds-code = buf_goods.gds-code
     7367                                                 no-error .
     7368             if available buf_parts-root
     7369             and buf_parts-root.orig-gds-code > 0
     7370             then
     7371             run wp-xmltagput( 4, "orig-gds-code",      string( buf_parts-root.orig-gds-code ), 0 ).
     7372           end.
     7373           run wp-xmltagput( 4, "artic",     string( buf_goods.artic    ), 0 ).
     7374           run wp-xmltagput( 4, "prodtype",  string( buf_goods.prod-type), 0 ).
     7375           run wp-xmltagput( 4, "prodcode",  string( buf_goods.prod-code), 0 ).
     7376           run wp-xmltagput( 4, "type",      string( buf_goods.gds-type ), 0 ).
     7377           run fill_bge-xml_goods in this-procedure (
     7378                 input p-parent-handle
     7379               , input buf_goods.gds-code
     7380           ).
     7381       end.
     7382       else do:
     7383           run wp-xmltagput( 4, "good",      "", 0 ).
     7384           run wp-xmltagput( 4, "artic",     "", 0 ).
     7385           run wp-xmltagput( 4, "prodtype",  "", 0 ).
     7386           run wp-xmltagput( 4, "prodcode",  "", 0 ).
     7387           run wp-xmltagput( 4, "type",      "", 0 ).
     7388       end.
     7389       find first buf_units no-lock
     7390               where buf_units.unit-name  = buf_goods.unit-base
     7391       no-error.
     7392       if available buf_units
     7393       then do:
     7394           run wp-xmltagput( 4, "unitType",    string( buf_units.type ), 0 ).
     7395       end.
     7396       else do:
     7397               run wp-xmltagput( 4, "unitType",   "",   0 ).
     7398       end.
     7399       if p-ext-doc-type <> 'ot':U
     7400       then do:
