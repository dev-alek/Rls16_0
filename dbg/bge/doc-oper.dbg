      605   procedure xmlchar-decode :
      606   define input parameter p-in-string      as character        no-undo.
      607   define output parameter p-out-string    as character        no-undo.
      608       define variable v-position      as integer      no-undo.
      609       define variable v-last-position as integer      no-undo.
      610       define variable v-temp-integer  as integer      no-undo.
      611       define variable v-current-char  as character    no-undo.
      612       define variable v-next-char     as character    no-undo.
      613       define variable v-success       as logical      no-undo.
      614   do
      615   on error undo, return error
      616   :
      617       assign
      618           p-out-string = "":U
      619           v-position   = 0
      620       .
      621       replace-cycle:
      622       do while yes
      623       on error undo, return error
      624       :
      625           assign
      626               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      627           .
      628           if v-last-position <= v-position
      629           then do:
      630               if v-position = 0
      631               then do:
      632                   assign
      633                       p-out-string = p-in-string
      634                   .
      635               end.
      636               else do:
      637                   assign
      638                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      639                   .
      640               end.
      641               leave replace-cycle.
      642           end.
      643           else do:
      644               assign
      645                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      646                   v-position      = v-last-position
      647                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      648               .
      649               if v-current-char = "#":U
      650               then do:
      651                   assign
      652                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      653                   .
      654                   if v-last-position > 0
      655                   then do:
      656                       run xmlchar-read-integer in this-procedure
      657                        (
      658                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      659                           , output v-temp-integer
      660                           , output v-success
      661                       ).
      662                       if v-success = yes
      663                       and v-temp-integer >= 1
      664                       and v-temp-integer <= 255
      665                       then do:
      666                           assign
      667                               p-out-string = p-out-string + chr( v-temp-integer )
      668                               v-position   = v-last-position + 1
      669                           .
      670                       end.
      671                       else do:
      672                           assign
      673                               p-out-string = p-out-string + "&":U
      674                               v-position   = v-position   + 1
      675                           .
      676                       end.
      677                   end.
      678                   else do:
      679                       assign
      680                           p-out-string = p-out-string + "&":U
      681                           v-position   = v-position   + 1
      682                       .
      683                   end.
      684               end.
      685               else do:
      686                   case substring( p-in-string, v-position + 1, 3 )
      687                   :
      688                       when "lt;":U
      689                       then do:
      690                           assign
      691                               p-out-string = p-out-string + "<":U
      692                               v-position   = v-position   + 3
      693                           .
      694                       end.
      695                       when "gt;":U
      696                       then do:
      697                           assign
      698                               p-out-string = p-out-string + ">":U
      699                               v-position   = v-position   + 3
      700                           .
      701                       end.
      702                       otherwise do:
      703                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      704                           then do:
      705                               assign
      706                                   p-out-string = p-out-string + "&":U
      707                                   v-position   = v-position   + 4
      708                               .
      709                           end.
      710                           else do:
      711                               case substring( p-in-string, v-position + 1, 5 )
      712                               :
      713                                   when "quot;":U
      714                                   then do:
      715                                       assign
      716                                           p-out-string = p-out-string + '"':U
      717                                           v-position   = v-position   + 5
      718                                       .
      719                                   end.
      720                                   when "apos;":U
      721                                   then do:
      722                                       assign
      723                                           p-out-string = p-out-string + "'":U
      724                                           v-position   = v-position   + 5
      725                                       .
      726                                   end.
      727                                   otherwise do:
      728                                       assign
      729                                           p-out-string = p-out-string + "&":U
      730                                       .
      731                                   end.
      732                               end case.
      733                           end.
      734                       end.
      735                   end case.
      736               end.
      737           end.
      738       end.
      739   end.
      740   end .
      741   procedure xmlchar-read-integer :
      742   define input parameter p-input-string      as character        no-undo.
      743   define output parameter p-output-integer   as integer          no-undo.
      744   define output parameter p-success       as logical          no-undo.
      745   do
      746   on error undo, return error
      747   :
      748       assign
      749           p-output-integer = integer( p-input-string )
      750       no-error.
      751       if error-status :error
      752       then do:
      753           assign
      754               p-success           = no
      755               p-output-integer    = 0
      756           .
      757       end.
      758       else do:
      759           assign
      760               p-success           = yes
      761           .
      762       end.
      763   end.
      764   end.
      765   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      766   procedure strtdate :
      767     define input  parameter p-str         as character no-undo .
      768     define output parameter p-value       as date      no-undo .
      769     define output parameter p-data-valid  as logical   no-undo .
      770     define output parameter p-message     as character no-undo .
      771   do
      772   on error undo, return error return-value
      773   :
      774     define variable v-value       as date      no-undo .
      775     define variable v-i           as integer   no-undo .
      776     define variable v-num         as integer   no-undo .
      777     define variable v-delim       as character no-undo .
      778     define variable v-delim-list  as character no-undo .
      779     define variable v-day         as integer   no-undo .
      780     define variable v-month       as integer   no-undo .
      781     define variable v-year        as integer   no-undo .
      782     define variable v-day-str     as character no-undo .
      783     define variable v-month-str   as character no-undo .
      784     define variable v-year-str    as character no-undo .
      785     assign
      786       p-value       = ?
      787       p-data-valid  = false
      788     .
      789     if p-str = ?
      790     then do:
      791       assign
      792         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      793       .
      794       return .
      795     end.
      796     if p-str = ""
      797     then do:
      798       assign
      799         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      800       .
      801       return .
      802     end.
      803     if length(p-str)  > 10
      804     then do:
      805       assign
      806         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      807       .
      808       return .
      809     end.
      810     assign
      811       v-delim-list = '/,-,.':U
      812     .
      813     _delim:
      814     do v-i = 1 to num-entries( v-delim-list )
      815     :
      816       assign
      817         v-delim = entry( v-i , v-delim-list )
      818         v-num   = num-entries( p-str , v-delim )
      819       .
      820       if v-num <> 3
      821       then do:
      822         assign
      823           v-delim = ''
      824         .
      825       end.
      826       else do:
      827         leave _delim.
      828       end.
      829     end.
      830     if v-delim = ''
      831     then do:
      832       assign
      833         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      834       .
      835       return .
      836     end.
      837     assign
      838       v-day-str   = entry( 1, p-str , v-delim)
      839       v-month-str = entry( 2, p-str , v-delim)
      840       v-year-str  = entry( 3, p-str , v-delim)
      841     .
      842     if  length(v-day-str) > 2   or
      843         length(v-day-str) < 1   or
      844         length(v-month-str) > 2 or
      845         length(v-month-str) < 1 or
      846         (
      847           length(v-year-str) <> 2 and
      848           length(v-year-str) <> 4
      849         )
      850     then do:
      851       assign
      852         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      853       .
      854       return .
      855     end.
      856     if length( v-year-str ) = 2
      857     then do:
      858       assign
      859         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      860       .
      861     end.
      862     assign
      863       v-day   = integer( v-day-str )
      864       v-month = integer( v-month-str)
      865       v-year  = integer( v-year-str)
      866     no-error .
      867     if error-status :error
      868     then do:
      869       assign
      870         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      871       .
      872       return .
      873     end.
      874     if v-day < 1  or
      875        v-day > 31 or
      876        v-month < 1 or
      877        v-month > 12 or
      878        v-year < 0   or
      879        v-year > 5000
      880     then do:
      881       assign
      882         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      883       .
      884       return .
      885     end.
      886     assign
      887       v-value = date( v-month, v-day, v-year )
      888     no-error .
      889     if error-status :error
      890     then do:
      891       assign
      892         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      893       .
      894       return .
      895     end.
      896     assign
      897       p-value       = v-value
      898       p-data-valid  = true
      899     .
      900   end.
      901   end procedure.
      902   define variable v-bge-xml-bgecliiv      as logical  init no  no-undo.
      903   define variable v-bge-xml-bgeclall      as logical  init no  no-undo.
