     6451   procedure cp-attr-delete :
     6452     do
     6453     on error undo, return error
     6454     :
     6455       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     6456       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     6457       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     6458       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     6459       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     6460       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     6461       define output parameter p-deleted  as logical no-undo.
     6462       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     6463       define variable v-type           as character no-undo .
     6464       define variable v-format         as character no-undo .
     6465       define variable v-label          as character no-undo .
     6466       define variable v-range          as integer   no-undo .
     6467       define variable v-user-can-edit  as logical   no-undo .
     6468       define variable v-output-display as logical   no-undo .
     6469       define variable v-other          as character no-undo .
     6470       run cp-attr-code in this-procedure
     6471         (input  p-code
     6472         ,output v-type
     6473         ,output v-format
     6474         ,output v-label
     6475         ,output v-range
     6476         ,output v-user-can-edit
     6477         ,output v-output-display
     6478         ,output v-other
     6479         ) no-error .
     6480       if error-status :error then do:
     6481         undo, return error return-value .
     6482       end.
     6483       find first buf_cash-pay-attr exclusive-lock
     6484         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     6485           and buf_cash-pay-attr.curr-code  = p-curr-code
     6486           and buf_cash-pay-attr.host-code  = p-host-code
     6487           and buf_cash-pay-attr.obj-type   = p-obj-type
     6488           and buf_cash-pay-attr.obj-code   = p-obj-code
     6489           and buf_cash-pay-attr.attr-code = p-code
     6490         no-error NO-WAIT.
     6491       if not available buf_cash-pay-attr then do:
     6492         p-deleted = no.
     6493       end.
     6494       else do:
     6495         delete buf_cash-pay-attr no-error .
     6496         if error-status:error then do:
     6497           undo, return error return-value .
     6498         end.
     6499         p-deleted = yes.
     6500       end.
