        6   define input parameter p-oper-name       as character               no-undo.
        7   define input parameter p-fact-order-from like ub.stk-tot.fact-order    no-undo.
        8   define input parameter p-fact-order-to   like ub.stk-tot.fact-order    no-undo.
        9   define input parameter p-date-from       as date                    no-undo.
