     6699   procedure export-documents :
     6700   do
     6701   on error undo, return error
     6702   :
     6703       define variable v-doc-code              as character    no-undo.
     6704       define variable v-obj-type              as character    no-undo.
     6705       define variable v-obj-code              as integer      no-undo.
     6706       define variable v-fact-order            as decimal      no-undo.
     6707       define variable v-crsa-sum-type         as character    no-undo.
     6708       define variable v-sale-sum-type         as character    no-undo.
     6709       define variable v-cost-sum-type         as character    no-undo.
     6710       define variable v-doc-exists            as logical      no-undo.
     6711       define variable v-trn-doc-out-code      as character    no-undo.
     6712       define variable v-trn-doc-office        as logical      no-undo.
     6713       define variable v-ot-tot-sale-exists    as logical      no-undo.
     6714       define variable v-ot-tot-cost-exists    as logical      no-undo.
     6715       define variable v-ot-tot-crsa-exists    as logical      no-undo.
     6716       define variable v-exists-before         as logical      no-undo.
     6717       define variable v-exists-after          as logical      no-undo.
     6718       define variable v-exp-ora-filename      as character    no-undo.
     6719       define variable v-date-from             as date         no-undo.
     6720       define variable v-date-to               as date         no-undo.
     6721       define variable v-obj-list              as character    no-undo.
     6722       define variable v-ora-exp-seq-num       as integer      no-undo.
     6723       define buffer buf_ot-tot-crsa-loop     for ub.ot-tot.
     6724       define buffer buf_ot-line-crsa-loop    for ub.ot-line.
     6725       define buffer buf_cost_ot-supp-line    for ub.ot-supp-line.
     6726       define buffer buf_sale_ot-supp-line    for ub.ot-supp-line.
     6727       define buffer buf_cost_ot-supp-tot     for ub.ot-supp-tot.
     6728       define buffer buf_sale_ot-supp-tot     for ub.ot-supp-tot.
     6729       define variable v-is-envd_              as logical      no-undo.
     6730       define variable vartype                 as character    no-undo.
     6731       define variable varenvd                 as character    no-undo.
     6732       define variable v-sum-all-parts         as decimal      no-undo.
     6733       define variable v-pr-doc-type           as logical      no-undo.
     6734       assign
     6735         v-obj-list = substitute( "&1,&2" , p-obj-type , p-obj-code )
     6736       .
     6737       if  p-ext-doc-type = 'ie':U
     6738           then assign v-pr-doc-type = YES .
     6739       export-documents-arch:
     6740       for each buf_ot-tot-crsa-loop no-lock
     6741          where buf_ot-tot-crsa-loop.obj-type     = p-obj-type
     6742            and buf_ot-tot-crsa-loop.obj-code     = p-obj-code
     6743            and buf_ot-tot-crsa-loop.ext-doc-type = p-ext-doc-type
     6744            and buf_ot-tot-crsa-loop.fact-order   > p-fact-order-from
     6745            and buf_ot-tot-crsa-loop.fact-order  <= p-fact-order-to
     6746            and buf_ot-tot-crsa-loop.sum-type     = 'crsa':U
     6747            and buf_ot-tot-crsa-loop.cat-id       = '##,##':U
     6748       on error undo, return error
     6749       :
     6750   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_ot-tot-crsa-loop.doc-code ,
     6751                           input 'envd':U ,
     6752                          output varenvd ,
     6753                          output vartype )  .
     6754           if    varenvd eq "YES"
     6755             and v-pr-doc-type eq YES
     6756             then
     6757             v-is-envd_ = YES .
     6758           else  v-is-envd_ = NO .
     6759           for each temp_cost_cat-id_ot-supp-tot no-lock
     6760           on error undo, return error
     6761           :
     6762               delete temp_cost_cat-id_ot-supp-tot.
     6763           end.
     6764           for each temp_cost_cli_ot-supp-tot no-lock
     6765           on error undo, return error
     6766           :
