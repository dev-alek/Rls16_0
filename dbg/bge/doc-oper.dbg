     8488                       run wp-xmltagput( 8, "exciseb",     string( abs( temp_cost_cli_ot-supp-line.excise-base      ) ), 2 ).
     8489                       run wp-xmltagclose( 7,  "cost" ).
     8490                       find first buf_sale_ot-supp-line no-lock
     8491                               where buf_sale_ot-supp-line.doc-code    = p-doc-code
     8492                               and buf_sale_ot-supp-line.cli-type    = temp_cost_cli_ot-supp-line.cli-type
     8493                               and buf_sale_ot-supp-line.cli-code    = temp_cost_cli_ot-supp-line.cli-code
     8494                               and buf_sale_ot-supp-line.artic       = temp_cost_cli_ot-supp-line.artic
     8495                               and buf_sale_ot-supp-line.prod-type   = temp_cost_cli_ot-supp-line.prod-type
     8496                               and buf_sale_ot-supp-line.prod-code   = temp_cost_cli_ot-supp-line.prod-code
     8497                               and buf_sale_ot-supp-line.sum-type    = 'sale':U
     8498                               and buf_sale_ot-supp-line.cat-id      = '##':U
     8499                       no-error.
     8500                       if available buf_sale_ot-supp-line
     8501                       then do:
     8502                           if v-bge-xml-bgefmt = "dbf":U
     8503                           then do:
     8504                               run set-dbf-out-file-name in this-procedure (
     8505                                    input substitute( "lsps&1&2_":U, buf_sale_ot-supp-line.artic, temp_cost_cat-id_ot-supp-line.cat-id )
     8506                                   , input p-doc-code
     8507                               ).
     8508                           end.
     8509                           run wp-xmltagopen( 7, "sale", "" ).
     8510                           if buf_sale_ot-supp-line.sum-rubl < 0
     8511                           then do:
     8512                               run wp-xmltagput( 8, "sign", "-1", 0 ).
     8513                           end.
     8514                           run wp-xmltagput( 8, "qnty",       string( abs( buf_sale_ot-supp-line.fact-qnty        )                                                                           ), 2 ).
     8515                           run wp-xmltagput( 8, "sumr",       string( bge-xml-normalize-dec( abs( buf_sale_ot-supp-line.sum-rubl         ) / buf_sale_ot-supp-line.fact-qnty  * temp_cost_cli_ot-supp-line.fact-qnty ) ), 1 ).
     8516                           run wp-xmltagput( 8, "VATr",       string( abs( buf_sale_ot-supp-line.vat-rubl         ) / buf_sale_ot-supp-line.fact-qnty  * temp_cost_cli_ot-supp-line.fact-qnty ), 2 ).
     8517                           run wp-xmltagput( 8, "SLTr",       string( abs( buf_sale_ot-supp-line.slt-rubl         ) / buf_sale_ot-supp-line.fact-qnty  * temp_cost_cli_ot-supp-line.fact-qnty ), 2 ).
     8518                           run wp-xmltagput( 8, "roadTaxr",   string( abs( buf_sale_ot-supp-line.road-tax-rubl    ) / buf_sale_ot-supp-line.fact-qnty  * temp_cost_cli_ot-supp-line.fact-qnty ), 2 ).
     8519                           run wp-xmltagput( 8, "transportr", string( abs( buf_sale_ot-supp-line.transport-rubl   ) / buf_sale_ot-supp-line.fact-qnty  * temp_cost_cli_ot-supp-line.fact-qnty ), 2 ).
     8520                           run wp-xmltagput( 8, "otherr",     string( abs( buf_sale_ot-supp-line.other-rubl       ) / buf_sale_ot-supp-line.fact-qnty  * temp_cost_cli_ot-supp-line.fact-qnty ), 2 ).
     8521                           run wp-xmltagput( 8, "exciser",    string( abs( buf_sale_ot-supp-line.excise-rubl      ) / buf_sale_ot-supp-line.fact-qnty  * temp_cost_cli_ot-supp-line.fact-qnty ), 2 ).
     8522                           run wp-xmltagput( 8, "sumb",       string( abs( buf_sale_ot-supp-line.sum-base         ) / buf_sale_ot-supp-line.fact-qnty  * temp_cost_cli_ot-supp-line.fact-qnty ), 2 ).
     8523                           run wp-xmltagput( 8, "VATb",       string( abs( buf_sale_ot-supp-line.vat-base         ) / buf_sale_ot-supp-line.fact-qnty  * temp_cost_cli_ot-supp-line.fact-qnty ), 2 ).
     8524                           run wp-xmltagput( 8, "SLTb",       string( abs( buf_sale_ot-supp-line.slt-base         ) / buf_sale_ot-supp-line.fact-qnty  * temp_cost_cli_ot-supp-line.fact-qnty ), 2 ).
     8525                           run wp-xmltagput( 8, "roadTaxb",   string( abs( buf_sale_ot-supp-line.road-tax-base    ) / buf_sale_ot-supp-line.fact-qnty  * temp_cost_cli_ot-supp-line.fact-qnty ), 2 ).
     8526                           run wp-xmltagput( 8, "transportb", string( abs( buf_sale_ot-supp-line.transport-base   ) / buf_sale_ot-supp-line.fact-qnty  * temp_cost_cli_ot-supp-line.fact-qnty ), 2 ).
     8527                           run wp-xmltagput( 8, "otherb",     string( abs( buf_sale_ot-supp-line.other-base       ) / buf_sale_ot-supp-line.fact-qnty  * temp_cost_cli_ot-supp-line.fact-qnty ), 2 ).
     8528                           run wp-xmltagput( 8, "exciseb",    string( abs( buf_sale_ot-supp-line.excise-base      ) / buf_sale_ot-supp-line.fact-qnty  * temp_cost_cli_ot-supp-line.fact-qnty ), 2 ).
     8529                           run wp-xmltagclose( 7, "sale" ).
     8530                       end.
     8531                       run wp-xmltagclose( 6,  "firm" ).
     8532                   end.
     8533                   run wp-xmltagclose( 5, string( temp_cost_cat-id_ot-supp-line.cat-id ) ).
     8534               end.
     8535               run wp-xmltagclose( 4, "paySum" ).
     8536           end.
     8537       end.
     8538       else do:
     8539       end.
     8540       run wp-xmltagclose( 3, "linedoc" ).
     8541   end.
     8542   end procedure.
     8543   procedure export-before-and-after-inv-trn :
     8544   do
     8545   on error undo, return error
     8546   :
     8547   define input parameter p-doc-code       as character    no-undo.
     8548   define output parameter p-exists-before as logical      no-undo.
     8549   define output parameter p-exists-after  as logical      no-undo.
     8550       define variable v-attr-value    as character     no-undo.
     8551       define variable v-attr-type     as character     no-undo.
     8552       define buffer buf_trn-doc-sum       for ub.trn-doc-sum.
     8553   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
     8554                           input 'addsum':U ,
     8555                          output v-attr-value ,
     8556                          output v-attr-type ) no-error .
     8557       if lookup( 'bd':U, v-attr-value ) <> 0
     8558       then do:
     8559           assign
     8560               p-exists-before = yes
     8561           .
     8562           find first buf_trn-doc-sum no-lock
     8563                where buf_trn-doc-sum.doc-code = p-doc-code
     8564                  and buf_trn-doc-sum.sum-type = 'bd':U
     8565           no-error.
     8566           if available buf_trn-doc-sum
     8567           then do:
     8568               if v-bge-xml-bgefmt = "dbf":U
     8569               then do:
     8570                   run set-dbf-out-file-name in this-procedure (
     8571                         input "hbiv":U
     8572                       , input p-doc-code
     8573                   ).
     8574               end.
     8575               run wp-xmltagopen( input 3, input "beforeSum", input "" ).
     8576               run wp-xmltagput( input 4, input "qnty", input string( buf_trn-doc-sum.fact-qnty ) , 2 ).
     8577                   run wp-xmltagopen( input 4, input "saleSum", input "" ).
     8578                       run wp-xmltagput( input 5, input "sumr",        input string( buf_trn-doc-sum.crsa-sum-rubl       ), input 1 ).
     8579                       run wp-xmltagput( input 5, input "VATr",        input string( buf_trn-doc-sum.crsa-vat-rubl       ), input 2 ).
     8580                       run wp-xmltagput( input 5, input "SLTr",        input string( buf_trn-doc-sum.crsa-slt-rubl       ), input 2 ).
     8581                       run wp-xmltagput( input 5, input "roadTaxr",    input string( buf_trn-doc-sum.crsa-road-tax-rubl  ), input 2 ).
     8582                       run wp-xmltagput( input 5, input "transportr",  input string( buf_trn-doc-sum.crsa-transport-rubl ), input 2 ).
     8583                       run wp-xmltagput( input 5, input "otherr",      input string( buf_trn-doc-sum.crsa-other-rubl     ), input 2 ).
     8584                       run wp-xmltagput( input 5, input "exciser",     input string( buf_trn-doc-sum.crsa-excise-rubl    ), input 2 ).
     8585                       run wp-xmltagput( input 5, input "sumb",        input string( buf_trn-doc-sum.crsa-sum-base       ), input 2 ).
     8586                       run wp-xmltagput( input 5, input "VATb",        input string( buf_trn-doc-sum.crsa-vat-base       ), input 2 ).
     8587                       run wp-xmltagput( input 5, input "SLTb",        input string( buf_trn-doc-sum.crsa-slt-base       ), input 2 ).
     8588                       run wp-xmltagput( input 5, input "roadTaxb",    input string( buf_trn-doc-sum.crsa-road-tax-base  ), input 2 ).
     8589                       run wp-xmltagput( input 5, input "transportb",  input string( buf_trn-doc-sum.crsa-transport-base ), input 2 ).
     8590                       run wp-xmltagput( input 5, input "otherb",      input string( buf_trn-doc-sum.crsa-other-base     ), input 2 ).
     8591                       run wp-xmltagput( input 5, input "exciseb",     input string( buf_trn-doc-sum.crsa-excise-base    ), input 2 ).
     8592                   run wp-xmltagclose( input 4, input "saleSum" ).
     8593                   run wp-xmltagopen( input 4, input "costSum", input "" ).
     8594                       run wp-xmltagput( input 5, input "sumr",        input string( buf_trn-doc-sum.cost-sum-rubl       ), input 1 ).
     8595                       run wp-xmltagput( input 5, input "VATr",        input string( buf_trn-doc-sum.cost-vat-rubl       ), input 2 ).
     8596                       run wp-xmltagput( input 5, input "SLTr",        input string( buf_trn-doc-sum.cost-slt-rubl       ), input 2 ).
     8597                       run wp-xmltagput( input 5, input "roadTaxr",    input string( buf_trn-doc-sum.cost-road-tax-rubl  ), input 2 ).
     8598                       run wp-xmltagput( input 5, input "transportr",  input string( buf_trn-doc-sum.cost-transport-rubl ), input 2 ).
     8599                       run wp-xmltagput( input 5, input "otherr",      input string( buf_trn-doc-sum.cost-other-rubl     ), input 2 ).
     8600                       run wp-xmltagput( input 5, input "exciser",     input string( buf_trn-doc-sum.cost-excise-rubl    ), input 2 ).
     8601                       run wp-xmltagput( input 5, input "sumb",        input string( buf_trn-doc-sum.cost-sum-base       ), input 2 ).
     8602                       run wp-xmltagput( input 5, input "VATb",        input string( buf_trn-doc-sum.cost-vat-base       ), input 2 ).
     8603                       run wp-xmltagput( input 5, input "SLTb",        input string( buf_trn-doc-sum.cost-slt-base       ), input 2 ).
     8604                       run wp-xmltagput( input 5, input "roadTaxb",    input string( buf_trn-doc-sum.cost-road-tax-base  ), input 2 ).
     8605                       run wp-xmltagput( input 5, input "transportb",  input string( buf_trn-doc-sum.cost-transport-base ), input 2 ).
     8606                       run wp-xmltagput( input 5, input "otherb",      input string( buf_trn-doc-sum.cost-other-base     ), input 2 ).
     8607                       run wp-xmltagput( input 5, input "exciseb",     input string( buf_trn-doc-sum.cost-excise-base    ), input 2 ).
     8608                   run wp-xmltagclose( input 4, input "costSum" ).
     8609               run wp-xmltagclose( input 3, input "beforeSum" ).
     8610           end.
     8611           else do:
     8612               run wp-XMLWriteLog( input v-bge-xml-log-file-name, input 1, input "*** ERR *** Не найдена запись trn-doc-sum с sum-type = 'bd':U для документа " + string( p-doc-code ) ).
     8613           end.
     8614       end.
     8615       if lookup( 'ad':U, v-attr-value ) <> 0
     8616       then do:
     8617           assign
     8618               p-exists-after  = yes
     8619           .
     8620           find first buf_trn-doc-sum no-lock
     8621                where buf_trn-doc-sum.doc-code = p-doc-code
     8622                  and buf_trn-doc-sum.sum-type = 'ad':U
     8623           no-error.
     8624           if available buf_trn-doc-sum
     8625           then do:
     8626               if v-bge-xml-bgefmt = "dbf":U
     8627               then do:
     8628                   run set-dbf-out-file-name in this-procedure (
     8629                         input "haiv":U
     8630                       , input p-doc-code
     8631                   ).
     8632               end.
     8633               run wp-xmltagopen( input 3, input "afterSum", input "" ).
     8634               run wp-xmltagput( input 4, input "qnty", input string( buf_trn-doc-sum.fact-qnty ), input 2 ).
     8635                   run wp-xmltagopen( input 4, input "saleSum", input "" ).
     8636                       run wp-xmltagput( input 5, input "sumr",        input string( buf_trn-doc-sum.crsa-sum-rubl       ), input 1 ).
     8637                       run wp-xmltagput( input 5, input "VATr",        input string( buf_trn-doc-sum.crsa-vat-rubl       ), input 2 ).
     8638                       run wp-xmltagput( input 5, input "SLTr",        input string( buf_trn-doc-sum.crsa-slt-rubl       ), input 2 ).
     8639                       run wp-xmltagput( input 5, input "roadTaxr",    input string( buf_trn-doc-sum.crsa-road-tax-rubl  ), input 2 ).
     8640                       run wp-xmltagput( input 5, input "transportr",  input string( buf_trn-doc-sum.crsa-transport-rubl ), input 2 ).
     8641                       run wp-xmltagput( input 5, input "otherr",      input string( buf_trn-doc-sum.crsa-other-rubl     ), input 2 ).
     8642                       run wp-xmltagput( input 5, input "exciser",     input string( buf_trn-doc-sum.crsa-excise-rubl    ), input 2 ).
     8643                       run wp-xmltagput( input 5, input "sumb",        input string( buf_trn-doc-sum.crsa-sum-base       ), input 2 ).
     8644                       run wp-xmltagput( input 5, input "VATb",        input string( buf_trn-doc-sum.crsa-vat-base       ), input 2 ).
     8645                       run wp-xmltagput( input 5, input "SLTb",        input string( buf_trn-doc-sum.crsa-slt-base       ), input 2 ).
     8646                       run wp-xmltagput( input 5, input "roadTaxb",    input string( buf_trn-doc-sum.crsa-road-tax-base  ), input 2 ).
     8647                       run wp-xmltagput( input 5, input "transportb",  input string( buf_trn-doc-sum.crsa-transport-base ), input 2 ).
     8648                       run wp-xmltagput( input 5, input "otherb",      input string( buf_trn-doc-sum.crsa-other-base     ), input 2 ).
     8649                       run wp-xmltagput( input 5, input "exciseb",     input string( buf_trn-doc-sum.crsa-excise-base    ), input 2 ).
     8650                   run wp-xmltagclose( input 4, input "saleSum" ).
     8651                   run wp-xmltagopen( input 4, input "costSum", input "" ).
     8652                       run wp-xmltagput( input 5, input "sumr",        input string( buf_trn-doc-sum.cost-sum-rubl       ), input 1 ).
     8653                       run wp-xmltagput( input 5, input "VATr",        input string( buf_trn-doc-sum.cost-vat-rubl       ), input 2 ).
     8654                       run wp-xmltagput( input 5, input "SLTr",        input string( buf_trn-doc-sum.cost-slt-rubl       ), input 2 ).
     8655                       run wp-xmltagput( input 5, input "roadTaxr",    input string( buf_trn-doc-sum.cost-road-tax-rubl  ), input 2 ).
     8656                       run wp-xmltagput( input 5, input "transportr",  input string( buf_trn-doc-sum.cost-transport-rubl ), input 2 ).
     8657                       run wp-xmltagput( input 5, input "otherr",      input string( buf_trn-doc-sum.cost-other-rubl     ), input 2 ).
     8658                       run wp-xmltagput( input 5, input "exciser",     input string( buf_trn-doc-sum.cost-excise-rubl    ), input 2 ).
     8659                       run wp-xmltagput( input 5, input "sumb",        input string( buf_trn-doc-sum.cost-sum-base       ), input 2 ).
     8660                       run wp-xmltagput( input 5, input "VATb",        input string( buf_trn-doc-sum.cost-vat-base       ), input 2 ).
     8661                       run wp-xmltagput( input 5, input "SLTb",        input string( buf_trn-doc-sum.cost-slt-base       ), input 2 ).
     8662                       run wp-xmltagput( input 5, input "roadTaxb",    input string( buf_trn-doc-sum.cost-road-tax-base  ), input 2 ).
     8663                       run wp-xmltagput( input 5, input "transportb",  input string( buf_trn-doc-sum.cost-transport-base ), input 2 ).
     8664                       run wp-xmltagput( input 5, input "otherb",      input string( buf_trn-doc-sum.cost-other-base     ), input 2 ).
     8665                       run wp-xmltagput( input 5, input "exciseb",     input string( buf_trn-doc-sum.cost-excise-base    ), input 2 ).
     8666                   run wp-xmltagclose( input 4, input "costSum" ).
     8667               run wp-xmltagclose( input 3, input "afterSum" ).
     8668           end.
     8669           else do:
     8670               run wp-XMLWriteLog( input v-bge-xml-log-file-name, input 1, input "*** ERR *** Не найдена запись trn-doc-sum с sum-type = 'ad':U для документа " + string( p-doc-code ) ).
     8671           end.
     8672       end.
     8673   end.
     8674   end procedure.
     8675   procedure export-before-and-after-inv-line :
     8676   do
     8677   on error undo, return error
     8678   :
     8679   define input parameter p-doc-code           as character        no-undo.
     8680   define input parameter p-artic              as character        no-undo.
     8681   define input parameter p-gds-code           as integer          no-undo.
     8682   define input parameter p-exists-before      as logical          no-undo.
     8683   define input parameter p-exists-after       as logical          no-undo.
     8684   define input parameter p-need-petrol-weight as logical          no-undo.
     8685       define buffer buf_doc-line-sum  for ub.doc-line-sum.
     8686       define buffer buf_inv-line      for ub.inv-line.
     8687       define buffer buf_goods         for ub.goods.
     8688       if p-need-petrol-weight = yes
     8689       then do:
     8690           find first buf_goods no-lock
     8691                where buf_goods.gds-code = p-gds-code
     8692           no-error.
     8693           if available buf_goods
     8694           then do:
     8695               find first buf_inv-line no-lock
     8696                    where buf_inv-line.doc-code   = p-doc-code
     8697                      and buf_inv-line.artic      = buf_goods.artic
     8698                      and buf_inv-line.prod-type  = buf_goods.prod-type
     8699                      and buf_inv-line.prod-code  = buf_goods.prod-code
     8700               no-error.
     8701               if available buf_inv-line
     8702               then do:
     8703                   run wp-xmltagput( input 3, input "petrolWeightBefore", input string( buf_inv-line.before-cli-qnty ), input 0 ).
     8704               end.
     8705           end.
     8706       end.
     8707       if p-exists-before = yes
     8708       then do:
     8709           find first buf_doc-line-sum no-lock
     8710                where buf_doc-line-sum.doc-code = p-doc-code
     8711                  and buf_doc-line-sum.gds-code = p-gds-code
     8712                  and buf_doc-line-sum.sum-type = 'bd':U
     8713           no-error.
     8714           if available buf_doc-line-sum
     8715           then do:
     8716               if v-bge-xml-bgefmt = "dbf":U
     8717               then do:
     8718                   run set-dbf-out-file-name in this-procedure (
     8719                         input substitute( "lbiv&1_":U, p-artic )
     8720                       , input p-doc-code
     8721                   ).
     8722               end.
     8723               run wp-xmltagput( input 3, input "quantityBefore", input string( buf_doc-line-sum.fact-qnty ), input 2 ).
     8724               run wp-xmltagopen( input 3, input "beforeSum", input "" ).
     8725               run wp-xmltagput( input 4, input "qnty", input string( buf_doc-line-sum.fact-qnty ), input 2 ).
     8726                   run wp-xmltagopen( input 4, input "saleSum", input "" ).
     8727                       run wp-xmltagput( input 5, input "sumr",        input string( buf_doc-line-sum.crsa-sum-rubl       ), input 1 ).
     8728                       run wp-xmltagput( input 5, input "VATr",        input string( buf_doc-line-sum.crsa-vat-rubl       ), input 2 ).
     8729                       run wp-xmltagput( input 5, input "SLTr",        input string( buf_doc-line-sum.crsa-slt-rubl       ), input 2 ).
     8730                       run wp-xmltagput( input 5, input "roadTaxr",    input string( buf_doc-line-sum.crsa-road-tax-rubl  ), input 2 ).
     8731                       run wp-xmltagput( input 5, input "transportr",  input string( buf_doc-line-sum.crsa-transport-rubl ), input 2 ).
     8732                       run wp-xmltagput( input 5, input "otherr",      input string( buf_doc-line-sum.crsa-other-rubl     ), input 2 ).
     8733                       run wp-xmltagput( input 5, input "exciser",     input string( buf_doc-line-sum.crsa-excise-rubl    ), input 2 ).
     8734                       run wp-xmltagput( input 5, input "sumb",        input string( buf_doc-line-sum.crsa-sum-base       ), input 2 ).
     8735                       run wp-xmltagput( input 5, input "VATb",        input string( buf_doc-line-sum.crsa-vat-base       ), input 2 ).
     8736                       run wp-xmltagput( input 5, input "SLTb",        input string( buf_doc-line-sum.crsa-slt-base       ), input 2 ).
     8737                       run wp-xmltagput( input 5, input "roadTaxb",    input string( buf_doc-line-sum.crsa-road-tax-base  ), input 2 ).
     8738                       run wp-xmltagput( input 5, input "transportb",  input string( buf_doc-line-sum.crsa-transport-base ), input 2 ).
     8739                       run wp-xmltagput( input 5, input "otherb",      input string( buf_doc-line-sum.crsa-other-base     ), input 2 ).
     8740                       run wp-xmltagput( input 5, input "exciseb",     input string( buf_doc-line-sum.crsa-excise-base    ), input 2 ).
     8741                   run wp-xmltagclose( input 4, input "saleSum" ).
     8742                   run wp-xmltagopen( input 4, input "costSum", input "" ).
     8743                       run wp-xmltagput( input 5, input "sumr",        input string( buf_doc-line-sum.cost-sum-rubl       ), input 1 ).
     8744                       run wp-xmltagput( input 5, input "VATr",        input string( buf_doc-line-sum.cost-vat-rubl       ), input 2 ).
     8745                       run wp-xmltagput( input 5, input "SLTr",        input string( buf_doc-line-sum.cost-slt-rubl       ), input 2 ).
     8746                       run wp-xmltagput( input 5, input "roadTaxr",    input string( buf_doc-line-sum.cost-road-tax-rubl  ), input 2 ).
     8747                       run wp-xmltagput( input 5, input "transportr",  input string( buf_doc-line-sum.cost-transport-rubl ), input 2 ).
     8748                       run wp-xmltagput( input 5, input "otherr",      input string( buf_doc-line-sum.cost-other-rubl     ), input 2 ).
     8749                       run wp-xmltagput( input 5, input "exciser",     input string( buf_doc-line-sum.cost-excise-rubl    ), input 2 ).
     8750                       run wp-xmltagput( input 5, input "sumb",        input string( buf_doc-line-sum.cost-sum-base       ), input 2 ).
     8751                       run wp-xmltagput( input 5, input "VATb",        input string( buf_doc-line-sum.cost-vat-base       ), input 2 ).
     8752                       run wp-xmltagput( input 5, input "SLTb",        input string( buf_doc-line-sum.cost-slt-base       ), input 2 ).
     8753                       run wp-xmltagput( input 5, input "roadTaxb",    input string( buf_doc-line-sum.cost-road-tax-base  ), input 2 ).
     8754                       run wp-xmltagput( input 5, input "transportb",  input string( buf_doc-line-sum.cost-transport-base ), input 2 ).
     8755                       run wp-xmltagput( input 5, input "otherb",      input string( buf_doc-line-sum.cost-other-base     ), input 2 ).
     8756                       run wp-xmltagput( input 5, input "exciseb",     input string( buf_doc-line-sum.cost-excise-base    ), input 2 ).
     8757                   run wp-xmltagclose( input 4, input "costSum" ).
     8758               run wp-xmltagclose( input 3, input "beforeSum" ).
     8759           end.
     8760           else do:
     8761               run wp-XMLWriteLog( input v-bge-xml-log-file-name, input 1, input "*** ERR *** Не найдена запись doc-line-sum с sum-type = 'bd':U для документа " + string( p-doc-code ) ).
     8762           end.
     8763       end.
     8764       if available buf_inv-line
     8765       then do:
     8766           run wp-xmltagput( input 3, input "petrolWeightAfter",  input string( buf_inv-line.after-cli-qnty  ), input 0 ).
     8767       end.
     8768       if p-exists-after = yes
     8769       then do:
     8770           find first buf_doc-line-sum no-lock
     8771                where buf_doc-line-sum.doc-code = p-doc-code
     8772                  and buf_doc-line-sum.gds-code = p-gds-code
     8773                  and buf_doc-line-sum.sum-type = 'ad':U
     8774           no-error.
     8775           if available buf_doc-line-sum
     8776           then do:
     8777               if v-bge-xml-bgefmt = "dbf":U
     8778               then do:
     8779                   run set-dbf-out-file-name in this-procedure (
     8780                         input substitute( "laiv&1_":U, p-artic )
     8781                       , input p-doc-code
     8782                   ).
     8783               end.
     8784               run wp-xmltagput( input 3, input "quantityAfter", input string( buf_doc-line-sum.fact-qnty ), input 2 ).
     8785               run wp-xmltagopen( input 3, input "afterSum", input "" ).
     8786               run wp-xmltagput( input 4, input "qnty", input string( buf_doc-line-sum.fact-qnty ), input 2 ).
     8787                   run wp-xmltagopen( input 4, input "saleSum", input "" ).
     8788                       run wp-xmltagput( input 5, input "sumr",        input string( buf_doc-line-sum.crsa-sum-rubl       ), input 1 ).
     8789                       run wp-xmltagput( input 5, input "VATr",        input string( buf_doc-line-sum.crsa-vat-rubl       ), input 2 ).
     8790                       run wp-xmltagput( input 5, input "SLTr",        input string( buf_doc-line-sum.crsa-slt-rubl       ), input 2 ).
     8791                       run wp-xmltagput( input 5, input "roadTaxr",    input string( buf_doc-line-sum.crsa-road-tax-rubl  ), input 2 ).
     8792                       run wp-xmltagput( input 5, input "transportr",  input string( buf_doc-line-sum.crsa-transport-rubl ), input 2 ).
     8793                       run wp-xmltagput( input 5, input "otherr",      input string( buf_doc-line-sum.crsa-other-rubl     ), input 2 ).
     8794                       run wp-xmltagput( input 5, input "exciser",     input string( buf_doc-line-sum.crsa-excise-rubl    ), input 2 ).
     8795                       run wp-xmltagput( input 5, input "sumb",        input string( buf_doc-line-sum.crsa-sum-base       ), input 2 ).
     8796                       run wp-xmltagput( input 5, input "VATb",        input string( buf_doc-line-sum.crsa-vat-base       ), input 2 ).
     8797                       run wp-xmltagput( input 5, input "SLTb",        input string( buf_doc-line-sum.crsa-slt-base       ), input 2 ).
     8798                       run wp-xmltagput( input 5, input "roadTaxb",    input string( buf_doc-line-sum.crsa-road-tax-base  ), input 2 ).
     8799                       run wp-xmltagput( input 5, input "transportb",  input string( buf_doc-line-sum.crsa-transport-base ), input 2 ).
     8800                       run wp-xmltagput( input 5, input "otherb",      input string( buf_doc-line-sum.crsa-other-base     ), input 2 ).
     8801                       run wp-xmltagput( input 5, input "exciseb",     input string( buf_doc-line-sum.crsa-excise-base    ), input 2 ).
     8802                   run wp-xmltagclose( input 4, input "saleSum" ).
     8803                   run wp-xmltagopen( input 4, input "costSum", input "" ).
     8804                       run wp-xmltagput( input 5, input "sumr",        input string( buf_doc-line-sum.cost-sum-rubl       ), input 1 ).
     8805                       run wp-xmltagput( input 5, input "VATr",        input string( buf_doc-line-sum.cost-vat-rubl       ), input 2 ).
     8806                       run wp-xmltagput( input 5, input "SLTr",        input string( buf_doc-line-sum.cost-slt-rubl       ), input 2 ).
     8807                       run wp-xmltagput( input 5, input "roadTaxr",    input string( buf_doc-line-sum.cost-road-tax-rubl  ), input 2 ).
     8808                       run wp-xmltagput( input 5, input "transportr",  input string( buf_doc-line-sum.cost-transport-rubl ), input 2 ).
     8809                       run wp-xmltagput( input 5, input "otherr",      input string( buf_doc-line-sum.cost-other-rubl     ), input 2 ).
     8810                       run wp-xmltagput( input 5, input "exciser",     input string( buf_doc-line-sum.cost-excise-rubl    ), input 2 ).
     8811                       run wp-xmltagput( input 5, input "sumb",        input string( buf_doc-line-sum.cost-sum-base       ), input 2 ).
     8812                       run wp-xmltagput( input 5, input "VATb",        input string( buf_doc-line-sum.cost-vat-base       ), input 2 ).
     8813                       run wp-xmltagput( input 5, input "SLTb",        input string( buf_doc-line-sum.cost-slt-base       ), input 2 ).
     8814                       run wp-xmltagput( input 5, input "roadTaxb",    input string( buf_doc-line-sum.cost-road-tax-base  ), input 2 ).
     8815                       run wp-xmltagput( input 5, input "transportb",  input string( buf_doc-line-sum.cost-transport-base ), input 2 ).
     8816                       run wp-xmltagput( input 5, input "otherb",      input string( buf_doc-line-sum.cost-other-base     ), input 2 ).
     8817                       run wp-xmltagput( input 5, input "exciseb",     input string( buf_doc-line-sum.cost-excise-base    ), input 2 ).
     8818                   run wp-xmltagclose( input 4, input "costSum" ).
     8819               run wp-xmltagclose( input 3, input "afterSum" ).
     8820           end.
     8821           else do:
     8822               run wp-XMLWriteLog( input v-bge-xml-log-file-name, input 1, input "*** ERR *** Не найдена запись doc-line-sum с sum-type = 'ad':U для документа " + string( p-doc-code ) ).
     8823           end.
     8824       end.
     8825   end.
     8826   end procedure.
     8827   procedure get-petrol-weight :
     8828   define input parameter p-ext-doc-type           as character    no-undo.
     8829   define input parameter p-doc-line-recid         as recid        no-undo.
     8830   define input parameter p-trn-doc-out-code       as character    no-undo.
     8831   define output parameter p-petrol-weight         as decimal      no-undo.
     8832   define output parameter p-weight-not-specified  as logical      no-undo.
     8833       define variable v-rvs-code              as character     no-undo.
     8834       define variable v-found-last-rvs-doc    as logical       no-undo.
     8835       define buffer buf_doc-line      for ub.doc-line.
     8836       define buffer buf_rvs-doc       for ub.rvs-doc.
     8837       define buffer buf_rvs-line      for ub.rvs-line.
     8838       define buffer buf_goods         for ub.goods.
     8839       define buffer buf_doc-pl        for ub.doc-pl.
     8840       define buffer buf_inv-line      for ub.inv-line.
     8841   do
     8842   for buf_doc-line
     8843     , buf_rvs-doc
     8844     , buf_rvs-line
     8845     , buf_goods
     8846     , buf_doc-pl
     8847     , buf_inv-line
     8848   on error undo, return error
     8849   :
     8850       find first buf_doc-line no-lock
     8851           where recid( buf_doc-line ) = p-doc-line-recid
     8852       .
     8853       find first buf_goods no-lock
     8854            where buf_goods.artic      = buf_doc-line.artic
     8855              and buf_goods.prod-type  = buf_doc-line.prod-type
     8856              and buf_goods.prod-code  = buf_doc-line.prod-code
     8857       .
     8858       assign
     8859           p-weight-not-specified = yes
     8860       .
     8861       find first buf_inv-line no-lock
     8862            where buf_inv-line.doc-code    = buf_doc-line.doc-code
     8863              and buf_inv-line.artic       = buf_doc-line.artic
     8864              and buf_inv-line.prod-type   = buf_doc-line.prod-type
     8865              and buf_inv-line.prod-code   = buf_doc-line.prod-code
     8866       no-error.
     8867       if available buf_inv-line
     8868       then do:
     8869           case p-ext-doc-type:
     8870               when 'ie':U
     8871               or when 're':U
     8872               or when 'we':U
     8873               or when 'ie':U
     8874               or when 'rs':U
     8875               or when 'ep':U
     8876               or when 'es':U
     8877               then do:
     8878                   assign
     8879                       p-petrol-weight        = buf_inv-line.wast-cli-qnty
     8880                       p-weight-not-specified = no
     8881                   .
     8882               end.
     8883               when 'vt':U
     8884               or when 'vp':U
     8885               or when 'ap':U
     8886               or when 'mp':U
     8887               then do:
     8888                   assign
     8889                       p-petrol-weight        = buf_doc-line.cli-qnty
     8890                       p-weight-not-specified = no
     8891                   .
     8892               end.
     8893               otherwise do:
     8894                   assign
     8895                       p-weight-not-specified = yes
     8896                   .
     8897               end.
     8898           end case.
     8899       end.
     8900   end.
     8901   end procedure.
     8902   procedure get-cash-pay :
     8903     do
     8904     on error undo, return error
     8905     :
     8906     define input parameter p-ext-doc-type           as character    no-undo.
     8907     define input parameter p-doc-line-recid         as recid        no-undo.
     8908     define input parameter p-trn-doc-out-code       as character    no-undo.
     8909     define output parameter p-cash-pay-not-specified  as logical      no-undo.
     8910       define buffer buf_doc-line      for ub.doc-line.
     8911       define buffer buf_goods         for ub.goods.
     8912       find first buf_doc-line no-lock
     8913           where recid( buf_doc-line ) = p-doc-line-recid
     8914       .
     8915       find first buf_goods no-lock
     8916            where buf_goods.artic      = buf_doc-line.artic
     8917              and buf_goods.prod-type  = buf_doc-line.prod-type
     8918              and buf_goods.prod-code  = buf_doc-line.prod-code
     8919       .
     8920       assign
     8921           p-cash-pay-not-specified = yes
     8922       .
     8923       case p-ext-doc-type:
     8924           when 'es':U
     8925           then do:
     8926               assign
     8927                   p-cash-pay-not-specified = no
     8928               .
     8929           end.
     8930           when 'rs':U
     8931           then do:
     8932               assign
     8933                   p-cash-pay-not-specified = no
     8934               .
     8935           end.
     8936           otherwise do:
     8937               assign
     8938                   p-cash-pay-not-specified = yes
     8939               .
     8940           end.
     8941         END CASE.
     8942     end.
     8943   end procedure.
     8944   procedure get-inkas-pay-desk :
     8945     define buffer buf_inkas-pay-desk for ub.inkas-pay-desk.
     8946     do
     8947     on error undo, return error
     8948     :
     8949     define input parameter p-inkas-code like ub.inkas.inkas-code no-undo .
     8950     define input parameter p-obj-type   like ub.inkas.obj-type no-undo .
     8951     define input parameter p-obj-code   like ub.inkas.obj-code no-undo .
     8952     define input parameter p-inkas-pay-desk-type like ub.inkas-pay-desk.doc-type no-undo .
     8953       if can-find( first buf_inkas-pay-desk  NO-LOCK WHERE
     8954                          buf_inkas-pay-desk.inkas-code = p-inkas-code ) then.
     8955       else do:
     8956         run trg/inkpdcr.p (
     8957                        p-inkas-code
     8958                       ,p-obj-type
     8959                       ,p-obj-code
     8960         ) no-error .
     8961         if error-status:error then do:
     8962           return error.
     8963         end.
     8964       end.
     8965       for each temp_inkas-pay
     8966       :
     8967           delete temp_inkas-pay.
     8968       end.
     8969       for each buf_inkas-pay-desk no-lock
     8970          where buf_inkas-pay-desk.inkas-code = p-inkas-code
     8971            and buf_inkas-pay-desk.doc-type = p-inkas-pay-desk-type
     8972       break by buf_inkas-pay-desk.pay-code
     8973       on error undo, return error
     8974       :
     8975           if first-of( buf_inkas-pay-desk.pay-code )
     8976           then do:
     8977               create temp_inkas-pay.
     8978               assign
     8979                   temp_inkas-pay.pay-code  = buf_inkas-pay-desk.pay-code
     8980                   temp_inkas-pay.tot-base  = 0
     8981                   temp_inkas-pay.tot-rubl  = 0
     8982                   temp_inkas-pay.tot-sum   = 0
     8983               .
     8984           end.
     8985           assign
     8986               temp_inkas-pay.tot-base  = temp_inkas-pay.tot-base + buf_inkas-pay-desk.tot-base
     8987               temp_inkas-pay.tot-rubl  = temp_inkas-pay.tot-rubl + buf_inkas-pay-desk.tot-rubl
     8988               temp_inkas-pay.tot-sum   = temp_inkas-pay.tot-sum  + buf_inkas-pay-desk.tot-sum
     8989           .
     8990       end.
     8991     end.
     8992   end procedure.
     8993   procedure export-gds-dtl :
     8994   define input parameter p-ext-doc-type   as character        no-undo.
     8995   define input parameter p-doc-code       as character        no-undo.
     8996   define input parameter p-artic          as character        no-undo.
     8997   define input parameter p-prod-type      as character        no-undo.
     8998   define input parameter p-prod-code      as integer          no-undo.
     8999       define variable v-doc-qnty       as decimal       no-undo.
     9000       define variable v-fact-qnty      as decimal       no-undo.
     9001       define variable v-sum-base       as decimal       no-undo.
     9002       define variable v-sum-rubl       as decimal       no-undo.
     9003       define variable v-vat-base       as decimal       no-undo.
     9004       define variable v-vat-rubl       as decimal       no-undo.
     9005       define variable v-slt-base       as decimal       no-undo.
     9006       define variable v-slt-rubl       as decimal       no-undo.
     9007       define variable v-road-tax-base  as decimal       no-undo.
     9008       define variable v-road-tax-rubl  as decimal       no-undo.
     9009       define buffer buf_gds-dtl       for ub.gds-dtl.
     9010       define buffer buf_gds-prt       for ub.gds-prt.
     9011       define buffer buf_trn-doc       for ub.trn-doc.
     9012       define buffer buf_doc-line      for ub.doc-line.
     9013   do
     9014   for buf_gds-dtl
     9015     , buf_gds-prt
     9016     , buf_trn-doc
     9017     , buf_doc-line
     9018   on error undo, return error
     9019   :
     9020       find first buf_trn-doc no-lock
     9021            where buf_trn-doc.doc-code = p-doc-code
     9022       no-error.
     9023       if not available buf_trn-doc
     9024       then do:
     9025           run wp-XMLWriteLog in this-procedure (
     9026                 input v-bge-xml-log-file-name
     9027               , input 1
     9028               , input substitute( "*** ERR *** Выгрузка признаков: не найден документ с номером '&1'"
     9029                                   , p-doc-code
     9030                                 )
     9031           ).
     9032           undo, return error.
     9033       end.
     9034       find first buf_doc-line no-lock
     9035            where buf_doc-line.doc-code    = p-doc-code
     9036              and buf_doc-line.artic       = p-artic
     9037              and buf_doc-line.prod-type   = p-prod-type
     9038              and buf_doc-line.prod-code   = p-prod-code
     9039       no-error.
     9040       if not available buf_doc-line
     9041       then do:
     9042           run wp-XMLWriteLog in this-procedure (
     9043                 input v-bge-xml-log-file-name
     9044               , input 1
     9045               , input substitute( "*** ERR *** Выгрузка признаков: не найдена строка документа с номером '&1' и артикулом товара '&2'"
     9046                                   , p-doc-code
     9047                                   , p-artic
     9048                                 )
     9049           ).
     9050           undo, return error.
     9051       end.
     9052       for each buf_gds-dtl no-lock
     9053          where buf_gds-dtl.prod-type  = p-prod-type
     9054            and buf_gds-dtl.prod-code  = p-prod-code
     9055            and buf_gds-dtl.artic      = p-artic
     9056            and buf_gds-dtl.doc-code   = p-doc-code
     9057       :
     9058           find first buf_gds-prt no-lock
     9059                where buf_gds-prt.node-code = buf_gds-dtl.prt-code
     9060           .
     9061   if buf_trn-doc.ext-doc-type = 'ot':U or
     9062      buf_trn-doc.ext-doc-type = ?                 then do:
     9063     assign
     9064      out-vatp-have-vat-slt = yes.
     9065   end.
     9066   else do:
     9067     find first out-vatp_doc-attr no-lock
     9068       where out-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     9069         and out-vatp_doc-attr.attr-code = 'envd':U
     9070         no-error .
     9071     if not available out-vatp_doc-attr then do:
     9072       assign
     9073         out-vatp-have-vat-slt = yes.
     9074     end.
     9075     else do:
     9076        out-vatp-have-vat-slt = no.
     9077     end.
     9078   end.
     9079   find first out-vatp_goods where out-vatp_goods.artic     = buf_doc-line.artic     and
     9080                                      out-vatp_goods.prod-type = buf_doc-line.prod-type and
     9081                                      out-vatp_goods.prod-code = buf_doc-line.prod-code no-lock.
     9082   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9083   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     9084     (input  buf_doc-line.artic
     9085     ,input  buf_doc-line.prod-type
     9086     ,input  buf_doc-line.prod-code
     9087     ,output varroot-node
     9088     ) no-error .
     9089   if error-status :error then do:
     9090     message
     9091       vss-workfile vss-revision vss-description skip
     9092       "Ошибка при определении корневого признака товара" skip
     9093       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     9094       error-status :get-message(1) skip
     9095       return-value skip
     9096       view-as alert-box error .
     9097     undo, return error .
     9098   end.
     9099   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     9100     (input  varroot-node
     9101     ,input  'empty-scale=request'
     9102     ,output varempty-scale
     9103     ) no-error .
     9104   if error-status :error then do:
     9105     message
     9106       vss-workfile vss-revision vss-description skip
     9107       "Ошибка при определении атрибута признака" skip
     9108       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     9109       "Признак" varroot-node skip
     9110       "Запрашивался атрибут" "empty-scale=request" skip
     9111       error-status :get-message(1) skip
     9112       return-value skip
     9113       view-as alert-box error .
     9114     undo, return error .
     9115   end.
     9116   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     9117   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     9118     (output varoutvprb
     9119     )  .
     9120   if varoutvprb = "base":u then do:
     9121     assign
     9122           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     9123       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1)
     9124     .
     9125   end.
     9126   else do:
     9127     assign
     9128           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     9129       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     9130     .
     9131   end.
     9132   if varoutvprb = "rubl":u then do:
     9133     assign
     9134           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     9135       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1) .
     9136   end.
     9137   else do:
     9138     assign
     9139           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale)
     9140       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * buf_trn-doc.base-rate / buf_trn-doc.base-scale) .
     9141   end.
     9142   assign
     9143     varis-cons-parts-have =  no.
     9144   assign
     9145     varfact-qnty       = 0
     9146     varcons-qnty       = 0
     9147     varprice-base-cons = 0
     9148     varprice-rubl-cons = 0.
     9149   find first out-vatp_doc-line where
     9150              out-vatp_doc-line.doc-code   = buf_trn-doc.doc-code
     9151          and out-vatp_doc-line.artic      = buf_doc-line.artic
     9152          and out-vatp_doc-line.prod-type  = buf_doc-line.prod-type
     9153          and out-vatp_doc-line.prod-code  = buf_doc-line.prod-code no-lock no-error.
     9154   if available out-vatp_doc-line           and
     9155     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
     9156     assign
     9157       varfact-qnty = out-vatp_doc-line.fact-qnty.
     9158   end.
     9159   else do:
     9160     for each out-vatp_parts where out-vatp_parts.out-code   = buf_trn-doc.doc-code
     9161                                  and out-vatp_parts.obj-type   = buf_trn-doc.obj-type
     9162                                  and out-vatp_parts.obj-code   = buf_trn-doc.obj-code
     9163                                  and out-vatp_parts.artic      = buf_doc-line.artic
     9164                                  and out-vatp_parts.prod-type  = buf_doc-line.prod-type
     9165                                  and out-vatp_parts.prod-code  = buf_doc-line.prod-code no-lock :
     9166       if out-vatp_parts.purch-code = 2 then do:
     9167   assign
     9168     price-rubl-with-tax-loco = out-vatp_parts.price-rubl
     9169     price-base-with-tax-loco = out-vatp_parts.price-base
     9170   .
     9171   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     9172   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     9173     (output varinvprbo
     9174     )  .
     9175     if out-vatp_parts.out-code = 'free-zone':U     or
     9176        out-vatp_parts.out-code = 'out-zone':U   or
     9177        out-vatp_parts.doc-type = 'акт':U then do:
     9178       assign
