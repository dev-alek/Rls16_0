       23   define input parameter hCNT              as handle                  no-undo.
       24   define variable vss-revision    as character no-undo init "$Revision: a61e6bb0c7e0, 2871, rls $":U .
       25   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
       26   define variable vss-date        as character no-undo init "$Date: Пн ноя 22 19:49:10 2021 +0300 $":U .
       27   define variable vss-workfile    as character no-undo init "$Workfile: doc-oper.p $":U .
       28   define variable vss-archive     as character no-undo init "$Archive: bge/doc-oper.p $":U .
