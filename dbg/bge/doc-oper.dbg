     1002   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
     1003                                             INPUT iFlagEmpty AS INTEGER).
     1004       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
     1005       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
     1006           DO:
     1007               IF iFlagEmpty = 0                           THEN RETURN "".
     1008               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
     1009               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
     1010               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
     1011               ELSE RETURN "".
     1012           END.
     1013       ELSE DO:
     1014           run xmlchar-encode in this-procedure (
     1015                 input sToPlace
     1016               , output sToPlace
     1017           ).
     1018           ASSIGN
     1019               sToPlace = sParName + '="' + sToPlace + '"'
     1020           .
     1021           RETURN sToPlace.
     1022       END.
     1023   END FUNCTION.
     1024   function bge-xml-date returns character
     1025   ( input p-date as date )
     1026   :
     1027     define variable v-date-str as character no-undo .
     1028     run bge-xml-date-to-str in this-procedure ( input   p-date
     1029                                               , output  v-date-str
     1030                                               ) .
     1031     return v-date-str.
     1032   end function.
     1033   function bge-xml-str-date returns character
     1034   ( input p-date-str as character )
     1035   :
     1036     define variable v-date-str as character no-undo .
     1037     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1038                                                   , output  v-date-str
     1039                                                   ) .
     1040     return v-date-str.
     1041   end function.
     1042   function bge-xml-normalize-dec returns decimal
     1043   ( input p-val as decimal )
     1044   :
     1045     return (if p-val = ? then 0 else p-val) .
     1046   end function.
     1047   PROCEDURE wp-XMLTagOpen:
     1048   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1049   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1050   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1051       define variable v-out-string    as character    no-undo.
     1052   do
     1053   on error undo, return error
     1054   :
     1055       if v-bge-xml-bgefmt = "dbf":U
     1056       then do:
     1057       end.
     1058       else do:
     1059           assign
     1060               v-out-string = substitute( "&1&2<&3&4>"
     1061                                       , chr(10)
     1062                                       , fill( " ":U, 4 * iTagLevel)
     1063                                       , sTagName
     1064                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1065                               )
     1066           .
     1067           put stream stmXMLOut unformatted
     1068               v-out-string
     1069           .
     1070       end.
     1071   end.
     1072   END PROCEDURE.
     1073   PROCEDURE wp-XMLTagPut:
     1074     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1075     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1076     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1077     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1078       define variable v-out-string    as character    no-undo.
     1079   do
     1080   on error undo, return error
     1081   :
     1082       if v-bge-xml-bgefmt = "dbf":U
     1083       then do:
     1084           if v-bge-xml-dbf-file-name <> "":U
     1085           then do:
     1086               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1087               export stream stmXMLOut
     1088                   sTagName
     1089                   sParValue
     1090               .
     1091               output stream stmXMLOut close.
     1092           end.
     1093       end.
     1094       else do:
     1095           IF  iFlagEmpty = 1
     1096           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1097           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1098           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1099           THEN DO:
     1100               run xmlchar-encode in this-procedure (
     1101                   input sParValue
     1102                   , output sParValue
     1103               ).
     1104               assign
     1105                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1106                                               , chr(10)
     1107                                               , FILL(" ", 4 * iTagLevel)
     1108                                               , sTagName
     1109                                               , sParValue
     1110                               )
     1111               .
     1112               PUT STREAM stmXMLOut UNFORMATTED
     1113                   v-out-string
     1114               .
     1115           END.
     1116       end.
     1117   end.
     1118   END PROCEDURE.
     1119   PROCEDURE wp-XMLTagClose:
     1120   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1121   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1122       define variable v-out-string    as character    no-undo.
     1123   do
     1124   on error undo, return error
     1125   :
     1126       if v-bge-xml-bgefmt = "dbf":U
     1127       then do:
     1128       end.
     1129       else do:
     1130           assign
     1131               v-out-string = substitute( "&1&2</&3>"
     1132                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1133                                   , fill( " ", 4 * iTagLevel )
     1134                                   , sTagName
     1135                           )
     1136           .
     1137           PUT STREAM stmXMLOut UNFORMATTED
     1138               v-out-string
     1139           .
     1140       end.
     1141   end.
     1142   END PROCEDURE.
     1143   PROCEDURE wp-XMLWriteLog:
     1144     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1145     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1146     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1147   define variable v-str              as character no-undo .
     1148   define variable v-error-append     as logical   no-undo .
     1149   define variable v-error-append-msg as character no-undo .
     1150   assign
     1151     v-str = chr(10)
     1152             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1153             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1154     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1155     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1156     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1157   .
     1158   run bge/bge-log.p (input v-str) no-error .
     1159   if error-status:error then do:
     1160     assign
     1161       v-error-append     = yes
     1162       v-error-append-msg = return-value
     1163     .
     1164   end.
     1165   run gbl/fileapnd.p
     1166     ( input sFileName
     1167     , input v-str
     1168     , input 10
     1169     ) no-error .
     1170   if error-status:error then do:
     1171     assign
     1172       v-error-append     = yes
     1173       v-error-append-msg = substitute( "&1&2&3"
     1174                                       , v-error-append-msg
     1175                                       , chr(10)
     1176                                       , return-value
     1177                                       )
     1178     .
     1179   end.
     1180   if v-error-append
     1181   then do:
     1182     return error substitute( "&1" , v-error-append-msg ) .
     1183   end.
     1184   END PROCEDURE.
     1185   PROCEDURE wp-XMLWriteEDT:
     1186     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1187     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1188     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1189       if valid-handle ( hEDT )
     1190       then do:
     1191           hEDT :move-to-eof().
     1192           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1193                                           OR sToWrite = "&Line") THEN "" ELSE
     1194                                           cur-time-string-sec() + " ").
     1195           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1196                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1197                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1198           hEDT :insert-string(chr(10)).
     1199       end.
     1200       process events.
     1201       output to 'bgescn.txt' append.
     1202           put unformatted
     1203               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1204                                           OR sToWrite = "&Line") THEN "" ELSE
     1205                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1206               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1207                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1208                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1209           .
     1210       output close.
     1211   END PROCEDURE.
     1212   PROCEDURE wp-XMLShowCNT:
     1213     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1214       if valid-handle( hCNT )
     1215       then do:
     1216           ASSIGN hCNT :VISIBLE = TRUE.
     1217       end.
     1218   END PROCEDURE.
     1219   PROCEDURE wp-XMLHideCNT:
     1220     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1221       if valid-handle( hCNT )
     1222       then do:
     1223           ASSIGN hCNT :VISIBLE = FALSE.
     1224       end.
     1225   END PROCEDURE.
     1226   PROCEDURE wp-XMLWriteCNT:
     1227     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1228     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1229       if valid-handle( hCNT )
     1230       then do:
     1231           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1232       end.
     1233   END PROCEDURE.
     1234   procedure bge-xml-write-header:
     1235   do
     1236   on error undo, return error
     1237   :
     1238   define input parameter p-xml-file-name  as character        no-undo.
     1239   define input parameter p-doc-name       as character        no-undo.
     1240   define input parameter p-version        as character        no-undo.
     1241   define input parameter p-db-num         as integer          no-undo.
     1242   define input parameter p-date-from      as date             no-undo.
     1243   define input parameter p-shift-num-from as integer          no-undo.
     1244   define input parameter p-date-to        as date             no-undo.
     1245   define input parameter p-shift-num-to   as integer          no-undo.
     1246   define input parameter p-obj-list       as character        no-undo.
     1247   define input parameter p-doc-type-list  as character        no-undo.
     1248   define input parameter p-pay-code       as logical          no-undo.
     1249   define input parameter p-cst            as logical          no-undo.
     1250   define input parameter p-parts          as logical          no-undo.
     1251   define input parameter p-chk-pay-code   as logical          no-undo.
     1252   define input parameter p-pay-desk       as logical          no-undo.
     1253   define input parameter p-pay-desk-cards as logical          no-undo.
     1254   define input parameter p-deleted        as logical          no-undo.
     1255   define input parameter p-opened-docs    as logical          no-undo.
     1256   define variable v-out-string    as character    no-undo.
     1257   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1258   assign
     1259       v-out-string = substitute( "&1&2&3"
     1260                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1261                           , chr(10)
     1262                           , "<IBS_Trade_House>":U )
     1263   .
     1264   put stream stmXMLOut unformatted
     1265       v-out-string
     1266   .
     1267   run wp-XMLTagOpen(1, "header","").
     1268   if v-bge-xml-bgeflold = "oracle":u
     1269   then do:
     1270     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1271     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1272     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1273     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1274     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1275   end.
     1276   run wp-XMLTagOpen( 2, "manifest", "").
     1277   run wp-XMLTagOpen( 3, "document", "").
     1278   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1279   run wp-XMLTagput( 4, "description", "", 0).
     1280   run wp-XMLTagput( 4, "version", p-version, 0).
     1281   run wp-XMLTagclose( 3, "document" ).
     1282   run wp-XMLTagclose( 2, "manifest" ).
     1283   run wp-XMLTagclose( 1, "header" ).
     1284   run wp-XMLTagOpen(1, "options","").
     1285   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1286   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1287   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1288   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1289   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1290   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1291   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1292   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1293   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1294   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1295   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1296   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1297   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1298   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1299   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1300   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1301   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1302   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1303   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1304   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1305   run wp-XMLTagClose(1, "options").
     1306   run wp-XMLTagOpen( 1, "body", "" ).
     1307   output stream stmXMLOut close.
     1308   end.
     1309   end procedure.
     1310   procedure xml-bge-write-footer:
     1311   do
     1312   on error undo, return error return-value
     1313   :
     1314   define input parameter p-xml-file-name as character    no-undo.
     1315   define variable v-error-num     as integer           no-undo.
     1316   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1317   run wp-XMLTagClose( 1, "body" ).
     1318   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1319   output stream stmXMLOut close.
     1320   if v-bge-xml-bgeflold = "oracle":u
     1321   then do:
     1322     define variable v-tmp-file-name         as character no-undo .
     1323     define variable v-zip-file-name         as character no-undo .
     1324     define variable v-exch-file-name        as character no-undo .
     1325     define variable v-heap-file-name        as character no-undo .
     1326     define variable v-i                     as integer   no-undo .
     1327     define variable v-file-name             as character no-undo .
     1328     define variable v-arc                   as character no-undo .
     1329     define variable v-str                   as character no-undo .
     1330     define variable v-exch-tmp-file-name    as character no-undo .
     1331     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1332     define variable v-bge-xml-exch-dir      as character no-undo .
     1333     define variable v-bge-xml-heap-dir      as character no-undo .
     1334     define variable v-bge-xml-compress-heap as logical   no-undo .
     1335     define variable v-home-dir              as character no-undo .
     1336     define variable v-os-command            as character no-undo .
     1337     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1338     if v-home-dir = ?
     1339     then do:
     1340       undo, return error substitute( "&1&2&3"
     1341                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1342                                     , chr(10)
     1343                                     , "Обратитесь к администратору.":u
     1344                                     ).
     1345     end.
     1346     assign
     1347       v-home-dir = v-home-dir
     1348     .
     1349     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1350     if error-status :error
     1351     then do:
     1352       undo, return error substitute( "&1&2&3"
     1353                                     , "Неверно задан каталог экспорта.":u
     1354                                     , chr(10)
     1355                                     , "Обратитесь к администратору.":u
     1356                                     ).
     1357     end.
     1358     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1359     if v-bge-xml-exch-dir = ?
     1360     then do:
     1361       undo, return error substitute( "&1&2&3"
     1362                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1363                                     , chr(10)
     1364                                     , "Обратитесь к администратору.":u
     1365                                     ).
     1366     end.
     1367     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1368     if error-status :error
     1369     then do:
     1370       undo, return error substitute( "&1&2&3"
     1371                                     , "Неверно задан каталог экспорта (exch).":u
     1372                                     , chr(10)
     1373                                     , "Обратитесь к администратору.":u
     1374                                     ).
     1375     end.
     1376     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1377     if v-bge-xml-heap-dir = ?
     1378     then do:
     1379       undo, return error substitute( "&1&2&3"
     1380                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1381                                     , chr(10)
     1382                                     , "Обратитесь к администратору.":u
     1383                                     ).
     1384     end.
     1385     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1386     if error-status :error
     1387     then do:
     1388       undo, return error substitute( "&1&2&3"
     1389                                     , "Неверно задан каталог экспорта (heap).":u
     1390                                     , chr(10)
     1391                                     , "Обратитесь к администратору.":u
     1392                                     ).
     1393     end.
     1394     get-key-value section "BGE" key "heap-compress" value v-str.
     1395     assign
     1396       v-i = int(v-str)
     1397     no-error .
     1398     if v-i = ? or v-i = 0
     1399     then do:
     1400       assign
     1401         v-bge-xml-compress-heap = no
     1402       .
     1403     end.
     1404     else do:
     1405       assign
     1406         v-bge-xml-compress-heap = yes
     1407       .
     1408     end.
     1409     assign
     1410       v-arc = search( "exe/7za.exe":u )
     1411     .
     1412     if v-arc = ? or v-arc = ""
     1413     then do:
     1414       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     1415     end.
     1416     assign
     1417       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     1418       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     1419       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     1420       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     1421       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     1422       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     1423       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     1424     .
     1425     run gbl/del-file.p (input v-tmp-file-name) .
     1426     run gbl/del-file.p (input v-zip-file-name) .
     1427     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     1428     if v-error-num > 0
     1429     then do:
     1430         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     1431                                      , p-xml-file-name + "xm1":u
     1432                                      , v-tmp-file-name
     1433                                      , v-error-num
     1434                                      ).
     1435     end.
     1436     assign
     1437       v-os-command     = substitute( "&1 a -tzip &2 &3"
     1438                                    , v-arc
     1439                                    , v-zip-file-name
     1440                                    , v-tmp-file-name
     1441                                    )
     1442     .
     1443     os-command silent value ( v-os-command ) .
     1444     run gbl/del-file.p (input v-heap-file-name) .
     1445     if v-bge-xml-compress-heap = no
     1446     then do:
     1447       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     1448       if v-error-num > 0
     1449       then do:
     1450           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1451                                        , v-tmp-file-name
     1452                                        , v-heap-file-name
     1453                                        , v-error-num
     1454                                        ) .
     1455       end.
     1456     end.
     1457     else do:
     1458       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     1459       if v-error-num > 0
     1460       then do:
     1461           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1462                                        , v-zip-file-name
     1463                                        , v-heap-file-name
     1464                                        , v-error-num
     1465                                        ) .
     1466       end.
     1467     end.
     1468     run gbl/del-file.p (input v-tmp-file-name) .
     1469     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     1470     if error-status :error then do:
     1471       undo, return error substitute( "&1&2&3"
     1472                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     1473                                     , chr(10)
     1474                                     , "Обратитесь к администратору."
     1475                                     ).
     1476     end.
     1477     run gbl/del-file.p (input v-exch-file-name) .
     1478     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     1479     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     1480     if v-error-num > 0
     1481     then do:
     1482       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1483                                     , v-zip-file-name
     1484                                     , v-exch-tmp-file-name
     1485                                     , v-error-num
     1486                                     ) .
     1487     end.
     1488     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     1489     if v-error-num > 0
     1490     then do:
     1491       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1492                                     , v-exch-tmp-file-name
     1493                                     , v-exch-file-name
     1494                                     , v-error-num
     1495                                     ) .
     1496     end.
     1497     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     1498   end.
     1499   else do:
     1500     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1501     if v-error-num > 0
     1502     then do:
     1503       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1504                                     , p-xml-file-name + "xm1"
     1505                                     , p-xml-file-name + "xml"
     1506                                     , v-error-num
     1507                                     ) .
     1508     end.
     1509   end.
     1510   if opsys = "unix"
     1511   then do:
     1512       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1513   end.
     1514   end.
     1515   end procedure.
     1516   procedure xml-bge-filename0:
     1517   define input parameter p-prefix   as character no-undo .
     1518   define input parameter p-name     as character no-undo .
     1519   define input parameter p-shared-process as logical no-undo .
     1520   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     1521   define output parameter p-xml-file-name  as character no-undo .
     1522   // define output parameter p-fullfnamenoext as character no-undo .
     1523   define output parameter p-locked         as logical      no-undo.
     1524   define variable v-fullfnamenoext as character no-undo .
     1525   define variable v-fileext        as character no-undo .
     1526   define variable v-fullfname      as character no-undo .
     1527   define variable v-error-num      as integer   no-undo .
     1528   do
     1529   on error undo, return error
     1530   :
     1531     case v-bge-xml-bgeflold :
     1532       when "old" then do:
     1533         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     1534         v-fileext       = ".xml":U .
     1535         v-fullfname     = v-fullfnamenoext + v-fileext .
     1536         p-xml-file-name = v-fullfname .
     1537         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1538         if v-error-num > 0 then do:
     1539           return error.
     1540         end.
     1541       end.
     1542       when "var" then do:
     1543         case p-prefix :
     1544           when "doc" then do:
     1545             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     1546             v-fileext       = ".xml":U .
     1547             v-fullfname     = v-fullfnamenoext + v-fileext .
     1548             p-xml-file-name = v-fullfname .
     1549           end.
     1550           when "day" then do:
     1551             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     1552             v-fileext       = ".xml":U .
     1553             v-fullfname     = v-fullfnamenoext + v-fileext .
     1554             p-xml-file-name = v-fullfname .
     1555           end.
     1556           otherwise do:
     1557             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1558             v-fileext       = ".xml":U .
     1559             v-fullfname     = v-fullfnamenoext + v-fileext .
     1560             p-xml-file-name = v-fullfname .
     1561           end.
     1562         end case.
     1563         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1564         if v-error-num > 0 then do:
     1565           return error.
     1566         end.
     1567       end.
     1568       when "new" then do:
     1569                   run bge/genfname.p (
     1570                       input p-home-dir
     1571                       , input p-prefix
     1572                       , input ""
     1573                       , input "xml"
     1574                       , input ""
     1575                       , output p-xml-file-name
     1576                   ).
     1577       end.
     1578       when "no-parameter" then do:
     1579         if p-shared-process then do:
     1580                       run bge/genfname.p (
     1581                           input p-home-dir
     1582                           , input "d"
     1583                           , input ""
     1584                           , input "xml"
     1585                           , input ""
     1586                           , output p-xml-file-name
     1587                       ).
     1588         end.
     1589         else do:
     1590           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1591           v-fileext       = ".xml":U .
     1592           v-fullfname     = v-fullfnamenoext + v-fileext .
     1593           p-xml-file-name = v-fullfname .
     1594           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1595           if v-error-num > 0 then do:
     1596             return error.
     1597           end.
     1598         end.
     1599       end.
     1600     end case.
     1601     assign
     1602       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1603       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     1604     .
     1605   end .
     1606   end procedure .
     1607   procedure xml-bge-filename :
     1608   do
     1609   on error undo, return error
     1610   :
     1611   define input parameter p-prefix             as character    no-undo.
     1612   define input parameter p-name               as character    no-undo.
     1613   define input parameter p-shared-process     as logical      no-undo.
     1614   define output parameter p-xml-file-name     as character    no-undo.
     1615   define output parameter p-log-file-name     as character    no-undo.
     1616   define output parameter p-locked            as logical      no-undo.
     1617   define variable v-home-dir          as character no-undo .
     1618   define variable v-error-num         as integer   no-undo .
     1619   define variable v-bge-xml-heap-dir  as character no-undo .
     1620       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1621       if v-home-dir = ?
     1622       then do:
     1623           message
     1624             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1625             skip(1)
     1626             skip "Обратитесь к администратору."
     1627           view-as alert-box error.
     1628           undo, return error .
     1629       end.
     1630       if v-bge-xml-bgeflold <> "oracle"
     1631       then do:
     1632         assign
     1633             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     1634         .
     1635       end.
     1636       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1637       if error-status :error
     1638       then do:
     1639           message
     1640             skip "Неверно задан каталог экспорта."
     1641             skip(1)
     1642             skip "Обратитесь к администратору."
     1643           view-as alert-box error.
     1644           undo, return error .
     1645       end.
     1646       if v-bge-xml-bgefmt = "dbf":U
     1647       then do:
     1648           assign
     1649               p-xml-file-name = v-home-dir
     1650               p-locked        = no
     1651           .
     1652       end.
     1653       else do:
     1654           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     1655             output p-xml-file-name, output p-locked) .
     1656       end.
     1657       if v-bge-xml-bgeflold = "oracle"
     1658       then do:
     1659         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1660         if v-bge-xml-heap-dir = ?
     1661         then do:
     1662           undo, return error substitute( "&1&2&3"
     1663                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1664                                         , chr(10)
     1665                                         , "Обратитесь к администратору.":u
     1666                                         ).
     1667         end.
     1668         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1669         if error-status :error
     1670         then do:
     1671           undo, return error substitute( "&1&2&3"
     1672                                         , "Неверно задан каталог экспорта (heap).":u
     1673                                         , chr(10)
     1674                                         , "Обратитесь к администратору.":u
     1675                                         ).
     1676         end.
     1677         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     1678           assign
     1679             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     1680           .
     1681         end.
     1682         else do:
     1683           assign
     1684             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     1685           .
     1686         end.
     1687       end.
     1688       else do:
     1689         assign
     1690             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     1691         .
     1692       end.
     1693       assign
     1694          v-bge-xml-static-log-file-name = p-log-file-name
     1695       .
     1696   end.
     1697   end procedure.
     1698   procedure bge-xml-read-config :
     1699   do
     1700   on error undo, return error return-value
     1701   :
     1702   define input  parameter p-last-date as date      no-undo .
     1703   define input  parameter p-db-num    as integer   no-undo .
     1704       define variable v-bgeclall      as character     no-undo.
     1705       define variable v-bgedict       as character     no-undo.
     1706       define variable v-bgeshift      as character     no-undo.
     1707       define variable v-par-type      as character     no-undo.
     1708       define variable v-bgeflnm       as character     no-undo.
     1709       define variable v-bgecliiv      as character     no-undo .
     1710       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     1711       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     1712       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     1713       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     1714       define variable v-db-num-str    as character     no-undo .
     1715       define variable v-param-type      as character  no-undo .
     1716       define variable v-value-character as character  no-undo .
     1717       define variable v-value-date      as date       no-undo .
     1718       define variable v-value-decimal   as decimal    no-undo .
     1719       define variable v-value-integer   as integer    no-undo .
     1720       define variable v-value-logical   as logical    no-undo .
     1721       define variable v-tth             as handle      no-undo .
     1722       run adm/shattri.p ( input "get":U
     1723                         , input  '':u
     1724                         , input  0
     1725                         , input  'bge-export':U
     1726                         , input  'bgeclall':U
     1727                         , output v-bgecliiv
     1728                         , output v-value-date
     1729                         , output v-value-decimal
     1730                         , output v-value-integer
     1731                         , output v-value-logical
     1732                         , output v-param-type
     1733                         , input-output table-handle v-tth
     1734                         ) no-error .
     1735       if error-status :error
     1736       then do:
     1737         assign
     1738           v-bge-xml-bgecliiv = no
     1739         .
     1740       end.
     1741       else do:
     1742         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     1743       end.
     1744       delete object v-tth.
     1745       assign
     1746           v-bge-xml-bgeclall = no
     1747           v-bge-xml-bgedict  = no
     1748       .
     1749       run adm/shattri.p ( input "get":U
     1750                         , input  '':u
     1751                         , input  0
     1752                         , input  'bge-export':U
     1753                         , input  'bgeclall':U
     1754                         , output v-value-character
     1755                         , output v-value-date
     1756                         , output v-value-decimal
     1757                         , output v-value-integer
     1758                         , output v-value-logical
     1759                         , output v-param-type
     1760                         , input-output table-handle v-tth
     1761                         ) no-error .
     1762       if error-status :error
     1763       then do:
     1764         assign
     1765           v-bge-xml-bgeclall = no
     1766         .
     1767       end.
     1768       else do:
     1769         assign
     1770           v-bge-xml-bgeclall = v-value-logical
     1771         .
     1772       end.
     1773       delete object v-tth.
     1774       run adm/shattri.p ( input "get":U
     1775                         , input  '':u
     1776                         , input  0
     1777                         , input  'bge-export':U
     1778                         , input  'bgedict':U
     1779                         , output v-value-character
     1780                         , output v-value-date
     1781                         , output v-value-decimal
     1782                         , output v-value-integer
     1783                         , output v-value-logical
     1784                         , output v-param-type
     1785                         , input-output table-handle v-tth
     1786                         ) no-error .
     1787       if error-status :error
     1788       then do:
     1789         assign
     1790           v-bge-xml-bgedict = no
     1791         .
     1792       end.
     1793       else do:
     1794         assign
     1795           v-bge-xml-bgedict = v-value-logical
     1796         .
     1797       end.
     1798       delete object v-tth.
     1799       run adm/shattri.p ( input "get":U
     1800                         , input  '':u
     1801                         , input  0
     1802                         , input  'bge-export':U
     1803                         , input  'bgefmt':U
     1804                         , output v-value-character
     1805                         , output v-value-date
     1806                         , output v-value-decimal
     1807                         , output v-value-integer
     1808                         , output v-value-logical
     1809                         , output v-param-type
     1810                         , input-output table-handle v-tth
     1811                         ) no-error .
     1812       if error-status :error
     1813       then do:
     1814         assign
     1815           v-bge-xml-bgefmt  = "xml":U
     1816         .
     1817       end.
     1818       else do:
     1819         assign
     1820           v-bge-xml-bgefmt  = v-value-character
     1821         .
     1822       end.
     1823       delete object v-tth.
     1824       run adm/shattri.p ( input "get":U
     1825                         , input  '':u
     1826                         , input  0
     1827                         , input  'bge-export':U
     1828                         , input  'bgeshift':U
     1829                         , output v-value-character
     1830                         , output v-value-date
     1831                         , output v-value-decimal
     1832                         , output v-value-integer
     1833                         , output v-value-logical
     1834                         , output v-param-type
     1835                         , input-output table-handle v-tth
     1836                         ) no-error .
     1837       if error-status :error
     1838       then do:
     1839         assign
     1840             v-bge-xml-shift-mode = no
     1841         .
     1842       end.
     1843       else do:
     1844         assign
     1845             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     1846         .
     1847       end.
     1848       delete object v-tth.
     1849       run adm/shattri.p ( input "get":U
     1850                         , input  '':u
     1851                         , input  0
     1852                         , input  'bge-export':U
     1853                         , input  'bgeflold':U
     1854                         , output v-value-character
     1855                         , output v-value-date
     1856                         , output v-value-decimal
     1857                         , output v-value-integer
     1858                         , output v-value-logical
     1859                         , output v-param-type
     1860                         , input-output table-handle v-tth
     1861                         ) no-error .
     1862       if error-status :error
     1863       then do:
     1864         assign
     1865           v-bge-xml-bgeflold = "no-parameter":U
     1866         .
     1867       end.
     1868       else do:
     1869         assign
     1870           v-bge-xml-bgeflold  = v-value-character
     1871         .
     1872       end.
     1873       delete object v-tth.
     1874       assign
     1875         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     1876         v-bge-xml-db-num-str  = v-db-num-str
     1877       .
     1878       if p-last-date <> ?
     1879       then do:
     1880           run adm/shattri.p ( input "get":U
     1881                             , input  '':u
     1882                             , input  0
     1883                             , input  'bge-export':U
     1884                             , input  'bgeflnm':U
     1885                             , output v-value-character
     1886                             , output v-value-date
     1887                             , output v-value-decimal
     1888                             , output v-value-integer
     1889                             , output v-value-logical
     1890                             , output v-param-type
     1891                             , input-output table-handle v-tth
     1892                             ) no-error .
     1893           if error-status :error
     1894           then do:
     1895             assign
     1896               v-bgeflnm = '':U
     1897             .
     1898           end.
     1899           else do:
     1900             assign
     1901               v-bgeflnm = v-value-character
     1902             .
     1903           end.
     1904           delete object v-tth.
     1905           if v-bge-xml-bgeflold = "var"
     1906           then do:
     1907               if v-bgeflnm = ?
     1908               or num-entries( v-bgeflnm ) < 2
     1909               then do:
     1910                   assign
     1911                       v-bge-xml-bgeflold = "new"
     1912                   .
     1913               end.
     1914               else do:
     1915                   assign
     1916                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     1917                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     1918                   .
     1919                   assign
     1920                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     1921                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     1922                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1923                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     1924                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     1925                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     1926                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1927                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     1928                   .
     1929               end.
     1930           end.
     1931       end.
     1932   end.
     1933   end procedure.
     1934   procedure bge-xml-get-ref-filename :
     1935   define input parameter p-in-file-name       as character        no-undo.
     1936   define output parameter p-home-dir          as character        no-undo.
     1937   define output parameter p-out-file-name     as character        no-undo.
     1938   define output parameter p-locked            as logical          no-undo.
     1939       define variable v-counter       as integer      no-undo.
     1940       define variable v-error-level   as integer      no-undo.
     1941   do
     1942   on error undo, return error
     1943   :
     1944       run bge/bge-ini.p (
     1945             input "bge"
     1946           , output p-home-dir
     1947       ).
     1948       if return-value <> "OK"
     1949       then do:
     1950           undo, return error.
     1951       end.
     1952       assign
     1953           p-home-dir = p-home-dir + "\dict":U
     1954       .
     1955       run bge/dir_cd.p (
     1956           input p-home-dir
     1957           , input "CA"
     1958       ).
     1959       if return-value = "ERROR"
     1960       then do:
     1961           undo, return error.
     1962       end.
     1963       assign
     1964           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     1965       .
     1966       assign
     1967           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     1968       .
     1969       wait-lock:
     1970       do v-counter = 1 TO 3
     1971       :
     1972           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     1973           if p-locked = no
     1974           then do:
     1975               leave wait-lock.
     1976           end.
     1977           else do:
     1978               readkey pause 1.
     1979           end.
     1980       END.
     1981       if p-locked = yes
     1982       then do:
     1983           undo, return error.
     1984       end.
     1985       run bge/os_copy.p (
     1986             input "D":U
     1987           , input p-out-file-name + "xml":U
     1988           , input "":U
     1989           , output v-error-level
     1990       ).
     1991       if v-error-level > 0
     1992       then do:
     1993           undo, return error.
     1994       end.
     1995   end.
     1996   end procedure.
     1997   procedure bge-xml-write-ref-header :
     1998   define input parameter p-bge-name as character        no-undo.
     1999   define input parameter p-file-name as character        no-undo.
     2000       define variable v-out-string    as character    no-undo.
     2001   do
     2002   on error undo, return error
     2003   :
     2004       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     2005       put stream stmXMLOut unformatted
     2006           "<?xml version='1.0' encoding='windows-1251'?>":U
     2007       .
     2008       assign
     2009           v-out-string = substitute( "&1&2"
     2010                               , chr(10)
     2011                               , "<IBS_Trade_House>":U )
     2012       .
     2013       put stream stmXMLOut unformatted
     2014           v-out-string
     2015       .
     2016       run wp-XMLTagOpen( 1, "header", "" ).
     2017       if v-bge-xml-bgeflold = "oracle":u
     2018       then do:
     2019         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     2020         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     2021         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     2022         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     2023         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     2024       end.
     2025       else do:
     2026         run wp-XMLTagOpen( 2, "delivery", "" ).
     2027         run wp-XMLTagOpen( 3, "to", "" ).
     2028         run wp-XMLTagClose( 3, "to" ).
     2029         run wp-XMLTagOpen( 3, "from", "" ).
     2030         run wp-XMLTagClose( 3, "from" ).
     2031         run wp-XMLTagClose( 2, "delivery" ).
     2032       end.
     2033       run wp-XMLTagOpen( 2, "manifest", "" ).
     2034       run wp-XMLTagOpen( 3, "document", "" ).
     2035       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2036       run wp-XMLTagPut( 4, "description", "", 0 ).
     2037       run wp-XMLTagClose( 3, "document" ).
     2038       run wp-XMLTagClose( 2, "manifest" ).
     2039       run wp-XMLTagClose( 1, "header" ).
     2040       run wp-XMLTagOpen( 1, "body", "" ).
     2041   end.
     2042   end procedure.
     2043   procedure bge-xml-write-ref-footer :
     2044   define input parameter p-file-name as character        no-undo.
     2045       define variable v-error-level   as integer      no-undo.
     2046   do
     2047   on error undo, return error
     2048   :
     2049       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2050       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2051       output stream stmXMLOut close.
     2052       run bge/os_copy.p (
     2053             input "M":U
     2054           , input p-file-name + "xm1":U
     2055           , input p-file-name + "xml":U
     2056           , output v-error-level
     2057       ).
     2058       if v-error-level > 0
     2059       then do:
     2060           undo, return error.
     2061       end.
     2062   end.
     2063   end procedure.
     2064   procedure bge-xml-out-dir :
     2065   define output parameter p-out-dir       as character    no-undo.
     2066   define output parameter p-log-file-name as character    no-undo.
     2067   do
     2068   on error undo, return error
     2069   :
     2070       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2071       if p-out-dir = ?
     2072       then do:
     2073           message
     2074             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2075                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2076             skip(1)
     2077             skip "Обратитесь к администратору."
     2078           view-as alert-box error.
     2079           undo, return error .
     2080       end.
     2081       if v-bge-xml-bgeflold <> "oracle" then assign
     2082         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2083       .
     2084       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2085       if error-status :error  then do:
     2086           run wp-XMLWriteLog in this-procedure (
     2087                 input p-log-file-name
     2088               , input 0
     2089               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2090                                   , p-out-dir
     2091                                   , return-value
     2092                                   , trim( error-status :get-message( 1 ) )
     2093                                   )
     2094           ).
     2095           undo, return error.
     2096       end.
     2097       assign
     2098           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2099           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2100       .
     2101   end.
     2102   end procedure.
     2103   procedure bge-xml-out-dir2 :
     2104   define output parameter p-out-dir       as character    no-undo.
     2105   define output parameter p-out-dirR      as character    no-undo.
     2106   define output parameter p-log-file-name as character    no-undo.
     2107   do
     2108   on error undo, return error
     2109   :
     2110       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2111       if p-out-dir = ?
     2112       then do:
     2113           message
     2114             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2115                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2116             skip(1)
     2117             skip "Обратитесь к администратору."
     2118           view-as alert-box error.
     2119           undo, return error .
     2120       end.
     2121       if v-bge-xml-bgeflold <> "oracle" then assign
     2122             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2123             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2124         .
     2125       else p-out-dirR = p-out-dir .
     2126       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2127       if error-status :error  then do:
     2128           run wp-XMLWriteLog in this-procedure (
     2129                 input p-log-file-name
     2130               , input 0
     2131               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2132                                   , p-out-dir
     2133                                   , return-value
     2134                                   , error-status :get-message( 1 )
     2135                                   )
     2136           ).
     2137           undo, return error.
     2138       end.
     2139       if p-out-dirR <> p-out-dir then do:
     2140         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2141         if error-status :error then do:
     2142           run wp-XMLWriteLog in this-procedure (
     2143                 input p-log-file-name
     2144               , input 0
     2145               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2146                                   , p-out-dirR
     2147                                   , return-value
     2148                                   , error-status :get-message( 1 )
     2149                                   )
     2150           ).
     2151           p-out-dirR = p-out-dir .
     2152         end.
     2153       end .
     2154       assign
     2155         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2156         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2157       .
     2158   end.
     2159   end procedure.
     2160   procedure bge-xml-out-file :
     2161   do
     2162   on error undo, return error
     2163   :
     2164   define input parameter p-out-dir            as character        no-undo.
     2165   define input parameter p-prefix             as character        no-undo.
     2166   define input parameter p-sheduled           as logical          no-undo.
     2167   define output parameter p-xml-file-name     as character        no-undo.
     2168   define output parameter p-locked            as logical          no-undo.
     2169   define variable v-home-dir      as character     no-undo.
     2170   define variable v-error-num     as integer       no-undo.
     2171   define variable v-today             as date         no-undo.
     2172   define variable v-time              as integer      no-undo.
     2173       if v-bge-xml-bgefmt = "dbf":U
     2174       then do:
     2175           assign
     2176               p-xml-file-name = p-out-dir
     2177               p-locked        = no
     2178           .
     2179       end.
     2180       else do:
     2181           if v-bge-xml-bgeflold = "firm":U
     2182           then do:
     2183               run bge/genfname.p (
     2184                     input p-out-dir
     2185                   , input p-prefix
     2186                   , input "":U
     2187                   , input "arj":U
     2188                   , input "":U
     2189                   , output p-xml-file-name
     2190               ).
     2191           end.
     2192           else do:
     2193               run bge/genfname.p (
     2194                     input p-out-dir
     2195                   , input p-prefix
     2196                   , input "":U
     2197                   , input "xml":U
     2198                   , input "":U
     2199                   , output p-xml-file-name
     2200               ).
     2201           end.
     2202           assign
     2203               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2204               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2205           .
     2206       end.
     2207   end.
     2208   end procedure.
     2209   procedure bge-xml-init-ext-doc-type :
     2210       define variable v-counter    as integer      no-undo.
     2211       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2212   do
     2213   for buf_temp_ext-doc-type
     2214   on error undo, return error
     2215   :
     2216       empty temp-table buf_temp_ext-doc-type.
     2217       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2218       :
     2219           create buf_temp_ext-doc-type.
     2220           assign
     2221               buf_temp_ext-doc-type.edt-key               = v-counter
     2222               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2223               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2224           .
     2225       end.
     2226   end.
     2227   end procedure.
     2228   procedure bge-xml-get-decimal-shift-num :
     2229   define input parameter p-shift-date     as date             no-undo.
     2230   define input parameter p-shift-num      as integer          no-undo.
     2231   define output parameter p-shift-decimal as decimal          no-undo.
     2232   do
     2233   on error undo, return error
     2234   :
     2235       assign
     2236           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2237       .
     2238   end.
     2239   end procedure.
     2240   procedure bge-xml-ora-exp-filename :
     2241     define input  parameter p-table-name  as character no-undo .
     2242     define input  parameter p-doc-code    as character no-undo .
     2243     define input  parameter p-obj-code    as integer   no-undo .
     2244     define output parameter p-filename    as character no-undo .
     2245     define output parameter p-seq-num     as integer   no-undo .
     2246     define variable v-ora-exp-seq     as integer   no-undo .
     2247     define variable v-ora-exp-seq-str as character no-undo .
     2248     define variable v-home-dir        as character no-undo.
     2249   do
     2250   on error undo, return error return-value
     2251   :
     2252     if v-bge-xml-bgeflold = "oracle":u
     2253     then do:
     2254       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2255       if v-home-dir = ?
     2256       then do:
     2257         undo, return error substitute( "&1&2&3":U
     2258                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2259                                       , chr(10)
     2260                                       , "Обратитесь к администратору.":U
     2261                                       ).
     2262       end.
     2263       assign
     2264           v-home-dir = v-home-dir
     2265       .
     2266       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2267       if error-status :error
     2268       then do:
     2269         undo, return error substitute( "&1&2&3":U
     2270                                       , "Неверно задан каталог экспорта.":U
     2271                                       , chr(10)
     2272                                       , "Обратитесь к администратору.":U
     2273                                       ).
     2274       end.
     2275       assign
     2276         v-ora-exp-seq = ?
     2277       .
     2278       if  p-table-name <> ? and
     2279           p-doc-code <> ?
     2280       then do:
     2281         run bge/get-oesq.p ( input p-table-name
     2282                            , input p-doc-code
     2283                            , output v-ora-exp-seq
     2284                            ) no-error .
     2285         if error-status :error = yes
     2286         then do:
     2287           undo, return error return-value .
     2288         end.
     2289       end.
     2290       if v-ora-exp-seq = ?
     2291       then do:
     2292         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2293         if error-status :error
     2294         then do:
     2295           undo, return error return-value .
     2296         end.
     2297       end.
     2298       if p-table-name <> ? and
     2299          p-doc-code   <> ?
     2300       then do:
     2301         run bge/oesqdoc.p ( input p-table-name
     2302                           , input p-doc-code
     2303                           , input v-ora-exp-seq
     2304                           ) no-error .
     2305         if error-status :error = yes
     2306         then do:
     2307           undo, return error return-value .
     2308         end.
     2309       end.
     2310       assign
     2311         p-seq-num  = v-ora-exp-seq
     2312         p-filename = substitute("&1/&2-000_&3."
     2313                                , v-home-dir
     2314                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2315                                , string(v-ora-exp-seq , "999999999")
     2316                                )
     2317       .
     2318     end.
     2319   end.
     2320   end procedure.
     2321   procedure bge-xml-date-to-str :
     2322     define input  parameter p-date  as date      no-undo .
     2323     define output parameter p-str   as character no-undo .
     2324   do
     2325   on error undo, return error return-value
     2326   :
     2327     if p-date <> ?
     2328     then do:
     2329       assign
     2330         p-str = substitute( "&1-&2-&3"
     2331                           , string( year(p-date)  , "9999")
     2332                           , string( month(p-date) , "99"  )
     2333                           , string( day(p-date)   , "99"  )
     2334                           )
     2335       .
     2336     end.
     2337     else do:
     2338       assign
     2339         p-str = ?
     2340       .
     2341     end.
     2342   end.
     2343   end procedure.
     2344   procedure bge-xml-date-str-to-str :
     2345     define input  parameter p-date-str  as character no-undo .
     2346     define output parameter p-str       as character no-undo .
     2347     define variable v-date          as date      no-undo .
     2348     define variable v-date-valid    as logical   no-undo .
     2349     define variable v-error-message as character no-undo .
     2350   do
     2351   on error undo, return error return-value
     2352   :
     2353     assign
     2354       p-str = ?
     2355     .
     2356     if p-date-str = ? or p-date-str = ""
     2357     then do:
     2358       return .
     2359     end.
     2360     run strtdate in this-procedure ( input  p-date-str
     2361                                    , output v-date
     2362                                    , output v-date-valid
     2363                                    , output v-error-message
     2364                                    ).
     2365     if v-date-valid <> true
     2366     then do:
     2367       return .
     2368     end.
     2369     assign
     2370       p-str = substitute( "&1-&2-&3"
     2371                         , string( year(v-date)  , "9999")
     2372                         , string( month(v-date) , "99"  )
     2373                         , string( day(v-date)   , "99"  )
     2374                         )
     2375     .
     2376   end.
     2377   end procedure.
     2378   procedure bge-xml-fill-tt-bgecliiv :
     2379     define input  parameter p-str as character no-undo .
     2380     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2381     define buffer buf_clients             for ub.clients.
     2382     define variable v-i         as integer   no-undo .
     2383     define variable v-count     as integer   no-undo .
     2384     define variable v-cli-count as integer   no-undo .
     2385     define variable v-client    as character no-undo .
     2386     define variable v-obj-type  as character no-undo .
     2387     define variable v-obj-code  as integer   no-undo .
     2388   do
     2389   on error undo, return error return-value
     2390   :
     2391     empty temp-table buf_tt-bge-xml-bgecliiv.
     2392     assign
     2393       v-bge-xml-bgecliiv = no
     2394       v-cli-count        = num-entries(p-str,';')
     2395     .
     2396     if v-cli-count > 0
     2397     then do:
     2398       _cli-cycle:
     2399       do v-i = 1 to v-cli-count
     2400       :
     2401         assign
     2402           v-client = entry(v-i , p-str, ';')
     2403         .
     2404         if num-entries(v-client) <> 2
     2405         then do:
     2406           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2407         end.
     2408         assign
     2409           v-obj-type = entry(1, v-client)
     2410         .
     2411         assign
     2412           v-obj-code = integer(entry(2, v-client))
     2413         no-error .
     2414         if error-status :error
     2415         then do:
     2416           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2417         end.
     2418         find first buf_clients no-lock
     2419           where buf_clients.obj-type = v-obj-type
     2420             and buf_clients.obj-code = v-obj-code
     2421         no-error.
     2422         if not available buf_clients
     2423         then do:
     2424           next _cli-cycle.
     2425         end.
     2426         find first buf_tt-bge-xml-bgecliiv no-lock
     2427           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2428             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2429         no-error .
     2430         if available buf_tt-bge-xml-bgecliiv
     2431         then do:
     2432           next _cli-cycle.
     2433         end.
     2434         create buf_tt-bge-xml-bgecliiv.
     2435         assign
     2436           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2437           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2438         .
     2439       end.
     2440     end.
     2441     else do:
     2442       assign
     2443         v-bge-xml-bgecliiv = no
     2444       .
     2445       return .
     2446     end.
     2447     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     2448     if available buf_tt-bge-xml-bgecliiv
     2449     then do:
     2450       assign
     2451         v-bge-xml-bgecliiv = yes
     2452       .
     2453     end.
     2454   end.
     2455   end procedure.
     2456   procedure bge-xml-resolve-ext-doc-type :
     2457     define input  parameter p-ext-doc-type      as character no-undo .
     2458     define input  parameter p-obj-type          as character no-undo .
     2459     define input  parameter p-obj-code          as integer   no-undo .
     2460     define output parameter p-out-ext-doc-type  as character no-undo .
     2461     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2462   do
     2463   on error undo, return error return-value
     2464   :
     2465     assign
     2466       p-out-ext-doc-type = p-ext-doc-type
     2467     .
     2468     if p-ext-doc-type <> 'ie':U
     2469     then do:
     2470       return .
     2471     end.
     2472     if v-bge-xml-bgecliiv = yes
     2473     then do:
     2474       find first buf_tt-bge-xml-bgecliiv no-lock
     2475         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     2476           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     2477       no-error .
     2478       if available buf_tt-bge-xml-bgecliiv
     2479       then do:
     2480         assign
     2481           p-out-ext-doc-type = 'iv':U
     2482         .
     2483       end.
     2484     end.
     2485   end.
     2486   end procedure.
     2487   procedure safe-wp-xmltagput :
     2488     define input  parameter pTagLevel   as integer   no-undo .
     2489     define input  parameter pTagName    as character no-undo .
     2490     define input  parameter pParValue   as character no-undo .
     2491     define input  parameter pFlagEmpty  as integer   no-undo .
     2492   do
     2493   on error undo, return error return-value
     2494   :
     2495     if v-bge-xml-bgeflold = "oracle":u
     2496     then do:
     2497       return .
     2498     end.
     2499     run wp-xmltagput in this-procedure ( input pTagLevel
     2500                                        , input pTagName
     2501                                        , input pParValue
     2502                                        , input pFlagEmpty
     2503                                        ).
     2504   end.
     2505   end procedure.
