     5939   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5940   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5941   define  shared variable g#auto-pid           as integer   no-undo .
     5942   define  shared variable conn-par             as character no-undo .
     5943   define  shared variable g#auto-user-id       as character no-undo .
     5944   define  shared variable g#auto-user-login    as character no-undo .
     5945   define  shared variable g#auto-user-password as character no-undo .
