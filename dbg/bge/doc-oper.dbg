     9676       if p-ext-doc-type = 'we':U and
     9677           (v-tech-pass or can-find(first ub.sale-doc where ub.sale-doc.doc-code = p-doc-code and ub.sale-doc.doc-kind = 'trf':U))
     9678       then do:
     9679         run safe-wp-xmltagput in this-procedure ( input 3, input "techfuel":U  , input "yes":u, input 1 ).
     9680       end.
     9681       if p-ext-doc-type = 'ie':U and
     9682           (v-tech-pass or can-find(first ub.sale-doc where ub.sale-doc.doc-code = p-doc-code and ub.sale-doc.doc-kind = 'itr':U))
     9683       then do:
     9684         run safe-wp-xmltagput in this-procedure ( input 3, input "techfuel":U  , input "yes":u, input 1 ).
     9685       end.
     9686       if p-ext-doc-type = 'ie':U
     9687       then do:
     9688   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
     9689                           input 'is-lgas-corr':U ,
     9690                          output v-attr-value ,
     9691                          output v-attr-type ) no-error .
     9692         if not error-status:error and v-attr-value = "yes" then do:
     9693           run wp-xmltagput( input 3, input "lgascorr"  ,  input "yes", input 0 ).
     9694         end.
     9695       end.
     9696   end.
     9697   end procedure.
     9698   procedure export-pay-code :
     9699   define input parameter p-doc-code           as character        no-undo.
     9700   define input parameter p-ext-doc-type       as character        no-undo.
     9701   define input parameter p-trn-doc-out-code   as character        no-undo.
     9702   define input parameter p-pay-desk           as logical          no-undo.
     9703   define input parameter p-pay-desk-cards     as logical          no-undo.
     9704   define output parameter p-is-out            as integer          no-undo.
     9705       define variable v-inkas-pay-desk-type    as character    no-undo.
     9706   define buffer buf_sale-doc     for ub.sale-doc.
     9707   do
     9708   for buf_sale-doc
     9709   on error undo, return error
     9710   :
     9711       case p-ext-doc-type :
     9712           when 'es':U
     9713           then do:
     9714               assign
     9715                   p-is-out                = 1
     9716                   v-inkas-pay-desk-type   = 'при':U
     9717               .
     9718               find first buf_sale-doc no-lock
     9719                    where buf_sale-doc.doc-code = p-doc-code
     9720               no-error.
     9721           end.
     9722           when 'rs':U
     9723           then do:
     9724               assign
     9725                   p-is-out                = -1
     9726                   v-inkas-pay-desk-type   = 'рас':U
     9727               .
     9728               find first buf_sale-doc no-lock
     9729                    where buf_sale-doc.doc-code = p-trn-doc-out-code
     9730               no-error.
     9731           end.
     9732       end case.
     9733       if available buf_sale-doc
     9734       then do:
     9735           run bge/bgepych2.p (
     9736                 input buf_sale-doc.inkas-code
     9737               , input p-ext-doc-type
     9738               , input p-pay-desk
     9739               , input p-pay-desk-cards
     9740               , input yes
     9741               , input yes
     9742               , input yes
     9743           )no-error.
     9744                   if ERROR-STATUS:error then do:
     9745                       run wp-XMLWriteLog(
     9746                             sLogFile,
     9747                             1,
     9748                             substitute("&1 (Документ &2)", if return-value <> "" then return-value else error-status:get-message(1), p-doc-code)
     9749                       ).
     9750                       run write-to-log( vss-workfile + chr(32) +
     9751                                       substitute("&1 (Документ &2)", if return-value <> "" then return-value else error-status:get-message(1), p-doc-code)
     9752                                       ) .
     9753                   end.
     9754               run get-inkas-pay-desk in this-procedure (
     9755                     input buf_sale-doc.inkas-code
     9756                   , input buf_sale-doc.obj-type
     9757                   , input buf_sale-doc.obj-code
     9758                   , input v-inkas-pay-desk-type
     9759               ) no-error .
     9760               if error-status:error
     9761               then do:
     9762                   run wp-XMLWriteLog(
     9763                         input v-bge-xml-log-file-name
     9764                       , input 1
     9765                       , input substitute( "*** ERR *** Не удалось рассчитать разбивку по кодам оплат по документу &1. &2. &3. &4", p-doc-code, return-value, trim( error-status :get-message( 1 ) ), trim( error-status :get-message( 2 ) ) )
     9766                   ).
     9767               end.
     9768               if v-bge-xml-bgefmt = "dbf":U
     9769               then do:
     9770                   run set-dbf-out-file-name in this-procedure (
     9771                         input "hcss":U
     9772                       , input p-doc-code
     9773                   ).
     9774               end.
     9775               run wp-xmltagopen( 3, "cassSum","" ).
     9776               for each temp_inkas-pay
     9777               on error undo, return error
     9778               :
     9779                   run wp-xmltagopen( 4, "payCode", "" ).
     9780                   run wp-xmltagput( 5, "code", string( temp_inkas-pay.pay-code            ), 0 ).
     9781                   run wp-xmltagput( 5, "sum",  string( p-is-out * temp_inkas-pay.tot-sum  ), 2 ).
     9782                   run wp-xmltagput( 5, "sumb", string( p-is-out * temp_inkas-pay.tot-base ), 2 ).
     9783                   run wp-xmltagput( 5, "sumr", string( p-is-out * temp_inkas-pay.tot-rubl ), 2 ).
     9784                   run wp-xmltagclose( 4, "payCode" ).
     9785               end.
     9786               run wp-xmltagclose( 3, "cassSum" ).
     9787       end.
     9788       else do:
     9789           if p-ext-doc-type = 'es':U
     9790           or p-ext-doc-type = 'rs':U
     9791           then do:
     9792               run wp-XMLWriteLog(
     9793                     input v-bge-xml-log-file-name
     9794                   , input 1
     9795                   , input substitute( "*** ERR *** Не найден buf_inkas для документа расхода или возврата по кассе &1", p-doc-code )
     9796               ).
     9797           end.
     9798       end.
     9799   end.
     9800   end procedure.
     9801   procedure export-price-doc-ot-tot :
     9802   define input parameter p-doc-code   as character        no-undo.
     9803   define input parameter p-sum-type   as character        no-undo.
     9804   define input parameter p-cat-id     as character        no-undo.
     9805       define buffer buf_ot-tot        for ub.ot-tot.
     9806   do
     9807   for buf_ot-tot
     9808   on error undo, return error
     9809   :
     9810       find first buf_ot-tot no-lock
     9811            where buf_ot-tot.doc-code = p-doc-code
     9812              and buf_ot-tot.sum-type = 'crsa':U
     9813              and buf_ot-tot.cat-id   = p-cat-id
     9814       no-error.
     9815       if not available buf_ot-tot
     9816       then do:
     9817           run wp-XMLWriteLog in this-procedure (
     9818                 input v-bge-xml-log-file-name
     9819               , input 1
     9820               , input substitute( "В архиве не найдена запись документа переоценки &1 c sum-type = &2", p-doc-code, 'crsa':U )
     9821           ).
     9822       end.
     9823       else do:
     9824           if v-bge-xml-bgefmt = "dbf":U
     9825           then do:
     9826               run set-dbf-out-file-name in this-procedure (
     9827                     input "hpss":U
     9828                   , input p-doc-code
     9829               ).
     9830           end.
     9831           run wp-xmltagopen( 3, "saleSum","" ).
     9832           run wp-xmltagput( 4, "sumr"      , string( buf_ot-tot.sum-rubl        ), 1 ).
     9833           run wp-xmltagput( 4, "VATr"      , string( buf_ot-tot.vat-rubl        ), 2 ).
     9834           run wp-xmltagput( 4, "SLTr"      , string( buf_ot-tot.slt-rubl        ), 2 ).
     9835           run wp-xmltagput( 4, "roadTaxr"  , string( buf_ot-tot.road-tax-rubl   ), 2 ).
     9836           run wp-xmltagput( 4, "transportr", string( buf_ot-tot.transport-rubl  ), 2 ).
     9837           run wp-xmltagput( 4, "otherr"    , string( buf_ot-tot.other-rubl      ), 2 ).
     9838           run wp-xmltagput( 4, "exciser"   , string( buf_ot-tot.excise-rubl     ), 2 ).
     9839           run wp-xmltagput( 4, "sumb"      , string( buf_ot-tot.sum-base        ), 2 ).
     9840           run wp-xmltagput( 4, "VATb"      , string( buf_ot-tot.vat-base        ), 2 ).
     9841           run wp-xmltagput( 4, "SLTb"      , string( buf_ot-tot.slt-base        ), 2 ).
     9842           run wp-xmltagput( 4, "roadTaxb"  , string( buf_ot-tot.road-tax-base   ), 2 ).
     9843           run wp-xmltagput( 4, "transportb", string( buf_ot-tot.transport-base  ), 2 ).
     9844           run wp-xmltagput( 4, "otherb"    , string( buf_ot-tot.other-base      ), 2 ).
     9845           run wp-xmltagput( 4, "exciseb"   , string( buf_ot-tot.excise-base     ), 2 ).
     9846           run wp-xmltagclose( 3, "saleSum" ).
     9847       end.
     9848   end.
     9849   end procedure.
     9850   procedure export-trn-doc-ot-tot :
     9851   define input parameter p-doc-code                   as character        no-undo.
     9852   define input parameter p-sum-type                   as character        no-undo.
     9853   define input parameter p-cat-id                     as character        no-undo.
     9854   define input parameter p-fact-qnty                  as decimal          no-undo.
     9855   define input parameter p-ext-doc-type               as character        no-undo.
     9856   define input parameter p-pay-code                   as logical          no-undo.
     9857   define input-output parameter p-ot-tot-sale-exists  as logical          no-undo.
     9858   define input-output parameter p-ot-tot-cost-exists  as logical          no-undo.
     9859   define input-output parameter p-ot-tot-crsa-exists  as logical          no-undo.
     9860   define input parameter        p-is-envd_            as logical          no-undo.
     9861   define input parameter        p-sum-all-parts_      as decimal          no-undo.
     9862       define variable v-ot-tot-sale-exists    as logical      no-undo.
     9863       define variable v-ot-tot-cost-exists    as logical      no-undo.
     9864       define variable v-ot-tot-crsa-exists    as logical      no-undo.
     9865       define buffer buf_ot-tot        for ub.ot-tot.
     9866   do
     9867   for buf_ot-tot
     9868   on error undo, return error
     9869   :
     9870       find first buf_ot-tot no-lock
     9871            where buf_ot-tot.doc-code = p-doc-code
     9872              and buf_ot-tot.sum-type = p-sum-type
     9873              and buf_ot-tot.cat-id   = p-cat-id
     9874       no-error.
     9875       if not available buf_ot-tot
     9876       then do:
     9877       end.
     9878       else do:
     9879           case p-sum-type
     9880           :
     9881               when 'sale':U
     9882               or when 'sasr':U
     9883               then do:
     9884                   assign
     9885                       p-ot-tot-sale-exists = yes
     9886                   .
     9887                   if v-bge-xml-bgefmt = "dbf":U
     9888                   then do:
     9889                       run set-dbf-out-file-name in this-procedure (
     9890                             input "hdsm":U
     9891                           , input p-doc-code
     9892                       ).
     9893                   end.
     9894                   run wp-xmltagopen( 3, "docSum","" ).
     9895                   run wp-xmltagput( 4, "sumr"      , string( abs( buf_ot-tot.sum-rubl       ) ), 1 ).
     9896                   if p-is-envd_ eq NO then
     9897                     run wp-xmltagput( 4, "VATr"    , string( abs( buf_ot-tot.vat-rubl       ) ), 2 ).
     9898                   else
     9899                     run wp-xmltagput( 4, "VATr"    , string( abs( p-sum-all-parts_          ) ), 2 ).
     9900                   run wp-xmltagput( 4, "SLTr"      , string( abs( buf_ot-tot.slt-rubl       ) ), 2 ).
     9901                   run wp-xmltagput( 4, "roadTaxr"  , string( abs( buf_ot-tot.road-tax-rubl  ) ), 2 ).
     9902                   run wp-xmltagput( 4, "transportr", string( abs( buf_ot-tot.transport-rubl ) ), 2 ).
     9903                   run wp-xmltagput( 4, "otherr"    , string( abs( buf_ot-tot.other-rubl     ) ), 2 ).
     9904                   run wp-xmltagput( 4, "exciser"   , string( abs( buf_ot-tot.excise-rubl    ) ), 2 ).
     9905                   run wp-xmltagput( 4, "sumb"      , string( abs( buf_ot-tot.sum-base       ) ), 2 ).
     9906                   run wp-xmltagput( 4, "VATb"      , string( abs( buf_ot-tot.vat-base       ) ), 2 ).
     9907                   run wp-xmltagput( 4, "SLTb"      , string( abs( buf_ot-tot.slt-base       ) ), 2 ).
     9908                   run wp-xmltagput( 4, "roadTaxb"  , string( abs( buf_ot-tot.road-tax-base  ) ), 2 ).
     9909                   run wp-xmltagput( 4, "transportb", string( abs( buf_ot-tot.transport-base ) ), 2 ).
     9910                   run wp-xmltagput( 4, "otherb"    , string( abs( buf_ot-tot.other-base     ) ), 2 ).
     9911                   run wp-xmltagput( 4, "exciseb"   , string( abs( buf_ot-tot.excise-base    ) ), 2 ).
     9912                   run wp-xmltagclose( 3, "docSum" ).
     9913               end.
     9914               when 'cost':U
     9915               or when 'cssr':U
     9916               then do:
     9917                   assign
     9918                       p-ot-tot-cost-exists = yes
     9919                   .
     9920                   if v-bge-xml-bgefmt = "dbf":U
     9921                   then do:
     9922                       run set-dbf-out-file-name in this-procedure (
     9923                             input "hcsm":U
     9924                           , input p-doc-code
     9925                       ).
     9926                   end.
     9927                   run wp-xmltagopen( 3, "costSum", "" ).
     9928                   run wp-xmltagput( 4, "sumr",        string( abs( buf_ot-tot.sum-rubl       ) ), 1 ).
     9929                   if p-is-envd_ eq NO then
     9930                     run wp-xmltagput( 4, "VATr" ,     string( abs( buf_ot-tot.vat-rubl       ) ), 2 ).
     9931                   else
     9932                     run wp-xmltagput( 4, "VATr" ,     string( abs( p-sum-all-parts_          ) ), 2 ).
     9933                   run wp-xmltagput( 4, "SLTr",        string( abs( buf_ot-tot.slt-rubl       ) ), 2 ).
     9934                   run wp-xmltagput( 4, "roadTaxr",    string( abs( buf_ot-tot.road-tax-rubl  ) ), 2 ).
     9935                   run wp-xmltagput( 4, "transportr",  string( abs( buf_ot-tot.transport-rubl ) ), 2 ).
     9936                   run wp-xmltagput( 4, "otherr",      string( abs( buf_ot-tot.other-rubl     ) ), 2 ).
     9937                   run wp-xmltagput( 4, "exciser",     string( abs( buf_ot-tot.excise-rubl    ) ), 2 ).
     9938                   run wp-xmltagput( 4, "sumb",        string( abs( buf_ot-tot.sum-base       ) ), 2 ).
     9939                   run wp-xmltagput( 4, "VATb",        string( abs( buf_ot-tot.vat-base       ) ), 2 ).
     9940                   run wp-xmltagput( 4, "SLTb",        string( abs( buf_ot-tot.slt-base       ) ), 2 ).
     9941                   run wp-xmltagput( 4, "roadTaxb",    string( abs( buf_ot-tot.road-tax-base  ) ), 2 ).
     9942                   run wp-xmltagput( 4, "transportb",  string( abs( buf_ot-tot.transport-base ) ), 2 ).
     9943                   run wp-xmltagput( 4, "otherb",      string( abs( buf_ot-tot.other-base     ) ), 2 ).
     9944                   run wp-xmltagput( 4, "exciseb",     string( abs( buf_ot-tot.excise-base    ) ), 2 ).
     9945                   run wp-xmltagclose( 3, "costSum" ).
     9946                   run fill-temp-cost-supp in this-procedure (
     9947                       input p-doc-code
     9948                   ).
     9949               end.
     9950               when 'crsa':U
     9951               or when 'cgsr':U
     9952               then do:
     9953                   assign
     9954                       p-ot-tot-crsa-exists = yes
     9955                   .
     9956                   if v-bge-xml-bgefmt = "dbf":U
     9957                   then do:
     9958                       run set-dbf-out-file-name in this-procedure (
     9959                             input "hssm":U
     9960                           , input p-doc-code
     9961                       ).
     9962                   end.
     9963                   run wp-xmltagopen( 3, "saleSum", "" ).
     9964                   run wp-xmltagput( 4, "sumr",         string( abs( buf_ot-tot.sum-rubl        ) ), 1 ).
     9965                   run wp-xmltagput( 4, "VATr",         string( abs( buf_ot-tot.vat-rubl        ) ), 2 ).
     9966                   run wp-xmltagput( 4, "SLTr",         string( abs( buf_ot-tot.slt-rubl        ) ), 2 ).
     9967                   run wp-xmltagput( 4, "roadTaxr",     string( abs( buf_ot-tot.road-tax-rubl   ) ), 2 ).
     9968                   run wp-xmltagput( 4, "transportr",   string( abs( buf_ot-tot.transport-rubl  ) ), 2 ).
     9969                   run wp-xmltagput( 4, "otherr",       string( abs( buf_ot-tot.other-rubl      ) ), 2 ).
     9970                   run wp-xmltagput( 4, "exciser",      string( abs( buf_ot-tot.excise-rubl     ) ), 2 ).
     9971                   run wp-xmltagput( 4, "sumb",         string( abs( buf_ot-tot.sum-base        ) ), 2 ).
     9972                   run wp-xmltagput( 4, "VATb",         string( abs( buf_ot-tot.vat-base        ) ), 2 ).
     9973                   run wp-xmltagput( 4, "SLTb",         string( abs( buf_ot-tot.slt-base        ) ), 2 ).
     9974                   run wp-xmltagput( 4, "roadTaxb",     string( abs( buf_ot-tot.road-tax-base   ) ), 2 ).
     9975                   run wp-xmltagput( 4, "transportb",   string( abs( buf_ot-tot.transport-base  ) ), 2 ).
     9976                   run wp-xmltagput( 4, "otherb",       string( abs( buf_ot-tot.other-base      ) ), 2 ).
     9977                   run wp-xmltagput( 4, "exciseb",      string( abs( buf_ot-tot.excise-base     ) ), 2 ).
     9978                   run wp-xmltagclose( 3, "saleSum" ).
     9979                   run fill-temp-cost-supp in this-procedure (
     9980                       input p-doc-code
     9981                   ).
     9982               end.
     9983           end case.
     9984       end.
     9985   end.
     9986   end procedure.
     9987   procedure fill-temp-cost-supp :
     9988   define input parameter p-doc-code   as character        no-undo.
     9989       define buffer buf_cost_ot-supp-tot     for ub.ot-supp-tot.
     9990       define buffer buf_sale_ot-supp-tot     for ub.ot-supp-tot.
     9991       define buffer buf_cost_ot-supp-line    for ub.ot-supp-line.
     9992       define buffer buf_sale_ot-supp-line    for ub.ot-supp-line.
     9993   do
     9994   on error undo, return error
     9995   :
     9996       for each temp_cost_cat-id_ot-supp-tot no-lock
     9997       on error undo, return error
     9998       :
     9999           delete temp_cost_cat-id_ot-supp-tot.
    10000       end.
    10001       for each temp_cost_cli_ot-supp-tot no-lock
    10002       on error undo, return error
    10003       :
    10004           delete temp_cost_cli_ot-supp-tot.
    10005       end.
    10006       for each buf_cost_ot-supp-tot no-lock
    10007          where buf_cost_ot-supp-tot.doc-code = p-doc-code
    10008       on error undo, return error
    10009       :
    10010           if buf_cost_ot-supp-tot.sum-type = 'cost':U + 'p':U
    10011           then do:
    10012               find first temp_cost_cat-id_ot-supp-tot
    10013                    where temp_cost_cat-id_ot-supp-tot.cat-id   = buf_cost_ot-supp-tot.cat-id
    10014               no-error.
    10015               if not available temp_cost_cat-id_ot-supp-tot
    10016               then do:
    10017                   create temp_cost_cat-id_ot-supp-tot.
    10018                   assign
    10019                       temp_cost_cat-id_ot-supp-tot.cat-id   = buf_cost_ot-supp-tot.cat-id
    10020                   .
    10021               end.
    10022               run fill_bge-xml_clients in this-procedure (
    10023                     input p-parent-handle
    10024                   , input buf_cost_ot-supp-tot.cli-type
    10025                   , input buf_cost_ot-supp-tot.cli-code
    10026               ).
    10027               find first temp_cost_cli_ot-supp-tot
    10028                    where temp_cost_cli_ot-supp-tot.cat-id   = buf_cost_ot-supp-tot.cat-id
    10029                      and temp_cost_cli_ot-supp-tot.cli-type = buf_cost_ot-supp-tot.cli-type
    10030                      and temp_cost_cli_ot-supp-tot.cli-code = buf_cost_ot-supp-tot.cli-code
    10031               no-error.
    10032               if not available temp_cost_cli_ot-supp-tot
    10033               then do:
    10034                   create temp_cost_cli_ot-supp-tot.
    10035                   assign
    10036                       temp_cost_cli_ot-supp-tot.cat-id            = buf_cost_ot-supp-tot.cat-id
    10037                       temp_cost_cli_ot-supp-tot.cli-type          = buf_cost_ot-supp-tot.cli-type
    10038                       temp_cost_cli_ot-supp-tot.cli-code          = buf_cost_ot-supp-tot.cli-code
    10039                       temp_cost_cli_ot-supp-tot.sum-rubl          = buf_cost_ot-supp-tot.sum-rubl
    10040                       temp_cost_cli_ot-supp-tot.vat-rubl          = buf_cost_ot-supp-tot.vat-rubl
    10041                       temp_cost_cli_ot-supp-tot.slt-rubl          = buf_cost_ot-supp-tot.slt-rubl
    10042                       temp_cost_cli_ot-supp-tot.road-tax-rubl     = buf_cost_ot-supp-tot.road-tax-rubl
    10043                       temp_cost_cli_ot-supp-tot.transport-rubl    = buf_cost_ot-supp-tot.transport-rubl
    10044                       temp_cost_cli_ot-supp-tot.other-rubl        = buf_cost_ot-supp-tot.other-rubl
    10045                       temp_cost_cli_ot-supp-tot.excise-rubl       = buf_cost_ot-supp-tot.excise-rubl
    10046                       temp_cost_cli_ot-supp-tot.sum-base          = buf_cost_ot-supp-tot.sum-base
    10047                       temp_cost_cli_ot-supp-tot.vat-base          = buf_cost_ot-supp-tot.vat-base
    10048                       temp_cost_cli_ot-supp-tot.slt-base          = buf_cost_ot-supp-tot.slt-base
    10049                       temp_cost_cli_ot-supp-tot.road-tax-base     = buf_cost_ot-supp-tot.road-tax-base
    10050                       temp_cost_cli_ot-supp-tot.transport-base    = buf_cost_ot-supp-tot.transport-base
    10051                       temp_cost_cli_ot-supp-tot.other-base        = buf_cost_ot-supp-tot.other-base
    10052                       temp_cost_cli_ot-supp-tot.excise-base       = buf_cost_ot-supp-tot.excise-base
    10053                       temp_cost_cli_ot-supp-tot.fact-qnty         = buf_cost_ot-supp-tot.fact-qnty
    10054                   .
    10055               end.
    10056           end.
    10057       end.
    10058       for each temp_cost_cat-id_ot-supp-line no-lock
    10059       on error undo, return error
    10060       :
    10061           delete temp_cost_cat-id_ot-supp-line.
    10062       end.
    10063       for each temp_cost_cli_ot-supp-line no-lock
    10064       on error undo, return error
    10065       :
    10066           delete temp_cost_cli_ot-supp-line.
    10067       end.
    10068       for each buf_cost_ot-supp-line no-lock
    10069          where buf_cost_ot-supp-line.doc-code = p-doc-code
    10070       on error undo, return error
    10071       :
    10072           if buf_cost_ot-supp-line.sum-type = 'cost':U + 'p':U
    10073           then do:
    10074               find first temp_cost_cat-id_ot-supp-line
    10075                    where temp_cost_cat-id_ot-supp-line.artic      = buf_cost_ot-supp-line.artic
    10076                      and temp_cost_cat-id_ot-supp-line.prod-type  = buf_cost_ot-supp-line.prod-type
    10077                      and temp_cost_cat-id_ot-supp-line.prod-code  = buf_cost_ot-supp-line.prod-code
    10078                      and temp_cost_cat-id_ot-supp-line.cat-id     = buf_cost_ot-supp-line.cat-id
    10079               no-error.
    10080               if not available temp_cost_cat-id_ot-supp-line
    10081               then do:
    10082                   create temp_cost_cat-id_ot-supp-line.
    10083                   assign
    10084                       temp_cost_cat-id_ot-supp-line.artic     = buf_cost_ot-supp-line.artic
    10085                       temp_cost_cat-id_ot-supp-line.prod-type = buf_cost_ot-supp-line.prod-type
    10086                       temp_cost_cat-id_ot-supp-line.prod-code = buf_cost_ot-supp-line.prod-code
    10087                       temp_cost_cat-id_ot-supp-line.cat-id    = buf_cost_ot-supp-line.cat-id
    10088                   .
    10089               end.
    10090               find first temp_cost_cli_ot-supp-line
    10091                    where temp_cost_cli_ot-supp-line.artic      = buf_cost_ot-supp-line.artic
    10092                      and temp_cost_cli_ot-supp-line.prod-type  = buf_cost_ot-supp-line.prod-type
    10093                      and temp_cost_cli_ot-supp-line.prod-code  = buf_cost_ot-supp-line.prod-code
    10094                      and temp_cost_cli_ot-supp-line.cat-id     = buf_cost_ot-supp-line.cat-id
    10095                      and temp_cost_cli_ot-supp-line.cli-type   = buf_cost_ot-supp-line.cli-type
    10096                      and temp_cost_cli_ot-supp-line.cli-code   = buf_cost_ot-supp-line.cli-code
    10097               no-error.
    10098               if not available temp_cost_cli_ot-supp-line
    10099               then do:
    10100                   create temp_cost_cli_ot-supp-line.
    10101                   assign
    10102                       temp_cost_cli_ot-supp-line.artic             = buf_cost_ot-supp-line.artic
    10103                       temp_cost_cli_ot-supp-line.prod-type         = buf_cost_ot-supp-line.prod-type
    10104                       temp_cost_cli_ot-supp-line.prod-code         = buf_cost_ot-supp-line.prod-code
    10105                       temp_cost_cli_ot-supp-line.cat-id            = buf_cost_ot-supp-line.cat-id
    10106                       temp_cost_cli_ot-supp-line.cli-type          = buf_cost_ot-supp-line.cli-type
    10107                       temp_cost_cli_ot-supp-line.cli-code          = buf_cost_ot-supp-line.cli-code
    10108                       temp_cost_cli_ot-supp-line.sum-rubl          = buf_cost_ot-supp-line.sum-rubl
    10109                       temp_cost_cli_ot-supp-line.vat-rubl          = buf_cost_ot-supp-line.vat-rubl
    10110                       temp_cost_cli_ot-supp-line.slt-rubl          = buf_cost_ot-supp-line.slt-rubl
    10111                       temp_cost_cli_ot-supp-line.road-tax-rubl     = buf_cost_ot-supp-line.road-tax-rubl
    10112                       temp_cost_cli_ot-supp-line.transport-rubl    = buf_cost_ot-supp-line.transport-rubl
    10113                       temp_cost_cli_ot-supp-line.other-rubl        = buf_cost_ot-supp-line.other-rubl
    10114                       temp_cost_cli_ot-supp-line.excise-rubl       = buf_cost_ot-supp-line.excise-rubl
    10115                       temp_cost_cli_ot-supp-line.sum-base          = buf_cost_ot-supp-line.sum-base
    10116                       temp_cost_cli_ot-supp-line.vat-base          = buf_cost_ot-supp-line.vat-base
    10117                       temp_cost_cli_ot-supp-line.slt-base          = buf_cost_ot-supp-line.slt-base
    10118                       temp_cost_cli_ot-supp-line.road-tax-base     = buf_cost_ot-supp-line.road-tax-base
    10119                       temp_cost_cli_ot-supp-line.transport-base    = buf_cost_ot-supp-line.transport-base
    10120                       temp_cost_cli_ot-supp-line.other-base        = buf_cost_ot-supp-line.other-base
    10121                       temp_cost_cli_ot-supp-line.excise-base       = buf_cost_ot-supp-line.excise-base
    10122                       temp_cost_cli_ot-supp-line.fact-qnty         = buf_cost_ot-supp-line.fact-qnty
    10123                   .
    10124               end.
    10125               else do:
    10126                   run wp-XMLWriteLog(  v-bge-xml-log-file-name,
    10127                                               1,
    10128                                       "*** WRN: *** Найдено больше одной записи ot-supp-line для документа "
    10129                                       + string( p-doc-code )
    10130                   ).
    10131               end.
    10132           end.
    10133       end.
    10134   end.
    10135   end procedure.
    10136   procedure export-ot-line :
    10137   define input parameter p-doc-code   as character        no-undo.
    10138   define input parameter p-artic      as character        no-undo.
    10139   define input parameter p-prod-type  as character        no-undo.
    10140   define input parameter p-prod-code  as integer          no-undo.
    10141   define input parameter p-sum-type   as character        no-undo.
    10142   define input parameter p-is-envd    as logical          no-undo.
    10143   define input parameter p-sum-line_  as decimal          no-undo.
    10144       define buffer buf_ot-line       for ub.ot-line.
    10145   do
    10146   for buf_ot-line
    10147   on error undo, return error
    10148   :
    10149       find first buf_ot-line no-lock
    10150            where buf_ot-line.doc-code    = p-doc-code
    10151              and buf_ot-line.artic       = p-artic
    10152              and buf_ot-line.prod-type   = p-prod-type
    10153              and buf_ot-line.prod-code   = p-prod-code
    10154              and buf_ot-line.sum-type    = p-sum-type
    10155              and buf_ot-line.sum-rubl    <> 0
    10156       no-error.
    10157       if available buf_ot-line
    10158       then do:
    10159           case p-sum-type
    10160           :
    10161               when 'sale':U
    10162               or when 'sasr':U
    10163               then do:
    10164                   if v-bge-xml-bgefmt = "dbf":U
    10165                   then do:
    10166                       run set-dbf-out-file-name in this-procedure (
    10167                             input substitute( "ldsm&1_":U, p-artic )
    10168                           , input p-doc-code
    10169                       ).
    10170                   end.
    10171                   run wp-xmltagopen( 4, "docSum", "" ).
    10172                   run wp-xmltagput( 5, "rateVAT",    string( entry( 1, buf_ot-line.cat-id ) ), 2 ).
    10173                   run wp-xmltagput( 5, "rateSLT",    string( entry( 2, buf_ot-line.cat-id ) ), 2 ).
    10174                   if p-ext-doc-type = 'ot':U
    10175                   then do:
    10176                           run wp-xmltagput( 5, "sumr",       string( buf_ot-line.sum-rubl         ), 1 ).
    10177                           if p-is-envd eq NO then
    10178                             run wp-xmltagput( 5, "VATr",       string( buf_ot-line.vat-rubl       ), 2 ).
    10179                           else
    10180                             run wp-xmltagput( 5, "VATr",       string( p-sum-line_                ), 2 ).
    10181                           run wp-xmltagput( 5, "SLTr",       string( buf_ot-line.slt-rubl         ), 2 ).
    10182                           run wp-xmltagput( 5, "roadTaxr",   string( buf_ot-line.road-tax-rubl    ), 2 ).
    10183                           run wp-xmltagput( 5, "transportr", string( buf_ot-line.transport-rubl   ), 2 ).
    10184                           run wp-xmltagput( 5, "otherr",     string( buf_ot-line.other-rubl       ), 2 ).
    10185                           run wp-xmltagput( 5, "exciser",    string( buf_ot-line.excise-rubl      ), 2 ).
    10186                           run wp-xmltagput( 5, "sumb",       string( buf_ot-line.sum-base         ), 2 ).
    10187                           run wp-xmltagput( 5, "VATb",       string( buf_ot-line.vat-base         ), 2 ).
    10188                           run wp-xmltagput( 5, "SLTb",       string( buf_ot-line.slt-base         ), 2 ).
    10189                           run wp-xmltagput( 5, "roadTaxb",   string( buf_ot-line.road-tax-base    ), 2 ).
    10190                           run wp-xmltagput( 5, "transportb", string( buf_ot-line.transport-base   ), 2 ).
    10191                           run wp-xmltagput( 5, "otherb",     string( buf_ot-line.other-base       ), 2 ).
    10192                           run wp-xmltagput( 5, "exciseb",    string( buf_ot-line.excise-base      ), 2 ).
    10193                   end.
    10194                   else do:
    10195                           run wp-xmltagput( 5, "sumr",       string( abs( buf_ot-line.sum-rubl       ) ), 1 ).
    10196                           if p-is-envd eq NO then
    10197                             run wp-xmltagput( 5, "VATr",       string( abs( buf_ot-line.vat-rubl     ) ), 2 ).
    10198                           else
    10199                             run wp-xmltagput( 5, "VATr",       string( abs( p-sum-line_              ) ), 2 ).
    10200                           run wp-xmltagput( 5, "SLTr",       string( abs( buf_ot-line.slt-rubl       ) ), 2 ).
    10201                           run wp-xmltagput( 5, "roadTaxr",   string( abs( buf_ot-line.road-tax-rubl  ) ), 2 ).
    10202                           run wp-xmltagput( 5, "transportr", string( abs( buf_ot-line.transport-rubl ) ), 2 ).
    10203                           run wp-xmltagput( 5, "otherr",     string( abs( buf_ot-line.other-rubl     ) ), 2 ).
    10204                           run wp-xmltagput( 5, "exciser",    string( abs( buf_ot-line.excise-rubl    ) ), 2 ).
    10205                           run wp-xmltagput( 5, "sumb",       string( abs( buf_ot-line.sum-base       ) ), 2 ).
    10206                           run wp-xmltagput( 5, "VATb",       string( abs( buf_ot-line.vat-base       ) ), 2 ).
    10207                           run wp-xmltagput( 5, "SLTb",       string( abs( buf_ot-line.slt-base       ) ), 2 ).
    10208                           run wp-xmltagput( 5, "roadTaxb",   string( abs( buf_ot-line.road-tax-base  ) ), 2 ).
    10209                           run wp-xmltagput( 5, "transportb", string( abs( buf_ot-line.transport-base ) ), 2 ).
    10210                           run wp-xmltagput( 5, "otherb",     string( abs( buf_ot-line.other-base     ) ), 2 ).
    10211                           run wp-xmltagput( 5, "exciseb",    string( abs( buf_ot-line.excise-base    ) ), 2 ).
    10212                   end.
    10213                   run wp-xmltagclose( 4, "docSum" ).
    10214               end.
    10215               when 'cost':U
    10216               or when 'cssr':U
    10217               then do:
    10218                   if v-bge-xml-bgefmt = "dbf":U
    10219                   then do:
    10220                       run set-dbf-out-file-name in this-procedure (
    10221                             input substitute( "lcsm&1_":U, buf_ot-line.artic )
    10222                           , input p-doc-code
    10223                       ).
    10224                   end.
    10225                   run wp-xmltagopen( 4, "costSum", "" ).
    10226                   run wp-xmltagput( 5, "sumr",       string( abs( buf_ot-line.sum-rubl       ) ), 1 ).
    10227                   if p-is-envd eq NO then
    10228                     run wp-xmltagput( 5, "VATr",       string( abs( buf_ot-line.vat-rubl     ) ), 2 ).
    10229                   else
    10230                     run wp-xmltagput( 5, "VATr",       string( abs( p-sum-line_              ) ), 2 ).
    10231                   run wp-xmltagput( 5, "SLTr",       string( abs( buf_ot-line.slt-rubl       ) ), 2 ).
    10232                   run wp-xmltagput( 5, "roadTaxr",   string( abs( buf_ot-line.road-tax-rubl  ) ), 2 ).
    10233                   run wp-xmltagput( 5, "transportr", string( abs( buf_ot-line.transport-rubl ) ), 2 ).
    10234                   run wp-xmltagput( 5, "otherr",     string( abs( buf_ot-line.other-rubl     ) ), 2 ).
    10235                   run wp-xmltagput( 5, "exciser",    string( abs( buf_ot-line.excise-rubl    ) ), 2 ).
    10236                   run wp-xmltagput( 5, "sumb",       string( abs( buf_ot-line.sum-base       ) ), 2 ).
    10237                   run wp-xmltagput( 5, "VATb",       string( abs( buf_ot-line.vat-base       ) ), 2 ).
    10238                   run wp-xmltagput( 5, "SLTb",       string( abs( buf_ot-line.slt-base       ) ), 2 ).
    10239                   run wp-xmltagput( 5, "roadTaxb",   string( abs( buf_ot-line.road-tax-base  ) ), 2 ).
    10240                   run wp-xmltagput( 5, "transportb", string( abs( buf_ot-line.transport-base ) ), 2 ).
    10241                   run wp-xmltagput( 5, "otherb",     string( abs( buf_ot-line.other-base     ) ), 2 ).
    10242                   run wp-xmltagput( 5, "exciseb",    string( abs( buf_ot-line.excise-base    ) ), 2 ).
    10243                   run wp-xmltagclose( 4, "costSum" ).
    10244               end.
    10245               when 'crsa':U
    10246               or when 'cgsr':U
    10247               then do:
    10248                   if v-bge-xml-bgefmt = "dbf":U
    10249                   then do:
    10250                       run set-dbf-out-file-name in this-procedure (
    10251                             input substitute( "lssm&1_":U, buf_ot-line.artic )
    10252                           , input p-doc-code
    10253                       ).
    10254                   end.
    10255                   if p-ext-doc-type = 'ot':U
    10256                   then do:
    10257                       run wp-xmltagopen( 4, "saleSum", "" ).
    10258                       run wp-xmltagput( 5, "sumr",       string( buf_ot-line.sum-rubl        ), 1 ).
    10259                       run wp-xmltagput( 5, "VATr",       string( buf_ot-line.vat-rubl        ), 2 ).
    10260                       run wp-xmltagput( 5, "SLTr",       string( buf_ot-line.slt-rubl        ), 2 ).
    10261                       run wp-xmltagput( 5, "roadTaxr",   string( buf_ot-line.road-tax-rubl   ), 2 ).
    10262                       run wp-xmltagput( 5, "transportr", string( buf_ot-line.transport-rubl  ), 2 ).
    10263                       run wp-xmltagput( 5, "otherr",     string( buf_ot-line.other-rubl      ), 2 ).
    10264                       run wp-xmltagput( 5, "exciser",    string( buf_ot-line.excise-rubl     ), 2 ).
    10265                       run wp-xmltagput( 5, "sumb",       string( buf_ot-line.sum-base        ), 2 ).
    10266                       run wp-xmltagput( 5, "VATb",       string( buf_ot-line.vat-base        ), 2 ).
    10267                       run wp-xmltagput( 5, "SLTb",       string( buf_ot-line.slt-base        ), 2 ).
    10268                       run wp-xmltagput( 5, "roadTaxb",   string( buf_ot-line.road-tax-base   ), 2 ).
    10269                       run wp-xmltagput( 5, "transportb", string( buf_ot-line.transport-base  ), 2 ).
    10270                       run wp-xmltagput( 5, "otherb",     string( buf_ot-line.other-base      ), 2 ).
    10271                       run wp-xmltagput( 5, "exciseb",    string( buf_ot-line.excise-base     ), 2 ).
    10272                       run wp-xmltagclose( 4, "saleSum" ).
    10273                   end.
    10274                   else do:
    10275                       run wp-xmltagopen( 4, "saleSum", "" ).
    10276                       run wp-xmltagput( 5, "sumr",       string( abs( buf_ot-line.sum-rubl       ) ), 1 ).
    10277                       run wp-xmltagput( 5, "VATr",       string( abs( buf_ot-line.vat-rubl       ) ), 2 ).
    10278                       run wp-xmltagput( 5, "SLTr",       string( abs( buf_ot-line.slt-rubl       ) ), 2 ).
    10279                       run wp-xmltagput( 5, "roadTaxr",   string( abs( buf_ot-line.road-tax-rubl  ) ), 2 ).
    10280                       run wp-xmltagput( 5, "transportr", string( abs( buf_ot-line.transport-rubl ) ), 2 ).
    10281                       run wp-xmltagput( 5, "otherr",     string( abs( buf_ot-line.other-rubl     ) ), 2 ).
    10282                       run wp-xmltagput( 5, "exciser",    string( abs( buf_ot-line.excise-rubl    ) ), 2 ).
    10283                       run wp-xmltagput( 5, "sumb",       string( abs( buf_ot-line.sum-base       ) ), 2 ).
    10284                       run wp-xmltagput( 5, "VATb",       string( abs( buf_ot-line.vat-base       ) ), 2 ).
    10285                       run wp-xmltagput( 5, "SLTb",       string( abs( buf_ot-line.slt-base       ) ), 2 ).
    10286                       run wp-xmltagput( 5, "roadTaxb",   string( abs( buf_ot-line.road-tax-base  ) ), 2 ).
    10287                       run wp-xmltagput( 5, "transportb", string( abs( buf_ot-line.transport-base ) ), 2 ).
    10288                       run wp-xmltagput( 5, "otherb",     string( abs( buf_ot-line.other-base     ) ), 2 ).
    10289                       run wp-xmltagput( 5, "exciseb",    string( abs( buf_ot-line.excise-base    ) ), 2 ).
    10290                       run wp-xmltagclose( 4, "saleSum" ).
    10291                   end.
    10292               end.
    10293           end case.
    10294       end.
    10295   end.
    10296   end procedure.
    10297   procedure fill_bge-xml_goods :
    10298   define input parameter p-parent-handle  as handle           no-undo.
    10299   define input parameter p-gds-code       as integer          no-undo.
    10300   do
    10301   on error undo, return error
    10302   :
    10303       if p-parent-handle :get-signature( "cb-fill_bge-xml_goods" ) <> "":U
    10304       then do:
    10305           run cb-fill_bge-xml_goods in p-parent-handle (
    10306               input p-gds-code
    10307           ).
    10308       end.
    10309   end.
    10310   end procedure.
    10311   procedure fill_bge-xml_clients :
    10312   define input parameter p-parent-handle  as handle           no-undo.
    10313   define input parameter p-obj-type       as character        no-undo.
    10314   define input parameter p-obj-code       as integer          no-undo.
    10315   do
    10316   on error undo, return error
    10317   :
    10318       if p-parent-handle :get-signature( "cb-fill_bge-xml_clients" ) <> "":U
    10319       then do:
    10320           run cb-fill_bge-xml_clients in p-parent-handle (
    10321                 input p-obj-type
    10322               , input p-obj-code
    10323           ).
    10324       end.
    10325   end.
    10326   end procedure.
    10327   procedure fill_bge-xml_dis-card :
    10328   define input parameter p-parent-handle  as handle           no-undo.
    10329   define input parameter p-d-card         as character        no-undo.
    10330   do
    10331   on error undo, return error
    10332   :
    10333       if p-parent-handle :get-signature( "cb-fill_bge-xml_dis-card" ) <> "":U
    10334       then do:
    10335           run cb-fill_bge-xml_dis-card in p-parent-handle (
    10336               input p-d-card
    10337           ).
    10338       end.
    10339   end.
    10340   end procedure.
    10341   procedure set-dbf-out-file-name :
    10342   define input parameter p-prefix     as character        no-undo.
    10343   define input parameter p-doc-code   as character        no-undo.
    10344       define variable v-file-name    as character    no-undo.
    10345   do
    10346   on error undo, return error
    10347   :
    10348       assign
    10349           v-file-name = trim( p-doc-code )
    10350       .
    10351       if v-file-name = "":U
    10352       then do:
    10353           assign
    10354               v-file-name = "noname":U
    10355           .
    10356       end.
    10357       else do:
    10358           assign
    10359               v-file-name = replace( v-file-name, "*":U, "#":U )
    10360           .
    10361       end.
    10362       assign
    10363           p-prefix = replace( p-prefix, "*":U, "_":U )
    10364       .
    10365       assign
    10366           p-prefix = replace( p-prefix, "/":U, "_":U )
    10367       .
    10368       assign
    10369           p-prefix = replace( p-prefix, "\":U, "_":U )
    10370       .
    10371       assign
    10372           p-prefix = replace( p-prefix, ":":U, "_":U )
    10373       .
    10374       assign
    10375           p-prefix = replace( p-prefix, "?":U, "_":U )
    10376       .
    10377       assign
    10378           p-prefix = replace( p-prefix, '"':U, "_":U )
    10379       .
    10380       assign
    10381           p-prefix = replace( p-prefix, ">":U, "_":U )
    10382       .
    10383       assign
    10384           p-prefix = replace( p-prefix, "<":U, "_":U )
    10385       .
    10386       assign
    10387           p-prefix = replace( p-prefix, "|":U, "_":U )
    10388       .
    10389       assign
    10390           v-bge-xml-dbf-file-name = substitute( "&1/&2&3.d":U
    10391                                               , sOutFile
    10392                                               , p-prefix
    10393                                               , v-file-name
    10394                                               )
    10395       .
    10396   end.
    10397   end procedure.
    10398   procedure get-doc-line-attr-character :
    10399   define input parameter p-doc-code               as character        no-undo.
    10400   define input parameter p-gds-code               as integer          no-undo.
    10401   define input parameter p-attr-code              as character        no-undo.
    10402   define output parameter p-attr-value-character  as character        no-undo.
    10403   define output parameter p-attr-exists           as logical          no-undo.
    10404       define buffer buf_doc-line-attr for ub.doc-line-attr.
    10405       define buffer buf_doc-attr for ub.doc-attr.
    10406   do
    10407   on error undo, return error
    10408   :
    10409       find first buf_doc-attr no-lock
    10410            where buf_doc-attr.doc-code    = p-doc-code
    10411              and buf_doc-attr.attr-code   = p-attr-code
    10412       no-error.
    10413       case p-attr-code:
    10414         when 'autoent':U then do:
    10415           assign
    10416             p-attr-value-character = entry (1, buf_doc-attr.attr-value, ";")
    10417           no-error.
    10418           if error-status :error
    10419           then do:
    10420               assign
    10421                   p-attr-exists = no
    10422               .
    10423           end.
    10424           else do:
    10425               assign
    10426                   p-attr-exists = yes
    10427               .
    10428           end.
    10429         end.
    10430         when 'ptbobj':U then do:
    10431           assign
    10432             p-attr-value-character = entry (1, buf_doc-attr.attr-value, ";")
    10433           no-error.
    10434           if error-status :error
    10435           then do:
    10436               assign
    10437                   p-attr-exists = no
    10438               .
    10439           end.
    10440           else do:
    10441               assign
    10442                   p-attr-exists = yes
    10443               .
    10444           end.
    10445         end.
    10446         when 'ptb-item-pour':U or
    10447         when 'car-num':U or
    10448         when 'fio-driver':U or
    10449         when 'time-income':U
    10450         then do:
    10451           assign
    10452               p-attr-value-character = buf_doc-attr.attr-value
    10453           no-error.
    10454           if error-status :error
    10455           then do:
    10456               assign
    10457                   p-attr-exists = no
    10458               .
    10459           end.
    10460           else do:
    10461               assign
    10462                   p-attr-exists = yes
    10463               .
    10464           end.
    10465         end.
    10466         otherwise do:
    10467           find first buf_doc-line-attr no-lock
    10468                where buf_doc-line-attr.doc-code    = p-doc-code
    10469                  and buf_doc-line-attr.gds-code    = p-gds-code
    10470                  and buf_doc-line-attr.attr-code   = p-attr-code
    10471           no-error.
    10472           if available buf_doc-line-attr
    10473           then do:
    10474               assign
    10475                   p-attr-value-character = buf_doc-line-attr.attr-value
    10476                   p-attr-exists          = yes
    10477               .
    10478           end.
    10479           else do:
    10480               assign
    10481                   p-attr-exists          = no
    10482               .
    10483           end.
    10484         end.
    10485       end case.
    10486   end.
    10487   end procedure.
    10488   procedure get-doc-line-attr-integer :
    10489   define input parameter p-doc-code               as character        no-undo.
    10490   define input parameter p-gds-code               as integer          no-undo.
    10491   define input parameter p-attr-code              as character        no-undo.
    10492   define output parameter p-attr-value-integer    as integer          no-undo.
    10493   define output parameter p-attr-exists           as logical          no-undo.
    10494       define buffer buf_doc-line-attr for ub.doc-line-attr.
    10495       define buffer buf_doc-attr for ub.doc-attr.
    10496   do
    10497   on error undo, return error
    10498   :
    10499       find first buf_doc-attr no-lock
    10500            where buf_doc-attr.doc-code    = p-doc-code
    10501              and buf_doc-attr.attr-code   = p-attr-code
    10502       no-error.
    10503       case p-attr-code:
    10504         when 'autoent':U then do:
    10505           assign
    10506             p-attr-value-integer = integer (entry (2, buf_doc-attr.attr-value, ";"))
    10507           no-error.
    10508           if error-status :error
    10509           then do:
    10510               assign
    10511                   p-attr-exists = no
    10512               .
    10513           end.
    10514           else do:
    10515               assign
    10516                   p-attr-exists = yes
    10517               .
    10518           end.
    10519         end.
    10520         when 'ptbobj':U then do:
    10521           assign
    10522             p-attr-value-integer = integer (entry (2, buf_doc-attr.attr-value, ";"))
    10523           no-error.
    10524           if error-status :error
    10525           then do:
    10526               assign
    10527                   p-attr-exists = no
    10528               .
    10529           end.
    10530           else do:
    10531               assign
    10532                   p-attr-exists = yes
    10533               .
    10534           end.
    10535         end.
    10536         otherwise do:
    10537           find first buf_doc-line-attr no-lock
    10538                where buf_doc-line-attr.doc-code    = p-doc-code
    10539                  and buf_doc-line-attr.gds-code    = p-gds-code
    10540                  and buf_doc-line-attr.attr-code   = p-attr-code
    10541           no-error.
    10542           if available buf_doc-line-attr
    10543           then do:
    10544               assign
    10545                   p-attr-value-integer = integer (buf_doc-line-attr.attr-value)
    10546               no-error.
    10547             if error-status :error
    10548             then do:
    10549                 assign
    10550                     p-attr-exists = no
    10551                 .
    10552             end.
    10553             else do:
    10554                 assign
    10555                     p-attr-exists = yes
    10556                 .
    10557             end.
    10558           end.
    10559           else do:
    10560               assign
    10561                   p-attr-exists          = no
    10562               .
    10563           end.
    10564         end.
    10565       end case.
    10566   end.
    10567   end procedure.
