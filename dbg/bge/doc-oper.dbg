     5653   procedure thbjattr_code :
     5654      define input  parameter p-upper-code     as character no-undo .
     5655      define input  parameter p-code           as character no-undo .
     5656      define output parameter p-label          as character no-undo .
     5657      define output parameter p-user-can-edit  as logical   no-undo .
     5658      define output parameter p-output-display as logical   no-undo .
     5659      define output parameter p-other          as character no-undo .
     5660      define output parameter p-prop-list      as character no-undo .
     5661      define output parameter p-prop-type-list as character no-undo .
     5662      define output parameter p-prop-label-list as character no-undo .
     5663      define output parameter p-global          as logical no-undo .
     5664      define output parameter p-host           as logical no-undo .
     5665      define output parameter p-shop           as logical no-undo .
     5666      define output parameter p-store          as logical no-undo .
     5667      define output parameter p-db             as logical no-undo .
     5668      define variable p-region as logical no-undo.
     5669      run thbjattr_code_reg in this-procedure (
     5670                                               p-upper-code,
     5671                                               p-code,
     5672                                               output p-label,
     5673                                               output p-user-can-edit,
     5674                                               output p-output-display,
     5675                                               output p-other,
     5676                                               output p-prop-list,
     5677                                               output p-prop-type-list,
     5678                                               output p-prop-label-list,
     5679                                               output p-global,
     5680                                               output p-host,
     5681                                               output p-shop,
     5682                                               output p-store,
     5683                                               output p-db,
     5684                                               output p-region
     5685                                               ).
     5686   end procedure.
     5687   procedure thbjattr_code_reg :
     5688   define input  parameter p-upper-code     as character no-undo .
     5689   define input  parameter p-code           as character no-undo .
     5690   define output parameter p-label          as character no-undo .
     5691   define output parameter p-user-can-edit  as logical   no-undo .
     5692   define output parameter p-output-display as logical   no-undo .
     5693   define output parameter p-other          as character no-undo .
     5694   define output parameter p-prop-list      as character no-undo .
     5695   define output parameter p-prop-type-list as character no-undo .
     5696   define output parameter p-prop-label-list as character no-undo .
     5697   define output parameter p-global          as logical no-undo .
     5698   define output parameter p-host           as logical no-undo .
     5699   define output parameter p-shop           as logical no-undo .
     5700   define output parameter p-store          as logical no-undo .
     5701   define output parameter p-db             as logical no-undo .
     5702   define output parameter p-region         as logical no-undo .
     5703   do
     5704   on error undo, return error return-value
     5705   :
     5706       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
     5707       (input  p-upper-code
     5708       ,input  p-code
     5709       ,output p-label
     5710       ,output p-user-can-edit
     5711       ,output p-output-display
     5712       ,output p-other
     5713       ,output p-prop-list
     5714       ,output p-prop-type-list
     5715       ,output p-prop-label-list
     5716       ,output p-global
     5717       ,output p-host
     5718       ,output p-shop
     5719       ,output p-store
     5720       ,output p-db
     5721       ,output p-region
     5722       ) no-error .
     5723     if error-status :error
     5724     then do:
     5725       undo, return error substitute( "&1. &2&3&4", vss-include-info23, return-value, chr(10), error-status :get-message (1)).
     5726     end.
     5727   end.
     5728   end procedure.
