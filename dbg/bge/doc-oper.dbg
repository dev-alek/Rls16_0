     5947   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5948   define  shared variable auto-window-h     as handle    no-undo .
     5949   define  shared variable auto-log-msg-h    as handle    no-undo .
     5950   define  shared variable hand-log-msg-h    as handle    no-undo .
     5951   define  shared variable log-file-name     as character no-undo initial ? .
     5952   define  shared variable add-log-file-name as character no-undo initial ? .
     5953   define  shared variable writelogvalue     as character no-undo initial ? .
     5954   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5955   define stream LogStream .
     5956   define variable mNoTime as logical no-undo.
     5957   procedure write-to-log-notime :
     5958     define input param i-str as character no-undo .
     5959     mNoTime = yes.
     5960     run write-to-log (i-str).
     5961     mNoTime = no.
     5962   end.
     5963   procedure write-to-log :
     5964     define input param p-str as character no-undo .
     5965     do
     5966     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     5967     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
     5968     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
     5969     :
     5970       define variable log-res        as logical   no-undo .
     5971       define variable v-jj           as integer   no-undo .
     5972       if    mNoTime
     5973          or writelogvalue eq "AsyncProc"
     5974       then
     5975          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
     5976       else
     5977          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
     5978       if auto-log-msg-h <> ? then do:
     5979         log-res = auto-log-msg-h:move-to-eof( ) .
     5980         log-res = auto-log-msg-h:insert-string( p-str ).
     5981       end.
     5982       if hand-log-msg-h <> ? then do:
     5983         log-res = hand-log-msg-h:move-to-eof( ) .
     5984         log-res = hand-log-msg-h:insert-string( p-str ).
     5985       end.
     5986       assign
     5987         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
     5988         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
     5989         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
     5990       .
     5991       if add-log-file-name <> ? then do:
     5992         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
     5993           run gbl/fileapnd.p
     5994             ( input entry(v-jj, add-log-file-name, chr(1) )
     5995             ,input p-str
     5996             ,input 20
     5997             ) no-error .
     5998           if error-status:error then do:
     5999             return error return-value .
     6000           end.
     6001         end.
     6002       end.
     6003       if writelogvalue eq "AsyncProc"
     6004       then do:
     6005          p-str = trim(p-str, (chr(13) + chr(10)) )
     6006       .
     6007          Publish "WriteLogAsunc" (p-str,yes).
     6008       end.
     6009       else if writelogvalue <> "yes" then do:
     6010         run gbl/fileapnd.p
     6011           ( input log-file-name
     6012           ,input p-str
     6013           ,input 20
     6014           ) no-error .
     6015         if error-status:error then do:
     6016           return error return-value .
     6017         end.
     6018       end.
     6019     end.
     6020   end procedure.
     6021   procedure write-to-screen :
     6022     define input param p-str as character no-undo .
     6023     do
     6024     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     6025     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
     6026     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
     6027     :
     6028       define variable log-res as logical no-undo.
     6029       assign
     6030         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
     6031       .
     6032       if auto-log-msg-h <> ?
     6033       then do:
     6034         log-res = auto-log-msg-h:move-to-eof( ) .
     6035         log-res = auto-log-msg-h:insert-string( p-str ).
     6036       end.
     6037       if hand-log-msg-h <> ?
     6038       then do:
     6039         log-res = hand-log-msg-h:move-to-eof( ) .
     6040         log-res = hand-log-msg-h:insert-string( p-str ).
     6041       end.
     6042     end.
     6043   end procedure.
     6044   procedure send-msg-to-email :
     6045     define input  parameter p-subject      as character no-undo .
     6046     define input  parameter p-text-err     as character no-undo .
     6047     define input  parameter p-attach-files as character no-undo .
     6048     do
     6049     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     6050     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
     6051     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
     6052     :
     6053       define variable v-tth             as handle    no-undo .
     6054       define variable v-value-character as character no-undo .
     6055       define variable v-value-date      as date      no-undo .
     6056       define variable v-value-decimal   as decimal   no-undo .
     6057       define variable v-value-integer   as integer   no-undo .
     6058       define variable v-value-logical   as logical   no-undo .
     6059       define variable v-param-type      as character no-undo .
     6060       define variable v-email       as character no-undo .
     6061       define variable v-tmp-str     as character no-undo .
     6062       define variable v-tmp1-str    as character no-undo .
     6063       define variable v-ind         as integer   no-undo .
     6064       define variable v-num-entries as integer   no-undo .
     6065       delete object v-tth no-error.
     6066       run adm/shattri.p
     6067         ( input "get":U
     6068          ,input  "":U
     6069          ,input  0
     6070          ,input  'auto-task':U
     6071          ,input  'send-msg-to-email':U
     6072          ,output v-value-character
     6073          ,output v-value-date
     6074          ,output v-value-decimal
     6075          ,output v-value-integer
     6076          ,output v-value-logical
     6077          ,output v-param-type
     6078          ,input-output table-handle v-tth
     6079         ) no-error .
     6080       if not error-status :error  then do:
     6081         assign
     6082           v-tmp-str = v-value-character
     6083         .
     6084       end.
     6085       delete object v-tth no-error.
     6086       assign
     6087         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
     6088         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
     6089         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
     6090         v-num-entries = num-entries( v-tmp-str, chr(44) )
     6091         v-email       = "":U
     6092       .
     6093       do v-ind = 1 to v-num-entries
     6094       :
     6095         assign
     6096           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
     6097         .
     6098         if trim( v-tmp1-str ) <> "":U then do:
     6099           if v-email = "":U then do:
     6100             assign
     6101               v-email = v-tmp1-str
     6102             .
     6103           end.
     6104           else do:
     6105             assign
     6106               v-email = v-email + chr(44) + v-tmp1-str
     6107             .
     6108           end.
     6109         end.
     6110       end.
     6111       if v-email <> "":U then do:
     6112         run gbl/sendmail.p
     6113           ( input v-email
     6114           , input p-subject
     6115           , input p-text-err
     6116           , input p-attach-files
     6117           ) no-error .
     6118         if error-status :error
     6119           or return-value <> "":U
     6120         then do:
     6121           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
     6122         end.
     6123       end.
     6124     end.
     6125   end procedure.
