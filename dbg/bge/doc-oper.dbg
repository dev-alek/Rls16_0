     4662   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4663   procedure factord :
     4664     define input  parameter p-fact-date            as date    no-undo .
     4665     define input  parameter p-fact-time            as integer no-undo .
     4666     define input  parameter p-fact-num             as integer no-undo .
     4667     define input  parameter p-shift-date           as date    no-undo .
     4668     define input  parameter p-shift-num            as integer no-undo .
     4669     define input  parameter p-shift-on             as logical no-undo .
     4670     define output parameter p-fact-order           as decimal no-undo .
     4671     define output parameter p-shift-end-fact-order as decimal no-undo .
     4672     define output parameter p-day-end-fact-order   as decimal no-undo .
     4673     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     4674     if p-fact-date = ?
     4675     then do:
     4676       return error "Не указана фактическая дата" .
     4677     end.
     4678     define variable v-fact-date-num as integer no-undo .
     4679     assign
     4680       v-fact-date-num = integer(p-fact-date)
     4681     .
     4682     if p-fact-num = ?
     4683     or p-fact-num = 0
     4684     then do:
     4685       return error "Не задан p-fact-num " + string(p-fact-num) .
     4686     end.
     4687     if p-fact-num < 0
     4688     then do:
     4689       return error "Отрицательный fact-num " + string(p-fact-num) .
     4690     end.
     4691     if p-fact-num >= 100000000
     4692     then do:
     4693       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     4694     end.
     4695     if p-shift-on = true
     4696     then do:
     4697       if p-shift-date = ?
     4698       then do:
     4699         return error "Не задана дата смены" .
     4700       end.
     4701       if p-shift-num = ?
     4702       or p-shift-num = 0
     4703       then do:
     4704         return error "Не задан номер смены" .
     4705       end.
     4706     end.
     4707     else do:
     4708       assign
     4709         p-shift-date = p-fact-date
     4710         p-shift-num  = 24
     4711       .
     4712     end.
     4713     define variable v-shift-offset as integer no-undo .
     4714     if p-shift-date = p-fact-date
     4715     then do:
     4716       assign
     4717         v-shift-offset = 1
     4718       .
     4719     end.
     4720     if p-shift-date < p-fact-date
     4721     then do:
     4722       assign
     4723         v-shift-offset = 0
     4724       .
     4725     end.
     4726     if p-shift-date > p-fact-date
     4727     then do:
     4728       message
     4729         vss-workfile vss-revision vss-description skip
     4730         "Неправильная дата закрытия смены" skip
     4731         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     4732         view-as alert-box error .
     4733       undo, return error
     4734         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     4735           ,string(p-fact-date, '99/99/9999':U)
     4736           ,string(p-shift-date, '99/99/9999':U)
     4737           )
     4738       .
     4739     end.
     4740     if p-shift-num < 1
     4741     or p-shift-num > 24
     4742     then do:
     4743       message
     4744         vss-workfile vss-revision vss-description skip
     4745         "Неправильный номер смены" skip
     4746         "p-shift-num" p-shift-num skip
     4747         view-as alert-box error .
     4748       undo, return error return-value .
     4749     end.
     4750     assign
     4751       p-fact-order           = v-fact-date-num
     4752                              + v-shift-offset * 0.5
     4753                              + p-shift-num    * 0.02 - 0.01
     4754                              + p-fact-num     * 0.0000000001
     4755       p-shift-end-fact-order = v-fact-date-num
     4756                              + v-shift-offset * 0.5
     4757                              + p-shift-num    * 0.02
     4758       p-day-end-fact-order   = v-fact-date-num
     4759                              + 0.99
     4760     .
     4761     if p-fact-order           <= v-fact-date-num
     4762     or p-shift-end-fact-order <= v-fact-date-num
     4763     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     4764     or p-shift-end-fact-order >= p-day-end-fact-order
     4765     then do:
     4766       message
     4767         vss-workfile vss-revision vss-description skip
     4768         "Внутренняя ошибка при генерации фактического номера" skip
     4769         "p-fact-date"            p-fact-date            skip
     4770         "p-fact-time"            p-fact-time            skip
     4771         "p-fact-num"             p-fact-num             skip
     4772         "p-shift-date"           p-shift-date           skip
     4773         "p-shift-num"            p-shift-num            skip
     4774         "p-shift-on"             p-shift-on             skip
     4775         "p-shift-end-fact-order" p-shift-end-fact-order skip
     4776         "p-day-end-fact-order"   p-day-end-fact-order   skip
     4777         "v-fact-date-num"        v-fact-date-num        skip
     4778         view-as alert-box error .
     4779       undo, return error return-value .
     4780     end.
     4781   end procedure.
     4782   procedure day-begin-fact-order :
     4783     define input  parameter p-fact-date            as date    no-undo .
     4784     define output parameter p-day-begin-fact-order as decimal no-undo .
     4785     do
     4786     on error undo, return error return-value
     4787     :
     4788       if p-fact-date = ?
     4789       then do:
     4790         assign
     4791           p-day-begin-fact-order = 0
     4792         .
     4793       end.
     4794       else do:
     4795         assign
     4796           p-day-begin-fact-order = integer(p-fact-date)
     4797         .
     4798       end.
     4799     end.
     4800   end procedure.
     4801   procedure factord-max-fact-order :
     4802     define output parameter p-max-fact-order as decimal   no-undo .
     4803     do
     4804     on error undo, return error return-value
     4805     :
     4806       run day-begin-fact-order in this-procedure
     4807         (input  date(1, 1, 5000)
     4808         ,output p-max-fact-order
     4809         ) .
     4810     end.
     4811   end procedure.
     4812   procedure factord-cut-archive :
     4813     define input  parameter p-obj-type             as character no-undo .
     4814     define input  parameter p-obj-code             as integer   no-undo .
     4815     define input  parameter p-fact-date            as date      no-undo .
     4816     define output parameter p-shift-on             as logical   no-undo .
     4817     define output parameter p-shift-date           as date      no-undo .
     4818     define output parameter p-shift-num            as integer   no-undo .
     4819     define output parameter p-day-end-fact-order   as decimal   no-undo .
     4820     define output parameter p-shift-end-fact-order as decimal   no-undo .
     4821     define variable v-fact-order as decimal   no-undo .
     4822     define buffer buf_shift-obj for ub.shift-obj .
     4823     do
     4824     on error undo, return error return-value
     4825     :
     4826   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4827   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     4828     (input  p-obj-type
     4829     ,input  p-obj-code
     4830     ,input  'shift-on=request'
     4831     ,output p-shift-on
     4832     ) no-error .
     4833       if error-status :error
     4834       then do:
     4835         message
     4836           vss-workfile vss-revision vss-description skip
     4837           "Ошибка при определении атрибута объекта" skip
     4838           "Объект" p-obj-type p-obj-code skip
     4839           error-status :get-message(1) skip
     4840           return-value skip
     4841           view-as alert-box error .
     4842         undo, return error return-value .
     4843       end.
     4844       if p-shift-on = false
     4845       then do:
     4846         assign
     4847           p-shift-date               = ?
     4848           p-shift-num                = 0
     4849         .
     4850       end.
     4851       else do:
     4852         find first buf_shift-obj share-lock
     4853           where buf_shift-obj.obj-type   = p-obj-type
     4854             and buf_shift-obj.obj-code   = p-obj-code
     4855             and buf_shift-obj.shift-date > p-fact-date
     4856           use-index pi
     4857           no-error .
     4858         if not available buf_shift-obj
     4859         or buf_shift-obj.status_ <> 'зкр':U
     4860         then do:
     4861           message
     4862             vss-workfile vss-revision vss-description skip
     4863             "Невозможно вычислить последнюю смену" skip
     4864             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     4865             "Объект" p-obj-type p-obj-code skip
     4866             "Дата" p-fact-date skip
     4867             view-as alert-box error .
     4868           undo, return error return-value .
     4869         end.
     4870         find last buf_shift-obj share-lock
     4871           where buf_shift-obj.obj-type = p-obj-type
     4872             and buf_shift-obj.obj-code = p-obj-code
     4873             and buf_shift-obj.shift-date <= p-fact-date
     4874           use-index pi
     4875           no-error .
     4876         if available buf_shift-obj
     4877         then do:
     4878           if  buf_shift-obj.status_ = 'зкр':U
     4879           then do:
     4880             assign
     4881               p-shift-date = buf_shift-obj.shift-date
     4882               p-shift-num  = buf_shift-obj.shift-num
     4883             .
     4884           end.
     4885           else do:
     4886             message
     4887               vss-workfile vss-revision vss-description skip
     4888               "Невозможно вычислить последнюю смену" skip
     4889               "Статус смены отличен от статуса" 'зкр':U skip
     4890               "Объект" p-obj-type p-obj-code skip
     4891               "Дата" p-fact-date skip
     4892               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     4893               view-as alert-box error .
     4894             undo, return error return-value .
     4895           end.
     4896         end.
     4897         else do:
     4898           assign
     4899             p-shift-date = p-fact-date - 1
     4900             p-shift-num  = 1
     4901           .
     4902         end.
     4903       end.
     4904       run factord in this-procedure
     4905         (input  p-fact-date
     4906         ,input  1
     4907         ,input  1
     4908         ,input  p-shift-date
     4909         ,input  p-shift-num
     4910         ,input  p-shift-on
     4911         ,output v-fact-order
     4912         ,output p-shift-end-fact-order
     4913         ,output p-day-end-fact-order
     4914         ) no-error .
     4915       if error-status :error
     4916       then do:
     4917         message
     4918           vss-workfile vss-revision vss-description skip
     4919           "Ошибка при вызове процедуры factord"
     4920           error-status :get-message(1) skip
     4921           return-value skip
     4922           view-as alert-box error .
     4923         undo, return error return-value .
     4924       end.
     4925     end.
     4926   end procedure.
     4927   procedure factord-lock-shift :
     4928     define input  parameter p-obj-type  as character no-undo .
     4929     define input  parameter p-obj-code  as integer   no-undo .
     4930     define input  parameter p-fact-date as date      no-undo .
     4931     define parameter buffer buf_shift-obj for ub.shift-obj .
     4932     define variable v-shift-on      as logical   no-undo .
     4933     define variable v-extra-message as character no-undo .
     4934     define variable v-error as character no-undo .
     4935     do
     4936     on error undo, return error return-value
     4937     :
     4938   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4939   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     4940     (input  p-obj-type
     4941     ,input  p-obj-code
     4942     ,input  'shift-on=request'
     4943     ,output v-shift-on
     4944     ) no-error .
     4945       if error-status :error
     4946       then do:
     4947         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     4948         undo, return error v-error .
     4949       end.
     4950       if v-shift-on = true
     4951       then do:
     4952         find first buf_shift-obj share-lock
     4953           where buf_shift-obj.obj-type   = p-obj-type
     4954             and buf_shift-obj.obj-code   = p-obj-code
     4955             and buf_shift-obj.shift-date > p-fact-date
     4956           use-index pi
     4957           no-error .
     4958         if not available buf_shift-obj
     4959         or buf_shift-obj.status_ <> 'зкр':U
     4960         then do:
     4961           find last buf_shift-obj
     4962             where buf_shift-obj.obj-type = p-obj-type
     4963               and buf_shift-obj.obj-code = p-obj-code
     4964               and buf_shift-obj.status_  = 'зкр':U
     4965             use-index stts
     4966             no-error .
     4967           if available buf_shift-obj
     4968           then do:
     4969             assign
     4970               v-extra-message =
     4971                     substitute("Дата начала последеней закрытой смены на объекте &1"
     4972                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     4973                               )
     4974             .
     4975           end.
     4976           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     4977           undo, return error v-error .
     4978         end.
     4979       end.
     4980     end.
     4981   end procedure.
     4982   procedure factord-end-day :
     4983     define input  parameter p-fact-date            as date    no-undo .
     4984     define output parameter p-day-end-fact-order   as decimal no-undo .
     4985     do
     4986     on error undo, return error return-value
     4987     :
     4988       if p-fact-date = ?
     4989       then do:
     4990         return error "Не указана фактическая дата" .
     4991       end.
     4992       assign
     4993         p-day-end-fact-order = integer(p-fact-date) + 0.99
     4994       .
     4995     end.
     4996   end procedure.
     4997   procedure factord-to-date :
     4998     define input  parameter p-fact-order as decimal no-undo .
     4999     define output parameter p-fact-date  as date    no-undo .
     5000     define variable v-ref-date  as date      no-undo .
     5001     define variable v-ref-delta as integer   no-undo .
     5002     do
     5003     on error undo, return error return-value
     5004     :
     5005       if p-fact-order = ?
     5006       or p-fact-order = 0
     5007       then do:
     5008         return error "Не указан fact-order" .
     5009       end.
     5010       assign
     5011         v-ref-date  = date(1, 1, 2000)
     5012       .
     5013       assign
     5014         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     5015       .
     5016       assign
     5017         p-fact-date = v-ref-date + v-ref-delta
     5018       .
     5019     end.
     5020   end procedure.
     5021   procedure factord-to-fact-num :
     5022     define input  parameter p-fact-order as decimal no-undo .
     5023     define output parameter p-fact-num   as integer no-undo .
     5024     define variable v-fact-order-trunc as decimal no-undo .
     5025     do
     5026     on error undo, return error return-value
     5027     :
     5028       if p-fact-order = ?
     5029       or p-fact-order = 0
     5030       then do:
     5031         return error "Не указан fact-order" .
     5032       end.
     5033       assign
     5034        v-fact-order-trunc = truncate(p-fact-order, 2)
     5035       .
     5036       assign
     5037         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     5038       .
     5039     end.
     5040   end procedure.
     5041   procedure factord-to-shift-num :
     5042     define input  parameter p-fact-order as decimal no-undo .
     5043     define output parameter p-shift-num   as integer no-undo .
     5044     define variable  p-shift-numd  as decimal   no-undo .
     5045     define variable v-fact-order-trunc as decimal no-undo .
     5046     do
     5047     on error undo, return error return-value
     5048     :
     5049       if p-fact-order = ?
     5050       or p-fact-order = 0
     5051       then do:
     5052         return error "Не указан fact-order" .
     5053       end.
     5054       assign
     5055        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     5056       .
     5057       if v-fact-order-trunc < 0.5 then do:
     5058         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     5059       end.
     5060       assign
     5061         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     5062         .
     5063        assign
     5064         p-shift-num = truncate (p-shift-numd , 0)
     5065       .
     5066     end.
     5067   end procedure.
