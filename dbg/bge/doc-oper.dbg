     6546   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6547   define NEW SHARED temp-table temp-cpa-pcep no-undo
     6548   field cdpay-code like ub.cash-pay.cdpay-code
     6549   field curr-code like ub.cash-pay.cdpay-code
     6550   field prefix as character
     6551   index pi is primary
     6552   cdpay-code
     6553   curr-code
     6554   .
     6555   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6556   procedure cpapcep:
     6557   define variable ii as integer no-undo .
     6558   define buffer buf_cash-pay for ub.cash-pay.
     6559   define buffer buf_cash-pay-attr for ub.cash-pay-attr.
     6560   define buffer buf_temp-cpa-pcep for temp-cpa-pcep.
     6561     do
     6562     on error undo, return error
     6563     :
     6564        for each buf_cash-pay-attr no-lock where
     6565               buf_Cash-pay-attr.attr-code = 'paycard-export-prefix':U:
     6566          do ii = 1 to num-entries(buf_Cash-pay-attr.attr-value):
     6567           create buf_temp-cpa-pcep.
     6568           assign
     6569           buf_temp-cpa-pcep.cdpay-code = buf_cash-pay-attr.cdpay-code
     6570           buf_temp-cpa-pcep.curr-code = buf_cash-pay-attr.curr-code
     6571           buf_temp-cpa-pcep.prefix = entry(ii, buf_Cash-pay-attr.attr-value)
     6572           .
     6573         end.
     6574       end.
     6575     end.
     6576   end procedure.
