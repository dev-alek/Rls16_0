      103   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      104   procedure cur-time :
      105      define output parameter p-today as date      no-undo .
      106      define output parameter p-time  as integer   no-undo .
      107     do
      108     on error undo, return error
      109     :
      110       define variable v-date1 as date      no-undo .
      111       define variable v-date2 as date      no-undo .
      112       define variable v-time  as integer   no-undo .
      113       assign
      114         v-date1 = today
      115         v-time  = time
      116         v-date2 = today
      117       .
      118       if v-date1 <> v-date2
      119       then do:
      120         assign
      121           v-date1 = today
      122           v-time  = v-time
      123         .
      124       end.
      125       assign
      126         p-today = v-date1
      127         p-time  = v-time
      128       .
      129     end.
      130   end.
      131   function cur-time-date returns character
      132   :
      133     return string(today, '99/99/9999':U) .
      134   end.
      135   function cur-time-mjd returns decimal
      136   :
      137     define variable v-date as date      no-undo .
      138     define variable v-time as integer   no-undo .
      139     run cur-time in this-procedure
      140       (output v-date
      141       ,output v-time
      142       ) .
      143     return integer(v-date) - 2400002 + (v-time / 86400) .
      144   end.
      145   function cur-time-get-ending-index returns integer
      146   (input p-number as integer
      147   )
      148   :
      149     if p-number < 0
      150     or p-number = ?
      151     then do:
      152       return 1 .
      153     end.
      154     define variable v-rest as integer   no-undo .
      155     assign
      156       p-number = p-number modulo 100
      157     .
      158     if p-number < 20
      159     then do:
      160       assign
      161         v-rest = p-number
      162       .
      163     end.
      164     else do:
      165       assign
      166         v-rest = p-number modulo 10
      167       .
      168     end.
      169     case v-rest :
      170       when 1
      171       then do:
      172         return 2 .
      173       end.
      174       when 2 or
      175       when 3 or
      176       when 4
      177       then do:
      178         return 3 .
      179       end.
      180       otherwise do:
      181         return 1 .
      182       end.
      183     end case .
      184   end.
      185   procedure cur-time-mjd-to-date :
      186      define input  parameter i-mjd-diff as decimal no-undo.
      187      define output parameter o-Date     as date    no-undo.
      188      define output parameter o-Time     as integer no-undo.
      189      define variable v-day-number as integer   no-undo .
      190      if    i-mjd-diff < 0
      191         or i-mjd-diff = ?
      192      then do:
      193         return "?" .
      194      end.
      195      assign
      196         v-day-number = truncate(i-mjd-diff,0).
      197         o-Date = date(v-day-number + 2400002).
      198         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      199     .
      200   end.
      201   function cur-time-mjd-to-string returns character
      202   (input p-mjd-diff as decimal
      203   )
      204   :
      205     define variable v-day-number as integer   no-undo .
      206     define variable v-seconds    as integer   no-undo .
      207     define variable v-hour       as integer   no-undo .
      208     define variable v-min        as integer   no-undo .
      209     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      210     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      211     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      212     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      213     if p-mjd-diff < 0
      214     or p-mjd-diff = ?
      215     then do:
      216       return "?" .
      217     end.
      218     assign
      219       v-day-number = integer(truncate(p-mjd-diff,0))
      220       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      221     .
      222     if v-seconds > 86400
      223     then do:
      224       assign
      225         v-seconds = 86400 - 1
      226       .
      227     end.
      228     if v-seconds < 0
      229     then do:
      230       assign
      231         v-seconds = 0
      232       .
      233     end.
      234     assign
      235       v-hour = truncate(v-seconds / 3600, 0)
      236     .
      237     assign
      238       v-seconds = v-seconds modulo 3600
      239     .
      240     assign
      241       v-min = truncate(v-seconds / 60, 0)
      242     .
      243     assign
      244       v-seconds = v-seconds modulo 60
      245     .
      246     return
      247         (if v-day-number <> 0
      248           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      249           else ""
      250         )
      251       + (if v-day-number <> 0 or v-hour <> 0
      252           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      253           else ""
      254         )
      255       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      256           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      257           else ""
      258         )
      259       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      260       .
      261   end.
      262   function cur-time-string returns character
      263   :
      264     define variable v-date as date      no-undo .
      265     define variable v-time as integer   no-undo .
      266     run cur-time in this-procedure
      267       (output v-date
      268       ,output v-time
      269       ) .
      270     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      271   end.
      272   function cur-time-string-sec returns character
      273   :
      274     define variable v-date as date      no-undo .
      275     define variable v-time as integer   no-undo .
      276     run cur-time in this-procedure
      277       (output v-date
      278       ,output v-time
      279       ) .
      280     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      281   end.
      282   function cur-time-custom  returns character
      283   (input p-prefix as character
      284   ,input p-date-format as character
      285   ,input p-delimiter as character
      286   ,input p-time-format as character
      287   ,input p-suffix as character
      288   )
      289   :
      290     define variable v-date as date      no-undo .
      291     define variable v-time as integer   no-undo .
      292     run cur-time in this-procedure
      293       (output v-date
      294       ,output v-time
      295       ) .
      296     return
      297       p-prefix
      298       + string(v-date, p-date-format)
      299       + p-delimiter
      300       + string(v-time, p-time-format)
      301       + p-suffix
      302       .
      303   end.
      304   function cur-time-print  returns character
      305   :
      306     define variable v-date as date      no-undo .
      307     define variable v-time as integer   no-undo .
      308     run cur-time in this-procedure
      309       (output v-date
      310       ,output v-time
      311       ) .
      312     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      313   end.
      314   function cur-time-datetime returns datetime
      315   :
      316     define variable v-char as character no-undo .
      317     define variable v-datetime as datetime no-undo .
      318     v-char = cur-time-string().
      319     v-datetime = datetime(v-char).
      320     return  v-datetime.
      321   end.
      322   function cur-time-string-msec returns character
      323   :
      324     define variable v-date as datetime  no-undo .
      325     v-date = now.
      326     return string(v-date) .
      327   end.
      328   define variable vss-include-info2 as character format "X(65)" no-undo
      329   initial "@(#)$Workfile$ $Revision$".
      330   procedure xmlchar-test :
      331   define input parameter p-in-string          as character        no-undo.
      332   define output parameter p-out-string-enc    as character        no-undo.
      333   define output parameter p-out-string-dec    as character        no-undo.
      334   do
      335   on error undo, return error
      336   :
      337          run xmlchar-encode in this-procedure
      338       (
      339             input p-in-string
      340           , output p-out-string-enc
      341       ).
      342          run xmlchar-decode in this-procedure
      343       (
      344             input p-out-string-enc
      345           , output p-out-string-dec
      346       ).
      347   end.
      348   end .
      349   procedure xmlchar-encode :
      350   define input parameter p-in-string      as character        no-undo.
      351   define output parameter p-out-string    as character        no-undo.
      352       define variable v-position      as integer      no-undo.
      353       define variable v-current-char  as character    no-undo.
      354   do
      355   on error undo, return error
      356   :
      357       assign
      358           p-out-string = "":U
      359       .
      360       case p-in-string
      361       :
      362           when ?
      363           then do:
      364               assign
      365                   p-out-string = "?":U
      366               .
      367           end.
      368           when "?":U
      369           then do:
      370               assign
      371                   p-out-string = "&#63;":U
      372               .
      373           end.
      374           otherwise do:
      375               do v-position = 1 to length( p-in-string )
      376               :
      377                   assign
      378                       v-current-char = substring( p-in-string, v-position, 1 )
      379                   .
      380                   case v-current-char
      381                   :
      382                       when "&":U
      383                       then do:
      384                           assign
      385                               p-out-string = p-out-string + "&amp;":U
      386                           .
      387                       end.
      388                       when ">":U
      389                       then do:
      390                           assign
      391                               p-out-string = p-out-string + "&gt;":U
      392                           .
      393                       end.
      394                       when "<":U
      395                       then do:
      396                           assign
      397                               p-out-string = p-out-string + "&lt;":U
      398                           .
      399                       end.
      400                       when "'":U
      401                       then do:
      402                           assign
      403                               p-out-string = p-out-string + "&apos;":U
      404                           .
      405                       end.
      406                       when '"':U
      407                       then do:
      408                           assign
      409                               p-out-string = p-out-string + "&quot;":U
      410                           .
      411                       end.
      412                       when chr(1)
      413                       then do:
      414                           assign
      415                               p-out-string = p-out-string + "":U
      416                           .
      417                       end.
      418                       when chr(2)
      419                       then do:
      420                           assign
      421                               p-out-string = p-out-string + "":U
      422                           .
      423                       end.
      424                       when chr(3)
      425                       then do:
      426                           assign
      427                               p-out-string = p-out-string + "":U
      428                           .
      429                       end.
      430                       when chr(4)
      431                       then do:
      432                           assign
      433                               p-out-string = p-out-string + "":U
      434                           .
      435                       end.
      436                       when chr(5)
      437                       then do:
      438                           assign
      439                               p-out-string = p-out-string + "":U
      440                           .
      441                       end.
      442                       when chr(6)
      443                       then do:
      444                           assign
      445                               p-out-string = p-out-string + "":U
      446                           .
      447                       end.
      448                       when chr(7)
      449                       then do:
      450                           assign
      451                               p-out-string = p-out-string + "":U
      452                           .
      453                       end.
      454                       when chr(8)
      455                       then do:
      456                           assign
      457                               p-out-string = p-out-string + "":U
      458                           .
      459                       end.
      460                       when chr(9)
      461                       then do:
      462                           assign
      463                               p-out-string = p-out-string + "":U
      464                           .
      465                       end.
      466                       when chr(29)
      467                       then do:
      468                           assign
      469                               p-out-string = p-out-string + "":U
      470                           .
      471                       end.
      472                       when chr(10)
      473                       then do:
      474                           assign
      475                               p-out-string = p-out-string + "&#10;":U
      476                           .
      477                       end.
      478                       when chr(13)
      479                       then do:
      480                           assign
      481                               p-out-string = p-out-string + "&#13;":U
      482                           .
      483                       end.
      484                       otherwise do:
      485                           assign
      486                               p-out-string = p-out-string + v-current-char
      487                           .
      488                       end.
      489                   end case.
      490               end.
      491           end.
      492       end case.
      493   end.
      494   end .
