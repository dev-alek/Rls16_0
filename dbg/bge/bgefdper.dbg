     1188       .
     1189     end.
     1190     return no-apply.
     1191   end.
     1192   on ctrl-b of date_to in frame Dialog-Frame
     1193   do:
     1194     if (can-query (self, "sensitive")
     1195        and
     1196        self :sensitive = true
     1197        )
     1198     or (can-query (self, "read-only")
     1199        and
     1200        self :read-only = false
     1201        )
     1202     then do:
     1203       if self :handle <> focus :handle
     1204       then do:
     1205         apply "entry":u to self .
     1206       end.
     1207       define variable v-curr-sv-date as date no-undo .
     1208       define variable v-new-sv-date  as date no-undo .
     1209       assign
     1210         v-curr-sv-date = date(self :screen-value) no-error
     1211       .
     1212       if v-curr-sv-date = ?
     1213       then do:
     1214         run gbl/getcurdt.p
     1215           (output v-curr-sv-date
     1216           ) .
     1217       end.
     1218       if v-curr-sv-date <> ?
     1219       then do:
     1220         assign
     1221           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1222         .
     1223         assign
     1224           self :screen-value = string(v-new-sv-date) .
     1225         .
     1226       end.
     1227     end.
     1228     return no-apply .
     1229   end.
     1230   on ctrl-e of date_to in frame Dialog-Frame
     1231   do:
     1232     if (can-query (self, "sensitive")
     1233        and
     1234        self :sensitive = true
     1235        )
     1236     or (can-query (self, "read-only")
     1237        and
     1238        self :read-only = false
     1239        )
     1240     then do:
     1241       if self :handle <> focus :handle
     1242       then do:
     1243         apply "entry":u to self .
     1244       end.
     1245       define variable v-curr-sv-date as date no-undo .
     1246       define variable v-new-sv-date  as date no-undo .
     1247       assign
     1248         v-curr-sv-date = date(self :screen-value) no-error
     1249       .
     1250       if v-curr-sv-date = ?
     1251       then do:
     1252         run gbl/getcurdt.p
     1253           (output v-curr-sv-date
     1254           ) .
     1255       end.
     1256       if v-curr-sv-date <> ?
     1257       then do:
     1258         run gbl/lastdate.p
     1259           (input  v-curr-sv-date
     1260           ,output v-new-sv-date
     1261           ).
     1262         assign
     1263           self :screen-value = string(v-new-sv-date) .
     1264         .
     1265       end.
     1266     end.
     1267     return no-apply .
     1268   end.
     1269   on ctrl-f of date_to in frame Dialog-Frame
     1270   do:
     1271     if (can-query (self, "sensitive")
     1272        and
     1273        self :sensitive = true
     1274        )
     1275     or (can-query (self, "read-only")
     1276        and
     1277        self :read-only = false
     1278        )
     1279     then do:
     1280       if self :handle <> focus :handle
     1281       then do:
     1282         apply "entry":u to self .
     1283       end.
     1284       define variable v-ok            as logical   no-undo .
     1285       define variable v-curr-sv-date  as date      no-undo .
     1286       define variable v-description   as character no-undo .
     1287       assign
     1288         v-curr-sv-date = date(self :screen-value) no-error
     1289       .
     1290       if v-curr-sv-date = ?
     1291       then do:
     1292         run gbl/getcurdt.p
     1293           (output v-curr-sv-date
     1294           ) .
     1295       end.
     1296       if v-curr-sv-date <> ?
     1297       then do:
     1298         run gbl/d-inpday.w
     1299           (input ?
     1300           ,input "Выбор даты"
     1301           ,input v-description
     1302           ,input ""
     1303           ,input-output v-curr-sv-date
     1304           ,output v-ok
     1305           ).
     1306         if v-ok = true
     1307         then do:
     1308           assign
     1309             self :screen-value = string(v-curr-sv-date) .
     1310           .
     1311         end.
     1312       end.
     1313     end.
     1314     return no-apply .
     1315   end.
     1316     define MENU m-ed-date9
     1317       MENU-ITEM m-ed-date9-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1318       MENU-ITEM m-ed-date9-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1319       MENU-ITEM m-ed-date9-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1320       MENU-ITEM m-ed-date9-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1321       .
     1322     if date_to :POPUP-MENU in frame Dialog-Frame = ?
     1323     then do:
     1324       ASSIGN
     1325         date_to :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date9 :HANDLE
     1326         date_to :MENU-MOUSE in frame Dialog-Frame = 3
     1327       .
     1328     end.
     1329     define variable v-label-handle9 as handle no-undo .
     1330     assign
     1331       v-label-handle9 = date_to :side-label-handle in frame Dialog-Frame
     1332     .
     1333     if valid-handle (v-label-handle9)
     1334     then do:
     1335       if v-label-handle9 :tooltip = ""
     1336       or v-label-handle9 :tooltip = ?
     1337       then do:
     1338         assign
     1339           v-label-handle9 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     1340         .
     1341       end.
     1342     end.
     1343     ON CHOOSE OF MENU-ITEM m-ed-date9-1 in menu m-ed-date9 DO:
     1344       apply "ctrl-b":U to date_to in frame Dialog-Frame .
     1345     END.
     1346     ON CHOOSE OF MENU-ITEM m-ed-date9-2 in menu m-ed-date9 DO:
     1347       apply "ctrl-d":U to date_to in frame Dialog-Frame .
     1348     END.
     1349     ON CHOOSE OF MENU-ITEM m-ed-date9-3 in menu m-ed-date9 DO:
     1350       apply "ctrl-e":U to date_to in frame Dialog-Frame .
     1351     END.
     1352     ON CHOOSE OF MENU-ITEM m-ed-date9-4 in menu m-ed-date9 DO:
     1353       apply "ctrl-f":U to date_to in frame Dialog-Frame .
     1354     END.
     1355   run cur-time in this-procedure ( output v-today
     1356                                  , output v-time
     1357                                  ).
     1358   ASSIGN
     1359       date_from = v-today
     1360       date_to   = v-today
     1361   .
     1362   MAIN-BLOCK:
     1363   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1364      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1365   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1366     run mainmenu_getcntxt in parparentproc
     1367       (output v-cntxt-db-num
     1368       ,output v-cntxt-userid
     1369       ,output v-cntxt-level
     1370       ,output v-cntxt-host-code-obj
     1371       ,output v-cntxt-obj-type
     1372       ,output v-cntxt-obj-code
     1373       ,output v-cntxt-db-num-obj
     1374       ,output v-cntxt-is-admin
     1375       ) .
     1376       run get-host-name in this-procedure ( output v-host-name ) no-error .
     1377       if error-status :error
     1378       then do:
     1379           message
     1380             vss-workfile vss-revision vss-description
     1381             skip "Ошибка при определении имени фирмы"
     1382             skip "Код фирмы:" v-cntxt-host-code-obj
     1383             skip "Имя фирмы будет отображаться как '" + 'орг':U + string( v-cntxt-host-code-obj ) + "'"
     1384             skip return-value
     1385             skip trim(error-status :get-message(1))
     1386                  trim(error-status :get-message(2))
     1387                  trim(error-status :get-message(3))
     1388                  trim(error-status :get-message(4))
     1389                  trim(error-status :get-message(5))
     1390           view-as alert-box warning.
     1391           assign
     1392               v-host-name = 'орг':U + string( v-cntxt-host-code-obj )
     1393           .
     1394       end.
     1395     RUN enable_UI.
     1396       assign
     1397           ed-doc-type :screen-value = chr(10) + "    Все"
     1398       .
     1399      run init-fields in this-procedure .
     1400     WAIT-FOR GO OF FRAME Dialog-Frame.
     1401   END.
     1402   RUN disable_UI.
     1403   PROCEDURE clear-obj-list :
     1404     define buffer buf_temp_obj-list for temp_obj-list .
     1405     do
     1406     on error undo, return error return-value
     1407     :
     1408       for each buf_temp_obj-list
     1409       on error undo, return error return-value
     1410       :
     1411         delete buf_temp_obj-list .
     1412       end.
     1413     end.
     1414   END PROCEDURE.
     1415   PROCEDURE disable_UI :
     1416     HIDE FRAME Dialog-Frame.
     1417   END PROCEDURE.
     1418   PROCEDURE enable_UI :
     1419     DISPLAY date_from date_to ed-object rs-1 ed-doc-type
     1420         WITH FRAME Dialog-Frame.
     1421     ENABLE RECT-1 RECT-2 Btn_OK Btn_Cancel b-help date_from date_to rs-1
     1422            bt-sel-host ed-doc-type bt-sel-doc-type
     1423         WITH FRAME Dialog-Frame.
     1424     VIEW FRAME Dialog-Frame.
     1425   END PROCEDURE.
     1426   PROCEDURE fill-obj-list :
     1427     define input  parameter p-host-code as integer   no-undo .
     1428     do
     1429     on error undo, return error
     1430     :
     1431       define buffer buf_clients for ub.clients.
     1432       find first buf_clients no-lock
     1433         where buf_clients.obj-type = 'орг':U
     1434           and buf_clients.obj-code = p-host-code
     1435         no-error .
     1436       if not available buf_clients
     1437       then do:
     1438         message
     1439           vss-workfile vss-revision vss-description skip
     1440           "Ошибка задания входных параметров" skip
     1441           "Не найдена фирма с кодом" p-host-code skip
     1442           view-as alert-box error .
     1443         undo, return error return-value .
     1444       end.
     1445       create temp_obj-list.
     1446       assign
     1447         temp_obj-list.obj-type = buf_clients.obj-type
     1448         temp_obj-list.obj-code = buf_clients.obj-code
     1449         temp_obj-list.obj-name = buf_clients.obj-name
     1450       .
     1451     end.
     1452   END PROCEDURE.
     1453   PROCEDURE get-host-name :
     1454   do
     1455   on error undo, return error
     1456   :
     1457   define output parameter p-host-name as character    no-undo.
     1458   define buffer buf_clients   for ub.clients.
     1459       find first buf_clients no-lock
     1460            where buf_clients.obj-type = 'орг':U
     1461              and buf_clients.obj-code = v-cntxt-host-code-obj
     1462       no-error.
     1463       if not available buf_clients
     1464       then do:
     1465           message
     1466             vss-workfile vss-revision vss-description
     1467             skip "Не удалось найти текущую фирму"
     1468             skip return-value
     1469             skip trim(error-status :get-message(1))
     1470                  trim(error-status :get-message(2))
     1471                  trim(error-status :get-message(3))
     1472                  trim(error-status :get-message(4))
     1473                  trim(error-status :get-message(5))
     1474           view-as alert-box error.
     1475           undo, return error .
     1476       end.
     1477       else do:
     1478           assign
     1479               p-host-name = buf_clients.obj-name
     1480           .
     1481       end.
     1482   end.
     1483   END PROCEDURE.
     1484   PROCEDURE init-fields :
     1485   do
     1486   on error undo, return error
     1487   :
     1488       define variable v-oper-num     as integer           no-undo.
     1489     define buffer buf_user-host for ub.user-host.
     1490     find first buf_user-host no-lock
     1491       where buf_user-host.db-num    = v-cntxt-db-num
     1492         and buf_user-host.user-id   = v-cntxt-userid
     1493         and buf_user-host.host-code = v-cntxt-host-code-obj
     1494       no-error .
     1495     if available buf_user-host
     1496     then do:
     1497         run clear-obj-list in this-procedure .
     1498         run fill-obj-list in this-procedure
     1499           (input  buf_user-host.host-code
     1500           ) no-error .
     1501     end.
     1502      assign
     1503           p-doc-type-list = p-init-doc-type-list
     1504       .
     1505       assign
     1506           rs-1 :screen-value in frame dialog-frame = "2"
     1507           ed-object :screen-value in frame Dialog-frame = 'орг':U + string( v-cntxt-host-code-obj ) + " " + v-host-name
     1508       .
     1509       assign
     1510           rs-1
     1511       .
     1512       display rs-1
     1513       with frame Dialog-Frame
     1514       .
     1515   if p-init-doc-type-list <> ?
     1516       and p-init-doc-type-list <> ''
     1517       then do:
     1518           do v-oper-num = 1 to 6
     1519           :
     1520               if lookup( v-ext-fin-doc-type-list [v-oper-num * 2], p-init-doc-type-list ) <> 0
     1521               then do:
     1522                   assign
     1523                       ed-doc-type :screen-value in frame Dialog-Frame = ed-doc-type :screen-value in frame Dialog-Frame
     1524                                                   + v-ext-fin-doc-type-list [v-oper-num * 2 - 1] + chr(10)
     1525                   .
     1526               end.
     1527           end.
     1528       end.
     1529   end.
     1530   END PROCEDURE.
     1531   PROCEDURE object-select :
     1532   do
     1533   on error undo, return error
     1534   :
     1535   case rs-1 :screen-value in frame Dialog-frame
     1536   :
     1537       when "1"
     1538       then do:
     1539           assign
     1540               ed-object :screen-value = ""
     1541           .
     1542       end.
     1543       when "2"
     1544       then do:
     1545           for each temp_obj-list
     1546           :
     1547               delete temp_obj-list.
     1548           end.
     1549           create temp_obj-list.
     1550           assign
     1551               temp_obj-list.obj-type = 'орг':U
     1552               temp_obj-list.obj-code = v-cntxt-host-code-obj
     1553               ed-object :screen-value = temp_obj-list.obj-type + string(temp_obj-list.obj-code) + chr(32) + "(":U + v-host-name + ")":U
     1554           .
     1555       end.
     1556   end case.
     1557   end.
     1558   END PROCEDURE.
