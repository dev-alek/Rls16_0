      580        SIZE 55.3 BY 2.17.
      581   DEFINE FRAME Dialog-Frame
      582        Btn_OK AT ROW 1.27 COL 1.5
      583        Btn_Cancel AT ROW 1.27 COL 11.5
      584        b-help AT ROW 1.27 COL 47.5
      585        date_from AT ROW 3.13 COL 8.3 COLON-ALIGNED
      586        date_to AT ROW 3.13 COL 25.1 COLON-ALIGNED
      587        ed-object AT ROW 4.97 COL 18.5 NO-LABEL
      588        rs-1 AT ROW 5.03 COL 3 NO-LABEL
      589        bt-sel-host AT ROW 7 COL 15
      590        ed-doc-type AT ROW 12.13 COL 16.3 NO-LABEL
      591        bt-sel-doc-type AT ROW 12.17 COL 52.8
      592        "документов" VIEW-AS TEXT
      593             SIZE 12 BY .87 AT ROW 13.07 COL 2.3
      594        "Типы" VIEW-AS TEXT
      595             SIZE 12 BY .87 AT ROW 12.2 COL 2.1
      596        RECT-1 AT ROW 4.43 COL 1.9
      597        RECT-2 AT ROW 12 COL 1.5
      598        SPACE(1.44) SKIP(0.24)
      599       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      600            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      601            TITLE "Диапазон дат для экспорта".
      602   ASSIGN
      603          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      604          FRAME Dialog-Frame:HIDDEN           = TRUE.
      605   ASSIGN
      606          ed-doc-type:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      607   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      608   DO:
      609     APPLY "END-ERROR":U TO SELF.
      610   END.
      611   ON CHOOSE OF bt-sel-doc-type IN FRAME Dialog-Frame
      612   DO:
      613       define variable v-cancel     as logical           no-undo.
      614       define variable v-oper-num   as integer           no-undo.
      615       run bge/bgeseltp.w (
      616             input "fin-doc":U
      617           , input p-init-doc-type-list
      618           , output p-doc-type-list
      619           , output v-cancel
      620       ) no-error.
      621       if error-status :error
      622       then do:
      623           message
      624             vss-workfile vss-revision vss-description
      625             skip "Ошибка выбора типов операций."
      626             skip return-value
      627             skip trim(error-status :get-message(1))
      628                  trim(error-status :get-message(2))
      629                  trim(error-status :get-message(3))
      630                  trim(error-status :get-message(4))
      631                  trim(error-status :get-message(5))
      632           view-as alert-box error.
      633           undo, return no-apply .
      634       end.
      635       if v-cancel = yes
      636       then do:
      637           assign
      638               p-doc-type-list = p-init-doc-type-list
      639           .
      640       end.
      641       else do:
      642           assign
      643               p-init-doc-type-list    = p-doc-type-list
      644           .
      645           if p-doc-type-list = ''
      646           then do:
      647               assign
      648                   ed-doc-type :screen-value in frame Dialog-Frame = "Все"
      649               .
      650           end.
      651           else do:
      652               assign
      653                   ed-doc-type :screen-value in frame Dialog-Frame = ''
      654               .
      655               do v-oper-num = 1 to 6
      656               :
      657                   if lookup( v-ext-fin-doc-type-list [v-oper-num * 2], p-init-doc-type-list ) <> 0
      658                   then do:
      659                       assign
      660                           ed-doc-type :screen-value in frame Dialog-Frame = ed-doc-type :screen-value in frame Dialog-Frame
      661                                                       + v-ext-fin-doc-type-list [v-oper-num * 2 - 1] + chr(10)
      662                       .
      663                   end.
      664               end.
      665           end.
      666       end.
      667   END.
      668   ON CHOOSE OF bt-sel-host IN FRAME Dialog-Frame
      669   DO:
      670       assign
      671           rs-1 :screen-value  = "2"
      672       .
      673       define buffer buf_user-host for ub.user-host .
      674       define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
      675       find first buf_user-host no-lock
      676         where buf_user-host.db-num    = v-cntxt-db-num
      677           and buf_user-host.user-id   = v-cntxt-userid
      678           and buf_user-host.host-code = v-cntxt-host-code-obj
      679         no-error .
      680       if available buf_user-host
      681       then do:
      682         run userhsts_clear in this-procedure .
      683         run userhsts_append in this-procedure
      684           (input v-cntxt-host-code-obj
      685           ) .
      686       end.
      687       define variable v-user-select as logical   no-undo .
      688   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      689   run userhsts_select-many in this-procedure
      690     (input  parparentproc
      691     ,input  v-cntxt-db-num
      692     ,input  v-cntxt-userid
      693     ,input  v-cntxt-host-code-obj
      694     ,output v-user-select
      695     )  .
      696       if v-user-select <> true
      697       then do:
      698         return no-apply .
      699       end.
      700       run clear-obj-list in this-procedure .
      701       for each buf_userhsts_temp-user-host
      702       :
      703         run fill-obj-list in this-procedure
      704           (input buf_userhsts_temp-user-host.host-code
      705           ) no-error .
      706         if error-status :error
      707         then do:
      708           return no-apply.
      709         end.
      710       end.
      711       assign
      712           v-obj-list = ""
      713       .
      714       for each temp_obj-list:
      715           assign v-obj-list = v-obj-list + (if v-obj-list <> "" then chr(10) else "" )
      716                              + temp_obj-list.obj-type + string( temp_obj-list.obj-code ) + chr(32)
      717                              + temp_obj-list.obj-name
      718                                       .
      719       end.
      720       assign
      721           ed-object :screen-value = v-obj-list
      722       .
      723   END.
      724   ON CHOOSE OF Btn_Cancel IN FRAME Dialog-Frame
      725   DO:
      726       assign
      727           p-cancel = yes
      728       .
      729       apply "window-close" to frame Dialog-Frame.
      730   END.
      731   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
      732   DO:
      733       ASSIGN
      734           date_from
      735           date_to
      736           rs-1
      737           date_exp_from = date_from
      738           date_exp_to   = date_to
      739       .
      740       if date_from > date_to
      741       then do:
      742           message
      743               "Даты интервала заданы неверно. "
      744               skip " Нижняя дата интервала должна быть меньше верхней."
      745               skip(1) "Задайте интервал дат правильно или отмените экспорт."
      746           view-as alert-box information.
      747           apply "entry" to date_from.
      748           undo, return no-apply.
      749       end.
      750         case rs-1 :screen-value
      751         :
      752         when "1"
      753         then do:
      754             assign
      755                 p-range = 1
      756                 p-obj-list = ""
      757             .
      758         end.
      759         when "2"
      760         then do:
      761             assign
      762                 p-range = 2
      763             .
      764             assign
      765                 p-obj-list = ""
      766             .
      767             for each temp_obj-list
      768             :
      769                 assign
      770                     p-obj-list = p-obj-list
      771                             + ( if p-obj-list = "" then "" else "," ) + temp_obj-list.obj-type
      772                             + "," + string( temp_obj-list.obj-code )
      773                 .
      774             end.
      775         end.
      776         end case.
      777      APPLY "GO" TO FRAME Dialog-Frame.
      778   END.
      779   ON RETURN OF date_from IN FRAME Dialog-Frame
      780   DO:
      781       APPLY "ENTRY" TO date_to IN FRAME Dialog-Frame.
      782       RETURN NO-APPLY.
      783   END.
      784   ON RETURN OF date_to IN FRAME Dialog-Frame
      785   DO:
      786       APPLY "ENTRY" TO btn_OK IN FRAME Dialog-Frame.
      787       RETURN NO-APPLY.
      788   END.
      789   ON VALUE-CHANGED OF rs-1 IN FRAME Dialog-Frame
      790   DO:
      791   run object-select in this-procedure no-error .
      792   if error-status :error
      793   then do:
      794       undo, return no-apply.
      795   end.
      796   assign
      797       rs-1
      798   .
      799   END.
      800   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      801   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      802   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      803   on help of frame Dialog-Frame
      804   do:
      805     run gbl/app_help.p
      806       (input this-procedure :file-name
      807       ,input ''
      808       ,input ?
      809       ) no-error.
      810     if error-status :error then do:
      811       message
      812         "Ошибка при вызове помощи"
      813         error-status :get-message(1)
      814         view-as alert-box .
      815     end.
      816   end.
      817   run minbtn-set in this-procedure .
      818   on choose of b-help in frame Dialog-Frame
      819   do:
      820     apply "help":u to frame Dialog-Frame .
      821   end.
      822   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      823   procedure minbtn-set :
      824       do
      825           on error undo, return error return-value
      826           :
      827           define variable ii              as integer       no-undo .
      828           define variable fh              as widget-handle no-undo .
      829           define variable hh              as widget-handle no-undo .
      830           define variable v-h             as handle        extent 4 no-undo .
      831           define variable v-name-button   as character     no-undo .
      832           define variable v-help-old-x    as decimal       no-undo .
      833           define variable v-help-old-y    as decimal       no-undo .
      834           define variable v-help-old-size as decimal       no-undo .
      835           define variable v-frame-width   as decimal       no-undo .
      836           define variable jj              as integer       no-undo .
      837           do
      838               on error undo, return error
      839               :
      840               assign
      841                   v-frame-width = frame Dialog-Frame:width - 0.3
      842                   fh            = frame Dialog-Frame:first-child
      843                   hh            = fh:first-child
      844                   ii            = 1
      845                   .
      846               do while valid-handle(hh):
      847                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      848                   do:
      849                       case lc(hh:name) :
      850                           when "b-help" then
      851                               do:
      852                                   hh:load-image-up("cmp/b-help.bmp":u) .
      853                                   hh:load-image-down("cmp/b-help.bmp":u) .
      854                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      855                                   hh:TOOLTIP = "Помощь" .
      856                                   v-help-old-x = hh:column .
      857                                   v-help-old-y = hh:row    .
      858                                   v-help-old-size = hh:width .
      859                                   hh:width-chars = 2.5 .
      860                               end.
      861                           when "b-print" then
      862                               do:
      863                                   hh:load-image("cmp/b-print.bmp":u) .
      864                                   hh:TOOLTIP = "Печать" .
      865                                   v-h[ii] = hh:handle .
      866                                   ii = ii + 1 .
      867                                   hh:width-chars = 3 .
      868                               end.
      869                           when "b-history" or
      870                           when "b-hist" then
      871                               do:
      872                                   hh:load-image("cmp/b-hist.bmp":u) .
      873                                   hh:TOOLTIP = "История" .
      874                                   v-h[ii] = hh:handle .
      875                                   ii = ii + 1 .
      876                                   hh:width-chars = 3 .
      877                               end.
      878                           when "b-sch" then
      879                               do:
      880                                   hh:load-image("cmp/b-sch.bmp":u) .
      881                                   hh:TOOLTIP = "Установка Фильтра" .
      882                                   v-h[ii] = hh:handle .
      883                                   ii = ii + 1 .
      884                                   hh:width-chars = 3 .
      885                               end.
      886                           when "b-hist-user" then
      887                               do:
      888                                   hh:load-image("cmp/b-hist.bmp":u) .
      889                                   hh:TOOLTIP = "История пользователя" .
      890                                   ii = ii + 1 .
      891                               end.
      892                       end case.
      893                   end.
      894                   hh = hh:next-sibling.
      895               end.
      896               b-help:column = v-frame-width - b-help:width-chars.
      897               jj = 0.
      898               repeat ii = 4 to 1 by -1 :
      899                   if valid-handle (v-h[ii] ) then
      900                   do:
      901                       jj  = jj + 1 .
      902                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      903                       v-h[ii]:row    = v-help-old-y .
      904                   end.
      905               end.
      906           end.
      907       end.
      908   end procedure.
      909   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      910   on ' ' of date_from in frame Dialog-Frame
      911   do:
      912     if (can-query (self, "sensitive")
      913        and
      914        self :sensitive = true
      915        )
      916     or (can-query (self, "read-only")
      917        and
      918        self :read-only = false
      919        )
      920     then do:
      921       assign
      922         self :screen-value = ?
      923       .
      924     end.
      925     return no-apply.
      926   end.
      927   on delete-character of date_from in frame Dialog-Frame
      928   do:
      929     if (can-query (self, "sensitive")
      930        and
      931        self :sensitive = true
      932        )
      933     or (can-query (self, "read-only")
      934        and
      935        self :read-only = false
      936        )
      937     then do:
      938       assign
      939         self :screen-value = ?
      940       .
      941     end.
      942     return no-apply.
      943   end.
      944   on ctrl-d of date_from in frame Dialog-Frame
      945   do:
      946     define variable v-curr-sv-date as date no-undo .
      947     if (can-query (self, "sensitive")
      948        and
      949        self :sensitive = true
      950        )
      951     or (can-query (self, "read-only")
      952        and
      953        self :read-only = false
      954        )
      955     then do:
      956       if self :handle <> focus :handle
      957       then do:
      958         apply "entry":u to self .
      959       end.
      960       run gbl/getcurdt.p
      961         (output v-curr-sv-date
      962         ) .
      963       assign
      964         self :screen-value = string(v-curr-sv-date) .
      965       .
      966     end.
      967     return no-apply.
      968   end.
      969   on ctrl-b of date_from in frame Dialog-Frame
      970   do:
      971     if (can-query (self, "sensitive")
      972        and
      973        self :sensitive = true
      974        )
      975     or (can-query (self, "read-only")
      976        and
      977        self :read-only = false
      978        )
      979     then do:
      980       if self :handle <> focus :handle
      981       then do:
      982         apply "entry":u to self .
      983       end.
      984       define variable v-curr-sv-date as date no-undo .
      985       define variable v-new-sv-date  as date no-undo .
      986       assign
      987         v-curr-sv-date = date(self :screen-value) no-error
      988       .
      989       if v-curr-sv-date = ?
      990       then do:
      991         run gbl/getcurdt.p
      992           (output v-curr-sv-date
      993           ) .
      994       end.
      995       if v-curr-sv-date <> ?
      996       then do:
      997         assign
      998           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      999         .
     1000         assign
     1001           self :screen-value = string(v-new-sv-date) .
     1002         .
     1003       end.
     1004     end.
     1005     return no-apply .
     1006   end.
     1007   on ctrl-e of date_from in frame Dialog-Frame
     1008   do:
     1009     if (can-query (self, "sensitive")
     1010        and
     1011        self :sensitive = true
     1012        )
     1013     or (can-query (self, "read-only")
     1014        and
     1015        self :read-only = false
     1016        )
     1017     then do:
     1018       if self :handle <> focus :handle
     1019       then do:
     1020         apply "entry":u to self .
     1021       end.
     1022       define variable v-curr-sv-date as date no-undo .
     1023       define variable v-new-sv-date  as date no-undo .
     1024       assign
     1025         v-curr-sv-date = date(self :screen-value) no-error
     1026       .
     1027       if v-curr-sv-date = ?
     1028       then do:
     1029         run gbl/getcurdt.p
     1030           (output v-curr-sv-date
     1031           ) .
     1032       end.
     1033       if v-curr-sv-date <> ?
     1034       then do:
     1035         run gbl/lastdate.p
     1036           (input  v-curr-sv-date
     1037           ,output v-new-sv-date
     1038           ).
     1039         assign
     1040           self :screen-value = string(v-new-sv-date) .
     1041         .
     1042       end.
     1043     end.
     1044     return no-apply .
     1045   end.
     1046   on ctrl-f of date_from in frame Dialog-Frame
     1047   do:
     1048     if (can-query (self, "sensitive")
     1049        and
     1050        self :sensitive = true
     1051        )
     1052     or (can-query (self, "read-only")
     1053        and
     1054        self :read-only = false
     1055        )
     1056     then do:
     1057       if self :handle <> focus :handle
     1058       then do:
     1059         apply "entry":u to self .
     1060       end.
     1061       define variable v-ok            as logical   no-undo .
     1062       define variable v-curr-sv-date  as date      no-undo .
     1063       define variable v-description   as character no-undo .
     1064       assign
     1065         v-curr-sv-date = date(self :screen-value) no-error
     1066       .
     1067       if v-curr-sv-date = ?
     1068       then do:
     1069         run gbl/getcurdt.p
     1070           (output v-curr-sv-date
     1071           ) .
     1072       end.
     1073       if v-curr-sv-date <> ?
     1074       then do:
     1075         run gbl/d-inpday.w
     1076           (input ?
     1077           ,input "Выбор даты"
     1078           ,input v-description
     1079           ,input ""
     1080           ,input-output v-curr-sv-date
     1081           ,output v-ok
     1082           ).
     1083         if v-ok = true
     1084         then do:
     1085           assign
     1086             self :screen-value = string(v-curr-sv-date) .
     1087           .
     1088         end.
     1089       end.
     1090     end.
     1091     return no-apply .
     1092   end.
     1093     define MENU m-ed-date7
     1094       MENU-ITEM m-ed-date7-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1095       MENU-ITEM m-ed-date7-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1096       MENU-ITEM m-ed-date7-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1097       MENU-ITEM m-ed-date7-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1098       .
     1099     if date_from :POPUP-MENU in frame Dialog-Frame = ?
     1100     then do:
     1101       ASSIGN
     1102         date_from :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date7 :HANDLE
     1103         date_from :MENU-MOUSE in frame Dialog-Frame = 3
     1104       .
     1105     end.
