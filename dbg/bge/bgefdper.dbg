     1117         .
     1118       end.
     1119     end.
     1120     ON CHOOSE OF MENU-ITEM m-ed-date7-1 in menu m-ed-date7 DO:
     1121       apply "ctrl-b":U to date_from in frame Dialog-Frame .
     1122     END.
     1123     ON CHOOSE OF MENU-ITEM m-ed-date7-2 in menu m-ed-date7 DO:
     1124       apply "ctrl-d":U to date_from in frame Dialog-Frame .
     1125     END.
     1126     ON CHOOSE OF MENU-ITEM m-ed-date7-3 in menu m-ed-date7 DO:
     1127       apply "ctrl-e":U to date_from in frame Dialog-Frame .
     1128     END.
     1129     ON CHOOSE OF MENU-ITEM m-ed-date7-4 in menu m-ed-date7 DO:
     1130       apply "ctrl-f":U to date_from in frame Dialog-Frame .
     1131     END.
