        1   define input parameter p-esys-id like ub.ext-system.esys-id no-undo.
        2   define input parameter p-db-num like ub.ext-system.db-num no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Просмотр маршрутизации по заданой ВС".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      113   define variable v-waitfram-action01         as character   no-undo .
      114   define variable v-waitfram-action02         as character   no-undo .
      115   define variable v-waitfram-action03         as character   no-undo .
      116   define variable mWaitFramTextBeg            as character   no-undo.
      117   define variable mWaitFramTextEnd            as character   no-undo.
      118   define variable mWaitFramView               as logical     no-undo.
      119   define variable mWaitProcEvent              as logical     no-undo init yes.
      120   define variable mWaitFramInterval           as integer     no-undo init 1 .
      121   define variable mWaitFramStop               as logical     no-undo.
      122   define variable mWaitFramStopUser           as logical     no-undo.
      123   define variable mWaitFramStopTimeOut        as logical     no-undo.
      124   define variable mWaitFramStartProc          as datetime-tz no-undo.
      125   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      126   define button B-WaitFramStop auto-end-key
      127        label "Стоп"
      128        size 10 by 1 tooltip "Остоновить процесс".
      129   define button B-viewProcInfo
      130        label "Информация"
      131        size 15 by 1 tooltip "Информация о процесс".
      132   define frame waitfram
      133     v-waitfram-action01 format "x(72)" no-label skip
      134     v-waitfram-action02 format "x(72)" no-label skip
      135     v-waitfram-action03 format "x(72)" no-label skip
      136     B-viewProcInfo
      137     B-WaitFramStop at row 4 col 30
      138     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      139     .
      140   define new global shared variable mBatchMode as logical no-undo init ?.
      141   define variable mFramBachModHandle as handle no-undo.
      142   mFramBachModHandle = frame waitfram:handle.
      143   define variable mFameOldVis as logical no-undo.
      144   define variable mVisCUrentVin as logical no-undo.
      145   if session:batch-mode
      146   then
      147      mBatchMode = yes.
      148   if mBatchMode = ? then do:
      149     mVisCUrentVin = current-window:visible.
      150     mFameOldVis = mFramBachModHandle:visible.
      151     mFramBachModHandle:visible  = yes.
      152     mBatchMode = mFramBachModHandle:visible ne yes.
      153     mFramBachModHandle:visible = mFameOldVis.
      154     current-window:visible = mVisCUrentVin.
      155   end.
      156    if  log-manager:logfile-name ne ?
      157     then DO:
      158         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      159         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      160         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      161     end.
      162   on choose of B-WaitFramStop in frame waitfram
      163   do:
      164     mWaitFramStop = yes.
      165     mWaitFramStopUser = yes.
      166   end.
      167   function waitfram-check-timeout returns logical():
      168      define variable vtime as int64 no-undo.
      169      if mWaitFramStopTimeOut
      170      then
      171         return yes.
      172      vtime = ( now - mWaitFramStartProc ) / 1000 .
      173      if     mWaitFramTimeOut ne ?
      174         and mWaitFramTimeOut ne 0
      175         and mWaitFramTimeOut lt vtime
      176      then do:
      177         mWaitFramStopTimeOut = yes.
      178      end.
      179      return mWaitFramStopTimeOut.
      180   end.
      181   procedure waitfram-hide :
      182     if not session:batch-mode
      183     then do
      184     on error undo, return error return-value
      185     :
      186       pause 0 before-hide .
      187       if not mBatchMode then
      188         hide frame waitfram .
      189     if     not mWaitFramView
      190        and mWaitProcEvent
      191     then
      192       process events .
      193     end.
      194   end procedure.
      195   procedure waitfram-show :
      196     define input  parameter p-message as character no-undo .
      197     define variable v-left-margin as integer   no-undo .
      198     if not session:batch-mode
      199     then do
      200     on error undo, return error return-value
      201     :
      202       if length(p-message) <= 70 then do:
      203         assign
      204           v-left-margin = integer((70 - length(p-message)) / 2)
      205         .
      206         assign
      207           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      208         .
      209         assign
      210           v-waitfram-action01 = " "
      211           v-waitfram-action02 = " "
      212                                    + fill(" ", v-left-margin)
      213                                    + p-message
      214           v-waitfram-action03 = " "
      215         .
      216       end.
      217       else do:
      218         define variable vRindex1 as integer no-undo.
      219         define variable vRindex2 as integer no-undo.
      220         vRindex1 = r-index(p-message," ",70).
      221         if vRindex1 = 0
      222         then
      223            vRindex1 = 70.
      224         if length(p-message)  <= vRindex1 + 70 then do:
      225           assign
      226             v-waitfram-action01 = " "
      227             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      228             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      229           .
      230         end.
      231         else do:
      232           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      233           if vRindex2 <= vRindex1
      234           then
      235              vRindex2 = vRindex1 + 70.
      236           assign
      237             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      238             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      239             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      240           .
      241         end.
      242       end.
      243       B-viewProcInfo:visible   in frame waitfram = no.
      244       B-viewProcInfo:sensitive in frame waitfram = no.
      245       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      246       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      247       if  (   mWaitFramView
      248          or  mWaitProcEvent)
      249          and not mBatchMode
      250       then
      251          display
      252             v-waitfram-action01 skip
      253             v-waitfram-action02 skip
      254             v-waitfram-action03 skip
      255          with frame waitfram .
      256       if     mWaitFramView
      257          then do:
      258             if     mWaitFramInterval ne ?
      259                and not mBatchMode
      260             then
      261                wait-for go of frame waitfram pause mWaitFramInterval.
      262          end.
      263          else
      264             if     mWaitProcEvent
      265                and not mBatchMode
      266             then
      267                process events .
      268     end.
      269   end procedure.
      270      procedure waitfram-show-this:
      271         define input  parameter iInterval as int64 no-undo.
      272         define variable vtime as int64 no-undo.
      273         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      274         mWaitFramInterval = iInterval.
      275         run waitfram-show (substitute("&1&2 &3&4" ,
      276                                       mWaitFramTextBeg ,
      277                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      278                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      279                                       mWaitFramTextEnd
      280                                      )
      281                           ).
      282      end.
      283      procedure WaitFramRunPause:
      284         define input  parameter iInterval as dec no-undo.
      285         define variable vStart  as datetime-tz no-undo.
      286         define variable vend    as datetime-tz no-undo.
      287         define variable vint as int64 no-undo.
      288         define variable vOk as logical no-undo.
      289         vStart = now.
      290         vend   = vStart.
      291         publish "WaitFramPause" (iInterval,output vOk).
      292         vend   =  now.
      293         vint = vend - vStart.
      294         vint = iInterval - vint / 1000.
      295         if     not mWaitFramStop
      296            and (   vint > 0
      297                 or (    not vOk
      298                     and iInterval eq ?
      299                     )
      300                 )
      301         then
      302            run waitfram-show-this (iInterval).
      303         vend   =  now.
      304         vint = vend - vStart.
      305         vint = iInterval - vint / 1000.
      306         if     not mWaitFramStop
      307            and vint > 0
      308         then do:
      309            run gbl/pause.p (vint * 1000).
      310         end.
      311         if iInterval ne ?
      312         then
      313            publish "WaitFramStop".
      314         waitfram-check-timeout().
      315      end.
      316      procedure WaitFramWaitFor:
      317         define input  parameter iInterval as dec no-undo.
      318         assign
      319            mWaitFramStartProc   = now
      320            mWaitFramStopUser    = no
      321            mWaitFramStopTimeOut = no
      322         .
      323         block-wait:
      324         do while not mWaitFramStop:
      325            run WaitFramRunPause (iInterval).
      326            if  waitfram-check-timeout()
      327            then do:
      328               leave block-wait.
      329            end.
      330         end.
      331         run waitfram-hide.
      332      end.
      333   procedure waitfram-join :
      334     define input  parameter p-line-1  as character no-undo .
      335     define input  parameter p-line-2  as character no-undo .
      336     define input  parameter p-line-3  as character no-undo .
      337     define output parameter p-message as character no-undo .
      338     do
      339     on error undo, return error return-value
      340     :
      341       assign
      342         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      343                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      344                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      345       .
      346     end.
      347   end procedure.
      348   function waitfram-join-function returns character
      349     (input p-line-1 as character
      350     ,input p-line-2 as character
      351     ,input p-line-3 as character
      352     ).
      353     define variable v-message as character no-undo .
      354     run waitfram-join in this-procedure
      355       (input  p-line-1
      356       ,input  p-line-2
      357       ,input  p-line-3
      358       ,output v-message
      359       ) .
      360     return v-message .
      361   end function .
      362   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      363   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      364   define variable tempcxml_v-num_ as integer no-undo .
      365   define  temp-table temp-xml-tables no-undo
      366   field order as integer
      367   field tbl-name as character
      368   field tbl-handle_ as handle
      369   field table-handle_ as handle
      370   field uniq-gate-rec as character
      371   field gate-name as character
      372   field gate-handle_ as handle
      373   field is-parent as logical
      374   index pi is unique primary
      375   uniq-gate-rec
      376   tbl-name
      377   index iorder
      378   order
      379   index gr
      380   uniq-gate-rec
      381   index gh
      382   gate-handle_
      383   index iparent
      384   is-parent
      385   .
      386   define  temp-table temp-xml-records no-undo
      387   field tbl-name as character
      388   field uniq-key-rec as character
      389   index pi is unique primary
      390   tbl-name
      391   uniq-key-rec
      392   .
      393   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      394   procedure gen-key-rec :
      395     define input  parameter p-tbl-name    as character no-undo.
      396     define input  parameter p-bh_tbl-name as handle    no-undo.
      397     define output parameter p-key-rec     as character no-undo.
      398     do
      399     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      400     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      401     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      402     :
      403       define variable fh               as handle    no-undo .
      404       define variable v-ok             as logical   no-undo .
      405       define variable v-inform         as character no-undo .
      406       define variable v-ind            as integer   no-undo .
      407       define variable v-idx-field-qnty as integer   no-undo .
      408       if p-tbl-name = ?
      409         or p-tbl-name = "":U
      410       then do:
      411         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      412       end.
      413       if not p-bh_tbl-name:available then do:
      414         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      415       end.
      416       assign
      417         p-key-rec = p-tbl-name
      418         v-inform  = p-bh_tbl-name:index-information(1)
      419         v-ind     = 2
      420       .
      421       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      422       on error undo, return error
      423       :
      424         assign
      425           v-inform = p-bh_tbl-name:index-information( v-ind )
      426           v-ind    = v-ind + 1
      427         .
      428       end.
      429       if v-inform = ?
      430         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      431         or entry( 3, v-inform, ",":U ) <> "1":U
      432       then do:
      433         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      434       end.
      435       else do:
      436         assign
      437           v-idx-field-qnty = num-entries( v-inform ) - 4
      438         .
      439         if v-idx-field-qnty < 2 then do:
      440           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      441         end.
      442         do v-ind = 1 to v-idx-field-qnty by 2
      443         on error undo, return error
      444         :
      445           assign
      446             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      447             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      448           .
      449         end.
      450       end.
      451       if p-key-rec = ? then do:
      452         assign
      453           p-key-rec = "":U
      454         .
      455         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      456       end.
      457     end.
      458     return.
      459   end procedure.
      460   procedure gen-where-keyr-tab :
      461     define input  parameter i-tableSerach as character no-undo.
      462     define input  parameter i-tablekey   as character  no-undo.
      463     define input  parameter p-key-rec    as character  no-undo.
      464     define input  parameter p-key-handle as handle     no-undo .
      465     define input  parameter p-db-name    as character  no-undo .
      466     define input  parameter p-tt-handle  as handle     no-undo .
      467     define output parameter o-Where      as character  no-undo.
      468     do
      469     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      470     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      471     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      472     :
      473       define variable v-full-tbl-name  as character no-undo .
      474       define variable bh_tbl-name      as handle    no-undo .
      475       define variable fh_key           as handle    no-undo .
      476       define variable fh_search        as handle    no-undo .
      477       define variable v-field-num      as integer   no-undo .
      478       define variable v-count-fld      as integer   no-undo .
      479       define variable v-inform         as character no-undo .
      480       define variable v-ind            as integer   no-undo .
      481       define variable v-idx-field-qnty as integer   no-undo .
      482       define variable v-field-name     as character no-undo .
      483       define variable v-field-val      as character no-undo .
      484       define variable v-word-link      as character no-undo .
      485       define variable vTable           as character no-undo.
      486       define variable bh_tbl-key       as handle    no-undo .
      487       assign
      488         p-key-rec = trim( p-key-rec )
      489       .
      490       if p-key-handle <> ? then do:
      491         if not valid-handle(p-key-handle)
      492            or p-key-handle:type <> "buffer"
      493         then do:
      494           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      495         end.
      496         if num-entries( p-key-rec, chr(3) ) > 1
      497           or p-key-rec = ?
      498           or p-key-rec = "":U
      499         then do:
      500           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      501         end.
      502       end.
      503       else do:
      504         if p-key-rec = ?
      505           or p-key-rec = "":U
      506         then do:
      507           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      508         end.
      509       end.
      510       assign
      511         vTable = entry( 1 , p-key-rec, chr(3) )
      512       .
      513       if p-tt-handle <> ?
      514         and ( not valid-handle(p-tt-handle)
      515               or p-tt-handle:type <> "buffer"
      516             )
      517       then do:
      518         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      519       end.
      520       if p-tt-handle = ? then do:
      521         assign
      522           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      523         .
      524         create buffer bh_tbl-name for table v-full-tbl-name .
      525       end.
      526       else do:
      527         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      528       end.
      529       assign
      530         v-inform = bh_tbl-name:index-information(1)
      531         v-ind    = 2
      532       .
      533       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      534       on error undo, return error
      535       :
      536         assign
      537           v-inform = bh_tbl-name:index-information( v-ind )
      538           v-ind    = v-ind + 1
      539         .
      540       end.
      541       if v-inform = ?
      542         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      543         or entry( 3, v-inform, ",":U ) <> "1":U
      544       then do:
      545         delete object bh_tbl-name no-error.
      546         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      547       end.
      548       assign
      549         v-idx-field-qnty = num-entries( v-inform ) - 4
      550       .
      551       if v-idx-field-qnty < 2 then do:
      552         delete object bh_tbl-name no-error.
      553         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      554       end.
      555       assign
      556         o-where     = "where":U
      557         v-word-link = "":U
      558         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      559         v-count-fld = 0
      560       .
      561       if i-tablekey ne "" and i-tablekey ne ?
      562       then do:
      563         assign
      564           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      565         .
      566         create buffer bh_tbl-key for table v-full-tbl-name .
      567       end.
      568       if i-tableSerach ne "" and i-tableSerach ne ?
      569       then do:
      570         delete object bh_tbl-name no-error.
      571         assign
      572           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      573         .
      574         create buffer bh_tbl-name for table v-full-tbl-name .
      575       end.
      576       block_where:
      577       do v-ind = 1 to v-idx-field-qnty by 2
      578       on error undo, return error
      579       :
      580         assign
      581           v-count-fld = v-count-fld + 1
      582         .
      583         if p-key-handle = ?
      584           and v-count-fld > v-field-num
      585         then do:
      586           leave block_where.
      587         end.
      588         define variable VfieldKeyTable as handle no-undo.
      589         assign
      590           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      591           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      592         .
      593         if     bh_tbl-key ne ?
      594         then do:
      595            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      596            if VfieldKeyTable eq ?
      597            then next block_where.
      598         end.
      599         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      600         then
      601            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      602         else
      603            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      604         if p-key-handle = ? then do:
      605           assign
      606             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      607           .
      608         end.
      609         else do:
      610           assign
      611             fh_key = p-key-handle:buffer-field( v-field-name )
      612           .
      613           if fh_key = ?
      614             or not valid-handle( fh_key )
      615           then do:
      616             delete object bh_tbl-name.
      617             if     bh_tbl-key ne ?
      618             then
      619                delete object bh_tbl-key.
      620             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      621           end.
      622           assign
      623             v-field-val = fh_key:buffer-value
      624           .
      625         end.
      626         if fh_search:data-type ="character":U then do:
      627           assign
      628             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      629             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      630             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      631             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      632             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      633             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      634             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      635             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      636             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      637             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      638             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      639             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      640             v-field-val = substitute( '"&1"', v-field-val )
      641           .
      642         end.
      643         assign
      644           o-where = substitute( "&1 &2", o-where, v-field-val )
      645         .
      646         if v-word-link = "":U then do:
      647           assign
      648             v-word-link = "and":U
      649           .
      650         end.
      651       end.
      652       delete object bh_tbl-name.
      653       if     bh_tbl-key ne ?
      654       then
      655          delete object bh_tbl-key.
      656       if p-key-handle = ?
      657         and v-count-fld <> v-field-num
      658       then do:
      659         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      660       end.
      661     end.
      662   end procedure.
      663   procedure gen-hn-keyr-tab :
      664     define input  parameter i-tableSerach as character no-undo.
      665     define input  parameter i-tablekey   as character no-undo.
      666     define input  parameter p-key-rec    as character no-undo.
      667     define input  parameter p-key-handle as handle    no-undo .
      668     define input  parameter p-db-name    as character no-undo .
      669     define input  parameter p-tt-handle  as handle    no-undo .
      670     define input  parameter p-stts-lock  as integer   no-undo .
      671     define output parameter o-hn         as handle    no-undo.
      672     define variable v-full-tbl-name as character no-undo.
      673     define variable v-where         as character no-undo.
      674     define variable bh_tbl-name     as handle    no-undo.
      675     define variable vTable          as character no-undo.
      676     do
      677     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      678     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      679     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      680         run gen-where-keyr-tab(i-tableSerach,
      681                                i-tablekey,
      682                                p-key-rec,
      683                                p-key-handle,
      684                                p-db-name,
      685                                p-tt-handle,
      686                                output v-where).
      687         if i-tableSerach ne "" and i-tableSerach ne ?
      688         then do:
      689            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      690            create buffer bh_tbl-name for table v-full-tbl-name .
      691         end.
      692         else do:
      693            if p-tt-handle = ? then do:
      694               assign
      695                  vTable = entry( 1 , p-key-rec, chr(3) )
      696               .
      697               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      698               create buffer bh_tbl-name for table v-full-tbl-name .
      699            end.
      700            else do:
      701               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      702            end.
      703         end.
      704         if p-tt-handle = ? then do:
      705            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      706         end.
      707         else do:
      708            bh_tbl-name:find-first( v-where ) no-error .
      709         end.
      710         o-hn = bh_tbl-name.
      711      end.
      712   end procedure.
      713   procedure gen-hn-keyr :
      714     define input  parameter p-key-rec    as character no-undo.
      715     define input  parameter p-key-handle as handle    no-undo .
      716     define input  parameter p-db-name    as character no-undo .
      717     define input  parameter p-tt-handle  as handle    no-undo .
      718     define input  parameter p-stts-lock  as integer   no-undo .
      719     define output parameter o-hn         as handle    no-undo.
      720     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      721   end.
      722   procedure gen-row-keyr :
      723     define input  parameter p-key-rec    as character no-undo.
      724     define input  parameter p-key-handle as handle    no-undo .
      725     define input  parameter p-db-name    as character no-undo .
      726     define input  parameter p-tt-handle  as handle    no-undo .
      727     define input  parameter p-stts-lock  as integer   no-undo .
      728     define output parameter p-tbl-row    as rowid     no-undo.
      729     define output parameter p-tbl-name   as character no-undo.
      730     define variable vHn as handle no-undo.
      731       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      732       p-tbl-row = if vHn:available then vHn:rowid else ?.
      733       p-tbl-name =  vHn:table.
      734       delete object vHn no-error.
      735     if p-tbl-row = ? then do:
      736       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      737     end.
      738     else do:
      739       return.
      740     end.
      741   end procedure.
      742   procedure gen-key-fv :
      743     define input  parameter p-key-rec    as character no-undo .
      744     define output parameter p-field-list as character no-undo .
      745     define output parameter p-value-list as character no-undo.
      746     do
      747     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      748     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      749     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      750     :
      751       define variable v-full-tbl-name  as character no-undo .
      752       define variable bh_tbl-name      as handle    no-undo .
      753       define variable v-tbl-name       as character no-undo .
      754       define variable v-field-num      as integer   no-undo .
      755       define variable v-count-fld      as integer   no-undo .
      756       define variable v-inform         as character no-undo .
      757       define variable v-ind            as integer   no-undo .
      758       define variable v-idx-field-qnty as integer   no-undo .
      759       define variable v-delim-key      as character no-undo .
      760       if p-key-rec = ?
      761         or p-key-rec = "":U
      762       then do:
      763         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      764       end.
      765       assign
      766         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      767         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      768       .
      769       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      770       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      771       assign
      772         v-inform = bh_tbl-name:index-information(1)
      773         v-ind    = 2
      774       .
      775       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      776       on error undo, return error
      777       :
      778         assign
      779           v-inform = bh_tbl-name:index-information( v-ind )
      780           v-ind    = v-ind + 1
      781         .
      782       end.
      783       if v-inform = ?
      784         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      785         or entry( 3, v-inform, ",":U ) <> "1":U
      786       then do:
      787         delete object bh_tbl-name no-error.
      788         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      789       end.
      790       assign
      791         v-idx-field-qnty = num-entries( v-inform ) - 4
      792       .
      793       if v-idx-field-qnty < 2 then do:
      794         delete object bh_tbl-name no-error.
      795         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      796       end.
      797       assign
      798         p-field-list = "":U
      799         p-value-list = "":U
      800         v-delim-key  = "":U
      801         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      802         v-count-fld  = 0
      803       .
      804       block_where:
      805       do v-ind = 1 to v-idx-field-qnty by 2
      806       on error undo, return error
      807       :
      808         assign
      809           v-count-fld = v-count-fld + 1
      810         .
      811         if v-count-fld > v-field-num then do:
      812           leave block_where.
      813         end.
      814         assign
      815           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      816           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      817         .
      818         if v-ind = 1 then do:
      819           assign
      820             v-delim-key = chr(3)
      821           .
      822         end.
      823       end.
      824       delete object bh_tbl-name.
      825       if v-count-fld <> v-field-num then do:
      826         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      827       end.
      828     end.
      829   end procedure.
      830   procedure gen-key-field :
      831     define input  parameter p-table      as character no-undo .
      832     define output parameter p-field-list as character no-undo .
      833     do
      834     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      835     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      836     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      837     :
      838       define variable v-full-tbl-name  as character no-undo .
      839       define variable bh_tbl-name      as handle    no-undo .
      840       define variable v-tbl-name       as character no-undo .
      841       define variable v-field-num      as integer   no-undo .
      842       define variable v-count-fld      as integer   no-undo .
      843       define variable v-inform         as character no-undo .
      844       define variable v-ind            as integer   no-undo .
      845       define variable v-idx-field-qnty as integer   no-undo .
      846       define variable v-delim-key      as character no-undo .
      847       if p-table = ?
      848         or p-table = "":U
      849       then do:
      850         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
      851       end.
      852       assign
      853         v-tbl-name      = p-table
      854         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      855       .
      856       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      857       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
      858       assign
      859         v-inform = bh_tbl-name:index-information(1)
      860         v-ind    = 2
      861       .
      862       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      863       on error undo, return error
      864       :
      865         assign
      866           v-inform = bh_tbl-name:index-information( v-ind )
      867           v-ind    = v-ind + 1
      868         .
      869       end.
      870       if v-inform = ?
      871         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      872         or entry( 3, v-inform, ",":U ) <> "1":U
      873       then do:
      874         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      875       end.
      876       assign
      877         v-idx-field-qnty = num-entries( v-inform ) - 4
      878       .
      879       if v-idx-field-qnty < 2 then do:
      880         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      881       end.
      882       assign
      883         p-field-list = "":U
      884         v-delim-key  = "":U
      885         v-count-fld  = 0
      886       .
      887       block_where:
      888       do v-ind = 1 to v-idx-field-qnty by 2
      889       on error undo, return error
      890       :
      891         assign
      892           v-count-fld = v-count-fld + 1
      893         .
      894         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      895         if v-ind = 1 then do:
      896           assign
      897             v-delim-key = chr(3)
      898           .
      899         end.
      900       end.
      901       delete object bh_tbl-name.
      902     end.
      903   end procedure.
      904   procedure get-gate-file-name :
      905   define input parameter p-gate-rec as character no-undo .
      906   define output  parameter p-gate-file-name as character no-undo .
      907   define buffer buf_clob-data for ub.clob-data.
      908   define variable v-tbl-row as rowid no-undo .
      909   define variable v-tbl-name as character no-undo .
      910   run gen-row-keyr in this-procedure ( input p-gate-rec
      911                                       ,input ?
      912                                       ,input "ub"
      913                                       ,input ?
      914                                       ,input no-lock
      915                                       ,output v-tbl-row
      916                                       ,output v-tbl-name) no-error.
      917   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
      918                                                           ,vss-include-info1
      919                                                           ,p-gate-rec).
      920   find first buf_clob-data no-lock where
      921             rowid(buf_clob-data) = v-tbl-row no-error.
      922   if not available buf_clob-data then do:
      923     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
      924                                                             ,vss-include-info1
      925                                                             ,p-gate-rec).
      926   end.
      927   p-gate-file-name = buf_clob-data.file-name.
      928   end procedure.
      929   procedure get-gate-rec :
      930   define input  parameter p-gate-name as character no-undo .
      931   define output parameter p-gate-rec as character no-undo .
      932   define buffer buf_clob-bind for ub.clob-bind.
      933   define buffer buf_clob-data for ub.clob-data.
      934   main-block:
      935   do
      936   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message (1))
      937   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info1 )
      938   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info1 )
      939   :
      940       find first buf_clob-bind no-lock where
      941                 buf_clob-bind.uniq-key-rec = p-gate-name
      942             and buf_clob-bind.field-name = '':U
      943             and buf_clob-bind.part-num = 1
      944             and buf_clob-bind.resource-type = 'gate':U
      945             no-error.
      946       if not available buf_clob-bind then do:
      947         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
      948                                         , p-gate-name
      949                                         ).
      950       end.
      951       find first buf_clob-data no-lock where
      952                 buf_clob-data.db-num = buf_clob-bind.db-num
      953             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
      954       if not available buf_clob-data then do:
      955         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
      956                                         , buf_clob-bind.db-num
      957                                         , buf_clob-bind.int64-id
      958                                         , p-gate-name
      959                                         ).
      960       end.
      961       run gen-key-rec in this-procedure ( input 'clob-data':U
      962                                 ,input buffer buf_clob-data:handle
      963                                 ,output p-gate-rec).
      964   end.
      965   end procedure.
      966   procedure get-gate-by-name :
      967   define input  parameter p-gate-name as character no-undo .
      968   define output parameter p-gate-rec as character no-undo .
      969   define output parameter p-dsh as handle no-undo .
      970   define input-output  parameter p-xmlh as handle no-undo .
      971   define variable v-ii as integer   no-undo .
      972   define variable glog as logical   no-undo .
      973   define variable v-longchar as longchar no-undo .
      974   define variable v-txmlh as handle no-undo .
      975   define variable v-db-num as integer no-undo .
      976   define variable v-int64-id as int64 no-undo .
      977   define buffer buf_clob-bind for ub.clob-bind.
      978   define buffer buf_clob-data for ub.clob-data.
      979   main-block:
      980   do
      981   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message (1))
      982   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info1 )
      983   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info1 )
      984   :
      985       find first buf_clob-bind no-lock where
      986                 buf_clob-bind.uniq-key-rec = p-gate-name
      987             and buf_clob-bind.field-name = '':U
      988             and buf_clob-bind.part-num = 1
      989             and buf_clob-bind.resource-type = 'gate':U
      990             no-error.
      991       if not available buf_clob-bind then do:
      992         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
      993                                         , p-gate-name
      994                                         ).
      995       end.
      996       find first buf_clob-data no-lock where
      997                 buf_clob-data.db-num = buf_clob-bind.db-num
      998             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
      999       if not available buf_clob-data then do:
     1000         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1001                                         , buf_clob-bind.db-num
     1002                                         , buf_clob-bind.int64-id
     1003                                         , p-gate-name
     1004                                         ).
     1005       end.
     1006       assign
     1007       v-longchar = buf_clob-data.cdata
     1008       .
     1009       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1010       if error-status :error then do:
     1011         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1012       end.
     1013       create dataset p-dsh .
     1014       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1015                                     , v-longchar
     1016                                     , ?
     1017                                     , ?
     1018                                     , ?
     1019                                     ) no-error.
     1020       v-longchar = '':U.
     1021       if error-status :error
     1022       or not glog
     1023       then do:
     1024         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1025       end.
     1026       if not valid-handle(p-xmlh)
     1027       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1028         create temp-table v-txmlh.
     1029         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1030         v-txmlh:temp-table-prepare("temp-xml-tables").
     1031         p-xmlh = v-txmlh:default-buffer-handle.
     1032       end.
     1033       run gen-key-rec in this-procedure ( input 'clob-data':U
     1034                                 ,input buffer buf_clob-data:handle
     1035                                 ,output p-gate-rec).
     1036       do v-ii = 1 to p-dsh:num-buffers:
     1037         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1038         if not p-xmlh:available then do:
     1039           p-xmlh:buffer-create().
     1040           assign
     1041           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1042           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1043           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1044           p-xmlh::gate-handle_ = p-dsh
     1045           p-xmlh::uniq-gate-rec = p-gate-rec
     1046           p-xmlh::gate-name = p-dsh:name
     1047           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1048           .
     1049           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1050             assign
     1051             p-xmlh::order = -3.
     1052           end.
     1053         end.
     1054       end.
     1055   end.
     1056   end procedure.
     1057   procedure get-gate-by-rec :
     1058   define input  parameter p-gate-rec as character no-undo .
     1059   define output parameter p-dsh as handle no-undo .
     1060   define input-output  parameter p-xmlh as handle no-undo .
     1061   define input-output parameter p-longchar  as longchar no-undo .
     1062   define variable v-ii as integer   no-undo .
     1063   define variable glog as logical   no-undo .
     1064   define variable v-rowid as rowid no-undo .
     1065   define variable v-tbl-name as character no-undo .
     1066   define variable v-longchar as longchar no-undo .
     1067   define variable v-txmlh as handle no-undo .
     1068   define buffer buf_clob-data for ub.clob-data.
     1069   main-block:
     1070   do
     1071   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message (1))
     1072   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info1 )
     1073   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info1 )
     1074   :
     1075     run gen-row-keyr in this-procedure (
     1076                                           input  p-gate-rec
     1077                                           ,input  ?
     1078                                           ,input  "ub"
     1079                                           ,input  ?
     1080                                           ,input  NO-LOCK
     1081                                           ,output v-rowid
     1082                                           ,output v-tbl-name   ) no-error.
     1083       find first buf_clob-data no-lock where
     1084                 rowid(buf_clob-data) = v-rowid  no-error.
     1085       if not available buf_clob-data then do:
     1086         undo, return error substitute("Не найден CLOB  &1"
     1087                                         , p-gate-rec
     1088                                         ).
     1089       end.
     1090       assign
     1091       v-longchar = buf_clob-data.cdata
     1092       .
     1093       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1094       if error-status :error then do:
     1095         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1096       end.
     1097       create dataset p-dsh .
     1098       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1099                                     , v-longchar
     1100                                     , ?
     1101                                     , ?
     1102                                     , ?
     1103                                     ) no-error.
     1104       define variable v-esm as character no-undo .
     1105       v-esm = error-status:get-message(1) .
     1106       if p-longchar <> ? then do:
     1107         p-longchar = v-longchar.
     1108       end.
     1109       v-longchar = '':U.
     1110       if error-status :error
     1111       or not glog
     1112       then do:
     1113         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1114                                      , p-gate-rec
     1115                                      , p-gate-rec
     1116                                      , v-esm
     1117                                      ).
     1118       end.
     1119       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1120       if not valid-handle(p-xmlh)
     1121       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1122         create temp-table v-txmlh.
     1123         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1124         v-txmlh:temp-table-prepare("temp-xml-tables").
     1125         p-xmlh = v-txmlh:default-buffer-handle.
     1126       end.
     1127       do v-ii = 1 to p-dsh:num-buffers:
     1128         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1129         if not p-xmlh:available then do:
     1130           p-xmlh:buffer-create().
     1131           assign
     1132           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1133           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1134           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1135           p-xmlh::gate-handle_ = p-dsh
     1136           p-xmlh::uniq-gate-rec = p-gate-rec
     1137           p-xmlh::gate-name = p-dsh:name
     1138           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1139           .
     1140           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1141             assign
     1142             p-xmlh::order = -3.
     1143           end.
     1144           p-xmlh:buffer-release().
     1145         end.
     1146       end.
     1147   end.
     1148   end procedure.
     1149   procedure get-gate-by-file :
     1150   define input  parameter p-schema-file-name as character no-undo .
     1151   define input  parameter p-gate-rec as character no-undo .
     1152   define output parameter p-dsh as handle no-undo .
     1153   define input-output  parameter p-xmlh as handle no-undo .
     1154   define variable v-ii as integer   no-undo .
     1155   define variable glog as logical   no-undo .
     1156   define variable v-rowid as rowid no-undo .
     1157   define variable v-tbl-name as character no-undo .
     1158   define variable v-longchar as longchar no-undo .
     1159   define variable v-txmlh as handle no-undo .
     1160   main-block:
     1161   do
     1162   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message (1))
     1163   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info1 )
     1164   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info1 )
     1165   :
     1166       COPY-LOB
     1167       FROM  FILE p-schema-file-name
     1168       TO  OBJECT v-longchar
     1169       no-convert
     1170       NO-ERROR .
     1171       if error-status :error then do:
     1172           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1173                                     , p-schema-file-name
     1174                                 , chr(10)
     1175                                 , error-status:get-message(1) ).
     1176       end.
     1177       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1178       if error-status :error then do:
     1179         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1180       end.
     1181       create dataset p-dsh .
     1182       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1183                                     , v-longchar
     1184                                     , ?
     1185                                     , ?
     1186                                     , ?
     1187                                     ) no-error.
     1188       v-longchar = ''.
     1189       if error-status :error
     1190       or not glog
     1191       then do:
     1192         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1193                                      , p-schema-file-name
     1194                                      ,chr(10)
     1195                                      , error-status:get-message(1)
     1196                                      ).
     1197       end.
     1198       if not valid-handle(p-xmlh)
     1199       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1200         create temp-table v-txmlh.
     1201         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1202         v-txmlh:temp-table-prepare("temp-xml-tables").
     1203         p-xmlh = v-txmlh:default-buffer-handle.
     1204       end.
     1205       do v-ii = 1 to p-dsh:num-buffers:
     1206         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1207                                      ,p-dsh:get-buffer-handle(v-ii):name
     1208                                      ,p-gate-rec
     1209                                      )) no-error.
     1210         if not p-xmlh:available then do:
     1211           p-xmlh:buffer-create().
     1212           assign
     1213           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1214           p-xmlh::uniq-gate-rec = p-gate-rec
     1215           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1216           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1217           p-xmlh::gate-handle_ = p-dsh
     1218           p-xmlh::gate-name = p-dsh:name
     1219           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1220           .
     1221           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1222             assign
     1223             p-xmlh::order = -3.
     1224           end.
     1225           p-xmlh:buffer-release().
     1226         end.
     1227       end.
     1228   end.
     1229   end procedure.
     1230   procedure gate-clear :
     1231   define input  parameter p-dsh as handle no-undo .
     1232   define input  parameter p-xmlh as handle no-undo .
     1233   define variable v-dsh as handle no-undo .
     1234   define variable v-th as handle no-undo .
     1235     do
     1236     on error undo, return error return-value
     1237     :
     1238       if valid-handle(p-dsh) then do:
     1239         delete object p-dsh.
     1240         v-dsh = p-dsh.
     1241         p-dsh = ?.
     1242       end.
     1243       repeat while true:
     1244         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1245                            , share-lock) no-error.
     1246         if p-xmlh:available then do:
     1247           assign
     1248           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1249           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1250           and valid-handle(v-th)
     1251           and v-th:dynamic = yes
     1252           then do:
     1253             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1254             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1255           end.
     1256           p-xmlh:buffer-delete().
     1257         end.
     1258         else do:
     1259           leave.
     1260         end.
     1261       end.
     1262       if p-xmlh:dynamic = yes
     1263       and valid-handle(p-xmlh)
     1264       then do:
     1265         delete object p-xmlh:table-handle.
     1266         p-xmlh = ?.
     1267       end.
     1268       v-dsh = ?.
     1269     end.
     1270   end procedure.
     1271   procedure all-gates-clear :
     1272   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1273   do
     1274   on error undo, return error
     1275   :
     1276     for each buf_temp-xml-tables
     1277     break
     1278     by buf_temp-xml-tables.uniq-gate-rec
     1279     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1280     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1281     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1282     :
     1283         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1284           delete object buf_temp-xml-tables.gate-handle_.
     1285           buf_temp-xml-tables.gate-handle_ = ?.
     1286         end.
     1287         if valid-handle(buf_temp-xml-tables.table-handle_)
     1288         and buf_temp-xml-tables.table-handle_:dynamic = no
     1289         then do:
     1290           delete object buf_temp-xml-tables.table-handle_.
     1291           buf_temp-xml-tables.table-handle_ = ?.
     1292         end.
     1293         delete buf_temp-xml-tables.
     1294     end.
     1295   end.
     1296   end procedure.
     1297   procedure fix-schemalocation :
     1298   define input-output  parameter p-longchar as longchar no-undo .
     1299   DEFINE VARIABLE hdoc AS HANDLE.
     1300   DEFINE VARIABLE hroot AS HANDLE.
     1301   DEFINE VARIABLE hnode-child AS HANDLE.
     1302   DEFINE VARIABLE hnode-attr AS HANDLE.
     1303   define variable v-jj as integer   no-undo .
     1304   define variable ok as logical   no-undo .
     1305   define variable v-path1                    as character                no-undo .
     1306   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1307   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1308   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1309   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1310   define variable v-schema-location          as character                no-undo .
     1311   do
     1312   on error undo, return error return-value
     1313   :
     1314     CREATE X-DOCUMENT hdoc.
     1315     CREATE X-noderef hroot.
     1316     CREATE X-noderef hnode-child.
     1317     CREATE X-noderef hnode-attr.
     1318     hdoc:load("longchar", p-longchar, no) no-error.
     1319     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1320     hdoc:get-document-element(hroot).
     1321     _repeat:
     1322     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1323       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1324       if not ok then next.
     1325       if hNode-Child:local-name = "include"
     1326       then do:
     1327         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1328           v-schema-location = hnode-attr:node-value.
     1329           run gbl/filename.p (
     1330                           input "exe/" + hnode-attr:node-value
     1331                         ,output v-full-path1
     1332                         ,output v-path1
     1333                         ,output v-file-name1
     1334                         ,output v-file-name-no-ext1
     1335                         ,output v-file-name-ext1
     1336                         ) no-error .
     1337           if error-status :error then do:
     1338             delete object hnode-attr.
     1339             delete object hnode-child.
     1340             delete object hroot.
     1341             delete object hdoc.
     1342             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1343           end.
     1344         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1345         leave  _repeat.
     1346       end.
     1347     END.
     1348     hdoc:save("longchar", p-longchar).
     1349     delete object hnode-attr.
     1350     delete object hnode-child.
     1351     delete object hroot.
     1352     delete object hdoc.
     1353   end.
     1354   end procedure.
     1355   procedure gate-clb_fill-xml-tables :
     1356   define input parameter p-dsh as handle no-undo .
     1357   define input-output parameter p-xmlh as handle no-undo .
     1358   define variable v-ii as integer no-undo .
     1359     do
     1360     on error undo, return error
     1361     :
     1362       do v-ii = 1 to p-dsh:num-buffers:
     1363         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1364         if not p-xmlh:available then do:
     1365           p-xmlh:buffer-create().
     1366           assign
     1367           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1368           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1369           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1370           p-xmlh::gate-handle_ = p-dsh
     1371           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1372           p-xmlh::gate-name = p-dsh:name
     1373           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1374           .
     1375           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1376             assign
     1377             p-xmlh::order = -3.
     1378           end.
     1379           p-xmlh:buffer-release().
     1380         end.
     1381       end.
     1382     end.
     1383   end procedure.
     1384   procedure all-gates-empty :
     1385   define buffer buf_temp-xml-tables for temp-xml-tables.
     1386   do
     1387   on error undo, return error
     1388   :
     1389     for each buf_temp-xml-tables
     1390     break
     1391     by buf_temp-xml-tables.uniq-gate-rec
     1392     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1393     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1394     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1395     :
     1396       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1397         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1398       end.
     1399     end.
     1400   end.
     1401   end procedure.
     1402   define temp-table tt-esys-route no-undo
     1403     field esr-name-rec     like ub.esys-route.esr-name-rec
     1404     field esr-uniq-key-rec like ub.esys-route.esr-uniq-key-rec
     1405     field uniq-gate-rec like ub.esys-route.uniq-gate-rec
     1406     field ord-num      like ub.esys-route.esr-tbl-ord
     1407     field esr-pack-num     like ub.esys-route.esr-last-pack    column-label "Пакет"
     1408     field esys-id      like ub.esys-route.esys-id
     1409     field db-num       like ub.esys-route.db-num
     1410     field esr-CreUserName  like ub.esys-route.esr-CreUserName
     1411     field esr-CreDate      like ub.esys-route.esr-CreDate
     1412     field esr-CreTime      like ub.esys-route.esr-CreTime
     1413     field descr        as character               column-label "Информация"
     1414     field rec-rowid    as rowid
     1415     index pi  is primary unique esys-id db-num ord-num
     1416     index pii  ord-num
     1417     index piii rec-rowid
     1418     .
     1419   FUNCTION get-gate-file-name-f RETURNS CHARACTER
     1420     ( input p-gate-rec as character )  FORWARD.
     1421   DEFINE BUTTON b-help DEFAULT
     1422        LABEL "Помо&щь"
     1423        SIZE 3 BY 1
     1424        BGCOLOR 8 .
     1425   DEFINE BUTTON b-quit AUTO-END-KEY DEFAULT
     1426        LABEL "&Выход"
     1427        SIZE 10 BY 1
     1428        BGCOLOR 8 .
     1429   DEFINE VARIABLE t-all AS LOGICAL INITIAL no
     1430        LABEL "Показать все (без расшифровки)"
     1431        VIEW-AS TOGGLE-BOX
     1432        SIZE 33.38 BY .79 NO-UNDO.
     1433   DEFINE QUERY br-route FOR
     1434         tt-esys-route SCROLLING.
     1435   DEFINE BROWSE br-route
     1436     QUERY br-route NO-LOCK DISPLAY
     1437         tt-esys-route.esr-pack-num format "-999999999"
     1438   tt-esys-route.descr format "X(255)"
     1439   tt-esys-route.esr-name-rec format "X(255)"
     1440   tt-esys-route.esr-uniq-key-rec format "X(255)"
     1441   tt-esys-route.esr-CreUserName format "X(18)"
     1442   tt-esys-route.esr-CreDate
     1443   tt-esys-route.esr-CreTime
     1444   tt-esys-route.uniq-gate-rec column-label "Гейт" format "X(255)"
     1445   get-gate-file-name-f(tt-esys-route.uniq-gate-rec) column-label "Имя Гейта" format "X(32)"
     1446       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 18.79.
     1447   DEFINE FRAME v-route
     1448        b-quit AT ROW 1 COL 1
     1449        b-help AT ROW 1 COL 95
     1450        t-all AT ROW 2.54 COL 2.13
     1451        br-route AT ROW 3.46 COL 1
     1452        SPACE(0.12) SKIP(0.00)
     1453       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1454            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1455            TITLE "просмотр маршрутизации"
     1456            CANCEL-BUTTON b-quit.
     1457   ASSIGN
     1458          FRAME v-route:SCROLLABLE       = FALSE
     1459          FRAME v-route:HIDDEN           = TRUE.
     1460   ON WINDOW-CLOSE OF FRAME v-route
     1461   DO:
     1462     APPLY "END-ERROR":U TO SELF.
     1463   END.
     1464   ON VALUE-CHANGED OF br-route IN FRAME v-route
     1465   DO:
     1466   END.
     1467   ON VALUE-CHANGED OF t-all IN FRAME v-route
     1468   DO:
     1469     define variable v-log   as logical   no-undo .
     1470     define variable v-rowid as rowid     no-undo .
     1471     if available tt-esys-route then do:
     1472       assign
     1473         v-rowid = tt-esys-route.rec-rowid
     1474       .
     1475     end.
     1476     else do:
     1477       assign
     1478         v-rowid = ?
     1479       .
     1480     end.
     1481     assign
     1482       t-all
     1483     .
     1484     run full-fill in this-procedure .
     1485     OPEN QUERY br-route for each tt-esys-route no-lock   by tt-esys-route.ord-num .
     1486     apply "entry" to br-route in frame v-route.
     1487     if v-rowid <> ? then do:
     1488       find first tt-esys-route no-lock
     1489         where tt-esys-route.rec-rowid = v-rowid
     1490         no-error .
     1491       if available tt-esys-route then do:
     1492         reposition br-route to rowid rowid( tt-esys-route ) no-error .
     1493       end.
     1494     end.
     1495   END.
     1496   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1497   on help of frame v-route
     1498   do:
     1499     run gbl/app_help.p
     1500       (input this-procedure :file-name
     1501       ,input ''
     1502       ,input ?
     1503       ) no-error.
     1504     if error-status :error then do:
     1505       message
     1506         "Ошибка при вызове помощи"
     1507         error-status :get-message(1)
     1508         view-as alert-box .
     1509     end.
     1510   end.
     1511   run minbtn-set in this-procedure .
     1512   on choose of b-help in frame v-route
     1513   do:
     1514     apply "help":u to frame v-route .
     1515   end.
     1516   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1517   procedure minbtn-set :
     1518       do
     1519           on error undo, return error return-value
     1520           :
     1521           define variable ii              as integer       no-undo .
     1522           define variable fh              as widget-handle no-undo .
     1523           define variable hh              as widget-handle no-undo .
     1524           define variable v-h             as handle        extent 4 no-undo .
     1525           define variable v-name-button   as character     no-undo .
     1526           define variable v-help-old-x    as decimal       no-undo .
     1527           define variable v-help-old-y    as decimal       no-undo .
     1528           define variable v-help-old-size as decimal       no-undo .
     1529           define variable v-frame-width   as decimal       no-undo .
     1530           define variable jj              as integer       no-undo .
     1531           do
     1532               on error undo, return error
     1533               :
     1534               assign
     1535                   v-frame-width = frame v-route:width - 0.3
     1536                   fh            = frame v-route:first-child
     1537                   hh            = fh:first-child
     1538                   ii            = 1
     1539                   .
     1540               do while valid-handle(hh):
     1541                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1542                   do:
     1543                       case lc(hh:name) :
     1544                           when "b-help" then
     1545                               do:
     1546                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1547                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1548                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1549                                   hh:TOOLTIP = "Помощь" .
     1550                                   v-help-old-x = hh:column .
     1551                                   v-help-old-y = hh:row    .
     1552                                   v-help-old-size = hh:width .
     1553                                   hh:width-chars = 2.5 .
     1554                               end.
     1555                           when "b-print" then
     1556                               do:
     1557                                   hh:load-image("cmp/b-print.bmp":u) .
     1558                                   hh:TOOLTIP = "Печать" .
     1559                                   v-h[ii] = hh:handle .
     1560                                   ii = ii + 1 .
     1561                                   hh:width-chars = 3 .
     1562                               end.
     1563                           when "b-history" or
     1564                           when "b-hist" then
     1565                               do:
     1566                                   hh:load-image("cmp/b-hist.bmp":u) .
     1567                                   hh:TOOLTIP = "История" .
     1568                                   v-h[ii] = hh:handle .
     1569                                   ii = ii + 1 .
     1570                                   hh:width-chars = 3 .
     1571                               end.
     1572                           when "b-sch" then
     1573                               do:
     1574                                   hh:load-image("cmp/b-sch.bmp":u) .
     1575                                   hh:TOOLTIP = "Установка Фильтра" .
     1576                                   v-h[ii] = hh:handle .
     1577                                   ii = ii + 1 .
     1578                                   hh:width-chars = 3 .
     1579                               end.
     1580                           when "b-hist-user" then
     1581                               do:
     1582                                   hh:load-image("cmp/b-hist.bmp":u) .
     1583                                   hh:TOOLTIP = "История пользователя" .
     1584                                   ii = ii + 1 .
     1585                               end.
     1586                       end case.
     1587                   end.
     1588                   hh = hh:next-sibling.
     1589               end.
     1590               b-help:column = v-frame-width - b-help:width-chars.
     1591               jj = 0.
     1592               repeat ii = 4 to 1 by -1 :
     1593                   if valid-handle (v-h[ii] ) then
     1594                   do:
     1595                       jj  = jj + 1 .
     1596                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1597                       v-h[ii]:row    = v-help-old-y .
     1598                   end.
     1599               end.
     1600           end.
     1601       end.
     1602   end procedure.
     1603   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1604   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1605   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1606   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1607   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1608   define variable v-diasize-current-frame-height as decimal   no-undo .
     1609   define variable v-diasize-change-size          as logical   no-undo .
     1610   define variable v-diasize-resize-button        as handle    no-undo .
     1611   define variable v-diasize-wndmax               as logical   no-undo .
     1612   define variable v-diasize-wndstore             as logical   no-undo .
     1613   define variable v-diasize-proc-name            as character no-undo .
     1614   define variable v-diasize-browse-handle        as handle    no-undo .
     1615   define variable v-diasize-browse-number        as integer   no-undo .
     1616   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1617   define temp-table temp-diasize-handle no-undo
     1618     field handle-value  as handle
     1619     field save-position as decimal
     1620     index xpk is primary unique handle-value
     1621     .
     1622   define temp-table temp-browse-handle no-undo
     1623     field browse-type   as character
     1624     field browse-number as integer
     1625     field browse-handle as handle
     1626     field original-size as decimal
     1627     index xpk is primary unique browse-type browse-number
     1628     index xie browse-type browse-handle
     1629   .
     1630   procedure diasize_change-height :
     1631     define input  parameter p-change-value  as decimal   no-undo .
     1632     define input  parameter p-move-resize   as logical   no-undo .
     1633     define variable v-field-group-handle    as handle    no-undo .
     1634     define variable v-object-handle         as handle    no-undo .
     1635     define variable v-frame-height          as decimal   no-undo .
     1636     define variable v-frame-virtual-height  as decimal   no-undo .
     1637     define variable v-browse-height         as decimal   no-undo .
     1638     define variable v-window-height         as decimal   no-undo .
     1639     define variable v-window-virtual-height as decimal   no-undo .
     1640     define variable v-change-sign           as integer   no-undo .
     1641     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1642     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1643     if p-change-value > 0
     1644     then do:
     1645       if frame v-route :height + p-change-value
     1646           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1647       then do:
     1648         assign
     1649           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1650                           - (frame v-route :height-chars)
     1651         .
     1652         if p-change-value <= 0
     1653         then do:
     1654           run diasize_position-resize-button in this-procedure .
     1655           return .
     1656         end.
     1657       end.
     1658     end.
     1659     if p-change-value < 0
     1660     then do:
     1661       if frame v-route :height + p-change-value < v-diasize-orig-frame-height
     1662       then do:
     1663         assign
     1664           p-change-value = v-diasize-orig-frame-height
     1665                          - (frame v-route :height-chars)
     1666         .
     1667         if p-change-value >= 0
     1668         then do:
     1669           run diasize_position-resize-button in this-procedure .
     1670           return .
     1671         end.
     1672       end.
     1673     end.
     1674     if p-change-value >= 0
     1675     then do:
     1676       assign
     1677         v-change-sign = 1
     1678       .
     1679     end.
     1680     else do:
     1681       assign
     1682         v-change-sign = -1
     1683       .
     1684     end.
     1685     assign
     1686       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1687     .
     1688     if p-change-value = 0
     1689     then do:
     1690       run diasize_position-resize-button in this-procedure .
     1691       return .
     1692     end.
     1693     move_block:
     1694     do
     1695     on error undo move_block, retry move_block
     1696     :
     1697       if retry
     1698       then do:
     1699         do
     1700         on error undo move_block, leave move_block
     1701         :
     1702           if p-change-value > 0
     1703           then do:
     1704             for each buf_temp-diasize-handle
     1705             on error undo, next
     1706             :
     1707               assign
     1708                 v-object-handle = buf_temp-diasize-handle.handle-value
     1709               .
     1710               if v-object-handle <> v-diasize-resize-button
     1711               then do:
     1712                 assign
     1713                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1714                 .
     1715               end.
     1716             end.
     1717             assign
     1718               v-diasize-browse-handle :height = v-browse-height
     1719             .
     1720             for each buf_temp-browse-handle
     1721               where buf_temp-browse-handle.browse-type = 'height':u
     1722             on error undo, next
     1723             :
     1724               assign
     1725                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1726               .
     1727             end.
     1728             assign
     1729               frame v-route :height = v-frame-height
     1730             .
     1731             if frame v-route :scrollable = true
     1732             then do:
     1733               assign
     1734                 frame v-route :virtual-height = v-frame-virtual-height
     1735               .
     1736             end.
     1737             run diasize_position-resize-button in this-procedure .
     1738           end.
     1739           else do:
     1740             if frame v-route :scrollable = true
     1741             then do:
     1742               assign
     1743                 frame v-route :virtual-height = v-frame-virtual-height
     1744               .
     1745             end.
     1746             assign
     1747               frame v-route :height = v-frame-height
     1748             .
     1749             assign
     1750               v-diasize-browse-handle :height = v-browse-height
     1751             .
     1752             for each buf_temp-browse-handle
     1753               where buf_temp-browse-handle.browse-type = 'height':u
     1754             on error undo, next
     1755             :
     1756               assign
     1757                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1758               .
     1759             end.
     1760             for each buf_temp-diasize-handle
     1761             on error undo, next
     1762             :
     1763               assign
     1764                 v-object-handle = buf_temp-diasize-handle.handle-value
     1765               .
     1766               if v-object-handle <> v-diasize-resize-button
     1767               then do:
     1768                 assign
     1769                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1770                 .
     1771               end.
     1772             end.
     1773             run diasize_position-resize-button in this-procedure .
     1774           end.
     1775           assign
     1776             v-diasize-change-size = false
     1777           .
     1778           leave move_block .
     1779         end.
     1780       end.
     1781       assign
     1782         v-diasize-need-full-display = true
     1783       .
     1784       if v-diasize-change-size = false
     1785       then do:
     1786         assign
     1787           v-diasize-change-size = true
     1788         .
     1789       end.
     1790       else do:
     1791         return .
     1792       end.
     1793       assign
     1794         v-frame-height = frame v-route :height
     1795         v-frame-virtual-height = frame v-route :virtual-height
     1796         v-browse-height = v-diasize-browse-handle :height
     1797       .
     1798       for each buf_temp-browse-handle
     1799         where buf_temp-browse-handle.browse-type = 'height':u
     1800       :
     1801         assign
     1802           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1803         .
     1804       end.
     1805       for each buf_temp-diasize-handle
     1806       :
     1807         delete buf_temp-diasize-handle .
     1808       end.
     1809       assign
     1810         v-field-group-handle = frame v-route :first-child
     1811       .
     1812       do while valid-handle(v-field-group-handle)
     1813       :
     1814         assign
     1815           v-object-handle = v-field-group-handle :first-child
     1816         .
     1817         do while valid-handle(v-object-handle)
     1818         :
     1819           if  v-object-handle <> v-diasize-browse-handle :handle
     1820           and can-query(v-object-handle, "row")
     1821           and can-query(v-object-handle, "height")
     1822           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1823           then do:
     1824             find first buf_temp-browse-handle
     1825               where buf_temp-browse-handle.browse-type   = 'height':u
     1826                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1827               no-error .
     1828             if available buf_temp-browse-handle
     1829             then do:
     1830             end.
     1831             else do:
     1832               create buf_temp-diasize-handle .
     1833               assign
     1834                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1835                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1836               .
     1837             end.
     1838           end.
     1839           assign
     1840             v-object-handle = v-object-handle :next-sibling
     1841           .
     1842         end.
     1843         assign
     1844           v-field-group-handle = v-field-group-handle :next-sibling
     1845         .
     1846       end.
     1847       do with frame v-route
     1848       :
     1849         hide v-diasize-resize-button .
     1850         assign
     1851           v-diasize-resize-button :row    = 1
     1852           v-diasize-resize-button :column = 1
     1853         .
     1854       end.
     1855       if p-change-value > 0
     1856       then do:
     1857         if frame v-route :scrollable = true
     1858         then do:
     1859           assign
     1860             frame v-route :virtual-height = frame v-route :virtual-height + p-change-value
     1861             no-error .
     1862           if error-status :error
     1863           or error-status :get-message(1) <> ""
     1864           then do:
     1865             undo move_block, retry move_block .
     1866           end.
     1867         end.
     1868         assign
     1869           frame v-route :height = frame v-route :height + p-change-value
     1870           no-error .
     1871         if error-status :error
     1872         or error-status :get-message(1) <> ""
     1873         then do:
     1874           undo move_block, retry move_block .
     1875         end.
     1876         assign
     1877           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1878           no-error .
     1879         if error-status :error
     1880         or error-status :get-message(1) <> ""
     1881         then do:
     1882           undo move_block, retry move_block .
     1883         end.
     1884         for each buf_temp-browse-handle
     1885           where buf_temp-browse-handle.browse-type = 'height':u
     1886         on error undo move_block, retry move_block
     1887         :
     1888           assign
     1889             buf_temp-browse-handle.browse-handle :height
     1890               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1891             no-error .
     1892           if error-status :error
     1893           or error-status :get-message(1) <> ""
     1894           then do:
     1895             undo move_block, retry move_block .
     1896           end.
     1897         end.
     1898         for each buf_temp-diasize-handle
     1899         on error undo move_block, retry move_block
     1900         :
     1901           assign
     1902             v-object-handle = buf_temp-diasize-handle.handle-value
     1903           .
     1904           if v-object-handle <> v-diasize-resize-button
     1905           then do:
     1906             assign
     1907               v-object-handle :row = v-object-handle :row + p-change-value
     1908               no-error .
     1909             if error-status :error
     1910             or error-status :get-message(1) <> ""
     1911             then do:
     1912               undo move_block, retry move_block .
     1913             end.
     1914           end.
     1915         end.
     1916       end.
     1917       else do:
     1918         for each buf_temp-diasize-handle
     1919         on error undo move_block, retry move_block
     1920         :
     1921           assign
     1922             v-object-handle = buf_temp-diasize-handle.handle-value
     1923           .
     1924           if v-object-handle <> v-diasize-resize-button
     1925           then do:
     1926             assign
     1927               v-object-handle :row = v-object-handle :row + p-change-value
     1928               no-error .
     1929             if error-status :error
     1930             or error-status :get-message(1) <> ""
     1931             then do:
     1932               undo move_block, retry move_block .
     1933             end.
     1934           end.
     1935         end.
     1936         assign
     1937           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1938           no-error .
     1939         if error-status :error
     1940         or error-status :get-message(1) <> ""
     1941         then do:
     1942           undo move_block, retry move_block .
     1943         end.
     1944         for each buf_temp-browse-handle
     1945           where buf_temp-browse-handle.browse-type = 'height':u
     1946         on error undo move_block, retry move_block
     1947         :
     1948           assign
     1949             buf_temp-browse-handle.browse-handle :height
     1950               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1951             no-error .
     1952           if error-status :error
     1953           or error-status :get-message(1) <> ""
     1954           then do:
     1955             undo move_block, retry move_block .
     1956           end.
     1957         end.
     1958         assign
     1959           frame v-route :height = frame v-route :height + p-change-value
     1960           no-error .
     1961         if error-status :error
     1962         or error-status :get-message(1) <> ""
     1963         then do:
     1964           undo move_block, retry move_block .
     1965         end.
     1966         if frame v-route :scrollable = true
     1967         then do:
     1968           assign
     1969             frame v-route :virtual-height = frame v-route :virtual-height + p-change-value
     1970             no-error .
     1971           if error-status :error
     1972           or error-status :get-message(1) <> ""
     1973           then do:
     1974             undo move_block, retry move_block .
     1975           end.
     1976         end.
     1977       end.
     1978       if p-move-resize = true
     1979       then do:
     1980         run diasize_position-resize-button in this-procedure .
     1981       end.
     1982       if v-diasize-wndstore = true
     1983       then do:
     1984         if connected("ub") = true
     1985         then do:
     1986           define variable v-cntxt-db-num        as integer   no-undo .
     1987           define variable v-cntxt-userid        as character no-undo .
     1988           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1989                                             , OUTPUT v-cntxt-userid
     1990                                             ) .
     1991           run gbl/wndsizew.p
     1992             (input  v-cntxt-db-num
     1993             ,input  v-cntxt-userid
     1994             ,input  v-diasize-proc-name
     1995             ,input  'height':u
     1996             ,input  string(frame v-route :height - v-diasize-orig-frame-height)
     1997             ) .
     1998         end.
     1999       end.
     2000     end.
     2001     assign
     2002       v-diasize-change-size = false
     2003     .
     2004   end procedure.
     2005   procedure diasize_set-height :
     2006     define input  parameter p-new-height  as decimal   no-undo .
     2007     define input  parameter p-move-resize as logical   no-undo .
     2008     do
     2009     on error undo, return error return-value
     2010     :
     2011       run diasize_change-height in this-procedure
     2012         (input  (p-new-height - frame v-route :height)
     2013         ,input  p-move-resize
     2014         ) .
     2015     end.
     2016   end procedure.
     2017   procedure diasize_change-width :
     2018     define input  parameter p-change-value as decimal   no-undo .
     2019     define input  parameter p-move-resize  as logical   no-undo .
     2020     define variable v-field-group-handle   as handle    no-undo .
     2021     define variable v-object-handle        as handle    no-undo .
     2022     define variable v-frame-width          as decimal   no-undo .
     2023     define variable v-frame-virtual-width  as decimal   no-undo .
     2024     define variable v-browse-width         as decimal   no-undo .
     2025     define variable v-window-width         as decimal   no-undo .
     2026     define variable v-window-virtual-width as decimal   no-undo .
     2027     define variable v-change-sign          as integer   no-undo .
     2028     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2029     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2030     if p-change-value > 0
     2031     then do:
     2032       if frame v-route :width + p-change-value >
     2033           session :width-chars
     2034       then do:
     2035         assign
     2036           p-change-value = session :width-chars - frame v-route :width
     2037         .
     2038         if p-change-value <= 0
     2039         then do:
     2040           run diasize_position-resize-button in this-procedure .
     2041           return .
     2042         end.
     2043       end.
     2044     end.
     2045     if p-change-value < 0
     2046     then do:
     2047       if frame v-route :width + p-change-value < v-diasize-orig-frame-width
     2048       then do:
     2049         assign
     2050           p-change-value = v-diasize-orig-frame-width
     2051                          - frame v-route :width
     2052         .
     2053         if p-change-value >= 0
     2054         then do:
     2055           run diasize_position-resize-button in this-procedure .
     2056           return .
     2057         end.
     2058       end.
     2059     end.
     2060     if p-change-value >= 0
     2061     then do:
     2062       assign
     2063         v-change-sign = 1
     2064       .
     2065     end.
     2066     else do:
     2067       assign
     2068         v-change-sign = -1
     2069       .
     2070     end.
     2071     assign
     2072       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2073     .
     2074     if p-change-value = 0
     2075     then do:
     2076       run diasize_position-resize-button in this-procedure .
     2077       return .
     2078     end.
     2079     move_block:
     2080     do
     2081     on error undo move_block, leave move_block
     2082     :
     2083       if retry
     2084       then do:
     2085         do
     2086         on error undo move_block, leave move_block
     2087         :
     2088           if p-change-value > 0
     2089           then do:
     2090             for each buf_temp-diasize-handle
     2091             on error undo, next
     2092             :
     2093               assign
     2094                 v-object-handle = buf_temp-diasize-handle.handle-value
     2095               .
     2096               if v-object-handle <> v-diasize-resize-button
     2097               then do:
     2098                 assign
     2099                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2100                 .
     2101               end.
     2102             end.
     2103             assign
     2104               v-diasize-browse-handle :width = v-browse-width
     2105             .
     2106             for each buf_temp-browse-handle
     2107               where buf_temp-browse-handle.browse-type = 'width':u
     2108             on error undo, next
     2109             :
     2110               assign
     2111                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2112               .
     2113             end.
     2114             assign
     2115               frame v-route :width = v-frame-width
     2116             .
     2117             if frame v-route :scrollable = true
     2118             then do:
     2119               assign
     2120                 frame v-route :virtual-width = v-frame-virtual-width
     2121               .
     2122             end.
     2123             run diasize_position-resize-button in this-procedure .
     2124           end.
     2125           else do:
     2126             if frame v-route :scrollable = true
     2127             then do:
     2128               assign
     2129                 frame v-route :virtual-width = v-frame-virtual-width
     2130               .
     2131             end.
     2132             assign
     2133               frame v-route :width = v-frame-width
     2134             .
     2135             for each buf_temp-browse-handle
     2136               where buf_temp-browse-handle.browse-type = 'width':u
     2137             on error undo, next
     2138             :
     2139               assign
     2140                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2141               .
     2142             end.
     2143             assign
     2144               v-diasize-browse-handle :width = v-browse-width
     2145             .
     2146             for each buf_temp-diasize-handle
     2147             on error undo, next
     2148             :
     2149               assign
     2150                 v-object-handle = buf_temp-diasize-handle.handle-value
     2151               .
     2152               if v-object-handle <> v-diasize-resize-button
     2153               then do:
     2154                 assign
     2155                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2156                 .
     2157               end.
     2158             end.
     2159             run diasize_position-resize-button in this-procedure .
     2160           end.
     2161           assign
     2162             v-diasize-change-size = false
     2163           .
     2164           leave move_block .
     2165         end.
     2166       end.
     2167       assign
     2168         v-diasize-need-full-display = true
     2169       .
     2170       if v-diasize-change-size = false
     2171       then do:
     2172         assign
     2173           v-diasize-change-size = true
     2174         .
     2175       end.
     2176       else do:
     2177         return .
     2178       end.
     2179       assign
     2180         v-frame-width = frame v-route :width
     2181         v-frame-virtual-width = frame v-route :virtual-width
     2182         v-browse-width = v-diasize-browse-handle :width
     2183       .
     2184       for each buf_temp-browse-handle
     2185         where buf_temp-browse-handle.browse-type = 'width':u
     2186       :
     2187         assign
     2188           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2189         .
     2190       end.
     2191       for each buf_temp-diasize-handle
     2192       :
     2193         delete buf_temp-diasize-handle .
     2194       end.
     2195       assign
     2196         v-field-group-handle = frame v-route :first-child
     2197       .
     2198       do while valid-handle(v-field-group-handle)
     2199       :
     2200         assign
     2201           v-object-handle = v-field-group-handle :first-child
     2202         .
     2203         do while valid-handle(v-object-handle)
     2204         :
     2205           if  v-object-handle <> v-diasize-browse-handle :handle
     2206           and v-object-handle <> v-diasize-resize-button
     2207           and can-query(v-object-handle, "row")
     2208           and can-query(v-object-handle, "height")
     2209           and ( v-object-handle :col + v-object-handle :width
     2210                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2211               )
     2212           then do:
     2213             find first buf_temp-browse-handle
     2214               where buf_temp-browse-handle.browse-type   = 'width':u
     2215                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2216               no-error .
     2217             if available buf_temp-browse-handle
     2218             then do:
     2219             end.
     2220             else do:
     2221               create buf_temp-diasize-handle .
     2222               assign
     2223                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2224                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2225               .
     2226             end.
     2227           end.
     2228           assign
     2229             v-object-handle = v-object-handle :next-sibling
     2230           .
     2231         end.
     2232         assign
     2233           v-field-group-handle = v-field-group-handle :next-sibling
     2234         .
     2235       end.
     2236       do with frame v-route
     2237       :
     2238         hide v-diasize-resize-button .
     2239         v-diasize-resize-button :row = 1.
     2240         v-diasize-resize-button :column = 1.
     2241       end.
     2242       if p-change-value > 0
     2243       then do:
     2244         if frame v-route :scrollable = true
     2245         then do:
     2246           assign
     2247             frame v-route :virtual-width = frame v-route :virtual-width + p-change-value
     2248             no-error .
     2249           if error-status :error
     2250           or error-status :get-message(1) <> ""
     2251           then do:
     2252             undo move_block, retry move_block.
     2253           end.
     2254         end.
     2255         assign
     2256           frame v-route :width = v-frame-width + p-change-value
     2257           no-error .
     2258         if error-status :error
     2259         or error-status :get-message(1) <> ""
     2260         then do:
     2261           undo move_block, retry move_block.
     2262         end.
     2263         assign
     2264           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2265         no-error .
     2266         if error-status :error
     2267         or error-status :get-message(1) <> ""
     2268         then do:
     2269           undo move_block, retry move_block.
     2270         end.
     2271         for each buf_temp-browse-handle
     2272           where buf_temp-browse-handle.browse-type = 'width':u
     2273         on error undo move_block, retry move_block
     2274         :
     2275           assign
     2276             buf_temp-browse-handle.browse-handle :width
     2277               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2278             no-error .
     2279           if error-status :error
     2280           or error-status :get-message(1) <> ""
     2281           then do:
     2282             undo move_block, retry move_block .
     2283           end.
     2284         end.
     2285         for each buf_temp-diasize-handle
     2286         on error undo move_block, retry move_block
     2287         :
     2288           assign
     2289             v-object-handle = buf_temp-diasize-handle.handle-value
     2290           .
     2291           if v-object-handle <> v-diasize-resize-button
     2292           then do:
     2293             assign
     2294               v-object-handle :col = v-object-handle :col + p-change-value
     2295               no-error .
     2296             if error-status :error
     2297             or error-status :get-message(1) <> ""
     2298             then do:
     2299               undo move_block, retry move_block .
     2300             end.
     2301           end.
     2302         end.
     2303       end.
     2304       else do:
     2305         for each buf_temp-diasize-handle
     2306         on error undo move_block, retry move_block
     2307         :
     2308           assign
     2309             v-object-handle = buf_temp-diasize-handle.handle-value
     2310           .
     2311           if v-object-handle <> v-diasize-resize-button
     2312           then do:
     2313             assign
     2314               v-object-handle :col = v-object-handle :col + p-change-value
     2315               no-error .
     2316             if error-status :error
     2317             or error-status :get-message(1) <> ""
     2318             then do:
     2319               undo move_block, retry move_block .
     2320             end.
     2321           end.
     2322         end.
     2323         for each buf_temp-browse-handle
     2324           where buf_temp-browse-handle.browse-type = 'width':u
     2325         on error undo move_block, retry move_block
     2326         :
     2327           assign
     2328             buf_temp-browse-handle.browse-handle :width
     2329               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2330             no-error .
     2331           if error-status :error
     2332           or error-status :get-message(1) <> ""
     2333           then do:
     2334             undo move_block, retry move_block .
     2335           end.
     2336         end.
     2337         assign
     2338           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2339           no-error .
     2340         if error-status :error
     2341         or error-status :get-message(1) <> ""
     2342         then do:
     2343           undo move_block, retry move_block.
     2344         end.
     2345         assign
     2346           frame v-route :width = frame v-route :width + p-change-value
     2347         no-error .
     2348         if error-status :error
     2349         or error-status :get-message(1) <> ""
     2350         then do:
     2351           undo move_block, retry move_block.
     2352         end.
     2353         if frame v-route :scrollable = true
     2354         then do:
     2355           assign
     2356             frame v-route :virtual-width = frame v-route :virtual-width + p-change-value
     2357           no-error .
     2358           if error-status :error
     2359           or error-status :get-message(1) <> ""
     2360           then do:
     2361             undo move_block, retry move_block.
     2362           end.
     2363         end.
     2364       end.
     2365       if p-move-resize
     2366       then do:
     2367         run diasize_position-resize-button in this-procedure .
     2368       end.
     2369       if v-diasize-wndstore = true
     2370       then do:
     2371         if connected("ub") = true
     2372         then do:
     2373           define variable v-cntxt-db-num        as integer   no-undo .
     2374           define variable v-cntxt-userid        as character no-undo .
     2375           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2376                                             , OUTPUT v-cntxt-userid
     2377                                             ) .
     2378           run gbl/wndsizew.p
     2379             (input  v-cntxt-db-num
     2380             ,input  v-cntxt-userid
     2381             ,input  v-diasize-proc-name
     2382             ,input  'width':u
     2383             ,input  string(frame v-route :width - v-diasize-orig-frame-width)
     2384             ) .
     2385         end.
     2386       end.
     2387     end.
     2388     assign
     2389       v-diasize-change-size = false
     2390     .
     2391   end procedure.
     2392   procedure diasize_set-width :
     2393     define input  parameter p-new-width  as decimal   no-undo .
     2394     define input  parameter p-move-resize as logical   no-undo .
     2395     do
     2396     on error undo, return error return-value
     2397     :
     2398       run diasize_change-width in this-procedure
     2399         (input  (p-new-width - frame v-route :width)
     2400         ,input  p-move-resize
     2401         ) .
     2402     end.
     2403   end procedure.
     2404   procedure diasize_position-resize-button :
     2405     do with frame v-route
     2406     :
     2407       hide v-diasize-resize-button .
     2408       assign
     2409         v-diasize-resize-button :row = frame v-route :height - v-diasize-resize-button :height
     2410                     - 1
     2411                     - (frame v-route :border-bottom-pixels / session :pixels-per-row)
     2412         v-diasize-resize-button :col = frame v-route :width - v-diasize-resize-button :width
     2413                     - 1
     2414                     - (frame v-route :border-right-pixels / session :pixels-per-column)
     2415       .
     2416       view v-diasize-resize-button .
     2417     end.
     2418   end procedure.
     2419   on alt-right anywhere
     2420   do:
     2421     run diasize_change-width in this-procedure
     2422       (input 1
     2423       ,input true
     2424       ) .
     2425     return no-apply .
     2426   end.
     2427   on alt-left anywhere
     2428   do:
     2429     run diasize_change-width in this-procedure
     2430       (input -1
     2431       ,input true
     2432       ) .
     2433     return no-apply .
     2434   end.
     2435   on alt-down anywhere
     2436   do:
     2437     run diasize_change-height in this-procedure
     2438       (input 1
     2439       ,input true
     2440       ) .
     2441     return no-apply .
     2442   end.
     2443   on alt-up anywhere
     2444   do:
     2445     run diasize_change-height in this-procedure
     2446       (input -1
     2447       ,input true
     2448       ) .
     2449     return no-apply .
     2450   end.
     2451   on alt-enter of frame v-route
     2452   do:
     2453     run diasize_maximize in this-procedure
     2454       (input  ?
     2455       ).
     2456     return no-apply .
     2457   end.
     2458   procedure diasize_end-move :
     2459     do
     2460     on error undo, return error return-value
     2461     :
     2462       define variable v-row-delta as decimal   no-undo .
     2463       define variable v-col-delta as decimal   no-undo .
     2464       define variable v-new-row as decimal   no-undo .
     2465       define variable v-new-col as decimal   no-undo .
     2466       assign
     2467         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2468         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2469       .
     2470       assign
     2471         v-row-delta = v-new-row - frame v-route :height
     2472         v-col-delta = v-new-col - frame v-route :width
     2473       .
     2474       run diasize_change-height in this-procedure
     2475         (input v-row-delta
     2476         ,input true
     2477         ) .
     2478       run diasize_change-width in this-procedure
     2479         (input v-col-delta
     2480         ,input true
     2481         ) .
     2482     end.
     2483   end procedure.
     2484   procedure diasize_maximize :
     2485     define input  parameter p-action as logical   no-undo .
     2486     do
     2487     on error undo, return error return-value
     2488     :
     2489       if p-action = ?
     2490       then do:
     2491         if v-diasize-need-maximize = true
     2492         then do:
     2493           assign
     2494             p-action = true
     2495           .
     2496         end.
     2497         else do:
     2498           assign
     2499             p-action = false
     2500           .
     2501         end.
     2502       end.
     2503       if p-action = true
     2504       then do:
     2505         run diasize_change-height in this-procedure
     2506           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2507               - frame v-route :height-chars
     2508           ,input true
     2509           ) .
     2510         run diasize_change-width in this-procedure
     2511           (input session :width-chars
     2512               - frame v-route :width-chars
     2513           ,input true
     2514           ) .
     2515         assign
     2516           v-diasize-need-maximize = false
     2517         .
     2518       end.
     2519       else do:
     2520         run diasize_change-width in this-procedure
     2521           (input v-diasize-orig-frame-width
     2522               - frame v-route :width-chars
     2523           ,input true
     2524           ) .
     2525         run diasize_change-height in this-procedure
     2526           (input v-diasize-orig-frame-height
     2527               - frame v-route :height-chars
     2528           ,input true
     2529           ) .
     2530         assign
     2531           v-diasize-need-maximize = true
     2532         .
     2533       end.
     2534     end.
     2535   end procedure.
     2536   procedure diasize_restore-orig-size :
     2537     do
     2538     on error undo, return error return-value
     2539     :
     2540       assign
     2541         v-diasize-current-frame-width  = frame v-route :width
     2542         v-diasize-current-frame-height = frame v-route :height
     2543       .
     2544       run diasize_set-height in this-procedure
     2545         (input  v-diasize-orig-frame-height
     2546         ,input  true
     2547         ) .
     2548       run diasize_set-width in this-procedure
     2549         (input  v-diasize-orig-frame-width
     2550         ,input  true
     2551         ) .
     2552     end.
     2553   end procedure.
     2554   procedure diasize_restore-current-size :
     2555     do
     2556     on error undo, return error return-value
     2557     :
     2558       run diasize_set-height in this-procedure
     2559         (input  v-diasize-current-frame-height
     2560         ,input  true
     2561         ) .
     2562       run diasize_set-width in this-procedure
     2563         (input  v-diasize-current-frame-width
     2564         ,input  true
     2565         ) .
     2566     end.
     2567   end procedure.
     2568   procedure diasize_set-browse-handle :
     2569     define input  parameter p-browse-handle as handle   no-undo .
     2570     define buffer buf_temp-browse-handle for temp-browse-handle .
     2571     do
     2572     on error undo, return error return-value
     2573     :
     2574       assign
     2575         v-diasize-browse-handle = p-browse-handle
     2576       .
     2577       for each buf_temp-browse-handle
     2578       on error undo, return error return-value
     2579       :
     2580         delete buf_temp-browse-handle .
     2581       end.
     2582     end.
     2583   end procedure.
     2584   procedure diasize_add_browse :
     2585     define input  parameter p-browse-type   as character no-undo .
     2586     define input  parameter p-browse-handle as handle    no-undo .
     2587     define buffer buf_temp-browse-handle for temp-browse-handle .
     2588     do
     2589     on error undo, return error return-value
     2590     :
     2591       assign
     2592         v-diasize-browse-number = v-diasize-browse-number + 1
     2593       .
     2594       create buf_temp-browse-handle .
     2595       assign
     2596         buf_temp-browse-handle.browse-type   = p-browse-type
     2597         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2598         buf_temp-browse-handle.browse-handle = p-browse-handle
     2599       .
     2600     end.
     2601   end procedure.
     2602   procedure diasize_init :
     2603     define variable v-default-value    as logical   no-undo .
     2604     define variable v-restore-saved    as logical   no-undo .
     2605     define variable v-resize-value-str as character no-undo .
     2606     do
     2607     on error undo, return error return-value
     2608     :
     2609       do with frame v-route
     2610       :
     2611         assign
     2612           v-diasize-orig-frame-height = frame v-route :height
     2613           v-diasize-orig-frame-width  = frame v-route :width
     2614           v-diasize-browse-handle     = browse br-route :handle
     2615         .
     2616         create button v-diasize-resize-button
     2617         assign
     2618           parent        = frame v-route :first-child
     2619           label         = "s"
     2620           height-pixels = 16
     2621           width-pixels  = 16
     2622           visible       = true
     2623           sensitive     = true
     2624           movable       = true
     2625           triggers:
     2626             on end-move persistent run diasize_end-move in this-procedure .
     2627           end triggers.
     2628         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2629         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2630         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2631         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2632         assign
     2633           v-diasize-wndmax = false
     2634         .
     2635         if connected("ub") = true
     2636         then do:
     2637           define variable v-cntxt-db-num        as integer   no-undo .
     2638           define variable v-cntxt-userid        as character no-undo .
     2639           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2640                                             , OUTPUT v-cntxt-userid
     2641                                             ) .
     2642           run gbl/wndpar_r.p
     2643             (input  v-cntxt-db-num
     2644             ,input  v-cntxt-userid
     2645             ,input  'wndmax':U
     2646             ,output v-diasize-wndmax
     2647             ,output v-default-value
     2648             ) .
     2649         end.
     2650         assign
     2651           v-diasize-wndstore = false
     2652         .
     2653         if connected("ub") = true
     2654         then do:
     2655           run gbl/wndpar_r.p
     2656             (input  v-cntxt-db-num
     2657             ,input  v-cntxt-userid
     2658             ,input  'wndstore':U
     2659             ,output v-diasize-wndstore
     2660             ,output v-default-value
     2661             ) .
     2662         end.
     2663         assign
     2664           v-diasize-proc-name = entry(1, program-name(2), '.')
     2665         .
     2666         if v-diasize-wndstore = true
     2667         then do:
     2668           assign
     2669             v-restore-saved = false
     2670           .
     2671           if connected("ub") = true
     2672           then do:
     2673             run gbl/wndsizer.p
     2674               (input  v-cntxt-db-num
     2675               ,input  v-cntxt-userid
     2676               ,input  v-diasize-proc-name
     2677               ,input  'height':u
     2678               ,output v-resize-value-str
     2679               ) .
     2680             if v-resize-value-str <> '':U
     2681             then do:
     2682               run diasize_change-height in this-procedure
     2683                 (input  integer(v-resize-value-str)
     2684                 ,input  true
     2685                 ) .
     2686               assign
     2687                 v-restore-saved = true
     2688               .
     2689             end.
     2690           end.
     2691           if connected("ub") = true
     2692           then do:
     2693             run gbl/wndsizer.p
     2694               (input  v-cntxt-db-num
     2695               ,input  v-cntxt-userid
     2696               ,input  v-diasize-proc-name
     2697               ,input  'width':u
     2698               ,output v-resize-value-str
     2699               ) .
     2700             if v-resize-value-str <> '':U
     2701             then do:
     2702               run diasize_change-width in this-procedure
     2703                 (input  integer(v-resize-value-str)
     2704                 ,input  true
     2705                 ) .
     2706               assign
     2707                 v-restore-saved = true
     2708               .
     2709             end.
     2710           end.
     2711           if v-restore-saved <> true
     2712           then do:
     2713             if v-diasize-wndmax = true
     2714             then do:
     2715               run diasize_maximize in this-procedure
     2716                 (input  true
     2717                 ) .
     2718             end.
     2719           end.
     2720         end.
     2721         else do:
     2722           if v-diasize-wndmax = true
     2723           then do:
     2724             run diasize_maximize in this-procedure
     2725               (input  true
     2726               ) .
     2727           end.
     2728         end.
     2729       end.
     2730     end.
     2731   end procedure.
     2732   procedure diasize_need-full-display :
     2733     define output parameter p-need-full-display as logical   no-undo .
     2734     do
     2735     on error undo, return error return-value
     2736     :
     2737       assign
     2738         p-need-full-display = v-diasize-need-full-display
     2739       .
     2740       assign
     2741         v-diasize-need-full-display = false
     2742       .
     2743     end.
     2744   end procedure.
     2745   procedure get-context :
     2746      define output parameter p-db-num as integer          no-undo.
     2747      define output parameter p-user-id as character        no-undo.
     2748      define variable v-login               as character    no-undo.
     2749      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2750      define buffer buf_user-login  for ub.user-login .
     2751      do
     2752      on error undo, return error
     2753      :
     2754            FIND FIRST buf_sys-ctrl no-lock.
     2755            ASSIGN
     2756               v-login = USERID("ub")
     2757               p-db-num = buf_sys-ctrl.db-num
     2758            .
     2759            FIND FIRST buf_user-login
     2760                 WHERE buf_user-login.db-num = p-db-num
     2761                   AND buf_user-login.user-login = v-login
     2762                 no-lock
     2763                 no-error
     2764                 .
     2765            IF AVAILABLE buf_user-login
     2766            THEN DO:
     2767               assign
     2768                  p-user-id = buf_user-login.user-id
     2769               .
     2770            END.
     2771      end.
     2772   end procedure.
     2773       run diasize_init in this-procedure .
     2774   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME v-route:PARENT eq ?
     2775   THEN FRAME v-route:PARENT = ACTIVE-WINDOW.
     2776   MAIN-BLOCK:
     2777   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2778      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2779     run full-fill in this-procedure .
     2780     RUN MYenable.
     2781     WAIT-FOR GO OF FRAME v-route focus br-route.
     2782   END.
     2783   RUN disable_UI.
     2784   PROCEDURE disable_UI :
     2785     HIDE FRAME v-route.
     2786   END PROCEDURE.
     2787   PROCEDURE enable_UI :
     2788     DISPLAY t-all
     2789         WITH FRAME v-route.
     2790     ENABLE b-quit b-help t-all br-route
     2791         WITH FRAME v-route.
     2792     VIEW FRAME v-route.
     2793     OPEN QUERY br-route for each tt-esys-route no-lock   by tt-esys-route.ord-num .
     2794   END PROCEDURE.
     2795   PROCEDURE fill-tt :
     2796   define input parameter p1-esys-id  like ub.esys-route.esys-id    no-undo .
     2797     define input parameter p1-db-num   like ub.esys-route.db-num    no-undo .
     2798     define input parameter p1-pack-num like ub.esys-route.esr-last-pack no-undo .
     2799     do
     2800     on error undo, return error
     2801     :
     2802       define buffer buf_esys-route for ub.esys-route .
     2803       define variable v-key-rec     like ub.esys-route.esr-uniq-key-rec no-undo .
     2804       define variable v-delim-key   as   character             no-undo .
     2805       define variable v-route-descr as   character             no-undo .
     2806       for each buf_esys-route no-lock
     2807         where buf_esys-route.esys-id   = p1-esys-id
     2808           and buf_esys-route.db-num    = p1-db-num
     2809           and buf_esys-route.esr-last-pack = p1-pack-num
     2810       on error undo, return error
     2811       :
     2812         case entry( 1, buf_esys-route.esr-name-rec, chr(1) ):
     2813           when "delete":U then do:
     2814             assign
     2815               v-route-descr = "(удаление)" + chr(32)
     2816               v-delim-key   = chr(1)
     2817               v-key-rec     = substring( buf_esys-route.esr-name-rec, index( buf_esys-route.esr-name-rec, chr(1) ) + 1 )
     2818             .
     2819           end.
     2820           when "command":U then do:
     2821             case entry( 2, buf_esys-route.esr-name-rec, chr(1) ):
     2822               when "delete":U then do:
     2823                 assign
     2824                   v-route-descr = "(удаление)" + chr(32)
     2825                   v-delim-key   = chr(3)
     2826                   v-key-rec     = entry( 3, buf_esys-route.esr-name-rec, chr(1) )
     2827                 .
     2828               end.
     2829               otherwise do:
     2830                 assign
     2831                   v-route-descr = "команда" + chr(32)
     2832                   v-delim-key   = chr(1)
     2833                   v-key-rec     = "":U
     2834                 .
     2835               end.
     2836             end.
     2837           end.
     2838           otherwise do:
     2839             assign
     2840               v-route-descr = "":U
     2841               v-delim-key   = chr(3)
     2842               v-key-rec     = buf_esys-route.esr-uniq-key-rec
     2843             .
     2844           end.
     2845         end case.
     2846         if v-key-rec <> "":U then do:
     2847           case entry( 1, v-key-rec, v-delim-key ) :
     2848             when 'trn-doc':U then do:
     2849               assign
     2850                 v-route-descr = v-route-descr
     2851                                 + "складской документ N" + chr(32) + entry( 2, v-key-rec, v-delim-key )
     2852               .
     2853             end.
     2854             when 'price-doc':U then do:
     2855               assign
     2856                 v-route-descr = v-route-descr
     2857                                 + "переоценка N" + chr(32) + entry( 2, v-key-rec, v-delim-key )
     2858               .
     2859             end.
     2860             when 'fbr-doc':U then do:
     2861               assign
     2862                 v-route-descr = v-route-descr
     2863                                 + "документ производства N" + chr(32) + entry( 2, v-key-rec, v-delim-key )
     2864               .
     2865             end.
     2866             when 'rvs-doc':U then do:
     2867               assign
     2868                 v-route-descr = v-route-descr
     2869                                 + "сверка N" + chr(32) + entry( 2, v-key-rec, v-delim-key )
     2870               .
     2871             end.
     2872             when 'inkas':U then do:
     2873               assign
     2874                 v-route-descr = v-route-descr
     2875                                 + "продажа N" + chr(32) + entry( 2, v-key-rec, v-delim-key )
     2876               .
     2877             end.
     2878             when 'shift-obj':U then do:
     2879               assign
     2880                 v-route-descr = v-route-descr
     2881                                 + "смена N" + chr(32) + entry( 5, v-key-rec, v-delim-key ) + chr(32)
     2882                                 + "от" + chr(32) + entry( 4, v-key-rec, v-delim-key ) + chr(32)
     2883                                 + "на объекте тип:" + chr(32) + entry( 2, v-key-rec, v-delim-key ) + chr(32)
     2884                                 + "код:" + chr(32) + entry( 3, v-key-rec, v-delim-key )
     2885               .
     2886             end.
     2887             when 'clients':U then do:
     2888               assign
     2889                 v-route-descr = v-route-descr
     2890                                 + "контрагент" + chr(32)
     2891                                 + "тип:" + chr(32) + entry( 2, v-key-rec, v-delim-key ) + chr(32)
     2892                                 + "код:" + chr(32) + entry( 3, v-key-rec, v-delim-key )
     2893               .
     2894             end.
     2895             when 'goods':U then do:
     2896               assign
     2897                 v-route-descr = v-route-descr
     2898                                 + "товар код:" + chr(32) + entry( 2, v-key-rec, v-delim-key )
     2899               .
     2900             end.
     2901             when 'bar-code':U then do:
     2902               assign
     2903                 v-route-descr = v-route-descr
     2904                                 + "бар-код" + chr(32) + entry( 2, v-key-rec, v-delim-key )
     2905               .
     2906             end.
     2907             when 'prod-bc':U then do:
     2908               assign
     2909                 v-route-descr = v-route-descr
     2910                                 + "доп. код" + chr(32) + entry( 3, v-key-rec, v-delim-key ) + chr(32)
     2911                                 + "для бар-кода" + chr(32) + entry( 2, v-key-rec, v-delim-key )
     2912               .
     2913             end.
     2914             when 'gds-grp':U then do:
     2915               assign
     2916                 v-route-descr = v-route-descr
     2917                                 + "группа товаров код:" + chr(32) + entry( 2, v-key-rec, v-delim-key )
     2918               .
     2919             end.
     2920             when 'cli-grp':U then do:
     2921               assign
     2922                 v-route-descr = v-route-descr
     2923                                 + "группа клиентов код:" + chr(32) + entry( 2, v-key-rec, v-delim-key )
     2924               .
     2925             end.
     2926             when 'db':U then do:
     2927               assign
     2928                 v-route-descr = v-route-descr
     2929                                 + "УБД" + chr(32) + entry( 2, v-key-rec, v-delim-key )
     2930               .
     2931             end.
     2932             when 'recipe':U then do:
     2933               assign
     2934                 v-route-descr = v-route-descr
     2935                                 + "рецепт" + chr(32) + entry( 2, v-key-rec, v-delim-key )
     2936               .
     2937             end.
     2938             when 'config':U then do:
     2939               assign
     2940                 v-route-descr = v-route-descr
     2941                                 + "настроечный параметр" + chr(32) + entry( 2, v-key-rec, v-delim-key )
     2942               .
     2943             end.
     2944             otherwise do:
     2945               if t-all = true then do:
     2946                 assign
     2947                   v-route-descr = "Без расшифровки --->"
     2948                 .
     2949               end.
     2950               else do:
     2951                 assign
     2952                   v-route-descr = "":U
     2953                 .
     2954               end.
     2955             end.
     2956           end case.
     2957         end.
     2958         else do:
     2959           case entry( 2, buf_esys-route.esr-name-rec, v-delim-key ) :
     2960             when "goods":U then do:
     2961               if entry( 3, buf_esys-route.esr-name-rec, v-delim-key ) = "ren-art":U then do:
     2962                 assign
     2963                   v-route-descr = v-route-descr
     2964                                   + "переименование товара" + chr(32)
     2965                                   + entry( 4, buf_esys-route.esr-name-rec, v-delim-key ) + chr(32)
     2966                                   + "ст. арт." + chr(32) + entry( 5, buf_esys-route.esr-name-rec, v-delim-key ) + chr(32)
     2967                                   + "ст. тип пр." + chr(32) + entry( 6, buf_esys-route.esr-name-rec, v-delim-key ) + chr(32)
     2968                                   + "ст. код пр." + chr(32) + entry( 7, buf_esys-route.esr-name-rec, v-delim-key ) + chr(32)
     2969                                   + "н. арт." + chr(32) + entry( 8, buf_esys-route.esr-name-rec, v-delim-key ) + chr(32)
     2970                                   + "н. тип пр." + chr(32) + entry( 9, buf_esys-route.esr-name-rec, v-delim-key ) + chr(32)
     2971                                   + "н. код пр." + chr(32) + entry( 10, buf_esys-route.esr-name-rec, v-delim-key )
     2972                 .
     2973               end.
     2974             end.
     2975             otherwise do:
     2976               if t-all = true then do:
     2977                 assign
     2978                   v-route-descr = "Без расшифровки --->"
     2979                 .
     2980               end.
     2981               else do:
     2982                 assign
     2983                   v-route-descr = "":U
     2984                 .
     2985               end.
     2986             end.
     2987           end case.
     2988         end.
     2989         if v-route-descr <> "":U then do:
     2990           create tt-esys-route .
     2991           assign
     2992             tt-esys-route.descr        = v-route-descr
     2993             tt-esys-route.esr-name-rec     = buf_esys-route.esr-name-rec
     2994             tt-esys-route.esr-uniq-key-rec = buf_esys-route.esr-uniq-key-rec
     2995             tt-esys-route.uniq-gate-rec = buf_esys-route.uniq-gate-rec
     2996             tt-esys-route.ord-num      = buf_esys-route.esr-tbl-ord
     2997             tt-esys-route.esys-id      = buf_esys-route.esys-id
     2998             tt-esys-route.db-num       = buf_esys-route.db-num
     2999             tt-esys-route.esr-pack-num     = buf_esys-route.esr-last-pack
     3000             tt-esys-route.esr-CreUserName  = buf_esys-route.esr-CreUserName
     3001             tt-esys-route.esr-CreDate      = buf_esys-route.esr-CreDate
     3002             tt-esys-route.esr-CreTime      = buf_esys-route.esr-CreTime
     3003             tt-esys-route.rec-rowid    = rowid( buf_esys-route )
     3004           .
     3005         end.
     3006       end.
     3007     end.
     3008   END PROCEDURE.
     3009   PROCEDURE full-fill :
     3010   define buffer buf_ext-system       for ub.ext-system.
     3011     define buffer buf_esys-pck-sent for ub.esys-pck-sent .
     3012     find first buf_ext-system no-lock
     3013       where buf_ext-system.esys-id = p-esys-id
     3014          and buf_ext-system.db-num = p-db-num
     3015       no-error
     3016     .
     3017     if not available buf_ext-system then do:
     3018       message
     3019         vss-workfile vss-revision vss-description skip
     3020         substitute( "ВС &1 не найдена", p-esys-id )
     3021         view-as alert-box error
     3022       .
     3023       return error .
     3024     end.
     3025     run waitfram-show in this-procedure
     3026       (input "Подождите идет сбор информации..."
     3027       ).
     3028     for each tt-esys-route
     3029     on error undo, return error
     3030     :
     3031       delete tt-esys-route.
     3032     end.
     3033     for each buf_esys-pck-sent no-lock
     3034         where buf_esys-pck-sent.esys-id = buf_ext-system.esys-id
     3035           and buf_esys-pck-sent.db-num = buf_ext-system.db-num
     3036           and buf_esys-pck-sent.esps-rcvd   = FALSE
     3037     on error undo, return error
     3038     :
     3039       run fill-tt in this-procedure
     3040         ( input buf_ext-system.esys-id
     3041          ,input buf_ext-system.db-num
     3042          ,input buf_esys-pck-sent.esps-pack-num
     3043         ) .
     3044     end.
     3045     run fill-tt in this-procedure
     3046       ( input buf_ext-system.esys-id
     3047        ,input buf_ext-system.db-num
     3048        ,input -1
     3049       ) .
     3050     run waitfram-hide in this-procedure .
     3051   END PROCEDURE.
     3052   PROCEDURE MyEnable :
     3053   assign
     3054   tt-esys-route.descr:resizable in browse br-route = yes
     3055   tt-esys-route.descr:width = 70
     3056   tt-esys-route.esr-name-rec:resizable in browse br-route = yes
     3057   tt-esys-route.esr-name-rec:width = 30
     3058   tt-esys-route.esr-uniq-key-rec:resizable in browse br-route = yes
     3059   tt-esys-route.esr-uniq-key-rec:width = 70
     3060   tt-esys-route.uniq-gate-rec:resizable in browse br-route = yes
     3061   tt-esys-route.uniq-gate-rec:width = 40
     3062   .
     3063   assign
     3064   frame v-route:title = substitute("Недошедшая информация для ВС &1",   p-esys-id )
     3065   .
     3066   DISPLAY t-all
     3067   WITH FRAME v-route.
     3068   ENABLE
     3069   b-quit
     3070   b-help
     3071   t-all
     3072   br-route
     3073   WITH FRAME v-route.
     3074   VIEW FRAME v-route.
     3075   OPEN QUERY br-route for each tt-esys-route no-lock   by tt-esys-route.ord-num .
     3076   apply "value-changed" to br-route in frame v-route.
     3077   END PROCEDURE.
     3078   FUNCTION get-gate-file-name-f RETURNS CHARACTER
     3079     ( input p-gate-rec as character ) :
     3080   define variable v-gate-file-name as character no-undo.
     3081   if p-gate-rec > '':U then do:
     3082     run get-gate-file-name in this-procedure ( input p-gate-rec
     3083                                              ,output v-gate-file-name) no-error.
     3084     if error-status:error then do:
     3085       v-gate-file-name = "!!!Гейт не найден".
     3086     end.
     3087   end.
     3088   return v-gate-file-name.
     3089   END FUNCTION.
