        1   block-level on error undo, throw.
        2   define input  parameter p-table-name as character no-undo.
        3   define input  parameter p-doc-code   as character no-undo.
        4   define output parameter p-seq-num    as integer   no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: get-oesq.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: bge/get-oesq.p $":U .
       10   define variable vss-description as character no-undo init "Получение номера sequence выгрузки в Oracle Retail для документа".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   procedure orddocattr-value :
       71     do
       72     on error undo, return error return-value
       73     :
       74       define input  parameter p-doc-code like ub.ord-doc-attr.doc-code   no-undo .
       75       define input  parameter p-code     like ub.ord-doc-attr.attr-code  no-undo .
       76       define output parameter p-value    like ub.ord-doc-attr.attr-value no-undo .
       77       define output parameter p-type     as character no-undo .
       78       define buffer buf_ord-doc-attr for ub.ord-doc-attr .
       79       define variable v-format         as character no-undo .
       80       define variable v-fillin_width   as integer   no-undo .
       81       define variable v-fillin_height  as integer   no-undo .
       82       define variable v-label          as character no-undo .
       83       define variable v-user-can-edit  as logical   no-undo .
       84       define variable v-output-display as logical   no-undo .
       85       define variable v-other          as character no-undo .
       86       define variable v-proc           as character no-undo .
       87       define variable v-func           as character no-undo .
       88       define variable v-sort           as integer   no-undo .
       89       run orddocattr-code in this-procedure
       90         (input  p-code
       91         ,output p-type
       92         ,output v-format
       93         ,output v-fillin_width
       94         ,output v-fillin_height
       95         ,output v-label
       96         ,output v-user-can-edit
       97         ,output v-output-display
       98         ,output v-proc
       99         ,output v-func
      100         ,output v-sort
      101         ,output v-other
      102         ) no-error .
      103       if error-status :error then do:
      104         undo, return error return-value .
      105       end.
      106       find first buf_ord-doc-attr no-lock
      107         where buf_ord-doc-attr.doc-code  = p-doc-code
      108           and buf_ord-doc-attr.attr-code = p-code
      109         no-error .
      110       if avail buf_ord-doc-attr then do:
      111         assign
      112           p-value =  buf_ord-doc-attr.attr-value
      113         .
      114       end.
      115       else do:
      116         assign
      117           p-value = if p-type = 'L':U then "no":U else ""
      118         .
      119       end.
      120     end.
      121   end procedure.
      122   procedure orddocattr-write :
      123     do
      124     on error undo, return error return-value
      125     :
      126       define input parameter p-doc-code like ub.ord-doc-attr.doc-code   no-undo .
      127       define input parameter p-code     like ub.ord-doc-attr.attr-code  no-undo .
      128       define input parameter p-value    like ub.ord-doc-attr.attr-value no-undo .
      129       define buffer buf_ord-doc-attr for ub.ord-doc-attr .
      130       define variable v-type           as character no-undo .
      131       define variable v-format         as character no-undo .
      132       define variable v-fillin_width   as integer   no-undo .
      133       define variable v-fillin_height  as integer   no-undo .
      134       define variable v-label          as character no-undo .
      135       define variable v-user-can-edit  as logical   no-undo .
      136       define variable v-output-display as logical   no-undo .
      137       define variable v-other          as character no-undo .
      138       define variable v-proc           as character no-undo .
      139       define variable v-func           as character no-undo .
      140       define variable v-sort           as integer   no-undo .
      141       run orddocattr-code in this-procedure
      142         (input  p-code
      143         ,output v-type
      144         ,output v-format
      145         ,output v-fillin_width
      146         ,output v-fillin_height
      147         ,output v-label
      148         ,output v-user-can-edit
      149         ,output v-output-display
      150         ,output v-proc
      151         ,output v-func
      152         ,output v-sort
      153         ,output v-other
      154         ) no-error .
      155       if error-status :error then do:
      156         undo, return error return-value .
      157       end.
      158       find first buf_ord-doc-attr exclusive-lock
      159         where buf_ord-doc-attr.doc-code  = p-doc-code
      160           and buf_ord-doc-attr.attr-code = p-code
      161         no-error .
      162       if not available buf_ord-doc-attr then do:
      163         create buf_ord-doc-attr .
      164         assign
      165           buf_ord-doc-attr.doc-code  = p-doc-code
      166           buf_ord-doc-attr.attr-code = p-code
      167         .
      168       end.
      169       assign
      170         buf_ord-doc-attr.attr-value = p-value
      171       .
      172   end.
      173   end procedure.
      174   procedure orddocattr-exist :
      175     do
      176     on error undo, return error return-value
      177     :
      178       define input parameter p-doc-code like ub.ord-doc-attr.doc-code   no-undo .
      179       define input parameter p-code     like ub.ord-doc-attr.attr-code  no-undo .
      180       define output parameter p-exist   as logical  no-undo .
      181       define buffer buf_ord-doc-attr for ub.ord-doc-attr .
      182       define variable v-type           as character no-undo .
      183       define variable v-format         as character no-undo .
      184       define variable v-fillin_width   as integer   no-undo .
      185       define variable v-fillin_height  as integer   no-undo .
      186       define variable v-label          as character no-undo .
      187       define variable v-user-can-edit  as logical   no-undo .
      188       define variable v-output-display as logical   no-undo .
      189       define variable v-other          as character no-undo .
      190       define variable v-proc           as character no-undo .
      191       define variable v-func           as character no-undo .
      192       define variable v-sort           as integer   no-undo .
      193       run orddocattr-code in this-procedure
      194         (input  p-code
      195         ,output v-type
      196         ,output v-format
      197         ,output v-fillin_width
      198         ,output v-fillin_height
      199         ,output v-label
      200         ,output v-user-can-edit
      201         ,output v-output-display
      202         ,output v-proc
      203         ,output v-func
      204         ,output v-sort
      205         ,output v-other
      206         ) no-error .
      207       if error-status :error then do:
      208         undo, return error return-value .
      209       end.
      210       find first buf_ord-doc-attr no-lock
      211         where buf_ord-doc-attr.doc-code  = p-doc-code
      212           and buf_ord-doc-attr.attr-code = p-code
      213         no-error .
      214       if  available buf_ord-doc-attr then do:
      215         p-exist = yes.
      216       end.
      217     end.
      218   end procedure.
      219   procedure orddocattr-delete :
      220     do
      221     on error undo, return error return-value
      222     :
      223       define input parameter p-doc-code like ub.ord-doc-attr.doc-code   no-undo .
      224       define input parameter p-code     like ub.ord-doc-attr.attr-code  no-undo .
      225       define output parameter p-deleted  as logical no-undo.
      226       define buffer buf_ord-doc-attr for ub.ord-doc-attr .
      227       define variable v-type           as character no-undo .
      228       define variable v-format         as character no-undo .
      229       define variable v-fillin_width   as integer   no-undo .
      230       define variable v-fillin_height  as integer   no-undo .
      231       define variable v-label          as character no-undo .
      232       define variable v-user-can-edit  as logical   no-undo .
      233       define variable v-output-display as logical   no-undo .
      234       define variable v-proc           as character no-undo .
      235       define variable v-func           as character no-undo .
      236       define variable v-sort           as integer   no-undo .
      237       define variable v-other          as character no-undo .
      238       run orddocattr-code in this-procedure
      239         (input  p-code
      240         ,output v-type
      241         ,output v-format
      242         ,output v-fillin_width
      243         ,output v-fillin_height
      244         ,output v-label
      245         ,output v-user-can-edit
      246         ,output v-output-display
      247         ,output v-proc
      248         ,output v-func
      249         ,output v-sort
      250         ,output v-other
      251         ) no-error .
      252       if error-status :error then do:
      253         undo, return error return-value .
      254       end.
      255       find first buf_ord-doc-attr exclusive-lock
      256         where buf_ord-doc-attr.doc-code  = p-doc-code
      257           and buf_ord-doc-attr.attr-code = p-code
      258         no-error NO-WAIT.
      259       if not available buf_ord-doc-attr then do:
      260         p-deleted = no.
      261       end.
      262       else do:
      263         delete buf_ord-doc-attr.
      264         p-deleted = yes.
      265       end.
      266     end.
      267   end procedure.
      268   procedure orddocattr-code :
      269     do on error undo, return error return-value
      270     :
      271       define input  parameter p-code           as character no-undo .
      272       define output parameter p-type           as character no-undo .
      273       define output parameter p-format         as character no-undo .
      274       define output parameter p-fillin_width   as integer   no-undo .
      275       define output parameter p-fillin_height  as integer   no-undo .
      276       define output parameter p-label          as character no-undo .
      277       define output parameter p-user-can-edit  as logical   no-undo .
      278       define output parameter p-output-display as logical   no-undo .
      279       define output parameter p-proc           as character no-undo .
      280       define output parameter p-func           as character no-undo .
      281       define output parameter p-sort           as integer   no-undo .
      282       define output parameter p-other          as character no-undo .
      283       case p-code :
      284               when 'cycle-doc-code':U then do:     assign     p-label          = "Номер заказа цикличного"     p-type           = 'C':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Номер заказа цикличного"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
      285               when 'cycle-day':U then do:     assign     p-label          = "период цикличности"     p-type           = 'I':U      p-format         = ">>>>>>9"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "период цикличности"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
      286               when 'cycle-done':U then do:     assign     p-label          = "Заказ рассчитан"     p-type           = 'C':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Заказ рассчитан"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
      287               when 'exch-code':U then do:     assign     p-label          = "Валюта Заказа"     p-type           = 'C':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Валюта Заказа"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
      288               when 'exch-rate':U then do:     assign     p-label          = "Валюта Заказа"     p-type           = 'C':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Валюта Заказа"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
      289               when 'exch-scale':U then do:     assign     p-label          = "Валюта Заказа"     p-type           = 'C':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Валюта Заказа"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
      290               when 'base-rate':U then do:     assign     p-label          = "Валюта Заказа"     p-type           = 'C':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Валюта Заказа"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
      291               when 'base-scale':U then do:     assign     p-label          = "Валюта Заказа"     p-type           = 'C':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Валюта Заказа"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
      292               when 'cycle-contract-code':U then do:     assign     p-label          = "договор"     p-type           = 'C':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "договор"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
      293               when 'cycle-ship-date':U then do:     assign     p-label          = "дата доставки"     p-type           = 'T':U      p-format         = "99/99/9999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "дата доставки"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
      294               when 'cycle-ship-time':U then do:     assign     p-label          = "время доставки"     p-type           = 'I':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "время доставки"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
      295               when 'cycle-date1':U then do:     assign     p-label          = "период продаж"     p-type           = 'T':U      p-format         = "99/99/9999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "период продаж"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
      296               when 'cycle-date2':U then do:     assign     p-label          = "период продаж"     p-type           = 'T':U      p-format         = "99/99/9999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "период продаж"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
      297               when 'cycle-doc-date':U then do:     assign     p-label          = "дата заказа"     p-type           = 'T':U      p-format         = "99/99/9999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "дата заказа"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
      298               when 'ora-exp-seq-num':U then do:     assign     p-label          = "Номер выгрузки в Oracle Retail"     p-type           = 'I':U      p-format         = "999999999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Номер выгрузки в Oracle Retail"     p-user-can-edit  = false     p-output-display = false     p-sort           = 100     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
      299         otherwise do:
      300           undo, return error "неизвестный атрибут строки заказа" + " " + p-code .
      301         end.
      302       end.
      303     end.
      304   end procedure.
      305   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      306   define new global shared variable g#trdcalib as handle no-undo.
      307     define buffer buf_trn-doc       for ub.trn-doc.
      308     define buffer buf_c-trn-doc     for ub.c-trn-doc.
      309     define buffer buf_price-doc     for ub.price-doc.
      310     define buffer buf_ord-doc       for ub.ord-doc.
      311     define variable v-seq-num as integer   no-undo .
      312     define variable v-exist   as logical   no-undo .
      313     define variable v-value   as character no-undo.
      314     define variable v-type    as character no-undo.
      315   do
      316   for buf_trn-doc
      317     , buf_c-trn-doc
      318     , buf_price-doc
      319     , buf_ord-doc
      320   on error undo, return error return-value
      321   :
      322     assign
      323       p-seq-num = ?
      324     .
      325     case p-table-name
      326     :
      327       when 'trn-doc':U
      328       or when 'c-trn-doc':U
      329       or when 'price-doc':U
      330       then do:
      331   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-xst in g#trdcalib (  input p-doc-code ,
      332                           input 'ora-exp-seq-num':U ,
      333                          output v-exist ) no-error .
      334         if error-status :error
      335         then do:
      336           undo, return error substitute( "&1 &2 &3 &4&5&4&6&4&7"
      337                                         , vss-workfile
      338                                         , vss-revision
      339                                         , vss-description
      340                                         , chr(10)
      341                                         , error-status :get-message(1)
      342                                         , return-value
      343                                         , "Ошибка из tdat-xst.i"
      344                                         ).
      345         end.
      346         if v-exist = no
      347         then do:
      348           return .
      349         end.
      350   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
      351                           input 'ora-exp-seq-num':U ,
      352                          output v-value ,
      353                          output v-type ) no-error .
      354         if error-status :error
      355         then do:
      356           undo, return error substitute( "&1 &2 &3 &4&5&4&6&4&7"
      357                                         , vss-workfile
      358                                         , vss-revision
      359                                         , vss-description
      360                                         , chr(10)
      361                                         , error-status :get-message(1)
      362                                         , return-value
      363                                         , "Ошибка из tdat-val.i"
      364                                         ).
      365         end.
      366       end.
      367       when 'ord-doc':U
      368       then do:
      369         run orddocattr-exist in this-procedure ( input p-doc-code
      370                                                 , input 'ora-exp-seq-num':U
      371                                                 , output v-exist
      372                                                 ) no-error .
      373         if error-status :error = yes
      374         then do:
      375           undo, return error substitute( "&1 &2 &3 &4&5&4&6&4&7"
      376                                         , vss-workfile
      377                                         , vss-revision
      378                                         , vss-description
      379                                         , chr(10)
      380                                         , error-status :get-message(1)
      381                                         , return-value
      382                                         , "Ошибка из orddocattr-exist"
      383                                         ).
      384         end.
      385         if v-exist = no
      386         then do:
      387           return .
      388         end.
      389         run orddocattr-value in this-procedure ( input p-doc-code
      390                                                 , input 'ora-exp-seq-num':U
      391                                                 , output v-value
      392                                                 , output v-type
      393                                                 ) no-error .
      394         if error-status :error
      395         then do:
      396           undo, return error substitute( "&1 &2 &3 &4&5&4&6&4&7"
      397                                         , vss-workfile
      398                                         , vss-revision
      399                                         , vss-description
      400                                         , chr(10)
      401                                         , error-status :get-message(1)
      402                                         , return-value
      403                                         , "Ошибка из orddocattr-value"
      404                                         ).
      405         end.
      406       end.
      407       otherwise do:
      408         undo, return error substitute( "&1 &2 &3 &4&5: &6"
      409                                       , vss-workfile
      410                                       , vss-revision
      411                                       , vss-description
      412                                       , chr(10)
      413                                       , "Недопустимый тип документа":U
      414                                       , p-table-name
      415                                       ).
      416       end.
      417     end case.
      418     assign
      419       v-seq-num = integer(v-value)
      420     no-error .
      421     if error-status :error = yes
      422     then do:
      423       undo, return error substitute( "&1 &2 &3 &4&5: &6"
      424                                     , vss-workfile
      425                                     , vss-revision
      426                                     , vss-description
      427                                     , chr(10)
      428                                     , "Ошибка преобразования номера пакета":U
      429                                     , v-value
      430                                     ).
      431     end.
      432     assign
      433       p-seq-num = v-seq-num
      434     .
      435   end.
