      236   define buffer buf_sys-ctrl for ub.sys-ctrl.
      237   define variable v-db-attr-value as character no-undo .
      238   do for
      239     buf_sys-ctrl
      240   on error undo, return error return-value
      241   :
      242     find first buf_sys-ctrl no-lock no-error .
      243     if not available buf_sys-ctrl
      244     then do:
      245       undo , return error "Не найдена запись sys-ctrl!" .
      246     end.
      247     if p-ora-exp-seq < 1
      248     then do:
      249       undo , return error substitute( "Ошибка записи параметра номера выгрузки Oracle Retail &1 для БД &2, значение параметра &3.&4Значение параметра не должно быть меньше 1"
      250                                     , 'ora-exp-seq':U
      251                                     , buf_sys-ctrl.db-num
      252                                     , p-ora-exp-seq
      253                                     , chr(10)
      254                                     ).
      255     end.
      256     assign
      257       v-db-attr-value = string(p-ora-exp-seq)
      258     .
      259     run db-attr-write in this-procedure ( input buf_sys-ctrl.db-num
      260                                         , input 'ora-exp-seq':U
      261                                         , input v-db-attr-value
      262                                         ) no-error .
      263     if error-status :error
      264     then do:
      265       undo , return error substitute( "Ошибка записи параметра номера выгрузки Oracle Retail &1 для БД &2, значение параметра &3"
      266                                     , 'ora-exp-seq':U
      267                                     , buf_sys-ctrl.db-num
      268                                     , v-db-attr-value
      269                                     ).
      270     end.
      271   end.
