     3151     define output parameter p-news           as logical   no-undo .
     3152     do
     3153     on error undo, return error
     3154     :
     3155           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ext-system-attr-news in g#attr-lib
     3156         (input  p-code
     3157         ,output p-news
     3158         ) no-error .
     3159       if error-status :error
     3160       then do:
     3161         undo, return error return-value .
     3162       end.
     3163     end.
     3164   end procedure.
     3165   procedure ext-system-attr-manual-edit :
     3166     define input  parameter p-code           as character no-undo .
