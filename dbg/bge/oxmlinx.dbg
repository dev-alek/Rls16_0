     3969                          add-log-file-name = m-add-log-file-name.
     3970                     run bge/cmdeigen.p (
     3971                                           input parparentproc
     3972                                           ,input this-procedure:handle
     3973                                           ,input p-log-handle
     3974                                           ,input buf_ext-system.esys-id
     3975                                           ,input buf_ext-system.db-num
     3976                                           ,input v-cur-db-num
     3977                                           ,input v-full-path
     3978                                           ,input v-file-name
     3979                                           ,input v-pack-data
     3980                                           ,input v-espr-pack-num
     3981                                           ,input add-log-file-name
     3982                                           ) no-error.
     3983                     if error-status:error then v-return-error = 1.
     3984                     end .
     3985                     set-size(v-pack-data) = 0 .
     3986                     if not can-find(first  ub.esys-pck-rcvd no-lock
     3987                                       where ub.esys-pck-rcvd.esys-id  = buf_Ext-system.esys-id
     3988                                         and ub.esys-pck-rcvd.db-num   = buf_Ext-system.db-num
     3989                                         and ub.esys-pck-rcvd.espr-cr-db-num   = g#db-num
     3990                                         and ub.esys-pck-rcvd.espr-pack-num = v-espr-pack-num
     3991                                         )
     3992                     then do:
     3993                       v-return-error = 2.
     3994                     end.
     3995                     else v-analys-count = v-analys-count + 1 . // для итогового сообщения о количестве обработанных пакетов
     3996                   end.
     3997                   if v-return-error > 0 then do:
     3998                   if v-err-type = '' then do:
     3999                     assign
     4000                     v-err-type = 'PROCESSING'.
     4001                   end.
     4002                   v-err-msg = substitute( "Ошибка при разборе файла &1.&2&3&2&4"
     4003                                           , v-file-name
     4004                                           ,chr(10)
     4005                                           , return-value
     4006                                           , (if v-return-error = 1
     4007                                             then trim( error-status :get-message( 1 ) )
     4008                                             else "Пакет принят неполностью")
     4009                                         )         .
     4010                   run write-log in p-log-handle (
     4011                                                   input 2
     4012                                                   ,input v-err-msg ).
     4013                     run send-msg-to-email in parparentproc
     4014                         ( input substitute( "ТН (ver &2) БД &1. Ошибка OXML при импорте пакета из ВС &2"
     4015                                           , v-ver-num
     4016                                           , v-cur-db-num
     4017                                           , buf_ext-system.esys-id )
     4018                         ,input v-err-msg
     4019                         ,input (if buf_ext-system.delivery-method = integer('3':U)
     4020                                 then entry(num-entries(add-log-file-name, chr(1)), add-log-file-name, chr(1))
     4021                                 else '')
     4022                         ) no-error .
     4023                     if error-status :error then do:
     4024                       run write-log in p-log-handle (
     4025                         input 2
     4026                       , input substitute( "&1. &3&2&4", vss-workfile, chr(10), error-status:get-message(1), return-value )
     4027                                                         ) .
     4028                     end.
     4029                   end.
     4030                   if buf_ext-system.delivery-method = integer('3':U) then do:
     4031                     if v-exch-file-date = "" then do:
     4032                       run cur-time in this-procedure ( output v-today, output v-time).
     4033                       v-exch-file-date = string(datetime(v-today, mtime), "99/99/9999 HH:MM:SS").
     4034                     end.
     4035                     run rul/ora-rcpt.p (
     4036                                           input parparentproc
     4037                                         ,input this-procedure:handle
     4038                                         ,input p-log-handle
     4039                                         ,input v-cmd-proc-handle
     4040                                         ,input v-cmd-code
     4041                                         ,input buf_ext-system.esys-id
     4042                                         ,input v-espr-pack-num
     4043                                         ,input v-file-name
     4044                                         ,input v-exch-file-date
     4045                                         ,input entry(num-entries(add-log-file-name, chr(1)), add-log-file-name, chr(1))
     4046                                         ,input v-err-type) no-error.
     4047                     if error-status:error then do:
     4048                       v-err-msg = substitute( "Ошибка при разборе файла &1&2Не удалось сформировать квитанцию для пакета.&2&3&2&4"
     4049                                               , v-file-name
     4050                                               ,chr(10)
     4051                                               , return-value
     4052                                               , error-status:get-message(1)
     4053                                             )         .
     4054                       os-delete value(entry(num-entries(add-log-file-name, chr(1)), add-log-file-name, chr(1))).
     4055                       assign
     4056                       add-log-file-name = add-log-file-name0
     4057                       .
     4058                       run write-log in p-log-handle (
     4059                                                       input 2
     4060                                                       ,input v-err-msg
     4061                                                                         ).
     4062                       run send-msg-to-email in parparentproc
     4063                         ( input substitute( "ТН (ver &2) БД &1. Ошибка OXML при импорте пакета из ВС &2"
     4064                                           , v-ver-num
     4065                                           , v-cur-db-num
     4066                                           , buf_ext-system.esys-id )
     4067                         ,input v-err-msg
     4068                         ,input (if buf_ext-system.delivery-method = integer('3':U)
     4069                                 then entry(num-entries(add-log-file-name, chr(1)), add-log-file-name, chr(1))
     4070                                 else '')
     4071                         ) no-error .
     4072                       if error-status :error then do:
     4073                       run write-log in p-log-handle (
     4074                         input 2
     4075                       , input substitute( "&1. &3&2&4", vss-workfile, chr(10), error-status:get-message(1), return-value )
     4076                                                         ) .
     4077                       end.
     4078                     end.
     4079                     if v-err-type = '' then  do:
     4080                       os-delete value(entry(num-entries(add-log-file-name, chr(1)), add-log-file-name, chr(1))).
     4081                     end.
     4082                     assign
     4083                     add-log-file-name = add-log-file-name0
     4084                     .
     4085                   end.
     4086                   if buf_ext-system.delivery-method = integer('11':U)
     4087                   and v-return-error > 0
     4088                   then do:
     4089                     run gbl/ren-file.p (input v-full-path,
     4090                                         input (v-path + "\err_" + v-file-name)
     4091                                         ) no-error.
     4092                     if v-cert-enabled then do :
     4093                       v-position = r-index(v-sign-file, "\") .
     4094                     run gbl/ren-file.p (input v-sign-file,
     4095                                         input (v-path + "\err_" + substring(v-sign-file, v-position + 1))
     4096                                         ) no-error.
     4097                     end .
     4098                   end.
     4099                   if v-return-error > 0
     4100                   and buf_ext-system.delivery-method <> integer('5':U)
     4101                   then do:
     4102                     return error ''.
     4103                   end.
     4104                   assign
     4105                     v-rcvd-pack = true
     4106                   .
     4107                   if not (v-espr-pack-name begins "ack_") then
     4108                   v-espr-pack-num = v-espr-pack-num + 1 .
     4109                   if ( v-pack-num <> -1
     4110                       and v-espr-pack-num > v-pack-num
     4111                     )
     4112                     or lookup( v-action, "analys":U ) <> 0
     4113                   then do:
     4114                     leave rcvd-pack.
     4115                   end.
     4116                 end.
     4117               end.
     4118               run gbl/del-file.p ( input v-temp-dir ) no-error .
     4119               if error-status:error then do:
     4120                 run write-to-log( vss-workfile + chr(32)
     4121                                   + substitute( "&1", return-value )
     4122                                 ).
     4123               end.
     4124               if (v-analys-count = 0) and (lookup( v-action, "take,take+analys":U ) > 0) then
     4125                 run write-log in p-log-handle (  input 2
     4126                                                   ,substitute(" для ВС '&1' нет разобранных пакетов", buf_ext-system.esys-name ) ) .
     4127               run write-log in p-log-handle (  input 2
     4128                                                   ,substitute(v-msg-templ-finish, buf_ext-system.esys-name ) ) .
     4129           end.
     4130           add-log-file-name = ?.
     4131         end.
     4132       end.
     4133       if valid-object(v-pkcs) then delete object v-pkcs .
     4134       run write-log in p-log-handle (
     4135             input 1
     4136           , input "Загрузка данных по внешним системам завершена."
     4137       ).
     4138   end.
     4139   procedure get-log-file-name :
     4140   define output parameter p-log-file-name as character no-undo .
     4141     do
     4142     on error undo, return error
     4143     :
     4144       p-log-file-name = add-log-file-name.
     4145     end.
     4146   end procedure.
     4147   procedure set-err-type :
     4148   define input parameter p-err-type as character no-undo .
     4149   if v-err-type = '' then v-err-type = p-err-type.
     4150   end procedure.
     4151   procedure set-exch-date-time :
     4152   define input parameter p-exch-file-date as character no-undo .
     4153   v-exch-file-date = p-exch-file-date.
     4154   end procedure.
     4155   procedure cb_fill-filelist :
     4156   define input parameter p-file-name as character no-undo .
     4157   define input parameter p-dm as integer no-undo .
     4158   define variable v-file-name as character no-undo .
     4159   do
     4160   on error undo, return error
     4161   :
     4162     find first temp-filelist where
     4163               temp-filelist.file-name = p-file-name no-error.
     4164     if p-dm = integer('9':U)
     4165     then do:
     4166       if not available temp-filelist then do:
     4167         create temp-filelist.
     4168         if num-entries(p-file-name, '.':u) > 1
     4169         then do:
     4170           assign
     4171             temp-filelist.file-extension = entry(num-entries(p-file-name, '.':u), p-file-name,  '.':u )
     4172             temp-filelist.file-name-no-ext = entry(num-entries(p-file-name, '.':u) - 1, p-file-name, '.':u )
     4173           .
     4174         end.
     4175         else do:
     4176           assign
     4177             temp-filelist.file-extension = ''
     4178             temp-filelist.file-extension = p-file-name
     4179           .
     4180         end.
     4181         assign
     4182         temp-filelist.file-name = p-file-name.
     4183         release temp-filelist.
     4184       end.
     4185     end.
     4186     else do:
     4187       if not available temp-filelist then do:
     4188         v-file-name = p-file-name.
     4189         entry(1, v-file-name, "_") = "".
     4190         create temp-filelist.
     4191         assign
     4192         temp-filelist.file-name = p-file-name
     4193         temp-filelist.full-name = v-file-name
     4194         .
     4195         release temp-filelist.
     4196       end.
     4197     end.
     4198   end.
     4199   end procedure.
     4200   procedure get-num-namepack :
     4201   define input parameter p-target-dir as character no-undo .
     4202   define input parameter p-esys-id as integer no-undo .
     4203   define input parameter p-db-num as integer no-undo .
     4204   define input parameter p-ext-sys-met as integer no-undo .
     4205   define variable v-file-pack-num as integer no-undo .
     4206   define variable datestr as character no-undo.
     4207   define variable timestr as character no-undo.
     4208     define variable xml-source as character no-undo.
     4209     define variable xml-result as character no-undo.
     4210     define variable java as character no-undo.
     4211     define variable saxon as character no-undo.
     4212     define variable xsl as character no-undo.
     4213     define variable ii as integer no-undo.
     4214   do
     4215   on error undo, return error
     4216   :
     4217     case p-ext-sys-met :
     4218       when 11 then do :
     4219         run filelist-init in this-procedure
     4220         (input p-target-dir
     4221         ,input true
     4222         ,input "xml" // ,p7s,p7c"
     4223   
     4224         ,input ""
     4225         ) no-error.
     4226         if error-status:error then do:
     4227           undo, return error .
     4228         end.
     4229         
     4230         for each temp-filelist:
     4231           /* пакеты и аски оставляем;
     4232              прочие файлы игнорируем:
     4233              - where temp-filelist.file-name begins "err_"
     4234              - исключаем файлы с электронной подисью (такая же стоит в bge/espcknum.p):
     4235                if (v-sign-fileext > "") and (temp-filelist.file-extension = v-sign-fileext)
     4236              - ещё электронная подпись, связанная с bge/espcknum.p и bge/oxmlspci.w:
     4237                if can-do("p7s,p7c", temp-filelist.file-extension)
     4238              - в директорию импорта стали попадать файлы иконок, сслылок, и прочего,
     4239                у которых другая структура имени и потом они ругаются на entry(3, ...):
     4240                if num-entries(temp-filelist.file-name, "_") > 2 then . else delete temp-filelist .
     4241           */
     4242           if  num-entries(temp-filelist.file-name, "_") = 4 then do :
     4243            /* if p-esys-id = integer (entry (2, temp-filelist.file-name-no-ext, "_")) then .
     4244             else do :
     4245               delete temp-filelist.
     4246               next .  
     4247             end . */
     4248             v-file-pack-num = integer (entry (3, temp-filelist.file-name-no-ext, "_")) no-error .
     4249             if error-status:error then do:
     4250               /* ошибка возникнет при присвоении, если неверное имя пакета - например начинается не с номера пакета, пропускаем идем дальше.*/
     4251               delete temp-filelist.
     4252               next .  
     4253             end.
     4254             if v-espr-pack-num > v-file-pack-num then next .  
     4255             create tt-espcknum.
     4256             assign
     4257               tt-espcknum.tt-espr-pack-name = temp-filelist.file-name
     4258               tt-espcknum.tt-espr-pack-num  = v-file-pack-num
     4259             .
     4260           end .
     4261           else if (  num-entries(temp-filelist.file-name, "_") = 5
     4262                      and temp-filelist.file-name begins "ack"  ) then do :
     4263             /*if p-esys-id = integer (entry (3, temp-filelist.file-name-no-ext, "_")) then .
     4264             else do :
     4265               delete temp-filelist.
     4266               next .  
     4267             end .*/
     4268           end .
     4269           else do :
     4270             /* прочие файлы игнорируем */
     4271             delete temp-filelist.
     4272             next.
     4273           end.
     4274         end. /* end_of for_each temp-filelist */
     4275   
     4276       end . /* end_of when esys-dm-erp-1C-RN */
     4277       when 9 then do :
     4278         
     4279         ii = 0.
     4280         for each temp-filelist
     4281            where temp-filelist.file-name begins "fail" 
     4282         and not (temp-filelist.file-name matches "*Stsmsg*"
     4283              or  temp-filelist.file-name matches "*unknown*") :
     4284           ii = ii + 1.
     4285           create tt-espcknum.
     4286           assign
     4287             tt-espcknum.tt-espr-pack-name = temp-filelist.file-name + "."
     4288             tt-espcknum.tt-espr-pack-num = ii
     4289           no-error.      
     4290         end.
     4291         for each temp-filelist where temp-filelist.file-name begins "ok" 
     4292         and  not (temp-filelist.file-name matches "*Stsmsg*"
     4293                   or  temp-filelist.file-name matches "*unknown*") :
     4294         ii = ii + 1.
     4295         create tt-espcknum.
     4296         assign
     4297           tt-espcknum.tt-espr-pack-name = temp-filelist.file-name + "."
     4298           tt-espcknum.tt-espr-pack-num = ii
     4299         no-error.
     4300         end.
     4301         for each temp-filelist where temp-filelist.file-name begins "ORDRSP" :
     4302         ii = ii + 1.
     4303         create tt-espcknum.
     4304         assign
     4305           tt-espcknum.tt-espr-pack-name = temp-filelist.file-name + "."
     4306           tt-espcknum.tt-espr-pack-num = ii
     4307         no-error.
     4308         end.
     4309         for each temp-filelist where temp-filelist.file-name begins "DESADV" :
     4310         ii = ii + 1.
     4311         create tt-espcknum.
     4312         assign
     4313           tt-espcknum.tt-espr-pack-name = temp-filelist.file-name + "."
     4314           tt-espcknum.tt-espr-pack-num = ii
     4315         no-error.            
     4316         end.
     4317         
     4318       end . /* end_of when esys-dm-contour-edi */
     4319       otherwise return .
     4320     end case .
     4321   
     4322     
     4323   
     4324   /* 04/III-2019 - не используется
     4325     if v-l-err then
     4326       run write-log in p-log-handle (
     4327             input 1
     4328           , input substitute( "При преобразовании файла(ов) возникли ошибки. Проверьте целостность xml пакетов.")
     4329       ).
     4330   */
     4331   end.
     4332   
     4333   end procedure. /* get-num-namepack */
