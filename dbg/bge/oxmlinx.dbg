      294                       then do:
      295                           assign
      296                               p-out-string = p-out-string + " ":U
      297                           .
      298                       end.
      299                       when chr(5)
      300                       then do:
      301                           assign
      302                               p-out-string = p-out-string + " ":U
      303                           .
      304                       end.
      305                       when chr(6)
      306                       then do:
      307                           assign
      308                               p-out-string = p-out-string + " ":U
      309                           .
      310                       end.
      311                       when chr(7)
      312                       then do:
      313                           assign
      314                               p-out-string = p-out-string + " ":U
      315                           .
      316                       end.
      317                       when chr(8)
      318                       then do:
      319                           assign
      320                               p-out-string = p-out-string + " ":U
      321                           .
      322                       end.
      323                       when chr(9)
      324                       then do:
      325                           assign
      326                               p-out-string = p-out-string + " ":U
