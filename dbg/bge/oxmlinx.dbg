        1   block-level on error undo, throw.
        2   define input parameter parparentproc    as widget-handle    no-undo.
        3   define input parameter p-parent-handle      as widget-handle    no-undo.
        4   define input parameter p-log-handle         as handle           no-undo.
        5   define input parameter p-parameter-string   as character        no-undo.
        6   define variable vss-revision    as character no-undo init "$Revision: 10060ac8659a, 2974, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
        8   define variable vss-date        as character no-undo init "$Date: Ср апр 06 16:23:42 2022 +0300 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: oxmlinx.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: bge/oxmlinx.p $":U .
       11   define variable vss-description as character no-undo init "Импорт из файла OpenXML".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "X(65)" no-undo
       82   initial "@(#)$Workfile$ $Revision$".
       83   procedure xmlchar-test :
       84   define input parameter p-in-string          as character        no-undo.
       85   define output parameter p-out-string-enc    as character        no-undo.
       86   define output parameter p-out-string-dec    as character        no-undo.
       87   do
       88   on error undo, return error
       89   :
       90          run xmlchar-encode in this-procedure
       91       (
       92             input p-in-string
       93           , output p-out-string-enc
       94       ).
       95          run xmlchar-decode in this-procedure
       96       (
       97             input p-out-string-enc
       98           , output p-out-string-dec
       99       ).
      100   end.
      101   end .
      102   procedure xmlchar-encode :
      103   define input parameter p-in-string      as character        no-undo.
      104   define output parameter p-out-string    as character        no-undo.
      105       define variable v-position      as integer      no-undo.
      106       define variable v-current-char  as character    no-undo.
      107   do
      108   on error undo, return error
      109   :
      110       assign
      111           p-out-string = "":U
      112       .
      113       case p-in-string
      114       :
      115           when ?
      116           then do:
      117               assign
      118                   p-out-string = "?":U
      119               .
      120           end.
      121           when "?":U
      122           then do:
      123               assign
      124                   p-out-string = "&#63;":U
      125               .
      126           end.
      127           otherwise do:
      128               do v-position = 1 to length( p-in-string )
      129               :
      130                   assign
      131                       v-current-char = substring( p-in-string, v-position, 1 )
      132                   .
      133                   case v-current-char
      134                   :
      135                       when "&":U
      136                       then do:
      137                           assign
      138                               p-out-string = p-out-string + "&amp;":U
      139                           .
      140                       end.
      141                       when ">":U
      142                       then do:
      143                           assign
      144                               p-out-string = p-out-string + "&gt;":U
      145                           .
      146                       end.
      147                       when "<":U
      148                       then do:
      149                           assign
      150                               p-out-string = p-out-string + "&lt;":U
      151                           .
      152                       end.
      153                       when "'":U
      154                       then do:
      155                           assign
      156                               p-out-string = p-out-string + "&apos;":U
      157                           .
      158                       end.
      159                       when '"':U
      160                       then do:
      161                           assign
      162                               p-out-string = p-out-string + "&quot;":U
      163                           .
      164                       end.
      165                       when chr(1)
      166                       then do:
      167                           assign
      168                               p-out-string = p-out-string + "":U
      169                           .
      170                       end.
      171                       when chr(2)
      172                       then do:
      173                           assign
      174                               p-out-string = p-out-string + "":U
      175                           .
      176                       end.
      177                       when chr(3)
      178                       then do:
      179                           assign
      180                               p-out-string = p-out-string + "":U
      181                           .
      182                       end.
      183                       when chr(4)
      184                       then do:
      185                           assign
      186                               p-out-string = p-out-string + "":U
      187                           .
      188                       end.
      189                       when chr(5)
      190                       then do:
      191                           assign
      192                               p-out-string = p-out-string + "":U
      193                           .
      194                       end.
      195                       when chr(6)
      196                       then do:
      197                           assign
      198                               p-out-string = p-out-string + "":U
      199                           .
      200                       end.
      201                       when chr(7)
      202                       then do:
      203                           assign
      204                               p-out-string = p-out-string + "":U
      205                           .
      206                       end.
      207                       when chr(8)
      208                       then do:
      209                           assign
      210                               p-out-string = p-out-string + "":U
      211                           .
      212                       end.
      213                       when chr(9)
      214                       then do:
      215                           assign
      216                               p-out-string = p-out-string + "":U
      217                           .
      218                       end.
      219                       when chr(29)
      220                       then do:
      221                           assign
      222                               p-out-string = p-out-string + "":U
      223                           .
      224                       end.
      225                       when chr(10)
      226                       then do:
      227                           assign
      228                               p-out-string = p-out-string + "&#10;":U
      229                           .
      230                       end.
      231                       when chr(13)
      232                       then do:
      233                           assign
      234                               p-out-string = p-out-string + "&#13;":U
      235                           .
      236                       end.
      237                       otherwise do:
      238                           assign
      239                               p-out-string = p-out-string + v-current-char
      240                           .
      241                       end.
      242                   end case.
      243               end.
      244           end.
      245       end case.
      246   end.
      247   end .
      248   procedure xmlchar-encode-1c :
      249   define input parameter p-in-string      as character        no-undo.
      250   define output parameter p-out-string    as character        no-undo.
      251       define variable v-position      as integer      no-undo.
      252       define variable v-current-char  as character    no-undo.
      253   do
      254   on error undo, return error
      255   :
      256       assign
      257           p-out-string = "":U
      258       .
      259       case p-in-string
      260       :
      261           when ?
      262           then do:
      263               assign
      264                   p-out-string = "?":U
      265               .
      266           end.
      267           otherwise do:
      268               do v-position = 1 to length( p-in-string )
      269               :
