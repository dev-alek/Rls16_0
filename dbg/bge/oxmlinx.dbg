     3169     on error undo, return error
     3170     :
     3171           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ext-system-attr-manual-edit in g#attr-lib
     3172         (input  p-code
     3173         ,output p-section-num
     3174         ) no-error .
     3175       if error-status :error
     3176       then do:
     3177         undo, return error return-value .
     3178       end.
     3179     end.
     3180   end procedure.
     3181   procedure ext-system-attr-batch-edit :
