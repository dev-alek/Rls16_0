      358   procedure xmlchar-decode :
      359   define input parameter p-in-string      as character        no-undo.
      360   define output parameter p-out-string    as character        no-undo.
      361       define variable v-position      as integer      no-undo.
      362       define variable v-last-position as integer      no-undo.
      363       define variable v-temp-integer  as integer      no-undo.
      364       define variable v-current-char  as character    no-undo.
      365       define variable v-next-char     as character    no-undo.
      366       define variable v-success       as logical      no-undo.
      367   do
      368   on error undo, return error
      369   :
      370       assign
      371           p-out-string = "":U
      372           v-position   = 0
      373       .
      374       replace-cycle:
      375       do while yes
      376       on error undo, return error
      377       :
      378           assign
      379               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      380           .
      381           if v-last-position <= v-position
      382           then do:
      383               if v-position = 0
      384               then do:
      385                   assign
      386                       p-out-string = p-in-string
      387                   .
      388               end.
      389               else do:
      390                   assign
      391                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      392                   .
      393               end.
      394               leave replace-cycle.
      395           end.
      396           else do:
      397               assign
      398                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      399                   v-position      = v-last-position
      400                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      401               .
      402               if v-current-char = "#":U
      403               then do:
      404                   assign
      405                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      406                   .
      407                   if v-last-position > 0
      408                   then do:
      409                       run xmlchar-read-integer in this-procedure
      410                        (
      411                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      412                           , output v-temp-integer
      413                           , output v-success
      414                       ).
      415                       if v-success = yes
      416                       and v-temp-integer >= 1
      417                       and v-temp-integer <= 255
      418                       then do:
      419                           assign
      420                               p-out-string = p-out-string + chr( v-temp-integer )
      421                               v-position   = v-last-position + 1
      422                           .
      423                       end.
      424                       else do:
      425                           assign
      426                               p-out-string = p-out-string + "&":U
      427                               v-position   = v-position   + 1
      428                           .
      429                       end.
      430                   end.
      431                   else do:
      432                       assign
      433                           p-out-string = p-out-string + "&":U
      434                           v-position   = v-position   + 1
      435                       .
      436                   end.
      437               end.
      438               else do:
      439                   case substring( p-in-string, v-position + 1, 3 )
      440                   :
      441                       when "lt;":U
      442                       then do:
      443                           assign
      444                               p-out-string = p-out-string + "<":U
      445                               v-position   = v-position   + 3
      446                           .
      447                       end.
      448                       when "gt;":U
      449                       then do:
      450                           assign
      451                               p-out-string = p-out-string + ">":U
      452                               v-position   = v-position   + 3
      453                           .
      454                       end.
      455                       otherwise do:
      456                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      457                           then do:
      458                               assign
      459                                   p-out-string = p-out-string + "&":U
      460                                   v-position   = v-position   + 4
      461                               .
      462                           end.
      463                           else do:
      464                               case substring( p-in-string, v-position + 1, 5 )
      465                               :
      466                                   when "quot;":U
      467                                   then do:
      468                                       assign
      469                                           p-out-string = p-out-string + '"':U
      470                                           v-position   = v-position   + 5
      471                                       .
      472                                   end.
      473                                   when "apos;":U
      474                                   then do:
      475                                       assign
      476                                           p-out-string = p-out-string + "'":U
      477                                           v-position   = v-position   + 5
      478                                       .
      479                                   end.
      480                                   otherwise do:
      481                                       assign
      482                                           p-out-string = p-out-string + "&":U
      483                                       .
      484                                   end.
      485                               end case.
      486                           end.
      487                       end.
      488                   end case.
      489               end.
      490           end.
      491       end.
      492   end.
      493   end .
      494   procedure xmlchar-read-integer :
      495   define input parameter p-input-string      as character        no-undo.
      496   define output parameter p-output-integer   as integer          no-undo.
      497   define output parameter p-success       as logical          no-undo.
      498   do
      499   on error undo, return error
      500   :
      501       assign
      502           p-output-integer = integer( p-input-string )
      503       no-error.
      504       if error-status :error
      505       then do:
      506           assign
      507               p-success           = no
      508               p-output-integer    = 0
      509           .
      510       end.
      511       else do:
      512           assign
      513               p-success           = yes
      514           .
      515       end.
      516   end.
      517   end.
      518   define variable vss-include-info1 as character format "X(65)" no-undo
      519   initial "@(#)$Workfile$ $Revision$".
      520   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      521   procedure cur-time :
      522      define output parameter p-today as date      no-undo .
      523      define output parameter p-time  as integer   no-undo .
      524     do
      525     on error undo, return error
      526     :
      527       define variable v-date1 as date      no-undo .
      528       define variable v-date2 as date      no-undo .
      529       define variable v-time  as integer   no-undo .
      530       assign
      531         v-date1 = today
      532         v-time  = time
      533         v-date2 = today
      534       .
      535       if v-date1 <> v-date2
      536       then do:
      537         assign
      538           v-date1 = today
      539           v-time  = v-time
      540         .
      541       end.
      542       assign
      543         p-today = v-date1
      544         p-time  = v-time
      545       .
      546     end.
      547   end.
      548   function cur-time-date returns character
      549   :
      550     return string(today, '99/99/9999':U) .
      551   end.
      552   function cur-time-mjd returns decimal
      553   :
      554     define variable v-date as date      no-undo .
      555     define variable v-time as integer   no-undo .
      556     run cur-time in this-procedure
      557       (output v-date
      558       ,output v-time
      559       ) .
      560     return integer(v-date) - 2400002 + (v-time / 86400) .
      561   end.
      562   function cur-time-get-ending-index returns integer
      563   (input p-number as integer
      564   )
      565   :
      566     if p-number < 0
      567     or p-number = ?
      568     then do:
      569       return 1 .
      570     end.
      571     define variable v-rest as integer   no-undo .
      572     assign
      573       p-number = p-number modulo 100
      574     .
      575     if p-number < 20
      576     then do:
      577       assign
      578         v-rest = p-number
      579       .
      580     end.
      581     else do:
      582       assign
      583         v-rest = p-number modulo 10
      584       .
      585     end.
      586     case v-rest :
      587       when 1
      588       then do:
      589         return 2 .
      590       end.
      591       when 2 or
      592       when 3 or
      593       when 4
      594       then do:
      595         return 3 .
      596       end.
      597       otherwise do:
      598         return 1 .
      599       end.
      600     end case .
      601   end.
      602   procedure cur-time-mjd-to-date :
      603      define input  parameter i-mjd-diff as decimal no-undo.
      604      define output parameter o-Date     as date    no-undo.
      605      define output parameter o-Time     as integer no-undo.
      606      define variable v-day-number as integer   no-undo .
      607      if    i-mjd-diff < 0
      608         or i-mjd-diff = ?
      609      then do:
      610         return "?" .
      611      end.
      612      assign
      613         v-day-number = truncate(i-mjd-diff,0).
      614         o-Date = date(v-day-number + 2400002).
      615         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      616     .
      617   end.
      618   function cur-time-mjd-to-string returns character
      619   (input p-mjd-diff as decimal
      620   )
      621   :
      622     define variable v-day-number as integer   no-undo .
      623     define variable v-seconds    as integer   no-undo .
      624     define variable v-hour       as integer   no-undo .
      625     define variable v-min        as integer   no-undo .
      626     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      627     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      628     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      629     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      630     if p-mjd-diff < 0
      631     or p-mjd-diff = ?
      632     then do:
      633       return "?" .
      634     end.
      635     assign
      636       v-day-number = integer(truncate(p-mjd-diff,0))
      637       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      638     .
      639     if v-seconds > 86400
      640     then do:
      641       assign
      642         v-seconds = 86400 - 1
      643       .
      644     end.
      645     if v-seconds < 0
      646     then do:
      647       assign
      648         v-seconds = 0
      649       .
      650     end.
      651     assign
      652       v-hour = truncate(v-seconds / 3600, 0)
      653     .
      654     assign
      655       v-seconds = v-seconds modulo 3600
      656     .
      657     assign
      658       v-min = truncate(v-seconds / 60, 0)
      659     .
      660     assign
      661       v-seconds = v-seconds modulo 60
      662     .
      663     return
      664         (if v-day-number <> 0
      665           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      666           else ""
      667         )
      668       + (if v-day-number <> 0 or v-hour <> 0
      669           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      670           else ""
      671         )
      672       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      673           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      674           else ""
      675         )
      676       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      677       .
      678   end.
      679   function cur-time-string returns character
      680   :
      681     define variable v-date as date      no-undo .
      682     define variable v-time as integer   no-undo .
      683     run cur-time in this-procedure
      684       (output v-date
      685       ,output v-time
      686       ) .
      687     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      688   end.
      689   function cur-time-string-sec returns character
      690   :
      691     define variable v-date as date      no-undo .
      692     define variable v-time as integer   no-undo .
      693     run cur-time in this-procedure
      694       (output v-date
      695       ,output v-time
      696       ) .
      697     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      698   end.
      699   function cur-time-custom  returns character
      700   (input p-prefix as character
      701   ,input p-date-format as character
      702   ,input p-delimiter as character
      703   ,input p-time-format as character
      704   ,input p-suffix as character
      705   )
      706   :
      707     define variable v-date as date      no-undo .
      708     define variable v-time as integer   no-undo .
      709     run cur-time in this-procedure
      710       (output v-date
      711       ,output v-time
      712       ) .
      713     return
      714       p-prefix
      715       + string(v-date, p-date-format)
      716       + p-delimiter
      717       + string(v-time, p-time-format)
      718       + p-suffix
      719       .
      720   end.
      721   function cur-time-print  returns character
      722   :
      723     define variable v-date as date      no-undo .
      724     define variable v-time as integer   no-undo .
      725     run cur-time in this-procedure
      726       (output v-date
      727       ,output v-time
      728       ) .
      729     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      730   end.
      731   function cur-time-datetime returns datetime
      732   :
      733     define variable v-char as character no-undo .
      734     define variable v-datetime as datetime no-undo .
      735     v-char = cur-time-string().
      736     v-datetime = datetime(v-char).
      737     return  v-datetime.
      738   end.
      739   function cur-time-string-msec returns character
      740   :
      741     define variable v-date as datetime  no-undo .
      742     v-date = now.
      743     return string(v-date) .
      744   end.
      745   define stream stmXMLOut.
      746   define stream stmXMLLog.
      747   define stream strXMLIn.
      748   define temp-table temp_xmllib_rec-list no-undo
      749       field recName       as character
      750       field recLevel      as integer
      751       field recOpenLine   as integer
      752       field recCloseLine  as integer
      753       field closed        as logical
      754       index pi is primary unique
      755           recName
      756           recLevel
      757       index cl
      758           closed
      759   .
      760   define temp-table temp_xmllib_rec-fld-list no-undo
      761       field recName       as character
      762       field recLevel      as integer
      763       field fldName       as character
      764       field fldOpenLine   as integer
      765       field fldCloseLine  as integer
      766       field closed        as logical
      767       index pi is primary unique
      768           recName
      769           recLevel
      770           fldName
      771       index fn
      772           fldName
      773       index cl
      774           closed
      775   .
      776   define temp-table temp_xmllib_rec no-undo
      777       field rec-key       as integer
      778       field recLevel      as integer
      779       field recOpenLine   as integer
      780       field recCloseLine  as integer
      781       field recName       as character
      782       field closed        as logical
      783       index pi is primary unique
      784           rec-key
      785       index nm
      786           recName
      787           closed
      788           rec-key
      789       index cl
      790           closed
      791       index rlv
      792           recName
      793           recLevel
      794           closed
      795           rec-key
      796   .
      797   define temp-table temp_xmllib_rec-fld no-undo
      798       field fld-key       as integer
      799       field rec-key       as integer
      800       field fldOpenLine   as integer
      801       field fldCloseLine  as integer
      802       field fldName       as character
      803       field fldValue      as character
      804       field closed        as logical
      805       index pi is primary unique
      806           fld-key
      807       index nm
      808           rec-key
      809           fldName
      810           closed
      811           fld-key
      812       index cl
      813           closed
      814   .
      815   define variable v-xmllib-rec-key            as integer      no-undo .
      816   define variable v-xmllib-rec-fld-key        as integer      no-undo .
      817   define variable v-xmllib-dirname            as character    no-undo .
      818   define variable v-xmllib-filename           as character    no-undo .
      819   define variable v-xmllib-log-filename       as character    no-undo .
      820   define variable v-xmllib-log-handle         as handle       no-undo .
      821   define variable v-xmllib-log-proc-name      as character    no-undo .
      822   define variable v-xmllib-error-status       as logical      no-undo .
      823   define variable v-xmllib-sax-reader-handle  as handle       no-undo .
      824   define variable v-xmllib-prg-bar-handle     as handle       no-undo .
      825   define variable v-xmllib-codepage-convert   as logical      no-undo .
      826   define variable v-xmllib-codepage-source    as character    no-undo .
      827   define variable v-xmllib-codepage-target    as character    no-undo .
      828   procedure xmllib-clear-parse-data :
      829   do
      830   on error undo, return error
      831   :
      832       empty temp-table temp_xmllib_rec-list.
      833       empty temp-table temp_xmllib_rec-fld-list.
      834       empty temp-table temp_xmllib_rec.
      835       empty temp-table temp_xmllib_rec-fld.
      836   end.
      837   end procedure.
      838   procedure xmllib-add-rec-fld :
      839   define input parameter p-rec-name       as character        no-undo.
      840   define input parameter p-rec-fld-name   as character        no-undo.
      841       define buffer buf_rec-list        for temp_xmllib_rec-list.
      842       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
      843   do
      844   for buf_rec-list
      845     , buf_rec-fld-list
      846   on error undo, return error
      847   :
      848       find first buf_rec-list
      849            where buf_rec-list.recName = p-rec-name
      850       no-error.
      851       if not available buf_rec-list
      852       then do:
      853           create buf_rec-list.
      854           assign
      855               buf_rec-list.recName        = p-rec-name
      856               buf_rec-list.recOpenLine    = 0
      857               buf_rec-list.recCloseLine   = 0
      858               buf_rec-list.closed         = yes
      859           .
      860       end.
      861       find first buf_rec-fld-list
      862            where buf_rec-fld-list.recName = p-rec-name
      863              and buf_rec-fld-list.fldName = p-rec-fld-name
      864       no-error.
      865       if not available buf_rec-fld-list
      866       then do:
      867           create buf_rec-fld-list.
      868           assign
      869               buf_rec-fld-list.recName        = p-rec-name
      870               buf_rec-fld-list.fldName        = p-rec-fld-name
      871               buf_rec-fld-list.fldOpenLine    = 0
      872               buf_rec-fld-list.fldCloseLine   = 0
      873               buf_rec-fld-list.closed         = yes
      874           .
      875       end.
      876   end.
      877   end procedure.
      878   procedure xmllib-tag-open:
      879   define input parameter v-tag-level  as integer      no-undo.
      880   define input parameter v-tag-name   as character    no-undo.
      881   define input parameter v-tag-value  as character    no-undo.
      882   do
      883   on error undo, return error
      884   :
      885       assign
      886           v-tag-name = trim( v-tag-name )
      887       .
      888       put stream stmXMLOut unformatted
      889           substitute( "&1&2<&3&4&5>"
      890               , chr(10)
      891               , fill(" ", 4 * v-tag-level)
      892               , v-tag-name
      893               , ( if v-tag-value = "":U or v-tag-value = ? then "":U else " ":U )
      894               , v-tag-value
      895           )
      896       .
      897   end.
      898   end procedure.
      899   procedure xmllib-tag-put:
      900   define input parameter v-tag-level      as integer      no-undo.
      901   define input parameter v-tag-name       as character    no-undo.
      902   define input parameter v-tag-value      as character    no-undo.
      903   define input parameter v-empty-mode     as integer      no-undo.
      904   do
      905   on error undo, return error
      906   :
      907       assign
      908           v-tag-name = trim( v-tag-name )
      909       .
      910       if  v-empty-mode = 1
      911       or (v-empty-mode = 0 and (v-tag-value <> "":U and v-tag-value <> ?) )
      912       or (v-empty-mode = 2 and (v-tag-value <> "":U and v-tag-value <> ? and v-tag-value <> "0":U))
      913       or (v-empty-mode = 3 and (v-tag-value <> "":U and v-tag-value <> ? and caps(v-tag-value) <> "no":U))
      914       then do:
      915           run xmlchar-encode in this-procedure (
      916                 input v-tag-value
      917               , output v-tag-value
      918           ).
      919           put stream stmXMLOut unformatted
      920               substitute( "&1&2<&3>&4</&3>"
      921                   , chr(10)
      922                   , fill(" ":U, 4 * v-tag-level)
      923                   , v-tag-name
      924                   , v-tag-value
      925               )
      926           .
      927       end.
      928   end.
      929   end procedure.
      930   procedure xmllib-tag-put-null :
      931   define input parameter p-tag-level  as integer      no-undo.
      932   define input parameter p-tag-name   as character    no-undo.
      933   do
      934   on error undo, return error
      935   :
      936       assign
      937           p-tag-name = trim( p-tag-name )
      938       .
      939       put stream stmXMLOut unformatted
      940           substitute( '&1&2<&3 nil="true" /&3>'
      941               , chr(10)
      942               , fill(" ":U, 4 * p-tag-level)
      943               , p-tag-name
      944           )
      945       .
      946   end.
      947   end procedure.
      948   procedure xmllib-tag-close:
      949   define input parameter v-tag-level as integer      no-undo.
      950   define input parameter v-tag-name  as character    no-undo.
      951   do
      952   on error undo, return error
      953   :
      954       assign
      955           v-tag-name = trim( v-tag-name )
      956       .
      957       put stream stmXMLOut unformatted
      958           substitute( "&1&2</&3>"
      959               , chr(10)
      960               , fill( " ":U, 4 * v-tag-level)
      961               , v-tag-name
      962           )
      963       .
      964   end.
      965   end procedure.
      966   procedure xmllib-write-log:
      967   define input parameter v-filename   as character    no-undo.
      968   define input parameter v-log-level  as integer      no-undo.
      969   define input parameter v-out-string as character    no-undo.
      970   do
      971   on error undo, return error
      972   :
      973       output stream stmXMLLog to value( v-filename ) append.
      974       put stream stmXMLLog unformatted
      975           chr(10)
      976       .
      977       put stream stmXMLLog unformatted
      978           ( if v-log-level = 0
      979             or v-out-string = "&DLine":U
      980             or v-out-string = "&Line":U
      981             then "":U
      982             else cur-time-string-sec() + " ":U )
      983       .
      984       put stream stmXMLLog unformatted
      985           ( if v-out-string = "&Line":U
      986             then fill( "-":U, 80 )
      987             else if v-out-string = "&DLine":U
      988                  then fill( "=":U, 80 )
      989                  else v-out-string )
      990       .
      991       output stream stmXMLLog close.
      992   end.
      993   end procedure.
      994   procedure xmllib-write-edt:
      995   define input parameter v-editor-handle    as handle       no-undo.
      996   define input parameter v-log-level        as integer      no-undo.
      997   define input parameter v-out-string       as character    no-undo.
      998   do
      999   on error undo, return error
     1000   :
     1001       if valid-handle ( v-editor-handle )
     1002       then do:
     1003           v-editor-handle :move-to-eof().
     1004           v-editor-handle :insert-string( ( if v-log-level = 0
     1005                                             or v-out-string = "&DLine":U
     1006                                             or v-out-string = "&Line":U
     1007                                             then "":U
     1008                                             else cur-time-string-sec() + " ":U
     1009                                         ) ).
     1010           v-editor-handle :insert-string( ( if v-out-string = "&Line":U
     1011                                             then fill( "-":U, 80 )
     1012                                             else if v-out-string = "&DLine":U then fill("=":U, 80)
     1013                                             else fill( " ":U, v-log-level) + v-out-string
     1014                                         ) ).
     1015           v-editor-handle :insert-string( chr(10) ).
     1016       end.
     1017   end.
     1018   end procedure.
     1019   procedure xmllib-show-cnt:
     1020   define input parameter v-fillin-handle     as handle   no-undo.
     1021   do
     1022   on error undo, return error
     1023   :
     1024       if valid-handle( v-fillin-handle )
     1025       then do:
     1026           assign
     1027               v-fillin-handle :visible = true
     1028           .
     1029       end.
     1030   end.
     1031   end procedure.
     1032   procedure xmllib-hide-cnt:
     1033   define input parameter v-fillin-handle     as handle   no-undo.
     1034   do
     1035   on error undo, return error
     1036   :
     1037       if valid-handle( v-fillin-handle )
     1038       then do:
     1039           assign v-fillin-handle :visible = false.
     1040       end.
     1041   end.
     1042   end procedure.
     1043   procedure xmllib-write-cnt:
     1044   define input parameter v-fillin-handle    as handle       no-undo.
     1045   define input parameter v-fillin-string    as character    no-undo.
     1046   do
     1047   on error undo, return error
     1048   :
     1049       if valid-handle( v-fillin-handle )
     1050       then do:
     1051           assign
     1052               v-fillin-handle :SCREEN-value = v-fillin-string
     1053           .
     1054       end.
     1055   end.
     1056   end procedure.
     1057   procedure xmllib-write-header:
     1058   define input parameter p-first-file     as logical      no-undo.
     1059   define input parameter p-xml-file-name  as character    no-undo.
     1060   define input parameter p-list-file-name as character    no-undo.
     1061   define input parameter p-file-number    as integer      no-undo.
     1062   define input parameter p-have-prev      as logical      no-undo.
     1063   define input parameter p-prev-filename  as character    no-undo.
     1064   define input parameter p-parameter-list as character    no-undo.
     1065       define variable v-counter    as integer        no-undo.
     1066   do
     1067   on error undo, return error
     1068   :
     1069       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1070       put stream stmXMLOut unformatted
     1071           "<?xml version='1.0' encoding='windows-1251'?>"
     1072       .
     1073       run xmllib-tag-open( input 0, input "root"          , input "":U ).
     1074       run xmllib-tag-open( input 0, input "THheader"        , input "":U ).
     1075       run xmllib-tag-put( input 1 , input "THfileName"      , input p-xml-file-name + "xml":U  , input 0 ).
     1076       run xmllib-tag-put( input 1 , input "THfileNumber"    , input string( p-file-number     ), input 0 ).
     1077       run xmllib-tag-put( input 1 , input "THhavePrev"      , input string( p-have-prev       ), input 3 ).
     1078       run xmllib-tag-put( input 1 , input "THprevFileName"  , input p-prev-filename            , input 0 ).
     1079       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1080       :
     1081           run xmllib-tag-put(
     1082                 input 1
     1083               , input entry( 2 * v-counter, p-parameter-list )
     1084               , input entry( 2 * v-counter + 1, p-parameter-list )
     1085               , input 0
     1086           ).
     1087       end.
     1088       run xmllib-tag-close( input 0, input "THheader" ).
     1089       output stream stmXMLOut close.
     1090       if p-list-file-name <> "":U
     1091       then do:
     1092           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1093           if p-first-file = yes
     1094           then do:
     1095               put stream stmXMLOut unformatted
     1096                   "<?xml version='1.0' encoding='windows-1251'?>"
     1097               .
     1098               run xmllib-tag-open( input 0, input "OpenXML", input "" ).
     1099           end.
     1100           run xmllib-tag-open( input 1, input "THfile", input "" ).
     1101           run xmllib-tag-put( input 2, input "THfileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1102           run xmllib-tag-put( input 2, input "THfileNumber"     , input string( p-file-number     ), input 0 ).
     1103           run xmllib-tag-put( input 2, input "THhavePrev"       , input string( p-have-prev       ), input 3 ).
     1104           run xmllib-tag-put( input 2, input "THprevFileName"   , input p-prev-filename            , input 0 ).
     1105           do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1106           :
     1107               run xmllib-tag-put(
     1108                   input 2
     1109                   , input entry( 2 * v-counter, p-parameter-list )
     1110                   , input entry( 2 * v-counter + 1, p-parameter-list )
     1111                   , input 0
     1112               ).
     1113           end.
     1114           run xmllib-tag-close( input 1, input "THfile" ).
     1115           output stream stmXMLOut close.
     1116       end.
     1117   end.
     1118   end procedure.
     1119   procedure xmllib-write-footer:
     1120   define input parameter p-last-file      as logical      no-undo.
     1121   define input parameter p-xml-file-name  as character    no-undo.
     1122   define input parameter p-list-file-name as character    no-undo.
     1123   define input parameter p-have-next      as logical      no-undo.
     1124   define input parameter p-next-file-name as character    no-undo.
     1125       define variable v-error-num     as integer           no-undo.
     1126   do
     1127   on error undo, return error
     1128   :
     1129       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1130       if p-have-next = yes
     1131       then do:
     1132           run xmllib-tag-open( input 0, input "footer", "" ).
     1133           run xmllib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1134           run xmllib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1135           run xmllib-tag-close( input 0, input "footer" ).
     1136       end.
     1137       run xmllib-tag-close( input 0, input "root" ).
     1138       output stream stmXMLOut close.
     1139       run bge/os_copy.p (
     1140             input "M"
     1141           , input p-xml-file-name + "tmp"
     1142           , input p-xml-file-name + "xml"
     1143           , output v-error-num
     1144       ).
     1145       if p-last-file = yes
     1146       and p-list-file-name <> "":U
     1147       then do:
     1148           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1149               run xmllib-tag-close( input 0, input "OpenXML" ).
     1150           output stream stmXMLOut close.
     1151           run bge/os_copy.p (
     1152                 input "M"
     1153               , input p-list-file-name + "tmp"
     1154               , input p-list-file-name + "xml":U
     1155               , output v-error-num
     1156           ).
     1157       end.
     1158   end.
     1159   end procedure.
     1160   procedure xmllib-filename :
     1161   define input parameter p-subdir             as character        no-undo.
     1162   define input parameter p-prefix             as character    no-undo.
     1163   define output parameter p-xml-file-name     as character    no-undo.
     1164   define output parameter p-log-file-name     as character    no-undo.
     1165   define output parameter p-list-file-name    as character    no-undo.
     1166       define variable v-home-dir  as character    no-undo.
     1167       define variable v-error-num as integer      no-undo.
     1168   do
     1169   on error undo, return error
     1170   :
     1171       get-key-value section "OXML" key "oxml-dir" value v-home-dir.
     1172       if v-home-dir = ?
     1173       then do:
     1174           message
     1175             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1176             skip "Нет параметра oxml-dir в секции [OXML]."
     1177             skip(1)
     1178             skip "Обратитесь к администратору."
     1179           view-as alert-box error.
     1180           undo, return error .
     1181       end.
     1182       if p-subdir <> "":U
     1183       then do:
     1184           assign
     1185               v-home-dir = substitute( "&1/out/&2", v-home-dir, p-subdir )
     1186           .
     1187       end.
     1188       run gbl/dir-cre.p (
     1189           input v-home-dir
     1190       ) no-error.
     1191       if error-status :error
     1192       then do:
     1193           message
     1194             skip "Неверно задан каталог экспорта в ini-файле."
     1195             skip "Не удаётся создать каталог, указанный параметром"
     1196             skip "oxml-dir в секции [OXML]."
     1197             skip(1)
     1198             skip "Обратитесь к администратору."
     1199           view-as alert-box error.
     1200           undo, return error .
     1201       end.
     1202       run bge/genfname.p (
     1203             input v-home-dir
     1204           , input p-prefix
     1205           , input ""
     1206           , input "xml"
     1207           , input "tmp"
     1208           , output p-xml-file-name
     1209       ).
     1210       assign
     1211           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1212           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1213           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1214       .
     1215   end.
     1216   end procedure.
     1217   procedure xmllib-check-file-size :
     1218   define input parameter p-out-filename   as character    no-undo.
     1219   define output parameter p-is-big        as logical      no-undo.
     1220       define variable v-current-position    as integer        no-undo.
     1221   do
     1222   on error undo, return error
     1223   :
     1224       assign
     1225           v-current-position = seek( stmXMLOut )
     1226       .
     1227       if v-current-position / 1024 / 1024  >= 100
     1228       then do:
     1229           assign
     1230               p-is-big = yes
     1231           .
     1232       end.
     1233   end.
     1234   end procedure.
     1235   procedure xmllib-parse-file :
     1236   define input parameter p-full-filename      as character        no-undo.
     1237       define variable v-num-dirs              as integer      no-undo .
     1238       define variable v-str                   as character    no-undo .
     1239       define variable v-str-count             as int64        no-undo .
     1240   do
     1241   on error undo, return error
     1242   :
     1243       assign
     1244           v-num-dirs              = num-entries( p-full-filename,"\/":U )
     1245           v-xmllib-error-status   = no
     1246       .
     1247       if v-num-dirs > 1
     1248       then do:
     1249           assign
     1250               v-xmllib-filename = entry( v-num-dirs, p-full-filename, "\/":U )
     1251               v-xmllib-dirname  = substring( p-full-filename, 1, length( p-full-filename ) - length( v-xmllib-filename ) - 1 )
     1252           .
     1253       end.
     1254       else do:
     1255           assign
     1256               v-xmllib-filename = p-full-filename
     1257               v-xmllib-dirname  = "":U
     1258           .
     1259       end.
     1260       if valid-handle(v-xmllib-prg-bar-handle)
     1261       then do:
     1262   if session :set-wait-state( "compiler" ) then.
     1263         input stream strXMLIn from value(p-full-filename) .
     1264         repeat
     1265         :
     1266           import stream strXMLIn unformatted v-str no-error .
     1267           assign
     1268             v-str-count = v-str-count + 1
     1269           .
     1270         end.
     1271         input stream strXMLIn close .
     1272   if session :set-wait-state( "" ) then.
     1273         run prg-bar_init-cb-handle in this-procedure ( input v-xmllib-prg-bar-handle ) .
     1274         run prg-bar_new in this-procedure ( input 1 , input v-str-count) .
     1275         run prg-bar_show in this-procedure .
     1276       end.
     1277       create sax-reader v-xmllib-sax-reader-handle.
     1278       v-xmllib-sax-reader-handle :set-input-source( "FILE":U, p-full-filename ).
     1279       v-xmllib-sax-reader-handle :sax-parse( ) no-error.
     1280       if error-status :error
     1281       then do:
     1282           run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     1283                                                                       ,vss-workfile
     1284                                                                       ,vss-revision
     1285                                                                       ,vss-description
     1286                                                                       ,chr(10)
     1287                                                                       ,return-value
     1288                                                                       ,trim(error-status :get-message(1))
     1289                                                                       ,trim(error-status :get-message(2))
     1290                                                                       ,trim(error-status :get-message(3)))
     1291                                                     ).
     1292           undo, return error .
     1293       end.
     1294       if v-xmllib-error-status <> no
     1295       then do:
     1296           run xmllib-parse-error in this-procedure (
     1297               input "*** При обработке XML файла были ошибки."
     1298           ).
     1299           delete object v-xmllib-sax-reader-handle.
     1300       end.
     1301       delete object v-xmllib-sax-reader-handle.
     1302       if valid-handle(v-xmllib-prg-bar-handle)
     1303       then do:
     1304         run prg-bar_delete in this-procedure .
     1305       end.
     1306   end.
     1307   end procedure.
     1308   procedure xmllib-parse-progressive :
     1309   define input parameter p-full-filename      as character no-undo .
     1310   define input parameter p-pack-data          as memptr no-undo .
     1311   define input parameter p-parse-first        as logical no-undo .
     1312   define input parameter p-first-err          as logical no-undo .
     1313   define output parameter p-parse-status as integer no-undo .
     1314   define variable v-num-dirs              as integer no-undo .
     1315   define variable glog                    as logical no-undo .
     1316   define variable v-pack-size             as int64 no-undo .
     1317   do
     1318   on error undo, return error
     1319   :
     1320     if p-parse-first then do:
     1321       if valid-handle(v-xmllib-sax-reader-handle)
     1322       then do:
     1323       end.
     1324       assign
     1325           v-num-dirs              = num-entries( p-full-filename,"\/":U )
     1326           v-xmllib-error-status   = no
     1327       .
     1328       if v-num-dirs > 1
     1329       then do:
     1330           assign
     1331               v-xmllib-filename = entry( v-num-dirs, p-full-filename, "\/":U )
     1332               v-xmllib-dirname  = substring( p-full-filename, 1, length( p-full-filename ) - length( v-xmllib-filename ) - 1 )
     1333           .
     1334       end.
     1335       else do:
     1336           assign
     1337               v-xmllib-filename = p-full-filename
     1338               v-xmllib-dirname  = "":U
     1339           .
     1340       end.
     1341       create sax-reader v-xmllib-sax-reader-handle.
     1342       v-pack-size = get-size (p-pack-data) .
     1343       if v-pack-size > 0 then
     1344         glog = v-xmllib-sax-reader-handle :set-input-source( "MEMPTR":U, p-pack-data ) no-error.
     1345       else
     1346         glog = v-xmllib-sax-reader-handle :set-input-source( "FILE":U, p-full-filename ) no-error.
     1347       if error-status :error
     1348       or not glog
     1349       then do:
     1350         delete object v-xmllib-sax-reader-handle.
     1351         run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     1352                                                                     ,vss-workfile
     1353                                                                     ,vss-revision
     1354                                                                     ,vss-description
     1355                                                                     ,chr(10)
     1356                                                                     ,return-value
     1357                                                                     ,trim(error-status :get-message(1))
     1358                                                                     ,trim(error-status :get-message(2))
     1359                                                                     ,trim(error-status :get-message(3)) )
     1360                                                   ).
     1361         undo, return error .
     1362       end.
     1363       v-xmllib-sax-reader-handle :sax-parse-first( ) no-error.
     1364     end.
     1365     else do:
     1366       v-xmllib-sax-reader-handle :sax-parse-next( ) no-error.
     1367     end.
     1368     if error-status :error
     1369     then do:
     1370       delete object v-xmllib-sax-reader-handle.
     1371       run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     1372                                                                   ,vss-workfile
     1373                                                                   ,vss-revision
     1374                                                                   ,vss-description
     1375                                                                   ,chr(10)
     1376                                                                   ,return-value
     1377                                                                   ,trim(error-status :get-message(1))
     1378                                                                   ,trim(error-status :get-message(2))
     1379                                                                   ,trim(error-status :get-message(3)) )
     1380                                                 ).
     1381       undo, return error .
     1382     end.
     1383     if v-xmllib-error-status <> no
     1384     then do:
     1385       run xmllib-parse-error in this-procedure (
     1386           input "*** При обработке XML файла были ошибки."
     1387       ).
     1388       if p-first-err then do:
     1389         delete object v-xmllib-sax-reader-handle.
     1390       end.
     1391       else do:
     1392         v-xmllib-error-status = no.
     1393       end.
     1394     end.
     1395     if v-xmllib-sax-reader-handle:parse-status = SAX-COMPLETE  then do:
     1396       p-parse-status = SAX-COMPLETE.
     1397       delete object v-xmllib-sax-reader-handle.
     1398       return '':U.
     1399     end.
     1400     else do:
     1401       p-parse-status = v-xmllib-sax-reader-handle:parse-status.
     1402       return '':U.
     1403     end.
     1404   end.
     1405   end procedure.
     1406   procedure StartElement :
     1407   define input parameter p-name-space     as character        no-undo.
     1408   define input parameter p-local-name     as character        no-undo.
     1409   define input parameter p-q-name         as character        no-undo.
     1410   define input parameter p-attributes     as handle           no-undo.
     1411       define buffer buf_rec             for temp_xmllib_rec.
     1412       define buffer buf_rec-fld         for temp_xmllib_rec-fld.
     1413       define buffer buf_rec-list        for temp_xmllib_rec-list.
     1414       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     1415   do
     1416   for buf_rec
     1417     , buf_rec-fld
     1418     , buf_rec-list
     1419     , buf_rec-fld-list
     1420   on error undo, return error
     1421   :
     1422       if valid-handle(v-xmllib-prg-bar-handle)
     1423       then do:
     1424         run prg-bar_stepto in this-procedure ( input SELF:LOCATOR-LINE-NUMBER ) .
     1425       end.
     1426       find first buf_rec-list
     1427            where buf_rec-list.recName = p-q-name
     1428       no-error.
     1429       if available buf_rec-list
     1430       then do:
     1431           if buf_rec-list.closed = no
     1432           then do:
     1433               find first buf_rec-fld-list
     1434                    where buf_rec-fld-list.recName = buf_rec-list.recName
     1435                      and buf_rec-fld-list.fldName = p-q-name
     1436               no-error.
     1437               if available buf_rec-fld-list
     1438               and buf_rec-list.recName = buf_rec-fld-list.recName
     1439               then do:
     1440                   if buf_rec-fld-list.closed = no
     1441                   then do:
     1442                       run xmllib-parse-error in this-procedure (
     1443                           input substitute( "Ошибка 1 открытия поля <&1> записи <&2>: Поле с этим именем уже открыто на строке &3."
     1444                                           , p-q-name
     1445                                           , p-q-name
     1446                                           , buf_rec-fld-list.fldOpenLine
     1447                                           )
     1448                       ).
     1449                   end.
     1450                   else do:
     1451                       run xmllib-parse-rec-fld-open in this-procedure (
     1452                             input buf_rec-list.recName
     1453                           , input buf_rec-list.recLevel
     1454                           , input buf_rec-fld-list.fldName
     1455                       ).
     1456                       assign
     1457                           buf_rec-fld-list.closed         = no
     1458                           buf_rec-fld-list.fldOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     1459                           buf_rec-fld-list.fldCloseLine   = 0
     1460                       .
     1461                   end.
     1462               end.
     1463               else do:
     1464                   assign
     1465                       buf_rec-list.recLevel = buf_rec-list.recLevel + 1
     1466                   .
     1467                   run xmllib-parse-rec-open in this-procedure (
     1468                         input buf_rec-list.recName
     1469                       , input buf_rec-list.recLevel
     1470                   ).
     1471                   assign
     1472                       buf_rec-list.closed         = no
     1473                       buf_rec-list.recOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     1474                       buf_rec-list.recCloseLine   = 0
     1475                   .
     1476               end.
     1477           end.
     1478           else do:
     1479               run xmllib-parse-rec-open in this-procedure (
     1480                     input buf_rec-list.recName
     1481                   , input buf_rec-list.recLevel
     1482               ).
     1483               assign
     1484                   buf_rec-list.closed         = no
     1485                   buf_rec-list.recOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     1486                   buf_rec-list.recCloseLine   = 0
     1487               .
     1488           end.
     1489       end.
     1490       else do:
     1491           open-record:
     1492           for each buf_rec-fld-list
     1493              where buf_rec-fld-list.fldName = p-q-name
     1494           :
     1495               find first buf_rec-list
     1496                    where buf_rec-list.recName = buf_rec-fld-list.recName
     1497                      and buf_rec-list.closed  = no
     1498               no-error.
     1499               if available buf_rec-list
     1500               then do:
     1501                   run xmllib-parse-rec-fld-open in this-procedure (
     1502                         input buf_rec-list.recName
     1503                       , input buf_rec-list.recLevel
     1504                       , input buf_rec-fld-list.fldName
     1505                   ).
     1506                   assign
     1507                       buf_rec-fld-list.recLevel       = buf_rec-list.recLevel
     1508                       buf_rec-fld-list.closed         = no
     1509                       buf_rec-fld-list.fldOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     1510                       buf_rec-fld-list.fldCloseLine   = 0
     1511                   .
     1512                   leave open-record.
     1513               end.
     1514           end.
     1515       end.
     1516   end.
     1517   end procedure.
     1518   procedure Characters :
     1519   define input parameter p-char-data  as memptr.
     1520   define input parameter p-numchars   as integer.
     1521       define variable v-data-string    as character    no-undo.
     1522       define variable v-cp-utf8           as integer no-undo init 65001 .
     1523       define variable v-cp-windows1251    as integer no-undo init 1251 .
     1524       define buffer buf_xmllib_rec             for temp_xmllib_rec.
     1525       define buffer buf_xmllib_rec-fld         for temp_xmllib_rec-fld.
     1526       define buffer buf_xmllib_rec-list        for temp_xmllib_rec-list.
     1527       define buffer buf_xmllib_rec-fld-list    for temp_xmllib_rec-fld-list.
     1528   do
     1529   for buf_xmllib_rec
     1530     , buf_xmllib_rec-fld
     1531     , buf_xmllib_rec-list
     1532     , buf_xmllib_rec-fld-list
     1533   on error undo, return error
     1534   :
     1535       find first buf_xmllib_rec-list
     1536            where buf_xmllib_rec-list.closed = no
     1537       no-error.
     1538       if available buf_xmllib_rec-list
     1539       then do:
     1540           find first buf_xmllib_rec-fld-list
     1541                where buf_xmllib_rec-fld-list.closed = no
     1542           no-error.
     1543           if available buf_xmllib_rec-fld-list
     1544           and buf_xmllib_rec-fld-list.recName  = buf_xmllib_rec-list.recName
     1545           and buf_xmllib_rec-fld-list.recLevel = buf_xmllib_rec-list.recLevel
     1546           then do:
     1547               find last buf_xmllib_rec
     1548                   where buf_xmllib_rec.recName  = buf_xmllib_rec-list.recName
     1549                     and buf_xmllib_rec.recLevel = buf_xmllib_rec-list.recLevel
     1550                     and buf_xmllib_rec.closed   = no
     1551               use-index nm
     1552               no-error.
     1553               if available buf_xmllib_rec
     1554               then do:
     1555                   find last buf_xmllib_rec-fld
     1556                       where buf_xmllib_rec-fld.rec-key = buf_xmllib_rec.rec-key
     1557                         and buf_xmllib_rec-fld.fldName = buf_xmllib_rec-fld-list.fldName
     1558                         and buf_xmllib_rec-fld.closed = no
     1559                   use-index nm
     1560                   no-error.
     1561                   if available buf_xmllib_rec-fld
     1562                   then do:
     1563                       assign
     1564                           v-data-string = get-string( p-char-data, 1, get-size( p-char-data ) )
     1565                       .
     1566                       if v-xmllib-codepage-convert = yes
     1567                       then do:
     1568                         assign
     1569                             v-data-string = codepage-convert( v-data-string , v-xmllib-codepage-target , v-xmllib-codepage-source )
     1570                         .
     1571                       end.
     1572                       run xmlchar-decode in this-procedure (
     1573                           input v-data-string
     1574                           , output v-data-string
     1575                       ).
     1576                       assign
     1577                           buf_xmllib_rec-fld.fldValue = trim( substitute( "&1&2", buf_xmllib_rec-fld.fldValue, v-data-string ) )
     1578                       .
     1579                   end.
     1580               end.
     1581           end.
     1582       end.
     1583   end.
     1584   end procedure.
     1585   procedure EndElement :
     1586   define input parameter p-name-space     as character        no-undo.
     1587   define input parameter p-local-name     as character        no-undo.
     1588   define input parameter p-q-name         as character        no-undo.
     1589       define buffer buf_rec             for temp_xmllib_rec.
     1590       define buffer buf_rec-fld         for temp_xmllib_rec-fld.
     1591       define buffer buf_rec-list        for temp_xmllib_rec-list.
     1592       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     1593   do
     1594   for buf_rec
     1595     , buf_rec-fld
     1596     , buf_rec-list
     1597     , buf_rec-fld-list
     1598   on error undo, return error
     1599   :
     1600       find last buf_rec-list
     1601           where buf_rec-list.recName = p-q-name
     1602       use-index pi
     1603       no-error.
     1604       if available buf_rec-list
     1605       then do:
     1606           if buf_rec-list.closed = yes
     1607           then do:
     1608               run xmllib-parse-error in this-procedure (
     1609                   input substitute( "Ошибка закрытия записи или поля <&1>: Нет метки открытой записи."
     1610                                   , p-q-name
     1611                                   )
     1612               ).
     1613           end.
     1614           else do:
     1615               find last buf_rec
     1616                   where buf_rec.recName  = buf_rec-list.recName
     1617                     and buf_rec.recLevel = buf_rec-list.recLevel
     1618                     and buf_rec.closed   = no
     1619               use-index nm
     1620               no-error.
     1621               if not available buf_rec
     1622               then do:
     1623                   run xmllib-parse-error in this-procedure (
     1624                       input substitute( "Ошибка закрытия записи или поля <&1> уровня &2: Нет открытой записи."
     1625                                       , p-q-name
     1626                                       , buf_rec-list.recLevel
     1627                                       )
     1628                   ).
     1629               end.
     1630               else do:
     1631                   find first buf_rec-fld-list
     1632                        where buf_rec-fld-list.recName  = buf_rec.recName
     1633                          and buf_rec-fld-list.recLevel = buf_rec.recLevel
     1634                          and buf_rec-fld-list.fldName  = p-q-name
     1635                          and buf_rec-fld-list.closed   = no
     1636                   no-error.
     1637                   if not available buf_rec-fld-list
     1638                   then do:
     1639                       if buf_rec.recName <> p-q-name
     1640                       then do:
     1641                           run xmllib-parse-error in this-procedure (
     1642                               input substitute( "Ошибка закрытия записи <&1>: Имя открытой записи не совпадает с именем метки."
     1643                                               , buf_rec.recName
     1644                                               )
     1645                           ).
     1646                       end.
     1647                       else do:
     1648                           assign
     1649                               buf_rec.closed              = yes
     1650                               buf_rec.recCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     1651                               buf_rec-list.recCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     1652                           .
     1653                           if buf_rec-list.recLevel > 0
     1654                           then do:
     1655                               assign
     1656                                   buf_rec-list.recLevel = buf_rec-list.recLevel - 1
     1657                               .
     1658                               for each buf_rec-fld-list
     1659                                  where buf_rec-fld-list.recName = buf_rec-list.recName
     1660                               :
     1661                                   assign
     1662                                       buf_rec-fld-list.recLevel = buf_rec-fld-list.recLevel - 1
     1663                                   .
     1664                               end.
     1665                           end.
     1666                           else do:
     1667                               assign
     1668                                   buf_rec-list.closed         = yes
     1669                               .
     1670                           end.
     1671                       end.
     1672                   end.
     1673                   else do:
     1674                       find last buf_rec-fld
     1675                           where buf_rec-fld.rec-key = buf_rec.rec-key
     1676                             and buf_rec-fld.fldName = buf_rec-fld-list.fldName
     1677                             and buf_rec-fld.closed  = no
     1678                       use-index nm
     1679                       no-error.
     1680                       if not available buf_rec-fld
     1681                       then do:
     1682                           run xmllib-parse-error in this-procedure (
     1683                               input substitute( "Ошибка 2 закрытия поля <&1>: Не найдено открытое поле с этим именем в записи <&2> уровня &3."
     1684                                               , buf_rec-fld-list.fldName
     1685                                               , buf_rec.recName
     1686                                               , buf_rec.recLevel
     1687                                               )
     1688                           ).
     1689                       end.
     1690                       else do:
     1691                           assign
     1692                               buf_rec-fld.closed              = yes
     1693                               buf_rec-fld-list.closed         = yes
     1694                               buf_rec-fld.fldCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     1695                               buf_rec-fld-list.fldCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     1696                           .
     1697                       end.
     1698                   end.
     1699               end.
     1700           end.
     1701       end.
     1702       else do:
     1703           close-field-rec:
     1704           for each buf_rec-fld-list
     1705              where buf_rec-fld-list.fldName = p-q-name
     1706           :
     1707               find first buf_rec-list
     1708                    where buf_rec-list.recName  = buf_rec-fld-list.recName
     1709                      and buf_rec-list.recLevel = buf_rec-fld-list.recLevel
     1710                      and buf_rec-list.closed   = no
     1711               no-error.
     1712               if available buf_rec-list
     1713               then do:
     1714                   find last buf_rec
     1715                       where buf_rec.recName  = buf_rec-list.recName
     1716                         and buf_rec.recLevel = buf_rec-list.recLevel
     1717                         and buf_rec.closed   = no
     1718                   use-index nm
     1719                   no-error.
     1720                   if not available buf_rec
     1721                   then do:
     1722                       run xmllib-parse-error in this-procedure (
     1723                           input substitute( "Ошибка закрытия поля <&1>: Нет открытой записи."
     1724                                           , p-q-name
     1725                                           )
     1726                       ).
     1727                   end.
     1728                   else do:
     1729                       find last buf_rec-fld
     1730                           where buf_rec-fld.rec-key = buf_rec.rec-key
     1731                             and buf_rec-fld.fldName = buf_rec-fld-list.fldName
     1732                             and buf_rec-fld.closed  = no
     1733                       use-index nm
     1734                       no-error.
     1735                       if not available buf_rec-fld
     1736                       then do:
     1737                           run xmllib-parse-error in this-procedure (
     1738                               input substitute( "Ошибка 1 закрытия поля <&1>: Не найдено открытое поле с этим именем в записи <&2> уровня &3."
     1739                                               , buf_rec-fld-list.fldName
     1740                                               , buf_rec.recName
     1741                                               , buf_rec.recLevel
     1742                                               )
     1743                           ).
     1744                       end.
     1745                       else do:
     1746                           assign
     1747                               buf_rec-fld.closed              = yes
     1748                               buf_rec-fld-list.closed         = yes
     1749                               buf_rec-fld.fldCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     1750                               buf_rec-fld-list.fldCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     1751                           .
     1752                       end.
     1753                   end.
     1754                   leave close-field-rec.
     1755               end.
     1756           end.
     1757       end.
     1758   end.
     1759   end procedure.
     1760   procedure Error :
     1761   define input parameter p-error-message     as character        no-undo.
     1762   do
     1763   on error undo, return error
     1764   :
     1765       run xmllib-parse-error in this-procedure (
     1766           input p-error-message
     1767       ).
     1768       assign
     1769           v-xmllib-error-status = yes
     1770       .
     1771   end.
     1772   end procedure.
     1773   procedure xmllib-parse-error :
     1774   define input parameter p-err-message    as character        no-undo.
     1775   do
     1776   on error undo, return error
     1777   :
     1778       if valid-handle(v-xmllib-log-handle) then do:
     1779         run value(v-xmllib-log-proc-name) in  v-xmllib-log-handle
     1780                  (input substitute("&1Файл:    &2 &3&1Строка &4&1&5"
     1781                                    ,chr(10)
     1782                                    ,v-xmllib-dirname
     1783                                    ,v-xmllib-filename
     1784                                    ,(if valid-handle(v-xmllib-sax-reader-handle)
     1785                                      then v-xmllib-sax-reader-handle :locator-line-number
     1786                                      else ?)
     1787                                    ,p-err-message)).
     1788       end.
     1789       else do:
     1790         if v-xmllib-log-filename = "":U
     1791         then do:
     1792             message
     1793                     vss-workfile vss-revision vss-description
     1794                 skip "Файл:   " v-xmllib-dirname v-xmllib-filename
     1795                 skip "Строка: " (if valid-handle(v-xmllib-sax-reader-handle)
     1796                                  then v-xmllib-sax-reader-handle :locator-line-number
     1797                                  else ?)
     1798                 skip(1)
     1799                 skip p-err-message
     1800                 skip return-value
     1801                 skip trim( error-status :get-message( 1 ) )
     1802                     trim( error-status :get-message( 2 ) )
     1803                     trim( error-status :get-message( 3 ) )
     1804             view-as alert-box error.
     1805             undo, return error.
     1806         end.
     1807         else do:
     1808           output to value( v-xmllib-log-filename ).
     1809           put unformatted
     1810               substitute( "&1&2", chr(10), p-err-message )
     1811           .
     1812           output close.
     1813         end.
     1814       end.
     1815   end.
     1816   end procedure.
     1817   procedure xmllib-set-log-filename :
     1818   define input parameter p-log-filename   as character        no-undo.
     1819   do
     1820   on error undo, return error
     1821   :
     1822       run gbl/fileapnd.p (
     1823             input p-log-filename
     1824           , input "":U
     1825           , input 10
     1826       ) no-error.
     1827       if error-status :error
     1828       then do:
     1829           assign
     1830               v-xmllib-log-filename = "":U
     1831           .
     1832       end.
     1833       else do:
     1834           assign
     1835               v-xmllib-log-filename = p-log-filename
     1836           .
     1837       end.
     1838   end.
     1839   end procedure.
     1840   procedure xmllib-set-log-handle :
     1841   define input parameter p-log-handle    as handle        no-undo.
     1842   define input parameter p-log-proc-name as character no-undo .
     1843   do
     1844   on error undo, return error
     1845   :
     1846       if valid-handle(p-log-handle)
     1847       and lookup(p-log-proc-name, p-log-handle:internal-entries) > 0
     1848       then do:
     1849         assign
     1850         v-xmllib-log-handle    = p-log-handle
     1851         v-xmllib-log-proc-name = p-log-proc-name
     1852         .
     1853       end.
     1854       else do:
     1855         assign
     1856         v-xmllib-log-handle    = ?
     1857         v-xmllib-log-proc-name = '':U
     1858         .
     1859       end.
     1860   end.
     1861   end procedure.
     1862   procedure xmllib-set-prg-bar-handle :
     1863   define input parameter p-handle    as handle        no-undo.
     1864   do
     1865   on error undo, return error
     1866   :
     1867       if valid-handle(p-handle)
     1868       then do:
     1869         assign
     1870           v-xmllib-prg-bar-handle = p-handle
     1871         .
     1872       end.
     1873       else do:
     1874         assign
     1875           v-xmllib-prg-bar-handle = ?
     1876         .
     1877       end.
     1878   end.
     1879   end procedure.
     1880   procedure xmllib-set-codepage-convert :
     1881     define input  parameter p-codepage-source as character no-undo .
     1882     define input  parameter p-codepage-target as character no-undo .
     1883   do
     1884   on error undo, return error return-value
     1885   :
     1886     if ( p-codepage-source <> "" and p-codepage-target <> "" )
     1887     then do:
     1888       assign
     1889         v-xmllib-codepage-convert = yes
     1890         v-xmllib-codepage-source  = p-codepage-source
     1891         v-xmllib-codepage-target  = p-codepage-target
     1892       .
     1893     end.
     1894     else do:
     1895       assign
     1896         v-xmllib-codepage-convert = no
     1897         v-xmllib-codepage-source  = ""
     1898         v-xmllib-codepage-target  = ""
     1899       .
     1900     end.
     1901   end.
     1902   end procedure.
     1903   procedure xmllib-parse-rec-open :
     1904   define input parameter p-rec-name   as character        no-undo.
     1905   define input parameter p-rec-level  as integer          no-undo.
     1906       define buffer buf_temp_xmllib_rec       for temp_xmllib_rec.
     1907   do
     1908   for buf_temp_xmllib_rec
     1909   on error undo, return error
     1910   :
     1911        find first buf_temp_xmllib_rec
     1912            where buf_temp_xmllib_rec.recName = p-rec-name
     1913              and buf_temp_xmllib_rec.recLevel = p-rec-level
     1914              and buf_temp_xmllib_rec.closed  = no
     1915       use-index nm
     1916       no-error.
     1917       if available buf_temp_xmllib_rec
     1918       then do:
     1919           run xmllib-parse-error in this-procedure (
     1920               input substitute( "Ошибка 2 открытия записи <&1>: Запись с этим именем и уровнем &2 уже открыта на строке &3."
     1921                               , p-rec-name
     1922                               , p-rec-level
     1923                               , buf_temp_xmllib_rec.recOpenLine
     1924                               )
     1925           ).
     1926       end.
     1927       else do:
     1928           assign
     1929               v-xmllib-rec-key    = v-xmllib-rec-key + 1
     1930           .
     1931           create buf_temp_xmllib_rec.
     1932           assign
     1933               buf_temp_xmllib_rec.rec-key         = v-xmllib-rec-key
     1934               buf_temp_xmllib_rec.recOpenLine     = v-xmllib-sax-reader-handle :locator-line-number
     1935               buf_temp_xmllib_rec.recCloseLine    = 0
     1936               buf_temp_xmllib_rec.recName         = p-rec-name
     1937               buf_temp_xmllib_rec.recLevel        = p-rec-level
     1938               buf_temp_xmllib_rec.closed          = no
     1939           .
     1940       end.
     1941   end.
     1942   end procedure.
     1943   procedure xmllib-parse-rec-fld-open :
     1944   define input parameter p-rec-name   as character        no-undo.
     1945   define input parameter p-rec-level  as integer          no-undo.
     1946   define input parameter p-fld-name   as character        no-undo.
     1947       define buffer buf_temp_xmllib_rec       for temp_xmllib_rec.
     1948       define buffer buf_temp_xmllib_rec-fld   for temp_xmllib_rec-fld.
     1949   do
     1950   for buf_temp_xmllib_rec
     1951     , buf_temp_xmllib_rec-fld
     1952   on error undo, return error substitute( "Ошибка в xmllib-parse-rec-fld-open. &1. &2. &3"
     1953                                           , return-value
     1954                                           , trim( error-status :get-message( 1 ) )
     1955                                           , trim( error-status :get-message( 2 ) ) )
     1956   :
     1957       find last buf_temp_xmllib_rec
     1958           where buf_temp_xmllib_rec.recName   = p-rec-name
     1959             and buf_temp_xmllib_rec.recLevel  = p-rec-level
     1960             and buf_temp_xmllib_rec.closed    = no
     1961       use-index nm
     1962       no-error.
     1963       if not available buf_temp_xmllib_rec
     1964       then do:
     1965           run xmllib-parse-error in this-procedure (
     1966               input substitute( "Ошибка 2 открытия поля <&2> в записи <&1> уровня &3: Нет открытой записи."
     1967                               , p-rec-name
     1968                               , p-fld-name
     1969                               , p-rec-level
     1970                               )
     1971           ).
     1972       end.
     1973       else do:
     1974           find last buf_temp_xmllib_rec-fld
     1975               where buf_temp_xmllib_rec-fld.rec-key  = buf_temp_xmllib_rec.rec-key
     1976                 and buf_temp_xmllib_rec-fld.fldName  = p-fld-name
     1977                 and buf_temp_xmllib_rec-fld.closed   = no
     1978           use-index nm
     1979           no-error.
     1980           if available buf_temp_xmllib_rec-fld
     1981           then do:
     1982               run xmllib-parse-error in this-procedure (
     1983                   input substitute( "Ошибка 3 открытия поля <&2> в записи <&1>: Поле с этим именем уже открыто на строке &3."
     1984                                   , p-rec-name
     1985                                   , p-fld-name
     1986                                   , buf_temp_xmllib_rec-fld.fldOpenLine
     1987                                   )
     1988               ).
     1989           end.
     1990           else do:
     1991               assign
     1992                   v-xmllib-rec-fld-key    = v-xmllib-rec-fld-key + 1
     1993               .
     1994               create buf_temp_xmllib_rec-fld.
     1995               assign
     1996                   buf_temp_xmllib_rec-fld.fld-key         = v-xmllib-rec-fld-key
     1997                   buf_temp_xmllib_rec-fld.rec-key         = buf_temp_xmllib_rec.rec-key
     1998                   buf_temp_xmllib_rec-fld.fldOpenLine     = v-xmllib-sax-reader-handle :locator-line-number
     1999                   buf_temp_xmllib_rec-fld.fldCloseLine    = 0
     2000                   buf_temp_xmllib_rec-fld.fldName         = p-fld-name
     2001                   buf_temp_xmllib_rec-fld.closed          = no
     2002               .
     2003           end.
     2004       end.
     2005   end.
     2006   end procedure.
     2007   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2008   PROCEDURE verify-ini-entry:
     2009   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
     2010   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
     2011   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
     2012   DEFINE INPUT  PARAMETER silence          as logical no-undo.
     2013   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
     2014   define variable v-mess as character no-undo .
     2015   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
     2016   if ini-entry-value = ? and ini-key-name begins "spl"
     2017   then
     2018   get-key-value section ini-section-name key "splall" value ini-entry-value.
     2019   if ini-entry-value = ? and ini-key-name begins "sav"
     2020   then
     2021   get-key-value section ini-section-name key "savall" value ini-entry-value.
     2022   if ini-entry-value = ? then do:
     2023     assign
     2024     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
     2025                       , chr(10)
     2026                       , ini-section-name
     2027                       , ini-key-name
     2028                       , error-msg-text).
     2029       if not silence then do:
     2030         message
     2031         v-mess
     2032         view-as alert-box ERROR  .
     2033         return error.
     2034       end.
     2035       else do:
     2036         return error v-mess.
     2037       end.
     2038   end.
     2039   END PROCEDURE.
     2040   PROCEDURE verify-file:
     2041   DEFINE INPUT  PARAMETER filename       as character no-undo.
     2042   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
     2043   DEFINE INPUT  PARAMETER silence        as logical no-undo.
     2044   DEFINE OUTPUT PARAMETER found          as logical no-undo.
     2045   file-info:file-name = filename.
     2046   found = NOT (file-info:full-pathname = ?).
     2047   if NOT found  then do:
     2048     if not silence then do:
     2049       message error-msg-text
     2050       view-as alert-box ERROR.
     2051       return error.
     2052     end.
     2053     else return error error-msg-text.
     2054   end.
     2055   END PROCEDURE.
     2056   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2057   define new shared temp-table temp-param-name no-undo
     2058   field profile_id as integer
     2059   field profile-type as character
     2060   field schema-name as character
     2061   field esys-id as integer
     2062   field call_id as character
     2063   field once-more as integer
     2064   field codex_id as integer
     2065   field ruleset_id as integer
     2066   field order_id as integer
     2067   field param-name as character
     2068   field param-type as character
     2069   field pack-process-uniq-key-rec as character
     2070   index pi is primary unique
     2071   esys-id
     2072   schema-name
     2073   profile_id
     2074   call_id
     2075   .
     2076   procedure xmlischn_fill :
     2077   define input  parameter p-codex-id  as integer   no-undo .
     2078   define input  parameter p-ruleset-id as integer   no-undo .
     2079   define buffer buf_rule-call-param  for ub.rule-call-param.
     2080   define buffer buf2_rule-call-param for ub.rule-call-param.
     2081   define buffer buf_temp-param-name for temp-param-name.
     2082   define variable v-esys-id-list as character no-undo .
     2083   define variable v-ii as integer no-undo .
     2084     do
     2085     on error undo, return error return-value
     2086     :
     2087       for each buf_rule-call-param where
     2088               buf_rule-call-param.codex_id = p-codex-id
     2089           and buf_rule-call-param.ruleset_id = p-ruleset-id
     2090       break
     2091       by buf_rule-call-param.call_id
     2092       by buf_rule-call-param.profile_id
     2093       by buf_rule-call-param.once-more
     2094       :
     2095         if first-of(buf_rule-call-param.once-more) then do:
     2096           v-esys-id-list = ''.
     2097           for each buf2_rule-call-param no-lock
     2098              where buf2_rule-call-param.call_id    = buf_rule-call-param.call_id
     2099                and buf2_rule-call-param.codex_id   = buf_rule-call-param.codex_id
     2100                and buf2_rule-call-param.ruleset_id = buf_rule-call-param.ruleset_id
     2101                and buf2_rule-call-param.profile_id = buf_rule-call-param.profile_id
     2102                and buf2_rule-call-param.once-more  = buf_rule-call-param.once-more
     2103                and buf2_rule-call-param.param-2-data-type = 'ext-system':U :
     2104             if buf2_rule-call-param.param-name = "p-esys-id"
     2105                  or
     2106                  (buf2_rule-call-param.param-name = "p-esys-id-list"
     2107                  and
     2108                  buf2_rule-call-param.p-index > 0)
     2109             then do:
     2110               assign
     2111               v-esys-id-list = v-esys-id-list + (if v-esys-id-list = '' then '' else chr(44)) +
     2112                               string( buf2_rule-call-param.param-value-integer)
     2113               .
     2114             end.
     2115           end.
     2116         end.
     2117         if v-esys-id-list = "" then v-esys-id-list = "-1".
     2118         if buf_rule-call-param.param-2-data-type = "xsd" then do:
     2119           find first buf_temp-param-name where
     2120                   buf_temp-param-name.schema-name = buf_rule-call-param.param-value-character
     2121             and buf_temp-param-name.profile_id = buf_rule-call-param.profile_id
     2122             and buf_temp-param-name.call_id = buf_rule-call-param.call_id
     2123             and buf_temp-param-name.once-more = buf_rule-call-param.once-more
     2124             no-error.
     2125           if not available buf_temp-param-name then do:
     2126             do v-ii = 1 to num-entries(v-esys-id-list):
     2127               find first buf_temp-param-name where
     2128                       buf_temp-param-name.schema-name = buf_rule-call-param.param-value-character
     2129                 and buf_temp-param-name.profile_id = buf_rule-call-param.profile_id
     2130                 and buf_temp-param-name.call_id = buf_rule-call-param.call_id
     2131                 and buf_temp-param-name.esys-id = integer(entry(v-ii, v-esys-id-list))
     2132                 no-error.
     2133               if not available buf_temp-param-name then do:
     2134             create buf_temp-param-name.
     2135             assign
     2136             buf_temp-param-name.schema-name = buf_rule-call-param.param-value-character
     2137             buf_temp-param-name.profile_id = buf_rule-call-param.profile_id
     2138             buf_temp-param-name.call_id = buf_rule-call-param.call_id
     2139             buf_temp-param-name.once-more = buf_rule-call-param.once-more
     2140             buf_temp-param-name.esys-id = integer(entry(v-ii, v-esys-id-list))
     2141             buf_temp-param-name.ruleset_id = buf_rule-call-param.ruleset_id
     2142             buf_temp-param-name.codex_id = buf_rule-call-param.codex_id
     2143             buf_temp-param-name.order_id = buf_rule-call-param.order_id
     2144             buf_temp-param-name.param-name = buf_rule-call-param.param-name
     2145               buf_temp-param-name.param-type = "xsd"
     2146               buf_temp-param-name.profile-type = entry (buf_rule-call-param.codex_id, 'dis-card-type,dis-card-type,dis-card-type,dis-card-type,dis-card-type,dis-card-type,,,,,goods,clients,gds-grp,cli-grp,,,,edoc,chk-doc,thref,pdf,rep,ord,fdoc':U)
     2147               buf_temp-param-name.pack-process-uniq-key-rec =
     2148               substitute("&2&1&3&1&4&1&5"
     2149                                                                         , chr(4)
     2150                                                                         , buf_rule-call-param.call_id
     2151                                                                         , buf_rule-call-param.codex_id
     2152                                                                         , buf_rule-call-param.ruleset_id
     2153                                                                         , buf_rule-call-param.order_id)
     2154               .
     2155               end.
     2156             end.
     2157           end.
     2158         end.
     2159         if buf_rule-call-param.param-2-data-type = "sub-type" then do:
     2160           find first buf_temp-param-name where
     2161                   buf_temp-param-name.schema-name = buf_rule-call-param.param-value-character
     2162             and buf_temp-param-name.profile_id = buf_rule-call-param.profile_id
     2163             and buf_temp-param-name.call_id = buf_rule-call-param.call_id
     2164             and buf_temp-param-name.once-more = buf_rule-call-param.once-more
     2165             no-error.
     2166           if not available buf_temp-param-name then do:
     2167             do v-ii = 1 to num-entries(v-esys-id-list):
     2168               find first buf_temp-param-name where
     2169                       buf_temp-param-name.schema-name = buf_rule-call-param.param-value-character
     2170                 and buf_temp-param-name.profile_id = buf_rule-call-param.profile_id
     2171                 and buf_temp-param-name.call_id = buf_rule-call-param.call_id
     2172                 and buf_temp-param-name.esys-id = integer(entry(v-ii, v-esys-id-list))
     2173                 no-error.
     2174               if not available buf_temp-param-name then do:
     2175               create buf_temp-param-name.
     2176               assign
     2177               buf_temp-param-name.schema-name = buf_rule-call-param.param-value-character
     2178               buf_temp-param-name.profile_id = buf_rule-call-param.profile_id
     2179               buf_temp-param-name.call_id = buf_rule-call-param.call_id
     2180               buf_temp-param-name.once-more = buf_rule-call-param.once-more
     2181               buf_temp-param-name.esys-id = integer(entry(v-ii, v-esys-id-list))
     2182               buf_temp-param-name.ruleset_id = buf_rule-call-param.ruleset_id
     2183               buf_temp-param-name.codex_id = buf_rule-call-param.codex_id
     2184               buf_temp-param-name.order_id = buf_rule-call-param.order_id
     2185               buf_temp-param-name.param-name = buf_rule-call-param.param-name
     2186               buf_temp-param-name.param-type = "no-xsd"
     2187             buf_temp-param-name.profile-type = entry (buf_rule-call-param.codex_id, 'dis-card-type,dis-card-type,dis-card-type,dis-card-type,dis-card-type,dis-card-type,,,,,goods,clients,gds-grp,cli-grp,,,,edoc,chk-doc,thref,pdf,rep,ord,fdoc':U)
     2188             buf_temp-param-name.pack-process-uniq-key-rec =
     2189             substitute("&2&1&3&1&4&1&5"
     2190                                                                        , chr(4)
     2191                                                                        , buf_rule-call-param.call_id
     2192                                                                        , buf_rule-call-param.codex_id
     2193                                                                        , buf_rule-call-param.ruleset_id
     2194                                                                        , buf_rule-call-param.order_id)
     2195             .
     2196           end.
     2197         end.
     2198       end.
     2199       end.
     2200       end.
     2201     end.
     2202   end procedure.
     2203   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2204   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2205   define  shared variable g#auto-pid           as integer   no-undo .
     2206   define  shared variable conn-par             as character no-undo .
     2207   define  shared variable g#auto-user-id       as character no-undo .
     2208   define  shared variable g#auto-user-login    as character no-undo .
     2209   define  shared variable g#auto-user-password as character no-undo .
     2210   define  shared variable v-socket             as logical   no-undo .
     2211   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2212   define  shared variable auto-window-h     as handle    no-undo .
     2213   define  shared variable auto-log-msg-h    as handle    no-undo .
     2214   define  shared variable hand-log-msg-h    as handle    no-undo .
     2215   define  shared variable log-file-name     as character no-undo initial ? .
     2216   define  shared variable add-log-file-name as character no-undo initial ? .
     2217   define  shared variable writelogvalue     as character no-undo initial ? .
     2218   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2219   define stream LogStream .
     2220   define variable mNoTime as logical no-undo.
     2221   procedure write-to-log-notime :
     2222     define input param i-str as character no-undo .
     2223     mNoTime = yes.
     2224     run write-to-log (i-str).
     2225     mNoTime = no.
     2226   end.
     2227   procedure write-to-log :
     2228     define input param p-str as character no-undo .
     2229     do
     2230     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2231     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
     2232     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
     2233     :
     2234       define variable log-res        as logical   no-undo .
     2235       define variable v-jj           as integer   no-undo .
     2236       if    mNoTime
     2237          or writelogvalue eq "AsyncProc"
     2238       then
     2239          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
     2240       else
     2241          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
     2242       if auto-log-msg-h <> ? then do:
     2243         log-res = auto-log-msg-h:move-to-eof( ) .
     2244         log-res = auto-log-msg-h:insert-string( p-str ).
     2245       end.
     2246       if hand-log-msg-h <> ? then do:
     2247         log-res = hand-log-msg-h:move-to-eof( ) .
     2248         log-res = hand-log-msg-h:insert-string( p-str ).
     2249       end.
     2250       assign
     2251         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
     2252         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
     2253         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
     2254       .
     2255       if add-log-file-name <> ? then do:
     2256         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
     2257           run gbl/fileapnd.p
     2258             ( input entry(v-jj, add-log-file-name, chr(1) )
     2259             ,input p-str
     2260             ,input 20
     2261             ) no-error .
     2262           if error-status:error then do:
     2263             return error return-value .
     2264           end.
     2265         end.
     2266       end.
     2267       if writelogvalue eq "AsyncProc"
     2268       then do:
     2269          p-str = trim(p-str, (chr(13) + chr(10)) )
     2270       .
     2271          Publish "WriteLogAsunc" (p-str,yes).
     2272       end.
     2273       else if writelogvalue <> "yes" then do:
     2274         run gbl/fileapnd.p
     2275           ( input log-file-name
     2276           ,input p-str
     2277           ,input 20
     2278           ) no-error .
     2279         if error-status:error then do:
     2280           return error return-value .
     2281         end.
     2282       end.
     2283     end.
     2284   end procedure.
     2285   procedure write-to-screen :
     2286     define input param p-str as character no-undo .
     2287     do
     2288     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2289     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
     2290     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
     2291     :
     2292       define variable log-res as logical no-undo.
     2293       assign
     2294         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
     2295       .
     2296       if auto-log-msg-h <> ?
     2297       then do:
     2298         log-res = auto-log-msg-h:move-to-eof( ) .
     2299         log-res = auto-log-msg-h:insert-string( p-str ).
     2300       end.
     2301       if hand-log-msg-h <> ?
     2302       then do:
     2303         log-res = hand-log-msg-h:move-to-eof( ) .
     2304         log-res = hand-log-msg-h:insert-string( p-str ).
     2305       end.
     2306     end.
     2307   end procedure.
     2308   procedure send-msg-to-email :
     2309     define input  parameter p-subject      as character no-undo .
     2310     define input  parameter p-text-err     as character no-undo .
     2311     define input  parameter p-attach-files as character no-undo .
     2312     do
     2313     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2314     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
     2315     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
     2316     :
     2317       define variable v-tth             as handle    no-undo .
     2318       define variable v-value-character as character no-undo .
     2319       define variable v-value-date      as date      no-undo .
     2320       define variable v-value-decimal   as decimal   no-undo .
     2321       define variable v-value-integer   as integer   no-undo .
     2322       define variable v-value-logical   as logical   no-undo .
     2323       define variable v-param-type      as character no-undo .
     2324       define variable v-email       as character no-undo .
     2325       define variable v-tmp-str     as character no-undo .
     2326       define variable v-tmp1-str    as character no-undo .
     2327       define variable v-ind         as integer   no-undo .
     2328       define variable v-num-entries as integer   no-undo .
     2329       delete object v-tth no-error.
     2330       run adm/shattri.p
     2331         ( input "get":U
     2332          ,input  "":U
     2333          ,input  0
     2334          ,input  'auto-task':U
     2335          ,input  'send-msg-to-email':U
     2336          ,output v-value-character
     2337          ,output v-value-date
     2338          ,output v-value-decimal
     2339          ,output v-value-integer
     2340          ,output v-value-logical
     2341          ,output v-param-type
     2342          ,input-output table-handle v-tth
     2343         ) no-error .
     2344       if not error-status :error  then do:
     2345         assign
     2346           v-tmp-str = v-value-character
     2347         .
     2348       end.
     2349       delete object v-tth no-error.
     2350       assign
     2351         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
     2352         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
     2353         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
     2354         v-num-entries = num-entries( v-tmp-str, chr(44) )
     2355         v-email       = "":U
     2356       .
     2357       do v-ind = 1 to v-num-entries
     2358       :
     2359         assign
     2360           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
     2361         .
     2362         if trim( v-tmp1-str ) <> "":U then do:
     2363           if v-email = "":U then do:
     2364             assign
     2365               v-email = v-tmp1-str
     2366             .
     2367           end.
     2368           else do:
     2369             assign
     2370               v-email = v-email + chr(44) + v-tmp1-str
     2371             .
     2372           end.
     2373         end.
     2374       end.
     2375       if v-email <> "":U then do:
     2376         run gbl/sendmail.p
     2377           ( input v-email
     2378           , input p-subject
     2379           , input p-text-err
     2380           , input p-attach-files
     2381           ) no-error .
     2382         if error-status :error
     2383           or return-value <> "":U
     2384         then do:
     2385           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
     2386         end.
     2387       end.
     2388     end.
     2389   end procedure.
     2390   define  shared variable oxml-exch-dir as character no-undo .
     2391   define  shared variable oxml-heap-dir as character no-undo .
     2392   define variable err-mess as character no-undo .
     2393   define temp-table t-pck-conf no-undo
     2394     field esys-id         as integer
     2395     field db-num          as integer
     2396     field current-db-num  as integer
     2397     field pack-num        as integer
     2398     field rcvd-recs       as integer
     2399     field total-recs      as integer
     2400     field sys-key         as character
     2401     field src_db-key      as character
     2402     field ver-num         as character
     2403     field prev-crc        as character
     2404     field actual-date     as date
     2405     field actual-time-int as integer
     2406   .
     2407   FUNCTION ora-rcpt_get-rcpt-name returns character ( input p-file-name as character):
     2408   define variable v-file-name as character no-undo .
     2409   assign
     2410   v-file-name = substitute("&1-&2_&3"
     2411                             ,entry(2, entry(1, p-file-name, "_"), "-")
     2412                             ,entry(1, entry(1, p-file-name, "_"), "-")
     2413                             ,entry(2, p-file-name, "_")) no-error.
     2414   if error-status:error then v-file-name = p-file-name.
     2415   return v-file-name.
     2416   END FUNCTION.
     2417   define variable vss-include-info9 as character format "X(65)" no-undo
     2418   initial "@(#)$Workfile$ $Revision$".
     2419   define variable v-filelist-total-file-num           as integer      no-undo .
     2420   define variable v-filelist-total-dir-num            as integer      no-undo .
     2421   define variable v-filelist-main-procedure-handle    as handle       no-undo .
     2422   define variable v-filelist-main-procedure-name      as character    no-undo .
     2423   define temp-table temp-dirlist no-undo
     2424       field dir-full-name     as character
     2425       field dir-short-name    as character
     2426       field need-process      as logical
     2427       index xpk is primary unique dir-full-name
     2428   .
     2429   define temp-table temp-filelist no-undo
     2430     field file-name        as character
     2431     field file-name-no-ext as character
     2432     field file-extension   as character
     2433     field directory-name   as character
     2434     field full-name        as character
     2435     field dir-short-name   as character
     2436     field need-process     as logical
     2437     index xpk is unique primary full-name
     2438     index xie1 directory-name file-name
     2439     index xie2 directory-name file-name-no-ext
     2440     index xie3 file-name
     2441     index xie4 file-name-no-ext
     2442     index xie5 need-process file-name
     2443     .
     2444   define stream dir-list .
     2445   procedure filelist-get-file-num :
     2446     define output parameter p-file-num as integer   no-undo .
     2447     do
     2448     on error undo, return error return-value
     2449     :
     2450       assign
     2451         p-file-num = v-filelist-total-file-num
     2452       .
     2453     end.
     2454   end procedure.
     2455   procedure filelist-clear :
     2456     do
     2457     on error undo, return error return-value
     2458     :
     2459       define buffer buf_filelist for temp-filelist .
     2460       assign
     2461         v-filelist-total-file-num = 0
     2462       .
     2463       for each buf_filelist
     2464       on error undo, return error
     2465       :
     2466         delete buf_filelist .
     2467       end.
     2468     end.
     2469   end procedure.
     2470   procedure filelist-init :
     2471     do
     2472     on error undo, return error
     2473     :
     2474       define input parameter p-dir-name       as character no-undo .
     2475       define input parameter p-filter-ext     as logical   no-undo .
     2476       define input parameter p-ext-list       as character no-undo .
     2477       define input parameter p-dir-short-name as character no-undo .
     2478       define buffer buf_temp-filelist for temp-filelist .
     2479       if p-filter-ext = true
     2480          and p-ext-list = ?
     2481       or (p-filter-ext = false
     2482          and p-ext-list <> ?
     2483          and p-ext-list <> "":U
     2484          )
     2485       then do:
     2486         message
     2487           vss-workfile vss-revision vss-description skip
     2488           "Ошибка задания входных параметров" skip
     2489           "p-filter-ext" p-filter-ext skip
     2490           "p-ext-list"   p-ext-list   skip
     2491           view-as alert-box error .
     2492         undo, return error .
     2493       end.
     2494       for each buf_temp-filelist
     2495         where buf_temp-filelist.directory-name = p-dir-name
     2496       on error undo, return error return-value
     2497       :
     2498         delete buf_temp-filelist .
     2499       end.
     2500       input stream dir-list from os-dir( p-dir-name ).
     2501       define variable v-file                  as character no-undo .
     2502       define variable v-path                  as character no-undo .
     2503       define variable v-mask                  as character no-undo .
     2504       define variable v-extension             as character no-undo .
     2505       define variable v-file-name-without-ext as character no-undo .
     2506       repeat
     2507       on error undo, return error
     2508       :
     2509         import stream dir-list v-file v-path v-mask .
     2510         if  v-mask <> ?
     2511         and v-mask begins 'F':u
     2512         then do:
     2513         end.
     2514         else do:
     2515           next .
     2516         end.
     2517         if num-entries(v-file, '.':u) > 1
     2518         then do:
     2519           assign
     2520             v-extension = entry(num-entries(v-file, '.':u), v-file,  '.':u )
     2521             v-file-name-without-ext = entry(num-entries(v-file, '.':u) - 1, v-file, '.':u )
     2522           .
     2523         end.
     2524         else do:
     2525           assign
     2526             v-extension = ''
     2527             v-file-name-without-ext = v-file
     2528           .
     2529         end.
     2530         if p-filter-ext = true
     2531         then do:
     2532           if lookup(v-extension, p-ext-list) = 0
     2533           then do:
     2534             next .
     2535           end.
     2536         end.
     2537         create buf_temp-filelist .
     2538         assign
     2539           buf_temp-filelist.file-name        = v-file
     2540           buf_temp-filelist.directory-name   = p-dir-name
     2541           buf_temp-filelist.file-name-no-ext = v-file-name-without-ext
     2542           buf_temp-filelist.file-extension   = v-extension
     2543           buf_temp-filelist.full-name        = p-dir-name + '/':u + v-file
     2544           buf_temp-filelist.dir-short-name   = p-dir-short-name
     2545         .
     2546         assign
     2547           v-filelist-total-file-num = v-filelist-total-file-num + 1
     2548         .
     2549         if v-filelist-main-procedure-handle <> ?
     2550         then do:
     2551           run value( v-filelist-main-procedure-name ) in v-filelist-main-procedure-handle
     2552             (input "file":U
     2553             , input v-filelist-total-file-num
     2554             , input buf_temp-filelist.full-name
     2555             , input buf_temp-filelist.file-name
     2556             ) no-error.
     2557           if error-status :error
     2558           then do:
     2559             message
     2560               vss-workfile vss-revision vss-description skip
     2561               "filelist-dirlist-subdir-init" skip(1)
     2562               skip "Ошибка при вызове процедуры вывода"
     2563               skip "результатов сканирования каталогов."
     2564               skip return-value
     2565               skip trim(error-status :get-message(1))
     2566                       trim(error-status :get-message(2))
     2567                       trim(error-status :get-message(3))
     2568               view-as alert-box error.
     2569             undo, return error .
     2570           end.
     2571         end.
     2572       end.
     2573       input stream dir-list close .
     2574       return.
     2575     end.
     2576   end procedure.
     2577   procedure filelist-dirlist-init-by-list :
     2578     do
     2579     on error undo, return error
     2580     :
     2581       define input parameter p-root-dir   as character no-undo .
     2582       define input parameter p-dir-list   as character no-undo .
     2583       define input parameter p-filter-ext as logical   no-undo .
     2584       define input parameter p-ext-list   as character no-undo .
     2585       define variable v-num-appdir as integer   no-undo .
     2586       do v-num-appdir = 1 to num-entries(p-dir-list)
     2587       :
     2588         define variable v-curr-dir  as character no-undo .
     2589         assign
     2590           v-curr-dir = entry(v-num-appdir, p-dir-list)
     2591         .
     2592         run filelist-init in this-procedure
     2593           (input p-root-dir + '/':u + v-curr-dir
     2594           ,input p-filter-ext
     2595           ,input p-ext-list
     2596           ,input v-curr-dir
     2597           ) .
     2598       end.
     2599     end.
     2600   end procedure.
     2601   procedure filelist-dirlist-clear :
     2602     do
     2603     on error undo, return error
     2604     :
     2605       define buffer buf_temp-dirlist for temp-dirlist .
     2606       assign
     2607           v-filelist-total-dir-num = 0
     2608       .
     2609       for each buf_temp-dirlist
     2610       on error undo, return error
     2611       :
     2612         delete buf_temp-dirlist .
     2613       end.
     2614     end.
     2615   end procedure.
     2616   procedure filelist-dirlist-subdir-init :
     2617   define input parameter p-dir-name   as character no-undo .
     2618       define buffer buf_temp-dirlist for temp-dirlist .
     2619   do
     2620   for buf_temp-dirlist
     2621   on error undo, return error
     2622   :
     2623       assign
     2624           file-info :file-name = p-dir-name
     2625       .
     2626       if file-info :full-pathname = ?
     2627       or index( file-info :file-type, "D" ) = 0
     2628       then do:
     2629           message
     2630               vss-workfile vss-revision vss-description skip
     2631               "filelist-dirlist-init: Заданного каталога не существует."
     2632               skip (1)
     2633               skip "Задан каталог:"
     2634               skip substitute( "'&1'", p-dir-name )
     2635           view-as alert-box error .
     2636           undo, return error .
     2637       end.
     2638       input stream dir-list from os-dir( p-dir-name ).
     2639       define variable v-file                  as character no-undo .
     2640       define variable v-path                  as character no-undo .
     2641       define variable v-mask                  as character no-undo .
     2642       file-in-directory:
     2643       repeat
     2644       on error undo, return error
     2645       :
     2646           import stream dir-list
     2647               v-file
     2648               v-path
     2649               v-mask
     2650           .
     2651           if  v-mask = ?
     2652           or index( v-mask, 'D':u ) = 0
     2653           or v-file = ".":U
     2654           or v-file = "..":U
     2655           then do:
     2656               next file-in-directory.
     2657           end.
     2658           else do:
     2659               find first buf_temp-dirlist
     2660                    where buf_temp-dirlist.dir-full-name    = v-path
     2661               no-error.
     2662               if not available buf_temp-dirlist
     2663               then do:
     2664                   create buf_temp-dirlist .
     2665                   assign
     2666                       buf_temp-dirlist.dir-full-name    = v-path
     2667                       buf_temp-dirlist.dir-short-name   = v-file
     2668                       buf_temp-dirlist.need-process     = yes
     2669                   .
     2670               end.
     2671               assign
     2672                   v-filelist-total-dir-num = v-filelist-total-dir-num + 1
     2673               .
     2674               if v-filelist-main-procedure-handle <> ?
     2675               then do:
     2676                   run value( v-filelist-main-procedure-name ) in v-filelist-main-procedure-handle (
     2677                         input "dir":U
     2678                       , input v-filelist-total-dir-num
     2679                       , input buf_temp-dirlist.dir-full-name
     2680                       , input buf_temp-dirlist.dir-short-name
     2681                   ) no-error.
     2682                   if error-status :error
     2683                   then do:
     2684                       message
     2685                           vss-workfile vss-revision vss-description skip
     2686                           "filelist-dirlist-subdir-init"
     2687                           skip(1)
     2688                           skip "Ошибка при вызове процедуры вывода"
     2689                           skip "результатов сканирования каталогов."
     2690                           skip return-value
     2691                           skip trim(error-status :get-message(1))
     2692                                trim(error-status :get-message(2))
     2693                                trim(error-status :get-message(3))
     2694                       view-as alert-box error.
     2695                       undo, return error .
     2696                   end.
     2697               end.
     2698           end.
     2699       end.
     2700       input stream dir-list close .
     2701   end.
     2702   end procedure.
     2703   procedure filelist-dirlist-init :
     2704   define input parameter p-dir-name   as character no-undo .
     2705       define variable v-file  as character no-undo.
     2706       define variable v-path  as character no-undo.
     2707       define variable v-mask  as character no-undo.
     2708       define buffer buf_temp-dirlist for temp-dirlist .
     2709   do
     2710   for buf_temp-dirlist
     2711   on error undo, return error
     2712   :
     2713       assign
     2714           file-info :file-name = p-dir-name
     2715       .
     2716       if file-info :full-pathname = ?
     2717       or index( file-info :file-type, "D" ) = 0
     2718       then do:
     2719           message
     2720               vss-workfile vss-revision vss-description skip
     2721               "filelist-dirlist-init: Заданного каталога не существует."
     2722               skip (1)
     2723               skip "Задан каталог:"
     2724               skip substitute( "'&1'", p-dir-name )
     2725           view-as alert-box error .
     2726           undo, return error .
     2727       end.
     2728       for each buf_temp-dirlist
     2729          where buf_temp-dirlist.dir-full-name begins file-info :full-pathname
     2730       on error undo, return error return-value
     2731       :
     2732           delete buf_temp-dirlist .
     2733       end.
     2734       create buf_temp-dirlist .
     2735       assign
     2736           buf_temp-dirlist.dir-full-name    = file-info :full-pathname
     2737           buf_temp-dirlist.dir-short-name   = file-info :file-name
     2738           buf_temp-dirlist.need-process     = yes
     2739       .
     2740       do
     2741       while available buf_temp-dirlist
     2742       on error undo, return error
     2743       :
     2744           run filelist-dirlist-subdir-init in this-procedure (
     2745               input buf_temp-dirlist.dir-full-name
     2746           ).
     2747           assign
     2748               buf_temp-dirlist.need-process = no
     2749           .
     2750           find first buf_temp-dirlist
     2751                where buf_temp-dirlist.need-process = yes
     2752           no-error.
     2753       end.
     2754   end.
     2755   end procedure.
     2756   procedure filelist-set-procedure-handle :
     2757   define input parameter p-proc-handle    as handle           no-undo.
     2758   define input parameter p-proc-name      as character        no-undo.
     2759       define variable v-signature    as character    no-undo.
     2760   do
     2761   on error undo, return error
     2762   :
     2763       if p-proc-handle = ?
     2764       or not valid-handle( p-proc-handle )
     2765       or p-proc-handle :get-signature( p-proc-name ) = ""
     2766       then do:
     2767           assign
     2768               v-filelist-main-procedure-handle = ?
     2769               v-filelist-main-procedure-name   = ""
     2770           .
     2771           undo, return error "filelist-set-procedure-handle: Ошибка передачи handle основной процедуры или имени процедуры обработки результатов сканирования каталогов.".
     2772       end.
     2773       else do:
     2774           assign
     2775               v-signature = p-proc-handle :get-signature( p-proc-name )
     2776           .
     2777           if entry(   1, v-signature )    = "PROCEDURE":U
     2778           and entry( 1, entry(  3, v-signature ), " ":U ) = "INPUT":U
     2779           and entry( 3, entry(  3, v-signature ), " ":U ) = "CHARACTER":U
     2780           and entry( 1, entry(  4, v-signature ), " ":U ) = "INPUT":U
     2781           and entry( 3, entry(  4, v-signature ), " ":U ) = "INTEGER":U
     2782           and entry( 1, entry(  5, v-signature ), " ":U ) = "INPUT":U
     2783           and entry( 3, entry(  5, v-signature ), " ":U ) = "CHARACTER":U
     2784           and entry( 1, entry(  6, v-signature ), " ":U ) = "INPUT":U
     2785           and entry( 3, entry(  6, v-signature ), " ":U ) = "CHARACTER":U
     2786           then do:
     2787               assign
     2788                   v-filelist-main-procedure-handle = p-proc-handle
     2789                   v-filelist-main-procedure-name   = p-proc-name
     2790               .
     2791           end.
     2792           else do:
     2793               assign
     2794                   v-filelist-main-procedure-handle = ?
     2795                   v-filelist-main-procedure-name   = ""
     2796               .
     2797               undo, return error "filelist-set-procedure-handle: Ошибка задания параметров процедуры обработки результатов сканирования каталогов.".
     2798           end.
     2799       end.
     2800   end.
     2801   end procedure.
     2802   procedure filelist-clear-procedure-handle :
     2803   do
     2804   on error undo, return error
     2805   :
     2806       assign
     2807           v-filelist-main-procedure-handle = ?
     2808           v-filelist-main-procedure-name   = ?
     2809       .
     2810   end.
     2811   end procedure.
     2812   procedure filelist-build-by-dirlist :
     2813       define buffer buf_temp-dirlist      for temp-dirlist.
     2814   do
     2815   for buf_temp-dirlist
     2816   on error undo, return error
     2817   :
     2818       for each buf_temp-dirlist
     2819       on error undo, return error
     2820       :
     2821           run filelist-init in this-procedure (
     2822                 input buf_temp-dirlist.dir-full-name
     2823               , input no
     2824               , input "":U
     2825               , input buf_temp-dirlist.dir-short-name
     2826           ).
     2827       end.
     2828   end.
     2829   end procedure.
     2830   procedure filelist-check-dir-exists :
     2831   define input parameter p-dir-name   as character        no-undo.
     2832   define output parameter p-exists    as logical          no-undo.
     2833   do
     2834   on error undo, return error
     2835   :
     2836       assign
     2837           file-info :file-name = p-dir-name
     2838       .
     2839       if file-info :file-type <> ?
     2840       and substring( file-info :file-type, 1, 1 ) = "D":U
     2841       then do:
     2842           assign
     2843               p-exists = yes
     2844           .
     2845       end.
     2846       else do:
     2847           assign
     2848               p-exists = no
     2849           .
     2850       end.
     2851   end.
     2852   end procedure.
