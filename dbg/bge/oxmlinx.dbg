     3197     // ext-system-attr-value для проверки сертификатов
     3198   function checkCertSubject returns logical private (input p-cert-subject as character,
     3199                                                      input p-1cou-subject as character) :
     3200   // p-cert-subject приходит как "CN=ERP, OU=00000", p-1cou-subject содержит только сам код - "00000"
     3201   // lookup не ищет без пробела "OU=00000" в "CN=ERP, OU=00000"
     3202   return index(
     3203                  p-cert-subject,
     3204                  substitute("OU=&1", p-1cou-subject)
     3205               ) > 0 .
     3206   end function .
     3207   define variable v-num-params        as integer      no-undo.
     3208   define variable v-cur-db-num        as integer      no-undo.
     3209   define variable v-cr-db-num         as integer      no-undo.
     3210   define variable v-pack-num          as integer      no-undo.
     3211   define variable v-esys-id           as integer      no-undo.
     3212   define variable v-esys-db-num       as integer      no-undo init 0.
     3213   define variable v-action            as character    no-undo.
     3214   define variable v-xml-file-name     as character    no-undo.
     3215   define variable v-log-file-name     as character    no-undo.
     3216   define variable v-list-file-name    as character    no-undo.
     3217   define variable v-source-dir        as character no-undo .
     3218   define variable v-target-dir        as character no-undo .
     3219   define variable v-temp-dir          as character no-undo .
     3220   define variable v-file-hash         as character no-undo .
     3221   define variable v-today             as date         no-undo.
     3222   define variable v-time              as integer      no-undo.
     3223   define variable v-parameter-list    as character    no-undo.
     3224   define variable v-file-name         as character    no-undo.
     3225   DEFINE VARIABLE v-full-path         as character    no-undo.
     3226   DEFINE VARIABLE v-file-name-no-ext  as character    no-undo.
     3227   DEFINE VARIABLE v-file-name-ext     as character    no-undo.
     3228   define variable v-path              as character    no-undo.
     3229   define variable v-success           as logical      no-undo.
     3230   define variable v-espr-pack-num     as integer      no-undo.
     3231   define variable v-espr-pack-name    as character    no-undo.
     3232   define variable v-rcvd-pack         as logical      no-undo.
     3233   define variable v-custom-pack-name  as character no-undo .
     3234   define variable v-custom-pack-flag  as logical   no-undo .
     3235   define variable v-msg-templ-start   as character no-undo .
     3236   define variable v-msg-templ-finish  as character no-undo .
     3237   define variable v-return-message    as character no-undo .
     3238   define variable v-take-count        as integer no-undo .
     3239   define variable v-analys-count      as integer no-undo .
     3240   define variable v-analys-ack        as integer no-undo .
     3241   define variable v-err-msg as character no-undo .
     3242   define variable v-ver-num as character no-undo .
     3243   define variable add-log-file-name0 as character no-undo .
     3244   define variable m-add-log-file-name as character no-undo .
     3245   define variable v-err-type as character no-undo .
     3246   define variable v-cmd-proc-handle as handle no-undo .
     3247   define variable v-cmd-code as integer no-undo .
     3248   define variable v-exch-file-date as character no-undo .
     3249   define variable v-return-error as integer no-undo .
     3250   define variable v-extsys-list as character no-undo .
     3251   define variable v-ack-snum_pack as character no-undo .
     3252   define variable v-1c-stat as integer no-undo .
     3253   define variable v-ack-err as character no-undo .
     3254   define variable v-sender-id as character no-undo .
     3255   define variable v-type as character no-undo .
     3256   define variable v-cert-enabled as logical no-undo . // true - проверить цифровую подпись
     3257   define variable v-cert-enstr   as character no-undo . // чтение v-cert-enabled строкой
     3258   define variable v-pack-data    as memptr no-undo .
     3259   define variable v-sign-data    as memptr no-undo .
     3260   define variable v-pkcs         as class ibs.th.gbl.pkcs no-undo .
     3261   define variable v-sign-file    as character no-undo . // имя файла с электронной подписью
     3262   define variable v-sign-fileext as character no-undo . // расширение файла с электронной подписью
     3263   define variable v-cert-issuer-name as character no-undo .
     3264   define variable v-cert-subj-name   as character no-undo .
     3265   define variable v-cert-repository  as integer no-undo .
     3266   define variable v-position     as integer no-undo . // позиция точки в имени файла
     3267   define variable v-attr-type    as character no-undo . // для чтения значений из ext-system-attr
     3268   define variable v-cert-subject as character no-undo . // владелец сертификата из входящего пакета
     3269   define variable v-1c-subj      as character initial "00000" no-undo . // так мы решили называть 1с
     3270   def var i as int.
     3271   define buffer buf_ext-system         for ub.ext-system.
     3272   define buffer buf_esys-pck-keys      for ub.esys-pck-keys.
     3273   define buffer next_filelist          for temp-filelist .
     3274   define temp-table tt-espcknum no-undo
     3275     field tt-espr-pack-num  as integer
     3276     field tt-espr-pack-name as character
     3277     field tt-espr-pack-date as datetime
     3278     index inum tt-espr-pack-num ascending
     3279     index idate tt-espr-pack-date     ascending
     3280   .
     3281   do
     3282   for buf_ext-system
     3283   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3284   :
     3285     run write-log in p-log-handle ( 1, "Загрузка данных из внешних систем..." ).
     3286     do : // чтение параметров
     3287       v-num-params = num-entries(p-parameter-string) .
     3288       assign
     3289         v-action      =          entry( 1, p-parameter-string )
     3290         v-cur-db-num  = integer( entry( 2, p-parameter-string ) )
     3291       .
     3292       if v-num-params > 2 then do:
     3293         assign
     3294         v-extsys-list =          entry( 3, p-parameter-string )
     3295         v-esys-db-num = integer( entry( 4, p-parameter-string ) )
     3296         .
     3297         if v-extsys-list = '' then v-extsys-list = '0'.
     3298       end.
     3299       if v-num-params > 4 then do:
     3300         assign
     3301         v-pack-num  = integer( entry( 4, p-parameter-string ) )
     3302         v-cr-db-num = integer( entry( 5, p-parameter-string ) )
     3303         .
     3304       end.
     3305       else v-pack-num = -1.
     3306       run get-version-num in parparentproc ( output v-ver-num ).
     3307     end . // end_of чтение параметров
     3308     case v-action:
     3309       when "take":U then do:
     3310         v-msg-templ-start  = "Прием пакетов данных из ВС &1 '&2'" .
     3311         v-msg-templ-finish = "Завершен прием пакетов данных из ВС '&1'" .
     3312       end.
     3313       when "analys":U then do:
     3314         v-msg-templ-start  = "Разбор данных из ВС &1 '&2'" .
     3315         v-msg-templ-finish = "Завершен разбор данных из ВС '&1'" .
     3316       end.
     3317       when "take+analys":U then do:
     3318         v-msg-templ-start  = "Прием и разбор пакетов данных из ВС &1 '&2'" .
     3319         v-msg-templ-finish = "Завершен прием и разбор пакетов данных из ВС '&1'" .
     3320       end.
     3321       otherwise do:
     3322         v-return-message = substitute( "Не предусмотрена операция &1", v-action ) .
     3323         return error v-return-message.
     3324       end.
     3325     end case.
     3326     run db-attr-value in this-procedure
     3327                  (input  ibs.th.gbl.gbl-var:g#db-num
     3328                  ,input 'int-point':U
     3329                  ,output v-sender-id
     3330                  ,output v-type
     3331     ) no-error .
     3332       run xmlischn_fill in this-procedure ( input 4, input 2).
     3333       run xmlischn_fill in this-procedure ( input 4, input 3).
     3334       run xmlischn_fill in this-procedure ( input 11, input 4).
     3335       run xmlischn_fill in this-procedure ( input 12, input 5).
     3336       run xmlischn_fill in this-procedure ( input 13, input 4).
     3337       run xmlischn_fill in this-procedure ( input 18, input 4).
     3338       run xmlischn_fill in this-procedure ( input 18, input 8).
     3339       run xmlischn_fill in this-procedure ( input 18, input 12).
     3340       run xmlischn_fill in this-procedure ( input 18, input 16).
     3341       run xmlischn_fill in this-procedure ( input 18, input 20).
     3342       run xmlischn_fill in this-procedure ( input 18, input 24).
     3343       run xmlischn_fill in this-procedure ( input 20, input 4).
     3344       _ext-system:
     3345       do i = 1 to num-entries(v-extsys-list)
     3346       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
     3347         v-esys-id = int(entry(i,v-extsys-list,';')).
     3348         for each buf_ext-system no-lock
     3349           where buf_ext-system.esys-have-import = yes
     3350             and buf_ext-system.esys-db-num-imp = v-cur-db-num
     3351             and (v-esys-id = 0
     3352                   or
     3353                   (buf_ext-system.esys-id = v-esys-id
     3354                   and
     3355                   buf_ext-system.db-num = v-esys-db-num)
     3356                 )
     3357         on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3358         :
     3359           assign
     3360           add-log-file-name  = substring( log-file-name, 1, r-index( log-file-name, '.':u) - 1 ) + substitute( "-&1.LOG", buf_ext-system.esys-id )
     3361           g#esys-source-esys = buf_ext-system.esys-id
     3362           m-add-log-file-name = add-log-file-name
     3363           .
     3364             if buf_ext-system.delivery-method = integer('11':U)
     3365             then do :
     3366                 if (v-sender-id = ? or trim(v-sender-id) = "")
     3367                 then do :
     3368                     run write-log in p-log-handle (
     3369                           input 2
     3370                         , input 'Нет атрибута БД "Номер точки интеграции". Без него работа с системой 1С-ERP не возможна!'
     3371                     ).
     3372                     undo _ext-system, next _ext-system.
     3373                 end.
     3374             end.
     3375           do:
     3376             run ext-system-attr-value in this-procedure (
     3377                                         input  buf_ext-system.esys-id
     3378                                        ,input  buf_ext-system.db-num
     3379                                        ,input  'cert-sign':U
     3380                                        ,output v-cert-enstr
     3381                                        ,output v-attr-type) no-error .
     3382             if not error-status:error then v-cert-enabled = logical (v-cert-enstr) no-error .
     3383             if error-status:error then do :
     3384               run write-log in p-log-handle (
     3385                                                     input 2
     3386                                                   , substitute("&1 Ошибка при чтении параметров ВС.&2&3&2&4&2&5"
     3387                                                                 ,vss-workfile
     3388                                                                 ,chr(10)
     3389                                                               ,substitute( "Параметр &1", 'cert-sign':U )
     3390                                                               ,substitute( "&1", error-status:get-message(error-status:num-messages) )
     3391                                                               ,substitute( "&1", return-value )
     3392                                                               )
     3393                                     ) .
     3394               undo _ext-system, next _ext-system.
     3395             end .
     3396             if v-cert-enabled then do :
     3397               run ext-system-attr-value in this-procedure (
     3398                                         input  buf_ext-system.esys-id
     3399                                        ,input  buf_ext-system.db-num
     3400                                        ,input  'cert-file-ext':U
     3401                                        ,output v-sign-fileext
     3402                                        ,output v-attr-type) no-error .
     3403               if not error-status:error then
     3404               run ext-system-attr-value in this-procedure (
     3405                                         input  buf_ext-system.esys-id
     3406                                        ,input  buf_ext-system.db-num
     3407                                        ,input  'cert-sign-issuer':U
     3408                                        ,output v-cert-issuer-name
     3409                                        ,output v-attr-type) no-error .
     3410               if not error-status:error then
     3411               run ext-system-attr-value in this-procedure (
     3412                                         input  buf_ext-system.esys-id
     3413                                        ,input  buf_ext-system.db-num
     3414                                        ,input  'cert-sign-subject':U
     3415                                        ,output v-cert-subj-name
     3416                                        ,output v-attr-type) no-error .
     3417               if error-status:error then do:
     3418                 run write-log in p-log-handle (
     3419                                                     input 2
     3420                                         , substitute("&1 Ошибка чтения настроек ВС.&2&3&2&4"
     3421                                                     ,vss-workfile
     3422                                                     ,chr(10)
     3423                                                     ,error-status:get-message(error-status:num-messages)
     3424                                                     ,return-value
     3425                                                     )
     3426                                     ) .
     3427                 undo _ext-system, next _ext-system.
     3428               end.
     3429               v-cert-repository = ? .
     3430               run ext-system-attr-value in this-procedure (
     3431                                         input  buf_ext-system.esys-id
     3432                                        ,input  buf_ext-system.db-num
     3433                                        ,input  'cert-repository':U
     3434                                        ,output v-cert-enstr
     3435                                        ,output v-attr-type) no-error .
     3436               if v-cert-enstr > ""
     3437               then
     3438                 v-cert-repository = integer(v-cert-enstr) no-error .
     3439               if v-cert-repository = ?
     3440               then
     3441                 v-cert-repository = 0 .
     3442               if v-cert-subj-name > "" then . else do :
     3443                 run write-log in p-log-handle (
     3444                                           input 2
     3445                                         , substitute("&1 Ошибка чтения настроек ВС.&2&3"
     3446                                                     ,vss-workfile
     3447                                                     ,chr(10)
     3448                                                     ,"Отсутствует имя Владельца сертификата (~"Субъект~") в параметрах настройки внешней системы"
     3449                                                     )
     3450                           ) .
     3451                 undo _ext-system, next _ext-system.
     3452               end .
     3453               if v-cert-issuer-name > "" then . else do :
     3454                 run write-log in p-log-handle (
     3455                                           input 2
     3456                                         , substitute("&1 Ошибка чтения настроек ВС.&2&3"
     3457                                                     ,vss-workfile
     3458                                                     ,chr(10)
     3459                                                     ,"Отсутствует имя Издателя сертификата в параметрах настройки внешней системы"
     3460                                                     )
     3461                           ) .
     3462                 undo _ext-system, next _ext-system.
     3463               end .
     3464               if not valid-object (v-pkcs) then v-pkcs = new ibs.th.gbl.pkcs().
     3465             end .
     3466             else assign
     3467               v-cert-issuer-name = ""
     3468               v-cert-subj-name   = ""
     3469               v-sign-fileext     = ""
     3470             .
     3471           end . // end_of параметры настройки ЭЦП
     3472             run bge/lockesys.p (
     3473                input buf_ext-system.esys-id
     3474               ,input buf_ext-system.db-num
     3475               ,buffer buf_ext-system
     3476               ,output v-success) no-error.
     3477             if error-status:error or v-success = no
     3478             then do:
     3479                 run write-log in p-log-handle (
     3480                       input 2
     3481                     , input return-value
     3482                 ).
     3483                 undo _ext-system, next _ext-system.
     3484             end.
     3485           run write-log in p-log-handle (  input 2
     3486                  ,substitute(v-msg-templ-start, buf_ext-system.esys-id, buf_ext-system.esys-name ) ) .
     3487           run write-log in p-log-handle (  input 2
     3488                    ,( if v-cert-enabled then substitute("Используются файлы электронной подписи с расширением '.&1'", v-sign-fileext)
     3489                                         else "Файлы электронной подписи не используются." )
     3490                                             ) .
     3491             do:
     3492               assign
     3493                 v-espr-pack-num = -1
     3494                 v-custom-pack-name = ''
     3495               .
     3496               // внутри espcknum.p очищается temp-filelist и вызывается его заполнение через run filelist-init
     3497               run bge/espcknum.p ( input "get":U
     3498                             ,input buf_ext-system.esys-id
     3499                             ,input buf_ext-system.db-num
     3500                             ,input buf_ext-system.delivery-method
     3501                             ,input oxml-exch-dir
     3502                             ,input oxml-heap-dir
     3503                             ,input v-sign-fileext
     3504                             ,input-output v-espr-pack-num    // передаётся в sxg-pack.p
     3505                             ,input-output v-custom-pack-name // снаружи не используется; перед анализом обнуляется
     3506                             ,output v-espr-pack-name // до анализа не используется; в анализе читается повторно
     3507                             ,output v-source-dir // передаётся в sxg-pack.p
     3508                             ,output v-target-dir // передаётся в sxg-pack.p
     3509                             ,output v-temp-dir   // передаётся в sxg-pack.p
     3510                             ,output v-log-file-name // до анализа не используется; в анализе - только для oracle-retail
     3511                             ,output v-list-file-name // не используется
     3512                             ,output v-custom-pack-flag // до анализа не используется; в анализе читается повторно
     3513                           ) no-error.
     3514               if error-status:error then do:
     3515                 run write-log in p-log-handle (
     3516                                                 input 2
     3517                                               , substitute("&1 Ошибка при генерации номера пакета.&2&3&2&4"
     3518                                                             ,vss-workfile
     3519                                                             ,chr(10)
     3520                                                           , error-status:get-message(error-status:num-messages)
     3521                                                           , return-value
     3522                                                           )
     3523                                 ) .
     3524                 undo _ext-system, next _ext-system.
     3525               end.
     3526               assign
     3527                 v-take-count   = 0
     3528                 v-analys-count = 0
     3529                 v-analys-ack   = 0
     3530                 v-rcvd-pack = false
     3531               .
     3532               if lookup( v-action, "take,take+analys":U ) <> 0 then do:
     3533                 run write-log in p-log-handle (input 2 ,  substitute ("Копирование пакетов данных из &1 в &2", v-source-dir, v-target-dir)  ) .
     3534                   v-filelist-total-file-num = 0 .
     3535                   empty temp-table temp-filelist .
     3536                 run bge/sxg-pack.p (
     3537                               input parparentproc
     3538                               ,input this-procedure:handle
     3539                               ,input p-log-handle
     3540                               ,input "get":U
     3541                               ,input true
     3542                               ,input ?
     3543                               ,input v-source-dir // получено из espcknum.p
     3544                               ,input v-target-dir // получено из espcknum.p
     3545                               ,input v-temp-dir   // получено из espcknum.p
     3546                               ,input v-espr-pack-num
     3547                               ,input buf_ext-system.esys-id
     3548                               ,input buf_ext-system.db-num
     3549                               ,input v-cr-db-num
     3550                               ,input buf_ext-system.delivery-method
     3551                               ) no-error.
     3552                 if error-status:error then do:
     3553                   run write-log in p-log-handle ( input 2
     3554                                                   ,input substitute("&1 &2"
     3555                                                             ,vss-workfile
     3556                                                             ,return-value )
     3557                                                 ).
     3558                   undo _ext-system, next _ext-system.
     3559                 end.
     3560               end.
     3561               if buf_ext-system.delivery-method = integer('9':U)
     3562               or buf_ext-system.delivery-method = integer('11':U)
     3563               then do:
     3564                 run get-num-namepack in this-procedure
