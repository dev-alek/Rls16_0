     2445       run bgelib-tag-put in this-procedure ( input 1, input "sysTime"         , input string( buf_trn-doc.sys-time                         ), input 0 ).
     2446       run bgelib-tag-put in this-procedure ( input 1, input "reasonCode"      , input string( buf_trn-doc.reason-code                      ), input 2 ).
     2447       run bgelib-tag-put in this-procedure ( input 1, input "comment"         , input buf_trn-doc.PS                                        , input 0 ).
     2448       run bgelib-tag-close in this-procedure ( input 0, input "doc").
     2449       for each buf_doc-line no-lock
     2450          where buf_doc-line.doc-code = buf_trn-doc.doc-code
     2451       :
     2452           run bgelib-tag-open in this-procedure (3, "line","").
     2453           find first buf_goods no-lock
     2454                where buf_goods.artic      = buf_doc-line.artic
     2455                  and buf_goods.prod-type  = buf_doc-line.prod-type
     2456                  and buf_goods.prod-code  = buf_doc-line.prod-code
     2457           .
     2458           if available buf_goods
     2459           then do:
     2460               assign
     2461                   v-good-code = string( buf_goods.gds-code )
     2462                   v-good-type = string( buf_goods.gds-type )
     2463               .
     2464               run fill_bgelib_goods in this-procedure (
     2465                     input p-parent-handle
     2466                   , input buf_goods.gds-code
     2467               ).
     2468           end.
     2469           else do:
     2470               assign
     2471                   v-good-code = ""
     2472                   v-good-type = ""
     2473               .
     2474           end.
     2475           run bgelib-tag-put in this-procedure ( input 1, input "goodID", input v-good-code, input 0 ).
     2476           run bgelib-tag-put in this-procedure ( input 1, input "type", input v-good-type, input 0 ).
     2477           find first buf_units no-lock
     2478                where buf_units.unit-name  = buf_goods.unit-base
     2479           no-error.
     2480           if available buf_units
     2481           then do:
     2482               run bgelib-tag-put in this-procedure ( input 1, "unitType",   string(buf_units.type),             0 ).
     2483           end.
     2484           else do:
     2485               run bgelib-tag-put in this-procedure ( input 1, "unitType",   "",                             0 ).
     2486           end.
     2487           run bgelib-tag-put in this-procedure ( input 1, "wait",       string( buf_doc-line.wt-brutto ), 0 ).
     2488           run bgelib-tag-put in this-procedure ( input 1, "place",      string( buf_doc-line.num-place ), 0 ).
     2489           run r-sale in this-procedure (
     2490                 input buf_doc-line.doc-code
     2491               , input buf_doc-line.artic
     2492               , input buf_doc-line.prod-type
     2493               , input buf_doc-line.prod-code
     2494               , output v-fact-qnty
     2495               , output v-vat-pc
     2496               , output v-slt-pc
     2497               , output v-sum-base
     2498               , output v-sum-rubl
     2499               , output v-vat-base
     2500               , output v-vat-rubl
     2501               , output v-slt-base
     2502               , output v-slt-rubl
     2503               , output v-road-tax-base
     2504               , output v-road-tax-rubl
     2505               , output v-transport-base
     2506               , output v-transport-rubl
     2507               , output v-other-base
     2508               , output v-other-rubl
     2509               , output v-excise-base
     2510               , output v-excise-rubl
     2511           ).
     2512           assign
     2513               v-fact-qnty      = v-fact-qnty      * p-sign
     2514               v-sum-base       = v-sum-base       * p-sign
     2515               v-sum-rubl       = v-sum-rubl       * p-sign
     2516               v-vat-base       = v-vat-base       * p-sign
     2517               v-vat-rubl       = v-vat-rubl       * p-sign
     2518               v-slt-base       = v-slt-base       * p-sign
     2519               v-slt-rubl       = v-slt-rubl       * p-sign
     2520               v-road-tax-base  = v-road-tax-base  * p-sign
     2521               v-road-tax-rubl  = v-road-tax-rubl  * p-sign
     2522               v-transport-base = v-transport-base * p-sign
     2523               v-transport-rubl = v-transport-rubl * p-sign
     2524               v-other-base     = v-other-base     * p-sign
     2525               v-other-rubl     = v-other-rubl     * p-sign
     2526               v-excise-base    = v-excise-base    * p-sign
     2527               v-excise-rubl    = v-excise-rubl    * p-sign
     2528           .
     2529           run bgelib-tag-put in this-procedure ( input 1, "qnty", string( v-fact-qnty ), 0 ).
     2530           run bgelib-tag-close in this-procedure ( 0, "line").
     2531           run bgelib-tag-open in this-procedure ( input 0, "lineDocSum","").
     2532           run bgelib-tag-put in this-procedure ( input 1, input "docID",      input buf_trn-doc.doc-code , input 0 ).
     2533           run bgelib-tag-put in this-procedure ( input 1, input "goodID", input v-good-code, input 0 ).
     2534           run bgelib-tag-put in this-procedure ( input 1, input "rateVAT",    input string( v-vat-pc ), input 2 ).
     2535           run bgelib-tag-put in this-procedure ( input 1, input "rateSLT",    input string( v-slt-pc ), input 2 ).
     2536           run bgelib-tag-put in this-procedure ( input 1, input "sumb",       input v-sum-base        , input 2 ).
     2537           run bgelib-tag-put in this-procedure ( input 1, input "sumr",       input v-sum-rubl        , input 2 ).
     2538           run bgelib-tag-put in this-procedure ( input 1, input "VATb",       input v-vat-base        , input 2 ).
     2539           run bgelib-tag-put in this-procedure ( input 1, input "VATr",       input v-vat-rubl        , input 2 ).
     2540           run bgelib-tag-put in this-procedure ( input 1, input "SLTb",       input v-slt-base        , input 2 ).
     2541           run bgelib-tag-put in this-procedure ( input 1, input "SLTr",       input v-slt-rubl        , input 2 ).
     2542           run bgelib-tag-put in this-procedure ( input 1, input "roadTaxb",   input v-road-tax-base   , input 2 ).
     2543           run bgelib-tag-put in this-procedure ( input 1, input "roadTaxr",   input v-road-tax-rubl   , input 2 ).
     2544           run bgelib-tag-put in this-procedure ( input 1, input "transportb", input v-transport-base  , input 2 ).
     2545           run bgelib-tag-put in this-procedure ( input 1, input "transportr", input v-transport-rubl  , input 2 ).
     2546           run bgelib-tag-put in this-procedure ( input 1, input "otherb",     input v-other-base      , input 2 ).
     2547           run bgelib-tag-put in this-procedure ( input 1, input "otherr",     input v-other-rubl      , input 2 ).
     2548           run bgelib-tag-put in this-procedure ( input 1, input "exciseb",    input v-excise-base     , input 2 ).
     2549           run bgelib-tag-put in this-procedure ( input 1, input "exciser",    input v-excise-rubl     , input 2 ).
     2550           run bgelib-tag-close in this-procedure ( 0, "lineDocSum" ).
     2551           assign
     2552               v-tot-sale-sum-base       = v-tot-sale-sum-base       + v-sum-base
     2553               v-tot-sale-sum-rubl       = v-tot-sale-sum-rubl       + v-sum-rubl
     2554               v-tot-sale-vat-base       = v-tot-sale-vat-base       + v-vat-base
     2555               v-tot-sale-vat-rubl       = v-tot-sale-vat-rubl       + v-vat-rubl
     2556               v-tot-sale-slt-base       = v-tot-sale-slt-base       + v-slt-base
     2557               v-tot-sale-slt-rubl       = v-tot-sale-slt-rubl       + v-slt-rubl
     2558               v-tot-sale-road-tax-base  = v-tot-sale-road-tax-base  + v-road-tax-base
     2559               v-tot-sale-road-tax-rubl  = v-tot-sale-road-tax-rubl  + v-road-tax-rubl
     2560               v-tot-sale-transport-base = v-tot-sale-transport-base + v-transport-base
     2561               v-tot-sale-transport-rubl = v-tot-sale-transport-rubl + v-transport-rubl
     2562               v-tot-sale-other-base     = v-tot-sale-other-base     + v-other-base
     2563               v-tot-sale-other-rubl     = v-tot-sale-other-rubl     + v-other-rubl
     2564               v-tot-sale-excise-base    = v-tot-sale-excise-base    + v-excise-base
     2565               v-tot-sale-excise-rubl    = v-tot-sale-excise-rubl    + v-excise-rubl
     2566           .
     2567           run r-cost in this-procedure (
     2568                 input buf_doc-line.doc-code
     2569               , input buf_doc-line.artic
     2570               , input buf_doc-line.prod-type
     2571               , input buf_doc-line.prod-code
     2572               , output v-fact-qnty
     2573               , output v-vat-pc
     2574               , output v-slt-pc
     2575               , output v-sum-base
     2576               , output v-sum-rubl
     2577               , output v-vat-base
     2578               , output v-vat-rubl
     2579               , output v-slt-base
     2580               , output v-slt-rubl
     2581               , output v-road-tax-base
     2582               , output v-road-tax-rubl
     2583               , output v-transport-base
     2584               , output v-transport-rubl
     2585               , output v-other-base
     2586               , output v-other-rubl
     2587               , output v-excise-base
     2588               , output v-excise-rubl
     2589           ).
     2590           assign
     2591               v-fact-qnty      = v-fact-qnty      * p-sign
     2592               v-sum-base       = v-sum-base       * p-sign
     2593               v-sum-rubl       = v-sum-rubl       * p-sign
     2594               v-vat-base       = v-vat-base       * p-sign
     2595               v-vat-rubl       = v-vat-rubl       * p-sign
     2596               v-slt-base       = v-slt-base       * p-sign
     2597               v-slt-rubl       = v-slt-rubl       * p-sign
     2598               v-road-tax-base  = v-road-tax-base  * p-sign
     2599               v-road-tax-rubl  = v-road-tax-rubl  * p-sign
     2600               v-transport-base = v-transport-base * p-sign
     2601               v-transport-rubl = v-transport-rubl * p-sign
     2602               v-other-base     = v-other-base     * p-sign
     2603               v-other-rubl     = v-other-rubl     * p-sign
     2604               v-excise-base    = v-excise-base    * p-sign
     2605               v-excise-rubl    = v-excise-rubl    * p-sign
     2606           .
     2607           run bgelib-tag-open in this-procedure ( input 0, input "lineCostSum","").
     2608           run bgelib-tag-put in this-procedure ( input 1, input "docID",      input buf_trn-doc.doc-code , input 0 ).
     2609           run bgelib-tag-put in this-procedure ( input 1, input "goodID", input v-good-code, input 0 ).
     2610           run bgelib-tag-put in this-procedure ( input 1, input "rateVAT",    input string( v-vat-pc ), input 2).
     2611           run bgelib-tag-put in this-procedure ( input 1, input "rateSLT",    input string( v-slt-pc ), input 2).
     2612           run bgelib-tag-put in this-procedure ( input 1, input "sumb",       input v-sum-base        , input 2).
     2613           run bgelib-tag-put in this-procedure ( input 1, input "sumr",       input v-sum-rubl        , input 2).
     2614           run bgelib-tag-put in this-procedure ( input 1, input "VATb",       input v-vat-base        , input 2).
     2615           run bgelib-tag-put in this-procedure ( input 1, input "VATr",       input v-vat-rubl        , input 2).
     2616           run bgelib-tag-put in this-procedure ( input 1, input "SLTb",       input v-slt-base        , input 2).
     2617           run bgelib-tag-put in this-procedure ( input 1, input "SLTr",       input v-slt-rubl        , input 2).
     2618           run bgelib-tag-put in this-procedure ( input 1, input "roadTaxb",   input v-road-tax-base   , input 2).
     2619           run bgelib-tag-put in this-procedure ( input 1, input "roadTaxr",   input v-road-tax-rubl   , input 2).
     2620           run bgelib-tag-put in this-procedure ( input 1, input "transportb", input v-transport-base  , input 2).
     2621           run bgelib-tag-put in this-procedure ( input 1, input "transportr", input v-transport-rubl  , input 2).
     2622           run bgelib-tag-put in this-procedure ( input 1, input "otherb",     input v-other-base      , input 2).
     2623           run bgelib-tag-put in this-procedure ( input 1, input "otherr",     input v-other-rubl      , input 2).
     2624           run bgelib-tag-put in this-procedure ( input 1, input "exciseb",    input v-excise-base     , input 2).
     2625           run bgelib-tag-put in this-procedure ( input 1, input "exciser",    input v-excise-rubl     , input 2).
     2626           run bgelib-tag-close in this-procedure ( input 0, input "lineCostSum" ).
     2627           assign
     2628               v-tot-cost-sum-base       = v-tot-cost-sum-base       + v-sum-base
     2629               v-tot-cost-sum-rubl       = v-tot-cost-sum-rubl       + v-sum-rubl
     2630               v-tot-cost-vat-base       = v-tot-cost-vat-base       + v-vat-base
     2631               v-tot-cost-vat-rubl       = v-tot-cost-vat-rubl       + v-vat-rubl
     2632               v-tot-cost-slt-base       = v-tot-cost-slt-base       + v-slt-base
     2633               v-tot-cost-slt-rubl       = v-tot-cost-slt-rubl       + v-slt-rubl
     2634               v-tot-cost-road-tax-base  = v-tot-cost-road-tax-base  + v-road-tax-base
     2635               v-tot-cost-road-tax-rubl  = v-tot-cost-road-tax-rubl  + v-road-tax-rubl
     2636               v-tot-cost-transport-base = v-tot-cost-transport-base + v-transport-base
     2637               v-tot-cost-transport-rubl = v-tot-cost-transport-rubl + v-transport-rubl
     2638               v-tot-cost-other-base     = v-tot-cost-other-base     + v-other-base
     2639               v-tot-cost-other-rubl     = v-tot-cost-other-rubl     + v-other-rubl
     2640               v-tot-cost-excise-base    = v-tot-cost-excise-base    + v-excise-base
     2641               v-tot-cost-excise-rubl    = v-tot-cost-excise-rubl    + v-excise-rubl
     2642           .
     2643           if p-cst = yes
     2644           or p-parts = yes
     2645           then do:
     2646               run export-parts in this-procedure (
     2647                     input buf_doc-line.doc-code
     2648                   , input ( if available buf_goods then buf_goods.gds-code else 0 )
     2649                   , input buf_doc-line.obj-type
     2650                   , input buf_doc-line.obj-code
     2651                   , input buf_doc-line.prod-type
     2652                   , input buf_doc-line.prod-code
     2653                   , input buf_doc-line.artic
     2654               ).
     2655           end.
     2656       end.
     2657       run bgelib-tag-open in this-procedure (input 0, input "docSum", input "" ).
     2658       run bgelib-tag-put in this-procedure ( input 1, input "docID",      input buf_trn-doc.doc-code , input 0 ).
     2659       run bgelib-tag-put in this-procedure ( input 1, input "sumb",       input v-tot-sale-sum-base       , input 2).
     2660       run bgelib-tag-put in this-procedure ( input 1, input "sumr",       input v-tot-sale-sum-rubl       , input 2).
     2661       run bgelib-tag-put in this-procedure ( input 1, input "VATb",       input v-tot-sale-vat-base       , input 2).
     2662       run bgelib-tag-put in this-procedure ( input 1, input "VATr",       input v-tot-sale-vat-rubl       , input 2).
     2663       run bgelib-tag-put in this-procedure ( input 1, input "SLTb",       input v-tot-sale-slt-base       , input 2).
     2664       run bgelib-tag-put in this-procedure ( input 1, input "SLTr",       input v-tot-sale-slt-rubl       , input 2).
     2665       run bgelib-tag-put in this-procedure ( input 1, input "roadTaxb",   input v-tot-sale-road-tax-base  , input 2).
     2666       run bgelib-tag-put in this-procedure ( input 1, input "roadTaxr",   input v-tot-sale-road-tax-rubl  , input 2).
     2667       run bgelib-tag-put in this-procedure ( input 1, input "transportb", input v-tot-sale-transport-base , input 2).
     2668       run bgelib-tag-put in this-procedure ( input 1, input "transportr", input v-tot-sale-transport-rubl , input 2).
     2669       run bgelib-tag-put in this-procedure ( input 1, input "otherb",     input v-tot-sale-other-base     , input 2).
     2670       run bgelib-tag-put in this-procedure ( input 1, input "otherr",     input v-tot-sale-other-rubl     , input 2).
     2671       run bgelib-tag-put in this-procedure ( input 1, input "exciseb",    input v-tot-sale-excise-base    , input 2).
     2672       run bgelib-tag-put in this-procedure ( input 1, input "exciser",    input v-tot-sale-excise-rubl    , input 2).
     2673       run bgelib-tag-close in this-procedure ( input 0, input "docSum" ).
     2674       run bgelib-tag-open in this-procedure( input 0, input "docCostSum", input "").
     2675       run bgelib-tag-put in this-procedure ( input 1, input "docID",      input buf_trn-doc.doc-code , input 0 ).
     2676       run bgelib-tag-put in this-procedure ( input 1, input "sumb",       input v-tot-cost-sum-base       , input 2).
     2677       run bgelib-tag-put in this-procedure ( input 1, input "sumr",       input v-tot-cost-sum-rubl       , input 2).
     2678       run bgelib-tag-put in this-procedure ( input 1, input "VATb",       input v-tot-cost-vat-base       , input 2).
     2679       run bgelib-tag-put in this-procedure ( input 1, input "VATr",       input v-tot-cost-vat-rubl       , input 2).
     2680       run bgelib-tag-put in this-procedure ( input 1, input "SLTb",       input v-tot-cost-slt-base       , input 2).
     2681       run bgelib-tag-put in this-procedure ( input 1, input "SLTr",       input v-tot-cost-slt-rubl       , input 2).
     2682       run bgelib-tag-put in this-procedure ( input 1, input "roadTaxb",   input v-tot-cost-road-tax-base  , input 2).
     2683       run bgelib-tag-put in this-procedure ( input 1, input "roadTaxr",   input v-tot-cost-road-tax-rubl  , input 2).
     2684       run bgelib-tag-put in this-procedure ( input 1, input "transportb", input v-tot-cost-transport-base , input 2).
     2685       run bgelib-tag-put in this-procedure ( input 1, input "transportr", input v-tot-cost-transport-rubl , input 2).
     2686       run bgelib-tag-put in this-procedure ( input 1, input "otherb",     input v-tot-cost-other-base     , input 2).
     2687       run bgelib-tag-put in this-procedure ( input 1, input "otherr",     input v-tot-cost-other-rubl     , input 2).
     2688       run bgelib-tag-put in this-procedure ( input 1, input "exciseb",    input v-tot-cost-excise-base    , input 2).
     2689       run bgelib-tag-put in this-procedure ( input 1, input "exciser",    input v-tot-cost-excise-rubl    , input 2).
     2690       run bgelib-tag-close in this-procedure ( input 0, input "docCostSum" ).
     2691   end.
     2692   end procedure.
     2693   procedure export-parts :
     2694   do
     2695   on error undo, return error
     2696   :
     2697   define input parameter p-doc-code   as character    no-undo.
     2698   define input parameter p-gds-code   as integer      no-undo.
     2699   define input parameter p-obj-type   as character    no-undo.
     2700   define input parameter p-obj-code   as integer      no-undo.
     2701   define input parameter p-prod-type  as character    no-undo.
     2702   define input parameter p-prod-code  as integer      no-undo.
     2703   define input parameter p-artic      as character    no-undo.
     2704       define variable v-parts-cst-code    as character    no-undo.
     2705       define variable v-fact-qnty      as decimal     no-undo.
     2706       define variable v-sum-rubl       as decimal     no-undo.
     2707       define variable v-vat-rubl       as decimal     no-undo.
     2708       define variable v-slt-rubl       as decimal     no-undo.
     2709       define variable v-road-tax-rubl  as decimal     no-undo.
     2710       define variable v-transport-rubl as decimal     no-undo.
     2711       define variable v-other-rubl     as decimal     no-undo.
     2712       define variable v-excise-rubl    as decimal     no-undo.
     2713       define variable v-sum-base       as decimal     no-undo.
     2714       define variable v-vat-base       as decimal     no-undo.
     2715       define variable v-slt-base       as decimal     no-undo.
     2716       define variable v-road-tax-base  as decimal     no-undo.
     2717       define variable v-transport-base as decimal     no-undo.
     2718       define variable v-other-base     as decimal     no-undo.
     2719       define variable v-excise-base    as decimal     no-undo.
     2720       define variable v-supp-type      as character   no-undo.
     2721       define variable v-supp-code      as integer     no-undo.
     2722       define variable v-in-code        as character   no-undo.
     2723       define variable v-cst-code       as character   no-undo.
     2724       define variable v-parts-host-code      as integer       no-undo.
     2725       define variable v-parts-contract-code  as integer       no-undo.
     2726       define buffer buf_parts                for ub.parts.
     2727       define buffer buf_parts-attr           for ub.parts-attr.
     2728       assign
     2729           v-parts-cst-code = ""
     2730       .
     2731       for each buf_parts no-lock
     2732           where buf_parts.out-code   = p-doc-code
     2733             and buf_parts.obj-type   = p-obj-type
     2734             and buf_parts.obj-code   = p-obj-code
     2735             and buf_parts.prod-type  = p-prod-type
     2736             and buf_parts.prod-code  = p-prod-code
     2737             and buf_parts.artic      = p-artic
     2738       on error undo, return error return-value
     2739       :
     2740           if p-parts = yes
     2741           then do:
     2742   assign
     2743     price-rubl-with-tax-loc = buf_parts.price-rubl
     2744     price-base-with-tax-loc = buf_parts.price-base
     2745   .
     2746   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2747   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2748     (output varinvprb
     2749     )  .
     2750     if buf_parts.out-code = 'free-zone':U     or
     2751        buf_parts.out-code = 'out-zone':U   or
     2752        buf_parts.doc-type = 'акт':U then do:
     2753       assign
     2754         in-vatp-have-vat-slt = yes.
     2755     end.
     2756     else do:
     2757       find first in-vatp_doc-attr no-lock
     2758         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     2759           and in-vatp_doc-attr.attr-code = 'envd':U
     2760         no-error .
     2761       if not available in-vatp_doc-attr then do:
     2762         assign
     2763           in-vatp-have-vat-slt = yes.
     2764       end.
     2765       else do:
     2766            in-vatp-have-vat-slt = no.
     2767       end.
     2768     end.
     2769     assign
     2770      price-cli-with-tax-loc = buf_parts.price-cli
     2771      cli-base-rate          = buf_parts.cli-base-rate.
     2772     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     2773              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     2774     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     2775             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     2776             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     2777             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     2778             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     2779             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     2780             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2781       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2782     assign
     2783       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     2784     assign
     2785       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     2786       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     2787       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     2788       transport-cli-loc  = 0
     2789       other-cli-loc      = 0
     2790     .
     2791   ASSIGN
     2792             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     2793       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     2794   .
     2795               ASSIGN
     2796                   v-fact-qnty           = buf_parts.fact-qnty
     2797                   v-sum-rubl            = price-rubl-with-tax-loc * v-fact-qnty
     2798                   v-vat-rubl            = vat-rubl-loc            * v-fact-qnty
     2799                   v-slt-rubl            = slt-rubl-loc            * v-fact-qnty
     2800                   v-road-tax-rubl       = road-tax-rubl-loc       * v-fact-qnty
     2801                   v-transport-rubl      = transport-rubl-loc      * v-fact-qnty
     2802                   v-other-rubl          = other-rubl-loc          * v-fact-qnty
     2803                   v-excise-rubl         = 0
     2804                   v-sum-base            = price-base-with-tax-loc * v-fact-qnty
     2805                   v-vat-base            = vat-base-loc            * v-fact-qnty
     2806                   v-slt-base            = slt-base-loc            * v-fact-qnty
     2807                   v-road-tax-base       = road-tax-base-loc       * v-fact-qnty
     2808                   v-transport-base      = transport-base-loc      * v-fact-qnty
     2809                   v-other-base          = other-base-loc          * v-fact-qnty
     2810                   v-excise-base         = 0
     2811                   v-parts-host-code     = buf_parts.host-code
     2812                   v-parts-contract-code = buf_parts.contract-code
     2813               .
     2814               if p-gds-code <> 0
     2815               then do:
     2816                   find first buf_parts-attr no-lock
     2817                        where buf_parts-attr.in-code   = buf_parts.in-code
     2818                          and buf_parts-attr.gds-code  = p-gds-code
     2819                          and buf_parts-attr.part-code = buf_parts.part-code
     2820                   no-error .
     2821                   if available buf_parts-attr
     2822                   then do:
     2823                       assign
     2824                           v-supp-type = buf_parts-attr.supp-type
     2825                           v-supp-code = buf_parts-attr.supp-code
     2826                           v-in-code   = buf_parts-attr.income-in-code
     2827                           v-cst-code  = buf_parts-attr.cst-code
     2828                       .
     2829                   end.
     2830                   else do:
     2831                       assign
     2832                           v-supp-type = buf_parts.supp-type
     2833                           v-supp-code = buf_parts.supp-code
     2834                           v-in-code   = buf_parts.in-code
     2835                           v-cst-code  = buf_parts.cst-code
     2836                       .
     2837                   end.
     2838               end.
     2839               else do:
     2840                   assign
     2841                       v-supp-type = buf_parts.supp-type
     2842                       v-supp-code = buf_parts.supp-code
     2843                       v-in-code   = buf_parts.in-code
     2844                       v-cst-code  = buf_parts.cst-code
     2845                   .
     2846               end.
     2847               run bgelib-tag-open in this-procedure ( input 0, input "linePart", input "" ).
     2848               run bgelib-tag-put in this-procedure ( input 1, input "docID"       , input p-doc-code                 , input 0 ).
     2849               run bgelib-tag-put in this-procedure ( input 1, input "goodID"      , input ( if p-gds-code = 0 then "" else string( p-gds-code ) ), input 0 ).
     2850               run bgelib-tag-put in this-procedure ( input 1, input "inputDocID"  , input string( v-in-code          ), input 2 ).
     2851               run bgelib-tag-put in this-procedure ( input 1, input "qnty"        , input string( v-fact-qnty        ), input 2 ).
     2852               run bgelib-tag-put in this-procedure ( input 1, input "cst"         , input string( v-cst-code         ), input 2 ).
     2853               run bgelib-tag-put in this-procedure ( input 1, input "supp"        , input string( v-supp-type + string( v-supp-code ) ), input 2 ).
     2854               run bgelib-tag-put in this-procedure ( input 1, input "hostCode"    , input string( v-parts-host-code       ), input 2 ).
     2855               run bgelib-tag-put in this-procedure ( input 1, input "contractCode", input string( v-parts-contract-code   ), input 2 ).
     2856               run bgelib-tag-put in this-procedure ( input 1, input "sumr"        , input string( v-sum-rubl         ), input 2 ).
     2857               run bgelib-tag-put in this-procedure ( input 1, input "VATr"        , input string( v-vat-rubl         ), input 2 ).
     2858               run bgelib-tag-put in this-procedure ( input 1, input "SLTr"        , input string( v-slt-rubl         ), input 2 ).
     2859               run bgelib-tag-put in this-procedure ( input 1, input "roadTaxr"    , input string( v-road-tax-rubl    ), input 2 ).
     2860               run bgelib-tag-put in this-procedure ( input 1, input "transportr"  , input string( v-transport-rubl   ), input 2 ).
     2861               run bgelib-tag-put in this-procedure ( input 1, input "otherr"      , input string( v-other-rubl       ), input 2 ).
     2862               run bgelib-tag-put in this-procedure ( input 1, input "exciser"     , input string( v-excise-rubl      ), input 2 ).
     2863               run bgelib-tag-put in this-procedure ( input 1, input "sumb"        , input string( v-sum-base         ), input 2 ).
     2864               run bgelib-tag-put in this-procedure ( input 1, input "VATb"        , input string( v-vat-base         ), input 2 ).
     2865               run bgelib-tag-put in this-procedure ( input 1, input "SLTb"        , input string( v-slt-base         ), input 2 ).
     2866               run bgelib-tag-put in this-procedure ( input 1, input "roadTaxb"    , input string( v-road-tax-base    ), input 2 ).
     2867               run bgelib-tag-put in this-procedure ( input 1, input "transportb"  , input string( v-transport-base   ), input 2 ).
     2868               run bgelib-tag-put in this-procedure ( input 1, input "otherb"      , input string( v-other-base       ), input 2 ).
     2869               run bgelib-tag-put in this-procedure ( input 1, input "exciseb"     , input string( v-excise-base      ), input 2 ).
     2870               run bgelib-tag-close in this-procedure ( input 0, input "linePart" ).
     2871           end.
     2872           if p-cst = yes
     2873           then do:
     2874               assign
     2875                   v-parts-cst-code = v-parts-cst-code
     2876                                       + ( if ( v-cst-code <> ?
     2877                                           and trim( v-cst-code )   <> ""
     2878                                           and trim( v-parts-cst-code ) <> "" )
     2879                                           then "; "
     2880                                           else ""  )
     2881                                       + v-cst-code
     2882               .
     2883           end.
     2884       end.
     2885       if p-cst = yes
     2886       and v-parts-cst-code <> ""
     2887       then do:
     2888           run bgelib-tag-open in this-procedure ( input 0, input "lineCST", input "" ).
     2889           run bgelib-tag-put in this-procedure ( input 1, input "docID"  , input p-doc-code       , input 0 ).
     2890           run bgelib-tag-put in this-procedure ( input 1, input "goodID" , input ( if p-gds-code = 0 then "" else string( p-gds-code ) ), input 0 ).
     2891           run bgelib-tag-put in this-procedure ( input 1, input "CST"      , input v-parts-cst-code , input 0 ).
     2892           run bgelib-tag-close in this-procedure ( input 0, input "lineCST" ).
     2893       end.
     2894   end.
     2895   end procedure.
     2896   procedure fill_bgelib_goods :
     2897   define input parameter p-parent-handle  as handle           no-undo.
     2898   define input parameter p-gds-code       as integer          no-undo.
     2899   do
     2900   on error undo, return error
     2901   :
     2902       if p-parent-handle :get-signature( "cb-fill_bgelib_goods" ) <> "":U
     2903       then do:
     2904           run cb-fill_bgelib_goods in p-parent-handle (
     2905               input p-gds-code
     2906           ).
     2907       end.
     2908   end.
     2909   end procedure.
