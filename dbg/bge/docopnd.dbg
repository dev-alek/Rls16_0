     1776     else do:
     1777       assign
     1778               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-base-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1779               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-rubl-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1780        .
     1781     end.
     1782   end.
     1783   assign
     1784   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     1785   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     1786               ASSIGN
     1787                   p-fact-qnty           = p-fact-qnty     + v-gds-dtl-fact-qnty
     1788                   p-sum-base            = p-sum-base      + price-base-with-tax-sale  * v-gds-dtl-fact-qnty
     1789                   p-sum-rubl            = p-sum-rubl      + price-rubl-with-tax-sale  * v-gds-dtl-fact-qnty
     1790                   p-vat-base            = p-vat-base      + vat-base-sale             * v-gds-dtl-fact-qnty
     1791                   p-vat-rubl            = p-vat-rubl      + vat-rubl-sale             * v-gds-dtl-fact-qnty
     1792                   p-slt-base            = p-slt-base      + slt-base-sale             * v-gds-dtl-fact-qnty
     1793                   p-slt-rubl            = p-slt-rubl      + slt-rubl-sale             * v-gds-dtl-fact-qnty
     1794                   p-road-tax-base       = p-road-tax-base + road-tax-base-sale        * v-gds-dtl-fact-qnty
     1795                   p-road-tax-rubl       = p-road-tax-rubl + road-tax-rubl-sale        * v-gds-dtl-fact-qnty
     1796                   p-excise-base         = p-excise-base   + excise-base-sale          * v-gds-dtl-fact-qnty
     1797                   p-excise-rubl         = p-excise-rubl   + excise-rubl-sale          * v-gds-dtl-fact-qnty
     1798                   p-other-base          = p-other-base    + discnt-base-sale          * v-gds-dtl-fact-qnty
     1799                   p-other-rubl          = p-other-rubl    + discnt-rubl-sale          * v-gds-dtl-fact-qnty
     1800               .
     1801           end.
     1802       end.
     1803       assign
     1804           p-transport-base      = 0
     1805           p-transport-rubl      = 0
     1806           p-vat-pc              = buf_doc-line.vat-pc
     1807           p-slt-pc              = buf_doc-line.slt-pc
     1808       .
     1809     end.
     1810     if p-fact-qnty      = ?
     1811     or p-vat-pc         = ?
     1812     or p-slt-pc         = ?
     1813     or p-sum-base       = ?
     1814     or p-sum-rubl       = ?
     1815     or p-vat-base       = ?
     1816     or p-vat-rubl       = ?
     1817     or p-slt-base       = ?
     1818     or p-slt-rubl       = ?
     1819     or p-road-tax-base  = ?
     1820     or p-road-tax-rubl  = ?
     1821     or p-transport-base = ?
     1822     or p-transport-rubl = ?
     1823     or p-other-base     = ?
     1824     or p-other-rubl     = ?
     1825     or p-excise-base    = ?
     1826     or p-excise-rubl    = ?
     1827     then do:
     1828       message
     1829         vss-workfile vss-revision vss-description skip
     1830         vss-include-info4 skip
     1831         "Получены неопределенные значения" skip
     1832         "Документ" p-doc-code skip
     1833         "Артикул" p-artic p-prod-type p-prod-code skip
     1834         "fact-qnty     " p-fact-qnty      skip
     1835         "vat-pc        " p-vat-pc         skip
     1836         "slt-pc        " p-slt-pc         skip
     1837         "sum-base      " p-sum-base       skip
     1838         "sum-rubl      " p-sum-rubl       skip
     1839         "vat-base      " p-vat-base       skip
     1840         "vat-rubl      " p-vat-rubl       skip
     1841         "slt-base      " p-slt-base       skip
     1842         "slt-rubl      " p-slt-rubl       skip
     1843         "road-tax-base " p-road-tax-base  skip
     1844         "road-tax-rubl " p-road-tax-rubl  skip
     1845         "transport-base" p-transport-base skip
     1846         "transport-rubl" p-transport-rubl skip
     1847         "other-base    " p-other-base     skip
     1848         "other-rubl    " p-other-rubl     skip
     1849         "excise-base   " p-excise-base    skip
     1850         "excise-rubl   " p-excise-rubl    skip
     1851         view-as alert-box error .
     1852       undo, return error .
     1853     end.
     1854   end procedure.
     1855   define variable vss-include-info8 as character format "X(65)" no-undo
     1856   initial "@(#)$Workfile$ $Revision$".
     1857   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1858   procedure r-cost :
     1859     define input  parameter v-doc-code       like ub.doc-line.doc-code          no-undo .
     1860     define input  parameter v-artic          like ub.doc-line.artic             no-undo .
     1861     define input  parameter v-prod-type      like ub.doc-line.prod-type         no-undo .
     1862     define input  parameter v-prod-code      like ub.doc-line.prod-code         no-undo .
     1863     define output parameter v-fact-qnty      like ub.ot-line.fact-qnty       no-undo .
     1864     define output parameter v-vat-pc         like ub.doc-line.vat-pc         no-undo .
     1865     define output parameter v-slt-pc         like ub.doc-line.slt-pc         no-undo .
     1866     define output parameter v-sum-base       like ub.ot-line.sum-base        no-undo .
     1867     define output parameter v-sum-rubl       like ub.ot-line.sum-rubl        no-undo .
     1868     define output parameter v-vat-base       like ub.ot-line.vat-base        no-undo .
     1869     define output parameter v-vat-rubl       like ub.ot-line.vat-rubl        no-undo .
     1870     define output parameter v-slt-base       like ub.ot-line.slt-base        no-undo .
     1871     define output parameter v-slt-rubl       like ub.ot-line.slt-rubl        no-undo .
     1872     define output parameter v-road-tax-base  like ub.ot-line.road-tax-base   no-undo .
     1873     define output parameter v-road-tax-rubl  like ub.ot-line.road-tax-rubl   no-undo .
     1874     define output parameter v-transport-base like ub.ot-line.transport-base  no-undo .
     1875     define output parameter v-transport-rubl like ub.ot-line.transport-rubl  no-undo .
     1876     define output parameter v-other-base     like ub.ot-line.other-base      no-undo .
     1877     define output parameter v-other-rubl     like ub.ot-line.other-rubl      no-undo .
     1878     define output parameter v-excise-base    like ub.ot-line.excise-base     no-undo .
     1879     define output parameter v-excise-rubl    like ub.ot-line.excise-rubl     no-undo .
     1880     do
     1881     on error undo, return error
     1882     :
     1883       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1884       define buffer   in-vatp-parts    for ub.parts   .
     1885       define buffer   in-vatp-doc      for ub.trn-doc .
     1886       define buffer   in-vatp-goods    for ub.goods   .
     1887       define buffer   in-vatp-sysconf  for ub.sysconf .
     1888       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1889       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1890       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1891       define variable varinvprb                  as   character              no-undo.
     1892       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1893       define variable cli-base-rate              as   decimal                no-undo.
     1894       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1895       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1896       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1897       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1898       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1899       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1900       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1901       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1902       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1903       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1904       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1905       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1906       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1907       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1908       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1909       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1910       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1911       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1912       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1913       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1914       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1915       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1916       define variable varinvatp-envd             as   character              no-undo.
     1917       define variable varinvatp-type             as   character              no-undo.
     1918       def var v-parts-fact-qnty as decimal   no-undo .
     1919       define buffer buf_parts    for ub.parts    .
     1920       define buffer buf_goods    for ub.goods    .
     1921       define buffer buf_trn-doc  for ub.trn-doc  .
     1922       define buffer buf_doc-line for ub.doc-line .
     1923       find first buf_doc-line no-lock
     1924         where buf_doc-line.doc-code  = v-doc-code
     1925           and buf_doc-line.artic     = v-artic
     1926           and buf_doc-line.prod-type = v-prod-type
     1927           and buf_doc-line.prod-code = v-prod-code
     1928         no-error .
     1929       if not available buf_doc-line then do:
     1930         message
     1931           vss-workfile vss-revision vss-description skip
     1932           vss-include-info9 skip
     1933           "Ошибка задания входных параметров" skip
     1934           "Не найдена строка документа"  skip
     1935           "Документ" v-doc-code skip
     1936           "Артикул" v-artic v-prod-type v-prod-code skip
     1937           view-as alert-box error .
     1938         return error .
     1939       end.
     1940       find first buf_trn-doc no-lock
     1941         where buf_trn-doc.doc-code = v-doc-code
     1942         no-error .
     1943       if not available buf_trn-doc then do:
     1944         message
     1945           vss-workfile vss-revision vss-description skip
     1946           vss-include-info9 skip
     1947           "Ошибка задания входных параметров" skip
     1948           "Не найден документ" skip
     1949           "Документ" v-doc-code skip
     1950           "Артикул" v-artic v-prod-type v-prod-code skip
     1951           view-as alert-box error .
     1952         undo, return error .
     1953       end.
     1954       find first buf_goods no-lock
     1955         where buf_goods.artic     = buf_doc-line.artic
     1956           and buf_goods.prod-type = buf_doc-line.prod-type
     1957           and buf_goods.prod-code = buf_doc-line.prod-code
     1958         no-error .
     1959       if not available buf_goods then do:
     1960         message
     1961           vss-workfile vss-revision vss-description skip
     1962           vss-include-info9 skip
     1963           "Ошибка задания входных параметров" skip
     1964           "Не найден товар" skip
     1965           "Документ" v-doc-code skip
     1966           "Артикул" v-artic v-prod-type v-prod-code skip
     1967           view-as alert-box error .
     1968         undo, return error .
     1969       end.
     1970       if buf_goods.gds-type = 'т':U then do:
     1971             for each buf_parts no-lock
     1972               where buf_parts.out-code  = buf_trn-doc.doc-code
     1973                 and buf_parts.obj-type  = buf_trn-doc.obj-type
     1974                 and buf_parts.obj-code  = buf_trn-doc.obj-code
     1975                 and buf_parts.artic     = buf_doc-line.artic
     1976                 and buf_parts.prod-type = buf_doc-line.prod-type
     1977                 and buf_parts.prod-code = buf_doc-line.prod-code
     1978             on error undo, return error
     1979             :
     1980   assign
     1981     price-rubl-with-tax-loc = buf_parts.price-rubl
     1982     price-base-with-tax-loc = buf_parts.price-base
     1983   .
     1984   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1985   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1986     (output varinvprb
     1987     )  .
     1988     if buf_parts.out-code = 'free-zone':U     or
     1989        buf_parts.out-code = 'out-zone':U   or
     1990        buf_parts.doc-type = 'акт':U then do:
     1991       assign
     1992         in-vatp-have-vat-slt = yes.
     1993     end.
     1994     else do:
     1995       find first in-vatp_doc-attr no-lock
     1996         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     1997           and in-vatp_doc-attr.attr-code = 'envd':U
     1998         no-error .
     1999       if not available in-vatp_doc-attr then do:
     2000         assign
     2001           in-vatp-have-vat-slt = yes.
     2002       end.
     2003       else do:
     2004            in-vatp-have-vat-slt = no.
     2005       end.
     2006     end.
     2007     assign
     2008      price-cli-with-tax-loc = buf_parts.price-cli
     2009      cli-base-rate          = buf_parts.cli-base-rate.
     2010     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     2011              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     2012     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     2013             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     2014             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     2015             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     2016             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     2017             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     2018             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2019       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2020     assign
     2021       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     2022     assign
     2023       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     2024       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     2025       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     2026       transport-cli-loc  = 0
     2027       other-cli-loc      = 0
     2028     .
     2029   ASSIGN
     2030             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     2031       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     2032   .
     2033               assign
     2034                 v-parts-fact-qnty  = (if buf_trn-doc.doc-type = 'при':U
     2035                                       or buf_trn-doc.doc-type = 'возврат':U
     2036                                       or buf_trn-doc.doc-type = 'инв':U
     2037                                       then buf_parts.fact-qnty
     2038                                       else - buf_parts.fact-qnty
     2039                                      )
     2040               .
     2041               assign
     2042                 v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
     2043                 v-sum-base            = v-sum-base       +  ( price-base-with-tax-loc * v-parts-fact-qnty )
     2044                 v-sum-rubl            = v-sum-rubl       +  ( price-rubl-with-tax-loc * v-parts-fact-qnty )
     2045                 v-vat-base            = v-vat-base       +  ( vat-base-loc            * v-parts-fact-qnty )
     2046                 v-vat-rubl            = v-vat-rubl       +  ( vat-rubl-loc            * v-parts-fact-qnty )
     2047                 v-slt-base            = v-slt-base       +  ( slt-base-loc            * v-parts-fact-qnty )
     2048                 v-slt-rubl            = v-slt-rubl       +  ( slt-rubl-loc            * v-parts-fact-qnty )
     2049                 v-road-tax-base       = v-road-tax-base  +  ( road-tax-base-loc       * v-parts-fact-qnty )
     2050                 v-road-tax-rubl       = v-road-tax-rubl  +  ( road-tax-rubl-loc       * v-parts-fact-qnty )
     2051                 v-excise-base         =   0
     2052                 v-excise-rubl         =   0
     2053                 v-transport-base      = v-transport-base +   (transport-base-loc      * v-parts-fact-qnty )
     2054                 v-transport-rubl      = v-transport-rubl +   (transport-rubl-loc      * v-parts-fact-qnty )
     2055                 v-other-base          = v-other-base     +   (other-base-loc          * v-parts-fact-qnty )
     2056                 v-other-rubl          = v-other-rubl     +   (other-rubl-loc          * v-parts-fact-qnty )
     2057               .
     2058           end.
     2059   assign
     2060     price-rubl-with-tax-loc = buf_doc-line.price-rubl
     2061     price-base-with-tax-loc = buf_doc-line.price-base
     2062   .
     2063   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2064   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2065     (output varinvprb
     2066     )  .
