     1584                                      out-vatp_goods.prod-type = buf_doc-line.prod-type and
     1585                                      out-vatp_goods.prod-code = buf_doc-line.prod-code no-lock.
     1586   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
