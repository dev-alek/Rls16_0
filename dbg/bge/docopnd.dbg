     1545               if buf_trn-doc.doc-type = 'при':U
     1546               or buf_trn-doc.doc-type = 'возврат':U
     1547               then do:
     1548                   assign
     1549                       v-gds-dtl-fact-qnty = buf_gds-dtl.fact-qnty
     1550                   .
     1551               end.
