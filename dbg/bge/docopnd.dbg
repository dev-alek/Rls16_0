     1538           and buf_gds-dtl.artic     = buf_doc-line.artic
     1539           and buf_gds-dtl.prod-type = buf_doc-line.prod-type
     1540           and buf_gds-dtl.prod-code = buf_doc-line.prod-code
     1541       on error undo, return error
     1542       :
     1543           if buf_trn-doc.doc-type <> 'инв':U
