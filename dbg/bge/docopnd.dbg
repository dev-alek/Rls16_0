      586   procedure xmlchar-decode :
      587   define input parameter p-in-string      as character        no-undo.
      588   define output parameter p-out-string    as character        no-undo.
      589       define variable v-position      as integer      no-undo.
      590       define variable v-last-position as integer      no-undo.
      591       define variable v-temp-integer  as integer      no-undo.
      592       define variable v-current-char  as character    no-undo.
      593       define variable v-next-char     as character    no-undo.
      594       define variable v-success       as logical      no-undo.
      595   do
      596   on error undo, return error
      597   :
      598       assign
      599           p-out-string = "":U
      600           v-position   = 0
      601       .
      602       replace-cycle:
      603       do while yes
      604       on error undo, return error
      605       :
      606           assign
      607               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      608           .
      609           if v-last-position <= v-position
      610           then do:
      611               if v-position = 0
      612               then do:
      613                   assign
      614                       p-out-string = p-in-string
      615                   .
      616               end.
      617               else do:
      618                   assign
      619                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      620                   .
      621               end.
      622               leave replace-cycle.
      623           end.
      624           else do:
      625               assign
      626                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      627                   v-position      = v-last-position
      628                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      629               .
      630               if v-current-char = "#":U
      631               then do:
      632                   assign
      633                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      634                   .
      635                   if v-last-position > 0
      636                   then do:
      637                       run xmlchar-read-integer in this-procedure
      638                        (
      639                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      640                           , output v-temp-integer
      641                           , output v-success
      642                       ).
      643                       if v-success = yes
      644                       and v-temp-integer >= 1
      645                       and v-temp-integer <= 255
      646                       then do:
      647                           assign
      648                               p-out-string = p-out-string + chr( v-temp-integer )
      649                               v-position   = v-last-position + 1
      650                           .
      651                       end.
      652                       else do:
      653                           assign
      654                               p-out-string = p-out-string + "&":U
      655                               v-position   = v-position   + 1
      656                           .
      657                       end.
      658                   end.
      659                   else do:
      660                       assign
      661                           p-out-string = p-out-string + "&":U
      662                           v-position   = v-position   + 1
      663                       .
      664                   end.
      665               end.
      666               else do:
      667                   case substring( p-in-string, v-position + 1, 3 )
      668                   :
      669                       when "lt;":U
      670                       then do:
      671                           assign
      672                               p-out-string = p-out-string + "<":U
      673                               v-position   = v-position   + 3
      674                           .
      675                       end.
      676                       when "gt;":U
      677                       then do:
      678                           assign
      679                               p-out-string = p-out-string + ">":U
      680                               v-position   = v-position   + 3
      681                           .
      682                       end.
      683                       otherwise do:
      684                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      685                           then do:
      686                               assign
      687                                   p-out-string = p-out-string + "&":U
      688                                   v-position   = v-position   + 4
      689                               .
      690                           end.
      691                           else do:
      692                               case substring( p-in-string, v-position + 1, 5 )
      693                               :
      694                                   when "quot;":U
      695                                   then do:
      696                                       assign
      697                                           p-out-string = p-out-string + '"':U
      698                                           v-position   = v-position   + 5
      699                                       .
      700                                   end.
      701                                   when "apos;":U
      702                                   then do:
      703                                       assign
      704                                           p-out-string = p-out-string + "'":U
      705                                           v-position   = v-position   + 5
      706                                       .
      707                                   end.
      708                                   otherwise do:
      709                                       assign
      710                                           p-out-string = p-out-string + "&":U
      711                                       .
      712                                   end.
      713                               end case.
      714                           end.
      715                       end.
      716                   end case.
      717               end.
      718           end.
      719       end.
      720   end.
      721   end .
      722   procedure xmlchar-read-integer :
      723   define input parameter p-input-string      as character        no-undo.
      724   define output parameter p-output-integer   as integer          no-undo.
      725   define output parameter p-success       as logical          no-undo.
      726   do
      727   on error undo, return error
      728   :
      729       assign
      730           p-output-integer = integer( p-input-string )
      731       no-error.
      732       if error-status :error
      733       then do:
      734           assign
      735               p-success           = no
      736               p-output-integer    = 0
      737           .
      738       end.
      739       else do:
      740           assign
      741               p-success           = yes
      742           .
      743       end.
      744   end.
      745   end.
      746   define variable v-bgelib-bgeclall           as logical      no-undo.
      747   define variable v-bgelib-bgedict            as logical      no-undo.
      748   define temp-table temp_ext-doc-type no-undo
      749       field edt-key               as integer
      750       field ext-doc-type          as character
      751       field ext-doc-type-label    as character
      752       index pi is primary unique
      753           edt-key
      754   .
      755   define temp-table temp_bgelib_goods no-undo
      756       field gds-code as integer
      757       index pi is primary unique
      758           gds-code
      759   .
      760   define temp-table temp_bgelib_clients no-undo
      761       field obj-type as character
      762       field obj-code as integer
      763       index pi is primary unique
      764           obj-type
      765           obj-code
      766   .
      767   define temp-table temp_bgelib_dis-card no-undo
      768       field d-card as character
      769       index pi is primary unique
      770           d-card
      771   .
      772   define temp-table temp_bgelib_trn-doc no-undo
      773       field doc-code as integer
      774   .
      775   procedure bgelib-tag-open:
      776   do
      777   on error undo, return error
      778   :
      779   define input parameter v-tag-level  as integer      no-undo.
      780   define input parameter v-tag-name   as character    no-undo.
      781   define input parameter v-tag-value  as character    no-undo.
      782       put stream stmXMLOut unformatted
      783           chr(10)
      784           + fill(" ", 4 * v-tag-level)
      785           + "<" + v-tag-name
      786           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
      787           + v-tag-value + ">"
      788       .
      789   end.
      790   end procedure.
      791   procedure bgelib-tag-put:
      792   do
      793   on error undo, return error
      794   :
      795   define input parameter v-tag-level      as integer      no-undo.
      796   define input parameter v-tag-name       as character    no-undo.
      797   define input parameter v-tag-value      as character    no-undo.
      798   define input parameter v-empty-mode     as integer      no-undo.
      799       v-tag-name = trim(v-tag-name).
      800       if  v-empty-mode = 1
      801       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
      802       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
      803       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
      804       then do:
      805           run xmlchar-encode in this-procedure (
      806                 input v-tag-value
      807               , output v-tag-value
      808           ).
      809           put stream stmXMLOut unformatted
      810               chr(10) + fill(" ", 4 * v-tag-level)
      811                           + '<' + v-tag-name + '>'
      812                           + v-tag-value
      813                           + '</' + v-tag-name + '>'
      814           .
      815       end.
      816   end.
      817   end procedure.
      818   procedure bgelib-tag-close:
      819   do
      820   on error undo, return error
      821   :
      822   define input parameter v-tag-level as integer      no-undo.
      823   define input parameter v-tag-name  as character    no-undo.
      824       put stream stmXMLOut unformatted
      825           chr(10)
      826           + fill( " ", 4 * v-tag-level)
      827           + '</' + v-tag-name + '>'
      828       .
      829   end.
      830   end procedure.
      831   procedure bgelib-write-log:
      832   do
      833   on error undo, return error
      834   :
      835   define input parameter v-filename   as character    no-undo.
      836   define input parameter v-log-level  as integer      no-undo.
      837   define input parameter v-out-string as character    no-undo.
      838       output stream stmXMLLog to value( v-filename ) append.
      839       put stream stmXMLLog unformatted
      840           chr(10)
      841       .
      842       put stream stmXMLLog unformatted
      843           ( if v-log-level = 0
      844             or v-out-string = "&DLine"
      845             or v-out-string = "&Line"
      846             then ""
      847             else cur-time-string-sec() + " " )
      848       .
      849       put stream stmXMLLog unformatted
      850           ( if v-out-string = "&Line"
      851             then fill( "-", 80 )
      852             else if v-out-string = "&DLine"
      853                  then fill( "=", 80 )
      854                  else v-out-string )
      855       .
      856       output stream stmXMLLog close.
      857   end.
      858   end procedure.
      859   procedure bgelib-write-edt:
      860   do
      861   on error undo, return error
      862   :
      863   define input parameter v-editor-handle    as handle       no-undo.
      864   define input parameter v-log-level        as integer      no-undo.
      865   define input parameter v-out-string       as character    no-undo.
      866       if valid-handle ( v-editor-handle )
      867       then do:
      868           v-editor-handle :move-to-eof().
      869           v-editor-handle :insert-string( ( if v-log-level = 0
      870                                             or v-out-string = "&DLine"
      871                                             or v-out-string = "&Line"
      872                                             then ""
      873                                             else cur-time-string-sec() + " "
      874                                         ) ).
      875           v-editor-handle :insert-string( ( if v-out-string = "&Line"
      876                                             then fill( "-", 80 )
      877                                             else if v-out-string = "&DLine" then fill("=", 80)
      878                                             else fill( " ", v-log-level) + v-out-string
      879                                         ) ).
      880           v-editor-handle :insert-string( chr(10) ).
      881       end.
      882       process events.
      883       output to 'bgescn.txt' append.
      884           put unformatted
      885               chr(10)
      886               string( ( if v-log-level = 0
      887                         or v-out-string = "&DLine"
      888                         or v-out-string = "&Line"
      889                         then ""
      890                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
      891                     ) )
      892               string( ( if v-out-string = "&Line"
      893                         then fill( "-", 80 )
      894                         else if v-out-string = "&DLine"
      895                              then fill( "=", 80 )
      896                              else fill( " ", v-log-level ) + v-out-string
      897                     ) )
      898           .
      899       output close.
      900   end.
      901   end procedure.
      902   procedure bgelib-show-cnt:
      903   do
      904   on error undo, return error
      905   :
      906   define input parameter v-fillin-handle     as handle   no-undo.
      907       if valid-handle( v-fillin-handle )
      908       then do:
      909           assign
      910               v-fillin-handle :visible = true
      911           .
      912       end.
      913   end.
      914   end procedure.
      915   procedure bgelib-hide-cnt:
      916   do
      917   on error undo, return error
      918   :
      919   define input parameter v-fillin-handle     as handle   no-undo.
      920       if valid-handle( v-fillin-handle )
      921       then do:
      922           assign v-fillin-handle :visible = false.
      923       end.
      924   end.
      925   end procedure.
      926   procedure bgelib-write-cnt:
      927   do
      928   on error undo, return error
      929   :
      930   define input parameter v-fillin-handle    as handle       no-undo.
      931   define input parameter v-fillin-string    as character    no-undo.
      932       if valid-handle( v-fillin-handle )
      933       then do:
      934           assign
      935               v-fillin-handle :SCREEN-value = v-fillin-string
      936           .
      937       end.
      938   end.
      939   end procedure.
      940   procedure bgelib-write-header:
      941   do
      942   on error undo, return error
      943   :
      944   define input parameter p-first-file     as logical      no-undo.
      945   define input parameter p-xml-file-name  as character    no-undo.
      946   define input parameter p-list-file-name as character    no-undo.
      947   define input parameter p-file-number    as integer      no-undo.
      948   define input parameter p-have-prev      as logical      no-undo.
      949   define input parameter p-prev-filename  as character    no-undo.
      950   define input parameter p-obj-list       as character    no-undo.
      951   define input parameter p-doc-type-list  as character    no-undo.
      952   define input parameter p-parameter-list as character    no-undo.
      953       define variable v-counter    as integer        no-undo.
      954       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
      955       put stream stmXMLOut unformatted
      956           "<?xml version='1.0' encoding='windows-1251'?>"
      957       .
      958       run bgelib-tag-open( input 0, input "root"  , input "" ).
      959       run bgelib-tag-open( input 0, input "header", input "" ).
      960       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      961       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      962       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      963       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
      964       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
      965       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      966       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      967       :
      968           run bgelib-tag-put(
      969                 input 1
      970               , input entry( 2 * v-counter, p-parameter-list )
      971               , input entry( 2 * v-counter + 1, p-parameter-list )
      972               , input 0
      973           ).
      974       end.
      975       run bgelib-tag-close( input 0, input "header" ).
      976       output stream stmXMLOut close.
      977       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
      978       if p-first-file = yes
      979       then do:
      980           put stream stmXMLOut unformatted
      981               "<?xml version='1.0' encoding='windows-1251'?>"
      982           .
      983           run bgelib-tag-open( input 0, input "export", input "" ).
      984       end.
      985       run bgelib-tag-open( input 1, input "file", input "" ).
      986       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      987       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      988       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      989       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
      990       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
      991       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      992       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      993       :
      994           run bgelib-tag-put(
      995                 input 2
      996               , input trim(entry( 2 * v-counter, p-parameter-list ))
      997               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
      998               , input 0
      999           ).
     1000       end.
     1001       run bgelib-tag-close( input 1, input "file" ).
     1002       output stream stmXMLOut close.
     1003   end.
     1004   end procedure.
     1005   procedure bgelib-write-footer:
     1006   do
     1007   on error undo, return error
     1008   :
     1009   define input parameter p-last-file      as logical      no-undo.
     1010   define input parameter p-xml-file-name  as character    no-undo.
     1011   define input parameter p-list-file-name as character    no-undo.
     1012   define input parameter p-have-next      as logical      no-undo.
     1013   define input parameter p-next-file-name as character    no-undo.
     1014       define variable v-error-num     as integer           no-undo.
     1015       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1016       if p-have-next = yes
     1017       then do:
     1018           run bgelib-tag-open( input 0, input "footer", "" ).
     1019           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1020           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1021           run bgelib-tag-close( input 0, input "footer" ).
     1022       end.
     1023       run bgelib-tag-close( input 0, input "root" ).
     1024       output stream stmXMLOut close.
     1025       run bge/os_copy.p (
     1026             input "M"
     1027           , input p-xml-file-name + "tmp"
     1028           , input p-xml-file-name + "xml"
     1029           , output v-error-num
     1030       ).
     1031       if p-last-file = yes
     1032       then do:
     1033           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1034               run bgelib-tag-close( input 0, input "export" ).
     1035           output stream stmXMLOut close.
     1036           run bge/os_copy.p (
     1037                 input "M"
     1038               , input p-list-file-name + "tmp"
     1039               , input p-list-file-name + "xml"
     1040               , output v-error-num
     1041           ).
     1042       end.
     1043   end.
     1044   end procedure.
     1045   procedure bgelib-filename :
     1046   do
     1047   on error undo, return error
     1048   :
     1049   define input parameter p-prefix             as character    no-undo.
     1050   define output parameter p-xml-file-name     as character    no-undo.
     1051   define output parameter p-log-file-name     as character    no-undo.
     1052   define output parameter p-list-file-name    as character    no-undo.
     1053       define variable v-home-dir  as character    no-undo.
     1054       define variable v-error-num as integer      no-undo.
     1055       get-key-value section "BGE" key "outdir" value v-home-dir.
     1056       if v-home-dir = ?
     1057       then do:
     1058           message
     1059             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1060             skip(1)
     1061             skip "Обратитесь к администратору."
     1062           view-as alert-box error.
     1063           undo, return error .
     1064       end.
     1065       run gbl/dir-cre.p (
     1066           input v-home-dir
     1067       ) no-error.
     1068       if error-status :error
     1069       then do:
     1070           message
     1071             skip "Неверно задан каталог экспорта."
     1072             skip(1)
     1073             skip "Обратитесь к администратору."
     1074           view-as alert-box error.
     1075           undo, return error .
     1076       end.
     1077       run bge/genfname.p (
     1078             input v-home-dir
     1079           , input p-prefix
     1080           , input ""
     1081           , input "xml"
     1082           , input "tmp"
     1083           , output p-xml-file-name
     1084       ).
     1085       assign
     1086           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1087           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1088           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1089       .
     1090   end.
     1091   end procedure.
     1092   procedure bgelib-read-config :
     1093   do
     1094   on error undo, return error
     1095   :
     1096   define variable v-par-type as character     no-undo.
     1097     define variable v-param-type      as character  no-undo .
     1098     define variable v-value-character as character  no-undo .
     1099     define variable v-value-date      as date       no-undo .
     1100     define variable v-value-decimal   as decimal    no-undo .
     1101     define variable v-value-integer   as integer    no-undo .
     1102     define variable v-value-logical   as logical    no-undo .
     1103     define variable v-tth             as handle     no-undo .
     1104       assign
     1105           v-bgelib-bgeclall = no
     1106           v-bgelib-bgedict  = no
     1107       .
     1108       run adm/shattri.p ( input "get":U
     1109                         , input  '':u
     1110                         , input  0
     1111                         , input  'bge-export':U
     1112                         , input  'bgeclall':U
     1113                         , output v-value-character
     1114                         , output v-value-date
     1115                         , output v-value-decimal
     1116                         , output v-value-integer
     1117                         , output v-value-logical
     1118                         , output v-param-type
     1119                         , input-output table-handle v-tth
     1120                         ) no-error .
     1121       if error-status :error
     1122       then do:
     1123         assign
     1124           v-bgelib-bgeclall = no
     1125         .
     1126       end.
     1127       else do:
     1128         assign
     1129           v-bgelib-bgeclall = v-value-logical
     1130         .
     1131       end.
     1132       delete object v-tth.
     1133       run adm/shattri.p ( input "get":U
     1134                         , input  '':u
     1135                         , input  0
     1136                         , input  'bge-export':U
     1137                         , input  'bgedict':U
     1138                         , output v-value-character
     1139                         , output v-value-date
     1140                         , output v-value-decimal
     1141                         , output v-value-integer
     1142                         , output v-value-logical
     1143                         , output v-param-type
     1144                         , input-output table-handle v-tth
     1145                         ) no-error .
     1146       if error-status :error
     1147       then do:
     1148         assign
     1149           v-bgelib-bgedict = no
     1150         .
     1151       end.
     1152       else do:
     1153         assign
     1154           v-bgelib-bgedict = v-value-logical
     1155         .
     1156       end.
     1157       delete object v-tth.
     1158       run adm/shattri.p ( input "get":U
     1159                         , input  '':u
     1160                         , input  0
     1161                         , input  'bge-export':U
     1162                         , input  'bgefmt':U
     1163                         , output v-value-character
     1164                         , output v-value-date
     1165                         , output v-value-decimal
     1166                         , output v-value-integer
     1167                         , output v-value-logical
     1168                         , output v-param-type
     1169                         , input-output table-handle v-tth
     1170                         ) no-error .
     1171       if error-status :error
     1172       then do:
     1173         assign
     1174           v-bgelib-bgefmt  = "xml":U
     1175         .
     1176       end.
     1177       else do:
     1178         assign
     1179           v-bgelib-bgefmt  = v-value-character
     1180         .
     1181       end.
     1182       delete object v-tth.
     1183       run adm/shattri.p ( input "get":U
     1184                         , input  '':u
     1185                         , input  0
     1186                         , input  'bge-export':U
     1187                         , input  'bgeflold':U
     1188                         , output v-value-character
     1189                         , output v-value-date
     1190                         , output v-value-decimal
     1191                         , output v-value-integer
     1192                         , output v-value-logical
     1193                         , output v-param-type
     1194                         , input-output table-handle v-tth
     1195                         ) no-error .
     1196       if error-status :error
     1197       then do:
     1198         assign
     1199           v-bgelib-bgeflold  = "old":U
     1200         .
     1201       end.
     1202       else do:
     1203         assign
     1204           v-bgelib-bgeflold  = v-value-character
     1205         .
     1206       end.
     1207       delete object v-tth.
     1208   end.
     1209   end procedure.
     1210   procedure bgelib-check-file-size :
     1211   do
     1212   on error undo, return error
     1213   :
     1214   define input parameter p-out-filename   as character    no-undo.
     1215   define output parameter p-is-big        as logical      no-undo.
     1216       define variable v-current-position    as integer        no-undo.
     1217       assign
     1218           v-current-position = seek( stmXMLOut )
     1219       .
     1220       if v-current-position / 1024 / 1024  >= 100
     1221       then do:
     1222           assign
     1223               p-is-big = yes
     1224           .
     1225       end.
     1226   end.
     1227   end procedure.
     1228   procedure bgelib-init-ext-doc-type :
     1229       define variable v-counter    as integer      no-undo.
     1230       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     1231   do
     1232   for buf_temp_ext-doc-type
     1233   on error undo, return error
     1234   :
     1235       empty temp-table buf_temp_ext-doc-type.
