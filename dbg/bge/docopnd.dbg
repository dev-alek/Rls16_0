        1   block-level on error undo, throw.
        2   define input parameter p-host-code       as integer                 no-undo.
        3   define input parameter p-obj-type        as character               no-undo.
        4   define input parameter p-obj-code        as integer                 no-undo.
        5   define input parameter p-cst             as logical                 no-undo.
        6   define input parameter p-parts           as logical                 no-undo.
        7   define input parameter sOutFile          as character               no-undo.
        8   define input parameter sLogFile          as character               no-undo.
        9   define input parameter p-parent-handle   as handle                  no-undo.
       10   define input parameter hEDT              as handle                  no-undo.
       11   define input parameter hCNT              as handle                  no-undo.
       12   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       13   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       14   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile: docopnd.p $":U .
       16   define variable vss-archive     as character no-undo init "$Archive: bge/docopnd.p $":U .
       17   define variable vss-description as character no-undo init "Экспорт не закрытых на факт документов прихода и расхода.".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define variable vss-include-info0 as character format "X(65)" no-undo
       79   initial "@(#)$Workfile$ $Revision$".
       80   define variable v-bgelib-bgefmt        as character         no-undo.
       81   define variable v-bgelib-bgeflold      as character         no-undo.
       82   define stream stmXMLOut.
       83   define stream stmXMLLog.
       84   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       85   procedure cur-time :
       86      define output parameter p-today as date      no-undo .
       87      define output parameter p-time  as integer   no-undo .
       88     do
       89     on error undo, return error
       90     :
       91       define variable v-date1 as date      no-undo .
       92       define variable v-date2 as date      no-undo .
       93       define variable v-time  as integer   no-undo .
       94       assign
       95         v-date1 = today
       96         v-time  = time
       97         v-date2 = today
       98       .
       99       if v-date1 <> v-date2
      100       then do:
      101         assign
      102           v-date1 = today
      103           v-time  = v-time
      104         .
      105       end.
      106       assign
      107         p-today = v-date1
      108         p-time  = v-time
      109       .
      110     end.
      111   end.
      112   function cur-time-date returns character
      113   :
      114     return string(today, '99/99/9999':U) .
      115   end.
      116   function cur-time-mjd returns decimal
      117   :
      118     define variable v-date as date      no-undo .
      119     define variable v-time as integer   no-undo .
      120     run cur-time in this-procedure
      121       (output v-date
      122       ,output v-time
      123       ) .
      124     return integer(v-date) - 2400002 + (v-time / 86400) .
      125   end.
      126   function cur-time-get-ending-index returns integer
      127   (input p-number as integer
      128   )
      129   :
      130     if p-number < 0
      131     or p-number = ?
      132     then do:
      133       return 1 .
      134     end.
      135     define variable v-rest as integer   no-undo .
      136     assign
      137       p-number = p-number modulo 100
      138     .
      139     if p-number < 20
      140     then do:
      141       assign
      142         v-rest = p-number
      143       .
      144     end.
      145     else do:
      146       assign
      147         v-rest = p-number modulo 10
      148       .
      149     end.
      150     case v-rest :
      151       when 1
      152       then do:
      153         return 2 .
      154       end.
      155       when 2 or
      156       when 3 or
      157       when 4
      158       then do:
      159         return 3 .
      160       end.
      161       otherwise do:
      162         return 1 .
      163       end.
      164     end case .
      165   end.
      166   procedure cur-time-mjd-to-date :
      167      define input  parameter i-mjd-diff as decimal no-undo.
      168      define output parameter o-Date     as date    no-undo.
      169      define output parameter o-Time     as integer no-undo.
      170      define variable v-day-number as integer   no-undo .
      171      if    i-mjd-diff < 0
      172         or i-mjd-diff = ?
      173      then do:
      174         return "?" .
      175      end.
      176      assign
      177         v-day-number = truncate(i-mjd-diff,0).
      178         o-Date = date(v-day-number + 2400002).
      179         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      180     .
      181   end.
      182   function cur-time-mjd-to-string returns character
      183   (input p-mjd-diff as decimal
      184   )
      185   :
      186     define variable v-day-number as integer   no-undo .
      187     define variable v-seconds    as integer   no-undo .
      188     define variable v-hour       as integer   no-undo .
      189     define variable v-min        as integer   no-undo .
      190     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      191     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      192     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      193     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      194     if p-mjd-diff < 0
      195     or p-mjd-diff = ?
      196     then do:
      197       return "?" .
      198     end.
      199     assign
      200       v-day-number = integer(truncate(p-mjd-diff,0))
      201       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      202     .
      203     if v-seconds > 86400
      204     then do:
      205       assign
      206         v-seconds = 86400 - 1
      207       .
      208     end.
      209     if v-seconds < 0
      210     then do:
      211       assign
      212         v-seconds = 0
      213       .
      214     end.
      215     assign
      216       v-hour = truncate(v-seconds / 3600, 0)
      217     .
      218     assign
      219       v-seconds = v-seconds modulo 3600
      220     .
      221     assign
      222       v-min = truncate(v-seconds / 60, 0)
      223     .
      224     assign
      225       v-seconds = v-seconds modulo 60
      226     .
      227     return
      228         (if v-day-number <> 0
      229           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      230           else ""
      231         )
      232       + (if v-day-number <> 0 or v-hour <> 0
      233           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      234           else ""
      235         )
      236       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      237           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      238           else ""
      239         )
      240       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      241       .
      242   end.
      243   function cur-time-string returns character
      244   :
      245     define variable v-date as date      no-undo .
      246     define variable v-time as integer   no-undo .
      247     run cur-time in this-procedure
      248       (output v-date
      249       ,output v-time
      250       ) .
      251     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      252   end.
      253   function cur-time-string-sec returns character
      254   :
      255     define variable v-date as date      no-undo .
      256     define variable v-time as integer   no-undo .
      257     run cur-time in this-procedure
      258       (output v-date
      259       ,output v-time
      260       ) .
      261     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      262   end.
      263   function cur-time-custom  returns character
      264   (input p-prefix as character
      265   ,input p-date-format as character
      266   ,input p-delimiter as character
      267   ,input p-time-format as character
      268   ,input p-suffix as character
      269   )
      270   :
      271     define variable v-date as date      no-undo .
      272     define variable v-time as integer   no-undo .
      273     run cur-time in this-procedure
      274       (output v-date
      275       ,output v-time
      276       ) .
      277     return
      278       p-prefix
      279       + string(v-date, p-date-format)
      280       + p-delimiter
      281       + string(v-time, p-time-format)
      282       + p-suffix
      283       .
      284   end.
      285   function cur-time-print  returns character
      286   :
      287     define variable v-date as date      no-undo .
      288     define variable v-time as integer   no-undo .
      289     run cur-time in this-procedure
      290       (output v-date
      291       ,output v-time
      292       ) .
      293     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      294   end.
      295   function cur-time-datetime returns datetime
      296   :
      297     define variable v-char as character no-undo .
      298     define variable v-datetime as datetime no-undo .
      299     v-char = cur-time-string().
      300     v-datetime = datetime(v-char).
      301     return  v-datetime.
      302   end.
      303   function cur-time-string-msec returns character
      304   :
      305     define variable v-date as datetime  no-undo .
      306     v-date = now.
      307     return string(v-date) .
      308   end.
      309   define variable vss-include-info2 as character format "X(65)" no-undo
      310   initial "@(#)$Workfile$ $Revision$".
      311   procedure xmlchar-test :
      312   define input parameter p-in-string          as character        no-undo.
      313   define output parameter p-out-string-enc    as character        no-undo.
      314   define output parameter p-out-string-dec    as character        no-undo.
      315   do
      316   on error undo, return error
      317   :
      318          run xmlchar-encode in this-procedure
      319       (
      320             input p-in-string
      321           , output p-out-string-enc
      322       ).
      323          run xmlchar-decode in this-procedure
      324       (
      325             input p-out-string-enc
      326           , output p-out-string-dec
      327       ).
      328   end.
      329   end .
      330   procedure xmlchar-encode :
      331   define input parameter p-in-string      as character        no-undo.
      332   define output parameter p-out-string    as character        no-undo.
      333       define variable v-position      as integer      no-undo.
      334       define variable v-current-char  as character    no-undo.
      335   do
      336   on error undo, return error
      337   :
      338       assign
      339           p-out-string = "":U
      340       .
      341       case p-in-string
      342       :
      343           when ?
      344           then do:
      345               assign
      346                   p-out-string = "?":U
      347               .
      348           end.
      349           when "?":U
      350           then do:
      351               assign
      352                   p-out-string = "&#63;":U
      353               .
      354           end.
      355           otherwise do:
      356               do v-position = 1 to length( p-in-string )
      357               :
      358                   assign
      359                       v-current-char = substring( p-in-string, v-position, 1 )
      360                   .
      361                   case v-current-char
      362                   :
      363                       when "&":U
      364                       then do:
      365                           assign
      366                               p-out-string = p-out-string + "&amp;":U
      367                           .
      368                       end.
      369                       when ">":U
      370                       then do:
      371                           assign
      372                               p-out-string = p-out-string + "&gt;":U
      373                           .
      374                       end.
      375                       when "<":U
      376                       then do:
      377                           assign
      378                               p-out-string = p-out-string + "&lt;":U
      379                           .
      380                       end.
      381                       when "'":U
      382                       then do:
      383                           assign
      384                               p-out-string = p-out-string + "&apos;":U
      385                           .
      386                       end.
      387                       when '"':U
      388                       then do:
      389                           assign
      390                               p-out-string = p-out-string + "&quot;":U
      391                           .
      392                       end.
      393                       when chr(1)
      394                       then do:
      395                           assign
      396                               p-out-string = p-out-string + "":U
      397                           .
      398                       end.
      399                       when chr(2)
      400                       then do:
      401                           assign
      402                               p-out-string = p-out-string + "":U
      403                           .
      404                       end.
      405                       when chr(3)
      406                       then do:
      407                           assign
      408                               p-out-string = p-out-string + "":U
      409                           .
      410                       end.
      411                       when chr(4)
      412                       then do:
      413                           assign
      414                               p-out-string = p-out-string + "":U
      415                           .
      416                       end.
      417                       when chr(5)
      418                       then do:
      419                           assign
      420                               p-out-string = p-out-string + "":U
      421                           .
      422                       end.
      423                       when chr(6)
      424                       then do:
      425                           assign
      426                               p-out-string = p-out-string + "":U
      427                           .
      428                       end.
      429                       when chr(7)
      430                       then do:
      431                           assign
      432                               p-out-string = p-out-string + "":U
      433                           .
      434                       end.
      435                       when chr(8)
      436                       then do:
      437                           assign
      438                               p-out-string = p-out-string + "":U
      439                           .
      440                       end.
      441                       when chr(9)
      442                       then do:
      443                           assign
      444                               p-out-string = p-out-string + "":U
      445                           .
      446                       end.
      447                       when chr(29)
      448                       then do:
      449                           assign
      450                               p-out-string = p-out-string + "":U
      451                           .
      452                       end.
      453                       when chr(10)
      454                       then do:
      455                           assign
      456                               p-out-string = p-out-string + "&#10;":U
      457                           .
      458                       end.
      459                       when chr(13)
      460                       then do:
      461                           assign
      462                               p-out-string = p-out-string + "&#13;":U
      463                           .
      464                       end.
      465                       otherwise do:
      466                           assign
      467                               p-out-string = p-out-string + v-current-char
      468                           .
      469                       end.
      470                   end case.
      471               end.
      472           end.
      473       end case.
      474   end.
      475   end .
      476   procedure xmlchar-encode-1c :
