     2328       for each buf_trn-doc no-lock
     2329          where buf_trn-doc.obj-type   = p-obj-type
     2330            and buf_trn-doc.obj-code   = p-obj-code
     2331            and buf_trn-doc.status_    = 'накл':U
     2332            or ( buf_trn-doc.obj-type   = p-obj-type
     2333               and buf_trn-doc.obj-code   = p-obj-code
     2334               and buf_trn-doc.status_    = 'разрешен':U )
     2335       :
     2336           if buf_trn-doc.is-flora = yes
     2337           then do:
     2338           end.
     2339           else do:
     2340               if buf_trn-doc.ext-doc-type = 'ie':U
     2341               or buf_trn-doc.ext-doc-type = 'ee':U
     2342               then do:
     2343                   run bgelib-write-cnt( input hCNT, string( buf_trn-doc.doc-date, "99/99/9999" ) + "  " + buf_trn-doc.doc-code ).
     2344                   run export-trn-doc in this-procedure (
     2345                       input buf_trn-doc.doc-code
     2346                       , input buf_trn-doc.ext-doc-type
     2347                       , input p-host-code
     2348                       , input buf_trn-doc.ext-doc-type
     2349                       , input ( if buf_trn-doc.ext-doc-type = 'ie':U then 1 else -1 )
     2350                   ) no-error.
     2351                   if error-status :error
     2352                   then do:
     2353                       undo, return error vss-description + "Ошибка вывода документа " + buf_trn-doc.doc-code.
     2354                   end.
     2355               end.
     2356            end.
     2357      end.
     2358       output stream stmxmlout close.
