     1561               .
     1562           end.
     1563           if v-gds-dtl-fact-qnty <> 0
     1564           then do:
     1565   if buf_trn-doc.ext-doc-type = 'ot':U or
     1566      buf_trn-doc.ext-doc-type = ?                 then do:
     1567     assign
     1568      out-vatp-have-vat-slt = yes.
     1569   end.
     1570   else do:
     1571     find first out-vatp_doc-attr no-lock
