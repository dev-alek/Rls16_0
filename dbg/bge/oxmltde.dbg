        1   define input parameter p-mainmenu-handle    as widget-handle    no-undo.
        2   define input parameter p-mode               as integer          no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Типы данных для внешних подсистем OpenXML.".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   procedure cur-time :
       69      define output parameter p-today as date      no-undo .
       70      define output parameter p-time  as integer   no-undo .
       71     do
       72     on error undo, return error
       73     :
       74       define variable v-date1 as date      no-undo .
       75       define variable v-date2 as date      no-undo .
       76       define variable v-time  as integer   no-undo .
       77       assign
       78         v-date1 = today
       79         v-time  = time
       80         v-date2 = today
       81       .
       82       if v-date1 <> v-date2
       83       then do:
       84         assign
       85           v-date1 = today
       86           v-time  = v-time
       87         .
       88       end.
       89       assign
       90         p-today = v-date1
       91         p-time  = v-time
       92       .
       93     end.
       94   end.
       95   function cur-time-date returns character
       96   :
       97     return string(today, '99/99/9999':U) .
       98   end.
       99   function cur-time-mjd returns decimal
      100   :
      101     define variable v-date as date      no-undo .
      102     define variable v-time as integer   no-undo .
      103     run cur-time in this-procedure
      104       (output v-date
      105       ,output v-time
      106       ) .
      107     return integer(v-date) - 2400002 + (v-time / 86400) .
      108   end.
      109   function cur-time-get-ending-index returns integer
      110   (input p-number as integer
      111   )
      112   :
      113     if p-number < 0
      114     or p-number = ?
      115     then do:
      116       return 1 .
      117     end.
      118     define variable v-rest as integer   no-undo .
      119     assign
      120       p-number = p-number modulo 100
      121     .
      122     if p-number < 20
      123     then do:
      124       assign
      125         v-rest = p-number
      126       .
      127     end.
      128     else do:
      129       assign
      130         v-rest = p-number modulo 10
      131       .
      132     end.
      133     case v-rest :
      134       when 1
      135       then do:
      136         return 2 .
      137       end.
      138       when 2 or
      139       when 3 or
      140       when 4
      141       then do:
      142         return 3 .
      143       end.
      144       otherwise do:
      145         return 1 .
      146       end.
      147     end case .
      148   end.
      149   procedure cur-time-mjd-to-date :
      150      define input  parameter i-mjd-diff as decimal no-undo.
      151      define output parameter o-Date     as date    no-undo.
      152      define output parameter o-Time     as integer no-undo.
      153      define variable v-day-number as integer   no-undo .
      154      if    i-mjd-diff < 0
      155         or i-mjd-diff = ?
      156      then do:
      157         return "?" .
      158      end.
      159      assign
      160         v-day-number = truncate(i-mjd-diff,0).
      161         o-Date = date(v-day-number + 2400002).
      162         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      163     .
      164   end.
      165   function cur-time-mjd-to-string returns character
      166   (input p-mjd-diff as decimal
      167   )
      168   :
      169     define variable v-day-number as integer   no-undo .
      170     define variable v-seconds    as integer   no-undo .
      171     define variable v-hour       as integer   no-undo .
      172     define variable v-min        as integer   no-undo .
      173     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      174     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      175     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      176     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      177     if p-mjd-diff < 0
      178     or p-mjd-diff = ?
      179     then do:
      180       return "?" .
      181     end.
      182     assign
      183       v-day-number = integer(truncate(p-mjd-diff,0))
      184       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      185     .
      186     if v-seconds > 86400
      187     then do:
      188       assign
      189         v-seconds = 86400 - 1
      190       .
      191     end.
      192     if v-seconds < 0
      193     then do:
      194       assign
      195         v-seconds = 0
      196       .
      197     end.
      198     assign
      199       v-hour = truncate(v-seconds / 3600, 0)
      200     .
      201     assign
      202       v-seconds = v-seconds modulo 3600
      203     .
      204     assign
      205       v-min = truncate(v-seconds / 60, 0)
      206     .
      207     assign
      208       v-seconds = v-seconds modulo 60
      209     .
      210     return
      211         (if v-day-number <> 0
      212           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      213           else ""
      214         )
      215       + (if v-day-number <> 0 or v-hour <> 0
      216           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      217           else ""
      218         )
      219       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      220           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      221           else ""
      222         )
      223       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      224       .
      225   end.
      226   function cur-time-string returns character
      227   :
      228     define variable v-date as date      no-undo .
      229     define variable v-time as integer   no-undo .
      230     run cur-time in this-procedure
      231       (output v-date
      232       ,output v-time
      233       ) .
      234     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      235   end.
      236   function cur-time-string-sec returns character
      237   :
      238     define variable v-date as date      no-undo .
      239     define variable v-time as integer   no-undo .
      240     run cur-time in this-procedure
      241       (output v-date
      242       ,output v-time
      243       ) .
      244     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      245   end.
      246   function cur-time-custom  returns character
      247   (input p-prefix as character
      248   ,input p-date-format as character
      249   ,input p-delimiter as character
      250   ,input p-time-format as character
      251   ,input p-suffix as character
      252   )
      253   :
      254     define variable v-date as date      no-undo .
      255     define variable v-time as integer   no-undo .
      256     run cur-time in this-procedure
      257       (output v-date
      258       ,output v-time
      259       ) .
      260     return
      261       p-prefix
      262       + string(v-date, p-date-format)
      263       + p-delimiter
      264       + string(v-time, p-time-format)
      265       + p-suffix
      266       .
      267   end.
      268   function cur-time-print  returns character
      269   :
      270     define variable v-date as date      no-undo .
      271     define variable v-time as integer   no-undo .
      272     run cur-time in this-procedure
      273       (output v-date
      274       ,output v-time
      275       ) .
      276     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      277   end.
      278   function cur-time-datetime returns datetime
      279   :
      280     define variable v-char as character no-undo .
      281     define variable v-datetime as datetime no-undo .
      282     v-char = cur-time-string().
      283     v-datetime = datetime(v-char).
      284     return  v-datetime.
      285   end.
      286   function cur-time-string-msec returns character
      287   :
      288     define variable v-date as datetime  no-undo .
      289     v-date = now.
      290     return string(v-date) .
      291   end.
      292   define new global shared variable g#library  as handle no-undo .
      293   define new global shared variable g#library2 as handle no-undo .
      294   procedure proc-alt-shift-f2:
      295     if not ibs.th.gbl.gbl-var:rcode
      296   then
      297     run gbl\inidebug.p .
      298   end.
      299   procedure proc-alt-shift-f3:
      300     run gbl/prvssinf.p
      301       ( input this-procedure
      302       ) .
      303   end.
      304   define variable v-inform-launched as logical no-undo initial false .
      305   procedure proc-alt-shift-f4:
      306     define variable v-action as character no-undo .
      307     if v-inform-launched = false then do:
      308       assign
      309         v-inform-launched = true
      310       .
      311       run gbl/d-inform.w
      312         (  input self
      313         ,  input this-procedure
      314         , output v-action
      315         ) no-error .
      316       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      317       assign
      318         v-inform-launched = false
      319       .
      320     end.
      321   end.
      322   procedure proc-alt-f1:
      323     run gbl/corrhelp.p
      324       (input this-procedure
      325       ) .
      326   end .
      327   on alt-shift-f2 anywhere do:
      328     run proc-alt-shift-f2.
      329   end.
      330   on alt-shift-f3 anywhere do:
      331     run proc-alt-shift-f3 in this-procedure .
      332   end.
      333   on alt-shift-f4 anywhere do:
      334     run proc-alt-shift-f4 in this-procedure.
      335   end.
      336   on alt-f1 anywhere do:
      337     run proc-alt-f1 in this-procedure .
      338   end.
      339       define buffer buf_init_datatype-exp       for ub.datatype-exp.
      340   DEFINE BUTTON b-exit
      341        LABEL "&Выход"
      342        SIZE 10 BY 1
      343        BGCOLOR 8 .
      344   DEFINE BUTTON b-help
      345        LABEL "Помощ&ь"
      346        SIZE 10 BY 1
      347        BGCOLOR 8 .
      348   DEFINE BUTTON b-sel
      349        LABEL "*"
      350        SIZE 3 BY 1.
      351   DEFINE BUTTON b-select
      352        LABEL "В&ыбор"
      353        SIZE 10 BY 1.
      354   DEFINE VARIABLE ed-desc AS CHARACTER
      355        VIEW-AS EDITOR
      356        SIZE 96.88 BY 2.21 NO-UNDO.
      357   DEFINE QUERY br-table FOR
      358         buf_init_datatype-exp SCROLLING.
      359   DEFINE BROWSE br-table
      360     QUERY br-table NO-LOCK DISPLAY
      361         buf_init_datatype-exp.dte-id
      362         ( if buf_init_datatype-exp.dte-status = -1
      363           then "новая"
      364           else ( if buf_init_datatype-exp.dte-status = 1
      365                  then "в работе"
      366                  else "останов" ) )                       column-label " Статус "
      367         buf_init_datatype-exp.dte-name
      368         buf_init_datatype-exp.dte-des
      369       WITH NO-ROW-MARKERS SEPARATORS SIZE 96.88 BY 18.54.
      370   DEFINE FRAME Dialog-Frame
      371        b-exit AT ROW 1.17 COL 1.63
      372        b-sel AT ROW 1.17 COL 11.63
      373        b-select AT ROW 1.17 COL 14.63
      374        b-help AT ROW 1.17 COL 88.63
      375        br-table AT ROW 2.5 COL 1.63
      376        ed-desc AT ROW 21.17 COL 1.63 NO-LABEL
      377        SPACE(0.46) SKIP(0.15)
      378       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      379            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      380            TITLE "Список типов данных OpenXML".
      381   ASSIGN
      382          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      383          FRAME Dialog-Frame:HIDDEN           = TRUE.
      384   ASSIGN
      385          ed-desc:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      386   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      387   DO:
      388     APPLY "END-ERROR":U TO SELF.
      389   END.
      390   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      391   DO:
      392       apply "WINDOW-CLOSE" TO FRAME Dialog-Frame .
      393   END.
      394   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      395   on help of frame Dialog-Frame
      396   do:
      397     run gbl/app_help.p
      398       (input this-procedure :file-name
      399       ,input ''
      400       ,input ?
      401       ) no-error.
      402     if error-status :error then do:
      403       message
      404         "Ошибка при вызове помощи"
      405         error-status :get-message(1)
      406         view-as alert-box .
      407     end.
      408   end.
      409   run minbtn-set in this-procedure .
      410   on choose of b-help in frame Dialog-Frame
      411   do:
      412     apply "help":u to frame Dialog-Frame .
      413   end.
      414   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      415   procedure minbtn-set :
      416       do
      417           on error undo, return error return-value
      418           :
      419           define variable ii              as integer       no-undo .
      420           define variable fh              as widget-handle no-undo .
      421           define variable hh              as widget-handle no-undo .
      422           define variable v-h             as handle        extent 4 no-undo .
      423           define variable v-name-button   as character     no-undo .
      424           define variable v-help-old-x    as decimal       no-undo .
      425           define variable v-help-old-y    as decimal       no-undo .
      426           define variable v-help-old-size as decimal       no-undo .
      427           define variable v-frame-width   as decimal       no-undo .
      428           define variable jj              as integer       no-undo .
      429           do
      430               on error undo, return error
      431               :
      432               assign
      433                   v-frame-width = frame Dialog-Frame:width - 0.3
      434                   fh            = frame Dialog-Frame:first-child
      435                   hh            = fh:first-child
      436                   ii            = 1
      437                   .
      438               do while valid-handle(hh):
      439                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      440                   do:
      441                       case lc(hh:name) :
      442                           when "b-help" then
      443                               do:
      444                                   hh:load-image-up("cmp/b-help.bmp":u) .
      445                                   hh:load-image-down("cmp/b-help.bmp":u) .
      446                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      447                                   hh:TOOLTIP = "Помощь" .
      448                                   v-help-old-x = hh:column .
      449                                   v-help-old-y = hh:row    .
      450                                   v-help-old-size = hh:width .
      451                                   hh:width-chars = 2.5 .
      452                               end.
      453                           when "b-print" then
      454                               do:
      455                                   hh:load-image("cmp/b-print.bmp":u) .
      456                                   hh:TOOLTIP = "Печать" .
      457                                   v-h[ii] = hh:handle .
      458                                   ii = ii + 1 .
      459                                   hh:width-chars = 3 .
      460                               end.
      461                           when "b-history" or
      462                           when "b-hist" then
      463                               do:
      464                                   hh:load-image("cmp/b-hist.bmp":u) .
      465                                   hh:TOOLTIP = "История" .
      466                                   v-h[ii] = hh:handle .
      467                                   ii = ii + 1 .
      468                                   hh:width-chars = 3 .
      469                               end.
      470                           when "b-sch" then
      471                               do:
      472                                   hh:load-image("cmp/b-sch.bmp":u) .
      473                                   hh:TOOLTIP = "Установка Фильтра" .
      474                                   v-h[ii] = hh:handle .
      475                                   ii = ii + 1 .
      476                                   hh:width-chars = 3 .
      477                               end.
      478                           when "b-hist-user" then
      479                               do:
      480                                   hh:load-image("cmp/b-hist.bmp":u) .
      481                                   hh:TOOLTIP = "История пользователя" .
      482                                   ii = ii + 1 .
      483                               end.
      484                       end case.
      485                   end.
      486                   hh = hh:next-sibling.
      487               end.
      488               b-help:column = v-frame-width - b-help:width-chars.
      489               jj = 0.
      490               repeat ii = 4 to 1 by -1 :
      491                   if valid-handle (v-h[ii] ) then
      492                   do:
      493                       jj  = jj + 1 .
      494                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      495                       v-h[ii]:row    = v-help-old-y .
      496                   end.
      497               end.
      498           end.
      499       end.
      500   end procedure.
      501   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      502   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      503   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      504   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      505   define variable v-diasize-current-frame-width  as decimal   no-undo .
      506   define variable v-diasize-current-frame-height as decimal   no-undo .
      507   define variable v-diasize-change-size          as logical   no-undo .
      508   define variable v-diasize-resize-button        as handle    no-undo .
      509   define variable v-diasize-wndmax               as logical   no-undo .
      510   define variable v-diasize-wndstore             as logical   no-undo .
      511   define variable v-diasize-proc-name            as character no-undo .
      512   define variable v-diasize-browse-handle        as handle    no-undo .
      513   define variable v-diasize-browse-number        as integer   no-undo .
      514   define variable v-diasize-need-full-display    as logical   no-undo init false .
      515   define temp-table temp-diasize-handle no-undo
      516     field handle-value  as handle
      517     field save-position as decimal
      518     index xpk is primary unique handle-value
      519     .
      520   define temp-table temp-browse-handle no-undo
      521     field browse-type   as character
      522     field browse-number as integer
      523     field browse-handle as handle
      524     field original-size as decimal
      525     index xpk is primary unique browse-type browse-number
      526     index xie browse-type browse-handle
      527   .
      528   procedure diasize_change-height :
      529     define input  parameter p-change-value  as decimal   no-undo .
      530     define input  parameter p-move-resize   as logical   no-undo .
      531     define variable v-field-group-handle    as handle    no-undo .
      532     define variable v-object-handle         as handle    no-undo .
      533     define variable v-frame-height          as decimal   no-undo .
      534     define variable v-frame-virtual-height  as decimal   no-undo .
      535     define variable v-browse-height         as decimal   no-undo .
      536     define variable v-window-height         as decimal   no-undo .
      537     define variable v-window-virtual-height as decimal   no-undo .
      538     define variable v-change-sign           as integer   no-undo .
      539     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      540     define buffer buf_temp-browse-handle  for temp-browse-handle .
      541     if p-change-value > 0
      542     then do:
      543       if frame Dialog-Frame :height + p-change-value
      544           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      545       then do:
      546         assign
      547           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      548                           - (frame Dialog-Frame :height-chars)
      549         .
      550         if p-change-value <= 0
      551         then do:
      552           run diasize_position-resize-button in this-procedure .
      553           return .
      554         end.
      555       end.
      556     end.
      557     if p-change-value < 0
      558     then do:
      559       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      560       then do:
      561         assign
      562           p-change-value = v-diasize-orig-frame-height
      563                          - (frame Dialog-Frame :height-chars)
      564         .
      565         if p-change-value >= 0
      566         then do:
      567           run diasize_position-resize-button in this-procedure .
      568           return .
      569         end.
      570       end.
      571     end.
      572     if p-change-value >= 0
      573     then do:
      574       assign
      575         v-change-sign = 1
      576       .
      577     end.
      578     else do:
      579       assign
      580         v-change-sign = -1
      581       .
      582     end.
      583     assign
      584       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      585     .
      586     if p-change-value = 0
      587     then do:
      588       run diasize_position-resize-button in this-procedure .
      589       return .
      590     end.
      591     move_block:
      592     do
      593     on error undo move_block, retry move_block
      594     :
      595       if retry
      596       then do:
      597         do
      598         on error undo move_block, leave move_block
      599         :
      600           if p-change-value > 0
      601           then do:
      602             for each buf_temp-diasize-handle
      603             on error undo, next
      604             :
