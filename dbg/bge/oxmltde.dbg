     1219           end.
     1220         end.
     1221         for each buf_temp-browse-handle
     1222           where buf_temp-browse-handle.browse-type = 'width':u
     1223         on error undo move_block, retry move_block
     1224         :
     1225           assign
     1226             buf_temp-browse-handle.browse-handle :width
     1227               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1228             no-error .
     1229           if error-status :error
     1230           or error-status :get-message(1) <> ""
     1231           then do:
     1232             undo move_block, retry move_block .
     1233           end.
     1234         end.
     1235         assign
     1236           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1237           no-error .
     1238         if error-status :error
     1239         or error-status :get-message(1) <> ""
     1240         then do:
     1241           undo move_block, retry move_block.
     1242         end.
     1243         assign
     1244           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1245         no-error .
     1246         if error-status :error
     1247         or error-status :get-message(1) <> ""
     1248         then do:
     1249           undo move_block, retry move_block.
     1250         end.
     1251         if frame Dialog-Frame :scrollable = true
     1252         then do:
     1253           assign
     1254             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1255           no-error .
     1256           if error-status :error
     1257           or error-status :get-message(1) <> ""
     1258           then do:
     1259             undo move_block, retry move_block.
     1260           end.
     1261         end.
     1262       end.
     1263       if p-move-resize
     1264       then do:
     1265         run diasize_position-resize-button in this-procedure .
     1266       end.
     1267       if v-diasize-wndstore = true
     1268       then do:
     1269         if connected("ub") = true
     1270         then do:
     1271           define variable v-cntxt-db-num        as integer   no-undo .
     1272           define variable v-cntxt-userid        as character no-undo .
     1273           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1274                                             , OUTPUT v-cntxt-userid
     1275                                             ) .
     1276           run gbl/wndsizew.p
     1277             (input  v-cntxt-db-num
     1278             ,input  v-cntxt-userid
     1279             ,input  v-diasize-proc-name
     1280             ,input  'width':u
     1281             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1282             ) .
     1283         end.
     1284       end.
     1285     end.
     1286     assign
     1287       v-diasize-change-size = false
     1288     .
     1289   end procedure.
     1290   procedure diasize_set-width :
     1291     define input  parameter p-new-width  as decimal   no-undo .
     1292     define input  parameter p-move-resize as logical   no-undo .
     1293     do
     1294     on error undo, return error return-value
     1295     :
     1296       run diasize_change-width in this-procedure
     1297         (input  (p-new-width - frame Dialog-Frame :width)
     1298         ,input  p-move-resize
     1299         ) .
     1300     end.
     1301   end procedure.
     1302   procedure diasize_position-resize-button :
     1303     do with frame Dialog-Frame
     1304     :
     1305       hide v-diasize-resize-button .
     1306       assign
     1307         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1308                     - 1
     1309                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1310         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1311                     - 1
     1312                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1313       .
     1314       view v-diasize-resize-button .
     1315     end.
     1316   end procedure.
     1317   on alt-right anywhere
     1318   do:
     1319     run diasize_change-width in this-procedure
     1320       (input 1
     1321       ,input true
     1322       ) .
     1323     return no-apply .
     1324   end.
     1325   on alt-left anywhere
     1326   do:
     1327     run diasize_change-width in this-procedure
     1328       (input -1
     1329       ,input true
     1330       ) .
     1331     return no-apply .
     1332   end.
     1333   on alt-down anywhere
     1334   do:
     1335     run diasize_change-height in this-procedure
     1336       (input 1
     1337       ,input true
     1338       ) .
     1339     return no-apply .
     1340   end.
     1341   on alt-up anywhere
     1342   do:
     1343     run diasize_change-height in this-procedure
     1344       (input -1
     1345       ,input true
     1346       ) .
     1347     return no-apply .
     1348   end.
     1349   on alt-enter of frame Dialog-Frame
     1350   do:
     1351     run diasize_maximize in this-procedure
     1352       (input  ?
     1353       ).
     1354     return no-apply .
     1355   end.
     1356   procedure diasize_end-move :
     1357     do
     1358     on error undo, return error return-value
     1359     :
     1360       define variable v-row-delta as decimal   no-undo .
     1361       define variable v-col-delta as decimal   no-undo .
     1362       define variable v-new-row as decimal   no-undo .
     1363       define variable v-new-col as decimal   no-undo .
     1364       assign
     1365         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1366         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1367       .
     1368       assign
     1369         v-row-delta = v-new-row - frame Dialog-Frame :height
     1370         v-col-delta = v-new-col - frame Dialog-Frame :width
     1371       .
     1372       run diasize_change-height in this-procedure
     1373         (input v-row-delta
     1374         ,input true
     1375         ) .
     1376       run diasize_change-width in this-procedure
     1377         (input v-col-delta
     1378         ,input true
     1379         ) .
     1380     end.
     1381   end procedure.
     1382   procedure diasize_maximize :
     1383     define input  parameter p-action as logical   no-undo .
     1384     do
     1385     on error undo, return error return-value
     1386     :
     1387       if p-action = ?
     1388       then do:
     1389         if v-diasize-need-maximize = true
     1390         then do:
     1391           assign
     1392             p-action = true
     1393           .
     1394         end.
     1395         else do:
     1396           assign
     1397             p-action = false
     1398           .
     1399         end.
     1400       end.
     1401       if p-action = true
     1402       then do:
     1403         run diasize_change-height in this-procedure
     1404           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1405               - frame Dialog-Frame :height-chars
     1406           ,input true
     1407           ) .
     1408         run diasize_change-width in this-procedure
     1409           (input session :width-chars
     1410               - frame Dialog-Frame :width-chars
     1411           ,input true
     1412           ) .
     1413         assign
     1414           v-diasize-need-maximize = false
     1415         .
     1416       end.
     1417       else do:
     1418         run diasize_change-width in this-procedure
     1419           (input v-diasize-orig-frame-width
     1420               - frame Dialog-Frame :width-chars
     1421           ,input true
     1422           ) .
     1423         run diasize_change-height in this-procedure
     1424           (input v-diasize-orig-frame-height
     1425               - frame Dialog-Frame :height-chars
     1426           ,input true
     1427           ) .
     1428         assign
     1429           v-diasize-need-maximize = true
     1430         .
     1431       end.
     1432     end.
     1433   end procedure.
     1434   procedure diasize_restore-orig-size :
     1435     do
     1436     on error undo, return error return-value
     1437     :
     1438       assign
     1439         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1440         v-diasize-current-frame-height = frame Dialog-Frame :height
     1441       .
     1442       run diasize_set-height in this-procedure
     1443         (input  v-diasize-orig-frame-height
     1444         ,input  true
     1445         ) .
     1446       run diasize_set-width in this-procedure
     1447         (input  v-diasize-orig-frame-width
     1448         ,input  true
     1449         ) .
     1450     end.
     1451   end procedure.
     1452   procedure diasize_restore-current-size :
     1453     do
     1454     on error undo, return error return-value
     1455     :
     1456       run diasize_set-height in this-procedure
     1457         (input  v-diasize-current-frame-height
     1458         ,input  true
     1459         ) .
     1460       run diasize_set-width in this-procedure
     1461         (input  v-diasize-current-frame-width
     1462         ,input  true
     1463         ) .
     1464     end.
     1465   end procedure.
     1466   procedure diasize_set-browse-handle :
     1467     define input  parameter p-browse-handle as handle   no-undo .
     1468     define buffer buf_temp-browse-handle for temp-browse-handle .
     1469     do
     1470     on error undo, return error return-value
     1471     :
     1472       assign
     1473         v-diasize-browse-handle = p-browse-handle
     1474       .
     1475       for each buf_temp-browse-handle
     1476       on error undo, return error return-value
     1477       :
     1478         delete buf_temp-browse-handle .
     1479       end.
     1480     end.
     1481   end procedure.
     1482   procedure diasize_add_browse :
     1483     define input  parameter p-browse-type   as character no-undo .
     1484     define input  parameter p-browse-handle as handle    no-undo .
     1485     define buffer buf_temp-browse-handle for temp-browse-handle .
     1486     do
     1487     on error undo, return error return-value
     1488     :
     1489       assign
     1490         v-diasize-browse-number = v-diasize-browse-number + 1
     1491       .
     1492       create buf_temp-browse-handle .
     1493       assign
     1494         buf_temp-browse-handle.browse-type   = p-browse-type
     1495         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1496         buf_temp-browse-handle.browse-handle = p-browse-handle
     1497       .
     1498     end.
     1499   end procedure.
     1500   procedure diasize_init :
     1501     define variable v-default-value    as logical   no-undo .
     1502     define variable v-restore-saved    as logical   no-undo .
     1503     define variable v-resize-value-str as character no-undo .
     1504     do
     1505     on error undo, return error return-value
     1506     :
     1507       do with frame Dialog-Frame
     1508       :
     1509         assign
     1510           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1511           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1512           v-diasize-browse-handle     = browse br-table :handle
     1513         .
     1514         create button v-diasize-resize-button
     1515         assign
     1516           parent        = frame Dialog-Frame :first-child
     1517           label         = "s"
     1518           height-pixels = 16
     1519           width-pixels  = 16
     1520           visible       = true
     1521           sensitive     = true
     1522           movable       = true
     1523           triggers:
     1524             on end-move persistent run diasize_end-move in this-procedure .
     1525           end triggers.
     1526         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1527         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1528         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1529         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1530         assign
     1531           v-diasize-wndmax = false
     1532         .
     1533         if connected("ub") = true
     1534         then do:
     1535           define variable v-cntxt-db-num        as integer   no-undo .
     1536           define variable v-cntxt-userid        as character no-undo .
     1537           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1538                                             , OUTPUT v-cntxt-userid
     1539                                             ) .
     1540           run gbl/wndpar_r.p
     1541             (input  v-cntxt-db-num
     1542             ,input  v-cntxt-userid
     1543             ,input  'wndmax':U
     1544             ,output v-diasize-wndmax
     1545             ,output v-default-value
     1546             ) .
     1547         end.
     1548         assign
     1549           v-diasize-wndstore = false
     1550         .
     1551         if connected("ub") = true
     1552         then do:
     1553           run gbl/wndpar_r.p
     1554             (input  v-cntxt-db-num
     1555             ,input  v-cntxt-userid
     1556             ,input  'wndstore':U
     1557             ,output v-diasize-wndstore
     1558             ,output v-default-value
     1559             ) .
     1560         end.
     1561         assign
     1562           v-diasize-proc-name = entry(1, program-name(2), '.')
     1563         .
     1564         if v-diasize-wndstore = true
     1565         then do:
     1566           assign
     1567             v-restore-saved = false
     1568           .
     1569           if connected("ub") = true
     1570           then do:
     1571             run gbl/wndsizer.p
     1572               (input  v-cntxt-db-num
     1573               ,input  v-cntxt-userid
     1574               ,input  v-diasize-proc-name
     1575               ,input  'height':u
     1576               ,output v-resize-value-str
     1577               ) .
     1578             if v-resize-value-str <> '':U
     1579             then do:
     1580               run diasize_change-height in this-procedure
     1581                 (input  integer(v-resize-value-str)
     1582                 ,input  true
     1583                 ) .
     1584               assign
     1585                 v-restore-saved = true
     1586               .
     1587             end.
     1588           end.
     1589           if connected("ub") = true
     1590           then do:
     1591             run gbl/wndsizer.p
     1592               (input  v-cntxt-db-num
     1593               ,input  v-cntxt-userid
     1594               ,input  v-diasize-proc-name
     1595               ,input  'width':u
     1596               ,output v-resize-value-str
     1597               ) .
     1598             if v-resize-value-str <> '':U
     1599             then do:
     1600               run diasize_change-width in this-procedure
     1601                 (input  integer(v-resize-value-str)
     1602                 ,input  true
     1603                 ) .
     1604               assign
     1605                 v-restore-saved = true
     1606               .
     1607             end.
     1608           end.
     1609           if v-restore-saved <> true
     1610           then do:
     1611             if v-diasize-wndmax = true
     1612             then do:
     1613               run diasize_maximize in this-procedure
     1614                 (input  true
     1615                 ) .
     1616             end.
     1617           end.
     1618         end.
     1619         else do:
     1620           if v-diasize-wndmax = true
     1621           then do:
     1622             run diasize_maximize in this-procedure
     1623               (input  true
     1624               ) .
     1625           end.
     1626         end.
     1627       end.
     1628     end.
     1629   end procedure.
     1630   procedure diasize_need-full-display :
     1631     define output parameter p-need-full-display as logical   no-undo .
     1632     do
     1633     on error undo, return error return-value
     1634     :
     1635       assign
     1636         p-need-full-display = v-diasize-need-full-display
     1637       .
     1638       assign
     1639         v-diasize-need-full-display = false
     1640       .
     1641     end.
     1642   end procedure.
     1643   procedure get-context :
     1644      define output parameter p-db-num as integer          no-undo.
     1645      define output parameter p-user-id as character        no-undo.
     1646      define variable v-login               as character    no-undo.
     1647      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1648      define buffer buf_user-login  for ub.user-login .
     1649      do
     1650      on error undo, return error
     1651      :
     1652            FIND FIRST buf_sys-ctrl no-lock.
     1653            ASSIGN
     1654               v-login = USERID("ub")
     1655               p-db-num = buf_sys-ctrl.db-num
     1656            .
     1657            FIND FIRST buf_user-login
     1658                 WHERE buf_user-login.db-num = p-db-num
     1659                   AND buf_user-login.user-login = v-login
     1660                 no-lock
     1661                 no-error
     1662                 .
     1663            IF AVAILABLE buf_user-login
     1664            THEN DO:
     1665               assign
     1666                  p-user-id = buf_user-login.user-id
     1667               .
     1668            END.
     1669      end.
     1670   end procedure.
     1671       run diasize_init in this-procedure .
     1672   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1673   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1674   MAIN-BLOCK:
     1675   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1676      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1677       run init-fields in this-procedure.
     1678       RUN enable_UI.
     1679       run ui-disable-all in this-procedure.
     1680       run ui-enable in this-procedure.
     1681       apply "value-changed" to br-table.
     1682       apply "entry" to br-table.
     1683     WAIT-FOR GO OF FRAME Dialog-Frame.
     1684   END.
     1685   RUN disable_UI.
     1686   PROCEDURE disable_UI :
     1687     HIDE FRAME Dialog-Frame.
     1688   END PROCEDURE.
     1689   PROCEDURE enable_UI :
     1690     DISPLAY ed-desc
     1691         WITH FRAME Dialog-Frame.
     1692     ENABLE b-exit b-help br-table ed-desc
     1693         WITH FRAME Dialog-Frame.
     1694     VIEW FRAME Dialog-Frame.
     1695     run local-open-query in this-procedure .
     1696   END PROCEDURE.
     1697   PROCEDURE init-fields :
     1698   do
     1699   on error undo, return error
     1700   :
     1701   end.
     1702   END PROCEDURE.
     1703   PROCEDURE local-open-query :
     1704       open query br-table
     1705           for each buf_init_datatype-exp no-lock
     1706       .
     1707    END PROCEDURE.
     1708   PROCEDURE reposition-to-recid :
     1709   define input parameter p-datatype-exp-recid  as recid        no-undo.
     1710   do
     1711   on error undo, return error
     1712   :
     1713       if p-datatype-exp-recid <> ?
     1714       then do:
     1715           reposition br-table to recid p-datatype-exp-recid no-error .
     1716       end.
     1717       do with frame Dialog-Frame
     1718       :
     1719           apply "entry":u to browse br-table .
     1720       end.
     1721   end.
     1722   END PROCEDURE.
     1723   PROCEDURE ui-disable-all :
     1724   do
     1725   with frame Dialog-Frame
     1726   on error undo, return error
     1727   :
     1728       disable
     1729           b-sel
     1730           b-select
     1731       with frame Dialog-Frame .
     1732   end.
     1733   END PROCEDURE.
     1734   PROCEDURE ui-enable :
     1735       define buffer buf_clients       for ub.clients.
     1736   do
     1737   for buf_clients
     1738   with frame Dialog-Frame
     1739   on error undo, return error
     1740   :
     1741       if p-mode = 1
     1742       then do:
     1743           enable
     1744               b-sel
     1745               b-select
     1746           with frame Dialog-Frame .
     1747       end.
     1748   end.
     1749   END PROCEDURE.
