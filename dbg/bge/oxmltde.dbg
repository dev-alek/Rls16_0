      607               .
      608               if v-object-handle <> v-diasize-resize-button
      609               then do:
      610                 assign
      611                   v-object-handle :row = buf_temp-diasize-handle.save-position
      612                 .
      613               end.
      614             end.
      615             assign
      616               v-diasize-browse-handle :height = v-browse-height
      617             .
      618             for each buf_temp-browse-handle
      619               where buf_temp-browse-handle.browse-type = 'height':u
      620             on error undo, next
      621             :
      622               assign
      623                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      624               .
      625             end.
      626             assign
      627               frame Dialog-Frame :height = v-frame-height
      628             .
      629             if frame Dialog-Frame :scrollable = true
      630             then do:
      631               assign
      632                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      633               .
      634             end.
      635             run diasize_position-resize-button in this-procedure .
