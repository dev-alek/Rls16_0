      901     .
      902   end procedure.
      903   procedure diasize_set-height :
      904     define input  parameter p-new-height  as decimal   no-undo .
      905     define input  parameter p-move-resize as logical   no-undo .
      906     do
      907     on error undo, return error return-value
      908     :
      909       run diasize_change-height in this-procedure
      910         (input  (p-new-height - frame Dialog-Frame :height)
      911         ,input  p-move-resize
      912         ) .
      913     end.
      914   end procedure.
      915   procedure diasize_change-width :
      916     define input  parameter p-change-value as decimal   no-undo .
      917     define input  parameter p-move-resize  as logical   no-undo .
      918     define variable v-field-group-handle   as handle    no-undo .
      919     define variable v-object-handle        as handle    no-undo .
      920     define variable v-frame-width          as decimal   no-undo .
      921     define variable v-frame-virtual-width  as decimal   no-undo .
      922     define variable v-browse-width         as decimal   no-undo .
      923     define variable v-window-width         as decimal   no-undo .
      924     define variable v-window-virtual-width as decimal   no-undo .
      925     define variable v-change-sign          as integer   no-undo .
      926     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      927     define buffer buf_temp-browse-handle  for temp-browse-handle .
      928     if p-change-value > 0
      929     then do:
      930       if frame Dialog-Frame :width + p-change-value >
      931           session :width-chars
      932       then do:
      933         assign
      934           p-change-value = session :width-chars - frame Dialog-Frame :width
      935         .
      936         if p-change-value <= 0
      937         then do:
      938           run diasize_position-resize-button in this-procedure .
      939           return .
      940         end.
      941       end.
      942     end.
      943     if p-change-value < 0
      944     then do:
      945       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      946       then do:
      947         assign
      948           p-change-value = v-diasize-orig-frame-width
      949                          - frame Dialog-Frame :width
      950         .
      951         if p-change-value >= 0
      952         then do:
      953           run diasize_position-resize-button in this-procedure .
      954           return .
      955         end.
      956       end.
      957     end.
      958     if p-change-value >= 0
      959     then do:
      960       assign
      961         v-change-sign = 1
      962       .
      963     end.
      964     else do:
      965       assign
      966         v-change-sign = -1
      967       .
      968     end.
      969     assign
      970       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      971     .
      972     if p-change-value = 0
      973     then do:
      974       run diasize_position-resize-button in this-procedure .
      975       return .
      976     end.
