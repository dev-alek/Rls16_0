      718           and can-query(v-object-handle, "row")
      719           and can-query(v-object-handle, "height")
      720           and ( v-object-handle :row > v-diasize-browse-handle :row )
      721           then do:
      722             find first buf_temp-browse-handle
      723               where buf_temp-browse-handle.browse-type   = 'height':u
      724                 and buf_temp-browse-handle.browse-handle = v-object-handle
      725               no-error .
      726             if available buf_temp-browse-handle
      727             then do:
      728             end.
      729             else do:
      730               create buf_temp-diasize-handle .
      731               assign
      732                 buf_temp-diasize-handle.handle-value  = v-object-handle
      733                 buf_temp-diasize-handle.save-position = v-object-handle :row
      734               .
      735             end.
      736           end.
      737           assign
      738             v-object-handle = v-object-handle :next-sibling
      739           .
      740         end.
      741         assign
      742           v-field-group-handle = v-field-group-handle :next-sibling
      743         .
      744       end.
      745       do with frame Dialog-Frame
      746       :
      747         hide v-diasize-resize-button .
      748         assign
      749           v-diasize-resize-button :row    = 1
      750           v-diasize-resize-button :column = 1
      751         .
      752       end.
      753       if p-change-value > 0
