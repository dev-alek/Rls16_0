      887                                             , OUTPUT v-cntxt-userid
      888                                             ) .
      889           run gbl/wndsizew.p
      890             (input  v-cntxt-db-num
      891             ,input  v-cntxt-userid
      892             ,input  v-diasize-proc-name
      893             ,input  'height':u
      894             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      895             ) .
