     1282       define variable v-chk-pay-code              as logical      no-undo.
     1283       define variable v-pay-desk                  as logical      no-undo.
     1284       define variable v-opened-docs               as logical      no-undo.
     1285       define variable v-exp-doc                   as logical      no-undo.
     1286       define variable v-exp-ref                   as logical      no-undo.
     1287       define variable v-exp-day                   as logical      no-undo.
     1288       define variable v-exp-way                   as logical      no-undo.
     1289       define variable v-exp-ref-ext               as logical      no-undo.
     1290       define variable v-exp-stk                   as logical      no-undo.
     1291       define variable v-exp-stk-supp              as logical      no-undo.
     1292       define variable v-incr                      as logical      no-undo.
     1293       define variable v-exp-checks                as logical      no-undo.
     1294       define variable v-exp-doc-rvs               as logical      no-undo.
     1295       define variable v-exp-fo                    as logical      no-undo.
     1296       define variable v-exp-fp                    as logical      no-undo.
     1297       define variable v-exp-s-f                   as logical      no-undo.
     1298       define variable v-range                     as integer      no-undo.
     1299       define variable v-initial-range             as integer      no-undo.
     1300       define variable v-host-code                 as integer      no-undo.
     1301       define variable v-par-value         as character    no-undo.
     1302       define variable v-par-type          as character    no-undo.
     1303       define variable v-shift-mode-on     as logical      no-undo.
     1304       define variable v-bgeflold          as character    no-undo.
     1305       define variable v-value-character as character  no-undo .
     1306       define variable v-value-date      as date       no-undo .
     1307       define variable v-value-decimal   as decimal    no-undo .
     1308       define variable v-value-integer   as integer    no-undo .
     1309       define variable v-value-logical   as logical    no-undo .
     1310       define variable v-tth             as handle     no-undo .
     1311   do
     1312   on error undo, return error
     1313   :
     1314       run adm/lockshda.p ( input p-cre-db-num
     1315                          , input p-task-type
     1316                          , input p-task-num
     1317                          , input 'schedule-param-list':U
     1318                          , buffer lck_schedule-attr
     1319                          ) no-error .
     1320       if error-status :error = yes
     1321       then do:
     1322         run write-to-log( vss-workfile + chr(32)
     1323                         + "Другая сессия уже работает с этим расписанием..." + chr(10)
     1324                         + error-status:get-message(error-status:num-messages)
     1325                         + return-value
     1326                         ) .
     1327         return .
     1328       end.
     1329       run adm/shattri.p ( input "get":U
     1330                         , input  '':u
     1331                         , input  0
     1332                         , input  'bge-export':U
     1333                         , input  'bgeshift':U
     1334                         , output v-value-character
     1335                         , output v-value-date
     1336                         , output v-value-decimal
     1337                         , output v-value-integer
     1338                         , output v-value-logical
     1339                         , output v-param-type
     1340                         , input-output table-handle v-tth
     1341                         ) no-error .
     1342       if error-status :error
     1343       then do:
     1344         assign
     1345             v-shift-mode-on = no
     1346         .
     1347       end.
     1348       else do:
     1349         assign
     1350             v-shift-mode-on = ( v-value-character = "distinct":U )
     1351         .
     1352       end.
     1353       delete object v-tth.
     1354       run adm/shattri.p ( input "get":U
     1355                         , input  '':u
     1356                         , input  0
     1357                         , input  'bge-export':U
     1358                         , input  'bgeflold':U
     1359                         , output v-value-character
     1360                         , output v-value-date
     1361                         , output v-value-decimal
     1362                         , output v-value-integer
     1363                         , output v-value-logical
     1364                         , output v-param-type
     1365                         , input-output table-handle v-tth
     1366                         ) no-error .
     1367       if error-status :error
     1368       then do:
     1369         assign
     1370           v-bgeflold  = "old":U
     1371         .
     1372       end.
     1373       else do:
     1374         assign
     1375           v-bgeflold  = v-value-character
     1376         .
     1377       end.
     1378       delete object v-tth.
     1379       run gbl/set-gbl.p (
     1380             input true
     1381           , input g#auto-user-id
     1382           , input g#auto-user-password
     1383       ) no-error .
     1384       if error-status :error
     1385       then do:
     1386           run write-to-log( vss-workfile + chr(32)
     1387                           + "Ошибка при инициализации переменных g#..." + chr(10)
     1388                           + error-status:get-message(error-status:num-messages)
     1389                           + return-value
     1390                           ) .
     1391           return error.
     1392       end.
     1393       do :
     1394       run schedule-attr-value in this-procedure (
     1395             input p-cre-db-num
     1396           , input p-task-type
     1397           , input p-task-num
     1398           , input 'schedule-param-list':U
     1399           , output v-param-list
     1400           , output v-param-type
     1401       ).
     1402       assign
     1403           v-range = integer( entry( 1,  v-param-list ) )
     1404       .
     1405       if v-range = 2
     1406       then do:
     1407           if num-entries( v-param-list ) > 14
     1408           then do:
     1409               assign
     1410                   v-host-code = integer( entry( 15,  v-param-list ) )
     1411               .
     1412           end.
     1413           else do:
     1414               assign
     1415                   v-host-code = -1
     1416               .
     1417               run write-to-log in this-procedure (
     1418                   input vss-workfile + chr(32) + " Не удалось определить код фирмы для выгрузки по объектам."
     1419               ).
     1420           end.
     1421       end.
     1422       run schedule-attr-extract-logical in this-procedure (
     1423             input 2
     1424           , input v-param-list
     1425           , output v-pay-code
     1426       ).
     1427       run schedule-attr-extract-logical in this-procedure (
     1428             input 3
     1429           , input v-param-list
     1430           , output v-cst
     1431       ).
     1432       run schedule-attr-extract-logical in this-procedure (
     1433             input 4
     1434           , input v-param-list
     1435           , output v-opened-docs
     1436       ).
     1437       run schedule-attr-extract-logical in this-procedure (
     1438             input 6
     1439           , input v-param-list
     1440           , output v-parts
     1441       ).
     1442       run schedule-attr-extract-logical in this-procedure (
     1443             input 7
     1444           , input v-param-list
     1445           , output v-chk-pay-code
     1446       ).
     1447       run schedule-attr-extract-logical in this-procedure (
     1448             input 8
     1449           , input v-param-list
     1450           , output v-exp-doc
     1451       ).
     1452       run schedule-attr-extract-logical in this-procedure (
     1453             input 9
     1454           , input v-param-list
     1455           , output v-exp-ref
     1456       ).
     1457       run schedule-attr-extract-logical in this-procedure (
     1458             input 10
     1459           , input v-param-list
     1460           , output v-exp-day
     1461       ).
     1462       run schedule-attr-extract-logical in this-procedure (
     1463             input 11
     1464           , input v-param-list
     1465           , output v-exp-way
     1466       ).
     1467       run schedule-attr-extract-logical in this-procedure (
     1468             input 12
     1469           , input v-param-list
     1470           , output v-exp-ref-ext
     1471       ).
     1472       run schedule-attr-extract-logical in this-procedure (
     1473             input 13
     1474           , input v-param-list
     1475           , output v-exp-stk
     1476       ).
     1477       run schedule-attr-extract-logical in this-procedure (
     1478             input 14
     1479           , input v-param-list
     1480           , output v-exp-stk-supp
     1481       ).
     1482       run schedule-attr-extract-logical in this-procedure (
     1483             input 16
     1484           , input v-param-list
     1485           , output v-pay-desk
     1486       ).
     1487       run schedule-attr-extract-logical in this-procedure (
     1488             input 17
     1489           , input v-param-list
     1490           , output v-incr
     1491       ).
     1492       run schedule-attr-extract-logical in this-procedure (
     1493             input 18
     1494           , input v-param-list
     1495           , output v-exp-checks
     1496       ).
     1497       run schedule-attr-extract-logical in this-procedure (
     1498             input 19
     1499           , input v-param-list
     1500           , output v-exp-fo
     1501       ).
     1502       run schedule-attr-extract-logical in this-procedure (
     1503             input 20
     1504           , input v-param-list
     1505           , output v-exp-fp
     1506       ).
     1507       run schedule-attr-extract-logical in this-procedure (
     1508             input 22
     1509           , input v-param-list
     1510           , output v-exp-s-f
     1511       ).
     1512       run schedule-attr-extract-logical in this-procedure (
     1513             input 23
     1514           , input v-param-list
     1515           , output v-exp-doc-rvs
     1516       ).
     1517       end .
     1518       if v-incr = no
     1519       then do:
     1520           if v-exp-doc = yes
     1521           or v-exp-fp = yes
     1522           then do:
     1523               run schedule-attr-value in this-procedure (
     1524                   input p-cre-db-num
     1525                   , input p-task-type
     1526                   , input p-task-num
     1527                   , input 'schedule-doc-type-list':U
     1528                   , output v-doc-type-list
     1529                   , output v-param-type
     1530               ).
     1531           end.
     1532           if v-exp-doc = yes
     1533           or v-exp-stk = yes
     1534           or v-exp-day = yes
     1535           or v-exp-fo  = yes
     1536           or v-exp-fp  = yes
     1537           or v-exp-s-f = yes
     1538           then do:
     1539               run schedule-attr-value in  this-procedure (
     1540                   input p-cre-db-num
     1541                   , input p-task-type
     1542                   , input p-task-num
     1543                   , input 'schedule-date-list':U
     1544                   , output v-date-range
     1545                   , output v-param-type
     1546               ).
     1547               run analyze-date-range in this-procedure (
     1548                     input v-date-range
     1549                   , output v-date-from
     1550                   , output v-date-to
     1551               ) no-error.
     1552               if error-status :error
     1553               or v-date-from  = ?
     1554               or v-date-to    = ?
     1555               then do:
     1556                   run write-to-log( vss-workfile + chr(32)
     1557                                   + substitute( " Ошибка выгрузки по расписанию. Не удалось определить интервал дат для выгрузки." + chr(10) + "&1" + chr(10) + "&2" + chr(10) + "&3"
     1558                                                   , return-value
     1559                                                   , error-status :get-message( 0 )
     1560                                                   , error-status :get-message( 1 )
     1561                                               )
     1562                                   ) .
     1563                   undo, return error .
     1564               end.
     1565           end.
     1566       end.
     1567       if v-exp-doc = yes
     1568       or v-exp-day = yes
     1569       or v-exp-way = yes
     1570       or v-exp-stk = yes
     1571       or v-exp-fo  = yes
     1572       or v-exp-fp  = yes
     1573       or v-exp-s-f = yes
     1574       then do:
     1575           assign
     1576               v-initial-range = v-range
     1577           .
     1578           run fill-obj-list in this-procedure (
     1579                 input v-initial-range
     1580               , input v-host-code
     1581               , output v-range
     1582               , output v-obj-list
     1583           ).
     1584           if v-obj-list = ""
     1585           or v-range <> 3
     1586           then do:
     1587               run write-to-log( vss-workfile + chr(32)
     1588                               + substitute( " Нет объектов для выгрузки или неверно задан тип выгрузки."
     1589                                               + chr(10) + "    Номер базы данных:                   &1"
     1590                                               + chr(10) + "    Задан список объектов:               &2"
     1591                                               + chr(10) + "    Тип выгрузки (допускается только 3): &3"
     1592                                               , p-db-num
     1593                                               , v-obj-list
     1594                                               , v-range
     1595                                           )
     1596                               ) .
     1597               undo, return error .
     1598           end.
     1599       end.
     1600       if v-incr = no
     1601       then do:
     1602           run write-to-log ( vss-workfile + chr(32) + " Выгрузка по расписанию. Флаг инкрементальной выгрузки выключен." ) .
     1603           if v-exp-doc = yes
     1604           then do:
     1605               if v-shift-mode-on = yes
     1606               then do:
     1607                   run bge/shd-doch.p (
     1608                         input p-db-num
     1609                       , input v-date-from
     1610                       , input v-date-to
     1611                       , input v-range
     1612                       , input v-obj-list
     1613                       , input cross-list(v-doc-type-list, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U, chr(44))
     1614                       , input v-pay-code
     1615                       , input v-cst
     1616                       , input v-parts
     1617                       , input v-chk-pay-code
     1618                       , input v-pay-desk
     1619                       , input no
     1620                       , input v-opened-docs
     1621                       , input v-exp-doc-rvs
     1622                       , input ?
     1623                       , input ?
     1624                   ) no-error.
     1625                   if error-status :error
     1626                   then do:
     1627                       run write-to-log( vss-workfile + chr(32)
     1628                                       + substitute( " Ошибка выгрузки документов по расписанию. &1 "
     1629                                                       , return-value
     1630                                                   )
     1631                                       ) .
     1632                   end.
     1633               end.
     1634               else do:
     1635                   if v-bgeflold = "firm":U
     1636                   then do:
     1637                       run bge/shd-docf.p (
     1638                             input p-db-num
     1639                           , input v-date-from
     1640                           , input v-date-to
     1641                           , input v-range
     1642                           , input v-obj-list
     1643                           , input cross-list(v-doc-type-list, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U, chr(44))
     1644                           , input v-pay-code
     1645                           , input v-cst
     1646                           , input v-parts
     1647                           , input v-chk-pay-code
     1648                           , input v-pay-desk
     1649                           , input no
     1650                           , input v-opened-docs
     1651                           , input v-exp-doc-rvs
     1652                           , input ?
