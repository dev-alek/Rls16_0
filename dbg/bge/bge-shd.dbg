     1659                                                           , return-value
     1660                                                       )
     1661                                           ) .
     1662                       end.
     1663                   end.
     1664                   else do:
     1665                       run bge/shd-docs.p (
     1666                             input p-db-num
     1667                           , input v-date-from
     1668                           , input v-date-to
     1669                           , input v-range
     1670                           , input v-obj-list
     1671                           , input cross-list(v-doc-type-list, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U, chr(44))
     1672                           , input v-pay-code
     1673                           , input v-cst
     1674                           , input v-parts
     1675                           , input v-chk-pay-code
     1676                           , input v-pay-desk
     1677                           , input no
     1678                           , input v-opened-docs
     1679                           , input v-exp-doc-rvs
     1680                           , input ?
     1681                           , input ?
     1682                       ) no-error.
     1683                       if error-status :error
     1684                       then do:
     1685                           run write-to-log( vss-workfile + chr(32)
     1686                                           + substitute( " Ошибка выгрузки документов по расписанию. &1 "
     1687                                                           , return-value
     1688                                                       )
     1689                                           ) .
     1690                       end.
     1691                   end.
     1692               end.
     1693           end.
     1694           if v-exp-ref = yes
     1695           then do:
     1696               if v-exp-ref-ext = yes
     1697               then do:
     1698                   run bge/bge-ref.p (
     1699                         input ?
     1700                       , input "good-ext"
     1701                       , input yes
     1702                       , input v-host-code
     1703                       , input ?
     1704                       , input ?
     1705                   ) no-error.
     1706               end.
     1707               else do:
     1708                   run bge/bge-ref.p (
     1709                         input ?
     1710                       , input ""
     1711                       , input yes
     1712                       , input v-host-code
     1713                       , input ?
     1714                       , input ?
     1715                   ) no-error.
     1716               end.
     1717               if error-status :error
     1718               then do:
     1719                   run write-to-log( vss-workfile + chr(32)
     1720                                   + substitute( " Ошибка выгрузки справочников по расписанию. &1 "
     1721                                                   , return-value
     1722                                               )
     1723                                   ) .
     1724               end.
     1725           end.
     1726           if v-exp-day = yes
     1727           then do:
     1728               run bge/bge-day.p (
     1729                     input ?
     1730                   , input v-date-from
     1731                   , input v-date-to
     1732                   , input v-range
     1733                   , input v-obj-list
     1734                   , input 0
     1735                   , input yes
     1736                   , input ?
     1737                   , input ?
     1738               ) no-error.
     1739               if error-status :error
     1740               then do:
     1741                   run write-to-log( vss-workfile + chr(32)
     1742                                   + substitute( " Ошибка выгрузки товаров по дням по расписанию. &1 "
     1743                                                   , return-value
     1744                                               )
     1745                                   ) .
     1746               end.
     1747           end.
     1748           if v-exp-way = yes
     1749           then do:
     1750               run bge/bge-way.p (
     1751                   input -1
     1752                   , input yes
     1753                   , input p-db-num
     1754                   , input v-obj-list
     1755                   , input ?
     1756                   , input ?
     1757               ) no-error.
     1758               if error-status :error
     1759               then do:
     1760                   run write-to-log( vss-workfile + chr(32)
     1761                                   + substitute( " Ошибка выгрузки товаров в пути по расписанию. &1 "
     1762                                                   , return-value
     1763                                               )
     1764                                   ) .
     1765               end.
     1766           end.
     1767           if v-exp-stk = yes and entry(1,v-date-range) = '1' then do:
     1768                       run bge/bgestd.p (
     1769                             input ?
     1770                           , input -1
     1771                           , input 3
     1772                           , input v-obj-list
     1773                           , input v-date-to
     1774                           , input v-cst
     1775                           , input yes
     1776                           , input yes
     1777                           , input 0
     1778                           , input ?
     1779                           , input ?
     1780                       ).
     1781           end.
     1782           else if v-exp-stk = yes  then  do:
     1783              if v-exp-stk-supp = yes
     1784               then do:
     1785                   run bge/bge-stk.p (
     1786                         input ?
     1787                       , input -1
     1788                       , input v-date-from
     1789                       , input v-date-to
     1790                       , input yes
     1791                       , input yes
     1792                       , input p-db-num
     1793                       , input v-obj-list
     1794                       , input ?
     1795                       , input ?
     1796                   ) no-error.
     1797                   if error-status :error
     1798                   then do:
     1799                       run write-to-log( vss-workfile + chr(32)
     1800                                       + substitute( " Ошибка выгрузки остатков товаров по поставщикам по расписанию. &1 "
     1801                                                       , return-value
     1802                                                   )
     1803                                       ) .
     1804                   end.
     1805               end.
     1806               else do:
     1807                   run bge/bge-stk.p (
     1808                         input ?
     1809                       , input -1
     1810                       , input v-date-from
     1811                       , input v-date-to
     1812                       , input no
     1813                       , input yes
     1814                       , input p-db-num
     1815                       , input v-obj-list
     1816                       , input ?
     1817                       , input ?
     1818                   ) no-error.
     1819                   if error-status :error
     1820                   then do:
     1821                       run write-to-log( vss-workfile + chr(32)
     1822                                       + substitute( " Ошибка выгрузки остатков товаров по расписанию. &1 "
     1823                                                       , return-value
     1824                                                   )
     1825                                       ) .
     1826                   end.
     1827               end.
     1828           end.
     1829           if v-exp-fo = yes then do:
     1830               run bge/bgefo.p (
     1831                     input v-date-from
     1832                   , input v-date-to
     1833                   , input v-range
     1834                   , input v-obj-list
     1835                   , input ?
     1836                   , input ?
     1837                   ) no-error.
     1838                   if error-status :error
     1839                   then do:
     1840                       run write-to-log( vss-workfile + chr(32)
     1841                                       + substitute( " Ошибка выгрузки ФО по расписанию. &1 &2 "
     1842                                                       , return-value, error-status :get-message(1)
     1843                                                   )
     1844                                       ) .
     1845                   end.
     1846           end.
     1847           if v-exp-fp = yes then do:
     1848               run bge/bgefdoc.p (
     1849                     input v-date-from
     1850                   , input v-date-to
     1851                   , input v-initial-range
     1852                   , input "shd":U
     1853                   , input (if v-initial-range = 2 then v-host-code else 0)
     1854                   , input v-obj-list
     1855                   , input p-db-num
     1856                   , input cross-list(v-doc-type-list, 'пко,рко,ппп,рпп,апп,апр,':U, chr(44))
     1857                   , input ?
     1858                   , input ?
     1859               ) no-error.
     1860                   if error-status :error
     1861                   then do:
     1862                       run write-to-log( vss-workfile + chr(32)
     1863                                       + substitute( " Ошибка выгрузки платежных документов по расписанию. &1 &2 "
     1864                                                       , return-value, error-status :get-message(1)
     1865                                                   )
     1866                                       ) .
     1867                   end.
     1868           end.
     1869           if v-exp-s-f = yes then do:
     1870           end.
     1871       end.
     1872       else do:
     1873           run write-to-log ( vss-workfile + chr(32) + " Выгрузка по расписанию. Флаг инкрементальной выгрузки включен. " ) .
     1874           if v-exp-doc = yes
     1875           then do:
     1876               if v-shift-mode-on = yes
     1877               then do:
     1878                   v-obj-list-shift = "".
     1879                   v-obj-list-noshift = "".
     1880                   do v-obj-counter = 1 to num-entries (v-obj-list) / 2:
     1881                       assign
     1882                       v-obj-list-type = entry(v-obj-counter * 2 - 1, v-obj-list)
     1883                       v-obj-list-code = integer(entry(v-obj-counter * 2, v-obj-list)) no-error.
     1884                       if not can-find(first buf_shift-obj
     1885                           where buf_shift-obj.obj-type = v-obj-list-type
     1886                             and buf_shift-obj.obj-code = v-obj-list-code)
     1887                           then do:
     1888                               assign
     1889                               v-obj-list-noshift = v-obj-list-noshift + v-obj-list-type + ',' + string(v-obj-list-code) + ','.
     1890                       end.
     1891                       else do:
     1892                           assign
     1893                           v-obj-list-shift = v-obj-list-shift + v-obj-list-type + ',' + string(v-obj-list-code) + ','.
     1894                       end.
     1895                   end.
     1896                   if v-obj-list-shift <> "" then do:
     1897                   run bge/shd-inch.p (
     1898                         input p-db-num
     1899                       , input v-range
     1900                           , input v-obj-list-shift
     1901                           , input v-exp-checks
     1902                           , input v-exp-doc-rvs
     1903                       ) no-error.
     1904                       if error-status :error
     1905                       then do:
     1906                           run write-to-log ( vss-workfile + chr(32)
     1907                                           + substitute( " Ошибка выгрузки по расписанию. &1 "
     1908                                                           , return-value
     1909                                                       )
     1910                                           ) .
     1911                           undo, return error .
     1912                       end.
     1913                   end.
     1914                   if v-obj-list-noshift <> "" then do:
     1915                       run bge/shd-incr.p (
     1916                             input p-db-num
     1917                           , input v-range
     1918                           , input v-obj-list-noshift
     1919                           , input v-exp-checks
     1920                           , input v-exp-doc-rvs
     1921                       ) no-error.
     1922                       if error-status :error
     1923                       then do:
     1924                           run write-to-log ( vss-workfile + chr(32)
     1925                                           + substitute( " Ошибка выгрузки по расписанию. &1 "
     1926                                                           , return-value
     1927                                                       )
     1928                                           ) .
     1929                           undo, return error .
     1930                       end.
     1931                   end.
     1932               end.
     1933               else do:
     1934                   run bge/shd-incr.p (
     1935                         input p-db-num
     1936                       , input v-range
     1937                       , input v-obj-list
     1938                       , input v-exp-checks
     1939                       , input v-exp-doc-rvs
     1940                   ) no-error.
     1941                   if error-status :error
     1942                   then do:
     1943                       run write-to-log ( vss-workfile + chr(32)
     1944                                       + substitute( " Ошибка выгрузки по расписанию. &1 "
     1945                                                       , return-value
     1946                                                   )
     1947                                       ) .
     1948                       undo, return error .
     1949                   end.
     1950               end.
     1951           end.
     1952           if v-exp-ref = yes
     1953           then do:
     1954               run bge/bge-ref.p (
     1955                     input ?
     1956                   , input "good-ext"
     1957                   , input yes
     1958                   , input v-host-code
     1959                   , input ?
     1960                   , input ?
     1961               ) no-error.
     1962           end.
     1963           if v-exp-fp = yes
     1964           then do:
     1965               run bge/shfdincr.p (
     1966                     input p-db-num
     1967                   , input v-initial-range
     1968                   , input (if v-initial-range = 2 then v-host-code else 0)
     1969                   , input v-obj-list
     1970               ) no-error.
     1971               if error-status :error
     1972               then do:
     1973                   run write-to-log ( vss-workfile + chr(32)
     1974                                   + substitute( " Ошибка выгрузки по расписанию. &1 "
     1975                                                   , return-value
     1976                                               )
     1977                                   ) .
     1978                   undo, return error .
     1979               end.
     1980           end.
     1981           if v-exp-fo = yes
     1982           then do:
     1983               run bge/shfoincr.p (
     1984                     input p-db-num
     1985                   , input v-range
     1986                   , input v-obj-list
     1987               ) no-error.
     1988               if error-status :error
     1989               then do:
     1990                   run write-to-log ( vss-workfile + chr(32)
     1991                                   + substitute( " Ошибка выгрузки по расписанию ФО. &1 "
     1992                                                   , return-value
     1993                                               )
     1994                                   ) .
     1995                   undo, return error .
     1996               end.
     1997           end.
     1998       end.
     1999   end.
     2000   procedure analyze-date-range :
     2001   do
     2002   on error undo, return error
     2003   :
     2004   define input parameter p-date-range         as character    no-undo.
     2005   define output parameter p-date-from         as date         no-undo.
     2006   define output parameter p-date-to           as date         no-undo.
     2007       define variable v-today         as date      no-undo.
     2008       define variable v-time          as integer   no-undo.
     2009       define variable v-days-ago      as integer       no-undo.
     2010       define variable v-days-amount   as integer       no-undo.
     2011       run cur-time in this-procedure ( output v-today
     2012                                      , output v-time
     2013                                      ).
     2014       case entry( 1, p-date-range )
     2015       :
     2016           when "0":U
     2017           then do:
     2018               assign
     2019                   v-days-ago    = integer( entry( 3, p-date-range ) )
     2020                   v-days-amount = integer( entry( 2, p-date-range ) )
     2021               .
     2022               assign
     2023                   p-date-from = v-today - v-days-ago
     2024                   p-date-to   = v-today - v-days-ago + v-days-amount
     2025               .
     2026               if p-date-to > v-today
     2027               then do:
     2028                   assign
     2029                     p-date-to = v-today
     2030                   .
     2031               end.
     2032           end.
     2033           when "1":U
     2034           then do:
     2035               assign
     2036                   p-date-from = date( entry( 4, p-date-range ) )
     2037                   p-date-to   = v-today
     2038               .
     2039           end.
     2040           when "2":U
     2041           then do:
     2042               assign
     2043                   p-date-from = date( entry( 4, p-date-range ) )
     2044                   p-date-to   = date( entry( 5, p-date-range ) )
     2045               .
     2046           end.
     2047           otherwise do:
     2048               assign
     2049                   p-date-from = ?
     2050                   p-date-to   = ?
     2051               .
     2052           end.
     2053       end case.
     2054   end.
     2055   end procedure.
     2056   procedure fill-obj-list :
     2057   define input parameter p-range-in   as integer          no-undo.
     2058   define input parameter p-host-code  as integer          no-undo.
     2059   define output parameter p-range-out as integer          no-undo.
     2060   define output parameter p-obj-list  as character        no-undo.
     2061       define variable v-obj-counter               as integer      no-undo.
     2062       define buffer buf_clients   for ub.clients.
     2063   do
     2064   for buf_clients
     2065   on error undo, return error
     2066   :
     2067       if p-range-in = 2
     2068       and v-host-code = -1
     2069       then do:
     2070           assign
     2071               p-range-in = 1
     2072           .
     2073       end.
     2074       assign
     2075           p-range-out = p-range-in
     2076       .
     2077       run init-temphost.
     2078       case p-range-in
     2079       :
     2080           when 1
     2081           then do:
     2082               for each temp-obj
     2083               :
     2084                   if temp-obj.db-num = p-db-num
     2085                   then do:
     2086                       assign
     2087                           p-obj-list = p-obj-list
     2088                                           + ( if p-obj-list = "" then "" else "," )
     2089                                           + temp-obj.obj-type
     2090                                           + "," + string( temp-obj.obj-code )
     2091                       .
     2092                   end.
     2093               end.
     2094               assign
     2095                   p-range-out  = 3
     2096               .
     2097           end.
     2098           when 2
     2099           then do:
     2100               for each temp-obj
     2101               :
     2102                   if temp-obj.db-num = p-db-num
     2103                   and temp-obj.host-code = v-host-code
     2104                   then do:
     2105                       assign
     2106                           p-obj-list = p-obj-list
     2107                                           + ( if p-obj-list = "" then "" else "," )
     2108                                           + temp-obj.obj-type
     2109                                           + "," + string( temp-obj.obj-code )
     2110                       .
     2111                   end.
     2112               end.
     2113               assign
     2114                   p-range-out  = 3
     2115               .
     2116           end.
     2117           when 3
     2118           then do:
     2119               run schedule-attr-value in this-procedure (
     2120                     input p-cre-db-num
     2121                   , input p-task-type
     2122                   , input p-task-num
     2123                   , input 'schedule-obj-list':U
     2124                   , output v-temp-obj-list
     2125                   , output v-param-type
     2126               ).
     2127               do v-obj-counter = 1 to num-entries ( v-temp-obj-list ) / 2
     2128               :
     2129                   find first buf_clients no-lock
     2130                           where buf_clients.obj-type  = entry( v-obj-counter * 2 - 1, v-temp-obj-list )
     2131                           and buf_clients.obj-code = integer( entry( v-obj-counter * 2, v-temp-obj-list ) )
     2132                   no-error.
     2133                   if not available buf_clients
     2134                   then do:
     2135                       run write-to-log( vss-workfile + chr(32)
     2136                                       + substitute( " Ошибка выгрузки по расписанию: Не найден заданный объект &1 &2" + chr(10)
     2137                                                       , buf_clients.obj-type
     2138                                                       , buf_clients.obj-code
     2139                                                   )
     2140                                       ) .
     2141                       undo, return error .
     2142                   end.
     2143                   else do:
     2144                       if buf_clients.db-num = p-db-num
     2145                       then do:
     2146                           assign
     2147                               p-obj-list = p-obj-list
     2148                                               + ( if p-obj-list = "" then "" else "," )
     2149                                               + buf_clients.obj-type
     2150                                               + "," + string( buf_clients.obj-code )
     2151                           .
     2152                       end.
     2153                   end.
     2154               end.
     2155           end.
     2156       end case.
     2157   end.
     2158   end procedure.
