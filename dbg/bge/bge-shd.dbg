        1   block-level on error undo, throw.
        2   define input parameter p-cre-db-num as integer   no-undo .
        3   define input parameter p-task-type  as character no-undo .
        4   define input parameter p-task-num   as integer   no-undo .
        5   define input parameter p-db-num     as integer   no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: a61e6bb0c7e0, 2871, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
        8   define variable vss-date        as character no-undo init "$Date: Пн ноя 22 19:49:10 2021 +0300 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: bge-shd.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: bge/bge-shd.p $":U .
       11   define variable vss-description as character no-undo init "Экспорт по расписанию.".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   define  shared variable g#auto-pid           as integer   no-undo .
       83   define  shared variable conn-par             as character no-undo .
       84   define  shared variable g#auto-user-id       as character no-undo .
       85   define  shared variable g#auto-user-login    as character no-undo .
       86   define  shared variable g#auto-user-password as character no-undo .
       87   define  shared variable v-socket             as logical   no-undo .
       88   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89   define  shared variable auto-window-h     as handle    no-undo .
       90   define  shared variable auto-log-msg-h    as handle    no-undo .
       91   define  shared variable hand-log-msg-h    as handle    no-undo .
       92   define  shared variable log-file-name     as character no-undo initial ? .
       93   define  shared variable add-log-file-name as character no-undo initial ? .
       94   define  shared variable writelogvalue     as character no-undo initial ? .
       95   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       96   procedure cur-time :
       97      define output parameter p-today as date      no-undo .
       98      define output parameter p-time  as integer   no-undo .
       99     do
      100     on error undo, return error
      101     :
      102       define variable v-date1 as date      no-undo .
      103       define variable v-date2 as date      no-undo .
      104       define variable v-time  as integer   no-undo .
      105       assign
      106         v-date1 = today
      107         v-time  = time
      108         v-date2 = today
      109       .
      110       if v-date1 <> v-date2
      111       then do:
      112         assign
      113           v-date1 = today
      114           v-time  = v-time
      115         .
      116       end.
      117       assign
      118         p-today = v-date1
      119         p-time  = v-time
      120       .
      121     end.
      122   end.
      123   function cur-time-date returns character
      124   :
      125     return string(today, '99/99/9999':U) .
      126   end.
      127   function cur-time-mjd returns decimal
      128   :
      129     define variable v-date as date      no-undo .
      130     define variable v-time as integer   no-undo .
      131     run cur-time in this-procedure
      132       (output v-date
      133       ,output v-time
      134       ) .
      135     return integer(v-date) - 2400002 + (v-time / 86400) .
      136   end.
      137   function cur-time-get-ending-index returns integer
      138   (input p-number as integer
      139   )
      140   :
      141     if p-number < 0
      142     or p-number = ?
      143     then do:
      144       return 1 .
      145     end.
      146     define variable v-rest as integer   no-undo .
      147     assign
      148       p-number = p-number modulo 100
      149     .
      150     if p-number < 20
      151     then do:
      152       assign
      153         v-rest = p-number
      154       .
      155     end.
      156     else do:
      157       assign
      158         v-rest = p-number modulo 10
      159       .
      160     end.
      161     case v-rest :
      162       when 1
      163       then do:
      164         return 2 .
      165       end.
      166       when 2 or
      167       when 3 or
      168       when 4
      169       then do:
      170         return 3 .
      171       end.
      172       otherwise do:
      173         return 1 .
      174       end.
      175     end case .
      176   end.
      177   procedure cur-time-mjd-to-date :
      178      define input  parameter i-mjd-diff as decimal no-undo.
      179      define output parameter o-Date     as date    no-undo.
      180      define output parameter o-Time     as integer no-undo.
      181      define variable v-day-number as integer   no-undo .
      182      if    i-mjd-diff < 0
      183         or i-mjd-diff = ?
      184      then do:
      185         return "?" .
      186      end.
      187      assign
      188         v-day-number = truncate(i-mjd-diff,0).
      189         o-Date = date(v-day-number + 2400002).
      190         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      191     .
      192   end.
      193   function cur-time-mjd-to-string returns character
      194   (input p-mjd-diff as decimal
      195   )
      196   :
      197     define variable v-day-number as integer   no-undo .
      198     define variable v-seconds    as integer   no-undo .
      199     define variable v-hour       as integer   no-undo .
      200     define variable v-min        as integer   no-undo .
      201     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      202     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      203     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      204     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      205     if p-mjd-diff < 0
      206     or p-mjd-diff = ?
      207     then do:
      208       return "?" .
      209     end.
      210     assign
      211       v-day-number = integer(truncate(p-mjd-diff,0))
      212       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      213     .
      214     if v-seconds > 86400
      215     then do:
      216       assign
      217         v-seconds = 86400 - 1
      218       .
      219     end.
      220     if v-seconds < 0
      221     then do:
      222       assign
      223         v-seconds = 0
      224       .
      225     end.
      226     assign
      227       v-hour = truncate(v-seconds / 3600, 0)
      228     .
      229     assign
      230       v-seconds = v-seconds modulo 3600
      231     .
      232     assign
      233       v-min = truncate(v-seconds / 60, 0)
      234     .
      235     assign
      236       v-seconds = v-seconds modulo 60
      237     .
      238     return
      239         (if v-day-number <> 0
      240           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      241           else ""
      242         )
      243       + (if v-day-number <> 0 or v-hour <> 0
      244           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      245           else ""
      246         )
      247       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      248           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      249           else ""
      250         )
      251       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      252       .
      253   end.
      254   function cur-time-string returns character
      255   :
      256     define variable v-date as date      no-undo .
      257     define variable v-time as integer   no-undo .
      258     run cur-time in this-procedure
      259       (output v-date
      260       ,output v-time
      261       ) .
      262     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      263   end.
      264   function cur-time-string-sec returns character
      265   :
      266     define variable v-date as date      no-undo .
      267     define variable v-time as integer   no-undo .
      268     run cur-time in this-procedure
      269       (output v-date
      270       ,output v-time
      271       ) .
      272     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      273   end.
      274   function cur-time-custom  returns character
      275   (input p-prefix as character
      276   ,input p-date-format as character
      277   ,input p-delimiter as character
      278   ,input p-time-format as character
      279   ,input p-suffix as character
      280   )
      281   :
      282     define variable v-date as date      no-undo .
      283     define variable v-time as integer   no-undo .
      284     run cur-time in this-procedure
      285       (output v-date
      286       ,output v-time
      287       ) .
      288     return
      289       p-prefix
      290       + string(v-date, p-date-format)
      291       + p-delimiter
      292       + string(v-time, p-time-format)
      293       + p-suffix
      294       .
      295   end.
      296   function cur-time-print  returns character
      297   :
      298     define variable v-date as date      no-undo .
      299     define variable v-time as integer   no-undo .
      300     run cur-time in this-procedure
      301       (output v-date
      302       ,output v-time
      303       ) .
      304     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      305   end.
      306   function cur-time-datetime returns datetime
      307   :
      308     define variable v-char as character no-undo .
      309     define variable v-datetime as datetime no-undo .
      310     v-char = cur-time-string().
      311     v-datetime = datetime(v-char).
      312     return  v-datetime.
      313   end.
      314   function cur-time-string-msec returns character
      315   :
      316     define variable v-date as datetime  no-undo .
      317     v-date = now.
      318     return string(v-date) .
      319   end.
      320   define stream LogStream .
      321   define variable mNoTime as logical no-undo.
      322   procedure write-to-log-notime :
      323     define input param i-str as character no-undo .
      324     mNoTime = yes.
      325     run write-to-log (i-str).
      326     mNoTime = no.
      327   end.
      328   procedure write-to-log :
      329     define input param p-str as character no-undo .
      330     do
      331     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      332     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      333     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      334     :
      335       define variable log-res        as logical   no-undo .
      336       define variable v-jj           as integer   no-undo .
      337       if    mNoTime
      338          or writelogvalue eq "AsyncProc"
      339       then
      340          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      341       else
      342          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      343       if auto-log-msg-h <> ? then do:
      344         log-res = auto-log-msg-h:move-to-eof( ) .
      345         log-res = auto-log-msg-h:insert-string( p-str ).
      346       end.
      347       if hand-log-msg-h <> ? then do:
      348         log-res = hand-log-msg-h:move-to-eof( ) .
      349         log-res = hand-log-msg-h:insert-string( p-str ).
      350       end.
      351       assign
      352         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      353         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      354         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      355       .
      356       if add-log-file-name <> ? then do:
      357         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      358           run gbl/fileapnd.p
      359             ( input entry(v-jj, add-log-file-name, chr(1) )
      360             ,input p-str
      361             ,input 20
      362             ) no-error .
      363           if error-status:error then do:
      364             return error return-value .
      365           end.
      366         end.
      367       end.
      368       if writelogvalue eq "AsyncProc"
      369       then do:
      370          p-str = trim(p-str, (chr(13) + chr(10)) )
      371       .
      372          Publish "WriteLogAsunc" (p-str,yes).
      373       end.
      374       else if writelogvalue <> "yes" then do:
      375         run gbl/fileapnd.p
      376           ( input log-file-name
      377           ,input p-str
      378           ,input 20
      379           ) no-error .
      380         if error-status:error then do:
      381           return error return-value .
      382         end.
      383       end.
      384     end.
      385   end procedure.
      386   procedure write-to-screen :
      387     define input param p-str as character no-undo .
      388     do
      389     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      390     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      391     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      392     :
      393       define variable log-res as logical no-undo.
      394       assign
      395         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      396       .
      397       if auto-log-msg-h <> ?
      398       then do:
      399         log-res = auto-log-msg-h:move-to-eof( ) .
      400         log-res = auto-log-msg-h:insert-string( p-str ).
      401       end.
      402       if hand-log-msg-h <> ?
      403       then do:
      404         log-res = hand-log-msg-h:move-to-eof( ) .
      405         log-res = hand-log-msg-h:insert-string( p-str ).
      406       end.
      407     end.
      408   end procedure.
      409   procedure send-msg-to-email :
      410     define input  parameter p-subject      as character no-undo .
      411     define input  parameter p-text-err     as character no-undo .
      412     define input  parameter p-attach-files as character no-undo .
      413     do
      414     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      415     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      416     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      417     :
      418       define variable v-tth             as handle    no-undo .
      419       define variable v-value-character as character no-undo .
      420       define variable v-value-date      as date      no-undo .
      421       define variable v-value-decimal   as decimal   no-undo .
      422       define variable v-value-integer   as integer   no-undo .
      423       define variable v-value-logical   as logical   no-undo .
      424       define variable v-param-type      as character no-undo .
      425       define variable v-email       as character no-undo .
      426       define variable v-tmp-str     as character no-undo .
      427       define variable v-tmp1-str    as character no-undo .
      428       define variable v-ind         as integer   no-undo .
      429       define variable v-num-entries as integer   no-undo .
      430       delete object v-tth no-error.
      431       run adm/shattri.p
      432         ( input "get":U
      433          ,input  "":U
      434          ,input  0
      435          ,input  'auto-task':U
      436          ,input  'send-msg-to-email':U
      437          ,output v-value-character
      438          ,output v-value-date
      439          ,output v-value-decimal
      440          ,output v-value-integer
      441          ,output v-value-logical
      442          ,output v-param-type
      443          ,input-output table-handle v-tth
      444         ) no-error .
      445       if not error-status :error  then do:
      446         assign
      447           v-tmp-str = v-value-character
      448         .
      449       end.
      450       delete object v-tth no-error.
      451       assign
      452         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      453         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      454         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      455         v-num-entries = num-entries( v-tmp-str, chr(44) )
      456         v-email       = "":U
      457       .
      458       do v-ind = 1 to v-num-entries
      459       :
      460         assign
      461           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      462         .
      463         if trim( v-tmp1-str ) <> "":U then do:
      464           if v-email = "":U then do:
      465             assign
      466               v-email = v-tmp1-str
      467             .
      468           end.
      469           else do:
      470             assign
      471               v-email = v-email + chr(44) + v-tmp1-str
      472             .
      473           end.
      474         end.
      475       end.
      476       if v-email <> "":U then do:
      477         run gbl/sendmail.p
      478           ( input v-email
      479           , input p-subject
      480           , input p-text-err
      481           , input p-attach-files
      482           ) no-error .
      483         if error-status :error
      484           or return-value <> "":U
      485         then do:
      486           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      487         end.
      488       end.
      489     end.
      490   end procedure.
      491   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      492   define temp-table temp-schedule-free no-undo
      493   field free-id as character
      494   field free-task-name as character
      495   field proc-run-name as character
      496   field proc-param-edit-name as character
      497   field conf-param as character
      498   field is-gbd as logical
      499   field is-ubd as logical
      500   field enable-concurrent-0 as logical
      501   field enable-concurrent-db as logical
      502   field other-info as character
      503   field enc-key as character
      504   field is-rum as logical
      505   index pi is unique primary
      506   free-id.
      507   procedure schedule-attr-name :
      508   do
      509     on error undo, return error
      510     :
      511     define input  parameter p-code           as character no-undo .
      512     define output parameter p-type           as character no-undo .
      513     define output parameter p-format         as character no-undo .
      514     define output parameter p-label          as character no-undo .
      515     define output parameter p-user-can-edit  as logical   no-undo .
      516     define output parameter p-output-display as logical   no-undo .
      517     define output parameter p-other          as character no-undo .
      518       if index(p-code, chr(4)) > 0 then do:
      519         p-code = entry(1, p-code, chr(4)).
      520       end.
      521       case p-code :
      522               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      523               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      524               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      525               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      526               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      527               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      528               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      529               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      530               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      531         otherwise do:
      532           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      533         end.
      534       end.
      535     end.
      536   end procedure.
      537   procedure schedule-attr-tooltip :
      538   do
      539     on error undo, return error
      540     :
      541       define input  parameter p-code    as character no-undo .
      542       define output parameter p-tooltip as character no-undo .
      543       define output parameter p-label   as character no-undo .
      544       if index(p-code, chr(4)) > 0 then do:
      545         p-code = entry(1, p-code, chr(4)).
      546       end.
      547       case p-code :
      548               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      549               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      550               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      551               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      552               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      553               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      554               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      555               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      556               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      557         otherwise do:
      558               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      559         end.
      560       end.
      561     end.
      562   end procedure.
      563   procedure schedule-attr-value :
      564   do
      565   on error undo, return error return-value
      566   :
      567   define input parameter  p-cre-db-num as integer    no-undo.
      568   define input parameter  p-task-type  as character  no-undo.
      569   define input parameter  p-task-num   as integer    no-undo.
      570   define input parameter  p-code       as character  no-undo.
      571   define output parameter p-value      as character  no-undo.
      572   define output parameter p-type       as character  no-undo.
      573       define variable v-format         as character no-undo .
      574       define variable v-label          as character no-undo .
      575       define variable v-user-can-edit  as logical   no-undo .
      576       define variable v-output-display as logical   no-undo .
      577       define variable v-other          as character no-undo .
      578       define buffer buf_schedule-attr for ub.schedule-attr.
      579       run schedule-attr-name in this-procedure (
      580             input  p-code
      581           , output p-type
      582           , output v-format
      583           , output v-label
      584           , output v-user-can-edit
      585           , output v-output-display
      586           , output v-other
      587       ) no-error .
      588       if error-status :error
      589       then do:
      590           undo, return error return-value .
      591       end.
      592       if p-code begins ('schd-free-id':U + chr(4))
      593       and entry(2, p-code, chr(4)) = '':U then do:
      594         find first buf_schedule-attr no-lock
      595             where buf_schedule-attr.cre-db-num = p-cre-db-num
      596               and buf_schedule-attr.task-type  = p-task-type
      597               and buf_schedule-attr.task-num   = p-task-num
      598               and buf_schedule-attr.attr-code  begins p-code
      599         no-error .
      600       end.
      601       else do:
      602         find first buf_schedule-attr no-lock
      603             where buf_schedule-attr.cre-db-num = p-cre-db-num
      604               and buf_schedule-attr.task-type  = p-task-type
      605               and buf_schedule-attr.task-num   = p-task-num
      606               and buf_schedule-attr.attr-code  = p-code
      607         no-error .
      608       end.
      609       if available buf_schedule-attr
      610       then do:
      611           assign
      612               p-value = buf_schedule-attr.attr-value
      613           .
      614       end.
      615       else do:
      616         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      617            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      618         end.
      619         else do:
      620           assign
      621               p-value = if p-type = 'L':U then "no":U else ""
      622           .
      623         end.
      624       end.
      625   end.
      626   end procedure.
      627   procedure schedule-attr-write :
      628   do
      629   on error undo, return error
      630   :
      631   define input parameter p-cre-db-num  as integer   no-undo.
      632   define input parameter p-task-type   as character no-undo.
      633   define input parameter p-task-num    as integer   no-undo.
      634   define input parameter p-code        as character no-undo.
      635   define input parameter p-value       as character no-undo.
      636       define variable v-type              as character                no-undo.
      637       define variable v-format            as character                no-undo.
      638       define variable v-label             as character                no-undo.
      639       define variable v-user-can-edit     as logical                  no-undo.
      640       define variable v-output-display    as logical                  no-undo.
      641       define variable v-other             as character                no-undo.
      642       define buffer buf_schedule-attr for ub.schedule-attr .
      643       run schedule-attr-name in this-procedure (
      644             input  p-code
      645           , output v-type
      646           , output v-format
      647           , output v-label
      648           , output v-user-can-edit
      649           , output v-output-display
      650           , output v-other
      651       ) no-error.
      652       if error-status :error
      653       then do:
      654           undo, return error return-value.
      655       end.
      656       find first buf_schedule-attr exclusive-lock
      657            where buf_schedule-attr.cre-db-num = p-cre-db-num
      658              and buf_schedule-attr.task-type  = p-task-type
      659              and buf_schedule-attr.task-num   = p-task-num
      660              and buf_schedule-attr.attr-code  = p-code
      661       no-error.
      662       if not available buf_schedule-attr
      663       then do:
      664           create buf_schedule-attr.
      665           assign
      666             buf_schedule-attr.cre-db-num = p-cre-db-num
      667             buf_schedule-attr.task-type  = p-task-type
      668             buf_schedule-attr.task-num   = p-task-num
      669             buf_schedule-attr.attr-code  = p-code
      670             buf_schedule-attr.attr-value = p-value
      671           .
      672       end.
      673       else do:
      674           assign
      675               buf_schedule-attr.attr-value = p-value
      676           .
      677       end.
      678   end.
      679   end procedure.
      680   procedure schedule-attr-delete :
      681   do
      682   on error undo, return error
      683   :
      684   define input  parameter p-cre-db-num  as integer   no-undo.
      685   define input  parameter p-task-type   as character no-undo.
      686   define input  parameter p-task-num    as integer   no-undo.
      687   define input  parameter p-code        as character no-undo.
      688   define output parameter p-deleted     as logical   no-undo.
      689       define buffer buf_schedule-attr for ub.schedule-attr .
      690       define variable v-type              as character                no-undo.
      691       define variable v-format            as character                no-undo.
      692       define variable v-label             as character                no-undo.
      693       define variable v-user-can-edit     as logical                  no-undo.
      694       define variable v-output-display    as logical                  no-undo.
      695       define variable v-other             as character                no-undo.
      696       run schedule-attr-name in this-procedure (
      697             input p-code
      698           , output v-type
      699           , output v-format
      700           , output v-label
      701           , output v-user-can-edit
      702           , output v-output-display
      703           , output v-other
      704       ) no-error .
      705       if error-status :error
      706       then do:
      707           undo, return error return-value .
      708       end.
      709       find first buf_schedule-attr exclusive-lock
      710            where buf_schedule-attr.cre-db-num = p-cre-db-num
      711              and buf_schedule-attr.task-type  = p-task-type
      712              and buf_schedule-attr.task-num   = p-task-num
      713              and buf_schedule-attr.attr-code  = p-code
      714       no-error.
      715       if not available buf_schedule-attr
      716       then do:
      717           assign
      718               p-deleted = no
      719           .
      720       end.
      721       else do:
      722           delete buf_schedule-attr.
      723           assign
      724               p-deleted = yes
      725           .
      726       end.
      727   end.
      728   end procedure.
      729   procedure schedule-attr-news :
      730   do
      731   on error undo, return error
      732   :
      733       define input  parameter p-code           as character no-undo .
      734       define output parameter p-news           as logical   no-undo .
      735       if index(p-code, chr(4)) > 0 then do:
      736         p-code = entry(1, p-code, chr(4)).
      737       end.
      738       case p-code :
      739               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      740               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      741               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      742               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      743               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      744               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      745               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      746               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      747               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      748         otherwise do:
      749           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      750         end.
      751       end.
      752   end.
      753   end procedure.
      754   procedure schedule-attr-extract-logical :
      755   do
      756   on error undo, return error
      757   :
      758   define input  parameter p-parameter-number   as integer      no-undo.
      759   define input  parameter p-parameter-list     as character    no-undo.
      760   define output parameter p-parameter-value   as logical      no-undo.
      761       if num-entries( p-parameter-list ) > p-parameter-number - 1
      762       then do:
      763           assign
      764               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      765           .
      766       end.
      767       else do:
      768           assign
      769               p-parameter-value   = no
      770           .
      771       end.
      772   end.
      773   end procedure.
      774   procedure schedule-attr-get-free-id :
      775   do
      776   on error undo, return error return-value
      777   :
      778     define input  parameter p-cre-db-num  as integer   no-undo.
      779     define input  parameter p-task-type   as character no-undo.
      780     define input  parameter p-task-num    as integer   no-undo.
      781     define output parameter p-free-id     as character no-undo.
      782     define buffer buf_schedule-attr for ub.schedule-attr.
      783     find first buf_schedule-attr no-lock
      784         where buf_schedule-attr.cre-db-num = p-cre-db-num
      785           and buf_schedule-attr.task-type  = p-task-type
      786           and buf_schedule-attr.task-num   = p-task-num
      787           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      788     no-error .
      789     if available buf_schedule-attr then
      790     assign
      791     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      792     no-error
      793     .
      794   end.
      795   end procedure.
      796   procedure schedule-attr-get-free-props :
      797     define input parameter p-free-id as character no-undo .
      798     define output parameter p-value as character no-undo .
      799     define buffer buf_temp-schedule-free for temp-schedule-free.
      800     do
      801     on error undo, return error return-value
      802     :
      803       find first buf_temp-schedule-free no-lock no-error .
      804       if not available buf_temp-schedule-free then do:
      805         run schedule-attr-fill-free-props in this-procedure .
      806       end.
      807       find first buf_temp-schedule-free where
      808               buf_temp-schedule-free.free-id = p-free-id no-error.
      809       if available buf_temp-schedule-free then do:
      810         assign
      811         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      812                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      813                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      814                   buf_temp-schedule-free.conf-param           + chr(4) +
      815                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      816                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      817                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      818                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      819                   buf_temp-schedule-free.other-info
      820         .
      821       end.
      822       else do:
      823        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      824                              "id произвольной задачи - &5"
      825                              ,vss-workfile
      826                              ,vss-revision
      827                              ,vss-description
      828                              ,chr(10)
      829                              ,p-free-id).
      830       end.
      831     end.
      832   end procedure.
      833   procedure schedule-attr-is-rum-free-id :
      834   define input parameter p-free-id as character no-undo .
      835   define output parameter p-is-rum as logical no-undo .
      836   define buffer buf_temp-schedule-free for temp-schedule-free.
      837   do
      838   on error undo, return error
      839   :
      840       find first buf_temp-schedule-free no-lock no-error .
      841       if not available buf_temp-schedule-free then do:
      842         run schedule-attr-fill-free-props in this-procedure .
      843       end.
      844       find first buf_temp-schedule-free where
      845               buf_temp-schedule-free.free-id = p-free-id no-error.
      846       if available buf_temp-schedule-free
      847       and buf_temp-schedule-free.is-rum
      848       then do:
      849         p-is-rum = yes.
      850       end.
      851   end.
      852   end procedure.
      853   procedure schedule-attr-fill-free-props :
      854   define variable v-path                    as character                no-undo .
      855   DEFINE VARIABLE v-full-path               as character                no-undo .
      856   DEFINE VARIABLE v-file-name               as character                no-undo .
      857   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      858   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      859   define buffer buf_temp-schedule-free for temp-schedule-free.
      860   define variable v-answer as logical no-undo .
      861     do
      862     on error undo, return error substitute("&1 &2 &3&4&5&4"
      863                                           ,vss-workfile
      864                                           ,vss-revision
      865                                           ,vss-description
      866                                           ,chr(10)
      867                                           ,error-status:get-message(1) )
      868     :
      869       run gbl/filename.p (
      870                       input 'cmp/shd-free.d'
      871                     ,output v-full-path
      872                     ,output v-path
      873                     ,output v-file-name
      874                     ,output v-file-name-no-ext
      875                     ,output v-file-name-ext
      876                     ) .
      877       input from value(v-full-path).
      878       repeat :
      879         create buf_temp-schedule-free.
      880         import buf_temp-schedule-free.
      881       END.
      882       input close.
      883       _ff:
      884       for each buf_temp-schedule-free :
      885         if buf_temp-schedule-free.free-id = '':U then do:
      886            delete buf_temp-schedule-free.
      887            next _ff.
      888          end.
      889          run schedule-attr-check-enc in this-procedure (
      890                                                       input  buf_temp-schedule-free.free-id
      891                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      892                                                               buf_temp-schedule-free.proc-param-edit-name +
      893                                                               buf_temp-schedule-free.conf-param +
      894                                                               string(buf_temp-schedule-free.is-gbd) +
      895                                                               string(buf_temp-schedule-free.is-ubd) +
      896                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      897                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      898                                                               string(buf_temp-schedule-free.other-info)
      899                                                               )
      900                                                       ,input  buf_temp-schedule-free.enc-key
      901                                                       ,output v-answer    ) no-error .
      902          if error-status:error
      903          or not v-answer then delete buf_temp-schedule-free.
      904        end.
      905     end.
      906   end procedure.
      907   Function schedule-attr-reverse returns character (str as character).
      908      define variable rev_incl_s as character init "" no-undo .
      909      define variable rev_incl_i as integer no-undo .
      910      define variable rev_incl_l as integer no-undo .
      911      rev_incl_l = length(str).
      912      do rev_incl_i = 1 to rev_incl_l:
      913         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      914      end.
      915      return rev_incl_s.
      916   end.
      917   procedure schedule-attr-check-enc.
      918     define input  parameter p-free-id   as character no-undo .
      919     define input  parameter p-value     as character no-undo .
      920     define input  parameter p-enc-value as character no-undo .
      921     define output parameter p-answer    as logical   no-undo .
      922     define variable tmp         as character no-undo .
      923     define variable v-enc-value as character no-undo .
      924     assign
      925     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      926     .
      927     run schedule-attr-pswd-enc in this-procedure
      928       ( input tmp
      929        ,output v-enc-value
      930       ) no-error .
      931     if error-status:error then do:
      932       message
      933         vss-workfile vss-revision vss-description skip
      934         "Ошибка при вызове процедуры pswd-enc" skip
      935         return-value skip
      936         error-status :get-message(1) skip
      937         view-as alert-box error .
      938       undo, return error .
      939     end.
      940     if v-enc-value = p-enc-value then do:
      941       assign
      942         p-answer = true
      943       .
      944     end.
      945     else do:
      946       assign
      947         p-answer = false
      948       .
      949     end.
      950   end.
      951   procedure schedule-attr-conf-enc.
      952     define input  parameter p-free-id   as character no-undo .
      953     define input  parameter p-value     as character no-undo .
      954     define output parameter p-enc-value as character no-undo .
      955     define variable tmp         as character no-undo .
      956     assign
      957       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      958     .
      959     run schedule-attr-pswd-enc in this-procedure
      960       ( input tmp
      961        ,output p-enc-value
      962       ) no-error .
      963     if error-status:error then do:
      964       message
      965         vss-workfile vss-revision vss-description skip
      966         "Ошибка при вызове процедуры pswd-enc" skip
      967         return-value skip
      968         error-status :get-message(1) skip
      969         view-as alert-box error .
      970       undo, return error .
      971     end.
      972   end procedure.
      973   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      974   procedure schedule-attr-pswd-enc :
      975     define input parameter  pswd     as character no-undo .
      976     define output parameter enc-pswd as character no-undo .
      977     do
      978     on error undo, return error return-value
      979     :
      980       assign
      981         enc-pswd = encode(pswd + string(index(pswd, "k")))
      982       .
      983     end.
      984   end procedure.
      985   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      986   define  temp-table temp-host no-undo
      987     field host-code like ub.store.host-code
      988     index xpk host-code
      989   .
      990   define  temp-table temp-obj no-undo
      991     field obj-type  like ub.clients.obj-type
      992     field obj-code  like ub.clients.obj-code
      993     field host-code like ub.store.host-code
      994     field db-num    like ub.clients.db-num
      995     index xpk  obj-type obj-code
      996     index xie1 host-code
      997     index xie2 db-num host-code
      998   .
      999   procedure init-temphost:
     1000     define buffer buf_store   for ub.store .
     1001     define buffer buf_shop    for ub.shop .
     1002     define buffer buf_clients for ub.clients .
     1003     define buffer buf_db for ub.db .
     1004     define buffer buf_temp-host for temp-host .
     1005     define buffer buf_temp-obj for temp-obj .
     1006     do
     1007     on error undo, return error return-value
     1008     :
     1009       for each buf_store
     1010       on error undo, return error
     1011       :
     1012         find first buf_temp-host
     1013           where buf_temp-host.host-code = buf_store.host-code
     1014           no-error .
     1015         if not available buf_temp-host
     1016         then do:
     1017           create buf_temp-host .
     1018           assign
     1019             buf_temp-host.host-code = buf_store.host-code
     1020           .
     1021         end.
     1022         find first buf_clients no-lock
     1023           where buf_clients.obj-type = 'скл':U
     1024             and buf_clients.obj-code = buf_store.obj-code
     1025           no-error .
     1026         if not available buf_clients
     1027         then do:
     1028           message
     1029             "Ошибка при поиске клиента" skip
     1030             "Клиент" 'скл':U buf_store.obj-code skip
     1031             view-as alert-box error .
     1032           undo, return error .
     1033         end.
     1034         create buf_temp-obj .
     1035         assign
     1036           buf_temp-obj.obj-type  = 'скл':U
     1037           buf_temp-obj.obj-code  = buf_store.obj-code
     1038           buf_temp-obj.host-code = buf_store.host-code
     1039           buf_temp-obj.db-num    = buf_clients.db-num
     1040         .
     1041       end.
     1042       for each buf_shop
     1043       on error undo, return error
     1044       :
     1045         find first buf_temp-host
     1046           where buf_temp-host.host-code = buf_shop.host-code
     1047           no-error .
     1048         if not available buf_temp-host
     1049         then do:
     1050           create buf_temp-host .
     1051           assign
     1052             buf_temp-host.host-code = buf_shop.host-code
     1053           .
     1054         end.
     1055         find first buf_clients no-lock
     1056           where buf_clients.obj-type = 'маг':U
     1057             and buf_clients.obj-code = buf_shop.obj-code
     1058           no-error .
     1059         if not available buf_clients then do:
     1060           message
     1061             "Ошибка при поиске клиента" skip
     1062             "Клиент" 'маг':U buf_shop.obj-code skip
     1063             view-as alert-box error .
     1064           undo, return error .
     1065         end.
     1066         create buf_temp-obj .
     1067         assign
     1068           buf_temp-obj.obj-type  = 'маг':U
     1069           buf_temp-obj.obj-code  = buf_shop.obj-code
     1070           buf_temp-obj.host-code = buf_shop.host-code
     1071           buf_temp-obj.db-num    = buf_clients.db-num
     1072         .
     1073       end.
     1074     end.
     1075   end.
     1076   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1077   DEFINE new SHARED TEMP-TABLE TT-tnved NO-UNDO
     1078   FIELD tnved  AS CHAR FORMAT "X(10)"  LABEL 'Код ТНВЭД':U
     1079   FIELD f-name AS CHAR FORMAT "X(255)" LABEL 'Полное наименование':U
     1080   INDEX tnved IS UNIQUE PRIMARY  tnved.
     1081   function diff-list returns character (
     1082     input parfirst-list  as character,
     1083     input parsecond-list as character,
     1084     input pardelim       as character).
     1085     if pardelim = ""
     1086     or pardelim = ?
     1087     then do:
     1088       assign
     1089         pardelim = ","
     1090       .
     1091     end.
     1092     def var ind as integer no-undo .
     1093     def var v-elem as character no-undo .
     1094     def var v-result-list as character no-undo init "".
     1095     def var v-num-parfirst-list as integer no-undo .
     1096     assign
     1097       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1098     .
     1099     do ind = 1 to v-num-parfirst-list
     1100     :
     1101       assign
     1102         v-elem = entry(ind, parfirst-list, pardelim)
     1103       .
     1104       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
     1105         assign
     1106           v-result-list = v-result-list
     1107                         + (if v-result-list > "" then pardelim else "")
     1108                         + v-elem
     1109         .
     1110       end.
     1111     end.
     1112     return v-result-list .
     1113   end function.
     1114   function add-list returns character (
     1115    input parfirst-list  as character,
     1116    input parsecond-list as character,
     1117    input pardelim       as character).
     1118     if pardelim = ""
     1119     or pardelim = ?
     1120     then do:
     1121       assign
     1122         pardelim = ","
     1123       .
     1124     end.
     1125     def var ind as integer no-undo .
     1126     def var v-elem as character no-undo .
     1127     def var v-result-list as character no-undo init "".
     1128     def var v-num-parfirst-list as integer no-undo .
     1129     assign
     1130       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1131     .
     1132     do ind = 1 to v-num-parfirst-list
     1133     :
     1134       assign
     1135         v-elem = entry(ind, parfirst-list, pardelim)
     1136       .
     1137       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1138         assign
     1139           v-result-list = v-result-list
     1140                         + (if v-result-list > "" then pardelim else "")
     1141                         + v-elem
     1142         .
     1143       end.
     1144     end.
     1145     def var v-num-parsecond-list as integer no-undo .
     1146     assign
     1147       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
     1148     .
     1149     do ind = 1 to v-num-parsecond-list
     1150     :
     1151       assign
     1152         v-elem = entry(ind, parsecond-list, pardelim)
     1153       .
     1154       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1155         assign
     1156           v-result-list = v-result-list
     1157                         + (if v-result-list > "" then pardelim else "")
     1158                         + v-elem
     1159         .
     1160       end.
     1161     end.
     1162     return v-result-list .
     1163   end function.
     1164   function cross-list returns character (
     1165    input parfirst-list  as character,
     1166    input parsecond-list as character,
     1167    input pardelim       as character).
     1168     if pardelim = ""
     1169     or pardelim = ?
     1170     then do:
     1171       assign
     1172         pardelim = ","
     1173       .
     1174     end.
     1175     def var ind as integer no-undo .
     1176     def var v-elem as character no-undo .
     1177     def var v-result-list as character no-undo init "".
     1178     def var v-num-parfirst-list as integer no-undo .
     1179     assign
     1180       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1181     .
     1182     do ind = 1 to v-num-parfirst-list
     1183     :
     1184       assign
     1185         v-elem = entry(ind, parfirst-list, pardelim)
     1186       .
     1187       if lookup(v-elem, v-result-list, pardelim) = 0
     1188       and lookup(v-elem, parsecond-list, pardelim) > 0
     1189       then do:
     1190         assign
     1191           v-result-list = v-result-list
     1192                         + (if v-result-list > "" then pardelim else "")
     1193                         + v-elem
     1194         .
     1195       end.
     1196     end.
     1197     return v-result-list .
     1198   end function.
     1199   function radio-label returns character (
     1200    input par-rs-value  as character,
     1201    input par-rs-radio-buttons as character)
     1202    .
     1203    DEFINE variable v-result-label as character no-undo.
     1204    assign
     1205    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
     1206                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
     1207                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
     1208                             ), par-rs-radio-buttons
     1209                           )
     1210    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1211    .
     1212   return v-result-label.
     1213   end function.
     1214   function m-radio-label returns character (
     1215    input par-rs-value  as character,
     1216    input par-rs-radio-buttons as character,
     1217    input par-delim as character
     1218    )
     1219    .
     1220    DEFINE variable v-result-label as character no-undo.
     1221    assign
     1222    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
     1223                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
     1224                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
     1225                             ), par-rs-radio-buttons, par-delim
     1226                           )
     1227    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1228    .
     1229   return v-result-label.
     1230   end function.
     1231   FUNCTION mixlist returns character
     1232   (
     1233    input parfirst-list  as character
     1234    ,input parsecond-list as character
     1235    ,input pardelim       as character
     1236    ,input pardelim-result as character ) :
     1237     if pardelim = ""
     1238     or pardelim = ?
     1239     then do:
     1240       assign
     1241         pardelim = ","
     1242       .
     1243     end.
     1244     def var ind as integer no-undo .
     1245     def var v-elem1 as character no-undo .
     1246     def var v-elem2 as character no-undo .
     1247     def var v-result-list as character no-undo init "".
     1248     do ind = 1 to num-entries(parfirst-list, pardelim)
     1249     :
     1250       assign
     1251         v-elem1 = entry(ind, parfirst-list, pardelim)
     1252         v-elem2 = entry(ind, parsecond-list, pardelim)
     1253       .
     1254         assign
     1255           v-result-list = v-result-list
     1256                         + (if v-result-list > "" then pardelim-result else "")
     1257                         + v-elem1 + pardelim-result + v-elem2
     1258         .
     1259     end.
     1260     return v-result-list .
     1261   END FUNCTION.
     1262       define buffer lck_schedule-attr for ub.schedule-attr.
     1263       define buffer buf_shift-obj for ub.shift-obj.
     1264       define variable v-ind                       as integer      no-undo.
     1265       define variable v-param-list                as character    no-undo.
     1266       define variable v-temp-obj-list             as character    no-undo.
     1267       define variable v-obj-counter               as integer      no-undo.
     1268       define variable v-obj-list                  as character    no-undo.
     1269       define variable v-obj-list-shift            as character    no-undo.
     1270       define variable v-obj-list-noshift          as character    no-undo.
     1271       define variable v-obj-list-type             as character    no-undo.
     1272       define variable v-obj-list-code             as integer      no-undo.
     1273       define variable v-doc-type-list             as character    no-undo.
     1274       define variable v-spec-doc-type-list        as character    no-undo.
     1275       define variable v-date-range                as character    no-undo.
     1276       define variable v-param-type                as character    no-undo.
     1277       define variable v-date-from                 as date         no-undo.
     1278       define variable v-date-to                   as date         no-undo.
     1279       define variable v-pay-code                  as logical      no-undo.
     1280       define variable v-cst                       as logical      no-undo.
