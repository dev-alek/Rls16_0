     1535   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1536     run mainmenu_getcntxt in parparentproc
     1537       (output v-cntxt-db-num
     1538       ,output v-cntxt-userid
     1539       ,output v-cntxt-level
     1540       ,output v-cntxt-host-code-obj
     1541       ,output v-cntxt-obj-type
     1542       ,output v-cntxt-obj-code
     1543       ,output v-cntxt-db-num-obj
     1544       ,output v-cntxt-is-admin
