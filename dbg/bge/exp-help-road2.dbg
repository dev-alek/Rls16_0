     1563   RUN disable_UI.
     1564   PROCEDURE attach-attr-to-schedule-line :
     1565     DEFINE INPUT PARAMETER p-param-list AS CHARACTER NO-UNDO.
     1566     define input  parameter p-obj-list as character no-undo .
     1567     define input  parameter p-oss-list as character no-undo .
     1568     define input  parameter p-gds-list as character no-undo .
     1569     define buffer buf_schedule      for schedule.
     1570     define buffer buf_schedule-attr for schedule-attr.
     1571     define buffer lock-batchprocess for ub.batchprocess.
     1572     CASE p-mode:
     1573       when 'shd':U then
     1574         do:
     1575           run gbl/lock-prc.p
     1576             (input 'schd':U
     1577             ,input 'help-road':U
     1578             ,input 0
     1579             ,input 0
     1580             ,input '':U
     1581             ,input ""
     1582             ,input ""
     1583             ,input (
     1584             "выгрузка реализации банковских продуктов"
     1585             )
     1586             ,input yes
     1587             ,buffer lock-batchprocess
     1588             ) no-error .
     1589           FIND FIRST buf_schedule-attr NO-LOCK WHERE
     1590             buf_schedule-attr.task-type   = p-task-type
     1591             and buf_schedule-attr.cre-db-num = INTEGER(p-db-num-char)
     1592             and buf_schedule-attr.attr-code = ('schd-free-id':U + chr(4) + 'help-road') NO-ERROR.
     1593           IF AVAILABLE  buf_schedule-attr
     1594             AND buf_schedule-attr.task-num <> p-task-num
     1595             AND buf_schedule-attr.task-num <> - 1
     1596             and p-task-num <> - 1
     1597             THEN
     1598           DO:
     1599             MESSAGE
     1600               substitute("Уже есть расписание выгрузки реализации банковских продуктов для БД &1&2" +
     1601               "номер расписания &3"
     1602               ,buf_schedule-attr.cre-db-num
     1603               ,chr(10)
     1604               ,buf_schedule-attr.task-num)
     1605               VIEW-AS ALERT-BOX ERROR.
     1606             UNDO, RETURN ERROR.
     1607           END.
     1608           find first buf_schedule no-lock
     1609             where buf_schedule.task-type   = p-task-type
     1610             and buf_schedule.cre-db-num  = INTEGER(p-db-num-char)
     1611             and buf_schedule.task-num    = p-task-num
     1612             no-error.
     1613           if not available buf_schedule
     1614             and (  p-task-type   <> 'autofree':U
     1615             or p-db-num-char <> p-db-num-char
     1616             or p-task-num    <> -1 )
     1617             then
     1618           do:
     1619             message
     1620               vss-workfile vss-revision vss-description
     1621               skip
     1622               "Не найдена строка расписания."
     1623               skip return-value
     1624               skip trim(error-status :get-message(1))
     1625               trim(error-status :get-message(2))
     1626               trim(error-status :get-message(3))
     1627               view-as alert-box error.
     1628             undo, return error .
     1629           end.
     1630           run schedule-attr-write in this-procedure (
     1631             input INTEGER(p-db-num-char)
     1632             , input p-task-type
     1633             , input p-task-num
     1634             , input 'schedule-param-list':U
     1635             , input p-param-list
     1636             ).
     1637           run schedule-attr-write in this-procedure (
     1638             input INTEGER(p-db-num-char)
     1639             , input p-task-type
     1640             , input p-task-num
     1641             , input 'schedule-obj-list':U
     1642             , input p-obj-list
     1643             ).
     1644           run schedule-attr-write in this-procedure (
     1645             input INTEGER(p-db-num-char)
     1646             , input p-task-type
     1647             , input p-task-num
     1648             , input 'schedule-oss-list':U
     1649             , input p-oss-list
     1650             ).
     1651           run schedule-attr-write in this-procedure (
     1652             input INTEGER(p-db-num-char)
     1653             , input p-task-type
     1654             , input p-task-num
     1655             , input 'schedule-gds-list':U
     1656             , input p-gds-list
     1657             ).
     1658         end.
     1659       when 'run':U then
     1660         do:
     1661           p-params = p-param-list.
     1662         end.
     1663     END CASE.
     1664   END PROCEDURE.
     1665   PROCEDURE check-host-list :
     1666     define input-output parameter pHost-code-list as character no-undo.
     1667     define variable iCount        as integer   no-undo.
     1668     define variable cTemp         as character no-undo.
     1669     define variable iTempHostCode as integer   no-undo.
     1670     define variable cNewHostList  as character no-undo.
     1671     define variable lOk           as logical   no-undo.
     1672     do iCount = 1 to num-entries( pHost-code-list ):
     1673       cTemp = entry( iCount, pHost-code-list ).
     1674       assign
     1675         iTempHostCode = integer( cTemp ) no-error
     1676         .
     1677       run validate-host( iTempHostCode, no, no, output lOk ).
     1678       if lOk and lookup( string( iTempHostCode ), cNewHostList ) = 0
     1679         then
     1680       do:
     1681         assign
     1682           cNewHostList = cNewHostList + ',' + string( iTempHostCode )
     1683           .
     1684       end.
     1685     end.
     1686     pHost-code-list = trim( cNewHostList, ',' ).
     1687     return.
     1688   END PROCEDURE.
     1689   PROCEDURE convert :
     1690     define input-output parameter v-rid-list as character no-undo.
     1691     define variable v-list as character no-undo .
     1692     define variable v-ind  as integer   no-undo .
     1693     define buffer buf_sysconf for ub.sysconf.
     1694     do
     1695       on error undo, return error return-value
     1696       :
     1697       do v-ind = 1 to num-entries(v-rid-list)
     1698         :
     1699         find first buf_sysconf no-lock
     1700           where recid(buf_sysconf) = integer(entry(v-ind, v-rid-list))
     1701           no-error .
     1702         if available buf_sysconf
     1703           then
     1704         do:
     1705           assign
     1706             v-list = v-list
     1707                     + (if v-list = '':U
     1708                       then '':U
     1709                       else chr(44)
     1710                       )
     1711                     + string(buf_sysconf.host-code)
     1712             .
     1713         end.
     1714       end.
     1715       assign
     1716         v-rid-list = v-list
     1717         .
     1718     end.
     1719   END PROCEDURE.
     1720   PROCEDURE disable_UI :
     1721     HIDE FRAME Dialog-Frame.
     1722   END PROCEDURE.
     1723   PROCEDURE enable_UI :
     1724     DISPLAY date-from date-to EDITOR-1 RADIO-SET-1 EDITOR-2 RADIO-SET-2 EDITOR-3
     1725       RADIO-SET-3 v-folder v-file
     1726       WITH FRAME Dialog-Frame.
     1727     ENABLE b-exit b-quit RECT-1 RECT-8 RECT-2 RECT-3 date-from date-to EDITOR-1
     1728       RADIO-SET-1 EDITOR-2 RADIO-SET-2 EDITOR-3 RADIO-SET-3 v-folder b-dir
     1729       v-file
     1730       WITH FRAME Dialog-Frame.
     1731     VIEW FRAME Dialog-Frame.
     1732   END PROCEDURE.
     1733   PROCEDURE init-param-values :
     1734     do
     1735       on error undo, return error
     1736       :
     1737       define input parameter p-task-type              as character    no-undo.
     1738       define input parameter p-db-num-char            as character    no-undo.
     1739       define input parameter p-task-num               as integer      no-undo.
     1740       define variable v-param-list as character no-undo.
     1741       define variable v-param-type as character no-undo.
     1742       define variable v-obj-list   as character no-undo .
     1743       define variable v-gds-list   as character no-undo .
     1744       define variable v-oss-list   as character no-undo .
     1745       define variable ii           as integer   no-undo .
     1746       define variable v-entry-1    as character no-undo .
     1747       define variable v-entry-2    as character no-undo .
     1748       define variable v-entry-3    as character no-undo .
     1749       define variable v-task-num   as integer   no-undo .
     1750       define variable v-ii1        as integer   no-undo.
     1751       define variable v-text       as character no-undo.
     1752       define variable v-ii2        as integer   no-undo.
     1753       define buffer buf_tt-obj        for tt-obj.
     1754       define buffer buf_tt-oss-ref    for tt-oss-ref.
     1755       define buffer buf_tt-gds-list   for tt-gds-list.
     1756       define buffer buf_schedule      for ub.schedule.
     1757       define buffer buf_schedule-attr for ub.schedule-attr.
     1758       DO WITH FRAME Dialog-Frame:
     1759         CASE p-mode:
     1760           when 'run':U then
     1761             do:
     1762               if RADIO-SET-1 = 0 then RADIO-SET-1 = 2 .
     1763               if RADIO-SET-2 = 0 then RADIO-SET-2 = 1 .
     1764               if RADIO-SET-3 = 0 then RADIO-SET-3 = 1 .
     1765               DISPLAY
     1766                 v-folder
     1767                 v-file
     1768                 RADIO-SET-1
     1769                 RADIO-SET-2
     1770                 RADIO-SET-3
     1771                 date-from
     1772                 date-to
     1773                 .
     1774               EMPTY TEMP-TABLE buf_tt-obj.
     1775               IF v-obj-list <> "":U
     1776                 and RADIO-SET-1 = 3
     1777                 THEN
     1778               do ii = 1 to num-entries(v-obj-list, chr(4))
     1779                 on error undo, next
     1780                 :
     1781                 assign
     1782                   v-entry-1 = entry(ii, v-obj-list, chr(4))
     1783                   .
     1784                 FIND FIRST ub.clients
     1785                   WHERE ub.clients.obj-type = ENTRY(1, v-entry-1, chr(44))
     1786                   AND ub.clients.obj-code = INTEGER(ENTRY(2, v-entry-1, chr(44)))
     1787                   NO-LOCK
     1788                   NO-ERROR
     1789                   .
     1790                 IF AVAILABLE ub.clients
     1791                   THEN
     1792                 DO:
     1793                   create tt-obj.
     1794                   ASSIGN
     1795                     tt-obj.obj-code  = ub.clients.obj-code
     1796                     tt-obj.obj-type  = ub.clients.obj-type
     1797                     tt-obj.obj-name  = ub.clients.obj-name
     1798                     tt-obj.host-code = ub.clients.host-code
     1799                     v-text           = v-text + chr(10) + ub.clients.obj-name
     1800                     .
     1801                 END.
     1802                 ASSIGN
     1803                   v-text   = TRIM(v-text, chr(10))
     1804                   EDITOR-1 = v-text
     1805                   .
     1806               end.
     1807               ELSE
     1808               DO:
     1809                 if RADIO-SET-1 = 4 then
     1810                 do:
     1811                   EDITOR-1 = "Все":U.
     1812                   FOR EACH ub.clients
     1813                     WHERE ub.clients.obj-type = 'маг':U
     1814                     NO-LOCK
     1815                     :
     1816                     CREATE tt-obj.
     1817                     ASSIGN
     1818                       tt-obj.obj-code  = ub.clients.obj-code
     1819                       tt-obj.obj-type  = ub.clients.obj-type
     1820                       tt-obj.obj-name  = ub.clients.obj-name
     1821                       tt-obj.host-code = ub.clients.host-code
     1822                       .
     1823                   END.
     1824                 end.
     1825                 else
     1826                 do:
     1827                   apply "VALUE-CHANGED" TO RADIO-SET-1.
     1828                 end.
     1829               END.
     1830               DISPLAY
     1831                 EDITOR-1
     1832                 WITH FRAME Dialog-Frame.
     1833               EMPTY TEMP-TABLE buf_tt-oss-ref.
     1834               IF v-oss-list <> "":U
     1835                 and RADIO-SET-2 = 2
     1836                 THEN
     1837               do ii = 1 to num-entries(v-oss-list, chr(4))
     1838                 on error undo, next
     1839                 :
     1840                 assign
     1841                   v-entry-2 = entry(ii, v-oss-list, chr(4))
     1842                   .
     1843                 Find first ub.OperServ
     1844                   WHERE ub.OperServ.id = INTEGER(ENTRY(1, v-entry-2, chr(44)))
     1845                   NO-LOCK no-error .
     1846                 if available (ub.OperServ) then
     1847                 do:
     1848                   CREATE tt-oss-ref.
     1849                   buffer-copy ub.OperServ to tt-oss-ref .
     1850                     v-text-oss                   = v-text-oss + chr(10) + ub.OperServ.ext-code
     1851                     .
     1852                 END.
     1853                 ASSIGN
     1854                   v-text-oss = TRIM(v-text-oss, chr(10))
     1855                   EDITOR-2   = v-text-oss
     1856                   .
     1857               end.
     1858               ELSE
     1859               DO:
     1860                 if RADIO-SET-2 = 1 then
     1861                 do:
     1862                   EDITOR-2 = "Все":U.
     1863                   FOR EACH ub.OperServ
     1864                     NO-LOCK
     1865                     :
     1866                     if available (ub.OperServ) then
     1867                     do:
     1868                       CREATE tt-oss-ref.
     1869                       buffer-copy ub.OperServ to tt-oss-ref .
     1870                     END.
     1871                   end.
     1872                 END.
     1873               end.
     1874               DISPLAY
     1875                 EDITOR-2
     1876                 WITH FRAME Dialog-Frame.
     1877               EMPTY TEMP-TABLE buf_tt-gds-list.
     1878               IF v-gds-list <> "":U
     1879                 and RADIO-SET-3 = 2
     1880                 THEN
     1881               do ii = 1 to num-entries(v-gds-list, chr(4))
     1882                 on error undo, next
     1883                 :
     1884                 assign
     1885                   v-entry-3 = entry(ii, v-gds-list, chr(4))
     1886                   .
     1887                 find first ub.goods-attr no-lock
     1888                   where ub.goods-attr.attr-code  = 'oper-serv-idd':U
     1889                   and ub.goods-attr.gds-code = INTEGER(ENTRY(1, v-entry-3, chr(44)))
     1890                   no-error .
     1891                 if available (ub.goods-attr) then
     1892                 do:
     1893                   find first ub.goods no-lock where ub.goods-attr.gds-code = ub.goods.gds-code no-error .
     1894                   if available (ub.goods) then
     1895                   do:
     1896                     CREATE tt-gds-list.
     1897                     ASSIGN
     1898                       tt-gds-list.artic     = ub.goods.artic
     1899                       tt-gds-list.gds-code  = ub.goods.gds-code
     1900                       tt-gds-list.gds-name  = ub.goods.gds-name
     1901                       tt-gds-list.prod-code = ub.goods.prod-code
     1902                       tt-gds-list.prod-type = ub.goods.prod-type
     1903                       v-text-gds            = v-text-gds + chr(10) + ub.goods.gds-name
     1904                       .
     1905                   end.
     1906                 end.
     1907                 ASSIGN
     1908                   v-text-gds = TRIM(v-text-gds, chr(10))
     1909                   EDITOR-3   = v-text-gds
     1910                   .
     1911               end.
     1912               ELSE
     1913               DO:
     1914                 if RADIO-SET-3 = 1 then
     1915                 do:
     1916                   EDITOR-3 = "Все":U.
     1917                   for each ub.goods-attr no-lock
     1918                     where ub.goods-attr.attr-code  = 'oper-serv-idd':U,
     1919                     each ub.goods no-lock where ub.goods.gds-code = ub.goods-attr.gds-code
     1920                     :
     1921                     CREATE tt-gds-list.
     1922                     ASSIGN
     1923                       tt-gds-list.artic     = ub.goods.artic
     1924                       tt-gds-list.gds-code  = ub.goods.gds-code
     1925                       tt-gds-list.gds-name  = ub.goods.gds-name
     1926                       tt-gds-list.prod-code = ub.goods.prod-code
     1927                       tt-gds-list.prod-type = ub.goods.prod-type
     1928                       .
     1929                   end.
     1930                 END.
     1931               end.
     1932               DISPLAY
     1933                 EDITOR-3
     1934                 WITH FRAME Dialog-Frame.
     1935             END.
     1936         END CASE.
     1937       END.
     1938     END.
     1939   END PROCEDURE.
     1940   PROCEDURE proc-save :
     1941     DEFINE VARIABLE glog             AS LOGICAL   NO-UNDO.
     1942     DEFINE VARIABLE v-param-list     AS CHARACTER NO-UNDO.
     1943     define variable v-obj-list       as character no-undo .
     1944     define variable v-list           as character no-undo .
     1945     define variable v-oss-list       as character no-undo .
     1946     define variable v-gds-list       as character no-undo .
     1947     define variable ii               as integer   no-undo .
     1948     define variable v-exists         as logical   no-undo .
     1949     define variable v-date-file-name as character no-undo.
     1950     define variable v-time-file      as char      no-undo.
     1951     define buffer buf_tt-obj      for tt-obj .
     1952     define buffer buf_tt-oss-ref  for tt-oss-ref .
     1953     define buffer buf_tt-gds-list for tt-gds-list .
     1954     define variable v-file-name as character no-undo .
     1955     ASSIGN
     1956       FRAME Dialog-Frame
     1957       RADIO-SET-1
     1958       RADIO-SET-2
     1959       RADIO-SET-3
     1960       EDITOR-1
     1961       EDITOR-2
     1962       EDITOR-3
     1963       v-folder
     1964       v-file
     1965       date-from
     1966       date-to
     1967       .
     1968     if date-from > date-to then
     1969     do:
     1970       message
     1971         "Даты интервала заданы неверно. "
     1972         skip
     1973         " Нижняя дата интервала должна быть меньше верхней."
     1974         skip(1) "Задайте интервал дат правильно или отмените экспорт."
     1975         view-as alert-box information.
     1976       apply "entry" to date-from.
     1977       undo, return no-apply.
     1978     end.
     1979     if not can-find( first buf_tt-obj ) then
     1980     do:
     1981       message
     1982         "Не заданы объекты для выгрузки"
     1983         view-as alert-box error .
     1984       return error.
     1985     end.
     1986     v-obj-list = ''.
     1987     for each buf_tt-obj :
     1988       assign
     1989         v-obj-list = v-obj-list
     1990                    + buf_tt-obj.obj-type + chr(44)
     1991                    + string(buf_tt-obj.obj-code) + chr(4)
     1992         .
     1993     end.
     1994     if not can-find( first buf_tt-oss-ref ) then
     1995     do:
     1996       message
     1997         "Не заданы платежные агенты/операторы для выгрузки"
     1998         view-as alert-box error .
     1999       return error.
     2000     end.
     2001     v-oss-list = ''.
     2002     for each buf_tt-oss-ref :
     2003       assign
     2004         v-oss-list = v-oss-list + string (buf_tt-oss-ref.id) + chr(4)
     2005         .
     2006     end.
     2007     if not can-find( first buf_tt-gds-list ) then
     2008     do:
     2009       message
     2010         "Не заданы товары платежного агента/оператора для выгрузки"
     2011         view-as alert-box error .
     2012       return error.
     2013     end.
     2014     v-gds-list = ''.
     2015     for each buf_tt-gds-list :
     2016       assign
     2017         v-gds-list = v-gds-list
     2018                    + string (buf_tt-gds-list.gds-code)  + chr(4)
     2019         .
     2020     end.
     2021     if v-file = "" then
     2022     do:
     2023       assign
     2024         v-time-file      = replace(  string(time,"HH:MM:SS"),  ":",  ""  )
     2025         v-today          = today
     2026         v-date-file-name = STRING(YEAR(v-today), "9999") +  STRING(DAY(v-today), "99") + STRING(MONTH(v-today), "99")
     2027         v-file           = substitute( "rep_PA_&1_&2"
     2028                                   , v-date-file-name, v-time-file )
     2029         .
     2030     end.
     2031     ASSIGN
     2032       v-obj-list = TRIM(v-obj-list, chr(4)).
     2033     v-oss-list = TRIM(v-oss-list, chr(4)).
     2034     v-gds-list = TRIM(v-gds-list, chr(4)).
     2035     v-param-list = v-folder + chr(4) +
     2036       v-file   + chr(4) +
     2037       STRING( RADIO-SET-1 ) + chr(4) +
     2038       STRING( RADIO-SET-2 ) + chr(4) +
     2039       STRING( RADIO-SET-3 ) + chr(4) +
     2040       string(if date-from <> ? then string(date-from) else "") + chr(4) +
     2041       string(if date-to <> ? then string(date-to) else "") + chr(4)
     2042       .
     2043     IF p-mode = 'shd' THEN
     2044     DO:
     2045       run attach-attr-to-schedule-line in this-procedure ( INPUT v-param-list
     2046         , INPUT v-obj-list
     2047         , input v-oss-list
     2048         , input v-gds-list
     2049         ) .
     2050     END.
     2051     if p-mode = 'run' then do:
     2052         run rep/r-help-road.p ( INPUT ?
     2053       , INPUT v-folder
     2054       , INPUT v-file
     2055       , INPUT date-from
     2056       , INPUT date-to
     2057       , INPUT ""
     2058       , INPUT ""
     2059       , INPUT v-log-handle
     2060       , INPUT TABLE tt-obj
     2061       , INPUT TABLE tt-oss-ref
     2062       , INPUT TABLE tt-gds-list
     2063       ) .
     2064     end.
     2065   END PROCEDURE.
