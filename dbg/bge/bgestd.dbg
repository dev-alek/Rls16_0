       87   define   shared variable g#passwd as character no-undo .
       88   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89   define  temp-table temp-host no-undo
       90     field host-code like ub.store.host-code
       91     index xpk host-code
       92   .
       93   define  temp-table temp-obj no-undo
       94     field obj-type  like ub.clients.obj-type
       95     field obj-code  like ub.clients.obj-code
       96     field host-code like ub.store.host-code
       97     field db-num    like ub.clients.db-num
       98     index xpk  obj-type obj-code
       99     index xie1 host-code
      100     index xie2 db-num host-code
      101   .
      102   procedure init-temphost:
      103     define buffer buf_store   for ub.store .
      104     define buffer buf_shop    for ub.shop .
      105     define buffer buf_clients for ub.clients .
      106     define buffer buf_db for ub.db .
      107     define buffer buf_temp-host for temp-host .
      108     define buffer buf_temp-obj for temp-obj .
      109     do
      110     on error undo, return error return-value
      111     :
      112       for each buf_store
      113       on error undo, return error
      114       :
      115         find first buf_temp-host
      116           where buf_temp-host.host-code = buf_store.host-code
      117           no-error .
      118         if not available buf_temp-host
      119         then do:
      120           create buf_temp-host .
      121           assign
      122             buf_temp-host.host-code = buf_store.host-code
      123           .
      124         end.
      125         find first buf_clients no-lock
      126           where buf_clients.obj-type = 'скл':U
      127             and buf_clients.obj-code = buf_store.obj-code
      128           no-error .
      129         if not available buf_clients
      130         then do:
      131           message
      132             "Ошибка при поиске клиента" skip
      133             "Клиент" 'скл':U buf_store.obj-code skip
      134             view-as alert-box error .
      135           undo, return error .
      136         end.
      137         create buf_temp-obj .
      138         assign
      139           buf_temp-obj.obj-type  = 'скл':U
      140           buf_temp-obj.obj-code  = buf_store.obj-code
      141           buf_temp-obj.host-code = buf_store.host-code
      142           buf_temp-obj.db-num    = buf_clients.db-num
      143         .
      144       end.
      145       for each buf_shop
      146       on error undo, return error
      147       :
      148         find first buf_temp-host
      149           where buf_temp-host.host-code = buf_shop.host-code
      150           no-error .
      151         if not available buf_temp-host
      152         then do:
      153           create buf_temp-host .
      154           assign
      155             buf_temp-host.host-code = buf_shop.host-code
      156           .
      157         end.
      158         find first buf_clients no-lock
      159           where buf_clients.obj-type = 'маг':U
      160             and buf_clients.obj-code = buf_shop.obj-code
      161           no-error .
      162         if not available buf_clients then do:
      163           message
      164             "Ошибка при поиске клиента" skip
      165             "Клиент" 'маг':U buf_shop.obj-code skip
      166             view-as alert-box error .
      167           undo, return error .
      168         end.
      169         create buf_temp-obj .
      170         assign
      171           buf_temp-obj.obj-type  = 'маг':U
      172           buf_temp-obj.obj-code  = buf_shop.obj-code
      173           buf_temp-obj.host-code = buf_shop.host-code
      174           buf_temp-obj.db-num    = buf_clients.db-num
      175         .
      176       end.
      177     end.
      178   end.
      179   define variable vss-include-info1 as character format "X(65)" no-undo
      180   initial "@(#)$Workfile$ $Revision$".
      181   define variable v-bgelib-bgefmt        as character         no-undo.
      182   define variable v-bgelib-bgeflold      as character         no-undo.
