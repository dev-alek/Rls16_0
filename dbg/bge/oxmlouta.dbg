      574   procedure xmlchar-decode :
      575   define input parameter p-in-string      as character        no-undo.
      576   define output parameter p-out-string    as character        no-undo.
      577       define variable v-position      as integer      no-undo.
      578       define variable v-last-position as integer      no-undo.
      579       define variable v-temp-integer  as integer      no-undo.
      580       define variable v-current-char  as character    no-undo.
      581       define variable v-next-char     as character    no-undo.
      582       define variable v-success       as logical      no-undo.
      583   do
      584   on error undo, return error
      585   :
      586       assign
      587           p-out-string = "":U
      588           v-position   = 0
      589       .
      590       replace-cycle:
      591       do while yes
      592       on error undo, return error
      593       :
      594           assign
      595               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      596           .
      597           if v-last-position <= v-position
      598           then do:
      599               if v-position = 0
      600               then do:
      601                   assign
      602                       p-out-string = p-in-string
      603                   .
      604               end.
      605               else do:
      606                   assign
      607                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      608                   .
      609               end.
      610               leave replace-cycle.
      611           end.
      612           else do:
      613               assign
      614                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      615                   v-position      = v-last-position
      616                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      617               .
      618               if v-current-char = "#":U
      619               then do:
      620                   assign
      621                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      622                   .
      623                   if v-last-position > 0
      624                   then do:
      625                       run xmlchar-read-integer in this-procedure
      626                        (
      627                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      628                           , output v-temp-integer
      629                           , output v-success
      630                       ).
      631                       if v-success = yes
      632                       and v-temp-integer >= 1
      633                       and v-temp-integer <= 255
      634                       then do:
      635                           assign
      636                               p-out-string = p-out-string + chr( v-temp-integer )
      637                               v-position   = v-last-position + 1
      638                           .
      639                       end.
      640                       else do:
      641                           assign
      642                               p-out-string = p-out-string + "&":U
      643                               v-position   = v-position   + 1
      644                           .
      645                       end.
      646                   end.
      647                   else do:
      648                       assign
      649                           p-out-string = p-out-string + "&":U
      650                           v-position   = v-position   + 1
      651                       .
      652                   end.
      653               end.
      654               else do:
      655                   case substring( p-in-string, v-position + 1, 3 )
      656                   :
      657                       when "lt;":U
      658                       then do:
      659                           assign
      660                               p-out-string = p-out-string + "<":U
      661                               v-position   = v-position   + 3
      662                           .
      663                       end.
      664                       when "gt;":U
      665                       then do:
      666                           assign
      667                               p-out-string = p-out-string + ">":U
      668                               v-position   = v-position   + 3
      669                           .
      670                       end.
      671                       otherwise do:
      672                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      673                           then do:
      674                               assign
      675                                   p-out-string = p-out-string + "&":U
      676                                   v-position   = v-position   + 4
      677                               .
      678                           end.
      679                           else do:
      680                               case substring( p-in-string, v-position + 1, 5 )
      681                               :
      682                                   when "quot;":U
      683                                   then do:
      684                                       assign
      685                                           p-out-string = p-out-string + '"':U
      686                                           v-position   = v-position   + 5
      687                                       .
      688                                   end.
      689                                   when "apos;":U
      690                                   then do:
      691                                       assign
      692                                           p-out-string = p-out-string + "'":U
      693                                           v-position   = v-position   + 5
      694                                       .
      695                                   end.
      696                                   otherwise do:
      697                                       assign
      698                                           p-out-string = p-out-string + "&":U
      699                                       .
      700                                   end.
      701                               end case.
      702                           end.
      703                       end.
      704                   end case.
      705               end.
      706           end.
      707       end.
      708   end.
      709   end .
      710   procedure xmlchar-read-integer :
      711   define input parameter p-input-string      as character        no-undo.
      712   define output parameter p-output-integer   as integer          no-undo.
      713   define output parameter p-success       as logical          no-undo.
      714   do
      715   on error undo, return error
      716   :
      717       assign
      718           p-output-integer = integer( p-input-string )
      719       no-error.
      720       if error-status :error
      721       then do:
      722           assign
      723               p-success           = no
      724               p-output-integer    = 0
      725           .
      726       end.
      727       else do:
      728           assign
      729               p-success           = yes
      730           .
      731       end.
      732   end.
      733   end.
      734   define variable vss-include-info2 as character format "X(65)" no-undo
      735   initial "@(#)$Workfile$ $Revision$".
      736   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      737   define stream stmXMLOut.
      738   define stream stmXMLLog.
      739   define stream strXMLIn.
      740   define temp-table temp_xmllib_rec-list no-undo
      741       field recName       as character
      742       field recLevel      as integer
      743       field recOpenLine   as integer
      744       field recCloseLine  as integer
      745       field closed        as logical
      746       index pi is primary unique
      747           recName
      748           recLevel
      749       index cl
      750           closed
      751   .
      752   define temp-table temp_xmllib_rec-fld-list no-undo
      753       field recName       as character
      754       field recLevel      as integer
      755       field fldName       as character
      756       field fldOpenLine   as integer
      757       field fldCloseLine  as integer
      758       field closed        as logical
      759       index pi is primary unique
      760           recName
      761           recLevel
      762           fldName
      763       index fn
      764           fldName
      765       index cl
      766           closed
      767   .
      768   define temp-table temp_xmllib_rec no-undo
      769       field rec-key       as integer
      770       field recLevel      as integer
      771       field recOpenLine   as integer
      772       field recCloseLine  as integer
      773       field recName       as character
      774       field closed        as logical
      775       index pi is primary unique
      776           rec-key
      777       index nm
      778           recName
      779           closed
      780           rec-key
      781       index cl
      782           closed
      783       index rlv
      784           recName
      785           recLevel
      786           closed
      787           rec-key
      788   .
      789   define temp-table temp_xmllib_rec-fld no-undo
      790       field fld-key       as integer
      791       field rec-key       as integer
      792       field fldOpenLine   as integer
      793       field fldCloseLine  as integer
      794       field fldName       as character
      795       field fldValue      as character
      796       field closed        as logical
      797       index pi is primary unique
      798           fld-key
      799       index nm
      800           rec-key
      801           fldName
      802           closed
      803           fld-key
      804       index cl
      805           closed
      806   .
      807   define variable v-xmllib-rec-key            as integer      no-undo .
      808   define variable v-xmllib-rec-fld-key        as integer      no-undo .
      809   define variable v-xmllib-dirname            as character    no-undo .
      810   define variable v-xmllib-filename           as character    no-undo .
      811   define variable v-xmllib-log-filename       as character    no-undo .
      812   define variable v-xmllib-log-handle         as handle       no-undo .
      813   define variable v-xmllib-log-proc-name      as character    no-undo .
      814   define variable v-xmllib-error-status       as logical      no-undo .
      815   define variable v-xmllib-sax-reader-handle  as handle       no-undo .
      816   define variable v-xmllib-prg-bar-handle     as handle       no-undo .
      817   define variable v-xmllib-codepage-convert   as logical      no-undo .
      818   define variable v-xmllib-codepage-source    as character    no-undo .
      819   define variable v-xmllib-codepage-target    as character    no-undo .
      820   procedure xmllib-clear-parse-data :
      821   do
      822   on error undo, return error
      823   :
      824       empty temp-table temp_xmllib_rec-list.
      825       empty temp-table temp_xmllib_rec-fld-list.
      826       empty temp-table temp_xmllib_rec.
      827       empty temp-table temp_xmllib_rec-fld.
      828   end.
      829   end procedure.
      830   procedure xmllib-add-rec-fld :
      831   define input parameter p-rec-name       as character        no-undo.
      832   define input parameter p-rec-fld-name   as character        no-undo.
      833       define buffer buf_rec-list        for temp_xmllib_rec-list.
      834       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
      835   do
      836   for buf_rec-list
      837     , buf_rec-fld-list
      838   on error undo, return error
      839   :
      840       find first buf_rec-list
      841            where buf_rec-list.recName = p-rec-name
      842       no-error.
      843       if not available buf_rec-list
      844       then do:
      845           create buf_rec-list.
      846           assign
      847               buf_rec-list.recName        = p-rec-name
      848               buf_rec-list.recOpenLine    = 0
      849               buf_rec-list.recCloseLine   = 0
      850               buf_rec-list.closed         = yes
      851           .
      852       end.
      853       find first buf_rec-fld-list
      854            where buf_rec-fld-list.recName = p-rec-name
      855              and buf_rec-fld-list.fldName = p-rec-fld-name
      856       no-error.
      857       if not available buf_rec-fld-list
      858       then do:
      859           create buf_rec-fld-list.
      860           assign
      861               buf_rec-fld-list.recName        = p-rec-name
      862               buf_rec-fld-list.fldName        = p-rec-fld-name
      863               buf_rec-fld-list.fldOpenLine    = 0
      864               buf_rec-fld-list.fldCloseLine   = 0
      865               buf_rec-fld-list.closed         = yes
      866           .
      867       end.
      868   end.
      869   end procedure.
      870   procedure xmllib-tag-open:
      871   define input parameter v-tag-level  as integer      no-undo.
      872   define input parameter v-tag-name   as character    no-undo.
      873   define input parameter v-tag-value  as character    no-undo.
      874   do
      875   on error undo, return error
      876   :
      877       assign
      878           v-tag-name = trim( v-tag-name )
      879       .
      880       put stream stmXMLOut unformatted
      881           substitute( "&1&2<&3&4&5>"
      882               , chr(10)
      883               , fill(" ", 4 * v-tag-level)
      884               , v-tag-name
      885               , ( if v-tag-value = "":U or v-tag-value = ? then "":U else " ":U )
      886               , v-tag-value
      887           )
      888       .
      889   end.
      890   end procedure.
      891   procedure xmllib-tag-put:
      892   define input parameter v-tag-level      as integer      no-undo.
      893   define input parameter v-tag-name       as character    no-undo.
      894   define input parameter v-tag-value      as character    no-undo.
      895   define input parameter v-empty-mode     as integer      no-undo.
      896   do
      897   on error undo, return error
      898   :
      899       assign
      900           v-tag-name = trim( v-tag-name )
      901       .
      902       if  v-empty-mode = 1
      903       or (v-empty-mode = 0 and (v-tag-value <> "":U and v-tag-value <> ?) )
      904       or (v-empty-mode = 2 and (v-tag-value <> "":U and v-tag-value <> ? and v-tag-value <> "0":U))
      905       or (v-empty-mode = 3 and (v-tag-value <> "":U and v-tag-value <> ? and caps(v-tag-value) <> "no":U))
      906       then do:
      907           run xmlchar-encode in this-procedure (
      908                 input v-tag-value
      909               , output v-tag-value
      910           ).
      911           put stream stmXMLOut unformatted
      912               substitute( "&1&2<&3>&4</&3>"
      913                   , chr(10)
      914                   , fill(" ":U, 4 * v-tag-level)
      915                   , v-tag-name
      916                   , v-tag-value
      917               )
      918           .
      919       end.
      920   end.
      921   end procedure.
      922   procedure xmllib-tag-put-null :
      923   define input parameter p-tag-level  as integer      no-undo.
      924   define input parameter p-tag-name   as character    no-undo.
      925   do
      926   on error undo, return error
      927   :
      928       assign
      929           p-tag-name = trim( p-tag-name )
      930       .
      931       put stream stmXMLOut unformatted
      932           substitute( '&1&2<&3 nil="true" /&3>'
      933               , chr(10)
      934               , fill(" ":U, 4 * p-tag-level)
      935               , p-tag-name
      936           )
      937       .
      938   end.
      939   end procedure.
      940   procedure xmllib-tag-close:
      941   define input parameter v-tag-level as integer      no-undo.
      942   define input parameter v-tag-name  as character    no-undo.
      943   do
      944   on error undo, return error
      945   :
      946       assign
      947           v-tag-name = trim( v-tag-name )
      948       .
      949       put stream stmXMLOut unformatted
      950           substitute( "&1&2</&3>"
      951               , chr(10)
      952               , fill( " ":U, 4 * v-tag-level)
      953               , v-tag-name
      954           )
      955       .
      956   end.
      957   end procedure.
      958   procedure xmllib-write-log:
      959   define input parameter v-filename   as character    no-undo.
      960   define input parameter v-log-level  as integer      no-undo.
      961   define input parameter v-out-string as character    no-undo.
      962   do
      963   on error undo, return error
      964   :
      965       output stream stmXMLLog to value( v-filename ) append.
      966       put stream stmXMLLog unformatted
      967           chr(10)
      968       .
      969       put stream stmXMLLog unformatted
      970           ( if v-log-level = 0
      971             or v-out-string = "&DLine":U
      972             or v-out-string = "&Line":U
      973             then "":U
      974             else cur-time-string-sec() + " ":U )
      975       .
      976       put stream stmXMLLog unformatted
      977           ( if v-out-string = "&Line":U
      978             then fill( "-":U, 80 )
      979             else if v-out-string = "&DLine":U
      980                  then fill( "=":U, 80 )
      981                  else v-out-string )
      982       .
      983       output stream stmXMLLog close.
      984   end.
      985   end procedure.
      986   procedure xmllib-write-edt:
      987   define input parameter v-editor-handle    as handle       no-undo.
      988   define input parameter v-log-level        as integer      no-undo.
      989   define input parameter v-out-string       as character    no-undo.
      990   do
      991   on error undo, return error
      992   :
      993       if valid-handle ( v-editor-handle )
      994       then do:
      995           v-editor-handle :move-to-eof().
      996           v-editor-handle :insert-string( ( if v-log-level = 0
      997                                             or v-out-string = "&DLine":U
      998                                             or v-out-string = "&Line":U
      999                                             then "":U
     1000                                             else cur-time-string-sec() + " ":U
     1001                                         ) ).
     1002           v-editor-handle :insert-string( ( if v-out-string = "&Line":U
     1003                                             then fill( "-":U, 80 )
     1004                                             else if v-out-string = "&DLine":U then fill("=":U, 80)
     1005                                             else fill( " ":U, v-log-level) + v-out-string
     1006                                         ) ).
     1007           v-editor-handle :insert-string( chr(10) ).
     1008       end.
     1009   end.
     1010   end procedure.
     1011   procedure xmllib-show-cnt:
     1012   define input parameter v-fillin-handle     as handle   no-undo.
     1013   do
     1014   on error undo, return error
     1015   :
     1016       if valid-handle( v-fillin-handle )
     1017       then do:
     1018           assign
     1019               v-fillin-handle :visible = true
     1020           .
     1021       end.
     1022   end.
     1023   end procedure.
     1024   procedure xmllib-hide-cnt:
     1025   define input parameter v-fillin-handle     as handle   no-undo.
     1026   do
     1027   on error undo, return error
     1028   :
     1029       if valid-handle( v-fillin-handle )
     1030       then do:
     1031           assign v-fillin-handle :visible = false.
     1032       end.
     1033   end.
     1034   end procedure.
     1035   procedure xmllib-write-cnt:
     1036   define input parameter v-fillin-handle    as handle       no-undo.
     1037   define input parameter v-fillin-string    as character    no-undo.
     1038   do
     1039   on error undo, return error
     1040   :
     1041       if valid-handle( v-fillin-handle )
     1042       then do:
     1043           assign
     1044               v-fillin-handle :SCREEN-value = v-fillin-string
     1045           .
     1046       end.
     1047   end.
     1048   end procedure.
     1049   procedure xmllib-write-header:
     1050   define input parameter p-first-file     as logical      no-undo.
     1051   define input parameter p-xml-file-name  as character    no-undo.
     1052   define input parameter p-list-file-name as character    no-undo.
     1053   define input parameter p-file-number    as integer      no-undo.
     1054   define input parameter p-have-prev      as logical      no-undo.
     1055   define input parameter p-prev-filename  as character    no-undo.
     1056   define input parameter p-parameter-list as character    no-undo.
     1057       define variable v-counter    as integer        no-undo.
     1058   do
     1059   on error undo, return error
     1060   :
     1061       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1062       put stream stmXMLOut unformatted
     1063           "<?xml version='1.0' encoding='windows-1251'?>"
     1064       .
     1065       run xmllib-tag-open( input 0, input "root"          , input "":U ).
     1066       run xmllib-tag-open( input 0, input "THheader"        , input "":U ).
     1067       run xmllib-tag-put( input 1 , input "THfileName"      , input p-xml-file-name + "xml":U  , input 0 ).
     1068       run xmllib-tag-put( input 1 , input "THfileNumber"    , input string( p-file-number     ), input 0 ).
     1069       run xmllib-tag-put( input 1 , input "THhavePrev"      , input string( p-have-prev       ), input 3 ).
     1070       run xmllib-tag-put( input 1 , input "THprevFileName"  , input p-prev-filename            , input 0 ).
     1071       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1072       :
     1073           run xmllib-tag-put(
     1074                 input 1
     1075               , input entry( 2 * v-counter, p-parameter-list )
     1076               , input entry( 2 * v-counter + 1, p-parameter-list )
     1077               , input 0
     1078           ).
     1079       end.
     1080       run xmllib-tag-close( input 0, input "THheader" ).
     1081       output stream stmXMLOut close.
     1082       if p-list-file-name <> "":U
     1083       then do:
     1084           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1085           if p-first-file = yes
     1086           then do:
     1087               put stream stmXMLOut unformatted
     1088                   "<?xml version='1.0' encoding='windows-1251'?>"
     1089               .
     1090               run xmllib-tag-open( input 0, input "OpenXML", input "" ).
     1091           end.
     1092           run xmllib-tag-open( input 1, input "THfile", input "" ).
     1093           run xmllib-tag-put( input 2, input "THfileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1094           run xmllib-tag-put( input 2, input "THfileNumber"     , input string( p-file-number     ), input 0 ).
     1095           run xmllib-tag-put( input 2, input "THhavePrev"       , input string( p-have-prev       ), input 3 ).
     1096           run xmllib-tag-put( input 2, input "THprevFileName"   , input p-prev-filename            , input 0 ).
     1097           do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1098           :
     1099               run xmllib-tag-put(
     1100                   input 2
     1101                   , input entry( 2 * v-counter, p-parameter-list )
     1102                   , input entry( 2 * v-counter + 1, p-parameter-list )
     1103                   , input 0
     1104               ).
     1105           end.
     1106           run xmllib-tag-close( input 1, input "THfile" ).
     1107           output stream stmXMLOut close.
     1108       end.
     1109   end.
     1110   end procedure.
     1111   procedure xmllib-write-footer:
     1112   define input parameter p-last-file      as logical      no-undo.
     1113   define input parameter p-xml-file-name  as character    no-undo.
     1114   define input parameter p-list-file-name as character    no-undo.
     1115   define input parameter p-have-next      as logical      no-undo.
     1116   define input parameter p-next-file-name as character    no-undo.
     1117       define variable v-error-num     as integer           no-undo.
     1118   do
     1119   on error undo, return error
     1120   :
     1121       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1122       if p-have-next = yes
     1123       then do:
     1124           run xmllib-tag-open( input 0, input "footer", "" ).
     1125           run xmllib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1126           run xmllib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1127           run xmllib-tag-close( input 0, input "footer" ).
     1128       end.
     1129       run xmllib-tag-close( input 0, input "root" ).
     1130       output stream stmXMLOut close.
     1131       run bge/os_copy.p (
     1132             input "M"
     1133           , input p-xml-file-name + "tmp"
     1134           , input p-xml-file-name + "xml"
     1135           , output v-error-num
     1136       ).
     1137       if p-last-file = yes
     1138       and p-list-file-name <> "":U
     1139       then do:
     1140           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1141               run xmllib-tag-close( input 0, input "OpenXML" ).
     1142           output stream stmXMLOut close.
     1143           run bge/os_copy.p (
     1144                 input "M"
     1145               , input p-list-file-name + "tmp"
     1146               , input p-list-file-name + "xml":U
     1147               , output v-error-num
     1148           ).
     1149       end.
     1150   end.
     1151   end procedure.
     1152   procedure xmllib-filename :
     1153   define input parameter p-subdir             as character        no-undo.
     1154   define input parameter p-prefix             as character    no-undo.
     1155   define output parameter p-xml-file-name     as character    no-undo.
     1156   define output parameter p-log-file-name     as character    no-undo.
     1157   define output parameter p-list-file-name    as character    no-undo.
     1158       define variable v-home-dir  as character    no-undo.
     1159       define variable v-error-num as integer      no-undo.
     1160   do
     1161   on error undo, return error
     1162   :
     1163       get-key-value section "OXML" key "oxml-dir" value v-home-dir.
     1164       if v-home-dir = ?
     1165       then do:
     1166           message
     1167             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1168             skip "Нет параметра oxml-dir в секции [OXML]."
     1169             skip(1)
     1170             skip "Обратитесь к администратору."
     1171           view-as alert-box error.
     1172           undo, return error .
     1173       end.
     1174       if p-subdir <> "":U
     1175       then do:
     1176           assign
     1177               v-home-dir = substitute( "&1/out/&2", v-home-dir, p-subdir )
     1178           .
     1179       end.
     1180       run gbl/dir-cre.p (
     1181           input v-home-dir
     1182       ) no-error.
     1183       if error-status :error
     1184       then do:
     1185           message
     1186             skip "Неверно задан каталог экспорта в ini-файле."
     1187             skip "Не удаётся создать каталог, указанный параметром"
     1188             skip "oxml-dir в секции [OXML]."
     1189             skip(1)
     1190             skip "Обратитесь к администратору."
     1191           view-as alert-box error.
     1192           undo, return error .
     1193       end.
     1194       run bge/genfname.p (
     1195             input v-home-dir
     1196           , input p-prefix
     1197           , input ""
     1198           , input "xml"
     1199           , input "tmp"
     1200           , output p-xml-file-name
     1201       ).
     1202       assign
     1203           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1204           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1205           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1206       .
     1207   end.
     1208   end procedure.
     1209   procedure xmllib-check-file-size :
     1210   define input parameter p-out-filename   as character    no-undo.
     1211   define output parameter p-is-big        as logical      no-undo.
     1212       define variable v-current-position    as integer        no-undo.
     1213   do
     1214   on error undo, return error
     1215   :
     1216       assign
     1217           v-current-position = seek( stmXMLOut )
     1218       .
     1219       if v-current-position / 1024 / 1024  >= 100
     1220       then do:
     1221           assign
     1222               p-is-big = yes
     1223           .
     1224       end.
     1225   end.
     1226   end procedure.
     1227   procedure xmllib-parse-file :
     1228   define input parameter p-full-filename      as character        no-undo.
     1229       define variable v-num-dirs              as integer      no-undo .
     1230       define variable v-str                   as character    no-undo .
     1231       define variable v-str-count             as int64        no-undo .
     1232   do
     1233   on error undo, return error
     1234   :
     1235       assign
     1236           v-num-dirs              = num-entries( p-full-filename,"\/":U )
     1237           v-xmllib-error-status   = no
     1238       .
     1239       if v-num-dirs > 1
     1240       then do:
     1241           assign
     1242               v-xmllib-filename = entry( v-num-dirs, p-full-filename, "\/":U )
     1243               v-xmllib-dirname  = substring( p-full-filename, 1, length( p-full-filename ) - length( v-xmllib-filename ) - 1 )
     1244           .
     1245       end.
     1246       else do:
     1247           assign
     1248               v-xmllib-filename = p-full-filename
     1249               v-xmllib-dirname  = "":U
     1250           .
     1251       end.
     1252       if valid-handle(v-xmllib-prg-bar-handle)
     1253       then do:
     1254   if session :set-wait-state( "compiler" ) then.
     1255         input stream strXMLIn from value(p-full-filename) .
     1256         repeat
     1257         :
     1258           import stream strXMLIn unformatted v-str no-error .
     1259           assign
     1260             v-str-count = v-str-count + 1
     1261           .
     1262         end.
     1263         input stream strXMLIn close .
     1264   if session :set-wait-state( "" ) then.
     1265         run prg-bar_init-cb-handle in this-procedure ( input v-xmllib-prg-bar-handle ) .
     1266         run prg-bar_new in this-procedure ( input 1 , input v-str-count) .
     1267         run prg-bar_show in this-procedure .
     1268       end.
     1269       create sax-reader v-xmllib-sax-reader-handle.
     1270       v-xmllib-sax-reader-handle :set-input-source( "FILE":U, p-full-filename ).
     1271       v-xmllib-sax-reader-handle :sax-parse( ) no-error.
     1272       if error-status :error
     1273       then do:
     1274           run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     1275                                                                       ,vss-workfile
     1276                                                                       ,vss-revision
     1277                                                                       ,vss-description
     1278                                                                       ,chr(10)
     1279                                                                       ,return-value
     1280                                                                       ,trim(error-status :get-message(1))
     1281                                                                       ,trim(error-status :get-message(2))
     1282                                                                       ,trim(error-status :get-message(3)))
     1283                                                     ).
     1284           undo, return error .
     1285       end.
     1286       if v-xmllib-error-status <> no
     1287       then do:
     1288           run xmllib-parse-error in this-procedure (
     1289               input "*** При обработке XML файла были ошибки."
     1290           ).
     1291           delete object v-xmllib-sax-reader-handle.
     1292       end.
     1293       delete object v-xmllib-sax-reader-handle.
     1294       if valid-handle(v-xmllib-prg-bar-handle)
     1295       then do:
     1296         run prg-bar_delete in this-procedure .
     1297       end.
     1298   end.
     1299   end procedure.
     1300   procedure xmllib-parse-progressive :
     1301   define input parameter p-full-filename      as character no-undo .
     1302   define input parameter p-pack-data          as memptr no-undo .
     1303   define input parameter p-parse-first        as logical no-undo .
     1304   define input parameter p-first-err          as logical no-undo .
     1305   define output parameter p-parse-status as integer no-undo .
     1306   define variable v-num-dirs              as integer no-undo .
     1307   define variable glog                    as logical no-undo .
     1308   define variable v-pack-size             as int64 no-undo .
     1309   do
     1310   on error undo, return error
     1311   :
     1312     if p-parse-first then do:
     1313       if valid-handle(v-xmllib-sax-reader-handle)
     1314       then do:
     1315       end.
     1316       assign
     1317           v-num-dirs              = num-entries( p-full-filename,"\/":U )
     1318           v-xmllib-error-status   = no
     1319       .
     1320       if v-num-dirs > 1
     1321       then do:
     1322           assign
     1323               v-xmllib-filename = entry( v-num-dirs, p-full-filename, "\/":U )
     1324               v-xmllib-dirname  = substring( p-full-filename, 1, length( p-full-filename ) - length( v-xmllib-filename ) - 1 )
     1325           .
     1326       end.
     1327       else do:
     1328           assign
     1329               v-xmllib-filename = p-full-filename
     1330               v-xmllib-dirname  = "":U
     1331           .
     1332       end.
     1333       create sax-reader v-xmllib-sax-reader-handle.
     1334       v-pack-size = get-size (p-pack-data) .
     1335       if v-pack-size > 0 then
     1336         glog = v-xmllib-sax-reader-handle :set-input-source( "MEMPTR":U, p-pack-data ) no-error.
     1337       else
     1338         glog = v-xmllib-sax-reader-handle :set-input-source( "FILE":U, p-full-filename ) no-error.
     1339       if error-status :error
     1340       or not glog
     1341       then do:
     1342         delete object v-xmllib-sax-reader-handle.
     1343         run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     1344                                                                     ,vss-workfile
     1345                                                                     ,vss-revision
     1346                                                                     ,vss-description
     1347                                                                     ,chr(10)
     1348                                                                     ,return-value
     1349                                                                     ,trim(error-status :get-message(1))
     1350                                                                     ,trim(error-status :get-message(2))
     1351                                                                     ,trim(error-status :get-message(3)) )
     1352                                                   ).
     1353         undo, return error .
     1354       end.
     1355       v-xmllib-sax-reader-handle :sax-parse-first( ) no-error.
     1356     end.
     1357     else do:
     1358       v-xmllib-sax-reader-handle :sax-parse-next( ) no-error.
     1359     end.
     1360     if error-status :error
     1361     then do:
     1362       delete object v-xmllib-sax-reader-handle.
     1363       run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     1364                                                                   ,vss-workfile
     1365                                                                   ,vss-revision
     1366                                                                   ,vss-description
     1367                                                                   ,chr(10)
     1368                                                                   ,return-value
     1369                                                                   ,trim(error-status :get-message(1))
     1370                                                                   ,trim(error-status :get-message(2))
     1371                                                                   ,trim(error-status :get-message(3)) )
     1372                                                 ).
     1373       undo, return error .
     1374     end.
     1375     if v-xmllib-error-status <> no
     1376     then do:
     1377       run xmllib-parse-error in this-procedure (
     1378           input "*** При обработке XML файла были ошибки."
     1379       ).
     1380       if p-first-err then do:
     1381         delete object v-xmllib-sax-reader-handle.
     1382       end.
     1383       else do:
     1384         v-xmllib-error-status = no.
     1385       end.
     1386     end.
     1387     if v-xmllib-sax-reader-handle:parse-status = SAX-COMPLETE  then do:
     1388       p-parse-status = SAX-COMPLETE.
     1389       delete object v-xmllib-sax-reader-handle.
     1390       return '':U.
     1391     end.
     1392     else do:
     1393       p-parse-status = v-xmllib-sax-reader-handle:parse-status.
     1394       return '':U.
     1395     end.
     1396   end.
     1397   end procedure.
     1398   procedure StartElement :
     1399   define input parameter p-name-space     as character        no-undo.
     1400   define input parameter p-local-name     as character        no-undo.
     1401   define input parameter p-q-name         as character        no-undo.
     1402   define input parameter p-attributes     as handle           no-undo.
     1403       define buffer buf_rec             for temp_xmllib_rec.
     1404       define buffer buf_rec-fld         for temp_xmllib_rec-fld.
     1405       define buffer buf_rec-list        for temp_xmllib_rec-list.
     1406       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     1407   do
     1408   for buf_rec
     1409     , buf_rec-fld
     1410     , buf_rec-list
     1411     , buf_rec-fld-list
     1412   on error undo, return error
     1413   :
     1414       if valid-handle(v-xmllib-prg-bar-handle)
     1415       then do:
     1416         run prg-bar_stepto in this-procedure ( input SELF:LOCATOR-LINE-NUMBER ) .
     1417       end.
     1418       find first buf_rec-list
     1419            where buf_rec-list.recName = p-q-name
     1420       no-error.
     1421       if available buf_rec-list
     1422       then do:
     1423           if buf_rec-list.closed = no
     1424           then do:
     1425               find first buf_rec-fld-list
     1426                    where buf_rec-fld-list.recName = buf_rec-list.recName
     1427                      and buf_rec-fld-list.fldName = p-q-name
     1428               no-error.
     1429               if available buf_rec-fld-list
     1430               and buf_rec-list.recName = buf_rec-fld-list.recName
     1431               then do:
     1432                   if buf_rec-fld-list.closed = no
     1433                   then do:
     1434                       run xmllib-parse-error in this-procedure (
     1435                           input substitute( "Ошибка 1 открытия поля <&1> записи <&2>: Поле с этим именем уже открыто на строке &3."
     1436                                           , p-q-name
     1437                                           , p-q-name
     1438                                           , buf_rec-fld-list.fldOpenLine
     1439                                           )
     1440                       ).
     1441                   end.
     1442                   else do:
     1443                       run xmllib-parse-rec-fld-open in this-procedure (
     1444                             input buf_rec-list.recName
     1445                           , input buf_rec-list.recLevel
     1446                           , input buf_rec-fld-list.fldName
     1447                       ).
     1448                       assign
     1449                           buf_rec-fld-list.closed         = no
     1450                           buf_rec-fld-list.fldOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     1451                           buf_rec-fld-list.fldCloseLine   = 0
     1452                       .
     1453                   end.
     1454               end.
     1455               else do:
     1456                   assign
     1457                       buf_rec-list.recLevel = buf_rec-list.recLevel + 1
     1458                   .
     1459                   run xmllib-parse-rec-open in this-procedure (
     1460                         input buf_rec-list.recName
     1461                       , input buf_rec-list.recLevel
     1462                   ).
     1463                   assign
     1464                       buf_rec-list.closed         = no
     1465                       buf_rec-list.recOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     1466                       buf_rec-list.recCloseLine   = 0
     1467                   .
     1468               end.
     1469           end.
     1470           else do:
     1471               run xmllib-parse-rec-open in this-procedure (
     1472                     input buf_rec-list.recName
     1473                   , input buf_rec-list.recLevel
     1474               ).
     1475               assign
     1476                   buf_rec-list.closed         = no
     1477                   buf_rec-list.recOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     1478                   buf_rec-list.recCloseLine   = 0
     1479               .
     1480           end.
     1481       end.
     1482       else do:
     1483           open-record:
     1484           for each buf_rec-fld-list
     1485              where buf_rec-fld-list.fldName = p-q-name
     1486           :
     1487               find first buf_rec-list
     1488                    where buf_rec-list.recName = buf_rec-fld-list.recName
     1489                      and buf_rec-list.closed  = no
     1490               no-error.
     1491               if available buf_rec-list
     1492               then do:
     1493                   run xmllib-parse-rec-fld-open in this-procedure (
     1494                         input buf_rec-list.recName
     1495                       , input buf_rec-list.recLevel
     1496                       , input buf_rec-fld-list.fldName
     1497                   ).
     1498                   assign
     1499                       buf_rec-fld-list.recLevel       = buf_rec-list.recLevel
     1500                       buf_rec-fld-list.closed         = no
     1501                       buf_rec-fld-list.fldOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     1502                       buf_rec-fld-list.fldCloseLine   = 0
     1503                   .
     1504                   leave open-record.
     1505               end.
     1506           end.
     1507       end.
     1508   end.
     1509   end procedure.
     1510   procedure Characters :
     1511   define input parameter p-char-data  as memptr.
     1512   define input parameter p-numchars   as integer.
     1513       define variable v-data-string    as character    no-undo.
     1514       define variable v-cp-utf8           as integer no-undo init 65001 .
     1515       define variable v-cp-windows1251    as integer no-undo init 1251 .
     1516       define buffer buf_xmllib_rec             for temp_xmllib_rec.
     1517       define buffer buf_xmllib_rec-fld         for temp_xmllib_rec-fld.
     1518       define buffer buf_xmllib_rec-list        for temp_xmllib_rec-list.
     1519       define buffer buf_xmllib_rec-fld-list    for temp_xmllib_rec-fld-list.
     1520   do
     1521   for buf_xmllib_rec
     1522     , buf_xmllib_rec-fld
     1523     , buf_xmllib_rec-list
     1524     , buf_xmllib_rec-fld-list
     1525   on error undo, return error
     1526   :
     1527       find first buf_xmllib_rec-list
     1528            where buf_xmllib_rec-list.closed = no
     1529       no-error.
     1530       if available buf_xmllib_rec-list
     1531       then do:
     1532           find first buf_xmllib_rec-fld-list
     1533                where buf_xmllib_rec-fld-list.closed = no
     1534           no-error.
     1535           if available buf_xmllib_rec-fld-list
     1536           and buf_xmllib_rec-fld-list.recName  = buf_xmllib_rec-list.recName
     1537           and buf_xmllib_rec-fld-list.recLevel = buf_xmllib_rec-list.recLevel
     1538           then do:
     1539               find last buf_xmllib_rec
     1540                   where buf_xmllib_rec.recName  = buf_xmllib_rec-list.recName
     1541                     and buf_xmllib_rec.recLevel = buf_xmllib_rec-list.recLevel
     1542                     and buf_xmllib_rec.closed   = no
     1543               use-index nm
     1544               no-error.
     1545               if available buf_xmllib_rec
     1546               then do:
     1547                   find last buf_xmllib_rec-fld
     1548                       where buf_xmllib_rec-fld.rec-key = buf_xmllib_rec.rec-key
     1549                         and buf_xmllib_rec-fld.fldName = buf_xmllib_rec-fld-list.fldName
     1550                         and buf_xmllib_rec-fld.closed = no
     1551                   use-index nm
     1552                   no-error.
     1553                   if available buf_xmllib_rec-fld
     1554                   then do:
     1555                       assign
     1556                           v-data-string = get-string( p-char-data, 1, get-size( p-char-data ) )
     1557                       .
     1558                       if v-xmllib-codepage-convert = yes
     1559                       then do:
     1560                         assign
     1561                             v-data-string = codepage-convert( v-data-string , v-xmllib-codepage-target , v-xmllib-codepage-source )
     1562                         .
     1563                       end.
     1564                       run xmlchar-decode in this-procedure (
     1565                           input v-data-string
     1566                           , output v-data-string
     1567                       ).
     1568                       assign
     1569                           buf_xmllib_rec-fld.fldValue = trim( substitute( "&1&2", buf_xmllib_rec-fld.fldValue, v-data-string ) )
     1570                       .
     1571                   end.
     1572               end.
     1573           end.
     1574       end.
     1575   end.
     1576   end procedure.
     1577   procedure EndElement :
     1578   define input parameter p-name-space     as character        no-undo.
     1579   define input parameter p-local-name     as character        no-undo.
     1580   define input parameter p-q-name         as character        no-undo.
     1581       define buffer buf_rec             for temp_xmllib_rec.
     1582       define buffer buf_rec-fld         for temp_xmllib_rec-fld.
     1583       define buffer buf_rec-list        for temp_xmllib_rec-list.
     1584       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     1585   do
     1586   for buf_rec
     1587     , buf_rec-fld
     1588     , buf_rec-list
     1589     , buf_rec-fld-list
     1590   on error undo, return error
     1591   :
     1592       find last buf_rec-list
     1593           where buf_rec-list.recName = p-q-name
     1594       use-index pi
     1595       no-error.
     1596       if available buf_rec-list
     1597       then do:
     1598           if buf_rec-list.closed = yes
     1599           then do:
     1600               run xmllib-parse-error in this-procedure (
     1601                   input substitute( "Ошибка закрытия записи или поля <&1>: Нет метки открытой записи."
     1602                                   , p-q-name
     1603                                   )
     1604               ).
     1605           end.
     1606           else do:
     1607               find last buf_rec
     1608                   where buf_rec.recName  = buf_rec-list.recName
     1609                     and buf_rec.recLevel = buf_rec-list.recLevel
     1610                     and buf_rec.closed   = no
     1611               use-index nm
     1612               no-error.
     1613               if not available buf_rec
     1614               then do:
     1615                   run xmllib-parse-error in this-procedure (
     1616                       input substitute( "Ошибка закрытия записи или поля <&1> уровня &2: Нет открытой записи."
     1617                                       , p-q-name
     1618                                       , buf_rec-list.recLevel
     1619                                       )
     1620                   ).
     1621               end.
     1622               else do:
     1623                   find first buf_rec-fld-list
     1624                        where buf_rec-fld-list.recName  = buf_rec.recName
     1625                          and buf_rec-fld-list.recLevel = buf_rec.recLevel
     1626                          and buf_rec-fld-list.fldName  = p-q-name
     1627                          and buf_rec-fld-list.closed   = no
     1628                   no-error.
     1629                   if not available buf_rec-fld-list
     1630                   then do:
     1631                       if buf_rec.recName <> p-q-name
     1632                       then do:
     1633                           run xmllib-parse-error in this-procedure (
     1634                               input substitute( "Ошибка закрытия записи <&1>: Имя открытой записи не совпадает с именем метки."
     1635                                               , buf_rec.recName
     1636                                               )
     1637                           ).
     1638                       end.
     1639                       else do:
     1640                           assign
     1641                               buf_rec.closed              = yes
     1642                               buf_rec.recCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     1643                               buf_rec-list.recCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     1644                           .
     1645                           if buf_rec-list.recLevel > 0
     1646                           then do:
     1647                               assign
     1648                                   buf_rec-list.recLevel = buf_rec-list.recLevel - 1
     1649                               .
     1650                               for each buf_rec-fld-list
     1651                                  where buf_rec-fld-list.recName = buf_rec-list.recName
     1652                               :
     1653                                   assign
     1654                                       buf_rec-fld-list.recLevel = buf_rec-fld-list.recLevel - 1
     1655                                   .
     1656                               end.
     1657                           end.
     1658                           else do:
     1659                               assign
     1660                                   buf_rec-list.closed         = yes
     1661                               .
     1662                           end.
     1663                       end.
     1664                   end.
     1665                   else do:
     1666                       find last buf_rec-fld
     1667                           where buf_rec-fld.rec-key = buf_rec.rec-key
     1668                             and buf_rec-fld.fldName = buf_rec-fld-list.fldName
     1669                             and buf_rec-fld.closed  = no
     1670                       use-index nm
     1671                       no-error.
     1672                       if not available buf_rec-fld
     1673                       then do:
     1674                           run xmllib-parse-error in this-procedure (
     1675                               input substitute( "Ошибка 2 закрытия поля <&1>: Не найдено открытое поле с этим именем в записи <&2> уровня &3."
     1676                                               , buf_rec-fld-list.fldName
     1677                                               , buf_rec.recName
     1678                                               , buf_rec.recLevel
     1679                                               )
     1680                           ).
     1681                       end.
     1682                       else do:
     1683                           assign
     1684                               buf_rec-fld.closed              = yes
     1685                               buf_rec-fld-list.closed         = yes
     1686                               buf_rec-fld.fldCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     1687                               buf_rec-fld-list.fldCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     1688                           .
     1689                       end.
     1690                   end.
     1691               end.
     1692           end.
     1693       end.
     1694       else do:
     1695           close-field-rec:
     1696           for each buf_rec-fld-list
     1697              where buf_rec-fld-list.fldName = p-q-name
     1698           :
     1699               find first buf_rec-list
     1700                    where buf_rec-list.recName  = buf_rec-fld-list.recName
     1701                      and buf_rec-list.recLevel = buf_rec-fld-list.recLevel
     1702                      and buf_rec-list.closed   = no
     1703               no-error.
     1704               if available buf_rec-list
     1705               then do:
     1706                   find last buf_rec
     1707                       where buf_rec.recName  = buf_rec-list.recName
     1708                         and buf_rec.recLevel = buf_rec-list.recLevel
     1709                         and buf_rec.closed   = no
     1710                   use-index nm
     1711                   no-error.
     1712                   if not available buf_rec
     1713                   then do:
     1714                       run xmllib-parse-error in this-procedure (
     1715                           input substitute( "Ошибка закрытия поля <&1>: Нет открытой записи."
     1716                                           , p-q-name
     1717                                           )
     1718                       ).
     1719                   end.
     1720                   else do:
     1721                       find last buf_rec-fld
     1722                           where buf_rec-fld.rec-key = buf_rec.rec-key
     1723                             and buf_rec-fld.fldName = buf_rec-fld-list.fldName
     1724                             and buf_rec-fld.closed  = no
     1725                       use-index nm
     1726                       no-error.
     1727                       if not available buf_rec-fld
     1728                       then do:
     1729                           run xmllib-parse-error in this-procedure (
     1730                               input substitute( "Ошибка 1 закрытия поля <&1>: Не найдено открытое поле с этим именем в записи <&2> уровня &3."
     1731                                               , buf_rec-fld-list.fldName
     1732                                               , buf_rec.recName
     1733                                               , buf_rec.recLevel
     1734                                               )
     1735                           ).
     1736                       end.
     1737                       else do:
     1738                           assign
     1739                               buf_rec-fld.closed              = yes
     1740                               buf_rec-fld-list.closed         = yes
     1741                               buf_rec-fld.fldCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     1742                               buf_rec-fld-list.fldCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     1743                           .
     1744                       end.
     1745                   end.
     1746                   leave close-field-rec.
     1747               end.
     1748           end.
     1749       end.
     1750   end.
     1751   end procedure.
     1752   procedure Error :
     1753   define input parameter p-error-message     as character        no-undo.
     1754   do
     1755   on error undo, return error
     1756   :
     1757       run xmllib-parse-error in this-procedure (
     1758           input p-error-message
     1759       ).
     1760       assign
     1761           v-xmllib-error-status = yes
     1762       .
     1763   end.
     1764   end procedure.
     1765   procedure xmllib-parse-error :
     1766   define input parameter p-err-message    as character        no-undo.
     1767   do
     1768   on error undo, return error
     1769   :
     1770       if valid-handle(v-xmllib-log-handle) then do:
     1771         run value(v-xmllib-log-proc-name) in  v-xmllib-log-handle
     1772                  (input substitute("&1Файл:    &2 &3&1Строка &4&1&5"
     1773                                    ,chr(10)
     1774                                    ,v-xmllib-dirname
     1775                                    ,v-xmllib-filename
     1776                                    ,(if valid-handle(v-xmllib-sax-reader-handle)
     1777                                      then v-xmllib-sax-reader-handle :locator-line-number
     1778                                      else ?)
     1779                                    ,p-err-message)).
     1780       end.
     1781       else do:
     1782         if v-xmllib-log-filename = "":U
     1783         then do:
     1784             message
     1785                     vss-workfile vss-revision vss-description
     1786                 skip "Файл:   " v-xmllib-dirname v-xmllib-filename
     1787                 skip "Строка: " (if valid-handle(v-xmllib-sax-reader-handle)
     1788                                  then v-xmllib-sax-reader-handle :locator-line-number
     1789                                  else ?)
     1790                 skip(1)
     1791                 skip p-err-message
     1792                 skip return-value
     1793                 skip trim( error-status :get-message( 1 ) )
     1794                     trim( error-status :get-message( 2 ) )
     1795                     trim( error-status :get-message( 3 ) )
     1796             view-as alert-box error.
     1797             undo, return error.
     1798         end.
     1799         else do:
     1800           output to value( v-xmllib-log-filename ).
     1801           put unformatted
     1802               substitute( "&1&2", chr(10), p-err-message )
     1803           .
     1804           output close.
     1805         end.
     1806       end.
     1807   end.
     1808   end procedure.
     1809   procedure xmllib-set-log-filename :
     1810   define input parameter p-log-filename   as character        no-undo.
     1811   do
     1812   on error undo, return error
     1813   :
     1814       run gbl/fileapnd.p (
     1815             input p-log-filename
     1816           , input "":U
     1817           , input 10
     1818       ) no-error.
     1819       if error-status :error
     1820       then do:
     1821           assign
     1822               v-xmllib-log-filename = "":U
     1823           .
     1824       end.
     1825       else do:
     1826           assign
     1827               v-xmllib-log-filename = p-log-filename
     1828           .
     1829       end.
     1830   end.
     1831   end procedure.
     1832   procedure xmllib-set-log-handle :
     1833   define input parameter p-log-handle    as handle        no-undo.
     1834   define input parameter p-log-proc-name as character no-undo .
     1835   do
     1836   on error undo, return error
     1837   :
     1838       if valid-handle(p-log-handle)
     1839       and lookup(p-log-proc-name, p-log-handle:internal-entries) > 0
     1840       then do:
     1841         assign
     1842         v-xmllib-log-handle    = p-log-handle
     1843         v-xmllib-log-proc-name = p-log-proc-name
     1844         .
     1845       end.
     1846       else do:
     1847         assign
     1848         v-xmllib-log-handle    = ?
     1849         v-xmllib-log-proc-name = '':U
     1850         .
     1851       end.
     1852   end.
     1853   end procedure.
     1854   procedure xmllib-set-prg-bar-handle :
     1855   define input parameter p-handle    as handle        no-undo.
     1856   do
     1857   on error undo, return error
     1858   :
     1859       if valid-handle(p-handle)
     1860       then do:
     1861         assign
     1862           v-xmllib-prg-bar-handle = p-handle
     1863         .
     1864       end.
     1865       else do:
     1866         assign
     1867           v-xmllib-prg-bar-handle = ?
     1868         .
     1869       end.
     1870   end.
     1871   end procedure.
     1872   procedure xmllib-set-codepage-convert :
     1873     define input  parameter p-codepage-source as character no-undo .
     1874     define input  parameter p-codepage-target as character no-undo .
     1875   do
     1876   on error undo, return error return-value
     1877   :
     1878     if ( p-codepage-source <> "" and p-codepage-target <> "" )
     1879     then do:
     1880       assign
     1881         v-xmllib-codepage-convert = yes
     1882         v-xmllib-codepage-source  = p-codepage-source
     1883         v-xmllib-codepage-target  = p-codepage-target
     1884       .
     1885     end.
     1886     else do:
     1887       assign
     1888         v-xmllib-codepage-convert = no
     1889         v-xmllib-codepage-source  = ""
     1890         v-xmllib-codepage-target  = ""
     1891       .
     1892     end.
     1893   end.
     1894   end procedure.
     1895   procedure xmllib-parse-rec-open :
     1896   define input parameter p-rec-name   as character        no-undo.
     1897   define input parameter p-rec-level  as integer          no-undo.
     1898       define buffer buf_temp_xmllib_rec       for temp_xmllib_rec.
     1899   do
     1900   for buf_temp_xmllib_rec
     1901   on error undo, return error
     1902   :
     1903        find first buf_temp_xmllib_rec
     1904            where buf_temp_xmllib_rec.recName = p-rec-name
     1905              and buf_temp_xmllib_rec.recLevel = p-rec-level
     1906              and buf_temp_xmllib_rec.closed  = no
     1907       use-index nm
     1908       no-error.
     1909       if available buf_temp_xmllib_rec
     1910       then do:
     1911           run xmllib-parse-error in this-procedure (
     1912               input substitute( "Ошибка 2 открытия записи <&1>: Запись с этим именем и уровнем &2 уже открыта на строке &3."
     1913                               , p-rec-name
     1914                               , p-rec-level
     1915                               , buf_temp_xmllib_rec.recOpenLine
     1916                               )
     1917           ).
     1918       end.
     1919       else do:
     1920           assign
     1921               v-xmllib-rec-key    = v-xmllib-rec-key + 1
     1922           .
     1923           create buf_temp_xmllib_rec.
     1924           assign
     1925               buf_temp_xmllib_rec.rec-key         = v-xmllib-rec-key
     1926               buf_temp_xmllib_rec.recOpenLine     = v-xmllib-sax-reader-handle :locator-line-number
     1927               buf_temp_xmllib_rec.recCloseLine    = 0
     1928               buf_temp_xmllib_rec.recName         = p-rec-name
     1929               buf_temp_xmllib_rec.recLevel        = p-rec-level
     1930               buf_temp_xmllib_rec.closed          = no
     1931           .
     1932       end.
     1933   end.
     1934   end procedure.
     1935   procedure xmllib-parse-rec-fld-open :
     1936   define input parameter p-rec-name   as character        no-undo.
     1937   define input parameter p-rec-level  as integer          no-undo.
     1938   define input parameter p-fld-name   as character        no-undo.
     1939       define buffer buf_temp_xmllib_rec       for temp_xmllib_rec.
     1940       define buffer buf_temp_xmllib_rec-fld   for temp_xmllib_rec-fld.
     1941   do
     1942   for buf_temp_xmllib_rec
     1943     , buf_temp_xmllib_rec-fld
     1944   on error undo, return error substitute( "Ошибка в xmllib-parse-rec-fld-open. &1. &2. &3"
     1945                                           , return-value
     1946                                           , trim( error-status :get-message( 1 ) )
     1947                                           , trim( error-status :get-message( 2 ) ) )
     1948   :
     1949       find last buf_temp_xmllib_rec
     1950           where buf_temp_xmllib_rec.recName   = p-rec-name
     1951             and buf_temp_xmllib_rec.recLevel  = p-rec-level
     1952             and buf_temp_xmllib_rec.closed    = no
     1953       use-index nm
     1954       no-error.
     1955       if not available buf_temp_xmllib_rec
     1956       then do:
     1957           run xmllib-parse-error in this-procedure (
     1958               input substitute( "Ошибка 2 открытия поля <&2> в записи <&1> уровня &3: Нет открытой записи."
     1959                               , p-rec-name
     1960                               , p-fld-name
     1961                               , p-rec-level
     1962                               )
     1963           ).
     1964       end.
     1965       else do:
     1966           find last buf_temp_xmllib_rec-fld
     1967               where buf_temp_xmllib_rec-fld.rec-key  = buf_temp_xmllib_rec.rec-key
     1968                 and buf_temp_xmllib_rec-fld.fldName  = p-fld-name
     1969                 and buf_temp_xmllib_rec-fld.closed   = no
     1970           use-index nm
     1971           no-error.
     1972           if available buf_temp_xmllib_rec-fld
     1973           then do:
     1974               run xmllib-parse-error in this-procedure (
     1975                   input substitute( "Ошибка 3 открытия поля <&2> в записи <&1>: Поле с этим именем уже открыто на строке &3."
     1976                                   , p-rec-name
     1977                                   , p-fld-name
     1978                                   , buf_temp_xmllib_rec-fld.fldOpenLine
     1979                                   )
     1980               ).
     1981           end.
     1982           else do:
     1983               assign
     1984                   v-xmllib-rec-fld-key    = v-xmllib-rec-fld-key + 1
     1985               .
     1986               create buf_temp_xmllib_rec-fld.
     1987               assign
     1988                   buf_temp_xmllib_rec-fld.fld-key         = v-xmllib-rec-fld-key
     1989                   buf_temp_xmllib_rec-fld.rec-key         = buf_temp_xmllib_rec.rec-key
     1990                   buf_temp_xmllib_rec-fld.fldOpenLine     = v-xmllib-sax-reader-handle :locator-line-number
     1991                   buf_temp_xmllib_rec-fld.fldCloseLine    = 0
     1992                   buf_temp_xmllib_rec-fld.fldName         = p-fld-name
     1993                   buf_temp_xmllib_rec-fld.closed          = no
     1994               .
     1995           end.
     1996       end.
     1997   end.
     1998   end procedure.
     1999   define stream out-stream.
     2000   define temp-table temp_table no-undo
     2001       field dtt-name  as character
     2002       field dtt-tag   as character
     2003       index pi is primary unique
     2004           dtt-name
     2005   .
     2006   define temp-table temp_table-field no-undo
     2007       field dtt-name  as character
     2008       field dtf-name  as character
     2009       field dtf-tag   as character
     2010       index pi is primary unique
     2011           dtt-name
     2012           dtf-name
     2013   .
     2014       define variable v-cur-db-num        as integer      no-undo.
     2015       define variable v-esys-id           as integer      no-undo.
     2016       define variable v-db-num            as integer      no-undo.
     2017       define variable v-buffer-handle     as handle       no-undo.
     2018       define variable v-xml-file-name     as character    no-undo.
     2019       define variable v-log-file-name     as character    no-undo.
     2020       define variable v-list-file-name    as character    no-undo.
     2021       define variable v-tesr-key          as integer      no-undo.
     2022       define variable v-today             as date         no-undo.
     2023       define variable v-time              as integer      no-undo.
     2024       define variable v-parameter-list    as character    no-undo.
     2025       define variable v-action            as character    no-undo.
     2026       define buffer buf_ext-system                for ub.ext-system.
     2027       define buffer buf_esys-datatype-exp         for ub.esys-datatype-exp.
     2028       define buffer buf_datatype-exp              for ub.datatype-exp.
     2029       define buffer buf_datatype-table-exp        for ub.datatype-table-exp.
     2030       define buffer buf_datatype-table-field-exp  for ub.datatype-table-field-exp.
     2031       define buffer buf_temp_table                for temp_table.
     2032       define buffer buf_temp_table-field          for temp_table-field.
     2033       define buffer buf_datatype-table            for ub.datatype-table.
     2034       define buffer buf_datatype-table-field      for ub.datatype-table-field.
     2035   do
     2036   for buf_ext-system
     2037     , buf_esys-datatype-exp
     2038     , buf_datatype-exp
     2039     , buf_datatype-table-exp
     2040     , buf_datatype-table-field-exp
     2041     , buf_temp_table
     2042     , buf_temp_table-field
     2043     , buf_datatype-table
     2044     , buf_datatype-table-field
     2045   on error undo, return error
     2046   :
     2047       assign
     2048           v-cur-db-num = integer( entry( 1, p-parameter-string ) )
     2049           v-esys-id    = integer( entry( 2, p-parameter-string ) )
     2050           v-db-num     = integer( entry( 3, p-parameter-string ) )
     2051       .
     2052       find first buf_ext-system no-lock
     2053            where buf_ext-system.esys-id = v-esys-id
     2054              and buf_ext-system.db-num  = v-db-num
     2055       no-error.
     2056       if available buf_ext-system
     2057       then do:
     2058           if buf_ext-system.esys-have-export = yes
     2059           and buf_ext-system.esys-status     <> 0
     2060           then do:
     2061               run write-log in p-log-handle (
     2062                     input 1
     2063                   , input substitute( "Выгрузка данных по внешней системе '&1'... ", buf_ext-system.esys-name )
     2064               ).
     2065               run xmllib-filename in this-procedure (
     2066                     input "":U
     2067                   , input "o":U
     2068                   , output v-xml-file-name
     2069                   , output v-log-file-name
     2070                   , output v-list-file-name
     2071               ).
     2072               assign
     2073                   v-list-file-name = "":U
     2074                   v-parameter-list = substitute( "&1,&2,&3,&4,&5,&6,&7"
     2075                                                   , 5
     2076                                                   , "format":U
     2077                                                   , "Trade House OpenXML 1.0":U
     2078                                                   , "version":U
     2079                                                   , trim( replace( substring( vss-archive, 15, 4 ), "$":U, "":U ) )
     2080                                                   , "revision":U
     2081                                                   , trim( replace( substring( vss-revision, 12 ), "$":U, "":U ) )
     2082                                               )
     2083                   v-parameter-list = substitute( "&1,&2,&3,&4,&5"
     2084                                                   , v-parameter-list
     2085                                                   , "esysName":U
     2086                                                   , buf_ext-system.esys-name
     2087                                                   , "currentDbNum":U
     2088                                                   , string( v-cur-db-num )
     2089                                               )
     2090               .
     2091               run xmllib-write-header in this-procedure (
     2092                     input yes
     2093                   , input v-xml-file-name
     2094                   , input v-list-file-name
     2095                   , input 1
     2096                   , input no
     2097                   , input "":U
     2098                   , input v-parameter-list
     2099               ).
     2100               for each buf_esys-datatype-exp no-lock
     2101                  where buf_esys-datatype-exp.esys-id      = buf_ext-system.esys-id
     2102                    and buf_esys-datatype-exp.db-num       = buf_ext-system.db-num
     2103                    and buf_esys-datatype-exp.ede-status   <> 0
     2104               on error undo, return error
     2105               :
     2106                   find first buf_datatype-exp no-lock
     2107                        where buf_datatype-exp.dte-id = buf_esys-datatype-exp.dte-id
     2108                   no-error.
     2109                   if available buf_datatype-exp
     2110                   and buf_datatype-exp.dte-status <> 0
     2111                   then do:
     2112                       for each buf_datatype-table-exp no-lock
     2113                          where buf_datatype-table-exp.dte-id      = buf_datatype-exp.dte-id
     2114                            and buf_datatype-table-exp.dtte-status <> 0
     2115                       on error undo, return error
     2116                       :
     2117                           find first buf_temp_table
     2118                                where buf_temp_table.dtt-name = buf_datatype-table-exp.dtt-name
     2119                           no-error.
     2120                           if not available buf_temp_table
     2121                           then do:
     2122                               find first buf_datatype-table no-lock
     2123                                    where buf_datatype-table.dtt-name = buf_datatype-table-exp.dtt-name
     2124                               no-error.
     2125                               create buf_temp_table.
     2126                               assign
     2127                                   buf_temp_table.dtt-name = buf_datatype-table-exp.dtt-name
     2128                                   buf_temp_table.dtt-tag  = ( if available buf_datatype-table
     2129                                                               then buf_datatype-table.dtt-xml-tag
     2130                                                               else "TH_" + buf_datatype-table-exp.dtt-name )
     2131                               .
     2132                           end.
     2133                           for each buf_datatype-table-field-exp no-lock
     2134                              where buf_datatype-table-field-exp.dte-id    = buf_datatype-table-exp.dte-id
     2135                                and buf_datatype-table-field-exp.dtt-name  = buf_datatype-table-exp.dtt-name
     2136                           on error undo, return error
     2137                           :
     2138                               find first buf_temp_table-field
     2139                                    where buf_temp_table-field.dtt-name = buf_datatype-table-field-exp.dtt-name
     2140                                      and buf_temp_table-field.dtf-name = buf_datatype-table-field-exp.dtf-name
     2141                               no-error.
     2142                               if not available buf_temp_table-field
     2143                               then do:
     2144                                   find first buf_datatype-table-field no-lock
     2145                                        where buf_datatype-table-field.dtt-name = buf_datatype-table-field-exp.dtt-name
     2146                                          and buf_datatype-table-field.dtf-name = buf_datatype-table-field-exp.dtf-name
     2147                                   no-error.
     2148                                   create buf_temp_table-field.
     2149                                   assign
     2150                                       buf_temp_table-field.dtt-name = buf_datatype-table-field-exp.dtt-name
     2151                                       buf_temp_table-field.dtf-name = buf_datatype-table-field-exp.dtf-name
     2152                                       buf_temp_table-field.dtf-tag  = ( if available buf_datatype-table-field
     2153                                                                         then buf_datatype-table-field.dtf-xml-tag
     2154                                                                         else "TH_" + buf_datatype-table-field-exp.dtf-name )
     2155                                   .
     2156                               end.
     2157                           end.
     2158                       end.
     2159                   end.
     2160               end.
     2161               OUTPUT STREAM stmXMLOut TO VALUE( v-xml-file-name + "tmp" ) CONVERT TARGET "1251" APPEND.
     2162               run export-tables in this-procedure .
     2163               OUTPUT STREAM stmXMLOut close.
     2164               run xmllib-write-footer in this-procedure (
     2165                     input yes
     2166                   , input v-xml-file-name
     2167                   , input v-list-file-name
     2168                   , input no
     2169                   , input "":U
     2170               ).
     2171               run write-log in p-log-handle (
     2172                     input 1
     2173                   , input substitute( "Выгрузка данных по внешней системе '&1' завершена. ", buf_ext-system.esys-name )
     2174               ).
     2175           end.
     2176       end.
     2177   end.
     2178   procedure export-tables :
     2179       define variable v-bh            as handle       no-undo.
     2180       define variable v-qh            as handle       no-undo.
     2181       define variable v-query         as character    no-undo.
     2182       define variable v-buffer-name   as character    no-undo.
     2183       define buffer buf_temp_table                for temp_table.
     2184       define buffer buf_temp_table-field          for temp_table-field.
     2185   do
     2186   for buf_temp_table
     2187     , buf_temp_table-field
     2188   on error undo, return error
     2189   :
     2190       for each buf_temp_table
     2191       on error undo, return error
     2192       :
     2193           run xmllib-tag-open in this-procedure ( input 1, input buf_temp_table.dtt-tag, input "":U ).
     2194           run xmllib-tag-put in this-procedure ( input 2, input "TH__record-action"    , input "export":U    , input 0 ).
     2195           assign
     2196               v-buffer-name = "buf_" + buf_temp_table.dtt-name
     2197           .
     2198           create buffer v-bh for table buf_temp_table.dtt-name buffer-name v-buffer-name.
     2199           create query v-qh.
     2200           v-qh :set-buffers( v-bh ).
     2201           assign
     2202               v-query             = substitute( "for each &1 no-lock"
     2203                                                   , v-buffer-name )
     2204           .
     2205           v-qh :query-prepare( v-query ).
     2206           v-qh :query-open.
     2207           v-qh :get-first.
     2208           if v-qh :query-off-end = no
     2209           then do:
     2210               export-table:
     2211               do
     2212               while yes
     2213               on error undo, return error
     2214               :
     2215                   v-qh :get-next.
     2216                   if v-qh :query-off-end = yes
     2217                   then do:
     2218                       undo export-table, leave export-table.
     2219                   end.
     2220                   for each buf_temp_table-field
     2221                   on error undo, return error
     2222                   :
     2223                       run xmllib-tag-put in this-procedure (
     2224                             input 2
     2225                           , input buf_temp_table-field.dtf-tag
     2226                           , input v-bh :buffer-field( buf_temp_table-field.dtf-name ) :buffer-value
     2227                           , input 0
     2228                       ).
     2229                   end.
     2230               end.
     2231           end.
     2232           delete object v-qh.
     2233           delete object v-bh.
     2234           run xmllib-tag-close in this-procedure ( input 1, input buf_temp_table.dtt-tag ).
     2235       end.
     2236   end.
     2237   end procedure.
