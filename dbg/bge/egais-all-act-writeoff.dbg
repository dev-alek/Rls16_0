      441   procedure thbjattr_delete-section :
      442   define input  parameter p-obj-type   like ub.thbj-attr.obj-type   no-undo .
      443   define input  parameter p-obj-code   like ub.thbj-attr.obj-code   no-undo .
      444   define input  parameter p-upper-code like ub.thbj-attr.upper-prop-code  no-undo .
      445   do
      446   on error undo, return error return-value
      447   :
      448       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_delete-section in g#attr-lib
      449       (input  p-obj-type
      450       ,input  p-obj-code
      451       ,input  p-upper-code
      452       ) no-error .
      453     if error-status :error
      454     then do:
      455       undo, return error return-value .
      456     end.
      457   end.
      458   end procedure.
      459   procedure thbjattr_manual-edit :
      460   define input  parameter p-ucode          as character no-undo .
      461   define input  parameter p-code           as character no-undo .
      462   define output parameter p-section-num    as integer no-undo .
      463   do
      464   on error undo, return error return-value
      465   :
      466       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_manual-edit in g#attr-lib
      467       (input  p-ucode
      468       ,input  p-code
      469       ,output  p-section-num
      470       ) no-error .
      471     if error-status :error
      472     then do:
      473       undo, return error return-value .
      474     end.
      475   end.
      476   end procedure.
      477   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      478   define temp-table tt-act-header
      479       field num           as character        label "№ акта"      format "X(30)"
      480       field date_         as date             label "Дата акта"
      481       field type_         as character        label "Основание списания" format "X(18)"
      482       field is-sent       as logical
      483       field answer_       as character        label "Ответ"       format "X(1500)"
      484       field RegID         as character        label "Рег. номер"  format "X(50)"
      485       index pi as primary unique
      486           num
      487   .
      488   define temp-table tt-gds-act
      489       field num           as character                label "№ акта"
      490       field position_     as integer                  label "№ пп"                    format ">>>9"
      491       field gds-code      like ub.goods.gds-code      label "Код товара   "
      492       field alc-code      as character                label "Алкогольный код"         format "X(21)"
      493       field gds-name      like ub.goods.gds-name      label "Наименование товара"     format "X(35)"
      494       field qnty          as decimal                  label "Количество"
      495       field inform-B      as character                label "Справка Б"               format "X(20)"
      496       field marks-qnty    as integer                  label "Кол-во марок"
      497       field egais-name    as character
      498       index pi as primary unique
      499           num position_
      500       index code
      501           gds-code
      502   .
      503   define new shared temp-table tt-marks
      504       field num                 as character            label "№ акта"
      505       field gds-part-position_  as integer
      506       field mark                as character            label "Марка"          format "X(100)"
      507       field new_                as logical
      508       field gds-code            like ub.goods.gds-code  LABEL "Код товара"
      509       field gds-name            as character            LABEL "Наименование"   FORMAT "X(30)"
      510       field alc-code            as character            LABEL "Алк. код"       FORMAT "X(20)"
      511       field impor-full-name     as character            LABEL "Импортер"       FORMAT "X(130)"
      512       field prod-full-name      as character            LABEL "Производитель"  FORMAT "X(130)"
      513       field flag                as logical              label "T"
      514       index pi as primary unique
      515           mark
      516   .
      517   define variable sw as handle no-undo .
      518   define variable v-file              as character no-undo initial "ActWriteOff1.xml".
      519   DEFINE VARIABLE hDoc AS HANDLE NO-UNDO.
      520   DEFINE VARIABLE hRoot AS HANDLE NO-UNDO.
      521   DEFINE VARIABLE good AS LOGICAL NO-UNDO.
      522   procedure makeXML :
      523       create sax-writer sw .
      524       sw:formatted = true.
      525       sw:set-output-destination ("file", v-file).
      526       sw:encoding = "UTF-8".
      527       sw:start-document () .
      528       sw:start-element ("ns:Documents") .
      529       sw:insert-attribute ("Version", "1.0") .
      530       sw:insert-attribute ("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance") .
      531       sw:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01") .
      532       sw:insert-attribute ("xmlns:pref", "http://fsrar.ru/WEGAIS/ProductRef") .
      533       sw:insert-attribute ("xmlns:awr", "http://fsrar.ru/WEGAIS/ActWriteOff") .
      534           sw:start-element ("ns:Owner") .
      535               sw:write-data-element ("ns:FSRAR_ID", v-fs-rar) .
      536           sw:end-element ("ns:Owner") .
      537           sw:start-element ("ns:Document") .
      538               sw:start-element ("ns:ActWriteOff") .
      539                   sw:write-data-element ("awr:Identity", tt-act-header.num) no-error .
      540                   sw:start-element ("awr:Header") .
      541                       sw:write-data-element ("awr:ActNumber", tt-act-header.num) no-error .
      542                       sw:write-data-element ("awr:ActDate", string(iso-date(tt-act-header.date_))) no-error .
      543                       sw:write-data-element ("awr:TypeWriteOff", tt-act-header.type_) no-error .
      544                       sw:write-data-element ("awr:Note", "Необходимо списать товарные позиции с баланса") .
      545                   sw:end-element ("awr:Header") .
      546                   sw:start-element ("awr:Content") .
      547       for each tt-gds-act no-lock where tt-gds-act.num = tt-act-header.num :
      548                       sw:start-element ("awr:Position") .
      549                           sw:write-data-element ("awr:Identity", string(tt-gds-act.position_)) no-error .
      550                           sw:write-data-element ("awr:Quantity", string(tt-gds-act.qnty)) no-error .
      551                           sw:write-data-element ("gds-code", string(tt-gds-act.gds-code)) no-error .
      552                           sw:write-data-element ("gds-name", tt-gds-act.gds-name) no-error .
      553                           sw:write-data-element ("alc-code", tt-gds-act.alc-code) no-error .
      554                           sw:start-element ("awr:InformB") .
      555                               sw:write-data-element ("pref:BRegId", tt-gds-act.inform-B) no-error .
      556                           sw:end-element ("awr:InformB") .
      557                           sw:start-element ("awr:MarkCodeInfo") .
      558               for each tt-marks no-lock where tt-marks.num = tt-gds-act.num and tt-marks.gds-part-position_ = tt-gds-act.position_ :
      559                               sw:write-data-element ("awr:MarkCode", tt-marks.mark) .
      560               end.
      561                           sw:end-element ("awr:MarkCodeInfo") .
      562                       sw:end-element ("awr:Position") .
      563       end.
      564                   sw:end-element ("awr:Content") .
      565               sw:end-element ("ns:ActWriteOff") .
      566           sw:end-element ("ns:Document") .
      567       sw:end-element ("ns:Documents") .
      568       sw:end-document () .
      569       delete object sw.
      570   end procedure .
      571   procedure makeXMLegais :
      572       create sax-writer sw .
      573       sw:formatted = true.
      574       sw:set-output-destination ("file", v-file).
      575       sw:encoding = "UTF-8".
      576       sw:start-document () .
      577       sw:start-element ("ns:Documents") .
      578       sw:insert-attribute ("Version", "1.0") .
      579       sw:insert-attribute ("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance") .
      580       sw:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01") .
      581       sw:insert-attribute ("xmlns:pref", "http://fsrar.ru/WEGAIS/ProductRef") .
      582       sw:insert-attribute ("xmlns:awr", "http://fsrar.ru/WEGAIS/ActWriteOff") .
      583           sw:start-element ("ns:Owner") .
      584               sw:write-data-element ("ns:FSRAR_ID", v-fs-rar) .
      585           sw:end-element ("ns:Owner") .
      586           sw:start-element ("ns:Document") .
      587               sw:start-element ("ns:ActWriteOff") .
      588                   sw:write-data-element ("awr:Identity", tt-act-header.num) .
      589                   sw:start-element ("awr:Header") .
      590                       sw:write-data-element ("awr:ActNumber", tt-act-header.num) .
      591                       sw:write-data-element ("awr:ActDate", string(iso-date(tt-act-header.date_))) no-error .
      592                       sw:write-data-element ("awr:TypeWriteOff", tt-act-header.type_) .
      593                       sw:write-data-element ("awr:Note", "Необходимо списать товарные позиции с баланса") .
      594                   sw:end-element ("awr:Header") .
      595                   sw:start-element ("awr:Content") .
      596       for each tt-gds-act no-lock where tt-gds-act.num = tt-act-header.num :
      597           if tt-gds-act.qnty <= 0 or trim(tt-gds-act.inform-B) = "" or tt-gds-act.inform-B = ? then next.
      598                       sw:start-element ("awr:Position") .
      599                           sw:write-data-element ("awr:Identity", string(tt-gds-act.position_)) .
      600                           sw:write-data-element ("awr:Quantity", string(tt-gds-act.qnty)) .
      601                           sw:start-element ("awr:InformB") .
      602                               sw:write-data-element ("pref:BRegId", tt-gds-act.inform-B) .
      603                           sw:end-element ("awr:InformB") .
      604                       sw:end-element ("awr:Position") .
      605       end.
      606                   sw:end-element ("awr:Content") .
      607               sw:end-element ("ns:ActWriteOff") .
      608           sw:end-element ("ns:Document") .
      609       sw:end-element ("ns:Documents") .
      610       sw:end-document () .
      611       delete object sw.
      612   end procedure .
      613   procedure makeXMLegais_v2 :
      614       create sax-writer sw .
      615       sw:formatted = true.
      616       sw:set-output-destination ("file", v-file).
      617       sw:encoding = "UTF-8".
      618       sw:start-document () .
      619       sw:start-element ("ns:Documents") .
      620       sw:insert-attribute ("Version", "1.0") .
      621       sw:insert-attribute ("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance") .
      622       sw:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01") .
      623       sw:insert-attribute ("xmlns:pref", "http://fsrar.ru/WEGAIS/ProductRef_v2") .
      624       sw:insert-attribute ("xmlns:awr", "http://fsrar.ru/WEGAIS/ActWriteOff_v2") .
      625       sw:insert-attribute ("xmlns:ce", "http://fsrar.ru/WEGAIS/CommonEnum") .
      626           sw:start-element ("ns:Owner") .
      627               sw:write-data-element ("ns:FSRAR_ID", v-fs-rar) .
      628           sw:end-element ("ns:Owner") .
      629           sw:start-element ("ns:Document") .
      630               sw:start-element ("ns:ActWriteOff_v2") .
      631                   sw:write-data-element ("awr:Identity", tt-act-header.num) .
      632                   sw:start-element ("awr:Header") .
      633                       sw:write-data-element ("awr:ActNumber", tt-act-header.num) .
      634                       sw:write-data-element ("awr:ActDate", string(iso-date(tt-act-header.date_))) no-error .
      635                       sw:write-data-element ("awr:TypeWriteOff", tt-act-header.type_) .
      636                       sw:write-data-element ("awr:Note", "Необходимо списать товарные позиции с баланса") .
      637                   sw:end-element ("awr:Header") .
      638                   sw:start-element ("awr:Content") .
      639       for each tt-gds-act no-lock where tt-gds-act.num = tt-act-header.num :
      640           if tt-gds-act.qnty <= 0 or trim(tt-gds-act.inform-B) = "" or tt-gds-act.inform-B = ? then next.
      641                       sw:start-element ("awr:Position") .
      642                           sw:write-data-element ("awr:Identity", string(tt-gds-act.position_)) .
      643                           sw:write-data-element ("awr:Quantity", string(tt-gds-act.qnty)) .
      644                           sw:start-element ("awr:InformF1F2") .
      645                             sw:start-element ("awr:InformF2") .
      646                               sw:write-data-element ("pref:F2RegId", tt-gds-act.inform-B) .
      647                             sw:end-element ("awr:InformF2") .
      648                           sw:end-element ("awr:InformF1F2") .
      649           find first tt-marks where tt-marks.num = tt-gds-act.num and tt-marks.gds-part-position_ = tt-gds-act.position_ no-lock no-error.
      650           if available tt-marks and (tt-act-header.type_ = "Проверки" or tt-act-header.type_ = "Арест") then do :
      651                           sw:start-element ("awr:MarkCodeInfo") .
      652               for each tt-marks no-lock where tt-marks.num = tt-gds-act.num and tt-marks.gds-part-position_ = tt-gds-act.position_ :
      653                               sw:write-data-element ("awr:MarkCode", tt-marks.mark) .
      654               end.
      655                           sw:end-element ("awr:MarkCodeInfo") .
      656           end.
      657                       sw:end-element ("awr:Position") .
      658       end.
      659                   sw:end-element ("awr:Content") .
      660               sw:end-element ("ns:ActWriteOff_v2") .
      661           sw:end-element ("ns:Document") .
      662       sw:end-element ("ns:Documents") .
      663       sw:end-document () .
      664       delete object sw.
      665   end procedure .
      666   procedure parseXML :
      667       define input parameter inFile as character no-undo .
      668       empty temp-table tt-act-header .
      669       empty temp-table tt-gds-act .
      670       CREATE X-DOCUMENT hDoc.
      671       CREATE X-NODEREF hRoot.
      672       hDoc:encoding = 'utf-8'.
      673       hDoc:LOAD("file", search(inFile),FALSE).
      674       hDoc:GET-DOCUMENT-ELEMENT(hRoot).
      675       RUN GetChildren(hRoot, 1).
      676       DELETE OBJECT hDoc.
      677       DELETE OBJECT hRoot.
      678   end procedure .
      679   procedure GetChildren :
      680       DEFINE INPUT PARAMETER hParent AS HANDLE NO-UNDO.
      681       DEFINE INPUT PARAMETER level AS INTEGER NO-UNDO.
      682       DEFINE VARIABLE i AS INTEGER NO-UNDO.
      683       DEFINE VARIABLE hNoderef AS HANDLE NO-UNDO.
      684       DEFINE VARIABLE hText AS HANDLE NO-UNDO.
      685       CREATE X-NODEREF hNoderef.
      686       CREATE X-NODEREF hText .
      687       REPEAT i = 1 TO hParent:NUM-CHILDREN:
      688           good = hParent:GET-CHILD(hNoderef,i).
      689           IF NOT good THEN
      690               LEAVE.
      691           IF hNoderef:SUBTYPE <> "element" THEN
      692               NEXT.
      693           hNoderef:GET-CHILD(hText, 1) no-error .
      694           IF hNoderef:NAME = "awr:Header" THEN do :
      695               create tt-act-header .
      696               assign tt-act-header.is-sent = bh-act-header:buffer-field("is-sent"):buffer-value .
      697           end .
      698           .
      699           IF hNoderef:NAME = "awr:ActNumber" THEN assign tt-act-header.num    = hText:node-value no-error .
      700           IF hNoderef:NAME = "awr:ActDate" THEN
      701               assign tt-act-header.date_ = date(substring(hText:node-value, 9, 2) + "/" + substring(hText:node-value, 6, 2) + "/" + substring(hText:node-value, 1, 4)) no-error .
      702           IF hNoderef:NAME = "awr:TypeWriteOff" THEN assign tt-act-header.type_    = hText:node-value no-error .
      703           IF hNoderef:NAME = "awr:Position" THEN do :
      704               assign ii = 0 .
      705               create tt-gds-act .
      706               assign tt-gds-act.num = tt-act-header.num .
      707           end.
      708           IF hNoderef:NAME = "awr:Identity" THEN assign tt-gds-act.position_ = integer(hText:node-value) no-error .
      709           IF hNoderef:NAME = "awr:Quantity" THEN assign tt-gds-act.qnty = decimal(hText:node-value) no-error .
      710           IF hNoderef:NAME = "pref:BRegId"
      711           OR hNoderef:NAME = "pref:F2RegId" THEN assign tt-gds-act.inform-B = (hText:node-value) no-error .
      712           IF hNoderef:NAME = "gds-code"     THEN do :
      713               assign tt-gds-act.gds-code = integer(hText:node-value) no-error .
      714               find first buf_goods no-lock where buf_goods.gds-code = tt-gds-act.gds-code no-error .
      715               if available buf_goods then assign tt-gds-act.gds-name = buf_goods.gds-name .
      716           end.
      717           if hNoderef:NAME = "gds-name" and trim(tt-gds-act.gds-name) = "" then assign tt-gds-act.gds-name = (hText:node-value) no-error .
      718           IF hNoderef:NAME = "alc-code"     THEN assign tt-gds-act.alc-code = (hText:node-value) no-error .
      719           IF hNoderef:NAME = "awr:MarkCode" THEN do :
      720               create tt-marks.
      721               assign
      722                   tt-marks.num                    = tt-gds-act.num
      723                   tt-marks.gds-part-position_     = tt-gds-act.position_
      724                   tt-marks.mark                   = hText:node-value
      725                   tt-marks.gds-code               = tt-gds-act.gds-code
      726                   tt-marks.gds-name               = tt-gds-act.gds-name
      727                   tt-marks.alc-code               = tt-gds-act.alc-code
      728                   ii = ii + 1.
      729               .
      730               assign tt-gds-act.marks-qnty = ii .
      731           end.
      732           run GetChildren (hNoderef, (level + 1)).
      733       END.
      734       DELETE OBJECT hNoderef.
      735       DELETE OBJECT hText.
      736   END procedure.
      737   DEFINE BUTTON Btn_lkp
      738        LABEL "Просмотр"
      739        SIZE 15 BY 1.13.
      740   DEFINE BUTTON Btn_create
      741        LABEL "Создать"
      742        SIZE 15 BY 1.13.
      743   DEFINE BUTTON Btn_chg
      744        LABEL "Изменить"
      745        SIZE 15 BY 1.13.
      746   DEFINE BUTTON Btn_del
      747        LABEL "Удалить"
      748        SIZE 15 BY 1.13.
      749   DEFINE BUTTON Btn_send
      750        LABEL "Отправить"
      751        SIZE 15 BY 1.13.
      752   DEFINE BUTTON Btn_OK AUTO-GO
      753        LABEL "Выход"
      754        SIZE 15 BY 1.13
      755        BGCOLOR 8 .
      756   DEFINE BUTTON Btn_Ans
      757        LABEL "Посмотреть ответ"
      758        SIZE 20 BY 1.13
      759        BGCOLOR 8 .
      760   DEFINE BUTTON Btn_Sel AUTO-GO
      761        LABEL "Выбор"
      762        SIZE 15 BY 1.13
      763        BGCOLOR 8 .
      764   DEFINE BUTTON Btn_Edit
      765        LABEL "Редактировать"
      766        SIZE 15 BY 1.13 tooltip "Вернуть в 'Новые' для редактирования"
      767        BGCOLOR 8 .
      768   DEFINE VARIABLE f-date AS DATE FORMAT "99/99/99":U
      769        LABEL "Дата с"
      770        VIEW-AS FILL-IN
      771        SIZE 9.5 BY 1 NO-UNDO.
      772   DEFINE VARIABLE f-date-2 AS DATE FORMAT "99/99/99":U
      773        LABEL "по"
      774        VIEW-AS FILL-IN
      775        SIZE 9.5 BY 1 NO-UNDO.
      776   DEFINE VARIABLE RADIO-SET-1 AS INTEGER INITIAL 1
      777        VIEW-AS RADIO-SET HORIZONTAL
      778        RADIO-BUTTONS
      779             "Новые", 1,
      780             "Отправленные", 2
      781        SIZE 27 BY 1.25 NO-UNDO.
      782   DEFINE FRAME Dialog-Frame
      783        Btn_OK AT ROW 1.2 COL 2
      784        Btn_create at row 1.2 col 17
      785        Btn_chg at row 1.2 col 32
      786        Btn_del at row 1.2 col 47
      787        Btn_send at row 1.2 col 62
      788        Btn_Ans AT ROW 1.2 COL 32 WIDGET-ID 10
      789        Btn_lkp AT ROW 1.2 COL 17 WIDGET-ID 12
      790        Btn_Sel AT ROW 1.2 COL 17
      791        Btn_Edit AT ROW 1.2 COL 52
      792        RADIO-SET-1 AT ROW 1.2 COL 80 NO-LABEL WIDGET-ID 2
      793        f-date AT ROW 2.5 COL 8.63 COLON-ALIGNED WIDGET-ID 22
      794        f-date-2 AT ROW 2.5 COL 22.75 COLON-ALIGNED WIDGET-ID 26
      795        SPACE(2) SKIP(22.2)
      796       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      797            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      798            TITLE "Акты о списании товаров в ЕГАИС"
      799            DEFAULT-BUTTON Btn_OK WIDGET-ID 100.
      800   ASSIGN
      801          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      802          FRAME Dialog-Frame:HIDDEN           = TRUE.
      803   ON window-close OF FRAME Dialog-Frame
      804   do:
      805       delete object egais no-error .
      806     apply "END-ERROR":U to self.
      807   end.
      808   ON CHOOSE OF Btn_lkp IN FRAME Dialog-Frame
      809   DO:
      810       if not bh-act-header:available then return no-apply .
      811       run bge/egais-act-writeOff.w (parparentproc, 'ПРОСМОТР':U, egais, v-ext-sys, v-fs-rar, bh-act-header:handle) .
      812   END.
      813   ON CHOOSE OF Btn_Edit IN FRAME Dialog-Frame
      814   DO:
      815       if not bh-act-header:available then return no-apply .
      816       find last buf_clob-bind where buf_clob-bind.field-name_ = 'egais-awo':U and buf_clob-bind.uniq-key-rec = bh-act-header:buffer-field ("num"):buffer-value .
      817       entry(4, buf_clob-bind.descr, chr(4)) = string(no) no-error .
      818       entry(5, buf_clob-bind.descr, chr(4)) = "" no-error .
      819       entry(6, buf_clob-bind.descr, chr(4)) = "" no-error .
      820       bh-act-header:buffer-field ("is-sent"):buffer-value = string(no) no-error .
      821       bh-act-header:buffer-field ("answer_"):buffer-value = "" no-error .
      822       bh-act-header:buffer-field ("RegID"):buffer-value = "" no-error .
      823       find first ub.esys-all-attr
      824                   where ub.esys-all-attr.table-name = "esys-pck-sent"
      825                   and ub.esys-all-attr.attr-code = "egais"
      826                   and ub.esys-all-attr.key2       = 4
      827                   and ub.esys-all-attr.attr-value = buf_clob-bind.uniq-key-rec
      828                   no-error.
      829       if available (ub.esys-all-attr )
      830       then do:
      831         delete ub.esys-all-attr .
      832       end.
      833       run refresh-query .
      834   END.
      835   ON CHOOSE OF Btn_Sel IN FRAME Dialog-Frame
      836   DO:
      837       if not bh-act-header:available then return no-apply .
      838       assign p-RegID = bh-act-header:buffer-field ("RegID"):buffer-value .
      839       if p-RegID = "" or p-RegID = ? or num-entries(p-RegID, CHR(5)) <> 2 then do :
      840           message "Данный акт либо относится к старой версии ЕГАИС, либо по нему ещё не получен ответ (в этом случае нажмите кнопку 'Посмотреть ответ')." view-as alert-box .
      841           p-RegID = "" .
      842           return no-apply .
      843       end.
      844       if entry(2, p-RegID, CHR(5)) = "R" then do :
      845           message "Данный акт о списании был отклонён ЕГАИС. Чтобы узнать причину нажмите кнопку 'Посмотреть ответ'" view-as alert-box .
      846           p-RegID = "" .
      847           return no-apply .
      848       end.
      849       assign p-RegID = entry(1, p-RegID, CHR(5)) .
      850   END.
      851   ON CHOOSE OF Btn_create IN FRAME Dialog-Frame
      852   DO:
      853       run bge/egais-act-writeOff.w (parparentproc, 'ДОБАВЛЕНИЕ':U, egais, v-ext-sys, v-fs-rar, bh-act-header:handle) .
      854       bh-act-header = egais:GetHndlTable(3, "").
      855       run refresh-query.
      856   END.
      857   ON CHOOSE OF Btn_chg IN FRAME Dialog-Frame
      858   DO:
      859       if not bh-act-header:available then return no-apply .
      860       v-act-num = bh-act-header:buffer-field ("num"):buffer-value .
      861       run bge/egais-act-writeOff.w (parparentproc, 'ИЗМЕНЕНИЕ':U, egais, v-ext-sys, v-fs-rar, bh-act-header:handle) .
      862       bh-act-header = egais:GetHndlTable(3, "").
      863       run refresh-query.
      864   END.
      865   ON CHOOSE OF Btn_del IN FRAME Dialog-Frame
      866   DO:
      867       if not bh-act-header:available then return no-apply .
      868       find last buf_clob-bind where buf_clob-bind.field-name_ = 'egais-awo':U and buf_clob-bind.uniq-key-rec = bh-act-header:buffer-field ("num"):buffer-value .
      869       delete buf_clob-bind .
      870       bh-act-header:buffer-delete () .
      871       run refresh-query.
      872   END.
      873   ON CHOOSE OF Btn_send IN FRAME Dialog-Frame
      874   DO:
      875       if not bh-act-header:available then return no-apply .
      876       find last buf_clob-bind where buf_clob-bind.field-name_ = 'egais-awo':U and buf_clob-bind.uniq-key-rec = bh-act-header:buffer-field ("num"):buffer-value .
      877       find first buf_clob-data no-lock where buf_clob-data.db-num = buf_clob-bind.db-num and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
      878       os-delete "temp-ActWriteOff.xml".
      879       copy-lob
      880       from  object buf_clob-data.cdata
      881       to  file 'temp-ActWriteOff.xml'
      882       no-convert
      883       no-error .
      884       run parseXML in this-procedure (input "temp-ActWriteOff.xml") .
      885       find first tt-act-header .
      886       v-file = 'ActWriteOff.xml' .
      887       os-delete "ActWriteOff.xml" .
      888       if egais:VerXSD = "1" then run makeXMLegais .
      889       if egais:VerXSD = "2" then run makeXMLegais_v2 .
      890       egais:inNum = tt-act-header.num .
      891       egais:SendRequestUTM() .
      892       glog = egais:IsSent .
      893       glog = egais:StatusErr .
      894       if glog then do :
      895           message egais:Msg view-as alert-box.
      896           return no-apply.
      897       end.
      898       else do :
      899           entry (4, buf_clob-bind.descr, chr(4)) = "yes".
      900           bh-act-header:buffer-field ("is-sent"):buffer-value = true.
      901       end.
      902       run refresh-query.
      903       message "Акт " egais:inNum " отправлен" view-as alert-box .
      904   END.
      905   ON CHOOSE OF Btn_Ans IN FRAME Dialog-Frame
      906   DO:
      907     if not bh-act-header:available
      908       then return no-apply.
      909       v-act-num = bh-act-header:buffer-field ("num"):buffer-value .
      910         egais:inNum = bh-act-header:buffer-field ("num"):buffer-value .
      911         egais:GetHndlTable(2, bh-act-header:buffer-field ("num"):buffer-value) .
      912         glog = egais:StatusErr .
      913         if glog
      914         and (bh-act-header:buffer-field ("answer_"):buffer-value = ""
      915           or bh-act-header:buffer-field ("answer_"):buffer-value = ? )
      916         then do :
      917               message egais:Msg view-as alert-box.
      918               return no-apply.
      919         end.
      920         else message (bh-act-header:buffer-field ("answer_"):buffer-value) view-as alert-box information .
      921     run refresh-query.
      922   END.
      923   ON value-changed OF RADIO-SET-1 IN FRAME Dialog-Frame
      924   do:
      925     assign RADIO-SET-1 .
      926     if RADIO-SET-1 = 1
      927     then do :
      928       ENABLE Btn_create Btn_chg Btn_del Btn_send
      929         WITH FRAME Dialog-Frame.
      930       HIDE Btn_Ans Btn_lkp Btn_Edit in FRAME Dialog-Frame.
      931     end.
      932     else do :
      933       ENABLE Btn_Ans Btn_lkp Btn_Edit
      934         WITH FRAME Dialog-Frame.
      935       HIDE Btn_create Btn_chg Btn_del Btn_send in FRAME Dialog-Frame.
      936     end.
      937     run refresh-query.
      938   end.
      939   ON leave OF f-date IN FRAME Dialog-Frame
      940   do:
      941     run refresh-query.
      942   end.
      943   ON return OF f-date IN FRAME Dialog-Frame
      944   do:
      945     run refresh-query.
      946   end.
      947   ON leave OF f-date-2 IN FRAME Dialog-Frame
      948   do:
      949     run refresh-query.
      950   end.
      951   ON return OF f-date-2 IN FRAME Dialog-Frame
      952   do:
      953     run refresh-query.
      954   end.
      955   if valid-handle(active-window) and frame Dialog-Frame:PARENT eq ?
      956   then frame Dialog-Frame:PARENT = active-window.
      957   MAIN-BLOCK:
      958   do on error   undo MAIN-BLOCK, leave MAIN-BLOCK
      959      on end-key undo MAIN-BLOCK, leave MAIN-BLOCK:
      960   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      961   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run getcurus in g#library2
      962     (output v-db-num
      963     ,output v-user-id
      964     ) no-error .
      965     empty temp-table thbjattr_thbj-attr .
      966     run adm/shattri.p (
      967          input "get":U
      968         ,input v-cntxt-obj-type
      969         ,input v-cntxt-obj-code
      970         ,input 'egais':U
      971         ,input 'egais-fsrar':U
      972         ,output v-value-character
      973         ,output v-value-date
      974         ,output v-value-decimal
      975         ,output v-value-integer
      976         ,output v-value-logical
      977         ,output v-value-type
      978         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      979         ) no-error .
      980     assign
      981       v-fs-rar = v-value-character
      982     .
      983     run adm/shattri.p (
      984          input "get":U
      985         ,input '':U
      986         ,input 0
      987         ,input 'egais':U
      988         ,input 'egais-exsys':U
      989         ,output v-value-character
      990         ,output v-value-date
      991         ,output v-value-decimal
      992         ,output v-value-integer
      993         ,output v-value-logical
      994         ,output v-value-type
      995         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      996         ) no-error .
      997     assign v-ext-sys = v-value-integer .
      998     egais = new ActWriteOff (v-cntxt-obj-type, v-cntxt-obj-code, v-fs-rar, v-ext-sys).
      999     egais:DbNum = v-db-num .
     1000     egais:User_Id = v-user-id .
     1001     bh-act-header = egais:GetHndlTable(3, "").
     1002     create query qh-act-header.
     1003     f-date = date (now) - 31.
     1004     f-date-2 = ?.
     1005     run refresh-query.
     1006     create browse browse-hdl-act-header
     1007       assign
     1008         title     = 'Акты о списании товара ЕГАИС'
     1009         frame     = frame Dialog-Frame:handle
     1010         query     = qh-act-header
     1011         x         = 10
     1012         y         = 60
     1013         width     = 104
     1014         height    = 22
     1015         visible   = true
     1016         read-only = true
     1017         sensitive = true
     1018         separators = true
     1019         column-resizable = true
     1020         column-scrolling = true
     1021         triggers:
     1022         end triggers
     1023     .
     1024     on row-display of browse-hdl-act-header do :
     1025         if valid-handle (calc-col-hndl) then do :
     1026             if RADIO-SET-1 = 1 then calc-col-hndl:SCREEN-VALUE = "Новый" .
     1027             else do :
     1028               assign v-RegID = bh-act-header:buffer-field ("RegID"):buffer-value .
     1029               if v-RegID = "" or v-RegID = ? or num-entries(v-RegID, CHR(5)) <> 2 then calc-col-hndl:SCREEN-VALUE = "Отправлен" .
     1030               if num-entries(v-RegID, CHR(5)) = 2 then do :
     1031                   if entry(2, v-RegID, CHR(5)) = "R" then do :
     1032                       calc-col-hndl:SCREEN-VALUE = "Отклонен" .
     1033                       calc-col-hndl:bgcolor = red_color .
     1034                   end.
     1035                   if entry(2, v-RegID, CHR(5)) = "A" then do :
     1036                       calc-col-hndl:SCREEN-VALUE = "Принят" .
     1037                       calc-col-hndl:bgcolor = green_color .
     1038                   end.
     1039               end.
     1040             end.
     1041         end.
     1042         if valid-handle (calc-col-hndl2) then do :
     1043             if RADIO-SET-1 = 1 then calc-col-hndl2:SCREEN-VALUE = " - " .
     1044             else do :
     1045               assign v-RegID = bh-act-header:buffer-field ("RegID"):buffer-value .
     1046               calc-col-hndl2:SCREEN-VALUE = entry(1, v-RegID, CHR(5)) .
     1047             end.
     1048         end.
     1049     end.
     1050     ON value-changed OF browse-hdl-act-header
     1051     do:
     1052         if calc-col-hndl:SCREEN-VALUE = "Отклонен" then enable Btn_Edit with FRAME Dialog-Frame .
     1053                                                    else disable Btn_Edit with FRAME Dialog-Frame .
     1054     end.
     1055     if not bh-act-header = ?
     1056     then do:
     1057       do ii = 1 to bh-act-header:num-fields - 3:
     1058         bcol[ii] = browse-hdl-act-header:add-like-column('tt-act-header' + '.' + bh-act-header:buffer-field (ii):name, 0, 'FILL-IN').
     1059       end.
     1060       calc-col-hndl = browse-hdl-act-header:add-calc-column("char", "X(10)", "", "Статус") .
     1061       calc-col-hndl2 = browse-hdl-act-header:add-calc-column("char", "X(20)", "", "RegID") .
     1062       browse-hdl-act-header:get-browse-column (1):width-chars = 30.
     1063       browse-hdl-act-header:get-browse-column (2):width-chars = 17.
     1064       browse-hdl-act-header:get-browse-column (3):width-chars = 20.
     1065       browse-hdl-act-header:get-browse-column (4):width-chars = 10.
     1066       browse-hdl-act-header:get-browse-column (5):width-chars = 20.
     1067     end.
     1068     run enable_UI.
     1069     apply "value-changed" to RADIO-SET-1 in frame Dialog-Frame.
     1070     if not p-select then hide Btn_sel in FRAME Dialog-Frame.
     1071     else do :
     1072         hide Btn_create Btn_chg Btn_del Btn_send RADIO-SET-1 Btn_Edit in FRAME Dialog-Frame.
     1073         assign
     1074           Btn_lkp:x = Btn_lkp:x + 120
     1075           Btn_Ans:x = Btn_Ans:x + 120
     1076         .
     1077         ENABLE Btn_Ans Btn_lkp Btn_sel WITH FRAME Dialog-Frame.
     1078     end.
     1079     wait-for go of frame Dialog-Frame.
     1080   end.
     1081   run disable_UI.
     1082   PROCEDURE disable_UI :
     1083     HIDE FRAME Dialog-Frame.
     1084   END PROCEDURE.
     1085   PROCEDURE enable_UI :
     1086     DISPLAY RADIO-SET-1 f-date f-date-2
     1087         WITH FRAME Dialog-Frame.
     1088     ENABLE Btn_OK RADIO-SET-1 f-date f-date-2
     1089         WITH FRAME Dialog-Frame.
     1090     VIEW FRAME Dialog-Frame.
     1091   END PROCEDURE.
     1092   PROCEDURE refresh-query :
     1093   def var v-proposition  as char no-undo.
     1094   if bh-act-header = ?
     1095     then return .
     1096     assign input frame Dialog-Frame
     1097       f-date
     1098       f-date-2
     1099     .
     1100     v-proposition =
     1101       (if f-date <> ? then " and tt-act-header.date_ >= " + string (f-date) else "") +
     1102       (if f-date-2 <> ? then " and tt-act-header.date_ <= " + string (f-date-2) else "")
     1103       .
     1104   if p-select then do :
     1105       qh-act-header:query-close.
     1106       qh-act-header:set-buffers (bh-act-header).
     1107       qh-act-header:query-prepare ( substitute ("for each tt-act-header where tt-act-header.is-sent and tt-act-header.type_ = 'Пересортица' &1 by tt-act-header.date_ descending", v-proposition) ).
     1108       qh-act-header:query-open.
     1109       bh-act-header:find-first ( "where tt-act-header.num = " + "'" + v-act-num + "'" ) no-error .
     1110   end.
     1111   else do :
     1112     case RADIO-SET-1 :
     1113       when 1  then
     1114       do:
     1115         qh-act-header:query-close.
     1116         qh-act-header:set-buffers (bh-act-header).
     1117         qh-act-header:query-prepare ( substitute ("for each tt-act-header where not tt-act-header.is-sent &1 by tt-act-header.date_ descending", v-proposition) ).
     1118         qh-act-header:query-open.
     1119         bh-act-header:find-first ( "where tt-act-header.num = " + "'" + v-act-num + "'" + v-proposition) no-error .
     1120       end.
     1121       when 2  then
     1122       do:
     1123         qh-act-header:query-close.
     1124         qh-act-header:set-buffers (bh-act-header).
     1125         qh-act-header:query-prepare ( substitute ("for each tt-act-header where tt-act-header.is-sent &1 by tt-act-header.date_ descending", v-proposition) ).
     1126         qh-act-header:query-open.
     1127         bh-act-header:find-first ( "where tt-act-header.num = " + "'" + v-act-num + "'" + v-proposition ) no-error .
     1128       end.
     1129     end case.
     1130   end.
     1131   if bh-act-header:available
     1132     then qh-act-header:reposition-to-rowid ( bh-act-header:rowid ) no-error.
     1133   if valid-handle (browse-hdl-act-header) then apply "value-changed" to browse-hdl-act-header.
     1134   end.
     1135   PROCEDURE proc-row-leave :
     1136     if false then do:
     1137       do ii = 1 to extent (bcol).
     1138         bcol[ii]:bgcolor = RED_COLOR.
     1139       end.
     1140     end.
     1141   end.
