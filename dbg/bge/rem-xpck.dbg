        1   block-level on error undo, throw.
        2   define input parameter p-esys-id      like ub.ext-system.esys-id         no-undo .
        3   define input parameter p-db-num       like ub.ext-system.db-num          no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: f0ffd58b8bac, 1562, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: SMMolotkov $":U .
        6   define variable vss-date        as character no-undo init "$Date: Tue Nov 06 04:41:34 2018 +0300 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: rem-xpck.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: bge/rem-xpck.p $":U .
        9   define variable vss-description as character no-undo init "Удаление пакетов OXML по указанной ВС".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   define  shared variable g#auto-pid           as integer   no-undo .
       82   define  shared variable conn-par             as character no-undo .
       83   define  shared variable g#auto-user-id       as character no-undo .
       84   define  shared variable g#auto-user-login    as character no-undo .
       85   define  shared variable g#auto-user-password as character no-undo .
       86   define  shared variable v-socket             as logical   no-undo .
       87   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   define  shared variable auto-window-h     as handle    no-undo .
       89   define  shared variable auto-log-msg-h    as handle    no-undo .
       90   define  shared variable hand-log-msg-h    as handle    no-undo .
       91   define  shared variable log-file-name     as character no-undo initial ? .
       92   define  shared variable add-log-file-name as character no-undo initial ? .
       93   define  shared variable writelogvalue     as character no-undo initial ? .
       94   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       95   procedure cur-time :
       96      define output parameter p-today as date      no-undo .
       97      define output parameter p-time  as integer   no-undo .
       98     do
       99     on error undo, return error
      100     :
      101       define variable v-date1 as date      no-undo .
      102       define variable v-date2 as date      no-undo .
      103       define variable v-time  as integer   no-undo .
      104       assign
      105         v-date1 = today
      106         v-time  = time
      107         v-date2 = today
      108       .
      109       if v-date1 <> v-date2
      110       then do:
      111         assign
      112           v-date1 = today
      113           v-time  = v-time
      114         .
      115       end.
      116       assign
      117         p-today = v-date1
      118         p-time  = v-time
      119       .
      120     end.
      121   end.
      122   function cur-time-date returns character
      123   :
      124     return string(today, '99/99/9999':U) .
      125   end.
      126   function cur-time-mjd returns decimal
      127   :
      128     define variable v-date as date      no-undo .
      129     define variable v-time as integer   no-undo .
      130     run cur-time in this-procedure
      131       (output v-date
      132       ,output v-time
      133       ) .
      134     return integer(v-date) - 2400002 + (v-time / 86400) .
      135   end.
      136   function cur-time-get-ending-index returns integer
      137   (input p-number as integer
      138   )
      139   :
      140     if p-number < 0
      141     or p-number = ?
      142     then do:
      143       return 1 .
      144     end.
      145     define variable v-rest as integer   no-undo .
      146     assign
      147       p-number = p-number modulo 100
      148     .
      149     if p-number < 20
      150     then do:
      151       assign
      152         v-rest = p-number
      153       .
      154     end.
      155     else do:
      156       assign
      157         v-rest = p-number modulo 10
      158       .
      159     end.
      160     case v-rest :
      161       when 1
      162       then do:
      163         return 2 .
      164       end.
      165       when 2 or
      166       when 3 or
      167       when 4
      168       then do:
      169         return 3 .
      170       end.
      171       otherwise do:
      172         return 1 .
      173       end.
      174     end case .
      175   end.
      176   procedure cur-time-mjd-to-date :
      177      define input  parameter i-mjd-diff as decimal no-undo.
      178      define output parameter o-Date     as date    no-undo.
      179      define output parameter o-Time     as integer no-undo.
      180      define variable v-day-number as integer   no-undo .
      181      if    i-mjd-diff < 0
      182         or i-mjd-diff = ?
      183      then do:
      184         return "?" .
      185      end.
      186      assign
      187         v-day-number = truncate(i-mjd-diff,0).
      188         o-Date = date(v-day-number + 2400002).
      189         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      190     .
      191   end.
      192   function cur-time-mjd-to-string returns character
      193   (input p-mjd-diff as decimal
      194   )
      195   :
      196     define variable v-day-number as integer   no-undo .
      197     define variable v-seconds    as integer   no-undo .
      198     define variable v-hour       as integer   no-undo .
      199     define variable v-min        as integer   no-undo .
      200     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      201     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      202     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      203     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      204     if p-mjd-diff < 0
      205     or p-mjd-diff = ?
      206     then do:
      207       return "?" .
      208     end.
      209     assign
      210       v-day-number = integer(truncate(p-mjd-diff,0))
      211       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      212     .
      213     if v-seconds > 86400
      214     then do:
      215       assign
      216         v-seconds = 86400 - 1
      217       .
      218     end.
      219     if v-seconds < 0
      220     then do:
      221       assign
      222         v-seconds = 0
      223       .
      224     end.
      225     assign
      226       v-hour = truncate(v-seconds / 3600, 0)
      227     .
      228     assign
      229       v-seconds = v-seconds modulo 3600
      230     .
      231     assign
      232       v-min = truncate(v-seconds / 60, 0)
      233     .
      234     assign
      235       v-seconds = v-seconds modulo 60
      236     .
      237     return
      238         (if v-day-number <> 0
      239           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      240           else ""
      241         )
      242       + (if v-day-number <> 0 or v-hour <> 0
      243           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      244           else ""
      245         )
      246       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      247           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      248           else ""
      249         )
      250       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      251       .
      252   end.
      253   function cur-time-string returns character
      254   :
      255     define variable v-date as date      no-undo .
      256     define variable v-time as integer   no-undo .
      257     run cur-time in this-procedure
      258       (output v-date
      259       ,output v-time
      260       ) .
      261     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      262   end.
      263   function cur-time-string-sec returns character
      264   :
      265     define variable v-date as date      no-undo .
      266     define variable v-time as integer   no-undo .
      267     run cur-time in this-procedure
      268       (output v-date
      269       ,output v-time
      270       ) .
      271     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      272   end.
      273   function cur-time-custom  returns character
      274   (input p-prefix as character
      275   ,input p-date-format as character
      276   ,input p-delimiter as character
      277   ,input p-time-format as character
      278   ,input p-suffix as character
      279   )
      280   :
      281     define variable v-date as date      no-undo .
      282     define variable v-time as integer   no-undo .
      283     run cur-time in this-procedure
      284       (output v-date
      285       ,output v-time
      286       ) .
      287     return
      288       p-prefix
      289       + string(v-date, p-date-format)
      290       + p-delimiter
      291       + string(v-time, p-time-format)
      292       + p-suffix
      293       .
      294   end.
      295   function cur-time-print  returns character
      296   :
      297     define variable v-date as date      no-undo .
      298     define variable v-time as integer   no-undo .
      299     run cur-time in this-procedure
      300       (output v-date
      301       ,output v-time
      302       ) .
      303     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      304   end.
      305   function cur-time-datetime returns datetime
      306   :
      307     define variable v-char as character no-undo .
      308     define variable v-datetime as datetime no-undo .
      309     v-char = cur-time-string().
      310     v-datetime = datetime(v-char).
      311     return  v-datetime.
      312   end.
      313   function cur-time-string-msec returns character
      314   :
      315     define variable v-date as datetime  no-undo .
      316     v-date = now.
      317     return string(v-date) .
      318   end.
      319   define stream LogStream .
      320   define variable mNoTime as logical no-undo.
      321   procedure write-to-log-notime :
      322     define input param i-str as character no-undo .
      323     mNoTime = yes.
      324     run write-to-log (i-str).
      325     mNoTime = no.
      326   end.
      327   procedure write-to-log :
      328     define input param p-str as character no-undo .
      329     do
      330     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      331     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      332     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      333     :
      334       define variable log-res        as logical   no-undo .
      335       define variable v-jj           as integer   no-undo .
      336       if    mNoTime
      337          or writelogvalue eq "AsyncProc"
      338       then
      339          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      340       else
      341          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      342       if auto-log-msg-h <> ? then do:
      343         log-res = auto-log-msg-h:move-to-eof( ) .
      344         log-res = auto-log-msg-h:insert-string( p-str ).
      345       end.
      346       if hand-log-msg-h <> ? then do:
      347         log-res = hand-log-msg-h:move-to-eof( ) .
      348         log-res = hand-log-msg-h:insert-string( p-str ).
      349       end.
      350       assign
      351         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      352         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      353         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      354       .
      355       if add-log-file-name <> ? then do:
      356         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      357           run gbl/fileapnd.p
      358             ( input entry(v-jj, add-log-file-name, chr(1) )
      359             ,input p-str
      360             ,input 20
      361             ) no-error .
      362           if error-status:error then do:
      363             return error return-value .
      364           end.
      365         end.
      366       end.
      367       if writelogvalue eq "AsyncProc"
      368       then do:
      369          p-str = trim(p-str, (chr(13) + chr(10)) )
      370       .
      371          Publish "WriteLogAsunc" (p-str,yes).
      372       end.
      373       else if writelogvalue <> "yes" then do:
      374         run gbl/fileapnd.p
      375           ( input log-file-name
      376           ,input p-str
      377           ,input 20
      378           ) no-error .
      379         if error-status:error then do:
      380           return error return-value .
      381         end.
      382       end.
      383     end.
      384   end procedure.
      385   procedure write-to-screen :
      386     define input param p-str as character no-undo .
      387     do
      388     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      389     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      390     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      391     :
      392       define variable log-res as logical no-undo.
      393       assign
      394         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      395       .
      396       if auto-log-msg-h <> ?
      397       then do:
      398         log-res = auto-log-msg-h:move-to-eof( ) .
      399         log-res = auto-log-msg-h:insert-string( p-str ).
      400       end.
      401       if hand-log-msg-h <> ?
      402       then do:
      403         log-res = hand-log-msg-h:move-to-eof( ) .
      404         log-res = hand-log-msg-h:insert-string( p-str ).
      405       end.
      406     end.
      407   end procedure.
      408   procedure send-msg-to-email :
      409     define input  parameter p-subject      as character no-undo .
      410     define input  parameter p-text-err     as character no-undo .
      411     define input  parameter p-attach-files as character no-undo .
      412     do
      413     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      414     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      415     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      416     :
      417       define variable v-tth             as handle    no-undo .
      418       define variable v-value-character as character no-undo .
      419       define variable v-value-date      as date      no-undo .
      420       define variable v-value-decimal   as decimal   no-undo .
      421       define variable v-value-integer   as integer   no-undo .
      422       define variable v-value-logical   as logical   no-undo .
      423       define variable v-param-type      as character no-undo .
      424       define variable v-email       as character no-undo .
      425       define variable v-tmp-str     as character no-undo .
      426       define variable v-tmp1-str    as character no-undo .
      427       define variable v-ind         as integer   no-undo .
      428       define variable v-num-entries as integer   no-undo .
      429       delete object v-tth no-error.
      430       run adm/shattri.p
      431         ( input "get":U
      432          ,input  "":U
      433          ,input  0
      434          ,input  'auto-task':U
      435          ,input  'send-msg-to-email':U
      436          ,output v-value-character
      437          ,output v-value-date
      438          ,output v-value-decimal
      439          ,output v-value-integer
      440          ,output v-value-logical
      441          ,output v-param-type
      442          ,input-output table-handle v-tth
      443         ) no-error .
      444       if not error-status :error  then do:
      445         assign
      446           v-tmp-str = v-value-character
      447         .
      448       end.
      449       delete object v-tth no-error.
      450       assign
      451         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      452         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      453         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      454         v-num-entries = num-entries( v-tmp-str, chr(44) )
      455         v-email       = "":U
      456       .
      457       do v-ind = 1 to v-num-entries
      458       :
      459         assign
      460           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      461         .
      462         if trim( v-tmp1-str ) <> "":U then do:
      463           if v-email = "":U then do:
      464             assign
      465               v-email = v-tmp1-str
      466             .
      467           end.
      468           else do:
      469             assign
      470               v-email = v-email + chr(44) + v-tmp1-str
      471             .
      472           end.
      473         end.
      474       end.
      475       if v-email <> "":U then do:
      476         run gbl/sendmail.p
      477           ( input v-email
      478           , input p-subject
      479           , input p-text-err
      480           , input p-attach-files
      481           ) no-error .
      482         if error-status :error
      483           or return-value <> "":U
      484         then do:
      485           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      486         end.
      487       end.
      488     end.
      489   end procedure.
      490   define  shared variable oxml-exch-dir as character no-undo .
      491   define  shared variable oxml-heap-dir as character no-undo .
      492   define variable err-mess as character no-undo .
      493   define temp-table t-pck-conf no-undo
      494     field esys-id         as integer
      495     field db-num          as integer
      496     field current-db-num  as integer
      497     field pack-num        as integer
      498     field rcvd-recs       as integer
      499     field total-recs      as integer
      500     field sys-key         as character
      501     field src_db-key      as character
      502     field ver-num         as character
      503     field prev-crc        as character
      504     field actual-date     as date
      505     field actual-time-int as integer
      506   .
      507   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      508   procedure esallatr-name :
      509   do
      510     on error undo, return error
      511     :
      512     define input  parameter p-code           as character no-undo .
      513     define output parameter p-type           as character no-undo .
      514     define output parameter p-format         as character no-undo .
      515     define output parameter p-label          as character no-undo .
      516     define output parameter p-user-can-edit  as logical   no-undo .
      517     define output parameter p-output-display as logical   no-undo .
      518     define output parameter p-other          as character no-undo .
      519       case p-code :
      520               when 'custom-pack-name':U then do:     assign     p-label = "Имя файла в ВС"     p-type = 'C':U      p-format = "X(255)"     p-label = "Имя файла в ВС"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      521               when 'route-custom-pack-name':U then do:     assign     p-label = "Иям файла в ВС"     p-type = 'C':U      p-format = "X(255)"     p-label = "Иям файла в ВС"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      522         otherwise do:
      523           undo, return error substitute("неизвестный атрибут ВС &1", p-code) .
      524         end.
      525       end.
      526     end.
      527   end procedure.
      528   procedure esallatr-value :
      529   do
      530     on error undo, return error
      531     :
      532     define input  parameter p-table-name as character no-undo .
      533     define input  parameter p-key1     as int64 no-undo .
      534     define input  parameter p-key2     as int64 no-undo .
      535     define input  parameter p-key3     as character no-undo .
      536     define input  parameter p-key4     as character no-undo .
      537     define input  parameter p-key5     as int64 no-undo .
      538     define input  parameter p-key6     as int64 no-undo .
      539     define input  parameter p-key7     as character no-undo .
      540     define input  parameter p-key8     as character no-undo .
      541     define input  parameter p-code     as character no-undo .
      542     define output parameter p-value    as character no-undo .
      543     define output parameter p-type     as character no-undo .
      544     define buffer buf_esys-all-attr for ub.esys-all-attr.
      545     define variable v-format         as character no-undo .
      546     define variable v-label          as character no-undo .
      547     define variable v-user-can-edit  as logical   no-undo .
      548     define variable v-output-display as logical   no-undo .
      549     define variable v-other          as character no-undo .
      550       run esallatr-name in this-procedure
      551         (input  p-code
      552         ,output p-type
      553         ,output v-format
      554         ,output v-label
      555         ,output v-user-can-edit
      556         ,output v-output-display
      557         ,output v-other
      558         ) no-error .
      559       if error-status :error then do:
      560         undo, return error return-value .
      561       end.
      562       Find first  buf_esys-all-attr no-lock where
      563                   buf_esys-all-attr.attr-code = p-code
      564              and  buf_esys-all-attr.table-name  = p-table-name
      565              and  buf_esys-all-attr.key1  = p-key1
      566              and  buf_esys-all-attr.key2  = p-key2
      567              and  buf_esys-all-attr.key3  = p-key3
      568              and  buf_esys-all-attr.key4  = p-key4
      569              and  buf_esys-all-attr.key5  = p-key5
      570              and  buf_esys-all-attr.key6  = p-key6
      571              and  buf_esys-all-attr.key7  = p-key7
      572              and  buf_esys-all-attr.key8  = p-key8  no-error .
      573      if avail buf_esys-all-attr then do:
      574       assign
      575       p-value = buf_esys-all-attr.attr-value.
      576      end.
      577      else do:
      578       assign
      579       p-value = if p-type = 'L':U then "no":U else "".
      580      end.
      581   end.
      582   end procedure.
      583   do
      584   on error undo, return error
      585   :
      586     define stream dir-stream .
      587     define buffer buf_ext-system       for ub.ext-system .
      588     define buffer buf_esys-pck-sent for ub.esys-pck-sent.
      589     define buffer buf_esys-pck-rcvd for ub.esys-pck-rcvd .
      590     define buffer buf_esys-all-attr for ub.esys-all-attr.
      591     define variable v-pck-for-esys  as integer   no-undo .
      592     define variable v-add-to-list  as logical   no-undo .
      593     define variable v-list-action  as character no-undo .
      594     define variable v-action       as character no-undo .
      595     define variable v-dir-name     as character no-undo .
      596     define variable v-pack-num     as integer   no-undo .
      597     define variable v-pack-name    as character no-undo .
      598     define variable v-custom-pack-name as character no-undo .
      599     define variable v-source-dir   as character no-undo .
      600     define variable v-target-dir   as character no-undo .
      601     define variable v-temp-dir     as character no-undo .
      602     define variable v-ind          as integer   no-undo .
      603     define variable v-type         as character no-undo .
      604     define variable v-filename     as character no-undo .
      605     define variable v-fullfilename as character no-undo .
      606     define variable v-log-file-name as character no-undo .
      607     define variable v-list-file-name as character no-undo .
      608     define variable v-custom-pack-flag as logical no-undo .
      609     define variable v-file-cnt     as integer   no-undo .
      610     define variable v-count-del      as integer   no-undo .
      611     define variable v-count-need-del as integer   no-undo .
      612     define variable v-today        as date      no-undo .
      613     define variable v-time         as integer   no-undo .
      614     define variable v-success      as logical no-undo .
      615     find first buf_ext-system no-lock
      616       where buf_ext-system.esys-id = p-esys-id
      617         and buf_ext-system.db-num = p-db-num
      618       no-error
      619     .
      620     if not available buf_ext-system then do:
      621       run write-to-log( substitute( "&1. ВС &2 не найдена", vss-workfile, p-esys-id ) ) .
      622       return error.
      623     end.
      624     if buf_ext-system.delete-pck-on = 0 then do:
      625       return .
      626     end.
      627     assign
      628     v-pck-for-esys = buf_ext-system.esys-id
      629     .
      630     if buf_ext-system.save-days-pck-num < 20 then do:
      631       return.
      632     end.
      633     run write-to-log( substitute("Анализ необходимости удаления файлов OXML по ВС &1", v-pck-for-esys ) ) .
      634     v-success = no.
      635     run bge/lockesys.p (
      636       input buf_ext-system.esys-id
      637       ,input buf_ext-system.db-num
      638       ,buffer buf_ext-system
      639       ,output v-success
      640     ) no-error.
      641     if error-status:error
      642     or not v-success
      643     then do:
      644       run write-to-log( substitute( "&1. &2", vss-workfile, return-value ) ).
      645       return .
      646     end.
      647     run cur-time in this-procedure
      648       ( output v-today
      649        ,output v-time
      650       ) no-error .
      651     if error-status :error then do:
      652       run write-to-log( substitute( "&1. Ошибка при определении текущего времени. &2&3&2&4", vss-workfile, chr(10), error-status :get-message(1) , return-value )
      653                       ) .
      654       return error.
      655     end.
      656     assign
      657       v-list-action    = "put,get":U
      658       v-count-del      = 0
      659       v-count-need-del = 0
      660       v-file-cnt       = 0
      661     .
      662     do v-ind = 1 to 2
      663     :
      664       assign
      665         v-action   = entry( v-ind, v-list-action )
      666         v-pack-num = ?
      667       .
      668       run bge/espcknum.p
      669         ( input v-action
      670          ,input p-esys-id
      671          ,input p-db-num
      672          ,input buf_ext-system.delivery-method
      673          ,input oxml-exch-dir
      674          ,input oxml-heap-dir
      675          ,input ""
      676          ,input-output v-pack-num
      677          ,input-output v-custom-pack-name
      678          ,output v-pack-name
      679          ,output v-source-dir
      680          ,output v-target-dir
      681          ,output v-temp-dir
      682          ,output v-log-file-name
      683          ,output v-list-file-name
      684          ,output v-custom-pack-flag
      685         ) no-error.
      686       if error-status:error then do:
      687         run write-to-log( substitute( "&1. Ошибка при генерации номера пакета. &2&3&2&4", vss-workfile, chr(10), error-status:get-message(1), return-value ) ) .
      688       end.
      689       if v-action = "put":U  then do:
      690         assign
      691           v-dir-name = v-source-dir
      692         .
      693       end.
      694       else do:
      695         assign
      696           v-dir-name = v-target-dir
      697         .
      698       end.
      699       assign
      700         file-info :file-name = v-dir-name
      701       .
      702       if file-info :full-pathname = ""
      703       or file-info :full-pathname = ?  then do:
      704         message
      705           vss-workfile vss-revision vss-description skip
      706           substitute( "Каталог: &1 ('heap') не найден !!!", v-dir-name ) skip
      707           return-value skip
      708           error-status :get-message ( error-status :num-messages )
      709           view-as alert-box error
      710         .
      711         undo, return error .
      712       end.
      713       assign
      714         v-dir-name = file-info :full-pathname
      715       .
      716       input stream dir-stream from os-dir ( v-dir-name )  no-attr-list no-echo  .
      717       _repeat:
      718       repeat:
      719         import stream dir-stream v-filename v-fullfilename .
      720         assign
      721         file-info :file-name = v-fullfilename
      722         .
      723         if caps( file-info :file-type ) begins "F":U
      724           and num-entries( v-filename, "." ) > 1
      725         then do:
      726           assign
      727           v-file-cnt = v-file-cnt + 1
      728           .
      729           if file-info :file-mod-date + buf_ext-system.save-days-pck-num < v-today then do:
      730             if length(v-filename) = 14
      731             and substring(v-filename, 1, 1) = 'o'
      732             and substring(v-filename, 11, 4) = '.xml'
      733             and trim(substring(v-filename, 2, 9), '0123456789') = '' then do:
      734               assign
      735                 v-pack-num    = integer( substring( v-filename, 2, r-index(v-filename, '.':U) - 1 ) )
      736                 v-add-to-list = true
      737               .
      738             end.
      739             else do:
      740               find first buf_esys-all-attr no-lock where
      741                       buf_esys-all-attr.attr-code = 'custom-pack-name':U
      742                   and buf_esys-all-attr.table-name = (if v-ind = 1 then 'esys-pck-sent':U else 'esys-pck-rcvd':U)
      743                   and buf_esys-all-attr.key2 = p-esys-id
      744                   and buf_esys-all-attr.attr-value  = v-filename
      745                   and buf_esys-all-attr.key5 =  p-db-num no-error.
      746               if not available buf_esys-all-attr then next _repeat.
      747               assign
      748                 v-pack-num    = buf_esys-all-attr.key1
      749                 v-add-to-list = true
      750               .
      751             end.
      752             case v-action :
      753               when "put":U then do:
      754                 find first buf_esys-pck-sent no-lock
      755                   where buf_esys-pck-sent.esys-id  = v-pck-for-esys
      756                     and buf_esys-pck-sent.db-num   = p-db-num
      757                     and buf_esys-pck-sent.esps-pack-num = v-pack-num
      758                     and buf_esys-pck-sent.esps-cr-db-num = g#db-num
      759                   no-error .
      760                 if not available buf_esys-pck-sent
      761                   or buf_esys-pck-sent.esps-rcvd <> true
      762                 then do:
      763                   assign
      764                     v-add-to-list = false
      765                   .
      766                 end.
      767               end.
      768               when "get":U then do:
      769                 find first buf_esys-pck-rcvd no-lock
      770                   where buf_esys-pck-rcvd.esys-id   = v-pck-for-esys
      771                     and buf_esys-pck-rcvd.db-num   = p-db-num
      772                     and buf_esys-pck-rcvd.espr-pack-num = v-pack-num
      773                     and buf_esys-pck-rcvd.espr-cr-db-num = g#db-num
      774                   no-error .
      775                 if not available buf_esys-pck-rcvd then do:
      776                   assign
      777                     v-add-to-list = false
      778                   .
      779                 end.
      780               end.
      781             end case.
      782             if v-add-to-list = true then do:
      783               if v-count-need-del = 0 then do:
      784                 run write-to-log( substitute("Удаление файлов OXML по ВС &1", v-pck-for-esys ) ) .
      785               end.
      786               assign
      787                 v-count-need-del = v-count-need-del + 1
      788               .
      789               run gbl/del-file.p
      790                 ( input file-info :full-pathname
      791                 ) no-error .
      792               if error-status:error then do:
      793                 run write-to-log( substitute( "&1. Ошибка при удалении пакета. &2&3&2&4", vss-workfile, chr(10), error-status:get-message(1), return-value )
      794                                 ) .
      795               end.
      796               else do:
      797                 assign
      798                   v-count-del = v-count-del + 1
      799                 .
      800               end.
      801             end.
      802           end.
      803         end.
      804       end.
      805       input stream dir-stream close.
      806     end.
      807     if v-count-need-del > 0 then do:
      808       run write-to-log( substitute("Анализ пакетов по ВС &1 завершен. Просмотрено &2 файлов. Удалено &3 из &4 старых пакетов."
      809                                    , v-pck-for-esys
      810                                    , v-file-cnt
      811                                    , v-count-del
      812                                    , v-count-need-del
      813                                      ) ) .
      814     end.
      815     else do:
      816       run write-to-log( substitute("Анализ пакетов по ВС &1 завершен. Просмотрено &2 файлов. Старых файлов не обнаружено."
      817                                    , v-pck-for-esys
      818                                    , v-file-cnt
      819                                      ) ) .
      820     end.
      821   end.
