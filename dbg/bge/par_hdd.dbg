      194   procedure schedule-attr-name :
      195   do
      196     on error undo, return error
      197     :
      198     define input  parameter p-code           as character no-undo .
      199     define output parameter p-type           as character no-undo .
      200     define output parameter p-format         as character no-undo .
      201     define output parameter p-label          as character no-undo .
      202     define output parameter p-user-can-edit  as logical   no-undo .
      203     define output parameter p-output-display as logical   no-undo .
      204     define output parameter p-other          as character no-undo .
      205       if index(p-code, chr(4)) > 0 then do:
      206         p-code = entry(1, p-code, chr(4)).
      207       end.
      208       case p-code :
      209               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      210               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      211               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      212               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      213               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      214               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      215               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      216               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      217               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      218         otherwise do:
      219           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      220         end.
      221       end.
      222     end.
      223   end procedure.
      224   procedure schedule-attr-tooltip :
      225   do
      226     on error undo, return error
      227     :
      228       define input  parameter p-code    as character no-undo .
      229       define output parameter p-tooltip as character no-undo .
      230       define output parameter p-label   as character no-undo .
      231       if index(p-code, chr(4)) > 0 then do:
      232         p-code = entry(1, p-code, chr(4)).
      233       end.
      234       case p-code :
      235               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      236               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      237               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      238               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      239               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      240               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      241               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      242               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      243               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      244         otherwise do:
      245               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      246         end.
      247       end.
      248     end.
      249   end procedure.
      250   procedure schedule-attr-value :
      251   do
      252   on error undo, return error return-value
      253   :
      254   define input parameter  p-cre-db-num as integer    no-undo.
      255   define input parameter  p-task-type  as character  no-undo.
      256   define input parameter  p-task-num   as integer    no-undo.
      257   define input parameter  p-code       as character  no-undo.
      258   define output parameter p-value      as character  no-undo.
      259   define output parameter p-type       as character  no-undo.
      260       define variable v-format         as character no-undo .
      261       define variable v-label          as character no-undo .
      262       define variable v-user-can-edit  as logical   no-undo .
      263       define variable v-output-display as logical   no-undo .
      264       define variable v-other          as character no-undo .
      265       define buffer buf_schedule-attr for ub.schedule-attr.
      266       run schedule-attr-name in this-procedure (
      267             input  p-code
      268           , output p-type
      269           , output v-format
      270           , output v-label
      271           , output v-user-can-edit
      272           , output v-output-display
      273           , output v-other
      274       ) no-error .
      275       if error-status :error
      276       then do:
      277           undo, return error return-value .
      278       end.
      279       if p-code begins ('schd-free-id':U + chr(4))
      280       and entry(2, p-code, chr(4)) = '':U then do:
      281         find first buf_schedule-attr no-lock
      282             where buf_schedule-attr.cre-db-num = p-cre-db-num
      283               and buf_schedule-attr.task-type  = p-task-type
      284               and buf_schedule-attr.task-num   = p-task-num
      285               and buf_schedule-attr.attr-code  begins p-code
      286         no-error .
      287       end.
      288       else do:
      289         find first buf_schedule-attr no-lock
      290             where buf_schedule-attr.cre-db-num = p-cre-db-num
      291               and buf_schedule-attr.task-type  = p-task-type
      292               and buf_schedule-attr.task-num   = p-task-num
      293               and buf_schedule-attr.attr-code  = p-code
      294         no-error .
      295       end.
      296       if available buf_schedule-attr
      297       then do:
      298           assign
      299               p-value = buf_schedule-attr.attr-value
      300           .
      301       end.
      302       else do:
      303         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      304            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      305         end.
      306         else do:
      307           assign
      308               p-value = if p-type = 'L':U then "no":U else ""
      309           .
      310         end.
      311       end.
      312   end.
      313   end procedure.
      314   procedure schedule-attr-write :
      315   do
      316   on error undo, return error
      317   :
      318   define input parameter p-cre-db-num  as integer   no-undo.
      319   define input parameter p-task-type   as character no-undo.
      320   define input parameter p-task-num    as integer   no-undo.
      321   define input parameter p-code        as character no-undo.
      322   define input parameter p-value       as character no-undo.
      323       define variable v-type              as character                no-undo.
      324       define variable v-format            as character                no-undo.
      325       define variable v-label             as character                no-undo.
      326       define variable v-user-can-edit     as logical                  no-undo.
      327       define variable v-output-display    as logical                  no-undo.
      328       define variable v-other             as character                no-undo.
      329       define buffer buf_schedule-attr for ub.schedule-attr .
      330       run schedule-attr-name in this-procedure (
      331             input  p-code
      332           , output v-type
      333           , output v-format
      334           , output v-label
      335           , output v-user-can-edit
      336           , output v-output-display
      337           , output v-other
      338       ) no-error.
      339       if error-status :error
      340       then do:
      341           undo, return error return-value.
      342       end.
      343       find first buf_schedule-attr exclusive-lock
      344            where buf_schedule-attr.cre-db-num = p-cre-db-num
      345              and buf_schedule-attr.task-type  = p-task-type
      346              and buf_schedule-attr.task-num   = p-task-num
      347              and buf_schedule-attr.attr-code  = p-code
      348       no-error.
      349       if not available buf_schedule-attr
      350       then do:
      351           create buf_schedule-attr.
      352           assign
      353             buf_schedule-attr.cre-db-num = p-cre-db-num
      354             buf_schedule-attr.task-type  = p-task-type
      355             buf_schedule-attr.task-num   = p-task-num
      356             buf_schedule-attr.attr-code  = p-code
      357             buf_schedule-attr.attr-value = p-value
      358           .
      359       end.
      360       else do:
      361           assign
      362               buf_schedule-attr.attr-value = p-value
      363           .
      364       end.
      365   end.
      366   end procedure.
      367   procedure schedule-attr-delete :
      368   do
      369   on error undo, return error
      370   :
      371   define input  parameter p-cre-db-num  as integer   no-undo.
      372   define input  parameter p-task-type   as character no-undo.
      373   define input  parameter p-task-num    as integer   no-undo.
      374   define input  parameter p-code        as character no-undo.
      375   define output parameter p-deleted     as logical   no-undo.
      376       define buffer buf_schedule-attr for ub.schedule-attr .
      377       define variable v-type              as character                no-undo.
      378       define variable v-format            as character                no-undo.
      379       define variable v-label             as character                no-undo.
      380       define variable v-user-can-edit     as logical                  no-undo.
      381       define variable v-output-display    as logical                  no-undo.
      382       define variable v-other             as character                no-undo.
      383       run schedule-attr-name in this-procedure (
      384             input p-code
      385           , output v-type
      386           , output v-format
      387           , output v-label
      388           , output v-user-can-edit
      389           , output v-output-display
      390           , output v-other
      391       ) no-error .
      392       if error-status :error
      393       then do:
      394           undo, return error return-value .
      395       end.
      396       find first buf_schedule-attr exclusive-lock
      397            where buf_schedule-attr.cre-db-num = p-cre-db-num
      398              and buf_schedule-attr.task-type  = p-task-type
      399              and buf_schedule-attr.task-num   = p-task-num
      400              and buf_schedule-attr.attr-code  = p-code
      401       no-error.
      402       if not available buf_schedule-attr
      403       then do:
      404           assign
      405               p-deleted = no
      406           .
      407       end.
      408       else do:
      409           delete buf_schedule-attr.
      410           assign
      411               p-deleted = yes
      412           .
      413       end.
      414   end.
      415   end procedure.
      416   procedure schedule-attr-news :
      417   do
      418   on error undo, return error
      419   :
      420       define input  parameter p-code           as character no-undo .
      421       define output parameter p-news           as logical   no-undo .
      422       if index(p-code, chr(4)) > 0 then do:
      423         p-code = entry(1, p-code, chr(4)).
      424       end.
      425       case p-code :
      426               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      427               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      428               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      429               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      430               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      431               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      432               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      433               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      434               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      435         otherwise do:
      436           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      437         end.
      438       end.
      439   end.
      440   end procedure.
      441   procedure schedule-attr-extract-logical :
      442   do
      443   on error undo, return error
      444   :
      445   define input  parameter p-parameter-number   as integer      no-undo.
      446   define input  parameter p-parameter-list     as character    no-undo.
      447   define output parameter p-parameter-value   as logical      no-undo.
      448       if num-entries( p-parameter-list ) > p-parameter-number - 1
      449       then do:
      450           assign
      451               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      452           .
      453       end.
      454       else do:
      455           assign
      456               p-parameter-value   = no
      457           .
      458       end.
      459   end.
      460   end procedure.
      461   procedure schedule-attr-get-free-id :
      462   do
      463   on error undo, return error return-value
      464   :
      465     define input  parameter p-cre-db-num  as integer   no-undo.
      466     define input  parameter p-task-type   as character no-undo.
      467     define input  parameter p-task-num    as integer   no-undo.
      468     define output parameter p-free-id     as character no-undo.
      469     define buffer buf_schedule-attr for ub.schedule-attr.
      470     find first buf_schedule-attr no-lock
      471         where buf_schedule-attr.cre-db-num = p-cre-db-num
      472           and buf_schedule-attr.task-type  = p-task-type
      473           and buf_schedule-attr.task-num   = p-task-num
      474           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      475     no-error .
      476     if available buf_schedule-attr then
      477     assign
      478     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      479     no-error
      480     .
      481   end.
      482   end procedure.
      483   procedure schedule-attr-get-free-props :
      484     define input parameter p-free-id as character no-undo .
      485     define output parameter p-value as character no-undo .
      486     define buffer buf_temp-schedule-free for temp-schedule-free.
      487     do
      488     on error undo, return error return-value
      489     :
      490       find first buf_temp-schedule-free no-lock no-error .
      491       if not available buf_temp-schedule-free then do:
      492         run schedule-attr-fill-free-props in this-procedure .
      493       end.
      494       find first buf_temp-schedule-free where
      495               buf_temp-schedule-free.free-id = p-free-id no-error.
      496       if available buf_temp-schedule-free then do:
      497         assign
      498         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      499                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      500                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      501                   buf_temp-schedule-free.conf-param           + chr(4) +
      502                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      503                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      504                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      505                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      506                   buf_temp-schedule-free.other-info
      507         .
      508       end.
      509       else do:
      510        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      511                              "id произвольной задачи - &5"
      512                              ,vss-workfile
      513                              ,vss-revision
      514                              ,vss-description
      515                              ,chr(10)
      516                              ,p-free-id).
      517       end.
      518     end.
      519   end procedure.
      520   procedure schedule-attr-is-rum-free-id :
      521   define input parameter p-free-id as character no-undo .
      522   define output parameter p-is-rum as logical no-undo .
      523   define buffer buf_temp-schedule-free for temp-schedule-free.
      524   do
      525   on error undo, return error
      526   :
      527       find first buf_temp-schedule-free no-lock no-error .
      528       if not available buf_temp-schedule-free then do:
      529         run schedule-attr-fill-free-props in this-procedure .
      530       end.
      531       find first buf_temp-schedule-free where
      532               buf_temp-schedule-free.free-id = p-free-id no-error.
      533       if available buf_temp-schedule-free
      534       and buf_temp-schedule-free.is-rum
      535       then do:
      536         p-is-rum = yes.
      537       end.
      538   end.
      539   end procedure.
      540   procedure schedule-attr-fill-free-props :
      541   define variable v-path                    as character                no-undo .
      542   DEFINE VARIABLE v-full-path               as character                no-undo .
      543   DEFINE VARIABLE v-file-name               as character                no-undo .
      544   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      545   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      546   define buffer buf_temp-schedule-free for temp-schedule-free.
      547   define variable v-answer as logical no-undo .
      548     do
      549     on error undo, return error substitute("&1 &2 &3&4&5&4"
      550                                           ,vss-workfile
      551                                           ,vss-revision
      552                                           ,vss-description
      553                                           ,chr(10)
      554                                           ,error-status:get-message(1) )
      555     :
      556       run gbl/filename.p (
      557                       input 'cmp/shd-free.d'
      558                     ,output v-full-path
      559                     ,output v-path
      560                     ,output v-file-name
      561                     ,output v-file-name-no-ext
      562                     ,output v-file-name-ext
      563                     ) .
      564       input from value(v-full-path).
      565       repeat :
      566         create buf_temp-schedule-free.
      567         import buf_temp-schedule-free.
      568       END.
      569       input close.
      570       _ff:
      571       for each buf_temp-schedule-free :
      572         if buf_temp-schedule-free.free-id = '':U then do:
      573            delete buf_temp-schedule-free.
      574            next _ff.
      575          end.
      576          run schedule-attr-check-enc in this-procedure (
      577                                                       input  buf_temp-schedule-free.free-id
      578                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      579                                                               buf_temp-schedule-free.proc-param-edit-name +
      580                                                               buf_temp-schedule-free.conf-param +
      581                                                               string(buf_temp-schedule-free.is-gbd) +
      582                                                               string(buf_temp-schedule-free.is-ubd) +
      583                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      584                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      585                                                               string(buf_temp-schedule-free.other-info)
      586                                                               )
      587                                                       ,input  buf_temp-schedule-free.enc-key
      588                                                       ,output v-answer    ) no-error .
      589          if error-status:error
      590          or not v-answer then delete buf_temp-schedule-free.
      591        end.
      592     end.
      593   end procedure.
      594   Function schedule-attr-reverse returns character (str as character).
      595      define variable rev_incl_s as character init "" no-undo .
      596      define variable rev_incl_i as integer no-undo .
      597      define variable rev_incl_l as integer no-undo .
      598      rev_incl_l = length(str).
      599      do rev_incl_i = 1 to rev_incl_l:
      600         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      601      end.
      602      return rev_incl_s.
      603   end.
      604   procedure schedule-attr-check-enc.
      605     define input  parameter p-free-id   as character no-undo .
      606     define input  parameter p-value     as character no-undo .
      607     define input  parameter p-enc-value as character no-undo .
      608     define output parameter p-answer    as logical   no-undo .
      609     define variable tmp         as character no-undo .
      610     define variable v-enc-value as character no-undo .
      611     assign
      612     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      613     .
      614     run schedule-attr-pswd-enc in this-procedure
      615       ( input tmp
      616        ,output v-enc-value
      617       ) no-error .
      618     if error-status:error then do:
      619       message
      620         vss-workfile vss-revision vss-description skip
      621         "Ошибка при вызове процедуры pswd-enc" skip
      622         return-value skip
      623         error-status :get-message(1) skip
      624         view-as alert-box error .
      625       undo, return error .
      626     end.
      627     if v-enc-value = p-enc-value then do:
      628       assign
      629         p-answer = true
      630       .
      631     end.
      632     else do:
      633       assign
      634         p-answer = false
      635       .
      636     end.
      637   end.
      638   procedure schedule-attr-conf-enc.
      639     define input  parameter p-free-id   as character no-undo .
      640     define input  parameter p-value     as character no-undo .
      641     define output parameter p-enc-value as character no-undo .
      642     define variable tmp         as character no-undo .
      643     assign
      644       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      645     .
      646     run schedule-attr-pswd-enc in this-procedure
      647       ( input tmp
      648        ,output p-enc-value
      649       ) no-error .
      650     if error-status:error then do:
      651       message
      652         vss-workfile vss-revision vss-description skip
      653         "Ошибка при вызове процедуры pswd-enc" skip
      654         return-value skip
      655         error-status :get-message(1) skip
      656         view-as alert-box error .
      657       undo, return error .
      658     end.
      659   end procedure.
      660   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      661   procedure schedule-attr-pswd-enc :
      662     define input parameter  pswd     as character no-undo .
      663     define output parameter enc-pswd as character no-undo .
      664     do
      665     on error undo, return error return-value
      666     :
      667       assign
      668         enc-pswd = encode(pswd + string(index(pswd, "k")))
      669       .
      670     end.
      671   end procedure.
      672   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      673   define input parameter parparentproc as widget-handle no-undo .
      674   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo .
      675   define input parameter p-curr-obj-type  like ub.clients.obj-type no-undo .
      676   define input parameter p-curr-obj-code  like ub.clients.obj-code no-undo .
      677   define input PARAMETER p-mode           AS CHARACTER NO-UNDO.
      678   define input parameter p-db-num-char    as character    no-undo.
      679   define input parameter p-task-type      as character    no-undo.
      680   define input parameter p-task-num       as integer      no-undo.
      681   define input parameter p-action         as character    no-undo.
      682   define output parameter p-cancel        as logical      no-undo.
      683   define output parameter p-params        as character    no-undo.
      684   define variable v-text         as character no-undo .
      685   define variable v-text-oss     as character no-undo .
      686   define variable v-text-gds     as character no-undo .
      687   define variable v-today        as date      no-undo .
      688   define variable v-rid-list     as character no-undo.
      689   define variable v-rid-list-oss as character no-undo.
      690   define variable v-rid-list-gds as character no-undo.
      691   define variable pList as character no-undo .
      692   define variable c-dir          as character no-undo.
      693   DEFINE BUTTON b-dir
      694        IMAGE-UP FILE "btn-down-arrow":U
      695        IMAGE-DOWN FILE "btn-down-arrow":U
      696        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      697        LABEL ""
      698        SIZE 3 BY .86.
      699   DEFINE BUTTON b-exit AUTO-GO
      700        LABEL "&Ввод"
      701        SIZE 10 BY 1
      702        BGCOLOR 8 .
      703   DEFINE BUTTON b-quit AUTO-END-KEY
      704        LABEL "&Отмена"
      705        SIZE 10 BY 1
      706        BGCOLOR 8 .
      707   DEFINE VARIABLE EDITOR-1 AS CHARACTER
      708        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
      709        SIZE 40.6 BY 4 NO-UNDO.
      710   DEFINE VARIABLE num-days AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 1
      711        LABEL "За последние"
      712        VIEW-AS FILL-IN
      713        SIZE 14 BY 1 NO-UNDO.
      714   DEFINE VARIABLE v-file AS CHARACTER FORMAT "X(25)":U
      715        LABEL "Имя файла"
      716        VIEW-AS FILL-IN
      717        SIZE 30.6 BY 1 NO-UNDO.
      718   DEFINE VARIABLE v-folder AS CHARACTER FORMAT "X(256)":U
      719        LABEL "Путь для выгрузки файла"
      720        VIEW-AS FILL-IN
      721        SIZE 27.6 BY 1 NO-UNDO.
      722   DEFINE VARIABLE RADIO-SET-1 AS INTEGER INITIAL 2
      723        VIEW-AS RADIO-SET VERTICAL
      724        RADIO-BUTTONS
      725             "Текущий", 2,
      726   "Все по фирме", 1,
      727   "Выборочно", 3,
      728   "Все", 4
      729        SIZE 15 BY 3 NO-UNDO.
      730   DEFINE RECTANGLE RECT-1
      731        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      732        SIZE 60 BY 4.71.
      733   DEFINE RECTANGLE RECT-8
      734        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      735        SIZE 60 BY 2.81.
      736   DEFINE FRAME Dialog-Frame
      737        b-exit AT ROW 1 COL 2.6
      738        b-quit AT ROW 1 COL 12.6
      739        num-days AT ROW 2.52 COL 19.6 COLON-ALIGNED WIDGET-ID 22
      740        EDITOR-1 AT ROW 4.52 COL 21.2 NO-LABEL
      741        RADIO-SET-1 AT ROW 5.1 COL 4 NO-LABEL
      742        v-folder AT ROW 10.14 COL 29 COLON-ALIGNED
      743        b-dir AT ROW 10.19 COL 58.6 WIDGET-ID 30
      744        v-file AT ROW 11.24 COL 29 COLON-ALIGNED
      745        "дней" VIEW-AS TEXT
      746             SIZE 8 BY 1 AT ROW 2.52 COL 36 WIDGET-ID 32
      747        " Выбор объектов:" VIEW-AS TEXT
      748             SIZE 17 BY .67 AT ROW 4.05 COL 3.4
      749             FGCOLOR 4
      750        " Выгрузка в:" VIEW-AS TEXT
      751             SIZE 13.6 BY .67 AT ROW 9.24 COL 4.8
      752             FGCOLOR 4
      753        RECT-1 AT ROW 4.29 COL 2.6
      754        RECT-8 AT ROW 9.67 COL 2.6
      755        SPACE(1.39) SKIP(0.55)
      756       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      757            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      758            TITLE "Параметры выгрузки результатов проверки HDD"
      759            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit.
      760   ASSIGN
      761          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      762          FRAME Dialog-Frame:HIDDEN           = TRUE.
      763   ASSIGN
      764          EDITOR-1:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      765   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      766   DO:
      767       APPLY "END-ERROR":U TO SELF.
      768     END.
      769   ON CHOOSE OF b-dir IN FRAME Dialog-Frame
      770   DO:
      771       system-dialog get-dir c-dir.
      772       v-folder:screen-value in frame Dialog-Frame = c-dir.
      773     END.
      774   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      775   DO:
      776       RUN proc-save IN THIS-PROCEDURE .
      777     END.
      778   ON VALUE-CHANGED OF RADIO-SET-1 IN FRAME Dialog-Frame
      779   DO:
      780       ASSIGN
      781         Radio-set-1
      782         .
      783       CASE RADIO-SET-1:
      784         WHEN 1 THEN
      785           DO:
      786             EDITOR-1 = "":U.
      787             EMPTY TEMP-TABLE tt-obj.
      788             FOR EACH ub.clients NO-LOCK
      789               WHERE ub.clients.obj-type = 'маг':U
      790               :
      791               CREATE tt-obj.
      792               ASSIGN
      793                 tt-obj.obj-code  = ub.clients.obj-code
      794                 tt-obj.obj-type  = ub.clients.obj-type
      795                 tt-obj.obj-name  = ub.clients.obj-name
      796                 tt-obj.host-code = ub.clients.db-num
      797                 .
      798               ASSIGN
      799                 v-text = v-text + chr(10) + ub.clients.obj-name
      800                 .
      801             END.
      802             ASSIGN
      803               v-text   = TRIM(v-text, chr(10))
      804               EDITOR-1 = v-text
      805               .
      806           END.
      807         WHEN 2 THEN
      808           DO:
      809             EMPTY TEMP-TABLE tt-obj.
      810             FIND FIRST ub.clients
      811               WHERE ub.clients.obj-type = v-cntxt-obj-type
      812               AND ub.clients.obj-code = v-cntxt-obj-code
      813               NO-LOCK
      814               .
      815             CREATE tt-obj.
      816             ASSIGN
      817               tt-obj.obj-code  = ub.clients.obj-code
      818               tt-obj.obj-type  = ub.clients.obj-type
      819               tt-obj.obj-name  = ub.clients.obj-name
      820               tt-obj.host-code = ub.clients.db-num
      821               .
      822             ASSIGN
      823               EDITOR-1 = ub.clients.obj-name
      824               .
      825           END.
      826         WHEN 3
      827         THEN
      828           DO:
      829             run ref/cli-all.w ( parParentProc
      830               , input "b-sel,b-mark"
      831               , 'маг':U
      832               , ?
      833               , ?
      834               , ?
      835               , ?
      836               , ?
      837               , output  v-rid-list
      838               ) .
      839             IF  v-rid-list <> "":U
      840               AND v-rid-list <> ?
      841               THEN
      842             DO:
      843               EDITOR-1 = "":U.
      844               define variable v-ii1  as integer   no-undo.
      845               define variable v-text as character no-undo.
      846               EMPTY TEMP-TABLE tt-obj.
      847               DO v-ii1 = 1 to num-entries(v-rid-list):
      848                 FIND FIRST ub.clients
      849                   WHERE RECID( ub.clients ) = integer(entry(v-ii1, v-rid-list))
      850                   NO-LOCK
      851                   .
      852                 ASSIGN
      853                   v-text = v-text + chr(10) + ub.clients.obj-name
      854                   .
      855                 CREATE tt-obj.
      856                 ASSIGN
      857                   tt-obj.obj-code  = ub.clients.obj-code
      858                   tt-obj.obj-type  = ub.clients.obj-type
      859                   tt-obj.obj-name  = ub.clients.obj-name
      860                   tt-obj.host-code = ub.clients.db-num
      861                   .
      862               END.
      863               ASSIGN
      864                 v-text   = TRIM(v-text, chr(10))
      865                 EDITOR-1 = v-text
      866                 .
      867             END.
      868           END.
      869         WHEN 4 THEN
      870           DO:
      871             EDITOR-1 = "Все":U.
      872             EMPTY TEMP-TABLE tt-obj.
      873             FOR EACH ub.clients
      874               WHERE ub.clients.obj-type = 'маг':U
      875               NO-LOCK
      876               :
      877               CREATE tt-obj.
      878               ASSIGN
      879                 tt-obj.obj-code  = ub.clients.obj-code
      880                 tt-obj.obj-type  = ub.clients.obj-type
      881                 tt-obj.obj-name  = ub.clients.obj-name
      882                 tt-obj.host-code = ub.clients.db-num
      883                 .
      884               ASSIGN
      885                 v-text = v-text + chr(10) + ub.clients.obj-name
      886                 .
      887             END.
      888           END.
      889         OTHERWISE
      890         DO:
      891         END.
      892       END case.
      893       DISPLAY
      894         EDITOR-1
      895         WITH FRAME Dialog-Frame.
      896     END.
      897   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      898     THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      899   MAIN-BLOCK:
      900   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      901     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      902   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      903     run mainmenu_getcntxt in parparentproc
      904       (output v-cntxt-db-num
      905       ,output v-cntxt-userid
      906       ,output v-cntxt-level
      907       ,output v-cntxt-host-code-obj
      908       ,output v-cntxt-obj-type
      909       ,output v-cntxt-obj-code
      910       ,output v-cntxt-db-num-obj
      911       ,output v-cntxt-is-admin
      912       ) .
      913   if p-mode = 'shd':U then
      914   do:
      915     assign
      916       frame Dialog-Frame :title = frame Dialog-Frame :title +
      917                           substitute(". &1: БД &2, Задача номер &3"
      918                           , p-task-type
      919                           , p-db-num-char
      920                           , p-task-num )
      921       .
      922   end.
      923   run init-param-values in this-procedure ( input p-task-type
      924     , input p-db-num-char
      925     , input p-task-num
      926     ) .
      927   RUN enable_UI.
      928   WAIT-FOR GO OF FRAME Dialog-Frame.
      929   END.
      930   RUN disable_UI.
      931   PROCEDURE attach-attr-to-schedule-line :
      932     DEFINE INPUT PARAMETER p-param-list AS CHARACTER NO-UNDO.
      933     define input  parameter p-obj-list as character no-undo .
      934     define buffer buf_schedule      for schedule.
      935     define buffer buf_schedule-attr for schedule-attr.
      936     define buffer lock-batchprocess for ub.batchprocess.
      937     CASE p-mode:
      938       when 'shd':U then
      939         do:
      940           run gbl/lock-prc.p
      941             (input 'schd':U
      942             ,input 'hdd-rep':U
      943             ,input 0
      944             ,input 0
      945             ,input '':U
      946             ,input ""
      947             ,input ""
      948             ,input (
      949             "выгрузка результатов проверки HDD"
      950             )
      951             ,input yes
      952             ,buffer lock-batchprocess
      953             ) no-error .
      954           FIND FIRST buf_schedule-attr NO-LOCK WHERE
      955             buf_schedule-attr.task-type   = p-task-type
      956             and buf_schedule-attr.cre-db-num = INTEGER(p-db-num-char)
      957             and buf_schedule-attr.attr-code = ('schd-free-id':U + chr(4) + 'help-road') NO-ERROR.
      958           IF AVAILABLE  buf_schedule-attr
      959             AND buf_schedule-attr.task-num <> p-task-num
      960             AND buf_schedule-attr.task-num <> - 1
      961             and p-task-num <> - 1
      962             THEN
      963           DO:
      964             MESSAGE
      965               substitute("Уже есть расписание выгрузки результатов проверки HDD БД &1&2" +
      966               "номер расписания &3"
      967               ,buf_schedule-attr.cre-db-num
      968               ,chr(10)
      969               ,buf_schedule-attr.task-num)
      970               VIEW-AS ALERT-BOX ERROR.
      971             UNDO, RETURN ERROR.
      972           END.
      973           find first buf_schedule no-lock
      974             where buf_schedule.task-type   = p-task-type
      975             and buf_schedule.cre-db-num  = INTEGER(p-db-num-char)
      976             and buf_schedule.task-num    = p-task-num
      977             no-error.
      978           if not available buf_schedule
      979             and (  p-task-type   <> 'autofree':U
      980             or p-db-num-char <> p-db-num-char
      981             or p-task-num    <> -1 )
      982             then
      983           do:
      984             message
      985               vss-workfile vss-revision vss-description
      986               skip
      987               "Не найдена строка расписания."
      988               skip return-value
      989               skip trim(error-status :get-message(1))
      990               trim(error-status :get-message(2))
      991               trim(error-status :get-message(3))
      992               view-as alert-box error.
      993             undo, return error .
      994           end.
      995           run schedule-attr-write in this-procedure (
      996             input INTEGER(p-db-num-char)
      997             , input p-task-type
      998             , input p-task-num
      999             , input 'schedule-param-list':U
     1000             , input p-param-list
     1001             ).
     1002           run schedule-attr-write in this-procedure (
     1003             input INTEGER(p-db-num-char)
     1004             , input p-task-type
     1005             , input p-task-num
     1006             , input 'schedule-obj-list':U
     1007             , input p-obj-list
     1008             ).
     1009         end.
     1010       when 'run':U then
     1011         do:
     1012           p-params = p-param-list.
     1013         end.
     1014     END CASE.
     1015   END PROCEDURE.
     1016   PROCEDURE check-host-list :
     1017     define input-output parameter pHost-code-list as character no-undo.
     1018     define variable iCount        as integer   no-undo.
     1019     define variable cTemp         as character no-undo.
     1020     define variable iTempHostCode as integer   no-undo.
     1021     define variable cNewHostList  as character no-undo.
     1022     define variable lOk           as logical   no-undo.
     1023     do iCount = 1 to num-entries( pHost-code-list ):
     1024       cTemp = entry( iCount, pHost-code-list ).
     1025       assign
     1026         iTempHostCode = integer( cTemp ) no-error
     1027         .
     1028       run validate-host( iTempHostCode, no, no, output lOk ).
     1029       if lOk and lookup( string( iTempHostCode ), cNewHostList ) = 0
     1030         then
     1031       do:
     1032         assign
     1033           cNewHostList = cNewHostList + ',' + string( iTempHostCode )
     1034           .
     1035       end.
     1036     end.
     1037     pHost-code-list = trim( cNewHostList, ',' ).
     1038     return.
     1039   END PROCEDURE.
     1040   PROCEDURE convert :
     1041     define input-output parameter v-rid-list as character no-undo.
     1042     define variable v-list as character no-undo .
     1043     define variable v-ind  as integer   no-undo .
     1044     define buffer buf_sysconf for ub.sysconf.
     1045     do
     1046       on error undo, return error return-value
     1047       :
     1048       do v-ind = 1 to num-entries(v-rid-list)
     1049         :
     1050         find first buf_sysconf no-lock
     1051           where recid(buf_sysconf) = integer(entry(v-ind, v-rid-list))
     1052           no-error .
     1053         if available buf_sysconf
     1054           then
     1055         do:
     1056           assign
     1057             v-list = v-list
     1058                     + (if v-list = '':U
     1059                       then '':U
     1060                       else chr(44)
     1061                       )
     1062                     + string(buf_sysconf.host-code)
     1063             .
     1064         end.
     1065       end.
     1066       assign
     1067         v-rid-list = v-list
     1068         .
     1069     end.
     1070   END PROCEDURE.
     1071   PROCEDURE disable_UI :
     1072     HIDE FRAME Dialog-Frame.
     1073   END PROCEDURE.
     1074   PROCEDURE enable_UI :
     1075     DISPLAY num-days EDITOR-1 RADIO-SET-1 v-folder v-file
     1076         WITH FRAME Dialog-Frame.
     1077     ENABLE b-exit b-quit RECT-1 RECT-8 num-days EDITOR-1 RADIO-SET-1 v-folder
     1078            b-dir v-file
     1079         WITH FRAME Dialog-Frame.
     1080     VIEW FRAME Dialog-Frame.
     1081   END PROCEDURE.
     1082   PROCEDURE init-param-values :
     1083     do
     1084       on error undo, return error
     1085       :
     1086       define input parameter p-task-type              as character    no-undo.
     1087       define input parameter p-db-num-char            as character    no-undo.
     1088       define input parameter p-task-num               as integer      no-undo.
     1089       define variable v-param-list as character no-undo.
     1090       define variable v-param-type as character no-undo.
     1091       define variable v-obj-list   as character no-undo .
     1092       define variable v-gds-list   as character no-undo .
     1093       define variable v-oss-list   as character no-undo .
     1094       define variable ii           as integer   no-undo .
     1095       define variable v-entry-1    as character no-undo .
     1096       define variable v-entry-2    as character no-undo .
     1097       define variable v-entry-3    as character no-undo .
     1098       define variable v-task-num   as integer   no-undo .
     1099       define variable v-ii1        as integer   no-undo.
     1100       define variable v-text       as character no-undo.
     1101       define variable v-ii2        as integer   no-undo.
     1102       define buffer buf_tt-obj        for tt-obj.
     1103       define buffer buf_schedule      for ub.schedule.
     1104       define buffer buf_schedule-attr for ub.schedule-attr.
     1105       DO WITH FRAME Dialog-Frame:
     1106         CASE p-mode:
     1107           when 'shd':U then
     1108             do:
     1109               if p-task-num > 0
     1110                 then
     1111               do:
     1112                 v-task-num = p-task-num.
     1113               end.
     1114               else
     1115               do:
     1116                 for each buf_schedule
     1117                   where buf_schedule.task-type     = p-task-type
     1118                   AND buf_schedule.cre-db-num    = INTEGER(p-db-num-char)
     1119                   no-lock
     1120                   ,
     1121                   first buf_schedule-attr
     1122                   where buf_schedule-attr.task-type   = p-task-type
     1123                   AND buf_schedule-attr.cre-db-num  = INTEGER(p-db-num-char)
     1124                   AND buf_schedule-attr.task-num    = buf_schedule.task-num
     1125                   AND buf_schedule-attr.attr-code   = ('schd-free-id':U + chr(4) + 'help-road')
     1126                   no-lock
     1127                   :
     1128                   ASSIGN
     1129                     v-task-num = buf_schedule.task-num
     1130                     .
     1131                   leave .
     1132                 end.
     1133               end.
     1134               if v-task-num > 0
     1135                 then
     1136               do:
     1137                 run schedule-attr-value in this-procedure  ( input p-db-num-char
     1138                   , input p-task-type
     1139                   , input v-task-num
     1140                   , input 'schedule-param-list':U
     1141                   , output v-param-list
     1142                   , output v-param-type
     1143                   ) .
     1144                 run schedule-attr-value in this-procedure  ( input p-db-num-char
     1145                   , input p-task-type
     1146                   , input v-task-num
     1147                   , input 'schedule-obj-list':U
     1148                   , output v-obj-list
     1149                   , output v-param-type
     1150                   ) .
     1151               end.
     1152               v-ii2 = num-entries( v-param-list, chr(4) ).
     1153               if v-ii2 < 5 THEN
     1154               do:
     1155                 do v-ii1 = v-ii2 to 4:
     1156                   v-param-list = v-param-list
     1157                     + '':U
     1158                     + chr(4).
     1159                 end.
     1160               end.
     1161               ASSIGN
     1162                 v-folder    = ENTRY(1, v-param-list, chr(4))
     1163                 v-file      = ENTRY(2, v-param-list, chr(4))
     1164                 RADIO-SET-1 = INTEGER( ENTRY(3, v-param-list, chr(4)) )
     1165                 num-days    = INTEGER( ENTRY(4, v-param-list, chr(4)) )
     1166                 .
     1167                 if num-days = 0 then num-days = 1 .
     1168               if RADIO-SET-1 = 0 then RADIO-SET-1 = 2 .
     1169               DISPLAY
     1170                 v-folder
     1171                 v-file
     1172                 RADIO-SET-1
     1173                 num-days
     1174                 .
     1175               EMPTY TEMP-TABLE buf_tt-obj.
     1176               IF v-obj-list <> "":U
     1177                 and RADIO-SET-1 = 3
     1178                 THEN
     1179               do ii = 1 to num-entries(v-obj-list, chr(4))
     1180                 on error undo, next
     1181                 :
     1182                 assign
     1183                   v-entry-1 = entry(ii, v-obj-list, chr(4))
     1184                   .
     1185                 FIND FIRST ub.clients
     1186                   WHERE ub.clients.db-num = integer(v-entry-1)
     1187                   NO-LOCK
     1188                   NO-ERROR
     1189                   .
     1190                 IF AVAILABLE ub.clients
     1191                   THEN
     1192                 DO:
     1193                   create tt-obj.
     1194                   ASSIGN
     1195                     tt-obj.obj-code  = ub.clients.obj-code
     1196                     tt-obj.obj-type  = ub.clients.obj-type
     1197                     tt-obj.obj-name  = ub.clients.obj-name
     1198                     tt-obj.host-code = ub.clients.db-num
     1199                     v-text           = v-text + chr(10) + ub.clients.obj-name
     1200                     .
     1201                 END.
     1202                 ASSIGN
     1203                   v-text   = TRIM(v-text, chr(10))
     1204                   EDITOR-1 = v-text
     1205                   .
     1206               end.
     1207               ELSE
     1208               DO:
     1209                 if RADIO-SET-1 = 4 then
     1210                 do:
     1211                   EDITOR-1 = "Все":U.
     1212                   FOR EACH ub.clients
     1213                     WHERE ub.clients.obj-type = 'маг':U
     1214                     NO-LOCK
     1215                     :
     1216                     CREATE tt-obj.
     1217                     ASSIGN
     1218                       tt-obj.obj-code  = ub.clients.obj-code
     1219                       tt-obj.obj-type  = ub.clients.obj-type
     1220                       tt-obj.obj-name  = ub.clients.obj-name
     1221                       tt-obj.host-code = ub.clients.db-num
     1222                       .
     1223                   END.
     1224                 end.
     1225                 else
     1226                 do:
     1227                   apply "VALUE-CHANGED" TO RADIO-SET-1.
     1228                 end.
     1229               END.
     1230               DISPLAY
     1231                 EDITOR-1
     1232                 WITH FRAME Dialog-Frame.
     1233           end.
     1234           WHEN 'run'
     1235           THEN
     1236             DO:
     1237               v-param-list = '':U
     1238                 + chr(4)
     1239                 + '':U
     1240                 + chr(4)
     1241                 + '':U
     1242                 + chr(4)
     1243   .
     1244             END.
     1245         END CASE.
     1246       END.
     1247     END.
     1248   END PROCEDURE.
     1249   PROCEDURE proc-save :
     1250     DEFINE VARIABLE glog             AS LOGICAL   NO-UNDO.
     1251     DEFINE VARIABLE v-param-list     AS CHARACTER NO-UNDO.
     1252     define variable v-obj-list       as character no-undo .
     1253     define variable v-list           as character no-undo .
     1254     define variable v-oss-list       as character no-undo .
     1255     define variable v-gds-list       as character no-undo .
     1256     define variable ii               as integer   no-undo .
     1257     define variable v-exists         as logical   no-undo .
     1258     define variable v-date-file-name as character no-undo.
     1259     define variable v-time-file      as char      no-undo.
     1260     define buffer buf_tt-obj      for tt-obj .
     1261     define variable v-file-name as character no-undo .
     1262     ASSIGN
     1263       FRAME Dialog-Frame
     1264       RADIO-SET-1
     1265       EDITOR-1
     1266       v-folder
     1267       v-file
     1268       num-days
     1269       .
     1270     if num-days < 0 then
     1271     do:
     1272       message
     1273         "Кол-во дней задан неверно. "
     1274         skip "Задайте интервал правильно или отмените экспорт."
     1275         view-as alert-box information.
     1276       apply "entry" to num-days.
     1277       undo, return no-apply.
     1278     end.
     1279     if not can-find( first buf_tt-obj ) then
     1280     do:
     1281       message
     1282         "Не заданы объекты для выгрузки"
     1283         view-as alert-box error .
     1284       return error.
     1285     end.
     1286     v-obj-list = ''.
     1287     for each buf_tt-obj :
     1288       assign
     1289         v-obj-list = v-obj-list
     1290                    + string(buf_tt-obj.host-code) + chr(4)
     1291         .
     1292     end.
     1293     if v-file = "" then
     1294     do:
     1295       assign
     1296         v-time-file      = replace(  string(time,"HH:MM:SS"),  ":",  ""  )
     1297         v-today          = today
     1298         v-date-file-name = STRING(YEAR(v-today), "9999") +  STRING(DAY(v-today), "99") + STRING(MONTH(v-today), "99")
     1299         v-file           = substitute( "rep_PA_&1_&2"
     1300                                   , v-date-file-name, v-time-file )
     1301         .
     1302     end.
     1303     ASSIGN
     1304       v-obj-list = TRIM(v-obj-list, chr(4)).
     1305       v-param-list = v-folder + chr(4) +
     1306       v-file   + chr(4) +
     1307       STRING( RADIO-SET-1 ) + chr(4) +
     1308       string(if num-days <> ? then string(num-days) else "") + chr(4)
     1309       .
     1310     IF p-mode = 'shd' THEN
     1311     DO:
     1312       run attach-attr-to-schedule-line in this-procedure ( INPUT v-param-list
     1313         , INPUT v-obj-list
     1314         ) .
     1315     END.
     1316   END PROCEDURE.
