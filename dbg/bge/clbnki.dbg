      570   procedure init-host-list :
      571   define input parameter p-host-list as character no-undo .
      572   define variable v-counter as integer no-undo .
      573   define buffer buf_temp_obj-list for temp_obj-list.
      574     do
      575     on error undo, return error
      576     :
      577     for each buf_temp_obj-list
      578     :
      579         delete buf_temp_obj-list.
      580     end.
      581     do v-counter = 1 to num-entries( p-host-list ) / 2
      582     :
      583         create buf_temp_obj-list.
      584         assign
      585             buf_temp_obj-list.obj-type = entry( 2 * v-counter - 1,  p-host-list )
      586             buf_temp_obj-list.obj-code = integer( entry( 2 * v-counter,      p-host-list ) )
      587         .
      588     end.
      589     end.
      590   end procedure.
      591   procedure fill-hfin-schet :
      592   define input parameter p-hfin-schet as character no-undo .
      593   define variable v-counter as integer no-undo .
      594   define buffer buf_temp_hfin-schet for temp_hfin-schet.
      595     do
      596     on error undo, return error return-value
      597     :
      598         for each buf_temp_hfin-schet
      599         :
      600             delete buf_temp_hfin-schet.
      601         end.
      602         do v-counter = 1 to num-entries( p-hfin-schet ) / 6
      603         :
      604             create buf_temp_hfin-schet.
      605             assign
      606             buf_temp_hfin-schet.host-code = integer( entry( 6 * v-counter - 5,      p-hfin-schet ) )
      607             buf_temp_hfin-schet.r-schet = entry( 6 * v-counter - 4,  p-hfin-schet )
      608             buf_temp_hfin-schet.cli-type =  entry( 6 * v-counter - 3,      p-hfin-schet )
      609             buf_temp_hfin-schet.cli-code = integer( entry( 6 * v-counter - 2,      p-hfin-schet ) )
      610             buf_temp_hfin-schet.code-bank = integer( entry( 6 * v-counter - 1,      p-hfin-schet ) )
      611             buf_temp_hfin-schet.code-schet = integer( entry( 6 * v-counter,      p-hfin-schet ) )
      612             .
      613         end.
      614     end.
      615   end procedure.
      616   procedure fill-cfin-schet :
      617   define input parameter p-cfin-schet as character no-undo .
      618   define variable v-counter as integer no-undo .
      619   define buffer buf_temp_cfin-schet for temp_cfin-schet.
      620     do
      621     on error undo, return error return-value
      622     :
      623         for each buf_temp_cfin-schet
      624         :
      625             delete buf_temp_cfin-schet.
      626         end.
      627         do v-counter = 1 to num-entries( p-cfin-schet ) / 6
      628         :
      629             create buf_temp_cfin-schet.
      630             assign
      631             buf_temp_cfin-schet.host-code = integer( entry( 6 * v-counter - 5,      p-cfin-schet ) )
      632             buf_temp_cfin-schet.r-schet = entry( 6 * v-counter - 4,  p-cfin-schet )
      633             buf_temp_cfin-schet.cli-type =  entry( 6 * v-counter - 3,      p-cfin-schet )
      634             buf_temp_cfin-schet.cli-code = integer( entry( 6 * v-counter - 2,      p-cfin-schet ) )
      635             buf_temp_cfin-schet.code-bank = integer( entry( 6 * v-counter - 1,      p-cfin-schet ) )
      636             buf_temp_cfin-schet.code-schet = integer( entry( 6 * v-counter,      p-cfin-schet ) )
      637             .
      638         end.
      639     end.
      640   end procedure.
      641   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      642   define NEW SHARED temp-table temp_hfields no-undo
      643   field order_ as integer
      644   field label_ as character
      645   field name_ as character
      646   field value_ as character init ?
      647   field imported    as logical
      648   field readed      as logical
      649   field subject     as character
      650   index pi is primary
      651   name_
      652   index ilab
      653   label_
      654   index ii
      655   imported
      656   index ir
      657   readed
      658   index isubject subject
      659   .
      660   procedure create-TEMP-hfields  :
      661   define input parameter p-mode as character no-undo .
      662     do
      663     on error undo, return error
      664     :
      665   define variable ii as integer no-undo .
      666   define variable h-init-doc as character  extent 116 init
      667   [
      668       'Дата='                           , 'doc-date'
      669      ,'Номер='                          , 'prn-doc-code'
      670      ,'Сумма='                          , 'sum-doc'
      671      ,'Плательщик='                     , 'payer-inn/payer-name'
      672      ,'Плательщик1='                    , 'payer-name'
      673      ,'Плательщик2='                    , 'payer-r-schet'
      674      ,'Плательщик3='                    , 'payer-bank-name'
      675      ,'Плательщик4='                    , 'payer-bank-city'
      676      ,'ПлательщикСчет='                 , 'payer-r-schet'
      677      ,'ПлательщикИНН='                  , 'payer-INN'
      678      ,'ПлательщикКПП='                  , 'payer-kpp'
      679      ,'ПлательщикРасчСчет='             , 'payer-r-schet'
      680      ,'ПлательщикБИК='                  , 'payer-bik'
      681      ,'ПлательщикКорСчет='              , 'payer-c-schet'
      682      ,'ПлательщикБанк1='                , 'payer-bank-name'
      683      ,'ПлательщикБанк2='                , 'payer-bank-city'
      684      ,'Получатель='                     , 'receiver-inn/receiver-name'
      685      ,'Получатель1='                    , 'receiver-name'
      686      ,'Получатель2='                    , 'receiver-r-schet'
      687      ,'Получатель3='                    , 'receiver-bank-name'
      688      ,'Получатель4='                    , 'receiver-bank-city'
      689      ,'ПолучательСчет='                 , 'receiver-r-schet'
      690      ,'ПолучательИНН='                  , 'receiver-INN'
      691      ,'ПолучательКПП='                  , 'receiver-kpp'
      692      ,'ПолучательРасчСчет='             , 'receiver-r-schet'
      693      ,'ПолучательБИК='                  , 'receiver-bik'
      694      ,'ПолучательКорСчет='              , 'receiver-c-schet'
      695      ,'ПолучательБанк1='                , 'receiver-bank-name'
      696      ,'ПолучательБанк2='                , 'receiver-bank-city'
      697      ,'СтатусСоставителя='              , 'stat-pl'
      698      ,'ПоказательКБК='                  , 'f104'
      699      ,'ПоказательОснования='            , 'f106'
      700      ,'ОКАТО='                          , 'f105'
      701      ,'ПоказательПериода='              , 'f107'
      702      ,'ПоказательНомера='               , 'f108'
      703      ,'ПоказательДаты='                 , 'f109'
      704      ,'ПоказательТипа='                 , 'f110'
      705      ,'НазначениеПлатежа='              , 'naznach-plat/'
      706      ,'ВидПлатежа='                     , 'vid-plat'
      707      ,'ВидОплаты='                      , 'vid-opl'
      708      ,'Очередность='                    , 'ocher-pl'
      709      ,'СрокПлатежа='                    , 'srok-pl'
      710      ,'СекцияДокумент='                 , 'fin-ext-doc-type/'
      711      ,'ДатаСписано='                    , 'fact-date'
      712      ,'ДатаПоступило='                  , 'fact-date'
      713      ,''                                , 'receiver-type'
      714      ,''                                , 'receiver-code'
      715      ,''                                , 'receiver-code-schet'
      716      ,''                                , 'payer-type'
      717      ,''                                , 'payer-code'
      718      ,''                                , 'payer-code-schet'
      719      ,''                                , 'fin-ext-doc-type'
      720      ,''                                , 'fin-doc-type'
      721      ,''                                , 'host-code'
      722      ,''                                , 'curr-code'
      723      ,'КвитанцияДата'                   , 'cvitdate'
      724      ,'КвитанцияВремя'                  , 'cvitname'
      725      ,'КвитанцияСодержание'             , 'cvitcont'
      726                                      ] no-undo.
      727   define variable h-init-statement as character  extent 40 init
      728   [
      729       'ДатаНачала='                     , 'start-date'
      730      ,'ДатаКонца='                      , 'end-date'
      731      ,'РасчСчет='                       , 'r-schet'
      732      ,'НачальныйОстаток='               , 'start-sum-doc'
      733      ,'КонечныйОстаток='                , 'end-sum-doc'
      734      ,'ВсегоПоступило='                 , 'in-sum-doc'
      735      ,'ВсегоСписано='                   , 'out-sum-doc'
      736      ,'СекцияРасчСчет='                 , 'fins-ext-doc-type/'
      737      ,''                                , 'fins-ext-doc-type'
      738      ,''                                , 'fins-doc-type'
      739      ,''                                , 'host-code'
      740      ,''                                , 'curr-code'
      741      ,''                                , 'code-schet'
      742      ,''                                , 'code-bank'
      743      ,''                                , 'cli-name'
      744      ,''                                , 'bank-name'
      745      ,''                                , 'bank-city'
      746      ,''                                , 'cl-bank'
      747      ,''                                , 'bik'
      748      ,'ДатаСоздания='                   , 'bank-date'
      749                                      ] no-undo.
      750       for each temp_hfields:
      751         delete temp_hfields.
      752       end.
      753       do ii = 1 to (if p-mode = 'exp' then 42 else 58):
      754         create temp_hfields.
      755         assign
      756         temp_hfields.order_ = ii
      757         temp_hfields.label_ = h-init-doc[ii * 2 - 1]
      758         temp_hfields.name_ = h-init-doc[ii * 2]
      759         temp_hfields.subject = 'fin-doc':U
      760         .
      761       end.
      762       do ii = 1 to (if p-mode = 'exp' then 0 else 20):
      763         create temp_hfields.
      764         assign
      765         temp_hfields.order_ = ii
      766         temp_hfields.label_ = h-init-statement[ii * 2 - 1]
      767         temp_hfields.name_ = h-init-statement[ii * 2]
      768         temp_hfields.subject = 'fin-statement':U
      769         .
      770       end.
      771     end.
      772   end procedure.
      773   define variable v-input-error as logical no-undo .
      774   define variable v-view-log as logical no-undo .
      775   define variable v-esm as character no-undo .
      776   define variable log-file-name as character no-undo init 'ext-cbnk.log'.
      777   if num-entries(p-parameter, chr(4)) <> 4
      778   then do:
      779     assign
      780     v-input-error = yes
      781     v-esm         = substitute("Неверное количество ENTRY в составном параметре - &1, должно быть 4"
      782                                , num-entries(p-parameter, chr(4))).
      783     .
      784   end.
      785   else do:
      786     if num-entries(entry(2, p-parameter, chr(4))) <> 9
      787     then do:
      788       assign
      789       v-input-error = yes
      790       v-esm         = substitute("Неверное количество ENTRY в 2-ом ENTRY составного параметре - &1, должно быть 9"
      791                                 , num-entries(entry(2, p-parameter, chr(4)))).
      792       .
      793     end.
      794     if num-entries(entry(3, p-parameter, chr(4))) <> 5
      795     then do:
      796       assign
      797       v-input-error = yes
      798       v-esm         = substitute("Неверное количество ENTRY в 3-ом ENTRY составного параметре - &1, должно быть 5"
      799                                 , num-entries(entry(3, p-parameter, chr(4)))).
      800       .
      801     end.
      802     assign
      803     p-auto = integer(entry(1, p-parameter, chr(4)) )
      804     p-format  = entry( 1, entry(2, p-parameter, chr(4)) )
      805     p-encoding  = entry( 2, entry(2, p-parameter, chr(4)) )
      806     p-rs-1 = integer( entry( 3, entry(2, p-parameter, chr(4))) )
      807     p-curr-host-code = integer(entry(4, entry(2, p-parameter, chr(4))))
      808     p-rs-hsch = integer( entry( 6, entry(2, p-parameter, chr(4)) ) )
      809     p-create  = logical( entry( 8, entry(2, p-parameter, chr(4)) ) )
      810     p-no-th-create  = (if num-entries(entry(2, p-parameter, chr(4))) > 8
      811                        and p-create = no
      812                        then logical( entry( 9, entry(2, p-parameter, chr(4)) ) )
      813                        else no)
      814     no-error .
      815     if error-status:error then do:
      816       assign
      817       v-esm = error-status:get-message(1)
      818       v-input-error = yes
      819       .
      820     end.
      821   end.
      822   if v-input-error = yes then do:
      823     run write-log-and-file in p-log-handle (
      824           input 1
      825         , input log-file-name
      826         , input 1
      827         , input substitute("Ошибка входных параметров &1:&2&3&4"
      828                            , p-parameter
      829                            , chr(10)
      830                            , v-esm
      831                            , return-value
      832                            )).
      833     assign
      834     v-view-log = yes.
      835     return.
      836   end.
      837   if p-rs-1 <> 1
      838   and p-rs-1 <> 2 then do:
      839     v-esm = substitute("Неизвестное значение параметра выбора фирмы:&1", p-rs-1).
      840     run write-log-and-file in p-log-handle (
      841           input 1
      842         , input log-file-name
      843         , input 1
      844         , input substitute("Ошибка входных параметров &1:&2&3&4"
      845                            , p-parameter
      846                            , chr(10)
      847                            , v-esm
      848                            , return-value
      849                            )).
      850     assign
      851     v-view-log = yes.
      852     return.
      853   end.
      854   if p-rs-1 <> 2
      855   and p-rs-hsch <> 1
      856   then do:
      857     v-esm = substitute("Несопоставимые значения параметра выбора фирмы (&1)" +
      858                        " и параметра выбора счетов фирмы (&2)"
      859                        , p-rs-1
      860                        , p-rs-hsch
      861                        ).
      862     run write-log-and-file in p-log-handle (
      863           input 1
      864         , input log-file-name
      865         , input 1
      866         , input substitute("Ошибка входных параметров &1:&2&3&4"
      867                            , p-parameter
      868                            , chr(10)
      869                            , v-esm
      870                            , return-value
      871                            )).
      872     assign
      873     v-view-log = yes.
      874     return.
      875   end.
      876   run proc-main in this-procedure no-error .
      877   if error-status:error then do:
      878     run write-log-and-file in p-log-handle (
      879           input 1
      880         , input log-file-name
      881         , input 1
      882         , input substitute("Ошибка при импорте данных из системы КЛИЕНТ-БАНК в формате&1&2&3 &4"
      883                            , entry (lookup (p-format, '1s':U) + 1, ',' + '1С':U)
      884                            , chr(10)
      885                            , error-status:get-message(1)
      886                            , return-value
      887                            )).
      888     assign
      889     v-view-log = yes.
      890   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      891   if v-view-log
      892   and not g#news
      893   and not g#auto
      894   then do:
      895     message
      896     substitute('!!!В процессе Импорта из системы КЛИЕНТ-БАНК  произошли ошибки!!!')  skip
      897     "!!!Внимательно прочитайте Log-file!!"
      898     view-as alert-box error .
      899        define variable v-user-action8   as character no-undo .
      900     define variable v-printed8       as logical   no-undo .
      901     run gbl/prnfilen.w
      902       (input  (substitute('!!!В процессе Импорта из системы КЛИЕНТ-БАНК  произошли ошибки!!!'))
      903       ,input  0
      904       ,input  (string("./":U) + 'ext-cbnk.log')
      905       ,input  7
      906       ,output v-user-action8
      907       ,output v-printed8
      908       ) .
      909   end.
      910   if v-view-log = true
      911   and (g#news
      912   or g#auto)
      913   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
      914   then do:
      915      run cb_set-view-log in p-parent-handle ( input yes).
      916   end.
      917    .
      918     return "error":U.
      919   end.
      920   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      921   if v-view-log
      922   and not g#news
      923   and not g#auto
      924   then do:
      925     message
      926     substitute('!!!В процессе Импорта из системы КЛИЕНТ-БАНК  произошли ошибки!!!')  skip
      927     "!!!Внимательно прочитайте Log-file!!"
      928     view-as alert-box error .
      929        define variable v-user-action10   as character no-undo .
      930     define variable v-printed10       as logical   no-undo .
      931     run gbl/prnfilen.w
      932       (input  (substitute('!!!В процессе Импорта из системы КЛИЕНТ-БАНК  произошли ошибки!!!'))
      933       ,input  0
      934       ,input  (string("./":U) + 'ext-cbnk.log')
      935       ,input  7
      936       ,output v-user-action10
      937       ,output v-printed10
      938       ) .
      939   end.
      940   if v-view-log = true
      941   and (g#news
      942   or g#auto)
      943   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
      944   then do:
      945      run cb_set-view-log in p-parent-handle ( input yes).
      946   end.
      947    .
      948   procedure proc-main :
      949   define buffer buf_sysconf for ub.sysconf.
      950   define buffer buf_fin-schet for ub.fin-schet.
      951   define buffer buf_fin-bank for ub.fin-bank.
      952   define variable ii as integer no-undo .
      953   define variable v-count as integer no-undo .
      954   define variable v-processed as integer no-undo .
      955   define variable v-created as integer no-undo .
      956   define variable v-count-statement as integer no-undo .
      957   define variable v-processed-statement as integer no-undo .
      958   define variable v-created-statement as integer no-undo .
      959   define variable v-full-path        as character no-undo .
      960   define variable v-path             as character no-undo .
      961   define variable v-file-name        as character no-undo .
      962   define variable v-file-name-no-ext as character no-undo .
      963   define variable v-file-name-ext    as character no-undo .
      964     do
      965     on error undo, return error return-value
      966     :
      967       run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("Импорт документов из системы КЛИЕНТ-БАНК по формату &1", entry (lookup (p-format, '1s':U) + 1, ',' + '1С':U))).
      968       if p-rs-1 = 1 then do:
      969         run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("     Фирмы: Все")).
      970       end.
      971       else do:
      972         run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("     Фирмы:")).
      973         for each temp_obj-list no-lock:
      974                         run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("     &1&2", temp_obj-list.obj-type, temp_obj-list.obj-code)).
      975         end.
      976       end.
      977       if p-rs-hsch = 1 then do:
      978         run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("     Счета фирм: Все")).
      979       end.
      980       else do:
      981         run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("     Счета фирм:")).
      982         for each temp_hfin-schet no-lock:
      983                         run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input SUBSTITUTE("&1 &2&3 &4/&5",                                          temp_hfin-schet.r-schet                                        ,temp_hfin-schet.cli-type                                       ,temp_hfin-schet.cli-code                                       ,temp_hfin-schet.code-bank                                      ,temp_hfin-schet.code-schet)).
      984         end.
      985       end.
      986       run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("     Кодировка: &1",  if p-encoding = "windows-1251" then 'Windows' else 'DOS')).
      987        _buf_sysconf:
      988        for each buf_sysconf  no-lock:
      989          if p-rs-1 = 2 then do:
      990            find first temp_obj-list no-lock where
      991                       temp_obj-list.obj-type = 'орг':U
      992                   AND temp_obj-list.obj-code = buf_sysconf.host-code no-error .
      993            if not available temp_obj-list then next _buf_sysconf.
      994          end.
      995          _buf_fin-schet:
      996          for each buf_Fin-schet no-lock where
      997                  buf_fin-schet.host-code = buf_sysconf.host-code
      998              AND buf_fin-schet.cli-type  = 'орг':U
      999              AND buf_fin-schet.cli-code  = buf_sysconf.host-code
     1000              and buf_fin-schet.status_   = 'тек':U:
     1001             if p-rs-hsch = 2  then do:
     1002               find first temp_hfin-schet no-lock where
     1003                         temp_hfin-schet.host-code = buf_sysconf.host-code
     1004                     AND temp_hfin-schet.code-schet = buf_fin-schet.code-schet
     1005                     AND temp_hfin-schet.code-bank = buf_fin-schet.code-bank  no-error.
     1006               if not available temp_hfin-schet then next _buf_fin-schet.
     1007             end.
     1008             else do:
     1009             end.
     1010             find first buf_fin-bank no-lock where
     1011                       buf_fin-bank.host-code = buf_sysconf.host-code
     1012                   AND buf_fin-bank.code-bank = buf_fin-schet.code-bank.
     1013             find first temp-bik where
     1014                       temp-bik.host-code = buf_sysconf.host-code
     1015                   AND temp-bik.bik       = buf_fin-bank.bik no-error.
     1016             if not available temp-bik then do:
     1017                run get-inis-from-bik-host in this-procedure (
     1018                                                              input buf_sysconf.host-code
     1019                                                             ,input buf_fin-bank.bik
     1020                                                             ,input buf_fin-bank.code-bank) no-error .
     1021                if error-status:error then do:
     1022                 run write-log-and-file in p-log-handle (
     1023                       input 1
     1024                     , input log-file-name
     1025                     , input 1
     1026                     , input  substitute( "!!!Ошибка получения пути к файлу импорта для загрузки в формате &1&2 Фирма &3 Банк с БИК &4&2&5 &6&2" +
     1027                                          "!!!Финдокументы по фирме &3 БИК &4 импортироваться не будут!"
     1028                                                   , entry (lookup (p-format, '1s':U) + 1, ',' + '1С':U)
     1029                                                   , chr(10)
     1030                                                   , buf_fin-bank.host-code
     1031                                                   , buf_fin-bank.bik
     1032                                                   , return-value
     1033                                                   , error-status :get-message( 1 )
     1034                                               )
     1035                                                       ).
     1036                 assign
     1037                 v-view-log = yes.
     1038                end.
     1039             end.
     1040             find first temp-bik where
     1041                       temp-bik.host-code = buf_sysconf.host-code
     1042                   AND temp-bik.bik       = buf_fin-bank.bik no-error.
     1043             if not available temp-bik
     1044             or temp-bik.o_name = '':u then next _buf_fin-schet.
     1045          end.
     1046        end.
     1047       _temp-bik:
     1048       for each temp-bik:
     1049         run gbl/filename.p (
     1050                         input temp-bik.o_name
     1051                       ,output v-full-path
     1052                       ,output v-path
     1053                       ,output v-file-name
     1054                       ,output v-file-name-no-ext
     1055                       ,output v-file-name-ext
     1056                       ) no-error .
     1057         if error-status:error then do:
     1058           run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Отсутствует файл &1 для импорта&2банк с БИК &3 фирма &4"                           ,temp-bik.o_name                                                                           ,chr(10)                                                                             ,temp-bik.bik                                                                              ,temp-bik.host-code)).
     1059           delete temp-bik.
     1060           assign
     1061           v-view-log = yes.
     1062           next _temp-bik.
     1063         end.
     1064         CASE p-format:
     1065           when '1s':U then do:
     1066             find first temp_hfields no-lock no-error.
     1067             if not available temp_hfields then do:
     1068               run create-temp-hfields in this-procedure ('imp').
     1069             end.
     1070             run bge/cbnki-1s.p (
     1071                              input parparentproc
     1072                             ,input p-log-handle
     1073                             ,input temp-bik.o_name
     1074                             ,input temp-bik.host-code
     1075                             ,input temp-bik.bik
     1076                             ,input temp-bik.code-bank
     1077                             ,input temp-bik.adresat
     1078                             ,input p-create
     1079                             ,input p-no-th-create
     1080                             ,input p-encoding
     1081                             ,input p-rs-hsch
     1082                             ,input-output v-view-log
     1083                             ,output v-count
     1084                             ,output v-processed
     1085                             ,output v-created
     1086                             ,output v-count-statement
     1087                             ,output v-processed-statement
     1088                             ,output v-created-statement
     1089                             ) no-error .
     1090           end.
     1091         END CASE.
     1092         if error-status:error then do:
     1093             run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Ошибка при импорта данных по финдокументам:&1БИК &2 фирма &3&1&4 &5"                           , chr(10)                                                                                   , temp-bik.bik                                                                                    , temp-bik.host-code                                                                              , error-status:get-message(1)                                                                     , return-value )).
     1094           assign
     1095           v-view-log = yes.
     1096         end.
     1097         else do:
     1098         run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("БИК &1 Фирма &2&4 - файл импорта &3:&4" +                                                        "в файле &8 документов&4" +                                                                         "обработано документов: &5&4" +                                                                   "в т.ч. создано в статусе &6 - &7&4"                                                         ,temp-bik.bik                                                                                     ,temp-bik.host-code                                                                               ,temp-bik.o_name                                                                                  ,chr(10)                                                                                    ,v-processed                                                                                      ,'новый':U                                                                                     ,v-created                                                                                        ,v-count  )  +                                                                                substitute("в файле &5 выписок&1" +                                                                         "обработано выписок: &2&1" +                                                                   "в т.ч. создано в статусе &3 - &4&1"                                                         ,chr(10)                                                                                    ,v-processed-statement                                                                            ,'новый':U                                                                                     ,v-created-statement                                                                              ,v-count-statement )).
     1099         end.
     1100         os-append value( temp-bik.o_name ) value( temp-bik.f_name) .
     1101         if os-error = 0 then
     1102         os-delete value( temp-bik.o_name ) .
     1103       end.
     1104     end.
     1105   end procedure.
     1106   procedure get-inis-from-bik-host :
     1107   define input parameter p-host-code like ub.sysconf.host-code no-undo .
     1108   define input parameter p-bik       like ub.fin-bank.bik no-undo .
     1109   define input parameter p-code-bank like ub.fin-bank.code-bank no-undo .
     1110   define variable loc-in_ as character no-undo .
     1111   define variable loc-spl as character no-undo .
     1112   define variable loc-sav as character no-undo .
     1113   define variable loc-out as character no-undo .
     1114   define variable loc-adresat as character no-undo .
     1115   DEFINE VARIABLE v-today as date no-undo .
     1116   DEFINE VARIABLE v-time as integer no-undo .
     1117   define variable ii as integer no-undo .
     1118   define variable v-doc-type-1s as character no-undo .
     1119   define buffer buf_fin-bank for ub.fin-bank.
     1120   define buffer buf_fin-schet for ub.fin-schet.
     1121   define buffer buf_temp_hfin-schet for temp_hfin-schet.
     1122     do
     1123     on error undo, return error
     1124     :
     1125       create temp-bik.
     1126       assign
     1127       temp-bik.host-code = p-host-code
     1128       temp-bik.code-bank = p-code-bank
     1129       temp-bik.bik       = p-bik
     1130       .
     1131       run bge/cbnkinis.p (
     1132                            input parparentproc
     1133                          , input p-format
     1134                          , input p-bik
     1135                          , input p-host-code
     1136                          , input "get":U
     1137                          , output loc-out
     1138                          , output LOC-in_
     1139                          , output LOC-spl
     1140                          , output LOC-sav
     1141                          , output loc-adresat
     1142                          )  no-error .
     1143       if error-status:error then do:
     1144         run write-log-and-file in p-log-handle (
     1145               input 1
     1146             , input log-file-name
     1147             , input 1
     1148             , input substitute("!!!Не удалось получить настройки для системы КЛИЕНТ-БАНК формата &1 для БИК &2 фирма &3 из ini-файла:&4&5 &6"
     1149                                 , p-format
     1150                                 , p-bik
     1151                                 , p-host-code
     1152                                 , chr(10)
     1153                                 , error-status:get-message(1)
     1154                                 , return-value)).
     1155         assign
     1156         v-view-log = yes.
     1157         return error.
     1158       end.
     1159       run cur-time in this-procedure(output v-today, output v-time).
     1160       assign
     1161       temp-bik.f_name = substitute("&1&2\&3_&4_&5.spl"
     1162                                  ,loc-in_
     1163                                  ,loc-sav
     1164                                  ,string(day(v-today), "99")
     1165                                  ,string(month(v-today), "99")
     1166                                  ,string(year(v-today) modulo 100, "99")
     1167                                  )
     1168       temp-bik.o_name = substitute("&1&2\&3", loc-in_, loc-spl , 'KL_to_1C.txt')
     1169       temp-bik.adresat = loc-adresat
     1170       .
     1171     end.
     1172   end procedure.
