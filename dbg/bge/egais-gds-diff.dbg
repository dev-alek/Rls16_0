        1   define temp-table tt-gds-diff no-undo
        2       field label_ as character
        3       field TH-value as character     format "X(100)"
        4       field EGAIS-value as character  format "X(100)"
        5       index pi as primary
        6           label_
        7   .
        8   define input parameter p-rowid as rowid .
        9   define input parameter bh-gds as handle.
       10   define input parameter bh-gds-egais as handle.
       11   define new global shared variable g#language as character no-undo .
       12   if g#language <> '' and g#language <> 'rus':U then do:
       13     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       14   end.
       15   DEFINE BUTTON b-ok AUTO-GO
       16        LABEL "OK"
       17        SIZE 15 BY 1.14
       18        BGCOLOR 8 .
       19   DEFINE QUERY br-gds-diff FOR
       20         tt-gds-diff SCROLLING.
       21   DEFINE BROWSE br-gds-diff
       22     QUERY br-gds-diff DISPLAY
       23       tt-gds-diff.label_ COLUMN-LABEL "Название поля" FORMAT "X(22)":U
       24       tt-gds-diff.TH-value COLUMN-LABEL "Значение в TH" FORMAT "X(100)":U width 39
       25       tt-gds-diff.EGAIS-value COLUMN-LABEL "Значение ЕГАИС" FORMAT "X(100)":U width 40
       26       WITH NO-ROW-MARKERS SEPARATORS SIZE 107 BY 11.19 ROW-HEIGHT-CHARS .57 FIT-LAST-COLUMN.
       27   DEFINE FRAME Dialog-Frame
       28        b-ok AT ROW 1.24 COL 2
       29        br-gds-diff AT ROW 2.67 COL 2 WIDGET-ID 200
       30        SPACE(0.39) SKIP(0.04)
       31       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
       32            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
       33            TITLE "Различия по строке"
       34            DEFAULT-BUTTON b-ok WIDGET-ID 100.
       35   ASSIGN
       36          FRAME Dialog-Frame:SCROLLABLE       = FALSE
       37          FRAME Dialog-Frame:HIDDEN           = TRUE.
       38   ON WINDOW-CLOSE OF FRAME Dialog-Frame
       39   DO:
       40     APPLY "END-ERROR":U TO SELF.
       41   END.
       42   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
       43   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
       44   MAIN-BLOCK:
       45   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
       46      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
       47   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
       48   define variable v-diasize-need-maximize        as logical   no-undo init true  .
       49   define variable v-diasize-orig-frame-height    as decimal   no-undo .
       50   define variable v-diasize-orig-frame-width     as decimal   no-undo .
       51   define variable v-diasize-current-frame-width  as decimal   no-undo .
       52   define variable v-diasize-current-frame-height as decimal   no-undo .
       53   define variable v-diasize-change-size          as logical   no-undo .
       54   define variable v-diasize-resize-button        as handle    no-undo .
       55   define variable v-diasize-wndmax               as logical   no-undo .
       56   define variable v-diasize-wndstore             as logical   no-undo .
       57   define variable v-diasize-proc-name            as character no-undo .
       58   define variable v-diasize-browse-handle        as handle    no-undo .
       59   define variable v-diasize-browse-number        as integer   no-undo .
       60   define variable v-diasize-need-full-display    as logical   no-undo init false .
       61   define temp-table temp-diasize-handle no-undo
       62     field handle-value  as handle
       63     field save-position as decimal
       64     index xpk is primary unique handle-value
       65     .
       66   define temp-table temp-browse-handle no-undo
       67     field browse-type   as character
       68     field browse-number as integer
       69     field browse-handle as handle
       70     field original-size as decimal
       71     index xpk is primary unique browse-type browse-number
       72     index xie browse-type browse-handle
       73   .
       74   procedure diasize_change-height :
       75     define input  parameter p-change-value  as decimal   no-undo .
       76     define input  parameter p-move-resize   as logical   no-undo .
       77     define variable v-field-group-handle    as handle    no-undo .
       78     define variable v-object-handle         as handle    no-undo .
       79     define variable v-frame-height          as decimal   no-undo .
       80     define variable v-frame-virtual-height  as decimal   no-undo .
       81     define variable v-browse-height         as decimal   no-undo .
       82     define variable v-window-height         as decimal   no-undo .
       83     define variable v-window-virtual-height as decimal   no-undo .
       84     define variable v-change-sign           as integer   no-undo .
       85     define buffer buf_temp-diasize-handle for temp-diasize-handle .
       86     define buffer buf_temp-browse-handle  for temp-browse-handle .
       87     if p-change-value > 0
       88     then do:
       89       if frame Dialog-Frame :height + p-change-value
       90           > decimal(session :work-area-height-pixels) / session :pixels-per-row
       91       then do:
       92         assign
       93           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
       94                           - (frame Dialog-Frame :height-chars)
       95         .
       96         if p-change-value <= 0
       97         then do:
       98           run diasize_position-resize-button in this-procedure .
       99           return .
      100         end.
      101       end.
      102     end.
      103     if p-change-value < 0
      104     then do:
      105       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      106       then do:
      107         assign
      108           p-change-value = v-diasize-orig-frame-height
      109                          - (frame Dialog-Frame :height-chars)
      110         .
      111         if p-change-value >= 0
      112         then do:
      113           run diasize_position-resize-button in this-procedure .
      114           return .
      115         end.
      116       end.
      117     end.
      118     if p-change-value >= 0
      119     then do:
      120       assign
      121         v-change-sign = 1
      122       .
      123     end.
      124     else do:
      125       assign
      126         v-change-sign = -1
      127       .
      128     end.
      129     assign
      130       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      131     .
      132     if p-change-value = 0
      133     then do:
      134       run diasize_position-resize-button in this-procedure .
      135       return .
      136     end.
      137     move_block:
      138     do
      139     on error undo move_block, retry move_block
      140     :
      141       if retry
      142       then do:
      143         do
      144         on error undo move_block, leave move_block
      145         :
      146           if p-change-value > 0
      147           then do:
      148             for each buf_temp-diasize-handle
      149             on error undo, next
      150             :
      151               assign
      152                 v-object-handle = buf_temp-diasize-handle.handle-value
      153               .
      154               if v-object-handle <> v-diasize-resize-button
      155               then do:
      156                 assign
      157                   v-object-handle :row = buf_temp-diasize-handle.save-position
      158                 .
      159               end.
      160             end.
      161             assign
      162               v-diasize-browse-handle :height = v-browse-height
      163             .
      164             for each buf_temp-browse-handle
      165               where buf_temp-browse-handle.browse-type = 'height':u
      166             on error undo, next
      167             :
      168               assign
      169                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      170               .
      171             end.
      172             assign
      173               frame Dialog-Frame :height = v-frame-height
      174             .
      175             if frame Dialog-Frame :scrollable = true
      176             then do:
      177               assign
      178                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      179               .
      180             end.
      181             run diasize_position-resize-button in this-procedure .
      182           end.
      183           else do:
      184             if frame Dialog-Frame :scrollable = true
      185             then do:
      186               assign
      187                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      188               .
      189             end.
      190             assign
      191               frame Dialog-Frame :height = v-frame-height
      192             .
      193             assign
      194               v-diasize-browse-handle :height = v-browse-height
      195             .
      196             for each buf_temp-browse-handle
      197               where buf_temp-browse-handle.browse-type = 'height':u
      198             on error undo, next
      199             :
      200               assign
      201                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      202               .
      203             end.
      204             for each buf_temp-diasize-handle
      205             on error undo, next
      206             :
      207               assign
      208                 v-object-handle = buf_temp-diasize-handle.handle-value
      209               .
      210               if v-object-handle <> v-diasize-resize-button
      211               then do:
      212                 assign
      213                   v-object-handle :row = buf_temp-diasize-handle.save-position
      214                 .
      215               end.
      216             end.
      217             run diasize_position-resize-button in this-procedure .
      218           end.
      219           assign
      220             v-diasize-change-size = false
      221           .
      222           leave move_block .
      223         end.
      224       end.
      225       assign
      226         v-diasize-need-full-display = true
      227       .
      228       if v-diasize-change-size = false
      229       then do:
      230         assign
      231           v-diasize-change-size = true
      232         .
      233       end.
      234       else do:
      235         return .
      236       end.
      237       assign
      238         v-frame-height = frame Dialog-Frame :height
      239         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      240         v-browse-height = v-diasize-browse-handle :height
      241       .
      242       for each buf_temp-browse-handle
      243         where buf_temp-browse-handle.browse-type = 'height':u
      244       :
      245         assign
      246           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      247         .
      248       end.
      249       for each buf_temp-diasize-handle
      250       :
      251         delete buf_temp-diasize-handle .
      252       end.
      253       assign
      254         v-field-group-handle = frame Dialog-Frame :first-child
      255       .
      256       do while valid-handle(v-field-group-handle)
      257       :
      258         assign
      259           v-object-handle = v-field-group-handle :first-child
      260         .
      261         do while valid-handle(v-object-handle)
      262         :
      263           if  v-object-handle <> v-diasize-browse-handle :handle
      264           and can-query(v-object-handle, "row")
      265           and can-query(v-object-handle, "height")
      266           and ( v-object-handle :row > v-diasize-browse-handle :row )
      267           then do:
      268             find first buf_temp-browse-handle
      269               where buf_temp-browse-handle.browse-type   = 'height':u
      270                 and buf_temp-browse-handle.browse-handle = v-object-handle
      271               no-error .
      272             if available buf_temp-browse-handle
      273             then do:
      274             end.
      275             else do:
      276               create buf_temp-diasize-handle .
      277               assign
      278                 buf_temp-diasize-handle.handle-value  = v-object-handle
      279                 buf_temp-diasize-handle.save-position = v-object-handle :row
      280               .
      281             end.
      282           end.
      283           assign
      284             v-object-handle = v-object-handle :next-sibling
      285           .
      286         end.
      287         assign
      288           v-field-group-handle = v-field-group-handle :next-sibling
      289         .
      290       end.
      291       do with frame Dialog-Frame
      292       :
      293         hide v-diasize-resize-button .
      294         assign
      295           v-diasize-resize-button :row    = 1
      296           v-diasize-resize-button :column = 1
      297         .
      298       end.
      299       if p-change-value > 0
      300       then do:
      301         if frame Dialog-Frame :scrollable = true
      302         then do:
      303           assign
      304             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      305             no-error .
      306           if error-status :error
      307           or error-status :get-message(1) <> ""
      308           then do:
      309             undo move_block, retry move_block .
      310           end.
      311         end.
      312         assign
      313           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      314           no-error .
      315         if error-status :error
      316         or error-status :get-message(1) <> ""
      317         then do:
      318           undo move_block, retry move_block .
      319         end.
      320         assign
      321           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      322           no-error .
      323         if error-status :error
      324         or error-status :get-message(1) <> ""
      325         then do:
      326           undo move_block, retry move_block .
      327         end.
      328         for each buf_temp-browse-handle
      329           where buf_temp-browse-handle.browse-type = 'height':u
      330         on error undo move_block, retry move_block
      331         :
      332           assign
      333             buf_temp-browse-handle.browse-handle :height
      334               = buf_temp-browse-handle.browse-handle :height + p-change-value
      335             no-error .
      336           if error-status :error
      337           or error-status :get-message(1) <> ""
      338           then do:
      339             undo move_block, retry move_block .
      340           end.
      341         end.
      342         for each buf_temp-diasize-handle
      343         on error undo move_block, retry move_block
      344         :
      345           assign
      346             v-object-handle = buf_temp-diasize-handle.handle-value
      347           .
      348           if v-object-handle <> v-diasize-resize-button
      349           then do:
      350             assign
      351               v-object-handle :row = v-object-handle :row + p-change-value
      352               no-error .
      353             if error-status :error
      354             or error-status :get-message(1) <> ""
      355             then do:
      356               undo move_block, retry move_block .
      357             end.
      358           end.
      359         end.
      360       end.
      361       else do:
      362         for each buf_temp-diasize-handle
      363         on error undo move_block, retry move_block
      364         :
      365           assign
      366             v-object-handle = buf_temp-diasize-handle.handle-value
      367           .
      368           if v-object-handle <> v-diasize-resize-button
      369           then do:
      370             assign
      371               v-object-handle :row = v-object-handle :row + p-change-value
      372               no-error .
      373             if error-status :error
      374             or error-status :get-message(1) <> ""
      375             then do:
      376               undo move_block, retry move_block .
      377             end.
      378           end.
      379         end.
      380         assign
      381           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      382           no-error .
      383         if error-status :error
      384         or error-status :get-message(1) <> ""
      385         then do:
      386           undo move_block, retry move_block .
      387         end.
      388         for each buf_temp-browse-handle
      389           where buf_temp-browse-handle.browse-type = 'height':u
      390         on error undo move_block, retry move_block
      391         :
      392           assign
      393             buf_temp-browse-handle.browse-handle :height
      394               = buf_temp-browse-handle.browse-handle :height + p-change-value
      395             no-error .
      396           if error-status :error
      397           or error-status :get-message(1) <> ""
      398           then do:
      399             undo move_block, retry move_block .
      400           end.
      401         end.
      402         assign
      403           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      404           no-error .
      405         if error-status :error
      406         or error-status :get-message(1) <> ""
      407         then do:
      408           undo move_block, retry move_block .
      409         end.
      410         if frame Dialog-Frame :scrollable = true
      411         then do:
      412           assign
      413             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      414             no-error .
      415           if error-status :error
      416           or error-status :get-message(1) <> ""
      417           then do:
      418             undo move_block, retry move_block .
      419           end.
      420         end.
      421       end.
      422       if p-move-resize = true
      423       then do:
      424         run diasize_position-resize-button in this-procedure .
      425       end.
      426       if v-diasize-wndstore = true
      427       then do:
      428         if connected("ub") = true
      429         then do:
      430           define variable v-cntxt-db-num        as integer   no-undo .
      431           define variable v-cntxt-userid        as character no-undo .
      432           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      433                                             , OUTPUT v-cntxt-userid
      434                                             ) .
      435           run gbl/wndsizew.p
      436             (input  v-cntxt-db-num
      437             ,input  v-cntxt-userid
      438             ,input  v-diasize-proc-name
      439             ,input  'height':u
      440             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      441             ) .
      442         end.
      443       end.
      444     end.
      445     assign
      446       v-diasize-change-size = false
      447     .
      448   end procedure.
      449   procedure diasize_set-height :
      450     define input  parameter p-new-height  as decimal   no-undo .
      451     define input  parameter p-move-resize as logical   no-undo .
      452     do
      453     on error undo, return error return-value
      454     :
      455       run diasize_change-height in this-procedure
      456         (input  (p-new-height - frame Dialog-Frame :height)
      457         ,input  p-move-resize
      458         ) .
      459     end.
      460   end procedure.
      461   procedure diasize_change-width :
      462     define input  parameter p-change-value as decimal   no-undo .
      463     define input  parameter p-move-resize  as logical   no-undo .
      464     define variable v-field-group-handle   as handle    no-undo .
      465     define variable v-object-handle        as handle    no-undo .
      466     define variable v-frame-width          as decimal   no-undo .
      467     define variable v-frame-virtual-width  as decimal   no-undo .
      468     define variable v-browse-width         as decimal   no-undo .
      469     define variable v-window-width         as decimal   no-undo .
      470     define variable v-window-virtual-width as decimal   no-undo .
      471     define variable v-change-sign          as integer   no-undo .
      472     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      473     define buffer buf_temp-browse-handle  for temp-browse-handle .
      474     if p-change-value > 0
      475     then do:
      476       if frame Dialog-Frame :width + p-change-value >
      477           session :width-chars
      478       then do:
      479         assign
      480           p-change-value = session :width-chars - frame Dialog-Frame :width
      481         .
      482         if p-change-value <= 0
      483         then do:
      484           run diasize_position-resize-button in this-procedure .
      485           return .
      486         end.
      487       end.
      488     end.
      489     if p-change-value < 0
      490     then do:
      491       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      492       then do:
      493         assign
      494           p-change-value = v-diasize-orig-frame-width
      495                          - frame Dialog-Frame :width
      496         .
      497         if p-change-value >= 0
      498         then do:
      499           run diasize_position-resize-button in this-procedure .
      500           return .
      501         end.
      502       end.
      503     end.
      504     if p-change-value >= 0
      505     then do:
      506       assign
      507         v-change-sign = 1
      508       .
      509     end.
      510     else do:
      511       assign
      512         v-change-sign = -1
      513       .
      514     end.
      515     assign
      516       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      517     .
      518     if p-change-value = 0
      519     then do:
      520       run diasize_position-resize-button in this-procedure .
      521       return .
      522     end.
      523     move_block:
      524     do
      525     on error undo move_block, leave move_block
      526     :
      527       if retry
      528       then do:
      529         do
      530         on error undo move_block, leave move_block
      531         :
      532           if p-change-value > 0
      533           then do:
      534             for each buf_temp-diasize-handle
      535             on error undo, next
      536             :
      537               assign
      538                 v-object-handle = buf_temp-diasize-handle.handle-value
      539               .
      540               if v-object-handle <> v-diasize-resize-button
      541               then do:
      542                 assign
      543                   v-object-handle :col = buf_temp-diasize-handle.save-position
      544                 .
      545               end.
      546             end.
      547             assign
      548               v-diasize-browse-handle :width = v-browse-width
      549             .
      550             for each buf_temp-browse-handle
      551               where buf_temp-browse-handle.browse-type = 'width':u
      552             on error undo, next
      553             :
      554               assign
      555                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      556               .
      557             end.
      558             assign
      559               frame Dialog-Frame :width = v-frame-width
      560             .
      561             if frame Dialog-Frame :scrollable = true
      562             then do:
      563               assign
      564                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      565               .
      566             end.
      567             run diasize_position-resize-button in this-procedure .
      568           end.
      569           else do:
      570             if frame Dialog-Frame :scrollable = true
      571             then do:
      572               assign
      573                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      574               .
      575             end.
      576             assign
      577               frame Dialog-Frame :width = v-frame-width
      578             .
      579             for each buf_temp-browse-handle
      580               where buf_temp-browse-handle.browse-type = 'width':u
      581             on error undo, next
      582             :
      583               assign
      584                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      585               .
      586             end.
      587             assign
      588               v-diasize-browse-handle :width = v-browse-width
      589             .
      590             for each buf_temp-diasize-handle
      591             on error undo, next
      592             :
      593               assign
      594                 v-object-handle = buf_temp-diasize-handle.handle-value
      595               .
      596               if v-object-handle <> v-diasize-resize-button
      597               then do:
      598                 assign
      599                   v-object-handle :col = buf_temp-diasize-handle.save-position
      600                 .
      601               end.
      602             end.
      603             run diasize_position-resize-button in this-procedure .
      604           end.
      605           assign
      606             v-diasize-change-size = false
      607           .
      608           leave move_block .
      609         end.
      610       end.
      611       assign
      612         v-diasize-need-full-display = true
      613       .
      614       if v-diasize-change-size = false
      615       then do:
      616         assign
      617           v-diasize-change-size = true
      618         .
      619       end.
      620       else do:
      621         return .
      622       end.
      623       assign
      624         v-frame-width = frame Dialog-Frame :width
      625         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      626         v-browse-width = v-diasize-browse-handle :width
      627       .
      628       for each buf_temp-browse-handle
      629         where buf_temp-browse-handle.browse-type = 'width':u
      630       :
      631         assign
      632           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      633         .
      634       end.
      635       for each buf_temp-diasize-handle
      636       :
      637         delete buf_temp-diasize-handle .
      638       end.
      639       assign
      640         v-field-group-handle = frame Dialog-Frame :first-child
      641       .
      642       do while valid-handle(v-field-group-handle)
      643       :
      644         assign
      645           v-object-handle = v-field-group-handle :first-child
      646         .
      647         do while valid-handle(v-object-handle)
      648         :
      649           if  v-object-handle <> v-diasize-browse-handle :handle
      650           and v-object-handle <> v-diasize-resize-button
      651           and can-query(v-object-handle, "row")
      652           and can-query(v-object-handle, "height")
      653           and ( v-object-handle :col + v-object-handle :width
      654                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      655               )
      656           then do:
      657             find first buf_temp-browse-handle
      658               where buf_temp-browse-handle.browse-type   = 'width':u
      659                 and buf_temp-browse-handle.browse-handle = v-object-handle
      660               no-error .
      661             if available buf_temp-browse-handle
      662             then do:
      663             end.
      664             else do:
      665               create buf_temp-diasize-handle .
      666               assign
      667                 buf_temp-diasize-handle.handle-value  = v-object-handle
      668                 buf_temp-diasize-handle.save-position = v-object-handle :col
      669               .
      670             end.
      671           end.
      672           assign
      673             v-object-handle = v-object-handle :next-sibling
      674           .
      675         end.
      676         assign
      677           v-field-group-handle = v-field-group-handle :next-sibling
      678         .
      679       end.
      680       do with frame Dialog-Frame
      681       :
      682         hide v-diasize-resize-button .
      683         v-diasize-resize-button :row = 1.
      684         v-diasize-resize-button :column = 1.
      685       end.
      686       if p-change-value > 0
      687       then do:
      688         if frame Dialog-Frame :scrollable = true
      689         then do:
      690           assign
      691             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      692             no-error .
      693           if error-status :error
      694           or error-status :get-message(1) <> ""
      695           then do:
      696             undo move_block, retry move_block.
      697           end.
      698         end.
      699         assign
      700           frame Dialog-Frame :width = v-frame-width + p-change-value
      701           no-error .
      702         if error-status :error
      703         or error-status :get-message(1) <> ""
      704         then do:
      705           undo move_block, retry move_block.
      706         end.
      707         assign
      708           v-diasize-browse-handle :width = v-browse-width + p-change-value
      709         no-error .
      710         if error-status :error
      711         or error-status :get-message(1) <> ""
      712         then do:
      713           undo move_block, retry move_block.
      714         end.
      715         for each buf_temp-browse-handle
      716           where buf_temp-browse-handle.browse-type = 'width':u
      717         on error undo move_block, retry move_block
      718         :
      719           assign
      720             buf_temp-browse-handle.browse-handle :width
      721               = buf_temp-browse-handle.browse-handle :width + p-change-value
      722             no-error .
      723           if error-status :error
      724           or error-status :get-message(1) <> ""
      725           then do:
      726             undo move_block, retry move_block .
      727           end.
      728         end.
      729         for each buf_temp-diasize-handle
      730         on error undo move_block, retry move_block
      731         :
      732           assign
      733             v-object-handle = buf_temp-diasize-handle.handle-value
      734           .
      735           if v-object-handle <> v-diasize-resize-button
      736           then do:
      737             assign
      738               v-object-handle :col = v-object-handle :col + p-change-value
      739               no-error .
      740             if error-status :error
      741             or error-status :get-message(1) <> ""
      742             then do:
      743               undo move_block, retry move_block .
      744             end.
      745           end.
      746         end.
      747       end.
      748       else do:
      749         for each buf_temp-diasize-handle
      750         on error undo move_block, retry move_block
      751         :
      752           assign
      753             v-object-handle = buf_temp-diasize-handle.handle-value
      754           .
      755           if v-object-handle <> v-diasize-resize-button
      756           then do:
      757             assign
      758               v-object-handle :col = v-object-handle :col + p-change-value
      759               no-error .
      760             if error-status :error
      761             or error-status :get-message(1) <> ""
      762             then do:
      763               undo move_block, retry move_block .
      764             end.
      765           end.
      766         end.
      767         for each buf_temp-browse-handle
      768           where buf_temp-browse-handle.browse-type = 'width':u
      769         on error undo move_block, retry move_block
      770         :
      771           assign
      772             buf_temp-browse-handle.browse-handle :width
      773               = buf_temp-browse-handle.browse-handle :width + p-change-value
      774             no-error .
      775           if error-status :error
      776           or error-status :get-message(1) <> ""
      777           then do:
      778             undo move_block, retry move_block .
      779           end.
      780         end.
      781         assign
      782           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
      783           no-error .
      784         if error-status :error
      785         or error-status :get-message(1) <> ""
      786         then do:
      787           undo move_block, retry move_block.
      788         end.
      789         assign
      790           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
      791         no-error .
      792         if error-status :error
      793         or error-status :get-message(1) <> ""
      794         then do:
      795           undo move_block, retry move_block.
      796         end.
      797         if frame Dialog-Frame :scrollable = true
      798         then do:
      799           assign
      800             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      801           no-error .
      802           if error-status :error
      803           or error-status :get-message(1) <> ""
      804           then do:
      805             undo move_block, retry move_block.
      806           end.
      807         end.
      808       end.
      809       if p-move-resize
      810       then do:
      811         run diasize_position-resize-button in this-procedure .
      812       end.
      813       if v-diasize-wndstore = true
      814       then do:
      815         if connected("ub") = true
      816         then do:
      817           define variable v-cntxt-db-num        as integer   no-undo .
      818           define variable v-cntxt-userid        as character no-undo .
      819           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      820                                             , OUTPUT v-cntxt-userid
      821                                             ) .
      822           run gbl/wndsizew.p
      823             (input  v-cntxt-db-num
      824             ,input  v-cntxt-userid
      825             ,input  v-diasize-proc-name
      826             ,input  'width':u
      827             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
      828             ) .
      829         end.
      830       end.
      831     end.
      832     assign
      833       v-diasize-change-size = false
      834     .
      835   end procedure.
      836   procedure diasize_set-width :
      837     define input  parameter p-new-width  as decimal   no-undo .
      838     define input  parameter p-move-resize as logical   no-undo .
      839     do
      840     on error undo, return error return-value
      841     :
      842       run diasize_change-width in this-procedure
      843         (input  (p-new-width - frame Dialog-Frame :width)
      844         ,input  p-move-resize
      845         ) .
      846     end.
      847   end procedure.
      848   procedure diasize_position-resize-button :
      849     do with frame Dialog-Frame
      850     :
      851       hide v-diasize-resize-button .
      852       assign
      853         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
      854                     - 1
      855                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
      856         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
      857                     - 1
      858                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
      859       .
      860       view v-diasize-resize-button .
      861     end.
      862   end procedure.
      863   on alt-right anywhere
      864   do:
      865     run diasize_change-width in this-procedure
      866       (input 1
      867       ,input true
      868       ) .
      869     return no-apply .
      870   end.
      871   on alt-left anywhere
      872   do:
      873     run diasize_change-width in this-procedure
      874       (input -1
      875       ,input true
      876       ) .
      877     return no-apply .
      878   end.
      879   on alt-down anywhere
      880   do:
      881     run diasize_change-height in this-procedure
      882       (input 1
      883       ,input true
      884       ) .
      885     return no-apply .
      886   end.
      887   on alt-up anywhere
      888   do:
      889     run diasize_change-height in this-procedure
      890       (input -1
      891       ,input true
      892       ) .
      893     return no-apply .
      894   end.
      895   on alt-enter of frame Dialog-Frame
      896   do:
      897     run diasize_maximize in this-procedure
      898       (input  ?
      899       ).
      900     return no-apply .
      901   end.
      902   procedure diasize_end-move :
      903     do
      904     on error undo, return error return-value
      905     :
      906       define variable v-row-delta as decimal   no-undo .
      907       define variable v-col-delta as decimal   no-undo .
      908       define variable v-new-row as decimal   no-undo .
      909       define variable v-new-col as decimal   no-undo .
      910       assign
      911         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
      912         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
      913       .
      914       assign
      915         v-row-delta = v-new-row - frame Dialog-Frame :height
      916         v-col-delta = v-new-col - frame Dialog-Frame :width
      917       .
      918       run diasize_change-height in this-procedure
      919         (input v-row-delta
      920         ,input true
      921         ) .
      922       run diasize_change-width in this-procedure
      923         (input v-col-delta
      924         ,input true
      925         ) .
      926     end.
      927   end procedure.
      928   procedure diasize_maximize :
      929     define input  parameter p-action as logical   no-undo .
      930     do
      931     on error undo, return error return-value
      932     :
      933       if p-action = ?
      934       then do:
      935         if v-diasize-need-maximize = true
      936         then do:
      937           assign
      938             p-action = true
      939           .
      940         end.
      941         else do:
      942           assign
      943             p-action = false
      944           .
      945         end.
      946       end.
      947       if p-action = true
      948       then do:
      949         run diasize_change-height in this-procedure
      950           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
      951               - frame Dialog-Frame :height-chars
      952           ,input true
      953           ) .
      954         run diasize_change-width in this-procedure
      955           (input session :width-chars
      956               - frame Dialog-Frame :width-chars
      957           ,input true
      958           ) .
      959         assign
      960           v-diasize-need-maximize = false
      961         .
      962       end.
      963       else do:
      964         run diasize_change-width in this-procedure
      965           (input v-diasize-orig-frame-width
      966               - frame Dialog-Frame :width-chars
      967           ,input true
      968           ) .
      969         run diasize_change-height in this-procedure
      970           (input v-diasize-orig-frame-height
      971               - frame Dialog-Frame :height-chars
      972           ,input true
      973           ) .
      974         assign
      975           v-diasize-need-maximize = true
      976         .
      977       end.
      978     end.
      979   end procedure.
      980   procedure diasize_restore-orig-size :
      981     do
      982     on error undo, return error return-value
      983     :
      984       assign
      985         v-diasize-current-frame-width  = frame Dialog-Frame :width
      986         v-diasize-current-frame-height = frame Dialog-Frame :height
      987       .
      988       run diasize_set-height in this-procedure
      989         (input  v-diasize-orig-frame-height
      990         ,input  true
      991         ) .
      992       run diasize_set-width in this-procedure
      993         (input  v-diasize-orig-frame-width
      994         ,input  true
      995         ) .
      996     end.
      997   end procedure.
      998   procedure diasize_restore-current-size :
      999     do
     1000     on error undo, return error return-value
     1001     :
     1002       run diasize_set-height in this-procedure
     1003         (input  v-diasize-current-frame-height
     1004         ,input  true
     1005         ) .
     1006       run diasize_set-width in this-procedure
     1007         (input  v-diasize-current-frame-width
     1008         ,input  true
     1009         ) .
     1010     end.
     1011   end procedure.
     1012   procedure diasize_set-browse-handle :
     1013     define input  parameter p-browse-handle as handle   no-undo .
     1014     define buffer buf_temp-browse-handle for temp-browse-handle .
     1015     do
     1016     on error undo, return error return-value
     1017     :
     1018       assign
     1019         v-diasize-browse-handle = p-browse-handle
     1020       .
     1021       for each buf_temp-browse-handle
     1022       on error undo, return error return-value
     1023       :
     1024         delete buf_temp-browse-handle .
     1025       end.
     1026     end.
     1027   end procedure.
     1028   procedure diasize_add_browse :
     1029     define input  parameter p-browse-type   as character no-undo .
     1030     define input  parameter p-browse-handle as handle    no-undo .
     1031     define buffer buf_temp-browse-handle for temp-browse-handle .
     1032     do
     1033     on error undo, return error return-value
     1034     :
     1035       assign
     1036         v-diasize-browse-number = v-diasize-browse-number + 1
     1037       .
     1038       create buf_temp-browse-handle .
     1039       assign
     1040         buf_temp-browse-handle.browse-type   = p-browse-type
     1041         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1042         buf_temp-browse-handle.browse-handle = p-browse-handle
     1043       .
     1044     end.
     1045   end procedure.
     1046   procedure diasize_init :
     1047     define variable v-default-value    as logical   no-undo .
     1048     define variable v-restore-saved    as logical   no-undo .
     1049     define variable v-resize-value-str as character no-undo .
     1050     do
     1051     on error undo, return error return-value
     1052     :
     1053       do with frame Dialog-Frame
     1054       :
     1055         assign
     1056           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1057           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1058           v-diasize-browse-handle     = browse br-gds-diff :handle
     1059         .
     1060         create button v-diasize-resize-button
     1061         assign
     1062           parent        = frame Dialog-Frame :first-child
     1063           label         = "s"
     1064           height-pixels = 16
     1065           width-pixels  = 16
     1066           visible       = true
     1067           sensitive     = true
     1068           movable       = true
     1069           triggers:
     1070             on end-move persistent run diasize_end-move in this-procedure .
     1071           end triggers.
     1072         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1073         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1074         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1075         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1076         assign
     1077           v-diasize-wndmax = false
     1078         .
     1079         if connected("ub") = true
     1080         then do:
     1081           define variable v-cntxt-db-num        as integer   no-undo .
     1082           define variable v-cntxt-userid        as character no-undo .
     1083           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1084                                             , OUTPUT v-cntxt-userid
     1085                                             ) .
     1086           run gbl/wndpar_r.p
     1087             (input  v-cntxt-db-num
     1088             ,input  v-cntxt-userid
     1089             ,input  'wndmax':U
     1090             ,output v-diasize-wndmax
     1091             ,output v-default-value
     1092             ) .
     1093         end.
     1094         assign
     1095           v-diasize-wndstore = false
     1096         .
     1097         if connected("ub") = true
     1098         then do:
     1099           run gbl/wndpar_r.p
     1100             (input  v-cntxt-db-num
     1101             ,input  v-cntxt-userid
     1102             ,input  'wndstore':U
     1103             ,output v-diasize-wndstore
     1104             ,output v-default-value
     1105             ) .
     1106         end.
     1107         assign
     1108           v-diasize-proc-name = entry(1, program-name(2), '.')
     1109         .
     1110         if v-diasize-wndstore = true
     1111         then do:
     1112           assign
     1113             v-restore-saved = false
     1114           .
     1115           if connected("ub") = true
     1116           then do:
     1117             run gbl/wndsizer.p
     1118               (input  v-cntxt-db-num
     1119               ,input  v-cntxt-userid
     1120               ,input  v-diasize-proc-name
     1121               ,input  'height':u
     1122               ,output v-resize-value-str
     1123               ) .
     1124             if v-resize-value-str <> '':U
     1125             then do:
     1126               run diasize_change-height in this-procedure
     1127                 (input  integer(v-resize-value-str)
     1128                 ,input  true
     1129                 ) .
     1130               assign
     1131                 v-restore-saved = true
     1132               .
     1133             end.
     1134           end.
     1135           if connected("ub") = true
     1136           then do:
     1137             run gbl/wndsizer.p
     1138               (input  v-cntxt-db-num
     1139               ,input  v-cntxt-userid
     1140               ,input  v-diasize-proc-name
     1141               ,input  'width':u
     1142               ,output v-resize-value-str
     1143               ) .
     1144             if v-resize-value-str <> '':U
     1145             then do:
     1146               run diasize_change-width in this-procedure
     1147                 (input  integer(v-resize-value-str)
     1148                 ,input  true
     1149                 ) .
     1150               assign
     1151                 v-restore-saved = true
     1152               .
     1153             end.
     1154           end.
     1155           if v-restore-saved <> true
     1156           then do:
     1157             if v-diasize-wndmax = true
     1158             then do:
     1159               run diasize_maximize in this-procedure
     1160                 (input  true
     1161                 ) .
     1162             end.
     1163           end.
     1164         end.
     1165         else do:
     1166           if v-diasize-wndmax = true
     1167           then do:
     1168             run diasize_maximize in this-procedure
     1169               (input  true
     1170               ) .
     1171           end.
     1172         end.
     1173       end.
     1174     end.
     1175   end procedure.
     1176   procedure diasize_need-full-display :
     1177     define output parameter p-need-full-display as logical   no-undo .
     1178     do
     1179     on error undo, return error return-value
     1180     :
     1181       assign
     1182         p-need-full-display = v-diasize-need-full-display
     1183       .
     1184       assign
     1185         v-diasize-need-full-display = false
     1186       .
     1187     end.
     1188   end procedure.
     1189   procedure get-context :
     1190      define output parameter p-db-num as integer          no-undo.
     1191      define output parameter p-user-id as character        no-undo.
     1192      define variable v-login               as character    no-undo.
     1193      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1194      define buffer buf_user-login  for ub.user-login .
     1195      do
     1196      on error undo, return error
     1197      :
     1198            FIND FIRST buf_sys-ctrl no-lock.
     1199            ASSIGN
     1200               v-login = USERID("ub")
     1201               p-db-num = buf_sys-ctrl.db-num
     1202            .
     1203            FIND FIRST buf_user-login
     1204                 WHERE buf_user-login.db-num = p-db-num
     1205                   AND buf_user-login.user-login = v-login
     1206                 no-lock
     1207                 no-error
     1208                 .
     1209            IF AVAILABLE buf_user-login
     1210            THEN DO:
     1211               assign
     1212                  p-user-id = buf_user-login.user-id
     1213               .
     1214            END.
     1215      end.
     1216   end procedure.
     1217     run diasize_init in this-procedure .
     1218     run fill-tt.
     1219     RUN enable_UI.
     1220     WAIT-FOR GO OF FRAME Dialog-Frame.
     1221   END.
     1222   RUN disable_UI.
     1223   procedure fill-tt :
     1224       def var ii as integer no-undo .
     1225       bh-gds:find-by-rowid (p-rowid, no-lock) no-error.
     1226       if bh-gds:available then do :
     1227           if bh-gds:buffer-field ("alc-code"):buffer-value <> ? and bh-gds:buffer-field ("alc-code"):buffer-value <> "" then do :
     1228               bh-gds-egais:find-unique (substitute("where tt-gds-EG.alc-code = '&1'", bh-gds:buffer-field ("alc-code"):buffer-value), no-lock) no-error.
     1229           end.
     1230           else do :
     1231               bh-gds-egais:find-unique (substitute("where tt-gds-EG.gds-name = '&1'", bh-gds:buffer-field ("gds-name"):buffer-value), no-lock) no-error.
     1232           end.
     1233           if bh-gds-egais:available then do :
     1234               do ii = 2 to (bh-gds-egais:num-fields - 2) :
     1235                   if bh-gds:buffer-field (ii):buffer-value <> bh-gds-egais:buffer-field (ii):buffer-value then do :
     1236                       create tt-gds-diff .
     1237                       assign
     1238                           tt-gds-diff.label_ = bh-gds:buffer-field (ii):label
     1239                           tt-gds-diff.TH-value = string(bh-gds:buffer-field (ii):buffer-value)
     1240                           tt-gds-diff.EGAIS-value = string(bh-gds-egais:buffer-field (ii):buffer-value)
     1241                       .
     1242                   end.
     1243               end.
     1244           end.
     1245       end.
     1246   end procedure.
     1247   PROCEDURE disable_UI :
     1248     HIDE FRAME Dialog-Frame.
     1249   END PROCEDURE.
     1250   PROCEDURE enable_UI :
     1251     ENABLE b-ok br-gds-diff
     1252         WITH FRAME Dialog-Frame.
     1253     VIEW FRAME Dialog-Frame.
     1254     br-gds-diff:column-resizable in FRAME Dialog-Frame = true .
     1255     OPEN QUERY br-gds-diff FOR EACH tt-gds-diff.
     1256   END PROCEDURE.
