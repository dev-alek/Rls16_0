        1   define variable vss-revision    as character no-undo init "$Revision$":U .
        2   define variable vss-author      as character no-undo init "$Author$":U .
        3   define variable vss-date        as character no-undo init "$Date$":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        5   define variable vss-archive     as character no-undo init "$Archive$":U .
        6   define variable vss-description as character no-undo init "Отчет по версиям RC на УБД".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   define new global shared variable g#library  as handle no-undo .
       66   define new global shared variable g#library2 as handle no-undo .
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      113     define variable v-cntxt-db-num        as integer   no-undo .
      114     define variable v-cntxt-userid        as character no-undo .
      115     define variable v-cntxt-level         as character no-undo .
      116     define variable v-cntxt-host-code-obj as integer   no-undo .
      117     define variable v-cntxt-obj-type      as character no-undo .
      118     define variable v-cntxt-obj-code      as integer   no-undo .
      119     define variable v-cntxt-db-num-obj    as integer   no-undo .
      120     define variable v-cntxt-is-admin      as logical   no-undo .
      121   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      122   define temp-table temp-schedule-free no-undo
      123   field free-id as character
      124   field free-task-name as character
      125   field proc-run-name as character
      126   field proc-param-edit-name as character
      127   field conf-param as character
      128   field is-gbd as logical
      129   field is-ubd as logical
      130   field enable-concurrent-0 as logical
      131   field enable-concurrent-db as logical
      132   field other-info as character
      133   field enc-key as character
      134   field is-rum as logical
      135   index pi is unique primary
      136   free-id.
      137   procedure schedule-attr-name :
      138   do
      139     on error undo, return error
      140     :
      141     define input  parameter p-code           as character no-undo .
      142     define output parameter p-type           as character no-undo .
      143     define output parameter p-format         as character no-undo .
      144     define output parameter p-label          as character no-undo .
      145     define output parameter p-user-can-edit  as logical   no-undo .
      146     define output parameter p-output-display as logical   no-undo .
      147     define output parameter p-other          as character no-undo .
      148       if index(p-code, chr(4)) > 0 then do:
      149         p-code = entry(1, p-code, chr(4)).
      150       end.
      151       case p-code :
      152               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      153               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      154               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      155               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      156               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      157               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      158               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      159               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      160               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      161         otherwise do:
      162           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      163         end.
      164       end.
      165     end.
      166   end procedure.
      167   procedure schedule-attr-tooltip :
      168   do
      169     on error undo, return error
      170     :
      171       define input  parameter p-code    as character no-undo .
      172       define output parameter p-tooltip as character no-undo .
      173       define output parameter p-label   as character no-undo .
      174       if index(p-code, chr(4)) > 0 then do:
      175         p-code = entry(1, p-code, chr(4)).
      176       end.
      177       case p-code :
      178               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      179               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      180               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      181               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      182               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      183               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      184               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      185               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      186               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      187         otherwise do:
      188               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      189         end.
      190       end.
      191     end.
      192   end procedure.
      193   procedure schedule-attr-value :
      194   do
      195   on error undo, return error return-value
      196   :
      197   define input parameter  p-cre-db-num as integer    no-undo.
      198   define input parameter  p-task-type  as character  no-undo.
      199   define input parameter  p-task-num   as integer    no-undo.
      200   define input parameter  p-code       as character  no-undo.
      201   define output parameter p-value      as character  no-undo.
      202   define output parameter p-type       as character  no-undo.
      203       define variable v-format         as character no-undo .
      204       define variable v-label          as character no-undo .
      205       define variable v-user-can-edit  as logical   no-undo .
      206       define variable v-output-display as logical   no-undo .
      207       define variable v-other          as character no-undo .
      208       define buffer buf_schedule-attr for ub.schedule-attr.
      209       run schedule-attr-name in this-procedure (
      210             input  p-code
      211           , output p-type
      212           , output v-format
      213           , output v-label
      214           , output v-user-can-edit
      215           , output v-output-display
      216           , output v-other
      217       ) no-error .
      218       if error-status :error
      219       then do:
      220           undo, return error return-value .
      221       end.
      222       if p-code begins ('schd-free-id':U + chr(4))
      223       and entry(2, p-code, chr(4)) = '':U then do:
      224         find first buf_schedule-attr no-lock
      225             where buf_schedule-attr.cre-db-num = p-cre-db-num
      226               and buf_schedule-attr.task-type  = p-task-type
      227               and buf_schedule-attr.task-num   = p-task-num
      228               and buf_schedule-attr.attr-code  begins p-code
      229         no-error .
      230       end.
      231       else do:
      232         find first buf_schedule-attr no-lock
      233             where buf_schedule-attr.cre-db-num = p-cre-db-num
      234               and buf_schedule-attr.task-type  = p-task-type
      235               and buf_schedule-attr.task-num   = p-task-num
      236               and buf_schedule-attr.attr-code  = p-code
      237         no-error .
      238       end.
      239       if available buf_schedule-attr
      240       then do:
      241           assign
      242               p-value = buf_schedule-attr.attr-value
      243           .
      244       end.
      245       else do:
      246         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      247            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      248         end.
      249         else do:
      250           assign
      251               p-value = if p-type = 'L':U then "no":U else ""
      252           .
      253         end.
      254       end.
      255   end.
      256   end procedure.
      257   procedure schedule-attr-write :
      258   do
      259   on error undo, return error
      260   :
      261   define input parameter p-cre-db-num  as integer   no-undo.
      262   define input parameter p-task-type   as character no-undo.
      263   define input parameter p-task-num    as integer   no-undo.
      264   define input parameter p-code        as character no-undo.
      265   define input parameter p-value       as character no-undo.
      266       define variable v-type              as character                no-undo.
      267       define variable v-format            as character                no-undo.
      268       define variable v-label             as character                no-undo.
      269       define variable v-user-can-edit     as logical                  no-undo.
      270       define variable v-output-display    as logical                  no-undo.
      271       define variable v-other             as character                no-undo.
      272       define buffer buf_schedule-attr for ub.schedule-attr .
      273       run schedule-attr-name in this-procedure (
      274             input  p-code
      275           , output v-type
      276           , output v-format
      277           , output v-label
      278           , output v-user-can-edit
      279           , output v-output-display
      280           , output v-other
      281       ) no-error.
      282       if error-status :error
      283       then do:
      284           undo, return error return-value.
      285       end.
      286       find first buf_schedule-attr exclusive-lock
      287            where buf_schedule-attr.cre-db-num = p-cre-db-num
      288              and buf_schedule-attr.task-type  = p-task-type
      289              and buf_schedule-attr.task-num   = p-task-num
      290              and buf_schedule-attr.attr-code  = p-code
      291       no-error.
      292       if not available buf_schedule-attr
      293       then do:
      294           create buf_schedule-attr.
      295           assign
      296             buf_schedule-attr.cre-db-num = p-cre-db-num
      297             buf_schedule-attr.task-type  = p-task-type
      298             buf_schedule-attr.task-num   = p-task-num
      299             buf_schedule-attr.attr-code  = p-code
      300             buf_schedule-attr.attr-value = p-value
      301           .
      302       end.
      303       else do:
      304           assign
      305               buf_schedule-attr.attr-value = p-value
      306           .
      307       end.
      308   end.
      309   end procedure.
      310   procedure schedule-attr-delete :
      311   do
      312   on error undo, return error
      313   :
      314   define input  parameter p-cre-db-num  as integer   no-undo.
      315   define input  parameter p-task-type   as character no-undo.
      316   define input  parameter p-task-num    as integer   no-undo.
      317   define input  parameter p-code        as character no-undo.
      318   define output parameter p-deleted     as logical   no-undo.
      319       define buffer buf_schedule-attr for ub.schedule-attr .
      320       define variable v-type              as character                no-undo.
      321       define variable v-format            as character                no-undo.
      322       define variable v-label             as character                no-undo.
      323       define variable v-user-can-edit     as logical                  no-undo.
      324       define variable v-output-display    as logical                  no-undo.
      325       define variable v-other             as character                no-undo.
      326       run schedule-attr-name in this-procedure (
      327             input p-code
      328           , output v-type
      329           , output v-format
      330           , output v-label
      331           , output v-user-can-edit
      332           , output v-output-display
      333           , output v-other
      334       ) no-error .
      335       if error-status :error
      336       then do:
      337           undo, return error return-value .
      338       end.
      339       find first buf_schedule-attr exclusive-lock
      340            where buf_schedule-attr.cre-db-num = p-cre-db-num
      341              and buf_schedule-attr.task-type  = p-task-type
      342              and buf_schedule-attr.task-num   = p-task-num
      343              and buf_schedule-attr.attr-code  = p-code
      344       no-error.
      345       if not available buf_schedule-attr
      346       then do:
      347           assign
      348               p-deleted = no
      349           .
      350       end.
      351       else do:
      352           delete buf_schedule-attr.
      353           assign
      354               p-deleted = yes
      355           .
      356       end.
      357   end.
      358   end procedure.
      359   procedure schedule-attr-news :
      360   do
      361   on error undo, return error
      362   :
      363       define input  parameter p-code           as character no-undo .
      364       define output parameter p-news           as logical   no-undo .
      365       if index(p-code, chr(4)) > 0 then do:
      366         p-code = entry(1, p-code, chr(4)).
      367       end.
      368       case p-code :
      369               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      370               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      371               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      372               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      373               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      374               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      375               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      376               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      377               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      378         otherwise do:
      379           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      380         end.
      381       end.
      382   end.
      383   end procedure.
      384   procedure schedule-attr-extract-logical :
      385   do
      386   on error undo, return error
      387   :
      388   define input  parameter p-parameter-number   as integer      no-undo.
      389   define input  parameter p-parameter-list     as character    no-undo.
      390   define output parameter p-parameter-value   as logical      no-undo.
      391       if num-entries( p-parameter-list ) > p-parameter-number - 1
      392       then do:
      393           assign
      394               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      395           .
      396       end.
      397       else do:
      398           assign
      399               p-parameter-value   = no
      400           .
      401       end.
      402   end.
      403   end procedure.
      404   procedure schedule-attr-get-free-id :
      405   do
      406   on error undo, return error return-value
      407   :
      408     define input  parameter p-cre-db-num  as integer   no-undo.
      409     define input  parameter p-task-type   as character no-undo.
      410     define input  parameter p-task-num    as integer   no-undo.
      411     define output parameter p-free-id     as character no-undo.
      412     define buffer buf_schedule-attr for ub.schedule-attr.
      413     find first buf_schedule-attr no-lock
      414         where buf_schedule-attr.cre-db-num = p-cre-db-num
      415           and buf_schedule-attr.task-type  = p-task-type
      416           and buf_schedule-attr.task-num   = p-task-num
      417           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      418     no-error .
      419     if available buf_schedule-attr then
      420     assign
      421     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      422     no-error
      423     .
      424   end.
      425   end procedure.
      426   procedure schedule-attr-get-free-props :
      427     define input parameter p-free-id as character no-undo .
      428     define output parameter p-value as character no-undo .
      429     define buffer buf_temp-schedule-free for temp-schedule-free.
      430     do
      431     on error undo, return error return-value
      432     :
      433       find first buf_temp-schedule-free no-lock no-error .
      434       if not available buf_temp-schedule-free then do:
      435         run schedule-attr-fill-free-props in this-procedure .
      436       end.
      437       find first buf_temp-schedule-free where
      438               buf_temp-schedule-free.free-id = p-free-id no-error.
      439       if available buf_temp-schedule-free then do:
      440         assign
      441         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      442                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      443                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      444                   buf_temp-schedule-free.conf-param           + chr(4) +
      445                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      446                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      447                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      448                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      449                   buf_temp-schedule-free.other-info
      450         .
      451       end.
      452       else do:
      453        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      454                              "id произвольной задачи - &5"
      455                              ,vss-workfile
      456                              ,vss-revision
      457                              ,vss-description
      458                              ,chr(10)
      459                              ,p-free-id).
      460       end.
      461     end.
      462   end procedure.
      463   procedure schedule-attr-is-rum-free-id :
      464   define input parameter p-free-id as character no-undo .
      465   define output parameter p-is-rum as logical no-undo .
      466   define buffer buf_temp-schedule-free for temp-schedule-free.
      467   do
      468   on error undo, return error
      469   :
      470       find first buf_temp-schedule-free no-lock no-error .
      471       if not available buf_temp-schedule-free then do:
      472         run schedule-attr-fill-free-props in this-procedure .
      473       end.
      474       find first buf_temp-schedule-free where
      475               buf_temp-schedule-free.free-id = p-free-id no-error.
      476       if available buf_temp-schedule-free
      477       and buf_temp-schedule-free.is-rum
      478       then do:
      479         p-is-rum = yes.
      480       end.
      481   end.
      482   end procedure.
      483   procedure schedule-attr-fill-free-props :
      484   define variable v-path                    as character                no-undo .
      485   DEFINE VARIABLE v-full-path               as character                no-undo .
      486   DEFINE VARIABLE v-file-name               as character                no-undo .
      487   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      488   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      489   define buffer buf_temp-schedule-free for temp-schedule-free.
      490   define variable v-answer as logical no-undo .
      491     do
      492     on error undo, return error substitute("&1 &2 &3&4&5&4"
      493                                           ,vss-workfile
      494                                           ,vss-revision
      495                                           ,vss-description
      496                                           ,chr(10)
      497                                           ,error-status:get-message(1) )
      498     :
      499       run gbl/filename.p (
      500                       input 'cmp/shd-free.d'
      501                     ,output v-full-path
      502                     ,output v-path
      503                     ,output v-file-name
      504                     ,output v-file-name-no-ext
      505                     ,output v-file-name-ext
      506                     ) .
      507       input from value(v-full-path).
      508       repeat :
      509         create buf_temp-schedule-free.
      510         import buf_temp-schedule-free.
      511       END.
      512       input close.
      513       _ff:
      514       for each buf_temp-schedule-free :
      515         if buf_temp-schedule-free.free-id = '':U then do:
      516            delete buf_temp-schedule-free.
      517            next _ff.
      518          end.
      519          run schedule-attr-check-enc in this-procedure (
      520                                                       input  buf_temp-schedule-free.free-id
      521                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      522                                                               buf_temp-schedule-free.proc-param-edit-name +
      523                                                               buf_temp-schedule-free.conf-param +
      524                                                               string(buf_temp-schedule-free.is-gbd) +
      525                                                               string(buf_temp-schedule-free.is-ubd) +
      526                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      527                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      528                                                               string(buf_temp-schedule-free.other-info)
      529                                                               )
      530                                                       ,input  buf_temp-schedule-free.enc-key
      531                                                       ,output v-answer    ) no-error .
      532          if error-status:error
      533          or not v-answer then delete buf_temp-schedule-free.
      534        end.
      535     end.
      536   end procedure.
      537   Function schedule-attr-reverse returns character (str as character).
      538      define variable rev_incl_s as character init "" no-undo .
      539      define variable rev_incl_i as integer no-undo .
      540      define variable rev_incl_l as integer no-undo .
      541      rev_incl_l = length(str).
      542      do rev_incl_i = 1 to rev_incl_l:
      543         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      544      end.
      545      return rev_incl_s.
      546   end.
      547   procedure schedule-attr-check-enc.
      548     define input  parameter p-free-id   as character no-undo .
      549     define input  parameter p-value     as character no-undo .
      550     define input  parameter p-enc-value as character no-undo .
      551     define output parameter p-answer    as logical   no-undo .
      552     define variable tmp         as character no-undo .
      553     define variable v-enc-value as character no-undo .
      554     assign
      555     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      556     .
      557     run schedule-attr-pswd-enc in this-procedure
      558       ( input tmp
      559        ,output v-enc-value
      560       ) no-error .
      561     if error-status:error then do:
      562       message
      563         vss-workfile vss-revision vss-description skip
      564         "Ошибка при вызове процедуры pswd-enc" skip
      565         return-value skip
      566         error-status :get-message(1) skip
      567         view-as alert-box error .
      568       undo, return error .
      569     end.
      570     if v-enc-value = p-enc-value then do:
      571       assign
      572         p-answer = true
      573       .
      574     end.
      575     else do:
      576       assign
      577         p-answer = false
      578       .
      579     end.
      580   end.
      581   procedure schedule-attr-conf-enc.
      582     define input  parameter p-free-id   as character no-undo .
      583     define input  parameter p-value     as character no-undo .
      584     define output parameter p-enc-value as character no-undo .
      585     define variable tmp         as character no-undo .
      586     assign
      587       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      588     .
      589     run schedule-attr-pswd-enc in this-procedure
      590       ( input tmp
      591        ,output p-enc-value
      592       ) no-error .
      593     if error-status:error then do:
      594       message
      595         vss-workfile vss-revision vss-description skip
      596         "Ошибка при вызове процедуры pswd-enc" skip
      597         return-value skip
      598         error-status :get-message(1) skip
      599         view-as alert-box error .
      600       undo, return error .
      601     end.
      602   end procedure.
      603   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      604   procedure schedule-attr-pswd-enc :
      605     define input parameter  pswd     as character no-undo .
      606     define output parameter enc-pswd as character no-undo .
      607     do
      608     on error undo, return error return-value
      609     :
      610       assign
      611         enc-pswd = encode(pswd + string(index(pswd, "k")))
      612       .
      613     end.
      614   end procedure.
      615   define input parameter parparentproc as widget-handle no-undo .
      616   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo .
      617   define input parameter p-curr-obj-type  like ub.clients.obj-type no-undo .
      618   define input parameter p-curr-obj-code  like ub.clients.obj-code no-undo .
      619   define input PARAMETER p-mode           AS CHARACTER NO-UNDO.
      620   define input parameter p-db-num-char    as character    no-undo.
      621   define input parameter p-task-type      as character    no-undo.
      622   define input parameter p-task-num       as integer      no-undo.
      623   define input parameter p-action         as character    no-undo.
      624   define output parameter p-cancel        as logical      no-undo.
      625   define output parameter p-params        as character    no-undo.
      626   define variable v-text         as character no-undo .
      627   define variable v-text-oss     as character no-undo .
      628   define variable v-text-gds     as character no-undo .
      629   define variable v-today        as date      no-undo .
      630   define variable v-db-list     as character no-undo.
      631   define variable c-dir          as character no-undo.
      632   DEFINE BUTTON b-exit AUTO-GO
      633        LABEL "&Ввод"
      634        SIZE 10 BY 1
      635        BGCOLOR 8 .
      636   DEFINE BUTTON b-quit AUTO-END-KEY
      637        LABEL "&Отмена"
      638        SIZE 10 BY 1
      639        BGCOLOR 8 .
      640   DEFINE VARIABLE num-days AS INTEGER FORMAT ">>>9":U INITIAL 0
      641        LABEL "За последние"
      642        VIEW-AS FILL-IN
      643        SIZE 14 BY 1 NO-UNDO.
      644   DEFINE RECTANGLE RECT-3
      645        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      646        SIZE 43.5 BY 10.25.
      647   DEFINE VARIABLE sel-dbs AS CHARACTER
      648        VIEW-AS SELECTION-LIST MULTIPLE SCROLLBAR-VERTICAL
      649        SIZE 9.5 BY 8.63 NO-UNDO.
      650   DEFINE FRAME Dialog-Frame
      651        b-exit AT ROW 1 COL 2.63
      652        b-quit AT ROW 1 COL 12.63
      653        num-days AT ROW 2.5 COL 19.5 COLON-ALIGNED WIDGET-ID 22
      654        sel-dbs AT ROW 4.38 COL 22.5 NO-LABEL WIDGET-ID 50
      655        "дней" VIEW-AS TEXT
      656             SIZE 8 BY 1 AT ROW 2.5 COL 36 WIDGET-ID 32
      657        "БД для выбора:" VIEW-AS TEXT
      658             SIZE 16 BY 1 AT ROW 4.25 COL 3.5 WIDGET-ID 48
      659             FGCOLOR 4
      660        RECT-3 AT ROW 3.75 COL 2.5 WIDGET-ID 20
      661        SPACE(3.87) SKIP(1.20)
      662       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      663            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      664            TITLE "Параметры отчета по версиям RC"
      665            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit.
      666   ASSIGN
      667          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      668          FRAME Dialog-Frame:HIDDEN           = TRUE.
      669   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      670   DO:
      671       APPLY "END-ERROR":U TO SELF.
      672     END.
      673   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      674   DO:
      675       RUN proc-save IN THIS-PROCEDURE .
      676     END.
      677   ON VALUE-CHANGED OF sel-dbs IN FRAME Dialog-Frame
      678   DO:
      679     assign
      680     sel-dbs
      681     .
      682   END.
      683   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      684     THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      685   MAIN-BLOCK:
      686   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      687     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      688   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      689     run mainmenu_getcntxt in parparentproc
      690       (output v-cntxt-db-num
      691       ,output v-cntxt-userid
      692       ,output v-cntxt-level
      693       ,output v-cntxt-host-code-obj
      694       ,output v-cntxt-obj-type
      695       ,output v-cntxt-obj-code
      696       ,output v-cntxt-db-num-obj
      697       ,output v-cntxt-is-admin
      698       ) .
      699     run init-fields in this-procedure .
      700   if p-mode = 'shd':U then
      701   do:
      702     assign
      703       frame Dialog-Frame :title = frame Dialog-Frame :title +
      704                           substitute(". &1: БД &2, Задача номер &3"
      705                           , p-task-type
      706                           , p-db-num-char
      707                           , p-task-num )
      708       .
      709   end.
      710   run init-param-values in this-procedure ( input p-task-type
      711     , input p-db-num-char
      712     , input p-task-num
      713     ) .
      714   RUN enable_UI.
      715   WAIT-FOR GO OF FRAME Dialog-Frame.
      716   END.
      717   RUN disable_UI.
      718   PROCEDURE attach-attr-to-schedule-line :
      719     DEFINE INPUT PARAMETER p-param-list AS CHARACTER NO-UNDO.
      720     define buffer buf_schedule      for schedule.
      721     define buffer buf_schedule-attr for schedule-attr.
      722     define buffer lock-batchprocess for ub.batchprocess.
      723     CASE p-mode:
      724       when 'shd':U then
      725         do:
      726           run gbl/lock-prc.p
      727             (input 'schd':U
      728             ,input 'rep-RC':U
      729             ,input 0
      730             ,input 0
      731             ,input '':U
      732             ,input ""
      733             ,input ""
      734             ,input (
      735             "Отчет по версиям RC"
      736             )
      737             ,input yes
      738             ,buffer lock-batchprocess
      739             ) no-error .
      740           FIND FIRST buf_schedule-attr NO-LOCK WHERE
      741             buf_schedule-attr.task-type   = p-task-type
      742             and buf_schedule-attr.cre-db-num = INTEGER(p-db-num-char)
      743             and buf_schedule-attr.attr-code = ('schd-free-id':U + chr(4) + 'rep-RC') NO-ERROR.
      744           IF AVAILABLE  buf_schedule-attr
      745             AND buf_schedule-attr.task-num <> p-task-num
      746             AND buf_schedule-attr.task-num <> - 1
      747             and p-task-num <> - 1
      748             THEN
      749           DO:
      750             MESSAGE
      751               substitute("Уже есть расписание для отчета по версиям RC &1&2" +
      752               "номер расписания &3"
      753               ,buf_schedule-attr.cre-db-num
      754               ,chr(10)
      755               ,buf_schedule-attr.task-num)
      756               VIEW-AS ALERT-BOX ERROR.
      757             UNDO, RETURN ERROR.
      758           END.
      759           find first buf_schedule no-lock
      760             where buf_schedule.task-type   = p-task-type
      761             and buf_schedule.cre-db-num  = INTEGER(p-db-num-char)
      762             and buf_schedule.task-num    = p-task-num
      763             no-error.
      764           if not available buf_schedule
      765             and (  p-task-type   <> 'autofree':U
      766             or p-db-num-char <> p-db-num-char
      767             or p-task-num    <> -1 )
      768             then
      769           do:
      770             message
      771               vss-workfile vss-revision vss-description
      772               skip
      773               "Не найдена строка расписания."
      774               skip return-value
      775               skip trim(error-status :get-message(1))
      776               trim(error-status :get-message(2))
      777               trim(error-status :get-message(3))
      778               view-as alert-box error.
      779             undo, return error .
      780           end.
      781           run schedule-attr-write in this-procedure (
      782             input INTEGER(p-db-num-char)
      783             , input p-task-type
      784             , input p-task-num
      785             , input 'schedule-param-list':U
      786             , input p-param-list
      787             ).
      788         end.
      789       when 'run':U then
      790         do:
      791           p-params = p-param-list.
      792         end.
      793     END CASE.
      794   END PROCEDURE.
      795   PROCEDURE check-host-list :
      796     define input-output parameter pHost-code-list as character no-undo.
      797     define variable iCount        as integer   no-undo.
      798     define variable cTemp         as character no-undo.
      799     define variable iTempHostCode as integer   no-undo.
      800     define variable cNewHostList  as character no-undo.
      801     define variable lOk           as logical   no-undo.
      802     do iCount = 1 to num-entries( pHost-code-list ):
      803       cTemp = entry( iCount, pHost-code-list ).
      804       assign
      805         iTempHostCode = integer( cTemp ) no-error
      806         .
      807       run validate-host( iTempHostCode, no, no, output lOk ).
      808       if lOk and lookup( string( iTempHostCode ), cNewHostList ) = 0
      809         then
      810       do:
      811         assign
      812           cNewHostList = cNewHostList + ',' + string( iTempHostCode )
      813           .
      814       end.
      815     end.
      816     pHost-code-list = trim( cNewHostList, ',' ).
      817     return.
      818   END PROCEDURE.
      819   PROCEDURE convert :
      820     define input-output parameter v-rid-list as character no-undo.
      821     define variable v-list as character no-undo .
      822     define variable v-ind  as integer   no-undo .
      823     define buffer buf_sysconf for ub.sysconf.
      824     do
      825       on error undo, return error return-value
      826       :
      827       do v-ind = 1 to num-entries(v-rid-list)
      828         :
      829         find first buf_sysconf no-lock
      830           where recid(buf_sysconf) = integer(entry(v-ind, v-rid-list))
      831           no-error .
      832         if available buf_sysconf
      833           then
      834         do:
      835           assign
      836             v-list = v-list
      837                     + (if v-list = '':U
      838                       then '':U
      839                       else chr(44)
      840                       )
      841                     + string(buf_sysconf.host-code)
      842             .
      843         end.
      844       end.
      845       assign
      846         v-rid-list = v-list
      847         .
      848     end.
      849   END PROCEDURE.
      850   PROCEDURE disable_UI :
      851     HIDE FRAME Dialog-Frame.
      852   END PROCEDURE.
      853   PROCEDURE enable_UI :
      854     DISPLAY num-days sel-dbs
      855         WITH FRAME Dialog-Frame.
      856     ENABLE b-exit b-quit RECT-3 num-days sel-dbs
      857         WITH FRAME Dialog-Frame.
      858     VIEW FRAME Dialog-Frame.
      859   END PROCEDURE.
      860   PROCEDURE init-param-values :
      861     do
      862       on error undo, return error
      863       :
      864       define input parameter p-task-type              as character    no-undo.
      865       define input parameter p-db-num-char            as character    no-undo.
      866       define input parameter p-task-num               as integer      no-undo.
      867       define variable v-param-list as character no-undo.
      868       define variable v-param-type as character no-undo.
      869       define variable v-obj-list   as character no-undo .
      870       define variable v-gds-list   as character no-undo .
      871       define variable v-oss-list   as character no-undo .
      872       define variable ii           as integer   no-undo .
      873       define variable v-entry-1    as character no-undo .
      874       define variable v-entry-2    as character no-undo .
      875       define variable v-entry-3    as character no-undo .
      876       define variable v-task-num   as integer   no-undo .
      877       define variable v-ii1        as integer   no-undo.
      878       define variable v-text       as character no-undo.
      879       define variable v-ii2        as integer   no-undo.
      880       define buffer buf_schedule      for ub.schedule.
      881       define buffer buf_schedule-attr for ub.schedule-attr.
      882       DO WITH FRAME Dialog-Frame:
      883         CASE p-mode:
      884           when 'shd':U then
      885             do:
      886               if p-task-num > 0
      887                 then
      888               do:
      889                 v-task-num = p-task-num.
      890               end.
      891               else
      892               do:
      893                 for each buf_schedule
      894                   where buf_schedule.task-type     = p-task-type
      895                   AND buf_schedule.cre-db-num    = INTEGER(p-db-num-char)
      896                   no-lock
      897                   ,
      898                   first buf_schedule-attr
      899                   where buf_schedule-attr.task-type   = p-task-type
      900                   AND buf_schedule-attr.cre-db-num  = INTEGER(p-db-num-char)
      901                   AND buf_schedule-attr.task-num    = buf_schedule.task-num
      902                   AND buf_schedule-attr.attr-code   = ('schd-free-id':U + chr(4) + 'help-road')
      903                   no-lock
      904                   :
      905                   ASSIGN
      906                     v-task-num = buf_schedule.task-num
      907                     .
      908                   leave .
      909                 end.
      910               end.
      911               if v-task-num > 0
      912                 then
      913               do:
      914                 run schedule-attr-value in this-procedure  ( input p-db-num-char
      915                   , input p-task-type
      916                   , input v-task-num
      917                   , input 'schedule-param-list':U
      918                   , output v-param-list
      919                   , output v-param-type
      920                   ) .
      921                 run schedule-attr-value in this-procedure  ( input p-db-num-char
      922                   , input p-task-type
      923                   , input v-task-num
      924                   , input 'schedule-obj-list':U
      925                   , output v-obj-list
      926                   , output v-param-type
      927                   ) .
      928                 run schedule-attr-value in this-procedure  ( input p-db-num-char
      929                   , input p-task-type
      930                   , input v-task-num
      931                   , input 'schedule-oss-list':U
      932                   , output v-oss-list
      933                   , output v-param-type
      934                   ) .
      935                 run schedule-attr-value in this-procedure  ( input p-db-num-char
      936                   , input p-task-type
      937                   , input v-task-num
      938                   , input 'schedule-gds-list':U
      939                   , output v-gds-list
      940                   , output v-param-type
      941                   ) .
      942               end.
      943               v-ii2 = num-entries( v-param-list, chr(4) ).
      944               if v-ii2 < 7 THEN
      945               do:
      946                 do v-ii1 = v-ii2 to 2:
      947                   v-param-list = v-param-list
      948                     + '':U
      949                     + chr(4).
      950                 end.
      951               end.
      952               ASSIGN
      953                 sel-dbs     = ENTRY(2, v-param-list, chr(4))
      954                 num-days    = INTEGER( ENTRY(1, v-param-list, chr(4)) )
      955                 .
      956               DISPLAY
      957                 num-days
      958                 sel-dbs
      959                 .
      960           end.
      961           WHEN 'run'
      962           THEN
      963             DO:
      964               v-param-list = '':U
      965                 + chr(4)
      966                 + '':U
      967                 + chr(4)
      968                 + '':U
      969                 + chr(4)
      970                 + '':U
      971                 + chr(4)
      972                 + '':U
      973                 + chr(4).
      974             END.
      975         END CASE.
      976       END.
      977     END.
      978   END PROCEDURE.
      979   PROCEDURE proc-save :
      980     DEFINE VARIABLE glog             AS LOGICAL   NO-UNDO.
      981     DEFINE VARIABLE v-param-list     AS CHARACTER NO-UNDO.
      982     define variable ii               as integer   no-undo .
      983     ASSIGN
      984       FRAME Dialog-Frame
      985       num-days
      986       sel-dbs
      987       .
      988     if num-days < 0 then
      989     do:
      990       message
      991         "Кол-во дней задан неверно. "
      992         skip "Задайте интервал правильно или отмените экспорт."
      993         view-as alert-box information.
      994       apply "entry" to num-days.
      995       undo, return no-apply.
      996     end.
      997       assign
      998         v-db-list = sel-dbs .
      999         .
     1000     ASSIGN
     1001       v-param-list = string(if num-days <> ? then string(num-days) else "") + chr(4) +
     1002       v-db-list + chr(4)
     1003       .
     1004     IF p-mode = 'shd' THEN
     1005     DO:
     1006       run attach-attr-to-schedule-line in this-procedure ( INPUT v-param-list
     1007         ) .
     1008     END.
     1009   END PROCEDURE.
     1010   PROCEDURE init-fields :
     1011     define buffer buf_sys-ctrl for ub.sys-ctrl .
     1012     define buffer buf_db       for db .
     1013     define variable v-db-list as character no-undo .
     1014     do
     1015       with frame Dialog-Frame
     1016       on error undo, return error
     1017       :
     1018       FIND FIRST buf_sys-ctrl No-LOCK.
     1019         For each buf_db no-LOCK:
     1020           assign
     1021             v-db-list = substitute( "&1&2&3", v-db-list, chr(44), buf_db.db-num )
     1022             .
     1023         end.
     1024       assign
     1025         sel-dbs :list-items in frame Dialog-Frame = v-db-list  .
     1026       .
     1027     end.
