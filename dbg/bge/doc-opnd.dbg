     3245     assign
     3246      price-cli-with-tax-loc = buf_parts.price-cli
     3247      cli-base-rate          = buf_parts.cli-base-rate.
     3248     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     3249              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
