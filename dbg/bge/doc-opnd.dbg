     3287                 v-road-tax-base       = v-road-tax-base  +  ( road-tax-base-loc       * v-parts-fact-qnty )
     3288                 v-road-tax-rubl       = v-road-tax-rubl  +  ( road-tax-rubl-loc       * v-parts-fact-qnty )
     3289                 v-excise-base         =   0
     3290                 v-excise-rubl         =   0
     3291                 v-transport-base      = v-transport-base +   (transport-base-loc      * v-parts-fact-qnty )
     3292                 v-transport-rubl      = v-transport-rubl +   (transport-rubl-loc      * v-parts-fact-qnty )
     3293                 v-other-base          = v-other-base     +   (other-base-loc          * v-parts-fact-qnty )
     3294                 v-other-rubl          = v-other-rubl     +   (other-rubl-loc          * v-parts-fact-qnty )
     3295               .
     3296           end.
