     3159       define buffer buf_trn-doc  for ub.trn-doc  .
     3160       define buffer buf_doc-line for ub.doc-line .
     3161       find first buf_doc-line no-lock
     3162         where buf_doc-line.doc-code  = v-doc-code
     3163           and buf_doc-line.artic     = v-artic
     3164           and buf_doc-line.prod-type = v-prod-type
     3165           and buf_doc-line.prod-code = v-prod-code
     3166         no-error .
