     3514           slt-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     3515           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     3516           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     3517         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     3518         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     3519         if transport-base-loc = ? then transport-base-loc = 0.
     3520         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     3521         if other-base-loc     = ? then other-base-loc     = 0.
     3522         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     3523         assign
     3524           transport-cli-loc      = 0
     3525           other-cli-loc          = 0
     3526           road-tax-cli-loc       = ?
     3527           vat-cli-loc            = ?
     3528           slt-cli-loc            = ?
     3529           price-cli-with-tax-loc = ?.
     3530      end.
     3531   ASSIGN
     3532             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     3533       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     3534   .
     3535             assign
     3536               v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
     3537               v-vat-pc              = vat-pc-loc
     3538               v-slt-pc              = slt-pc-loc
     3539               v-sum-base            = v-sum-base       + (price-base-with-tax-loc * v-parts-fact-qnty)
     3540               v-sum-rubl            = v-sum-rubl       + (price-rubl-with-tax-loc * v-parts-fact-qnty)
     3541               v-vat-base            = v-vat-base       + (vat-base-loc            * v-parts-fact-qnty)
     3542               v-vat-rubl            = v-vat-rubl       + (vat-rubl-loc            * v-parts-fact-qnty)
     3543               v-slt-base            = v-slt-base       + (slt-base-loc            * v-parts-fact-qnty)
     3544               v-slt-rubl            = v-slt-rubl       + (slt-rubl-loc            * v-parts-fact-qnty)
     3545               v-road-tax-base       =  0
     3546               v-road-tax-rubl       =  0
     3547               v-excise-base         =  0
     3548               v-excise-rubl         =  0
     3549               v-transport-base      =  0
     3550               v-transport-rubl      =  0
     3551               v-other-base          =  0
     3552               v-other-rubl          =  0
     3553             .
     3554       end.
     3555     end.
     3556   end procedure.
     3557   do
     3558   on error undo, return error
     3559   :
     3560       define buffer buf_trn-doc       for ub.trn-doc.
     3561       output stream stmxmlout to value( soutfile + "xm1" ) convert target "1251" append.
     3562       run wp-XMLWriteCNT( hCNT, "" ).
     3563       run wp-XMLWriteEDT( hEDT, 4, "Операция: Выгрузка незакрытых документов прихода и расхода." ).
     3564       run wp-XMLWriteLog( sLogFile, 0, "&Line" ).
     3565       run wp-XMLWriteLog( sLogFile, 1, "XML - Вывод операции: Выгрузка незакрытых документов прихода и расхода." ).
     3566       for each buf_trn-doc no-lock
     3567          where buf_trn-doc.obj-type   = p-obj-type
     3568            and buf_trn-doc.obj-code   = p-obj-code
     3569            and buf_trn-doc.status_    = 'накл':U
     3570            or ( buf_trn-doc.obj-type   = p-obj-type
     3571               and buf_trn-doc.obj-code   = p-obj-code
     3572               and buf_trn-doc.status_    = 'разрешен':U )
     3573       :
     3574           if buf_trn-doc.is-flora = yes
     3575           then do:
     3576           end.
     3577           else do:
     3578               if buf_trn-doc.ext-doc-type = 'ie':U
     3579               or buf_trn-doc.ext-doc-type = 'ee':U
     3580               then do:
     3581                   run wp-XMLWriteCNT( hCNT, string( buf_trn-doc.doc-date, "99/99/9999" ) + "  " + buf_trn-doc.doc-code ).
     3582                   run export-trn-doc in this-procedure (
     3583                       input buf_trn-doc.doc-code
     3584                       , input buf_trn-doc.ext-doc-type
     3585                       , input p-host-code
     3586                       , input buf_trn-doc.ext-doc-type
     3587                       , input ( if buf_trn-doc.ext-doc-type = 'ie':U then 1 else -1 )
     3588                   ) no-error.
     3589                   if error-status :error
     3590                   then do:
     3591                       undo, return error vss-description + "Ошибка вывода документа " + buf_trn-doc.doc-code.
     3592                   end.
     3593               end.
     3594           end.
     3595       end.
     3596       output stream stmxmlout close.
     3597   end.
     3598   procedure export-trn-doc :
     3599   define input parameter p-doc-code       as character    no-undo.
     3600   define input parameter p-ext-doc-type   as character    no-undo.
     3601   define input parameter p-host-code      as integer      no-undo.
     3602   define input parameter p-oper-name      as character    no-undo.
     3603   define input parameter p-sign           as integer      no-undo.
     3604       define variable v-fact-qnty       as decimal       no-undo.
     3605       define variable v-vat-pc          as decimal       no-undo.
     3606       define variable v-slt-pc          as decimal       no-undo.
     3607       define variable v-sum-base        as decimal       no-undo.
     3608       define variable v-sum-rubl        as decimal       no-undo.
     3609       define variable v-vat-base        as decimal       no-undo.
     3610       define variable v-vat-rubl        as decimal       no-undo.
     3611       define variable v-slt-base        as decimal       no-undo.
     3612       define variable v-slt-rubl        as decimal       no-undo.
     3613       define variable v-road-tax-base   as decimal       no-undo.
     3614       define variable v-road-tax-rubl   as decimal       no-undo.
     3615       define variable v-transport-base  as decimal       no-undo.
     3616       define variable v-transport-rubl  as decimal       no-undo.
     3617       define variable v-other-base      as decimal       no-undo.
     3618       define variable v-other-rubl      as decimal       no-undo.
     3619       define variable v-excise-base     as decimal       no-undo.
     3620       define variable v-excise-rubl     as decimal       no-undo.
     3621       define variable v-tot-cost-sum-base         as decimal       no-undo.
     3622       define variable v-tot-cost-sum-rubl         as decimal       no-undo.
     3623       define variable v-tot-cost-vat-base         as decimal       no-undo.
     3624       define variable v-tot-cost-vat-rubl         as decimal       no-undo.
     3625       define variable v-tot-cost-slt-base         as decimal       no-undo.
     3626       define variable v-tot-cost-slt-rubl         as decimal       no-undo.
     3627       define variable v-tot-cost-road-tax-base    as decimal       no-undo.
     3628       define variable v-tot-cost-road-tax-rubl    as decimal       no-undo.
     3629       define variable v-tot-cost-transport-base   as decimal       no-undo.
     3630       define variable v-tot-cost-transport-rubl   as decimal       no-undo.
     3631       define variable v-tot-cost-other-base       as decimal       no-undo.
     3632       define variable v-tot-cost-other-rubl       as decimal       no-undo.
     3633       define variable v-tot-cost-excise-base      as decimal       no-undo.
     3634       define variable v-tot-cost-excise-rubl      as decimal       no-undo.
     3635       define variable v-tot-sale-sum-base         as decimal       no-undo.
     3636       define variable v-tot-sale-sum-rubl         as decimal       no-undo.
     3637       define variable v-tot-sale-vat-base         as decimal       no-undo.
     3638       define variable v-tot-sale-vat-rubl         as decimal       no-undo.
     3639       define variable v-tot-sale-slt-base         as decimal       no-undo.
     3640       define variable v-tot-sale-slt-rubl         as decimal       no-undo.
     3641       define variable v-tot-sale-road-tax-base    as decimal       no-undo.
     3642       define variable v-tot-sale-road-tax-rubl    as decimal       no-undo.
     3643       define variable v-tot-sale-transport-base   as decimal       no-undo.
     3644       define variable v-tot-sale-transport-rubl   as decimal       no-undo.
     3645       define variable v-tot-sale-other-base       as decimal       no-undo.
     3646       define variable v-tot-sale-other-rubl       as decimal       no-undo.
     3647       define variable v-tot-sale-excise-base      as decimal       no-undo.
     3648       define variable v-tot-sale-excise-rubl      as decimal       no-undo.
     3649       define variable v-base-code                 as integer       no-undo.
     3650       define variable v-base-code-okv             as integer       no-undo.
     3651       define buffer buf_trn-doc   for ub.trn-doc.
     3652       define buffer buf_doc-line  for ub.doc-line.
     3653       define buffer buf_goods     for ub.goods.
     3654       define buffer buf_units     for ub.units.
     3655       define buffer buf_parts     for ub.parts.
     3656   do
     3657   for buf_trn-doc
     3658     , buf_doc-line
     3659     , buf_goods
     3660     , buf_units
     3661     , buf_parts
     3662   on error undo, return error
     3663   :
     3664       find first buf_trn-doc no-lock
     3665            where buf_trn-doc.doc-code = p-doc-code
     3666       .
     3667   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3668   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     3669     (input  p-host-code
     3670     ,output v-base-code
     3671     )  .
     3672       run get-base-code-okv in this-procedure (
     3673             input v-base-code
     3674           , output v-base-code-okv
     3675       ).
     3676       run wp-xmltagopen(2, "operation","").
     3677       run wp-xmltagput(3, "referenceNo",    buf_trn-doc.doc-code, 0).
     3678       run wp-xmltagput(3, "codeOperation",  string( p-ext-doc-type ), 0).
     3679       run wp-xmltagput(3, "status",         string( buf_trn-doc.status_ ), 0).
     3680       run wp-xmltagput(3, "host",           string( p-host-code ), 0).
     3681       run wp-xmltagput(3, "store",          buf_trn-doc.obj-type + string( buf_trn-doc.obj-code ), 0).
     3682       run wp-xmltagput(3, "factOrder"    ,  string( buf_trn-doc.fact-order                        ), 0 ).
     3683       run wp-xmltagput(3, "sysDate"      ,  string( buf_trn-doc.sys-date, "99.99.9999"            ), 0 ).
     3684       run wp-xmltagput(3, "sysTime"      ,  string( buf_trn-doc.sys-time                          ), 0 ).
     3685       run wp-xmltagput(3, "dateDoc",        string( buf_trn-doc.doc-date,"99.99.9999"), 0).
     3686       run wp-xmltagput(3, "dateFact",       string( buf_trn-doc.fact-date,"99.99.9999"), 0).
     3687       run wp-xmltagput(3, "valutCode",      string( v-base-code ), 0).
     3688       run wp-xmltagput(3, "valutCodeOKV",   string( v-base-code-okv                      ), 0 ).
     3689        run wp-xmltagput(3, "firm",           buf_trn-doc.cli-type + string(buf_trn-doc.cli-code), 0).
     3690       run wp-xmltagput(3, "extNumber",      string(buf_trn-doc.ord-num), 0).
     3691       run wp-xmltagput(3, "paymentCode",   string(buf_trn-doc.pay-code), 0).
     3692       run wp-xmltagput(3, "outCode",       buf_trn-doc.out-code, 0).
     3693       run wp-xmltagput(3, "reasonCode",     string( buf_trn-doc.reason-code ), 2 ).
     3694       run wp-xmltagput(3, "comment",       buf_trn-doc.PS, 0).
     3695       for each buf_doc-line no-lock
     3696          where buf_doc-line.doc-code = buf_trn-doc.doc-code
     3697       :
     3698           run wp-xmltagopen(3, "linedoc","").
     3699           find first buf_goods no-lock
     3700                where buf_goods.artic      = buf_doc-line.artic
     3701                  and buf_goods.prod-type  = buf_doc-line.prod-type
     3702                  and buf_goods.prod-code  = buf_doc-line.prod-code
     3703           .
     3704           if available buf_goods
     3705           then do:
     3706               run wp-xmltagput( 4, "good",       string(buf_goods.gds-code),         0).
     3707               run wp-xmltagput( 4, "type",       string(buf_goods.gds-type),         0).
     3708               run fill_bge-xml_goods in this-procedure (
     3709                     input p-parent-handle
     3710                   , input buf_goods.gds-code
     3711               ).
     3712           end.
     3713           else do:
     3714               run wp-xmltagput( 4, "good",       "",         0).
     3715               run wp-xmltagput( 4, "type",       "",         0).
     3716           end.
     3717           find first buf_units no-lock
     3718                where buf_units.unit-name  = buf_goods.unit-base
     3719           no-error.
     3720           if available buf_units
     3721           then do:
     3722               run wp-xmltagput( 4, "unitType",   string(buf_units.type),             0 ).
     3723           end.
     3724           else do:
     3725               run wp-xmltagput( 4, "unitType",   "",                             0 ).
     3726           end.
     3727           run wp-xmltagput( 4, "wait",       string( buf_doc-line.wt-brutto ), 0 ).
     3728           run wp-xmltagput( 4, "place",      string( buf_doc-line.num-place ), 0 ).
     3729           run r-sale in this-procedure (
     3730                 input buf_doc-line.doc-code
     3731               , input buf_doc-line.artic
     3732               , input buf_doc-line.prod-type
     3733               , input buf_doc-line.prod-code
     3734               , output v-fact-qnty
     3735               , output v-vat-pc
     3736               , output v-slt-pc
     3737               , output v-sum-base
     3738               , output v-sum-rubl
     3739               , output v-vat-base
     3740               , output v-vat-rubl
     3741               , output v-slt-base
     3742               , output v-slt-rubl
     3743               , output v-road-tax-base
     3744               , output v-road-tax-rubl
     3745               , output v-transport-base
     3746               , output v-transport-rubl
     3747               , output v-other-base
     3748               , output v-other-rubl
     3749               , output v-excise-base
     3750               , output v-excise-rubl
     3751           ).
     3752           assign
     3753               v-fact-qnty      = v-fact-qnty      * p-sign
     3754               v-sum-base       = v-sum-base       * p-sign
     3755               v-sum-rubl       = v-sum-rubl       * p-sign
     3756               v-vat-base       = v-vat-base       * p-sign
     3757               v-vat-rubl       = v-vat-rubl       * p-sign
     3758               v-slt-base       = v-slt-base       * p-sign
     3759               v-slt-rubl       = v-slt-rubl       * p-sign
     3760               v-road-tax-base  = v-road-tax-base  * p-sign
     3761               v-road-tax-rubl  = v-road-tax-rubl  * p-sign
     3762               v-transport-base = v-transport-base * p-sign
     3763               v-transport-rubl = v-transport-rubl * p-sign
     3764               v-other-base     = v-other-base     * p-sign
     3765               v-other-rubl     = v-other-rubl     * p-sign
     3766               v-excise-base    = v-excise-base    * p-sign
     3767               v-excise-rubl    = v-excise-rubl    * p-sign
     3768           .
     3769           run wp-xmltagput( 4, "quantity",    string( v-fact-qnty ), 0 ).
     3770           run wp-xmltagopen( 4, "docSum","").
     3771           run wp-xmltagput( 5, "rateVAT",    string( v-vat-pc ), 2).
     3772           run wp-xmltagput( 5, "rateSLT",    string( v-slt-pc ), 2).
     3773           run wp-xmltagput( 5, "sumr",       v-sum-rubl       , 2).
     3774           run wp-xmltagput( 5, "VATr",       v-vat-rubl       , 2).
     3775           run wp-xmltagput( 5, "SLTr",       v-slt-rubl       , 2).
     3776           run wp-xmltagput( 5, "roadTaxr",   v-road-tax-rubl  , 2).
     3777           run wp-xmltagput( 5, "transportr", v-transport-rubl , 2).
     3778           run wp-xmltagput( 5, "otherr",     v-other-rubl     , 2).
     3779           run wp-xmltagput( 5, "exciser",    v-excise-rubl    , 2).
     3780           run wp-xmltagput( 5, "sumb",       v-sum-base       , 2).
     3781           run wp-xmltagput( 5, "VATb",       v-vat-base       , 2).
     3782           run wp-xmltagput( 5, "SLTb",       v-slt-base       , 2).
     3783           run wp-xmltagput( 5, "roadTaxb",   v-road-tax-base  , 2).
     3784           run wp-xmltagput( 5, "transportb", v-transport-base , 2).
     3785           run wp-xmltagput( 5, "otherb",     v-other-base     , 2).
     3786           run wp-xmltagput( 5, "exciseb",    v-excise-base    , 2).
     3787           run wp-xmltagclose( 4, "docSum" ).
     3788           assign
     3789               v-tot-sale-sum-base       = v-tot-sale-sum-base       + v-sum-base
     3790               v-tot-sale-sum-rubl       = v-tot-sale-sum-rubl       + v-sum-rubl
     3791               v-tot-sale-vat-base       = v-tot-sale-vat-base       + v-vat-base
     3792               v-tot-sale-vat-rubl       = v-tot-sale-vat-rubl       + v-vat-rubl
     3793               v-tot-sale-slt-base       = v-tot-sale-slt-base       + v-slt-base
     3794               v-tot-sale-slt-rubl       = v-tot-sale-slt-rubl       + v-slt-rubl
     3795               v-tot-sale-road-tax-base  = v-tot-sale-road-tax-base  + v-road-tax-base
     3796               v-tot-sale-road-tax-rubl  = v-tot-sale-road-tax-rubl  + v-road-tax-rubl
     3797               v-tot-sale-transport-base = v-tot-sale-transport-base + v-transport-base
     3798               v-tot-sale-transport-rubl = v-tot-sale-transport-rubl + v-transport-rubl
     3799               v-tot-sale-other-base     = v-tot-sale-other-base     + v-other-base
     3800               v-tot-sale-other-rubl     = v-tot-sale-other-rubl     + v-other-rubl
     3801               v-tot-sale-excise-base    = v-tot-sale-excise-base    + v-excise-base
     3802               v-tot-sale-excise-rubl    = v-tot-sale-excise-rubl    + v-excise-rubl
     3803           .
     3804           run r-cost in this-procedure (
     3805                 input buf_doc-line.doc-code
     3806               , input buf_doc-line.artic
     3807               , input buf_doc-line.prod-type
     3808               , input buf_doc-line.prod-code
     3809               , output v-fact-qnty
     3810               , output v-vat-pc
     3811               , output v-slt-pc
     3812               , output v-sum-base
     3813               , output v-sum-rubl
     3814               , output v-vat-base
     3815               , output v-vat-rubl
     3816               , output v-slt-base
     3817               , output v-slt-rubl
     3818               , output v-road-tax-base
     3819               , output v-road-tax-rubl
     3820               , output v-transport-base
     3821               , output v-transport-rubl
     3822               , output v-other-base
     3823               , output v-other-rubl
     3824               , output v-excise-base
     3825               , output v-excise-rubl
     3826           ).
     3827           assign
     3828               v-fact-qnty      = v-fact-qnty      * p-sign
     3829               v-sum-base       = v-sum-base       * p-sign
     3830               v-sum-rubl       = v-sum-rubl       * p-sign
     3831               v-vat-base       = v-vat-base       * p-sign
     3832               v-vat-rubl       = v-vat-rubl       * p-sign
     3833               v-slt-base       = v-slt-base       * p-sign
     3834               v-slt-rubl       = v-slt-rubl       * p-sign
     3835               v-road-tax-base  = v-road-tax-base  * p-sign
     3836               v-road-tax-rubl  = v-road-tax-rubl  * p-sign
     3837               v-transport-base = v-transport-base * p-sign
     3838               v-transport-rubl = v-transport-rubl * p-sign
     3839               v-other-base     = v-other-base     * p-sign
     3840               v-other-rubl     = v-other-rubl     * p-sign
     3841               v-excise-base    = v-excise-base    * p-sign
     3842               v-excise-rubl    = v-excise-rubl    * p-sign
     3843           .
     3844           run wp-xmltagopen( 4, "costSum","").
     3845           run wp-xmltagput( 5, "rateVAT",    string( v-vat-pc ), 2).
     3846           run wp-xmltagput( 5, "rateSLT",    string( v-slt-pc ), 2).
     3847           run wp-xmltagput( 5, "sumr",       v-sum-rubl       , 2).
     3848           run wp-xmltagput( 5, "VATr",       v-vat-rubl       , 2).
     3849           run wp-xmltagput( 5, "SLTr",       v-slt-rubl       , 2).
     3850           run wp-xmltagput( 5, "roadTaxr",   v-road-tax-rubl  , 2).
     3851           run wp-xmltagput( 5, "transportr", v-transport-rubl , 2).
     3852           run wp-xmltagput( 5, "otherr",     v-other-rubl     , 2).
     3853           run wp-xmltagput( 5, "exciser",    v-excise-rubl    , 2).
     3854           run wp-xmltagput( 5, "sumb",       v-sum-base       , 2).
     3855           run wp-xmltagput( 5, "VATb",       v-vat-base       , 2).
     3856           run wp-xmltagput( 5, "SLTb",       v-slt-base       , 2).
     3857           run wp-xmltagput( 5, "roadtaxb",   v-road-tax-base  , 2).
     3858           run wp-xmltagput( 5, "transportb", v-transport-base , 2).
     3859           run wp-xmltagput( 5, "otherb",     v-other-base     , 2).
     3860           run wp-xmltagput( 5, "exciseb",    v-excise-base    , 2).
     3861           run wp-xmltagclose( 4, "costSum" ).
     3862           assign
     3863               v-tot-cost-sum-base       = v-tot-cost-sum-base       + v-sum-base
     3864               v-tot-cost-sum-rubl       = v-tot-cost-sum-rubl       + v-sum-rubl
     3865               v-tot-cost-vat-base       = v-tot-cost-vat-base       + v-vat-base
     3866               v-tot-cost-vat-rubl       = v-tot-cost-vat-rubl       + v-vat-rubl
     3867               v-tot-cost-slt-base       = v-tot-cost-slt-base       + v-slt-base
     3868               v-tot-cost-slt-rubl       = v-tot-cost-slt-rubl       + v-slt-rubl
     3869               v-tot-cost-road-tax-base  = v-tot-cost-road-tax-base  + v-road-tax-base
     3870               v-tot-cost-road-tax-rubl  = v-tot-cost-road-tax-rubl  + v-road-tax-rubl
     3871               v-tot-cost-transport-base = v-tot-cost-transport-base + v-transport-base
     3872               v-tot-cost-transport-rubl = v-tot-cost-transport-rubl + v-transport-rubl
     3873               v-tot-cost-other-base     = v-tot-cost-other-base     + v-other-base
     3874               v-tot-cost-other-rubl     = v-tot-cost-other-rubl     + v-other-rubl
     3875               v-tot-cost-excise-base    = v-tot-cost-excise-base    + v-excise-base
     3876               v-tot-cost-excise-rubl    = v-tot-cost-excise-rubl    + v-excise-rubl
     3877           .
     3878           if p-cst = yes
     3879           or p-parts = yes
     3880           then do:
     3881               run export-parts in this-procedure (
     3882                     input buf_doc-line.doc-code
     3883                   , input ( if available buf_goods then buf_goods.gds-code else 0 )
     3884                   , input buf_doc-line.obj-type
     3885                   , input buf_doc-line.obj-code
     3886                   , input buf_doc-line.prod-type
     3887                   , input buf_doc-line.prod-code
     3888                   , input buf_doc-line.artic
     3889               ).
     3890           end.
     3891           run wp-xmltagclose( 3, "linedoc").
     3892       end.
     3893       run wp-xmltagopen( 3, "docSum","").
     3894       run wp-xmltagput( 4, "sumr",       v-tot-sale-sum-rubl       , 2).
     3895       run wp-xmltagput( 4, "VATr",       v-tot-sale-vat-rubl       , 2).
     3896       run wp-xmltagput( 4, "SLTr",       v-tot-sale-slt-rubl       , 2).
     3897       run wp-xmltagput( 4, "roadTaxr",   v-tot-sale-road-tax-rubl  , 2).
     3898       run wp-xmltagput( 4, "transportr", v-tot-sale-transport-rubl , 2).
     3899       run wp-xmltagput( 4, "otherr",     v-tot-sale-other-rubl     , 2).
     3900       run wp-xmltagput( 4, "exciser",    v-tot-sale-excise-rubl    , 2).
     3901       run wp-xmltagput( 4, "sumb",       v-tot-sale-sum-base       , 2).
     3902       run wp-xmltagput( 4, "VATb",       v-tot-sale-vat-base       , 2).
     3903       run wp-xmltagput( 4, "SLTb",       v-tot-sale-slt-base       , 2).
     3904       run wp-xmltagput( 4, "roadtaxb",   v-tot-sale-road-tax-base  , 2).
     3905       run wp-xmltagput( 4, "transportb", v-tot-sale-transport-base , 2).
     3906       run wp-xmltagput( 4, "otherb",     v-tot-sale-other-base     , 2).
     3907       run wp-xmltagput( 4, "exciseb",    v-tot-sale-excise-base    , 2).
     3908       run wp-xmltagclose( 3, "docSum" ).
     3909       run wp-xmltagopen( 3, "costSum","").
     3910       run wp-xmltagput( 4, "sumr",       v-tot-cost-sum-rubl       , 2).
     3911       run wp-xmltagput( 4, "VATr",       v-tot-cost-vat-rubl       , 2).
     3912       run wp-xmltagput( 4, "SLTr",       v-tot-cost-slt-rubl       , 2).
     3913       run wp-xmltagput( 4, "roadTaxr",   v-tot-cost-road-tax-rubl  , 2).
     3914       run wp-xmltagput( 4, "transportr", v-tot-cost-transport-rubl , 2).
     3915       run wp-xmltagput( 4, "otherr",     v-tot-cost-other-rubl     , 2).
     3916       run wp-xmltagput( 4, "exciser",    v-tot-cost-excise-rubl    , 2).
     3917       run wp-xmltagput( 4, "sumb",       v-tot-cost-sum-base       , 2).
     3918       run wp-xmltagput( 4, "VATb",       v-tot-cost-vat-base       , 2).
     3919       run wp-xmltagput( 4, "SLTb",       v-tot-cost-slt-base       , 2).
     3920       run wp-xmltagput( 4, "roadtaxb",   v-tot-cost-road-tax-base  , 2).
     3921       run wp-xmltagput( 4, "transportb", v-tot-cost-transport-base , 2).
     3922       run wp-xmltagput( 4, "otherb",     v-tot-cost-other-base     , 2).
     3923       run wp-xmltagput( 4, "exciseb",    v-tot-cost-excise-base    , 2).
     3924       run wp-xmltagclose( 3, "costSum" ).
     3925       run wp-xmltagclose(2, "operation").
     3926   end.
     3927   end procedure.
     3928   procedure export-parts :
     3929   do
     3930   on error undo, return error
     3931   :
     3932   define input parameter p-doc-code   as character    no-undo.
     3933   define input parameter p-gds-code   as integer      no-undo.
     3934   define input parameter p-obj-type   as character    no-undo.
     3935   define input parameter p-obj-code   as integer      no-undo.
     3936   define input parameter p-prod-type  as character    no-undo.
     3937   define input parameter p-prod-code  as integer      no-undo.
     3938   define input parameter p-artic      as character    no-undo.
     3939       define variable v-parts-cst-code    as character    no-undo.
     3940       define variable v-fact-qnty      as decimal     no-undo.
     3941       define variable v-sum-rubl       as decimal     no-undo.
     3942       define variable v-vat-rubl       as decimal     no-undo.
     3943       define variable v-slt-rubl       as decimal     no-undo.
     3944       define variable v-road-tax-rubl  as decimal     no-undo.
     3945       define variable v-transport-rubl as decimal     no-undo.
     3946       define variable v-other-rubl     as decimal     no-undo.
     3947       define variable v-excise-rubl    as decimal     no-undo.
     3948       define variable v-sum-base       as decimal     no-undo.
     3949       define variable v-vat-base       as decimal     no-undo.
     3950       define variable v-slt-base       as decimal     no-undo.
     3951       define variable v-road-tax-base  as decimal     no-undo.
     3952       define variable v-transport-base as decimal     no-undo.
     3953       define variable v-other-base     as decimal     no-undo.
     3954       define variable v-excise-base    as decimal     no-undo.
     3955       define variable v-supp-type      as character   no-undo.
     3956       define variable v-supp-code      as integer     no-undo.
     3957       define variable v-in-code        as character   no-undo.
     3958       define variable v-cst-code       as character   no-undo.
     3959       define variable v-parts-host-code      as integer       no-undo.
     3960       define variable v-parts-contract-code  as integer       no-undo.
     3961       define buffer buf_parts                for ub.parts.
     3962       define buffer buf_parts-attr           for ub.parts-attr.
     3963       assign
     3964           v-parts-cst-code = ""
     3965       .
     3966       for each buf_parts no-lock
     3967           where buf_parts.out-code   = p-doc-code
     3968             and buf_parts.obj-type   = p-obj-type
     3969             and buf_parts.obj-code   = p-obj-code
     3970             and buf_parts.prod-type  = p-prod-type
     3971             and buf_parts.prod-code  = p-prod-code
     3972             and buf_parts.artic      = p-artic
     3973       on error undo, return error return-value
     3974       :
     3975           if p-parts = yes
     3976           then do:
     3977   assign
     3978     price-rubl-with-tax-loc = buf_parts.price-rubl
     3979     price-base-with-tax-loc = buf_parts.price-base
     3980   .
     3981   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3982   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3983     (output varinvprb
     3984     )  .
     3985     if buf_parts.out-code = 'free-zone':U     or
     3986        buf_parts.out-code = 'out-zone':U   or
     3987        buf_parts.doc-type = 'акт':U then do:
     3988       assign
     3989         in-vatp-have-vat-slt = yes.
     3990     end.
     3991     else do:
     3992       find first in-vatp_doc-attr no-lock
     3993         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     3994           and in-vatp_doc-attr.attr-code = 'envd':U
     3995         no-error .
     3996       if not available in-vatp_doc-attr then do:
     3997         assign
     3998           in-vatp-have-vat-slt = yes.
     3999       end.
     4000       else do:
     4001            in-vatp-have-vat-slt = no.
     4002       end.
     4003     end.
     4004     assign
     4005      price-cli-with-tax-loc = buf_parts.price-cli
     4006      cli-base-rate          = buf_parts.cli-base-rate.
     4007     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     4008              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     4009     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     4010             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     4011             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     4012             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     4013             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     4014             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     4015             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     4016       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     4017     assign
     4018       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     4019     assign
     4020       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     4021       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     4022       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     4023       transport-cli-loc  = 0
     4024       other-cli-loc      = 0
     4025     .
     4026   ASSIGN
     4027             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     4028       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     4029   .
     4030               ASSIGN
     4031                   v-fact-qnty           = buf_parts.fact-qnty
     4032                   v-sum-rubl            = price-rubl-with-tax-loc * v-fact-qnty
     4033                   v-vat-rubl            = vat-rubl-loc            * v-fact-qnty
     4034                   v-slt-rubl            = slt-rubl-loc            * v-fact-qnty
     4035                   v-road-tax-rubl       = road-tax-rubl-loc       * v-fact-qnty
     4036                   v-transport-rubl      = transport-rubl-loc      * v-fact-qnty
     4037                   v-other-rubl          = other-rubl-loc          * v-fact-qnty
     4038                   v-excise-rubl         = 0
     4039                   v-sum-base            = price-base-with-tax-loc * v-fact-qnty
     4040                   v-vat-base            = vat-base-loc            * v-fact-qnty
     4041                   v-slt-base            = slt-base-loc            * v-fact-qnty
     4042                   v-road-tax-base       = road-tax-base-loc       * v-fact-qnty
     4043                   v-transport-base      = transport-base-loc      * v-fact-qnty
     4044                   v-other-base          = other-base-loc          * v-fact-qnty
     4045                   v-excise-base         = 0
     4046                   v-parts-host-code     = buf_parts.host-code
     4047                   v-parts-contract-code = buf_parts.contract-code
     4048               .
     4049               if p-gds-code <> 0
     4050               then do:
     4051                   find first buf_parts-attr no-lock
     4052                        where buf_parts-attr.in-code   = buf_parts.in-code
     4053                          and buf_parts-attr.gds-code  = p-gds-code
     4054                          and buf_parts-attr.part-code = buf_parts.part-code
     4055                   no-error .
     4056                   if available buf_parts-attr
     4057                   then do:
     4058                       assign
     4059                           v-supp-type = buf_parts-attr.supp-type
     4060                           v-supp-code = buf_parts-attr.supp-code
     4061                           v-in-code   = buf_parts-attr.income-in-code
     4062                           v-cst-code  = buf_parts-attr.cst-code
     4063                       .
     4064                   end.
     4065                   else do:
     4066                       assign
     4067                           v-supp-type = buf_parts.supp-type
     4068                           v-supp-code = buf_parts.supp-code
     4069                           v-in-code   = buf_parts.in-code
     4070                           v-cst-code  = buf_parts.cst-code
     4071                       .
     4072                   end.
     4073               end.
     4074               else do:
     4075                   assign
     4076                       v-supp-type = buf_parts.supp-type
     4077                       v-supp-code = buf_parts.supp-code
     4078                       v-in-code   = buf_parts.in-code
     4079                       v-cst-code  = buf_parts.cst-code
     4080                   .
     4081               end.
     4082               run wp-xmltagopen in this-procedure ( input 5, input "part", input "" ).
     4083               run wp-xmltagput in this-procedure ( input 6, input "doc_ID"    , input string( v-in-code          ), input 2 ).
     4084               run wp-xmltagput in this-procedure ( input 6, input "qnty"      , input string( v-fact-qnty        ), input 2 ).
     4085               run wp-xmltagput in this-procedure ( input 6, input "cst"       , input string( v-cst-code         ), input 2 ).
     4086               run wp-xmltagput in this-procedure ( input 6, input "supp"      , input string( v-supp-type + string( v-supp-code ) ), input 2 ).
     4087               run wp-xmltagput in this-procedure ( input 6, input "hostCode"      , input string( v-parts-host-code       ), input 2 ).
     4088               run wp-xmltagput in this-procedure ( input 6, input "contractCode"  , input string( v-parts-contract-code   ), input 2 ).
     4089               run wp-xmltagput in this-procedure ( input 6, input "sumr"      , input string( v-sum-rubl         ), input 2 ).
     4090               run wp-xmltagput in this-procedure ( input 6, input "VATr"      , input string( v-vat-rubl         ), input 2 ).
     4091               run wp-xmltagput in this-procedure ( input 6, input "SLTr"      , input string( v-slt-rubl         ), input 2 ).
     4092               run wp-xmltagput in this-procedure ( input 6, input "roadTaxr"  , input string( v-road-tax-rubl    ), input 2 ).
     4093               run wp-xmltagput in this-procedure ( input 6, input "transportr", input string( v-transport-rubl   ), input 2 ).
     4094               run wp-xmltagput in this-procedure ( input 6, input "otherr"    , input string( v-other-rubl       ), input 2 ).
     4095               run wp-xmltagput in this-procedure ( input 6, input "exciser"   , input string( v-excise-rubl      ), input 2 ).
     4096               run wp-xmltagput in this-procedure ( input 6, input "sumb"      , input string( v-sum-base         ), input 2 ).
     4097               run wp-xmltagput in this-procedure ( input 6, input "VATb"      , input string( v-vat-base         ), input 2 ).
     4098               run wp-xmltagput in this-procedure ( input 6, input "SLTb"      , input string( v-slt-base         ), input 2 ).
     4099               run wp-xmltagput in this-procedure ( input 6, input "roadtaxb"  , input string( v-road-tax-base    ), input 2 ).
     4100               run wp-xmltagput in this-procedure ( input 6, input "transportb", input string( v-transport-base   ), input 2 ).
     4101               run wp-xmltagput in this-procedure ( input 6, input "otherb"    , input string( v-other-base       ), input 2 ).
     4102               run wp-xmltagput in this-procedure ( input 6, input "exciseb"   , input string( v-excise-base      ), input 2 ).
     4103               run wp-xmltagclose in this-procedure ( input 5, input "part" ).
     4104           end.
     4105           if p-cst = yes
     4106           then do:
     4107               assign
     4108                   v-parts-cst-code = v-parts-cst-code
     4109                                       + ( if ( v-cst-code <> ?
     4110                                           and trim( v-cst-code )   <> ""
     4111                                           and trim( v-parts-cst-code ) <> "" )
     4112                                           then "; "
     4113                                           else ""  )
     4114                                       + v-cst-code
     4115               .
     4116           end.
     4117       end.
     4118       if p-cst = yes
     4119       and v-parts-cst-code <> ""
     4120       then do:
     4121           run wp-xmltagput in this-procedure ( input 4, input "CSTCode"      , input v-parts-cst-code , input 0 ).
     4122       end.
     4123   end.
     4124   end procedure.
     4125   procedure fill_bge-xml_goods :
     4126   define input parameter p-parent-handle  as handle           no-undo.
     4127   define input parameter p-gds-code       as integer          no-undo.
     4128   do
     4129   on error undo, return error
     4130   :
     4131       if p-parent-handle :get-signature( "cb-fill_bge-xml_goods" ) <> "":U
     4132       then do:
     4133           run cb-fill_bge-xml_goods in p-parent-handle (
     4134               input p-gds-code
     4135           ).
     4136       end.
     4137   end.
     4138   end procedure.
     4139   procedure get-base-code-okv :
     4140   define input parameter p-base-code          as integer          no-undo.
     4141   define output parameter p-base-code-okv     as integer          no-undo.
     4142       define buffer buf_currency      for ub.currency.
     4143   do
     4144   for buf_currency
     4145   on error undo, return error
     4146   :
     4147       find first buf_currency no-lock
     4148            where buf_currency.curr-code = p-base-code
     4149       .
     4150       assign
     4151           p-base-code-okv = buf_currency.okv-code
     4152       .
     4153   end.
     4154   end procedure.
