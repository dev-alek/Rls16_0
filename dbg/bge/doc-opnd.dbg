     3154       define variable varinvatp-envd             as   character              no-undo.
     3155       define variable varinvatp-type             as   character              no-undo.
     3156       def var v-parts-fact-qnty as decimal   no-undo .
     3157       define buffer buf_parts    for ub.parts    .
