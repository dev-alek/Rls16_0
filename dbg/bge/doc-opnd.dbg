      886   define variable v-bge-xml-shift-mode    as logical           no-undo.
      887   define variable v-bge-xml-bgeflnm-doc   as character         no-undo.
      888   define variable v-bge-xml-bgeflnm-day   as character         no-undo.
      889   define variable v-bge-xml-log-file-name as character    no-undo.
      890   define variable v-bge-xml-dbf-file-name as character    no-undo.
      891   define variable v-bge-xml-db-num-str    as character    no-undo .
      892   define variable v-bge-xml-static-log-file-name as character    no-undo.
