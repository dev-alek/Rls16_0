     2858   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2859   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2860     (output varoutvprb
     2861     )  .
     2862   if varoutvprb = "base":u then do:
     2863     assign
     2864           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     2865       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1)
     2866     .
     2867   end.
     2868   else do:
     2869     assign
     2870           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     2871       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     2872     .
     2873   end.
     2874   if varoutvprb = "rubl":u then do:
     2875     assign
     2876           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     2877       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1) .
     2878   end.
     2879   else do:
     2880     assign
     2881           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale)
     2882       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * buf_trn-doc.base-rate / buf_trn-doc.base-scale) .
     2883   end.
     2884   assign
     2885     varis-cons-parts-have =  no.
     2886   assign
     2887     varfact-qnty       = 0
     2888     varcons-qnty       = 0
     2889     varprice-base-cons = 0
     2890     varprice-rubl-cons = 0.
     2891   find first out-vatp_doc-line where
     2892              out-vatp_doc-line.doc-code   = buf_trn-doc.doc-code
     2893          and out-vatp_doc-line.artic      = buf_doc-line.artic
     2894          and out-vatp_doc-line.prod-type  = buf_doc-line.prod-type
     2895          and out-vatp_doc-line.prod-code  = buf_doc-line.prod-code no-lock no-error.
     2896   if available out-vatp_doc-line           and
     2897     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
     2898     assign
     2899       varfact-qnty = out-vatp_doc-line.fact-qnty.
     2900   end.
     2901   else do:
     2902     for each out-vatp_parts where out-vatp_parts.out-code   = buf_trn-doc.doc-code
     2903                                  and out-vatp_parts.obj-type   = buf_trn-doc.obj-type
     2904                                  and out-vatp_parts.obj-code   = buf_trn-doc.obj-code
     2905                                  and out-vatp_parts.artic      = buf_doc-line.artic
     2906                                  and out-vatp_parts.prod-type  = buf_doc-line.prod-type
     2907                                  and out-vatp_parts.prod-code  = buf_doc-line.prod-code no-lock :
     2908       if out-vatp_parts.purch-code = 2 then do:
     2909   assign
     2910     price-rubl-with-tax-loco = out-vatp_parts.price-rubl
     2911     price-base-with-tax-loco = out-vatp_parts.price-base
     2912   .
     2913   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2914   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2915     (output varinvprbo
     2916     )  .
     2917     if out-vatp_parts.out-code = 'free-zone':U     or
     2918        out-vatp_parts.out-code = 'out-zone':U   or
     2919        out-vatp_parts.doc-type = 'акт':U then do:
     2920       assign
     2921         in-vatp-have-vat-slto = yes.
     2922     end.
     2923     else do:
     2924       find first in-vatp_doc-attro no-lock
     2925         where in-vatp_doc-attro.doc-code  = out-vatp_parts.out-code
     2926           and in-vatp_doc-attro.attr-code = 'envd':U
     2927         no-error .
     2928       if not available in-vatp_doc-attro then do:
     2929         assign
     2930           in-vatp-have-vat-slto = yes.
     2931       end.
     2932       else do:
     2933            in-vatp-have-vat-slto = no.
     2934       end.
     2935     end.
     2936     assign
     2937      price-cli-with-tax-loco = out-vatp_parts.price-cli
     2938      cli-base-rateo          = out-vatp_parts.cli-base-rate.
     2939     ASSIGN   road-tax-base-loco  = (if out-vatp_parts.road-tax-base  = ? then 0 else out-vatp_parts.road-tax-base)
     2940              road-tax-rubl-loco  = (if out-vatp_parts.road-tax-rubl  = ? then 0 else out-vatp_parts.road-tax-rubl).
     2941     ASSIGN  transport-base-loco = (if out-vatp_parts.transport-base = ? then 0 else out-vatp_parts.transport-base)
     2942             transport-rubl-loco = (if out-vatp_parts.transport-rubl = ? then 0 else out-vatp_parts.transport-rubl)
     2943             other-base-loco     = (if out-vatp_parts.other-base     = ? then 0 else out-vatp_parts.other-base)
     2944             other-rubl-loco     = (if out-vatp_parts.other-rubl     = ? then 0 else out-vatp_parts.other-rubl)
     2945             vat-pc-loco         = (if out-vatp_parts.vat-pc         = ? then 0 else out-vatp_parts.vat-pc)
     2946             slt-pc-loco         = (if out-vatp_parts.slt-pc         = ? then 0 else out-vatp_parts.slt-pc).
     2947             ASSIGN   slt-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     2948       ASSIGN   slt-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     2949     assign
     2950       exch-rate-cli-loco = (out-vatp_parts.price-rubl - transport-rubl-loco - other-rubl-loco - road-tax-rubl-loco - (if out-vatp_parts.vat-type <> 'в т. ч.':U then vat-rubl-loco else 0) - (if out-vatp_parts.slt-type <> 'в т. ч.':U then slt-rubl-loco else 0)) / out-vatp_parts.price-cli .
     2951     assign
     2952       slt-cli-loco        = slt-rubl-loco       / exch-rate-cli-loco
     2953       vat-cli-loco        = vat-rubl-loco       / exch-rate-cli-loco
     2954       road-tax-cli-loco   = road-tax-rubl-loco  / exch-rate-cli-loco
     2955       transport-cli-loco  = 0
     2956       other-cli-loco      = 0
     2957     .
     2958   ASSIGN
     2959             price-base-without-tax-loco = price-base-with-tax-loco - vat-base-loco - slt-base-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))
     2960       price-rubl-without-tax-loco = price-rubl-with-tax-loco - vat-rubl-loco - slt-rubl-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))
     2961   .
     2962         assign
     2963           varprice-base-cons = varprice-base-cons + (price-base-with-tax-loco - (if road-tax-base-loco = ? then 0 else road-tax-base-loco))* out-vatp_parts.fact-qnty
     2964           varprice-rubl-cons = varprice-rubl-cons + (price-rubl-with-tax-loco - (if road-tax-rubl-loco = ? then 0 else road-tax-rubl-loco))* out-vatp_parts.fact-qnty.
     2965         assign
     2966           varis-cons-parts-have = yes
     2967           varcons-qnty          = varcons-qnty + out-vatp_parts.fact-qnty.
     2968       end.
     2969       assign
     2970         varfact-qnty = varfact-qnty + out-vatp_parts.fact-qnty.
     2971     end.
     2972   end.
     2973   assign
     2974     varprice-base-cons = varprice-base-cons / varcons-qnty
     2975     varprice-rubl-cons = varprice-rubl-cons / varcons-qnty.
     2976   if varprice-base-cons = ? then do:
     2977     assign
     2978       varprice-base-cons = 0.
     2979   end.
     2980   if varprice-rubl-cons = ? then do:
     2981     assign
     2982       varprice-rubl-cons = 0.
     2983   end.
     2984   assign
     2985       slt-base-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
     2986     vat-base-buyer              = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     2987     discnt-base-sale            = buf_gds-dtl.discnt-base
     2988     price-base-with-tax-sale    = (buf_gds-dtl.price-base - buf_gds-dtl.discnt-base)
     2989       slt-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
     2990     vat-rubl-buyer              = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     2991     discnt-rubl-sale            = buf_gds-dtl.discnt-rubl
     2992     price-rubl-with-tax-sale    = (buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl)
     2993     .
     2994   if buf_trn-doc.doc-type = 'инв':U then do:
     2995     assign
     2996       varfact-qnty = buf_gds-dtl.doc-qnty.
     2997   end.
     2998   else do:
     2999     assign
     3000       varfact-qnty = buf_gds-dtl.fact-qnty.
     3001   end.
     3002   if varis-cons-parts-have = no then do:
     3003     assign
     3004           vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     3005           vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc).
     3006   end.
     3007   else do:
     3008     if buf_trn-doc.doc-type = 'инв':U then do:
     3009       assign
     3010               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     3011               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     3012        .
     3013     end.
     3014     else do:
     3015       assign
     3016               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-base-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     3017               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-rubl-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     3018        .
     3019     end.
     3020   end.
     3021   assign
     3022   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     3023   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     3024               ASSIGN
     3025                   p-fact-qnty           = p-fact-qnty     + v-gds-dtl-fact-qnty
     3026                   p-sum-base            = p-sum-base      + price-base-with-tax-sale  * v-gds-dtl-fact-qnty
     3027                   p-sum-rubl            = p-sum-rubl      + price-rubl-with-tax-sale  * v-gds-dtl-fact-qnty
     3028                   p-vat-base            = p-vat-base      + vat-base-sale             * v-gds-dtl-fact-qnty
     3029                   p-vat-rubl            = p-vat-rubl      + vat-rubl-sale             * v-gds-dtl-fact-qnty
     3030                   p-slt-base            = p-slt-base      + slt-base-sale             * v-gds-dtl-fact-qnty
     3031                   p-slt-rubl            = p-slt-rubl      + slt-rubl-sale             * v-gds-dtl-fact-qnty
     3032                   p-road-tax-base       = p-road-tax-base + road-tax-base-sale        * v-gds-dtl-fact-qnty
     3033                   p-road-tax-rubl       = p-road-tax-rubl + road-tax-rubl-sale        * v-gds-dtl-fact-qnty
     3034                   p-excise-base         = p-excise-base   + excise-base-sale          * v-gds-dtl-fact-qnty
     3035                   p-excise-rubl         = p-excise-rubl   + excise-rubl-sale          * v-gds-dtl-fact-qnty
     3036                   p-other-base          = p-other-base    + discnt-base-sale          * v-gds-dtl-fact-qnty
     3037                   p-other-rubl          = p-other-rubl    + discnt-rubl-sale          * v-gds-dtl-fact-qnty
     3038               .
     3039           end.
     3040       end.
     3041       assign
     3042           p-transport-base      = 0
     3043           p-transport-rubl      = 0
     3044           p-vat-pc              = buf_doc-line.vat-pc
     3045           p-slt-pc              = buf_doc-line.slt-pc
     3046       .
     3047     end.
     3048     if p-fact-qnty      = ?
     3049     or p-vat-pc         = ?
     3050     or p-slt-pc         = ?
     3051     or p-sum-base       = ?
     3052     or p-sum-rubl       = ?
     3053     or p-vat-base       = ?
     3054     or p-vat-rubl       = ?
     3055     or p-slt-base       = ?
     3056     or p-slt-rubl       = ?
     3057     or p-road-tax-base  = ?
     3058     or p-road-tax-rubl  = ?
     3059     or p-transport-base = ?
     3060     or p-transport-rubl = ?
     3061     or p-other-base     = ?
     3062     or p-other-rubl     = ?
     3063     or p-excise-base    = ?
     3064     or p-excise-rubl    = ?
     3065     then do:
     3066       message
     3067         vss-workfile vss-revision vss-description skip
     3068         vss-include-info5 skip
     3069         "Получены неопределенные значения" skip
     3070         "Документ" p-doc-code skip
     3071         "Артикул" p-artic p-prod-type p-prod-code skip
     3072         "fact-qnty     " p-fact-qnty      skip
     3073         "vat-pc        " p-vat-pc         skip
     3074         "slt-pc        " p-slt-pc         skip
     3075         "sum-base      " p-sum-base       skip
     3076         "sum-rubl      " p-sum-rubl       skip
     3077         "vat-base      " p-vat-base       skip
     3078         "vat-rubl      " p-vat-rubl       skip
     3079         "slt-base      " p-slt-base       skip
     3080         "slt-rubl      " p-slt-rubl       skip
     3081         "road-tax-base " p-road-tax-base  skip
     3082         "road-tax-rubl " p-road-tax-rubl  skip
     3083         "transport-base" p-transport-base skip
     3084         "transport-rubl" p-transport-rubl skip
     3085         "other-base    " p-other-base     skip
     3086         "other-rubl    " p-other-rubl     skip
     3087         "excise-base   " p-excise-base    skip
     3088         "excise-rubl   " p-excise-rubl    skip
     3089         view-as alert-box error .
     3090       undo, return error .
     3091     end.
     3092   end procedure.
     3093   define variable vss-include-info9 as character format "X(65)" no-undo
     3094   initial "@(#)$Workfile$ $Revision$".
     3095   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3096   procedure r-cost :
     3097     define input  parameter v-doc-code       like ub.doc-line.doc-code          no-undo .
     3098     define input  parameter v-artic          like ub.doc-line.artic             no-undo .
     3099     define input  parameter v-prod-type      like ub.doc-line.prod-type         no-undo .
     3100     define input  parameter v-prod-code      like ub.doc-line.prod-code         no-undo .
     3101     define output parameter v-fact-qnty      like ub.ot-line.fact-qnty       no-undo .
     3102     define output parameter v-vat-pc         like ub.doc-line.vat-pc         no-undo .
     3103     define output parameter v-slt-pc         like ub.doc-line.slt-pc         no-undo .
     3104     define output parameter v-sum-base       like ub.ot-line.sum-base        no-undo .
     3105     define output parameter v-sum-rubl       like ub.ot-line.sum-rubl        no-undo .
     3106     define output parameter v-vat-base       like ub.ot-line.vat-base        no-undo .
     3107     define output parameter v-vat-rubl       like ub.ot-line.vat-rubl        no-undo .
     3108     define output parameter v-slt-base       like ub.ot-line.slt-base        no-undo .
     3109     define output parameter v-slt-rubl       like ub.ot-line.slt-rubl        no-undo .
     3110     define output parameter v-road-tax-base  like ub.ot-line.road-tax-base   no-undo .
     3111     define output parameter v-road-tax-rubl  like ub.ot-line.road-tax-rubl   no-undo .
     3112     define output parameter v-transport-base like ub.ot-line.transport-base  no-undo .
     3113     define output parameter v-transport-rubl like ub.ot-line.transport-rubl  no-undo .
     3114     define output parameter v-other-base     like ub.ot-line.other-base      no-undo .
     3115     define output parameter v-other-rubl     like ub.ot-line.other-rubl      no-undo .
     3116     define output parameter v-excise-base    like ub.ot-line.excise-base     no-undo .
     3117     define output parameter v-excise-rubl    like ub.ot-line.excise-rubl     no-undo .
     3118     do
     3119     on error undo, return error
     3120     :
     3121       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     3122       define buffer   in-vatp-parts    for ub.parts   .
     3123       define buffer   in-vatp-doc      for ub.trn-doc .
     3124       define buffer   in-vatp-goods    for ub.goods   .
     3125       define buffer   in-vatp-sysconf  for ub.sysconf .
     3126       define buffer   in-vatp_doc-attr for ub.doc-attr.
     3127       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     3128       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     3129       define variable varinvprb                  as   character              no-undo.
     3130       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     3131       define variable cli-base-rate              as   decimal                no-undo.
     3132       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     3133       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     3134       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     3135       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     3136       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     3137       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     3138       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     3139       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     3140       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     3141       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     3142       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     3143       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     3144       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     3145       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     3146       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     3147       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     3148       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     3149       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     3150       define variable other-base-loc             like ub.doc-line.price-base no-undo.
