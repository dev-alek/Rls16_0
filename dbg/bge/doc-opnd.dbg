     2736       define variable exch-rate-cli-loco          like ub.trn-doc.exch-rate   no-undo.
     2737       define variable varinvatp-envdo             as   character              no-undo.
     2738       define variable varinvatp-typeo             as   character              no-undo.
     2739       define variable v-gds-dtl-fact-qnty as decimal no-undo .
     2740       define buffer buf_gds-dtl  for ub.gds-dtl .
     2741       define buffer buf_goods    for ub.goods .
     2742       define buffer buf_trn-doc  for ub.trn-doc .
     2743       define buffer buf_doc-line for ub.doc-line .
     2744       find first buf_doc-line no-lock
     2745         where buf_doc-line.doc-code  = p-doc-code
     2746           and buf_doc-line.artic     = p-artic
     2747           and buf_doc-line.prod-type = p-prod-type
     2748           and buf_doc-line.prod-code = p-prod-code
     2749         no-error .
     2750       if not available buf_doc-line then do:
     2751         message
