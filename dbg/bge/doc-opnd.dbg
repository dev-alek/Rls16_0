      981   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
      982                                             INPUT iFlagEmpty AS INTEGER).
      983       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
      984       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
      985           DO:
      986               IF iFlagEmpty = 0                           THEN RETURN "".
      987               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
      988               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
      989               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
      990               ELSE RETURN "".
      991           END.
      992       ELSE DO:
      993           run xmlchar-encode in this-procedure (
      994                 input sToPlace
      995               , output sToPlace
      996           ).
      997           ASSIGN
      998               sToPlace = sParName + '="' + sToPlace + '"'
      999           .
     1000           RETURN sToPlace.
     1001       END.
     1002   END FUNCTION.
     1003   function bge-xml-date returns character
     1004   ( input p-date as date )
     1005   :
     1006     define variable v-date-str as character no-undo .
     1007     run bge-xml-date-to-str in this-procedure ( input   p-date
     1008                                               , output  v-date-str
     1009                                               ) .
     1010     return v-date-str.
     1011   end function.
     1012   function bge-xml-str-date returns character
     1013   ( input p-date-str as character )
     1014   :
     1015     define variable v-date-str as character no-undo .
     1016     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1017                                                   , output  v-date-str
     1018                                                   ) .
     1019     return v-date-str.
     1020   end function.
     1021   function bge-xml-normalize-dec returns decimal
     1022   ( input p-val as decimal )
     1023   :
     1024     return (if p-val = ? then 0 else p-val) .
     1025   end function.
     1026   PROCEDURE wp-XMLTagOpen:
     1027   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1028   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1029   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1030       define variable v-out-string    as character    no-undo.
     1031   do
     1032   on error undo, return error
     1033   :
     1034       if v-bge-xml-bgefmt = "dbf":U
     1035       then do:
     1036       end.
     1037       else do:
     1038           assign
     1039               v-out-string = substitute( "&1&2<&3&4>"
     1040                                       , chr(10)
     1041                                       , fill( " ":U, 4 * iTagLevel)
     1042                                       , sTagName
     1043                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1044                               )
     1045           .
     1046           put stream stmXMLOut unformatted
     1047               v-out-string
     1048           .
     1049       end.
     1050   end.
     1051   END PROCEDURE.
     1052   PROCEDURE wp-XMLTagPut:
     1053     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1054     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1055     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1056     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1057       define variable v-out-string    as character    no-undo.
     1058   do
     1059   on error undo, return error
     1060   :
     1061       if v-bge-xml-bgefmt = "dbf":U
     1062       then do:
     1063           if v-bge-xml-dbf-file-name <> "":U
     1064           then do:
     1065               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1066               export stream stmXMLOut
     1067                   sTagName
     1068                   sParValue
     1069               .
     1070               output stream stmXMLOut close.
     1071           end.
     1072       end.
     1073       else do:
     1074           IF  iFlagEmpty = 1
     1075           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1076           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1077           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1078           THEN DO:
     1079               run xmlchar-encode in this-procedure (
     1080                   input sParValue
     1081                   , output sParValue
     1082               ).
     1083               assign
     1084                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1085                                               , chr(10)
     1086                                               , FILL(" ", 4 * iTagLevel)
     1087                                               , sTagName
     1088                                               , sParValue
     1089                               )
     1090               .
     1091               PUT STREAM stmXMLOut UNFORMATTED
     1092                   v-out-string
     1093               .
     1094           END.
     1095       end.
     1096   end.
     1097   END PROCEDURE.
     1098   PROCEDURE wp-XMLTagClose:
     1099   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1100   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1101       define variable v-out-string    as character    no-undo.
     1102   do
     1103   on error undo, return error
     1104   :
     1105       if v-bge-xml-bgefmt = "dbf":U
     1106       then do:
     1107       end.
     1108       else do:
     1109           assign
     1110               v-out-string = substitute( "&1&2</&3>"
     1111                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1112                                   , fill( " ", 4 * iTagLevel )
     1113                                   , sTagName
     1114                           )
     1115           .
     1116           PUT STREAM stmXMLOut UNFORMATTED
     1117               v-out-string
     1118           .
     1119       end.
     1120   end.
     1121   END PROCEDURE.
     1122   PROCEDURE wp-XMLWriteLog:
     1123     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1124     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1125     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1126   define variable v-str              as character no-undo .
     1127   define variable v-error-append     as logical   no-undo .
     1128   define variable v-error-append-msg as character no-undo .
     1129   assign
     1130     v-str = chr(10)
     1131             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1132             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1133     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1134     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1135     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1136   .
     1137   run bge/bge-log.p (input v-str) no-error .
     1138   if error-status:error then do:
     1139     assign
     1140       v-error-append     = yes
     1141       v-error-append-msg = return-value
     1142     .
     1143   end.
     1144   run gbl/fileapnd.p
     1145     ( input sFileName
     1146     , input v-str
     1147     , input 10
     1148     ) no-error .
     1149   if error-status:error then do:
     1150     assign
     1151       v-error-append     = yes
     1152       v-error-append-msg = substitute( "&1&2&3"
     1153                                       , v-error-append-msg
     1154                                       , chr(10)
     1155                                       , return-value
     1156                                       )
     1157     .
     1158   end.
     1159   if v-error-append
     1160   then do:
     1161     return error substitute( "&1" , v-error-append-msg ) .
     1162   end.
     1163   END PROCEDURE.
     1164   PROCEDURE wp-XMLWriteEDT:
     1165     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1166     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1167     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1168       if valid-handle ( hEDT )
     1169       then do:
     1170           hEDT :move-to-eof().
     1171           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1172                                           OR sToWrite = "&Line") THEN "" ELSE
     1173                                           cur-time-string-sec() + " ").
     1174           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1175                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1176                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1177           hEDT :insert-string(chr(10)).
     1178       end.
     1179       process events.
     1180       output to 'bgescn.txt' append.
     1181           put unformatted
     1182               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1183                                           OR sToWrite = "&Line") THEN "" ELSE
     1184                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1185               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1186                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1187                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1188           .
     1189       output close.
     1190   END PROCEDURE.
     1191   PROCEDURE wp-XMLShowCNT:
     1192     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1193       if valid-handle( hCNT )
     1194       then do:
     1195           ASSIGN hCNT :VISIBLE = TRUE.
     1196       end.
     1197   END PROCEDURE.
     1198   PROCEDURE wp-XMLHideCNT:
     1199     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1200       if valid-handle( hCNT )
     1201       then do:
     1202           ASSIGN hCNT :VISIBLE = FALSE.
     1203       end.
     1204   END PROCEDURE.
     1205   PROCEDURE wp-XMLWriteCNT:
     1206     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1207     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1208       if valid-handle( hCNT )
     1209       then do:
     1210           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1211       end.
     1212   END PROCEDURE.
     1213   procedure bge-xml-write-header:
     1214   do
     1215   on error undo, return error
     1216   :
     1217   define input parameter p-xml-file-name  as character        no-undo.
     1218   define input parameter p-doc-name       as character        no-undo.
     1219   define input parameter p-version        as character        no-undo.
     1220   define input parameter p-db-num         as integer          no-undo.
     1221   define input parameter p-date-from      as date             no-undo.
     1222   define input parameter p-shift-num-from as integer          no-undo.
     1223   define input parameter p-date-to        as date             no-undo.
     1224   define input parameter p-shift-num-to   as integer          no-undo.
     1225   define input parameter p-obj-list       as character        no-undo.
     1226   define input parameter p-doc-type-list  as character        no-undo.
     1227   define input parameter p-pay-code       as logical          no-undo.
     1228   define input parameter p-cst            as logical          no-undo.
     1229   define input parameter p-parts          as logical          no-undo.
     1230   define input parameter p-chk-pay-code   as logical          no-undo.
     1231   define input parameter p-pay-desk       as logical          no-undo.
     1232   define input parameter p-pay-desk-cards as logical          no-undo.
     1233   define input parameter p-deleted        as logical          no-undo.
     1234   define input parameter p-opened-docs    as logical          no-undo.
     1235   define variable v-out-string    as character    no-undo.
     1236   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1237   assign
     1238       v-out-string = substitute( "&1&2&3"
     1239                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1240                           , chr(10)
     1241                           , "<IBS_Trade_House>":U )
     1242   .
     1243   put stream stmXMLOut unformatted
     1244       v-out-string
     1245   .
     1246   run wp-XMLTagOpen(1, "header","").
     1247   if v-bge-xml-bgeflold = "oracle":u
     1248   then do:
     1249     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1250     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1251     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1252     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1253     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1254   end.
     1255   run wp-XMLTagOpen( 2, "manifest", "").
     1256   run wp-XMLTagOpen( 3, "document", "").
     1257   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1258   run wp-XMLTagput( 4, "description", "", 0).
     1259   run wp-XMLTagput( 4, "version", p-version, 0).
     1260   run wp-XMLTagclose( 3, "document" ).
     1261   run wp-XMLTagclose( 2, "manifest" ).
     1262   run wp-XMLTagclose( 1, "header" ).
     1263   run wp-XMLTagOpen(1, "options","").
     1264   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1265   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1266   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1267   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1268   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1269   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1270   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1271   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1272   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1273   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1274   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1275   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1276   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1277   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1278   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1279   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1280   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1281   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1282   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1283   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1284   run wp-XMLTagClose(1, "options").
     1285   run wp-XMLTagOpen( 1, "body", "" ).
     1286   output stream stmXMLOut close.
     1287   end.
     1288   end procedure.
     1289   procedure xml-bge-write-footer:
     1290   do
     1291   on error undo, return error return-value
     1292   :
     1293   define input parameter p-xml-file-name as character    no-undo.
     1294   define variable v-error-num     as integer           no-undo.
     1295   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1296   run wp-XMLTagClose( 1, "body" ).
     1297   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1298   output stream stmXMLOut close.
     1299   if v-bge-xml-bgeflold = "oracle":u
     1300   then do:
     1301     define variable v-tmp-file-name         as character no-undo .
     1302     define variable v-zip-file-name         as character no-undo .
     1303     define variable v-exch-file-name        as character no-undo .
     1304     define variable v-heap-file-name        as character no-undo .
     1305     define variable v-i                     as integer   no-undo .
     1306     define variable v-file-name             as character no-undo .
     1307     define variable v-arc                   as character no-undo .
     1308     define variable v-str                   as character no-undo .
     1309     define variable v-exch-tmp-file-name    as character no-undo .
     1310     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1311     define variable v-bge-xml-exch-dir      as character no-undo .
     1312     define variable v-bge-xml-heap-dir      as character no-undo .
     1313     define variable v-bge-xml-compress-heap as logical   no-undo .
     1314     define variable v-home-dir              as character no-undo .
     1315     define variable v-os-command            as character no-undo .
     1316     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1317     if v-home-dir = ?
     1318     then do:
     1319       undo, return error substitute( "&1&2&3"
     1320                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1321                                     , chr(10)
     1322                                     , "Обратитесь к администратору.":u
     1323                                     ).
     1324     end.
     1325     assign
     1326       v-home-dir = v-home-dir
     1327     .
     1328     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1329     if error-status :error
     1330     then do:
     1331       undo, return error substitute( "&1&2&3"
     1332                                     , "Неверно задан каталог экспорта.":u
     1333                                     , chr(10)
     1334                                     , "Обратитесь к администратору.":u
     1335                                     ).
     1336     end.
     1337     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1338     if v-bge-xml-exch-dir = ?
     1339     then do:
     1340       undo, return error substitute( "&1&2&3"
     1341                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1342                                     , chr(10)
     1343                                     , "Обратитесь к администратору.":u
     1344                                     ).
     1345     end.
     1346     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1347     if error-status :error
     1348     then do:
     1349       undo, return error substitute( "&1&2&3"
     1350                                     , "Неверно задан каталог экспорта (exch).":u
     1351                                     , chr(10)
     1352                                     , "Обратитесь к администратору.":u
     1353                                     ).
     1354     end.
     1355     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1356     if v-bge-xml-heap-dir = ?
     1357     then do:
     1358       undo, return error substitute( "&1&2&3"
     1359                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1360                                     , chr(10)
     1361                                     , "Обратитесь к администратору.":u
     1362                                     ).
     1363     end.
     1364     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1365     if error-status :error
     1366     then do:
     1367       undo, return error substitute( "&1&2&3"
     1368                                     , "Неверно задан каталог экспорта (heap).":u
     1369                                     , chr(10)
     1370                                     , "Обратитесь к администратору.":u
     1371                                     ).
     1372     end.
     1373     get-key-value section "BGE" key "heap-compress" value v-str.
     1374     assign
     1375       v-i = int(v-str)
     1376     no-error .
     1377     if v-i = ? or v-i = 0
     1378     then do:
     1379       assign
     1380         v-bge-xml-compress-heap = no
     1381       .
     1382     end.
     1383     else do:
     1384       assign
     1385         v-bge-xml-compress-heap = yes
     1386       .
     1387     end.
     1388     assign
     1389       v-arc = search( "exe/7za.exe":u )
     1390     .
     1391     if v-arc = ? or v-arc = ""
     1392     then do:
     1393       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     1394     end.
     1395     assign
     1396       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     1397       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     1398       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     1399       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     1400       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     1401       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     1402       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     1403     .
     1404     run gbl/del-file.p (input v-tmp-file-name) .
     1405     run gbl/del-file.p (input v-zip-file-name) .
     1406     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     1407     if v-error-num > 0
     1408     then do:
     1409         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     1410                                      , p-xml-file-name + "xm1":u
     1411                                      , v-tmp-file-name
     1412                                      , v-error-num
     1413                                      ).
     1414     end.
     1415     assign
     1416       v-os-command     = substitute( "&1 a -tzip &2 &3"
     1417                                    , v-arc
     1418                                    , v-zip-file-name
     1419                                    , v-tmp-file-name
     1420                                    )
     1421     .
     1422     os-command silent value ( v-os-command ) .
     1423     run gbl/del-file.p (input v-heap-file-name) .
     1424     if v-bge-xml-compress-heap = no
     1425     then do:
     1426       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     1427       if v-error-num > 0
     1428       then do:
     1429           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1430                                        , v-tmp-file-name
     1431                                        , v-heap-file-name
     1432                                        , v-error-num
     1433                                        ) .
     1434       end.
     1435     end.
     1436     else do:
     1437       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     1438       if v-error-num > 0
     1439       then do:
     1440           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1441                                        , v-zip-file-name
     1442                                        , v-heap-file-name
     1443                                        , v-error-num
     1444                                        ) .
     1445       end.
     1446     end.
     1447     run gbl/del-file.p (input v-tmp-file-name) .
     1448     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     1449     if error-status :error then do:
     1450       undo, return error substitute( "&1&2&3"
     1451                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     1452                                     , chr(10)
     1453                                     , "Обратитесь к администратору."
     1454                                     ).
     1455     end.
     1456     run gbl/del-file.p (input v-exch-file-name) .
     1457     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     1458     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     1459     if v-error-num > 0
     1460     then do:
     1461       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1462                                     , v-zip-file-name
     1463                                     , v-exch-tmp-file-name
     1464                                     , v-error-num
     1465                                     ) .
     1466     end.
     1467     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     1468     if v-error-num > 0
     1469     then do:
     1470       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1471                                     , v-exch-tmp-file-name
     1472                                     , v-exch-file-name
     1473                                     , v-error-num
     1474                                     ) .
     1475     end.
     1476     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     1477   end.
     1478   else do:
     1479     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1480     if v-error-num > 0
     1481     then do:
     1482       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1483                                     , p-xml-file-name + "xm1"
     1484                                     , p-xml-file-name + "xml"
     1485                                     , v-error-num
     1486                                     ) .
     1487     end.
     1488   end.
     1489   if opsys = "unix"
     1490   then do:
     1491       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1492   end.
     1493   end.
     1494   end procedure.
     1495   procedure xml-bge-filename0:
     1496   define input parameter p-prefix   as character no-undo .
     1497   define input parameter p-name     as character no-undo .
     1498   define input parameter p-shared-process as logical no-undo .
     1499   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     1500   define output parameter p-xml-file-name  as character no-undo .
     1501   // define output parameter p-fullfnamenoext as character no-undo .
     1502   define output parameter p-locked         as logical      no-undo.
     1503   define variable v-fullfnamenoext as character no-undo .
     1504   define variable v-fileext        as character no-undo .
     1505   define variable v-fullfname      as character no-undo .
     1506   define variable v-error-num      as integer   no-undo .
     1507   do
     1508   on error undo, return error
     1509   :
     1510     case v-bge-xml-bgeflold :
     1511       when "old" then do:
     1512         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     1513         v-fileext       = ".xml":U .
     1514         v-fullfname     = v-fullfnamenoext + v-fileext .
     1515         p-xml-file-name = v-fullfname .
     1516         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1517         if v-error-num > 0 then do:
     1518           return error.
     1519         end.
     1520       end.
     1521       when "var" then do:
     1522         case p-prefix :
     1523           when "doc" then do:
     1524             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     1525             v-fileext       = ".xml":U .
     1526             v-fullfname     = v-fullfnamenoext + v-fileext .
     1527             p-xml-file-name = v-fullfname .
     1528           end.
     1529           when "day" then do:
     1530             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     1531             v-fileext       = ".xml":U .
     1532             v-fullfname     = v-fullfnamenoext + v-fileext .
     1533             p-xml-file-name = v-fullfname .
     1534           end.
     1535           otherwise do:
     1536             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1537             v-fileext       = ".xml":U .
     1538             v-fullfname     = v-fullfnamenoext + v-fileext .
     1539             p-xml-file-name = v-fullfname .
     1540           end.
     1541         end case.
     1542         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1543         if v-error-num > 0 then do:
     1544           return error.
     1545         end.
     1546       end.
     1547       when "new" then do:
     1548                   run bge/genfname.p (
     1549                       input p-home-dir
     1550                       , input p-prefix
     1551                       , input ""
     1552                       , input "xml"
     1553                       , input ""
     1554                       , output p-xml-file-name
     1555                   ).
     1556       end.
     1557       when "no-parameter" then do:
     1558         if p-shared-process then do:
     1559                       run bge/genfname.p (
     1560                           input p-home-dir
     1561                           , input "d"
     1562                           , input ""
     1563                           , input "xml"
     1564                           , input ""
     1565                           , output p-xml-file-name
     1566                       ).
     1567         end.
     1568         else do:
     1569           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1570           v-fileext       = ".xml":U .
     1571           v-fullfname     = v-fullfnamenoext + v-fileext .
     1572           p-xml-file-name = v-fullfname .
     1573           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1574           if v-error-num > 0 then do:
     1575             return error.
     1576           end.
     1577         end.
     1578       end.
     1579     end case.
     1580     assign
     1581       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1582       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     1583     .
     1584   end .
     1585   end procedure .
     1586   procedure xml-bge-filename :
     1587   do
     1588   on error undo, return error
     1589   :
     1590   define input parameter p-prefix             as character    no-undo.
     1591   define input parameter p-name               as character    no-undo.
     1592   define input parameter p-shared-process     as logical      no-undo.
     1593   define output parameter p-xml-file-name     as character    no-undo.
     1594   define output parameter p-log-file-name     as character    no-undo.
     1595   define output parameter p-locked            as logical      no-undo.
     1596   define variable v-home-dir          as character no-undo .
     1597   define variable v-error-num         as integer   no-undo .
     1598   define variable v-bge-xml-heap-dir  as character no-undo .
     1599       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1600       if v-home-dir = ?
     1601       then do:
     1602           message
     1603             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1604             skip(1)
     1605             skip "Обратитесь к администратору."
     1606           view-as alert-box error.
     1607           undo, return error .
     1608       end.
     1609       if v-bge-xml-bgeflold <> "oracle"
     1610       then do:
     1611         assign
     1612             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     1613         .
     1614       end.
     1615       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1616       if error-status :error
     1617       then do:
     1618           message
     1619             skip "Неверно задан каталог экспорта."
     1620             skip(1)
     1621             skip "Обратитесь к администратору."
     1622           view-as alert-box error.
     1623           undo, return error .
     1624       end.
     1625       if v-bge-xml-bgefmt = "dbf":U
     1626       then do:
     1627           assign
     1628               p-xml-file-name = v-home-dir
     1629               p-locked        = no
     1630           .
     1631       end.
     1632       else do:
     1633           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     1634             output p-xml-file-name, output p-locked) .
     1635       end.
     1636       if v-bge-xml-bgeflold = "oracle"
     1637       then do:
     1638         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1639         if v-bge-xml-heap-dir = ?
     1640         then do:
     1641           undo, return error substitute( "&1&2&3"
     1642                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1643                                         , chr(10)
     1644                                         , "Обратитесь к администратору.":u
     1645                                         ).
     1646         end.
     1647         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1648         if error-status :error
     1649         then do:
     1650           undo, return error substitute( "&1&2&3"
     1651                                         , "Неверно задан каталог экспорта (heap).":u
     1652                                         , chr(10)
     1653                                         , "Обратитесь к администратору.":u
     1654                                         ).
     1655         end.
     1656         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     1657           assign
     1658             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     1659           .
     1660         end.
     1661         else do:
     1662           assign
     1663             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     1664           .
     1665         end.
     1666       end.
     1667       else do:
     1668         assign
     1669             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     1670         .
     1671       end.
     1672       assign
     1673          v-bge-xml-static-log-file-name = p-log-file-name
     1674       .
     1675   end.
     1676   end procedure.
     1677   procedure bge-xml-read-config :
     1678   do
     1679   on error undo, return error return-value
     1680   :
     1681   define input  parameter p-last-date as date      no-undo .
     1682   define input  parameter p-db-num    as integer   no-undo .
     1683       define variable v-bgeclall      as character     no-undo.
     1684       define variable v-bgedict       as character     no-undo.
     1685       define variable v-bgeshift      as character     no-undo.
     1686       define variable v-par-type      as character     no-undo.
     1687       define variable v-bgeflnm       as character     no-undo.
     1688       define variable v-bgecliiv      as character     no-undo .
     1689       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     1690       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     1691       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     1692       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     1693       define variable v-db-num-str    as character     no-undo .
     1694       define variable v-param-type      as character  no-undo .
     1695       define variable v-value-character as character  no-undo .
     1696       define variable v-value-date      as date       no-undo .
     1697       define variable v-value-decimal   as decimal    no-undo .
     1698       define variable v-value-integer   as integer    no-undo .
     1699       define variable v-value-logical   as logical    no-undo .
     1700       define variable v-tth             as handle      no-undo .
     1701       run adm/shattri.p ( input "get":U
     1702                         , input  '':u
     1703                         , input  0
     1704                         , input  'bge-export':U
     1705                         , input  'bgeclall':U
     1706                         , output v-bgecliiv
     1707                         , output v-value-date
     1708                         , output v-value-decimal
     1709                         , output v-value-integer
     1710                         , output v-value-logical
     1711                         , output v-param-type
     1712                         , input-output table-handle v-tth
     1713                         ) no-error .
     1714       if error-status :error
     1715       then do:
     1716         assign
     1717           v-bge-xml-bgecliiv = no
     1718         .
     1719       end.
     1720       else do:
     1721         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     1722       end.
     1723       delete object v-tth.
     1724       assign
     1725           v-bge-xml-bgeclall = no
     1726           v-bge-xml-bgedict  = no
     1727       .
     1728       run adm/shattri.p ( input "get":U
     1729                         , input  '':u
     1730                         , input  0
     1731                         , input  'bge-export':U
     1732                         , input  'bgeclall':U
     1733                         , output v-value-character
     1734                         , output v-value-date
     1735                         , output v-value-decimal
     1736                         , output v-value-integer
     1737                         , output v-value-logical
     1738                         , output v-param-type
     1739                         , input-output table-handle v-tth
     1740                         ) no-error .
     1741       if error-status :error
     1742       then do:
     1743         assign
     1744           v-bge-xml-bgeclall = no
     1745         .
     1746       end.
     1747       else do:
     1748         assign
     1749           v-bge-xml-bgeclall = v-value-logical
     1750         .
     1751       end.
     1752       delete object v-tth.
     1753       run adm/shattri.p ( input "get":U
     1754                         , input  '':u
     1755                         , input  0
     1756                         , input  'bge-export':U
     1757                         , input  'bgedict':U
     1758                         , output v-value-character
     1759                         , output v-value-date
     1760                         , output v-value-decimal
     1761                         , output v-value-integer
     1762                         , output v-value-logical
     1763                         , output v-param-type
     1764                         , input-output table-handle v-tth
     1765                         ) no-error .
     1766       if error-status :error
     1767       then do:
     1768         assign
     1769           v-bge-xml-bgedict = no
     1770         .
     1771       end.
     1772       else do:
     1773         assign
     1774           v-bge-xml-bgedict = v-value-logical
     1775         .
     1776       end.
     1777       delete object v-tth.
     1778       run adm/shattri.p ( input "get":U
     1779                         , input  '':u
     1780                         , input  0
     1781                         , input  'bge-export':U
     1782                         , input  'bgefmt':U
     1783                         , output v-value-character
     1784                         , output v-value-date
     1785                         , output v-value-decimal
     1786                         , output v-value-integer
     1787                         , output v-value-logical
     1788                         , output v-param-type
     1789                         , input-output table-handle v-tth
     1790                         ) no-error .
     1791       if error-status :error
     1792       then do:
     1793         assign
     1794           v-bge-xml-bgefmt  = "xml":U
     1795         .
     1796       end.
     1797       else do:
     1798         assign
     1799           v-bge-xml-bgefmt  = v-value-character
     1800         .
     1801       end.
     1802       delete object v-tth.
     1803       run adm/shattri.p ( input "get":U
     1804                         , input  '':u
     1805                         , input  0
     1806                         , input  'bge-export':U
     1807                         , input  'bgeshift':U
     1808                         , output v-value-character
     1809                         , output v-value-date
     1810                         , output v-value-decimal
     1811                         , output v-value-integer
     1812                         , output v-value-logical
     1813                         , output v-param-type
     1814                         , input-output table-handle v-tth
     1815                         ) no-error .
     1816       if error-status :error
     1817       then do:
     1818         assign
     1819             v-bge-xml-shift-mode = no
     1820         .
     1821       end.
     1822       else do:
     1823         assign
     1824             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     1825         .
     1826       end.
     1827       delete object v-tth.
     1828       run adm/shattri.p ( input "get":U
     1829                         , input  '':u
     1830                         , input  0
     1831                         , input  'bge-export':U
     1832                         , input  'bgeflold':U
     1833                         , output v-value-character
     1834                         , output v-value-date
     1835                         , output v-value-decimal
     1836                         , output v-value-integer
     1837                         , output v-value-logical
     1838                         , output v-param-type
     1839                         , input-output table-handle v-tth
     1840                         ) no-error .
     1841       if error-status :error
     1842       then do:
     1843         assign
     1844           v-bge-xml-bgeflold = "no-parameter":U
     1845         .
     1846       end.
     1847       else do:
     1848         assign
     1849           v-bge-xml-bgeflold  = v-value-character
     1850         .
     1851       end.
     1852       delete object v-tth.
     1853       assign
     1854         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     1855         v-bge-xml-db-num-str  = v-db-num-str
     1856       .
     1857       if p-last-date <> ?
     1858       then do:
     1859           run adm/shattri.p ( input "get":U
     1860                             , input  '':u
     1861                             , input  0
     1862                             , input  'bge-export':U
     1863                             , input  'bgeflnm':U
     1864                             , output v-value-character
     1865                             , output v-value-date
     1866                             , output v-value-decimal
     1867                             , output v-value-integer
     1868                             , output v-value-logical
     1869                             , output v-param-type
     1870                             , input-output table-handle v-tth
     1871                             ) no-error .
     1872           if error-status :error
     1873           then do:
     1874             assign
     1875               v-bgeflnm = '':U
     1876             .
     1877           end.
     1878           else do:
     1879             assign
     1880               v-bgeflnm = v-value-character
     1881             .
     1882           end.
     1883           delete object v-tth.
     1884           if v-bge-xml-bgeflold = "var"
     1885           then do:
     1886               if v-bgeflnm = ?
     1887               or num-entries( v-bgeflnm ) < 2
     1888               then do:
     1889                   assign
     1890                       v-bge-xml-bgeflold = "new"
     1891                   .
     1892               end.
     1893               else do:
     1894                   assign
     1895                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     1896                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     1897                   .
     1898                   assign
     1899                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     1900                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     1901                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1902                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     1903                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     1904                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     1905                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1906                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     1907                   .
     1908               end.
     1909           end.
     1910       end.
     1911   end.
     1912   end procedure.
     1913   procedure bge-xml-get-ref-filename :
     1914   define input parameter p-in-file-name       as character        no-undo.
     1915   define output parameter p-home-dir          as character        no-undo.
     1916   define output parameter p-out-file-name     as character        no-undo.
     1917   define output parameter p-locked            as logical          no-undo.
     1918       define variable v-counter       as integer      no-undo.
     1919       define variable v-error-level   as integer      no-undo.
     1920   do
     1921   on error undo, return error
     1922   :
     1923       run bge/bge-ini.p (
     1924             input "bge"
     1925           , output p-home-dir
     1926       ).
     1927       if return-value <> "OK"
     1928       then do:
     1929           undo, return error.
     1930       end.
     1931       assign
     1932           p-home-dir = p-home-dir + "\dict":U
     1933       .
     1934       run bge/dir_cd.p (
     1935           input p-home-dir
     1936           , input "CA"
     1937       ).
     1938       if return-value = "ERROR"
     1939       then do:
     1940           undo, return error.
     1941       end.
     1942       assign
     1943           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     1944       .
     1945       assign
     1946           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     1947       .
     1948       wait-lock:
     1949       do v-counter = 1 TO 3
     1950       :
     1951           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     1952           if p-locked = no
     1953           then do:
     1954               leave wait-lock.
     1955           end.
     1956           else do:
     1957               readkey pause 1.
     1958           end.
     1959       END.
     1960       if p-locked = yes
     1961       then do:
     1962           undo, return error.
     1963       end.
     1964       run bge/os_copy.p (
     1965             input "D":U
     1966           , input p-out-file-name + "xml":U
     1967           , input "":U
     1968           , output v-error-level
     1969       ).
     1970       if v-error-level > 0
     1971       then do:
     1972           undo, return error.
     1973       end.
     1974   end.
     1975   end procedure.
     1976   procedure bge-xml-write-ref-header :
     1977   define input parameter p-bge-name as character        no-undo.
     1978   define input parameter p-file-name as character        no-undo.
     1979       define variable v-out-string    as character    no-undo.
     1980   do
     1981   on error undo, return error
     1982   :
     1983       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     1984       put stream stmXMLOut unformatted
     1985           "<?xml version='1.0' encoding='windows-1251'?>":U
     1986       .
     1987       assign
     1988           v-out-string = substitute( "&1&2"
     1989                               , chr(10)
     1990                               , "<IBS_Trade_House>":U )
     1991       .
     1992       put stream stmXMLOut unformatted
     1993           v-out-string
     1994       .
     1995       run wp-XMLTagOpen( 1, "header", "" ).
     1996       if v-bge-xml-bgeflold = "oracle":u
     1997       then do:
     1998         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1999         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     2000         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     2001         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     2002         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     2003       end.
     2004       else do:
     2005         run wp-XMLTagOpen( 2, "delivery", "" ).
     2006         run wp-XMLTagOpen( 3, "to", "" ).
     2007         run wp-XMLTagClose( 3, "to" ).
     2008         run wp-XMLTagOpen( 3, "from", "" ).
     2009         run wp-XMLTagClose( 3, "from" ).
     2010         run wp-XMLTagClose( 2, "delivery" ).
     2011       end.
     2012       run wp-XMLTagOpen( 2, "manifest", "" ).
     2013       run wp-XMLTagOpen( 3, "document", "" ).
     2014       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2015       run wp-XMLTagPut( 4, "description", "", 0 ).
     2016       run wp-XMLTagClose( 3, "document" ).
     2017       run wp-XMLTagClose( 2, "manifest" ).
     2018       run wp-XMLTagClose( 1, "header" ).
     2019       run wp-XMLTagOpen( 1, "body", "" ).
     2020   end.
     2021   end procedure.
     2022   procedure bge-xml-write-ref-footer :
     2023   define input parameter p-file-name as character        no-undo.
     2024       define variable v-error-level   as integer      no-undo.
     2025   do
     2026   on error undo, return error
     2027   :
     2028       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2029       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2030       output stream stmXMLOut close.
     2031       run bge/os_copy.p (
     2032             input "M":U
     2033           , input p-file-name + "xm1":U
     2034           , input p-file-name + "xml":U
     2035           , output v-error-level
     2036       ).
     2037       if v-error-level > 0
     2038       then do:
     2039           undo, return error.
     2040       end.
     2041   end.
     2042   end procedure.
     2043   procedure bge-xml-out-dir :
     2044   define output parameter p-out-dir       as character    no-undo.
     2045   define output parameter p-log-file-name as character    no-undo.
     2046   do
     2047   on error undo, return error
     2048   :
     2049       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2050       if p-out-dir = ?
     2051       then do:
     2052           message
     2053             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2054                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2055             skip(1)
     2056             skip "Обратитесь к администратору."
     2057           view-as alert-box error.
     2058           undo, return error .
     2059       end.
     2060       if v-bge-xml-bgeflold <> "oracle" then assign
     2061         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2062       .
     2063       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2064       if error-status :error  then do:
     2065           run wp-XMLWriteLog in this-procedure (
     2066                 input p-log-file-name
     2067               , input 0
     2068               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2069                                   , p-out-dir
     2070                                   , return-value
     2071                                   , trim( error-status :get-message( 1 ) )
     2072                                   )
     2073           ).
     2074           undo, return error.
     2075       end.
     2076       assign
     2077           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2078           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2079       .
     2080   end.
     2081   end procedure.
     2082   procedure bge-xml-out-dir2 :
     2083   define output parameter p-out-dir       as character    no-undo.
     2084   define output parameter p-out-dirR      as character    no-undo.
     2085   define output parameter p-log-file-name as character    no-undo.
     2086   do
     2087   on error undo, return error
     2088   :
     2089       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2090       if p-out-dir = ?
     2091       then do:
     2092           message
     2093             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2094                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2095             skip(1)
     2096             skip "Обратитесь к администратору."
     2097           view-as alert-box error.
     2098           undo, return error .
     2099       end.
     2100       if v-bge-xml-bgeflold <> "oracle" then assign
     2101             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2102             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2103         .
     2104       else p-out-dirR = p-out-dir .
     2105       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2106       if error-status :error  then do:
     2107           run wp-XMLWriteLog in this-procedure (
     2108                 input p-log-file-name
     2109               , input 0
     2110               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2111                                   , p-out-dir
     2112                                   , return-value
     2113                                   , error-status :get-message( 1 )
     2114                                   )
     2115           ).
     2116           undo, return error.
     2117       end.
     2118       if p-out-dirR <> p-out-dir then do:
     2119         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2120         if error-status :error then do:
     2121           run wp-XMLWriteLog in this-procedure (
     2122                 input p-log-file-name
     2123               , input 0
     2124               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2125                                   , p-out-dirR
     2126                                   , return-value
     2127                                   , error-status :get-message( 1 )
     2128                                   )
     2129           ).
     2130           p-out-dirR = p-out-dir .
     2131         end.
     2132       end .
     2133       assign
     2134         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2135         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2136       .
     2137   end.
     2138   end procedure.
     2139   procedure bge-xml-out-file :
     2140   do
     2141   on error undo, return error
     2142   :
     2143   define input parameter p-out-dir            as character        no-undo.
     2144   define input parameter p-prefix             as character        no-undo.
     2145   define input parameter p-sheduled           as logical          no-undo.
     2146   define output parameter p-xml-file-name     as character        no-undo.
     2147   define output parameter p-locked            as logical          no-undo.
     2148   define variable v-home-dir      as character     no-undo.
     2149   define variable v-error-num     as integer       no-undo.
     2150   define variable v-today             as date         no-undo.
     2151   define variable v-time              as integer      no-undo.
     2152       if v-bge-xml-bgefmt = "dbf":U
     2153       then do:
     2154           assign
     2155               p-xml-file-name = p-out-dir
     2156               p-locked        = no
     2157           .
     2158       end.
     2159       else do:
     2160           if v-bge-xml-bgeflold = "firm":U
     2161           then do:
     2162               run bge/genfname.p (
     2163                     input p-out-dir
     2164                   , input p-prefix
     2165                   , input "":U
     2166                   , input "arj":U
     2167                   , input "":U
     2168                   , output p-xml-file-name
     2169               ).
     2170           end.
     2171           else do:
     2172               run bge/genfname.p (
     2173                     input p-out-dir
     2174                   , input p-prefix
     2175                   , input "":U
     2176                   , input "xml":U
     2177                   , input "":U
     2178                   , output p-xml-file-name
     2179               ).
     2180           end.
     2181           assign
     2182               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2183               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2184           .
     2185       end.
     2186   end.
     2187   end procedure.
     2188   procedure bge-xml-init-ext-doc-type :
     2189       define variable v-counter    as integer      no-undo.
     2190       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2191   do
     2192   for buf_temp_ext-doc-type
     2193   on error undo, return error
     2194   :
     2195       empty temp-table buf_temp_ext-doc-type.
     2196       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2197       :
     2198           create buf_temp_ext-doc-type.
     2199           assign
     2200               buf_temp_ext-doc-type.edt-key               = v-counter
     2201               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2202               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2203           .
     2204       end.
     2205   end.
     2206   end procedure.
     2207   procedure bge-xml-get-decimal-shift-num :
     2208   define input parameter p-shift-date     as date             no-undo.
     2209   define input parameter p-shift-num      as integer          no-undo.
     2210   define output parameter p-shift-decimal as decimal          no-undo.
     2211   do
     2212   on error undo, return error
     2213   :
     2214       assign
     2215           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2216       .
     2217   end.
     2218   end procedure.
     2219   procedure bge-xml-ora-exp-filename :
     2220     define input  parameter p-table-name  as character no-undo .
     2221     define input  parameter p-doc-code    as character no-undo .
     2222     define input  parameter p-obj-code    as integer   no-undo .
     2223     define output parameter p-filename    as character no-undo .
     2224     define output parameter p-seq-num     as integer   no-undo .
     2225     define variable v-ora-exp-seq     as integer   no-undo .
     2226     define variable v-ora-exp-seq-str as character no-undo .
     2227     define variable v-home-dir        as character no-undo.
     2228   do
     2229   on error undo, return error return-value
     2230   :
     2231     if v-bge-xml-bgeflold = "oracle":u
     2232     then do:
     2233       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2234       if v-home-dir = ?
     2235       then do:
     2236         undo, return error substitute( "&1&2&3":U
     2237                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2238                                       , chr(10)
     2239                                       , "Обратитесь к администратору.":U
     2240                                       ).
     2241       end.
     2242       assign
     2243           v-home-dir = v-home-dir
     2244       .
     2245       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2246       if error-status :error
     2247       then do:
     2248         undo, return error substitute( "&1&2&3":U
     2249                                       , "Неверно задан каталог экспорта.":U
     2250                                       , chr(10)
     2251                                       , "Обратитесь к администратору.":U
     2252                                       ).
     2253       end.
     2254       assign
     2255         v-ora-exp-seq = ?
     2256       .
     2257       if  p-table-name <> ? and
     2258           p-doc-code <> ?
     2259       then do:
     2260         run bge/get-oesq.p ( input p-table-name
     2261                            , input p-doc-code
     2262                            , output v-ora-exp-seq
     2263                            ) no-error .
     2264         if error-status :error = yes
     2265         then do:
     2266           undo, return error return-value .
     2267         end.
     2268       end.
     2269       if v-ora-exp-seq = ?
     2270       then do:
     2271         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2272         if error-status :error
     2273         then do:
     2274           undo, return error return-value .
     2275         end.
     2276       end.
     2277       if p-table-name <> ? and
     2278          p-doc-code   <> ?
     2279       then do:
     2280         run bge/oesqdoc.p ( input p-table-name
     2281                           , input p-doc-code
     2282                           , input v-ora-exp-seq
     2283                           ) no-error .
     2284         if error-status :error = yes
     2285         then do:
     2286           undo, return error return-value .
     2287         end.
     2288       end.
     2289       assign
     2290         p-seq-num  = v-ora-exp-seq
     2291         p-filename = substitute("&1/&2-000_&3."
     2292                                , v-home-dir
     2293                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2294                                , string(v-ora-exp-seq , "999999999")
     2295                                )
     2296       .
     2297     end.
     2298   end.
     2299   end procedure.
     2300   procedure bge-xml-date-to-str :
     2301     define input  parameter p-date  as date      no-undo .
     2302     define output parameter p-str   as character no-undo .
     2303   do
     2304   on error undo, return error return-value
     2305   :
     2306     if p-date <> ?
     2307     then do:
     2308       assign
     2309         p-str = substitute( "&1-&2-&3"
     2310                           , string( year(p-date)  , "9999")
     2311                           , string( month(p-date) , "99"  )
     2312                           , string( day(p-date)   , "99"  )
     2313                           )
     2314       .
     2315     end.
     2316     else do:
     2317       assign
     2318         p-str = ?
     2319       .
     2320     end.
     2321   end.
     2322   end procedure.
     2323   procedure bge-xml-date-str-to-str :
     2324     define input  parameter p-date-str  as character no-undo .
     2325     define output parameter p-str       as character no-undo .
     2326     define variable v-date          as date      no-undo .
     2327     define variable v-date-valid    as logical   no-undo .
     2328     define variable v-error-message as character no-undo .
     2329   do
     2330   on error undo, return error return-value
     2331   :
     2332     assign
     2333       p-str = ?
     2334     .
     2335     if p-date-str = ? or p-date-str = ""
     2336     then do:
     2337       return .
     2338     end.
     2339     run strtdate in this-procedure ( input  p-date-str
     2340                                    , output v-date
     2341                                    , output v-date-valid
     2342                                    , output v-error-message
     2343                                    ).
     2344     if v-date-valid <> true
     2345     then do:
     2346       return .
     2347     end.
     2348     assign
     2349       p-str = substitute( "&1-&2-&3"
     2350                         , string( year(v-date)  , "9999")
     2351                         , string( month(v-date) , "99"  )
     2352                         , string( day(v-date)   , "99"  )
     2353                         )
     2354     .
     2355   end.
     2356   end procedure.
     2357   procedure bge-xml-fill-tt-bgecliiv :
     2358     define input  parameter p-str as character no-undo .
     2359     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2360     define buffer buf_clients             for ub.clients.
     2361     define variable v-i         as integer   no-undo .
     2362     define variable v-count     as integer   no-undo .
     2363     define variable v-cli-count as integer   no-undo .
     2364     define variable v-client    as character no-undo .
     2365     define variable v-obj-type  as character no-undo .
     2366     define variable v-obj-code  as integer   no-undo .
     2367   do
     2368   on error undo, return error return-value
     2369   :
     2370     empty temp-table buf_tt-bge-xml-bgecliiv.
     2371     assign
     2372       v-bge-xml-bgecliiv = no
     2373       v-cli-count        = num-entries(p-str,';')
     2374     .
     2375     if v-cli-count > 0
     2376     then do:
     2377       _cli-cycle:
     2378       do v-i = 1 to v-cli-count
     2379       :
     2380         assign
     2381           v-client = entry(v-i , p-str, ';')
     2382         .
     2383         if num-entries(v-client) <> 2
     2384         then do:
     2385           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2386         end.
     2387         assign
     2388           v-obj-type = entry(1, v-client)
     2389         .
     2390         assign
     2391           v-obj-code = integer(entry(2, v-client))
     2392         no-error .
     2393         if error-status :error
     2394         then do:
     2395           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2396         end.
     2397         find first buf_clients no-lock
     2398           where buf_clients.obj-type = v-obj-type
     2399             and buf_clients.obj-code = v-obj-code
     2400         no-error.
     2401         if not available buf_clients
     2402         then do:
     2403           next _cli-cycle.
     2404         end.
     2405         find first buf_tt-bge-xml-bgecliiv no-lock
     2406           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2407             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2408         no-error .
     2409         if available buf_tt-bge-xml-bgecliiv
     2410         then do:
     2411           next _cli-cycle.
     2412         end.
     2413         create buf_tt-bge-xml-bgecliiv.
     2414         assign
     2415           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2416           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2417         .
     2418       end.
     2419     end.
     2420     else do:
     2421       assign
     2422         v-bge-xml-bgecliiv = no
     2423       .
     2424       return .
     2425     end.
     2426     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     2427     if available buf_tt-bge-xml-bgecliiv
     2428     then do:
     2429       assign
     2430         v-bge-xml-bgecliiv = yes
     2431       .
     2432     end.
     2433   end.
     2434   end procedure.
     2435   procedure bge-xml-resolve-ext-doc-type :
     2436     define input  parameter p-ext-doc-type      as character no-undo .
     2437     define input  parameter p-obj-type          as character no-undo .
     2438     define input  parameter p-obj-code          as integer   no-undo .
     2439     define output parameter p-out-ext-doc-type  as character no-undo .
     2440     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2441   do
     2442   on error undo, return error return-value
     2443   :
     2444     assign
     2445       p-out-ext-doc-type = p-ext-doc-type
     2446     .
     2447     if p-ext-doc-type <> 'ie':U
     2448     then do:
     2449       return .
     2450     end.
     2451     if v-bge-xml-bgecliiv = yes
     2452     then do:
     2453       find first buf_tt-bge-xml-bgecliiv no-lock
     2454         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     2455           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     2456       no-error .
     2457       if available buf_tt-bge-xml-bgecliiv
     2458       then do:
     2459         assign
     2460           p-out-ext-doc-type = 'iv':U
     2461         .
     2462       end.
     2463     end.
     2464   end.
     2465   end procedure.
     2466   procedure safe-wp-xmltagput :
     2467     define input  parameter pTagLevel   as integer   no-undo .
     2468     define input  parameter pTagName    as character no-undo .
     2469     define input  parameter pParValue   as character no-undo .
     2470     define input  parameter pFlagEmpty  as integer   no-undo .
     2471   do
     2472   on error undo, return error return-value
     2473   :
     2474     if v-bge-xml-bgeflold = "oracle":u
     2475     then do:
     2476       return .
     2477     end.
     2478     run wp-xmltagput in this-procedure ( input pTagLevel
     2479                                        , input pTagName
     2480                                        , input pParValue
     2481                                        , input pFlagEmpty
     2482                                        ).
     2483   end.
     2484   end procedure.
