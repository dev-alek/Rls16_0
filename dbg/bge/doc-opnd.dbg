      584   procedure xmlchar-decode :
      585   define input parameter p-in-string      as character        no-undo.
      586   define output parameter p-out-string    as character        no-undo.
      587       define variable v-position      as integer      no-undo.
      588       define variable v-last-position as integer      no-undo.
      589       define variable v-temp-integer  as integer      no-undo.
      590       define variable v-current-char  as character    no-undo.
      591       define variable v-next-char     as character    no-undo.
      592       define variable v-success       as logical      no-undo.
      593   do
      594   on error undo, return error
      595   :
      596       assign
      597           p-out-string = "":U
      598           v-position   = 0
      599       .
      600       replace-cycle:
      601       do while yes
      602       on error undo, return error
      603       :
      604           assign
      605               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      606           .
      607           if v-last-position <= v-position
      608           then do:
      609               if v-position = 0
      610               then do:
      611                   assign
      612                       p-out-string = p-in-string
      613                   .
      614               end.
      615               else do:
      616                   assign
      617                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      618                   .
      619               end.
      620               leave replace-cycle.
      621           end.
      622           else do:
      623               assign
      624                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      625                   v-position      = v-last-position
      626                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      627               .
      628               if v-current-char = "#":U
      629               then do:
      630                   assign
      631                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      632                   .
      633                   if v-last-position > 0
      634                   then do:
      635                       run xmlchar-read-integer in this-procedure
      636                        (
      637                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      638                           , output v-temp-integer
      639                           , output v-success
      640                       ).
      641                       if v-success = yes
      642                       and v-temp-integer >= 1
      643                       and v-temp-integer <= 255
      644                       then do:
      645                           assign
      646                               p-out-string = p-out-string + chr( v-temp-integer )
      647                               v-position   = v-last-position + 1
      648                           .
      649                       end.
      650                       else do:
      651                           assign
      652                               p-out-string = p-out-string + "&":U
      653                               v-position   = v-position   + 1
      654                           .
      655                       end.
      656                   end.
      657                   else do:
      658                       assign
      659                           p-out-string = p-out-string + "&":U
      660                           v-position   = v-position   + 1
      661                       .
      662                   end.
      663               end.
      664               else do:
      665                   case substring( p-in-string, v-position + 1, 3 )
      666                   :
      667                       when "lt;":U
      668                       then do:
      669                           assign
      670                               p-out-string = p-out-string + "<":U
      671                               v-position   = v-position   + 3
      672                           .
      673                       end.
      674                       when "gt;":U
      675                       then do:
      676                           assign
      677                               p-out-string = p-out-string + ">":U
      678                               v-position   = v-position   + 3
      679                           .
      680                       end.
      681                       otherwise do:
      682                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      683                           then do:
      684                               assign
      685                                   p-out-string = p-out-string + "&":U
      686                                   v-position   = v-position   + 4
      687                               .
      688                           end.
      689                           else do:
      690                               case substring( p-in-string, v-position + 1, 5 )
      691                               :
      692                                   when "quot;":U
      693                                   then do:
      694                                       assign
      695                                           p-out-string = p-out-string + '"':U
      696                                           v-position   = v-position   + 5
      697                                       .
      698                                   end.
      699                                   when "apos;":U
      700                                   then do:
      701                                       assign
      702                                           p-out-string = p-out-string + "'":U
      703                                           v-position   = v-position   + 5
      704                                       .
      705                                   end.
      706                                   otherwise do:
      707                                       assign
      708                                           p-out-string = p-out-string + "&":U
      709                                       .
      710                                   end.
      711                               end case.
      712                           end.
      713                       end.
      714                   end case.
      715               end.
      716           end.
      717       end.
      718   end.
      719   end .
      720   procedure xmlchar-read-integer :
      721   define input parameter p-input-string      as character        no-undo.
      722   define output parameter p-output-integer   as integer          no-undo.
      723   define output parameter p-success       as logical          no-undo.
      724   do
      725   on error undo, return error
      726   :
      727       assign
      728           p-output-integer = integer( p-input-string )
      729       no-error.
      730       if error-status :error
      731       then do:
      732           assign
      733               p-success           = no
      734               p-output-integer    = 0
      735           .
      736       end.
      737       else do:
      738           assign
      739               p-success           = yes
      740           .
      741       end.
      742   end.
      743   end.
      744   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      745   procedure strtdate :
      746     define input  parameter p-str         as character no-undo .
      747     define output parameter p-value       as date      no-undo .
      748     define output parameter p-data-valid  as logical   no-undo .
      749     define output parameter p-message     as character no-undo .
      750   do
      751   on error undo, return error return-value
      752   :
      753     define variable v-value       as date      no-undo .
      754     define variable v-i           as integer   no-undo .
      755     define variable v-num         as integer   no-undo .
      756     define variable v-delim       as character no-undo .
      757     define variable v-delim-list  as character no-undo .
      758     define variable v-day         as integer   no-undo .
      759     define variable v-month       as integer   no-undo .
      760     define variable v-year        as integer   no-undo .
      761     define variable v-day-str     as character no-undo .
      762     define variable v-month-str   as character no-undo .
      763     define variable v-year-str    as character no-undo .
      764     assign
      765       p-value       = ?
      766       p-data-valid  = false
      767     .
      768     if p-str = ?
      769     then do:
      770       assign
      771         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      772       .
      773       return .
      774     end.
      775     if p-str = ""
      776     then do:
      777       assign
      778         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      779       .
      780       return .
      781     end.
      782     if length(p-str)  > 10
      783     then do:
      784       assign
      785         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      786       .
      787       return .
      788     end.
      789     assign
      790       v-delim-list = '/,-,.':U
      791     .
      792     _delim:
      793     do v-i = 1 to num-entries( v-delim-list )
      794     :
      795       assign
      796         v-delim = entry( v-i , v-delim-list )
      797         v-num   = num-entries( p-str , v-delim )
      798       .
      799       if v-num <> 3
      800       then do:
      801         assign
      802           v-delim = ''
      803         .
      804       end.
      805       else do:
      806         leave _delim.
      807       end.
      808     end.
      809     if v-delim = ''
      810     then do:
      811       assign
      812         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      813       .
      814       return .
      815     end.
      816     assign
      817       v-day-str   = entry( 1, p-str , v-delim)
      818       v-month-str = entry( 2, p-str , v-delim)
      819       v-year-str  = entry( 3, p-str , v-delim)
      820     .
      821     if  length(v-day-str) > 2   or
      822         length(v-day-str) < 1   or
      823         length(v-month-str) > 2 or
      824         length(v-month-str) < 1 or
      825         (
      826           length(v-year-str) <> 2 and
      827           length(v-year-str) <> 4
      828         )
      829     then do:
      830       assign
      831         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      832       .
      833       return .
      834     end.
      835     if length( v-year-str ) = 2
      836     then do:
      837       assign
      838         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      839       .
      840     end.
      841     assign
      842       v-day   = integer( v-day-str )
      843       v-month = integer( v-month-str)
      844       v-year  = integer( v-year-str)
      845     no-error .
      846     if error-status :error
      847     then do:
      848       assign
      849         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      850       .
      851       return .
      852     end.
      853     if v-day < 1  or
      854        v-day > 31 or
      855        v-month < 1 or
      856        v-month > 12 or
      857        v-year < 0   or
      858        v-year > 5000
      859     then do:
      860       assign
      861         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      862       .
      863       return .
      864     end.
      865     assign
      866       v-value = date( v-month, v-day, v-year )
      867     no-error .
      868     if error-status :error
      869     then do:
      870       assign
      871         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      872       .
      873       return .
      874     end.
      875     assign
      876       p-value       = v-value
      877       p-data-valid  = true
      878     .
      879   end.
      880   end procedure.
      881   define variable v-bge-xml-bgecliiv      as logical  init no  no-undo.
      882   define variable v-bge-xml-bgeclall      as logical  init no  no-undo.
