        1   block-level on error undo, throw.
        2   define input parameter p-host-code       as integer                 no-undo.
        3   define input parameter p-obj-type        as character               no-undo.
        4   define input parameter p-obj-code        as integer                 no-undo.
        5   define input parameter p-cst             as logical                 no-undo.
        6   define input parameter p-parts           as logical                 no-undo.
        7   define input parameter sOutFile          as character               no-undo.
        8   define input parameter sLogFile          as character               no-undo.
        9   define input parameter p-parent-handle   as handle                  no-undo.
       10   define input parameter hEDT              as handle                  no-undo.
       11   define input parameter hCNT              as handle                  no-undo.
       12   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       13   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       14   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile: doc-opnd.p $":U .
       16   define variable vss-archive     as character no-undo init "$Archive: bge/doc-opnd.p $":U .
       17   define variable vss-description as character no-undo init "Экспорт не закрытых на факт документов прихода и расхода.".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define variable vss-include-info0 as character format "X(65)" no-undo
       79   initial "@(#)$Workfile$ $Revision$".
       80   DEF STREAM stmXMLOut.
       81   DEF STREAM stmXMLLog.
       82   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   procedure cur-time :
       84      define output parameter p-today as date      no-undo .
       85      define output parameter p-time  as integer   no-undo .
       86     do
       87     on error undo, return error
       88     :
       89       define variable v-date1 as date      no-undo .
       90       define variable v-date2 as date      no-undo .
       91       define variable v-time  as integer   no-undo .
       92       assign
       93         v-date1 = today
       94         v-time  = time
       95         v-date2 = today
       96       .
       97       if v-date1 <> v-date2
       98       then do:
       99         assign
      100           v-date1 = today
      101           v-time  = v-time
      102         .
      103       end.
      104       assign
      105         p-today = v-date1
      106         p-time  = v-time
      107       .
      108     end.
      109   end.
      110   function cur-time-date returns character
      111   :
      112     return string(today, '99/99/9999':U) .
      113   end.
      114   function cur-time-mjd returns decimal
      115   :
      116     define variable v-date as date      no-undo .
      117     define variable v-time as integer   no-undo .
      118     run cur-time in this-procedure
      119       (output v-date
      120       ,output v-time
      121       ) .
      122     return integer(v-date) - 2400002 + (v-time / 86400) .
      123   end.
      124   function cur-time-get-ending-index returns integer
      125   (input p-number as integer
      126   )
      127   :
      128     if p-number < 0
      129     or p-number = ?
      130     then do:
      131       return 1 .
      132     end.
      133     define variable v-rest as integer   no-undo .
      134     assign
      135       p-number = p-number modulo 100
      136     .
      137     if p-number < 20
      138     then do:
      139       assign
      140         v-rest = p-number
      141       .
      142     end.
      143     else do:
      144       assign
      145         v-rest = p-number modulo 10
      146       .
      147     end.
      148     case v-rest :
      149       when 1
      150       then do:
      151         return 2 .
      152       end.
      153       when 2 or
      154       when 3 or
      155       when 4
      156       then do:
      157         return 3 .
      158       end.
      159       otherwise do:
      160         return 1 .
      161       end.
      162     end case .
      163   end.
      164   procedure cur-time-mjd-to-date :
      165      define input  parameter i-mjd-diff as decimal no-undo.
      166      define output parameter o-Date     as date    no-undo.
      167      define output parameter o-Time     as integer no-undo.
      168      define variable v-day-number as integer   no-undo .
      169      if    i-mjd-diff < 0
      170         or i-mjd-diff = ?
      171      then do:
      172         return "?" .
      173      end.
      174      assign
      175         v-day-number = truncate(i-mjd-diff,0).
      176         o-Date = date(v-day-number + 2400002).
      177         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      178     .
      179   end.
      180   function cur-time-mjd-to-string returns character
      181   (input p-mjd-diff as decimal
      182   )
      183   :
      184     define variable v-day-number as integer   no-undo .
      185     define variable v-seconds    as integer   no-undo .
      186     define variable v-hour       as integer   no-undo .
      187     define variable v-min        as integer   no-undo .
      188     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      189     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      190     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      191     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      192     if p-mjd-diff < 0
      193     or p-mjd-diff = ?
      194     then do:
      195       return "?" .
      196     end.
      197     assign
      198       v-day-number = integer(truncate(p-mjd-diff,0))
      199       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      200     .
      201     if v-seconds > 86400
      202     then do:
      203       assign
      204         v-seconds = 86400 - 1
      205       .
      206     end.
      207     if v-seconds < 0
      208     then do:
      209       assign
      210         v-seconds = 0
      211       .
      212     end.
      213     assign
      214       v-hour = truncate(v-seconds / 3600, 0)
      215     .
      216     assign
      217       v-seconds = v-seconds modulo 3600
      218     .
      219     assign
      220       v-min = truncate(v-seconds / 60, 0)
      221     .
      222     assign
      223       v-seconds = v-seconds modulo 60
      224     .
      225     return
      226         (if v-day-number <> 0
      227           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      228           else ""
      229         )
      230       + (if v-day-number <> 0 or v-hour <> 0
      231           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      232           else ""
      233         )
      234       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      235           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      236           else ""
      237         )
      238       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      239       .
      240   end.
      241   function cur-time-string returns character
      242   :
      243     define variable v-date as date      no-undo .
      244     define variable v-time as integer   no-undo .
      245     run cur-time in this-procedure
      246       (output v-date
      247       ,output v-time
      248       ) .
      249     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      250   end.
      251   function cur-time-string-sec returns character
      252   :
      253     define variable v-date as date      no-undo .
      254     define variable v-time as integer   no-undo .
      255     run cur-time in this-procedure
      256       (output v-date
      257       ,output v-time
      258       ) .
      259     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      260   end.
      261   function cur-time-custom  returns character
      262   (input p-prefix as character
      263   ,input p-date-format as character
      264   ,input p-delimiter as character
      265   ,input p-time-format as character
      266   ,input p-suffix as character
      267   )
      268   :
      269     define variable v-date as date      no-undo .
      270     define variable v-time as integer   no-undo .
      271     run cur-time in this-procedure
      272       (output v-date
      273       ,output v-time
      274       ) .
      275     return
      276       p-prefix
      277       + string(v-date, p-date-format)
      278       + p-delimiter
      279       + string(v-time, p-time-format)
      280       + p-suffix
      281       .
      282   end.
      283   function cur-time-print  returns character
      284   :
      285     define variable v-date as date      no-undo .
      286     define variable v-time as integer   no-undo .
      287     run cur-time in this-procedure
      288       (output v-date
      289       ,output v-time
      290       ) .
      291     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      292   end.
      293   function cur-time-datetime returns datetime
      294   :
      295     define variable v-char as character no-undo .
      296     define variable v-datetime as datetime no-undo .
      297     v-char = cur-time-string().
      298     v-datetime = datetime(v-char).
      299     return  v-datetime.
      300   end.
      301   function cur-time-string-msec returns character
      302   :
      303     define variable v-date as datetime  no-undo .
      304     v-date = now.
      305     return string(v-date) .
      306   end.
      307   define variable vss-include-info2 as character format "X(65)" no-undo
      308   initial "@(#)$Workfile$ $Revision$".
      309   procedure xmlchar-test :
      310   define input parameter p-in-string          as character        no-undo.
      311   define output parameter p-out-string-enc    as character        no-undo.
      312   define output parameter p-out-string-dec    as character        no-undo.
      313   do
      314   on error undo, return error
      315   :
      316          run xmlchar-encode in this-procedure
      317       (
      318             input p-in-string
      319           , output p-out-string-enc
      320       ).
      321          run xmlchar-decode in this-procedure
      322       (
      323             input p-out-string-enc
      324           , output p-out-string-dec
      325       ).
      326   end.
      327   end .
      328   procedure xmlchar-encode :
      329   define input parameter p-in-string      as character        no-undo.
      330   define output parameter p-out-string    as character        no-undo.
      331       define variable v-position      as integer      no-undo.
      332       define variable v-current-char  as character    no-undo.
      333   do
      334   on error undo, return error
      335   :
      336       assign
      337           p-out-string = "":U
      338       .
      339       case p-in-string
      340       :
      341           when ?
      342           then do:
      343               assign
      344                   p-out-string = "?":U
      345               .
      346           end.
      347           when "?":U
      348           then do:
      349               assign
      350                   p-out-string = "&#63;":U
      351               .
      352           end.
      353           otherwise do:
      354               do v-position = 1 to length( p-in-string )
      355               :
      356                   assign
      357                       v-current-char = substring( p-in-string, v-position, 1 )
      358                   .
      359                   case v-current-char
      360                   :
      361                       when "&":U
      362                       then do:
      363                           assign
      364                               p-out-string = p-out-string + "&amp;":U
      365                           .
      366                       end.
      367                       when ">":U
      368                       then do:
      369                           assign
      370                               p-out-string = p-out-string + "&gt;":U
      371                           .
      372                       end.
      373                       when "<":U
      374                       then do:
      375                           assign
      376                               p-out-string = p-out-string + "&lt;":U
      377                           .
      378                       end.
      379                       when "'":U
      380                       then do:
      381                           assign
      382                               p-out-string = p-out-string + "&apos;":U
      383                           .
      384                       end.
      385                       when '"':U
      386                       then do:
      387                           assign
      388                               p-out-string = p-out-string + "&quot;":U
      389                           .
      390                       end.
      391                       when chr(1)
      392                       then do:
      393                           assign
      394                               p-out-string = p-out-string + "":U
      395                           .
      396                       end.
      397                       when chr(2)
      398                       then do:
      399                           assign
      400                               p-out-string = p-out-string + "":U
      401                           .
      402                       end.
      403                       when chr(3)
      404                       then do:
      405                           assign
      406                               p-out-string = p-out-string + "":U
      407                           .
      408                       end.
      409                       when chr(4)
      410                       then do:
      411                           assign
      412                               p-out-string = p-out-string + "":U
      413                           .
      414                       end.
      415                       when chr(5)
      416                       then do:
      417                           assign
      418                               p-out-string = p-out-string + "":U
      419                           .
      420                       end.
      421                       when chr(6)
      422                       then do:
      423                           assign
      424                               p-out-string = p-out-string + "":U
      425                           .
      426                       end.
      427                       when chr(7)
      428                       then do:
      429                           assign
      430                               p-out-string = p-out-string + "":U
      431                           .
      432                       end.
      433                       when chr(8)
      434                       then do:
      435                           assign
      436                               p-out-string = p-out-string + "":U
      437                           .
      438                       end.
      439                       when chr(9)
      440                       then do:
      441                           assign
      442                               p-out-string = p-out-string + "":U
      443                           .
      444                       end.
      445                       when chr(29)
      446                       then do:
      447                           assign
      448                               p-out-string = p-out-string + "":U
      449                           .
      450                       end.
      451                       when chr(10)
      452                       then do:
      453                           assign
      454                               p-out-string = p-out-string + "&#10;":U
      455                           .
      456                       end.
      457                       when chr(13)
      458                       then do:
      459                           assign
      460                               p-out-string = p-out-string + "&#13;":U
      461                           .
      462                       end.
      463                       otherwise do:
      464                           assign
      465                               p-out-string = p-out-string + v-current-char
      466                           .
      467                       end.
      468                   end case.
      469               end.
      470           end.
      471       end case.
      472   end.
      473   end .
      474   procedure xmlchar-encode-1c :
