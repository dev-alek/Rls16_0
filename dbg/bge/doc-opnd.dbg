     2753           vss-include-info5 skip
     2754           "Ошибка задания входных параметров" skip
     2755           "Не найдена строка документа" skip
     2756           "Документ" p-doc-code skip
     2757           "Артикул" p-artic p-prod-type p-prod-code skip
     2758           view-as alert-box error .
     2759         undo, return error .
     2760       end.
     2761       find first buf_trn-doc no-lock
     2762         where buf_trn-doc.doc-code = buf_doc-line.doc-code
     2763         no-error .
     2764       if not available buf_trn-doc then do:
     2765         message
     2766           vss-workfile vss-revision vss-description skip
     2767           vss-include-info5 skip
     2768           "Не найден документ" skip
     2769           "Документ" p-doc-code skip
     2770           "Артикул" p-artic p-prod-type p-prod-code skip
     2771           view-as alert-box error .
     2772         undo, return error .
     2773       end.
     2774       for each buf_gds-dtl no-lock
     2775         where buf_gds-dtl.doc-code  = buf_doc-line.doc-code
     2776           and buf_gds-dtl.artic     = buf_doc-line.artic
     2777           and buf_gds-dtl.prod-type = buf_doc-line.prod-type
     2778           and buf_gds-dtl.prod-code = buf_doc-line.prod-code
     2779       on error undo, return error
     2780       :
     2781           if buf_trn-doc.doc-type <> 'инв':U
     2782           then do:
     2783               if buf_trn-doc.doc-type = 'при':U
     2784               or buf_trn-doc.doc-type = 'возврат':U
     2785               then do:
     2786                   assign
     2787                       v-gds-dtl-fact-qnty = buf_gds-dtl.fact-qnty
     2788                   .
     2789               end.
     2790               else do:
     2791                   assign
     2792                       v-gds-dtl-fact-qnty = - buf_gds-dtl.fact-qnty
     2793                   .
     2794               end.
     2795           end.
     2796           else do:
     2797               assign
     2798                   v-gds-dtl-fact-qnty = buf_gds-dtl.doc-qnty
     2799               .
     2800           end.
     2801           if v-gds-dtl-fact-qnty <> 0
     2802           then do:
     2803   if buf_trn-doc.ext-doc-type = 'ot':U or
     2804      buf_trn-doc.ext-doc-type = ?                 then do:
     2805     assign
     2806      out-vatp-have-vat-slt = yes.
     2807   end.
     2808   else do:
     2809     find first out-vatp_doc-attr no-lock
     2810       where out-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     2811         and out-vatp_doc-attr.attr-code = 'envd':U
     2812         no-error .
     2813     if not available out-vatp_doc-attr then do:
     2814       assign
     2815         out-vatp-have-vat-slt = yes.
     2816     end.
     2817     else do:
     2818        out-vatp-have-vat-slt = no.
     2819     end.
     2820   end.
     2821   find first out-vatp_goods where out-vatp_goods.artic     = buf_doc-line.artic     and
     2822                                      out-vatp_goods.prod-type = buf_doc-line.prod-type and
     2823                                      out-vatp_goods.prod-code = buf_doc-line.prod-code no-lock.
     2824   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2825   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     2826     (input  buf_doc-line.artic
