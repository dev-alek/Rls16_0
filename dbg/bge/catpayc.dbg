        1   block-level on error undo, throw.
        2   define input parameter p-host-code          as integer      no-undo.
        3   define input parameter p-rec-amount         as integer      no-undo.
        4   define input parameter p-rec-code-list      as character    no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision: 2d6430604525, 1301, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
        7   define variable vss-date        as character no-undo init "$Date: Tue Apr 10 12:04:11 2018 +0300 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: catpayc.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: bge/catpayc.p $":U .
       10   define variable vss-description as character no-undo init "Выгрузка справочника типов кассовых платежей".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define variable vss-include-info0 as character format "X(65)" no-undo
       70   initial "@(#)$Workfile$ $Revision$".
       71   define variable v-bgelib-bgefmt        as character         no-undo.
       72   define variable v-bgelib-bgeflold      as character         no-undo.
       73   define stream stmXMLOut.
       74   define stream stmXMLLog.
       75   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   procedure cur-time :
       77      define output parameter p-today as date      no-undo .
       78      define output parameter p-time  as integer   no-undo .
       79     do
       80     on error undo, return error
       81     :
       82       define variable v-date1 as date      no-undo .
       83       define variable v-date2 as date      no-undo .
       84       define variable v-time  as integer   no-undo .
       85       assign
       86         v-date1 = today
       87         v-time  = time
       88         v-date2 = today
       89       .
       90       if v-date1 <> v-date2
       91       then do:
       92         assign
       93           v-date1 = today
       94           v-time  = v-time
       95         .
       96       end.
       97       assign
       98         p-today = v-date1
       99         p-time  = v-time
      100       .
      101     end.
      102   end.
      103   function cur-time-date returns character
      104   :
      105     return string(today, '99/99/9999':U) .
      106   end.
      107   function cur-time-mjd returns decimal
      108   :
      109     define variable v-date as date      no-undo .
      110     define variable v-time as integer   no-undo .
      111     run cur-time in this-procedure
      112       (output v-date
      113       ,output v-time
      114       ) .
      115     return integer(v-date) - 2400002 + (v-time / 86400) .
      116   end.
      117   function cur-time-get-ending-index returns integer
      118   (input p-number as integer
      119   )
      120   :
      121     if p-number < 0
      122     or p-number = ?
      123     then do:
      124       return 1 .
      125     end.
      126     define variable v-rest as integer   no-undo .
      127     assign
      128       p-number = p-number modulo 100
      129     .
      130     if p-number < 20
      131     then do:
      132       assign
      133         v-rest = p-number
      134       .
      135     end.
      136     else do:
      137       assign
      138         v-rest = p-number modulo 10
      139       .
      140     end.
      141     case v-rest :
      142       when 1
      143       then do:
      144         return 2 .
      145       end.
      146       when 2 or
      147       when 3 or
      148       when 4
      149       then do:
      150         return 3 .
      151       end.
      152       otherwise do:
      153         return 1 .
      154       end.
      155     end case .
      156   end.
      157   procedure cur-time-mjd-to-date :
      158      define input  parameter i-mjd-diff as decimal no-undo.
      159      define output parameter o-Date     as date    no-undo.
      160      define output parameter o-Time     as integer no-undo.
      161      define variable v-day-number as integer   no-undo .
      162      if    i-mjd-diff < 0
      163         or i-mjd-diff = ?
      164      then do:
      165         return "?" .
      166      end.
      167      assign
      168         v-day-number = truncate(i-mjd-diff,0).
      169         o-Date = date(v-day-number + 2400002).
      170         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      171     .
      172   end.
      173   function cur-time-mjd-to-string returns character
      174   (input p-mjd-diff as decimal
      175   )
      176   :
      177     define variable v-day-number as integer   no-undo .
      178     define variable v-seconds    as integer   no-undo .
      179     define variable v-hour       as integer   no-undo .
      180     define variable v-min        as integer   no-undo .
      181     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      182     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      183     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      184     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      185     if p-mjd-diff < 0
      186     or p-mjd-diff = ?
      187     then do:
      188       return "?" .
      189     end.
      190     assign
      191       v-day-number = integer(truncate(p-mjd-diff,0))
      192       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      193     .
      194     if v-seconds > 86400
      195     then do:
      196       assign
      197         v-seconds = 86400 - 1
      198       .
      199     end.
      200     if v-seconds < 0
      201     then do:
      202       assign
      203         v-seconds = 0
      204       .
      205     end.
      206     assign
      207       v-hour = truncate(v-seconds / 3600, 0)
      208     .
      209     assign
      210       v-seconds = v-seconds modulo 3600
      211     .
      212     assign
      213       v-min = truncate(v-seconds / 60, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 60
      217     .
      218     return
      219         (if v-day-number <> 0
      220           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      221           else ""
      222         )
      223       + (if v-day-number <> 0 or v-hour <> 0
      224           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      225           else ""
      226         )
      227       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      228           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      229           else ""
      230         )
      231       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      232       .
      233   end.
      234   function cur-time-string returns character
      235   :
      236     define variable v-date as date      no-undo .
      237     define variable v-time as integer   no-undo .
      238     run cur-time in this-procedure
      239       (output v-date
      240       ,output v-time
      241       ) .
      242     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      243   end.
      244   function cur-time-string-sec returns character
      245   :
      246     define variable v-date as date      no-undo .
      247     define variable v-time as integer   no-undo .
      248     run cur-time in this-procedure
      249       (output v-date
      250       ,output v-time
      251       ) .
      252     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      253   end.
      254   function cur-time-custom  returns character
      255   (input p-prefix as character
      256   ,input p-date-format as character
      257   ,input p-delimiter as character
      258   ,input p-time-format as character
      259   ,input p-suffix as character
      260   )
      261   :
      262     define variable v-date as date      no-undo .
      263     define variable v-time as integer   no-undo .
      264     run cur-time in this-procedure
      265       (output v-date
      266       ,output v-time
      267       ) .
      268     return
      269       p-prefix
      270       + string(v-date, p-date-format)
      271       + p-delimiter
      272       + string(v-time, p-time-format)
      273       + p-suffix
      274       .
      275   end.
      276   function cur-time-print  returns character
      277   :
      278     define variable v-date as date      no-undo .
      279     define variable v-time as integer   no-undo .
      280     run cur-time in this-procedure
      281       (output v-date
      282       ,output v-time
      283       ) .
      284     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      285   end.
      286   function cur-time-datetime returns datetime
      287   :
      288     define variable v-char as character no-undo .
      289     define variable v-datetime as datetime no-undo .
      290     v-char = cur-time-string().
      291     v-datetime = datetime(v-char).
      292     return  v-datetime.
      293   end.
      294   function cur-time-string-msec returns character
      295   :
      296     define variable v-date as datetime  no-undo .
      297     v-date = now.
      298     return string(v-date) .
      299   end.
      300   define variable vss-include-info2 as character format "X(65)" no-undo
      301   initial "@(#)$Workfile$ $Revision$".
      302   procedure xmlchar-test :
      303   define input parameter p-in-string          as character        no-undo.
      304   define output parameter p-out-string-enc    as character        no-undo.
      305   define output parameter p-out-string-dec    as character        no-undo.
      306   do
      307   on error undo, return error
      308   :
      309          run xmlchar-encode in this-procedure
      310       (
      311             input p-in-string
      312           , output p-out-string-enc
      313       ).
      314          run xmlchar-decode in this-procedure
      315       (
      316             input p-out-string-enc
      317           , output p-out-string-dec
      318       ).
      319   end.
      320   end .
      321   procedure xmlchar-encode :
      322   define input parameter p-in-string      as character        no-undo.
      323   define output parameter p-out-string    as character        no-undo.
      324       define variable v-position      as integer      no-undo.
      325       define variable v-current-char  as character    no-undo.
      326   do
      327   on error undo, return error
      328   :
      329       assign
      330           p-out-string = "":U
      331       .
      332       case p-in-string
      333       :
      334           when ?
      335           then do:
      336               assign
      337                   p-out-string = "?":U
      338               .
      339           end.
      340           when "?":U
      341           then do:
      342               assign
      343                   p-out-string = "&#63;":U
      344               .
      345           end.
      346           otherwise do:
      347               do v-position = 1 to length( p-in-string )
      348               :
      349                   assign
      350                       v-current-char = substring( p-in-string, v-position, 1 )
      351                   .
      352                   case v-current-char
      353                   :
      354                       when "&":U
      355                       then do:
      356                           assign
      357                               p-out-string = p-out-string + "&amp;":U
      358                           .
      359                       end.
      360                       when ">":U
      361                       then do:
      362                           assign
      363                               p-out-string = p-out-string + "&gt;":U
      364                           .
      365                       end.
      366                       when "<":U
      367                       then do:
      368                           assign
      369                               p-out-string = p-out-string + "&lt;":U
      370                           .
      371                       end.
      372                       when "'":U
      373                       then do:
      374                           assign
      375                               p-out-string = p-out-string + "&apos;":U
      376                           .
      377                       end.
      378                       when '"':U
      379                       then do:
      380                           assign
      381                               p-out-string = p-out-string + "&quot;":U
      382                           .
      383                       end.
      384                       when chr(1)
      385                       then do:
      386                           assign
      387                               p-out-string = p-out-string + "":U
      388                           .
      389                       end.
      390                       when chr(2)
      391                       then do:
      392                           assign
      393                               p-out-string = p-out-string + "":U
      394                           .
      395                       end.
      396                       when chr(3)
      397                       then do:
      398                           assign
      399                               p-out-string = p-out-string + "":U
      400                           .
      401                       end.
      402                       when chr(4)
      403                       then do:
      404                           assign
      405                               p-out-string = p-out-string + "":U
      406                           .
      407                       end.
      408                       when chr(5)
      409                       then do:
      410                           assign
      411                               p-out-string = p-out-string + "":U
      412                           .
      413                       end.
      414                       when chr(6)
      415                       then do:
      416                           assign
      417                               p-out-string = p-out-string + "":U
      418                           .
      419                       end.
      420                       when chr(7)
      421                       then do:
      422                           assign
      423                               p-out-string = p-out-string + "":U
      424                           .
      425                       end.
      426                       when chr(8)
      427                       then do:
      428                           assign
      429                               p-out-string = p-out-string + "":U
      430                           .
      431                       end.
      432                       when chr(9)
      433                       then do:
      434                           assign
      435                               p-out-string = p-out-string + "":U
      436                           .
      437                       end.
      438                       when chr(29)
      439                       then do:
      440                           assign
      441                               p-out-string = p-out-string + "":U
      442                           .
      443                       end.
      444                       when chr(10)
      445                       then do:
      446                           assign
      447                               p-out-string = p-out-string + "&#10;":U
      448                           .
      449                       end.
      450                       when chr(13)
      451                       then do:
      452                           assign
      453                               p-out-string = p-out-string + "&#13;":U
      454                           .
      455                       end.
      456                       otherwise do:
      457                           assign
      458                               p-out-string = p-out-string + v-current-char
      459                           .
      460                       end.
      461                   end case.
      462               end.
      463           end.
      464       end case.
      465   end.
      466   end .
      467   procedure xmlchar-encode-1c :
