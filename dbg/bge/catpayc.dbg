      577   procedure xmlchar-decode :
      578   define input parameter p-in-string      as character        no-undo.
      579   define output parameter p-out-string    as character        no-undo.
      580       define variable v-position      as integer      no-undo.
      581       define variable v-last-position as integer      no-undo.
      582       define variable v-temp-integer  as integer      no-undo.
      583       define variable v-current-char  as character    no-undo.
      584       define variable v-next-char     as character    no-undo.
      585       define variable v-success       as logical      no-undo.
      586   do
      587   on error undo, return error
      588   :
      589       assign
      590           p-out-string = "":U
      591           v-position   = 0
      592       .
      593       replace-cycle:
      594       do while yes
      595       on error undo, return error
      596       :
      597           assign
      598               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      599           .
      600           if v-last-position <= v-position
      601           then do:
      602               if v-position = 0
      603               then do:
      604                   assign
      605                       p-out-string = p-in-string
      606                   .
      607               end.
      608               else do:
      609                   assign
      610                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      611                   .
      612               end.
      613               leave replace-cycle.
      614           end.
      615           else do:
      616               assign
      617                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      618                   v-position      = v-last-position
      619                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      620               .
      621               if v-current-char = "#":U
      622               then do:
      623                   assign
      624                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      625                   .
      626                   if v-last-position > 0
      627                   then do:
      628                       run xmlchar-read-integer in this-procedure
      629                        (
      630                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      631                           , output v-temp-integer
      632                           , output v-success
      633                       ).
      634                       if v-success = yes
      635                       and v-temp-integer >= 1
      636                       and v-temp-integer <= 255
      637                       then do:
      638                           assign
      639                               p-out-string = p-out-string + chr( v-temp-integer )
      640                               v-position   = v-last-position + 1
      641                           .
      642                       end.
      643                       else do:
      644                           assign
      645                               p-out-string = p-out-string + "&":U
      646                               v-position   = v-position   + 1
      647                           .
      648                       end.
      649                   end.
      650                   else do:
      651                       assign
      652                           p-out-string = p-out-string + "&":U
      653                           v-position   = v-position   + 1
      654                       .
      655                   end.
      656               end.
      657               else do:
      658                   case substring( p-in-string, v-position + 1, 3 )
      659                   :
      660                       when "lt;":U
      661                       then do:
      662                           assign
      663                               p-out-string = p-out-string + "<":U
      664                               v-position   = v-position   + 3
      665                           .
      666                       end.
      667                       when "gt;":U
      668                       then do:
      669                           assign
      670                               p-out-string = p-out-string + ">":U
      671                               v-position   = v-position   + 3
      672                           .
      673                       end.
      674                       otherwise do:
      675                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      676                           then do:
      677                               assign
      678                                   p-out-string = p-out-string + "&":U
      679                                   v-position   = v-position   + 4
      680                               .
      681                           end.
      682                           else do:
      683                               case substring( p-in-string, v-position + 1, 5 )
      684                               :
      685                                   when "quot;":U
      686                                   then do:
      687                                       assign
      688                                           p-out-string = p-out-string + '"':U
      689                                           v-position   = v-position   + 5
      690                                       .
      691                                   end.
      692                                   when "apos;":U
      693                                   then do:
      694                                       assign
      695                                           p-out-string = p-out-string + "'":U
      696                                           v-position   = v-position   + 5
      697                                       .
      698                                   end.
      699                                   otherwise do:
      700                                       assign
      701                                           p-out-string = p-out-string + "&":U
      702                                       .
      703                                   end.
      704                               end case.
      705                           end.
      706                       end.
      707                   end case.
      708               end.
      709           end.
      710       end.
      711   end.
      712   end .
      713   procedure xmlchar-read-integer :
      714   define input parameter p-input-string      as character        no-undo.
      715   define output parameter p-output-integer   as integer          no-undo.
      716   define output parameter p-success       as logical          no-undo.
      717   do
      718   on error undo, return error
      719   :
      720       assign
      721           p-output-integer = integer( p-input-string )
      722       no-error.
      723       if error-status :error
      724       then do:
      725           assign
      726               p-success           = no
      727               p-output-integer    = 0
      728           .
      729       end.
      730       else do:
      731           assign
      732               p-success           = yes
      733           .
      734       end.
      735   end.
      736   end.
      737   define variable v-bgelib-bgeclall           as logical      no-undo.
      738   define variable v-bgelib-bgedict            as logical      no-undo.
      739   define temp-table temp_ext-doc-type no-undo
      740       field edt-key               as integer
      741       field ext-doc-type          as character
      742       field ext-doc-type-label    as character
      743       index pi is primary unique
      744           edt-key
      745   .
      746   define temp-table temp_bgelib_goods no-undo
      747       field gds-code as integer
      748       index pi is primary unique
      749           gds-code
      750   .
      751   define temp-table temp_bgelib_clients no-undo
      752       field obj-type as character
      753       field obj-code as integer
      754       index pi is primary unique
      755           obj-type
      756           obj-code
      757   .
      758   define temp-table temp_bgelib_dis-card no-undo
      759       field d-card as character
      760       index pi is primary unique
      761           d-card
      762   .
      763   define temp-table temp_bgelib_trn-doc no-undo
      764       field doc-code as integer
      765   .
      766   procedure bgelib-tag-open:
      767   do
      768   on error undo, return error
      769   :
      770   define input parameter v-tag-level  as integer      no-undo.
      771   define input parameter v-tag-name   as character    no-undo.
      772   define input parameter v-tag-value  as character    no-undo.
      773       put stream stmXMLOut unformatted
      774           chr(10)
      775           + fill(" ", 4 * v-tag-level)
      776           + "<" + v-tag-name
      777           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
      778           + v-tag-value + ">"
      779       .
      780   end.
      781   end procedure.
      782   procedure bgelib-tag-put:
      783   do
      784   on error undo, return error
      785   :
      786   define input parameter v-tag-level      as integer      no-undo.
      787   define input parameter v-tag-name       as character    no-undo.
      788   define input parameter v-tag-value      as character    no-undo.
      789   define input parameter v-empty-mode     as integer      no-undo.
      790       v-tag-name = trim(v-tag-name).
      791       if  v-empty-mode = 1
      792       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
      793       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
      794       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
      795       then do:
      796           run xmlchar-encode in this-procedure (
      797                 input v-tag-value
      798               , output v-tag-value
      799           ).
      800           put stream stmXMLOut unformatted
      801               chr(10) + fill(" ", 4 * v-tag-level)
      802                           + '<' + v-tag-name + '>'
      803                           + v-tag-value
      804                           + '</' + v-tag-name + '>'
      805           .
      806       end.
      807   end.
      808   end procedure.
      809   procedure bgelib-tag-close:
      810   do
      811   on error undo, return error
      812   :
      813   define input parameter v-tag-level as integer      no-undo.
      814   define input parameter v-tag-name  as character    no-undo.
      815       put stream stmXMLOut unformatted
      816           chr(10)
      817           + fill( " ", 4 * v-tag-level)
      818           + '</' + v-tag-name + '>'
      819       .
      820   end.
      821   end procedure.
      822   procedure bgelib-write-log:
      823   do
      824   on error undo, return error
      825   :
      826   define input parameter v-filename   as character    no-undo.
      827   define input parameter v-log-level  as integer      no-undo.
      828   define input parameter v-out-string as character    no-undo.
      829       output stream stmXMLLog to value( v-filename ) append.
      830       put stream stmXMLLog unformatted
      831           chr(10)
      832       .
      833       put stream stmXMLLog unformatted
      834           ( if v-log-level = 0
      835             or v-out-string = "&DLine"
      836             or v-out-string = "&Line"
      837             then ""
      838             else cur-time-string-sec() + " " )
      839       .
      840       put stream stmXMLLog unformatted
      841           ( if v-out-string = "&Line"
      842             then fill( "-", 80 )
      843             else if v-out-string = "&DLine"
      844                  then fill( "=", 80 )
      845                  else v-out-string )
      846       .
      847       output stream stmXMLLog close.
      848   end.
      849   end procedure.
      850   procedure bgelib-write-edt:
      851   do
      852   on error undo, return error
      853   :
      854   define input parameter v-editor-handle    as handle       no-undo.
      855   define input parameter v-log-level        as integer      no-undo.
      856   define input parameter v-out-string       as character    no-undo.
      857       if valid-handle ( v-editor-handle )
      858       then do:
      859           v-editor-handle :move-to-eof().
      860           v-editor-handle :insert-string( ( if v-log-level = 0
      861                                             or v-out-string = "&DLine"
      862                                             or v-out-string = "&Line"
      863                                             then ""
      864                                             else cur-time-string-sec() + " "
      865                                         ) ).
      866           v-editor-handle :insert-string( ( if v-out-string = "&Line"
      867                                             then fill( "-", 80 )
      868                                             else if v-out-string = "&DLine" then fill("=", 80)
      869                                             else fill( " ", v-log-level) + v-out-string
      870                                         ) ).
      871           v-editor-handle :insert-string( chr(10) ).
      872       end.
      873       process events.
      874       output to 'bgescn.txt' append.
      875           put unformatted
      876               chr(10)
      877               string( ( if v-log-level = 0
      878                         or v-out-string = "&DLine"
      879                         or v-out-string = "&Line"
      880                         then ""
      881                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
      882                     ) )
      883               string( ( if v-out-string = "&Line"
      884                         then fill( "-", 80 )
      885                         else if v-out-string = "&DLine"
      886                              then fill( "=", 80 )
      887                              else fill( " ", v-log-level ) + v-out-string
      888                     ) )
      889           .
      890       output close.
      891   end.
      892   end procedure.
      893   procedure bgelib-show-cnt:
      894   do
      895   on error undo, return error
      896   :
      897   define input parameter v-fillin-handle     as handle   no-undo.
      898       if valid-handle( v-fillin-handle )
      899       then do:
      900           assign
      901               v-fillin-handle :visible = true
      902           .
      903       end.
      904   end.
      905   end procedure.
      906   procedure bgelib-hide-cnt:
      907   do
      908   on error undo, return error
      909   :
      910   define input parameter v-fillin-handle     as handle   no-undo.
      911       if valid-handle( v-fillin-handle )
      912       then do:
      913           assign v-fillin-handle :visible = false.
      914       end.
      915   end.
      916   end procedure.
      917   procedure bgelib-write-cnt:
      918   do
      919   on error undo, return error
      920   :
      921   define input parameter v-fillin-handle    as handle       no-undo.
      922   define input parameter v-fillin-string    as character    no-undo.
      923       if valid-handle( v-fillin-handle )
      924       then do:
      925           assign
      926               v-fillin-handle :SCREEN-value = v-fillin-string
      927           .
      928       end.
      929   end.
      930   end procedure.
      931   procedure bgelib-write-header:
      932   do
      933   on error undo, return error
      934   :
      935   define input parameter p-first-file     as logical      no-undo.
      936   define input parameter p-xml-file-name  as character    no-undo.
      937   define input parameter p-list-file-name as character    no-undo.
      938   define input parameter p-file-number    as integer      no-undo.
      939   define input parameter p-have-prev      as logical      no-undo.
      940   define input parameter p-prev-filename  as character    no-undo.
      941   define input parameter p-obj-list       as character    no-undo.
      942   define input parameter p-doc-type-list  as character    no-undo.
      943   define input parameter p-parameter-list as character    no-undo.
      944       define variable v-counter    as integer        no-undo.
      945       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
      946       put stream stmXMLOut unformatted
      947           "<?xml version='1.0' encoding='windows-1251'?>"
      948       .
      949       run bgelib-tag-open( input 0, input "root"  , input "" ).
      950       run bgelib-tag-open( input 0, input "header", input "" ).
      951       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      952       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      953       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      954       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
      955       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
      956       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      957       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      958       :
      959           run bgelib-tag-put(
      960                 input 1
      961               , input entry( 2 * v-counter, p-parameter-list )
      962               , input entry( 2 * v-counter + 1, p-parameter-list )
      963               , input 0
      964           ).
      965       end.
      966       run bgelib-tag-close( input 0, input "header" ).
      967       output stream stmXMLOut close.
      968       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
      969       if p-first-file = yes
      970       then do:
      971           put stream stmXMLOut unformatted
      972               "<?xml version='1.0' encoding='windows-1251'?>"
      973           .
      974           run bgelib-tag-open( input 0, input "export", input "" ).
      975       end.
      976       run bgelib-tag-open( input 1, input "file", input "" ).
      977       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      978       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      979       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      980       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
      981       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
      982       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      983       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      984       :
      985           run bgelib-tag-put(
      986                 input 2
      987               , input trim(entry( 2 * v-counter, p-parameter-list ))
      988               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
      989               , input 0
      990           ).
      991       end.
      992       run bgelib-tag-close( input 1, input "file" ).
      993       output stream stmXMLOut close.
      994   end.
      995   end procedure.
      996   procedure bgelib-write-footer:
      997   do
      998   on error undo, return error
      999   :
     1000   define input parameter p-last-file      as logical      no-undo.
     1001   define input parameter p-xml-file-name  as character    no-undo.
     1002   define input parameter p-list-file-name as character    no-undo.
     1003   define input parameter p-have-next      as logical      no-undo.
     1004   define input parameter p-next-file-name as character    no-undo.
     1005       define variable v-error-num     as integer           no-undo.
     1006       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1007       if p-have-next = yes
     1008       then do:
     1009           run bgelib-tag-open( input 0, input "footer", "" ).
     1010           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1011           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1012           run bgelib-tag-close( input 0, input "footer" ).
     1013       end.
     1014       run bgelib-tag-close( input 0, input "root" ).
     1015       output stream stmXMLOut close.
     1016       run bge/os_copy.p (
     1017             input "M"
     1018           , input p-xml-file-name + "tmp"
     1019           , input p-xml-file-name + "xml"
     1020           , output v-error-num
     1021       ).
     1022       if p-last-file = yes
     1023       then do:
     1024           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1025               run bgelib-tag-close( input 0, input "export" ).
     1026           output stream stmXMLOut close.
     1027           run bge/os_copy.p (
     1028                 input "M"
     1029               , input p-list-file-name + "tmp"
     1030               , input p-list-file-name + "xml"
     1031               , output v-error-num
     1032           ).
     1033       end.
     1034   end.
     1035   end procedure.
     1036   procedure bgelib-filename :
     1037   do
     1038   on error undo, return error
     1039   :
     1040   define input parameter p-prefix             as character    no-undo.
     1041   define output parameter p-xml-file-name     as character    no-undo.
     1042   define output parameter p-log-file-name     as character    no-undo.
     1043   define output parameter p-list-file-name    as character    no-undo.
     1044       define variable v-home-dir  as character    no-undo.
     1045       define variable v-error-num as integer      no-undo.
     1046       get-key-value section "BGE" key "outdir" value v-home-dir.
     1047       if v-home-dir = ?
     1048       then do:
     1049           message
     1050             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1051             skip(1)
     1052             skip "Обратитесь к администратору."
     1053           view-as alert-box error.
     1054           undo, return error .
     1055       end.
     1056       run gbl/dir-cre.p (
     1057           input v-home-dir
     1058       ) no-error.
     1059       if error-status :error
     1060       then do:
     1061           message
     1062             skip "Неверно задан каталог экспорта."
     1063             skip(1)
     1064             skip "Обратитесь к администратору."
     1065           view-as alert-box error.
     1066           undo, return error .
     1067       end.
     1068       run bge/genfname.p (
     1069             input v-home-dir
     1070           , input p-prefix
     1071           , input ""
     1072           , input "xml"
     1073           , input "tmp"
     1074           , output p-xml-file-name
     1075       ).
     1076       assign
     1077           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1078           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1079           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1080       .
     1081   end.
     1082   end procedure.
     1083   procedure bgelib-read-config :
     1084   do
     1085   on error undo, return error
     1086   :
     1087   define variable v-par-type as character     no-undo.
     1088     define variable v-param-type      as character  no-undo .
     1089     define variable v-value-character as character  no-undo .
     1090     define variable v-value-date      as date       no-undo .
     1091     define variable v-value-decimal   as decimal    no-undo .
     1092     define variable v-value-integer   as integer    no-undo .
     1093     define variable v-value-logical   as logical    no-undo .
     1094     define variable v-tth             as handle     no-undo .
     1095       assign
     1096           v-bgelib-bgeclall = no
     1097           v-bgelib-bgedict  = no
     1098       .
     1099       run adm/shattri.p ( input "get":U
     1100                         , input  '':u
     1101                         , input  0
     1102                         , input  'bge-export':U
     1103                         , input  'bgeclall':U
     1104                         , output v-value-character
     1105                         , output v-value-date
     1106                         , output v-value-decimal
     1107                         , output v-value-integer
     1108                         , output v-value-logical
     1109                         , output v-param-type
     1110                         , input-output table-handle v-tth
     1111                         ) no-error .
     1112       if error-status :error
     1113       then do:
     1114         assign
     1115           v-bgelib-bgeclall = no
     1116         .
     1117       end.
     1118       else do:
     1119         assign
     1120           v-bgelib-bgeclall = v-value-logical
     1121         .
     1122       end.
     1123       delete object v-tth.
     1124       run adm/shattri.p ( input "get":U
     1125                         , input  '':u
     1126                         , input  0
     1127                         , input  'bge-export':U
     1128                         , input  'bgedict':U
     1129                         , output v-value-character
     1130                         , output v-value-date
     1131                         , output v-value-decimal
     1132                         , output v-value-integer
     1133                         , output v-value-logical
     1134                         , output v-param-type
     1135                         , input-output table-handle v-tth
     1136                         ) no-error .
     1137       if error-status :error
     1138       then do:
     1139         assign
     1140           v-bgelib-bgedict = no
     1141         .
     1142       end.
     1143       else do:
     1144         assign
     1145           v-bgelib-bgedict = v-value-logical
     1146         .
     1147       end.
     1148       delete object v-tth.
     1149       run adm/shattri.p ( input "get":U
     1150                         , input  '':u
     1151                         , input  0
     1152                         , input  'bge-export':U
     1153                         , input  'bgefmt':U
     1154                         , output v-value-character
     1155                         , output v-value-date
     1156                         , output v-value-decimal
     1157                         , output v-value-integer
     1158                         , output v-value-logical
     1159                         , output v-param-type
     1160                         , input-output table-handle v-tth
     1161                         ) no-error .
     1162       if error-status :error
     1163       then do:
     1164         assign
     1165           v-bgelib-bgefmt  = "xml":U
     1166         .
     1167       end.
     1168       else do:
     1169         assign
     1170           v-bgelib-bgefmt  = v-value-character
     1171         .
     1172       end.
     1173       delete object v-tth.
     1174       run adm/shattri.p ( input "get":U
     1175                         , input  '':u
     1176                         , input  0
     1177                         , input  'bge-export':U
     1178                         , input  'bgeflold':U
     1179                         , output v-value-character
     1180                         , output v-value-date
     1181                         , output v-value-decimal
     1182                         , output v-value-integer
     1183                         , output v-value-logical
     1184                         , output v-param-type
     1185                         , input-output table-handle v-tth
     1186                         ) no-error .
     1187       if error-status :error
     1188       then do:
     1189         assign
     1190           v-bgelib-bgeflold  = "old":U
     1191         .
     1192       end.
     1193       else do:
     1194         assign
     1195           v-bgelib-bgeflold  = v-value-character
     1196         .
     1197       end.
     1198       delete object v-tth.
     1199   end.
     1200   end procedure.
     1201   procedure bgelib-check-file-size :
     1202   do
     1203   on error undo, return error
     1204   :
     1205   define input parameter p-out-filename   as character    no-undo.
     1206   define output parameter p-is-big        as logical      no-undo.
     1207       define variable v-current-position    as integer        no-undo.
     1208       assign
     1209           v-current-position = seek( stmXMLOut )
     1210       .
     1211       if v-current-position / 1024 / 1024  >= 100
     1212       then do:
     1213           assign
     1214               p-is-big = yes
     1215           .
     1216       end.
     1217   end.
     1218   end procedure.
     1219   procedure bgelib-init-ext-doc-type :
     1220       define variable v-counter    as integer      no-undo.
     1221       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     1222   do
     1223   for buf_temp_ext-doc-type
     1224   on error undo, return error
     1225   :
     1226       empty temp-table buf_temp_ext-doc-type.
     1227       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1228       :
     1229           create buf_temp_ext-doc-type.
     1230           assign
     1231               buf_temp_ext-doc-type.edt-key               = v-counter
     1232               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1233               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     1234           .
     1235       end.
     1236   end.
     1237   end procedure.
     1238   do
     1239   on error undo, return error
     1240   :
     1241       define variable v-counter           as integer       no-undo.
     1242       define variable v-xml-file-name     as character     no-undo.
     1243       define variable v-log-file-name     as character     no-undo.
     1244       define variable v-list-file-name    as character     no-undo.
     1245       define variable v-xml-file-number   as integer       no-undo.
     1246       define variable v-cancel            as logical       no-undo.
     1247       define variable v-parameter-list    as character     no-undo.
     1248       define buffer buf_cash-pay      for ub.cash-pay.
     1249       run bgelib-read-config in this-procedure no-error.
     1250       if error-status :error
     1251       then do:
     1252           message
     1253           vss-workfile vss-revision vss-description
     1254           skip "Ошибка чтения параметров экспорта."
     1255           skip "Для экспорта данных будут приняты параметры по умолчанию."
     1256           skip return-value
     1257           skip trim(error-status :get-message(1))
     1258                trim(error-status :get-message(2))
     1259                trim(error-status :get-message(3))
     1260           view-as alert-box error.
     1261       end.
     1262       run bgelib-filename in this-procedure (
     1263             input "pcp"
     1264           , output v-xml-file-name
     1265           , output v-log-file-name
     1266           , output v-list-file-name
     1267       ).
     1268       run gbl/waitfrsp.w (
     1269             input substring( v-xml-file-name, 1, 1 )
     1270           , input 200
     1271           , output v-cancel
     1272       ) .
     1273       if v-cancel = yes
     1274       then do:
     1275           undo, return error .
     1276       end.
     1277       run bgelib-write-log in this-procedure (
     1278             input v-log-file-name
     1279           , input 1
     1280           , input "&DLine"
     1281       ).
     1282       run bgelib-write-log in this-procedure (
     1283             input v-log-file-name
     1284           , input 1
     1285           , input substitute( "Начало выгрузки справочника типов кассовых платежей в файл &1"
     1286                                   , replace( v-xml-file-name, "/", "\" ) + "tmp"
     1287                             )
     1288       ).
     1289       if p-rec-amount = ?
     1290       or p-rec-code-list = ?
     1291       or ( p-rec-amount <> 0
     1292           and num-entries( p-rec-code-list ) = 0 )
     1293       then do:
     1294           run bgelib-write-log in this-procedure (
     1295                 input v-log-file-name
     1296               , input 1
     1297               , input "Неверно заданы входные параметры."
     1298           ).
     1299           undo, return error.
     1300       end.
     1301       assign
     1302           v-parameter-list         =  substitute( "&1,&2,&3,&4,&5,&6,&7,&8,&9"
     1303                                                  , 4
     1304                                                  , "docName"          , "cashPay":U
     1305                                                  , "version"          , replace("12.3 " + replace( vss-revision + vss-date, "$", " " ),',','')
     1306                                                  , "exportDate"       , string( today,          "99/99/9999" )
     1307                                                  , "exportTime"       , string( time,           "HH:MM:SS"   )
     1308                                                 )
     1309           v-xml-file-number       =   1
     1310       .
     1311       run bgelib-write-header in this-procedure (
     1312             input yes
     1313           , input v-xml-file-name
     1314           , input v-list-file-name
     1315           , input v-xml-file-number
     1316           , input no
     1317           , input ""
     1318           , input ""
     1319           , input ""
     1320           , input v-parameter-list
     1321       ).
     1322       for each buf_cash-pay no-lock
     1323       :
     1324           run write-body in this-procedure (
     1325                 input buf_cash-pay.cdpay-code
     1326               , input buf_cash-pay.curr-code
     1327               , input v-parameter-list
     1328               , input v-xml-file-name
     1329               , input v-log-file-name
     1330               , input v-list-file-name
     1331               , input v-xml-file-number
     1332               , output v-xml-file-name
     1333               , output v-xml-file-number
     1334           ) no-error.
     1335           if error-status :error
     1336           then do:
     1337               run bgelib-write-log in this-procedure (
     1338                     input v-log-file-name
     1339                   , input 1
     1340                   , input substitute(  "*** ERR: *** Ошибка выгрузки типа кассового платежа &1. &2. &3. &4", buf_cash-pay.cdpay-code, buf_cash-pay.curr-code, trim(error-status :get-message(1)), trim(error-status :get-message(2)) )
     1341               ).
     1342           end.
     1343       end.
     1344       run bgelib-write-footer in this-procedure (
     1345             input yes
     1346           , input v-xml-file-name
     1347           , input v-list-file-name
     1348           , input no
     1349           , input ""
     1350       ).
     1351       run bgelib-write-log in this-procedure (
     1352             input v-log-file-name
     1353           , input 1
     1354           , input substitute( "Данные выгружены в файл &1"
     1355                                   , replace( v-xml-file-name, "/", "\" ) + "xml"
     1356                             )
     1357       ).
     1358       run bgelib-write-log in this-procedure (
     1359             input v-log-file-name
     1360           , input 1
     1361           , input "&DLine"
     1362       ).
     1363   end.
     1364   procedure write-body :
     1365   do
     1366   on error undo, return error
     1367   :
     1368   define input parameter p-obj-code               as integer      no-undo.
     1369   define input parameter p-curr-code              as integer      no-undo.
     1370   define input parameter p-parameter-list         as character    no-undo.
     1371   define input parameter p-xml-file-name          as character    no-undo.
     1372   define input parameter p-log-file-name          as character    no-undo.
     1373   define input parameter p-list-file-name         as character    no-undo.
     1374   define input parameter p-xml-file-number        as integer      no-undo.
     1375   define output parameter p-last-xml-file-name    as character    no-undo.
     1376   define output parameter p-last-xml-file-number  as integer      no-undo.
     1377       define variable v-need-new-file as logical      no-undo.
     1378       define variable v-void-string   as character      no-undo.
     1379       define variable v-prev-filename as character      no-undo.
     1380       define buffer buf_cash-pay      for ub.cash-pay.
     1381       assign
     1382           p-last-xml-file-name   = p-xml-file-name
     1383           p-last-xml-file-number = p-xml-file-number
     1384       .
     1385       run bgelib-check-file-size in this-procedure (
     1386             input p-xml-file-name + "tmp"
     1387           , output v-need-new-file
     1388       ).
     1389       if v-need-new-file = yes
     1390       then do:
     1391           assign
     1392               v-prev-filename = p-xml-file-name
     1393           .
     1394           run bgelib-filename in this-procedure (
     1395                 input "pcp"
     1396               , output p-xml-file-name
     1397               , output v-void-string
     1398               , output v-void-string
     1399           ).
     1400           run bgelib-write-footer in this-procedure (
     1401                 input no
     1402               , input v-prev-filename
     1403               , input p-list-file-name
     1404               , input yes
     1405               , input p-xml-file-name + "xml":U
     1406           ).
     1407           run bgelib-write-log in this-procedure (
     1408                 input p-log-file-name
     1409               , input 1
     1410               , input substitute( "Данные выгружены в файл &1"
     1411                                       , replace( p-xml-file-name, "/", "\" ) + "xml"
     1412                               )
     1413           ).
     1414           assign
     1415               p-last-xml-file-number   = p-xml-file-number + 1
     1416               p-last-xml-file-name     = p-xml-file-name
     1417           .
     1418           run bgelib-write-header in this-procedure (
     1419                 input no
     1420               , input p-last-xml-file-name
     1421               , input p-list-file-name
     1422               , input p-last-xml-file-number
     1423               , input yes
     1424               , input v-prev-filename + "xml":U
     1425               , input ""
     1426               , input ""
     1427               , input p-parameter-list
     1428           ).
     1429           assign
     1430               v-need-new-file = no
     1431           .
     1432       end.
     1433       output stream stmxmlout to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1434       find first buf_cash-pay no-lock
     1435            where buf_cash-pay.cdpay-code  = p-obj-code
     1436              and buf_cash-pay.curr-code = p-curr-code
     1437       .
     1438   run bgelib-tag-open in this-procedure ( input 1, input "pcp", input "").
     1439   run bgelib-tag-put in this-procedure ( input 2, "payTypeID"      , input string( buf_cash-pay.cdpay-code          ), input 0 ).
     1440   run bgelib-tag-put in this-procedure ( input 2, "currCodeID"     , input string( buf_cash-pay.curr-code         ), input 0 ).
     1441   run bgelib-tag-put in this-procedure ( input 2, "name"           , input string( buf_cash-pay.obj-name          ), input 0 ).
     1442   run bgelib-tag-put in this-procedure ( input 2, "payCode"        , input string( buf_cash-pay.pay-code          ), input 0 ).
     1443   run bgelib-tag-put in this-procedure ( input 2, "payLimit"       , input string( buf_cash-pay.pay-limit         ), input 0 ).
     1444   run bgelib-tag-put in this-procedure ( input 2, "wthCode"        , input string( buf_cash-pay.wth-code          ), input 0 ).
     1445   run bgelib-tag-put in this-procedure ( input 2, "isCash"         , input string( buf_cash-pay.is-cash           ), input 0 ).
     1446   run bgelib-tag-put in this-procedure ( input 2, "isCreditCard"   , input string( buf_cash-pay.is-credit-card    ), input 0 ).
     1447   run bgelib-tag-put in this-procedure ( input 2, "isDebetCard"    , input string( buf_cash-pay.is-debet-card     ), input 0 ).
     1448   run bgelib-tag-put in this-procedure ( input 2, "payCardView"    , input string( buf_cash-pay.pay-card-view     ), input 0 ).
     1449   run bgelib-tag-put in this-procedure ( input 2, "atr1"           , input string( buf_cash-pay.atr1              ), input 0 ).
     1450   run bgelib-tag-put in this-procedure ( input 2, "atr2"           , input string( buf_cash-pay.atr2              ), input 0 ).
     1451   run bgelib-tag-put in this-procedure ( input 2, "atr4"           , input string( buf_cash-pay.atr4              ), input 0 ).
     1452   run bgelib-tag-put in this-procedure ( input 2, "atr8"           , input string( buf_cash-pay.atr8              ), input 0 ).
     1453   run bgelib-tag-put in this-procedure ( input 2, "atr16"          , input string( buf_cash-pay.atr16             ), input 0 ).
     1454   run bgelib-tag-put in this-procedure ( input 2, "atr32"          , input string( buf_cash-pay.atr32             ), input 0 ).
     1455   run bgelib-tag-put in this-procedure ( input 2, "atr64"          , input string( buf_cash-pay.atr64             ), input 0 ).
     1456   run bgelib-tag-put in this-procedure ( input 2, "atr128"         , input string( buf_cash-pay.atr128            ), input 0 ).
     1457   run bgelib-tag-close in this-procedure ( input 1, input "pcp" ).
     1458       output stream stmxmlout close.
     1459   end.
     1460   end procedure.
