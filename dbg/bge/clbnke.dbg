      530      ,''                                , 'receiver-type'
      531      ,''                                , 'receiver-code'
      532      ,''                                , 'receiver-code-schet'
      533      ,''                                , 'payer-type'
      534      ,''                                , 'payer-code'
      535      ,''                                , 'payer-code-schet'
      536      ,''                                , 'fin-ext-doc-type'
      537      ,''                                , 'fin-doc-type'
      538      ,''                                , 'host-code'
      539      ,''                                , 'curr-code'
      540      ,'КвитанцияДата'                   , 'cvitdate'
      541      ,'КвитанцияВремя'                  , 'cvitname'
      542      ,'КвитанцияСодержание'             , 'cvitcont'
      543                                      ] no-undo.
      544   define variable h-init-statement as character  extent 40 init
      545   [
      546       'ДатаНачала='                     , 'start-date'
      547      ,'ДатаКонца='                      , 'end-date'
      548      ,'РасчСчет='                       , 'r-schet'
      549      ,'НачальныйОстаток='               , 'start-sum-doc'
      550      ,'КонечныйОстаток='                , 'end-sum-doc'
      551      ,'ВсегоПоступило='                 , 'in-sum-doc'
      552      ,'ВсегоСписано='                   , 'out-sum-doc'
      553      ,'СекцияРасчСчет='                 , 'fins-ext-doc-type/'
      554      ,''                                , 'fins-ext-doc-type'
      555      ,''                                , 'fins-doc-type'
      556      ,''                                , 'host-code'
      557      ,''                                , 'curr-code'
      558      ,''                                , 'code-schet'
      559      ,''                                , 'code-bank'
      560      ,''                                , 'cli-name'
      561      ,''                                , 'bank-name'
      562      ,''                                , 'bank-city'
      563      ,''                                , 'cl-bank'
      564      ,''                                , 'bik'
      565      ,'ДатаСоздания='                   , 'bank-date'
      566                                      ] no-undo.
      567       for each temp_hfields:
      568         delete temp_hfields.
      569       end.
      570       do ii = 1 to (if p-mode = 'exp' then 42 else 58):
      571         create temp_hfields.
      572         assign
      573         temp_hfields.order_ = ii
      574         temp_hfields.label_ = h-init-doc[ii * 2 - 1]
      575         temp_hfields.name_ = h-init-doc[ii * 2]
      576         temp_hfields.subject = 'fin-doc':U
      577         .
      578       end.
      579       do ii = 1 to (if p-mode = 'exp' then 0 else 20):
      580         create temp_hfields.
      581         assign
      582         temp_hfields.order_ = ii
      583         temp_hfields.label_ = h-init-statement[ii * 2 - 1]
      584         temp_hfields.name_ = h-init-statement[ii * 2]
      585         temp_hfields.subject = 'fin-statement':U
      586         .
      587       end.
      588     end.
      589   end procedure.
      590   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      591   procedure fd-attr-code :
      592     do
      593     on error undo, return error
      594     :
      595       define input  parameter p-code           as character no-undo .
      596       define output parameter p-type           as character no-undo .
      597       define output parameter p-format         as character no-undo .
      598       define output parameter p-label          as character no-undo .
      599       define output parameter p-user-can-edit  as logical   no-undo .
      600       define output parameter p-output-display as logical   no-undo .
      601       define output parameter p-other          as character no-undo .
      602       case p-code :
      603               when 'shift-date':U then do:     assign     p-label = "Дата смены"     p-type = 'T':U      p-format = "99/99/9999"     p-label = "Дата смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      604               when 'shift-num':U then do:     assign     p-label = "П.смены"     p-type = 'I':U      p-format = "99"     p-label = "П.смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      605               when 'shift-name':U then do:     assign     p-label = "№ смены"     p-type = 'C':U      p-format = "X(2)"     p-label = "№ смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      606               when 'barcode':U then do:     assign     p-label = "Штрих-код"     p-type = 'C':U      p-format = "X(20)"     p-label = "Штрих-код"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      607               when 'lockid':U then do:     assign     p-label = "ID блокировки чека"     p-type = 'C':U      p-format = "X(2)"     p-label = "ID блокировки чека"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      608               when 'cover_sheet':U then do:     assign     p-label = "Разбиение по номиналам"     p-type = 'C':U      p-format = "X(4000)"     p-label = "Разбиение по номиналам"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      609               when 'pre-vedom':U then do:     assign     p-label = "Атрибут для препроводительной ведомости"     p-type = 'C':U      p-format = "X(256)"     p-label = "Атрибут для препроводительной ведомости"     p-user-can-edit  = false     p-output-display = false     p-other = '':u      .   end.
      610               when 'contr-kb':U then do:     assign     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-type = 'I':U      p-format = ">>>9"     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      611         otherwise do:
      612           undo, return error "неизвестный атрибут платежа" + " " + p-code .
      613         end.
      614       end.
      615     end.
      616   end procedure.
      617   procedure fd-attr-tooltip :
      618     do
      619     on error undo, return error
      620     :
      621       define input  parameter p-code    as character no-undo .
      622       define output parameter p-tooltip as character no-undo .
      623       define output parameter p-label   as character no-undo .
      624       case p-code :
      625               when 'shift-date':U then do:     assign     p-tooltip = "Дата смены"     p-label = "Дата смены" .   end.
      626               when 'shift-num':U then do:     assign     p-tooltip = "П.смены"     p-label = "П.смены" .   end.
      627               when 'shift-name':U then do:     assign     p-tooltip = "№ смены"     p-label = "№ смены" .   end.
      628               when 'barcode':U then do:     assign     p-tooltip = "Штрих-код"     p-label = "Штрих-код" .   end.
      629               when 'lockid':U then do:     assign     p-tooltip = "ID блокировки чека"     p-label = "ID блокировки чека" .   end.
      630               when 'cover_sheet':U then do:     assign     p-tooltip = "Разбиение по номиналам"     p-label = "Разбиение по номиналам" .   end.
      631               when 'pre-vedom':U then do:     assign     p-tooltip = "Атрибут для препроводительной ведомости"     p-label = "Атрибут для препроводительной ведомости" .   end.
      632               when 'contr-kb':U then do:     assign     p-tooltip = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами" .   end.
      633         otherwise do:
      634           undo, return error "неизвестный атрибут платежа" + " " + p-code .
      635         end.
      636       end.
      637     end.
      638   end procedure.
      639   procedure fin-doc-attr-write :
      640    do
      641    on error undo, return error return-value
      642    :
      643   define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
      644   define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
      645   define input parameter p-attr-code     like ub.fin-doc-attr.attr-code  no-undo .
      646   define input parameter p-attr-value    like ub.fin-doc-attr.attr-value no-undo .
      647   define variable  v-format         as character no-undo .
      648   define variable  v-label          as character no-undo .
      649   define variable  v-user-can-edit  as logical   no-undo .
      650   define variable  v-output-display as logical   no-undo .
      651   define variable  v-other          as character no-undo .
      652   define variable  v-type           as character no-undo .
      653   define buffer buf_fin-doc-attr for ub.fin-doc-attr.
      654   run fd-attr-code in this-procedure
      655                                     (input  p-attr-code
      656                                     ,output v-type
      657                                     ,output v-format
      658                                     ,output v-label
      659                                     ,output v-user-can-edit
      660                                     ,output v-output-display
      661                                     ,output v-other
      662                                     ) no-error .
      663   if error-status :error then do:
      664     undo, return error return-value .
      665   end.
      666   find first buf_fin-doc-attr  exclusive-lock  where
      667             buf_fin-doc-attr.attr-code    = p-attr-code
      668         AND buf_fin-doc-attr.host-code    = p-host-code
      669         AND buf_fin-doc-attr.fin-doc-code     = p-fin-doc-code  no-error .
      670     if not available  buf_fin-doc-attr then do:
      671         create buf_fin-doc-attr.
      672         assign
      673         buf_fin-doc-attr.attr-code    = p-attr-code
      674         buf_fin-doc-attr.attr-value   = p-attr-value
      675         buf_fin-doc-attr.host-code    = p-host-code
      676         buf_fin-doc-attr.fin-doc-code     = p-fin-doc-code
      677         .
      678     end.
      679     else do:
      680        if buf_fin-doc-attr.attr-value = p-attr-value then do:
      681          run write-fin-doc-attr-proc  in this-procedure (buffer buf_fin-doc-attr ).
      682        end.
      683        else do:
      684          assign
      685          buf_fin-doc-attr.attr-value = p-attr-value.
      686        end.
      687     end.
      688    end.
      689   end procedure.
      690   procedure fd-attr-exist :
      691     do
      692     on error undo, return error
      693     :
      694       define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
      695       define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
      696       define input parameter p-code          like ub.fin-doc-attr.attr-code  no-undo .
      697       define output parameter p-exist   as logical  no-undo .
      698       define buffer buf_fin-doc-attr for ub.fin-doc-attr .
      699       define variable  v-type           as character no-undo .
      700       define variable  v-format         as character no-undo .
      701       define variable  v-label          as character no-undo .
      702       define variable  v-user-can-edit  as logical   no-undo .
      703       define variable  v-output-display as logical   no-undo .
      704       define variable  v-other          as character no-undo .
      705       run fd-attr-code in this-procedure
      706         (input  p-code
      707         ,output v-type
      708         ,output v-format
      709         ,output v-label
      710         ,output v-user-can-edit
      711         ,output v-output-display
      712         ,output v-other
      713         ) no-error .
      714       if error-status :error then do:
      715         undo, return error return-value .
      716       end.
      717       find first buf_fin-doc-attr exclusive-lock
      718         where buf_fin-doc-attr.host-code  = p-host-code
      719           and buf_fin-doc-attr.fin-doc-code  = p-fin-doc-code
      720           and buf_fin-doc-attr.attr-code = p-code
      721         no-error .
      722       if  available buf_fin-doc-attr then do:
      723         p-exist = yes.
      724       end.
      725     end.
      726   end procedure.
      727   procedure fd-attr-delete :
      728     do
      729     on error undo, return error
      730     :
      731     define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
      732     define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
      733     define input parameter p-code          like ub.fin-doc-attr.attr-code  no-undo .
      734     define output parameter p-deleted  as logical no-undo.
      735       define buffer buf_fin-doc-attr for ub.fin-doc-attr .
      736       define variable  v-type           as character no-undo .
      737       define variable  v-format         as character no-undo .
      738       define variable  v-label          as character no-undo .
      739       define variable  v-user-can-edit  as logical   no-undo .
      740       define variable  v-output-display as logical   no-undo .
      741       define variable  v-other          as character no-undo .
      742       run fd-attr-code in this-procedure
      743         (input  p-code
      744         ,output v-type
      745         ,output v-format
      746         ,output v-label
      747         ,output v-user-can-edit
      748         ,output v-output-display
      749         ,output v-other
      750         ) no-error .
      751       if error-status :error then do:
      752         undo, return error return-value .
      753       end.
      754       find first buf_fin-doc-attr exclusive-lock
      755         where buf_fin-doc-attr.host-code  = p-host-code
      756           and buf_fin-doc-attr.fin-doc-code  = p-fin-doc-code
      757           and buf_fin-doc-attr.attr-code = p-code
      758         no-error NO-WAIT.
      759       if not available buf_fin-doc-attr then do:
      760         p-deleted = no.
      761       end.
      762       else do:
      763         delete buf_fin-doc-attr no-error .
      764         if error-status:error then do:
      765           undo, return error return-value .
      766         end.
      767         p-deleted = yes.
      768       end.
      769     end.
      770   end procedure.
