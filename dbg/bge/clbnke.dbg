      956             buf_c-fin-doc-attr.attr-code    = p-attr-code
      957         and buf_c-fin-doc-attr.fin-doc-code      = p-fin-doc-code
      958         and buf_c-fin-doc-attr.host-code      = p-host-code
      959         and buf_c-fin-doc-attr.corr-user-db-num = p-corr-user-db-num
      960         and buf_c-fin-doc-attr.chip-num         > p-chip-num      no-error .
      961     if available  buf_c-fin-doc-attr then do:
      962       assign
      963       p-attr-value = buf_c-fin-doc-attr.attr-value
      964       .
      965     end.
      966     else do:
      967       p-attr-value = ? .
      968     end.
      969    end.
      970   end procedure.
      971   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      972   procedure write-fin-doc-attr-proc :
      973   define parameter buffer buf_fin-doc-attr for ub.fin-doc-attr.
      974   define variable v-date as date no-undo .
      975   define variable v-time as integer no-undo .
      976   define buffer buf_c-fin-doc-attr for ub.c-fin-doc-attr.
      977     do
      978     on error undo, return error
      979     :
      980       if not available buf_fin-doc-attr then do:
      981         undo, return error (vss-workfile + chr(32) + vss-revision + chr(32) + vss-description  + chr(10) +
      982                       "Ошибка задания входных параметров:Не определен атрибут платежа" ).
      983       end.
      984       run cur-time in this-procedure(output v-date, output v-time).
      985       create buf_c-fin-doc-attr.
      986       buffer-copy buf_fin-doc-attr to buf_c-fin-doc-attr
      987       assign
      988       buf_c-fin-doc-attr.chip-num           = next-value (s-corr-chip, ub)
      989       buf_c-fin-doc-attr.corr-time          = v-time
      990       buf_c-fin-doc-attr.corr-user-db-num   = g#db-num
      991       buf_c-fin-doc-attr.corr-user-name     = g#userid
      992       buf_c-fin-doc-attr.corr-date          = v-date
      993       .
      994       release buf_c-fin-doc-attr.
      995     end.
      996   end procedure.
      997   define variable v-input-error as logical no-undo .
      998   define variable v-view-log as logical no-undo .
      999   define variable v-esm as character no-undo .
     1000   define variable v-date-range as character no-undo .
     1001   define variable log-file-name as character no-undo init 'ext-cbnk.log'.
     1002   define stream PrnLibStream.
     1003   if num-entries(p-parameter, chr(4)) <> 4
     1004   then do:
     1005     assign
     1006     v-input-error = yes
     1007     v-esm         = substitute("Неверное количество ENTRY в составном параметре - &1, должно быть 3"
     1008                                , num-entries(p-parameter, chr(4))).
     1009     .
     1010   end.
     1011   else do:
     1012     if num-entries(entry(2, p-parameter, chr(4))) <> 9
     1013     then do:
     1014       assign
     1015       v-input-error = yes
     1016       v-esm         = substitute("Неверное количество ENTRY в 2-ом ENTRY составного параметре - &1, должно быть 9"
     1017                                 , num-entries(entry(1, p-parameter, chr(4)))).
     1018       .
     1019     end.
     1020     if num-entries(entry(3, p-parameter, chr(4))) <> 5
     1021     then do:
     1022       assign
     1023       v-input-error = yes
     1024       v-esm         = substitute("Неверное количество ENTRY в 3-ом ENTRY составного параметре - &1, должно быть 5"
     1025                                 , num-entries(entry(2, p-parameter, chr(4)))).
     1026       .
     1027     end.
     1028     assign
     1029     p-auto = integer(entry(1, p-parameter, chr(4)) )
     1030     p-format  = entry( 1, entry(2, p-parameter, chr(4)) )
     1031     p-encoding  = entry( 2, entry(2, p-parameter, chr(4)) )
     1032     p-rs-1 = integer( entry( 3, entry(2, p-parameter, chr(4))) )
     1033     p-curr-host-code = integer(entry(4, entry(2, p-parameter, chr(4))))
     1034     p-rs-hsch = integer( entry( 6, entry(2, p-parameter, chr(4)) ) )
     1035     p-rs-csch = integer( entry( 7, entry(2, p-parameter, chr(4)) ) )
     1036     v-date-range = entry(3, p-parameter, chr(4))
     1037     p-doc-type-list = entry(4, p-parameter, chr(4))
     1038     no-error .
     1039     if error-status:error then do:
     1040       assign
     1041       v-esm = error-status:get-message(1)
     1042       v-input-error = yes
     1043       .
     1044     end.
     1045   end.
     1046   if v-input-error = yes then do:
     1047     run write-log-and-file in p-log-handle (
     1048           input 1
     1049         , input log-file-name
     1050         , input 1
     1051         , input substitute("Ошибка входных параметров &1:&2&3&4"
     1052                            , p-parameter
     1053                            , chr(10)
     1054                            , v-esm
     1055                            , return-value
     1056                            )).
     1057     assign
     1058     v-view-log = yes.
     1059     return.
     1060   end.
     1061   if p-rs-1 <> 1
     1062   and p-rs-1 <> 2 then do:
     1063     v-esm = substitute("Неизвестное значение параметра выбора фирмы:&1", p-rs-1).
     1064     run write-log-and-file in p-log-handle (
     1065           input 1
     1066         , input log-file-name
     1067         , input 1
     1068         , input substitute("Ошибка входных параметров &1:&2&3&4"
     1069                            , p-parameter
     1070                            , chr(10)
     1071                            , v-esm
     1072                            , return-value
     1073                            )).
     1074     assign
     1075     v-view-log = yes.
     1076     return.
     1077   end.
     1078   if p-rs-1 <> 2
     1079   and (p-rs-hsch <> 1
     1080        or
     1081        p-rs-csch <> 1)
     1082   then do:
     1083     v-esm = substitute("Несопоставимые значения параметра выбора фирмы (&1)" +
     1084                        " и параметра выбора счетов фирмы (&2)" +
     1085                        " и/или параметра выбора счетов контрагента (&3)"
     1086                        , p-rs-1
     1087                        , p-rs-hsch
     1088                        , p-rs-csch
     1089                        ).
     1090     run write-log-and-file in p-log-handle (
     1091           input 1
     1092         , input log-file-name
     1093         , input 1
     1094         , input substitute("Ошибка входных параметров &1:&2&3&4"
     1095                            , p-parameter
     1096                            , chr(10)
     1097                            , v-esm
     1098                            , return-value
     1099                            )).
     1100     assign
     1101     v-view-log = yes.
     1102     return.
     1103   end.
     1104   run analyze-date-range in this-procedure (
     1105       input v-date-range
     1106       , output p-date-from
     1107       , output p-date-to
     1108   ) no-error.
     1109   if error-status :error
     1110   or p-date-from  = ?
     1111   or p-date-to    = ?
     1112   then do:
     1113     run write-log-and-file in p-log-handle (
     1114           input 1
     1115         , input log-file-name
     1116         , input 1
     1117         , input  substitute( "Ошибка входных параметров:Не удалось определить интервал дат для выгрузки.&1&2 &3"
     1118                                       , chr(10)
     1119                                       , return-value
     1120                                       , error-status :get-message( 1 )
     1121                                   )
     1122                                            ).
     1123     assign
     1124     v-view-log = yes.
     1125     return.
     1126   end.
     1127   CASE p-format:
     1128     when '1s':U then do:
     1129        run proc-main-1s in this-procedure no-error .
     1130     end.
     1131   END CASE.
     1132   if error-status:error then do:
     1133     run write-log-and-file in p-log-handle (
     1134           input 1
     1135         , input log-file-name
     1136         , input 1
     1137         , input substitute("Ошибка при экспорте данных в систему КЛИЕНТ-БАНК в формате&1&2&3 &4"
     1138                            , entry (lookup (p-format, '1s':U) + 1, ',' + '1С':U)
     1139                            , chr(10)
     1140                            , error-status:get-message(1)
     1141                            , return-value
     1142                            )).
     1143     assign
     1144     v-view-log = yes.
     1145   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1146   if v-view-log
     1147   and not g#news
     1148   and not g#auto
     1149   then do:
     1150     message
     1151     substitute('!!!В процессе Экспорта в систему КЛИЕНТ-БАНК  произошли ошибки!!!')  skip
     1152     "!!!Внимательно прочитайте Log-file!!"
     1153     view-as alert-box error .
     1154        define variable v-user-action7   as character no-undo .
     1155     define variable v-printed7       as logical   no-undo .
     1156     run gbl/prnfilen.w
     1157       (input  (substitute('!!!В процессе Экспорта в систему КЛИЕНТ-БАНК  произошли ошибки!!!'))
     1158       ,input  0
     1159       ,input  (string("./":U) + 'ext-cbnk.log')
     1160       ,input  7
     1161       ,output v-user-action7
     1162       ,output v-printed7
     1163       ) .
     1164   end.
     1165   if v-view-log = true
     1166   and (g#news
     1167   or g#auto)
     1168   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     1169   then do:
     1170      run cb_set-view-log in p-parent-handle ( input yes).
     1171   end.
     1172    .
     1173     return "error":U.
     1174   end.
     1175   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1176   if v-view-log
     1177   and not g#news
     1178   and not g#auto
     1179   then do:
     1180     message
     1181     substitute('!!!В процессе Экспорта в систему КЛИЕНТ-БАНК  произошли ошибки!!!')  skip
     1182     "!!!Внимательно прочитайте Log-file!!"
     1183     view-as alert-box error .
     1184        define variable v-user-action9   as character no-undo .
     1185     define variable v-printed9       as logical   no-undo .
     1186     run gbl/prnfilen.w
     1187       (input  (substitute('!!!В процессе Экспорта в систему КЛИЕНТ-БАНК  произошли ошибки!!!'))
     1188       ,input  0
     1189       ,input  (string("./":U) + 'ext-cbnk.log')
     1190       ,input  7
     1191       ,output v-user-action9
     1192       ,output v-printed9
     1193       ) .
     1194   end.
     1195   if v-view-log = true
     1196   and (g#news
     1197   or g#auto)
     1198   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     1199   then do:
     1200      run cb_set-view-log in p-parent-handle ( input yes).
     1201   end.
     1202    .
     1203   procedure proc-main-1s :
     1204   define buffer buf_sysconf for ub.sysconf.
     1205   define buffer buf_fin-doc for ub.fin-doc.
     1206   define variable v-count as integer no-undo .
     1207   define variable ii as integer no-undo .
     1208     do
     1209     on error undo, return error return-value
     1210     :
     1211       run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("Экспорт документов в систему КЛИЕНТ-БАНК по формату &1", entry (lookup (p-format, '1s':U) + 1, ',' + '1С':U))).
     1212       if p-rs-1 = 1 then do:
     1213         run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("     Фирмы: Все")).
     1214       end.
     1215       else do:
     1216         run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("     Фирмы:")).
     1217         for each temp_obj-list no-lock:
     1218                         run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("     &1&2", temp_obj-list.obj-type, temp_obj-list.obj-code)).
     1219         end.
     1220       end.
     1221       if p-rs-hsch = 1 then do:
     1222         run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("     Счета фирм: Все")).
     1223       end.
     1224       else do:
     1225         run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("     Счета фирм:")).
     1226         for each temp_hfin-schet no-lock:
     1227                         run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input SUBSTITUTE("&1 &2&3 &4/&5",                                          temp_hfin-schet.r-schet                                        ,temp_hfin-schet.cli-type                                       ,temp_hfin-schet.cli-code                                       ,temp_hfin-schet.code-bank                                      ,temp_hfin-schet.code-schet)).
     1228         end.
     1229       end.
     1230       if p-rs-csch = 1 then do:
     1231         run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("     Счета контрагентов: Все")).
     1232       end.
     1233       else do:
     1234         run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("     Счета контрагентов:")).
     1235         for each temp_cfin-schet no-lock:
     1236                         run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input SUBSTITUTE("&1 &2&3 &4/&5",                                          temp_cfin-schet.r-schet                                        ,temp_cfin-schet.cli-type                                       ,temp_cfin-schet.cli-code                                       ,temp_cfin-schet.code-bank                                      ,temp_cfin-schet.code-schet)).
     1237         end.
     1238       end.
     1239       run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("     Типы документов:")).
     1240        do ii = 1 to num-entries(p-doc-type-list):
     1241       run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("&1", entry (lookup (entry(ii, p-doc-type-list), 'пко,рко,ппп,рпп,апп,апр,':U), 'приходный кассовый ордер,расходный кассовый ордер,приходное платежное поручение,расходное платежное поручение,апп,апр':U) )).
     1242        end.
     1243       run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("     Интервал дат: с &1 по &2", string(p-date-from, "99/99/9999"), string(p-date-to, "99/99/9999"))).
     1244       run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("     Кодировка: &1",  if p-encoding = "windows-1251" then 'Windows' else 'DOS')).
     1245        _buf_sysconf:
     1246        for each buf_sysconf  no-lock:
     1247          if p-rs-1 = 2 then do:
     1248            find first temp_obj-list no-lock where
     1249                       temp_obj-list.obj-type = 'орг':U
     1250                   AND temp_obj-list.obj-code = buf_sysconf.host-code no-error .
     1251            if not available temp_obj-list then next _buf_sysconf.
     1252          end.
     1253          do ii = 1 to num-entries(p-doc-type-list):
     1254           _buf_fin-doc:
     1255           for each buf_fin-doc no-lock where
     1256                   buf_fin-doc.host-code = buf_sysconf.host-code
     1257               AND  buf_fin-doc.fin-ext-doc-type = entry(ii, p-doc-type-list)
     1258               and status_ = 'банк':U
     1259               and buf_fin-doc.doc-date >= p-date-from
     1260               AND buf_fin-doc.doc-date <= p-date-to:
     1261             if p-rs-hsch = 2  then do:
     1262               find first temp_hfin-schet no-lock where
     1263                         temp_hfin-schet.host-code = buf_sysconf.host-code
     1264                     AND temp_hfin-schet.code-schet = buf_fin-doc.payer-code-schet no-error.
     1265               if not available temp_hfin-schet then next _buf_fin-doc.
     1266             end.
     1267             if p-rs-csch = 2  then do:
     1268               find first temp_cfin-schet no-lock where
     1269                         temp_cfin-schet.host-code = buf_sysconf.host-code
     1270                     AND temp_cfin-schet.code-schet = buf_fin-doc.receiver-code-schet no-error.
     1271               if not available temp_cfin-schet then next _buf_fin-doc.
     1272             end.
     1273             find first temp-bik where
     1274                       temp-bik.host-code = buf_fin-doc.host-code
     1275                   AND temp-bik.bik = buf_fin-doc.payer-bik no-error.
     1276             if not available temp-bik then do:
     1277               run export-header-1s in this-procedure (
     1278                                                       input buf_fin-doc.host-code
     1279                                                     , input buf_fin-doc.payer-bik
     1280                                                       ) no-error .
     1281               if error-status:error then do:
     1282                 run write-log-and-file in p-log-handle (
     1283                       input 1
     1284                     , input log-file-name
     1285                     , input 1
     1286                     , input  substitute( "!!!Ошибка записи заголовка файла для выгрузки в формате &1&2 Фирма &3 Банк с БИК &4&2&5 &6&2" +
     1287                                          "!!!Финдокументы по фирме &3 БИК &4 экспортироваться не будут!"
     1288                                                   , entry (lookup (p-format, '1s':U) + 1, ',' + '1С':U)
     1289                                                   , chr(10)
     1290                                                   , buf_fin-doc.host-code
     1291                                                   , buf_fin-doc.payer-bik
     1292                                                   , return-value
     1293                                                   , error-status :get-message( 1 )
     1294                                               )
     1295                                                       ).
     1296                 assign
     1297                 v-view-log = yes.
     1298               end.
     1299             end.
     1300             find first temp-bik where
     1301                       temp-bik.host-code = buf_fin-doc.host-code
     1302                   AND temp-bik.bik = buf_fin-doc.payer-bik no-error.
     1303             if not available temp-bik
     1304             or temp-bik.f_name = '':U then next _buf_fin-doc.
     1305             CASE buf_fin-doc.fin-ext-doc-type:
     1306               when 'рпп':U then do:
     1307                 run export-fin-doc-ec-1s in this-procedure (
     1308                                                           buffer buf_fin-doc
     1309                                                         , input temp-bik.f_name
     1310                                                         , input temp-bik.adresat
     1311                                                         ) no-error .
     1312               end.
     1313             END CASE.
     1314             if error-status:error then do:
     1315                 run write-log-and-file in p-log-handle (
     1316                       input 1
     1317                     , input log-file-name
     1318                     , input 1
     1319                     , input  substitute( "Ошибка экспорта финдокумента &5 при выгрузке в формате &1&2&3 &4"
     1320                                                   , entry (lookup (p-format, '1s':U) + 1, ',' + '1С':U)
     1321                                                   , chr(10)
     1322                                                   , return-value
     1323                                                   , error-status :get-message( 1 )
     1324                                                   , buf_fin-doc.prn-doc-code
     1325                                               )
     1326                                                       ).
     1327               assign
     1328               v-view-log = yes.
     1329               NEXT _buf_fin-doc.
     1330             end.
     1331             else do:
     1332               assign
     1333               v-count = v-count + 1
     1334               temp-bik.d-count = temp-bik.d-count + 1
     1335               .
     1336               run show-counter in p-log-handle .
     1337               run write-counter in p-log-handle (substitute("Экспорт БИК &1 Фирма &2: экспортировано документов &3"
     1338                                               , temp-bik.bik
     1339                                               , temp-bik.host-code
     1340                                               , temp-bik.d-count)).
     1341             end.
     1342           end.
     1343         end.
     1344       end.
     1345       ii = 0.
     1346       for each temp-bik no-lock:
     1347         if temp-bik.f_name = '':U then next.
     1348         run export-footer-1s in this-procedure (
     1349                                                 input temp-bik.host-code
     1350                                               , input temp-bik.bik
     1351                                               , input temp-bik.f_name
     1352                                               , input temp-bik.o_name
     1353                                               , input temp-bik.d-count).
     1354         assign
     1355         ii = 1.
     1356       end.
     1357       if ii = 0 then do:
     1358         run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input "!!!Не удалось экспортировать финдокументы или найдено ни одного финдокумента для экспорта").
     1359       end.
     1360     end.
     1361   end procedure.
     1362   procedure export-header-1s :
     1363   define input parameter p-host-code like ub.sysconf.host-code no-undo .
     1364   define input parameter p-bik       like ub.fin-bank.bik no-undo .
     1365   define variable loc-in_ as character no-undo .
     1366   define variable loc-spl as character no-undo .
     1367   define variable loc-sav as character no-undo .
     1368   define variable loc-out as character no-undo .
     1369   define variable loc-adresat as character no-undo .
     1370   DEFINE VARIABLE v-today as date no-undo .
     1371   DEFINE VARIABLE v-time as integer no-undo .
     1372   define variable ii as integer no-undo .
     1373   define variable v-doc-type-1s as character no-undo .
     1374   define variable v-version as character no-undo .
     1375   define buffer buf_fin-bank for ub.fin-bank.
     1376   define buffer buf_fin-schet for ub.fin-schet.
     1377   define buffer buf_temp_hfin-schet for temp_hfin-schet.
     1378   define buffer find_first-fin-bank for ub.fin-bank.
     1379     do
     1380     on error undo, return error
     1381     :
     1382       find first buf_fin-bank no-lock where
     1383                   buf_fin-bank.host-code = p-host-code
     1384               AND buf_fin-bank.bik = p-bik.
     1385       create temp-bik.
     1386       assign
     1387       temp-bik.host-code = p-host-code
     1388       temp-bik.bik       = p-bik
     1389       .
     1390       run bge/cbnkinis.p (
     1391                            input parparentproc
     1392                          , input p-format
     1393                          , input p-bik
     1394                          , input p-host-code
     1395                          , input "send":U
     1396                          , output loc-out
     1397                          , output LOC-in_
     1398                          , output LOC-spl
     1399                          , output LOC-sav
     1400                          , output loc-adresat
     1401                          )  no-error .
     1402       if error-status:error then do:
     1403         run write-log-and-file in p-log-handle (
     1404               input 1
     1405             , input log-file-name
     1406             , input 1
     1407             , input substitute("!!!Не удалось получить настройки для системы КЛИЕНТ-БАНК формата &1 для БИК &2 фирма &3 из ini-файла:&4&5 &6"
     1408                                 , p-format
     1409                                 , p-bik
     1410                                 , p-host-code
     1411                                 , chr(10)
     1412                                 , error-status:get-message(1)
     1413                                 , return-value)).
     1414         assign
     1415         v-view-log = yes.
     1416         undo,  return error.
     1417       end.
     1418       assign
     1419       temp-bik.f_name = substitute("&1&2\&3.dat", loc-out, loc-spl, substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 ), '.dat')
     1420       temp-bik.o_name = substitute("&1&2\&3", loc-out, loc-spl , '1C_to_KL.txt')
     1421       temp-bik.adresat = loc-adresat
     1422       .
     1423       if p-encoding <> 'windows-1251' then do:
     1424         output stream PrnLibStream
     1425         to value(  temp-bik.f_name ) convert target p-encoding.
     1426       end.
     1427       else do:
     1428         output stream PrnLibStream
     1429         to value(  temp-bik.f_name ) .
     1430       end.
     1431       run cur-time in this-procedure ( output v-today
     1432                                      , output v-time
     1433                                      ).
     1434       run gbl/getvers.p (output v-version).
     1435       v-version = substitute('IBS TH &1', v-version).
     1436       put stream PrnLibStream unformatted
     1437       '1CClientBankExchange' skip
     1438       'ВерсияФормата=1.01'   skip
     1439       'Кодировка=' (if p-encoding = 'windows-1251' then 'Windows':U else 'DOS') skip
     1440       'Отправитель=' v-version skip
     1441       'Получатель=' loc-adresat skip
     1442       'ДатаСоздания=' string(v-today, "99/99/9999") skip
     1443       'ВремяСоздания=' string(v-time, "HH:MM:SS") skip
     1444       'ДатаНачала=' string(p-date-from, "99/99/9999") skip
     1445       'ДатаКонца=' string(p-date-to, "99/99/9999") skip
     1446       .
     1447       _buf_fin-schet:
     1448       FOR EACH find_first-fin-bank no-lock where
     1449               find_first-fin-bank.host-code = p-host-code
     1450           AND find_first-fin-bank.bik       = p-bik
     1451           AND find_first-fin-bank.status_   = 'тек':U,
     1452          each buf_fin-schet no-lock where
     1453               buf_fin-schet.host-code = p-host-code
     1454          AND  buf_fin-schet.code-bank = find_first-fin-bank.code-bank
     1455          AND  buf_fin-schet.status_       = 'тек':U:
     1456         if p-rs-csch = 2 then do:
     1457             find first buf_temp_hfin-schet no-lock where
     1458                       buf_temp_hfin-schet.host-code = buf_fin-schet.host-code
     1459                   AND buf_temp_hfin-schet.code-schet = buf_fin-schet.code-schet no-error.
     1460             if not available buf_temp_hfin-schet then next _buf_fin-schet.
     1461         end.
     1462         put stream PrnLibStream unformatted
     1463         'РасчСчет='  buf_fin-schet.r-schet skip
     1464         .
     1465       end.
     1466       do ii = 1 to num-entries(p-doc-type-list):
     1467         CASE entry(ii, p-doc-type-list):
     1468           when 'рпп':U then do:
     1469             v-doc-type-1s =  'Платежное поручение'.
     1470           end.
     1471         END CASE.
     1472         put stream PrnLibStream unformatted
     1473         'Документ='  v-doc-type-1s skip.
     1474         .
     1475       end.
     1476       output stream PrnLibStream close.
     1477     end.
     1478   end procedure.
     1479   procedure export-fin-doc-ec-1s :
     1480   define parameter buffer buf_fin-doc for ub.fin-doc.
     1481   define input parameter p-f_name as character no-undo .
     1482   define input parameter p-adresat as character no-undo .
     1483   define variable h_fin-doc as handle no-undo .
     1484   define variable h_field as handle no-undo .
     1485   define buffer locked_fin-doc for ub.fin-doc.
     1486   define buffer buf_fin-bank for ub.fin-bank.
     1487   define buffer buf_rfin-bank for ub.fin-bank.
     1488   define buffer buf_fin-schet for ub.fin-schet.
     1489   define buffer buf_rfin-schet for ub.fin-schet.
     1490     do
     1491     on error undo, return error
     1492     :
     1493       find first locked_fin-doc where
     1494                  recid(locked_fin-doc) = recid(buf_fin-doc).
     1495       if p-encoding <> 'windows-1251' then do:
     1496         output stream PrnLibStream
     1497         to value(  p-f_name ) convert target p-encoding append.
     1498       end.
     1499       else do:
     1500         output stream PrnLibStream
     1501         to value(  p-f_name ) append.
     1502       end.
     1503       find first buf_fin-schet no-lock where
     1504                 buf_fin-schet.host-code = buf_fin-doc.host-code
     1505             AND buf_fin-schet.code-schet = buf_fin-doc.payer-code-schet .
     1506       if buf_fin-schet.status_ <> 'тек':U then do:
     1507         run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Финдокумент &1 (фирма &2)&3Счет Плательщика имеет статус &4&3Экспорт невозможен"                             , buf_fin-doc.prn-doc-code                                                                                       , buf_fin-doc.host-code                                                                                          , chr(10)                                                                                                  ,buf_fin-schet.status_                                                                )).
     1508         output stream PrnLibStream close.
     1509         return.
     1510       end.
     1511       find first buf_fin-bank no-lock where
     1512                 buf_fin-bank.host-code = buf_fin-doc.host-code
     1513             AND buf_fin-bank.code-bank = buf_fin-schet.code-bank .
     1514       if buf_fin-bank.status_ <> 'тек':U then do:
     1515         run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Финдокумент &1 (фирма &2)&3Банк Плательщика имеет статус &4&3Экспорт невозможен"                             , buf_fin-doc.prn-doc-code                                                                                       , buf_fin-doc.host-code                                                                                          , chr(10)                                                                                                  ,buf_fin-bank.status_                                                                )).
     1516         output stream PrnLibStream close.
     1517         return.
     1518       end.
     1519       find first buf_rfin-schet no-lock where
     1520                 buf_rfin-schet.host-code = buf_fin-doc.host-code
     1521             AND buf_rfin-schet.code-schet = buf_fin-doc.receiver-code-schet .
     1522       if buf_rfin-schet.status_ <> 'тек':U then do:
     1523         run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Финдокумент &1 (фирма &2)&3Счет Получателя имеет статус &4&3Экспорт невозможен"                              , buf_fin-doc.prn-doc-code                                                                                       , buf_fin-doc.host-code                                                                                          , chr(10)                                                                                                  ,buf_rfin-schet.status_                                                                )).
     1524         output stream PrnLibStream close.
     1525         return.
     1526       end.
     1527       find first buf_rfin-bank no-lock where
     1528                 buf_rfin-bank.host-code = buf_fin-doc.host-code
     1529             AND buf_rfin-bank.code-bank = buf_rfin-schet.code-bank .
     1530       if buf_fin-bank.status_ <> 'тек':U then do:
     1531         run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Финдокумент &1 (фирма &2)&3Банк Получателя имеет статус &4&3Экспорт невозможен"                             , buf_fin-doc.prn-doc-code                                                                                       , buf_fin-doc.host-code                                                                                          , chr(10)                                                                                                  ,buf_rfin-bank.status_                                                                )).
     1532         output stream PrnLibStream close.
     1533         return.
     1534       end.
     1535       assign
     1536       h_fin-doc = buffer locked_fin-doc:handle
     1537       .
     1538       find first temp_hfields no-lock no-error.
     1539       if not available temp_hfields then do:
     1540         run create-temp-hfields in this-procedure ('exp').
     1541       end.
     1542       put stream PrnLibStream unformatted
     1543       'СекцияДокумент=Платежное поручение' skip.
     1544       for each temp_hfields by temp_hfields.order_:
     1545         CASE temp_hfields.name_:
     1546           when 'doc-date' then do:
     1547             put stream PrnLibStream unformatted
     1548             temp_hfields.label_ string(h_fin-doc:buffer-field(temp_hfields.name_):buffer-value, "99.99.9999") skip
     1549             .
     1550           end.
     1551           when 'sum-doc' then do:
     1552             put stream PrnLibStream unformatted
     1553             temp_hfields.label_ trim(string(h_fin-doc:buffer-field(temp_hfields.name_):buffer-value, ">>>>>>>>>>>>9.99")) skip
     1554             .
     1555           end.
     1556           when "payer-inn/payer-name"
     1557           OR
     1558           WHEN "RECEIVER-inn/RECEIVER-name"
     1559           then do:
     1560             put stream PrnLibStream unformatted
     1561             temp_hfields.label_
     1562             substitute("ИНН &1 &2"
     1563                         ,h_fin-doc:buffer-field(entry(1, temp_hfields.name_, chr(47))):buffer-value
     1564                         ,h_fin-doc:buffer-field(entry(2, temp_hfields.name_, chr(47))):buffer-value
     1565                       )
     1566             skip
     1567             .
     1568           end.
     1569           when 'naznach-plat/' then do:
     1570             put stream PrnLibStream unformatted
     1571             temp_hfields.label_
     1572             replace(h_fin-doc:buffer-field(entry(1, temp_hfields.name_, chr(47))):buffer-value, '@', '')
     1573             skip.
     1574           end.
     1575           otherwise do:
     1576             if h_fin-doc:buffer-field(temp_hfields.name_):data-type = 'date':U then do:
     1577               put stream PrnLibStream unformatted
     1578               temp_hfields.label_ string(h_fin-doc:buffer-field(temp_hfields.name_):buffer-value, "99.99.9999") skip
     1579               .
     1580             end.
     1581             else do:
     1582               put stream PrnLibStream unformatted
     1583               temp_hfields.label_ h_fin-doc:buffer-field(temp_hfields.name_):buffer-value skip
     1584               .
     1585             end.
     1586           end.
     1587         END CASE.
     1588       end.
     1589       put stream PrnLibStream unformatted
     1590       'КонецДокумента' skip.
     1591       output stream PRnLibStream close.
     1592       assign
     1593       locked_fin-doc.pay-author = p-adresat.
     1594     end.
     1595   end procedure.
     1596   procedure export-footer-1s :
     1597   define input parameter p-host-code like ub.sysconf.host-code no-undo .
     1598   define input parameter p-bik       like ub.fin-bank.bik      no-undo .
     1599   define input parameter p-f_name    as character no-undo .
     1600   define input parameter p-o_name    as character no-undo .
     1601   define input parameter p-count     as integer no-undo .
     1602   define variable v-os-err as integer no-undo .
     1603   define variable v-os-err-name as character no-undo .
     1604     do
     1605     on error undo, return error
     1606     :
     1607       if p-encoding <> 'windows-1251' then do:
     1608         output stream PrnLibStream
     1609         to value(  p-f_name ) convert target p-encoding append.
     1610       end.
     1611       else do:
     1612         output stream PrnLibStream
     1613         to value(  p-f_name ) append.
     1614       end.
     1615       put stream PrnLibStream unformatted
     1616       'КонецФайла'
     1617       skip.
     1618       output stream PRnLibStream close.
     1619       OS-RENAME value(p-f_name ) value(p-o_name).
     1620       assign
     1621       v-os-err = os-error.
     1622       if v-os-err <> 0 then do:
     1623         if v-os-err <> 10 then do:
     1624          run gbl/os-errnm.p (v-os-err, output v-os-err-name).
     1625         end.
     1626          run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("БИК &1 Фирма &2&4 - файл экспорта &3:&4экспортировано документов: &5&4" +                              "!!!Не удалось сохранить файл с именем &6:&4&7"                      ,p-bik                                                                                     ,p-host-code                                                                               ,p-f_name                                                                                  ,chr(10)                                                                              ,p-count                                                                                   ,p-o_name                                                                                  ,(if v-os-err = 10 then 'Возможно не был перемещен файл, полученный в предудыщем сеансе экспорта' else v-os-err-name ))).
     1627       end.
     1628       else do:
     1629         run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("БИК &1 Фирма &2&4 - файл экспорта &3:&4экспортировано документов: &5"                      ,p-bik                                                                                     ,p-host-code                                                                               ,p-o_name                                                                                  ,chr(10)                                                                              ,p-count)).
     1630       end.
     1631     end.
     1632   end procedure.
     1633   procedure analyze-date-range :
     1634   do
     1635   on error undo, return error
     1636   :
     1637   define input parameter p-date-range  as character    no-undo.
     1638   define output parameter p-date-from  as date         no-undo.
     1639   define output parameter p-date-to    as date         no-undo.
     1640       define variable v-today         as date      no-undo.
     1641       define variable v-time          as integer   no-undo.
     1642       define variable v-days-ago      as integer       no-undo.
     1643       define variable v-days-amount   as integer       no-undo.
     1644       run cur-time in this-procedure ( output v-today
     1645                                      , output v-time
     1646                                      ).
     1647       case entry( 1, p-date-range )
     1648       :
     1649           when "0"
     1650           then do:
     1651               assign
     1652                   v-days-ago    = integer( entry( 3, p-date-range ) )
     1653                   v-days-amount = integer( entry( 2, p-date-range ) )
     1654               .
     1655               assign
     1656                   p-date-from = v-today - v-days-ago
     1657                   p-date-to   = v-today - v-days-ago + v-days-amount
     1658               .
     1659               if p-date-to > v-today
     1660               then do:
     1661                   assign
     1662                     p-date-to = v-today
     1663                   .
     1664               end.
     1665           end.
     1666           when "1"
     1667           then do:
     1668               assign
     1669                   p-date-from = date( entry( 4, p-date-range ) )
     1670                   p-date-to   = v-today
     1671               .
     1672           end.
     1673           when "2"
     1674           then do:
     1675               assign
     1676                   p-date-from = date( entry( 4, p-date-range ) )
     1677                   p-date-to   = date( entry( 5, p-date-range ) )
     1678               .
     1679           end.
     1680           otherwise do:
     1681               assign
     1682                   p-date-from = ?
     1683                   p-date-to   = ?
     1684               .
     1685           end.
     1686       end case.
     1687   end.
     1688   end procedure.
