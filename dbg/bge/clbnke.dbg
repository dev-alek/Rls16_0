      387   procedure init-host-list :
      388   define input parameter p-host-list as character no-undo .
      389   define variable v-counter as integer no-undo .
      390   define buffer buf_temp_obj-list for temp_obj-list.
      391     do
      392     on error undo, return error
      393     :
      394     for each buf_temp_obj-list
      395     :
      396         delete buf_temp_obj-list.
      397     end.
      398     do v-counter = 1 to num-entries( p-host-list ) / 2
      399     :
      400         create buf_temp_obj-list.
      401         assign
      402             buf_temp_obj-list.obj-type = entry( 2 * v-counter - 1,  p-host-list )
      403             buf_temp_obj-list.obj-code = integer( entry( 2 * v-counter,      p-host-list ) )
      404         .
      405     end.
      406     end.
      407   end procedure.
      408   procedure fill-hfin-schet :
      409   define input parameter p-hfin-schet as character no-undo .
      410   define variable v-counter as integer no-undo .
      411   define buffer buf_temp_hfin-schet for temp_hfin-schet.
      412     do
      413     on error undo, return error return-value
      414     :
      415         for each buf_temp_hfin-schet
      416         :
      417             delete buf_temp_hfin-schet.
      418         end.
      419         do v-counter = 1 to num-entries( p-hfin-schet ) / 6
      420         :
      421             create buf_temp_hfin-schet.
      422             assign
      423             buf_temp_hfin-schet.host-code = integer( entry( 6 * v-counter - 5,      p-hfin-schet ) )
      424             buf_temp_hfin-schet.r-schet = entry( 6 * v-counter - 4,  p-hfin-schet )
      425             buf_temp_hfin-schet.cli-type =  entry( 6 * v-counter - 3,      p-hfin-schet )
      426             buf_temp_hfin-schet.cli-code = integer( entry( 6 * v-counter - 2,      p-hfin-schet ) )
      427             buf_temp_hfin-schet.code-bank = integer( entry( 6 * v-counter - 1,      p-hfin-schet ) )
      428             buf_temp_hfin-schet.code-schet = integer( entry( 6 * v-counter,      p-hfin-schet ) )
      429             .
      430         end.
      431     end.
      432   end procedure.
