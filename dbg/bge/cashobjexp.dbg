        1   define variable vss-revision    as character no-undo init "$Revision:$":U .
        2   define variable vss-author      as character no-undo init "$Author:$":U .
        3   define variable vss-date        as character no-undo init "$Date:$":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
        5   define variable vss-archive     as character no-undo init "$Archive:$":U .
        6   define variable vss-description as character no-undo init "".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   function objExists return character
       62   (input  ifolder as character,
       63    input  iType   as character  ):
       64       define variable vFileType as character no-undo init "D,F".
       65       define variable vi        as integer no-undo.
       66       define variable vtype as character no-undo.
       67       if iType ne ?
       68       then
       69          vFileType = iType.
       70       do vi = 1 to num-entries(vFileType):
       71          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
       72          vtype = file-information:file-type.
       73          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
       74             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
       75             index(vtype , entry(vi,vFileType )) > 0
       76          then return file-information:full-pathname .
       77          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
       78          vtype = file-information:file-type.
       79          if file-information:file-name <> "" and
       80             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
       81             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
       82             index( vtype, entry(vi,vFileType )) > 0
       83          then return file-information:full-pathname .
       84       end.
       85       return ? .
       86   end.
       87   function SearchFile return character
       88   (input  ifile as character):
       89      return objExists(ifile,?).
       90   end.
       91   function SearchPFile return character
       92   (input inFile as char):
       93        define variable oFile       as character no-undo.
       94        define variable vFileSearch as character no-undo.
       95        define variable vNumEntry   as integer no-undo.
       96        if inFile = "" then return ?.
       97        vNumEntry = num-entries(inFile,".").
       98        vFileSearch = inFile.
       99        if    vNumEntry > 0
      100           and (   entry(vNumEntry,inFile,".") eq "p"
      101                or entry(vNumEntry,inFile,".") eq "w")
      102        then do:
      103           entry(vNumEntry,vFileSearch, ".") = "r".
      104           oFile = search(vFileSearch ).
      105           if oFile eq ?
      106           then
      107              oFile = search(inFile).
      108        end.
      109        else
      110           oFile = search(vFileSearch).
      111        return oFile.
      112     end.
      113   define buffer code        for ub.code.
      114   define buffer b-clients   for ub.clients.
      115   define buffer b-cash-desk for ub.cash-desk.
      116   define buffer sys-ctrl    for ub.sys-ctrl.
      117   define new global shared variable g#language as character no-undo .
      118   if g#language <> '' and g#language <> 'rus':U then do:
      119     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      120   end.
      121   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      122   define variable v-waitfram-action01         as character   no-undo .
      123   define variable v-waitfram-action02         as character   no-undo .
      124   define variable v-waitfram-action03         as character   no-undo .
      125   define variable mWaitFramTextBeg            as character   no-undo.
      126   define variable mWaitFramTextEnd            as character   no-undo.
      127   define variable mWaitFramView               as logical     no-undo.
      128   define variable mWaitProcEvent              as logical     no-undo init yes.
      129   define variable mWaitFramInterval           as integer     no-undo init 1 .
      130   define variable mWaitFramStop               as logical     no-undo.
      131   define variable mWaitFramStopUser           as logical     no-undo.
      132   define variable mWaitFramStopTimeOut        as logical     no-undo.
      133   define variable mWaitFramStartProc          as datetime-tz no-undo.
      134   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      135   define button B-WaitFramStop auto-end-key
      136        label "Стоп"
      137        size 10 by 1 tooltip "Остоновить процесс".
      138   define button B-viewProcInfo
      139        label "Информация"
      140        size 15 by 1 tooltip "Информация о процесс".
      141   define frame waitfram
      142     v-waitfram-action01 format "x(72)" no-label skip
      143     v-waitfram-action02 format "x(72)" no-label skip
      144     v-waitfram-action03 format "x(72)" no-label skip
      145     B-viewProcInfo
      146     B-WaitFramStop at row 4 col 30
      147     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      148     .
      149   define new global shared variable mBatchMode as logical no-undo init ?.
      150   define variable mFramBachModHandle as handle no-undo.
      151   mFramBachModHandle = frame waitfram:handle.
      152   define variable mFameOldVis as logical no-undo.
      153   define variable mVisCUrentVin as logical no-undo.
      154   if session:batch-mode
      155   then
      156      mBatchMode = yes.
      157   if mBatchMode = ? then do:
      158     mVisCUrentVin = current-window:visible.
      159     mFameOldVis = mFramBachModHandle:visible.
      160     mFramBachModHandle:visible  = yes.
      161     mBatchMode = mFramBachModHandle:visible ne yes.
      162     mFramBachModHandle:visible = mFameOldVis.
      163     current-window:visible = mVisCUrentVin.
      164   end.
      165    if  log-manager:logfile-name ne ?
      166     then DO:
      167         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      168         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      169         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      170     end.
      171   on choose of B-WaitFramStop in frame waitfram
      172   do:
      173     mWaitFramStop = yes.
      174     mWaitFramStopUser = yes.
      175   end.
      176   function waitfram-check-timeout returns logical():
      177      define variable vtime as int64 no-undo.
      178      if mWaitFramStopTimeOut
      179      then
      180         return yes.
      181      vtime = ( now - mWaitFramStartProc ) / 1000 .
      182      if     mWaitFramTimeOut ne ?
      183         and mWaitFramTimeOut ne 0
      184         and mWaitFramTimeOut lt vtime
      185      then do:
      186         mWaitFramStopTimeOut = yes.
      187      end.
      188      return mWaitFramStopTimeOut.
      189   end.
      190   procedure waitfram-hide :
      191     if not session:batch-mode
      192     then do
      193     on error undo, return error return-value
      194     :
      195       pause 0 before-hide .
      196       if not mBatchMode then
      197         hide frame waitfram .
      198     if     not mWaitFramView
      199        and mWaitProcEvent
      200     then
      201       process events .
      202     end.
      203   end procedure.
      204   procedure waitfram-show :
      205     define input  parameter p-message as character no-undo .
      206     define variable v-left-margin as integer   no-undo .
      207     if not session:batch-mode
      208     then do
      209     on error undo, return error return-value
      210     :
      211       if length(p-message) <= 70 then do:
      212         assign
      213           v-left-margin = integer((70 - length(p-message)) / 2)
      214         .
      215         assign
      216           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      217         .
      218         assign
      219           v-waitfram-action01 = " "
      220           v-waitfram-action02 = " "
      221                                    + fill(" ", v-left-margin)
      222                                    + p-message
      223           v-waitfram-action03 = " "
      224         .
      225       end.
      226       else do:
      227         define variable vRindex1 as integer no-undo.
      228         define variable vRindex2 as integer no-undo.
      229         vRindex1 = r-index(p-message," ",70).
      230         if vRindex1 = 0
      231         then
      232            vRindex1 = 70.
      233         if length(p-message)  <= vRindex1 + 70 then do:
      234           assign
      235             v-waitfram-action01 = " "
      236             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      237             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      238           .
      239         end.
      240         else do:
      241           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      242           if vRindex2 <= vRindex1
      243           then
      244              vRindex2 = vRindex1 + 70.
      245           assign
      246             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      247             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      248             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      249           .
      250         end.
      251       end.
      252       B-viewProcInfo:visible   in frame waitfram = no.
      253       B-viewProcInfo:sensitive in frame waitfram = no.
      254       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      255       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      256       if  (   mWaitFramView
      257          or  mWaitProcEvent)
      258          and not mBatchMode
      259       then
      260          display
      261             v-waitfram-action01 skip
      262             v-waitfram-action02 skip
      263             v-waitfram-action03 skip
      264          with frame waitfram .
      265       if     mWaitFramView
      266          then do:
      267             if     mWaitFramInterval ne ?
      268                and not mBatchMode
      269             then
      270                wait-for go of frame waitfram pause mWaitFramInterval.
      271          end.
      272          else
      273             if     mWaitProcEvent
      274                and not mBatchMode
      275             then
      276                process events .
      277     end.
      278   end procedure.
      279      procedure waitfram-show-this:
      280         define input  parameter iInterval as int64 no-undo.
      281         define variable vtime as int64 no-undo.
      282         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      283         mWaitFramInterval = iInterval.
      284         run waitfram-show (substitute("&1&2 &3&4" ,
      285                                       mWaitFramTextBeg ,
      286                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      287                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      288                                       mWaitFramTextEnd
      289                                      )
      290                           ).
      291      end.
      292      procedure WaitFramRunPause:
      293         define input  parameter iInterval as dec no-undo.
      294         define variable vStart  as datetime-tz no-undo.
      295         define variable vend    as datetime-tz no-undo.
      296         define variable vint as int64 no-undo.
      297         define variable vOk as logical no-undo.
      298         vStart = now.
      299         vend   = vStart.
      300         publish "WaitFramPause" (iInterval,output vOk).
      301         vend   =  now.
      302         vint = vend - vStart.
      303         vint = iInterval - vint / 1000.
      304         if     not mWaitFramStop
      305            and (   vint > 0
      306                 or (    not vOk
      307                     and iInterval eq ?
      308                     )
      309                 )
      310         then
      311            run waitfram-show-this (iInterval).
      312         vend   =  now.
      313         vint = vend - vStart.
      314         vint = iInterval - vint / 1000.
      315         if     not mWaitFramStop
      316            and vint > 0
      317         then do:
      318            run gbl/pause.p (vint * 1000).
      319         end.
      320         if iInterval ne ?
      321         then
      322            publish "WaitFramStop".
      323         waitfram-check-timeout().
      324      end.
      325      procedure WaitFramWaitFor:
      326         define input  parameter iInterval as dec no-undo.
      327         assign
      328            mWaitFramStartProc   = now
      329            mWaitFramStopUser    = no
      330            mWaitFramStopTimeOut = no
      331         .
      332         block-wait:
      333         do while not mWaitFramStop:
      334            run WaitFramRunPause (iInterval).
      335            if  waitfram-check-timeout()
      336            then do:
      337               leave block-wait.
      338            end.
      339         end.
      340         run waitfram-hide.
      341      end.
      342   procedure waitfram-join :
      343     define input  parameter p-line-1  as character no-undo .
      344     define input  parameter p-line-2  as character no-undo .
      345     define input  parameter p-line-3  as character no-undo .
      346     define output parameter p-message as character no-undo .
      347     do
      348     on error undo, return error return-value
      349     :
      350       assign
      351         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      352                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      353                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      354       .
      355     end.
      356   end procedure.
      357   function waitfram-join-function returns character
      358     (input p-line-1 as character
      359     ,input p-line-2 as character
      360     ,input p-line-3 as character
      361     ).
      362     define variable v-message as character no-undo .
      363     run waitfram-join in this-procedure
      364       (input  p-line-1
      365       ,input  p-line-2
      366       ,input  p-line-3
      367       ,output v-message
      368       ) .
      369     return v-message .
      370   end function .
      371   define new global shared variable g#library  as handle no-undo .
      372   define new global shared variable g#library2 as handle no-undo .
      373   define temp-table tt-code no-undo serialize-name "code" like ub.code.
      374   run waitfram-show ("Ждите...") .
      375   find first sys-ctrl no-lock.
      376   define variable v-sys-key as character no-undo.
      377   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
      378   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
      379     (output v-sys-key
      380     ) no-error .
      381   for each b-clients where b-clients.obj-type eq 'орг':U no-lock:
      382      for first ub.sysconf no-lock where ub.sysconf.host-code = b-clients.obj-code:
      383         create tt-code.
      384         assign
      385            tt-code.parent    = "CashObj"
      386            tt-code.code      = v-sys-key
      387            tt-code.CodeName  = b-clients.obj-name
      388            tt-code.export_   = true
      389         .
      390      end.
      391   end.
      392   if available tt-code
      393   then do:
      394      define variable mparent1 as character no-undo.
      395      mparent1 = substitute ("CashObj&1&2",chr(4),v-sys-key).
      396      for each b-clients where b-clients.obj-type = 'маг':U no-lock:
      397         create tt-code.
      398         assign
      399            tt-code.parent   = mparent1
      400            tt-code.code     = string(b-clients.obj-code)
      401            tt-code.CodeName = b-clients.obj-name
      402            tt-code.export_  = true
      403         .
      404         define variable mparent2 as character no-undo.
      405         mparent2 = substitute ("&2&1&3",chr(4),mparent1,tt-code.code).
      406         for each b-cash-desk where b-cash-desk.db-num   = b-clients.db-num
      407                            and     b-cash-desk.obj-code = b-clients.obj-code
      408                            and not b-cash-desk.is-del
      409         no-lock:
      410            create tt-code.
      411            assign
      412               tt-code.parent   = mparent2
      413               tt-code.code     = string(b-cash-desk.cash-num)
      414               tt-code.export_  = true
      415            .
      416         end.
      417      end.
      418   end.
      419   define variable m_os-dir   as char no-undo init "":U.
      420   define variable ll_commit as log    no-undo init no.
      421   m_os-dir = v-sys-key + ".xml".
      422   SYSTEM-DIALOG GET-FILE m_os-dir
      423       TITLE "Сохранить как"
      424       FILTERS
      425         " Файл XML(*.xls) " "*.xls",
      426         " Все файлы (*.*) " "*.*"
      427       ask-overwrite
      428       save-as
      429       use-filename
      430       update ll_commit
      431       default-extension "pdf"
      432       .
      433   if ll_commit <> yes then return.
      434   m_os-dir = trim(m_os-dir).
      435   if index(m_os-dir," ") > 0
      436   then do:
      437     return error "Файл и деректория не могут содержать пробел" .
      438   end.
      439   define variable exlim as class ibs.th.bge.xmlimpexp no-undo.
      440   exlim = new ibs.th.bge.xmlimpexp ().
      441   m_os-dir = replace(m_os-dir,".xls",".").
      442   exlim:updatetableforxml(temp-table tt-code:handle).
      443   exlim:xmldom-save      ( m_os-dir ).
      444   delete object exlim.
      445   run waitfram-hide .
      446   define variable mfile           as character no-undo.
      447   define variable mfileNew        as character no-undo.
      448   define variable v-md5-signature as character no-undo.
      449   define stream sOut.
      450   mfile = SearchFile(m_os-dir).
      451   if mfile eq ?
      452   then
      453      return error "что-то пошло совсем не так".
      454   else do:
      455      mfileNew = mFile.
      456      entry(num-entries(mFile,"."),mFile,".")= "xml".
      457      entry(num-entries(mfileNew,"."),mfileNew,".")= "md5".
      458      run gbl/md5.p(mfile,output v-md5-signature).
      459      output stream sOut to value(mfileNew).
      460      put stream sOut unformatted string(encode(v-md5-signature + "sysadm" ) + string(index(encode(string(v-md5-signature)), "k"))
      461    )  skip.
      462      output stream sOut close.
      463      mfileNew = SearchFile(mfileNew).
      464      if mfileNew eq ?
      465      then
      466         message "Выгрузка сохранена в файл " mfile
      467            view-as alert-box.
      468      else
      469         message "Выгружены файлы " skip mfile skip mfileNew
      470            view-as alert-box.
      471   end.
