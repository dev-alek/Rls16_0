      579        Btn_OK AT ROW 1.27 COL 1.5
      580        Btn_Cancel AT ROW 1.27 COL 11.5
      581        b-help AT ROW 1.27 COL 47.5
      582        date_from AT ROW 2.77 COL 8.5 COLON-ALIGNED
      583        date_to AT ROW 2.77 COL 25.4 COLON-ALIGNED
      584        rs-1 AT ROW 5.03 COL 3 NO-LABEL
      585        ed-object AT ROW 5.27 COL 18.5 NO-LABEL
      586        bt-sel-host AT ROW 7 COL 15
      587        RECT-1 AT ROW 4.43 COL 1.9
      588        SPACE(0.94) SKIP(0.15)
      589       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      590            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      591            TITLE "Диапазон дат для экспорта".
      592   ASSIGN
      593          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      594          FRAME Dialog-Frame:HIDDEN           = TRUE.
      595   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      596   DO:
      597     APPLY "END-ERROR":U TO SELF.
      598   END.
      599   ON CHOOSE OF bt-sel-host IN FRAME Dialog-Frame
      600   DO:
      601       assign
      602           rs-1 :screen-value  = "2"
      603       .
      604       define buffer buf_user-host for ub.user-host .
      605       define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
      606       find first buf_user-host no-lock
      607         where buf_user-host.db-num    = v-cntxt-db-num
      608           and buf_user-host.user-id   = v-cntxt-userid
      609           and buf_user-host.host-code = v-cntxt-host-code-obj
      610         no-error .
      611       if available buf_user-host
      612       then do:
      613         run userhsts_clear in this-procedure .
      614         run userhsts_append in this-procedure
      615           (input v-cntxt-host-code-obj
      616           ) .
      617       end.
      618       define variable v-user-select as logical   no-undo .
      619   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      620   run userhsts_select-many in this-procedure
      621     (input  parparentproc
      622     ,input  v-cntxt-db-num
      623     ,input  v-cntxt-userid
      624     ,input  v-cntxt-host-code-obj
      625     ,output v-user-select
      626     )  .
      627       if v-user-select <> true
      628       then do:
      629         return no-apply .
      630       end.
      631       run clear-obj-list in this-procedure .
      632       for each buf_userhsts_temp-user-host
      633       :
      634         run fill-obj-list in this-procedure
      635           (input buf_userhsts_temp-user-host.host-code
      636           ) no-error .
      637         if error-status :error
      638         then do:
      639           return no-apply.
      640         end.
      641       end.
      642       assign
      643           v-obj-list = ""
      644       .
      645       for each temp_obj-list:
      646           assign v-obj-list = v-obj-list + (if v-obj-list <> "" then chr(10) else "" )
      647                              + temp_obj-list.obj-type + string( temp_obj-list.obj-code ) + chr(32)
      648                              + temp_obj-list.obj-name
      649                                       .
      650       end.
      651       assign
      652           ed-object :screen-value = v-obj-list
      653       .
      654   END.
      655   ON CHOOSE OF Btn_Cancel IN FRAME Dialog-Frame
      656   DO:
      657       assign
      658           p-cancel = yes
      659       .
      660       apply "window-close" to frame Dialog-Frame.
      661   END.
      662   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
      663   DO:
      664       ASSIGN
      665           date_from
      666           date_to
      667           rs-1
      668           date_exp_from = date_from
      669           date_exp_to   = date_to
      670       .
      671       if date_from > date_to
      672       then do:
      673           message
      674               "Даты интервала заданы неверно. "
      675               skip " Нижняя дата интервала должна быть меньше верхней."
      676               skip(1) "Задайте интервал дат правильно или отмените экспорт."
      677           view-as alert-box information.
      678           apply "entry" to date_from.
      679           undo, return no-apply.
      680       end.
      681         case rs-1 :screen-value
      682         :
      683         when "1"
      684         then do:
      685             assign
      686                 p-range = 1
      687                 p-obj-list = ""
      688             .
      689         end.
      690         when "2"
      691         then do:
      692             assign
      693                 p-range = 2
      694             .
      695             assign
      696                 p-obj-list = ""
      697             .
      698             for each temp_obj-list
      699             :
      700                 assign
      701                     p-obj-list = p-obj-list
      702                             + ( if p-obj-list = "" then "" else "," ) + temp_obj-list.obj-type
      703                             + "," + string( temp_obj-list.obj-code )
      704                 .
      705             end.
      706         end.
      707         end case.
      708      APPLY "GO" TO FRAME Dialog-Frame.
      709   END.
      710   ON RETURN OF date_from IN FRAME Dialog-Frame
      711   DO:
      712       APPLY "ENTRY" TO date_to IN FRAME Dialog-Frame.
      713       RETURN NO-APPLY.
      714   END.
      715   ON RETURN OF date_to IN FRAME Dialog-Frame
      716   DO:
      717       APPLY "ENTRY" TO btn_OK IN FRAME Dialog-Frame.
      718       RETURN NO-APPLY.
      719   END.
      720   ON VALUE-CHANGED OF rs-1 IN FRAME Dialog-Frame
      721   DO:
      722   run object-select in this-procedure no-error .
      723   if error-status :error
      724   then do:
      725       undo, return no-apply.
      726   end.
      727   assign
      728       rs-1
      729   .
      730   END.
      731   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      732   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      733   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      734   on help of frame Dialog-Frame
      735   do:
      736     run gbl/app_help.p
      737       (input this-procedure :file-name
      738       ,input ''
      739       ,input ?
      740       ) no-error.
      741     if error-status :error then do:
      742       message
      743         "Ошибка при вызове помощи"
      744         error-status :get-message(1)
      745         view-as alert-box .
      746     end.
      747   end.
      748   run minbtn-set in this-procedure .
      749   on choose of b-help in frame Dialog-Frame
      750   do:
      751     apply "help":u to frame Dialog-Frame .
      752   end.
      753   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      754   procedure minbtn-set :
      755       do
      756           on error undo, return error return-value
      757           :
      758           define variable ii              as integer       no-undo .
      759           define variable fh              as widget-handle no-undo .
      760           define variable hh              as widget-handle no-undo .
      761           define variable v-h             as handle        extent 4 no-undo .
      762           define variable v-name-button   as character     no-undo .
      763           define variable v-help-old-x    as decimal       no-undo .
      764           define variable v-help-old-y    as decimal       no-undo .
      765           define variable v-help-old-size as decimal       no-undo .
      766           define variable v-frame-width   as decimal       no-undo .
      767           define variable jj              as integer       no-undo .
      768           do
      769               on error undo, return error
      770               :
      771               assign
      772                   v-frame-width = frame Dialog-Frame:width - 0.3
      773                   fh            = frame Dialog-Frame:first-child
      774                   hh            = fh:first-child
      775                   ii            = 1
      776                   .
      777               do while valid-handle(hh):
      778                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      779                   do:
      780                       case lc(hh:name) :
      781                           when "b-help" then
      782                               do:
      783                                   hh:load-image-up("cmp/b-help.bmp":u) .
      784                                   hh:load-image-down("cmp/b-help.bmp":u) .
      785                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      786                                   hh:TOOLTIP = "Помощь" .
      787                                   v-help-old-x = hh:column .
      788                                   v-help-old-y = hh:row    .
      789                                   v-help-old-size = hh:width .
      790                                   hh:width-chars = 2.5 .
      791                               end.
      792                           when "b-print" then
      793                               do:
      794                                   hh:load-image("cmp/b-print.bmp":u) .
      795                                   hh:TOOLTIP = "Печать" .
      796                                   v-h[ii] = hh:handle .
      797                                   ii = ii + 1 .
      798                                   hh:width-chars = 3 .
      799                               end.
      800                           when "b-history" or
      801                           when "b-hist" then
      802                               do:
      803                                   hh:load-image("cmp/b-hist.bmp":u) .
      804                                   hh:TOOLTIP = "История" .
      805                                   v-h[ii] = hh:handle .
      806                                   ii = ii + 1 .
      807                                   hh:width-chars = 3 .
      808                               end.
      809                           when "b-sch" then
      810                               do:
      811                                   hh:load-image("cmp/b-sch.bmp":u) .
      812                                   hh:TOOLTIP = "Установка Фильтра" .
      813                                   v-h[ii] = hh:handle .
      814                                   ii = ii + 1 .
      815                                   hh:width-chars = 3 .
      816                               end.
      817                           when "b-hist-user" then
      818                               do:
      819                                   hh:load-image("cmp/b-hist.bmp":u) .
      820                                   hh:TOOLTIP = "История пользователя" .
      821                                   ii = ii + 1 .
      822                               end.
      823                       end case.
      824                   end.
      825                   hh = hh:next-sibling.
      826               end.
      827               b-help:column = v-frame-width - b-help:width-chars.
      828               jj = 0.
      829               repeat ii = 4 to 1 by -1 :
      830                   if valid-handle (v-h[ii] ) then
      831                   do:
      832                       jj  = jj + 1 .
      833                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      834                       v-h[ii]:row    = v-help-old-y .
      835                   end.
      836               end.
      837           end.
      838       end.
      839   end procedure.
      840   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      841   on ' ' of date_from in frame Dialog-Frame
      842   do:
