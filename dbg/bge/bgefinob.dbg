     1007           (input ?
     1008           ,input "Выбор даты"
     1009           ,input v-description
     1010           ,input ""
     1011           ,input-output v-curr-sv-date
     1012           ,output v-ok
     1013           ).
     1014         if v-ok = true
     1015         then do:
     1016           assign
     1017             self :screen-value = string(v-curr-sv-date) .
     1018           .
     1019         end.
     1020       end.
