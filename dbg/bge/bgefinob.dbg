      924           ) .
      925       end.
      926       if v-curr-sv-date <> ?
      927       then do:
      928         assign
      929           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      930         .
      931         assign
      932           self :screen-value = string(v-new-sv-date) .
      933         .
      934       end.
      935     end.
      936     return no-apply .
      937   end.
      938   on ctrl-e of date_from in frame Dialog-Frame
      939   do:
