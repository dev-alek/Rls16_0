      986        )
      987     then do:
      988       if self :handle <> focus :handle
      989       then do:
      990         apply "entry":u to self .
      991       end.
      992       define variable v-ok            as logical   no-undo .
      993       define variable v-curr-sv-date  as date      no-undo .
      994       define variable v-description   as character no-undo .
      995       assign
      996         v-curr-sv-date = date(self :screen-value) no-error
      997       .
      998       if v-curr-sv-date = ?
      999       then do:
     1000         run gbl/getcurdt.p
