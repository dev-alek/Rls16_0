      891       run gbl/getcurdt.p
      892         (output v-curr-sv-date
      893         ) .
      894       assign
      895         self :screen-value = string(v-curr-sv-date) .
      896       .
      897     end.
      898     return no-apply.
      899   end.
      900   on ctrl-b of date_from in frame Dialog-Frame
      901   do:
      902     if (can-query (self, "sensitive")
      903        and
      904        self :sensitive = true
      905        )
      906     or (can-query (self, "read-only")
      907        and
      908        self :read-only = false
      909        )
      910     then do:
      911       if self :handle <> focus :handle
      912       then do:
      913         apply "entry":u to self .
      914       end.
      915       define variable v-curr-sv-date as date no-undo .
      916       define variable v-new-sv-date  as date no-undo .
      917       assign
      918         v-curr-sv-date = date(self :screen-value) no-error
      919       .
