     1200   on ctrl-f of date_to in frame Dialog-Frame
     1201   do:
     1202     if (can-query (self, "sensitive")
     1203        and
     1204        self :sensitive = true
     1205        )
     1206     or (can-query (self, "read-only")
     1207        and
     1208        self :read-only = false
     1209        )
     1210     then do:
     1211       if self :handle <> focus :handle
     1212       then do:
     1213         apply "entry":u to self .
     1214       end.
     1215       define variable v-ok            as logical   no-undo .
     1216       define variable v-curr-sv-date  as date      no-undo .
     1217       define variable v-description   as character no-undo .
     1218       assign
     1219         v-curr-sv-date = date(self :screen-value) no-error
     1220       .
     1221       if v-curr-sv-date = ?
     1222       then do:
     1223         run gbl/getcurdt.p
     1224           (output v-curr-sv-date
     1225           ) .
     1226       end.
     1227       if v-curr-sv-date <> ?
     1228       then do:
     1229         run gbl/d-inpday.w
     1230           (input ?
     1231           ,input "Выбор даты"
     1232           ,input v-description
     1233           ,input ""
     1234           ,input-output v-curr-sv-date
     1235           ,output v-ok
     1236           ).
     1237         if v-ok = true
     1238         then do:
     1239           assign
     1240             self :screen-value = string(v-curr-sv-date) .
     1241           .
     1242         end.
     1243       end.
     1244     end.
     1245     return no-apply .
     1246   end.
     1247     define MENU m-ed-date9
     1248       MENU-ITEM m-ed-date9-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1249       MENU-ITEM m-ed-date9-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1250       MENU-ITEM m-ed-date9-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1251       MENU-ITEM m-ed-date9-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1252       .
     1253     if date_to :POPUP-MENU in frame Dialog-Frame = ?
     1254     then do:
     1255       ASSIGN
     1256         date_to :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date9 :HANDLE
     1257         date_to :MENU-MOUSE in frame Dialog-Frame = 3
     1258       .
     1259     end.
     1260     define variable v-label-handle9 as handle no-undo .
     1261     assign
     1262       v-label-handle9 = date_to :side-label-handle in frame Dialog-Frame
     1263     .
     1264     if valid-handle (v-label-handle9)
     1265     then do:
     1266       if v-label-handle9 :tooltip = ""
     1267       or v-label-handle9 :tooltip = ?
     1268       then do:
     1269         assign
     1270           v-label-handle9 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     1271         .
     1272       end.
     1273     end.
     1274     ON CHOOSE OF MENU-ITEM m-ed-date9-1 in menu m-ed-date9 DO:
     1275       apply "ctrl-b":U to date_to in frame Dialog-Frame .
     1276     END.
     1277     ON CHOOSE OF MENU-ITEM m-ed-date9-2 in menu m-ed-date9 DO:
     1278       apply "ctrl-d":U to date_to in frame Dialog-Frame .
     1279     END.
     1280     ON CHOOSE OF MENU-ITEM m-ed-date9-3 in menu m-ed-date9 DO:
     1281       apply "ctrl-e":U to date_to in frame Dialog-Frame .
     1282     END.
     1283     ON CHOOSE OF MENU-ITEM m-ed-date9-4 in menu m-ed-date9 DO:
     1284       apply "ctrl-f":U to date_to in frame Dialog-Frame .
     1285     END.
     1286   run cur-time in this-procedure ( output v-today
     1287                                  , output v-time
     1288                                  ).
     1289   ASSIGN
     1290       date_from = v-today
     1291       date_to   = v-today
     1292   .
     1293   MAIN-BLOCK:
     1294   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1295      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1296   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1297     run mainmenu_getcntxt in parparentproc
     1298       (output v-cntxt-db-num
     1299       ,output v-cntxt-userid
     1300       ,output v-cntxt-level
     1301       ,output v-cntxt-host-code-obj
     1302       ,output v-cntxt-obj-type
     1303       ,output v-cntxt-obj-code
     1304       ,output v-cntxt-db-num-obj
     1305       ,output v-cntxt-is-admin
     1306       ) .
     1307       run get-host-name in this-procedure ( output v-host-name ) no-error .
     1308       if error-status :error
     1309       then do:
     1310           message
     1311             vss-workfile vss-revision vss-description
     1312             skip "Ошибка при определении имени фирмы"
     1313             skip "Код фирмы:" v-cntxt-host-code-obj
     1314             skip "Имя фирмы будет отображаться как '" + 'орг':U + string( v-cntxt-host-code-obj ) + "'"
     1315             skip return-value
     1316             skip trim(error-status :get-message(1))
     1317                  trim(error-status :get-message(2))
     1318                  trim(error-status :get-message(3))
     1319                  trim(error-status :get-message(4))
     1320                  trim(error-status :get-message(5))
     1321           view-as alert-box warning.
     1322           assign
     1323               v-host-name = 'орг':U + string( v-cntxt-host-code-obj )
     1324           .
     1325       end.
     1326     RUN enable_UI.
     1327      run init-fields in this-procedure .
     1328     WAIT-FOR GO OF FRAME Dialog-Frame.
     1329   END.
     1330   RUN disable_UI.
     1331   PROCEDURE clear-obj-list :
     1332     define buffer buf_temp_obj-list for temp_obj-list .
     1333     do
     1334     on error undo, return error return-value
     1335     :
     1336       for each buf_temp_obj-list
     1337       on error undo, return error return-value
     1338       :
     1339         delete buf_temp_obj-list .
     1340       end.
     1341     end.
     1342   END PROCEDURE.
     1343   PROCEDURE disable_UI :
     1344     HIDE FRAME Dialog-Frame.
     1345   END PROCEDURE.
     1346   PROCEDURE enable_UI :
     1347     DISPLAY date_from date_to rs-1 ed-object
     1348         WITH FRAME Dialog-Frame.
     1349     ENABLE RECT-1 Btn_OK Btn_Cancel b-help date_from date_to rs-1 bt-sel-host
     1350         WITH FRAME Dialog-Frame.
     1351     VIEW FRAME Dialog-Frame.
     1352   END PROCEDURE.
     1353   PROCEDURE fill-obj-list :
     1354     define input  parameter p-host-code as integer   no-undo .
     1355     do
     1356     on error undo, return error
     1357     :
     1358       define buffer buf_clients for ub.clients.
     1359       find first buf_clients no-lock
     1360         where buf_clients.obj-type = 'орг':U
     1361           and buf_clients.obj-code = p-host-code
     1362         no-error .
     1363       if not available buf_clients
     1364       then do:
     1365         message
     1366           vss-workfile vss-revision vss-description skip
     1367           "Ошибка задания входных параметров" skip
     1368           "Не найдена фирма с кодом" p-host-code skip
     1369           view-as alert-box error .
     1370         undo, return error return-value .
     1371       end.
     1372       create temp_obj-list.
     1373       assign
     1374         temp_obj-list.obj-type = buf_clients.obj-type
     1375         temp_obj-list.obj-code = buf_clients.obj-code
     1376         temp_obj-list.obj-name = buf_clients.obj-name
     1377       .
     1378     end.
     1379   END PROCEDURE.
     1380   PROCEDURE get-host-name :
     1381   do
     1382   on error undo, return error
     1383   :
     1384   define output parameter p-host-name as character    no-undo.
     1385   define buffer buf_clients   for ub.clients.
     1386       find first buf_clients no-lock
     1387            where buf_clients.obj-type = 'орг':U
     1388              and buf_clients.obj-code = v-cntxt-host-code-obj
     1389       no-error.
     1390       if not available buf_clients
     1391       then do:
     1392           message
     1393             vss-workfile vss-revision vss-description
     1394             skip "Не удалось найти текущую фирму"
     1395             skip return-value
     1396             skip trim(error-status :get-message(1))
     1397                  trim(error-status :get-message(2))
     1398                  trim(error-status :get-message(3))
     1399                  trim(error-status :get-message(4))
     1400                  trim(error-status :get-message(5))
     1401           view-as alert-box error.
     1402           undo, return error .
     1403       end.
     1404       else do:
     1405           assign
     1406               p-host-name = buf_clients.obj-name
     1407           .
     1408       end.
     1409   end.
     1410   END PROCEDURE.
     1411   PROCEDURE init-fields :
     1412   do
     1413   on error undo, return error
     1414   :
     1415     define variable v-oper-num     as integer           no-undo.
     1416     define buffer buf_user-host for ub.user-host.
     1417     find first buf_user-host no-lock
     1418       where buf_user-host.db-num    = v-cntxt-db-num
     1419         and buf_user-host.user-id   = v-cntxt-userid
     1420         and buf_user-host.host-code = v-cntxt-host-code-obj
     1421       no-error .
     1422     if available buf_user-host
     1423     then do:
     1424         run clear-obj-list in this-procedure .
     1425         run fill-obj-list in this-procedure
     1426           (input  buf_user-host.host-code
     1427           ) no-error .
     1428     end.
     1429      assign
     1430           p-doc-type-list = p-init-doc-type-list
     1431       .
     1432       assign
     1433           rs-1 :screen-value in frame dialog-frame = "2"
     1434           ed-object :screen-value in frame Dialog-frame = 'орг':U + string( v-cntxt-host-code-obj ) + " " + v-host-name
     1435       .
     1436       assign
     1437           rs-1
     1438       .
     1439       display rs-1
     1440       with frame Dialog-Frame
     1441       .
     1442       END.
     1443       END PROCEDURE.
     1444   PROCEDURE object-select :
     1445   do
     1446   on error undo, return error
     1447   :
     1448   case rs-1 :screen-value in frame Dialog-frame
     1449   :
     1450       when "1"
     1451       then do:
     1452           assign
     1453               ed-object :screen-value = ""
     1454           .
     1455       end.
     1456       when "2"
     1457       then do:
     1458           for each temp_obj-list
     1459           :
     1460               delete temp_obj-list.
     1461           end.
     1462           create temp_obj-list.
     1463           assign
     1464               temp_obj-list.obj-type  = 'орг':U
     1465               temp_obj-list.obj-code  = v-cntxt-host-code-obj
     1466               ed-object :screen-value = temp_obj-list.obj-type + string(temp_obj-list.obj-code) + chr(32) + "(":U + v-host-name + ")":U
     1467           .
     1468       end.
     1469   end case.
     1470   end.
     1471   END PROCEDURE.
