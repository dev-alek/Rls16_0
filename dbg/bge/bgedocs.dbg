      190   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      191   procedure cur-time :
      192      define output parameter p-today as date      no-undo .
      193      define output parameter p-time  as integer   no-undo .
      194     do
      195     on error undo, return error
      196     :
      197       define variable v-date1 as date      no-undo .
      198       define variable v-date2 as date      no-undo .
      199       define variable v-time  as integer   no-undo .
      200       assign
      201         v-date1 = today
      202         v-time  = time
      203         v-date2 = today
      204       .
      205       if v-date1 <> v-date2
      206       then do:
      207         assign
      208           v-date1 = today
      209           v-time  = v-time
      210         .
      211       end.
      212       assign
      213         p-today = v-date1
      214         p-time  = v-time
      215       .
      216     end.
      217   end.
      218   function cur-time-date returns character
      219   :
      220     return string(today, '99/99/9999':U) .
      221   end.
      222   function cur-time-mjd returns decimal
      223   :
      224     define variable v-date as date      no-undo .
      225     define variable v-time as integer   no-undo .
      226     run cur-time in this-procedure
      227       (output v-date
      228       ,output v-time
      229       ) .
      230     return integer(v-date) - 2400002 + (v-time / 86400) .
      231   end.
      232   function cur-time-get-ending-index returns integer
      233   (input p-number as integer
      234   )
      235   :
      236     if p-number < 0
      237     or p-number = ?
      238     then do:
      239       return 1 .
      240     end.
      241     define variable v-rest as integer   no-undo .
      242     assign
      243       p-number = p-number modulo 100
      244     .
      245     if p-number < 20
      246     then do:
      247       assign
      248         v-rest = p-number
      249       .
      250     end.
      251     else do:
      252       assign
      253         v-rest = p-number modulo 10
      254       .
      255     end.
      256     case v-rest :
      257       when 1
      258       then do:
      259         return 2 .
      260       end.
      261       when 2 or
      262       when 3 or
      263       when 4
      264       then do:
      265         return 3 .
      266       end.
      267       otherwise do:
      268         return 1 .
      269       end.
      270     end case .
      271   end.
      272   procedure cur-time-mjd-to-date :
      273      define input  parameter i-mjd-diff as decimal no-undo.
      274      define output parameter o-Date     as date    no-undo.
      275      define output parameter o-Time     as integer no-undo.
      276      define variable v-day-number as integer   no-undo .
      277      if    i-mjd-diff < 0
      278         or i-mjd-diff = ?
      279      then do:
      280         return "?" .
      281      end.
      282      assign
      283         v-day-number = truncate(i-mjd-diff,0).
      284         o-Date = date(v-day-number + 2400002).
      285         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      286     .
      287   end.
      288   function cur-time-mjd-to-string returns character
      289   (input p-mjd-diff as decimal
      290   )
      291   :
      292     define variable v-day-number as integer   no-undo .
      293     define variable v-seconds    as integer   no-undo .
      294     define variable v-hour       as integer   no-undo .
      295     define variable v-min        as integer   no-undo .
      296     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      297     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      298     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      299     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      300     if p-mjd-diff < 0
      301     or p-mjd-diff = ?
      302     then do:
      303       return "?" .
      304     end.
      305     assign
      306       v-day-number = integer(truncate(p-mjd-diff,0))
      307       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      308     .
      309     if v-seconds > 86400
      310     then do:
      311       assign
      312         v-seconds = 86400 - 1
      313       .
      314     end.
      315     if v-seconds < 0
      316     then do:
      317       assign
      318         v-seconds = 0
      319       .
      320     end.
      321     assign
      322       v-hour = truncate(v-seconds / 3600, 0)
      323     .
      324     assign
      325       v-seconds = v-seconds modulo 3600
      326     .
      327     assign
      328       v-min = truncate(v-seconds / 60, 0)
      329     .
      330     assign
      331       v-seconds = v-seconds modulo 60
      332     .
      333     return
      334         (if v-day-number <> 0
      335           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      336           else ""
      337         )
      338       + (if v-day-number <> 0 or v-hour <> 0
      339           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      340           else ""
      341         )
      342       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      343           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      344           else ""
      345         )
      346       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      347       .
      348   end.
      349   function cur-time-string returns character
      350   :
      351     define variable v-date as date      no-undo .
      352     define variable v-time as integer   no-undo .
      353     run cur-time in this-procedure
      354       (output v-date
      355       ,output v-time
      356       ) .
      357     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      358   end.
      359   function cur-time-string-sec returns character
      360   :
      361     define variable v-date as date      no-undo .
      362     define variable v-time as integer   no-undo .
      363     run cur-time in this-procedure
      364       (output v-date
      365       ,output v-time
      366       ) .
      367     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      368   end.
      369   function cur-time-custom  returns character
      370   (input p-prefix as character
      371   ,input p-date-format as character
      372   ,input p-delimiter as character
      373   ,input p-time-format as character
      374   ,input p-suffix as character
      375   )
      376   :
      377     define variable v-date as date      no-undo .
      378     define variable v-time as integer   no-undo .
      379     run cur-time in this-procedure
      380       (output v-date
      381       ,output v-time
      382       ) .
      383     return
      384       p-prefix
      385       + string(v-date, p-date-format)
      386       + p-delimiter
      387       + string(v-time, p-time-format)
      388       + p-suffix
      389       .
      390   end.
      391   function cur-time-print  returns character
      392   :
      393     define variable v-date as date      no-undo .
      394     define variable v-time as integer   no-undo .
      395     run cur-time in this-procedure
      396       (output v-date
      397       ,output v-time
      398       ) .
      399     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      400   end.
      401   function cur-time-datetime returns datetime
      402   :
      403     define variable v-char as character no-undo .
      404     define variable v-datetime as datetime no-undo .
      405     v-char = cur-time-string().
      406     v-datetime = datetime(v-char).
      407     return  v-datetime.
      408   end.
      409   function cur-time-string-msec returns character
      410   :
      411     define variable v-date as datetime  no-undo .
      412     v-date = now.
      413     return string(v-date) .
      414   end.
      415   define variable vss-include-info3 as character format "X(65)" no-undo
      416   initial "@(#)$Workfile$ $Revision$".
      417   procedure xmlchar-test :
      418   define input parameter p-in-string          as character        no-undo.
      419   define output parameter p-out-string-enc    as character        no-undo.
      420   define output parameter p-out-string-dec    as character        no-undo.
      421   do
      422   on error undo, return error
      423   :
      424          run xmlchar-encode in this-procedure
      425       (
      426             input p-in-string
      427           , output p-out-string-enc
      428       ).
      429          run xmlchar-decode in this-procedure
      430       (
      431             input p-out-string-enc
      432           , output p-out-string-dec
      433       ).
      434   end.
      435   end .
      436   procedure xmlchar-encode :
      437   define input parameter p-in-string      as character        no-undo.
      438   define output parameter p-out-string    as character        no-undo.
      439       define variable v-position      as integer      no-undo.
      440       define variable v-current-char  as character    no-undo.
      441   do
      442   on error undo, return error
      443   :
      444       assign
      445           p-out-string = "":U
      446       .
      447       case p-in-string
      448       :
      449           when ?
      450           then do:
      451               assign
      452                   p-out-string = "?":U
      453               .
      454           end.
      455           when "?":U
      456           then do:
      457               assign
      458                   p-out-string = "&#63;":U
      459               .
      460           end.
      461           otherwise do:
      462               do v-position = 1 to length( p-in-string )
      463               :
      464                   assign
      465                       v-current-char = substring( p-in-string, v-position, 1 )
      466                   .
      467                   case v-current-char
      468                   :
      469                       when "&":U
      470                       then do:
      471                           assign
      472                               p-out-string = p-out-string + "&amp;":U
      473                           .
      474                       end.
      475                       when ">":U
      476                       then do:
      477                           assign
      478                               p-out-string = p-out-string + "&gt;":U
      479                           .
      480                       end.
      481                       when "<":U
      482                       then do:
      483                           assign
      484                               p-out-string = p-out-string + "&lt;":U
      485                           .
      486                       end.
      487                       when "'":U
      488                       then do:
      489                           assign
      490                               p-out-string = p-out-string + "&apos;":U
      491                           .
      492                       end.
      493                       when '"':U
      494                       then do:
      495                           assign
      496                               p-out-string = p-out-string + "&quot;":U
      497                           .
      498                       end.
      499                       when chr(1)
      500                       then do:
      501                           assign
      502                               p-out-string = p-out-string + "":U
      503                           .
      504                       end.
      505                       when chr(2)
      506                       then do:
      507                           assign
      508                               p-out-string = p-out-string + "":U
      509                           .
      510                       end.
      511                       when chr(3)
      512                       then do:
      513                           assign
      514                               p-out-string = p-out-string + "":U
      515                           .
      516                       end.
      517                       when chr(4)
      518                       then do:
      519                           assign
      520                               p-out-string = p-out-string + "":U
      521                           .
      522                       end.
      523                       when chr(5)
      524                       then do:
      525                           assign
      526                               p-out-string = p-out-string + "":U
      527                           .
      528                       end.
      529                       when chr(6)
      530                       then do:
      531                           assign
      532                               p-out-string = p-out-string + "":U
      533                           .
      534                       end.
      535                       when chr(7)
      536                       then do:
      537                           assign
      538                               p-out-string = p-out-string + "":U
      539                           .
      540                       end.
      541                       when chr(8)
      542                       then do:
      543                           assign
      544                               p-out-string = p-out-string + "":U
      545                           .
      546                       end.
      547                       when chr(9)
      548                       then do:
      549                           assign
      550                               p-out-string = p-out-string + "":U
      551                           .
      552                       end.
      553                       when chr(29)
      554                       then do:
      555                           assign
      556                               p-out-string = p-out-string + "":U
      557                           .
      558                       end.
      559                       when chr(10)
      560                       then do:
      561                           assign
      562                               p-out-string = p-out-string + "&#10;":U
      563                           .
      564                       end.
      565                       when chr(13)
      566                       then do:
      567                           assign
      568                               p-out-string = p-out-string + "&#13;":U
      569                           .
      570                       end.
      571                       otherwise do:
      572                           assign
      573                               p-out-string = p-out-string + v-current-char
      574                           .
      575                       end.
      576                   end case.
      577               end.
      578           end.
      579       end case.
      580   end.
      581   end .
      582   procedure xmlchar-encode-1c :
      583   define input parameter p-in-string      as character        no-undo.
      584   define output parameter p-out-string    as character        no-undo.
      585       define variable v-position      as integer      no-undo.
      586       define variable v-current-char  as character    no-undo.
      587   do
      588   on error undo, return error
      589   :
      590       assign
      591           p-out-string = "":U
      592       .
      593       case p-in-string
      594       :
      595           when ?
      596           then do:
      597               assign
      598                   p-out-string = "?":U
      599               .
      600           end.
      601           otherwise do:
      602               do v-position = 1 to length( p-in-string )
      603               :
      604                   assign
      605                       v-current-char = substring( p-in-string, v-position, 1 )
      606                   .
      607                   case v-current-char
      608                   :
      609                       when chr(1)
      610                       then do:
      611                           assign
      612                               p-out-string = p-out-string + " ":U
      613                           .
      614                       end.
      615                       when chr(2)
      616                       then do:
      617                           assign
      618                               p-out-string = p-out-string + " ":U
      619                           .
      620                       end.
      621                       when chr(3)
      622                       then do:
      623                           assign
      624                               p-out-string = p-out-string + " ":U
      625                           .
      626                       end.
      627                       when chr(4)
      628                       then do:
      629                           assign
      630                               p-out-string = p-out-string + " ":U
      631                           .
      632                       end.
      633                       when chr(5)
      634                       then do:
      635                           assign
      636                               p-out-string = p-out-string + " ":U
      637                           .
      638                       end.
      639                       when chr(6)
      640                       then do:
      641                           assign
      642                               p-out-string = p-out-string + " ":U
      643                           .
      644                       end.
      645                       when chr(7)
      646                       then do:
      647                           assign
      648                               p-out-string = p-out-string + " ":U
      649                           .
      650                       end.
      651                       when chr(8)
      652                       then do:
      653                           assign
      654                               p-out-string = p-out-string + " ":U
      655                           .
      656                       end.
      657                       when chr(9)
      658                       then do:
      659                           assign
      660                               p-out-string = p-out-string + " ":U
      661                           .
      662                       end.
      663                       when chr(29)
      664                       then do:
      665                           assign
      666                               p-out-string = p-out-string + " ":U
      667                           .
      668                       end.
      669                       when chr(10)
      670                       then do:
      671                           assign
      672                               p-out-string = p-out-string + " ":U
      673                           .
      674                       end.
      675                       when chr(13)
      676                       then do:
      677                           assign
      678                               p-out-string = p-out-string + " ":U
      679                           .
      680                       end.
      681                       otherwise do:
      682                           assign
      683                               p-out-string = p-out-string + v-current-char
      684                           .
      685                       end.
      686                   end case.
      687               end.
      688           end.
      689       end case.
      690   end.
      691   end .
      692   procedure xmlchar-decode :
      693   define input parameter p-in-string      as character        no-undo.
      694   define output parameter p-out-string    as character        no-undo.
      695       define variable v-position      as integer      no-undo.
      696       define variable v-last-position as integer      no-undo.
      697       define variable v-temp-integer  as integer      no-undo.
      698       define variable v-current-char  as character    no-undo.
      699       define variable v-next-char     as character    no-undo.
      700       define variable v-success       as logical      no-undo.
      701   do
      702   on error undo, return error
      703   :
      704       assign
      705           p-out-string = "":U
      706           v-position   = 0
      707       .
      708       replace-cycle:
      709       do while yes
      710       on error undo, return error
      711       :
      712           assign
      713               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      714           .
      715           if v-last-position <= v-position
      716           then do:
      717               if v-position = 0
      718               then do:
      719                   assign
      720                       p-out-string = p-in-string
      721                   .
      722               end.
      723               else do:
      724                   assign
      725                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      726                   .
      727               end.
      728               leave replace-cycle.
      729           end.
      730           else do:
      731               assign
      732                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      733                   v-position      = v-last-position
      734                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      735               .
      736               if v-current-char = "#":U
      737               then do:
      738                   assign
      739                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      740                   .
      741                   if v-last-position > 0
      742                   then do:
      743                       run xmlchar-read-integer in this-procedure
      744                        (
      745                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      746                           , output v-temp-integer
      747                           , output v-success
      748                       ).
      749                       if v-success = yes
      750                       and v-temp-integer >= 1
      751                       and v-temp-integer <= 255
      752                       then do:
      753                           assign
      754                               p-out-string = p-out-string + chr( v-temp-integer )
      755                               v-position   = v-last-position + 1
      756                           .
      757                       end.
      758                       else do:
      759                           assign
      760                               p-out-string = p-out-string + "&":U
      761                               v-position   = v-position   + 1
      762                           .
      763                       end.
      764                   end.
      765                   else do:
      766                       assign
      767                           p-out-string = p-out-string + "&":U
      768                           v-position   = v-position   + 1
      769                       .
      770                   end.
      771               end.
      772               else do:
      773                   case substring( p-in-string, v-position + 1, 3 )
      774                   :
      775                       when "lt;":U
      776                       then do:
      777                           assign
      778                               p-out-string = p-out-string + "<":U
      779                               v-position   = v-position   + 3
      780                           .
      781                       end.
      782                       when "gt;":U
      783                       then do:
      784                           assign
      785                               p-out-string = p-out-string + ">":U
      786                               v-position   = v-position   + 3
      787                           .
      788                       end.
      789                       otherwise do:
      790                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      791                           then do:
      792                               assign
      793                                   p-out-string = p-out-string + "&":U
      794                                   v-position   = v-position   + 4
      795                               .
      796                           end.
      797                           else do:
      798                               case substring( p-in-string, v-position + 1, 5 )
      799                               :
      800                                   when "quot;":U
      801                                   then do:
      802                                       assign
      803                                           p-out-string = p-out-string + '"':U
      804                                           v-position   = v-position   + 5
      805                                       .
      806                                   end.
      807                                   when "apos;":U
      808                                   then do:
      809                                       assign
      810                                           p-out-string = p-out-string + "'":U
      811                                           v-position   = v-position   + 5
      812                                       .
      813                                   end.
      814                                   otherwise do:
      815                                       assign
      816                                           p-out-string = p-out-string + "&":U
      817                                       .
      818                                   end.
      819                               end case.
      820                           end.
      821                       end.
      822                   end case.
      823               end.
      824           end.
      825       end.
      826   end.
      827   end .
      828   procedure xmlchar-read-integer :
      829   define input parameter p-input-string      as character        no-undo.
      830   define output parameter p-output-integer   as integer          no-undo.
      831   define output parameter p-success       as logical          no-undo.
      832   do
      833   on error undo, return error
      834   :
      835       assign
      836           p-output-integer = integer( p-input-string )
      837       no-error.
      838       if error-status :error
      839       then do:
      840           assign
      841               p-success           = no
      842               p-output-integer    = 0
      843           .
      844       end.
      845       else do:
      846           assign
      847               p-success           = yes
      848           .
      849       end.
      850   end.
      851   end.
      852   define variable v-bgelib-bgeclall           as logical      no-undo.
      853   define variable v-bgelib-bgedict            as logical      no-undo.
      854   define temp-table temp_ext-doc-type no-undo
      855       field edt-key               as integer
      856       field ext-doc-type          as character
      857       field ext-doc-type-label    as character
      858       index pi is primary unique
      859           edt-key
      860   .
      861   define temp-table temp_bgelib_goods no-undo
      862       field gds-code as integer
      863       index pi is primary unique
      864           gds-code
      865   .
      866   define temp-table temp_bgelib_clients no-undo
      867       field obj-type as character
      868       field obj-code as integer
      869       index pi is primary unique
      870           obj-type
      871           obj-code
      872   .
      873   define temp-table temp_bgelib_dis-card no-undo
      874       field d-card as character
      875       index pi is primary unique
      876           d-card
      877   .
      878   define temp-table temp_bgelib_trn-doc no-undo
      879       field doc-code as integer
      880   .
      881   procedure bgelib-tag-open:
      882   do
      883   on error undo, return error
      884   :
      885   define input parameter v-tag-level  as integer      no-undo.
      886   define input parameter v-tag-name   as character    no-undo.
      887   define input parameter v-tag-value  as character    no-undo.
      888       put stream stmXMLOut unformatted
      889           chr(10)
      890           + fill(" ", 4 * v-tag-level)
      891           + "<" + v-tag-name
      892           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
      893           + v-tag-value + ">"
      894       .
      895   end.
      896   end procedure.
      897   procedure bgelib-tag-put:
      898   do
      899   on error undo, return error
      900   :
      901   define input parameter v-tag-level      as integer      no-undo.
      902   define input parameter v-tag-name       as character    no-undo.
      903   define input parameter v-tag-value      as character    no-undo.
      904   define input parameter v-empty-mode     as integer      no-undo.
      905       v-tag-name = trim(v-tag-name).
      906       if  v-empty-mode = 1
      907       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
      908       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
      909       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
      910       then do:
      911           run xmlchar-encode in this-procedure (
      912                 input v-tag-value
      913               , output v-tag-value
      914           ).
      915           put stream stmXMLOut unformatted
      916               chr(10) + fill(" ", 4 * v-tag-level)
      917                           + '<' + v-tag-name + '>'
      918                           + v-tag-value
      919                           + '</' + v-tag-name + '>'
      920           .
      921       end.
      922   end.
      923   end procedure.
      924   procedure bgelib-tag-close:
      925   do
      926   on error undo, return error
      927   :
      928   define input parameter v-tag-level as integer      no-undo.
      929   define input parameter v-tag-name  as character    no-undo.
      930       put stream stmXMLOut unformatted
      931           chr(10)
      932           + fill( " ", 4 * v-tag-level)
      933           + '</' + v-tag-name + '>'
      934       .
      935   end.
      936   end procedure.
      937   procedure bgelib-write-log:
      938   do
      939   on error undo, return error
      940   :
      941   define input parameter v-filename   as character    no-undo.
      942   define input parameter v-log-level  as integer      no-undo.
      943   define input parameter v-out-string as character    no-undo.
      944       output stream stmXMLLog to value( v-filename ) append.
      945       put stream stmXMLLog unformatted
      946           chr(10)
      947       .
      948       put stream stmXMLLog unformatted
      949           ( if v-log-level = 0
      950             or v-out-string = "&DLine"
      951             or v-out-string = "&Line"
      952             then ""
      953             else cur-time-string-sec() + " " )
      954       .
      955       put stream stmXMLLog unformatted
      956           ( if v-out-string = "&Line"
      957             then fill( "-", 80 )
      958             else if v-out-string = "&DLine"
      959                  then fill( "=", 80 )
      960                  else v-out-string )
      961       .
      962       output stream stmXMLLog close.
      963   end.
      964   end procedure.
      965   procedure bgelib-write-edt:
      966   do
      967   on error undo, return error
      968   :
      969   define input parameter v-editor-handle    as handle       no-undo.
      970   define input parameter v-log-level        as integer      no-undo.
      971   define input parameter v-out-string       as character    no-undo.
      972       if valid-handle ( v-editor-handle )
      973       then do:
      974           v-editor-handle :move-to-eof().
      975           v-editor-handle :insert-string( ( if v-log-level = 0
      976                                             or v-out-string = "&DLine"
      977                                             or v-out-string = "&Line"
      978                                             then ""
      979                                             else cur-time-string-sec() + " "
      980                                         ) ).
      981           v-editor-handle :insert-string( ( if v-out-string = "&Line"
      982                                             then fill( "-", 80 )
      983                                             else if v-out-string = "&DLine" then fill("=", 80)
      984                                             else fill( " ", v-log-level) + v-out-string
      985                                         ) ).
      986           v-editor-handle :insert-string( chr(10) ).
      987       end.
      988       process events.
      989       output to 'bgescn.txt' append.
      990           put unformatted
      991               chr(10)
      992               string( ( if v-log-level = 0
      993                         or v-out-string = "&DLine"
      994                         or v-out-string = "&Line"
      995                         then ""
      996                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
      997                     ) )
      998               string( ( if v-out-string = "&Line"
      999                         then fill( "-", 80 )
     1000                         else if v-out-string = "&DLine"
     1001                              then fill( "=", 80 )
     1002                              else fill( " ", v-log-level ) + v-out-string
     1003                     ) )
     1004           .
     1005       output close.
     1006   end.
     1007   end procedure.
     1008   procedure bgelib-show-cnt:
     1009   do
     1010   on error undo, return error
     1011   :
     1012   define input parameter v-fillin-handle     as handle   no-undo.
     1013       if valid-handle( v-fillin-handle )
     1014       then do:
     1015           assign
     1016               v-fillin-handle :visible = true
     1017           .
     1018       end.
     1019   end.
     1020   end procedure.
     1021   procedure bgelib-hide-cnt:
     1022   do
     1023   on error undo, return error
     1024   :
     1025   define input parameter v-fillin-handle     as handle   no-undo.
     1026       if valid-handle( v-fillin-handle )
     1027       then do:
     1028           assign v-fillin-handle :visible = false.
     1029       end.
     1030   end.
     1031   end procedure.
     1032   procedure bgelib-write-cnt:
     1033   do
     1034   on error undo, return error
     1035   :
     1036   define input parameter v-fillin-handle    as handle       no-undo.
     1037   define input parameter v-fillin-string    as character    no-undo.
     1038       if valid-handle( v-fillin-handle )
     1039       then do:
     1040           assign
     1041               v-fillin-handle :SCREEN-value = v-fillin-string
     1042           .
     1043       end.
     1044   end.
     1045   end procedure.
     1046   procedure bgelib-write-header:
     1047   do
     1048   on error undo, return error
     1049   :
     1050   define input parameter p-first-file     as logical      no-undo.
     1051   define input parameter p-xml-file-name  as character    no-undo.
     1052   define input parameter p-list-file-name as character    no-undo.
     1053   define input parameter p-file-number    as integer      no-undo.
     1054   define input parameter p-have-prev      as logical      no-undo.
     1055   define input parameter p-prev-filename  as character    no-undo.
     1056   define input parameter p-obj-list       as character    no-undo.
     1057   define input parameter p-doc-type-list  as character    no-undo.
     1058   define input parameter p-parameter-list as character    no-undo.
     1059       define variable v-counter    as integer        no-undo.
     1060       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1061       put stream stmXMLOut unformatted
     1062           "<?xml version='1.0' encoding='windows-1251'?>"
     1063       .
     1064       run bgelib-tag-open( input 0, input "root"  , input "" ).
     1065       run bgelib-tag-open( input 0, input "header", input "" ).
     1066       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1067       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1068       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1069       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1070       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
     1071       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1072       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1073       :
     1074           run bgelib-tag-put(
     1075                 input 1
     1076               , input entry( 2 * v-counter, p-parameter-list )
     1077               , input entry( 2 * v-counter + 1, p-parameter-list )
     1078               , input 0
     1079           ).
     1080       end.
     1081       run bgelib-tag-close( input 0, input "header" ).
     1082       output stream stmXMLOut close.
     1083       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1084       if p-first-file = yes
     1085       then do:
     1086           put stream stmXMLOut unformatted
     1087               "<?xml version='1.0' encoding='windows-1251'?>"
     1088           .
     1089           run bgelib-tag-open( input 0, input "export", input "" ).
     1090       end.
     1091       run bgelib-tag-open( input 1, input "file", input "" ).
     1092       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1093       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1094       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1095       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1096       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     1097       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1098       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1099       :
     1100           run bgelib-tag-put(
     1101                 input 2
     1102               , input trim(entry( 2 * v-counter, p-parameter-list ))
     1103               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     1104               , input 0
     1105           ).
     1106       end.
     1107       run bgelib-tag-close( input 1, input "file" ).
     1108       output stream stmXMLOut close.
     1109   end.
     1110   end procedure.
     1111   procedure bgelib-write-footer:
     1112   do
     1113   on error undo, return error
     1114   :
     1115   define input parameter p-last-file      as logical      no-undo.
     1116   define input parameter p-xml-file-name  as character    no-undo.
     1117   define input parameter p-list-file-name as character    no-undo.
     1118   define input parameter p-have-next      as logical      no-undo.
     1119   define input parameter p-next-file-name as character    no-undo.
     1120       define variable v-error-num     as integer           no-undo.
     1121       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1122       if p-have-next = yes
     1123       then do:
     1124           run bgelib-tag-open( input 0, input "footer", "" ).
     1125           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1126           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1127           run bgelib-tag-close( input 0, input "footer" ).
     1128       end.
     1129       run bgelib-tag-close( input 0, input "root" ).
     1130       output stream stmXMLOut close.
     1131       run bge/os_copy.p (
     1132             input "M"
     1133           , input p-xml-file-name + "tmp"
     1134           , input p-xml-file-name + "xml"
     1135           , output v-error-num
     1136       ).
     1137       if p-last-file = yes
     1138       then do:
     1139           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1140               run bgelib-tag-close( input 0, input "export" ).
     1141           output stream stmXMLOut close.
     1142           run bge/os_copy.p (
     1143                 input "M"
     1144               , input p-list-file-name + "tmp"
     1145               , input p-list-file-name + "xml"
     1146               , output v-error-num
     1147           ).
     1148       end.
     1149   end.
     1150   end procedure.
     1151   procedure bgelib-filename :
     1152   do
     1153   on error undo, return error
     1154   :
     1155   define input parameter p-prefix             as character    no-undo.
     1156   define output parameter p-xml-file-name     as character    no-undo.
     1157   define output parameter p-log-file-name     as character    no-undo.
     1158   define output parameter p-list-file-name    as character    no-undo.
     1159       define variable v-home-dir  as character    no-undo.
     1160       define variable v-error-num as integer      no-undo.
     1161       get-key-value section "BGE" key "outdir" value v-home-dir.
     1162       if v-home-dir = ?
     1163       then do:
     1164           message
     1165             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1166             skip(1)
     1167             skip "Обратитесь к администратору."
     1168           view-as alert-box error.
     1169           undo, return error .
     1170       end.
     1171       run gbl/dir-cre.p (
     1172           input v-home-dir
     1173       ) no-error.
     1174       if error-status :error
     1175       then do:
     1176           message
     1177             skip "Неверно задан каталог экспорта."
     1178             skip(1)
     1179             skip "Обратитесь к администратору."
     1180           view-as alert-box error.
     1181           undo, return error .
     1182       end.
     1183       run bge/genfname.p (
     1184             input v-home-dir
     1185           , input p-prefix
     1186           , input ""
     1187           , input "xml"
     1188           , input "tmp"
     1189           , output p-xml-file-name
     1190       ).
     1191       assign
     1192           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1193           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1194           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1195       .
     1196   end.
     1197   end procedure.
     1198   procedure bgelib-read-config :
     1199   do
     1200   on error undo, return error
     1201   :
     1202   define variable v-par-type as character     no-undo.
     1203     define variable v-param-type      as character  no-undo .
     1204     define variable v-value-character as character  no-undo .
     1205     define variable v-value-date      as date       no-undo .
     1206     define variable v-value-decimal   as decimal    no-undo .
     1207     define variable v-value-integer   as integer    no-undo .
     1208     define variable v-value-logical   as logical    no-undo .
     1209     define variable v-tth             as handle     no-undo .
     1210       assign
     1211           v-bgelib-bgeclall = no
     1212           v-bgelib-bgedict  = no
     1213       .
     1214       run adm/shattri.p ( input "get":U
     1215                         , input  '':u
     1216                         , input  0
     1217                         , input  'bge-export':U
     1218                         , input  'bgeclall':U
     1219                         , output v-value-character
     1220                         , output v-value-date
     1221                         , output v-value-decimal
     1222                         , output v-value-integer
     1223                         , output v-value-logical
     1224                         , output v-param-type
     1225                         , input-output table-handle v-tth
     1226                         ) no-error .
     1227       if error-status :error
     1228       then do:
     1229         assign
     1230           v-bgelib-bgeclall = no
     1231         .
     1232       end.
     1233       else do:
     1234         assign
     1235           v-bgelib-bgeclall = v-value-logical
     1236         .
     1237       end.
     1238       delete object v-tth.
     1239       run adm/shattri.p ( input "get":U
     1240                         , input  '':u
     1241                         , input  0
     1242                         , input  'bge-export':U
     1243                         , input  'bgedict':U
     1244                         , output v-value-character
     1245                         , output v-value-date
     1246                         , output v-value-decimal
     1247                         , output v-value-integer
     1248                         , output v-value-logical
     1249                         , output v-param-type
     1250                         , input-output table-handle v-tth
     1251                         ) no-error .
     1252       if error-status :error
     1253       then do:
     1254         assign
     1255           v-bgelib-bgedict = no
     1256         .
     1257       end.
     1258       else do:
     1259         assign
     1260           v-bgelib-bgedict = v-value-logical
     1261         .
     1262       end.
     1263       delete object v-tth.
     1264       run adm/shattri.p ( input "get":U
     1265                         , input  '':u
     1266                         , input  0
     1267                         , input  'bge-export':U
     1268                         , input  'bgefmt':U
     1269                         , output v-value-character
     1270                         , output v-value-date
     1271                         , output v-value-decimal
     1272                         , output v-value-integer
     1273                         , output v-value-logical
     1274                         , output v-param-type
     1275                         , input-output table-handle v-tth
     1276                         ) no-error .
     1277       if error-status :error
     1278       then do:
     1279         assign
     1280           v-bgelib-bgefmt  = "xml":U
     1281         .
     1282       end.
     1283       else do:
     1284         assign
     1285           v-bgelib-bgefmt  = v-value-character
     1286         .
     1287       end.
     1288       delete object v-tth.
     1289       run adm/shattri.p ( input "get":U
     1290                         , input  '':u
     1291                         , input  0
     1292                         , input  'bge-export':U
     1293                         , input  'bgeflold':U
     1294                         , output v-value-character
     1295                         , output v-value-date
     1296                         , output v-value-decimal
     1297                         , output v-value-integer
     1298                         , output v-value-logical
     1299                         , output v-param-type
     1300                         , input-output table-handle v-tth
     1301                         ) no-error .
     1302       if error-status :error
     1303       then do:
     1304         assign
     1305           v-bgelib-bgeflold  = "old":U
     1306         .
     1307       end.
     1308       else do:
     1309         assign
     1310           v-bgelib-bgeflold  = v-value-character
     1311         .
     1312       end.
     1313       delete object v-tth.
     1314   end.
     1315   end procedure.
     1316   procedure bgelib-check-file-size :
     1317   do
     1318   on error undo, return error
     1319   :
     1320   define input parameter p-out-filename   as character    no-undo.
     1321   define output parameter p-is-big        as logical      no-undo.
     1322       define variable v-current-position    as integer        no-undo.
     1323       assign
     1324           v-current-position = seek( stmXMLOut )
     1325       .
     1326       if v-current-position / 1024 / 1024  >= 100
     1327       then do:
     1328           assign
     1329               p-is-big = yes
     1330           .
     1331       end.
     1332   end.
     1333   end procedure.
     1334   procedure bgelib-init-ext-doc-type :
     1335       define variable v-counter    as integer      no-undo.
     1336       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     1337   do
     1338   for buf_temp_ext-doc-type
     1339   on error undo, return error
     1340   :
     1341       empty temp-table buf_temp_ext-doc-type.
     1342       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1343       :
     1344           create buf_temp_ext-doc-type.
     1345           assign
     1346               buf_temp_ext-doc-type.edt-key               = v-counter
     1347               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1348               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     1349           .
     1350       end.
     1351   end.
     1352   end procedure.
     1353   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1354     define variable v-cntxt-db-num        as integer   no-undo .
     1355     define variable v-cntxt-userid        as character no-undo .
     1356     define variable v-cntxt-level         as character no-undo .
     1357     define variable v-cntxt-host-code-obj as integer   no-undo .
     1358     define variable v-cntxt-obj-type      as character no-undo .
     1359     define variable v-cntxt-obj-code      as integer   no-undo .
     1360     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1361     define variable v-cntxt-is-admin      as logical   no-undo .
     1362       define variable v-xml-file-name     as character            no-undo.
     1363       define variable v-log-file-name     as character            no-undo.
     1364       define variable v-list-file-name    as character            no-undo.
     1365       define variable v-xml-file-number   as integer              no-undo.
     1366       define variable v-log-string        as character            no-undo.
     1367       define variable v-fact-order-from   like ub.stk-tot.fact-order no-undo.
     1368       define variable v-fact-order-to     like ub.stk-tot.fact-order no-undo.
     1369       define variable v-docs-exists       as logical              no-undo.
     1370       define variable v-obj-counter       as integer              no-undo.
     1371       define variable v-db-num            as integer              no-undo.
     1372       define variable v-cancel            as logical              no-undo.
     1373       define variable v-space-available   as logical              no-undo.
     1374       define variable v-yesno             as logical              no-undo.
     1375       define variable v-parameter-list    as character            no-undo.
     1376   do
     1377   on error undo, return error
     1378   :
     1379       run bgelib-init-ext-doc-type in this-procedure .
     1380   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1381     run mainmenu_getcntxt in p-mainmenu-handle
     1382       (output v-cntxt-db-num
     1383       ,output v-cntxt-userid
     1384       ,output v-cntxt-level
     1385       ,output v-cntxt-host-code-obj
     1386       ,output v-cntxt-obj-type
     1387       ,output v-cntxt-obj-code
     1388       ,output v-cntxt-db-num-obj
     1389       ,output v-cntxt-is-admin
     1390       ) .
     1391   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1392   do:
     1393     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1394       (input  v-cntxt-db-num
     1395       ,input  v-cntxt-userid
     1396       ,input  0
     1397       ,input  'actn_documents_export':U
     1398       ,input  'firm':U
     1399       ,input  v-cntxt-host-code-obj
     1400       ,input  '':U
     1401       ,input  0
     1402       ,input  0
     1403       ,input  0
     1404       ,input  0
     1405       ,input  yes
     1406       ,output v-yesno
     1407       )  .
     1408   end.
     1409       if v-yesno = no
     1410       then do:
     1411           return error.
     1412       end.
     1413       run init-temphost.
     1414       assign
     1415           v-log-string = ", по всем фирмам"
     1416       .
     1417       case p-range:
     1418       when 2
     1419       then do:
     1420           for each temp-obj
     1421           where temp-obj.host-code <> v-cntxt-host-code-obj
     1422           :
     1423               delete temp-obj.
     1424           end.
     1425           assign
     1426               v-log-string = ", по фирме (код фирмы " + string( v-cntxt-host-code-obj ) + ")"
     1427           .
     1428       end.
     1429       when 3
     1430       then do:
     1431           for each temp-obj
     1432           :
     1433               delete temp-obj.
     1434           end.
     1435           do v-obj-counter = 1 to num-entries ( p-obj-list ) / 2
     1436           :
     1437               create temp-obj.
     1438               assign
     1439                   temp-obj.obj-type = entry( v-obj-counter * 2 - 1, p-obj-list )
     1440                   temp-obj.obj-code = integer( entry( v-obj-counter * 2, p-obj-list ) )
     1441               no-error .
     1442               if error-status :error
     1443               then do:
     1444                   message
     1445                   vss-workfile vss-revision vss-description
     1446                   skip "Ошибка чтения списка объектов"
     1447                   skip return-value
     1448                   skip trim(error-status :get-message(1))
     1449                       trim(error-status :get-message(2))
     1450                       trim(error-status :get-message(3))
     1451                   view-as alert-box error.
     1452                   undo, return error .
     1453               end.
     1454   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1455   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1456     (input  temp-obj.obj-type
     1457     ,input  temp-obj.obj-code
     1458     ,output temp-obj.host-code
     1459     ) no-error .
     1460               if error-status :error
     1461               then do:
     1462                   message
     1463                   vss-workfile vss-revision vss-description
     1464                   skip "Не найдена фирма для объекта" temp-obj.obj-type temp-obj.obj-code
     1465                   skip return-value
     1466                   skip trim(error-status :get-message(1))
     1467                       trim(error-status :get-message(2))
     1468                       trim(error-status :get-message(3))
     1469                   view-as alert-box error.
     1470                   undo, return error .
     1471               end.
     1472           end.
     1473           assign
     1474               v-log-string = ", по объектам: " + p-obj-list
     1475           .
     1476       end.
     1477       end case.
     1478       run bgelib-filename in this-procedure (
     1479             input "doc"
     1480           , output v-xml-file-name
     1481           , output v-log-file-name
     1482           , output v-list-file-name
     1483       ).
     1484       run gbl/waitfrsp.w (
     1485             input substring( v-xml-file-name, 1, 1 )
     1486           , input 200
     1487           , output v-cancel
     1488       ) .
     1489       if v-cancel = yes
     1490       then do:
     1491           undo, return error .
     1492       end.
     1493       run bgelib-write-log in this-procedure (
     1494             input v-log-file-name
     1495           , input 1
     1496           , input "&DLine"
     1497       ).
     1498       run bgelib-write-log in this-procedure (
     1499             input v-log-file-name
     1500           , input 1
     1501           , input substitute( "Начало выгрузки в файл &1"
     1502                                   , replace( v-xml-file-name, "/", "\" ) + "tmp"
     1503                             )
     1504       ).
     1505       run bgelib-write-log in this-procedure (
     1506             input v-log-file-name
     1507           , input 1
     1508           , input substitute( "................с параметрами: Дата с: &1, дата по: &2"
     1509                                   , p-date-from
     1510                                   , p-date-to
     1511                             )
     1512       ).
     1513       run bgelib-write-log in this-procedure (
     1514             input v-log-file-name
     1515           , input 1
     1516           , input substitute( "................с параметрами: ... список объектов: &1", p-obj-list )
     1517       ).
     1518       run bgelib-write-log in this-procedure (
     1519             input v-log-file-name
     1520           , input 1
     1521           , input substitute( "................с параметрами: ... типы документов: &1", p-doc-type-list )
     1522       ).
     1523       run bgelib-write-log in this-procedure (
     1524             input v-log-file-name
     1525           , input 1
     1526           , input substitute( "................с параметрами: ... надо ли виды платежей: &1, ГТД: &2, партии: &3, типы кассовых платежей: &4, кассы: &5, преф.карт: &6, незакр.документы: &7"
     1527                                                         , p-pay-code
     1528                                                         , p-cst
     1529                                                         , p-parts
     1530                                                         , p-chk-pay-code
     1531                                                         , p-pay-desk
     1532                                                         , p-pay-desk-cards
     1533                                                         , p-opened-docs  )
     1534       ).
     1535       assign
     1536           v-parameter-list         =  substitute( "&1,&2,&3,&4,&5,&6,&7,&8,&9"
     1537                                                  , 12
     1538                                                  , "docName"          , "document":U
     1539                                                  , "version"          , replace("15.0 " + replace( vss-revision + vss-date, "$", " " ),',','')
     1540                                                  , "exportDate"       , string( today,          "99/99/9999" )
     1541                                                  , "exportTime"       , string( time,           "HH:MM:SS"   )
     1542                                                 )
     1543                                     + substitute( ",&1,&2,&3,&4,&5,&6,&7,&8"
     1544                                                  , "baseNum"          , 0
     1545                                                  , "dateFrom"         , string( p-date-from,    "99/99/9999" )
     1546                                                  , "dateto"           , string( p-date-to,      "99/99/9999" )
     1547                                                  , "needPaySupp"      , p-pay-code
     1548                                                 )
     1549                                     + substitute( ",&1,&2,&3,&4,&5,&6,&7,&8"
     1550                                                  , "needLineCST"          , p-cst
     1551                                                  , "needLineParts"        , p-parts
     1552                                                  , "needLineChkPayCode"   , p-chk-pay-code
     1553                                                  , "needLineChkPayDesk"   , p-pay-desk
     1554                                                 )
     1555                                     + substitute( ",&1,&2,&3,&4"
     1556                                                  , "needLineChkPayDeskCards"  , p-pay-desk-cards
     1557                                                  , "needOpenedDocs"           , p-opened-docs
     1558                                                 )
     1559       .
     1560       run bgelib-write-header in this-procedure (
     1561             input yes
     1562           , input v-xml-file-name
     1563           , input v-list-file-name
     1564           , input 1
     1565           , input no
     1566           , input ""
     1567           , input p-obj-list
     1568           , input p-doc-type-list
     1569           , input v-parameter-list
     1570       ).
     1571       object-of-list:
     1572       for each temp-obj
     1573       :
     1574           run cb-fill_bgelib_clients in this-procedure (
     1575                 input temp-obj.obj-type
     1576               , input temp-obj.obj-code
     1577           ).
     1578           run export-docs-by-object (
     1579                 input temp-obj.host-code
     1580               , input temp-obj.obj-type
     1581               , input temp-obj.obj-code
     1582               , input v-xml-file-name
     1583               , input v-log-file-name
     1584               , input v-list-file-name
     1585               , input v-xml-file-number
     1586               , output v-xml-file-name
     1587               , output v-xml-file-number
     1588           ) no-error.
     1589           if error-status :error
     1590           then do:
     1591               message
     1592               vss-workfile vss-revision vss-description
     1593               skip "Ошибка экспорта документов по объекту"
     1594               skip "Тип объекта:" temp-obj.obj-type
     1595               skip "Код объекта:" temp-obj.obj-code
     1596               skip return-value
     1597               skip trim(error-status :get-message(1))
     1598                    trim(error-status :get-message(2))
     1599                    trim(error-status :get-message(3))
     1600               view-as alert-box error.
     1601               next object-of-list.
     1602           end.
     1603       end.
     1604       run bge/catgood.p (
     1605             input "good-ext,list"
     1606           , input table temp_bgelib_goods
     1607       ).
     1608       run bge/catfirm.p (
     1609             input "list":U
     1610           , input v-cntxt-host-code-obj
     1611           , input table temp_bgelib_clients
     1612       ).
     1613       run bgelib-write-footer in this-procedure (
     1614             input yes
     1615           , input v-xml-file-name
     1616           , input v-list-file-name
     1617           , input no
     1618           , input ""
     1619       ).
     1620       run bgelib-write-log in this-procedure (
     1621             input v-log-file-name
     1622           , input 1
     1623           , input substitute( "Данные выгружены в файл &1"
     1624                                   , replace( v-xml-file-name, "/", "\" ) + "xml"
     1625                             )
     1626       ).
     1627       run bgelib-write-log in this-procedure (
     1628             input v-log-file-name
     1629           , input 1
     1630           , input "&DLine"
     1631       ).
     1632   end.
     1633   procedure export-docs-by-object :
     1634   define input parameter p-host-code              as integer      no-undo.
     1635   define input parameter p-obj-type               as character    no-undo.
     1636   define input parameter p-obj-code               as integer      no-undo.
     1637   define input parameter p-xml-file-name          as character    no-undo.
     1638   define input parameter p-log-file-name          as character    no-undo.
     1639   define input parameter p-list-file-name         as character    no-undo.
     1640   define input parameter p-xml-file-number        as integer      no-undo.
     1641   define output parameter p-new-xml-file-name     as character    no-undo.
     1642   define output parameter p-new-xml-file-number   as integer      no-undo.
     1643       define variable v-archive-ok        as logical      no-undo.
     1644       define variable v-comment           as character    no-undo.
     1645   do
     1646   on error undo, return error
     1647   :
     1648       assign
     1649           p-new-xml-file-name     = p-xml-file-name
     1650           p-new-xml-file-number   = p-xml-file-number
     1651       .
     1652       run bgelib-write-edt( hEDT, 1, string( p-obj-type ) + " " + string( p-obj-code ) ).
     1653       run bgelib-write-edt( hEDT, 4,  "Расчет архивов").
     1654       run bge/bge-ahz.p (
     1655             input p-mainmenu-handle
     1656           , input p-obj-type
     1657           , input p-obj-code
     1658           , input yes
     1659           , input yes
     1660           , input no
     1661           , input p-date-from
     1662           , input p-date-to
     1663           , output v-archive-ok
     1664           , output v-comment
     1665       ) no-error.
     1666       if error-status :error
     1667       then do:
     1668           message
     1669           vss-workfile vss-revision vss-description
     1670           skip "Ошибка проверки архивов на объекте."
     1671           skip "Тип объекта:" p-obj-type
     1672           skip "Код объекта:" p-obj-code
     1673           skip return-value
     1674           skip trim(error-status :get-message(1))
     1675               trim(error-status :get-message(2))
     1676               trim(error-status :get-message(3))
     1677           view-as alert-box error.
     1678           undo, return error .
     1679       end.
     1680       if v-archive-ok = no
     1681       then do:
     1682           run bgelib-write-log in this-procedure (
     1683                 input v-log-file-name
     1684               , input 1
     1685               , input substitute( "*** Документы по объекту &1 &2 в интервале дат &3 - &4 не будут выгружены. Архивы по объекту в заданном интервале дат не целостные. &5."
     1686                                       , p-obj-type
     1687                                       , p-obj-code
     1688                                       , p-date-from
     1689                                       , p-date-to
     1690                                       , v-comment       )
     1691           ).
     1692           undo, return error .
     1693       end.
     1694       process events.
     1695       run rep/get-fo.p (
     1696             input  p-obj-type
     1697           , input  p-obj-code
     1698           , input  p-date-from
     1699           , input  p-date-to
     1700           , output v-fact-order-from
     1701           , output v-fact-order-to
     1702           , output v-docs-exists
     1703       ) no-error .
     1704       if error-status :error
     1705       then do:
     1706           message
     1707             vss-workfile vss-revision vss-description
     1708             skip "Ошибка определения границ fact-order для поиска по архивам"
     1709             skip return-value
     1710             skip trim(error-status :get-message(1))
     1711                  trim(error-status :get-message(2))
     1712                  trim(error-status :get-message(3))
     1713           view-as alert-box error.
     1714           undo, return error .
     1715       end.
     1716       if v-docs-exists = no
     1717       then do:
     1718           run bgelib-write-edt( hEDT, 4, "В заданном диапазоне дат нет закрытых документов").
     1719       end.
     1720       else do:
     1721           run bgelib-show-cnt(hCNT).
     1722           for each temp_ext-doc-type
     1723           :
     1724               if lookup( temp_ext-doc-type.ext-doc-type, p-doc-type-list ) <> 0
     1725               or p-doc-type-list = ""
     1726               then do:
     1727                   run bge/docoper.p (
     1728                         input p-host-code
     1729                       , input p-obj-type
     1730                       , input p-obj-code
     1731                       , input temp_ext-doc-type.ext-doc-type
     1732                       , input temp_ext-doc-type.ext-doc-type-label
     1733                       , input v-fact-order-from
     1734                       , input v-fact-order-to
     1735                       , input p-pay-code
     1736                       , input p-cst
     1737                       , input p-parts
     1738                       , input p-chk-pay-code
     1739                       , input p-pay-desk
     1740                       , input p-pay-desk-cards
     1741                       , input p-obj-list
     1742                       , input p-doc-type-list
     1743                       , input v-parameter-list
     1744                       , input p-xml-file-name
     1745                       , input p-log-file-name
     1746                       , input p-list-file-name
     1747                       , input p-xml-file-number
     1748                       , input this-procedure
     1749                       , input hEDT
     1750                       , input hCNT
     1751                       , output p-new-xml-file-name
     1752                       , output p-new-xml-file-number
     1753                   ) no-error.
     1754                   if error-status :error
     1755                   then do:
     1756                     message
     1757                         vss-workfile vss-revision vss-description
     1758                         skip(1)
     1759                         skip "Ошибка вызова bge/docoper.p"
     1760                         skip return-value
     1761                         skip trim(error-status :get-message(2))
     1762                         skip trim(error-status :get-message(2))
     1763                              trim(error-status :get-message(3))
     1764                     view-as alert-box error.
     1765                     run bgelib-write-edt( hEDT, 1, substitute( "&1. &2. &3."
     1766                                                              , return-value
     1767                                                              , trim(error-status :get-message(1))
     1768                                                              , trim(error-status :get-message(2))
     1769                                                              )
     1770                                         ).
     1771                     undo, return error return-value .
     1772                   end.
     1773                   assign
     1774                       p-xml-file-name     = p-new-xml-file-name
     1775                       p-xml-file-number   = p-new-xml-file-number
     1776                   .
     1777               end.
     1778           end.
     1779           run bgelib-hide-cnt( hCNT ).
     1780       end.
     1781       if p-deleted = yes
     1782       then do:
     1783           run bgelib-show-CNT( hCNT ).
     1784           run bge/docdeld.p (
     1785                 input p-host-code
     1786               , input p-obj-type
     1787               , input p-obj-code
     1788               , input p-date-from
     1789               , input p-date-to
     1790               , input v-xml-file-name
     1791               , input v-log-file-name
     1792               , input hEDT
     1793               , input hCNT
     1794           ) no-error.
     1795           if error-status :error
     1796           then do:
     1797               run bgelib-write-edt( hEDT, 1, substitute( "&1. &2. &3."
     1798                                               , return-value
     1799                                               , trim(error-status :get-message(1))
     1800                                               , trim(error-status :get-message(2))
     1801                                               )  ).
     1802           end.
     1803           run bgelib-hide-cnt( hCNT ).
     1804       end.
     1805       process events.
     1806       if p-opened-docs = yes
     1807       then do:
     1808           run bgelib-show-cnt(hCNT).
     1809           run bge/docopnd.p (
     1810                 input p-host-code
     1811               , input p-obj-type
     1812               , input p-obj-code
     1813               , input p-cst
     1814               , input p-parts
     1815               , input p-xml-file-name
     1816               , input p-log-file-name
     1817               , input this-procedure
     1818               , input hEDT
     1819               , input hCNT
     1820           ) no-error.
     1821           if error-status :error
     1822           then do:
     1823               run bgelib-write-edt( hEDT, 1, substitute( "&1. &2. &3."
     1824                                               , return-value
     1825                                               , trim(error-status :get-message(1))
     1826                                               , trim(error-status :get-message(2))
     1827                                               )  ).
     1828           end.
     1829           process events.
     1830           run bgelib-hide-cnt(hCNT).
     1831       end.
     1832       process events.
     1833   end.
     1834   end procedure.
     1835   procedure cb-fill_bgelib_goods :
     1836   define input parameter p-gds-code   as integer          no-undo.
     1837       define buffer buf_temp_bgelib_goods     for temp_bgelib_goods.
     1838   do
     1839   for buf_temp_bgelib_goods
     1840   on error undo, return error
     1841   :
     1842       find first buf_temp_bgelib_goods
     1843            where buf_temp_bgelib_goods.gds-code = p-gds-code
     1844       no-error.
     1845       if not available buf_temp_bgelib_goods
     1846       then do:
     1847           create buf_temp_bgelib_goods.
     1848           assign
     1849               buf_temp_bgelib_goods.gds-code = p-gds-code
     1850           .
     1851       end.
     1852   end.
     1853   end procedure.
     1854   procedure cb-fill_bgelib_clients :
     1855   define input parameter p-obj-type   as character        no-undo.
     1856   define input parameter p-obj-code   as integer          no-undo.
     1857       define buffer buf_temp_bgelib_clients     for temp_bgelib_clients.
     1858   do
     1859   for buf_temp_bgelib_clients
     1860   on error undo, return error
     1861   :
     1862       find first buf_temp_bgelib_clients
     1863            where buf_temp_bgelib_clients.obj-type = p-obj-type
     1864              and buf_temp_bgelib_clients.obj-code = p-obj-code
     1865       no-error.
     1866       if not available buf_temp_bgelib_clients
     1867       then do:
     1868           create buf_temp_bgelib_clients.
     1869           assign
     1870               buf_temp_bgelib_clients.obj-type = p-obj-type
     1871               buf_temp_bgelib_clients.obj-code = p-obj-code
     1872           .
     1873       end.
     1874   end.
     1875   end procedure.
