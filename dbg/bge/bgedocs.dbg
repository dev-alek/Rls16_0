       92   define   shared variable g#passwd as character no-undo .
       93   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       94   define  temp-table temp-host no-undo
       95     field host-code like ub.store.host-code
       96     index xpk host-code
       97   .
       98   define  temp-table temp-obj no-undo
       99     field obj-type  like ub.clients.obj-type
      100     field obj-code  like ub.clients.obj-code
      101     field host-code like ub.store.host-code
      102     field db-num    like ub.clients.db-num
      103     index xpk  obj-type obj-code
      104     index xie1 host-code
      105     index xie2 db-num host-code
      106   .
      107   procedure init-temphost:
      108     define buffer buf_store   for ub.store .
      109     define buffer buf_shop    for ub.shop .
      110     define buffer buf_clients for ub.clients .
      111     define buffer buf_db for ub.db .
      112     define buffer buf_temp-host for temp-host .
      113     define buffer buf_temp-obj for temp-obj .
      114     do
      115     on error undo, return error return-value
      116     :
      117       for each buf_store
      118       on error undo, return error
      119       :
      120         find first buf_temp-host
      121           where buf_temp-host.host-code = buf_store.host-code
      122           no-error .
      123         if not available buf_temp-host
      124         then do:
      125           create buf_temp-host .
      126           assign
      127             buf_temp-host.host-code = buf_store.host-code
      128           .
      129         end.
      130         find first buf_clients no-lock
      131           where buf_clients.obj-type = 'скл':U
      132             and buf_clients.obj-code = buf_store.obj-code
      133           no-error .
      134         if not available buf_clients
      135         then do:
      136           message
      137             "Ошибка при поиске клиента" skip
      138             "Клиент" 'скл':U buf_store.obj-code skip
      139             view-as alert-box error .
      140           undo, return error .
      141         end.
      142         create buf_temp-obj .
      143         assign
      144           buf_temp-obj.obj-type  = 'скл':U
      145           buf_temp-obj.obj-code  = buf_store.obj-code
      146           buf_temp-obj.host-code = buf_store.host-code
      147           buf_temp-obj.db-num    = buf_clients.db-num
      148         .
      149       end.
      150       for each buf_shop
      151       on error undo, return error
      152       :
      153         find first buf_temp-host
      154           where buf_temp-host.host-code = buf_shop.host-code
      155           no-error .
      156         if not available buf_temp-host
      157         then do:
      158           create buf_temp-host .
      159           assign
      160             buf_temp-host.host-code = buf_shop.host-code
      161           .
      162         end.
      163         find first buf_clients no-lock
      164           where buf_clients.obj-type = 'маг':U
      165             and buf_clients.obj-code = buf_shop.obj-code
      166           no-error .
      167         if not available buf_clients then do:
      168           message
      169             "Ошибка при поиске клиента" skip
      170             "Клиент" 'маг':U buf_shop.obj-code skip
      171             view-as alert-box error .
      172           undo, return error .
      173         end.
      174         create buf_temp-obj .
      175         assign
      176           buf_temp-obj.obj-type  = 'маг':U
      177           buf_temp-obj.obj-code  = buf_shop.obj-code
      178           buf_temp-obj.host-code = buf_shop.host-code
      179           buf_temp-obj.db-num    = buf_clients.db-num
      180         .
      181       end.
      182     end.
      183   end.
      184   define variable vss-include-info1 as character format "X(65)" no-undo
      185   initial "@(#)$Workfile$ $Revision$".
      186   define variable v-bgelib-bgefmt        as character         no-undo.
