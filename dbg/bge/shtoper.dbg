     2837   FUNCTION get-curr RETURNS CHARACTER
     2838     (buffer loc-wealth for ub.wealth ) :
     2839   define buffer buf_currency for ub.currency.
     2840   if loc-wealth.curr-code = ? or loc-wealth.is-money = no then
     2841   return loc-wealth.unit-base.
     2842   FIND FIRST buf_currency no-lock where
     2843             buf_currency.curr-code = loc-wealth.curr-code No-ERROR.
     2844   if avail buf_currency then
     2845     RETURN buf_currency.curr-abbr.
     2846   else return "".
     2847   END FUNCTION.
     2848   define new global shared variable g#lib-trn  as handle no-undo .
     2849   define new global shared variable g#lib-trn2 as handle no-undo .
     2850   define new global shared variable g#lib-trn3 as handle no-undo .
     2851   define new global shared variable g#lib-trn4 as handle no-undo .
     2852   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2853   def
     2854   new shared
     2855   temp-table  obj-list no-undo
     2856     field obj-type like ub.clients.obj-type
     2857     field obj-code like ub.clients.obj-code
     2858     field obj-name like ub.clients.obj-name
     2859     field obj-id   as integer
     2860     field db-num   as integer
     2861     index pi is primary unique obj-id
     2862     index ie1 obj-type obj-code
     2863     index ie2 obj-name
     2864   .
     2865   procedure create_obj-list :
     2866      define input parameter p-obj-type like ub.clients.obj-type no-undo .
     2867      define input parameter p-obj-code like ub.clients.obj-code no-undo .
     2868      do
     2869      on error undo, return error return-value
     2870      :
     2871         define buffer cli-obj for ub.clients .
     2872         define variable p-var as integer no-undo .
     2873         define buffer buf_obj-list for obj-list .
     2874         find last buf_obj-list  use-index pi no-error .
     2875         if available buf_obj-list
     2876         then
     2877            p-var = buf_obj-list.obj-id + 1.
     2878         else
     2879            p-var = 1.
     2880         find first cli-obj where
     2881                   cli-obj.obj-type = p-obj-type
     2882               and cli-obj.obj-code = p-obj-code
     2883         no-lock no-error.
     2884         if available cli-obj
     2885         then do:
     2886            create buf_obj-list.
     2887            assign
     2888               buf_obj-list.obj-id   = p-var
     2889               buf_obj-list.obj-code = cli-obj.obj-code
     2890               buf_obj-list.obj-type = cli-obj.obj-type
     2891               buf_obj-list.obj-name = cli-obj.obj-name
     2892               buf_obj-list.db-num   = cli-obj.db-num
     2893            .
     2894         end.
     2895      end.
     2896   end.
     2897   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2898   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2899   procedure factord :
     2900     define input  parameter p-fact-date            as date    no-undo .
     2901     define input  parameter p-fact-time            as integer no-undo .
     2902     define input  parameter p-fact-num             as integer no-undo .
     2903     define input  parameter p-shift-date           as date    no-undo .
     2904     define input  parameter p-shift-num            as integer no-undo .
     2905     define input  parameter p-shift-on             as logical no-undo .
     2906     define output parameter p-fact-order           as decimal no-undo .
     2907     define output parameter p-shift-end-fact-order as decimal no-undo .
     2908     define output parameter p-day-end-fact-order   as decimal no-undo .
     2909     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     2910     if p-fact-date = ?
     2911     then do:
     2912       return error "Не указана фактическая дата" .
     2913     end.
     2914     define variable v-fact-date-num as integer no-undo .
     2915     assign
     2916       v-fact-date-num = integer(p-fact-date)
     2917     .
     2918     if p-fact-num = ?
     2919     or p-fact-num = 0
     2920     then do:
     2921       return error "Не задан p-fact-num " + string(p-fact-num) .
     2922     end.
     2923     if p-fact-num < 0
     2924     then do:
     2925       return error "Отрицательный fact-num " + string(p-fact-num) .
     2926     end.
     2927     if p-fact-num >= 100000000
     2928     then do:
     2929       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     2930     end.
     2931     if p-shift-on = true
     2932     then do:
     2933       if p-shift-date = ?
     2934       then do:
     2935         return error "Не задана дата смены" .
     2936       end.
     2937       if p-shift-num = ?
     2938       or p-shift-num = 0
     2939       then do:
     2940         return error "Не задан номер смены" .
     2941       end.
     2942     end.
     2943     else do:
     2944       assign
     2945         p-shift-date = p-fact-date
     2946         p-shift-num  = 24
     2947       .
     2948     end.
     2949     define variable v-shift-offset as integer no-undo .
     2950     if p-shift-date = p-fact-date
     2951     then do:
     2952       assign
     2953         v-shift-offset = 1
     2954       .
     2955     end.
     2956     if p-shift-date < p-fact-date
     2957     then do:
     2958       assign
     2959         v-shift-offset = 0
     2960       .
     2961     end.
     2962     if p-shift-date > p-fact-date
     2963     then do:
     2964       message
     2965         vss-workfile vss-revision vss-description skip
     2966         "Неправильная дата закрытия смены" skip
     2967         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     2968         view-as alert-box error .
     2969       undo, return error
     2970         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     2971           ,string(p-fact-date, '99/99/9999':U)
     2972           ,string(p-shift-date, '99/99/9999':U)
     2973           )
     2974       .
     2975     end.
     2976     if p-shift-num < 1
     2977     or p-shift-num > 24
     2978     then do:
     2979       message
     2980         vss-workfile vss-revision vss-description skip
     2981         "Неправильный номер смены" skip
     2982         "p-shift-num" p-shift-num skip
     2983         view-as alert-box error .
     2984       undo, return error return-value .
     2985     end.
     2986     assign
     2987       p-fact-order           = v-fact-date-num
     2988                              + v-shift-offset * 0.5
     2989                              + p-shift-num    * 0.02 - 0.01
     2990                              + p-fact-num     * 0.0000000001
     2991       p-shift-end-fact-order = v-fact-date-num
     2992                              + v-shift-offset * 0.5
     2993                              + p-shift-num    * 0.02
     2994       p-day-end-fact-order   = v-fact-date-num
     2995                              + 0.99
     2996     .
     2997     if p-fact-order           <= v-fact-date-num
     2998     or p-shift-end-fact-order <= v-fact-date-num
     2999     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     3000     or p-shift-end-fact-order >= p-day-end-fact-order
     3001     then do:
     3002       message
     3003         vss-workfile vss-revision vss-description skip
     3004         "Внутренняя ошибка при генерации фактического номера" skip
     3005         "p-fact-date"            p-fact-date            skip
     3006         "p-fact-time"            p-fact-time            skip
     3007         "p-fact-num"             p-fact-num             skip
     3008         "p-shift-date"           p-shift-date           skip
     3009         "p-shift-num"            p-shift-num            skip
     3010         "p-shift-on"             p-shift-on             skip
     3011         "p-shift-end-fact-order" p-shift-end-fact-order skip
     3012         "p-day-end-fact-order"   p-day-end-fact-order   skip
     3013         "v-fact-date-num"        v-fact-date-num        skip
     3014         view-as alert-box error .
     3015       undo, return error return-value .
     3016     end.
     3017   end procedure.
     3018   procedure day-begin-fact-order :
     3019     define input  parameter p-fact-date            as date    no-undo .
     3020     define output parameter p-day-begin-fact-order as decimal no-undo .
     3021     do
     3022     on error undo, return error return-value
     3023     :
     3024       if p-fact-date = ?
     3025       then do:
     3026         assign
     3027           p-day-begin-fact-order = 0
     3028         .
     3029       end.
     3030       else do:
     3031         assign
     3032           p-day-begin-fact-order = integer(p-fact-date)
     3033         .
     3034       end.
     3035     end.
     3036   end procedure.
     3037   procedure factord-max-fact-order :
     3038     define output parameter p-max-fact-order as decimal   no-undo .
     3039     do
     3040     on error undo, return error return-value
     3041     :
     3042       run day-begin-fact-order in this-procedure
     3043         (input  date(1, 1, 5000)
     3044         ,output p-max-fact-order
     3045         ) .
     3046     end.
     3047   end procedure.
     3048   procedure factord-cut-archive :
     3049     define input  parameter p-obj-type             as character no-undo .
     3050     define input  parameter p-obj-code             as integer   no-undo .
     3051     define input  parameter p-fact-date            as date      no-undo .
     3052     define output parameter p-shift-on             as logical   no-undo .
     3053     define output parameter p-shift-date           as date      no-undo .
     3054     define output parameter p-shift-num            as integer   no-undo .
     3055     define output parameter p-day-end-fact-order   as decimal   no-undo .
     3056     define output parameter p-shift-end-fact-order as decimal   no-undo .
     3057     define variable v-fact-order as decimal   no-undo .
     3058     define buffer buf_shift-obj for ub.shift-obj .
     3059     do
     3060     on error undo, return error return-value
     3061     :
     3062   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3063   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3064     (input  p-obj-type
     3065     ,input  p-obj-code
     3066     ,input  'shift-on=request'
     3067     ,output p-shift-on
     3068     ) no-error .
     3069       if error-status :error
     3070       then do:
     3071         message
     3072           vss-workfile vss-revision vss-description skip
     3073           "Ошибка при определении атрибута объекта" skip
     3074           "Объект" p-obj-type p-obj-code skip
     3075           error-status :get-message(1) skip
     3076           return-value skip
     3077           view-as alert-box error .
     3078         undo, return error return-value .
     3079       end.
     3080       if p-shift-on = false
     3081       then do:
     3082         assign
     3083           p-shift-date               = ?
     3084           p-shift-num                = 0
     3085         .
     3086       end.
     3087       else do:
     3088         find first buf_shift-obj share-lock
     3089           where buf_shift-obj.obj-type   = p-obj-type
     3090             and buf_shift-obj.obj-code   = p-obj-code
     3091             and buf_shift-obj.shift-date > p-fact-date
     3092           use-index pi
     3093           no-error .
     3094         if not available buf_shift-obj
     3095         or buf_shift-obj.status_ <> 'зкр':U
     3096         then do:
     3097           message
     3098             vss-workfile vss-revision vss-description skip
     3099             "Невозможно вычислить последнюю смену" skip
     3100             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     3101             "Объект" p-obj-type p-obj-code skip
     3102             "Дата" p-fact-date skip
     3103             view-as alert-box error .
     3104           undo, return error return-value .
     3105         end.
     3106         find last buf_shift-obj share-lock
     3107           where buf_shift-obj.obj-type = p-obj-type
     3108             and buf_shift-obj.obj-code = p-obj-code
     3109             and buf_shift-obj.shift-date <= p-fact-date
     3110           use-index pi
     3111           no-error .
     3112         if available buf_shift-obj
     3113         then do:
     3114           if  buf_shift-obj.status_ = 'зкр':U
     3115           then do:
     3116             assign
     3117               p-shift-date = buf_shift-obj.shift-date
     3118               p-shift-num  = buf_shift-obj.shift-num
     3119             .
     3120           end.
     3121           else do:
     3122             message
     3123               vss-workfile vss-revision vss-description skip
     3124               "Невозможно вычислить последнюю смену" skip
     3125               "Статус смены отличен от статуса" 'зкр':U skip
     3126               "Объект" p-obj-type p-obj-code skip
     3127               "Дата" p-fact-date skip
     3128               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     3129               view-as alert-box error .
     3130             undo, return error return-value .
     3131           end.
     3132         end.
     3133         else do:
     3134           assign
     3135             p-shift-date = p-fact-date - 1
     3136             p-shift-num  = 1
     3137           .
     3138         end.
     3139       end.
     3140       run factord in this-procedure
     3141         (input  p-fact-date
     3142         ,input  1
     3143         ,input  1
     3144         ,input  p-shift-date
     3145         ,input  p-shift-num
     3146         ,input  p-shift-on
     3147         ,output v-fact-order
     3148         ,output p-shift-end-fact-order
     3149         ,output p-day-end-fact-order
     3150         ) no-error .
     3151       if error-status :error
     3152       then do:
     3153         message
     3154           vss-workfile vss-revision vss-description skip
     3155           "Ошибка при вызове процедуры factord"
     3156           error-status :get-message(1) skip
     3157           return-value skip
     3158           view-as alert-box error .
     3159         undo, return error return-value .
     3160       end.
     3161     end.
     3162   end procedure.
     3163   procedure factord-lock-shift :
     3164     define input  parameter p-obj-type  as character no-undo .
     3165     define input  parameter p-obj-code  as integer   no-undo .
     3166     define input  parameter p-fact-date as date      no-undo .
     3167     define parameter buffer buf_shift-obj for ub.shift-obj .
     3168     define variable v-shift-on      as logical   no-undo .
     3169     define variable v-extra-message as character no-undo .
     3170     define variable v-error as character no-undo .
     3171     do
     3172     on error undo, return error return-value
     3173     :
     3174   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3175   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3176     (input  p-obj-type
     3177     ,input  p-obj-code
     3178     ,input  'shift-on=request'
     3179     ,output v-shift-on
     3180     ) no-error .
     3181       if error-status :error
     3182       then do:
     3183         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     3184         undo, return error v-error .
     3185       end.
     3186       if v-shift-on = true
     3187       then do:
     3188         find first buf_shift-obj share-lock
     3189           where buf_shift-obj.obj-type   = p-obj-type
     3190             and buf_shift-obj.obj-code   = p-obj-code
     3191             and buf_shift-obj.shift-date > p-fact-date
     3192           use-index pi
     3193           no-error .
     3194         if not available buf_shift-obj
     3195         or buf_shift-obj.status_ <> 'зкр':U
     3196         then do:
     3197           find last buf_shift-obj
     3198             where buf_shift-obj.obj-type = p-obj-type
     3199               and buf_shift-obj.obj-code = p-obj-code
     3200               and buf_shift-obj.status_  = 'зкр':U
     3201             use-index stts
     3202             no-error .
     3203           if available buf_shift-obj
     3204           then do:
     3205             assign
     3206               v-extra-message =
     3207                     substitute("Дата начала последеней закрытой смены на объекте &1"
     3208                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     3209                               )
     3210             .
     3211           end.
     3212           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     3213           undo, return error v-error .
     3214         end.
     3215       end.
     3216     end.
     3217   end procedure.
     3218   procedure factord-end-day :
     3219     define input  parameter p-fact-date            as date    no-undo .
     3220     define output parameter p-day-end-fact-order   as decimal no-undo .
     3221     do
     3222     on error undo, return error return-value
     3223     :
     3224       if p-fact-date = ?
     3225       then do:
     3226         return error "Не указана фактическая дата" .
     3227       end.
     3228       assign
     3229         p-day-end-fact-order = integer(p-fact-date) + 0.99
     3230       .
     3231     end.
     3232   end procedure.
     3233   procedure factord-to-date :
     3234     define input  parameter p-fact-order as decimal no-undo .
     3235     define output parameter p-fact-date  as date    no-undo .
     3236     define variable v-ref-date  as date      no-undo .
     3237     define variable v-ref-delta as integer   no-undo .
     3238     do
     3239     on error undo, return error return-value
     3240     :
     3241       if p-fact-order = ?
     3242       or p-fact-order = 0
     3243       then do:
     3244         return error "Не указан fact-order" .
     3245       end.
     3246       assign
     3247         v-ref-date  = date(1, 1, 2000)
     3248       .
     3249       assign
     3250         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     3251       .
     3252       assign
     3253         p-fact-date = v-ref-date + v-ref-delta
     3254       .
     3255     end.
     3256   end procedure.
     3257   procedure factord-to-fact-num :
     3258     define input  parameter p-fact-order as decimal no-undo .
     3259     define output parameter p-fact-num   as integer no-undo .
     3260     define variable v-fact-order-trunc as decimal no-undo .
     3261     do
     3262     on error undo, return error return-value
     3263     :
     3264       if p-fact-order = ?
     3265       or p-fact-order = 0
     3266       then do:
     3267         return error "Не указан fact-order" .
     3268       end.
     3269       assign
     3270        v-fact-order-trunc = truncate(p-fact-order, 2)
     3271       .
     3272       assign
     3273         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     3274       .
     3275     end.
     3276   end procedure.
     3277   procedure factord-to-shift-num :
     3278     define input  parameter p-fact-order as decimal no-undo .
     3279     define output parameter p-shift-num   as integer no-undo .
     3280     define variable  p-shift-numd  as decimal   no-undo .
     3281     define variable v-fact-order-trunc as decimal no-undo .
     3282     do
     3283     on error undo, return error return-value
     3284     :
     3285       if p-fact-order = ?
     3286       or p-fact-order = 0
     3287       then do:
     3288         return error "Не указан fact-order" .
     3289       end.
     3290       assign
     3291        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     3292       .
     3293       if v-fact-order-trunc < 0.5 then do:
     3294         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     3295       end.
     3296       assign
     3297         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     3298         .
     3299        assign
     3300         p-shift-num = truncate (p-shift-numd , 0)
     3301       .
     3302     end.
     3303   end procedure.
     3304   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3305   PROCEDURE fostatok :
     3306   define input parameter p-host-code   as integer no-undo .
     3307   define input parameter x-store-code  like ub.clients.obj-code    no-undo.
     3308   define input parameter x-store-type  like ub.clients.obj-type    no-undo.
     3309   define input parameter x-tog-shift   as   logical             no-undo.
     3310   define input parameter x-date-start  as date        no-undo.
     3311   define input parameter x-date-end    as date        no-undo.
     3312   define input parameter x-shift-start as integer     no-undo.
     3313   define input parameter x-shift-end   as integer     no-undo.
     3314   define input parameter xTog-obj   as logical no-undo.
     3315   define input parameter p-curr-code as integer no-undo .
     3316   define input parameter p-cashbookid as integer  no-undo .
     3317   define output parameter sum       as decimal   no-undo.
     3318   define output parameter Fact-order  as decimal  no-undo.
     3319   define variable Fact-order#   as decimal  no-undo.
     3320   define variable Fact-orderS   as character  no-undo.
     3321   define variable x-date-start-t  as date   no-undo.
     3322   define variable x-sum-type as character no-undo .
     3323       if x-tog-shift then do:
     3324         assign
     3325         x-sum-type = 'shift-obj':U.
     3326       end.
     3327       else do:
     3328         x-sum-type = 'obj':U.
     3329       end.
     3330   Assign
     3331   Fact-order   = 0
     3332   sum     = 0
     3333   x-date-start-t  = x-date-start + 1 .
     3334   IF x-date-end = date('') then DO:
     3335     Fact-order = 0 .
     3336     For each obj-list no-lock
     3337         WHERE  (NOT xTog-obj OR
     3338                 (x-store-type = obj-list.obj-type
     3339                 AND
     3340                 x-store-code = obj-list.obj-code))
     3341     :
     3342      fact-order# = 0.
     3343      IF  x-TOG-Shift = False Then DO:
     3344         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     3345             arh-fin-doc-schet-nal-obj.Fact-date <=  x-date-start
     3346             USE-INDEX fact-date  no-error .
     3347        if Available arh-fin-doc-schet-nal-obj THEN  do:
     3348          Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     3349        end.
     3350      End.
     3351      Else  DO :
     3352         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     3353              (arh-fin-doc-schet-nal-obj.shift-date  = x-date-start-t and
     3354               arh-fin-doc-schet-nal-obj.shift-num  < x-shift-start or
     3355               arh-fin-doc-schet-nal-obj.shift-date  < x-date-start-t  )
     3356               and arh-fin-doc-schet-nal-obj.shift-num  > 0
     3357               USE-INDEX Shift-num no-error .
     3358         if Available arh-fin-doc-schet-nal-obj THEN  do:
     3359           Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     3360         end.
     3361       END.
     3362       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     3363     End.
     3364   End.
     3365   Else DO:
     3366     For each obj-list  no-lock WHERE
     3367        (NOT xTog-obj
     3368         OR
     3369         (x-store-type = obj-list.obj-type
     3370         AND
     3371         x-store-code = obj-list.obj-code))
     3372      :
     3373      IF  x-TOG-Shift = False Then DO:
     3374         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     3375               arh-fin-doc-schet-nal-obj.Fact-date <= x-date-end
     3376               and arh-fin-doc-schet-nal-obj.shift-num = 0
     3377               USE-INDEX fact-date no-error.
     3378        if Available arh-fin-doc-schet-nal-obj THEN  do:
     3379          Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     3380        end.
     3381      END.
     3382      Else DO:
     3383         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     3384               (arh-fin-doc-schet-nal-obj.shift-date  = x-date-end and
     3385               arh-fin-doc-schet-nal-obj.shift-num  <= x-shift-end or
     3386               arh-fin-doc-schet-nal-obj.shift-date  < x-date-end       ) and
     3387               arh-fin-doc-schet-nal-obj.shift-num   > 0      use-index shift-num no-error.
     3388         if Available arh-fin-doc-schet-nal-obj THEN  do:
     3389           Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     3390         end.
     3391       End.
     3392       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     3393     End.
     3394   End.
     3395   END PROCEDURE.
