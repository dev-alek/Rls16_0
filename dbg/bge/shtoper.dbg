      519                       then do:
      520                           assign
      521                               p-out-string = p-out-string + " ":U
      522                           .
      523                       end.
      524                       when chr(5)
      525                       then do:
      526                           assign
      527                               p-out-string = p-out-string + " ":U
      528                           .
      529                       end.
      530                       when chr(6)
      531                       then do:
      532                           assign
      533                               p-out-string = p-out-string + " ":U
      534                           .
      535                       end.
      536                       when chr(7)
      537                       then do:
      538                           assign
      539                               p-out-string = p-out-string + " ":U
      540                           .
      541                       end.
      542                       when chr(8)
      543                       then do:
      544                           assign
      545                               p-out-string = p-out-string + " ":U
